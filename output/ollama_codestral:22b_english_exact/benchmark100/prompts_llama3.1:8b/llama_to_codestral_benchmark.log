---
   - name: Import assert.yml task
     import_tasks: assert.yml
     run_once: yes
     delegate_to: localhost

   - name: Install repository for RedHat task
     yum_repository:
       name: hashicorp
       description: Hashicorp Repository
       baseurl: "https://rpm.releases.hashicorp.com/redhat/$releasever/$basearch/stable"
       gpgcheck: yes
       gpgkey: "https://rpm.releases.hashicorp.com/gpg"
     when: ansible_os_family == 'RedHat'

   - name: Install required package gpg task
     apt:
       name: gpg
       state: present
     when: ansible_os_family == 'Debian'

   - name: Install apt key for Debian task
     apt_key:
       url: "https://apt.releases.hashicorp.com/gpg"
       state: present
     when: ansible_os_family == 'Debian'

   - name: Install repository for Debian task
     apt_repository:
       repo: "deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_lsb.codename }} main"
       state: present
     when: ansible_os_family == 'Debian'

   - name: Install latest hashicorp product using package task
     package:
       name: hashicorp-product
       state: latest
     when: install_method == 'package' and version is not defined

   - name: Install versioned hashicorp product using package task
     package:
       name: hashicorp-product
       state: "{{ version }}"
     when: install_method == 'package' and version is defined

   - name: Install manually task
     unarchive:
       src: "https://releases.hashicorp.com/hashicorp-product/{{ hashicorp_product_version }}/hashicorp-product_{{ hashicorp_product_version }}_linux_amd64.zip"
       dest: /usr/local/bin
       remote_src: yes
     when: install_method == 'manual'

