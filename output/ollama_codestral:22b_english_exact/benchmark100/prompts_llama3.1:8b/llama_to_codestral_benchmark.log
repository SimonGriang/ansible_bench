---
   - name: Download RKE2 installation script
     get_url:
       url: "{{ rke2_download_url }}"
       dest: "{{ rke2_download_dir }}/install.sh"
       mode: '0755'
     when: implementation != 'copy'

   - name: Copy local RKE2 installation script
     copy:
       src: "{{ rke2_local_src }}"
       dest: "{{ rke2_download_dir }}/install.sh"
       mode: '0755'
     when: airgap_mode and implementation == 'copy'

   - name: Create RKE2 artifacts folder
     file:
       path: "{{ rke2_artifacts_dir }}"
       state: directory
       mode: '0755'
     when: airgap_mode and implementation != 'exists'

   - name: Download RKE2 checksum and artifacts
     block:
       - name: Download RKE2 checksum and artifacts remotely
         get_url:
           url: "{{ rke2_artifacts_url }}"
           dest: "{{ rke2_artifacts_dir }}/"
           mode: '0644'
     rescue:
       - name: Download RKE2 checksum and artifacts locally
         copy:
           src: "{{ rke2_local_artifacts_src }}"
           dest: "{{ rke2_artifacts_dir }}/"
           mode: '0644'
     when: airgap_mode and implementation == 'download'

   - name: Airgap mode - additional images tarballs
     block:
       - name: Create directory for additional images tarballs
         file:
           path: "{{ rke2_additional_tarballs_dir }}"
           state: directory
           mode: '0755'
       - name: Copy RKE2 components to additional images tarballs directory
         copy:
           src: "{{ item.src }}"
           dest: "{{ rke2_additional_tarballs_dir }}/"
           mode: '0644'
         with_items: "{{ rke2_additional_tarballs }}"
     when: >
       airgap_mode and
       implementation != 'exists' and
       rke2_additional_tarballs is defined

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ rke2_artifacts_dir }}/{{ item }}"
       state: file
       mode: '0644'
     loop:
       - rke2.linux-amd64.tar.gz
       - rke2.linux-amd64.tar.gz.sha256
     when: airgap_mode and implementation == 'exists'

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: "{{ rke2_fs_object_path }}"
     register: fs_object_stats

   - name: Check if separate partition
     shell: "grep '^{{ fs_object_stats.stat.dev }}' /proc/mounts"
     register: partition_check
     ignore_errors: true

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "/var/lib/rke2"
     when: >
       (fs_object_stats.stat.isdir is not defined or
        not fs_object_stats.stat.isdir) or
       partition_check.rc == 1

   - name: Check RKE2 version
     shell: >
       {{ rke2_bin_path }}/bin/rke2 --version |
       grep -o 'rke2 [0-9].[0-9]*' |
       cut -d' ' -f2 &&
       systemctl is-active rke2
     register: rke2_version_check
     ignore_errors: true

   - name: Set RKE2 versions
     set_fact:
       rke2_current_version: "{{ rke2_version_check.stdout_lines[0] }}"
       rke2_service_status: "{{ rke2_version_check.stdout_lines[1] }}"
     when: rke2_version_check.rc == 0

   - name: Prevent accidental RKE2 downgrade
     assert:
       that:
         - rke2_current_version is version_compare(rke2_desired_version, '>=')
       fail_msg: >
         Attempted downgrade from {{ rke2_current_version }}
         to {{ rke2_desired_version }}
     when: rke2_current_version is defined

   - name: Run RKE2 install script
     shell: >
       INSTALL_RKE2_VERSION={{ rke2_desired_version }}
       {{ rke2_install_options }}
       {{ rke2_download_dir }}/install.sh
     when: >
       rke2_current_version is not defined or
       rke2_current_version != rke2_desired_version

   - name: Copy Custom Manifests
     copy:
       src: "{{ custom_manifests_src }}"
       dest: "{{ rke2_manifests_dir }}"
       mode: '0644'
     when: custom_manifests_src is defined

   - name: Copy Static Pods
     copy:
       src: "{{ static_pods_src }}"
       dest: "{{ rke2_static_pods_dir }}"
       mode: '0644'
     when: static_pods_src is defined

   - name: Copy RKE2 environment file
     copy:
       src: "{{ rke2_env_file_src }}"
       dest: "{{ rke2_env_file_dest }}"
       mode: '0644'
     when: rke2_env_options is defined

