---
   - name: Check if Helm binary exists
     stat:
       path: "{{ helm_bin_path }}"
     register: helm_check

   - name: Check current Helm version
     command: "{{ helm_bin_path }} version"
     register: helm_existing_version
     changed_when: false
     failed_when: false

   - name: Download Helm binary
     get_url:
       url: "{{ helm_repo_path }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}"
       dest: "/tmp/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}"
     when: >
       not helm_check.stat.exists or
       helm_version not in helm_existing_version.stdout

   - name: Copy Helm binary into place
     copy:
       src: "/tmp/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}"
       dest: "{{ helm_bin_path }}"
       mode: '0755'
       owner: root
       group: root
     become: true
     when: >
       not helm_check.stat.exists or
       helm_version not in helm_existing_version.stdout
   

