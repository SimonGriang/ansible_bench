       postfix_sender_access_rules: "{{ postfix_sender_access | default([]) }}"
       postfix_mynetworks: >
         {{ postfix_mynetworks |
         default('127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128') }}
       postfix_mydestination: "{{ postfix_mydestination | default('') }}"
       postfix_relay_domains: "{{ postfix_relay_domains | default('') }}"
       postfix_smtpd_recipient_restrictions: >
         {{ postfix_smtpd_recipient_restrictions
         | default('permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination') }}
       postfix_smtpd_sender_restrictions: >
         {{ postfix_smtpd_sender_restrictions
         | default('permit_mynetworks, permit_sasl_authenticated, reject_unauth_pipelining') }}
       postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default('') }}"
       postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains | default('') }}"

   - name: Configure postfix main.cf
     template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify:
       - Validate postfix configuration
       - Restart postfix

   - name: Configure postfix master.cf
     template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify:
       - Validate postfix configuration
       - Restart postfix

