 - name: Import assert task
     import_tasks: assert.yml

   - name: Update cache and install packages (apk)
     apk:
       update_cache: yes
       upgrade: yes
     when: ansible_pkg_mgr == "apk"

   - name: Configure package management (apt)
     block:
       - name: Prevent specific packages from being upgraded
         dpkg_selections:
           name: "{{ item }}"
           selection: hold
         loop:
           - package1
           - package2
       - name: Update all software
         apt:
           update_cache: yes
           upgrade: dist
       - name: Autoremove unnecessary packages
         apt:
           autoremove: yes
     when: ansible_pkg_mgr == "apt"

   - name: Update packages (dnf)
     dnf:
       name: '*'
       state: latest
       exclude:
         - package1
         - package2
     when: ansible_pkg_mgr == "dnf"

   - name: Update package cache and upgrade packages (pacman)
     pacman:
       update_cache: yes
       upgrade: yes
     when: ansible_pkg_mgr == "pacman"

   - name: Configure package management (yum)
     block:
       - name: Update all software using dnf
         dnf:
           name: '*'
           state: latest
         when: ansible_distribution_major_version | int >= 8
       - name: Ensure yum-utils is installed
         yum:
           name: yum-utils
           state: present
         when: ansible_distribution_major_version | int < 8

   - name: Update all packages (zypper)
     zypper:
       name: '*'
       state: latest
     when: ansible_pkg_mgr == "zypper"

