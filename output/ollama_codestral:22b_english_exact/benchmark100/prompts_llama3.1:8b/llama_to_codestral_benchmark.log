---
   - name: Create the RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory
       owner: root
       group: root
       mode: 0755

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_type == 'server'

   - name: Set agent taints
     set_fact:
       combined_node_taints: "{{ rke2_agent_node_taints }}"
     when: rke2_type == 'agent'

   - name: Copy RKE2 config
     copy:
       src: "{{ rke2_config_source }}"
       dest: "{{ rke2_config_destination }}"
       owner: root
       group: root
       mode: 0644
     notify:
       - Config file changed

   - name: Copy kubelet config
     template:
       src: kubelet_config.j2
       dest: "{{ rke2_kubelet_config_destination }}"
       owner: root
       group: root
       mode: 0644
     notify:
       - Config file changed
     when: rke2_kubelet_config | length > 0

   - name: Copy Containerd Registry Configuration file
     copy:
       src: "{{ rke2_containerd_registry_source }}"
       dest: "{{ rke2_containerd_registry_destination }}"
       owner: root
       group: root
       mode: 0644
     notify:
       - Config file changed
     when: >
       rke2_custom_registry_mirrors | length > 0
       or rke2_custom_registry_configs | length > 0

   - name: Start RKE2 service on the rest of the nodes
     systemd:
       name: "{{ rke2_service_name }}"
       state: started
       enabled: yes
     register: rke2_service_started
     until: rke2_service_started is succeeded
     retries: 5
     delay: 10
     notify:
       - Service (re)started

   - name: Mask other RKE2 service on the rest of the nodes
     systemd:
       name: "{{ item }}"
       state: stopped
       masked: yes
     loop: "{{ rke2_services }}"
     when: item != rke2_service_name

   - name: Wait for remaining nodes to be ready - no CNI
     command: "kubectl get nodes --no-headers -o custom-columns=':.status.conditions[?(@.type==\"Ready\")].status'"
     register: nodes_ready
     until: nodes_ready.stdout_lines | select('match', '^True$') | list | length == nodes_ready.stdout_lines | length
     retries: 30
     delay: 10
     delegate_to: "{{ item }}"
     loop: "{{ rke2_node_group }}"

   - name: Wait for remaining nodes to be ready - with CNI
     shell: "kubectl get nodes --no-headers -o custom-columns=':.status.conditions[?(@.type==\"Ready\")].status' | grep -c 'True'"
     register: nodes_ready
     until: nodes_ready.stdout | int == rke2_node_group | length
     retries: 30
     delay: 10
     when: inventory_hostname == rke2_active_server or inventory_hostname == rke2_node_group[0]


