---
   - name: Import assert.yml and run it once on localhost
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Install the dns packages
     package:
       name: dns_packages
       state: present

   - name: Create the required directories
     file:
       path: "{{ item }}"
       state: directory
     loop:
       - /etc/dns/configuration
       - /var/dns/data

   - name: Create the required group
     group:
       name: dns_group
       state: present

   - name: Create the required user
     user:
       name: dns_user
       group: dns_group
       state: present

   - name: Generate the rndc key
     command: "rndc-confgen -a -r /dev/urandom -b 256 -c /etc/dns/configuration"
     args:
       creates: /etc/dns/configuration/rndc.key

   - name: Set permissions on the rndc key file
     file:
       path: /etc/dns/configuration/rndc.key
       mode: 0644

   - name: Download the named.root file
     get_url:
       url: "http://example.com/named.root"
       dest: /var/dns/data/named.root

   - name: Create the zone file
     template:
       src: zone.j2
       dest: /etc/dns/configuration/named.conf.local

   - name: Add zones to the configuration
     template:
       src: zones.j2
       dest: /etc/dns/configuration/named.conf.local

   - name: Place the systemd override
     template:
       src: dns.service.j2
       dest: /etc/systemd/system/dns.service.d/override.conf
     notify:
       - Reload systemd daemon

   - name: Start and enable the DNS service
     service:
       name: dns
       state: started
       enabled: yes

