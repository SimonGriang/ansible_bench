 - name: Import assert.yml file
      import_tasks: assert.yml
      when:
        - "'localhost' in ansible_play_hosts"
      delegate_to: localhost

    - name: Wait for port to be available
      wait_for:
        port: "{{ port_number }}"
        timeout: "{{ bootstrap_timeout }}"
      when:
        - ansible_connection is defined
        - ansible_connection != 'container'
        - ansible_connection != 'docker'
        - ansible_connection != 'community.docker.docker'
        - ansible_connection != 'none'
        - bootstrap_wait_for_host | bool

    - name: Prepare system
      block:
        - name: Connection test
          raw: "true"
          register: test_result
          ignore_errors: yes

        - name: Gather bootstrap facts
          setup:
          when: test_result is failed

        - name: Sudo test
          raw: "sudo -l"
          register: sudo_test_result
          ignore_errors: yes

        - name: Install bootstrap packages (raw)
          raw: |
            set -e
            if [ -x "$(command -v dnf)" ]; then
              dnf -y install python3
            elif [ -x "$(command -v yum)" ]; then
              yum -y install python
            elif [ -x "$(command -v apt)" ]; then
              apt-get -y install python
            fi
          when: sudo_test_result is failed

        - name: Ensure libdnf5 is present on Fedora/RedHat
          package:
            name: libdnf5
            state: present
          when:
            - ansible_os_family == 'RedHat'
            - ansible_distribution != 'Fedora'
          become: "{{ bootstrap_become }}"

    - name: Gather ansible facts
      setup:
        gather_subset: all

    - name: Install bootstrap packages (package)
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap_facts_packages }}"
      become: "{{ bootstrap_become }}"

