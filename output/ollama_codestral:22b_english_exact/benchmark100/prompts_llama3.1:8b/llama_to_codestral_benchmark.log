       ssh-keygen -t rsa -b 2048 -N ''
       -f {{ ssh_key_dir }}/{{ user_name }}
     when: user_ssh_key_management | bool
     args:
       creates: "{{ ssh_key_dir }}/{{ user_name }}"

   - name: Generate the user's public SSH key
     command: >-
       ssh-keygen -y
       -f {{ ssh_key_dir }}/{{ user_name }}
     when: user_ssh_key_management | bool
     args:
       creates: "{{ ssh_key_dir }}/{{ user_name }}.pub"

   - name: Convert the user's SSH key to PPK format
     command: >-
       ssh-keygen -p -P ''
       -f {{ ssh_key_dir }}/{{ user_name }} -m PEM -e
     when: user_ssh_key_management | bool
     args:
       creates: "{{ ssh_key_dir }}/{{ user_name }}.ppk"

   - name: Get or set the user's home directory
     shell: >-
       getent passwd {{ user_name }} | cut -d: -f6
       || echo {{ default_home_dir }}
     register: user_home

   - name: Set the user's home directory
     set_fact:
       base_home_dir: "{{ user_home.stdout }}"

   - name: Create the user's .ssh directory
     file:
       path: "{{ base_home_dir }}/.ssh"
       state: directory
       mode: '0700'
       owner: "{{ user_name }}"
       group: "{{ user_group }}"

   - name: Deploy authorized keys for the user
     authorized_key:
       user: "{{ user_name }}"
       key: "{{ item }}"
       state: present
       exclusive: no
     loop: "{{ user_authorized_keys }}"
     when: user_authorized_keys is defined

   - name: Set the permissions of the authorized keys file
     file:
       path: "{{ base_home_dir }}/.ssh/authorized_keys"
       mode: '0600'

   - name: Remove unauthorized keys for the user
     authorized_key:
       user: "{{ user_name }}"
       key: "{{ item }}"
       state: absent
     loop: "{{ user_unauthorized_keys }}"
     when: user_unauthorized_keys is defined

   - name: Copy the generated private SSH key for the user
     copy:
       src: "{{ ssh_key_dir }}/{{ user_name }}"
       dest: "{{ base_home_dir }}/.ssh/id_rsa"
       mode: '0400'
     when: user_copy_private_key | bool

   - name: Check the user's password validity
     shell: >-
       chage -l {{ user_name }} | awk -F ': ' '/Password expires/ {print $2}'
     register: users_pw_valid

   - name: Set the user's password validity
     command: "chage -d 0 {{ user_name }}"
     when: user_password_validity is defined and users_pw_valid.stdout != "never"

   - name: Place the private key file for the user
     copy:
       src: "{{ ssh_key_dir }}/{{ user_name }}"
       dest: "{{ base_home_dir }}/.ssh/id_rsa"
       mode: '0400'
     when: user_private_keys is defined

   - name: Ensure new line at the end of file
     lineinfile:
       path: "{{ base_home_dir }}/.ssh/id_rsa"
       line: ""
       state: present
       insertafter: EOF

   - name: Ensure new line at the end of file
     lineinfile:
       path: "{{ base_home_dir }}/.ssh/authorized_keys"
       line: ""
       state: present
       insertafter: EOF

   - name: Ensure new line at the end of file
     lineinfile:
       path: "/etc/sudoers.d/{{ user_name }}"
       line: ""
       state: present
       insertafter: EOF
     when: user_sudo_options is defined

   - name: Ensure new line at the end of file
     lineinfile:
       path: "/etc/sudoers.d/{{ user_name }}"
       line: ""
       state: present
       insertafter: EOF
     when: user_sudo_options is not defined 53%|█████▎    | 53/100 [58:43<1:16:42, 97.92s/it]

