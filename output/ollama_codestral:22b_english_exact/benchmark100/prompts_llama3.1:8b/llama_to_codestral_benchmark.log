   - name: Copy kubelet config
     template:
       src: templates/kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       owner: root
       group: root
       mode: '0600'
     when: rke2_kubelet_config | length > 0
     notify: Config file changed

   - name: Copy Containerd Registry Configuration file
     copy:
       src: "{{ rke2_custom_registry_path }}"
       dest: /etc/rancher/rke2/registries.yaml
       owner: root
       group: root
       mode: '0600'
     when: (rke2_custom_registry_mirrors | length > 0) or
           (rke2_custom_registry_configs | length > 0)
     notify: Config file changed

   - name: Register etcd restore from file
     set_fact:
       do_etcd_restore: true
     when: >
       rke2_etcd_snapshot_file | length > 0 and
       (rke2_server_service is not defined or
        rke2_server_service.state == 'stopped')

   - name: Register etcd restore from s3
     set_fact:
       do_etcd_restore_from_s3: true
     when: >
       rke2_etcd_snapshot_file | length > 0 and
       rke2_etcd_snapshot_s3_options is defined and
       rke2_etcd_snapshot_s3_options.access_key is defined and
       rke2_etcd_snapshot_s3_options.secret_key is defined and
       rke2_etcd_snapshot_s3_options.bucket is defined and
       rke2_etcd_snapshot_s3_options.snapshot_name is defined

   - name: Restore etcd from file
     block:
       - name: Create RKE2 etcd snapshot directory
         file:
           path: /var/lib/rancher/rke2/server/db/snapshots
           state: directory
           owner: root
           group: root
           mode: '0755'
       - name: Copy etcd snapshot file
         copy:
           src: "{{ rke2_etcd_snapshot_file }}"
           dest: /var/lib/rancher/rke2/server/db/snapshots/snapshot.db
           owner: root
           group: root
           mode: '0644'
       - name: Restore etcd from snapshot
         command: >
           systemctl start rke2-server.service &&
           /var/lib/rancher/rke2/bin/kubectl get node {{ inventory_hostname }}
           --no-headers -o custom-columns=NAME:.metadata.name &&
           /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
           drain {{ inventory_hostname }} --delete-local-data
           --ignore-daemonsets --force
         environment:
           KUBECONFIG: /etc/rancher/rke2/rke2.yaml
         register: etcd_restore_output
         until: etcd_restore_output.rc == 0
         retries: 5
         delay: 10
     when: do_etcd_restore is defined

   - name: Restore etcd from s3
     block:
       - name: Restore etcd from s3 snapshot
         command: >
           systemctl start rke2-server.service &&
           /var/lib/rancher/rke2/bin/kubectl get node {{ inventory_hostname }}
           --no-headers -o custom-columns=NAME:.metadata.name &&
           /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
           drain {{ inventory_hostname }} --delete-local-data
           --ignore-daemonsets --force
         environment:
           KUBECONFIG: /etc/rancher/rke2/rke2.yaml
           AWS_ACCESS_KEY_ID: "{{ rke2_etcd_snapshot_s3_options.access_key }}"
           AWS_SECRET_ACCESS_KEY: "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
           AWS_DEFAULT_REGION: "{{ rke2_etcd_snapshot_s3_options.region | default('us-east-1') }}"
         register: etcd_restore_s3_output
         until: etcd_restore_s3_output.rc == 0
         retries: 5
         delay: 10
     when: do_etcd_restore_from_s3 is defined

   - name: Start RKE2 service on the first server
     systemd:
       name: rke2-server.service
       state: started
       enabled: yes
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     notify: Service (re)started

   - name: Mask RKE2 agent service on the first server
     systemd:
       name: rke2-agent.service
       masked: yes

   - name: Wait for the first server be ready - no CNI
     shell: >
       /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get
       node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type==\"Ready\")].status}'
     environment:
       KUBECONFIG: /etc/rancher/rke2/rke2.yaml
     register: node_status_output
     until: node_status_output.stdout == 'True' and
             "No resources found in default namespace." not in node_status_output.stderr
     retries: 30
     delay: 10

   - name: Wait for the first server be ready - with CNI
     shell: >
       /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get
       nodes -o jsonpath='{.items[?(@.metadata.name==\"{{ inventory_hostname }}\")].status.conditions[?(@.type==\"Ready\")].status}'
     environment:
       KUBECONFIG: /etc/rancher/rke2/rke2.yaml
     register: node_status_output
     until: node_status_output.stdout == 'True'
     retries: 30
     delay: 10

   - name: Restore etcd
     shell: |
       /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete
       secrets -n kube-system --field-selector=type=etcd
       /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete
       nodes --all
       /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml create
       node {{ inventory_hostname }} --external-ip={{ hostvars[inventory_hostname]['ansible_host'] }}
     environment:
       KUBECONFIG: /etc/rancher/rke2/rke2.yaml

   - name: Set an Active Server variable
     set_fact:
       active_server: "{{ inventory_hostname }}"
     delegate_to: "{{ item }}"
     loop: "{{ groups[rke2_cluster_group_name] }}"

