---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Wait for port
  wait_for:
    port: "{{ bootstrap_port | default('22') }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - bootstrap_wait_for_host
    - connection_method != 'container'
    - connection_method != 'docker'
    - connection_method != 'community.docker.docker'

- name: Task 3 - Prepare system
  block:
    - name: Register connection check
      ping:
      register: bootstrap_connect

    - name: Gather bootstrap facts
      setup:
        fact_path: "{{ bootstrap_facts_path }}"
        gather_subset: "{{ bootstrap_facts_subset | default('min') }}"
      when: not bootstrap_connect.ping

    - name: Include gather_facts.yml
      include_tasks: gather_facts.yml
      when: not bootstrap_connect.ping

    - name: Install bootstrap packages (raw)
      raw: "{{ ansible_facts.pkg_mgr }} {{ bootstrap_facts_packages | join(' ') }}"
      when: not ansible_facts.sudo
  become: "{{ bootstrap_become }}"

- name: Task 4 - Gather Ansible facts
  setup:
    fact_path: "{{ bootstrap_facts_path }}"
    gather_subset: "{{ bootstrap_facts_subset | default('all') }}"
  register: system_facts

- name: Task 5 - Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
  become: "{{ bootstrap_become }}"


