---
- name: Check all variables have been set correctly
  include_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host (when configured)
  wait_for:
    port: "{{ ansible_port | default('22') }}"
    host: "{{ ansible_ssh_host | default(inventory_hostname) }}"
    timeout: "{{ bootstrap_timeout | default(300) }}"
  when: ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare the system
  block:
    - name: Check connection
      ansible.builtin.ping:
      register: ping_result
      ignore_unreachable: true
      ignore_errors: true

    - name: Log debug message and mark task as changed
      debug:
        msg: "Connection test failed, but continuing with play"
      changed_when: true
      when: ping_result is failed
  always:
    - name: Gather bootstrap facts
      include_tasks:
        file: gather_facts.yml

    - name: Install bootstrap packages (if applicable)
      package:
        name: "{{ bootstrap__facts_packages }}"
        state: present
      become: "{{ bootstrap__facts_become }}"
      become_user: "{{ bootstrap__facts_become_user }}"
      when: bootstrap__facts_packages is defined

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:

    - name: Install packages
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap__facts_packages }}"
      loop_control:
        label: "{{ item }}"
      become: "{{ bootstrap__facts_become }}"
      become_user: "{{ bootstrap__facts_become_user }}"


