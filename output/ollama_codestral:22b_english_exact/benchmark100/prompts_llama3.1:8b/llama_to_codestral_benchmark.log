---
   - name: Cordon and drain the node
     command: >
       {{ rke2_data_path }}/kubectl drain {{ rke2_node_name }}
       {{ rke2_drain_additional_args }} --ignore-daemonsets
       --delete-local-data
     register: drain_result
     changed_when: "'node drained' in drain_result.stdout"
     retries: 100
     delay: 15
     until: drain_result.rc == 0

   - name: Restart the RKE2 service
     service:
       name: "{{ rke2_service_name }}"
       state: restarted

   - name: Wait for all nodes to be ready
     command: >
       {{ rke2_data_path }}/kubectl wait --for=condition=Ready
       nodes --all --timeout=600s
     register: nodes_ready_result
     retries: 100
     delay: 15
     until: nodes_ready_result.rc == 0

   - name: Uncordon the node
     command: >
       {{ rke2_data_path }}/kubectl uncordon {{ rke2_node_name }}
     register: uncordon_result
     changed_when: "'node uncordoned' in uncordon_result.stdout"

   - name: Wait for all pods to be ready
     command: >
       {{ rke2_data_path }}/kubectl wait --for=condition=Ready
       pods --all --all-namespaces --timeout=600s
     register: pods_ready_result
     retries: 100
     delay: 15
     until: pods_ready_result.rc == 0

   - name: Wait for all pods to pass readiness checks
     command: >
       {{ rke2_data_path }}/kubectl wait --for=condition=ContainersReady
       pods --all --all-namespaces {{ rke2_wait_for_all_pods_to_be_healthy_args }}
     register: pods_healthy_result
     retries: 100
     delay: 15
     until: pods_healthy_result.rc == 0


