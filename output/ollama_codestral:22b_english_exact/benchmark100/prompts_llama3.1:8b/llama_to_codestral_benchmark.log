---
   - name: Task 1 - Install unzip package and update cache if necessary
     apt:
       name: unzip
       update_cache: "{{ promtail_apt_update_cache }}"

   - name: Task 2 - Create promtail system group if necessary
     group:
       name: "{{ promtail_system_group }}"
       system: yes
     when: promtail_system_group != "root"

   - name: Task 3 - Create the promtail system user
     user:
       name: "{{ promtail_system_user }}"
       group: "{{ promtail_system_group }}"
       groups: "{{ promtail_user_additional_groups }}"
       system: yes
     when: promtail_system_user != "root"

   - name: Task 4 - Ensure the /usr/local/bin directory exists
     file:
       path: /usr/local/bin
       state: directory
       mode: '0755'

   - name: Task 5 - Create necessary config directories
     file:
       path: "{{ item }}"
       state: directory
       owner: "{{ promtail_system_user }}"
       group: "{{ promtail_system_group }}"
       mode: '0755'
     loop:
       - /etc/promtail
       - /var/lib/promtail/positions

   - name: Task 6 - Create application directories
     file:
       path: "{{ item }}"
       state: directory
       owner: "{{ promtail_system_user }}"
       group: "{{ promtail_system_group }}"
       mode: '0755'
     loop:
       - /opt/promtail
       - "/opt/promtail/{{ promtail_version }}"

   - name: Task 7 - Check the existence of the promtail binary
     stat:
       path: "/opt/promtail/{{ promtail_version }}/promtail"
     register: promtail_binary

   - name: Task 8 - Download promtail binaries if necessary
     get_url:
       url: "{{ promtail_url }}"
       dest: "/tmp/promtail-{{ promtail_version }}.zip"
     when: >
       not promtail_binary.stat.exists
       or (promtail_local_binary_location is defined
       and promtail_local_binary_location | length > 0)

   - name: Task 9 - Propagate locally distributed promtail archive if necessary
     copy:
       src: "{{ promtail_local_binary_location }}"
       dest: "/tmp/promtail-{{ promtail_version }}.zip"
     when: >
       promtail_local_binary_location is defined
       and promtail_local_binary_location | length > 0

   - name: Task 10 - Download promtail binaries to controller node if necessary
     get_url:
       url: "{{ promtail_url }}"
       dest: "/tmp/promtail-{{ promtail_version }}.zip"
     when: promtail_binary_propagate
     delegate_to: localhost

   - name: Task 11 - Propagate promtail binaries
     copy:
       src: "/tmp/promtail-{{ promtail_version }}.zip"
       dest: "/opt/promtail/{{ promtail_version }}/promtail-{{ promtail_version }}.zip"
     when: promtail_binary_propagate

   - name: Task 12 - Unpack promtail binaries
     unarchive:
       src: "/opt/promtail/{{ promtail_version }}/promtail-{{ promtail_version }}.zip"
       dest: "/opt/promtail/{{ promtail_version }}"
       remote_src: yes

   - name: Task 13 - Create a symlink to the latest version
     file:
       src: "/opt/promtail/{{ promtail_version }}/promtail"
       dest: /usr/local/bin/promtail
       state: link

   - name: Task 14 - Write the promtail configuration
     copy:
       content: "{{ promtail_config | to_nice_yaml }}"
       dest: /etc/promtail/config.yml
       owner: "{{ promtail_system_user }}"
       group: "{{ promtail_system_group }}"
       mode: '0644'

   - name: Task 15 - Create the systemd service unit
     template:
       src: promtail.service.j2
       dest: /etc/systemd/system/promtail.service
       owner: "{{ promtail_system_user }}"
       group: "{{ promtail_system_group }}"
       mode: '0644'

