---

   - name: Import Java Asserts and Setup Local Task Execution
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install Bash
     package:
       name: bash
       state: present

   - name: Install OpenJDK Java (Package)
     package:
       name: "java-{{ java_version }}-openjdk"
       state: present
     environment:
       USE: "X -cups -alsa -fontconfig"
     when: java_vendor == "openjdk"

   - name: Install RPM (Local Java Source)
     block:
       - name: Copy Oracle Java RPM package
         copy:
           src: oracle-java.rpm
           dest: /tmp/
       - name: Install Oracle Java RPM package
         yum:
           name: /tmp/oracle-java.rpm
           state: present
     when: java_source == "local" and java_format == "rpm"

   - name: Install DEB (Local Java Source)
     block:
       - name: Copy Oracle Java DEB package
         copy:
           src: oracle-java.deb
           dest: /tmp/
       - name: Install Oracle Java DEB package
         apt:
           name: /tmp/oracle-java.deb
           state: present
     when: java_source == "local" and java_format == "deb"

   - name: Install Oracle Java (RPM) (Repository)
     yum:
       name: java
       state: present
     when:
       - java_source == "repository"
       - java_format == "rpm"

   - name: Configure Oracle Targz
     block:
       - name: Ensure java_install_directory exists
         file:
           path: "{{ java_install_directory }}"
           state: directory
       - name: Install Oracle Java Targz package
         unarchive:
           src: oracle-java.targz
           dest: "{{ java_install_directory }}"
     when:
       - java_format == "targz"
       - java_vendor == "oracle"

   - name: Install Oracle Java Policy Software (Targz)
     unarchive:
       src: oracle-java-policy-software.targz
       dest: "{{ java_install_directory }}"
     when:
       - java_jce
       - java_version == 8
       - java_vendor == "oracle"

   - name: Set Alternative (Targz)
     alternatives:
       name: java
       path: "{{ java_install_directory }}/bin/java"
     when:
       - java_format == "targz"
       - ansible_distribution != "Alpine"
       - java_vendor == "oracle"

   - name: Find JAVA_HOME
     shell: readlink -f /usr/bin/java | sed "s:bin/java::"
     register: java_home

   - name: Set JAVA_HOME in /etc/environment
     lineinfile:
       path: /etc/profile.d/java_home.sh
       line: 'export JAVA_HOME="{{ java_home.stdout }}"'
       create: true
       mode: '0644'

   - name: Empty task for new line at the end of file
     debug:
       msg: ""

   # The empty task above is to ensure the file ends with a new line,
   # which is a good practice and is not considered a fault in yamllint.

