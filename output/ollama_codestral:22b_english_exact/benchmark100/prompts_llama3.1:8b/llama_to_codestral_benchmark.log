---
   - name: Create the document root for each vhost
     file:
       path: "{{ item.document_root }}"
       state: directory
       mode: '0755'
     when:
       - item.document_root is defined
       - item.create_docroot | default(True)
     loop: "{{ httpd_vhosts }}"

   - name: Configure the vhosts
     template:
       src: "{{ vhost_conf_template }}"
       dest: "/etc/httpd/sites-available/{{ item.name }}.conf"
       mode: '0644'
     notify:
       - Test httpd configuration validity
       - Restart httpd
     loop: "{{ httpd_vhosts }}"


