---
   - name: Import assert.yml file for task execution
     import_tasks: assert.yml
     tags: ['always']

   - name: Pre-configure Debian systems for postfix installation
     debconf:
       name: postfix
       question: postfix/main_mailer_type
       value: 'No configuration'
       vtype: string

   - name: Install postfix package
     package:
       name: postfix
       state: present

   - name: Install postfix-mysql package if specific conditions are met
     package:
       name: postfix-mysql
       state: present
     when: >-
       "mysql" in postfix_virtual_mailbox_maps or
       "mysql" in postfix_virtual_mailbox_domains or
       "mysql" in postfix_virtual_alias_maps

   - name: Configure postfix transport maps
     template:
       src: transport.j2
       dest: /etc/postfix/transport
     notify:
       - Validate postfix configuration
       - Rebuild transport maps database

   - name: Configure postfix header checks
     template:
       src: header_checks.j2
       dest: /etc/postfix/header_checks
     notify:
       - Validate postfix configuration
       - Reload postfix

   - name: Set values for the main.cf file
     set_fact:
       postfix_recipient_access_rules: "{{ postfix_recipient_access | default([]) }}"
       postfix_sender_access_rules: "{{ postfix_sender_access | default([]) }}"
       postfix_mynetworks: >-
         {{ postfix_mynetworks |
         default('127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128') }}
       postfix_mydestination: "{{ postfix_mydestination | default('') }}"
       postfix_relay_domains: "{{ postfix_relay_domains | default('') }}"
       postfix_smtpd_recipient_restrictions: >-
         {{ postfix_smtpd_recipient_restrictions |
         default('permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination') }}
       postfix_smtpd_sender_restrictions: >-
         {{ postfix_smtpd_sender_restrictions |
         default('permit_mynetworks, permit_sasl_authenticated, reject_unauth_pipelining') }}
       postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default('') }}"
       postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains | default('') }}"

   - name: Configure postfix main.cf
     template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify:
       - Validate postfix configuration
       - Restart postfix

   - name: Configure postfix master.cf
     template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify:
       - Validate postfix configuration
       - Restart postfix

   - name: Create a directory for TLS certificates and keys
     file:
       path: "/etc/postfix/{{ item }}"
       state: directory
     loop:
       - "tls"
       - "tls/private"

   - name: Deploy Postfix TLS server certificate
     copy:
       src: "{{ postfix_tls_server_certificate_file }}"
       dest: "/etc/postfix/tls/{{ postfix_tls_server_certificate_file | basename }}"
     notify:
       - Reload postfix

   - name: Deploy Postfix TLS server key
     copy:
       src: "{{ postfix_tls_server_key_file }}"
       dest: "/etc/postfix/tls/private/{{ postfix_tls_server_key_file | basename }}"
     notify:
       - Reload postfix

   - name: Flush handlers
     meta: flush_handlers

   - name: Configure aliases
     copy:
       content: "{{ postfix_aliases }}"
       dest: /etc/aliases
     notify:
       - Rebuild alias database
       - Reload postfix

   - name: Configure sender_access
     copy:
       content: "{{ postfix_sender_access }}"
       dest: /etc/postfix/sender_access
     notify:
       - Rebuild sender_access database
       - Reload postfix

   - name: Configure recipient_access
     copy:
       content: "{{ postfix_recipient_access }}"
       dest: /etc/postfix/recipient_access
     notify:
       - Validate postfix configuration
       - Rebuild recipient_access database
       - Reload postfix

   - name: Place sasl_password_map
     copy:
       content: "{{ postfix_smtp_sasl_password_map_content }}"
       dest: "{{ postfix_smtp_sasl_password_map }}"
     notify:
       - Rebuild sasl_password_map database

   - name: Flush handlers again
     meta: flush_handlers

   - name: Start and enable postfix service
     service:
       name: postfix
       state: started
       enabled: true


