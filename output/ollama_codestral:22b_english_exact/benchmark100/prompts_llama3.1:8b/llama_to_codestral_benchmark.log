---
   - name: Hardening | Disable Swap
     become: true
     when:
       - ansible_swaptotal_mb > 0
       - vault_hardening_disable_swap | default(false)
     block:
       - name: Disable swap temporarily
         command: swapoff -a
       - name: Disable swap permanently
         replace:
           path: /etc/fstab
           regexp: '^([^#].*?\sswap\s+sw\s+.*)$'
           replace: '# \1'

   - name: Hardening | Disable Core Dumps
     become: true
     when: vault_hardening_disable_core_dumps
     community.general.pam_limits:
       domain: '*'
       limit_type: '{{ item.type }}'
       limit_item: core
       value: 0
     loop:
       - {type: hard}
       - {type: soft}

   - name: Hardening | Disable Shell Command History
     become: true
     when: vault_hardening_disable_shell_command_history
     copy:
       src: vault.sh
       dest: /etc/profile.d/
       mode: '0644'

   - name: Hardening | Configure SELinux / AppArmor
     become: true
     block:
       - name: Install selinux-policy package
         package:
           name: selinux-policy
           state: present
       - name: Set SELinux policy to targeted
         ansible.posix.selinux:
           policy: targeted
           state: enforcing
       - name: Enforce AppArmor
         command: aa-enforce /etc/apparmor.d/*

   - name: Add linebreak at the end of file
     lineinfile:
       path: /dev/null
       line: ''
       state: present
       create: yes

