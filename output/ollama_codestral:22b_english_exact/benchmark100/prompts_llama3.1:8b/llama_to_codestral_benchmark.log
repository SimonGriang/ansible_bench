---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install the MySQL package
     package:
       name: mysql-server
       state: present
     notify:
       - Set MySQL root password
       - Systemctl daemon-reexec

   - name: Configure the MySQL server
     ini_file:
       path: "{{ mysql_configuration_destination }}/server.cnf"
       section: mysqld
       option: "{{ item.option }}"
       value: "{{ item.value }}"
     with_items: "{{ mysql_configuration_options }}"
     notify:
       - Restart MySQL server

   - name: Configure the MySQL client
     ini_file:
       path: "{{ mysql_configuration_destination }}/client.cnf"
       section: client
       option: socket
       value: "{{ mysql_socket }}"

   - name: Initialize the MySQL database
     shell: "{{ mysql_initialize_command }}"

   - name: Start and enable the MySQL service
     service:
       name: "{{ mysql_service }}"
       state: started
       enabled: yes

   - name: Flush handlers
     meta: flush_handlers

   - name: Place the my.cnf file
     template:
       src: my.cnf.j2
       dest: /root/.my.cnf

   - name: Create databases
     mysql_db:
       name: "{{ item.name }}"
       state: present
     with_items: "{{ mysql_databases }}"
     no_log: yes

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       host: "{{ item.host }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       state: present
     with_items: "{{ mysql_users }}"
     no_log: yes

   - name: Flush handlers again
     meta: flush_handlers

