   - name: Import assert.yml role
     import_role:
       name: assert
     run_once: true
     delegate_to: localhost

   - name: Install git package
     package:
       name: "{{ git_packages }}"
       state: present

   - name: Check if a user exists
     shell: "getent passwd {{ git_username }}"
     register: user_check
     ignore_errors: true
     when: git_username is defined

   - name: Create a directory for git configuration
     file:
       path: "/home/{{ git_username | default('') }}"
       state: directory
       owner: "{{ git_username | default(omit) }}"
       group: "{{ git_groupname | default(omit) }}"
     when: user_check.rc == 0

   - name: Configure git
