---
   - name: Import assert tasks
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install sysctl requirements
     package:
       name: "{{ sysctl_requirements }}"
       state: present

   - name: Set sysctl settings
     sysctl:
       name: "{{ item.name }}"
       value: "{{ item.value }}"
     with_items: "{{ sysctl_items | default([]) }}"
     when:
       - sysctl_items is defined
       - item.name is defined
       - item.value is defined
       - ansible_connection not in ['container', 'docker', 'community.docker.docker']
     loop_control:
       label: "{{ item.name }}"
     notify:
       - Reload sysctl settings

   - name: Ensure sysctl settings are reloaded
     sysctl:
       reload: true
     when: sysctl_reload | default(false) | bool
     changed_when: false
     notify:
       - Reload sysctl settings

   handlers:
     - name: Reload sysctl settings
       command: /sbin/sysctl -p
       changed_when: true
