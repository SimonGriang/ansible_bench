---
  - name: Import assert.yml
    import_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Uninstall systemd-logger
    package:
      name: systemd-logger
      state: absent

  - name: Install rsyslog and required packages
    package:
      name: "{{ rsyslog_packages }}"
      state: present

  - name: Install additional rsyslog features
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ rsyslog_features }}"

  - name: Configure default rsyslog configuration
    template:
      src: rsyslog.conf.j2
      dest: "{{ rsyslog_config_file }}"
      owner: root
      group: root
      mode: '0644'
    notify: Restart rsyslog
    when: rsyslog_deploy_default_config | bool

  - name: Create /etc/rsyslog.d/ directory
    file:
      path: /etc/rsyslog.d/
      state: directory
      mode: '0755'

  - name: Configure rsyslog forward rule
    template:
      src: forward_rule.conf.j2
      dest: /etc/rsyslog.d/forward_rule.conf
      owner: root
      group: root
      mode: '0644'
    notify: Restart rsyslog
    when: not rsyslog_deploy_default_config | bool

  - name: Configure additional rsyslog configuration files
    copy:
      content: "{{ item.value }}"
      dest: "/etc/rsyslog.d/{{ item.key }}"
      owner: root
      group: root
      mode: '0440'
    notify: Restart rsyslog
    loop: "{{ rsyslog_rsyslog_d_files | dict2items }}"

  - name: Start and enable rsyslog service
    service:
      name: rsyslog
      state: started
      enabled: true

