---
   - name: Load OS-specific variables
     include_vars: "{{ ansible_os_family }}.yml"

   - name: Include setup tasks for RedHat-based systems
     include_tasks: redhat_setup.yml
     when: ansible_os_family == 'RedHat'

   - name: Include setup tasks for Debian-based systems
     include_tasks: debian_setup.yml
     when: ansible_os_family == 'Debian'

   - name: Install Docker packages (non-RedHat/Debian or Ansible < 2.12)
     package:
       name: docker-ce
       state: present
     when: ansible_os_family != 'RedHat' or ansible_os_family != 'Debian' or ansible_version.full is version_compare('2.12', '<')

   - name: Install Docker packages (RedHat/Debian and Ansible >= 2.12)
     package:
       name: docker-ce
       state: present
       allow_downgrade: yes
     when: ansible_os_family == 'RedHat' or ansible_os_family == 'Debian' and ansible_version.full is version_compare('2.12', '>=')

   - name: Install docker-compose plugin (non-RedHat/Debian or Ansible < 2.12)
     package:
       name: docker-compose-plugin
       state: present
     when: docker_compose_plugin_enabled and (ansible_os_family != 'RedHat' or ansible_os_family != 'Debian' or ansible_version.full is version_compare('2.12', '<'))

   - name: Install docker-compose-plugin (RedHat/Debian and Ansible >= 2.12)
     package:
       name: docker-compose-plugin
       state: present
       allow_downgrade: yes
     when: docker_compose_plugin_enabled and (ansible_os_family == 'RedHat' or ansible_os_family == 'Debian') and ansible_version.full is version_compare('2.12', '>=')

   - name: Create Docker directory with correct permissions
     file:
       path: /etc/docker
       state: directory
       mode: '0755'

   - name: Configure Docker daemon options
     copy:
       src: daemon.json
       dest: /etc/docker/daemon.json
       mode: '0644'

   - name: Enable and start Docker service
     service:
       name: docker
       state: started
       enabled: yes
     when: docker_service_enabled

   - name: Notify handlers to update firewall rules
     changed_when: true
     notify: Update firewall rules

   - name: Include docker-compose management tasks
     include_tasks: docker_compose_management.yml
     when: docker_compose_enabled

   - name: Get information about the docker group
     command: getent group docker
     register: docker_group_info
     changed_when: false

   - name: Check if there are users to add to the docker group
     set_fact:
       users_to_add: "{{ docker_users | difference(docker_group_info.stdout_lines | map('regex_search', '^docker:.*:(.*)$') | map('first') | map('split', ',')) }}"

   - name: Include docker users management tasks
     include_tasks: docker_users_management.yml
     when: users_to_add | length > 0


