 - name: Restart RKE2 service
     service:
       name: rke2-server
       state: restarted
     notify: Service restarted

   - name: Wait for all nodes to be ready
     shell: "kubectl get nodes | awk 'NR>1 {print $2}' | grep -v 'Ready' | wc -l"
     register: all_ready_nodes
     until: all_ready_nodes.stdout == "0"
     retries: 100
     delay: 15
     run_once: true
     delegate_to: "{{ ansible_play_hosts_all | intersect(groups[rke2_servers_group_name]) | first }}"
     when: not ansible_check_mode

   - name: Wait for all pods to be ready
     shell: "kubectl get pods --all-namespaces | awk 'NR>1 {print $3}' | grep -v 'Running\|Succeeded' | wc -l"
     register: all_pods_ready
     until: all_pods_ready.stdout == "0"
     retries: 100
     delay: 15
     run_once: true
     delegate_to: "{{ ansible_play_hosts_all | intersect(groups[rke2_servers_group_name]) | first }}"
     when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready | bool

