      state: directory
      mode: '0755'

  - name: Initialize EasyRSA PKI directory
    command: easyrsa init-pki
    args:
      chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki

  - name: Build CA certificate using EasyRSA
    command: easyrsa build-ca nopass
    args:
      chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/ca.crt

  - name: Generate DH parameters using EasyRSA
    command: easyrsa gen-dh
    args:
      chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/dh.pem

  - name: Build server certificate using EasyRSA
    command: easyrsa build-server-full server nopass
    args:
      chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/issued/server.crt

  - name: Build client certificate using EasyRSA
    command: easyrsa build-client-full client nopass
    args:
      chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/issued/client.crt

  - name: Generate Certificate Revocation List (CRL) using EasyRSA
    command: easyrsa gen-crl
    args:
      chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/crl.pem

  - name: Generate Diffie-Hellman (DH) key using OpenVPN
    command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
    args:
      creates: /etc/openvpn/easy-rsa/pki/ta.key

  - name: Copy files to /etc/openvpn/server directory
    copy:
      src: "{{ item.src }}"
      dest: "/etc/openvpn/server/{{ item.dest }}"
      remote_src: yes
    with_items:
      - { src: '/etc/openvpn/easy-rsa/pki/ca.crt', dest: 'ca.crt' }
      - { src: '/etc/openvpn/easy-rsa/pki/dh.pem', dest: 'dh.pem' }
      - { src: '/etc/openvpn/easy-rsa/pki/ta.key', dest: 'ta.key' }
      - { src: '/etc/openvpn/easy-rsa/pki/issued/server.crt', dest: 'server.crt' }
      - { src: '/etc/openvpn/easy-rsa/pki/issued/client.crt', dest: 'client.crt' }
      - { src: '/etc/openvpn/easy-rsa/pki/private/server.key', dest: 'server.key' }
      - { src: '/etc/openvpn/easy-rsa/pki/private/client.key', dest: 'client.key' }

  - name: Copy files to /etc/openvpn directory
    copy:
      src: "{{ item.src }}"
      dest: "/etc/openvpn/{{ item.dest }}"
      remote_src: yes
    with_items:
      - { src: '/etc/openvpn/easy-rsa/pki/ca.crt', dest: 'ca.crt' }
      - { src: '/etc/openvpn/easy-rsa/pki/ta.key', dest: 'ta.key' }

  - name: Place the server.conf file
    template:
      src: server.conf.j2
      dest: /etc/openvpn/server.conf
      owner: root
      group: root
      mode: '0644'

