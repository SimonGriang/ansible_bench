---
   - name: Migrate adoptopenjdk to temurin
     set_fact:
       java_jdk_vendor: "temurin"
     when: java_jdk_vendor == "adoptopenjdk"

   - name: Gather OS specific variables
     include_vars: "{{ java_jdk_vendor }}-{{ ansible_os_family | lower }}-{{ ansible_distribution_major_version }}.yml"

   - name: Gather architecture specific variables
     include_vars: architecture.yml

   - name: Set OS-specific variables (I)
     set_fact:
       java_open_jdk_key_repo: "{{ java_open_jdk_key_repo_override | default(java_open_jdk_key_repo) }}"
       java_open_jdk_repo: "{{ java_open_jdk_repo_override | default(java_open_jdk_repo) }}"
     when: java_open_jdk_key_repo is defined and java_open_jdk_repo is defined

   - name: Set OS and architecture specific variables (II)
     set_fact:
       java_open_jdk_home_dir: "{{ java_open_jdk_home_dir_override | default(java_open_jdk_home_dir) }}"
       java_open_jdk_package: "{{ java_open_jdk_package_override | default(java_open_jdk_package) }}"
     when: java_open_jdk_home_dir is defined and java_open_jdk_package is defined

   - name: Set specific variables
     set_fact:
       java_home: "{{ java_open_jdk_home }}"

   - name: Debian pre-requisites
     block:
       - name: Remove deprecated repositories
         apt_repository:
           repo: "deb http://ppa.launchpad.net/openjdk-r/ppa/ubuntu {{ ansible_distribution_release }} main"
           state: absent
       - name: Install extra apt tools
         apt:
           name:
             - software-properties-common
             - apt-transport-https
           state: present
       - name: Add required key repositories
         apt_key:
           url: "{{ java_open_jdk_key_repo }}"
           state: present
       - name: Add required repositories
         apt_repository:
           repo: "deb {{ java_open_jdk_repo }} {{ ansible_distribution_release }} main"
           state: present
     when: ansible_os_family == "Debian"

   - name: RedHat pre-requisites
     block:
       - name: Add required key repositories
         rpm_key:
           key: "{{ java_open_jdk_key_repo }}"
           state: present
       - name: Add required repositories
         yum_repository:
           name: "openjdk"
           description: "OpenJDK"
           baseurl: "{{ java_open_jdk_repo }}"
     when: ansible_os_family == "RedHat"

   - name: Install required libs
     package:
       name: "{{ java_open_jdk_required_libs }}"
       state: present

   - name: Install Java, Debian
     apt:
       name: "{{ java_open_jdk_package }}"
       state: present
     when: ansible_os_family == "Debian"

   - name: Install Java, RedHat
     yum:
       name: "{{ java_open_jdk_package }}"
       state: present
     when: ansible_os_family == "RedHat"

   - name: Export environment variables
     template:
       src: jdk.sh.j2
       dest: /etc/profile.d/jdk.sh

   - name: Source environment variables
     shell: source /etc/profile

   - name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
     set_fact:
       java_home: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre"
     when: ansible_java.version.major < 11

   - name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
     set_fact:
       java_home: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}"
     when: ansible_java.version.major >= 11

