---
   - name: Import assert.yml tasks
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Wait for port to be available
     wait_for:
       port: "{{ port_number }}"
       timeout: "{{ bootstrap_timeout }}"
     when:
       - ansible_connection is defined
       - ansible_connection not in ["container", "docker", "community.docker.docker"]
       - ansible_connection != "none"
       - bootstrap_wait_for_host | bool
     delegate_to: localhost

   - name: Prepare system
     become: true
     block:
       - name: Connection test
         raw: "true"
         register: connection_test_result
         ignore_unreachable: true
       - name: Gather bootstrap facts
         setup:
         when: connection_test_result.failed | bool
       - name: Sudo test
         raw: "sudo -l -U {{ ansible_ssh_user }}"
         register: sudo_test_result
         ignore_unreachable: true
         ignore_errors: true
       - name: Install bootstrap packages
         raw: "{{ ansible_pkg_mgr }} install -y sudo"
         when: sudo_test_result.failed | bool
       - name: Ensure libdnf5 is present on Fedora/RedHat
         raw: "{{ ansible_pkg_mgr }} install -y dnf5"
         when:
           - ansible_os_family == "RedHat"
           - ansible_distribution != "Fedora"

   - name: Gather ansible facts
     setup:
       gather_subset: all

   - name: Install bootstrap packages (package)
     package:
       name: "{{ item }}"
       state: present
     become: "{{ bootstrap_become }}"
     loop: "{{ bootstrap_facts_packages }}"

   # The last line must be empty for correct YAML formatting

