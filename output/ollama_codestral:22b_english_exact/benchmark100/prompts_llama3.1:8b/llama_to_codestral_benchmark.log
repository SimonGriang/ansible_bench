---
- name: Enable 'proxy' and 'proxy_http' Apache2 modules
  ansible.builtin.apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  when: ansible_os_family == 'Debian' or ansible_os_family == 'Suse'
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Configure Apache2 locations
  ansible.builtin.template:
    src: location.conf.j2
    dest: "/etc/apache2/sites-available/{{ item }}.conf"
    mode: '0644'
  loop: "{{ httpd_locations }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd


