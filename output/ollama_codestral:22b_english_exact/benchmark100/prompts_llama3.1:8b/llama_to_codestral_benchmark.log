---
   - name: Execute tasks on localhost
     hosts: localhost
     tasks:
       - name: Import and run assert.yml file
         import_tasks: assert.yml

       - name: Install required packages
         package:
           name: "{{ selinux_requirements }}"
           state: present
         notify: Gather facts

       - name: Flush handlers
         meta: flush_handlers

       - name: Configure selinux
         when: >
           selinux_status is defined
           and connection not in ['container', 'docker', 'community.docker.docker']
         block:
           - name: Manage selinux settings
             selinux:
               state: "{{ selinux_state }}"
               policy: "{{ selinux_policy }}"
             notify: Reboot

           - name: Manage selinux booleans
             when: selinux_booleans is defined
             seboolean:
               name: "{{ item.name }}"
               state: "{{ item.state }}"
               persistent: "{{ item.persistent | default('yes') }}"
             loop: "{{ selinux_booleans }}"

