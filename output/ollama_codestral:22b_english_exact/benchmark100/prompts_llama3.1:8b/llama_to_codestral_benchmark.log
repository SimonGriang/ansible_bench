---
   - name: Task 1 - Assert that systemd is being used as the init system
     assert:
       that:
         - ansible_service_mgr == "systemd"
       fail_msg: "This playbook is meant for systemd-based systems only."
       success_msg: "System is using systemd."

   - name: Task 2 - Get the latest release of the Grafana Loki project
     uri:
       url: "https://api.github.com/repos/grafana/loki/releases/latest"
       return_content: yes
       status_code: 200
     register: _latest_release
     until: _latest_release.status == 200
     retries: 5
     delay: 2

   - name: Task 3 - Set the promtail version to the latest release tag
     set_fact:
       promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
     when: promtail_version == 'latest'

   - name: Task 4 - Test if the zip local archive exists in the specified directory
     stat:
       path: "{{ local_directory }}"
     register: _local_dir

   - name: Task 5 - Assert that the local binary exists in the specified directory
     assert:
       that:
         - _local_dir.stat.exists == true
         - _local_dir.stat.isdir == true
         - (local_directory + '/promtail-linux-' + arch + '.zip') is exists
       fail_msg: "The promtail binary archive does not exist in the specified directory."
       success_msg: "The promtail binary archive exists in the specified directory."
     when: _local_dir.stat.exists and _local_dir.stat.isdir

   - name: Task 6 - Get the checksum list for the latest release
     uri:
       url: "https://api.github.com/repos/grafana/loki/releases/{{ _latest_release.json.id }}"
       return_content: yes
       status_code: 200
     register: __promtail_checksums

   - name: Task 7 - Get the checksum for the specified architecture
     set_fact:
       __promtail_checksum: "{{ item.split(' ')[0] }}"
     loop: "{{ __promtail_checksums.json.assets | json_query(query) }}"
     vars:
       query: "[?contains(browser_download_url, 'promtail-linux-{{ arch }}.zip')].browser_download_url"
     when: not _local_dir.stat.exists or not _local_dir.stat.isdir

