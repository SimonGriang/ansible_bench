 - name: Import assert tasks for the httpd role
      ansible.builtin.import_tasks: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Install Apache HTTP Server
      ansible.builtin.package:
        name: "{{ httpd_packages }}"
        state: present

    - name: Configure SELinux settings for httpd service
      block:
        - name: Modify SELinux settings for httpd service
          community.general.seboolean:
            name: "{{ item }}"
            state: yes
            persistent: yes
          loop: "{{ httpd_sebooleans }}"

        - name: Allow connections to custom ports and SSL port
          community.general.seport:
            ports: "{{ httpd_port }}"
            proto: tcp
            setype: http_port_t
            state: present

        - name: Allow SSL port if defined
          community.general.seport:
            ports: 443
            proto: tcp
            setype: http_port_t
            state: present
      when: ansible_selinux.status == 'enabled'

    - name: Configure Apache HTTP Server
      ansible.builtin.template:
        src: "{{ httpd_config_src }}"
        dest: /etc/httpd/conf/httpd.conf
        mode: 0644
      notify:
        - Test httpd configuration validity
        - Restart httpd

    - name: Activate Apache HTTP Server modules on Debian-based systems
      ansible.builtin.command: a2enmod {{ httpd_modules_to_activate_with_command | join(' ') }}
      notify: Test httpd configuration validity
      when: ansible_os_family == 'Debian'

    - name: Import SSL configuration tasks
      ansible.builtin.import_tasks: ssl.yml
      when: https_ssl_enable is defined

    - name: Import locations configuration tasks
      ansible.builtin.import_tasks: locations.yml
      when: httpd_locations is defined

    - name: Import virtual hosts configuration tasks
      ansible.builtin.import_tasks: vhosts.yml
      when: httpd_vhosts is defined

    - name: Configure custom ports for Apache HTTP Server
      ansible.builtin.template:
        src: "{{ httpd_ports_conf }}"
        dest: /etc/httpd/conf.d/ports.conf
      notify:
        - Test httpd configuration validity
        - Restart httpd
      when: ansible_os_family in ['Debian', 'Suse']

    - name: Import directories configuration tasks
      ansible.builtin.import_tasks: directories.yml
      when: httpd_directories is defined

    - name: Flush handlers
      ansible.builtin.meta: flush_handlers

    - name: Remove default index.html file
      ansible.builtin.file:
        path: /var/www/html/index.html
        state: absent
      when: httpd_remove_example is defined

    - name: Start and enable Apache HTTP Server service
      ansible.builtin.service:
        name: httpd
        state: started
        enabled: true

