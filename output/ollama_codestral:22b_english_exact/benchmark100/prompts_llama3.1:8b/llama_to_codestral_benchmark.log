---
   - name: Create local ssh key directory for a user
     file:
       path: "{{ ssh_key_dir }}"
       state: directory
       mode: '0750'

   - name: Manage the user account
     user:
       name: "{{ user_name }}"
       comment: "{{ user_comment }}"
       group: "{{ user_group }}"
       create_home: "{{ create_home }}"
       password: "{{ user_password }}"
       expires: "{{ user_expires }}"

   - name: Set up the user's sudo options
     template:
       src: sudoer.j2
       dest: "/etc/sudoers.d/{{ user_name }}"
       mode: '0440'
       validate: 'visudo -csf %s'
     when: user_sudo_options is defined

   - name: Remove the user's sudo configuration if no sudo options are defined
     file:
       path: "/etc/sudoers.d/{{ user_name }}"
       state: absent
     when: user_sudo_options is not defined

   - name: Generate the user's private SSH key
     command: "ssh-keygen -t rsa -b 2048 -N '' -f {{ ssh_key_dir }}/{{ user_name }}"
     when: user_ssh_key_management
     args:
       creates: "{{ ssh_key_dir }}/{{ user_name }}"

   - name: Generate the user's public SSH key
     command: "ssh-keygen -y -f {{ ssh_key_dir }}/{{ user_name }}"
     when: user_ssh_key_management
     args:
       creates: "{{ ssh_key_dir }}/{{ user_name }}.pub"

   - name: Convert the user's SSH key to PPK format
     command: "ssh-keygen -p -P '' -f {{ ssh_key_dir }}/{{ user_name }} -m PEM -e"
     when: user_ssh_key_management
     args:
       creates: "{{ ssh_key_dir }}/{{ user_name }}.ppk"

   - name: Get or set the user's home directory
     shell: "getent passwd {{ user_name }} | cut -d: -f6 || echo {{ default_home_dir }}"
     register: user_home

   - name: Set the user's home directory
     set_fact:
       base_home_dir: "{{ user_home.stdout }}"

   - name: Create the user's .ssh directory
     file:
       path: "{{ base_home_dir }}/.ssh"
       state: directory
       mode: '0700'
       owner: "{{ user_name }}"
       group: "{{ user_group }}"

   - name: Deploy authorized keys for the user
     authorized_key:
       user: "{{ user_name }}"
       key: "{{ item }}"
       state: present
       exclusive: no
     loop: "{{ user_authorized_keys }}"
     when: user_authorized_keys is defined

   - name: Set the permissions of the authorized keys file
     file:
       path: "{{ base_home_dir }}/.ssh/authorized_keys"
       mode: '0600'

   - name: Remove unauthorized keys for the user
     authorized_key:
       user: "{{ user_name }}"
       key: "{{ item }}"
       state: absent
     loop: "{{ user_unauthorized_keys }}"
     when: user_unauthorized_keys is defined

   - name: Copy the generated private SSH key for the user
     copy:
       src: "{{ ssh_key_dir }}/{{ user_name }}"
       dest: "{{ base_home_dir }}/.ssh/id_rsa"
       mode: '0400'
     when: user_copy_private_key

   - name: Check the user's password validity
     shell: "chage -l {{ user_name }} | grep 'Password expires' | awk '{print $3}'"
     register: users_pw_valid

   - name: Set the user's password validity
     command: "chage -d 0 {{ user_name }}"
     when: user_password_validity is defined and users_pw_valid.stdout != "never"

   - name: Place the private key file for the user
     copy:
       src: "{{ ssh_key_dir }}/{{ user_name }}"
       dest: "{{ base_home_dir }}/.ssh/id_rsa"
       mode: '0400'
     when: user_private_keys is defined
   

