 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Install the mysql package
     package:
       name: mysql
       state: present

   - name: Configure the mysql server
     template:
       src: "{{ mysql_name }}-server.cnf.j2"
       dest: "{{ mysql_config_directory }}/{{ mysql_name }}-server.cnf"
       owner: root
       group: root
       mode: 0644
     with_items: "{{ mysql_configuration_options }}"

   - name: Configure the mysql client
     template:
       src: "{{ mysql_name }}-client.cnf.j2"
       dest: "{{ mysql_config_directory }}/{{ mysql_name }}-client.cnf"
       owner: root
       group: root
       mode: 0644
     vars:
       mysql_socket: "{{ mysql_socket_path }}"

   - name: Initialize the mysql service
     command: "{{ mysql_initialize_command }}"
     when: ansible_os_family == 'Alpine' or ansible_os_family == 'Archlinux'

   - name: Start and enable the mysql service
     service:
       name: mysql
       state: started
       enabled: yes

   - name: Flush handlers
     meta: flush_handlers

   - name: Create my.cnf file in /root/.my.cnf
     template:
       src: my.cnf.j2
       dest: /root/.my.cnf
       owner: root
       group: root
       mode: 0600

   - name: Create databases
     community.mysql.mysql_db:
       name: "{{ item.name }}"
       state: present
     with_items: "{{ mysql_databases }}"

   - name: List databases
     community.mysql.mysql_info:
       login_user: root
       login_password: "{{ mysql_root_password }}"
       filter:
         - databases

   - name: Import databases
     community.mysql.mysql_db:
       name: "{{ item.name }}"
       state: import
       target: "{{ item.initial_import }}"
     with_items: "{{ mysql_databases }}"
     when: item.initial_import is defined

   - name: Create users
     community.mysql.mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       host: "{{ item.host | default('localhost') }}"
       state: present
     with_items: "{{ mysql_users }}"

   - name: Flush handlers
     meta: flush_handlers

