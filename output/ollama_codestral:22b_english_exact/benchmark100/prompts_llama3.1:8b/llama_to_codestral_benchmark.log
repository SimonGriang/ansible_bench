 - name: Create the Vault group
     group:
       name: "{{ vault_group }}"
       system: true

   - name: Create the Vault user
     user:
       name: "{{ vault_user }}"
       shell: "{{ vault_user_shell }}"
       group: "{{ vault_group }}"

   - name: Create the Vault download directory
     file:
       path: "{{ vault_download_path }}"
       state: directory
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: '0755'

   - name: Download the Vault binary
     get_url:
       url: "{{ vault_download_url }}"
       dest: "{{ vault_download_path }}"
     unarchive:
       src: "{{ vault_download_path }}/vault.zip"
       dest: "{{ vault_download_path }}"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: '0755'

   - name: Check if the vault_path exists
     stat:
       path: "{{ vault_path }}"
     register: vault_path_stat

   - name: Create vault_path if it does not exist
     file:
       path: "{{ vault_path }}"
       state: directory
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: '0755'
     when: not vault_path_stat.stat.exists

   - name: Create directories in vault_path
     file:
       path: "{{ vault_path }}/{{ item }}"
       state: directory
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: '0755'
     loop: "{{ vault_directories }}"

   - name: Create data directories
     file:
       path: "{{ item }}"
       state: directory
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: '0755'
     loop: "{{ vault_data_directories }}"

   - name: Generate TLS key and certificate
     shell: >
       openssl req -new -newkey rsa:4096 -days 3650 -nodes -x509
       -subj "/C=US/ST=Denial/L=Springfield/O=Dis/CN=vault.service.consul"
       -keyout "{{ vault_path }}/tls.key" -out "{{ vault_path }}/tls.crt"

   - name: Set ownership of TLS material
     file:
       path: "{{ item }}"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
     loop: "{{ vault_tls_files }}"

   - name: Copy the Vault binary
     copy:
       src: "{{ vault_download_path }}/vault"
       dest: "/usr/bin/vault"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: '0755'

   - name: Set cap_ipc_lock=ep on /usr/bin/vault
     capabilities:
       path: "/usr/bin/vault"
       capability: cap_ipc_lock=ep
       state: present

   - name: Touch vault.env
     file:
       path: "{{ vault_path }}/vault.env"
       state: touch
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: '0644'

   - name: Create /usr/lib/systemd/system
     file:
       path: "/usr/lib/systemd/system"
       state: directory
       owner: root
       group: root
       mode: '0755'

   - name: Copy the Vault service file
     copy:
       src: "files/vault.service"
       dest: "/usr/lib/systemd/system/vault.service"
       owner: root
       group: root
       mode: '0644'

   - name: Copy the Vault configuration
     copy:
       src: "files/vault.hcl"
       dest: "{{ vault_path }}/vault.hcl"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: '0644'

   - name: Flush handlers
     meta: flush_handlers

