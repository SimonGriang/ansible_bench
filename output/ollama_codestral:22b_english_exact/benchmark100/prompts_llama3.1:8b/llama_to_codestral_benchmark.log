 - name: Create RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory
       owner: root
       group: root
       mode: '0755'

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_type == 'server'

   - name: Set agent taints
     set_fact:
       combined_node_taints: "{{ rke2_agent_node_taints }}"
     when: rke2_type == 'agent'

   - name: Copy RKE2 config
     copy:
       src: "{{ rke2_config_src }}"
       dest: "{{ rke2_config_dest }}"
       owner: root
       group: root
       mode: '0644'
     notify: Config file changed

   - name: Copy kubelet config
     template:
       src: kubelet.config.j2
       dest: "{{ rke2_kubelet_config_dest }}"
       owner: root
       group: root
       mode: '0644'
     when: rke2_kubelet_config is not empty
     notify: Config file changed

   - name: Copy Containerd Registry Configuration file
     copy:
       src: "{{ rke2_containerd_config_src }}"
       dest: "{{ rke2_containerd_config_dest }}"
       owner: root
       group: root
       mode: '0644'
     when: rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty
     notify: Config file changed

   - name: Start RKE2 service on the rest of the nodes
     systemd:
       name: "{{ rke2_service_name }}"
       state: started
       enabled: yes
     register: service_result
     retries: 10
     delay: 10
     until: service_result is succeeded
     notify: Service (re)started

   - name: Mask other RKE2 service on the rest of the nodes
     systemd:
       name: "{{ item }}"
       masked: yes
     loop: "{{ rke2_services }}"
     when: item != rke2_type

   - name: Wait for remaining nodes to be ready - no CNI
     command: "kubectl get nodes --no-headers=true -o name | grep '{{ item }}'"
     register: node_status
     retries: 20
     delay: 30
     until: node_status.rc == 0
     loop: "{{ rke2_node_group }}"

   - name: Wait for remaining nodes to be ready - with CNI
     shell: "kubectl get nodes --field-selector=status.conditions[?(@.type=='Ready')].status=='True' --no-headers=true | wc -l"
     register: ready_nodes
     retries: 20
     delay: 30
     until: ready_nodes.stdout|int == rke2_node_group|length
     when: inventory_hostname == rke2_active_server or inventory_hostname == rke2_node_group[0]

