---
- name: Restart RKE2 service on a node
  become: yes
  service:
    name: rke2-server
    state: restarted
  notify: Service restarted
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  shell: kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' | grep -c True
  register: all_ready_nodes
  retries: 100
  delay: 15
  until: all_ready_nodes.stdout == rke2_node_count
  delegate_to: "{{ groups[rke2_servers_group_name] | first }}"
  run_once: yes
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  shell: kubectl get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded | wc -l
  register: all_pods_ready
  retries: 100
  delay: 15
  until: all_pods_ready.stdout == "0"
  delegate_to: "{{ groups[rke2_servers_group_name] | first }}"
  run_once: yes
  when:
    - not ansible_check_mode
    - rke2_wait_for_all_pods_to_be_ready


