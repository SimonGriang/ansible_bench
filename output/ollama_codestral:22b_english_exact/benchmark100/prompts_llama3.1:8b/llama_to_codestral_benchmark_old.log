---
   - name: Import assert.yml role
     import_role:
       name: assert
     delegate_to: localhost
     run_once: true

   - name: Install git package
     package:
       name: "{{ git_packages }}"
       state: present

   - name: Check if a user exists
     shell: "getent passwd {{ git_username }}"
     register: user_exists
     ignore_errors: true
     when: git_username is defined

   - name: Create a directory for git configuration
     file:
       path: "/home/{{ git_username }}"
       state: directory
       owner: "{{ git_username | default(omit) }}"
       group: "{{ git_groupname | default(omit) }}"
     when: user_exists.rc == 0

   - name: Configure git
     template:
       src: gitconfig.j2
       dest: "/home/{{ git_username }}/.gitconfig"
       mode: "0644"
     when: user_exists.rc == 0 and git_user_email is defined and git_user_name is defined and git_username is defined

   - name: Create the repository destination
     file:
       path: "{{ git_repository_destination }}"
       state: directory
       owner: "{{ git_username | default(omit) }}"
       group: "{{ git_groupname | default(omit) }}"
     when: user_exists.rc == 0

   - name: Clone all specified repositories
     git:
       repo: "{{ item.repo }}"
       dest: "{{ item.dest | default(git_repository_destination + '/' + item.repo.split('/')[-1].replace('.git', '')) }}"
       version: "{{ item.version | default('HEAD') }}"
       force: "{{ item.force | default(false) }}"
     become_user: "{{ git_username }}"
     with_items: "{{ git_repositories }}"
     when: user_exists.rc == 0 and git_repositories is defined and git_repository_destination is defined

