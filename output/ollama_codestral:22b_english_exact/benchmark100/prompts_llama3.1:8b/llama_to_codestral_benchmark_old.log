- name: Run bash command to prepare summary on RKE2 nodes
  shell: >
    kubectl get nodes
    -o=custom-columns='NAME:.metadata.name,STATUS:.status.conditions[?(@.type=="Ready")].status,ROLES:.metadata.labels."node-role.kubernetes.io/master",AGE:.metadata.creationTimestamp'
    | tee /tmp/k8s_nodes_summary
  register: nodes_summary

- name: Debug the K8s nodes state
  debug:
    var: nodes_summary.stdout_lines


