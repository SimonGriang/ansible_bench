---
   - name: Import assert tasks
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install sysctl requirements
     package:
       name: "{{ sysctl_requirements }}"
       state: present

   - name: Set sysctl settings
     sysctl:
       name: "{{ item.name }}"
       value: "{{ item.value }}"
     loop: "{{ sysctl_items }}"
     loop_control:
       label: "{{ item.name }}"
     when:
       - sysctl_items is defined
       - item.name is defined
       - item.value is defined
       - ansible_connection not in [
           'container',
           'docker',
           'community.docker.docker'
         ]
     notify: Reload sysctl

   - name: Reload sysctl
     sysctl:
       reload: true
     when: sysctl_reload | bool

   handlers:
     - name: Reload sysctl
       sysctl:
         reload: true


