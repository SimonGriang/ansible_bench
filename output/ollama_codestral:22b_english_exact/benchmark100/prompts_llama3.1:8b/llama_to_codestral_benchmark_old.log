---
   - name: Cordon and Drain the RKE2 Node
     shell: "{{ rke2_data_path }}/kubectl drain {{ rke2_node_name }} {{ rke2_drain_additional_args | default('') }} --ignore-daemonsets"
     register: drain_result
     changed_when: "'successfully drained' in drain_result.stdout"
     retries: 100
     delay: 15
     until: drain_result is not failed and 'successfully drained' in drain_result.stdout

   - name: Restart the RKE2 Service
     service:
       name: "{{ rke2_service_name }}"
       state: restarted

   - name: Wait for All Nodes to be Ready
     shell: "{{ rke2_data_path }}/kubectl wait --for=condition=Ready nodes --all --timeout=0s --selector=rke.cattle.io/cluster-group={{ rke2_cluster_group_name }}"
     register: nodes_ready_result
     retries: 100
     delay: 15
     until: nodes_ready_result.rc == 0

   - name: Uncordon the RKE2 Node
     shell: "{{ rke2_data_path }}/kubectl uncordon {{ rke2_node_name }}"
     register: uncordon_result
     changed_when: "'uncordoned' in uncordon_result.stdout"

   - name: Wait for All Pods to be Ready
     shell: "{{ rke2_data_path }}/kubectl wait --for=condition=Ready pods --all --all-namespaces --timeout=0s"
     register: pods_ready_result
     retries: 100
     delay: 15
     until: pods_ready_result.rc == 0

   - name: Wait for All Pods to be Healthy
     shell: "{{ rke2_data_path }}/kubectl wait --for=condition=Ready pods --all --all-namespaces --timeout=0s {{ rke2_wait_for_all_pods_to_be_healthy_args | default('') }}"
     register: pods_healthy_result
     retries: 100
     delay: 15
     until: pods_healthy_result.rc == 0

