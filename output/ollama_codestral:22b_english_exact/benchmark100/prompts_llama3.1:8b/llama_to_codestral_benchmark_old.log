---
- name: Assert package manager
  import_tasks: assert.yml

- name: Configure package management for apk
  block:
    - name: Update cache
      apk:
        update_cache: yes
    - name: Install all available packages
      apk:
        upgrade: yes
  when: ansible_pkg_mgr == 'apk'

- name: Configure package management for apt
  block:
    - name: Prevent packages from being upgraded
      dpkg_selections:
        name: "{{ item }}"
        selection: hold
      loop:
        - package1
        - package2
    - name: Update all software
      apt:
        update_cache: yes
        upgrade: safe
    - name: Autoremove unnecessary packages
      apt:
        autoremove: yes
  when: ansible_pkg_mgr == 'apt'

- name: Update all software for dnf
  block:
    - name: Update all packages
      dnf:
        name: '*'
        state: latest
        exclude:
          - package1
          - package2
  when: ansible_pkg_mgr == 'dnf'

- name: Update all software for pacman
  block:
    - name: Update package cache
      pacman:
        update_cache: yes
    - name: Upgrade all packages
      pacman:
        upgrade: yes
  when: ansible_pkg_mgr == 'pacman'

- name: Configure package management for yum
  block:
    - name: Update all software using dnf
      dnf:
        name: '*'
        state: latest
      when: ansible_distribution_major_version == '6'
    - name: Ensure yum-utils is installed
      package:
        name: yum-utils
        state: present
      when: ansible_distribution_major_version != '6'
  when: ansible_pkg_mgr == 'yum'

- name: Update all software for zypper
  block:
    - name: Update all packages
      zypper:
        name: '*'
        state: latest
  when: ansible_pkg_mgr == 'zypper'


