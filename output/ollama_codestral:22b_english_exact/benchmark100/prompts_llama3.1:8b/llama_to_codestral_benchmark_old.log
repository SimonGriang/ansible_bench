 - name: Import assert.yml file
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Wait for port to be available
     wait_for:
       port: "{{ port_number }}"
       timeout: "{{ bootstrap_timeout }}"
     when:
       - ansible_connection is defined
       - ansible_connection not in ["container", "docker", "community.docker.docker"]
       - ansible_connection != "none"
       - bootstrap_wait_for_host | bool

   - name: Prepare system
     block:
       - name: Connection test
         command: /usr/bin/true
         failed_when: false
         changed_when: false
         register: connection_test
       - name: Sudo test
         command: /usr/bin/sudo /usr/bin/true
         failed_when: false
         changed_when: false
         register: sudo_test
     become: yes
     when: connection_test is failed or sudo_test is failed

   - name: Gather ansible facts
     setup:
       gather_subset: all
     become: no

   - name: Install bootstrap packages (package)
     package:
       name: "{{ item }}"
     become: "{{ bootstrap_become }}"
     loop: "{{ bootstrap_facts_packages }}"
     when: sudo_test is failed
     notify:
       - Ensure libdnf5 is present on Fedora/RedHat

   - name: Ensure libdnf5 is present on Fedora/RedHat
     package:
       name: libdnf5
       state: present
     become: "{{ bootstrap_become }}"
     when: ansible_os_family == 'RedHat' and sudo_test is failed


