---
   - name: import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost

   - name: install apache httpd package
     package:
       name: "{{ httpd_packages }}"
       state: present

   - name: configure selinux if enabled
     block:
       - name: modify selinux settings
         seboolean:
           name: "{{ httpd_sebooleans }}"
           state: true
           persistent: true
       - name: allow connections to custom ports
         seport:
           ports: "{{ httpd_port }},{{ httpd_ssl_port }}"
           proto: tcp
           setype: http_port_t
           state: present
     when: ansible_selinux.status == "enabled"

   - name: configure httpd service
     template:
       src: "{{ httpd_config_src }}"
       dest: "{{ httpd_config_dest }}"

   - name: activate httpd module on Debian systems
     command: "a2enmod {{ httpd_modules_to_activate_with_command }}"
     when: ansible_os_family == "Debian"

   - name: import ssl.yml if https_ssl_enable is true
     import_tasks: ssl.yml
     when: https_ssl_enable | bool

   - name: import locations.yml if httpd_locations is defined
     import_tasks: locations.yml
     when: httpd_locations is defined

   - name: import vhosts.yml if httpd_vhosts is defined
     import_tasks: vhosts.yml
     when: httpd_vhosts is defined

   - name: configure ports on Debian and Suse systems
     template:
       src: "{{ httpd_ports_conf.j2 }}"
       dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
     when: ansible_os_family in ["Debian", "Suse"]

   - name: import directories.yml if httpd_directories is defined
     import_tasks: directories.yml
     when: httpd_directories is defined

   - name: remove default index.html file if httpd_remove_example is true
     file:
       path: "{{ httpd_data_directory }}/index.html"
       state: absent
     when: httpd_remove_example | bool

   - name: start and enable httpd service
     service:
       name: "{{ httpd_service }}"
       state: started
       enabled: true

