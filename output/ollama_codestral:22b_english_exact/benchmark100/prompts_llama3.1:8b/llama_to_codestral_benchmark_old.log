---
- name: Selinux Configuration Playbook
  hosts: localhost
  become: true
  tasks:
    - name: Import assert.yml
      ansible.builtin.import_tasks: assert.yml
      run_once: true

    - name: Install selinux packages
      ansible.builtin.package:
        name: "{{ selinux_requirements }}"
        state: present
      notify: Gather facts

    - name: Flush handlers
      ansible.builtin.meta: flush_handlers

    - name: Configure selinux
      ansible.posix.selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot
      when: selinux_enabled and ansible_connection != 'docker' and ansible_connection != 'container'

    - name: Manage selinux booleans
      ansible.posix.seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      notify: Reboot
      when: selinux_booleans is defined


