---
   - name: Download RKE2 installation script
     get_url:
       url: "{{ rke2_url }}"
       dest: "{{ rke2_dir }}/rke2.sh"
       mode: '0755'
     when: not airgap_mode or (airgap_mode and implementation == 'download')
     ignore_errors: "{{ airgap_mode and implementation == 'download' }}"

   - name: Copy local RKE2 installation script
     copy:
       src: "{{ local_rke2_src }}"
       dest: "{{ rke2_dir }}/rke2.sh"
       mode: '0755'
     when: airgap_mode and implementation == 'copy'

   - name: Create RKE2 artifacts folder
     file:
       path: "{{ rke2_dir }}"
       state: directory
       mode: '0755'
     when: airgap_mode and implementation != 'exists'

   - name: Download RKE2 checksum and artifacts
     get_url:
       url: "{{ item.url }}"
       dest: "{{ rke2_dir }}/{{ item.filename }}"
       mode: '0644'
     with_items:
       - { url: "{{ rke2_checksum_url }}", filename: "rke2.sha256" }
       - { url: "{{ rke2_artifacts_url }}", filename: "rke2-images.linux-amd64.tar.gz" }
     when: airgap_mode and implementation == 'download'
     ignore_errors: true
     register: remote_download

   - name: Fallback to local downloading and pushing
     block:
       - copy:
           src: "{{ local_rke2_checksum_src }}"
           dest: "{{ rke2_dir }}/rke2.sha256"
           mode: '0644'
       - copy:
           src: "{{ local_rke2_artifacts_src }}"
           dest: "{{ rke2_dir }}/rke2-images.linux-amd64.tar.gz"
           mode: '0644'
     when: airgap_mode and implementation == 'download' and remote_download is failed

   - name: Airgap mode - additional images tarballs
     block:
       - file:
           path: "{{ additional_images_dir }}"
           state: directory
           mode: '0755'
       - copy:
           src: "{{ item.src }}"
           dest: "{{ additional_images_dir }}/{{ item.dest }}"
           mode: '0644'
         with_items: "{{ additional_images_tarballs }}"
     when: airgap_mode and implementation != 'exists' and additional_images_tarballs is defined

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ rke2_dir }}/{{ item }}"
       state: file
       mode: '0644'
     with_items:
       - rke2.sha256
       - rke2-images.linux-amd64.tar.gz
     when: airgap_mode and implementation == 'exists'

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: "{{ fs_object_path }}"
     register: fs_stats

   - name: Check if separate partition
     shell: "mount | grep '{{ fs_object_path }}'"
     register: mount_output
     changed_when: false

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: /usr/local/bin
     when: fs_stats.stat.isdir is defined and fs_stats.stat.isdir and '/usr/local' not in mount_output.stdout

   - name: Check RKE2 version
     shell: "{{ rke2_bin_path }}/rke2 --version || systemctl status rke2-server.service | grep 'Active:'"
     register: rke2_version_output
     changed_when: false

   - name: Set RKE2 versions
     set_fact:
       installed_version: "{{ rke2_version_output.stdout | regex_search('v\\d+\\.\\d+\\.\\d+') }}"
       desired_version: "{{ rke2_version }}"

   - name: Prevent accidental RKE2 downgrade
     assert:
       that:
         - desired_version is version(installed_version, '>=')
       msg: "Desired version is less than the installed version"

   - name: Run RKE2 install script
     shell: "./rke2.sh {{ rke2_install_vars }}"
     args:
       chdir: "{{ rke2_dir }}"
     when: desired_version != installed_version

   - name: Copy Custom Manifests
     copy:
       src: "{{ custom_manifests_src }}"
       dest: "{{ custom_manifests_dest }}"
       mode: '0644'
     when: custom_manifests_src is defined

   - name: Copy Static Pods
     copy:
       src: "{{ static_pods_src }}"
       dest: "{{ static_pods_dest }}"
       mode: '0644'
     when: static_pods_src is defined

   - name: Copy RKE2 environment file
     copy:
       src: "{{ rke2_env_src }}"
       dest: "{{ rke2_env_dest }}"
       mode: '0644'
     when: environment_options is defined

