---
   - name: Hardening | Disable Swap
     command: swapoff -a
     when: ansible_swaps.0 is defined and ansible_swaps.0.size_kb > 0 and
           vault_hardening_disable_swap | bool

   - name: Hardening | Disable Core Dumps
     community.general.pam_limits:
       domain: '*'
       limit_type: '{{ item.limit_type }}'
       limit_item: core
       value: 0
     loop:
       - limit_type: '-'
       - limit_type: 'soft'
     when: vault_hardening_disable_core_dumps | bool

   - name: Hardening | Disable Shell Command History
     copy:
       src: vault.sh
       dest: /etc/profile.d/
       mode: '0644'
     when: vault_hardening_disable_shell_command_history | bool

   - name: Hardening | Configure SELinux / AppArmor
     block:
       - name: Install SELinux policy
         package:
           name: selinux-policy
           state: present

       - name: Set SELinux policy to targeted and state to enforcing
         selinux:
           policy: targeted
           state: enforcing

       - name: Enforce AppArmor
         command: aa-enforce /etc/apparmor.d/*

   # Added a new line at the end of the file to fix new-line-at-end-of-file error
   # Removed trailing spaces on the line to fix trailing-spaces error
   # Comment now indented like content to fix comments-indentation error
   # Line length reduced to conform with line-length rule
   

