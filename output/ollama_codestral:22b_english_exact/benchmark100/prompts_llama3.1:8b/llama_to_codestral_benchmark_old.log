---
   - name: Import assert.yml file for task execution
     import_tasks: assert.yml
     run_once: true

   - name: Pre-configure Debian systems for postfix installation
     debconf:
       name: postfix
       question: postfix/main_mailer_type
       value: "'No configuration'"
       vtype: string

   - name: Install postfix package
     package:
       name: postfix
       state: present

   - name: Install postfix-mysql package if specific conditions are met
     package:
       name: postfix-mysql
       state: present
     when: >
       'mysql' in postfix_virtual_mailbox_maps
       or 'mysql' in postfix_virtual_mailbox_domains
       or 'mysql' in postfix_virtual_alias_maps

   - name: Configure postfix transport maps
     template:
       src: transport.j2
       dest: /etc/postfix/transport
     notify:
       - Validate postfix configuration
       - Rebuild transport maps database

   - name: Configure postfix header checks
     template:
       src: header_checks.j2
       dest: /etc/postfix/header_checks
     notify:
       - Validate postfix configuration
       - Reload postfix

   - name: Set values for the main.cf file
     set_fact:
       postfix_recipient_access_rules: "{{ postfix_recipient_access | default([]) }}"
       postfix_sender_access_rules: "{{ postfix_sender_access | default([]) }}"
       # Additional logic to generate postfix_recipient_access_rules
       # and postfix_sender_access_rules

   - name: Configure postfix main.cf
     template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify:
       - Validate postfix configuration
       - Restart postfix

   - name: Configure postfix master.cf
     template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify:
       - Validate postfix configuration
       - Restart postfix

   - name: Create a directory for TLS certificates and keys
     file:
       path: "{{ postfix_tls_dir }}"
       state: directory
       mode: '0755'

   - name: Deploy Postfix TLS server certificate
     copy:
       src: "{{ postfix_tls_cert_file }}"
       dest: "{{ postfix_tls_cert_dest_file }}"
     notify:
       - Reload postfix

   - name: Deploy Postfix TLS server key
     copy:
       src: "{{ postfix_tls_key_file }}"
       dest: "{{ postfix_tls_key_dest_file }}"
     notify:
       - Reload postfix

   - name: Flush handlers
     meta: flush_handlers

   - name: Configure aliases
     copy:
       content: "{{ postfix_aliases }}"
       dest: "{{ postfix_alias_file }}"
     notify:
       - Rebuild alias database
       - Reload postfix

   - name: Configure sender_access
     copy:
       content: "{{ postfix_sender_access }}"
       dest: "{{ postfix_sender_access_file }}"
     notify:
       - Rebuild sender_access database
       - Reload postfix

   - name: Configure recipient_access
     copy:
       content: "{{ postfix_recipient_access }}"
       dest: "{{ postfix_recipient_access_file }}"
     notify:
       - Validate postfix configuration
       - Rebuild recipient_access database
       - Reload postfix

   - name: Place sasl_password_map
     copy:
       content: "{{ postfix_smtp_sasl_password_map_content }}"
       dest: "{{ postfix_smtp_sasl_password_map }}"
     notify:
       - Rebuild sasl_password_map database

   - name: Flush handlers again
     meta: flush_handlers

   - name: Start and enable postfix service
     service:
       name: postfix
       state: started
       enabled: true


