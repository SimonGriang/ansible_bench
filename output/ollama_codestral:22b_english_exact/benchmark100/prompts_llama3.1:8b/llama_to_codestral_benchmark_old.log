---
   - name: Import and run assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install required packages
     package:
       name: "{{ selinux_requirements }}"
       state: present
     notify: Gather facts

   - name: Flush handlers
     meta: flush_handlers

   - name: Configure selinux
     when:
       - selinux_status is defined
       - ansible_connection not in ['container', 'docker', 'community.docker.docker']
     block:
       - name: Manage selinux settings
         seboolean:
           name: "{{ selinux_state }}"
           state: "{{ selinux_policy }}"
         notify: Reboot

       - name: Manage selinux booleans
         when: selinux_booleans is defined
         seboolean:
           name: "{{ item.name }}"
           state: "{{ item.state }}"
           persistent: "{{ item.persistent | default('yes') }}"
         loop: "{{ selinux_booleans }}"

   - name: Ensure handlers are notified now
     meta: flush_handlers

