 - name: Install epel package repositories
    hosts: all
    tasks:
      - name: Install epel package repositories for compatible operating systems
        package:
          name: epel-release
        when: ansible_os_family == "RedHat" or ansible_distribution == "Amazon"

      - name: Install the epel GPG key
        rpm_key:
          key: "{{ epel_gpg_key }}"
          state: present

      - name: Install the epel-release package
        package:
          name: epel-release
          state: present
        notify: Update package cache

      - name: Install the epel-next-release package
        package:
          name: epel-next-release
          state: present
        notify: Update package cache
        when: epel_next | default(false)
    handlers:
      - name: Update package cache
        yum:
          update_cache: yes
          update_only: yes
          cache_valid_time: 3600


