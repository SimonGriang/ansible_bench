 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install mysql package
     package:
       name: mysql
       state: present

   - name: Configure mysql server
     template:
       src: "{{ mysql_name }}-server.cnf.j2"
       dest: "{{ mysql_configuration_directory }}/{{ mysql_name }}-server.cnf"
     with_dict: "{{ mysql_configuration_options }}"

   - name: Configure mysql client
     template:
       src: "{{ mysql_name }}-client.cnf.j2"
       dest: "{{ mysql_configuration_directory }}/{{ mysql_name }}-client.cnf"
     vars:
       socket: "{{ mysql_socket }}"

   - name: Initialize mysql service
     command: "{{ mysql_initialize_command }}"
     when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"

   - name: Start and enable mysql service
     service:
       name: mysql
       state: started
       enabled: true
     notify: flush handlers

   - name: Create my.cnf file
     template:
       src: my.cnf.j2
       dest: /root/.my.cnf

   - name: Create databases
     community.mysql.mysql_db:
       name: "{{ item.name }}"
       state: present
     with_items: "{{ mysql_databases }}"

   - name: List databases
     community.mysql.mysql_info:
       login_user: root
       login_password: "{{ mysql_root_password }}"
       filter:
         - databases

   - name: Import databases
     community.mysql.mysql_db:
       name: "{{ item.name }}"
       state: import
       target: "{{ item.initial_import }}"
     with_items: "{{ mysql_databases }}"
     when: item.initial_import is defined

   - name: Create users
     community.mysql.mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       host: "{{ item.host }}"
       priv: "{{ item.priv }}"
     with_items: "{{ mysql_users }}"
     no_log: true
     notify: flush handlers

   - name: Flush handlers
     meta: flush_handlers

   - name: Flush handlers again
     meta: flush_handlers

