---
   - name: Import and run tasks from assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install required packages for the service
     package:
       name: "{{ service_required_packages }}"
       state: present

   - name: Configure systemd service for each item in the service_list
     block:
       - name: Copy systemd service file
         template:
           src: systemd.j2
           dest: "/etc/systemd/system/{{ item.name }}.service"
           mode: '0644'
         notify: Systemctl daemon-reload
         when: ansible_service_mgr == "systemd"
       - name: Manage systemd service
         systemd:
           name: "{{ item.name }}"
           state: >-
             {%- if item.state is defined -%}
             {{ item.state }}
             {%- elif item.enabled is defined and item.enabled %}
             started
             {%- else -%}
             stopped
             {%- endif -%}
           enabled: "{{ item.enabled | default(true) }}"
         when: ansible_service_mgr == "systemd"
     loop: "{{ service_list }}"

   - name: Configure sysvinit service for each item in the service_list
     block:
       - name: Copy sysvinit service file
         template:
           src: sysvinit.j2
           dest: "/etc/init.d/{{ item.name }}"
           mode: '0755'
         when: ansible_service_mgr != "systemd"
       - name: Manage sysvinit service
         service:
           name: "{{ item.name }}"
           state: >-
             {%- if item.state is defined -%}
             {{ item.state }}
             {%- elif item.enabled is defined and item.enabled %}
             started
             {%- else -%}
             stopped
             {%- endif -%}
           enabled: "{{ item.enabled | default(true) }}"
         when: ansible_service_mgr != "systemd"
     loop: "{{ service_list }}"

   - name: Flush handlers
     meta: flush_handlers

