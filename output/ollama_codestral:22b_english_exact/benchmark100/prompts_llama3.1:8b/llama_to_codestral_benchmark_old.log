---
   - name: Import Java Asserts and Setup Local Task Execution
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Install Bash
     package:
       name: bash
       state: present

   - name: Install OpenJDK Java (Package)
     block:
       - name: Install OpenJDK Java Package
         package:
           name: openjdk-11-jdk
           state: present
       - name: Set Environment Variable USE
         lineinfile:
           path: /etc/environment
           regexp: '^USE='
           line: 'USE="X -cups -alsa -fontconfig"'
     when: java_vendor == 'openjdk'

   - name: Install RPM (Local Java Source)
     block:
       - name: Copy Oracle Java RPM Package
         copy:
           src: oracle_java.rpm
           dest: /tmp
       - name: Install Oracle Java RPM Package
         yum:
           name: /tmp/oracle_java.rpm
           state: present
     when:
       - java_source == 'local'
       - java_format == 'rpm'

   - name: Install DEB (Local Java Source)
     block:
       - name: Copy Oracle Java DEB Package
         copy:
           src: oracle_java.deb
           dest: /tmp
       - name: Install Oracle Java DEB Package
         apt:
           name: /tmp/oracle_java.deb
           state: present
     when:
       - java_source == 'local'
       - java_format == 'deb'

   - name: Install Oracle Java (RPM) (Repository)
     yum:
       name: oracle-java
       state: present
     when:
       - java_source == 'repository'
       - java_format == 'rpm'

   - name: Configure Oracle Targz
     block:
       - name: Ensure Java Install Directory Exists
         file:
           path: "{{ java_install_directory }}"
           state: directory
       - name: Install Oracle Java Targz Package
         unarchive:
           src: oracle_java.targz
           dest: "{{ java_install_directory }}"
     when:
       - java_format == 'targz'
       - java_vendor == 'oracle'

   - name: Install Oracle Java Policy Software (Targz)
     unarchive:
       src: oracle_java_policy_software.targz
       dest: "{{ java_install_directory }}/security"
     when:
       - java_jce is defined and java_jce
       - java_version is defined and java_version == 8
       - java_vendor is defined and java_vendor == 'oracle'

   - name: Set Alternative (Targz)
     command: >
       update-alternatives --install /usr/bin/java java
       "{{ java_install_directory }}/bin/java" 1
     when:
       - java_format == 'targz'
       - ansible_distribution != 'Alpine'
       - java_vendor == 'oracle'

   - name: Find JAVA_HOME
     shell: readlink -f /usr/bin/java | sed "s:bin/java::"
     register: java_home

   - name: Set JAVA_HOME in /etc/environment
     lineinfile:
       path: /etc/profile.d/java_home.sh
       line: 'export JAVA_HOME="{{ java_home.stdout }}"'
       create: yes
       mode: 0644
     become: yes

   # Added new line at the end of the file as per yamllint check.

