---
   - name: Assert that systemd is being used as the init system
     assert:
       that: "ansible_service_mgr == 'systemd'"
       fail_msg: "This playbook is only for systems using systemd."

   - name: Get the latest release of the Grafana Loki project from the GitHub API
     uri:
       url: "https://api.github.com/repos/grafana/loki/releases/latest"
       return_content: yes
       status_code: 200
       validate_certs: yes
     register: _latest_release
     until: _latest_release.status == 200
     retries: 5
     delay: 10

   - name: Set the promtail version to the latest release tag
     set_fact:
       promtail_version: "{{ _latest_release.json.tag_name | regex_replace('^v', '') }}"
     when: promtail_version == 'latest'

   - name: Test if the zip local archive exists in the specified directory
     stat:
       path: "{{ local_dir }}/promtail-linux-{{ ansible_architecture }}.zip"
     register: _local_archive
     when: local_dir != ""

   - name: Assert that the local binary exists in the specified directory
     assert:
       that: _local_archive.stat.exists
       fail_msg: "The promtail binary archive does not exist in the specified directory."
     when: local_dir != ""

   - name: Get the checksum list for the latest release
     uri:
       url: "{{ _latest_release.json.assets_url }}"
       return_content: yes
       status_code: 200
       validate_certs: yes
     register: _promtail_checksums
     when: local_dir == ""

   - name: Get the checksum for the specified architecture
     set_fact:
       __promtail_checksum: "{{ item.browser_download_url | regex_search('promtail-linux-' + ansible_architecture + '\\.zip\\.sha256') | regex_replace('^.*sha256', '') }}"
     loop: "{{ _promtail_checksums.json }}"
     loop_control:
       label: "{{ item.browser_download_url }}"
     when: local_dir == "" and 'promtail-linux-' + ansible_architecture + '.zip' in item.browser_download_url

