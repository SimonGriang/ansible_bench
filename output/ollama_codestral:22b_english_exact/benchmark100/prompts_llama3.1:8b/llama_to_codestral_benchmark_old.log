---
- name: Import assertion handling tasks
  import_tasks: assert.yml

- name: Install cron package
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell settings for cron jobs
  lineinfile:
    path: /etc/cron.d/cron
    regexp: '^SHELL='
    line: 'SHELL={{ cron_shell }}'

- name: Configure the system path for cron jobs
  lineinfile:
    path: /etc/cron.d/cron
    regexp: '^PATH='
    line: 'PATH={{ cron_path }}'

- name: Configure the mail-to setting for cron jobs
  lineinfile:
    path: /etc/cron.d/cron
    regexp: '^MAILTO='
    line: 'MAILTO={{ cron_mailto }}'

- name: Start and enable the cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    special_time: "{{ item.special_time | default(omit) }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"


