---
- name: Task 1 - Check all variables have been set correctly
  include_tasks: assert.yml

- name: Task 2 - Wait for host (when configured)
  wait_for:
    port: "{{ ansible_port | default(inventory_hostname) }}"
    host: "{{ ansible_ssh_host | default(inventory_hostname) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: Task 3 - Prepare the system
  block:
    - name: Test connection
      ping:
      register: _test_connection

    - name: Register test connection result
      set_fact:
        _connection_test_result: "{{ 'Passed' if _test_connection is successful else 'Failed' }}"
      changed_when: _test_connection is not successful

    - name: Debug connection test result
      debug:
        msg: "Connection test result: {{ _connection_test_result }}"

    - name: Gather bootstrap facts
      include_tasks: gather_facts.yml

    - name: Install bootstrap packages (if applicable)
      # Include tasks to install bootstrap packages here

- name: Task 4 - Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:

    - name: Install required packages
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap__facts_packages }}"
      become: true
      become_user: "{{ bootstrap__packages_become_user | default(omit) }}"
  

