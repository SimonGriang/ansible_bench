       - rke2_airgap_mode is defined and rke2_airgap_mode
       - rke2_implementation == 'download'
     ignore_errors: yes
     register: remote_download_result

   - name: Fallback to local downloading and pushing
     copy:
       src: "{{ rke2_local_artifacts_source }}"
       dest: "{{ rke2_artifacts_folder }}"
       mode: '0644'
     when:
       - rke2_airgap_mode is defined and rke2_airgap_mode
       - rke2_implementation == 'download'
       - remote_download_result is failed

   - name: Airgap mode - additional images tarballs
     block:
       - name: Create directory for additional images tarballs
         file:
           path: "{{ rke2_tarballs_folder }}"
           state: directory
           mode: '0755'
       - name: Copy RKE2 components to tarballs folder
         copy:
           src: "{{ item }}"
           dest: "{{ rke2_tarballs_folder }}"
           mode: '0644'
         with_fileglob:
           - "{{ rke2_components_source }}"
     when:
       - rke2_airgap_mode is defined and rke2_airgap_mode
       - rke2_implementation != 'exists'
       - rke2_additional_tarballs | length > 0

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ rke2_artifacts_folder }}"
       state: directory
       mode: '0755'
     when:
       - rke2_airgap_mode is defined and rke2_airgap_mode
       - rke2_implementation == 'exists'

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: "{{ rke2_fs_object_path }}"
     register: fs_stats

   - name: Check if separate partition
     command: "grep -q '{{ rke2_partition_device }}' /proc/mounts"
     register: grep_output
     failed_when: grep_output.rc > 1
     changed_when: false

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "/usr/local/bin"
     when:
       - fs_stats.stat.writeable
       - grep_output.rc == 0

   - name: Check RKE2 version
     shell: "{{ rke2_bin_path }}/rke2 --version || systemctl status rke2"
     register: rke2_version_result
     changed_when: false
     ignore_errors: yes

   - name: Set RKE2 versions
     set_fact:
       rke2_installed_version: "{{ rke2_version_result.stdout_lines[0].split(' ')[2] }}"
       rke2_desired_version: "{{ rke2_version }}"

   - name: Prevent accidental RKE2 downgrade
     assert:
       that:
         - rke2_installed_version is version_compare(rke2_desired_version, '>=')
       fail_msg: "Downgrading RKE2 is not allowed"

   - name: Run RKE2 install script
     shell: >-
       {{ rke2_script_destination }}
       --install-rke2-{{ rke2_server_mode }}
       {{ rke2_install_options }}
     when:
       - rke2_desired_version != rke2_installed_version

   - name: Copy Custom Manifests
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_custom_manifests_destination }}"
       mode: '0644'
     with_fileglob:
       - "{{ rke2_custom_manifests_source }}"
     when:
       - rke2_custom_manifests is defined

   - name: Copy Static Pods
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_static_pods_destination }}"
       mode: '0644'
     with_fileglob:
       - "{{ rke2_static_pods_source }}"
     when:
       - rke2_static_pods is defined

   - name: Copy RKE2 environment file
     copy:
       src: "{{ rke2_environment_file_source }}"
       dest: "{{ rke2_environment_file_destination }}"
       mode: '0644'
     when:
       - rke2_environment_options is defined
