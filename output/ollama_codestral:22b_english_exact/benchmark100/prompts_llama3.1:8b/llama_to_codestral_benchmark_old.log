---
   - name: Import tasks from assert.yml for the httpd role
     ansible.builtin.import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install the Apache HTTP Server
     ansible.builtin.package:
       name: "{{ httpd_packages }}"
       state: present

   - name: Configure SELinux settings for the httpd service
     block:
       - name: Modify SELinux settings for the httpd service
         community.general.seboolean:
           name: "{{ item.name }}"
           state: yes
           persistent: yes
         loop: "{{ httpd_sebooleans }}"

       - name: Allow connections to custom ports and SSL port
         community.general.seport:
           ports: "{{ httpd_port }}"
           proto: tcp
           setype: http_port_t
           state: present

       - name: Allow SSL port if defined
         community.general.seport:
           ports: 443
           proto: tcp
           setype: http_port_t
           state: present
         when: https_ssl_enable is defined
     when: ansible_selinux.status == "enabled"

   - name: Configure the Apache HTTP Server
     ansible.builtin.template:
       src: "{{ httpd_config_src }}"
       dest: "/etc/httpd/conf/httpd.conf"
       owner: root
       group: root
       mode: '0644'
     notify:
       - Test httpd configuration validity
       - Restart httpd

   - name: Activate specific Apache HTTP Server modules on Debian-based systems
     ansible.builtin.command: "a2enmod {{ httpd_modules_to_activate_with_command }}"
     when: ansible_os_family == "Debian"
     notify:
       - Test httpd configuration validity

   - name: Import tasks related to SSL configuration
     ansible.builtin.import_tasks: ssl.yml
     when: https_ssl_enable is defined

   - name: Import tasks related to locations configuration
     ansible.builtin.import_tasks: locations.yml
     when: httpd_locations is defined

   - name: Import tasks related to virtual hosts configuration
     ansible.builtin.import_tasks: vhosts.yml
     when: httpd_vhosts is defined

   - name: Configure custom ports for the Apache HTTP Server on Debian-based and Suse-based systems
     ansible.builtin.template:
       src: "{{ httpd_ports_conf }}"
       dest: "/etc/httpd/conf.d/custom_ports.conf"
       owner: root
       group: root
       mode: '0644'
     when: ansible_os_family in ['Debian', 'Suse']
     notify:
       - Test httpd configuration validity
       - Restart httpd

   - name: Import tasks related to directories configuration
     ansible.builtin.import_tasks: directories.yml
     when: httpd_directories is defined

   - name: Flush handlers
     ansible.builtin.meta: flush_handlers

   - name: Remove the default index.html file from the Apache HTTP Server's data directory
     ansible.builtin.file:
       path: "/var/www/html/index.html"
       state: absent
     when: httpd_remove_example is defined

   - name: Start and enable the Apache HTTP Server service
     ansible.builtin.service:
       name: httpd
       state: started
       enabled: yes

