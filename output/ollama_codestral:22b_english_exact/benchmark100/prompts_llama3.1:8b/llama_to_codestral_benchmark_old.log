---
   - name: Create local ssh key directory for a user
     file:
       path: "{{ ssh_key_dir }}"
       state: directory
       mode: 0750
       owner: "{{ user_name }}"
       group: "{{ user_group }}"

   - name: Manage the user account
     user:
       name: "{{ user_name }}"
       comment: "{{ user_comment }}"
       group: "{{ user_group }}"
       create_home: "{{ create_home }}"
       password: "{{ user_password }}"
       update_password: always
       expires: "{{ user_expires }}"
       shell: "{{ user_shell }}"

   - name: Set up the user's sudo options
     template:
       src: sudoers.j2
       dest: "/etc/sudoers.d/{{ user_name }}"
       mode: 0440
       owner: root
       group: root
     when: user_sudo_options is defined
     vars:
       sudo_options: "{{ user_sudo_options }}"
     notify: Reload sudoers

   - name: Remove the user's sudo options
     file:
       path: "/etc/sudoers.d/{{ user_name }}"
       state: absent
     when: user_sudo_options is not defined
     notify: Reload sudoers

   - name: Generate the user's private SSH key
     community.crypto.openssh_keypair:
       path: "{{ ssh_key_dir }}/{{ user_name }}"
       type: ed25519
     when: user_ssh_key_management

   - name: Generate the user's public SSH key
     community.crypto.openssh_keypair:
       path: "{{ ssh_key_dir }}/{{ user_name }}"
       type: ed25519
       public_action: recreate
     when: user_ssh_key_management

   - name: Convert the user's SSH key to PPK format
     command: >
       ssh-keygen -p -N '' -m PEM
       -f {{ ssh_key_dir }}/{{ user_name }}
     when: user_ssh_key_management

   - name: Get or set the user's home directory
     set_fact:
       user_home: "{{ lookup('password', '{{ user_name }} chdir=/home') | default(default_home_dir) }}"

   - name: Create the user's .ssh directory
     file:
       path: "{{ user_home }}/.ssh"
       state: directory
       mode: 0700
       owner: "{{ user_name }}"
       group: "{{ user_group }}"

   - name: Deploy authorized keys for the user
     authorized_key:
       user: "{{ user_name }}"
       key: "{{ item }}"
       state: present
     loop: "{{ user_authorized_keys }}"
     when: user_authorized_keys is defined

   - name: Remove unauthorized keys for the user
     authorized_key:
       user: "{{ user_name }}"
       key: "{{ item }}"
       state: absent
     loop: "{{ user_unauthorized_keys }}"
     when: user_unauthorized_keys is defined

   - name: Copy the generated private SSH key for the user
     copy:
       src: "{{ ssh_key_dir }}/{{ user_name }}"
       dest: "{{ user_home }}/.ssh/id_ed25519"
       mode: 0400
       owner: "{{ user_name }}"
       group: "{{ user_group }}"
     when: user_copy_private_key

   - name: Check the user's password validity
     command: chage -l {{ user_name }}
     register: users_pw_valid
     changed_when: false

   - name: Set the user's password validity
     command: >
       chage -M {{ user_password_validity }} -m 0
       -W 7 -I 30 -E {{ user_password_expiration }}
       {{ user_name }}
     when: user_password_validity is defined and 'Password expires' not in users_pw_valid.stdout

   - name: Place the private key file for the user
     copy:
       src: "{{ ssh_key_dir }}/{{ user_name }}"
       dest: "{{ user_home }}/.ssh/id_ed25519"
       mode: 0400
       owner: "{{ user_name }}"
       group: "{{ user_group }}"
     when: user_private_keys is defined


