---
   - name: Create the Vault group
     group:
       name: "{{ vault_group }}"
       system: true

   - name: Create the Vault user
     user:
       name: "{{ vault_user }}"
       shell: "{{ vault_user_shell }}"
       group: "{{ vault_group }}"

   - name: Create the Vault download directory
     file:
       path: "{{ vault_download_path }}"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: "0755"
       state: directory

   - name: Download the Vault binary
     get_url:
       url: "{{ vault_binary_url }}"
       dest: "{{ vault_download_path }}"
     unarchive:
       src: "{{ vault_download_path }}/vault_{{ vault_version }}_linux_amd64.zip"
       dest: "{{ vault_download_path }}"
       remote_src: yes
     file:
       path: "{{ vault_download_path }}/vault"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: "0755"

   - name: Check if the vault_path exists
     stat:
       path: "{{ vault_path }}"
     register: vault_path_stat

   - name: Create vault_path if it does not exist
     file:
       path: "{{ vault_path }}"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: "0755"
       state: directory
     when: not vault_path_stat.stat.exists

   - name: Create directories in vault_path
     file:
       path: "{{ item }}"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: "0755"
       state: directory
     loop: "{{ vault_directories }}"

   - name: Create data directories
     file:
       path: "{{ item }}"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: "0700"
       state: directory
     loop: "{{ vault_data_directories }}"

   - name: Generate TLS key and certificate
     shell: >
       openssl req -newkey rsa:2048 -nodes -keyout {{ vault_tls_path }}/vault.key
       -x509 -days 3650 -out {{ vault_tls_path }}/vault.crt
       -subj "/CN={{ vault_tls_cn }}"
     args:
       warn: false

   - name: Set ownership of TLS material
     file:
       path: "{{ item }}"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
     loop: "{{ vault_tls_files }}"

   - name: Copy the Vault binary
     copy:
       src: "{{ vault_download_path }}/vault"
       dest: "/usr/bin/vault"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: "0755"

   - name: Set cap_ipc_lock=ep on /usr/bin/vault
     capabilities:
       path: "/usr/bin/vault"
       capability: cap_ipc_lock=ep
       state: present

   - name: Touch vault.env
     file:
       path: "/etc/vault.env"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: "0644"
       state: touch

   - name: Create /usr/lib/systemd/system
     file:
       path: "/usr/lib/systemd/system"
       owner: "root"
       group: "root"
       mode: "0755"
       state: directory

   - name: Copy the Vault service file
     copy:
       src: "files/vault.service"
       dest: "/usr/lib/systemd/system/vault.service"
       owner: "root"
       group: "root"
       mode: "0644"

   - name: Copy the Vault configuration
     copy:
       src: "files/vault.hcl"
       dest: "/etc/vault.hcl"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: "0644"

   - name: Flush handlers
     meta: flush_handlers

