---
   - name: Gather basic system facts
     raw: cat /etc/os-release
     become: false
     register: bootstrap_facts
     changed_when: false

   - name: Extract and set distribution name and major version
     set_fact:
       bootstrap_distribution: "{{ item.split('=')[1].strip('\"') }}"
       bootstrap_distribution_major_version: "{{ item.split('=')[1].split('.')[0] }}"
     loop: "{{ bootstrap_facts.stdout_lines }}"
     when: item.startswith('ID=') or item.startswith('VERSION_ID=')

   - name: Identify and set operating system family
     set_fact:
       bootstrap_os_family: "{{ item.key }}"
     loop: "{{ lookup('dict', bootstrap_os_family_map) }}"
     loop_control:
       label: "{{ item.key }}"
     when: bootstrap_distribution in item.value

   - name: Debug bootstrap_os_family
     debug:
