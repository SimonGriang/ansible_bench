 - name: Create RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory
       owner: root
       group: root
       mode: 0755

   - name: Set server taints
     shell: rke2_server_node_taints
     when: rke2_server_type == 'server'

   - name: Copy RKE2 config
     template:
       src: "{{ rke2_config }}"
       dest: /etc/rancher/rke2/config.yaml
       owner: root
       group: root
       mode: 0600
     notify: Config file changed

   - name: Copy kubelet config
     template:
       src: templates/kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       owner: root
       group: root
       mode: 0600
     notify: Config file changed
     when: rke2_kubelet_config | length > 0

   - name: Copy Containerd Registry Configuration file
     copy:
       src: "{{ rke2_custom_registry_path }}"
       dest: /etc/rancher/rke2/registries.yaml
       owner: root
       group: root
       mode: 0600
     notify: Config file changed
     when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

   - name: Register etcd restore from file
     set_fact:
       do_etcd_restore: true
     when:
       - rke2_etcd_snapshot_file | length > 0
       - rke2_server_service is not defined or rke2_server_service.status.ActiveState != 'active'

   - name: Register etcd restore from s3
     set_fact:
       do_etcd_restore_from_s3: true
     when:
       - rke2_etcd_snapshot_file | length > 0
       - rke2_etcd_snapshot_s3_options is defined
       - rke2_etcd_snapshot_s3_options.access_key is defined
       - rke2_etcd_snapshot_s3_options.secret_key is defined
       - rke2_etcd_snapshot_s3_options.bucket is defined
       - rke2_etcd_snapshot_s3_options.snapshot_name is defined

   - name: Restore etcd from file
     block:
       - name: Create RKE2 etcd snapshot directory
         file:
           path: /var/lib/rancher/rke2/server/db/snapshots
           state: directory
           owner: root
           group: root
           mode: 0700

       - name: Copy etcd snapshot file
         copy:
           src: "{{ rke2_etcd_snapshot_file }}"
           dest: /var/lib/rancher/rke2/server/db/snapshots/
           owner: root
           group: root
           mode: 0600

       - name: Restore etcd from snapshot
         command: rke2 server --config /etc/rancher/rke2/config.yaml --etcd-snapshot-restore-wait --etcd-snapshot-dir=/var/lib/rancher/rke2/server/db/snapshots
     when: do_etcd_restore is defined

   - name: Restore etcd from s3
     command: rke2 server --config /etc/rancher/rke2/config.yaml --etcd-s3 --etcd-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }} --etcd-s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }} --etcd-s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }} --etcd-s3-snapshot-name {{ rke2_etcd_snapshot_s3_options.snapshot_name }}
     when: do_etcd_restore_from_s3 is defined

   - name: Start RKE2 service on the first server
     systemd:
       name: rke2-server.service
       state: started
       enabled: yes
       daemon_reload: yes
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     notify: Service (re)started

   - name: Mask RKE2 agent service on the first server
     systemd:
       name: rke2-agent.service
       masked: yes

   - name: Wait for the first server be ready - no CNI
     shell: kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
     register: result
     until: "'True' in result.stdout and ('No' in result.stdout or 'None' in result.stdout)"
     retries: 30
     delay: 10

   - name: Wait for the first server be ready - with CNI
     shell: kubectl get nodes {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
     register: result
     until: "'True' in result.stdout"
     retries: 30
     delay: 10

   - name: Restore etcd
     block:
       - name: Remove old secrets
         command: kubectl delete secrets --all -n kube-system

       - name: Remove old nodes
         command: kubectl delete nodes --all

       - name: Create new nodes
         command: kubectl replace --force -f /etc/rancher/rke2/server/node-state.json

   - name: Set an Active Server variable
     set_fact:
       active_server: "{{ inventory_hostname }}"
     delegate_to: "{{ item }}"
     delegate_facts: true
     loop: "{{ groups[rke2_cluster_group_name] }}"

