---
   - name: Create the RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory
       owner: root
       group: root
       mode: '0755'

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_type == 'server'

   - name: Set agent taints
     set_fact:
       combined_node_taints: "{{ rke2_agent_node_taints }}"
     when: rke2_type == 'agent'

   - name: Copy RKE2 config
     copy:
       src: "{{ rke2_config_source }}"
       dest: "{{ rke2_config_destination }}"
       owner: root
       group: root
       mode: '0644'
     notify: Config file changed

   - name: Copy kubelet config
     template:
       src: kubelet.config.j2
       dest: "{{ rke2_kubelet_config_destination }}"
       owner: root
       group: root
       mode: '0644'
     when: rke2_kubelet_config | length > 0
     notify: Config file changed

   - name: Copy Containerd Registry Configuration file
     copy:
       src: "{{ rke2_registry_config_source }}"
       dest: "{{ rke2_registry_config_destination }}"
       owner: root
       group: root
       mode: '0644'
     when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
     notify: Config file changed

   - name: Start RKE2 service on the rest of the nodes
     systemd:
       name: "{{ rke2_service_name }}"
       state: started
       enabled: yes
     register: rke2_service_status
     until: rke2_service_status.status.ActiveState == 'active'
     retries: 10
     delay: 10
     notify: Service (re)started

   - name: Mask other RKE2 service on the rest of the nodes
     systemd:
       name: "{{ item }}"
       masked: yes
     loop: "{{ rke2_services }}"
     when: item != rke2_type

   - name: Wait for remaining nodes to be ready - no CNI
     shell: |
       set -o pipefail
       kubectl get nodes --no-headers | awk '{print $2}' | grep -v NotReady
     register: node_status
     until: node_status.stdout_lines | length == groups['all'] | length
     retries: 60
     delay: 10
     delegate_to: "{{ inventory_hostname }}"
     loop: "{{ groups['all'] }}"

   - name: Wait for remaining nodes to be ready - with CNI
     shell: |
       set -o pipefail
       kubectl get nodes --field-selector=status.conditions[?(@.type=='NetworkUnavailable')].status==False --no-headers | wc -l
     register: ready_nodes
     until:
       - ready_nodes.stdout | int == groups['all'] | length
       - (inventory_hostname == hostvars[groups['all'][0]]['ansible_host'] or
          inventory_hostname == hostvars[groups['all'][0]]['inventory_hostname'])
     retries: 60
     delay: 10
     delegate_to: "{{ inventory_hostname }}"

