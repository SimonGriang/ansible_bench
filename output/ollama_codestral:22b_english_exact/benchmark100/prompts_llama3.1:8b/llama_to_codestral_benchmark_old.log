etries: 30\n     delay: 10\n\n   - name: Wait for the first server be ready - with CNI\n     shell: >\n       kubectl get nodes {{ inventory_hostname }}\n       -o jsonpath=\'{.status.conditions[?(@.type=="Ready")].status}\'\n     register: result\n     until: "\'True\' in result.stdout"\n     retries: 30\n     delay: 10\n\n   - name: Restore etcd\n     block:\n       - name: Remove old secrets\n         command: kubectl delete secrets --all -n kube-system\n\n       - name: Remove old nodes\n         command: kubectl delete nodes --all\n\n       - name: Create new nodes\n         command: >\n           kubectl replace --force\n           -f /etc/rancher/rke2/server/node-state.json\n\n   - name: Set an Active Server variable\n     set_fact:\n       active_server: "{{ inventory_hostname }}"\n     delegate_to: "{{ item }}"\n     delegate_facts: true\n     loop: "{{ groups[rke2_cluster_group_name] }}"' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-13T23:40:00.490141299Z', 'done': True, 'done_reason': 'stop', 'total_duration': 36606719899, 'load_duration': 20944244, 'prompt_eval_count': 2944, 'prompt_eval_duration': 1562905628, 'eval_count': 1577, 'eval_duration': 35020890053, 'model_name': 'codestral:22b'} id='run--f8e15b3d-f225-4828-bc65-27995d13d0d3-0' usage_metadata={'input_tokens': 2944, 'output_tokens': 1577, 'total_tokens': 4521}
