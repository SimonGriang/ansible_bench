 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install the dns packages
     package:
       name:
         - bind9
         - bind9utils
         - dnsutils
       state: present

   - name: Create the required directories
     file:
       path: "{{ item }}"
       state: directory
       owner: root
       group: bind
       mode: '0775'
     loop:
       - /etc/bind
       - /var/cache/bind
       - /var/lib/bind

   - name: Create the required group
     group:
       name: bind
       state: present

   - name: Create the required user
     user:
       name: bind
       group: bind
       system: yes
       home: /var/lib/bind
       shell: /usr/sbin/nologin
       state: present

   - name: Generate the rndc key
     command: rndc-confgen -a -c /etc/rndc.key
     args:
       creates: /etc/rndc.key

   - name: Set permissions on the rndc key file
     file:
       path: /etc/rndc.key
       owner: root
       group: bind
       mode: '0644'

   - name: Download the named.root file
     get_url:
       url: https://data.iana.org/root-anchors/root.hints
       dest: /var/lib/bind/named.root
       owner: root
       group: bind
       mode: '0644'

   - name: Create the zone file
     template:
       src: zone.j2
       dest: /etc/bind/named.conf.local
       owner: root
       group: bind
       mode: '0644'

   - name: Add zones to the configuration
     blockinfile:
       path: /etc/bind/named.conf.local
       block: |
         zone "example.com" {
             type master;
             file "/etc/bind/db.example.com";
         };
         zone "0.168.192.in-addr.arpa" {
             type master;
             file "/etc/bind/db.192.168.0";
         };

   - name: Place the systemd override
     copy:
       src: bind9.service.d.j2
       dest: /etc/systemd/system/bind9.service.d/override.conf
     notify:
       - Reload systemd daemon

   - name: Start and enable the DNS service
     service:
       name: bind9
       state: started
       enabled: yes

