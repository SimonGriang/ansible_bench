   - name: Create SSL certificate
     x509_certificate:
       path: /etc/ssl/certs/cert.pem
       privatekey_path: /etc/ssl/private/private_key.pem
       csr_path: /etc/ssl/csr/csr.pem
       provider: selfsigned
       mode: '0600'
