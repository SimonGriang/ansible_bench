---
   - name: Load OS-specific variables
     include_vars: "{{ ansible_os_family }}.yml"

   - name: Include setup tasks for RedHat-based systems
     include_tasks: redhat.yml
     when: ansible_os_family == 'RedHat'

   - name: Include setup tasks for Debian-based systems
     include_tasks: debian.yml
     when: ansible_os_family == 'Debian'

   - name: Install Docker packages (non-RedHat/Debian or Ansible <2.12)
     package:
       name: docker-ce
       state: present
     when:
       - ansible_os_family != 'RedHat' or ansible_os_family != 'Debian'
       - ansible_version.full is version_compare('2.12', '<')

   - name: Install Docker packages (with downgrade option, Ansible >=2.12 and RedHat/Debian)
     package:
       name: docker-ce
       state: present
       allow_downgrade: yes
     when:
       - ansible_os_family == 'RedHat' or ansible_os_family == 'Debian'
       - ansible_version.full is version_compare('2.12', '>=')

   - name: Install docker-compose plugin
     package:
       name: docker-compose
       state: present
     when:
       - docker_compose_plugin_enabled
       - ansible_os_family != 'RedHat' or ansible_os_family != 'Debian' or ansible_version.full is version_compare('2.12', '<')

   - name: Install docker-compose-plugin (with downgrade option)
     package:
       name: docker-compose-plugin
       state: present
       allow_downgrade: yes
     when:
       - docker_compose_plugin_enabled
       - ansible_os_family == 'RedHat' or ansible_os_family == 'Debian'
       - ansible_version.full is version_compare('2.12', '>=')

   - name: Ensure /etc/docker/ directory exists
     file:
       path: /etc/docker
       state: directory
       mode: '0755'

   - name: Configure Docker daemon options
     copy:
       content: "{{ docker_daemon_options | to_nice_json }}"
       dest: /etc/docker/daemon.json

   - name: Ensure Docker is started and enabled at boot
     service:
       name: docker
       state: started
       enabled: yes
     when: docker_service_enabled

   - name: Notify handlers to update firewall rules
     command: /bin/true
     notify: update_firewall_rules

   - name: Include docker-compose management tasks
     include_tasks: docker-compose.yml
     when: docker_compose_enabled

   - name: Get docker group information
     command: getent group docker
     register: docker_group_info
     changed_when: false

   - name: Check if there are users to add to the docker group
     set_fact:
       users_to_add: >-
         {%- set existing_users = docker_group_info.stdout | regex_findall('\b(\w+)\b') if docker_group_info.stdout else [] -%}
         {{ docker_users | difference(existing_users) }}

   - name: Include docker users management tasks
     include_tasks: docker-users.yml
     when: users_to_add | length > 0



