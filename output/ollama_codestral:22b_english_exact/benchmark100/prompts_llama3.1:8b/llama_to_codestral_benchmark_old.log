 - name: Import assert.yml
      import_tasks: assert.yml
      delegate_to: localhost
      run_once: true

    - name: Wait for port to become available
      wait_for:
        port: "{{ bootstrap_port | default(22) }}"
        timeout: "{{ bootstrap_timeout }}"
      when:
        - "'bootstrap' in group_names"
        - "'container' not in connection"
        - "'docker' not in connection"
        - "'community.docker.docker' not in connection"
        - bootstrap_wait_for_host is defined and bootstrap_wait_for_host

    - name: Prepare system for further tasks
      block:
        - name: Check if connection is established
          ping:
          register: bootstrap_connect
          ignore_unreachable: true

        - name: Gather bootstrap facts
          setup:
          when: bootstrap_connect is failed

        - name: Include gather_facts.yml
          include_tasks: gather_facts.yml
          when: bootstrap_connect is failed

        - name: Install bootstrap packages (raw)
          raw: "{{ ansible_python_interpreter | default('python') }} -m pip install --upgrade pip && {{ ansible_python_interpreter | default('python') }} -m pip install {{ bootstrap_facts_packages | join(' ') }}"
          when:
            - bootstrap_connect is failed
            - ansible_python_interpreter is not defined

    - name: Gather Ansible facts
      setup:
      register: system_facts

    - name: Install bootstrap packages (package)
      package:
        name: "{{ bootstrap_facts_packages }}"
        update_cache: true
      become: "{{ bootstrap_become }}"

