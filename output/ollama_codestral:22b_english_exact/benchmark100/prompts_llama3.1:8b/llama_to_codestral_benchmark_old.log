       name: "{{ group.name }}"
       state: present
       gid: "{{ group.gid | default(omit) }}"
       system: "{{ group.system | default(omit) }}"

   - name: Configure sudo options for a group
     template:
       src: sudo_group.j2
       dest: "/etc/sudoers.d/{{ group.name }}"
       mode: '0640'
       validate: '/usr/sbin/visudo -cf %s'
     when: group.sudo is defined


