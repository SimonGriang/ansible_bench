---
   - name: Enable specific Apache2 modules
     community.general.apache2_module:
       state: present
       name: "{{ item }}"
     loop:
       - proxy
       - proxy_http
     when: ansible_os_family == 'Debian' or ansible_os_family == 'Suse'

   - name: Configure Apache2 locations
     template:
       src: location.conf.j2
       dest: "/etc/httpd/conf.d/location_{{ item.label }}.conf"
       mode: 0644
     loop: "{{ httpd_locations }}"
     loop_control:
       label: "{{ item.label }}"
     notify:
       - Test httpd
       - Restart httpd

