---
- name: Create SSL private key
  openssl_privatekey:
    path: "{{ ssl_private_key_path }}"
    mode: "{{ ssl_private_key_mode }}"
    owner: "{{ ssl_private_key_owner }}"
    group: "{{ ssl_private_key_group }}"

- name: Create SSL Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ ssl_csr_path }}"
    privatekey_path: "{{ ssl_private_key_path }}"
    common_name: "{{ ssl_common_name }}"
    mode: "{{ ssl_csr_mode }}"
    owner: "{{ ssl_csr_owner }}"
    group: "{{ ssl_csr_group }}"

- name: Create SSL certificates
  openssl_certificate:
    path: "{{ ssl_cert_path }}"
    privatekey_path: "{{ ssl_private_key_path }}"
    csr_path: "{{ ssl_csr_path }}"
    provider: selfsigned
    mode: "{{ ssl_cert_mode }}"
    owner: "{{ ssl_cert_owner }}"
    group: "{{ ssl_cert_group }}"

- name: Create a PKCS#12 file
  openssl_pkcs12:
    path: "{{ ssl_pkcs12_path }}"
    privatekey_path: "{{ ssl_private_key_path }}"
    certificate_path: "{{ ssl_cert_path }}"
    friendly_name: "{{ ssl_pkcs12_friendly_name }}"
    mode: "{{ ssl_pkcs12_mode }}"
    owner: "{{ ssl_pkcs12_owner }}"
    group: "{{ ssl_pkcs12_group }}"

- name: Read the private key
  slurp:
    src: "{{ ssl_private_key_path }}"
  register: ssl_private_key_content

- name: Read the certificate
  slurp:
    src: "{{ ssl_cert_path }}"
  register: ssl_cert_content

- name: Create a combined private key and certificate file
  copy:
    content: "{{ ssl_private_key_content['content'] | b64decode }}\n{{ ssl_cert_content['content'] | b64decode }}"
    dest: "{{ ssl_combined_path }}"
    mode: "{{ ssl_combined_mode }}"
    owner: "{{ ssl_combined_owner }}"
    group: "{{ ssl_combined_group }}"


