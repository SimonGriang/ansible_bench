---
   - name: Migrate adoptopenjdk to temurin (if selected)
     set_fact:
       java_jdk_vendor: "temurin"
     when: java_jdk_vendor == "adoptopenjdk"

   - name: Gather OS specific variables
     include_vars: "{{ item }}"
     with_first_found:
       - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"

   - name: Gather architecture specific variables
     include_vars: architecture.yml

   - name: Set OS-specific variables (I)
     set_fact:
       java_open_jdk_package: "{{ java_open_jdk_package_override | default(java_open_jdk_package, true) }}"
       java_open_jdk_home_dir: "{{ java_open_jdk_home_dir_override | default(java_open_jdk_home_dir, true) }}"

   - name: Set OS and architecture specific variables (II)
     set_fact:
       java_open_jdk_home_dir: "{{ java_open_jdk_home_dir_override | default(java_open_jdk_home_dir, true) }}"
       java_open_jdk_package: "{{ java_open_jdk_package_override | default(java_open_jdk_package, true) }}"

   - name: Set specific variables
     set_fact:
       java_home: "{{ java_open_jdk_home }}"

   - name: Debian pre-requisites
     block:
       - name: Remove deprecated repositories
         apt_repository:
           repo: "{{ item }}"
           state: absent
         loop: "{{ java_jdk_debian_deprecated_repos }}"
       - name: Install extra apt tools
         apt:
           name: "{{ java_jdk_debian_extra_apt_tools }}"
           state: present
       - name: Add required key repositories
         apt_key:
           url: "{{ item }}"
           state: present
         loop: "{{ java_jdk_debian_required_keys }}"
       - name: Add required repositories
         apt_repository:
           repo: "{{ item }}"
           state: present
         loop: "{{ java_jdk_debian_required_repos }}"
     when: ansible_os_family == "Debian"

   - name: RedHat pre-requisites
     block:
       - name: Add required key repositories
         rpm_key:
           key: "{{ item }}"
           state: present
         loop: "{{ java_jdk_redhat_required_keys }}"
       - name: Add required repositories
         yum_repository:
           name: "{{ item.name }}"
           description: "{{ item.description }}"
           baseurl: "{{ item.baseurl }}"
           gpgcheck: "{{ item.gpgcheck | default(omit) }}"
           gpgkey: "{{ item.gpgkey | default(omit) }}"
           enabled: "{{ item.enabled | default(omit) }}"
         loop: "{{ java_jdk_redhat_required_repos }}"
     when: ansible_os_family == "RedHat"

   - name: Install required libs
     package:
       name: "{{ java_required_libs }}"
       state: present

   - name: Install Java, Debian
     apt:
       name: "{{ java_open_jdk_package }}"
       state: present
     when: ansible_os_family == "Debian"

   - name: Install Java, RedHat
     yum:
       name: "{{ java_open_jdk_package }}"
       state: present
     when: ansible_os_family == "RedHat"

   - name: Export environment variables
     template:
       src: jdk.sh.j2
       dest: /etc/profile.d/jdk.sh

   - name: Source environment variables
     shell: source /etc/profile
     args:
       executable: /bin/bash

   - name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
     set_fact:
       java_home: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre"
     when: java_home_version is version('11', '<')

   - name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
     set_fact:
       java_home: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}"
     when: java_home_version is version('11', '>=')

