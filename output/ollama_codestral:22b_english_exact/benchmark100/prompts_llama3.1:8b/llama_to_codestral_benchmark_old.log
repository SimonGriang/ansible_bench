r be ready - with CNI\n     shell: >\n       kubectl get nodes {{ inventory_hostname }}\n       -o jsonpath=\'{.status.conditions[?(@.type=="Ready")].status}\'\n     register: result\n     until: "\'True\' in result.stdout"\n     retries: 30\n     delay: 10\n\n   - name: Restore etcd\n     block:\n       - name: Remove old secrets\n         command: kubectl delete secrets --all -n kube-system\n\n       - name: Remove old nodes\n         command: kubectl delete nodes --all\n\n       - name: Create new nodes\n         command: >\n           kubectl replace --force\n           -f /etc/rancher/rke2/server/node-state.json\n\n   - name: Set an Active Server variable\n     set_fact:\n       active_server: "{{ inventory_hostname }}"\n     delegate_to: "{{ item }}"\n     delegate_facts: true\n     loop: "{{ groups[rke2_cluster_group_name] }}"\n...' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-13T23:39:23.156455084Z', 'done': True, 'done_reason': 'stop', 'total_duration': 37865815972, 'load_duration': 24496672, 'prompt_eval_count': 3217, 'prompt_eval_duration': 1661561649, 'eval_count': 1560, 'eval_duration': 36178370289, 'model_name': 'codestral:22b'} id='run--3bbd2eb3-a161-4d65-9944-41118ceb4f8c-0' usage_metadata={'input_tokens': 3217, 'output_tokens': 1560, 'total_tokens': 4777}
