---
   - name: Create SSH key directory
     ansible.builtin.file:
       path: "{{ users_ssh_key_directory }}"
       state: directory
       mode: '0750'
     when: manage_ssh_key | default(false) | bool

   - name: Manage user account
     ansible.builtin.user:
       name: "{{ user.name }}"
       state: "{{ user.state | default('present') }}"
       comment: "{{ user.comment | default(omit) }}"
       create_home: "{{ user.create_home | default(omit) }}"
       password: "{{ user.password | default(omit) }}"
       uid: "{{ user.uid | default(omit) }}"
       group: "{{ user.group | default(omit) }}"
       groups: "{{ user.groups | default(omit) }}"
       home: "{{ user.home | default(omit) }}"
       shell: "{{ user.shell | default(omit) }}"
       update_password: "{{ user.update_password | default(omit) }}"
       expires: "{{ user.expires | default(omit) }}"
       system: "{{ user.system | default(omit) }}"

   - name: Set sudo options
     ansible.builtin.template:
       src: sudo.j2
       dest: "/etc/sudoers.d/{{ user.name }}"
       mode: '0640'
       validate: '/usr/sbin/visudo --check --file %s'
     when: sudo_options is defined

   - name: Remove sudo options
     ansible.builtin.file:
       path: "/etc/sudoers.d/{{ user.name }}"
       state: absent
     when: sudo_options is not defined

   - name: Generate private SSH key
     ansible.builtin.command: "{{ users_ssh_keygen_command }} {{ user.name }}"
     delegate_to: localhost
     become: false
     when: manage_ssh_key | default(false) | bool

   - name: Generate public SSH key
     ansible.builtin.shell: "{{ users_ssh_keygen_pubkey_command }} {{ user.name }}"
     args:
       chdir: "{{ users_ssh_key_directory }}"
     delegate_to: localhost
     become: false
     when: manage_ssh_key | default(false) | bool

   - name: Convert private SSH key to ppk format
     ansible.builtin.shell: ssh-keygen -e -f "{{ users_ssh_key_directory }}/{{ user.name }}" -C "Generated by Ansible role robertdebock.users"
     args:
       chdir: "{{ users_ssh_key_directory }}"
     delegate_to: localhost
     become: false
     when: manage_ssh_key | default(false) | bool

   - name: Get or set home directory
     ansible.builtin.getent:
       database: passwd
       key: "{{ user.name }}"
       fail_key: false
     register: user_info

   - name: Set home directory to /home if user not found
     ansible.builtin.set_fact:
       home_directory: "/home"
     when: user_info.ansible_facts.getent_passwd is undefined

   - name: Create .ssh directory
     ansible.builtin.file:
       path: "{{ home_directory | default(user_info.ansible_facts.getent_passwd[user.name][4]) }}/.ssh"
       state: directory
       mode: '0700'
       owner: "{{ user.name }}"
       group: "{{ user.name }}"
     become: true
     become_user: "{{ user.name }}"
     when: manage_ssh_key | default(false) | bool or private_keys is defined

   - name: Deploy authorized keys
     ansible.posix.authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
     with_items: "{{ authorized_keys }}"
     when: authorized_keys is defined

   - name: Remove unauthorized keys
     ansible.posix.authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
       state: absent
     with_items: "{{ unauthorized_keys }}"
     when: unauthorized_keys is defined

   - name: Copy private SSH key
     ansible.builtin.copy:
       src: "{{ users_ssh_key_directory }}/{{ user.name }}"
       dest: "{{ home_directory | default(user_info.ansible_facts.getent_passwd[user.name][4]) }}/.ssh/id_rsa"
       mode: '0400'
       owner: "{{ user.name }}"
       group: "{{ user.name }}"
     when: copy_private_key | default(false) | bool

   - name: Check password valid time
     ansible.builtin.command: awk 'BEGIN { FS = ":" } $1 == "{{ user.name }}" { print $5 }' /etc/shadow
     register: password_valid_time
     changed_when: false

   - name: Set password valid time
     ansible.builtin.command: chage -M "{{ user.password_validity_days }}" "{{ user.name }}"
     when: user.password_validity_days is defined and password_valid_time.stdout != user.password_validity_days

   - name: Place private key file
     ansible.builtin.copy:
       content: "{{ item.content }}"
       dest: "{{ home_directory | default(user_info.ansible_facts.getent_passwd[user.name][4]) }}/.ssh/{{ item.filename }}"
       mode: '0400'
       owner: "{{ user.name }}"
       group: "{{ user.name }}"
     with_items: "{{ private_keys }}"
     when: private_keys is defined
   

