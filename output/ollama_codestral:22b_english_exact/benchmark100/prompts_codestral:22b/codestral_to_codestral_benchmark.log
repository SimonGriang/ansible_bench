 - name: gather_facts | Lookup bootstrap facts
      shell: |
        set -o pipefail
        /usr/bin/python3 -c 'import platform; print(platform.release())'
      register: bootstrap_facts
      args:
        executable: /bin/bash
      changed_when: false
      check_mode: no

    - name: gather_facts | Set bootstrap facts (I)
      set_fact:
        bootstrap_distribution: >
          {{ (bootstrap_facts.stdout | regex_search('(?i)(ubuntu|redhat|centos|oracle|suse|debian|alpine|arch|fedora|opensuse)'))[0]
          | lower }}
        bootstrap_major_version: >
          {{ (bootstrap_facts.stdout | regex_search('([0-9]+\.[0-9]+)'))[0] }}
      when:
        - bootstrap_facts is succeeded
        - bootstrap_distribution is not defined

    - name: gather_facts | Set bootstrap facts (II)
      set_fact:
        bootstrap_os_family: >
          {{ (os_family_map | dict2items | selectattr('value', 'equalto', bootstrap_distribution) | list | first).key }}
      vars:
        os_family_map:
          RedHat: redhat
          RedHat: centos
          RedHat: oracle
          Debian: debian
          Debian: ubuntu
          Suse: suse
          Suse: opensuse
          Archlinux: arch
          Alpine: alpine
          Fedora: fedora
          Solaris: sunos
      when:
        - bootstrap_distribution is defined
        - bootstrap_distribution in os_family_map.values()

