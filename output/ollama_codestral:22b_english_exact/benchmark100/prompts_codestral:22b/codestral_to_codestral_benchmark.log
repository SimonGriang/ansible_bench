---
   - name: Task 1: Create the RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory
       owner: root
       group: root
       mode: '0700'

   - name: Task 2: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_type == 'server'

   - name: Task 3: Copy rke2 config
     copy:
       src: "{{ rke2_config }}"
       dest: /etc/rancher/rke2/config.yaml
       owner: root
       group: root
       mode: '0600'
     notify: Config file changed

   - name: Task 4: Copy kubelet config
     copy:
       src: templates/kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       owner: root
       group: root
       mode: '0600'
     when: rke2_kubelet_config != ''
     notify: Config file changed

   - name: Task 5: Copy Containerd Registry Configuration file
     copy:
       src: "{{ rke2_custom_registry_path }}"
       dest: /etc/rancher/rke2/registries.yaml
       owner: root
       group: root
       mode: '0600'
     when: rke2_custom_registry_mirrors != '' or rke2_custom_registry_configs != ''
     notify: Config file changed

   - name: Task 6: Register if we need to do a etcd restore from file
     set_fact:
       do_etcd_restore: true
     when: rke2_etcd_snapshot_file != '' and (ansible_facts.services['rke2-server.service'] is not defined or ansible_facts.services['rke2-server.service'].state != 'running')

   - name: Task 7: Register if we need to do a etcd restore from s3
     set_fact:
       do_etcd_restore_from_s3: true
     when: rke2_etcd_snapshot_file != '' and rke2_etcd_snapshot_s3_options is defined and 'access_key' in rke2_etcd_snapshot_s3_options and 'secret_key' in rke2_etcd_snapshot_s3_options and 'bucket' in rke2_etcd_snapshot_s3_options and 'snapshot_name' in rke2_etcd_snapshot_s3_options

   - name: Task 8: Restore etcd from file
     block:
       - file:
           path: /var/lib/rancher/rke2/server/db/snapshots
           state: directory
         become: true

       - copy:
           src: "{{ rke2_etcd_snapshot_file }}"
           dest: /var/lib/rancher/rke2/server/db/snapshots
           become: true

       - command: rke2 server --config /etc/rancher/rke2/config.yaml --etcd-restore-snapshot-name snapshot.db
         become: true
         register: etcd_restore_output
         changed_when: "'Successfully restored snapshot' in etcd_restore_output.stdout"
     when: do_etcd_restore is defined

   - name: Task 9: Restore etcd from s3
     block:
       - command: rke2 server --config /etc/rancher/rke2/config.yaml --etcd-s3 --etcd-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }} --etcd-s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }} --etcd-s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }} --etcd-s3-snapshot-name {{ rke2_etcd_snapshot_s3_options.snapshot_name }}
         become: true
         register: etcd_restore_output
         changed_when: "'Successfully restored snapshot' in etcd_restore_output.stdout"
     when: do_etcd_restore_from_s3 is defined

   - name: Task 10: Start RKE2 service on the first server
     systemd:
