---
- name: Install epel
  yum:
    name: epel-release
  when: >
    ansible_os_family == 'RedHat' and
    (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2' or
    ansible_distribution in ['RedHat', 'CentOS'] and
    ansible_distribution_major_version in ['7', '8', '9', '10'])

- name: Install epel gpg key
  rpm_key:
    state: present
    key: "{{ epel_gpg_key }}"

- name: Install epel-release
  yum:
    name: "{{ epel_url }}"
  notify: Update package cache

- name: Install epel-next-release
  yum:
    name: "{{ epel_next_url }}"
  notify: Update package cache
  when: epel_next | bool


