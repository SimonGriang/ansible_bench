---
   - name: Download RKE2 installation script
     get_url:
       url: "{{ rke2_install_url }}"
       dest: "{{ rke2_install_path }}"
     when: not rke2_airgap_mode_enabled

   - name: Copy local RKE2 installation script
     copy:
       src: "{{ rke2_local_install_path }}"
       dest: "{{ rke2_install_path }}"
     when:
       - rke2_airgap_mode_enabled
       - rke2_airgap_implementation == 'copy'

   - name: Create RKE2 artifacts folder
     file:
       path: "{{ rke2_artifacts_path }}"
       state: directory
       mode: "{{ rke2_artifacts_permissions }}"
     when:
       - rke2_airgap_mode_enabled
       - rke2_airgap_implementation != 'exists'

   - name: Download RKE2 checksum and artifacts
     block:
       - name: Download RKE2 checksum file
         get_url:
           url: "{{ rke2_checksum_url }}"
           dest: "{{ rke2_checksum_path }}"
         register: checksum_file

       - name: Download RKE2 artifacts
         get_url:
           url: "{{ rke2_artifacts_url }}"
           dest: "{{ rke2_artifacts_path }}"
         register: artifacts_file

       - name: Verify checksums
         command: "sha256sum -c {{ rke2_checksum_path }}"
         args:
           chdir: "{{ rke2_artifacts_path }}"
         changed_when: false

       - name: Fallback to local RKE2 install script
         get_url:
           url: "{{ rke2_fallback_install_url }}"
           dest: "{{ rke2_install_path }}"
         when: checksum_file is failed or artifacts_file is failed
     when:
       - rke2_airgap_mode_enabled
       - rke2_airgap_implementation == 'download'

   - name: Copy local RKE2 artifacts
     copy:
       src: "{{ rke2_local_artifacts_path }}"
       dest: "{{ rke2_artifacts_path }}"
     when:
       - rke2_airgap_mode_enabled
       - rke2_airgap_implementation == 'copy'

   - name: Copy additional images tarballs
     block:
       - name: Create additional images directory
         file:
           path: "{{ rke2_additional_images_path }}"
           state: directory
           mode: "{{ rke2_additional_images_permissions }}"

       - name: Copy additional images
         copy:
           src: "{{ rke2_local_additional_images_path }}"
           dest: "{{ rke2_additional_images_path }}"
     when:
       - rke2_airgap_mode_enabled
       - rke2_additional_images_to_copy
       - rke2_airgap_implementation != 'exists'

   - name: Ensure artifacts exist and have acceptable permissions
     block:
       - name: Check artifacts existence and permissions
         stat:
           path: "{{ rke2_install_path }}"
         register: artifacts_stat

       - name: Change artifacts permissions
         file:
           path: "{{ rke2_install_path }}"
           mode: '0444'
         when: artifacts_stat.stat.writeable

       - name: Make install script executable
         file:
           path: "{{ rke2_install_path }}"
           mode: '0555'
         when: not artifacts_stat.stat.executable

       - name: Fail if install script does not exist or is not executable
         fail:
           msg: "RKE2 install script does not exist or is not executable"
         when: not artifacts_stat.stat.exists or not artifacts_stat.stat.executable
     when:
       - rke2_airgap_mode_enabled
       - rke2_airgap_implementation == 'exists'

   - name: Set RKE2 bin path
     block:
       - name: Populate service facts
         service_facts:

       - name: Get stats of the filesystem object
         stat:
           path: "/"
         register: root_stats

       - name: Check if separate partition
         set_fact:
           rke2_bin_path: "{{ rke2_separate_partition_path }}"
         when: root_stats.stat.mount != '/'

   - name: Check RKE2 version
     block:
       - name: Check RKE2 version using binary
         command: "{{ rke2_bin_path }}/rke2 --version"
         register: rke2_version_output
         changed_when: false
         ignore_errors: true

       - name: Set installed version
         set_fact:
           installed_version: "not installed"
         when: rke2_version_output is failed

       - name: Check running RKE2 version
         command: "{{ rke2_service_binary }} --version"
         register: running_version_output
         changed_when: false
         ignore_errors: true
         when: "'rke2.service' in services"

       - name: Set running version
         set_fact:
           running_version: "{{ desired_rke2_version }}"
         when: running_version_output is failed
     when: rke2_version_output is failed or running_version_output is failed

   - name: Prevent accidental RKE2 downgrade
