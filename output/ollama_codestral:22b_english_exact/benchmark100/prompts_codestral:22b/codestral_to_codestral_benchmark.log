           repo: 'deb https://packages.adoptium.net/artifactory/deb/{{ ansible_distribution_release }} main'
           state: present
     when: ansible_os_family == 'Debian'

   - name: Handle RedHat pre-requisites for Java
     block:
       - name: Add required key repositories
         rpm_key:
           key: 'https://packages.adoptium.net/artifactory/api/gpg/key/public'
           state: present

       - name: Add required repositories
         yum_repository:
           name: 'adoptopenjdk'
           description: 'AdoptOpenJDK'
