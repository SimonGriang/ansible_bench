---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
       state: present
     notify:
       - Set root password
       - Reexecute systemd daemon

   - name: Configure mysql server
     lineinfile:
       path: /etc/mysql/mysql.conf.d/mysqld.cnf
       section: "{{ item.section }}"
       regexp: "^\\s*{{ item.option }}\\s*="
       line: "{{ item.option }} = {{ item.value }}"
     with_items: "{{ mysql_configuration_options }}"
     notify:
       - Restart mysql server

   - name: Configure mysql client
     lineinfile:
       path: /etc/mysql/mysql.conf.d/mysql-client.cnf
       section: client
       regexp: "^\\s*socket\\s*="
       line: "socket = {{ mysql_socket }}"

   - name: Initialize mysql
     command: "{{ mysql_initialize_command }}"
     when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"

   - name: Start and enable mysql
     service:
       name: mysql
       state: started
       enabled: yes

   - name: Flush handlers
     meta: flush_handlers

   - name: Place my.cnf
     template:
       src: my.cnf.j2
       dest: /root/.my.cnf
       mode: 0600

   - name: Create databases
     mysql_db:
       name: "{{ item.name }}"
       state: present
       login_user: root
       login_password: "{{ mysql_root_password }}"
     with_items: "{{ mysql_databases }}"
     when: mysql_databases is defined and 'initial_import' not in item

   - name: List databases
     shell: >
       mysql -u root --password='{{ mysql_root_password }}' -e 'SHOW DATABASES;'
     register: mysql_info
     changed_when: false

   - name: Import database
     mysql_db:
       name: "{{ item.name }}"
       state: import
       target: "{{ item.initial_import }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
     with_items: "{{ mysql_databases }}"
     when: 'initial_import' in item and item.name not in mysql_info.stdout_lines

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       host: "{{ item.host | default('localhost') }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       state: present
       login_user: root
       login_password: "{{ mysql_root_password }}"
     with_items: "{{ mysql_users }}"
     when: mysql_users is defined

   - name: Flush handlers again
     meta: flush_handlers

