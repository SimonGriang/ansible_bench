---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
  - name: Manage SELinux state and policy
    selinux:
      state: "{{ selinux_state }}"
      policy: "{{ selinux_policy }}"
    notify: Reboot
    when:
      - selinux_status is defined
      - ansible_connection not in ['container', 'docker', 'community.docker.docker']

  - name: Manage SELinux booleans
    seboolean:
      name: "{{ item.name }}"
      state: "{{ item.state | default('yes') }}"
      persistent: "{{ item.persistent | default('yes') }}"
    loop: "{{ selinux_booleans | default([]) }}"
    when:
      - selinux_status is defined
      - ansible_connection not in ['container', 'docker', 'community.docker.docker']
  when: selinux_status is defined


