       | from_json
       | json_query('items[?metadata.name==`' + ansible_facts.hostname + '`].status.conditions[?type==`Ready`].status')
       | first == 'True'
     retries: 30
     delay: 5
     when: rke2_cni == 'none'

   - name: Task 13: Wait for the first server to be ready - with CNI
     command: kubectl get nodes -o json
     register: node_status
     until: >
       node_status.stdout
       | from_json
       | json_query('items[?metadata.name==`' + ansible_facts.hostname + '`].status.conditions[?type==`Ready`].status')
       | first == 'True'
       and node_status.stdout
       | from_json
       | json_query('items[?metadata.name==`' + ansible_facts.hostname + '`].status.conditions[?type==`NetworkUnavailable`].status')
       | first == 'False'
     retries: 30
     delay: 5
     when: rke2_cni != 'none'

   - name: Task 14: Restore etcd
     block:
       - command: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
         register: registered_nodes

       - command: kubectl delete secrets -l node-role.kubernetes.io/etcd
         ignore_errors: yes

       - command: kubectl delete nodes {{ item }}
         loop: "{{ registered_nodes.stdout.split() }}"
         ignore_errors: yes

       - set_fact:
           active_server: "{{ ansible_facts.hostname }}"
     when: >
       do_etcd_restore is defined
       or do_etcd_restore_from_s3 is defined
   

