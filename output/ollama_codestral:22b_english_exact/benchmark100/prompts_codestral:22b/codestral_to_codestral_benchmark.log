---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install python pip
     pip:
       name: "{{ python_pip_packages }}"
       state: present

   - name: Configure pip proxy
     blockinfile:
       path: /etc/pip.conf
       mode: '0644'
       create: true
       block: |
         [global]
         index-url = {{ python_pip_proxy }}
     when: python_pip_proxy is defined

   - name: Trust hosts
     blockinfile:
       path: /etc/pip.conf
       mode: '0644'
       create: true
       block: |
         [global]
         trusted-host = {{ python_pip_trusted_host }}
     when: python_pip_trusted_host is defined

   - name: Update pip
     pip:
       name: "{{ python_pip_pip_package }}"
       state: "{{ python_pip_pip_state }}"
       executable: "{{ python_pip_executable | default(omit) }}"
     when: >
       python_pip_update
       and ansible_distribution not in ['Bookworm', 'Noble']
       and ansible_os_family != 'Alpine'

   - name: Install requested modules
     pip:
       name: "{{ item.name }}{% if item.version is defined %}=={{ item.version }}{% endif %}"
       state: "{{ item.state | default('present') }}"
       executable: "{{ python_pip_executable | default(omit) }}"
     loop: "{{ python_pip_modules }}"
     loop_control:
       label: "{{ item.name }}"
     when: >
       ansible_distribution not in ['Bookworm', 'Noble']
       and ansible_os_family != 'Alpine'

