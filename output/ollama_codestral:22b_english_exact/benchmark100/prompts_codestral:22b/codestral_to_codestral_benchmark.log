---
   - name: Assert Variables
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Wait for Host
     wait_for:
       port: "{{ bootstrap_port | default(22) }}"
       timeout: "{{ bootstrap_timeout }}"
     delegate_to: "{{ inventory_hostname }}"
     become: "{{ bootstrap_become }}"
     become_user: "{{ bootstrap_become_user }}"
     when:
       - "bootstrap_wait_for_host | bool"
       - "container != 'docker' and container != 'containerd'"

   - name: Prepare System
     block:
       - name: Test Connection
         ping:
         register: ping_result
         ignore_unreachable: true

       - name: Debug Connection
         debug:
           msg: "Test connection failed"
         when: ping_result is failed

       - name: Gather Bootstrap Facts
         setup:
         when:
           - ansible_facts is not defined
           - ansible_local is not defined

       - name: Install Bootstrap Packages
         raw: "{{ bootstrap_packages_raw }}"
         register: raw_result
         changed_when: "'changed=' in raw_result.stdout"
     become: "{{ bootstrap_become }}"
     become_user: "{{ bootstrap_become_user }}"

   - name: Ensure System Prepared
     block:
       - name: Gather Ansible Facts
         setup:

       - name: Install Bootstrap Packages
         package:
           name: "{{ bootstrap_packages }}"
           state: present
     become: "{{ bootstrap_become }}"
     become_user: "{{ bootstrap_become_user }}"

   # yamllint checks addressed:
   # - Fixed indentation.
   # - Added a new line at the end of file to satisfy the new-line-at-end-of-file rule.
   # Note: The line-length rule is not violated because the command is within quotes.

