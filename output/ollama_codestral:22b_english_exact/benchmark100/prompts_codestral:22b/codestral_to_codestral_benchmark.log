---
   - name: Migrate Java JDK vendor from 'adoptopenjdk' to 'temurin' if selected
     set_fact:
       java_jdk_vendor: "temurin"
     when: java_jdk_vendor == 'adoptopenjdk'

   - name: Gather OS-specific variables for Java
     include_vars: "{{ java_jdk_vendor }}/{{ ansible_os_family | lower }}.yml"

   - name: Gather architecture-specific variables for Java
     include_vars: "architecture.yml"

   - name: Set OS-specific variables for Java (I)
     set_fact:
       java_home: "{{ java_home | default(java_open_jdk_home) }}"
       java_package: "{{ java_package | default(java_open_jdk_package) }}"

   - name: Set OS and architecture-specific variables for Java (II)
     set_fact:
       java_home: "{{ java_open_jdk_home }}"

   - name: Handle Debian pre-requisites for Java
     block:
       - name: Remove deprecated repositories
         apt_repository:
           repo: 'deb https://adoptopenjdk.jfrog.io/adoptopenjdk/deb/ {{ ansible_distribution_release }} main'
           state: absent

       - name: Install extra apt tools
         apt:
           name: ['apt-transport-https', 'ca-certificates', 'gnupg', 'software-properties-common']
           state: present

       - name: Add required key repositories
         apt_key:
           url: 'https://packages.adoptium.net/artifactory/api/gpg/key/public'
           state: present

       - name: Add required repositories
         apt_repository:
           repo: 'deb https://packages.adoptium.net/artifactory/deb/ {{ ansible_distribution_release }} main'
           state: present
     when: ansible_os_family == 'Debian'

   - name: Handle RedHat pre-requisites for Java
     block:
       - name: Add required key repositories
         rpm_key:
           key: 'https://packages.adoptium.net/artifactory/api/gpg/key/public'
           state: present

       - name: Add required repositories
         yum_repository:
           name: 'adoptopenjdk'
           description: 'AdoptOpenJDK'
           baseurl: 'https://packages.adoptium.net/artifactory/rpm/{{ ansible_os_family | lower }}/$releasever/$basearch'
           gpgcheck: yes
           gpgkey: 'https://packages.adoptium.net/artifactory/api/gpg/key/public'
           enabled: yes
     when: ansible_os_family == 'RedHat'

   - name: Install required libraries for Java
     package:
       name: "{{ java_package_dependencies }}"
       state: present

   - name: Install Java on Debian
     apt:
       name: "{{ java_package }}"
       state: present
       update_cache: yes
     when: ansible_os_family == 'Debian'

   - name: Install Java on RedHat
     yum:
       name: "{{ java_package }}"
       state: present
     when: ansible_os_family == 'RedHat'

   - name: Export environment variables for Java
     template:
       src: 'jdk.sh.j2'
       dest: '/etc/profile.d/jdk.sh'

   - name: Source environment variables for Java
     shell: 'source /etc/profile.d'

   - name: Correct Java version selected for Java < 11
     alternatives:
       name: java
       path: "{{ java_home }}/bin/java"
     when: java_version | int < 11

   - name: Correct Java version selected for Java >= 11
     alternatives:
       name: javac
       path: "{{ java_home }}/bin/javac"
     when: java_version | int >= 11

