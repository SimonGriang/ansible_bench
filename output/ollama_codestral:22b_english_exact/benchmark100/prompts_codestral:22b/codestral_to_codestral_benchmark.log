---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install cron
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure shell
     lineinfile:
       path: "{{ cron_configuration }}"
       regexp: '^SHELL='
       line: 'SHELL={{ cron_shell }}'
       create: yes
       mode: 0600
     notify: Restart cron

   - name: Configure path
     lineinfile:
       path: "{{ cron_configuration }}"
       regexp: '^PATH='
       line: 'PATH={{ cron_path }}'
       create: yes
       mode: 0600
     notify: Restart cron

   - name: Configure mailto
     lineinfile:
       path: "{{ cron_configuration }}"
       regexp: '^MAILTO='
       line: 'MAILTO={{ cron_mailto }}'
       create: yes
       mode: 0600
     notify: Restart cron

   - name: Start and enable cron
