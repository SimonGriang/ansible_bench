---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install dns
     package:
       name: bind9
       state: present

   - name: Create directories
     file:
       path: "{{ item }}"
       state: directory
       owner: bind
       group: bind
       mode: 0755
     loop:
       - /var/cache/bind
       - /etc/bind

   - name: Create group
     group:
       name: bind
       system: true

   - name: Create user
     user:
       name: bind
       group: bind
       system: true

   - name: Generate rndc key
     shell: rndc-confgen -a -c /etc/bind/rndc.key
     args:
       creates: /etc/bind/rndc.key

   - name: Set permissions on rndc key file
     file:
       path: /etc/bind/rndc.key
       owner: bind
       group: bind
       mode: 0644

   - name: Get the hints/root file
     get_url:
       url: https://www.internic.net/domain/named.cache
       dest: /var/cache/bind/named.cache
     when: dns_caching | bool

   - name: Create zone file
     template:
       src: zone.j2
       dest: "/var/cache/bind/{{ item }}.zone"
     loop: "{{ dns_primary_zones }}"
     when: dns_primary_zones is defined

   - name: Add zones to configuration
     template:
       src: named.conf.local.j2
       dest: /etc/bind/named.conf.local

   - name: Place systemd override
     template:
       src: bind9.service.j2
       dest: /etc/systemd/system/bind9.service.d/override.conf
     when: ansible_service_mgr == "systemd"

   - name: Start and enable dns
     service:
       name: bind9
       state: started
       enabled: true

