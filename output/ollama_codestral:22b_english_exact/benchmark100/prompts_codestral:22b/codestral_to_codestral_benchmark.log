---
   - name: MySQL Server Setup
     hosts: all
     become: true

     tasks:
       - name: Import assert.yml
         import_tasks: assert.yml
         run_once: true

       - name: Install mysql
         package:
           name: "{{ mysql_packages }}"
         notify:
           - Set root password
           - Systemctl daemon-reexec

       - name: Configure mysql server
         lineinfile:
           path: "{{ mysql_configuration_destination }}/mysql-server.cnf"
           regexp: "^{{ item.key }} ="
           line: "{{ item.key }} = {{ item.value }}"
         loop: "{{ mysql_configuration_options|dict2items }}"
         notify:
           - Restart mysql server

       - name: Configure mysql client
         lineinfile:
           path: "{{ mysql_configuration_destination }}/mysql-client.cnf"
           regexp: "^socket ="
           line: "socket = {{ mysql_socket }}"

       - name: Initialize mysql
         command: "{{ mysql_initialize_command }}"
         when: ansible_os_family in ['Alpine', 'Archlinux']

       - name: Start and enable mysql
         service:
           name: "{{ mysql_service }}"
           state: started
           enabled: true

       - name: Flush handlers
         meta: flush_handlers

       - name: Place my.cnf
         template:
           src: my.cnf.j2
           dest: /root/.my.cnf
           mode: '0640'

       - name: Create databases
         mysql_db:
           name: "{{ item.name }}"
           socket: "{{ mysql_socket }}"
           login_password: "{{ mysql_root_password }}"
         loop: "{{ mysql_databases }}"
         when: mysql_databases is defined

       - name: Create users
         mysql_user:
           name: "{{ item.name }}"
           password: "{{ item.password }}"
           host: "{{ item.host | default('localhost') }}"
           priv: "{{ item.priv }}"
           socket: "{{ mysql_socket }}"
           login_password: "{{ mysql_root_password }}"
         loop: "{{ mysql_users }}"
         when: mysql_users is defined

       - name: Flush handlers again
         meta: flush_handlers

