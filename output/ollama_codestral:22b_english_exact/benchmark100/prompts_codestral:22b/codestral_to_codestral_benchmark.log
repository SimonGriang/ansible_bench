 - name: Install Keepalived
     include_tasks: keepalived.yml
     when:
       - rke2_ha_mode is defined
       - "'RKE2 servers' in group_names"
       - rke2_ha_mode == "Keepalived"

   - name: Install RKE2
     include_tasks: rke2_install.yml

   - name: Apply CIS Hardening
     include_tasks: cis.yml
     when: rke2_cis_profile is defined

   - name: Identify Active Server
     include_tasks: find_active_server.yml

   - name: Enable IPVS Kernel Module
     include_tasks: ipvs_enable.yml
     when:
       - rke2_enable_ipvs_load_balancing | default(false)
       - "'RKE2 servers' in group_names"
       - rke2_ha_mode == "Kubevip"
       - rke2_ha_mode != "Keepalived"

   - name: Copy Kube-vip Manifests
     include_tasks: copy_kubevip_manifests.yml
     when:
       - inventory_hostname == groups['RKE2 servers'][0]
       - rke2_ha_mode == "Kubevip"
       - rke2_ha_mode != "Keepalived"

   - name: Copy Ingress-nginx Manifests
     include_tasks: copy_ingress_nginx_manifests.yml
     when:
       - inventory_hostname == groups['RKE2 servers'][0]
       - rke2_ingress_nginx_values is defined

   - name: Prepare First Server Node
     include_tasks: first_server_prepare.yml
     when:
       - inventory_hostname == groups['RKE2 servers'][0]
       - (active_server is not defined or groups['RKE2 servers'] | length == 1)

   - name: Restore etcd
     include_tasks: first_server_restore.yml
     when:
       - active_server is defined
       - (inventory_hostname == active_server or inventory_hostname == groups['RKE2 servers'][0])
       - rke2_etcd_restore_needed | default(false)

   - name: Download kubeconfig
     include_tasks: download_kubeconfig.yml
     when:
       - rke2_kubeconfig_download | default(false)
       - inventory_hostname == groups['RKE2 servers'][0]

   - name: Prepare and Join Remaining Nodes
     include_tasks: join_remaining_nodes.yml
     when:
       - active_server is defined
       - groups['RKE2 servers'] | length > 1

   - name: Rolling Restart Servers
     include_tasks: rolling_restart.yml
     when:
       - rke2_installed_version is defined
       - rke2_installed_version != rke2_running_version
       - "'RKE2 servers' in group_names"

   - name: Rolling Restart Agents
     include_tasks: rolling_restart.yml
     when:
       - rke2_installed_version is defined
       - rke2_installed_version != rke2_running_version
       - "'RKE2 servers' not in group_names"

   - name: Flush Handlers
     meta: flush_handlers

   - name: Rolling Restart Config Change
     include_tasks: change_config.yml
     when: rke2_restart_needed_config_change | default(false)

   - name: Final Steps
     include_tasks: final_steps.yml

