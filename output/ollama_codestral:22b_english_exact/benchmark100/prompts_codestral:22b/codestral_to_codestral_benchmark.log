---
   - name: Create directories
     file:
       path: /opt/cadvisor
       state: directory
       mode: '0755'

   - name: Download cadvisor binary
     get_url:
       url: "https://github.com/google/cadvisor/releases/download/v0.45.0/cadvisor"
       dest: /opt/cadvisor/cadvisor
       checksum: sha256:3e05377687a334b9484a1e4826f587b35790e499168ac5889c62e71947810170
       mode: '0755'
     when: ansible_facts['filesystem']('/opt/cadvisor/cadvisor') is defined and ansible_facts['filesystem']('/opt/cadvisor/cadvisor')['checksum'] != '3e05377687a334b9484a1e4826f587b35790e499168ac5889c62e71947810170'

   - name: Propagate locally distributed cadvisor binary
     copy:
       src: /local/path/to/cadvisor
       dest: /opt/cadvisor/cadvisor
       mode: '0755'
       owner: cadvisor
       group: cadvisor
     notify: Restart cadvisor service
     when: ansible_facts['filesystem']('/local/path/to/cadvisor') is defined

   - name: Create a symlink
     file:
       src: /opt/cadvisor/cadvisor
       dest: /usr/local/bin/cadvisor
       state: link

   - name: Configure cadvisor systemd service
     copy:
       src: cadvisor.service
       dest: /etc/systemd/system/cadvisor.service
     notify: Restart cadvisor service

   - name: Check cadvisor service status
     shell: systemctl status cadvisor
     register: service_status
     changed_when: false

   - name: Enable cadvisor systemd service
     systemd:
       name: cadvisor
       enabled: yes
       daemon_reload: yes

   - name: Start cadvisor systemd service
     systemd:
       name: cadvisor
       state: started
       daemon_reload: yes

   - name: Handler to restart cadvisor service
     systemd:
       name: cadvisor
       state: restarted
     listen: Restart cadvisor service

