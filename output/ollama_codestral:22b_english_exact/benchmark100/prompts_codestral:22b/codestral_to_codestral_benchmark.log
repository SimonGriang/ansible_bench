---
   - name: Ensure /etc/openvpn/easy-rsa directory exists
     file:
       path: /etc/openvpn/easy-rsa
       state: directory
       mode: '0700'

   - name: Initialize easy-rsa
     shell: "{{ openvpn_easyrsa_path }} init-pki"
     args:
       chdir: /etc/openvpn/easy-rsa
     when: not exists("/etc/openvpn/easy-rsa/pki")

   - name: Build CA
     shell: "EASYRSA_BATCH=yes {{ openvpn_easyrsa_path }} build-ca nopass"
     args:
       chdir: /etc/openvpn/easy-rsa
     when: not exists("/etc/openvpn/easy-rsa/pki/ca.crt")

   - name: Generate Diffie-Hellman parameters
     shell: "{{ openvpn_easyrsa_path }} gen-dh"
     args:
       chdir: /etc/openvpn/easy-rsa
     when: not exists("/etc/openvpn/easy-rsa/pki/dh.pem")

   - name: Build server certificates
     shell: >
       EASYRSA_BATCH=yes
       {{ openvpn_easyrsa_path }} build-server-full server nopass
     args:
       chdir: /etc/openvpn/easy-rsa
     when: not exists("/etc/openvpn/easy-rsa/pki/issued/server.crt")

   - name: Build client certificates
     shell: >
       EASYRSA_BATCH=yes
       {{ openvpn_easyrsa_path }} build-client-full client nopass
     args:
       chdir: /etc/openvpn/easy-rsa
     when: not exists("/etc/openvpn/easy-rsa/pki/issued/client.crt")

   - name: Generate Certificate Revocation List
     shell: "{{ openvpn_easyrsa_path }} gen-crl"
     args:
       chdir: /etc/openvpn/easy-rsa
     when: not exists("/etc/openvpn/easy-rsa/pki/crl.pem")

   - name: Generate TLS Auth Key
     shell: "openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key"
     when: not exists("/etc/openvpn/easy-rsa/pki/ta.key")

   - name: Copy files to /etc/openvpn/server
     copy:
       src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
       dest: "/etc/openvpn/server/{{ item }}"
       mode: '0600'
     loop:
       - ca.crt
       - dh.pem
       - issued/server.crt
       - private/server.key
       - ta.key
     notify: Restart openvpn

   - name: Copy files to /etc/openvpn
     copy:
       src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
       dest: "/etc/openvpn/{{ item }}"
       mode: '0600'
     loop:
       - ca.crt
       - crl.pem
       - dh.pem
       - ta.key

   - name: Place server.conf
     template:
       src: server.conf.j2
       dest: "{{ openvpn_configuration_directory }}/server.conf"
       owner: root
       group: "{{ openvpn_group }}"
       mode: '0640'
     notify: Restart openvpn


