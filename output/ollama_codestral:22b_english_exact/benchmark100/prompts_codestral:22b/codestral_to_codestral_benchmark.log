- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
  notify: gather_facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when: >
    selinux is defined
    and connection != 'container'
    and connection != 'docker'
    and connection != 'community.docker'
  seboolean:
    name: "{{ selinux_state }}"
    state: "{{ selinux_policy }}"
  notify: reboot

- name: Manage selinux booleans
  when: selinux_booleans is defined
  seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state | default('yes') }}"
    persistent: "{{ item.persistent | default(omit) }}"
  loop: "{{ selinux_booleans }}"
  

