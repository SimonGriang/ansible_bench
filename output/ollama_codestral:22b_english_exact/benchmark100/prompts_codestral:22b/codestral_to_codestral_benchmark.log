         ignore_errors: yes

       - command: kubectl delete nodes {{ item }}
         loop: "{{ registered_nodes.stdout.split() }}"
         ignore_errors: yes

       - set_fact:
           active_server: "{{ ansible_facts.hostname }}"
     when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

