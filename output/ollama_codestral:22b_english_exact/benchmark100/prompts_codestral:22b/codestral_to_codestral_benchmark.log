---
   - name: Create SSL key
     openssl_privatekey:
       path: "{{ ssl_key_path }}"
       owner: "{{ ssl_owner }}"
       group: "{{ ssl_group }}"
       mode: 0600

   - name: Create SSL CSR
     openssl_csr:
       path: "{{ csr_path }}"
       privatekey_path: "{{ ssl_key_path }}"
       common_name: "{{ common_name }}"
       owner: "{{ ssl_owner }}"
       group: "{{ ssl_group }}"
       mode: 0640

   - name: Create SSL certificate
     openssl_certificate:
       path: "{{ cert_path }}"
       privatekey_path: "{{ ssl_key_path }}"
       csr_path: "{{ csr_path }}"
       provider: selfsigned
       owner: "{{ ssl_owner }}"
       group: "{{ ssl_group }}"
       mode: 0640

   - name: Create PKCS#12 file
     openssl_pkcs12:
       path: "{{ pkcs12_path }}"
       privatekey_path: "{{ ssl_key_path }}"
       certificate_path: "{{ cert_path }}"
       owner: "{{ ssl_owner }}"
       group: "{{ ssl_group }}"
       mode: 0600

   - name: Read private key
     slurp:
       src: "{{ ssl_key_path }}"
