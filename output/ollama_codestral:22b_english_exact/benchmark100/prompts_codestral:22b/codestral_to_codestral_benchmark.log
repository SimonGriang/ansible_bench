 - name: Import assert.yml
     import_tasks: assert.yml
     run_once: true

   - name: Install using package
     block:
       - name: Setup HashiCorp repositories (RedHat/Rocky)
         yum_repository:
           name: hashicorp
           description: HashiCorp Stable - $basearch
           baseurl: https://rpm.releases.hashicorp.com/RHEL/$releasever/$basearch/stable
           gpgcheck: yes
           gpgkey: https://rpm.releases.hashicorp.com/gpg
         when: ansible_os_family == "RedHat" and hashicorp_installation_method == "package"

       - name: Setup HashiCorp repositories (Debian)
         apt_repository:
           repo: deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main
           state: present
         when: ansible_os_family == "Debian" and hashicorp_installation_method == "package"

       - name: Install required packages (RedHat/Rocky)
         package:
           name: yum-utils
           state: present
         when: ansible_os_family == "RedHat" and hashicorp_installation_method == "package"

       - name: Install required packages (Debian)
         package:
           name: software-properties-common
           state: present
         when: ansible_os_family == "Debian" and hashicorp_installation_method == "package"

       - name: Install HashiCorp products using package manager (RedHat/Rocky)
         package:
           name: "{{ hashicorp_products }}"
           state: present
         when: ansible_os_family == "RedHat" and hashicorp_installation_method == "package"

       - name: Install HashiCorp products using package manager (Debian)
         package:
           name: "{{ hashicorp_products }}"
           state: present
         when: ansible_os_family == "Debian" and hashicorp_installation_method == "package"
     when: hashicorp_installation_method == "package"

   - name: Install manually
     block:
       - name: Install HashiCorp products manually
         unarchive:
           src: "{{ hashicorp_product_src }}"
           dest: "{{ hashicorp_product_dest }}"
           mode: '0755'
           owner: root
           group: root
     when: hashicorp_installation_method == "manual"

