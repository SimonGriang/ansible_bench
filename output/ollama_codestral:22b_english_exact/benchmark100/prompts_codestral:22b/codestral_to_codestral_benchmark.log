---
   - name: Execute git role tasks
     hosts: all
     become: true

     tasks:
       - name: Assert role variables
         import_tasks: assert.yml

       - name: Install git
         package:
           name: "{{ git_packages }}"
           state: present

       - name: Check if user exists
         command: "id -u {{ git_username }}"
         register: user_check
         ignore_errors: true

       - name: Create user's home directory
         file:
           path: "/home/{{ git_username }}"
           state: directory
           owner: "{{ git_username }}"
           group: "{{ git_username }}"
           mode: '0755'
         when: user_check.rc == 0

       - name: Configure git
         template:
           src: gitconfig.j2
           dest: "/home/{{ git_username }}/.gitconfig"
         when:
           - user_check.rc == 0
           - git_username is defined
           - git_email is defined
           - git_name is defined

       - name: Create repository destination
         file:
           path: "{{ git_repository_destination }}"
           state: directory
           owner: "{{ git_username }}"
           group: "{{ git_username }}"
           mode: '0755'
         when:
           - user_check.rc == 0
           - git_repository_destination is defined

       - name: Clone repositories
         git:
           repo: "{{ item }}"
           dest: "{{ git_repository_destination }}/{{ item | basename }}"
           clone: true
           update: false
           accept_hostkey: true
         become_user: "{{ git_username }}"
         with_items: "{{ git_repositories }}"
         when:
           - user_check.rc == 0
           - git_repository_destination is defined
           - git_repositories is defined


