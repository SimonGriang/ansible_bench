     shell: "kubectl taint nodes --all node-role.kubernetes.io/server-"
     when: rke2_type == 'server'

   - name: Set server taints
     shell: "kubectl taint nodes $(hostname) {{ rke2_server_node_taints }} --overwrite"
     when: rke2_type == 'server'

   - name: Set agent taints
     shell: "kubectl taint nodes --all node-role.kubernetes.io/agent-"
     when: rke2_type == 'agent'

   - name: Set agent taints
     shell: "kubectl taint nodes $(hostname) {{ rke2_agent_node_taints }} --overwrite"
     when: rke2_type == 'agent'

   - name: Copy RKE2 config
     copy:
       src: "{{ rke2_config }}"
       dest: /etc/rancher/rke2/config.yaml
       owner: root
       group: root
       mode: "0644"
     notify: Config file changed

   - name: Copy kubelet config
     template:
       src: kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       owner: root
       group: root
       mode: "0644"
     when: rke2_kubelet_config != ''
     notify: Config file changed

   - name: Copy Containerd Registry Configuration file
     copy:
       src: "{{ rke2_custom_registry_path }}"
       dest: /etc/rancher/rke2/registries.yaml
       owner: root
       group: root
       mode: "0644"
     when: rke2_custom_registry_mirrors != '' or rke2_custom_registry_configs != ''
     notify: Config file changed

   - name: Start RKE2 service on the rest of the nodes
     systemd:
       name: "{{ rke2_service_name }}"
       state: started
       enabled: true
       daemon_reload: true
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     notify: Service (re)started

   - name: Mask other RKE2 service on the rest of the nodes
     systemd:
       name: "{{ 'agent' if rke2_type == 'server' else 'server' }}"
       state: stopped
       masked: true

   - name: Wait for remaining nodes to be ready - no CNI
     shell: "kubectl get nodes --no-headers | awk '{print $2}' | grep -v 'Ready' || true"
     register: result
     until: result.stdout == ""
     retries: 60
     delay: 10
     when: rke2_cni == 'none'

   - name: Wait for remaining nodes to be ready - with CNI
     shell: "kubectl get nodes --no-headers | awk '{print $2}' | grep 'Ready' | wc -l"
     register: result
     until: result.stdout|int == ansible_play_hosts.all|length
     retries: 60
     delay: 10
     when: rke2_cni != 'none'
   

