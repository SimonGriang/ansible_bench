---
- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that:
      - "ansible_service_mgr == 'systemd'"
    fail_msg: "This module only works with systemd"
  delegate_to: localhost
  run_once: true

- name: Get the latest release version of Promtail from GitHub
  ansible.builtin.uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    headers:
      Authorization: "token {{ lookup('env', 'GH_TOKEN') }}"
      Accept: "application/vnd.github.v3+json"
    return_content: true
  register: promtail_release
  delegate_to: localhost
  run_once: true

- name: Check if the local Promtail binary archive exists
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ go_arch }}.tar.gz"
  register: promtail_binary_local_stat
  delegate_to: localhost
  run_once: true

- name: Assert local Promtail binary archive exists
  ansible.builtin.assert:
    that:
      - "promtail_binary_local_stat.stat.exists"
    fail_msg: "When using 'promtail_binary_local_dir' please ensure that the binary exists"
  delegate_to: localhost
  run_once: true

- name: Get the checksum for the Promtail binary
  ansible.builtin.uri:
    url: "{{ promtail_release.json.tarball_url | regex_replace('.tar.gz$', '.txt') }}"
    return_content: true
  register: promtail_checksum_list
  when: "not promtail_binary_local_dir"
  run_once: true

- name: Set the checksum for the Promtail binary
  ansible.builtin.set_fact:
    promtail_checksum: "{{ promtail_checksum_list.content | regex_search('promtail-' + go_arch + '\\.tar\\.gz\\s+(.*)') | first }}"
  when: "not promtail_binary_local_dir"
  run_once: true


