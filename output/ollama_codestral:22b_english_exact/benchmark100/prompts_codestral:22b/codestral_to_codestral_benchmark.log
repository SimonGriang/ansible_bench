    extra_args: "{{ item.extra_args | default(omit) }}"
    executable: >-
      {{
        (item.virtualenv | default(false))
        | ternary(pip_virtualenv_executable, pip_executable)
      }}
  loop: "{{ pip_install_packages }}"


