e: \'adoptopenjdk\'\n           description: \'AdoptOpenJDK\'\n           baseurl: \'https://packages.adoptium.net/artifactory/rpm/{{ ansible_os_family | lower }}/$releasever/$basearch\'\n           gpgcheck: yes\n           gpgkey: \'https://packages.adoptium.net/artifactory/api/gpg/key/public\'\n           enabled: yes\n     when: ansible_os_family == \'RedHat\'\n\n   - name: Install required libraries for Java\n     package:\n       name: "{{ java_package_dependencies }}"\n       state: present\n\n   - name: Install Java on Debian\n     apt:\n       name: "{{ java_package }}"\n       state: present\n       update_cache: yes\n     when: ansible_os_family == \'Debian\'\n\n   - name: Install Java on RedHat\n     yum:\n       name: "{{ java_package }}"\n       state: present\n     when: ansible_os_family == \'RedHat\'\n\n   - name: Export environment variables for Java\n     template:\n       src: \'jdk.sh.j2\'\n       dest: \'/etc/profile.d/jdk.sh\'\n\n   - name: Source environment variables for Java\n     shell: \'source /etc/profile.d\'\n\n   - name: Correct Java version selected for Java < 11\n     alternatives:\n       name: java\n       path: "{{ java_home }}/bin/java"\n     when: java_version | int < 11\n\n   - name: Correct Java version selected for Java >= 11\n     alternatives:\n       name: javac\n       path: "{{ java_home }}/bin/javac"\n     when: java_version | int >= 11' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-16T06:43:41.600200459Z', 'done': True, 'done_reason': 'stop', 'total_duration': 21451766338, 'load_duration': 14905725, 'prompt_eval_count': 1041, 'prompt_eval_duration': 870764381, 'eval_count': 1040, 'eval_duration': 20564552391, 'model_name': 'codestral:22b'} id='run--f7873d82-3cbe-471b-988f-4fba8708d558-0' usage_metadata={'input_tokens': 1041, 'output_tokens': 1040, 'total_tokens': 2081}
