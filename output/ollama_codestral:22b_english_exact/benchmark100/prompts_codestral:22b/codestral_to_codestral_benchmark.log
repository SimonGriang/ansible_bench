---
   - hosts: debian12
     tasks:
       - name: debian12 | Get python3 version installed
         shell: python3 --version 2>&1 | cut -d' ' -f2 | cut -d'.' -f1,2
         register: python_version
         changed_when: false

       - name: debian12 | Remove EXTERNALLY-MANAGED
         file:
           path: "/usr/lib/python3.11/EXTERNALLY-MANAGED"
           state: absent
