---
- name: Cordon and Drain the node
  when: rke2_drain_node_during_upgrade | bool
  command: >-
    kubectl drain {{ ansible_host }}
    --ignore-daemonsets
    --delete-local-data
    --force
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

- name: Restart RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted

- name: Wait for all nodes to be ready again
  command: >-
    kubectl get nodes
    --selector=node-role.kubernetes.io/control-plane!=true
    --field-selector=spec.unschedulable=false
    --no-headers
    -o custom-columns=:metadata.name
  register: ready_nodes
  until: ready_nodes.stdout_lines | length == groups[rke2_servers_group_name] | length
  retries: 60
  delay: 10
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

- name: Uncordon the node
  when: rke2_drain_node_during_upgrade | bool
  command: >-
    kubectl uncordon {{ ansible_host }}
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

- name: Wait for all pods to be ready again
  when: rke2_wait_for_all_pods_to_be_ready | bool
  command: >-
    kubectl get pods
    --all-namespaces
    --field-selector=status.phase!=Running,status.phase!=Succeeded
    --no-headers
    -o custom-columns=:metadata.namespace
  register: unready_pods
  until: unready_pods.stdout_lines | length == 0
  retries: 60
  delay: 10
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

- name: Wait for all pods to pass readiness checks
  when: rke2_wait_for_all_pods_to_be_healthy | bool
  command: >-
    kubectl wait {{ rke2_wait_for_all_pods_to_be_healthy_args }}
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"


