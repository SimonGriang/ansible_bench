---
   - name: Import assert.yml
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Configure apk
     block:
       - name: Update apk cache
         apk:
           update_cache: yes
         when: ansible_pkg_mgr == "apk"

       - name: Upgrade all software
         apk:
           upgrade: yes
         when: ansible_pkg_mgr == "apk"
         notify: Reboot

   - name: Configure apt
     block:
       - name: Prevent upgrade for selected packages
         dpkg_selections:
           name: "{{ item }}"
           selection: hold
         loop: "{{ update_excluded_packages }}"
         when: ansible_pkg_mgr == "apt"

       - name: Update apt cache
         apt:
           update_cache: yes
           cache_valid_time: "{{ update_cache_valid_time }}"
         when: ansible_pkg_mgr == "apt"

       - name: Upgrade all software
         apt:
           upgrade: "{{ update_upgrade_command }}"
         when: ansible_pkg_mgr == "apt"
         notify: Reboot

       - name: Autoremove
         apt:
           autoremove: yes
         when: ansible_pkg_mgr == "apt" and update_autoremove

   - name: Update all software (dnf)
     block:
       - name: Upgrade all software
         dnf:
           name: "*"
           exclude: "{{ update_excluded_packages }}"
           state: latest
         when: ansible_pkg_mgr in ["dnf", "dnf5"]
         notify: Reboot

   - name: Update all software (pacman)
     block:
       - name: Update pacman cache
         pacman:
           update_cache: yes
         when: ansible_pkg_mgr == "pacman"

       - name: Upgrade all software
         pacman:
           upgrade: yes
         when: ansible_pkg_mgr == "pacman"
         notify: Reboot

   - name: Configure yum
     block:
       - name: Install yum-utils
         yum:
           name: yum-utils
           state: present
         when: ansible_pkg_mgr == "yum" and ansible_distribution_major_version != "6"

       - name: Upgrade all software
         yum:
           name: "*"
           exclude: "{{ update_excluded_packages }}"
           state: latest
         when: ansible_pkg_mgr == "yum"
         notify: Reboot

   - name: Update all software (zypper)
     block:
       - name: Upgrade all software
         zypper:
           name: "*"
           state: latest
         when: ansible_pkg_mgr == "zypper"
         notify: Reboot

