     blockinfile:
       path: ~/.pip/pip.conf
       create: yes
       block: |
         [global]
         proxy = {{ python_pip_proxy }}
     when: python_pip_proxy is defined

   - name: Trust hosts
     blockinfile:
       path: ~/.pip/pip.conf
       create: yes
       marker: "# {mark} ANSIBLE MANAGED BLOCK - Trusted Hosts"
