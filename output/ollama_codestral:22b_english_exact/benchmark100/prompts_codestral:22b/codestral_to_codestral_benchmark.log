---
   - name: Ensure apt key is not present
     ansible.builtin.file:
       path: /etc/apt/trusted.gpg.d/docker.gpg
       state: absent

   - name: Ensure old apt source list is not present
     ansible.builtin.file:
       path: /etc/apt/sources.list.d/docker.list
       state: absent

   - name: Ensure old versions of Docker are not installed
     ansible.builtin.package:
       name: docker-ce
       state: absent

   - name: Ensure legacy repo file is not present
     ansible.builtin.file:
       path: /etc/apt/sources.list.d/docker.list
       state: absent

   - name: Ensure dependencies are installed
     ansible.builtin.package:
       name:
         - apt-transport-https
         - ca-certificates
         - python3-debian
       state: present

   - name: Add or remove Docker repository
     ansible.builtin.apt_repository:
       repo: "deb [arch={{ docker_architecture }}] https://download.docker.com/linux/{{ ansible_distribution | lower }} {{ ansible_distribution_release }} stable"
       state: "{{ 'present' if docker_add_repo else 'absent' }}"
       filename: docker
       mode: '0644'
       update_cache: no
     register: docker_repo

