---
   - name: Disable swap
     shell: swapoff -a
     when: vault_hardening_disable_swap | bool

   - name: Disable swap in fstab
     mount:
       name: swap
       fstype: swap
       state: absent
     when: vault_hardening_disable_swap | bool

   - name: Disable core dumps
     pam_limits:
       domain: "{{ limit.domain }}"
       limit_type: hard
       limit_item: "{{ limit.limit_item }}"
       value: 0
     loop:
       - {domain: '*', limit_item: 'core'}
       - {domain: '@student', limit_item: 'core'}
     loop_control:
       loop_var: limit
     when: vault_hardening_disable_core_dumps | bool

   - name: Disable Shell Command History
     copy:
       src: disable_vault_history.sh
       dest: /etc/profile.d/
       mode: '0644'
     when: vault_hardening_disable_shell_command_history | bool

   - name: Check if SELinux is enabled
     shell: getenforce
     register: selinux_status
     changed_when: false
     failed_when: false
     when: vault_hardening_configure_selinux_apparmor | bool

   - name: Configure SELinux
     block:
       - name: Install selinux-policy package
         package:
           name: selinux-policy
           state: present
       - name: Set SELinux policy to targeted and enforcing
         selinux:
           policy: targeted
           state: enforcing
     when:
       - vault_hardening_configure_selinux_apparmor | bool
       - selinux_status.stdout == 'Enforcing'

   - name: Check if AppArmor is enabled
     stat:
       path: /sys/module/apparmor
     register: apparmor_status
     when: vault_hardening_configure_selinux_apparmor | bool

   - name: Enable AppArmor profile for Vault binary
     copy:
       src: vault.apparmor
       dest: /etc/apparmor.d/
       mode: '0644'
     when:
       - vault_hardening_configure_selinux_apparmor | bool
       - apparmor_status.stat.exists

   - name: Reload AppArmor profiles
     shell: apparmor_parser -r /etc/apparmor.d/vault.apparmor
     when:
       - vault_hardening_configure_selinux_apparmor | bool
       - apparmor_status.stat.exists


