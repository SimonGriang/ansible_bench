ount': 529, 'eval_duration': 10153425979, 'model_name': 'codestral:22b'} id='run--8af1c37a-1f3e-4755-8c93-6b9b08591c42-0' usage_metadata={'input_tokens': 769, 'output_tokens': 529, 'total_tokens': 1298}
