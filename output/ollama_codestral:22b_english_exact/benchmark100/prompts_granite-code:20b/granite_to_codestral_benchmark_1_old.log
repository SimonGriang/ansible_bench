       cmd: "rndc-confgen -a -c {{ rndc_key_file }}"

   - name: Set permissions on rndc key file
     file:
       path: "{{ rndc_key_file }}"
       mode: "0644"

   - name: Get the hints/root file
     get_url:
       url: "{{ hints_root_url }}"
       dest: "{{ named_root_file }}"

   - name: Create zone file
     template:
       src: zone.j2
       dest: "{{ zone_config_dir }}/{{ item }}"
     with_items: "{{ dns_zones }}"

   - name: Add zones to configuration
     blockinfile:
       path: "{{ named_conf_file }}"
       block: |
         {% for zone in dns_zones %}
         include "{{ zone_config_dir }}/{{ zone }}";
         {% endfor %}

   - name: Place systemd override
     template:
       src: override.conf.j2
       dest: "{{ systemd_override_dir }}/named.conf"

   - name: Start and enable dns
     service:
       name: dns
       state: started
       enabled: true


