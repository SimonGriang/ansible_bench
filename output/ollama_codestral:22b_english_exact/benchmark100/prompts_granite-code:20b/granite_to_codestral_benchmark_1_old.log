---
   - name: Create group vault
     group:
       name: vault
       state: present

   - name: Create user vault
     user:
       name: vault
       system: yes
       group: vault
       shell: /usr/sbin/nologin
       createhome: no
       home: /opt/vault

   - name: Create directory /opt/vault
     file:
       path: /opt/vault
       state: directory
       owner: vault
       group: vault
       mode: '0755'

   - name: Download Vault binary
     unarchive:
       src: https://releases.hashicorp.com/vault/1.7.3/vault_1.7.3_linux_amd64.zip
       dest: /opt/vault
       remote_src: yes
       owner: vault
       group: vault

   - name: Create directory /etc/vault.d
     file:
       path: /etc/vault.d
       state: directory
       owner: vault
       group: vault
       mode: '0755'

   - name: Copy Vault binary
     copy:
       src: /opt/vault/vault
       dest: /usr/bin/vault
       mode: '0755'
       remote_src: yes

   - name: Set cap_ipc_lock=ep on /usr/bin/vault
     capabilities:
       path: /usr/bin/vault
       capability: cap_ipc_lock=ep
       state: present

   - name: Create file /etc/vault.d/vault.env
     file:
       path: /etc/vault.d/vault.env
       state: touch
       owner: vault
       group: vault
       mode: '0644'

   - name: Create directory /usr/lib/systemd/system
     file:
       path: /usr/lib/systemd/system
       state: directory
       owner: root
       group: root
       mode: '0755'

   - name: Copy Vault service file
     copy:
       src: vault.service
       dest: /usr/lib/systemd/system/vault.service
       owner: root
       group: root
       mode: '0644'

   - name: Copy vault configuration
     copy:
       src: vault.hcl
       dest: /etc/vault.d/vault.hcl
       owner: vault
       group: vault
       mode: '0644'

   - name: Flush handlers
     meta: flush_handlers

