 - name: Install mysql
     become: true
     yum:
       name: mysql
       state: present

   - name: Configure mysql server
     become: true
     copy:
       dest: /etc/mysql/mysql.conf.d/mysqld.cnf
       content: |
         # MySQL server configuration
         # Add your server configurations here

   - name: Configure mysql client
     become: true
     copy:
       dest: /etc/mysql/mysql.conf.d/mysql-client.cnf
       content: |
         # MySQL client configuration
         # Add your client configurations here

   - name: Initialize mysql
     become: true
     command: mysql_install_db

   - name: Start and enable mysql
     become: true
     service:
       name: mysql
       state: started
       enabled: true

   - name: Flush handlers
     meta: flush_handlers

   - name: Place my.cnf
     become: true
     copy:
       src: my.cnf
       dest: /etc/mysql/my.cnf

   - name: Create databases
     become: true
     mysql_db:
       name: "{{ item }}"
       state: present
     with_items:
       - db1
       - db2

   - name: List databases
     become: true
     shell: mysql -e "SHOW DATABASES;"
     register: mysql_databases

   - debug:
       var: mysql_databases.stdout_lines

   - name: Import database
     become: true
     mysql_db:
       name: db1
       state: import
       target: /path/to/database.sql

   - name: Create users
     become: true
     mysql_user:
       name: user1
       password: password1
       priv: "db1.*:ALL"
       state: present

   - name: Flush handlers again
     meta: flush_handlers


