---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  template:
    src: mysql.cnf.j2
    dest: "{{ mysql_configuration_destination }}"
    owner: "{{ mysql_name }}"
    group: "{{ mysql_name }}"
    mode: '0644'
  vars:
    mysql_configuration_options: "{{ mysql_server_configuration_options }}"
    mysql_socket: "{{ mysql_server_socket }}"

- name: Configure mysql client
  template:
    src: my.cnf.j2
    dest: "{{ mysql_configuration_destination }}"
    owner: "{{ mysql_name }}"
    group: "{{ mysql_name }}"
    mode: '0644'
  vars:
    mysql_socket: "{{ mysql_client_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    collation: "{{ item.collation | default(omit) }}"
    encoding: "{{ item.encoding | default(omit) }}"
  with_items: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


