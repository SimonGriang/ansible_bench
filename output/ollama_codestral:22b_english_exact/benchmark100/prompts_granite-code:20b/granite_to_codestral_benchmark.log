---
   - name: Install git
     package:
       name: "{{ git_packages }}"
       state: present

   - name: See if the specified user exists
     getent:
       database: passwd
       key: "{{ git_username }}"

   - name: Create directory for git configuration
     file:
       path: "~{{ git_username }}/.gitconfig"
       state: directory
       owner: "{{ git_username }}"
       group: "{{ git_groupname }}"
       mode: 0700

   - name: Place git configuration
     template:
       src: gitconfig.j2
       dest: "~{{ git_username }}/.gitconfig"
       owner: "{{ git_username }}"
       group: "{{ git_groupname }}"
       mode: 0600

   - name: Create repository_destination
     file:
       path: "{{ repository_destination }}"
       state: directory
       owner: "{{ git_username }}"
       group: "{{ git_groupname }}"
       mode: 0755

   - name: Clone all roles
     git:
       repo: "{{ item.repo }}"
       dest: "{{ git_repository_destination }}/{{ item.name }}"
       update: yes
       accept_hostkey: yes
     become_user: "{{ git_username }}"
     with_items: "{{ git_repositories }}"

