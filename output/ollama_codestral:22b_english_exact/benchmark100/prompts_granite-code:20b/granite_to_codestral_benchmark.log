content=' ```yaml\n   ---\n   - name: Create RKE2 config dir\n     ansible.builtin.file:\n       path: /etc/rancher/rke2\n       state: directory\n\n   - name: Set server taints\n     ansible.builtin.set_fact:\n       rke2_server_taints: "{{ rke2_server_node_taints }}"\n\n   - name: Copy rke2 config\n     ansible.builtin.copy:\n       src: "{{ rke2_config_source }}"\n       dest: /etc/rancher/rke2/config.yaml\n       mode: \'0600\'\n\n   - name: Copy kubelet config\n     ansible.builtin.copy:\n       src: "{{ rke2_kubelet_config_source }}"\n       dest: /etc/rancher/rke2/kubelet-config.yaml\n       mode: \'0600\'\n     when: rke2_kubelet_config | length > 0\n\n   - name: Copy Containerd Registry Configuration file\n     ansible.builtin.copy:\n       src: "{{ rke2_registry_config_source }}"\n       dest: /etc/rancher/rke2/registries.yaml\n       mode: \'0600\'\n     when: rke2_custom_registry_mirrors or rke2_custom_registry_configs\n\n   - name: Register if we need to do a etcd restore from file\n     ansible.builtin.set_fact:\n       do_etcd_restore: >-\n         {{ rke2_etcd_snapshot_file is defined\n         and rke2_etcd_snapshot_file | length > 0\n         and ansible_facts.services["rke2-server.service"] is not defined }}\n\n   - name: Register if we need to do a etcd restore from s3\n     ansible.builtin.set_fact:\n       do_etcd_restore_from_s3: >-\n         {{ rke2_etcd_snapshot_s3_options.access_key is defined\n         and rke2_etcd_snapshot_s3_options.secret_key is defined\n         and rke2_etcd_snapshot_s3_options.bucket is defined\n         and rke2_etcd_snapshot_s3_options.snapshot_name is defined }}\n\n   - name: Restore etcd from file\n     block:\n       - name: Create RKE2 etcd snapshot directory\n         ansible.builtin.file:\n           path: /var/lib/rancher/rke2/server/db/snapshots\n           state: directory\n\n       - name: Copy etcd snapshot file\n         ansible.builtin.copy:\n           src: "{{ rke2_etcd_snapshot_file }}"\n           dest: /var/lib/rancher/rke2/server/db/snapshots\n\n       - name: Restore etcd from snapshot\n         ansible.builtin.command: >-\n           /var/lib/rancher/rke2/bin/kubectl\n           --kubeconfig=/etc/rancher/rke2/rke2.yaml\n           etcdbackup restore /var/lib/rancher/rke2/server/db/snapshots\n     when: do_etcd_restore is defined\n\n   - name: Restore etcd from s3\n     ansible.builtin.command: >-\n       /var/lib/rancher/rke2/bin/rke2 server\n       --config=/etc/rancher/rke2/config.yaml\n       --etcd-s3\n       --etcd-s3-endpoint=https://{{ rke2_etcd_snapshot_s3_options.bucket }}.s3.amazonaws.com\n       --etcd-s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }}\n       --etcd-s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }}\n       --etcd-s3-prefix={{ rke2_etcd_snapshot_s3_options.snapshot_name }}\n     when: do_etcd_restore_from_s3 is defined\n\n   - name: Start RKE2 service on the first server\n     ansible.builtin.systemd:\n       name: rke2-server.service\n       state: started\n       enabled: yes\n\n   - name: Mask RKE2 agent service on the first server\n     ansible.builtin.systemd:\n       name: rke2-agent.service\n       masked: yes\n\n   - name: Wait for the first server be ready - no CNI\n     ansible.builtin.command: >-\n       /var/lib/rancher/rke2/bin/kubectl\n       --kubeconfig=/etc/rancher/rke2/rke2.yaml\n       get nodes {{ inventory_hostname }} -o json\n     register: server_info\n     until: >-\n       (server_info.stdout | from_json).status.conditions\n       | selectattr(\'type\', \'equalto\', \'Ready\')\n       | map(attribute=\'status\')\n       | list\n       | count(\'True\') == 1\n       and (server_info.stdout | from_json).status.conditions\n       | selectattr(\'type\', \'equalto\', \'MemoryPressure\')\n       | map(attribute=\'status\')\n       | list\n       | count(\'False\') == 1\n       and (server_info.stdout | from_json).status.conditions\n       | selectattr(\'type\', \'equalto\', \'DiskPressure\')\n       | map(attribute=\'status\')\n       | list\n       | count(\'False\') == 1\n       and (server_info.stdout | from_json).status.conditions\n       | selectattr(\'type\', \'equalto\', \'PIDPressure\')\n       | map(attribute=\'status\')\n       | list\n       | count(\'False\') == 1\n     retries: 60\n     delay: 10\n     when: rke2_cni | length == 0\n\n   - name: Wait for the first server be ready - with CNI\n     ansible.builtin.command: >-\n       /var/lib/rancher/rke2/bin/kubectl\n       --kubeconfig=/etc/rancher/rke2/rke2.yaml\n       get nodes {{ inventory_hostname }} -o json\n     register: server_info\n     until: >-\n       (server_info.stdout | from_json).status.conditions\n       | selectattr(\'type\', \'equalto\', \'Ready\')\n       | map(attribute=\'status\')\n       | list\n       | count(\'True\') == 1\n     retries: 60\n     delay: 10\n     when: rke2_cni | length > 0\n\n   - name: Restore etcd\n     block:\n       - name: Remove old <node>.node-password.rke2 secrets\n         ansible.builtin.command: >-\n           /var/lib/rancher/rke2/bin/kubectl\n           --kubeconfig=/etc/rancher/rke2/rke2.yaml\n           delete secret {{ item }}.node-password.rke2\n         with_items: "{{ ansible_play_hosts_all }}"\n\n       - name: Remove old nodes\n         ansible.builtin.command: >-\n           /var/lib/rancher/rke2/bin/kubectl\n           --kubeconfig=/etc/rancher/rke2/rke2.yaml\n           delete node {{ item }}\n         with_items: "{{ ansible_play_hosts_all }}"\n\n       - name: Remove old nodes and secrets\n         ansible.builtin.command: >-\n           /var/lib/rancher/rke2/bin/rke2 server\n           --config=/etc/rancher/rke2/config.yaml\n           --node-name={{ inventory_hostname }}\n           --node-ip={{ ansible_default_ipv4.address }}\n           --node-external-ip={{ ansible_default_ipv4.address }}\n           --node-taint={{ rke2_server_taints }}\n           --debug\n           --etcd-exclude-unsafe-sysctls=false\n        