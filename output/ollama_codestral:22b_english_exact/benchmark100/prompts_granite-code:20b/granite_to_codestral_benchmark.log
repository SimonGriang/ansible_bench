 - name: lookup bootstrap facts (raw)
     command: cat /etc/os-release
     register: bootstrap_facts

   - name: set bootstrap facts (I)  # noqa jinja
     set_fact:
       bootstrap_distribution: "{{ item.value.bootstrap_distribution }}"
       bootstrap_distribution_major_version: "{{ item.value.bootstrap_distribution_major_version }}"
     loop: "{{ bootstrap__os_family_map | dict2items }}"
     when:
       - item.key == ansible_os_family
       - item.value.bootstrap_distribution in bootstrap_facts.stdout

   - name: set bootstrap facts (II)
     set_fact:
       bootstrap_os_family: "{{ item.key }}"
     loop: "{{ bootstrap__os_family_map | dict2items }}"
     when:
       - item.value.bootstrap_distribution in bootstrap_facts.stdout

