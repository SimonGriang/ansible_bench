 - name: Create the RKE2 config dir
     file:
       path: "/etc/rancher/rke2"
       state: directory

   - name: Set server taints
     shell: |
       if [ "{{ rke2_mode }}" == "server" ]; then
         kubectl taint nodes --overwrite {{ ansible_nodename }} CriticalAddonsOnly=true:NoSchedule --kubeconfig /etc/rancher/rke2/rke2.yaml
       fi

   - name: Set agent taints
     shell: |
       if [ "{{ rke2_mode }}" == "agent" ]; then
         kubectl taint nodes --overwrite {{ ansible_nodename }} CriticalAddonsOnly=true:NoExecute --kubeconfig /etc/rancher/rke2/rke2.yaml
       fi

   - name: Copy RKE2 config
     copy:
       src: "{{ rke2_config_file }}"
       dest: "/etc/rancher/rke2/config.yaml"

   - name: Copy kubelet config
     copy:
       src: "{{ kubelet_config_file }}"
       dest: "/etc/rancher/rke2/kubelet-config.json"
     when: kubelet_config_file is defined

   - name: Copy Containerd Registry Configuration file
     copy:
       src: "{{ containerd_registry_config_file }}"
       dest: "/etc/rancher/rke2/registries.yaml"
     when: containerd_registry_config_file is defined

   - name: Start RKE2 service on the rest of the nodes
     systemd:
       name: rke2-server
       state: started
       enabled: yes
     when: rke2_mode == "server"

   - name: Mask other RKE2 service on the rest of the nodes
     systemd:
       name: "{{ item }}"
       state: stopped
       enabled: no
       masked: yes
     with_items:
       - rke2-agent

   - name: Wait for remaining nodes to be ready - no CNI
     shell: |
       if [ "{{ use_cni }}" != "true" ]; then
         kubectl wait --for=condition=Ready nodes --all --timeout=180s --kubeconfig /etc/rancher/rke2/rke2.yaml
       fi

   - name: Wait for remaining nodes to be ready - with CNI
     shell: |
       if [ "{{ use_cni }}" == "true" ]; then
         kubectl wait --for=condition=Ready nodes --all --timeout=300s --kubeconfig /etc/rancher/rke2/rke2.yaml
       fi

