---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install dns
  package:
    name: dns
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ directories_to_create }}"

- name: Create group
  group:
    name: "{{ group_name }}"
    state: present

- name: Create user
  user:
    name: "{{ user_name }}"
    group: "{{ group_name }}"
    state: present

- name: Generate rndc key
  command:
    cmd: rndc-confgen -a -r /dev/urandom -b 1024 -k /etc/bind/rndc.key
    creates: /etc/bind/rndc.key

- name: Set permissions on rndc key file
  file:
    path: /etc/bind/rndc.key
    mode: '0640'

- name: Get the hints/root file
  get_url:
    url: "{{ hints_root_url }}"
    dest: /var/named/named.root

- name: Create zone file
  template:
    src: zone.j2
    dest: "/var/named/{{ item.name }}"
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named.conf

- name: Place systemd override
  template:
    src: named.service.d.j2
    dest: /etc/systemd/system/named.service.d/override.conf

- name: Start and enable dns
  service:
    name: named
    state: started
    enabled: true


