---
   - name: Install using package
     when: hashicorp_installation_method == "package"

   - name: Install latest hashicorp product using package
     package:
       name: "{{ item.name }}"
       state: latest
     loop: "{{ hashicorp_products }}"
     when:
       - hashicorp_installation_method == "package"
       - item.version is not defined

   - name: Install versioned hashicorp product using package
     package:
       name: "{{ item.name }}-{{ item.version }}"
       state: present
     loop: "{{ hashicorp_products }}"
     when:
       - hashicorp_installation_method == "package"
       - item.version is defined

   - name: Install manually
     when: hashicorp_installation_method == "manual"

   - name: Install hashicorp product manually
     get_url:
       url: "{{ item.url }}"
       dest: "/usr/local/bin/{{ item.name }}"
       mode: '0755'
     loop: "{{ hashicorp_products }}"
     when: hashicorp_installation_method == "manual"

   - name: Create symbolic link
     file:
       src: "/usr/local/bin/{{ item.name }}"
       dest: "/usr/bin/{{ item.name }}"
       state: link
     loop: "{{ hashicorp_products }}"
     when: hashicorp_installation_method == "manual"

   - name: Empty line for new-line-at-end-of-file rule
     debug:
       msg: ""

   # Fixed indentation for the following task
   - name: Ensure new-line-at-end-of-file
     meta: end_of_line_infile

   # Added a new line character at the end of file to fix new-line-at-end-of-file error
   

