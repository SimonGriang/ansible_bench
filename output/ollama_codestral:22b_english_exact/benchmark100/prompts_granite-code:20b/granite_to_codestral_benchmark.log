---
- name: password | Get efi path
  stat:
    path: /sys/firmware/efi
  register: efi_path

- name: password | Remove unwanted grub.cfg on EFI systems
  file:
    path: "{{ efi_path.stat.path }}/EFI/ubuntu/grub.cfg"
    state: absent
  when: efi_path.stat.exists

- name: password | Install user template
  template:
    src: user.j2
    dest: /etc/user.conf

- name: password | EFI | add password
  lineinfile:
    path: /etc/grub.d/efi.cfg
    regexp: '^GRUB_CMDLINE_LINUX_DEFAULT="(.*)"$'
    line: 'GRUB_CMDLINE_LINUX_DEFAULT="\1 password=<PASSWORD>"'
    backrefs: yes

- name: password | MBR | add password
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX="(.*)"$'
    line: 'GRUB_CMDLINE_LINUX="\1 password=<PASSWORD>"'
    backrefs: yes

- name: password | Add --unrestricted
  replace:
    path: "{{ item }}"
    regexp: '^(.*)$'
    replace: '\1 --unrestricted'
  loop:
    - /etc/file1
    - /etc/file2


