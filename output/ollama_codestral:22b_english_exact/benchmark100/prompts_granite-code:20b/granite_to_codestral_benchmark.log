---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install dns
     package:
       name: dns
       state: present

   - name: Create directories
     file:
       path: "{{ item.path }}"
       state: directory
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
       mode: "{{ item.mode }}"
     loop: "{{ directories }}"

   - name: Create group
     group:
       name: "{{ group_name }}"
       state: present

   - name: Create user
     user:
       name: "{{ user_name }}"
       group: "{{ group_name }}"
       state: present

   - name: Generate rndc key
     shell: rndc-confgen -a -r /dev/urandom -k rndc-key -t -c /etc/rndc.key

   - name: Set permissions on rndc key file
     file:
       path: /etc/rndc.key
       mode: 0644

   - name: Get the hints/root file
     get_url:
       url: "{{ hints_url }}"
       dest: /var/named/named.root

   - name: Create zone file
     template:
       src: zone.j2
       dest: "/var/named/{{ item }}.zone"
     loop: "{{ dns_zones }}"

   - name: Add zones to configuration
     blockinfile:
       path: /etc/named.conf
       block: |
         {% for zone in dns_zones %}
         zone "{{ zone }}" {
             type master;
             file "/var/named/{{ zone }}.zone";
         };
         {% endfor %}

   - name: Place systemd override
     template:
       src: systemd_override.j2
       dest: /etc/systemd/system/named.service.d/override.conf

   - name: Start and enable dns
     systemd:
       name: named
       state: started
       enabled: yes

