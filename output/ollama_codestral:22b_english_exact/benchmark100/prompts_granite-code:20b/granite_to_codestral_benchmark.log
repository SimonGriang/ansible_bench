     loop: "{{ users }}"
     loop_control:
       loop_var: user
     vars:
       user_name: "{{ user.name }}"

   - name: Manage cron permission
     template:
       src: cron.allow.j2
       dest: /etc/cron.allow
       mode: "0644"
     when: users_cron_allow

   - name: Check existence of /etc/cron.allow
     file:
       path: /etc/cron.allow
       state: absent
     when: not users_cron_allow

