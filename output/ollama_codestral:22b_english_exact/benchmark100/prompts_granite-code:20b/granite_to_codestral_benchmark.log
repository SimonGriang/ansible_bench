     loop: "{{ bootstrap_os_release_result.stdout_lines }}"
     when: item.startswith('ID=')

   - name: set bootstrap facts (II)
     set_fact:
       bootstrap_os_family: "{{ item.value }}"
     loop:
       - { key: '^(debian|ubuntu)$', value: 'debian' }
       - { key: '^(redhat|centos|fedora)$', value: 'redhat' }
       - { key: '^(suse)$', value: 'suse' }
     when: bootstrap_distribution | regex_search(item.key)

   - name: Blank line at end of the file
     debug:
       msg: ""


