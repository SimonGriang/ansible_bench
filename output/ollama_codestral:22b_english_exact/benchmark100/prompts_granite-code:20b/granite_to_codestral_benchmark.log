---
- name: Install epel
  yum:
    name: epel-release
    state: present
  when: >
    (ansible_distribution == "Amazon" and ansible_distribution_major_version == "2")
    or (ansible_os_family == "RedHat" and ansible_distribution_major_version in ["7", "8", "9", "10"])
  notify: update_cache

- name: Install epel gpg key
  rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install epel-release
  package:
    name: "{{ epel_url }}"
    state: present
  notify: update_cache

- name: Install epel-next-release
  package:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next | bool
  notify: update_cache

- name: update_cache
  yum:
    update_cache: yes


