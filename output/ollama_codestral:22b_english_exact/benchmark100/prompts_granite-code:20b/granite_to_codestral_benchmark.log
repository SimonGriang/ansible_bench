   - name: Generate public ssh key for {{ user.name }}
     command: "{{ ssh_keygen_pubkey_command }}"

   - name: Convert ssh key to ppk for {{ user.name }}
     command: "{{ ssh_keygen_pubkey_command }}"

   - name: Get or set the home directory for {{ user.name }}
     command: "getent passwd {{ user.name }}"
     register: user_data
     changed_when: False

   - set_fact:
       base_home_directory: "{{ user_data.stdout.split(':')[4] }}"

   - name: Create .ssh directory for {{ user.name }}
     file:
       path: "{{ base_home_directory }}/.ssh"
       state: directory
       mode: '0700'

   - name: Deploy authorized keys for {{ user.name }}
     authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
       state: present
     with_items: "{{ authorized_keys }}"

   - name: Remove unauthorized keys for {{ user.name }}
     authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
       state: absent
     with_items: "{{ unauthorized_keys }}"

   - name: Copy generated private ssh key for {{ user.name }}
     copy:
       src: "{{ ssh_key_path }}"
       dest: "{{ destination }}"
       mode: '0600'

   - name: Check users password valid time for {{ user.name }}
     command: "chage -l {{ user.name }} | awk -F ': ' '/Maximum number of days between password change/ {print $2}'"
     register: password_validity
     changed_when: False

   - name: Set users password valid time for {{ user.name }}
     command: "chage -M {{ password_valid_days }} {{ user.name }}"
     when: password_validity.stdout != password_valid_days

   - name: Place private key file for {{ user.name }}
     copy:
       src: "{{ private_key_file }}"
       dest: "{{ base_home_directory }}/.ssh/id_rsa"
       mode: '0600'
   

