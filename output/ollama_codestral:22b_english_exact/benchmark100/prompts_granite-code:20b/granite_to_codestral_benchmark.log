---
   - name: Download RKE2 installation script
     get_url:
       url: "{{ rke2_install_bash_url }}"
       dest: "{{ rke2_install_script_dir }}/rke2.sh"
       mode: '0700'
       timeout: "{{ rke2_artifact_fetch_timeout }}"

   - name: Copy local RKE2 installation script
     copy:
       src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
       dest: "{{ rke2_install_script_dir }}/rke2.sh"
       mode: '0700'
       force: yes

   - name: Create RKE2 artifacts folder
     file:
       path: "{{ rke2_artifact_path }}"
       state: directory
       mode: '0700'

   - name: Download RKE2 checksum and artifacts
     block:
       - name: Download checksum file
         get_url:
           url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
           dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
           mode: '0640'
           timeout: "{{ rke2_artifact_fetch_timeout }}"
       - name: Download RKE2 artifacts
         get_url:
           url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"
           dest: "{{ rke2_artifact_path }}/{{ item }}"
           checksum: "sha256:{{ lookup('file', '{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt') | regex_search('{{ item }}\\s+(\\S+)') | first }}"
           timeout: "{{ rke2_artifact_fetch_timeout }}"
       - name: Download RKE2 install script
         get_url:
           url: "{{ rke2_install_bash_url }}"
           dest: "{{ rke2_install_script_dir }}/rke2.sh"
           mode: '0700'
           timeout: "{{ rke2_artifact_fetch_timeout }}"
     when: airgap_mode is defined and airgap_mode and airgap_implementation == 'download'

   - name: Copy local RKE2 artifacts
     copy:
       src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
       dest: "{{ rke2_artifact_path }}/{{ item }}"
       mode: '0640'
       force: yes
     when: airgap_mode is defined and airgap_mode and airgap_implementation == 'copy'

   - name: Airgap mode - additional images tarballs
     block:
       - name: Create additional images tarballs folder
         file:
           path: "{{ rke2_tarball_images_path }}"
           state: directory
           mode: '0700'
       - name: Copy additional tarball images
         copy:
           src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
           dest: "{{ rke2_tarball_images_path }}/{{ item }}"
           mode: '0644'
           force: yes
     when: airgap_mode is defined and airgap_mode and rke2_tarball_images is defined

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ rke2_artifact_path }}/{{ item }}"
       state: file
     register: artifacts
     when: airgap_mode is defined and airgap_mode and airgap_implementation == 'exists'
   - name: Modify artifacts permission
     file:
       path: "{{ item.path }}"
       mode: '0640'
     loop: "{{ artifacts.results }}"
     when: item.stat.writeable
   - name: Modify install script permission
     file:
       path: "{{ rke2_install_script_dir }}/rke2.sh"
       mode: '0700'
     when: artifacts.results[-1].stat.writeable and not artifacts.results[-1].stat.executable
   - name: Check if install script is executable
     stat:
       path: "{{ rke2_install_script_dir }}/rke2.sh"
     register: install_script
   - name: Fail if install script is not executable
     fail:
       msg: "Install script is not executable"
     when: not install_script.stat.executable

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: /usr/local
     register: fs_stats

   - name: Check if separate partition
     set_fact:
       separate_partition: "{{ fs_stats.stat.dev != ansible_mounts | selectattr('mount', 'equalto', '/') | list | first | json_query('dev') }}"

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "{{ separate_partition | ternary('/usr/local/bin', '/var/lib/rancher/rke2/bin') }}"

   - name: Check RKE2 version
     shell: "{{ rke2_bin_path }}/rke2 --version || true"
     changed_when: false
     register: rke2_version_check

   - name: Prevent accidental RKE2 downgrade
     assert:
       that:
         - "'{{ rke2_version }}' == rke2_version_check.stdout_lines[0] | regex_search('(?<=v)[0-9]\\.[0-9]\\.[0-9]+')"
       fail_msg: "RKE2 downgrade is not allowed"

   - name: Run RKE2 install script
     shell: "{{ rke2_install_script_dir }}/rke2.sh {{ airgap_mode | ternary('--private-registry :5000', '') }}"

   - name: Copy Custom Manifests
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/server/manifests/"
       owner: root
       group: root
       mode: '0644'

   - name: Copy Static Pods
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/agent/pod-manifests/"
       owner: root
       group: root
       mode: '0644'

   - name: Copy RKE2 environment file
     template:
       src: rke2_environment.j2
       dest: "/etc/default/rke2-{{ rke2_type }}"
       owner: root
       group: root
       mode: '0644'

