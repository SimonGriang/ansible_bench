---
   - name: Cordon and Drain the node
     shell: kubectl cordon {{ rke2_node_name }} && kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-local-data
     when: rke2_drain_node_during_upgrade

   - name: Restart RKE2 service
     systemd:
       name: rke2-server
       state: restarted

   - name: Wait for all nodes to be ready
     shell: kubectl wait --for=condition=Ready nodes --all --timeout=600s

   - name: Uncordon the node
     shell: kubectl uncordon {{ rke2_node_name }}
     when: rke2_drain_node_during_upgrade

   - name: Wait for all pods to be ready
     shell: kubectl wait --for=condition=Ready pods --all --timeout=600s
     when: rke2_wait_for_all_pods_to_be_ready

