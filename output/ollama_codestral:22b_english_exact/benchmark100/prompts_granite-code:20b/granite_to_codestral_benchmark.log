---
   - name: Install fail2ban
     ansible.builtin.package:
       name: fail2ban
       state: present

   - name: Copy filters in filter.d
     ansible.builtin.copy:
       src: "/path/to/filters/"
       dest: "/etc/fail2ban/filter.d/"
       owner: root
       group: root
       mode: '0640'

   - name: Configure fail2ban.local
     community.general.ini_file:
       path: /etc/fail2ban/fail2ban.local
       section: DEFAULT
       option: "{{ item.option }}"
       value: "{{ item.value }}"
       mode: '0640'
     loop: "{{ fail2ban_config_options }}"

   - name: Configure jail.local
     community.general.ini_file:
       path: /etc/fail2ban/jail.local
       section: "{{ item.section }}"
       option: "{{ item.option }}"
       value: "{{ item.value }}"
       mode: '0640'
     loop: "{{ jail_config_options }}"

   - name: Stat auth log file
     ansible.builtin.stat:
       path: /var/log/auth.log
     register: auth_log

   - name: Touch auth log file
     ansible.builtin.file:
       path: /var/log/auth.log
       state: touch
       owner: root
       group: root
       mode: '0640'
     when: not auth_log.stat.exists

   - name: Start and enable fail2ban
     ansible.builtin.service:
       name: fail2ban
       state: started
       enabled: true

