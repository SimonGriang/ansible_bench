---
   - name: Check if Helm binary exists
     stat:
       path: /usr/local/bin/helm
     register: helm_stat

   - name: Check Helm version
     command: helm version
     register: helm_version
     when: helm_stat.stat.exists

   - name: Download Helm
     unarchive:
       src: https://get.helm.sh/helm-v3.8.2-linux-amd64.tar.gz
       dest: /tmp
       remote_src: true
     when: >
       not helm_stat.stat.exists or
       'v3.8.2' not in helm_version.stdout


