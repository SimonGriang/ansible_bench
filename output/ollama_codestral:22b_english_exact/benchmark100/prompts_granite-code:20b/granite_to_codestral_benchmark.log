---
   - name: Create group vault
     group:
       name: vault
       state: present

   - name: Create user vault
     user:
       name: vault
       comment: "Vault System User"
       system: yes
       shell: /bin/false
       group: vault

   - name: Create directory /opt/vault
     file:
       path: /opt/vault
       state: directory

   - name: Download Vault binary
     unarchive:
       src: "https://releases.hashicorp.com/vault/1.7.0/vault_1.7.0_linux_amd64.zip"
       dest: /opt/vault
       remote_src: yes

   - name: Create directory /etc/vault.d
     file:
       path: /etc/vault.d
       state: directory

   - name: Copy Vault binary
     copy:
       src: /opt/vault/vault
       dest: /usr/bin/vault
       mode: '0755'
       remote_src: yes

   - name: Set cap_ipc_lock=ep on /usr/bin/vault
     capabilities:
       path: /usr/bin/vault
       capability: cap_ipc_lock=ep
       state: present

   - name: Create file /etc/vault.d/vault.env
     file:
       path: /etc/vault.d/vault.env
       state: touch

   - name: Create directory /usr/lib/systemd/system
     file:
       path: /usr/lib/systemd/system
       state: directory

   - name: Copy Vault service file
     copy:
       src: path_to_your_vault_service_file
       dest: /usr/lib/systemd/system/vault.service

   - name: Copy vault configuration
     copy:
       src: path_to_your_vault_configuration_file
       dest: /etc/vault.d/vault.hcl

   - name: Flush handlers
     meta: flush_handlers

