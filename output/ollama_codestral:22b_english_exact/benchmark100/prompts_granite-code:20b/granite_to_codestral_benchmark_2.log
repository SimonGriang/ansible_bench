       key: "{{ epel_gpg_key }}"
       state: present

   - name: Install epel-release
     package:
       name: "{{ epel_url }}"
       state: present
     notify: Update package cache

   - name: Install epel-next-release
     package:
       name: "{{ epel_next_url }}"
       state: present
     when: epel_next | bool
     notify: Update package cache

