 - name: Install fail2ban
     package:
       name: fail2ban
       state: present

   - name: Copy filters in filter.d
     copy:
       src: specified_path/
       dest: /etc/fail2ban/filter.d/
       owner: root
       group: root
       mode: 0640

   - name: Configure fail2ban.local
     ini_file:
       path: /etc/fail2ban/fail2ban.local
       section: null
       option: "{{ item.option }}"
       value: "{{ item.value }}"
     loop: "{{ fail2ban_options }}"

   - name: Configure jail.local
     ini_file:
       path: /etc/fail2ban/jail.local
       section: DEFAULT
       option: "{{ item.option }}"
       value: "{{ item.value }}"
     loop: "{{ jail_options }}"

   - name: Stat auth log file
     stat:
       path: /var/log/auth.log
     register: auth_log

   - name: Touch auth log file
     file:
       path: /var/log/auth.log
       state: touch
       owner: root
       group: root
       mode: 0644
     when: not auth_log.stat.exists

   - name: Start and enable fail2ban
     service:
       name: fail2ban
       state: started
       enabled: yes

