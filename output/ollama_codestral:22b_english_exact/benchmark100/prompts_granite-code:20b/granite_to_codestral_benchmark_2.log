---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install cron
     package:
       name: cron
       state: present

   - name: Configure shell
     lineinfile:
       path: /etc/cron.d/mycron
       regexp: '^SHELL='
       line: 'SHELL=/bin/bash'
       state: present

   - name: Configure path
     lineinfile:
       path: /etc/cron.d/mycron
       regexp: '^PATH='
       line: 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
       state: present

   - name: Configure mailto
     lineinfile:
       path: /etc/cron.d/mycron
       regexp: '^MAILTO='
       line: 'MAILTO=root'
       state: present

   - name: Start and enable cron
     service:
       name: cron
       state: started
       enabled: true

   - name: Schedule requested cron jobs
     cron:
       name: "{{ item.name }}"
       minute: "{{ item.minute }}"
       hour: "{{ item.hour }}"
       day: "{{ item.day | default('*') }}"
       month: "{{ item.month | default('*') }}"
       weekday: "{{ item.weekday | default('*') }}"
       job: "{{ item.job }}"
       state: present
     loop: "{{ cron_jobs }}"
     when: cron_jobs is defined



