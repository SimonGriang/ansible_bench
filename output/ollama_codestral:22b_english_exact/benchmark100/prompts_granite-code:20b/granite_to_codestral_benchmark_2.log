           src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
           dest: "{{ rke2_tarball_images_path }}/{{ item }}"
           mode: 0644
           force: true

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     block:
       - name: Check artifacts
         stat:
           path: "{{ rke2_artifact_path }}/{{ item }}"
         register: artifacts
         loop:
           - rke2
           - "rke2-images.linux-{{ rke2_architecture }}.tar.gz"
           - "sha256sum-{{ rke2_architecture }}.txt"
       - name: Make artifacts read-only
         file:
           path: "{{ item.stat.path }}"
           mode: 0640
         when: item.stat.writeable
         loop: "{{ artifacts.results }}"
       - name: Make install script executable
         file:
           path: "{{ rke2_install_script_dir }}/rke2.sh"
           mode: 0700
         when: >
           artifacts.results[2].stat.writeable and
           not artifacts.results[2].stat.executable
       - name: Fail if install script is not executable
         fail:
           msg: "Install script is not executable"
         when: not artifacts.results[2].stat.executable

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: /usr/local
     register: fs_stats

   - name: Check if separate partition
     set_fact:
       separate_partition: >-
         {{ fs_stats.stat.isblk and
            fs_stats.stat.dev != ansible_mounts |
            selectattr('mount', 'equalto', '/') |
            map(attribute='dev') | first }}

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "{{ '/usr/local/bin' if separate_partition
                          else '/var/lib/rancher/rke2/bin' }}"

   - name: Check RKE2 version
     shell: "{{ rke2_bin_path }}/rke2 --version"
     register: rke2_version_check
     ignore_errors: true

   - name: Prevent accidental RKE2 downgrade
     assert:
       that:
         - >
           rke2_version_check.failed or
           (rke2_version in rke2_version_check.stdout)
       fail_msg: "RKE2 downgrade detected"

   - name: Run RKE2 install script
     shell: "bash {{ rke2_install_script_dir }}/rke2.sh"
     environment:
       INSTALL_RKE2_TYPE: "{{ rke2_type }}"
       INSTALL_RKE2_EXEC: "{{ 'server' if rke2_type == 'server' else 'agent' }}"
       INSTALL_RKE2_CHANNEL_URL: "{{ rke2_artifact_url }}"
       INSTALL_RKE2_VERSION: "{{ rke2_version }}"

   - name: Copy Custom Manifests
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/server/manifests/"
       owner: root
       group: root
       mode: 0644
     with_fileglob: "{{ rke2_custom_manifests_path }}/*.yaml"

   - name: Copy Static Pods
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/agent/pod-manifests/"
       owner: root
       group: root
       mode: 0644
     with_fileglob: "{{ rke2_static_pod_manifests_path }}/*.yaml"

   - name: Copy RKE2 environment file
     template:
       src: rke2_environment.j2
       dest: "/etc/default/rke2-{{ rke2_type }}"
       owner: root
       group: root
       mode: 0644


