---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  template:
    src: "{{ mysql_configuration_destination }}"
    dest: "/etc/mysql/mysql.conf.d/{{ mysql_name }}.cnf"
    owner: root
    group: root
    mode: '0644'
  notify: Restart mysql

- name: Configure mysql client
  template:
    src: "{{ mysql_configuration_destination }}"
    dest: "/root/.my.cnf"
    owner: root
    group: root
    mode: '0600'

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/mysql

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: '0600'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


