 - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install postfix
     apt:
       name: postfix
       state: present

   - name: Install postfix-mysql
     apt:
       name: postfix-mysql
       state: present

   - name: Configure postfix (transport_maps)
     lineinfile:
       path: /etc/postfix/transport
       line: 'example.com mysql:/etc/postfix/mysql_virtual_alias_maps.cf'
       create: yes

   - name: Configure postfix (header_checks)
     lineinfile:
       path: /etc/postfix/header_checks
       line: '/^Received:/ IGNORE'
       create: yes

   - name: Setting values for main.cf (1/2)
     lineinfile:
       path: /etc/postfix/main.cf
       line: 'setting_1 = value_1'

   - name: Setting values for main.cf (2/2)
     lineinfile:
       path: /etc/postfix/main.cf
       line: 'setting_2 = value_2'

   - name: Configure postfix (main.cf)
     copy:
       src: main.cf
       dest: /etc/postfix/main.cf

   - name: Configure postfix (master.cf)
     copy:
       src: master.cf
       dest: /etc/postfix/master.cf

   - name: Creates cert/key directory
     file:
       path: /etc/postfix/cert
       state: directory

   - name: Deploy Postfix TLS server certificate
     copy:
       src: server.crt
       dest: /etc/postfix/cert/server.crt

   - name: Deploy Postfix TLS server key
     copy:
       src: server.key
       dest: /etc/postfix/cert/server.key

   - name: Flush handlers
     meta: flush_handlers

   - name: Configure aliases
     copy:
       src: aliases
       dest: /etc/aliases

   - name: Configure sender_access
     copy:
       src: sender_access
       dest: /etc/postfix/sender_access

   - name: Configure recipient_access
     copy:
       src: recipient_access
       dest: /etc/postfix/recipient_access

   - name: Place sasl_password_map
     copy:
       src: sasl_password_map
       dest: /etc/postfix/sasl_password_map

   - name: Flush handlers again
     meta: flush_handlers

   - name: Start and enable postfix
     service:
       name: postfix
       state: started
       enabled: yes

