 - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
       state: present

   - name: Configure mysql server
     template:
       src: "{{ mysql_configuration_destination }}/{{ mysql_name }}.cnf.j2"
       dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}.cnf"
       owner: root
       group: root
       mode: 0644
     vars:
       mysql_options: "{{ mysql_configuration_options }}"
       mysql_socket: "{{ mysql_socket }}"

   - name: Configure mysql client
     template:
       src: my.cnf.j2
       dest: "/root/.my.cnf"
     vars:
       mysql_name: "{{ mysql_name }}"
       mysql_socket: "{{ mysql_socket }}"

   - name: Initialize mysql
     command: "{{ mysql_initialize_command }}"

   - name: Start and enable mysql
     service:
       name: mysql
       state: started
       enabled: yes

   - name: Flush handlers
     meta: flush_handlers

   - name: Place my.cnf
     template:
       src: my.cnf.j2
       dest: "/root/.my.cnf"

   - name: Create databases
     mysql_db:
       name: "{{ item }}"
       state: present
     loop: "{{ mysql_databases }}"

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       host: "{{ item.host | default('localhost') }}"
       priv: "{{ item.priv }}"
       state: present
     loop: "{{ mysql_users }}"

   - name: Flush handlers again
     meta: flush_handlers

