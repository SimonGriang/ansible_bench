---
- name: Check if certificates exists
  stat:
    path: "<path_to_certificate>"
  register: cert_stat

- name: Fail if some cert doesn't exist
  fail:
    msg: "Certificate does not exist at {{ '<path_to_certificate>' }}"
  when: not cert_stat.stat.exists

- name: Setting keystore variables in java < 11
  set_fact:
    java_keystore_path: "<java_keystore_path>"
    java_keystore_password: "<java_keystore_password>"
  when: ansible_java.version is version_compare('11', '<')

- name: Setting keystore variables in java >= 11
  set_fact:
    java_keystore_path: "<java_keystore_path>"
    java_keystore_password: "<java_keystore_password>"
  when: ansible_java.version is version_compare('11', '>=')

- name: Import SSL certificates
  java_cert:
    cert_path: "<path_to_certificate>"
    keystore_path: "{{ java_keystore_path }}"
    keystore_pass: "{{ java_keystore_password }}"
    keystore_create: yes
    state: present


