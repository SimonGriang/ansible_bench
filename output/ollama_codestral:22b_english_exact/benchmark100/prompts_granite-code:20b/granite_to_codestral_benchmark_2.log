---
   - name: Install requirements
     package:
       name: bash
       state: present

   - name: Install openjdk java (package)
     package:
       name: openjdk-java
       state: present

   - name: Install RPM
     package:
       name: /path/to/rpm/package.rpm
       state: present

   - name: Install DEB
     package:
       name: /path/to/deb/package.deb
       state: present

   - name: Install oracle java (rpm) (repository)
     package:
       name: oracle-java
       state: present

   - name: Configure oracle targz
     unarchive:
       src: /path/to/oracle-java.tgz
       dest: /usr/lib/jvm
       remote_src: yes

   - name: Install oracle java policy software (targz)
     unarchive:
       src: /path/to/oracle-java-policy.tgz
       dest: /usr/lib/jvm
       remote_src: yes

   - name: Set alternative (targz)
     command: "alternatives --install /usr/bin/java java /usr/lib/jvm/jdk1.8.0_291/bin/java 1"

   - name: Find JAVA_HOME
     find:
       paths: /usr/lib/jvm
       patterns: "jdk*"
       file_type: directory
     register: java_home_dir

   - name: Set JAVA_HOME in /etc/environment
     lineinfile:
       path: /etc/environment
       regexp: '^JAVA_HOME='
       line: 'JAVA_HOME={{ java_home_dir.files[0].path }}'
       state: present

