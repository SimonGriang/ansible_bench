---
- name: Create RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory

- name: Set server taints
  command: "rke2 server --config /etc/rancher/rke2/config.yaml --node-taint {{ rke2_server_node_taints }}"
  when: rke2_server_node_taints is defined

- name: Copy rke2 config
  copy:
    src: "{{ rke2_config_file }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0600'

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_file }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0600'
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_registry_config_file }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0600'
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and 'inactive' in rke2_server_status.stdout }}"

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined }}"

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/server/db/snapshots
        state: directory

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/snapshots/etcd-snapshot.db

    - name: Restore etcd from snapshot
      command: /var/lib/rancher/rke2/bin/kubectl exec -n kube-system etcd-rke2-server-{{ inventory_hostname }} -- etcdctl --endpoints=https://127.0.0.1:2381 --cacert=/etc/rancher/rke2/server/tls/etcd/server-ca.crt --cert=/etc/rancher/rke2/server/tls/etcd/server-client.crt --key=/etc/rancher/rke2/server/tls/etcd/server-client.key snapshot restore /var/lib/rancher/rke2/server/db/snapshots/etcd-snapshot.db
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  command: "rke2 server --config /etc/rancher/rke2/config.yaml --etcd-s3 --etcd-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }} --etcd-s3-endpoint {{ rke2_etcd_snapshot_s3_options.endpoint }} --etcd-s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }} --etcd-s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }} --etcd-s3-snapshot-name {{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    masked: yes

- name: Wait for the first server be ready - no CNI
  command: /var/lib/rancher/rke2/bin/kubectl get nodes {{ inventory_hostname }}
  register: node_status
  until: "'MemoryPressure' not in node_status.stdout and 'DiskPressure' not in node_status.stdout and 'PIDPressure' not in node_status.stdout"
  retries: 30
  delay: 10

- name: Wait for the first server be ready - with CNI
  command: /var/lib/rancher/rke2/bin/kubectl get nodes {{ inventory_hostname }}
  register: node_status
  until: "'Ready' in node_status.stdout"
  retries: 30
  delay: 10

- name: Restore etcd
  block:
    - name: Remove old <node>.node-password.rke2 secrets
      command: /var/lib/rancher/rke2/bin/kubectl delete secrets -n kube-system {{ item }}.node-password.rke2
      with_items: "{{ groups['rke2_cluster_group_name'] }}"

    - name: Remove old nodes
      command: /var/lib/rancher/rke2/bin/kubectl delete node {{ item }}
      with_items: "{{ groups['rke2_cluster_group_name'] }}"

    - name: Remove old nodes and secrets
      command: /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml remove node {{ item }} --force --ignore-daemonsets
      with_items: "{{ groups['rke2_cluster_group_name'] }}"
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  delegate_facts: true
  with_items: "{{ groups['rke2_cluster_group_name'] }}"


