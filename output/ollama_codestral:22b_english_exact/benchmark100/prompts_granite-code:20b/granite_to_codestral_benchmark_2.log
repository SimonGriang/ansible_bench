     shell: |
       if [[ "{{ node_role }}" == "server" ]]; then
         kubectl taint nodes "{{ inventory_hostname }}" node-role.kubernetes.io/control-plane=NoSchedule:NoExecute
       fi
     delegate_to: localhost

   - name: Set agent taints
     shell: |
       if [[ "{{ node_role }}" == "agent" ]]; then
         kubectl taint nodes "{{ inventory_hostname }}" node-role.kubernetes.io/agent=NoSchedule:NoExecute
       fi
     delegate_to: localhost

