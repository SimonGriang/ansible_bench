---
   - name: Create RKE2 config dir
     file:
       path: "/etc/rancher/rke2"
       state: directory

   - name: Set server taints
     shell: >
       if [[ "{{ node_role }}" == "server" ]]; then
         kubectl taint nodes "{{ inventory_hostname }}"
         node-role.kubernetes.io/control-plane=NoSchedule:NoExecute;
       fi
     delegate_to: localhost

   - name: Set agent taints
     shell: >
       if [[ "{{ node_role }}" == "agent" ]]; then
         kubectl taint nodes "{{ inventory_hostname }}"
         node-role.kubernetes.io/agent=NoSchedule:NoExecute;
       fi
     delegate_to: localhost

   - name: Copy RKE2 config
     copy:
       src: "files/rke2-config.yaml"
       dest: "/etc/rancher/rke2/config.yaml"

   - name: Copy kubelet config
     copy:
       src: "files/kubelet-config.yaml"
       dest: "/etc/rancher/rke2/kubelet-config.yaml"
     when: kubelet_config is defined

   - name: Copy Containerd Registry Configuration file
     copy:
       src: "files/registries.yaml"
       dest: "/etc/rancher/rke2/registries.yaml"
     when: custom_registry is defined

   - name: Start RKE2 service on the rest of the nodes
     systemd:
       name: rke2-server.service
       state: started

   - name: Mask other RKE2 service on the rest of the nodes
     systemd:
       name: "{{ item }}"
       masked: true
     loop:
       - rke2-agent.service

   - name: Wait for remaining nodes to be ready - no CNI
     shell: >
       until kubectl get nodes "{{ inventory_hostname }}"
       -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' | grep -q "True";
       do sleep 5; done
     delegate_to: localhost
     when: no_cni_used is defined

   - name: Wait for remaining nodes to be ready - with CNI
     shell: >
       until kubectl get nodes "{{ inventory_hostname }}"
       -o jsonpath='{.status.conditions[?(@.type=="NetworkUnavailable")].status}'
       | grep -q "False"; do sleep 5; done
     delegate_to: localhost
     when: cni_used is defined

   - name: Ensure new line at end of file
     lineinfile:
       path: "{{ ansible_playbook }}"
       line: ""
       state: present
     delegate_to: localhost
     run_once: true

   # new line added at the end of the file to comply with the new-line-at-end-of-file rule


