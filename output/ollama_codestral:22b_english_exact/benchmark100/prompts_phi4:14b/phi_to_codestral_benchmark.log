---
   - name: Remove obsolete Docker packages
     package:
       name: "{{ docker_obsolete_packages }}"
       state: absent

   - name: Add Docker GPG key
     rpm_key:
       key: "{{ docker_yum_gpg_key }}"
       state: present
     when: docker_add_repo | bool

   - name: Add Docker repository
     yum_repository:
       name: docker-{{ docker_edition }}
       description: Docker Repository
       baseurl: "{{ docker_yum_repo_url }}"
       gpgkey: "{{ docker_yum_gpg_key }}"
       gpgcheck: true
     when: docker_add_repo | bool

   - name: Configure Docker Nightly repo
     lineinfile:
       path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
       regexp: '^#?\s*\[docker-{{ docker_edition }}-nightly\]'
       line: "[docker-{{ docker_edition }}-nightly]{{ ' ' if docker_yum_repo_enable_nightly else '# ' }}"
       insertafter: '^#?\s*\[docker-{{ docker_edition }}\]'
     when: docker_add_repo | bool

   - name: Configure Docker Test repo
     lineinfile:
       path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
       regexp: '^#?\s*\[docker-{{ docker_edition }}-test\]'
       line: "[docker-{{ docker_edition }}-test]{{ ' ' if docker_yum_repo_enable_test else '# ' }}"
       insertafter: '^#?\s*\[docker-{{ docker_edition }}\]'
     when: docker_add_repo | bool

   - name: Configure containerd on RHEL 8
     block:
       - name: Ensure runc is not installed
         package:
           name: runc
           state: absent
       - name: Ensure container-selinux is installed
         package:
           name: container-selinux
           state: present
       - name: Ensure containerd.io is installed
         package:
           name: containerd.io
           state: present
     when:
       - ansible_distribution == 'RedHat'
       - ansible_distribution_major_version == '8'

   # No trailing spaces or new line at the end of file.

