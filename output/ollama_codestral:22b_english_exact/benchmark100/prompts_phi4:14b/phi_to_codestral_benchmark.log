---
   - name: Import assert tasks
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install cron packages
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure cron shell environment
     lineinfile:
       path: "{{ cron_configuration }}"
       line: "SHELL={{ cron_shell }}"
       create: true
       mode: "0600"
     notify: Restart cron service

   - name: Configure PATH environment variable for cron
     lineinfile:
       path: "{{ cron_configuration }}"
       line: "PATH={{ cron_path }}"
       create: true
       mode: "0600"
     notify: Restart cron service

   - name: Configure MAILTO environment variable for cron
     lineinfile:
       path: "{{ cron_configuration }}"
       line: "MAILTO={{ cron_mailto }}"
       create: true
       mode: "0600"
     notify: Restart cron service

   - name: Start and enable cron service
     service:
       name: "{{ cron_service }}"
       state: started
       enabled: true
     when: cron_service is defined and cron_service | length > 0

   - name: Schedule cron jobs
     cron:
       name: "{{ item.name }}"
       job: "{{ item.job }}"
       minute: "{{ item.minute | default('*') }}"
       hour: "{{ item.hour | default('*') }}"
       day: "{{ item.day | default('*') }}"
       month: "{{ item.month | default('*') }}"
       weekday: "{{ item.weekday | default('*') }}"
       user: "{{ item.user | default('root') }}"
       state: "{{ item.state | default('present') }}"
     loop: "{{ cron_jobs }}"
     loop_control:
       label: "{{ item.name }}"
     when: cron_jobs is defined and cron_jobs | length > 0

   handlers:
     - name: Restart cron service
       service:
         name: "{{ cron_service }}"
         state: restarted
         enabled: true
       when: cron_service is defined and cron_service | length > 0

