 - name: Import assert tasks
      import_tasks: assert.yml
      delegate_to: localhost
      run_once: true

    - name: Install DNS packages
      package:
        name: "{{ dns_packages }}"
        state: present

    - name: Create DNS directories
      file:
        path: "{{ item }}"
        state: directory
        mode: '0755'
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
      loop:
        - "{{ dns_datadir }}"
        - "{{ dns_confdir }}"

    - name: Create DNS group
      group:
        name: "{{ dns_group }}"
        state: present

    - name: Create DNS user
      user:
        name: "{{ dns_owner }}"
        system: yes
        state: present

    - name: Generate rndc key
      command:
        cmd: rndc-confgen -a -r /dev/urandom -b 1024 -t rndc-key
        creates: "{{ dns_confdir }}/rndc.key"

    - name: Set rndc key permissions
      file:
        path: "{{ dns_confdir }}/rndc.key"
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
        mode: '0640'

    - name: Download root hints file
      get_url:
        url: "{{ dns_root_hints_url }}"
        dest: "{{ dns_confdir }}/root.hints"
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
        mode: '0644'
      notify: Rndc reload
      when: dns_caching

    - name: Create primary zone files
      template:
        src: zone.j2
        dest: "{{ dns_confdir }}/{{ item }}.zone"
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
        mode: '0644'
        validate: named-checkzone "%s"
      loop: "{{ dns_zones }}"
      notify: Rndc reload

    - name: Create named.conf file
      template:
        src: named.conf.j2
        dest: "{{ dns_confdir }}/named.conf"
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
        mode: '0644'
        validate: named-checkconf %s
      notify: Restart DNS service

    - name: Create systemd service override
      block:
        - name: Create systemd service override directory
          file:
            path: /etc/systemd/system/{{ dns_service }}.service.d
            state: directory
            mode: '0755'

        - name: Copy systemd service override file
          copy:
            src: override.conf
