---
   - name: Create directory for SSH keys if user management is enabled
     file:
       path: "/path/to/ssh/keys"
       state: directory

   - name: Manage user accounts
     user:
       name: "{{ user.name }}"
       state: "{{ user.state }}"
       comment: "{{ user.comment }}"
       home: "{{ user.home | default('/home') }}"
       shell: "{{ user.shell }}"
       groups: "{{ user.groups | join(',') }}"
     register: user_result

   - name: Set sudo privileges for users
     template:
       src: sudoers.j2
       dest: "/etc/sudoers.d/{{ user.name }}"
     when: user.sudo_options is defined

   - name: Remove sudo privileges for users
     file:
       path: "/etc/sudoers.d/{{ user.name }}"
       state: absent
     when: user.sudo_options is not defined

   - name: Generate private SSH key for users
     openssh_keypair:
       path: "/path/to/ssh/keys/{{ user.name }}"
     when: user.ssh_key_management_enabled

   - name: Generate public SSH key for users
     shell:
       cmd: >-
         ssh-keygen -y
         -f /path/to/ssh/keys/{{ user.name }}.key
         > /path/to/ssh/keys/{{ user.name }}.pub
     when: user.ssh_key_management_enabled

   - name: Convert SSH key to PPK format for users
     shell:
       cmd: >-
         puttygen /path/to/ssh/keys/{{ user.name }}.key
         -o /path/to/ssh/keys/{{ user.name }}.ppk
     when: user.ssh_key_management_enabled

   - name: Determine user's home directory
     shell:
       cmd: "getent passwd {{ user.name }} | cut -d: -f6"
     register: user_home
     ignore_errors: true

   - name: Create .ssh directory
     file:
       path: "{{ user_home.stdout | default('/home') }}/.ssh"
       state: directory
     when: user.ssh_key_management_enabled or user.private_keys is defined

   - name: Deploy authorized SSH keys
     authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
     loop: "{{ user.authorized_keys }}"
     when: user.authorized_keys is defined

   - name: Remove unauthorized SSH keys
     authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
       state: absent
     loop: "{{ user.unauthorized_keys }}"
     when: user.unauthorized_keys is defined

   - name: Copy generated private SSH keys
     copy:
       src: "/path/to/ssh/keys/{{ user.name }}.key"
       dest: "{{ user_home.stdout | default('/home') }}/.ssh/{{ user.name }}.key"
     when: user.copy_private_key

   - name: Check password validity period
     shell:
       cmd: >-
         chage -l {{ user.name }} |
         grep 'Password expires' |
         cut -d: -f2 |
         awk '{$1=$1};1'
     register: password_validity

   - name: Set password validity period
     shell:
       cmd: >-
         chage -M {{ user.password_validity_days }}
         {{ user.name }}
     when: >
       user.password_validity_days is defined and
       password_validity.stdout != user.password_validity_days

   - name: Place additional private key files
     copy:
       src: "{{ item.src }}"
       dest: "{{ user_home.stdout | default('/home') }}/.ssh/{{ item.dest }}"
     loop: "{{ user.additional_private_keys }}"
     when: user.additional_private_keys is defined

