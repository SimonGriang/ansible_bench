 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install MySQL packages
     package:
       name: "{{ mysql_packages }}"
       state: present
     notify:
       - set_root_password
       - reload_systemd_daemon

   - name: Configure MySQL server configuration file
     ini_file:
       path: /etc/mysql/my.cnf
       section: mysqld
       option: "{{ item.option }}"
       value: "{{ item.value }}"
       mode: '0644'
     with_items: "{{ mysql_configuration_options }}"
     notify: restart_mysql_server

   - name: Configure MySQL client configuration file
     ini_file:
       path: /etc/mysql/my.cnf
       section: client
       option: socket
       value: "{{ mysql_socket }}"

   - name: Initialize MySQL database if on Alpine or Archlinux
     command: mysql_install_db --user=mysql --ldata=/var/lib/mysql
     when: ansible_os_family == 'Alpine' or ansible_os_family == 'Archlinux'
     args:
       creates: /var/lib/mysql

   - name: Start and enable MySQL service
     service:
       name: mysql
       state: started
       enabled: true

   - name: Flush handlers to apply previous changes
     meta: flush_handlers

   - name: Place the my.cnf configuration file
     template:
       src: my.cnf.j2
       dest: /root/.my.cnf
       owner: root
       mode: '0600'

   - name: Create MySQL databases
     mysql_db:
       name: "{{ item.name }}"
       state: present
       login_unix_socket: "{{ mysql_socket }}"
     with_items: "{{ mysql_databases }}"
     no_log: true
     when: item.import is not defined

   - name: List current MySQL databases
     shell: mysql --defaults-file=/root/.my.cnf -e "SHOW DATABASES;"
     register: mysql_databases_list
     no_log: true

   - name: Import databases if initial import is defined and not already present
     mysql_db:
       name: "{{ item.name }}"
       state: import
       target: "{{ item.import }}"
       login_unix_socket: "{{ mysql_socket }}"
     with_items: "{{ mysql_databases }}"
     no_log: true
     when: item.import is defined and item.name not in mysql_databases_list.stdout_lines

   - name: Create MySQL users
     mysql_user:
       name: "{{ item.name }}"
       host: "{{ item.host | default('localhost') }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       state: present
       login_unix_socket: "{{ mysql_socket }}"
     with_items: "{{ mysql_users }}"
     no_log: true

   - name: Flush handlers again to apply user creation changes
     meta: flush_handlers


