---
   - name: Create the RKE2 manifests directory
     file:
       path: /etc/rancher/rke2/manifests
       state: directory
       owner: root
       group: root
       mode: '0700'

   - name: Copy kube-vip files to the first server
     copy:
       src: kube-vip.yaml.j2
       dest: /etc/rancher/rke2/manifests/kube-vip.yaml
       owner: root
       group: root
       mode: '0664'

   - name: Copy kube-vip load balancer manifests to the first server
     copy:
       src: kube-vip-cloud-provider.yaml.j2
       dest: /etc/rancher/rke2/manifests/kube-vip-cloud-provider.yaml
       owner: root
       group: root
       mode: '0664'
     when: cloud_provider_enabled | default(false) | bool

