           url: "{{ item }}"
           state: present
         loop: "{{ java_os_specific_vars.apt_key_repos }}"
       - name: Add required repositories
         apt_repository:
           repo: "{{ item }}"
           state: present
         loop: "{{ java_os_specific_vars.apt_repos }}"
     when: ansible_os_family == 'Debian'

   - name: Handle RedHat pre-requisites for Java installation
     block:
       - name: Add key repositories
         yum_repository:
           name: "{{ item.name }}"
           description: "{{ item.description }}"
           baseurl: "{{ item.baseurl }}"
           gpgkey: "{{ item.gpgkey }}"
           gpgcheck: yes
         loop: "{{ java_os_specific_vars.yum_repos }}"
     when: ansible_os_family == 'RedHat'

   - name: Install required libraries for Java
     package:
       name: "{{ java_os_specific_vars.required_libraries }}"
       state: present

   - name: Install Java on Debian systems
     apt:
       name: "{{ java_jdk_vendor }}-{{ java_jdk_version }}-jdk"
       state: present
       update_cache: yes
     when: ansible_os_family == 'Debian'

   - name: Install Java on RedHat systems
     yum:
       name: "{{ java_jdk_vendor }}-{{ java_jdk_version }}-openjdk"
       state: present
     when: ansible_os_family == 'RedHat'

   - name: Export Java environment variables
     template:
       src: jdk.sh.j2
       dest: /etc/profile.d/jdk.sh

   - name: Source Java environment variables
     shell: source /etc/profile.d/jdk.sh

   - name: Correct Java version selection for versions less than 11 on Debian systems
     shell: update-alternatives --set java "{{ java_home }}/bin/java"
     when: ansible_os_family == 'Debian' and java_jdk_version | int < 11

   - name: Correct Java version selection for versions 11 or greater on Debian systems
     shell: update-java-alternatives --set java-1.{{ java_jdk_version }}.0-openjdk-{{ java_jdk_vendor }}
     when: ansible_os_family == 'Debian' and java_jdk_version | int >= 11

