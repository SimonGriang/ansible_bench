ne': True, 'done_reason': 'stop', 'total_duration': 11433909702, 'load_duration': 14396103, 'prompt_eval_count': 1653, 'prompt_eval_duration': 22884389, 'eval_count': 578, 'eval_duration': 11395277526, 'model_name': 'codestral:22b'} id='run--8c9a791c-58a5-4b80-8dff-d503e5a70389-0' usage_metadata={'input_tokens': 1653, 'output_tokens': 578, 'total_tokens': 2231}
