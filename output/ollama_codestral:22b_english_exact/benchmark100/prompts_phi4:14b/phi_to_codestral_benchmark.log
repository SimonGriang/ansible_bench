---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install cron
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure shell
     lineinfile:
       path: /etc/default/cron
       regexp: '^SHELL='
       line: 'SHELL="{{ cron_shell }}"'
     notify: restart cron

   - name: Configure path
     lineinfile:
       path: /etc/environment
       regexp: '^PATH='
       line: 'PATH="{{ cron_path }}"'
     notify: restart cron

   - name: Configure mailto
     lineinfile:
       path: /etc/default/cron
       regexp: '^MAILTO='
       line: 'MAILTO="{{ cron_mailto }}"'
     notify: restart cron

   - name: Start and enable cron
     service:
       name: "{{ cron_service }}"
       state: started
       enabled: true
     when: cron_service is defined and cron_service != ''

   - name: Schedule requested cron jobs
     cron:
       name: "{{ item.name }}"
       job: "{{ item.job }}"
       state: present
       user: "{{ item.user | default(omit) }}"
       minute: "{{ item.minute | default(omit) }}"
       hour: "{{ item.hour | default(omit) }}"
       day: "{{ item.day | default(omit) }}"
       month: "{{ item.month | default(omit) }}"
       weekday: "{{ item.weekday | default(omit) }}"
     loop: "{{ cron_jobs | default([]) }}"
     when: cron_jobs is defined
     notify: restart cron 85%|████████▌ | 85/100 [1:45:05<15:33, 62.21s/it]

