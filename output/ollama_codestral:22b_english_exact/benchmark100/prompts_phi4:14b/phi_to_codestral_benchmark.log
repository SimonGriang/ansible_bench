---
   - name: Import assert.yml tasks
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install PHP
     package:
       name: "{{ php_packages }}"
       state: present

   - name: Find used php.ini file
     shell: "{{ php_ini_command }}"
     register: php_found_ini_location
     changed_when: false
     when: php_ini_location is not defined

   - name: Configure PHP
     template:
       src: php.ini.j2
       dest: "{{ php_found_ini_location.stdout }}"
       mode: '0644'
     notify: restart httpd


