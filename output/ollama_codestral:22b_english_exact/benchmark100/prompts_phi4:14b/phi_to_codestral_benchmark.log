 - name: Import Assert Task
    import_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Install Logrotate Packages
    package:
      name: "{{ logrotate_packages }}"
      state: present

  - name: Configure Logrotate
    template:
      src: "{{ logrotate_config_file }}"
      dest: "{{ logrotate_config_directory }}/logrotate.conf"
      mode: 0644

  - name: Generate Logrotate.d Configuration Files
    template:
      src: entry.j2
      dest: "{{ logrotate_confd_directory }}/{{ item.key }}"
    when: item.value.state != 'absent'
    with_dict: "{{ logrotate_entries }}"

  - name: Remove Logrotate.d Configuration Files
    file:
      path: "{{ logrotate_confd_directory }}/{{ item.key }}"
      state: absent
    when: item.value.state == 'absent'
