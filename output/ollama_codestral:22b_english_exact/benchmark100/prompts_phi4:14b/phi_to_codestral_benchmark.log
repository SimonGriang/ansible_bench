---
   - name: Assert systemd is used as the init system
     assert:
       that:
         - ansible_service_mgr == 'systemd'
       fail_msg: "This playbook only works with systemd"

   - name: Fetch latest release information for Grafana Loki
     uri:
       url: "https://api.github.com/repos/grafana/loki/releases/latest"
       method: GET
       return_content: yes
       status_code: 200
       headers:
         Accept: "application/vnd.github.v3+json"
       validate_certs: yes
       body_format: json
       url_username: "{{ lookup('env', 'GITHUB_USER') }}"
       url_password: "{{ lookup('env', 'GITHUB_TOKEN') }}"
     register: github_release
     until: github_release.status == 200
     retries: 5
     delay: 10
     when: promtail_version == 'latest'
     no_log: true

   - name: Set promtail_version fact
     set_fact:
       promtail_version: "{{ github_release.json.tag_name }}"
     when: promtail_version == 'latest'

   - name: Verify existence of local promtail binary archive
     stat:
       path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}-{{ ansible_architecture }}.tar.gz"
     register: promtail_binary_archive
     when: promtail_binary_local_dir is defined

   - name: Assert local promtail binary archive exists
     assert:
       that:
         - promtail_binary_archive.stat.exists
       fail_msg: "Local promtail binary archive does not exist"
     when: promtail_binary_local_dir is defined

   - name: Fetch checksum list for promtail binary
     set_fact:
       promtail_checksum_list: "{{ lookup('url', 'https://github.com/grafana/loki/releases/download/' + promtail_version + '/SHA256SUMS', split_lines=True) }}"
     when: promtail_binary_local_dir is not defined

   - name: Extract checksum for promtail binary
     set_fact:
       promtail_checksum: "{{ item.split()[0] }}"
     loop: "{{ promtail_checksum_list }}"
     when:
       - promtail_binary_local_dir is not defined
       - "'promtail-linux-' + ansible_architecture in item"
   

