 - name: Collect OS release information
     command: cat /etc/os-release
     become: "{{ bootstrap_become }}"
     become_user: "{{ bootstrap_become_user | default(omit) }}"
     register: bootstrap_facts
     changed_when: false
     failed_when: bootstrap_facts.rc != 0

   - name: Set bootstrap facts for distribution and major version
     set_fact:
       bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_search('(?<=PRETTY_NAME=).+(?= .*)') | regex_replace('\"', '') | trim | lower }}"
       bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search('(?<=VERSION_ID=).+') | regex_replace('\"', '') | trim | regex_replace('\\..*$', '') }}"
     when:
       - bootstrap_facts.rc == 0
       - bootstrap_distribution is not defined
       - bootstrap_facts.stdout is search('PRETTY_NAME')
     become: "{{ bootstrap_become }}"
     become_user: "{{ bootstrap_become_user | default(omit) }}"

   - name: Set bootstrap facts for the OS family
     set_fact:
       bootstrap_os_family: "{{ item.value }}"
     loop: "{{ lookup('dict', bootstrap__os_family_map) }}"
     when:
       - bootstrap_distribution is defined
       - item.key == bootstrap_distribution
     become: "{{ bootstrap_become }}"
     become_user: "{{ bootstrap_become_user | default(omit) }}"

