---
   - name: Cordon and Drain the node during RKE2 upgrade
     ansible.builtin.command:
       cmd: kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-local-data
     register: drain
     until: drain is succeeded
     retries: 100
     delay: 15
     when: rke2_drain_node_during_upgrade
     delegate_to: "{{ groups['kubernetes_masters'][0] }}"
     run_once: true

   - name: Restart the RKE2 service on the node
     ansible.builtin.service:
       name: "{{ rke2_service_name }}"
       state: restarted
     notify: Service (re)started

   - name: Wait for all nodes to be ready again
     ansible.builtin.command:
       cmd: kubectl get nodes --selector='!node-role.kubernetes.io/master' --field-selector=status.conditions[?(@.type=='Ready')].status=True -o jsonpath='{.items[*]}'
     register: nodes
     until: nodes.stdout | length == groups[rke2_cluster_group_name] | length
     retries: 100
     delay: 15
     delegate_to: "{{ groups['kubernetes_masters'][0] }}"
     run_once: true

   - name: Uncordon the node after the upgrade
     ansible.builtin.command:
       cmd: kubectl uncordon {{ rke2_node_name }}
     when: rke2_drain_node_during_upgrade
     delegate_to: "{{ groups['kubernetes_masters'][0] }}"
     run_once: true

   - name: Wait for all pods to be ready again
     ansible.builtin.command:
       cmd: kubectl get pods --all-namespaces -o jsonpath='{.items[?(@.status.phase!="Running" && @.status.phase!="Succeeded")]}'
     register: pods
     until: pods.stdout == ''
     retries: 100
     delay: 15
     when: rke2_wait_for_all_pods_to_be_ready
     delegate_to: "{{ groups['kubernetes_masters'][0] }}"
     run_once: true

   - name: Wait for all pods to pass readiness checks
     ansible.builtin.command:
       cmd: kubectl wait {{ rke2_wait_for_all_pods_to_be_healthy_args }}
     register: pods_healthy
     until: pods_healthy is succeeded
     retries: 100
     delay: 15
     when: rke2_wait_for_all_pods_to_be_healthy
     delegate_to: "{{ groups['kubernetes_masters'][0] }}"
     run_once: true
   

