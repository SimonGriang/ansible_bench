---
   - name: Ensure /etc/openvpn/easy-rsa directory exists
     file:
       path: /etc/openvpn/easy-rsa
       state: directory
       mode: '0755'

   - name: Initialize PKI directory using EasyRSA
     shell:
       cmd: "./easyrsa init-pki"
       chdir: /etc/openvpn/easy-rsa

   - name: Build a CA certificate using EasyRSA without a passphrase
     shell:
       cmd: "./easyrsa build-ca nopass"
       chdir: /etc/openvpn/easy-rsa

   - name: Generate a Diffie-Hellman parameters file using EasyRSA
     shell:
       cmd: "./easyrsa gen-dh"
       chdir: /etc/openvpn/easy-rsa

   - name: Build a server certificate using EasyRSA without a passphrase
     shell:
       cmd: "./easyrsa build-server-full server nopass"
       chdir: /etc/openvpn/easy-rsa

   - name: Build a client certificate using EasyRSA without a passphrase
     shell:
       cmd: "./easyrsa build-client-full client nopass"
       chdir: /etc/openvpn/easy-rsa

   - name: Generate a Certificate Revocation List using EasyRSA
     shell:
       cmd: "./easyrsa gen-crl"
       chdir: /etc/openvpn/easy-rsa

   - name: Generate a TLS auth key using OpenVPN
     shell:
       cmd: "openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key"

   - name: Copy necessary EasyRSA files to /etc/openvpn/server
     copy:
       src: "{{ item.src }}"
       dest: "/etc/openvpn/server/{{ item.dest }}"
       mode: '0644'
     loop:
       - { src: '/etc/openvpn/easy-rsa/pki/ca.crt', dest: 'ca.crt' }
       - { src: '/etc/openvpn/easy-rsa/pki/dh.pem', dest: 'dh.pem' }
       - { src: '/etc/openvpn/easy-rsa/pki/ta.key', dest: 'ta.key' }
       - { src: '/etc/openvpn/easy-rsa/pki/issued/server.crt', dest: 'server.crt' }
       - { src: '/etc/openvpn/easy-rsa/pki/private/server.key', dest: 'server.key' }
       - { src: '/etc/openvpn/easy-rsa/pki/issued/client.crt', dest: 'client.crt' }
       - { src: '/etc/openvpn/easy-rsa/pki/private/client.key', dest: 'client.key' }

   - name: Copy necessary EasyRSA files to /etc/openvpn
     copy:
       src: "{{ item.src }}"
       dest: "/etc/openvpn/{{ item.dest }}"
       mode: '0644'
     loop:
       - { src: '/etc/openvpn/easy-rsa/pki/ca.crt', dest: 'ca.crt' }
       - { src: '/etc/openvpn/easy-rsa/pki/ta.key', dest: 'ta.key' }

   - name: Deploy the OpenVPN server configuration file
     template:
       src: server.conf.j2
       dest: /etc/openvpn/server.conf
       owner: root
       group: root
       mode: '0644'
     notify: restart openvpn

