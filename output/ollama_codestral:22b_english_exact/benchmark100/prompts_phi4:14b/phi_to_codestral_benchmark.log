 - name: Import assert.yml tasks
      import_tasks: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Install GRUB packages
      package:
        name: "{{ grub_packages }}"
        state: present

    - name: Set GRUB_TIMEOUT
      lineinfile:
        path: /etc/default/grub
        regexp: '^GRUB_TIMEOUT='
        line: 'GRUB_TIMEOUT={{ grub_timeout }}'
        create: yes
        mode: 0664
      notify: update GRUB

    - name: Set GRUB_RECORDFAIL_TIMEOUT
      lineinfile:
        path: /etc/default/grub
        regexp: '^GRUB_RECORDFAIL_TIMEOUT='
        line: 'GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}'
        create: yes
        mode: 0664
      notify: update GRUB

    - name: Add options to GRUB_CMDLINE_LINUX
      lineinfile:
        path: /etc/default/grub
        regexp: '^GRUB_CMDLINE_LINUX='
        line: 'GRUB_CMDLINE_LINUX="{{ grub_cmdline_linux | regex_replace("\\b(" + grub_options | join("|") + ")\\b", "") }} {{ grub_options | join(" ") }}"'
        create: yes
        mode: 0664
        backrefs: yes
      notify: update GRUB
      when: grub_options is defined and grub_options | length > 0

    - name: Import password.yml if password setting is required
      import_tasks: password.yml
      when: grub_set_password | bool

    - name: Flush handlers
      meta: flush_handlers

