 - name: Load OS-specific variables
      include_vars:
        file: "{{ item }}"
        name: "{{ item | regex_replace('\\.yml$', '') }}"
      with_first_found:
        - "{{ ansible_distribution }}.yml"
        - "{{ ansible_os_family }}.yml"
        - "main.yml"
      tags:
        - docker-install

    - name: Include RedHat-specific setup tasks
      include_tasks: setup-RedHat.yml
      when: ansible_os_family == 'RedHat'
      tags:
        - docker-install

    - name: Include Debian-specific setup tasks
      include_tasks: setup-Debian.yml
      when: ansible_os_family == 'Debian'
      tags:
        - docker-install

    - name: Install Docker packages (Ansible < 2.12 or non-RedHat/Debian)
      package:
        name: "{{ docker_packages }}"
        state: "{{ docker_packages_state }}"
      notify: restart docker
      ignore_errors: "{{ ansible_check_mode }}"
      when: >
        ansible_version.full is version_compare('2.12', '<')
        or ansible_os_family not in ['RedHat', 'Debian']
      tags:
        - docker-install

    - name: Install Docker packages with allow_downgrade (Ansible >= 2.12 and RedHat/Debian)
      package:
        name: "{{ docker_packages }}"
        allow_downgrade: yes
      notify: restart docker
      ignore_errors: "{{ ansible_check_mode }}"
      when: >
        ansible_version.full is version_compare('2.12', '>=')
        and ansible_os_family in ['RedHat', 'Debian']
      tags:
        - docker-install

    - name: Install Docker Compose plugin (Ansible < 2.12 or non-RedHat/Debian)
      package:
        name: "{{ docker_compose_package }}"
        state: "{{ docker_compose_package_state }}"
      notify: restart docker
      ignore_errors: "{{ ansible_check_mode }}"
      when: >
        docker_install_compose_plugin
        and (ansible_version.full is version_compare('2.12', '<')
        or ansible_os_family not in ['RedHat', 'Debian'])
      tags:
        - docker-compose-plugin

    - name: Install Docker Compose plugin with allow_downgrade (Ansible >= 2.12 and RedHat/Debian)
      package:
        name: "{{ docker_compose_package }}"
        allow_downgrade: yes
      notify: restart docker
      ignore_errors: "{{ ansible_check_mode }}"
      when: >
        docker_install_compose_plugin
        and ansible_version.full is version_compare('2.12', '>=')
        and ansible_os_family in ['RedHat', 'Debian']
      tags:
        - docker-compose-plugin

    - name: Ensure /etc/docker directory exists
      file:
        path: /etc/docker
        state: directory
        mode: 0755
      when: docker_daemon_options.keys() | length > 0
      tags:
        - docker-config

    - name: Configure Docker daemon options
      copy:
        content: "{{ docker_daemon_options | to_nice_json }}"
        dest: /etc/docker/daemon.json
        mode: 0644
      notify: restart docker
      when: docker_daemon_options.keys() | length > 0
      tags:
        - docker-config

    - name: Manage Docker service
      service:
        name: docker
        state: "{{ docker_service_state }}"
        enabled: "{{ docker_service_enabled }}"
      ignore_errors: "{{ ansible_check_mode }}"
      when: docker_service_manage
      tags:
        - docker-service

    - name: Flush handlers
      meta: flush_handlers
      tags:
        - docker-handlers

    - name: Include Docker Compose setup tasks
      include_tasks: docker-compose.yml
      when: docker_install_compose
      tags:
        - docker-compose

    - name: Get Docker group info
      getent:
        database: group
        key: docker
      when: docker_users | length > 0
      register: docker_group_info
      tags:
        - docker-users

    - name: Check if any users need to be added to Docker group
      set_fact:
        at_least_one_user_to_modify: true
      when: >
        docker_users | difference(docker_group_info.getent_group[1].split(':')[3].split(',')) | length > 0
      tags:
        - docker-users

    - name: Include Docker user modification tasks
      include_tasks: docker-users.yml
      when: at_least_one_user_to_modify is defined
      tags:
        - docker-users

