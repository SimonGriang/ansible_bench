---
   - name: Install Keepalived
     include_role:
       name: keepalived_install
     when: rke2_ha_mode | bool and rke2_ha_mode_keepalived | bool and inventory_hostname in groups['rke2_servers'] and rke2_api_ip is defined

   - name: Download and install RKE2 version
     include_role:
       name: rke2_install

   - name: Apply CIS Hardening
     include_role:
       name: cis_hardening
     when: cis_profile is defined

   - name: Find Active Server
     include_role:
       name: active_server_find

   - name: Enable IPVS kernel module
     modprobe:
       name: ip_vs
       state: present
     when: rke2_ha_mode | bool and rke2_ha_mode_kubevip | bool and inventory_hostname in groups['rke2_servers'] and not rke2_ha_mode_keepalived | bool

   - name: Copy kube-vip manifests to the masternode
     include_role:
       name: kube_vip_manifests_copy
     when: rke2_ha_mode | bool and rke2_ha_mode_kubevip | bool and not rke2_ha_mode_keepalived | bool

   - name: Copy ingress-nginx manifests to the masternode
     include_role:
       name: ingress_nginx_manifests_copy
     when: ingress_nginx_values is defined and ingress_nginx_values

   - name: Prepare very first server node in the cluster
     include_role:
       name: first_server_node_prepare
     when: groups['rke2_servers'] | length == 1 or active_server is not defined

   - name: Restore etcd specific tasks
     include_role:
       name: etcd_restore
     when: active_server is defined and (inventory_hostname == active_server or groups['rke2_servers'][0] == inventory_hostname) and rke2_etcd_restore is defined

   - name: Download kubeconfig to ansible localhost
     include_role:
       name: kubeconfig_download
     when: rke2_kubeconfig_download | bool and groups['rke2_servers'][0] == inventory_hostname

   - name: Prepare and join remaining nodes of the cluster
     include_role:
       name: remaining_nodes_prepare_join
     when: active_server is defined and groups['rke2_servers'] | length > 1

   - name: Rolling cordon and drain restart when version changes - servers
     include_role:
       name: rolling_cordon_drain_restart_servers

   - name: Rolling cordon and drain restart when version changes - agents
     include_role:
       name: rolling_cordon_drain_restart_agents

   - name: Flush handlers
     meta: flush_handlers

   - name: Rolling restart when config files change
     include_role:
       name: rolling_restart_config_changes

   - name: Final steps
     include_role:
       name: final_steps

