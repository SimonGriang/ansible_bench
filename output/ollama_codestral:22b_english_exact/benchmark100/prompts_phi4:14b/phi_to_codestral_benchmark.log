 - name: Assert Variables Configuration
     ansible.builtin.import_tasks: assert_variables.yml
     delegate_to: localhost
     run_once: true

   - name: Wait for Host Availability
     ansible.builtin.wait_for:
       host: "{{ inventory_hostname }}"
       port: "{{ host_port | default(22) }}"
     when:
       - connection != 'container'
       - wait_for_host | default(true)
     connection: local
     become: "{{ become | default(false) }}"

   - name: Prepare System
     block:
       - name: Test Connection
         ansible.builtin.ping:
         register: ping_result
         ignore_unreachable: true

       - name: Debug Connection Timeout
         ansible.builtin.debug:
           msg: "Connection timed out after {{ ansible_connect_timeout }} seconds"
         when: ping_result is failed

       - name: Gather Facts
         ansible.builtin.setup:

