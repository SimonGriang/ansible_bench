 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
     notify:
       - set mysql root password
       - restart mysql systemd daemon

   - name: Configure mysql server
     template:
       src: "{{ mysql_configuration_source }}"
       dest: "{{ mysql_configuration_destination }}"
     with_dict: "{{ mysql_configuration_options }}"
     notify:
       - restart mysql systemd daemon

   - name: Configure mysql client
     lineinfile:
       path: "{{ mysql_configuration_destination }}"
       regexp: '^socket'
       line: "socket = {{ mysql_socket }}"
       insertafter: '^\\[client\\]$'

   - name: Initialize mysql
     command: "{{ mysql_initialize_command }}"
     when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"

   - name: Start and enable mysql
     service:
       name: "{{ mysql_service }}"
       state: started
       enabled: yes

   - name: Flush handlers
     meta: flush_handlers

   - name: Place my.cnf
     template:
       src: my.cnf.j2
       dest: /root/.my.cnf
       mode: 0640

   - name: Create databases
     mysql_db:
       name: "{{ item.name }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
       no_log: true
     with_items: "{{ mysql_databases }}"

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
       no_log: true
     with_items: "{{ mysql_users }}"

   - name: Flush handlers again
     meta: flush_handlers

