---
- name: Disable swap if vault_hardening_disable_swap is set and swap is currently enabled
  shell: |
    swapoff -a
    sed -i '/swap/d' /etc/fstab
  when:
    - vault_hardening_disable_swap
    - ansible_swaptotal_mb > 0

- name: Disable core dumps if vault_hardening_disable_core_dumps is set
  pam_limits:
    domain: '*'
    limit_type: "{{ item.limit_type }}"
    limit_item: core
    value: 0
  loop:
    - { limit_type: soft }
    - { limit_type: hard }
  when: vault_hardening_disable_core_dumps

- name: Disable shell command history for vault commands if vault_hardening_disable_shell_command_history is set
  copy:
    dest: /etc/profile.d/disable_vault_history.sh
    content: |
      #!/bin/sh
      if [[ "$BASH" ]] && [[ "$BASH_COMMAND" =~ ^vault\ * ]]; then
        HISTCONTROL=ignorespace:erasedups
      fi
    mode: '0755'
  when: vault_hardening_disable_shell_command_history

- name: Configure SELinux and/or AppArmor if vault_hardening_configure_selinux_apparmor is set
  block:
    - name: Ensure selinux-policy is installed and set the SELinux policy to enforcing
      package:
        name: selinux-policy
        state: present
      selinux:
        policy: targeted
        state: enforcing
      when:
        - ansible_selinux.status == 'enabled'
        - ansible_selinux.config_mode == 'enforcing' or ansible_selinux.mode == 'enforcing'

    - name: Enforce the AppArmor profile for the vault application
      command: apparmor_parser -r /etc/apparmor.d/usr.bin.vault
      when:
        - ansible_apparmor.status == 'enabled'
        - ansible_apparmor.complain_mode == 'disabled'
  when: vault_hardening_configure_selinux_apparmor


