---
   - name: Import assert task
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install Apache HTTP server
     ansible.builtin.package:
       name: "{{ httpd_packages }}"
       state: present

   - name: Configure SELinux settings
     block:
       - name: Modify SELinux booleans
         ansible.posix.seboolean:
           name: "{{ item }}"
           state: yes
           persistent: yes
         loop: "{{ httpd_sebooleans }}"
       - name: Allow connections to custom ports
         seport:
           ports: "{{ httpd_port }},{{ httpd_ssl_port|default(omit) }}"
           proto: tcp
           setype: http_port_t
           state: present
     when: ansible_selinux is defined and ansible_selinux.status == 'enabled'

   - name: Configure Apache HTTP server
     ansible.builtin.template:
       src: "{{ httpd_config_src }}"
       dest: "{{ httpd_config_dest }}"
       mode: '0644'
     notify:
       - Test Apache configuration
       - Restart Apache service

   - name: Activate Apache HTTP modules on Debian
     ansible.builtin.command: a2enmod "{{ item }}"
     loop: "{{ httpd_modules_to_activate_with_command }}"
     notify:
       - Test Apache configuration
     when: ansible_os_family == 'Debian'

   - name: Import SSL configuration tasks
     import_tasks: ssl.yml
     when: https_ssl_enable

   - name: Import location configuration tasks
     import_tasks: locations.yml
     when: httpd_locations is defined

   - name: Import virtual host configuration tasks
     import_tasks: vhosts.yml
     when: httpd_vhosts is defined

   - name: Configure Apache HTTP server ports on Debian and SUSE
     ansible.builtin.template:
       src: "{{ httpd_ports_conf }}"
       dest: "/etc/apache2/ports.conf"
       mode: '0644'
     notify:
       - Test Apache configuration
       - Restart Apache service
     when: ansible_os_family in ['Debian', 'Suse']

   - name: Import directory configuration tasks
     import_tasks: directories.yml
     when: httpd_directories is defined

   - name: Flush handlers
     ansible.builtin.meta: flush_handlers

   - name: Remove default HTML index file
     ansible.builtin.file:
       path: "{{ httpd_data_directory }}/index.html"
       state: absent
     when: httpd_remove_example

   - name: Start and enable Apache HTTP server service
     ansible.builtin.service:
       name: "{{ httpd_service }}"
       state: started
       enabled: yes

