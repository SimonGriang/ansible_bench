       - name: Install Oracle Java DEB package
         apt:
           deb: "/tmp/{{ java_oracle_deb_package }}"
           state: present
     when: java_source == 'local' and java_format == 'DEB'

   - name: Install Oracle Java RPM package from repository
     package:
       name: "{{ java_oracle_package }}"
       state: present
