---
   - name: Create RKE2 configuration directory
     file:
       path: /etc/rancher/rke2
       state: directory
       owner: root
       group: root
       mode: '0755'

   - name: Set server node taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_node_type == 'server'

   - name: Set agent node taints
     set_fact:
       combined_node_taints: "{{ rke2_agent_node_taints }}"
     when: rke2_node_type == 'agent'

   - name: Deploy RKE2 configuration file
     template:
       src: "{{ rke2_config }}"
       dest: /etc/rancher/rke2/config.yaml
       owner: root
       group: root
       mode: '0600'
     notify: Config file changed

   - name: Deploy kubelet configuration file
     template:
       src: templates/kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       owner: root
       group: root
       mode: '0600'
     when: rke2_kubelet_config | length > 0
     notify: Config file changed

   - name: Deploy Containerd registry configuration file
     template:
       src: "{{ rke2_custom_registry_path }}"
       dest: /etc/rancher/rke2/registries.yaml
       owner: root
       group: root
       mode: '0600'
     when: rke2_custom_registry_path is defined
     notify: Config file changed

   - name: Start RKE2 service on all nodes
     systemd:
       name: "{{ rke2_service_name }}"
       state: started
       enabled: true
       daemon_reload: true
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     register: service_result
     until: service_result is succeeded
     retries: 10
     delay: 3
     notify: Service (re)started

   - name: Mask other RKE2 services on non-applicable nodes
     systemd:
       name: "{{ item }}"
       masked: true
       enabled: false
     with_items:
       - rke2-agent.service
       - rke2-server.service
     when: item != rke2_service_name

   - name: Verify node readiness without CNI
     shell: |
       kubectl get nodes -o json |
       jq -e '.items[] | select(.metadata.name == "{{ inventory_hostname }}") |
       .status.conditions[] | select(.type == "MemoryPressure" or .type == "DiskPressure" or
       .type == "PIDPressure" or .type == "Ready" or .type == "CNIReady") |
       select(.status == "True")'
     delegate_to: "{{ rke2_server_address }}"
     register: command_result
     until: command_result.rc == 0
     retries: 100
     delay: 15
     when: rke2_node_type == 'server' or inventory_hostname == groups['rke2_servers'][0]

   - name: Verify node readiness with CNI
     shell: |
       kubectl get nodes -o json |
       jq -e '.items[] | select(.metadata.name == "{{ inventory_hostname }}") |
       .status.conditions[] | select(.type == "Ready" and .status == "True")' &&
       kubectl get nodes --field-selector=status.nodeInfo.containerRuntimeVersion='rke2://{{ rke2_version }}' --no-headers | wc -l
     delegate_to: "{{ rke2_server_address }}"
     register: command_result
     until: command_result.rc == 0 and command_result.stdout | trim == groups['rke2_nodes'] | length
     retries: 100
     delay: 15
     when: not ansible_check_mode and (rke2_node_type == 'server' or inventory_hostname == groups['rke2_servers'][0])
   

