---
   - name: Check if EFI path exists
     stat:
       path: /sys/firmware/efi
     register: efi_path

   - name: Remove EFI grub.cfg if system is EFI
     file:
       path: /boot/grub2/grub.cfg
       state: absent
     when: efi_path.stat.exists

   - name: Deploy user template to Grub configuration directory
     template:
       src: grub.cfg.j2
       dest: /etc/default/grub
       mode: '0644'
     notify:
       - Update Grub

   - name: Add password to EFI Grub configuration
     lineinfile:
       path: /etc/grub2-efi.cfg
       line: 'set superusers="admin"'
       insertbefore: '^set default'
     notify:
       - Update Grub
     when: efi_path.stat.exists

   - name: Add password to MBR Grub configuration
     lineinfile:
       path: /etc/grub2.cfg
       line: 'set superusers="admin"'
       insertbefore: '^set default'
     notify:
       - Update Grub
     when: efi_path.stat.exists

   - name: Modify files to add --unrestricted class
     lineinfile:
       path: "{{ item }}"
       regexp: '^CLASS='
       line: 'CLASS="--class gnu-linux --class gnu-linux-simple-menu --class gnu-linux-simple-menu-submenu --unrestricted"'
     with_items:
       - /etc/grub2-efi.cfg
       - /etc/grub2.cfg
     notify:
       - Update Grub
     when: efi_path.stat.exists

   - name: Ensure the playbook ends with a new line
     meta: noop

