---
   - name: Install the vault package
     package:
       name: "{{ vault_package }}"
       state: present
     notify:
       - reload daemon
       - restart vault service

   - name: Reload the system daemon
     systemd:
       daemon_reload: true
     listen: "reload daemon"

   - name: Restart the vault service
     systemd:
       name: vault
       state: restarted
     listen: "restart vault service"

   - name: Ensure a new line at the end of file
     meta: noop


