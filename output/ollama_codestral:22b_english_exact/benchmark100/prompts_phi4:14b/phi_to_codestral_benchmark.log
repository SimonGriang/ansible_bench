---
   - name: Import assert conditions
     import_tasks: assert.yml
     run_once: yes
     delegate_to: localhost

   - name: Pre-configure Debian systems for Postfix
     debconf:
       name: postfix
       question: postfix/main_mailer_type
       vtype: string
       value: "No configuration"
     when: ansible_os_family == 'Debian'

   - name: Install Postfix
     package:
       name: postfix
       state: present

   - name: Conditionally install postfix-mysql
     package:
       name: postfix-mysql
       state: present
     when: >
       (postfix_virtual_mailbox_maps is defined and 'mysql' in postfix_virtual_mailbox_maps) or
       (postfix_virtual_mailbox_domains is defined and 'mysql' in postfix_virtual_mailbox_domains) or
       (postfix_virtual_alias_maps is defined and 'mysql' in postfix_virtual_alias_maps)

   - name: Configure Postfix transport maps
     template:
       src: transport.j2
       dest: /etc/postfix/transport
     notify: Validate transport maps and rebuild database
     when: postfix_transport_maps_template is defined

   - name: Configure Postfix header checks
     template:
       src: header_checks.j2
       dest: /etc/postfix/header_checks
     notify: Validate header checks and reload Postfix
     when: postfix_header_checks_template is defined

   - name: Set values for Postfix main.cf (part 1)
     set_fact:
       postfix_main_cf_smtpd_recipient_restrictions: "{{ postfix_recipient_access | default(omit) }}"
       postfix_main_cf_smtpd_sender_restrictions: "{{ postfix_sender_access | default(omit) }}"

   - name: Set values for Postfix main.cf (part 2)
     set_fact:
       postfix_main_cf_mynetworks: "{{ mynetworks | default(omit) }}"
       postfix_main_cf_mydestination: "{{ mydestination | default(omit) }}"
       postfix_main_cf_relay_domains: "{{ relay_domains | default(omit) }}"
       postfix_main_cf_virtual_mailbox_domains: "{{ virtual_mailbox_domains | default(omit) }}"
       postfix_main_cf_virtual_alias_domains: "{{ virtual_alias_domains | default(omit) }}"

   - name: Configure Postfix main.cf
     template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify: Validate main.cf and restart Postfix

   - name: Configure Postfix master.cf
     template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify: Validate master.cf and restart Postfix

   - name: Create directories for TLS certificates and keys
     file:
       path: "{{ item }}"
       state: directory
     with_items:
       - "{{ postfix_tls_cert_path | dirname }}"
       - "{{ postfix_tls_key_path | dirname }}"
     when: item is defined and item | length > 0

   - name: Deploy Postfix TLS server certificate
     copy:
       src: "{{ postfix_tls_cert_src }}"
       dest: "{{ postfix_tls_cert_path }}"
     notify: Reload Postfix
     when: postfix_tls_cert_src is defined

   - name: Deploy Postfix TLS server key
     copy:
       src: "{{ postfix_tls_key_src }}"
       dest: "{{ postfix_tls_key_path }}"
     notify: Reload Postfix
     when: postfix_tls_key_src is defined

   - name: Flush Postfix handlers
     meta: flush_handlers

   - name: Configure Postfix aliases
     lineinfile:
       path: /etc/aliases
       line: "{{ item.key }}: {{ item.value }}"
     with_dict: "{{ postfix_aliases }}"
     notify: Rebuild alias database and reload Postfix
     when: postfix_aliases is defined

   - name: Configure Postfix sender access
     lineinfile:
       path: /etc/postfix/sender_access
       line: "{{ item.key }} {{ item.value }}"
     with_dict: "{{ postfix_sender_access }}"
     notify: Rebuild sender access database and reload Postfix
     when: postfix_sender_access is defined

   - name: Configure Postfix recipient access
     lineinfile:
       path: /etc/postfix/recipient_access
       line: "{{ item.key }} {{ item.value }}"
     with_dict: "{{ postfix_recipient_access }}"
     notify: Validate recipient access and reload Postfix
     when: postfix_recipient_access is defined

   - name: Place SASL password map
     copy:
       content: "{{ postfix_smtp_sasl_password_map }}"
       dest: /etc/postfix/sasl_passwd
     notify: Rebuild sasl_password_map database
     when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map | length > 0

   - name: Flush Postfix handlers again
     meta: flush_handlers

   - name: Start and enable Postfix service
     service:
       name: postfix
       state: started
       enabled: yes

