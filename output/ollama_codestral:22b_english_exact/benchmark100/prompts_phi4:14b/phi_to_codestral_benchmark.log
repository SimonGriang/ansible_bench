---
   - name: import_assert_tasks
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: wait_for_port
     wait_for:
       port: "{{ bootstrap_port | default(22) }}"
       timeout: "{{ bootstrap_timeout }}"
       state: started
     become: false
     when:
       - bootstrap_wait_for_host | default(true)
       - connection not in ['docker', 'podman', 'kubectl']

   - block:
       - name: test_connection
         ping:

       - name: check_sudo
         command: /usr/bin/sudo -l -v
         changed_when: false
     rescue:
       - name: gather_bootstrap_facts
         setup:
           gather_subset: 'all'

       - name: install_bootstrap_packages
         raw: |
           {% if ansible_facts['os_family'] == 'RedHat' %}
           dnf install -y python3 libselinux-python3
           {% elif ansible_facts['os_family'] == 'Debian' %}
           apt-get update && apt-get install -y python3 sudo
           {% endif %}

   - name: gather_facts
     setup:
     become: false

   - name: install_bootstrap_packages
     package:
       name: "{{ bootstrap_facts_packages }}"
       state: present
       update_cache: yes
     become: "{{ bootstrap_become }}"
     when: bootstrap_facts_packages is defined and bootstrap_facts_packages | length > 0

