---
   - name: Migrate the Java JDK vendor
     set_fact:
       java_jdk_vendor: "temurin"
     when: java_jdk_vendor == "adoptopenjdk"

   - name: Gather OS-specific variables for the Java JDK
     include_vars:
       file: "{{ item }}"
       name: java_jdk_os_vars
     with_first_found:
       - "{{ java_jdk_vendor }}_{{ ansible_os_family | lower }}_{{ ansible_distribution_major_version }}.yml"
       - "{{ java_jdk_vendor }}_{{ ansible_os_family | lower }}.yml"
       - "{{ java_jdk_vendor }}.yml"

   - name: Gather architecture-specific variables for the Java JDK
     include_vars:
       file: "{{ item }}"
       name: java_jdk_arch_vars
     with_first_found:
       - "{{ java_jdk_vendor }}_{{ ansible_architecture }}.yml"
       - "{{ java_jdk_vendor }}.yml"

   - name: Set OS-specific Java variables
     set_fact:
       java_os_specific_vars: "{{ java_jdk_os_vars[ansible_os_family] | default({}) }}"
     when: java_os_specific_vars is not defined or java_os_specific_vars is none

   - name: Set OS and architecture-specific Java variables
     set_fact:
       java_arch_specific_vars: "{{ java_jdk_arch_vars[ansible_architecture] | default({}) }}"
     when: java_arch_specific_vars is not defined or java_arch_specific_vars is none

   - name: Set specific Java variables
     set_fact:
       java_home: "{{ java_os_specific_vars.java_home | default('/usr/lib/jvm/default-java') }}"

   - name: Handle Debian pre-requisites for Java installation
     block:
       - name: Remove deprecated repositories
         apt_repository:
           repo: "{{ item }}"
           state: absent
         loop: "{{ java_os_specific_vars.apt_repos_to_remove }}"

       - name: Install extra packages
         apt:
           name: "{{ java_os_specific_vars.apt_extra_packages }}"
           state: present

       - name: Add key repositories
         apt_key:
           url: "{{ item }}"
           state: present
         loop: "{{ java_os_specific_vars.apt_key_repos }}"

       - name: Add required repositories
         apt_repository:
           repo: "{{ item }}"
           state: present
         loop: "{{ java_os_specific_vars.apt_repos }}"
     when: ansible_os_family == 'Debian'

   - name: Handle RedHat pre-requisites for Java installation
     block:
       - name: Add key repositories
         yum_repository:
           name: "{{ item.name }}"
           description: "{{ item.description }}"
           baseurl: "{{ item.baseurl }}"
           gpgkey: "{{ item.gpgkey }}"
           gpgcheck: yes
         loop: "{{ java_os_specific_vars.yum_repos }}"
     when: ansible_os_family == 'RedHat'

   - name: Install required libraries for Java
     package:
       name: "{{ java_os_specific_vars.required_libraries }}"
       state: present

   - name: Install Java on Debian systems
     apt:
       name: "{{ java_jdk_vendor }}-{{ java_jdk_version }}-jdk"
       state: present
       update_cache: yes
     when: ansible_os_family == 'Debian'

   - name: Install Java on RedHat systems
     yum:
       name: "{{ java_jdk_vendor }}-{{ java_jdk_version }}-openjdk"
       state: present
     when: ansible_os_family == 'RedHat'

   - name: Export Java environment variables
     template:
       src: jdk.sh.j2
       dest: /etc/profile.d/jdk.sh

   - name: Source Java environment variables
     shell: source /etc/profile.d/jdk.sh

   - name: Correct Java version selection for versions less than 11 on Debian systems
     shell: "update-alternatives --set java {{ java_home }}/bin/java"
     when: ansible_os_family == 'Debian' and java_jdk_version | int < 11

   - name: Correct Java version selection for versions 11 or greater on Debian systems
     shell: "update-java-alternatives --set java-1.{{ java_jdk_version }}.0-openjdk-{{ java_jdk_vendor }}"
     when: ansible_os_family == 'Debian' and java_jdk_version | int >= 11

