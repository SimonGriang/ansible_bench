---
   - name: Create document root directories for HTTP virtual hosts
     file:
       path: "{{ item.documentroot }}"
       state: directory
       owner: root
       group: root
       mode: 0755
     loop: "{{ httpd_vhosts | selectattr('documentroot', 'defined') | list }}"
     loop_control:
       label: "{{ item.name }}"
     when:
       - httpd_vhosts is defined
       - item.create_docroot | default(true)

   - name: Configure virtual host configuration files using templates
     template:
       src: "{{ vhost_conf_template }}"
       dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
       owner: root
       group: root
       mode: 0644
     loop: "{{ httpd_vhosts }}"
     loop_control:
       label: "{{ item.name }}"
     notify:
       - Test httpd configuration
       - Restart httpd service

   - name: Enable virtual hosts on Debian-based systems
     command: "a2ensite {{ item.name }}"
     loop: "{{ httpd_vhosts }}"
     loop_control:
       label: "{{ item.name }}"
     when:
       - ansible_os_family == 'Debian'
     notify:
       - Test httpd configuration
       - Restart httpd service

