---
   - name: Task 1 - Install unzip package
     apt:
       name: unzip
       update_cache: "{{ promtail_apt_update_cache }}"

   - name: Task 2 - Create Promtail group
     group:
       name: "{{ promtail_system_group }}"
       state: present
     when: promtail_system_group != 'root'

   - name: Task 3 - Create Promtail user
     user:
       name: "{{ promtail_system_user }}"
       group: "{{ promtail_system_group }}"
       groups: "{{ promtail_user_additional_groups }}"
       shell: /usr/sbin/nologin
       createhome: "{{ promtail_system_user == 'root' }}"

   - name: Task 4 - Ensure /usr/local/bin directory exists
     file:
       path: /usr/local/bin
       state: directory
       mode: '0755'

   - name: Task 5 - Create Promtail configuration directories
     file:
       path: "{{ item }}"
       state: directory
       owner: root
       group: "{{ promtail_system_group }}"
       mode: '0770'
     loop:
       - /etc/promtail
       - /etc/promtail/file_sd
       - /var/lib/promtail/positions

   - name: Task 6 - Create Promtail application directories
     file:
       path: "{{ item }}"
       state: directory
       owner: "{{ promtail_system_user }}"
       group: "{{ promtail_system_group }}"
       mode: '0755'
     loop:
       - "{{ promtail_install_dir }}"

   - name: Task 7 - Check if Promtail binary exists
     stat:
       path: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}"
     register: promtail_binary

   - name: Task 8 - Download Promtail binaries if not present locally
     get_url:
       url: "{{ promtail_dist_url }}"
       dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
       checksum: "{{ promtail_custom_checksum | default(omit) }}"
     when: not promtail_binary.stat.exists

   - name: Task 9 - Propagate a locally distributed Promtail archive
     copy:
       src: "{{ promtail_local_dir }}/promtail-{{ promtail_version }}.tar.gz"
       dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
     when: promtail_local_dir is defined and not promtail_binary.stat.exists

   - name: Task 10 - Download Promtail binaries to the controller node
     delegate_to: localhost
     get_url:
       url: "{{ promtail_dist_url }}"
       dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
       checksum: "{{ promtail_custom_checksum | default(omit) }}"
     when: promtail_binary_propagate
     run_once: true

   - name: Task 11 - Propagate Promtail binaries across nodes
     copy:
       src: "/tmp/promtail-{{ promtail_version }}.tar.gz"
       dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
     when: promtail_binary_propagate

   - name: Task 12 - Unpack the Promtail binaries
     unarchive:
       src: "/tmp/promtail-{{ promtail_version }}.tar.gz"
       dest: "{{ promtail_install_dir }}"
       creates: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}"
       extra_opts:
         - --strip-components=1

   - name: Task 13 - Create a symlink to the latest version of Promtail
     file:
       src: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}"
       dest: /usr/local/bin/promtail
       state: link
     notify: restart promtail

   - name: Task 14 - Write the Promtail configuration file
     template:
       src: promtail.yaml.j2
       dest: /etc/promtail/promtail.yaml
     notify: restart promtail
     register: promtail_config_check
     failed_when: promtail_config_check.failed or 'Configuration OK' not in promtail_config_check.msg

   - name: Task 15 - Create a systemd service unit for Promtail
     template:
       src: promtail.service.j2
       dest: /etc/systemd/system/promtail.service
       mode: '0644'
     notify: restart promtail

