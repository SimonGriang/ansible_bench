           url: "{{ rke2_install_url }}"
           dest: "{{ rke2_bin_dir }}/rke2-install.sh"
           mode: '0755'
           timeout: 60
         retries: 5
         delay: 10
     rescue:
       - name: Copy local checksum and artifacts to remote hosts
         copy:
           src: "{{ item.src }}"
           dest: "{{ item.dest }}"
           mode: '0644'
         loop: "{{ rke2_artifacts }}"

   - name: Copy local RKE2 artifacts if in airgap mode using 'copy' method
     when: rke2_airgap_mode and rke2_airgap_implementation == 'copy'
     copy:
       src: "{{ item.src }}"
       dest: "{{ item.dest }}"
       mode: '0644'
     loop: "{{ rke2_artifacts }}"

   - name: Handle additional tarballs in airgap mode if not using 'exists' implementation
     when: rke2_airgap_mode and rke2_airgap_implementation != 'exists' and rke2_airgap_copy_additional_tarballs | length > 0
     block:
       - name: Create directory for additional tarballs
         file:
           path: "{{ rke2_airgap_tarballs_dir }}"
           state: directory
           mode: '0755'

       - name: Copy additional tarballs to remote hosts
         copy:
           src: "{{ item }}"
           dest: "{{ rke2_airgap_tarballs_dir }}"
           mode: '0644'
         loop: "{{ rke2_airgap_copy_additional_tarballs }}"

   - name: Ensure artifacts exist and have acceptable permissions in airgap mode with 'exists' implementation
     when: rke2_airgap_mode and rke2_airgap_implementation == 'exists'
     block:
       - name: Confirm RKE2 artifacts exist
         stat:
           path: "{{ item.dest }}"
         register: artifact_stat
         loop: "{{ rke2_artifacts }}"
         failed_when: not artifact_stat.stat.exists

       - name: Adjust permissions of RKE2 artifacts
         file:
           path: "{{ item.dest }}"
           mode: '0644'
         loop: "{{ rke2_artifacts }}"

       - name: Confirm RKE2 installation script is executable
         file:
           path: "{{ rke2_bin_dir }}/rke2-install.sh"
           mode: '0755'

   - name: Populate service facts
     service_facts:

   - name: Get filesystem statistics for /usr/local
     stat:
       path: /usr/local
     register: usr_local_stat

   - name: Check if /usr/local is on a separate partition
     set_fact:
       rke2_is_separate_partition: "{{ usr_local_stat.stat.dev != ansible_mounts | selectattr('mount', 'equalto', '/') | list | first | json_query('device') }}"

   - name: Determine RKE2 binary path based on filesystem checks
     set_fact:
       rke2_binary_path: "{{ rke2_is_separate_partition | ternary('/var/lib/rke2/bin/rke2', '/usr/local/bin/rke2') }}"

   - name: Check the installed and running RKE2 versions
     shell: |
       set -o pipefail
       if [ -x "{{ rke2_binary_path }}" ]; then
         installed_version=$("{{ rke2_binary_path }}" --version | awk '/^rke2 version/ {print $3}')
       else
         installed_version=""
       fi
       if systemctl is-active rke2-server.service > /dev/null 2>&1; then
         running_version=$(systemctl status rke2-server.service | awk '/Loaded:/ {print $2}' | awk -F'/' '{print $NF}' | awk -F'.' '{print $1}')
       else
         running_version=""
       fi
       echo "{\"installed_version\": \"$installed_version\", \"running_version\": \"$running_version\"}"
     args:
       executable: /bin/bash
     register: rke2_version_check
     changed_when: false

   - name: Set RKE2 version facts based on the version check results
     when: not ansible_check_mode
     set_fact:
       rke2_installed_version: "{{ (rke2_version_check.stdout | from_json).installed_version }}"
       rke2_running_version: "{{ (rke2_version_check.stdout | from_json).running_version }}"

   - name: Prevent accidental RKE2 downgrade unless explicitly allowed
     assert:
       that:
         - rke2_running_version == rke2_version or allow_rke2_downgrade
       fail_msg: "Attempted to downgrade RKE2 from version '{{ rke2_running_version }}' to '{{ rke2_version }}'"
       success_msg: "RKE2 version is allowed to be '{{ rke2_running_version }}'"

   - name: Run RKE2 install script if the version needs to be updated
     when: rke2_running_version != rke2_version
     block:
       - name: Run RKE2 install script in airgap mode
         when: rke2_airgap_mode
         environment:
           INSTALL_RKE2_TYPE: "{{ rke2_type | default('server') }}"
           INSTALL_RKE2_VERSION: "{{ rke2_version }}"
           INSTALL_RKE2_ARTIFACT_DIR: "{{ rke2_artifact_dir }}"
         script: "{{ rke2_bin_dir }}/rke2-install.sh"

       - name: Run RKE2 install script in non-airgap mode
         when: not rke2_airgap_mode
         environment:
           INSTALL_RKE2_TYPE: "{{ rke2_type | default('server') }}"
           INSTALL_RKE2_VERSION: "{{ rke2_version }}"
         script: "{{ rke2_bin_dir }}/rke2-install.sh"

   - name: Copy custom manifests if they are defined
     when: rke2_manifests_dir is defined and rke2_manifests_dir
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_manifests_dir }}"
       mode: '0644'
     loop: "{{ rke2_custom_manifests }}"

   - name: Copy static pods if they are defined
     when: rke2_static_pods_dir is defined and rke2_static_pods_dir
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_static_pods_dir }}"
       mode: '0644'
     loop: "{{ rke2_static_pods }}"

   - name: Copy RKE2 environment file if environment options are defined
     when: rke2_environment_options is defined and rke2_environment_options
     copy:
       content: |
         {% for key, value in rke2_environment_options.items() %}
         {{ key }}={{ value }}
         {% endfor %}
       dest: "{{ rke2_environment_file }}"
       mode: '0644'

