---
   - name: Set package state
     set_fact:
       ansible_package_state: "{{ 'present' if ansible_install_method == 'package' else 'absent' }}"

   - name: Setup Ansible on RedHat systems (excluding Fedora)
     become: yes
     yum:
       name: ansible
       state: "{{ ansible_package_state }}"
     when:
       - ansible_install_method == 'package'
       - ansible_os_family == 'RedHat'
       - ansible_distribution != 'Fedora'

   - name: Setup Ansible on Fedora
     become: yes
     dnf:
       name: ansible
       state: "{{ ansible_package_state }}"
     when:
       - ansible_install_method == 'package'
       - ansible_distribution == 'Fedora'

   - name: Setup Ansible on Ubuntu
     become: yes
     apt:
       name: ansible
       state: "{{ ansible_package_state }}"
     when:
       - ansible_install_method == 'package'
       - ansible_distribution == 'Ubuntu'

   - name: Setup Ansible on Debian
     become: yes
     apt:
       name: ansible
       state: "{{ ansible_package_state }}"
     when:
       - ansible_install_method == 'package'
       - ansible_distribution == 'Debian'

   - name: Setup Ansible using Pip
     become: yes
     pip:
       name: ansible
       state: "{{ ansible_package_state }}"
     when: ansible_install_method == 'pip'

