 - name: Check if Java certificates exist
     stat:
       path: "{{ item }}"
     loop: "{{ java_certificates }}"
     register: cert_check

   - name: Fail if any Java certificate is missing
     fail:
       msg: "Java certificate {{ item.item }} is missing"
     when: not item.stat.exists
     loop: "{{ cert_check.results }}"
     loop_control:
       label: "{{ item.item }}"

   - name: Set keystore directory variables for Java < 11
     set_fact:
       keystore_dir: "/usr/lib/jvm/java-{{ java_version }}-openjdk/lib/security"
     when: java_version is version('11', '<')

   - name: Set keystore directory variables for Java >= 11
     set_fact:
       keystore_dir: "/usr/lib/jvm/java-{{ java_version }}-openjdk/lib/security/cacerts"
     when: java_version is version('11', '>=')

   - name: Import SSL certificates into the Java keystore
     java_cert:
       cert_path: "{{ item }}"
       keystore_path: "{{ keystore_dir }}/cacerts"
       keystore_pass: changeit
       state: present
     loop: "{{ java_certificates }}"

