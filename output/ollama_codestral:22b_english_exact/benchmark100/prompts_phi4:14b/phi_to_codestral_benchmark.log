 - name: Create the RKE2 configuration directory
      file:
        path: /etc/rancher/rke2
        state: directory
        owner: root
        group: root
        mode: 0755

    - name: Set server-specific node taints
      set_fact:
        rke2_server_node_taints: "{{ rke2_server_node_taints }}"
      when: rke2_type == 'server'

    - name: Template the RKE2 configuration file
      template:
        src: "{{ rke2_config }}"
        dest: /etc/rancher/rke2/config.yaml
        owner: root
        group: root
        mode: 0600
      notify: Config file changed

    - name: Template the kubelet configuration file
      template:
        src: templates/kubelet-config.yaml.j2
        dest: /etc/rancher/rke2/kubelet-config.yaml
        owner: root
        group: root
        mode: 0600
      when: rke2_kubelet_config | length > 0
      notify: Config file changed

    - name: Configure Containerd registry settings
      copy:
        src: "{{ rke2_custom_registry_path }}"
        dest: /etc/rancher/rke2/registries.yaml
        owner: root
        group: root
        mode: 0600
      when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)
      notify: Config file changed

    - name: Determine if an etcd restore from a file is necessary
      set_fact:
        do_etcd_restore: true
      when: rke2_etcd_snapshot_name and ((ansible_facts['services']['rke2-server'] is not defined) or (ansible_facts['services']['rke2-server']['state'] != 'running'))

    - name: Determine if an etcd restore from S3 is necessary
      set_fact:
        do_etcd_restore_from_s3: true
      when: rke2_etcd_snapshot_name and (rke2_etcd_s3_access_key | length > 0) and (rke2_etcd_s3_secret_key | length > 0) and (rke2_etcd_s3_bucket | length > 0)

    - name: Restore etcd from a snapshot file
      block:
        - name: Create the snapshot directory
          file:
            path: "{{ rke2_data_dir }}/db/snapshots"
            state: directory
            owner: root
            group: root
            mode: 0755

        - name: Copy the snapshot file
          copy:
            src: "{{ rke2_etcd_snapshot_url }}"
            dest: "{{ rke2_data_dir }}/db/snapshots/{{ rke2_etcd_snapshot_name }}"
            owner: root
            group: root
            mode: 0644

        - name: Restore etcd from the snapshot
          command:
            cmd: "rke2 server --config /etc/rancher/rke2/config.yaml --data-dir {{ rke2_data_dir }} --etcd-snapshot-restore-name {{ rke2_etcd_snapshot_name }}"
          register: etcd_restore_output
          changed_when: etcd_restore_output.rc != 0
      when: do_etcd_restore

    - name: Restore etcd from an S3 snapshot
      command:
        cmd: "rke2 server --config /etc/rancher/rke2/config.yaml --data-dir {{ rke2_data_dir }} --etcd-snapshot-restore-name {{ rke2_etcd_snapshot_name }} --etcd-s3 --etcd-s3-bucket {{ rke2_etcd_s3_bucket }} --etcd-s3-endpoint {{ rke2_etcd_s3_endpoint }}"
      environment:
        AWS_ACCESS_KEY_ID: "{{ rke2_etcd_s3_access_key }}"
        AWS_SECRET_ACCESS_KEY: "{{ rke2_etcd_s3_secret_key }}"
      register: etcd_restore_output
      changed_when: etcd_restore_output.rc != 0
      when: do_etcd_restore_from_s3

    - name: Start the RKE2 server service
      systemd:
        name: rke2-server.service
        state: started
        enabled: yes
        daemon_reload: yes
        no_block: yes
      environment:
        RKE2_TOKEN: "{{ rke2_token }}"
      notify: Service (re)started

    - name: Mask the RKE2 agent service
      systemd:
        name: rke2-agent.service
        state: stopped
        enabled: no
        masked: yes

    - name: Wait for the first server to be ready without CNI
      command: kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.reason=="KubeletReady")].status}'
      register: server_status
      until: server_status.stdout == 'True'
      retries: 100
      delay: 15
      when: rke2_cni == 'none'

    - name: Wait for the first server to be ready with CNI
      command: kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
      register: server_status
      until: server_status.stdout == 'True'
      retries: 40
      delay: 15
      when: rke2_cni != 'none'

    - name: Clean up old nodes and secrets if restoring etcd
      block:
        - name: Retrieve registered node names
          command: kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o jsonpath='{.items[*].metadata.name}'
          register: node_names_output

        - name: Identify nodes no longer present
          set_fact:
            nodes_to_delete: "{{ ansible_play_hosts | difference(node_names_output.stdout.split(' ')) }}"

        - name: Delete associated secrets and nodes
          command: "{{ item }}"
          with_items:
            - "kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete secret --field-selector=node.kubernetes.io/instance-type=etcd {{ node_names_output.stdout | replace(' ', ' --field-selector=node.kubernetes.io/instance-type=etcd ') }}"
            - "kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete node {{ nodes_to_delete | join(' ') }}"
          when: nodes_to_delete | length > 0
      when: do_etcd_restore or do_etcd_restore_from_s3

    - name: Set the active server variable
      set_fact:
        active_server: "{{ inventory_hostname }}"
      delegate_to: "{{ item }}"
      delegate_facts: true
      with_items: "{{ groups[rke2_cluster_group_name] }}"

