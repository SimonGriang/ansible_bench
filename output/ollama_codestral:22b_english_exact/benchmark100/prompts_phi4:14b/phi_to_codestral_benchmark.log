   - name: Import tasks from assert.yml
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install Python pip
     package:
       name: "{{ python_pip_packages }}"

   - name: Configure pip proxy settings
     ini_file:
       path: /etc/pip.conf
       section: global
       option: index-url
       value: "{{ python_pip_proxy | default('') }}"
     when: python_pip_proxy is defined

   - name: Configure trusted hosts for pip
     ini_file:
       path: /etc/pip.conf
       section: global
       option: trusted-host
       value: "{{ python_pip_trusted_host | default('') }}"
     when: python_pip_trusted_host is defined

   - name: Update pip to the latest version
     pip:
       name: "{{ python_pip_pip_package }}"
       state: "{{ python_pip_pip_state }}"
       executable: "{{ python_pip_executable }}"
     when: >
       python_pip_update and
       ansible_distribution_release not in ['bookworm', 'noble'] and
       ansible_os_family != 'Alpine'

   - name: Install requested Python modules
     pip:
       name: "{{ python_pip_modules }}"
       state: "{{ item.state | default('present') }}"
       version: "{{ item.version | default(omit) }}"
       executable: "{{ python_pip_executable }}"
     loop: "{{ python_pip_modules }}"
     when: >
       ansible_distribution_release not in ['bookworm', 'noble'] and
       ansible_os_family != 'Alpine'

