---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install bash
     package:
       name: bash
       state: present

   - name: Install OpenJDK
     package:
       name: "{{ java_openjdk_package }}"
       state: present
     environment:
       JAVA_HOME: "/usr/lib/jvm/{{ java_openjdk_package }}"
     when: java_vendor == "openjdk"

   - name: Copy and install Oracle Java RPM package
     block:
       - name: Copy Oracle Java RPM package
         copy:
           src: "{{ java_oracle_rpm_package }}"
           dest: /tmp
       - name: Install Oracle Java RPM package
         package:
           name: /tmp/{{ java_oracle_rpm_package }}
           state: present
     when: java_source == "local" and java_format == "RPM"

   - name: Copy and install Oracle Java DEB package
     block:
       - name: Copy Oracle Java DEB package
         copy:
           src: "{{ java_oracle_deb_package }}"
           dest: /tmp
       - name: Install Oracle Java DEB package
         apt:
           deb: /tmp/{{ java_oracle_deb_package }}
           state: present
     when: java_source == "local" and java_format == "DEB"

   - name: Install Oracle Java RPM package from repository
     package:
       name: "{{ java_oracle_package }}"
       state: present
     when: java_source == "repository" and java_format == "RPM"

   - name: Install Oracle Java tarball
     block:
       - name: Ensure installation directory exists
         file:
           path: "{{ java_install_dir }}"
           state: directory
       - name: Extract Oracle Java tarball
         unarchive:
           src: "{{ java_oracle_tarball }}"
           dest: "{{ java_install_dir }}"
         notify: Set java permissions
     when: java_format == "targz" and java_vendor == "Oracle"

   - name: Install Oracle JCE policy software
     unarchive:
       src: "{{ java_jce_zip }}"
       dest: "{{ java_install_dir }}/jre/lib/security"
     when: java_version == 8 and java_jce_enabled and java_vendor == "Oracle"

   - name: Set Java as default alternative
     alternatives:
       name: java
       path: "{{ java_install_dir }}/bin/java"
       link: /usr/bin/java
     when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "Oracle"

   - name: Determine JAVA_HOME directory
     shell: |
       set -o pipefail
       /usr/bin/readlink -f /usr/bin/java | sed "s:bin/java::"
     register: java_home
     changed_when: false

   - name: Set JAVA_HOME environment variable
     lineinfile:
       path: /etc/profile.d/java_home.sh
       line: 'export JAVA_HOME="{{ java_home.stdout }}"'
       create: true
       mode: 0644

   - name: Flush handlers
     meta: flush_handlers

   - name: Set java permissions
     file:
       path: "{{ java_install_dir }}"
       state: directory
       owner: root
       group: root
       recurse: yes
     when: java_format == "targz" and java_vendor == "Oracle"

