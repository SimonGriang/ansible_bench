   - name: Install MySQL packages
     package:
       name: "{{ mysql_packages }}"
     notify:
       - Set root password
       - Restart system daemon

   - name: Configure the MySQL server configuration file
     template:
       src: my.cnf.j2
       dest: /etc/mysql/my.cnf
       owner: root
       group: root
       mode: 0644
     notify:
       - Restart MySQL server

   - name: Configure the MySQL client configuration file
     lineinfile:
       dest: /etc/mysql/mysql.conf.d/mysqldump.cnf
       regexp: '^socket='
       line: "socket={{ mysql_socket }}"

   - name: Initialize the MySQL database if on Alpine or Archlinux
     command: mysql_install_db --user=mysql --datadir=/var/lib/mysql
     args:
       creates: /var/lib/mysql
     when: ansible_os_family == 'Alpine' or ansible_os_family == 'Archlinux'

   - name: Start and enable the MySQL service
     service:
       name: mysql
       state: started
       enabled: true

   - name: Flush handlers to apply previous changes
     meta: flush_handlers

   - name: Place the my.cnf configuration file
     template:
       src: my.cnf.j2
       dest: /root/.my.cnf
       owner: root
       group: root
       mode: 0600

   - name: Create MySQL databases
     mysql_db:
       name: "{{ item.name }}"
       state: present
       login_unix_socket: "{{ mysql_socket }}"
       no_log: true
     with_items: "{{ mysql_databases }}"
     when: item.import is undefined

   - name: List current MySQL databases
     shell: >
       mysql --defaults-file=/root/.my.cnf -NBe
       'show databases'
     register: mysql_db_list
     no_log: true

   - name: Import databases if initial import is defined and not already present
     mysql_db:
       name: "{{ item.name }}"
       state: import
       target: "{{ item.import }}"
       login_unix_socket: "{{ mysql_socket }}"
       no_log: true
     with_items: "{{ mysql_databases }}"
     when: item.import is defined and item.name not in mysql_db_list.stdout_lines

   - name: Create MySQL users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       host: "{{ item.host | default('localhost') }}"
       state: present
       login_unix_socket: "{{ mysql_socket }}"
       no_log: true
     with_items: "{{ mysql_users }}"

   - name: Flush handlers again to apply user creation changes
     meta: flush_handlers

