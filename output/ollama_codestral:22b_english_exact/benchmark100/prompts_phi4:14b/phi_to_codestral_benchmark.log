---
   - name: Import assert.yml
     ansible.builtin.import_tasks: assert.yml
     delegate_to: localhost

   - name: Configure apk package manager
     when: ansible_pkg_mgr == 'apk'
     block:
       - name: Update apk package cache
         ansible.builtin.apk:
           update_cache: true
         changed_when: false
       - name: Upgrade all software
         ansible.builtin.apk:
           upgrade: true
         notify: Reboot

   - name: Configure apt package manager
     when: ansible_pkg_mgr == 'apt'
     block:
       - name: Hold selected packages
         ansible.builtin.dpkg_selections:
           name: "{{ item }}"
           selection: hold
         loop: "{{ apt_hold_packages | default([]) }}"
       - name: Update and upgrade all software
         ansible.builtin.apt:
           update_cache: true
           upgrade: dist
           env: "{{ apt_env_vars | default({}) }}"
         notify: Reboot
       - name: Perform autoremove
         when: apt_perform_autoremove | bool
         ansible.builtin.apt:
           autoremove: true
         notify: Reboot

   - name: Update all software using dnf package manager
     when: ansible_pkg_mgr in ['dnf', 'dnf5']
     block:
       - name: Update all software
         ansible.builtin.dnf:
           name: "*"
           state: latest
           exclude: "{{ dnf_exclude_packages | default([]) }}"
         notify: Reboot

   - name: Update all software using pacman package manager
     when: ansible_pkg_mgr == 'pacman'
     block:
       - name: Update pacman package cache
         ansible.builtin.pacman:
           update_cache: true
       - name: Upgrade all software
         ansible.builtin.pacman:
           upgrade: true
         notify: Reboot

   - name: Configure yum package manager
     when: ansible_pkg_mgr == 'yum'
     block:
       - name: Update all software (yum version 6)
         when: ansible_distribution_major_version == '6'
         ansible.builtin.yum:
           name: "*"
           state: latest
         notify: Reboot
       - name: Update all software and install yum-utils
         when: ansible_distribution_major_version != '6'
         block:
           - name: Update all software
             ansible.builtin.yum:
               name: "*"
               state: latest
             notify: Reboot
           - name: Install yum-utils
             ansible.builtin.yum:
               name: yum-utils
               state: present

   - name: Update all software using zypper package manager
     when: ansible_pkg_mgr == 'zypper'
     block:
       - name: Update all software
         community.general.zypper:
           name: "*"
           state: latest
         notify: Reboot


