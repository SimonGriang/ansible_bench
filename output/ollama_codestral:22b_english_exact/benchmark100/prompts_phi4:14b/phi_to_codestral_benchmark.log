---
   - name: Import assert.yml
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install required software packages
     package:
       name: "{{ users_requirements }}"
       state: present
     when: users_requirements | length > 0

   - name: Include tasks for each group in users_groups
     include_tasks: group.yml
     loop: "{{ users_groups }}"
     loop_control:
       loop_var: group

   - name: Ensure /etc/sudoers includes /etc/sudoers.d directory
     lineinfile:
       path: /etc/sudoers
       line: '#includedir /etc/sudoers.d'
       regexp: '^#includedir\s+/etc/sudoers.d$'
       validate: 'visudo -csf %s'

   - name: Include tasks for each user in users
     include_tasks: user.yml
     loop: "{{ users }}"
     loop_control:
       loop_var: user

   - name: Manage cron permissions with template
     template:
       src: cron.allow.j2
       dest: /etc/cron.allow
       mode: '0644'
     when: users_cron_allow | bool

   - name: Remove /etc/cron.allow if cron permissions are not required
     file:
       path: /etc/cron.allow
       state: absent
     when: not users_cron_allow | bool

