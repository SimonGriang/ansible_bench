   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
       state: present

   - name: Configure mysql server
     lineinfile:
       path: /etc/mysql/my.cnf
       regexp: "^{{ item.key }} ="
       line: "{{ item.key }} = {{ item.value }}"
     with_dict: "{{ mysql_configuration_options }}"

   - name: Configure mysql client
     lineinfile:
       path: /etc/mysql/mysql.conf.d/mysqld.cnf
       regexp: "^socket ="
       line: "socket = /var/run/mysqld/mysqld.sock"

   - name: Initialize mysql
     command: mysql_install_db
     when: ansible_os_family == 'Alpine' or ansible_os_family == 'Archlinux'

   - name: Start and enable mysql
     service:
       name: mysql
       state: started
       enabled: yes

   - name: Place my.cnf
     copy:
       src: my.cnf
       dest: /etc/mysql/my.cnf
       mode: '0644'

   - name: Create databases
     mysql_db:
       name: "{{ item.name }}"
       state: present
     with_items: "{{ mysql_databases }}"
     when: not item.initial_import

   - name: List databases
     command: mysql -e "SHOW DATABASES;"
     register: mysql_databases_list

   - name: Import database
     mysql_db:
       name: "{{ item.name }}"
       state: import
       target: "{{ item.source }}"
     with_items: "{{ mysql_databases }}"
     when: item.initial_import and item.name not in mysql_databases_list.stdout

