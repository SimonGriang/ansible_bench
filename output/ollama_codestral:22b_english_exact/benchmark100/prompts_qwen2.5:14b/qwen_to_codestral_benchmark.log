---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install requirements
     package:
       name: bash
       state: present

   - name: Install openjdk java (package)
     package:
       name: openjdk
       state: present
     when: java_vendor == "openjdk"

   - name: Install RPM
     yum:
       name: /path/to/oracle-java.rpm
       state: present

   - name: Install DEB
     apt:
       deb: /path/to/oracle-java.deb
       state: present

   - name: Install oracle java (rpm) (repository)
     yum:
       name: oracle-java
       state: present

   - name: Configure oracle targz
     unarchive:
       src: /path/to/oracle-java.targz
       dest: /path/to/installation/directory
       creates: /path/to/installation/directory

   - name: Install oracle java policy software (targz)
     unarchive:
       src: /path/to/oracle-java-jce-policy.targz
       dest: /path/to/installation/directory/lib/security

   - name: Set alternative (targz)
     alternatives:
       name: java
       link: /usr/bin/java
       path: /path/to/installation/directory/bin/java
     when: ansible_os_family != "Alpine"

   - name: Find JAVA_HOME
     shell: |
       set -o pipefail
       readlink -f /usr/bin/java | sed "s:bin/java::"
     args:
       executable: /bin/bash
     register: java_home_path
     changed_when: false

   - name: Set JAVA_HOME in /etc/environment
     lineinfile:
       path: /etc/environment
       line: 'JAVA_HOME={{ java_home_path.stdout }}'
       regexp: '^JAVA_HOME='
       state: present
   

