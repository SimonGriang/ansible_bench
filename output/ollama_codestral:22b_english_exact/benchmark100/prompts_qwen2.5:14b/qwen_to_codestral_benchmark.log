     import_tasks: assert.yml

   - name: Install dns
     package:
       name: "{{ dns_packages }}"
       state: present

   - name: Create directories
     file:
       path: "{{ item.path }}"
       state: directory
       mode: "{{ item.mode }}"
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
     loop: "{{ dns_directories }}"

   - name: Create group
     group:
       name: "{{ dns_group }}"
       system: yes

   - name: Create user
     user:
       name: "{{ dns_user }}"
       system: yes
       group: "{{ dns_group }}"
       shell: /sbin/nologin
       home: "{{ dns_data_directory }}"
       createhome: no

   - name: Generate rndc key
     shell: |
       rndc-confgen -a -r /dev/urandom -k {{ dns_data_directory }}/rndc.key -c {{ dns_data_directory }}/rndc.conf
     args:
       creates: "{{ dns_data_directory }}/rndc.key"

   - name: Set permissions on rndc key file
     file:
       path: "{{ dns_data_directory }}/rndc.key"
       mode: '0644'
       owner: "{{ dns_user }}"
       group: "{{ dns_group }}"

   - name: Get the hints/root file
     get_url:
       url: "{{ root_hints_url }}"
       dest: "{{ dns_data_directory }}/root.hints"
       owner: "{{ dns_user }}"
       group: "{{ dns_group }}"
       mode: '0644'

   - name: Create zone file
     template:
       src: zone.j2
       dest: "{{ dns_data_directory }}/{{ item }}.zone"
       owner: "{{ dns_user }}"
       group: "{{ dns_group }}"
       mode: '0644'
     loop: "{{ dns_zones }}"

   - name: Add zones to configuration
     template:
       src: named.conf.j2
       dest: "{{ dns_conf_directory }}/named.conf"
       owner: "{{ dns_user }}"
       group: "{{ dns_group }}"
       mode: '0644'
     notify: restart dns

   - name: Place systemd override
     template:
       src: dns.service.j2
       dest: "/etc/systemd/system/dns.service.d/override.conf"
     notify: restart dns

   - name: Start and enable dns
     service:
       name: dns
       state: started
       enabled: yes
   

