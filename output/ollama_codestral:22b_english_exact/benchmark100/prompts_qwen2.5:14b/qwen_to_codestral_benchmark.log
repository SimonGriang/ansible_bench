---
- name: assert
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: install php
  package:
    name: "{{ php_packages }}"
    state: present

- name: find used php.ini
  shell: "php -i | grep 'Loaded Configuration File' | awk '{print $4}'"
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
  notify: restart httpd


