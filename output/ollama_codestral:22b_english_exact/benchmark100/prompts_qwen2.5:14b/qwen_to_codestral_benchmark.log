 - name: Check if system is EFI
     stat:
       path: /sys/firmware/efi/efivars
     register: efi_vars

   - name: Remove grub.cfg if system is EFI
     file:
       path: /boot/grub2/grub.cfg
       state: absent
     when: efi_vars.stat.isdir is defined and efi_vars.stat.isdir

   - name: Install GRUB user template
     copy:
       src: 01_users
       dest: /etc/grub.d/01_users
       owner: root
       group: root
       mode: '0700'
     notify: update grub

   - name: Add password to EFI GRUB configuration
     lineinfile:
       path: /etc/grub2-efi.cfg
       line: 'set superusers="root"'
       insertafter: '^set timeout'
     notify: update grub

   - name: Add password to MBR GRUB configuration
     lineinfile:
       path: /etc/grub2.cfg
       line: 'set superusers="root"'
       insertafter: '^set timeout'
     notify: update grub

   - name: Add --unrestricted option to specified files
     replace:
       path: "{{ item }}"
       regexp: '(CLASS="[^"]*)"'
       replace: '\1 --unrestricted"'
     with_items: "{{ grub_password_unrestricted_files }}"
     when: grub_password_unrestricted | bool
     notify: update grub

   - name: Update GRUB
     command: grub2-mkconfig -o /boot/grub2/grub.cfg
     when: efi_vars.stat.isdir is defined and efi_vars.stat.isdir or grub_password_unrestricted | bool

Note: The 'update grub' tasks are handler tasks which means they are called when the respective tasks that notify the handler have made changes to the system. This prevents unnecessary runs of the grub2-mkconfig command.

