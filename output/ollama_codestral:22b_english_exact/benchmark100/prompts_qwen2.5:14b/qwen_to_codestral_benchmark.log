     loop:
       - "{{ cadvisor_install_dir }}"
       - "{{ cadvisor_bin_dir }}"

   - name: cadvisor | download
     get_url:
       url: "{{ cadvisor_download_url }}"
       dest: "{{ cadvisor_bin_dir }}/cadvisor"
       owner: "{{ cadvisor_user }}"
       group: "{{ cadvisor_group }}"
       mode: 0755
