- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_binary

- name: Check Helm version
  command: /usr/local/bin/helm version --short
  register: helm_version_output
  when: helm_binary.stat.exists
  changed_when: false

- name: Download helm
  get_url:
    url: "https://get.helm.sh/helm-v{{ helm_version }}-linux-amd64.tar.gz"
    dest: "/tmp/helm-v{{ helm_version }}-linux-amd64.tar.gz"
  when: >
    not helm_binary.stat.exists or
    (helm_version_output is defined and helm_version not in helm_version_output.stdout)

- name: Copy helm binary into place
  copy:
    src: "/tmp/helm-v{{ helm_version }}-linux-amd64/linux-amd64/helm"
    dest: "/usr/local/bin/helm"
    mode: '0755'
  when: >
    not helm_binary.stat.exists or
    (helm_version_output is defined and helm_version not in helm_version_output.stdout)


