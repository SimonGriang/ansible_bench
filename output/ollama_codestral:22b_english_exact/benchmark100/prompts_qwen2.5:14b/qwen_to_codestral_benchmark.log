---
   - name: Create RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: server_type == 'server'

   - name: Copy RKE2 configuration file
     template:
       src: config.yaml.j2
       dest: /etc/rancher/rke2/config.yaml
     notify: Config file changed

   - name: Copy kubelet configuration file
     template:
       src: kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
     when: rke2_kubelet_config | length > 0
     notify: Config file changed

   - name: Copy Containerd Registry Configuration file
     template:
       src: registries.yaml.j2
       dest: /etc/rancher/rke2/registries.yaml
     when:
       - rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
     notify: Config file changed

   - name: Register if we need to do a etcd restore from file
     set_fact:
       do_etcd_restore: true
     when:
       - rke2_etcd_snapshot_file | length > 0
       - >
         (services['rke2-server.service'] is not defined
         or services['rke2-server.service']['state'] != 'started')

   - name: Register if we need to do a etcd restore from s3
     set_fact:
       do_etcd_restore_from_s3: true
     when:
       - rke2_etcd_snapshot_file | length > 0
       - rke2_etcd_snapshot_s3_options.access_key is defined
       - rke2_etcd_snapshot_s3_options.secret_key is defined
       - rke2_etcd_snapshot_s3_options.bucket is defined
       - rke2_etcd_snapshot_s3_options.snapshot_name is defined

   - name: Restore etcd from file
     block:
       - file:
           path: /var/lib/rancher/rke2/server/db/snapshots
           state: directory
       - copy:
           src: "{{ rke2_etcd_snapshot_file }}"
           dest: /var/lib/rancher/rke2/server/db/snapshots/snapshot.db
       - shell: >
           /var/lib/rancher/rke2/bin/kube-rke2-server etcd
           --config=/var/lib/rancher/rke2/server/config.yaml
           --snapshot-restore
           --snapshot-restore-wait-time=5m
     when: do_etcd_restore is defined

   - name: Restore etcd from s3
     shell: >
       /var/lib/rancher/rke2/bin/kube-rke2-server etcd
       --config=/var/lib/rancher/rke2/server/config.yaml
       --snapshot-restore-from-s3
       --etcd-s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }}
       --etcd-s3-key={{ rke2_etcd_snapshot_s3_options.snapshot_name }}
       --etcd-s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }}
       --etcd-s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }}
       --etcd-s3-endpoint={{ rke2_etcd_snapshot_s3_options.endpoint_url }}
       --etcd-s3-insecure-skip-tls-verify={{ rke2_etcd_snapshot_s3_options.insecure_skip_tls_verify | default(false) }}
       --snapshot-restore-wait-time=5m
     when: do_etcd_restore_from_s3 is defined

   - name: Start RKE2 service on the first server
     systemd:
       name: rke2-server.service
       state: started
       enabled: yes
       daemon_reload: yes
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     when: inventory_hostname == groups[rke2_cluster_group_name][0]

   - name: Mask RKE2 agent service on the first server
     systemd:
       name: rke2-agent.service
       state: stopped
       enabled: no
       masked: yes
     when: inventory_hostname == groups[rke2_cluster_group_name][0]

   - name: Wait for the first server be ready - no CNI
     shell: >
       /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
       get nodes {{ inventory_hostname }}
       -o=jsonpath='{.status.conditions[?(@.type==\"Ready\")].status}'
     register: first_server_ready
     until: first_server_ready.stdout == 'True'
     retries: 10
     delay: 6
     when: inventory_hostname == groups[rke2_cluster_group_name][0]

   - name: Wait for the first server be ready - with CNI
     shell: >
       /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
       get nodes {{ inventory_hostname }}
       -o=jsonpath='{.status.conditions[?(@.type==\"Ready\")].status}'
       | grep -q True
       &&
       /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
       get nodes {{ inventory_hostname }}
       -o=jsonpath='{.status.conditions[?(@.type==\"NetworkUnavailable\")].status}'
       | grep -q False
     register: first_server_ready
     until: first_server_ready.rc == 0
     retries: 10
     delay: 6
     when: inventory_hostname == groups[rke2_cluster_group_name][0]

   - name: Restore etcd
     block:
       - shell: >
           /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
           get secrets -n kube-system
           | grep 'rke2-etcd-snapshot'
           | awk '{print $1}'
         register: etcd_secrets

       - shell: >
           /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
           delete secrets {{ item }} -n kube-system
         with_items: "{{ etcd_secrets.stdout_lines }}"

       - shell: >
           /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
           get nodes
           | grep -v 'name:'
           | awk '{print $1}'
         register: k8s_nodes

       - shell: >
           /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
           delete nodes {{ item }}
         with_items: "{{ k8s_nodes.stdout_lines }}"
     when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

   - name: Set an Active Server variable
     set_fact:
       active_server: "{{ inventory_hostname }}"
     with_items: "{{ groups[rke2_cluster_group_name] }}"

   - name: Add a newline at the end of the file
     lineinfile:
       path: "{{ ansible_playbook_python }}"
       line: ""
       state: present
       insertafter: EOF


