---
   - name: Create RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory
       mode: '0755'

   - name: Set server taints
     shell: >
       kubectl taint nodes {{ ansible_hostname }}
       node-role.kubernetes.io/server=true:NoSchedule
       --overwrite
     when: rke2_type == 'server'

   - name: Set agent taints
     shell: >
       kubectl taint nodes {{ ansible_hostname }}
       node-role.kubernetes.io/agent=true:NoSchedule
       --overwrite
     when: rke2_type == 'agent'

   - name: Copy RKE2 config file
     copy:
       src: config.yaml
       dest: /etc/rancher/rke2/config.yaml
     notify: Restart RKE2 service

   - name: Copy kubelet config file
     copy:
       src: kubelet-config.yaml
       dest: /etc/rancher/rke2/kubelet-config.yaml
     notify: Restart RKE2 service
     when: >
       kubelet_config_content is defined
       and kubelet_config_content | length > 0

   - name: Copy Containerd Registry Configuration file
     copy:
       src: registries.yaml
       dest: /etc/rancher/rke2/registries.yaml
     notify: Restart RKE2 service
     when: >
       registries_config is defined
       and registries_config | length > 0

   - name: Start RKE2 service
     systemd:
       name: rke2-server.service
       state: started
       enabled: yes
     notify: Restart RKE2 service
     register: result
     until: result is not failed
     retries: 5
     delay: 10

   - name: Mask other RKE2 services
     systemd:
       name: "{{ item }}"
       masked: yes
     loop:
       - rke2-agent.service
       - rke2-agent.socket
     when: rke2_type != 'server'

   - name: Wait for remaining nodes to be ready - no CNI
     shell: >
       kubectl wait --for=condition=Ready nodes --all
       --timeout=600s
       --field-selector=metadata.name!={{ ansible_hostname }}
     register: result
     until: result.rc == 0
     retries: 10
     delay: 10
     when: >
       rke2_cni_plugin is not defined
       or rke2_cni_plugin == ''

   - name: Wait for remaining nodes to be ready - with CNI
     shell: >
       kubectl wait --for=condition=Ready -n kube-system pods --all
       --timeout=600s
       --field-selector=status.phase!=Succeeded
     register: result
     until: result.rc == 0
     retries: 10
     delay: 10
     when: >
       rke2_cni_plugin is defined
       and rke2_cni_plugin != ''



