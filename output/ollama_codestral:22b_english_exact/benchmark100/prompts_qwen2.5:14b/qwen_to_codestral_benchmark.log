---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Configure apk
     block:
       - apk:
           update_cache: yes
           upgrade: yes
         notify: reboot

   - name: Configure apt
     block:
       - dpkg_selections:
           name: "{{ apt_exclude_packages }}"
           selection: hold
       - apt:
           update_cache: yes
           upgrade: safe
           autoremove: yes
         notify: reboot

   - name: Update all software (dnf)
     block:
       - dnf:
           name: '*'
           exclude: "{{ dnf_exclude_packages }}"
           state: latest
         notify: reboot

   - name: Update all software (pacman)
     block:
       - pacman:
           update_cache: yes
           upgrade: yes
         notify: reboot

   - name: Configure yum
     block:
       - yum:
           name: yum-utils
           state: present
         when: ansible_pkg_mgr == 'yum'
       - yum:
           name: '*'
           state: latest
         notify: reboot

   - name: Update all software (zypper)
     block:
       - zypper:
           name: '*'
           state: latest
         notify: reboot


