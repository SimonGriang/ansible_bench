 - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install requirements
     package:
       name: bash
       state: present

   - name: Install openjdk java (package)
     package:
       name: openjdk
       state: present
     when: java_vendor == "openjdk"

   - name: Install RPM
     yum:
       name: "/path/to/local/oracle-java.rpm"
       state: present

   - name: Install DEB
     apt:
       deb: "/path/to/local/oracle-java.deb"
       state: present

   - name: Install oracle java (rpm) (repository)
     yum:
       name: oracle-java
       state: present

   - name: Configure oracle targz
     unarchive:
       src: "/path/to/local/oracle-java.targz"
       dest: "/opt/"
       remote_src: yes
     file:
       path: "/opt/java"
       state: directory

   - name: Install oracle java policy software (targz)
     copy:
       src: "/path/to/local/jce_policy-8.zip"
       dest: "/opt/java/jre/lib/security/"

   - name: Set alternative (targz)
     alternatives:
       name: java
       link: /usr/bin/java
       path: /opt/java/bin/java
     when: ansible_os_family != "Alpine"

   - name: Find JAVA_HOME
     command: "readlink -f /usr/bin/java | sed 's:/bin/java::'"
     register: java_home_path

   - name: Set JAVA_HOME in /etc/environment
     lineinfile:
       path: /etc/environment
       regexp: '^JAVA_HOME='
       line: 'JAVA_HOME={{ java_home_path.stdout }}'

