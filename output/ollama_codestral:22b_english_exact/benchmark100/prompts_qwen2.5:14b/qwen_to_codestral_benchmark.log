---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Pre-configure debian systems
     debconf:
       name: postfix
       question: postfix/main_mailer_type
       value: 'No configuration'
       vtype: string

   - name: Install postfix
     apt:
       name: postfix
       state: present

   - name: Install postfix-mysql
     apt:
       name: postfix-mysql
       state: present
     when: >
       postfix_virtual_mailbox_maps is defined and
       postfix_virtual_mailbox_maps | regex_search('mysql') or
       postfix_virtual_mailbox_domains is defined and
       postfix_virtual_mailbox_domains | regex_search('mysql') or
       postfix_virtual_alias_maps is defined and
       postfix_virtual_alias_maps | regex_search('mysql')

   - name: Configure postfix (transport_maps)
     template:
       src: transport_maps.j2
       dest: /etc/postfix/transport_maps
     notify:
       - Validate postfix configuration
       - Rebuild transport_maps

   - name: Configure postfix (header_checks)
     template:
       src: header_checks.j2
       dest: /etc/postfix/header_checks
     notify:
       - Validate postfix configuration
       - Reload postfix

   - name: Setting values for main.cf (1/2)
     set_fact:
       main_cf_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default('') }}"
       main_cf_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default('') }}"
     when: >
       postfix_smtpd_recipient_restrictions is defined and
       postfix_smtpd_sender_restrictions is defined

   - name: Setting values for main.cf (2/2)
     set_fact:
       main_cf_mynetworks: "{{ postfix_mynetworks | join(',') }}"
       main_cf_mydestination: "{{ postfix_mydestination | join(',') }}"
       main_cf_relay_domains: "{{ postfix_relay_domains | join(',') }}"
       main_cf_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default('') }}"
       main_cf_virtual_alias_domains: "{{ postfix_virtual_alias_domains | default('') }}"

   - name: Configure postfix (main.cf)
     template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify:
       - Validate postfix configuration
       - Restart postfix

   - name: Configure postfix (master.cf)
     template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify:
       - Validate postfix configuration
       - Restart postfix

   - name: Creates cert/key directory
     file:
       path: "{{ item | dirname }}"
       state: directory
     loop:
       - "{{ postfix_smtpd_tls_cert_file | default('') }}"
       - "{{ postfix_smtpd_tls_key_file | default('') }}"

   - name: Deploy Postfix TLS server certificate
     copy:
       src: "{{ postfix_smtpd_tls_cert_file | default('') }}"
       dest: /etc/postfix/certs/smtpd.crt
     notify:
       - Reload postfix

   - name: Deploy Postfix TLS server key
     copy:
       src: "{{ postfix_smtpd_tls_key_file | default('') }}"
       dest: /etc/postfix/certs/smtpd.key
     notify:
       - Reload postfix

   - name: Flush handlers
     meta: flush_handlers

   - name: Configure aliases
     template:
       src: aliases.j2
       dest: /etc/aliases
     notify:
       - Rebuild aliases database
       - Reload postfix

   - name: Configure sender_access
     template:
       src: sender_access.j2
       dest: /etc/postfix/sender_access
     notify:
       - Rebuild sender_access database
       - Reload postfix

   - name: Configure recipient_access
     template:
       src: recipient_access.j2
       dest: /etc/postfix/recipient_access
     notify:
       - Validate postfix configuration
       - Rebuild recipient_access database
       - Reload postfix

   - name: Place sasl_password_map
     copy:
       content: "{{ postfix_sasl_password_map_content | default('') }}"
       dest: /etc/postfix/sasl_password_map
     notify:
       - Rebuild sasl_password_map database

   - name: Flush handlers again
     meta: flush_handlers

   - name: Start and enable postfix
     service:
       name: postfix
       state: started
