---
   - name: Check if system is EFI
     stat:
       path: /sys/firmware/efi/efivars
     register: efi_system

   - name: Remove grub.cfg if system is EFI
     file:
       path: /boot/grub2/grub.cfg
       state: absent
     when: efi_system.stat.isdir is defined and efi_system.stat.isdir

   - name: Install user template for GRUB
     copy:
       src: 01_users
       dest: /etc/grub.d/01_users
       owner: root
       mode: 0700
     notify: update grub

   - name: Add password to EFI GRUB configuration
     lineinfile:
       path: /etc/grub2-efi.cfg
       line: 'set superusers="admin"'
       regexp: '^set superusers'
       insertafter: '^GRUB_CMDLINE_LINUX="'
     notify: update grub

   - name: Add password to MBR GRUB configuration
     lineinfile:
       path: /etc/grub2.cfg
       line: 'set superusers="admin"'
       regexp: '^set superusers'
       insertafter: '^GRUB_CMDLINE_LINUX="'
     notify: update grub

   - name: Add --unrestricted option to specified files
     lineinfile:
       path: "{{ item }}"
       regexp: '^(CLASS=")(.*)(")'
       line: 'CLASS="\2 --unrestricted"'
       backrefs: yes
     with_items: "{{ grub_password_unrestricted_files }}"
     when: grub_password_unrestricted is defined and grub_password_unrestricted
     notify: update grub

   - name: Handle GRUB update
     shell: grub2-mkconfig -o /boot/grub2/grub.cfg
     listen: update grub

