---
   - name: Create Vault group
     group:
       name: "{{ vault_group }}"
       state: present
       system: true

   - name: Create Vault user
     user:
       name: "{{ vault_user }}"
       home: "/"
       shell: "{{ vault_user_shell }}"
       groups: "{{ vault_group }}"
       system: true

   - name: Create Vault download directory
     file:
       path: "{{ vault_download_path }}"
       state: directory
       mode: '0755'
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"

   - name: Download Vault binary
     get_url:
       url: "{{ vault_binary_url }}"
       dest: "{{ vault_download_path }}"
       owner: root

   - name: Unarchive Vault binary
     unarchive:
       src: "{{ vault_download_path }}"
       dest: "{{ vault_download_path }}"
       remote_src: yes

   - name: Check if vault_path exists
     stat:
       path: "{{ vault_path }}"
     register: vault_path_check

   - name: Create vault_path if it does not exist
     file:
       path: "{{ vault_path }}"
       state: directory
       mode: '0755'
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
     when: not vault_path_check.stat.exists | bool

   - name: Create directory in vault_path
     file:
       path: "{{ item.path }}"
       state: directory
       mode: '0755'
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
     loop: "{{ vault_directories }}"

   - name: Create data directory
     file:
       path: "{{ item.path }}"
       state: directory
       mode: '0755'
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
     loop: "{{ vault_data_directories }}"

   - name: Generate TLS key and certificate
     shell: >
       cd "{{ vault_data_directory }}/tls/" &&
       vault cert generate -address=http://127.0.0.1:8200 -tls-skip-verify -init
       -out=ca.pem -key-type=rsa -key-bits=4096 -format=pem_bundle
     notify: Restart vault

   - name: Set ownership of tls material
     file:
       path: "{{ item }}"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
     loop: "{{ vault_tls_files }}"

   - name: Copy Vault binary
     copy:
       src: "{{ vault_download_path }}/vault"
       dest: "{{ vault_path }}/usr/bin/vault"
       mode: '0755'
     notify: Restart vault

   - name: Set cap_ipc_lock=ep on /usr/bin/vault
     capabilities:
       path: "{{ vault_path }}/usr/bin/vault"
       capability: cap_ipc_lock=ep
       state: present
     changed_when: false

   - name: Touch vault.env
     file:
       path: "{{ vault_path }}/etc/vault.d/vault.env"
       state: touch
       mode: '0644'
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
     notify: Restart vault

   - name: Create /usr/lib/systemd/system
     file:
       path: "/usr/lib/systemd/system"
       state: directory
       mode: '0755'

   - name: Copy Vault service file
     template:
       src: "vault.service.j2"
       dest: "/usr/lib/systemd/system/vault.service"
       mode: '0644'
     notify: Daemon reload
     when: service_mgr == 'systemd'

   - name: Copy vault configuration
     copy:
       src: "vault.hcl"
       dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
       mode: '0644'
     notify: Restart vault

   - name: Flush handlers
     meta: flush_handlers

