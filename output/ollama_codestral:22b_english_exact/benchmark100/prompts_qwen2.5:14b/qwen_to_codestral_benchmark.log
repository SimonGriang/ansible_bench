       path: "{{ item.key_path }}"
       mode: '0640'
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
     with_items: "{{ ssl_items }}"

   - name: Create ssl csr
     openssl_csr:
       path: "{{ item.csr_path }}"
       privatekey_path: "{{ item.key_path }}"
       mode: '0644'
       common_name: "{{ item.common_name }}"
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
     with_items: "{{ ssl_items }}"

   - name: Create ssl certificates
     openssl_certificate:
       path: "{{ item.cert_path }}"
       privatekey_path: "{{ item.key_path }}"
       csr_path: "{{ item.csr_path }}"
       provider: selfsigned
       mode: '0644'
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
     with_items: "{{ ssl_items }}"

   - name: Create PKCS#12 file
     openssl_pkcs12:
       path: "{{ item.p12_path }}"
       privatekey_path: "{{ item.key_path }}"
       certificate_path: "{{ item.cert_path }}"
       mode: '0640'
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
       friendly_name: "{{ item.friendly_name }}"
     with_items: "{{ ssl_items }}"

   - name: Read private key
     slurp:
       src: "{{ item.key_path }}"
     register: private_keys
     with_items: "{{ ssl_items }}"

   - name: Read certificate
     slurp:
       src: "{{ item.cert_path }}"
     register: certificates
     with_items: "{{ ssl_items }}"

   - name: Create combined private_key and certificate file
     copy:
       content: |
         {{ item.0.content | b64decode }}
         {{ item.1.content | b64decode }}
       dest: "{{ item.2.combined_path }}"
       mode: '0640'
       owner: "{{ item.2.owner }}"
       group: "{{ item.2.group }}"
     with_together:
       - "{{ private_keys.results }}"
       - "{{ certificates.results }}"
       - "{{ ssl_items }}"
     loop_control:
       label: "{{ item.2.combined_path }}"

