       state: "{{ user.state | default('present') }}"
       password: "{{ user.password | password_hash('sha512') }}"
       sudo: "yes"
     when: user.sudo is defined and user.sudo | bool

   - name: "Set sudo options for {{ user.name }}"
     copy:
       content: "{{ user.name }} ALL=(ALL) NOPASSWD: ALL"
       dest: "/etc/sudoers.d/{{ user.name }}"
       mode: '0640'
       validate: "/usr/sbin/visudo --check --file=%s"
     when: user.sudo_options is defined

   - name: "Remove sudo options for {{ user.name }}"
     file:
       path: "/etc/sudoers.d/{{ user.name }}"
       state: absent
     when: user.sudo_options is not defined

   - name: "Generate private ssh key for {{ user.name }}"
     community.crypto.openssh_keypair:
       path: "{{ ssh_key_directory }}/{{ user.name }}"
     when: user.manage_ssh_key | bool
     delegate_to: localhost
     become: no

   - name: "Generate public ssh key for {{ user.name }}"
     community.crypto.openssh_keypair:
       path: "{{ ssh_key_directory }}/{{ user.name }}"
       type: "ed25519"
       public_key_format: "OpenSSH"
     when: user.manage_ssh_key | bool
     delegate_to: localhost
     become: no

   - name: "Convert ssh key to ppk for {{ user.name }}"
     command: >
       puttygen "{{ ssh_key_directory }}/{{ user.name }}"
       -O private-openssh
       -o "{{ ssh_key_directory }}/{{ user.name }}.ppk"
     when: user.manage_ssh_key | bool
     delegate_to: localhost
     become: no

   - name: "Get or set the home directory for {{ user.name }}"
     set_fact:
       user_home: "{{ lookup('env', 'HOME') }}"
     when: user.home is not defined

   - name: "Create .ssh directory for {{ user.name }}"
     file:
       path: "{{ user_home }}/.ssh"
       state: directory
       mode: '0700'
     become: yes
     when: user.manage_ssh_key | bool or user.private_keys is defined

   - name: "Deploy authorized keys for {{ user.name }}"
     authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
       state: present
     with_items: "{{ user.authorized_keys }}"
     when: user.authorized_keys is defined

   - name: "Remove unauthorized keys for {{ user.name }}"
     authorized_key:
       user: "{{ user.name }}"
       key: "{{ item }}"
       state: absent
     with_items: "{{ user.unauthorized_keys }}"
     when: user.unauthorized_keys is defined

   - name: "Copy generated private ssh key for {{ user.name }}"
     copy:
       src: "{{ ssh_key_directory }}/{{ user.name }}"
       dest: "{{ user_home }}/.ssh/id_ed25519"
       mode: '0600'
     when: user.copy_private_key | bool

   - name: "Check users password valid time for {{ user.name }}"
     shell: "chage -l {{ user.name }} | grep 'Password expires' | awk '{print $3}'"
     register: password_expiry
     changed_when: false

   - name: "Set users password valid time for {{ user.name }}"
     command: "chage -I {{ user.password_validity_days }} {{ user.name }}"
     when: >
       user.password_validity_days is defined
       and password_expiry.stdout != user.password_validity_days

   - name: "Place private key file for {{ user.name }}"
     copy:
       src: "{{ item.src }}"
       dest: "{{ user_home }}/.ssh/{{ item.dest }}"
       mode: "{{ item.mode | default('0600') }}"
       owner: "{{ user.name }}"
       group: "{{ user.name }}"
     loop: "{{ user.private_keys }}"
     loop_control:
       label: "{{ item.dest }}"
     when: user.private_keys is defined

