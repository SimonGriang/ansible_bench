---
   - name: Ensure /etc/openvpn/easy-rsa directory exists
     file:
       path: /etc/openvpn/easy-rsa
       state: directory
       mode: '0755'

   - name: Easyrsa init-pki
     shell: |
       cd /etc/openvpn/easy-rsa
       if [ ! -f pki/ca.crt ]; then
         ./easyrsa init-pki
       fi

   - name: Easyrsa build-ca
     shell: |
       cd /etc/openvpn/easy-rsa
       if [ ! -f pki/ca.crt ]; then
         ./easyrsa --batch build-ca nopass
       fi

   - name: Easyrsa gen-dh
     shell: |
       cd /etc/openvpn/easy-rsa
       if [ ! -f pki/dh.pem ]; then
         ./easyrsa gen-dh
       fi

   - name: Easyrsa build-server-full server nopass
     shell: |
       cd /etc/openvpn/easy-rsa
       if [ ! -f pki/issued/server.crt ]; then
         ./easyrsa --batch build-server-full server nopass
       fi

   - name: Easyrsa build-client-full client nopass
     shell: |
       cd /etc/openvpn/easy-rsa
       if [ ! -f pki/issued/client.crt ]; then
         ./easyrsa --batch build-client-full client nopass
       fi

   - name: Easyrsa gen-crl
     shell: |
       cd /etc/openvpn/easy-rsa
       if [ ! -f pki/crl.pem ]; then
         ./easyrsa gen-crl
       fi

   - name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
     shell: |
       if [ ! -f /etc/openvpn/easy-rsa/pki/ta.key ]; then
         openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
       fi

   - name: Copy files to /etc/openvpn/server
     shell: |
       cd /etc/openvpn/easy-rsa
       cp pki/{ca.crt,dh.pem,issued/server.crt,private/server.key,crl.pem} /etc/openvpn/server
       chmod 600 /etc/openvpn/server/{server.key,crl.pem}

   - name: Copy files to /etc/openvpn
     shell: |
       cd /etc/openvpn/easy-rsa
       cp pki/{ca.crt,ta.key} /etc/openvpn

   - name: Place server.conf
     template:
       src: server.conf.j2
       dest: /etc/openvpn/server.conf
     notify: restart openvpn

