---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install dns
     package:
       name: "{{ dns_packages }}"
       state: present

   - name: Create directories
     file:
       path: "{{ item.path }}"
       state: directory
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
       mode: "{{ item.mode }}"
     with_items: "{{ dns_directories }}"

   - name: Create group
     group:
       name: "{{ dns_group }}"
       system: yes

   - name: Create user
     user:
       name: "{{ dns_user }}"
       system: yes
       group: "{{ dns_group }}"
       home: "{{ dns_home_directory }}"
       shell: /sbin/nologin
       createhome: no

   - name: Generate rndc key
     shell:
       cmd: >
         rndc-confgen -a -c {{ dns_config_directory }}
         -k {{ dns_rndc_directory }} -r /dev/urandom

   - name: Set permissions on rndc key file
     file:
       path: "{{ dns_rndc_key_file }}"
       mode: "0644"

   - name: Get the hints/root file
     get_url:
       url: "{{ dns_root_hints_url }}"
       dest: "{{ dns_data_directory }}/named.root"

   - name: Create zone file
     template:
       src: zone.j2
       dest: "{{ dns_data_directory }}/{{ item }}.zone"
     with_items: "{{ dns_zones }}"

   - name: Add zones to configuration
     template:
       src: named.conf.j2
       dest: "{{ dns_config_directory }}/named.conf"

   - name: Place systemd override
     copy:
       src: dns.service
       dest: /etc/systemd/system/dns.service.d/override.conf

   - name: Start and enable dns
     systemd:
       name: dns
