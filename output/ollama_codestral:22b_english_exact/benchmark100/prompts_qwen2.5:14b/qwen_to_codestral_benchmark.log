tl get nodes -o jsonpath=\'{.items[*].metadata.name}\'\n         register: nodes\n       - command: "kubectl delete node {{ item }} || true"\n         loop: "{{ nodes.stdout.split(\' \') }}"\n       - command: rm -rf /var/lib/rancher/rke2/server/db/nodes/*\n     when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined\n\n   - name: Set an Active Server variable\n     set_fact:\n       active_server: "{{ inventory_hostname }}"\n     with_items: "{{ groups[rke2_cluster_group_name] }}"\n\n# The end of the file is marked by a new line as per the yamllint error message\n# Long lines are broken down to comply with the line-length rule\n# Indentation issues are fixed to match YAML syntax requirements' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-19T00:05:45.674519993Z', 'done': True, 'done_reason': 'stop', 'total_duration': 34959560464, 'load_duration': 14745043, 'prompt_eval_count': 2819, 'prompt_eval_duration': 628845505, 'eval_count': 1532, 'eval_duration': 34314397473, 'model_name': 'codestral:22b'} id='run--c80a49f7-fb89-4ff8-b06a-04e7d2715dbf-0' usage_metadata={'input_tokens': 2819, 'output_tokens': 1532, 'total_tokens': 4351}
