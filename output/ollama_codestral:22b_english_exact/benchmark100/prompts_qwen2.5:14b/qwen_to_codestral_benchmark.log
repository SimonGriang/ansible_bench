---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Wait for port to be available
     wait_for:
       port: "{{ bootstrap_port }}"
       timeout: "{{ bootstrap_timeout }}"
       host: "{{ bootstrap_host | default(inventory_hostname) }}"
       connect_timeout: 5
       sleep: 5
     become: true

   - name: Prepare system
     raw: /usr/bin/python3 -c 'import sys, json; print(json.dumps(sys.version_info[:]))'
     register: python_version
     become: true
     changed_when: false

   - name: Gather bootstrap facts
     setup:
     when: python_version.stdout == 'failed'

   - name: Install bootstrap packages (raw)
     raw: "{{ ansible_facts['pkg_mgr'] }} install -y {{ bootstrap_pkgs['raw'] }}"
     become: true
     when: python_version.stdout == 'failed'

   - name: Ensure libdnf5 is present on Fedora/RedHat
     package:
       name: libdnf5
       state: present
     when: ansible_facts['os_family'] == 'RedHat'
     become: true

   - name: Gather ansible facts
     setup:

   - name: Install bootstrap packages (package)
     package:
       name: "{{ bootstrap_pkgs['package'] }}"
       state: present
       update_cache: true
     become: true

