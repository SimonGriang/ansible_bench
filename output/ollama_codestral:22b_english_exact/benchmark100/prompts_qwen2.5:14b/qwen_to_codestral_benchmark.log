---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install cron
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure shell
     lineinfile:
       path: /etc/crontab
       regexp: '^SHELL='
       line: 'SHELL={{ cron_shell }}'
     notify: Restart cron
     become: true
     mode: '0600'

   - name: Configure path
     lineinfile:
       path: /etc/crontab
       regexp: '^PATH='
       line: 'PATH={{ cron_path }}'
     notify: Restart cron
     become: true
     mode: '0600'

   - name: Configure mailto
     lineinfile:
       path: /etc/crontab
       regexp: '^MAILTO='
       line: 'MAILTO={{ cron_mailto }}'
     notify: Restart cron
     become: true
     mode: '0600'

   - name: Start and enable cron
     systemd:
       name: "{{ cron_service }}"
       state: started
       enabled: yes
     when: cron_service is defined and cron_service | length > 0

   - name: Schedule requested cron jobs
     cron:
       name: "{{ item.name }}"
       minute: "{{ item.minute | default('*') }}"
       hour: "{{ item.hour | default('*') }}"
       day: "{{ item.day | default('*') }}"
       month: "{{ item.month | default('*') }}"
       weekday: "{{ item.weekday | default('*') }}"
       job: "{{ item.command }}"
     with_items: "{{ cron_jobs }}"

