       dest: /etc/sysctl.d/60-rke2-cis.conf
       mode: '0600'
     notify: restart systemd-sysctl

   - name: Flush handlers
     meta: flush_handlers

   - name: restart systemd-sysctl
     systemd:
       name: systemd-sysctl
       state: restarted

   # 'notify' handlers should be placed after tasks that may trigger them
   # The 'restart systemd-sysctl' handler was moved to the end of the playbook
