 - name: Ensure the unzip package is available on the target system
      package:
        name: unzip
        state: present
        update_cache: yes

    - name: Create a system group for promtail
      group:
        name: promtail
        state: present
        system: yes

    - name: Create the promtail user
      user:
        name: promtail
        state: present
        system: yes
        group: promtail

    - name: Ensure the /usr/local/bin directory exists
      file:
        path: /usr/local/bin
        state: directory
        mode: '0755'

    - name: Create config directories
      file:
        path: /etc/promtail
        state: directory
        mode: '0750'
        owner: promtail
        group: promtail

    - name: Create application directories
      file:
        path: /opt/promtail
        state: directory
        mode: '0750'
        owner: promtail
        group: promtail

    - name: Check if the promtail binary exists
      stat:
        path: /opt/promtail/promtail
      register: promtail_binary

    - name: Download promtail binaries
      get_url:
        url: "{{ promtail_url }}"
        dest: /tmp/promtail.zip
      when: not promtail_binary.stat.exists and not locally_distributed and not propagate

    - name: Propagate locally distributed promtail archive
      copy:
        src: "{{ local_promtail_archive }}"
        dest: /tmp/promtail.zip
      when: not promtail_binary.stat.exists and locally_distributed and not propagate

    - name: Download promtail binaries to controller node
      get_url:
        url: "{{ promtail_url }}"
        dest: /tmp/promtail.zip
        delegate_to: localhost
      when: not promtail_binary.stat.exists and propagate and inventory_hostname != 'localhost'

    - name: Propagate promtail binaries
      copy:
        src: /tmp/promtail.zip
        dest: /tmp/promtail.zip
      when: not promtail_binary.stat.exists and propagate and inventory_hostname == 'localhost'

    - name: Unpack promtail binaries
      unarchive:
        src: /tmp/promtail.zip
        dest: /opt/promtail
        mode: '0750'
        owner: promtail
        group: promtail
        creates: /opt/promtail/promtail

    - name: Create symlink to latest version
      file:
        src: /opt/promtail/promtail
        dest: /usr/local/bin/promtail
        state: link
      notify: Restart promtail service

    - name: Write configuration
      template:
        src: promtail.config.j2
        dest: /etc/promtail/promtail-config.yaml
        mode: '0640'
        owner: promtail
        group: promtail
      notify: Restart promtail service

    - name: Create systemd service unit
      template:
        src: promtail.service.j2
        dest: /etc/systemd/system/promtail.service
        mode: '0644'
      notify: Restart promtail service

    - name: Flush handlers
      meta: flush_handlers

    - name: Restart promtail service
      systemd:
        name: promtail
        state: restarted
        enabled: yes

