---
   - name: Enable proxy and proxy_http modules
     apache2_module:
       state: present
       name: "{{ item }}"
     loop:
       - proxy
       - proxy_http
     notify:
       - Test httpd configuration
       - Restart httpd
     when: ansible_os_family == 'Debian' or ansible_os_family == 'Suse'

   - name: Configure locations
     template:
       src: location.conf.j2
       dest: "{{ item.dest }}"
       mode: "{{ item.mode }}"
     loop: "{{ httpd_locations }}"
     notify:
       - Test httpd configuration
       - Restart httpd

   - name: Test httpd configuration
     command: apache2ctl configtest
     register: result
     changed_when: "result.rc != 0"
     notify:
       - Restart httpd

   - name: Restart httpd
     service:
       name: apache2
       state: restarted
     when: result is defined and result.changed


