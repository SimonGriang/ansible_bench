---
   - name: Update apt cache
     apt:
       update_cache: yes
     when: ansible_os_family == "Debian"

   - name: Update dnf cache
     dnf:
       update_cache: yes
     when: ansible_os_family == "RedHat"

   - name: Install keepalived package
     package:
       name: keepalived
       state: present

   - name: Create directory for keepalived
     file:
       path: /etc/keepalived
       state: directory
       mode: '0755'

   - name: Create Kubernetes API health check script for Debian OS family
     copy:
       dest: /etc/keepalived/check_k8s_api.sh
       content: |
         # Kubernetes API health check script for Debian
         # Script content here
       mode: '0755'
     when: ansible_os_family == "Debian"
     notify: restart keepalived

   - name: Create Kubernetes API health check script for RedHat OS family
     copy:
       dest: /etc/keepalived/check_k8s_api.sh
       content: |
         # Kubernetes API health check script for RedHat
         # Script content here
       mode: '0755'
     when: ansible_os_family == "RedHat"
     notify: restart keepalived

   - name: Create RKE2 Server health check script for Debian OS family
     copy:
       dest: /etc/keepalived/check_rke2_server.sh
       content: |
         # RKE2 Server health check script for Debian
         # Script content here
       mode: '0755'
     when: ansible_os_family == "Debian"
     notify: restart keepalived

   - name: Create RKE2 Server health check script for RedHat OS family
     copy:
       dest: /etc/keepalived/check_rke2_server.sh
       content: |
         # RKE2 Server health check script for RedHat
         # Script content here
       mode: '0755'
     when: ansible_os_family == "RedHat"
     notify: restart keepalived

   - name: Create keepalived config file
     copy:
       dest: /etc/keepalived/keepalived.conf
       content: |
         # Keepalived configuration file
         # Configuration content here
     notify: restart keepalived

   - name: Enable keepalived and make sure it is not masked
     systemd:
       name: keepalived
       enabled: yes
       masked: no
     notify: restart keepalived

   - name: Flush handlers
     meta: flush_handlers

   - name: Restart keepalived (handler)
     systemd:
       name: keepalived
       state: restarted

