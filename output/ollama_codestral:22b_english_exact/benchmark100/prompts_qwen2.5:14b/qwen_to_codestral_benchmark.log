   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       priv: "{{ item.privileges }}"
       state: present
     loop: "{{ mysql_users }}"
     no_log: true

   - name: Flush handlers
     meta: flush_handlers

