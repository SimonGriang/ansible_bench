---
   - name: Update java_jdk_vendor
     set_fact:
       java_jdk_vendor: temurin
     when: java_jdk_vendor == 'adoptopenjdk'

   - name: Include OS-specific variables
     include_vars: "{{ lookup('first_found', params) }}"
     vars:
       params:
         files:
           - "{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
           - "{{ ansible_distribution }}.yml"

   - name: Include architecture-specific variables
     include_vars: "{{ lookup('first_found', params) }}"
     vars:
       params:
         files:
           - "{{ ansible_architecture }}.yml"

   - name: Set OS-specific variables
     set_fact:
       java_debian_repo: "{{ java_debian_repo_default }}"
       java_redhat_repo: "{{ java_redhat_repo_default }}"
     when:
       - java_debian_repo is not defined or java_debian_repo is none
       - java_redhat_repo is not defined or java_redhat_repo is none

   - name: Set OS and architecture-specific variables
     set_fact:
       java_debian_package: "{{ java_debian_package_default }}"
       java_redhat_package: "{{ java_redhat_package_default }}"
     when:
       - java_debian_package is not defined or java_debian_package is none
       - java_redhat_package is not defined or java_redhat_package is none

   - name: Set java_home
     set_fact:
       java_home: "/usr/lib/jvm/{{ java_jdk_vendor }}-{{ java_jdk_version }}"

   - name: Debian pre-requisites
     block:
       - name: Remove deprecated repositories
         apt_repository:
           repo: "deb http://ppa.launchpad.net/webupd8team/java/ubuntu {{ ansible_lsb.codename }} main"
           state: absent
       - name: Remove deprecated repositories
         apt_repository:
           repo: "deb-src http://ppa.launchpad.net/webupd8team/java/ubuntu {{ ansible_lsb.codename }} main"
           state: absent
       - name: Install extra apt tools
         apt:
           name:
             - apt-transport-https
             - ca-certificates
             - gnupg
             - software-properties-common
           state: present
       - name: Add key repositories
         apt_key:
           url: "https://adoptopenjdk.jfrog.io/adoptopenjdk/api/gpg/key/public"
           state: present
       - name: Add repositories
         apt_repository:
           repo: "deb {{ java_debian_repo }} {{ ansible_lsb.codename }} main"
           state: present
     when: ansible_os_family == 'Debian'

   - name: RedHat pre-requisites
     block:
       - name: Add key repositories
         rpm_key:
           key: "https://yum.corretto.aws/corretto.key"
           state: present
       - name: Add repositories
         yum_repository:
           name: "Corretto"
           description: "Corretto Repository"
           baseurl: "{{ java_redhat_repo }}"
           gpgcheck: true
           gpgkey: "https://yum.corretto.aws/corretto.key"
           enabled: true
     when: ansible_os_family == 'RedHat'

   - name: Install required libraries
     package:
       name: "{{ java_required_libraries }}"
       state: present

   - name: Install Java, Debian
     block:
       - name: Update apt cache
         apt:
           update_cache: true
       - name: Install Java
         apt:
           name: "{{ java_debian_package }}"
           state: present
         register: java_install_result
         until: java_install_result is succeeded
     when: ansible_os_family == 'Debian'

   - name: Install Java, RedHat
     block:
       - name: Install Java
         yum:
           name: "{{ java_redhat_package }}"
           state: present
         register: java_install_result
         until: java_install_result is succeeded
     when: ansible_os_family == 'RedHat'

   - name: Export environment variables
     template:
       src: java.sh.j2
       dest: /etc/profile.d/java.sh

   - name: Source environment variables
     shell: source /etc/profile.d/java.sh
     args:
       executable: /bin/bash

   - name: Correct java version selected for Java versions less than 11
     block:
       - name: Check if alternative exists
         shell: >
           set -o pipefail && update-java-alternatives --list |
           grep -E "{{ java_home }}" | wc -l
         register: java_alternative_exists
         ignore_errors: true
       - name: Set alternative
         shell: update-java-alternatives --set "{{ java_home }}"
         when: java_alternative_exists.stdout|int > 0
     when: ansible_os_family == 'Debian' and java_jdk_version|int < 11

   - name: Correct java version selected for Java versions greater than or equal to 11
     block:
       - name: Check if alternative exists
         shell: >
           set -o pipefail && update-alternatives --list java |
           grep -E "{{ java_home }}/bin/java" | wc -l
         register: java_alternative_exists
         ignore_errors: true
       - name: Set alternative
         shell: update-alternatives --install /usr/bin/java java "{{ java_home }}/bin/java" 1
         when: java_alternative_exists.stdout|int > 0
       - name: Verify alternative
         shell: update-alternatives --auto java
     when: ansible_os_family == 'Debian' and java_jdk_version|int >= 11
