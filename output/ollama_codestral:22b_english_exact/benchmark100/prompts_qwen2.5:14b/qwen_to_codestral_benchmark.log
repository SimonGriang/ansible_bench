---
   - name: Cordon and Drain the node
     kubernetes.core.k8s_drain:
       name: "{{ rke2_node_name }}"
       state: drain
       delete_options:
         ignore_daemonsets: true
         timeout: 120
       wait_timeout: 100
       wait_retries: 100
       wait_retry_interval: 15
       wait_condition:
         type: NodeReady
         status: 'True'
         reason: 'KubeletReady'
       kubeconfig: "{{ rke2_data_path }}/kubeconfig.yaml"
       drain_timeout: 120
       extra_args: "{{ rke2_drain_additional_args | default(omit) }}"

   - name: Restart RKE2 service on node
     ansible.builtin.service:
       name: rke2-server.service
       state: restarted
     notify: Service (re)started
     delegate_to: "{{ rke2_node_name }}"

   - name: Wait for all nodes to be ready again
     kubernetes.core.k8s_info:
       kind: Node
       field_selectors:
         - status.conditions.type=Ready
         - status.conditions.status=True
     register: nodes
     until: nodes.resources | length == nodes.resources | map(attribute='metadata.name') | unique | length
     retries: 100
     delay: 15

   - name: Uncordon the node
     kubernetes.core.k8s_drain:
       name: "{{ rke2_node_name }}"
       state: uncordon
     when: rke2_drain_node_during_upgrade | default(true)

   - name: Wait for all pods to be ready again
     kubernetes.core.k8s_info:
       kind: Pod
       field_selectors:
         - status.phase=Running
         - status.phase=Succeeded
     register: pods
     until: pods.resources | length == pods.resources | map(attribute='metadata.name') | unique | length
     retries: 100
     delay: 15
     when: rke2_wait_for_all_pods_to_be_ready | default(true)

   - name: Wait for all pods to pass readiness checks
     ansible.builtin.command: kubectl wait --for=condition=Ready pods --all --all-namespaces --timeout=1200s
     changed_when: false
     when: rke2_wait_for_all_pods_to_be_healthy | default(true)

