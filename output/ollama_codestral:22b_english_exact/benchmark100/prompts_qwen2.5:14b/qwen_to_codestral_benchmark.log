---
   - name: Import assert.yml
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
     notify:
       - Set root password
       - Systemctl daemon-reexec

   - name: Configure mysql server
     template:
       src: mysql-server.cnf.j2
       dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
     vars:
       mysql_configuration_options: "{{ mysql_configuration_options }}"
     notify:
       - Restart mysql server

   - name: Configure mysql client
     lineinfile:
       path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
       regexp: '^socket'
       line: "socket = {{ mysql_socket_location }}"

   - name: Initialize mysql
     command: "{{ mysql_initialize_command }}"
     when: ansible_os_family in ['Alpine', 'Archlinux']

   - name: Start and enable mysql
     service:
       name: mysql
       state: started
       enabled: true

   - name: Flush handlers
     meta: flush_handlers

   - name: Place my.cnf
     template:
       src: my.cnf.j2
       dest: /root/.my.cnf

   - name: Create databases
     mysql_db:
       name: "{{ item.name }}"
       state: present
       login_user: root
     with_items: "{{ mysql_databases }}"

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       state: present
       login_user: root
     with_items: "{{ mysql_users }}"

   - name: Flush handlers again
     meta: flush_handlers
