         apt_repository:
           repo: "deb {{ java_debian_repo }} {{ ansible_lsb.codename }} main"
           state: present
     when: ansible_os_family == 'Debian'

   - name: RedHat pre-requisites
     block:
       - name: Add key repositories
         rpm_key:
           key: "https://yum.corretto.aws/corretto.key"
           state: present
       - name: Add repositories
         yum_repository:
           name: "Corretto"
           description: "Corretto Repository"
           baseurl: "{{ java_redhat_repo }}"
           gpgcheck: yes
           gpgkey: "https://yum.corretto.aws/corretto.key"
           enabled: yes
     when: ansible_os_family == 'RedHat'

