 - name: Create local ssh_key_directory for {{ user.name }}
    file:
      path: "{{ ssh_key_directory }}"
      state: directory
      mode: '0750'
    delegate_to: localhost
    become: no
    when: user.manage_ssh_key

  - name: Manage user {{ user.name }}
    user:
      name: "{{ user.name }}"
      state: "{{ user.state | default('present') }}"
      password: "{{ user.password | default(omit) }}"
      sudo: "{{ user.sudo | default(omit) }}"

  - name: Set sudo options for {{ user.name }}
    template:
      src: sudoers.d.j2
      dest: "/etc/sudoers.d/{{ user.name }}"
      mode: '0640'
      validate: /usr/sbin/visudo --check
    when: user.sudo is defined

  - name: Remove sudo options for {{ user.name }}
    file:
      path: "/etc/sudoers.d/{{ user.name }}"
      state: absent
    when: user.sudo is not defined

  - name: Generate private ssh key for {{ user.name }}
    openssh_keypair:
      path: "{{ ssh_key_directory }}/{{ user.name }}"
    delegate_to: localhost
    become: no
    when: user.manage_ssh_key

  - name: Generate public ssh key for {{ user.name }}
    shell: "ssh-keygen -y -f {{ ssh_key_directory }}/{{ user.name }} > {{ ssh_key_directory }}/{{ user.name }}.pub"
    delegate_to: localhost
    become: no
    when: user.manage_ssh_key

  - name: Convert ssh key to ppk for {{ user.name }}
    shell: "puttygen {{ ssh_key_directory }}/{{ user.name }} -O private-openssh -o {{ ssh_key_directory }}/{{ user.name }}.ppk"
    delegate_to: localhost
    become: no
    when: user.manage_ssh_key

  - name: Get or set the home directory for {{ user.name }}
    getent:
      database: passwd
      key: "{{ user.name }}"
      fail_key: no
    register: getent_user

  - name: Set home directory variable for {{ user.name }}
    set_fact:
      home_dir: "{{ getent_user.ansible_facts.getent_passwd[user.name][4] | default(default_home_directory) }}"

  - name: Create .ssh directory for {{ user.name }}
    file:
      path: "{{ home_dir }}/.ssh"
      state: directory
      owner: "{{ user.name }}"
      group: "{{ user.name }}"
      mode: '0700'
    become: yes
    when: user.manage_ssh_key or user.private_keys is defined

  - name: Deploy authorized keys for {{ user.name }}
    authorized_key:
      user: "{{ user.name }}"
      key: "{{ item }}"
      state: present
    with_items: "{{ user.authorized_keys | default([]) }}"

  - name: Remove unauthorized keys for {{ user.name }}
    authorized_key:
      user: "{{ user.name }}"
      key: "{{ item }}"
      state: absent
    with_items: "{{ user.unauthorized_keys | default([]) }}"

  - name: Copy generated private ssh key for {{ user.name }}
    copy:
      src: "{{ ssh_key_directory }}/{{ user.name }}"
      dest: "{{ home_dir }}/.ssh/id_rsa"
      mode: '0600'
    delegate_to: localhost
    become: no
    when: user.copy_private_key

  - name: Check users password valid time for {{ user.name }}
    shell: "chage -l {{ user.name }} | grep 'Password expires' | awk '{print $3}'"
    register: password_expires
    changed_when: false

  - name: Set users password valid time for {{ user.name }}
    shell: "chage --maxdays {{ user.password_validity_days }} {{ user.name }}"
    when: user.password_validity_days is defined and password_expires.stdout != user.password_validity_days

  - name: Place private key file for {{ user.name }}
    copy:
      content: "{{ item.key }}"
      dest: "{{ home_dir }}/.ssh/{{ item.filename }}"
      mode: '0600'
      owner: "{{ user.name }}"
      group: "{{ user.name }}"
    with_items: "{{ user.private_keys | default([]) }}"
    when: user.private_keys is defined

