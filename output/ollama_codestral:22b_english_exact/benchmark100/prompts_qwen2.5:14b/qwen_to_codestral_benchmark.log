  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian' and item.create_docroot is defined and item.create_docroot
  args:
    creates: "/etc/apache2/sites-enabled/{{ item.name }}.conf"
  notify:
    - Test Apache configuration
    - Restart Apache server


