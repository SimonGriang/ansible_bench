---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install cron
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure shell
     lineinfile:
       path: /etc/cron.env
       regexp: '^SHELL='
       line: "SHELL={{ cron_shell }}"
       insertbefore: BOF
       owner: root
       group: root
       mode: '0600'
     notify: Restart cron

   - name: Configure path
     lineinfile:
       path: /etc/cron.env
       regexp: '^PATH='
       line: "PATH={{ cron_path }}"
       insertbefore: BOF
       owner: root
       group: root
       mode: '0600'
     notify: Restart cron

   - name: Configure mailto
     lineinfile:
       path: /etc/cron.env
       regexp: '^MAILTO='
       line: "MAILTO={{ cron_mailto }}"
       insertbefore: BOF
       owner: root
       group: root
       mode: '0600'
     notify: Restart cron

   - name: Start and enable cron
     service:
       name: "{{ cron_service }}"
       state: started
       enabled: true
     when: cron_service is defined and cron_service | length > 0

   - name: Schedule requested cron jobs
     cron:
       name: "{{ item.name }}"
       minute: "{{ item.minute | default('*') }}"
       hour: "{{ item.hour | default('*') }}"
       day: "{{ item.day | default('*') }}"
       month: "{{ item.month | default('*') }}"
       weekday: "{{ item.weekday | default('*') }}"
       job: "{{ item.job }}"
     with_items: "{{ cron_jobs }}"
     when: cron_jobs is defined and cron_jobs | length > 0


