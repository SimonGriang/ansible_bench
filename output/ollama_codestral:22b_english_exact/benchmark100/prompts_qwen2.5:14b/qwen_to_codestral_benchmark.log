- name: lookup bootstrap facts (raw)
  ansible.builtin.command: cat /etc/os-release
  register: bootstrap_os_release_raw
  changed_when: false

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ bootstrap_os_release_raw.stdout | regex_search('ID=(\\S+)') | regex_replace('ID=') }}"
    bootstrap_major_version: "{{ bootstrap_os_release_raw.stdout | regex_search('VERSION_ID=(\\d+)') | regex_replace('VERSION_ID=') }}"

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ bootstrap__os_family_map[bootstrap_distribution] }}"


