     with_items: "{{ inventory_hostnames }}"

   - name: Create combined private_key and certificate file
     copy:
       content: |
         {{ private_key_content.results | map(attribute='content') | map('b64decode') | list | join('\n') }}
         {{ certificate_content.results | map(attribute='content') | map('b64decode') | list | join('\n') }}
       dest: "/etc/ssl/combined/{{ item }}.pem"
       owner: root
       group: ssl-cert
       mode: '0640'
     with_items: "{{ inventory_hostnames }}"

   # End of the playbook
   

