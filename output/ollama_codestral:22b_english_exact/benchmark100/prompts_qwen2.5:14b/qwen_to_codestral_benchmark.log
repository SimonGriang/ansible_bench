       line: "SHELL={{ cron_shell }}"
       insertbefore: BOF
       owner: root
       group: root
       mode: '0600'
     notify: Restart cron

   - name: Configure path
     lineinfile:
       path: /etc/cron.env
       regexp: '^PATH='
       line: "PATH={{ cron_path }}"
       insertbefore: BOF
       owner: root
       group: root
       mode: '0600'
