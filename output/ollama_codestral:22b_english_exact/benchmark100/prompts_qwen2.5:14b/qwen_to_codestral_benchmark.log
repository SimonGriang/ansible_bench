 - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install mysql
    package:
      name: "{{ mysql_packages }}"
      state: present

  - name: Configure mysql server
    lineinfile:
      dest: "{{ mysql_configuration_file }}"
      regexp: "^{{ item.name }} ="
      line: "{{ item.name }} = {{ item.value }}"
    loop: "{{ mysql_configuration_options | dict2items }}"
    notify: Restart mysql

  - name: Configure mysql client
    lineinfile:
      dest: "{{ mysql_client_configuration_file }}"
      regexp: "^socket ="
      line: "socket = {{ mysql_socket }}"

  - name: Initialize mysql
    command: mysql_install_db
    when: ansible_os_family == 'Alpine' or ansible_os_family == 'Archlinux'

  - name: Start and enable mysql
    service:
      name: mysql
      state: started
      enabled: yes

  - name: Place my.cnf
    copy:
      src: my.cnf
      dest: /etc/my.cnf
      mode: '0644'

  - name: Create databases
    mysql_db:
      name: "{{ item.name }}"
      state: present
    loop: "{{ mysql_databases }}"
    when: item.initial_import is not defined

  - name: List databases
    command: mysql -e "SHOW DATABASES;"
    register: databases

  - name: Import database
    mysql_db:
      name: "{{ item.name }}"
      state: import
      target: "{{ item.initial_import }}"
    loop: "{{ mysql_databases }}"
    when: item.initial_import is defined and item.name not in databases.stdout

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.privileges }}"
      state: present
    loop: "{{ mysql_users }}"
    no_log: true

  - name: Flush handlers
    meta: flush_handlers

  - name: Flush handlers again
    meta: flush_handlers

