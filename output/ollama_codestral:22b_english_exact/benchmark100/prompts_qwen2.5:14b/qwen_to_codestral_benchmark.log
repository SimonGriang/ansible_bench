 - name: Import assert.yml
    import_tasks: assert.yml

  - name: Uninstall conflicting systemd-logger
    package:
      name: systemd-logger
      state: absent

  - name: Install rsyslog
    package:
      name: rsyslog
      state: present

  - name: Install additional rsyslog packages
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ rsyslog_features }}"

  - name: Configuring default rsyslog
    template:
      src: default.conf.j2
      dest: /etc/rsyslog.conf
    when: rsyslog_deploy_default_config | bool

  - name: Make configuration directory
    file:
      path: /etc/rsyslog.d/
      state: directory
      mode: '0755'

  - name: Configuring rsyslog forward rule
    template:
      src: forward.conf.j2
      dest: /etc/rsyslog.d/forward.conf
    when: not rsyslog_deploy_default_config | bool

  - name: Configuring additional config files
    copy:
      src: "{{ item }}"
      dest: /etc/rsyslog.d/
      mode: '0644'
      owner: root
      group: root
    loop: "{{ rsyslog_additional_config_files }}"

  - name: Start and enable rsyslog
    service:
      name: rsyslog
      state: started
      enabled: yes

