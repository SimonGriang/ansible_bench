content=' ---\n   - name: Create RKE2 config directory\n     file:\n       path: /etc/rancher/rke2\n       state: directory\n\n   - name: Set server taints\n     set_fact:\n       combined_node_taints: "{{ rke2_server_node_taints }}"\n     when: server_type == \'server\'\n\n   - name: Copy RKE2 configuration file\n     template:\n       src: config.yaml.j2\n       dest: /etc/rancher/rke2/config.yaml\n     notify: Config file changed\n\n   - name: Copy kubelet configuration file\n     template:\n       src: kubelet-config.yaml.j2\n       dest: /etc/rancher/rke2/kubelet-config.yaml\n     when: rke2_kubelet_config != ""\n     notify: Config file changed\n\n   - name: Copy Containerd Registry Configuration file\n     template:\n       src: registries.yaml.j2\n       dest: /etc/rancher/rke2/registries.yaml\n     when: rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != ""\n     notify: Config file changed\n\n   - name: Register if we need to do a etcd restore from file\n     set_fact:\n       do_etcd_restore: true\n     when: rke2_etcd_snapshot_file != "" and (services[\'rke2-server.service\'] is not defined or services[\'rke2-server.service\'][\'state\'] != \'started\')\n\n   - name: Register if we need to do a etcd restore from s3\n     set_fact:\n       do_etcd_restore_from_s3: true\n     when: rke2_etcd_snapshot_file != "" and rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined\n\n   - name: Restore etcd from file\n     block:\n       - file:\n           path: /var/lib/rancher/rke2/server/db/snapshots\n           state: directory\n       - copy:\n           src: "{{ rke2_etcd_snapshot_file }}"\n           dest: /var/lib/rancher/rke2/server/db/snapshots/snapshot.db\n       - shell: /var/lib/rancher/rke2/bin/kube-rke2-server etcd --config=/var/lib/rancher/rke2/server/config.yaml --snapshot-restore --snapshot-restore-wait-time=5m\n     when: do_etcd_restore is defined\n\n   - name: Restore etcd from s3\n     shell: /var/lib/rancher/rke2/bin/kube-rke2-server etcd --config=/var/lib/rancher/rke2/server/config.yaml --snapshot-restore-from-s3 --etcd-s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }} --etcd-s3-key={{ rke2_etcd_snapshot_s3_options.snapshot_name }} --etcd-s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }} --etcd-s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }} --etcd-s3-endpoint={{ rke2_etcd_snapshot_s3_options.endpoint_url }} --etcd-s3-insecure-skip-tls-verify={{ rke2_etcd_snapshot_s3_options.insecure_skip_tls_verify | default(false) }} --snapshot-restore-wait-time=5m\n     when: do_etcd_restore_from_s3 is defined\n\n   - name: Start RKE2 service on the first server\n     systemd:\n       name: rke2-server.service\n       state: started\n       enabled: yes\n       daemon_reload: yes\n     environment:\n       RKE2_TOKEN: "{{ rke2_token }}"\n     when: inventory_hostname == groups[rke2_cluster_group_name][0]\n\n   - name: Mask RKE2 agent service on the first server\n     systemd:\n       name: rke2-agent.service\n       state: stopped\n       enabled: no\n       masked: yes\n     when: inventory_hostname == groups[rke2_cluster_group_name][0]\n\n   - name: Wait for the first server be ready - no CNI\n     shell: "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes {{ inventory_hostname }} -o=jsonpath=\'{.status.conditions[?(@.type==\\"Ready\\")].status}\'"\n     register: first_server_ready\n     until: first_server_ready.stdout == \'True\'\n     retries: 10\n     delay: 6\n     when: inventory_hostname == groups[rke2_cluster_group_name][0]\n\n   - name: Wait for the first server be ready - with CNI\n     shell: "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes {{ inventory_hostname }} -o=jsonpath=\'{.status.conditions[?(@.type==\\"Ready\\")].status}\' | grep -q True && /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes {{ inventory_hostname }} -o=jsonpath=\'{.status.conditions[?(@.type==\\"NetworkUnavailable\\")].status}\' | grep -q False"\n     register: first_server_ready\n     until: first_server_ready.rc == 0\n     retries: 10\n     delay: 6\n     when: inventory_hostname == groups[rke2_cluster_group_name][0]\n\n   - name: Restore etcd\n     block:\n       - shell: "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get secrets -n kube-system | grep \'rke2-etcd-snapshot\' | awk \'{print $1}\'"\n         register: etcd_secrets\n\n       - shell: "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete secrets {{ item }} -n kube-system"\n         with_items: "{{ etcd_secrets.stdout_lines }}"\n\n       - shell: "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes | grep -v \'name:\' | awk \'{print $1}\'"\n         register: k8s_nodes\n\n       - shell: "/var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete nodes {{ item }}"\n         with_items: "{{ k8s_nodes.stdout_lines }}"\n     when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined\n\n   - name: Set an Active Server variable\n     set_fact:\n       active_server: "{{ inventory_hostname }}"\n     with_items: "{{ groups[rke2_cluster_group_name] }}"' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-08T20:09:23.846448625Z', 'done': True, 'done_reason': 'stop', 'total_duration': 40598897867, 'load_duration': 16989177, 'prompt_eval_count': 1102, 'prompt_eval_duration': 855728955, 'eval_count': 1915, 'eval_duration': 39725378362, 'model_name': 'codestral:22b'} id='run--b67554c0-5e67-46fb-950a-a2d8dfb938d9-0' usage_metadata={'input_tokens': 1102, 'output_tokens': 1915, 'total_tokens': 3017}
