---
   - name: Import assert.yml
     ansible.builtin.import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Configure apk
     block:
       - name: Update apk cache
         community.general.apk:
           update_cache: true
       - name: Upgrade all software
         community.general.apk:
           upgrade: true
         notify: reboot

   - name: Configure apt
     block:
       - name: Prevent upgrade for selected packages
         ansible.builtin.dpkg_selections:
           name: "{{ item }}"
           selection: hold
         loop: "{{ apt_hold_packages }}"
       - name: Update all software
         ansible.builtin.apt:
           upgrade: dist
       - name: Autoremove unused packages
         ansible.builtin.apt:
           autoremove: true
         notify: reboot

   - name: Update all software (dnf)
     block:
       - name: Update all software
         ansible.builtin.dnf:
           name: '*'
           exclude: "{{ dnf_exclude_packages }}"
         notify: reboot

   - name: Update all software (pacman)
     block:
       - name: Update all software
         community.general.pacman:
           update_cache: true
           upgrade: true
         notify: reboot

   - name: Configure yum
     block:
       - name: Install yum-utils if needed
         ansible.builtin.yum:
           name: yum-utils
           state: present
       - name: Update all software
         ansible.builtin.yum:
           name: '*'
           state: latest
         notify: reboot

   - name: Update all software (zypper)
