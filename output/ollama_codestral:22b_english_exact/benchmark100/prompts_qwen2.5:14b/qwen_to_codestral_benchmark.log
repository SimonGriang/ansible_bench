---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Configure apk
  block:
    - name: Update apk cache
      apk:
        update_cache: true
    - name: Upgrade all software
      apk:
        upgrade: true
      notify: reboot

- name: Configure apt
  block:
    - name: Prevent upgrade for selected packages
      dpkg_selections:
        name: "{{ item }}"
        selection: hold
      loop: "{{ apt_hold_packages }}"
    - name: Update all software
      apt:
        upgrade: dist
    - name: Autoremove unused packages
      apt:
        autoremove: true
      notify: reboot

- name: Update all software (dnf)
  block:
    - name: Update all software
      dnf:
        name: '*'
        exclude: "{{ dnf_exclude_packages }}"
      notify: reboot

- name: Update all software (pacman)
  block:
    - name: Update all software
      pacman:
        update_cache: true
        upgrade: true
      notify: reboot

- name: Configure yum
  block:
    - name: Install yum-utils if needed
      yum:
        name: yum-utils
        state: present
    - name: Update all software
      yum:
        name: '*'
        state: latest
      notify: reboot

- name: Update all software (zypper)
  block:
    - name: Update all software
      zypper:
        name: '*'
        state: latest
      notify: reboot


