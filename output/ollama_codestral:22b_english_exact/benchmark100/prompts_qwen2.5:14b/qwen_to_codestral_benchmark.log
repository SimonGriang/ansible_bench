---
   - name: Create RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory
     when: rke2_server_type == 'server'

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_server_type == 'server'
     notify: Config file changed

   - name: Copy RKE2 configuration file
     template:
       src: config.yaml.j2
       dest: /etc/rancher/rke2/config.yaml
     notify: Config file changed

   - name: Copy kubelet configuration file
     template:
       src: kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
     when: rke2_kubelet_config | length > 0
     notify: Config file changed

   - name: Copy Containerd Registry Configuration file
     template:
       src: registries.yaml.j2
       dest: /etc/rancher/rke2/registries.yaml
     when: >
       rke2_custom_registry_mirrors | length > 0
       or rke2_custom_registry_configs | length > 0
     notify: Config file changed

   - name: Register if we need to do a etcd restore from file
     set_fact:
       do_etcd_restore: true
     when: >
       rke2_etcd_snapshot_file | length > 0
       and (rke2_server_service.state is undefined
       or rke2_server_service.state == 'stopped')

   - name: Register if we need to do a etcd restore from s3
     set_fact:
       do_etcd_restore_from_s3: true
     when: >
       rke2_etcd_snapshot_file | length > 0
       and rke2_etcd_snapshot_s3_options.access_key is defined
       and rke2_etcd_snapshot_s3_options.secret_key is defined
       and rke2_etcd_snapshot_s3_options.bucket is defined
       and rke2_etcd_snapshot_s3_options.snapshot_name is defined

   - name: Restore etcd from file
     block:
       - file:
           path: /var/lib/rancher/rke2/server/db/snapshots
           state: directory
       - copy:
           src: "{{ rke2_etcd_snapshot_file }}"
           dest: /var/lib/rancher/rke2/server/db/snapshots/snapshot.db
       - command: >-
           rke2 server --config /etc/rancher/rke2/config.yaml
           --etcd-snapshot-restore=/var/lib/rancher/rke2/server/db/snapshots/snapshot.db
     when: do_etcd_restore is defined

   - name: Restore etcd from s3
     command: >-
       rke2 server --config /etc/rancher/rke2/config.yaml
       --etcd-snapshot-restore-url="s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/{{
       rke2_etcd_snapshot_s3_options.snapshot_name }}?access_key={{
       rke2_etcd_snapshot_s3_options.access_key }}&secret_key={{
       rke2_etcd_snapshot_s3_options.secret_key }}"
     when: do_etcd_restore_from_s3 is defined

   - name: Start RKE2 service on the first server
     systemd:
       name: rke2-server
       state: started
       enabled: true
       daemon_reload: true
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     when: inventory_hostname == groups[rke2_cluster_group_name][0]

   - name: Mask RKE2 agent service on the first server
     systemd:
       name: rke2-agent
       state: stopped
       enabled: false
       masked: true
     when: inventory_hostname == groups[rke2_cluster_group_name][0]

   - name: Wait for the first server be ready - no CNI
     command: >-
       kubectl get nodes -o
       jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}'
     register: result
     until: result.stdout == "True"
     retries: 30
     delay: 10
     when: inventory_hostname == groups[rke2_cluster_group_name][0]

   - name: Wait for the first server be ready - with CNI
     command: >-
       kubectl get nodes -o
       jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}'
     register: result
     until: result.stdout == "True"
     retries: 30
     delay: 10
     when: >
       inventory_hostname == groups[rke2_cluster_group_name][0]
       and rke2_cni_plugin is defined

   - name: Restore etcd
     block:
       - command: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
         register: nodes
       - command: "kubectl delete node {{ item }} || true"
         loop: "{{ nodes.stdout.split(' ') }}"
       - command: rm -rf /var/lib/rancher/rke2/server/db/nodes/*
     when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

   - name: Set an Active Server variable
     set_fact:
       active_server: "{{ inventory_hostname }}"
     with_items: "{{ groups[rke2_cluster_group_name] }}"

   # The new line at the end of file is added as per the yamllint error message
   # The long lines are broken down as per the line-length error message
   # The indentation is corrected as per the indentation error message

