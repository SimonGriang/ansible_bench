---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Pre-configure debian systems
     ansible.builtin.debconf:
       name: postfix
       question: postfix/main_mailer_type
       value: 'No configuration'
       vtype: string

   - name: Install postfix
     ansible.builtin.package:
       name: postfix
       state: present

   - name: Install postfix-mysql
     ansible.builtin.package:
       name: postfix-mysql
       state: present
     when: >
       'mysql' in postfix_virtual_mailbox_maps or
       'mysql' in postfix_virtual_mailbox_domains or
       'mysql' in postfix_virtual_alias_maps

   - name: Configure postfix (transport_maps)
     ansible.builtin.template:
       src: transport_maps.j2
       dest: /etc/postfix/transport_maps
     notify:
       - validate-postfix
       - rebuild-transport-maps

   - name: Configure postfix (header_checks)
     ansible.builtin.template:
       src: header_checks.j2
       dest: /etc/postfix/header_checks
     notify:
       - validate-postfix
       - reload-postfix

   - name: Setting values for main.cf (1/2)
     ansible.builtin.set_fact:
       postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions_value }}"
       postfix_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions_value }}"
     when: >
       postfix_smtpd_recipient_restrictions_value is defined and
       postfix_smtpd_sender_restrictions_value is defined

   - name: Setting values for main.cf (2/2)
     ansible.builtin.set_fact:
       postfix_mynetworks: "{{ postfix_mynetworks_value }}"
       postfix_mydestination: "{{ postfix_mydestination_value }}"
       postfix_relay_domains: "{{ postfix_relay_domains_value }}"
       postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains_value }}"
       postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains_value }}"
     when: >
       postfix_mynetworks_value is defined and
       postfix_mydestination_value is defined and
       postfix_relay_domains_value is defined and
       postfix_virtual_mailbox_domains_value is defined and
       postfix_virtual_alias_domains_value is defined

   - name: Configure postfix (main.cf)
     ansible.builtin.template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify:
       - validate-postfix
       - restart-postfix

   - name: Configure postfix (master.cf)
     ansible.builtin.template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify:
       - validate-postfix
       - restart-postfix

   - name: Creates cert/key directory
     ansible.builtin.file:
       path: "{{ item | dirname }}"
       state: directory
     with_items:
       - "{{ postfix_smtpd_tls_cert_file }}"
       - "{{ postfix_smtpd_tls_key_file }}"

   - name: Deploy Postfix TLS server certificate
     ansible.builtin.copy:
       src: "{{ postfix_smtpd_tls_cert_file }}"
       dest: "/etc/postfix/{{ postfix_smtpd_tls_cert_file | basename }}"
     notify: reload-postfix

   - name: Deploy Postfix TLS server key
     ansible.builtin.copy:
       src: "{{ postfix_smtpd_tls_key_file }}"
       dest: "/etc/postfix/{{ postfix_smtpd_tls_key_file | basename }}"
     notify: reload-postfix

   - name: Flush handlers
     ansible.builtin.meta: flush_handlers

   - name: Configure aliases
     ansible.builtin.template:
       src: aliases.j2
       dest: /etc/aliases
     notify:
       - rebuild-alias-database
       - reload-postfix

   - name: Configure sender_access
     ansible.builtin.template:
       src: sender_access.j2
       dest: /etc/postfix/sender_access
     notify:
       - rebuild-sender-access-database
       - reload-postfix

   - name: Configure recipient_access
     ansible.builtin.template:
       src: recipient_access.j2
       dest: /etc/postfix/recipient_access
     notify:
       - validate-postfix
       - rebuild-recipient-access-database
       - reload-postfix

   - name: Place sasl_password_map
     ansible.builtin.copy:
       content: "{{ postfix_sasl_password_map_content }}"
       dest: /etc/postfix/sasl_password_map
     notify: rebuild-sasl-password-map-database

   - name: Flush handlers again
     ansible.builtin.meta: flush_handlers

   - name: Start and enable postfix
     ansible.builtin.service:
       name: postfix
       state: started
       enabled: true

