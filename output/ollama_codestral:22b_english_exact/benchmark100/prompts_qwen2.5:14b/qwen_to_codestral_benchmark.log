    name: "{{ item.name }}"
    value: "{{ item.value }}"
    sysctl_set: yes
    state: present
  with_items: "{{ sysctl_items | default([]) }}"
  when:
    - item.name is defined
    - item.value is defined
    - ansible_connection != 'docker' and ansible_connection != 'container'


