 - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install cron
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure shell
     blockinfile:
       path: /etc/cron.d/cron
       regexp: '^SHELL='
       line: 'SHELL=/bin/bash'
     notify: Restart cron

   - name: Configure path
     blockinfile:
       path: /etc/cron.d/cron
       regexp: '^PATH='
       line: 'PATH=/usr/local/bin:/usr/bin:/bin'
     notify: Restart cron

   - name: Configure mailto
     blockinfile:
       path: /etc/cron.d/cron
       regexp: '^MAILTO='
       line: 'MAILTO=root'
     notify: Restart cron

   - name: Start and enable cron
     systemd:
       name: "{{ cron_service }}"
       state: started
       enabled: yes
     when: cron_service is defined and cron_service != ''

   - name: Schedule requested cron jobs
     cron:
       name: "{{ item.name }}"
       minute: "{{ item.minute }}"
       hour: "{{ item.hour }}"
       day: "{{ item.day | default(omit) }}"
       month: "{{ item.month | default(omit) }}"
       weekday: "{{ item.weekday | default(omit) }}"
       job: "{{ item.job }}"
       state: "{{ item.state | default('present') }}"
       user: "{{ item.user | default('root') }}"
     loop: "{{ cron_jobs }}"

