 - name: Create ssl key
     openssl_privatekey:
       path: "/etc/ssl/private/{{ item }}.key"
       owner: root
       group: ssl-cert
       mode: '0640'
     with_items: "{{ inventory_hostnames }}"

   - name: Create ssl csr
     openssl_csr:
       path: "/etc/ssl/csr/{{ item }}.csr"
       privatekey_path: "/etc/ssl/private/{{ item }}.key"
       common_name: "{{ item }}"
       owner: root
       group: ssl-cert
       mode: '0640'
     with_items: "{{ inventory_hostnames }}"

   - name: Create ssl certificates
     openssl_certificate:
       path: "/etc/ssl/certs/{{ item }}.crt"
       privatekey_path: "/etc/ssl/private/{{ item }}.key"
       csr_path: "/etc/ssl/csr/{{ item }}.csr"
       provider: selfsigned
       owner: root
       group: ssl-cert
       mode: '0640'
     with_items: "{{ inventory_hostnames }}"

   - name: Create PKCS#12 file
     openssl_pkcs12:
       path: "/etc/ssl/pkcs12/{{ item }}.p12"
       privatekey_path: "/etc/ssl/private/{{ item }}.key"
       certificate_path: "/etc/ssl/certs/{{ item }}.crt"
       owner: root
       group: ssl-cert
       mode: '0640'
     with_items: "{{ inventory_hostnames }}"

   - name: Read private key
     slurp:
       src: "/etc/ssl/private/{{ item }}.key"
     register: private_key_content
     with_items: "{{ inventory_hostnames }}"

   - name: Read certificate
     slurp:
       src: "/etc/ssl/certs/{{ item }}.crt"
     register: certificate_content
     with_items: "{{ inventory_hostnames }}"

   - name: Create combined private_key and certificate file
