     block:
       - dpkg_selections:
           name: "{{ apt_exclude_packages }}"
           selection: hold
       - apt:
           update_cache: true
           upgrade: safe
           autoremove: true
         notify: reboot

   - name: Update all software (dnf)
     dnf:
       name: '*'
       exclude: "{{ dnf_exclude_packages }}"
       state: latest
     notify: reboot

   - name: Update all software (pacman)
     pacman:
       update_cache: true
       upgrade: true
     notify: reboot

   - name: Configure yum
     block:
       - yum:
           name: yum-utils
           state: present
         when: ansible_pkg_mgr == 'yum'
       - yum:
           name: '*'
           state: latest
         notify: reboot

   - name: Update all software (zypper)
     zypper:
       name: '*'
       state: latest
     notify: reboot

