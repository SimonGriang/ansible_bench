---
   - name: Create the RKE2 config directory
     file:
       path: "{{ rke2_config_dir }}"
       state: directory

   - name: Set server taints
     command: >-
       /var/lib/rancher/rke2/bin/kubectl taint node {{ inventory_hostname }}
       {{ rke2_server_taint }} --overwrite
     when: rke2_type == "server"

   - name: Set agent taints
     command: >-
       /var/lib/rancher/rke2/bin/kubectl taint node {{ inventory_hostname }}
       {{ rke2_agent_taint }} --overwrite
     when: rke2_type == "agent"

   - name: Copy RKE2 config file
     copy:
       src: "{{ rke2_config_file }}"
       dest: "{{ rke2_config_dir }}"
     notify: Restart rke2-server

   - name: Copy kubelet config file
     copy:
       src: "{{ kubelet_config_file }}"
       dest: "{{ kubelet_config_dir }}"
     when: kubelet_config_content | length > 0
     notify: Restart rke2-server

   - name: Copy Containerd Registry Configuration file
     copy:
       src: "{{ containerd_registry_config_file }}"
       dest: "{{ containerd_registry_config_dir }}"
     when: containerd_registry_config_enabled
     notify: Restart rke2-server

