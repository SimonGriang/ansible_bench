       state: absent

   - name: Install rsyslog
     package:
       name: rsyslog
       state: present

   - name: Install additional rsyslog packages
     package:
       name: "{{ rsyslog_features }}"
       state: present

   - name: Configuring default rsyslog
     template:
       src: etc/rsyslog/rsyslog.conf.j2
       dest: /etc/rsyslog.conf
     when: rsyslog_deploy_default_config|bool

   - name: Make configuration directory
     file:
       path: /etc/rsyslog.d/
       state: directory
       mode: '0755'

   - name: Configuring rsyslog forward rule
     template:
       src: etc/rsyslog.d/10-forward.conf.j2
       dest: /etc/rsyslog.d/10-forward.conf
     when: not rsyslog_deploy_default_config|bool

   - name: Configuring additional config files
     copy:
       src: "{{ item }}"
       dest: /etc/rsyslog.d/
       owner: root
       group: root
       mode: '0644'
     with_fileglob:
       - "files/etc/rsyslog.d/*"

   - name: Start and enable rsyslog
     service:
       name: rsyslog
       state: started
       enabled: true

