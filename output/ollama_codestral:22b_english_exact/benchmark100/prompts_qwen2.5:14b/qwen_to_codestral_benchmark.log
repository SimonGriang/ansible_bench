       src: "{{ cadvisor_local_dir }}/cadvisor"
       dest: "{{ cadvisor_bin_dir }}/cadvisor"
       owner: "{{ cadvisor_user }}"
       group: "{{ cadvisor_group }}"
       mode: 0755
     when: cadvisor_local_dir | default(false)
     notify: restart cadvisor

   - name: cadvisor | symlink
     file:
       src: "{{ cadvisor_bin_dir }}/cadvisor"
       dest: "{{ cadvisor_symlink }}"
       state: link

   - name: cadvisor | server systemd service
     template:
       src: cadvisor.service.j2
       dest: /etc/systemd/system/cadvisor.service
       owner: root
       group: root
       mode: 0644
     notify: restart cadvisor

   - name: test_task
