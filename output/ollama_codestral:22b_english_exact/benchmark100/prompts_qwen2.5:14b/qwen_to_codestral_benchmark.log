---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Pre-configure debian systems
     debconf:
       name: postfix
       question: postfix/main_mailer_type
       value: 'No configuration'
       vtype: string

   - name: Install postfix
     package:
       name: postfix
       state: present

   - name: Install postfix-mysql
     package:
       name: postfix-mysql
       state: present
     when: >
       "mysql" in postfix_virtual_mailbox_maps
       or "mysql" in postfix_virtual_mailbox_domains
       or "mysql" in postfix_virtual_alias_maps

   - name: Configure postfix (transport_maps)
     template:
       src: transport_maps.j2
       dest: /etc/postfix/transport_maps
     notify:
       - validate transport_maps
       - rebuild transport_maps

   - name: Configure postfix (header_checks)
     template:
       src: header_checks.j2
       dest: /etc/postfix/header_checks
     notify:
       - validate header_checks
       - reload postfix

   - name: Setting values for main.cf (1/2)
     set_fact:
       main_cf_smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions_template }}"
       main_cf_smtpd_sender_restrictions: "{{ smtpd_sender_restrictions_template }}"
     when: >
       smtpd_recipient_restrictions_template is defined
       and smtpd_sender_restrictions_template is defined

   - name: Setting values for main.cf (2/2)
     set_fact:
       main_cf_mynetworks: "{{ mynetworks_template }}"
       main_cf_mydestination: "{{ mydestination_template }}"
       main_cf_relay_domains: "{{ relay_domains_template }}"
       main_cf_smtpd_recipient_restrictions: >-
         {{ main_cf_smtpd_recipient_restrictions | default('') }},
         {{ smtpd_recipient_restrictions_template }}
       main_cf_smtpd_sender_restrictions: >-
         {{ main_cf_smtpd_sender_restrictions | default('') }},
         {{ smtpd_sender_restrictions_template }}
       main_cf_virtual_mailbox_domains: "{{ virtual_mailbox_domains_template }}"
       main_cf_virtual_alias_domains: "{{ virtual_alias_domains_template }}"
     when: >
       mynetworks_template is defined
       and mydestination_template is defined
       and relay_domains_template is defined
       and virtual_mailbox_domains_template is defined
       and virtual_alias_domains_template is defined

   - name: Configure postfix (main.cf)
     template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify:
       - validate main.cf
       - restart postfix

   - name: Configure postfix (master.cf)
     template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify:
       - validate master.cf
       - restart postfix

   - name: Creates cert/key directory
     file:
       path: "{{ item | dirname }}"
       state: directory
     loop:
       - "{{ postfix_smtpd_tls_cert_file }}"
       - "{{ postfix_smtpd_tls_key_file }}"

   - name: Deploy Postfix TLS server certificate
     copy:
       src: "{{ postfix_smtpd_tls_cert_file }}"
       dest: /etc/postfix/tls_cert.pem
     notify: reload postfix

   - name: Deploy Postfix TLS server key
     copy:
       src: "{{ postfix_smtpd_tls_key_file }}"
       dest: /etc/postfix/tls_key.pem
     notify: reload postfix

   - name: Flush handlers
     meta: flush_handlers

   - name: Configure aliases
     template:
       src: aliases.j2
       dest: /etc/aliases
     notify:
       - rebuild alias database
       - reload postfix

   - name: Configure sender_access
     template:
       src: sender_access.j2
       dest: /etc/postfix/sender_access
     notify:
       - rebuild sender_access database
       - reload postfix

   - name: Configure recipient_access
     template:
       src: recipient_access.j2
       dest: /etc/postfix/recipient_access
     notify:
       - validate recipient_access
       - rebuild recipient_access database
       - reload postfix

   - name: Place sasl_password_map
     copy:
       content: "{{ sasl_password_map_content }}"
       dest: /etc/postfix/sasl_password_map
     notify: rebuild sasl_password_map database

   - name: Flush handlers again
     meta: flush_handlers

   - name: Start and enable postfix
     service:
       name: postfix
       state: started
       enabled: true

   # Added a linebreak at the end of the file to fix trailing-spaces and new-line-at-end-of-file errors.
