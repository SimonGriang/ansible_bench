---
   - name: Install Keepalived
     command: apt install -y keepalived
     when: rke2_ha_enabled and server_in_rke2_server_group

   - name: Download and install RKE2
     get_url:
       url: "https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2.linux-amd64.tar.gz"
       dest: "/tmp/rke2.linux-amd64.tar.gz"
     register: rke2_download

   - name: Extract RKE2
     unarchive:
       src: "/tmp/rke2.linux-amd64.tar.gz"
       dest: "/usr/local/bin"
       remote_src: true
     when: rke2_download.changed

   - name: CIS Hardening
     include_tasks: cis_hardening.yml
     when: cis_profile is defined

   - name: Find Active Server
     command: kubectl get nodes -o json
     register: nodes_json

   - name: Enable IPVS kernel module
     modprobe:
       name: ip_vs
       state: present
     when: use_kube_vip | bool and rke2_ha_enabled | bool

   - name: Copy kube-vip manifests to the masternode
     copy:
       src: kube-vip.yaml
       dest: /etc/rancher/kube-vip.yaml
     when: not use_keepalived | bool

   - name: Copy ingress-nginx manifests to the masternode
     copy:
       src: ingress-nginx.yaml
       dest: /etc/rancher/ingress-nginx.yaml
     when: ingress_nginx_config is defined

   - name: Prepare very first server node in the cluster
     include_tasks: first_server_setup.yml

   - name: Restore etcd specific tasks
     include_tasks: etcd_restore.yml
     when: restore_etcd | bool

   - name: Download kubeconfig to ansible localhost
     fetch:
       src: /etc/rancher/rke2/rke2.yaml
       dest: /tmp/kubeconfig
       flat: true
     when: download_kubeconfig | bool

   - name: Prepare and join remaining nodes of the cluster
     include_tasks: join_nodes.yml
     when: active_server is defined

   - name: Rolling cordon and drain restart when version changes - servers
     include_tasks: rolling_restart.yml
     vars:
       node_type: servers
     when: rke2_version_changed | bool

   - name: Rolling cordon and drain restart when version changes - agents
     include_tasks: rolling_restart.yml
     vars:
       node_type: agents
     when: rke2_version_changed | bool

   - name: Flush handlers
     meta: flush_handlers

   - name: Rolling restart when config files change
     include_tasks: rolling_restart.yml
     when: config_files_changed | bool

   - name: Final steps
     include_tasks: final_steps.yml

