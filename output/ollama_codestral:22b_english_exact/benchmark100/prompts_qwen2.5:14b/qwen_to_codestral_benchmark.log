---
   - name: Download RKE2 installation script
     get_url:
       url: "{{ rke2_url }}"
       dest: "{{ rke2_install_path }}"
       mode: '0700'
       timeout: 30

   - name: Copy local RKE2 installation script
     copy:
       src: "{{ rke2_local_install_path }}"
       dest: "{{ rke2_install_path }}"
       mode: '0700'
       force: true
     when:
       - rke2_airgap_mode is defined
       - rke2_airgap_implementation is defined

   - name: Create RKE2 artifacts folder
     file:
       path: "{{ rke2_artifacts_path }}"
       state: directory
       mode: '0700'
     when:
       - rke2_airgap_mode is defined
       - rke2_airgap_implementation != 'exists'

   - name: Download RKE2 checksum and artifacts
     block:
       - name: Download RKE2 checksum
         get_url:
           url: "{{ rke2_checksum_url }}"
           dest: "{{ rke2_artifacts_path }}"
       - name: Download RKE2 artifacts
         get_url:
           url: "{{ rke2_artifacts_url }}"
           dest: "{{ rke2_artifacts_path }}"
       - name: Download RKE2 install script
         get_url:
           url: "{{ rke2_install_script_url }}"
           dest: "{{ rke2_artifacts_path }}"
     when:
       - rke2_airgap_mode is defined
       - rke2_airgap_implementation == 'download'

   - name: Rescue for failed download
     block:
       - name: Create directory for local download
         file:
           path: "/tmp/rke2_local"
           state: directory
       - name: Download RKE2 artifacts and install script locally
         get_url:
           url: "{{ item.url }}"
           dest: "/tmp/rke2_local"
         loop:
           - "{{ rke2_artifacts_url }}"
           - "{{ rke2_install_script_url }}"
       - name: Copy local RKE2 artifacts to remote hosts
         copy:
           src: "/tmp/rke2_local"
           dest: "{{ rke2_artifacts_path }}"
     rescue:
       - name: Cleanup local download directory
         file:
           path: "/tmp/rke2_local"
           state: absent
     when:
       - rke2_airgap_mode is defined
       - rke2_airgap_implementation == 'download'
       - ansible_failed_result

   - name: Copy local RKE2 artifacts
     copy:
       src: "{{ rke2_local_artifacts_path }}"
       dest: "{{ rke2_remote_artifacts_path }}"
       mode: '0640'
       force: true
     when:
       - rke2_airgap_mode is defined
       - rke2_airgap_implementation == 'copy'

   - name: Airgap mode - additional images tarballs
     block:
       - name: Create folder for additional images tarballs
         file:
           path: "{{ rke2_additional_tarballs_path }}"
           state: directory
       - name: Copy additional images tarballs
         copy:
           src: "{{ item }}"
           dest: "{{ rke2_tarball_images_path }}"
         loop: "{{ rke2_airgap_copy_additional_tarballs }}"
     when:
       - rke2_airgap_mode is defined
       - rke2_airgap_copy_additional_tarballs | length > 0
       - rke2_airgap_implementation != 'exists'

   - name: Ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ item }}"
       state: file
       mode: '0640'
     loop:
       - "{{ rke2_artifacts_path }}/rke2.linux-amd64.tar.gz"
       - "{{ rke2_install_path }}"
     when:
       - rke2_airgap_mode is defined
       - rke2_airgap_implementation == 'exists'

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: /usr/local
     register: fs_object

   - name: Check if separate partition
     shell: grep ' /usr/local ' /proc/mounts
     register: separate_partition
     changed_when: false

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "{{ '/usr/local/bin' if separate_partition.stdout
         else '/var/lib/rancher/rke2/bin' }}"

   - name: Check RKE2 version
     shell: "{{ rke2_bin_path }}/rke2 --version"
     register: rke2_version_output
     ignore_errors: true

   - name: Set RKE2 versions
     set_fact:
       rke2_installed_version: >-
         {{ rke2_version_output.stdout_lines[0].split(' ')[2]
         if rke2_version_output.rc == 0 else '' }}
       rke2_running_version: >-
         {{ ansible_facts.services['rke2-server.service'].state
         == 'running' | ternary(rke2_version_output.stdout_lines[0].split(' ')[2], '') }}
     when: not ansible_check_mode

   - name: Prevent accidental RKE2 downgrade
     fail:
       msg: "Downgrading RKE2 from {{ rke2_running_version }} to
             {{ rke2_new_version }} is not allowed"
     when:
       - rke2_running_version is defined
       - rke2_new_version is defined
       - rke2_running_version != rke2_new_version
       - rke2_allow_downgrade | default(false) | bool

   - name: Run RKE2 install script
     shell: >-
       {{ rke2_install_path }}/rke2.sh
       {{ '--airgap-image-repository ' + rke2_airgap_image_repository
       if rke2_airgap_mode else '' }}
     when:
       - rke2_new_version is defined
       - rke2_installed_version != rke2_new_version
       - not ansible_check_mode

   - name: Copy Custom Manifests
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/manifests/"
     loop: "{{ rke2_custom_manifests }}"
     when: rke2_custom_manifests is defined and rke2_custom_manifests | length > 0

   - name: Copy Static Pods
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_agent_pod_manifests_path }}/"
     loop: "{{ rke2_static_pods }}"
     when: rke2_static_pods is defined and rke2_static_pods | length > 0

   - name: Copy RKE2 environment file
     copy:
       content: |
         {% for key, value in rke2_environment_options.items() %}
         {{ key }}={{ value }}
         {% endfor %}
       dest: "{{ rke2_environment_file_path }}"
     when:
       - rke2_environment_options is defined
       - rke2_environment_options | length > 0


