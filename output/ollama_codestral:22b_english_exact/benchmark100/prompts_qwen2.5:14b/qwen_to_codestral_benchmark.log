---
   - name: Create document root directories for each virtual host
     ansible.builtin.file:
       path: "{{ item.documentroot }}"
       state: directory
       mode: '0755'
     when: item.create_docroot is not defined or item.create_docroot
     loop: "{{ httpd_vhosts }}"

   - name: Configure virtual hosts using a template
     ansible.builtin.template:
       src: "{{ vhost_conf_template }}"
       dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
     loop: "{{ httpd_vhosts }}"
     notify:
       - Test httpd configuration validity
       - Restart httpd service

   - name: Test httpd configuration validity
     ansible.builtin.command: httpd -t
     changed_when: false
     notify:
       - Restart httpd service

   - name: Restart httpd service
     ansible.builtin.service:
       name: httpd
       state: restarted
     listen:
       - Test httpd configuration validity
       - Restart httpd service

   - meta: flush_handlers


