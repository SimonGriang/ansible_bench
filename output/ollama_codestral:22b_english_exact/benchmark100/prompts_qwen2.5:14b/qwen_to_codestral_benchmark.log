---
- name: Update apt cache
  apt:
    update_cache: yes
  when: ansible_os_family == "Debian"

- name: Update dnf cache
  dnf:
    update_cache: yes
  when: ansible_os_family == "RedHat"

- name: Install packages
  package:
    name: keepalived
    state: present

- name: Create directory for keepalived
  file:
    path: /etc/keepalived
    state: directory
    mode: '0755'

- name: Create Kubernetes API health check script for Debian OS family
  copy:
    dest: /etc/keepalived/check_k8s_api.sh
    content: |
      # Add script content here
    mode: '0755'
  when: ansible_os_family == "Debian"
  notify: Restart keepalived

- name: Create Kubernetes API health check script for RedHat OS famliy
  copy:
    dest: /etc/keepalived/check_k8s_api.sh
    content: |
      # Add script content here
    mode: '0755'
  when: ansible_os_family == "RedHat"
  notify: Restart keepalived

- name: Create RKE2 Server health check script for Debian OS family
  copy:
    dest: /etc/keepalived/check_rke2_server.sh
    content: |
      # Add script content here
    mode: '0755'
  when: ansible_os_family == "Debian"
  notify: Restart keepalived

- name: Create RKE2 Server health check script for RedHat OS family
  copy:
    dest: /etc/keepalived/check_rke2_server.sh
    content: |
      # Add script content here
    mode: '0755'
  when: ansible_os_family == "RedHat"
  notify: Restart keepalived

- name: Create keepalived config file
  copy:
    dest: /etc/keepalived/keepalived.conf
    content: |
      # Add configuration content here
  notify: Restart keepalived

- name: Enable keepalived and make sure it is not masked
  service:
    name: keepalived
    enabled: yes
    masked: no
  notify: Restart keepalived

- name: Flush handlers
  meta: flush_handlers


