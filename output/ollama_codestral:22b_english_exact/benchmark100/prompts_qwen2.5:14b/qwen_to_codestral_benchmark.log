 - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install using package
     package:
       name: "{{ hashicorp_product_name }}"
       state: present
     when: hashicorp_install_method == 'package'

   - name: Install repository for RedHat
     yum_repository:
       name: hashicorp
       description: HashiCorp Stable - $basearch
       baseurl: https://rpm.releases.hashicorp.com/RHEL/$releasever/$basearch/stable
       gpgkey: https://rpm.releases.hashicorp.com/gpg
       gpgcheck: yes
     when: ansible_os_family == 'RedHat'

   - name: Configure debian
     block:
       - name: Install required package gpg
         apt:
           name: gpg
           state: present

       - name: Install apt key for Debian
         apt_key:
           url: https://keybase.io/hashicorp/pgp_keys.asc
           state: present

       - name: Install repository for Debian
         apt_repository:
           repo: "deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
           state: present
     when: ansible_os_family == 'Debian'

   - name: Install hashicorp product using package
     package:
       name: "{{ hashicorp_product_name }}"
       state: present
     when: hashicorp_install_method == 'package' and hashicorp_product_version is not defined

   - name: Install versioned hashicorp product using package
     package:
       name: "{{ hashicorp_product_name }}={{ hashicorp_product_version }}"
       state: present
     when: hashicorp_install_method == 'package' and hashicorp_product_version is defined

   - name: Install manually
     block:
       - name: Install hashicorp product manually
         unarchive:
           src: "https://releases.hashicorp.com/{{ hashicorp_product_name }}/{{ hashicorp_product_version }}/{{ hashicorp_product_name }}_{{ hashicorp_product_version }}_linux_amd64.zip"
           dest: "{{ hashicorp_install_destination }}"
           remote_src: yes
           creates: "{{ hashicorp_install_destination }}/{{ hashicorp_product_name }}"
         when: hashicorp_install_method == 'manual'

       - name: Set permissions and owner
         file:
           path: "{{ hashicorp_install_destination }}/{{ hashicorp_product_name }}"
           mode: '0755'
           owner: "{{ hashicorp_install_owner }}"
           group: "{{ hashicorp_install_group }}"
         when: hashicorp_install_method == 'manual' and hashicorp_install_owner is defined and hashicorp_install_group is defined

