 - name: check if all variables have been set correctly
      assert:
        that:
          - bootstrap_wait_for_host is defined
          - bootstrap_install is defined

    - name: wait for host
      wait_for:
        host: "{{ bootstrap_wait_for_host_address }}"
        port: "{{ bootstrap_wait_for_host_port }}"
        search_regex: "{{ bootstrap_wait_for_host_search_regex }}"
      when: bootstrap_wait_for_host | bool

    - name: prepare system
      block:
        - name: prepare system | establish connection to host
          ping:
          register: bootstrap_ping_result
          ignore_unreachable: true
        - name: prepare system | gather facts
          setup:
          when: bootstrap_ping_result is succeeded
        - name: prepare system | include tasks to gather bootstrap facts (raw)
          include_tasks:
            file: gather-bootstrap-facts.yml
          when: bootstrap_ping_result is succeeded
      ignore_errors: true

    - name: install bootstrap packages (raw)
      raw: "{{ bootstrap_install.raw }}"
      when:
        - ansible_os_family is defined
        - bootstrap_install.raw is defined
        - bootstrap_ping_result is succeeded

    - name: ensure system is prepared by issuing ansible modules
      block:
        - name: ensure system is prepared by issuing ansible modules | gather facts
          setup:
        - name: ensure system is prepared by issuing ansible modules | install bootstrap packages
          package:
            name: "{{ bootstrap_facts.packages }}"
            state: present
      when: bootstrap_ping_result is succeeded

Note: This Ansible Playbook assumes that the necessary variables are defined elsewhere in the role or playbook. Make sure to set these variables accordingly before running the playbook.

