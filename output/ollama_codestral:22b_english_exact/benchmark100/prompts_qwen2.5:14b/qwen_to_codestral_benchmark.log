---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install cron
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure shell
     cronvar:
       name: SHELL
       value: "{{ cron_shell_path }}"
       mode: "{{ cron_file_mode }}"
     notify: Restart cron

   - name: Configure path
     cronvar:
       name: PATH
       value: "{{ cron_path_variable }}"
       mode: "{{ cron_file_mode }}"
     notify: Restart cron

   - name: Configure mailto
     cronvar:
       name: MAILTO
       value: "{{ cron_mailto }}"
       mode: "{{ cron_file_mode }}"
     notify: Restart cron

   - name: Start and enable cron
     service:
       name: "{{ cron_service }}"
       state: started
       enabled: true
     when: cron_service is defined and cron_service | length > 0

   - name: Schedule requested cron jobs
     cron:
       name: "{{ item.name }}"
       special_time: "{{ item.special_time | default(omit) }}"
       minute: "{{ item.minute | default(omit) }}"
       hour: "{{ item.hour | default(omit) }}"
       day: "{{ item.day | default(omit) }}"
       month: "{{ item.month | default(omit) }}"
       weekday: "{{ item.weekday | default(omit) }}"
       job: "{{ item.job }}"
       state: "{{ item.state | default('present') }}"
     loop: "{{ cron_jobs }}"
     loop_control:
       label: "{{ item.name }}"

   # Ensure the playbook ends with a new line character as per yamllint's new-line-at-end-of-file rule.
   

