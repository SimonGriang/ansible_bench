---
  - name: Ensure the unzip package is available on the target system
    package:
      name: unzip
      state: present
      update_cache: yes
    become: true

  - name: Create a system group for promtail
    group:
      name: promtail
      system: true
      state: present
    become: true

  - name: Create the promtail user
    user:
      name: promtail
      system: true
      group: promtail
      shell: /sbin/nologin
      create_home: false
    become: true

  - name: Ensure the /usr/local/bin directory exists
    file:
      path: /usr/local/bin
      state: directory
      mode: '0755'
    become: true

  - name: Create config directories
    file:
      path: /etc/promtail
      state: directory
      mode: '0755'
      owner: promtail
      group: promtail
    become: true

  - name: Create application directories
    file:
      path: /var/lib/promtail
      state: directory
      mode: '0755'
      owner: promtail
      group: promtail
    become: true

  - name: Check if the promtail binary exists
    stat:
      path: /usr/local/bin/promtail
    register: promtail_binary

  - name: Download promtail binaries
    get_url:
      url: "{{ promtail_url }}"
      dest: /tmp/promtail.zip
      mode: '0644'
    when: not promtail_binary.stat.exists and not promtail_local_propagation and not promtail_propagation

  - name: Propagate locally distributed promtail archive
    copy:
      src: "{{ promtail_local_archive_path }}"
      dest: /tmp/promtail.zip
      mode: '0644'
    when: not promtail_binary.stat.exists and promtail_local_propagation

  - name: Download promtail binaries to controller node
    get_url:
      url: "{{ promtail_url }}"
      dest: /tmp/promtail.zip
      mode: '0644'
    delegate_to: localhost
    when: not promtail_binary.stat.exists and promtail_propagation

  - name: Propagate promtail binaries
    copy:
      src: /tmp/promtail.zip
      dest: /tmp/promtail.zip
      mode: '0644'
    when: promtail_propagation

  - name: Unpack promtail binaries
    unarchive:
      src: /tmp/promtail.zip
      dest: /var/lib/promtail
      mode: '0755'
      creates: /var/lib/promtail/promtail
      remote_src: true

  - name: Create symlink to latest version
    file:
      src: /var/lib/promtail/promtail
      dest: /usr/local/bin/promtail
      state: link
    become: true
    notify: Restart promtail

  - name: Write configuration
    template:
      src: promtail.yml.j2
      dest: /etc/promtail/promtail.yml
      mode: '0644'
      owner: promtail
      group: promtail
    become: true
    notify: Restart promtail

  - name: Create systemd service unit
    template:
      src: promtail.service.j2
      dest: /etc/systemd/system/promtail.service
      mode: '0644'
    become: true
    notify:
      - Reload systemd
      - Restart promtail

