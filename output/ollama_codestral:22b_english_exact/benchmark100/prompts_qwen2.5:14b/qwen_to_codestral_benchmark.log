---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  command: getent passwd "{{ git_user }}"
  register: user_exists
  changed_when: false
  ignore_errors: true

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_user }}/.config/git"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
    mode: 0700
  when: user_exists.rc == 0 and git_config_path is defined

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_user }}/.config/git/config"
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
    mode: 0644
  when: user_exists.rc == 0 and git_config_path is defined

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
    mode: 0755
  when: user_exists.rc == 0 and repository_destination is defined

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}/{{ item.path }}"
  loop: "{{ git_repositories }}"
  become_user: "{{ git_user }}"
  when: user_exists.rc == 0 and repository_destination is defined and git_repositories is defined


