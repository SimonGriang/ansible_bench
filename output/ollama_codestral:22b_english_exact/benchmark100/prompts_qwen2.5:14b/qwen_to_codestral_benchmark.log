     assert:
       that:
         - variable1 is defined
         - variable2 is defined

   - name: Wait for host
     wait_for:
       host: "{{ inventory_hostname }}"
       port: "{{ bootstrap_port }}"
       timeout: "{{ bootstrap_wait_timeout }}"
     when: bootstrap_wait_for_host

   - name: Prepare system
     block:
       - setup:
       - include_tasks: bootstrap-facts.yml
     rescue:
       - debug: msg="Unable to establish a connection to the host."

   - name: Install bootstrap packages (raw)
     raw: "bootstrap-install-command-for-{{ ansible_os_family }}"
     when: bootstrap_install.raw

   - name: Ensure system is prepared
     block:
       - setup:
       - package:
           name: "{{ bootstrap_packages }}"
           state: present
     vars:
       bootstrap_packages: "{{ bootstrap_packages_per_os[ansible_os_family] }}"


