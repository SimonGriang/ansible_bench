---
  - name: Check if Helm binary exists
    command: test -f /path/to/helm
    ignore_errors: true
    register: helm_check

  - name: Check Helm version
    command: helm version --client --short
    register: helm_version
    when: helm_check.rc == 0

  - name: Download helm
    get_url:
      url: "{{ helm_repo }}/helm-v{{ helm_version_required }}-linux-amd64.tar.gz"
      dest: "/tmp/helm-v{{ helm_version_required }}-linux-amd64.tar.gz"
    when: >
      helm_check.rc != 0 or
      helm_version.stdout_lines[0].split(':')[1].strip() !=
      "v{{ helm_version_required }}"

  - name: Copy helm binary into place
    copy:
      src: "/tmp/helm-v{{ helm_version_required }}-linux-amd64/linux-amd64/helm"
      dest: "/path/to/helm"
      mode: 0755
    when: >
      helm_check.rc != 0 or
      helm_version.stdout_lines[0].split(':')[1].strip() !=
      "v{{ helm_version_required }}"

