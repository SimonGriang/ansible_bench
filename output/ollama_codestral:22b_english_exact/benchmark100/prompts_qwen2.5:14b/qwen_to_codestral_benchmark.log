---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install python pip
     package:
       name: "{{ name }}"
       state: present

   - name: Configure pip proxy
     blockinfile:
       path: /etc/pip.conf
       block: |
         [global]
         proxy = {{ python_pip_proxy }}
       marker: "# {mark} ANSIBLE MANAGED BLOCK - pip proxy"
       create: yes
     when: python_pip_proxy is defined

   - name: Trust hosts
     blockinfile:
       path: /etc/pip.conf
       block: |
         [global]
         trusted-host = {{ python_pip_trusted_host }}
       marker: "# {mark} ANSIBLE MANAGED BLOCK - pip trusted host"
       create: yes
     when: python_pip_trusted_host is defined

   - name: Update pip
     pip:
       name: pip
       state: latest
     when: >
       python_pip_update | bool and
       ansible_distribution_release != 'bookworm' and
       ansible_distribution_release != 'noble' and
       ansible_os_family != 'Alpine'

   - name: Install requested modules
     pip:
       name: "{{ item.name }}"
       state: "{{ item.state | default('present') }}"
       version: "{{ item.version | default(omit) }}"
     loop: "{{ python_pip_modules }}"
     when: >
       ansible_distribution_release != 'bookworm' and
       ansible_distribution_release != 'noble' and
       ansible_os_family != 'Alpine'

