 - name: hardening | Disable swap now
    shell: swapoff -a
    when: ansible_swaps.results | selectattr('stdout', 'search', '/dev/') | list | length > 0

   - name: hardening | Disable swap permanently
    mount:
      name: swap
      fstype: swap
      state: absent
    when: vault_hardening_disable_swap | bool

   - name: hardening | Disable core dumps
    pam_limits:
      domain: '*'
      limit_type: hard
      limit_item: core
      value: 0
    when: vault_hardening_disable_core_dumps | bool

   - name: hardening | Disable Shell Command History
    copy:
      dest: /etc/profile.d/disable_shell_command_history.sh
      content: |
        unset HISTFILE
    when: vault_hardening_disable_shell_command_history | bool

   - name: hardening | Install selinux-policy
    package:
      name: selinux-policy
      state: present

   - name: hardening | Set SELinux policy
    selinux:
      policy: targeted
      state: enforcing
    when: vault_hardening_configure_selinux_apparmor | bool and ansible_selinux.status == 'enabled'

   - name: hardening | Enable AppArmor (enforcing)
    lineinfile:
      path: /etc/apparmor/parser.conf
      regexp: '^/usr/bin/vault$'
      line: '/usr/bin/vault Px,'
      state: present
    when: vault_hardening_configure_selinux_apparmor | bool and ansible_apparmor.status == 'enabled'
    notify:
      - restart apparmor

