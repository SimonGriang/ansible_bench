---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    state: started
    host: '{{ inventory_hostname }}'
    connect_timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  shell: true
  become: true
  become_user: root
  become_method: sudo
  become_flags: '-n'

- name: Gather bootstrap facts
  setup:
  when: ansible_facts.distribution is not defined

- name: Install bootstrap packages (raw)
  raw: >
    {{ ansible_facts['os_family'] == 'RedHat' |
       ternary('yum install -y', 'apt-get install -y') }}
    {{ bootstrap_packages | join(' ') }}

- name: Ensure libdnf5 is present on Fedora/RedHat
  package:
    name: libdnf5
    state: present
  when: ansible_os_family == 'RedHat'

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_packages }}"
    state: present
    update_cache: yes
    cache_valid_time: "{{ bootstrap_cache_valid_time | default(3600) }}"


