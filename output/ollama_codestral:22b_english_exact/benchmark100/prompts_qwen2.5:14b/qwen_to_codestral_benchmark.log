---
   - name: Download RKE2 installation script
     get_url:
       url: "<remote_url>"
       dest: "<directory>"
       mode: "<mode>"
       timeout: "<timeout>"

   - name: Copy local RKE2 installation script
     copy:
       src: "<local_script_path>"
       dest: "<directory>"
       mode: 0700
       force: true
     when:
       - rke2_airgap_mode is defined
       - rke2_airgap_implementation is defined

   - name: Create RKE2 artifacts folder
     file:
       path: "<artifacts_folder_path>"
       mode: 0700
       state: directory
     when:
       - rke2_airgap_mode != "exists"
       - rke2_airgap_implementation != "exists"

   - name: Download RKE2 checksum and artifacts
     block:
       - get_url:
           url: "<checksum_file_url>"
           dest: "<checksum_file_destination>"
       - get_url:
           url: "<artifacts_url>"
           dest: "<artifacts_destination>"
       - get_url:
           url: "<install_script_url>"
           dest: "<install_script_destination>"
     when:
       - rke2_airgap_mode == "download"
       - rke2_airgap_implementation == "download"

   - name: Rescue for failed download
     block:
       - file:
           path: "<directory>"
           state: directory
       - local_action:
           module: get_url
           url: "<artifacts_url>"
           dest: "<local_artifacts_destination>"
       - local_action:
           module: get_url
           url: "<install_script_url>"
           dest: "<local_install_script_destination>"
       - copy:
           src: "<local_artifacts_destination>"
           dest: "<remote_artifacts_destination>"
       - copy:
           src: "<local_install_script_destination>"
           dest: "<remote_install_script_destination>"
     rescue:
       - debug:
           msg: "Failed to download RKE2 artifacts and install script,
             downloading locally and copying to remote hosts"
     when:
       - rke2_airgap_mode == "download"
       - rke2_airgap_implementation == "download"

   - name: Copy local RKE2 artifacts
     copy:
       src: "<local_artifacts_path>"
       dest: "<remote_rke2_artifact_path>"
       mode: 0640
       force: true
     when:
       - rke2_airgap_mode == "copy"
       - rke2_airgap_implementation == "copy"

   - name: Airgap mode - additional images tarballs
     block:
       - file:
           path: "<additional_images_tarballs_folder>"
           state: directory
       - copy:
           src: "<additional_tarballs_path>/"
           dest: "<rke2_tarball_images_path>"
     when:
       - rke2_airgap_mode is defined
       - rke2_airgap_copy_additional_tarballs | length > 0
       - rke2_airgap_implementation != "exists"

   - name: Ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ item }}"
       state: file
       mode: 0600
     loop:
       - "<artifact_path>"
       - "<install_script_path>"
     when:
       - rke2_airgap_mode == "exists"
       - rke2_airgap_implementation == "exists"

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: "/usr/local"
     register: usr_local_stats

   - name: Check if separate partition
     shell: grep '/usr/local' /proc/mounts
     register: usr_local_partition

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "{{ '/usr/local/bin' if usr_local_partition.stdout_lines |
         length > 0 else '/var/lib/rancher/rke2/bin' }}"

   - name: Check RKE2 version
     shell: "{{ rke2_bin_path }}/rke2 --version | head -n 1 | cut -d ' ' -f 2"
     register: rke2_version_check
     ignore_errors: true

   - name: Set RKE2 versions
     set_fact:
       rke2_installed_version: "{{ rke2_version_check.stdout }}"
       rke2_running_version: "{{ ansible_facts.services['rke2-server.service']
         ['state'] == 'running' | ternary(rke2_version_check.stdout, '') }}"
     when: not ansible_check_mode

   - name: Prevent accidental RKE2 downgrade
     fail:
       msg: "Attempted to downgrade RKE2 from {{ rke2_running_version }} to
         {{ rke2_installed_version }}"
     when:
       - rke2_running_version is defined
       - rke2_installed_version is defined
       - rke2_running_version != rke2_installed_version
       - not rke2_airgap_allow_downgrade

   - name: Run RKE2 install script
     shell: >-
       INSTALL_RKE2_VERSION={{ rke2_installed_version }} sh /tmp/rke2.sh
       {{ rke2_airgap_implementation == 'download' | ternary('--airgap-repository=/var/lib/rancher/rke2/airgap-images', '') }}
     when:
       - rke2_installed_version != rke2_running_version
       - not ansible_check_mode

   - name: Copy Custom Manifests
     copy:
