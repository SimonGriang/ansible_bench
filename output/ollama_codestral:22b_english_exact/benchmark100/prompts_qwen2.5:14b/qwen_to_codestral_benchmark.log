---
   - name: Restart RKE2 service
     service:
       name: "{{ rke2_service_name }}"
       state: restarted
     delegate_to: "{{ rke2_node_name }}"

   - name: Wait for all nodes to be ready again
     shell: "kubectl get nodes --no-headers | awk '{print $2}' | grep -v 'Ready'"
     register: k8s_nodes_not_ready
     until: k8s_nodes_not_ready.stdout == ""
     retries: 100
     delay: 15
     run_once: yes
     check_mode: yes
     delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

   - name: Wait for all pods to be ready again
     shell: "kubectl get pods --all-namespaces --no-headers | awk '{print $3}' | grep -v 'Running\\|Succeeded'"
     register: k8s_pods_not_ready
     until: k8s_pods_not_ready.stdout == ""
     retries: 100
     delay: 15
     run_once: yes
     when: rke2_wait_for_all_pods_to_be_ready
     check_mode: yes
     delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

