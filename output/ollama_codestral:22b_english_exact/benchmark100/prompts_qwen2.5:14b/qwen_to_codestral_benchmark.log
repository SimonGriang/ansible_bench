 - name: Check if python3.11 EXTERNALLY-MANAGED file exists
     stat:
       path: "/path/to/python3.11/EXTERNALLY-MANAGED"
     register: python311_managed

   - name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
     command: "mv /path/to/python3.11/EXTERNALLY-MANAGED /path/to/python3.11/EXTERNALLY-MANAGED.old"
     when: python311_managed.stat.exists

   - name: Check if python3.12 EXTERNALLY-MANAGED file exists
     stat:
       path: "/path/to/python3.12/EXTERNALLY-MANAGED"
     register: python312_managed

   - name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
     command: "mv /path/to/python3.12/EXTERNALLY-MANAGED /path/to/python3.12/EXTERNALLY-MANAGED.old"
     when: python312_managed.stat.exists

   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Install python pip
     pip:
       name: "{{ python_pip_packages }}"

   - name: Configure pip proxy
     blockinfile:
       path: /etc/pip.conf
       block: |
         [global]
         proxy = {{ python_pip_proxy }}
     when: python_pip_proxy is defined

   - name: Trust hosts
     blockinfile:
       path: /etc/pip.conf
       block: |
         [global]
         trusted-host = {{ python_pip_trusted_host }}
     when: python_pip_trusted_host is defined

   - name: Update pip
     pip:
       name: pip
       extra_args: "--upgrade-strategy only-if-needed"
     when: python_pip_update and ansible_distribution != 'Debian' and ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

   - name: Install requested modules
     pip:
       name: "{{ python_pip_modules }}"
     when: ansible_distribution != 'Debian' and ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

