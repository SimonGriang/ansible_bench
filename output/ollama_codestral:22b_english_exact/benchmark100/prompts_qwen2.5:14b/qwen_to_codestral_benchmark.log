 - name: "Install Keepalived"
     apt:
       name: keepalived
       state: present
     when: "'rke2-servers' in group_names and ha_mode"

   - name: "Download and install RKE2"
     get_url:
       url: "https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2.linux-amd64.tar.gz"
       dest: "/tmp/rke2.linux-amd64.tar.gz"
     notify: "Install RKE2"

   - name: "CIS Hardening"
     include_tasks: "cis_hardening.yml"
     when: cis_profile is defined

   - name: "Find Active Server"
     command: "kubectl get node -l 'node-role.kubernetes.io/master' -o jsonpath='{.items[0].metadata.name}'"
     register: active_server
     when: "'rke2-servers' in group_names"

   - name: "Enable IPVS kernel module"
     modprobe:
       name: ip_vs
       state: present
     when: "'rke2-servers' in group_names and ha_mode and use_kube_vip"

   - name: "Copy kube-vip manifests to the masternode"
     copy:
       src: "files/kube-vip.yaml"
       dest: "/etc/rancher/kube-vip.yaml"
     when: "'rke2-servers' in group_names and not use_keepalived"

   - name: "Copy ingress-nginx manifests to the masternode"
     copy:
       src: "files/ingress-nginx.yaml"
       dest: "/etc/rancher/ingress-nginx.yaml"
     when: ingress_nginx_config is defined

   - name: "Prepare very first server node in the cluster"
     include_tasks: "first_server_setup.yml"
     when: "'rke2-servers' in group_names and inventory_hostname == ansible_play_hosts_all[0]"

   - name: "Restore etcd specific tasks"
     include_tasks: "restore_etcd.yml"
     when: restore_etcd

   - name: "Download kubeconfig to ansible localhost"
     fetch:
       src: "/etc/rancher/rke2/rke2.yaml"
       dest: "kubeconfig"
       flat: yes
     when: download_kubeconfig

   - name: "Prepare and join remaining nodes of the cluster"
     include_tasks: "join_cluster.yml"
     when: "'rke2-servers' in group_names and active_server.stdout is defined"

   - name: "Rolling cordon and drain restart when version changes - servers"
     include_tasks: "rolling_restart.yml"
     vars:
       node_role: "master"
     when: "'rke2-servers' in group_names and rke2_version_changed"

   - name: "Rolling cordon and drain restart when version changes - agents"
     include_tasks: "rolling_restart.yml"
     vars:
       node_role: "worker"
     when: "'rke2-agents' in group_names and rke2_version_changed"

   - name: "Flush handlers"
     meta: flush_handlers

   - name: "Rolling restart when config files change"
     include_tasks: "rolling_restart.yml"
     vars:
       node_role: "master"
     when: "'rke2-servers' in group_names and config_files_changed"

   - name: "Final steps"
     include_tasks: "final_steps.yml"

