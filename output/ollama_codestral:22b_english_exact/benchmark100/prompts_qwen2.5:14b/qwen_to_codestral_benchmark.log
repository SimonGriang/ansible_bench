---
- name: Check current docker-compose version
  command: docker-compose --version
  register: docker_compose_check
  changed_when: false
  ignore_errors: true

- name: Set fact for current Docker Compose version
  set_fact:
    current_docker_compose_version: "{{ docker_compose_check.stdout.split(' ')[-1] }}"
  when: docker_compose_check.rc == 0

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: >
    current_docker_compose_version is defined
    and current_docker_compose_version != docker_compose_version

- name: Install Docker Compose (if configured)
  get_url:
    url: "https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-Linux-x86_64"
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when: >
    docker_compose_check.rc != 0
    or current_docker_compose_version is not defined
    or current_docker_compose_version != docker_compose_version

