---
   - name: hardening | Disable swap
     when: vault_hardening_disable_swap | bool
     block:
       - name: hardening | Disable swap now
         command: swapoff -a
         when: ansible_swaptotal_mb > 0

       - name: hardening | Disable swap permanently
         mount:
           name: swap
           fstype: swap
           state: absent

   - name: hardening | Disable core dumps
     when: vault_hardening_disable_core_dumps | bool
     sysctl:
       name: fs.suid_dumpable
       value: '0'
       state: present
       reload: yes

   - name: hardening | Disable Shell Command History
     when: vault_hardening_disable_shell_command_history | bool
     copy:
       dest: /etc/profile.d/disable_history.sh
       content: |
         HISTFILE=/dev/null

   - name: hardening | Configure SELinux / AppArmor
     when: vault_hardening_configure_selinux_apparmor | bool
     block:
       - name: hardening | Install selinux-policy
         package:
           name: selinux-policy
           state: present

       - name: hardening | Set SELinux policy
         selinux:
           policy: targeted
           state: enforcing

   - name: hardening | Enable AppArmor (enforcing)
     when:
       - vault_hardening_configure_selinux_apparmor | bool
       - ansible_facts['apparmor']['status']['enabled'] | bool
     systemd:
       name: apparmor
       enabled: yes
       state: started
       masked: no
     notify:
       - reload apparmor profiles

   - name: hardening | Configure AppArmor Profile for Vault Binary
     when:
       - vault_hardening_configure_selinux_apparmor | bool
       - ansible_facts['apparmor']['status']['enabled'] | bool
     copy:
       dest: /etc/apparmor.d/local/usr.bin.vault
       content: |
         # AppArmor profile for the Vault binary
         # Generated by Ansible
         /usr/bin/vault {
           # Allow read/write access to necessary directories and files
         }
     notify:
       - reload apparmor profiles

   - name: hardening | Reload AppArmor Profiles
     systemd:
       name: apparmor
       state: reloaded
     when:
       - vault_hardening_configure_selinux_apparmor | bool
       - ansible_facts['apparmor']['status']['enabled'] | bool
     listen:
       - reload apparmor profiles


