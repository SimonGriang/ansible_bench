 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install python pip
     package:
       name: "{{ python_pip_name }}"
       state: present

   - name: Configure pip proxy
     ini_file:
       path: /etc/pip.conf
       section: global
       option: proxy
       value: "{{ python_pip_proxy }}"
     when: python_pip_proxy is defined

   - name: Trust hosts
     ini_file:
       path: /etc/pip.conf
       section: global
       option: trusted-host
       value: "{{ python_pip_trusted_host }}"
     when: python_pip_trusted_host is defined

   - name: Update pip
     pip:
       name: pip
       state: latest
     when: >
       python_pip_update and
       ansible_distribution_release not in ['bookworm', 'noble'] and
       ansible_os_family != "Alpine"

   - name: Install requested modules
     pip:
       name: "{{ item.name }}"
       state: "{{ item.state | default('present') }}"
       version: "{{ item.version | default(omit) }}"
     loop: "{{ python_pip_modules }}"
     when: >
       ansible_distribution_release not in ['bookworm', 'noble'] and
       ansible_os_family != "Alpine"

