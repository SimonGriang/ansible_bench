     run_once: true

   - name: Install required packages
     package:
       name: "{{ grub_packages }}"
       state: present

   - name: Set GRUB_TIMEOUT
     lineinfile:
       dest: /etc/default/grub
       regexp: '^GRUB_TIMEOUT='
       line: 'GRUB_TIMEOUT={{ grub_timeout }}'
     notify: Update grub

   - name: Set GRUB_RECORDFAIL_TIMEOUT
     lineinfile:
       dest: /etc/default/grub
       regexp: '^GRUB_RECORDFAIL_TIMEOUT='
       line: 'GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}'
     notify: Update grub

   - name: Add options to GRUB_CMDLINE_LINUX
     lineinfile:
       dest: /etc/default/grub
       backrefs: yes
       regexp: '^(GRUB_CMDLINE_LINUX=(?!.*\s{{ item }}\s))'
       line: '\1 {{ item }}'
     with_items: '{{ grub_options }}'
     when: grub_options is defined and grub_options
     notify: Update grub

   - name: Import password.yml
     import_tasks: password.yml
     when: grub_set_password | bool

   - name: Flush handlers
     meta: flush_handlers

