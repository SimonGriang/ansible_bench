---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Enable redis module stream (RHEL 8)
     dnf:
       name: redis5-modules-stream
       state: present
     when: ansible_distribution_major_version == '8'

   - name: Install redis
     package:
       name: "{{ redis_packages }}"
       state: present

   - name: Configure redis
     template:
       src: redis.conf.j2
       dest: /etc/redis.conf
       owner: redis
       group: redis
       mode: '0640'
     notify: restart redis

   - name: Start and enable redis
     service:
       name: "{{ redis_service }}"
       state: started
       enabled: true


