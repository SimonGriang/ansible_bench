 - name: Create RKE2 config directory
     file:
       path: "{{ rke2_config_dir }}"
       state: directory

   - name: Set server taints
     shell: "kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml taint node {{ inventory_hostname }} {{ rke2_taints[rke2_type].server }}"
     when: rke2_type == 'server'

   - name: Set agent taints
     shell: "kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml taint node {{ inventory_hostname }} {{ rke2_taints[rke2_type].agent }}"
     when: rke2_type == 'agent'

   - name: Copy RKE2 config file
     template:
       src: rke2.yaml.j2
       dest: "{{ rke2_config_dir }}/config.yaml"
     notify: Restart RKE2 service

   - name: Copy kubelet config file
     template:
       src: kubelet.yaml.j2
       dest: "{{ rke2_config_dir }}/kubelet-config.yaml"
     when: kubelet_config is defined and kubelet_config
     notify: Restart RKE2 service

   - name: Copy Containerd Registry Configuration file
     template:
       src: registries.yaml.j2
       dest: "{{ rke2_config_dir }}/registries.yaml"
     when: containerd_registry_config is defined and containerd_registry_config
     notify: Restart RKE2 service

   - name: Start RKE2 service
     service:
       name: rke2-server.service
       state: started
     until: rke2_service.status.ActiveState == 'active'
     retries: 10
     delay: 10
     notify: Restart RKE2 service
     register: rke2_service

   - name: Mask other RKE2 services
     systemd:
       name: "{{ item }}"
       masked: yes
     loop:
       - rke2-agent.service
       - rke2-ingress.service
     when: rke2_type != 'server'

   - name: Wait for remaining nodes to be ready - no CNI
     shell: "kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=Ready nodes --all --timeout=600s"
     register: node_check
     until: node_check is succeeded
     retries: 10
     delay: 30
     when: rke2_type == 'server' and (not containerd_registry_config or not containerd_registry_config.cni)

   - name: Wait for remaining nodes to be ready - with CNI
     shell: "kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml wait --for=condition=Ready nodes --all --timeout=600s"
     register: node_check
     until: node_check is succeeded and node_status.resources|length == node_status.ready_replicas
     retries: 10
     delay: 30
     when: rke2_type == 'server' and containerd_registry_config and containerd_registry_config.cni

