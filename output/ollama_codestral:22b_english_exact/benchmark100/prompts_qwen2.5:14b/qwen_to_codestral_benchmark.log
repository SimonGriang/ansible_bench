   - name: Configure oracle targz
     block:
       - unarchive:
           src: "/path/to/local/oracle-java.targz"
           dest: "/opt/"
           remote_src: yes
       - file:
           path: "/opt/java"
           state: directory

   - name: Install oracle java policy software (targz)
     copy:
       src: "/path/to/local/jce_policy-8.zip"
       dest: "/opt/java/jre/lib/security/"

   - name: Set alternative (targz)
     alternatives:
       name: java
       link: /usr/bin/java
       path: /opt/java/bin/java
     when: ansible_os_family != "Alpine"

   - name: Find JAVA_HOME
     command: "readlink -f /usr/bin/java | sed 's:/bin/java::'"
     register: java_home_path

   - name: Set JAVA_HOME in /etc/environment
     lineinfile:
       path: /etc/environment
       regexp: '^JAVA_HOME='
       line: 'JAVA_HOME={{ java_home_path.stdout }}'
     

