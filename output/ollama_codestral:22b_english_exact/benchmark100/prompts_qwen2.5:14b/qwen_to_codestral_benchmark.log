---
   - name: Remove old versions of Docker
     package:
       name:
         - docker
         - docker-engine
         - docker.io
       state: absent

   - name: Add Docker GPG key
     apt_key:
       url: https://download.docker.com/linux/{{ ansible_distribution | lower }}/gpg
       state: present

   - name: Add Docker repository
     apt_repository:
       repo: deb [arch=amd64] https://download.docker.com/linux/{{ ansible_distribution | lower }} {{ ansible_distribution_release }} stable
       state: present

   - name: Configure Docker Nightly repo
     apt_repository:
       repo: deb [arch=amd64] https://download.docker.com/linux/{{ ansible_distribution | lower }} {{ ansible_distribution_release }} nightly
       state: present
     when: docker_nightly_repo | bool

   - name: Configure Docker Test repo
     apt_repository:
       repo: deb [arch=amd64] https://download.docker.com/linux/{{ ansible_distribution | lower }} {{ ansible_distribution_release }} test
       state: present
     when: docker_test_repo | bool

   - name: Configure containerd on RHEL 8
     block:
       - name: Ensure runc is not installed
         package:
           name: runc
           state: absent

       - name: Ensure container-selinux and containerd.io are installed
         package:
           name:
             - container-selinux
             - containerd.io
           state: present
     when: ansible_distribution == 'RedHat' and ansible_distribution_major_version == '8'

