---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install apache httpd
     package:
       name: "{{ httpd_packages }}"
       state: present

   - name: Configure selinux
     block:
       - seboolean:
           name: "{{ item }}"
           state: true
           persistent: true
         loop: "{{ selinux_booleans }}"
       - seport:
           ports: "{{ item }}"
           proto: tcp
           setype: http_port_t
           state: present
         loop: "{{ selinux_ports }}"
     when: ansible_selinux.status == 'enabled'

   - name: Configure httpd
     template:
       src: "{{ src }}"
       dest: "{{ dest }}"
     notify:
       - test httpd configuration
       - restart httpd

   - name: Activate httpd module | Debian
     command: a2enmod "{{ item }}"
     loop: "{{ httpd_modules }}"
     when: ansible_os_family == 'Debian'
     notify:
       - test httpd configuration
       - restart httpd

   - name: Import ssl.yml
     import_tasks: ssl.yml
     when: httpd_ssl == true

   - name: Import locations.yml
     import_tasks: locations.yml
     when: httpd_locations is defined

   - name: Import vhosts.yml
     import_tasks: vhosts.yml
     when: httpd_vhosts is defined

   - name: Configure ports
     template:
       src: "{{ httpd_ports_configuration }}"
       dest: "{{ httpd_ports_destination }}"
     notify:
       - test httpd configuration
       - restart httpd
     when: ansible_os_family == 'Debian' or ansible_os_family == 'Suse'

   - name: Import directories.yml
     import_tasks: directories.yml
     when: httpd_directories is defined

   - name: Flush handlers
     meta: flush_handlers

   - name: Removing default html
     file:
       path: /var/www/html/index.html
       state: absent
     when: httpd_remove_example == true

   - name: Start and enable httpd
     service:
       name: "{{ httpd_service }}"
       state: started
       enabled: true

   - name: Import firewall.yml
     import_tasks: firewall.yml
     when: httpd_open_firewall == true

