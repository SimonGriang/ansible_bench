 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: yes

   - name: Install apache httpd
     package:
       name: "{{ httpd_packages }}"
       state: present

   - name: Configure selinux
     block:
       - name: Allow connections to custom ports
         seboolean:
           name: "{{ item.name }}"
           state: yes
           persistent: yes
         with_items: "{{ httpd_selinux_booleans }}"
     when: ansible_selinux.status == "enabled"

   - name: Configure httpd
     template:
       src: "{{ httpd_config_file }}.j2"
       dest: "{{ httpd_config_file }}"
     notify:
       - Test httpd configuration
       - Restart httpd

   - name: Activate httpd module | Debian
     command: "a2enmod {{ item }}"
     with_items: "{{ httpd_enabled_modules }}"
     notify:
       - Test httpd configuration
       - Restart httpd
     when: ansible_os_family == 'Debian'

   - name: Import ssl.yml
     import_tasks: ssl.yml
     when: httpd_ssl_enabled | bool

   - name: Import locations.yml
     import_tasks: locations.yml
     when: httpd_locations | length > 0

   - name: Import vhosts.yml
     import_tasks: vhosts.yml
     when: httpd_vhosts | length > 0

   - name: Configure ports
     template:
       src: "{{ httpd_ports_file }}.j2"
       dest: "{{ httpd_ports_file }}"
     notify:
       - Test httpd configuration
       - Restart httpd
     when: ansible_os_family == 'Debian' or ansible_os_family == 'Suse'

   - name: Import directories.yml
     import_tasks: directories.yml
     when: httpd_directories | length > 0

   - name: Flush handlers
     meta: flush_handlers

   - name: Removing default html
     file:
       path: "{{ httpd_default_html_file }}"
       state: absent
     when: httpd_remove_example | bool

   - name: Start and enable httpd
     service:
       name: "{{ httpd_service }}"
       state: started
       enabled: yes

