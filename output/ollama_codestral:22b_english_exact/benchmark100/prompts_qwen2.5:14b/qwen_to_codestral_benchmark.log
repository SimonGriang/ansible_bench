       src: "{{ item }}"
       dest: "/etc/rsyslog.d/{{ item | basename }}"
       mode: '0644'
       owner: root
       group: root
     loop: "{{ rsyslog_additional_config_files }}"

   - name: Start and enable rsyslog
     systemd:
       name: rsyslog
