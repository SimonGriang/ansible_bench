       name: etcd
       state: present
       system: true

   - name: Create etcd user
     user:
       name: etcd
       comment: etcd user
       group: etcd
       shell: /bin/nologin
       system: true

   - name: Copy systemctl config file for kernel hardening
     copy:
       src: >-
