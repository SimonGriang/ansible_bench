       path: /var/lib/promtail
       state: directory
       mode: '0755'
       owner: promtail
       group: promtail
     become: yes

   - name: Check if the promtail binary exists
     stat:
       path: /usr/local/bin/promtail
     register: promtail_binary

   - name: Download promtail binaries
     get_url:
       url: "{{ promtail_url }}"
       dest: /tmp/promtail.zip
       mode: '0644'
     when: not promtail_binary.stat.exists and not promtail_local_propagation and not promtail_propagation

   - name: Propagate locally distributed promtail archive
     copy:
       src: "{{ promtail_local_archive_path }}"
       dest: /tmp/promtail.zip
       mode: '0644'
     when: not promtail_binary.stat.exists and promtail_local_propagation

   - name: Download promtail binaries to controller node
     get_url:
