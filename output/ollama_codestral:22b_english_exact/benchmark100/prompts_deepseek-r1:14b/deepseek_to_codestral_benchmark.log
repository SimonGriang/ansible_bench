       dest: "{{ rke2_artifacts_path }}/{{ item }}"
       mode: '0640'
     with_items: "{{ rke2_artifacts }}"
     when: airgap_mode and use_copy

   - name: Airgap mode - additional images tarballs
     block:
       - name: Create additional images tarballs directory
         file:
           path: "{{ rke2_additional_images_path }}"
           state: directory

       - name: Copy additional images tarballs
         copy:
           src: "{{ item }}"
           dest: "{{ rke2_additional_images_path }}/"
         with_items: "{{ rke2_additional_images_tarballs }}"
     when: airgap_mode and rke2_additional_images_tarballs is defined

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ item }}"
       mode: '{{ "0700" if item.endswith(".sh") else "0640" }}'
     with_items:
       - "{{ rke2_artifacts_path }}/rke2-install.sh"
       - "{{ rke2_artifacts_path }}/{{ rke2_artifact_file }}"
     when: airgap_mode and use_exists

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: /usr/local
     register: usr_local_stat

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "{{ '/opt/rke2' if usr_local_stat.stat.writeable or
         usr_local_stat.stat.isblk else '/usr/local/bin' }}"

   - name: Check RKE2 version
     command: "{{ rke2_bin_path }}/bin/rke2 --version"
     register: rke2_version_check
     ignore_errors: true

   - name: Prevent accidental RKE2 downgrade
     assert:
       that:
         - not rke2_version_check.failed or
           (rke2_version_check.stdout | regex_replace('^rke2 version v', '') |
           version_compare(rke2_version, '>=')) or allow_rke2_downgrade | bool
       msg: "Downgrading RKE2 is not allowed"

   - name: Run RKE2 install script
     command: >-
       {{ rke2_artifacts_path }}/rke2-install.sh
       {{ '--airgap-repository=/tmp/rke2-airgap-images' if airgap_mode else '' }}
     environment:
       INSTALL_RKE2_TYPE: "{{ rke2_type }}"
       INSTALL_RKE2_VERSION: "{{ rke2_version }}"
       INSTALL_RKE2_EXEC: "{{ 'server' if rke2_type == 'server' else 'agent' }}"

   - name: Copy Custom Manifests
     template:
       src: custom_manifests.yaml.j2
       dest: "{{ rke2_config_path }}/manifests/custom-manifests.yaml"
     when: custom_manifests is defined

   - name: Copy Static Pods
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_agent_config_path }}/pod-manifests/"
     with_fileglob:
       - "{{ static_pods_path }}/*.yaml"
     when: static_pods_path is defined

   - name: Copy RKE2 environment file
     template:
       src: rke2-env.j2
       dest: "/etc/default/rke2"
       mode: '0644'
     when: rke2_env_options is defined
