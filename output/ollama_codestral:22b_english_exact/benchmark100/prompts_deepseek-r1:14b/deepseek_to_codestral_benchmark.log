           src: "{{ item }}"
           dest: "{{ rke2_additional_images_path }}/"
         with_items: "{{ rke2_additional_images_tarballs }}"
     when: airgap_mode and rke2_additional_images_tarballs is defined

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ item }}"
       mode: '{{ "0700" if item.endswith(".sh") else "0640" }}'
     with_items:
