---
   - name: Restart RKE2 service
     service:
       name: "{{ rke2_node_name }}.service"
       state: restarted
     notify: Service (re)started

   - name: Wait for all nodes to be ready again
     shell: >
       kubectl get nodes --no-headers |
       awk '{print $2}' |
       grep -v "Ready" |
       wc -l
     register: nodes_not_ready
     until: nodes_not_ready.stdout == "0"
     retries: 100
     delay: 15
     delegate_to: >
       {{ groups[rke2_servers_group_name].0
       if rke2_servers_group_name in groups else
       groups['all'][0] }}
     when: not ansible_check_mode

   - name: Wait for all pods to be ready again
     shell: >
       kubectl get pods --all-namespaces --no-headers |
       awk '{print $3}' |
       grep -v "Running" |
       wc -l
     register: pods_not_ready
     until: pods_not_ready.stdout == "0"
     retries: 100
     delay: 15
     delegate_to: >
       {{ groups[rke2_servers_group_name].0
       if rke2_servers_group_name in groups else
       groups['all'][0] }}
     when: >
       not ansible_check_mode and
       rke2_wait_for_all_pods_to_be_ready


