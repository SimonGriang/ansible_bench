 - name: Import assertions
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: yes

   - name: Install using package
     block:
       - name: Configure debian
         when: ansible_os_family == 'Debian'
         block:
           - name: Add HashiCorp GPG key
             ansible.builtin.apt_key:
               url: https://apt.releases.hashicorp.com/gpg
               state: present

           - name: Add HashiCorp apt repository
             ansible.builtin.apt_repository:
               repo: "deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_lsb.codename }} main"
               state: present

       - name: Install HashiCorp product using package
         block:
           - name: Install HashiCorp product (Latest)
             ansible.builtin.package:
               name: hashicorp-product
               state: present
             when: hashicorp_product_version == 'latest'

           - name: Install HashiCorp product (Specific version)
             ansible.builtin.package:
               name: "hashicorp-product={{ hashicorp_product_version }}"
               state: present
             when: hashicorp_product_version != 'latest'
     become: yes

   - name: Install manually
     ansible.builtin.unarchive:
       src: "https://releases.hashicorp.com/hashicorp-product/{{ hashicorp_product_version }}/hashicorp-product_{{ hashicorp_product_version }}_linux_amd64.zip"
       dest: /usr/local/bin
       remote_src: yes
       mode: 0755
     become: yes
     when: hashicorp_product_install_method == 'manual'

