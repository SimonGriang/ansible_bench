 - name: Import assertion tasks
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: yes

   - name: Install Python pip
     package:
       name: "{{ python_pip_packages }}"
       state: present

   - name: Configure pip proxy settings
     blockinfile:
       path: /etc/pip.conf
       insertafter: '[global]'
       block: |
         index-url = {{ python_pip_proxy }}
     when: python_pip_proxy is defined

   - name: Configure pip trusted hosts
     blockinfile:
       path: /etc/pip.conf
       insertafter: '[global]'
       block: |
         trusted-host = {{ python_pip_trusted_host }}
     when: python_pip_trusted_host is defined

   - name: Update pip
     pip:
       name: pip
       state: latest
     when: ansible_distribution not in ['Debian', 'Ubuntu'] or ansible_distribution_release not in ['bookworm', 'noble'] or ansible_os_family != 'Alpine'

   - name: Install Python modules
     pip:
       name: "{{ item.name }}"
       state: "{{ item.state | default('present') }}"
       version: "{{ item.version | default(omit) }}"
     with_items: "{{ python_pip_modules }}"
     loop_control:
       label: "{{ item.name }}"
     when: ansible_distribution not in ['Debian', 'Ubuntu'] or ansible_distribution_release not in ['bookworm', 'noble'] or ansible_os_family != 'Alpine'

