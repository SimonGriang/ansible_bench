---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install git
     package:
       name: git
       state: present

   - name: Check if user exists
     command: "id -u {{ user_name }}"
     register: user_exists
     ignore_errors: true

   - name: Create git config directory
     file:
       path: "/home/{{ user_name }}/.config/git"
       state: directory
       mode: '0755'

   - name: Place git configuration
     template:
       src: gitconfig.j2
       dest: "/home/{{ user_name }}/.gitconfig"
       mode: '0644'

   - name: Create repository destination
     file:
       path: "/home/{{ user_name }}/repos"
       state: directory
       mode: '0755'

   - name: Clone all repositories
     git:
       repo: "{{ item.repo }}"
       dest: "/home/{{ user_name }}/repos/{{ item.dest }}"
       version: "{{ item.version }}"
       accept_hostkey: yes
       key_file: "/home/{{ user_name }}/.ssh/id_rsa"
     loop:
       - { repo: 'git@github.com:repo1.git', dest: 'repo1', version: 'main' }
       - { repo: 'git@github.com:repo2.git', dest: 'repo2', version: 'develop' }
     become: true
     become_user: "{{ user_name }}"

