---
   - name: locations | Enable modules
     apache2_module:
       state: present
       name: "{{ item }}"
     loop:
       - proxy
       - proxy_http
     when: ansible_os_family == "Debian" or ansible_os_family == "Suse"
     notify: restart apache

   - name: locations | Configure locations
     template:
       src: locations.conf.j2
       dest: /etc/httpd/conf.d/locations.conf
     loop: "{{ httpd_locations }}"
     notify: restart apache

   - name: Flush handlers
     meta: flush_handlers

   - name: Ensure Apache is running
     systemd:
       name: httpd
       state: started

