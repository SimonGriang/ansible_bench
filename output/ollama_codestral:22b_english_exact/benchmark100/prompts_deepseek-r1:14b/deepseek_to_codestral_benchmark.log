---
   - name: Import assertion tasks
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install required software packages
     package:
       name: "{{ users_requirements }}"
       state: present
     when: users_requirements | length > 0

   - name: Manage user groups
     include_tasks: group.yml
     loop: "{{ users_groups }}"
     loop_control:
       loop_var: group

   - name: Configure sudoers directory inclusion
     lineinfile:
       path: /etc/sudoers
       line: '#includedir /etc/sudoers.d'
       state: present
     check_mode: true
     register: sudoers_check
     changed_when: false
     failed_when: sudoers_check.failed or ('missing' in sudoers_check.msg)

   - name: Manage user configurations
     include_tasks: user.yml
     loop: "{{ users }}"
     loop_control:
       loop_var: user

   - name: Configure cron allow permissions
     template:
       src: cron.allow.j2
       dest: /etc/cron.allow
       mode: '0644'
     when: users_cron_allow

   - name: Remove cron allow file if not needed
     file:
       path: /etc/cron.allow
       state: absent
     when: not users_cron_allow

   - name: Validate sudoers file changes
     command: visudo -c
     changed_when: false

