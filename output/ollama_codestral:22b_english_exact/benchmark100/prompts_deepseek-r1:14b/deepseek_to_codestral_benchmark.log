---
- name: Create RKE2 configuration directory
  file:
    path: "/etc/rancher/rke2"
    state: directory
    mode: '0755'

- name: Set server taints
  lineinfile:
    path: "/etc/rancher/rke2/config.yaml"
    line: 'server-taint: ["CriticalAddonsOnly=true:NoExecute"]'
    create: yes
    mode: '0644'
  when: node_type == 'server'
  notify: Restart RKE2 service

- name: Set agent taints
  lineinfile:
    path: "/etc/rancher/rke2/config.yaml"
    line: 'agent-taint: ["CriticalAddonsOnly=true:NoExecute"]'
    create: yes
    mode: '0644'
  when: node_type == 'agent'
  notify: Restart RKE2 service

- name: Copy RKE2 configuration file
  template:
    src: "rke2_config.yml.j2"
    dest: "/etc/rancher/rke2/config.yaml"
    mode: '0644'
  notify: Restart RKE2 service

- name: Copy Kubelet configuration file
  template:
    src: "kubelet_config.yml.j2"
    dest: "/etc/rancher/rke2/kubelet-config.yaml"
    mode: '0644'
  when: kubelet_config is defined
  notify: Restart RKE2 service

- name: Copy Containerd Registry Configuration file
  copy:
    src: "/path/to/custom/registry/config.toml"
    dest: "/etc/rancher/rke2/registries.yaml"
    mode: '0644'
  when: custom_registry is defined
  notify: Restart RKE2 service

- name: Start RKE2 service on other nodes
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
  when: inventory_hostname != ansible_hostname
  notify: Wait for node to be ready

- name: Mask other RKE2 services on nodes
  systemd:
    name: "{{ 'rke2-server.service' if node_type == 'agent' else 'rke2-agent.service' }}"
    masked: yes

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    host: "{{ item }}"
    port: 6443
    timeout: 600
  loop: "{{ groups['rke2'] | difference([inventory_hostname]) }}"
  when: cni_configured is not defined

- name: Wait for remaining nodes to be ready - with CNI
  uri:
    url: "https://{{ item }}:6443/readyz"
    validate_certs: no
    status_code: 200
  loop: "{{ groups['rke2'] | difference([inventory_hostname]) }}"
  register: result
  until: result.status == 200
  retries: 10
  delay: 30
  when: cni_configured is defined
  

