 - name: Create RKE2 config directory
     file:
       path: "{{ rke2_config_dir }}"
       state: directory
       mode: '0755'

   - name: Set server taints
     shell: >
       {{ rke2_bin_dir }}/kubectl --kubeconfig {{ rke2_config_dir }}/kubeconfig.yaml
       patch node {{ inventory_hostname }}
       -p '{"spec": {"taints": [{{ rke2_server_node_taints }}]}}'
     when: rke2_role == "server"

   - name: Copy RKE2 configuration file
     copy:
       src: "{{ rke2_config_src }}"
       dest: "{{ rke2_config_dir }}/config.yaml"
       mode: '0644'
     notify: restart rke2

   - name: Copy kubelet configuration file
     copy:
       content: "{{ rke2_kubelet_config | to_nice_yaml }}"
       dest: "{{ rke2_config_dir }}/kubelet-config.yaml"
       mode: '0644'
     when: rke2_kubelet_config | length > 0
     notify: restart rke2

   - name: Copy Containerd Registry Configuration file
     copy:
       src: "{{ rke2_containerd_registry_config_src }}"
       dest: "{{ rke2_config_dir }}/registry-config.yaml"
       mode: '0644'
     when: rke2_containerd_registry_config is defined
     notify: restart rke2

   - name: Register etcd restore from file
     set_fact:
       rke2_etcd_restore_from_file: "true"
     when:
       - rke2_etcd_snapshot_restore_src is defined
       - not rke2_service_state.status.Active

   - name: Register etcd restore from S3
     set_fact:
       rke2_etcd_restore_from_s3: "true"
     when:
       - rke2_etcd_s3_bucket is defined
       - rke2_etcd_s3_access_key is defined
       - rke2_etcd_s3_secret_key is defined
       - rke2_etcd_s3_endpoint is defined
       - not rke2_service_state.status.Active

   - name: Restore etcd from file
     block:
       - name: Create directories for etcd restore
         file:
           path: "{{ item }}"
           state: directory
           mode: '0755'
         loop:
           - "{{ rke2_data_dir }}/db/snapshots/"
           - "{{ rke2_data_dir }}/db/member/"

       - name: Copy etcd snapshot file
         copy:
           src: "{{ rke2_etcd_snapshot_restore_src }}"
           dest: "{{ rke2_data_dir }}/db/snapshots/etcd-snapshot-restore.db"
           mode: '0644'

       - name: Run etcd restore command
         command: >-
           {{ rke2_bin_dir }}/etcdctl --endpoints=https://127.0.0.1:2379
           --cacert={{ rke2_data_dir }}/server-tls/etcd-server-ca-cert.pem
           --cert={{ rke2_data_dir }}/server-tls/etcd-server-cert.pem
           --key={{ rke2_data_dir }}/server-tls/etcd-server-key.pem
           snapshot restore {{ rke2_data_dir }}/db/snapshots/etcd-snapshot-restore.db
     when: rke2_etcd_restore_from_file

   - name: Restore etcd from S3
     command: >-
       {{ rke2_bin_dir }}/etcdctl --endpoints=https://127.0.0.1:2379
       --cacert={{ rke2_data_dir }}/server-tls/etcd-server-ca-cert.pem
       --cert={{ rke2_data_dir }}/server-tls/etcd-server-cert.pem
       --key={{ rke2_data_dir }}/server-tls/etcd-server-key.pem
       snapshot restore --data-dir {{ rke2_data_dir }}/db/snapshots/
       --name etcd-snapshot-restore {{ rke2_etcd_s3_endpoint }}
       {{ rke2_etcd_s3_bucket }} {{ rke2_etcd_s3_access_key }}
       {{ rke2_etcd_s3_secret_key }}
     when: rke2_etcd_restore_from_s3

   - name: Start RKE2 service
     systemd:
       name: rke2-server
       state: started
       enabled: yes
       daemon_reload: yes
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     notify: restart rke2

   - name: Mask RKE2 agent service
     systemd:
       name: rke2-agent
       state: stopped
       enabled: no
       masked: yes

   - name: Wait for first server to be ready (no CNI)
     command: >-
       {{ rke2_bin_dir }}/kubectl --kubeconfig {{ rke2_config_dir }}/kubeconfig.yaml
       wait --for=jsonpath='{.status.conditions[?(@.type==\"Ready\")].status}==\"True\"'
       --timeout=5m node {{ inventory_hostname }}
     when: rke2_cni_plugin is not defined

   - name: Wait for first server to be ready (with CNI)
     command: >-
       {{ rke2_bin_dir }}/kubectl --kubeconfig {{ rke2_config_dir }}/kubeconfig.yaml
       wait --for=condition=ready --timeout=5m node {{ inventory_hostname }}
     when: rke2_cni_plugin is defined

   - name: Restore etcd
     block:
       - name: Clean up old nodes and secrets
         shell: |
           {{ rke2_bin_dir }}/kubectl --kubeconfig {{ rke2_config_dir }}/kubeconfig.yaml get nodes -o name | grep -v {{ inventory_hostname }} | xargs -I {} {{ rke2_bin_dir }}/kubectl --kubeconfig {{ rke2_config_dir }}/kubeconfig.yaml delete {}
           {{ rke2_bin_dir }}/kubectl --kubeconfig {{ rke2_config_dir }}/kubeconfig.yaml get secrets -n kube-system rke2-etcd-snapshot-* -o name | xargs -I {} {{ rke2_bin_dir }}/kubectl --kubeconfig {{ rke2_config_dir }}/kubeconfig.yaml delete {}
     when: rke2_etcd_restore_from_file or rke2_etcd_restore_from_s3

   - name: Set Active Server variable
     set_fact:
       rke2_active_server: "{{ inventory_hostname }}"
     delegate_to: "{{ item }}"
     delegate_facts: true
     loop: "{{ groups['rke2_cluster'] }}"

