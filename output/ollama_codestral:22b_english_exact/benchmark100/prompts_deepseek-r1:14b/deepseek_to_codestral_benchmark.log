---
   - name: hardening | Disable swap
     command: swapoff -a
     when: vault_hardening_disable_swap | bool
     tags: hardening

   - name: hardening | Disable core dumps
     pam_limits:
       domain: '*'
       limit_type: 'soft'
       limit_item: core
       value: 0
     when: vault_hardening_disable_core_dumps | bool
     tags: hardening

   - name: hardening | Disable Shell Command History
     blockinfile:
       path: /etc/profile.d/vault.sh
       block: |
         if [ "$BASH" ]; then
           HISTCONTROL=ignorespace:erasedups
           HISTSIZE=0
           HISTFILESIZE=0
           shopt -u histappend
           export HISTCONTROL HISTSIZE HISTFILESIZE
         fi
       create: yes
     when: vault_hardening_disable_shell_command_history | bool
     tags: hardening

   - name: hardening | Configure SELinux / AppArmor
     block:
       - name: Enable SELinux
         selinux:
           policy: targeted
           state: enforcing

       - name: Install required SELinux policies
         package:
           name: selinux-policy-vault
           state: present

       - name: Enforce AppArmor profiles for Vault
         apparmor:
           name: vault
           state: enforcing
     when: vault_hardening_configure_selinux_apparmor | bool
     tags: hardening

