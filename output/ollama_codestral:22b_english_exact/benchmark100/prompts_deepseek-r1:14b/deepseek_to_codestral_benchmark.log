---
   - name: Import assertion file
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Install system requirements
     package:
       name: bash
       state: present

   - name: Install OpenJDK Java
     package:
       name: "java-{{ java_version }}-openjdk-devel"
       state: present
     when: java_vendor == 'openjdk'

   - name: Install Oracle Java RPM from local
     block:
       - name: Copy Oracle Java RPM package
         copy:
           src: /path/to/oracle-java-{{ java_version }}-rpm.rpm
           dest: /tmp/oracle-java-{{ java_version }}-rpm.rpm
       - name: Install Oracle Java RPM package
         package:
           name: /tmp/oracle-java-{{ java_version }}-rpm.rpm
           state: present
     when: java_source == 'local' and java_format == 'rpm'

   - name: Install Oracle Java DEB from local
     block:
       - name: Copy Oracle Java DEB package
         copy:
           src: /path/to/oracle-java-{{ java_version }}-deb.deb
           dest: /tmp/oracle-java-{{ java_version }}-deb.deb
       - name: Install Oracle Java DEB package
         package:
           name: /tmp/oracle-java-{{ java_version }}-deb.deb
           state: present
     when: java_source == 'local' and java_format == 'deb'

   - name: Install Oracle Java RPM from repository
     package:
       name: "oracle-java-{{ java_version }}-rpm"
       state: present
     when: java_source == 'repository' and java_format == 'rpm'

   - name: Configure Oracle Java targz installation
     block:
       - name: Extract Oracle Java targz package
         unarchive:
           src: /path/to/oracle-java-{{ java_version }}-targz.tar.gz
           dest: /opt/
       - name: Install Oracle Java targz package
         command: "/opt/oracle-java-{{ java_version }}-targz/install.sh"
     when: java_format == 'targz' and java_vendor == 'oracle'

   - name: Install Oracle Java JCE policy
     copy:
       src: /path/to/jce_policy-{{ java_version }}.jar
       dest: "/opt/oracle-java-{{ java_version }}/lib/security/"
     when: java_jce and java_version == 8 and java_vendor == 'oracle'

   - name: Set Java alternative
     alternatives:
       name: java
       link: /usr/bin/java
       path: "/opt/oracle-java-{{ java_version }}/bin/java"
     when: java_format == 'targz' and distribution != 'Alpine'

   - name: Find Java home directory
     command: readlink -f /usr/bin/java
     register: java_home
     changed_when: false

   - name: Set JAVA_HOME in environment
     lineinfile:
       path: /etc/profile.d/java_home.sh
       line: 'export JAVA_HOME={{ java_home.stdout | dirname }}'
       create: yes
       mode: '0644'
   

