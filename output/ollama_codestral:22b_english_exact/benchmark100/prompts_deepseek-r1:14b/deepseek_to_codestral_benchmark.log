---
- name: Import assert
  import_tasks: assert.yml

- name: Install logrotate
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  template:
    src: "{{ logrotate_config_file }}.j2"
    dest: "{{ logrotate_config_directory }}"

- name: Generate logrotate.d files
  template:
    src: "{{ item.file }}.j2"
    dest: "{{ logrotate_d_directory }}/{{ item.file }}"
  loop: "{{ logrotate_entries }}"
  when: not item.state | default('present') == 'absent'

- name: Remove logrotate.d files
  file:
    path: "{{ logrotate_d_directory }}/{{ item.file }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  when: item.state | default('present') == 'absent'

- name: Start logrotate
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state | default('started') }}"
    enabled: "{{ logrotate_service_enabled | default(true) }}"
  when: logrotate_service is defined


