---
   - name: Create local SSH key directory for user
     file:
       path: "{{ ssh_key_dir }}"
       state: directory
       owner: "{{ user }}"
       mode: '0750'

   - name: Manage user account
     user:
       name: "{{ user }}"
       state: "{{ user_state }}"
       comment: "{{ user_comment }}"
       home: "{{ user_home_directory }}"
       shell: "{{ user_shell }}"

   - name: Set sudo options for user
     copy:
       content: "{{ user }} ALL=(ALL) NOPASSWD: ALL"
       dest: "/etc/sudoers.d/{{ user }}"
       mode: '0440'

   - name: Generate private SSH key for user
     command: "{{ ssh_keygen_command }}"
     args:
       creates: "{{ private_key_file }}"

   - name: Generate public SSH key for user
     command: "ssh-keygen -y -f {{ private_key_file }} > {{ public_key_file }}"
     args:
       creates: "{{ public_key_file }}"

   - name: Convert SSH key to ppk format for user
     command: "puttygen {{ private_key_file }} -o {{ ppk_key_file }}"
     args:
       creates: "{{ ppk_key_file }}"

   - name: Get or set the home directory for user
     shell: echo ~{{ user }}
     register: user_home_directory
     when: user_home_directory is not defined

   - name: Create .ssh directory for user
     file:
       path: "{{ user_home_directory.stdout }}/.ssh"
       state: directory
       owner: "{{ user }}"
       mode: '0700'

   - name: Deploy authorized keys for user
     authorized_key:
       user: "{{ user }}"
       key: "{{ lookup('file', '{{ authorized_key_file }}') }}"
       state: present

   - name: Remove unauthorized keys for user
     authorized_key:
       user: "{{ user }}"
       key: "{{ item }}"
       state: absent
     with_items: "{{ unauthorized_keys }}"

   - name: Copy generated private SSH key for user
     copy:
       src: "{{ private_key_file }}"
       dest: "{{ user_home_directory.stdout }}/"
       owner: "{{ user }}"
       mode: '0600'

   - name: Check users password valid time for user
     shell: chage -l {{ user }}
     register: chage_output
     changed_when: false

   - name: Set users password valid time for user
     command: "chage -M {{ password_max_days }} -m {{ password_min_days }} -W {{ password_warn_days }} {{ user }}"

   - name: Place private key file for user
     copy:
       src: "{{ private_key_file }}"
       dest: "{{ user_home_directory.stdout }}/.ssh/id_rsa"
       owner: "{{ user }}"
       mode: '0600'

