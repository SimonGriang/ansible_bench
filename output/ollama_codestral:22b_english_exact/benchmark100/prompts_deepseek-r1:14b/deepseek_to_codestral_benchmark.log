 - name: Create /etc/openvpn/easy-rsa directory
    file:
      path: /etc/openvpn/easy-rsa
      state: directory
      mode: '0755'

  - name: Initialize OpenVPN PKI structure
    command: easyrsa init-pki chdir=/etc/openvpn/easy-rsa creates=/etc/openvpn/easy-rsa/pki

  - name: Generate OpenVPN CA certificate
    command: easyrsa build-ca nopass chdir=/etc/openvpn/easy-rsa creates=/etc/openvpn/easy-rsa/pki/ca.crt
    environment:
      EASYRSA_BATCH: 'yes'

  - name: Generate Diffie-Hellman parameters
    command: easyrsa gen-dh chdir=/etc/openvpn/easy-rsa creates=/etc/openvpn/easy-rsa/pki/dh.pem

  - name: Generate server certificate
    command: easyrsa build-server-full server nopass chdir=/etc/openvpn/easy-rsa creates=/etc/openvpn/easy-rsa/pki/issued/server.crt
    environment:
      EASYRSA_BATCH: 'yes'

  - name: Generate client certificate
    command: easyrsa build-client-full client nopass chdir=/etc/openvpn/easy-rsa creates=/etc/openvpn/easy-rsa/pki/issued/client.crt
    environment:
      EASYRSA_BATCH: 'yes'

  - name: Generate Certificate Revocation List
    command: easyrsa gen-crl chdir=/etc/openvpn/easy-rsa creates=/etc/openvpn/easy-rsa/pki/crl.pem

  - name: Generate OpenVPN TA key
    command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key chdir=/etc/openvpn/easy-rsa creates=/etc/openvpn/easy-rsa/pki/ta.key

  - name: Copy PKI files to /etc/openvpn/server directory
    copy:
      src: "{{ item }}"
      dest: /etc/openvpn/server
      mode: '0640'
    with_items:
      - /etc/openvpn/easy-rsa/pki/ca.crt
      - /etc/openvpn/easy-rsa/pki/dh.pem
      - /etc/openvpn/easy-rsa/pki/issued/server.crt
      - /etc/openvpn/easy-rsa/pki/issued/server.key
      - /etc/openvpn/easy-rsa/pki/ta.key

  - name: Copy additional PKI files to /etc/openvpn directory
    copy:
      src: "{{ item }}"
      dest: /etc/openvpn
      mode: '0640'
    with_items:
      - /etc/openvpn/easy-rsa/pki/crl.pem
      - /etc/openvpn/easy-rsa/pki/issued/client.crt
      - /etc/openvpn/easy-rsa/pki/issued/client.key

  - name: Place OpenVPN server configuration file
    template:
      src: server.conf.j2
      dest: /etc/openvpn/server.conf
      owner: root
      group: root
      mode: '0644'
    notify: restart openvpn

