---
   - name: lookup bootstrap facts (raw)
     ansible.builtin.raw: cat /etc/os-release
     register: bootstrap_facts
     changed_when: false
     vars:
       ansible_user: "{{ bootstrap_user }}"

   - name: set bootstrap facts (I)
     ansible.builtin.set_fact:
       bootstrap_distribution: "{{ item.value.name }}"
       bootstrap_distribution_major_version: "{{
         (item.value.version | regex_search('^\\d+')).0 }}"
     loop: "{{ bootstrap__os_family_map | dict2items }}"
     loop_control:
       label: "{{ item.value.name }}"
     vars:
       ansible_become: "{{ item.value.become | default(false) }}"
     when:
       - bootstrap_facts.stdout is defined
       - bootstrap_facts.stdout | regex_search(item.value.pretty_name)

   - name: set bootstrap facts (II)
     ansible.builtin.set_fact:
       bootstrap_os_family: "{{ item.key }}"
     loop: "{{ bootstrap__os_family_map | dict2items }}"
     loop_control:
       label: "{{ item.key }}"
     vars:
       ansible_become: "{{ item.value.become | default(false) }}"
     when:
       - bootstrap_distribution is defined
       - bootstrap_distribution == item.value.name
       - bootstrap_distribution_major_version is defined
       - bootstrap_distribution_major_version == item.value.version

