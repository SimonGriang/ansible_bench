---
   - name: Migrate adoptopenjdk to temurin (if selected)
     set_fact:
       java_jdk_vendor: temurin
     when: java_jdk_vendor == 'adoptopenjdk'

   - name: Gather OS specific variables
     include_vars: "{{ item }}"
     with_first_found:
       - "{{ java_jdk_vendor }}_{{ ansible_os_family | lower }}_{{ ansible_distribution_major_version }}.yml"
       - "{{ java_jdk_vendor }}_{{ ansible_os_family | lower }}.yml"

   - name: Gather architecture specific variables
     include_vars: "{{ item }}"
     with_first_found:
       - "{{ java_jdk_vendor }}_{{ ansible_architecture }}.yml"

   - name: Set OS specific variables (I)
     set_fact:
       java_jdk_version: "{{ java_jdk_version | default('8') }}"
       java_repos: "{{ java_repos | default([]) }}"
       java_libs: "{{ java_libs | default([]) }}"

   - name: Set OS and architecture specific variables (II)
     set_fact:
       java_bin_dir: "{{ java_bin_dir | default('/usr/lib/jvm/java-' + java_jdk_version + '-openjdk-' + ansible_architecture) }}"
       java_package_name: "{{ java_package_name | default('java-' + java_jdk_version + '-openjdk-' + ansible_architecture) }}"

   - name: Set specific variables
     set_fact:
       java_home: "{{ java_bin_dir }}"

   - name: Debian pre-requisites
     block:
       - name: Remove deprecated repositories
         apt_repository:
           repo: "{{ item }}"
           state: absent
         loop: "{{ java_deprecated_repos | default([]) }}"
       - name: Install extra apt tools
         apt:
           name: "{{ item }}"
           state: present
         loop: "{{ java_apt_tools | default([]) }}"
       - name: Add key repositories
         apt_key:
           url: "{{ item }}"
           state: present
         loop: "{{ java_apt_keys | default([]) }}"
       - name: Add required repositories
         apt_repository:
           repo: "{{ item }}"
           state: present
         loop: "{{ java_repos }}"
     when: ansible_os_family == 'Debian'

   - name: RedHat pre-requisites
     block:
       - name: Add key repositories
         rpm_key:
           key: "{{ item }}"
           state: present
         loop: "{{ java_rpm_keys | default([]) }}"
       - name: Add required repositories
         yum_repository:
           name: "{{ item.name }}"
           description: "{{ item.description }}"
           baseurl: "{{ item.baseurl }}"
           gpgcheck: yes
           gpgkey: "{{ item.gpgkey }}"
           enabled: yes
         loop: "{{ java_repos }}"
     when: ansible_os_family == 'RedHat'

   - name: Install required libs
     package:
       name: "{{ item }}"
       state: present
     loop: "{{ java_libs }}"

   - name: Install Java, Debian
     apt:
       name: "{{ java_package_name }}"
       state: present
     when: ansible_os_family == 'Debian'

   - name: Install Java, RedHat
     yum:
       name: "{{ java_package_name }}"
       state: present
     when: ansible_os_family == 'RedHat'

   - name: Export environment variables
     template:
       src: java.sh.j2
       dest: /etc/profile.d/java.sh

   - name: Source environment variables
     shell: source /etc/profile.d/java.sh
     args:
       executable: /bin/bash

   - name: Correct java version selected for Java < 11
     alternatives:
       name: java
       link: /usr/bin/java
       path: "{{ java_bin_dir }}/bin/java"
     when: java_jdk_version is version('11', '<')

   - name: Correct java version selected for Java >= 11
     alternatives:
       name: java
       link: /usr/bin/java
       path: "{{ java_bin_dir }}/bin/java"
     when: java_jdk_version is version('11', '>=')

   - name: Ensure new line at the end of file
     lineinfile:
       path: "{{ ansible_playbook_python }}"
       line: ""
       state: present
       insertafter: EOF

   - name: Remove trailing spaces
     lineinfile:
       path: "{{ ansible_playbook_python }}"
       regexp: ' +$'
       state: absent

