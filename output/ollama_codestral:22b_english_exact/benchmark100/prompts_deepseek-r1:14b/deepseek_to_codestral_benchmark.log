---
   - name: Import assert.yml
     import_tasks: assert.yml

   - name: Pre-configure debian systems
     debconf:
       name: postfix
       question: "{{ item.question }}"
       value: "{{ item.value }}"
       vtype: "{{ item.vtype }}"
     loop:
       - question: 'postfix/main_mailer_type'
         value: 'Internet Site'
         vtype: 'string'
       - question: 'postfix/mailname'
         value: ''
         vtype: 'string'

   - name: Install postfix
     apt:
       name: postfix
       state: present

   - name: Install postfix-mysql
     apt:
       name: postfix-mysql
       state: present

   - name: Configure postfix (transport_maps)
     template:
       src: transport_maps.j2
       dest: /etc/postfix/transport_maps
     notify:
       - validate transport_maps
       - rebuild transport_maps

   - name: Configure postfix (header_checks)
     template:
       src: header_checks.j2
       dest: /etc/postfix/header_checks
     notify:
       - validate header_checks
       - reload postfix

   - name: Setting values for main.cf (1/2)
     set_fact:
       postfix_recipient_access: "{{ lookup('file', 'recipient_access') }}"
       postfix_sender_access: "{{ lookup('file', 'sender_access') }}"

   - name: Setting values for main.cf (2/2)
     set_fact:
       postfix_mynetworks: "127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128"
       postfix_mydestination: "localhost"
       postfix_relay_domains: ""

   - name: Configure postfix (main.cf)
     template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify:
       - validate main.cf
       - restart postfix

   - name: Configure postfix (master.cf)
     template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify:
       - validate master.cf
       - restart postfix

   - name: Creates cert/key directory
     file:
       path: "{{ item }}"
       state: directory
       owner: root
       group: root
       mode: '0700'
     loop:
       - /etc/postfix/cert
       - /etc/postfix/key

   - name: Deploy Postfix TLS server certificate
     copy:
       src: "{{ postfix_tls_server_cert_src }}"
       dest: /etc/postfix/cert/tls_server.cert
     notify:
       - reload postfix

   - name: Deploy Postfix TLS server key
     copy:
       src: "{{ postfix_tls_server_key_src }}"
       dest: /etc/postfix/key/tls_server.key
     notify:
       - reload postfix

   - name: Flush handlers
     meta: flush_handlers

   - name: Configure aliases
     blockinfile:
       path: /etc/aliases
       block: "{{ postfix_aliases }}"
     notify:
       - rebuild aliases
       - reload postfix

   - name: Configure sender_access
     copy:
       content: "{{ postfix_sender_access }}"
       dest: /etc/postfix/sender_access
     notify:
       - rebuild sender_access
       - reload postfix

   - name: Configure recipient_access
     copy:
       content: "{{ postfix_recipient_access }}"
       dest: /etc/postfix/recipient_access
     notify:
       - validate recipient_access
       - rebuild recipient_access
       - reload postfix

   - name: Place sasl_password_map
     copy:
       content: "{{ postfix_sasl_password_map }}"
       dest: /etc/postfix/sasl_password_map
     notify:
       - rebuild sasl_password_map

   - name: Flush handlers again
     meta: flush_handlers

   - name: Start and enable postfix
     service:
       name: postfix
       state: started
       enabled: true

