---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
     notify:
       - Set root password
       - Systemctl daemon-reexec

   - name: Configure mysql server
     lineinfile:
       path: /etc/mysql/mysql.conf.d/mysqld.cnf
       regexp: "^{{ item.option }} ="
       line: "{{ item.option }} = {{ item.value }}"
     loop: "{{ mysql_configuration_options }}"
     notify: Restart mysql server

   - name: Configure mysql client
     lineinfile:
       path: /etc/mysql/mysql.conf.d/mysql-client.cnf
       line: "socket = /var/run/mysqld/mysqld.sock"

   - name: Initialize mysql
     command: mysql_install_db --user=mysql
     when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"

   - name: Start and enable mysql
     service:
       name: mysql
       state: started
       enabled: true

   - name: Place my.cnf
     template:
       src: my.cnf.j2
       dest: /etc/mysql/my.cnf
       mode: '0644'

   - name: Create databases
     mysql_db:
       name: "{{ item.name }}"
       state: present
       collation: "{{ item.collation | default('utf8_general_ci') }}"
       encoding: "{{ item.encoding | default('utf8') }}"
     loop: "{{ mysql_databases | default([]) }}"
     when: mysql_databases is defined

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       host: "{{ item.host | default('localhost') }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       state: present
       append_privs: true
     loop: "{{ mysql_users | default([]) }}"
     when: mysql_users is defined

   - name: Flush handlers again
     meta: flush_handlers

