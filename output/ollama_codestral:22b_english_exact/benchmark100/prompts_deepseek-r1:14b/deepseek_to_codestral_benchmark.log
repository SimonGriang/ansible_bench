---
- name: gather_facts | Lookup bootstrap facts
  shell: "cat /etc/os-release"
  register: os_release
  changed_when: false

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    ansible_os_distribution: "{{ os_release.stdout | regex_search('ID=([^ ]+)') | regex_replace('ID=', '') }}"
    ansible_os_version: "{{ os_release.stdout | regex_search('VERSION_ID=([^ ]+)') | regex_replace('VERSION_ID=', '') | regex_replace('\\..*$', '') }}"

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    ansible_os_family: >-
      {%- if ansible_os_distribution in ['debian', 'ubuntu'] -%}
        Debian
      {%- elif ansible_os_distribution in ['fedora', 'centos', 'redhat'] -%}
        RedHat
      {%- else -%}
        Unknown
      {%- endif -%}

