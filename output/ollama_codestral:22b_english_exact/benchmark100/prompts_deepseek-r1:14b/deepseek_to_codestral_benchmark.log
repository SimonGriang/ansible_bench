---
- name: Generate a private SSL key using OpenSSL
  openssl_privatekey:
    path: "{{ ssl_dir }}/{{ ssl_key_file }}"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_key_mode }}"

- name: Generate a Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ ssl_dir }}/{{ csr_file }}"
    privatekey_path: "{{ ssl_dir }}/{{ ssl_key_file }}"
    common_name: "{{ common_name }}"
    mode: "{{ csr_mode }}"

- name: Generate a self-signed SSL certificate
  openssl_certificate:
    path: "{{ ssl_dir }}/{{ ssl_cert_file }}"
    privatekey_path: "{{ ssl_dir }}/{{ ssl_key_file }}"
    csr_path: "{{ ssl_dir }}/{{ csr_file }}"
    provider: selfsigned
    mode: "{{ ssl_cert_mode }}"

- name: Create a PKCS#12 file
  openssl_pkcs12:
    path: "{{ ssl_dir }}/{{ pkcs12_file }}"
    privatekey_path: "{{ ssl_dir }}/{{ ssl_key_file }}"
    certificate_path: "{{ ssl_dir }}/{{ ssl_cert_file }}"
    mode: "{{ pkcs12_mode }}"

- name: Read the private key content
  slurp:
    src: "{{ ssl_dir }}/{{ ssl_key_file }}"
  register: private_key_content

- name: Read the certificate content
  slurp:
    src: "{{ ssl_dir }}/{{ ssl_cert_file }}"
  register: certificate_content

- name: Combine private key and certificate into a single file
  copy:
    content: |
      {{ private_key_content['content'] | b64decode }}
      {{ certificate_content['content'] | b64decode }}
    dest: "{{ ssl_dir }}/{{ combined_file }}"
    mode: "{{ combined_mode }}"


