---
   - name: Import assertion file
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Install cron packages
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure cron shell
     lineinfile:
       path: /etc/cron.env
       regexp: '^SHELL='
       line: 'SHELL={{ cron_shell }}'
     notify: restart cron service

   - name: Configure cron path
     lineinfile:
       path: /etc/cron.env
       regexp: '^PATH='
       line: 'PATH={{ cron_path }}'
     notify: restart cron service

   - name: Configure cron mailto
     lineinfile:
       path: /etc/cron.env
       regexp: '^MAILTO='
       line: 'MAILTO={{ cron_mailto }}'
     notify: restart cron service

   - name: Start and enable cron service
     service:
       name: "{{ cron_service }}"
       state: started
       enabled: yes
     when: cron_service is defined and cron_service | length > 0

   - name: Schedule cron jobs
     cron:
       name: "{{ item.name }}"
       job: "{{ item.job }}"
       minute: "{{ item.minute | default(omit) }}"
       hour: "{{ item.hour | default(omit) }}"
       day: "{{ item.day | default(omit) }}"
       month: "{{ item.month | default(omit) }}"
       weekday: "{{ item.weekday | default(omit) }}"
     with_items: "{{ cron_jobs }}"

   - name: Restart cron service
     service:
       name: cron
       state: restarted
     changed_when: true
     notify: restart cron service

   - name: Handler for cron service restart
     listen: restart cron service
     service:
       name: cron
       state: restarted
     changed_when: true

   - name: End of playbook
     debug:
       msg: "Playbook execution completed"

