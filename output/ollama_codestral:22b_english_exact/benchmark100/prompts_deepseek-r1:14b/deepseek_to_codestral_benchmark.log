     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Configure apk
     apk:
       update_cache: yes
       upgrade: yes
     changed_when: false

   - name: Configure apt
     apt:
       upgrade: safe
       update_cache: yes
       force_apt_get: yes

   - name: Update all software (dnf)
     dnf:
       name: "*"
       state: latest
       exclude: package1,package2

   - name: Update all software (pacman)
     pacman:
       update_cache: yes
       upgrade: yes

   - name: Configure yum
     block:
       - name: Check if CentOS/RHEL 6
         command: rpm -q --queryformat '%{VERSION}\n' centos-release
         register: centos_version
