 - name: Import assertion tasks
     import_tasks: assert.yml

   - name: Install MySQL server packages
     package:
       name: "{{ mysql_packages }}"
     notify:
       - mysql_root_password
       - mysql_systemd_daemon_reexec

   - name: Configure MySQL server settings
     copy:
       dest: /etc/mysql/mariadb.conf.d/50-server.cnf
       content: |
         [mysqld]
         bind-address = "127.0.0.1"
         skip-character-set-client-handshake
         character-set-server = utf8mb4
         collation-server = utf8mb4_general_ci
     notify:
       - mysql_server_restart

   - name: Configure MySQL client settings
     copy:
       dest: /root/.my.cnf
       content: |
         [client]
         socket = /var/run/mysqld/mysqld.sock

   - name: Initialize MySQL database
     command: mysql_install_db --user=mysql --ldata=/var/lib/mysql
     when: ansible_os_family == 'Alpine' or ansible_os_family == 'Archlinux'

   - name: Start and enable MySQL service
     service:
       name: "{{ mysql_service_name }}"
       state: started
       enabled: yes

   - name: Flush handlers
     meta: flush_handlers

   - name: Create MySQL configuration file
     template:
       src: my.cnf.j2
       dest: /etc/mysql/my.cnf
       mode: 0644

   - name: List existing MySQL databases
     mysql_info:
       login_user: root
       login_password: "{{ mysql_root_password }}"
       filter: databases
     register: mysql_databases

   - name: Create MySQL databases
     mysql_db:
       name: "{{ item }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
     loop: "{{ mysql_databases_to_create }}"
     when: initial_import is not defined and item not in mysql_databases.databases

   - name: Import MySQL databases
     mysql_db:
       name: "{{ item }}"
       state: import
       target: "{{ initial_import_location }}/{{ item }}.sql"
       login_user: root
       login_password: "{{ mysql_root_password }}"
     loop: "{{ mysql_databases_to_create }}"
     when: initial_import is defined and item not in mysql_databases.databases

   - name: Create MySQL users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
       host: "{{ item.host | default('localhost') }}"
     loop: "{{ mysql_users }}"
     loop_control:
       label: "{{ item.name }}"
     notify:
       - mysql_server_restart

   - name: Flush handlers
     meta: flush_handlers

