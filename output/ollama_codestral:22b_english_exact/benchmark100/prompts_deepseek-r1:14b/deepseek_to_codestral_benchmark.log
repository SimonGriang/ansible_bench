---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: yes

   - name: Install dns
     package:
       name: "{{ dns_packages }}"
       state: present

   - name: Create directories
     file:
       path: "{{ item.path }}"
       state: directory
       mode: "{{ item.mode }}"
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
     loop:
       - { path: '/var/lib/named', mode: '0770', owner: 'root', group: 'root' }
       - { path: '/etc/named', mode: '0750', owner: 'root', group: 'root' }

   - name: Create group
     group:
       name: "{{ dns_group }}"
       state: present

   - name: Create user
     user:
       name: "{{ dns_owner }}"
       system: yes

   - name: Generate rndc key
     command: rndc-confgen -a -c /etc/named

   - name: Set permissions on rndc key file
     file:
       path: /etc/named.rndc.key
       owner: root
       group: "{{ dns_group }}"
       mode: 0640

   - name: Get the hints/root file
     get_url:
       url: "{{ dns_root_hints_url }}"
       dest: /var/named/root.hints
       owner: root
       group: "{{ dns_group }}"
       mode: 0644
     when: dns_caching_dns

   - name: Create zone file
     template:
       src: "{{ item.src }}"
       dest: "/etc/named/{{ item.dest }}"
       validate: named-checkzone {{ item.zone }} %s
     loop: "{{ dns_zones }}"
     notify: Rndc reload

   - name: Add zones to configuration
     template:
       src: named.conf.j2
       dest: /etc/named/named.conf
     notify: Restart dns

   - name: Place systemd override
     template:
       src: override.conf.j2
       dest: /etc/systemd/system/named.service.d/override.conf
     register: dns_service_systemd_override
     when: dns_use_systemd

   - name: Start and enable dns
     service:
       name: named
       state: started
       enabled: yes

