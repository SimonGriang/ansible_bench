---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Task 2 - Install using package
  package:
    name: "{{ hashicorp_product }}"
    state: present
  when: hashicorp_install_method == 'package'

- name: Task 3 - Configure debian
  block:
  - name: Add GPG Key
    apt_key:
      url: "https://apt.releases.hashicorp.com/gpg"
      state: present
  - name: Add HashiCorp Repository
    apt_repository:
      repo: "deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_lsb.codename }} main"
      state: present
      update_cache: yes
  when: ansible_os_family == 'Debian'

- name: Task 4 - Install hashicorp product using package
  package:
    name: "{{ hashicorp_product }}{{ hashicorp_version | ternary('=' + hashicorp_version, '') }}"
    state: present
  when: hashicorp_install_method == 'package'

- name: Task 5 - Install manually
  block:
  - name: Download HashiCorp product
    get_url:
      url: "{{ hashicorp_product_download_url }}"
      dest: "/tmp/{{ hashicorp_product }}.zip"
  - name: Extract HashiCorp product
    unarchive:
      src: "/tmp/{{ hashicorp_product }}.zip"
      dest: "{{ hashicorp_product_install_dir }}"
      remote_src: yes
  - name: Set permissions for extracted files
    file:
      path: "{{ hashicorp_product_install_dir }}"
      state: directory
      recurse: yes
      owner: "{{ hashicorp_product_user }}"
      group: "{{ hashicorp_product_group }}"
      mode: 0755
  when: hashicorp_install_method == 'manual'


