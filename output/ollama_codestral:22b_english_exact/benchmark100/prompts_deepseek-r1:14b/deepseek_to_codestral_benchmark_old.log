---
- name: Generate private SSL key
  openssl_privatekey:
    path: "{{ ssl_directory }}/privkey.pem"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_key_mode }}"

- name: Generate Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ ssl_directory }}/csr.pem"
    privatekey_path: "{{ ssl_directory }}/privkey.pem"
    common_name: "{{ common_name }}"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_csr_mode }}"

- name: Generate self-signed SSL certificate
  openssl_certificate:
    path: "{{ ssl_directory }}/cert.pem"
    privatekey_path: "{{ ssl_directory }}/privkey.pem"
    csr_path: "{{ ssl_directory }}/csr.pem"
    provider: selfsigned
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_cert_mode }}"

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ ssl_directory }}/keystore.p12"
    privatekey_path: "{{ ssl_directory }}/privkey.pem"
    certificate_path: "{{ ssl_directory }}/cert.pem"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_p12_mode }}"

- name: Read private key content
  slurp:
    src: "{{ ssl_directory }}/privkey.pem"
  register: private_key_content

- name: Read certificate content
  slurp:
    src: "{{ ssl_directory }}/cert.pem"
  register: certificate_content

- name: Combine private key and certificate into a single file
  copy:
    content: "{{ private_key_content['content'] | b64decode }}\n{{ certificate_content['content'] | b64decode }}"
    dest: "{{ ssl_directory }}/combined.pem"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_combined_mode }}"


