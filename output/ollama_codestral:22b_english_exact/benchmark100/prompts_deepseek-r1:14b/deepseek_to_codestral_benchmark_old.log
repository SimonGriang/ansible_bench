 - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install dns
     package:
       name: "{{ dns_packages }}"
       state: present

   - name: Create directories
     file:
       path: "{{ item.path }}"
       state: directory
       mode: "{{ item.mode }}"
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
     loop:
       - {path: /var/lib/dns, mode: '0770', owner: root, group: "{{ dns_group }}"}
       - {path: /etc/dns, mode: '0770', owner: root, group: "{{ dns_group }}"}

   - name: Create group
     group:
       name: "{{ dns_group }}"
       state: present

   - name: Create user
     user:
       name: "{{ dns_owner }}"
       system: true
       groups: "{{ dns_group }}"

   - name: Generate rndc key
     shell: rndc-confgen -a -c /etc/dns -r /dev/urandom

   - name: Set permissions on rndc key file
     file:
       path: /etc/dns/rndc.key
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: '0640'

   - name: Get the hints/root file
     get_url:
       url: "https://www.internic.net/domain/named.cache"
       dest: /var/lib/dns/root.hints
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: '0644'
     when: dns_caching_dns

   - name: Create zone file
     template:
       src: zone.j2
       dest: "/etc/dns/{{ item }}.zone"
       mode: '0644'
       owner: root
       group: "{{ dns_group }}"
     loop: "{{ dns_zones }}"
     notify: Rndc reload

   - name: Add zones to configuration
     template:
       src: named.conf.j2
       dest: /etc/dns/named.conf
       mode: '0644'
       owner: root
       group: "{{ dns_group }}"
     notify: Restart dns

   - name: Place systemd override
     copy:
       src: dns.service.override
       dest: /etc/systemd/system/dns.service.d/override.conf
       mode: '0644'
     notify: Reload systemd
     when: ansible_service_mgr == 'systemd'

   - name: Start and enable dns
     service:
       name: dns
       state: started
       enabled: true

   - name: Rndc reload handler
     shell: rndc reload
     listen: Rndc reload

   - name: Restart dns handler
     service:
       name: dns
       state: restarted
     listen: Restart dns

   - name: Reload systemd handler
     systemd:
       daemon_reload: true
     listen: Reload systemd

