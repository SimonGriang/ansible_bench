 - name: Check if EFI firmware exists on the system
     stat:
       path: /sys/firmware/efi/efivars/
     register: efi_firmware

   - name: Remove GRUB configuration file on EFI systems
     file:
       path: /boot/grub2/grub.cfg
       state: absent
     when: efi_firmware.stat.isdir is defined and efi_firmware.stat.isdir

   - name: Install custom user template for GRUB
     copy:
       src: 01_users.j2
       dest: /etc/grub.d/01_users
       mode: '0755'

   - name: Add EFI password protection to GRUB
     blockinfile:
       path: /etc/grub2-efi.cfg
       insertafter: '^menuentry'
       block: |
         password_pbkdf2 [user] [hashed password]
     when: efi_firmware.stat.isdir is defined and efi_firmware.stat.isdir

   - name: Add MBR password protection to GRUB
     blockinfile:
       path: /etc/grub2.cfg
       insertafter: '^menuentry'
       block: |
         password_pbkdf2 [user] [hashed password]
     when: efi_firmware.stat.isdir is defined and not efi_firmware.stat.isdir

   - name: Add unrestricted access to GRUB password entries
     lineinfile:
       path: "{{ '/etc/grub2-efi.cfg' if efi_firmware.stat.isdir is defined and efi_firmware.stat.isdir else '/etc/grub2.cfg' }}"
       regexp: '^password_pbkdf2'
       line: 'password_pbkdf2 [user] [hashed password] --unrestricted'
       backrefs: yes
     when: enable_unrestricted_access | bool

