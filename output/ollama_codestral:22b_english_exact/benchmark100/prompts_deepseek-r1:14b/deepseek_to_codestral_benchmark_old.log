 - name: Import assert.yml
     import_tasks: assert.yml

   - name: Install using package
     block:
       - name: Configure debian
         block:
           - name: Add HashiCorp GPG key
             apt_key:
               url: "https://keybase.io/hashicorp/pgp_keys.asc"
               state: present
           - name: Add HashiCorp repository
             apt_repository:
               repo: "deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_lsb.codename }} main"
               state: present
         when: ansible_os_family == 'Debian'
       - name: Install HashiCorp product using package
         block:
           - name: Install latest version
             package:
               name: "{{ hashicorp_product }}"
               state: latest
             when: hashicorp_product_version is not defined
           - name: Install specific version
             package:
               name: "{{ hashicorp_product }}={{ hashicorp_product_version }}"
               state: present
             when: hashicorp_product_version is defined
         when: ansible_os_family == 'Debian'
     when: hashicorp_install_method == 'package'

   - name: Install manually
     block:
       - name: Extract HashiCorp product
         unarchive:
           src: "{{ hashicorp_product_remote_src }}"
           dest: "{{ hashicorp_product_dest }}"
           remote_src: yes
       - name: Set permissions
         file:
           path: "{{ hashicorp_product_dest }}/{{ hashicorp_product }}"
           mode: '0755'
     when: hashicorp_install_method == 'manual'

