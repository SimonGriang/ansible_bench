       - name: Install Oracle Java DEB package
         apt:
           deb: "/tmp/{{ java_package }}"
     when:
       - java_source == 'local'
       - java_format == 'deb'

   - name: Install Oracle Java RPM from repository
     package:
       name: "java-{{ java_version }}-oracle"
       state: present
     when:
       - java_source == 'repository'
       - java_format == 'rpm'

   - name: Configure Oracle Java targz installation
     block:
       - name: Extract Oracle Java targz package
         unarchive:
           src: "{{ java_package_src }}"
           dest: "{{ java_install_dir }}"
           remote_src: yes
       - name: Install Oracle Java targz package
         shell: >
           {{ java_install_dir }}/{{ java_package_dir }}/bin/java_install_params -n
         args:
           chdir: "{{ java_install_dir }}/{{ java_package_dir }}"
     when:
       - java_format == 'targz'
       - java_vendor == 'oracle'

   - name: Install Oracle Java JCE policy
     get_url:
       url: "{{ java_jce_url }}"
       dest: "{{ java_jce_dest }}"
