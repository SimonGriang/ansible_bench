---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install apache httpd
     package:
       name: "{{ httpd_packages }}"
       state: present

   - name: Configure selinux
     block:
       - seboolean:
           name: "{{ item.name }}"
           state: "{{ item.state }}"
           persistent: yes
         with_items:
           - { name: 'httpd_can_network_connect', state: 'yes' }
         when: ansible_selinux.status == 'enabled'

       - seport:
           ports: "{{ httpd_ports }}"
           proto: tcp
           setype: http_port_t
           state: present
         when: ansible_selinux.status == 'enabled'

   - name: Configure httpd
     template:
       src: "{{ httpd_config_file }}"
       dest: "{{ httpd_config_dest }}"
       mode: 0644
     notify:
       - Test httpd configuration
       - Restart httpd

   - name: Activate httpd module | Debian
