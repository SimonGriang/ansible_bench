     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Enable Redis module stream for RHEL 8
     dnf:
       name: 'redis-modules-stream'
       state: present
     when:
       - ansible_distribution == 'RedHat'
       - ansible_distribution_major_version == '8'

   - name: Install Redis package
     package:
       name: "{{ redis_packages }}"
       state: present

   - name: Configure Redis settings
     template:
       src: "redis.conf-{{ ansible_distribution }}.j2"
       dest: "/etc/redis.conf"
       owner: "{{ redis_owner }}"
       group: "{{ redis_group }}"
       mode: "{{ redis_mode }}"
     notify: restart Redis

   - name: Start and enable Redis service
     service:
       name: "{{ redis_service }}"
       state: started
       enabled: true

