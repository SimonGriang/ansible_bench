---
   - name: Migrate adoptopenjdk to temurin
     set_fact:
       java_jdk_vendor: temurin
     when: java_jdk_vendor == 'adoptopenjdk'

   - name: Gather OS specific variables
     include_vars: "{{ item }}"
     with_first_found:
       - "{{ ansible_distribution }}-{{ ansible_distribution_version }}-{{ java_jdk_vendor }}.yml"
       - "{{ ansible_distribution }}-{{ java_jdk_vendor }}.yml"

   - name: Gather architecture specific variables
     include_vars: "{{ item }}"
     with_first_found:
       - "{{ ansible_architecture }}-{{ java_jdk_vendor }}.yml"

   - name: Set OS specific variables
     set_fact:
       java_openjdk_version: "{{ java_openjdk_version | default('11') }}"
       java_openjdk_repositories: "{{ java_openjdk_repositories | default([]) }}"
       java_openjdk_libs: "{{ java_openjdk_libs | default([]) }}"

   - name: Set OS and architecture specific variables
     set_fact:
       java_openjdk_installation_path: "{{ java_openjdk_installation_path | default('/usr/lib/jvm') }}"
       java_openjdk_package_name: "{{ java_openjdk_package_name | default('java-{{ java_openjdk_version }}-openjdk-headless') }}"

   - name: Set specific variables
     set_fact:
       java_home: "{{ java_openjdk_installation_path }}/jdk-{{ java_openjdk_version }}"

   - name: Debian pre-requisites
     block:
       - apt_repository:
           repo: "{{ item }}"
           state: absent
         loop: "{{ java_openjdk_deprecated_repositories }}"
       - apt:
           name: apt-transport-https
       - apt_key:
           url: "{{ item }}"
           state: present
         loop: "{{ java_openjdk_keys }}"
       - apt_repository:
           repo: "{{ item }}"
           state: present
         loop: "{{ java_openjdk_repositories }}"
     when: ansible_os_family == 'Debian'

   - name: RedHat pre-requisites
     block:
       - yum_repository:
           name: "{{ item.name }}"
           description: "{{ item.description }}"
           baseurl: "{{ item.url }}"
           gpgcheck: yes
           gpgkey: "{{ item.gpgkey }}"
           enabled: yes
         loop: "{{ java_openjdk_repositories }}"
     when: ansible_os_family == 'RedHat'

   - name: Install required libs
     package:
       name: "{{ java_openjdk_libs }}"
       state: present

   - name: Install Java, Debian
     apt:
       name: "{{ java_openjdk_package_name }}"
       state: present
     when: ansible_os_family == 'Debian'

   - name: Install Java, RedHat
     yum:
       name: "{{ java_openjdk_package_name }}"
       state: present
     when: ansible_os_family == 'RedHat'

   - name: Export environment variables
     copy:
       dest: /etc/profile.d/java.sh
       content: |
         export JAVA_HOME="{{ java_home }}"
         export PATH=$PATH:$JAVA_HOME/bin

   - name: Source environment variables
     shell: source /etc/profile.d/java.sh

   - name: Correct java version selected for Java < 11
     alternatives:
       name: java
       link: /usr/bin/java
       path: "{{ java_home }}/jre/bin/java"
     when: java_openjdk_version | int < 11

   - name: Correct java version selected for Java >= 11
     alternatives:
       name: java
       link: /usr/bin/java
       path: "{{ java_home }}/bin/java"
     when: java_openjdk_version | int >= 11

