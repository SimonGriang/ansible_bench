 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Install git
     package:
       name: git
       state: present

   - name: Check if user exists
     shell: "id -u {{ user_name }}"
     register: user_check
     ignore_errors: true

   - name: Create git config directory
     file:
       path: "/home/{{ user_name }}/.config/git"
       state: directory
       mode: '0700'

   - name: Place git configuration
     template:
       src: gitconfig.j2
       dest: "/home/{{ user_name }}/.config/git/config"
       mode: '0600'

   - name: Create repository destination
     file:
       path: "/home/{{ user_name }}/repos"
       state: directory
       mode: '0755'

   - name: Clone all repositories
     git:
       repo: "{{ item.repo }}"
       dest: "/home/{{ user_name }}/repos/{{ item.dest }}"
       version: "{{ item.version }}"
     loop: "{{ repositories }}"
     become_user: "{{ user_name }}"

