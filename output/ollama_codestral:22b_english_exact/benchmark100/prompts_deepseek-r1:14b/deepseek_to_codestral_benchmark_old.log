---
   - name: Create RKE2 configuration directory
     file:
       path: /etc/rancher/rke2
       state: directory
       mode: '0750'

   - name: Set server taints
     lineinfile:
       path: /etc/rancher/rke2/config.yaml
       regexp: '^server-taint:'
       line: "server-taint: ['CriticalAddonsOnly=true:NoExecute']"
     when: "'server' in node_type"
     notify: Restart RKE2 service

   - name: Set agent taints
     lineinfile:
       path: /etc/rancher/rke2/config.yaml
       regexp: '^agent-taint:'
       line: "agent-taint: ['CriticalAddonsOnly=true:NoExecute']"
     when: "'agent' in node_type"
     notify: Restart RKE2 service

   - name: Copy RKE2 configuration file
     template:
       src: config.yaml.j2
       dest: /etc/rancher/rke2/config.yaml
       mode: '0644'
     notify: Restart RKE2 service

   - name: Copy Kubelet configuration file
     template:
       src: kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       mode: '0644'
     when: kubelet_config is defined
     notify: Restart RKE2 service

   - name: Copy Containerd Registry Configuration file
     copy:
       src: /path/to/custom/registries.yaml
       dest: /etc/rancher/rke2/registries.yaml
       mode: '0644'
     when: custom_registry_settings is defined
     notify: Restart RKE2 service

   - name: Start RKE2 service on other nodes
     systemd:
       name: rke2-server.service
       state: started
       enabled: true
     when: inventory_hostname != ansible_hostname
     notify: Restart RKE2 service

   - name: Mask other RKE2 services on nodes
     systemd:
       name: "{{ 'rke2-agent.service' if 'server' in node_type else 'rke2-server.service' }}"
       masked: true

   - name: Wait for remaining nodes to be ready - no CNI
     command: >-
       kubectl get nodes --no-headers=true
       --field-selector=metadata.name={{ item }}
       --output=jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
     loop: "{{ groups['all'] }}"
     register: result
     until: result.stdout == "True"
     retries: 60
     delay: 1
     when: inventory_hostname != item and not cni_config

   - name: Wait for remaining nodes to be ready - with CNI
     command: >-
       kubectl get nodes --no-headers=true
       --field-selector=metadata.name={{ item }}
       --output=jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
     loop: "{{ groups['all'] }}"
     register: result
     until: result.stdout == "True"
     retries: 60
     delay: 1
     when: inventory_hostname != item and cni_config


