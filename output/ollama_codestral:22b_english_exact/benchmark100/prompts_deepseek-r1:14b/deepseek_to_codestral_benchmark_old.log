Do not include hosts:, vars:, or any playbook-level headers. Only output valid task entries or blocks as expected in a role.  

Task 1: Import assertion file
Description Task 1: Import assertion file assert.yml and run once on localhost.

Task 2: Install system requirements
Description Task 2: Install bash package.

Task 3: Install OpenJDK Java
Description Task 3: Install OpenJDK Java package when java_vendor is set to "openjdk".

Task 4: Install Oracle Java RPM from local
Description Task 4: Copy and install Oracle Java RPM package when java_source is "local" and java_format is "rpm".

Task 5: Install Oracle Java DEB from local
Description Task 5: Copy and install Oracle Java DEB package when java_source is "local" and java_format is "deb".

Task 6: Install Oracle Java RPM from repository
Description Task 6: Install Oracle Java RPM package when java_source is "repository" and java_format is "rpm".

Task 7: Configure Oracle Java targz installation
Description Task 7: Extract and install Oracle Java targz package when java_format is "targz" and java_vendor is "oracle".

Task 8: Install Oracle Java JCE policy
Description Task 8: Install Java Cryptography Extension (JCE) policy software when java_jce is enabled, java_version is 8, and java_vendor is "oracle".

Task 9: Set Java alternative
Description Task 9: Set Java alternative link when java_format is "targz" and distribution is not Alpine.

Task 10: Find Java home directory
Description Task 10: Determine JAVA_HOME by finding the real path of /usr/bin/java.

Task 11: Set JAVA_HOME in environment
Description Task 11: Add JAVA_HOME to /etc/profile.d/java_home.sh file.


- Last generated (faulty) playbook: 
---
  - name: Import assertion file
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install system requirements
    package:
      name: bash
      state: present

  - name: Install OpenJDK Java
    package:
      name: "java-{{ java_version }}-openjdk"
      state: present
    when: java_vendor == "openjdk"

  - name: Install Oracle Java RPM from local
    block:
      - name: Copy Oracle Java RPM package
        copy:
          src: "{{ java_package_src }}"
          dest: "/tmp/{{ java_package }}"
      - name: Install Oracle Java RPM package
        package:
          name: "/tmp/{{ java_package }}"
          state: present
    when:
      - java_source == "local"
      - java_format == "rpm"

  - name: Install Oracle Java DEB from local
    block:
      - name: Copy Oracle Java DEB package
        copy:
          src: "{{ java_package_src }}"
          dest: "/tmp/{{ java_package }}"
      - name: Install Oracle Java DEB package
        apt:
          deb: "/tmp/{{ java_package }}"
    when:
      - java_source == "local"
      - java_format == "deb"

  - name: Install Oracle Java RPM from repository
    package:
      name: "java-{{ java_version }}-oracle"
      state: present
    when:
      - java_source == "repository"
      - java_format == "rpm"

  - name: Configure Oracle Java targz installation
    block:
      - name: Extract Oracle Java targz package
        unarchive:
          src: "{{ java_package_src }}"
          dest: "{{ java_install_dir }}"
          remote_src: yes
      - name: Install Oracle Java targz package
        shell: >
          {{ java_install_dir }}/{{ java_package_dir }}/bin/java_install_params -n
        args:
          chdir: "{{ java_install_dir }}/{{ java_package_dir }}"
    when:
      - java_format == "targz"
      - java_vendor == "oracle"

  - name: Install Oracle Java JCE policy
    get_url:
      url: "{{ java_jce_url }}"
      dest: "{{ java_jce_dest }}"
      mode: '0644'
    when:
      - java_jce | bool
      - java_version == 8
      - java_vendor == "oracle"

  - name: Set Java alternative
    alternatives:
      name: java
      path: "{{ java_install_dir }}/{{ java_package_dir }}/bin/java"
    when:
      - java_format == "targz"
      - ansible_os_family != "Alpine"

  - name: Find Java home directory
    shell: "readlink -f /usr/bin/java | sed 's:/bin/java::'"
    register: java_home
    changed_when: false

  - name: Set JAVA_HOME in environment
    lineinfile:
      path: /etc/profile.d/java_home.sh
      line: "export JAVA_HOME={{ java_home.stdout }}"
      create: true

