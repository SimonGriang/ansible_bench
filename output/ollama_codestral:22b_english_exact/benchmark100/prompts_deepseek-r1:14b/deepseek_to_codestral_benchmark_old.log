 - name: Import assert.yml
      import_tasks: assert.yml

    - name: Pre-configure debian systems
      debconf:
        name: postfix
        question: postfix/mailname
        value: "{{ postfix_mailname }}"
        vtype: string
      when: ansible_os_family == 'Debian'

    - name: Install postfix
      package:
        name: postfix
        state: present

    - name: Install postfix-mysql
      package:
        name: postfix-mysql
        state: present

    - name: Configure postfix (transport_maps)
      template:
        src: transport_maps.cf.j2
        dest: /etc/postfix/transport_maps.cf
      notify:
        - postmap transport_maps

    - name: Configure postfix (header_checks)
      template:
        src: header_checks.j2
        dest: /etc/postfix/header_checks
      notify:
        - validate header_checks
        - reload postfix

    - name: Setting values for main.cf (1/2)
      set_fact:
        postconf_sender_access: "{{ postfix_sender_access }}"
        postconf_recipient_access: "{{ postfix_recipient_access }}"

    - name: Setting values for main.cf (2/2)
      set_fact:
        postconf_mynetworks: "{{ postfix_mynetworks }}"
        postconf_mydestination: "{{ postfix_mydestination }}"
        postconf_relay_domains: "{{ postfix_relay_domains }}"
