---
   - name: Create local SSH key directory for user
     file:
       path: "/home/{{ user }}/.ssh"
       state: directory
       owner: "{{ user }}"
       mode: 0750

   - name: Manage user account
     user:
       name: "{{ user }}"
       state: present
       comment: "{{ user_comment }}"
       home: "{{ user_home }}"
       shell: "{{ user_shell }}"

   - name: Set sudo options for user
     copy:
       dest: "/etc/sudoers.d/{{ user }}"
       content: "{{ user }} ALL=(ALL) NOPASSWD:ALL\n"
       validate: 'visudo -csf %s'

   - name: Generate private SSH key for user
     command: >
       ssh-keygen -t rsa -b 4096 -f /home/{{ user }}/.ssh/id_rsa -N ''
     args:
       creates: "/home/{{ user }}/.ssh/id_rsa"

   - name: Generate public SSH key for user
     command: >
       ssh-keygen -y -f /home/{{ user }}/.ssh/id_rsa > /home/{{ user }}/.ssh/id_rsa.pub
     args:
       creates: "/home/{{ user }}/.ssh/id_rsa.pub"

   - name: Convert SSH key to ppk format for user
     command: >
       puttygen /home/{{ user }}/.ssh/id_rsa -o /home/{{ user }}/.ssh/id_rsa.ppk -O private
     args:
       creates: "/home/{{ user }}/.ssh/id_rsa.ppk"

   - name: Get or set the home directory for user
     shell: echo $HOME || echo "/home"
     register: home_dir

   - name: Create .ssh directory for user
     file:
       path: "{{ home_dir.stdout }}/.ssh"
       state: directory
       owner: "{{ user }}"
       mode: 0700

   - name: Deploy authorized keys for user
     authorized_key:
       user: "{{ user }}"
       state: present
       key: "{{ lookup('file', '/path/to/authorized_keys') }}"

   - name: Remove unauthorized keys for user
     authorized_key:
       user: "{{ user }}"
       state: absent
       key: "{{ lookup('file', '/path/to/unauthorized_keys') }}"

   - name: Copy generated private SSH key for user
     copy:
       src: "/home/{{ user }}/.ssh/id_rsa"
       dest: "{{ home_dir.stdout }}/id_rsa"
       owner: "{{ user }}"
       mode: 0600

   - name: Check users password valid time for user
     shell: chage -l '{{ user }}' | grep 'Password expires'
     register: password_expiry

   - name: Set users password valid time for user
     shell: >
       chage -M {{ password_max_days }} -m {{ password_min_days }} -W {{ password_warning_days }} '{{ user }}'

   - name: Place private key file for user
     copy:
       src: "/path/to/private_key"
       dest: "{{ home_dir.stdout }}/.ssh/id_rsa"
       owner: "{{ user }}"
       mode: 0600


