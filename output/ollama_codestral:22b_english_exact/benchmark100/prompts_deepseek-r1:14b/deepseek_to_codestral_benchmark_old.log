---
   - name: Create RKE2 config directory
     file:
       path: "{{ rke2_config_dir }}"
       state: directory
       mode: 0755

   - name: Set server taints
     shell: >
       rke2_taint_cmd="kubectl --kubeconfig
       {{ rke2_config_dir }}/kubeconfig.yaml -n kube-system patch node
       {{ inventory_hostname }} -p '{\"spec\":{\"taints\":[{\"key\":
       \"node-role.kubernetes.io/server\",\"effect\":\"NoSchedule\"}]}}'"
       if {{ rke2_server | bool }}; then
         $rke2_taint_cmd
       else
         $rke2_taint_cmd --type merge
       fi
     when:
       - rke2_server_node_taints is defined
       - rke2_server_node_taints | length > 0
     changed_when: false

   - name: Copy RKE2 configuration file
     copy:
       src: "{{ rke2_config_file }}"
       dest: "{{ rke2_config_dir }}/config.yaml"
       mode: 0600
     notify: Restart RKE2 server

   - name: Copy kubelet configuration file
     copy:
       content: "{{ rke2_kubelet_config | to_nice_yaml }}"
       dest: "{{ rke2_config_dir }}/kubelet-config.yaml"
       mode: 0600
     notify: Restart RKE2 server
     when: rke2_kubelet_config | default({}) | length > 0

   - name: Copy Containerd Registry Configuration file
     copy:
       content: "{{ rke2_containerd_registry_config | to_nice_yaml }}"
       dest: "{{ rke2_config_dir }}/registries.yaml"
       mode: 0600
     notify: Restart RKE2 server
     when: rke2_containerd_registry_config | default({}) | length > 0

   - name: Register etcd restore from file
     set_fact:
       rke2_etcd_restore_from_file: "{{ rke2_etcd_snapshot_file is defined and
       rke2_etcd_snapshot_file and rke2_service.state != 'running' }}"

   - name: Register etcd restore from S3
     set_fact:
       rke2_etcd_restore_from_s3: "{{ rke2_etcd_s3_options is defined and
       rke2_etcd_s3_endpoint is defined and rke2_etcd_s3_access_key is defined
       and rke2_etcd_s3_secret_key is defined and rke2_service.state !=
       'running' }}"

   - name: Restore etcd from file
     block:
       - name: Create etcd restore directory
         file:
           path: /var/lib/rancher/rke2/server/db/etcd-restore
           state: directory
       - name: Copy etcd snapshot file
         copy:
           src: "{{ rke2_etcd_snapshot_file }}"
           dest: /var/lib/rancher/rke2/server/db/etcd-restore/etcd-snapshot-restore.db
       - name: Run etcd restore command
         command: >
           /var/lib/rancher/rke2/bin/rke2-server
           --data-dir /var/lib/rancher/rke2
           --config /var/lib/rancher/rke2/config.yaml
           --etcd-snapshot-restore-path
           /var/lib/rancher/rke2/server/db/etcd-restore/etcd-snapshot-restore.db
     when: rke2_etcd_restore_from_file | bool

   - name: Restore etcd from S3
     block:
       - name: Run etcd restore command with S3 options
         command: >
           /var/lib/rancher/rke2/bin/rke2-server
           --data-dir /var/lib/rancher/rke2
           --config /var/lib/rancher/rke2/config.yaml
           --etcd-s3
           --etcd-s3-endpoint {{ rke2_etcd_s3_endpoint }}
           --etcd-s3-access-key {{ rke2_etcd_s3_access_key }}
           --etcd-s3-secret-key {{ rke2_etcd_s3_secret_key }}
           --etcd-s3-bucket {{ rke2_etcd_s3_options.bucket }}
           --etcd-s3-folder {{ rke2_etcd_s3_options.folder }}
     when: rke2_etcd_restore_from_s3 | bool

   - name: Start RKE2 service
     systemd:
       name: rke2-server.service
       state: started
       enabled: true
       daemon_reload: true
       environment:
         RKE2_TOKEN: "{{ rke2_token }}"
     notify: Restart RKE2 server

   - name: Mask RKE2 agent service
     systemd:
       name: rke2-agent.service
       masked: true
       enabled: false

   - name: Wait for first server to be ready (no CNI)
     shell: >
       until kubectl --kubeconfig {{ rke2_config_dir }}/kubeconfig.yaml
       get nodes {{ inventory_hostname }}
       -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
       do
         echo "Waiting for first server to be ready"
       done
     when: rke2_cni_plugin is not defined or rke2_cni_plugin == 'none'

   - name: Wait for first server to be ready (with CNI)
     shell: >
       until kubectl --kubeconfig {{ rke2_config_dir }}/kubeconfig.yaml
       wait --for=condition=Ready node/{{ inventory_hostname }}
       do
         echo "Waiting for first server to be ready"
       done
     when: rke2_cni_plugin is defined and rke2_cni_plugin != 'none'

   - name: Restore etcd
     include_tasks: etcd_restore.yml
     when: rke2_etcd_restore_from_file | bool or rke2_etcd_restore_from_s3 | bool

   - name: Set Active Server variable
     set_fact:
       rke2_active_server: true
     delegate_to: "{{ item }}"
     delegate_facts: true
     with_items: "{{ groups['kubernetes_cluster'] }}"
     run_once: true 71%|███████   | 71/100 [1:30:28<1:17:14, 159.82s/it]

