 - name: Import assertion tasks
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install Python pip
     package:
       name: "{{ python_pip_packages }}"
       state: present

   - name: Configure pip proxy settings
     lineinfile:
       path: /etc/pip.conf
       regexp: '^index-url'
       line: "index-url = {{ python_pip_proxy }}"
       insertafter: '\[global\]'
     when: python_pip_proxy is defined

   - name: Configure pip trusted hosts
     lineinfile:
       path: /etc/pip.conf
       regexp: '^trusted-host'
       line: "trusted-host = {{ python_pip_trusted_host }}"
       insertafter: '\[global\]'
     when: python_pip_trusted_host is defined

   - name: Update pip
     pip:
       name: pip
       state: latest
     when:
       - ansible_distribution != 'bookworm'
       - ansible_distribution != 'noble'
       - ansible_os_family != 'Alpine'

   - name: Install Python modules
     pip:
       name: "{{ item.name }}"
       state: "{{ item.state | default('present') }}"
       version: "{{ item.version | default(omit) }}"
     loop: "{{ python_pip_modules }}"
     when:
       - ansible_distribution != 'bookworm'
       - ansible_distribution != 'noble'
       - ansible_os_family != 'Alpine'

