content=' ---\n   - name: Import assert.yml\n     import_tasks: assert.yml\n     delegate_to: localhost\n     run_once: true\n\n   - name: Install apache httpd\n     package:\n       name: "{{ httpd_packages }}"\n       state: present\n\n   - name: Configure selinux\n     block:\n       - seboolean:\n           name: "{{ item.name }}"\n           state: "{{ item.state }}"\n           persistent: yes\n         with_items:\n           - { name: \'httpd_can_network_connect\', state: \'yes\' }\n         when: ansible_selinux.status == \'enabled\'\n\n       - seport:\n           ports: "{{ httpd_ports }}"\n           proto: tcp\n           setype: http_port_t\n           state: present\n         when: ansible_selinux.status == \'enabled\'\n\n   - name: Configure httpd\n     template:\n       src: "{{ httpd_config_file }}"\n       dest: "{{ httpd_config_dest }}"\n       mode: 0644\n     notify:\n       - Test httpd configuration\n       - Restart httpd\n\n   - name: Activate httpd module | Debian\n     command: a2enmod "{{ item }}"\n     with_items: "{{ httpd_activate_modules }}"\n     when: ansible_os_family == \'Debian\'\n     changed_when: false\n\n   - name: Import ssl.yml\n     import_tasks: ssl.yml\n     when: httpd_ssl\n\n   - name: Import locations.yml\n     import_tasks: locations.yml\n     when: httpd_locations is defined\n\n   - name: Import vhosts.yml\n     import_tasks: vhosts.yml\n     when: httpd_vhosts is defined\n\n   - name: Configure ports\n     template:\n       src: "{{ httpd_ports_config_file }}"\n       dest: "{{ httpd_ports_config_dest }}"\n     notify:\n       - Test httpd configuration\n       - Restart httpd\n     when: ansible_os_family in [\'Debian\', \'Suse\']\n\n   - name: Import directories.yml\n     import_tasks: directories.yml\n     when: httpd_directories is defined\n\n   - name: Flush handlers\n     meta: flush_handlers\n\n   - name: Removing default html\n     file:\n       path: "{{ httpd_default_html }}"\n       state: absent\n     