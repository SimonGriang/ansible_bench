 - name: Download RKE2 installation script
     get_url:
       url: "{{ rke2_install_script_url }}"
       dest: "{{ rke2_artifacts_dir }}/install.sh"
       mode: '0700'
     when: not airgap_mode

   - name: Copy local RKE2 installation script
     copy:
       src: "{{ rke2_install_script_local_path }}"
       dest: "{{ rke2_artifacts_dir }}/install.sh"
       mode: '0700'
     when: airgap_mode and rke2_install_method == 'copy'

   - name: Create RKE2 artifacts folder
     file:
       path: "{{ rke2_artifacts_dir }}"
       state: directory
       mode: '0700'
     when: airgap_mode and rke2_install_method != 'exists'

   - name: Download RKE2 checksum and artifacts
     block:
       - get_url:
           url: "{{ rke2_checksum_url }}"
           dest: "{{ rke2_artifacts_dir }}/sha256sum.txt"
       - shell: "cd {{ rke2_artifacts_dir }} && sha256sum -c sha256sum.txt"
     rescue:
       - copy:
           src: "{{ rke2_checksum_local_path }}"
           dest: "{{ rke2_artifacts_dir }}"
       - copy:
           src: "{{ rke2_artifacts_local_path }}"
           dest: "{{ rke2_artifacts_dir }}"
           mode: '0640'
     when: not airgap_mode

   - name: Copy local RKE2 artifacts
     copy:
       src: "{{ rke2_artifacts_local_path }}"
       dest: "{{ rke2_artifacts_dir }}"
       mode: '0640'
     when: airgap_mode and rke2_install_method == 'copy'

   - name: Airgap mode - additional images tarballs
     block:
       - file:
           path: "{{ rke2_tarballs_dir }}"
           state: directory
       - copy:
           src: "{{ item }}"
           dest: "{{ rke2_tarballs_dir }}/"
         with_fileglob: "{{ rke2_tarballs_local_path }}/*"
     when: airgap_mode and rke2_additional_tarballs is defined

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ item }}"
       mode: "{{ '0440' if item.endswith('.sha256') else '0750' }}"
     with_fileglob: "{{ rke2_artifacts_dir }}/*"
     when: airgap_mode and rke2_install_method == 'exists'

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: /usr/local
     register: usr_local_fs

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "{{ '/var/lib/rancher/rke2/bin' if usr_local_fs.stat.writeable else '/usr/local/bin' }}"

   - name: Check RKE2 version
     shell: "{{ rke2_bin_path }}/rke2 --version || /usr/local/bin/rke2 --version || true"
     register: rke2_version_check
     changed_when: false

   - name: Prevent accidental RKE2 downgrade
     assert:
       that:
         - not rke2_version_check.stdout or rke2_version_check.stdout | regex_replace('v', '') is version_compare(rke2_version, '>=') or rke2_allow_downgrade | default(false)
       fail_msg: "Downgrade from '{{ rke2_version_check.stdout }}' to '{{ rke2_version }}' is not allowed. Set rke2_allow_downgrade to true to override."

   - name: Run RKE2 install script
     shell: "airgap_install={{ airgap_mode | ternary('--airgap-install', '') }} {{ rke2_artifacts_dir }}/install.sh"
     environment:
       INSTALL_RKE2_VERSION: "{{ rke2_version }}"
       INSTALL_RKE2_TYPE: "{{ rke2_type }}"
       INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"
       INSTALL_RKE2_BIN_DIR: "{{ rke2_bin_path }}"
       INSTALL_RKE2_SYSTEM_DEFAULTS: "{{ rke2_system_defaults | default('true') }}"
       INSTALL_RKE2_SELINUX: "{{ rke2_selinux | default('') }}"
       INSTALL_RKE2_SYSTEM_EXTRA_ARGS: "{{ rke2_system_extra_args | default('') }}"
       INSTALL_RKE2_SYSTEM_EXTRA_ENV: "{{ rke2_system_extra_env | default('') }}"
       INSTALL_RKE2_MIRROR: "{{ rke2_mirror | default('') }}"
       INSTALL_RKE2_SKIP_DOWNLOAD: "{{ rke2_skip_download | default('false') }}"

   - name: Copy Custom Manifests
     template:
       src: custom_manifests.yml.j2
       dest: "{{ rke2_manifest_dir }}/custom.yml"
     when: rke2_custom_manifests is defined

   - name: Copy Static Pods
     copy:
       src: "{{ item }}"
       dest: "{{ rke2_pod_manifest_dir }}/"
     with_fileglob: "{{ rke2_static_pods_local_path }}/*"
     when: rke2_static_pods_local_path is defined

   - name: Copy RKE2 environment file
     template:
       src: rke2_environment.j2
       dest: "{{ rke2_environment_file }}"
       mode: '0644'
     when: rke2_environment_options is defined

