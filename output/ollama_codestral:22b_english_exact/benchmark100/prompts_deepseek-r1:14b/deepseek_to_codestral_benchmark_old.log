 - name: Create local SSH key directory for user
     file:
       path: /home/{{ user }}/.ssh
       state: directory
       owner: "{{ user }}"
       mode: 0750

   - name: Manage user account
     user:
       name: "{{ user }}"
       state: present
       comment: "{{ user_comment }}"
       home: "{{ user_home }}"
       shell: "{{ user_shell }}"

   - name: Set sudo options for user
     copy:
       dest: /etc/sudoers.d/{{ user }}
       content: "{{ user }} ALL=(ALL) NOPASSWD:ALL\n"
       validate: 'visudo -csf %s'

   - name: Generate private SSH key for user
     command: ssh-keygen -t rsa -b 4096 -f /home/{{ user }}/.ssh/id_rsa -N ""
     args:
       creates: /home/{{ user }}/.ssh/id_rsa

   - name: Generate public SSH key for user
     command: ssh-keygen -y -f /home/{{ user }}/.ssh/id_rsa > /home/{{ user }}/.ssh/id_rsa.pub
     args:
       creates: /home/{{ user }}/.ssh/id_rsa.pub

   - name: Convert SSH key to ppk format for user
     command: puttygen /home/{{ user }}/.ssh/id_rsa -o /home/{{ user }}/.ssh/id_rsa.ppk -O private
     args:
       creates: /home/{{ user }}/.ssh/id_rsa.ppk

   - name: Get or set the home directory for user
     shell: echo $HOME || echo "/home"
     register: home_dir

   - name: Create .ssh directory for user
     file:
       path: "{{ home_dir.stdout }}/.ssh"
       state: directory
       owner: "{{ user }}"
       mode: 0700

   - name: Deploy authorized keys for user
