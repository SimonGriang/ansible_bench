 - name: Import assertion file
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install cron package
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure cron shell environment
     cron:
       name: "Set SHELL environment"
       env: true
       job: "SHELL=/bin/bash"

   - name: Configure cron path environment
     cron:
       name: "Set PATH environment"
       env: true
       job: "PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"

   - name: Configure cron mailto settings
     cron:
       name: "Set MAILTO for notifications"
       env: true
       job: "MAILTO={{ cron_mailto }}"

   - name: Start and enable cron service
     service:
       name: "{{ cron_service }}"
       state: started
       enabled: true
     when: cron_service is defined

   - name: Schedule cron jobs
     cron:
       name: "{{ item.name }}"
       minute: "{{ item.minute }}"
       hour: "{{ item.hour }}"
       day: "{{ item.day | default('*') }}"
       month: "{{ item.month | default('*') }}"
       weekday: "{{ item.weekday | default('*') }}"
       job: "{{ item.job }}"
     loop: "{{ cron_jobs }}"
     when: cron_jobs is defined


