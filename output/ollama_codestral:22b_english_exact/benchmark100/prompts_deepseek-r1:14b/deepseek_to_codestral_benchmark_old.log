           state: enforcing
       - name: Install required SELinux policies
         command: semodule -i /path/to/policies/
       - name: Enforce AppArmor profiles for Vault
         command: aa-enforce /etc/apparmor.d/vault
     when: vault_hardening_configure_selinux_apparmor | bool

