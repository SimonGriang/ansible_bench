---
- name: Import assertion tasks
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Docker Compose package
  package:
    name: docker-compose
    state: present
  when: installation_type == "package"

- name: Install Docker Compose binary
  block:
    - name: Install required packages
      package:
        name:
          - python3-pip
          - libffi-dev
          - libssl-dev
        state: present

    - name: Install docker-compose with pip
      pip:
        name: docker-compose
        state: present
        executable: pip3

    - name: Move docker-compose to /usr/local/bin
      copy:
        src: /usr/local/bin/docker-compose
        dest: /usr/local/bin/docker-compose
        mode: 0755
        remote_src: yes
  when: installation_type == "binary"


