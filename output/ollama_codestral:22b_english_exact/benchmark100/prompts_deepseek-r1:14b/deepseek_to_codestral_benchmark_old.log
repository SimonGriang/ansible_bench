 - name: Import assert
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: yes

   - name: Wait for port to be available
     wait_for:
       port: "{{ port }}"
       timeout: "{{ bootstrap_timeout }}"
     connection: all
     become: no

   - name: Prepare system
     block:
       - name: Test connection and sudo access
         ping:
       - name: Gather facts
         setup:
       - name: Install necessary packages
         raw: "{{ ansible_facts.pkg_mgr }} install -y {{ 'libdnf5' if 'RedHat' in ansible_facts.os_family else '' }} {{ 'python3' if ansible_facts.python.version.major == 2 else '' }}"
         changed_when: false
     rescue:
       - name: Gather facts
         setup:
       - name: Install necessary packages
         raw: "{{ ansible_facts.pkg_mgr }} install -y {{ 'libdnf5' if 'RedHat' in ansible_facts.os_family else '' }} {{ 'python3' if ansible_facts.python.version.major == 2 else '' }}"
         changed_when: false

   - name: Gather ansible facts
     setup:
     become: no

   - name: Install bootstrap packages (package)
     package:
       name: "{{ bootstrap_facts_packages }}"
       state: present
     become: "{{ bootstrap_become }}"

