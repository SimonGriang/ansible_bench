---
   - name: Generate OpenSSL private key
     openssl_privatekey:
       path: "{{ key_directory }}/private_key.pem"
       mode: '0400'

   - name: Generate OpenSSL CSR
     openssl_csr:
       path: "{{ csr_directory }}/csr.pem"
       privatekey_path: "{{ key_directory }}/private_key.pem"
       common_name: "{{ common_name }}"
       mode: '0400'

   - name: Generate OpenSSL X.509 certificate
     openssl_certificate:
       path: "{{ cert_directory }}/cert.pem"
       privatekey_path: "{{ key_directory }}/private_key.pem"
       csr_path: "{{ csr_directory }}/csr.pem"
       provider: selfsigned
       mode: '0400'

   - name: Generate PKCS#12 file
     openssl_pkcs12:
       path: "{{ key_directory }}/cert.p12"
       privatekey_path: "{{ key_directory }}/private_key.pem"
       certificate_path: "{{ cert_directory }}/cert.pem"
       friendly_name: "{{ friendly_name }}"
       mode: '0400'

   - name: Read private key content
     shell: "cat {{ key_directory }}/private_key.pem"
     register: private_key_content

   - name: Read certificate content
     shell: "cat {{ cert_directory }}/cert.pem"
     register: certificate_content

   - name: Create a combined private key and certificate file
     copy:
       content: |
         {{ private_key_content.stdout }}
         {{ certificate_content.stdout }}
       dest: "{{ key_directory }}/combined.pem"
       mode: '0400'

