---
   - name: Import assertion file
     import_tasks: assert.yml

   - name: Install cron packages
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure cron shell
     cronvar:
       name: SHELL
       value: "{{ cron_shell }}"
     notify: Restart cron service

   - name: Configure cron path
     cronvar:
       name: PATH
       value: "{{ cron_path }}"
     notify: Restart cron service

   - name: Configure cron mailto
     cronvar:
       name: MAILTO
       value: "{{ cron_mailto }}"
     notify: Restart cron service

   - name: Start and enable cron service
     service:
       name: "{{ cron_service }}"
       state: started
       enabled: true
     when: cron_service is defined and cron_service | length > 0

   - name: Schedule cron jobs
     cron:
       name: "{{ item.name }}"
       job: "{{ item.job }}"
       minute: "{{ item.minute | default('*') }}"
       hour: "{{ item.hour | default('*') }}"
       day: "{{ item.day | default('*') }}"
       month: "{{ item.month | default('*') }}"
       weekday: "{{ item.weekday | default('*') }}"
     loop: "{{ cron_jobs }}"
     loop_control:
       label: "{{ item.name }}"

   - name: Handler to restart cron service
     service:
       name: cron
       state: restarted
     listen: Restart cron service


