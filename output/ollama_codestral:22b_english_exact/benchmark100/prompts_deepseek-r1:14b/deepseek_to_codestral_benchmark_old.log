 - name: "Import assert.yml"
     import_tasks: assert.yml
     delegate_to: localhost

   - name: "Install mysql"
     package:
       name: "{{ mysql_packages }}"
     notify:
       - root password
       - systemctl daemon reexecution

   - name: "Configure mysql server"
     ini_file:
       path: /etc/mysql/mariadb.conf.d/50-server.cnf
       section: mysqld
       option: "{{ item.option }}"
       value: "{{ item.value }}"
       mode: 0644
     loop: "{{ mysql_server_settings }}"
     notify:
       - mysql server restart

   - name: "Configure mysql client"
     ini_file:
       path: /etc/mysql/mariadb.conf.d/50-client.cnf
       section: client
       option: socket
       value: /var/run/mysqld/mysqld.sock
       mode: 0644

   - name: "Initialize mysql"
     command: "mysql_install_db --user=mysql"
     args:
       creates: /var/lib/mysql/mysql/user.frm
     when: ansible_os_family in ['Alpine', 'Archlinux']

   - name: "Start and enable mysql"
     service:
