 - name: Import assert.yml
      import_tasks: assert.yml

    - name: Pre-configure debian systems
      debconf:
        name: postfix
        question: '{{ item.question }}'
        value: '{{ item.value }}'
        vtype: '{{ item.vtype }}'
      with_items:
        - { question: 'postfix/main_mailer_type', value: 'Internet Site', vtype: 'string' }
        - { question: 'postfix/mailname', value: '{{ ansible_fqdn }}', vtype: 'string' }

    - name: Install postfix
      apt:
        name: postfix
        state: present

    - name: Install postfix-mysql
      apt:
        name: postfix-mysql
        state: present

    - name: Configure postfix (transport_maps)
      template:
        src: transport_maps.cf.j2
        dest: /etc/postfix/transport_maps.cf
      notify:
        - validate-transport-maps
        - rebuild-database

    - name: Configure postfix (header_checks)
      template:
        src: header_checks.j2
        dest: /etc/postfix/header_checks
      notify:
        - validate-header-checks
        - reload-postfix

    - name: Setting values for main.cf (1/2)
      set_fact:
        postfix_mynetworks: "127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128"
        postfix_smtpd_sender_restrictions: "reject_unknown_sender_domain"

    - name: Setting values for main.cf (2/2)
      set_fact:
        postfix_mynetworks: "{{ postfix_mynetworks }} {{ postfix_additional_networks | default('') }}"
        postfix_mydestination: "{{ ansible_fqdn }}, localhost, localhost.localdomain"
        postfix_relay_domains: "{{ postfix_additional_relay_domains | default('') }}"
        postfix_smtpd_recipient_restrictions: "reject_unknown_recipient_domain"

    - name: Configure postfix (main.cf)
      template:
        src: main.cf.j2
        dest: /etc/postfix/main.cf
      notify:
        - validate-main-cf
        - restart-postfix

    - name: Configure postfix (master.cf)
      template:
        src: master.cf.j2
        dest: /etc/postfix/master.cf
      notify:
        - validate-master-cf
        - restart-postfix

    - name: Creates cert/key directory
      file:
        path: "{{ item }}"
        state: directory
        mode: '0700'
      with_items:
        - /etc/postfix/certs
        - /etc/postfix/keys

    - name: Deploy Postfix TLS server certificate
      copy:
        src: server.crt
        dest: /etc/postfix/certs/server.crt
      notify:
        - reload-postfix

    - name: Deploy Postfix TLS server key
      copy:
        src: server.key
        dest: /etc/postfix/keys/server.key
        mode: '0600'
      notify:
        - reload-postfix

    - name: Flush handlers
      meta: flush_handlers

    - name: Configure aliases
      lineinfile:
        path: /etc/aliases
        line: "{{ item }}"
      with_items:
        - "postmaster: root"
        - "mailer-daemon: root"
      notify:
        - rebuild-aliases
        - reload-postfix

    - name: Configure sender_access
      template:
        src: sender_access.j2
        dest: /etc/postfix/sender_access
      notify:
        - validate-sender-access
        - rebuild-database
        - reload-postfix

    - name: Configure recipient_access
      template:
        src: recipient_access.j2
        dest: /etc/postfix/recipient_access
      notify:
        - validate-recipient-access
        - rebuild-database
        - reload-postfix

    - name: Place sasl_password_map
      copy:
        src: sasl_password_map
        dest: /etc/postfix/sasl_password_map
      notify:
        - rebuild-sasl-password-map

    - name: Flush handlers again
      meta: flush_handlers

    - name: Start and enable postfix
      service:
        name: postfix
        state: started
        enabled: yes

