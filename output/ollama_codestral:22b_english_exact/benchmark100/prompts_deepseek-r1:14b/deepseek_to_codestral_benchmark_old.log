 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Configure apk
     apk:
       update_cache: yes
       upgrade: 'no'
     changed_when: false

   - name: Configure apt
     apt:
       upgrade: "{{ 'no' if ('package1' in ansible_facts['packages'] or 'package2' in ansible_facts['packages']) else 'safe' }}"
       update_cache: yes
       force_apt_get: yes

   - name: Update all software (dnf)
     dnf:
       name: "*"
       state: latest
       exclude: "package1,package2"

   - name: Update all software (pacman)
     pacman:
       update_cache: yes
       upgrade: yes

   - name: Configure yum
     block:
       - name: Check if system is CentOS/RHEL 6
         command: "rpm -q --queryformat '%{VERSION}' redhat-release-server"
         register: rhel_version
         changed_when: false

       - name: Update all software (yum)
         yum:
           name: "*"
           state: latest
         when: rhel_version.stdout != '6'

       - name: Update all software (dnf)
         dnf:
           name: "*"
           state: latest
         when: rhel_version.stdout == '6'
     when: ansible_pkg_mgr == "yum"

   - name: Install yum-utils for non-CentOS/RHEL 6 systems
     package:
       name: yum-utils
       state: present
     when: ansible_pkg_mgr == "yum" and rhel_version.stdout != '6'

   - name: Update all software (zypper)
     zypper:
       name: "*"
       state: latest

