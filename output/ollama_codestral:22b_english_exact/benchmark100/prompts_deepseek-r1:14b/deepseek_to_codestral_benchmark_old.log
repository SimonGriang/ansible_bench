         register: rhel_version
         changed_when: false

       - name: Update all software (yum)
         yum:
           name: "*"
           state: latest
         when: rhel_version.stdout != '6'

       - name: Update all software (dnf)
         dnf:
           name: "*"
           state: latest
         when: rhel_version.stdout == '6'
     when: ansible_pkg_mgr == "yum"

   - name: Install yum-utils for non-CentOS/RHEL 6 systems
     package:
       name: yum-utils
       state: present
     when: ansible_pkg_mgr == "yum" and rhel_version.stdout != '6'

   - name: Update all software (zypper)
     zypper:
       name: "*"
       state: latest


