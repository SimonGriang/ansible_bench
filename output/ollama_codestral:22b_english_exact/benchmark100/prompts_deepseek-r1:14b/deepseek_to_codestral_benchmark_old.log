 - name: Import preflight tasks
     import_tasks: preflight.yml
     tags:
       - promtail_install
       - promtail

   - name: Import installation tasks
     import_tasks: install.yml
     become: True
     tags:
       - promtail_install
       - promtail

   - name: Ensure promtail service is started and enabled
     systemd:
       daemon_reload: True
       name: "{{ promtail_systemd_service }}"
       state: started
       enabled: True
     tags:
