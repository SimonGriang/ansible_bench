---
   - name: Import assert.yml
     ansible.builtin.import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Wait for port to be available
     ansible.builtin.wait_for:
       port: 22
       timeout: "{{ bootstrap_timeout }}"
     when:
       - ansible_connection is defined
       - ansible_connection != 'container'
       - bootstrap_wait_for_host

   - name: Test connection
     block:
       - name: Prepare system
         ansible.builtin.wait_for_connection:
           timeout: "{{ bootstrap_timeout }}"
         register: bootstrap_connect
         changed_when: false

   - name: Test sudo
     block:
       - name: Prepare system
         ansible.builtin.command: 'sudo --version'
         changed_when: false

   - name: Gather bootstrap facts
     block:
       - name: Prepare system
         ansible.builtin.include_tasks: gather_facts.yml
         when: bootstrap_connect is failed

   - name: Install bootstrap packages (raw)
     block:
       - name: Prepare system
         ansible.builtin.raw: "{{ bootstrap_install.raw }}"
         register: bootstrap_install_packages
         changed_when: >
           bootstrap_install_packages.stdout | regex_search('(No packages marked for (installation|update))|(already installed)')
           and ansible_facts.os_family != "RedHat"
         executable: /bin/sh
         when: bootstrap_connect is failed

   - name: Ensure libdnf5 is present on Fedora/RedHat
     block:
       - name: Prepare system
         ansible.builtin.raw: 'dnf install -y python3-libdnf5'
         executable: /bin/sh
         when:
           - bootstrap_connect is failed
           - ansible_facts.os_family == "RedHat"

   - name: Gather ansible facts
     ansible.builtin.setup:
       gather_subset: all
     become: false

   - name: Install bootstrap packages (package)
     ansible.builtin.package:
       name: "{{ bootstrap_facts_packages.split() }}"
       state: present
       update_cache: true
       become: "{{ bootstrap_become }}"

