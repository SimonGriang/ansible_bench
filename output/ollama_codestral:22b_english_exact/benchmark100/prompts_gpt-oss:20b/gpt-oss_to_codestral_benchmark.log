content=' ---\n   - name: Import assert.yml\n     import_tasks: assert.yml\n     delegate_to: localhost\n     run_once: true\n\n   - name: Install apache httpd\n     package:\n       name: "{{ httpd_packages }}"\n       state: present\n\n   - name: Configure selinux\n     seboolean:\n       name: "{{ item.key }}"\n       state: true\n       persistent: true\n     loop: "{{ httpd_sebooleans | dict2items }}"\n     when: ansible_selinux.status == "enabled"\n\n   - name: Add SELinux port entries\n     seport:\n       ports: "{{ httpd_port }}{{ \', \' + httpd_ssl_port if httpd_ssl_port is defined else \'\' }}"\n       proto: tcp\n       setype: http_port_t\n       state: present\n     when: ansible_selinux.status == "enabled"\n\n   - name: Configure httpd\n     template:\n       src: "{{ httpd_config_src }}"\n       dest: "{{ httpd_config_dest }}"\n       mode: \'0644\'\n     notify:\n       - Test httpd configuration validity\n       - Restart httpd\n\n   - name: Activate httpd module | Debian\n     command: "a2enmod {{ item }}"\n     loop: "{{ httpd_modules_to_activate_with_command }}"\n     changed_when: false\n     notify:\n       - Test httpd configuration validity\n     when: ansible_os_family == \'Debian\'\n\n   - name: Import ssl.yml\n     import_tasks: ssl.yml\n     when: https_ssl_enable | bool\n\n   - name: Import locations.yml\n     import_tasks: locations.yml\n     when: httpd_locations is defined\n\n   - name: Import vhosts.yml\n     import_tasks: vhosts.yml\n     when: httpd_vhosts is defined\n\n   - name: Configure ports\n     template:\n       src: "{{ httpd_ports_conf }}.j2"\n       dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"\n       mode: \'0644\'\n     notify:\n       - Test httpd configuration validity\n       - Restart httpd\n     when: ansible_os_family in [\'Debian\', \'Suse\']\n\n   - name: Import directories.yml\n     import_tasks: directories.yml\n     when: httpd_directories is defined\n\n   - name: Flush handlers\n     meta: flush_handlers\n\n   - name: Removing default html\n     file:\n       path: "{{ httpd_data_directory }}/index.html"\n       state: absent\n     when: httpd_remove_example | bool\n\n   - name: Start and enable httpd\n     service:\n       name: "{{ httpd_service }}"\n       state: started\n       enabled: true\n   ...' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-17T09:23:17.902323774Z', 'done': True, 'done_reason': 'stop', 'total_duration': 19372953766, 'load_duration': 26627835, 'prompt_eval_count': 1923, 'prompt_eval_duration': 162646987, 'eval_count': 732, 'eval_duration': 19182399987, 'model_name': 'codestral:22b'} id='run--64e8ac05-5f3e-4e34-85cc-e00d52d80395-0' usage_metadata={'input_tokens': 1923, 'output_tokens': 732, 'total_tokens': 2655}
