---
   - name: Import assert.yml
     ansible.builtin.import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Wait for port to be available
     ansible.builtin.wait_for:
       port: "{{ ansible_port | default(22) }}"
       timeout: "{{ bootstrap_timeout }}"
     when:
       - ansible_connection is defined
       - ansible_connection != 'container'
       - ansible_connection != 'docker'
       - bootstrap_wait_for_host

   - name: Prepare system
     block:
       - name: Check connection and sudo
         ansible.builtin.shell: sudo --version
         async: "{{ bootstrap_timeout }}"
         poll: 1
         register: sudo_check
         ignore_errors: true

       - name: Gather bootstrap facts and install bootstrap packages
         when: sudo_check.failed or sudo_check.rc != 0
         block:
           - name: Gather bootstrap facts
             ansible.builtin.include_tasks: gather_facts.yml

           - name: Install bootstrap packages
             ansible.builtin.raw: "{{ bootstrap_install.raw }}"
             register: bootstrap_install_packages

           - name: Check bootstrap packages installation
             ansible.builtin.assert:
               that:
                 - >-
                   (bootstrap_facts_ansible_distribution == 'Alpine' or
                   bootstrap_facts_ansible_distribution == 'Archlinux' or
                   bootstrap_facts_ansible_distribution == 'Gentoo') and
                   bootstrap_install_packages.stdout |
                   regex_search(bootstrap_install.stdout_regex)
                 - >-
                   (bootstrap_facts_ansible_distribution == 'Debian' or
                   bootstrap_facts_ansible_distribution == 'RedHat' or
                   bootstrap_facts_ansible_distribution == 'Rocky' or
                   bootstrap_facts_ansible_distribution == 'Suse') and
                   not bootstrap_install_packages.stdout |
                   regex_search(bootstrap_install.stdout_regex)
     rescue:
       - ansible.builtin.fail:
           msg: "Failed to prepare system"

   - name: Gather ansible facts
     ansible.builtin.setup:
     become: false

   - name: Install bootstrap packages (package)
     ansible.builtin.package:
       name: "{{ bootstrap_facts_packages.split() }}"
       state: present
       update_cache: yes
     become: "{{ bootstrap_become }}"


