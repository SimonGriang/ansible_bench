---
   - name: Create the RKE2 config dir
     file:
       path: /etc/rancher/rke2
       state: directory
       owner: root
       group: root
       mode: 0755

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_type == 'server'

   - name: Copy rke2 config
     template:
       src: "{{ rke2_config }}"
       dest: /etc/rancher/rke2/config.yaml
       owner: root
       group: root
       mode: 0600
     notify: Config file changed

   - name: Copy kubelet config
     template:
       src: templates/kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       owner: root
       group: root
       mode: 0600
     when: rke2_kubelet_config != ''
     notify: Config file changed

   - name: Copy Containerd Registry Configuration file
     template:
       src: "{{ rke2_custom_registry_path }}"
       dest: /etc/rancher/rke2/registries.yaml
       owner: root
       group: root
       mode: 0600
     when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
     notify: Config file changed

   - name: Register if we need to do a etcd restore from file
     set_fact:
       do_etcd_restore: true
     when: rke2_etcd_snapshot_file != '' and (service_facts['rke2-server.service'] is not defined or service_facts['rke2-server.service']['state'] != 'running')

   - name: Register if we need to do a etcd restore from s3
     set_fact:
       do_etcd_restore_from_s3: true
     when: rke2_etcd_snapshot_file != '' and rke2_etcd_snapshot_s3_options is defined and 'access_key' in rke2_etcd_snapshot_s3_options and 'secret_key' in rke2_etcd_snapshot_s3_options and 'bucket' in rke2_etcd_snapshot_s3_options and 'snapshot_name' in rke2_etcd_snapshot_s3_options

   - name: Restore etcd from file
     block:
       - file:
           path: "{{ rke2_etcd_snapshot_destination_dir }}"
           state: directory
       - copy:
           src: "{{ rke2_etcd_snapshot_source_dir }}/{{ rke2_etcd_snapshot_file }}"
           dest: "{{ rke2_etcd_snapshot_destination_dir }}/{{ rke2_etcd_snapshot_file }}"
       - command: "rke2 server --cluster-reset --cluster-reset-restore-path={{ rke2_etcd_snapshot_destination_dir }}/{{ rke2_etcd_snapshot_file }} --token={{ rke2_token }}"
     when: do_etcd_restore is defined

   - name: Restore etcd from s3
     command: >
       rke2 server --cluster-reset --etcd-s3
       --etcd-s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }}
       --etcd-s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }}
       --etcd-s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }}
       --etcd-s3-endpoint={{ rke2_etcd_snapshot_s3_options.endpoint | default('') }}
       --etcd-s3-region={{ rke2_etcd_snapshot_s3_options.region | default('') }}
       {% if rke2_etcd_snapshot_s3_options.endpoint_ca is defined %}--etcd-s3-endpoint-ca={{ rke2_etcd_snapshot_s3_options.endpoint_ca }}{% endif %}
       {% if rke2_etcd_snapshot_s3_options.folder is defined %}--etcd-s3-folder={{ rke2_etcd_snapshot_s3_options.folder }}{% endif %}
       {% if rke2_etcd_snapshot_s3_options.skip_ssl_verify | default(false) %}--etcd-s3-skip-ssl-verify{% endif %}
       --token={{ rke2_token }}
     when: do_etcd_restore_from_s3 is defined

   - name: Start RKE2 service on the first server
     systemd:
       name: rke2-server.service
       state: started
       enabled: yes
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     notify: Service (re)started

   - name: Mask RKE2 agent service on the first server
     systemd:
       name: rke2-agent.service
       state: stopped
       enabled: no
       masked: yes

   - name: Wait for the first server be ready - no CNI
     command: kubectl get node "{{ rke2_node_name }}"
     register: kube_describe
     until: >
       ('Allocated memory' in kube_describe.stdout and 'Sufficient memory' in kube_describe.stdout) or
       ('Allocated disk' in kube_describe.stdout and 'No disk pressure' in kube_describe.stdout) or
       ('Allocated PID' in kube_describe.stdout and 'Sufficient PID' in kube_describe.stdout) or
       ('Initialized' in kube_describe.stdout and 'false' in kube_describe.stdout) or
       ('KubeletReady' in kube_describe.stdout and 'true' in kube_describe.stdout)
     retries: 100
     delay: 15
     when: not ansible_check_mode and rke2_cni == 'none'

   - name: Wait for the first server be ready - with CNI
     command: kubectl get nodes | grep "{{ rke2_node_name }}"
     register: kube_nodes
     until: '" Ready " in kube_nodes.stdout'
     retries: 40
     delay: 15
     when: not ansible_check_mode and rke2_cni != 'none'

   - name: Restore etcd
     block:
       - command: kubectl get nodes --no-headers
         register: kube_nodes
       - set_fact:
           registered_nodes: "{{ kube_nodes.stdout_lines }}"
       - set_fact:
           all_nodes: "{{ groups[rke2_cluster_group_name] | map('extract', hostvars, 'inventory_hostname') | list }}"
       - name: Delete old node-password secrets
         command: kubectl delete secret {{ item }}-node-password
         loop: "{{ all_nodes | difference(registered_nodes) }}"
         ignore_errors: yes
       - name: Delete old node objects
         command: kubectl delete node {{ item }}
         loop: "{{ all_nodes | difference(registered_nodes) }}"
         ignore_errors: yes
     when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

   - name: Set an Active Server variable
     set_fact:
       active_server: "{{ inventory_hostname }}"
     delegate_to: "{{ item }}"
     delegate_facts: true
     loop: "{{ groups[rke2_cluster_group_name] }}"

