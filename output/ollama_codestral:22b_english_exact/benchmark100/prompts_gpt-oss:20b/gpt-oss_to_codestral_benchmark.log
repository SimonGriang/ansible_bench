 - name: Cordon and Drain the node {{ rke2_node_name }}
     shell: >-
       set -o pipefail &&
       {{ rke2_data_path }}kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml drain
       {{ rke2_node_name }} {{ rke2_drain_additional_args }}
     register: drain
     retries: 100
     delay: 15
     until: '"drained" in drain.stdout'
     changed_when: false
     run_once: true
     delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
     when: rke2_drain_node_during_upgrade | bool

   - name: Restart RKE2 service on {{ rke2_node_name }}
     service:
       name: "{{ rke2_service_name }}"
       state: restarted
     notify: Service (re)started

   - name: Wait for all nodes to be ready again
     shell: >-
       {{ rke2_data_path }}kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes |
       grep -c ' Ready'
     register: all_ready_nodes
     retries: 100
     delay: 15
     until: all_ready_nodes.stdout | int == groups[rke2_cluster_group_name] | length
     changed_when: false
     run_once: true
     delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

   - name: Uncordon the node {{ rke2_node_name }}
     shell: >-
       set -o pipefail &&
       {{ rke2_data_path }}kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml uncordon
       {{ rke2_node_name }}
     changed_when: false
     run_once: true
     delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
     when: rke2_drain_node_during_upgrade | bool

   - name: Wait for all pods to be ready again
     shell: >-
       {{ rke2_data_path }}kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods
       -A --field-selector=status.phase!=Running,status.phase!=Succeeded
       --ignore-not-found | wc -l
     register: all_pods_ready
     retries: 100
     delay: 15
     until: all_pods_ready.stdout | int == 0
     changed_when: false
     run_once: true
     delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
     when: rke2_wait_for_all_pods_to_be_ready | bool

   - name: Wait for all pods to pass readiness checks
     shell: >-
       set -o pipefail &&
       {{ rke2_data_path }}kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml wait
       {{ rke2_wait_for_all_pods_to_be_healthy_args }}
     changed_when: false
     retries: 100
     delay: 15
     run_once: true
     delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
     when: rke2_wait_for_all_pods_to_be_healthy | bool

