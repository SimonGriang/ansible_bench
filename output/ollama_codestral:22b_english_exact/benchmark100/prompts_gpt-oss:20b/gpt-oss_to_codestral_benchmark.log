     register: result
     until: result.stdout | int == groups[rke2_cluster_group_name] | length
     retries: 30
     delay: 10
     when:
       - rke2_cni != 'none'
       - not ansible_check_mode
       - (inventory_hostname == active_server or inventory_hostname == groups[rke2_servers_group_name][0])

