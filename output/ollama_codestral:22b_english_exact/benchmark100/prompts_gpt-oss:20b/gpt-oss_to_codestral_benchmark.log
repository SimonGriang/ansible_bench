               postfix_mynetworks -%}
         {%- endif -%}
         {%- set _net_list = _net_list + ['127.0.0.0/8', '[::1]/128'] -%}
         {{ _net_list | unique | join(', ') }}
       _postfix_mydestination: >-
         {%- set _dest_list = [] -%}
         {%- if postfix_mydestination is defined -%}
           {%- set _dest_list = _dest_list + [postfix_mydestination] if
               postfix_mydestination is string else _dest_list +
               postfix_mydestination -%}
         {%- endif -%}
         {%- set _dest_list = _dest_list + ['localhost', ansible_fqdn,
               ansible_hostname] -%}
         {{ _dest_list | unique | join(', ') }}
       _postfix_relay_domains: >-
         {%- if postfix_relay_domains is defined -%}
           {{ postfix_relay_domains | join(', ') }}
         {%- else -%}
           ''
         {%- endif -%}
       _postfix_smtpd_recipient_restrictions: >-
         {%- set _recip_list = [] -%}
         {%- if postfix_smtpd_recipient_restrictions is defined -%}
           {%- set _recip_list = _recip_list +
               [postfix_smtpd_recipient_restrictions] if
