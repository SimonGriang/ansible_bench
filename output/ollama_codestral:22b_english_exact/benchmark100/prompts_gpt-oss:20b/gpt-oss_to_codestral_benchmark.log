29106949Z', 'done': True, 'done_reason': 'stop', 'total_duration': 51994641994, 'load_duration': 17207181, 'prompt_eval_count': 1660, 'prompt_eval_duration': 1297194411, 'eval_count': 1960, 'eval_duration': 50678931841, 'model_name': 'codestral:22b'} id='run--76639d18-64d1-4d35-a527-febcc121da45-0' usage_metadata={'input_tokens': 1660, 'output_tokens': 1960, 'total_tokens': 3620}
