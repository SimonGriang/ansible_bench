---
   - name: Import assert.yml
     ansible.builtin.import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install mysql
     ansible.builtin.package:
       name: "{{ mysql_packages }}"
       state: present
     notify:
       - Set root password
       - Systemctl daemon-reexec

   - name: Configure mysql server
     community.general.ini_file:
       path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
       section: "{{ item.section }}"
       option: "{{ item.option }}"
       value: "{{ item.value }}"
     loop: "{{ mysql_configuration_options }}"
     notify: Restart mysql server

   - name: Configure mysql client
     community.general.ini_file:
       path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
       section: client
       option: socket
       value: "{{ mysql_socket }}"

   - name: Initialize mysql
     ansible.builtin.command: "{{ mysql_initialize_command }}"
     args:
       creates: "/var/lib/mysql/mysql"
     when: ansible_distribution == 'Alpine' or ansible_distribution == 'Archlinux'

   - name: Start and enable mysql
     ansible.builtin.service:
       name: "{{ mysql_service }}"
       state: started
       enabled: true

   - name: Flush handlers
     ansible.builtin.meta: flush_handlers

   - name: Place my.cnf
     ansible.builtin.template:
       src: my.cnf.j2
       dest: /root/.my.cnf
       mode: '0640'

   - name: Create databases
     community.mysql.mysql_db:
       name: "{{ item.name }}"
       state: "{{ item.state | default('present') }}"
       target: "{{ item.target | default(omit) }}"
       encoding: "{{ item.encoding | default(omit) }}"
       collation: "{{ item.collation | default(omit) }}"
       login_unix_socket: "{{ mysql_socket }}"
       login_password: "{{ mysql_root_password }}"
     loop: "{{ mysql_databases }}"
     loop_control:
       label: "{{ item.name }}"
     when:
       - mysql_databases is defined
       - item.initial_import is not defined
     no_log: true

   - name: List databases
     community.mysql.mysql_info:
       filter: databases
       login_unix_socket: "{{ mysql_socket }}"
       login_password: "{{ mysql_root_password }}"
     register: mysql_info
     no_log: true

   - name: Import database
     community.mysql.mysql_db:
       name: "{{ item.name }}"
       state: import
       target: "{{ item.initial_import }}"
       login_unix_socket: "{{ mysql_socket }}"
       login_password: "{{ mysql_root_password }}"
     loop: "{{ mysql_databases }}"
     loop_control:
       label: "{{ item.name }}"
     when:
       - item.initial_import is defined
       - item.name not in mysql_info.databases

   - name: Create users
     community.mysql.mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv | default(omit) }}"
       host: "{{ item.host | default(omit) }}"
