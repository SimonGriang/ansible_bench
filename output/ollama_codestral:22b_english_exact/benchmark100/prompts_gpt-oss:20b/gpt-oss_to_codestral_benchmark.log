               state: present

       - name: Install hashicorp product using package
         loop: "{{ hashicorp_products }}"
         loop_control:
           loop_var: product
         block:
           - name: Install latest hashicorp product using package
             when: product.version is not defined
             package:
               name: "{{ product.name }}"
               state: present

           - name: Install versioned hashicorp product using package
             when: product.version is defined
             package:
               name: "{{ product.name }}={{ product.version }}"
               state: present

   - name: Install manually
     when: hashicorp_install_method == 'manual'
     block:
       - name: Install hashicorp product manually
         loop: "{{ hashicorp_products }}"
         loop_control:
           loop_var: product
         unarchive:
           src: "{{ hashicorp_src }}/{{ product.name }}_{{ product.version }}_{{ ansible_system | lower }}_
                 {{ hashicorp_architecture_mapping[ansible_architecture] }}.zip"
           dest: "{{ hashicorp_destination }}"
           remote_src: true
           group: "{{ hashicorp_group }}"
           owner: "{{ hashicorp_user }}"
           mode: "{{ hashicorp_mode }}"

