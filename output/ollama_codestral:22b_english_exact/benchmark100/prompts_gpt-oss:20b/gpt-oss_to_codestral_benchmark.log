 - name: Import assert.yml
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Configure apk
     block:
       - name: Update apk cache
         community.general.apk:
           update_cache: true
         changed_when: false

       - name: Upgrade all packages
         community.general.apk:
           upgrade: true
         notify: Reboot
     when: ansible_pkg_mgr == "apk"

   - name: Configure apt
     block:
       - name: Hold selected packages to prevent upgrade
         ansible.builtin.dpkg_selections:
           name: "{{ item }}"
           selection: hold
         loop: "{{ update_excluded_packages }}"

       - name: Update all packages
         ansible.builtin.apt:
           update_cache: true
           upgrade: "{{ update_upgrade_command }}"
           cache_valid_time: "{{ update_cache_valid_time }}"
         environment:
           DEBIAN_FRONTEND: nointeractive
         notify: Reboot

       - name: Optionally autoremove packages
         ansible.builtin.apt:
           autoremove: "{{ update_autoremove }}"
         when: update_autoremove | bool
     when: ansible_pkg_mgr == "apt"

   - name: Update all software (dnf)
     ansible.builtin.dnf:
       name: "*"
       state: latest
       exclude: "{{ update_excluded_packages }}"
     notify: Reboot
     when: ansible_pkg_mgr in ["dnf", "dnf5"]

   - name: Update all software (pacman)
     community.general.pacman:
       update_cache: true
       upgrade: true
     notify: Reboot
     when: ansible_pkg_mgr == "pacman"

   - name: Configure yum
     block:
       - name: Upgrade all packages (RHEL/CentOS 6)
         ansible.builtin.dnf:
           name: "*"
           state: latest
           exclude: "{{ update_excluded_packages }}"
         notify: Reboot
         when: ansible_distribution_major_version == "6"

       - name: Upgrade all packages (other versions)
         block:
           - name: Upgrade all packages
             ansible.builtin.dnf:
               name: "*"
               state: latest
               exclude: "{{ update_excluded_packages }}"
             notify: Reboot

           - name: Install yum-utils
             ansible.builtin.package:
               name: yum-utils
               state: present
     when: ansible_pkg_mgr == "yum"

   - name: Update all software (zypper)
     community.general.zypper:
       name: "*"
       state: latest
     notify: Reboot
     when: ansible_pkg_mgr == "zypper"

