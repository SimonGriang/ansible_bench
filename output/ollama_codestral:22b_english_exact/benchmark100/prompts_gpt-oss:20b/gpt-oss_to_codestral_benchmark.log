---
   - name: Task 1 - Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost

   - name: Task 2 - Install requirements
     package:
       name: bash
       state: present

   - name: Task 3 - Install openjdk java (package)
     package:
       name: "{{ java_openjdk_package }}"
       state: present
     when: java_vendor == 'openjdk'
     environment:
       USE: "X -cups -alsa -fontconfig"

   - name: Task 4 - Install RPM
     block:
       - name: Copy RPM file
         copy:
           src: "{{ java_package }}"
           dest: "/tmp/{{ java_package }}"
           mode: '0640'
       - name: Install RPM file
         package:
           name: "/tmp/{{ java_package }}"
           state: present
     when: java_source == 'local' and java_format == 'rpm'

   - name: Task 5 - Install DEB
     block:
       - name: Copy DEB file
         copy:
           src: "{{ java_package }}"
           dest: "/tmp/{{ java_package }}"
           mode: '0640'
       - name: Install DEB file
         apt:
           deb: "/tmp/{{ java_package }}"
     when: java_source == 'local' and java_format == 'deb'

   - name: Task 6 - Install oracle java (rpm) (repository)
     package:
       name: "{{ java_oracle_package }}"
       state: present
     when: java_source == 'repository' and java_format == 'rpm'

   - name: Task 7 - Configure oracle targz
     block:
       - name: Ensure directory exists
         file:
           path: "{{ java_install_directory }}"
           state: directory
           mode: '0755'
       - name: Unarchive package
         unarchive:
           src: "{{ java_oracle_package }}"
           dest: "{{ java_install_directory }}"
           mode: '0755'
     when: java_format == 'targz' and java_vendor == 'oracle'

   - name: Task 8 - Install oracle java policy software (targz)
     unarchive:
       src: jce_policy-8.zip
       dest: "{{ java_install_directory }}"
       mode: '0755'
     when: java_jce | bool and java_version == 8 and java_vendor == 'oracle'

   - name: Task 9 - Set alternative (targz)
     alternatives:
       name: java
       link: /usr/bin/java
       path: "{{ java_install_directory }}/{{ java_oracle_directory }}/bin/java"
     when: java_format == 'targz' and ansible_distribution != 'Alpine' and java_vendor == 'oracle'

   - name: Task 10 - Find JAVA_HOME
     shell: readlink -f $(which java) | sed "s:/bin/java$::"
     register: java_home
     changed_when: false
     check_mode: no

   - name: Task 11 - Set JAVA_HOME in /etc/environment
     lineinfile:
       path: /etc/profile.d/java_home.sh
       line: 'export JAVA_HOME="{{ java_home.stdout }}"'
       create: yes
       mode: '0644'
       regexp: '^export JAVA_HOME='
       state: present
     

