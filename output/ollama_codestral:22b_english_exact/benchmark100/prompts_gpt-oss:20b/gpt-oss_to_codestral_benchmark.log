       if [ -f "{{ rke2_bin_path }}" ]; then
         installed_version=$(RKE2_BINARY={{ rke2_bin_path }} {{ rke2_bin_path }} --version | cut -d '+' -f1)
       else
         installed_version="not installed"
       fi
       if systemctl is-active --quiet {{ rke2_service_name }}; then
         running_binary=$(readlink -f /proc/$(systemctl show --property MainPID --value {{ rke2_service_name }})/exe)
         running_version=$(RKE2_BINARY=$running_binary $running_binary --version | cut -d '+' -f1)
       else
         running_version="{{ rke2_version }}"
       fi
       echo "{\"installed_version\": \"$installed_version\", \"running_version\": \"$running_version\"}"
     args:
       executable: /bin/bash
     register: versions_check

   - name: Set RKE2 versions
     ansible.builtin.set_fact:
       installed_version: "{{ (versions_check.stdout | from_json).installed_version }}"
       running_version: "{{ (versions_check.stdout | from_json).running_version }}"
     when: not ansible_check_mode

   - name: Prevent accidental RKE2 downgrade
     ansible.builtin.assert:
       that:
         - rke2_version_clean is version(running_version_clean, '>=')
       fail_msg: "Downgrading from {{ running_version_clean }} to {{ rke2_version_clean }} is not allowed."
       success_msg: "No downgrade detected."
     when:
       - not ansible_check_mode
       - rke2_version != "not installed"
       - not rke2_allow_downgrade

   - name: Run RKE2 install script
     block:
       - name: Run RKE2 install script (airgap mode)
         ansible.builtin.shell:
           cmd: "{{ rke2_install_script_dir }}/rke2.sh"
           executable: /bin/bash
         environment:
           INSTALL_RKE2_ARTIFACT_PATH: "{{ rke2_artifact_path }}"
           INSTALL_RKE2_AGENT_IMAGES_DIR: "{{ rke2_tarball_images_path }}"
           INSTALL_RKE2_METHOD: "{{ rke2_airgap_implementation }}"
         when: rke2_airgap_mode == true

       - name: Run RKE2 install script (non-airgap mode)
         ansible.builtin.shell:
           cmd: "{{ rke2_install_script_dir }}/rke2.sh"
           executable: /bin/bash
         environment:
           INSTALL_RKE2_VERSION: "{{ rke2_version }}"
           INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"
           INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"
           INSTALL_RKE2_METHOD: "{{ rke2_airgap_implementation }}"
         when: rke2_airgap_mode == false
     when:
       - not ansible_check_mode
       - installed_version != rke2_version

   - name: Copy Custom Manifests
     ansible.builtin.template:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/server/manifests/"
       owner: root
       group: root
       mode: '0644'
     loop: "{{ rke2_custom_manifests }}"
     when: rke2_custom_manifests | length > 0

   - name: Copy Static Pods
     ansible.builtin.copy:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/agent/pod-manifests/"
       owner: root
       group: root
       mode: '0644'
     loop: "{{ rke2_static_pods }}"
     when: rke2_static_pods is defined and rke2_static_pods | length > 0

   - name: Copy RKE2 environment file
     ansible.builtin.template:
       src: rke2_environment.j2
       dest: "/etc/default/rke2-{{ rke2_type }}"
       owner: root
       group: root
       mode: '0644'
     when: rke2_environment_options is defined and rke2_environment_options | length > 0

