     wait_for:
       port: "{{ bootstrap_ssh_port | default(22) }}"
       timeout: "{{ bootstrap_timeout }}"
     delegate_to: localhost
     become: "{{ bootstrap_become }}"
     when:
       - ansible_connection != 'container'
       - ansible_connection != 'docker'
       - bootstrap_wait_for_host | default(true)

   - name: prepare system
     block:
       - name: test connection to host
         wait_for_connection:
           timeout: "{{ bootstrap_timeout }}"
         register: bootstrap_test_connection
         changed_when: false
     rescue:
       - name: display timeout value on connection test failure
         debug:
           msg: "Connection test failed. Timeout: {{ bootstrap_timeout }}"
         changed_when: true
     always:
       - name: gather raw bootstrap facts
         import_tasks: gather_facts.yml

       - name: execute raw shell commands
         shell: |
           {% raw %}{{ bootstrap_install.raw }}{% endraw %}
         args:
           executable: /bin/sh
         register: bootstrap_raw_shell_commands
         changed_when: |
           bootstrap_raw_shell_commands.stdout is search('BOOTSTRAP_CHANGED_REGEX') or
           (ansible_os_family == 'RedHat' and bootstrap_raw_shell_commands.stdout is search('BOOTSTRAP_CHANGED_REGEX_REDHAT'))
