       path: "{{ vault_download_path }}"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: 0755
       state: directory

   - name: Download Vault binary
     ansible.builtin.unarchive:
       src: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
       dest: "{{ vault_download_path }}"
       remote_src: true
       creates: "{{ vault_download_path }}/vault"
       owner: root
       group: root
       mode: 0644

   - name: Check if vault_path exists
     ansible.builtin.stat:
       path: "{{ vault_path }}"
     register: vault_check_path

   - name: Create vault_path if it does not exist
     ansible.builtin.file:
       path: "{{ vault_path }}"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: 0755
     when:
       - not vault_check_path.stat.exists
       - vault_path | length > 0

   - name: Create directory in vault_path
     ansible.builtin.file:
       path: "{{ item.name }}"
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
       mode: "{{ item.mode }}"
     loop: "{{ vault_directories }}"

   - name: Create data directory
     ansible.builtin.file:
       path: "{{ item.name }}"
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
       mode: "{{ item.mode }}"
     loop: "{{ vault_data_directories }}"

   - name: Generate TLS key and certificate
     ansible.builtin.command: >
       openssl req -new -newkey rsa:4096 -days 365 -nodes -x509
       -subj '/CN={{ vault_fqdn }}'
       -keyout {{ vault_data_directory }}/tls/tls.key
       -out {{ vault_data_directory }}/tls/tls.crt
       creates="{{ vault_data_directory }}/tls/tls.key"
     notify:
       - Restart vault

   - name: Set ownership of tls material
     ansible.builtin.file:
       path: "{{ item.name }}"
       owner: "{{ item.owner }}"
       group: "{{ item.group }}"
       mode: "{{ item.mode }}"
     loop: "{{ vault_tls_files }}"

   - name: Copy Vault binary
     ansible.builtin.copy:
       src: "{{ vault_download_path }}/vault"
       dest: "{{ vault_path }}/usr/bin/vault"
       remote_src: true
       owner: root
       group: root
       mode: 0755
     notify:
       - Restart vault

   - name: Set cap_ipc_lock=ep on /usr/bin/vault
     community.general.capabilities:
       path: "{{ vault_path }}/usr/bin/vault"
       capability: cap_ipc_lock+ep
       state: present
       changed_when: false

   - name: Touch vault.env
     ansible.builtin.file:
       path: "{{ vault_path }}/etc/vault.d/vault.env"
       owner: "{{ vault_user }}"
       group: "{{ vault_group }}"
       mode: 0644
       state: touch
       access_time: preserve
       modify_time: preserve
     notify:
       - Restart vault

   - name: Create /usr/lib/systemd/system
     ansible.builtin.file:
       path: /usr/lib/systemd/system
       owner: root
       group: root
       mode: 0755
       state: directory

   - name: Copy Vault service file
     ansible.builtin.template:
       src: vault.service.j2
       dest: /usr/lib/systemd/system/vault.service
       owner: root
       group: root
       mode: 0644
     notify:
       - Daemon reload
     when:
       - ansible_service_mgr == "systemd"

   - name: Copy vault configuration
     ansible.builtin.copy:
       src: vault.hcl
       dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
       owner: root
       group: root
       mode: 0644
       force: false
     notify:
       - Restart vault

   - name: Flush handlers
     ansible.builtin.meta:
       flush_handlers: true

   # This task is added to ensure a new line at the end of the file as per yamllint requirement
   - name: Ensure new line at end of file
     debug:
       msg: "New line added at end of file"  5%|▌         | 5/100 [08:57<3:23:02, 128.23s/it]

