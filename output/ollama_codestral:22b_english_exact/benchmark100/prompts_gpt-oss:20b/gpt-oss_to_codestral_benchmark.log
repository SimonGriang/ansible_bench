---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: "{{ dns_datadir }}", mode: '1770', owner: "{{ dns_owner }}", group: "{{ dns_group }}" }
    - { path: "{{ dns_confdir }}", mode: '0755', owner: 'root', group: 'root' }
  loop_control:
    label: "{{ item.path }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true

- name: Generate rndc key
  shell: "rndc-confgen -a -c {{ dns_confdir }}/rndc.key"
  args:
    creates: "{{ dns_confdir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0640'

- name: Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.root
    dest: "{{ dns_datadir }}/named.root"
    validate_certs: "{{ dns_validate_certs }}"
    mode: '0640'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.db"
    validate: "named-checkzone {{ item.name }} %s"
    mode: '0640'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop: "{{ dns_zones }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.type is undefined or item.type == 'primary'
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    validate: "named-checkconf -zj %s"
    mode: '0640'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    backup: true
  notify: Restart dns

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: /etc/systemd/system/{{ dns_service }}.service.d
        state: directory
        mode: '0755'
    - name: Copy override.conf
      copy:
        src: override.conf
        dest: /etc/systemd/system/{{ dns_service }}.service.d/override.conf
        owner: root
        group: root
        mode: '0644'
    - name: Reload systemd daemon
      systemd:
        daemon_reload: true
      changed_when: false
  when: ansible_service_mgr == "systemd"

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


