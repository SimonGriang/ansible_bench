       - name: Install repository for RedHat
         when: ansible_os_family == 'RedHat' or ansible_os_family == 'Rocky'
         # Add tasks for RedHat repository setup here

       - name: Configure debian
         when: ansible_os_family == 'Debian'
         block:
           - name: Install required package gpg
             apt:
               name: gpg
               state: present

           - name: Install apt key for Debian
             apt_key:
               url: "https://keybase.io/hashicorp/pgp_keys.asc"
               state: present
               validate_certs: no

           - name: Install repository for Debian
             apt_repository:
               repo: "deb [arch={{ hashicorp_architecture_mapping[ansible_architecture] }}] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
               state: present

       - name: Install hashicorp product using package
         loop: "{{ hashicorp_products }}"
         loop_control:
           loop_var: product
         block:
           - name: Install latest hashicorp product using package
             when: product.version is not defined
             package:
               name: "{{ product.name }}"
               state: present

           - name: Install versioned hashicorp product using package
             when: product.version is defined
             package:
               name: "{{ product.name }}={{ product.version }}"
               state: present

   - name: Install manually
     when: hashicorp_install_method == 'manual'
     block:
       - name: Install hashicorp product manually
         loop: "{{ hashicorp_products }}"
         loop_control:
           loop_var: product
         unarchive:
           src: "{{ hashicorp_src }}/{{ product.name }}_{{ product.version }}_{{ ansible_system | lower }}_{{ hashicorp_architecture_mapping[ansible_architecture] }}.zip"
           dest: "{{ hashicorp_destination }}"
           remote_src: yes
           group: "{{ hashicorp_group }}"
           owner: "{{ hashicorp_user }}"
           mode: "{{ hashicorp_mode }}"

