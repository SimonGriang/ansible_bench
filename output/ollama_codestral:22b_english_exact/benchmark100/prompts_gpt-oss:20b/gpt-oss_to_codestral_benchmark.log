---
   - name: Lookup bootstrap facts
     ansible.builtin.raw:
       cmd: cat /etc/os-release
     register: bootstrap_facts
     changed_when: false
     check_mode: false

   - name: Set bootstrap facts (I)
     ansible.builtin.set_fact:
       bootstrap_distribution: "{{ item }}"
       bootstrap_distribution_major_version: >-
         {{ (bootstrap_facts.stdout_lines | join('\n') |
         regex_search('^.*VERSION_ID="(\\d{1,2})(\\.\\d{1,4})*?".*$', multiline=True) |
         first | default('NA'))[0] }}
     loop: "{{ bootstrap_os_family_map | flatten }}"
     when: >-
       bootstrap_facts.rc == 0 and
       bootstrap_distribution is not defined and
       (bootstrap_facts.stdout | regex_search(bootstrap_search[item] | default(item)))
     become: false

   - name: Set bootstrap facts (II)
     ansible.builtin.set_fact:
       bootstrap_os_family: "{{ item.key }}"
     loop: "{{ bootstrap_os_family_map | dict2items }}"
     when: bootstrap_distribution in item.value
     become: false
     loop_control:
       label: "{{ item.key }}"

