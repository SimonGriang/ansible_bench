       - inventory_hostname == (groups[rke2_servers_group_name] | first)
     delegate_to: "{{ groups[rke2_servers_group_name] | first }}"

   - name: Replace loopback IP by master server IP
     ansible.builtin.replace:
       path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
       regexp: '127\.0\.0\.1|\[::1\]'
       replace: "{{ rke2_api_ip | default(ansible_host | ansible.utils.ipwrap) }}"
       mode: '0600'
     delegate_to: localhost
     become: false
     when:
       - not ansible_check_mode
       - rke2_download_kubeconf | bool
       - inventory_hostname == (groups[rke2_servers_group_name] | first)

