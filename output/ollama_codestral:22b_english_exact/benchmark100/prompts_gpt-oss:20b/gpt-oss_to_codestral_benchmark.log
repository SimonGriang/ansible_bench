 - name: Import assert
      ansible.builtin.import_tasks:
        file: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Install cron
      package:
        name: "{{ cron_packages }}"
        state: present

    - name: Configure shell
      ansible.builtin.lineinfile:
        path: "{{ cron_configuration }}"
        line: "SHELL={{ cron_shell }}"
        create: true
        mode: '0600'
      notify: Restart cron

    - name: Configure path
      ansible.builtin.lineinfile:
        path: "{{ cron_configuration }}"
        line: "PATH={{ cron_path }}"
        create: true
        mode: '0600'
      notify: Restart cron

    - name: Configure mailto
      ansible.builtin.lineinfile:
        path: "{{ cron_configuration }}"
        line: "MAILTO={{ cron_mailto }}"
        create: true
        mode: '0600'
      notify: Restart cron

    - name: Start and enable cron
      service:
        name: "{{ cron_service }}"
        state: started
        enabled: yes
      when: cron_service is defined and cron_service | length > 0

    - name: Schedule requested cron jobs
      ansible.builtin.cron:
        name: "{{ item.name }}"
        minute: "{{ item.minute | default(omit) }}"
        hour: "{{ item.hour | default(omit) }}"
        day: "{{ item.day | default(omit) }}"
        month: "{{ item.month | default(omit) }}"
        weekday: "{{ item.weekday | default(omit) }}"
        special_time: "{{ item.special_time | default(omit) }}"
        job: "{{ item.command }}"
        state: "{{ item.state | default('present') }}"
        user: "{{ item.user | default(omit) }}"
      loop: "{{ cron_jobs | default([]) }}"
      loop_control:
        label: "{{ item.name }}"
      when: cron_jobs is defined

