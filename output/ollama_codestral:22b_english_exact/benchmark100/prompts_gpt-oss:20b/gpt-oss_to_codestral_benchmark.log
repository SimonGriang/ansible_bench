           checksum: "sha256:{{ lookup('file', '{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt') }}"
         loop: "{{ rke2_artifact | select('not match', 'sha256sum') | list }}"

       - name: Download RKE2 installation script
         ansible.builtin.get_url:
           url: "{{ rke2_install_bash_url }}"
           dest: "{{ rke2_install_script_dir }}/rke2.sh"
           mode: '0700'
     rescue:
       - name: Pause for 7 seconds
         ansible.builtin.pause:
           seconds: 7

       - name: Create local directory
         ansible.builtin.file:
           path: "{{ rke2_airgap_copy_sourcepath }}"
           state: directory
           mode: '0750'
           owner: "{{ lookup('env', 'USER') }}"

       - name: Download checksum file locally
         ansible.builtin.get_url:
           url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
           dest: "{{ rke2_airgap_copy_sourcepath }}/sha256sum-{{ rke2_architecture }}.txt"

       - name: Download artifacts locally
         ansible.builtin.get_url:
           url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"
           dest: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
         loop: "{{ rke2_artifact }}"

       - name: Download installation script locally
         ansible.builtin.get_url:
           url: "{{ rke2_install_bash_url }}"
           dest: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"

       - name: Copy local artifacts to remote host
         ansible.builtin.copy:
           src: "{{ rke2_airgap_copy_sourcepath }}/"
           dest: "{{ rke2_artifact_path }}/"

       - name: Copy local installation script to remote host
         ansible.builtin.copy:
           src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
           dest: "{{ rke2_install_script_dir }}/rke2.sh"
           mode: '0700'
     when:
       - rke2_airgap_mode == true
       - rke2_airgap_implementation == 'download'

   - name: Copy local RKE2 artifacts
     ansible.builtin.copy:
       src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
       dest: "{{ rke2_artifact_path }}/{{ item }}"
       mode: '0640'
       force: true
     loop: "{{ rke2_artifact }}"
     when:
       - rke2_airgap_mode == true
       - rke2_airgap_implementation == 'copy'

   - name: Airgap mode – additional images tarballs
     block:
       - name: Create directory for tarball images
         ansible.builtin.file:
           path: "{{ rke2_tarball_images_path }}"
           state: directory
           mode: '0700'

       - name: Copy additional tarball images
         ansible.builtin.copy:
           src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
           dest: "{{ rke2_tarball_images_path }}/{{ item }}"
           mode: '0644'
           force: true
         loop: "{{ rke2_airgap_copy_additional_tarballs }}"
     when:
       - rke2_airgap_mode == true
       - rke2_airgap_copy_additional_tarballs | length > 0
       - rke2_airgap_implementation != 'exists'

   - name: Airgap mode – ensure artifacts exist and have acceptable permissions
     block:
       - name: Stat artifacts
         ansible.builtin.stat:
           path: "{{ rke2_artifact_path }}/{{ item }}"
         loop: "{{ rke2_artifact }}"
         register: artifacts

       - name: Stat installation script
         ansible.builtin.stat:
           path: "{{ rke2_install_script_dir }}/rke2.sh"
         register: install_script

       - name: Set artifacts_writeable fact
         ansible.builtin.set_fact:
           artifacts_writeable: "{{ artifacts.results | selectattr('stat.writeable', 'equalto', true) | list | length > 0 }}"

       - name: Change artifact permissions if writable
         ansible.builtin.file:
           path: "{{ rke2_artifact_path }}/{{ item }}"
           mode: '0640'
         loop: "{{ rke2_artifact }}"
         when: artifacts_writeable

       - name: Ensure installation script is executable
         ansible.builtin.file:
           path: "{{ rke2_install_script_dir }}/rke2.sh"
           mode: "+x"
         when: not install_script.stat.executable

       - name: Fail if installation script is still not executable
         ansible.builtin.fail:
           msg: "The script at {{ rke2_install_script_dir }}/rke2.sh must be executable."
         when: not install_script.stat.executable
     when:
       - rke2_airgap_mode == true
       - rke2_airgap_implementation == 'exists'

   - name: Populate service facts
     ansible.builtin.service_facts:

   - name: Get stats of the FS object
     ansible.builtin.stat:
       path: /usr/local
     register: usr_local

   - name: Check if separate partition
     ansible.builtin.command:
       cmd: grep '/usr/local ' /proc/mounts
     changed_when: false
     register: partition_result
     failed_when: partition_result.rc >= 2

   - name: Set RKE2 bin path
     ansible.builtin.set_fact:
       rke2_bin_path: "/usr/local/bin/rke2"
     when: not usr_local.stat.writeable or partition_result.rc == 1

   - name: Set RKE2 bin path
     ansible.builtin.set_fact:
       rke2_bin_path: "/opt/rke2/bin/rke2"
     when: usr_local.stat.writeable and partition_result.rc != 1

   - name: Check RKE2 version
     ansible.builtin.shell: |
       set -o pipefail
       if [ -f "{{ rke2_bin_path }}" ]; then
         installed_version=$(RKE2_BINARY={{ rke2_bin_path }} {{ rke2_bin_path }} --version | cut -d '+' -f1)
       else
         installed_version="not installed"
       fi
       if systemctl is-active --quiet {{ rke2_service_name }}; then
         running_binary=$(readlink -f /proc/$(systemctl show --property MainPID --value {{ rke2_service_name }})/exe)
         running_version=$(RKE2_BINARY=$running_binary $running_binary --version | cut -d '+' -f1)
       else
         running_version="{{ rke2_version }}"
       fi
       echo "{\"installed_version\": \"$installed_version\", \"running_version\": \"$running_version\"}"
     args:
       executable: /bin/bash
     register: versions_check

   - name: Set RKE2 versions
     ansible.builtin.set_fact:
       installed_version: "{{ (versions_check.stdout | from_json).installed_version }}"
       running_version: "{{ (versions_check.stdout | from_json).running_version }}"
     when: not ansible_check_mode

   - name: Prevent accidental RKE2 downgrade
     ansible.builtin.assert:
       that:
         - rke2_version_clean is version(running_version_clean, '>=')
       fail_msg: "Downgrading from {{ running_version_clean }} to {{ rke2_version_clean }} is not allowed."
       success_msg: "No downgrade detected."
     when:
       - not ansible_check_mode
       - rke2_version != "not installed"
       - not rke2_allow_downgrade

   - name: Run RKE2 install script
     block:
       - name: Run RKE2 install script (airgap mode)
         ansible.builtin.shell:
           cmd: "{{ rke2_install_script_dir }}/rke2.sh"
           executable: /bin/bash
         environment:
           INSTALL_RKE2_ARTIFACT_PATH: "{{ rke2_artifact_path }}"
           INSTALL_RKE2_AGENT_IMAGES_DIR: "{{ rke2_tarball_images_path }}"
           INSTALL_RKE2_METHOD: "{{ rke2_airgap_implementation }}"
         when: rke2_airgap_mode == true

       - name: Run RKE2 install script (non-airgap mode)
         ansible.builtin.shell:
           cmd: "{{ rke2_install_script_dir }}/rke2.sh"
           executable: /bin/bash
         environment:
           INSTALL_RKE2_VERSION: "{{ rke2_version }}"
           INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"
           INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"
           INSTALL_RKE2_METHOD: "{{ rke2_airgap_implementation }}"
         when: rke2_airgap_mode == false
     when:
       - not ansible_check_mode
       - installed_version != rke2_version

   - name: Copy Custom Manifests
     ansible.builtin.template:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/server/manifests/"
       owner: root
       group: root
       mode: '0644'
     loop: "{{ rke2_custom_manifests }}"
     when: rke2_custom_manifests | length > 0

   - name: Copy Static Pods
     ansible.builtin.copy:
       src: "{{ item }}"
       dest: "{{ rke2_data_path }}/agent/pod-manifests/"
       owner: root
       group: root
       mode: '0644'
     loop: "{{ rke2_static_pods }}"
     when: rke2_static_pods is defined and rke2_static_pods | length > 0

   - name: Copy RKE2 environment file
     ansible.builtin.template:
       src: rke2_environment.j2
       dest: "/etc/default/rke2-{{ rke2_type }}"
       owner: root
       group: root
       mode: '0644'
     when: rke2_environment_options is defined and rke2_environment_options | length > 0

