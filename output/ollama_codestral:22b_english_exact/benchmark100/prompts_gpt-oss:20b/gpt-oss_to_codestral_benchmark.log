---
   - name: Java | Migrate adoptopenjdk to temurin
     set_fact:
       java_jdk_vendor: "temurin"
     when: java_jdk_vendor == "adoptopenjdk"

   - name: Java | Gather OS specific variables
     include_vars:
       file: "{{ java_jdk_vendor }}/{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
       name: os_vars
     with_first_found:
       skip: "true"

   - name: Java | Gather architecture specific variables
     include_vars:
       file: "architecture.yml"
       name: arch_vars
     with_first_found:
       skip: "true"

   - name: Java | Setting OS specific variables (I)
     set_fact:
       java_open_jdk_version_major: "{{ java_open_jdk_version_major | default(__java_open_jdk_version_major) }}"
       java_required_repositories_openjdk: "{{ java_required_repositories_openjdk | default(__java_required_repositories_openjdk) }}"
       java_required_key_repositories_openjdk: "{{ java_required_key_repositories_openjdk | default(__java_required_key_repositories_openjdk) }}"
       java_required_libs_openjdk: "{{ java_required_libs_openjdk | default(__java_required_libs_openjdk) }}"
       java_deprecated_repositories_adoptopenjdk: "{{ java_deprecated_repositories_adoptopenjdk | default(__java_deprecated_repositories_adoptopenjdk) }}"

   - name: Java | Setting OS and architecture specific variables (II)
     set_fact:
       java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default(__java_open_jdk_home_dir) }}"
       java_open_jdk_package: "{{ java_open_jdk_package | default(__java_open_jdk_package) }}"

   - name: Java | Setting specific variables
     set_fact:
       java_home: "{{ java_open_jdk_home }}"

   - name: Java | Debian pre-requisites
     block:
       - name: Java | Remove deprecated repositories
         apt_repository:
           repo: "{{ item }}"
           state: absent
         loop: "{{ java_deprecated_repositories_adoptopenjdk }}"
         when: java_deprecated_repositories_adoptopenjdk | length > 0

       - name: Java | Install extra apt tools
         package:
           name: "{{ java_open_jdk_apt_extra_packages }}"
           state: present
         register: apt_tools_installed
         until: apt_tools_installed is succeeded
         retries: 5
         delay: 10
         when: java_open_jdk_apt_extra_packages | length > 0

       - name: Java | Add required key repositories, Debian
         apt_key:
           url: "{{ item }}"
           state: present
         loop: "{{ java_required_key_repositories_openjdk }}"

       - name: Java | Add required repositories, Debian
         apt_repository:
           repo: "{{ item }}"
           update_cache: "yes"
         loop: "{{ java_required_repositories_openjdk }}"
     when: ansible_os_family == 'Debian'

   - name: Java | RedHat pre-requisites
     block:
       - name: Java | Add required key repositories, RedHat
         rpm_key:
           key: "{{ item }}"
           state: present
         loop: "{{ java_required_key_repositories_openjdk }}"

       - name: Java | Add required repositories, RedHat
         yum_repository:
           name: "{{ item.name }}"
           description: "{{ item.description }}"
           file: "{{ item.file }}"
           baseurl: "{{ item.baseurl }}"
           gpgcheck: "{{ item.gpgcheck }}"
           state: present
         loop: "{{ java_required_repositories_openjdk }}"
     when: ansible_os_family == 'RedHat'

   - name: Java | Install required libs
     package:
       name: "{{ java_required_libs_openjdk }}"
       state: present
     register: java_required_libs_installed
     until: java_required_libs_installed is succeeded
     retries: 5
     delay: 10

   - name: Java | Install Java, Debian
     apt:
       name: "{{ java_open_jdk_package }}={{ java_open_jdk_version }}"
       state: present
       update_cache: "yes"
       cache_valid_time: 3600
     register: java_package_installed
     until: java_package_installed is succeeded
     retries: 5
     delay: 10
     when: ansible_os_family == 'Debian' and java_open_jdk_version is defined

   - name: Java | Install Java, RedHat
     yum:
       name: "{{ java_open_jdk_package }}-{{ java_open_jdk_version }}"
       state: present
     register: java_package_installed
     until: java_package_installed is succeeded
     retries: 5
     delay: 10
     when: ansible_os_family == 'RedHat' and java_open_jdk_version is defined

   - name: Java | Export environment variables
     template:
       src: "jdk.sh.j2"
       dest: "/etc/profile.d/jdk.sh"
       mode: '0755'
       owner: root

   - name: Java | Source environment variables
     shell: source /etc/profile
     args:
       executable: /bin/bash
     changed_when: false
     tags:
       - skip_ansible_lint

   - name: Java | Correct java version selected
     alternatives:
       name: java
       path: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/{{ ['jre', 'bin'][java_open_jdk_version_major | int >= 11] }}/java"
     when: ansible_os_family == 'Debian'
