---
   - name: Create RKE2 config dir
     file:
       path: /etc/rancher/rke2
       state: directory
       owner: root
       group: root
       mode: 0755

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_type == 'server'

   - name: Set agent taints
     set_fact:
       combined_node_taints: "{{ rke2_agent_node_taints }}"
     when: rke2_type == 'agent'

   - name: Copy RKE2 config
     template:
       src: "{{ rke2_config }}"
       dest: /etc/rancher/rke2/config.yaml
       owner: root
       group: root
       mode: 0600
     notify: "Config file changed"

   - name: Copy kubelet config
     template:
       src: templates/kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       owner: root
       group: root
       mode: 0600
     when: rke2_kubelet_config | length > 0
     notify: "Config file changed"

   - name: Copy Containerd Registry Configuration file
     template:
       src: "{{ rke2_custom_registry_path }}"
       dest: /etc/rancher/rke2/registries.yaml
       owner: root
       group: root
       mode: 0600
     when: >
       rke2_custom_registry_mirrors | length > 0 or
       rke2_custom_registry_configs | length > 0
     notify: "Config file changed"

   - name: Start RKE2 service on the rest of the nodes
     systemd:
       name: "{{ rke2_service_name }}"
       state: started
       enabled: true
     register: rke2_service_started
     retries: 3
     delay: 10
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     notify: "Service (re)started"

   - name: Mask other RKE2 service on the rest of the nodes
     systemd:
       name: "rke2-{{ item }}.service"
       state: stopped
       enabled: false
       masked: true
     loop: "{{ ['agent', 'server'] | reject('match', rke2_type) | list }}"

   - name: Wait for remaining nodes to be ready - no CNI
     shell: >
       kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes |
       grep -qE '(Ready|SchedulingDisabled)'
     register: result
     until: result.stdout.find('SchedulingDisabled') != -1 or
            result.stdout.find('Ready') != -1
     retries: 30
     delay: 10
     when:
       - rke2_cni == 'none'
       - (inventory_hostname == active_server or
          inventory_hostname == groups[rke2_servers_group_name][0])
       - inventory_hostname in groups[rke2_cluster_group_name]

   - name: Wait for remaining nodes to be ready - with CNI
     shell: >
       kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes |
       grep " Ready" | wc -l
     register: result
     until: result.stdout | int == groups[rke2_cluster_group_name] | length
     retries: 30
     delay: 10
     when:
       - rke2_cni != 'none'
       - not ansible_check_mode
       - (inventory_hostname == active_server or
          inventory_hostname == groups[rke2_servers_group_name][0])
   

