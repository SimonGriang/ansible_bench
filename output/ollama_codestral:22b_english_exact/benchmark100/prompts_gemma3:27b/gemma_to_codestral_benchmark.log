---
- name: Vault Hardening Role
  hosts: all
  become: yes
  tasks:
    - name: Ensure vault is not in shell history
      shell: "rm ~/.bash_history; touch ~/.bash_history; chmod 0644 ~/.bash_history; chown root:root ~/.bash_history"
      args:
        warn: false
      ignore_errors: true
      changed_when: false

    - name: Configure SELinux/AppArmor
      block:
        - name: Configure SELinux
          package:
            name: selinux-policy
            state: present
          when: ansible_selinux.status == "enabled"

        - name: Set SELinux policy and state
          selinux:
            policy: targeted
            state: enforcing
          when: ansible_selinux.status == "enabled"

        - name: Configure AppArmor
          service:
            name: apparmor
            state: started
          when: ansible_apparmor.status == "enabled"
      when: vault_hardening_configure_selinux_apparmor


