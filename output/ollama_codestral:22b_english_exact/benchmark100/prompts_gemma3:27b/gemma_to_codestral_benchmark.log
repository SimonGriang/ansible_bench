     template:
       src: "{{ mysql_name }}-server.cnf.j2"
       dest: "/etc/mysql/mysql.conf.d/{{ mysql_name }}-server.cnf"
       mode: 0644
     vars:
       options: "{{ mysql_configuration_options }}"
     notify:
       - Restart mysql server

   - name: Configure mysql client
     template:
       src: "{{ mysql_name }}-client.cnf.j2"
       dest: "/etc/mysql/mysql.conf.d/{{ mysql_name }}-client.cnf"
       mode: 0644
     vars:
       socket: "{{ mysql_socket }}"

   - name: Initialize mysql
     command: "{{ mysql_initialize_command }}"
     when: ansible_os_family in ['Alpine', 'Archlinux']

   - name: Start and enable mysql
     service:
       name: "{{ mysql_service }}"
       state: started
       enabled: true

   - name: Flush handlers
     meta: flush_handlers

   - name: Place my.cnf
     copy:
       src: my.cnf.j2
       dest: /root/.my.cnf
       mode: 0640

   - name: Create databases
     mysql_db:
       name: "{{ item.name }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
       login_unix_socket: "{{ mysql_socket }}"
     with_items: "{{ mysql_databases }}"

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       password: "{{ item.password }}"
       login_user: root
       login_password: "{{ mysql_root_password }}"
       login_unix_socket: "{{ mysql_socket }}"
       priv: "{{ item.priv }}"
     with_items: "{{ mysql_users }}"

   - name: Flush handlers again
     meta: flush_handlers

