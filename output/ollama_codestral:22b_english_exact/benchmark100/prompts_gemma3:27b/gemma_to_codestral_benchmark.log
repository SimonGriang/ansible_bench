 - name: Import assert.yml
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install cron
     package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure shell
     lineinfile:
       path: "{{ cron_configuration }}"
       line: "SHELL={{ cron_shell }}"
       create: yes
       mode: 0600
     notify: Restart cron

   - name: Configure path
     lineinfile:
       path: "{{ cron_configuration }}"
       line: "PATH={{ cron_path }}"
       create: yes
       mode: 0600
     notify: Restart cron

   - name: Configure mailto
     lineinfile:
       path: "{{ cron_configuration }}"
       line: "MAILTO={{ cron_mailto }}"
       create: yes
       mode: 0600
     notify: Restart cron

   - name: Start and enable cron
     service:
       name: "{{ cron_service }}"
       state: started
       enabled: yes
     when: cron_service is defined and cron_service | length > 0

   - name: Schedule requested cron jobs
     cron:
       minute: "{{ item.minute | default('*') }}"
       hour: "{{ item.hour | default('*') }}"
       day: "{{ item.day | default('*') }}"
       month: "{{ item.month | default('*') }}"
       weekday: "{{ item.weekday | default('*') }}"
       special_time: "{{ item.special_time | default(omit) }}"
       job: "{{ item.job }}"
       state: "{{ item.state | default('present') }}"
       user: "{{ item.user | default(omit) }}"
     loop: "{{ cron_jobs | default([]) }}"
     loop_control:
       label: "{{ item.job }}"
     when: cron_jobs is defined

