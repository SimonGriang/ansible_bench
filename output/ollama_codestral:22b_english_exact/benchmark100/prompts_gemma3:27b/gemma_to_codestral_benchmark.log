 - name: Restart the RKE2 service
     service:
       name: "{{ rke2_service_name }}"
       state: restarted
     notify: Service (re)started

   - name: Wait for all nodes to be ready
     delegate_to: "{{ active_server | default((groups[rke2_servers_group_name] | list)[0]) }}"
     run_once: true
     shell: >
       {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes
       -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}'
       | grep -c True
     register: rke2_ready_nodes
     until: rke2_ready_nodes.stdout | int == groups[rke2_cluster_group_name] | length
     retries: 100
     delay: 15

   - name: Wait for all pods to be ready
     delegate_to: "{{ active_server | default((groups[rke2_servers_group_name] | list)[0]) }}"
     run_once: true
     shell: >
       {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods
       --all-namespaces -o jsonpath='{.items[?(@.status.phase!="Running" && @.status.phase!="Succeeded")]}'
       | jq -c '. | length'
     register: rke2_unready_pods
     until: rke2_unready_pods.stdout | int == 0
     retries: 100
     delay: 15
     when: rke2_wait_for_all_pods_to_be_ready | bool and not ansible_check_mode

