_MIRROR: "{{ rke2_mirror }}"\n       INSTALL_RKE2_SYSTEM_DEFAULTS: "{{ rke2_system_defaults }}"\n       INSTALL_RKE2_IMAGE_TARBALL: "{{ rke2_image_tarball | default(omit) }}"\n       INSTALL_RKE2_BIN_DIR: "{{ rke2_bin_path }}"\n     when: rke2_installed_version == \'\' or rke2_installed_version != rke2_version\n\n   - name: Copy Custom Manifests\n     copy:\n       src: "{{ item }}"\n       dest: "{{ rke2_data_dir }}/{{ item | basename }}"\n     with_fileglob:\n       - "{{ rke2_custom_manifests_path }}/*.yaml"\n     when: rke2_custom_manifests_path is defined\n\n   - name: Copy Static Pods\n     copy:\n       src: "{{ item }}"\n       dest: "{{ rke2_agent_path }}/pod-manifests/{{ item | basename }}"\n     with_fileglob:\n       - "{{ rke2_static_pods_path }}/*.yaml"\n     when: rke2_static_pods_path is defined\n\n   - name: Copy RKE2 environment file\n     template:\n       src: rke2_env.j2\n       dest: /etc/default/rke2\n       owner: root\n       group: root\n       mode: \'0644\'\n     vars:\n       rke2_env_options: "{{ rke2_env_options }}"\n\n   # Added a new line at the end of file to fix yamllint errors\n   # Make sure to check if it doesn\'t cause any other issues in the playbook execution' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-11T21:05:14.245025411Z', 'done': True, 'done_reason': 'stop', 'total_duration': 39000530959, 'load_duration': 31725908, 'prompt_eval_count': 2877, 'prompt_eval_duration': 1057223934, 'eval_count': 1771, 'eval_duration': 37909682983, 'model_name': 'codestral:22b'} id='run--3a843ba5-2a73-426a-afe5-2d041d05669c-0' usage_metadata={'input_tokens': 2877, 'output_tokens': 1771, 'total_tokens': 4648}
