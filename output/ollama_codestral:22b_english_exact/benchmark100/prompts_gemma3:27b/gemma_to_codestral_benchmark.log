 - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install mysql
    package:
      name: "{{ mysql_packages }}"
    notify:
      - Set root password
      - Systemctl daemon-reexec

  - name: Configure mysql server
    lineinfile:
      dest: "/etc/mysql/mysql_name-server.cnf"
      regexp: "^{{ item.option }}"
      line: "{{ item.option }} = {{ item.value }}"
    with_items: "{{ mysql_configuration_options }}"

  - name: Configure mysql client
    lineinfile:
      dest: "/etc/mysql/mysql_name-client.cnf"
      regexp: "^socket"
      line: "socket = {{ mysql_socket }}"

  - name: Initialize mysql
    command: "{{ mysql_initialize_command }}"
    when: ansible_os_family == 'Alpine' or ansible_os_family == 'Archlinux'

  - name: Start and enable mysql
    service:
      name: "{{ mysql_service }}"
      state: started
      enabled: yes

  - name: Flush handlers
    meta: flush_handlers

  - name: Place my.cnf
    template:
      src: my.cnf.j2
      dest: /root/.my.cnf
      mode: 0640

  - name: Create databases
    mysql_db:
      name: "{{ item.name }}"
      state: "{{ item.state | default('present') }}"
      target: "{{ item.target | default(omit) }}"
      encoding: "{{ item.encoding | default('utf8mb4') }}"
      collation: "{{ item.collation | default('utf8mb4_general_ci') }}"
      login_user: root
      login_password: "{{ mysql_root_password }}"
      login_unix_socket: "{{ mysql_socket }}"
    with_items: "{{ mysql_databases }}"

  - name: List databases
    mysql_info:
      login_user: root
      login_password: "{{ mysql_root_password }}"
      login_unix_socket: "{{ mysql_socket }}"
      filter: databases
    register: databases
  - name: debug
    debug:
      var: databases

  - name: Import database
    mysql_db:
      name: "{{ item.name }}"
      state: import
      target: "{{ item.target }}"
      login_user: root
      login_password: "{{ mysql_root_password }}"
      login_unix_socket: "{{ mysql_socket }}"
    with_items: "{{ mysql_databases }}"
    when: item.target is defined and item.name not in databases.databases

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.priv }}"
      host: "{{ item.host | default('localhost') }}"
      login_user: root
      login_password: "{{ mysql_root_password }}"
      login_unix_socket: "{{ mysql_socket }}"
    with_items: "{{ mysql_users }}"

  - name: Flush handlers again
    meta: flush_handlers

