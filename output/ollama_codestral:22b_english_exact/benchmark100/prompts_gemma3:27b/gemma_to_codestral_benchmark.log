---
- name: lookup bootstrap facts (raw)
  shell: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  become: false
  become_user: "{{ bootstrap_user }}"

- name: set bootstrap facts (I) # noqa jinja
  set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: >-
      {{ (bootstrap_facts.stdout | regex_search('PRETTY_NAME=".*? {{ item.key }}([0-9]+).*"'))[0]
      | regex_replace('.*?([0-9]+)') }}
  loop: "{{ lookup('dict', bootstrap__os_family_map) }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - "'PRETTY_NAME' in bootstrap_facts.stdout and item.value in bootstrap_facts.stdout"
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ lookup('dict', bootstrap__os_family_map) }}"
  loop_control:
    label: "{{ item.key }}"
  when:
    - bootstrap_distribution in item.value
