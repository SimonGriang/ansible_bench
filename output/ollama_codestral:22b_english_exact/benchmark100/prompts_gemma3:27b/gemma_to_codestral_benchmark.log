---
   - name: Restart the RKE2 service
     service:
       name: "{{ rke2_service_name }}"
       state: restarted
     notify: Service (re)started

   - name: Wait for all nodes to be ready
     delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
     run_once: true
     shell: >
       {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes
       -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}'
       | grep True | wc -l
     register: ready_nodes
     until: ready_nodes.stdout | int == groups[rke2_cluster_group_name] | length
     retries: 100
     delay: 15

   - name: Wait for all pods to be ready
     delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
     run_once: true
     when:
       - rke2_wait_for_all_pods_to_be_ready
       - not ansible_check_mode
     shell: >
       {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods
       --all-namespaces -o jsonpath='{range .items[?(@.status.phase!="Running" && @.status.phase!="Succeeded")]}{.metadata.name}{"\n"}{end}'
       | wc -l
     register: not_ready_pods
     until: not_ready_pods.stdout | int == 0
     retries: 100
     delay: 15

