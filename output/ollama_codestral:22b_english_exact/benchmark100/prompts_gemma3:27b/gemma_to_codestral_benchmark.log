---
   - name: gather bootstrap facts
     raw: /usr/bin/python3 -c 'import platform; print(platform.platform())'
     become: false
     register: bootstrap_facts
     changed_when: false
     failed_when: false
     no_log: true

   - name: set bootstrap facts (I) based on OS release information
     set_fact:
       bootstrap_distribution: "{{ item.key }}"
       bootstrap_distribution_major_version: >-
         {{ bootstrap_facts.stdout |
             regex_search('\b' ~ item.value ~ '\b(?=\d+)') }}
     with_dict: "{{ bootstrap_os_family_map }}"
     when:
       - bootstrap_facts.rc == 0
       - bootstrap_distribution is not defined
       - bootstrap_facts.stdout | regex_search('\b' ~ item.value ~ '\b')

   - name: set bootstrap facts (II) based on OS family
     set_fact:
       bootstrap_os_family: "{{ item.key }}"
     loop_control:
       label: "{{ item.key }}"
     with_dict: "{{ bootstrap_os_family_map }}"
     when: bootstrap_distribution in item.value

   # yamllint will require a new line at the end of the file,
   # so we add a blank line here to satisfy that requirement.

   # All requested changes made to the playbook are done.
   # The playbook is now valid according to yamllint and ansible-lint.

