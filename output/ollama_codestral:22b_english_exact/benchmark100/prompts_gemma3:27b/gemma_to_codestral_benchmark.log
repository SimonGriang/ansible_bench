 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install mysql
     package:
       name: "{{ mysql_packages }}"
     notify:
       - Set root password
       - Systemctl daemon-reexec

   - name: Configure mysql server
     template:
       src: "{{ mysql_name }}-server.cnf.j2"
       dest: "/etc/mysql/{{ mysql_name }}-server.cnf"
       owner: root
       group: root
       mode: 0644
     vars:
       options: "{{ mysql_configuration_options }}"
     notify:
       - Restart mysql server

   - name: Configure mysql client
     template:
       src: "{{ mysql_name }}-client.cnf.j2"
       dest: "/etc/mysql/{{ mysql_name }}-client.cnf"
       owner: root
       group: root
       mode: 0644
     vars:
       socket: "{{ mysql_socket }}"

   - name: Initialize mysql
     command: "{{ mysql_initialize_command }}"
     when: ansible_os_family == 'Alpine' or ansible_os_family == 'Archlinux'

   - name: Start and enable mysql
     systemd:
       name: "{{ mysql_service }}"
       state: started
       enabled: yes

   - name: Flush handlers
     meta: flush_handlers

   - name: Place my.cnf
     copy:
       src: my.cnf.j2
       dest: /root/.my.cnf
       mode: 0640

   - name: Create databases
     mysql_db:
       name: "{{ item }}"
       login_password: "{{ mysql_root_password }}"
       login_unix_socket: "{{ mysql_socket }}"
     loop: "{{ mysql_databases }}"

   - name: Create users
     mysql_user:
       name: "{{ item.name }}"
       host: "{{ item.host }}"
       password: "{{ item.password }}"
       priv: "{{ item.priv }}"
       login_password: "{{ mysql_root_password }}"
       login_unix_socket: "{{ mysql_socket }}"
     loop: "{{ mysql_users }}"

   - name: Flush handlers again
     meta: flush_handlers

