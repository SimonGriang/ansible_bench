 - name: Check if all variables have been set correctly
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: yes

   - name: Wait for host to be reachable
     wait_for:
       port: 22
       host: "{{ ansible_ssh_host | default(ansible_host, true) | default(inventory_hostname) }}"
       timeout: "{{ bootstrap_timeout }}"
       search_regex: OpenSSH
     become: "{{ bootstrap__become_privileges | bool }}"
     delegate_to: localhost
     when:
       - bootstrap_wait_for_host | bool
       - ansible_connection not in ['container', 'docker']

   - name: Prepare the system
     block:
       - name: Test connection
         wait_for_connection:
           timeout: "{{ bootstrap_timeout }}"
         register: bootstrap_connect

       - name: Debug timeout
         debug:
           var: bootstrap_timeout
         when: bootstrap_connect is failed
     always:
       - name: Gather bootstrap facts
