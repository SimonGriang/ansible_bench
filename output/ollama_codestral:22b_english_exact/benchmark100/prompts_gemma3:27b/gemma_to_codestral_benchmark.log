      name: "{{ java_openjdk_package }}"
      state: present
    environment:
      USE: "{{ java_openjdk_use | default('') }}"
    when: java_vendor == 'openjdk'

  - name: Install RPM
    block:
      - name: Copy RPM file to /tmp/
        copy:
          src: "{{ java_rpm_file }}"
          dest: /tmp/
      - name: Install RPM package
        package:
          name: "/tmp/{{ java_rpm_file }}"
          state: present
    when: java_source == 'local' and java_format == 'rpm'

  - name: Install DEB
    block:
      - name: Copy DEB file to /tmp/
        copy:
          src: "{{ java_deb_file }}"
          dest: /tmp/
      - name: Install DEB package
        apt:
          deb: "/tmp/{{ java_deb_file }}"
          state: present
    when: java_source == 'local' and java_format == 'deb'

  - name: Install oracle java (rpm) (repository)
    package:
      name: "{{ java_oracle_package }}"
      state: present
    when: java_source == 'repository' and java_format == 'rpm'

  - name: Configure oracle targz
    block:
      - name: Ensure installation directory exists
        file:
          path: "{{ java_install_dir }}"
          state: directory
      - name: Extract targz archive
        unarchive:
          src: "{{ java_targz_file }}"
          dest: "{{ java_install_dir }}"
          extra_opts:
            - "--strip-components=1"
    when: java_format == 'targz' and java_vendor == 'oracle'

  - name: Install oracle java policy software (targz)
    unarchive:
      src: "{{ java_jce_zip_file }}"
      dest: "{{ java_install_dir }}/jre/lib/security"
    when: java_jce | bool and java_version == 8 and java_vendor == 'oracle'

  - name: Set alternative (targz)
    command: "alternatives --install /usr/bin/java java {{ java_install_dir }}/bin/java 2000"
    when: java_format == 'targz' and ansible_os_family != 'Alpine' and java_vendor == 'oracle'

  - name: Find JAVA_HOME
    command: "readlink -f /usr/bin/java | sed 's:/bin/java::'"
    register: java_home
    changed_when: false

  - name: Set JAVA_HOME in /etc/environment
    lineinfile:
      path: /etc/profile.d/java_home.sh
      line: "export JAVA_HOME={{ java_home.stdout }}"
      create: yes


