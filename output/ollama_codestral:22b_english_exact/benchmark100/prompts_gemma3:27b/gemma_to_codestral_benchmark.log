       url: "{{ dns_root_hints_url }}"
       dest: "{{ dns_datadir }}/hints/root-servers.hints"
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: '0644'
     when: dns_caching_dns | bool
     notify: Rndc reload

   - name: Create zone file
     template:
       src: zone.j2
       dest: "{{ dns_datadir }}/{{ item.name }}"
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: '0644'
     loop: "{{ dns_zones }}"
     notify: Rndc reload

   - name: Add zones to configuration
     template:
       src: named.conf.j2
       dest: "{{ dns_confdir }}/named.conf"
       owner: root
       group: root
       mode: '0644'
       validate: named-checkconf -t %s
       backup: yes
     notify: Restart dns

   - name: Place systemd override
     when: ansible_service_mgr == 'systemd'
     block:
       - name: Create systemd override directory
         file:
           path: "/etc/systemd/system/{{ dns_service }}.service.d"
           state: directory

       - name: Copy systemd override file
         template:
           src: override.conf.j2
           dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"

       - name: Reload systemd daemon
         systemd:
           daemon_reload: true

   - name: Start and enable dns
     service:
       name: "{{ dns_service }}"
       state: started
       enabled: true

