           vault_hardening_configure_selinux_apparmor | bool and
           ansible_selinux.status == "enabled"

       - name: Set SELinux policy to targeted and state to enforcing
         ansible.posix.selinux:
           policy: targeted
           state: enforcing
         when: >-
           vault_hardening_configure_selinux_apparmor | bool and
           ansible_selinux.status == "enabled"

       - name: Configure AppArmor
         ansible.builtin.service:
           name: apparmor
           state: started
           enabled: true
         when: >-
           vault_hardening_configure_selinux_apparmor | bool and
           ansible_apparmor.status == "enabled"


