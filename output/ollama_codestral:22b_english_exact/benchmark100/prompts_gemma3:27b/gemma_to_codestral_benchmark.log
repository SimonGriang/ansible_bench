---
   - name: Set java_jdk_vendor to temurin if it's currently adoptopenjdk
     set_fact:
       java_jdk_vendor: "temurin"
     when: java_jdk_vendor == "adoptopenjdk"

   - name: Include variables based on java_jdk_vendor, ansible_distribution, and ansible_distribution_major_version
     include_vars: "{{ lookup('first_found', params) }}"
     vars:
       params:
         files:
           - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
           - "{{ java_jdk_vendor }}-{{ ansible_distribution }}.yml"
           - "{{ java_jdk_vendor }}.yml"
         paths:
           - "vars"

   - name: Include architecture-specific variables
     include_vars: "architecture.yml"

   - name: Set facts for OpenJDK version, repositories, and libraries
     set_fact:
       java_open_jdk_version: "{{ java_open_jdk_version | default('11') }}"
       java_required_repositories_openjdk: "{{ java_required_repositories_openjdk | default([]) }}"
       java_required_libs_openjdk: "{{ java_required_libs_openjdk | default([]) }}"

   - name: Set facts for java_open_jdk_home_dir and java_open_jdk_package
     set_fact:
       java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/java-' + java_open_jdk_version + '-openjdk-amd64') }}"
       java_open_jdk_package: "{{ java_open_jdk_package | default('java-' + java_open_jdk_version + '-openjdk-devel') }}"

   - name: Set java_home fact
     set_fact:
       java_home: "{{ java_open_jdk_home }}"

   - name: Remove deprecated AdoptOpenJDK repositories (Debian)
     apt_repository:
       repo: "{{ item }}"
       state: absent
     loop: "{{ java_deprecated_repositories_adoptopenjdk | default([]) }}"
     when: ansible_os_family == "Debian"

   - name: Install extra apt tools (Debian)
     apt:
       name: "{{ java_open_jdk_apt_extra_packages }}"
       state: present
     when: ansible_os_family == "Debian" and java_open_jdk_apt_extra_packages is defined

   - name: Add required apt key repositories (Debian)
     apt_key:
       url: "{{ item }}"
       state: present
     loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
     when: ansible_os_family == "Debian"

   - name: Add required apt repositories (Debian)
     apt_repository:
       repo: "{{ item }}"
       state: present
     loop: "{{ java_required_repositories_openjdk | default([]) }}"
     when: ansible_os_family == "Debian"

   - name: Add required RPM key repositories (RedHat)
     rpm_key:
       key: "{{ item }}"
       state: present
     loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
     when: ansible_os_family == "RedHat"

   - name: Add required YUM repositories (RedHat)
     yum_repository:
       name: java-openjdk
       description: Java OpenJDK
       baseurl: "{{ item }}"
       gpgcheck: yes
       enabled: yes
     loop: "{{ java_required_repositories_openjdk | default([]) }}"
     when: ansible_os_family == "RedHat"

   - name: Install required libraries
     package:
       name: "{{ java_required_libs_openjdk }}"
       state: present

   - name: Install Java (Debian)
     apt:
       name: "{{ java_open_jdk_package }}"
       state: present
     when: ansible_os_family == "Debian"

   - name: Install Java (RedHat)
     yum:
       name: "{{ java_open_jdk_package }}"
       state: present
     when: ansible_os_family == "RedHat"

   - name: Create /etc/profile.d/jdk.sh template
     template:
       src: jdk.sh.j2
       dest: /etc/profile.d/jdk.sh
       mode: '0644'

   - name: Source /etc/profile to apply Java environment variables
     shell: source /etc/profile
     args:
       executable: /bin/bash

   - name: Set 'java' alternative to correct path (Debian, Java < 11)
     alternatives:
       name: java
       path: "{{ java_open_jdk_home_dir }}/bin/java"
     when: ansible_os_family == "Debian" and java_open_jdk_version is version_compare('11', '<')

   - name: Set 'java' alternative to correct path (Debian, Java >= 11)
     alternatives:
       name: java
       path: "{{ java_open_jdk_home_dir }}/bin/java"
       link: /usr/lib/jvm/java-openjdk/bin/java
     when: ansible_os_family == "Debian" and java_open_jdk_version is version_compare('11', '>=')

