---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'docker'
    - ansible_connection != 'container'
    - bootstrap_wait_for_host | default(true)

- name: Prepare system
  block:
    - name: Test connection
      ping:
    - name: Test sudo access
      shell: id
      become: yes
  rescue:
    - name: Gather facts
      setup:
    - name: Install bootstrap packages (raw)
      raw: "{{ ansible_pkg_mgr }} install -y python3"
    - name: Ensure libdnf5 is present on RedHat-based systems
      package:
        name: libdnf5
        state: present
      become: yes
      when: ansible_os_family == 'RedHat'

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: yes
  become: "{{ bootstrap_become }}"
  

