---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: yes

   - name: Configure apk
     apk:
       update_cache: yes
       upgrade: yes
     when: ansible_pkg_mgr == 'apk'
     notify: Reboot

   - name: Configure apt
     block:
       - name: Prevent apt upgrades for specific packages
         dpkg_selections:
           name: "{{ item }}"
           selection: hold
         loop: "{{ update_excluded_packages }}"
       - name: Update apt cache
         apt:
           update_cache: yes
       - name: Upgrade all apt software
         apt:
           upgrade: dist
         notify: Reboot
       - name: Autoremove unused apt packages
         apt:
           autoremove: yes
         when: apt_autoremove | bool
     when: ansible_pkg_mgr == 'apt'

   - name: Update all software (dnf)
     dnf:
       name: '*'
       exclude: "{{ update_excluded_packages }}"
       state: latest
     when: ansible_pkg_mgr in ['dnf', 'dnf5']
     notify: Reboot

   - name: Update all software (pacman)
     pacman:
       upgrade: yes
     when: ansible_pkg_mgr == 'pacman'
     notify: Reboot

   - name: Configure yum
     block:
       - name: Update all yum software (version 6)
         yum:
           name: '*'
           exclude: "{{ update_excluded_packages }}"
           state: latest
         when: yum_version.stdout == '6'
         notify: Reboot
       - name: Update all yum software (other versions)
         yum:
           name: '*'
           exclude: "{{ update_excluded_packages }}"
           state: latest
         when: yum_version.stdout != '6'
         notify: Reboot
     vars:
       yum_version: "{{ lookup('pipe', 'yum --version | cut -d. -f1') }}"
     when: ansible_pkg_mgr == 'yum'

   - name: Update all software (zypper)
     zypper:
       name: '*'
       type: patch
     when: ansible_pkg_mgr == 'zypper'
     notify: Reboot

