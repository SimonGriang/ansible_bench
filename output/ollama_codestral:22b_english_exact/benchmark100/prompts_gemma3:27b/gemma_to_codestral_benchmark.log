---
   - name: Import assert.yml
     ansible.builtin.import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install cron
     ansible.builtin.package:
       name: "{{ cron_packages }}"
       state: present

   - name: Configure shell
     ansible.builtin.lineinfile:
       path: "{{ cron_configuration }}"
       regexp: '^SHELL='
       line: 'SHELL={{ cron_shell }}'
       create: yes
       mode: '0600'
     notify: Restart cron

   - name: Configure path
     ansible.builtin.lineinfile:
       path: "{{ cron_configuration }}"
       regexp: '^PATH='
       line: 'PATH={{ cron_path }}'
       create: yes
       mode: '0600'
     notify: Restart cron

   - name: Configure mailto
     ansible.builtin.lineinfile:
       path: "{{ cron_configuration }}"
       regexp: '^MAILTO='
       line: 'MAILTO={{ cron_mailto }}'
       create: yes
       mode: '0600'
     notify: Restart cron

   - name: Start and enable cron
     ansible.builtin.service:
       name: "{{ cron_service }}"
       state: started
       enabled: true
     when: cron_service | length > 0

   - name: Schedule requested cron jobs
     ansible.builtin.cron:
       name: "{{ item.name }}"
       minute: "{{ item.minute }}"
       hour: "{{ item.hour }}"
       day: "{{ item.day }}"
       month: "{{ item.month }}"
       weekday: "{{ item.weekday }}"
       special_time: "{{ item.special_time }}"
       job: "{{ item.job }}"
     loop: "{{ cron_jobs }}"
     loop_control:
       label: "{{ item.name }}"
     when: cron_jobs is defined

