       state: present
     when: >-
       postfix_mysql_virtual_mailbox_maps is defined or
       postfix_mysql_virtual_mailbox_domains is defined

   - name: Configure postfix (transport_maps)
     template:
       src: transport_maps.j2
       dest: /etc/postfix/transport_maps
     notify:
       - Validate postfix
       - Rebuild database
     when: postfix_transport_maps_template is defined

   - name: Configure postfix (header_checks)
     template:
       src: header_checks.j2
       dest: /etc/postfix/header_checks
     notify:
       - Validate postfix
       - Reload postfix
     when: postfix_header_checks_template is defined

   - name: Setting values for main.cf (1/2)
     set_fact:
       postfix_main_cf_facts1: "value1"
     when: condition1 is defined

   - name: Setting values for main.cf (2/2)
     set_fact:
       postfix_main_cf_facts2: "{{ variable2 | default('default_value') }}"

   - name: Configure postfix (main.cf)
     template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify:
       - Validate postfix
       - Restart postfix

   - name: Configure postfix (master.cf)
     template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify:
       - Validate postfix
       - Restart postfix

   - name: Creates cert/key directory
     file:
       path: /etc/postfix/cert
       state: directory
     when: >-
       postfix_tls_cert_file is defined or
       postfix_tls_key_file is defined

   - name: Deploy Postfix TLS server certificate
     copy:
       src: "{{ postfix_tls_cert_file }}"
       dest: /etc/postfix/cert/cert.pem
     when: postfix_tls_cert_file is defined

   - name: Deploy Postfix TLS server key
     copy:
       src: "{{ postfix_tls_key_file }}"
       dest: /etc/postfix/cert/key.pem
     when: postfix_tls_key_file is defined

   - name: Flush handlers
     meta: flush_handlers

   - name: Configure aliases
     lineinfile:
       dest: /etc/aliases
       line: "{{ item.key }}: {{ item.value }}"
     loop: "{{ postfix_aliases | dict2items }}"

   - name: Configure sender_access
     lineinfile:
       dest: /etc/postfix/sender_access
       line: "{{ item }}"
     loop: "{{ postfix_sender_access }}"

   - name: Configure recipient_access
     lineinfile:
       dest: /etc/postfix/recipient_access
       line: "{{ item }}"
     loop: "{{ postfix_recipient_access }}"

   - name: Place sasl_password_map
     copy:
       content: "{{ postfix_sasl_password_map }}"
       dest: /etc/postfix/sasl_password_map

   - name: Flush handlers again
     meta: flush_handlers

   - name: Start and enable postfix
     service:
       name: postfix
       state: started
       enabled: true


