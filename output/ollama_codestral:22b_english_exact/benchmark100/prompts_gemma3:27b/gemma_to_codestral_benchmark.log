---
- name: Enable Backports repository for Debian
  apt_repository:
    repo: "deb http://deb.debian.org/debian {{ ansible_distribution_release }}-backports main"
    state: present
    filename: "debian-backports-{{ ansible_distribution_release }}"
  when: ansible_distribution == 'Debian' and ansible_distribution_major_version | int < 9

- name: Set default_release fact for older Debian versions
