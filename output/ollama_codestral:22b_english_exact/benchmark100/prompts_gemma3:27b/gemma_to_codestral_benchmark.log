 - name: Set java_jdk_vendor fact to temurin if it's adoptopenjdk
    set_fact:
      java_jdk_vendor: "temurin"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Include OS specific variables
    include_vars: "{{ java_jdk_vendor }}/{{ ansible_distribution }}/{{ ansible_distribution_major_version }}.yml"

  - name: Include architecture specific variables
    include_vars: architecture.yml

  - name: Set OS specific variables
    set_fact:
      java_open_jdk_version: "{{ java_open_jdk_version | default('8') }}"
      java_open_jdk_repo: "{{ java_open_jdk_repo | default('ppa:openjdk/ppa') }}"
      java_required_libs_openjdk: "{{ java_required_libs_openjdk | default('ca-certificates') }}"

  - name: Set OS and architecture specific variables
    set_fact:
      java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/java-1.{{ java_open_jdk_version }}.0-openjdk-{{ ansible_architecture }}') }}"
      java_open_jdk_package: "{{ java_open_jdk_package | default('java-1.{{ java_open_jdk_version }}.0-openjdk-{{ ansible_architecture }}') }}"

  - name: Set java_home fact
    set_fact:
      java_home: "{{ java_open_jdk_home }}"

  - name: Remove deprecated AdoptOpenJDK repositories (Debian)
    apt_repository:
      repo: "{{ item }}"
      state: absent
    loop: "{{ java_deprecated_repositories_adoptopenjdk }}"
    when: ansible_os_family == 'Debian'

  - name: Install extra apt tools (Debian)
    apt:
      name: "{{ java_open_jdk_apt_extra_packages }}"
      state: present
    when: ansible_os_family == 'Debian' and java_open_jdk_apt_extra_packages is defined

  - name: Add required apt key repositories (Debian)
    apt_key:
      url: "{{ item }}"
      state: present
    loop: "{{ java_required_key_repositories_openjdk }}"
    when: ansible_os_family == 'Debian'

  - name: Add required apt repositories (Debian)
    apt_repository:
      repo: "{{ item }}"
      state: present
    loop: "{{ java_required_repositories_openjdk }}"
    when: ansible_os_family == 'Debian'

  - name: Add required RPM key repositories (RedHat)
    rpm_key:
      key: "{{ item }}"
      state: present
    loop: "{{ java_required_key_repositories_openjdk }}"
    when: ansible_os_family == 'RedHat'

  - name: Add required YUM repositories (RedHat)
    yum_repository:
      name: openjdk
      description: OpenJDK repository
      baseurl: "{{ java_required_repositories_openjdk }}"
      gpgcheck: yes
    when: ansible_os_family == 'RedHat'

  - name: Install required libraries
    package:
      name: "{{ java_required_libs_openjdk }}"
      state: present

  - name: Install Java (Debian)
    apt:
      name: "{{ java_open_jdk_package }}"
      state: present
    when: ansible_os_family == 'Debian'

  - name: Install Java (RedHat)
    yum:
      name: "{{ java_open_jdk_package }}"
      state: present
    when: ansible_os_family == 'RedHat'

  - name: Create template file for Java environment variables
    template:
      src: jdk.sh.j2
      dest: /etc/profile.d/jdk.sh

  - name: Source /etc/profile to apply Java environment variables
    shell: source /etc/profile
    args:
      executable: /bin/bash

  - name: Set 'java' alternative to correct path (Debian, Java < 11)
    alternatives:
      name: java
      path: "{{ java_open_jdk_home_dir }}/bin/java"
    when: ansible_os_family == 'Debian' and java_open_jdk_version | int < 11

  - name: Set 'java' alternative to correct path (Debian, Java >= 11)
    alternatives:
      name: java
      path: "{{ java_open_jdk_home_dir }}/bin/java"
      priority: 1100
    when: ansible_os_family == 'Debian' and java_open_jdk_version | int >= 11

