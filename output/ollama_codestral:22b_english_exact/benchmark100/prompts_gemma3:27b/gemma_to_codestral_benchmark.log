 - name: Import assert tasks
      import_tasks: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Install python pip
      package:
        name: "{{ python_pip_packages }}"
        state: present

    - name: Configure pip proxy
      blockinfile:
        path: /etc/pip.conf
        insertafter: "[global]"
        block: |
          index-url = {{ python_pip_proxy }}
      when: python_pip_proxy is defined
      notify: Update pip cache

    - name: Trust hosts
      blockinfile:
        path: /etc/pip.conf
        insertafter: "[global]"
        block: |
          trusted-host = {{ python_pip_trusted_host }}
      when: python_pip_trusted_host is defined
      notify: Update pip cache

    - name: Update pip
      pip:
        name: "{{ python_pip_pip_package }}"
        state: "{{ python_pip_pip_state }}"
        executable: "{{ python_pip_executable }}"
      when: ansible_distribution != 'Debian' or (ansible_distribution == 'Debian' and ansible_distribution_release not in ['bookworm', 'noble']) and ansible_os_family != 'Alpine'

    - name: Install requested modules
      pip:
        name: "{{ item.name }}"
        state: "{{ item.state | default('present') }}"
        version: "{{ item.version | default(omit) }}"
        executable: "{{ python_pip_executable }}"
      loop: "{{ python_pip_modules }}"
      loop_control:
        label: "{{ item.name }}"
      when: ansible_distribution != 'Debian' or (ansible_distribution == 'Debian' and ansible_distribution_release not in ['bookworm', 'noble']) and ansible_os_family != 'Alpine'

    - name: Update pip cache
      command: pip cache purge
      changed_when: false

