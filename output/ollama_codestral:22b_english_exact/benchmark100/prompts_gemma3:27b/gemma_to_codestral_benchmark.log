     delegate_to: localhost
     run_once: true

   - name: Configure apk
     apk:
       update_cache: true
       upgrade: true
       state: latest
     notify: Reboot
     when: ansible_pkg_mgr == 'apk'

   - name: Configure apt
     block:
       - name: Set apt preferences
         copy:
           dest: /etc/apt/preferences.d/update_excluded_packages
           content: |
             {% for package in update_excluded_packages %}
             Package: {{ package }}
             Pin: release *
             Pin-Priority: -1
             {% endfor %}
       - name: Update apt cache
         apt:
           update_cache: true
           cache_valid_time: 3600
       - name: Upgrade all software with apt
         apt:
           upgrade: dist
         notify: Reboot
       - name: Autoremove apt packages
         apt:
           autoremove: true
         when: apt_autoremove | default(false) | bool
     when: ansible_pkg_mgr == 'apt'

   - name: Update all software (dnf)
     dnf:
       name: '*'
       state: latest
       exclude: "{{ update_excluded_packages | join(',') }}"
     notify: Reboot
     when: ansible_pkg_mgr in ['dnf', 'dnf5']

   - name: Update all software (pacman)
     pacman:
       update_cache: true
       upgrade: true
     notify: Reboot
     when: ansible_pkg_mgr == 'pacman'

   - name: Configure yum
     block:
       - name: Configure yum 6
         yum_repository:
           name: yum6
           file: excluded_packages
           exclude: "{{ update_excluded_packages | join(',') }}"
         when: ansible_distribution_major_version == '6'
       - name: Configure yum others
         yum:
           name: '*'
           state: latest
           exclude: "{{ update_excluded_packages | join(',') }}"
           update_cache: true
         notify: Reboot
     when: ansible_pkg_mgr == 'yum'

   - name: Update all software (zypper)
     zypper:
       name: '*'
       state: latest
       type: package
       update_cache: true
     notify: Reboot
     when: ansible_pkg_mgr == 'zypper'

   - name: Ensure playbook ends with a new line
     debug:
       msg: "Playbook execution complete"

   - name: Ensure file ends with a new line
     lineinfile:
       path: "{{ ansible_playbook_python }}"
       line: ""
       state: present
       insertafter: EOF
       create: true
       mode: '0644'


