       - name: Modify selinux boolean values
         seboolean:
           name: "{{ item }}"
           state: true
           persistent: true
         loop: "{{ httpd_sebooleans }}"
       - name: Allow connections to custom ports
         seport:
           ports: "{{ httpd_port }},{{ httpd_ssl_port }}"
           proto: tcp
           setype: http_port_t
           state: present
         when: httpd_port is defined and httpd_ssl_port is defined
     when:
       - ansible_selinux is defined
       - ansible_selinux.status == "enabled"

   - name: Configure httpd
     template:
       src: "{{ httpd_config_src }}"
       dest: "{{ httpd_config_dest }}"
       mode: 0644
     notify:
       - Test httpd configuration
       - Restart httpd

   - name: Activate httpd module | Debian
     command: "a2enmod {{ item }}"
     loop: "{{ httpd_modules_to_activate_with_command }}"
     when: ansible_os_family == "Debian"

   - name: Import ssl
     import_tasks: ssl.yml
     when: https_ssl_enable | bool

   - name: Import locations
     import_tasks: locations.yml
     when: httpd_locations is defined

   - name: Import vhosts
     import_tasks: vhosts.yml
     when: httpd_vhosts is defined

   - name: Configure ports
     template:
       src: "httpd_ports.conf.j2"
       dest: "{{ httpd_server_root }}/ports.conf"
       mode: 0644
     notify:
       - Test httpd configuration
       - Restart httpd
     when: ansible_os_family in ["Debian", "Suse"]

   - name: Import directories
     import_tasks: directories.yml
     when: httpd_directories is defined

   - name: Flush handlers
     meta: flush_handlers

   - name: Removing default html
     file:
       path: "{{ httpd_data_directory }}/index.html"
       state: absent
     when: httpd_remove_example | bool

   - name: Start and enable httpd
     service:
       name: "{{ httpd_service }}"
       state: started
       enabled: true

