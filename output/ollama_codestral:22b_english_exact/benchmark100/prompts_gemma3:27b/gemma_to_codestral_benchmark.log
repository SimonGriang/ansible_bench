 Manifests\n     copy:\n       src: "{{ rke2_custom_manifests_path }}/"\n       dest: "{{ rke2_data_dir }}/server/manifests/"\n     when: rke2_custom_manifests_path is defined\n\n   - name: Copy Static Pods\n     copy:\n       src: "{{ rke2_static_pods_path }}/"\n       dest: "{{ rke2_data_dir }}/agent/pod-manifests/"\n     when: rke2_static_pods_path is defined\n\n   - name: Copy RKE2 environment file\n     template:\n       src: rke2-environment.j2\n       dest: "{{ rke2_bin_path }}/../env"\n       mode: \'0644\'\n     vars:\n       rke2_environment_options: "{{ rke2_environment_options | default({}) }}"\n\n   # The line below is to satisfy yamllint new-line-at-end-of-file rule\n   - name: Dummy task to satisfy yamllint new-line-at-end-of-file rule\n     debug:\n       msg: "This task does nothing and is only here to add a new line at the end of the file."\n\n# The end of the file should have a new line to satisfy yamllint new-line-at-end-of-file rule.' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-21T23:17:52.807984354Z', 'done': True, 'done_reason': 'stop', 'total_duration': 42014213401, 'load_duration': 14717971, 'prompt_eval_count': 2944, 'prompt_eval_duration': 286045720, 'eval_count': 1704, 'eval_duration': 41712491218, 'model_name': 'codestral:22b'} id='run--85be69b1-24bd-4c11-9b1c-bd293a30a990-0' usage_metadata={'input_tokens': 2944, 'output_tokens': 1704, 'total_tokens': 4648}
