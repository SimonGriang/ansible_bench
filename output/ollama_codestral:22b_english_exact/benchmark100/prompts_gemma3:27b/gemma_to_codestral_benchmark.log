nt': 579, 'eval_duration': 12039193027, 'model_name': 'codestral:22b'} id='run--e744f017-6ea0-497b-8e3d-314da80dbcdb-0' usage_metadata={'input_tokens': 775, 'output_tokens': 579, 'total_tokens': 1354}
