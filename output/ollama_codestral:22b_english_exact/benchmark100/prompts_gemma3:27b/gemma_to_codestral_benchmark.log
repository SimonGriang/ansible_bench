 - name: Import assert.yml
     import_tasks: assert.yml
     run_once: true
     delegate_to: localhost

   - name: Install dns
     package:
       name: "{{ dns_packages }}"
       state: present

   - name: Create directories
     file:
       path: "{{ item }}"
       state: directory
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: "0750"
     loop:
       - "{{ dns_datadir }}"
       - "{{ dns_confdir }}"

   - name: Create group
     group:
       name: "{{ dns_group }}"
       state: present

   - name: Create user
     user:
       name: "{{ dns_owner }}"
       system: yes

   - name: Generate rndc key
     command: rndc-confgen -a -r /dev/urandom -b 1024 -k {{ dns_confdir }}/rndc.key
     args:
       creates: "{{ dns_confdir }}/rndc.key"

   - name: Set permissions on rndc key file
     file:
       path: "{{ dns_confdir }}/rndc.key"
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: "0644"

   - name: Get the hints/root file
     get_url:
       url: "{{ dns_root_hints_url }}"
       dest: "{{ dns_datadir }}/named.root"
     when: dns_caching_dns | bool
     notify: Rndc reload

   - name: Create zone file
     template:
       src: zone.j2
       dest: "{{ dns_datadir }}/{{ item.name }}.zone"
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: "0644"
     loop: "{{ dns_zones }}"
     notify: Rndc reload
     vars:
       zone_file: "{{ dns_datadir }}/{{ item.name }}.zone"
     changed_when: false

   - name: Add zones to configuration
     template:
       src: named.conf.j2
       dest: "{{ dns_confdir }}/named.conf"
       owner: "{{ dns_owner }}"
       group: "{{ dns_group }}"
       mode: "0644"
       validate: "named-checkconf -t %s"
       backup: yes
     notify: Restart dns

   - name: Place systemd override
     block:
       - name: Create systemd override directory
         file:
           path: "/etc/systemd/system/{{ dns_service }}.service.d"
           state: directory

       - name: Copy systemd override file
         copy:
           src: override.conf
           dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"

       - name: Reload systemd daemon
         systemd:
           daemon_reload: yes
     when: ansible_service_mgr == 'systemd'

   - name: Start and enable dns
     service:
       name: "{{ dns_service }}"
       state: started
       enabled: yes

