---
   - name: Download RKE2 kubeconfig
     ansible.builtin.fetch:
       src: "/etc/rancher/rke2/rke2.yaml"
       dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
       flat: yes
     when: rke2_download_kubeconf and inventory_hostname == (groups[rke2_servers_group_name] | first)

