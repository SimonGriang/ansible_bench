       combined_node_taints: "{{ rke2_agent_node_taints }}"
     when: rke2_type == 'agent'

   - name: Copy RKE2 config
     template:
       src: rke2-config.yml.j2
       dest: /etc/rancher/rke2/config.yaml
       mode: '0644'
     notify: restart rke2

   - name: Copy kubelet config
     template:
       src: kubelet-config.yml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       mode: '0644'
     notify: restart rke2
     when: rke2_kubelet_config | length > 0

   - name: Copy Containerd Registry Configuration file
     template:
       src: registries.yml.j2
       dest: /etc/rancher/rke2/registries.yaml
       mode: '0644'
     notify: restart rke2
     when: >
       rke2_custom_registry_mirrors | length > 0
       or rke2_custom_registry_configs | length > 0

   - name: Start RKE2 service on the rest of the nodes
     systemd:
       name: rke2-server.service
       state: started
       enabled: true
       daemon_reload: true
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     register: rke2_service_result
     until: rke2_service_result is succeeded
     retries: 5
     delay: 10
     notify: handle rke2 service restart

   - name: Mask other RKE2 service on the rest of the nodes
     systemd:
       name: "{{ item }}"
       state: stopped
       enabled: false
       masked: true
     with_items:
       - rke2-server.service
       - rke2-agent.service
     when: item != 'rke2-' + rke2_type + '.service'

   - name: Wait for remaining nodes to be ready - no CNI
     shell: |
       kubectl get nodes --no-headers -o wide |
       awk '{print $2}' | grep 'Ready' | wc -l
     register: ready_nodes
     until: ready_nodes.stdout | int >= ansible_play_hosts | length
     retries: 30
     delay: 10
     when: rke2_cni == 'none' and (rke2_active_server or inventory_hostname == groups['rke2_servers'][0])

   - name: Wait for remaining nodes to be ready - with CNI
     shell: kubectl get nodes --no-headers -o wide | grep -vE 'NotReady|SchedulingDisabled|PodCIDR' | wc -l
     register: ready_nodes
     until: ready_nodes.stdout | int == ansible_play_hosts | length
     retries: 30
     delay: 10
     when: rke2_cni != 'none' and (rke2_active_server or inventory_hostname == groups['rke2_servers'][0])


