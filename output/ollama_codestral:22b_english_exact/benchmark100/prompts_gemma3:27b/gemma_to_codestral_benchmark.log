 - name: gather_facts | Lookup bootstrap facts
     raw: cat /etc/os-release
     register: bootstrap_facts

   - name: gather_facts | Set bootstrap facts (I)
     set_fact:
       bootstrap_distribution: "{{ item.split('=')[1] | replace('\"', '') }}"
       bootstrap_distribution_major_version: "{{ (bootstrap_search.stdout | regex_search('\\d+')).group(0) }}"
     when:
       - bootstrap_facts.rc == 0
       - bootstrap_distribution is not defined
       - bootstrap_search.stdout != ''
     loop: "{{ bootstrap_facts.stdout_lines }}"
     loop_control:
       loop_var: line
     vars:
       bootstrap_search:
         command: "grep 'PRETTY_NAME' /etc/os-release | grep '{{ item }}'"
         chdir: "/"
       bootstrap_os_family_map:
         debian: ['debian', 'ubuntu', 'linuxmint', 'popos']
         rhel: ['centos', 'redhat', 'scientific', 'oracle', 'amazon', 'almalinux']
         suse: ['suse', 'opensuse']

   - name: gather_facts | Set bootstrap facts (II)
     set_fact:
       bootstrap_os_family: "{{ item.key }}"
     when: bootstrap_distribution in item.value
     loop: "{{ bootstrap_os_family_map | dict2items }}"
     loop_control:
       loop_var: item

