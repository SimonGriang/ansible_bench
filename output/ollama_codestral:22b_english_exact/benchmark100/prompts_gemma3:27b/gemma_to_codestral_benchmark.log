593575, 'load_duration': 19472227, 'prompt_eval_count': 936, 'prompt_eval_duration': 124333380, 'eval_count': 583, 'eval_duration': 12045897147, 'model_name': 'codestral:22b'} id='run--961eaf7b-2cb0-453c-a71a-aed0a6fbca7d-0' usage_metadata={'input_tokens': 936, 'output_tokens': 583, 'total_tokens': 1519}
