 - name: Download RKE2 installation script
     get_url:
       url: "{{ rke2_url }}"
       dest: "/tmp/rke2.sh"
     when: not rke2_airgap_mode

   - name: Copy local RKE2 installation script
     copy:
       src: "{{ rke2_local_path }}/rke2.sh"
       dest: "/tmp/rke2.sh"
     when: rke2_airgap_mode and rke2_airgap_implementation == 'copy'

   - name: Create RKE2 artifacts folder
     file:
       path: "{{ rke2_artifact_path }}"
       state: directory
     when: rke2_airgap_mode and rke2_airgap_implementation != 'exists'

   - name: Download RKE2 checksum and artifacts
     block:
       - name: Attempt remote download
         get_url:
           url: "{{ rke2_artifact_url }}/{{ item }}"
           dest: "{{ rke2_artifact_path }}/{{ item }}"
         loop:
           - "{{ rke2_artifact_filename }}"
           - "{{ rke2_artifact_filename }}.sha256"
         register: remote_download
     rescue:
       - name: Fallback to local download and push
         copy:
           src: "{{ rke2_local_path }}/{{ item }}"
           dest: "{{ rke2_artifact_path }}/{{ item }}"
         loop:
           - "{{ rke2_artifact_filename }}"
           - "{{ rke2_artifact_filename }}.sha256"
         when: not remote_download.results[0].failed

   - name: Copy local RKE2 artifacts
     copy:
       src: "{{ rke2_local_path }}/{{ item }}"
       dest: "{{ rke2_artifact_path }}/{{ item }}"
     loop:
       - "{{ rke2_artifact_filename }}"
       - "{{ rke2_artifact_filename }}.sha256"
     when: rke2_airgap_mode and rke2_airgap_implementation == 'copy'

   - name: Airgap mode - additional images tarballs
     copy:
       src: "{{ rke2_local_path }}/{{ item }}"
       dest: "{{ rke2_artifact_path }}/{{ item }}"
     loop: "{{ rke2_additional_images | default([]) }}"
     when: rke2_airgap_mode

   - name: Airgap mode - ensure artifacts exist and have acceptable permissions
     file:
       path: "{{ rke2_artifact_path }}/{{ item }}"
       mode: '0644'
     loop:
       - "{{ rke2_artifact_filename }}"
       - "{{ rke2_artifact_filename }}.sha256"
     when: rke2_airgap_mode

   - name: Populate service facts
     service_facts:

   - name: Get stats of the FS object
     stat:
       path: /usr/local
     register: usr_local_stat

   - name: Check if separate partition
     set_fact:
       separate_partition: "{{ usr_local_stat.stat.dev != '/dev/root' }}"

   - name: Set RKE2 bin path
     set_fact:
       rke2_bin_path: "{{ '/usr/local/bin' if separate_partition else '/var/lib/rancher/rke2/bin' }}"

   - name: Check RKE2 version
     shell: "{{ rke2_bin_path }}/rke2 --version"
     register: rke2_version_check
     ignore_errors: true

   - name: Set RKE2 versions
     set_fact:
       installed_version: "{{ rke2_version_check.stdout_lines[0].split(':')[1].strip() if rke2_version_check.stdout_lines else '0.0.0' }}"
       running_version: "{{ services['rke2-server.service'].state == 'running' | ternary(rke2_version_check.stdout_lines[0].split(':')[1].strip(), '0.0.0') }}"

   - name: Prevent accidental RKE2 downgrade
     assert:
       that:
         - rke2_allow_downgrade or running_version == '0.0.0' or installed_version == running_version or installed_version is version(running_version, '>')
       fail_msg: "RKE2 downgrade attempted. Set rke2_allow_downgrade to true to allow."

   - name: Run RKE2 install script
     shell: |
       INSTALL_RKE2_TYPE={{ rke2_install_type }} \
       INSTALL_RKE2_VERSION={{ rke2_version }} \
       INSTALL_RKE2_EXEC="server" \
       INSTALL_RKE2_BIN_DIR="{{ rke2_bin_path }}" \
       INSTALL_RKE2_DATA_DIR={{ rke2_data_dir }} \
       INSTALL_RKE2_SYSTEM_DEFAULTS=true \
       INSTALL_RKE2_SYSTEMD_DIR=/etc/systemd/system \
       sh /tmp/rke2.sh

   - name: Copy Custom Manifests
     copy:
       src: "{{ rke2_custom_manifests_path }}/"
       dest: "{{ rke2_data_dir }}/server/manifests/"
     when: rke2_custom_manifests_path is defined

   - name: Copy Static Pods
     copy:
       src: "{{ rke2_static_pods_path }}/"
       dest: "{{ rke2_data_dir }}/agent/pod-manifests/"
     when: rke2_static_pods_path is defined

   - name: Copy RKE2 environment file
     template:
       src: rke2-environment.j2
       dest: "{{ rke2_bin_path }}/../env"
       mode: '0644'
     vars:
       rke2_environment_options: "{{ rke2_environment_options | default({}) }}"

