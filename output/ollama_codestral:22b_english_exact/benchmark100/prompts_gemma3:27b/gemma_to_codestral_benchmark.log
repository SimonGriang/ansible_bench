         block:
           - name: Install repository for RedHat
             get_url:
               url: "{{ hashicorp_redhat_repo_url }}"
               dest: /etc/yum.repos.d/hashicorp.repo
               mode: '0640'
             when: ansible_os_family == "RedHat"

