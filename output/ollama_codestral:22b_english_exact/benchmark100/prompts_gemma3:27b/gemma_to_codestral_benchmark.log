       dest: /usr/bin/vault
       owner: root
       group: root
       mode: 0755
     notify:
       - Restart vault

   - name: Set cap_ipc_lock=ep on /usr/bin/vault
     capabilities:
       path: /usr/bin/vault
       capability: cap_ipc_lock=ep
       state: present

   - name: Touch vault.env
     file:
       path: "{{ vault_path }}/etc/vault.d/vault.env"
       state: touch
       owner: vault
       group: "{{ vault_group }}"
