---
   - name: lookup bootstrap facts (raw)
     raw: cat /etc/os-release
     register: bootstrap_facts
     changed_when: false
     become: false
     become_user: "{{ bootstrap_user }}"

   - name: set bootstrap facts (I)  # noqa jinja
     when:
       - bootstrap_facts.rc == 0
       - bootstrap_distribution is not defined
       - "'PRETTY_NAME=' ~ item ~ '" in bootstrap_facts.stdout_lines|join
     loop: "{{ bootstrap__os_family_map.keys()|list }}"
     vars:
       version_match: >-
         {{ bootstrap_facts.stdout_lines|join('\n')|
         regex_search('PRETTY_NAME=' ~ item ~ ' (\\d+)') }}
     set_fact:
       bootstrap_distribution: "{{ item }}"
       bootstrap_distribution_major_version: "{{ version_match.group(1) }}"
     become: "{{ bootstrap_become }}"
     become_user: "{{ bootstrap_become_user }}"

   - name: set bootstrap facts (II)
     when: bootstrap_distribution in bootstrap__os_family_map[bootstrap_os_family]
     loop: "{{ bootstrap__os_family_map.keys()|list }}"
     loop_control:
       loop_var: bootstrap_os_family
     set_fact:
       bootstrap_os_family: "{{ bootstrap_os_family }}"
     become: "{{ bootstrap_become }}"
     become_user: "{{ bootstrap_become_user }}"


