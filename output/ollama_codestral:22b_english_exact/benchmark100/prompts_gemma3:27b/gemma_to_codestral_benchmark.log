       path: /etc/rancher/rke2
       state: directory
       owner: root
       group: root
       mode: '0755'

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_type == 'server'

   - name: Copy rke2 config
     template:
       src: rke2.yaml.j2
       dest: /etc/rancher/rke2/config.yaml
       owner: root
       group: root
       mode: '0644'
     notify: Config file changed

   - name: Copy kubelet config
     template:
       src: kubelet.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       owner: root
       group: root
       mode: '0644'
     notify: Config file changed
     when: rke2_kubelet_config | length > 0

   - name: Copy Containerd Registry Configuration file
     template:
       src: registries.yaml.j2
       dest: /etc/rancher/rke2/registries.yaml
       owner: root
       group: root
       mode: '0644'
     notify: Config file changed
     when: >
       rke2_custom_registry_mirrors | length > 0 or
       rke2_custom_registry_configs | length > 0

   - name: Register if we need to do a etcd restore from file
     set_fact:
       do_etcd_restore: true
     when: >
       rke2_etcd_snapshot_file is defined and
       (ansible_facts.services["rke2-server.service"] is not defined or
       ansible_facts.services["rke2-server.service"]["state"] in ["stopped", "inactive"])

   - name: Register if we need to do a etcd restore from s3
     set_fact:
       do_etcd_restore_from_s3: true
     when: >
       rke2_etcd_snapshot_file is defined and
       rke2_etcd_snapshot_s3_options is defined and
       rke2_etcd_snapshot_s3_options.access_key_id is defined and
       rke2_etcd_snapshot_s3_options.secret_access_key is defined and
       rke2_etcd_snapshot_s3_options.bucket is defined

   - name: Restore etcd from file
     block:
       - file:
           path: /var/lib/rancher/rke2/server/db
           state: directory
           owner: root
           group: root
           mode: '0755'
       - copy:
           src: "{{ rke2_etcd_snapshot_file }}"
           dest: /var/lib/rancher/rke2/server/db/snap.db
           owner: root
           group: root
           mode: '0644'
       - command: systemctl stop rke2-server.service
       - command: >
           /var/lib/rancher/rke2/bin/rke2 server
           --config /etc/rancher/rke2/config.yaml
           --etcd-snapshot-restore-from=/var/lib/rancher/rke2/server/db/snap.db
           --etcd-schedulable-endpoint=false
     when: do_etcd_restore

   - name: Restore etcd from s3
     command: >
       /var/lib/rancher/rke2/bin/rke2 server
       --config /etc/rancher/rke2/config.yaml
       --etcd-snapshot-restore-from-s3
       --etcd-s3-endpoint-url="{{ rke2_etcd_snapshot_s3_options.endpoint_url }}"
       --etcd-s3-access-key-id="{{ rke2_etcd_snapshot_s3_options.access_key_id }}"
       --etcd-s3-secret-access-key="{{ rke2_etcd_snapshot_s3_options.secret_access_key }}"
       --etcd-s3-bucket="{{ rke2_etcd_snapshot_s3_options.bucket }}"
       --etcd-schedulable-endpoint=false
     when: do_etcd_restore_from_s3

   - name: Start RKE2 service on the first server
     systemd:
       name: rke2-server.service
       state: started
       enabled: true
       daemon_reload: true
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     notify: Service (re)started

   - name: Mask RKE2 agent service on the first server
     systemd:
       name: rke2-agent.service
       state: stopped
       enabled: false
       masked: true

   - name: Wait for the first server be ready - no CNI
     command: kubectl get nodes
     register: kubectl_output
     until: kubectl_output.stdout.find("NotReady") == -1
     retries: 30
     delay: 10
     when: rke2_type == 'server' and rke2_enable_cni_plugin == false

   - name: Wait for the first server be ready - with CNI
     command: >
       kubectl get nodes -o
       jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}'
     register: kubectl_output
     until: "'True' in kubectl_output.stdout_lines"
     retries: 30
     delay: 10
     when: rke2_type == 'server' and rke2_enable_cni_plugin == true

   - name: Restore etcd
     block:
       - command: kubectl get nodes -o name
         register: nodes
       - set_fact:
           node_names: "{{ nodes.stdout_lines | map('regex_replace', '^nodes/', '') | list }}"
       - shell: kubectl get secrets -n kube-system | grep etcd-snap | awk '{print $1}'
         register: etcd_secrets
       - command: kubectl delete secrets -n kube-system {{ item }}
         loop: "{{ etcd_secrets.stdout_lines }}"
       - command: kubectl delete nodes {{ item }}
         loop: "{{ node_names }}"

   - name: Set an Active Server variable
     set_fact:
       active_server: "{{ inventory_hostname }}"
     delegate_to: "{{ item }}"
     delegate_facts: true
     loop: "{{ groups[rke2_cluster_group_name] }}"
   

