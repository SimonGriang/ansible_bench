 - name: Check if Helm binary exists
     stat:
       path: "{{ helm_bin_path }}"
     register: helm_check

   - name: Check Helm version
     command: helm version
     register: helm_existing_version
     failed_when: false
     changed_when: false

   - name: Download Helm binary
     unarchive:
       src: "{{ helm_repo_path }}/helm-v{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
       dest: /tmp
       remote_src: yes
     when: >
       not helm_check.stat.exists or
       ('v' + helm_version) not in helm_existing_version.stdout
     register: helm_download

   - name: Copy Helm binary into place
     copy:
       src: "/tmp/{{ helm_platform }}-{{ helm_arch }}/helm"
       dest: "{{ helm_bin_path }}"
       mode: 0755
       remote_src: yes
