content=' ---\n   - name: Download RKE2 installation script\n     get_url:\n       url: "{{ rke2_install_script_url }}"\n       dest: "{{ rke2_artifact_path }}/install.sh"\n       mode: \'0755\'\n     when: not airgap_mode\n\n   - name: Copy local RKE2 installation script\n     copy:\n       src: "{{ rke2_local_install_script_path }}"\n       dest: "{{ rke2_artifact_path }}/install.sh"\n       mode: \'0755\'\n     when: airgap_mode and rke2_implementation == \'copy\'\n\n   - name: Create RKE2 artifacts folder\n     file:\n       path: "{{ rke2_artifact_path }}"\n       state: directory\n     when: airgap_mode and rke2_implementation != \'exists\'\n\n   - name: Download RKE2 checksum and artifacts\n     block:\n       - name: Download RKE2 checksum and artifacts (remote)\n         get_url:\n           url: "{{ item.url }}"\n           dest: "{{ rke2_artifact_path }}/{{ item.name }}"\n           checksum: "sha256:{{ item.checksum }}"\n         loop: "{{ rke2_artifacts }}"\n     rescue:\n       - name: Download RKE2 checksum and artifacts (local)\n         copy:\n           src: "{{ item.local_path }}"\n           dest: "{{ rke2_artifact_path }}/{{ item.name }}"\n         loop: "{{ rke2_artifacts }}"\n       - name: Copy RKE2 artifacts to remote hosts\n         copy:\n           src: "{{ rke2_artifact_path }}/{{ item.name }}"\n           dest: "{{ rke2_artifact_path }}/{{ item.name }}"\n         loop: "{{ rke2_artifacts }}"\n\n   - name: Copy local RKE2 artifacts\n     copy:\n       src: "{{ item.local_path }}"\n       dest: "{{ rke2_artifact_path }}/{{ item.name }}"\n     loop: "{{ rke2_artifacts }}"\n     when: airgap_mode and rke2_implementation == \'copy\'\n\n   - name: Airgap mode - additional images tarballs\n     copy:\n       src: "{{ item.local_path }}"\n       dest: "{{ rke2_artifact_path }}/{{ item.name }}"\n     loop: "{{ additional_images }}"\n     when: airgap_mode and additional_images is defined\n\n   - name: Airgap mode - ensure artifacts exist and have acceptable permissions\n     file:\n       path: "{{ rke2_artifact_path }}/{{ item.name }}"\n       state: file\n       mode: \'0644\'\n     loop: "{{ rke2_artifacts }}"\n     when: airgap_mode\n\n   - name: Populate service facts\n     service_facts:\n\n   - name: Get stats of the FS object\n     stat:\n       path: /usr/local\n     register: usr_local_stat\n\n   - name: Check if separate partition\n     set_fact:\n       rke2_separate_partition: "{{ usr_local_stat.stat.dev != ansible_mounts | selectattr(\'mount\', \'equalto\', \'/\') | map(attribute=\'dev\') | first }}"\n\n   - name: Set RKE2 bin path\n     set_fact:\n       rke2_bin_path: "{{ \'/usr/local/bin\' if rke2_separate_partition else \'/var/lib/rancher/rke2/bin\' }}"\n\n   - name: Check RKE2 version\n     shell: "{{ rke2_bin_path }}/rke2 --version"\n     ignore_errors: yes\n     register: rke2_version_check\n\n   - name: Set RKE2 versions\n     set_fact:\n       rke2_installed_version: "{{ rke2_version_check.stdout_lines[0].split(\'+\')[0] if rke2_version_check.stdout_lines | length > 0 else \'\' }}"\n       rke2_running_version: "{{ (services[\'rke2-server.service\'].state == \'running\') | ternary(rke2_installed_version, \'\') }}"\n\n   - name: Prevent accidental RKE2 downgrade\n     assert:\n       that:\n         - rke2_installed_version == \'\' or allow_downgrade or rke2_installed_version is version(rke2_running_version, \'>=\')\n       fail_msg: "Downgrade detected: installed={{ rke2_installed_version }}, running={{ rke2_running_version }}. To allow downgrades, set allow_downgrade to true."\n\n   - name: Run RKE2 install script\n     command: "sh {{ rke2_artifact_path }}/install.sh"\n     environment:\n       INSTALL_RKE2_VERSION: "{{ rke2_version }}"\n       INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"\n       INSTALL_RKE2_TYPE: "{{ rke2_type }}"\n       INSTALL_RKE2_MIRROR: "{{ rke2_mirror }}"\n       INSTALL_RKE2_SYSTEM_DEFAULTS: "{{ rke2_system_defaults }}"\n       INSTALL_RKE2_IMAGE_TARBALL: "{{ rke2_image_tarball | default(omit) }}"\n       INSTALL_RKE2_BIN_DIR: "{{ rke2_bin_path }}"\n     when: rke2_installed_version == \'\' or rke2_installed_version != rke2_version\n\n   - name: Copy Custom Manifests\n     copy:\n       src: "{{ item }}"\n       dest: "{{ rke2_data_dir }}/{{ item | basename }}"\n     with_fileglob:\n       - "{{ rke2_custom_manifests_path }}/*.yaml"\n     when: rke2_custom_manifests_path is defined\n\n   - name: Copy Static Pods\n     copy:\n       src: "{{ item }}"\n       dest: "{{ rke2_agent_path }}/pod-manifests/{{ item | basename }}"\n     with_fileglob:\n       - "{{ rke2_static_pods_path }}/*.yaml"\n     when: rke2_static_pods_path is defined\n\n   - name: Copy RKE2 environment file\n     template:\n       src: rke2_env.j2\n       dest: /etc/default/rke2\n       owner: root\n       group: root\n       mode: \'0644\'\n     vars:\n       rke2_env_options: "{{ rke2_env_options }}"' additional_kwargs={} response_metadata={'model': 'codestral:22b', 'created_at': '2025-10-11T21:03:10.243349585Z', 'done': True, 'done_reason': 'stop', 'total_duration': 35756110590, 'load_duration': 16598944, 'prompt_eval_count': 971, 'prompt_eval_duration': 647157749, 'eval_count': 1703, 'eval_duration': 35091680251, 'model_name': 'codestral:22b'} id='run--b5530a9a-f5ad-40a7-bed8-7ce11413a63b-0' usage_metadata={'input_tokens': 971, 'output_tokens': 1703, 'total_tokens': 2674}
