       createhome: "{{ user.createhome | default(omit) }}"
       password: "{{ user.password | default(omit) }}"
       uid: "{{ user.uid | default(omit) }}"
       group: "{{ user.group | default(omit) }}"
       shell: "{{ user.shell | default(omit) }}"
       expires: "{{ user.expires | default(omit) }}"
     register: user_account

   - name: Set sudo options for user
     template:
       src: sudoers.j2
       dest: "/etc/sudoers.d/{{ user.name }}"
       validate: 'visudo -csf %s'
     loop: "{{ users }}"
     loop_control:
       loop_var: user
       label: "{{ user.name }}"
     when: user.sudo_options is defined

   - name: Remove sudo options for user
     file:
       path: "/etc/sudoers.d/{{ user.name }}"
       state: absent
     loop: "{{ users }}"
     loop_control:
       loop_var: user
       label: "{{ user.name }}"
     when: user.sudo_options is not defined

   - name: Generate private ssh key for user
     command: "ssh-keygen -t rsa -b 4096 -f \"{{ ssh_key_directory }}/{{ user.name }}_id_rsa\" -N ''"
     delegate_to: localhost
     when: user.manage_ssh_key is defined and user.manage_ssh_key | bool

   - name: Generate public ssh key for user
     command: "ssh-keygen -y -f \"{{ ssh_key_directory }}/{{ user.name }}_id_rsa\" > \"{{ ssh_key_directory }}/{{ user.name }}_id_rsa.pub\""
     delegate_to: localhost
     when: user.manage_ssh_key is defined and user.manage_ssh_key | bool

   - name: Convert ssh key to ppk for user
     command: "puttygen \"{{ ssh_key_directory }}/{{ user.name }}_id_rsa\" -o \"{{ ssh_key_directory }}/{{ user.name }}_id_rsa.ppk\" -O private"
     delegate_to: localhost
     when: user.manage_ssh_key is defined and user.manage_ssh_key | bool

   - name: Get or set the home directory for user
     shell: "getent passwd {{ user.name }} | cut -d: -f6 || echo '/home'"
     register: user_home

   - name: Create .ssh directory for user
     file:
       path: "{{ user_home.stdout }}/.ssh"
       state: directory
       mode: '0700'
       owner: "{{ user.name }}"
       group: "{{ user.name }}"
     become: yes
     become_user: "{{ user.name }}"
     when: user.manage_ssh_key is defined or user.private_keys is defined

   - name: Deploy authorized keys for user
     authorized_key:
       user: "{{ user.name }}"
       state: present
       key: "{{ item }}"
     loop: "{{ user.authorized_keys }}"

   - name: Remove unauthorized keys for user
     authorized_key:
       user: "{{ user.name }}"
       state: absent
       key: "{{ item }}"
     loop: "{{ user.unauthorized_keys }}"

   - name: Copy generated private ssh key for user
     copy:
       src: "{{ ssh_key_directory }}/{{ user.name }}_id_rsa"
       dest: "{{ user_home.stdout }}/.ssh/id_rsa"
       mode: '0600'
       owner: "{{ user.name }}"
       group: "{{ user.name }}"
     when: user.copy_private_key is defined

   - name: Check users password valid time
     shell: "chage -l {{ user.name }} | grep 'Password expires' | awk '{print $3, $4, $5}'"
     register: user_password_valid_time

   - name: Set users password valid time
     command: "chage -I {{ user.password_inactive_days }} -m {{ user.password_min_days }} -W {{ user.password_warn_days }} -M {{ user.password_max_days }} {{ user.name }}"

   - name: Place private key file for user
     copy:
       content: "{{ user.private_keys }}"
       dest: "{{ user_home.stdout }}/.ssh/id_rsa"
       mode: '0600'
       owner: "{{ user.name }}"
       group: "{{ user.name }}"
     when: user.private_keys is defined 53%|█████▎    | 53/100 [1:02:00<1:44:14, 133.07s/it]

