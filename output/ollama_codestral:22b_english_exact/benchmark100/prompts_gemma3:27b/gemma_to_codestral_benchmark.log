 - name: Get all RKE2 nodes
     shell: kubectl --kubeconfig {{ kubeconfig_file }} get nodes -o name
     register: nodes_output

   - name: Store RKE2 node names in variable
     set_fact:
       node_names: "{{ nodes_output.stdout_lines | map('regex_replace', '^node/', '') | list }}"

   - name: Remove old RKE2 nodes
     shell: |
       kubectl --kubeconfig {{ kubeconfig_file }} delete node {{ item }}
