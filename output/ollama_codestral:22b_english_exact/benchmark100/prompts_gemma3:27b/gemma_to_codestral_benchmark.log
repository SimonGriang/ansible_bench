---
   - name: Create the RKE2 config directory
     file:
       path: /etc/rancher/rke2
       state: directory
       mode: '0755'

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_type == 'server'

   - name: Set agent taints
     set_fact:
       combined_node_taints: "{{ rke2_agent_node_taints }}"
     when: rke2_type == 'agent'

   - name: Copy RKE2 config
     template:
       src: "{{ rke2_template_path }}"
       dest: "{{ rke2_config_path }}"
       mode: '0644'
     notify: Restart RKE2

   - name: Copy kubelet config
     template:
       src: "{{ rke2_kubelet_template_path }}"
       dest: "{{ rke2_kubelet_config_path }}"
       mode: '0644'
     when: rke2_kubelet_config | length > 0
     notify: Restart RKE2

   - name: Copy Containerd Registry Configuration file
     template:
       src: "{{ containerd_registry_template_path }}"
       dest: "{{ containerd_registry_config_path }}"
       mode: '0644'
     when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
     notify: Restart RKE2

   - name: Start RKE2 service on the rest of the nodes
     systemd:
       name: rke2-server.service
       state: started
       enabled: yes
       daemon_reload: yes
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     register: rke2_service_result
     until: rke2_service_result.changed == false
     retries: 5
     delay: 10
     notify: Handle RKE2 service restart

   - name: Mask other RKE2 service on the rest of the nodes
     systemd:
       name: "{{ item }}"
       state: stopped
       enabled: no
       masked: yes
     loop:
       - rke2-agent.service
       - rke2-server.service
     when: item != 'rke2-server.service' and rke2_type == 'server'

   - name: Wait for remaining nodes to be ready - no CNI
     shell: |
       kubectl get nodes --no-headers -o custom-columns=':.status.conditions[?(@.type=="MemoryPressure")].status' | grep -v True &&
       kubectl get nodes --no-headers -o custom-columns=':.status.conditions[?(@.type=="DiskPressure")].status' | grep -v True &&
       kubectl get nodes --no-headers -o custom-columns=':.status.conditions[?(@.type=="PIDPressure")].status' | grep -v True &&
       kubectl get nodes --no-headers -o custom-columns=':.status.conditions[?(@.type=="NetworkUnavailable")].status' | grep -v True
     register: nodes_ready
     until: nodes_ready.rc == 0
     retries: 30
     delay: 10
     when: rke2_cni == 'none' and (rke2_type == 'server' or inventory_hostname == groups['rke2_servers'][0])

   - name: Wait for remaining nodes to be ready - with CNI
     shell: kubectl get nodes | grep Ready | wc -l
     register: nodes_ready
     until: nodes_ready.stdout | int == (groups['rke2_servers'] | length + groups['rke2_workers'] | length)
     retries: 30
     delay: 10
     when: rke2_cni != 'none' and (rke2_type == 'server' or inventory_hostname == groups['rke2_servers'][0])

   # Added line break at the end of file
   

