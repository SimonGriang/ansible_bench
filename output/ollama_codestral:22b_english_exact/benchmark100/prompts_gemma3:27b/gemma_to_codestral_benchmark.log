---
   - name: Update apt cache
     when: ansible_pkg_mgr == 'apt'
     apt:
       update_cache: true

   - name: Update dnf cache
     when: ansible_pkg_mgr == 'dnf'
     dnf:
       update_cache: true

   - name: Install packages
     package:
       name: keepalived
       state: present

   - name: Create directory for keepalived
     file:
       path: /etc/keepalived
       state: directory
       owner: root
       group: root
       mode: 0755

   - name: Create Kubernetes API health check script for Debian OS family
     template:
       src: check_apiserver.sh.j2
       dest: /etc/keepalived/check_apiserver.sh
       owner: root
       group: root
       mode: 0755
     notify: Restart keepalived
     when: ansible_os_family == "Debian"

   - name: Create Kubernetes API health check script for RedHat OS family
     template:
       src: check_apiserver.sh.j2
       dest: /usr/libexec/keepalived/check_apiserver.sh
       owner: root
       group: root
       mode: 0755
     notify: Restart keepalived
     when: ansible_os_family == "RedHat"

   - name: Create RKE2 Server health check script for Debian OS family
     template:
       src: check_rke2server.sh.j2
       dest: /etc/keepalived/check_rke2server.sh
       owner: root
       group: root
       mode: 0755
     notify: Restart keepalived
     when: ansible_os_family == "Debian"

   - name: Create RKE2 Server health check script for RedHat OS family
     template:
       src: check_rke2server.sh.j2
       dest: /usr/libexec/keepalived/check_rke2server.sh
       owner: root
       group: root
       mode: 0755
     notify: Restart keepalived
     when: ansible_os_family == "RedHat"

   - name: Create keepalived config file
     template:
       src: keepalived.conf.j2
       dest: /etc/keepalived/keepalived.conf
       owner: root
       group: root
       mode: 0644
     notify: Restart keepalived

   - name: Enable keepalived and make sure it is not masked
     systemd:
       name: keepalived
       enabled: true
       masked: false
     notify: Restart keepalived

   - name: Flush handlers
     meta: flush_handlers

