pendent_relayhost_maps\', value: \'{{ postfix_sender_dependent_relayhost_maps | default("hash:/etc/postfix/sender_access") }}\' }\n       - { name: \'recipient_delimiter\', value: \'{{ postfix_recipient_delimiter | default("+") }}\' }\n\n   - name: Configure postfix (main.cf)\n     template:\n       src: main.cf.j2\n       dest: /etc/postfix/main.cf\n     notify:\n       - Validate postfix\n       - Restart postfix\n\n   - name: Configure postfix (master.cf)\n     template:\n       src: master.cf.j2\n       dest: /etc/postfix/master.cf\n     notify:\n       - Validate postfix\n       - Restart postfix\n\n   - name: Creates cert/key directory\n     file:\n       path: /etc/postfix/certs\n       state: directory\n     when: postfix_tls_cert_file is defined and postfix_tls_key_file is defined\n\n   - name: Deploy Postfix TLS server certificate\n     copy:\n       src: "{{ postfix_tls_cert_file }}"\n       dest: /etc/postfix/certs/postfix.cert\n     notify:\n       - Restart postfix\n     when: postfix_tls_cert_file is defined\n\n   - name: Deploy Postfix TLS server key\n     copy:\n       src: "{{ postfix_tls_key_file }}"\n       dest: /etc/postfix/certs/postfix.key\n       mode: 0600\n     notify:\n       - Restart postfix\n     when: postfix_tls_key_file is defined\n\n   - name: Flush handlers\n     meta: flush_handlers\n\n   - name: Configure aliases\n     template:\n       src: aliases.j2\n       dest: /etc/aliases\n     notify:\n       - New aliases\n\n   - name: Configure sender_access\n     template:\n       src: sender_access.j2\n       dest: /etc/postfix/sender_access\n     notify:\n       - Reload postfix\n\n   - name: Configure recipient_access\n     template:\n       src: recipient_access.j2\n       dest: /etc/postfix/recipient_access\n     notify:\n       - Reload postfix\n\n   - name: Place sasl_password_map\n     copy:\n       content: "{{ postfix_sasl_password_map }}"\n       dest: /etc/postfix/sasl_password_map\n     notify:\n       - Reload postfix\n 