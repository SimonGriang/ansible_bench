---
   - name: Create ssh_key_directory for user
     file:
       path: "{{ ssh_key_directory }}"
       state: directory
       mode: '0700'
     become: false
     delegate_to: localhost
     when: user.manage_ssh_key is defined and user.manage_ssh_key

   - name: Manage user account
     user:
       name: "{{ user.name }}"
       state: "{{ user.state | default('present') }}"
       comment: "{{ user.comment | default(omit) }}"
       createhome: "{{ user.createhome | default(omit) }}"
       password: "{{ user.password | default(omit) }}"
       uid: "{{ user.uid | default(omit) }}"
       group: "{{ user.group | default(omit) }}"
       shell: "{{ user.shell | default(omit) }}"
       expires: "{{ user.expires | default(omit) }}"
     register: user_account

   - name: Set sudo options for user
     template:
       src: sudoers.j2
       dest: "/etc/sudoers.d/{{ user.name }}"
       validate: 'visudo -csf %s'
     loop: "{{ users | selectattr('sudo', 'defined') }}"
     loop_control:
       label: "{{ user.name }}"

   - name: Remove sudo options for user
     file:
       path: "/etc/sudoers.d/{{ user.name }}"
       state: absent
     loop: "{{ users | selectattr('sudo', 'undefined') }}"
     loop_control:
       label: "{{ user.name }}"

   - name: Generate private ssh key for user
     command: "ssh-keygen -t rsa -N '' -f {{ ssh_key_directory }}/id_rsa"
     become: false
     delegate_to: localhost
     when: user.manage_ssh_key is defined and user.manage_ssh_key

   - name: Generate public ssh key for user
     shell: "ssh-keygen -y -f {{ ssh_key_directory }}/id_rsa > {{ ssh_key_directory }}/id_rsa.pub"
     become: false
     delegate_to: localhost
     when: user.manage_ssh_key is defined and user.manage_ssh_key

   - name: Convert ssh key to ppk for user
     command: "ssh-keygen -p -N '' -m PEM -f {{ ssh_key_directory }}/id_rsa -t rsa"
     become: false
     delegate_to: localhost
     when: user.manage_ssh_key is defined and user.manage_ssh_key

   - name: Get or set the home directory for user
     getent:
       database: passwd
       key: "{{ user.name }}"
     register: user_info

   - name: Set the base directory for user
     set_fact:
       base_directory: "{{ user_info.ansible_facts.getent_passwd[user.name][4] if user_info.ansible_facts.getent_passwd[user.name] else '/home' }}"

   - name: Create .ssh directory for user
     file:
       path: "{{ base_directory }}/.ssh"
       state: directory
       mode: '0700'
       owner: "{{ user.name }}"
       group: "{{ user.group | default(omit) }}"
     when: user.manage_ssh_key is defined and user.manage_ssh_key or private_keys is defined

   - name: Deploy authorized keys for user
     authorized_key:
       user: "{{ user.name }}"
       state: present
       key: "{{ item }}"
     loop: "{{ user.authorized_keys }}"

   - name: Remove unauthorized keys for user
     authorized_key:
       user: "{{ user.name }}"
       state: absent
       key: "{{ item }}"
     loop: "{{ user.unauthorized_keys }}"

   - name: Copy generated private ssh key for user
     copy:
       src: "{{ ssh_key_directory }}/id_rsa"
       dest: "{{ base_directory }}/.ssh/id_rsa"
