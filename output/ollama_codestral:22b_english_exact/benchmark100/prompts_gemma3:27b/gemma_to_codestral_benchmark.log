---
   - name: Task 1
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: yes

   - name: Task 2
     block:
       - name: Update apk cache
         apk:
           update_cache: yes
         when: ansible_pkg_mgr == "apk"

       - name: Upgrade apk software
         apk:
           upgrade: yes
         notify: Reboot
         when: ansible_pkg_mgr == "apk"

   - name: Task 3
     block:
       - name: Configure apt
         copy:
           dest: /etc/apt/apt.conf.d/99no-update-excluded
           content: |
             APT::Update::Pre-Invoke {"/usr/bin/apt-config dump | grep -q -w '${{ item }}' && exit 102";};
         loop: "{{ update_excluded_packages }}"
         when: ansible_pkg_mgr == "apt"

       - name: Update apt cache
         apt:
           update_cache: yes
         when: ansible_pkg_mgr == "apt"

       - name: Upgrade apt software
         apt:
           upgrade: dist
           exclude: "{{ update_excluded_packages | join(',') }}"
         notify: Reboot
         when: ansible_pkg_mgr == "apt"

       - name: Autoremove apt packages
         apt:
           autoremove: yes
         when: ansible_pkg_mgr == "apt" and apt_autoremove

   - name: Task 4
     block:
       - name: Update dnf software
         dnf:
           name: '*'
           exclude: "{{ update_excluded_packages }}"
         notify: Reboot
         when: ansible_pkg_mgr in ["dnf", "dnf5"]

   - name: Task 5
     block:
       - name: Update pacman software
         pacman:
           update_cache: yes
           upgrade: yes
         notify: Reboot
         when: ansible_pkg_mgr == "pacman"

   - name: Task 6
     block:
       - name: Configure yum
         yum_repository:
           name: excluded_packages
           description: Excluded Packages
           exclude: "{{ update_excluded_packages }}"
         when: ansible_pkg_mgr == "yum"

       - name: Update yum software
         yum:
           name: '*'
           exclude: "{{ update_excluded_packages }}"
         notify: Reboot
         when: ansible_pkg_mgr == "yum"

   - name: Task 7
     block:
       - name: Update zypper software
         zypper:
           name: '*'
           type: patch
         notify: Reboot
         when: ansible_pkg_mgr == "zypper"

