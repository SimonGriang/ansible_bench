---
   - name: Install Keepalived
     import_tasks: keepalived.yml
     when:
       - ha_mode is enabled
       - inventory_hostname in groups[rke2_servers_group_name]
       - rke2_api_ip is defined

   - name: Download and install RKE2
     import_tasks: rke2.yml
     vars:
       rke2_version: "{{ rke2_version }}"

   - name: CIS Hardening
     import_tasks: cis.yml
     when: rke2_cis_profile is defined and rke2_cis_profile | length > 0

   - name: Find Active Server
     import_tasks: find_active_server.yml

   - name: Enable IPVS kernel module
     modprobe:
       name: ip_vs
       state: present
     when:
       - rke2_kubevip_ipvs_lb_enable
       - inventory_hostname in groups[rke2_servers_group_name]
       - ha_mode is enabled
       - keepalived_used is not defined or not keepalived_used
     lineinfile:
       path: /etc/modules-load.d/ip_vs.conf
       line: ip_vs
       create: yes

   - name: Copy kube-vip manifests to the masternode
     import_tasks: kubevip.yml
     when:
       - ha_mode is enabled
       - rke2_kubevip_ipvs_lb_enable
       - keepalived_used is not defined or not keepalived_used
       - inventory_hostname == groups[rke2_servers_group_name][0]

   - name: Copy ingress-nginx manifests to the masternode
     import_tasks: ingress-nginx.yml
     when:
       - rke2_ingress_nginx_values is defined and rke2_ingress_nginx_values | length > 0
       - inventory_hostname == groups[rke2_servers_group_name][0]

   - name: Prepare very first server node in the cluster
     import_tasks: first_server.yml
     when:
       - inventory_hostname == groups[rke2_servers_group_name][0]
       - (active_server is not defined or active_server is none) or (groups[rke2_cluster_group_name] | length == 1)

   - name: Restore etcd specific tasks
     import_tasks: first_server_restore.yml
     when:
       - active_server is defined
       - (inventory_hostname == active_server or inventory_hostname == groups[rke2_servers_group_name][0])
       - (do_etcd_restore is defined or do_etcd_restore_from_s3 is defined)

   - name: Download kubeconfig to ansible localhost
     import_tasks: download_kubeconfig.yaml
     when:
       - rke2_download_kubeconf
       - inventory_hostname == groups[rke2_servers_group_name][0]

   - name: Prepare and join remaining nodes of the cluster
     import_tasks: remaining_nodes.yml
     when:
       - active_server is defined
       - groups[rke2_cluster_group_name] | length >= 2

   - name: Rolling cordon and drain restart when version changes - servers
     import_tasks: rolling_restart.yml
     vars:
       group_name: rke2_servers_group_name
     when:
       - installed_version is defined
       - installed_version != rke2_version

   - name: Rolling cordon and drain restart when version changes - agents
     import_tasks: rolling_restart.yml
     vars:
       group_name: rke2_agents_group_name
     when:
       - installed_version is defined
       - installed_version != rke2_version
       - inventory_hostname not in groups[rke2_servers_group_name]

   - name: Flush handlers
     meta: flush_handlers

   - name: Rolling restart when config files change
     import_tasks: rolling_restart.yml
     vars:
       group_name: rke2_cluster_group_name
     when: rke2_restart_needed

   - name: Final steps
     import_tasks: summary.yml

