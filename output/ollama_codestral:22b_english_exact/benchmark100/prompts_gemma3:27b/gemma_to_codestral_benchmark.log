      block:
        - name: Configure yum 6
          yum_repository:
            name: yum6
            file: excluded_packages
            exclude: "{{ update_excluded_packages | join(',') }}"
          when: ansible_distribution_major_version == '6'
        - name: Configure yum others
          yum:
            name: '*'
            state: latest
            exclude: "{{ update_excluded_packages | join(',') }}"
            update_cache: true
          notify: Reboot
      when: ansible_pkg_mgr == 'yum'

    - name: Update all software (zypper)
      zypper:
        name: '*'
        state: latest
        type: package
        update_cache: true
      notify: Reboot
      when: ansible_pkg_mgr == 'zypper'

