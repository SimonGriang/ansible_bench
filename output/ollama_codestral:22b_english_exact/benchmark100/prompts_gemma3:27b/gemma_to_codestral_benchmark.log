 - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Install git
     package:
       name: "{{ git_packages }}"
       state: present

   - name: See if the specified user exists
     command: "getent passwd {{ git_username }}"
     ignore_errors: true
     register: user_check
     changed_when: false
     failed_when:
       - user_check.rc != 0
       - not fail_key | default(true)

   - name: Create directory for git configuration
     file:
       path: "/home/{{ git_username }}"
       state: directory
       owner: "{{ git_username }}"
       group: "{{ git_username }}"
       mode: 0700

   - name: Place git configuration
     template:
       src: gitconfig.j2
       dest: "/home/{{ git_username }}/.gitconfig"
       owner: "{{ git_username }}"
       group: "{{ git_username }}"
       mode: 0600

   - name: Create repository_destination
     file:
       path: "{{ git_repository_destination }}"
       state: directory
       owner: "{{ git_username }}"
       group: "{{ git_username }}"
       mode: 0755

   - name: Clone all roles
     git:
       repo: "{{ item.repository_url }}"
       dest: "{{ item.destination_path }}"
       version: "{{ item.version | default('HEAD') }}"
       force: "{{ item.force | default(no) }}"
     become: yes
     become_user: "{{ git_username }}"
     loop: "{{ git_repositories }}"
     loop_control:
       label: "{{ item.destination_path }}"

