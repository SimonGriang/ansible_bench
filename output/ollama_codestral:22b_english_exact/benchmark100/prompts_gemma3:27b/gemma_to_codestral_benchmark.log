---
   - name: Import assert.yml
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Pre-configure debian systems
     debconf:
       name: postfix
       question: postfix/main_mailer_type
       value: "No configuration"
       vtype: string
     when: ansible_os_family == "Debian"

   - name: Install postfix
     package:
       name: postfix
       state: present

   - name: Install postfix-mysql
     package:
       name: postfix-mysql
       state: present
     when:
       - postfix_mysql_virtual_mailbox_maps is defined
       - postfix_mysql_virtual_mailbox_domains is defined

   - name: Configure postfix (transport_maps)
     template:
       src: transport_maps.j2
       dest: /etc/postfix/transport_maps
     notify:
       - Validate postfix
       - Rebuild database
     when: postfix_transport_maps_template is defined

   - name: Configure postfix (header_checks)
     template:
       src: header_checks.j2
       dest: /etc/postfix/header_checks
     notify:
       - Validate postfix
       - Reload postfix
     when: postfix_header_checks_template is defined

   - name: Setting values for main.cf (1/2)
     set_fact:
       postfix_main_cf_config: "{{ postfix_main_cf_config | combine(item) }}"
     with_items:
       - {name: 'mydestination',
          value: '{{ ansible_hostname }}, {{ ansible_fqdn }}'}
       - {name: 'mynetworks',
          value: '127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128'}
     when:
       - item.name not in postfix_main_cf_config
       - item.value is defined

   - name: Setting values for main.cf (2/2)
     set_fact:
       postfix_main_cf_config: >-
         {{ postfix_main_cf_config | combine({
           item.name: item.value
         }) }}
     loop:
       - {name: 'smtpd_relay_restrictions',
          value: '{{ postfix_smtpd_relay_restrictions | default([]) }}'}
       - {name: 'alias_maps',
          value: '{{ postfix_alias_maps | default("hash:/etc/aliases") }}'}
       - {name: 'sender_dependent_relayhost_maps',
          value: >-
            {{ postfix_sender_dependent_relayhost_maps |
            default("hash:/etc/postfix/sender_access") }}
       - {name: 'recipient_delimiter',
          value: '{{ postfix_recipient_delimiter | default("+") }}'}

   - name: Configure postfix (main.cf)
     template:
       src: main.cf.j2
       dest: /etc/postfix/main.cf
     notify:
       - Validate postfix
       - Restart postfix

   - name: Configure postfix (master.cf)
     template:
       src: master.cf.j2
       dest: /etc/postfix/master.cf
     notify:
       - Validate postfix
       - Restart postfix

   - name: Creates cert/key directory
     file:
       path: /etc/postfix/certs
       state: directory
     when:
       - postfix_tls_cert_file is defined
       - postfix_tls_key_file is defined

   - name: Deploy Postfix TLS server certificate
     copy:
       src: "{{ postfix_tls_cert_file }}"
       dest: /etc/postfix/certs/postfix.cert
     notify:
       - Restart postfix
     when: postfix_tls_cert_file is defined

   - name: Deploy Postfix TLS server key
     copy:
       src: "{{ postfix_tls_key_file }}"
       dest: /etc/postfix/certs/postfix.key
       mode: '0600'
     notify:
       - Restart postfix
     when: postfix_tls_key_file is defined

   - name: Flush handlers
     meta: flush_handlers

   - name: Configure aliases
     template:
       src: aliases.j2
       dest: /etc/aliases
     notify:
       - New aliases

   - name: Configure sender_access
     template:
       src: sender_access.j2
       dest: /etc/postfix/sender_access
     notify:
       - Reload postfix

   - name: Configure recipient_access
     template:
       src: recipient_access.j2
       dest: /etc/postfix/recipient_access
     notify:
       - Reload postfix

   - name: Place sasl_password_map
     copy:
       content: "{{ postfix_sasl_password_map }}"
       dest: /etc/postfix/sasl_password_map
     notify:
       - Reload postfix
     when: postfix_sasl_password_map is defined

   - name: Flush handlers again
     meta: flush_handlers

   - name: Start and enable postfix
     service:
       name: postfix
       state: started
       enabled: true


