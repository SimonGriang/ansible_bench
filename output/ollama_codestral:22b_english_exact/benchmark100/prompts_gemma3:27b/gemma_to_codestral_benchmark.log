       mode: '0755'

   - name: Set server taints
     set_fact:
       combined_node_taints: "{{ rke2_server_node_taints }}"
     when: rke2_type == 'server'

   - name: Copy rke2 config
     template:
       src: rke2.yaml.j2
       dest: /etc/rancher/rke2/config.yaml
       owner: root
       group: root
       mode: '0644'
     notify: Config file changed

   - name: Copy kubelet config
     template:
       src: kubelet-config.yaml.j2
       dest: /etc/rancher/rke2/kubelet-config.yaml
       owner: root
       group: root
       mode: '0644'
     notify: Config file changed
     when: rke2_kubelet_config | length > 0

   - name: Copy Containerd Registry Configuration file
     template:
       src: registries.yaml.j2
       dest: /etc/rancher/rke2/registries.yaml
       owner: root
       group: root
       mode: '0644'
     notify: Config file changed
     when: >
       rke2_custom_registry_mirrors | length > 0 or
       rke2_custom_registry_configs | length > 0

   - name: Register if we need to do a etcd restore from file
     set_fact:
       do_etcd_restore: >-
         {{ rke2_etcd_snapshot_file is defined and
         (ansible_facts['services']['rke2-server.service'] is not defined or
         ansible_facts['services']['rke2-server.service']['state'] == 'stopped') }}

   - name: Register if we need to do a etcd restore from s3
     set_fact:
       do_etcd_restore_from_s3: >-
         {{ rke2_etcd_snapshot_file is defined and
         rke2_etcd_snapshot_s3_options is defined and
         rke2_etcd_snapshot_s3_options.access_key is defined and
         rke2_etcd_snapshot_s3_options.secret_key is defined and
         rke2_etcd_snapshot_s3_options.bucket is defined }}

   - name: Restore etcd from file
     block:
       - file:
           path: /var/lib/rancher/rke2/server/db/snapshots
           state: directory
           mode: '0755'
       - copy:
           src: "{{ rke2_etcd_snapshot_file }}"
           dest: /var/lib/rancher/rke2/server/db/snapshots/db.snap
           mode: '0644'
       - command: >-
           rke2 server --etcd-snapshot-restore-wait-time=0
           --etcd-snapshot-restore-timeout=200
           --etcd-restore
     when: do_etcd_restore

   - name: Restore etcd from s3
     command: >-
       rke2 server --etcd-s3
       --etcd-s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }}
       --etcd-s3-endpoint={{ rke2_etcd_snapshot_s3_options.endpoint }}
       --etcd-s3-access-key-id={{ rke2_etcd_snapshot_s3_options.access_key }}
       --etcd-s3-secret-access-key={{ rke2_etcd_snapshot_s3_options.secret_key }}
       --etcd-snapshot-restore-wait-time=0
       --etcd-snapshot-restore-timeout=200
       --etcd-restore
     when: do_etcd_restore_from_s3

   - name: Start RKE2 service on the first server
     systemd:
       name: rke2-server.service
       state: started
       enabled: yes
       daemon_reload: yes
     environment:
       RKE2_TOKEN: "{{ rke2_token }}"
     notify: Service (re)started

   - name: Mask RKE2 agent service on the first server
     systemd:
       name: rke2-agent.service
       masked: yes
       enabled: no

   - name: Wait for the first server be ready - no CNI
     shell: >-
       kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes |
       grep -q 'NotReady'
     register: result
     until: result.rc != 0
     retries: 60
     delay: 10
     changed_when: false

   - name: Wait for the first server be ready - with CNI
     shell: >-
       kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o
       jsonpath='{.items[*].status.conditions[-1].status}' |
       grep -q 'True'
     register: result
     until: result.rc == 0
     retries: 60
     delay: 10
     changed_when: false

   - name: Restore etcd
     block:
       - set_fact:
           registered_nodes: >-
             {{ lookup('k8s', api_version='v1', kind='Node',
             kubeconfig='/etc/rancher/rke2/rke2.yaml') }}
       - set_fact:
           node_names: >-
             {{ registered_nodes.resources | map(attribute='metadata.name') |
             list }}
       - command: >-
           kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete secret
           --namespace kube-system rke2-etcd-snapshot-restore
           ignore_errors: yes
       - command: >-
           kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete cm
           --namespace kube-system rke2-etcd-restore-status
           ignore_errors: yes
       - command: >-
           kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete node
           {{ item }}
           ignore_errors: yes
         with_items: "{{ node_names }}"

   - name: Set an Active Server variable
     set_fact:
       active_server: "{{ inventory_hostname }}"
     delegate_to: "{{ item }}"
     delegate_facts: yes
     loop: "{{ groups[rke2_cluster_group_name] }}"
   

