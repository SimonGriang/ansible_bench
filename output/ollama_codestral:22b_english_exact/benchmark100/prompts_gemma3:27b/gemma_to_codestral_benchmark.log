---
   - name: Check if all variables have been set correctly
     import_tasks: assert.yml
     delegate_to: localhost
     run_once: true

   - name: Wait for host to be reachable
     wait_for:
       port: "{{ ansible_port | default(22) }}"
       host: >-
         {{ ansible_ssh_host |
         default(ansible_host |
         default(inventory_hostname)) }}
       timeout: "{{ bootstrap_timeout }}"
       connect_timeout: "{{ bootstrap_timeout }}"
     connection: local
     become: "{{ bootstrap_become }}"
     when:
       - ansible_connection != 'container'
       - ansible_connection != 'docker'
       - bootstrap_wait_for_host | default(true)

   - name: Prepare the system
     block:
       - name: Wait for connection
         wait_for_connection:
         register: bootstrap_connect

       - name: Debug bootstrap_timeout
         debug:
           var: bootstrap_timeout
         when: bootstrap_connect is failed

       - name: Gather bootstrap facts
         setup:

   - name: Install bootstrap packages
     raw: "{{ bootstrap_install_packages_command }}"
     register: bootstrap_install_packages
     changed_when: >-
       ('Alpine' in ansible_facts['os_family'] and
       bootstrap_install_packages.stdout is search(bootstrap_install_packages_expected_stdout))
       or ('Archlinux' in ansible_facts['os_family'] and
       bootstrap_install_packages.stdout is search(bootstrap_install_packages_expected_stdout))
       or ('Gentoo' in ansible_facts['os_family'] and
       bootstrap_install_packages.stdout is search(bootstrap_install_packages_expected_stdout))
       or ('Debian' not in ansible_facts['os_family'] and
       'RedHat' not in ansible_facts['os_family'] and
       'Rocky' not in ansible_facts['os_family'] and
       'Suse' not in ansible_facts['os_family'] and
       bootstrap_install_packages.stdout is not search(bootstrap_install_packages_expected_stdout))
     become: "{{ bootstrap_become }}"
     when: bootstrap_install_packages_command is defined

   - name: Ensure system is prepared by issuing ansible modules
     block:
       - name: Gather ansible facts
         setup:

       - name: Install packages
         package:
           name: "{{ bootstrap__facts_packages }}"
           state: present
           update_cache: true


