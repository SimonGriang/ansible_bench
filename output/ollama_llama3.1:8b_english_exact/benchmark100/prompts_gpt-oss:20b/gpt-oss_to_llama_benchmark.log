    path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  with_items:
    - name: example

- name: Create ssl csr
  community.crypto.openssl_csr:
    csr_path: "{{ openssl_csr_directory }}/{{ item.name }}.csr"
    key_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    common_name: "{{ item.common_name }}"
    mode: '0644'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  with_items:
    - name: example
      common_name: example.com

- name: Create ssl certificates
  community.crypto.x509_certificate:
    dest: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    provider: 'selfsigned'
    key_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    csr_path: "{{ openssl_csr_directory }}/{{ item.name }}.csr"
    mode: '0644'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  with_items:
    - name: example

- name: Create PKCS#12 file
  community.crypto.openssl_pkcs12:
    dest: "{{ openssl_key_directory }}/{{ item.name }}.p12"
    key_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    cert_path: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    friendly_name: "{{ item.name }}"
    state: 'present'
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  with_items:
    - name: example

- name: Read private key
  ansible.builtin.slurp:
    src: "{{ openssl_key_directory }}/{{ item.name }}.key"
    dest: "openssl_private_key"
  with_items:
    - name: example

- name: Read certificate
  ansible.builtin.slurp:
    src: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    dest: "openssl_certifcate"
  with_items:
    - name: example

- name: Create combined private_key and certificate file
  ansible.builtin.copy:
    content: "{{ openssl_private_key.content|b64decode|trim }}\n{{ openssl_certifcate.content|b64decode|trim }}"
    dest: "{{ openssl_key_directory }}/{{ item.name }}.keycrt"
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  with_items:
    - name: example


