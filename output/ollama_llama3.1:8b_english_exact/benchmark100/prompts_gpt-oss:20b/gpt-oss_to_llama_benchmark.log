---
- name: Include assert.yml for prerequisite checks
  include_tasks: assert.yml
  delegate_to: localhost

- name: Enable redis module stream (RHEL 8)
  become: true
  package:
    name: redis
    state: enabled
  when: ansible_distribution == 'RHEL' and ansible_distribution_major_version == '8'

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: "redis.conf-{{ ansible_distribution }}.j2"
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    mode: "{{ redis_mode }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
  notify: Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


