      uid: "{{ user.uid | default('', true) }}"
      group: "{{ user.group | default('', true) }}"
      groups: "{{ user.groups | default([], true) }}"
      shell: "{{ user.shell | default('', true) }}"
      state: "{{ user.state | default('present', true) }}"
    register: users_manage_user

  - name: Set sudo options for {{ user.name }}
    template:
      src: "sudo.j2"
      dest: "/etc/sudoers.d/{{ user.name | replace('.', 'dot') }}"
      mode: '0640'
    when: user.sudo_options
    notify: sudoers file updated

  - name: Remove sudo options for {{ user.name }}
    file:
      path: "/etc/sudoers.d/{{ user.name | replace('.', 'dot') }}"
      state: absent
    when: not user.sudo_options

  - name: Generate private ssh key for {{ user.name }}
    command:
      cmd: "{{ users_ssh_keygen_command }}"
      chdir: "{{ users_ssh_key_directory }}"
    when: user.manage_ssh_key

  - name: Generate public ssh key for {{ user.name }}
    command:
      cmd: "{{ users_ssh_keygen_pubkey_command }}"
      chdir: "{{ users_ssh_key_directory }}"
    when: user.manage_ssh_key

  - name: Convert ssh key to ppk for {{ user.name }}
    command:
      cmd: "ssh-keygen -e"
      chdir: "{{ users_ssh_key_directory }}"
    when: user.manage_ssh_key

  - name: Get or set the home directory for {{ user.name }}
    shell:
      cmd: "getent passwd {{ user.name }}"
    register: users_home_dir

  - name: Create .ssh directory for {{ user.name }}
    file:
      path: "{{ users_home_base_dir }}/{{ user.name }}/.ssh"
      mode: '0700'
      state: directory
      owner: "{{ user.name }}"
    when: user.manage_ssh_key or user.private_keys
    become: yes
    become_user: "{{ user.name }}"

  - name: Deploy authorized keys for {{ user.name }}
    authorized_key:
      user: "{{ user.name }}"
      key: "{{ item }}"
      state: present
    with_items: "{{ user.authorized_keys | default([], true) }}"
    when: user.authorized_keys

  - name: Remove unauthorized keys for {{ user.name }}
    authorized_key:
      user: "{{ user.name }}"
      key: "{{ item }}"
      state: absent
    with_items: "{{ user.unauthorized_keys | default([], true) }}"
    when: user.unauthorized_keys

  - name: Copy generated private ssh key for {{ user.name }}
