---
- name: Manage user {{ user.name }}
  hosts: localhost
  become: false
  tasks:
  - name: Create local ssh_key_directory for {{ user.name }}
    file:
      path: "{{ users_ssh_key_directory }}"
      mode: '0750'
      state: directory
    when: user.manage_ssh_key is defined and user.manage_ssh_key is true

  - name: Manage user {{ user.name }}
    user:
      name: "{{ user.name }}"
      comment: "{{ user.comment | default('', true) }}"
      home: "{{ users_home_base_dir }}/{{ user.name }}"
      password: "{{ user.password | default('', true) }}"
      uid: "{{ user.uid | default('', true) }}"
      group: "{{ user.group | default('', true) }}"
      groups: "{{ user.groups | default([], true) }}"
      shell: "{{ user.shell | default('', true) }}"
      state: "{{ user.state | default('present', true) }}"
    register: users_manage_user

  - name: Set sudo options for {{ user.name }}
    template:
      src: "sudo.j2"
      dest: "/etc/sudoers.d/{{ user.name | replace('.', 'dot') }}"
      mode: '0640'
    when: user.sudo_options is defined
    notify: sudoers file updated

  - name: Remove sudo options for {{ user.name }}
    file:
      path: "/etc/sudoers.d/{{ user.name | replace('.', 'dot') }}"
      state: absent
    when: user.sudo_options is not defined

  - name: Generate private ssh key for {{ user.name }}
    command:
      cmd: "{{ users_ssh_keygen_command }}"
      chdir: "{{ users_ssh_key_directory }}"
    when: user.manage_ssh_key is defined and user.manage_ssh_key is true

  - name: Generate public ssh key for {{ user.name }}
    command:
      cmd: "{{ users_ssh_keygen_pubkey_command }}"
      chdir: "{{ users_ssh_key_directory }}"
    when: user.manage_ssh_key is true

  - name: Convert ssh key to ppk for {{ user.name }}
    command:
      cmd: "ssh-keygen -e"
      chdir: "{{ users_ssh_key_directory }}"
    when: user.manage_ssh_key is true

  - name: Get or set the home directory for {{ user.name }}
    shell:
      cmd: "getent passwd {{ user.name }}"
    register: users_home_dir

  - name: Create .ssh directory for {{ user.name }}
    file:
      path: "{{ users_home_base_dir }}/{{ user.name }}/.ssh"
      mode: '0700'
      state: directory
      owner: "{{ user.name }}"
    when: user.manage_ssh_key or user.private_keys is defined
    become: yes
    become_user: "{{ user.name }}"

  - name: Deploy authorized keys for {{ user.name }}
    authorized_key:
      user: "{{ user.name }}"
      key: "{{ item }}"
      state: present
    with_items: "{{ user.authorized_keys | default([], true) }}"
    when: user.authorized_keys is defined

  - name: Remove unauthorized keys for {{ user.name }}
    authorized_key:
      user: "{{ user.name }}"
      key: "{{ item }}"
      state: absent
    with_items: "{{ user.unauthorized_keys | default([], true) }}"
    when: user.unauthorized_keys is defined

  - name: Copy generated private ssh key for {{ user.name }}
    copy:
      content: "{{ lookup('file', '{{ users_ssh_key_directory }}/{{ user.name }}') }}"
      dest: "{{ users_home_base_dir }}/{{ user.name }}/.ssh/id_rsa"
      mode: '400'
      owner: "{{ user.name }}"
    when: users_manage_user is defined and user.copy_private_key is true

  - name: Check users password valid time for {{ user.name }}
    shell:
      cmd: "awk -v uid={{ user.uid }} '{ if ($1 == uid) { print $4 } }' /etc/shadow"
    register: users_pw_valid
    when: user.state is not defined or user.state is 'present'

  - name: Set users password valid time for {{ user.name }}
    shell:
      cmd: "chage -M {{ user.password_validity_days }} {{ user.name }}"
    when: users_pw_valid | changed
    when: user.password_validity_days is defined

  - name: Place private key file for {{ user.name }}
    file:
      path: "{{ users_home_base_dir }}/{{ user.name }}/.ssh/{{ item.name }}"
      content: "{{ item.content }}"
      mode: '400'
      owner: "{{ user.name }}"
    with_items: "{{ user.private_keys | default([], true) }}"
    when: user.private_keys is defined

