---
- name: Import assert.yml
  include: assert.yml

- name: Install requirements
  apt:
    name: bash
    state: present

- name: Install openjdk java (package)
  apt:
    name: "{{ java_openjdk_package }}"
    state: present
  when: java_vendor == "openjdk"
  become: yes
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM
  block:
    - name: Copy Oracle Java RPM file
      copy:
        content: "{{ lookup('file', java_package) }}"
        dest: "/tmp/{{ java_package }}"
        mode: '0640'
    - name: Install the copied RPM file
      apt:
        deb: "/tmp/{{ java_package }}"
        state: present
  when:
    - java_source == "local"
    - java_format == "rpm"

- name: Install DEB
  block:
    - name: Copy Oracle Java DEB file
      copy:
        content: "{{ lookup('file', java_package) }}"
        dest: "/tmp/{{ java_package }}"
        mode: '0640'
    - name: Install the copied DEB file
      apt:
        deb: "/tmp/{{ java_package }}"
        state: present
  when:
    - java_source == "local"
    - java_format == "deb"

- name: Install oracle java (rpm) (repository)
  apt:
    name: "{{ java_oracle_package }}"
    state: present
  when:
    - java_source == "repository"
    - java_format == "rpm"

- name: Configure oracle targz
  block:
    - name: Ensure the directory exists
      file:
        path: "{{ java_install_directory }}"
        state: directory
        mode: '0755'
    - name: Unarchive the Oracle Java tar.gz package
      unarchive:
        src: "{{ java_oracle_package }}"
        dest: "{{ java_install_directory }}"
        mode: '0755'
  when:
    - java_format == "targz"
    - java_vendor == "oracle"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "jce_policy-8.zip"
    dest: "{{ java_install_directory }}"
    mode: '0755'
  when:
    - java_jce is true
    - java_version == 8
    - java_vendor == "oracle"

- name: Set alternative (targz)
  file:
    src: "{{ java_install_directory }}/{{ java_oracle_directory }}/bin/java"
    dest: "/usr/bin/java"
    state: link
  when:
    - java_format == "targz"
    - ansible_distribution != "Alpine"
    - java_vendor == "oracle"

- name: Find JAVA_HOME
  shell:
    cmd: "readlink -f /usr/bin/java | xargs dirname | xargs dirname | xargs dirname | xargs dirname | xargs dirname | xargs dirname | xargs dirname | xargs dirname | xargs dirname | xargs dirname"
    chdir: ~
    creates: /etc/profile.d/java_home.sh
    executable: /bin/bash
    args:
      chdir: ~
      creates: /etc/profile.d/java_home.sh
  register: java_home
  run_once: yes
  become: yes

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    dest: /etc/profile.d/java_home.sh
    regexp: '^export JAVA_HOME='
    line: "export JAVA_HOME={{ java_home.stdout }}"
    state: present
    mode: '0644'
  become: yes


