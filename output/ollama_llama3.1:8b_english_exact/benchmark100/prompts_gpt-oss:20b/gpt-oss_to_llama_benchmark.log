---
- name: Java | Check if certificates exists
  stat:
    path: '{{ item.java_cert_path }}'
  with_items:
    - java_certs
  register: check_java_certs

- name: Java | Fail if some cert doesn't exist
  fail:
    msg: "Certificate {{ item.java_cert_path }} does not exist."
  with_items:
    - check_java_certs.results
  when: item.stat.exists == false

- name: Java | Setting keystore variables in java < 11
  set_fact:
    java_keystore_dir: 'java_keystore_dir_old'
  when: java_open_jdk_version_major < 11 and (java_keystore_dir is defined and java_keystore_dir != None)

- name: Java | Setting keystore variables in java >= 11
  set_fact:
    java_keystore_dir: 'java_keystore_dir_new'
  when: java_open_jdk_version_major >= 11 and (java_keystore_dir_new is defined and java_keystore_dir_new != None)

- name: Java | Import SSL certificates
  java_cert:
    cert: '{{ item.java_cert_path }}'
    keystore_file: '{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts'
    keystore_pass: '{{ java_cert_keystore_pass }}'
    state: present
    keystore_create: true
    alias: '{{ item.java_cert_alias }}'
  with_items:
    - java_certs

