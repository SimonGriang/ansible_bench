    when: rke2_wait_for_all_pods_to_be_ready | bool

  - name: Wait for all pods to pass readiness checks
    shell:
      cmd: "{{ rke2_data_path }}/kubectl wait --kubeconfig={{ rke2_data_path }}/etc/rancher/rke2/rke2.yaml --timeout=10m --for condition=Ready pod --all -- {{ rke2_wait_for_all_pods_to_be_healthy_args }}"
      args:
        executable: /bin/bash
    retries: 100
    delay: 15
    until: success
    run_once: yes
    delegate_to: "{{ active_server if active_server is defined else groups[rke2_servers_group_name][0] }}"
    when: rke2_wait_for_all_pods_to_be_healthy | bool

