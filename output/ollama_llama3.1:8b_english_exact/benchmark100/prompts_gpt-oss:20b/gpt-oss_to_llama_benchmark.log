content='```yml\n---\n- name: Execute tasks for setting and getting bootstrap facts\n  tasks:\n  - name: Get bootstrap facts\n    ansible.builtin.raw:\n      cmd: cat /etc/os-release\n      check_mode: false\n      become: false\n    register: bootstrap_facts\n    changed_when: false\n\n  - name: Set bootstrap facts (I)\n    ansible.builtin.set_fact:\n      bootstrap_distribution: \'\'\n      bootstrap_distribution_major_version: \'\'\n    when:\n      - bootstrap_facts.rc == 0\n      - bootstrap_distribution is not defined\n      - bootstrap_facts.stdout.match(bootstrap__search[bootstrap_distribution] | default(bootstrap_distribution))\n    become: true\n    become_user: bootstrap_become_user\n    with_items: "{{ dict2items | map(attribute=\'value\') | flatten }}"\n\n  - name: Set bootstrap facts (II)\n    ansible.builtin.set_fact:\n      bootstrap_os_family: \'\'\n    become: true\n    become_user: bootstrap_become_user\n    with_dict: bootstrap__os_family_map\n    loop_control:\n      label: "{{ item.key }}"\n    when: bootstrap_distribution is defined\n    loop: "{{ dict2items | map(attribute=\'value\') | flatten }}"\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-17T04:30:39.593918676Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2383848602, 'load_duration': 124679494, 'prompt_eval_count': 614, 'prompt_eval_duration': 142015180, 'eval_count': 254, 'eval_duration': 2115611736, 'model_name': 'llama3.1:8b'} id='run--1d7d4f8e-896f-4988-8ada-b0f26720a4db-0' usage_metadata={'input_tokens': 614, 'output_tokens': 254, 'total_tokens': 868}
