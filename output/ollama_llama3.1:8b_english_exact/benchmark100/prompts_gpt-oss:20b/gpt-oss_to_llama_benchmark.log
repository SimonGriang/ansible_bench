  - name: Place private key file for {{ user.name }}
    file:
      path: "{{ users_home_base_dir }}/{{ user.name }}/.ssh/{{ item.name }}"
      content: "{{ item.content }}"
      mode: '400'
      owner: "{{ user.name }}"
    with_items: "{{ user.private_keys | default([], true) }}"
    when: user.private_keys

