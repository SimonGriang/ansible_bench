---
- name: Remove externally managed from Debian 12
  import_tasks: debian12.yml
  when: ansible_distribution == 'Debian' and ansible_major_version >= 12

- name: Ensure Pip is installed
  package:
    name: "{{ pip_package }}"

- name: Ensure packaging is available via dnf
  package:
    name: python3-packaging

- name: Ensure pip_install_packages are installed
  pip:
    name: "{{ item }}"
    version: "{{ item_version }}"
    virtualenv: "{{ item_virtualenv }}"
    state: "{{ item_state }}"
    extra_args: "{{ item_extra_args }}"
    executable: "{{ pip_executable }}"
  loop: "{{ pip_install_packages }}"
  loop_control:
    loop_var: item


