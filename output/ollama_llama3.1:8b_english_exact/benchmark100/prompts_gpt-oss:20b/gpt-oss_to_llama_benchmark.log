- name: Create docroot
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    mode: '0755'
    state: directory
  loop: "{{ httpd_vhosts | selectattr('documentroot', 'defined') | selectattr('create_docroot', 'undefined') | selectattr('documentroot') }}"
  when: httpd_vhosts is defined and item.documentroot is defined and (item.create_docroot is not defined or item.create_docroot)

- name: Configure vhosts
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Enable vhosts
  ansible.builtin.command:
    cmd: a2ensite {{ item.name }}
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian'
  notify:
    - Test httpd configuration validity
    - Restart httpd


