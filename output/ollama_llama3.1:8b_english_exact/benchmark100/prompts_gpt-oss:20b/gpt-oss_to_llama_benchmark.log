---
- name: Configure MySQL
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install MySQL
  package:
    name: "{{ item }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec
  loop: "{{ mysql_packages }}"

- name: Configure MySQL Server
  community.general.ini_file:
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    mode: '0644'
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
  notify:
    - Restart mysql server
  loop: "{{ mysql_configuration_options | map(attribute='option') }}"

- name: Configure MySQL Client
  community.general.ini_file:
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    mode: '0644'
    section: 'client'
    option: 'socket'
    value: "{{ mysql_socket }}"
    state: present

- name: Initialize MySQL
  command: "{{ mysql_initialize_command }}"
  when:
    - not '/var/lib/mysql/mysql' exists
    - ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and Enable MySQL
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush Handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create Databases
  community.mysql.mysql_db:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    target: "{{ item.target | default('/') }}"
    encoding: "{{ item.encoding | default('utf8') }}"
    collation: "{{ item.collation | default('utf8_general_ci') }}"
  no_log: true
  loop: "{{ mysql_databases | default([]) }}"
  when: mysql_databases is defined

- name: Create Users
  community.mysql.mysql_user:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
    name: "{{ item.name }}"
    state: 'present'
    password: "{{ item.password | default('') }}"
    privileges: "{{ item.privileges | default('') }}"
    host: "{{ item.host | default('') }}"
    host_all: "{{ item.host_all | default(false) }}"
    update_password: "{{ item.update_password | default(false) }}"
  no_log: true
  loop: "{{ mysql_users | default([]) }}"
  when: mysql_users is defined

- name: Flush Handlers Again
  meta: flush_handlers

