---
- name: Tasks
  hosts: localhost
  become: true

  tasks:
  - name: Include assertion tasks
    include_tasks: assert.yml
    delegate_to: localhost

  - name: Install python pip packages
    ansible.builtin.package:
      name: "{{ item }}"
      state: present
    loop: "{{ python_pip_packages }}"

  - name: Configure pip proxy
    ansible.builtin.copy:
      content: |
        [global]
        index-url = {{ python_pip_proxy }}
      dest: /etc/pip.conf
      mode: '0644'
    when: python_pip_proxy is defined

  - name: Trust hosts
    ansible.builtin.lineinfile:
      path: /etc/pip.conf
      line: "trusted-host = {{ python_pip_trusted_host }}"
      state: present
      mode: '0644'
    when: python_pip_trusted_host is defined

  - name: Update pip
    ansible.builtin.pip:
      name: "{{ python_pip_pip_package }}"
      state: "{{ python_pip_pip_state }}"
      executable: "{{ python_pip_executable }}"
    when:
      - python_pip_update
      - not (ansible_distribution_release in ['bookworm', 'noble'])
      - not (ansible_os_family == 'Alpine')

  - name: Install requested modules
    ansible.builtin.pip:
      name: "{{ item.name }}"
      state: "{{ item.state | default('present') }}"
      version: "{{ item.version | default(None) }}"
      executable: "{{ python_pip_executable }}"
    loop: "{{ python_pip_modules }}"
    when:
      - not (ansible_distribution_release in ['bookworm', 'noble'])
      - not (ansible_os_family == 'Alpine')


