l_count': 788, 'prompt_eval_duration': 157144969, 'eval_count': 405, 'eval_duration': 3782240876, 'model_name': 'llama3.1:8b'} id='run--06164ff1-fb3b-4e15-9fa7-67e5caaad743-0' usage_metadata={'input_tokens': 788, 'output_tokens': 405, 'total_tokens': 1193}
