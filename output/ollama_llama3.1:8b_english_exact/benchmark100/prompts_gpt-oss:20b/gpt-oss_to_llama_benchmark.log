ion': 4023563711, 'load_duration': 136584583, 'prompt_eval_count': 761, 'prompt_eval_duration': 136823684, 'eval_count': 453, 'eval_duration': 3749379825, 'model_name': 'llama3.1:8b'} id='run--89d9a7d7-521b-4f6e-9a17-ae42c1346298-0' usage_metadata={'input_tokens': 761, 'output_tokens': 453, 'total_tokens': 1214}
