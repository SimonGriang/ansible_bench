---
- name: Configure GRUB settings
  tasks:
  - name: Get efi path
    stat:
      path: /sys/firmware/efi/efivars/
    register: grub_efi

  - name: Remove unwanted grub.cfg on EFI systems
    file:
      path: /boot/grub2/grub.cfg
      state: absent
    when: grub_efi.stat.exists

  - name: Install user template
    template:
      src: templates/01_users.j2
      dest: /etc/grub.d/01_users
      owner: root
      group: root
      mode: '0700'
    notify: Update grub

  - name: EFI | add password
    lineinfile:
      dest: /etc/grub2-efi.cfg
      line: "password_pbkdf2 {{ grub_user }} <hash>"
      insertafter: 'EOF'
      regexp: '^password_pbkdf2 {{ grub_user }} '
    when: grub_efi.stat.exists
    notify: Update grub

  - name: MBR | add password
    lineinfile:
      dest: /etc/grub2.cfg
      line: "password_pbkdf2 {{ grub_user }} <hash>"
      insertafter: 'EOF'
      regexp: '^password_pbkdf2 {{ grub_user }} '
    when: grub_efi.stat.exists
    notify: Update grub

  - name: Add --unrestricted
    replace:
      path: "{{ item }}"
      regexp: '^CLASS="(((?!--unrestricted).)*)"$'
      replace: 'CLASS="\1 --unrestricted"'
    with_items: "{{ grub_password_unrestricted_files }}"
    when: grub_password_unrestricted
    notify: Update grub


