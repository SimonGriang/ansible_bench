---
- name: Create RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  when: rke2_kubelet_config != ''
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  when:
    - rke2_custom_registry_mirrors != ''
    - rke2_custom_registry_configs != ''
  notify: Config file changed

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when:
    - rke2_etcd_snapshot_file != ''
    - rke2_server.service != ''

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file != ''
    - rke2_etcd_snapshot_s3_options != ''
    - rke2_etcd_snapshot_s3_options.access_key != ''
    - rke2_etcd_snapshot_s3_options.secret_key != ''
    - rke2_etcd_snapshot_s3_options.bucket != ''
    - rke2_etcd_snapshot_s3_options.snapshot_name != ''

- name: Restore etcd from file
  block:
    - name: Create snapshot directory
      file:
        path: "{{ rke2_etcd_snapshot_destination_dir }}"
        state: directory
    - name: Copy etcd snapshot
      copy:
        content: "{{ lookup('file', rke2_etcd_snapshot_source_dir + '/' + rke2_etcd_snapshot_file) }}"
        dest: "{{ rke2_etcd_snapshot_destination_dir }}/{{ rke2_etcd_snapshot_file }}"
    - name: Run rke2 server
      command:
        cmd: rke2 server --cluster-reset --cluster-reset-restore-path="{{ rke2_etcd_snapshot_destination_dir }}/{{ rke2_etcd_snapshot_file }}" --token="{{ rke2_token }}"
  when: do_etcd_restore

- name: Restore etcd from s3
  command:
    cmd: rke2 server --cluster-reset --etcd-s3 --bucket="{{ rke2_etcd_snapshot_s3_options.bucket }}" --access-key="{{ rke2_etcd_snapshot_s3_options.access_key }}" --secret-key="{{ rke2_etcd_snapshot_s3_options.secret_key }}" --endpoint="{{ rke2_etcd_snapshot_s3_options.endpoint }}" --region="{{ rke2_etcd_snapshot_s3_options.region }}" --endpoint-ca="{{ rke2_etcd_snapshot_s3_options.endpoint_ca }}" --folder="{{ rke2_etcd_snapshot_s3_options.folder }}" --skip-ssl-verify="{{ rke2_etcd_snapshot_s3_options.skip_ssl_verify }}" --token="{{ rke2_token }}"
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  service:
    name: rke2-server.service
    state: started
    enabled: yes
  notify: Service (re)started
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent.service
    state: masked
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Wait for the first server be ready - no CNI
  uri:
    url: "http://{{ rke2_node_name }}:{{ rke2_port }}"
    method: GET
    headers:
      Authorization: Bearer "{{ rke2_token }}"
    body_format: json
    body: "kubectl get node '{{ rke2_node_name }}'"
    return_content: yes
  register: node_info
  until: node_info.json | length >= 2
  retries: 100
  delay: 15
  when:
    - not check_mode
    - rke2_cni == 'none'

- name: Wait for the first server be ready - with CNI
  uri:
    url: "http://{{ rke2_node_name }}:{{ rke2_port }}"
    method: GET
    headers:
      Authorization: Bearer "{{ rke2_token }}"
    body_format: json
    body: "kubectl get nodes | grep '{{ rke2_node_name }}'"
    return_content: yes
  register: node_info
  until: node_info.json | length >= 2
  retries: 40
  delay: 15
  when:
    - not check_mode
    - rke2_cni != 'none'

- name: Restore etcd
  block:
    - name: Get registered nodes
      uri:
        url: "http://{{ rke2_node_name }}:{{ rke2_port }}"
        method: GET
        headers:
          Authorization: Bearer "{{ rke2_token }}"
        body_format: json
        body: "kubectl get nodes --no-headers"
        return_content: yes
      register: nodes
    - name: Get all node names from inventory
      set_fact:
        all_nodes: "{{ hostvars | map('extract', 'ansible_hostname') | list }}"
    - name: Delete old node-password secrets
      uri:
        url: "http://{{ rke2_node_name }}:{{ rke2_port }}"
        method: DELETE
        headers:
          Authorization: Bearer "{{ rke2_token }}"
        body_format: json
        body: "kubectl delete secret kubernetes.io/kubelet-node-{{ item }} 2>/dev/null"
        return_content: yes
      loop: "{{ all_nodes }}"
    - name: Delete old node objects
      uri:
        url: "http://{{ rke2_node_name }}:{{ rke2_port }}"
        method: DELETE
        headers:
          Authorization: Bearer "{{ rke2_token }}"
        body_format: json
        body: "kubectl delete node {{ item }} 2>/dev/null"
        return_content: yes
      loop: "{{ all_nodes }}"
  when: do_etcd_restore or do_etcd_restore_from_s3

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ groups[rke2_cluster_group_name][0] }}"
  delegate_facts: true


