---
- name: Ensure user configuration
  tasks:
  - name: Import assert.yml
    ansible.builtin.import_tasks: assert.yml
    delegate_to: localhost

- name: Install required software
  tasks:
  - name: Install required software
    ansible.builtin.package:
      name: "{{ item }}"
      state: present
    loop: "{{ users_requirements }}"
    when: users_requirements | length > 0

- name: Ensure groups are created
  tasks:
  - name: Ensure groups are created
    ansible.builtin.include_tasks: group.yml
    loop: "{{ users_groups }}"
    loop_control:
      label: "{{ group }}"
      loop_var: group
    when: users_groups is defined

- name: Ensure /etc/sudoers.d directory is included
  tasks:
  - name: Ensure /etc/sudoers.d directory is included
    ansible.builtin.lineinfile:
      dest: /etc/sudoers
      regexp: '^#?includedir\s+etc\/sudoers\.d\s*(<|$)'
      line: 'includedir /etc/sudoers.d'
    notify: visudo

- name: Ensure users are created
  tasks:
  - name: Ensure users are created
    ansible.builtin.include_tasks: user.yml
    loop: "{{ users }}"
    loop_control:
      label: "{{ user }}"
      loop_var: user
    when: users is defined

- name: Manage cron permission
  tasks:
  - name: Manage cron permission
    ansible.builtin.template:
      src: cron.allow.j2
      dest: /etc/cron.allow
      mode: '0644'
    when: users_cron_allow

- name: Remove /etc/cron.allow if not required
  tasks:
  - name: Remove /etc/cron.allow if not required
    ansible.builtin.file:
      path: /etc/cron.allow
      state: absent
    when: not users_cron_allow

