---
- name: RKE2 playbook tasks
  tasks:
  - name: Cordon and Drain the node {{ rke2_node_name }}
    shell:
      cmd: "{{ rke2_data_path }}/kubectl cordon --kubeconfig={{ rke2_data_path }}/etc/rancher/rke2/rke2.yaml {{ rke2_node_name }} && {{ rke2_data_path }}/kubectl drain --kubeconfig={{ rke2_data_path }}/etc/rancher/rke2/rke2.yaml {{ rke2_node_name }} {{ rke2_drain_additional_args }}"
      args:
        executable: "/bin/bash"
      register: drain
      retries: 100
      delay: 15
      until: drain.stdout.find("drained") >= 0
      run_once: yes
      delegate_to: "{{ active_server if active_server is defined else groups[rke2_servers_group_name][0] }}"

  - name: Restart RKE2 service on {{ rke2_node_name }}
    service:
      name: "{{ rke2_service_name }}"
      state: restarted
    notify: Service (re)started

  - name: Wait for all nodes to be ready again
    shell:
      cmd: "{{ rke2_data_path }}/kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type==\"Ready\")].status}' | wc -l"
      args:
        executable: "/bin/bash"
      register: all_ready_nodes
      retries: 100
      delay: 15
      until: all_ready_nodes.stdout == str(len(groups[rke2_cluster_group_name]))
      run_once: yes
      delegate_to: "{{ active_server if active_server is defined else groups[rke2_servers_group_name][0] }}"

  - name: Uncordon the node {{ rke2_node_name }}
    shell:
      cmd: "{{ rke2_data_path }}/kubectl uncordon --kubeconfig={{ rke2_data_path }}/etc/rancher/rke2/rke2.yaml {{ rke2_node_name }}"
      args:
        executable: "/bin/bash"
    when: rke2_drain_node_during_upgrade == true
    run_once: yes
    delegate_to: "{{ active_server if active_server is defined else groups[rke2_servers_group_name][0] }}"

  - name: Wait for all pods to be ready again
    shell:
      cmd: "{{ rke2_data_path }}/kubectl get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded --ignore-not-found -o jsonpath='{.items[*].metadata.name}' | wc -l"
      args:
        executable: "/bin/bash"
      register: all_pods_ready
      retries: 100
      delay: 15
      until: all_pods_ready.stdout == "0"
      run_once: yes
      delegate_to: "{{ active_server if active_server is defined else groups[rke2_servers_group_name][0] }}"
    when: rke2_wait_for_all_pods_to_be_ready == true

  - name: Wait for all pods to pass readiness checks
    shell:
      cmd: "{{ rke2_data_path }}/kubectl wait --kubeconfig={{ rke2_data_path }}/etc/rancher/rke2/rke2.yaml --timeout=10m --for condition=Ready pod --all -- {{ rke2_wait_for_all_pods_to_be_healthy_args }}"
      args:
        executable: "/bin/bash"
    retries: 100
    delay: 15
    until: success
    run_once: yes
    delegate_to: "{{ active_server if active_server is defined else groups[rke2_servers_group_name][0] }}"
    when: rke2_wait_for_all_pods_to_be_healthy == true

