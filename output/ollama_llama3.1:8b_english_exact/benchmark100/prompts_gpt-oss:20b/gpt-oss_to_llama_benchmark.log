    set_fact:
      java_jdk_vendor: "temurin"
    when: java_jdk_vendor == "adoptopenjdk"

- name: Java | Gather OS specific variables
  tasks:
  - name: Include the OS-specific variable file located at `{{ java_jdk_vendor }}/{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml` using `with_first_found`
    include_tasks: "{{ java_jdk_vendor }}/{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
    when: java_jdk_vendor is defined

- name: Java | Gather architecture specific variables
  tasks:
  - name: Include the architecture-specific variable file `architecture.yml` using `with_first_found`
    include_tasks: "architecture.yml"
    when: java_jdk_vendor is defined

- name: Java | Setting OS specific variables (I)
  tasks:
  - name: Use `set_fact` to override OS-specific variables with either the already-defined value or the default `__` prefixed variable
    set_fact:
      java_open_jdk_version_major: "{{ java_open_jdk_version_major | default('__java_open_jdk_version_major') }}"
      java_required_repositories_openjdk: "{{ java_required_repositories_openjdk | default('__java_required_repositories_openjdk') }}"
      java_required_key_repositories_openjdk: "{{ java_required_key_repositories_openjdk | default('__java_required_key_repositories_openjdk') }}"
      java_required_libs_openjdk: "{{ java_required_libs_openjdk | default('__java_required_libs_openjdk') }}"
      java_deprecated_repositories_adoptopenjdk: "{{ java_deprecated_repositories_adoptopenjdk | default('__java_deprecated_repositories_adoptopenjdk') }}"

- name: Java | Setting OS and architecture specific variables (II)
  tasks:
  - name: Use `set_fact` to override `java_open_jdk_home_dir` and `java_open_jdk_package` with either the already-defined value or the default `__` prefixed variable
    set_fact:
      java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('__java_open_jdk_home_dir') }}"
      java_open_jdk_package: "{{ java_open_jdk_package | default('__java_open_jdk_package') }}"

- name: Java | Setting specific variables
  tasks:
  - name: Set the fact `java_home` to the value of `java_open_jdk_home`
    set_fact:
      java_home: "{{ java_open_jdk_home }}"

- name: Java | Debian pre-requisites
  when: ansible_os_family == 'Debian'
  block:
  - name: Remove deprecated repositories
    apt_repository:
      name: "{{ item }}"
      state: absent
    loop: "{{ java_deprecated_repositories_adoptopenjdk | default([]) }}"

  - name: Install extra apt tools
    package:
      name: "{{ item }}"
      state: present
      retry: yes
      retryable: yes
    loop: "{{ java_open_jdk_apt_extra_packages | default([]) }}"

  - name: Add required key repositories
    apt_key:
      url: "{{ item }}"
      state: present
    loop: "{{ java_required_key_repositories_openjdk | default([]) }}"

  - name: Add required repositories
    apt_repository:
      name: "{{ item }}"
      state: present
      update_cache: yes
    loop: "{{ java_required_repositories_openjdk | default([]) }}"

- name: Java | RedHat pre-requisites
  when: ansible_os_family == 'RedHat'
  block:
  - name: Add required key repositories
    rpm_key:
      state: present
      key: "{{ item }}"
    loop: "{{ java_required_key_repositories_openjdk | default([]) }}"

  - name: Add required repositories
    yum_repository:
      name: "{{ item.name }}"
      description: "{{ item.description }}"
      file: "{{ item.file }}"
      baseurl: "{{ item.baseurl }}"
      gpgcheck: "{{ item.gpgcheck }}"
      enabled: yes
    loop: "{{ java_required_repositories_openjdk | default([]) }}"

- name: Java | Install required libs
  tasks:
  - name: Install the packages listed in `java_required_libs_openjdk` using `package`, retrying until `java_required_libs_installed` succeeds
    package:
      name: "{{ item }}"
      state: present
      retry: yes
      retryable: yes
    loop: "{{ java_required_libs_openjdk | default([]) }}"

- name: Java | Install Java, Debian
  when: ansible_os_family == 'Debian'
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
    cache_valid_time: 3600
    version: "{{ java_open_jdk_version | default('') }}"
    retry: yes
    retryable: yes

- name: Java | Install Java, RedHat
  when: ansible_os_family == 'RedHat'
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present
    cache_valid_time: 3600
    version: "{{ java_open_jdk_version | default('') }}"
    retry: yes
    retryable: yes

- name: Java | Export environment variables
  tasks:
  - name: Deploy the JDK environment script from the template `jdk.sh.j2` to `/etc/profile.d/jdk.sh` with mode `0755`, owned by `root`
    template:
      src: templates/jdk.sh.j2
      dest: /etc/profile.d/jdk.sh
      mode: '0755'
      owner: root

- name: Java | Source environment variables
  tasks:
  - name: Source `/etc/profile` in a shell to apply the newly created environment variables, marked to skip ansible-lint
    shell: source /etc/profile
    skip_ansible_lint: yes

- name: Java | Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  when: (ansible_os_family == 'Debian') and (java_open_jdk_version_major < 11)
  alternatives:
    name: java
    path: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java

- name: Java | Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  when: (ansible_os_family == 'Debian') and (java_open_jdk_version_major >= 11)
  alternatives:
    name: java
    path: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java

