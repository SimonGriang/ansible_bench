      - name: Copy local installation script to remote
        copy:
          content: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
          dest: "{{ rke2_install_script_dir }}/rke2.sh"
          mode: '0700'
          force: true

  - name: Copy local RKE2 artifacts
    copy:
      content: "{{ item }}"
      dest: "{{ rke2_artifact_path }}/{{ item }}"
      mode: '0640'
      force: true
    loop: "{{ rke2_artifact | list }}"
    when: rke2_airgap_mode and rke2_airgap_implementation == 'copy'

  - name: Airgap mode – additional images tarballs
    block:
      - name: Create directory for additional images
        file:
          path: "{{ rke2_tarball_images_path }}"
          state: directory
          mode: '0700'

      - name: Copy additional images tarballs
        copy:
          content: "{{ item }}"
          dest: "{{ rke2_tarball_images_path }}/{{ item }}"
          mode: '0644'
          force: true
        loop: "{{ rke2_airgap_copy_additional_tarballs }}"

    when: rke2_airgap_mode and rke2_airgap_implementation != 'exists' and rke2_airgap_copy_additional_tarballs | length > 0

  - name: Airgap mode – ensure artifacts exist and have acceptable permissions
    block:
      - name: Stat RKE2 artifacts
        stat:
          path: "{{ rke2_artifact_path }}/{{ item }}"
          register: artifacts
        loop: "{{ rke2_artifact | list }}"

      - name: Stat RKE2 installation script
        stat:
          path: "{{ rke2_install_script_dir }}/rke2.sh"
          register: install_script

      - name: Set writable artifacts fact
        set_fact:
          artifacts_writeable: "{{ artifacts.results | map(attribute='stat.mode') | list | sort | first > 0400 }}"

      - name: Make artifacts read-only
        file:
          path: "{{ rke2_artifact_path }}/{{ item }}"
          mode: '0640'
          state: touch
        loop: "{{ rke2_artifact | list }}"

      - name: Make installation script executable
        file:
          path: "{{ rke2_install_script_dir }}/rke2.sh"
          mode: '0700'
          state: touch

    when: rke2_airgap_mode and rke2_airgap_implementation == 'exists'

  - name: Populate service facts
    service_facts:
      enabled: true

  - name: Get stats of the FS object
    stat:
      path: "/usr/local"
      register: usr_local

  - name: Check if separate partition
    shell:
      cmd: 'grep "/usr/local " /proc/mounts'
      register: partition_result
      changed: no
    failed_when: partition_result.rc >= 2

  - name: Set RKE2 bin path
    set_fact:
      rke2_bin_path: "{{ '/usr/local/bin/rke2' if usr_local.stat.permissions[0] | int < 7 else '/opt/rke2/bin/rke2' if partition_result.rc == 1 else '/usr/local/bin/rke2' }}"

  - name: Check RKE2 version
    shell:
      cmd: "{{ rke2_bin_path }} --version"
      register: versions_check
      changed: no

  - name: Set RKE2 versions
    set_fact:
      installed_version: "{{ versions_check.stdout | regex_findall('([0-9.]+)') | first }}"
      running_version: "{{ versions_check.stdout | regex_findall('([0-9.]+)') | last }}"
    when: not ansible_check_mode

  - name: Prevent accidental RKE2 downgrade
    assert:
      that: (installed_version | version >= running_version) or rke2_allow_downgrade
      msg: "RKE2 downgrade detected: {{ running_version_clean }} -> {{ rke2_version_clean }} (allow downgrade: {{ rke2_allow_downgrade | bool }})"
    when: not ansible_check_mode and rke2_version != 'not installed' and not rke2_allow_downgrade

  - name: Run RKE2 install script
    block:
      - name: Run installation script
        shell:
          cmd: "{{ rke2_install_script_dir }}/rke2.sh"
          environment:
            INSTALL_RKE2_ARTIFACT_PATH: "{{ rke2_artifact_path }}"
            INSTALL_RKE2_AGENT_IMAGES_DIR: "{{ rke2_tarball_images_path }}"
            INSTALL_RKE2_METHOD: "{{ rke2_airgap_mode | bool | ternary('airgap', 'default') }}"
          when: rke2_airgap_mode
      - name: Run installation script
        shell:
          cmd: "{{ rke2_install_script_dir }}/rke2.sh"
          environment:
            INSTALL_RKE2_VERSION: "{{ rke2_version }}"
            INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"
            INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"
            INSTALL_RKE2_METHOD: "{{ rke2_airgap_mode | bool | ternary('airgap', 'default') }}"
          when: not rke2_airgap_mode
    when: not ansible_check_mode and installed_version != running_version

  - name: Copy Custom Manifests
    template:
      src: "rke2_manifests.j2"
      dest: "{{ rke2_data_path }}/server/manifests/{{ item }}"
      owner: "root"
      group: "root"
      mode: "0644"
    loop: "{{ rke2_custom_manifests | list }}"
    when: rke2_custom_manifests | length > 0

  - name: Copy Static Pods
    copy:
      content: "{{ item }}"
      dest: "{{ rke2_data_path }}/agent/pod-manifests/{{ item }}"
      owner: "root"
      group: "root"
      mode: "0644"
    loop: "{{ rke2_static_pods | list }}"
    when: rke2_static_pods | length > 0

  - name: Copy RKE2 environment file
    template:
      src: "rke2_environment.j2"
      dest: "/etc/default/rke2-{{ rke2_type }}"
      owner: "root"
      group: "root"
      mode: "0644"
    when: rke2_environment_options | length > 0

