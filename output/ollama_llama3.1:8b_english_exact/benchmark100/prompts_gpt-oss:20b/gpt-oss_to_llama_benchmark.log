  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map_content is defined

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: yes

- name: Start and enable postfix
  ansible.builtin.service:
    name: "{{ postfix_service }}"
    state: started
    enabled: yes

