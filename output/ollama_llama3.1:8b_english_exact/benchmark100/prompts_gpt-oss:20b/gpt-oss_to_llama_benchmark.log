---
- name: Vault Configuration Tasks
  hosts: 
  become: true
  tasks:

  - name: Create Vault group
    ansible.builtin.group:
      name: "{{ vault_group }}"
      system: true

  - name: Create Vault user
    ansible.builtin.user:
      name: "{{ vault_user }}"
      create_home: false
      system: true
      shell: "{{ vault_user_shell }}"
      group: "{{ vault_group }}"

  - name: Create Vault download directory
    ansible.builtin.file:
      path: "{{ vault_download_path }}"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '0755'
      state: directory

  - name: Download Vault binary
    ansible.builtin.unarchive:
      src: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
      dest: "{{ vault_download_path }}"
      remote_src: true
      extra_opts: ['--strip-components=1']
    when: vault_download_path != '/'

  - name: Check if vault_path exists
    ansible.builtin.stat:
      path: "{{ vault_path }}"
    register: vault_check_path

  - name: Create vault_path if it does not exist
    ansible.builtin.file:
      path: "{{ vault_path }}"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '0755'
      state: directory
    when: vault_check_path.stat.exists is false and vault_path | length > 0

  - name: Create directory in vault_path
    ansible.builtin.file:
      path: "{{ item.path }}"
      owner: "{{ item.owner }}"
      group: "{{ item.group }}"
      mode: "{{ item.mode }}"
    loop: "{{ vault_directories }}"
    loop_control:
      loop_var: item

  - name: Create data directory
    ansible.builtin.file:
      path: "{{ item.path }}"
      owner: "{{ item.owner }}"
      group: "{{ item.group }}"
      mode: "{{ item.mode }}"
    loop: "{{ vault_data_directories }}"
    loop_control:
      loop_var: item

  - name: Generate TLS key and certificate
    ansible.builtin.command:
      cmd: "openssl req -x509 -newkey rsa:4096 -nodes -keyout '{{ vault_data_directory }}/tls/tls.key' -out '{{ vault_data_directory }}/tls/tls.crt' -days 365 -subj '/CN=vault'"
    notify: Restart vault
    when: not vault_data_directory | found_in_path

  - name: Set ownership of tls material
    ansible.builtin.file:
      path: "{{ item.path }}"
      owner: "{{ item.owner }}"
      group: "{{ item.group }}"
      mode: "{{ item.mode }}"
    loop: "{{ vault_tls_files }}"
    loop_control:
      loop_var: item

  - name: Copy Vault binary
    ansible.builtin.copy:
      content: "{{ lookup('file', '{{ vault_download_path }}/vault') }}"
      dest: "{{ vault_path }}/usr/bin/vault"
      owner: root
      group: root
      mode: '0755'
      remote_src: true
    notify: Restart vault

  - name: Set cap_ipc_lock=ep on /usr/bin/vault
    community.general.capabilities:
      path: "{{ vault_path }}/usr/bin/vault"
      capabilities: cap_ipc_lock+ep
      changed_when: false

  - name: Touch vault.env
    ansible.builtin.file:
      path: "{{ vault_path }}/etc/vault.d/vault.env"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '0644'
      state: touch
    notify: Restart vault

  - name: Create /usr/lib/systemd/system
    ansible.builtin.file:
      path: "/usr/lib/systemd/system"
      owner: root
      group: root
      mode: '0755'

  - name: Copy Vault service file
    ansible.builtin.template:
      src: "vault.service.j2"
      dest: "/usr/lib/systemd/system/vault.service"
      owner: root
      group: root
      mode: '0644'
    notify: Daemon reload
    when: ansible_service_mgr == "systemd"

  - name: Copy vault configuration
    ansible.builtin.copy:
      content: "{{ lookup('file', 'vault.hcl') }}"
      dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
      owner: root
      group: root
      mode: '0644'
    notify: Restart vault

  - name: Flush handlers
    ansible.builtin.meta:
      flush_handlers: false

