---
- name: Install HashiCorp products
  import_tasks: assert.yml

- name: Install HashiCorp products using package
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ hashicorp_products }}"
  when: hashicorp_products is defined

- name: Install latest HashiCorp products using package
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ hashicorp_products }}"
  when: hashicorp_products is defined and not hashicorp_products_version

- name: Install versioned HashiCorp products using package
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
    version: "{{ hashicorp_products_version[item] }}"
  loop: "{{ hashicorp_products }}"
  when: hashicorp_products is defined and hashicorp_products_version is defined

- name: Install HashiCorp products manually
  ansible.builtin.unarchive:
    src: "{{ hashicorp_src[item] }}"
    dest: "{{ hashicorp_destination }}"
    group: "{{ hashicorp_group }}"
    mode: "{{ hashicorp_mode }}"
    owner: "{{ hashicorp_owner }}"
    remote_src: true
  loop: "{{ hashicorp_products }}"
  when: hashicorp_products is defined

- name: Install repository for RedHat
  ansible.builtin.get_url:
    url: "{{ hashicorp_repo_url }}"
    dest: "{{ hashicorp_repo_path }}"
  when: ansible_os_family == 'RedHat' or ansible_os_family == 'Rocky'

- name: Configure Debian
  become: true
  ansible.builtin.apt:
    state: present
    repo: "{{ hashicorp_repo_url }}"
  when: ansible_os_family == 'Debian'

- name: Install gpg package for Debian
  ansible.builtin.apt:
    name: gpg
    state: present
  when: ansible_os_family == 'Debian'

- name: Install apt key for Debian
  ansible.builtin.apt_key:
    keyserver: hkp://keyserver.ubuntu.com
    state: present
    id: hashicorp_gpg_key
    validate_certs: false
  when: ansible_os_family == 'Debian'

- name: Install repository for Debian
  ansible.builtin.apt_repository:
    repo: "{{ hashicorp_repo_url }}"
    state: present
    arches: "{{ hashicorp_arches }}"
    dist: "{{ hashicorp_dist }}"
  when: ansible_os_family == 'Debian'

