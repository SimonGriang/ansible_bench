---
- name: Tasks to configure services
  import_tasks: assert.yml
  delegate_to: localhost

  tasks:
  - name: Install required packages
    ansible.builtin.package:
      name: "{{ service_required_packages }}"
      notify: Gather facts

  - name: Configure systemd service
    ansible.builtin.template:
      src: systemd.j2
      dest: /etc/systemd/system/{{ item.name }}.service
      mode: '0644'
    loop: "{{ service_list }}"
    loop_control:
      label: "{{ item.name }}"
    when: ansible_service_mgr == "systemd"
    notify: Systemctl daemon-reload

  - name: Configure sysvinit service
    ansible.builtin.template:
      src: sysvinit.j2
      dest: /etc/init.d/{{ item.name }}
      mode: '0755'
    loop: "{{ service_list }}"
    loop_control:
      label: "{{ item.name }}"
    when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]

  - name: Manage service
    ansible.builtin.service:
      name: "{{ item.name }}"
      state: "{{ item.state | default('started') }}"
      enabled: "{{ item.enabled | default(false) }}"
    loop: "{{ service_list }}"
    loop_control:
      label: "{{ item.name }}"
    when: item.state is defined or item.enabled is defined

  - name: Flush handlers
    ansible.builtin.meta:
      flush_handlers: yes


