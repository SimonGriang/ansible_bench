content='---\n\n\n---\n- name: Check if python is installed\n  ansible.builtin.command:\n    cmd: which python\n    register: python_executable\n    ignore_errors: yes\n    changed_when: false\n\n- name: Check if python3 is installed\n  ansible.builtin.command:\n    cmd: which python3\n    register: python3_executable\n    ignore_errors: yes\n    changed_when: false\n\n- name: Debug Python executable path\n  ansible.builtin.debug:\n    var: python_executable.stdout\n\n- name: Debug Python3 executable path\n  ansible.builtin.debug:\n    var: python3_executable.stdout\n\n- name: Import assert.yml\n  ansible.builtin.import_tasks:\n    file: assert.yml\n    run_once: true\n    delegate_to: localhost\n\n- name: Install requirements\n  ansible.builtin.package:\n    name: "{{ openssl_requirements }}"\n    state: present\n\n- name: Ensure packaging is available via dnf\n  ansible.builtin.package:\n    name: python3-packaging\n    state: present\n\n- name: Install pip packages\n  ansible.builtin.pip:\n    name: "{{ openssl_pip_packages }}"\n    state: present\n\n- name: Create key directory\n  ansible.builtin.file:\n    path: "{{ openssl_key_directory }}"\n    mode: \'750\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n    state: directory\n\n- name: Create csr directory\n  ansible.builtin.file:\n    path: "{{ openssl_csr_directory }}"\n    mode: \'755\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n    state: directory\n\n- name: Create crt directory\n  ansible.builtin.file:\n    path: "{{ openssl_crt_directory }}"\n    mode: \'755\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n    state: directory\n\n- name: Include create.yml\n  ansible.builtin.include_tasks:\n    file: create.yml\n  loop:\n    - "{{ openssl_items }}"\n  loop_control:\n    label: item.name\n  when: openssl_items is defined and openssl_items | length > 0' additional_kwargs={} response_metadata={'model': 'lla