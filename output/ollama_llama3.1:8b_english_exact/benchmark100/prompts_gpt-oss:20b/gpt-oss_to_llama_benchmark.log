---
- name: Main tasks
  tasks:
  - name: Import assert.yml
    ansible.builtin.import_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Wait for port to be available
    ansible.builtin.wait_for:
      host: '{{ ansible_host }}'
      port: 22
      timeout: '{{ bootstrap_timeout }}'
    when:
      - ansible_connection is defined
      - not ansible_connection.is_container
      - bootstrap_wait_for_host

  - block:
      - name: Test connection
        ansible.builtin.wait_for_connection:
          timeout: '{{ bootstrap_timeout }}'
        register: bootstrap_connect
        never: true

      - name: Test sudo
        ansible.builtin.command:
          cmd: 'sudo --version'
          creates: /dev/null
        never: true

    rescue:
      - name: Gather bootstrap facts
        ansible.builtin.include_tasks: gather_facts.yml

      - name: Install bootstrap packages (raw)
        ansible.builtin.raw:
          cmd: '{{ bootstrap_install.raw }}'
          executable: /bin/sh
          register: bootstrap_install_packages
          changed_when:
            - bootstrap_install_packages.stdout is search('package installed')
            - ansible_distribution in ['Fedora', 'RedHat']

      - name: Ensure libdnf5 is present on Fedora/RedHat
        ansible.builtin.raw:
          cmd: 'dnf install -y python3-libdnf5'
          executable: /bin/sh
        when: ansible_distribution in ['Fedora', 'RedHat']

  - name: Gather ansible facts
    ansible.builtin.setup:
      filter: 'all'
      gather_subset: ['all']
    become: false

  - name: Install bootstrap packages (package)
    ansible.builtin.package:
      name: '{{ item }}'
      state: present
      update_cache: true
      become: true
    loop: '{{ bootstrap_facts_packages.split() }}'


