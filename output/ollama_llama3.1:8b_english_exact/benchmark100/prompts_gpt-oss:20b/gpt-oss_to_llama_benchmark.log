        loop: "{{ rke2_artifact | list | reject('search', 'sha256sum') }}"
      - name: Download local RKE2 installation script
        get_url:
          url: "{{ rke2_install_bash_url }}"
          dest: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
          mode: '0700'
