---
- name: Create RKE2 manifests directory
  file:
    path: "{{ rke2_data_path }}/server/manifests"
    state: directory
    owner: root
    group: root
    mode: '0700'

- name: Copy kube-vip files to first server
  template:
    src: "templates/kube-vip/kube-vip.yml.j2"
    dest: "{{ rke2_data_path }}/server/manifests/kube-vip.yml"
    owner: root
    group: root
    mode: '0644'
  delegate_to: first_server

- name: Copy kube-vip files to first server (part 2)
  template:
    src: "templates/kube-vip/kube-vip-rbac.yml.j2"
    dest: "{{ rke2_data_path }}/server/manifests/kube-vip-rbac.yml"
    owner: root
    group: root
    mode: '0644'
  delegate_to: first_server

- name: Copy kube-vip load balancer manifests to first server
  template:
    src: "templates/kube-vip/kube-vip-cloud-{{ item }}.j2"
    dest: "{{ rke2_data_path }}/server/manifests/kube-vip-cloud-{{ item | replace('.j2', '') }}"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ rke2_kubevip_cloud_providers | map('regex_replace', '^.*\\.', '') | list }}"
  when: rke2_kubevip_cloud_provider_enable | bool
  delegate_to: first_server


