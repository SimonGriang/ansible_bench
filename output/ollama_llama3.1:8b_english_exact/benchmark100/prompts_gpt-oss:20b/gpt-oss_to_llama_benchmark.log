--- 

- name: Check if Helm binary exists
  stat:
    path: '{{ helm_bin_path }}'
  register: helm_check

- name: Check Helm version
  command:
    cmd: '{{ helm_bin_path }} version'
    chdir: /tmp
  register: helm_existing_version
  failed_when: False
  changed_when: False

- name: Download helm
  unarchive:
    src: '{{ helm_repo_path }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz'
    dest: /tmp
    remote_src: true
    mode: 0755
  when: not helm_check.stat.exists or not helm_existing_version.stdout.find(helm_version)
  register: helm_download

- name: Copy helm binary into place
  copy:
    content: '{{ item }}'
    dest: '{{ helm_bin_path }}'
    mode: 0755
    remote_src: true
  loop: '/tmp/{{ helm_platform }}-{{ helm_arch }}/helm/helm'
  become: true
  when: helm_download is changed

