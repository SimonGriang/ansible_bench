---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
    run_once: true
    delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    section: 'mysqld'
    option: "{{ item.option }}"
    value: "{{ item.value }}"
  loop:
    - option: 'bind-address'
      value: '127.0.0.1'
    - option: 'skip-networking'
      value: 'off'
  notify: Restart mysql server

- name: Configure mysql client
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    option: socket
    value: "{{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']
  become: true
  block:
    - stat:
        path: /var/lib/mysql/mysql
        state: directory
      when: not stat.exists
      become: true

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  community.mysql.mysql_db:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
    login_unix_socket: "{{ mysql_socket }}"
    name: "{{ item.name }}"
    state: present
    target: mysql
    encoding: "{{ item.encoding }}"
    collation: "{{ item.collation }}"
    skip_locked: true
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined
  no_log: true
  when: not item.initial_import

- name: List databases
  community.mysql.mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
    login_unix_socket: "{{ mysql_socket }}"
    filter: 'databases'
  register: mysql_info
  no_log: true

