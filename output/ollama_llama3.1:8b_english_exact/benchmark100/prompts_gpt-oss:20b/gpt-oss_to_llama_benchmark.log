---
- name: Task 1: check if all variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2: wait for host (when configured)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ bootstrap_ssh_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
    become: "{{ bootstrap_become }}"
    become_user: "{{ bootstrap_become_user }}"
  when:
    - not bootstrap_connection_type in ['container', 'docker']
    - bootstrap_wait_for_host
  delegate_to: localhost

- name: Task 3: prepare system
  block:
    - name: Test connection to host
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: wait_for_connection_result
      until: wait_for_connection_result.success
      changed_when: false

  rescue:
    - name: Output debug message if connection test fails
      debug:
        msg: "Connection test failed with timeout {{ bootstrap_timeout }}"
      changed: true

  always:
    - name: Include gather_facts.yml task file
      include_tasks: gather_facts.yml

    - name: Run raw shell commands
      shell:
        cmd: "{{ item }}"
        executable: /bin/sh
        register: raw_output
        changed_when: raw_output.stdout != ''
      loop: "{{ bootstrap_install.raw }}"
      until: raw_output.stdout == ''
      changed: true
      when: raw_output.stdout != ''

- name: Task 4: ensure system is prepared by issuing ansible modules
  block:
    - name: Gather Ansible facts
      setup:
        gather_subset: all

    - name: Install bootstrap packages
      package:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ bootstrap__facts_packages }}"
      become: "{{ bootstrap_become }}"
      become_user: "{{ bootstrap_become_user }}"


