--- 

- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: Check if specified user exists
  ansible.builtin.getent:
    database: passwd
    name: "{{ git_username }}"
    register: getent_passwd
  when: git_username is defined
  fail_key: false

- name: Create directory for git configuration
  ansible.builtin.file:
    path: /home/{{ git_username }}
    mode: '0755'
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
  when: getent_passwd[git_username] is defined and getent_passwd[git_username] != 'none'

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: /home/{{ git_username }}/.gitconfig
    mode: '0644'
  when: git_user_email is defined and git_user_name is defined and git_username is defined and getent_passwd[git_username] != 'none'

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ git_repository_destination }}"
    mode: '0750'
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
  when: git_username is defined and git_repository_destination is defined and getent_passwd[git_username] != 'none'

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ item.dest }}"
    dest: "{{ git_repository_destination }}/{{ item.dest }}"
    accept_hostkey: true
    version: "{{ item.version | default('HEAD') }}"
    force: "{{ item.force | default(git_force) }}"
  loop: "{{ git_repositories }}"
  loop_control:
    label: "{{ item.dest }}"
  become: true
  become_user: "{{ git_username }}"
  when: git_repositories is defined and git_repository_destination is defined and git_username is defined and getent_passwd[git_username] != 'none'

