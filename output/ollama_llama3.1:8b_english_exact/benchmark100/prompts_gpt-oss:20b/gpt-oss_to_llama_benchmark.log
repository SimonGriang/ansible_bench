---
- name: Create docroot
  become: yes
  delegate_to: localhost
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - (create_docroot is not defined or create_docroot is true)
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  loop_control:
    loop_var: item

- name: Configure vhosts
  become: yes
  delegate_to: localhost
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd
  loop: "{{ httpd_vhosts }}"
  loop_control:
    loop_var: item


