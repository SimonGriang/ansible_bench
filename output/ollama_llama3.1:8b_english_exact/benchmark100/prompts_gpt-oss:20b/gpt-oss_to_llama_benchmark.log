---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    name: postfix/main_mailer_type
    value: "No configuration"
    state: present

- name: Install postfix
  ansible.builtin.package:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present
  when: (postfix_virtual_mailbox_maps | regex_search('mysql')) or (postfix_virtual_mailbox_domains | regex_search('mysql')) or (postfix_virtual_alias_maps | regex_search('mysql'))

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: postfix_transport_maps_template
    dest: /etc/postfix/transport
    mode: '0644'
  notify:
    - Validate configuration
    - Rebuild transport_maps database
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: postfix_header_checks_template
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
    - Validate configuration
    - Reload postfix
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    _postfix_smtpd_recipient_restrictions_check_recipient_access: "{{ postfix_recipient_access | default(false) }}"
    _postfix_smtpd_sender_restrictions_check_sender_access: "{{ postfix_sender_access | default(false) }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    _postfix_mynetworks: "{{ postfix_mynetworks | default('127.0.0.0/8') }}"
    _postfix_mydestination: "{{ postfix_mydestination | default('localhost') }}"
    _postfix_relay_domains: "{{ postfix_relay_domains | default([]) | join(',') }}"
    _postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default('reject_invalid_helo_hostname') }}"
    _postfix_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default('reject_invalid_helo_hostname') }}"
    _postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default([]) | join(',') }}"
    _postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains | default([]) | join(',') }}"

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - Validate configuration
    - Restart postfix

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - Validate configuration
    - Restart postfix

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ postfix_smtpd_tls_cert_file | dirname }}"
    state: directory
    mode: '0700'
  when: postfix_smtpd_tls_cert_file is defined and postfix_smtpd_tls_key_file is defined

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    content: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0600'
    owner: "{{ postfix_smtpd_tls_cert_file_user | default('postfix') }}"
    group: "{{ postfix_smtpd_tls_cert_file_group | default('postfix') }}"
  notify:
    - Reload postfix
  when: postfix_smtpd_tls_cert_file_source is defined

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    content: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0600'
    owner: "{{ postfix_smtpd_tls_key_file_user | default('postfix') }}"
    group: "{{ postfix_smtpd_tls_key_file_group | default('postfix') }}"
  notify:
    - Reload postfix
  when: postfix_smtpd_tls_key_file_source is defined

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: yes

- name: Configure aliases
  ansible.builtin.lineinfile:
    dest: "{{ postfix_alias_path }}"
    line: "{{ item.name }}: {{ item.destination }}"
    state: present
  with_items: "{{ postfix_aliases }}"
  notify:
    - Rebuild alias database
    - Reload postfix

- name: Configure sender_access
  ansible.builtin.lineinfile:
    dest: "{{ postfix_sender_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    state: present
  with_items: "{{ postfix_sender_access }}"
  notify:
    - Rebuild sender_access database
    - Reload postfix

- name: Configure recipient_access
  ansible.builtin.lineinfile:
    dest: "{{ postfix_recipient_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    state: present
  with_items: "{{ postfix_recipient_access }}"
  notify:
    - Validate configuration
    - Rebuild recipient_access database
    - Reload postfix

- name: Place sasl_password_map
  ansible.builtin.copy:
    content: "{{ postfix_smtp_sasl_password_map_content }}"
    dest: "{{ postfix_smtp_sasl_password_map }}"
    mode: '0600'
    owner: "{{ postfix_smtp_sasl_password_map_user | default('postfix') }}"
    group: "{{ postfix_smtp_sasl_password_map_group | default('postfix') }}"
  notify:
    - Rebuild sasl_password_map database
  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map is not empty

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: yes

- name: Start and enable postfix
  ansible.builtin.service:
    name: "{{ postfix_service }}"
    state: started
    enabled: yes


