ration': 9921948480, 'model_name': 'llama3.1:8b'} id='run--5dfe7bc3-ac7b-430c-b344-ee9cb80812fc-0' usage_metadata={'input_tokens': 2469, 'output_tokens': 916, 'total_tokens': 3385}
