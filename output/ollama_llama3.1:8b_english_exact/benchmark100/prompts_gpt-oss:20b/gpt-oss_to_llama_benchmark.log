---
- name: Import assert.yml
  include_tasks:
    file: assert.yml
    run_once: true
    delegate_to: localhost

- name: Install prerequisites
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ vault_prerequisites }}"

- name: Include installation method specific tasks
  include_tasks:
    file: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  lineinfile:
    dest: /etc/vault.d/vault.env
    regexp: '^{{ item.name }}$'
    line: "{{ item.name }}={{ item.value }}"
    state: present
    create: true
    mode: '0644'
  notify: Restart vault
  loop: "{{ vault_environment_settings }}"

- name: Include hardening tasks
  include_tasks: hardening.yml

- name: Start and enable vault
  service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"

- name: Enable vault
  service:
    name: vault
    state: enabled
  when: vault_type != "oss"


