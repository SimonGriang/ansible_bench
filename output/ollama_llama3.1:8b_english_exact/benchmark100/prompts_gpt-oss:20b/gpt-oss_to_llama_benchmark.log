---

- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
    run_once: true
    delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    section: 'mysqld'
  loop:
    - option: 'bind-address'
      value: '127.0.0.1'
    - option: 'skip-networking'
      value: 'off'
  notify: Restart mysql server

- name: Configure mysql client
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    option: socket
    value: "{{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']
  become: true
  block:
    - stat:
        path: /var/lib/mysql/mysql
        state: directory
      when: not stat.exists
      become: true

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  community.mysql.mysql_db:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined
  no_log: true
  loop_control:
    loop_var: item
  when: item.initial_import != true

- name: List databases
  community.mysql.mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
    login_unix_socket: "{{ mysql_socket }}"
    filter: 'databases'
  register: mysql_info
  no_log: true

- name: Import database
  community.mysql.mysql_db:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
    login_unix_socket: "{{ mysql_socket }}"
    name: "{{ item.name }}"
    state: import
    target: mysql
    target_file: "{{ item.initial_import }}"
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined and item.initial_import is defined and mysql_info.databases is not defined

- name: Create users
  community.mysql.mysql_user:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"
  when: mysql_users is defined
  no_log: true
  loop_control:
    loop_var: item

- name: Flush handlers again
  meta: flush_handlers

- name: Ensure an empty line at the end of the file
  lineinfile:
    path: /dev/null
    line: ''


