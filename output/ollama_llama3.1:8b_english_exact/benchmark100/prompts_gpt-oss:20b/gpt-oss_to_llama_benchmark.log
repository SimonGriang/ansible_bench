---
- name: Configure GRUB settings
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: yes

- name: Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    dest: /etc/default/grub
    regexp: '^GRUB_TIMEOUT'
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: yes
    mode: '0664'
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    dest: /etc/default/grub
    regexp: '^GRUB_RECORDFAIL_TIMEOUT'
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: yes
    mode: '0664'
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  replace:
    dest: /etc/default/grub
    regexp: "^(GRUB_CMDLINE_LINUX='([^']*)')$"
    replace: "\1\2 {{ option }}= {{ value }}"
    group: 0
    validate: "/bin/sh -c '[[ `grep -q ^{{ option }}= {{ value }} $REGEX_MATCH ` ]] || echo {{ option }}= {{ value }} >> /etc/default/grub' && /bin/sh -c 'grep -q ^{{ option }}= {{ value }} /etc/default/grub || echo {{ option }}= {{ value }} >> /etc/default/grub'"
    mode: '0664'
  loop:
    item: "{{ grub_options | zip_longest(grub_options | map('split', '=')) | list }}"
    when: grub_options is defined and grub_options | length > 0

- name: Import password.yml
  import_tasks: password.yml
  when: grub_set_password

- name: Flush handlers
  meta: flush_handlers


