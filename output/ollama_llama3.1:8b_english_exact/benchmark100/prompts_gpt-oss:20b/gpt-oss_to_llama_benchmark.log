---
- name: Configure rsyslog
  tasks:
  - name: Import assert.yml
    ansible.builtin.import_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Uninstall conflicting systemd-logger
    ansible.builtin.package:
      name: systemd-logger
      state: absent

  - name: Install rsyslog
    ansible.builtin.package:
      name: "{{ item }}"
      state: "{{ rsyslog_package_state }}"
    loop: "{{ rsyslog_packages }}"
    loop_control:
      loop_var: item

  - name: Install additional rsyslog packages
    ansible.builtin.package:
      name: "rsyslog-{{ item }}"
      state: "{{ rsyslog_package_state }}"
    loop: "{{ rsyslog_features }}"
    loop_control:
      loop_var: item

  - name: Configuring default rsyslog
    ansible.builtin.template:
      src: "{{ rsyslog_config_file_format }}_rsyslog.conf.j2"
      dest: "{{ rsyslog_dest_conf_file }}"
      mode: '0644'
    when: rsyslog_deploy_default_config == true
    notify: Restart rsyslog

  - name: Make configuration directory
    ansible.builtin.file:
      path: /etc/rsyslog.d/
      state: directory
      mode: '0755'

  - name: Configuring rsyslog forward rule
    ansible.builtin.template:
      src: forward_rule.conf.j2
      dest: "/etc/rsyslog.d/{{ rsyslog_forward_rule_name }}.conf"
      mode: '0644'
    when: not rsyslog_deploy_default_config
    notify: Restart rsyslog

  - name: Configuring additional config files
    ansible.builtin.copy:
      content: "{{ item.value.content | default('') }}"
      dest: "/etc/rsyslog.d/{{ item.key }}.conf"
      mode: '0440'
      validate: "{{ 'rsyslogd -N1 -f %s' if item.value.validate else 'true %s' }}"
      owner: root
      group: root
    loop: "{{ rsyslog_rsyslog_d_files.items }}"
    loop_control:
      loop_var: item
    when: item.value.state == 'present'
    notify: Restart rsyslog

  - name: Start and enable rsyslog
    ansible.builtin.service:
      name: "{{ rsyslog_service }}"
      state: started
      enabled: yes

