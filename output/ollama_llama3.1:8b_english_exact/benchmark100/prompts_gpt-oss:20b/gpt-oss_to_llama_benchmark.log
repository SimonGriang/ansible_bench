---

- name: Task 1: Assert usage of systemd as an init system
  assert:
    that: ansible_service_mgr == 'systemd'
    fail_msg: 'This module only works with systemd'

- name: Task 2: Get latest release
  uri:
    url: 'https://api.github.com/repos/grafana/loki/releases/latest'
    method: GET
    status_code: 200
    return_content: true
    body_format: json
    validate_certs: false
    headers:
      Authorization: "Bearer {{ GH_TOKEN }}"
    retryable_status_codes:
      - 200
    retry: 5
    register: _latest_release
    env:
      ANSIBLE_DEBUG: '{{ ANSIBLE_DEBUG }}'

- name: Task 3: Set promtail version to {{ _latest_release.json.tag_name[1:] }}
  set_fact:
    promtail_version: '{{ _latest_release.json.tag_name[1:] }}'
  when: promtail_version == 'latest'
  delegate_to: localhost
  run_once: true

- name: Task 4: Test if zip local archive exists
  stat:
    path: '{{ promtail_binary_local_dir }}/{{ promtail_version }}_promtail-linux-{{ go_arch }}.zip'
    register: promtail_binary_local_archive
  when: promtail_binary_local_dir != ''
  delegate_to: localhost
  run_once: true

- name: Task 5: Assert local binary exists
  assert:
    that: promtail_binary_local_archive.stat.exists
    fail_msg: "When using 'promtail_binary_local_dir' please ensure that the binary exists"
  when: promtail_binary_local_dir != ''

- name: Task 6: Get checksum list
  set_fact:
    __promtail_checksums: "{{ lookup('url', 'https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/SHA256SUMS', wantlist=True) | list }}"
  when: promtail_binary_local_dir == ''

- name: Task 7: Get checksum for {{ go_arch }} architecture
  set_fact:
    __promtail_checksum: '{{ item.split(" ")[0] }}'
  loop:
    - '{{ __promtail_checksums }}'
  when: promtail_binary_local_dir == ''


