---
- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify:
    - Service (re)started

- name: Wait for all nodes to be ready again
  ansible.builtin.shell:
    cmd: '{{ rke2_data_path }}/bin/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes --field-selector=status.phase=Ready | wc -l'
    delegate_to: "{{ active_server if active_server is defined else groups[rke2_servers_group_name][0] }}"
    run_once: true
    retries: 100
    delay: 15
    until: item.stdout == str(len(groups[rke2_cluster_group_name]))
  register: all_ready_nodes
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  ansible.builtin.shell:
    cmd: '{{ rke2_data_path }}/bin/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get pods --all-namespaces -o jsonpath='{.items[*].status.phase != "Running" && .items[*].status.phase != "Succeeded"}' | wc -l'
    delegate_to: "{{ active_server if active_server is defined else groups[rke2_servers_group_name][0] }}"
    run_once: true
    retries: 100
    delay: 15
    until: item.stdout == '0'
  register: all_pods_ready
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready


