---
- name: Install Keepalived when HA mode is enabled
  include: keepalived.yml
  when:
    - rke2_api_ip is defined
    - inventory_hostname in groups[rke2_servers_group_name]
    - rke2_ha_mode is true
    - rke2_ha_mode_keepalived is true

- name: Download and install RKE2 {{ rke2_version }}
  include: rke2.yml

- name: CIS Hardening
  include: cis.yml
  when:
    - rke2_cis_profile has length > 0

- name: Find Active Server
  include: find_active_server.yml

- name: Enable IPVS kernel module
  community.general.modprobe:
    name: ip_vs
    state: present
    persistent: present
  when:
    - rke2_kubevip_ipvs_lb_enable is true
    - inventory_hostname in groups[rke2_servers_group_name]
    - rke2_ha_mode is true
    - rke2_ha_mode_kubevip is true
    - not rke2_ha_mode_keepalived

- name: Copy kube-vip manifests to the masternode
  include: kubevip.yml
  when:
    - inventory_hostname == groups[rke2_servers_group_name][0]
    - rke2_ha_mode is true
    - rke2_ha_mode_kubevip is true
    - not rke2_ha_mode_keepalived

- name: Copy ingress-nginx manifests to the masternode
  include: ingress-nginx.yml
  when:
    - rke2_ingress_nginx_values is defined and has length > 0

- name: Prepare very first server node in the cluster
  include: first_server.yml
  when:
    - inventory_hostname == groups[rke2_servers_group_name][0]
    - (active_server is not defined or (active_server is defined and (groups[rke2_servers_group_name] | length == 1)))

- name: Restore etcd specific tasks
  include: first_server_restore.yml
  when:
    - active_server is defined
    - (inventory_hostname == active_server or inventory_hostname == groups[rke2_servers_group_name][0])
    - (do_etcd_restore or do_etcd_restore_from_s3 is defined)

- name: Download kubeconfig to ansible localhost
  include: download_kubeconfig.yaml
  when:
    - rke2_download_kubeconf is true
    - inventory_hostname == groups[rke2_servers_group_name][0]

- name: Prepare and join remaining nodes of the cluster
  include: remaining_nodes.yml
  when:
    - active_server is defined
    - (groups[rke2_servers_group_name] | length >= 2)

- name: Rolling cordon and drain restart when version changes - servers
  include: rolling_restart.yml
  when:
    - inventory_hostname in groups[rke2_servers_group_name]
    - installed_version is defined and not "not installed"
    - rke2_version is defined and (rke2_version != installed_version)

- name: Rolling cordon and drain restart when version changes - agents
  include: rolling_restart.yml
  when:
    - inventory_hostname in groups[rke2_agents_group_name]
    - inventory_hostname not in groups[rke2_servers_group_name]
    - installed_version is defined and not "not installed"
    - rke2_version is defined and (rke2_version != installed_version)

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  include: change_config.yml
  when:
    - inventory_hostname in groups[rke2_cluster_group_name]
    - rke2_restart_needed is true

- name: Final steps
  include: summary.yml


