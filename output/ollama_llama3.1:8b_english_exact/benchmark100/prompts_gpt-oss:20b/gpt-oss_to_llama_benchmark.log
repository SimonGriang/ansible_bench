---
- name: Configure SELinux
  tasks:
  - name: Import assert
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: yes

  - name: Install required packages
    package:
      name: "{{ selinux_requirements }}"
      state: present
    notify:
      - Gather facts

  - name: Flush handlers
    meta: flush_handlers

  - name: Manage SELinux
    ansible.posix.selinux:
      state: "{{ selinux_state }}"
      policy: "{{ selinux_policy }}"
    when: ansible_selinux.status is defined and not ansible_hostname.startswith('docker-')
    notify:
      - Reboot

  - name: Manage SELinux booleans
    ansible.posix.seboolean:
      name: "{{ item }}"
      state: yes
      persistent: yes
    loop: "{{ selinux_booleans }}"
    when: selinux_booleans is defined


