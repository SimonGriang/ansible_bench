    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - path: "{{ dns_datadir }}"
      mode: '1770'
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
    - path: "{{ dns_confdir }}"
      mode: '0755'
      owner: 'root'
      group: 'root'
  loop_control:
    label: "{{ item.path }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    system: true
    state: present

- name: Generate rndc key
  command:
    cmd: rndc-confgen -a -c
    chdir: "{{ dns_confdir }}"
    creates: "{{ dns_confdir }}/rndc.key"
  notify: Rndc reload

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0640'

- name: Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.root
    dest: "{{ dns_datadir }}/named.root"
    validate_certs: "{{ dns_validate_certs }}"
    mode: '0640'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns|bool
  notify: Rndc reload

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.db"
    validate: "named-checkzone {{ item.name }} %s"
    mode: '0640'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop: "{{ dns_zones }}"
  loop_control:
    label: "{{ item.name }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    validate: "named-checkconf -zj %s"
    mode: '0640'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    backup: yes
  notify: Restart dns

- name: Place systemd override
  block:
    - name: Create directory
      file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        mode: '0755'
    - name: Copy override.conf
      copy:
        content: "{{ lookup('file', 'files/override.conf') }}"
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
        owner: 'root'
        group: 'root'
        mode: '0644'
    - name: Reload systemd daemon
      service:
        daemon_reload: true
        changed_when: false
  when: ansible_service_mgr == "systemd"

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


