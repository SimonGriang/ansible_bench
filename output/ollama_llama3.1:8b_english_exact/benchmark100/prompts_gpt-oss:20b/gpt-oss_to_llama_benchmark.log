---
- name: RKE2 Config
  hosts: all
  become: true

  tasks:
  - name: Create RKE2 config dir
    file:
      path: /etc/rancher/rke2
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Set server taints
    when: rke2_type == 'server'
    set_fact:
      combined_node_taints: "{{ rke2_server_node_taints }}"

  - name: Set agent taints
    when: rke2_type == 'agent'
    set_fact:
      combined_node_taints: "{{ rke2_agent_node_taints }}"

  - name: Copy RKE2 config
    template:
      src: "{{ rke2_config }}"
      dest: /etc/rancher/rke2/config.yaml
      owner: root
      group: root
      mode: '0600'
    notify: Config file changed

  - name: Copy kubelet config
    when: rke2_kubelet_config | length > 0
    template:
      src: templates/kubelet-config.yaml.j2
      dest: /etc/rancher/rke2/kubelet-config.yaml
      owner: root
      group: root
      mode: '0600'
    notify: Config file changed

  - name: Copy Containerd Registry Configuration file
    when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)
    template:
      src: "{{ rke2_custom_registry_path }}"
      dest: /etc/rancher/rke2/registries.yaml
      owner: root
      group: root
      mode: '0600'
    notify: Config file changed

  - name: Start RKE2 service on the rest of the nodes
    service:
      name: "{{ rke2_service_name }}"
      state: started
      enabled: true
      restart: on-failure
      retry: true
      retry_delay: 10
      register: rke2_service_result
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
    notify: Service (re)started

  - name: Mask other RKE2 service on the rest of the nodes
    service:
      name: "rke2-{{ item }}"
      state: masked
      enabled: false
    loop:
      - "{{ item }}"
    when: not rke2_type
    loop_control:
      loop_var: item
      loop: ['agent', 'server']

  - name: Wait for remaining nodes to be ready - no CNI
    when: (rke2_cni == 'none') and (inventory_hostname == active_server or inventory_hostname in groups[rke2_servers_group_name] | first)
    shell: |
      kubectl get nodes | grep " Ready" | wc -l
    retries: 10
    delay: 10
    notify: "Wait for remaining nodes to be ready - no CNI"

  - name: Wait for remaining nodes to be ready - with CNI
    when: (rke2_cni != 'none') and (inventory_hostname == active_server or inventory_hostname in groups[rke2_servers_group_name] | first) and not check_mode
    shell: |
      kubectl get nodes | grep " Ready" | wc -l
    retries: 10
    delay: 10
    register: rke2_nodes_count
    until: rke2_nodes_count.stdout == groups[rke2_cluster_group_name] | length
    notify: "Wait for remaining nodes to be ready - with CNI"

