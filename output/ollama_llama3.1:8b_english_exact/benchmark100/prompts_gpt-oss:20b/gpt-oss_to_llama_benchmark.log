---
- name: Task 1 - Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
    run_once: true
    delegate_to: localhost

- name: Task 2 - Install required packages
  ansible.builtin.package:
    name: "{{ selinux_requirements }}"
    state: present
    notify: Gather facts

- name: Task 3 - Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Task 4 - Configure selinux
  ansible.posix.selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
    notify: Reboot
  when: ansible_selinux.status is defined and not ansible_distribution == 'Alpine' and not ansible_distribution == 'FreeBSD'

