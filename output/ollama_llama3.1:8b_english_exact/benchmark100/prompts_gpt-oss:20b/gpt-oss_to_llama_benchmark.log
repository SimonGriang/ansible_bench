--- 

- name: Lookup bootstrap facts
  ansible.builtin.raw:
    cmd: cat /etc/os-release
    chdir: /tmp
    register: bootstrap_facts
    check_mode: false
    changed_when: false

- name: Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ bootstrap_os_family_map[item].distributions | flatten }}"
    bootstrap_distribution_major_version: >
      {{ bootstrap_facts.stdout_lines
        | join("\n")
        | regex_search('VERSION_ID="(\d{1,2})(\.\d{1,4})*?"', groups=1)
        | default('NA') }}
  loop: "{{ bootstrap_os_family_map | dict2items | flatten }}"
  when: bootstrap_facts.rc == 0 and
        'bootstrap_distribution' not in bootstrap_facts.stdout
        and bootstrap_facts.stdout | regex_search('PRETTY_NAME=.*', '{{ bootstrap_search[item] }}') or
        bootstrap_facts.stdout | regex_search('PRETTY_NAME=.*', item)

- name: Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  when: bootstrap_distribution in bootstrap_os_family_map[item].distributions

