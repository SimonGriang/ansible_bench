  copy:
    content: "{{ postfix_smtp_sasl_password_map }}"
    dest: "{{ postfix_smtp_sasl_password_map_dest }}"
    mode: "{{ postfix_smtp_sasl_password_map_mode }}"
  notify:
    - rebuild_sasl_password_map
  when:
    - postfix_smtp_sasl_password_map is defined
    - postfix_smtp_sasl_password_map is not empty

- name: Flush Postfix handlers again
  meta: flush_handlers

- name: Start and enable Postfix service
  service:
    name: postfix
    state: started
    enabled: yes


