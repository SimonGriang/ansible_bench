---
- name: Ensure Backports repository and Ansible package is installed
  hosts: all

  tasks:
  - name: Enable Backports repository for Debian systems with a version less than 9
    apt_repository:
      repo: 'ppa:deadsnakes/ppa'
      state: present
    when: ansible_distribution == 'Debian' and ansible_distribution_major_version < '9'

  - name: Set default release to Backports for Debian systems with a version less than 9
    set_fact:
      ansible_default_release: 'buster-backports'
    when: ansible_distribution == 'Debian' and ansible_distribution_major_version < '9'

  - name: Install Ansible package
    apt:
      name: ansible
      state: present
      default_release: "{{ ansible_default_release }}"
    when: ansible_distribution == 'Debian' and ansible_distribution_major_version < '9'


