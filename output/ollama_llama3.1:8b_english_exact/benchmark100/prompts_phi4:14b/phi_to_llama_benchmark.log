---
- name: Include assertions
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost

- name: Manage automatic service management for APT
  when: ansible_pkg_mgr == "apt"
  block:
    - name: Disable automatic service management on installation
      when: apt_autostart_state == "disabled"
      block:
        - name: Create or update /usr/sbin/policy-rc.d
          ansible.builtin.copy:
            content: "exit 101"
            dest: /usr/sbin/policy-rc.d
            mode: "755"
        - name: Set permissions for /usr/sbin/policy-rc.d
          ansible.builtin.file:
            path: /usr/sbin/policy-rc.d
            mode: "755"

    - name: Enable automatic service management on installation
      when: apt_autostart_state == "enabled"
      block:
        - name: Ensure /usr/sbin/policy-rc.d is absent
          ansible.builtin.file:
            path: /usr/sbin/policy-rc.d
            state: absent


