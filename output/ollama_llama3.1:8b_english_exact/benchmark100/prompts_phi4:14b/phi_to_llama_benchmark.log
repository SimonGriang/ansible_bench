---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port
  wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  connection: local
  when: bootstrap_wait_for_host and not bootstrap_connection_types

- name: Prepare system
  block:
    - name: Test connection
      ping:
    - name: Check sudo availability
      command: sudo -n true
  rescue:
    - name: Gather bootstrap facts
      setup: 
    - name: Install bootstrap packages
      raw: |
        {{ bootstrap_packages | join(' ') }}
      when: ansible_distribution == 'RedHat' and not bootstrap_packages =~ /libdnf5/
      when: ansible_distribution == 'CentOS' and not bootstrap_packages =~ /libdnf5/
      when: ansible_distribution == 'Fedora' and not bootstrap_packages =~ /libdnf5/
  when: not bootstrap_wait_for_host or not bootstrap_connection_types

- name: Gather facts
  setup: 

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
  become: "{{ bootstrap_become }}"


