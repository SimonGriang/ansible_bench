---
- name: Fail2ban Configuration
  hosts: localhost

  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml

    - name: Install fail2ban
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ fail2ban_packages }}"

    - name: Copy filters in filter.d
      copy:
        src: "{{ fail2ban_filterd_path }}/{{ item }}"
        dest: "/etc/fail2ban/filter.d/{{ item }}"
        mode: '0640'
        owner: root
      loop: "{{ fail2ban_filterd_files }}"
      notify: restart fail2ban

    - name: Configure fail2ban.local
      community.general.ini_file:
        path: "/etc/fail2ban/fail2ban.local"
        section: "SECTION"
        option: "OPTION"
        value: "{{ item.value }}"
        state: present
      loop: "{{ fail2ban_base_configuration | combine(fail2ban_configuration) }}"
      notify: restart fail2ban

    - name: Configure jail.local
      community.general.ini_file:
        path: "/etc/fail2ban/jail.local"
        section: "SECTION"
        option: "OPTION"
        value: "{{ item.value }}"
        state: present
      loop: "{{ fail2ban_base_jail_configuration | combine(fail2ban_jail_configuration) }}"
      notify: restart fail2ban

    - name: Stat auth log file
      stat:
        path: "/var/log/auth.log"
        register: fail2ban_auth

    - name: Touch auth log file
      file:
        path: "/var/log/auth.log"
        state: touch
        mode: '0640'

    - name: Start and enable fail2ban
      service:
        name: "{{ fail2ban_service }}"
        state: started
        enabled: yes

