    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_directories }}"
  loop_control:
    loop_var: item

- name: Create data directories for Vault
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
