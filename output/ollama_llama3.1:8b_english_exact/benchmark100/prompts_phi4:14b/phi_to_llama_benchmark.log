content='---\n\n\n- name: Import tasks from assert.yml\n  include: assert.yml\n  delegate_to: localhost\n\n- name: Install MySQL packages\n  package:\n    name: "{{ mysql_packages }}"\n    state: present\n  notify:\n    - set_root_password\n    - restart_systemd\n    handler:\n      name: restart_systemd\n      service: mysql\n\n- name: Configure the MySQL server configuration file\n  template:\n    src: templates/my.cnf.j2\n    dest: /etc/my.cnf\n    mode: \'0644\'\n  notify:\n    - restart_mysql\n  handler:\n    name: restart_mysql\n    service: mysql\n\n- name: Configure the MySQL client configuration file\n  template:\n    src: templates/client.cnf.j2\n    dest: /root/.my.cnf\n    mode: \'0600\'\n  vars:\n    mysql_socket: \'/var/run/mysqld/mysqld.sock\'\n\n- name: Initialize the MySQL database if on Alpine or Archlinux\n  when: ansible_distribution in [\'Alpine\', \'Archlinux\']\n  mysql_db:\n    name: mysql\n    state: present\n  mysql_db:\n    name: test\n    state: present\n  mysql_db:\n    name: performance_schema\n    state: present\n\n- name: Start and enable the MySQL service\n  service:\n    name: mysql\n    state: started\n    enabled: yes\n\n- name: Flush handlers to apply previous changes\n  meta: flush_handlers\n\n- name: Place the my.cnf configuration file\n  template:\n    src: templates/my.cnf.j2\n    dest: /root/my.cnf\n    mode: \'0644\'\n\n- name: Create MySQL databases\n  mysql_db:\n    name: "{{ item.name }}"\n    state: present\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_host: localhost\n    login_port: 3306\n  loop: "{{ mysql_databases }}"\n  when: item.initial_import == false\n\n- name: List current MySQL databases\n  mysql_db:\n    name: "{{ item.name }}"\n    state: query\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_host: localhost\n    login_port: 3306\n  loop: "{{ mysql_databases }}"\n  when: item.initial_import == false\n\n- name: Import databases if initial import is defined and not already present\n  when: item.initial_import | bool and item.name not in mysql_databases | map(attribute=\'name\') | list\n  mysql_db:\n    name: "{{ item.name }}"\n    state: import\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_host: localhost\n    login_port: 3306\n    target: "{{ item.target }}"\n  loop: "{{ mysql_databases }}"\n\n- name: Create MySQL users\n  mysql_user:\n    name: "{{ item.name }}"\n    password: "{{ item.password }}"\n    priv: "{{ item.priv }}"\n    state: present\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_host: localhost\n    login_port: 3306\n  loop: "{{ mysql_users }}"\n\n- name: Flush handlers again to apply user creation changes\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-14T20:18:39.960365431Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5760813501, 'load_duration': 110720594, 'prompt_eval_count': 718, 'prompt_eval_duration': 127089346, 'eval_count': 683, 'eval_duration': 5521714655, 'model_name': 'llama3.1:8b'} id='run--71e27922-abdf-4ac0-9ec4-567aa9118349-0' usage_metadata={'input_tokens': 718, 'output_tokens': 683, 'total_tokens': 1401}
