- name: Install SSL packages
  package:
    name: "{{ httpd_ssl_packages }}"
    state: present

- name: Place SSL configuration file
  template:
    src: ssl.conf.j2
    dest: "{{ httpd_config_directory }}/ssl.conf"
    mode: '0644'
  notify: test and restart http server

