---
- name: Create a system group for Vault
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create a system user for Vault
  user:
    name: "{{ vault_user }}"
    group: "{{ vault_group }}"
    shell: "{{ vault_user_shell }}"
    state: present

- name: Create a download directory for Vault
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Download the Vault binary
  get_url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_amd64.zip"
    dest: "{{ vault_download_path }}"
    mode: '0644'
  register: vault_download

- name: Check if the main Vault directory exists
  stat:
    path: "{{ vault_path }}"
    state: absent
  register: vault_check_path

- name: Create the main Vault directory if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
  when: not vault_check_path.stat.exists

- name: Create additional directories in the main Vault directory
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_directories }}"
  loop_control:
    loop_var: item

- name: Create data directories for Vault
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_data_directories }}"
  loop_control:
    loop_var: item

- name: Generate a TLS key and certificate for Vault
  openssl_certificate:
    path: "{{ vault_data_directory }}/tls/vault.crt"
    csr_path: "{{ vault_data_directory }}/tls/vault.csr"
    private_key_path: "{{ vault_data_directory }}/tls/vault.key"
    common_name: "{{ vault_path }}"
    organization: "vault"
  notify: restart vault

- name: Set ownership of TLS files
  file:
    path: "{{ item.path }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_tls_files }}"
  loop_control:
    loop_var: item

- name: Copy the Vault binary to the appropriate location
  copy:
    content: "{{ vault_download.content }}"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
  notify: restart vault

- name: Set specific capabilities on the Vault binary
  capability:
    name: cap_ipc_lock
    value: ep
    path: "{{ vault_path }}/usr/bin/vault"

- name: Create a vault environment file
  template:
    src: "templates/vault.env.j2"
    dest: "{{ vault_path }}/etc/vault.d/vault.env"
    owner: "root"
    group: "root"
    mode: '0644'
  notify: restart vault

- name: Ensure the systemd system directory exists
  file:
    path: "/usr/lib/systemd/system"
    state: directory
    owner: "root"
    group: "root"
    mode: '0755'

- name: Copy the Vault service file for systemd
  template:
    src: "templates/vault.service.j2"
    dest: "/usr/lib/systemd/system/vault.service"
    owner: "root"
    group: "root"
    mode: '0644'
  notify: reload systemd

- name: Copy the Vault configuration file
  template:
    src: "templates/vault.hcl.j2"
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: "root"
    group: "root"
    mode: '0644'
  notify: restart vault

- name: Flush handlers to apply changes
  meta: flush_handlers

