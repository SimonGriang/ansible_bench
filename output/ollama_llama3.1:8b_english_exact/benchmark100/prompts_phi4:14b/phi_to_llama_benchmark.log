        package:
          name: "{{ java_jdk_vendor }}-{{ java_jdk_version }}-jdk"
          state: present

  - name: Install Required Libraries for Java
    package:
      name: "{{ item }}"
      state: present
      cache_valid_time: 0
    loop:
      - "{{ java_jdk_vendor }}-{{ java_jdk_version }}"
      - "{{ java_jdk_vendor }}-{{ java_jdk_version }}-jdk-headless"

  - name: Install Java on Debian Systems
    apt:
      name: "{{ java_jdk_vendor }}-{{ java_jdk_version }}"
      state: present
      cache_valid_time: 0

  - name: Install Java on RedHat Systems
    yum:
