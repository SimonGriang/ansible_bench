---
- name: Gather bootstrap facts
  shell:
    cmd: cat /etc/os-release
    chdir: /root
    creates: /root/os-release.txt
  register: bootstrap_facts
  changed_when: false

- name: Set bootstrap distribution facts
  set_fact:
    bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_search('NAME=\"(.*)\"', groups=['1']) }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search('VERSION_ID=\"(.*)\"', groups=['1']) | regex_replace('^[0-9]+\\.', '') }}"
  when: bootstrap_facts is defined and bootstrap_facts.stdout | regex_search("PRETTY_NAME=\"(.*)\"", groups=['1']) and
         bootstrap_distribution is not defined and
         bootstrap_distribution_major_version is defined

- name: Set bootstrap operating system family
  set_fact:
    bootstrap_os_family: "{{ item.value[0] }}"
  with_dict: "{{ bootstrap_os_family_map }}"
  when: bootstrap_distribution is defined and bootstrap_distribution in bootstrap_os_family_map.keys()


