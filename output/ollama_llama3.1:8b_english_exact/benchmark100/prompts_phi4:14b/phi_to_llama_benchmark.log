---
- name: EasyRSA and OpenVPN Configuration
  hosts: all
  become: yes

  tasks:
  - name: Create /etc/openvpn/easy-rsa directory with mode 0755
    file:
      path: /etc/openvpn/easy-rsa
      state: directory
      mode: '0755'

  - name: Initialize PKI directory using EasyRSA
    command: "bash -c 'cd /etc/openvpn/easy-rsa && . easy-rsa.sh init-pki'"
    args:
      chdir: /etc/openvpn/easy-rsa

  - name: Build CA certificate using EasyRSA without passphrase
    command: "bash -c 'cd /etc/openvpn/easy-rsa && . easy-rsa.sh build-ca nopass'"
    args:
      chdir: /etc/openvpn/easy-rsa

  - name: Generate Diffie-Hellman parameters file using EasyRSA
    command: "bash -c 'cd /etc/openvpn/easy-rsa && . easy-rsa.sh gen-dh'"
    args:
      chdir: /etc/openvpn/easy-rsa

  - name: Build server certificate using EasyRSA without passphrase
    command: "bash -c 'cd /etc/openvpn/easy-rsa && . easy-rsa.sh build-server-full server nopass'"
    args:
      chdir: /etc/openvpn/easy-rsa

  - name: Build client certificate using EasyRSA without passphrase
    command: "bash -c 'cd /etc/openvpn/easy-rsa && . easy-rsa.sh build-client-full client nopass'"
    args:
      chdir: /etc/openvpn/easy-rsa

  - name: Generate Certificate Revocation List using EasyRSA
    command: "bash -c 'cd /etc/openvpn/easy-rsa && . easy-rsa.sh gen-crl'"
    args:
      chdir: /etc/openvpn/easy-rsa

  - name: Generate TLS auth key using OpenVPN
    command: "openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key"

  - name: Copy necessary EasyRSA files to /etc/openvpn/server
    file:
      src: /etc/openvpn/easy-rsa/pki/ca.crt
      dest: /etc/openvpn/server/ca.crt
      state: file
      mode: '0644'
    file:
      src: /etc/openvpn/easy-rsa/pki/ta.key
