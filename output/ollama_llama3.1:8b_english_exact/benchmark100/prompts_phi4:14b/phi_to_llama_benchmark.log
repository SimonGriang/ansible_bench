- name: Place git configuration file
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    mode: '0644'
  when: git_user_exists is defined and git_user_exists[git_username] is defined

- name: Create repository destination directory
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    mode: '0755'
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when: git_user_exists is defined and git_user_exists[git_username] is defined and git_repository_destination is defined

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}"
    accept_hostkey: yes
    version: "{{ item.version | default('') }}"
    force: yes
  loop: "{{ git_repositories }}"
  when: git_repository_destination is defined and git_user_exists is defined and git_user_exists[git_username] is defined


