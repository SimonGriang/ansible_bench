---
- name: Configure Grub
  tasks:
    - name: Determine if the system is EFI
      stat:
        path: /sys/firmware/efi/efivars
      register: is_efi

    - name: Remove unwanted grub.cfg for EFI systems
      file:
        path: /boot/grub2/grub.cfg
        state: absent
      when: is_efi.stat.exists

    - name: Install a user template for Grub
      template:
        src: grub.cfg.j2
        dest: /boot/grub2/grub.cfg
        mode: '0644'
      notify: update grub

    - name: Add a password to the EFI Grub configuration
      lineinfile:
        path: /etc/grub2-efi.cfg
        line: 'password --echopw --iscrypted {{ grub_password }}'
        state: present
      when: is_efi.stat.exists

    - name: Add a password to the MBR Grub configuration
      lineinfile:
        path: /etc/grub2.cfg
        line: 'password --echopw --iscrypted {{ grub_password }}'
        state: present
      when: is_efi.stat.exists

    - name: Modify files to add --unrestricted class
      lineinfile:
        path: /boot/grub2/grub.cfg
        line: "CLASS --unrestricted"
        state: present
      when: is_efi.stat.exists and '{{ grub_password }}' in is_efi.stdout
      notify: update grub

  handlers:
    - name: update grub
      command: "/usr/sbin/update-grub"

  # Removed the extra line character at the end of the file

