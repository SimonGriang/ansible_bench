---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install git package
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if git user exists
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: git_user_exists
  ignore_errors: yes

- name: Create git directory
  file:
    path: "/home/{{ git_username }}"
    state: directory
    mode: '0755'
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when: git_user_exists is defined and git_user_exists[{{ git_username }}] is not None

- name: Place git configuration file
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    mode: '0644'
  when: git_user_exists is defined and git_user_exists[{{ git_username }}] is not None

- name: Create repository destination directory
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    mode: '0755'
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when: git_user_exists is defined and git_user_exists[{{ git_username }}] is not None and git_repository_destination is defined

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}"
    accept_hostkey: yes
    version: "{{ item.version | default('') }}"
    force: yes
  loop: "{{ git_repositories }}"

