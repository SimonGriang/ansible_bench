---
- name: Manage services
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ service_required_packages }}"
    state: present
  notify:
    - Gather facts

- name: Configure systemd service templates
  template:
    src: systemd.j2
    dest: /etc/systemd/system/{{ item.name }}.service
    mode: '0644'
  loop: "{{ service_list }}"
  when: ansible_service_mgr == 'systemd'
  notify:
    - Systemctl daemon-reload

- name: Configure sysvinit service templates
  template:
    src: sysvinit.j2
    dest: /etc/init.d/{{ item.name }}
    mode: '0755'
  loop: "{{ service_list }}"
  when: ansible_service_mgr in ['sysvinit', 'upstart', 'openrc']

- name: Manage service state and enablement
  service:
    name: "{{ item.name }}"
    state: "{{ item.state | default('started') }}"
    enabled: "{{ item.enabled | default(false) }}"
  loop: "{{ service_list }}"

- meta: flush_handlers


