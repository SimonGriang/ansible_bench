- name: Gather Bootstrap Facts
  tasks:
  - name: Gather bootstrap facts
    raw: cat /etc/os-release
    register: bootstrap_facts
    changed_when: False

- name: Set Bootstrap Distribution and Major Version Facts
  tasks:
  - name: Set bootstrap distribution and major version facts
    set_fact:
      bootstrap_distribution: "{{ bootstrap_facts.stdout | json_query('bootstrap_os_family_map[?(@.name == bootstrap_distribution)].name') | first }}"
      bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | json_query('bootstrap_os_family_map[?(@.name == bootstrap_distribution)].version') | first }}"
    when:
      - bootstrap_facts.rc == 0
      - bootstrap_distribution is not defined
      - bootstrap_distribution_major_version is not defined
      - bootstrap_facts.stdout | from_json | string | search('PRETTY_NAME.*{{ bootstrap_search[bootstrap_distribution] }}')

- name: Determine and Set Bootstrap OS Family
  tasks:
  - name: Determine and set bootstrap OS family
    set_fact:
      bootstrap_os_family: "{{ item.value.name }}"
    loop: "{{ bootstrap_os_family_map }}"
    loop_control:
      label: "{{ item.key }}"
    when:
      - bootstrap_distribution == item.key


