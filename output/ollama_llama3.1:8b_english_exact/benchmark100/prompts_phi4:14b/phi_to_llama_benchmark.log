    name: bash
    state: present

- name: Install OpenJDK
  package:
    name: "{{ java_openjdk_package }}"
    state: present
  when: java_vendor == "openjdk"
  environment:
    JAVA_HOME: "/usr/lib/jvm/{{ java_openjdk_package }}"
    JRE_HOME: "/usr/lib/jvm/{{ java_openjdk_package }}"

- name: Install Oracle Java RPM package
  package:
    name: "{{ java_oracle_package }}"
    state: present
  when: (java_source == "local" and java_format == "rpm")

- name: Copy Oracle Java RPM package to /tmp
  copy:
    content: "{{ java_oracle_package }}"
    dest: "/tmp/{{ java_oracle_package }}"
    mode: '0644'
  when: (java_source == "local" and java_format == "rpm")

- name: Install Oracle Java RPM package
  package:
    name: "{{ java_oracle_package }}"
    state: present
  when: (java_source == "local" and java_format == "rpm")

- name: Install Oracle Java DEB package
  apt:
    name: "{{ java_oracle_package }}"
    state: present
  when: (java_source == "local" and java_format == "deb")

- name: Copy Oracle Java DEB package to /tmp
  copy:
    content: "{{ java_oracle_package }}"
    dest: "/tmp/{{ java_oracle_package }}"
    mode: '0644'
  when: (java_source == "local" and java_format == "deb")

- name: Install Oracle Java tarball
  unarchive:
    src: "{{ java_oracle_package }}"
    dest: "{{ java_install_dir }}"
    compression: tar
    extraopts: '--strip-components=1'
  when: (java_format == "targz" and java_vendor == "oracle")

- name: Ensure installation directory exists
  file:
    path: "{{ java_install_dir }}"
    state: directory
    mode: '0755'
  when: (java_format == "targz" and java_vendor == "oracle")

- name: Set permissions for installation directory
  file:
    path: "{{ java_install_dir }}"
    state: directory
    mode: '0755'
  when: (java_format == "targz" and java_vendor == "oracle")

- name: Install Oracle Java policy software
  unarchive:
    src: "{{ java_policy_zip }}"
    dest: "{{ java_install_dir }}"
    compression: zip
    extraopts: '--strip-components=1'
  when: (java_version == 8 and java_jce_enabled and java_vendor == "oracle")

- name: Set Java as default alternative
  shell:
    cmd: update-alternatives --set java /usr/lib/jvm/{{ java_vendor }}_jdk
  when: (java_format == "targz" and java_distribution != "alpine" and java_vendor == "oracle")

- name: Determine JAVA_HOME directory
  shell:
    cmd: /usr/bin/readlink -f /usr/bin/java
  register: java_home

- name: Set JAVA_HOME environment variable
  lineinfile:
    dest: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home.path }}"
    state: present


