- name: Task 1 - Remove externally managed file
  become: true
  file:
    path: /etc/apt/apt.conf.d/externally-managed
    state: absent

- name: Task 2 - Install Pip
  become: true
  apt:
    name: "{{ pip_package }}"
    state: present

- name: Task 3 - Install python3-packaging
  become: true
  dnf:
    name: python3-packaging
    state: present

- name: Task 4 - Install specified Python packages
  become: true
  pip:
    name: "{{ item }}"
    state: present
    executable: pip3
    version: "{{ item.split('==') | first }}"
    virtualenv: "{{ item.split('==') | last | regex_replace('==', '') }}"
    extra_args: "{{ item.split('==') | last | regex_replace('==', '') }}"
  loop: "{{ pip_install_packages }}"
  loop_control:
    loop_var: item


