    mode: '0644'
  when: promtail_binary_propagate is True and not promtail_binary.stat.exists

- name: Unpack the Promtail binaries
  unarchive:
    src: '{{ promtail_install_dir }}/promtail.tar.gz'
    dest: '{{ promtail_install_dir }}'
    compression: 'tar'
    interactive: False
  when: not promtail_binary.stat.exists

- name: Create a symlink to the latest version of Promtail
  file:
    path: '/usr/local/bin/promtail'
    state: link
    link_path: '{{ promtail_install_dir }}/bin/promtail'
  notify: restart promtail

- name: Write the Promtail configuration file
  template:
