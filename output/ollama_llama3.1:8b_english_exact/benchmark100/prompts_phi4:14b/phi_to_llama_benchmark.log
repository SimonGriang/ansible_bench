---
- name: Tasks for MySQL setup
  hosts: localhost
  become: true

  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install mysql
    package:
      name: "{{ mysql_packages }}"
      state: present
    notify:
      - set_root_password
      - restart_systemd_daemon

  - name: Configure mysql server
    template:
      src: templates/my.cnf.j2
      dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}"
      mode: '0640'
    notify:
      - restart_mysql_service

  - name: Configure mysql client
    template:
      src: templates/my.cnf.j2
      dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}"
      mode: '0640'
    notify:
      - restart_mysql_service

  - name: Set mysql client configuration
    template:
      src: templates/my.cnf.j2
      dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}"
      mode: '0640'
    notify:
      - restart_mysql_service

  - name: Initialize mysql
    command: "{{ mysql_initialize_command }}"
    when: ansible_distribution in ['Alpine', 'Archlinux']

  - name: Start and enable mysql
    service:
      name: "{{ mysql_service }}"
      state: started
      enabled: true

  - name: Flush handlers
    meta: flush_handlers

  - name: Place my.cnf
    template:
      src: templates/my.cnf.j2
      dest: /root/.my.cnf
      mode: '0640'

  - name: Create databases
    mysql_db:
      name: "{{ item.name }}"
      user: root
      password: "{{ mysql_root_password }}"
      state: present
      login_host: localhost
    when: mysql_databases is defined
    loop: "{{ mysql_databases }}"

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.priv }}"
      user: root
      password: "{{ mysql_root_password }}"
      state: present
      login_host: localhost
    when: mysql_users is defined
    loop: "{{ mysql_users }}"

  - name: Flush handlers again
    meta: flush_handlers


