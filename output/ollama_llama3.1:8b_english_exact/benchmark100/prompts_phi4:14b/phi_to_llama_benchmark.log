---
- name: Import assert.yml task file on localhost
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install OpenSSL packages
  package:
    name: "{{ openssl_requirements }}"
    state: present

- name: Install pip packages
  pip:
    name: "{{ openssl_pip_packages }}"
    state: present
  when: openssl_pip_packages | length > 0

- name: Create OpenSSL keys directory
  file:
    path: /path/to/openssl/keys
    state: directory
    mode: '0700'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create OpenSSL CSRs directory
  file:
    path: /path/to/openssl/CSRs
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create OpenSSL certificates directory
  file:
    path: /path/to/openssl/certs
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include create.yml task file for each item in openssl_items
  include_tasks: create.yml
  loop: "{{ openssl_items | default([]) }}"
  when: openssl_items is defined and openssl_items | length > 0

