---
- name: Configure Apache HTTP server
  hosts: all
  become: yes

  tasks:
  - name: Create document root directories for HTTP virtual hosts
    file:
      path: "{{ item.documentroot }}"
      state: directory
      mode: '0755'
    when: httpd_vhosts is defined and item.documentroot is defined and not item.create_docroot is false
    loop: "{{ httpd_vhosts }}"

  - name: Configure virtual host configuration files using templates
    template:
      src: "{{ vhost_conf_template }}"
      dest: "{{ item.documentroot }}/{{ item.name }}.conf"
      mode: '0644'
    notify: test httpd config and restart httpd
    loop: "{{ httpd_vhosts }}"

  - name: Enable virtual hosts on Debian-based systems
    apt:
      name: apache2
      state: present
    when: ansible_os_family == 'Debian'

  - name: Enable virtual hosts
    apt:
      name: apache2
      state: present
    when: ansible_os_family == 'Debian'

  - name: Enable virtual host
    command:
      cmd: a2ensite {{ item.name }}
    notify: test httpd config and restart httpd
    loop: "{{ httpd_vhosts }}"

  handlers:
  - name: test httpd config and restart httpd
    service:
      name: httpd
      state: restarted
      enabled: yes


