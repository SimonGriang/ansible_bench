---

- name: Install EPEL repository on supported Red Hat-based systems
  block:
    - name: Ensure EPEL repository is installed
      ansible.builtin.assert:
        that:
        - (ansible_distribution == 'Amazon Linux' and ansible_distribution_major_version == '2') or
          (ansible_distribution == 'Red Hat' and ansible_distribution_major_version in ['7', '8', '9'])
        message: This system does not meet the requirements to install the EPEL repository.

    - name: Add EPEL GPG key
      ansible.builtin.rpm_key:
        state: present
        key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}.gpg

    - name: Install EPEL release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      notify:
        - Update package cache

    - name: Optionally install EPEL next-release package
      ansible.builtin.package:
        name: "{{ epel_next_url }}"
        state: present
      when: epel_next

  handlers:
    - name: Update package cache
      ansible.builtin.package:
        manage_repo: yes
        state: present

