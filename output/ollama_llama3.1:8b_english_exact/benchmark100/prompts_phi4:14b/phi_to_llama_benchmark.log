- name: Tasks
  tasks:
  - name: Check for EXTERNALLY-MANAGED file for Python 3.11
    stat:
      path: /usr/lib/python3.11/EXTERNALLY-MANAGED
    register: result

  - name: Rename EXTERNALLY-MANAGED file for Python 3.11
    rename:
      path: /usr/lib/python3.11/EXTERNALLY-MANAGED
      dest: /usr/lib/python3.11/EXTERNALLY-MANAGED.old
    when: result.stat.exists

  - name: Check for EXTERNALLY-MANAGED file for Python 3.12
    stat:
      path: /usr/lib/python3.12/EXTERNALLY-MANAGED
    register: result

  - name: Rename EXTERNALLY-MANAGED file for Python 3.12
    rename:
      path: /usr/lib/python3.12/EXTERNALLY-MANAGED
      dest: /usr/lib/python3.12/EXTERNALLY-MANAGED.old
    when: result.stat.exists

  - name: Import tasks from assert.yml
    include_tasks: assert.yml
    delegate_to: localhost
    when: true

  - name: Install Python pip
    apt:
