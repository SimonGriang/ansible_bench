---
- name: Configure GRUB settings
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install required GRUB packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT value
  lineinfile:
    dest: /etc/default/grub
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: yes
    backup: yes
    mode: '0644'
  notify: update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT value
  lineinfile:
    dest: /etc/default/grub
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: yes
    backup: yes
    mode: '0644'
  notify: update grub

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    dest: /etc/default/grub
    line: "^GRUB_CMDLINE_LINUX.*?=\".*?\".*$"
    regexp_flags: 'multiline'
    insertafter: '^GRUB_CMDLINE_LINUX.*?=\".*?\".*$'
  when: grub_options is defined and grub_options is not empty
  notify: update grub
  delegate_to: localhost
  delegate_facts: yes
  delegate_args:
    executable: /bin/sh

- name: Import password.yml if password setting is required
  import_tasks: password.yml
  when: grub_set_password

- name: Flush any pending handlers
  meta: flush_handlers


