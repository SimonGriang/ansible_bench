---
- name: RKE2 kubeconfig tasks
  hosts: localhost
  become: false

  tasks:
  - name: Download the RKE2 kubeconfig file
    ansible.builtin.fetch:
      src: /etc/rancher/rke2/rke2.yaml
      dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
      flat: yes
    when:
      - rke2_download_kubeconf == true
      - inventory_hostname in groups(rke2_servers_group_name)
      - inventory_hostname == groups(rke2_servers_group_name)[0]

  - name: Replace loopback IP addresses in the downloaded kubeconfig file
    ansible.builtin.replace:
      path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
      regexp: '^(127\.0\.0\.1|::1).*\n.*\n'
      replace: "{{ rke2_api_ip | default(inventory_hostname | groups(rke2_servers_group_name)[0].vars['ansible_host']) }}"
      backup: false
    when:
      - rke2_download_kubeconf == true
      - inventory_hostname in groups(rke2_servers_group_name)
      - inventory_hostname == groups(rke2_servers_group_name)[0]
    notify:
      - file_owner
      - file_group
      - file_mode
    ignore_errors: yes


