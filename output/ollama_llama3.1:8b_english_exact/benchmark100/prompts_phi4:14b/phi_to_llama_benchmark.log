---
- name: Install EPEL repository package
  block:
    - name: Add EPEL GPG key
      ansible.builtin.rpm_key:
        state: present
        key: "{{ epel_gpg_key }}"
    - name: Install EPEL-release package
      ansible.builtin.package:
        state: present
        name: "{{ epel_url }}"
      notify: "Update package cache"
  when:
    - ansible_distribution in ['Amazon', 'Red Hat']
    - ansible_distribution_major_version | int in [7, 8, 9, 10]

- name: Install EPEL GPG key
  ansible.builtin.rpm_key:
    state: present
    key: "{{ epel_gpg_key }}"

- name: Install EPEL-release package and update package cache
  ansible.builtin.package:
    state: present
    name: "{{ epel_url }}"
  notify: "Update package cache"

- name: Optionally install EPEL-next-release package and update package cache
  ansible.builtin.package:
    state: present
    name: "{{ epel_next_url }}"
  when: epel_next
  notify: "Update package cache"

handlers:
  - name: "Update package cache"
    ansible.builtin.package:
      state: present
      name: "{{ epel_url }}"

