---
- name: Create an etcd group
  group:
    name: etcd
    state: present

- name: Create an etcd user
  user:
    name: etcd
    group: etcd
    shell: /bin/nologin
    comment: etcd user
    append: true
  become: yes

- name: Copy the kernel hardening sysctl configuration file
  copy:
    src: "{{ '/usr/local/share/rke2/rke2-cis-sysctl.conf' if '/usr/local' in path.writable() else '/opt/rke2/share/rke2/rke2-cis-sysctl.conf' }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: '0600'
  notify:
    - Restart systemd-sysctl

- name: Flush handlers
  meta:
    flush_handlers: yes


