content='```yml\n---\n- name: RKE2 Configuration\n  hosts: all\n  gather_facts: true\n  vars:\n    rke2_config: /path/to/rke2/config\n    rke2_custom_registry_path: /path/to/custom/registry\n    rke2_custom_registry_mirrors: []\n    rke2_custom_registry_configs: []\n    rke2_kubelet_config: \'\'\n    rke2_type: server\n    rke2_cni: none\n    rke2_cluster_group_name: rke2_cluster\n    rke2_server_node_taints:\n      rke2_server_node_taints: \'node.kubernetes.io/rke2-server=true:NoSchedule\'\n\n  tasks:\n  - name: Create the RKE2 configuration directory\n    become: yes\n    file:\n      path: /etc/rancher/rke2\n      state: directory\n      owner: root\n      group: root\n      mode: \'0755\'\n\n  - name: Set server-specific node taints\n    set_fact:\n      rke2_server_node_taints: "{{ rke2_server_node_taints | default({}) | combine({\'node.kubernetes.io/rke2-server\': \'NoSchedule\'}) }}"\n    when: rke2_type == \'server\'\n\n  - name: Template the RKE2 configuration file\n    become: yes\n    template:\n      src: "{{ rke2_config }}"\n      dest: /etc/rancher/rke2/config.yaml\n      owner: root\n      group: root\n      mode: \'0600\'\n    notify: Config file changed\n\n  - name: Template the kubelet configuration file\n    become: yes\n    template:\n      src: templates/kubelet-config.yaml.j2\n      dest: /etc/rancher/rke2/kubelet-config.yaml\n      owner: root\n      group: root\n      mode: \'0600\'\n    when: rke2_kubelet_config != \'\'\n    notify: Config file changed\n\n  - name: Configure Containerd registry settings\n    become: yes\n    copy:\n      content: "{{ rke2_custom_registry_mirrors | join(\'\\n\') }}"\n      dest: /etc/rancher/rke2/registries.yaml\n      owner: root\n      group: root\n      mode: \'0600\'\n    when: rke2_custom_registry_mirrors != [] or rke2_custom_registry_configs != []\n    notify: Config file changed\n\n  - name: Determine if an etcd restore from a file is necessary\n    set_fact:\n      do_etcd_restore: true\n    when:\n      - rke2_etcd_snapshot_file is defined\n      - (rke2_server.status == \'disabled\' or rke2_server.status == \'stopped\')\n\n  - name: Determine if an etcd restore from S3 is necessary\n    set_fact:\n      do_etcd_restore_from_s3: true\n    when:\n      - rke2_etcd_snapshot_file is defined\n      - rke2_etcd_snapshot_s3_bucket is defined\n      - rke2_etcd_snapshot_s3_object_key is defined\n\n  - name: Restore etcd from a snapshot file\n    become: yes\n    block:\n      - name: Create the snapshot directory\n        file:\n          path: /etc/rancher/rke2/etcd-snapshots\n          state: directory\n          owner: root\n          group: root\n          mode: \'0755\'\n\n      - name: Copy the snapshot file\n        copy:\n          content: "{{ lookup(\'file\', rke2_etcd_snapshot_file) }}"\n          dest: /etc/rancher/rke2/etcd-snapshots/{{ rke2_etcd_snapshot_file }}.snapshot\n          owner: root\n          group: root\n          mode: \'0600\'\n\n      - name: Restore etcd from the snapshot\n        command:\n          cmd: rke2 server restore /etc/rancher/rke2/etcd-snapshots/{{ rke2_etcd_snapshot_file }}.snapshot\n          chdir: /etc/rancher/rke2\n        register: rke2_restore_output\n        changed_when: false\n\n    when: do_etcd_restore\n\n  - name: Restore etcd from an S3 snapshot\n    become: yes\n    block:\n      - name: Restore etcd from the S3 snapshot\n        command:\n          cmd: rke2 server restore --s3-bucket="{{ rke2_etcd_snapshot_s3_bucket }}" --s3-object-key="{{ rke2_etcd_snapshot_s3_object_key }}" --s3-region="{{ rke2_etcd_snapshot_s3_region }}"\n          chdir: /etc/rancher/rke2\n        register: rke2_restore_output\n        changed_when: false\n\n    when: do_etcd_restore_from_s3\n\n  - name: Start the RKE2 server service\n    become: yes\n    service:\n      name: rke2-server.service\n      state: started\n      enabled: true\n      env:\n        RKE2_TOKEN: "{{ rke2_token }}"\n    notify: Service (re)started\n\n  - name: Mask the RKE2 agent service\n    become: yes\n    service:\n      name: rke2-agent.service\n      state: masked\n\n  - name: Wait for the first server to be ready without CNI\n    become: yes\n    block:\n      - name: Wait for the server to be ready\n        kubernetes_info:\n          api_version: v1\n          kind: Node\n          field_selector:\n            name: "{{ inventory_hostname }}"\n        register: rke2_node_info\n\n      - name: Check the server readiness status\n        kubernetes_info:\n          api_version: v1\n          kind: Node\n          field_selector:\n            name: "{{ inventory_hostname }}"\n        register: rke2_node_info\n        until: rke2_node_info.items[0].status.conditions[0].status == \'True\'\n        retries: 100\n        delay: 15\n\n    when: rke2_cni == \'none\'\n\n  - name: Wait for the first server to be ready with CNI\n    become: yes\n    block:\n      - name: Check the server readiness status\n        kubernetes_info:\n          api_version: v1\n          kind: Node\n          field_selector:\n            name: "{{ inventory_hostname }}"\n        register: rke2_node_info\n        until: rke2_node_info.items[0].status.conditions[0].status == \'True\'\n        retries: 40\n        delay: 15\n\n    when: rke2_cni != \'none\'\n\n  - name: Clean up old nodes and secrets if restoring etcd\n    block:\n      - name: Retrieve registered node names\n        kubernetes_info:\n          api_version: v1\n          kind: Node\n          field_selector:\n            name: "{{ inventory_hostname }}"\n        register: rke2_node_info\n\n      - name: Identify nodes no longer present\n        set_fact:\n          rke2_old_nodes: "{{ rke2_node_info.items | difference(rke2_node_info.items, rke2_nodes_to_keep) }}"\n\n      - name: Delete associated secrets and nodes\n        kubernetes:\n          api_version: v1\n          kind: Secret\n          name: "{{ item }}"\n          namespace: "{{ item }}"\n          state: absent\n        lo