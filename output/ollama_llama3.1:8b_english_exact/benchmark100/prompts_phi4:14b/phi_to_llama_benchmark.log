    loop:
      - { path: "{{ dns_datadir }}" }
      - { path: "{{ dns_confdir }}" }

  - name: Create a group for DNS service
    group:
      name: "{{ dns_group }}"
      state: present

  - name: Create a user for the DNS service
    user:
      name: "{{ dns_owner }}"
      system: yes
      create_home: no
      group: "{{ dns_group }}"

  - name: Generate the rndc key for DNS configuration
    command:
      cmd: rndc-keygen
      creates: "{{ dns_confdir }}/rndc.key"
      when: dns_service == 'bind9'

  - name: Set file permissions for the rndc key
    file:
      path: "{{ dns_confdir }}/rndc.key"
      state: file
      mode: '0640'
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"

  - name: Download the root hints file if DNS caching is enabled
    get_url:
      url: "{{ dns_root_hints_url }}"
      dest: "{{ dns_datadir }}/root.hints"
      mode: '0644'
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
    when: dns_caching is defined

  - name: Create primary zone files from templates
    template:
      src: "{{ item.src }}"
      dest: "{{ dns_datadir }}/{{ item.dest }}"
      mode: '0644'
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      validate: "named-checkzone {{ item.zone }} {{ dns_datadir }}/{{ item.dest }}"
    loop:
