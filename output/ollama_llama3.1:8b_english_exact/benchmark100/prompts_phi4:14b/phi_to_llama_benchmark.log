---
- name: Create RKE2 manifests directory
  file:
    path: /etc/rke2/manifests
    state: directory
    owner: root
    group: root
    mode: '0700'

- name: Copy kube-vip files to the first server
  copy:
    src: "{{ item }}"
    dest: /etc/rke2/manifests
    mode: '0644'
  loop:
    - templates/kube-vip.yaml.j2
  notify: restart k8s

- name: Copy kube-vip load balancer manifests to the first server
  copy:
    src: "{{ item }}"
    dest: /etc/rke2/manifests
