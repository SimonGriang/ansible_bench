- name: Tasks for Java JDK Installation and Configuration
  tasks:

  - name: Migrate Java JDK Vendor from AdoptOpenJDK to Temurin
    set_fact:
      java_jdk_vendor: "temurin"
    when: "'adoptopenjdk' == java_jdk_vendor"

  - name: Gather OS-Specific Variables for Java JDK
    include_vars:
      file: "vars/defaults"
      options:
        mode: 'hash'
        lookup: 'template'
        template: "{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.j2"

  - name: Gather Architecture-Specific Variables for Java JDK
    include_vars:
      file: "vars/defaults"
      options:
        mode: 'hash'
        lookup: 'template'
        template: "{{ java_jdk_vendor }}_{{ ansible_architecture }}.j2"

  - name: Set OS-Specific Java Variables
    set_fact:
      java_jdk_version: "{{ java_jdk_version | default('') }}"
      java_jdk_major_version: "{{ java_jdk_major_version | default('') }}"
    when: "'{{ java_jdk_version }}' == '' or '{{ java_jdk_major_version }}' == ''"

  - name: Set OS and Architecture-Specific Java Variables
    set_fact:
      java_jdk_version: "{{ java_jdk_version | default('') }}"
      java_jdk_major_version: "{{ java_jdk_major_version | default('') }}"
    when: "'{{ java_jdk_version }}' == '' or '{{ java_jdk_major_version }}' == ''"

  - name: Set Java Home Variable
    set_fact:
      java_home: "{{ java_home | default('/usr/lib/jvm/{{ java_jdk_vendor }}-{{ java_jdk_version }}') }}"

  - name: Handle Debian Pre-Requisites for Java Installation
    block:
      - name: Remove Deprecated Repositories
        apt:
          purge: yes
          autoclean: yes
          cache_valid_time: 0

      - name: Install Extra Packages
        apt:
          name: "{{ item }}"
          state: present
          cache_valid_time: 0
        loop:
          - "{{ java_jdk_vendor }}-{{ java_jdk_version }}"
          - "{{ java_jdk_vendor }}-{{ java_jdk_version }}-jdk-headless"

      - name: Add Key Repositories
        apt_key:
          url: "https://download.java.com/cp/openjdk-{{ java_jdk_version }}.asc"
          state: present

      - name: Add Required Repositories
        apt_repository:
          name: "{{ java_jdk_vendor }}-{{ java_jdk_version }}"
          state: present

  - name: Handle RedHat Pre-Requisites for Java Installation
    block:
      - name: Add Key Repositories
        rpm_key:
          state: present
          id: "{{ java_jdk_vendor }}-{{ java_jdk_version }}"

      - name: Add Required Repositories
        package:
          name: "{{ java_jdk_vendor }}-{{ java_jdk_version }}-jdk"
          state: present

  - name: Install Required Libraries for Java
    package:
      name: "{{ item }}"
      state: present
      cache_valid_time: 0
    loop:
      - "{{ java_jdk_vendor }}-{{ java_jdk_version }}"
      - "{{ java_jdk_vendor }}-{{ java_jdk_version }}-jdk-headless"

  - name: Install Java on Debian Systems
    apt:
      name: "{{ java_jdk_vendor }}-{{ java_jdk_version }}"
      state: present
      cache_valid_time: 0

  - name: Install Java on RedHat Systems
    yum:
      name: "{{ java_jdk_vendor }}-{{ java_jdk_version }}"
      state: present
      cache_valid_time: 0

  - name: Export Java Environment Variables
    template:
      src: "jdk.sh.j2"
      dest: "/etc/java/alternatives/jdk.sh"
      mode: '0644'

  - name: Source Java Environment Variables
    shell: "source /etc/java/alternatives/jdk.sh"

  - name: Correct Java Version Selection for Versions Less Than 11 on Debian Systems
    alternatives:
      name: java
      state: present
      path: "/usr/lib/jvm/{{ java_jdk_vendor }}-{{ java_jdk_version }}/bin/java"

  - name: Correct Java Version Selection for Versions 11 or Greater on Debian Systems
    alternatives:
      name: java
      state: present
      path: "/usr/lib/jvm/{{ java_jdk_vendor }}-{{ java_jdk_version }}.11+/bin/java"

