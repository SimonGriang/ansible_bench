---
- name: Install SSL packages
  apt:
    name: '{{ httpd_ssl_packages }}'
    state: present

- name: Place SSL configuration file
  template:
    src: 'ssl.conf.j2'
    dest: '{{ httpd_config_directory }}/ssl.conf'
    mode: '0644'
  notify:
    - restart httpd
  handler:
    - name: restart httpd
      service:
        name: httpd
        state: restarted
  when: ssl_config_changed

- name: Configure HTTP to HTTPS redirect
  template:
    src: 'default_vhost.conf.j2'
    dest: '{{ httpd_config_directory }}/{{ default_vhost_conf }}'
    mode: '0644'
  notify:
    - restart httpd
  handler:
    - name: restart httpd
      service:
        name: httpd
        state: restarted
  when: vhost_config_changed


