content='Here is the Ansible Playbook that meets the given requirements:\n\n```\n---\n- name: Task 1 - Import assert.yml only once and delegate to localhost\n  import_tasks: assert.yml\n  delegate_to: localhost\n  delegate_facts: no\n\n- name: Task 2 - Install Python pip using the specified package name\n  apt:\n    name: "{{ python_pip_packages }}"\n    state: present\n\n- name: Task 3 - Configure pip proxy settings if the proxy is defined\n  lineinfile:\n    dest: /etc/pip.conf\n    section: global\n    line: "index-url = https://{{ python_pip_proxy }}/"\n  when: python_pip_proxy is defined\n\n- name: Task 4 - Set trusted hosts for pip if specified\n  lineinfile:\n    dest: /etc/pip.conf\n    section: global\n    line: "trusted-host = {{ python_pip_trusted_host }}"\n  when: python_pip_trusted_host is defined\n\n- name: Task 5 - Update pip to the latest version under specific conditions\n  apt:\n    name: "{{ python_pip_pip_package }}"\n    state: latest\n  when:\n    - python_pip_update\n    - ansible_distribution_release not in [\'bookworm\', \'noble\']\n    - ansible_os_family != \'Alpine\'\n\n- name: Task 6 - Install requested Python pip modules based on conditions\n  pip:\n    name: "{{ item }}"\n    state: present\n  loop: "{{ python_pip_modules }}"\n  when:\n    - ansible_distribution_release not in [\'bookworm\', \'noble\']\n    - ansible_os_family != \'Alpine\'\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-14T20:30:40.15694002Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3128346770, 'load_duration': 96345735, 'prompt_eval_count': 591, 'prompt_eval_duration': 130857219, 'eval_count': 347, 'eval_duration': 2900212826, 'model_name': 'llama3.1:8b'} id='run--b802397d-c205-4d11-83ec-cfe3bc7c60b3-0' usage_metadata={'input_tokens': 591, 'output_tokens': 347, 'total_tokens': 938}
