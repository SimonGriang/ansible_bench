---
- name: Configure Apache HTTP Server
  hosts: localhost

  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install Apache HTTP Server
    ansible.builtin.package:
      name: "{{ httpd_packages }}"
      state: present

  - name: Configure SELinux
    ansible.builtin.seboolean:
      name: "{{ httpd_sebooleans }}"
      state: enabled
    when: selinux_enabled
  - name: Configure SELinux ports
    ansible.builtin.seport:
      name: "{{ httpd_port }},{{ httpd_ssl_port | default('443') }}"
      state: present
    when: selinux_enabled
  - name: Allow connections to custom ports
    ansible.builtin.seport:
      name: "{{ httpd_port }},{{ httpd_ssl_port | default('443') }}"
      state: present
    when: selinux_enabled

  - name: Configure main Apache HTTP Server configuration
    ansible.builtin.template:
      src: "{{ httpd_config_src }}"
      dest: "{{ httpd_config_dest }}"
      mode: '0644'
    notify: httpd restart

  - name: Activate Apache HTTP Server modules on Debian systems
    ansible.builtin.shell:
      cmd: "a2enmod {{ httpd_modules_to_activate_with_command }}"
    when: ansible_distribution == 'Debian'

  - name: Import SSL configuration tasks if HTTPS is enabled
    import_tasks: ssl.yml
    when: https_ssl_enable

  - name: Import location configuration tasks if locations are defined
    import_tasks: locations.yml
    when: httpd_locations is defined

  - name: Import virtual host configuration tasks if virtual hosts are defined
    import_tasks: vhosts.yml
    when: httpd_vhosts is defined

  - name: Configure ports for Debian and SUSE systems
    ansible.builtin.template:
      src: "{{ httpd_ports_conf }}"
      dest: "/etc/apache2/ports.conf"
      mode: '0644'
    notify: httpd restart
    when: (ansible_distribution == 'Debian' or ansible_distribution == 'SUSE')

  - name: Import directory configuration tasks if directories are defined
    import_tasks: directories.yml
    when: httpd_directories is defined

  - name: Flush all pending handlers
    ansible.builtin.meta: flush_handlers

  - name: Remove default HTML index file if specified
    ansible.builtin.file:
      path: "/var/www/html/index.html"
      state: absent
    when: httpd_remove_example

  - name: Start and enable Apache HTTP Server service
    ansible.builtin.service:
      name: httpd
      state: started
      enabled: yes


