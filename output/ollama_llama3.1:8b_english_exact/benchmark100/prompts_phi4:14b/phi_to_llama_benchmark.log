---
- name: Generate SSL certificates and keys
  hosts: localhost
  vars:
    ssl_key_path: /path/to/ssl/private/keys
    ssl_csr_path: /path/to/ssl/csr
    ssl_cert_path: /path/to/ssl/certs
    ssl_pkcs12_path: /path/to/ssl/pkcs12

  tasks:
  - name: Generate SSL private key files for each item
    community.crypto.openssl_privatekey:
      path: "{{ ssl_key_path }}/{{ item }}"
      state: present
      mode: '0600'
      owner: "{{ item }}"
      group: "{{ item }}"
    loop: "{{ ssl_items }}"

  - name: Generate SSL CSR (Certificate Signing Request) files for each item
    community.crypto.openssl_csr:
      path: "{{ ssl_csr_path }}/{{ item }}"
      state: present
      csr: "{{ ssl_key_path }}/{{ item }}"
      common_name: "{{ item }}"
      mode: '0644'
      owner: "{{ item }}"
      group: "{{ item }}"
    loop: "{{ ssl_items }}"

  - name: Generate SSL certificates for each item
    community.crypto.x509_certificate:
      path: "{{ ssl_cert_path }}/{{ item }}"
      state: present
      csr: "{{ ssl_csr_path }}/{{ item }}"
      key: "{{ ssl_key_path }}/{{ item }}"
      mode: '0644'
      owner: "{{ item }}"
      group: "{{ item }}"
    loop: "{{ ssl_items }}"

  - name: Create PKCS#12 files for each item
    community.crypto.openssl_pkcs12:
      path: "{{ ssl_pkcs12_path }}/{{ item }}"
      state: present
      key: "{{ ssl_key_path }}/{{ item }}"
      cert: "{{ ssl_cert_path }}/{{ item }}"
      friendly_name: "{{ item }}"
      mode: '0644'
      owner: "{{ item }}"
      group: "{{ item }}"
    loop: "{{ ssl_items }}"

  - name: Read and register the content of the private key files for each item
    ansible.builtin.slurp:
      src: "{{ ssl_key_path }}/{{ item }}"
      dest: "{{ ssl_key_path }}/{{ item }}_content"
    register: ssl_key_content
    loop: "{{ ssl_items }}"

  - name: Read and register the content of the certificate files for each item
    ansible.builtin.slurp:
      src: "{{ ssl_cert_path }}/{{ item }}"
      dest: "{{ ssl_cert_path }}/{{ item }}_content"
    register: ssl_cert_content
    loop: "{{ ssl_items }}"

  - name: Combine the registered private key and certificate content into a single file for each item
    ansible.builtin.copy:
      content: "{{ ssl_key_content[item].content }}{{ ssl_cert_content[item].content }}"
      dest: "{{ ssl_pkcs12_path }}/{{ item }}_combined"
      mode: '0644'
      owner: "{{ item }}"
      group: "{{ item }}"
    loop: "{{ ssl_items }}"


