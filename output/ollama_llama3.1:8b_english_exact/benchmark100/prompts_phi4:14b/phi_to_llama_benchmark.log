---
- name: Ensure the system is using systemd as the init system
  assert:
    that: ansible_service_mgr == 'systemd'
    message: |
      This playbook only works with systemd as the init system.

- name: Retrieve the latest release information for Grafana Loki from GitHub
  uri:
    url: 'https://api.github.com/repos/grafana/loki/releases/latest'
    method: GET
    headers:
      Accept: 'application/json'
      Authorization: 'Bearer {{ grafana_loki_github_token }}'
    status:
      - 200
    retry: 5
    retries: 5
  register: release_info
  when: promtail_version != 'latest'

- name: Set promtail version from release info
  set_fact:
    promtail_version: "{{ release_info.json.tag_name }}"

- name: Verify the existence of a local promtail binary archive
  stat:
    path: "{{ promtail_binary_local_dir }}/{{ promtail_version }}/promtail"
  when: promtail_binary_local_dir is defined
  failed_when: False
  register: local_promtail_stat
  msg: |
    Local promtail binary archive not found at {{ promtail_binary_local_dir }}/{{ promtail_version }}/promtail

- name: Download and verify the checksum for the promtail binary if not using a local binary
  when: promtail_binary_local_dir is not defined
  uri:
    url: "{{ lookup('url', 'https://github.com/grafana/loki/releases/download/' + promtail_version + '/promtail-' + promtail_version + '-linux-amd64.sha256') }}"
    method: GET
    headers:
      Accept: 'application/json'
      Authorization: 'Bearer {{ grafana_loki_github_token }}'
    status:
      - 200
    retry: 5
    retries: 5
  register: promtail_checksum
  until: promtail_checksum.status == 200
  retries: 5
  delay: 1
  failed_when: promtail_checksum.status != 200


