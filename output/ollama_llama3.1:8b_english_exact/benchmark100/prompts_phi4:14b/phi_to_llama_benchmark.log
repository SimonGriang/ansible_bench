--- 

- name: Enable Apache2 modules
  apt:
    name: apache2
    state: present
  when: ansible_distribution in ['Debian', 'Ubuntu']

- name: Enable Apache2 modules
  apt:
    name: apache2-mod_proxy
    state: present
  when: ansible_distribution in ['Suse']

- name: Enable Apache2 modules
  apt:
    name: apache2-mod_proxy_http
    state: present
  when: ansible_distribution in ['Suse']

- name: Configure Apache2 locations
  template:
    src: location.conf.j2
    dest: /etc/apache2/conf.d/{{ item.path }}
    mode: '0644'
  loop: "{{ httpd_locations }}"
  notify: httpd restart

- name: Configure Apache2 locations
  template:
    src: location.conf.j2
    dest: /etc/apache2/conf.d/{{ item.path }}
    mode: '0644'
  loop: "{{ httpd_locations }}"
  notify: httpd restart

- name: Trigger handlers to validate and restart HTTPD
  service:
    name: apache2
    state: restarted
    enabled: true
  notify: httpd restart

