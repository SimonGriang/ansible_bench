      name: rndc-keygen
      creates: "{{ dns_confdir }}/rndc.key"
      when: dns_service == 'bind9'

  - name: Set file permissions for the rndc key
    file:
      path: "{{ dns_confdir }}/rndc.key"
      state: file
      mode: '0640'
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"

  - name: Download the root hints file if DNS caching is enabled
    get_url:
      url: "{{ dns_root_hints_url }}"
      dest: "{{ dns_datadir }}/root.hints"
      mode: '0644'
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
    when: dns_caching

  - name: Create primary zone files from templates
    template:
      src: "{{ item.src }}"
      dest: "{{ dns_datadir }}/{{ item.dest }}"
      mode: '0644'
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      validate: "named-checkzone {{ item.zone }} {{ dns_datadir }}/{{ item.dest }}"
    loop:
      - { src: 'named.conf.default', dest: 'named.conf.default', zone: '{{ item.zone }}' }
      - { src: 'named.conf.default', dest: 'named.conf.default', zone: '{{ item.zone }}' }

  - name: Add DNS zones to the main configuration file
    template:
      src: 'named.conf.default.j2'
      dest: '{{ dns_confdir }}/named.conf'
      mode: '0644'
      owner: '{{ dns_owner }}'
      group: '{{ dns_group }}'
      validate: 'named-checkconf -z {{ dns_datadir }}/named.conf'

  - name: Create systemd service override if using systemd
    file:
      path: '/etc/systemd/system/dns.service.d/override.conf'
      state: file
      mode: '0644'
      owner: 'root'
      group: 'root'
    when: dns_service == 'bind9'

  - name: Start and enable the DNS service
    service:
      name: "{{ dns_service }}"
      state: started
      enabled: yes

