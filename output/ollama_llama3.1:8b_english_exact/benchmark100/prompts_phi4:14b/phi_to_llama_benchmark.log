content='```yml\n---\n- name: Configure Docker\n  tasks:\n  - name: Remove obsolete Docker packages\n    package_remove:\n      name: "{{ docker_obsolete_packages }}"\n\n  - name: Add Docker GPG key\n    apt_key:\n      keyserver: \'{{ docker_yum_gpg_key }}\'\n      state: present\n    when: docker_add_repo == true\n\n  - name: Add Docker repository\n    yum_repository:\n      name: "{{ docker_edition }}"\n      description: "{{ docker_edition }} repo"\n      baseurl: "{{ docker_yum_repo_url }}"\n      file: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n      enabled: yes\n      gpgcheck: yes\n      gpgkey: "{{ docker_yum_gpg_key }}"\n    when: docker_add_repo == true\n\n  - name: Configure Docker Nightly repo\n    lineinfile:\n      dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n      line: "enabled={{ docker_yum_repo_enable_nightly }}"\n      state: present\n      regexp: "^enabled"\n    when: docker_add_repo == true\n\n  - name: Configure Docker Test repo\n    lineinfile:\n      dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n      line: "enabled={{ docker_yum_repo_enable_test }}"\n      state: present\n      regexp: "^enabled"\n    when: docker_add_repo == true\n\n  - name: Configure containerd on RHEL 8\n    when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"\n    block:\n      - name: Uninstall runc\n        package:\n          name: runc\n          state: absent\n      - name: Install container-selinux\n        package:\n          name: container-selinux\n          state: present\n      - name: Install containerd.io\n        package:\n          name: containerd.io\n          state: present\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-14T20:15:57.765133139Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4286416408, 'load_duration': 118803708, 'prompt_eval_count': 600, 'prompt_eval_duration': 156667284, 'eval_count': 417, 'eval_duration': 4009919875, 'model_name': 'llama3.1:8b'} id='run--aec20a5c-af32-4f51-a30d-c1e4317f34d7-0' usage_metadata={'input_tokens': 600, 'output_tokens': 417, 'total_tokens': 1017}
