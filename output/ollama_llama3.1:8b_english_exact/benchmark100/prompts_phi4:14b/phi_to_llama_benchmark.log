---
- name: Configure rsyslog
  hosts: localhost
  gather_facts: no

  tasks:
  - name: Import assertion tasks
    include: ../tasks/assert.yml

  - name: Uninstall systemd-logger
    package:
      name: systemd-logger
      state: absent

  - name: Install rsyslog
    package:
      name: "{{ item }}"
      state: "{{ rsyslog_package_state }}"
    loop: "{{ rsyslog_packages }}"
    loop_control:
      persistent: yes

  - name: Install additional rsyslog features
    package:
      name: "{{ item }}"
      state: "{{ rsyslog_package_state }}"
    loop: "{{ rsyslog_features }}"
    loop_control:
      persistent: yes

  - name: Configure default rsyslog settings
    template:
      src: "rsyslog.conf.j2"
      dest: "{{ rsyslog_dest_conf_file }}"
      mode: '0644'
    when: rsyslog_deploy_default_config
    notify: restart rsyslog

  - name: Ensure rsyslog configuration directory exists
    file:
      path: "/etc/rsyslog.d/"
      state: directory
      mode: '0755'
      recurse: yes

  - name: Configure rsyslog to forward logs
    template:
      src: "forward_rule.conf.j2"
      dest: "/etc/rsyslog.d/{{ rsyslog_forward_rule_name }}"
      mode: '0644'
    when: not rsyslog_deploy_default_config
    notify: restart rsyslog

  - name: Configure additional rsyslog files
    template:
      src: "{{ item.file | default('template.j2') }}"
      dest: "{{ item.dest }}"
      mode: "{{ item.mode | default('0644') }}"
    loop: "{{ rsyslog_rsyslog_d_files }}"
    loop_control:
      persistent: yes
    notify: restart rsyslog
    when: item.state == 'present'

  - name: Start and enable rsyslog service
    service:
      name: "{{ rsyslog_service }}"
      state: started
      enabled: yes


