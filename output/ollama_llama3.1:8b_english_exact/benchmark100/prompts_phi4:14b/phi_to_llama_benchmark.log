- name: Check Java certificates
  stat:
    path: /usr/lib/jvm/java-8-oracle/jre/lib/security/cacerts
    register: cacerts
  delegate_to: localhost

- name: Check Java certificates
  stat:
    path: /usr/lib/jvm/java-11-oracle/lib/security/cacerts
    register: cacerts11
  delegate_to: localhost

- name: Fail the playbook if any Java certificate is missing
  fail:
    msg: 'Java certificate(s) missing: {{ cacerts.stat.exists|ternary(cacerts.stat.path, "") }} {{ cacerts11.stat.exists|ternary(cacerts11.stat.path, "") }}'
  when: (cacerts.stat.exists == False) or (cacerts11.stat.exists == False)

- name: Set keystore directory for Java versions less than 11
  set_fact:
    keystore_dir: '/usr/lib/jvm/java-{{ java_version }}-openjdk-amd64/jre/lib/security/'

- name: Set keystore directory for Java versions 11 and above
  set_fact:
    keystore_dir: '/usr/lib/jvm/java-{{ java_version }}-openjdk-amd64/lib/security/'

- name: Import SSL certificates into the Java keystore
  java_cert:
    src: '/path/to/certificate.pem'
    dest: '{{ keystore_dir }}cacerts'
    state: present
  delegate_to: localhost

  java_cert:
    src: '/path/to/certificate2.pem'
    dest: '{{ keystore_dir }}cacerts'
    state: present
  delegate_to: localhost

