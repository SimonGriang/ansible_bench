---
- name: Vault Configuration Tasks
  tasks:
  - include_tasks: assert.yml
    delegate_to: localhost
    when: vault_installation_method != 'builtin'

  - name: Install necessary prerequisites for Vault
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ vault_prerequisites }}"

  - name: Include tasks specific to the installation method
    include_tasks: "{{ vault_installation_method }}.yml"
    when: vault_installation_method != 'builtin'

  - name: Add environment variables for Vault
    lineinfile:
      dest: /etc/vault.d/vault.env
      line: "{{ item }}"
      create: yes
    notify: restart Vault
    loop:
      - "VAULT_ADDR=http://{{ vault_address }}:8200"
      - "VAULT_SKIP_VERIFY=true"
      - "VAULT_CACERT=/etc/vault.d/ca.crt"

  - include_tasks: hardening.yml

  - name: Start and enable Vault service for Open Source Software (OSS)
    service:
      name: vault
      state: started
      enabled: true
    when: vault_type == 'oss'

  - name: Enable Vault service for non-OSS versions
    service:
      name: vault
      enabled: true
    when: vault_type != 'oss'


