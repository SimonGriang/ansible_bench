---
- name: Download RKE2 installation script if not in airgap mode
  when: rke2_airgap_mode != 'true'
  get_url:
    url: https://get.rke2.io
    dest: /tmp/rke2-install.sh
    mode: '0755'
    timeout: 300

- name: Copy local RKE2 installation script if in airgap mode using the 'copy' method
  when: rke2_airgap_mode == 'true' and rke2_airgap_implementation == 'copy'
  copy:
    src: /path/to/local/rke2-install.sh
    dest: /tmp/rke2-install.sh
    mode: '0755'
    force: true

- name: Create RKE2 artifacts folder if in airgap mode and the implementation is not 'exists'
  when: rke2_airgap_mode == 'true' and rke2_airgap_implementation != 'exists'
  file:
    path: /var/lib/rke2
    state: directory
    mode: '0755'

- name: Download RKE2 checksum and artifacts with a fallback mechanism for airgap mode using the 'download' method
  block:
  - name: Download RKE2 checksum and artifacts
    get_url:
      url: https://example.com/rke2-checksum.txt
      dest: /tmp/rke2-checksum.txt
      mode: '0644'
      timeout: 300
  - name: Checksum validation
    assert:
      that: sha256sum == rke2_checksum
      msg: Checksum mismatch
  - name: Download RKE2 installation script
    get_url:
      url: https://example.com/rke2-install.tar.gz
      dest: /tmp/rke2-install.tar.gz
      mode: '0644'
      timeout: 300
  rescue:
  - name: Download RKE2 installation script (local fallback)
    copy:
      src: /path/to/local/rke2-install.tar.gz
      dest: /tmp/rke2-install.tar.gz
      mode: '0644'
      force: true
  - name: Upload RKE2 installation script to remote host
    copy:
      content: '{{ lookup("file", "/tmp/rke2-install.tar.gz") }}'
      dest: /tmp/rke2-install.tar.gz
      mode: '0644'
      force: true

- name: Copy local RKE2 artifacts if in airgap mode using the 'copy' method
  when: rke2_airgap_mode == 'true' and rke2_airgap_implementation == 'copy'
  copy:
    src: /path/to/local/rke2-artifacts.tar.gz
    dest: /var/lib/rke2/rke2-artifacts.tar.gz
    mode: '0644'
    force: true

- name: Handle additional tarballs in airgap mode if not using 'exists' implementation
  when: rke2_airgap_mode == 'true' and rke2_airgap_implementation != 'exists'
  block:
  - name: Create directory for additional tarballs
    file:
      path: /var/lib/rke2/additional-tarballs
      state: directory
      mode: '0755'
  - name: Copy additional tarballs
    copy:
      src: /path/to/local/additional-tarballs.tar.gz
      dest: /var/lib/rke2/additional-tarballs.tar.gz
      mode: '0644'
      force: true

- name: Ensure artifacts exist and have acceptable permissions in airgap mode with 'exists' implementation
  when: rke2_airgap_mode == 'true' and rke2_airgap_implementation == 'exists'
  block:
  - name: Check existence of artifacts
    stat:
      path: /var/lib/rke2/rke2-artifacts.tar.gz
      state: file
  - name: Set permissions for artifacts
    file:
      path: /var/lib/rke2/rke2-artifacts.tar.gz
      mode: '0644'
      state: file
  - name: Check execution permission for installation script
    stat:
      path: /tmp/rke2-install.sh
      state: file
      follow: true

- name: Populate service facts to gather information about system services
  service_facts:
    gather_subset: ['core']

- name: Get filesystem statistics for the /usr/local directory
  filesystem_stats:
    path: /usr/local
    stats: true
  register: filesystem_stats

- name: Check if /usr/local is on a separate partition
  stat:
    path: /proc/mounts
  register: mount_info
  when: filesystem_stats.filesystem_stats['/usr/local']['mountpoint'] != '/'

- name: Determine the RKE2 binary path based on filesystem checks
  set_fact:
    rke2_binary_path: '/usr/local/bin/rke2'
  when: filesystem_stats.filesystem_stats['/usr/local']['is_writeable'] == true or mount_info.stat.ismounted == true

- name: Check the installed and running RKE2 versions
  shell:
    cmd: 'rke2 version --json'
  register: rke2_version
  changed_when: false
  when: rke2_binary_path != '/usr/local/bin/rke2'

- name: Set RKE2 version facts based on the version check results
  when: not ansible_check_mode
  set_fact:
    rke2_version_installed: rke2_version.stdout_json['installed_version']
    rke2_version_running: rke2_version.stdout_json['running_version']

- name: Prevent accidental RKE2 downgrade unless explicitly allowed
  assert:
    that: rke2_version_installed != rke2_version_running or rke2_allow_downgrade
    msg: Downgrade detected without permission

- name: Run RKE2 install script if the version needs to be updated
  block:
  - name: Set environment variables
    set_fact:
      RKE2_VERSION: rke2_version_running
      RKE2_BINARY_PATH: rke2_binary_path
  - name: Run RKE2 installation script
    shell:
      cmd: '/tmp/rke2-install.sh'
      chdir: '/tmp'
      creates: /usr/local/bin/rke2

- name: Copy custom manifests if they are defined
  when: rke2_custom_manifests is defined and rke2_custom_manifests != []
  copy:
    src: '{{ item }}'
    dest: '/etc/kubernetes/manifests/{{ item }}'
    mode: '0644'
    force: true
  loop: '{{ rke2_custom_manifests }}'

- name: Copy static pods if they are defined
  when: rke2_static_pods is defined and rke2_static_pods != []
  copy:
    src: '{{ item }}'
    dest: '/var/lib/rke2/agent/pod-manifests/{{ item }}'
    mode: '0644'
    force: true
  loop: '{{ rke2_static_pods }}'

- name: Copy RKE2 environment file if environment options are defined
  when: rke2_environment_options is defined and rke2_environment_options != {}
  template:
    src: /path/to/rke2-environment.j2
    dest: /etc/kubernetes/manifests/rke2-environment.yaml
    mode: '0644'
    force: true


