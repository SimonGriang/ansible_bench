---
- import_tasks: assert.yml
  delegate_to: localhost
  delegate_facts: yes

- name: Enable Redis module
  module: dnf
  config_name: redis
  config_file: /etc/yum.repos.d/redis.repo
  state: enabled
  when: ansible_distribution == 'RedHat' and ansible_distribution_major_version == '8'

- name: Install Redis packages
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure Redis
  template:
    src: redis.conf.j2
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    mode: "{{ redis_mode }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
  notify:
    - restart redis

- name: Start and enable Redis service
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes


