      dest: /etc/rancher/rke2/registries.yaml
      owner: root
      group: root
      mode: '0600'
    when: custom_registry_mirrors or (rke2_custom_registry_path is defined and rke2_custom_registry_path != false)
    notify: Config file changed

  - name: Start the RKE2 service on all nodes
