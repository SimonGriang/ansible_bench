---
- name: Download RKE2 installation script if not in airgap mode
  when: rke2_airgap_mode != 'true'
  get_url:
    url: https://get.rke2.io
    dest: /tmp/rke2-install.sh
    mode: '0755'
    timeout: 300

- name: Copy local RKE2 installation script if in airgap mode using the 'copy' method
  when: rke2_airgap_mode == 'true' and rke2_airgap_implementation == 'copy'
  copy:
    src: /path/to/local/rke2-install.sh
    dest: /tmp/rke2-install.sh
    mode: '0755'
    force: true

- name: Create RKE2 artifacts folder if in airgap mode and the implementation is not 'exists'
  when: rke2_airgap_mode == 'true' and rke2_airgap_implementation != 'exists'
  file:
    path: /var/lib/rke2
    state: directory
    mode: '0755'

- name: Download RKE2 checksum and artifacts with a fallback mechanism for airgap mode using the 'download' method
  block:
  - name: Download RKE2 checksum and artifacts
    get_url:
      url: https://example.com/rke2-checksum.txt
      dest: /tmp/rke2-checksum.txt
      mode: '0644'
      timeout: 300
  - name: Checksum validation
    assert:
      that: sha256sum == rke2_checksum
      msg: Checksum mismatch
  - name: Download RKE2 installation script
    get_url:
      url: https://example.com/rke2-install.tar.gz
      dest: /tmp/rke2-install.tar.gz
      mode: '0644'
      timeout: 300
  rescue:
  - name: Download RKE2 installation script (local fallback)
    copy:
      src: /path/to/local/rke2-install.tar.gz
      dest: /tmp/rke2-install.tar.gz
      mode: '0644'
      force: true
