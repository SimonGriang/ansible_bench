--- 

- name: Import additional tasks from assert.yml, executing them on the localhost only once
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure the shell environment for cron
  template:
    src: cron.conf.j2
    dest: /etc/cron.d/crontab
    mode: '0600'
  notify:
    - Restart cron service

- name: Configure the PATH environment variable for cron
  lineinfile:
    dest: /etc/cron.d/crontab
    line: "PATH={{ cron_path }}\n"
    state: present
    mode: '0600'
  notify:
    - Restart cron service

- name: Configure the MAILTO environment variable for cron
  lineinfile:
    dest: /etc/cron.d/crontab
    line: "MAILTO={{ cron_mailto }}\n"
    state: present
    mode: '0600'
  notify:
    - Restart cron service

- name: Ensure the cron service is started and enabled
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service.name is not empty

- name: Schedule the specified cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    dayOfWeek: "{{ item.dayOfWeek }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined

