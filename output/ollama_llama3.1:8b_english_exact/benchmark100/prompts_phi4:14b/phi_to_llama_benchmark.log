ode == \'true\' and rke2_airgap_implementation == \'copy\'\n  copy:\n    src: /path/to/local/rke2-artifacts.tar.gz\n    dest: /var/lib/rke2/rke2-artifacts.tar.gz\n    mode: \'0644\'\n    force: true\n\n- name: Handle additional tarballs in airgap mode if not using \'exists\' implementation\n  when: rke2_airgap_mode == \'true\' and rke2_airgap_implementation != \'exists\'\n  block:\n  - name: Create directory for additional tarballs\n    file:\n      path: /var/lib/rke2/additional-tarballs\n      state: directory\n      mode: \'0755\'\n  - name: Copy additional tarballs\n    copy:\n      src: /path/to/local/additional-tarballs.tar.gz\n      dest: /var/lib/rke2/additional-tarballs.tar.gz\n      mode: \'0644\'\n      force: true\n\n- name: Ensure artifacts exist and have acceptable permissions in airgap mode with \'exists\' implementation\n  when: rke2_airgap_mode == \'true\' and rke2_airgap_implementation == \'exists\'\n  block:\n  - name: Check existence of artifacts\n    stat:\n      path: /var/lib/rke2/rke2-artifacts.tar.gz\n      state: file\n  - name: Set permissions for artifacts\n    file:\n      path: /var/lib/rke2/rke2-artifacts.tar.gz\n      mode: \'0644\'\n      state: file\n  - name: Check execution permission for installation script\n    stat:\n      path: /tmp/rke2-install.sh\n      state: file\n      follow: true\n\n- name: Populate service facts to gather information about system services\n  service_facts:\n    gather_subset: [\'core\']\n\n- name: Get filesystem statistics for the /usr/local directory\n  filesystem_stats:\n    path: /usr/local\n    stats: true\n  register: filesystem_stats\n\n- name: Check if /usr/local is on a separate partition\n  stat:\n    path: /proc/mounts\n  register: mount_info\n  when: filesystem_stats.filesystem_stats[\'/usr/local\'][\'mountpoint\'] != \'/\'\n\n- name: Determine the RKE2 binary path based on filesystem checks\n  set_fact:\n    rke2_binary_path: \'/usr/local/bin/rke2\'\n  when: filesystem_stats.filesystem_stat