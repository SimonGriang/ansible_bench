---
- name: Postfix configuration tasks
  include_tasks: assert.yml
  delegate_to: localhost

- name: Configure Debian systems for Postfix
  debconf:
    name: postfix/main_mailer_type
    value: "No configuration"
  when: ansible_distribution == "Debian"

- name: Install Postfix
  package:
    name: postfix
    state: present

- name: Conditionally install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when:
    - postfix_virtual_mailbox_maps | regex_search('mysql')
    - postfix_virtual_mailbox_domains | regex_search('mysql')
    - postfix_virtual_alias_maps | regex_search('mysql')

- name: Configure Postfix transport maps
  template:
    src: templates/transport.j2
    dest: /etc/postfix/transport
    notify:
      - validate_postfix_config
      - rebuild_postfix_transport_maps
  when: postfix_transport_maps_template is defined

- name: Configure Postfix header checks
  template:
    src: templates/header_checks.j2
    dest: /etc/postfix/header_checks
    notify:
      - validate_postfix_config
      - reload_postfix
  when: postfix_header_checks_template is defined

- name: Set values for Postfix main.cf (part 1)
  set_fact:
    postfix_recipient_restriction:
      - "reject_rbl_client zen.spamhaus.org"
      - "reject_rbl_client bl.spamcop.net"
    postfix_sender_restriction:
      - "reject_rbl_client zen.spamhaus.org"
      - "reject_rbl_client bl.spamcop.net"
  when:
    - postfix_recipient_access is defined
    - postfix_sender_access is defined

- name: Set values for Postfix main.cf (part 2)
  set_fact:
    mynetworks: "{{ postfix_mynetworks }}"
    mydestination: "{{ postfix_mydestination }}"
    relay_domains: "{{ postfix_relay_domains }}"
    smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions }}"
    smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions }}"
    virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains }}"
    virtual_alias_domains: "{{ postfix_virtual_alias_domains }}"
  when:
    - postfix_mynetworks is defined
    - postfix_mydestination is defined
    - postfix_relay_domains is defined
    - postfix_smtpd_recipient_restrictions is defined
    - postfix_smtpd_sender_restrictions is defined
    - postfix_virtual_mailbox_domains is defined
    - postfix_virtual_alias_domains is defined

- name: Configure Postfix main.cf
  template:
    src: templates/main.cf.j2
    dest: /etc/postfix/main.cf
    notify:
      - validate_postfix_config
      - restart_postfix
  when:
    - postfix_transport_maps_template is defined
    - postfix_header_checks_template is defined
    - postfix_recipient_access is defined
    - postfix_sender_access is defined

- name: Configure Postfix master.cf
  template:
    src: templates/master.cf.j2
    dest: /etc/postfix/master.cf
    notify:
      - validate_postfix_config
      - restart_postfix
  when:
    - postfix_transport_maps_template is defined
    - postfix_header_checks_template is defined
    - postfix_recipient_access is defined
    - postfix_sender_access is defined

- name: Create directories for TLS certificates and keys
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
  with_items:
    - { path: "/etc/postfix/ssl/certs", mode: "0755" }
    - { path: "/etc/postfix/ssl/private", mode: "0700" }
  when:
    - postfix_tls_certificate is defined
    - postfix_tls_private_key is defined

- name: Deploy Postfix TLS server certificate
  copy:
    content: "{{ postfix_tls_certificate }}"
    dest: "{{ postfix_tls_certificate_dest }}"
    mode: "{{ postfix_tls_certificate_mode }}"
  notify:
    - reload_postfix
  when: postfix_tls_certificate is defined

- name: Deploy Postfix TLS server key
  copy:
    content: "{{ postfix_tls_private_key }}"
    dest: "{{ postfix_tls_private_key_dest }}"
    mode: "{{ postfix_tls_private_key_mode }}"
  notify:
    - reload_postfix
  when: postfix_tls_private_key is defined

- name: Flush Postfix handlers
  meta: flush_handlers

- name: Configure Postfix aliases
  lineinfile:
    dest: /etc/aliases
    state: present
    line: "{{ postfix_aliases }}"
  notify:
    - rebuild_alias_database
    - reload_postfix
  when: postfix_aliases is defined

- name: Configure Postfix sender access
  lineinfile:
    dest: /etc/postfix/access
    state: present
    line: "{{ postfix_sender_access }}"
  notify:
    - rebuild_sender_access_database
    - reload_postfix
  when: postfix_sender_access is defined

- name: Configure Postfix recipient access
  lineinfile:
    dest: /etc/postfix/access
    state: present
    line: "{{ postfix_recipient_access }}"
  notify:
    - validate_postfix_config
    - rebuild_recipient_access_database
    - reload_postfix
  when: postfix_recipient_access is defined

