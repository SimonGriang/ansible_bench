    group: '{{ promtail_system_group }}'
  with_items:
    - path: '/etc/promtail'
    - path: '/etc/promtail/file_sd'
    - path: '/etc/promtail/positions'

- name: Create application directories for Promtail
  file:
    path: '{{ item.path }}'
    state: directory
    mode: '0755'
    owner: '{{ promtail_system_user }}'
    group: '{{ promtail_system_group }}'
  with_items:
    - path: '{{ promtail_install_dir }}'
    - path: '{{ promtail_install_dir }}/etc'
    - path: '{{ promtail_install_dir }}/logs'
    - path: '{{ promtail_install_dir }}/positions'
    - path: '{{ promtail_install_dir }}/positions/raft'

- name: Check if the Promtail binary exists
  stat:
    path: '{{ promtail_install_dir }}/promtail'
    state: file
  register: promtail_binary

- name: Download Promtail binaries if not present locally
  get_url:
    url: '{{ promtail_dist_url }}'
    dest: '{{ promtail_install_dir }}/promtail.tar.gz'
    checksum: '{{ promtail_custom_checksum }}'
    mode: '0644'
  when: not promtail_binary.stat.exists

- name: Propagate a locally distributed Promtail archive
  copy:
    content: '{{ lookup("file", "/path/to/local/promtail.tar.gz") }}'
    dest: '{{ promtail_install_dir }}/promtail.tar.gz'
    mode: '0644'
  when: not promtail_binary.stat.exists and (promtail_dist_url == '' or promtail_dist_url is None)

- name: Download Promtail binaries to the controller node
  get_url:
    url: '{{ promtail_dist_url }}'
    dest: '/tmp/promtail.tar.gz'
    checksum: '{{ promtail_custom_checksum }}'
    mode: '0644'
  when: promtail_binary_propagate is True and not promtail_binary.stat.exists

- name: Propagate Promtail binaries across nodes
  copy:
    content: '{{ lookup("file", "/tmp/promtail.tar.gz") }}'
