---
- name: Ensure a group is managed with a specific name and state
  ansible.builtin.group:
    name: "{{ group.name }}"
    state: "{{ group.state | default('present') }}"
    gid: "{{ group.gid | default(group.name) }}"
    system: "{{ group.system | default(false) }}"

- name: Configure sudo options for a specific group using a template
  ansible.builtin.template:
    src: "sudo_group.j2"
    dest: "/etc/sudoers.d/{{ group.name | replace('.', 'dot') }}"
    mode: "0640"
  when: group.sudo_options is defined
  loop_control:
    loop_var: group
  loop:
    - name: 'group1'
      state: 'present'
      gid: '1001'
      system: true
      sudo_options: true
    - name: 'group2'
      state: 'absent'
      gid: '1002'
      system: false
      sudo_options: true

- name: Validate sudoers file syntax
  ansible.builtin.command:
    cmd: visudo -c /etc/sudoers.d/{{ group.name | replace('.', 'dot') }}
  when: group.sudo_options is defined and group.name is defined
  no_log: true
  changed_when: false


