---

- name: Task 1 - Import assert.yml only once and delegate to localhost
  import_tasks:
    file: assert.yml
    delegate_to: localhost

- name: Task 2 - Install Python pip using the specified package name
  ansible.builtin.apt:
    name: "{{ python_pip_packages }}"
    state: present

- name: Task 3 - Configure pip proxy settings if the proxy is defined
  ansible.builtin.lineinfile:
    dest: /etc/pip.conf
    section: global
    line: "index-url = https://{{ python_pip_proxy }}/"
  when: python_pip_proxy is defined

- name: Task 4 - Set trusted hosts for pip if specified
  ansible.builtin.lineinfile:
    dest: /etc/pip.conf
    section: global
    line: "trusted-host = {{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined

- name: Task 5 - Update pip to the latest version under specific conditions
  ansible.builtin.apt:
    name: "{{ python_pip_pip_package }}"
    state: latest
  when:
    - python_pip_update
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'

- name: Task 6 - Install requested Python pip modules based on conditions
  ansible.builtin.pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when:
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'

