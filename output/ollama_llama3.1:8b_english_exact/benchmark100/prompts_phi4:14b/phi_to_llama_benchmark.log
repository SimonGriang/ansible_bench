---
- name: Manage Helm
  tasks:
  - name: Check if Helm binary exists
    stat:
      path: '{{ helm_bin_path }}'
    register: helm_check

  - name: Get current Helm version
    command:
      cmd: '{{ helm_bin_path }} version'
      chdir: /usr/local/bin
    failed_when: False
    changed_when: False
    register: helm_existing_version

  - name: Download Helm if necessary
    unarchive:
      src: '{{ helm_repo_path }}/{{ helm_version }}'
      dest: '{{ helm_bin_path }}'
      compression: tar
    when: helm_check.stat.exists == False or helm_existing_version.stdout != helm_version
    register: helm_download

  - name: Install downloaded Helm
    copy:
      content: '{{ helm_download.extracted }}'
      dest: '{{ helm_bin_path }}'
      mode: '0755'
    become: True
    when: helm_download is changed


