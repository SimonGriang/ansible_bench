---
- name: Ensure the unzip package is installed
  apt:
    name: unzip
    state: present
  when: promtail_apt_update_cache

- name: Create a group for Promtail
  group:
    name: '{{ promtail_system_group }}'
    state: present
  when: promtail_system_group != 'root'

- name: Create a user for Promtail
  user:
    name: '{{ promtail_system_user }}'
    group: '{{ promtail_system_group }}'
    groups: '{{ promtail_user_additional_groups }}'
    shell: '/usr/sbin/nologin'
    create_home: False
    home: '{{ lookup("path", "/") }}'
  when: promtail_system_user != 'root'

- name: Ensure the /usr/local/bin directory exists
  file:
    path: '/usr/local/bin'
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create necessary configuration directories for Promtail
  file:
    path: '{{ item.path }}'
    state: directory
    mode: '0770'
    owner: root
    group: '{{ promtail_system_group }}'
  with_items:
    - path: '/etc/promtail'
    - path: '/etc/promtail/file_sd'
    - path: '/etc/promtail/positions'

- name: Create application directories for Promtail
  file:
    path: '{{ item.path }}'
    state: directory
    mode: '0755'
    owner: '{{ promtail_system_user }}'
    group: '{{ promtail_system_group }}'
  with_items:
    - path: '{{ promtail_install_dir }}'
    - path: '{{ promtail_install_dir }}/etc'
    - path: '{{ promtail_install_dir }}/logs'
    - path: '{{ promtail_install_dir }}/positions'
    - path: '{{ promtail_install_dir }}/positions/raft'

- name: Check if the Promtail binary exists
  stat:
    path: '{{ promtail_install_dir }}/promtail'
    state: file
  register: promtail_binary

- name: Download Promtail binaries if not present locally
  get_url:
    url: '{{ promtail_dist_url }}'
    dest: '{{ promtail_install_dir }}/promtail.tar.gz'
    checksum: '{{ promtail_custom_checksum }}'
    mode: '0644'
  when: not promtail_binary.stat.exists

- name: Propagate a locally distributed Promtail archive
  copy:
    content: '{{ lookup("file", "/path/to/local/promtail.tar.gz") }}'
    dest: '{{ promtail_install_dir }}/promtail.tar.gz'
    mode: '0644'
  when: not promtail_binary.stat.exists and (promtail_dist_url == '' or promtail_dist_url is undefined)

- name: Download Promtail binaries to the controller node
  get_url:
    url: '{{ promtail_dist_url }}'
    dest: '/tmp/promtail.tar.gz'
    checksum: '{{ promtail_custom_checksum }}'
    mode: '0644'
  when: promtail_binary_propagate and not promtail_binary.stat.exists

- name: Propagate Promtail binaries across nodes
  copy:
    content: '{{ lookup("file", "/tmp/promtail.tar.gz") }}'
    dest: '{{ promtail_install_dir }}/promtail.tar.gz'
    mode: '0644'
  when: promtail_binary_propagate and not promtail_binary.stat.exists

- name: Unpack the Promtail binaries
  unarchive:
    src: '{{ promtail_install_dir }}/promtail.tar.gz'
    dest: '{{ promtail_install_dir }}'
    compression: 'tar'
    interactive: False
  when: not promtail_binary.stat.exists

- name: Create a symlink to the latest version of Promtail
  file:
    path: '/usr/local/bin/promtail'
    state: link
    link_path: '{{ promtail_install_dir }}/bin/promtail'
  notify: restart promtail

- name: Write the Promtail configuration file
  template:
    src: '{{ item.src }}'
    dest: '{{ item.dest }}'
    mode: '0644'
  with_items:
    - src: 'templates/promtail.yml.j2'
      dest: '/etc/promtail/promtail.yml'
  notify: restart promtail

- name: Create a systemd service unit for Promtail
  template:
    src: 'templates/promtail.service.j2'
    dest: '/etc/systemd/system/promtail.service'
    mode: '0644'
  notify: restart promtail


