- name: Prepare a summary of K8s nodes when the current host is the first in the rke2_servers_group
  block:
    - name: Retrieve and display the state of K8s nodes
      shell: "{{ rke2_data_path }}/kubectl get nodes --kubeconfig=/etc/rancher/rke2/rke2.yaml -o wide --no-headers"
      args:
        executable: /bin/bash
      when: "'{{ inventory_hostname }}' == '{{ groups.rke2_servers_group | first }}'"
      register: nodes_summary
      retries: 5
      retry_delay: 1
      until: nodes_summary is succeeded
  always:
    - debug:
        var: nodes_summary

- name: Display the state of K8s nodes
  debug:
    var: nodes_summary

