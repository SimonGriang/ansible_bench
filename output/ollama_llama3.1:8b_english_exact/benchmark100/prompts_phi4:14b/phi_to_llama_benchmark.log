---
- name: Import additional tasks
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when:
    - not (connection == 'docker' or connection == 'docker_container')
    - bootstrap_wait_for_host == true

- name: Prepare system
  block:
    - name: Test connection
      wait_for_connection:
        timeout: 10
        delay: 1
    - name: Verify sudo access
      command: /usr/bin/id -u
      changed_when: False
  rescue:
    - name: Gather bootstrap facts
      setup:
        gather_subset: ['all']
  always:
    - name: Install bootstrap packages
      raw: /usr/bin/apt-get update && /usr/bin/apt-get install -y --force-yes ansible
      when: bootstrap_packages_install

- name: Gather facts
  setup:
    gather_subset: ['all']
  no_log: True

- name: Install packages
  package:
    name: "{{ item }}"
    state: present
    cache_valid_time: 300
    update_cache: true
  loop: "{{ bootstrap_facts_packages }}"
  when: bootstrap_become
  become: True


