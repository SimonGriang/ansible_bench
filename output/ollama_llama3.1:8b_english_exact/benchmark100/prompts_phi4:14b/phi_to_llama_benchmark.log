---

- name: Manage User Accounts
  become: yes

  tasks:
  - name: Create directory for SSH keys if user management is enabled
    file:
      path: /path/to/ssh/keys
      state: directory
      mode: 0755
    when: user_management_enabled == true

  - name: Manage user accounts
    user:
      name: '{{ item.name }}'
      state: '{{ item.state | default("present") }}'
      comment: '{{ item.comment | default("") }}'
      home: '{{ item.home | default(lookup("env", "HOME")) }}'
      shell: '{{ item.shell | default("/bin/bash") }}'
      groups: '{{ item.groups | default([]) }}'
      append: true
    loop: '{{ users }}'
    register: user_result

  - name: Set sudo privileges for users if specified in their configuration
    template:
      src: 'sudoers.j2'
      dest: '/etc/sudoers.d/{{ item.name }}'
      mode: 0440
    when: item.sudo_options != 'undefined' and item.sudo_options is defined

  - name: Remove sudo privileges for users if not specified in their configuration
    file:
      path: '/etc/sudoers.d/{{ item.name }}'
      state: absent
    when: item.sudo_options == 'undefined' or not item.sudo_options
    loop: '{{ users }}'

  - name: Generate private SSH key for users who require SSH key management
    sshkey:
      type: rsa
      key_length: 2048
      state: present
      path: '/path/to/ssh/keys/{{ item.name }}'
    when: item.ssh_key_management and not item.ssh_key_exists
    loop: '{{ users }}'

  - name: Generate public SSH key for users who require SSH key management
    sshkey:
      type: rsa
      key_length: 2048
      state: present
      path: '/path/to/ssh/keys/{{ item.name }}.pub'
      key_file: '/path/to/ssh/keys/{{ item.name }}'
    when: item.ssh_key_management and not item.ssh_key_exists
    loop: '{{ users }}'

  - name: Convert SSH key to PPK format for users who require SSH key management
    sshkey:
      type: rsa
      key_length: 2048
      state: present
      path: '/path/to/ssh/keys/{{ item.name }}.ppk'
      key_file: '/path/to/ssh/keys/{{ item.name }}'
    when: item.ssh_key_management and not item.ssh_key_exists
    loop: '{{ users }}'

  - name: Determine home directory for users, defaulting to /home if the user is not found
    set_fact:
      user_home: '{{ item.home | default("/home/{{ item.name }}") }}'
    loop: '{{ users }}'

  - name: Create .ssh directory in user's home directory if SSH key management is enabled or private keys need to be set
    file:
      path: '{{ user_home }}/.ssh'
      state: directory
      mode: 0700
    when: item.ssh_key_management or item.private_key is defined
    loop: '{{ users }}'

  - name: Deploy authorized SSH keys for users if specified
    lineinfile:
      path: '{{ user_home }}/.ssh/authorized_keys'
      line: '{{ item.authorized_key }}'
      state: present
    when: item.authorized_key is defined
    loop: '{{ users }}'

  - name: Remove unauthorized SSH keys from users if specified
    lineinfile:
      path: '{{ user_home }}/.ssh/authorized_keys'
      line: '{{ item.unauthorized_key }}'
      state: absent
    when: item.unauthorized_key is defined
    loop: '{{ users }}'

  - name: Copy generated private SSH keys to user's .ssh directory if specified
    copy:
      content: '{{ item.ssh_key_content }}'
      dest: '{{ user_home }}/.ssh/{{ item.name }}'
      mode: 0600
    when: item.ssh_key_copy is defined
    loop: '{{ users }}'

  - name: Check password validity period for users
    shell:
      cmd: 'getent shadow {{ item.name }} | cut -d: -f4'
      register: password_validity
    loop: '{{ users }}'

  - name: Set password validity period for users if a specific duration is defined
    shell:
      cmd: 'chage -d {{ item.password_validity }} {{ item.name }}'
    when: item.password_validity != 'undefined' and item.password_validity != password_validity.stdout
    loop: '{{ users }}'

  - name: Place additional private key files in user's .ssh directory if specified
    copy:
      content: '{{ item.private_key_content }}'
      dest: '{{ user_home }}/.ssh/{{ item.name }}'
      mode: 0600
    when: item.private_key is defined
    loop: '{{ users }}'


