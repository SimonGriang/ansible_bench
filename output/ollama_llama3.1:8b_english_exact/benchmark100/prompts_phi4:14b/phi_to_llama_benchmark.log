      dest: /etc/openvpn/server/server.key
      state: file
      mode: '0600'

  - name: Copy necessary EasyRSA files to /etc/openvpn
    file:
      src: /etc/openvpn/easy-rsa/pki/ca.crt
      dest: /etc/openvpn/ca.crt
      state: file
      mode: '0644'
    file:
      src: /etc/openvpn/easy-rsa/pki/ta.key
      dest: /etc/openvpn/ta.key
      state: file
      mode: '0600'

  - name: Deploy OpenVPN server configuration file
    template:
      src: templates/server.conf.j2
      dest: /etc/openvpn/server.conf
      mode: '0644'
      owner: root
      group: root
    notify: Restart OpenVPN

  handlers:
    - name: Restart OpenVPN
      service:
        name: openvpn
        state: restarted


