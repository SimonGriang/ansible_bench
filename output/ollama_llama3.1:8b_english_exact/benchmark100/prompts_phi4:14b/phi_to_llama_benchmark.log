content="```yml\n---\n- name: Manage Helm\n  tasks:\n  - name: Check if Helm binary exists\n    stat:\n      path: '{{ helm_bin_path }}'\n    register: helm_check\n\n  - name: Get current Helm version\n    command:\n      cmd: '{{ helm_bin_path }} version'\n      chdir: /usr/local/bin\n    failed_when: False\n    changed_when: False\n    register: helm_existing_version\n\n  - name: Download Helm if necessary\n    unarchive:\n      src: '{{ helm_repo_path }}/{{ helm_version }}'\n      dest: '{{ helm_bin_path }}'\n      compression: tar\n    when: helm_check.stat.exists == False or helm_existing_version.stdout != helm_version\n    register: helm_download\n\n  - name: Install downloaded Helm\n    copy:\n      content: '{{ helm_download.extracted }}'\n      dest: '{{ helm_bin_path }}'\n      mode: '0755'\n    become: True\n    when: helm_download is changed\n```" additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-14T20:23:07.830011748Z', 'done': True, 'done_reason': 'stop', 'total_duration': 1931909291, 'load_duration': 97817522, 'prompt_eval_count': 566, 'prompt_eval_duration': 126858789, 'eval_count': 208, 'eval_duration': 1706786961, 'model_name': 'llama3.1:8b'} id='run--844ec1eb-3c4b-4bea-a55e-be280ef2a469-0' usage_metadata={'input_tokens': 566, 'output_tokens': 208, 'total_tokens': 774}
