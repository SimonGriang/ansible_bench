---
- name: Configure Hardening
  become: true

  - name: Disable swap if vault_hardening_disable_swap is set and swap is currently enabled
    swapoff:
      state: present
    when: vault_hardening_disable_swap is defined and vault_hardening_disable_swap and ( ansible_swap_enabled is defined and ansible_swap_enabled ) and ( ansible_swap_enabled is defined and ansible_swap_enabled )

  - name: Temporarily disable swap using the swapoff command only if swap is currently active
    swapoff:
      state: present
    when: ansible_swap_enabled is defined and ansible_swap_enabled

  - name: Ensure swap is not mounted permanently
    lineinfile:
      path: /etc/fstab
      state: absent
      regexp: '^swap'
      backrefs: yes

  - name: Disable core dumps if vault_hardening_disable_core_dumps is set
    lineinfile:
      path: /etc/security/limits.conf
      regexp: '^\s*core\s*soft\s*[^#]*'
      line: 'core soft 0'
      state: present
    when: vault_hardening_disable_core_dumps is defined

  - name: Set PAM limits to prevent core dumps by configuring hard and soft limits for all users
    lineinfile:
      path: /etc/security/limits.conf
      regexp: '^\s*core\s*hard\s*[^#]*'
      line: 'core hard 0'
      state: present
    when: vault_hardening_disable_core_dumps is defined

  - name: Disable shell command history for vault commands if vault_hardening_disable_shell_command_history is set
    template:
      src: templates/vault_history.sh.j2
      dest: /etc/profile.d/vault_history.sh
      mode: '0644'
    notify: restart sshd
    when: vault_hardening_disable_shell_command_history is defined

  - name: Configure SELinux and/or AppArmor if vault_hardening_configure_selinux_apparmor is set
    when: vault_hardening_configure_selinux_apparmor is defined

  - name: Ensure selinux-policy is installed
    package:
      name: selinux-policy
      state: present
  when: vault_hardening_configure_selinux_apparmor is defined and ansible_selinux_enabled is defined and ansible_selinux_enabled

  - name: Set the SELinux policy to enforcing
    selinux:
      policy: 'enforcing'
  when: vault_hardening_configure_selinux_apparmor is defined and ansible_selinux_enabled is defined and ansible_selinux_enabled

  - name: Enforce the AppArmor profile for the vault application
    apparmor:
      state: 'present'
      profile: /etc/apparmor.d/usr.sbin.vault
  when: vault_hardening_configure_selinux_apparmor is defined and ansible_apparmor_enabled is defined and ansible_apparmor_enabled


