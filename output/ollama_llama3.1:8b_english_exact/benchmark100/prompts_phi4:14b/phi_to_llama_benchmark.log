  when: ansible_version.major >= 2 and (ansible_distribution_family == 'RedHat' or ansible_distribution_family == 'Debian')

- name: Install Docker Compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  when: not ansible_version.major >= 2 or (ansible_distribution_family != 'RedHat' and ansible_distribution_family != 'Debian') and docker_install_compose_plugin

- name: Install Docker Compose plugin with allow_downgrade
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: yes
  notify: restart docker
  when: ansible_version.major >= 2 and (ansible_distribution_family == 'RedHat' or ansible_distribution_family == 'Debian') and docker_install_compose_plugin

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    mode: '0755'
  when: docker_daemon_options

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options | to_nice_yaml }}"
    dest: /etc/docker/daemon.json
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options

- name: Manage Docker service
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  when: docker_service_manage

- meta: flush_handlers

- include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Retrieve Docker group information
  getent:
    database: group
    name: docker
  register: docker_group_info
  when: docker_users

- name: Determine if any users need to be added to the Docker group
  set_fact:
    at_least_one_user_to_modify: true
  when: docker_users and docker_group_info and docker_users | difference(docker_group_info['result'] | map('extract', ['name'])) != []

- include_tasks: docker-users.yml
  when: at_least_one_user_to_modify

- name: Ensure an empty line at the end of file
  lineinfile:
    dest: /etc/ansible/roles/docker/tasks/main.yml
    line: ""

