  - name: Disable core dumps if vault_hardening_disable_core_dumps is set
    lineinfile:
      path: /etc/security/limits.conf
      regexp: '^\s*core\s*soft\s*[^#]*'
      line: 'core soft 0'
      state: present
    when: vault_hardening_disable_core_dumps is defined

