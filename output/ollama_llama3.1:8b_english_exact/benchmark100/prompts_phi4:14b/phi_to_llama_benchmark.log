--- 

- name: Task 1 - Enable Apache modules proxy and proxy_http on Debian and Suse systems
  hosts: ['Debian', 'Suse']
  become: true

  tasks:
  - name: Enable Apache modules
    community.general.apache2_module:
      name: "{{ item }}"
      state: present
    loop:
      - proxy
      - proxy_http
    when: ansible_distribution in ['Debian', 'Suse']

- name: Task 2 - Configure Apache locations using a template
  hosts: ['Debian', 'Suse']
  become: true

  tasks:
  - name: Configure Apache locations
    ansible.builtin.template:
      src: location.conf.j2
      dest: '{{ httpd_config_directory }}/{{ item.name }}.conf'
      mode: '0644'
    loop: '{{ httpd_locations }}'
    loop_control:
      label: '{{ item.name }}'
    notify:
      - test_httpd_config
      - restart_httpd

