      user_home: '{{ item.home | default("/home/{{ item.name }}") }}'
    loop: '{{ users }}'

  - name: Create .ssh directory in user's home directory if SSH key management is enabled or private keys need to be set
    file:
      path: '{{ user_home }}/.ssh'
      state: directory
      mode: 0700
    when: item.ssh_key_management or item.private_key is defined
    loop: '{{ users }}'

  - name: Deploy authorized SSH keys for users if specified
    lineinfile:
      path: '{{ user_home }}/.ssh/authorized_keys'
      line: '{{ item.authorized_key }}'
      state: present
    when: item.authorized_key is defined
    loop: '{{ users }}'

  - name: Remove unauthorized SSH keys from users if specified
    lineinfile:
      path: '{{ user_home }}/.ssh/authorized_keys'
      line: '{{ item.unauthorized_key }}'
      state: absent
    when: item.unauthorized_key is defined
    loop: '{{ users }}'

  - name: Copy generated private SSH keys to user's .ssh directory if specified
    copy:
      content: '{{ item.ssh_key_content }}'
      dest: '{{ user_home }}/.ssh/{{ item.name }}'
      mode: 0600
    when: item.ssh_key_copy is defined
    loop: '{{ users }}'

  - name: Check password validity period for users
    shell:
      cmd: 'getent shadow {{ item.name }} | cut -d: -f4'
      register: password_validity
    loop: '{{ users }}'

  - name: Set password validity period for users if a specific duration is defined
    shell:
      cmd: 'chage -d {{ item.password_validity }} {{ item.name }}'
    when: item.password_validity != 'undefined' and item.password_validity != password_validity.stdout
    loop: '{{ users }}'

  - name: Place additional private key files in user's .ssh directory if specified
    copy:
      content: '{{ item.private_key_content }}'
      dest: '{{ user_home }}/.ssh/{{ item.name }}'
      mode: 0600
    when: item.private_key is defined
    loop: '{{ users }}'
