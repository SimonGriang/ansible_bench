---
- name: Check if all necessary variables have been set correctly
  import_tasks: assert_variables.yml
  delegate_to: localhost

- name: Wait for the host to become available if specified in the configuration
  wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ ssh_port | default(22) }}"
    connect_timeout: "{{ connect_timeout | default(5) }}"
    timeout: "{{ wait_timeout | default(300) }}"
  when:
    - connection_type != "container"
    - wait_for_host
  delegate_to: localhost
  become: true
  become_user: "{{ become_user | default('root') }}"
  become_method: "{{ become_method | default('sudo') }}"

- name: Prepare the system by ensuring connectivity and installing necessary packages
  block:
    - name: Test connection to host
      connection: local
      local_action: ping
      register: connection_result
    - debug:
        msg: "Connection to {{ inventory_hostname }} timed out after {{ timeout }} seconds"
      when: connection_result is failed
    - name: Gather system facts
      setup:
        filter: "ansible_{{ ansible_facts_filter | default('all') }}"
    - name: Install packages using raw command
      raw: "{{ package_manager_cmd }} {{ package_name }} {{ package_state | default('present') }}"
      when: package_manager_cmd is defined
    - name: Install packages using Ansible's package module
      package:
        name: "{{ package_name }}"
        state: "{{ package_state | default('present') }}"
        install_repo: "{{ install_repo | default(false) }}"
      when: package_manager_cmd is not defined

  when: become

- name: Ensure the system is fully prepared by executing necessary Ansible modules
  block:
    - name: Gather Ansible facts
      setup:
        filter: "ansible_{{ ansible_facts_filter | default('all') }}"
    - name: Install required packages
      package:
        name: "{{ package }}"
        state: "{{ package_state | default('present') }}"
        install_repo: "{{ install_repo | default(false) }}"
      loop: "{{ packages }}"
      loop_control:
        loop_var: package



