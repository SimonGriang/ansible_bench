---
- name: Task 1 - Import assert.yml
  include_tasks: assert.yml

- name: Task 2 - Install nginx
  package:
    name: nginx
    state: present

- name: Task 3 - Place nginx.conf
  template:
    src: templates/nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: '0644'
    validate: '/usr/sbin/nginx -t -c /etc/nginx/nginx.conf'
  notify:
    - restart nginx

- name: Task 4 - Ensure /etc/nginx/conf.d exists
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: '0755'

- name: Task 5 - Place default.conf
  template:
    src: templates/default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'
  notify:
    - restart nginx

- name: Task 6 - Start and enable nginx
  service:
    name: nginx
    state: started
    enabled: yes


