---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install HashiCorp products
  block:
    - name: Download HashiCorp repository configuration for RedHat or Rocky
      when: ansible_distribution in ['RedHat', 'Rocky']
      get_url:
        url: '{{ hashicorp_repository_url }}'
