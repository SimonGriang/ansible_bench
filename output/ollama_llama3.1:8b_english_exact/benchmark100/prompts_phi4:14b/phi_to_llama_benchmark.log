---
- name: Upgrade RKE2
  tasks:
  - name: Cordon and Drain the node during RKE2 upgrade
    kubectl:
      cmd: cordon
      name: "{{ rke2_node_name }}"
    register: drain
    retries: 100
    delay: 15
    until: drain is not failed
    delegate_to: active
    when: rke2_drain_node_during_upgrade

  - name: Restart the RKE2 service on the node
    ansible.builtin.service:
      name: "{{ rke2_service_name }}"
      state: restarted
    notify: Service (re)started

  - name: Wait for all nodes to be ready again
    kubectl:
      cmd: get nodes -o jsonpath='{.items[*].status.phase}'
      args: --all-namespaces
    register: nodes
    retries: 100
    delay: 15
    until: nodes.stdout | length >= rke2_cluster_group_name
    delegate_to: active
    run_once: yes

  - name: Uncordon the node after the upgrade
    kubectl:
      cmd: uncordon
      name: "{{ rke2_node_name }}"
    delegate_to: active
    when: rke2_drain_node_during_upgrade
    run_once: yes

  - name: Wait for all pods to be ready again
    kubectl:
      cmd: get pods -o jsonpath='{.items[*].status.phase}'
      args: --all-namespaces
    register: pods
    retries: 100
    delay: 15
    until: '^(Running|Succeeded)$'
    delegate_to: active
    when: rke2_wait_for_all_pods_to_be_ready
    run_once: yes

  - name: Wait for all pods to pass readiness checks
    kubectl:
      cmd: wait --for condition=ready
      args: "{{ rke2_wait_for_all_pods_to_be_healthy_args }}"
    delegate_to: active
    retries: 100
    delay: 15
    until: true
    when: rke2_wait_for_all_pods_to_be_healthy
    run_once: yes


