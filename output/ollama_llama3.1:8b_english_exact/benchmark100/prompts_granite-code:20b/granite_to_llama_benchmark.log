---
- name: Ensure old versions of Docker are not installed
  package:
    name: docker-ce
    state: absent

- name: Add Docker GPG key
  apt_key:
    url: https://download.docker.com/linux/ubuntu/gpg
    state: present

- name: Add Docker repository
  apt_repository:
    repo: 'https://download.docker.com/linux/ubuntu ${distro_release[-1]}-'
    state: present

- name: Configure Docker Nightly repo
  apt_repository:
    repo: 'https://download.docker.com/linux/ubuntu ${distro_release[-1]}-nightly'
    state: present

- name: Configure Docker Test repo
  apt_repository:
    repo: 'https://download.docker.com/linux/ubuntu ${distro_release[-1]}-test'
    state: present

- name: Configure containerd on RHEL 8
  yum_repository:
    name: containerd
    description: Containerd repository
    baseurl: https://download.containerd.io/
    gpgcheck: true
    gpgkey: https://download.containerd.io/content/keyring.gpg
  when: ansible_distribution == 'RedHat' and ansible_distribution_major_version == '8'

  # Ensure containerd package is installed
  yum:
    name: containerd.io
    state: present
  when: ansible_distribution == 'RedHat' and ansible_distribution_major_version == '8'


