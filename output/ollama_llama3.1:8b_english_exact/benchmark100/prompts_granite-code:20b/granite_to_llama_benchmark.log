---
- name: Install apache httpd
  apt:
    name: apache2
    state: present

- name: Configure selinux
  selinux:
    state: enabled
  when: selinux_enabled == true
  notify: selinux configuration changed
  tasks:
    - name: Allow httpd to listen on port {{ httpd_port }}
      selinux:
        policy: targeted
        module: httpd_can_network_relay
        state: enabled
    - name: Allow httpd to connect to port {{ httpd_port }}
      selinux:
        policy: targeted
        module: httpd_can_network_connect
        state: enabled

- name: Configure httpd
  template:
    src: templates/httpd.conf.j2
    dest: /etc/apache2/apache2.conf
    notify: test httpd configuration validity
  notify: restart httpd

- name: Activate httpd module | Debian
  apt:
    name: libapache2-mod-httpd
    state: present
  when: ansible_os_family == 'Debian'
  notify: test httpd configuration validity

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable == true

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined != false

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined != false

- name: Configure ports
  template:
    src: templates/ports.j2
    dest: /etc/apache2/ports.conf
    notify: test httpd configuration validity
  when: ansible_os_family in ['Debian', 'Suse']
  notify: restart httpd

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined != false

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example == true

- name: Start and enable httpd
  service:
    name: apache2
    state: started
    enabled: yes


