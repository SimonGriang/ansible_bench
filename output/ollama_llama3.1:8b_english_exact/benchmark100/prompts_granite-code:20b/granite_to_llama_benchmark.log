---
- name: Configure and manage cron jobs
  tasks:
    - name: Install cron
      apt:
        name: cron
        state: present

    - name: Configure shell
      lineinfile:
        dest: /etc/cron.d/crontab
        regexp: '^SHELL='
        line: 'SHELL=/bin/bash'

    - name: Configure path
      lineinfile:
        dest: /etc/cron.d/crontab
        regexp: '^PATH='
        line: 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

    - name: Configure mailto
      lineinfile:
        dest: /etc/cron.d/crontab
        regexp: '^MAILTO='
        line: 'MAILTO=root'

    - name: Start and enable cron
      service:
        name: cron
        enabled: yes
        state: started

    - name: Schedule requested cron jobs
      cron:
        name: "example"
        minute: "*/5"
        hour: "*"
        job: "/usr/bin/example-command"


