---

- name: Install ssl packages
  apt:
    name:
      - libssl-dev
      - libssl-doc
      - libssl-openssl-rsa-perl
      - openssl
      - openssl-blacklist
      - openssl-blacklist-demos
      - openssl-blacklist-nss
      - openssl-blacklist-ppc
      - openssl-blacklist-tls-dane
      - openssl-blacklist-weak-keys
      - ssl-cert
      - ssl-cert-check
      - ssl-cert-dummy
      - ssl-cert-snakeoil
      - ssl-openssl
      - ssl-openssl-perl

- name: Place configuration
  template:
    src: templates/ssl.conf.j2
    dest: /etc/ssl/ssl.conf
    mode: '0644'
  notify:
    - Restart ssl service

- name: Configure redirect from http to https
  template:
    src: templates/default.vhost.j2
    dest: /etc/apache2/sites-available/default.vhost
    mode: '0644'
  notify:
    - Restart apache2 service

