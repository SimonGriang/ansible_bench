- name: Configure pip and install modules
  tasks:
  - name: Import assert.yml
    include_yaml: assert.yml

  - name: Install python pip
    apt:
      name: python-pip
      state: present

  - name: Configure pip proxy
    ini_file:
      dest: /etc/pip.conf
      section: global
      option: proxy
      value: 'http://your-proxy-url.com'

  - name: Trust hosts
    ini_file:
      dest: /etc/pip.conf
      section: global
      option: trusted-hosts
      value: 'your-trusted-host.com'

  - name: Update pip
    pip:
      name: pip
      state: latest

  - name: Install requested modules
    pip:
      name: your-modules
      state: present


