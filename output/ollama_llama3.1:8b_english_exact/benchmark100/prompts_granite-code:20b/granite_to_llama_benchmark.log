---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Ensure that logrotate is installed.
  ansible.builtin.apt:
    name: logrotate
    state: present

- name: Template /etc/logrotate.conf using the template.
  ansible.builtin.template:
    src: templates/logrotate.conf.j2
    dest: /etc/logrotate.conf
    mode: '0644'

- name: Template /etc/logrotate.d/{{ item.name }} using the template.
  ansible.builtin.template:
    src: templates/logrotate.d.j2
    dest: /etc/logrotate.d/{{ item.name }}
    mode: '0644'
  loop:
    items: "{{ logrotate_configs | list }}"

- name: Remove /etc/logrotate.d/{{ item.name }}.
  ansible.builtin.file:
    path: /etc/logrotate.d/{{ item.name }}
    state: absent
  loop:
    items: "{{ logrotate_configs | list }}"

- name: Start the logrotate service.
  ansible.builtin.service:
    name: logrotate
    state: started


