---
- name: Configure and Schedule Cron Jobs
  tasks:
  - name: Install cron
    package:
      name: cron
      state: present

  - name: Configure shell
    lineinfile:
      dest: /etc/cron.d/crontab
      line: SHELL=/bin/bash
      state: present

  - name: Configure path
    lineinfile:
      dest: /etc/cron.d/crontab
      line: PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      state: present

  - name: Configure mailto
    lineinfile:
      dest: /etc/cron.d/crontab
      line: MAILTO=root
      state: present

  - name: Start and enable cron
    service:
      name: cron
      state: started
      enabled: yes

  - name: Schedule requested cron jobs
    cron:
      name: "0 0 * * * /usr/local/bin/cronjob >> /var/log/cronjob.log 2>&1"
      minute: "0"
      hour: "0"
      day: "*"
      month: "*"
      dayOfWeek: "*"

