--- 

- name: Import assert.yml
  include: assert.yml

- name: Install required packages
  package:
    name:
      - package1
      - package2

- name: Set GRUB_TIMEOUT
  lineinfile:
    dest: /etc/default/grub
    regexp: '^GRUB_TIMEOUT='
    line: 'GRUB_TIMEOUT=10'

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    dest: /etc/default/grub
    regexp: '^GRUB_RECORDFAIL_TIMEOUT='
    line: 'GRUB_RECORDFAIL_TIMEOUT=10'

- name: Add options to GRUB_CMDLINE_LINUX
  replace:
    dest: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX=".*"'
    replacement: 'GRUB_CMDLINE_LINUX="option1 option2"'

- name: Import password.yml
  include: password.yml
  when: grub_set_password == true

- name: Flush handlers
  meta: flush_handlers

