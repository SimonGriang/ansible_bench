---

- name: Import assert.yml
  include: assert.yml

- name: Install dns
  apt:
    name: dnsutils
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items:
    - { path: '/etc/bind', mode: '0755', owner: 'bind', group: 'bind' }

- name: Create group
  group:
    name: bind
    state: present

- name: Create user
  user:
    name: bind
    group: bind
    create_home: False
    state: present

- name: Generate rndc key
  command: rndc-keygen

- name: Set permissions on rndc key file
  file:
    path: '/etc/bind/rndc.key'
    state: file
    mode: '0600'

- name: Get the hints/root file
  get_url:
    url: 'http://www.internic.net/domain/named.root'
    dest: '/etc/bind/named.root'
    state: present

- name: Create zone file
  template:
    src: templates/{{ item.zone }}.template
    dest: '/var/named/{{ item.zone }}.zone'
    mode: '0644'
  with_items:
    - { zone: 'example.com' }
    - { zone: 'example.net' }

- name: Add zones to configuration
  template:
    src: templates/named.conf.template
    dest: '/etc/bind/named.conf'
    mode: '0644'

- name: Place systemd override
  template:
    src: templates/bind.systemd-override.template
    dest: '/etc/systemd/system/bind.service.d/override.conf'
    mode: '0644'

- name: Start and enable dns
  service:
    name: bind9
    state: started
    enabled: True

