---
- name: Configure MySQL
  hosts: localhost
  become: yes

  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install mysql
    package:
      name: "{{ mysql_packages }}"
      state: present

  - name: Configure mysql server
    template:
      src: templates/my.cnf.j2
      dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}"
      mode: '0644'
    notify:
      - restart mysql

  - name: Configure mysql client
    template:
      src: templates/my.cnf.j2
      dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}"
      mode: '0644'
    notify:
      - restart mysql

  - name: Initialize mysql
    command: "{{ mysql_initialize_command }}"

  - name: Start and enable mysql
    service:
      name: mysql
      state: started
      enabled: yes

  - name: Flush handlers
    meta: flush_handlers

  - name: Place my.cnf
    template:
      src: templates/my.cnf.j2
      dest: /root/.my.cnf
      mode: '0600'

  - name: Create databases
    mysql_db:
      name: "{{ item.name }}"
      state: present
    with_items: "{{ mysql_databases }}"

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.priv }}"
      state: present
    with_items: "{{ mysql_users }}"

  - name: Flush handlers again
    meta: flush_handlers

