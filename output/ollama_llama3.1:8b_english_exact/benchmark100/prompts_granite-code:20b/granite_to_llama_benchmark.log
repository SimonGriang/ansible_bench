---
- name: Ensure apt key is not present in trusted.gpg.d
  apt_key:
    state: absent
    keyserver: keyserver.ubuntu.com
    id: 0C8BC4312B82FB88436A1E2D15713B012DFD46B5

- name: Ensure old apt source list is not present in /etc/apt/sources.list.d
  apt_source:
    list: /etc/apt/sources.list.d/*.list
    state: absent

- name: Ensure old versions of Docker are not installed
  apt:
    name: docker
    state: absent

- name: Ensure legacy repo file is not present
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure dependencies are installed
  apt:
    name: python3-pip, python3-dev, libffi-dev, libssl-dev, make, build-essential, python3-setuptools
    state: present

- name: Add or remove Docker repository
  apt_repository:
    repo: 'https://download.docker.com/linux/ubuntu {{ ansible_distribution_release }}'
    state: present

- name: Ensure handlers are notified immediately to update the apt cache
  meta:
    hosts: localhost
  notify: apt_cache_update


