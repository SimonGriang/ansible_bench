    copy:
      src: "{{ item.src }}"
      dest: "/etc/fail2ban/filter.d/{{ item.dest }}"
      owner: root
      group: root
      mode: '0640'
    loop:
      - { src: 'filter-ssh.conf', dest: 'filter-ssh.conf' }
      - { src: 'filter-sshd.conf', dest: 'filter-sshd.conf' }
      - { src: 'filter-xinetd.conf', dest: 'filter-xinetd.conf' }
      - { src: 'filter-postgres.conf', dest: 'filter-postgres.conf' }
      - { src: 'filter-mysql.conf', dest: 'filter-mysql.conf' }
      - { src: 'filter-sshd.conf', dest: 'filter-sshd.conf' }
      - { src: 'filter-dovecot.conf', dest: 'filter-dovecot.conf' }

  - name: Configure fail2ban.local
    ini_file:
      file: /etc/fail2ban/fail2ban.local
      section: 'fail2ban'
      option: 'loglevel'
      value: 3
    loop:
      - { option: 'logtarget', value: '/var/log/fail2ban.log' }
      - { option: 'logrotate', value: true }
      - { option: 'logfilerotate', value: true }
      - { option: 'backend', value: 'gamin' }
      - { option: 'banaction', value: 'iptables' }
      - { option: 'banaction_all', value: 'iptables' }
      - { option: 'bantime', value: 300 }
      - { option: 'findtime', value: 300 }
      - { option: 'maxretry', value: 2 }

  - name: Configure jail.local
    ini_file:
      file: /etc/fail2ban/jail.local
      section: 'default'
      option: 'enabled'
      value: true
    loop:
