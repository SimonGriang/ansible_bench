    content: "{{ openssl_private_key.content }}\n{{ openssl_certifcate.content }}"
    mode: "{{ item.mode }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ openssl_key_list | items }}"

