- name: CIS Hardening
  template:
    src: cis-hardening.j2
    dest: /etc/rke2/cis-hardening.yml
    mode: '0644'

- name: Find Active Server
  command:
    cmd: rke2 get-activeserver
  register: activeserver
  when: rke2_mode == 'cluster'

- name: Enable IPVS kernel module
  modprobe:
    name: ip_vs

- name: Copy kube-vip manifests to the masternode
  copy:
    src: templates/kube-vip.yml
    dest: /etc/rke2/templates/kube-vip.yml
    mode: '0644'

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: templates/ingress-nginx.yml
    dest: /etc/rke2/templates/ingress-nginx.yml
    mode: '0644'

- name: Prepare very first server node in the cluster
  command:
    cmd: rke2 join --token {{ rke2_token }} {{ activeserver.stdout }}

