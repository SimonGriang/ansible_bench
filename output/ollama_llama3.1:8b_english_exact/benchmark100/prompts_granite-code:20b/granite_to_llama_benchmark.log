- name: Gather information about the operating system
  command: cat /etc/os-release
  register: os_release

- name: Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ os_release.stdout | from_json | dict2items | selectattr('key', 'match', 'ID') | map(attribute='value') | first }}"
    bootstrap_distribution_major_version: "{{ os_release.stdout | from_json | dict2items | selectattr('key', 'match', 'VERSION_ID') | map(attribute='value') | first | split('.')[0] }}"

- name: Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ os_release.stdout | from_json | dict2items | selectattr('key', 'match', '^ID|^NAME$|^VERSION_ID$') | map(attribute='value') | list | first | lower | replace(' ', '_') | replace('.', '_') }}"

