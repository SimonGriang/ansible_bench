---

- name: Install required packages
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - python3
    - python3-pip
    - git
    - curl
    - unzip

- name: Flush handlers
  ansible.builtin.handler_flush

- name: Configure selinux
  selinux:
    policy: targeted
    state: enabled

- name: Manage selinux booleans
  selinux.boolean:
    name: "{{ item }}"
    state: true
  loop:
    - allow_httpd_anon_write
    - allow_httpd_mod_ssl

- name: Remove duplicate task
  # This task will be removed because it duplicates the task above
  # selinux.boolean:
  #   name: "{{ item }}"
  #   state: true
  # loop:
  #   - allow_httpd_anon_write
  #   - allow_httpd_mod_ssl

