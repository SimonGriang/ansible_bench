---
- name: Install mysql
  apt:
    name: mysql-server
    state: present

- name: Configure mysql server
  template:
    src: templates/my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: '0644'
  notify:
    - restart mysql

- name: Configure mysql client
  template:
    src: templates/my.cnf-client.j2
    dest: /etc/mysql/conf.d/my.cnf
    mode: '0644'
  notify:
    - restart mysql

- name: Initialize mysql
  mysql_user:
    name: root
    password: "{{ mysql_root_password }}"
    priv: '*.*:ALL'
  mysql_db:
    name: mysql
    state: present

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: templates/my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: '0644'
  notify:
    - restart mysql

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  with_items:
    - { name: 'database1' }
    - { name: 'database2' }

- name: List databases
  mysql_db:
    name: ''
    state: list

- name: Import database
  mysql_db:
    name: 'database1'
    state: import
    sql: 'path/to/sql/file.sql'

- name: Create users
  mysql_user:
    name: 'user1'
    password: 'user1password'
    priv: 'database1.*:ALL'
  mysql_user:
    name: 'user2'
    password: 'user2password'
    priv: 'database2.*:ALL'

- name: Flush handlers again
  meta: flush_handlers

