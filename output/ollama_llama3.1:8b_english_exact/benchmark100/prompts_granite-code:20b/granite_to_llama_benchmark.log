---
- name: RKE2 setup tasks
  tasks:
  - name: Create the RKE2 config dir
    file:
      path: /etc/rke2
      state: directory

  - name: Set server taints
    set_fact:
      server_taints: "node-role.kubernetes.io/master=true"

  - name: Set agent taints
    set_fact:
      agent_taints: "node-role.kubernetes.io/aggregator=true"

  - name: Copy RKE2 config
    template:
      src: rke2.yml.j2
      dest: /etc/rke2/config.yaml
      mode: '0644'

  - name: Copy kubelet config
    copy:
      src: /etc/kubernetes/kubelet.conf
      dest: /etc/rke2/kubelet.conf
      mode: '0644'
    when: kubelet_config is defined

  - name: Copy Containerd Registry Configuration file
    copy:
      src: /etc/containerd/config.toml
      dest: /etc/rke2/containerd.toml
      mode: '0644'
    when: containerd_registry is defined

  - name: Start RKE2 service on the rest of the nodes
    service:
      name: rke2
      state: started
    when: inventory_hostname != groups['rke2_servers'][0]

  - name: Mask other RKE2 service on the rest of the nodes
    service:
      name: rke2-agent
      state: masked
    when: inventory_hostname != groups['rke2_servers'][0]

  - name: Wait for remaining nodes to be ready - no CNI
    wait_for:
      host: "{{ groups['rke2_servers'][0] }}"
      port: 22
      timeout: 300
      state: started
    when: cni is not defined

  - name: Wait for remaining nodes to be ready - with CNI
    wait_for:
      host: "{{ groups['rke2_servers'][0] }}"
      port: 22
      timeout: 300
      state: started
    when: cni is defined


