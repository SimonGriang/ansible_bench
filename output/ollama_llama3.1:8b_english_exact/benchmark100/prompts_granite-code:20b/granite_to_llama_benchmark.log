---
- name: RKE2 Playbook
  hosts: "{{ rke2_cluster_group_name }}"
  gather_facts: no

  tasks:
  - name: Create the RKE2 config dir
    file:
      path: /etc/rancher/rke2
      state: directory

  - name: Set server taints
    set_fact:
      server_taints: "{{ rke2_server_node_taints }}"

  - name: Copy rke2 config
    copy:
      src: "{{ item.src }}"
      dest: /etc/rancher/rke2/config.yaml
      mode: '0600'
    loop:
      - { src: 'rke2.conf' }
    notify: restart rke2-server.service

  - name: Copy kubelet config
    copy:
      src: "{{ item.src }}"
      dest: /etc/rancher/rke2/kubelet-config.yaml
      mode: '0600'
    when: rke2_kubelet_config != ""
    loop:
      - { src: 'kubelet.conf' }

  - name: Copy Containerd Registry Configuration file
    copy:
      src: "{{ item.src }}"
      dest: /etc/rancher/rke2/registries.yaml
      mode: '0600'
    when:
      (rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != "")
    loop:
      - { src: 'containerd-registry.conf' }

  - name: Register if we need to do a etcd restore from file
    set_fact:
      do_etcd_restore: (rke2_etcd_snapshot_file != "" and rke2-server.service.status == "active")

  - name: Register if we need to do a etcd restore from s3
    set_fact:
      do_etcd_restore_from_s3: (rke2_etcd_snapshot_s3_options.access_key != "" or rke2_etcd_snapshot_s3_options.secret_key != "" or rke2_etcd_snapshot_s3_options.bucket != "" or rke2_etcd_snapshot_s3_options.snapshot_name != "")

  - name: Restore etcd from file
    when: do_etcd_restore
    block:
      - name: Create the RKE2 etcd snapshot directory
        file:
          path: /etc/rancher/rke2/etcd-snapshot
          state: directory

      - name: Copy the etcd snapshot file
        copy:
          src: "{{ rke2_etcd_snapshot_file }}"
          dest: /etc/rancher/rke2/etcd-snapshot.tar

      - name: Restore etcd from the snapshot
        command: rke2 server restore --etcd-snapshot /etc/rancher/rke2/etcd-snapshot.tar

  - name: Restore etcd from s3
    when: do_etcd_restore_from_s3
    block:
      - name: Execute the rke2 server command with s3 restore options
        command: rke2 server restore --etcd-snapshot-s3 --aws-access-key {{ rke2_etcd_snapshot_s3_options.access_key }} --aws-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }} --aws-bucket {{ rke2_etcd_snapshot_s3_options.bucket }} --aws-snapshot {{ rke2_etcd_snapshot_s3_options.snapshot_name }}

  - name: Start RKE2 service on the first server
    when: inventory_hostname == groups[rke2_cluster_group_name][0]
    service:
      name: rke2-server
      state: started
      enabled: yes

  - name: Mask RKE2 agent service on the first server
    when: inventory_hostname == groups[rke2_cluster_group_name][0]
    service:
      name: rke2-agent
      state: masked

  - name: Wait for the first server be ready - no CNI
    when: inventory_hostname == groups[rke2_cluster_group_name][0]
    wait_for:
      host: "{{ inventory_hostname }}"
      port: 22
      delay: 10
      timeout: 600
      state: started
      connect_timeout: 5
      sleep: 5
      path: /etc/rancher/rke2

  - name: Wait for the first server be ready - with CNI
    when: inventory_hostname == groups[rke2_cluster_group_name][0]
    wait_for:
      host: "{{ inventory_hostname }}"
      port: 22
      delay: 10
      timeout: 600
      state: started
      connect_timeout: 5
      sleep: 5
      path: /etc/rancher/rke2
      condition: "Ready"

  - name: Restore etcd
    when: (do_etcd_restore or do_etcd_restore_from_s3)
    block:
      - name: Remove old <node>.node-password.rke2 secrets
        file:
          path: /etc/rancher/rke2/node-{{ inventory_hostname }}.node-password.rke2
          state: absent

      - name: Remove old nodes
        command: rke2 server delete-node {{ inventory_hostname }}

      - name: Remove old secrets
        command: rke2 server delete-secret {{ inventory_hostname }}.node-password.rke2

      - name: Execute the rke2 server command to remove old nodes and secrets
        command: rke2 server delete-node-and-secret {{ inventory_hostname }}

  - name: Set an Active Server variable
    delegate_to: "{{ groups[rke2_cluster_group_name] }}"
    delegate_facts: yes
    set_fact:
      active_server: "{{ inventory_hostname }}"


