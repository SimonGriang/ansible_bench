---

- name: MySQL Tasks
  hosts: localhost
  become: yes

  tasks:
  - name: Install mysql
    apt:
      name: mysql-server
      state: present

  - name: Configure mysql server
    template:
      src: templates/my.cnf.j2
      dest: /etc/mysql/my.cnf
      mode: '0644'
    notify:
      - restart mysql

  - name: Configure mysql client
    template:
      src: templates/my.cnf.j2
      dest: /etc/mysql/my.cnf
      mode: '0644'
    notify:
      - restart mysql

  - name: Initialize mysql
    mysql_db:
      name: mydb
      state: present

  - name: Start and enable mysql
    service:
      name: mysql
      state: started
      enabled: yes

  - name: Flush handlers
    meta:
      flush_handlers: false

  - name: Place my.cnf
    copy:
      content: |
        [mysqld]
        bind-address = 127.0.0.1
      dest: /etc/mysql/my.cnf
      mode: '0644'

  - name: Create databases
    mysql_db:
      name: mydb
      state: present

  - name: List databases
    mysql_db:
      name: mydb
      state: present
    register: db_list

  - name: Import database
    mysql_db:
      name: mydb
      state: present
    register: db_list

  - name: Create users
    mysql_user:
      name: myuser
      password: mypass
      priv: '*.*:ALL'
      state: present

  - name: Flush handlers again
    meta:
      flush_handlers: false

