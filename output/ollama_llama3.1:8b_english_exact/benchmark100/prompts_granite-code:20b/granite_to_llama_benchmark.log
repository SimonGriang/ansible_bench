---
- name: Bootstrap Facts
  tasks:
  - name: lookup bootstrap facts (raw)
    command:
      cmd: 'ansible-playbook -i inventory bootstrap.yml --graph --list --verbose'
    register: bootstrap_facts

  - name: set bootstrap facts (I) # noqa jinja
    set_fact:
      bootstrap_distribution: "{{ item.distribution }}"
      bootstrap_distribution_major_version: "{{ item.major_version }}"
    loop: "{{ bootstrap_facts.stdout | from_json | json_query('bootstrap__os_family_map[*]') }}"
    when: item.os_family == 'Debian'

  - name: set bootstrap facts (II)
    set_fact:
      bootstrap_os_family: "{{ item.os_family }}"
    loop: "{{ bootstrap_facts.stdout | from_json | json_query('bootstrap__os_family_map[*]') }}"
    when: item.os_family == 'RedHat'


