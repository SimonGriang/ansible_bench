---

- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install cron
  ansible.builtin.apt:
    name: cron
    state: present

- name: Configure shell
  ansible.builtin.user:
    name: root
    shell: /bin/bash

- name: Configure path
  become: true
  ansible.builtin.file:
    path: /etc/profile.d/cron.sh
    state: file
    mode: '0755'

- name: Configure mailto
  ansible.builtin.lineinfile:
    dest: /etc/cron.d/crontab
    line: MAILTO='root'
    state: present

- name: Start and enable cron
  ansible.builtin.service:
    name: cron
    enabled: true
    state: started

- name: Schedule requested cron jobs
  ansible.builtin.cron:
    name: '0 * * * * root /path/to/script.sh'
    minute: '0'
    hour: '*'
    day: '*'
    month: '*'
    weekday: '*'


