---
- name: Install requirements
  tasks:
  - name: Install bash package
    apt:
      name: bash
      state: present

- name: Install openjdk java (package)
  tasks:
  - name: Install openjdk java package
    apt:
      name: openjdk-8-jdk
      state: present

- name: Install RPM
  tasks:
  - name: Install RPM package
    apt:
      name: rpm
      state: present

- name: Install DEB
  tasks:
  - name: Install DEB package
    apt:
      name: deb
      state: present

- name: Install oracle java (rpm) (repository)
  tasks:
  - name: Install oracle java (rpm) package from the repository
    apt_repository:
      repo: ppa:webupd8team/java
      state: present
    apt:
      name: oracle-java8-installer
      state: present

- name: Configure oracle targz
  tasks:
  - name: Configure oracle java (targz)
    apt_repository:
      repo: ppa:webupd8team/java
      state: present
    apt:
      name: oracle-java8-installer
      state: present

- name: Install oracle java policy software (targz)
  tasks:
  - name: Install oracle java policy software (targz)
    apt:
      name: oracle-java8-policy
      state: present

- name: Set alternative (targz)
  tasks:
  - name: Set alternative for java
    alternatives:
      name: java
      path: /usr/lib/jvm/java-8-oracle/bin/java
      state: present

- name: Find JAVA_HOME
  tasks:
  - name: Find the JAVA_HOME directory
    shell: echo "/usr/lib/jvm/java-8-oracle"

- name: Set JAVA_HOME in /etc/environment
  tasks:
  - name: Set the JAVA_HOME environment variable
    lineinfile:
      dest: /etc/environment
      regexp: '^JAVA_HOME'
      line: JAVA_HOME=/usr/lib/jvm/java-8-oracle
      state: present


