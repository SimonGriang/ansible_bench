---
- name: Install RKE2
  hosts: localhost
  gather_facts: no
  become: yes
  vars:
    rke2_install_bash_url: "https://example.com/rke2-install-bash.sh"
    rke2_install_script_dir: "/path/to/rke2-install-script"
    rke2_artifact_fetch_timeout: 300
    rke2_artifact_path: "/path/to/rke2-artifacts"
    rke2_airgap_copy_sourcepath: "/path/to/airgap-copy-source"
    rke2_artifact_url: "https://example.com/rke2-artifacts"
    rke2_version: "1.23.4"
    rke2_architecture: "amd64"
    rke2_tarball_images_path: "/path/to/rke2-tarball-images"
    rke2_type: "example"
    airgap_implementation: "download"
    rke2_tarball_images: "yes"
    rke2_install_script_mode: "0700"
    rke2_install_script_executable: "no"
    rke2_custom_manifests: "manifest1, manifest2"
    rke2_static_pods: "pod1, pod2"

  tasks:
  - name: Download RKE2 installation script
    get_url:
      url: "{{ rke2_install_bash_url }}"
      dest: "{{ rke2_install_script_dir }}/rke2.sh"
      mode: '0700'
      timeout: "{{ rke2_artifact_fetch_timeout }}"

  - name: Copy local RKE2 installation script
    copy:
      content: "{{ lookup('file', '{{ rke2_airgap_copy_sourcepath }}/rke2.sh') }}"
      dest: "{{ rke2_install_script_dir }}/rke2.sh"
      mode: '0700'
      force: yes

  - name: Create RKE2 artifacts folder
    file:
      path: "{{ rke2_artifact_path }}"
      state: directory
      mode: '0700'

  - name: Download RKE2 checksum and artifacts
    get_url:
      url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ rke2_architecture }}.txt"
      dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
      mode: '0640'
      timeout: "{{ rke2_artifact_fetch_timeout }}"
    when: airgap_implementation == 'download'

    get_url:
      url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ rke2_architecture }}.tar.gz"
      dest: "{{ rke2_artifact_path }}/{{ rke2_architecture }}.tar.gz"
      mode: '0640'
      timeout: "{{ rke2_artifact_fetch_timeout }}"
    when: airgap_implementation == 'download'

    get_url:
      url: "{{ rke2_install_bash_url }}"
      dest: "{{ rke2_install_script_dir }}/rke2.sh"
      mode: '0700'
      timeout: "{{ rke2_artifact_fetch_timeout }}"
    when: airgap_implementation == 'download'

  - name: Copy local RKE2 artifacts
    copy:
      content: "{{ lookup('file', '{{ rke2_airgap_copy_sourcepath }}/{{ item }}') }}"
      dest: "{{ rke2_artifact_path }}/{{ item }}"
      mode: '0640'
      force: yes
    loop: "{{ rke2_artifacts }}"
    when: airgap_implementation == 'copy'

  - name: Airgap mode - additional images tarballs
    file:
      path: "{{ rke2_tarball_images_path }}"
      state: directory
      mode: '0700'
    when: airgap_implementation == 'exists' and rke2_tarball_images

    copy:
      content: "{{ lookup('file', '{{ rke2_airgap_copy_sourcepath }}/{{ item }}') }}"
      dest: "{{ rke2_tarball_images_path }}/{{ item }}"
      mode: '0644'
      force: yes
    loop: "{{ rke2_tarball_images }}"
    when: airgap_implementation == 'exists' and rke2_tarball_images

  - name: Airgap mode - ensure artifacts exist and have acceptable permissions
    stat:
      path: "{{ rke2_artifact_path }}/{{ item }}"
    register: artifact
    loop: "{{ rke2_artifacts }}"
    when: airgap_implementation == 'exists'

    file:
      path: "{{ rke2_artifact_path }}/{{ item }}"
      state: file
      mode: '0640'
    when: artifact.stat.exists and airgap_implementation == 'exists'

    file:
      path: "{{ rke2_install_script_dir }}/rke2.sh"
      state: file
      mode: '0700'
    when: rke2_install_script_mode == '0700' and airgap_implementation == 'exists'

    file:
      path: "{{ rke2_install_script_dir }}/rke2.sh"
      state: file
      mode: '0700'
      recurse: true
    when: rke2_install_script_mode == '0700' and airgap_implementation == 'exists'

    file:
      path: "{{ rke2_install_script_dir }}/rke2.sh"
      state: file
      mode: '0700'
      recurse: true
      executable: yes
    when: not rke2_install_script_executable and airgap_implementation == 'exists'

  - name: Populate service facts
    service_facts:
      enabled: true

  - name: Get stats of the FS object
    stat:
      path: "/usr/local"

  - name: Check if separate partition
    stat:
      path: "/usr/local"

  - name: Set RKE2 bin path
    set_fact:
      rke2_bin_path: "/usr/local/bin"

  - name: Check RKE2 version
    shell:
      cmd: rke2 --version
    register: rke2_version
    failed_when: rke2_version.stderr | length > 0

  - name: Prevent accidental RKE2 downgrade
    assert:
      that: rke2_version.stdout | length > 0

  - name: Run RKE2 install script
    shell:
      cmd: "{{ rke2_install_script_dir }}/rke2.sh {{ rke2_airgap_copy_sourcepath }} {{ rke2_artifact_path }} {{ rke2_tarball_images_path }} {{ rke2_type }} {{ airgap_implementation }} {{ rke2_artifacts }} {{ rke2_tarball_images }}"
      args:
        chdir: "{{ rke2_install_script_dir }}"

  - name: Copy Custom Manifests
    copy:
      content: "{{ lookup('file', '{{ item }}') }}"
      dest: "{{ rke2_data_path }}/server/manifests/{{ item }}"
      owner: root
      group: root
      mode: '0644'
    loop: "{{ rke2_custom_manifests }}"
    notify: restart rke2

  - name: Copy Static Pods
    copy:
      content: "{{ lookup('file', '{{ item }}') }}"
      dest: "{{ rke2_data_path }}/agent/pod-manifests/{{ item }}"
      owner: root
      group: root
      mode: '0644'
    loop: "{{ rke2_static_pods }}"
    notify: restart rke2

  - name: Copy RKE2 environment file
    copy:
      content: "{{ lookup('template', 'rke2_environment.j2') }}"
      dest: "/etc/default/rke2-{{ rke2_type }}"
      owner: root
      group: root
      mode: '0644'
    notify: restart rke2

