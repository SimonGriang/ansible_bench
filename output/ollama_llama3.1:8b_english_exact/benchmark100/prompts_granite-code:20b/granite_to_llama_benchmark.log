_count': 473, 'eval_duration': 3818572592, 'model_name': 'llama3.1:8b'} id='run--e4a382e1-ae6d-4082-8526-6449ce8f172f-0' usage_metadata={'input_tokens': 545, 'output_tokens': 473, 'total_tokens': 1018}
