---
- name: Install Keepalived when HA mode is enabled
  apt:
    name: keepalived
    state: present
  when: ha_mode == True

- name: Download and install RKE2 {{ rke2_version }}
  get_url:
    url: https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2_{{ rke2_version }}_linux_amd64
    dest: /usr/local/bin/rke2
    mode: '0755'
  apt:
    name: curl
    state: present
  shell: |
    curl -sSL https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2_{{ rke2_version }}_linux_amd64.sha256sum | sha256sum -c --
    if [ $? -ne 0 ]; then echo "Download failed"; exit 1; fi
    mv rke2_{{ rke2_version }}_linux_amd64 /usr/local/bin/rke2
    chmod 0755 /usr/local/bin/rke2

- name: CIS Hardening
  template:
    src: cis-hardening.j2
    dest: /etc/rke2/cis-hardening.yml
    mode: '0644'

- name: Find Active Server
  command:
    cmd: rke2 get-activeserver
  register: activeserver
  when: rke2_mode == 'cluster'

- name: Enable IPVS kernel module
  modprobe:
    name: ip_vs

- name: Copy kube-vip manifests to the masternode
  copy:
    src: templates/kube-vip.yml
    dest: /etc/rke2/templates/kube-vip.yml
    mode: '0644'

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: templates/ingress-nginx.yml
    dest: /etc/rke2/templates/ingress-nginx.yml
    mode: '0644'

- name: Prepare very first server node in the cluster
  command:
    cmd: rke2 join --token {{ rke2_token }} {{ activeserver.stdout }}

- name: Restore etcd specific tasks
  template:
    src: etcd-hardening.j2
    dest: /etc/rke2/etcd-hardening.yml
    mode: '0644'
  when: restore_etcd == True

- name: Download kubeconfig to ansible localhost
  fetch:
    src: /etc/rke2/rke2-cluster.yml
    dest: /etc/ansible/rke2-cluster.yml
    flat: yes

- name: Prepare and join remaining nodes of the cluster
  command:
    cmd: rke2 join --token {{ rke2_token }} {{ activeserver.stdout }}
  when: rke2_mode == 'cluster'

- name: Rolling cordon and drain restart when version changes - servers
  shell: |
    for node in $(rke2 get-nodes --state=running); do rke2 cordon $node && rke2 drain $node; done
    rke2 rolling-update --force

- name: Rolling cordon and drain restart when version changes - agents
  shell: |
    for node in $(rke2 get-nodes --state=running); do rke2 cordon $node && rke2 drain $node; done
    rke2 rolling-update --force

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  shell: |
    rke2 rolling-update --force

- name: Final steps
  debug:
    msg: Final steps completed successfully


