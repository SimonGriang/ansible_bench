    name: "{{ mysql_packages }}"
    state: 'present'

- name: Configure mysql server
  template:
    src: mysql-server.j2
    dest: "{{ mysql_configuration_destination }}/mysql-server.cnf"
    mode: '0644'
  notify:
    - restart mysql

- name: Configure mysql client
  template:
    src: mysql-client.j2
    dest: "{{ mysql_configuration_destination }}/mysql-client.cnf"
    mode: '0644'
  notify:
    - restart mysql

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta:
    flush_handlers: true

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0600'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  with_items:
    - "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items:
    - "{{ mysql_users }}"

- name: Flush handlers again
  meta:
    flush_handlers: true

