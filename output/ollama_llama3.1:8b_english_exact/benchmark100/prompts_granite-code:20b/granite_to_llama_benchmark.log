      bootstrap_os_family: "{{ item.value | regex_search('NAME=\"(Ubuntu|Debian|Red Hat|CentOS|Fedora|Amazon Linux|SUSE Linux|Arch Linux|Manjaro)\"' ) | regex_replace('\"', '') }}"
    loop: "{{ os_release.stdout_lines | json_query('[@][?starts_with(key, "NAME") or starts_with(key, "VERSION_ID") ]') }}"

