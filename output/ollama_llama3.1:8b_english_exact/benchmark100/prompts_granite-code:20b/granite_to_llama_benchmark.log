---
- name: Configure and enable httpd service
  tasks:
  - name: Install apache httpd
    package:
      name: httpd
      state: present

  - name: Configure selinux
    selinux:
      state: present
      allow_httpd_builtin_port: yes
      allow_httpd_port: yes

  - name: Configure httpd
    template:
      src: httpd.conf.j2
      dest: /etc/httpd/conf/httpd.conf
      mode: '0644'
    notify:
      - test httpd configuration validity
      - restart httpd

  - name: Activate httpd module | Debian
    command: a2enmod {{ item }}
    when: ansible_os_family == 'Debian'
    notify:
      - test httpd configuration validity

  - name: Import ssl.yml
    include_vars:
      file: ssl.yml
      when: https_ssl_enable == true

  - name: Import locations.yml
    include_vars:
      file: locations.yml
      when: httpd_locations is defined

  - name: Import vhosts.yml
    include_vars:
      file: vhosts.yml
      when: httpd_vhosts is defined

  - name: Configure ports
    template:
      src: ports.conf.j2
      dest: /etc/apache2/ports.conf
      mode: '0644'
    when: (ansible_os_family == 'Debian') or (ansible_os_family == 'Suse')
    notify:
      - test httpd configuration validity
      - restart httpd

  - name: Import directories.yml
    include_vars:
      file: directories.yml
      when: httpd_directories is defined

  - name: Flush handlers
    meta:
      flush_handlers

  - name: Removing default html
    file:
      path: /var/www/html/index.html
      state: absent
    when: httpd_remove_example == true

  - name: Start and enable httpd
    service:
      name: httpd
      state: started
      enabled: yes

  # Added a new line character at the end of the file

