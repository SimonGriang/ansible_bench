---
- name: RKE2 config tasks
  tasks:
  - name: Create the RKE2 config dir
    file:
      path: /etc/rancher/rke2
      state: directory

  - name: Set server taints
    set_fact:
      server_taints: ~
    when: inventory_hostname == groups['servers'][0]

  - name: Set agent taints
    set_fact:
      agent_taints: ~
    when: inventory_hostname == groups['agents'][0]

  - name: Copy RKE2 config
    copy:
      src: /path/to/rke2.conf
      dest: /etc/rancher/rke2/config.yaml
      mode: '0644'

  - name: Copy kubelet config
    copy:
      src: /path/to/kubelet.conf
      dest: /etc/systemd/system/kubelet.service.d/10-kubelet.conf
      mode: '0644'
    when: kubelet_config is defined

  - name: Copy Containerd Registry Configuration file
    copy:
      src: /path/to/registry.conf
      dest: /etc/containerd/config.toml
      mode: '0644'
    when: custom_registry is defined

  - name: Start RKE2 service on the rest of the nodes
    service:
      name: rke2
      state: started
    when: inventory_hostname not in groups['servers'] and inventory_hostname not in groups['agents']

  - name: Mask other RKE2 service on the rest of the nodes
    service:
      name: rke2
      state: masked
    when: inventory_hostname not in groups['servers'] and inventory_hostname not in groups['agents']

  - name: Wait for remaining nodes to be ready - no CNI
    wait_for:
      host: localhost
      port: 22
      timeout: 300
    when: cni is not defined

  - name: Wait for remaining nodes to be ready - with CNI
    wait_for:
      host: localhost
      port: 22
      timeout: 300
    when: cni is defined


