- name: Tasks to handle EXTERNALLY-MANAGED file
  tasks:
    - name: Remove EXTERNALLY-MANAGED file if we're on Debian12
      file:
        path: /path/to/EXTERNALLY-MANAGED
        state: absent
      when: ansible_distribution == 'Debian' and ansible_distribution_major_version == '12'

    - name: Get python3 version installed
      shell:
        cmd: python3 --version
      register: python_version

    - name: Remove EXTERNALLY-MANAGED
      file:
        path: /path/to/EXTERNALLY-MANAGED
        state: absent
      when: ansible_distribution == 'Debian' and ansible_distribution_major_version == '12' and python_version.stdout.startswith('Python 3.11')

