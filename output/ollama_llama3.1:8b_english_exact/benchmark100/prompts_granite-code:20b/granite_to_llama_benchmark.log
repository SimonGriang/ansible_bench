---
- name: OpenVPN client configuration tasks
  tasks:
  - name: Ensure /etc/openvpn/client exists
    file:
      path: /etc/openvpn/client
      state: directory
      owner: openvpn
      group: openvpn
      mode: '0755'

  - name: Place client.conf
    template:
      src: templates/client.conf.j2
      dest: /etc/openvpn/client/client.conf
      owner: openvpn
      group: openvpn
      mode: '0644'
    notify: Restart openvpn

  - name: Restart openvpn
    service:
      name: openvpn
      state: restarted
    listen: Restart openvpn

