---
- name: password | Get efi path
  stat:
    path: /EFI/BOOT/grub.cfg
  register: efi_path

- name: password | Remove unwanted grub.cfg on EFI systems
  file:
    path: "{{ efi_path.path }}"
    state: absent

- name: password | Install user template
  template:
    src: templates/user.j2
    dest: /etc/user.conf
    mode: '0644'

- name: password | EFI | add password
  lineinfile:
    path: /EFI/BOOT/grub.cfg
    line: "password --efi {{ password }}"

- name: password | MBR | add password
  lineinfile:
    path: /boot/grub/grub.cfg
    line: "password --mbr {{ password }}"

- name: password | Add --unrestricted
  replace:
    path: /etc/user.conf
    regexp: '(^| )restricted( |$)'
    replace: '\1unrestricted\3'


