tribution }}-{{ ansible_distribution_major_version }}-{{ ansible_machine }}\n\n\n- name: Install Java, RedHat if ansible_os_family equals RedHat\n  yum:\n    name: "{{ item }}"\n    state: present\n  when: ansible_os_family == "RedHat"\n  loop:\n    - java-{{ java_jdk_version_major }}-{{ java_jdk_version_minor }}-{{ java_jdk_version_update }}-{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}-{{ ansible_machine }}\n\n\n- name: Export environment variables\n  environment:\n    JAVA_HOME: "{{ java_open_jdk_path }}"\n    PATH: "{{ java_open_jdk_bin_path }}:{{ PATH }}"\n\n\n- name: Source environment variables\n  shell:\n    cmd: "source /etc/profile.d/java.sh"\n\n\n- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11 if ansible_os_family equals Debian and java_open_jdk_version_major is less than 11\n  shell:\n    cmd: "sed -i \'s|/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java|/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java|\' /etc/java-{{ java_jdk_version_major }}-{{ java_jdk_version_minor }}-{{ java_jdk_version_update }}-{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}-{{ ansible_machine }}/java.conf"\n  when: (ansible_os_family == "Debian" and java_open_jdk_version_major < 11)\n\n\n- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11 if ansible_os_family equals Debian and java_open_jdk_version_major is greater than or equal to 11\n  shell:\n    cmd: "sed -i \'s|/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java|/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java|\' /etc/java-{{ java_jdk_version_major }}-{{ java_jdk_version_minor }}-{{ java_jdk_version_update }}-{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}-{{ ansible_machine }}/java.conf"\n  when: (ansible_os_family == "Debian" and java_open_jdk_version_major >= 11)' additional_kw