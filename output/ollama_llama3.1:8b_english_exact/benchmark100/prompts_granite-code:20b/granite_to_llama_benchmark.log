---
- name: Git Configuration
  hosts: all
  tasks:
  - name: Install git
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ git_packages }}"
  - name: See if the specified user exists
    getent:
      database: passwd
      name: "{{ git_username }}"
    register: user_exists
  - name: Create directory for git configuration
    file:
      path: /home/{{ git_username }}/.config/git
      state: directory
      owner: "{{ git_username }}"
      group: "{{ git_groupname }}"
      mode: '0750'
  - name: Place git configuration
    template:
      src: templates/gitconfig.j2
      dest: /home/{{ git_username }}/.config/git/config
      owner: "{{ git_username }}"
      group: "{{ git_groupname }}"
      mode: '0600'
    vars:
      git_user_email: "{{ git_user_email }}"
      git_user_name: "{{ git_user_name }}"
      git_username: "{{ git_username }}"
  - name: Create repository_destination
    file:
      path: "{{ git_repository_destination }}"
      state: directory
      owner: "{{ git_username }}"
      group: "{{ git_groupname }}"
      mode: '0750'
  - name: Clone all roles
    git:
      repo: "{{ item }}"
      dest: "{{ git_repository_destination }}"
      version: master
      update: yes
      clone: yes
      accept_hostkey: yes
      user: "{{ git_username }}"
    loop: "{{ git_repositories }}"


