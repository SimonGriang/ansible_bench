---
- name: Configure environment
  tasks:
    - name: Import assert.yml
      include: assert.yml

    - name: Install python pip
      package:
        name: python-pip
        state: present

    - name: Configure pip proxy
      ini_file:
        file: /etc/pip.conf
        section: global
        option: proxy
        value: "{{ proxy_url }}"

    - name: Trust hosts
      ini_file:
        file: /etc/pip.conf
        section: global
        option: trusted-hosts
        value: "{{ proxy_url }}"

    - name: Update pip
      pip:
        name: pip
        state: latest

    - name: Install requested modules
      pip:
        name: "{{ item }}"
        state: present
      loop:
        - '{{ item }}'
      loop_control:
        loop_var: item


