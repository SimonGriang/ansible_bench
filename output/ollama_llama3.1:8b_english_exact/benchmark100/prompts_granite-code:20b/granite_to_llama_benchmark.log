--- 

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    name: "{{ git_username }}"
  register: user_exists

- name: Create directory for git configuration
  file:
    path: /home/{{ git_username }}/.gitconfig
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0700'

- name: Place git configuration
  template:
    src: templates/gitconfig.j2
    dest: /home/{{ git_username }}/.gitconfig
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0600'
  notify: restart git

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0700'

- name: Clone all roles
  git:
    repo: "{{ item }}"
    dest: "{{ git_repository_destination }}/{{ item }}"
    version: main
    update: yes
    clone: yes
  loop: "{{ git_repositories }}"
  become: yes
  become_user: "{{ git_username }}"

