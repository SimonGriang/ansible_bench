--- 

- name: Install and configure cadvisor
  hosts: localhost

  tasks:
  - name: Create directories
    file:
      path: /opt/cadvisor
      state: directory

  - name: Download binary file
    get_url:
      url: https://github.com/google/cadvisor/releases/download/v0.37.0/cadvisor-0.37.0.linux-arm64.tar.gz
      dest: /opt/cadvisor/cadvisor-0.37.0
      sha256: 66134d860a6f690760368235395766608d908d7439654425793356e66e302f8a

  - name: Propagate locally distributed cadvisor binary
    copy:
      content: /home/dev/bin/cadvisor/cadvisor-0.37.0
      dest: /opt/cadvisor/cadvisor-0.37.0
      mode: '0755'

  - name: Symlink
    file:
      src: /opt/cadvisor/cadvisor-0.37.0
      dest: /opt/cadvisor/cadvisor
      state: link

  - name: Template file /etc/systemd/system/cadvisor.service
    template:
      src: systemd-system-cadvisor-service.j2
      dest: /etc/systemd/system/cadvisor.service
      mode: '0644'

  - name: Test task
    shell:
      cmd: "if ! systemctl is-active cadvisor.service; then echo false; else echo true; fi"
      register: service_active

  - name: Debug
    debug:
      var: service_active

  - name: Enable server systemd
    systemd:
      name: cadvisor.service
      enabled: yes

  - name: Start server systemd
    systemd:
      name: cadvisor.service
      state: started
      daemon_reload: yes

