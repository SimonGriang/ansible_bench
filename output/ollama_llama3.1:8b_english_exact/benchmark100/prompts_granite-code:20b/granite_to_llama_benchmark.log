---
- name: Install Keepalived when HA mode is enabled
  apt:
    name: keepalived
    state: present
  when: ha_mode == true

- name: Download and install RKE2 {{ rke2_version }}
  get_url:
    url: https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2-install.sh
    dest: /tmp
  shell: |
    rm -rf /usr/local/bin/rke2
    chmod +x /tmp/rke2-install.sh
    /tmp/rke2-install.sh install
  become: yes

- name: CIS Hardening
  import_role:
    name: cis_rke2

- name: Find Active Server
  shell: |
    ACTIVE_SERVER=$(kubectl get nodes --field-selector=status.conditions[?(@.type=="Ready")].status=="True" | awk '{print $1}' | head -1)
    echo "{{ ACTIVE_SERVER }}"

- name: Enable IPVS kernel module
  modprobe:
    name: ip_vs
    state: present

- name: Copy kube-vip manifests to the masternode
  copy:
    src: "/path/to/kube-vip/manifests"
    dest: "/path/to/master/node/manifests"

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: "/path/to/ingress-nginx/manifests"
    dest: "/path/to/master/node/manifests"

- name: Prepare very first server node in the cluster
  shell: |
    kubectl label nodes "{{ ACTIVE_SERVER }}" master=true

- name: Restore etcd specific tasks
  import_role:
    name: etcd_restore
  when: restore_options == true

- name: Download kubeconfig to ansible localhost
  shell: |
    kubectl config view --flatten > /path/to/kubeconfig
    echo ""

- name: Prepare and join remaining nodes of the cluster
  shell: |
    for node in $(kubectl get nodes --field-selector=status.conditions[?(@.type=="Ready")].status=="True" | awk '{print $1}' | tail -1); do
      kubectl label nodes "{{ node }}" master=true
    done

- name: Rolling cordon and drain restart when version changes - servers
  shell: |
    kubectl cordon $(kubectl get nodes --field-selector=status.conditions[?(@.type=="Ready")].status=="True" | awk '{print $1}' | head -1)
    kubectl drain $(kubectl get nodes --field-selector=status.conditions[?(@.type=="Ready")].status=="True" | awk '{print $1}' | head -1)
    kubectl rollout restart deployment --all

- name: Rolling cordon and drain restart when version changes - agents
  shell: |
    kubectl cordon $(kubectl get nodes --field-selector=status.conditions[?(@.type=="Ready")].status=="True" | awk '{print $1}' | tail -1)
    kubectl drain $(kubectl get nodes --field-selector=status.conditions[?(@.type=="Ready")].status=="True" | awk '{print $1}' | tail -1)
    kubectl rollout restart deployment --all

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  shell: |
    kubectl rollout restart deployment --all

- name: Final steps
  shell: |
    echo "Cluster deployment completed successfully"
    echo "Final steps executed"

