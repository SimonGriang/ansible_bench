---
- name: Certificate Tasks
  tasks:
  - name: Check if certificates exists
    stat:
      path: /path/to/certificates
    register: certificates_exists

  - name: Fail if some cert doesn't exist
    fail:
      msg: "Some certificates do not exist"

  - name: Setting keystore variables in java < 11
    set_fact:
      keystore_type: "JKS"
      keystore_provider: "SUN"
    when: ansible_java_version < "11"

  - name: Setting keystore variables in java >= 11
    set_fact:
      keystore_type: "PKCS12"
      keystore_provider: "Oracle"
    when: ansible_java_version >= "11"

  - name: Import SSL certificates
    java_cert:
      cert: "/path/to/ssl/cert"


