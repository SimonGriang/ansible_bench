--- 

- name: Configure DNS
  tasks:
  - name: Import assert.yml
    include_yaml: assert.yml

  - name: Install dns
    apt:
      name: dnsutils
      state: present

  - name: Create directories
    file:
      path: /etc/bind
      state: directory
      mode: '0755'
      owner: bind
      group: bind

  - name: Create named directory
    file:
      path: /etc/bind/named
      state: directory
      mode: '0755'
      owner: bind
      group: bind

  - name: Create named.conf directory
    file:
      path: /etc/bind/named.conf
      state: directory
      mode: '0755'
      owner: bind
      group: bind

  - name: Create group
    group:
      name: bind
      state: present

  - name: Create user
    user:
      name: bind
      group: bind
      system: yes
      create_home: no
      home: /var/named
      state: present

  - name: Generate rndc key
    rndc:
      action: gss-keygen
      state: present

  - name: Set permissions on rndc key file
    file:
      path: /etc/bind/rndc.key
      state: file
      mode: '0600'
      owner: bind
      group: bind

  - name: Get the hints/root file
    get_url:
      url: https://www.internic.net/domain/named.root
      dest: /etc/bind/named.root
      force: yes
      mode: '0644'
      owner: bind
      group: bind

  - name: Create zone file
    template:
      src: templates/zone.j2
      dest: /etc/bind/{{ item.zone }}.conf
      mode: '0644'
      owner: bind
      group: bind
    with_items: dns_zones

  - name: Add zones to configuration
    template:
      src: templates/named.conf.j2
      dest: /etc/bind/named.conf
      mode: '0644'
      owner: bind
      group: bind

  - name: Place systemd override
    template:
      src: templates/bind.service.j2
      dest: /etc/systemd/system/bind.service.d/override.conf
      mode: '0644'
      owner: root
      group: root

  - name: Start and enable dns
    service:
      name: bind9
      state: started
      enabled: yes

