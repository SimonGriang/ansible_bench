---
- name: SSL/TLS management playbook
  hosts: localhost

  tasks:
  - name: Create ssl key
    openssl_privatekey:
      path: /etc/ssl/private/{{ inventory_hostname }}.key
      size: 4096
    become: true

  - name: Create ssl csr
    openssl_csr:
      path: /etc/ssl/private/{{ inventory_hostname }}.csr
      private_key_path: /etc/ssl/private/{{ inventory_hostname }}.key
      common_name: {{ inventory_hostname }}
    become: true

  - name: Create ssl certificates
    openssl_certificate:
      path: /etc/ssl/certs/{{ inventory_hostname }}.crt
      csr_path: /etc/ssl/private/{{ inventory_hostname }}.csr
      private_key_path: /etc/ssl/private/{{ inventory_hostname }}.key
      provider: selfsigned
    become: true

  - name: Create PKCS#12 file
    openssl_pkcs12:
      path: /etc/ssl/private/{{ inventory_hostname }}.p12
      privatekey_path: /etc/ssl/private/{{ inventory_hostname }}.key
      certificate_path: /etc/ssl/certs/{{ inventory_hostname }}.crt
      password: some_password
    become: true

  - name: Read private key
    ansible.builtin.copy:
      content: |
        -----BEGIN RSA PRIVATE KEY-----
        {{ lookup('file', '/etc/ssl/private/{{ inventory_hostname }}.key') }}
        -----END RSA PRIVATE KEY-----
      dest: /tmp/{{ inventory_hostname }}.key
      mode: '0644'
    become: true

  - name: Read certificate
    ansible.builtin.copy:
      content: |
        -----BEGIN CERTIFICATE-----
        {{ lookup('file', '/etc/ssl/certs/{{ inventory_hostname }}.crt') }}
        -----END CERTIFICATE-----
      dest: /tmp/{{ inventory_hostname }}.crt
      mode: '0644'
    become: true

  - name: Create combined private_key and certificate file
    ansible.builtin.copy:
      content: |
        -----BEGIN RSA PRIVATE KEY-----
        {{ lookup('file', '/etc/ssl/private/{{ inventory_hostname }}.key') }}
        -----END RSA PRIVATE KEY-----
        -----BEGIN CERTIFICATE-----
        {{ lookup('file', '/etc/ssl/certs/{{ inventory_hostname }}.crt') }}
        -----END CERTIFICATE-----
      dest: /tmp/{{ inventory_hostname }}.key_and_crt
      mode: '0644'
    become: true


