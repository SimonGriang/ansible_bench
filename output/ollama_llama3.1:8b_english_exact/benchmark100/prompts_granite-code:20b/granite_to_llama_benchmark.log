---
- name: Install fail2ban
  apt:
    name: fail2ban
    state: present

- name: Copy filters in filter.d
  copy:
    src: /path/to/filters.conf
    dest: /etc/fail2ban/filter.d
    owner: root
    group: root
    mode: '0640'

- name: Configure fail2ban.local
  ini_file:
    dest: /etc/fail2ban/fail2ban.local
    section: fail2ban
    options:
      - name: loglevel
        value: INFO
      - name: logtarget
        value: /var/log/fail2ban.log
    state: present

- name: Configure jail.local
  ini_file:
    dest: /etc/fail2ban/jail.local
    section: jail
    options:
      - name: enabled
        value: 'true'
      - name: filter
        value: 'ssh-iptables'
      - name: banaction
        value: 'iptables-allports'
    state: present

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
    state: file

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    owner: root
    group: adm
    mode: '0640'

- name: Start and enable fail2ban
  service:
    name: fail2ban
    state: started
    enabled: yes

