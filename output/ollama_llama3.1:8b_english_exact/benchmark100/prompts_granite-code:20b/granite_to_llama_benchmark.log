--- 

- name: Load OS-specific vars
  include_vars: "{{ ansible_distribution }}.yml"

- name: Install Docker packages
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - docker.io
    - containerd

- name: Install docker-compose plugin
  pip:
    name: docker-compose

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Configure Docker daemon options
  template:
    src: dockerdaemon.j2
    dest: /etc/docker/daemon.json
    mode: '0644'
  notify:
    - restart docker

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: started
    enabled: yes

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta:
    hostvars: "{{ groups['docker'] | map('extract', hostvars) | group_by('docker') | list }}"
    handlers:
      - restart docker

- name: Ensure docker-compose is installed
  pip:
    name: docker-compose

- name: Ensure docker group users are in the docker group
  user:
    name: "{{ item }}"
    group: docker
    append: yes
  loop:
    - "{{ ansible_user_id }}"

