---
- name: Configure Promtail
  tasks:
  - name: Check if the system uses systemd
    assert:
      that: ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian'
      msg: "This module only works with systemd as the init system."
  - name: Retrieve the latest release of Promtail
    uri:
      url: https://api.github.com/repos/promtail/promtail/releases/latest
      method: GET
      return_content: true
    register: promtail_release
  - name: Set the Promtail version to the latest release
    set_fact:
      promtail_version: "{{ promtail_release.json.tag_name }}"


