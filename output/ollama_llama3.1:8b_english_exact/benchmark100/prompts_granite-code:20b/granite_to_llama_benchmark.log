      state: present

  - name: Create promtail group
    group:
      name: promtail
      state: present

  - name: Create the promtail user
    user:
      name: promtail
      group: promtail
      create_home: yes
      home: /home/promtail
      state: present

  - name: Ensure /usr/local/bin exists
    file:
      path: /usr/local/bin
      state: directory
      mode: '0755'

  - name: Create config directories
    file:
      path: /etc/promtail
      state: directory
      mode: '0755'

  - name: Create application dirs
