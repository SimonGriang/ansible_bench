---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install prerequisites
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - python3-pip
    - python3-dev
    - build-essential
    - libssl-dev
    - libffi-dev
    - python3-setuptools

- name: Include installation method specific tasks
  include_tasks: "{{ vault_type }}.yml"

- name: Add Vault environment variables
  environment:
    VAULT_ADDR: "https://127.0.0.1:8200"
    VAULT_SKIP_VERIFY: "1"

- name: Include hardening tasks
  include_tasks: hardening.yml

- name: Start and enable vault
  service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"

- name: Enable vault
  service:
    name: vault
    state: enabled
  when: vault_type != "oss"


