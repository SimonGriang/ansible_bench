---
- name: Tasks for Vault installation
  tasks:

  - name: Create group vault
    group:
      name: vault
      state: present

  - name: Create user vault
    user:
      name: vault
      group: vault
      create_home: yes
      state: present

  - name: Create directory /opt/vault
    file:
      path: /opt/vault
      state: directory
      mode: '0755'

  - name: Download Vault binary
    get_url:
      url: 'https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_amd64.zip'
      dest: /opt/vault
      mode: '0644'

  - name: Create directory /etc/vault.d
    file:
      path: /etc/vault.d
      state: directory
      mode: '0755'

  - name: Copy Vault binary
    unarchive:
      src: /opt/vault/vault_{{ vault_version }}_linux_amd64.zip
      dest: /opt/vault
      compression: zip
      skip_cleanup: yes

  - name: Set cap_ipc_lock=ep on /usr/bin/vault
    setfacl:
      file: /usr/bin/vault
      set: "d:cap_ipc_lock=ep"

  - name: Create file /etc/vault.d/vault.env
    template:
      src: templates/vault.env.j2
      dest: /etc/vault.d/vault.env
      mode: '0644'

  - name: Create directory /usr/lib/systemd/system
    file:
      path: /usr/lib/systemd/system
      state: directory
      mode: '0755'

  - name: Copy Vault service file
    template:
      src: templates/vault.service.j2
      dest: /usr/lib/systemd/system/vault.service
      mode: '0644'

  - name: Copy vault configuration
    template:
      src: templates/vault.hcl.j2
      dest: /etc/vault.d/vault.hcl
      mode: '0644'

  - name: Flush handlers
    meta:
      hostname: Flush handlers

