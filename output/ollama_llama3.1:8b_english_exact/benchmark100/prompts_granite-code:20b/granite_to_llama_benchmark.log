---
- name: Manage user
  hosts: []
  become: yes

  tasks:
  - name: Create local ssh_key_directory for {{ user.name }}
    file:
      path: '{{ users_ssh_key_directory }}'
      mode: '0750'
      state: directory

  - name: Manage user {{ user.name }}
    user:
      name: '{{ user.name }}'
      home: '{{ users_home_directory }}'
      shell: '{{ user.shell }}'
      password_last_changed: '{{ user.password_last_changed }}'
      password_expires: '{{ user.password_expires }}'
      password_lockout_time: '{{ user.password_lockout_time }}'
      group: '{{ user.group }}'
      append: False

  - name: Set sudo options for {{ user.name }}
    template:
      src: 'sudoers.d/{{ user.name }}.j2'
      dest: '/etc/sudoers.d/{{ user.name }}'
      mode: '0644'
    when: sudo_options is defined and sudo_options | bool

  - name: Remove sudo options for {{ user.name }}
    file:
      path: '/etc/sudoers.d/{{ user.name }}'
      state: absent
    when: not sudo_options or not sudo_options | bool

  - name: Generate private ssh key for {{ user.name }}
    command:
      cmd: '{{ ssh_keygen_command }}'
      chdir: '{{ users_ssh_key_directory }}'
      creates: '{{ users_ssh_key_filename }}'

  - name: Generate public ssh key for {{ user.name }}
    command:
      cmd: '{{ ssh_keygen_pubkey_command }}'
      chdir: '{{ users_ssh_key_directory }}'
      creates: '{{ users_ssh_key_filename }}'

  - name: Convert ssh key to ppk for {{ user.name }}
    command:
      cmd: '{{ ssh_keygen_pubkey_command }} -e -f {{ users_ssh_key_filename }}'
      chdir: '{{ users_ssh_key_directory }}'
      creates: '{{ users_ssh_ppk_filename }}'

  - name: Get or set the home directory for {{ user.name }}
    shell:
      cmd: 'getent passwd {{ user.name }} | cut -d: -f6'
      chdir: '/root'

  - name: Create .ssh directory for {{ user.name }}
    file:
      path: '{{ users_home_directory }}/.ssh'
      mode: '0700'
      state: directory
      owner: '{{ user.name }}'
      group: '{{ user.name }}'

  - name: Deploy authorized keys for {{ user.name }}
    authorized_key:
      user: '{{ user.name }}'
      state: present
      key: '{{ item }}'
    with_items:
      - '{{ users_authorized_keys }}'

  - name: Remove unauthorized keys for {{ user.name }}
    authorized_key:
      user: '{{ user.name }}'
      state: absent
      key: '{{ item }}'
    with_items:
      - '{{ users_unauthorized_keys }}'

  - name: Copy generated private ssh key for {{ user.name }}
    copy:
      content: '{{ lookup('file', '{{ users_ssh_key_filename }}') }}'
      dest: '{{ users_home_directory }}/.ssh/{{ users_ssh_ppk_filename }}'
      mode: '0600'
      owner: '{{ user.name }}'
      group: '{{ user.name }}'

  - name: Check users password valid time for {{ user.name }}
    shell:
      cmd: "awk -v user=\"{{ user.name }}\" \"/{{ user.name }}/{print $4}\" | xargs -I '{}' awk -v user=\"{}\" \"/{{ user.name }}/{print $5}\""
      chdir: '/root'

  - name: Set users password valid time for {{ user.name }}
    command:
      cmd: 'chage -d 0 {{ user.name }}'
      chdir: '/root'

  - name: Place private key file for {{ user.name }}
    copy:
      content: '{{ lookup('file', '{{ users_ssh_key_filename }}') }}'
      dest: '{{ users_home_directory }}/.ssh/{{ users_ssh_ppk_filename }}'
      mode: '0600'
      owner: '{{ user.name }}'
      group: '{{ user.name }}'


