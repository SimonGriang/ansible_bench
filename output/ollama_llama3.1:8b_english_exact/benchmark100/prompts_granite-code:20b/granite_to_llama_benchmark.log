      name: bind
      state: present

  - name: Create user
    user:
      name: bind
      group: bind
      system: yes
      create_home: no
      home: /var/named
      state: present

  - name: Generate rndc key
    rndc:
      action: gss-keygen
      state: present

  - name: Set permissions on rndc key file
    file:
      path: /etc/bind/rndc.key
      state: file
      mode: '0600'
      owner: bind
      group: bind

  - name: Get the hints/root file
