---
- name: Configure cron
  import_tasks: assert.yml

- name: Install cron
  apt:
    name: cron
    state: present

- name: Configure shell
  shell:
    cmd: "update-alternatives --set /bin/sh /usr/bin/bash"

- name: Configure path
  file:
    path: /etc/environment
    state: present
    mode: '0644'
  notify: reload system services

- name: Configure mailto
  lineinfile:
    dest: /etc/crontab
    regexp: '^MAILTO='
    line: MAILTO=root
    state: present

- name: Start and enable cron
  service:
    name: cron
    enabled: yes
    state: started

- name: Schedule requested cron jobs
  cron:
    absent: no
    minute: '*/5'
    hour: '*/12'
    job: /usr/bin/find /home -name '*.log' -type f -delete


