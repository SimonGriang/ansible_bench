---
- name: Bootstrap Facts
  hosts: all

  tasks:
  - name: Gather information about the operating system
    command: cat /etc/os-release
    register: os_release

  - name: Set bootstrap facts (I)
    set_fact:
      bootstrap_distribution: "{{ item.value | regex_replace('NAME=\"(.*?)\"' , '\\1') }}"
      bootstrap_distribution_major_version: "{{ item.value | regex_search('VERSION_ID=\"(.*?)\"' ) | regex_replace('\"', '') | split('.') | first }}"
    loop: "{{ os_release.stdout_lines | json_query('[@][?starts_with(key, "NAME") or starts_with(key, "VERSION_ID") ]') }}"

