---
- name: Play to configure service
  import_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ required_packages }}"
  when: ansible_service_mgr in ['systemd', 'sysvinit', 'upstart', 'openrc']

- name: Configure systemd service
  template:
    src: templates/service.service.j2
    dest: /etc/systemd/system/service.service
    mode: '0644'
  when: ansible_service_mgr == 'systemd'

- name: Configure sysvinit service
  template:
    src: templates/service.service.j2
    dest: /etc/init.d/service
    mode: '0755'
  when: ansible_service_mgr in ['sysvinit', 'upstart', 'openrc']

- name: Manage service
  service:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    enabled: "{{ item.enabled }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers


