---
- name: Configure Apache HTTPD server
  become: yes
  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install apache httpd
    package:
      name: apache2
      state: present

  - name: Configure selinux
    seboolean:
      name: httpd_enable_homedirs
      state: enabled
    seboolean:
      name: httpd_disable_trans
      state: disabled

  - name: Configure httpd
    template:
      src: templates/httpd.conf.j2
      dest: /etc/httpd/conf/httpd.conf
      mode: '0644'

  - name: Activate httpd module | Debian
    apt:
      name: libapache2-mod-php
      state: present
    when: ansible_distribution == 'Debian'

  - name: Import ssl.yml
    import_tasks: ssl.yml

  - name: Import locations.yml
    import_tasks: locations.yml

  - name: Import vhosts.yml
    import_tasks: vhosts.yml

  - name: Configure ports
    lineinfile:
      dest: /etc/httpd/conf.d/ports.conf
      line: NameVirtualHost *:80
      backup: yes

  - name: Import directories.yml
    import_tasks: directories.yml

  - name: Flush handlers
    meta: flush_handlers

  - name: Removing default html
    file:
      path: /var/www/html/index.html
      state: absent

  - name: Start and enable httpd
    service:
      name: httpd
      state: started
      enabled: yes


