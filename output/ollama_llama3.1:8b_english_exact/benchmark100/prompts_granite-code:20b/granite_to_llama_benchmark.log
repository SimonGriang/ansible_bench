content='---\n\n\n---\n\n- name: Set fact java_jdk_vendor to temurin if java_jdk_vendor equals adoptopenjdk\n  set_fact:\n    java_jdk_vendor: "temurin"\n  when: java_jdk_vendor == "adoptopenjdk"\n\n\n- name: Include OS specific variables based on java_jdk_vendor, ansible_distribution, and ansible_distribution_major_version\n  include_vars:\n    file: "os_{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.yaml"\n\n\n- name: Include architecture specific variables\n  include_vars:\n    file: "architecture_{{ ansible_architecture }}.yaml"\n\n\n- name: Set OS specific variables (I)\n  set_fact:\n    java_open_jdk_home_dir: "{{ os_java_open_jdk_home_dir }}"\n\n\n- name: Set OS and architecture specific variables (II)\n  set_fact:\n    java_open_jdk_version_major: "{{ os_java_open_jdk_version_major }}"\n\n\n- name: Set specific variables\n  set_fact:\n    java_version: "{{ os_java_version }}"\n\n\n- name: Add pre-requisites for Debian if ansible_os_family equals Debian\n  apt:\n    name: "{{ os_pre_requisites_debian }}"\n    state: present\n  when: ansible_os_family == "Debian"\n\n\n- name: Add pre-requisites for RedHat if ansible_os_family equals RedHat\n  yum:\n    name: "{{ os_pre_requisites_redhat }}"\n    state: present\n  when: ansible_os_family == "RedHat"\n\n\n- name: Install required libs\n  package:\n    name: "{{ os_required_libs }}"\n    state: present\n\n\n- name: Install Java, Debian if ansible_os_family equals Debian\n  package:\n    name: "{{ os_java_debian }}"\n    state: present\n  when: ansible_os_family == "Debian"\n\n\n- name: Install Java, RedHat if ansible_os_family equals RedHat\n  package:\n    name: "{{ os_java_redhat }}"\n    state: present\n  when: ansible_os_family == "RedHat"\n\n\n- name: Export environment variables\n  shell:\n    cmd: "export PATH=$PATH:/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin"\n\n\n- name: Source environment variables\n  shell:\n    cmd: "source /etc/profile.d/java.sh"\n\n\n- na