---
- name: RKE2 tasks
  hosts: localhost
  become: true

  tasks:
  - name: Create the RKE2 config dir
    file:
      path: /etc/rancher/rke2
      state: directory

  - name: Set server taints
    set_fact:
      server_taints: "{{ rke2_server_node_taints }}"

  - name: Copy rke2 config
    copy:
      content: "{{ lookup('template', 'rke2-config.yaml.j2') }}"
      dest: /etc/rancher/rke2/config.yaml
      mode: '0600'

  - name: Copy kubelet config
    copy:
      content: "{{ lookup('template', 'kubelet-config.yaml.j2') }}"
      dest: /etc/rancher/rke2/kubelet-config.yaml
      mode: '0600'
    when: rke2_kubelet_config != ""

  - name: Copy Containerd Registry Configuration file
    copy:
      content: "{{ lookup('template', 'registries.yaml.j2') }}"
      dest: /etc/rancher/rke2/registries.yaml
      mode: '0600'
    when: (rke2_custom_registry_mirrors != "") or (rke2_custom_registry_configs != "")

  - name: Register if we need to do a etcd restore from file
    set_fact:
      do_etcd_restore: (rke2_etcd_snapshot_file != "") and (rke2-server.service.status == "active")

  - name: Register if we need to do a etcd restore from s3
    set_fact:
      do_etcd_restore_from_s3: (rke2_etcd_snapshot_s3_options.access_key != "") and (rke2_etcd_snapshot_s3_options.secret_key != "") and (rke2_etcd_snapshot_s3_options.bucket != "") and (rke2_etcd_snapshot_s3_options.snapshot_name != "")

  - name: Restore etcd from file
    block:
      - name: Create the RKE2 etcd snapshot directory
        file:
          path: /etc/rancher/rke2/etcd-snapshot
          state: directory
      - name: Copy the etcd snapshot file
        copy:
          content: "{{ lookup('file', rke2_etcd_snapshot_file) }}"
          dest: /etc/rancher/rke2/etcd-snapshot/rke2-etcd-snapshot.tar
      - name: Restore etcd from the snapshot
        command: rke2 server restore --etcd-snapshot /etc/rancher/rke2/etcd-snapshot/rke2-etcd-snapshot.tar
    when: do_etcd_restore

  - name: Restore etcd from s3
    command: rke2 server restore --etcd-snapshot-s3 {{ rke2_etcd_snapshot_s3_options.access_key }}:{{ rke2_etcd_snapshot_s3_options.secret_key }}@{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }}
    when: do_etcd_restore_from_s3

  - name: Start RKE2 service on the first server
    service:
      name: rke2-server
      state: started
      enabled: yes

  - name: Mask RKE2 agent service on the first server
    service:
      name: rke2-agent
      state: masked

  - name: Wait for the first server be ready - no CNI
    wait_for:
      status: 'active'
      host: "{{ inventory_hostname }}"
      timeout: 300
      delay: 10
      connect_timeout: 10
      path: /etc/rancher/rke2/rke2-agent.service
      state: present
      condition: "memory={{ rke2_memory_limit }};disk={{ rke2_disk_limit }};pid={{ rke2_pid_limit }}"
    when: (rke2_kubelet_config == "") and (rke2_cni_provider == "")

  - name: Wait for the first server be ready - with CNI
    wait_for:
      status: 'active'
      host: "{{ inventory_hostname }}"
      timeout: 300
      delay: 10
      connect_timeout: 10
      path: /etc/rancher/rke2/rke2-agent.service
      state: present
      condition: "memory={{ rke2_memory_limit }};disk={{ rke2_disk_limit }};pid={{ rke2_pid_limit }}"
    when: (rke2_kubelet_config != "") and (rke2_cni_provider != "")

  - name: Restore etcd
    block:
      - name: Remove old <node>.node-password.rke2 secrets
        shell: rke2 server remove-secrets
      - name: Remove old nodes
        command: rke2 server remove-nodes
      - name: Remove old etcd snapshot
        command: rke2 server remove-etcd-snapshot
    when: (do_etcd_restore or do_etcd_restore_from_s3)

  - name: Set an Active Server variable
    set_fact:
      active_server: "{{ inventory_hostname }}"
    delegate_to: "{{ rke2_cluster_group_name }}"
    delegate_facts: true


