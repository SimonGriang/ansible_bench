- name: Configure and Schedule Cron Jobs
  tasks:
  - name: Install cron
    package:
      name: cron
      state: present

  - name: Configure shell
    lineinfile:
      dest: /etc/cron.d/crontab
      line: "SHELL=/bin/bash"
      state: present

  - name: Configure path
    lineinfile:
      dest: /etc/cron.d/crontab
      line: "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      state: present

  - name: Configure mailto
    lineinfile:
      dest: /etc/cron.d/crontab
      line: "MAILTO=root"
