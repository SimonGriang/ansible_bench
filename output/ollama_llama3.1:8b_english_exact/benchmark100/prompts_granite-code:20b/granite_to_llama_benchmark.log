  get_url:
    url: 'http://www.internic.net/domain/named.root'
    dest: '/etc/bind/named.root'
    state: present

- name: Create zone file
  template:
    src: 'templates/{{ item.zone }}.template'
    dest: '/var/named/{{ item.zone }}.zone'
    mode: '0644'
  with_items:
  - { zone: 'example.com' }
  - { zone: 'example.net' }

- name: Add zones to configuration
  template:
    src: 'templates/named.conf.template'
    dest: '/etc/bind/named.conf'
    mode: '0644'

- name: Place systemd override
  template:
    src: 'templates/bind.systemd-override.template'
    dest: '/etc/systemd/system/bind.service.d/override.conf'
    mode: '0644'

- name: Start and enable dns
  service:
    name: bind9
    state: started
    enabled: true


