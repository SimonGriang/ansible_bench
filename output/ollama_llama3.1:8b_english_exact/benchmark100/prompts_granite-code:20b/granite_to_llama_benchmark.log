---
- name: Ensure unzip package is available
  apt:
    name: unzip
    state: present

- name: Create promtail group
  group:
    name: promtail
    state: present

- name: Create the promtail user
  user:
    name: promtail
    group: promtail
    state: present

- name: Ensure /usr/local/bin exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    mode: '0755'

- name: Create application dirs
  file:
    path: /var/log/promtail
    state: directory
    mode: '0755'

- name: Check promtail binary
  stat:
    path: /usr/local/bin/promtail
    state: file

- name: Download promtail binaries
  get_url:
    url: 'https://example.com/promtail.tar.gz'
    dest: /tmp/promtail.tar.gz
    mode: '0644'

- name: Propagate locally distributed promtail archive
  copy:
    content: "{{ lookup('file', '/tmp/promtail.tar.gz') }}"
    dest: /tmp/promtail.tar.gz

- name: Download promtail binaries to controller node
  get_url:
    url: 'https://example.com/promtail.tar.gz'
    dest: /tmp/promtail.tar.gz
    mode: '0644'
    connection: local

- name: Propagate promtail binaries
  copy:
    content: "{{ lookup('file', '/tmp/promtail.tar.gz') }}"
    dest: /tmp/promtail.tar.gz

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail.tar.gz
    dest: /usr/local/bin
    compression: tar

- name: Create symlink to latest version
  file:
    path: /usr/local/bin/promtail
    state: link
    link_path: /usr/local/bin/promtail/latest

- name: Write config
  template:
    src: templates/promtail.yml.j2
    dest: /etc/promtail/promtail.yml
    mode: '0644'

- name: Create systemd service unit
  template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'

