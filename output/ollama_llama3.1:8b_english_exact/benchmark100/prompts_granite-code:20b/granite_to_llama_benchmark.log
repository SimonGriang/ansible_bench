      force: yes
      mode: '0644'
      owner: bind
      group: bind

  - name: Create zone file
    template:
      src: templates/zone.j2
      dest: /etc/bind/{{ item.zone }}.conf
      mode: '0644'
      owner: bind
      group: bind
    with_items: dns_zones

  - name: Add zones to configuration
    template:
      src: templates/named.conf.j2
      dest: /etc/bind/named.conf
      mode: '0644'
      owner: bind
      group: bind

  - name: Place systemd override
    template:
      src: templates/bind.service.j2
      dest: /etc/systemd/system/bind.service.d/override.conf
      mode: '0644'
      owner: root
      group: root

  - name: Start and enable dns
    service:
      name: bind9
      state: started
      enabled: yes


