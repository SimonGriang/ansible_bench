---
- name: Create etcd group
  group:
    name: etcd
    state: present

- name: Create etcd user
  user:
    name: etcd
    shell: /bin/nologin
    group: etcd
    append: true

- name: Copy systemctl config file for kernel hardening
  copy:
    src: /path/to/sysctl/config/file
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: '0600'
  notify:
    - restart systemd-sysctl

- name: Flush handlers
  meta: flush_handlers

