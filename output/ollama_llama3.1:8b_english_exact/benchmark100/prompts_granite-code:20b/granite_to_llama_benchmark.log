content='---\n\n\n- name: Import assert.yml\n  ansible.builtin.include_tasks: assert.yml\n\n- name: Ensure that logrotate is installed.\n  ansible.builtin.apt:\n    name: logrotate\n    state: present\n\n- name: Template /etc/logrotate.conf using the template.\n  ansible.builtin.template:\n    src: templates/logrotate.conf.j2\n    dest: /etc/logrotate.conf\n    mode: \'0644\'\n\n- name: Generate logrotate.d files\n  ansible.builtin.template:\n    src: templates/logrotate.d.j2\n    dest: /etc/logrotate.d/{{ item.name }}\n    mode: \'0644\'\n  loop:\n    items: "{{ logrotate_configs | list }}"\n    when: logrotate_configs is defined\n\n- name: Remove logrotate.d files\n  ansible.builtin.file:\n    path: /etc/logrotate.d/{{ item.name }}\n    state: absent\n  loop:\n    items: "{{ logrotate_configs | list }}"\n    when: logrotate_configs is defined\n\n- name: Start the logrotate service\n  ansible.builtin.service:\n    name: logrotate\n    state: started\n    enabled: true' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-23T01:25:38.01704414Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2605175593, 'load_duration': 106395793, 'prompt_eval_count': 1572, 'prompt_eval_duration': 390258139, 'eval_count': 243, 'eval_duration': 2107234256, 'model_name': 'llama3.1:8b'} id='run--9c993820-dfc7-4e88-8b15-c34789ef8d06-0' usage_metadata={'input_tokens': 1572, 'output_tokens': 243, 'total_tokens': 1815}
