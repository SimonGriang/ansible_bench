- name: Import assert.yml
  include: assert.yml

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop:
    - package1
    - package2

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: /etc/systemd/system/my_service.service
    mode: '0644'
  when: ansible_service_mgr == "systemd"

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: /etc/init.d/my_service
    mode: '0755'
  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]

- name: Manage service
  service:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    enabled: "{{ item.enabled }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers

