- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /path/to/python3.11-EXTERNALLY-MANAGED
  register: python3_11_file_exists

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  file:
    src: /path/to/python3.11-EXTERNALLY-MANAGED
    dest: /path/to/new_name
  when: python3_11_file_exists.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /path/to/python3.12-EXTERNALLY-MANAGED
  register: python3_12_file_exists

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  file:
    src: /path/to/python3.12-EXTERNALLY-MANAGED
    dest: /path/to/new_name
  when: python3_12_file_exists.stat.exists

- name: Import assert.yml
  include_yaml:
    file: /path/to/assert.yml

- name: Install python pip
  apt:
    name: python3-pip
    state: present

- name: Configure pip proxy
  pip:
    options: --proxy http://proxy.example.com:8080

- name: Trust hosts
  pip:
    options: --trusted-host host1.example.com
  with_items:
    - host1.example.com
    - host2.example.com

- name: Update pip.
  pip:
    name: pip
    state: latest

- name: Install requested modules
  pip:
    name: "{{ item }}"
    state: present
  loop:
    - module1
