      cmd: "awk -v user={{ user.name }} '/{{ user.name }}/{print $3}' /etc/shadow | cut -d: -f3"
      register: password_validity

  - name: Set users password valid time for {{ user.name }}
    command:
      cmd: "chage -d {{ user.password_validity }} {{ user.name }}"
      when: password_validity.stdout != "99999"

  - name: Place private key file for {{ user.name }}
    copy:
      content: "{{ lookup('file', '{{ users_ssh_key_directory }}/{{ user.name }}') }}"
      dest: "{{ user.home }}/.ssh/{{ user.name }}_private_key"
      mode: '0600'

