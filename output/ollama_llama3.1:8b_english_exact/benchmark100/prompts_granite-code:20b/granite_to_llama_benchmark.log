  - name: Import assert.yml
    include: assert.yml

  - name: Install prerequisites
    apt:
      name: "{{ item }}"
      state: present
    loop:
      - apt-transport-https
      - ca-certificates
      - curl
      - gnupg2
      - software-properties-common

  - name: Include installation method specific tasks
    include_tasks: "{{ vault_type }}.yml"

  - name: Add Vault environment variables
    shell: |
      echo "VAULT_ADDR='{{ vault_addr }}'" >> /etc/environment
      echo "VAULT_SKIP_SECRETS MANAGEMENT='true'" >> /etc/environment

  - name: Include hardening tasks
    include_tasks: hardening.yml

  - name: Start and enable vault when vault_type is "oss"
    when: vault_type == "oss"
    service:
      name: vault
      state: started
      enabled: true

  - name: Enable vault when vault_type is not "oss"
    when: vault_type != "oss"
    service:
      name: vault
      state: enabled  8%|▊         | 8/100 [04:22<45:45, 29.84s/it]

