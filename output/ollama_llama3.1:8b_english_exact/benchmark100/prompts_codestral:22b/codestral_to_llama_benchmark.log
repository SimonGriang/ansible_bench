---
- name: Upgrade RKE2 services
  become: true
  tasks:
  - name: Cordon and Drain the node
    kubectl:
      cmd: cordon
      state: present
    when: rke2_drain_node_during_upgrade
  - name: Cordon and Drain the node
    kubectl:
      cmd: drain
      state: present
    when: rke2_drain_node_during_upgrade

  - name: Restart RKE2 service
    service:
      name: "{{ rke2_service_name }}"
      state: restarted

  - name: Wait for all nodes to be ready again
    kubectl:
      cmd: get nodes --field-selector status.phase=Ready -o json | jq '.items | length'
      register: ready_nodes
    retry: 60
    retries: "{{ (rke2_servers_group_name | length) - 1 }}"
    until: ready_nodes.rc == rke2_servers_group_name | length
    when: rke2_drain_node_during_upgrade

  - name: Uncordon the node
    kubectl:
      cmd: uncordon
      state: present
    when: rke2_drain_node_during_upgrade

  - name: Wait for all pods to be ready again
    kubectl:
      cmd: get pods --field-selector status.phase=Running,Succeeded -o json | jq '.items | length'
      register: ready_pods
    retry: 60
    retries: "{{ (rke2_servers_group_name | length) - 1 }}"
    until: ready_pods.rc == rke2_servers_group_name | length
    when: rke2_wait_for_all_pods_to_be_ready

  - name: Wait for all pods to pass readiness checks
    kubectl:
      cmd: wait --timeout 300s --for condition=Ready {{ rke2_wait_for_all_pods_to_be_healthy_args }}
    when: rke2_wait_for_all_pods_to_be_healthy


