- name: RKE2 manifests directory
  become: true
  ansible.builtin.file:
    path: '{{ rke2_data_path }}/server/manifests'
    state: directory
    owner: root
    group: root
    mode: '0700'

- name: Copy kube-vip files to first server
  become: true
  ansible.builtin.copy:
    src: 'templates/kube-vip/kube-vip.yml.j2'
    dest: '{{ rke2_data_path }}/server/manifests/kube-vip.yml'
    owner: root
    group: root
    mode: '0644'
  delegate_to: first_server

- name: Copy kube-vip files to first server
  become: true
  ansible.builtin.copy:
    src: 'templates/kube-vip/kube-vip-rbac.yml.j2'
    dest: '{{ rke2_data_path }}/server/manifests/kube-vip-rbac.yml'
    owner: root
    group: root
    mode: '0644'
  delegate_to: first_server

- name: Copy kube-vip load balancer manifests to first server
  become: true
  ansible.builtin.copy:
    src: 'templates/kube-vip/kube-vip-cloud-{{ item }}'
    dest: '{{ rke2_data_path }}/server/manifests/kube-vip-cloud-{{ item }}'
    owner: root
    group: root
    mode: '0644'
  delegate_to: first_server
  when: rke2_kubevip_cloud_provider_enable
  with_fileglob:
    - 'templates/kube-vip/kube-vip-cloud-*.j2'

