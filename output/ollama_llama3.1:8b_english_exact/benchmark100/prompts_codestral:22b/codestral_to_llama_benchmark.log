content='---\n\n- name: Install epel\n  when: (ansible_distribution == \'Amazon\' and ansible_distribution_major_version == \'2\') or (ansible_distribution in [\'RedHat\', \'CentOS\'] and ansible_distribution_major_version in [\'7\', \'8\', \'9\', \'10\'])\n  yum:\n    name: epel-release\n    state: present\n\n- name: Install epel gpg key\n  rpm_key:\n    state: present\n    key: "{{ epel_gpg_key }}"\n\n- name: Install epel-release\n  yum_repository:\n    name: epel\n    description: EPEL repo\n    enabled: yes\n    gpgcheck: yes\n    gpgkey: "{{ epel_url }}"\n  when: ansible_distribution in [\'RedHat\', \'CentOS\'] and ansible_distribution_major_version in [\'7\', \'8\', \'9\', \'10\']\n  notify: Update package cache\n\n- name: Install epel-next-release\n  when: epel_next\n  yum_repository:\n    name: epel-next\n    description: EPEL next repo\n    enabled: yes\n    gpgcheck: yes\n    gpgkey: "{{ epel_next_url }}"\n  notify: Update package cache' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-16T01:44:09.063515602Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2246593992, 'load_duration': 108116136, 'prompt_eval_count': 470, 'prompt_eval_duration': 24754373, 'eval_count': 256, 'eval_duration': 2112642124, 'model_name': 'llama3.1:8b'} id='run--d2fdebf6-e6f2-4828-8adb-e405a3df955c-0' usage_metadata={'input_tokens': 470, 'output_tokens': 256, 'total_tokens': 726}
