---

- name: Set Package State
  set_fact:
    ansible_package_state: "present" if ansible_distribution in ['RedHat', 'CentOS', 'Fedora', 'Ubuntu', 'Debian'] and ansible_package_manager == "yum" else "absent"

- name: Set Up Ansible on RedHat
  when: ansible_distribution in ['RedHat', 'CentOS'] and ansible_package_manager == "yum"
  include_tasks: setup-RedHat.yml

- name: Set Up Ansible on Fedora
  when: ansible_distribution == "Fedora" and ansible_package_manager == "dnf"
  include_tasks: setup-Fedora.yml

- name: Set Up Ansible on Ubuntu
  when: ansible_distribution == "Ubuntu" and ansible_package_manager == "apt"
  include_tasks: setup-Ubuntu.yml

- name: Set Up Ansible on Debian
  when: ansible_distribution == "Debian" and ansible_package_manager == "apt"
  include_tasks: setup-Debian.yml

- name: Set Up Ansible using Pip
  when: ansible_distribution not in ['RedHat', 'CentOS', 'Fedora', 'Ubuntu', 'Debian'] or ansible_package_manager != "yum"
  include_tasks: setup-pip.yml

