---
- name: Vault Hardening Tasks
  hosts: 
  gather_facts: true

  tasks:
  - name: Disable swap
    block:
      - name: Disable swap
        shell: swapoff -a
        when: vault_hardening_disable_swap == true
      - name: Remove swap entry from fstab
        mount:
          name: "{{ item }}"
          state: absent
        with_items:
          - "{{ item }}"
        when: vault_hardening_disable_swap == true

  - name: Disable core dumps
    block:
      - name: Set limits and domains to prevent core dumps
        pam_limits:
          name: "{{ item.0 }}"
          domain: "{{ item.1 }}"
          limit_name: core
          limit_value: 0
        with_nested:
          - [ 'hard', 'soft' ]
          - [ 'login', 'user', 'root' ]
        when: vault_hardening_disable_core_dumps == true

  - name: Disable Shell Command History
    block:
      - name: Copy script to /etc/profile.d/
        copy:
          content: "export HISTIGNORE='vault.*'"
          dest: "/etc/profile.d/vault_hardening.sh"
          mode: '0755'
        when: vault_hardening_disable_shell_command_history == true

  - name: Configure SELinux / AppArmor
    block:
      - name: Install and configure SELinux
        block:
          - name: Check if SELinux is enabled
            shell: sestatus | grep "SELinux status"
            register: selinux_status
          - name: Install selinux-policy package
            yum:
              name: selinux-policy
              state: present
            when: selinux_status.stdout != ""
          - name: Set SELinux policy to targeted and enforcing
            selinux:
              policy: targeted
              state: enforcing
            when: selinux_status.stdout != ""
        when: vault_hardening_configure_selinux_apparmor == true
      - name: Install and configure AppArmor
        block:
          - name: Check if AppArmor is enabled
            shell: aa-status | grep "AppArmor enabled"
            register: apparmor_status
          - name: Enable AppArmor profile for vault binary
            apparmor:
              profile: /usr/bin/vault
              state: present
            when: apparmor_status.stdout != ""
        when: vault_hardening_configure_selinux_apparmor == true

