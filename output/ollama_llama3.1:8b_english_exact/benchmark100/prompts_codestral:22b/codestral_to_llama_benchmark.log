content='```yml\n---\n# Create the RKE2 config directory\n- name: Create the RKE2 config directory\n  file:\n    path: /etc/rancher/rke2\n    state: directory\n    owner: root\n    group: root\n    mode: \'0755\'\n\n# Set server taints\n- name: Set server taints\n  set_fact:\n    combined_node_taints: "{{ rke2_server_node_taints }}"\n  when: rke2_type == \'server\'\n\n# Copy rke2 config\n- name: Copy rke2 config\n  template:\n    src: "{{ rke2_config }}"\n    dest: /etc/rancher/rke2/config.yaml\n    owner: root\n    group: root\n    mode: \'0600\'\n  notify:\n    - Config file changed\n\n# Copy kubelet config\n- name: Copy kubelet config\n  template:\n    src: templates/kubelet-config.yaml.j2\n    dest: /etc/rancher/rke2/kubelet-config.yaml\n    owner: root\n    group: root\n    mode: \'0600\'\n  when: rke2_kubelet_config is not empty\n  notify:\n    - Config file changed\n\n# Copy Containerd Registry Configuration file\n- name: Copy Containerd Registry Configuration file\n  template:\n    src: "{{ rke2_custom_registry_path }}"\n    dest: /etc/rancher/rke2/registries.yaml\n    owner: root\n    group: root\n    mode: \'0600\'\n  when: (rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty)\n  notify:\n    - Config file changed\n\n# Register if we need to do a etcd restore from file\n- name: Register if we need to do a etcd restore from file\n  set_fact:\n    do_etcd_restore: true\n  when: (rke2_etcd_snapshot_file is not empty and\n         (rke2_server_service.state == \'stopped\' or rke2_server_service.enabled is not True))\n\n# Register if we need to do a etcd restore from s3\n- name: Register if we need to do a etcd restore from s3\n  set_fact:\n    do_etcd_restore_from_s3: true\n  when: (rke2_etcd_snapshot_file is not empty and\n         (rke2_etcd_snapshot_s3_options.access_key is defined and\n          rke2_etcd_snapshot_s3_options.secret_key is defined and\n          rke2_etcd_snapshot_s3_options.bucket is defined and\n          rke2_etcd_snapshot_s3_options.snapshot_name is defined))\n\n# Restore etcd from file\n- block:\n  - name: Create directory for etcd snapshot\n    file:\n      path: /etc/rancher/rke2/etcd-snapshot\n      state: directory\n      owner: root\n      group: root\n      mode: \'0755\'\n  - name: Copy etcd snapshot file\n    copy:\n      content: "{{ rke2_etcd_snapshot_file }}"\n      dest: /etc/rancher/rke2/etcd-snapshot/snapshot.etcd\n      owner: root\n      group: root\n      mode: \'0600\'\n  - name: Restore etcd from snapshot\n    shell:\n      cmd: "{{ \'rke2 server restore --etcd-snapshot /etc/rancher/rke2/etcd-snapshot/snapshot.etcd\' }}"\n      register: rke2_server_restore\n    when: do_etcd_restore\n  when: do_etcd_restore\n\n# Restore etcd from s3\n- block:\n  - name: Restore etcd from s3\n    shell:\n      cmd: "{{ \'rke2 server restore --etcd-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }}\'\n               + \' --etcd-s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }}\'\n               + \' --etcd-s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }}\'\n               + \' --etcd-s3-snapshot-name {{ rke2_etcd_snapshot_s3_options.snapshot_name }}\' }}"\n      register: rke2_server_restore\n    when: do_etcd_restore_from_s3\n  when: do_etcd_restore_from_s3\n\n# Start RKE2 service on the first server\n- name: Start RKE2 service on the first server\n  service:\n    name: rke2-server.service\n    state: started\n    enabled: yes\n  when: rke2_token is defined\n  notify:\n    - Service (re)started\n\n# Mask RKE2 agent service on the first server\n- name: Mask RKE2 agent service on the first server\n  service:\n    name: rke2-agent.service\n    state: masked\n\n# Wait for the first server to be ready - no CNI\n- name: Wait for the first server to be ready - no CNI\n  kubectl:\n    cmd: get node\n    api_endpoint: https://{{ inventory_hostname }}\n    wait: yes\n  when: rke2_cni == \'none\'\n\n# Wait for the first server to be ready - with 