---
- name: RKE2 Playbook
  hosts: localhost
  become: true

  tasks:
  - name: Download RKE2 installation script
    get_url:
      url: "{{ rke2_installation_script_url }}"
      dest: "{{ rke2_installation_script_dest }}"
      mode: '0644'
    when: rke2_airgap_mode == 'false'

  - name: Copy local RKE2 installation script
    copy:
      content: "{{ lookup('file', rke2_installation_script_local_src) | b64decode }}"
      dest: "{{ rke2_installation_script_local_dest }}"
      mode: '0644'
    when: rke2_airgap_mode == 'true' and rke2_airgap_implementation == 'copy'

  - name: Create RKE2 artifacts folder
    file:
      path: "{{ rke2_artifacts_folder }}"
      state: directory
      mode: '0755'
    when: rke2_airgap_mode == 'true' and rke2_airgap_implementation != 'exists'

  - name: Download RKE2 checksum and artifacts
    get_url:
      url: "{{ rke2_checksum_url }}"
      dest: "{{ rke2_artifacts_folder }}"
      mode: '0644'
    when: rke2_airgap_mode == 'true' and rke2_airgap_implementation == 'download'
    notify:
      - download_checksum_and_artifacts

  - name: Copy local RKE2 artifacts
    copy:
      src: "{{ rke2_artifacts_folder }}/*"
      dest: "{{ rke2_artifacts_folder }}"
      mode: '0644'
    when: rke2_airgap_mode == 'true' and rke2_airgap_implementation == 'copy'

  - name: Copy additional images tarballs
    file:
      path: "{{ rke2_additional_images_tarballs_folder }}"
      state: directory
      mode: '0755'
    when: rke2_airgap_mode == 'true' and rke2_additional_images_tarballs_to_copy and rke2_airgap_implementation != 'exists'
    notify:
      - copy_additional_images_tarballs

  - name: Ensure artifacts exist and have acceptable permissions
    file:
      path: "{{ rke2_artifacts_folder }}/*"
      state: file
      mode: '0444'
    when: rke2_airgap_mode == 'true' and rke2_airgap_implementation == 'exists'
    notify:
      - ensure_artifacts_permissions

  - name: Set RKE2 bin path
    set_fact:
      rke2_bin_path: "{{ rke2_bin_path | default('/usr/local/bin/rke2') }}"
    notify:
      - set_rke2_bin_path

  - name: Check RKE2 version
    shell:
      cmd: "{{ rke2_bin_path }} --version"
      register: rke2_binary_output
    when: rke2_bin_path is defined
    notify:
      - check_rke2_version

  - name: Prevent accidental RKE2 downgrade
    fail:
      msg: "Downgrade not allowed."
    when: rke2_version < rke2_desired_version and rke2_downgrade_allowed == 'false'

  - name: Run RKE2 install script
    shell:
      cmd: "{{ rke2_installation_script_dest }} {{ rke2_airgap_variables | default('') }}"
      creates: "{{ rke2_bin_path }}"
    when: rke2_version not in [rke2_desired_version, 'not installed']

  - name: Copy Custom Manifests
    copy:
      src: "{{ rke2_custom_manifests_src }}/*"
      dest: "{{ rke2_custom_manifests_dest }}"
      mode: '0644'
    when: rke2_custom_manifests_to_copy

  - name: Copy Static Pods
    copy:
      src: "{{ rke2_static_pods_src }}/*"
      dest: "{{ rke2_static_pods_dest }}"
      mode: '0644'
    when: rke2_static_pods_to_copy

  - name: Copy RKE2 environment file
    copy:
      src: "{{ rke2_environment_file_src }}"
      dest: "{{ rke2_environment_file_dest }}"
      mode: '0644'
    when: rke2_environment_options_to_set

