---
- name: Tasks
  vars:
    ha_mode: 'Keepalived'
  tasks:
  - name: Install Keepalived
    include: keepalived.yml
  - name: Install RKE2
    get_url:
      url: 'https://github.com/rke2/rke2/releases/download/{{ rke2_version }}/rke2-{{ rke2_version }}-linux-amd64'
      dest: '/usr/local/bin/rke2'
      mode: '0755'
  - name: Apply CIS Hardening
    include: cis.yml
    when: cis_profile is defined
  - name: Identify Active Server
    include: find_active_server.yml
  - name: Enable IPVS Kernel Module
    modprobe:
      name: 'ip_vs'
    when:
      - ipvs_load_balancing is defined
      - inventory_hostname in groups['rke2_servers']
      - ha_mode != 'Keepalived'
  - name: Copy Kube-vip Manifests
    copy:
      content: "{{ lookup('template', 'kube-vip.yaml.j2') }}"
      dest: '/etc/kubernetes/manifests/kube-vip.yaml'
      mode: '0644'
    when:
      - inventory_hostname in groups['rke2_servers']
      - inventory_hostname == groups['rke2_servers'][0]
      - ha_mode == 'Kubevip'
  - name: Copy Ingress-nginx Manifests
    copy:
      content: "{{ lookup('template', 'ingress-nginx.yaml.j2') }}"
      dest: '/etc/kubernetes/manifests/ingress-nginx.yaml'
      mode: '0644'
    when:
      - inventory_hostname in groups['rke2_servers']
      - inventory_hostname == groups['rke2_servers'][0]
      - ingress_nginx_values is defined
  - name: Prepare First Server Node
    include: first_server_prepare.yml
    when:
      - inventory_hostname in groups['rke2_servers']
      - inventory_hostname == groups['rke2_servers'][0]
      - (active_server is not defined or (active_server is defined and inventory_hostname == groups['rke2_servers'][0]))
  - name: Restore etcd
    include: first_server_restore.yml
    when:
      - active_server is defined
      - (inventory_hostname == active_server or inventory_hostname == groups['rke2_servers'][0])
      - etcd_restore is defined
  - name: Download kubeconfig
    fetch:
      url: 'https://{{ inventory_hostname }}:8443/api/v1/config'
      dest: '/etc/kubernetes/admin.conf'
      flat: yes
    when:
      - inventory_hostname in groups['rke2_servers']
      - inventory_hostname == groups['rke2_servers'][0]
      - kubeconfig_download is defined
  - name: Prepare and Join Remaining Nodes
    include: remaining_nodes_join.yml
    when:
      - active_server is defined
      - inventory_hostname in groups['rke2_servers']
      - inventory_hostname != active_server
  - name: Rolling Restart Servers
    include: rolling_restart.yml
    when:
      - rke2_version != rke2_running_version
      - inventory_hostname in groups['rke2_servers']
  - name: Rolling Restart Agents
    include: rolling_restart.yml
    when:
      - rke2_version != rke2_running_version
      - inventory_hostname not in groups['rke2_servers']
  - name: Flush Handlers
    meta: flush_handlers
  - name: Rolling Restart Config Change
    include: change_config.yml
    when:
      - restart_needed is defined
  - name: Final Steps
    include: final_steps.yml

