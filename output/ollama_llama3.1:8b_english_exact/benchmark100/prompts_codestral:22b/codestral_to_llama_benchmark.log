content="---\n\n\n- name: Import assert.yml\n  import_tasks: assert.yml\n\n- name: Install dns\n  apt:\n    name: dnsutils\n    state: present\n\n- name: Create directories\n  file:\n    path: /etc/bind\n    state: directory\n    mode: '0755'\n    owner: bind\n    group: bind\n  when: not caching_dns\n  notify: restart bind\n\n- name: Create directories\n  file:\n    path: /var/cache/bind\n    state: directory\n    mode: '0755'\n    owner: bind\n    group: bind\n  when: not caching_dns\n  notify: restart bind\n\n- name: Create group\n  group:\n    name: bind\n    state: present\n\n- name: Create user\n  user:\n    name: bind\n    group: bind\n    append: false\n    system: yes\n\n- name: Generate rndc key\n  command:\n    cmd: rndc-confgen -a /etc/bind/rndc.key\n    creates: /etc/bind/rndc.key\n\n- name: Set permissions on rndc key file\n  file:\n    path: /etc/bind/rndc.key\n    state: file\n    mode: '0600'\n    owner: bind\n    group: bind\n\n- name: Get the hints/root file\n  get_url:\n    url: http://ftp.internic.net/domain/named.root\n    dest: /var/cache/bind/named.root\n    mode: '0644'\n    force: true\n  when: caching_dns\n\n- name: Create zone file\n  template:\n    src: templates/zone.j2\n    dest: /var/cache/bind/{{ item.zone }}.zone\n    mode: '0644'\n    owner: bind\n    group: bind\n  when: item.zone_type == 'primary' and item.zone is not undefined\n  loop:\n    items: dns_zones\n\n- name: Add zones to configuration\n  template:\n    src: templates/named.conf.j2\n    dest: /etc/bind/named.conf.local\n    mode: '0644'\n    owner: bind\n    group: bind\n  notify: restart bind\n\n- name: Place systemd override\n  template:\n    src: templates/bind.service.j2\n    dest: /etc/systemd/system/bind.service.d/override.conf\n    mode: '0644'\n    owner: root\n    group: root\n  when: systemd\n  notify: restart bind\n\n- name: Start and enable dns\n  service:\n    name: bind\n    state: started\n    enabled: yes" additional_kwargs={} response_metadata={'model':