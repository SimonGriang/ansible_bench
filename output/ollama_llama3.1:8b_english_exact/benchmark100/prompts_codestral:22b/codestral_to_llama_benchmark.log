---
- name: Apache HTTP Server Configuration
  hosts: localhost
  tasks:
  - name: Import assert.yml
    include: assert.yml

  - name: Install apache httpd
    package:
      name: "{{ httpd_packages }}"
      state: present

  - name: Configure selinux
    seboolean:
      name: "{{ item }}"
      state: "{{ item in httpd_sebooleans | string }}"
    with_items: "{{ httpd_sebooleans | list }}"
    when: selinux_enabled

  - name: Configure httpd
    template:
      src: "{{ httpd_config_src }}"
      dest: "{{ httpd_config_dest }}"
      mode: '0644'
    notify:
      - test httpd configuration
      - restart httpd

  - name: Activate httpd module | Debian
    command:
      name: "{{ item }}"
      args: "/usr/sbin/a2enmod {{ item }}"
    with_items: "{{ httpd_modules_to_activate_with_command | list }}"
    when: ansible_distribution == "Debian"

  - name: Import ssl.yml
    include: ssl.yml
    when: httpd_ssl

  - name: Import locations.yml
    include: locations.yml
    when: httpd_locations

  - name: Import vhosts.yml
    include: vhosts.yml
    when: httpd_vhosts

  - name: Configure ports
    template:
      src: "{{ httpd_ports_conf }}"
      dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
      mode: '0644'
    notify:
      - test httpd configuration
      - restart httpd
    when:
      - ansible_distribution == "Debian" or ansible_distribution == "SUSE"

  - name: Import directories.yml
    include: directories.yml
    when: httpd_directories

  - name: Flush handlers
    meta:
      hostkeys: true
    notify: handlers

  - name: Removing default html
    file:
      path: "{{ httpd_data_directory }}/index.html"
      state: absent
    when: httpd_remove_example

  - name: Start and enable httpd
    service:
      name: "{{ httpd_service }}"
      state: started
      enabled: true


