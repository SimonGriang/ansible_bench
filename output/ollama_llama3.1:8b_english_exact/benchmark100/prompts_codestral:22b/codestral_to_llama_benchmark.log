    changed_when: bootstrap_packages_result.rc != 0

- name: Ensure System Prepared
  block:
  - name: Gather Ansible Facts
    setup: "{{ ansible_facts }}"
  - name: Install Bootstrap Packages
    package:
      name: "{{ bootstrap_packages | default([]) | join(' ') }}"
