- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure Debian systems
  debconf:
    name: 'postfix/main_mailer_type'
    value: 'no configuration'
    state: present
  when: ansible_distribution == 'Debian'

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: ('postfix_database' in group_vars and postfix_database == 'mysql') or ('postfix_database' in hostvars and hostvars[ansible_hostname]['postfix_database'] == 'mysql')

- name: Configure postfix (transport_maps)
  template:
    src: postfix_transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: '0644'
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: postfix_header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf
  set_fact:
    postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default('reject_non_fqdn_recipient') }}"
    postfix_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default('reject_non_fqdn_sender') }}"

- name: Configure postfix (main.cf)
  template:
    src: postfix_main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - postconf -d -c {{ postfix_config_path }}
  when: postfix_main_cf_template is defined

- name: Configure postfix (master.cf)
  template:
    src: postfix_master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - postconf -d -c {{ postfix_config_path }}
  when: postfix_master_cf_template is defined

- name: Create cert/key directory
  file:
    path: "{{ postfix_config_path }}/cert"
    state: directory
  when: ('postfix_smtpd_tls_cert_file_source' in group_vars and postfix_smtpd_tls_cert_file_source) or ('postfix_smtpd_tls_cert_file_source' in hostvars and hostvars[ansible_hostname]['postfix_smtpd_tls_cert_file_source'])

- name: Deploy Postfix TLS server certificate
  copy:
    content: "{{ postfix_smtpd_tls_cert }}"
    dest: "{{ postfix_config_path }}/cert/{{ item }}"
    mode: '0644'
  with_items:
    - server.crt
  when: ('postfix_smtpd_tls_cert_file_source' in group_vars and postfix_smtpd_tls_cert_file_source) or ('postfix_smtpd_tls_cert_file_source' in hostvars and hostvars[ansible_hostname]['postfix_smtpd_tls_cert_file_source'])

- name: Deploy Postfix TLS server key
  copy:
    content: "{{ postfix_smtpd_tls_key }}"
    dest: "{{ postfix_config_path }}/cert/{{ item }}"
    mode: '0644'
  with_items:
    - server.key
  when: ('postfix_smtpd_tls_key_file_source' in group_vars and postfix_smtpd_tls_key_file_source) or ('postfix_smtpd_tls_key_file_source' in hostvars and hostvars[ansible_hostname]['postfix_smtpd_tls_key_file_source'])

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: postfix_aliases.j2
    dest: /etc/aliases
    mode: '0644'
  when: postfix_aliases is defined

- name: Configure sender_access
  template:
    src: postfix_sender_access.j2
    dest: /etc/postfix/sender_access
    mode: '0644'
  when: postfix_sender_access is defined

- name: Configure recipient_access
  template:
    src: postfix_recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: '0644'
  when: postfix_recipient_access is defined

- name: Place sasl_password_map
  template:
    src: postfix_sasl_password_map.j2
    dest: /etc/postfix/sasl_password_map
    mode: '0644'
  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map != ''

- name: Flush handlers (again)
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes


