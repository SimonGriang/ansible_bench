---

- name: Configure HashiCorp Products
  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install using package
    when: hashicorp_installation_method == "package"
    block:
      - name: Set up HashiCorp repositories for RedHat/Rocky
        when: ansible_distribution in ['RedHat', 'Rocky']
        apt_repository:
          repo: 'https://apt.hashicorp.com/ansible/rocky'
          state: present

      - name: Set up HashiCorp repositories for Debian
        when: ansible_distribution == 'Debian'
        apt_repository:
          repo: 'https://apt.hashicorp.com/ansible/debian'
          state: present

      - name: Install required packages
        apt:
          name: "{{ item }}"
          state: present
        with_items:
          - apt-transport-https
          - ca-certificates
          - curl
          - gnupg2
          - lsb-release

      - name: Install HashiCorp products
        apt:
          name: "{{ item }}"
          state: present
        with_items:
          - consul=consul-1.10.3
          - nomad=nomad-1.3.3

  - name: Install manually
    when: hashicorp_installation_method == "manual"
    block:
      - name: Download HashiCorp archive
        get_url:
          url: "https://releases.hashicorp.com/{{ item }}/{{ version }}/hashicorp-{{ item }}_{{ version }}_linux_amd64.zip"
          dest: "/tmp/hashicorp-{{ item }}_{{ version }}.zip"
          force: yes
        with_items:
          - consul
          - nomad

      - name: Extract HashiCorp archive
        unarchive:
          src: "/tmp/hashicorp-{{ item }}_{{ version }}.zip"
          dest: /usr/local/bin
          compression: 'zip'
        with_items:
          - consul
          - nomad

      - name: Set correct file permissions for HashiCorp binaries
        file:
          path: "/usr/local/bin/{{ item }}"
          mode: '0755'
        with_items:
          - consul
          - nomad

      - name: Update hashicorp version
        lineinfile:
          dest: "/usr/local/bin/{{ item }}"
          state: present
          line: "{{ item }} --version {{ version }}"
