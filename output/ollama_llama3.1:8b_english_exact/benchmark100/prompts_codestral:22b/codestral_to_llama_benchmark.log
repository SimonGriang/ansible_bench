---
- name: OpenSSL tasks
  hosts: localhost
  become: yes

  tasks:
  - name: Import assert.yml
    include: assert.yml

  - name: Install requirements
    apt:
      name: "{{ openssl_requirements }}"
      state: present

  - name: Install pip packages
    pip:
      name: "{{ openssl_pip_packages }}"
      state: present

  - name: Create key directory
    file:
      path: /path/to/keys
      state: directory
      mode: '700'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"

  - name: Create csr directory
    file:
      path: /path/to/csr
      state: directory
      mode: '755'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"

  - name: Create crt directory
    file:
      path: /path/to/crt
      state: directory
      mode: '755'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"

  - name: Include create.yml
    include: create.yml
    loop: "{{ openssl_items }}"
    loop_control:
      label: "{{ item }}"


