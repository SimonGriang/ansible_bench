---
- name: Configure GRUB settings
  hosts: []

  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install required packages
    apt:
      name: "{{ item }}"
      state: present
    loop: "{{ grub_packages }}"

  - name: Set GRUB_TIMEOUT
    lineinfile:
      dest: /etc/default/grub
      regexp: '^GRUB_TIMEOUT='
      line: 'GRUB_TIMEOUT={{ grub_timeout }}'
    notify: Update grub

  - name: Set GRUB_RECORDFAIL_TIMEOUT
    lineinfile:
      dest: /etc/default/grub
      regexp: '^GRUB_RECORDFAIL_TIMEOUT='
      line: 'GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}'
    notify: Update grub

  - name: Add options to GRUB_CMDLINE_LINUX
    lineinfile:
      dest: /etc/default/grub
      regexp: '^GRUB_CMDLINE_LINUX=".*"'
      line: "GRUB_CMDLINE_LINUX=\"{{ grub_options | default('', true) }}\""
    when: grub_options is not undefined and grub_options != ''
    notify: Update grub

  - name: Import password.yml
    import_tasks: password.yml
    when: grub_set_password

  - name: Flush handlers
    meta: flush_handlers


