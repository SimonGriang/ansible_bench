---
- name: Configure cron
  hosts: localhost
  tasks:
  - name: Import assert.yml
    include: assert.yml

  - name: Install cron
    package:
      name: "{{ cron_packages }}"
      state: present

  - name: Configure shell
    lineinfile:
      dest: "{{ cron_configuration }}"
      line: "SHELL={{ cron_shell }}"
      state: present
    notify:
      - Restart cron

  - name: Configure path
    lineinfile:
      dest: "{{ cron_configuration }}"
      line: "PATH={{ cron_path }}"
      state: present
    notify:
      - Restart cron

  - name: Configure mailto
    lineinfile:
      dest: "{{ cron_configuration }}"
      line: "MAILTO={{ cron_mailto }}"
      state: present
    notify:
      - Restart cron

  - name: Start and enable cron
    service:
      name: "{{ cron_service }}"
      enabled: true
      state: started
    when: "'cron_service' in groups['localhost']"

  - name: Schedule requested cron jobs
    cron:
      name: "{{ item.name }}"
      job: "{{ item.job }}"
      minute: "{{ item.minute | default(omit) }}"
      hour: "{{ item.hour | default(omit) }}"
      day: "{{ item.day | default(omit) }}"
      month: "{{ item.month | default(omit) }}"
      weekday: "{{ item.weekday | default(omit) }}"
      special_time: "{{ item.special_time | default(omit) }}"
      user: "{{ item.user | default(omit, true) | default(uname -u) }}"
      state: "{{ item.state | default('present') }}"
    loop: "{{ cron_jobs }}"
    when: "'cron_jobs' in groups['localhost']"  

    # added an extra newline at the end of the file

