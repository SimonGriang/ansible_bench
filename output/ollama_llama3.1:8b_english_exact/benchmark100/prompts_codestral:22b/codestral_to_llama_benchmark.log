- name: Create ssl key
  become: yes
  openssl_privatekey:
    path: /path/to/ssl/key
    state: present
    mode: '0644'
    group: ssl_group
    user: ssl_user

- name: Create ssl csr
  become: yes
  openssl_csr:
    csr_path: /path/to/ssl/csr
    csr_privkey_path: /path/to/ssl/key
    state: present
    mode: '0644'
    group: ssl_group
    user: ssl_user

- name: Create ssl certificates
  become: yes
  x509_certificate:
    cert_path: /path/to/ssl/cert
    csr_path: /path/to/ssl/csr
    privatekey_path: /path/to/ssl/key
    state: present
    mode: '0644'
    group: ssl_group
    user: ssl_user

- name: Create PKCS#12 file
  become: yes
  openssl_pkcs12:
    pfx_path: /path/to/pkcs12
    cert_path: /path/to/ssl/cert
    privatekey_path: /path/to/ssl/key
    csr_path: /path/to/ssl/csr
    state: present
    mode: '0644'
    group: ssl_group
    user: ssl_user

- name: Read private key
  slurp:
    src: /path/to/ssl/key
    dest: ssl_private_key

- name: Read certificate
  slurp:
    src: /path/to/ssl/cert
    dest: ssl_certificate

- name: Create combined private_key and certificate file
  become: yes
  file:
    path: /path/to/combined
    mode: '0644'
    group: ssl_group
    user: ssl_user
    contents: |
      {{ ssl_private_key }}{{ ssl_certificate }}


