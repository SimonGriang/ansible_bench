--- 

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    dest: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    state: present
    create: yes
    mode: '0640'
  notify: Restart cron

- name: Configure path
  lineinfile:
    dest: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    state: present
    create: yes
    mode: '0640'
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    dest: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    state: present
    create: yes
    mode: '0640'
  notify: Restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ''

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default('') }}"
    hour: "{{ item.hour | default('') }}"
    day: "{{ item.day | default('') }}"
    month: "{{ item.month | default('') }}"
    weekday: "{{ item.weekday | default('') }}"
    special_time: "{{ item.special_time | default('') }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default('present') }}"
    user: "{{ item.user }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined

