--- 

- name: Assert role variables
  import_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if user exists
  user:
    name: "{{ git_username }}"
    state: absent
  register: user_exists

- name: Create user's home directory
  file:
    path: "/home/{{ git_username }}"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'
  when: user_exists.changed

- name: Configure git
  template:
    src: templates/gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    mode: '0644'
  when: user_exists.changed

- name: Create repository destination
  file:
    path: "{{ git_repository_destination }}"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'
  when: user_exists.changed and git_repository_destination is defined

- name: Clone repositories
  git:
    repo: "{{ git_repositories }}"
    dest: "{{ git_repository_destination }}"
    version: master
    clone: yes
    update: yes
  when: user_exists.changed and git_repositories is defined and git_repository_destination is defined

