tasks/main.yml:

  - name: Enable modules in Apache
    ansible.builtin.module_name: 'apache2'
    args:
      name: 'proxy'
      state: 'present'
    when: ansible_distribution == 'Debian' or ansible_distribution == 'Suse'

  - name: Enable modules in Apache
