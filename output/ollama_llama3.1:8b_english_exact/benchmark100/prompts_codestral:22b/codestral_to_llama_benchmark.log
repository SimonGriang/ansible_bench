---
- name: Restore etcd - get all nodes
  kubectl:
    cmd: get nodes -o jsonpath='{.items[*].metadata.name}'
  register: node_names

- name: Restore etcd - remove old nodes
  kubectl:
    cmd: delete node {{ item }}
  loop: "{{ node_names.stdout }}"
  when: item not in groups[rke2_cluster_group_name]


