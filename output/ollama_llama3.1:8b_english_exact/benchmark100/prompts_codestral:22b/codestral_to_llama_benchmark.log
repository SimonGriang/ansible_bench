---

- name: Vault configuration and setup
  hosts: localhost
  become: yes

  tasks:
  - name: Import assert.yml
    include: assert.yml

  - name: Install prerequisites
    apt:
      name: "{{ item }}"
      state: present
    loop: "{{ vault_prerequisites }}"

  - name: Include installation method specific tasks
    include_tasks: "{{ vault_installation_method }}.yml"

  - name: Add Vault environment variables
    lineinfile:
      dest: /etc/vault.d/vault.env
      line: "{{ item }}"
      state: present
      notify: restart-vault
    loop: "{{ vault_environment_settings }}"
    when: vault_environment_settings is defined and vault_environment_settings | list | length > 0

  - name: Include hardening tasks
    include_tasks: hardening.yml

  - name: Start and enable vault
    service:
      name: vault
      state: started
      enabled: yes
    when: vault_type == "oss"

  - name: Enable vault
    service:
      name: vault
      state: enabled
      enabled: yes
    when: vault_type != "oss"

  handlers:
  - name: restart-vault
    service:
      name: vault
      state: restarted

