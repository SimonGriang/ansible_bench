- name: Configure rsyslog
  hosts: localhost
  tasks:
    - name: Import assert.yml
      include_role:
        name: assert
      delegate_to: localhost

    - name: Uninstall conflicting systemd-logger
      package:
        name: systemd-logger
        state: absent

    - name: Install rsyslog
      package:
        name: "{{ rsyslog_packages }}"
        state: "{{ rsyslog_package_state }}"

    - name: Install additional rsyslog packages
      package:
        name: "{{ item }}"
        state: "{{ rsyslog_package_state }}"
      loop: "{{ rsyslog_features }}"

    - name: Configuring default rsyslog
      template:
        src: "{{ rsyslog_config_file_format }}"
        dest: "{{ rsyslog_dest_conf_file }}"
        mode: '0644'
      notify: restart rsyslog
      when: rsyslog_deploy_default_config is true

    - name: Make configuration directory
      file:
        path: /etc/rsyslog.d/
        mode: '0755'
        state: directory

    - name: Configuring rsyslog forward rule
      template:
        src: "{{ rsyslog_config_file_format }}"
        dest: "/etc/rsyslog.d/{{ rsyslog_forward_rule_name }}.conf"
        mode: '0644'
      notify: restart rsyslog
      when: rsyslog_deploy_default_config is false

    - name: Configuring additional config files
      loop:
        rsyslog_rsyslog_d_files
      when: rsyslog_deploy_default_config is false
      tasks:
        - name: Create rsyslog config file
          file:
            path: "/etc/rsyslog.d/{{ item.key }}.conf"
            mode: '0644'
            content: "{{ item.value.content | string }}"
            validate: "{{ item.value.validate | string }}"
          notify: restart rsyslog
          when: item.value.state == 'present' or item.value.state is not defined

    - name: Start and enable rsyslog
      service:
        name: "{{ rsyslog_service }}"
        state: started
        enabled: true

