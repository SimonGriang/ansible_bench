---
- name: Migrate Java JDK vendor from 'adoptopenjdk' to 'temurin' if selected
  when: java_vendor == 'adoptopenjdk'
  set_fact:
    java_vendor: 'temurin'

- include_vars:
    file: "{{ java_vendor }}.yml"

- include_vars:
    file: "architecture.yml"

- name: Set OS-specific variables for Java (I)
  set_fact:
    java_open_jdk_home: "{{ java_open_jdk_home | default('') }}"
    java_adopt_jdk_home: "{{ java_adopt_jdk_home | default('') }}"
    java_home: "{{ java_home | default('') }}"
    java_version: "{{ java_version | default('') }}"

- name: Set OS and architecture-specific variables for Java (II)
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- block:
  - name: Handle Debian pre-requisites for Java
    when: ansible_distribution == 'Debian' or ansible_distribution == 'Ubuntu'
    apt:
      cache_valid_time: 0
      state: present
    become: yes
    apt_key:
      keyserver: keyserver.ubuntu.com
      state: present
      id: "{{ item }}"
    become: yes
  with_items:
    - 'https://keyserver.ubuntu.com/pks/lookup?op=get&fingerprint=on&search=0x21B7CD6FA61D9C66'
    - 'https://keyserver.ubuntu.com/pks/lookup?op=get&fingerprint=on&search=0x7638D0442B90D010'
    - 'https://keyserver.ubuntu.com/pks/lookup?op=get&fingerprint=on&search=0x76B19D39D39D2C6D'
  - name: Add required repositories
    apt_repository:
      repo: ppa:openjdk/r
      state: present
      update_cache: yes
    become: yes
  when: java_vendor == 'temurin'

- block:
  - name: Handle RedHat pre-requisites for Java
    when: ansible_distribution == 'RedHat' or ansible_distribution == 'CentOS'
    yum:
      cache_valid_time: 0
      state: present
    become: yes
    yum_key:
      key: 21B7CD6FA61D9C66
      state: present
    become: yes
  - name: Add required repositories
    yum_repository:
      name: openjdk-r
      description: OpenJDK packages
      baseurl: https://download.openjdk.java.net/redhat/rhel-$releasever
      gpgcheck: yes
    become: yes

- name: Install required libraries for Java
  package:
    name: "{{ item }}"
    state: present
  with_items:
    - libstdc++6
    - lib32stdc++6

- block:
  - name: Install Java on Debian
    when: java_vendor == 'temurin'
    apt:
      cache_valid_time: 0
      state: present
      name: openjdk-17-jdk
    become: yes
  - name: Install Java on Debian
    when: java_vendor == 'adoptopenjdk'
    apt:
      cache_valid_time: 0
      state: present
      name: openjdk-11-jdk
    become: yes

- block:
  - name: Install Java on RedHat
    when: java_vendor == 'temurin'
    yum:
      cache_valid_time: 0
      state: present
      name: java-17-openjdk
    become: yes
  - name: Install Java on RedHat
    when: java_vendor == 'adoptopenjdk'
    yum:
      cache_valid_time: 0
      state: present
      name: java-11-openjdk
    become: yes

- name: Export environment variables for Java
  template:
    src: templates/jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0755'

- name: Source environment variables for Java
  shell: source /etc/profile.d/jdk.sh

- block:
  - name: Correct Java version selected for Java < 11
    alternatives:
      name: /usr/libexec/java_home
      state: present
      link: /usr/libexec/java_home
    when: java_version < '11'
  - name: Correct Java version selected for Java >= 11
    alternatives:
      name: /usr/libexec/java_home
      state: present
      link: /usr/libexec/java_home
    when: java_version >= '11'

