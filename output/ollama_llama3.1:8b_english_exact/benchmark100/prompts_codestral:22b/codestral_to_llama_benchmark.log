---
- name: Import assertions
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"

- name: Configure selinux
  seboolean:
    state: enabled
  seport:
    name: "{{ httpd_port }}"
  when: httpd_ssl_port is defined | bool

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
  notify:
    - test httpd configuration
    - restart httpd

- name: Activate httpd module | Debian
  command: "{{ httpd_modules_to_activate_with_command }}"
  notify:
    - test httpd configuration
  when: ansible_distribution == 'Debian'

- name: Import ssl configuration
  import_tasks: "ssl.yml"
  when: ssl_enabled | bool

- name: Import locations
  import_tasks: "locations.yml"
  when: httpd_locations is defined | bool

- name: Import virtual hosts
  import_tasks: "vhosts.yml"
  when: httpd_vhosts is defined | bool

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_server_root }}"
  notify:
    - test httpd configuration
    - restart httpd
  when: (ansible_distribution == 'Debian') or (ansible_distribution == 'Suse')

- name: Import directories
  import_tasks: "directories.yml"
  when: httpd_directories is defined | bool

- name: Flush handlers
  meta: flush_handlers

- name: Remove default HTML
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


