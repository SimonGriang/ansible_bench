---
- name: MySQL Configuration and Initialization
  hosts: localhost
  gather_facts: no
  vars:
    mysql_packages:
      - mysql-server
      - mysql-client
    mysql_configuration_options:
      - { section: 'mysqld', option: 'bind-address', value: '127.0.0.1' }
      - { section: 'mysqld', option: 'skip-networking', value: 'off' }
    mysql_socket: /var/run/mysqld/mysqld.sock
    mysql_initialize_command: /usr/bin/mysql_install_db
    mysql_databases:
      - name: mydb
        initial_import: False
      - name: mydb2
        initial_import: True
    mysql_users:
      - name: myuser
        password: mypassword
    mysql_root_password: myrootpassword
  tasks:
  - name: Import assert.yml
    include_vars:
      file: /path/to/assert.yml

  - name: Install mysql
    package:
      name: "{{ mysql_packages }}"
      state: present
    notify:
      - set_root_password
      - reexecute_systemd_daemon

  - name: Configure mysql server
    template:
      src: templates/mysql-server.cnf.j2
      dest: /etc/my.cnf
      mode: '0644'
    notify: restart_mysql

  - name: Configure mysql client
    template:
      src: templates/mysql-client.cnf.j2
      dest: /etc/mysql/client.cnf
      mode: '0644'
    notify: restart_mysql

  - name: Initialize mysql
    command:
      cmd: "{{ mysql_initialize_command }}"
    when: (ansible_distribution == 'Alpine' or ansible_distribution == 'Archlinux') and mysql_databases is defined

  - name: Start and enable mysql
    service:
      name: mysql
      state: started
      enabled: yes

  - name: Flush handlers
    meta: flush_handlers

  - name: Place my.cnf
    template:
      src: templates/my.cnf.j2
      dest: /root/.my.cnf
      mode: '0600'

  - name: Create databases
    mysql_db:
      name: "{{ item.name }}"
      state: present
      user: root
      password: "{{ mysql_root_password }}"
      password_hash: "{{ item.initial_import | bool }}" if item.initial_import else (false | bool)
    loop: "{{ mysql_databases }}"
    when: mysql_databases is defined

  - name: List databases
    mysql_db:
      name: ''
      state: list
      user: root
      password: "{{ mysql_root_password }}"

  - name: Import database
    mysql_db:
      name: "{{ item.name }}"
      state: present
      user: root
      password: "{{ mysql_root_password }}"
      password_hash: "{{ item.initial_import | bool }}" if item.initial_import else (false | bool)
    loop: "{{ mysql_databases }}"
    when: mysql_databases is defined and item.initial_import

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "*.*:ALL"
      user_password: yes
    loop: "{{ mysql_users }}"
    when: mysql_users is defined

  - name: Flush handlers again
    meta: flush_handlers


