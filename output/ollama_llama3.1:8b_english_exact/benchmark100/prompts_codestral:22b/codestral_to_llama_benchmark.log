  - name: Create keepalived configuration file
    template:
      src: templates/keepalived.conf.j2
      dest: /etc/keepalived/keepalived.conf
      owner: root
      group: root
      mode: '0644'
    notify:
      - restart keepalived

  - name: Enable and unmask keepalived service
    service:
      name: keepalived
      enabled: yes
      masked: no
    notify:
      - restart keepalived

  - name: Flush handlers
    meta:
      flush_handlers: false



