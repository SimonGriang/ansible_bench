    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when: bootstrap_wait_for_host and ansible_connection.connection_type not in ['container', 'docker']
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

- name: Prepare System
  block:
  - name: Test Connection
    connection: "{{ ansible_connection.connection_type }}"
