---
# Configure Vault

hosts: all
become: true

vars:
  vault_group: vault_group
  vault_user: vault_user
  vault_download_path: /opt/vault
  vault_path: /opt/vault
  vault_directories:
    - name: /opt/vault/data
      owner: vault_user
      group: vault_group
      mode: '0755'
    - name: /opt/vault/logs
      owner: vault_user
      group: vault_group
      mode: '0755'
  vault_data_directories:
    - name: /opt/vault/data
      owner: vault_user
      group: vault_group
      mode: '0755'
    - name: /opt/vault/logs
      owner: vault_user
      group: vault_group
      mode: '0755'
  vault_tls_files:
    - file: /opt/vault/data/tls/tls.key
      owner: vault_user
      group: vault_group
      mode: '0644'
    - file: /opt/vault/data/tls/tls.crt
      owner: vault_user
      group: vault_group
      mode: '0644'
  vault_data_directory: /opt/vault/data
  vault_tls_directory: /opt/vault/data/tls
  vault_service_file_path: /opt/vault/vault.service.j2
  vault_hcl_file_path: /opt/vault/vault.hcl
  vault_env_file_path: /opt/vault/etc/vault.d/vault.env
  vault_binary_url: https://example.com/vault-binary.tar.gz

tasks:
  - name: Create Vault group
    ansible.builtin.group:
      name: '{{ vault_group }}'
      state: present

  - name: Create Vault user
    ansible.builtin.user:
      name: '{{ vault_user }}'
      group: '{{ vault_group }}'
      create_home: false
      state: present

  - name: Create Vault download directory
    ansible.builtin.file:
      path: '{{ vault_download_path }}'
      state: directory
      owner: '{{ vault_user }}'
      group: '{{ vault_group }}'
      mode: '0755'

  - name: Download Vault binary
    ansible.builtin.get_url:
      url: '{{ vault_binary_url }}'
      dest: '{{ vault_download_path }}'
      mode: '0755'
    become: true

  - name: Unarchive Vault binary
    unarchive:
      src: '{{ vault_download_path }}/vault-*.tar.gz'
      dest: '{{ vault_download_path }}'
      compression: gzip
      interactive: yes
    become: true

  - name: Ensure Vault binary ownership
    ansible.builtin.file:
      path: '{{ vault_download_path }}/vault'
      owner: root
      group: root
      mode: '0755'

  - name: Check if vault_path exists
    ansible.builtin.stat:
      path: '{{ vault_path }}'
      state: file
    failed_when: false

  - name: Create vault_path if it does not exist
    ansible.builtin.file:
      path: '{{ vault_path }}'
      state: directory
      owner: '{{ vault_user }}'
      group: '{{ vault_group }}'
      mode: '0755'
    when: vault_path is not defined or vault_path|length > 0

  - name: Create directories in vault_path
    ansible.builtin.file:
      path: '{{ item.name }}'
      state: directory
      owner: '{{ item.owner }}'
      group: '{{ item.group }}'
      mode: '{{ item.mode }}'
    loop: '{{ vault_directories }}'

  - name: Create data directories
    ansible.builtin.file:
      path: '{{ item.name }}'
      state: directory
      owner: '{{ item.owner }}'
      group: '{{ item.group }}'
      mode: '{{ item.mode }}'
    loop: '{{ vault_data_directories }}'

  - name: Generate TLS key and certificate
    command: openssl req -x509 -newkey rsa:2048 -nodes -keyout '{{ vault_data_directory }}/tls/tls.key' -out '{{ vault_data_directory }}/tls/tls.crt' -days 365 -subj '/CN=localhost'
    notify: Restart vault

  - name: Set ownership of tls material
    ansible.builtin.file:
      path: '{{ item.file }}'
      owner: '{{ item.owner }}'
      group: '{{ item.group }}'
      mode: '{{ item.mode }}'
    loop: '{{ vault_tls_files }}'

  - name: Copy Vault binary
    ansible.builtin.copy:
      src: '{{ vault_download_path }}/vault'
      dest: '{{ vault_path }}/usr/bin/vault'
      mode: '0755'
    notify: Restart vault

  - name: Set capabilities on /usr/bin/vault
    community.general.capabilities:
      file: /usr/bin/vault
      capabilities: cap_ipc_lock=ep

  - name: Touch vault.env
    ansible.builtin.file:
      path: '{{ vault_env_file_path }}'
      state: touch
      mode: '0644'
    notify: Restart vault

  - name: Create /usr/lib/systemd/system
    ansible.builtin.file:
      path: '/usr/lib/systemd/system'
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Copy Vault service file
    ansible.builtin.copy:
      src: '{{ vault_service_file_path }}'
      dest: '/usr/lib/systemd/system/vault.service'
      mode: '0644'
    notify: Daemon reload

  - name: Copy vault configuration
    ansible.builtin.copy:
      src: '{{ vault_hcl_file_path }}'
      dest: '{{ vault_path }}/etc/vault.d/vault.hcl'
      mode: '0644'
    notify: Restart vault

  - name: Flush handlers
    meta: flush_handlers

handlers:
  - name: Restart vault
    service:
      name: vault
      state: restarted

  - name: Daemon reload
    systemd:
      daemon_reload: yes  5%|▌         | 5/100 [04:13<1:22:08, 51.88s/it]

