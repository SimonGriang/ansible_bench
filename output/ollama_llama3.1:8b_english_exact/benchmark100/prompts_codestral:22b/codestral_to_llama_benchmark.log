    mysql_db:
      name: "{{ item.name }}"
      state: present
      user: root
      password: "{{ mysql_root_password }}"
      password_hash: "{{ item.initial_import | string }}" if item.initial_import else (false | string)
    loop: "{{ mysql_databases }}"
    when: mysql_databases is defined

  - name: List databases
    mysql_db:
      name: ''
      state: list
      user: root
      password: "{{ mysql_root_password }}"
    register: mysql_info

  - name: Import database
    mysql_db:
      name: "{{ item.name }}"
      state: present
      user: root
      password: "{{ mysql_root_password }}"
      password_hash: "{{ item.initial_import | string }}" if item.initial_import else (false | string)
    loop: "{{ mysql_databases }}"
    when: mysql_databases is defined and item.initial_import

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "*.*:ALL"
      user_password: yes
    loop: "{{ mysql_users }}"
    when: mysql_users is defined

  - name: Flush handlers again
    meta: flush_handlers


