---
- name: Main tasks
  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install required packages
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ selinux_requirements }}"
    notify: gather_facts

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure selinux
    block:
      - name: Manage selinux state and policy
        selinux:
          state: "{{ selinux_state }}"
          policy: "{{ selinux_policy }}"
        notify: reboot_handler

      - name: Manage selinux booleans
        selinux:
          boolean:
            state: "{{ item.state }}"
            persistent: "{{ item.persistent }}"
          loop: "{{ selinux_booleans }}"
    when: selinux_status is defined and (connection != 'container' and connection != 'docker' and connection != 'community.docker.docker')


