---
- name: Configure virtual hosts
  tasks:
  - name: Create document root directories
    file:
      path: "{{ item.documentroot }}"
      state: directory
      owner: "{{ item.owner }}"
      group: "{{ item.group }}"
      mode: "{{ item.mode }}"
    loop: "{{ httpd_vhosts }}"
    loop_control:
      loop_var: item

  - name: Configure virtual hosts
    template:
      src: templates/vhost.conf.j2
      dest: "/etc/apache2/sites-available/{{ item.name }}.conf"
      mode: '0644'
    notify: "test configuration validity and restart httpd service"
    loop: "{{ httpd_vhosts }}"
    loop_control:
      loop_var: item

  - name: Enable virtual hosts on Debian systems
    apt:
      name: "{{ item.name }}"
      state: present
      cache_valid_time: 3600
    creates: "/etc/apache2/sites-available/{{ item.name }}.conf"
    when: ansible_distribution == "Debian"
    loop: "{{ httpd_vhosts }}"
    loop_control:
      loop_var: item

