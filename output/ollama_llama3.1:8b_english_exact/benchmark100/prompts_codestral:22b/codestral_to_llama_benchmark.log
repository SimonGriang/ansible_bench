--- 

- name: Task 1 - Import assert.yml
  include_task: assert.yml
  delegate_to: localhost
  run_once: yes

- name: Task 2 - Install required software
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  when: users_requirements | length > 0

- name: Task 3 - Loop over users_groups
  include_task: group.yml
  loop: "{{ users_groups }}"
  when: users_groups is defined

- name: Task 4 - Ensure /etc/sudoers.d is included
  lineinfile:
    dest: /etc/sudoers
    regexp: '^[@#]includedir\s+{{ users_sudo_includedir }}'
    line: '@{{ users_sudo_includedir }}'
  notify: visudo

- name: Task 5 - Loop over users
  include_task: user.yml
  loop: "{{ users }}"
  when: users is defined

- name: Task 6 - Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow == true

- name: Task 7 - Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow == false


