---
- name: Bootstrap tasks
  tasks:
  - name: Import assert.yml
    include: assert.yml

  - name: Wait for port to be available
    wait_for:
      host: 127.0.0.1
      port: 22
      connect_timeout: 5
      timeout: "{{ bootstrap_timeout }}"

  - name: Prepare system
    block:
      - name: Test connection
        ping:
          connection: ssh
      - name: Check if sudo is available
        stat:
          path: /usr/bin/sudo
        failed_when: False
      - name: Gather bootstrap facts
        setup:
          filter:
            - 'ansible_distribution'
            - 'ansible_distribution_version'
          gather_subset: all
      - name: Install necessary bootstrap packages
        raw: "{{ 'dnf -y install libdnf5' if ansible_distribution in ['Fedora', 'RedHat'] else '' }}"
    always:
      - name: Ensure libdnf5 is present on Fedora/RedHat systems
        raw: "{{ 'dnf -y install libdnf5' if ansible_distribution in ['Fedora', 'RedHat'] else '' }}"

  - name: Gather ansible facts
    setup:

  - name: Install bootstrap packages
    package:
      name: "{{ item }}"
      state: present
      become: "{{ bootstrap_become }}"
    loop: "{{ bootstrap_facts_packages }}"


