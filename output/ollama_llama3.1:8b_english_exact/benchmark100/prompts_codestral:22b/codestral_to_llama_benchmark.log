- name: Assert Variables
  import_tasks: assert.yml

- name: Wait for Host
  wait_for_connection:
    host: "{{ inventory_hostname }}"
    connection: "{{ ansible_connection.connection_type }}"
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when: bootstrap_wait_for_host and ansible_connection.connection_type not in ['container', 'docker']
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

- name: Prepare System
  block:
  - name: Test Connection
    connection: "{{ ansible_connection.connection_type }}"
    local: yes
  - name: Debug
    debug:
      msg: "Test connection failed."
    when: ansible_connection.connection_type == 'localhost' and not connection
  - name: Gather Bootstrap Facts
    setup: "{{ bootstrap_facts }}"
  - name: Install Bootstrap Packages
    raw: "{{ bootstrap_packages | default([]) | join(' ') }} {{ bootstrap_package_args | default('') }}"
    register: bootstrap_packages_result
    changed_when: bootstrap_packages_result.rc != 0

- name: Ensure System Prepared
  block:
  - name: Gather Ansible Facts
    setup: "{{ ansible_facts }}"
  - name: Install Bootstrap Packages
    package:
      name: "{{ bootstrap_packages | default([]) | join(' ') }}"
      state: present

