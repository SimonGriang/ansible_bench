  vars:
    mysql_packages:
      - mysql-server
      - mysql-client
    mysql_configuration_destination: /etc/mysql
    mysql_configuration_options:
      - option1: value1
      - option2: value2
    mysql_socket: /var/run/mysqld/mysqld.sock
    mysql_root_password: 'root_password'
    mysql_databases:
      - database1
      - database2
    mysql_users:
      - user1: 'user1_password'
      - user2: 'user2_password'
    mysql_initialize_command: mysql_install_db
    mysql_service: mysql

  tasks:
  - name: Import assert.yml
    include: assert.yml

  - name: Install mysql
    package:
      name: "{{ item }}"
      state: present
    notify: 
      - Set root password
      - Systemctl daemon-reexec
    loop: "{{ mysql_packages }}"

  - name: Configure mysql server
