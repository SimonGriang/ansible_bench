---
- name: Install epel
  ansible.builtin.apt:
    name: epel-release
    state: present
  notify:
    - update package cache

- name: Install epel gpg key
  ansible.builtin.apt_key:
    key: "{{ epel_gpg_key }}"

- name: Install epel-release
  ansible.builtin.apt:
    name: epel-release
    state: present
  notify:
    - update package cache

- name: Install epel-next-release
  ansible.builtin.apt:
    name: epel-next-release
    state: present
  when: epel_next
  notify:
    - update package cache


