---
- name: Install and configure cadvisor
  hosts: localhost

  tasks:
  - name: Create directories
    file:
      path: /usr/local/bin/cadvisor
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Download cadvisor binary
    get_url:
      url: https://example.com/cadvisor/cadvisor
      dest: /usr/local/bin/cadvisor
      checksum: sha256:1234567890abcdef
    when: not cadvisor_binary_locally_distributed

  - name: Download cadadvisor binary
    copy:
      content: "{{ cadvisor_binary | unquote }}"
      dest: /usr/local/bin/cadvisor
      mode: '0755'
    when: cadvisor_binary_locally_distributed

  - name: Propagate locally distributed cadvisor binary
    copy:
      content: "{{ cadvisor_binary | unquote }}"
      dest: /usr/local/bin/cadvisor
      mode: '0755'
    when: cadvisor_binary_locally_distributed
    notify:
      - restart cadvisor

  - name: Create a symlink
    file:
      path: /usr/local/bin/cadvisor-binary
      state: link
      target: /usr/local/bin/cadvisor

  - name: Configure cadvisor systemd service
    template:
      src: templates/cadvisor.service.j2
      dest: /etc/systemd/system/cadvisor.service
      mode: '0644'
    notify:
      - restart cadvisor

  - name: Check cadvisor service status
    shell:
      cmd: systemctl status cadvisor

  - name: Enable cadvisor systemd service
    service:
      name: cadvisor
      enabled: yes

  - name: Start cadadvisor systemd service
    service:
      name: cadvisor
      state: started
    notify:
      - reload systemd-daemon

  handlers:
  - name: restart cadvisor
    service:
      name: cadvisor
      state: restarted

  - name: reload systemd-daemon
    service:
      name: systemd-daemon
      state: reloaded

