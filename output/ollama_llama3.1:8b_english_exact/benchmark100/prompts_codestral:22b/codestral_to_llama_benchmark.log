---
- name: Tasks
  tasks:
  - name: Check if python3.11 EXTERNALLY-MANAGED file exists
    stat:
      path: /usr/bin/python3.11/EXTERNALLY-MANAGED
    register: python3_11_file_exists
  - name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
    file:
      path: /usr/bin/python3.11/EXTERNALLY-MANAGED
      state: link
      linkname: /usr/bin/python3.11/EXTERNALLY-MANAGED.old
    when: python3_11_file_exists.stat.exists
  - name: Check if python3.12 EXTERNALLY-MANAGED file exists
    stat:
      path: /usr/bin/python3.12/EXTERNALLY-MANAGED
    register: python3_12_file_exists
  - name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
    file:
      path: /usr/bin/python3.12/EXTERNALLY-MANAGED
      state: link
      linkname: /usr/bin/python3.12/EXTERNALLY-MANAGED.old
    when: python3_12_file_exists.stat.exists
  - include_tasks: assert.yml
  - name: Install python pip
    apt:
      name: python3-pip
      state: present
  - name: Configure pip proxy
    pip:
      executable: /usr/bin/python3
      virtualenv: false
      name: 'pip config set proxies {{ python_pip_proxy }}'
    when: python_pip_proxy is defined
  - name: Trust hosts
    pip:
      executable: /usr/bin/python3
      virtualenv: false
      name: 'pip config set trusted-hosts {{ python_pip_trusted_host }}'
    when: python_pip_trusted_host is defined
  - name: Update pip
    pip:
      executable: /usr/bin/python3
      virtualenv: false
      name: 'pip install --upgrade pip'
    when:
      - python_pip_update
      - not ansible_distribution in ['bookworm', 'noble']
      - not ansible_distribution_major_version == '3'
  - name: Install requested modules
    pip:
      executable: "{{ python_pip_executable }}"
      extra_opts:
        '--no-deps'
      name: "{{ item.name }} {{ item.state | default('present') }} {{ item.version | default('') }}"
    loop: "{{ python_pip_modules | default([]) }}"
    when:
      - not ansible_distribution in ['bookworm', 'noble']
      - not ansible_distribution_major_version == '3'

