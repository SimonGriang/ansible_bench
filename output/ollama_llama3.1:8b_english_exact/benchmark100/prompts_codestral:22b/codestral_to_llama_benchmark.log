---
- name: Tasks for Promtail Installation
  hosts: localhost
  gather_facts: no

  tasks:
  - name: Assert usage of systemd as an init system
    assert:
      that: "'systemd' in ansible_distribution"
      msg: "This module only works with systemd"

  - name: Get the latest release version of Promtail from GitHub
    uri:
      url: "https://api.github.com/repos/promtail/promtail/releases/latest"
      method: GET
      return_content: true
      headers:
        accept: application/json
        Authorization: Bearer {{ GH_TOKEN }}
    delegate_to: localhost
    run_once: true

  - name: Check if the local Promtail binary archive exists
    assert:
      that: lookup('file', promtail_binary_local_dir, error_on_missing=False) is not None
      msg: "When using 'promtail_binary_local_dir' please ensure that the binary exists"
    delegate_to: localhost
    run_once: true

  - name: Get the checksum for the Promtail binary
    uri:
      url: "https://github.com/promtail/promtail/releases/download/{{ promtail_release }}/promtail_{{ go_arch }}_linux_amd64.gz"
      method: GET
      return_content: true
      headers:
        accept: application/json
        Authorization: Bearer {{ GH_TOKEN }}
    delegate_to: localhost
    run_once: true


