---
- name: Update all software
  import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  when: package_manager == 'apk'
  apt:
    cache_valid_time: 3600
  notify: Reboot

- name: Configure apt
  when: package_manager == 'apt'
  apt:
    upgrade: 'yes'
    update_cache_valid_time: '{{ update_cache_valid_time }}'
    update_upgrade_command: '{{ update_upgrade_command }}'
    autoremove: '{{ update_autoremove }}'
  notify: Reboot

- name: Update all software (dnf)
  when: package_manager in ['dnf', 'dnf5']
  dnf:
    exclude: '{{ update_excluded_packages }}'
    update_cache: yes
  notify: Reboot

- name: Update all software (pacman)
  when: package_manager == 'pacman'
  pacman:
    update_cache: yes
  notify: Reboot

- name: Configure yum
  when: package_manager == 'yum'
  yum:
    exclude: '{{ update_excluded_packages }}'
    update_cache: yes
  when_not: '{{ distribution_major_version == 6 }}'
  apt:
    name: yum-utils
    state: present

- name: Update all software (zypper)
  when: package_manager == 'zypper'
  zypper:
    update: yes
  notify: Reboot


