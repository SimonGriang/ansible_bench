---
- name: MySQL configuration and initialization
  hosts: localhost
  gather_facts: true
  become: true
  vars:
    mysql_packages:
      - mysql-server
      - mysql-client
    mysql_configuration_destination: /etc/mysql
    mysql_configuration_options:
      - option1: value1
      - option2: value2
    mysql_socket: /var/run/mysqld/mysqld.sock
    mysql_root_password: 'root_password'
    mysql_databases:
      - database1
      - database2
    mysql_users:
      - user1: 'user1_password'
      - user2: 'user2_password'
  tasks:
    - name: Import assert.yml
      include: assert.yml

    - name: Install mysql
      package:
        name: "{{ item }}"
        state: present
      notify: 
        - Set root password
        - Systemctl daemon-reexec
      loop: "{{ mysql_packages }}"

    - name: Configure mysql server
      template:
        src: mysql-server.cnf.j2
        dest: "{{ item }}"
        mode: '0640'
      notify: Restart mysql server
      loop: "{{ mysql_configuration_destination }}/{{ item }}.cnf"
      with_items:
        - mysql-server.cnf

    - name: Configure mysql client
      template:
        src: mysql-client.cnf.j2
        dest: "{{ item }}"
        mode: '0640'
      loop: "{{ mysql_configuration_destination }}/{{ item }}.cnf"
      with_items:
        - mysql-client.cnf

    - name: Initialize mysql
      command: "{{ item }}"
      when: ansible_distribution in ['Alpine', 'Archlinux']
      loop: "{{ mysql_initialize_command }}"

    - name: Start and enable mysql
      service:
        name: "{{ mysql_service }}"
        state: started
        enabled: true

    - name: Flush handlers
      meta: flush_handlers

    - name: Place my.cnf
      template:
        src: my.cnf.j2
        dest: /root/my.cnf
        mode: '0640'
      notify: Restart mysql server

    - name: Create databases
      when: mysql_databases is defined
      mysql_db:
        name: "{{ item }}"
        state: present
        login_user: root
        login_password: "{{ mysql_root_password }}"
        login_host: "{{ mysql_socket }}"
      loop: "{{ mysql_databases }}"

    - name: Create users
      when: mysql_users is defined
      mysql_user:
        name: "{{ item.key }}"
        host: '%'
        password: "{{ item.value }}"
        priv: '*.*:ALL'
        state: present
        login_user: root
        login_password: "{{ mysql_root_password }}"
        login_host: "{{ mysql_socket }}"
      loop: "{{ mysql_users }}"

    - name: Flush handlers again
      meta: flush_handlers



