---
- name: Configure Keepalived and RKE2 Server Health Checks
  hosts: all
  become: true

  tasks:
  - name: Update package cache
    apt:
      cache_valid_time: 3600
    when: ansible_distribution == "Ubuntu" or ansible_distribution == "Debian"
  - name: Update package cache
    dnf:
      cache_enabled: yes
    when: ansible_distribution == "Fedora" or ansible_distribution == "CentOS" or ansible_distribution == "Red Hat Enterprise Linux"
  - name: Install keepalived package
    package:
      name: keepalived
      state: present

  - name: Create keepalived directory
    file:
      path: /etc/keepalived
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Create Kubernetes API health check script for Debian OS family
    template:
      src: templates/kubernetes-api-health-check-debian.sh.j2
      dest: /etc/keepalived/kubernetes-api-health-check.sh
      owner: root
      group: root
      mode: '0755'
    notify: restart keepalived

  - name: Create Kubernetes API health check script for RedHat OS family
    template:
      src: templates/kubernetes-api-health-check-redhat.sh.j2
      dest: /usr/libexec/keepalived/kubernetes-api-health-check.sh
      owner: root
      group: root
      mode: '0755'
    when: ansible_distribution == "Fedora" or ansible_distribution == "CentOS" or ansible_distribution == "Red Hat Enterprise Linux"
    notify: restart keepalived

  - name: Create RKE2 Server health check script for Debian OS family
    template:
      src: templates/rke2-server-health-check-debian.sh.j2
      dest: /etc/keepalived/rke2-server-health-check.sh
      owner: root
      group: root
      mode: '0755'
    notify: restart keepalived

  - name: Create RKE2 Server health check script for RedHat OS family
    template:
      src: templates/rke2-server-health-check-redhat.sh.j2
      dest: /usr/libexec/keepalived/rke2-server-health-check.sh
      owner: root
      group: root
      mode: '0755'
    when: ansible_distribution == "Fedora" or ansible_distribution == "CentOS" or ansible_distribution == "Red Hat Enterprise Linux"
    notify: restart keepalived

  - name: Create keepalived configuration file
    template:
      src: templates/keepalived.conf.j2
      dest: /etc/keepalived/keepalived.conf
      owner: root
      group: root
      mode: '0644'
    notify: restart keepalived

  - name: Enable and unmask keepalived service
    service:
      name: keepalived
      enabled: yes
      masked: no
    notify: restart keepalived

  - name: Flush handlers
    meta: flush_handlers


