---
- name: Manage user
  become: true
  tasks:
  - name: Create SSH key directory for user
    file:
      path: "{{ users_ssh_key_directory }}"
      state: directory
      mode: '0750'
    when: manage_ssh_key is defined and manage_ssh_key is true

  - name: Manage user account
    user:
      name: "{{ user.name }}"
      state: "{{ user.state | default('present') }}"
      comment: "{{ user.comment | default('') }}"
      create_home: "{{ user.create_home | default(true) }}"
      password: "{{ user.password | default('') }}"
      uid: "{{ user.uid | default('') }}"
      group: "{{ user.group | default('') }}"
      groups: "{{ user.groups | default([]) }}"
      home: "{{ user.home | default('/home') }}"
      shell: "{{ user.shell | default('/bin/bash') }}"
      update_password: "{{ user.update_password | default('always') }}"
      expires: "{{ user.expires | default('') }}"
      system: "{{ user.system | default(false) }}"
    when: user is defined

  - name: Set sudo options for user
    template:
      src: 'sudo.j2'
      dest: '/etc/sudoers.d/{{ user.name }}'
      mode: '0640'
    when: sudo_options is defined

  - name: Remove sudo options for user
    file:
      path: '/etc/sudoers.d/{{ user.name }}'
      state: absent
    when: sudo_options is not defined

  - name: Generate private SSH key for user
    command:
      cmd: "{{ users_ssh_keygen_command }}"
      chdir: "{{ users_ssh_key_directory }}"
    when: manage_ssh_key is defined and manage_ssh_key is true

  - name: Generate public SSH key for user
    shell:
      cmd: "{{ users_ssh_keygen_pubkey_command }}"
      chdir: "{{ users_ssh_key_directory }}"
    when: manage_ssh_key is defined and manage_ssh_key is true

  - name: Convert private SSH key to ppk format for user
    shell:
      cmd: 'ssh-keygen -e -f "{{ users_ssh_key_directory }}/{{ user.name }}" -C "Generated by Ansible role robertdebock.users"'
      chdir: "{{ users_ssh_key_directory }}"
    when: manage_ssh_key is defined and manage_ssh_key is true

  - name: Get or set home directory for user
    getent:
      database: passwd
      key: "{{ user.name }}"
      dest: user.home
    when: user is defined

  - name: Create .ssh directory for user
    file:
      path: "{{ user.home }}/.ssh"
      state: directory
      mode: '0700'
    when: (manage_ssh_key is defined and manage_ssh_key is true) or (private_keys is defined)

  - name: Deploy authorized keys for user
    authorized_key:
      user: "{{ user.name }}"
      state: present
      key: "{{ item }}"
    loop: "{{ authorized_keys | default([]) }}"
    when: authorized_keys is defined

  - name: Remove unauthorized keys for user
    authorized_key:
      user: "{{ user.name }}"
      state: absent
      key: "{{ item }}"
    loop: "{{ unauthorized_keys | default([]) }}"
    when: unauthorized_keys is defined

  - name: Copy generated private SSH key for user
    copy:
      content: "{{ lookup('file', '{{ users_ssh_key_directory }}/{{ user.name }}') }}"
      dest: "{{ user.home }}/.ssh/{{ user.name }}.pem"
      mode: '400'
      owner: "{{ user.name }}"
    when: (copy_private_key is defined and copy_private_key is true) and (manage_ssh_key is defined and manage_ssh_key is true)

  - name: Check password valid time for user
    command:
      cmd: 'awk \'BEGIN { FS = ":" } $1 == "{{ user.name }}" { print $5 }\' /etc/shadow'
    when: user is defined

  - name: Set password valid time for user
    command:
      cmd: 'chage -M "{{ user.password_validity_days }}" "{{ user.name }}"'
    when: (password_validity_days is defined) and (user is defined) and (user.password_validity_days != lookup('command', 'awk \'BEGIN { FS = ":" } $1 == "{{ user.name }}" { print $5 }\' /etc/shadow'))

  - name: Place private key file for user
    copy:
      content: "{{ item.content }}"
      dest: "{{ user.home }}/.ssh/{{ item.name }}"
      mode: '400'
      owner: "{{ user.name }}"
    loop: "{{ private_keys | default([]) }}"
    when: private_keys is defined


