---
- name: Set Bootstrap Facts
  tasks:
  - name: Lookup Bootstrap Facts
    raw: cat /etc/os-release
    register: bootstrap_facts
    changed_when: False
    become: false

  - name: Set Bootstrap Facts (I)
    set_fact:
      bootstrap_distribution: '{{ bootstrap_facts.stdout | regex_findall("NAME=\"(.*?)\"", regex_flags="i") | first }}'
      bootstrap_distribution_major: '{{ bootstrap_facts.stdout | regex_findall("VERSION_ID=\"(.*?)\"", regex_flags="i") | first | split(".")[0] }}'
    when:
      - bootstrap_facts is successful
      - bootstrap_distribution is undefined
      - bootstrap_distribution_major is defined
      - bootstrap_distribution_major | regex_search("^(2|3)", regex_flags="i")
    become: true
    become_user: '{{ bootstrap_become_user }}'

  - name: Set Bootstrap Facts (II)
    set_fact:
      bootstrap_os_family: '{{ bootstrap_distribution | to_lower | lookup("dict", bootstrap_distribution_families) | first }}'
    when:
      - bootstrap_distribution_major is defined
      - bootstrap_distribution_major | regex_search("^(2|3)", regex_flags="i")
      - bootstrap_distribution in bootstrap_distribution_families
    become: true
    become_user: '{{ bootstrap_become_user }}'

  vars:
    bootstrap_distribution_families:
      ubuntu: Debian
      debian: Debian
      centos: RedHat
      rhel: RedHat
      fedora: RedHat
      archlinux: ArchLinux
      freebsd: FreeBSD
      gentoo: Gentoo
      slackware: Slackware

