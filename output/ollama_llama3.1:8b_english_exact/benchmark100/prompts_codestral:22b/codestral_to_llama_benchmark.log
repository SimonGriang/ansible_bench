---
- name: Redis Configuration
  hosts: localhost
  tasks:
    - name: Import assert.yml
      include: assert.yml

    - name: Enable redis module stream (RHEL 8)
      shell: |
        dnf module enable redis

    - name: Install redis
      package:
        name: "{{ redis_packages }}"
        state: present

    - name: Configure redis
      template:
        src: src/redis.conf.j2
        dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
        mode: '{{ redis_mode }}'
        owner: '{{ redis_owner }}'
        group: '{{ redis_group }}'
        notify: Restart redis

    - name: Start and enable redis
      service:
        name: '{{ redis_service }}'
        state: started
        enabled: yes


