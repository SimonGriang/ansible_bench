# Tasks for configuring HTTPD directories
---

- name: Create directories
  file:
    path: '{{ item }}'
    state: directory
    mode: '0755'
  loop: '{{ httpd_directories }}'

- name: Configure directories
  template:
    src: 'directory.conf.j2'
    dest: '{{ item }}'
    mode: '0644'
  loop: '{{ httpd_directories }}'
  notify:
    - restart httpd

- name: Configure httpd configuration
  template:
    src: 'directory.conf.j2'
    dest: '{{ item }}'
    mode: '0644'
  loop: '{{ httpd_directories }}'
  notify:
    - restart httpd

- name: Test httpd configuration
  action: test
  module_name: httpd
  args:
    state: start
    config_file: '{{ httpd_config_directory }}/directory.conf'

- name: Restart httpd service
  service:
    name: httpd
    state: restarted

