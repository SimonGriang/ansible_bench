---
- name: RKE2 tasks
  hosts: all
  become: true

  vars:
    rke2_type: 'server'
    rke2_server_node_taints: 'rke2-server=true:NoSchedule'
    rke2_agent_node_taints: 'rke2-agent=true:NoSchedule'
    rke2_config: '/etc/rancher/rke2/config.yaml'
    rke2_kubelet_config: '/etc/rancher/rke2/kubelet-config.yaml'
    rke2_custom_registry_mirrors: []
    rke2_custom_registry_configs: []
    rke2_custom_registry_path: '/etc/rancher/rke2/registries.yaml'
    rke2_cluster_group_name: 'k8s_cluster'
    rke2_cni: 'none'
    rke2_token: 'your_token'
    rke2_service_name: 'rke2'

  tasks:
  - name: Create the RKE2 config directory
    file:
      path: /etc/rancher/rke2
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Set server taints
    set_fact:
      node_taints: '{{ rke2_server_node_taints }}'
    when: rke2_type == 'server'

  - name: Set agent taints
    set_fact:
      node_taints: '{{ rke2_agent_node_taints }}'
    when: rke2_type == 'agent'

  - name: Copy RKE2 config
    copy:
      content: '{{ lookup("template", rke2_config) }}'
      dest: /etc/rancher/rke2/config.yaml
      owner: root
      group: root
      mode: '0644'
    notify: Config file changed

  - name: Copy kubelet config
    copy:
      src: 'templates/kubelet-config.yaml.j2'
      dest: /etc/rancher/rke2/kubelet-config.yaml
      content: '{{ rke2_kubelet_config }}'
      owner: root
      group: root
      mode: '0644'
    when: rke2_kubelet_config != ""
    notify: Config file changed

  - name: Copy Containerd Registry Configuration file
    copy:
      content: '{{ lookup("template", rke2_custom_registry_path) }}'
      dest: /etc/rancher/rke2/registries.yaml
      owner: root
      group: root
      mode: '0644'
    when:
      - rke2_custom_registry_mirrors != []
      - rke2_custom_registry_configs != []
    notify: Config file changed

  - name: Start RKE2 service on the rest of the nodes
    service:
      name: '{{ rke2_service_name }}'
      state: started
      enabled: true
    environment:
      RKE2_TOKEN: '{{ rke2_token }}'
    notify: Service (re)started

  - name: Mask other RKE2 service on the rest of the nodes
    service:
      name: '{{ rke2_type == "server" ? "rke2-agent" : "rke2-server" }}'
      state: masked
    when: rke2_type == 'server'

  - name: Wait for remaining nodes to be ready - no CNI
    shell:
      cmd: |
        for node in $(kubectl get nodes -o jsonpath='{.items[*].metadata.name}'); do
          if kubectl get nodes $node -o jsonpath='{.status.conditions[*].status}'; then
            echo "Node $node is ready."
          else
            echo "Node $node is not ready, retrying in 10 seconds"

      run_once: true
      until: kubectl get nodes -o jsonpath='{.items[*].status.conditions[*].status}'

  - name: Wait for remaining nodes to be ready - with CNI
    shell:
      cmd: |
        count=$(kubectl get nodes -o jsonpath='{.items[*].status.conditions[*].status}')
        while [ $count -lt $(kubectl get nodes -o jsonpath='{.items[*].metadata.name}'); do
          echo "Waiting for nodes to be ready
      run_once: true
      until: kubectl get nodes -o jsonpath='{.items[*].status.conditions[*].status}'



