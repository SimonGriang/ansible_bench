---
- name: Install Helm
  tasks:
  - name: Check if Helm binary exists
    stat:
      path: '{{ helm_bin_path }}'
    register: helm_check

  - name: Check Helm version
    command:
      cmd: '{{ helm_bin_path }} version'
    ignore_errors: yes
    register: helm_existing_version

  - name: Download helm
    unarchive:
      src: 'https://get.helm.sh/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}'
      dest: '/tmp'
      copy: yes
      src: '/tmp/helm'
      dest: '/tmp/{{ helm_platform }}-{{ helm_arch }}/helm'
    when: (helm_check.stat.exists == False) or ((helm_existing_version.stdout != helm_version) and helm_check.stat.exists)

  - name: Copy helm binary into place
    copy:
      content: ''
      dest: '{{ helm_bin_path }}'
    when: helm_download.stat.exists


