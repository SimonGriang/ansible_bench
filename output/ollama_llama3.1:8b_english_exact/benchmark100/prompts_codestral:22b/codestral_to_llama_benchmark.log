    path: /var/cache/bind
    state: directory
    mode: '0755'
    owner: bind
    group: bind
  when: not caching_dns
  notify: restart bind

- name: Create group
  group:
    name: bind
    state: present

- name: Create user
  user:
    name: bind
    group: bind
    append: false
    system: yes

- name: Generate rndc key
  command:
    cmd: rndc-confgen -a /etc/bind/rndc.key
    creates: /etc/bind/rndc.key

- name: Set permissions on rndc key file
  file:
    path: /etc/bind/rndc.key
    state: file
    mode: '0600'
    owner: bind
    group: bind

- name: Get the hints/root file
  get_url:
    url: http://ftp.internic.net/domain/named.root
    dest: /var/cache/bind/named.root
    mode: '0644'
    force: true
  when: caching_dns|bool

- name: Create zone file
  template:
    src: templates/zone.j2
    dest: /var/cache/bind/{{ item.zone }}.zone
    mode: '0644'
    owner: bind
    group: bind
  when: item.zone_type == 'primary' and item.zone is defined
  loop:
    items: dns_zones

- name: Add zones to configuration
  template:
    src: templates/named.conf.j2
    dest: /etc/bind/named.conf.local
    mode: '0644'
    owner: bind
    group: bind
  notify: restart bind

- name: Place systemd override
  template:
    src: templates/bind.service.j2
    dest: /etc/systemd/system/bind.service.d/override.conf
    mode: '0644'
    owner: root
    group: root
  when: systemd|bool
  notify: restart bind

- name: Start and enable dns
  service:
    name: bind
    state: started
    enabled: yes

