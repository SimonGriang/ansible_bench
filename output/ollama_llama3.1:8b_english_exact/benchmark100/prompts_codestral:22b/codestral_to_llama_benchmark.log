---
- name: Task 1: password | Get efi path
  debug:
    var: grub_efi_path

- name: Task 2: password | Remove unwanted grub.cfg on EFI systems
  file:
    path: "{{ grub_efi_path }}/grub.cfg"
    state: absent

- name: Task 3: password | Install user template
  template:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    mode: '0644'

- name: Task 4: password | EFI | add password
  block:
    when: grub_efi_path is defined
  vars:
    grub_user: "your_username"
    grub_password: "your_password"
  file:
    path: "{{ grub_efi_path }}/etc/grub2-efi.cfg"
    line: "set superusers=\"{{ grub_user }}\""
    insertafter: '^set timeout='
  file:
    path: "{{ grub_efi_path }}/etc/grub2-efi.cfg"
    line: "password --echo-tty {{ grub_password }} {{ grub_user }}"
    insertafter: '^set superusers=\".*\"$'

- name: Task 5: password | MBR | add password
  block:
    when: grub_efi_path is defined
  vars:
    grub_user: "your_username"
    grub_password: "your_password"
  file:
    path: "/etc/grub2.cfg"
    line: "set superusers=\"{{ grub_user }}\""
    insertafter: '^set timeout='
  file:
    path: "/etc/grub2.cfg"
    line: "password --echo-tty {{ grub_password }} {{ grub_user }}"
    insertafter: '^set superusers=\".*\"$'

- name: Task 6: password | Add --unrestricted
  block:
    when: grub_password_unrestricted is defined and grub_password_unrestricted|bool
  vars:
    grub_password_unrestricted_files:
      - /etc/grub2.cfg
      - /etc/grub2-efi.cfg
  file:
    path: "{{ item }}"
    line: "--unrestricted"
    insertafter: '^set timeout='
  with_items: "{{ grub_password_unrestricted_files }}"


