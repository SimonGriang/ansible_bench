---
- name: Remove old Docker versions
  package:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Add Docker GPG key
  apt_key:
    keyserver: "https://download.docker.com/linux/{{ ansible_distribution | lower }}"
    state: present
  when: docker_add_repo

- name: Add Docker repository
  apt_repository:
    repo: "https://download.docker.com/linux/{{ ansible_distribution | lower }}"
    state: present
  when: docker_add_repo

- name: Configure Docker Nightly repo
  ini_file:
    path: "/etc/docker/ee/repos.conf"
    section: "nightly"
    option: "enabled"
    value: "{{ docker_yum_repo_enable_nightly }}"
  when: docker_add_repo

- name: Configure Docker Test repo
  ini_file:
    path: "/etc/docker/ee/repos.conf"
    section: "test"
    option: "enabled"
    value: "{{ docker_yum_repo_enable_test }}"
  when: docker_add_repo

- name: Configure containerd on RHEL 8
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"
  block:
    - name: Remove runc
      package:
        name: runc
        state: absent
    - name: Install container-selinux
      package:
        name: container-selinux
        state: present
    - name: Install containerd.io
      package:
        name: containerd.io
      state: present

- name: Ensure a new line character at the end of file
  lineinfile:
    path: /path/to/your/file.txt
    line: ''
    insertafter: BOF
  when: true

