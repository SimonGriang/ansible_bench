25-10-15T23:41:54.862470495Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5440021328, 'load_duration': 119784537, 'prompt_eval_count': 616, 'prompt_eval_duration': 158538037, 'eval_count': 541, 'eval_duration': 5160049903, 'model_name': 'llama3.1:8b'} id='run--f2746a65-da21-417f-8728-6799001c30c5-0' usage_metadata={'input_tokens': 616, 'output_tokens': 541, 'total_tokens': 1157}
