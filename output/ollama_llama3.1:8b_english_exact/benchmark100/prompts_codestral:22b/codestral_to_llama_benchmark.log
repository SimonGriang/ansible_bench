---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install dns
  apt:
    name: dnsutils
    state: present

- name: Create directories
  file:
    path: /etc/bind
    state: directory
    mode: '0755'
    owner: bind
    group: bind
  when: not caching_dns
  notify: restart bind

- name: Create directories
  file:
    path: /var/cache/bind
    state: directory
    mode: '0755'
    owner: bind
    group: bind
  when: not caching_dns
  notify: restart bind

- name: Create group
  group:
    name: bind
    state: present

- name: Create user
  user:
    name: bind
    group: bind
    append: true
    system: yes

- name: Generate rndc key
  command:
    cmd: rndc-confgen -a /etc/bind/rndc.key
    creates: /etc/bind/rndc.key

