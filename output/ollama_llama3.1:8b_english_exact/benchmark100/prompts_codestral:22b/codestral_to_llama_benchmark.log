---
- name: Ensure Docker is properly installed
  tasks:
  - name: Ensure apt key is not present
    apt_key:
      state: absent
      keyring: /etc/apt/keyrings/docker.gpg

  - name: Ensure old apt source list is not present
    file:
      path: /etc/apt/sources.list.d/docker.list
      state: absent

  - name: Ensure old versions of Docker are not installed
    apt:
      name: docker
      state: absent

  - name: Ensure legacy repo file is not present
    file:
      path: /etc/apt/sources.list.d/docker.list.save
      state: absent

  - name: Ensure dependencies are installed
    apt:
      name:
        - apt-transport-https
        - ca-certificates
        - python3-debian

  - name: Add or remove Docker repository
    block:
      - name: Add Docker repository
        apt_repository:
          repo: 'https://download.docker.com/linux/ubuntu {{ ansible_distribution_version }}'
          state: present
        when: docker_add_repo
      - name: Remove Docker repository
        apt_repository:
          repo: 'https://download.docker.com/linux/ubuntu {{ ansible_distribution_version }}'
          state: absent
        when: not docker_add_repo

      - name: Add Docker repository key
        apt_key:
          keyring: /etc/apt/keyrings/docker.gpg
          state: present
          url: https://download.docker.com/linux/ubuntu/gpg

      - name: Remove Docker repository key
        apt_key:
          keyring: /etc/apt/keyrings/docker.gpg
          state: absent
          url: https://download.docker.com/linux/ubuntu/gpg
        when: not docker_add_repo

  - name: Ensure handlers are notified immediately to update the apt cache
    meta:
      notify: update_apt_cache

