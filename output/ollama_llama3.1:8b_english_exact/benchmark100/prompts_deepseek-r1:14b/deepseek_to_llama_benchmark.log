---
- name: Configure Docker
  hosts: all

  tasks:
  - name: Remove old Docker versions
    package_manager:
      name: "{{ item }}"
      state: absent
    loop: "{{ docker_obsolete_packages }}"

  - name: Add Docker GPG key
    apt_key:
      keyserver: '{{ docker_yum_gpg_key.server }}'
      id: '{{ docker_yum_gpg_key.id }}'
      state: present
    when: docker_add_repo

  - name: Add Docker repository
    apt_repository:
      repo: '{{ docker_yum_repo_url }}'
      state: present
      filename: 'docker-{{ docker_edition }}'
    when: docker_add_repo

  - name: Configure Docker Nightly repo
    lineinfile:
      dest: '/etc/yum.repos.d/docker-{{ docker_edition }}.repo'
      regexp: '^enabled=0'
      line: 'enabled={{ docker_yum_repo_enable_nightly }}'
    when: docker_add_repo

  - name: Configure Docker Test repo
    lineinfile:
      dest: '/etc/yum.repos.d/docker-{{ docker_edition }}.repo'
      regexp: '^enabled=0'
      line: 'enabled={{ docker_yum_repo_enable_test }}'
    when: docker_add_repo

  - name: Configure containerd on RHEL 8
    when: ansible_facts.distribution_major_version == 8
    tasks:
      - name: Remove runc package
        package:
          name: runc
          state: absent

      - name: Ensure container-selinux is installed
        package:
          name: container-selinux
          state: present

      - name: Ensure containerd.io is installed
        package:
          name: containerd.io
          state: present


