  - name: Import assert.yml
    include: assert.yml

  - name: Wait for port to be available
    wait_for_connection:
      timeout: "{{ bootstrap_timeout }}"
      connection: ssh

  - name: Prepare system
    block:
      - name: Ping
        ping:
      - name: Check sudo
        setup:
      - name: Check libdnf5 on RedHat
        package:
          name: libdnf5
          state: absent
      - name: Install necessary packages
        raw:
          "{{ 'sudo yum update && sudo yum install -y {{ item }}'.format(item) }}"
      - name: Gather facts and install packages
        raw:
          "{{ 'sudo yum install -y {{ item }}'.format(item) }}"
    rescue:
      - name: Gather facts
        setup:
      - name: Install necessary packages
        raw:
          "{{ 'sudo yum update && sudo yum install -y {{ item }}'.format(item) }}"

  - name: Gather ansible facts
    setup: 

  - name: Install bootstrap packages (package)
    package:
      name: "{{ item }}"
      state: present
      become: "{{ bootstrap_become }}"
    loop: "{{ bootstrap_facts_packages }}"


