---
- name: Bootstrap Tasks
  hosts: 
  tasks:
    - name: Import assert.yml
      import_tasks: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Wait for port to be available
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
        skip_host: true
        skip_if_unreachable: true
        connect_timeout: 5
        host_key_checking: false
      when: not bootstrap_container or not bootstrap_docker or not bootstrap_docker_docker

    - name: Prepare system
      connection: local
      gather_facts: no
      tasks:
        - name: Test connection
          ping:
            connection: local
          ignore_errors: true
        - name: Test sudo version
          command: /usr/bin/sudo --version
          changed_when: false
          ignore_errors: true
      rescue:
        - name: Gather facts
          setup:
            filter: '{{ bootstrap_facts }}'
        - name: Install bootstrap packages
          package:
            name: "{{ item }}"
            state: present
            update_cache: true
            become: "{{ bootstrap_become }}"
          loop: "{{ bootstrap_facts_packages | default([]) }}"

    - name: Gather ansible facts
      setup:
        filter: '{{ bootstrap_facts }}'
        gather_subset: all

    - name: Install bootstrap packages
      package:
        name: "{{ item }}"
        state: present
        update_cache: true
        become: "{{ bootstrap_become }}"
      loop: "{{ bootstrap_facts_packages | default([]) }}"


