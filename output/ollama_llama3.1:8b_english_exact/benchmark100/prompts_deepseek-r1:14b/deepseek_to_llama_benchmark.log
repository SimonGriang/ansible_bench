- name: Import assertion tasks
  import_tasks: assert.yml

- name: Install Python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  lineinfile:
    dest: /etc/pip.conf
    regexp: '^index-url'
    line: "index-url = {{ python_pip_proxy }}"
    state: present
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  lineinfile:
    dest: /etc/pip.conf
    regexp: '^trusted-host'
    line: "trusted-host = {{ python_pip_trusted_host }}"
    state: present
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    executable: pip3
    state: present
    update: true
  when: ansible_distribution not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

- name: Install Python modules
  pip:
    executable: pip3
    name: "{{ item }}"
    version: "{{ python_pip_modules[item] }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when: ansible_distribution not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'


