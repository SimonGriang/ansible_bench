---
- name: Task 1: Import assertion tasks
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Task 2: Install php
  apt:
    name: "{{ php_packages }}"
    state: present

- name: Task 3: Find used php.ini
  shell: "php --ini | grep 'Loaded Configuration File' | cut -d '=' -f 2-"
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Task 4: Configure php
  template:
    src: templates/php.ini.j2
    dest: /etc/php/7.4/apache2/php.ini
    mode: '0644'
  notify: Restart httpd


