---
- name: Import assertion file
  assert:
    state: present
    src: ../files/assert.yml
    dest: /tmp/assert.yml
    mode: '0644'
  delegate_to: localhost

- name: Install bash package
  package:
    name: bash
    state: present

- name: Install OpenJDK Java
  package:
    name: "{{ java_vendor }}-java"
    state: present
  when: java_vendor == "openjdk"

- name: Copy and install Oracle Java RPM package
  copy:
    src: "{{ java_source }}/java.rpm"
    dest: /tmp/java.rpm
    mode: '0644'
  when:
    - java_source == "local"
    - java_format == "rpm"
  package:
    name: java.rpm
    state: present
  when:
    - java_source == "local"
    - java_format == "rpm"

- name: Copy and install Oracle Java DEB package
  copy:
    src: "{{ java_source }}/java.deb"
    dest: /tmp/java.deb
    mode: '0644'
  when:
    - java_source == "local"
    - java_format == "deb"
  package:
    name: java.deb
    state: present
  when:
    - java_source == "local"
    - java_format == "deb"

- name: Install Oracle Java RPM package
  package:
    name: java.rpm
    state: present
  when:
    - java_source == "repository"
    - java_format == "rpm"

- name: Extract and install Oracle Java targz package
  unarchive:
    src: "{{ java_source }}/java.targz"
    dest: /usr/local/java
    compression: tar
    extra_opts: --strip=1
  when:
    - java_format == "targz"
    - java_vendor == "oracle"

- name: Install Java Cryptography Extension (JCE) policy software
  package:
    name: java-1.8.0-openjdk-jce-policy
    state: present
  when:
    - java_jce == true
    - java_version == 8
    - java_vendor == "oracle"

- name: Set Java alternative link
  file:
    path: /usr/bin/java
    state: link
    target: /usr/local/java/bin/java
  when:
    - java_format == "targz"
    - ansible_distribution != "Alpine"

- name: Determine JAVA_HOME by finding the real path of /usr/bin/java
  shell:
    cmd: readlink -f /usr/bin/java
    chdir: /usr/local/java
  register: java_home

- name: Add JAVA_HOME to /etc/profile.d/java_home.sh file
  template:
    src: templates/java_home.sh.j2
    dest: /etc/profile.d/java_home.sh
    mode: '0644'
  notify: reload profile

handlers:
  - name: reload profile
    service:
      name: profile
      state: reloaded


