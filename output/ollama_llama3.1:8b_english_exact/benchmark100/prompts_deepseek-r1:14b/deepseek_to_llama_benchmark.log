content='---\n\n\ntasks:\n  - name: Import tasks from assert.yml for validation and assertions\n    include: assert.yml\n\n  - name: Configure debconf settings for postfix on Debian systems\n    debconf: name=postfix/main_mailer_type value=Internet\n\n  - name: Install the postfix package\n    apt: name=postfix state=present\n\n  - name: Install postfix-mysql package\n    apt: name=postfix-mysql state=present\n\n  - name: Configure postfix transport maps\n    template:\n      src: templates/transport_maps.cf.j2\n      dest: /etc/postfix/transport_maps.cf\n      mode: \'0644\'\n    notify:\n      - postfix-transportmaps\n\n  - name: Configure postfix header checks\n    template:\n      src: templates/header_checks.cf.j2\n      dest: /etc/postfix/header_checks.cf\n      mode: \'0644\'\n    notify:\n      - postfix-headerchecks\n\n  - name: Set facts for postfix configuration related to recipient and sender access restrictions\n    set_fact:\n      postfix_recipient_restrictions: "reject_rbl_client example.com, reject_rbl_client example.org"\n      postfix_sender_restrictions: "reject_rbl_client example.com, reject_rbl_client example.org"\n\n  - name: Set facts for postfix configuration related to mynetworks, mydestination, relay domains, and other settings\n    set_fact:\n      postfix_mynetworks: "192.168.1.0/24, 10.1.1.0/24"\n      postfix_mydestination: "example.com, example.org"\n      postfix_relay_domains: "example.com, example.org"\n\n  - name: Configure postfix main.cf\n    template:\n      src: templates/main.cf.j2\n      dest: /etc/postfix/main.cf\n      mode: \'0644\'\n    notify:\n      - postfix-maincf\n\n  - name: Configure postfix master.cf\n    template:\n      src: templates/master.cf.j2\n      dest: /etc/postfix/master.cf\n      mode: \'0644\'\n    notify:\n      - postfix-mastercf\n\n  - name: Create directories for TLS certificates and keys\n    file:\n      path: /etc/postfix/ssl\n      state: directory\n      owner: postfix\n      group: postfix\n      mode: \'0755\'\n  - name: Create directories for TLS certificates and keys\n    file:\n      path: /etc/postfix/keys\n      state: directory\n      owner: postfix\n      group: postfix\n      mode: \'0755\'\n\n  - name: Deploy Postfix TLS server certificate\n    copy:\n      content: "{{ lookup(\'file\', \'/path/to/cert\') }}"\n      dest: /etc/postfix/ssl/cert.pem\n      mode: \'0644\'\n    notify:\n      - postfix-reload\n\n  - name: Deploy Postfix TLS server key\n    copy:\n      content: "{{ lookup(\'file\', \'/path/to/key\') }}"\n      dest: /etc/postfix/keys/key.pem\n      mode: \'0640\'\n    notify:\n      - postfix-reload\n\n  - name: Flush handlers\n    meta: flush_handlers\n\n  - name: Configure postfix aliases\n    lineinfile:\n      dest: /etc/aliases\n      line: "alias@example.com: mail@example.com"\n      state: present\n    notify:\n      - postfix-rebuild\n\n  - name: Configure sender_access\n    lineinfile:\n      dest: /etc/postfix/sender_access\n      line: "example@example.com REJECT"\n      state: present\n    notify:\n      - postfix-rebuild\n\n  - name: Configure recipient_access\n    lineinfile:\n      dest: /etc/postfix/recipient_access\n      line: "example@example.com REJECT"\n      state: present\n    notify:\n      - postfix-rebuild\n\n  - name: Copy SASL password map content\n    copy:\n      content: "{{ lookup(\'file\', \'/path/to/sasl_password_map\') }}"\n      dest: /etc/postfix/sasl_password_map\n      mode: \'0644\'\n    notify:\n      - postfix-saslpasswdmap\n\n  - name: Flush handlers again\n    meta: flush_handlers\n\n  - name: Start and enable postfix\n    service:\n      name: postfix\n      state: started\n      enabled: yes' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-20T05:20:25.880100779Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7647961684, 'load_duration': 108178667, 'prompt_eval_count': 842, 'prompt_eval_duration': 145424978, 'eval_count': 899, 'eval_dur