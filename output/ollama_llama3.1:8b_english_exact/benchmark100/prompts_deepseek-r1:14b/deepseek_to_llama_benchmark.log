- name: Import assert.yml
  include: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - path: '/var/named/chroot/etc/named.conf'
