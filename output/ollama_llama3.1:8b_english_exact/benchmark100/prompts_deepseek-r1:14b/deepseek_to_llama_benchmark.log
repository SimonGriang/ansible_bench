---
- name: Configure and enable virtual host
  vars:
    httpd_vhosts_directory: /etc/apache2/sites-available
  tasks:
  - name: Create docroot directories for each virtual host
    file:
      path: "{{ item.documentroot }}"
      state: directory
      mode: '0755'
    when: item.documentroot is defined and httpd_vhosts is defined and (not create_docroot or item.documentroot is defined)
    loop: "{{ httpd_vhosts }}"
  - name: Configure virtual host settings
    template:
      src: vhost_conf_template
      dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
      mode: '0644'
    loop: "{{ httpd_vhosts }}"
  - name: Enable virtual hosts on Debian systems
    shell:
      cmd: a2ensite {{ item.name }}
      creates: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf-enabled"
    when: ansible_os_family == 'Debian'
    notify:
      - Test httpd configuration validity
      - Restart httpd
    loop: "{{ httpd_vhosts }}"


