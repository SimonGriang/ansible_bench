- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke_airgap_dir }}/{{ rke_version }}/rke-{{ rke_version }}-checksums.txt"
    dest: "{{ rke_airgap_dir }}/{{ rke_version }}/rke-{{ rke_version }}-checksums.txt"
    mode: '0644'
  when: rke_airgap_mode and rke_exists_implementation

- name: Airgap mode - additional images tarballs
  file:
    path: "{{ rke_airgap_dir }}/{{ rke_version }}-artifacts/images"
    state: directory
  when: rke_airgap_mode and rke_additional_tarballs

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ rke_airgap_dir }}/{{ rke_version }}/images.tar.gz"
    dest: "{{ rke_airgap_dir }}/{{ rke_version }}/images.tar.gz"
  when: rke_airgap_mode and rke_additional_tarballs

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke_airgap_dir }}/{{ rke_version }}-artifacts"
    state: directory
    mode: '0700'
  when: rke_airgap_mode and rke_exists_implementation

- name: Populate service facts
  setup:
    gather_facts: true

