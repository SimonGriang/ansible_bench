      mode: '600'
      owner: root
      group: root

  - name: Generate a Certificate Signing Request (CSR)
    openssl_csr:
      path: /path/to/ssl/csr.pem
      private_key_path: /path/to/ssl/key.pem
      state: present
      csr_extensions:
        - subjectAltName=DNS:example.com,DNS:www.example.com
      mode: '644'
      owner: root
      group: root

  - name: Generate a self-signed SSL certificate
    openssl_certificate:
      path: /path/to/ssl/cert.pem
      private_key_path: /path/to/ssl/key.pem
      csr_path: /path/to/ssl/csr.pem
      state: present
      provider: selfsigned
      mode: '644'
      owner: root
      group: root

  - name: Create a PKCS#12 file
    openssl_pkcs12:
      path: /path/to/ssl/pkcs12.p12
      privatekey_path: /path/to/ssl/key.pem
      certificates: /path/to/ssl/cert.pem
      state: present
      mode: '644'
      owner: root
      group: root

  - name: Read the private key content
    slurp:
      content: /path/to/ssl/key.pem
      dest: /path/to/ssl/key_content

  - name: Read the certificate content
    slurp:
      content: /path/to/ssl/cert.pem
      dest: /path/to/ssl/cert_content

  - name: Combine private key and certificate into a single file
    copy:
      content: "{{ lookup('file', '/path/to/ssl/key_content') }}{{ lookup('file', '/path/to/ssl/cert_content') }}"
      dest: /path/to/ssl/combined.pem
      mode: '644'
      owner: root
      group: root

