---
- name: Import assert.yml
  include: assert.yml
  run_once: true
  delegate_to: localhost

- name: Manage automatic service management
  block:
    - name: Manage apt_autostart_state
      when: ansible_distribution == 'Ubuntu'
      block:
        - name: Copy policy-rc.d file when apt_autostart_state is disabled
          copy:
            content: "exit 101"
            dest: /usr/sbin/policy-rc.d
            mode: '0755'
          when: apt_autostart_state == 'disabled'
        - name: Remove policy-rc.d file when apt_autostart_state is enabled
          file:
            path: /usr/sbin/policy-rc.d
            state: absent
          when: apt_autostart_state == 'enabled'

