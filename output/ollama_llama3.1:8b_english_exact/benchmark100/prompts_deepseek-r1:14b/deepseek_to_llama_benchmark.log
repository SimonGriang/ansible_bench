---
- name: Check and configure Java certificates
  tasks:
    - name: Check if Java certificates exist
      stat:
        path: "{{ item }}"
        state: file
      loop: "{{ java_certs }}"
      register: java_certs_status
    - name: Fail if Java certificates are missing
      fail:
        msg: "Missing Java certificate: {{ item.path }}"
      loop: "{{ java_certs_status.results | rejectattr('stat.exists', 'equal_to', true) }}"

    - name: Set keystore directory for Java versions less than 11
      set_fact:
        java_keystore_dir: "{{ keystore_legacy_dir }}"

    - name: Set keystore directory for Java versions 11 or newer
      set_fact:
        java_keystore_dir: "{{ keystore_new_dir }}"

    - name: Import SSL certificates into Java keystore
      java_key_store:
        state: present
        path: "{{ java_keystore_dir }}"
        keystore_password: "{{ keystore_password }}"
        key_password: "{{ key_password }}"
        aliases:
          "{{ item.alias }}": "{{ item.path }}"
        key_store_properties:
          "{{ item.alias }}": "{{ item.alias }}"
        loop: "{{ java_certs }}"
      notify: "Import SSL certificates into Java keystore"

