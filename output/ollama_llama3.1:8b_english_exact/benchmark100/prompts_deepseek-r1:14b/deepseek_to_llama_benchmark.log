---
- name: Create /etc/openvpn/easy-rsa directory with correct permissions
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize OpenVPN PKI structure
  ansible.builtin.command:
    cmd: easyrsa init-pki
    chdir: /etc/openvpn/easy-rsa
  register: easyrsa_init_pki_result
  changed_when: False

- name: Generate OpenVPN CA certificate
  ansible.builtin.command:
    cmd: easyrsa build-ca
    chdir: /etc/openvpn/easy-rsa
    executable: /usr/bin/easyrsa
  environment:
    EASYRSA_BATCH: 'yes'
    EASYRSA_ALGO: rsa
    EASYRSA_DIGEST: sha256
  changed_when: False

- name: Generate Diffie-Hellman parameters
  ansible.builtin.command:
    cmd: easyrsa gen-dh
    chdir: /etc/openvpn/easy-rsa
  changed_when: False

- name: Generate server certificate
  ansible.builtin.command:
    cmd: easyrsa build-server-full
    chdir: /etc/openvpn/easy-rsa
    executable: /usr/bin/easyrsa
  environment:
    EASYRSA_BATCH: 'yes'
    EASYRSA_ALGO: rsa
    EASYRSA_DIGEST: sha256
  changed_when: False

- name: Generate client certificate
  ansible.builtin.command:
    cmd: easyrsa build-client-full
    chdir: /etc/openvpn/easy-rsa
    executable: /usr/bin/easyrsa
  environment:
    EASYRSA_BATCH: 'yes'
    EASYRSA_ALGO: rsa
    EASYRSA_DIGEST: sha256
  changed_when: False

- name: Generate Certificate Revocation List
  ansible.builtin.command:
    cmd: easyrsa gen-crl
    chdir: /etc/openvpn/easy-rsa
  changed_when: False

- name: Generate OpenVPN TA key
  ansible.builtin.command:
    cmd: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy PKI files to /etc/openvpn/server directory
  ansible.builtin.copy:
    content: ''
    dest: /etc/openvpn/server/{{ item }}
    mode: '0640'
  loop:
    - ca.crt
    - crl.pem
    - dh2048.pem
    - index.txt
    - index.txt.attr
    - serial
    - server.crt
    - server.key

- name: Copy additional PKI files to /etc/openvpn directory
  ansible.builtin.copy:
    content: ''
    dest: /etc/openvpn/{{ item }}
    mode: '0640'
  loop:
    - ta.key

- name: Place OpenVPN server configuration file
  ansible.builtin.template:
    src: templates/server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: '0640'
  notify:
    - restart openvpn
  changed_when: False

