---
- name: Include assert.yml
  include: assert.yml

- name: Configure apk
  apt:
    cache_valid_time: 0
    full_upgrade: yes
    state: present

- name: Configure apt
  apt:
    upgrade_recommends: no
    cache_valid_time: 0
    full_upgrade: yes

- name: Update all software (dnf)
  dnf:
    update_cache: yes
    state: present
    exclude: 'kernel*'

- name: Update all software (pacman)
  pacman:
    update_cache: yes

- name: Configure yum
  block:
    - when: ansible_distribution in ['CentOS', 'RedHat']
      apt:
        cache_valid_time: 0
        full_upgrade: yes
        state: present
    - yum:
        update_cache: yes
      yum-utils:
        name: yum-utils
        state: present

- name: Update all software (zypper)
  zypper:
    update: yes
    state: present


