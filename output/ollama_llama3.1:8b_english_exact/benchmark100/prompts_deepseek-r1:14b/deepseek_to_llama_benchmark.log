        - "{{ item2 }}"
      when: "'Debian' in ansible_distribution"
    - name: Install packages
      package:
        name: "{{ item }}"
        state: present
      loop:
        - "{{ item }}"
        - "{{ item2 }}"
      when: "'RedHat' in ansible_distribution"

