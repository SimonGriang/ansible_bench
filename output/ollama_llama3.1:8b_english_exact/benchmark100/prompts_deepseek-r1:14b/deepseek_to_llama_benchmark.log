duration': 131133128, 'prompt_eval_count': 1452, 'prompt_eval_duration': 35710300, 'eval_count': 442, 'eval_duration': 4444969083, 'model_name': 'llama3.1:8b'} id='run--3bcc3e15-af83-437d-8ce3-6e06e7ec6ede-0' usage_metadata={'input_tokens': 1452, 'output_tokens': 442, 'total_tokens': 1894}
