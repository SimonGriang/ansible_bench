---
- name: Logrotate Configuration
  hosts: []
  tasks:

  - name: Import assertion tasks
    assert:
      module_path: ../assert.yml

  - name: Install logrotate
    package:
      name: "{{ logrotate_packages }}"

  - name: Configure logrotate
    template:
      src: logrotate_config_file.j2
      dest: "{{ logrotate_config_dir }}"
      mode: '0644'

  - name: Generate logrotate.d files
    template:
      src: "{{ item.template }}"
      dest: "{{ logrotate_config_dir }}/logrotate.d/{{ item.name }}"
      mode: '0644'
    loop: "{{ logrotate_entries }}"
    when: item.absent == false

  - name: Remove logrotate.d files
    file:
      path: "{{ logrotate_config_dir }}/logrotate.d/{{ item.name }}"
      state: absent
    loop: "{{ logrotate_entries }}"
    when: item.absent == true

  - name: Start logrotate
    service:
      name: "{{ logrotate_service }}"
      state: "{{ logrotate_service_state }}"
      enabled: "{{ logrotate_service_enabled }}"
    when: logrotate_service is defined


