  - name: RedHat pre-requisites
    when: ansible_distribution == "RedHat"
    block:
      - name: Add key repositories
        rpm_key:
          state: present
          key: "https://raw.githubusercontent.com/adoptopenjdk/deb-rpm-producer/master/templates/adoptopenjdk.key"
