---
- name: RKE2 configuration tasks
  tasks:
  - name: Create the RKE2 configuration directory
    file:
      path: /etc/rke2
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Set server taints
    set_fact:
      server_taints: "node-role.kubernetes.io/master=true:NoExecute"

  - name: Set agent taints
    set_fact:
      agent_taints: "node-role.kubernetes.io/agent=true:NoExecute"

  - name: Copy RKE2 configuration file
    template:
      src: templates/rke2.yaml.j2
      dest: /etc/rke2/config.yaml
      owner: root
      group: root
      mode: '0644'
    notify:
      - Restart RKE2

  - name: Copy Kubelet configuration file
    template:
      src: templates/kubelet.yaml.j2
      dest: /etc/systemd/system/kubelet.service.d/10-kubelet.conf
      owner: root
      group: root
      mode: '0644'
    when: kubelet_config
    notify:
      - Restart Kubelet

  - name: Copy Containerd Registry Configuration file
    template:
      src: templates/daemon.json.j2
      dest: /etc/containerd/config.toml
      owner: root
      group: root
      mode: '0644'
    when: containerd_registry
    notify:
      - Restart Containerd

  - name: Start RKE2 service on other nodes
    service:
      name: rke2
      state: started
      enabled: yes
    when: not ansible_distribution == 'Ubuntu'
    notify:
      - Restart RKE2

  - name: Mask other RKE2 services on nodes
    file:
      path: /etc/systemd/system/rke2-agent.service
      state: absent
    when: node_type == 'agent'
    notify:
      - Restart RKE2

  - name: Mask other RKE2 services on nodes
    file:
      path: /etc/systemd/system/rke2-server.service
      state: absent
    when: node_type == 'server'
    notify:
      - Restart RKE2

  - name: Wait for remaining nodes to be ready - no CNI
    wait_for:
      host: "{{ item }}"
      port: 22
      delay: 1
      timeout: 300
      state: started
    with_items: "{{ groups['all'] }}"
    when: not cni_config

  - name: Wait for remaining nodes to be ready - with CNI
    wait_for:
      host: "{{ item }}"
      port: 22
      delay: 1
      timeout: 300
      state: started
    with_items: "{{ groups['all'] }}"
    when: cni_config

  handlers:
  - name: Restart RKE2
    service:
      name: rke2
      state: restarted

  - name: Restart Kubelet
    service:
      name: kubelet
      state: restarted

  - name: Restart Containerd
    service:
      name: containerd
      state: restarted


