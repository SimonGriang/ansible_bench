---
- name: Tasks to configure git repositories
  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Install git
    apt:
      name: git
      state: present

  - name: Check if user exists
    user:
      name: gituser
      state: present

  - name: Create git config directory
    file:
      path: /home/gituser/.gitconfig
      state: directory
      mode: '0755'

  - name: Place git configuration
    template:
      src: templates/gitconfig.j2
      dest: /home/gituser/.gitconfig
      mode: '0600'

  - name: Create repository destination
    file:
      path: /home/gituser/repositories
      state: directory
      mode: '0755'

  - name: Clone all repositories
    git:
      repo: https://github.com/user/repository.git
      dest: /home/gituser/repositories
      version: master
      update: true
      clone: yes


