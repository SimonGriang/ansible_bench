---
- name: Gather raw OS facts
  raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  changed_when: no

- name: Extract and set OS distribution facts
  set_fact:
    bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_findall('PRETTY_NAME=(.*)' ) | first }}"
    bootstrap_distribution_major_version: "{{ bootstrap_distribution | regex_findall('VERSION_ID=(.*)' ) | first | split('=')[1] | split('.')[0] }}"
  become: true
  when: bootstrap_distribution is defined

- name: Map the OS family based on the determined distribution
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  become: true
  when: bootstrap_distribution is defined
  loop: "{{ bootstrap__os_family_map }}"


