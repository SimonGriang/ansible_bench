---
- name: Restart RKE2 service on {{ rke2_node_name}}
  service:
    name: rke2
    state: restarted
    enabled: true
  notify:
    - Service (re)started

- name: Wait for all nodes to be ready again
  block:
    - block:
        - kubectl:
            cmd: get node --field-selector status.phase=Ready
          delegate_to: "{{ rke2_node_name if ansible_check_mode == 'false' else 'localhost' }}"
          retry:
            attempts: 100
            delay: 15
        - kubectl:
            cmd: get node --field-selector status.phase=Ready
          delegate_to: "{{ rke2_node_name if ansible_check_mode == 'false' else 'localhost' }}"
          retry:
            attempts: 100
            delay: 15
      when: ansible_check_mode == 'false'
      run_once: true

- name: Wait for all pods to be ready again
  block:
    - block:
        - kubectl:
            cmd: get pod --all-namespaces --field-selector status.phase=Running
          delegate_to: "{{ rke2_node_name if ansible_check_mode == 'false' and rke2_wait_for_all_pods_to_be_ready == 'true' else 'localhost' }}"
          retry:
            attempts: 100
            delay: 15
        - kubectl:
            cmd: get pod --all-namespaces --field-selector status.phase=Running
          delegate_to: "{{ rke2_node_name if ansible_check_mode == 'false' and rke2_wait_for_all_pods_to_be_ready == 'true' else 'localhost' }}"
          retry:
            attempts: 100
            delay: 15
      when: ansible_check_mode == 'false' and rke2_wait_for_all_pods_to_be_ready == 'true'
      run_once: true


