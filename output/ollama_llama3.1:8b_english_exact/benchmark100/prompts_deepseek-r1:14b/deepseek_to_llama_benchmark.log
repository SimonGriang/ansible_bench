---

- name: Include tasks for installing Keepalived when HA mode is enabled
  ansible.builtin.include_tasks: tasks/keepalived.yml

- name: Download and install RKE2
  ansible.builtin.apt:
    name: rke2
    state: present
  when: rke2_version is defined
  notify: rke2 service restart

- name: Include tasks for CIS hardening
  ansible.builtin.include_tasks: tasks/cis.yml
  when: cis_profile is defined

- name: Include tasks to find active server
  ansible.builtin.include_tasks: tasks/find_active_server.yml

- name: Enable IPVS kernel module
  ansible.builtin.modprobe:
    name: ipvs
  when:
    - ha_mode is enabled
    - ha_mode is 'active-passive'
  notify: ipvs module loaded

- name: Include tasks to copy kube-vip manifests
  ansible.builtin.include_tasks: tasks/copy_kube_vip_manifests.yml
  when:
    - ha_mode is enabled
    - ha_mode is 'active-passive'

- name: Include tasks to copy ingress-nginx manifests
  ansible.builtin.include_tasks: tasks/copy_ingress_nginx_manifests.yml
  when: ingress_nginx_values is defined

- name: Include tasks to prepare the first server node
  ansible.builtin.include_tasks: tasks/prepare_first_server_node.yml
  when: first_server_node is defined

- name: Include tasks for etcd restore
  ansible.builtin.include_tasks: tasks/etcd_restore.yml
  when:
    - etcd_restore is enabled
    - etcd_snapshot is defined

- name: Include tasks to download kubeconfig
  ansible.builtin.include_tasks: tasks/download_kubeconfig.yml
  when: download_kubeconfig is enabled

- name: Include tasks to join remaining nodes
  ansible.builtin.include_tasks: tasks/join_remaining_nodes.yml
  when: active_server is defined

- name: Include tasks for rolling restart of servers
  ansible.builtin.include_tasks: tasks/rolling_restart_servers.yml
  when: rolling_restart_servers is enabled

- name: Include tasks for rolling restart of agents
  ansible.builtin.include_tasks: tasks/rolling_restart_agents.yml
  when: rolling_restart_agents is enabled

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Include tasks for rolling restart when config changes
  ansible.builtin.include_tasks: tasks/rolling_restart_config_changes.yml
  when: rolling_restart_config_changes is enabled

- name: Include tasks for final steps
  ansible.builtin.include_tasks: tasks/final_steps.yml

