---
- name: Configure and start Redis
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

  tasks:
  - name: Enable Redis module stream for RHEL 8
    dnf:
      name: redis-modules
      state: present

  - name: Install Redis package
    package:
      name: "{{ redis_packages[ansible_distribution] }}"
      state: present

  - name: Configure Redis settings
    template:
      src: "redis.conf-{{ ansible_distribution }}.j2"
      dest: "/etc/redis/redis.conf"
      mode: "{{ redis_mode }}"
    notify: restart redis

    become: true

  - name: Configure ownership, group, and mode
    file:
      path: "/etc/redis/redis.conf"
      owner: "{{ redis_owner }}"
      group: "{{ redis_group }}"
      mode: "{{ redis_mode }}"

  - name: Start and enable Redis service
    service:
      name: "{{ redis_service }}"
      state: started
      enabled: true


