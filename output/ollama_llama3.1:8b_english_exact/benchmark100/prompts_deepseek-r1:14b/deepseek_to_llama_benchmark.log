---

- name: Import assert.yml
  include: assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when: selinux_status is defined and (connection_type != 'container' and connection_type != 'docker' and connection_type != 'community.docker.docker')
  block:
    - name: Manage SELinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Manage SELinux booleans
      selinux_booleans:
        booleans: "{{ selinux_booleans }}"
        state: present
        persistent: yes
        label: "{{ item.name }}"
      when: selinux_booleans is defined
      loop: "{{ selinux_booleans }}"

