---

- name: Create the RKE2 config directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    rke2_server_node_taints: "node-role.kubernetes.io/rke2-server=true"

- name: Copy RKE2 configuration file
  copy:
    content: '{{ rke2_config | to_nice_json }}'
    dest: /etc/rke2/config.yaml
    mode: '0644'
    notify: restart rke2

- name: Copy kubelet configuration file
  copy:
    content: '{{ rke2_kubelet_config | to_nice_json }}'
    dest: /etc/systemd/system/kubelet.service.d/10-rke2.conf
    mode: '0644'
    when: rke2_kubelet_config is defined
    notify: restart kubelet

- name: Copy Containerd Registry Configuration file
  copy:
    content: '{{ rke2_registry_config | to_nice_json }}'
    dest: /etc/containerd/config.toml
    mode: '0644'
    when: rke2_registry_config is defined
    notify: restart containerd

- name: Register etcd restore from file
  set_fact:
    etcd_restore_from_file: true
  when: snapshot_file is defined and rke2_service.status == 'active'

- name: Register etcd restore from S3
  set_fact:
    etcd_restore_from_s3: true
  when: rke2_s3_options is defined and rke2_s3_options.bucket is defined and rke2_s3_options.endpoint is defined

- name: Restore etcd from file
  block:
    - name: Create directories
      file:
        path: /etc/etcd
        state: directory
        mode: '0755'
    - name: Copy snapshot file
      copy:
        content: '{{ snapshot_file }}'
        dest: /etc/etcd/etcd-snapshot.db
        mode: '0644'
    - name: Run etcd restore command
      command: etcdctl snapshot restore /etc/etcd/etcd-snapshot.db

  when: etcd_restore_from_file

- name: Restore etcd from S3
  block:
    - name: Run etcd restore command
      command: etcdctl snapshot restore /etc/etcd/etcd-snapshot.db

  when: etcd_restore_from_s3

- name: Start RKE2 service
  service:
    name: rke2-server
    state: started
    enabled: true
  notify: restart rke2
  when: rke2_service.status == 'active'

- name: Mask RKE2 agent service
  service:
    name: rke2-agent
    state: masked
    enabled: false

- name: Wait for first server to be ready (no CNI)
  wait_for:
    host: '{{ inventory_hostname }}'
    port: 22
    connect_timeout: 5
    status: 0
    delay: 10
    timeout: 300
  when: not rke2_cni_config is defined

- name: Wait for first server to be ready (with CNI)
  wait_for:
    host: '{{ inventory_hostname }}'
    port: 22
    connect_timeout: 5
    status: 0
    delay: 10
    timeout: 300
  when: rke2_cni_config is defined

- name: Restore etcd
  block:
    - name: Clean up old nodes
      command: etcdctl member list --format=yaml
    - name: Clean up old secrets
      command: etcdctl get /registry/secrets --format=yaml

  when: (etcd_restore_from_file or etcd_restore_from_s3)

- name: Set Active Server variable
  set_fact:
    active_server: '{{ groups['rke2_cluster'] | first }}'
  delegate_to: '{{ active_server }}'
  delegate_facts: yes

