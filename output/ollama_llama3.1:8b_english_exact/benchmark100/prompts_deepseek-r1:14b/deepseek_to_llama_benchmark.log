---
- name: Import assertion tasks
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install Apache HTTPD
  apt:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux
  selinux:
    state: enabled
  when: selinux_enabled
  notify: httpd_selinux_configured

- name: Configure Apache HTTPD
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
    notify:
      - httpd_config_test
      - httpd_service_restart

- name: Activate Apache HTTPD modules | Debian
  command:
    name: a2enmod
    args: "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_distribution == 'Debian'

- name: Import SSL configuration tasks
  include_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations configuration tasks
  include_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual hosts configuration tasks
  include_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure Apache HTTPD ports
  template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
    mode: '0644'
    notify:
      - httpd_config_test
      - httpd_service_restart
  when: (ansible_distribution == 'Debian') or (ansible_distribution == 'Suse')

- name: Import directories configuration tasks
  include_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta:
    flush_handlers: yes

- name: Remove default HTML
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable Apache HTTPD
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


