---
- name: Import assertion file
  assert:
    quiet: true
    msg: "{{ lookup('file', 'assert.yml') }}"

- name: Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell
  lineinfile:
    dest: /etc/crontab
    regexp: '^SHELL='
    line: SHELL=/bin/bash
    notify: restart cron

- name: Configure cron path
  lineinfile:
    dest: /etc/crontab
    regexp: '^PATH='
    line: PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    notify: restart cron

- name: Configure cron mailto
  lineinfile:
    dest: /etc/crontab
    regexp: '^MAILTO='
    line: MAILTO=root
    notify: restart cron

- name: Start and enable cron service
  service:
    name: cron
    enabled: true
    state: started
  when: cron_service is defined and cron_service != ''

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    dayOfWeek: "{{ item.dayOfWeek }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"

