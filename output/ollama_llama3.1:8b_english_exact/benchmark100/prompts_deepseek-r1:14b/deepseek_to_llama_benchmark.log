    enabled: true
  notify: restart rke2
  when: rke2_service.status == 'active'

- name: Mask RKE2 agent service
  service:
    name: rke2-agent
    state: masked
    enabled: false

- name: Wait for first server to be ready (no CNI)
  wait_for:
    host: '{{ inventory_hostname }}'
    port: 22
    connect_timeout: 5
    status: 0
    delay: 10
    timeout: 300
  when: not rke2_cni_config is defined

- name: Wait for first server to be ready (with CNI)
  wait_for:
    host: '{{ inventory_hostname }}'
    port: 22
    connect_timeout: 5
    status: 0
    delay: 10
    timeout: 300
  when: rke2_cni_config is defined

- name: Restore etcd
  block:
    - name: Clean up old nodes
      command: etcdctl member list --format=yaml
    - name: Clean up old secrets
      command: etcdctl get /registry/secrets --format=yaml

  when: (etcd_restore_from_file or etcd_restore_from_s3)

- name: Set Active Server variable
  set_fact:
    active_server: '{{ groups["rke2_cluster"] | first }}'
  delegate_to: '{{ active_server }}'
  delegate_facts: yes

