content='```\n---\n- name: Gather raw OS facts\n  raw:\n    cmd: cat /etc/os-release\n  register: bootstrap_facts\n  changed_when: no\n\n- name: Extract and set OS distribution facts\n  set_fact:\n    bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_findall(\'PRETTY_NAME=(.*)\' ) | first }}"\n    bootstrap_distribution_major_version: "{{ bootstrap_distribution | regex_findall(\'VERSION_ID=(.*)\' ) | first | split(\'=\')[1] | split(\'.\')[0] }}"\n  become: true\n  when: bootstrap_distribution is defined\n\n- name: Map the OS family based on the determined distribution\n  set_fact:\n    bootstrap_os_family: "{{ item.key }}"\n  become: true\n  when: bootstrap_distribution is defined\n  loop: "{{ bootstrap__os_family_map }}"\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-20T04:43:26.412796986Z', 'done': True, 'done_reason': 'stop', 'total_duration': 1591005749, 'load_duration': 95595086, 'prompt_eval_count': 446, 'prompt_eval_duration': 22901339, 'eval_count': 171, 'eval_duration': 1471959598, 'model_name': 'llama3.1:8b'} id='run--9ce22c70-38e1-42d8-aa9c-542591c3fd2a-0' usage_metadata={'input_tokens': 446, 'output_tokens': 171, 'total_tokens': 617}
