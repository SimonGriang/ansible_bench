content='---\n\n\n- name: Import assert.yml\n  import_tasks: assert.yml\n\n\n- name: Install apache httpd\n  package:\n    name: "{{ httpd_packages }}"\n    state: present\n\n\n- name: Configure selinux\n  selinux:\n    rule: allow_httpd_port\n    state: present\n  when: selinux_enabled\n\n\n- name: Configure httpd\n  template:\n    src: "{{ item.src }}"\n    dest: "{{ item.dest }}"\n    mode: \'0644\'\n  notify:\n    - httpd configuration test\n    - httpd service restart\n  loop:\n    - { src: \'httpd.conf.j2\', dest: \'/etc/httpd/conf/httpd.conf\' }\n\n\n- name: Activate httpd module | Debian\n  command:\n    name: a2enmod\n    args: "{{ item }}"\n  loop: "{{ httpd_modules | default([]) }}"\n  when: ansible_distribution == \'Debian\'\n\n\n- name: Import ssl.yml\n  import_tasks: ssl.yml\n  when: ssl_enabled\n\n\n- name: Import locations.yml\n  import_tasks: locations.yml\n  when: locations_defined\n\n\n- name: Import vhosts.yml\n  import_tasks: vhosts.yml\n  when: vhosts_defined\n\n\n- name: Configure ports\n  template:\n    src: "ports.conf.j2"\n    dest: "/etc/httpd/conf.d/ports.conf"\n  notify:\n    - httpd configuration test\n    - httpd service restart\n  when: (ansible_distribution == \'Debian\') or (ansible_distribution == \'SUSE\')\n\n\n- name: Import directories.yml\n  import_tasks: directories.yml\n  when: directories_defined\n\n\n- name: Flush handlers\n  meta:\n    flush_handlers: yes\n\n\n- name: Removing default html\n  file:\n    path: /var/www/html/index.html\n    state: absent\n  when: httpd_remove_example\n\n\n- name: Start and enable httpd\n  service:\n    name: httpd\n    state: started\n    enabled: yes' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-20T05:08:08.45377132Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3639133815, 'load_duration': 85428005, 'prompt_eval_count': 693, 'prompt_eval_duration': 132381328, 'eval_count': 422, 'eval_duration': 3420659651, 'model_name': 'llama3.1:8b'} id