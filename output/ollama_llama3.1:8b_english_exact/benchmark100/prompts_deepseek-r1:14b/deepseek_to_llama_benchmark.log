  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - path: '/var/named/chroot/etc/named.conf'
      mode: '0755'
      owner: 'root'
      group: 'root'
    - path: '/var/named/chroot/etc/named'
      mode: '0755'
      owner: 'root'
      group: 'root'

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    system: yes
    state: present

- name: Generate rndc key
  command: rndc-keygen -a -r /dev/urandom -k "{{ config_dir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ config_dir }}/rndc.key"
    owner: "root"
    group: "root"
    mode: "0600"

- name: Get the hints/root file
  get_url:
    url: "https://www.internic.net/domain/named.root"
    dest: "{{ config_dir }}/named.root"
    mode: '0644'
