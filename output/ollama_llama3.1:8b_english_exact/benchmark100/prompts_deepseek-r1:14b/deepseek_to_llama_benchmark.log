---

- name: Vault Server setup
  hosts: vault
  become: yes

  tasks:
    - name: Ensure vault user exists
      user:
        name: vault
        group: vault
        create_home: yes
        append: yes
        state: present

    - name: Ensure vault group exists
      group:
        name: vault
        state: present

    - name: Copy vault repository
      git:
        repo: https://github.com/hashicorp/vault.git
        dest: /opt/vault
        update: yes

    - name: Copy vault systemd service
      template:
        src: templates/vault.service.j2
        dest: /etc/systemd/system/vault.service
        mode: '0644'

    - name: Enable and start vault service
      service:
        name: vault
        enabled: yes
        state: started

    - name: Create vault data directory
      file:
        path: /opt/vault/data
        state: directory
        mode: '0750'
        owner: vault
        group: vault

    - name: Create vault logs directory
      file:
        path: /opt/vault/logs
        state: directory
        mode: '0750'
        owner: vault
        group: vault

    - name: Configure vault
      shell: |
        /opt/vault/bin/vault operator init -address="0.0.0.0:8200" -key=" {{ vault_key }}" > /dev/null 2>&1
        /opt/vault/bin/vault operator unseal -address="0.0.0.0:8200" -key=" {{ vault_key }}" > /dev/null 2>&1
      args:
        chdir: /opt/vault
      delegate_to: vault

    - name: Configure Vault TLS
      template:
        src: templates/vault.hcl.j2
        dest: /opt/vault/config/vault.hcl
        mode: '0644'

    - name: Configure Vault CA
      template:
        src: templates/vault_ca.hcl.j2
        dest: /opt/vault/config/vault_ca.hcl
        mode: '0644'

    - name: Configure Vault server
      template:
        src: templates/vault_server.hcl.j2
        dest: /opt/vault/config/vault_server.hcl
        mode: '0644'

    - name: Configure Vault UI
      template:
        src: templates/vault_ui.hcl.j2
        dest: /opt/vault/config/vault_ui.hcl
        mode: '0644'

    - name: Configure Vault AppRole auth
      template:
        src: templates/vault_auth_approle.hcl.j2
        dest: /opt/vault/config/vault_auth_approle.hcl
        mode: '0644'

    - name: Configure Vault Userpass auth
      template:
        src: templates/vault_auth_userpass.hcl.j2
        dest: /opt/vault/config/vault_auth_userpass.hcl
        mode: '0644'

    - name: Configure Vault AWS auth
      template:
        src: templates/vault_auth_aws.hcl.j2
        dest: /opt/vault/config/vault_auth_aws.hcl
        mode: '0644'

    - name: Configure Vault LDAP auth
      template:
        src: templates/vault_auth_ldap.hcl.j2
        dest: /opt/vault/config/vault_auth_ldap.hcl
        mode: '0644'

    - name: Configure Vault Kubernetes auth
      template:
        src: templates/vault_auth_kubernetes.hcl.j2
        dest: /opt/vault/config/vault_auth_kubernetes.hcl
        mode: '0644'

    - name: Configure Vault AppRole role
      template:
        src: templates/vault_approle_role.hcl.j2
        dest: /opt/vault/config/vault_approle_role.hcl
        mode: '0644'

    - name: Configure Vault Userpass role
      template:
        src: templates/vault_userpass_role.hcl.j2
        dest: /opt/vault/config/vault_userpass_role.hcl
        mode: '0644'

    - name: Configure Vault AWS role
      template:
        src: templates/vault_aws_role.hcl.j2
        dest: /opt/vault/config/vault_aws_role.hcl
        mode: '0644'

