---
- name: Task 1: Import assert.yml
  include_tasks: assert.yml

- name: Task 2: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Task 3: Configure mysql server
  template:
    src: mysql-server.conf.j2
    dest: /etc/my.cnf
    mode: '0644'
  loop: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Task 4: Configure mysql client
  template:
    src: mysql-client.conf.j2
    dest: /etc/mysql/client.cnf
    mode: '0644'

- name: Task 5: Initialize mysql
  when: ansible_distribution in ['Alpine', 'Archlinux']
  mysql_db:
    name: mysql
    state: present

- name: Task 6: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Task 7: Place my.cnf
  template:
    src: templates/my.cnf.j2
    dest: /etc/my.cnf
    mode: '0644'

- name: Task 8: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Task 9: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Task 10: Flush handlers again
  meta: flush_handlers


