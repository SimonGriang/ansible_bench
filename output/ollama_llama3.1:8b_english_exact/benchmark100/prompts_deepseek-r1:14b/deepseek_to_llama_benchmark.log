---
- name: Import tasks from assert.yml and run them once on localhost
  import_tasks: assert.yml

- name: Install packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ service_required_packages }}"
  notify: Gather facts

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: /etc/systemd/system/{{ item.name }}.service
    mode: '0644'
  loop: "{{ service_list }}"
  when: item.type == 'systemd'

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: /etc/init.d/{{ item.name }}
    mode: '0755'
  loop: "{{ service_list }}"
  when: item.type == 'sysvinit'

- name: Manage service
  service:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    enabled: "{{ item.enabled }}"
    daemon_reload: yes
  loop: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers


