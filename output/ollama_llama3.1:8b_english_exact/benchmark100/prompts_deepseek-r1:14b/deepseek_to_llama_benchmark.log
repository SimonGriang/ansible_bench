---
- name: Import assert.yml
  include: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: '/var/named/chroot/etc/named.conf', mode: '0755', owner: 'root', group: 'root' }
    - { path: '/var/named/chroot/etc/named', mode: '0755', owner: 'root', group: 'root' }

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    system: yes
    state: present

- name: Generate rndc key
  command: rndc-keygen -a -r /dev/urandom -k {{ config_dir }}/rndc.key

- name: Set permissions on rndc key file
  file:
    path: "{{ config_dir }}/rndc.key"
    owner: "root"
    group: "root"
    mode: "0600"

- name: Get the hints/root file
  get_url:
    url: "https://www.internic.net/domain/named.root"
    dest: "{{ config_dir }}/named.root"
    mode: '0644'
  when: dns_caching_dns

- name: Create zone file
  template:
    src: "named.{{ zone }}.j2"
    dest: "{{ config_dir }}/{{ zone }}.zone"
    mode: '0644'
  notify: Rndc reload

  when: dns_zones | in (item)
  loop: "{{ dns_zones }}"
  loop_control:
    loop_var: zone

- name: Add zones to configuration
  template:
    src: "named.conf.j2"
    dest: "{{ config_dir }}/named.conf"
    mode: '0644'
  notify: Restart dns

- name: Place systemd override
  template:
    src: "systemd.conf.j2"
    dest: "/etc/systemd/system/dns.service.d/override.conf"
    mode: '0644'
  when: using_systemd

  notify: reload systemd

- name: Start and enable dns
  service:
    name: dns
    state: started
    enabled: yes
    daemon_reload: yes


