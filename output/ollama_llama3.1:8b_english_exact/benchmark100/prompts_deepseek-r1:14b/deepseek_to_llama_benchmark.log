---
- name: Configuration Tasks
  hosts: localhost
  gather_facts: no

  tasks:
  - name: Import assertion file
    include: assert.yml
    delegate_to: localhost

  - name: Install cron package
    package:
      name: "{{ cron_packages }}"
      state: present

  - name: Configure cron shell environment
    lineinfile:
      dest: /etc/crontab
      regexp: '^SHELL'
      line: 'SHELL=/bin/bash'
      state: present

  - name: Configure cron path environment
    lineinfile:
      dest: /etc/crontab
      regexp: '^PATH'
      line: 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
      state: present

  - name: Configure cron mailto settings
    lineinfile:
      dest: /etc/crontab
      regexp: '^MAILTO'
      line: 'MAILTO=root'
      state: present

  - name: Start and enable cron service
    service:
      name: cron
      state: started
      enabled: True
    when: cron_service is defined

  - name: Schedule cron jobs
    cron:
      name: "{{ item.name }}"
      minute: "{{ item.minute }}"
      hour: "{{ item.hour }}"
      job: "{{ item.job }}"
      user: "{{ item.user }}"
    loop: "{{ cron_jobs }}"


