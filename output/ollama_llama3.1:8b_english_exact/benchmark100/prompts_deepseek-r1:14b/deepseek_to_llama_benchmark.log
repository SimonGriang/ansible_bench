---
- name: Include OS-specific variables
  include_vars: "{{ lookup('ansible.builtin.file', 'vars/{{ ansible_distribution }}.yml') }}"

- name: Include OS family specific tasks
  include_tasks: "tasks/{{ ansible_distribution_family }}.yml"

- name: Install Docker packages
  when: (ansible_version | version_compare('2.12', '<')) and (ansible_distribution | lower != 'redhat' and ansible_distribution | lower != 'debian')
  apt:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    notify: restart docker
    ignore_errors: yes

- name: Install Docker packages with downgrade option
  when: (ansible_version | version_compare('2.12', '>=')) and (ansible_distribution | lower == 'redhat' or ansible_distribution | lower == 'debian')
  apt:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    notify: restart docker
    ignore_errors: yes
    force_apt_get: yes
    default_release: "{{ docker_downgrade_release }}"

- name: Install docker-compose plugin
  when: (docker_install_compose_plugin | bool) and (ansible_version | version_compare('2.12', '<') or (ansible_distribution | lower != 'redhat' and ansible_distribution | lower != 'debian'))
  apt:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    notify: restart docker
    ignore_errors: yes

- name: Install docker-compose-plugin with downgrade option
  when: (docker_install_compose_plugin | bool) and (ansible_version | version_compare('2.12', '>=')) and (ansible_distribution | lower == 'redhat' or ansible_distribution | lower == 'debian')
  apt:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    notify: restart docker
    ignore_errors: yes
    force_apt_get: yes
    default_release: "{{ docker_downgrade_release }}"

- name: Ensure /etc/docker directory exists
  when: docker_daemon_options is defined
  file:
    path: /etc/docker
    state: directory
    mode: '0755'

- name: Configure Docker daemon options
  when: docker_daemon_options is defined
  template:
    src: docker-daemon.json.j2
    dest: /etc/docker/daemon.json
    mode: '0644'
  notify: restart docker

- name: Ensure Docker service is started and enabled
  when: docker_service_manage | bool
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: yes

- name: Flush handlers to avoid firewall conflicts
  meta:
    flush_handlers: yes

- name: Include docker-compose.yml tasks
  include_tasks: "tasks/docker-compose.yml"
  when: docker_install_compose | bool

- name: Get docker group information
  when: (docker_users is defined and docker_users | length > 0) and ((getent group docker) is undefined)
  shell: getent group docker

- name: Set fact for user modification
  when: (docker_users is defined and docker_users | length > 0) and ((getent group docker) is undefined)
  set_fact:
    need_modify_docker_group: true

- name: Include docker-users.yml tasks
  include_tasks: "tasks/docker-users.yml"
  when: (docker_users is defined and docker_users | length > 0) and (need_modify_docker_group | bool)


