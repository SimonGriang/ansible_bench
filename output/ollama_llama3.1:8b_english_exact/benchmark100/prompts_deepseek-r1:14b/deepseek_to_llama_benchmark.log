---
- name: Enable modules
  apt:
    name: ['apache2']
    state: present
  become: true

- name: Enable proxy and proxy_http modules
  a2enmod:
    name: ['proxy', 'proxy_http']
    state: present
  become: true

- name: Configure locations
  template:
    src: 'templates/location.conf.j2'
    dest: '/etc/apache2/conf.d/location.conf'
    mode: '0644'
  notify:
    - httpd test
    - httpd restart

- name: Notify httpd configuration test and restart handlers
  notify:
    - httpd test
    - httpd restart


