---

- name: Install unzip package
  apt:
    name: unzip
    state: present

- name: Create system group for promtail
  group:
    name: promtail
    state: present
    system: yes
    append: no

- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    append: no
    create_home: no
    system: yes
    shell: /bin/false

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Create application directories
  file:
    path: /var/log/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Check promtail binary existence
  stat:
    path: /usr/local/bin/promtail
    state: file

- name: Download promtail binaries
  get_url:
    url: https://example.com/promtail-binaries.tar.gz
    dest: /tmp/promtail-binaries.tar.gz
    checksum: sha256: some-checksum

- name: Propagate local promtail binaries
  copy:
    content: /tmp/promtail-binaries.tar.gz
    dest: /usr/local/bin/promtail
    mode: '0755'

- name: Download promtail binaries for controller node
  get_url:
    url: https://example.com/promtail-binaries.tar.gz
    dest: /tmp/promtail-binaries.tar.gz
    checksum: sha256: some-checksum

- name: Propagate promtail binaries
  copy:
    content: /tmp/promtail-binaries.tar.gz
    dest: /usr/local/bin/promtail
    mode: '0755'

- name: Unpack promtail binaries
  unarchive:
    src: /usr/local/bin/promtail.tar.gz
    dest: /usr/local/bin
    compression: gzip

- name: Create symlink to latest promtail version
  file:
    path: /usr/local/bin/latest-promtail
    state: link
    link_path: /usr/local/bin/promtail

- name: Write promtail config file
  template:
    src: templates/promtail-config.j2
    dest: /etc/promtail/config.yml
    mode: '0644'
    owner: promtail
    group: promtail

- name: Create systemd service unit
  template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
    owner: root
    group: root

