--- 

- name: Assert usage of systemd as an init system
  assert:
    that: systemd_init_system == true
    msg: "System uses systemd as init system, but expected it to be true"

- name: Get latest release and set promtail version
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    return_content: true
  register: latest_release

- name: Set promtail version
  set_fact:
    promtail_version: "{{ latest_release.json.tag_name }}"

- name: Test if zip local archive exists and assert local binary exists
  stat:
    path: /path/to/local/binary/archive.zip
  register: local_archive
  when: local_binary_dir

- name: Assert local binary exists
  assert:
    that: local_archive.stat.exists == true
    msg: "Local binary archive does not exist"

- name: Get checksum list and set checksum for target architecture
  uri:
    url: https://checksums.githubusercontent.com/promtail
    method: GET
    return_content: true
  register: checksum_list

- name: Set checksum for target architecture
  set_fact:
    checksum: "{{ checksum_list.json.checksums | json_query('[@].checksums | select(@.architecture == ' + (ansible_architecture | lower) + "') | [0].checksum') }}"

