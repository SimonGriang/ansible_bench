---
- name: Install OpenJDK
  become: true

  tasks:
  - name: Migrate adoptopenjdk to temurin (if selected)
    set_fact:
      java_jdk_vendor: "temurin"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Gather OS specific variables
    include_vars:
      file: "/usr/local/share/java/{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_major_version }}.yml"

  - name: Gather architecture specific variables
    include_vars:
      file: "/usr/local/share/java/{{ java_jdk_vendor }}_{{ ansible_architecture }}.yml"

  - name: Set OS specific variables (I)
    include_vars:
      file: "/usr/local/share/java/{{ java_jdk_vendor }}_{{ ansible_distribution }}.yml"

  - name: Set OS and architecture specific variables (II)
    include_vars:
      file: "/usr/local/share/java/{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_architecture }}.yml"

  - name: Set specific variables
    set_fact:
      java_home: "/usr/lib/jvm/{{ java_jdk_vendor }}"

  - name: Debian pre-requisites
    when: ansible_distribution == "Debian"
    block:
      - name: Remove deprecated repositories
        apt:
          name: "{{ item }}"
          state: absent
        loop:
          - "openjdk-{{ java_version }}-{{ java_jdk_vendor }}-default"
          - "openjdk-{{ java_version }}-{{ java_jdk_vendor }}-default-jdk"
      - name: Install extra apt tools
        apt:
          name: "{{ item }}"
          state: present
        loop:
          - "apt-transport-https"
          - "curl"
          - "gnupg2"
      - name: Add key repositories
        apt_key:
          url: "https://raw.githubusercontent.com/adoptopenjdk/deb-rpm-producer/master/templates/adoptopenjdk.key"
          state: present
      - name: Add required repositories
        apt_repository:
          repo: "ppa:openjdk/ppa"
          state: present
          update_cache: yes

  - name: RedHat pre-requisites
    when: ansible_distribution == "RedHat"
    block:
      - name: Add key repositories
        rpm_key:
          state: present
          key: "https://raw.githubusercontent.com/adoptopenjdk/deb-rpm-producer/master/templates/adoptopenjdk.key"
      - name: Add required repositories
        yum_repository:
          name: "adoptopenjdk"
          description: "OpenJDK repository"
          url: "https://adoptopenjdk.blob.core.windows.net/adoptopenjdk/maven-repo-release"
          gpgcheck: yes
          gpgkey: "https://adoptopenjdk.blob.core.windows.net/adoptopenjdk/maven-repo-release/RPM-GPG-KEY-adoptopenjdk"

  - name: Install required libs
    package:
      name: "{{ item }}"
      state: present
    loop:
      - libc6
      - libgcc1
      - libstdc++6
      - zlib1g
      - zlib1g-dev
      - libncurses5
      - libncurses5-dev
      - libssl-dev
      - libxml2-dev
      - libxslt-dev
      - libicu-dev
      - libcurl4-openssl-dev
      - libpcre3-dev
      - libjemalloc-dev
      - libjemalloc.so
      - libjemalloc.so.4
      - libgomp1
      - libstdc++6

  - name: Install Java, Debian
    when: ansible_distribution == "Debian"
    apt:
      name: "{{ item }}"
      state: present
    loop:
      - "openjdk-{{ java_version }}-{{ java_jdk_vendor }}-default"
      - "openjdk-{{ java_version }}-{{ java_jdk_vendor }}-default-jdk"

  - name: Install Java, RedHat
    when: ansible_distribution == "RedHat"
    yum:
      name: "{{ item }}"
      state: present
    loop:
      - "java-{{ java_version }}-{{ java_jdk_vendor }}-openjdk"
      - "java-{{ java_version }}-{{ java_jdk_vendor }}-openjdk-devel"

  - name: Export environment variables
    template:
      src: templates/java.env.j2
      dest: /etc/profile.d/java.env
      mode: '0644'
    notify: reload daemon

  - name: Source environment variables
    shell: ". /etc/profile.d/java.env"

  - name: Correct java version selected for Java < 11
    when: java_version < "11"
    alternatives:
      name: java
      link: /usr/bin/java
      path: "/usr/lib/jvm/{{ java_jdk_vendor }}-{{ java_version }}/jre/bin/java"

  - name: Correct java version selected for Java >= 11
    when: java_version >= "11"
    alternatives:
      name: java
      link: /usr/bin/java
      path: "/usr/lib/jvm/{{ java_jdk_vendor }}-{{ java_version }}/bin/java"

