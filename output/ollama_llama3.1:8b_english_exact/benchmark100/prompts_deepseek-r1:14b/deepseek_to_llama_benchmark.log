---
- name: Download RKE2 installation script
  get_url:
    url: "https://github.com/rancher/rke/releases/download/{{ rke_version }}/rke-installer-{{ rke_version }}-linux-amd64"
    dest: "{{ rke_airgap_dir }}/{{ rke_version }}/rke-installer-linux-amd64"
    mode: '0700'
  when: not rke_airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke_airgap_dir }}/{{ rke_version }}/rke-installer-linux-amd64"
    dest: "{{ rke_airgap_dir }}/{{ rke_version }}/rke-installer-linux-amd64"
    mode: '0700'
  when: rke_airgap_mode

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke_airgap_dir }}/{{ rke_version }}-artifacts"
    state: directory
    mode: '0700'
  when: rke_airgap_mode and not rke_exists_implementation

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "https://github.com/rancher/rke/releases/download/{{ rke_version }}/rke-{{ rke_version }}-checksums.txt"
    dest: "{{ rke_airgap_dir }}/{{ rke_version }}/rke-{{ rke_version }}-checksums.txt"
    mode: '0644'
  when: rke_airgap_mode

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke_airgap_dir }}/{{ rke_version }}/rke-{{ rke_version }}-checksums.txt"
    dest: "{{ rke_airgap_dir }}/{{ rke_version }}/rke-{{ rke_version }}-checksums.txt"
    mode: '0644'
  when: rke_airgap_mode and rke_exists_implementation

- name: Airgap mode - additional images tarballs
  file:
    path: "{{ rke_airgap_dir }}/{{ rke_version }}-artifacts/images"
    state: directory
  when: rke_airgap_mode and rke_additional_tarballs

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ rke_airgap_dir }}/{{ rke_version }}/images.tar.gz"
    dest: "{{ rke_airgap_dir }}/{{ rke_version }}/images.tar.gz"
  when: rke_airgap_mode and rke_additional_tarballs

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke_airgap_dir }}/{{ rke_version }}-artifacts"
    state: directory
    mode: '0700'
  when: rke_airgap_mode and rke_exists_implementation

- name: Populate service facts
  setup:
    gather_facts: true

- name: Get stats of the FS object
  filesystem:
    path: /usr/local
    stat: yes

- name: Set RKE2 bin path
  set_fact:
    rke_bin_path: "/usr/local/bin/rke"
  when:
    - not rke_local_mode
    - rke_fs_stats['mountpoint'] == '/usr/local'

- name: Set RKE2 bin path
  set_fact:
    rke_bin_path: "/usr/bin/rke"
  when:
    - not rke_local_mode
    - rke_fs_stats['mountpoint'] != '/usr/local'

- name: Check RKE2 version
  shell:
    cmd: "rke version"
    register: rke_version_output
  when: rke_airgap_mode and not rke_local_mode

- name: Check RKE2 version
  shell:
    cmd: "rke version"
    register: rke_version_output
  when: rke_airgap_mode and rke_local_mode

- name: Prevent accidental RKE2 downgrade
  assert:
    that: rke_version_output.stdout | regex('^\d+\.\d+\.\d+$')
  when: rke_version_output.stdout is not undefined

- name: Run RKE2 install script
  shell:
    cmd: "{{ rke_airgap_dir }}/{{ rke_version }}/rke-installer-{{ rke_version }}-linux-amd64 install"
    environment:
      RKE_VERSION: "{{ rke_version }}"
      RKE_LOCAL_MODE: "{{ rke_local_mode }}"
      RKE_AIRGAP_MODE: "{{ rke_airgap_mode }}"
  when: not rke_airgap_mode

- name: Copy Custom Manifests
  template:
    src: templates/custom_manifests.j2
    dest: "{{ rke_manifests_dir }}/custom_manifests.yaml"
    mode: '0644'
  when: rke_custom_manifests

- name: Copy Static Pods
  template:
    src: templates/agent_pod_manifests.j2
    dest: "{{ rke_agent_pod_manifests_dir }}/agent_pod_manifests.yaml"
    mode: '0644'
  when: rke_static_pods

- name: Copy RKE2 environment file
  template:
    src: templates/rke2_env.j2
    dest: "{{ rke_env_path }}"
    mode: '0644'
  when: rke_env_options
