---

- name: MySQL setup
  tasks:
  - name: Import assertion tasks from assert.yml for local execution
    include_tasks: assert.yml

  - name: Install MySQL server packages using the specified packages variable and notify handlers for root password and systemctl daemon reexecution
    package:
      name: "{{ item }}"
      state: present
    notify:
      - mysql_root_password
      - systemd_daemon_reexec
    loop:
      - mysql-server
      - mysql-client

  - name: Configure MySQL server settings by writing options to the configuration file and notify handler for mysql server restart
    template:
      src: my.cnf.j2
      dest: /etc/my.cnf
      mode: '0644'
    notify:
      - mysql_server_restart

  - name: Configure MySQL client settings by writing the socket option to the client configuration file
    template:
      src: my.cnf.j2
      dest: /etc/my.cnf
      mode: '0644'
    notify:
      - mysql_client_restart

  - name: Initialize MySQL database on Alpine or Archlinux distributions by running the initialization command
    command: mysql_install_db --user=mysql --ldata=/var/lib/mysql
    when: ansible_distribution in [ 'Alpine', 'Archlinux' ]

  - name: Start and enable the MySQL service using the specified service name variable
    service:
      name: "{{ mysql_service }}"
      state: started
      enabled: yes

  - name: Flush all pending handlers after performing configuration tasks
    meta: flush_handlers

  - name: Create a MySQL configuration file using a template with the specified mode
    template:
      src: my.cnf.j2
      dest: /etc/my.cnf
      mode: '0644'

  - name: Create MySQL databases from the specified list, skipping if initial import is defined
    mysql_db:
      name: "{{ item }}"
      state: present
    when: initial_import is not defined
    loop:
      - "{{ item }}"
      - "{{ item }}"

  - name: Collect information about existing MySQL databases to check for existence
    mysql_db_info:
      name: "{{ item }}"
      state: present
    loop:
      - "{{ item }}"
      - "{{ item }}"

  - name: Import MySQL databases from the specified initial import location if they do not exist
    mysql_db:
      name: "{{ item }}"
      state: present
    when: db_info.state == 'absent'
    loop:
      - "{{ item }}"
      - "{{ item }}"

  - name: Create MySQL users with specified privileges and notify handler for mysql server restart
    mysql_user:
      name: "{{ item.user }}"
      password: "{{ item.password | password_hash('sha256') }}"
      priv: "{{ item.priv }}"
      state: present
    notify:
      - mysql_server_restart
    loop:
      - user: user1
        password: password1
        priv: user1.*:ALL
      - user: user2
        password: password2
        priv: user2.*:ALL

  - name: Flush all pending handlers after performing user creation tasks
    meta: flush_handlers

