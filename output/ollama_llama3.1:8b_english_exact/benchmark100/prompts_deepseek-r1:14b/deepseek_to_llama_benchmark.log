  delegate_to: localhost

- name: Wait for host to be available
  wait_for: host={{ inventory_hostname }} port=22 connect_timeout=5
  delegate_to: localhost

- name: Prepare system for bootstrap
  connection: local
  tasks:
    - name: Test connection
      ping:
    - name: Handling connection failures
      local_action: 
        module: debug
        msg: "Connection failed"
    - name: Gather facts
      setup:
    - name: Install raw bootstrap packages
      apt:
        name: "{{ item }}"
        state: present
      loop:
        - "{{ bootstrap_package }}"
        - "{{ bootstrap_package2 }}"

- name: Ensure system preparation with Ansible modules
