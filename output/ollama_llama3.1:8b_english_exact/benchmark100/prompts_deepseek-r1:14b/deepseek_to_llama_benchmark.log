---
- name: Hardening Tasks
  hosts: all
  become: yes

  tasks:
  - name: Disable swap
    shell: swapoff -a
    when: vault_hardening_disable_swap

  - name: Disable core dumps
    pam:
      name: system-auth
      module: pam_limitcore
      attribute: limit_core
      value: 0
    when: vault_hardening_disable_core_dumps

  - name: Disable Shell Command History
    lineinfile:
      path: /etc/profile.d/vault.sh
      line: 'export HISTIGNORE="*"'
    when: vault_hardening_disable_shell_command_history

  - name: Configure SELinux / AppArmor
    selinux-policy-targeted:
      state: present
    when: vault_hardening_configure_selinux_apparmor

    - name: Install selinux-policy-targeted
      yum:
        name: selinux-policy-targeted
        state: present
      when: vault_hardening_configure_selinux_apparmor

    - name: Install selinux-policy-mls
      yum:
        name: selinux-policy-mls
        state: present
      when: vault_hardening_configure_selinux_apparmor

    - name: Install libselinux-python
      yum:
        name: libselinux-python
        state: present
      when: vault_hardening_configure_selinux_apparmor

    - name: Enable AppArmor
      service:
        name: apparmor
        enabled: yes
        state: started
      when: vault_hardening_configure_selinux_apparmor


