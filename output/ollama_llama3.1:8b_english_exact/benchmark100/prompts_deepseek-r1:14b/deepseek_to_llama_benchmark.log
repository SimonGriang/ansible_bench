---

- name: Install HashiCorp product
  hosts: localhost
  tasks:
  - name: Import assertion tasks from assert.yml for validation purposes
    include_tasks: assert.yml

  - name: Install using package
    block:
      - name: Install using package (Debian/Ubuntu)
        apt:
          name: "{{ package_name }}"
          state: present
        when: ansible_distribution in ['Debian', 'Ubuntu']
      - name: Install using package (RedHat/CentOS/Fedora)
        yum:
          name: "{{ package_name }}"
          state: present
        when: ansible_distribution in ['RedHat', 'CentOS', 'Fedora']
      - name: Install using package (SUSE)
        zypper:
          name: "{{ package_name }}"
          state: present
        when: ansible_distribution in ['SUSE']
    vars:
      package_name: 'hashicorp-product'

  - name: Configure debian
    block:
      - name: Add GPG key
        apt_key:
          url: 'https://apt.hashicorp.com/gpg'
          state: present
      - name: Add apt repository
        apt_repository:
          repo: 'ppa:hashicorp/product'
          state: present

  - name: Install hashicorp product using package
    block:
      - name: Install latest version
        apt:
          name: "{{ package_name }}"
          state: present
        when: package_version == 'latest'
      - name: Install version-specific
        apt:
          name: "{{ package_name }}={{ package_version }}"
          state: present
        when: package_version != 'latest'

  - name: Install manually
    block:
      - name: Extract files
        unarchive:
          src: 'https://example.com/product.tar.gz'
          dest: '/tmp/product'
          compression: gzip
      - name: Set destination permissions
        file:
          path: '/tmp/product'
          state: directory
          mode: '0755'
      - name: Set remote source
        copy:
          content: 'https://example.com/product.tar.gz'
          dest: '/tmp/product.tar.gz'
          mode: '0644'


