    shell: openssl x509 -req -days 365 -in "/path/to/csr_directory/csr.csr" -signkey "/path/to/key_directory/private_key.pem" -out "/path/to/cert_directory/cert.crt"
    args:
      chdir: "/path/to/cert_directory"
  - name: Generate a PKCS#12 file
    shell: openssl pkcs12 -export -in "/path/to/cert_directory/cert.crt" -inkey "/path/to/key_directory/private_key.pem" -out "/path/to/key_directory/pkcs12.pkcs12" -name "Friendly Name"
    args:
      chdir: "/path/to/key_directory"
  - name: Read private key content
    shell: cat "/path/to/key_directory/private_key.pem"
    register: private_key_content
  - name: Read certificate content
    shell: cat "/path/to/cert_directory/cert.crt"
    register: certificate_content
  - name: Create a combined private key and certificate file
    file:
      path: "/path/to/key_directory/combined_key_cert.pem"
      state: touch
      mode: '0644'
    shell: |
      cat /path/to/key_directory/private_key.pem /path/to/cert_directory/cert.crt > /path/to/key_directory/combined_key_cert.pem

