--- 

- name: Install Helm
  stat:
    path: /usr/local/bin/helm
  register: helm_check

- name: Get existing Helm version
  shell:
    cmd: helm version
  register: helm_existing_version

- name: Download Helm
  unarchive:
    src: "https://get.helm.sh/helm-{{ helm_version }}-linux-amd64.tgz"
    dest: /tmp
    flag: 'gzip'
  when: helm_check.stat.exists == False or helm_existing_version.stdout != "Client version: {{ helm_version }}"
  register: helm_download

- name: Copy Helm binary into place
  copy:
    content: "{{ helm_download.content | base64decode }}"
    dest: /usr/local/bin/helm
    mode: '0755'
  when: helm_download is not undefined
  become: True

