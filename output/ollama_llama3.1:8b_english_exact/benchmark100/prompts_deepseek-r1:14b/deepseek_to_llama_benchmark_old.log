---
- name: Configure Cron
  hosts: localhost

  tasks:
  - name: Import assertion file
    include_vars: assert.yml

  - name: Install cron packages
    package:
      name: "{{ cron_packages }}"
      state: present

  - name: Configure cron shell
    lineinfile:
      path: /etc/default/cron
      line: SHELL={{ cron_shell }}
      state: present
    notify: restart cron

  - name: Configure cron path
    lineinfile:
      path: /etc/default/cron
      line: PATH={{ cron_path }}
      state: present
    notify: restart cron

  - name: Configure cron mailto
    lineinfile:
      path: /etc/default/cron
      line: MAILTO={{ cron_mailto }}
      state: present
    notify: restart cron

  - name: Start and enable cron service
    service:
      name: cron
      enabled: yes
      state: started
    when: cron_service is defined and cron_service != ''

  - name: Schedule cron jobs
    cron:
      name: "{{ item.name }}"
      minute: "{{ item.minute }}"
      hour: "{{ item.hour }}"
      day: "{{ item.day }}"
      month: "{{ item.month }}"
      dayofweek: "{{ item.dayofweek }}"
      job: "{{ item.job }}"
    loop: "{{ cron_jobs }}"


