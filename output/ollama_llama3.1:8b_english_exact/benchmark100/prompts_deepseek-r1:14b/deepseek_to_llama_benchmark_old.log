---
- name: Create /etc/openvpn/easy-rsa directory with correct permissions
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize OpenVPN PKI structure
  command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate OpenVPN CA certificate
  command: easyrsa build-ca
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/private/ca.key
  environment:
    EASYRSA_BATCH: yes
    EASYRSA_ALTNAMES: ""

- name: Generate Diffie-Hellman parameters
  command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  creates: /etc/openvpn/easy-rsa/pki/dh.pem

- name: Generate server certificate
  command: easyrsa build-server-full server
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/private/server.key
  environment:
    EASYRSA_BATCH: yes

- name: Generate client certificate
  command: easyrsa build-client-full client
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/private/client.key
  environment:
    EASYRSA_BATCH: yes

- name: Generate Certificate Revocation List
  command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  creates: /etc/openvpn/easy-rsa/pki/crl.pem

- name: Generate OpenVPN TA key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Copy PKI files to /etc/openvpn/server directory
  file:
    src: /etc/openvpn/easy-rsa/pki/ta.key
    dest: /etc/openvpn/server
    state: link
    mode: '0640'
  notify: restart

  file:
    src: /etc/openvpn/easy-rsa/pki/ca.crt
    dest: /etc/openvpn/server
    state: link
    mode: '0640'
  notify: restart

  file:
    src: /etc/openvpn/easy-rsa/pki/dh.pem
    dest: /etc/openvpn/server
    state: link
    mode: '0640'
  notify: restart

  file:
    src: /etc/openvpn/easy-rsa/pki/crl.pem
    dest: /etc/openvpn/server
    state: link
    mode: '0640'
  notify: restart

  file:
    src: /etc/openvpn/easy-rsa/pki/private/ca.key
    dest: /etc/openvpn/server
    state: link
    mode: '0640'
  notify: restart

- name: Copy additional PKI files to /etc/openvpn directory
  file:
    src: /etc/openvpn/easy-rsa/pki/ca.crt
    dest: /etc/openvpn
    state: link
    mode: '0640'
  notify: restart

  file:
    src: /etc/openvpn/easy-rsa/pki/crl.pem
    dest: /etc/openvpn
    state: link
    mode: '0640'
  notify: restart

- name: Place OpenVPN server configuration file
  template:
    src: templates/server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: '0640'
  notify:
    - restart

- name: Restart OpenVPN service
  service:
    name: openvpn
    state: restarted


