---
- name: Verify Python and Python3 Installation
  hosts: localhost
  gather_facts: no

  tasks:
  - name: Check if Python is installed
    stat:
      path: /usr/bin/python
    register: python_present

  - name: Check if Python3 is installed
    stat:
      path: /usr/bin/python3
    register: python3_present

  - name: Debug Python executable path
    debug:
      msg: "Python executable path: {{ python_present.path }}"

  - name: Debug Python3 executable path
    debug:
      msg: "Python3 executable path: {{ python3_present.path }}"

  - name: Import assert.yml
    include_tasks: assert.yml
    loop: localhost

  - name: Install requirements
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ openssl_requirements | split(' ') }}"

  - name: Ensure packaging is available via dnf
    package:
      name: python3-packaging
      state: present

  - name: Install pip packages
    pip:
      name: "{{ item }}"
      state: present
    loop: "{{ openssl_pip_packages | split(' ') }}"

  - name: Create key directory
    file:
      path: "{{ openssl_key_directory }}"
      state: directory
      mode: '0755'
      owner: '{{ openssl_key_user }}'
      group: '{{ openssl_key_group }}'

  - name: Create csr directory
    file:
      path: "{{ openssl_csr_directory }}"
      state: directory
      mode: '0755'
      owner: '{{ openssl_csr_user }}'
      group: '{{ openssl_csr_group }}'

  - name: Create crt directory
    file:
      path: "{{ openssl_crt_directory }}"
      state: directory
      mode: '0755'
      owner: '{{ openssl_crt_user }}'
      group: '{{ openssl_crt_group }}'

  - name: Include create.yml
    include_tasks: create.yml
    loop: "{{ openssl_items }}"
    loop_control:
      loop_var: item


