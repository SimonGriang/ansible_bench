--- 

- name: Import assertion tasks
  include_tasks: assert.yml

- name: Install MySQL server
  package:
    name: "{{ packages }}"
    state: present
  notify:
    - mysql_root_password
    - systemctl_daemon_reexec

- name: Configure MySQL server
  template:
    src: my.cnf.j2
    dest: /etc/my.cnf
    mode: '0644'
  notify: restart_mysql

- name: Configure MySQL client
  template:
    src: client.cnf.j2
    dest: /etc/mysql/client.cnf
    mode: '0644'

- name: Initialize MySQL
  command: "{{ initdb_command }}"
  when: initdb_command is defined

- name: Start and enable MySQL
  service:
    name: "{{ service_name }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Create MySQL configuration file
  template:
    src: my.cnf.j2
    dest: /etc/my.cnf
    mode: '0644'

- name: Create MySQL databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ databases }}"
  when: not initial_import

- name: Collect information about existing MySQL databases
  mysql_db_info:
    name: "{{ item }}"
  loop: "{{ databases }}"
  register: db_info

- name: Import MySQL databases
  mysql_db:
    name: "{{ item.name }}"
    state: import
    source: "{{ item.source }}"
  loop: "{{ initial_import.databases }}"
  when: not db_info[item.name].exists

- name: Create MySQL users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
  loop: "{{ users }}"
  notify: restart_mysql

- name: Flush handlers
  meta: flush_handlers

- name: Create a MySQL configuration file
  template:
    src: my.cnf.j2
    dest: /etc/my.cnf
    mode: '0644'

- name: Create MySQL databases
