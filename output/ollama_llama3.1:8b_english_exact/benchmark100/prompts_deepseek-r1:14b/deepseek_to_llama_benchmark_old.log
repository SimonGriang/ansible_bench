---
- name: Assert systemd init system
  assert:
    that: ansible_init_systemd is true
    msg: "System init system is not systemd"

- name: Get latest release and set promtail version
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    return_content: true
  register: latest_release

- name: Set promtail_version variable
  set_fact:
    promtail_version: "{{ latest_release.json.tag_name }}"

- name: Test if zip local archive exists and assert local binary exists
  assert:
    that: ansible_distribution in ['centos', 'redhat'] and ansible_distribution_major_version == '8'
    msg: "Distribution is not supported"

- name: Get checksum list and set checksum for target architecture
  uri:
    url: https://github.com/grafana/loki/releases/download/{{ promtail_version }}/checksums.txt
    method: GET
    return_content: true
  register: checksum_list

  - name: Filter checksum for target architecture
    set_fact:
      checksum_arch: "{{ checksum_list.content | regex_search(' SHA256\\s+{{ ansible_architecture }}\\s+(.*)') | capture }}"


