- name: Import assertion tasks
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install system packages
  apt:
    name: "{{ openssl_requirements }}"
    state: "present"

- name: Install Python packages
  pip:
    name: "{{ openssl_pip_packages }}"
    state: "present"
  when: openssl_pip_packages | default(false) != ""

- name: Create key directory
  file:
    path: "{{ openssl_key_directory }}"
    mode: '700'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  become: yes

- name: Create certificate signing request directory
  file:
    path: "{{ openssl_csr_directory }}"
    mode: '755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  become: yes

- name: Create certificate directory
  file:
    path: "{{ openssl_crt_directory }}"
    mode: '755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  become: yes

- name: Include create tasks
  include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    label: "{{ item.name }}"
  when: openssl_items is defined and openssl_items | default([]) != []


