---
- name: Import assertion tasks
  include_tasks: assert.yml

- name: Install apache httpd
  apt:
    name: "{{ httpd_packages }}"

- name: Configure selinux
  selinux:
    state: present
  when: selinux_enabled
  notify: selinux_configured
  tasks:
    - name: Set selinux boolean settings
      selinux:
        policy: targeted
        boolean: "{{ httpd_sebooleans }}"
    - name: Allow connections on specified ports
      selinux:
        policy: targeted
        port:
          - name: httpd_port
            state: allowed
          - name: httpd_ssl_port
            state: allowed

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify:
    - httpd_config_test
    - httpd_service_restart

- name: Activate httpd module | Debian
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == 'Debian'

- name: Import ssl.yml
  include_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml
  include_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  include_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
