---
- name: Configure HTTP Server Directories
  hosts: all
  become: true

  tasks:
  - name: Create directories
    file:
      path: "{{ item.path }}"
      state: directory
      mode: '0755'
    loop: "{{ httpd_directories | items }}"
    notify: Restart httpd

  - name: Configure directories
    template:
      src: directory.conf.j2
      dest: "{{ item.path }}/{{ item.name }}.conf"
      mode: '0644'
    loop: "{{ httpd_directories | items }}"
    notify: [ 'Test httpd configuration validity', 'Restart httpd' ]

  handlers:
  - name: Test httpd configuration validity
    shell:
      cmd: /usr/sbin/httpd -t

  - name: Restart httpd
    service:
      name: httpd
      state: restarted


