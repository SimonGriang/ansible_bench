---
- name: Generate certificates and key
  hosts: []
  tasks:
  - name: Generate OpenSSL private key
    become: true
    become_user: root
    file:
      path: "/path/to/key/{{ item.key_name }}.key"
      state: present
      mode: '0600'
    loop:
      - { key_name: "example" }
    when: true
  - name: Generate OpenSSL Certificate Signing Request (CSR)
    become: true
    become_user: root
    community.crypto.csr:
      csr_extensions:
        - key_usage
      csr_permissions: '0644'
      csr_path: "/path/to/key/{{ item.key_name }}.csr"
      csr_private_key_path: "/path/to/key/{{ item.key_name }}.key"
      csr_common_name: "example.com"
      state: present
    loop:
      - { key_name: "example" }
  - name: Generate OpenSSL X.509 certificate
    become: true
    become_user: root
    community.crypto.certificate:
      certificate_permissions: '0644'
      certificate_path: "/path/to/cert/{{ item.key_name }}.crt"
      csr_private_key_path: "/path/to/key/{{ item.key_name }}.key"
      csr_path: "/path/to/key/{{ item.key_name }}.csr"
      state: present
    loop:
      - { key_name: "example" }
  - name: Generate a PKCS#12 file
    become: true
    become_user: root
    community.crypto.p12:
      p12_password: 'secret'
      p12_path: "/path/to/key/{{ item.key_name }}.p12"
      p12_pfx_permissions: '0644'
      p12_pfx_path: "/path/to/key/{{ item.key_name }}.key"
      p12_pfx_cert_path: "/path/to/cert/{{ item.key_name }}.crt"
      p12_pfx_friendly_name: "example"
      state: present
    loop:
      - { key_name: "example" }
  - name: Read private key content
    become: true
    become_user: root
    slurp:
      src: "/path/to/key/{{ item.key_name }}.key"
      dest: "/path/to/key/{{ item.key_name }}.key_contents"
    loop:
      - { key_name: "example" }
  - name: Read certificate content
    become: true
    become_user: root
    slurp:
      src: "/path/to/cert/{{ item.key_name }}.crt"
      dest: "/path/to/cert/{{ item.key_name }}.crt_contents"
    loop:
      - { key_name: "example" }
  - name: Create a combined private key and certificate file
    become: true
    become_user: root
    copy:
      content: |
        {{ slurp(src="/path/to/key/{{ item.key_name }}.key_contents") }} 
        {{ slurp(src="/path/to/cert/{{ item.key_name }}.crt_contents") }}
      dest: "/path/to/key/{{ item.key_name }}.combined"
      mode: '0644'
    loop:
      - { key_name: "example" }


