---
- name: Disable swap
  ansible.builtin.systemd:
    name: swap
    state: absent
    enabled: false

- name: Disable core dumps
  ansible.builtin.lineinfile:
    path: /etc/pam.d/common-session
    line: session required pam_limits.so
  when: vault_hardening_disable_core_dumps
- name: Disable core dumps
  ansible.builtin.lineinfile:
    path: /etc/security/limits.conf
    line: 'core 0 0'
    state: present
  when: vault_hardening_disable_core_dumps

- name: Disable shell command history
  ansible.builtin.lineinfile:
    path: /etc/profile.d/vault.sh
    line: 'export HISTFILESIZE=-1'
    state: present
  when: vault_hardening_disable_shell_command_history

- name: Configure SELinux/AppArmor
  block:
    - name: Enable SELinux
      ansible.builtin.service:
        name: selinux
        enabled: yes
        state: started
      when: vault_hardening_configure_selinux_apparmor
    - name: Install SELinux policies
      ansible.builtin.yum:
        name: selinux-policy
        state: present
      when: vault_hardening_configure_selinux_apparmor
    - name: Enforce AppArmor profiles for Vault
      ansible.builtin.apparmor:
        name: /path/to/vault/profile
        state: present
      when: vault_hardening_configure_selinux_apparmor

