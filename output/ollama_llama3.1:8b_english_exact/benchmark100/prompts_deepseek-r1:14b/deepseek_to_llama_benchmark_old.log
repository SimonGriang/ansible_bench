---
- name: Download RKE2 installation script
  get_url:
    url: 'https://storage.googleapis.com/rke2/releases/{{ rke2_version }}/rke2-installer.sh'
    dest: /tmp/rke2-installer.sh
    mode: '0700'
    validate_certs: no
  when: not rke2_airgap

- name: Copy local RKE2 installation script
  copy:
    content: "{{ lookup('file', 'rke2-installer.sh') }}"
    dest: /tmp/rke2-installer.sh
    mode: '0700'
  when: rke2_airgap and rke2_copy_implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: /usr/local/rke2
    state: directory
    mode: '0700'
    when: rke2_airgap and not rke2_copy_implementation == 'exists'

- name: Download RKE2 checksum and artifacts
  get_url:
    url: 'https://storage.googleapis.com/rke2/releases/{{ rke2_version }}/rke2-artifacts.tar.gz'
    dest: /tmp/rke2-artifacts.tar.gz
    mode: '0644'
    validate_certs: no
  when: rke2_airgap
  notify: rke2-artifacts-downloaded

- name: Copy local RKE2 artifacts
  copy:
    content: "{{ lookup('file', 'rke2-artifacts.tar.gz') }}"
    dest: /tmp/rke2-artifacts.tar.gz
    mode: '0644'
  when: rke2_airgap and rke2_copy_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  file:
    path: /usr/local/rke2/images
    state: directory
  when: rke2_airgap and rke2_additional_tarballs

- name: Airgap mode - additional images tarballs
  copy:
    src: rke2-images.tar.gz
    dest: /usr/local/rke2/images
    mode: '0644'
  when: rke2_airgap and rke2_additional_tarballs

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: /usr/local/rke2
    state: directory
    mode: '0700'
  when: rke2_airgap and rke2_copy_implementation == 'exists'
  notify: rke2-artifacts-permissions

- name: Populate service facts
  setup:

- name: Get stats of the FS object
  filesystem:
    path: /usr/local
    state: filesystem
  register: stats

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: '/usr/local/bin'
  when: stats.stats.is_mount == true or (stats.stats.is_mount == false and stats.stats.writeable == true)

- name: Check RKE2 version
  shell:
    cmd: rke2 version
    register: rke2_version_output
  when: not rke2_downgrade_allowed

- name: Check RKE2 version
  shell:
    cmd: rke2 version --output json
    register: rke2_version_output
  when: rke2_downgrade_allowed

- name: Prevent accidental RKE2 downgrade
  assert:
    that: rke2_version_output.stdout | regex('^[0-9]+.[0-9]+.[0-9]+$')
    msg: RKE2 version string is invalid

- name: Run RKE2 install script
  shell:
    cmd: /tmp/rke2-installer.sh
    args:
      creates: /usr/local/bin/rke2
    environment:
      RKE2_AIRGAP: '{{ rke2_airgap }}'
      RKE2_VERSION: '{{ rke2_version }}'
      RKE2_BIN_PATH: '{{ rke2_bin_path }}'
  when: rke2_airgap

- name: Copy Custom Manifests
  template:
    src: rke2-defaults.yml.j2
    dest: /etc/rancher/rke2/manifests/rke2-defaults.yml
    mode: '0644'

- name: Copy Static Pods
  template:
    src: rke2-agent-pod.yml.j2
