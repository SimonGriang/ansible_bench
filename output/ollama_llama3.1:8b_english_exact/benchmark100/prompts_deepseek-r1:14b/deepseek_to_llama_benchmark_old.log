---
- name: Install HashiCorp Product
  hosts: localhost
  gather_facts: no

  tasks:
  - name: Import assertion tasks
    include_tasks: assert.yml

  - name: Install HashiCorp product using package
    block:
      - name: install on redhat
        package:
          name: epel-release
          state: present
      - name: install on centos
        package:
          name: epel-release
          state: present
      - name: install on ubuntu
        package:
          name: ca-certificates
          state: present

  - name: Configure debian
    block:
      - name: Add gpg key
        apt_key:
          id: 3FA7E03280811993
          state: present
      - name: Add repository
        apt_repository:
          repo: 'ppa:hashicorp'
          state: present

  - name: Install hashicorp product using package
    block:
      - name: install latest
        package:
          name: terraform
          state: present
      - name: install version
        package:
          name: terraform_{{ version }}
          state: present

  - name: Install manually
    block:
      - name: copy files
        copy:
          content: |
            {{ src_file }}
          dest: {{ dest_file }}
          mode: '0644'
      - name: extract files
        unarchive:
          src: {{ src_file }}
          dest: {{ dest_file }}
          compression: gzip
      - name: set permissions
        file:
          path: {{ dest_file }}
          mode: '0755'


