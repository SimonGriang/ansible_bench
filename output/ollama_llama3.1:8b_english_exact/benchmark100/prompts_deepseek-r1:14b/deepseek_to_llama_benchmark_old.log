content='```\n---\n- name: Check if EFI firmware exists on the system\n  ansible.builtin.stat:\n    path: /sys/firmware/efi/efivars/\n  register: efi_firmware\n\n- name: Remove GRUB configuration file on EFI systems\n  ansible.builtin.file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: efi_firmware.stat.exists\n\n- name: Install custom user template for GRUB\n  ansible.builtin.copy:\n    content: "{{ lookup(\'template\', \'01_users.j2\') }}"\n    dest: /etc/grub.d/01_users\n    mode: \'0644\'\n\n- name: Add EFI password protection to GRUB\n  ansible.builtin.lineinfile:\n    dest: /etc/grub2-efi.cfg\n    line: "password_pbkdf2"\n    state: present\n  when: efi_firmware.stat.exists\n\n- name: Add MBR password protection to GRUB\n  ansible.builtin.lineinfile:\n    dest: /etc/grub2.cfg\n    line: "password_pbkdf2"\n    state: present\n\n- name: Add unrestricted access to GRUB password entries\n  ansible.builtin.lineinfile:\n    dest: /etc/grub.d/00_header\n    line: "# Set unrestricted access to grub password entries"\n    state: present\n    mode: \'0644\'\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-10T10:48:32.378371566Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3396456054, 'load_duration': 90549873, 'prompt_eval_count': 846, 'prompt_eval_duration': 181051354, 'eval_count': 297, 'eval_duration': 3123918840, 'model_name': 'llama3.1:8b'} id='run--2fc36bf4-b63f-439c-be04-2103786c44c7-0' usage_metadata={'input_tokens': 846, 'output_tokens': 297, 'total_tokens': 1143}
