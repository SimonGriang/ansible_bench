---

- name: Check if Java certificates exist
  stat:
    path: "{{ item }}"
  register: cert_status
  loop:
    - "{{ item }}"
  when: item is defined

- name: Fail if Java certificates are missing
  fail:
    msg: "Missing Java certificate: {{ item }}"
  loop: "{{ cert_status|map(attribute='path')|list }}"
  when: cert_status is defined and cert_status.stat.exists is not defined

- name: Set keystore directory for Java versions less than 11
  set_fact:
    java_keystore_dir: "/etc/legacy/keystore"

- name: Set keystore directory for Java versions 11 or newer
  set_fact:
    java_keystore_dir: "/etc/new/keystore"

- name: Import SSL certificates into Java keystore
  java_keystore:
    src: "{{ item.src }}"
    dest: "{{ java_keystore_dir }}"
    alias: "{{ item.alias }}"
    keystore_password: "{{ item.password }}"
    state: present
  loop:
    - src: "/etc/ssl/certs/your-cert1.pem"
      alias: "your-cert1"
      password: "your-password"
    - src: "/etc/ssl/certs/your-cert2.pem"
      alias: "your-cert2"
      password: "your-password"

