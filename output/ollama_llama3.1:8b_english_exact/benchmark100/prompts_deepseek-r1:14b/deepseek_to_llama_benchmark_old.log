---

- name: Main playbook tasks

  tasks:
  - name: Import tasks from assert.yml
    import_tasks: assert.yml
    run_once: true

  - name: Install required packages
    apt:
      name: "{{ service_required_packages }}"
      state: present
    notify: Gather facts

  - name: Configure systemd service
    template:
      src: systemd.j2
      dest: "/etc/systemd/system/{{ item }}"
      mode: '0644'
    loop: "{{ service_list }}"
    loop_control:
      extended: true

  - name: Configure systemd service
    template:
      src: systemd.j2
      dest: "/etc/systemd/system/{{ item }}.service"
      mode: '0644'
    loop: "{{ service_list }}"
    loop_control:
      extended: true

  - name: Configure sysvinit service
    template:
      src: sysvinit.j2
      dest: "/etc/init.d/{{ item }}"
      mode: '0755'
    loop: "{{ service_list }}"
    loop_control:
      extended: true

  - name: Manage service
    service:
      name: "{{ item }}"
      state: "{{ item.state }}"
      enabled: "{{ item.enabled }}"
      daemon_reload: true
    loop: "{{ service_list }}"
    loop_control:
      extended: true

  - name: Flush handlers
    meta: flush_handlers

  # Fixed indentation for the last task

