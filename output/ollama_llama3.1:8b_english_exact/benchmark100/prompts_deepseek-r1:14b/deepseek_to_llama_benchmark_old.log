  become: false

  tasks:
  - name: Test connection
    connection: local
    become: false
    debug:
      var: ansible_connection
    register: connection

  - name: Handle connection failures
    assert:
      that: connection | success
      msg: "Connection to {{ inventory_hostname }} failed"

  - name: Gather facts
    setup:

  - name: Install raw bootstrap packages
    apt:
      name: "{{ item }}"
      state: present
    loop:
      - "{{ item }}"
    loop_control:
      loop_var: item

- name: Ensure system preparation with Ansible modules
  apt:
    name: "{{ item }}"
    state: present
  with_items:
    - "{{ item }}"
  loop_control:
    loop_var: item

  # Gather facts
  setup

  # Install packages
  package:
    name: "{{ item }}"
    state: present
  with_items:
    - "{{ item }}"
  loop_control:
    loop_var: item


