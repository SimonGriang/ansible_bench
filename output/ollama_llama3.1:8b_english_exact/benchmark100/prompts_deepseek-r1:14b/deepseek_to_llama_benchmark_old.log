---
- name: Set the package state based on how Ansible is installed
  set_fact:
    ansible_package_state: "present" if (ansible_distribution == "RedHat" and ansible_distribution_major_version != "8" and ansible_pkg_mgr == "yum") else "absent"

- name: Set up Ansible on RedHat
  include_tasks: setup-RedHat.yml
  when:
    - ansible_distribution == "RedHat"
    - ansible_distribution_major_version != "8"
    - ansible_pkg_mgr == "yum"
    - ansible_package_state == "present"

- name: Set up Ansible on Fedora
  include_tasks: setup-Fedora.yml
  when:
    - ansible_distribution == "Fedora"
    - ansible_pkg_mgr == "dnf"
    - ansible_package_state == "present"

- name: Set up Ansible on Ubuntu
  include_tasks: setup-Ubuntu.yml
  when:
    - ansible_distribution == "Ubuntu"
    - ansible_pkg_mgr == "apt"
    - ansible_package_state == "present"

- name: Set up Ansible on Debian
  include_tasks: setup-Debian.yml
  when:
    - ansible_distribution == "Debian"
    - ansible_pkg_mgr == "apt"
    - ansible_package_state == "present"

- name: Set up Ansible using Pip
  include_tasks: setup-pip.yml
  when:
    - ansible_package_state == "absent"

