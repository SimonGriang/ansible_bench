  when: bootstrap_distribution and bootstrap_distribution in bootstrap__os_family_map and bootstrap_distribution_major_version == ''
  when: bootstrap_distribution and bootstrap_distribution in bootstrap__os_family_map and bootstrap_distribution_major_version == ''

- name: Set ansible_user
  set_fact:
    ansible_user: '{{ bootstrap_user }}'


