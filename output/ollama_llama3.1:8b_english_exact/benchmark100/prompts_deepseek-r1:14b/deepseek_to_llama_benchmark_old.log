- name: Create docroot for each vhost
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  when: item.documentroot is defined and item.create_docroot != false
  loop: "{{ httpd_vhosts }}"
  notify: "Test httpd configuration validity"

- name: Configure vhosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify: "Restart httpd"

