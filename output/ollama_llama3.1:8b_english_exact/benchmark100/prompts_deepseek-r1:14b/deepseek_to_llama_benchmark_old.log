---
- name: Install Keepalived when HA mode is enabled
  include_tasks:
    path: tasks/keepalived.yml

- name: Download and install RKE2
  include_tasks:
    path: tasks/rke2.yml

- name: Perform CIS hardening
  include_tasks:
    path: tasks/cis_hardening.yml
  when: cis_profile is defined

- name: Find and identify the active server
  include_tasks:
    path: tasks/find_active_server.yml

- name: Enable IPVS kernel module
  include_tasks:
    path: tasks/enable_ipvs.yml
  when: ha_mode is enabled and ipvs_enabled is true

- name: Copy kube-vip manifests
  include_tasks:
    path: tasks/copy_kubevip.yml
  when: ha_mode is enabled and kubevip_enabled is true

- name: Copy ingress-nginx manifests
  include_tasks:
    path: tasks/copy_ingress_nginx.yml
  when: ingress_nginx_values is defined

- name: Prepare the first server node
  include_tasks:
    path: tasks/prepare_first_node.yml
  when: first_server_node is defined

- name: Perform etcd restore
  include_tasks:
    path: tasks/etcd_restore.yml
  when: etcd_backup_path is defined and etcd_restore_enabled is true

- name: Download kubeconfig
  include_tasks:
    path: tasks/download_kubeconfig.yml
  when: download_kubeconfig is enabled

- name: Prepare and join remaining cluster nodes
  include_tasks:
    path: tasks/join_remaining_nodes.yml
  when: active_server is defined

- name: Perform rolling restart of servers
  include_tasks:
    path: tasks/rolling_restart_servers.yml
  when: version_change is true

- name: Perform rolling restart of agents
  include_tasks:
    path: tasks/rolling_restart_agents.yml
  when: version_change is true

- name: Flush handlers
  meta:
    flush_handlers: true

- name: Perform rolling restart when config changes
  include_tasks:
    path: tasks/rolling_restart_config.yml
  when: config_changes is true

- name: Perform final steps
  include_tasks:
    path: tasks/final_steps.yml

