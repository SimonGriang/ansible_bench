- name: Set fact for docker-compose current version
  set_fact:
    docker_compose_current_version: "{{ docker_compose_version.stdout | regex_findall('([0-9.]+)') | first }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: docker_compose_current_version != "1.29.2"

