---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: yes

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure SELinux
  when:
    - selinux_status is defined
    - connection.type != 'container'
    - connection.type != 'docker'
    - connection.type != 'community.docker.docker'
  block:
    - name: Manage SELinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Manage SELinux booleans
      selinux_booleans:
        booleans: "{{ selinux_booleans }}"
        state: "{{ item.state }}"
        persistent: true
        label: "{{ item.name }}"
      when: selinux_booleans is defined
      loop: "{{ selinux_booleans }}"

