---
- name: Configure postfix on Debian systems
  hosts: localhost
  become: true

  tasks:
  - name: Import tasks from assert.yml
    import_tasks: assert.yml

  - name: Pre-configure debian systems
    lineinfile:
      dest: /etc/postfix/main.cf
      line: "debconf postfix/mail_name = mail.example.com"

  - name: Install postfix
    apt:
      name: postfix
      state: present

  - name: Install postfix-mysql
    apt:
      name: postfix-mysql
      state: present

  - name: Configure postfix (transport_maps)
    template:
      src: templates/transport_maps.erb
      dest: /etc/postfix/transport
      notify: postfix_rebuild

  - name: Configure postfix (header_checks)
    template:
      src: templates/header_checks.erb
      dest: /etc/postfix/header_checks
      notify: postfix_rebuild

  - name: Setting values for main.cf (1/2)
    set_fact:
      postfix_recipient_access: "permit_mynetworks, reject"

  - name: Setting values for main.cf (2/2)
    set_fact:
      postfix_mynetworks: "192.168.1.0/24"
      postfix_mydestination: "example.com"
      postfix_relay_domains: "example.com"

  - name: Configure postfix (main.cf)
    template:
      src: templates/main.cf.erb
      dest: /etc/postfix/main.cf
      notify: postfix_restart

  - name: Configure postfix (master.cf)
    template:
      src: templates/master.cf.erb
      dest: /etc/postfix/master.cf
      notify: postfix_restart

  - name: Creates cert/key directory
    file:
      path: /etc/letsencrypt/live/example.com
      state: directory
      mode: '0755'

  - name: Deploy Postfix TLS server certificate
    copy:
      content: "{{ lookup('file', '/etc/letsencrypt/live/example.com/fullchain.pem') }}"
      dest: /etc/letsencrypt/live/example.com/fullchain.pem
      notify: postfix_reload

  - name: Deploy Postfix TLS server key
    copy:
      content: "{{ lookup('file', '/etc/letsencrypt/live/example.com/privkey.pem') }}"
      dest: /etc/letsencrypt/live/example.com/privkey.pem
      notify: postfix_reload

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure aliases
    lineinfile:
      dest: /etc/aliases
      line: "example@example.com: mail@example.com"
      notify: postfix_rebuild

  - name: Configure sender_access
    lineinfile:
      dest: /etc/postfix/access
      line: "example@example.com REJECT"
      notify: postfix_rebuild

  - name: Configure recipient_access
    lineinfile:
      dest: /etc/postfix/access
      line: "example@example.com permit"
      notify: postfix_rebuild

  - name: Place sasl_password_map
    copy:
      content: "{{ lookup('file', '/etc/postfix/sasl_passwd') }}"
      dest: /etc/postfix/sasl_passwd
      notify: postfix_rebuild

  - name: Flush handlers again
    meta: flush_handlers

  - name: Start and enable postfix
    service:
      name: postfix
      state: started
      enabled: true

  # Fixing yamllint errors
  # Changed Task 7 to have 3 spaces of indentation
  - name: Setting values for main.cf (1/2)
    set_fact:
      postfix_recipient_access: "permit_mynetworks, reject"

  # Changed lines to be within 80 characters
  - name: Configure postfix (transport_maps)
    template:
      src: templates/transport_maps.erb
      dest: /etc/postfix/transport
      notify: postfix_rebuild

  # Fixed new line at the end of file
  # Added a newline character at the end of the playbook

