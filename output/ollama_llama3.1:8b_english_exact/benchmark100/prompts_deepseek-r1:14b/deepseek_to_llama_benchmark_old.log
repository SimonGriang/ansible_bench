---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_packages }}"
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: mysql.conf.j2
    dest: /etc/my.cnf
  notify:
    - Restart mysql server
  loop: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  template:
    src: mysql_client.conf.j2
    dest: /etc/mysql/client.cnf
    mode: '0644'

- name: Initialize mysql
  when: ansible_distribution in ['Alpine', 'Archlinux']
  command: /usr/bin/mysql_install_db

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/my.cnf
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers again
  meta: flush_handlers

