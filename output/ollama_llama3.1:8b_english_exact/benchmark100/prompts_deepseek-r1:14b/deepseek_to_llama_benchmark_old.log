- name: Gather OS identification facts
  ansible.builtin.gather_facts:
    method: files
    files:
      - /etc/os-release

- name: Extract and set distribution name and major version
  set_fact:
    distribution_name: "{{ (ansible_facts['os_family'] + ansible_facts['os']['name']).split()[0] }}"
    distribution_major_version: "{{ ansible_facts['os']['version'].split('.')[0] }}"

- name: Map distribution to OS family
  set_fact:
    os_family: "{{ distribution_name | regex_replace('Ubuntu', 'Debian') | regex_replace('Ubuntu Core', 'Debian') }}"

