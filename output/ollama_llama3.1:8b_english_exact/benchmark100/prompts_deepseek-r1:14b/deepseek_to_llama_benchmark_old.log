    state: present
    skip_verify: true
  when: not ansible_distribution in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

- name: Install Python modules
  pip:
    name: "{{ item }}"
    state: present
    version: "{{ item_version }}"
    force: true
  loop: "{{ python_pip_modules }}"
  loop_control:
    loop_var: item
  when: not ansible_distribution in ['bookworm', 'noble'] and ansible_os_family != 'Alpine' and item_version is defined


