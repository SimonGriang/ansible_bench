---
- name: Install Java
  hosts: localhost
  gather_facts: no

  tasks:
    - name: Import assertion file
      import_tasks: assert.yml
      run_once: yes

    - name: Install system requirements
      package:
        name: bash
        state: present

    - name: Install OpenJDK Java
      package:
        name: "{{ java_vendor }}-java"
        state: present
      when: java_vendor == "openjdk"

    - name: Install Oracle Java RPM from local
      package:
        name: "{{ java_source }}-{{ java_version }}-{{ java_vendor }}-jdk-{{ java_format }}.rpm"
        state: present
      when: java_source == "local" and java_format == "rpm"

    - name: Install Oracle Java DEB from local
      package:
        name: "{{ java_source }}-{{ java_version }}-{{ java_vendor }}-jdk-{{ java_format }}.deb"
        state: present
      when: java_source == "local" and java_format == "deb"

    - name: Install Oracle Java RPM from repository
      package:
        name: "{{ java_vendor }}-java"
        state: present
      when: java_source == "repository" and java_format == "rpm"

    - name: Configure Oracle Java targz installation
      unarchive:
        src: "{{ java_source }}-{{ java_version }}-{{ java_vendor }}-jdk-{{ java_format }}.tar.gz"
        dest: /opt/java
        compression: tar
      when: java_format == "targz" and java_vendor == "oracle"

    - name: Install Oracle Java JCE policy
      package:
        name: "{{ java_vendor }}-jdk-{{ java_version }}-jce-policy"
        state: present
      when: java_jce and java_version == 8 and java_vendor == "oracle"

    - name: Set Java alternative
      file:
        dest: "/etc/alternatives/java"
        state: link
        content: "/usr/bin/java"
      when: java_format == "targz" and ansible_distribution not in ["Alpine Linux", "alpine"]

    - name: Find Java home directory
      find:
        paths: /usr/bin
        search_path: true
      register: java_bin_path

    - name: Set JAVA_HOME in environment
      lineinfile:
        dest: /etc/profile.d/java_home.sh
        line: "export JAVA_HOME=/usr/lib/jvm/{{ java_bin_path.path }}"
      state: present


