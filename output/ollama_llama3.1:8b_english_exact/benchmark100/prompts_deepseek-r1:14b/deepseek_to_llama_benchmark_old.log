---
- name: Helm Installation Tasks
  tasks:
  - name: Check if Helm binary exists
    stat:
      path: /usr/local/bin/helm
    register: helm_check

  - name: Check Helm version
    shell:
      cmd: helm version
    register: helm_existing_version

  - name: Download helm
    unarchive:
      src: "https://storage.googleapis.com/kubernetes-helm/helm-v{{ item.version }}-darwin-amd64.tar.gz"
      dest: /tmp
      dest_dir: /usr/local/bin
      compression: tar
      extra_opts: ["--strip-components=1"]
      version: "{{ item.version }}"
    when: "not helm_check.stat.exists or helm_existing_version.stdout.find('{{ item.version }}') == -1"
    register: helm_download
    loop:
      items:
        - version: "3.5.4"

  - name: Copy helm binary into place
    copy:
      src: "/tmp/helm/helm"
      dest: "/usr/local/bin/helm"
      mode: '0755'
    when: helm_download is changed


