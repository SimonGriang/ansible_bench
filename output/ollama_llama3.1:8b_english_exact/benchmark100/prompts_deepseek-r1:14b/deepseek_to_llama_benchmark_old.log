domains are configured to use MySQL\n\n- name: Create directories for TLS certificates and keys\n  file:\n    path: /etc/ssl/private/\n    state: directory\n    owner: postfix\n    group: postfix\n    mode: '0700'\n  notify: reload_postfix\n\n- name: Copy TLS server certificate\n  copy:\n    content: 'your TLS server certificate content'\n    dest: /etc/ssl/certs/your_server_certificate.crt\n    owner: root\n    group: root\n    mode: '0644'\n  notify: reload_postfix\n\n- name: Copy TLS server key\n  copy:\n    content: 'your TLS server key content'\n    dest: /etc/ssl/private/your_server_key.key\n    owner: root\n    group: root\n    mode: '0600'\n  notify: reload_postfix\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Configure postfix aliases\n  lineinfile:\n    dest: /etc/aliases\n    regexp: '^postmaster'\n    line: 'postmaster: root'\n  notify: rebuild_postfix_database\n\n- name: Configure postfix sender access restrictions\n  lineinfile:\n    dest: /etc/postfix/access\n    regexp: '^10\\.0\\.0\\.1'\n    line: '10.0.0.1'\n  notify: rebuild_postfix_database\n\n- name: Configure postfix recipient access restrictions\n  lineinfile:\n    dest: /etc/postfix/access\n    regexp: '^10\\.0\\.0\\.2'\n    line: '10.0.0.2'\n  notify: rebuild_postfix_database\n\n- name: Copy SASL password map content\n  copy:\n    content: 'your SASL password map content'\n    dest: /etc/postfix/sasl_password_map\n    owner: root\n    group: root\n    mode: '0644'\n  notify: rebuild_sasl_password_map\n\n- name: Start postfix service and ensure it is enabled to start on boot\n  service:\n    name: postfix\n    state: started\n    enabled: yes" additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-10T12:08:36.303146084Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7639345438, 'load_duration': 118375486, 'prompt_eval_count': 842, 'prompt_eval_duration': 142675983, 'eval_count': 893, 'eval_duration': 7377082145, 'model_name': 'llama3.1: