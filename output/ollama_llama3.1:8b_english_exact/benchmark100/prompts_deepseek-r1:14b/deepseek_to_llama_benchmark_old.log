---
- name: User management and SSH key configuration
  tasks:
  - name: Create local SSH key directory for user
    file:
      path: /home/{{ user }}/.ssh
      state: directory
      owner: "{{ user }}"
      group: "{{ user }}"
      mode: '0750'

  - name: Manage user account
    user:
      name: "{{ user }}"
      comment: "{{ user }}"
      home: "{{ user_home_dir | default('/home') }}"
      shell: '/bin/bash'
      state: present

  - name: Set sudo options for user
    lineinfile:
      dest: /etc/sudoers.d/{{ user }}
      state: present
      mode: '0644'
      line: 'Defaults:{{ user }} !requiretty'
      create: yes

  - name: Generate private SSH key for user
    command: ssh-keygen -t rsa -N '' -f "/home/{{ user }}/.ssh/{{ user }}_private_key"

  - name: Generate public SSH key for user
    command: ssh-keygen -y -f "/home/{{ user }}/.ssh/{{ user }}_private_key" > "/home/{{ user }}/.ssh/{{ user }}_public_key.pub"

  - name: Convert SSH key to ppk format for user
    command: puttygen "/home/{{ user }}/.ssh/{{ user }}_private_key" -O private-openssh -o "/home/{{ user }}/.ssh/{{ user }}_private_key.ppk"

  - name: Get or set the home directory for user
    set_fact:
      user_home_dir: "{{ lookup('file', '/home/{{ user }}') }}"

  - name: Create .ssh directory for user
    file:
      path: "/home/{{ user }}/.ssh"
      state: directory
      owner: "{{ user }}"
      group: "{{ user }}"
      mode: '0700'

  - name: Deploy authorized keys for user
    authorized_key:
      user: "{{ user }}"
      state: present
      key: "ssh-rsa 

