---

- name: Create the RKE2 config directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    rke2_server_node_taints: "node-role.kubernetes.io/rke2-server=true:NoSchedule"

- name: Copy RKE2 configuration file
  copy:
    content: "{{ lookup('file', 'rke2.conf') }}"
    dest: /etc/rke2/rke2.conf
    mode: '0644'
    notify: restart rke2-server

- name: Copy kubelet configuration file
  copy:
    content: "{{ lookup('file', 'kubelet.conf') }}"
    dest: /etc/kubernetes/kubelet.conf
    mode: '0644'
    when: rke2_kubelet_config
    notify: restart kubelet

- name: Copy Containerd Registry Configuration file
  copy:
    content: "{{ lookup('file', 'daemon.json') }}"
    dest: /etc/containerd/config.toml
    mode: '0644'
    when: custom_registry_mirrors or custom_registry_configs
    notify: restart containerd

- name: Register etcd restore from file
  set_fact:
    rke2_etcd_restore_from_file: true
  when:
    - snapshot_file is defined
    - rke2_service.status == 'running'

- name: Register etcd restore from S3
  set_fact:
    rke2_etcd_restore_from_s3: true
  when:
    - s3_options is defined
    - s3_region is defined
    - s3_access_key_id is defined
    - s3_secret_access_key is defined

- name: Restore etcd from file
  block:
    - name: Create /etc/etcd directory
      file:
        path: /etc/etcd
        state: directory
        mode: '0755'
    - name: Copy etcd snapshot file
      copy:
        content: "{{ lookup('file', 'etcd-snapshot.db') }}"
        dest: /etc/etcd/etcd-snapshot.db
        mode: '0644'
    - name: Run etcd restore command
      shell: |
        etcdctl snapshot restore /etc/etcd/etcd-snapshot.db
      when: rke2_etcd_restore_from_file

- name: Restore etcd from S3
  block:
    - name: Create /etc/etcd directory
      file:
        path: /etc/etcd
        state: directory
        mode: '0755'
    - name: Copy etcd snapshot file from S3
      get_url:
        url: "s3://{{ s3_bucket }}/{{ s3_key }}?AWS_ACCESS_KEY_ID={{ s3_access_key_id }}&AWS_SECRET_ACCESS_KEY={{ s3_secret_access_key }}&AWS_REGION={{ s3_region }}"
        dest: /etc/etcd/etcd-snapshot.db
        mode: '0644'
    - name: Run etcd restore command
      shell: |
        etcdctl snapshot restore /etc/etcd/etcd-snapshot.db
      when: rke2_etcd_restore_from_s3

- name: Start RKE2 service
  service:
    name: rke2-server
    state: started
    enabled: true
  notify: restart rke2-server
  when: not rke2_agent_masked

- name: Mask RKE2 agent service
  service:
    name: rke2-agent
    state: masked
  when: rke2_server_node_taints is defined

- name: Wait for first server to be ready (no CNI)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 6443
    timeout: 300
    connect_timeout: 10
    status: 200
  when: not cni_configured

- name: Wait for first server to be ready (with CNI)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 6443
    timeout: 300
    connect_timeout: 10
    status: 200
  when: cni_configured

- name: Restore etcd
  block:
    - name: Clean up old nodes
      shell: etcdctl member list
      when: rke2_etcd_restore_from_file or rke2_etcd_restore_from_s3
    - name: Clean up old secrets
      shell: etcdctl get /registry/secrets
      when: rke2_etcd_restore_from_file or rke2_etcd_restore_from_s3

- name: Set Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: all
  delegate_group: rke2_cluster_group

