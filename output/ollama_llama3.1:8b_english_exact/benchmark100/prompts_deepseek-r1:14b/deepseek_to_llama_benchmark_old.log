---

- name: Restart RKE2 service on {{ rke2_node_name}}
  service:
    name: rke2
    state: restarted
    enabled: true
  notify:
    - Service (re)started

- name: Wait for all nodes to be ready again
  uri:
    url: "https://{{ rke2_node_name }}:8443/api/v1/nodes"
    method: GET
    status: 200
    body_format: json
    headers:
      Authorization: "Bearer {{ rke2_kube_config_token }}"
    timeout: 10
    retries: 100
    delay: 15
    delegate_to: active
    delegate_facts: true
  register: all_nodes_ready
  until: all_nodes_ready.json.items[0].status.phase == 'Ready'
  when: ansible_check_mode == false

- name: Wait for all pods to be ready again
  uri:
    url: "https://{{ rke2_node_name }}:8443/api/v1/pods"
    method: GET
    status: 200
    body_format: json
    headers:
      Authorization: "Bearer {{ rke2_kube_config_token }}"
    timeout: 10
    retries: 100
    delay: 15
    delegate_to: active
    delegate_facts: true
  register: all_pods_ready
  until: all_pods_ready.json.items[0].status.phase == 'Running'
  when: ansible_check_mode == false and rke2_wait_for_all_pods_to_be_ready == true

