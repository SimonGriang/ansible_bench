---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install git
  package:
    name: git
    state: present

- name: Check if user exists
  user:
    name: git
    state: present
    mode: absent

- name: Create git config directory
  file:
    path: /home/git/.config/git
    state: directory
    mode: '0700'
    owner: git
    group: git

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: /home/git/.config/git/config
    state: file
    mode: '0600'
    owner: git
    group: git

- name: Create repository destination
  file:
    path: /home/git/repositories
    state: directory
    mode: '0755'
    owner: git
    group: git

- name: Clone all repositories
  git:
    repo: 'https://github.com/user/repo1.git'
    dest: /home/git/repositories/repo1
    version: master
    clone: yes
  delegate_to: localhost
  when: repo1
  notify: restart git service

  git:
    repo: 'https://github.com/user/repo2.git'
    dest: /home/git/repositories/repo2
    version: master
    clone: yes
  delegate_to: localhost
