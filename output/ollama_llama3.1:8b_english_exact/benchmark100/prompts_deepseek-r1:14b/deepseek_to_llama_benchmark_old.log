---
- name: DNS Configuration
  hosts: localhost
  become: yes

  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install dns
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ dns_packages }}"

  - name: Create directories
    file:
      path: "{{ item.path }}"
      mode: "{{ item.mode }}"
      owner: "{{ item.owner }}"
      group: "{{ item.group }}"
      state: directory
    loop:
      - { path: "{{ dns_data_dir }}", mode: "755", owner: "root", group: "root" }
      - { path: "{{ dns_config_dir }}", mode: "755", owner: "root", group: "root" }

  - name: Create group
    group:
      name: "{{ dns_group }}"
      state: present

  - name: Create user
    user:
      name: "{{ dns_owner }}"
      system: yes
      state: present
      group: "{{ dns_group }}"

  - name: Generate rndc key
    template:
      src: rndc.key.j2
      dest: "{{ dns_config_dir }}/rndc.key"
      mode: "0600"
    notify:
      - Restart dns

  - name: Set permissions on rndc key file
    file:
      path: "{{ dns_config_dir }}/rndc.key"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: "0600"

  - name: Get the hints/root file
    get_url:
      url: "{{ dns_root_hints_url }}"
      dest: "{{ dns_data_dir }}/hints/root"
      mode: "0644"
    when: dns_caching_dns

  - name: Create zone file
    template:
      src: zone.j2
      dest: "{{ dns_data_dir }}/zones/{{ item.name }}.zone"
      mode: "0644"
      validate: "{{ dns_data_dir }}/zones/{{ item.name }}.zone | dnssec-checkzone -K - {{ item.name }}"
    loop: "{{ dns_zones }}"
    notify:
      - Restart dns

  - name: Add zones to configuration
    template:
      src: named.conf.options.j2
      dest: "{{ dns_config_dir }}/named.conf.options"
      mode: "0644"
    notify:
      - Restart dns

  - name: Place systemd override
    template:
      src: "dns-systemd.override.j2"
      dest: "/etc/systemd/system/dns.service.d/override.conf"
      mode: "0644"
    when: using_systemd
    notify:
      - Reload systemd

  - name: Start and enable dns
    service:
      name: dns
      state: started
