---

- name: Configure Rsyslog
  hosts: localhost

  tasks:
  - name: Import assert.yml
    import_tasks:
      path: assert.yml

  - name: Uninstall conflicting systemd-logger
    package:
      name: systemd-logger
      state: absent

  - name: Install rsyslog
    package:
      name: "{{ rsyslog_packages }}"
      state: "{{ rsyslog_package_state }}"

  - name: Install additional rsyslog packages
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ rsyslog_features | list }}"

  - name: Configuring default rsyslog
    template:
      src: "{{ rsyslog_config_file_format }}"
      dest: "{{ rsyslog_dest_conf_file }}"
      mode: '0644'
    notify:
      - Restart rsyslog

  - name: Make configuration directory
    file:
      path: "/etc/rsyslog.d/"
      state: directory
      mode: '0755'

  - name: Configuring rsyslog forward rule
    template:
      src: "forward_rule.conf.j2"
      dest: "/etc/rsyslog.d/{{ rsyslog_forward_rule_name }}.conf"
      mode: '0644'
    notify:
      - Restart rsyslog
    when: not rsyslog_deploy_default_config | bool

  - name: Configuring additional config files
    template:
      src: "{{ item.value.src }}"
      dest: "/etc/rsyslog.d/{{ item.key }}.conf"
      mode: '0644'
    notify:
      - Restart rsyslog
    loop: "{{ rsyslog_rsyslog_d_files | dictitems }}"
    when: item.value.state is defined

  - name: Start and enable rsyslog
    service:
      name: "{{ rsyslog_service }}"
      state: started
      enabled: true

