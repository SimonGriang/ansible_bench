---
- name: Gather raw OS facts
  raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts

- name: Extract OS distribution facts
  set_fact:
    bootstrap_distribution: ''
    bootstrap_distribution_major_version: ''
  become: yes
  when: bootstrap_facts and bootstrap_facts.stdout != ''
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: bootstrap_facts.stdout != '' or bootstrap_facts.stdout | default('', true) != ''

- name: Set OS family
  set_fact:
    bootstrap_os_family: ''
  become: yes
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: bootstrap_distribution in bootstrap__os_family_map and bootstrap_distribution_major_version == ''

- name: Set ansible_user
  set_fact:
    ansible_user: '{{ bootstrap_user }}'

