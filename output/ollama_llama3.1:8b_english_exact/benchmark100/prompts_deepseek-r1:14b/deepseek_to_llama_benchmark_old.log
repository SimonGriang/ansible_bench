---
- name: Install unzip package
  apt:
    name: unzip
    state: present

- name: Create system group for promtail
  group:
    name: promtail
    state: present
    system: yes

- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    system: yes
    create_home: no
    append: yes
    comment: promtail user

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  file:
    path: /etc/promtail/config
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Create application directories
  file:
    path: /var/log/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  file:
    path: /var/log/promtail/config
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Check promtail binary existence
  stat:
    path: /usr/local/bin/promtail
    state: file
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: 'https://example.com/promtail/promtail-{{ ansible_distribution_version }}.zip'
    dest: /tmp/promtail-{{ ansible_distribution_version }}.zip
    checksum: 'sha256:{{ checksum }}'
  notify: restart promtail

- name: Propagate local promtail binaries
  copy:
    src: /tmp/promtail-{{ ansible_distribution_version }}.zip
    dest: /tmp/promtail.zip
    remote_src: yes

- name: Download promtail binaries for controller node
  get_url:
    url: 'https://example.com/promtail/promtail-{{ ansible_distribution_version }}.zip'
    dest: /tmp/promtail-{{ ansible_distribution_version }}.zip
    checksum: 'sha256:{{ checksum }}'
  notify: restart promtail

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail-{{ ansible_distribution_version }}.zip
    dest: /tmp/promtail.zip
    remote_src: yes

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail.zip
    dest: /usr/local/bin
    compression: 'zip'
    interactive: yes

- name: Create symlink to latest promtail version
  file:
    path: /usr/local/bin/promtail
    src: /usr/local/bin/promtail-{{ ansible_distribution_version }}
    state: link
  notify: restart promtail

- name: Write promtail config file
  template:
    src: promtail_config.j2
    dest: /etc/promtail/config/promtail.yml
    mode: '0644'
    owner: promtail
    group: promtail

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
    owner: root
    group: root
  notify: restart promtail


