--- 

- name: Generate a private SSL key using OpenSSL
  become: yes
  become_user: root
  become_method: sudo
  file:
    path: /path/to/ssl/private/key.pem
    state: file
    mode: '0600'
  openssl_private_key:
    path: /path/to/ssl/private/key.pem
    size: 2048
    type: rsa

- name: Generate a Certificate Signing Request (CSR)
  become: yes
  become_user: root
  become_method: sudo
  file:
    path: /path/to/ssl/csr.pem
    state: file
    mode: '0644'
  openssl_csr:
    path: /path/to/ssl/csr.pem
    privatekey_path: /path/to/ssl/private/key.pem
    common_name: yourdomain.com
    organization: yourorganization
    country_name: yourcountry
    state_or_province_name: yourstate
    locality_name: yourcity

- name: Generate a self-signed SSL certificate
  become: yes
  become_user: root
  become_method: sudo
  file:
    path: /path/to/ssl/cert.pem
    state: file
    mode: '0644'
  openssl_certificate:
    path: /path/to/ssl/cert.pem
    csr_path: /path/to/ssl/csr.pem
    privatekey_path: /path/to/ssl/private/key.pem
    provider: selfsigned

- name: Create a PKCS#12 file
  become: yes
  become_user: root
  become_method: sudo
  file:
    path: /path/to/ssl/pkcs12.p12
    state: file
    mode: '0644'
  openssl_pkcs12:
    path: /path/to/ssl/pkcs12.p12
    cert_path: /path/to/ssl/cert.pem
    privatekey_path: /path/to/ssl/private/key.pem
    password: yourpassword
    provider: selfsigned

- name: Read the private key content
  become: yes
  become_user: root
  become_method: sudo
  set_fact:
    private_key_content: "{{ lookup('file', '/path/to/ssl/private/key.pem') }}"

- name: Read the certificate content
  become: yes
  become_user: root
  become_method: sudo
  set_fact:
    certificate_content: "{{ lookup('file', '/path/to/ssl/cert.pem') }}"

- name: Combine private key and certificate into a single file
  become: yes
  become_user: root
  become_method: sudo
  file:
    path: /path/to/ssl/combined.pem
    state: file
    mode: '0644'
  copy:
    content: "{{ private_key_content }}{{ certificate_content }}"
    dest: /path/to/ssl/combined.pem

