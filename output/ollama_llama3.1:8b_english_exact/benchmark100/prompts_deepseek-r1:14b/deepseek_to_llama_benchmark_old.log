---
- name: Validate and configure Python packages
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install Python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  lineinfile:
    path: /etc/pip.conf
    line: "index-url = {{ python_pip_proxy }}"
    state: present
    create: yes
    regexp: '^index-url ='

- name: Configure pip trusted hosts
  lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    state: present
    create: yes
    regexp: '^trusted-host ='

- name: Update pip
  pip:
    name: pip
    state: present
    skip_verify: yes
  when: not ansible_distribution in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

- name: Install Python modules
  pip:
    name: "{{ item }}"
    state: present
    version: "{{ item_version }}"
    force: yes
  loop: "{{ python_pip_modules }}"
  loop_control:
    loop_var: item
  when: not ansible_distribution in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'
  when: item_version is defined


