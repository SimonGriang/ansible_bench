---
- name: Logrotate Tasks
  tasks:
  - name: Import assertion tasks
    include_tasks: assert.yml

  - name: Install logrotate package
    package:
      name: "{{ logrotate_packages }}"

  - name: Configure logrotate
    template:
      src: logrotate_config_file.j2
      dest: "{{ logrotate_config_dir }}"
      mode: '0644'

  - name: Generate logrotate.d configuration files
    template:
      src: "logrotate_config_file.j2"
      dest: "{{ logrotate_config_dir }}/{{ item.name }}"
      mode: '0644'
    loop: "{{ logrotate_entries }}"
    when: item.absent == false
    notify: logrotate restart

  - name: Remove logrotate.d files
    file:
      path: "{{ logrotate_config_dir }}/{{ item.name }}"
      state: absent
    loop: "{{ logrotate_entries }}"
    when: item.absent == true

  - name: Start and enable logrotate service
    service:
      name: "{{ logrotate_service }}"
      state: "{{ service_state }}"
      enabled: "{{ service_enabled }}"
      restarted: true


