    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  loop_control:
    loop_var: item

- name: Enable virtual hosts on Debian systems
  command:
    cmd: a2ensite {{ item.name }}.conf
    creates: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf-enabled"
  when: ansible_os_family == 'Debian'
  notify: Test httpd configuration validity and Restart httpd
  loop: "{{ httpd_vhosts }}"
  loop_control:
    loop_var: item


