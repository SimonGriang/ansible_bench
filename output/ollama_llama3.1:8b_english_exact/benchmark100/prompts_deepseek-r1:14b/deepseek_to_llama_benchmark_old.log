---
- name: Install OpenJDK
  tasks:
  - name: Migrate adoptopenjdk to temurin (if selected)
    set_fact:
      java_jdk_vendor: 'temurin' if java_jdk_vendor == 'adoptopenjdk' else java_jdk_vendor

  - name: Gather OS specific variables
    include_vars:
      file: 'vars/{{ java_jdk_vendor }}-os.yml'
      name: os_specific_vars

  - name: Gather architecture specific variables
    include_vars:
      file: 'vars/{{ ansible_architecture }}-vars.yml'
      name: arch_specific_vars

  - name: Set OS specific variables (I)
    set_fact:
      java_version: '{{ os_specific_vars.java_version }}'
      java_repos: '{{ os_specific_vars.java_repos }}'
      java_libs: '{{ os_specific_vars.java_libs }}'

  - name: Set OS and architecture specific variables (II)
    set_fact:
      java_install_path: '{{ arch_specific_vars.java_install_path }}'
      java_package: '{{ arch_specific_vars.java_package }}'

  - name: Set specific variables
    set_fact:
      java_home: '{{ java_install_path }}'

  - name: Debian pre-requisites
    when: ansible_distribution == 'Debian'
    block:
      - name: Remove deprecated repositories
        apt:
          name: '{{ java_repos }}'
          state: absent

      - name: Install extra apt tools
        apt:
          name: '{{ os_specific_vars.extra_apt_tools }}'
          state: present

      - name: Add key repositories
        apt_key:
          url: '{{ os_specific_vars.key_url }}'
          state: present

      - name: Add required repositories
        apt_repository:
          repo: '{{ os_specific_vars.repo }}'
          state: present

  - name: RedHat pre-requisites
    when: ansible_distribution == 'RedHat'
    block:
      - name: Add key repositories
        rpm_key:
          state: present

      - name: Add required repositories
        yum_repository:
          name: '{{ os_specific_vars.repo }}'
          state: present

  - name: Install required libs
    become: yes
    apt:
      name: '{{ java_libs }}'
      state: present

  - name: Install Java, Debian
    when: ansible_distribution == 'Debian'
    apt:
      name: '{{ java_package }}'
      state: present

  - name: Install Java, RedHat
    when: ansible_distribution == 'RedHat'
    yum:
      name: '{{ java_package }}'
      state: present

  - name: Export environment variables
    template:
      src: templates/java-environment.sh.j2
      dest: /etc/profile.d/java-environment.sh
      mode: '0644'

  - name: Source environment variables
    become: yes
    shell:
      cmd: source /etc/profile.d/java-environment.sh

  - name: Correct java version selected for Java < 11
    when: java_version < 11
    become: yes
    shell:
      cmd: update-alternatives --set java /usr/lib/jvm/{{ java_install_path }}/jre/bin/java

  - name: Correct java version selected for Java >= 11
    when: java_version >= 11
    become: yes
    shell:
      cmd: update-alternatives --set java /usr/lib/jvm/{{ java_install_path }}/bin/java


