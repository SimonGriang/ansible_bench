---
- name: Configure Cron Service
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install cron package
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  lineinfile:
    path: /etc/cron.d/crontab
    line: SHELL=/bin/bash
    state: present

- name: Configure cron path environment
  lineinfile:
    path: /etc/cron.d/crontab
    line: PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    state: present

- name: Configure cron mailto settings
  lineinfile:
    path: /etc/cron.d/crontab
    line: MAILTO="root"
    state: present

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: true
  when: cron_service is defined

- name: Schedule cron jobs
  cron:
    job: "{{ item }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    dayofweek: "{{ item.dayofweek }}"
  loop: "{{ cron_jobs }}"

