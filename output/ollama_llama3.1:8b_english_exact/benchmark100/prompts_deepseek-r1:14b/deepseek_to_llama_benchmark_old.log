    template:
      src: rke2.conf.j2
      dest: /etc/rke2/agent.conf
      mode: '0644'
    notify: rke2 restart

  - name: Copy Kubelet configuration file
    template:
      src: kubelet.conf.j2
      dest: /etc/systemd/system/kubelet.service.d/10-kubelet.conf
      mode: '0644'
    when: kubelet_config is defined
    notify: kubelet restart

  - name: Copy Containerd Registry Configuration file
    copy:
      content: "{{ containerd_registry_config }}"
      dest: /etc/containerd/config.toml
      mode: '0644'
    when: containerd_registry_config is defined
    notify: containerd restart

  - name: Start RKE2 service on other nodes
    service:
      name: rke2
      state: started
      enabled: yes
    when: inventory_hostname != groups['nodes'][0]

  - name: Mask other RKE2 services on nodes
    systemd:
      name: rke2-{{ node_type }}
      state: masked
    when: node_type == 'agent' or node_type == 'server'

  - name: Wait for remaining nodes to be ready - no CNI
    wait_for:
      host: "{{ groups['nodes'][0] }}"
      port: 22
      timeout: 300
      delay: 10
      state: started
    when: cni != true

  - name: Wait for remaining nodes to be ready - with CNI
    wait_for:
      host: "{{ groups['nodes'][0] }}"
      port: 22
      timeout: 300
      delay: 10
      state: started
    when: cni == true

