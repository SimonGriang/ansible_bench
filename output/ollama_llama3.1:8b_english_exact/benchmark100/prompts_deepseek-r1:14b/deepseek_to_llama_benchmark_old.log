      src: templates/header_checks.erb
      dest: /etc/postfix/header_checks
      notify: postfix_rebuild

  - name: Setting values for main.cf (1/2)
    set_fact:
      postfix_recipient_access: "permit_mynetworks, reject"

  - name: Setting values for main.cf (2/2)
    set_fact:
      postfix_mynetworks: "192.168.1.0/24"
      postfix_mydestination: "example.com"
      postfix_relay_domains: "example.com"

  - name: Configure postfix (main.cf)
    template:
      src: templates/main.cf.erb
      dest: /etc/postfix/main.cf
      notify: postfix_restart

  - name: Configure postfix (master.cf)
    template:
      src: templates/master.cf.erb
      dest: /etc/postfix/master.cf
      notify: postfix_restart

  - name: Creates cert/key directory
    file:
      path: /etc/letsencrypt/live/example.com
      state: directory
      mode: '0755'

  - name: Deploy Postfix TLS server certificate
    copy:
      content: "{{ lookup('file', '/etc/letsencrypt/live/example.com/fullchain.pem') }}"
