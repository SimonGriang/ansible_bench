--- 

- name: Import assert.yml role
  include_role:
    name: assert
    tasks_from: assert.yml
    delegate_to: localhost

- name: Install git package
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if a user exists
  user:
    name: "{{ git_username }}"
    state: absent
  when: git_username is defined

- name: Create a directory for git configuration
  file:
    path: /home/{{ git_username }}
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
  when: git_username is defined and user.exists

- name: Configure git
  template:
    src: gitconfig.j2
    dest: /home/{{ git_username }}
    mode: '0644'
  when: user.exists and git_username is defined and git_user_email is defined and git_user_name is defined and git_username is defined

- name: Create the repository destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
  when: user.exists

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}/{{ item.repo.split('/')[-1] }}"
    version: "{{ item.version | default('HEAD') }}"
    force: "{{ item.force | default(false) }}"
    clone: true
  loop: "{{ git_repositories }}"
  when: user.exists and git_repository_destination is defined and git_repositories is defined

