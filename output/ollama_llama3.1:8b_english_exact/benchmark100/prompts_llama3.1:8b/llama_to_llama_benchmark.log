---
- name: SELinux configuration
  hosts: localhost
  gather_facts: no

  tasks:
  - import_tasks: assert.yml
    when: assertion

  - name: Install SELinux packages
    ansible.builtin.package:
      name: "{{ selinux_requirements }}"
      state: present
    notify: Gather facts

  - meta: flush_handlers

  - name: Configure SELinux
    when: selinux_enabled and (ansible_connection != 'docker' and ansible_connection != 'docker_container')
    block:
    - name: Configure SELinux booleans
      ansible.posix.selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
    - name: Manage SELinux booleans
      ansible.posix.seboolean:
        name: "{{ item.name }}"
        persistent: "{{ item.persistent }}"
        state: "{{ item.state }}"
      loop: "{{ selinux_booleans }}"
      when: selinux_booleans is defined
    notify: Reboot

  handlers:
  - name: Reboot
    ansible.builtin.reboot:
      msg: Rebooting the system

  - name: Gather facts
    setup:
      filter: 'ansible_facts'


