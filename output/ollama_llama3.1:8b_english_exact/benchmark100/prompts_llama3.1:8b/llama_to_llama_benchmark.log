---
- name: Tasks for Java setup
  tasks:

  - name: Migrate adoptopenjdk to temurin (if selected)
    set_fact:
      java_jdk_vendor: "temurin"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Gather OS specific variables
    include_vars:
      file: "vars/{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_major_version }}.yml"

  - name: Gather architecture specific variables
    include_vars:
      file: "architecture.yml"

  - name: Set OS-specific variables (I)
    set_fact:
      java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-' + java_jdk_vendor + '-{{ java_jdk_version }}') }}"
    when: java_open_jdk_package is not undefined and java_open_jdk_package is not null

  - name: Set OS and architecture specific variables (II)
    set_fact:
      java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/' + java_jdk_vendor) }}"
    when: java_open_jdk_home_dir is not undefined and java_open_jdk_home_dir is not null

  - name: Set specific variables
    set_fact:
      java_home: "{{ java_open_jdk_home_dir }}"

  - name: Debian pre-requisites
    when: ansible_distribution == "Debian"
    tasks:
      - name: Remove deprecated repositories
        apt:
          name: "{{ item }}"
          state: absent
        loop: ["java-backports", "ppa:openjdk/r"]

      - name: Install extra apt tools
        apt:
          name: "{{ item }}"
          state: present
        loop: ["software-properties-common", "apt-transport-https"]

      - name: Add required key repositories
        apt_key:
          url: "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x6488DCD7A8D893D4EEBE8758E57F6F3E1398D57F"
          id: "6488DCD7A8D893D4EEBE8758E57F6F3E1398D57F"
        when: java_jdk_vendor == "temurin"

      - name: Add required repositories
        apt_repository:
          repo: "ppa:temurin/ppa"
          state: present
        when: java_jdk_vendor == "temurin"

  - name: RedHat pre-requisites
    when: ansible_distribution == "RedHat"
    tasks:
      - name: Add required key repositories
        rpm_key:
          id: "6488DCD7A8D893D4EEBE8758E57F6F3E1398D57F"
          state: present

      - name: Add required repositories
        yum_repository:
          name: "temurin"
          description: "Temurin OpenJDK Repository"
          baseurl: "https://download.java.net Temurin OpenJDK Repository"
          gpgcheck: true
        when: java_jdk_vendor == "temurin"

  - name: Install required libs
    apt:
      name: "{{ item }}"
      state: present
    loop: ["default-jre", "default-jdk"]
    when: ansible_distribution == "Debian"

  - name: Install Java, Debian
    apt:
      name: "{{ java_open_jdk_package }}"
      state: present
    when: ansible_distribution == "Debian"

  - name: Install Java, RedHat
    yum:
      name: "{{ java_open_jdk_package }}"
      state: present
    when: ansible_distribution == "RedHat"

  - name: Export environment variables
    template:
      src: "templates/jdk.sh.j2"
      dest: "/etc/profile.d/jdk.sh"
      mode: '0644'

  - name: Source environment variables
    shell: "source /etc/profile"

  - name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
    lineinfile:
      dest: "/usr/bin/java"
      line: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java"
    when: java_jdk_version < 11

  - name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
    lineinfile:
      dest: "/usr/bin/java"
      line: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java"
    when: java_jdk_version >= 11


