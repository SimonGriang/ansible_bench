---

- name: Check if Helm binary exists at specified path
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check current version of Helm installed on system
  shell:
    cmd: "{{ helm_bin_path }}/version"
    chdir: "{{ helm_bin_path | dirname }}"
  register: helm_existing_version
  changed_when: false
  failed_when: false

- name: Download Helm binary from specified repository
  get_url:
    url: "{{ helm_repo_path }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}"
    dest: "/tmp/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}"
    mode: '0644'
  when: not helm_check.stat.exists or helm_existing_version.stdout != helm_version

- name: Copy downloaded Helm binary into place at specified path
  copy:
    content: "{{ lookup('file', '/tmp/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}') }}"
    dest: "{{ helm_bin_path }}"
    mode: '0755'
    remote_src: true
  become: true
  when: helm_existing_version.stdout != helm_version

