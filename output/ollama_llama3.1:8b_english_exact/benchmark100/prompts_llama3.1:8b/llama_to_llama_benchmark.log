---
- name: Configure Services
  hosts: localhost
  tasks:

  - name: Import and run tasks from assert.yml playbook
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install required packages for the service
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ service_required_packages }}"

  - name: Configure systemd service for each item in the service_list
    template:
      src: systemd.j2
      dest: "/etc/systemd/system/{{ item.name }}.service"
      mode: '0644'
    notify: Systemctl daemon-reload
    loop: "{{ service_list }}"

  - name: Configure sysvinit service for each item in the service_list
    template:
      src: sysvinit.j2
      dest: "/etc/init.d/{{ item.name }}"
      mode: '0755'
    when: init_system in ['sysvinit', 'upstart', 'openrc']
    loop: "{{ service_list }}"

  - name: Manage each service in the service_list
    service:
      name: "{{ item.name }}"
      enabled: "{{ item.enabled | default(false) }}"
      state: "{{ item.state | default('started') }}"
    loop: "{{ service_list }}"

  - name: Flush handlers
    meta: flush_handlers


