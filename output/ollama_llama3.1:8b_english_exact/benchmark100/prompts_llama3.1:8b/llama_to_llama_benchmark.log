---

- name: Import assert.yml and run it once on localhost
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install the dns packages
  package:
    name:
      - bind9-dnsutils
      - bind9utils
      - bind9

- name: Create the required directories
  file:
    path: /etc/bind
    state: directory
    mode: '0755'

- name: Create the required group
  group:
    name: bind
    state: present

- name: Create the required user
  user:
    name: bind
    group: bind
    system: yes
    create_home: no

- name: Generate the rndc key
  command: rndc-keygen

- name: Set permissions on the rndc key file
  file:
    path: /etc/bind/rndc.key
    mode: '0644'

- name: Download the named.root file
  get_url:
    url: https://www.internic.net/domain/named.root
    dest: /etc/bind/named.root
    mode: '0644'

- name: Create the zone file
  template:
    src: templates/db.example.com.j2
    dest: /etc/bind/db.example.com
    mode: '0644'
  notify: restart bind

- name: Add zones to the configuration
  template:
    src: templates/named.conf.options.j2
    dest: /etc/bind/named.conf.options
    mode: '0644'
  notify: restart bind

- name: Place the systemd override
  template:
    src: templates/bind.service.j2
    dest: /etc/systemd/system/bind.service.d/override.conf
    mode: '0644'

- name: Reload systemd daemon
  service:
    name: systemd
    state: reloaded

- name: Start and enable the DNS service
  service:
    name: bind
    state: started
    enabled: yes

