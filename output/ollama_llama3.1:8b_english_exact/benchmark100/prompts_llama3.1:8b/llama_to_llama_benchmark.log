--- 

- name: Import assert.yml task
  import_tasks: assert.yml

- name: Install using package task
  block:
  - name: Install repository for RedHat task
    package:
      name: hashicorp-{{ hashicorp_product }}
      state: present
    when: ansible_distribution == 'RedHat' or ansible_distribution == 'Rocky Linux'

  - name: Configure Debian task
    block:
    - name: Install required package gpg task
      package:
        name: gnupg
        state: present
    - name: Install apt key for Debian task
      apt_key:
        keyserver: https://keyserver.ubuntu.com
        id: C80E328D10792D302A10E085C08F1F9787C4BD34
    - name: Install repository for Debian task
      apt_repository:
        repo: 'ppa:hashicorp/{{ hashicorp_product }}'

  - name: Install hashicorp product using package task
    block:
    - name: Install latest hashicorp product using package task
      package:
        name: "{{ hashicorp_product }}"
        state: present
    - name: Install versioned hashicorp product using package task
      package:
        name: "{{ hashicorp_product }}={{ hashicorp_version }}"
        state: present

- name: Install manually task
  block:
  - name: Download hashicorp product
    get_url:
      url: https://releases.hashicorp.com/{{ hashicorp_product }}/{{ hashicorp_version }}/hashicorp-{{ hashicorp_product }}_{{ hashicorp_version }}_linux_amd64.zip
      dest: /tmp
  - name: Unpack hashicorp product
    unarchive:
      src: /tmp/hashicorp-{{ hashicorp_product }}_{{ hashicorp_version }}_linux_amd64.zip
      dest: /tmp
      compression: zip

