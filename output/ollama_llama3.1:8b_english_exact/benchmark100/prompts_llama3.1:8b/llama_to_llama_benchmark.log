- name: Ensure systemd is being used as the init system
  assert:
    that: ansible_distribution in ['Ubuntu', 'Debian', 'RedHat', 'CentOS', 'Fedora']
    message: "This playbook requires systemd init system"

- name: Get the latest release of Grafana Loki from GitHub API
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    status_code: 200
    retries: 5
    delay: 1
  register: _latest_release
  until: _latest_release.status == 200

- name: Set promtail version to the latest release tag if it's set to 'latest'
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name | replace('v', '') }}"
  when: promtail_version == 'latest'

- name: Test if the zip local archive exists in the specified directory
  stat:
    path: "{{ promtail_bin_path }}/promtail-linux-{{ ansible_architecture }}.zip"
  register: promtail_archive
  when: promtail_bin_path != ''

- name: Assert that the local binary exists in the specified directory
  assert:
    that: promtail_archive.stat.exists
    message: "The promtail binary archive doesn't exist in the specified directory"

- name: Get the checksum list for the latest release
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/{{ _latest_release.json.tag_name }}
    method: GET
    status_code: 200
    retries: 5
    delay: 1
  register: __promtail_checksums
  until: __promtail_checksums.status == 200

- name: Get the checksum for the specified architecture
  set_fact:
    __promtail_checksum: "{{ __promtail_checksums.json.assets | json_query('..[?name==`promtail-linux-{{ ansible_architecture }}.zip`].browser_download_url') }}"
  when: promtail_bin_path == ''

