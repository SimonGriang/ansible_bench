        ansible.builtin.seboolean:
          state: enabled
          name: allow_httpd_ssl_port
          port: "{{ https_port }}"
      when: selinux_status.rc == 0

  - name: Configure Apache HTTP Server
    ansible.builtin.template:
      src: "{{ httpd_config_src }}"
      dest: "{{ httpd_config_dest }}"
      mode: '0644'
      notify:
        - Test httpd configuration validity
        - Restart httpd

  - name: Activate specific Apache HTTP Server modules on Debian-based systems
    block:
      - name: Check if system is Debian-based
        ansible.builtin.system_info:
          fact_name: ansible_distribution
          register: system_info
        when: system_info.facts.ansible_distribution is defined
      - name: Activate specific Apache HTTP Server modules
        ansible.builtin.command:
          cmd: a2enmod "{{ item }}"
        loop: "{{ httpd_modules_to_activate_with_command }}"
        notify: Test httpd configuration validity
      when: system_info.facts.ansible_distribution is defined and system_info.facts.ansible_distribution in ['Debian', 'Ubuntu']

  - name: Import tasks related to SSL configuration
    when: https_ssl_enable | bool
    import_tasks: ssl.yml

  - name: Import tasks related to locations configuration
    when: httpd_locations | bool
    import_tasks: locations.yml

  - name: Import tasks related to virtual hosts configuration
    when: httpd_vhosts | bool
    import_tasks: vhosts.yml

  - name: Configure custom ports for Apache HTTP Server
    block:
      - name: Check if system is Debian-based or Suse-based
        ansible.builtin.system_info:
          fact_name: ansible_distribution
          register: system_info
        when: system_info.facts.ansible_distribution is defined
      - name: Configure custom ports
        ansible.builtin.template:
          src: "{{ httpd_ports_conf }}"
          dest: "{{ httpd_ports_conf_dest }}"
          mode: '0644'
          notify:
            - Test httpd configuration validity
            - Restart httpd
      when: system_info.facts.ansible_distribution is defined and system_info.facts.ansible_distribution in ['Debian', 'Ubuntu', 'SUSE']

  - name: Import tasks related to directories configuration
    when: httpd_directories | bool
    import_tasks: directories.yml

  - name: Flush handlers
    ansible.builtin.meta:
      flush_handlers: yes

  - name: Remove default index.html file from Apache HTTP Server's data directory
    when: httpd_remove_example | bool
    ansible.builtin.file:
      path: "{{ httpd_remove_example }}"
      state: absent

  - name: Start and enable Apache HTTP Server service
    ansible.builtin.service:
      name: httpd
      state: started
      enabled: yes

