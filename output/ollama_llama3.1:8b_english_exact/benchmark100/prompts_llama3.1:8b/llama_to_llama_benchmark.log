---
- name: RKE2 setup tasks
  hosts: localhost
  gather_facts: no

  tasks:
  - name: Create the RKE2 config directory
    file:
      path: /etc/rancher/rke2
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Set server taints
    set_fact:
      combined_node_taints: "{{ rke2_server_node_taints }}"
    when: rke2_type == 'server'

  - name: Set agent taints
    set_fact:
      combined_node_taints: "{{ rke2_agent_node_taints }}"
    when: rke2_type == 'agent'

  - name: Copy RKE2 config
    copy:
      content: "{{ lookup('template', 'rke2.conf.j2') | template }}"
      dest: /etc/rancher/rke2/rke2.conf
      owner: root
      group: root
      mode: '0644'
    notify: Config file changed

  - name: Copy kubelet config
    copy:
      content: "{{ rke2_kubelet_config | default('') }}"
      dest: /etc/rancher/rke2/kubelet.conf
      owner: root
      group: root
      mode: '0644'
    when: rke2_kubelet_config is not empty
    notify: Config file changed

  - name: Copy Containerd Registry Configuration file
    copy:
      content: "{{ lookup('template', 'containers.json.j2') | template }}"
      dest: /etc/rancher/rke2/containers.json
      owner: root
      group: root
      mode: '0644'
    when: (rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty)
    notify: Config file changed

  - name: Start RKE2 service on the rest of the nodes
    service:
      name: rke2
      state: started
      enabled: yes
    when: inventory_hostname != groups['rke2'][0]
    retries: 3
    delay: 10
    notify: Service (re)started

  - name: Mask other RKE2 service on the rest of the nodes
    service:
      name: "{{ item }}"
      state: masked
    loop: "{{ groups['rke2'] | difference([groups['rke2'][0]]) | map('extract', item, 'name') }}"
    when: item != rke2_type

  - name: Wait for remaining nodes to be ready - no CNI
    wait_for:
      host: "{{ groups['rke2'] | difference([groups['rke2'][0]]) | first }}"
      port: 22
      state: started
      delay: 10
      timeout: 300
    retries: 3
    loop: "{{ groups['rke2'] | difference([groups['rke2'][0]]) }}"

  - name: Wait for remaining nodes to be ready - with CNI
    wait_for:
      host: "{{ groups['rke2'] | difference([groups['rke2'][0]]) | first }}"
      port: 22
      state: started
      delay: 10
      timeout: 300
    retries: 3
    when: (inventory_hostname == groups['rke2'][0] or inventory_hostname in groups['rke2'][:2])
    loop: "{{ groups['rke2'] | difference([groups['rke2'][0]]) }}"

  handlers:
    - name: Config file changed
      service:
        name: rke2
        state: restarted
        enabled: yes

    - name: Service (re)started
      service:
        name: rke2
        state: started
        enabled: yes


