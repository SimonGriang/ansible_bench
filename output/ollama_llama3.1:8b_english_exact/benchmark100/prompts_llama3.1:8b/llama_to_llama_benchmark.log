---
- name: Configure Apache Vhosts
  hosts: all
  become: true

  tasks:
  - name: Create the document root directory for each vhost
    file:
      path: "/var/www/{{ item.name }}"
      state: directory
      mode: '0755'
    with_items: "{{ httpd_vhosts }}"

  - name: Configure the Apache vhost configuration files
    template:
      src: templates/vhost_conf_template.conf.j2
      dest: "/etc/apache2/sites-available/{{ item.name }}.conf"
      mode: '0644'
    with_items: "{{ httpd_vhosts }}"

  - name: Enable Apache vhosts on Debian systems
    command: a2ensite {{ item.name }}
    when: ansible_distribution == 'Debian'
    with_items: "{{ httpd_vhosts }}"


