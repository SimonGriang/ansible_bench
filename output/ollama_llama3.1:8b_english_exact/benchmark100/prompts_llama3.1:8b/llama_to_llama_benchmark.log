---
- name: Cordon and Drain the Node
  rke2:
    cordon: yes
    drain: yes
    node_name: "{{ rke2_node_name }}"
    data_path: "{{ rke2_data_path }}"
    additional_drain_args: "{{ rke2_drain_additional_args }}"
  retries: 100
  delay: 15

- name: Restart the RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
    enabled: yes

- name: Wait for all nodes to be ready
  kubectl:
    cmd: get nodes --field-selector status.phase=Ready
    data_path: "{{ rke2_data_path }}"
    cluster_group_name: "{{ rke2_cluster_group_name }}"
    state: present
  retries: 100
  delay: 15

- name: Uncordon the Node
  rke2:
    cordon: no
    node_name: "{{ rke2_node_name }}"
    data_path: "{{ rke2_data_path }}"

- name: Wait for all pods to be ready
  kubectl:
    cmd: get pods --field-selector status.phase=Running
    data_path: "{{ rke2_data_path }}"
    state: present
  retries: 100
  delay: 15

- name: Wait for all pods to pass readiness checks
  kubectl:
    cmd: get pods --field-selector status.phase=Running --field-selector=ready=true
    data_path: "{{ rke2_data_path }}"
    wait_for_all_pods_to_be_healthy_args: "{{ rke2_wait_for_all_pods_to_be_healthy_args }}"
  retries: 100
  delay: 15

