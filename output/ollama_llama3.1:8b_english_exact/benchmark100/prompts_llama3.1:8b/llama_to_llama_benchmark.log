  - name: Include assertions from assert.yml
    include: assert.yml

  - name: Install the MySQL package
    package:
      name: mysql
      state: present
    notify:
      - set_root_password
      - systemctl_daemon_reexec

  - name: Configure the MySQL server
    ini_file:
      filename: /etc/my.cnf
      section: mysql
      option: "{{ item.key }}"
      value: "{{ item.value }}"
    notify:
      - restart_mysql
    with_dict: "{{ mysql_configuration_options }}"

  - name: Configure the MySQL client
    ini_file:
      filename: /etc/mysql/client.cnf
      section: client
      option: socket
      value: /var/run/mysqld/mysqld.sock

  - name: Initialize the MySQL database
    shell: "{{ mysql_initialize_command }}"

  - name: Start and enable the MySQL service
    service:
      name: mysql
      state: started
      enabled: yes

  - name: Flush handlers
    meta: flush_handlers

  - name: Place the my.cnf file
    template:
      src: my.cnf.j2
      dest: /root/.my.cnf

  - name: Create databases
    mysql_db:
      login_user: root
      login_password: ""
      login_host: localhost
      name: "{{ item.name }}"
      state: present
      no_log: true
    loop: "{{ mysql_databases }}"
    loop_control:
      loop_var: item

  - name: Create users
    mysql_user:
      login_user: root
      login_password: ""
      login_host: localhost
      name: "{{ item.name }}"
      host: "{{ item.host }}"
      password: "{{ item.password }}"
      priv: "{{ item.priv }}"
      state: present
      no_log: true
    loop: "{{ mysql_users }}"
    loop_control:
      loop_var: item

  - name: Flush handlers again
    meta: flush_handlers

