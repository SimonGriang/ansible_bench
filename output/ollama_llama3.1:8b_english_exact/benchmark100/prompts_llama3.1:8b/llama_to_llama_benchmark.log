- name: Ensure the /etc/openvpn/client directory exists with correct permissions
  become: true
  ansible.builtin.file:
    path: /etc/openvpn/client
    state: directory
    owner: openvpn
    group: openvpn
    mode: '0750'

- name: Place the client configuration file in the specified directory
  become: true
  ansible.builtin.template:
    src: client.conf.j2
    dest: /etc/openvpn/client/client.conf
    owner: openvpn
    group: openvpn
    mode: '0600'
  notify:
    - Restart openvpn service

- name: Ensure the client configuration file is not world readable
  become: true
  ansible.builtin.file:
    path: /etc/openvpn/client/client.conf
    owner: openvpn
    group: openvpn
    mode: '0600'

