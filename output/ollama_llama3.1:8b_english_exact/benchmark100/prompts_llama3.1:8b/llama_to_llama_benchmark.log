---
- name: Enable Backports repository
  apt_repository:
    repo: 'ppa:ondrej/php'
    state: present

- name: Set default_release option
  set_fact:
    default_release: "{{ ansible_distribution_version | int }}"

- name: Set default_release option for older Debian versions
  set_fact:
    default_release: "{{ ansible_distribution_version | int }}-backports"
  when: ansible_distribution_version | int < 9

- name: Set default_release option for Debian 9 and newer
  set_fact:
    default_release: "{{ ansible_distribution_version }}"

- name: Set default_release option for older Debian versions
  set_fact:
    default_release: "{{ default_release | default(ansible_distribution_version | int, True) }}-backports"
  when: ansible_distribution_version | int < 9

- name: Install Ansible package with default release
  apt:
    name: ansible
    state: present
    default_release: "{{ default_release }}"


