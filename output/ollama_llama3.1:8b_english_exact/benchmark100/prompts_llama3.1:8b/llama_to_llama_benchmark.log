---
- name: Restart RKE2 service on a node
  service:
    name: "{{ rke2_node_name }}"
    state: restarted
  notify:
    - Service (re)started

- name: Wait for all nodes to be ready again
  shell:
    cmd: "until [ $(rke2 node list --state Ready | wc -l) -eq $(rke2 node list | wc -l) ]; do sleep 15; done"
  delegate_to: "{{ rke2_servers_group_name[0] if rke2_servers_group_name | length > 0 else 'localhost' }}"
  retries: 100
  delay: 15
  until: check_mode == False
  register: all_ready_nodes

- name: Wait for all pods to be ready again
  shell:
    cmd: "until [ $(rke2 pod list --state Running,Succeeded | wc -l) -eq $(rke2 pod list | wc -l) ]; do sleep 15; done"
  delegate_to: "{{ rke2_servers_group_name[0] if rke2_servers_group_name | length > 0 else 'localhost' }}"
  retries: 100
  delay: 15
  until: check_mode == False and rke2_wait_for_all_pods_to_be_ready
  register: all_pods_ready


