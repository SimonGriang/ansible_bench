  - name: Import external tasks for assertion handling
    include_tasks: assert.yml
  - name: Install the cron package
    package:
      name: "{{ cron_packages }}"
      state: present
  - name: Configure shell settings for cron jobs
    lineinfile:
      dest: /etc/crontab
      line: SHELL="{{ cron_shell }}"
      state: present
  - name: Configure the system path for cron jobs
    lineinfile:
      dest: /etc/crontab
      line: PATH="{{ cron_path }}"
      state: present
  - name: Configure the mail-to setting for cron jobs
    lineinfile:
      dest: /etc/crontab
      line: MAILTO="{{ cron_mailto }}"
      state: present
  - name: Start and enable the cron service
    service:
      name: "{{ cron_service }}"
      state: started
      enabled: yes
  - name: Schedule cron jobs
    cron:
      job: "{{ item.command }} {{ item.time }}"
      minute: "{{ item.minute }}"
      hour: "{{ item.hour }}"
      day: "{{ item.day }}"
      month: "{{ item.month }}"
      dayofweek: "{{ item.dayofweek }}"
    loop: "{{ cron_jobs }}"


