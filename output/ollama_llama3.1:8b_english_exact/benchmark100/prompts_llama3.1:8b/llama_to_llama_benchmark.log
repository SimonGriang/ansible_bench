---
- name: Configure Apache vhosts
  hosts: localhost
  become: yes

  vars:
    httpd_vhosts:
      - name: vhost1
        document_root: /var/www/vhost1
        create_docroot: True
      - name: vhost2
        document_root: /var/www/vhost2
      - name: vhost3
        document_root: /var/www/vhost3

  tasks:
  - name: Create the document root for each vhost
    file:
      path: "{{ item.document_root }}"
      state: directory
      mode: '0755'
    when: item.create_docroot is defined and item.create_docroot|bool or item.document_root is defined
    loop: "{{ httpd_vhosts }}"

  - name: Configure the vhosts
    template:
      src: templates/vhost_conf.j2
      dest: "/etc/apache2/sites-available/{{ item.name }}"
      mode: '0644'
    notify:
      - Test httpd configuration validity
      - Restart httpd
    loop: "{{ httpd_vhosts }}"


