  include: rke2.yml

- name: CIS Hardening
  include: cis.yml
  when: cis_profile is defined

- name: Find Active Server
  include: find_active_server.yml

- name: Enable IPVS kernel module
  enable_kernel_module:
    module: ipvs
  when: haproxy_mode_enabled and inventory_hostname in groups('rke2_servers_group') and ipvs_lb_enabled

- name: Copy kube-vip manifests to the masternode
  include: kubevip.yml
  when: haproxy_mode_enabled and inventory_hostname == groups('rke2_servers_group')[0] and ipvs_lb_enabled

- name: Copy ingress-nginx manifests to the masternode
  include: ingress-nginx.yml
  when: ingress_nginx_values is defined and inventory_hostname == groups('rke2_servers_group')[0]

- name: Prepare very first server node in the cluster
  include: first_server.yml
  when: active_server is not defined or group_by('rke2_servers_group').0 | length == 1

- name: Restore etcd specific tasks
  include: first_server_restore.yml
  when: active_server is defined and (inventory_hostname == groups('rke2_servers_group')[0] or inventory_hostname == groups('rke2_servers_group')[-1] and etcd_restore_required)

- name: Download kubeconfig to ansible localhost
  include: download_kubeconfig.yaml
  when: inventory_hostname == groups('rke2_servers_group')[0] and kubeconfig_required

- name: Prepare and join remaining nodes of the cluster
  include: remaining_nodes.yml
  when: active_server is defined and group_by('rke2_servers_group').0 | length > 1

- name: Rolling cordon and drain restart when version changes - servers
  include: rolling_restart.yml
  when: version_changed and rke2_installed

- name: Rolling cordon and drain restart when version changes - agents
  include: rolling_restart.yml
  when: version_changed and rke2_installed

- name: Flush handlers
  meta:
    flush_handlers

- name: Rolling restart when config files change
  include: change_config.yml
  when: config_files_changed and rke2_restart_required

- name: Final steps
  include: summary.yml

