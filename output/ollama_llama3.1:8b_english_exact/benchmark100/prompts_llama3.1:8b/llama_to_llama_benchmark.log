- name: Include assert package manager tasks
  include_tasks: assert.yml

- name: Configure package management for package manager apk
  apt:
    cache_valid_time: 3600
    state: 'present'
  when: package_manager == 'apk'

- name: Configure package management for package manager apt
  apt:
    autoremove: false
    cache_valid_time: 3600
    package_blacklist:
      - package1
      - package2
    state: 'present'
  when: package_manager == 'apt'

- name: Update all software for package manager dnf
  dnf:
    autoremove: false
    cache_enabled: true
    exclude:
      - package1
      - package2
    state: 'present'
  when: package_manager == 'dnf'

- name: Update all software for package manager pacman
  pacman:
    cache_dir: /var/cache/pacman/pkg
    update_cache: true
    upgrade: true
  when: package_manager == 'pacman'

- name: Configure package management for package manager yum
  dnf:
    autoremove: false
    cache_enabled: true
    exclude:
      - package1
      - package2
  when: package_manager == 'yum' and yum_version != '6'
  notify: ensure yum-utils installed

- name: Ensure yum-utils is installed
  package:
    name: yum-utils
    state: 'present'

- name: Update all software for package manager zypper
  zypper:
    autoremove: false
    update: true
  when: package_manager == 'zypper'


