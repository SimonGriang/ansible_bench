---
- name: SSL Certificate Handling
  hosts: 
  tasks:
  - name: Create an SSL private key
    openssl_privatekey:
      path: /path/to/ssl/private/key.pem
      state: present
      owner: "youruser"
      group: "yourgroup"
      mode: '0644'
  - name: Create an SSL Certificate Signing Request (CSR)
    openssl_csr:
      path: /path/to/ssl/csr.pem
      privatekey_path: /path/to/ssl/private/key.pem
      state: present
      owner: "youruser"
      group: "yourgroup"
      mode: '0644'
  - name: Create an SSL certificate
    x509_certificate:
      path: /path/to/ssl/certificate.pem
      csr_path: /path/to/ssl/csr.pem
      privatekey_path: /path/to/ssl/private/key.pem
      state: present
      owner: "youruser"
      group: "yourgroup"
      mode: '0644'
  - name: Create a PKCS#12 file
    openssl_pkcs12:
      path: /path/to/pkcs12.p12
      privatekey_path: /path/to/ssl/private/key.pem
      certificate_path: /path/to/ssl/certificate.pem
      state: present
      owner: "youruser"
      group: "yourgroup"
      mode: '0644'
  - name: Read the private key
    slurp:
      dest: /path/to/ssl/private/key.pem
      content: private_key
  - name: Read the certificate
    slurp:
      dest: /path/to/ssl/certificate.pem
      content: certificate
  - name: Create a combined private key and certificate file
    copy:
      content: "{{ private_key }}{{ certificate }}"
      dest: /path/to/combined.pem
      owner: "youruser"
      group: "yourgroup"
      mode: '0644'


