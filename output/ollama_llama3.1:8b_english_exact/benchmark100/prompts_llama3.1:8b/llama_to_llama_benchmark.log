  become: yes
  apt_repository:
    repo: 'https://download.docker.com/linux/{{ ansible_distribution | lower }} {{ ansible_distribution_release | lower }}'
    state: present
    update_cache: yes
  when: docker_add_repo

- name: Notify apt update handler
  become: yes
  meta:
    handler: apt_update
    notify: apt update

