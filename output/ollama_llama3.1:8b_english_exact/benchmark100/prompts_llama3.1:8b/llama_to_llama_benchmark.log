irectory\n    mode: \'0700\'\n    owner: {{ user.name }}\n    group: {{ user.name }}\n  become: yes\n\n- name: Deploy authorized keys for the user\n  authorized_key:\n    user: {{ user.name }}\n    state: present\n    key: {{ item.key }}\n    key_state: present\n  loop: "{{ user.authorized_keys }}"\n  when: user.authorized_keys is defined\n\n- name: Remove unauthorized keys for the user\n  authorized_key:\n    user: {{ user.name }}\n    state: absent\n    key: {{ item.key }}\n  loop: "{{ user.unauthorized_keys }}"\n  when: user.unauthorized_keys is defined\n\n- name: Copy the generated private SSH key for the user\n  copy:\n    content: "{{ lookup(\'file\', \'/home/{{ user.name }}/.ssh/id_rsa\') }}"\n    dest: /home/{{ user.name }}/.ssh/private_key\n    mode: \'0400\'\n  when: user.copy_private_key is defined\n\n- name: Check the user\'s password validity\n  shell:\n    cmd: chage -l {{ user.name }}\n  register: result\n  when: user.password_validity is defined\n  become: yes\n\n- name: Set the user\'s password validity\n  shell:\n    cmd: chage -d {{ user.password_validity }} {{ user.name }}\n  when: user.password_validity is defined\n  become: yes\n\n- name: Place the private key file for the user\n  copy:\n    content: "{{ lookup(\'file\', \'/home/{{ user.name }}/.ssh/id_rsa\') }}"\n    dest: /home/{{ user.name }}/.ssh/private_key\n    mode: \'0400\'\n  when: user.private_keys is defined' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-24T02:21:40.542826992Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7935004617, 'load_duration': 123278812, 'prompt_eval_count': 1121, 'prompt_eval_duration': 264093035, 'eval_count': 895, 'eval_duration': 7545997925, 'model_name': 'llama3.1:8b'} id='run--8e13ce4b-b8d9-42ff-b5af-a670b4288904-0' usage_metadata={'input_tokens': 1121, 'output_tokens': 895, 'total_tokens': 2016}
