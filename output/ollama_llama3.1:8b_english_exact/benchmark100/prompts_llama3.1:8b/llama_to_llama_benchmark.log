---
- name: Configure HTTP Server
  hosts: all
  become: yes

  vars:
    httpd_directories:
      - path: /var/www/html
        mode: '0755'
        state: directory
        label: "/var/www/html"
      - path: /var/www/uploads
        mode: '0755'
        state: directory
        label: "/var/www/uploads"

  tasks:
  - name: Create necessary directories for HTTP server
    file:
      path: "{{ item.path }}"
      mode: "{{ item.mode }}"
      state: "{{ item.state }}"
      label: "{{ item.label }}"
    loop: "{{ httpd_directories }}"

  - name: Configure directory configurations for HTTP server
    template:
      src: directory.conf.j2
      dest: "{{ item.path }}/{{ item.path | replace('/', '') }}.conf"
      notify: "Test httpd configuration validity"
      notify: "Restart httpd"
    loop: "{{ httpd_directories }}"

  handlers:
  - name: Test httpd configuration validity
    test: "stat /var/www/html/.conf"

  - name: Restart httpd
    service:
      name: httpd
      state: restarted


