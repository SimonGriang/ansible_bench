---
- name: Configure Pip Settings
  hosts: localhost
  tasks:
  - name: Import assert.yml file
    include_tasks: assert.yml

  - name: Install python pip packages
    pip:
      name: "{{ item }}"
      state: present
    loop: "{{ python_pip_packages }}"

  - name: Configure pip proxy settings
    lineinfile:
      dest: /etc/pip.conf
      line: "proxy = {{ python_pip_proxy }}"
      state: present
    when: python_pip_proxy is defined

  - name: Configure pip trusted host settings
    lineinfile:
      dest: /etc/pip.conf
      line: "trusted-host = {{ python_pip_trusted_host }}"
      state: present
    when: python_pip_trusted_host is defined

  - name: Update pip to the specified version
    pip:
      name: "{{ python_pip_pip_package }}"
      state: present
    when:
      - python_pip_update is defined
      - ansible_distribution_release != "bookworm" and ansible_distribution_release != "noble"
      - ansible_os_family != "Alpine"

  - name: Install requested Python modules
    pip:
      name: "{{ item }}"
      state: present
    loop: "{{ python_pip_modules }}"
    when:
      - ansible_distribution_release != "bookworm" and ansible_distribution_release != "noble"
      - ansible_os_family != "Alpine"


