---

- name: OpenSSL Tasks
  hosts: localhost
  become: true

  tasks:
    - name: Import assert.yml
      include_tasks:
        file: assert.yml
        delegate_to: localhost
        run_once: true

    - name: Install required packages
      apt:
        name: "{{ openssl_requirements }}"
        state: present

    - name: Install pip packages
      pip:
        name: "{{ openssl_pip_packages }}"
        state: present
      when: openssl_pip_packages | length > 0

    - name: Create key directory
      file:
        path: "{{ openssl_key_directory }}"
        state: directory
        mode: "{{ openssl_key_mode }}"
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"

    - name: Create csr directory
      file:
        path: "{{ openssl_csr_directory }}"
        state: directory
        mode: "{{ openssl_csr_mode }}"
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"

    - name: Create crt directory
      file:
        path: "{{ openssl_crt_directory }}"
        state: directory
        mode: "{{ openssl_crt_mode }}"
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"

    - name: Include create.yml tasks
      include_tasks:
        file: create.yml
      loop: "{{ openssl_items }}"
      loop_label: item
      when: openssl_items is defined and openssl_items | length > 0

  # corrected the new line at the end of the file

