---
- name: Bootstrap playbook
  hosts: localhost
  gather_facts: no
  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
  - name: Wait for port
    wait_for: port=22
    become: false
    when: '"container" not in inventory_hostname or bootstrap_wait_for_host is defined'
  - name: Prepare system
    connection: local
    register: bootstrap_connect
    vars:
      bootstrap_timeout: 10
      bootstrap_wait_for_host: true
      bootstrap_become: false
    tasks:
    - name: Check connection
      connection: local
      ping:
      when: bootstrap_connect is defined and bootstrap_connect.connected
    - name: Gather facts
      setup: {}
      when: bootstrap_connect is defined and not bootstrap_connect.connected
    - name: Include gather_facts.yml
      include_tasks: gather_facts.yml
      when: bootstrap_connect is defined and not bootstrap_connect.connected
    - name: Check sudo
      become: true
      become_method: sudo
      become_user: root
      when: bootstrap_connect is defined and bootstrap_connect.sudo
    - name: Install bootstrap packages (raw)
      raw: yum install -y epel-release
      when: bootstrap_connect is defined and not bootstrap_connect.sudo
  - name: Gather Ansible facts
    setup:
  - name: Install bootstrap packages (package)
    package:
      name: '{{ bootstrap_facts_packages }}'
      state: present
      update_cache: true
    become: '{{ bootstrap_become }}'


