  - name: Copy Custom Manifests
    copy:
      content: "{{ lookup('file', '/path/to/custom-manifests') }}"
      dest: "/path/to/rke2-artifacts"
      mode: '0644'
    when: custom_manifests is defined

  - name: Copy Static Pods
    copy:
      content: "{{ lookup('file', '/path/to/static-pods') }}"
      dest: "/path/to/rke2-artifacts"
      mode: '0644'
    when: static_pods is defined

  - name: Copy RKE2 environment file
    copy:
      content: "{{ lookup('file', '/path/to/environment-options') }}"
      dest: "/path/to/environment-options"
      mode: '0644'
    when: environment_options is defined

