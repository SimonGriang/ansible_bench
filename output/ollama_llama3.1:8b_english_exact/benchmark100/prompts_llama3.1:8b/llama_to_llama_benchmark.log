content="---\n\n\n- name: Get the path to the efi variables directory\n  ansible.builtin.stat:\n    path: /sys/firmware/efi/efivars/\n  register: grub_efi\n\n\n- name: Remove the grub.cfg file on EFI systems\n  ansible.builtin.file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: grub_efi.stat.exists\n\n\n- name: Install a user template for grub\n  ansible.builtin.template:\n    src: 01_users.j2\n    dest: /etc/grub.d/01_users\n    mode: '0644'\n    owner: root\n    group: root\n  notify: Update grub\n\n\n- name: Add password to the grub configuration on EFI systems\n  ansible.builtin.lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: 'password --encrypted <password>'\n    insertbefore: EOF\n    state: present\n  when: grub_efi.stat.exists\n\n\n- name: Add password to the grub configuration on MBR systems\n  ansible.builtin.lineinfile:\n    path: /etc/grub2.cfg\n    line: 'password --encrypted <password>'\n    insertbefore: EOF\n    state: present\n  when: grub_efi.stat.exists\n\n\n- name: Modify the grub configuration to allow unrestricted access\n  ansible.builtin.replace:\n    path: '{{ item }}'\n    regexp: '(^|\\n).*--unrestricted'\n    replace: '\\1'\n    backup: False\n  loop: '{{ grub_password_unrestricted_files }}'\n  when: grub_password_unrestricted is True\n  notify: Update grub" additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-24T01:53:39.160064039Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3131077583, 'load_duration': 136614311, 'prompt_eval_count': 639, 'prompt_eval_duration': 141336940, 'eval_count': 346, 'eval_duration': 2851133485, 'model_name': 'llama3.1:8b'} id='run--2c30b094-0707-40af-911c-f4b3c528939d-0' usage_metadata={'input_tokens': 639, 'output_tokens': 346, 'total_tokens': 985}
