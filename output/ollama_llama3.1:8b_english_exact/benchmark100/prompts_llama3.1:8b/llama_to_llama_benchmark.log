---
- name: Postfix configuration tasks
  hosts: all
  gather_facts: no

  tasks:
  - import_tasks: assert.yml
    delegate_to: localhost
    when: not assert

  - name: Configure Debian systems for postfix installation
    debconf:
      name: postfix
      set: mailer_type='no configuration'

  - name: Install postfix package
    apt:
      name: postfix
      state: present

  - name: Install postfix-mysql package
    apt:
      name: postfix-mysql
      state: present
    when: "'mysql' in item | regex('postfix_(virtual_mailbox_maps|virtual_mailbox_domains|virtual_alias_maps|smtp_sasl_password_map_content)') | catch noop" with_items:
      - postfix_virtual_mailbox_maps
      - postfix_virtual_mailbox_domains
      - postfix_virtual_alias_maps
      - postfix_smtp_sasl_password_map_content

  - name: Configure postfix transport maps
    template:
      src: templates/transport.j2
      dest: /etc/postfix/transport
      mode: '0644'
    notify:
      - postconf validate
      - postfix rebuild transport maps

  - name: Configure postfix header checks
    template:
      src: templates/header_checks.j2
      dest: /etc/postfix/header_checks
      mode: '0644'
    notify:
      - postconf validate
      - postfix reload

  - name: Set values for main.cf file
    template:
      src: templates/main.cf.j2
      dest: /etc/postfix/main.cf
      mode: '0644'
    notify:
      - postconf validate
      - postfix restart

  - name: Configure postfix master.cf
    template:
      src: templates/master.cf.j2
      dest: /etc/postfix/master.cf
      mode: '0644'
    notify:
      - postconf validate
      - postfix restart

  - name: Create directories for TLS certificates and keys
    file:
      path: /etc/ssl/private/postfix/
      state: directory
    when: not ansible_distribution == 'Ubuntu'

  - name: Deploy Postfix TLS server certificate
    copy:
      content: "{{ lookup('file', '/etc/ssl/certs/postfix/ssl/postfix.crt') }}"
      dest: /etc/ssl/private/postfix/postfix.crt
      mode: '0644'
    notify:
      - postfix reload

  - name: Deploy Postfix TLS server key
    copy:
      content: "{{ lookup('file', '/etc/ssl/certs/postfix/ssl/postfix.key') }}"
      dest: /etc/ssl/private/postfix/postfix.key
      mode: '0644'
    notify:
      - postfix reload

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure aliases
    template:
      src: templates/aliases.j2
      dest: /etc/aliases
      mode: '0644'
    notify:
      - aliases rebuild
      - postfix reload

  - name: Configure sender_access
    template:
      src: templates/sender_access.j2
      dest: /etc/postfix/sender_access
      mode: '0644'
    notify:
      - sender_access rebuild
      - postfix reload

  - name: Configure recipient_access
    template:
      src: templates/recipient_access.j2
      dest: /etc/postfix/recipient_access
      mode: '0644'
    notify:
      - recipient_access rebuild
      - postfix reload

  - name: Place sasl_password_map
    template:
      src: templates/sasl_password_map.j2
      dest: /etc/postfix/sasl_password_map
      mode: '0644'
    notify:
      - sasl_password_map rebuild
      - postfix reload

  - name: Flush handlers again
    meta: flush_handlers

  - name: Start and enable postfix service
    service:
      name: postfix
      state: started
      enabled: yes


