---
- name: Sysctl Settings
  hosts: all
  tasks:
  - name: Import assert.yml tasks
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install sysctl requirements
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ sysctl_requirements }}"
    when: not ansible_connection.is_container

  - name: Set sysctl settings
    sysctl:
      name: "{{ item.name }}"
      value: "{{ item.value }}"
    loop: "{{ sysctl_items|default([]) }}"
    when: sysctl_items is defined and item.name is defined and item.value is defined and not ansible_connection.is_container
    notify: sysctl reload

  handlers:
  - name: sysctl reload
    service:
      name: sysctl
      state: reloaded


