---
- name: RKE2 playbook
  hosts: all
  become: true

  tasks:
  - name: Download RKE2 installation script
    get_url:
      url: "https://example.com/rke2-install.sh"
      dest: "/path/to/rke2-install.sh"
      mode: '0644'

  - name: Copy local RKE2 installation script
    copy:
      content: "{{ lookup('file', '/path/to/local/rke2-install.sh') }}"
      dest: "/path/to/rke2-install.sh"
      mode: '0644'
    when: (in_airgap and implementation == 'copy')

  - name: Create RKE2 artifacts folder
    file:
      path: "/path/to/rke2-artifacts"
      state: directory
      mode: '0755'
    when: (in_airgap and implementation != 'exists')

  - name: Download RKE2 checksum and artifacts
    get_url:
      url: "https://example.com/rke2-checksum.tar.gz"
      dest: "/path/to/rke2-artifacts"
      mode: '0644'
    when: (in_airgap and implementation == 'download')
    register: download_result
    until: download_result is not failed

  - name: Airgap mode - additional images tarballs
    file:
      path: "/path/to/extra-images.tar"
      state: directory
      mode: '0755'
    when: (in_airgap and implementation != 'exists' and extra_images is defined)

  - name: Airgap mode - ensure artifacts exist and have acceptable permissions
    file:
      path: "/path/to/rke2-artifacts"
      state: directory
      mode: '0755'
    when: (in_airgap and implementation == 'exists')

  - name: Populate service facts
    service_facts:
      gather_subset: ['all']

  - name: Get stats of the FS object
    filesystem:
      path: "/path/to/rke2-artifacts"
      stat: yes

  - name: Check if separate partition
    shell:
      cmd: "grep -q '/usr/local' /proc/mounts && echo yes || echo no"
      register: is_separate_partition
    changed_when: False

  - name: Set RKE2 bin path
    set_fact:
      rke2_bin_path: "/usr/local/bin"
    when: (rke2_bin_path is not defined or is_separate_partition.stdout == "yes")

  - name: Check RKE2 version
    shell:
      cmd: "rke2 --version && rke2 service status"
      register: rke2_version

  - name: Set RKE2 versions
    set_fact:
      rke2_version: rke2_version.stdout
    when: rke2_version|default('') != ''

  - name: Prevent accidental RKE2 downgrade
    assert:
      that: rke2_version >= rke2_desired_version
      msg: "RKE2 downgrade detected"

  - name: Run RKE2 install script
    shell:
      cmd: "/path/to/rke2-install.sh --version {{ rke2_desired_version }}"
    when: (rke2_version != rke2_desired_version)

  - name: Copy Custom Manifests
    copy:
      content: "{{ lookup('file', '/path/to/custom-manifests') }}"
      dest: "/path/to/rke2-artifacts"
      mode: '0644'
    when: custom_manifests is defined

  - name: Copy Static Pods
    copy:
      content: "{{ lookup('file', '/path/to/static-pods') }}"
      dest: "/path/to/rke2-artifacts"
      mode: '0644'
    when: static_pods is defined

  - name: Copy RKE2 environment file
    copy:
      content: "{{ lookup('file', '/path/to/environment-options') }}"
      dest: "/path/to/environment-options"
      mode: '0644'
    when: environment_options is defined



