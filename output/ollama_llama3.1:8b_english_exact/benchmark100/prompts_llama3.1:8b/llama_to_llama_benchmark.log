---

- name: Enable specific Apache2 modules
  apt:
    name: apache2
    state: present
  when: ansible_distribution in ['Debian', 'Suse']

- name: Enable proxy and proxy_http Apache2 modules
  a2enmod:
    name: "{{ item }}"
  loop:
    - proxy
    - proxy_http

- name: Configure Apache2 locations
  template:
    src: location.conf.j2
    dest: /etc/apache2/conf.d/{{ item.location }}
    mode: '0644'
    notify: Test httpd configuration validity
  loop: "{{ httpd_locations }}"
  when: httpd_locations is defined

- name: Configure location directories
  file:
    path: "/etc/apache2/conf.d/{{ item.location }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_locations }}"
  when: httpd_locations is defined

