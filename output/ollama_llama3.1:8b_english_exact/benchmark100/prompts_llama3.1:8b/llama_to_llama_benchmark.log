        state: present

    - name: Include installation method specific tasks
      import_tasks: "{{ vault_installation_method }}.yml"

    - name: Add Vault environment variables
      lineinfile:
        dest: /etc/vault.d/vault.env
        line: "{{ item.key }}={{ item.value }}"
        state: present
        create: true
      with_items: "{{ vault_environment_settings }}"
      notify: restart vault

    - name: Include hardening tasks
      import_tasks: hardening.yml

    - name: Start and enable vault on OSS
      service:
        name: vault
        state: started
        enabled: true
      when: vault_type == "oss"

    - name: Enable vault (non-OSS)
      service:
        name: vault
        state: enabled
      when: vault_type != "oss"


