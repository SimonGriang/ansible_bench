---
- name: RKE2 configuration tasks
  hosts: localhost
  gather_facts: true

  tasks:
  - name: Create the RKE2 config directory
    file:
      path: /etc/rancher/rke2
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Set server taints
    set_fact:
      server_taints: "{{ rke2_server_node_taints }}"
    when: server_type == 'server'

  - name: Copy RKE2 config
    template:
      src: "{{ rke2_config }}"
      dest: /etc/rancher/rke2/config.yaml
      owner: root
      group: root
      mode: '0600'
    notify: Config file changed

  - name: Copy kubelet config
    template:
      src: "templates/kubelet-config.yaml.j2"
      dest: /etc/rancher/rke2/kubelet-config.yaml
      owner: root
      group: root
      mode: '0600'
    when: rke2_kubelet_config | length > 0
    notify: Config file changed

  - name: Copy Containerd Registry Configuration file
    copy:
      content: "{{ rke2_custom_registry_path }}"
      dest: /etc/rancher/rke2/registries.yaml
      owner: root
      group: root
      mode: '0600'
    when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
    notify: Config file changed

  - name: Register etcd restore from file
    set_fact:
      do_etcd_restore: true
    when: rke2_etcd_snapshot_file | length > 0 and (rke2_server | default(undefined) | getattribute('service') is undefined or rke2_server | default(undefined) | getattribute('service') | default(undefined) | getattribute('status') == 'disabled')

  - name: Register etcd restore from s3
    set_fact:
      do_etcd_restore_from_s3: true
    when: rke2_etcd_snapshot_file | length > 0 and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options | length > 0

  - name: Restore etcd from file
    block:
      - name: Create the RKE2 etcd snapshot directory
        file:
          path: /etc/rancher/rke2/etcd-snapshot
          state: directory
          owner: root
          group: root
          mode: '0755'
      - name: Copy the etcd snapshot file
        copy:
          content: "{{ rke2_etcd_snapshot_file }}"
          dest: /etc/rancher/rke2/etcd-snapshot/snapshot.db
          owner: root
          group: root
          mode: '0600'
      - name: Restore etcd from the snapshot
        command: rke2 server restore-etcd /etc/rancher/rke2/etcd-snapshot/snapshot.db
    when: do_etcd_restore is defined

  - name: Restore etcd from s3
    command: rke2 server restore-etcd-from-s3 {{ rke2_etcd_snapshot_s3_options }}
    when: do_etcd_restore_from_s3 is defined

  - name: Start RKE2 service on the first server
    service:
      name: rke2-server.service
      state: started
      enabled: true
    when: inventory_hostname == rke2_cluster_group_name[0]
    notify: Service (re)started

  - name: Mask RKE2 agent service on the first server
    service:
      name: rke2-agent.service
      state: masked
    when: inventory_hostname == rke2_cluster_group_name[0]

  - name: Wait for the first server be ready - no CNI
    wait_for:
      host: "{{ inventory_hostname }}"
      port: 8443
      state: started
      delay: 10
      timeout: 300
      connect_timeout: 10
      timeout_message: "The first server {{ inventory_hostname }} is not ready"
      connect_timeout_message: "The first server {{ inventory_hostname }} is not reachable"
    when: inventory_hostname == rke2_cluster_group_name[0]
    until: kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' == 'True' and kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="CNIPluginInitialized")].status}' == 'False'

  - name: Wait for the first server be ready - with CNI
    wait_for:
      host: "{{ inventory_hostname }}"
      port: 8443
      state: started
      delay: 10
      timeout: 300
      connect_timeout: 10
      timeout_message: "The first server {{ inventory_hostname }} is not ready"
      connect_timeout_message: "The first server {{ inventory_hostname }} is not reachable"
    when: inventory_hostname == rke2_cluster_group_name[0]
    until: kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' == 'True'

  - name: Restore etcd
    block:
      - name: Remove old etcd secrets
        command: rke2 server remove-etcd-secrets
      - name: Remove old etcd nodes
        command: rke2 server remove-etcd-nodes
      - name: Create new etcd nodes
        command: rke2 server create-etcd-nodes

  - name: Set an Active Server variable
    set_fact:
      active_server: "{{ inventory_hostname }}"
    delegate_to: "{{ rke2_cluster_group_name[0] }}"
