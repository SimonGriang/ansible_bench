---

- name: Run assert.yml on localhost
  assert:
    state: present
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
    - name: Manage selinux
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot
    - name: Manage selinux booleans
      selinux_bool:
        state: "{{ item.state }}"
        persist: "{{ item.persistence }}"
        name: "{{ item.name }}"
      loop: "{{ selinux_booleans }}"
      when: selinux_booleans is defined and ansible_connection.connection_type not in ["container", "docker", "community.docker.docker"]
  when: selinux_status is defined

- handler: Reboot
  name: Reboot
  description: Reboot the system
  become: yes

- handler: Gather facts
  name: Gather facts
  description: Gather facts
  become: yes

