---

- name: Ensure /etc/openvpn/easy-rsa exists and set permissions
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize the EasyRSA PKI directory
  ansible.builtin.command:
    cmd: easy-rsa --batch init-pki
    chdir: /etc/openvpn/easy-rsa
  notify:
    - EasyRSA init-pki done

- name: Build the CA certificate using EasyRSA
  ansible.builtin.command:
    cmd: easy-rsa --batch build-ca
    chdir: /etc/openvpn/easy-rsa
  notify:
    - EasyRSA build-ca done

- name: Generate the Diffie-Hellman (DH) parameters using EasyRSA
  ansible.builtin.command:
    cmd: easy-rsa --batch gen-dh
    chdir: /etc/openvpn/easy-rsa
  notify:
    - EasyRSA gen-dh done

- name: Build the server certificate using EasyRSA
  ansible.builtin.command:
    cmd: easy-rsa --batch build-server-full
    chdir: /etc/openvpn/easy-rsa
  notify:
    - EasyRSA build-server-full done

- name: Build the client certificate using EasyRSA
  ansible.builtin.command:
    cmd: easy-rsa --batch build-client-full
    chdir: /etc/openvpn/easy-rsa
  notify:
    - EasyRSA build-client-full done

- name: Generate the Certificate Revocation List (CRL) using EasyRSA
  ansible.builtin.command:
    cmd: easy-rsa --batch gen-crl
    chdir: /etc/openvpn/easy-rsa
  notify:
    - EasyRSA gen-crl done

- name: Generate the Diffie-Hellman (DH) key using OpenVPN
  ansible.builtin.command:
    cmd: openvpn --genkey --secret
    chdir: /etc/openvpn/easy-rsa
  notify:
    - OpenVPN genkey done

- name: Copy files to the /etc/openvpn/server directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/ca.crt
    dest: /etc/openvpn/server/ca.crt
    mode: '0644'
  notify:
    - Copy ca.crt to /etc/openvpn/server done

- name: Copy files to the /etc/openvpn/server directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/dh.pem
    dest: /etc/openvpn/server/dh.pem
    mode: '0644'
  notify:
    - Copy dh.pem to /etc/openvpn/server done

- name: Copy files to the /etc/openvpn/server directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/ta.key
    dest: /etc/openvpn/server/ta.key
    mode: '0644'
  notify:
    - Copy ta.key to /etc/openvpn/server done

- name: Copy files to the /etc/openvpn/server directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/issued/server.crt
    dest: /etc/openvpn/server/server.crt
    mode: '0644'
  notify:
    - Copy server.crt to /etc/openvpn/server done

- name: Copy files to the /etc/openvpn/server directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/private/server.key
    dest: /etc/openvpn/server/server.key
    mode: '0644'
  notify:
    - Copy server.key to /etc/openvpn/server done

- name: Copy files to the /etc/openvpn/server directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/issued/client.crt
    dest: /etc/openvpn/server/client.crt
    mode: '0644'
  notify:
