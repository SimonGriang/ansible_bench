---
- name: Import assert.yml file
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    host: "{{ ansible_host }}"
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: (ansible_connection is defined) and (ansible_connection != "container" and ansible_connection != "docker" and ansible_connection != "community.docker.docker")
       and (ansible_connection != none) and (bootstrap_wait_for_host is true)

- name: Prepare system
  block:
    - name: Test connection
      connection: local
    - name: Gather bootstrap facts
      setup: {}
      when: connection failed
    - name: Test sudo access
      become: true
      become_method: sudo
      block:
        - name: Install bootstrap packages
          raw: "dnf install {{ bootstrap_packages }}"
          when: not bootstrap_packages is defined
        - name: Ensure libdnf5 is present
          package:
            name: libdnf5
            state: present
          when: ansible_distribution in ( "Fedora", "RedHat" )
  always:
    - name: Ensure libdnf5 is present
      package:
        name: libdnf5
        state: present
      when: ansible_distribution in ( "Fedora", "RedHat" )

- name: Gather ansible facts
  setup: {}

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become }}"


