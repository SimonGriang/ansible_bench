  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM (Local Java Source)
  copy:
    content: "{{ java_rpm_package }}"
    dest: /tmp/java.rpm
  when:
    - java_source == "local"
    - java_format == "rpm"
  apt:
    name: /tmp/java.rpm
    state: present

- name: Install DEB (Local Java Source)
  copy:
    content: "{{ java_deb_package }}"
    dest: /tmp/java.deb
  when:
    - java_source == "local"
    - java_format == "deb"
  apt:
    name: /tmp/java.deb
    state: present

- name: Install Oracle Java (RPM) (Repository)
  package:
    name: oracle-java-{{ java_version }}
  when:
    - java_source == "repository"
    - java_format == "rpm"

- name: Configure Oracle Targz
  file:
    path: "{{ java_install_directory }}"
    state: directory
  when: java_format == "targz" and java_vendor == "oracle"
  copy:
    content: "{{ java_targz_package }}"
    dest: "{{ java_install_directory }}/java.tar.gz"

- name: Install Oracle Java Policy Software (Targz)
  copy:
    content: "{{ java_policy_package }}"
    dest: "{{ java_install_directory }}/policy.tar.gz"
  when:
    - java_jce
    - java_version == 8
    - java_vendor == "oracle"

- name: Set Alternative (Targz)
  alternatives:
    name: java
    path: /usr/lib/jvm/java-{{ java_version }}
    state: present
  when:
    - java_format == "targz"
    - ansible_distribution != "Alpine"
    - java_vendor == "oracle"

- name: Find JAVA_HOME
  shell:
    cmd: readlink -f /usr/bin/java
  register: java_home

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: JAVA_HOME="{{ java_home.stdout }}"
    state: present


