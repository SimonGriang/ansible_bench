---
- name: FTP Server Setup
  hosts: all
  become: true

  tasks:
  - name: Import task list from 'assert.yml' for validation
    include_tasks:
      file: assert.yml
      run_once: true

  - name: Install vsftpd package
    package:
      name: vsftpd
      state: present

  - name: Configure vsftpd service
    template:
      src: vsftpd.conf.j2
      dest: /etc/vsftpd.conf
      mode: '0644'
      owner: root
      group: root
    notify:
      - restart vsftpd

  - name: Start and enable vsftpd service
    service:
      name: vsftpd
      state: started
      enabled: true

