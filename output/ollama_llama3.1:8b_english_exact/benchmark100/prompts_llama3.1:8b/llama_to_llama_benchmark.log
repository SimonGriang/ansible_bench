ion': 7913461854, 'load_duration': 111851079, 'prompt_eval_count': 1097, 'prompt_eval_duration': 254456166, 'eval_count': 906, 'eval_duration': 7545897831, 'model_name': 'llama3.1:8b'} id='run--b7ee7fce-1c88-472d-a639-8dcf9f551bf2-0' usage_metadata={'input_tokens': 1097, 'output_tokens': 906, 'total_tokens': 2003}
