---
- name: Ensure Docker Compose is installed and up-to-date
  hosts: []
  tasks:
  - name: Check current version of docker-compose
    shell: docker-compose --version
    register: docker_compose_vsn

  - name: Extract version number from docker-compose output
    set_fact:
      docker_compose_current_version: "{{ docker_compose_vsn.stderr.strip.split(' ')[2] }}"

  - name: Remove existing docker-compose version if outdated
    file:
