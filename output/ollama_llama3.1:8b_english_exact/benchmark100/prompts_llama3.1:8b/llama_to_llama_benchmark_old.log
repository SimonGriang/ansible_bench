---
- name: Configure MySQL server
  assert:
    that: mysql_package is installed
    msg: 'MySQL package is not installed'

- name: Install MySQL package
  package:
    name: mysql
    state: present
  notify:
    - set_root_password
    - systemctl daemon-reexec

- name: Configure MySQL server
  ini_file:
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'
    section: mysqld
    options: "{{ mysql_configuration_options | dict2items | items2dict }}"
  notify:
    - restart_mysql

- name: Configure MySQL client
  ini_file:
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'
    section: client
    options:
      socket: /var/run/mysqld/mysqld.sock

- name: Initialize MySQL database
  shell: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable MySQL service
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf file
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0600'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: localhost
    login_port: 3306
    state: present
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: '*.*:ALL'
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: localhost
    login_port: 3306
    state: present
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers
  meta: flush_handlers

