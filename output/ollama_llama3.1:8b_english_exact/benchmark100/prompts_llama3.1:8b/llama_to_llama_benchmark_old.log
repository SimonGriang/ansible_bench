---
- name: Configure Grafana Loki and Promtail

  tasks:
  - name: Assert that systemd is being used as the init system
    assert:
      that: ansible_distribution == 'Fedora' or ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian' or ansible_distribution == 'CentOS' or ansible_distribution == 'Red Hat Enterprise Linux' or ansible_distribution == 'Amazon Linux'
      msg: 'This playbook only runs on systems using systemd'

  - name: Get the latest release of the Grafana Loki project from the GitHub API
    uri:
      url: 'https://api.github.com/repos/grafana/loki/releases/latest'
      method: GET
      status_code: 200
      body_format: json
      headers:
        Accept: 'application/json'
      retry: 5
    register: _latest_release
    until: _latest_release.status == 200

  - name: Set the promtail version to the latest release tag (excluding the 'v' prefix) if it's set to 'latest'
    set_fact:
      promtail_version: "{{ _latest_release.json.tag_name | replace('v', '') }}"

  - name: Test if the zip local archive exists in the specified directory
    stat:
      path: "{{ ansible_distribution == 'Fedora' or ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian' or ansible_distribution == 'CentOS' or ansible_distribution == 'Red Hat Enterprise Linux' or ansible_distribution == 'Amazon Linux' ? '/path/to/local/directory/promtail-linux-{{ ansible_architecture }}.zip' : '/path/to/local/directory/promtail-linux-{{ ansible_architecture }}.zip' }}"
      state: file
    register: promtail_zip
    when: ansible_distribution == 'Fedora' or ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian' or ansible_distribution == 'CentOS' or ansible_distribution == 'Red Hat Enterprise Linux' or ansible_distribution == 'Amazon Linux'

  - name: Assert that the local binary exists in the specified directory
    stat:
      path: "{{ ansible_distribution == 'Fedora' or ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian' or ansible_distribution == 'CentOS' or ansible_distribution == 'Red Hat Enterprise Linux' or ansible_distribution == 'Amazon Linux' ? '/path/to/local/directory/promtail-linux-{{ ansible_architecture }}.zip' : '/path/to/local/directory/promtail-linux-{{ ansible_architecture }}.zip' }}"
      state: file
    register: promtail_binary
    when: promtail_zip.stat.exists

  - name: Get the checksum list for the latest release
    uri:
      url: "https://api.github.com/repos/grafana/loki/releases/{{ _latest_release.json.tag_name | replace('v', '') }}/assets"
      method: GET
      status_code: 200
      body_format: json
      headers:
        Accept: 'application/json'
      retry: 5
    register: __promtail_checksums
    until: __promtail_checksums.status == 200

  - name: Get the checksum for the specified architecture
    find:
      files:
        - path: "{{ item.download_url }}"
          name: "{{ item.name }}"
          checksum_algorithm: sha256
          checksum: "{{ item.sha256 }}"
      paths: "{{ __promtail_checksums.json | json_query('.[] | @.browser_download_url') }}"
      register: promtail_checksum
    when: promtail_binary.stat.exists is not true

  - name: Get the checksum for the specified architecture
    find:
      files:
        - path: "{{ item.download_url }}"
          name: "{{ item.name }}"
          checksum_algorithm: sha256
          checksum: "{{ item.sha256 }}"
      paths: "{{ __promtail_checksums.json | json_query('.[] | @.browser_download_url') }}"
      register: promtail_checksum
    when: promtail_binary.stat.exists is true

