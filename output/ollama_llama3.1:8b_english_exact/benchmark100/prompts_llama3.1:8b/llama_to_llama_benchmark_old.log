content='---\n\n\n- name: Import necessary tasks from assert.yml for the httpd role\n  include_tasks: assert.yml\n\n- name: Install the Apache HTTP Server on the target machine\n  ansible.builtin.package:\n    name: "{{ httpd_packages }}"\n    state: present\n\n- name: Configure SELinux settings for the httpd service if SELinux is enabled\n  when: ansible_kernel == \'SELinux-enabled\'\n  ansible.builtin.seboolean:\n    name: "{{ item }}"\n    state: enabled\n    persistent: yes\n  loop: "{{ httpd_sebooleans }}"\n\n- name: Configure SELinux settings for the httpd service (ports)\n  when: ansible_kernel == \'SELinux-enabled\'\n  ansible.builtin.seport:\n    name: "{{ item }}"\n    state: present\n    persistent: yes\n  loop: "{{ httpd_port | default([]) + (httpd_ssl_port | default([]) | map(\'extract\', \'port\') | list) }}"\n\n- name: Configure the Apache HTTP Server on the target machine\n  ansible.builtin.template:\n    src: "{{ httpd_config_src }}"\n    dest: "{{ httpd_config_dest }}"\n    mode: \'0644\'\n  notify:\n  - Test httpd configuration validity\n  - Restart httpd\n\n- name: Activate specific Apache HTTP Server modules on Debian-based systems\n  when: ansible_distribution in [\'Debian\', \'Ubuntu\']\n  ansible.builtin.command:\n    cmd: a2enmod "{{ item }}"\n  loop: "{{ httpd_modules_to_activate_with_command }}"\n  notify:\n  - Test httpd configuration validity\n\n- name: Import tasks related to SSL configuration if the https_ssl_enable variable is defined\n  when: https_ssl_enable\n  include_tasks: ssl.yml\n\n- name: Import tasks related to locations configuration if the httpd_locations variable is defined\n  when: httpd_locations\n  include_tasks: locations.yml\n\n- name: Import tasks related to virtual hosts configuration if the httpd_vhosts variable is defined\n  when: httpd_vhosts\n  include_tasks: vhosts.yml\n\n- name: Configure custom ports for the Apache HTTP Server on Debian-based and Suse-based systems\n  when: (ansible_distribution in [\'Debian\', \'Ubuntu\']) or (ansible_distribution in [\'SUSE\'])\n  ansible.builtin.template:\n    src: "{{ httpd_ports_conf }}"\n    dest: "{{ httpd_ports_dest }}"\n    mode: \'0644\'\n  notify:\n  - Test httpd configuration validity\n  - Restart httpd\n\n- name: Import tasks related to directories configuration if the httpd_directories variable is defined\n  when: httpd_directories\n  include_tasks: directories.yml\n\n- name: Flush handlers to ensure that any pending handlers are executed\n  ansible.builtin.meta:\n    flush_handlers: yes\n\n- name: Remove the default index.html file from the Apache HTTP Server\'s data directory if the httpd_remove_example variable is defined\n  when: httpd_remove_example\n  ansible.builtin.file:\n    path: "{{ httpd_data_dir }}/index.html"\n    state: absent\n\n- name: Start and enable the Apache HTTP Server service\n  ansible.builtin.service:\n    name: httpd\n    enabled: yes\n    state: started' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-13T19:08:37.763073499Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5993819313, 'load_duration': 113210677, 'prompt_eval_count': 1110, 'prompt_eval_duration': 255548254, 'eval_count': 672, 'eval_duration': 5623364997, 'model_name': 'llama3.1:8b'} id='run--7dbed44d-dab5-46f5-9db9-4c0b234130b5-0' usage_metadata={'input_tokens': 1110, 'output_tokens': 672, 'total_tokens': 1782}
