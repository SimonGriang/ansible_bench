al_duration': 15393373, 'eval_count': 435, 'eval_duration': 3634406702, 'model_name': 'llama3.1:8b'} id='run--8588c5f0-ec0a-4c48-b73d-36c1192318b5-0' usage_metadata={'input_tokens': 1388, 'output_tokens': 435, 'total_tokens': 1823}
