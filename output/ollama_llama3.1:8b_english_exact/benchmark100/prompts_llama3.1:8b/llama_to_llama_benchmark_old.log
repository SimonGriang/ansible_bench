---
- name: RKE2 Configuration and Service Management
  hosts: all
  become: true

  tasks:
  - name: Create the RKE2 config directory
    file:
      path: /etc/rancher/rke2
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Set server taints
    set_fact:
      combined_node_taints: "{{ rke2_server_node_taints }}"
    when: rke2_type == 'server'

  - name: Set agent taints
    set_fact:
      combined_node_taints: "{{ rke2_agent_node_taints }}"
    when: rke2_type == 'agent'

  - name: Copy RKE2 config
    copy:
      content: "{{ rke2_config | to_nice_str }}"
      dest: /etc/rancher/rke2/config.yaml
      owner: root
      group: root
      mode: '0644'
    notify: Config file changed

  - name: Copy kubelet config
    copy:
      content: "{{ rke2_kubelet_config | to_nice_str }}"
      dest: /etc/rancher/rke2/worker/kubelet.yaml
      owner: root
      group: root
      mode: '0644'
    when: rke2_kubelet_config != ""
    notify: Config file changed

  - name: Copy Containerd Registry Configuration file
    copy:
      content: "{{ rke2_custom_registry_mirrors | to_nice_str }}"
      dest: /etc/rancher/rke2/worker/containerd-registry.yaml
      owner: root
      group: root
      mode: '0644'
    when: rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != ""
    notify: Config file changed

  - name: Start RKE2 service on the rest of the nodes
    service:
      name: rke2
      state: started
      enabled: yes
    retries: 5
    delay: 30

  - name: Mask other RKE2 service on the rest of the nodes
    service:
      name: "{{ item }}"
      state: masked
      enabled: yes
    loop: "{{ rke2_other_services | rejectattr('type', 'eq', rke2_type) | map(attribute='name') }}"
    when: rke2_type != "server"

  - name: Wait for remaining nodes to be ready - no CNI
    rke2_node_status:
      node_type: "{{ item }}"
      status: ready
      cni: false
    retries: 5
    delay: 30
    loop: "{{ groups['other'] | list }}"

  - name: Wait for remaining nodes to be ready - with CNI
    rke2_node_status:
      node_type: "{{ item }}"
      status: ready
      cni: true
    retries: 5
    delay: 30
    when: (inventory_hostname == groups['server'][0] and inventory_hostname != groups['server'][0]) or inventory_hostname in groups['server']

  handlers:
    - name: Config file changed
      service:
        name: rke2
        state: restarted
        enabled: yes
        restart: true
    - name: Service (re)started
      service:
        name: rke2
        state: restarted
        enabled: yes
        restart: true


