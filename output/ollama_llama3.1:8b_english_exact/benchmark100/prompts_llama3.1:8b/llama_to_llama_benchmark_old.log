---
- name: Import Java Asserts and Setup Local Task Execution
  import_tasks: assert.yml
  run_once: true

- name: Install Bash
  package:
    name: bash
    state: present

- name: Install OpenJDK Java (Package)
  package:
    name: "{{ java_vendor|lower }}-openjdk{{ java_version }}"
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM (Local Java Source)
  when: java_source == "local" and java_format == "rpm"
  block:
    - copy:
        content: "{{ java_package_rpm }}"
        dest: /tmp/java.rpm
    - package:
        name: /tmp/java.rpm
        state: present

- name: Install DEB (Local Java Source)
  when: java_source == "local" and java_format == "deb"
  block:
    - copy:
        content: "{{ java_package_deb }}"
        dest: /tmp/java.deb
    - apt:
        name: /tmp/java.deb
        state: present

- name: Install Oracle Java (RPM) (Repository)
  when: java_source == "repository" and java_format == "rpm"
  package:
    name: java-1.{{ java_version }}-{{ java_vendor|lower }}-rpm
    state: present

- name: Configure Oracle Targz
  when: java_format == "targz" and java_vendor == "oracle"
  block:
    - file:
        path: "{{ java_install_directory }}"
        state: directory
        mode: '0755'
    - unarchive:
        src: "{{ java_package_targz }}"
        dest: "{{ java_install_directory }}"
        compression: tar
        interactive: yes

- name: Install Oracle Java Policy Software (Targz)
  when: java_jce and java_version == 8 and java_vendor == "oracle"
  package:
    name: "{{ java_package_jce }}"
    state: present

- name: Set Alternative (Targz)
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"
  shell: "update-alternatives --install /usr/bin/java java /usr/lib/jvm/java-{{ java_version }}-{{ java_vendor|lower }}-bin/java 1"

- name: Find JAVA_HOME
  shell: "readlink -f /usr/bin/java | sed 's/\/bin\/java//'"
  register: java_home

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    dest: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home }}"
    state: present
    create: yes


