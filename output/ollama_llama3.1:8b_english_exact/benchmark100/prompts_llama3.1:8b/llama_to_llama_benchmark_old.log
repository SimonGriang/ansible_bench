content="---\n\n\n  - name: Update the package cache on systems that use apt\n    apt:\n      update_cache: yes\n\n  - name: Update the package cache on systems that use dnf\n    dnf:\n      update_cache: yes\n\n  - name: Install the keepalived package\n    apt:\n      name: keepalived\n      state: present\n\n  - name: Create the /etc/keepalived directory with the correct permissions\n    file:\n      path: /etc/keepalived\n      owner: root\n      group: root\n      mode: '0755'\n      state: directory\n\n  - name: Create the Kubernetes API health check script for Debian-based systems\n    template:\n      src: templates/check_apiserver.sh.j2\n      dest: /etc/keepalived/check_apiserver.sh\n      owner: root\n      group: root\n      mode: '0755'\n\n  - name: Create the Kubernetes API health check script for RHEL-based systems\n    template:\n      src: templates/check_apiserver.sh.j2\n      dest: /usr/libexec/keepalived/check_apiserver.sh\n      owner: root\n      group: root\n      mode: '0755'\n\n  - name: Create the RKE2 Server health check script for Debian-based systems\n    template:\n      src: templates/check_rke2server.sh.j2\n      dest: /etc/keepalived/check_rke2server.sh\n      owner: root\n      group: root\n      mode: '0755'\n\n  - name: Create the RKE2 Server health check script for RHEL-based systems\n    template:\n      src: templates/check_rke2server.sh.j2\n      dest: /usr/libexec/keepalived/check_rke2server.sh\n      owner: root\n      group: root\n      mode: '0755'\n\n  - name: Create the keepalived configuration file\n    template:\n      src: templates/keepalived.conf.j2\n      dest: /etc/keepalived/keepalived.conf\n      owner: root\n      group: root\n      mode: '0644'\n\n  - name: Enable the keepalived service and ensure it is not masked\n    service:\n      name: keepalived\n      enabled: yes\n      masked: no\n\n  - name: Flush the handlers to execute any pending tasks\n    meta: flush_handlers" additional_kwargs={} response_metada