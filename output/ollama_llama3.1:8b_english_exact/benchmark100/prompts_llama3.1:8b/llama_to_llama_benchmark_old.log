      dest: "{{ httpd_config_directory }}/{{ default_vhost_filename }}"
      mode: '0644'
    notify:
      - test-apache-config
      - restart-apache

  handlers:
  - name: test-apache-config
    apache2:
      state: present
      configtest: true

  - name: restart-apache
    service:
