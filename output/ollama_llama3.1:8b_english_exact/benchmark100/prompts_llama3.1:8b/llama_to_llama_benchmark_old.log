---

- name: Enable Apache2 modules
  hosts: all
  become: true

  tasks:
  - name: Enable Apache2 modules
    community.general.apache2_module:
      name: proxy
      state: present
    when: ansible_distribution == 'Debian' or ansible_distribution == 'Suse'

  - name: Enable Apache2 module proxy_http
    community.general.apache2_module:
      name: proxy_http
      state: present
    when: ansible_distribution == 'Debian' or ansible_distribution == 'Suse'

  - name: Configure Apache2 locations
    block:
    - name: Loop over locations
      template:
        src: templates/location.conf.j2
        dest: /etc/httpd/conf.d/
        mode: '0644'
      loop: '{{ httpd_locations }}'
      notify: restart httpd

  handlers:
  - name: Test and restart httpd
    service:
      name: httpd
      state: restarted
      enabled: true

