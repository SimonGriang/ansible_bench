hosts: all
  become: true
  tasks:
  - name: Import assert.yml task file
    include_tasks: assert.yml

  - name: Manage automatic service management
    block:
      - name: Disable automatic service management on installation when apt_autostart_state is disabled
        copy:
          content: "exit 101"
          dest: /usr/sbin/policy-rc.d
          mode: '0755'
          owner: root
          group: root

      - name: Enable automatic service management on installation when apt_autostart_state is enabled
        file:
          path: /usr/sbin/policy-rc.d
          state: absent


