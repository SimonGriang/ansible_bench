---
- name: Restore etcd node names
  hosts: localhost
  become: false

  tasks:
  - name: Get the names of all nodes in the cluster
    shell: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
    register: node_names

  - name: Remove old nodes from the cluster
    kubernetes:
      state: absent
      api_version: v1
      kind: Node
    loop: "{{ node_names.stdout.split('\n') }}"
    when: "'{{ item }}' not in groups[rke2_cluster_group_name]"
    loop_control:
      loop_var: item


