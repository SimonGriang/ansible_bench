---
- name: OpenVPN tasks
  hosts: localhost

  tasks:
  - name: Ensure /etc/openvpn/easy-rsa exists and set permissions
    file:
      path: /etc/openvpn/easy-rsa
      state: directory
      mode: '0755'

  - name: Initialize the EasyRSA PKI directory
    command: easy-rsa --batch --init-pki

  - name: Build the CA certificate using EasyRSA
    command: easy-rsa --batch --build-ca --nocolor --pass

