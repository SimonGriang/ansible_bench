---
- name: Helm Management
  become: true

  tasks:
  - name: Check if Helm binary exists at specified path
    stat:
      path: "{{ helm_bin_path }}"
    register: helm_check

  - name: Check current version of Helm installed on system
    shell:
      cmd: "{{ helm_bin_path }} version"
      executable: /bin/bash
    register: helm_existing_version
    failed_when: false
    changed_when: false

  - name: Download Helm binary from specified repository
    get_url:
      url: "{{ helm_repo_path }}/{{ helm_version }}/{{ helm_platform }}/{{ helm_arch }}"
      dest: "/tmp/helm"
      checksum: sha256:{{ helm_checksum }}
    when: not helm_check.stat.exists or helm_check.stat.size == 0 or helm_existing_version.stdout != helm_version

  - name: Copy downloaded Helm binary into place at specified path
    copy:
      content: "{{ lookup('file', '/tmp/helm') }}"
      dest: "{{ helm_bin_path }}"
      mode: '0755'
    when: helm_check.stat.exists and helm_existing_version.stdout != helm_version
    become: true


