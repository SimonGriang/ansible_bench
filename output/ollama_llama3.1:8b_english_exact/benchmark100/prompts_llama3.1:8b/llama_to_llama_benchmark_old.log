---
- name: Configure SELinux
  hosts: all
  gather_facts: no
  tasks:
    - name: Import and run assert.yml on localhost
      include_role:
        name: assert
        tasks_from: assert.yml
        apply:
          - host: localhost
          - once: yes

    - name: Install packages
      package:
        name: "{{ item }}"
        state: present
      notify: Gather facts
      loop: "{{ selinux_requirements }}"

    - name: Flush handlers
      meta: flush_handlers

    - name: Configure SELinux
      block:
        - name: Manage SELinux
          selinux:
            state: "{{ selinux_state }}"
            policy: "{{ selinux_policy }}"
          notify: Reboot
        - name: Manage SELinux booleans
          selinux_booleans:
            present: "{{ selinux_booleans }}"
      when: not ansible_connection.local.host in ['container', 'docker', 'community.docker.docker']

    - name: Gather facts
      setup: 

    - name: Reboot
      reboot:
        msg: "SELinux configuration changed"
      when: selinux_state != "disabled"


