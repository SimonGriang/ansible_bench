  register: externally_managed_file_py312

- name: Rename python3.12 EXTERNALLY-MANAGED file
  ansible.builtin.mv:
    src: /usr/lib/python3.12/EXTERNALLY-MANAGED
    dest: /usr/lib/python3.12/EXTERNALLY-MANAGED.old
  when: externally_managed_file_py312.stat.exists

- name: Import assert.yml
  ansible.builtin.include_role:
    name: assert
  delegate_to: localhost

- name: Install python pip
  ansible.builtin.pip:
    name: '{{ python_pip_packages }}'

- name: Configure pip proxy
  ansible.builtin.pip:
    chdir: /etc
    name: '{{ python_pip_packages }}'
  when: python_pip_proxy is defined
  args:
    extra_args: "{{ ['--proxy', python_pip_proxy] }}"

- name: Trust hosts
  ansible.builtin.pip:
    chdir: /etc
    name: '{{ python_pip_packages }}'
  when: python_pip_trusted_host is defined
  args:
    extra_args: "{{ ['--trusted-host', python_pip_trusted_host] }}"

- name: Update pip
  ansible.builtin.pip:
    chdir: /usr/lib/python3.11
    name: '{{ python_pip_pip_package }}'
    state: '{{ python_pip_state }}'
  when:
    - python_pip_update
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'

- name: Install requested modules
  ansible.builtin.pip:
    chdir: /usr/lib/python3.11
    name: '{{ python_pip_modules }}'
    state: 'present'
  when:
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'


