on': 121459548, 'prompt_eval_count': 726, 'prompt_eval_duration': 133276843, 'eval_count': 468, 'eval_duration': 3827868551, 'model_name': 'llama3.1:8b'} id='run--df073063-9d08-456d-9ad5-63af862ef019-0' usage_metadata={'input_tokens': 726, 'output_tokens': 468, 'total_tokens': 1194}
