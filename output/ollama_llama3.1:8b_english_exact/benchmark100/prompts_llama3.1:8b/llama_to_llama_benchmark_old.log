    dest: /usr/lib/python3.12/EXTERNALLY-MANAGED.old

- name: Import assert.yml
  include_role:
    name: assert
  delegate_to: localhost

- name: Install python pip
  pip:
    name: '{{ python_pip_packages }}'

- name: Configure pip proxy
  when: python_pip_proxy is defined
  pip:
    name: '{{ python_pip_packages }}'
    chdir: /etc
    options: '--upgrade --proxy {{ python_pip_proxy }}'

- name: Trust hosts
  when: python_pip_trusted_host is defined
  pip:
    name: '{{ python_pip_packages }}'
    chdir: /etc
    options: '--upgrade --trusted-host {{ python_pip_trusted_host }}'

- name: Update pip
  when:
    - python_pip_update
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'
  pip:
    name: '{{ python_pip_pip_package }}'
    chdir: /usr/lib/python3.11
    state: '{{ python_pip_state }}'

- name: Install requested modules
  when:
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'
  pip:
    name: '{{ python_pip_modules }}'
    chdir: /usr/lib/python3.11
    state: 'present'

