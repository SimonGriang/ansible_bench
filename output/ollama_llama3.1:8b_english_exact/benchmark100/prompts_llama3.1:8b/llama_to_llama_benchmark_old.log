---
- name: Apache Vhost Configuration
  hosts: all

  tasks:
  - name: Create the document root directory for each vhost
    file:
      path: /var/www/{{ item.name }}
      state: directory
      mode: '0755'
    loop: '{{ httpd_vhosts }}'

  - name: Configure the Apache vhost configuration files
    template:
      src: templates/vhost_conf_template.j2
      dest: /etc/apache2/sites-available/{{ item.name }}.conf
      mode: '0644'
    loop: '{{ httpd_vhosts }}'

  - name: Enable Apache vhosts on Debian systems
    apt:
      name: apache2
      state: present
    when: ansible_distribution == 'Debian'

  - name: Enable Apache vhosts
    template:
      src: templates/vhost_conf_template.j2
      dest: /etc/apache2/sites-available/{{ item.name }}.conf
      mode: '0644'
    loop: '{{ httpd_vhosts }}'

  - name: Enable the vhost
    command:
      cmd: 'a2ensite {{ item.name }}'
      args: ''
    loop: '{{ httpd_vhosts }}'


