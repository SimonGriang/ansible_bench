---
- name: Configure Package Management
  tasks:
  - name: Import necessary tasks for package manager assert
    import_tasks: assert.yml

  - name: Configure package management for package manager apk
    apt:
      update_cache: true
      cache_valid_time: 3600
      install: "*"

  - name: Configure package management for package manager apt
    apt:
      autoclean: true
      autoremove: true
      upgrade: true
      upgrade_packages:
        - package1
        - package2

  - name: Update all software for package manager dnf
    dnf:
      update_cache: true
      cache_valid_time: 3600
      exclude:
        - package1
        - package2
      state: "latest"

  - name: Update all software for package manager pacman
    pacman:
      update_cache: true
      cache_valid_time: 3600
      refresh_db: true
      refresh_expired: true

  - name: Configure package management for package manager yum
    block:
      - name: Update all software for specific yum versions
        dnf:
          update_cache: true
          cache_valid_time: 3600
          exclude:
            - package1
            - package2
          state: "latest"
      - name: Install yum-utils for non-6 yum versions
        package:
          name: yum-utils
          state: present
        when: ansible_distribution_version < "6"

  - name: Update all software for package manager zypper
    zypper:
      update: true
      refresh: true
      full_refresh: true
      state: "latest"


