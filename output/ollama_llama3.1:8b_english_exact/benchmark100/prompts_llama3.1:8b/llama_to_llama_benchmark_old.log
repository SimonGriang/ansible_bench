- name: Generate TLS key and certificate
  openssl_private_key:
    path: "{{ vault_tls_path }}/{{ item.key }}"
    data: "{{ vault_tls_data }}"
    password: "{{ vault_tls_password }}"
  openssl_csr:
    path: "{{ vault_tls_path }}/{{ item.csr }}"
    data: "{{ vault_tls_data }}"
    privatekey: "{{ vault_tls_path }}/{{ item.key }}"
    password: "{{ vault_tls_password }}"
  openssl_certificate:
    path: "{{ vault_tls_path }}/{{ item.certificate }}"
    data: "{{ vault_tls_data }}"
    csr: "{{ vault_tls_path }}/{{ item.csr }}"
    privatekey: "{{ vault_tls_path }}/{{ item.key }}"
    password: "{{ vault_tls_password }}"
  with_items: "{{ vault_tls_items }}"

- name: Set ownership of TLS material
  file:
    path: "{{ item.path }}"
    state: file
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ vault_mode }}"
  with_items: "{{ vault_tls_files }}"

- name: Copy the Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}"
    mode: "{{ vault_mode }}"
  notify: restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setsebool:
    name: cap_ipc_lock
    state: ep
    persistent: true

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ vault_mode }}"

- name: Create /usr/lib/systemd/system
  file:
    path: "/usr/lib/systemd/system"
    state: directory
    owner: "root"
    group: "root"
    mode: '0755'

- name: Copy the Vault service file
  copy:
    src: "{{ playbook_dir }}/files/vault.service"
    dest: "/usr/lib/systemd/system/vault.service"
    mode: '0644'

- name: Copy the Vault configuration
  copy:
    src: "{{ playbook_dir }}/files/vault.hcl"
    dest: "{{ vault_path }}/vault.hcl"
    mode: '0644'

- name: Flush handlers
  meta: flush_handlers

