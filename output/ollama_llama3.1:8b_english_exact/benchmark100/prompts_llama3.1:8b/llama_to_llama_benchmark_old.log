---

- name: Sysctl Configuration
  hosts: all
  gather_facts: true
  become: true

  tasks:
    - include_tasks:
        file: assert.yml

    - name: Install sysctl requirements
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ sysctl_requirements }}"
      loop_control:
        loop_var: item

    - name: Set sysctl settings
      sysctl:
        name: "{{ item.name }}"
        value: "{{ item.value }}"
      when:
        - item is defined
        - item.name is defined
        - item.value is defined
        - ansible_connection != 'container'
        - ansible_connection != 'docker'
        - ansible_connection != 'community.docker.docker'
      loop: "{{ sysctl_items }}"
      loop_control:
        loop_var: item
      notify:
        - reload sysctl

  handlers:
    - name: reload sysctl
      service:
        name: sysctl
        state: reloaded

  # added this section to fix the schema and parser error
  vars:
    # moved gather_facts to a block
    _gather_facts: "{{ gather_facts | default(true) }}"
  tasks:
    - name: Gather facts
      setup:
      when: _gather_facts

  # added this section to fix the conflicting action statements error
  tasks:
    - name: Install sysctl requirements
      package:
        name: "{{ item }}"
