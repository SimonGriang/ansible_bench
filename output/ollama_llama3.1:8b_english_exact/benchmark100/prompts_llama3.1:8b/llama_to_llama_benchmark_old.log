---
- name: Include tasks from assert.yml playbook
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages for the service
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ service_required_packages }}"
  notify: "package installation"

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: "/etc/systemd/system/{{ item.name }}.service"
    mode: '0644'
  when: ansible_distribution == "Ubuntu" or ansible_distribution == "Debian"
  loop: "{{ service_list }}"
  notify: "Systemctl daemon-reload"

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: "/etc/init.d/{{ item.name }}"
    mode: '0755'
  when: (ansible_distribution == "Ubuntu" or ansible_distribution == "Debian") or (ansible_distribution == "RedHat" or ansible_distribution == "CentOS")
  loop: "{{ service_list }}"

- name: Manage each service in the service_list
  service:
    name: "{{ item.name }}"
    enabled: "{{ item.enabled | default(true) }}"
    state: "{{ item.state | default('started') }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers


