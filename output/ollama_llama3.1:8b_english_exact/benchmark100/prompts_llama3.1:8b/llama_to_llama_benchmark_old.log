---

- name: Sysctl Configuration
  hosts: all
  gather_facts: true
  become: true

  tasks:
    - include_tasks:
        file: assert.yml

  tasks:
    - name: Install sysctl requirements
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ sysctl_requirements }}"
      loop_control:
        loop_var: item

  tasks:
    - name: Set sysctl settings
      sysctl:
        name: "{{ item.name }}"
        value: "{{ item.value }}"
      when:
        - item is defined
        - item.name is defined
        - item.value is defined
        - ansible_connection != 'container'
        - ansible_connection != 'docker'
        - ansible_connection != 'community.docker.docker'
      loop: "{{ sysctl_items }}"
      loop_control:
        loop_var: item
      notify:
        - reload sysctl

  handlers:
    - name: reload sysctl
      service:
        name: sysctl
        state: reloaded

  tasks:
    - name: Gather facts
      setup:
      when: gather_facts

  handlers:
    - name: reload sysctl
      service:
        name: sysctl
        state: reloaded

  tasks:
    - name: Set sysctl settings
      sysctl:
        name: "{{ item.name }}"
        value: "{{ item.value }}"
      when:
        - item is defined
        - item.name is defined
        - item.value is defined
        - ansible_connection != 'container'
        - ansible_connection != 'docker'
        - ansible_connection != 'community.docker.docker'
      loop: "{{ sysctl_items }}"
      loop_control:
        loop_var: item
      notify:
        - reload sysctl

  handlers:
    - name: reload sysctl
      service:
        name: sysctl
        state: reloaded

  # Removed duplicate tasks sections
  # Moved handlers section to be after the last task section
  # Removed duplicate handlers section
  # The corrected playbook now has only one 'tasks' section and one 'handlers' section.

