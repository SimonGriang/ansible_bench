---
- name: OpenSSL Configuration Tasks
  tasks:
  - name: Check if python is installed
    command: python --version
    register: python_installed
    failed_when: python_installed.rc != 0

  - name: Check if python3 is installed
    command: python3 --version
    register: python3_installed
    failed_when: python3_installed.rc != 0

  - name: Debug Python executable path
    debug:
      msg: "Python executable path: {{ python_installed.path }}"

  - name: Debug Python3 executable path
    debug:
      msg: "Python3 executable path: {{ python3_installed.path }}"

  - name: Import assert.yml
    include_tasks: assert.yml
    when: ansible_distribution == 'CentOS' or ansible_distribution == 'Red Hat Enterprise Linux'

  - name: Install requirements
    package:
      name: "{{ openssl_requirements }}"
      state: present

  - name: Ensure packaging is available via dnf
    package:
      name: python3-packaging
      state: present

  - name: Install pip packages
    pip:
      name: "{{ openssl_pip_packages }}"
      state: present

  - name: Create key directory
    file:
      path: "{{ openssl_key_directory }}"
      mode: "{{ openssl_key_directory_mode }}"
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
      state: directory

  - name: Create csr directory
    file:
      path: "{{ openssl_csr_directory }}"
      mode: "{{ openssl_csr_directory_mode }}"
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
      state: directory

  - name: Create crt directory
    file:
      path: "{{ openssl_crt_directory }}"
      mode: "{{ openssl_crt_directory_mode }}"
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
      state: directory

  - name: Include create.yml
    include_tasks: create.yml
    loop: "{{ openssl_items }}"
    loop_control:
      loop_var: item


