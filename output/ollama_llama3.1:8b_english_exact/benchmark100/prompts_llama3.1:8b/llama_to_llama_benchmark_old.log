---
- name: Bootstrap tasks
  tasks:
  - name: Check all variables have been set correctly
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: yes

  - name: Wait for host (when configured)
    wait_for:
      host: "{{ ansible_ssh_host }}"
      port: "{{ ansible_port }}"
      timeout: "{{ bootstrap_timeout }}"
    when: ansible_connection != 'container' and ansible_connection != 'docker' and ansible_connection != 'community.docker.docker'

  - name: Prepare the system
    block:
      - name: Check connection
        ping:
        when: not bootstrap__skip_connection_check

      - name: Register result
        set_fact:
          bootstrap__result: "{{ lookup('pipe', 'ansible-playbook --version') }}"

      - name: Include tasks to gather bootstrap facts
        include_tasks: gather_facts.yml

      - name: Install bootstrap packages (if applicable)
        package:
          name: "{{ item }}"
          state: present
        loop: "{{ bootstrap__facts_packages }}"

  - name: Ensure system is prepared by issuing ansible modules
    block:
      - name: Gather ansible facts
        gather_facts: {}

      - name: Install required packages
        package:
          name: "{{ item }}"
          state: present
          become: "{{ bootstrap__become }}"
          become_user: "{{ bootstrap__become_user }}"
        loop: "{{ bootstrap__facts_packages|default([]) }}"
        when: bootstrap__facts_packages is defined

