        - Test httpd configuration validity
        - Restart httpd
      loop: "{{ httpd_vhosts }}"

  handlers:
    - name: Test httpd configuration validity
      test:
        path: "/etc/httpd/conf.d"

    - name: Restart httpd
      service:
        name: httpd
        state: restarted


