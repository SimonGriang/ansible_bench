\n\n- name: Rolling cordon and drain restart when version changes - agents\n  include: rolling_restart.yml\n  when: (rke2_version_changed == 'true') and (rke2_rke2_installed == 'true')\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Rolling restart when config files change\n  include: change_config.yml\n  when: (rke2_config_files_changed == 'true') and (rke2_rke2_installed == 'true')\n\n- name: Final steps\n  include: summary.yml" additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-13T20:14:34.926889925Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6520543499, 'load_duration': 98460024, 'prompt_eval_count': 888, 'prompt_eval_duration': 152644985, 'eval_count': 686, 'eval_duration': 6268115219, 'model_name': 'llama3.1:8b'} id='run--d4244870-94c4-489e-b540-5ead1af7152e-0' usage_metadata={'input_tokens': 888, 'output_tokens': 686, 'total_tokens': 1574}
