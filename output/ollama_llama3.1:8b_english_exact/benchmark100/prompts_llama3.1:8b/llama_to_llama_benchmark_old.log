---
- name: Install and configure Vault
  hosts: localhost
  vars:
    vault_package: "vault"

  tasks:
  - name: Install package with name stored in the 'vault_package' variable
    package:
      name: "{{ vault_package }}"
      state: present

  handlers:
  - name: Reload daemon on changes
    service:
      name: vault
      state: reloaded
      enabled: true
    notify: reload_daemon

  handlers:
  - name: Restart vault service
    service:
      name: vault
      state: restarted
    notify: restart_vault

  handlers:
  - name: Reload daemon
    service:
      name: vault
      state: reloaded
      enabled: true

  handlers:
  - name: Restart vault service
    service:
      name: vault
      state: restarted


