- name: Gather Bootstrap Facts
  shell:
    cmd: cat /etc/os-release
    args:
      chdir: /root
    register: bootstrap_facts
    become: false

- name: Set Bootstrap Distribution Facts (I)
  set_fact:
    bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_findall('NAME="([^"]+)"' ) | first }}"
