---
- name: Restart RKE2 service on a node
  service:
    name: rke2
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell:
    cmd: |
      for i in {1..100}; do
        if [ $(rke2 get nodes -o json | jq '.[] | select(.status == "Ready") | length') -eq $(rke2 get nodes -o json | jq '. | length') ]; then
          echo "All nodes are ready"
          exit 0
        fi
        sleep 15
      done
    delegate_to: "{{ rke2_node_name }}"
    delegate_facts: false
  when: ansible_check_mode != 'True'
  register: all_ready_nodes
  retries: 100
  delay: 15

- name: Wait for all pods to be ready again
  shell:
    cmd: |
      for i in {1..100}; do
        if [ $(rke2 get pods -o json | jq '.[] | select(.status != "Running" and .status != "Succeeded") | length') -eq 0 ]; then
          echo "All pods are ready"
          exit 0
        fi
        sleep 15
      done
    delegate_to: "{{ rke2_node_name }}"
    delegate_facts: false
  when: ansible_check_mode != 'True' and rke2_wait_for_all_pods_to_be_ready
  register: all_pods_ready
  retries: 100
  delay: 15


