    dest: /etc/profile.d/vault.sh
    mode: '0644'
  when: vault_hardening_disable_shell_command_history

- name: Configure SELinux / AppArmor
  yum:
    name: selinux-policy
    state: present
  when: selinux_enforcing != 'True'

- name: Configure SELinux
  selinux:
    policy: targeted
    state: enforcing
  when: selinux_enforcing != 'True'

- name: Configure AppArmor
  command: aa-enforce
  when: selinux_enforcing != 'True'


