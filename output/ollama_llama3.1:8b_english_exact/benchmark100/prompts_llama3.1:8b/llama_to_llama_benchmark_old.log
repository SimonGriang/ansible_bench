---
- name: Tasks
  tasks:
  - name: Remove Docker GPG key from trusted.gpg.d if present
    file:
      path: /usr/share/keyrings/docker-archive-keyring.gpg
      state: absent
  - name: Remove old Docker apt source list
    file:
      path: /etc/apt/sources.list.d/docker.list
      state: absent
  - name: Uninstall old versions of Docker
    apt:
      name: docker
      state: absent
  - name: Remove legacy Docker repository file
    file:
      path: /etc/apt/sources.list.d/docker.list.save
      state: absent
  - name: Install required dependencies
    apt:
      name:
        - apt-transport-https
        - ca-certificates
        - python3-debian
      state: present
  - name: Add or remove Docker repository
    apt_repository:
      repo: 'https://download.docker.com/linux/{{ ansible_distribution | lower }} {{ ansible_distribution_release }}'
      state: present
      filename: docker
      update_cache: yes
    notify: apt update
  - name: Notify apt update handler
    meta: flush_handlers

