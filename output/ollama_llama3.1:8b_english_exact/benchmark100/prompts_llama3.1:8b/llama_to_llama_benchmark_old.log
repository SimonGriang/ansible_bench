---
- name: Include assert role
  include_role:
    name: assert
    tasks: assert.yml
    delegate_to: localhost

- name: Install git package
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if user exists
  stat:
    path: /etc/passwd
    get_attr: user
  register: user_exists
  when: git_username is defined

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}{{ git_groupname | default('') }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
  when: user_exists.stat.exists

- name: Configure git
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    mode: "0644"
  when: user_exists.stat.exists and git_user_email is defined and git_user_name is defined and git_username is defined

- name: Create repository destination
  file:
    path: "{{ git_repository_destination | default('') }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
  when: user_exists.stat.exists

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination | default('') }}"
    version: "{{ item.version | default('HEAD') }}"
    force: true
    clone: true
    accept_hostkey: true
    become_user: "{{ git_username }}"
  loop: "{{ git_repositories | default([]) }}"
  when: user_exists.stat.exists and git_repositories is defined and git_repository_destination is defined


