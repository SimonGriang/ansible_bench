---
- name: Tasks
  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost

  - name: Install python pip packages
    pip:
      name: "{{ item }}"
      state: present
    loop: "{{ python_pip_packages }}"

  - name: Configure pip proxy settings
    lineinfile:
      dest: /etc/pip.conf
      regexp: '^proxy'
      line: "proxy = {{ python_pip_proxy }}"
    when: python_pip_proxy is defined

  - name: Configure pip trusted host settings
    lineinfile:
      dest: /etc/pip.conf
      regexp: '^trusted-host'
      line: "trusted-host = {{ python_pip_trusted_host }}"
    when: python_pip_trusted_host is defined

  - name: Update pip to the specified version
    pip:
      name: "{{ python_pip_pip_package }}"
      state: present
    when:
      - python_pip_update
      - not ansible_distribution_release in ['bookworm', 'noble']
      - ansible_os_family != 'Alpine'

  - name: Install requested Python modules
    pip:
      name: "{{ item }}"
      state: present
    loop: "{{ python_pip_modules }}"
    when:
      - not ansible_distribution_release in ['bookworm', 'noble']
      - ansible_os_family != 'Alpine'


