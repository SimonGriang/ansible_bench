---
- name: Import assert.yml file
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    host: "{{ ansible_host }}"
    port: "{{ ansible_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != "container"
    - ansible_connection != "docker"
    - ansible_connection != "community.docker.docker"
    - ansible_connection is not none
    - bootstrap_wait_for_host

- name: Prepare system
  block:
    - name: Connection test
      connection:
        message: "Connection test failed"
        retryable: true
      failed_when: false
    - name: Gather bootstrap facts
      setup:
        gather_subset: "!all"
      when: connection_test.failed

    - name: Sudo test
      become: true
      block:
        - name: Test sudo
          command: sudo -V
          failed_when: false
      rescue:
        - name: Install bootstrap packages (raw)
          raw: "{{ bootstrap_packages }}"

        - name: Ensure libdnf5 is present
          package:
            name: libdnf5
