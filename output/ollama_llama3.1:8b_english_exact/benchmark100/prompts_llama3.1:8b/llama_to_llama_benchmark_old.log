---
- name: Configure SSL and HTTP to HTTPS Redirect
  hosts: localhost
  become: yes

  vars:
    httpd_ssl_packages:
      - openssl
      - mod_ssl

    httpd_config_directory: /etc/apache2/conf.d
    httpd_config_file: ssl.conf
    default_vhost_conf: default-vhost.conf
    default_vhost_filename: default-vhost.conf

  tasks:
  - name: Install required SSL packages
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ httpd_ssl_packages }}"

  - name: Place SSL configuration file
    template:
      src: templates/ssl.conf.j2
      dest: "{{ httpd_config_directory }}/{{ httpd_config_file }}"
      mode: '0644'
    notify:
      - test-apache-config
      - restart-apache

  - name: Configure HTTP to HTTPS redirect
    template:
      src: templates/{{ default_vhost_conf }}
      dest: "{{ httpd_config_directory }}/{{ default_vhost_filename }}"
      mode: '0644'
    notify:
      - test-apache-config
      - restart-apache

  handlers:
  - name: test-apache-config
    apache2:
      state: present
      configtest: yes

  - name: restart-apache
    service:
      name: apache2
      state: restarted



