- name: OpenSSL Tasks
  hosts: localhost
  vars:
    openssl_requirements:
      - package1
      - package2
    openssl_pip_packages:
      - package3
      - package4
    openssl_key_directory: /path/to/key/directory
    openssl_file_owner: owner
    openssl_file_group: group
    openssl_csr_directory: /path/to/csr/directory
    openssl_crt_directory: /path/to/crt/directory
    openssl_items:
      - item1
      - item2

  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml
    run_once: yes
    delegate_to: localhost

  - name: Install required packages
    apt:
      name: "{{ item }}"
      state: present
    loop: "{{ openssl_requirements }}"

  - name: Install pip packages
    pip:
      name: "{{ item }}"
      state: present
    when: openssl_pip_packages is not empty
    loop: "{{ openssl_pip_packages }}"

  - name: Create the key directory
    file:
      path: "{{ openssl_key_directory }}"
      mode: '0755'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"

  - name: Create the csr directory
    file:
      path: "{{ openssl_csr_directory }}"
      mode: '0755'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"

  - name: Create the crt directory
    file:
      path: "{{ openssl_crt_directory }}"
      mode: '0755'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"

  - name: Include create.yml tasks
    include_tasks: create.yml
    loop: "{{ openssl_items }}"
    loop_control:
      loop_var: item
    when: openssl_items|default([]) != []

