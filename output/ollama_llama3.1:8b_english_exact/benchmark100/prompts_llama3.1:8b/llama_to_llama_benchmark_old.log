- name: Disable Swap
  name: swapoff -a
  when: vault_hardening_disable_swap
  become: yes

- name: Disable Swap at Boot
  name: sed -i 's/swap\s\+on//g' /etc/fstab
  when: vault_hardening_disable_swap
  become: yes

- name: Disable Core Dumps
  community.general.pam_limits:
    name: core
    limit: 0
    soft: yes
  when: vault_hardening_disable_core_dumps

- name: Disable Core Dumps
  community.general.pam_limits:
    name: core
    limit: 0
    soft: no
  when: vault_hardening_disable_core_dumps

- name: Disable Shell Command History
  copy:
    src: files/vault.sh
    dest: /etc/profile.d/vault.sh
    mode: '0644'
  when: vault_hardening_disable_shell_command_history

- name: Configure SELinux / AppArmor
  name: yum install -y selinux-policy
  when: selinux_enforcing != 'True'

- name: Configure SELinux
  selinux:
    policy: targeted
    state: enforcing
  when: selinux_enforcing != 'True'

- name: Configure AppArmor
  name: aa-enforce
  when: selinux_enforcing != 'True'

