---
- name: Configure rsyslog
  hosts: localhost

  tasks:
    - name: Import assert.yml
      include: assert.yml
      run_once: true

    - name: Uninstall systemd-logger
      package:
        name: systemd-logger
        state: absent

    - name: Install rsyslog
      package:
        name: rsyslog
        state: present

    - name: Install rsyslog packages
      package:
        name: "{{ rsyslog_packages }}"
        state: present

    - name: Install rsyslog features
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ rsyslog_features }}"

    - name: Configure default rsyslog configuration
      template:
        src: rsyslog.conf.j2
        dest: /etc/rsyslog.conf
        mode: '0644'
      notify:
        - Restart rsyslog

    - name: Create /etc/rsyslog.d/ directory
      file:
        path: /etc/rsyslog.d/
        state: directory
        mode: '0755'

    - name: Configure forward rule for rsyslog
      template:
        src: forward_rule.conf.j2
        dest: /etc/rsyslog.conf.d/forward.conf
        mode: '0644'
      notify:
        - Restart rsyslog

    - name: Configure additional rsyslog configuration files
      template:
        src: "{{ item.key }}.j2"
        dest: "{{ item.value.dest }}"
        mode: '0440'
        owner: root
        group: root
      loop: "{{ rsyslog_rsyslog_d_files | dict2items }}"
      notify:
        - Restart rsyslog

    - name: Start and enable rsyslog service
      service:
        name: rsyslog
        state: started
        enabled: yes

  handlers:
    - name: Restart rsyslog
      service:
        name: rsyslog
        state: restarted


