---
- name: Install unzip package and update cache if necessary
  apt:
    name: unzip
    state: present
  when: promtail_apt_update_cache

- name: Create promtail system group if necessary
  group:
    name: "{{ promtail_system_group }}"
    state: present
  when: promtail_system_group != "root"

- name: Create the promtail system user
  user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    groups: "{{ promtail_user_additional_groups }}"
    state: present
  when: promtail_system_user != "root"

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create necessary config directories
  file:
    path: /etc/promtail
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0755'
  when: true

  - name: Create positions file directory
    file:
      path: /var/lib/promtail/positions
      state: directory
      owner: "{{ promtail_system_user }}"
      group: "{{ promtail_system_group }}"
      mode: '0755'
    when: true

- name: Create application directories
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0755'
  loop:
    - path: /usr/local/promtail
    - path: /usr/local/promtail/{{ promtail_version }}/

- name: Check the existence of the promtail binary
  stat:
    path: /usr/local/promtail/{{ promtail_version }}/promtail
    state: file
  register: promtail_binary

- name: Download promtail binaries if necessary
  get_url:
    url: "{{ promtail_download_url }}"
    dest: /tmp/promtail.zip
    mode: '0644'
  when: not promtail_binary.stat.exists or promtail_reupload

- name: Propagate locally distributed promtail archive if necessary
  copy:
    content: "{{ lookup('file', '/tmp/promtail.zip') }}"
    dest: /tmp/promtail.zip
    mode: '0644'
  when: promtail_local_reupload

- name: Download promtail binaries to controller node if necessary
  get_url:
    url: "{{ promtail_download_url }}"
    dest: /tmp/promtail.zip
    mode: '0644'
  when: promtail_binary_propagate and not promtail_binary.stat.exists or promtail_reupload

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail.zip
    dest: /usr/local/promtail/{{ promtail_version }}/promtail.zip
    mode: '0644'
  when: promtail_binary_propagate

- name: Unpack promtail binaries
  unarchive:
    src: /usr/local/promtail/{{ promtail_version }}/promtail.zip
    dest: /usr/local/promtail/{{ promtail_version }}
    compression: 'zip'
  when: true

- name: Create a symlink to the latest version
  file:
    src: /usr/local/promtail/{{ promtail_version }}/promtail
    dest: /usr/local/bin/promtail
    state: link
    mode: '0755'

- name: Write the promtail configuration
  template:
    src: templates/promtail.yaml.j2
    dest: /etc/promtail/promtail.yaml
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0644'

- name: Create the systemd service unit
  template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: restart promtail service


