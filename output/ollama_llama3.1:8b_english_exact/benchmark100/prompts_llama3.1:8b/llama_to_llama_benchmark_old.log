---
- name: Install and configure Java
  tasks:
  - name: Migrate adoptopenjdk to temurin (if selected)
    set_fact:
      java_jdk_vendor: "temurin"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Gather OS specific variables
    include_vars:
      file: "vars/{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.yml"

  - name: Gather architecture specific variables
    include_vars:
      file: "architecture.yml"

  - name: Set OS-specific variables (I)
    set_fact:
      java_open_jdk_home: "{{ java_open_jdk_home_dir }}/{{ java_jdk_vendor }}"
    when: java_open_jdk_home_dir is defined and java_open_jdk_home_dir is not None
    when: java_jdk_vendor is defined and java_jdk_vendor is not None

  - name: Set OS and architecture specific variables (II)
    set_fact:
      java_open_jdk_package: "{{ java_jdk_vendor }}-openjdk-{{ java_jdk_version }}-default"
    when: java_jdk_vendor is defined and java_jdk_vendor is not None
    when: java_jdk_version is defined and java_jdk_version is not None

  - name: Set specific variables
    set_fact:
      java_home: "{{ java_open_jdk_home }}"
    when: java_open_jdk_home is defined and java_open_jdk_home is not None

  - name: Debian pre-requisites
    when: ansible_distribution == "Debian"
    tasks:
    - name: Remove deprecated repositories
      apt:
        name: "{{ item }}"
        state: absent
      loop:
        - "{{ java_jdk_vendor }}-openjdk-{{ java_jdk_version }}-default"
        - "{{ java_jdk_vendor }}-openjdk-{{ java_jdk_version }}-default-jre"
        - "{{ java_jdk_vendor }}-openjdk-{{ java_jdk_version }}-default-dce-java"
    - name: Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
      loop:
        - apt-transport-https
        - ca-certificates
        - curl
        - gnupg
        - lsb-release
    - name: Add required key repositories
      apt_key:
        url: "https://download.java.

