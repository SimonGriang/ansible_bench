- name: Create the RKE2 manifests directory
  file:
    path: /etc/rke2/manifests
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy kube-vip YAML files to the RKE2 manifests directory
  copy:
    src: templates/kube-vip.j2
    dest: /etc/rke2/manifests/kube-vip
    mode: '0644'

- name: Copy kube-vip load balancer manifests to the RKE2 manifests directory
  copy:
