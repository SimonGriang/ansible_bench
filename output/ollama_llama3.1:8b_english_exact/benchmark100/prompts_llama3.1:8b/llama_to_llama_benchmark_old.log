      loop_control:
        loop_var: item

    - name: Set sysctl settings
      sysctl:
        name: "{{ item.name }}"
        value: "{{ item.value }}"
      when:
        - item is defined
        - item.name is defined
        - item.value is defined
        - ansible_connection != 'container'
        - ansible_connection != 'docker'
        - ansible_connection != 'community.docker.docker'
      loop: "{{ sysctl_items }}"
      loop_control:
        loop_var: item
      notify:
        - reload sysctl

  handlers:
    - name: reload sysctl
      service:
        name: sysctl
        state: reloaded

