        name: "{{ item }}"
        state: present
      loop: "{{ openvpn_packages }}"

    - name: Set up OpenVPN server or client
      include_tasks: "{{ openvpn_role }}.yml"

    - name: Start and enable OpenVPN service
      service:
        name: openvpn
        state: started
        enabled: true


