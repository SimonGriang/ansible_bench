---
- name: Tasks to manage Python 3 on Debian 12
  hosts: all
  become: yes

  tasks:
  - name: Get Python 3 version installed on the system
    command: python3 --version
    register: py3ver

  - name: Remove the EXTERNALLY-MANAGED file on Debian 12
    file:
      path: /usr/lib/python3.11/EXTERNALLY-MANAGED
      state: absent
    when:
      - py3ver.stdout | regex_search("3\\.11") | bool
      - not molecule_notest

