- name: Configure HTTP server
  hosts: all
  become: yes

  vars:
    httpd_directories:
      - path: /var/www/html
        mode: '0755'
        state: directory
      - path: /var/www/images
        mode: '0755'
        state: directory
      - path: /var/www/videos
        mode: '0755'
        state: directory
      - path: /var/www/documents
        mode: '0755'
        state: directory

  tasks:
    - name: Create necessary directories for HTTP server
      file:
        path: "{{ item.path }}"
        mode: "{{ item.mode }}"
        state: "{{ item.state }}"
