---
- name: Tasks to configure etcd and kernel hardening
  hosts: all
  become: true
  tasks:
    - name: Create a system group named etcd and ensure it exists
      group:
        name: etcd
        state: present

    - name: Create a system user named etcd, assign it to the etcd group, and set its shell to /bin/nologin
      user:
        name: etcd
        group: etcd
        shell: /bin/nologin
        state: present

    - name: Copy the systemctl config file for kernel hardening to the /etc/sysctl.d/ directory
      copy:
        src: /usr/local/share/sysctl.conf
        dest: /etc/sysctl.d/99-kernel_hardening.conf
        content: "{{ lookup('file', '/usr/local/share/sysctl.conf') | conditional('file:///usr/local/share is writable', 'file:///usr/local/share is not writable') }}"
        notify: Restart systemd-sysctl

    - name: Flush the handlers to run pending tasks
      meta: flush_handlers

  handlers:
    - name: Restart systemd-sysctl
      service:
        name: systemd-sysctl
        state: restarted


