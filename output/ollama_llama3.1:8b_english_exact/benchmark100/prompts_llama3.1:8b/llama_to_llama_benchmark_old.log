---
- name: Configure and manage logrotate
  hosts: localhost
  gather_facts: no

  tasks:
  - name: Import and execute tasks from assert.yml playbook fragment
    include_tasks: assert.yml

  - name: Install logrotate package
    package:
      name: logrotate
      state: present

  - name: Configure logrotate by rendering a template
    template:
      src: "{{ item }}.j2"
      dest: "/etc/logrotate.d/{{ item }}"
      mode: '0644'
    loop: "{{ logrotate_config_file }}"
    loop_control:
      label: "{{ item }}"

  - name: Generate logrotate.d files using a template
    template:
      src: "entry.j2"
      dest: "/etc/logrotate.d/{{ item }}"
      mode: '0644'
    with_items: "{{ logrotate_entries }}"
    when: item.absent is not defined
    notify: restart logrotate

  - name: Remove logrotate.d files
    file:
      path: "/etc/logrotate.d/{{ item }}"
      state: absent
    with_items: "{{ logrotate_entries }}"
    when: item.absent is defined
    notify: restart logrotate

  - name: Manage logrotate service
    service:
      name: "{{ logrotate_service }}"
      state: "{{ logrotate_service_state }}"
      enabled: "{{ logrotate_service_enabled }}"


