---
- name: Import assert.yml task
  include_tasks: assert.yml
  when: local

- name: Install using package task
  block:
  - name: Install repository for RedHat task
    shell:
      cmd: |
        rpm --import https://packages.hashicorp.com/gpg
        echo "https://apt.releases.hashicorp.com/gpg" | sudo tee /etc/apt/sources.list.d/hashicorp.list
        apt update
        apt install apt-transport-https ca-certificates curl gnupg2 software-properties-common -y

  - name: Configure Debian task
    when: ansible_distribution == "Ubuntu"
    block:
      - name: Install required package gpg task
        apt:
          name: gnupg2
          state: present

      - name: Install apt key for Debian task
        apt_key:
          url: https://apt.releases.hashicorp.com/gpg
          state: present

      - name: Install repository for Debian task
        apt_repository:
          repo: 'ppa:hashicorp'
          state: present

  - name: Install hashicorp product using package task
    block:
      - name: Install latest hashicorp product using package task
        package:
          name: "{{ item }}-{{ ('1.1.10' if (ansible_distribution == 'Ubuntu' and item == 'terraform' and ansible_distribution_version == '20.04' and item == 'terraform' and ansible_distribution_version == '20.04') else 'latest') }}"
          state: present
        loop: ["terraform", "vagrant", "packer"]

      - name: Install versioned hashicorp product using package task
        package:
          name: "{{ item }}-{{ ('1.1.10' if (ansible_distribution == 'Ubuntu' and item == 'terraform' and ansible_distribution_version == '20.04' and item == 'terraform' and ansible_distribution_version == '20.04') else item }}"
          state: present
        loop: ["terraform", "vagrant", "packer"]

  - name: Install manually task
    block:
      - name: Download hashicorp product
        get_url:
          url: https://releases.hashicorp.com/{{ item }}/hashicorp-{{ item }}_{{ ansible_distribution }}.zip
          dest: /tmp
          mode: '0644'
        loop: ["terraform", "vagrant", "packer"]

      - name: Unpack hashicorp product
        unarchive:
          src: /tmp/hashicorp-{{ item }}_{{ ansible_distribution }}.zip
          dest: /tmp
          compression: zip
        loop: ["terraform", "vagrant", "packer"]


