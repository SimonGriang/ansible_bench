---

- name: Create an SSL private key
  file:
    path: /path/to/ssl/private.key
    state: touch
  become: yes
  become_method: sudo
  notify: restart service

- name: Create an SSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /path/to/ssl/private.key
    csr: /path/to/ssl/csr.csr
    common_name: example.com
    state: present
  become: yes
  become_method: sudo

- name: Create SSL certificates
  openssl_certificate:
    path: /path/to/ssl/csr.csr
    dest: /path/to/ssl/cert.pem
    provider: self-signed
    state: present
  become: yes
  become_method: sudo

- name: Create a PKCS#12 file
  openssl_pkcs12:
    src: /path/to/ssl/private.key
    dest: /path/to/ssl/pkcs12.pkcs12
    friendly_name: example
    cert: /path/to/ssl/cert.pem
    state: present
  become: yes
  become_method: sudo

- name: Read the private key
  slurp:
    src: /path/to/ssl/private.key
    dest: ssl_private_key
  register: ssl_private_key

- name: Read the certificate
  slurp:
    src: /path/to/ssl/cert.pem
    dest: ssl_cert
  register: ssl_cert

- name: Create a combined private key and certificate file
  copy:
    content: "{{ ssl_private_key.content }}{{ ssl_cert.content }}"
    dest: /path/to/ssl/combined.key
    mode: '0644'
    owner: 'root'
    group: 'root'
  become: yes
  become_method: sudo

