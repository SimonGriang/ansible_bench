---
- name: Bootstrap tasks
  hosts: localhost
  tasks:
  - import: from_yaml assert.yml
    delegate_to: localhost
  - name: Wait for port to become available
    wait_for:
      host: "{{ inventory_hostname }}"
      port: "{{ bootstrap_port | default(22) }}"
      timeout: "{{ bootstrap_timeout }}"
    when: not ansible_connection.remote_addr.startswith('docker://') and not ansible_connection.remote_addr.startswith('container://') and bootstrap_wait_for_host
  - name: Prepare system
    block:
      - name: Check connection
        assert:
          that: ansible_connection.active
          msg: "Connection not established"
      - name: Check sudo
        assert:
          that: ansible_connection.is_sudo
          msg: "Sudo not available"
    rescue:
      - name: Gather facts
        setup:
          filter: bootstrap
        delegate_to: localhost
      - include: gather_facts.yml
    when: bootstrap_become
  - name: Gather facts
    setup:
      filter: default
  - name: Install bootstrap packages
    package:
      name: "{{ bootstrap_facts_packages }}"
      state: present
      update_cache: yes
    become: "{{ bootstrap_become }}"


