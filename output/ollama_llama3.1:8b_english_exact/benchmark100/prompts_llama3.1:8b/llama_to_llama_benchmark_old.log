--- 

- name: Create the Vault group
  group:
    name: "{{ vault_group }}"
    state: present
    system: yes

- name: Create the Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"

- name: Create the Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ vault_download_mode }}"

- name: Download the Vault binary
  get_url:
    url: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}/"
    mode: "{{ vault_download_mode }}"
  unarchive:
    src: "{{ vault_download_path }}/vault.zip"
    dest: "{{ vault_download_path }}"
    compression: zip

- name: Check if the vault_path exists
  stat:
    path: "{{ vault_path }}"
    state: absent

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ vault_mode }}"

- name: Create directories in vault_path
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ vault_mode }}"
  with_items: "{{ vault_directories }}"

- name: Create data directories
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ vault_mode }}"
  with_items: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  openssl_private_key:
    path: "{{ vault_tls_path }}/{{ item.key }}"
    data: "{{ vault_tls_data }}"
    password: "{{ vault_tls_password }}"
  openssl_csr:
    path: "{{ vault_tls_path }}/{{ item.csr }}"
    data: "{{ vault_tls_data }}"
    privatekey: "{{ vault_tls_path }}/{{ item.key }}"
    password: "{{ vault_tls_password }}"
  openssl_certificate:
    path: "{{ vault_tls_path }}/{{ item.certificate }}"
    data: "{{ vault_tls_data }}"
    csr: "{{ vault_tls_path }}/{{ item.csr }}"
    privatekey: "{{ vault_tls_path }}/{{ item.key }}"
    password: "{{ vault_tls_password }}"
  with_items: "{{ vault_tls_items }}"

- name: Set ownership of TLS material
  file:
    path: "{{ item.path }}"
    state: file
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ vault_mode }}"
  with_items: "{{ vault_tls_files }}"

- name: Copy the Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}"
    mode: "{{ vault_mode }}"
  notify: restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setsebool:
    name: cap_ipc_lock
    state: ep
    persistent: yes

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/vault.env"
    state: touch
    owner: "{{ vault_user }}"
