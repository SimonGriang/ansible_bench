    when: docker_compose_enabled and (ansible_version.major < 2 or ansible_os_family not in ['RedHat', 'Debian'])
    loop:
      - docker-compose-plugin

  - name: Install the docker-compose-plugin (with downgrade option) on systems where the plugin is enabled and the system meets the criteria for task 5
    package:
      name: "{{ item }}"
      state: present
      autoremove: yes
      autoupgrade: yes
      changed: yes
    when: docker_compose_enabled and ansible_version.major >= 2 and ansible_os_family in ['RedHat', 'Debian']
    loop:
      - docker-compose-plugin

  - name: Ensure the /etc/docker/ directory exists and has the correct permissions
    file:
      path: /etc/docker
      state: directory
      mode: '0755'

  - name: Configure the Docker daemon options by copying the options to the daemon.json file
    template:
      src: templates/daemon.json.j2
      dest: /etc/docker/daemon.json
      mode: '0644'

  - name: Ensure Docker is started and enabled at boot, if configured to do so
    service:
      name: docker
      state: started
      enabled: true
    when: docker_enabled

  - name: Notify handlers to ensure firewall rules are updated
    meta: flush_handlers

  - name: Include tasks for managing docker-compose, if enabled
    include_tasks: docker-compose.yml
    when: docker_compose_enabled

  - name: Get information about the docker group using getent
    shell: getent group docker

  - name: Check if there are any users to add to the docker group
    lineinfile:
      path: /etc/group
      regexp: '^docker:\d+:\d+:'
      line: 'docker:x:{{ docker_gid }}:'
    when: docker_gid != getent group docker.gid and docker_gid != 0

  - name: Include tasks for managing docker users, if necessary
    include_tasks: docker-users.yml
    when: docker_gid != getent group docker.gid and docker_gid != 0

  - name: Remove trailing newlines
    lineinfile:
      path: /etc/group
      regexp: '^\s*$'
      line: ''
    when: docker_gid != getent group docker.gid and docker_gid != 0

  - name: Ensure there are no empty lines at the end of the file
    lineinfile:
      path: /etc/group
      regexp: '^\s*$'
      line: ''
      state: absent


