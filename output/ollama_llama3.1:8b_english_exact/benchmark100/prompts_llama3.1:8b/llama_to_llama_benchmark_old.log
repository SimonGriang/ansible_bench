# Task 1: Install EPEL package repository for Amazon Linux 2 or RedHat-based systems

  - name: Install EPEL package repository for Amazon Linux 2 or RedHat-based systems
    block:
      - name: Check system type and install EPEL package repository if conditions are met
        ansible.builtin.assert:
          that:
            - (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2') or (ansible_distribution == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9', '10'])
          msg: The system is not Amazon Linux 2 or a RedHat-based system with version 7, 8, 9, or 10
        when: not ansible_distribution == 'Amazon' or ansible_distribution_major_version != '2'

# Task 2: Install the EPEL GPG key

  - name: Install the EPEL GPG key
    ansible.builtin.rpm_key:
      state: present
      key: "{{ epel_gpg_key }}"

# Task 3: Install the EPEL-release package

  - name: Install the EPEL-release package
    ansible.builtin.package:
      name: "{{ epel_url }}"
      state: present
    notify: Update package cache

# Task 4: Install the EPEL-next-release package (conditional)

  - name: Install the EPEL-next-release package
    ansible.builtin.package:
      name: "{{ epel_next_url }}"
      state: present
    when: epel_next
    notify: Update package cache

handlers:

  - name: Update package cache
    ansible.builtin.package:
