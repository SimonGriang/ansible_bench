---
- name: RKE2 Installation and Configuration
  tasks:
    - name: Download RKE2 installation script
      get_url:
        url: "https://get.rke2.io"
        dest: "/tmp/rke2-install.sh"
        mode: '0755'

    - name: Copy local RKE2 installation script
      copy:
        src: "{{ rke2_path }}/rke2-install.sh"
        dest: "/tmp/rke2-install.sh"
        mode: '0755'
      when: rke2_implementation == 'copy' and rke2_airgap

    - name: Create RKE2 artifacts folder
      file:
        path: "/tmp/rke2-artifacts"
        state: directory
        mode: '0755'
      when: rke2_airgap and rke2_implementation != 'exists'

    - name: Download RKE2 checksum and artifacts
      get_url:
        url: "https://get.rke2.io"
        dest: "/tmp/rke2-artifacts"
        mode: '0755'
      when: rke2_airgap and rke2_implementation == 'download'

    - name: Airgap mode - additional images tarballs
      file:
        path: "/tmp/rke2-artifacts/images.tarballs"
        state: directory
        mode: '0755'
      when: rke2_airgap and rke2_implementation != 'exists' and rke2_additional_tarballs

    - name: Airgap mode - ensure artifacts exist and have acceptable permissions
      stat:
        path: "/tmp/rke2-artifacts"
        state: file
      when: rke2_airgap and rke2_implementation == 'exists'

    - name: Populate service facts
      service_facts:
        gather_subset: ['basic']

    - name: Get stats of the FS object
      file_stats:
        path: "/tmp/rke2-artifacts"

    - name: Check if separate partition
      shell:
        cmd: 'grep "/tmp/rke2-artifacts" /proc/mounts'
      register: result
      until: result.stdout != ""
      retries: 5
      delay: 10

    - name: Set RKE2 bin path
      set_fact:
        rke2_bin_path: "/usr/local/bin/rke2"
      when: (
        '/usr/local' in result.stdout and
        rke2_partition_type == "separate"
      )

    - name: Check RKE2 version
      shell:
        cmd: "rke2 version"

    - name: Set RKE2 versions
      set_fact:
        rke2_version: "1.21.3"
        rke2_desired_version: "1.21.3"
      when: (
        rke2_version.stdout is defined and rke2_version.stdout != rke2_desired_version
      )

    - name: Prevent accidental RKE2 downgrade
      assert:
        that: (
          rke2_version.stdout is defined and rke2_version.stdout >= rke2_desired_version
        )

    - name: Run RKE2 install script
      shell:
        cmd: "/tmp/rke2-artifacts/rke2-install.sh"
        args:
          chdir: "/tmp/rke2-artifacts"
      when: rke2_version.stdout is defined and rke2_version.stdout != rke2_desired_version

    - name: Copy Custom Manifests
      copy:
        src: "{{ rke2_path }}/manifests/*"
        dest: "/tmp/rke2-artifacts/manifests"
        mode: '0644'
      when: rke2_custom_manifests is defined

    - name: Copy Static Pods
      copy:
        src: "{{ rke2_path }}/static-pods/*"
        dest: "/tmp/rke2-artifacts/static-pods"
        mode: '0644'
      when: rke2_static_pods is defined

    - name: Copy RKE2 environment file
      copy:
        src: "{{ rke2_path }}/rke2.env"
        dest: "/tmp/rke2-artifacts/rke2.env"
        mode: '0644'
      when: rke2_environment_options is defined


