---
- name: Import assert.yml and run it once on localhost
  import_tasks: assert.yml
  become: false

- name: Install the dns packages
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - bind9
    - bind9utils

- name: Create the required directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /etc/bind
    - /var/named

- name: Create the required group
  group:
    name: bind
    state: present

- name: Create the required user
  user:
    name: bind
    group: bind
    state: present

- name: Generate the rndc key
  file:
    path: /etc/bind/rndc.key
    state: present
  delegate_to: localhost

- name: Set permissions on the rndc key file
  file:
    path: /etc/bind/rndc.key
    mode: '0600'

- name: Download the named.root file
  get_url:
    url: 'http://ftp.int-dns.net/bind/update/packages/bind-9.11.23-P1.tar.gz'
    dest: /tmp
    mode: '0644'

- name: Create the zone file
  template:
    src: templates/named.conf.default
    dest: /etc/bind/named.conf.default
    mode: '0644'

- name: Add zones to the configuration
  template:
    src: templates/named.conf.default
    dest: /etc/bind/named.conf.default
    mode: '0644'
  notify: reload bind

- name: Place the systemd override
  template:
    src: templates/bind.service
    dest: /etc/systemd/system/bind.service
    mode: '0644'
  notify: reload bind

- name: Start and enable the DNS service
  service:
    name: bind
    state: started
    enabled: yes
  notify: reload bind

