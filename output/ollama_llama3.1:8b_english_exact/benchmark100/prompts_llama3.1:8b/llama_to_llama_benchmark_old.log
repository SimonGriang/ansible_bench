---
- import: assert.yml
  tags:
    - always

- name: Configure Debian for postfix
  debconf:
    name: 'postfix/main_mailer_type'
    value: 'No configuration'
    state: present

- name: Install postfix package
  package:
    name: postfix
    state: present

- name: Install postfix-mysql package
  package:
    name: postfix-mysql
    state: present
  when:
    - '"mysql" in postfix_virtual_mailbox_maps'
    - '"mysql" in postfix_virtual_mailbox_domains'
    - '"mysql" in postfix_virtual_alias_maps'

- name: Configure postfix transport maps
  template:
    src: templates/transport
    dest: /etc/postfix/transport
    mode: '0644'
  notify:
    - validate_postfix_config
    - rebuild_transport_maps

- name: Configure postfix header checks
  template:
    src: templates/header_checks
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
    - validate_postfix_config
    - reload_postfix

- name: Set main.cf values
  template:
    src: templates/main.cf
    dest: /etc/postfix/main.cf
    mode: '0644'
    notify:
      - validate_postfix_config
      - restart_postfix
    vars:
      recipient_access: |-
        {{ postfix_recipient_access | default('') }}
      sender_access: |-
        {{ postfix_sender_access | default('') }}
      mynetworks: |-
        {{ postfix_mynetworks | default('') }}
      mydestination: |-
        {{ postfix_mydestination | default('') }}
      relay_domains: |-
        {{ postfix_relay_domains | default('') }}
      smtpd_recipient_restrictions: |-
        {{ postfix_smtpd_recipient_restrictions | default('') }}
      smtpd_sender_restrictions: |-
        {{ postfix_smtpd_sender_restrictions | default('') }}
      virtual_mailbox_domains: |-
        {{ postfix_virtual_mailbox_domains | default('') }}
      virtual_alias_domains: |-
        {{ postfix_virtual_alias_domains | default('') }}

- name: Configure postfix main.cf
  template:
    src: templates/main.cf
    dest: /etc/postfix/main.cf
    mode: '0644'
    notify:
      - validate_postfix_config
      - restart_postfix

- name: Configure postfix master.cf
  template:
    src: templates/master.cf
    dest: /etc/postfix/master.cf
    mode: '0644'
    notify:
      - validate_postfix_config
      - restart_postfix

- name: Create directory for TLS certificates and keys
  file:
    path: /etc/ssl/private/postfix
    state: directory
    mode: '0700'

- name: Deploy Postfix TLS server certificate
  copy:
    content: '{{ postfix_tls_server_cert }}'
    dest: /etc/ssl/certs/postfix_server_cert.pem
    mode: '0644'
  notify:
    - reload_postfix

- name: Deploy Postfix TLS server key
  copy:
    content: '{{ postfix_tls_server_key }}'
    dest: /etc/ssl/private/postfix_server_key.pem
    mode: '0644'
  notify:
    - reload_postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: templates/aliases
    dest: /etc/aliases
    mode: '0644'
    notify:
      - rebuild_alias_database
      - reload_postfix
  vars:
    aliases: |-
      {{ postfix_aliases | default('') }}

