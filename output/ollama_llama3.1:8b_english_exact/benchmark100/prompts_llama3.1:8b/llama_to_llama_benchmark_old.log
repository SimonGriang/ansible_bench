---
- name: Install EPEL package repository for Amazon Linux 2 or RedHat-based systems
  hosts: all
  become: true

  vars:
    epel_url: epel-release
    epel_next_url: epel-release-next
    epel_gpg_key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-8
    epel_next: false

  handlers:
    - name: Update package cache
      package:
        name: *
        state: present

  tasks:
  - name: Check if system is either Amazon Linux 2 or a RedHat-based system with version 7, 8, 9, or 10
    block:
    - name: Check if system is Amazon Linux 2
      ansible.builtin.system_info:
        fact: os_name
      register: is_amzn
      when: not ansible_distribution in ['Amazon Linux 2', 'RedHat', 'CentOS', 'Fedora']
      failed_when: False
    - name: Check if system is RedHat-based with version 7, 8, 9, or 10
      ansible.builtin.system_info:
        fact: ansible_distribution_version
      register: is_redhat
      when: ansible_distribution in ['RedHat', 'CentOS', 'Fedora'] and (ansible_distribution_major_version | int in [7, 8, 9, 10])
      failed_when: False
    when: not (is_amzn and is_redhat)

  - name: Install the EPEL GPG key
    ansible.builtin.rpm_key:
      state: present
      key: "{{ epel_gpg_key }}"

  - name: Install the EPEL-release package
    ansible.builtin.package:
      name: "{{ epel_url }}"
      state: present
    notify: Update package cache

  - name: Install the EPEL-next-release package (conditional)
    ansible.builtin.package:
      name: "{{ epel_next_url }}"
      state: present
    when: epel_next
    notify: Update package cache

