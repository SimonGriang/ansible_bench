---
- name: Configure and manage MySQL
  hosts: localhost

  tasks:
  - name: Import assert.yml and run it once on localhost
    include_tasks: assert.yml
    run_once: true

  - name: Install the mysql package
    package:
      name: mysql
      state: present

  - name: Configure the mysql server
    template:
      src: templates/mysql-server.cnf.j2
      dest: /etc/mysql/conf.d/{{ mysql_name }}-server.cnf
      mode: '0644'
    notify: restart mysql

  - name: Configure the mysql client
    template:
      src: templates/mysql-client.cnf.j2
      dest: /etc/mysql/conf.d/{{ mysql_name }}-client.cnf
      mode: '0644'
    notify: restart mysql

  - name: Initialize the mysql service
    shell: |
      {{ mysql_initialize_command }}
    when: ansible_distribution in ["Alpine", "Archlinux"]

  - name: Start and enable the mysql service
    service:
      name: mysql
      state: started
      enabled: true

  - name: Flush handlers
    meta: flush_handlers

  - name: Create a my.cnf file in the /root/.my.cnf directory
    template:
      src: templates/my.cnf.j2
      dest: /root/.my.cnf
      mode: '0600'
    notify: restart mysql

  - name: Create databases
    community.mysql.mysql_db:
      name: '{{ item.name }}'
      state: present
    loop: '{{ mysql_databases }}'

  - name: List databases on the target machine
    community.mysql.mysql_info:
      state: info

  - name: Import databases
    community.mysql.mysql_db:
      name: '{{ item.name }}'
      state: import
      sql: '{{ item.initial_import }}'
    loop: '{{ mysql_databases }}'
    when: item.initial_import is defined

  - name: Create users
    community.mysql.mysql_user:
      name: '{{ item.name }}'
      host: '{{ item.host }}'
      password: '{{ item.password }}'
      priv: '{{ item.priv }}'
    loop: '{{ mysql_users }}'

  - name: Flush handlers again
    meta: flush_handlers


