---
- name: Perform Vault tasks
  hosts: localhost

  tasks:
  - name: Import assert.yml file
    include_tasks:
      file: assert.yml
      run_once: true

  - name: Install prerequisites
    apt:
      name: "{{ vault_prerequisites }}"

  - name: Include installation method specific tasks
    include_tasks:
      file: "{{ vault_installation_method }}.yml"

  - name: Add Vault environment variables
    lineinfile:
      dest: /etc/vault.d/vault.env
      regexp: '^VAULT_'
      line: "{{ item.key }}={{ item.value }}"
    loop: "{{ vault_environment_settings|dict2items }}"
    notify: vault-restart

  - name: Include hardening tasks
    include_tasks: hardening.yml

  - name: Start and enable vault on OSS
    service:
      name: vault
      state: started
      enabled: true
    when: vault_type == "oss"

  - name: Enable vault (non-OSS)
    service:
      name: vault
      enabled: true
    when: vault_type != "oss"

  handlers:
  - name: vault-restart
    service:
      name: vault
      state: restarted


