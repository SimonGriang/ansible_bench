---
- name: Validate and run imported tasks
  block:
    - include_tasks: assert.yml
      run_once: true

- name: Install vsftpd package
  package:
    name: vsftpd
    state: present

- name: Configure vsftpd service
  template:
    src: vsftpd.conf.j2
    dest: /etc/pam.d/vsftpd
    mode: '0644'
    owner: root
    group: root
  notify: Restart vsftpd

- name: Start and enable vsftpd service
  service:
    name: vsftpd
    state: started
    enabled: yes


