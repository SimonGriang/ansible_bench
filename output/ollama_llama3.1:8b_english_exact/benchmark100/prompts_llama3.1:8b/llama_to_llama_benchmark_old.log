---
- name: Configure Docker
  tasks:
  - name: Load OS-specific variables
    include_vars: "{{ ansible_os_family }}.yml"
    vars:
      ansible_become: true

  - name: Include setup tasks for RedHat-based systems
    include_tasks: redhat.yml

  - name: Include setup tasks for Debian-based systems
    include_tasks: debian.yml

  - name: Install Docker packages on systems with Ansible version less than 2.12 or non-RedHat/Debian systems
    apt:
      name: "{{ item }}"
      state: present
    loop:
      - apt-transport-https
      - ca-certificates
      - curl
      - software-properties-common
      - docker-ce
      - docker-compose-plugin

  - name: Install Docker packages (with downgrade option) on systems with Ansible version 2.12 or higher and RedHat/Debian systems
    package:
      name: "{{ item }}"
      state: present
      autoremove: yes
      autoupgrade: yes
      changed: true
    when: ansible_version.major >= 2 and ansible_os_family in ['RedHat', 'Debian']
    loop:
      - docker-ce
      - docker-compose-plugin

  - name: Install the docker-compose plugin on systems where the plugin is enabled and the system meets the criteria for task 4 or 5
    apt:
      name: "{{ item }}"
      state: present
    when: docker_compose_enabled and (ansible_version.major < 2 or ansible_os_family not in ['RedHat', 'Debian'])
    loop:
      - docker-compose-plugin

  - name: Install the docker-compose-plugin (with downgrade option) on systems where the plugin is enabled and the system meets the criteria for task 5
    package:
      name: "{{ item }}"
      state: present
      autoremove: yes
      autoupgrade: yes
      changed: true
    when: docker_compose_enabled and ansible_version.major >= 2 and ansible_os_family in ['RedHat', 'Debian']
    loop:
      - docker-compose-plugin

  - name: Ensure the /etc/docker/ directory exists and has the correct permissions
    file:
      path: /etc/docker
      state: directory
      mode: '0755'

  - name: Configure the Docker daemon options by copying the options to the daemon.json file
    template:
      src: templates/daemon.json.j2
      dest: /etc/docker/daemon.json
      mode: '0644'

  - name: Ensure Docker is started and enabled at boot, if configured to do so
    service:
      name: docker
      state: started
      enabled: true
    when: docker_enabled == true

  - name: Notify handlers to ensure firewall rules are updated
    meta: flush_handlers

  - name: Include tasks for managing docker-compose, if enabled
    include_tasks: docker-compose.yml
    when: docker_compose_enabled == true

  - name: Get information about the docker group using getent
    shell: getent group docker

  - name: Check if there are any users to add to the docker group
    lineinfile:
      path: /etc/group
      regexp: '^docker:\d+:\d+:'
      line: 'docker:x:{{ docker_gid }}:'
    when: docker_gid != getent.group.docker.gid and docker_gid != 0

  - name: Include tasks for managing docker users, if necessary
    include_tasks: docker-users.yml
    when: docker_gid != getent.group.docker.gid and docker_gid != 0

  - name: Remove trailing newlines
    lineinfile:
      path: /etc/group
      regexp: '^\s*$'
      line: ''
    when: docker_gid != getent.group.docker.gid and docker_gid != 0

  - name: Ensure there are no empty lines at the end of the file
    lineinfile:
      path: /etc/group
      regexp: '^\s*$'
      line: ''
      state: absent

