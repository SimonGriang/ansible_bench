---
- name: Configure Apache vhosts
  hosts: localhost
  become: yes

  vars:
    httpd_vhosts:
      - { name: 'vhost1', document_root: '/var/www/vhost1', create_docroot: true }
      - { name: 'vhost2', document_root: '/var/www/vhost2' }

  tasks:
    - name: Create the document root for each vhost
      file:
        path: "{{ item.document_root }}"
        state: directory
        owner: root
        group: root
        mode: '0755'
      when:
        - item.document_root is defined
        - item.create_docroot != true
      loop: "{{ httpd_vhosts }}"

    - name: Configure the vhosts
      template:
        src: vhost_conf_template.j2
        dest: "/etc/httpd/conf.d/{{ item.name }}.conf"
        mode: '0644'
      notify:
        - Test httpd configuration validity
        - Restart httpd
      loop: "{{ httpd_vhosts }}"

  handlers:
    - name: Test httpd configuration validity
      test:
        path: "/etc/httpd/conf.d"

    - name: Restart httpd
      service:
        name: httpd
        state: restarted

