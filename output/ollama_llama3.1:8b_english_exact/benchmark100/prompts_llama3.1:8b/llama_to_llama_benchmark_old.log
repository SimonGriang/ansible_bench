---
- name: Manage user
  tasks:
  - name: Create local ssh key directory for a user
    file:
      path: /home/{{ user.name }}/.ssh
      state: directory
      mode: '0700'
  - name: Manage the user account
    user:
      name: "{{ user.name }}"
      comment: "{{ user.comment }}"
      group: "{{ user.group }}"
      create_home: "{{ user.create_home | default(false) }}"
      password: "{{ user.password | default('') }}"
      password_expires: "{{ user.password_expires | default(false) }}"
      home: "{{ user.home | default('/home/{{ user.name }}') }}"
  - name: Set up the user's sudo options
    template:
      src: templates/sudoers.j2
      dest: /etc/sudoers.d/{{ user.name }}
      mode: '0644'
      owner: root
      group: root
    when: user.sudo_options
  - name: Remove sudo options for the user
    file:
      path: /etc/sudoers.d/{{ user.name }}
      state: absent
    when: not user.sudo_options
  - name: Generate the user's private SSH key
    ssh_keygen:
      user: "{{ user.name }}"
      state: present
      type: rsa
      key_type: private
      path: /home/{{ user.name }}/.ssh/{{ user.name }}_private
    when: user.ssh_key_management
  - name: Generate the user's public SSH key
    ssh_keygen:
      user: "{{ user.name }}"
      state: present
      type: rsa
      key_type: public
      path: /home/{{ user.name }}/.ssh/{{ user.name }}_public
    when: user.ssh_key_management
  - name: Convert the user's SSH key to PPK format
    ssh_keygen:
      user: "{{ user.name }}"
      state: present
      type: rsa
      key_type: ppk
      path: /home/{{ user.name }}/.ssh/{{ user.name }}_ppk
    when: user.ssh_key_management
  - name: Get or set the user's home directory
    shell:
      cmd: "getent pwd {{ user.name }}|cut -d: -f1"
      register: user_home
  - name: Create the user's .ssh directory
    file:
      path: "{{ user_home }}/.ssh"
      state: directory
      mode: '0700'
      owner: "{{ user.name }}"
      group: "{{ user.group }}"
  - name: Deploy authorized keys for the user
    authorized_key:
      user: "{{ user.name }}"
      state: present
      key: "{{ user.authorized_keys | default('') }}"
      key_state: present
    when: user.authorized_keys
  - name: Remove unauthorized keys for the user
    authorized_key:
      user: "{{ user.name }}"
      state: absent
      key: "{{ user.unauthorized_keys | default('') }}"
      key_state: absent
    when: user.unauthorized_keys
  - name: Copy the generated private SSH key for the user
    copy:
      content: "{{ lookup('file', '/home/{{ user.name }}/.ssh/{{ user.name }}_private') }}"
      dest: "{{ user_home }}/{{ user.name }}_private"
      mode: '0640'
    when: user.copy_private_key
  - name: Check the user's password validity
    shell:
      cmd: "grep {{ user.name }} /etc/shadow|awk -F: '{print $2}'"
      register: users_pw_valid
  - name: Set the user's password validity
    shell:
      cmd: "if [ {{ users_pw_valid.stdout }} -eq 0 ]; then chage -E never {{ user.name }}; fi"
    when: user.password_validity and users_pw_valid.stdout == 0
  - name: Place the private key file for the user
    copy:
      content: "{{ lookup('file', '/home/{{ user.name }}/.ssh/{{ user.name }}_private') }}"
