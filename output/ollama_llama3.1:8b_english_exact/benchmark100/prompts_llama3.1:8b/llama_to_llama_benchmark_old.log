---
- name: Bootstrap system facts
  gather_facts: false
  tasks:
    - name: Gather system facts
      raw:
        cmd: cat /etc/os-release
      register: bootstrap_facts
      become: false

    - name: Extract distribution and version
      set_fact:
        bootstrap_distribution: ''
        bootstrap_distribution_major_version: ''
      loop: "{{ bootstrap_facts.stdout_lines }}"
      loop_control:
        label: '{{ item }}'
      when: bootstrap_facts.stdout_lines is defined
      vars:
        bootstrap_distribution_pattern: '^NAME="([^"]+)"$'
        bootstrap_distribution_major_version_pattern: '^VERSION_ID="([^"]+)"$'

      tasks:
        - name: Extract distribution
          set_fact:
            bootstrap_distribution: |-
              {{
                item
                  | regex_replace(bootstrap_distribution_pattern, '\\1')
                  | lower
              }}
          when: item is match("{{ bootstrap_distribution_pattern }}")

        - name: Extract major version
          set_fact:
            bootstrap_distribution_major_version: |-
              {{
                item
                  | regex_replace(bootstrap_distribution_major_version_pattern, '\\1')
                  | split('.') | first
              }}
          when: item is match("{{ bootstrap_distribution_major_version_pattern }}")

    - name: Identify OS family
      set_fact:
        bootstrap_os_family: ''
      loop: "{{ bootstrap_os_family_map | dict2items }}"
      when: bootstrap_distribution is defined
      vars:
        bootstrap_os_family_map:
          Debian: Debian
          Ubuntu: Debian
          CentOS: RedHat
          Fedora: RedHat
          Red Hat Enterprise Linux: RedHat
          Amazon Linux: Amazon
          Oracle Linux: OracleLinux
          Gentoo: Gentoo
          Funtoo: Gentoo
          Arch Linux: Archlinux
          SUSE Linux Enterprise Server: Suse
          openSUSE Leap: Suse
          openSUSE Tumbleweed: Suse
          Rocky Linux: RedHat
          AlmaLinux: RedHat
          Fedora Silverblue: RedHat

      tasks:
        - name: Set OS family
          set_fact:
            bootstrap_os_family: "{{ item.key }}"
          when: bootstrap_distribution == item.value

