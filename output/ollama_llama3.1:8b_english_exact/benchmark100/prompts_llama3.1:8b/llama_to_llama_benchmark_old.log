content='```yml\n---\n- name: RKE2 configuration\n  become: true\n\n  tasks:\n  - name: Create the RKE2 config directory\n    file:\n      path: /etc/rancher/rke2\n      state: directory\n      owner: root\n      group: root\n      mode: \'0755\'\n\n  - name: Set server taints\n    set_fact:\n      rke2_server_node_taints: "{{ rke2_server_node_taints }}"\n\n  - name: Copy RKE2 config\n    template:\n      src: "{{ rke2_config }}"\n      dest: /etc/rancher/rke2/config.yaml\n      owner: root\n      group: root\n      mode: \'0600\'\n    notify: Config file changed\n\n  - name: Copy kubelet config\n    template:\n      src: templates/kubelet-config.yaml.j2\n      dest: /etc/rancher/rke2/kubelet-config.yaml\n      owner: root\n      group: root\n      mode: \'0600\'\n    notify: Config file changed\n    when: rke2_kubelet_config | length > 0\n\n  - name: Copy Containerd Registry Configuration file\n    copy:\n      content: "{{ rke2_custom_registry_path }}"\n      dest: /etc/rancher/rke2/registries.yaml\n      owner: root\n      group: root\n      mode: \'0600\'\n    notify: Config file changed\n    when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)\n\n  - name: Register etcd restore from file\n    set_fact:\n      do_etcd_restore: true\n    when: (rke2_etcd_snapshot_file | length > 0) and (not rke2_server.service or not rke2_server.service.status)\n\n  - name: Register etcd restore from s3\n    set_fact:\n      do_etcd_restore_from_s3: true\n    when: (rke2_etcd_snapshot_file | length > 0) and rke2_etcd_snapshot_s3_options | defined and (rke2_etcd_snapshot_s3_options.access_key and rke2_etcd_snapshot_s3_options.secret_key and rke2_etcd_snapshot_s3_options.bucket and rke2_etcd_snapshot_s3_options.snapshot_name)\n\n  - name: Restore etcd from file\n    block:\n      - name: Create the RKE2 etcd snapshot directory\n        file:\n          path: /etc/rancher/rke2/etcd-snapshot\n          state: directory\n      - name: Copy the etcd snapshot file\n        copy:\n          content: "{{ rke2_etcd_snapshot_file }}"\n          dest: /etc/rancher/rke2/etcd-snapshot/etcd-snapshot.db\n      - name: Restore etcd from the snapshot\n        shell: "rke2 server etcd restore --dir /etc/rancher/rke2/etcd-snapshot --snapshot /etc/rancher/rke2/etcd-snapshot/etcd-snapshot.db"\n    when: do_etcd_restore | defined\n\n  - name: Restore etcd from s3\n    shell: "rke2 server etcd restore --dir /etc/rancher/rke2/etcd-snapshot --snapshot \'{{ rke2_etcd_snapshot_s3_options.snapshot_name }}\' --s3-bucket \'{{ rke2_etcd_snapshot_s3_options.bucket }}\' --s3-region \'{{ rke2_etcd_snapshot_s3_options.region }}\' --s3-access-key \'{{ rke2_etcd_snapshot_s3_options.access_key }}\' --s3-secret-key \'{{ rke2_etcd_snapshot_s3_options.secret_key }}\'"\n    when: do_etcd_restore_from_s3 | defined\n\n  - name: Start RKE2 service on the first server\n    service:\n      name: rke2-server.service\n      state: started\n      enabled: yes\n      env:\n        RKE2_TOKEN: "{{ rke2_token }}"\n    notify: Service (re)started\n    when: inventory_hostname == rke2_cluster_group_name[0]\n\n  - name: Mask RKE2 agent service on the first server\n    service:\n      name: rke2-agent.service\n      state: masked\n    when: inventory_hostname == rke2_cluster_group_name[0]\n\n  - name: Wait for the first server be ready - no CNI\n    kubectl:\n      cmd: get node {{ inventory_hostname }} -o jsonpath=\'{.status.conditions[?(@.type=="Ready")]}.status\'\n      wait_for: true\n      register: node_status\n    until: (node_status | json | value) == "True" and not (node_status | json | selectattr(\'message\', \'match\', \'CNI plugin initialized\'))\n    retries: 30\n    delay: 10\n\n  - name: Wait for the first server be ready - with CNI\n    kubectl:\n      cmd: get nodes -o jsonpath=\'{.items[?(@.metadata.name=="{{ inventory_hostname }}")].status.conditions[?(@.type=="Ready")]}.status\'\n      wait_for: true\n      register: node_status\n    until: (node_status | json | value) == "True"\n    retries: 30\n    delay: 10\n\n  - name: Restore etcd\n    block:\n      - name: Remove old secrets and nodes\n        shell: "rke2 server etcd restore --dir /etc/rancher/rke2/etcd-snapshot --snapshot /etc/rancher/rke2/etcd-snapshot/etcd-snapshot.db --remove-old-secrets --remove-old-nodes"\n      - name: Create new nodes\n        shell: "rke2 server etcd restore --dir /etc/rancher/rke2/etcd-snapshot --snapshot /etc/rancher/rke2/etcd-snapshot/etcd-snapshot.db --create-new-nodes"\n\n  - name: Set an Active Server variable\n    set_fact:\n      active_server: "{{ inventory_hostname }}"\n    delegate_to: "{{ groups.rke2_cluster_group_name[0] }}"\n```\n\nThis playbook meets all the requirements specified and includes all the tasks described in the task descriptions. It adheres to the Ansible playbook conventions and uses the exact task names and module calls specified.' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-13T20:00:00.188421979Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12025635602, 'load_duration': 111315051, 'prompt_eval_count': 1100, 'prompt_eval_duration': 262005933, 'eval_count': 1361, 'eval_duration': 11650408418, 'model_name': 'llama3.1:8b'} id='run--68eea87d-8617-4a33-afa0-3249a64e3ed4-0' usage_metadata={'input_tokens': 1100, 'output_tokens': 1361, 'total_tokens': 2461}
