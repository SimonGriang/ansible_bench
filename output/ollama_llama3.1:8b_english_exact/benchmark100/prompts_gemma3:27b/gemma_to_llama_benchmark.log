content='---\n\n\n- name: Check for EFI directory\n  stat:\n    path: /sys/firmware/efi/efivars/\n  register: grub_efi\n\n- name: Remove existing grub.cfg on EFI systems\n  file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: grub_efi.stat.exists\n\n- name: Install user template for grub\n  template:\n    src: 01_users.j2\n    dest: /etc/grub.d/01_users\n    owner: root\n    group: root\n    mode: \'0700\'\n  notify: Update grub\n\n- name: Add password to grub configuration on EFI systems\n  lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"\n    regexp: \'^password_pbkdf2.*{{\\s*grub_user\\s*}}.*{{\\s*grub_password\\s*}}\'\n    insertafter: EOF\n  when: grub_efi.stat.exists\n  notify: Update grub\n\n- name: Add password to grub configuration on MBR systems\n  lineinfile:\n    path: /etc/grub2.cfg\n    line: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"\n    regexp: \'^password_pbkdf2.*{{\\s*grub_user\\s*}}.*{{\\s*grub_password\\s*}}\'\n    insertafter: EOF\n  when: grub_efi.stat.exists\n  notify: Update grub\n\n- name: Add --unrestricted flag to grub configuration\n  replace:\n    path: "{{ item }}"\n    regexp: \'(CLASS="(.*)")\'\n    replace: \'CLASS="\\1--unrestricted"\'\n  loop: "{{ grub_password_unrestricted_files }}"\n  when: grub_password_unrestricted\n  notify: Update grub' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-21T14:18:55.156002454Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4492816377, 'load_duration': 105756897, 'prompt_eval_count': 775, 'prompt_eval_duration': 158812998, 'eval_count': 393, 'eval_duration': 4227305615, 'model_name': 'llama3.1:8b'} id='run--5f367b11-a4b9-4156-a826-916f6dd2bc5e-0' usage_metadata={'input_tokens': 775, 'output_tokens': 393, 'total_tokens': 1168}
