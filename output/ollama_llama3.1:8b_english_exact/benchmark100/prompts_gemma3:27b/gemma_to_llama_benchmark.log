--- 

- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for_connection:
    host: localhost
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'docker'
    - bootstrap_wait_for_host

- name: Prepare system
  block:
    - name: Test connection
      ping:
    - name: Test sudo
      setup:
        method: sudo
      when: "'sudo' in setup['sudo']['enabled']"
  rescue:
    - name: Gather bootstrap facts
      setup:
        method: sudo
      when: "'sudo' in setup['sudo']['enabled']"
      notify: bootstrap_packages
    - name: Install bootstrap packages
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap_facts_packages | list }}"
      when: "'sudo' in setup['sudo']['enabled']"

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages | list }}"
  when: bootstrap_become

