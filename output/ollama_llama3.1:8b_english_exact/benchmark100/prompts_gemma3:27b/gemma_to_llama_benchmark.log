content='```yml\n---\n- name: Restart RKE2 service\n  service:\n    name: "{{ rke2_service_name }}"\n    state: restarted\n  notify:\n    - Service (re)started\n\n- name: Wait for all nodes to be ready\n  shell: >\n    kubectl get nodes --kubeconfig={{ rke2_data_path }}/etc/rancher/rke2/rke2.yaml |\n    grep "STATUS\\| Ready" | wc -l | grep -v "0 " | xargs echo -n | awk \'{print $1}\' |\n    grep -c "^Ready$"\n  delegate_to: "{{ (active_server is defined) | ternary(active_server, rke2_servers_group_name[0].item) }}"\n  retries: 100\n  delay: 15\n  until: item.stdout == rke2_cluster_group_name | length\n  register: wait_for_nodes\n  when: not ansible_check_mode\n\n- name: Wait for all pods to be ready\n  shell: >\n    kubectl get pods --kubeconfig={{ rke2_data_path }}/etc/rancher/rke2/rke2.yaml |\n    grep -vE "(running|succeeded)" | wc -l | awk \'{print $1}\'\n  delegate_to: "{{ (active_server is defined) | ternary(active_server, rke2_servers_group_name[0].item) }}"\n  retries: 100\n  delay: 15\n  until: item.stdout == "0"\n  register: wait_for_pods\n  when: rke2_wait_for_all_pods_to_be_ready and not ansible_check_mode\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-11T17:29:08.458417639Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5170569262, 'load_duration': 2146956647, 'prompt_eval_count': 674, 'prompt_eval_duration': 312035767, 'eval_count': 341, 'eval_duration': 2709875277, 'model_name': 'llama3.1:8b'} id='run--46a2f14e-f2e3-485e-a118-23fb0df801a9-0' usage_metadata={'input_tokens': 674, 'output_tokens': 341, 'total_tokens': 1015}
