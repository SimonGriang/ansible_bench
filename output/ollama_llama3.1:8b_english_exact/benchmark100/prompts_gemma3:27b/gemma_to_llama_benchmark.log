---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml

- name: Task 2 - Pre-configure debian systems
  debconf:
    name: 'postfix/mailer_type'
    value: 'no configuration'
    state: present

- name: Task 3 - Install postfix
  apt:
    name: postfix
    state: present

- name: Task 4 - Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: "'mysql' in postfix_virtual_maps or 'mysql' in postfix_virtual_domains"

- name: Task 5 - Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: '0644'
  notify:
    - postfix validation
    - postfix mysql rebuild
  when: transport_maps_template is defined

- name: Task 6 - Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
    - postfix validation
    - postfix reload
  when: header_checks_template is defined

- name: Task 7 - Setting values for main.cf (1/2)
  set_fact:
    postfix_mydestination: "{{ postfix_mydestination | default('localhost') }}"
    postfix_mailname: "{{ postfix_mailname | default(hostvars[groups['mailhosts'][0]]['fqdn']) }}"
    postfix_mynetworks: "{{ postfix_mynetworks | default('127.0.0.0/8') }}"

- name: Task 8 - Setting values for main.cf (2/2)
  set_fact:
    postfix_mailname: "{{ postfix_mailname | default(hostvars[groups['mailhosts'][0]]['fqdn']) }}"
    postfix_mynetworks: "{{ postfix_mynetworks | default('127.0.0.0/8') }}"

- name: Task 9 - Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - postfix validation
    - postfix restart
  when: main_cf_template is defined

- name: Task 10 - Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - postfix validation
    - postfix restart
  when: master_cf_template is defined

- name: Task 11 - Creates cert/key directory
  file:
    path: "{{ postfix_tls_cert_dir }}"
    state: directory
    mode: '0755'
  when: postfix_tls_cert_dir is defined

- name: Task 12 - Deploy Postfix TLS server certificate
  copy:
    content: "{{ postfix_tls_cert }}"
    dest: "{{ postfix_tls_cert_file }}"
    mode: '0644'
  when: postfix_tls_cert is defined

- name: Task 13 - Deploy Postfix TLS server key
  copy:
    content: "{{ postfix_tls_key }}"
    dest: "{{ postfix_tls_key_file }}"
    mode: '0600'
  when: postfix_tls_key is defined

- name: Task 14 - Flush handlers
  meta: flush_handlers

- name: Task 15 - Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
    mode: '0644'
  notify: postfix alias update

- name: Task 16 - Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: '0644'
  notify: postfix sender_access update

- name: Task 17 - Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: '0644'
  notify: postfix recipient_access update

- name: Task 18 - Place sasl_password_map
  template:
    src: sasl_password_map.j2
    dest: /etc/postfix/sasl_password_map
    mode: '0644'
  notify: postfix sasl_password_map update

- name: Task 19 - Flush handlers again
  meta: flush_handlers

- name: Task 20 - Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes

