---
- name: Configure Promtail
  hosts: localhost
  gather_facts: true

  tasks:
  - name: Assert systemd as init system
    assert:
      that: ansible_distribution == 'Ubuntu'
      msg: "This playbook is designed to work with Ubuntu. Please use a different playbook for your distribution."

  - name: Get latest release
    uri:
