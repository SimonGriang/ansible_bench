---
- name: Verify variable configurations
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for host to be reachable
  wait_for_connection:
    connect_timeout: "{{ bootstrap_timeout }}"
    host: "{{ ansible_ssh_host | default(ansible_host | default(inventory_hostname)) }}"
    port: 22
  when:
    - not ansible_connection == 'docker'
    - not ansible_connection == 'container'
    - bootstrap_wait_for_host

- name: Prepare the system
  block:
    - name: Test connection
      wait_for_connection:
        connect_timeout: "{{ bootstrap_timeout }}"
        host: "{{ ansible_ssh_host | default(ansible_host | default(inventory_hostname)) }}"
        port: 22
      register: bootstrap_connect

    - name: Debug bootstrap_timeout on failure
      debug:
        var: bootstrap_timeout
      when: not bootstrap_connect.connected

    - name: Gather bootstrap facts
      include_tasks: gather_facts.yml

- name: Install bootstrap packages
  raw:
    cmd: "{{ item }}"
    shell: "{{ bootstrap_user }}"
  register: bootstrap_install_packages
  changed_when: "'{{ item.stdout_regex }}" in "{{ item.stdout }}" if (ansible_distribution in ["Alpine", "Archlinux", "Gentoo"]) else "'{{ item.stdout_regex }}" not in "{{ item.stdout }}" if (ansible_distribution in ["Debian", "RedHat", "Rocky", "Suse"])'
  with_items:
    - "{{ bootstrap_packages }}"
  become: true

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup: ""

    - name: Install packages
      package:
        name: "{{ item }}"
        state: present
        update_cache: true
      loop: "{{ bootstrap__facts_packages }}"

