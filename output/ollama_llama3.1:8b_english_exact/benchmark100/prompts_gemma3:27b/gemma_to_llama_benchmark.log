      rke2_running_version: "1.21.4"

  - name: Prevent accidental RKE2 downgrade
    assert:
      that: not rke2_upgrade or rke2_upgrade is True
      msg: RKE2 downgrade is attempted without explicit permission

  - name: Run RKE2 install script
    command:
      cmd: bash /tmp/rke2-install.sh
      chdir: /tmp
      creates: /usr/local/bin/rke2

  - name: Copy Custom Manifests
    copy:
