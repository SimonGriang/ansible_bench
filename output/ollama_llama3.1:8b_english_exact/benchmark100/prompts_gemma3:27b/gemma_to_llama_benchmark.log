---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    dest: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    create: yes
