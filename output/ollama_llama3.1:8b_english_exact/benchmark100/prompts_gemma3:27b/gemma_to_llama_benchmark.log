---
- name: Gather bootstrap facts
  raw:
    cmd: "cat /etc/os-release"
  become: false
  register: bootstrap_facts
  no_log: true
  gather_facts: false

- name: Set bootstrap facts (I)
  block:
  - name: Extract distribution and major version
    set_fact:
      bootstrap_distribution: ""
      bootstrap_distribution_major_version: ""
    when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is undefined
    - bootstrap_distribution is not defined
    - bootstrap_search in bootstrap_facts.stdout

  - name: Loop through possible OS distributions
    set_fact:
      bootstrap_distribution: "{{ item.value | regex_replace('^\D*', '') }}"
      bootstrap_distribution_major_version: "{{ item.value | regex_replace('^\D*|-\d+$', '') }}"
    loop: "{{ bootstrap_os_family_map }}"
    loop_control:
      label: bootstrap_os_family
    when:
    - bootstrap_distribution is undefined
    - bootstrap_distribution is not defined

  - name: Match OS name against current item in loop
    set_fact:
      bootstrap_distribution: "{{ item.value }}"
    when:
    - bootstrap_facts.stdout | regex_search(item.key, bootstrap_search)
    loop: "{{ bootstrap_os_family_map }}"
    loop_control:
      label: bootstrap_os_family

- name: Set bootstrap facts (II)
  block:
  - name: Loop through OS families
    set_fact:
      bootstrap_os_family: "{{ item.key }}"
    loop: "{{ bootstrap_os_family_map }}"
    loop_control:
      label: bootstrap_os_family

  - name: Set bootstrap OS family fact
    set_fact:
      bootstrap_os_family: "{{ item.key }}"
    when:
    - bootstrap_distribution in item.value
    loop: "{{ bootstrap_os_family_map }}"
    loop_control:
      label: bootstrap_os_family


