      mode: '0755'
    when: not airgap_mode | bool

  - name: Copy local RKE2 installation script
    copy:
      content: "{{ lookup('file', '/path/to/local/rke2-install.sh') }}"
      dest: /tmp/rke2-install.sh
      mode: '0755'
    when: airgap_mode and implementation == "copy" | bool

  - name: Create RKE2 artifacts folder
    file:
      path: /usr/local/rke2-artifacts
      state: directory
      mode: '0755'
    when: airgap_mode and implementation != "exists"

  - name: Download RKE2 checksum and artifacts
    get_url:
      url: https://example.com/rke2-artifacts.tar.gz
      dest: /tmp/rke2-artifacts.tar.gz
      mode: '0644'
    when: airgap_mode and implementation == "get"
    ignore_errors: yes

  - name: Download RKE2 checksum and artifacts (fallback to local)
    copy:
      content: "{{ lookup('file', '/path/to/local/rke2-artifacts.tar.gz') }}"
      dest: /tmp/rke2-artifacts.tar.gz
      mode: '0644'
    when: airgap_mode and implementation == "copy"

  - name: Copy local RKE2 artifacts
    copy:
      content: "{{ lookup('file', '/path/to/local/rke2-artifacts.tar.gz') }}"
      dest: /usr/local/rke2-artifacts.tar.gz
      mode: '0644'
    when: airgap_mode and implementation == "copy"

  - name: Airgap mode - additional images tarballs
    copy:
      content: "{{ lookup('file', '/path/to/local/additional-images.tar.gz') }}"
      dest: /usr/local/additional-images.tar.gz
      mode: '0644'
    when: airgap_mode and additional_images.tarball is defined

  - name: Airgap mode - ensure artifacts exist and have acceptable permissions
    file:
