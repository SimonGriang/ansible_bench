---
- name: Manage user account
  hosts: localhost
  become: yes

  tasks:
  - name: Create ssh_key_directory for user
    file:
      path: /home/{{ item.user }}/.ssh
      state: directory
      mode: '0755'
    loop: "{{ user }}"
    when: user.manage_ssh_key is defined and user.manage_ssh_key is true

  - name: Manage user account
    user:
      name: "{{ item.user }}"
      comment: "{{ item.comment }}"
      home: "{{ item.home }}"
      password: "{{ item.password }}"
      uid: "{{ item.uid }}"
      group: "{{ item.group }}"
      shell: "{{ item.shell }}"
      expires: "{{ item.expires }}"
      append: true
    loop: "{{ user }}"
    register: user_result

  - name: Set sudo options for user
    template:
      src: templates/sudo.j2
      dest: /etc/sudoers.d/{{ item.user }}
      mode: '0644'
    loop: "{{ user }}"
    loop_control:
      loop_var: item
    notify: sudo_config_updated
    when: user.sudo_options is defined

  - name: Remove sudo options for user
    file:
      path: /etc/sudoers.d/{{ item.user }}
      state: absent
    loop: "{{ user }}"
    loop_control:
      loop_var: item
    when: not user.sudo_options is defined

  - name: Generate private ssh key for user
    command:
      cmd: ssh-keygen -t rsa -N '' -f /home/{{ item.user }}/.ssh/id_rsa
    when: user.manage_ssh_key is defined and user.manage_ssh_key is true

  - name: Generate public ssh key for user
    command:
      cmd: ssh-keygen -y -f /home/{{ item.user }}/.ssh/id_rsa > /home/{{ item.user }}/.ssh/id_rsa.pub
    when: user.manage_ssh_key is defined

  - name: Convert ssh key to ppk for user
    command:
      cmd: ssh-keygen -p -t rsa -f /home/{{ item.user }}/.ssh/id_rsa
    when: user.manage_ssh_key is defined

  - name: Get or set the home directory for user
    set_fact:
      user_home: "{{ item.home | default('/home') }}"
    loop: "{{ user }}"
    loop_control:
      loop_var: item

  - name: Create .ssh directory for user
    file:
      path: /home/{{ item.user }}/.ssh
      state: directory
      mode: '0700'
    when: user.manage_ssh_key or user.private_keys is defined
    owner: "{{ item.user }}"
    group: "{{ item.group }}"

  - name: Deploy authorized keys for user
    authorized_key:
      user: "{{ item.user }}"
      state: present
      key: "{{ item.key }}"
    loop: "{{ item.authorized_keys }}"
    loop_control:
      loop_var: item

  - name: Remove unauthorized keys for user
    authorized_key:
      user: "{{ item.user }}"
      state: absent
      key: "{{ item.key }}"
    loop: "{{ item.unauthorized_keys }}"
    loop_control:
      loop_var: item

  - name: Copy generated private ssh key for user
    copy:
      content: "{{ lookup('file', '/home/{{ item.user }}/.ssh/id_rsa') }}"
      dest: /home/{{ item.user }}/.ssh/id_rsa
      mode: '0600'
    when: user.copy_private_key is defined

  - name: Check users password valid time
    shell:
      cmd: getent shadow {{ item.user }}
    register: user_shadow
    loop: "{{ user }}"
    loop_control:
      loop_var: item

  - name: Set users password valid time
    shell:
      cmd: chage -E {{ item.expires }} {{ item.user }}
    when: user_shadow is not None

  - name: Place private key file for user
    copy:
      content: "{{ item.content }}"
      dest: /home/{{ item.user }}/.ssh/private_key
      mode: '0600'
      owner: "{{ item.user }}"
      group: "{{ item.group }}"
    when: user.private_keys is defined
    loop: "{{ user }}"
    loop_control:
      loop_var: item

  handlers:
  - name: sudo_config_updated
    service:
      name: sudo
      state: restarted

