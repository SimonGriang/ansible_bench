---
- include_tasks: keepalived.yml
  when:
    - ha_mode_enabled
    - rke2_group_memberships[rke2_servers_group_name] is defined
    - rke2_api_ip is defined

- include_tasks: rke2.yml
  vars:
    rke2_version: "{{ rke2_version }}"

- include_tasks: cis.yml
  when:
    - rke2_cis_profile is defined
    - rke2_cis_profile | length > 0

- include_tasks: find_active_server.yml

- include_tasks: kubevip.yml
  when:
    - ha_mode_enabled
    - not rke2_kubevip_keepalived
    - rke2_group_memberships[rke2_servers_group_name] is defined

- include_tasks: ingress-nginx.yml
  when:
    - rke2_ingress_nginx_values is defined
    - rke2_ingress_nginx_values | length > 0
    - rke2_group_memberships[rke2_servers_group_name] is defined

- include_tasks: first_server.yml
  when:
    - rke2_group_memberships[rke2_servers_group_name] is defined
    - (active_server is undefined or rke2_group_memberships[rke2_servers_group_name] | length == 1)

- include_tasks: first_server_restore.yml
  when:
    - active_server is defined
    - (rke2_group_memberships[rke2_servers_group_name] is defined or rke2_group_memberships[rke2_servers_group_name] is defined)
    - (do_etcd_restore or do_etcd_restore_from_s3 is defined)

- include_tasks: download_kubeconfig.yaml
  when:
    - rke2_download_kubeconf
    - rke2_group_memberships[rke2_servers_group_name] is defined
    - rke2_group_memberships[rke2_servers_group_name] is defined

- include_tasks: remaining_nodes.yml
  when:
    - active_server is defined
    - rke2_group_memberships[rke2_cluster_group_name] | length >= 2

- include_tasks: rolling_cordon_drain_restart_servers.yml
  when:
    - rke2_installed_version is defined
    - rke2_installed_version != rke2_version

- include_tasks: rolling_cordon_drain_restart_agents.yml
  when:
    - rke2_installed_version is defined
    - rke2_installed_version != rke2_version
    - rke2_group_memberships[rke2_servers_group_name] is undefined

- include_tasks: rolling_restart.yml
  when:
    - rke2_restart_needed

- include_tasks: summary.yml


