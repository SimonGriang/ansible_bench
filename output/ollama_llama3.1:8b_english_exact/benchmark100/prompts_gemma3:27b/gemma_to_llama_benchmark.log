--- 

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install requirements
  package:
    name: "{{ sysctl_requirements }}"

- name: Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
  when: item.name is defined and item.value is defined and not container
  loop: "{{ sysctl_items }}"
  loop_control:
    label: "{{ item.name }}"
  notify:
    - sysctl_reload
  when: sysctl_set|bool

