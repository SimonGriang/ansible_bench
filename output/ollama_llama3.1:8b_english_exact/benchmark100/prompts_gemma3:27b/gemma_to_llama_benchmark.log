--- 

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"

- name: See if the specified user exists
  getent:
    database: passwd
    name: "{{ git_username }}"
  register: user_exists
  failed_when: user_exists == ""

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}/.gitconfig"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0700'

- name: Place git configuration
  template:
    src: "gitconfig.j2"
    dest: "/home/{{ git_username }}/.gitconfig"
    mode: '0600'

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0700'

- name: Clone all roles
  git:
    repo: "{{ item.repository_url }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    version: "{{ item.version }}"
    force: true
  loop: "{{ git_repositories }}"
  loop_control:
    label: "{{ item.name }}"
  register: git_clone_result
  notify: git repositories cloned

