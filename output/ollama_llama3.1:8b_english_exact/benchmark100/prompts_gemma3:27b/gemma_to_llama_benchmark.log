---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2 - Install nginx
  package:
    name: nginx
    state: present

- name: Task 3 - Place nginx.conf
  template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: '0644'
  notify:
    - Restart nginx
  delegate_to: localhost
  delegate_facts: yes
  delegate_to: localhost
  command: nginx -t -c %s
  args: /etc/nginx/nginx.conf

- name: Task 4 - Ensure /etc/nginx/conf.d exists
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: '0755'

- name: Task 5 - Place default.conf
  template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'
  notify:
    - Restart nginx

- name: Task 6 - Start and enable nginx
  service:
    name: nginx
    state: started
    enabled: yes


