--- 

- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Pre-configure debian systems
  debconf:
    name: 'postfix/mailname'
    value: 'No configuration'
    vtype: 'string'
  when: ansible_distribution == 'Debian'

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: mail_virtual_maps_type == 'mysql' or mail_domains_type == 'mysql'

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: '0644'
  notify:
    - postfix validation
    - postfix database rebuild
  when: transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
    - postfix validation
    - postfix reload
  when: header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    mail_myorigin: "{{ mail_myorigin_default if mail_myorigin is undefined else mail_myorigin }}"
    mail_mydestination: "{{ mail_mydestination_default if mail_mydestination is undefined else mail_mydestination }}"
  when: mail_myorigin is defined or mail_mydestination is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    mail_mydestination: "{{ mail_mydestination | default('localhost') }}"
    mail_myhostname: "{{ mail_myhostname | default('localhost') }}"
    mail_etc_aliases: "{{ mail_etc_aliases | default([]) }}"
  when: mail_mydestination is defined or mail_myhostname is defined or mail_etc_aliases is defined

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - postfix validation
    - postfix restart
  when: mail_myorigin is defined or mail_mydestination is defined or mail_myhostname is defined or mail_etc_aliases is defined

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - postfix validation
    - postfix restart
  when: mail_myorigin is defined or mail_mydestination is defined or mail_myhostname is defined or mail_etc_aliases is defined

- name: Creates cert/key directory
  file:
    path: "{{ postfix_tls_cert_dir }}"
    state: directory
    mode: '0755'
  when: postfix_tls_cert_dir is defined

- name: Deploy Postfix TLS server certificate
  file:
    src: "{{ postfix_tls_cert_src }}"
    dest: "{{ postfix_tls_cert_path }}"
    mode: '0644'
    state: link
  when: postfix_tls_cert_src is defined

- name: Deploy Postfix TLS server key
  file:
    src: "{{ postfix_tls_key_src }}"
    dest: "{{ postfix_tls_key_path }}"
    mode: '0644'
    state: link
  when: postfix_tls_key_src is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
    mode: '0644'
  when: mail_aliases is defined

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: '0644'
  when: mail_sender_access is defined

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: '0644'
  when: mail_recipient_access is defined

- name: Place sasl_password_map
  file:
    path: /etc/postfix/sasl_password_map
    content: "{{ mail_sasl_password_map }}"
    state: file
    mode: '0644'
  when: mail_sasl_password_map is defined

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true

