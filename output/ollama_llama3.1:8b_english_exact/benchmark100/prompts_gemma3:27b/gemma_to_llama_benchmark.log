3.1:8b', 'created_at': '2025-10-11T15:02:05.771081309Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11831619184, 'load_duration': 127699926, 'prompt_eval_count': 1092, 'prompt_eval_duration': 362741759, 'eval_count': 971, 'eval_duration': 11339267353, 'model_name': 'llama3.1:8b'} id='run--db3eb0d4-bc3c-404f-b11d-3309ce0b9b83-0' usage_metadata={'input_tokens': 1092, 'output_tokens': 971, 'total_tokens': 2063}
