---
- name: Configure Java
  tasks:
  - name: Migrate from adoptopenjdk to temurin if selected
    set_fact:
      java_jdk_vendor: "temurin"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Gather OS specific variables
    include_vars:
      file: "vars/{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.yml"

  - name: Gather architecture specific variables
    include_vars:
      file: "architecture.yml"

  - name: Set OS specific variables (I)
    set_fact:
      java_open_jdk_version: "{{ java_open_jdk_version_default | default('default') }}"
      java_open_jdk_repos: "{{ java_open_jdk_repos_default | default('default') }}"
      java_open_jdk_libs: "{{ java_open_jdk_libs_default | default('default') }}"

  - name: Set OS and architecture specific variables (II)
    set_fact:
      java_open_jdk_home_dir: "{{ java_open_jdk_home_dir_default | default('/usr/lib/jvm') }}"
      java_open_jdk_package: "{{ java_open_jdk_package_default | default('openjdk-{{ java_open_jdk_version }}') }}"

  - name: Set specific variables
    set_fact:
      java_home: "{{ java_open_jdk_home_dir }}/{{ java_open_jdk_package }}"

  - name: Remove deprecated repositories (Debian)
    apt:
      name: "{{ item }}"
      state: absent
      when: java_deprecated_repositories_adoptopenjdk and ansible_distribution == 'Debian'
    loop: "{{ java_deprecated_repositories_adoptopenjdk }}"

  - name: Install extra apt tools (Debian)
    apt:
      name: "{{ item }}"
      state: present
      when: java_open_jdk_apt_extra_packages and ansible_distribution == 'Debian'
    loop: "{{ java_open_jdk_apt_extra_packages }}"

  - name: Add required key repositories (Debian)
    apt_key:
      keyserver: "{{ item.keyserver }}"
      state: present
      when: java_required_key_repositories_openjdk and ansible_distribution == 'Debian'
    loop: "{{ java_required_key_repositories_openjdk }}"

  - name: Add required repositories (Debian)
    apt_repository:
      repo: "{{ item.repo }}"
      state: present
      when: java_required_repositories_openjdk and ansible_distribution == 'Debian'
    loop: "{{ java_required_repositories_openjdk }}"

  - name: Add required key repositories (RedHat)
    rpm_key:
      key: "{{ item.key }}"
      state: present
      when: java_required_key_repositories_openjdk and ansible_distribution == 'RedHat'
    loop: "{{ java_required_key_repositories_openjdk }}"

  - name: Add required repositories (RedHat)
    yum_repository:
      name: "{{ item.repo }}"
      state: present
      when: java_required_repositories_openjdk and ansible_distribution == 'RedHat'
    loop: "{{ java_required_repositories_openjdk }}"

  - name: Install required libs
    package:
      name: "{{ item }}"
      state: present
      when: java_required_libs_openjdk
    loop: "{{ java_required_libs_openjdk }}"

  - name: Install Java (Debian)
    apt:
      name: "{{ java_open_jdk_package }}={{ java_open_jdk_version }}"
      state: present
      when: java_open_jdk_package and ansible_distribution == 'Debian'

  - name: Install Java (RedHat)
    yum:
      name: "{{ java_open_jdk_package }}={{ java_open_jdk_version }}"
      state: present
      when: java_open_jdk_package and ansible_distribution == 'RedHat'

  - name: Export environment variables
    template:
      src: "templates/jdk.sh.j2"
      dest: "/etc/profile.d/jdk.sh"
      mode: '0755'

  - name: Source environment variables
    command: "source /etc/profile"

  - name: Correct java version selected (Debian, Java < 11)
    become: yes
    become_user: root
    command: "update-alternatives --set java /usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk-amd64/bin/java"
    when: java_open_jdk_version < 11 and ansible_distribution == 'Debian'

  - name: Correct java version selected (Debian, Java >= 11)
    become: yes
    become_user: root
    command: "update-alternatives --set java /usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk-amd64/bin/java"
    when: java_open_jdk_version >= 11 and ansible_distribution == 'Debian'

