---
- name: Configure DNS
  hosts: localhost
  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml

    - name: Install dns
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ dns_packages }}"

    - name: Create directories
      file:
        path: "{{ item.path }}"
        mode: "{{ item.mode }}"
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
      loop:
        - { path: "{{ dns_datadir }}", mode: '0755', owner: 'root', group: 'root' }
        - { path: "{{ dns_confdir }}", mode: '0755', owner: 'root', group: 'root' }

    - name: Create group
      group:
        name: "{{ dns_group }}"
        state: present
      when: dns_group is defined

    - name: Create user
      user:
        name: "{{ dns_owner }}"
        system: yes
        shell: /bin/false
      when: dns_owner is defined

    - name: Generate rndc key
      shell:
        cmd: rndc-confgen -a "{{ dns_confdir }}/rndc.key"
      when: not dns_key_file

    - name: Set permissions on rndc key file
      file:
        path: "{{ dns_confdir }}/rndc.key"
        mode: '0600'
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"

    - name: Get the hints/root file
      get_url:
        url: "{{ dns_root_url }}"
        dest: "{{ dns_datadir }}/{{ dns_root_file }}"
        mode: '0644'
        not_if: "test -f '{{ dns_datadir }}/{{ dns_root_file }}'"
      notify: Rndc reload

    - name: Create zone file
      template:
        src: templates/{{ item.name }}.j2
        dest: "{{ dns_datadir }}/{{ item.name }}"
        mode: '0644'
      loop: "{{ dns_zones }}"
      notify: Rndc reload
      when: dns_caching_dns is true

    - name: Validate and set permissions on zone file
      shell:
        cmd: named-checkzone {{ item.name }} {{ dns_datadir }}/{{ item.name }}
      loop: "{{ dns_zones }}"
      notify: Rndc reload
      when: dns_caching_dns is true

    - name: Add zones to configuration
      template:
        src: templates/named.j2
        dest: "{{ dns_confdir }}/named.conf"
        mode: '0644'
      notify: Restart dns
      when: dns_caching_dns is true

    - name: Validate named configuration
      shell:
        cmd: named-checkconf
      notify: Restart dns
      when: dns_caching_dns is true

    - name: Create backup of named configuration
      copy:
        content: |
          {% for zone in dns_zones %}
          zone "{{ zone.name }}" {
            type {{ zone.type }};
            file "{{ dns_datadir }}/{{ zone.name }}";
          };
          {% endfor %}
        dest: "{{ dns_confdir }}/named.conf.bak"
        mode: '0644'

    - name: Place systemd override
      file:
        path: /etc/systemd/system/dns.service.d/override.conf
        mode: '0644'
        content: |
          [Service]
          EnvironmentFile={{ dns_confdir }}/named.conf
      when: ansible_distribution == 'Fedora' or ansible_distribution == 'CentOS' or ansible_distribution == 'Red Hat Enterprise Linux'

    - name: Reload systemd daemon
      service:
        name: systemd
        state: reloaded
      when: ansible_distribution == 'Fedora' or ansible_distribution == 'CentOS' or ansible_distribution == 'Red Hat Enterprise Linux'

    - name: Start and enable dns
      service:
        name: "{{ dns_service }}"
        state: started
        enabled: yes

