---
- name: Configure Fail2ban
  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml
      delegate_to: localhost

    - name: Install fail2ban
      package:
        name: "{{ fail2ban_packages }}"

    - name: Copy filters in filter.d
      copy:
        src: "{{ fail2ban_filterd_path }}"
        dest: /etc/fail2ban/filter.d/
        owner: root
        group: root
        mode: '0640'
      notify: Restart fail2ban
      when: fail2ban_filterd_path is defined

    - name: Configure fail2ban.local
      ini_file:
        dest: /etc/fail2ban/fail2ban.local
        section: fail2ban
        mode: '0640'
        options:
          "{{ item.option }}={{ item.value }}"
        notify: Restart fail2ban
      loop:
        - {{ fail2ban_base_configuration | combine(fail2ban_configuration) }}
      loop_control:
        label: "{{ item.option }}"

    - name: Configure jail.local
      ini_file:
        dest: /etc/fail2ban/jail.local
        section: jail
        mode: '0640'
        options:
          "{{ item.option }}={{ item.value }}"
        notify: Restart fail2ban
      loop:
        - {{ fail2ban_base_jail_configuration | combine(fail2ban_jail_configuration) }}
      loop_control:
        label: "{{ item.option }}"

    - name: Stat auth log file
      stat:
        path: /var/log/auth.log
        register: fail2ban_auth

    - name: Touch auth log file
      file:
        path: /var/log/auth.log
        state: touch
        mode: '0640'
      when: fail2ban_auth.stat.exists is defined and fail2ban_auth.stat.exists is false

    - name: Start and enable fail2ban
      service:
        name: "{{ fail2ban_service }}"
        state: started
        enabled: yes


