  vars:
    httpd_directories:
      - /var/www/html
      - /var/www/docs
      - /var/www/images

  tasks:
  - name: Create directories
    file:
      path: "{{ item }}"
      state: directory
      mode: '0755'
    loop: "{{ httpd_directories }}"
