---
- name: Configure and Initialize MySQL
  hosts: localhost
  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install mysql
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ mysql_packages }}"
    notify:
      - Set root password
      - Systemctl daemon-reexec

  - name: Configure mysql server
    template:
      src: "mysql_name-server.cnf.j2"
      dest: "/etc/mysql/mysql_name-server.cnf"
      mode: '0640'
    notify:
      - Restart mysql server

  - name: Configure mysql client
    template:
      src: "mysql_name-client.cnf.j2"
      dest: "/etc/mysql/mysql_name-client.cnf"
      mode: '0640'
      owner: root
      group: root

  - name: Initialize mysql
    command: "{{ mysql_initialize_command }}"
    when:
      - ansible_distribution == 'Alpine'
      - ansible_distribution == 'Archlinux'

  - name: Start and enable mysql
    service:
      name: "{{ mysql_service }}"
      state: started
      enabled: yes

  - meta: flush_handlers

  - name: Place my.cnf
    copy:
      content: "{{ lookup('template', 'my.cnf.j2') }}"
      dest: "/root/.my.cnf"
      mode: '0640'

