---
- name: Configure GRUB settings
  hosts: localhost
  gather_facts: no

  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml

    - name: Install required packages
      package:
        name: "{{ grub_packages }}"
        state: present

    - name: Set GRUB_TIMEOUT
      lineinfile:
        dest: /etc/default/grub
        line: "GRUB_TIMEOUT={{ grub_timeout }}"
        create: yes
        mode: '0644'
      notify: Update grub

    - name: Set GRUB_RECORDFAIL_TIMEOUT
      lineinfile:
        dest: /etc/default/grub
        line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
        create: yes
        mode: '0644'
      notify: Update grub

    - name: Add options to GRUB_CMDLINE_LINUX
      lineinfile:
        dest: /etc/default/grub
        line: "GRUB_CMDLINE_LINUX=\"{{ grub_CMDLINE_LINUX }} {{ item }}\""
        regex: '^GRUB_CMDLINE_LINUX=".*"'
        backrefs: yes
      loop:
        - "{{ grub_options[0] }}"
      when: grub_options is defined and grub_options | length > 0
      notify: Update grub

    - name: Import password.yml
      include_tasks: password.yml
      when: grub_set_password

    - name: Flush handlers
      meta: flush_handlers


