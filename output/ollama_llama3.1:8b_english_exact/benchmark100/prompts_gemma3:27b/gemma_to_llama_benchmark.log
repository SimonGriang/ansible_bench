---
- name: Main tasks
  hosts: localhost

  tasks:
  - name: Import tasks from assert.yml
    include_tasks: assert.yml

  - name: Install required software
    apt:
      name: "{{ item }}"
      state: present
    loop: "{{ users_requirements | default([]) }}"

  - name: Include tasks from group.yml for each group
    include_tasks: group.yml
    loop: "{{ users_groups }}"
    loop_control:
      label: "{{ item }}"

  - name: Include directory in sudoers file
    lineinfile:
      dest: /etc/sudoers
      line: "%sudo ALL=(ALL:ALL) NOPASSWD:ALL"
      state: present
      validate: '/usr/sbin/visudo -cf %s'
    when: users_sudo_includedir is defined

  - name: Include tasks from user.yml for each user
    include_tasks: user.yml
    loop: "{{ users }}"
    loop_control:
      label: "{{ item }}"

  - name: Manage cron permission
    template:
      src: cron.allow.j2
      dest: /etc/cron.allow
      mode: '0644'
    when: users_cron_allow is true

  - name: Ensure /etc/cron.allow file does not exist
    file:
      path: /etc/cron.allow
      state: absent
    when: users_cron_allow is false


