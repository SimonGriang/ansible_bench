- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install dns
  apt:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: "{{ dns_datadir }}", mode: '0755', owner: 'root', group: 'root' }
    - { path: "{{ dns_confdir }}", mode: '0755', owner: 'root', group: 'root' }

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present
  when: dns_group is defined

- name: Create user
  user:
    name: "{{ dns_owner }}"
    system: yes
    home: "/var/lib/{{ dns_owner }}"
    group: "{{ dns_group }}"

- name: Generate rndc key
  command: rndc-confgen -a /etc/bind/rndc.key
  when: "/etc/bind/rndc.key" is file
  notify: Restart dns

- name: Set permissions on rndc key file
  file:
    path: /etc/bind/rndc.key
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0600'

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/{{ dns_root_hints_file }}"
    mode: '0644'
    validate_certs: no
  when: dns_caching_dns == true
  notify: Rndc reload

- name: Create zone file
  template:
    src: "zone.j2"
    dest: "{{ dns_datadir }}/{{ item.name }}.{{ item.zone }}"
    mode: '0644'
  loop:
    - { name: "example.com", zone: "com" }
  notify: Rndc reload
  delegate_to: localhost

- name: Validate zone file
  command: named-checkzone -d {{ dns_datadir }}/{{ item.name }}.{{ item.zone }}
  loop:
    - { name: "example.com", zone: "com" }
  delegate_to: localhost
  failed_when: false

- name: Set permissions on zone file
  file:
    path: "{{ dns_datadir }}/{{ item.name }}.{{ item.zone }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  loop:
    - { name: "example.com", zone: "com" }

- name: Add zones to configuration
  template:
    src: "named.j2"
    dest: "{{ dns_confdir }}/named.conf"
    mode: '0644'
  notify: Restart dns
  delegate_to: localhost

- name: Validate named configuration
  command: named-checkconf
  delegate_to: localhost
  failed_when: false

- name: Create named configuration backup
  copy:
    content: "{{ lookup('template', 'named.conf.j2') }}"
    dest: "{{ dns_confdir }}/named.confbak"
    mode: '0644'

- name: Place systemd override
  file:
    path: /etc/systemd/system/bind9.service.d/override.conf
    state: touch
  when: dns_service == 'bind9'
  notify: Reload systemd daemon
  delegate_to: localhost

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
