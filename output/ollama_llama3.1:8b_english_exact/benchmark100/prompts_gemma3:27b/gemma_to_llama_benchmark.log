---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection not in ['docker', 'podman']
    - bootstrap_wait_for_host

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.setup:
        gather_subset: ["all"]
    - name: Test sudo access
      ansible.builtin.setup:
        gather_subset: ["all"]
  rescue:
    - name: Gather facts
      ansible.builtin.setup:
        gather_subset: ["all"]
    - name: Install bootstrap packages via raw
      ansible.builtin.raw: "{{ bootstrap_packages_raw }}"
    - name: Ensure libdnf5 is present on RedHat-based systems
      ansible.builtin.package:
        name: libdnf5
        state: present
      when: ansible_distribution == 'RedHat' or ansible_distribution == 'CentOS'

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: ["all"]

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
    become: "{{ bootstrap_become }}"

