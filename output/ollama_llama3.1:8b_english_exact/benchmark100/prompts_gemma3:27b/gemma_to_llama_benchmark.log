---
- name: Configure Fail2Ban
  hosts: localhost
  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
  - name: Install fail2ban
    package:
      name: "{{ fail2ban_packages }}"
  - name: Copy filters in filter.d
    copy:
      content: "{{ lookup('file', fail2ban_filterd_path) }}"
      dest: /etc/fail2ban/filter.d/
      owner: root
      group: root
      mode: '0640'
    notify: Restart fail2ban
    when: fail2ban_filterd_path is defined
  - name: Configure fail2ban.local
    ini_file:
      dest: /etc/fail2ban/fail2ban.local
      mode: '0640'
      section: fail2ban
      option: "{{ item.option }}"
      value: "{{ item.value }}"
    notify: Restart fail2ban
    loop: "{{ fail2ban_base_configuration + fail2ban_configuration }}"
  - name: Configure jail.local
    ini_file:
      dest: /etc/fail2ban/jail.local
      mode: '0640'
      section: jail
      option: "{{ item.option }}"
      value: "{{ item.value }}"
    notify: Restart fail2ban
    loop: "{{ fail2ban_base_jail_configuration + fail2ban_jail_configuration }}"
  - name: Stat auth log file
    stat:
      path: /var/log/auth.log
    register: fail2ban_auth
  - name: Touch auth log file
    file:
      path: /var/log/auth.log
      state: touch
      mode: '0640'
    when: fail2ban_auth.stat.exists is defined and fail2ban_auth.stat.exists == False
  - name: Start and enable fail2ban
    service:
      name: "{{ fail2ban_service }}"
      state: started
      enabled: yes


