    file:
      path: "{{ vault_path }}"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '0755'
      state: directory
    when: not vault_check_path.stat.exists and vault_path != ""

  - name: Create directory in vault_path
    file:
      path: "{{ item.path }}"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '{{ item.mode }}'
      state: directory
    loop: "{{ vault_directories }}"
    loop_control:
      loop_var: item

  - name: Create data directory
    file:
      path: "{{ item.path }}"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '{{ item.mode }}'
      state: directory
    loop: "{{ vault_data_directories }}"
    loop_control:
      loop_var: item

  - name: Generate TLS key and certificate
    command:
      cmd: openssl req -x509 -newkey rsa:4096 -nodes -keyout tls.key -out tls.crt -days 365 -subj "/C=US/ST=Denial/L=Research/O=My\ Company/CN=vault.example.com"
      chdir: "{{ vault_data_directory }}/tls/"
    notify: Restart vault

  - name: Set ownership of tls material
    file:
      path: "{{ item.path }}"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '{{ item.mode }}'
      state: file
    loop: "{{ vault_tls_files }}"
    loop_control:
      loop_var: item

