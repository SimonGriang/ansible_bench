---
- name: Assert systemd as init system
  assert:
    that: systemd.fact.init_system == 'systemd'
    msg: 'Systemd init system expected but {{ systemd.fact.init_system }} found'

- name: Get latest release
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    headers:
      accept: application/json
    status:
      - 200
      - 404
    retries: 5
    retry_delay: 1
    return_content: true
  register: _latest_release

- name: Set promtail version to {{ _latest_release.json.tag_name[1:] }}
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"

- name: Test if zip local archive exists
  stat:
    path: '{{ promtail_binary_local_dir }}'
    get_stat_mode: true
  register: promtail_binary_local_archive

- name: Assert local binary exists
  assert:
    that: promtail_binary_local_archive.stat.exists
    msg: 'Local promtail binary archive expected but {{ promtail_binary_local_archive.stat.exists }} found'

- name: Get checksum list
  uri:
    url: https://github.com/grafana/loki/releases/download/{{ promtail_version }}/SHA256SUMS
    method: GET
    headers:
      accept: text/plain
    status:
      - 200
      - 404
    retries: 5
    retry_delay: 1
    return_content: true
  register: __promtail_checksums

- name: Get checksum for {{ go_arch }} architecture
  debug:
    msg: "{{ __promtail_checksums.content | split('\n') | selectattr('value', 'match', '^{{ item }}$') | map(attribute='value') | first }}"
  loop: "{{ __promtail_checksums.content | split('\n') }}"
  loop_control:
    loop_var: item
  when: promtail_binary_local_dir is undefined


