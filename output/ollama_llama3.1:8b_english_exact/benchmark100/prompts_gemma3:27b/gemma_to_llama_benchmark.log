- name: Get all RKE2 nodes
  shell: 
    cmd: kubectl get nodes --kubeconfig=/root/.kube/config -o jsonpath='{.items[*].metadata.name}'
  register: node_names

- name: Remove old RKE2 nodes
  kubectl:
    cmd: delete node {{ item }}
    kubeconfig: /root/.kube/config
    state: absent
  with_items: "{{ node_names.stdout_lines }}"
  ignore_errors: yes
  when: item not in groups['rke2_cluster_group_name']

