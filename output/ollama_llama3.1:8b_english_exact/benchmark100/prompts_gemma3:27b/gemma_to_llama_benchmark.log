    ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: 'redis.conf-{{ ansible_distribution }}.j2'
    dest: '{{ redis_configuration_directory }}/{{ redis_configuration_file }}'
    mode: '0644'
    owner: 'root'
    group: 'root'
  notify: Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true

