---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: templates/mysql_name-server.cnf.j2
    dest: /etc/mysql/mysql_name-server.cnf
    mode: '0640'
  notify: Restart mysql server
  vars:
    mysql_configuration_options: "{{ mysql_configuration_options | default({}) }}"

- name: Configure mysql client
  template:
    src: templates/mysql_name-client.cnf.j2
    dest: /etc/mysql/mysql_name-client.cnf
    mode: '0640'
  vars:
    mysql_socket: "{{ mysql_socket | default('/var/run/mysqld/mysqld.sock') }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution == 'Alpine' or ansible_distribution == 'Archlinux'

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  copy:
    src: templates/my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    user: root
    password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"
  loop_control:
    persisted: true

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('') }}"
    host: "{{ item.host | default('%') }}"
    user: root
    password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"
  loop_control:
    persisted: true

- name: Flush handlers again
  meta: flush_handlers


