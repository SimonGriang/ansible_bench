---
- name: Task 1 - Create necessary directories for cadvisor
  file:
    path: /opt/cadvisor
    state: directory
    mode: '0755'

- name: Task 2 - Download cadvisor binary
  get_url:
    url: "{{ cadvisor_download }}"
    dest: /opt/cadvisor/cadvisor-{{ cadvisor_version }}
    mode: '0755'
    sha256: "{{ cadvisor_checksum }}"
  when: cadvisor_binary_local_dir | bool == false

- name: Task 3 - Propagate locally distributed cadvisor binary
  copy:
    content: "{{ lookup('file', cadvisor_binary_local_dir + '/cadvisor-{{ cadvisor_version }}') }}"
    dest: /opt/cadvisor/cadvisor-{{ cadvisor_version }}
    mode: '0755'
    owner: root
    group: root
  notify:
    - restart cadvisor
  when: cadvisor_binary_local_dir | bool == true

- name: Task 4 - Symlink cadvisor
  file:
    src: /opt/cadvisor/cadvisor-{{ cadvisor_version }}
    dest: /opt/cadvisor/cadvisor
    state: link
    force: yes

- name: Task 5 - Create cadvisor systemd service
  template:
    src: systemd-system-cadvisor-service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'
  notify:
    - restart cadvisor

- name: Task 6 - Test if cadvisor systemd service is active
  shell:
    cmd: 'systemctl is-active cadvisor'
    register: service_active
  failed_when: false

- name: Task 7 - Debug
  debug:
    var: service_active

- name: Task 8 - Enable cadvisor systemd service
  systemd:
    name: cadvisor.service
    enabled: yes

- name: Task 9 - Start cadvisor systemd service
  systemd:
    name: cadvisor.service
    state: started
    daemon_reload: yes


