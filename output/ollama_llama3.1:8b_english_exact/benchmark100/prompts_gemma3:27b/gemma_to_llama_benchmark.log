---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: templates/{{ mysql_name }}-server.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: '0644'
  when: mysql_configuration_options is defined

- name: Configure mysql client
  template:
    src: templates/{{ mysql_name }}-client.cnf.j2
    dest: /etc/mysql/client.cnf
    mode: '0644'

- name: Initialize mysql
  shell: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  copy:
    content: "{{ lookup('template', 'my.cnf.j2') }}"
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    target: "{{ item.target | default('root') }}"
    encoding: "{{ item.encoding | default('utf8') }}"
    collation: "{{ item.collation | default('utf8_general_ci') }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: List databases
  mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
  register: database_info

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    target: "{{ item.target | default('root') }}"
    state: 'present'
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
    import_file: "{{ item.target }}"
  when: initial_import_target and item.name not in database_info.databases
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password | password_hash('mysql') }}"
    priv: "{{ item.privileges | default('*.*:ALL') }}@{{ item.host | default('%') }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers

