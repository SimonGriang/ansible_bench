---
- name: Check if the Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: helm version
  register: helm_existing_version
  failed_when: false
  changed_when: false

- name: Download helm
  unarchive:
    src: "{{ helm_repo_path }}/{{ helm_version }}/{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: /tmp
    remote_src: true
    state: present
  when: not helm_check.stat.exists or helm_existing_version.stdout != helm_version
  register: helm_download

- name: Copy helm binary into place
  copy:
    src: "/tmp/{{ helm_platform }}-{{ helm_arch }}"
    dest: "{{ helm_bin_path }}"
    mode: '0755'
    remote_src: true
  when: helm_download.changed
  become: true

