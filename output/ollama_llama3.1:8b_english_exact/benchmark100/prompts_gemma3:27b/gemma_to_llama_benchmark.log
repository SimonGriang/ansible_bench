---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip
  apt:
    name: "{{ python_pip_packages }}"
    state: 'present'

- name: Configure pip proxy
  template:
    src: templates/pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
  when: python_pip_proxy is defined
  notify: restart pip

- name: Trust hosts
  template:
    src: templates/pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
  when: python_pip_trusted_host is defined
  notify: restart pip

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
    skip_if_unavailable: yes
  when: python_pip_pip_package is defined

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default('') }}"
    executable: "{{ python_pip_executable }}"
    skip_if_unavailable: yes
  loop: "{{ python_pip_modules }}"
  loop_control:
    label: "{{ item.name }}"
  when: python_pip_modules is defined


