---
- name: Verify variable configurations
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for host to be reachable
  wait_for_connection:
    timeout: "{{ bootstrap_timeout }}"
    delegate_facts: yes
  when:
    - not ansible_connection == 'container' or not ansible_connection == 'docker'
    - bootstrap_wait_for_host == true

- block:
    - name: Test connection and register result
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: bootstrap_connect
    - name: Debug bootstrap_timeout if connection fails
      debug:
        var: bootstrap_timeout
      when: not bootstrap_connect.connected
    - name: Gather bootstrap facts
      setup:
        gather_subset: 'all'

- name: Install bootstrap packages
  raw:
    cmd: "{{ 'apt-get update && apt-get install -y {{ item }} || true' if ansible_distribution in ['Debian', 'RedHat', 'Rocky', 'Suse'] else 'apk add {{ item }} || true' if ansible_distribution == 'Alpine' else 'pacman -Syu --noconfirm {{ item }} || true' if ansible_distribution == 'Archlinux' else 'emerge {{ item }} || true' if ansible_distribution == 'Gentoo' else '' }}"
    become: yes
    become_user: "{{ bootstrap_user }}"
    register: bootstrap_install_packages
  when: bootstrap_user is defined

- block:
    - name: Gather ansible facts
      setup:
        gather_subset: 'all'
    - name: Install packages listed in bootstrap__facts_packages
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap__facts_packages }}"
      when: bootstrap__facts_packages is defined


