---
- name: OpenVPN Configuration
  become: yes

  tasks:
  - name: Ensure the easy-rsa directory exists
    file:
      path: /etc/openvpn/easy-rsa
      state: directory
      mode: '0755'

  - name: Initialize the easy-rsa PKI
    shell:
      cmd: easyrsa init-pki
      chdir: /etc/openvpn/easy-rsa
    when: not stat.exists(src="/etc/openvpn/easy-rsa/pki")

  - name: Build the Certificate Authority (CA)
    shell:
      cmd: easyrsa build-ca nopass
      chdir: /etc/openvpn/easy-rsa
    when: not stat.exists(src="/etc/openvpn/easy-rsa/pki/ca.crt")

  - name: Generate Diffie-Hellman parameters
    shell:
      cmd: easyrsa gen-dh
      chdir: /etc/openvpn/easy-rsa
    when: not stat.exists(src="/etc/openvpn/easy-rsa/pki/dh.pem")

  - name: Build the server certificate
    shell:
      cmd: easyrsa build-server-full server nopass
      chdir: /etc/openvpn/easy-rsa
    when: not stat.exists(src="/etc/openvpn/easy-rsa/pki/issued/server.crt")

  - name: Build the client certificate
    shell:
      cmd: easyrsa build-client-full client nopass
      chdir: /etc/openvpn/easy-rsa
    when: not stat.exists(src="/etc/openvpn/easy-rsa/pki/issued/client.crt")

  - name: Generate the Certificate Revocation List (CRL)
    shell:
      cmd: easyrsa gen-crl
      chdir: /etc/openvpn/easy-rsa
    when: not stat.exists(src="/etc/openvpn/easy-rsa/pki/crl.pem")

  - name: Generate TLS authentication key
    shell:
      cmd: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
      chdir: /etc/openvpn/easy-rsa

  - name: Copy PKI files to the server configuration directory
    file:
      src: /etc/openvpn/easy-rsa/pki/{{ item }}
      dest: /etc/openvpn/server
      mode: '0640'
      state: file
    with_items:
      - ca.crt
      - dh.pem
      - ta.key
      - client.crt
      - server.crt
      - ca.key
      - client.key
      - server.key

  - name: Copy ca.crt and ta.key to /etc/openvpn
    file:
      src: /etc/openvpn/easy-rsa/pki/{{ item }}
      dest: /etc/openvpn
      mode: '0640'
      state: file
    with_items:
      - ca.crt
      - ta.key

  - name: Place the server configuration file
    template:
      src: "server.conf.j2"
      dest: "{{ openvpn_configuration_directory }}/server.conf"
      mode: '0640'
      owner: openvpn
      group: openvpn
    notify: Restart openvpn

  - name: Generate EASYRSA_BATCH environment variable
    env:
      name: EASYRSA_BATCH
      value: yes

  - name: Wait for the easy-rsa directory to be created
    local_action:
      module: wait_for
      path: /etc/openvpn/easy-rsa
      state: present

  - name: Wait for the easy-rsa PKI to be initialized
    local_action:
      module: wait_for
      path: /etc/openvpn/easy-rsa/pki
      state: present

  - name: Wait for the CA certificate to be generated
    local_action:
      module: wait_for
      path: /etc/openvpn/easy-rsa/pki/ca.crt
      state: present

  - name: Wait for the Diffie-Hellman parameters to be generated
    local_action:
      module: wait_for
      path: /etc/openvpn/easy-rsa/pki/dh.pem
      state: present

  - name: Wait for the server certificate to be generated
    local_action:
      module: wait_for
      path: /etc/openvpn/easy-rsa/pki/issued/server.crt
      state: present

  - name: Wait for the client certificate to be generated
    local_action:
      module: wait_for
      path: /etc/openvpn/easy-rsa/pki/issued/client.crt
      state: present

  - name: Wait for the CRL to be generated
    local_action:
      module: wait_for
      path: /etc/openvpn/easy-rsa/pki/crl.pem
      state: present

  - name: Wait for the TLS authentication key to be generated
    local_action:
      module: wait_for
      path: /etc/openvpn/easy-rsa/pki/ta.key
      state: present

