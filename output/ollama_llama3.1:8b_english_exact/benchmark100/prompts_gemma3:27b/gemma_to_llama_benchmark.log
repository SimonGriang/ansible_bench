---
- name: Restart the RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify:
    - Service (re)started

- name: Wait for all nodes to be ready
  shell:
    cmd: |
      kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes | grep -v "NotReady" | wc -l
  delegate_to: "{{ rke2_node_name }}"
  retries: 100
  delay: 15
  until: inventory_hostname in groups(rke2_cluster_group_name)
  run_once: true

- name: Wait for all pods to be ready
  shell:
    cmd: |
      kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get pods -A --field-selector status.phase=Running || kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get pods -A --field-selector status.phase=Succeeded | wc -l
  delegate_to: "{{ rke2_node_name }}"
  retries: 100
  delay: 15
  until: inventory_hostname in groups(rke2_cluster_group_name)
  run_once: true
  when: rke2_wait_for_all_pods_to_be_ready and not ansible_check_mode


