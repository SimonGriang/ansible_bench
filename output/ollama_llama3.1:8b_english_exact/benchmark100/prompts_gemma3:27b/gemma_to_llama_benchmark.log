---
- name: Install EPEL and EPEL Next release
  hosts: localhost

  tasks:
  - name: Check OS compatibility
    block:
      - name: Ensure OS is Amazon Linux 2 or RedHat-based
        fail:
          msg: "Unsupported OS"
        when: (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2') or (ansible_distribution == 'RedHat' and ansible_distribution_major_version is version('7', '10'))
      - name: Ensure OS is Amazon Linux 2 or RedHat-based
        fail:
          msg: "Unsupported OS"
        when: (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2') or (ansible_distribution == 'RedHat' and ansible_distribution_major_version is version('7', '10'))
    always:
      - name: Ensure we are on supported OS
        fail:
          msg: "Unsupported OS"
        when: (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2') or (ansible_distribution == 'RedHat' and ansible_distribution_major_version is version('7', '10'))

  - name: Install epel gpg key
    rpm_key:
      state: present
      key: "{{ epel_gpg_key }}"

  - name: Install epel-release package
    yum:
      name: epel-release
      state: present
      notify: Update package cache
    when: epel_url is defined

  - name: Install epel-next-release package
    yum:
      name: epel-next-release
      state: present
      notify: Update package cache
    when: epel_next is defined and epel_next_url is defined


