---
- name: RKE2 Installation Tasks
  hosts: localhost
  gather_facts: no

  tasks:

  - name: Download RKE2 installation script
    get_url:
      url: "{{ rke2_url }}"
      dest: "{{ rke2_path }}/{{ rke2_installation_script }}"
      mode: '0755'
    when: not airgap

  - name: Copy local RKE2 installation script
    copy:
      content: "{{ lookup('file', rke2_local_path) }}"
      dest: "{{ rke2_path }}/{{ rke2_installation_script }}"
      mode: '0755'
    when: airgap and rke2_implementation == 'copy'

  - name: Create RKE2 artifacts folder
    file:
      path: "{{ rke2_artifacts_path }}"
      state: directory
      mode: '0755'
    when: airgap and rke2_implementation != 'exists'

  - name: Download RKE2 checksum and artifacts
    block:
      - name: Download RKE2 artifacts and checksums remotely
        get_url:
          url: "{{ rke2_url }}/rke2-{{ rke2_version }}-linux-amd64.tar.gz"
          dest: "{{ rke2_path }}/{{ rke2_artifact_name }}"
          mode: '0755'
        when: airgap
      - name: Fallback to local download
        copy:
          content: "{{ lookup('file', rke2_local_path) }}"
          dest: "{{ rke2_path }}/{{ rke2_artifact_name }}"
          mode: '0755'
        when: not airgap
      - name: Copy RKE2 checksums
        copy:
          content: "{{ lookup('file', rke2_local_checksum_path) }}"
          dest: "{{ rke2_path }}/{{ rke2_checksum_name }}"
          mode: '0755'
        when: not airgap

  - name: Copy local RKE2 artifacts
    copy:
      content: "{{ lookup('file', rke2_local_path) }}"
      dest: "{{ rke2_path }}/{{ rke2_artifact_name }}"
      mode: '0755'
    when: airgap and rke2_implementation == 'copy'

  - name: Airgap mode - additional images tarballs
    copy:
      content: "{{ lookup('file', rke2_local_additional_image_path) }}"
      dest: "{{ rke2_path }}/{{ rke2_additional_image_name }}"
      mode: '0755'
    when: airgap and rke2_additional_images

  - name: Airgap mode - ensure artifacts exist and have acceptable permissions
    file:
      path: "{{ rke2_path }}/{{ rke2_artifact_name }}"
      state: file
      mode: '0755'
    when: airgap

  - name: Populate service facts
    service_facts:
      gather_subset: ["kernel", "network"]

  - name: Get stats of the FS object
    filesystem:
      path: /usr/local
      stat: yes

  - name: Check if separate partition
    stat:
      path: "{{ rke2_path }}"
      state: file
    register: rke2_partition

  - name: Set RKE2 bin path
    set_fact:
      rke2_bin_path: "{{ rke2_path }}/{{ rke2_version }}-linux-amd64/bin"

  - name: Check RKE2 version
    shell:
      cmd: "{{ rke2_bin_path }}/rke2 version"
      executable: /bin/bash
      register: rke2_version_output
    failed_when: false

  - name: Set RKE2 versions
    set_fact:
      rke2_installed_version: "{{ rke2_version_output.stdout | regex_findall('version: ([0-9.]+)' | first ) }}"
      rke2_running_version: "{{ rke2_version_output.stdout | regex_findall('version: ([0-9.]+)' | first ) }}"

  - name: Prevent accidental RKE2 downgrade
    assert:
      that: rke2_force_upgrade | bool
      msg: "Downgrade not allowed, please use --force-upgrade flag"

  - name: Run RKE2 install script
    command:
      cmd: "{{ rke2_bin_path }}/rke2 init --config {{ rke2_config_path }}"
      executable: /bin/bash
      creates: "{{ rke2_path }}/rke2-agent.yml"

  - name: Copy Custom Manifests
    copy:
      content: "{{ lookup('file', rke2_local_manifest_path) }}"
      dest: "{{ rke2_path }}/{{ rke2_manifest_name }}"
      mode: '0755'

  - name: Copy Static Pods
    copy:
      content: "{{ lookup('file', rke2_local_static_pod_path) }}"
      dest: "{{ rke2_path }}/{{ rke2_static_pod_name }}"
      mode: '0755'

  - name: Copy RKE2 environment file
    copy:
      content: "{{ lookup('file', rke2_local_env_path) }}"
      dest: "{{ rke2_path }}/{{ rke2_env_name }}"
      mode: '0755'


