- name: Include assert.yml
  include_tasks: assert.yml

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk-{{ java_version }}
    state: present
  env:
    USE: "{{ exclude_features | join(',') }}"

- name: Install RPM
  package:
    name: "{{ java_rpm }}"
    state: present
  when: java_source == "local" and java_format == "rpm"
  copy:
    content: "{{ java_rpm }}"
    dest: "/tmp/{{ java_rpm }}"
    mode: '0644'

- name: Install DEB
  package:
    name: "{{ java_deb }}"
    state: present
  when: java_source == "local" and java_format == "deb"
  copy:
    content: "{{ java_deb }}"
    dest: "/tmp/{{ java_deb }}"
    mode: '0644'

- name: Install oracle java (rpm) (repository)
  package:
    name: "{{ java_rpm }}"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  shell: |
    mkdir -p "{{ java_install_dir }}"
    tar -xvzf "{{ java_targz }}" -C "{{ java_install_dir }}"
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_jce_policy }}"
    dest: "{{ java_install_dir }}"
    compression: zip
  when: java_jce and java_version == 8 and java_vendor == "oracle"

- name: Set alternative (targz)
  shell: |
    alternatives --install /usr/bin/java java "{{ java_targz }}" 1
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  find:
    paths: "/usr/lib/jvm"
    pattern: "{{ java_version }}"
  register: java_home
  when: java_format == "targz" and java_vendor == "oracle"

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: "/etc/profile.d/java_home.sh"
    line: 'export JAVA_HOME="{{ java_home.path }}"'
    state: present
  when: java_format == "targz" and java_vendor == "oracle"

