content="```yml\n---\n- name: Download RKE2 kubeconfig to localhost\n  fetch:\n    url: 'file:///etc/rancher/rke2/rke2.yaml'\n    flat: yes\n    dest: '{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}'\n  when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]\n\n- name: Replace loopback IP by master server IP\n  replace:\n    path: '{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}'\n    regexp: '(127\\.0\\.0\\.1|::1)'\n    replace: '{{ rke2_api_ip if rke2_api_ip is defined else groups[rke2_servers_group_name][0].ansible_host }}'\n  delegate_to: localhost\n  become: false\n  ansible_check_mode: true\n  when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]\n```" additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-11T16:52:26.640316254Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2275797755, 'load_duration': 134579150, 'prompt_eval_count': 612, 'prompt_eval_duration': 131900766, 'eval_count': 223, 'eval_duration': 2008492576, 'model_name': 'llama3.1:8b'} id='run--c3b92f40-9868-4615-9303-16eb3930437f-0' usage_metadata={'input_tokens': 612, 'output_tokens': 223, 'total_tokens': 835}
