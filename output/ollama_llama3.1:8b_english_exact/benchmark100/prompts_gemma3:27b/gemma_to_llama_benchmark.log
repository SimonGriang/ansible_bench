---
- name: Manage group
  group:
    name: "{{ group.name }}"
    state: "{{ group.state | default('present') }}"
    gid: "{{ group.gid }}"
    system: "{{ group.system }}"

- name: Set sudo options for group
  template:
    src: "sudo_group.j2"
    dest: "/etc/sudoers.d/{{ group.name | replace('.', 'dot') }}"
    mode: "0640"
  notify: sudo
  when: group.sudo_options is defined
  loop_control:
    label: "{{ group.name }}"
  loop: "{{ group.sudo_options }}"
  when: group.sudo_options is not undefined

