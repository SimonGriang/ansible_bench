- name: Copy kube-vip load balancer manifests to first server
  block:
    - name: Copy kube-vip load balancer manifests to first server
      copy:
        content: "{{ lookup('template', 'kube-vip-cloud-*.j2') | regex_replace('.j2$', '') }}"
        dest: "{{ rke2_data_path }}/server/manifests/{{ item }}"
