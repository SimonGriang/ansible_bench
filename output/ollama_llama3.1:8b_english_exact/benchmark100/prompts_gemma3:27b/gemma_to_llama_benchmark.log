---
- name: Configure SELinux settings
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: yes

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify:
    - Gather facts

- name: Flush handlers
  meta:
    flush_handlers: yes

- name: Configure SELinux settings
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when: ansible_selinux.status is defined and not container
  notify:
    - Reboot

- name: Manage SELinux booleans
  selinux_boolean:
    name: "{{ item }}"
    state: "{{ selinux_booleans[item] | default('yes') }}"
    persistent: yes
  loop: "{{ selinux_booleans | keys }}"
  when: selinux_booleans is defined


