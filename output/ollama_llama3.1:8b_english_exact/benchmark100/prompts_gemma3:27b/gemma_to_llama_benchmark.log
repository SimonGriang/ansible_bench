    rke2_custom_registry_mirrors: "{{ lookup('template', 'container_registry_mirrors.yaml.j2') }}"
    rke2_custom_registry_configs: "{{ lookup('template', 'container_registry_configs.yaml.j2') }}"
  tasks:
  - name: Create the RKE2 config directory
    file:
      path: /etc/rancher/rke2
      state: directory
      mode: '0755'

  - name: Set server taints
    set_fact:
      combined_node_taints: "{{ rke2_server_node_taints }}"

    when: rke2_type == 'server'

  - name: Set agent taints
    set_fact:
      combined_node_taints: "{{ rke2_agent_node_taints }}"

    when: rke2_type == 'agent'

  - name: Copy RKE2 config
    copy:
      src: templates/rke2.yaml.j2
      dest: /etc/rancher/rke2/rke2.yaml
      mode: '0644'
    notify:
      - restart rke2 service

  - name: Copy kubelet config
    copy:
      content: "{{ rke2_kubelet_config }}"
      dest: /etc/rke2/kubelet.yaml
      mode: '0644'
    when: rke2_kubelet_config | length > 0
    notify:
      - restart rke2 service

  - name: Copy Containerd Registry Configuration file
    copy:
      content: "{{ rke2_custom_registry_mirrors | combine(rke2_custom_registry_configs) | to_nice_yaml }}"
      dest: /etc/rke2/container_registry.yaml
      mode: '0644'
    when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
    notify:
      - restart rke2 service

  - name: Start RKE2 service on the rest of the nodes
    service:
      name: rke2
      state: started
      enabled: yes
      daemon_reload: yes
      env:
        RKE2_TOKEN: "{{ rke2_token }}"
      retries: 5
      delay: 10
      register: result

  - name: Mask other RKE2 service on the rest of the nodes
    service:
      name: "{{ rke2_type }}-rke2"
      state: masked

  - name: Wait for remaining nodes to be ready - no CNI
    shell:
      cmd: kubectl get nodes --field-selector "status.addresses[?operator=='Equal' && value='{node.name}'].value" -o jsonpath='{.items[?status.conditions[?condition.type==\"Ready\" && condition.status==\"True\"]].status.phase}'
      delegate_to: localhost
      retries: 5
      delay: 10
      register: nodes_ready

  - name: Wait for remaining nodes to be ready - with CNI
    shell:
      cmd: kubectl get nodes | grep -c "STATUS: Ready"
      delegate_to: localhost
      retries: 5
      delay: 10
      register: nodes_ready

  - name: Wait for remaining nodes to be ready - no CNI
    shell:
      cmd: kubectl get nodes --field-selector "status.addresses[?operator=='Equal' && value='{node.name}'].value" -o jsonpath='{.items[?status.conditions[?condition.type==\"Ready\" && condition.status==\"True\"]].status.phase}'
      delegate_to: localhost
      retries: 5
      delay: 10
      register: nodes_ready
    when: CNI == 'none' and (ansible_machine == 'server' or ansible_machine == 'active')

  - name: Wait for remaining nodes to be ready - with CNI
    shell:
      cmd: kubectl get nodes | grep -c "STATUS: Ready"
      delegate_to: localhost
      retries: 5
      delay: 10
      register: nodes_ready
    when: CNI != 'none' and (ansible_machine == 'server' or ansible_machine == 'active')


