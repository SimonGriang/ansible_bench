---
- name: Execute tasks
  tasks:
  - name: Check for python executable
    shell: 'which python 2>/dev/null'
    register: python_path
    ignore_errors: yes
    no_log: true

  - name: Check for python3 executable
    shell: 'which python3 2>/dev/null'
    register: python3_path
    ignore_errors: yes
    no_log: true

  - name: Debug Python executable path
    debug:
      msg: "{{ python_path.stdout }}"

  - name: Debug Python3 executable path
    debug:
      msg: "{{ python3_path.stdout }}"

  - name: Import assert tasks
    include_tasks:
      file: assert.yml
      apply: true
      delegate_to: localhost

  - name: Install openssl requirements
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ openssl_requirements }}"
    loop_control:
      loop_var: item

  - name: Ensure packaging is available via dnf
    package:
      name: 'python3-packaging'
      state: present

  - name: Install pip packages
    pip:
      name: "{{ item }}"
      state: present
    loop: "{{ openssl_pip_packages }}"
    loop_control:
      loop_var: item

  - name: Create key directory
    file:
      path: "{{ openssl_key_directory }}"
      mode: '0750'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
      state: directory

  - name: Create csr directory
    file:
      path: "{{ openssl_csr_directory }}"
      mode: '0755'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
      state: directory

  - name: Create crt directory
    file:
      path: "{{ openssl_crt_directory }}"
      mode: '0755'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
      state: directory

  - name: Include create tasks
    include_tasks:
      file: create.yml
    loop:
      label: "{{ item.name }}"
      loop: "{{ openssl_items }}"
      loop_control:
        loop_var: item
    when: openssl_items is defined and openssl_items | length > 0


