---
# Task 1: lookup bootstrap facts (raw)
- name: Retrieve os-release contents
  raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  become: no
  changed_when: no

# Task 2: set bootstrap facts (I) # noqa jinja
- name: Set bootstrap distribution and major version facts
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is undefined
    - '{{ bootstrap_facts.stdout | regex_findall("PRETTY_NAME=(.*)" + item.value + "(.*)") | length > 0 }}'
  loop: '{{ bootstrap__os_family_map | items(key_value_split) }}'
  loop_control:
    label: '{{ item.key }}'
  set_fact:
    bootstrap_distribution: '{{ item.value | regex_findall("PRETTY_NAME=(.*)" + item.key + "(.*)") | first }}'
    bootstrap_distribution_major_version: '{{ item.value | regex_findall("PRETTY_NAME=(.*)" + item.key + "(.*)") | last | split("=")[1] | split("\n")[0] }}'

# Task 3: set bootstrap facts (II)
- name: Set bootstrap os-family fact
  when:
    - bootstrap_distribution is defined
    - bootstrap_distribution in item.value
  loop: '{{ bootstrap__os_family_map | items(key_value_split) }}'
  loop_control:
    label: '{{ item.key }}'
  set_fact:
    bootstrap_os_family: '{{ item.key }}'


