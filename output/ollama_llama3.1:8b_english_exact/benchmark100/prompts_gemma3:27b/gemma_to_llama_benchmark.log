---
- name: Import assertions
  include_tasks: assert.yml
  delegate_to: localhost

- name: Disable automatic service management
  block:
    - name: Create policy-rc.d file to disable autostart
      file:
        path: /usr/sbin/policy-rc.d
        content: 'exit 101'
        mode: '755'
      when: apt_autostart_state == 'disabled'

- name: Enable automatic service management
  block:
    - name: Remove policy-rc.d file to enable autostart
      file:
        path: /usr/sbin/policy-rc.d
        state: absent
      when: apt_autostart_state == 'enabled'

