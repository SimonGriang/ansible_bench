---

- name: Import assert.yml
  include_tasks: assert.yml

- name: Wait for port to be available
  wait_for:
    host: "{{ ansible_host }}"
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - 'ansible_connection' in ansible_connection
    - ansible_connection != 'docker'
    - bootstrap_wait_for_host

- name: Prepare system
  connection: local
  tasks:
  - ping:
      connection: local
    ignore_errors: yes
  - assert:
      that: ansible_all_ipv4_addresses != []
    msg: Connection test failed
  - assert:
      that: ansible_sudoable
    msg: Sudo access test failed
  rescue:
  - name: Gather bootstrap facts
    setup:
      filter: 'ansible_facts'
    register: bootstrap_facts
  - name: Install bootstrap packages
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ bootstrap_facts.bootstrap_packages | default([]) }}"

- name: Gather ansible facts
  setup: 

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  when: bootstrap_become
  loop: "{{ bootstrap_facts_packages | default([]) }}"

