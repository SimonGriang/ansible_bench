- name: Gather Facts
  tasks:
  - name: Gather facts
    raw: cat /etc/os-release
    register: bootstrap_facts

  - name: Set bootstrap facts
    set_fact:
      bootstrap_distribution: ''
      bootstrap_distribution_major_version: ''
    when:
      - bootstrap_facts.rc == 0
      - bootstrap_distribution is not defined
      - bootstrap_facts.stdout | regex_search('PRETTY_NAME="([^"]+)"') | regex_search('^' + item.value + '$')
    loop: "{{ bootstrap_os_family_map }}"
    loop_control:
      label: item.key
    loop_var: item

  - name: Set bootstrap facts
    set_fact:
      bootstrap_os_family: "{{ bootstrap_os_family_map[loop_control.label] }}"
    when:
      - bootstrap_distribution is defined
      - bootstrap_distribution in bootstrap_os_family_map[loop_control.label]
    loop: "{{ bootstrap_os_family_map | dict2items }}"
    loop_control:
      label: item.key

