        ansible_distribution in ['amazon', 'redhat']
        and ansible_distribution_major_version in ['7', '8', '9', '10']

    - name: Install EPEL GPG key
      rpm_key:
        state: present
        key: "{{ epel_gpg_key }}"

    - name: Install epel-release package
      yum:
        name: epel-release
        state: present
        update_cache: yes
        notify: Update package cache
      when: epel_url is defined

    - name: Install epel-next-release package
      yum:
        name: epel-next-release
        state: present
        update_cache: yes
        notify: Update package cache
      when: epel_next == true

  handlers:
    - name: Update package cache
      yum:
        update_cache: yes100%|██████████| 100/100 [2:22:22<00:00, 50.37s/it]100%|██████████| 100/100 [2:22:22<00:00, 85.43s/it]


