- name: Install python pip
  pip:
    name: python-pip
    state: present

- name: Configure pip proxy
  lineinfile:
    dest: /etc/pip.conf
    section: global
    line: index-url = {{ python_pip_proxy }}
  when: python_pip_proxy is defined

- name: Trust hosts
  lineinfile:
    dest: /etc/pip.conf
    section: global
    line: trusted-host = {{ python_pip_trusted_host }}
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
  when: not (ansible_distribution in ['Debian', 'Alpine'] and ansible_distribution_major_version == '12')

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    version: "{{ item.version }}"
  loop: "{{ python_pip_modules }}"
  when: not (ansible_distribution in ['Debian', 'Alpine'] and ansible_distribution_major_version == '12')
  loop_control:
    label: "{{ item.name }}"
    loop_var: item

- name: Remove trailing spaces
  debug:
    msg: "Removing trailing spaces"

