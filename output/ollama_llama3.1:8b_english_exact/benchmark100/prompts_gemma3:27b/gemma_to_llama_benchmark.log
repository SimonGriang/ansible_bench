content='---\n\n\n- name: Download RKE2 kubeconfig to localhost\n  fetch:\n    src: /etc/rancher/rke2/rke2.yaml\n    dest: "{{ rke2_download_kubeconf_path }}"\n    flat: yes\n  when: rke2_download_kubeconf and rke2_servers_group_name in group_names and inventory_hostname == group_by(rke2_servers_group_name)[0]\n\n- name: Replace loopback IP by master server IP\n  replace:\n    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    regexp: \'^(127\\.0\\.0\\.1|::1)$\'\n    replace: "{{ rke2_api_ip | default(ansible_host, group_by(rke2_servers_group_name)[0].vars.ansible_host) }}"\n  delegate_to: localhost\n  become: false\n  when: not ansible_check_mode and rke2_download_kubeconf and rke2_servers_group_name in group_names and inventory_hostname == group_by(rke2_servers_group_name)[0]' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-21T15:41:13.786287556Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2574293319, 'load_duration': 125321337, 'prompt_eval_count': 612, 'prompt_eval_duration': 159945247, 'eval_count': 226, 'eval_duration': 2287216944, 'model_name': 'llama3.1:8b'} id='run--83bac103-09fd-414c-9c53-7fb8d778e000-0' usage_metadata={'input_tokens': 612, 'output_tokens': 226, 'total_tokens': 838}
