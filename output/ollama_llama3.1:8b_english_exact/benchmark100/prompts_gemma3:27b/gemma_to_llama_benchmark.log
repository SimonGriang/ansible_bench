---

- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify:
    - Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when: ansible_selinux.status == 'enabled' and not (connection.type == 'docker' or connection.type == 'docker_swarm')
  notify: Reboot

- name: Manage selinux booleans
  selinux_bool:
    state: "{{ selinux_booleans[item].state | default('yes') }}"
    persistent: "{{ selinux_booleans[item].persistent | default(false) }}"
    label: "{{ selinux_booleans[item].name }}"
  loop: "{{ selinux_booleans }}"
  when: selinux_booleans is defined

