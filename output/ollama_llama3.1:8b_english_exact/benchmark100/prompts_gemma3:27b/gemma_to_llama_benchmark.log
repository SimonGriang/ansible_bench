---
- name: Configure Vault
  hosts: all
  become: true

  tasks:
    - name: Set file permissions and owner
      file:
        path: /vault
        mode: '0644'
        owner: root
        group: root

    - name: Configure SELinux / AppArmor
      block:
        - name: Configure SELinux
          when: vault_hardening_configure_selinux_apparmor and ansible_selinux.status == "enabled"
          selinux:
            policy: targeted
            state: enforcing

        - name: Configure AppArmor
          when: vault_hardening_configure_selinux_apparmor and ansible_apparmor.status == "enabled"
          apparmor:
            package: yes
            state: present

    - name: Configure SELinux / AppArmor
      block:
        - name: Configure SELinux
          when: vault_hardening_configure_selinux_apparmor and ansible_selinux.status == "enabled"
          selinux:
            policy: targeted
            state: enforcing

        - name: Configure AppArmor
          when: ansible_apparmor.status == "enabled"
          apparmor:
            package: yes
            state: present

