- include: cis.yml
  when:
  - rke2_cis_profile is defined and rke2_cis_profile|length > 0

- include: find_active_server.yml

- include: kubevip.yml
  when:
  - ha_mode
  - not ha_mode|combine(inventory_hostname in groups('rke2_servers_group_name') and ha_mode) and not ha_mode|combine(inventory_hostname in groups('rke2_servers_group_name') and not ha_mode)
- copy:
    src: /path/to/kube-vip/manifests
    dest: /path/to/masternode/

- include: ingress-nginx.yml
  when:
  - rke2_ingress_nginx_values is defined and rke2_ingress_nginx_values|length > 0
- copy:
    src: /path/to/ingress-nginx/manifests
    dest: /path/to/masternode/

- include: first_server.yml
  when:
  - inventory_hostname in groups('rke2_servers_group_name') and (active_server is not defined or (active_server is defined and group_count('rke2_cluster_group_name') == 1))

- include: first_server_restore.yml
  when:
  - active_server is defined and (inventory_hostname == active_server or inventory_hostname in groups('rke2_servers_group_name')) and (do_etcd_restore is defined or do_etcd_restore_from_s3 is defined)

- include: download_kubeconfig.yaml
  when:
  - rke2_download_kubeconf and inventory_hostname in groups('rke2_servers_group_name')

- include: remaining_nodes.yml
  when:
  - active_server is defined and group_count('rke2_cluster_group_name') >= 2

- include: rolling_cordon_drain_restart_servers.yml
  when:
  - rke2_installed_version is defined and rke2_installed_version != rke2_version

- include: rolling_cordon_drain_restart_agents.yml
  when:
  - rke2_installed_version is defined and rke2_installed_version != rke2_version and inventory_hostname not in groups('rke2_servers_group_name')

- meta: flush_handlers

- include: rolling_restart.yml
  when:
  - rke2_restart_needed

- include: summary.yml


