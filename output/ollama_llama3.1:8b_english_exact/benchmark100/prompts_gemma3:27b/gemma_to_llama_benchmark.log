---
- name: Check OS compatibility
  fail:
    msg: "Unsupported OS, only Amazon Linux 2 or RedHat-based distributions with major version 7, 8, or 9 are supported"
  when: ansible_distribution != 'Amazon Linux 2' and (ansible_distribution == 'RedHat' and ansible_distribution_major_version not in ['7', '8', '9'])

- name: Install epel gpg key
  rpm_key:
    state: present
    key: '{{ epel_gpg_key }}'

- name: Install epel-release package
  yum:
    name: epel-release
    state: present
    update_cache: yes
  notify: Update package cache

- name: Install epel-next-release package
  yum:
    name: epel-next-release
    state: present
    update_cache: yes
  when: epel_next
  notify: Update package cache

