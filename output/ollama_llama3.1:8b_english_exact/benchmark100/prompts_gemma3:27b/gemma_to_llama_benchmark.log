---
- name: Import assert.yml
  include: assert.yml

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  sebool:
    state: present
    target: httpd
    name: "{{ item }}"
  with_items: "{{ httpd_sebooleans }}"
  when: selinux_enabled == true

- name: Configure connections to custom ports
  seport:
    name: httpd_port
    state: present
  when: httpd_port != 80

- name: Configure connections to custom ssl port
  seport:
    name: httpd_ssl_port
    state: present
  when: httpd_ssl_port != 443

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify: test and restart httpd

- name: Activate httpd modules | Debian
  command:
    name: a2enmod {{ item }}
    args:
      creates: "{{ item }}.conf"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_distribution == 'Debian'

- name: Import ssl.yml
  include: ssl.yml
  when: https_ssl_enable == true

- name: Import locations.yml
  include: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  include: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: httpd_ports_conf.j2
