- name: RKE2 configuration tasks
  become: true

  tasks:
  - name: Create the RKE2 config directory
    file:
      path: /etc/rancher/rke2
      state: directory
      mode: '0755'

  - name: Set server taints
    set_fact:
      combined_node_taints: "{{ combined_node_taints | default([]) + rke2_server_node_taints }}"
    when: rke2_type == 'server'

  - name: Set agent taints
    set_fact:
      combined_node_taints: "{{ combined_node_taints | default([]) + rke2_agent_node_taints }}"
    when: rke2_type == 'agent'

  - name: Copy RKE2 config
    template:
      src: templates/rke2.yaml.j2
      dest: /etc/rancher/rke2/config.yaml
      mode: '0644'
    notify: rke2_config_changed

  - name: Copy kubelet config
    template:
      src: templates/kubelet.yaml.j2
      dest: /etc/rke2/kubelet/config.yaml
      mode: '0644'
      when: rke2_kubelet_config | string
    notify: rke2_kubelet_config_changed

  - name: Copy Containerd Registry Configuration file
    template:
      src: templates/registry.yaml.j2
      dest: /etc/rke2/registry/config.yaml
      mode: '0644'
      when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)
    notify: rke2_registry_config_changed

  - name: Start RKE2 service on the rest of the nodes
    systemd:
      name: rke2
      state: started
      enabled: yes
      daemon_reload: yes
      restart: yes
      retry: 3
      delay: 5
      env: RKE2_TOKEN={{ rke2_token }}
      register: rke2_service_result
    notify: rke2_service_restarted

  - name: Mask other RKE2 service on the rest of the nodes
    systemd:
      name: rke2-{{ rke2_type }}
      state: masked
      enabled: no
    when: rke2_type != 'server'

  - name: Wait for remaining nodes to be ready - no CNI
    shell:
      cmd: kubectl get no --field-selector!="" --output=jsonpath='{range .items[*]}{.metadata.name}{", "}{end}' | grep -c '^'
    args:
      chdir: /home/core
    when: (cni == 'none') and (inventory_hostname == rke2_active_server or inventory_hostname == rke2_first_server)
    retries: 12
    delay: 10
    register: rke2_nodes_ready

  - name: Wait for remaining nodes to be ready - with CNI
    shell:
      cmd: kubectl get no --field-selector!="" --output=jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{", "}{end}' | grep -c "True"
    args:
      chdir: /home/core
    when: (cni != 'none') and ((inventory_hostname == rke2_active_server) or (inventory_hostname == rke2_first_server))
    retries: 12
    delay: 10
    register: rke2_nodes_ready

