---
- name: Configure Vault
  hosts: all
  become: true

  tasks:
  - name: Create Vault group
    group:
      name: "{{ vault_group }}"

  - name: Create Vault user
    user:
      name: "{{ vault_user }}"
      shell: "{{ vault_user_shell }}"
      group: "{{ vault_group }}"
      create_home: no

  - name: Create Vault download directory
    file:
      path: "{{ vault_download_path }}"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '0755'
      state: directory

  - name: Download Vault binary
    get_url:
      url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
      dest: "{{ vault_download_path }}"
      checksum: sha256:{{ vault_checksum }}
    unarchive:
      src: "{{ vault_download_path }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
      dest: "{{ vault_download_path }}"
      compression: 'zip'
      interactive: yes

  - name: Check if vault_path exists
    stat:
      path: "{{ vault_path }}"
      get_uid: no
    register: vault_check_path

  - name: Create vault_path if it does not exists
    file:
      path: "{{ vault_path }}"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '0755'
      state: directory
    when: vault_check_path.stat.exists == false and vault_path is not empty

  - name: Create directory in vault_path
    file:
      path: "{{ item.path }}"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '{{ item.mode }}'
      state: directory
    loop: "{{ vault_directories }}"
    loop_control:
      loop_var: item

  - name: Create data directory
    file:
      path: "{{ item.path }}"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '{{ item.mode }}'
      state: directory
    loop: "{{ vault_data_directories }}"
    loop_control:
      loop_var: item

  - name: Generate TLS key and certificate
    command:
      cmd: openssl req -x509 -newkey rsa:4096 -nodes -keyout tls.key -out tls.crt -days 365 -subj "/C=US/ST=Denial/L=Research/O=My\ Company/CN=vault.example.com"
      chdir: "{{ vault_data_directory }}/tls/"
    notify: Restart vault

  - name: Set ownership of tls material
    file:
      path: "{{ item.path }}"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '{{ item.mode }}'
      state: file
    loop: "{{ vault_tls_files }}"
    loop_control:
      loop_var: item

  - name: Copy Vault binary
    copy:
      content: "{{ vault_download_path }}/vault"
      dest: "/usr/bin/vault"
      owner: root
      group: root
      mode: '0755'
    notify: Restart vault

  - name: Set cap_ipc_lock=ep on /usr/bin/vault
    command:
      cmd: setcap cap_ipc_lock=ep /usr/bin/vault
      creates: /usr/bin/vault

  - name: Touch vault.env
    file:
      path: "{{ vault_path }}/etc/vault.d/vault.env"
      owner: "{{ vault_user }}"
      group: "{{ vault_group }}"
      mode: '0644'
      state: touch
      follow: yes
    notify: Restart vault

  - name: Create /usr/lib/systemd/system
    file:
      path: /usr/lib/systemd/system
      owner: root
      group: root
      mode: '0755'
      state: directory

  - name: Copy Vault service file
    template:
      src: "vault.service.j2"
      dest: "/usr/lib/systemd/system/vault.service"
      owner: root
      group: root
      mode: '0644'
    when: ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian'

  - name: Copy vault configuration
    copy:
      content: "{{ lookup('file', 'vault.hcl') }}"
      dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
      owner: root
      group: root
      mode: '0644'
    notify: Restart vault

  - name: Flush handlers
    meta: flush_handlers


