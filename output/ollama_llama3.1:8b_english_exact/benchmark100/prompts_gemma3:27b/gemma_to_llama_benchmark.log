      mode: '0640'
    when: not file.exists("/etc/openvpn/server/client.crt")
    notify: Restart openvpn

  - name: Copy PKI files to server configuration directory (continued)
    copy:
      content: ""
      dest: /etc/openvpn/server/server.crt
      mode: '0640'
    when: not file.exists("/etc/openvpn/server/server.crt")
    notify: Restart openvpn

  - name: Copy PKI files to server configuration directory (continued)
    copy:
      content: ""
      dest: /etc/openvpn/server/ca.key
      mode: '0640'
    when: not file.exists("/etc/openvpn/server/ca.key")
    notify: Restart openvpn

  - name: Copy PKI files to server configuration directory (continued)
    copy:
      content: ""
      dest: /etc/openvpn/server/client.key
      mode: '0640'
    when: not file.exists("/etc/openvpn/server/client.key")
    notify: Restart openvpn

  - name: Copy PKI files to server configuration directory (continued)
    copy:
