    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    create_home: false

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Download Vault binary
  get_url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/{{ vault_architecture }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
    dest: "{{ vault_download_path }}/.vault.zip"
    mode: '0644'
  unarchive:
    src: "{{ vault_download_path }}/.vault.zip"
    dest: "{{ vault_download_path }}"
    extract: yes
    compression: zip

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
    register: vault_check_path

- name: Create vault_path if it does not exists
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
  when:
    - not vault_check_path.stat.exists
    - vault_path is not empty

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  shell:
    cmd: openssl req -x509 -nodes -newkey rsa:4096 -keyout tls.key -out tls.crt -days 365 -subj "/C=US/ST=State/L=Locality/O=Organization/CN=example.com"
    chdir: "{{ vault_data_directory }}/tls/"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    content: /opt/vault/bin/vault
    dest: /usr/bin/vault
    mode: '0755'
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  shell:
    cmd: setcap cap_ipc_lock=ep /usr/bin/vault

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy Vault service file
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: '0644'
  notify: Daemon reload
  when:
    - ansible_distribution == 'Debian'

- name: Copy vault configuration
  template:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: '0644'
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers

