content='---\n\n\n---\n- name: RKE2 Configuration and Setup\n  hosts: all\n  tasks:\n\n  - name: Create the RKE2 config directory\n    file:\n      path: /etc/rancher/rke2\n      state: directory\n      mode: \'0755\'\n\n  - name: Set server taints\n    set_fact:\n      combined_node_taints: "{{ rke2_server_node_taints }}"\n    when: rke2_type == \'server\'\n\n  - name: Copy rke2 config\n    template:\n      src: templates/rke2.yml.j2\n      dest: /etc/rancher/rke2/config.yml\n      mode: \'0644\'\n      owner: root\n      group: root\n    notify: Config file changed\n\n  - name: Copy kubelet config\n    template:\n      src: templates/kubelet.yml.j2\n      dest: /etc/rancher/rke2/kubelet.yml\n      mode: \'0644\'\n      owner: root\n      group: root\n    when: rke2_kubelet_config | length > 0\n    notify: Config file changed\n\n  - name: Copy Containerd Registry Configuration file\n    template:\n      src: templates/containerd-registry.yml.j2\n      dest: /etc/rancher/rke2/containerd-registry.yml\n      mode: \'0644\'\n      owner: root\n      group: root\n    when:\n      - rke2_custom_registry_mirrors | length > 0\n      - rke2_custom_registry_configs | length > 0\n    notify: Config file changed\n\n  - name: Register if we need to do a etcd restore from file\n    set_fact:\n      do_etcd_restore: true\n    when:\n      - rke2_etcd_snapshot_file is defined\n      - (rke2-server.service is not defined or rke2-server.service is disabled)\n\n  - name: Register if we need to do a etcd restore from s3\n    set_fact:\n      do_etcd_restore_from_s3: true\n    when:\n      - rke2_etcd_snapshot_file is defined\n      - rke2_etcd_snapshot_s3_options is defined\n      - rke2_etcd_snapshot_s3_options.access_key is defined\n      - rke2_etcd_snapshot_s3_options.secret_key is defined\n      - rke2_etcd_snapshot_s3_options.bucket_name is defined\n\n  - name: Restore etcd from file\n    block:\n      - name: Create the destination directory\n        file:\n          path: /etc/rke2/etcd-snapshots\n          state: directory\n          mode: \'0755\'\n      - name: Copy the snapshot\n        copy:\n          src: \'{{ rke2_etcd_snapshot_file }}\'\n          dest: /etc/rke2/etcd-snapshots\n          mode: \'0644\'\n      - name: Run the rke2 server command with the --etcd-snapshot flag\n        shell:\n          cmd: rke2 server --etcd-snapshot={{ rke2_etcd_snapshot_file }}\n    when: do_etcd_restore\n\n  - name: Restore etcd from s3\n    shell:\n      cmd: rke2 server --etcd-snapshot-s3 {{ rke2_etcd_snapshot_s3_options.access_key }}:{{ rke2_etcd_snapshot_s3_options.secret_key }}@{{ rke2_etcd_snapshot_s3_options.bucket_name }}\n    when: do_etcd_restore_from_s3\n\n  - name: Start RKE2 service on the first server\n    systemd:\n      name: rke2-server.service\n      state: started\n      enabled: true\n      daemon_reload: true\n    when: rke2_type == \'server\'\n    notify: Service (re)started\n\n  - name: Mask RKE2 agent service on the first server\n    systemd:\n      name: rke2-agent.service\n      state: masked\n      enabled: false\n      daemon_reload: true\n    when: rke2_type == \'server\'\n\n  - name: Wait for the first server be ready - no CNI\n    shell:\n      cmd: kubectl get nodes -o jsonpath=\'{.items[0].status.conditions[?(@.type==\\"Ready\\")]}\'\n    register: server_ready\n    until: server_ready.stdout.find(\'"status": "True"\') != -1\n    retries: 30\n    delay: 10\n\n  - name: Wait for the first server be ready - with CNI\n    shell:\n      cmd: kubectl get nodes -o jsonpath=\'{.items[0].status.conditions[?(@.type==\\"Ready\\")]}\'\n    register: server_ready\n    until: server_ready.stdout.find(\'"status": "True"\') != -1\n    retries: 30\n    delay: 10\n\n  - name: Restore etcd\n    block:\n      - name: Get registered nodes\n        shell:\n          cmd: kubectl get nodes -o json\n      - name: Get node names\n        shell:\n          cmd: kubectl get nodes -o jsonpath=\'{.items[].metadata.name}\'\n      - name: Remove old secrets and nodes\n        shell:\n          cmd: kubectl delete secrets, nodes -o json\n\n  - name: Set an Active Server variable\n    set_fact:\n      active_server: "{{ inventory_hostname }}"\n    delegate_to: "{{ rke2_cluster_group_name }}"' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-21T15:49:11.69055415Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12422985254, 'load_duration': 105029499, 'prompt_eval_count': 1018, 'prompt_eval_duration': 165930144, 'eval_count': 1156, 'eval_duration': 12150854367, 'model_name': 'llama3.1:8b'} id='run--371838fb-b048-40fa-b103-e7e4d47ecb4c-0' usage_metadata={'input_tokens': 1018, 'output_tokens': 1156, 'total_tokens': 2174}
