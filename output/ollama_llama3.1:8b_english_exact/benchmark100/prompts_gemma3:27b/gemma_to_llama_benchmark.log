---
- name: Configure OpenVPN
  tasks:
  - name: Ensure easy-rsa directory exists
    file:
      path: /etc/openvpn/easy-rsa
      state: directory
      mode: '0755'

  - name: Initialize easy-rsa PKI
    command: easyrsa --batch --dir /etc/openvpn/easy-rsa init-pki
    when: not file.exists("/etc/openvpn/easy-rsa/pki")

  - name: Build Certificate Authority (CA)
    command: easyrsa --batch --dir /etc/openvpn/easy-rsa build-ca nopass
    when: not file.exists("/etc/openvpn/easy-rsa/pki/ca.crt")

  - name: Generate Diffie-Hellman parameters
    command: easyrsa --batch --dir /etc/openvpn/easy-rsa gen-dh
    when: not file.exists("/etc/openvpn/easy-rsa/pki/dh.pem")

  - name: Build server certificate
    command: easyrsa --batch --dir /etc/openvpn/easy-rsa build-server-full server nopass
    when: not file.exists("/etc/openvpn/easy-rsa/pki/issued/server.crt")

  - name: Build client certificate
    command: easyrsa --batch --dir /etc/openvpn/easy-rsa build-client-full client nopass
    when: not file.exists("/etc/openvpn/easy-rsa/pki/issued/client.crt")

  - name: Generate Certificate Revocation List (CRL)
    command: easyrsa --batch --dir /etc/openvpn/easy-rsa gen-crl
    when: not file.exists("/etc/openvpn/easy-rsa/pki/crl.pem")

  - name: Generate TLS authentication key
    command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

  - name: Copy PKI files to server configuration directory
    copy:
      content: ""
      dest: /etc/openvpn/server/ca.crt
      mode: '0640'
    when: not file.exists("/etc/openvpn/server/ca.crt")
    notify: Restart openvpn

  - name: Copy PKI files to server configuration directory (continued)
    copy:
