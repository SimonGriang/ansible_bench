      mode: '0644'

  - name: Copy RKE2 environment file
    copy:
      content: "{{ lookup('file', '/path/to/local/rke2-env.yaml') }}"
      dest: /usr/local/etc/kubernetes/environment/rke2-env.yaml
      mode: '0644'

  - name: Pause
    pause:
      when: false

