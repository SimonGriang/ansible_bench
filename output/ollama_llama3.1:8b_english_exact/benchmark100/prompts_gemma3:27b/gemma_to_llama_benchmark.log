---

- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml

- name: Install python pip
  ansible.builtin.package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  when: python_pip_proxy is defined
  block:
    - name: Set pip proxy
      ansible.builtin.lineinfile:
        dest: /etc/pip.conf
        section: "global"
        line: "index-url = {{ python_pip_proxy }}"
        state: present
    - name: Set permissions
      ansible.builtin.file:
        dest: /etc/pip.conf
        mode: '0644'

- name: Trust hosts
  when: python_pip_trusted_host is defined
  block:
    - name: Set trusted hosts
      ansible.builtin.lineinfile:
        dest: /etc/pip.conf
        section: "global"
        line: "trusted-host = {{ python_pip_trusted_host }}"
        state: present
    - name: Set permissions
      ansible.builtin.file:
        dest: /etc/pip.conf
        mode: '0644'

- name: Update pip
  when: ansible_distribution not in ['Debian', 'Alpine', 'noble']
  ansible.builtin.pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
    skip: false

- name: Install requested modules
  when: python_pip_modules is defined
  block:
    - name: Install modules
      ansible.builtin.pip:
        name: "{{ item.name }}"
        executable: "{{ python_pip_executable }}"
        state: "{{ item.state if item.state is defined else 'present' }}"
        version: "{{ item.version if item.version is defined else '' }}"
      loop: "{{ python_pip_modules }}"
      loop_control:
        label: "{{ item.name }}"

