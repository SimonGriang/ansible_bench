content='---\n\n\n- name: Import assert.yml\n  include_tasks: assert.yml\n\n- name: Install mysql\n  package:\n    name: "{{ item }}"\n    state: present\n  notify:\n    - Set root password\n    - Systemctl daemon-reexec\n  loop: "{{ mysql_packages }}"\n\n- name: Configure mysql server\n  template:\n    src: templates/{{ mysql_name }}-server.cnf.j2\n    dest: /etc/my.cnf.d/{{ mysql_name }}-server.cnf\n    mode: \'0644\'\n  notify: restart mysql\n\n- name: Configure mysql client\n  template:\n    src: templates/{{ mysql_name }}-client.cnf.j2\n    dest: /etc/my.cnf.d/{{ mysql_name }}-client.cnf\n    mode: \'0644\'\n\n- name: Initialize mysql\n  shell:\n    cmd: "{{ mysql_initialize_command }}"\n\n- name: Start and enable mysql\n  service:\n    name: "{{ mysql_service }}"\n    state: started\n    enabled: yes\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Place my.cnf\n  template:\n    src: templates/my.cnf.j2\n    dest: /root/.my.cnf\n    mode: \'0640\'\n\n- name: Create databases\n  mysql_db:\n    name: "{{ item.name }}"\n    state: present\n    target: "{{ item.target }}"\n    encoding: "{{ item.encoding }}"\n    collation: "{{ item.collation }}"\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_host: unix_socket\n  loop: "{{ mysql_databases }}"\n\n- name: List databases\n  mysql_info:\n    info: databases\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_host: unix_socket\n  debug: yes\n\n- name: Import database\n  mysql_db:\n    name: "{{ item.name }}"\n    state: import\n    target: "{{ item.target }}"\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_host: unix_socket\n    import_file: "{{ item.import_file }}"\n  when: mysql_import_target and not item.exists\n  loop: "{{ mysql_databases }}"\n\n- name: Create users\n  mysql_user:\n    name: "{{ item.name }}"\n    password: "{{ item.password }}"\n    priv: "{{ item.priv }}"\n    host: "{{ item.host }}"\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_host: unix_socket\n  loop: "{{ mysql_users }}"\n\n- name: Flush handlers again\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-11T15:15:13.243621376Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4745246637, 'load_duration': 98118062, 'prompt_eval_count': 754, 'prompt_eval_duration': 136298341, 'eval_count': 542, 'eval_duration': 4509996894, 'model_name': 'llama3.1:8b'} id='run--ff31ebaf-55c6-4d6a-849f-7aa48e42e8ee-0' usage_metadata={'input_tokens': 754, 'output_tokens': 542, 'total_tokens': 1296}
