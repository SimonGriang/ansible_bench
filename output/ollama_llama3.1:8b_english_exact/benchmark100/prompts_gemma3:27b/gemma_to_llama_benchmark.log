---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when: ansible_selinux.status == "enabled" and not ansible_connection.is_container
  notify: Reboot

- name: Manage selinux booleans
  selinux_booleans:
    booleans: "{{ selinux_booleans }}"
    persistent: "{{ persistent | default(false) }}"
    state: "{{ value | default('yes') }}"
  when: selinux_booleans is defined
  loop: "{{ selinux_booleans }}"
  loop_control:
