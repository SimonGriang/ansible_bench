      mode: '0600'
    when: user.copy_private_key

  - name: Check users password valid time
    shell:
      cmd: getent shadow {{ item.user }}
    register: user_shadow
    loop: "{{ user }}"
    loop_control:
      loop_var: item

  - name: Set users password valid time
    shell:
      cmd: chage -E {{ item.expires }} {{ item.user }}
    when: user_shadow is not None

  - name: Place private key file for user
    copy:
      content: "{{ item.content }}"
      dest: /home/{{ item.user }}/.ssh/private_key
      mode: '0600'
      owner: "{{ item.user }}"
      group: "{{ item.group }}"
    when: user.private_keys
    loop: "{{ user }}"
    loop_control:
      loop_var: item

  handlers:
  - name: sudo_config_updated
    service:
      name: sudo
