---

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- block:
    - name: Configure selinux
      selinux:
        allow_httpd_anon_write: yes
        allow_httpd_mod_auth: yes
        allow_httpd_mod_auth_pam: yes
        allow_httpd_mod_auth_zap: yes
        allow_httpd_sys_content_t: yes

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    notify:
      - Test httpd configuration validity
      - Restart httpd

- block:
    - name: Activate httpd module | Debian
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ httpd_modules_to_activate_with_command }}"
      when: ansible_distribution == 'Debian'

- import_tasks:
    file: "{{ item }}"
    when: https_ssl_enable == true
  loop:
    - ssl.yml

- import_tasks:
    file: "{{ item }}"
    when: httpd_locations is defined
  loop:
    - locations.yml

- import_tasks:
    file: "{{ item }}"
    when: httpd_vhosts is defined
  loop:
    - vhosts.yml

- block:
    - name: Configure ports
      template:
        src: "{{ httpd_ports_conf }}"
        dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
        notify:
          - Test httpd configuration validity
          - Restart httpd
      when: (ansible_distribution == 'Debian') or (ansible_distribution == 'SUSE')

- import_tasks:
    file: "{{ item }}"
    when: httpd_directories is defined
  loop:
    - directories.yml

- meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example == true

- service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true

