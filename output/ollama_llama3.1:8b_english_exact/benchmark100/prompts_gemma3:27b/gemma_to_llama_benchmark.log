---
- name: Gather Facts
  tasks:
  - name: Gather bootstrap facts
    raw: cat /etc/os-release
    register: bootstrap_facts

  - name: Set bootstrap facts (I)
    set_fact:
      bootstrap_distribution: ''
      bootstrap_distribution_major_version: ''
    when:
      - bootstrap_facts.rc == 0
      - bootstrap_distribution is not defined
      - bootstrap_facts.stdout | regex_search('{{ item.value }}.*{{ item.search }}', bootstrap_search) | bool
    loop: "{{ bootstrap_os_family_map }}"

  - name: Set bootstrap facts (II)
    set_fact:
      bootstrap_os_family: "{{ item.key }}"
    loop: "{{ bootstrap_os_family_map | dictitems }}"
    loop_control:
      label: "{{ item.key }}"
    when:
      - bootstrap_distribution is defined
      - bootstrap_distribution in bootstrap_os_family_map[item.key]


