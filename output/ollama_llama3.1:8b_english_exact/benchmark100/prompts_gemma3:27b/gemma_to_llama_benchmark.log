---

- name: Enable Apache modules
  become: yes
  apt:
    name: libapache2-mod-proxy
    state: present
  when: ansible_distribution_family == 'Debian'

- name: Enable Apache modules
  become: yes
  zypper:
    name: libapache2-mod_proxy_http
    state: present
  when: ansible_distribution_family == 'Suse'

- name: Configure Apache locations
  template:
    src: location.conf.j2
    dest: "/etc/apache2/conf-enabled/{{ item.name }}.conf"
    mode: '0644'
  notify: Test httpd configuration validity
  notify: Restart httpd
  loop: "{{ httpd_locations }}"
  loop_control:
    loop_var: item

