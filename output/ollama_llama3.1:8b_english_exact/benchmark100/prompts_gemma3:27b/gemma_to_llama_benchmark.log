content='```yml\n---\n- name: Gather bootstrap facts\n  raw:\n    cmd: \'uname -a\'\n  register: bootstrap_facts\n  become: false\n  delegate_to: localhost\n  gather_facts: no\n\n- name: Set bootstrap facts (I) based on OS release information\n  set_fact:\n    bootstrap_distribution: \'\'\n    bootstrap_distribution_major_version: \'\'\n  when:\n    - bootstrap_facts.rc == 0\n    - bootstrap_distribution is not defined\n  loop: \'{{ bootstrap_os_family_map }}\'\n  loop_control:\n    loop_var: distribution\n  when: bootstrap_facts.stdout | regex_search(distribution) is not defined\n  set_fact:\n    bootstrap_distribution: \'{{ distribution }}\'\n  set_fact:\n    bootstrap_distribution_major_version: \'{{ distribution.stdout_lines[0] | regex_search("([0-9]+)" ) }}\'\n    bootstrap_search: \'{{ distribution.stdout | regex_search("({{ item }})") }}\'\n\n- name: Set bootstrap facts (II) based on OS family\n  set_fact:\n    bootstrap_os_family: \'\'\n  loop: \'{{ bootstrap_os_family_map }}\'\n  loop_control:\n    label: distribution\n  when: bootstrap_distribution in bootstrap_os_family_map[distribution]\n  set_fact:\n    bootstrap_os_family: \'{{ distribution }}\'\n```' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-21T14:21:11.172359137Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2992127856, 'load_duration': 122813527, 'prompt_eval_count': 549, 'prompt_eval_duration': 169951642, 'eval_count': 268, 'eval_duration': 2698308272, 'model_name': 'llama3.1:8b'} id='run--a1ad04f3-b16b-44d5-934c-5ba6190c68cb-0' usage_metadata={'input_tokens': 549, 'output_tokens': 268, 'total_tokens': 817}
