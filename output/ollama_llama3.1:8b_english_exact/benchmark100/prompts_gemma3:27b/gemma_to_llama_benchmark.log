  when: ansible_pkg_mgr == 'apk'
  notify: Reboot

- name: Configure apt
  apt:
    cache_valid_time: 0
    state: present
    autoremove: true
    upgrade: true
    update_cache: true
  when: ansible_pkg_mgr == 'apt'
  notify: Reboot

- name: Update all software (dnf)
  dnf:
    cache_enabled: true
    state: present
    update_cache: true
    exclude: "{{ update_excluded_packages }}"
  when: ansible_pkg_mgr in ['dnf', 'dnf5']
  notify: Reboot

- name: Update all software (pacman)
  pacman:
    state: present
    update_cache: true
  when: ansible_pkg_mgr == 'pacman'
  notify: Reboot

- name: Configure yum
  yum:
    cache_valid_time: 0
    state: present
  when: ansible_pkg_mgr == 'yum'
  notify: Reboot
  handlers:
    - name: Reboot
      reboot:
        msg: 'Rebooting system after package update'
        conn_delay: 30

- name: Update all software (zypper)
  zypper:
    state: present
    update: true
  when: ansible_pkg_mgr == 'zypper'
  notify: Reboot

