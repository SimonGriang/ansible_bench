---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2 - Install cron
  package:
    name: "{{ cron_packages }}"

- name: Task 3 - Configure shell
  lineinfile:
    dest: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Task 4 - Configure path
  lineinfile:
    dest: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Task 5 - Configure mailto
  lineinfile:
    dest: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Task 6 - Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ""

- name: Task 7 - Schedule requested cron jobs
  cron:
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
    state: "{{ item.state }}"
    user: "{{ item.user }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined
  loop_control:
    label: "{{ item.name }}"


