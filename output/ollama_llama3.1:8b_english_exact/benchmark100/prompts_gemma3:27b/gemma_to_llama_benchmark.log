---
- name: RKE2 tasks
  hosts: rke2_cluster_group_name
  gather_facts: no

  tasks:
  - name: Get all RKE2 nodes
    kubectl:
      command: get nodes -o jsonpath='{.items[*].metadata.name}'
      kubeconfig: /etc/rancher/rke2/config
    register: node_names

  - name: Remove old RKE2 nodes
    kubectl:
      command: delete nodes {{ item }}
      kubeconfig: /etc/rancher/rke2/config
      ignore_errors: yes
    with_items: "{{ node_names.stdout_lines }}"
    when: item not in groups['rke2_cluster_group_name']


