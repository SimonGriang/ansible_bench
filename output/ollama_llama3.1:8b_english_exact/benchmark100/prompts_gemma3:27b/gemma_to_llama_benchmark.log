---
- name: RKE2 Tasks
  hosts: localhost
  gather_facts: yes
  become: yes

  tasks:
  - name: Download RKE2 installation script
    get_url:
      url: https://example.com/rke2-install.sh
      dest: /tmp/rke2-install.sh
      mode: '0755'
    when: not airgap_mode

  - name: Copy local RKE2 installation script
    copy:
      content: "{{ lookup('file', '/path/to/local/rke2-install.sh') }}"
      dest: /tmp/rke2-install.sh
      mode: '0755'
    when: airgap_mode and implementation == 'copy'

  - name: Create RKE2 artifacts folder
    file:
      path: /usr/local/rke2-artifacts
      state: directory
      mode: '0755'
    when: airgap_mode and implementation != 'exists'

  - name: Download RKE2 checksum and artifacts
    get_url:
      url: https://example.com/rke2-artifacts.tar.gz
      dest: /tmp/rke2-artifacts.tar.gz
      mode: '0644'
    when: airgap_mode and implementation == 'get'
    ignore_errors: yes

  - name: Download RKE2 checksum and artifacts (fallback to local)
    copy:
      content: "{{ lookup('file', '/path/to/local/rke2-artifacts.tar.gz') }}"
      dest: /tmp/rke2-artifacts.tar.gz
      mode: '0644'
    when: airgap_mode and implementation == 'copy'

  - name: Copy local RKE2 artifacts
    copy:
      content: "{{ lookup('file', '/path/to/local/rke2-artifacts.tar.gz') }}"
      dest: /usr/local/rke2-artifacts.tar.gz
      mode: '0644'
    when: airgap_mode and implementation == 'copy'

  - name: Airgap mode - additional images tarballs
    copy:
      content: "{{ lookup('file', '/path/to/local/additional-images.tar.gz') }}"
      dest: /usr/local/additional-images.tar.gz
      mode: '0644'
    when: airgap_mode and additional_images.tarball is defined

  - name: Airgap mode - ensure artifacts exist and have acceptable permissions
    file:
      path: /usr/local/rke2-artifacts
      state: directory
      mode: '0755'
    when: airgap_mode
    notify: restart rke2

  - name: Populate service facts
    service_facts:
      gather_subset: ['all']

  - name: Get stats of the FS object
    command:
      cmd: df -h /usr/local
      chdir: /usr/local
      creates: /usr/local/rke2-artifacts

  - name: Check if separate partition
    stat:
      path: /usr/local
      register: result
    when: result.stat.ismount

  - name: Set RKE2 bin path
    set_fact:
      rke2_bin_path: /usr/local/bin/rke2

  - name: Check RKE2 version
    command:
      cmd: rke2 version
      chdir: /usr/local/bin
      register: rke2_version

  - name: Check RKE2 version (continued)
    assert:
      that: rke2_version.stdout_lines[0] == '1.21.4'
      msg: RKE2 version is not 1.21.4

  - name: Set RKE2 versions
    set_fact:
      rke2_installed_version: 1.21.4
      rke2_running_version: 1.21.4

  - name: Prevent accidental RKE2 downgrade
    assert:
      that: not rke2_upgrade or rke2_upgrade is True
      msg: RKE2 downgrade is attempted without explicit permission

  - name: Run RKE2 install script
    command:
      cmd: bash /tmp/rke2-install.sh
      chdir: /tmp
      creates: /usr/local/bin/rke2

  - name: Copy Custom Manifests
    copy:
      content: "{{ lookup('file', '/path/to/local/custom-manifests.yaml') }}"
      dest: /usr/local/etc/kubernetes/manifesets/custom-manifests.yaml
      mode: '0644'

  - name: Copy Static Pods
    copy:
      content: "{{ lookup('file', '/path/to/local/static-pods.yaml') }}"
      dest: /usr/local/etc/kubernetes/manifests/static-pods.yaml
      mode: '0644'

  - name: Copy RKE2 environment file
    copy:
      content: "{{ lookup('file', '/path/to/local/rke2-env.yaml') }}"
      dest: /usr/local/etc/kubernetes/environment/rke2-env.yaml
      mode: '0644'


