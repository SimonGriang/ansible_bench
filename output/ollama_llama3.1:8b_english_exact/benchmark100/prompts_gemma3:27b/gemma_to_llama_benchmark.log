---
- name: Java configuration
  vars:
    java_jdk_vendor: adoptopenjdk
  tasks:
  - name: Migrate from adoptopenjdk to temurin if selected
    set_fact:
      java_jdk_vendor: "temurin" when (java_jdk_vendor == "adoptopenjdk")

  - name: Gather OS specific variables
    include_vars:
      file: "vars/{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"

  - name: Gather architecture specific variables
    include_vars:
      file: "architecture.yml"

  - name: Set OS specific variables (I)
    set_fact:
      java_open_jdk_repos: "{{ (java_open_jdk_repos | default({})) | combine({'openjdk': 'https://download.openjdk.java.net/{{ java_jdk_vendor }}'}})"
      java_open_jdk_libs: "{{ (java_open_jdk_libs | default({})) | combine({'openjdk': 'libopenjdk-{{ java_jdk_vendor }}-{{ java_open_jdk_version }}'}) }}"
    when: not java_open_jdk_repos or not java_open_jdk_libs

  - name: Set OS and architecture specific variables (II)
    set_fact:
      java_open_jdk_home_dir: "{{ (java_open_jdk_home_dir | default('/usr/lib/jvm')) }}"
      java_open_jdk_package: "{{ (java_open_jdk_package | default('openjdk-{{ java_jdk_vendor }}-{{ java_open_jdk_version }}')) }}"
    when: not java_open_jdk_home_dir or not java_open_jdk_package

  - name: Set specific variables
    set_fact:
      java_home: "{{ java_open_jdk_home_dir }}/{{ java_open_jdk_package }}"

  - name: Remove deprecated repositories (Debian)
    apt:
      name: "{{ java_deprecated_repositories_adoptopenjdk }}"
      state: absent
    when: (ansible_distribution == "Debian") and java_deprecated_repositories_adoptopenjdk

  - name: Install extra apt tools (Debian)
    apt:
      name: "{{ item }}"
      state: present
    loop: "{{ java_open_jdk_apt_extra_packages }}"
    when: (ansible_distribution == "Debian") and java_open_jdk_apt_extra_packages

  - name: Add required key repositories (Debian)
    apt_key:
      url: "{{ java_required_key_repositories_openjdk }}"
      state: present
    when: (ansible_distribution == "Debian") and java_required_key_repositories_openjdk

  - name: Add required repositories (Debian)
    apt_repository:
      repo: "{{ java_required_repositories_openjdk }}"
      state: present
    when: (ansible_distribution == "Debian") and java_required_repositories_openjdk

  - name: Add required key repositories (RedHat)
    rpm_key:
      key: "{{ java_required_key_repositories_openjdk }}"
      state: present
    when: (ansible_distribution == "RedHat") and java_required_key_repositories_openjdk

  - name: Add required repositories (RedHat)
    yum_repository:
      name: "{{ java_required_repositories_openjdk }}"
      description: "{{ java_required_repositories_openjdk }}"
      repo_gpgcheck: yes
      state: present
    when: (ansible_distribution == "RedHat") and java_required_repositories_openjdk

  - name: Install required libs
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ java_required_libs_openjdk }}"
    when: java_required_libs_openjdk

  - name: Install Java (Debian)
    apt:
      name: "{{ java_open_jdk_package }}"
      state: present
      version: "{{ java_open_jdk_version }}"
    when: (ansible_distribution == "Debian") and java_open_jdk_package and java_open_jdk_version

  - name: Install Java (RedHat)
    yum:
      name: "{{ java_open_jdk_package }}"
      state: present
      version: "{{ java_open_jdk_version }}"
    when: (ansible_distribution == "RedHat") and java_open_jdk_package and java_open_jdk_version

  - name: Export environment variables
    template:
      src: templates/jdk.sh.j2
      dest: /etc/profile.d/jdk.sh
      mode: '0644'

  - name: Source environment variables
    command: source /etc/profile

  - name: Correct java version selected (Debian, Java < 11)
    become: yes
    become_method: sudo
    command: update-alternatives --set java /usr/lib/jvm/java-{{ java_jdk_vendor }}-{{ java_open_jdk_version }}-amd64/bin/java
    when: (ansible_distribution == "Debian") and (java_jdk_vendor == "adoptopenjdk") and (java_open_jdk_version < "11")

  - name: Correct java version selected (Debian, Java >= 11)
    become: yes
    become_method: sudo
    command: update-alternatives --set java /usr/lib/jvm/java-{{ java_jdk_vendor }}-{{ java_open_jdk_version }}-amd64/bin/java
    when: (ansible_distribution == "Debian") and (java_jdk_vendor == "adoptopenjdk") and (java_open_jdk_version >= "11")


