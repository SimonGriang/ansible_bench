---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install git
  apt:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    name: "{{ git_username }}"
  register: user_exists
  failed_when: user_exists is undefined or user_exists.status != 0 and not git_username_fail_key

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    mode: '0600'

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Clone all roles
  git:
    repo: "{{ item.repository }}"
    dest: "{{ git_repository_destination }}/{{ item.repository | basename }}"
    version: "{{ item.version }}"
    force: yes
    clone: yes
  loop: "{{ git_repositories }}"
  loop_control:
    loop_var: item
  notify: "destination: {{ git_repository_destination }}/{{ item.repository | basename }}"


