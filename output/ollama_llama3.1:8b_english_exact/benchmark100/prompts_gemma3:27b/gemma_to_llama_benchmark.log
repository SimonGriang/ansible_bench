      loop: "{{ lookup('fileglob', 'kube-vip-cloud-*.j2') }}"
      when: rke2_kubevip_cloud_provider_enable == true
  always:
    - name: Set permissions on manifests directory
      file:
        path: "{{ rke2_data_path }}/server/manifests"
        mode: '0755'
        owner: root
        group: root

