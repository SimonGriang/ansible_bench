sponse_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-11T16:06:27.182479979Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11324603470, 'load_duration': 112403976, 'prompt_eval_count': 1972, 'prompt_eval_duration': 383811482, 'eval_count': 977, 'eval_duration': 10826773341, 'model_name': 'llama3.1:8b'} id='run--f02cb1e6-ad37-4bc9-b6d0-5991e1618efd-0' usage_metadata={'input_tokens': 1972, 'output_tokens': 977, 'total_tokens': 2949}
