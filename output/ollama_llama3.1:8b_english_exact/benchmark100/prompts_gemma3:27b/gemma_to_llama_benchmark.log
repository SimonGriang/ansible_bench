---
- name: Configure DNS
  hosts: localhost
  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml

    - name: Install dns
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ dns_packages }}"

    - name: Create directories
      file:
        path: "{{ item.path }}"
        mode: "{{ item.mode }}"
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
      loop:
        - { path: "{{ dns_datadir }}", mode: '0755', owner: 'root', group: 'root' }
        - { path: "{{ dns_confdir }}", mode: '0755', owner: 'root', group: 'root' }

    - name: Create group
      group:
        name: "{{ dns_group }}"
        state: present
      when: dns_group is defined

    - name: Create user
      user:
        name: "{{ dns_owner }}"
        system: yes
        shell: /bin/false
      when: dns_owner is defined

    - name: Generate rndc key
      shell:
        cmd: rndc-confgen -a "{{ dns_confdir }}/{% if dns_key_file %}rndc.key{% else %}rndc.key{% endif %}"
      when: not dns_key_file

    - name: Set permissions on rndc key file
      file:
        path: "{{ dns_confdir }}/rndc.key"
        mode: '0600'
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"

    - name: Get the hints/root file
      get_url:
        url: "{{ dns_root_url }}"
        dest: "{{ dns_datadir }}/{{ dns_root_file }}"
        mode: '0644'
        not_if: "test -f '{{ dns_datadir }}/{{ dns_root_file }}'"
