---
- name: Tasks for RKE2 installation
  hosts: all
  become: true

  tasks:
  - name: Create the RKE2 config directory
    file:
      path: /etc/rancher/rke2
      state: directory
      mode: '0755'

  - name: Set server taints
    set_fact:
      combined_node_taints: "{{ rke2_server_node_taints }}"
    when: rke2_type == 'server'

  - name: Copy rke2 config
    copy:
      src: templates/rke2.yaml.j2
      dest: /etc/rancher/rke2/config.yaml
      mode: '0600'
      owner: root
      group: root
      notify: Config file changed

  - name: Copy kubelet config
    copy:
      src: templates/kubelet.yaml.j2
      dest: /etc/rancher/rke2/kubelet.yaml
      mode: '0600'
      owner: root
      group: root
      notify: Config file changed
    when: rke2_kubelet_config | length > 0

  - name: Copy Containerd Registry Configuration file
    copy:
      src: templates/daemon.json.j2
      dest: /etc/containerd/config.toml
      mode: '0600'
      owner: root
      group: root
      notify: Config file changed
    when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)

  - name: Register if we need to do a etcd restore from file
    set_fact:
      do_etcd_restore: true
    when: rke2_etcd_snapshot_file is defined and (rke2_server.service is not defined or rke2_server.service is disabled)

  - name: Register if we need to do a etcd restore from s3
    set_fact:
      do_etcd_restore_from_s3: true
    when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.prefix is defined

  - name: Restore etcd from file
    block:
      - name: Create the destination directory
        file:
          path: /etc/rke2/etcd
          state: directory
          mode: '0755'

      - name: Copy the snapshot
        copy:
          src: "{{ rke2_etcd_snapshot_file }}"
          dest: /etc/rke2/etcd/etcd-snapshot.db
          mode: '0600'
          owner: root
          group: root

      - name: Run rke2 server with etcd flags
        shell:
          cmd: "rke2 server --etcd-snapshot-file /etc/rke2/etcd/etcd-snapshot.db --etcd-snapshot-dir /etc/rke2/etcd"
          args:
            creates: /etc/rke2/etcd/etcd-snapshot.db

  - name: Restore etcd from s3
    block:
      - name: Run rke2 server with s3 flags
        shell:
          cmd: "rke2 server --etcd-snapshot-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }} --etcd-snapshot-s3-prefix {{ rke2_etcd_snapshot_s3_options.prefix }} --etcd-snapshot-s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }} --etcd-snapshot-s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }}"
          args:
            creates: /etc/rke2/etcd/etcd-snapshot.db

  - name: Start RKE2 service on the first server
    service:
      name: rke2-server.service
      state: started
      enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
    notify: Service (re)started

  - name: Mask RKE2 agent service on the first server
    service:
      name: rke2-agent.service
      state: masked
      enabled: false

  - name: Wait for the first server be ready - no CNI
    wait_for:
      host: "{{ inventory_hostname }}"
      port: 8443
      path: /
      method: get
      timeout: 60
      status: 200
      body: "{{ 'node-' + inventory_hostname + ' is ready' }}"
    when: '"Ready" not in (kubectl get nodes -o json | jq -r '.items[] | .status.conditions[] | .reason')"

  - name: Wait for the first server be ready - with CNI
    wait_for:
      host: "{{ inventory_hostname }}"
      port: 8443
      path: /
      method: get
      timeout: 60
      status: 200
      body: "{{ 'Ready' }}"
    when: '"Ready" in (kubectl get nodes -o json | jq -r '.items[] | .status.conditions[] | .reason')"

  - name: Restore etcd
    block:
      - name: Get registered nodes
        shell:
          cmd: kubectl get nodes -o json
          register: registered_nodes
          creates: /etc/rke2/etcd/etcd-snapshot.db

      - name: Get node names
        shell:
          cmd: kubectl get nodes -o json | jq -r '.items[] | .metadata.name'
          register: node_names

      - name: Remove old secrets and nodes
        shell:
          cmd: "kubectl delete secrets {{ item }}; kubectl delete node {{ item }}; for node in {{ registered_nodes.json.items }}; do kubectl delete pod {{ node.metadata.name }}; done"
          loop: "{{ registered_nodes.json.items | map(attribute='metadata.name') | list }}"

  - name: Set an Active Server variable
    set_fact:
      active_server: "{{ inventory_hostname }}"
    delegate_to: "{{ groups['{{ rke2_cluster_group_name }}'] | first }}"

