ng it in production.' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-11T15:04:36.565749484Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9755565963, 'load_duration': 93822746, 'prompt_eval_count': 735, 'prompt_eval_duration': 166927653, 'eval_count': 956, 'eval_duration': 9493426930, 'model_name': 'llama3.1:8b'} id='run--d8952dec-1861-487e-aa68-24576be94f86-0' usage_metadata={'input_tokens': 735, 'output_tokens': 956, 'total_tokens': 1691}
