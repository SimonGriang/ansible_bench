---
- name: Enable Apache modules
  when: ansible_distribution in ['Debian', 'SUSE']
  block:
    - name: Enable proxy module
      community.general.apache2_module:
        name: proxy
        state: present
    - name: Enable proxy_http module
      community.general.apache2_module:
        name: proxy_http
        state: present

- name: Configure Apache locations
  block:
    - name: Create location configuration files
      template:
        src: location.conf.j2
        dest: "{{ httpd_config_directory }}/{{ item.name }}.conf"
        mode: '0644'
      notify:
        - Test httpd configuration validity
        - Restart httpd
      loop: "{{ httpd_locations }}"


