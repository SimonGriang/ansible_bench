---
- name: Configure vault settings
  hosts: all
  become: yes
  tasks:
    - name: Set the file permissions to 0644
      file:
        path: /etc/vault.d/vault.json
        mode: '0644'
    - name: Set the owner to root
      file:
        path: /etc/vault.d/vault.json
        owner: root
    - name: Set the group to root
      file:
        path: /etc/vault.d/vault.json
        group: root

  - name: Configure vault settings
    hosts: all
    become: yes
    tasks:
      - name: Set the file permissions to 0644
        file:
          path: /etc/vault.d/vault.json
          mode: '0644'
      - name: Set the owner to root
        file:
          path: /etc/vault.d/vault.json
          owner: root
      - name: Set the group to root
        file:
          path: /etc/vault.d/vault.json
          group: root

  - name: Configure SELinux / AppArmor
    hosts: all
    become: yes
    tasks:
      - name: Configure SELinux
        block:
          when: vault_hardening_configure_selinux_apparmor is true and ansible_selinux.status == "enabled"
          tasks:
            - name: Install selinux-policy package
              package:
                name: selinux-policy
                state: present
            - name: Set SELinux policy to targeted and state to enforcing
              selinux:
                policy: targeted
                state: enforcing
      - name: Configure AppArmor
        block:
          when: vault_hardening_configure_selinux_apparmor is true and ansible_apparmor.status == "enabled"
          tasks:
            - name: Install apparmor package
              package:
                name: apparmor
                state: present
            - name: Set AppArmor profile to enforcing
              apparmor:
                state: enforcing


