---
- name: Include assert.yml
  include_tasks: assert.yml

- name: Install bash
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: "{{ java_package }}-openjdk{{ java_version }}.{{ java_arch }}"
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "{{ java_use }}"

- name: Install RPM
  package:
    name: "{{ java_package }}-{{ java_version }}-linux-x64.rpm"
    state: present
  when:
    - java_source == "local"
    - java_format == "rpm"
  copy:
    content: "{{ java_rpm }}"
    dest: "/tmp/{{ java_rpm }}"
    mode: '0644'

- name: Install DEB
  package:
    name: "{{ java_package }}-{{ java_version }}-linux-x64.deb"
    state: present
  when:
    - java_source == "local"
    - java_format == "deb"
  copy:
    content: "{{ java_deb }}"
    dest: "/tmp/{{ java_deb }}"
    mode: '0644'

- name: Install oracle java (rpm) (repository)
  package:
    name: "{{ java_package }}-{{ java_version }}-linux-x64.rpm"
    state: present
  when:
    - java_source == "repository"
    - java_format == "rpm"

- name: Configure oracle targz
  unarchive:
    src: "{{ java_targz }}"
    dest: "{{ java_install_dir }}"
    compression: tar
  when:
    - java_format == "targz"
    - java_vendor == "oracle"
  become: yes
  notify: restart

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_jce_zip }}"
    dest: "{{ java_install_dir }}"
    compression: zip
  when:
    - java_jce
    - java_version == 8
    - java_vendor == "oracle"

- name: Set alternative (targz)
  shell:
    cmd: alternatives --set java /usr/lib/jvm/java-{{ java_version }}-openjdk-amd64/bin/java
  when:
    - java_format == "targz"
    - ansible_distribution != "Alpine"
    - java_vendor == "oracle"

- name: Find JAVA_HOME
  find:
    paths: ['/usr/lib/jvm']
    patterns: ['java-{{ java_version }}-openjdk-amd64']
  register: java_home
  become: yes

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: JAVA_HOME={{ java_home.path }}
  become: yes
  notify: restart


