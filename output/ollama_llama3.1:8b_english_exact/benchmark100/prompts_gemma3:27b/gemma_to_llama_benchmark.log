content='---\n\n\n- name: Manage User\n  hosts: localhost\n  become: true\n\n  tasks:\n  - name: Create ssh_key_directory for user\n    file:\n      path: /home/{{ user.name }}/ssh_key_directory\n      state: directory\n      owner: {{ user.name }}\n      group: {{ user.name }}\n    when: user.manage_ssh_key is defined and user.manage_ssh_key\n\n  - name: Manage user account\n    user:\n      name: {{ user.name }}\n      comment: {{ user.comment }}\n      home: {{ user.home }}\n      state: {{ user.state | default(\'present\') }}\n      create_home: {{ user.create_home | default(true) }}\n      password: {{ user.password | default(\'\') }}\n      uid: {{ user.uid | default(\'\') }}\n      group: {{ user.group | default(\'\') }}\n      shell: {{ user.shell | default(\'\') }}\n      expiry: {{ user.expiry | default(\'\') }}\n    register: user\n    when: user.manage_ssh_key is defined and user.manage_ssh_key\n\n  - name: Set sudo options for user\n    template:\n      src: templates/sudo.j2\n      dest: /etc/sudoers.d/{{ user.name }}\n      mode: \'0644\'\n      validate: \'sudo visudo -cf %s\'\n    loop: "{{ user.sudo_options | default([]) }}"\n    loop_control:\n      label: "{{ item }}"\n    when: user.manage_ssh_key is defined and user.manage_ssh_key\n\n  - name: Remove sudo options for user\n    file:\n      path: /etc/sudoers.d/{{ item }}\n      state: absent\n    loop: "{{ user.sudo_options | default([]) }}"\n    loop_control:\n      label: "{{ item }}"\n    when: user.manage_ssh_key is defined and user.manage_ssh_key\n\n  - name: Generate private ssh key for user\n    command:\n      cmd: ssh-keygen -t {{ user.key_type | default(\'rsa\') }} -N \'\' -f /home/{{ user.name }}/ssh_key_directory/{{ user.name }}_private\n    when: user.manage_ssh_key is defined and user.manage_ssh_key\n\n  - name: Generate public ssh key for user\n    command:\n      cmd: ssh-keygen -y -f /home/{{ user.name }}/ssh_key_directory/{{ user.name }}_private > /home/{{ user.name }}/ssh_key_directory/{{ user.name }}_public\n    when: user.manage_ssh_key is defined and user.manage_ssh_key\n\n  - name: Convert ssh key to ppk for user\n    command:\n      cmd: ssh-keygen -p -f /home/{{ user.name }}/ssh_key_directory/{{ user.name }}_private\n    when: user.manage_ssh_key is defined and user.manage_ssh_key\n\n  - name: Get or set the home directory for user\n    set_fact:\n      user_home: "{{ user.home | default(\'/home/{{ user.name }}\') }}"\n    when: user.manage_ssh_key is defined and user.manage_ssh_key\n\n  - name: Create .ssh directory for user\n    file:\n      path: /home/{{ user.name }}/.ssh\n      state: directory\n      owner: {{ user.name }}\n      group: {{ user.name }}\n    when: user.manage_ssh_key is defined or user.private_keys is defined\n\n  - name: Deploy authorized keys for user\n    authorized_key:\n      user: "{{ user.name }}"\n      state: present\n      key: "{{ item }}"\n    loop: "{{ user.authorized_keys | default([]) }}"\n    loop_control:\n      label: "{{ item }}"\n    when: user.manage_ssh_key is defined or user.private_keys is defined\n\n  - name: Remove unauthorized keys for user\n    authorized_key:\n      user: "{{ user.name }}"\n      state: absent\n      key: "{{ item }}"\n    loop: "{{ user.unauthorized_keys | default([]) }}"\n    loop_control:\n      label: "{{ item }}"\n    when: user.manage_ssh_key is defined or user.private_keys is defined\n\n  - name: Copy generated private ssh key for user\n    copy:\n      content: "{{ user.private_key | default(\'\') }}"\n      dest: /home/{{ user.name }}/.ssh/{{ user.name }}_private\n      mode: \'0600\'\n    when: user.copy_private_key is defined\n\n  - name: Check users password valid time\n    command:\n      cmd: grep -oP \'(?<={{ user.name }}:).*\' /etc/shadow\n    register: user_valid_time\n    when: user.manage_ssh_key is defined and user.manage_ssh_key\n\n  - name: Set users password valid time\n    command:\n      cmd: chage -E {{ user.expiry }} {{ user.name }}\n   