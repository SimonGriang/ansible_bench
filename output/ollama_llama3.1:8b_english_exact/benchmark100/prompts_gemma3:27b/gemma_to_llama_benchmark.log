- name: Ensure the /etc/openvpn/client directory exists
  file:
    path: /etc/openvpn/client
    state: directory
    owner: root
    group: "{{ openvpn_group }}"
    mode: '0750'

- name: Deploy the OpenVPN client configuration file
  template:
    src: client.conf.j2
    dest: "{{ openvpn_configuration_directory }}/client.conf"
    owner: root
    group: "{{ openvpn_group }}"
    mode: '0640'
  notify: Restart openvpn

