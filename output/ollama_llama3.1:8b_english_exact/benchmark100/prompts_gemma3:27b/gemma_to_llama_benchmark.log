--- 

- name: Import assert.yml
  include: assert.yml

- name: Install using package
  block:
    - name: Install Hashicorp products
      when: hashicorp_installation_method == "package"

- name: Install repository for RedHat
  yum_repository:
    name: hashicorp
    description: Hashicorp repository
    baseurl: https://rpm.releases.hashicorp.com/RedHat-$releasever
    gpgcheck: yes
    gpgkey: https://rpm.releases.hashicorp.com/gpg
    state: present
  when: ansible_distribution in ["RedHat", "Rocky"]

- name: Configure debian
  block:
    - name: Configure Debian package manager
      when: ansible_os_family == "Debian"

- name: Install required package gpg
  package:
    name: gnupg
    state: present
  when: ansible_os_family == "Debian"

- name: Install apt key for Debian
  apt_key:
    keyserver: keyserver.ubuntu.com
    state: present
    id: 77F66B693D721648FFC2EBB473BCB8BDFC1A459
  when: ansible_os_family == "Debian"

- name: Install repository for Debian
  apt_repository:
    repo: 'ppa:hashicorp'
    state: present
    arch: "{{ hashicorp_architecture_mapping[ansible_architecture] }}"
    dist: "{{ ansible_distribution_release }}"
  when: ansible_os_family == "Debian"

- name: Install hashicorp product using package
  block:
    - name: Install Hashicorp products
      when: hashicorp_products is defined

- name: Install latest hashicorp product using package
  block:
    - name: Install latest Hashicorp products
      loop: "{{ hashicorp_products }}"
      loop_control:
        label: "{{ item }}"
      when: hashicorp_products is defined

- name: Install versioned hashicorp product using package
  block:
    - name: Install versioned Hashicorp products
      loop: "{{ hashicorp_products }}"
      loop_control:
        label: "{{ item }}"
      when: hashicorp_products is defined

- name: Install manually
  block:
    - name: Install Hashicorp products manually
      when: hashicorp_installation_method == "manual"

- name: Install hashicorp product manually
  unarchive:
    src: "{{ hashicorp_src[ansible_distribution] }}/{{ item }}"
    dest: "{{ hashicorp_product_path }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
  with_items: "{{ hashicorp_products | list }}"

