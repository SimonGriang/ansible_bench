content='---\n\n\n- name: Import tasks from assert.yml, running only once on localhost\n  import_tasks: assert.yml\n\n\n- name: Install using package\n  block:\n    - name: Install Hashicorp products using a package manager\n      when: hashicorp_installation_method == "package"\n\n\n- name: Install repository for RedHat\n  become: yes\n  become_user: root\n  become_method: sudo\n  block:\n    - name: Download the Hashicorp repository file for RedHat-based systems\n      get_url:\n        url: https://apt.releases.hashicorp.com/hashicorp-repo-redhat-linux-x86_64.gpg\n        dest: /etc/yum.repos.d/hashicorp.repo\n        mode: \'0640\'\n\n\n- name: Configure debian\n  block:\n    - name: Configure the Debian package manager\n      when: ansible_os_family == "Debian"\n\n\n- name: Install required package gpg\n  when: ansible_os_family == "Debian"\n  apt:\n    name: gnupg\n\n\n- name: Install apt key for Debian\n  when: ansible_os_family == "Debian"\n  apt_key:\n    url: https://apt.releases.hashicorp.com/gpg\n    state: present\n    keyserver: keyserver.ubuntu.com\n    validate_certs: no\n\n\n- name: Install repository for Debian\n  when: ansible_os_family == "Debian"\n  apt_repository:\n    repo: \'ppa:hashicorp/debian-{{ hashicorp_architecture_mapping }}\'\n    state: present\n    arch: "{{ hashicorp_architecture_mapping }}"\n\n\n- name: Install hashicorp product using package\n  block:\n    - name: Install Hashicorp products using the package manager\n      when: hashicorp_products is defined\n\n\n- name: Install latest hashicorp product using package\n  when: hashicorp_products is defined\n  block:\n    - name: Install the latest version of each Hashicorp product\n      loop: "{{ hashicorp_products }}"\n      loop_control:\n        label: "{{ item }}"\n      package:\n        name: "{{ item }}"\n        state: latest\n\n\n- name: Install versioned hashicorp product using package\n  when: hashicorp_products is defined\n  block:\n    - name: Install a specific version of each Hashicorp product\n      loop: "{{ hashicorp_products }}"\n      loop_control:\n        label: "{{ item }}"\n      package:\n        name: "{{ version_coupler }}{{ item }}"\n        state: present\n\n\n- name: Install manually\n  block:\n    - name: Install Hashicorp products manually\n      when: hashicorp_installation_method == "manual"\n\n\n- name: Install hashicorp product manually\n  when: hashicorp_installation_method == "manual"\n  block:\n    - name: Unarchive each Hashicorp product to the destination directory\n      unarchive:\n        src: "{{ hashicorp_src }}/{{ item }}"\n        dest: "/opt/{{ item }}"\n        compression: tar\n        group: "{{ item_group }}"\n        mode: "{{ item_mode }}"\n        owner: "{{ item_owner }}"\n      loop: "{{ hashicorp_products }}"\n      loop_control:\n        label: "{{ item }}"' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-11T17:39:43.940329899Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5900023526, 'load_duration': 116372081, 'prompt_eval_count': 759, 'prompt_eval_duration': 142093566, 'eval_count': 678, 'eval_duration': 5639956710, 'model_name': 'llama3.1:8b'} id='run--551e4f85-4ea3-4131-9c41-759c6c23d700-0' usage_metadata={'input_tokens': 759, 'output_tokens': 678, 'total_tokens': 1437}
