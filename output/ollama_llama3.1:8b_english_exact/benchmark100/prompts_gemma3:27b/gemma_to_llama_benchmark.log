---
- name: Enable the Backports repository for Debian
  apt_repository:
    repo: "deb http://deb.debian.org/debian {{ ansible_distribution_release }}-backports main"
    state: present
    filename: "deb.debian.org-{{ ansible_distribution_release }}-backports main"

