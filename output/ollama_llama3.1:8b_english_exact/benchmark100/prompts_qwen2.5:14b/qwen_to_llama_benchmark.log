---
- name: Configure vsftpd
  hosts: localhost
  become: true

  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install vsftpd
    apt:
      name: vsftpd
      state: present

  - name: Configure vsftpd
    template:
      src: vsftpd.conf.j2
      dest: /etc/vsftpd.conf
      mode: '0644'
      owner: root
      group: root
    notify: restart vsftpd

  - name: Start and enable vsftpd
    service:
      name: vsftpd
      state: started
      enabled: true

  handlers:
  - name: restart vsftpd
    service:
      name: vsftpd
      state: restarted

