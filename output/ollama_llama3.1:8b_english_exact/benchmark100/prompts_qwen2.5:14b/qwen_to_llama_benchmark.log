--- 

- name: Import assert.yml
  include: assert.yml

- name: Install mysql
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_packages }}"

- name: Configure mysql server
  template:
    src: templates/my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: '0644'
  notify: restart mysql

- name: Configure mysql client
  template:
    src: templates/client.cnf.j2
    dest: /etc/mysql/client.cnf
    mode: '0644'

- name: Initialize mysql
  when: (ansible_distribution == 'Alpine' or ansible_distribution == 'Archlinux')
  mysql_db:
    name: mysql
    state: present

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    content: "{{ lookup('file', 'templates/my.cnf') }}"
    dest: /etc/mysql/my.cnf
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases | difference(mysql_databases_initial_import) }}"

- name: List databases
  mysql_db:
    name: "{{ item.name }}"
    state: list
  loop: "{{ mysql_databases }}"

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    src: "{{ item.file }}"
  loop: "{{ mysql_databases_initial_import }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    priv: "{{ item.privileges }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers
  meta: flush_handlers

- name: Flush handlers again
  meta: flush_handlers

