      file:
        path: /etc/rancher/rke2/etcd-snapshot
        state: directory
    - name: Copy the etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /etc/rancher/rke2/etcd-snapshot/snapshot.db
    - name: Restore etcd from the snapshot file
      command: rke2 etcd restore /etc/rancher/rke2/etcd-snapshot/snapshot.db
  when: do_etcd_restore

- name: Restore etcd from s3
  block:
    - name: Restore etcd from an S3 snapshot
      command: rke2 etcd restore-s3 --access-key="{{ rke2_etcd_snapshot_s3_options.access_key }}" --secret-key="{{ rke2_etcd_snapshot_s3_options.secret_key }}" --bucket="{{ rke2_etcd_snapshot_s3_options.bucket }}" --snapshot-name="{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: yes
  when: inventory_hostname in groups('rke2_cluster_group_name') and inventory_hostname == groups('rke2_cluster_group_name')[0]

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: masked
  when: inventory_hostname in groups('rke2_cluster_group_name') and inventory_hostname == groups('rke2_cluster_group_name')[0]

- name: Wait for the first server be ready - no CNI
  wait_for:
    host: "{{ inventory_hostname }}"
    state: started
    delay: 10
  when: inventory_hostname in groups('rke2_cluster_group_name') and inventory_hostname == groups('rke2_cluster_group_name')[0]

- name: Wait for the first server be ready - with CNI
  wait_for:
