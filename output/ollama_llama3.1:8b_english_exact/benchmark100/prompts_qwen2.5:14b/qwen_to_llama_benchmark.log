---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
    notify: selinux_facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when: (not selinux_enabled) or (selinux_enabled and selinux_connection_type == 'remote')
  block:
    - name: Manage selinux
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: selinux_reboot

    - name: Manage selinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        loop_var: item

