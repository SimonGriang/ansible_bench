content='---\n\n\n- name: Check if the system is EFI\n  stat:\n    path: /sys/firmware/efi/efivars\n  register: efi\n\n- name: Remove the grub.cfg file if the system is EFI\n  file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: efi.stat.exists == true\n\n- name: Install a user template for GRUB\n  template:\n    src: templates/01_users\n    dest: /etc/grub.d/01_users\n    mode: \'0700\'\n  notify: grub_update\n\n- name: Add a password to the EFI GRUB configuration\n  lineinfile:\n    dest: /etc/grub2-efi.cfg\n    line: "password --reuse=superusers"\n  notify: grub_update\n\n- name: Add a password to the MBR GRUB configuration\n  lineinfile:\n    dest: /etc/grub2.cfg\n    line: "password --reuse=superusers"\n  notify: grub_update\n\n- name: Add --unrestricted option to specified files\n  replace:\n    path: \'{{ item }}\'\n    content: \'{{ item | replace("CLASS=", "CLASS= --unrestricted") }}\'\n  with_items: \'{{ grub_password_unrestricted_files }}\'\n  when: grub_password_unrestricted == true\n  notify: grub_update' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-18T19:01:07.898903812Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3165753987, 'load_duration': 102916571, 'prompt_eval_count': 556, 'prompt_eval_duration': 163591921, 'eval_count': 288, 'eval_duration': 2898561069, 'model_name': 'llama3.1:8b'} id='run--e54ee207-2dbe-4f30-aedb-ee5daff36cb4-0' usage_metadata={'input_tokens': 556, 'output_tokens': 288, 'total_tokens': 844}
