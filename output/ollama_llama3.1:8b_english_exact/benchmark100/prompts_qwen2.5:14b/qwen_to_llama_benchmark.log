---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  become: true
  template:
    src: templates/main_mailer_type.conf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - reload postfix

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when:
    postfix_virtual_mailbox_maps is defined or postfix_virtual_mailbox_domains is defined or postfix_virtual_alias_maps is defined

- name: Configure postfix (transport_maps)
  template:
    src: templates/transport_maps.j2
    dest: /etc/postfix/transport
    mode: '0644'
  notify:
    - reload postfix
  when: postfix_virtual_mailbox_maps is defined

- name: Configure postfix (header_checks)
  template:
    src: templates/header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
    - reload postfix
  when: postfix_virtual_mailbox_maps is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    smtpd_recipient_restrictions: 'reject_non_fqdn_recipient reject_unknown_recipient_domain permit_mynetworks'
    smtpd_sender_restrictions: 'reject_non_fqdn_sender reject_unknown_sender_domain'
  when:
    postfix_virtual_alias_maps is defined and postfix_virtual_mailbox_domains is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    mynetworks: "{{ postfix_mynetworks | default('127.0.0.0/8, ::ffff:127.0.0.0/104') }}"
    mydestination: "{{ postfix_mydestination | default('localhost') }}"
    relay_domains: "{{ postfix_relay_domains | default('') }}"
    smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions | default('reject_non_fqdn_recipient reject_unknown_recipient_domain permit_mynetworks') }}"
    smtpd_sender_restrictions: "{{ smtpd_sender_restrictions | default('reject_non_fqdn_sender reject_unknown_sender_domain') }}"
    virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default('') }}"
    virtual_alias_domains: "{{ postfix_virtual_alias_maps | default('') }}"
  when:
    postfix_virtual_alias_maps is defined and postfix_virtual_mailbox_domains is defined

- name: Configure postfix (main.cf)
  template:
    src: templates/main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - restart postfix
  when: postfix_virtual_alias_maps is defined

- name: Configure postfix (master.cf)
  template:
    src: templates/master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - restart postfix
  when: postfix_virtual_alias_maps is defined

- name: Creates cert/key directory
  file:
    path: "{{ postfix_smtpd_tls_cert_file | dirname }}"
    state: directory
    mode: '0755'
  notify: always

- name: Deploy Postfix TLS server certificate
  copy:
    content: "{{ lookup('file', postfix_smtpd_tls_cert_file) }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0644'
  notify:
    - reload postfix

- name: Deploy Postfix TLS server key
  copy:
    content: "{{ lookup('file', postfix_smtpd_tls_key_file) }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0644'
  notify:
    - reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: templates/aliases.j2
    dest: /etc/aliases
    mode: '0644'
  notify:
    - rebuild_alias_database
    - reload postfix
  when: postfix_virtual_mailbox_maps is defined

- name: Configure sender_access
  template:
    src: templates/sender_access.j2
    dest: /etc/postfix/sender_access
    mode: '0644'
  notify:
    - rebuild_sender_access_database
    - reload postfix
  when: postfix_virtual_mailbox_maps is defined

- name: Configure recipient_access
  template:
    src: templates/recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: '0644'
  notify:
    - rebuild_recipient_access_database
    - reload postfix
  when: postfix_virtual_mailbox_maps is defined

- name: Place sasl_password_map
  template:
    src: templates/sasl_password_map.j2
    dest: /etc/postfix/sasl_password_map
    mode: '0644'
  notify:
    - rebuild_sasl_password_map_database
    - reload postfix
  when: postfix_virtual_mailbox_maps is defined

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true
