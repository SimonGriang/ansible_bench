    loop_var: item

- name: Create data directory
  file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_data_directories }}"
  loop_control:
    loop_var: item

- name: Generate TLS key and certificate
  openssl_certificate:
    path: "{{ vault_data_directory }}/tls/{{ vault_data_directory }}/tls.crt"
    key_path: "{{ vault_data_directory }}/tls/{{ vault_data_directory }}/tls.key"
    state: present
    validate_certs: no
    days: 1095
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item.path }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    state: file
  loop: "{{ vault_tls_files }}"
  loop_control:
    loop_var: item

- name: Copy Vault binary
  copy:
    content: "{{ lookup('file', '{{ vault_download_path }}/vault') }}"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  file:
    path: "{{ vault_path }}/usr/bin/vault"
    state: file
    follow: no
    mode: '0755'
    selevel: system_u
    seuser: system_u
    selabel: system_u:object_r:bin_t:s0
  attributes:
    cap_ipc_lock: ep

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    mode: '0644'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'

- name: Copy Vault service file
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: '0644'
  notify:
    - Daemon reload
  when: ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian'

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: '0644'
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers

