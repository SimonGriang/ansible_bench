---
- name: Task 1 - Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /path/to/python3.11/EXTERNALLY-MANAGED
  register: python3_11_file

- name: Task 2 - Rename python3.11 EXTERNALLY-MANAGED file if it exists
  file:
    src: /path/to/python3.11/EXTERNALLY-MANAGED
    dest: /path/to/python3.11/EXTERNALLY-MANAGED.old
  when: python3_11_file.stat.exists

- name: Task 3 - Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /path/to/python3.12/EXTERNALLY-MANAGED
  register: python3_12_file

- name: Task 4 - Rename python3.12 EXTERNALLY-MANAGED file if it exists
  file:
    src: /path/to/python3.12/EXTERNALLY-MANAGED
    dest: /path/to/python3.12/EXTERNALLY-MANAGED.old
  when: python3_12_file.stat.exists

- name: Task 5 - Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost

- name: Task 6 - Install python pip
  apt:
    name: python3-pip
    state: present
  when: python_pip_packages is defined | bool

- name: Task 7 - Configure pip proxy
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
  when: python_pip_proxy is defined

- name: Task 8 - Trust hosts
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
  when: python_pip_trusted_host is defined

- name: Task 9 - Update pip
  pip:
    name: pip
    update: yes
    extra_args: "{{ python_pip_update }}"
  when:
    - python_pip_update is defined
    - ansible_distribution not in ['bookworm', 'noble']
    - ansible_distribution not in ['Alpine']

- name: Task 10 - Install requested modules
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when:
    - python_pip_modules is defined
    - ansible_distribution not in ['bookworm', 'noble']
    - ansible_distribution not in ['Alpine']

