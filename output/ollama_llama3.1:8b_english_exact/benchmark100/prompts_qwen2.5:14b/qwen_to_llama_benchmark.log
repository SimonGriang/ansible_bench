---
- name: Install and configure OpenSSL
  tasks:
  - name: Check if python is installed
    command: python --version
    register: python_installed
    failed_when: python_installed.stderr != ''

  - name: Check if python3 is installed
    command: python3 --version
    register: python3_installed
    failed_when: python3_installed.stderr != ''

  - name: Debug Python executable path
    command: command="which python" shell=True
    register: python_path
    debug: var=python_path

  - name: Debug Python3 executable path
    command: command="which python3" shell=True
    register: python3_path
    debug: var=python3_path

  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install requirements
    pip:
      requirements: openssl_requirements

  - name: Ensure packaging is available via dnf
    dnf:
      name: python3-packaging
      state: present

  - name: Install pip packages
    pip:
      name: "{{ item }}"
      state: present
    loop: "{{ openssl_pip_packages }}"

  - name: Create key directory
    file:
      path: /etc/openssl/keys
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Create csr directory
    file:
      path: /etc/openssl/csr
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Create crt directory
    file:
      path: /etc/openssl/crt
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Include create.yml
    include_tasks: create.yml


