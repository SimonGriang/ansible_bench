---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml

- name: Task 2 - Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Task 3 - Configure shell
  lineinfile:
    dest: /etc/crontab
    line: SHELL=/bin/bash
    state: present
  notify: restart cron

- name: Task 4 - Configure path
  lineinfile:
    dest: /etc/crontab
    line: PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    state: present
  notify: restart cron

- name: Task 5 - Configure mailto
  lineinfile:
    dest: /etc/crontab
    line: MAILTO=root
    state: present
  notify: restart cron

- name: Task 6 - Start and enable cron
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ''

- name: Task 7 - Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    day_of_week: "{{ item.day_of_week }}"
    job: "{{ item.job }}"
    state: "{{ item.state }}"
  loop: "{{ cron_jobs }}"


