---
- name: Create document root directories for each virtual host
  become: yes
  block:
    - name: Create document root directory if specified and create_docroot is True or not set
      file:
        path: "{{ item.directory }}"
        state: directory
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: '0755'
      loop: "{{ httpd_vhosts }}"
      when: item.create_docroot | default(false) or item.create_docroot is not defined

- name: Create virtual host configuration files
  become: yes
  block:
    - name: Create vhost.conf file for each virtual host
      template:
        src: vhost_conf_template
        dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: '0644'
      loop: "{{ httpd_vhosts }}"
      notify:
        - test_apache_config
        - restart_apache

- name: Enable virtual hosts on Debian-based systems
  become: yes
  block:
    - name: Enable site for each virtual host on Debian
      apt:
        name: apache2
        state: present
      when: ansible_os_family == 'Debian'
    - name: Enable site for each virtual host
      command:
        cmd: a2ensite {{ item.name }}
        creates: "{{ item.directory }}/{{ item.name }}.conf"
      loop: "{{ httpd_vhosts }}"
      notify:
        - test_apache_config
        - restart_apache


