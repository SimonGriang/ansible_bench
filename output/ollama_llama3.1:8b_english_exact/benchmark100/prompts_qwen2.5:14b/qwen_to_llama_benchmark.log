---
- name: Apache Configuration Tasks
  hosts: localhost

  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install apache httpd
    package:
      name: "{{ httpd_packages }}"
      state: present

  - name: Configure selinux
    selinux:
      http_port_t: true
      status: true
      set_root_only: false
      policy: targeted

  - name: Configure httpd
    template:
      src: src/main.conf.j2
      dest: /etc/httpd/conf.d/main.conf
      mode: '0644'
    notify: restart httpd

  - name: Activate httpd module | Debian
    service:
      name: apache2
      state: started
      enabled: true
    when: ansible_distribution == 'Debian'
    notify: restart apache2

  - name: Import ssl.yml
    include_tasks: ssl.yml
    when: apache_ssl

  - name: Import locations.yml
    include_tasks: locations.yml
    when: httpd_locations

  - name: Import vhosts.yml
    include_tasks: vhosts.yml
    when: httpd_vhosts

  - name: Configure ports
    template:
      src: src/ports.conf.j2
      dest: /etc/httpd/conf.d/ports.conf
      mode: '0644'
    when: (ansible_distribution == 'Debian' or ansible_distribution == 'Suse')
    notify: restart httpd

  - name: Import directories.yml
    include_tasks: directories.yml
    when: httpd_directories

  - name: Flush handlers
    meta: flush_handlers

  - name: Removing default html
    file:
      path: /var/www/html/index.html
      state: absent
    when: httpd_remove_example

  - name: Start and enable httpd
    service:
      name: httpd
      state: started
      enabled: true


