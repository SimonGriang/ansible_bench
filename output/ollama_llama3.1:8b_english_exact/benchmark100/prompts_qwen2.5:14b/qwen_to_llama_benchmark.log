  when:
    - git_repositories is defined
    - git_user_exists is defined

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}/{{ item.repo | basename }}"
    version: "{{ item.version }}"
    clone: yes
    dest_dir: "{{ repository_destination }}"
  loop: "{{ git_repositories }}"
  loop_control:
    loop_var: item
  when:
