---
- name: Install and configure docker-compose
  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install docker-compose package
    package:
      name: docker-compose
      state: present
    when: installation_type == "package"

  - name: Install docker-compose as a binary
    apt:
      name: docker-compose
      state: present
    become: true
    when: installation_type == "binary"

  - name: Download binary
    get_url:
      url: https://github.com/docker/compose/releases/download/1.29.2/docker-compose-linux-x86_64
      dest: /usr/local/bin/docker-compose
      mode: '0755'
    when: installation_type == "binary"

  - name: Make the binary executable
    file:
      path: /usr/local/bin/docker-compose
      mode: '0755'
    when: installation_type == "binary"


