---
- name: Tasks
  tasks:
  - name: Assert usage of systemd
    assert:
      that: "'systemd' in ansible_distribution"
      msg: "System uses non-systemd init system"
  - name: Get latest release of promtail
    uri:
      url: "https://api.github.com/repos/grafana/loki/releases/latest"
      return_content: true
    register: release_info
  - name: Set promtail version from latest release
    set_fact:
      promtail_version: "{{ release_info.json.tag_name }}"
  - name: Test if zip local archive exists
    stat:
      path: "/path/to/promtail-{{ promtail_version }}-linux-{{ go_arch }}.zip"
    register: zip_local_archive
  - name: Assert local binary exists
    assert:
      that: "promtail_binary_local_dir is defined"
      msg: "Local binary not installed"
  - name: Get checksum list
    uri:
      url: "https://api.github.com/repos/grafana/loki/releases/latest"
      return_content: true
    register: release_info
  - name: Extract checksum for specific architecture
    set_fact:
      checksum_list: "{{ release_info.json.assets | json_query(' [*].browser_download_url | select(@.contains(\"{{ go_arch }}\")') | [0] }}"
  - name: Get checksum for specific architecture
    uri:
      url: "{{ checksum_list }}"
      return_content: true
    register: checksum_info
  - name: Set promtail checksum
    set_fact:
      promtail_checksum: "{{ checksum_info.content | trim }}"

Note: You should replace "/path/to/promtail-{{ promtail_version }}-linux-{{ go_arch }}.zip" with the actual path to the zip archive.

