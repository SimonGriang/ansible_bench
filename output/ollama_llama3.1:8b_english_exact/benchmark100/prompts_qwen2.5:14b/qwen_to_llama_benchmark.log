---
- name: Cleanup Docker and prepare for installation
  hosts: 
  tasks:
  - name: Remove the Docker apt key from the trusted.gpg.d directory
    apt_key:
      keyserver: keyserver.ubuntu.com
      state: absent
      key: 9DC8AB623FDCC37D

  - name: Remove the old Docker source list file from the sources.list.d directory
    file:
      path: /etc/apt/sources.list.d/docker.list
      state: absent

  - name: Uninstall any old versions of Docker that may be installed on the system
    apt:
      name: docker
      state: absent
      purge: yes

  - name: Remove the legacy Docker repository file if it exists
    file:
      path: /etc/apt/sources.list.d/docker.list
      state: absent

  - name: Install necessary dependencies for Docker
    apt:
      name:
        - apt-transport-https
        - ca-certificates
        - python3-debian
      state: present

  - name: Add or remove the Docker repository based on the variable docker_add_repo
    apt_repository:
      repo: 'https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable'
      state: present
      update_cache: yes
    notify: apt update

  - name: Flush handlers to ensure the apt cache is updated immediately after making changes to the Docker repository
    meta:
      flush_handlers: yes


