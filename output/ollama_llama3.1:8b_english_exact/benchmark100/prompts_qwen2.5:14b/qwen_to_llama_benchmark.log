---
- name: Configure and Initialize MySQL
  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install mysql
    yum:
      name: "{{ item }}"
      state: present
    loop: "{{ mysql_packages }}"
    notify: ['Set root password', 'Systemctl daemon-reexec']

  - name: Configure mysql server
    template:
      src: mysql-server.cnf.j2
      dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
      mode: '0644'
    notify: Restart mysql server

  - name: Configure mysql client
    template:
      src: mysql-client.cnf.j2
      dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
      mode: '0644'

  - name: Initialize mysql
    command: "{{ mysql_initialize_command }}"
    when: ansible_distribution in ['Alpine', 'Archlinux']

  - name: Start and enable mysql
    service:
      name: mysql
      state: started
      enabled: yes

  - name: Flush handlers
    meta: flush_handlers

  - name: Place my.cnf
    template:
      src: my.cnf.j2
      dest: /root/.my.cnf
      mode: '0600'

  - name: Create databases
    mysql_db:
      name: "{{ item }}"
      state: present
