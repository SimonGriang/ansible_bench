---
- name: Configure RKE2
  become: yes
  tasks:
  - name: Create the RKE2 config directory
    file:
      path: /etc/rke2
      state: directory

  - name: Set server taints
    kubernetes:
      state: present
      definition:
        apiVersion: v1
        kind: Node
        metadata:
          name: "{{ inventory_hostname }}"
        spec:
          taints:
          - key: rke2_type
            value: server
            effect: NoSchedule

  - name: Set agent taints
    kubernetes:
      state: present
      definition:
        apiVersion: v1
        kind: Node
        metadata:
          name: "{{ inventory_hostname }}"
        spec:
          taints:
          - key: rke2_type
            value: agent
            effect: NoSchedule

  - name: Copy RKE2 config file
    copy:
      content: "{{ lookup('file', '/path/to/rke2-config') }}"
      dest: /etc/rke2/config.yaml
      mode: '0644'
    notify:
      - restart rke2

  - name: Copy kubelet config file
    copy:
      content: "{{ lookup('file', '/path/to/kubelet-config') }}"
      dest: /etc/kubelet/config.yaml
      mode: '0644'
      when: rke2_type == 'server'
    notify:
      - restart kubelet

  - name: Copy Containerd Registry Configuration file
    copy:
      content: "{{ lookup('file', '/path/to/containerd-registry-config') }}"
      dest: /etc/containerd/config.toml
      mode: '0644'
      when: rke2_type == 'server' and containerd_registry_enabled == true
    notify:
      - restart containerd

  - name: Start RKE2 service
    service:
      name: rke2
      state: started
      enabled: yes
    retries: 10
    retry_delay: 5
    notify:
      - restart rke2

  - name: Mask other RKE2 services
    service:
      name: "{{ item }}"
      state: masked
    with_items:
      - rke2-external-dns
      - rke2-external-dns-default
    when: rke2_type == 'server'

  - name: Wait for remaining nodes to be ready - no CNI
    kubernetes:
      state: present
      definition:
        apiVersion: v1
        kind: Node
        metadata:
          name: "{{ inventory_hostname }}"
        spec:
          condition:
            status: "Ready"
          cni: no
    retries: 10
    retry_delay: 5
    until: kubernetes_node_statusReady condition is met

  - name: Wait for remaining nodes to be ready - with CNI
    kubernetes:
      state: present
      definition:
        apiVersion: v1
        kind: Node
        metadata:
          name: "{{ inventory_hostname }}"
        spec:
          condition:
            status: "Ready"
          cni: yes
    retries: 10
