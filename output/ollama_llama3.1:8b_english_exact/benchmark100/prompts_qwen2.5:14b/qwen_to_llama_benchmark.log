---
- name: Update apt cache
  apt:
    cache_valid_time: 0

- name: Update dnf cache
  dnf:
    cache: yes
    update_cache: yes

- name: Install packages
  package:
    name: keepalived
    state: present

- name: Create directory for keepalived
  file:
    path: /etc/keepalived
    state: directory
    mode: '0755'

- name: Create Kubernetes API health check script for Debian OS family
  template:
    src: templates/kubernetes_api_healthcheck.sh.j2
    dest: /etc/keepalived/kubernetes_api_healthcheck.sh
    mode: '0755'
  notify: restart keepalived

- name: Create Kubernetes API healthcheck script for RedHat OS family
  template:
    src: templates/kubernetes_api_healthcheck.sh.j2
    dest: /etc/keepalived/kubernetes_api_healthcheck.sh
    mode: '0755'
  notify: restart keepalived

- name: Create RKE2 Server health check script for Debian OS family
  template:
    src: templates/rke2_server_healthcheck.sh.j2
    dest: /etc/keepalived/rke2_server_healthcheck.sh
    mode: '0755'
  notify: restart keepalived

- name: Create RKE2 Server health check script for RedHat OS family
  template:
    src: templates/rke2_server_healthcheck.sh.j2
    dest: /etc/keepalived/rke2_server_healthcheck.sh
    mode: '0755'
  notify: restart keepalived

- name: Create keepalived config file
  template:
    src: templates/keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    mode: '0644'
  notify: restart keepalived

- name: Enable keepalived and make sure it is not masked
  service:
    name: keepalived
    enabled: yes
    masked: no
  notify: restart keepalived

- name: Flush handlers
  meta: flush_handlers

