---
- name: Configure Helm
  hosts: localhost

  tasks:
  - name: Check if Helm binary exists
    stat:
      path: /usr/local/bin/helm
    register: helm_exists

  - name: Check Helm version
    shell: helm version
    when: helm_exists.stat.exists
    register: helm_version
    failed_when: helm_version.stdout != "Client version: {{ lookup('env', 'Helm_VERSION') }}"

  - name: Download helm
    get_url:
      url: https://get.helm.sh/helm-v{{ lookup('env', 'Helm_VERSION') }}-linux-amd64.tar.gz
      dest: /tmp/helm.tar.gz
      mode: '0644'
    when: not helm_exists.stat.exists or helm_version.stdout != "Client version: {{ lookup('env', 'Helm_VERSION') }}"

  - name: Copy helm binary into place
    copy:
      content: "{{ lookup('file', '/tmp/helm.tar.gz') }} | tar xz --strip-components=1 -f {{ item.name }} --directory=/usr/local/bin/"
      dest: /usr/local/bin/helm
      mode: '0755'
    when: not helm_exists.stat.exists or helm_version.stdout != "Client version: {{ lookup('env', 'Helm_VERSION') }}"

