---
- name: Configure Apache HTTPD
  hosts: localhost

  tasks:
  - include: assert.yml

  - name: Install apache httpd
    package:
      name: "{{ httpd_packages }}"

  - name: Configure selinux
    selinux:
      state: "{{ selinux_state }}"
    when: selinux_enabled
    notify:
      - selinux_handlers

  - name: Configure httpd
    template:
      src: "{{ httpd_config_src }}"
      dest: "{{ httpd_config_dest }}"
      mode: '0644'
    notify:
      - httpd_handlers

  - name: Activate httpd module | Debian
    command: a2enmod {{ item }}
    notify: httpd_handlers
    with_items:
      - {{ httpd_modules }}
    when: ansible_distribution == 'Debian'

  - include: ssl.yml
    when: https_ssl_enable

  - include: locations.yml
    when: httpd_locations is defined

  - include: vhosts.yml
    when: httpd_vhosts is defined

  - name: Configure ports
    template:
      src: "{{ httpd_ports_src }}"
      dest: "{{ httpd_ports_dest }}"
      mode: '0644'
    notify:
      - httpd_handlers
    when: ansible_distribution in ['Debian', 'Suse']

  - include: directories.yml
    when: httpd_directories is defined

  - meta: flush_handlers

  - name: Removing default html
    file:
      path: "{{ httpd_data_dir }}/index.html"
      state: absent
    when: httpd_remove_example

  - name: Start and enable httpd
    service:
      name: httpd
      state: started
      enabled: yes


