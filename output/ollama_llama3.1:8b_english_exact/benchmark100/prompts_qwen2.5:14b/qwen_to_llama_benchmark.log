---
- name: Bootstrap tasks
  hosts: localhost
  gather_facts: no

  tasks:
    - name: Import assert.yml
      import_tasks: assert.yml

    - name: Wait for port to be available
      wait_for:
        host: localhost
        port: 22
        timeout: "{{ bootstrap_timeout }}"

    - name: Prepare system
      connection: local
      become: false
      raw: "test -x /usr/bin/python || (yum -y install python && yum -y install sudo)"
      changed_when: False
      when: ansible_connection == 'ssh' and ansible_user != 'root'

    - name: Gather ansible facts
      setup: {}

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      notify: bootstrap facts updated


