---

- name: Create etcd group
  group:
    name: etcd
    state: present

- name: Create etcd user
  user:
    name: etcd
    comment: etcd user
    group: etcd
    shell: /bin/nologin
    state: present

- name: Copy systemctl config file for kernel hardening
  template:
    src: "{{ '/usr/local/share/rke2/rke2-cis-sysctl.conf' if '/usr/local' is writable else '/opt/rke2/share/rke2/rke2-cis-sysctl.conf' }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: '0600'
  notify: restart systemd-sysctl

- name: Copy systemctl config file for kernel hardening (partition check)
  shell:
    cmd: |
      if [ ! -d /sysroot ]; then echo "Error: The system root is not mounted"; exit 1; fi
  when: "'/sysroot' in ansible_distribution"

- name: Copy systemctl config file for kernel hardening (partition check)
  shell:
    cmd: |
      if [ ! -d /sysroot ]; then echo "Error: The system root is not mounted"; exit 1; fi
  when: "'/sysroot' not in ansible_distribution"

- name: Flush handlers
  meta:
    flush_handlers: yes

