--- 

- name: Download RKE2 kubeconfig to localhost
  block:
  - name: Download RKE2 kubeconfig
    get_url:
      url: "http://{{ inventory_hostname }}:{{ rke2_server_port }}/v1/kubeconfig"
      dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
      mode: '0644'
    when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]
  - name: Wait for download
    pause:
      prompt: "Waiting for download to complete"

- name: Replace loopback IP by master server IP
  block:
  - name: Replace loopback IP with master server IP
    replace:
      path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
      regexp: '(127\.0\.0\.1|::1)'
      replace: "{{ rke2_api_ip | default(inventory_hostname | ip_addr('primary')) }}"
    when: not check_mode and rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]

