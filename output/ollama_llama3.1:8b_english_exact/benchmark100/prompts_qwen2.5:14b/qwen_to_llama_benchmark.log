---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install php
  apt:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  shell: php -r "echo ini_get('error_log');"
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.result) }}"
    mode: '0644'
  notify: restart httpd

