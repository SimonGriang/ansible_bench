---
- name: Gather facts and set bootstrap facts
  hosts: 
  gather_facts: True

  tasks:
  - name: Gather facts
    setup:

  - name: Set bootstrap facts (I)
    set_fact:
      distribution_name: "{{ ansible_distribution | lower }}"
      major_version: ""
    when: distribution_name is not undefined
    loop: "{{ bootstrap_os_family_map }}"
    loop_control:
      loop_var: item
    when: distribution_name is not undefined

