---

- name: Install Java
  hosts: 
  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install requirements
    package:
      name: bash
      state: present

  - name: Install openjdk java (package)
    package:
      name: "{{ java_vendor }}"
      state: present
    when: java_vendor == "openjdk"

  - name: Install RPM
    package:
      name: "{{ java_rpm }}"
      state: present
    when: java_rpm is defined

  - name: Install DEB
    package:
      name: "{{ java_deb }}"
      state: present
    when: java_deb is defined

  - name: Install oracle java (rpm) (repository)
    package:
      name: "{{ java_rpm_repo }}"
      state: present
    when: java_rpm_repo is defined

  - name: Configure oracle targz
    unarchive:
      src: "{{ java_targz }}"
      dest: "{{ java_targz_install_dir }}"
      compression: tar
    become: yes

  - name: Ensure installation directory
    file:
      path: "{{ java_targz_install_dir }}"
      state: directory
      mode: '0755'
    become: yes

  - name: Install oracle java policy software (targz)
    unarchive:
      src: "{{ java_policy_targz }}"
      dest: "{{ java_targz_install_dir }}"
      compression: tar
    become: yes

  - name: Set alternative (targz)
    alternatives:
      name: java
      path: "{{ java_targz_install_dir }}/bin/java"
      state: present
    when: java_targz_install_dir is defined and ansible_distribution != 'Alpine Linux'

  - name: Find JAVA_HOME
    shell:
      cmd: readlink -f /usr/bin/java
    register: java_link

  - name: Set JAVA_HOME in /etc/environment
    lineinfile:
      path: /etc/environment
      line: "JAVA_HOME={{ java_link.path | dirname }}"
      state: present

