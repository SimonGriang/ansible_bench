- name: Import assert.yml
  include_tasks: assert.yml

- name: Configure apk
  package_manager:
    name: apk
    update_cache: yes
    upgrade: yes
  notify:
    - reboot

- name: Configure apt
  apt:
    package_blacklist:
      - package1
      - package2
    update_cache: yes
    upgrade: yes
    autoremove: yes
  notify:
    - reboot

- name: Update all software (dnf)
  dnf:
    autorefresh: yes
    exclude:
      - package1
      - package2
    state: latest
  notify:
    - reboot

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes
  notify:
    - reboot

- name: Configure yum
  yum:
    update_cache: yes
    upgrade: yes
  yum_utils_install: yes
  notify:
    - reboot

- name: Update all software (zypper)
  zypper:
    update: yes
    full_update: yes
  notify:
    - reboot

