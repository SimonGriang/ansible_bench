---

- name: Create ssl key
  file:
    path: "/path/to/ssl/key/{{ inventory_hostname }}.key"
    state: touch
    mode: '0600'
  become: yes
  become_user: root

- name: Create ssl csr
  openssl_csr:
    path: "/path/to/ssl/key/{{ inventory_hostname }}.csr"
    privatekey_path: "/path/to/ssl/key/{{ inventory_hostname }}.key"
    csr_path: "/path/to/ssl/key/{{ inventory_hostname }}.csr"
    common_name: "{{ inventory_hostname }}"
  become: yes
  become_user: root

- name: Create ssl certificates
  openssl_csr:
    path: "/path/to/ssl/key/{{ inventory_hostname }}.csr"
    privatekey_path: "/path/to/ssl/key/{{ inventory_hostname }}.key"
    csr_path: "/path/to/ssl/key/{{ inventory_hostname }}.csr"
    certificate_path: "/path/to/ssl/key/{{ inventory_hostname }}.crt"
    csr_extensions:
      - "subjectAltName=DNS:{{ inventory_hostname }}"
  become: yes
  become_user: root

- name: Create PKCS#12 file
  openssl_pkcs12:
    src: "/path/to/ssl/key/{{ inventory_hostname }}.key"
    dest: "/path/to/ssl/key/{{ inventory_hostname }}.p12"
    cert: "/path/to/ssl/key/{{ inventory_hostname }}.crt"
    passphrase: "{{ inventory_hostname }}"
  become: yes
  become_user: root

- name: Read private key
  slurp:
    src: "/path/to/ssl/key/{{ inventory_hostname }}.key"
  register: ssl_key

- name: Read certificate
  slurp:
    src: "/path/to/ssl/key/{{ inventory_hostname }}.crt"
  register: ssl_cert

- name: Create combined private_key and certificate file
  file:
    path: "/path/to/ssl/key/{{ inventory_hostname }}.combined"
    state: touch
  become: yes
  become_user: root

  copy:
    content: "{{ ssl_key.content }}\n{{ ssl_cert.content }}"
    dest: "/path/to/ssl/key/{{ inventory_hostname }}.combined"
    mode: '0600'
  become: yes
  become_user: root

