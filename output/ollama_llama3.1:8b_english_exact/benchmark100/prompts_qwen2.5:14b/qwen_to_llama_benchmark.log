          mode: '0644'
          force: yes
      when:
        rke2_airgap_mode == 'download' and rke2_airgap_implementation == 'copy'

  - name: Copy local RKE2 artifacts
    copy:
      content: "{{ lookup('file', '/tmp/rke2-artifacts.tar.gz') }}"
      dest: /tmp/rke2-artifacts.tar.gz
      mode: '0640'
      force: yes
    when:
      rke2_airgap_mode == 'download' and rke2_airgap_implementation == 'copy'

  - name: Airgap mode - additional images tarballs
    file:
      path: /tmp/rke2-images
