content='---\n\n\n- name: Create local ssh_key_directory for {{ user.name }}\n  file:\n    path: /home/{{ user.name }}/.ssh\n    mode: \'0750\'\n    owner: {{ user.name }}\n    group: {{ user.name }}\n    state: directory\n  when: user.manage_ssh_key == true\n  become: false\n\n\n- name: Manage user {{ user.name }}\n  user:\n    name: "{{ user.name }}"\n    password: "{{ user.password }}"\n    comment: "{{ user.comment }}"\n    create_home: true\n    home: "{{ user.home }}"\n    group: "{{ user.group }}"\n    append: "{{ user.append }}"\n    update_password: "{{ user.update_password }}"\n    state: "{{ user.state }}"\n    groups: "{{ user.groups }}"\n    sudo: "{{ user.sudo }}"\n    sudo_flags: "{{ user.sudo_flags }}"\n  when: user.state == "present" or user.update_password == "always"\n\n\n- name: Set sudo options for {{ user.name }}\n  template:\n    src: templates/sudoers.d/{{ user.name }}.j2\n    dest: /etc/sudoers.d/{{ user.name }}\n    mode: \'0640\'\n    group: root\n    owner: root\n    validate: /usr/sbin/visudo --check\n  when: user.sudo == true\n\n\n- name: Remove sudo options for {{ user.name }}\n  file:\n    path: /etc/sudoers.d/{{ user.name }}\n    state: absent\n  when: user.sudo == false or user.sudo is undefined\n\n\n- name: Generate private ssh key for {{ user.name }}\n  ssh_keyscan:\n    name: "{{ user.name }}"\n    state: present\n    type: rsa\n    path: /home/{{ user.name }}/.ssh/{{ user.name }}_id_rsa\n  when: user.manage_ssh_key == true\n  become: false\n\n\n- name: Generate public ssh key for {{ user.name }}\n  ssh_keyscan:\n    name: "{{ user.name }}"\n    state: present\n    type: rsa\n    path: /home/{{ user.name }}/.ssh/{{ user.name }}_id_rsa.pub\n  when: user.manage_ssh_key == true\n  become: false\n\n\n- name: Convert ssh key to ppk for {{ user.name }}\n  ssh_keyscan:\n    name: "{{ user.name }}"\n    state: present\n    type: rsa\n    path: /home/{{ user.name }}/.ssh/{{ user.name }}_id_rsa.ppk\n  when: user.manage_ssh_key == true\n  become: false\n\n\n- name: Get or set the home directory for {{ user.name }}\n  file:\n    path: "{{ user.home }}"\n    state: present\n    recurse: true\n  when: user.home is defined or user.home is not undefined\n  become: false\n\n\n- name: Create .ssh directory for {{ user.name }}\n  file:\n    path: "{{ user.home }}/.ssh"\n    state: present\n    recurse: true\n  when: user.manage_ssh_key == true or user.private_keys is defined\n  become: true\n\n\n- name: Deploy authorized keys for {{ user.name }}\n  authorized_key:\n    user: "{{ user.name }}"\n    key: "{{ user.authorized_keys }}"\n    state: present\n  when: user.authorized_keys is defined\n\n\n- name: Remove unauthorized keys for {{ user.name }}\n  authorized_key:\n    user: "{{ user.name }}"\n    key: "{{ user.unauthorized_keys }}"\n    state: absent\n  when: user.unauthorized_keys is defined\n\n\n- name: Copy generated private ssh key for {{ user.name }}\n  copy:\n    content: "{{ lookup(\'file\', \'/home/{{ user.name }}/.ssh/{{ user.name }}_id_rsa\') }}"\n    dest: "{{ user.home }}/.ssh/{{ user.name }}_id_rsa"\n    mode: \'0600\'\n  when: user.copy_private_key == true\n  become: false\n\n\n- name: Check users password valid time for {{ user.name }}\n  shell:\n    cmd: "chage -l {{ user.name }}"\n    register: user_password_validity\n  when: user.password_validity_days is defined or user.password_validity_days is not undefined\n  become: false\n\n\n- name: Set users password valid time for {{ user.name }}\n  shell:\n    cmd: "chage -l {{ user.name }}"\n    register: user_password_validity\n  when: user.password_validity_days is defined and user_password_validity.stdout != "Maximum number of days between password change" and user_password_validity.stdout != "Minimum number of days between password change"\n  become: false\n\n\n- name: Place private key file for {{ user.name }}\n  copy:\n    content: "{{ lookup(\'file\', \'/home/{{ user.name }}/.ssh/{{ user.name }}_id_rsa\') }}"\n    dest: "{{ user.home }}/.ssh/{{ user.name }}_id_rsa"\n    mode: \'0600\'\n  when: user.private_keys is defined\n  become: false' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-18T19:31:05.72032093Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10126698779, 'load_duration': 104341582, 'prompt_eval_count': 950, 'prompt_eval_duration': 144801987, 'eval_count': 1029, 'eval_duration': 9876935135, 'model_name': 'llama3.1:8b'} id='run--16fd352d-943c-4623-ba8e-1f6a29e6d077-0' usage_metadata={'input_tokens': 950, 'output_tokens': 1029, 'total_tokens': 1979}
