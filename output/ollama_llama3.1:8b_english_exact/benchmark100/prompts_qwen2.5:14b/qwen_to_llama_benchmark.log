content='--- \n\n- name: Import assert.yml\n  include_tasks: assert.yml\n  run_once: true\n  delegate_to: localhost\n\n- name: Install prerequisites\n  package:\n    name: "{{ vault_prerequisites }}"\n    state: present\n\n- name: Include installation method specific tasks\n  include_tasks: "{{ vault_installation_method }}.yml"\n\n- name: Add Vault environment variables\n  lineinfile:\n    dest: /etc/vault.d/vault.env\n    line: "{{ item.key }}={{ item.value }}"\n    state: present\n  loop: "{{ vault_environment_settings|dict2items }}"\n  notify: Restart vault\n\n- name: Include hardening tasks\n  include_tasks: hardening.yml\n\n- name: Start and enable vault\n  service:\n    name: vault\n    state: started\n    enabled: true\n  when: vault_type == "oss"\n\n- name: Enable vault\n  service:\n    name: vault\n    enabled: true\n  when: vault_type != "oss"' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-18T18:58:56.490423214Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2367941534, 'load_duration': 110493234, 'prompt_eval_count': 460, 'prompt_eval_duration': 24558958, 'eval_count': 211, 'eval_duration': 2231936573, 'model_name': 'llama3.1:8b'} id='run--f4aef47f-5ce9-4664-9fec-478ae813043a-0' usage_metadata={'input_tokens': 460, 'output_tokens': 211, 'total_tokens': 671}
_______________________________________Cleaned LLM Output:_______________________________________ 
--- 

- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install prerequisites
  package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  lineinfile:
    dest: /etc/vault.d/vault.env
    line: "{{ item.key }}={{ item.value }}"
    state: present
  loop: "{{ vault_environment_settings|dict2items }}"
  notify: Restart vault

- name: Include hardening tasks
  include_tasks: hardening.yml

- name: Start and enable vault
  service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"

- name: Enable vault
  service:
    name: vault
    enabled: true
  when: vault_type != "oss"

