    when:
      rke2_airgap_mode == 'download' and rke2_airgap_implementation != 'exists' and rke2_airgap_copy_additional_tarballs | length > 0

    - name: Copy additional images tarballs
      copy:
        content: "{{ lookup('file', '/tmp/rke2-images.tar.gz') }}"
        dest: /tmp/rke2-images.tar.gz
        mode: '0640'
        force: yes
    when:
      rke2_airgap_mode == 'download' and rke2_airgap_implementation != 'exists' and rke2_airgap_copy_additional_tarballs | length > 0

