---
- import_playbook: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
    connect_timeout: 5
    host: "{{ inventory_hostname }}"

- name: Prepare system
  setup:
    run_tags: always
  changed_when: False
  become: true
  become_method: sudo
  become_flags: '-n -q'

- name: Gather bootstrap facts
  setup:
    gather_subset: 'all'

- name: Install bootstrap packages (raw)
  raw:
    cmd: |
      if [ -f /etc/os-release ]; then
        case $ID in
          Fedora|RedHat) echo "yum" ;;
          *) echo "apt-get" ;;
        esac
      else
        echo "dpkg"
      fi
      | bash -c "yum -y install {{ bootstrap_packages }} || apt-get -y install {{ bootstrap_packages }} || dpkg -i {{ bootstrap_packages }}"
      > /dev/null 2>&1
  when: prepare_system.changed

- name: Ensure libdnf5 is present on Fedora/RedHat
  apt:
    name: libdnf5
    state: present
  when: ansible_distribution in ['Fedora', 'RedHat']

- name: Gather ansible facts
  setup:
    gather_subset: 'all'

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_packages }}"
    state: present
  when: prepare_system.changed


