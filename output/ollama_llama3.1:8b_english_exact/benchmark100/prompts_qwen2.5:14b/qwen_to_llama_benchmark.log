      state: present\n            key: "https://www.apache.org/dist/commons/KEY"\n        - name: Add repositories\n          yum_repository:\n            name: "ppa:openjdk/ppa"\n\n    - name: Install required libraries\n      when: not java_install_method\n      block:\n        - name: Install libstdc++ (Debian/Ubuntu)\n          apt:\n            name: libstdc++6\n            state: present\n          when: ansible_distribution == "Debian"\n        - name: Install libstdc++ (RedHat/CentOS)\n          yum:\n            name: libstdc++-devel\n            state: present\n          when: ansible_distribution == "RedHat"\n\n    - name: Install Java, Debian\n      when: ansible_distribution == "Debian"\n      block:\n        - name: Update cache\n          apt:\n            update_cache: yes\n        - name: Check package installation\n          apt:\n            name: "{{ item }}"\n            state: present\n          loop:\n            - openjdk-{{ java_version }}-{{ java_jdk_vendor }}\n            - openjdk-{{ java_version }}-{{ java_jdk_vendor }}-{{ java_architecture }}\n\n    - name: Install Java, RedHat\n      when: ansible_distribution == "RedHat"\n      block:\n        - name: Update cache\n          yum:\n            update_cache: yes\n        - name: Check package installation\n          yum:\n            name: "{{ item }}"\n            state: present\n          loop:\n            - java-{{ java_version }}-{{ java_jdk_vendor }}\n            - java-{{ java_version }}-{{ java_jdk_vendor }}-{{ java_architecture }}\n\n    - name: Export environment variables\n      template:\n        src: "java_env_template.j2"\n        dest: "/etc/profile.d/java.sh"\n        mode: \'0644\'\n\n    - name: Source environment variables\n      shell:\n        cmd: \'source /etc/profile.d/java.sh\'\n\n    - name: Correct java version selected for Java versions less than 11\n      when: java_version < 11 and ansible_distribution == "Debian"\n      block:\n        - name: Update alter