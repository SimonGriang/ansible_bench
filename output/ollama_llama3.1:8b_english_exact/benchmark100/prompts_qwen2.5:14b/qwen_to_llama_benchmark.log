---

- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: server_type == "server"

- name: Copy RKE2 configuration file
  template:
    src: templates/rke2-config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    notify: Config file changed

- name: Copy kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    when: rke2_kubelet_config != ""
    notify: Config file changed

- name: Copy Containerd Registry Configuration file
  template:
    src: templates/registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
    when: (rke2_custom_registry_mirrors != "") or (rke2_custom_registry_configs != "")
    notify: Config file changed

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: (rke2_etcd_snapshot_file != "") and (rke2-server.service is disabled or undefined)

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: (rke2_etcd_snapshot_file != "") and (rke2_etcd_snapshot_s3_options.access_key and rke2_etcd_snapshot_s3_options.secret_key and rke2_etcd_snapshot_s3_options.bucket and rke2_etcd_snapshot_s3_options.snapshot_name)

- name: Restore etcd from file
  block:
    - name: Create the RKE2 etcd snapshot directory
      file:
        path: /etc/rancher/rke2/etcd-snapshot
        state: directory
    - name: Copy the etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /etc/rancher/rke2/etcd-snapshot/snapshot.db
    - name: Restore etcd from the snapshot file
      command: rke2 etcd restore /etc/rancher/rke2/etcd-snapshot/snapshot.db
  when: do_etcd_restore

- name: Restore etcd from s3
  block:
    - name: Restore etcd from an S3 snapshot
      command: rke2 etcd restore-s3 --access-key="{{ rke2_etcd_snapshot_s3_options.access_key }}" --secret-key="{{ rke2_etcd_snapshot_s3_options.secret_key }}" --bucket="{{ rke2_etcd_snapshot_s3_options.bucket }}" --snapshot-name="{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: yes
  when: inventory_hostname in groups('rke2_cluster_group_name') and inventory_hostname == groups('rke2_cluster_group_name')[0]

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: masked
  when: inventory_hostname in groups('rke2_cluster_group_name') and inventory_hostname == groups('rke2_cluster_group_name')[0]

- name: Wait for the first server be ready - no CNI
  wait_for:
    host: "{{ inventory_hostname }}"
    state: started
    delay: 10
  when: inventory_hostname in groups('rke2_cluster_group_name') and inventory_hostname == groups('rke2_cluster_group_name')[0]

- name: Wait for the first server be ready - with CNI
  wait_for:
    host: "{{ inventory_hostname }}"
    state: started
    delay: 10
  when: inventory_hostname in groups('rke2_cluster_group_name') and inventory_hostname == groups('rke2_cluster_group_name')[0]

- name: Restore etcd
  block:
    - name: Get registered nodes
      command: rke2 etcd get-registered-nodes
    - name: Remove old node secrets and nodes
      command: rke2 etcd remove-old-nodes
  when: (do_etcd_restore or do_etcd_restore_from_s3)

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: inventory_hostname in groups('rke2_cluster_group_name')

handlers:
  - name: Config file changed
    service:
      name: rke2-server
      state: restarted

