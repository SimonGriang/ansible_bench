---
- name: Enable proxy and proxy_http modules on Debian and Suse systems
  become: true
  apt:
    name: libapache2-mod-proxy
    state: present
  when: ansible_os_family == 'Debian'
- name: Enable proxy_http module on Suse systems
  become: true
  zypper:
    name: libaprutil1
    state: present
  when: ansible_os_family == 'Suse'
- name: Configure locations using a template
  become: true
  template:
    src: location.conf.j2
    dest: /etc/apache2/conf.d/location.conf
    mode: '0644'
  notify: httpd test and restart
- name: Ensure httpd_locations is defined
  set_fact:
    httpd_locations: "{{ lookup('template', 'locations.j2') }}"
- name: Loop over httpd_locations
  block:
    - name: Create location blocks
      template:
        src: location.conf.j2
        dest: /etc/apache2/conf.d/{{ item.name }}.conf
        mode: '0644'
      notify: httpd test and restart
      with_items: "{{ httpd_locations }}"
    - name: Create directory
      file:
        path: "{{ item.path }}"
        state: directory
        mode: '0755'
      with_items: "{{ httpd_locations }}"

