---
- name: rsyslog deployment
  hosts: all
  become: true

  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Uninstall conflicting systemd-logger
    package:
      name: systemd-logger
      state: absent

  - name: Install rsyslog
    package:
      name: rsyslog
      state: present

  - name: Install additional rsyslog packages
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ rsyslog_features }}"

  - name: Configuring default rsyslog
    template:
      src: rsyslog.conf.j2
      dest: /etc/rsyslog.conf
      mode: '0644'
    when: rsyslog_deploy_default_config

  - name: Make configuration directory
    file:
      path: /etc/rsyslog.d/
      state: directory
      mode: '0755'
      owner: root
      group: root

  - name: Configuring rsyslog forward rule
    template:
      src: rsyslog-forward.conf.j2
      dest: /etc/rsyslog.d/rsyslog-forward.conf
      mode: '0644'
    when: not rsyslog_deploy_default_config

  - name: Configuring additional config files
    copy:
      content: "{{ lookup('template', item) | string }}"
      dest: /etc/rsyslog.d/{{ item | basename }}.conf
      mode: '0644'
      owner: root
      group: root
    loop: "{{ rsyslog_config_files }}"

  - name: Start and enable rsyslog
    service:
      name: rsyslog
      state: started
      enabled: true


