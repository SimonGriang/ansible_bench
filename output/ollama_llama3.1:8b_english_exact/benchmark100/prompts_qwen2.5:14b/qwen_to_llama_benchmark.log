ion': 3660413220, 'model_name': 'llama3.1:8b'} id='run--3530aefa-ee32-4ba4-afaf-15dfbc1bf5a9-0' usage_metadata={'input_tokens': 628, 'output_tokens': 458, 'total_tokens': 1086}
