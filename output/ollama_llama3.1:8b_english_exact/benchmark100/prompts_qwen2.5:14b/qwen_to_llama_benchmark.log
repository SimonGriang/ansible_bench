--- 

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  delegate_to: "{{ active_server | default(ansible_group_name) }}"
  notify: "RKE2 service restarted"

- name: Wait for all nodes to be ready again
  wait_for_connection:
    host: "{{ active_server | default(ansible_group_name) }}"
    timeout: 15
    retries: 100
    connect_timeout: 15
    status: 200
  delegate_to: "{{ active_server | default(ansible_group_name) }}"
  when: "'active_server' in group_names"

- name: Wait for all pods to be ready again
  wait_for:
    host: "{{ active_server | default(ansible_group_name) }}"
    path: "{{ item.path }}"
    state: present
    timeout: 15
    retries: 100
    connect_timeout: 15
    delay: 15
    status: 200
  delegate_to: "{{ active_server | default(ansible_group_name) }}"
  with_items: "{{ rke2_pods }}"
  when: "'rke2_wait_for_all_pods_to_be_ready' in group_names"

