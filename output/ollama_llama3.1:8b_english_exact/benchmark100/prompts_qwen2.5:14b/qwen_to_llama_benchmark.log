---
- name: Ensure the unzip package is available on the target system
  apt:
    name: unzip
    state: present
  when: ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian'

- name: Ensure the unzip package is available on the target system
  yum:
    name: unzip
    state: present
  when: ansible_distribution == 'Red Hat' or ansible_distribution == 'CentOS'

- name: Create a system group for promtail
  group:
    name: promtail
    state: present
  become: yes

- name: Create a system user for promtail
  user:
    name: promtail
    group: promtail
    create_home: yes
    home: /etc/promtail
    state: present
  become: yes

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
  become: yes

- name: Create directories for promtail configuration files
  file:
    path: /etc/promtail
    state: directory
    mode: '0755'
  become: yes

- name: Create directories for the promtail application
  file:
    path: /usr/local/promtail
    state: directory
    mode: '0755'
  become: yes

- name: Check if the promtail binary exists
  stat:
    path: /usr/local/bin/promtail
    state: file

- name: Download promtail binaries
  get_url:
    url: https://example.com/promtail/promtail-linux-amd64.tar.gz
    dest: /tmp/promtail.tar.gz
    mode: '0644'
  when: not promtail_binary.exists

- name: Download promtail binaries
  copy:
    content: |
      #!/bin/bash
      curl -f https://example.com/promtail/promtail-linux-amd64.tar.gz -o /tmp/promtail.tar.gz
    dest: /usr/local/bin/promtail
    mode: '0755'
  when: promtail_binary.exists and promtail_binary.distributed

- name: Propagate locally distributed promtail archive
  copy:
    content: |
      #!/bin/bash
      curl -f https://example.com/promtail/promtail-linux-amd64.tar.gz -o /tmp/promtail.tar.gz
    dest: /usr/local/bin/promtail
    mode: '0755'
  when: not promtail_binary.exists and promtail_binary.distributed

- name: Download promtail binaries to controller node
  get_url:
    url: https://example.com/promtail/promtail-linux-amd64.tar.gz
    dest: /tmp/promtail.tar.gz
    mode: '0644'
    delegate_to: controller

- name: Propagate promtail binaries
  copy:
    content: |
      #!/bin/bash
      curl -f https://example.com/promtail/promtail-linux-amd64.tar.gz -o /tmp/promtail.tar.gz
    dest: /usr/local/bin/promtail
    mode: '0755'
  when: promtail_binary.exists and promtail_binary.propagated

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail.tar.gz
    dest: /usr/local/promtail
    compression: tar
    mode: '0755'
    force: yes
  when: not promtail_binary.exists

- name: Create symlink to latest version
  file:
    path: /usr/local/bin/promtail
    state: link
    src: /usr/local/promtail/promtail
  when: not promtail_binary.exists

- name: Write configuration
  template:
    src: templates/promtail.yml.j2
    dest: /etc/promtail/promtail.yml
    mode: '0644'
  become: yes
  when: not promtail_binary.exists

- name: Create systemd service unit
  template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
  become: yes
  when: not promtail_binary.exists

- name: Restart promtail service
  service:
    name: promtail
    state: restarted
    enabled: yes
  become: yes
  when: not promtail_binary.exists


