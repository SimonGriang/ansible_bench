---
- name: Install and configure Python packages
  hosts: localhost
  gather_facts: no

  tasks:
  - import_tasks: assert.yml
    delegate_to: localhost
    run_once: yes

  - name: Install python pip
    apt:
      name: '{{ name }}'
      state: present

  - name: Configure pip proxy
    template:
      src: pip-proxy.conf.j2
      dest: /etc/pip.conf
      mode: '0644'
    when: python_pip_proxy is defined

  - name: Trust hosts
    template:
      src: pip-trusted-hosts.conf.j2
      dest: /etc/pip.conf
      mode: '0644'
    when: python_pip_trusted_host is defined

  - name: Update pip
    apt:
      name: python3-pip
      state: present
    when:
      - python_pip_update == true
      - ansible_distribution_release not in ['bookworm', 'noble']
      - ansible_os_family != 'Alpine'

  - name: Install requested modules
    pip:
      name: '{{ item.name }}'
      state: '{{ item.state }}'
      version: '{{ item.version }}'
    loop: '{{ python_pip_modules | items }}'
    when:
      - ansible_distribution_release not in ['bookworm', 'noble']
      - ansible_os_family != 'Alpine'


