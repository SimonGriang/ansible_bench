---
- name: DNS Setup
  import_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items:
    - { path: '/etc/bind', mode: '0755', owner: 'root', group: 'root' }
    - { path: '/var/log/bind', mode: '0755', owner: 'root', group: 'bind' }

- name: Create group
  group:
    name: bind
    state: present

- name: Create user
  user:
    name: bind
    group: bind
    create_home: no
    system: yes

- name: Generate rndc key
  command: rndc-keygen -a -r /dev/urandom
  args:
    chdir: /etc/bind
  notify: restart bind

- name: Set permissions on rndc key file
  file:
    path: /etc/bind/rndc.key
    state: file
    mode: '0600'

- name: Get the hints/root file
  get_url:
    url: https://www.internic.net/froot/other/Ns.cache
    dest: /var/named/root.hints
    mode: '0644'

- name: Create zone file
  template:
    src: templates/zone.j2
    dest: /var/named/{{ item.name }}.zone
    mode: '0644'
  with_items:
    - { name: "example.com" }
    - { name: "example.net" }

- name: Add zones to configuration
  template:
    src: templates/named.conf.j2
    dest: /etc/bind/named.conf.local
    mode: '0644'

- name: Place systemd override
  file:
    path: /etc/systemd/system/bind.service.d/override.conf
    state: touch
  template:
    src: templates/bind.service.d/override.j2
    dest: /etc/systemd/system/bind.service.d/override.conf
    mode: '0644'

- name: Start and enable dns
  service:
    name: bind
    state: started
    enabled: yes

