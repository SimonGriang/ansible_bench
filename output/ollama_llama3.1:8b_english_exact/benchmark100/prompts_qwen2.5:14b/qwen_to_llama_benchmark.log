---
- name: RKE2 tasks
  tasks:
  - name: Download RKE2 installation script
    get_url:
      url: https://example.com/rke2-install.sh
      dest: /tmp/rke2-install.sh
      mode: '0644'
      timeout: 30

  - name: Copy local RKE2 installation script
    copy:
      content: "{{ lookup('file', '/tmp/rke2-install.sh') }}"
      dest: /tmp/rke2-install.sh
      mode: '0700'
      force: yes
    when:
      - rke2_airgap_mode == 'download'
      - rke2_airgap_implementation == 'copy'

  - name: Create RKE2 artifacts folder
    file:
      path: /tmp/rke2-artifacts
      state: directory
      mode: '0700'
    when:
      - rke2_airgap_mode == 'download'
      - rke2_airgap_implementation == 'copy'
      - rke2_airgap_mode != 'exists'

  - name: Download RKE2 checksum and artifacts
    get_url:
      url: https://example.com/rke2-checksum.txt
      dest: /tmp/rke2-checksum.txt
      mode: '0644'
    when:
      - rke2_airgap_mode == 'download'
      - rke2_airgap_implementation == 'copy'

    - name: Download RKE2 artifacts
      get_url:
        url: https://example.com/rke2-artifacts.tar.gz
        dest: /tmp/rke2-artifacts.tar.gz
        mode: '0644'
    when:
      - rke2_airgap_mode == 'download'
      - rke2_airgap_implementation == 'copy'

    - name: Download RKE2 install script
      get_url:
        url: https://example.com/rke2-install.sh
        dest: /tmp/rke2-install.sh
        mode: '0644'
      when:
        - rke2_airgap_mode == 'download'
        - rke2_airgap_implementation == 'copy'

  - name: Rescue for failed download
    block:
      - name: Create a directory for artifacts
        file:
          path: /tmp/rke2-artifacts
          state: directory
          mode: '0700'

      - name: Download RKE2 artifacts
        get_url:
          url: https://example.com/rke2-artifacts.tar.gz
          dest: /tmp/rke2-artifacts.tar.gz
          mode: '0644'

      - name: Download RKE2 install script
        get_url:
          url: https://example.com/rke2-install.sh
          dest: /tmp/rke2-install.sh
          mode: '0644'

      - name: Copy RKE2 artifacts to remote hosts
        copy:
          content: "{{ lookup('file', '/tmp/rke2-artifacts.tar.gz') }}"
          dest: /tmp/rke2-artifacts.tar.gz
          mode: '0644'
          force: yes
      when:
        - rke2_airgap_mode == 'download'
        - rke2_airgap_implementation == 'copy'

  - name: Copy local RKE2 artifacts
    copy:
      content: "{{ lookup('file', '/tmp/rke2-artifacts.tar.gz') }}"
      dest: /tmp/rke2-artifacts.tar.gz
      mode: '0640'
      force: yes
    when:
      - rke2_airgap_mode == 'download'
      - rke2_airgap_implementation == 'copy'

  - name: Airgap mode - additional images tarballs
    file:
      path: /tmp/rke2-images
      state: directory
    when:
      - rke2_airgap_mode == 'download'
      - rke2_airgap_implementation != 'exists'
      - rke2_airgap_copy_additional_tarballs | length > 0

    - name: Copy additional images tarballs
      copy:
        content: "{{ lookup('file', '/tmp/rke2-images.tar.gz') }}"
        dest: /tmp/rke2-images.tar.gz
        mode: '0640'
        force: yes
    when:
      - rke2_airgap_mode == 'download'
      - rke2_airgap_implementation != 'exists'
      - rke2_airgap_copy_additional_tarballs | length > 0

  - name: Ensure artifacts exist and have acceptable permissions
    file:
      path: /tmp/rke2-artifacts
      state: directory
      mode: '0700'
    when:
      - rke2_airgap_mode == 'exists'
      - rke2_airgap_implementation == 'exists'

    - name: Modify permissions if necessary
      file:
        path: /tmp/rke2-artifacts
        state: directory
        mode: '0700'
      when:
        - rke2_airgap_mode == 'exists'
        - rke2_airgap_implementation == 'exists'
        - (get_fact('rke2_airgap_mode') | default('')) != 'exists'
        - (get_fact('rke2_airgap_implementation') | default('')) != 'exists'

  - name: Populate service facts
    service_facts:
      gather_subset: ['network', 'hardware']

  - name: Get stats of the FS object
    filesystem_stats:
      path: /usr/local

  - name: Check if separate partition
    shell:
      cmd: grep /usr/local /proc/mounts

  - name: Set RKE2 bin path
    set_fact:
      rke2_bin_path: "{{ rke2_bin_path }}"

  - name: Check RKE2 version
    shell:
      cmd: rke2 version
    register: rke2_version

  - name: Set RKE2 versions
    set_fact:
      rke2_installed_version: "{{ rke2_version.stdout | trim }}"
      rke2_running_version: "{{ rke2_version.stdout | trim }}"

  - name: Prevent accidental RKE2 downgrade
    assert:
      that: rke2_installed_version == rke2_running_version
    when:
      - not ansible_check_mode

  - name: Run RKE2 install script
    shell:
      cmd: /tmp/rke2-install.sh
    when:
      - rke2_installed_version != rke2_running_version
      - not ansible_check_mode

  - name: Run RKE2 install script with airgap variables
    shell:
      cmd: /tmp/rke2-install.sh --airgap
    when:
      - rke2_airgap_mode == 'download'
      - rke2_airgap_implementation == 'copy'
      - rke2_installed_version != rke2_running_version
      - not ansible_check_mode

  - name: Copy Custom Manifests
    copy:
      content: "{{ lookup('file', '/tmp/custom_manifests.tar.gz') }}"
      dest: /etc/rke2/custom_manifests.tar.gz
      mode: '0640'
      force: yes
    when:
      - rke2_airgap_mode == 'download'
      - rke2_airgap_implementation == 'copy'
      - get_fact('rke2_airgap_copy_custom_manifests') | default(false)

  - name: Copy Static Pods
    copy:
      content: "{{ lookup('file', '/tmp/static_pods.tar.gz') }}"
      dest: /etc/rke2/agent/pod-manifests/static-pods.tar.gz
      mode: '0640'
      force: yes
    when:
      - rke2_airgap_mode == 'download'
      - rke2_airgap_implementation == 'copy'
      - get_fact('rke2_airgap_copy_static_pods') | default(false)

  - name: Copy RKE2 environment file
    copy:
      content: "{{ lookup('file', '/tmp/rke2-env.sh') }}"
      dest: /etc/rke2/env.sh
      mode: '0640'
      force: yes
    when:
      - rke2_airgap_mode == 'download'
      - rke2_airgap_implementation == 'copy'
      - get_fact('rke2_airgap_copy_env_file') | default(false)


