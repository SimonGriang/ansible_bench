91Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11434318825, 'load_duration': 112479086, 'prompt_eval_count': 2259, 'prompt_eval_duration': 639924949, 'eval_count': 1038, 'eval_duration': 10679903226, 'model_name': 'llama3.1:8b'} id='run--f4531709-bc91-47de-a1ca-b9caceca6fae-0' usage_metadata={'input_tokens': 2259, 'output_tokens': 1038, 'total_tokens': 3297}
