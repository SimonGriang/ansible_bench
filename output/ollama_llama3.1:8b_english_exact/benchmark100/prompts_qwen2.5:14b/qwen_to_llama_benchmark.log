---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    name: "{{ git_user }}"

- name: Create directory for git configuration
  file:
    path: "{{ git_config_dir }}"
    state: directory
    mode: '0755'
  when:
    - git_user is defined
    - (git_user_exists is defined)

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "{{ git_user_home }}/.gitconfig"
    mode: '0644'
  when:
    - git_user is defined
    - git_user_exists is defined
    - git_email is defined
    - git_name is defined

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    mode: '0755'
  when:
    - git_repositories is defined
    - git_user_exists is defined

- name: Clone all roles
  git:
