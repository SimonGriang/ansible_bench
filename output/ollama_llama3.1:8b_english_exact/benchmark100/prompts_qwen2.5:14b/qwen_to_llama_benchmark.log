---
- name: Bootstrap playbook
  hosts: all

  tasks:
  - name: Assert that all required variables are set correctly
    assert:
      that:
        - bootstrap_install.raw is defined
        - bootstrap_wait_for_host is defined
      message: "Required variables are not set correctly"

  - name: Wait for host (when configured)
    block:
      - name: Wait for host
        wait_for:
          host: "{{ bootstrap_wait_for_host }}"
          port: 22
          timeout: 10
      - name: Wait for host
        wait_for:
          host: "{{ bootstrap_wait_for_host }}"
          hostname: "{{ bootstrap_wait_for_host }}"
          timeout: 10
    when: bootstrap_wait_for_host is defined

  - name: Prepare system
    block:
      - name: Establish connection to host
        connection: "{{ bootstrap_install.raw }}"
        ignore_errors: yes
      - name: Gather facts
        setup: {}
    rescue:
      - debug:
          msg: "Error connecting to host. Skipping further tasks."

  - name: Include tasks to gather bootstrap facts (raw)
    include_tasks: gather_bootstrap_facts_raw.yml

  - name: Install bootstrap packages (raw)
    raw: "{{ bootstrap_install.raw }}"

  - name: Ensure system is prepared by issuing ansible modules
    block:
      - name: Gather ansible facts
        setup: {}
      - name: Install bootstrap packages
        package:
          name: "{{ item }}"
          state: present
        loop: "{{ bootstrap_facts.bootstrap_packages }}"
    when: bootstrap_facts is defined


