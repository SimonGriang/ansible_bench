--- 

- name: Import assert.yml
  include: assert.yml

- name: Install mysql
  package:
    name: "{{ item }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec
  loop: "{{ mysql_packages }}"

- name: Configure mysql server
  template:
    src: mysql-server.cnf.j2
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    mode: '0644'
  notify: Restart mysql server
  vars:
    mysql_configuration_options:
      - option1: value1
      - option2: value2

- name: Configure mysql client
