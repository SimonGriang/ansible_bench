---
- name: Install HashiCorp products
  hosts: all
  gather_facts: true

  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install using package
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ hashicorp_products }}"

  - name: Install repository for RedHat
    lineinfile:
      dest: /etc/yum.repos.d/hcp-repo.repo
      line: "name=HashiCorp repository - {{ ansible_basearch }}"
      state: present
    when: ansible_distribution == 'RedHat'

  - name: Configure debian
    lineinfile:
      dest: /etc/apt/sources.list.d/hcp.list
      line: "deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_distribution_release }}"
      state: present
    when: ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian'

  - name: Install required package gpg
    apt:
      name: gnupg
      state: present
    when: ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian'

  - name: Install apt key for Debian
    apt_key:
      url: 'https://apt.releases.hashicorp.com/gpg'
      state: present
    when: ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian'

  - name: Install repository for Debian
    apt_repository:
      repo: 'deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main'
      state: present
    when: ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian'

  - name: Install hashicorp product using package
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ hashicorp_products }}"
    when: hashicorp_version is not defined

  - name: Install versioned hashicorp product using package
    package:
      name: "{{ item }}={{ hashicorp_version }}"
      state: present
    loop: "{{ hashicorp_products }}"
    when: hashicorp_version is defined

  - name: Install manually
    unarchive:
      src: "{{ item }}"
      dest: "{{ hashicorp_install_dir }}"
      compression: 'tar'
    loop: "{{ hashicorp_products }}"
    when: hashicorp_install_method == 'manual'

  - name: Install hashicorp product manually
    unarchive:
      src: "{{ item }}"
      dest: "{{ hashicorp_install_dir }}"
      compression: 'tar'
      owner: "{{ hashicorp_install_user }}"
      group: "{{ hashicorp_install_group }}"
      mode: '0644'
    loop: "{{ hashicorp_products }}"
    when: hashicorp_install_method == 'manual' and hashicorp_version is defined


