---

- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  ansible.builtin.package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  ansible.builtin.template:
    src: grub_timeout.j2
    dest: /etc/default/grub
    backup: true
  notify:
    - Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  ansible.builtin.template:
    src: grub_recordfail_timeout.j2
    dest: /etc/default/grub
    backup: true
  notify:
    - Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  ansible.builtin.template:
    src: grub_cmdline_linux.j2
    dest: /etc/default/grub
    backup: true
  notify:
    - Update grub
  when: grub_options is defined and grub_options|length > 0

- name: Import password.yml
  import_tasks: password.yml
  when: grub_set_password|bool

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers

