---
- name: Task 1 - Import assert.yml
  include: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Install requirements
  apt:
    name: "{{ openssl_requirements }}"
    state: present

- name: Task 3 - Install pip packages
  pip:
    name: "{{ openssl_pip_packages | join(',') }}"
    state: present
  when: openssl_pip_packages is not empty

- name: Task 4 - Create key directory
  file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: '0700'
  become: true
  become_method: sudo
  become_user: root
  notify: owner group set for key directory
  when: openssl_key_directory is defined and openssl_key_directory is not empty

- name: Task 5 - Create csr directory
  file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: '0755'
  become: true
  become_method: sudo
  become_user: root
  notify: owner group set for csr directory
  when: openssl_csr_directory is defined and openssl_csr_directory is not empty

- name: Task 6 - Create crt directory
  file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: '0755'
  become: true
  become_method: sudo
  become_user: root
  notify: owner group set for crt directory
  when: openssl_crt_directory is defined and openssl_crt_directory is not empty

- name: Task 7 - Include create.yml
  include: create.yml
  when: openssl_items is defined and openssl_items is not empty
  loop: "{{ openssl_items }}"


