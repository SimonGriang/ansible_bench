---
- name: Configure rsyslog
  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Uninstall conflicting systemd-logger
    package:
      name: systemd-logger
      state: absent

  - name: Install rsyslog
    package:
      name: rsyslog
      state: present

  - name: Install additional rsyslog packages
    package:
      name: "{{ rsyslog_features | join(', ') }}"
      state: present

  - name: Configuring default rsyslog
    template:
      src: templates/default.conf.j2
      dest: /etc/rsyslog.conf
      mode: '0644'
    when: rsyslog_deploy_default_config

  - name: Make configuration directory
    file:
      path: /etc/rsyslog.d/
      state: directory
      mode: '0755'

  - name: Configuring rsyslog forward rule
    template:
      src: templates/forward.conf.j2
      dest: /etc/rsyslog.d/forward.conf
      mode: '0644'
    when: not rsyslog_deploy_default_config

  - name: Configuring additional config files
    template:
      src: templates/{{ item }}.j2
      dest: /etc/rsyslog.d/{{ item }}
      mode: '0644'
    with_items:
      - cron.conf
      - mail.conf
    when: rsyslog_deploy_default_config

  - name: Start and enable rsyslog
    service:
      name: rsyslog
      state: started
      enabled: yes


