---
- name: Install and configure DNS server
  hosts: []
  tasks:
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install dns
    apt:
      name: "{{ dns_packages }}"

  - name: Create directories
    file:
      path: "{{ item.path }}"
      state: directory
      mode: "{{ item.mode }}"
      owner: "{{ item.owner }}"
      group: "{{ item.group }}"
    loop:
      - path: '/var/named'
        mode: '0755'
        owner: 'root'
        group: 'root'
      - path: '/var/named/slave'
        mode: '0755'
        owner: 'root'
        group: 'root'
      - path: '/etc/bind'
        mode: '0755'
        owner: 'root'
        group: 'root'

  - name: Create group
    group:
      name: bind
      state: present

  - name: Create user
    user:
      name: bind
      group: bind
      state: present

  - name: Generate rndc key
    shell: rndc-keygen -a -b 256 -c /etc/bind/rndc.key

  - name: Set permissions on rndc key file
    file:
      path: /etc/bind/rndc.key
      mode: '0600'

  - name: Get the hints/root file
    get_url:
      url: 'http://ftp.int-dns.ws/named.root.gz'
      dest: '/var/named/named.root.gz'
      mode: '0644'

  - name: Create zone file
    template:
      src: templates/zone.j2
      dest: '/var/named/{{ zone }}.zone'
      mode: '0644'
    loop:
      - zone: 'example.com'
      - zone: 'example.net'

  - name: Add zones to configuration
    template:
      src: templates/named.conf.j2
      dest: /etc/bind/named.conf
      mode: '0644'
    loop:
      - zone: 'example.com'
      - zone: 'example.net'

  - name: Place systemd override
    file:
      path: /etc/systemd/system/bind.service.d/override.conf
      state: touch
      mode: '0644'

  - name: Start and enable dns
    service:
      name: bind
      state: started
      enabled: yes


