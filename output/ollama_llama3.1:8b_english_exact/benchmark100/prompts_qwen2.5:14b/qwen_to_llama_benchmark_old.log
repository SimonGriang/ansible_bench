--- 

- name: Create the RKE2 config directory
  file:
    path: /etc/rke2/config
    state: directory

- name: Set server taints
  set_fact:
    node_taint: "server:NoSchedule"

- name: Set agent taints
  set_fact:
    node_taint: "agent:NoSchedule"

- name: Copy RKE2 config file
  copy:
    src: /path/to/rke2_config.yaml
    dest: /etc/rke2/config/rke2.yaml
    notify: rke2_config_changed

- name: Copy kubelet config file
  copy:
    src: /path/to/kubelet_config.yaml
    dest: /etc/kubernetes/kubelet.yaml
    when: kubelet_config is defined
    notify: kubelet_config_changed

- name: Copy Containerd Registry Configuration file
  copy:
    src: /path/to/containerd_registry_config.yaml
    dest: /etc/containerd/config.toml
    when: containerd_registry_config is defined
    notify: containerd_registry_config_changed

- name: Start RKE2 service
  service:
    name: rke2
    state: started
    enabled: yes
    daemon_reload: yes
  retry: 5
  notify: rke2_service_restarted

- name: Mask other RKE2 services
  service:
    name: {{ item }}
    state: masked
  loop:
    - rke2-agent
    - rke2-controller
  when: "{{ node_type }} == 'server'"

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    host: "{{ inventory_hostname }}"
    state: started
    delay: 5
    timeout: 300
  when: cni_enabled == False
  until: node_condition == 'Ready'

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    host: "{{ inventory_hostname }}"
    state: started
    delay: 5
    timeout: 300
  when: cni_enabled == True
  until: node_status == 'Ready'

