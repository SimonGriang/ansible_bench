content='---\n\n\n- name: Import assert.yml\n  include_tasks: assert.yml\n\n\n- name: Install apache httpd\n  package:\n    name: "{{ httpd_packages }}"\n    state: present\n\n\n- name: Configure selinux\n  selinux:\n    relabel: yes\n    allow_httpd_anon_write: yes\n    allow_httpd_sys_content_t: yes\n    allow_httpd_sys_rw_content_t: yes\n    allow_http_port: "{{ custom_http_port }}"\n    allow_https_port: "{{ custom_https_port }}"\n\n\n- name: Configure httpd\n  template:\n    src: "{{ httpd_config_src }}"\n    dest: "{{ httpd_config_dest }}"\n    mode: \'0644\'\n  notify:\n    - restart httpd\n\n\n- name: Activate httpd module | Debian\n  command:\n    cmd: a2enmod "{{ httpd_mod }}"\n  when: ansible_distribution == "Debian"\n  notify:\n    - restart httpd\n\n\n- name: Import ssl.yml\n  include_tasks: ssl.yml\n  when: https_ssl_enable == true\n\n\n- name: Import locations.yml\n  include_tasks: locations.yml\n  when: httpd_locations is defined\n\n\n- name: Import vhosts.yml\n  include_tasks: vhosts.yml\n  when: httpd_vhosts is defined\n\n\n- name: Configure ports\n  template:\n    src: "{{ httpd_port_src }}"\n    dest: "{{ httpd_port_dest }}"\n    mode: \'0644\'\n  notify:\n    - restart httpd\n  when: (ansible_distribution == "Debian") or (ansible_distribution == "Suse")\n\n\n- name: Import directories.yml\n  include_tasks: directories.yml\n  when: httpd_directories is defined\n\n\n- name: Flush handlers\n  meta:\n    flush_handlers: yes\n\n\n- name: Removing default html\n  file:\n    path: "{{ httpd_data }}/index.html"\n    state: absent\n  when: httpd_remove_example == true\n\n\n- name: Start and enable httpd\n  service:\n    name: httpd\n    state: started\n    enabled: yes' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-08T15:48:25.405855492Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5020589347, 'load_duration': 100626714, 'prompt_eval_count': 685, 'prompt_eval_duration': 182576194, 'eval_count': 435, 'e