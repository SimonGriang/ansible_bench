---
- name: Ensure unzip package
  apt:
    name: unzip
    state: present
  when: ansible_distribution == 'Ubuntu' or ansible_distribution == 'Debian'
  become: yes
- name: Ensure unzip package (RHEL/CentOS)
  yum:
    name: unzip
    state: present
  when: ansible_distribution == 'RedHat' or ansible_distribution == 'CentOS'
  become: yes
- name: Create system group for promtail
  group:
    name: promtail
    state: present
    system: yes
  become: yes
- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    state: present
    system: yes
    create_home: no
  become: yes
- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  become: yes
- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  become: yes
- name: Create application directories
  file:
    path: /usr/local/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  become: yes
- name: Check if promtail binary exists
  stat:
    path: /usr/local/bin/promtail
    state: file
  register: promtail_binary
- name: Download promtail binaries
  get_url:
    url: "{{ promtail_binary_url }}"
    dest: /usr/local/bin
    mode: '0755'
    owner: promtail
    group: promtail
    force: yes
  when: promtail_binary.stat.exists == False and promtail_binary_url is defined and not promtail_binary_url in group_vars['all']['distributed_promtail_archives']
  become: yes
- name: Propagate locally distributed promtail archive
  copy:
    content: "{{ lookup('file', group_vars['all']['distributed_promtail_archives'][promtail_binary_url]) }}"
    dest: /usr/local/bin/promtail
    mode: '0755'
    owner: promtail
    group: promtail
  when: promtail_binary.stat.exists == False and group_vars['all']['distributed_promtail_archives'] is defined and promtail_binary_url in group_vars['all']['distributed_promtail_archives']
  become: yes
- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_binary_url }}"
    dest: /usr/local/bin
    mode: '0755'
    owner: promtail
    group: promtail
    force: yes
  when: promtail_binary.stat.exists == False and promtail_binary_url is defined and not promtail_binary_url in group_vars['all']['distributed_promtail_archives']
  run_once: yes
  become: yes
- name: Propagate promtail binaries
  copy:
    content: "{{ lookup('file', group_vars['all']['distributed_promtail_archives'][promtail_binary_url]) }}"
    dest: /usr/local/bin/promtail
    mode: '0755'
    owner: promtail
    group: promtail
  when: promtail_binary.stat.exists == False and group_vars['all']['distributed_promtail_archives'] is defined and promtail_binary_url in group_vars['all']['distributed_promtail_archives']
  run_once: yes
  become: yes
- name: Unpack promtail binaries
  unarchive:
    src: /usr/local/bin/promtail
    dest: /usr/local/promtail
    compression: tar
    mode: '0755'
    owner: promtail
    group: promtail
    preserve: yes
  register: unpack_result
  when: promtail_binary.stat.exists == False
  become: yes
- name: Create symlink to latest version
  file:
    path: /usr/local/bin/promtail
    state: link
    src: /usr/local/promtail/bin/promtail
  when: unpack_result is not failed
  become: yes
- name: Write configuration
  template:
    src: templates/promtail.yml.j2
    dest: /etc/promtail/promtail.yml
    mode: '0644'
    owner: promtail
    group: promtail
  when: unpack_result is not failed
  become: yes
- name: Create systemd service unit
  template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
    owner: promtail
    group: promtail
  when: unpack_result is not failed
  become: yes

