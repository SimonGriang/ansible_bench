---
- name: Bootstrap tasks
  tasks:
  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Wait for port to be available
    wait_for:
      host: localhost
      port: "{{ bootstrap_port }}"
      timeout: "{{ bootstrap_timeout }}"

  - name: Prepare system
    block:
      - name: Test connection and sudo availability
        connection: local
        setup: true
      rescue:
        - name: Gather bootstrap facts
          setup:
            gather_subset: "all"
        - name: Install necessary packages
          raw: |
            /usr/bin/apt-get update -qq && \
            /usr/bin/apt-get install -y --no-install-recommends "python" "sudo"
          when: not bootstrap_facts_installed

  - name: Gather ansible facts
    setup:

  - name: Install bootstrap packages
    package:
      name: "{{ bootstrap_facts_packages }}"
      state: present
      update_cache: yes


