---
- name: Import assert.yml
  include: assert.yml

- name: Install git
  apt:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    name: "{{ git_user }}"
  register: user_exists

- name: Create directory for git configuration
  file:
    path: "{{ git_config_dir }}"
    state: directory
  when: user_exists is not undefined and git_config_dir is defined and git_user is defined

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "{{ git_user }}/{{ git_config_dir }}/gitconfig"
    mode: '0644'
  when: git_user is defined and git_config_dir is defined and git_user is defined

- name: Create repository_destination
  file:
    path: "{{ git_repo_dir }}"
    state: directory
  when: git_repo_dir is defined and git_user is defined

- name: Clone all roles
  git:
    repo: "{{ item.repository }}"
    dest: "{{ git_repo_dir }}/{{ item.name }}"
    accept_hostkey: true
    clone: yes
  with_items: "{{ git_repositories }}"
  become: yes

