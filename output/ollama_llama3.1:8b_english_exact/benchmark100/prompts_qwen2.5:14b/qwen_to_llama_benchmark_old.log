---

- name: Configure Postfix
  hosts: localhost

  tasks:
  - name: Import assert.yml
    include: assert.yml

  - name: Pre-configure debian systems
    set_fact:
      main_mailer_type: 'No configuration'

  - name: Install postfix
    apt:
      name: postfix
      state: present

  - name: Install postfix-mysql
    apt:
      name: postfix-mysql
      state: present
    when: postfix_virtual_mailbox_maps|contains('mysql') or postfix_virtual_mailbox_domains|contains('mysql') or postfix_virtual_alias_maps|contains('mysql')

  - name: Configure postfix (transport_maps)
    template:
      src: templates/transport_maps.cf.j2
      dest: /etc/postfix/transport_maps
      mode: '0644'
    notify: [ validate_transport_maps, rebuild_transport_maps ]

  - name: Configure postfix (header_checks)
    template:
      src: templates/header_checks.cf.j2
      dest: /etc/postfix/header_checks
      mode: '0644'
    notify: [ validate_header_checks, reload_postfix ]

  - name: Setting values for main.cf (1/2)
    set_fact:
      smtpd_recipient_restrictions: 'permit_mynetworks,permit_sasl_authenticated,reject_non_fqdn_recipient,reject_unverified_recipient'
      smtpd_sender_restrictions: 'reject_null_sender'
    when: smtpd_sender_restrictions or smtpd_recipient_restrictions

  - name: Setting values for main.cf (2/2)
    set_fact:
      mynetworks: '192.168.1.0/24'
      mydestination: 'example.com'
      relay_domains: 'example.com'
      virtual_mailbox_domains: 'example.com'
      virtual_alias_domains: 'example.com'
    when: mynetworks or mydestination or relay_domains or virtual_mailbox_domains or virtual_alias_domains

  - name: Configure postfix (main.cf)
    template:
      src: templates/main.cf.j2
      dest: /etc/postfix/main.cf
      mode: '0644'
    notify: [ validate_main_cf, restart_postfix ]

  - name: Configure postfix (master.cf)
    template:
      src: templates/master.cf.j2
      dest: /etc/postfix/master.cf
      mode: '0644'
    notify: [ validate_master_cf, restart_postfix ]

  - name: Creates cert/key directory
    file:
      path: /etc/postfix/ssl
      state: directory
    when: postfix_smtpd_tls_cert_file or postfix_smtpd_tls_key_file

  - name: Deploy Postfix TLS server certificate
    copy:
      content: "{{ lookup('file', postfix_smtpd_tls_cert_file) }}"
      dest: /etc/postfix/ssl/tls.crt
      mode: '0644'
    notify: [ reload_postfix ]

  - name: Deploy Postfix TLS server key
    copy:
      content: "{{ lookup('file', postfix_smtpd_tls_key_file) }}"
      dest: /etc/postfix/ssl/tls.key
      mode: '0644'
    notify: [ reload_postfix ]

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure aliases
    lineinfile:
      dest: /etc/aliases
      line: 'postmaster: root'
    notify: [ rebuild_aliases, reload_postfix ]

  - name: Configure sender_access
    lineinfile:
      dest: /etc/postfix/sender_access
      line: 'sender_access_maps = hash:/etc/postfix/sender_access'
    notify: [ rebuild_sender_access, reload_postfix ]

  - name: Configure recipient_access
    lineinfile:
      dest: /etc/postfix/recipient_access
      line: 'recipient_access_maps = hash:/etc/postfix/recipient_access'
    notify: [ validate_recipient_access, rebuild_recipient_access, reload_postfix ]

  - name: Place sasl_password_map
    lineinfile:
      dest: /etc/postfix/sasl_password_map
      line: 'sasl_password_map = hash:/etc/postfix/sasl_password_map'
    notify: [ rebuild_sasl_password_map, reload_postfix ]

  - name: Flush handlers again
    meta: flush_handlers

  - name: Start and enable postfix
    service:
      name: postfix
      state: started
      enabled: yes

