---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install python pip
  apt:
    name: "{{ python_pip }}"
    state: present

- name: Configure pip proxy
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
  when: python_pip_proxy is defined

- name: Trust hosts
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
    notify: restart pip
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: present
  when:
    - python_pip_update
    - ansible_distribution-release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    version: "{{ item.version }}"
  loop: "{{ python_pip_modules }}"
  when:
    - ansible_distribution-release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'

