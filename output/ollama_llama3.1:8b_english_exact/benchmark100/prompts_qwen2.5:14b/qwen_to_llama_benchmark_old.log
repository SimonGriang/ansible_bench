---
- name: Preparing the System
  hosts: all
  become: yes

  tasks:
  - name: Check if all variables have been set correctly
    assert:
      that:
        - bootstrap_wait_for_host is defined
        - bootstrap_install.raw is defined
      message: "Missing required variables"

  - name: Wait for host (when configured)
    wait_for:
      host: "{{ bootstrap_wait_for_host }}"
      port: "{{ bootstrap_port }}"
      timeout: 5
    when: bootstrap_wait_for_host == 'true'

  - name: Prepare system
    block:
      - name: Establish a connection to the host
        ping:
          connection: ssh
        ignore_errors: true
      - name: Gather host facts
        setup:
          filter: 'ansible_'
    rescue:
      - name: Display a debug message if connection is not established
        debug:
          msg: "Connection to {{ inventory_hostname }} not established"

  - name: Include tasks to gather bootstrap facts (raw)
    include_tasks: gather_bootstrap_facts_raw.yml

  - name: Install bootstrap packages (raw)
    raw: "{{ bootstrap_install.raw }}"

  - name: Ensure system is prepared by issuing ansible modules
    block:
      - name: Gather ansible facts
        setup:
          filter: 'ansible_'
      - name: Install bootstrap packages
        package:
          name: "{{ item }}"
          state: present
        loop: "{{ bootstrap_facts.packages }}"
    when: bootstrap_facts is defined


