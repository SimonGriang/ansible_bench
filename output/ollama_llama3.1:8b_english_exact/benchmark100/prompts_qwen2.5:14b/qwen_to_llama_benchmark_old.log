---
- name: Import assert.yml
  include: assert.yml

- name: Manage automatic service management
  service:
    name: apt
    enabled: "{{ apt_autostart_state }}"

- name: Disable automatic service management on installation
  file:
    path: /usr/sbin/policy-rc.d
    state: touch
    mode: '0755'
  when: apt_autostart_state == 'disabled'
  notify: Disable apt autostart

- name: Enable automatic service management on installation
  file:
    path: /usr/sbin/policy-rc.d
    state: absent
  when: apt_autostart_state == 'enabled'
  notify: Enable apt autostart

