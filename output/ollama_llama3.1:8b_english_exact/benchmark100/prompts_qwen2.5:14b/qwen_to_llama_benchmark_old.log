---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    home: "/home/{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    create_home: false
    state: present

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Download Vault binary
  get_url:
    url: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}/vault"
    mode: '0755'
  become: yes

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
    state: absent

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
  when: vault_path is defined

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0755'
  loop: "{{ vault_directories }}"
  when: vault_directories is defined

- name: Create data directory
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0755'
  loop: "{{ vault_data_directories }}"
  when: vault_data_directories is defined

- name: Generate TLS key and certificate
  openssl_certificate:
    path: "{{ vault_data_directory }}/tls/tls.crt"
    private_key_path: "{{ vault_data_directory }}/tls/tls.key"
    days: 1095
    notify: Restart vault
  when: vault_data_directory is defined

- name: Set ownership of tls material
  file:
    path: "{{ item.path }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    state: file
  loop: "{{ vault_tls_files }}"
  when: vault_tls_files is defined

- name: Copy Vault binary
  copy:
    content: "{{ lookup('file', '{{ vault_download_path }}/vault') }}"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
    notify: Restart vault
  when: vault_path is defined

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  command:
    cmd: "setcap cap_ipc_lock=ep /usr/bin/vault"
    creates: "/usr/bin/vault"
    changed_when: "false"

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'
    notify: Restart vault
  when: vault_path is defined

- name: Create /usr/lib/systemd/system
  file:
    path: "/usr/lib/systemd/system"
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy Vault service file
  template:
    src: "vault.service.j2"
    dest: "/usr/lib/systemd/system/vault.service"
    mode: '0644'
    notify: Daemon reload
  when: ansible_distribution == 'Ubuntu'

- name: Copy vault configuration
  template:
    src: "vault.hcl.j2"
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: '0644'
    notify: Restart vault
  when: vault_path is defined

- name: Flush handlers
  meta: flush_handlers

  notify: Restart vault

