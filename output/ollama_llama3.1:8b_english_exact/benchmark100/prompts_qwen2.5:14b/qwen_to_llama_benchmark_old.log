---
- name: Verify if Python is installed
  command: python --version
  register: python_installed
  failed_when: python_installed.rc != 0

- name: Verify if Python 3 is installed
  command: python3 --version
  register: python3_installed
  failed_when: python3_installed.rc != 0

- name: Display the path of the Python executable if found
  debug:
    var: python_installed.path

- name: Display the path of the Python 3 executable if found
  debug:
    var: python3_installed.path

- name: Install required packages
  become: yes
  apt:
    name: openssl
    state: present

- name: Install python3-packaging
  become: yes
  dnf:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_pip_packages }}"

- name: Create key directory
  become: yes
  file:
    path: /path/to/keys
    state: directory
    mode: '0755'
    owner: user
    group: group

- name: Create csr directory
  become: yes
  file:
    path: /path/to/csr
    state: directory
    mode: '0755'
    owner: user
    group: group

- name: Create crt directory
  become: yes
  file:
    path: /path/to/crt
    state: directory
    mode: '0755'
    owner: user
    group: group

- name: Include create.yml
  include_tasks: create.yml
  loop: "{{ openssl_items }}"

