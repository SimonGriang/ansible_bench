---
- name: hardening
  tasks:
  - name: Disable swap
    shell: swapoff -a
    when: vault_hardening_disable_swap|bool
  - name: Disable swap now
    shell: swapoff -a
    when: "'swap' in fstab and vault_hardening_disable_swap|bool"
  - name: Disable swap permanently
    shell: umount /swap
    when: vault_hardening_disable_swap|bool

  - name: Disable core dumps
    shell: ulimit -c 0
    when: vault_hardening_disable_core_dumps|bool

  - name: Disable Shell Command History
    template:
      src: disable-command-history.sh.j2
      dest: /etc/profile.d/disable-command-history.sh
      mode: '0755'
    when: vault_hardening_disable_shell_command_history|bool

  - name: Configure SELinux / AppArmor
    shell: |
      if [ "$(getenforce)" == "Enforcing" ]; then
        setenforce 0
      fi
    when: vault_hardening_configure_selinux_apparmor|bool

  - name: Enable SELinux
    shell: setenforce 1
    when: vault_hardening_configure_selinux_apparmor|bool and getenforce == 'Enforcing'

  - name: Install selinux-policy
    package:
      name: selinux-policy
      state: present

  - name: Set SELinux policy
    shell: setenforce 1
    when: vault_hardening_configure_selinux_apparmor|bool

  - name: Enable AppArmor (enforcing)
    shell: |
      if [ "$(apparmor_status)" == "enabled" ]; then
        aa-enforce /path/to/vault
      fi
    when: vault_hardening_configure_selinux_apparmor|bool

