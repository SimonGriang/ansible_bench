---
- name: Configure cron settings
  tasks:
  - name: Import assertions and tasks
    include_tasks: assert.yml

  - name: Install cron package
    package:
      name: "{{ cron_packages }}"
      state: present

  - name: Configure SHELL variable in cron configuration
    lineinfile:
      path: /etc/crontab
      line: "SHELL={{ cron_shell }}"
      insertafter: EOF
      regexp: '^SHELL=.*$'
      state: present
    notify: Restart cron

  - name: Configure PATH variable in cron configuration
    lineinfile:
      path: /etc/crontab
      line: "PATH={{ cron_path }}"
      insertafter: EOF
      regexp: '^PATH=.*$'
      state: present
    notify: Restart cron

  - name: Configure MAILTO variable in cron configuration
    lineinfile:
      path: /etc/crontab
      line: "MAILTO={{ cron_mailto }}"
      insertafter: EOF
      regexp: '^MAILTO=.*$'
      state: present
    notify: Restart cron

  - name: Start and enable cron service
    service:
      name: cron
      enabled: "{{ cron_service }}"
      state: started

  - name: Schedule requested cron jobs
    cron:
      name: "{{ item.name }}"
      minute: "{{ item.minute | default('0') }}"
      hour: "{{ item.hour | default('0') }}"
      day: "{{ item.day | default('0') }}"
      month: "{{ item.month | default('0') }}"
      day_of_week: "{{ item.day_of_week | default('0') }}"
