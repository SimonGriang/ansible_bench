--- 

- name: Import assert.yml
  include_tasks: assert.yml

- name: Configure apk
  apt:
    cache_valid_time: 3600
    upgrade: yes
  notify: reboot

- name: Configure apt
  apt:
    autoremove: yes
    autoclean: yes
    upgrade: yes
    upgrade_partial: yes
    prevent_upgrade:
      - package1
      - package2
  notify: reboot

- name: Update all software (dnf)
  dnf:
    exclude: package1,package2
    update_cache: yes
    update_only: yes
  notify: reboot

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    refresh_db: yes
    upgrade: yes
  notify: reboot

- name: Configure yum
  yum:
    update_only: yes
    cache_valid_time: 3600
  notify: reboot
  when: yum is installed
  become: true
  become_method: sudo
  become_user: root
  become_password: secret

- name: Install yum-utils
  yum:
    name: yum-utils
    state: present

- name: Update all software (zypper)
  zypper:
    update: yes
    install: yes
  notify: reboot

