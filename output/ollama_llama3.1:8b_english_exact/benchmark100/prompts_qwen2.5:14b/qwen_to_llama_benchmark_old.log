--- 

- name: Create RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"

- name: Copy RKE2 configuration file
  template:
    src: templates/config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
  notify:
    - Config file changed

- name: Copy kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
  when: rke2_kubelet_config is not empty
  notify:
    - Config file changed

- name: Copy Containerd Registry Configuration file
  template:
    src: templates/registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
  when: (rke2_custom_registry_mirrors is not empty) or (rke2_custom_registry_configs is not empty)
  notify:
    - Config file changed

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: (rke2_etcd_snapshot_file is not empty) and (rke2-server.service is undefined or rke2-server.service is disabled)

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: (rke2_etcd_snapshot_file is not empty) and (rke2_etcd_snapshot_s3_options is defined)

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /etc/rancher/rke2/etcd-snapshot
        state: directory
    - name: Copy etcd snapshot file
      copy:
        content: "{{ lookup('file', rke2_etcd_snapshot_file) }}"
        dest: /etc/rancher/rke2/etcd-snapshot/snapshot.db
    - name: Restore etcd from snapshot file
      command: rke2 etcd restore /etc/rancher/rke2/etcd-snapshot/snapshot.db
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Restore etcd from S3 snapshot
      command: rke2 etcd restore --s3 {{ rke2_etcd_snapshot_s3_options }}
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server.service
    state: started
    enabled: yes
    args:
      env: RKE2_TOKEN={{ rke2_server_token }}
  when: inventory_hostname == rke2_first_server

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent.service
    state: masked
    enabled: no
  when: inventory_hostname == rke2_first_server

- name: Wait for the first server be ready - no CNI
  wait_for:
    host: "{{ rke2_first_server }}"
    port: 22
    delay: 10
    timeout: 300
    state: started
    connect_timeout: 10
    timeout_message: 'First server is not ready'
    connect_message: 'First server is not reachable'

- name: Wait for the first server be ready - with CNI
  wait_for:
    host: "{{ rke2_first_server }}"
    port: 22
    delay: 10
    timeout: 300
    state: started
    connect_timeout: 10
    timeout_message: 'First server is not ready'
    connect_message: 'First server is not reachable'
    connect_timeout_message: 'First server is not reachable'

- name: Restore etcd
  block:
    - name: Get registered nodes
      command: rke2 get nodes
    - name: Remove old node secrets and nodes
      command: rke2 etcd remove-node {{ inventory_hostname }}
  when: (do_etcd_restore is defined) or (do_etcd_restore_from_s3 is defined)

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: inventory_hostname in groups(rke2_cluster_group_name)

