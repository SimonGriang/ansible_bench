---
- name: Configure MySQL Server
  import_tasks: assert.yml

- name: Install MySQL Server
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure MySQL Server
  template:
    src: mysql-server.conf.j2
    dest: /etc/mysql/my.cnf
    mode: '0644'
  notify: restart mysql

- name: Configure MySQL Client
  template:
    src: mysql-client.conf.j2
    dest: /etc/mysql/conf.d/mysql-client.conf
    mode: '0644'
  notify: restart mysql

- name: Initialize MySQL
  when: (ansible_distribution == 'Alpine') or (ansible_distribution == 'Archlinux')
  command: mysql -e "SOURCE /dev/stdin; exit" <<EOF
            CREATE DATABASE {{ item }};
            GRANT ALL PRIVILEGES ON {{ item }}.* TO 'mysql'@'localhost';
            FLUSH PRIVILEGES;
EOF
  with_items: "{{ mysql_databases | reject('initial_import') }}"

- name: Start and Enable MySQL
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    src: files/my.cnf
    dest: /etc/mysql/my.cnf
    mode: '0644'
    owner: mysql
    group: mysql

- name: Create Databases
  mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_databases | reject('initial_import') }}"

- name: List Databases
  mysql_db:
    name: "*"
    state: present
    info: yes

- name: Import Database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.target }}"
  with_items: "{{ mysql_databases | reject('initial_import') }}"

- name: Create Users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
  with_items: "{{ mysql_users }}"

- name: Flush Handlers
  meta: flush_handlers

- name: Flush Handlers Again
  meta: flush_handlers


