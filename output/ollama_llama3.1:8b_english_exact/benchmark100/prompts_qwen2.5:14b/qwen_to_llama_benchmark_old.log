---
- name: Install Keepalived when HA mode is enabled
  when: (rke2_ha | bool) and (rke2_server_group == 'rke2-server')
  apt:
    name: keepalived
    state: present

- name: Download and install RKE2
  get_url:
    url: https://github.com/rke2/rke2/releases/download/v{{ rke2_version }}/rke2
    dest: /usr/local/bin/rke2
    mode: '0755'
  become: yes
  shell: true
  notify: restart rke2

- name: CIS Hardening
  when: rke2_cis_profile
  include_tasks: cis-hardening.yml

- name: Find Active Server
  when: rke2_active_server
  shell: rke2 get-activeserver

- name: Enable IPVS kernel module
  when: (rke2_kube_vip and rke2_ha)
  modprobe:
    name: ipvs

- name: Copy kube-vip manifests to the masternode
  when: not rke2_ha
  copy:
    content: "{{ lookup('file', 'kube-vip-deploy.yaml') }}"
    dest: /etc/kubernetes/kube-vip-deploy.yaml

- name: Copy ingress-nginx manifests to the masternode
  when: rke2_nginx_config
  copy:
    content: "{{ lookup('file', 'ingress-nginx-deploy.yaml') }}"
    dest: /etc/kubernetes/ingress-nginx-deploy.yaml

- name: Prepare very first server node in the cluster
  when: rke2_first_server
  include_tasks: prepare-first-server.yml

- name: Restore etcd specific tasks
  when: rke2_etcd_restore
  include_tasks: etcd-restore.yml

- name: Download kubeconfig to ansible localhost
  when: rke2_download_kubeconfig
  get_url:
    url: "{{ rke2_kubeconfig_url }}"
    dest: /root/.kube/config
    mode: '0600'

- name: Prepare and join remaining nodes of the cluster
  when: rke2_active_server
  include_tasks: prepare-and-join.yml

- name: Rolling cordon and drain restart when version changes - servers
  when: rke2_version_change
  block:
    - name: Cordon nodes
      kubernetes:
        api_version: v1
        kind: Node
        state: present
        name: "{{ item }}"
        cordon: yes
      loop: "{{ rke2_servers }}"
    - name: Drain nodes
      kubernetes:
        api_version: v1
        kind: Node
        state: present
        name: "{{ item }}"
        drain: yes
      loop: "{{ rke2_servers }}"

- name: Rolling cordon and drain restart when version changes - agents
  when: rke2_version_change
  block:
    - name: Cordon nodes
      kubernetes:
        api_version: v1
        kind: Node
        state: present
        name: "{{ item }}"
        cordon: yes
      loop: "{{ rke2_agents }}"
    - name: Drain nodes
      kubernetes:
        api_version: v1
        kind: Node
        state: present
        name: "{{ item }}"
        drain: yes
      loop: "{{ rke2_agents }}"

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  when: rke2_config_change
  block:
    - name: Cordon nodes
      kubernetes:
        api_version: v1
        kind: Node
        state: present
        name: "{{ item }}"
        cordon: yes
      loop: "{{ rke2_servers }}"
    - name: Drain nodes
      kubernetes:
        api_version: v1
        kind: Node
        state: present
        name: "{{ item }}"
        drain: yes
      loop: "{{ rke2_servers }}"
    - name: Restart nodes
      kubernetes:
        api_version: v1
        kind: Node
        state: present
        name: "{{ item }}"
        restart: yes
      loop: "{{ rke2_servers }}"

- name: Final steps
  include_tasks: final-steps.yml


