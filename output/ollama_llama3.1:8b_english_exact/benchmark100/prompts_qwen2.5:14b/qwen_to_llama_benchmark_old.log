content='---\n\n- name: Import assert.yml\n  include_tasks: assert.yml\n\n- name: Install required packages\n  package:\n    name: "{{ selinux_requirements }}"\n    state: present\n  notify:\n    - gather_facts\n\n- name: Flush handlers\n  meta:\n    flush_handlers\n\n- name: Configure selinux\n  when: (selinux_enabled and (selinux_enforcing or selinux_permissive)) and selinux_connection == \'direct\'\n  selinux:\n    state: "{{ selinux_state }}"\n    policy: "{{ selinux_policy }}"\n  notify:\n    - reboot\n\n- name: Manage selinux\n  selinux:\n    state: "{{ selinux_state }}"\n    policy: "{{ selinux_policy }}"\n  notify:\n    - reboot\n\n- name: Manage selinux booleans\n  seboolean:\n    state: "{{ item.value.state }}"\n    persistent: "{{ item.value.persistent }}"\n    label: "{{ item.key }}"\n  loop: "{{ selinux_booleans|dict2items }}"\n  when: selinux_enabled\n\n---' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-08T17:13:52.085299791Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2184023765, 'load_duration': 106877262, 'prompt_eval_count': 831, 'prompt_eval_duration': 22578665, 'eval_count': 213, 'eval_duration': 2053906549, 'model_name': 'llama3.1:8b'} id='run--7ed288a9-d478-48d9-8a65-99eca22fe99f-0' usage_metadata={'input_tokens': 831, 'output_tokens': 213, 'total_tokens': 1044}
