---
- name: Java installation tasks
  tasks:
  - name: Update java_jdk_vendor to temurin if it is adoptopenjdk
    set_fact:
      java_jdk_vendor: 'temurin'
    when: java_jdk_vendor == 'adoptopenjdk'
  - name: Include OS-specific variables based on distribution
    include_vars:
      file: "{{ ansible_distribution }}_vars.yml"
  - name: Include architecture-specific variables
    include_vars:
      file: "{{ ansible_architecture }}_vars.yml"
  - name: Set OS-specific variables (part I)
    set_fact:
      java_package: "{{ java_packages[ansible_distribution] }}"
      java_package_name: "{{ java_packages[ansible_distribution] }}"
    when: java_packages[ansible_distribution] is defined
  - name: Set OS and architecture-specific variables (part II)
    set_fact:
      java_alternative: "{{ java_alternatives[ansible_distribution][ansible_architecture] }}"
    when: java_alternatives[ansible_distribution][ansible_architecture] is defined
  - name: Set specific variables
    set_fact:
      java_home: "/usr/lib/jvm/{{ java_jdk_vendor }}"
  - name: Debian pre-requisites
    block:
      - name: Remove deprecated repositories
        apt:
          state: absent
          package: "{{ item }}"
        loop:
          - openjdk-11-jdk
          - openjdk-8-jdk
      - name: Install extra apt tools
        apt:
          name: "{{ item }}"
          state: present
        loop:
          - apt-transport-https
          - gnupg2
          - ca-certificates
          - curl
      - name: Add key repositories
        apt_key:
          url: "{{ item }}"
          state: present
        loop:
          - https://temurin.bintray.io/debian/public.key
      - name: Add repositories
        apt_repository:
          repo: 'ppa:openjdk-ppa/ppa'
          state: present
  - name: RedHat pre-requisites
    block:
      - name: Add key repositories
        rpm_key:
          state: present
          key: https://download.java.net/debian/jdk11/JUS-REPOS-KEY-11.asc
  - name: Install required libraries
    apt:
      name: "{{ item }}"
      state: present
    loop:
      - libstdc++6
      - libgcc1
      - libx11-6
      - libxext6
      - libxi6
  - name: Install Java, Debian
    apt:
      name: "{{ java_package }}"
      state: present
    when: java_package is defined
    notify: update-java-alternatives
  - name: Install Java, RedHat
    yum:
      name: "{{ java_package }}"
      state: present
    when: java_package is defined
    notify: update-java-alternatives
  - name: Export environment variables
    template:
      src: /etc/profile.d/java.env.j2
      dest: /etc/profile.d/java.env
      mode: '0644'
  - name: Source environment variables
    shell: source /etc/profile.d/java.env
  - name: Correct java version selected for Java versions less than 11
    shell: update-java-alternatives -s java-1.{8,9}-openjdk-amd64
    when: java_jdk_version < 11 and ansible_distribution == 'debian'
  - name: Correct java version selected for Java versions greater than or equal to 11
    shell: update-java-alternatives -s java-11-openjdk-amd64
    when: java_jdk_version >= 11 and ansible_distribution == 'debian'


