- name: Manage Helm Installation
  hosts: localhost

  tasks:
  - name: Check if Helm binary exists
    stat:
      path: /usr/local/bin/helm
    register: helm_binary_exists

  - name: Check Helm version
    shell:
      cmd: helm version
    register: helm_version
    when: helm_binary_exists.stat.exists == True

  - name: Download helm
    get_url:
