tasks:

  - name: Create ssl key
    file:
      path: /etc/ssl/private/{{ item }}/key.pem
      state: touch
      mode: '0640'
    loop: ['item1', 'item2', 'item3']

  - name: Create ssl csr
    command: openssl req -new -key /etc/ssl/private/{{ item }}/key.pem -out /etc/ssl/certs/{{ item }}/csr.pem -subj "/C=US/ST=State/L=Locality/O=Organization/CN={{ item }}"
    loop: ['item1', 'item2', 'item3']

  - name: Create ssl certificates
    command: openssl x509 -req -in /etc/ssl/certs/{{ item }}/csr.pem -signkey /etc/ssl/private/{{ item }}/key.pem -out /etc/ssl/certs/{{ item }}/cert.pem
    loop: ['item1', 'item2', 'item3']

  - name: Create PKCS#12 file
    command: openssl pkcs12 -export -in /etc/ssl/certs/{{ item }}/cert.pem -inkey /etc/ssl/private/{{ item }}/key.pem -out /etc/ssl/private/{{ item }}/p12.p12 -name "{{ item }}"
    loop: ['item1', 'item2', 'item3']

  - name: Read private key
    slurp:
      src: /etc/ssl/private/{{ item }}/key.pem
      dest: /etc/ssl/private/{{ item }}/key
    loop: ['item1', 'item2', 'item3']

  - name: Read certificate
    slurp:
      src: /etc/ssl/certs/{{ item }}/cert.pem
      dest: /etc/ssl/certs/{{ item }}/cert
    loop: ['item1', 'item2', 'item3']

  - name: Create combined private_key and certificate file
    file:
      path: /etc/ssl/{{ item }}/combined.pem
      state: touch
      mode: '0640'
    loop: ['item1', 'item2', 'item3']

