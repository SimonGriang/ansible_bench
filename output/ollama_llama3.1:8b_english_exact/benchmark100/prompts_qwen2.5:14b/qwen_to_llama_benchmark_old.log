---
- name: Download RKE2 kubeconfig to localhost
  block:
  - name: Download RKE2 kubeconfig
    fetch:
      src: /etc/rancher/rke2/rke2.yaml
      dest: "{{ rke2_download_kubeconf_path }}"
      flat: true
      mode: '0644'
    when:
    - rke2_download_kubeconf == true
    - inventory_hostname == groups['rke2_servers_group_name'][0]

  - name: Replace loopback IP by master server IP
    blockinfile:
      path: "{{ rke2_download_kubeconf_path }}"
      block: |
        apiServer: https://{{ rke2_api_ip or groups['rke2_servers_group_name'][0].ansible_all_ipv4_addresses[0] }}:8443
      marker: '# {marker}'
    when:
    - not ansible_check_mode
    - rke2_download_kubeconf == true
    - inventory_hostname == groups['rke2_servers_group_name'][0]


