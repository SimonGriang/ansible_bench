---
- name: Clean up Docker and add repository
  tasks:
    - name: Ensure apt key is not present in trusted.gpg.d
      apt_key:
        state: absent
        keyserver: https://download.docker.com/linux/ubuntu/gpg

    - name: Ensure old apt source list is not present in /etc/apt/sources.list.d
      apt_source:
        name: docker
        source: https://download.docker.com/linux/ubuntu
        state: absent

    - name: Ensure old versions of Docker are not installed
      apt:
        name: docker
        state: absent

    - name: Ensure legacy repo file is not present
      file:
        path: /etc/apt/sources.list.d/docker.list
        state: absent

    - name: Ensure dependencies are installed
      apt:
        name:
          - apt-transport-https
          - ca-certificates
          - python3-debian
        state: present

    - name: Add or remove Docker repository
      apt_repository:
        repo: 'https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable'
        state: "{{ docker_add_repo | bool }}"
        update_cache: yes
      notify: apt update

    - name: Ensure handlers are notified immediately to update the apt cache
      meta:
        flush_handlers: yes

