---

- name: Import assert.yml
  include: assert.yml

- name: Install cron
  apt:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^SHELL'
    line: 'SHELL=/bin/bash'
    state: present
  notify: restart cron

- name: Configure path
  lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^PATH'
    line: 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    state: present
  notify: restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^MAILTO'
    line: 'MAILTO=example@example.com'
    state: present
  notify: restart cron

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ''

- name: Schedule requested cron jobs
  cron:
    name: "Custom Cron Job"
    minute: "{{ cron_jobs.minute }}"
    hour: "{{ cron_jobs.hour }}"
    day: "{{ cron_jobs.day }}"
    month: "{{ cron_jobs.month }}"
    dayofweek: "{{ cron_jobs.dayofweek }}"
    job: 'echo "Hello World!"'
  loop: "{{ cron_jobs }}"
  loop_control:
    loop_var: cron_job
  when: cron_jobs is defined and cron_jobs != ''

