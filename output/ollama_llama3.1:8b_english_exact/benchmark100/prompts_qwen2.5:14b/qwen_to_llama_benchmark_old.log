---
- name: Install Java and set JAVA_HOME
  hosts: 
  become: yes

  tasks:
    - name: Import assert.yml
      include: assert.yml

    - name: Install requirements
      apt:
        name: bash
        state: present

    - name: Install openjdk java (package)
      apt:
        name: "{{ java_vendor }}-openjdk"
        state: present
      when: java_vendor == "openjdk"

    - name: Install RPM
      rpm_key:
        state: present
        key: https://yum.oracle.com/RPM-GPG-KEY-oracle-ol7
      rpm:
        state: present
        name: oracle-java8-Installer
        source: /path/to/package.rpm

    - name: Install DEB
      apt_key:
        state: present
        keyserver: keyserver.ubuntu.com
        key: 6488BDG8742D30D9
      apt:
        state: present
        name: oracle-java8-installer
        source: /path/to/package.deb

    - name: Install oracle java (rpm) (repository)
      yum_repository:
        name: ol7_java
        description: Oracle Java 7 and 8 RPMs
        baseurl: https://public-yum.oracle.com/repo/OracleLinux/OL7/java/x86_64
        gpgcheck: yes
        gpgkey: https://public-yum.oracle.com/RPM-GPG-KEY-oracle-ol7
      yum:
        name: oracle-java8-Installer
        state: present

    - name: Configure oracle targz
      unarchive:
        src: /path/to/package.tar.gz
        dest: /usr/local/java
        compression: gzip
      file:
        path: /usr/local/java
        state: directory

    - name: Install oracle java policy software (targz)
      unarchive:
        src: /path/to/jce_policy8.tar.gz
        dest: /usr/local/java/jre/lib/security
        compression: gzip

    - name: Set alternative (targz)
      shell:
        cmd: |
          update-alternatives --install /usr/bin/java java /usr/local/java/jre/bin/java 1
      when: java_vendor == "targz" and ansible_distribution != "Alpine Linux"

    - name: Find JAVA_HOME
      shell:
        cmd: "readlink -f /usr/bin/java | sed 's/\/bin\/java//'"
      register: java_home

    - name: Set JAVA_HOME in /etc/environment
      lineinfile:
        path: /etc/environment
        line: JAVA_HOME="{{ java_home.stdout }}"

