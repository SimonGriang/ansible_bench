- name: Populate services facts
  setup:
    submodules: ['services']

- name: Set the Active Server variable
  set_fact:
    active_server: " {{ item.hostname }} "
  with_items: " {{ groups.rke2_servers_group_name }} "
  when: " item.hostname in groups.rke2_servers_group_name and item.service_active('rke2-server.service') "

