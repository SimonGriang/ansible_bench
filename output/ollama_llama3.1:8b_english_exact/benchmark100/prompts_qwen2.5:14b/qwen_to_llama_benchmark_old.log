content='---\n\n\n- name: Import assert.yml\n  ansible.builtin.include_tasks: assert.yml\n\n- name: Install required software\n  when: users_requirements is defined\n  ansible.builtin.apt:\n    name: "{{ item }}"\n    state: present\n  loop: "{{ users_requirements }}"\n\n- name: Loop over users_groups\n  when: users_groups is defined\n  ansible.builtin.include_tasks: group.yml\n  loop: "{{ users_groups }}"\n\n- name: Ensure the /etc/sudoers.d directory is included\n  when: users_sudo_includedir is defined\n  ansible.builtin.lineinfile:\n    dest: /etc/sudoers\n    regexp: \'^includedir\'\n    line: \'includedir /etc/sudoers.d\'\n\n- name: Loop over users\n  when: users is defined\n  ansible.builtin.include_tasks: user.yml\n  loop: "{{ users }}"\n\n- name: Manage cron permission\n  when: users_cron_allow is defined\n  ansible.builtin.template:\n    src: cron.allow.j2\n    dest: /etc/cron.allow\n    mode: \'0644\'\n\n- name: Check existence of /etc/cron.allow\n  when: users_cron_allow is not defined\n  ansible.builtin.file:\n    path: /etc/cron.allow\n    state: absent' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-08T15:53:56.66621849Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2832908800, 'load_duration': 121407947, 'prompt_eval_count': 856, 'prompt_eval_duration': 147085563, 'eval_count': 278, 'eval_duration': 2562791082, 'model_name': 'llama3.1:8b'} id='run--d6709ec7-8d5a-4804-9875-bec78b8c7961-0' usage_metadata={'input_tokens': 856, 'output_tokens': 278, 'total_tokens': 1134}
