---
- name: Load OS-specific vars
  include_vars: "{{ ansible_distribution }}_vars/{{ ansible_distribution }}.yml"

- name: Include RedHat-specific setup tasks
  include_tasks: setup-RedHat.yml
  when: ansible_distribution_family == 'RedHat'

- name: Include Debian-specific setup tasks
  include_tasks: setup-Debian.yml
  when: ansible_distribution_family == 'Debian'

- name: Install Docker packages
  package:
    name: "{{ item }}"
    state: "{{ docker_packages_state }}"
  notify:
    - restart_docker
  loop: "{{ docker_packages }}"
  when: (ansible_version < '2.12') or (ansible_distribution_family not in ['RedHat', 'Debian'])

- name: Install Docker packages (with downgrade option)
  package:
    name: "{{ item }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: True
  notify:
    - restart_docker
  loop: "{{ docker_packages }}"
  when: (ansible_version >= '2.12') and (ansible_distribution_family in ['RedHat', 'Debian'])

- name: Install docker-compose plugin
  apt:
    name: docker-compose
    state: present
  when: docker_install_compose_plugin and (ansible_version < '2.12') or (ansible_distribution_family not in ['RedHat', 'Debian'])

- name: Install docker-compose-plugin (with downgrade option)
  apt:
    name: docker-compose
    state: present
    allow_downgrade: True
  when: docker_install_compose_plugin and (ansible_version >= '2.12') and (ansible_distribution_family in ['RedHat', 'Debian'])

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: '0755'
  when: docker_daemon_options is defined

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options | to_nice_json(indent=0) }}"
    dest: /etc/docker/daemon.json
    mode: '0644'
  notify:
    - restart_docker
  when: docker_daemon_options is defined

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  when: not ansible_check_mode

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta:
    flush_handlers: True

- name: Include docker-compose.yml tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group info using getent
  getent:
    database: group
    key: docker
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  set_fact:
    add_users_to_docker_group: "{{ docker_group_info['result'] | length > 0 }}"

- name: Include docker-users.yml tasks
  include_tasks: docker-users.yml
  when: add_users_to_docker_group


