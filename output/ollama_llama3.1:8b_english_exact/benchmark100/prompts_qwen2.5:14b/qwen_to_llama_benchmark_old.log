content='---\n\n\n- name: Create local ssh_key_directory for {{ user.name }}\n  file:\n    path: /home/{{ user.name }}/.ssh\n    mode: \'0750\'\n    state: directory\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n  when: user.manage_ssh_key\n\n\n- name: Manage user {{ user.name }}\n  user:\n    name: "{{ user.name }}"\n    password: "{{ user.password }}"\n    state: "{{ user.state }}"\n    append: true\n    groups: "{{ user.groups | default([]) | map(\'string\') | join(\',\') }}"\n    sudo: "{{ user.sudo | default(false) }}"\n    sudo_all: "{{ user.sudo_all | default(false) }}"\n    sudo_not_required_for: "{{ user.sudo_not_required_for | default([]) | map(\'string\') | join(\',\') }}"\n    shell: "{{ user.shell | default(\'/bin/bash\') }}"\n    create_home: true\n    home: "{{ user.home | default(\'/home/{{ user.name }}\') }}"\n  when: user.state == \'present\'\n\n\n- name: Set sudo options for {{ user.name }}\n  template:\n    src: templates/sudoers.d/{{ user.name }}\n    dest: /etc/sudoers.d/{{ user.name }}\n    mode: \'0640\'\n  notify: /usr/sbin/visudo --check\n\n\n- name: Remove sudo options for {{ user.name }}\n  file:\n    path: /etc/sudoers.d/{{ user.name }}\n    state: absent\n  when: user.sudo is not defined or user.sudo == false\n\n\n- name: Generate private ssh key for {{ user.name }}\n  openssl_privatekey:\n    path: /home/{{ user.name }}/.ssh/{{ user.name }}.key\n    state: present\n  when: user.manage_ssh_key\n\n\n- name: Generate public ssh key for {{ user.name }}\n  openssl_publickey:\n    path: /home/{{ user.name }}/.ssh/{{ user.name }}.pub\n    source: /home/{{ user.name }}/.ssh/{{ user.name }}.key\n  when: user.manage_ssh_key\n\n\n- name: Convert ssh key to ppk for {{ user.name }}\n  shell:\n    cmd: \'openssl rsa -in /home/{{ user.name }}/.ssh/{{ user.name }}.key -out /home/{{ user.name }}/.ssh/{{ user.name }}.ppk\'\n    chdir: \'/home/{{ user.name }}/.ssh\'\n  when: user.manage_ssh_key\n\n\n- name: Get or set the home directory for {{ user.name }}\n  shell:\n    cmd: \'getent passwd {{ user.name }} | cut -d: -f6\'\n    register: user_home\n  when: user.home is not defined\n\n\n- name: Create .ssh directory for {{ user.name }}\n  file:\n    path: /home/{{ user.name }}/.ssh\n    state: directory\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n    mode: \'0700\'\n  when: user.manage_ssh_key or user.private_keys\n\n\n- name: Deploy authorized keys for {{ user.name }}\n  authorized_key:\n    user: "{{ user.name }}"\n    state: present\n    key: "{{ user.authorized_keys | default([]) | map(\'string\') | join(\',\') }}"\n  when: user.authorized_keys is defined\n\n\n- name: Remove unauthorized keys for {{ user.name }}\n  authorized_key:\n    user: "{{ user.name }}"\n    state: absent\n    key: "{{ user.unauthorized_keys | default([]) | map(\'string\') | join(\',\') }}"\n  when: user.unauthorized_keys is defined\n\n\n- name: Copy generated private ssh key for {{ user.name }}\n  copy:\n    content: "{{ lookup(\'file\', \'/home/{{ user.name }}/.ssh/{{ user.name }}.key\') }}"\n    dest: /home/{{ user.name }}/.ssh/{{ user.name }}.ppk\n    mode: \'0600\'\n  when: user.copy_private_key\n\n\n- name: Check users password valid time for {{ user.name }}\n  shell:\n    cmd: \'getent shadow {{ user.name }} | cut -d: -f4\'\n    register: user_password_validity\n  when: user.password is not undefined\n\n\n- name: Set users password valid time for {{ user.name }}\n  shell:\n    cmd: \'chage -E {{ user.password_validity_days }} {{ user.name }}\'\n    when: user.password_validity_days is defined and user_password_validity != user.password_validity_days\n\n\n- name: Place private key file for {{ user.name }}\n  copy:\n    content: "{{ lookup(\'file\', \'/home/{{ user.name }}/.ssh/{{ user.name }}.key\') }}"\n    dest: /home/{{ user.name }}/.ssh/{{ user.name }}.ppk\n    mode: \'0600\'\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n  when: user.private_keys is defined' additional_kwargs={} resp