  user:
    name: etcd
    comment: etcd user
    group: etcd
    shell: /bin/nologin
    state: present

- name: Copy systemctl config file for kernel hardening
  copy:
    src: "{{ ('/usr/local/share/rke2/rke2-cis-sysctl.conf' if (stat.stat('/usr/local')|is_writeable) and stat('/usr/local')|is_directory else '/opt/rke2/share/rke2/rke2-cis-sysctl.conf') }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: '0600'
  notify:
    - restart systemd-sysctl

