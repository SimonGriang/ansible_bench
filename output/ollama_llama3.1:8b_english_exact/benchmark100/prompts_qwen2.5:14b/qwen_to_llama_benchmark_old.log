---
- name: Install and configure cadvisor
  hosts: localhost

  tasks:
  - name: cadvisor | create directories
    file:
      path: /etc/cadvisor
      state: directory
      mode: '0755'

  - name: cadvisor | download
    get_url:
      url: 'https://github.com/google/cadvisor/releases/download/{{ cadvisor_version }}/cadvisor'
      dest: /etc/cadvisor
      checksum: sha256={{ cadvisor_checksum }}
    when: cadvisor_local_dir == 'false'

  - name: cadvisor | propagate locally distributed cadvisor binary
    copy:
      src: /path/to/local/cadvisor
      dest: /etc/cadvisor
      mode: '0755'
    when: cadvisor_local_dir == 'true'
    notify: restart cadvisor

  - name: cadvisor | symlink
    file:
      src: /etc/cadvisor/cadvisor
      dest: /usr/local/bin/cadvisor
      state: link

  - name: cadvisor | server systemd service
    template:
      src: templates/cadvisor.service.j2
      dest: /etc/systemd/system/cadvisor.service
      mode: '0644'

  - name: test_task
    service:
      name: cadvisor
      state: active
      enabled: yes
    register: service_active

  - name: debug: var=service_active
    debug:
      var: service_active

  - name: cadvisor | enable server systemd
    service:
      name: cadadvisor
      enabled: yes
      state: started

  - name: cadvisor | start server systemd
    service:
      name: cadvisor
      state: started
      enabled: yes

