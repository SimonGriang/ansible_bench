--- 

- name: Download RKE2 installation script
  get_url:
    url: https://example.com/rke2-install.sh
    dest: /tmp/rke2-install.sh
    mode: '0700'
    timeout: 300

- name: Copy local RKE2 installation script
  copy:
    src: /tmp/rke2-install.sh
    dest: /usr/local/bin/rke2-install.sh
    mode: '0700'
    force: yes
  when:
    - rke2_airgap_mode == "download"
    - rke2_airgap_implementation == "exists"

- name: Create RKE2 artifacts folder
  file:
    path: /usr/local/rke2/artifacts
    state: directory
    mode: '0700'
  when:
    - rke2_airgap_mode != "exists"
    - rke2_airgap_implementation != "exists"

- name: Download RKE2 checksum and artifacts
  get_url:
    url: https://example.com/rke2-checksum.tar
    dest: /usr/local/rke2/artifacts
    mode: '0640'
  when:
    - rke2_airgap_mode == "download"
    - rke2_airgap_implementation == "download"

- name: Download RKE2 install script
  get_url:
    url: https://example.com/rke2-install.sh
    dest: /usr/local/rke2/artifacts
    mode: '0640'
  when:
    - rke2_airgap_mode == "download"
    - rke2_airgap_implementation == "download"

- name: Rescue for failed download
  block:
    - name: Create local download directory
      file:
        path: /usr/local/rke2/download
        state: directory
    - name: Download RKE2 artifacts
      get_url:
        url: https://example.com/rke2-artifacts.tar
        dest: /usr/local/rke2/download
        mode: '0640'
    - name: Download RKE2 install script
      get_url:
        url: https://example.com/rke2-install.sh
        dest: /usr/local/rke2/download
        mode: '0640'
    - name: Copy local RKE2 artifacts
      copy:
        src: /usr/local/rke2/download/rke2-artifacts.tar
        dest: /usr/local/rke2/artifacts
        mode: '0640'
        force: yes
  when:
