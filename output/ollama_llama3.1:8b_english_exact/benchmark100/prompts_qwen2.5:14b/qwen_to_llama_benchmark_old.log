content='---\n\n\n- name: RKE2 Node Operations\n  tasks:\n  - name: Cordon and Drain the node {{ rke2_node_name }}\n    kubectl:\n      cmd: cordon\n      name: "{{ rke2_node_name }}"\n      state: present\n    retry_until: 100\n    retry_interval: 15\n    until: kubectl get nodes -l node-role.kubernetes.io/master=true -o jsonpath=\'{.items[0].status.conditions[?(@.type=="Ready")].status}\' == \'True\'\n\n  - name: Cordon and Drain the node {{ rke2_node_name }}\n    kubectl:\n      cmd: drain\n      name: "{{ rke2_node_name }}"\n      state: present\n      additional_args: "{{ rke2_drain_additional_args }}"\n    retry_until: 100\n    retry_interval: 15\n    until: kubectl get nodes -l node-role.kubernetes.io/master=true -o jsonpath=\'{.items[0].status.conditions[?(@.type=="Ready")].status}\' == \'True\'\n\n  - name: Restart RKE2 service on {{ rke2_node_name }}\n    service:\n      name: rke2\n      state: restarted\n    notify: Service (re)started\n\n  - name: Wait for all nodes to be ready again\n    kubectl:\n      cmd: get\n      api: nodes\n      state: present\n      until: kubectl get nodes -o jsonpath=\'{.items[0].status.conditions[?(@.type=="Ready")].status}\' == \'True\'\n    retry_until: 100\n    retry_interval: 15\n\n  - name: Uncordon the node {{ rke2_node_name }}\n    kubectl:\n      cmd: uncordon\n      name: "{{ rke2_node_name }}"\n      state: present\n    when: rke2_drain_node_during_upgrade\n\n  - name: Wait for all pods to be ready again\n    kubectl:\n      cmd: get\n      api: pods\n      state: present\n      until: ( kubectl get pods -o jsonpath=\'{.items[0].status.phase}\' == \'Running\' or kubectl get pods -o jsonpath=\'{.items[0].status.phase}\' == \'Succeeded\' )\n    retry_until: 100\n    retry_interval: 15\n    when: rke2_wait_for_all_pods_to_be_ready\n\n  - name: Wait for all pods to pass readiness checks\n    kubectl:\n      cmd: wait\n      api: pods\n      state: present\n      until: kubectl get pods -o jsonpath=\'{.items[0].status.conditions[?(@.type=="Ready")].status}\' == \'True\'\n    retry_until: 100\n    retry_interval: 15\n    when: rke2_wait_for_all_pods_to_be_healthy' additional_kwargs={} response_metadata={'model': 'llama3.1:8b', 'created_at': '2025-10-08T16:19:12.676489814Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5436396480, 'load_duration': 109360763, 'prompt_eval_count': 1408, 'prompt_eval_duration': 29689591, 'eval_count': 604, 'eval_duration': 5296008681, 'model_name': 'llama3.1:8b'} id='run--6a9b4099-eff6-4fa2-8bb3-075d3d3df40c-0' usage_metadata={'input_tokens': 1408, 'output_tokens': 604, 'total_tokens': 2012}
