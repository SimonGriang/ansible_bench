---
- name: Configure HTTPD
  hosts: localhost
  become: true

  tasks:
  - name: Create directories for HTTPD
    file:
      path: "{{ item.path }}"
      state: directory
      mode: "0755"
    loop: "{{ httpd_directories }}"
    loop_control:
      loop_var: item

  - name: Configure HTTPD directories
    template:
      src: directory.conf.j2
      dest: "{{ httpd_config_directory }}/{{ item.name }}.conf"
      mode: "0644"
    loop: "{{ httpd_directories }}"
    loop_control:
      loop_var: item
    notify:
      - Test httpd configuration validity
      - Restart httpd

