---

- name: Assert usage of systemd as an init system
  assert:
    that: systemd_init_system is yes

- name: Get latest release of promtail
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    return_content: true
  register: latest_release

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/promtail_{{ promtail_version }}_{{ go_arch }}.zip"
  register: zip_local_archive
  until: zip_local_archive.stat.exists
  retries: 3
  delay: 1

- name: Assert local binary exists
  assert:
    that: promtail_binary_local_dir is defined and promtail_binary_local_dir != ""

- name: Get checksum list
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    return_content: true
  register: latest_release

- name: Get checksum for specific architecture
  set_fact:
    promtail_checksum: "{{ latest_release.json.binaries[0].download_count | regex_search('checksum=([^/]+)' + go_arch + '=') }}"

