---
- name: RKE2 Node Operations
  hosts: 
  tasks:
  - name: Cordon and Drain the node {{ rke2_node_name }}
    kubectl:
      cmd: cordon
      name: "{{ rke2_node_name }}"
      state: present
    retry_until: 100
    retry_interval: 15
    until: kubectl get nodes -l node-role.kubernetes.io/master=true -o jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}' == 'True'

  - name: Cordon and Drain the node {{ rke2_node_name }}
    kubectl:
      cmd: drain
      name: "{{ rke2_node_name }}"
      state: present
      additional_args: "{{ rke2_drain_additional_args }}"
    retry_until: 100
    retry_interval: 15
    until: kubectl get nodes -l node-role.kubernetes.io/master=true -o jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}' == 'True'

  - name: Restart RKE2 service on {{ rke2_node_name }}
    service:
      name: rke2
      state: restarted
    notify: Service (re)started

  - name: Wait for all nodes to be ready again
    kubectl:
      cmd: get
      api: nodes
      state: present
      until: kubectl get nodes -o jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}' == 'True'
    retry_until: 100
    retry_interval: 15

  - name: Uncordon the node {{ rke2_node_name }}
    kubectl:
      cmd: uncordon
      name: "{{ rke2_node_name }}"
      state: present
    when: rke2_drain_node_during_upgrade

  - name: Wait for all pods to be ready again
    kubectl:
      cmd: get
      api: pods
      state: present
      until: kubectl get pods -o jsonpath='{.items[0].status.phase}' == 'Running' or kubectl get pods -o jsonpath='{.items[0].status.phase}' == 'Succeeded'
    retry_until: 100
    retry_interval: 15
    when: rke2_wait_for_all_pods_to_be_ready

  - name: Wait for all pods to pass readiness checks
    kubectl:
      cmd: wait
      api: pods
      state: present
      until: kubectl get pods -o jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}' == 'True'
    retry_until: 100
    retry_interval: 15
    when: rke2_wait_for_all_pods_to_be_healthy

