  zypper:
    name: apache2-mod_proxy_http
    state: present
  when: ansible_distribution == 'SLES'

- name: Configure Apache locations using a template
  template:
    src: templates/apache_locations.conf.j2
    dest: /etc/apache2/conf-available/apache_locations.conf
    mode: '0644'
  notify:
    - restart apache

- name: Notify handler to test the Apache configuration
  notify: test apache configuration

- name: Notify handler to restart Apache after configuration changes
  notify: restart apache

- name: Restart apache
  service:
    name: apache2
    state: restarted

