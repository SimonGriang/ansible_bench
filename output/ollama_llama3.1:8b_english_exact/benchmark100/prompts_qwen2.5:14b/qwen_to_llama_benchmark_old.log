- name: Set the package state based on how Ansible is installed
  set_fact:
    ansible_package_state: "{{ ansible_distribution | lower }}_package"

- name: Set up Ansible on RedHat
  include_tasks: setup-RedHat.yml
  when: (ansible_distribution | lower == 'redhat' and ansible_distribution_major_version != '8') or (ansible_distribution | lower == 'centos' and ansible_distribution_major_version < '8')

- name: Set up Ansible on Fedora
  include_tasks: setup-Fedora.yml
  when: (ansible_distribution | lower == 'fedora')

- name: Set up Ansible on Ubuntu
  include_tasks: setup-Ubuntu.yml
  when: (ansible_distribution | lower == 'ubuntu')

- name: Set up Ansible on Debian
  include_tasks: setup-Debian.yml
  when: (ansible_distribution | lower == 'debian')

- name: Set up Ansible using Pip
  include_tasks: setup-pip.yml
  when: ansible_local['ansible']['installed_via_pip'] == true

