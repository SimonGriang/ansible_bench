---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
    state: started
  when:
    - ansible_connection is defined
    - ansible_virtualization_type != 'docker'
    - ansible_virtualization_type != 'container'
    - bootstrap_wait_for_host

- name: Prepare system
  block:
    - name: Test sudo availability
      ansible.builtin.command: sudo --version
      register: _sudo_version
      ignore_errors: true

    - name: Test SSH connection
      ansible.builtin.wait_for:
        host: "{{ inventory_hostname }}"
        port: "{{ ansible_port | default(22) }}"
        timeout: "{{ bootstrap_timeout }}"
      register: _wait_result
      ignore_errors: true
  rescue:
    - name: Gather bootstrap facts
      ansible.builtin.include_tasks: gather_facts.yml

    - name: Install bootstrap packages
      ansible.builtin.command: "{{ bootstrap_install.raw }}"
      args:
        executable: /bin/sh
      register: bootstrap_install_packages
      failed_when: |
        (ansible_facts['os_family'] in ['Alpine', 'Archlinux', 'Gentoo'] and
         not (bootstrap_install_packages.stdout is search(bootstrap_install.stdout_regex))) or
        (ansible_facts['os_family'] in ['Debian', 'RedHat', 'Rocky', 'Suse'] and
         (bootstrap_install_packages.stdout is search(bootstrap_install.stdout_regex)))

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: all
  become: false

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages.split() }}"
    state: present
    update_cache: true
  become: "{{ bootstrap_become }}"



