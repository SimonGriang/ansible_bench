      {% else %}
      /opt/rke2/bin/rke2
      {% endif %}

- name: Check RKE2 version
  shell: |
    set -o pipefail
    installed_version="not installed"
    if [[ -x {{ rke2_bin_path }} ]]; then
      installed_version=$({{ rke2_bin_path }} version | grep 'Version:' | awk '{print $2}')
