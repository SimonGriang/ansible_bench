---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: No configuration
    vtype: select
  when: ansible_facts.os_family == 'Debian'

- name: Install postfix
  ansible.builtin.apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.apt:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is search('mysql') or postfix_virtual_mailbox_domains is search('mysql') or postfix_virtual_alias_maps is search('mysql')

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport
    mode: '0644'
    notify:
      - Validate configuration
      - Rebuild transport_maps database
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
    mode: '0644'
    notify:
      - Validate configuration
      - Reload postfix
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    _postfix_smtpd_recipient_restrictions_check_recipient_access: >-
      {% if postfix_recipient_access is defined %}check_recipient_access hash:{{ postfix_recipient_access_path }}{% else %}{{ omit }}{% endif %}
    _postfix_smtpd_sender_restrictions_check_sender_access: >-
      {% if postfix_sender_access is defined %}check_sender_access hash:{{ postfix_sender_access_path }}{% else %}{{ omit }}{% endif %}
  when: postfix_recipient_access is defined or postfix_sender_access is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    _postfix_mynetworks: >-
      {% if postfix_mynetworks is defined %}
        {% if postfix_mynetworks is iterable %}
          {{ postfix_mynetworks | join(',') }}
        {% else %}
          {{ postfix_mynetworks }}
        {% endif %}
      {% else %}
        127.0.0.0/8
      {% endif %}
    _postfix_mydestination: >-
      {% if postfix_mydestination is defined %}
        {% if postfix_mydestination is iterable %}
          {{ postfix_mydestination | join(',') }}
        {% else %}
          {{ postfix_mydestination }}
        {% endif %}
      {% else %}
        localhost
      {% endif %}
    _postfix_relay_domains: >-
      {% if postfix_relay_domains is defined %}
        {% if postfix_relay_domains is iterable %}
          {{ postfix_relay_domains | join(',') }}
        {% else %}
          {{ postfix_relay_domains }}
        {% endif %}
      {% else %}
        ''
      {% endif %}
    _postfix_smtpd_recipient_restrictions: >-
      {% set lst = [] %}
      {% if postfix_smtpd_recipient_restrictions is defined %}
        {% if postfix_smtpd_recipient_restrictions is iterable %}
          {% set lst = lst + postfix_smtpd_recipient_restrictions %}
        {% else %}
          {% set lst = lst + [postfix_smtpd_recipient_restrictions] %}
        {% endif %}
      {% endif %}
      {% if _postfix_smtpd_recipient_restrictions_check_recipient_access is defined %}
        {% set lst = lst + [_postfix_smtpd_recipient_restrictions_check_recipient_access] %}
      {% endif %}
      {{ lst | join(',') if lst else omit }}
    _postfix_smtpd_sender_restrictions: >-
      {% set lst = [] %}
      {% if postfix_smtpd_sender_restrictions is defined %}
        {% if postfix_smtpd_sender_restrictions is iterable %}
          {% set lst = lst + postfix_smtpd_sender_restrictions %}
        {% else %}
          {% set lst = lst + [postfix_smtpd_sender_restrictions] %}
        {% endif %}
      {% endif %}
      {% if _postfix_smtpd_sender_restrictions_check_sender_access is defined %}
        {% set lst = lst + [_postfix_smtpd_sender_restrictions_check_sender_access] %}
      {% endif %}
      {{ lst | join(',') if lst else omit }}
    _postfix_virtual_mailbox_domains: >-
      {% if postfix_virtual_mailbox_domains is defined %}
        {% if postfix_virtual_mailbox_domains is iterable %}
          {{ postfix_virtual_mailbox_domains | join(',') }}
        {% else %}
          {{ postfix_virtual_mailbox_domains }}
        {% endif %}
      {% else %}
        ''
      {% endif %}
    _postfix_virtual_alias_domains: >-
      {% if postfix_virtual_alias_domains is defined %}
        {% if postfix_virtual_alias_domains is iterable %}
          {{ postfix_virtual_alias_domains | join(',') }}
        {% else %}
          {{ postfix_virtual_alias_domains }}
        {% endif %}
      {% else %}
        ''
      {% endif %}

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
    validate: "postconf -d -c %s"
  notify:
    - Validate configuration
    - Restart postfix

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
    validate: "postconf -d -c %s"
  notify:
    - Validate configuration
    - Restart postfix

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0700'
  loop:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"
  when: postfix_smtpd_tls_cert_file is defined and postfix_smtpd_tls_key_file is defined and postfix_smtpd_tls_cert_file_source is defined and postfix_smtpd_tls_key_file_source is defined

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0600'
  when: postfix_smtpd_tls_cert_file_source is defined
  notify: Reload postfix

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0600'
  when: postfix_smtpd_tls_key_file_source is defined
  notify: Reload postfix

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure aliases
  ansible.builtin.lineinfile:
    path: "{{ postfix_alias_path }}"
    line: "{{ item.name }}: {{ item.destination }}"
    create: yes
    mode: '0644'
  loop: "{{ postfix_aliases }}"
  notify:
    - Rebuild alias database
    - Reload postfix

- name: Configure sender_access
  ansible.builtin.lineinfile:
    path: "{{ postfix_sender_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    create: yes
    mode: '0644'
  loop: "{{ postfix_sender_access }}"
  notify:
    - Rebuild sender_access database
    - Reload postfix

- name: Configure recipient_access
  ansible.builtin.lineinfile:
    path: "{{ postfix_recipient_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    create: yes
    mode: '0644'
  loop: "{{ postfix_recipient_access }}"
  notify:
    - Validate configuration
    - Rebuild recipient_access database
    - Reload postfix

- name: Place sasl_password_map
  ansible.builtin.copy:
    content: "{{ postfix_smtp_sasl_password_map_content }}"
    dest: "{{ postfix_smtp_sasl_password_map }}"
    mode: '0600'
  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map | length > 0
  notify: Rebuild sasl_password_map database

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Start and enable postfix
  ansible.builtin.service:
    name: "{{ postfix_service }}"
    state: started
    enabled: true


