---
- name: Check current docker-compose version
  command: "{{ docker_compose_path }} --version"
  register: docker_compose_vsn
  changed_when: false
  ignore_errors: true

- name: Delete existing docker-compose version if it's different
  file:
    path: "{{ docker_compose_path }}"
    state: absent
  when:
    - docker_compose_vsn.stdout is defined
    - docker_compose_vsn.stdout != ''
    - (docker_compose_vsn.stdout | regex_replace('^.*?([0-9.]+).*$', '\\1') | regex_replace('^v', '')) != (docker_compose_version | regex_replace('^v', ''))

- name: Install Docker Compose (if configured)
  get_url:
    url: "{{ docker_compose_url }}"
    dest: "{{ docker_compose_path }}"
    mode: "0755"
  when:
    - docker_compose_vsn.stdout | default('') == ''
    - or
    - (docker_compose_vsn.stdout | regex_replace('^.*?([0-9.]+).*$', '\\1') | regex_replace('^v', '')) | version_compare(docker_compose_version | regex_replace('^v', ''), 'lt')


