rke2_version != installed_version\n  block:\n    - name: Execute install script in airgap mode\n      command: "{{ rke2_install_script_dir }}/rke2.sh"\n      environment:\n        INSTALL_RKE2_ARTIFACT_PATH: "{{ rke2_artifact_path }}"\n        INSTALL_RKE2_AGENT_IMAGES_DIR: "{{ rke2_tarball_images_path }}"\n        INSTALL_RKE2_METHOD: "airgap"\n      when: rke2_airgap_mode\n\n    - name: Execute install script in online mode\n      command: "{{ rke2_install_script_dir }}/rke2.sh"\n      environment:\n        INSTALL_RKE2_VERSION: "{{ rke2_version }}"\n        INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"\n        INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"\n        INSTALL_RKE2_METHOD: "online"\n      when: not rke2_airgap_mode\n\n- name: Copy Custom Manifests\n  template:\n    src: "{{ item }}"\n    dest: "{{ rke2_data_path }}/server/manifests/{{ item | basename }}"\n    owner: root\n    group: root\n    mode: "0644"\n  loop: "{{ rke2_custom_manifests }}"\n  when: rke2_custom_manifests | length > 0\n\n- name: Copy Static Pods\n  copy:\n    src: "{{ item }}"\n    dest: "{{ rke2_data_path }}/agent/pod-manifests/{{ item | basename }}"\n    owner: root\n    group: root\n    mode: "0644"\n  loop: "{{ rke2_static_pods }}"\n  when: rke2_static_pods is defined and rke2_static_pods | length > 0\n\n- name: Copy RKE2 environment file\n  template:\n    src: rke2_environment.j2\n    dest: "/etc/default/rke2-{{ rke2_type }}"\n    owner: root\n    group: root\n    mode: "0644"\n  when: rke2_environment_options is defined and rke2_environment_options | length > 0\n' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-17T14:14:46.897878676Z', 'done': True, 'done_reason': 'stop', 'total_duration': 44262461951, 'load_duration': 200346578, 'prompt_eval_count': 8177, 'prompt_eval_duration': 5613619405, 'eval_count': 3336, 'eval_duration': 38445295823, 'model_name': 'gpt-oss:20b'} id='run--43060a9d-702b-4f6a-b37a-9309198d7717-0' usage_metadata={'i