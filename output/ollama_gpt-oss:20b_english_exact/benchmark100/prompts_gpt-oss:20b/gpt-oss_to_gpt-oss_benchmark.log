---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  check_mode: false
  become: false

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: >-
      {{ (bootstrap_facts.stdout_lines | select('search', '^VERSION_ID=') | list | first
          | regex_search('VERSION_ID=\"([0-9]+)', '\\1')) | default('NA') }}
  loop: "{{ bootstrap_os_family_map | dict2items | map(attribute='value') | flatten }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - >
      (bootstrap_search[item] is defined and
       (bootstrap_facts.stdout | regex_search('PRETTY_NAME=\"([^\"]+)\"')
        | regex_replace('PRETTY_NAME=\"|\"', '')
        | regex_search(bootstrap_search[item]) is defined))
      or
      (bootstrap_search[item] is not defined and
       (bootstrap_facts.stdout | regex_search('PRETTY_NAME=\"([^\"]+)\"')
        | regex_replace('PRETTY_NAME=\"|\"', '') == item))

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  when:
    - bootstrap_distribution is defined
    - bootstrap_distribution in item.value


