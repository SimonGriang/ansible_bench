py:\n    content: "{{ item.content }}"\n    dest: >\n      {{ users_home_base_dir }}/{{ user.name }}/.ssh/{{ item.name | default(\'id_rsa\') }}\n    mode: \'0400\'\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n  loop: "{{ user.private_keys }}"\n  when: user.private_keys is defined' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-17T13:05:58.867053945Z', 'done': True, 'done_reason': 'stop', 'total_duration': 31724059199, 'load_duration': 160459197, 'prompt_eval_count': 2618, 'prompt_eval_duration': 1679655269, 'eval_count': 2775, 'eval_duration': 29882086621, 'model_name': 'gpt-oss:20b'} id='run--65b55abc-53fd-4cba-9a43-628d5edb62ee-0' usage_metadata={'input_tokens': 2618, 'output_tokens': 2775, 'total_tokens': 5393}
