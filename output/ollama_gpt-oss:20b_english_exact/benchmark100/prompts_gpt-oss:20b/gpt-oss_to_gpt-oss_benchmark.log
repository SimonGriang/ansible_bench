---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Configure apk
  when: ansible_pkg_mgr == 'apk'
  block:
    - name: Update apk cache
      community.general.apk:
        update_cache: true
      changed_when: false
    - name: Upgrade apk packages
      community.general.apk:
        upgrade: true
      notify: Reboot

- name: Configure apt
  when: ansible_pkg_mgr == 'apt'
  block:
    - name: Hold package {{ item }}
      ansible.builtin.dpkg_selections:
        name: "{{ item }}"
        selection: hold
      loop: "{{ update_excluded_packages }}"
    - name: Update apt packages
      ansible.builtin.apt:
        update_cache: true
        upgrade: "{{ update_upgrade_command }}"
        cache_valid_time: "{{ update_cache_valid_time }}"
      environment:
        DEBIAN_FRONTEND: nointeractive
      notify: Reboot
    - name: Autoremove apt packages
      ansible.builtin.apt:
        autoremove: "{{ update_autoremove }}"
      when: update_autoremove | bool

- name: Update all software (dnf)
  when: ansible_pkg_mgr in ['dnf', 'dnf5']
  ansible.builtin.dnf:
    name: "*"
    state: latest  # noqa: package-latest
    exclude: "{{ update_excluded_packages }}"
  notify: Reboot

- name: Update all software (pacman)
  when: ansible_pkg_mgr == 'pacman'
  community.general.pacman:
    update_cache: true
    upgrade: true
  notify: Reboot

- name: Configure yum
  when: ansible_pkg_mgr == "yum"
  block:
    - name: Upgrade packages on RHEL/CentOS 6
      ansible.builtin.dnf:
        name: "*"
        state: latest  # noqa: package-latest
        exclude: "{{ update_excluded_packages }}"
      notify: Reboot
      when: ansible_distribution_major_version == "6"
    - name: Upgrade packages on other major versions
      ansible.builtin.dnf:
        name: "*"
        state: latest  # noqa: package-latest
        exclude: "{{ update_excluded_packages }}"
      notify: Reboot
      when: ansible_distribution_major_version != "6"
    - name: Install yum-utils package
      ansible.builtin.package:
        name: yum-utils
        state: present
      when: ansible_distribution_major_version != "6"

- name: Update all software (zypper)
  when: ansible_pkg_mgr == 'zypper'
  community.general.zypper:
    name: "*"
    state: latest  # noqa: package-latest
  notify: Reboot


