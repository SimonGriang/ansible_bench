  command: grep '/usr/local ' /proc/mounts
  register: partition_result
  changed_when: false
  failed_when: partition_result.rc >= 2

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: >-
      {% if (usr_local.stat.mode | int(base=8) & 2) == 0 or partition_result.rc == 1 %}
