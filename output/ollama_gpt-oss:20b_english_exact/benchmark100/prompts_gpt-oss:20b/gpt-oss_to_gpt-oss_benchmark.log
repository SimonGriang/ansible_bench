---
- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that:
      - ansible_service_mgr == 'systemd'
    fail_msg: "This module only works with systemd"

- name: Get latest release
  ansible.builtin.uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: true
    status_code: 200
    body_format: json
    validate_certs: false
    user: "{{ lookup('env', 'GH_USER') }}"
    password: "{{ lookup('env', 'GH_TOKEN') }}"
  register: _latest_release
  retries: 5
  until: _latest_release.status == 200
  no_log: "{{ lookup('env', 'ANSIBLE_DEBUG') != 'True' }}"

- name: Set promtail version to {{ _latest_release.json.tag_name[1:] }}
  ansible.builtin.set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
  when: promtail_version == 'latest'
  delegate_to: localhost
  run_once: true

- name: Test if zip local archive exists
  ansible.builtin.stat:
    path: >-
      {{ promtail_binary_local_dir }}/{{ promtail_version }}_promtail-linux-
      {{ go_arch }}.zip
  register: promtail_binary_local_archive
  when: promtail_binary_local_dir | length > 0
  delegate_to: localhost
  run_once: true

- name: Assert local binary exists
  ansible.builtin.assert:
    that:
      - promtail_binary_local_archive.stat.exists
    fail_msg: >-
      When using 'promtail_binary_local_dir' please
      ensure that the binary exists
  when: promtail_binary_local_dir | length > 0

- name: Get checksum list
  ansible.builtin.set_fact:
    __promtail_checksums: >-
      {{
        lookup('url',
          'https://github.com/grafana/loki/releases/download/v' ~
          promtail_version ~
          '/SHA256SUMS',
          wantlist=True) | list
      }}
  run_once: true
  when: promtail_binary_local_dir | length == 0

- name: Get checksum for architecture {{ go_arch }}
  ansible.builtin.set_fact:
    __promtail_checksum: "{{ item.split(' ')[0] }}"
  with_items: "{{ __promtail_checksums }}"
  when:
    - promtail_binary_local_dir | length == 0
    - "promtail-linux-" ~ go_arch ~ ".zip" in item


