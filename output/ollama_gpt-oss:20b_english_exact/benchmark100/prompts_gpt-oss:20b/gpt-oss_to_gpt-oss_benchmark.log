---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install using package
  package:
    name: "{{ hashicorp_products | map(attribute='name') | list }}"
    state: present

- name: Install repository for RedHat
  get_url:
    url: https://rpm.releases.hashicorp.com/RHEL/hashicorp.repo
    dest: /etc/yum.repos.d/hashicorp.repo
  when: ansible_os_family in ['RedHat', 'Rocky']

- name: Configure debian
  apt_repository:
    repo: |
      deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_lsb.codename }} main
    state: present
  when: ansible_os_family == 'Debian'

- name: Install required package gpg
  package:
    name: gpg
    state: present
  when: ansible_os_family == 'Debian'

- name: Install apt key for Debian
  apt_key:
    url: https://apt.releases.hashicorp.com/gpg
    state: present
    validate_certs: false
  when: ansible_os_family == 'Debian'

- name: Install repository for Debian
  apt_repository:
    repo: |
      deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_lsb.codename }} main
    state: present
  when: ansible_os_family == 'Debian'

- name: Install hashicorp product using package
  loop: "{{ hashicorp_products }}"
  package:
    name: "{{ item.name }}"
    state: present
    version: "{{ item.version | default(omit) }}"

- name: Install latest hashicorp product using package
  loop: "{{ hashicorp_products }}"
  when: item.version is not defined
  package:
    name: "{{ item.name }}"
    state: latest

- name: Install versioned hashicorp product using package
  loop: "{{ hashicorp_products }}"
  when: item.version is defined
  package:
    name: "{{ item.name }}"
    state: present
    version: "{{ item.version }}"

- name: Install manually
  loop: "{{ hashicorp_products }}"
  unarchive:
    src: |
      {{ hashicorp_src }}/{{ item.name }}-{{ item.version | default('latest') }}.zip
    dest: "{{ hashicorp_destination }}"
    remote_src: true
    owner: "{{ hashicorp_user | default('root') }}"
    group: "{{ hashicorp_group | default('root') }}"
    mode: "{{ hashicorp_mode | default('0755') }}"

- name: Install hashicorp product manually
  loop: "{{ hashicorp_products }}"
  unarchive:
    src: |
      {{ hashicorp_src }}/{{ item.name }}-{{ item.version | default('latest') }}.zip
    dest: "{{ hashicorp_destination }}"
    remote_src: true
    owner: "{{ hashicorp_user | default('root') }}"
    group: "{{ hashicorp_group | default('root') }}"
    mode: "{{ hashicorp_mode | default('0755') }}"



