---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: No configuration
    vtype: select
  when: ansible_os_family == "Debian"

- name: Install postfix
  ansible.builtin.package:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present
  when: "'mysql' in (postfix_virtual_mailbox_maps | string) or 'mysql' in (postfix_virtual_mailbox_domains | string) or 'mysql' in (postix_virtual_alias_maps | string)"

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport
    mode: '0644'
  when: postfix_transport_maps_template is defined
  notify:
    - Validate configuration
    - Rebuild transport_maps database

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
    mode: '0644'
  when: postfix_header_checks_template is defined
  notify:
    - Validate configuration
    - Reload postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    _postfix_smtpd_recipient_restrictions_check_recipient_access: "{{ 'check_recipient_access' if postfix_recipient_access is defined else '' }}"
    _postfix_smtpd_sender_restrictions_check_sender_access: "{{ 'check_sender_access' if postfix_sender_access is defined else '' }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    _postfix_mynetworks: "{{ postfix_mynetworks | default('127.0.0.0/8') }}"
    _postfix_mydestination: "{{ postfix_mydestination | default('localhost') }}"
    _postfix_relay_domains: "{{ postfix_relay_domains | default('') }}"
    _postfix_smtpd_recipient_restrictions: "{{ _postfix_smtpd_recipient_restrictions_check_recipient_access }}"
    _postfix_smtpd_sender_restrictions: "{{ _postfix_smtpd_sender_restrictions_check_sender_access }}"
    _postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default([]) }}"
    _postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains | default([]) }}"

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
    validate: "postconf -d -c %s"
  notify:
    - Validate configuration
    - Restart postfix

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
    validate: "postconf -d -c %s"
  notify:
    - Validate configuration
    - Restart postfix

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0700'
  loop:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"
  when: postfix_smtpd_tls_cert_file is defined and postfix_smtpd_tls_cert_file_source is defined and postfix_smtpd_tls_key_file is defined and postfix_smtpd_tls_key_file_source is defined

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0600'
  when: postfix_smtpd_tls_cert_file_source is defined
  notify: Reload postfix

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0600'
  when: postfix_smtpd_tls_key_file_source is defined
  notify: Reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  ansible.builtin.lineinfile:
    path: "{{ postfix_alias_path }}"
    line: "{{ item.name }}: {{ item.destination }}"
    create: yes
    mode: '0644'
  loop: "{{ postfix_aliases }}"
  notify:
    - Rebuild alias database
    - Reload postfix

- name: Configure sender_access
  ansible.builtin.lineinfile:
    path: "{{ postfix_sender_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    create: yes
    mode: '0644'
  loop: "{{ postfix_sender_access }}"
  notify:
    - Rebuild sender_access database
    - Reload postfix

- name: Configure recipient_access
  ansible.builtin.lineinfile:
    path: "{{ postfix_recipient_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    create: yes
    mode: '0644'
  loop: "{{ postfix_recipient_access }}"
  notify:
    - Validate configuration
    - Rebuild recipient_access database
    - Reload postfix

- name: Place sasl_password_map
  ansible.builtin.copy:
    content: "{{ postfix_smtp_sasl_password_map_content }}"
    dest: "{{ postfix_smtp_sasl_password_map }}"
    mode: '0600'
  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map_content is defined and postfix_smtp_sasl_password_map_content | length > 0
  notify: Rebuild sasl_password_map database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  ansible.builtin.service:
    name: "{{ postfix_service }}"
    state: started
    enabled: true


