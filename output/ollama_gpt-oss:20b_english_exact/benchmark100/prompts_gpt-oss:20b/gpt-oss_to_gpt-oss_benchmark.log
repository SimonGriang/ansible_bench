\n    content: "{{ item.content }}"\n    dest: "{{users_home_base_dir}}/{{user.name}}/.ssh/{{item.name|default(\'id_rsa\')}}"\n    mode: \'0400\'\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n  loop: "{{ user.private_keys }}"\n  when: user.private_keys is defined' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-17T13:05:26.276671544Z', 'done': True, 'done_reason': 'stop', 'total_duration': 67863526765, 'load_duration': 207057968, 'prompt_eval_count': 2675, 'prompt_eval_duration': 1809048485, 'eval_count': 5975, 'eval_duration': 65844815592, 'model_name': 'gpt-oss:20b'} id='run--3deddbcf-c96a-4c76-8c1e-c0366f26cffa-0' usage_metadata={'input_tokens': 2675, 'output_tokens': 5975, 'total_tokens': 8650}
