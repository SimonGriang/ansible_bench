py:\n    content: "{{ item.content }}"\n    dest: "{{ users_home_base_dir }}/{{ user.name }}/.ssh/{{ item.name | default(\'id_rsa\') }}"\n    mode: \'0400\'\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n  loop: "{{ user.private_keys }}"\n  when: user.private_keys is defined' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-17T13:06:36.73103288Z', 'done': True, 'done_reason': 'stop', 'total_duration': 37018397110, 'load_duration': 164074359, 'prompt_eval_count': 2619, 'prompt_eval_duration': 555856131, 'eval_count': 3400, 'eval_duration': 36296370657, 'model_name': 'gpt-oss:20b'} id='run--987b7759-edce-48a2-8a26-cf79307044b3-0' usage_metadata={'input_tokens': 2619, 'output_tokens': 3400, 'total_tokens': 6019}
