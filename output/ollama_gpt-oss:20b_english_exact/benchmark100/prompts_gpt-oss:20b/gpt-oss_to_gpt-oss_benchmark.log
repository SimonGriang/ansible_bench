  when: promtail_binary_local_dir != ''
- name: Get checksum list
  ansible.builtin.set_fact:
    __promtail_checksums: >-
      {{ lookup('url',
          'https://github.com/grafana/loki/releases/download/v' + promtail_version + '/SHA256SUMS',
          wantlist=True) | list }}
  when: promtail_binary_local_dir == ''
  run_once: true
- name: Get checksum for {{ go_arch }} architecture
  ansible.builtin.set_fact:
    __promtail_checksum: "{{ item.split(' ')[0] }}"
  loop: "{{ __promtail_checksums }}"
  when:
    - promtail_binary_local_dir == ''
    - "'promtail-linux-{{ go_arch }}.zip' in item"
  run_once: true


