---
- name: Lookup bootstrap facts
  ansible.builtin.raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  check_mode: false

- name: Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: >-
      {{ (bootstrap_facts.stdout_lines | join(' ') |
          regex_search('^.*VERSION_ID=\"(\\d{1,2})(\\.\\d{1,4})*?\".*$', 1)) |
          default('NA') }}
  loop: "{{ bootstrap_os_family_map.values() | flatten }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - (bootstrap_facts.stdout | regex_search('PRETTY_NAME=.*') |
        regex_search(bootstrap_search[item] | default(item))) is defined

- name: Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"
  when:
    - bootstrap_distribution is defined
    - bootstrap_distribution in item.value



