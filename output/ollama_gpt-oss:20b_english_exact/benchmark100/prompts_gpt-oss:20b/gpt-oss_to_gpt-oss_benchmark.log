---  
- name: Download RKE2 installation script  
  when: not rke2_airgap_mode  
  get_url:  
    url: "{{ rke2_install_bash_url }}"  
    dest: "{{ rke2_install_script_dir }}/rke2.sh"  
    mode: "0700"  
    timeout: "{{ rke2_artifact_fetch_timeout }}"  

- name: Copy local RKE2 installation script  
  when: rke2_airgap_mode and rke2_airgap_implementation == 'copy'  
  copy:  
    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"  
    dest: "{{ rke2_install_script_dir }}/rke2.sh"  
    mode: "0700"  
    force: yes  

- name: Create RKE2 artifacts folder  
  when: rke2_airgap_mode and rke2_airgap_implementation != 'exists'  
  file:  
    path: "{{ rke2_artifact_path }}"  
    state: directory  
    mode: "0700"  

- name: Download RKE2 checksum and artifacts  
  when: rke2_airgap_mode and rke2_airgap_implementation == 'download'  
  block:  
    - name: Download checksum file  
      get_url:  
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"  
        dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"  
        mode: "0640"  
        force: yes  

    - name: Download RKE2 artifacts  
      get_url:  
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"  
        dest: "{{ rke2_artifact_path }}/{{ item }}"  
        mode: "0640"  
        checksum: "sha256:{{ lookup('file', rke2_artifact_path + '/sha256sum-' + rke2_architecture + '.txt') | regex_search('^([0-9a-f]{64})\\s+' + item + '$', multiline=True) }}"  
      loop: "{{ rke2_artifact | reject('match', 'sha256sum') | list }}"  

    - name: Download RKE2 installation script  
      get_url:  
        url: "{{ rke2_install_bash_url }}"  
        dest: "{{ rke2_install_script_dir }}/rke2.sh"  
        mode: "0700"  
        force: yes  
  rescue:  
    - name: Pause for 7 seconds  
      pause:  
        seconds: 7  

    - name: Create local directory for artifacts  
      file:  
        path: "{{ rke2_airgap_copy_sourcepath }}"  
        state: directory  
        mode: "0750"  
        owner: "{{ ansible_user }}"  
      delegate_to: localhost  

    - name: Download checksum locally  
      get_url:  
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"  
        dest: "{{ rke2_airgap_copy_sourcepath }}/sha256sum-{{ rke2_architecture }}.txt"  
        mode: "0640"  
        force: yes  
      delegate_to: localhost  

    - name: Download artifacts locally  
      get_url:  
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"  
        dest: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"  
        mode: "0640"  
        force: yes  
      loop: "{{ rke2_artifact | reject('match', 'sha256sum') | list }}"  
      delegate_to: localhost  

    - name: Download installation script locally  
      get_url:  
        url: "{{ rke2_install_bash_url }}"  
        dest: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"  
        mode: "0700"  
        force: yes  
      delegate_to: localhost  

    - name: Copy local artifacts to remote  
      copy:  
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"  
        dest: "{{ rke2_artifact_path }}/{{ item }}"  
        mode: "0640"  
        force: yes  
      loop: "{{ rke2_artifact | reject('match', 'sha256sum') | list }}"  

    - name: Copy local installation script to remote  
      copy:  
        src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"  
        dest: "{{ rke2_install_script_dir }}/rke2.sh"  
        mode: "0700"  
        force: yes  

- name: Copy local RKE2 artifacts  
  when: rke2_airgap_mode and rke2_airgap_implementation == 'copy'  
  copy:  
    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"  
    dest: "{{ rke2_artifact_path }}/{{ item }}"  
    mode: "0640"  
    force: yes  
  loop: "{{ rke2_artifact }}"  

- name: Airgap mode – additional images tarballs  
  when: rke2_airgap_mode and rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation != 'exists'  
  block:  
    - name: Create tarball images directory  
      file:  
        path: "{{ rke2_tarball_images_path }}"  
        state: directory  
        mode: "0700"  

    - name: Copy additional tarballs  
      copy:  
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"  
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"  
        mode: "0644"  
        force: yes  
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"  

- name: Airgap mode – ensure artifacts exist and have acceptable permissions  
  when: rke2_airgap_mode and rke2_airgap_implementation == 'exists'  
  block:  
    - name: Stat each artifact  
      stat:  
        path: "{{ rke2_artifact_path }}/{{ item }}"  
      register: artifacts  
      loop: "{{ rke2_artifact }}"  

    - name: Stat installation script  
      stat:  
        path: "{{ rke2_install_script_dir }}/rke2.sh"  
      register: install_script  

    - name: Set fact artifacts_writeable  
      set_fact:  
        artifacts_writeable: >-
          {{ artifacts.results | selectattr('stat.mode', 'defined') | selectattr('stat.mode', 'search', '2') | list | length > 0 }}  

    - name: Change writable artifact modes  
      file:  
        path: "{{ rke2_artifact_path }}/{{ item.item }}"  
        mode: "0640"  
      when: artifacts_writeable  
      loop: "{{ artifacts.results }}"  

    - name: Ensure installation script executable  
      file:  
        path: "{{ rke2_install_script_dir }}/rke2.sh"  
        mode: "0700"  
      when: (install_script.stat.mode | int(base=8) & 1) == 0  

    - name: Fail if script not executable  
      fail:  
        msg: "The script at {{ rke2_install_script_dir }}/rke2.sh must be executable."  
      when: (install_script.stat.mode | int(base=8) & 1) == 0  

- name: Populate service facts  
  ansible.builtin.service_facts:  

- name: Get stats of the FS object  
  stat:  
    path: /usr/local  
  register: usr_local  

- name: Check if separate partition  
  command: grep '/usr/local ' /proc/mounts  
  register: partition_result  
  changed_when: false  
  failed_when: partition_result.rc >= 2  

- name: Set RKE2 bin path  
  set_fact:  
    rke2_bin_path: >-
      {% if (usr_local.stat.mode | int(base=8) & 2) == 0 or partition_result.rc == 1 %}
        /usr/local/bin/rke2
      {% else %}
        /opt/rke2/bin/rke2
      {% endif %}  

- name: Check RKE2 version  
  shell: |
    set -o pipefail
    installed_version="not installed"
    if [[ -x {{ rke2_bin_path }} ]]; then
      installed_version=$({{ rke2_bin_path }} version | grep 'Version:' | awk '{print $2}')
    fi
    running_version="$installed_version"
    if systemctl is-active {{ rke2_service_name }} >/dev/null 2>&1; then
      main_pid=$(systemctl show -p MainPID {{ rke2_service_name }} | cut -d= -f2)
      if [[ -n "$main_pid" && -e /proc/$main_pid/exe ]]; then
        running_bin=$(readlink -f /proc/$main_pid/exe)
        running_version=$(${running_bin} version | grep 'Version:' | awk '{print $2}')
      fi
    fi
    echo "{\"installed_version\":\"$installed_version\",\"running_version\":\"$running_version\"}"
  register: versions_check
  changed_when: false  

- name: Set RKE2 versions  
  set_fact:  
    installed_version: "{{ versions_check.stdout | from_json | json_query('installed_version') }}"
    running_version: "{{ versions_check.stdout | from_json | json_query('running_version') }}"
  when: not ansible_check_mode  

- name: Prevent accidental RKE2 downgrade  
  assert:  
    that:
      - rke2_allow_downgrade or "{{ rke2_version_clean }}" >= "{{ running_version_clean }}"
    fail_msg: "Current running version {{ running_version_clean }} is newer than desired version {{ rke2_version_clean }}. Downgrade not allowed."
    success_msg: "Desired version {{ rke2_version_clean }} is acceptable."
  when: not ansible_check_mode and rke2_version != "not installed" and not rke2_allow_downgrade  

- name: Run RKE2 install script  
  when: not ansible_check_mode and rke2_version != installed_version  
  block:  
    - name: Execute install script in airgap mode  
      command: "{{ rke2_install_script_dir }}/rke2.sh"  
      environment:  
        INSTALL_RKE2_ARTIFACT_PATH: "{{ rke2_artifact_path }}"
        INSTALL_RKE2_AGENT_IMAGES_DIR: "{{ rke2_tarball_images_path }}"
        INSTALL_RKE2_METHOD: "airgap"  
      when: rke2_airgap_mode  

    - name: Execute install script in online mode  
      command: "{{ rke2_install_script_dir }}/rke2.sh"  
      environment:  
        INSTALL_RKE2_VERSION: "{{ rke2_version }}"
        INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"
        INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"
        INSTALL_RKE2_METHOD: "online"  
      when: not rke2_airgap_mode  

- name: Copy Custom Manifests  
  template:  
    src: "{{ item }}"  
    dest: "{{ rke2_data_path }}/server/manifests/{{ item | basename }}"  
    owner: root  
    group: root  
    mode: "0644"  
  loop: "{{ rke2_custom_manifests }}"  
  when: rke2_custom_manifests | length > 0  

- name: Copy Static Pods  
  copy:  
    src: "{{ item }}"  
    dest: "{{ rke2_data_path }}/agent/pod-manifests/{{ item | basename }}"  
    owner: root  
    group: root  
    mode: "0644"  
  loop: "{{ rke2_static_pods }}"  
  when: rke2_static_pods is defined and rke2_static_pods | length > 0  

- name: Copy RKE2 environment file  
  template:  
    src: rke2_environment.j2  
    dest: "/etc/default/rke2-{{ rke2_type }}"  
    owner: root  
    group: root  
    mode: "0644"  
  when: rke2_environment_options is defined and rke2_environment_options | length > 0  


