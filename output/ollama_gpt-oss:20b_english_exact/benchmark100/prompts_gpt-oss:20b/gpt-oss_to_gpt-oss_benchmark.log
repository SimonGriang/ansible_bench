---
- name: Create the RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: "Config file changed"

- name: Copy kubelet config
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: "Config file changed"
  when:
    - rke2_kubelet_config is defined
    - rke2_kubelet_config != ''

- name: Copy Containerd Registry Configuration file
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  notify: "Config file changed"
  when:
    - rke2_custom_registry_mirrors | length > 0
    - rke2_custom_registry_configs | length > 0

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when:
    - rke2_etcd_snapshot_file != ''
    - services['rke2-server.service'] is not defined or services['rke2-server.service'].state != 'running'

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file != ''
    - rke2_etcd_snapshot_s3_options is defined
    - rke2_etcd_snapshot_s3_options.access_key is defined
    - rke2_etcd_snapshot_s3_options.secret_key is defined
    - rke2_etcd_snapshot_s3_options.bucket is defined
    - rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create snapshot directory
      file:
        path: "{{ rke2_etcd_snapshot_destination_dir }}"
        state: directory
        owner: root
        group: root
        mode: '0755'
    - name: Copy snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_source_dir }}/{{ rke2_etcd_snapshot_file }}"
        dest: "{{ rke2_etcd_snapshot_destination_dir }}/{{ rke2_etcd_snapshot_file }}"
        owner: root
        group: root
        mode: '0600'
    - name: Restore etcd from file
      shell: |
        rke2 server --cluster-reset \
          --cluster-reset-restore-path \
            "{{ rke2_etcd_snapshot_destination_dir }}/{{ rke2_etcd_snapshot_file }}" \
          --token "{{ rke2_token }}"
      args:
        creates: /etc/rancher/rke2/installation
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Restore etcd from s3
      shell: |
        rke2 server --cluster-reset \
          --etcd-s3 \
          --etcd-s3-access-key-id="{{ rke2_etcd_snapshot_s3_options.access_key }}" \
          --etcd-s3-secret-access-key="{{ rke2_etcd_snapshot_s3_options.secret_key }}" \
          --etcd-s3-bucket="{{ rke2_etcd_snapshot_s3_options.bucket }}" \
          --etcd-s3-snapshot-name="{{ rke2_etcd_snapshot_s3_options.snapshot_name }}" \
          --token "{{ rke2_token }}"
      args:
        creates: /etc/rancher/rke2/installation
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: "Service (re)started"

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    state: stopped
    enabled: false
    masked: true

- name: Wait for the first server be ready - no CNI
  shell: "kubectl get node \"{{ rke2_node_name }}\""
  register: node_status_no_cni
  until:
    - "'Ready' in node_status_no_cni.stdout"
    - "'DiskPressure' not in node_status_no_cni.stdout"
    - "'MemoryPressure' not in node_status_no_cni.stdout"
    - "'PIDPressure' not in node_status_no_cni.stdout"
  retries: 100
  delay: 15
  when:
    - not ansible_check_mode
    - rke2_cni == 'none'

- name: Wait for the first server be ready - with CNI
  shell: "kubectl get nodes | grep \"{{ rke2_node_name }}\""
  register: node_status_cni
  until: "' Ready ' in node_status_cni.stdout"
  retries: 40
  delay: 15
  when:
    - not ansible_check_mode
    - rke2_cni != 'none'

- name: Restore etcd
  block:
    - name: Retrieve registered nodes
      shell: "kubectl get nodes --no-headers"
      register: registered_nodes_output
    - name: Set registered node names
      set_fact:
        registered_node_names: "{{ registered_nodes_output.stdout_lines | map('split', ' ') | map('first') | list }}"
    - name: Set inventory node names
      set_fact:
        inventory_node_names: "{{ groups[rke2_cluster_group_name] }}"
    - name: Delete old node-password secrets
      shell: "kubectl delete secret node-password-{{ item }} --ignore-not-found"
      loop: "{{ inventory_node_names }}"
      when: item not in registered_node_names
    - name: Delete old node objects
      shell: "kubectl delete node {{ item }} --ignore-not-found"
      loop: "{{ inventory_node_names }}"
      when: item not in registered_node_names
  when:
    - do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_facts: true
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"



