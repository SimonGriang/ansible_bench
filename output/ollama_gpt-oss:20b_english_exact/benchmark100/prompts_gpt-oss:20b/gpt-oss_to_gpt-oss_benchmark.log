---  
- name: check if all variables have been set correctly  
  import_tasks: assert.yml  
  run_once: true  
  delegate_to: localhost  

- name: wait for host (when configured)  
  wait_for:  
    host: "{{ inventory_hostname }}"  
    port: "{{ bootstrap_ssh_port | default(22) }}"  
    timeout: "{{ bootstrap_timeout }}"  
    state: started  
  when:  
    - bootstrap_wait_for_host | bool  
    - ansible_connection != 'container'  
    - ansible_connection != 'docker'  
  delegate_to: localhost  
  become: "{{ bootstrap_become | default(false) }}"  
  become_user: "{{ bootstrap_become_user | default(omit) }}"  

- name: prepare system  
  block:  
    - name: Test connection to the host  
      wait_for_connection:  
        timeout: "{{ bootstrap_timeout }}"  
      register: wait_result  
      changed_when: false  
  rescue:  
    - name: Connection test failed message  
      debug:  
        msg: "Connection test failed after {{ bootstrap_timeout }} seconds"  
      changed_when: true  
  always:  
    - name: Gather raw bootstrap facts  
      include_tasks: gather_facts.yml  
    - name: Execute bootstrap raw commands  
      raw: "{{ bootstrap_install.raw }}"  
      register: raw_output  
      changed_when: raw_output.stdout | length > 0  
      become: "{{ bootstrap_become | default(false) }}"  
      become_user: "{{ bootstrap_become_user | default(omit) }}"  

- name: ensure system is prepared by issuing ansible modules  
  block:  
    - name: Gather Ansible facts  
      setup:  
    - name: Install bootstrap packages  
      package:  
        name: "{{ bootstrap__facts_packages }}"  
        state: present  
        update_cache: yes  
  become: "{{ bootstrap_become | default(false) }}"  
  become_user: "{{ bootstrap_become_user | default(omit) }}"


