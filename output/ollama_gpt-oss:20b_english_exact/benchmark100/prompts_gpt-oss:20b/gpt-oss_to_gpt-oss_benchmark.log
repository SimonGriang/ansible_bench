---
- name: Create docroot
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when: >
    httpd_vhosts is defined and item.documentroot is defined and
    (item.create_docroot is not defined or item.create_docroot)

- name: Configure vhosts
  template:
    src: "{{ item.vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd


