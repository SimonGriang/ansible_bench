- name: Create temporary working directory
  ansible.builtin.tempfile:
    state: directory
  register: promtail_tmp_dir

- name: Download the latest release
  ansible.builtin.unarchive:
    src: "{{ download_url }}"
    dest: "{{ promtail_tmp_dir.path }}"
    remote_src: true
  register: promtail_download
  until: promtail_download is succeeded
  retries: 10
  delay: 5

- name: Verify the checksum
  ansible.builtin.command:
    cmd: "sha256sum {{ promtail_download.dest }}"
  register: promtail_checksum
  changed_when: false
  check_mode: false
  failed_when: promtail_checksum.stdout | regex_search('^[a-f0-9]{64}') is not defined

- name: Extract the archive
  ansible.builtin.unarchive:
    src: "{{ promtail_download.dest }}"
    dest: "{{ promtail_tmp_dir.path }}"
    remote_src: true
  register: promtail_extracted
  until: promtail_extracted is succeeded
  retries: 10
  delay: 5



