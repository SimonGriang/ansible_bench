---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure SELinux
  block:
    - name: Set SELinux state and policy
      ansible.posix.selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot
    - name: Manage SELinux booleans
      ansible.posix.selinux_boolean:
        name: "{{ item.name }}"
        state: "{{ item.state | default('yes') }}"
        persistent: "{{ item.persistent | default(false) }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.name }}"
      when: selinux_booleans is defined
  when:
    - ansible_selinux.status is defined
    - ansible_connection != 'docker'
    - ansible_connection != 'container'


