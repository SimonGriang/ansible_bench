---
- name: Hardening | Disable Swap
  when: vault_hardening_disable_swap | bool
  block:
    - name: Disable swap temporarily
      when: ansible_swaptotal_mb > 0
      ansible.builtin.command: swapoff -a
      changed_when: false
    - name: Disable swap permanently
      when: ansible_swaptotal_mb > 0
      ansible.builtin.replace:
        path: /etc/fstab
        regexp: '^\s*([^#\s]+)\s+swap\s+.*$'
        replace: '# \1 swap none defaults 0 0'
      changed_when: false

- name: Hardening | Disable Core Dumps
  when: vault_hardening_disable_core_dumps | bool
  community.general.pam_limits:
    domain: '*'
    limit_item: core
    limit_type: "{{ item.type }}"
    value: "{{ item.value }}"
  loop:
    - {type: hard, value: 0}
    - {type: soft, value: 0}

- name: Hardening | Disable Shell Command History
  when: vault_hardening_disable_shell_command_history | bool
  ansible.builtin.copy:
    src: vault.sh
    dest: /etc/profile.d/vault.sh
    mode: '0644'

- name: Hardening | Configure SELinux / AppArmor
  block:
    - name: Install SELinux policy package
      ansible.builtin.package:
        name: selinux-policy
        state: present
    - name: Set SELinux to targeted policy and enforcing state
      ansible.posix.selinux:
        policy: targeted
        state: enforcing
    - name: Enforce AppArmor
      ansible.builtin.command: aa-enforce /etc/apparmor.d/*
      changed_when: false


