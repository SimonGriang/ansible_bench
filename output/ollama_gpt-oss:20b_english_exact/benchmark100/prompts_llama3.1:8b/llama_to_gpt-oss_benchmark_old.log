- name: Gather basic system facts by executing a raw command to read /etc/os-release and store the output in a variable
  raw: cat /etc/os-release
  become: false
  register: bootstrap_facts

- name: Extract and set the distribution name and major version of the operating system from the gathered facts
  set_fact:
    bootstrap_distribution: "{{ item.distribution }}"
    bootstrap_distribution_major_version: "{{ item.major_version }}"
  loop:
