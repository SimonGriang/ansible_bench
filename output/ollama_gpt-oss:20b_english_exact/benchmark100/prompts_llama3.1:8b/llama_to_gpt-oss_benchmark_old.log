  when:
    - ansible_distribution == "Debian"
    - ansible_distribution_version is version("9", "<")
- name: Install Ansible package with default release
  apt:
    name: ansible
    state: present
    default_release: "{{ default_release }}"
  when:
    - ansible_distribution == "Debian"
    - ansible_distribution_version is version("9", "<")


