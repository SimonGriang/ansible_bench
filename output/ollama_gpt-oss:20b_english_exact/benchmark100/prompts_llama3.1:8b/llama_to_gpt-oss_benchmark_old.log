- name: Configure Apache2 modules and locations
  become: true
  block:
    - name: Enable specific Apache2 modules
      community.general.apache2_module:
        name: "{{ item }}"
        state: present
      loop:
        - proxy
        - proxy_http
      when: ansible_os_family in ['Debian', 'Suse']
    - name: Configure Apache2 locations
      ansible.builtin.template:
        src: location.conf.j2
        dest: "{{ httpd_config_dir }}/{{ item.name }}.conf"
        mode: '0644'
      loop: "{{ httpd_locations }}"
      loop_control:
        label: "{{ item.name }}"
      notify:
        - Test httpd
        - Restart httpd


