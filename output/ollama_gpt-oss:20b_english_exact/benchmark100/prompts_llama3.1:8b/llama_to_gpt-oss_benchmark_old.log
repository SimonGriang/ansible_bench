---
- name: Import the assert.yml file.
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install the PHP packages.
  ansible.builtin.package:
    name: "{{ php_packages }}"

- name: Find the location of the used php.ini file.
  ansible.builtin.command:
    cmd: "{{ php_ini_command }}"
  register: php_found_ini_location
  changed_when: false

- name: Configure the PHP settings.
  ansible.builtin.template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
    mode: "0644"
  notify: httpd_restart


