---
- hosts: all
  gather_facts: true
  tasks:
    - name: Import assert.yml
      import_tasks: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Enable redis module stream (RHEL 8)
      ansible.builtin.dnf:
        name: redis
        state: present

    - name: Install redis
      ansible.builtin.package:
        name: "{{ redis_packages }}"
        state: present

    - name: Configure redis
      ansible.builtin.template:
        src: redis.conf.j2
        dest: "{{ redis_config_dir }}/redis.conf"
        owner: "{{ redis_owner }}"
        group: "{{ redis_group }}"
        mode: "{{ redis_mode }}"
      notify: Restart redis

    - name: Start and enable redis
      ansible.builtin.service:
        name: "{{ redis_service }}"
        state: started
        enabled: true

  handlers:
    - name: Restart redis
      ansible.builtin.service:
        name: "{{ redis_service }}"
        state: restarted


