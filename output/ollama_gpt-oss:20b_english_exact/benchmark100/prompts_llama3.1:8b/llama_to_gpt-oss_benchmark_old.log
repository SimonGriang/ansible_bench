---
- name: Import assert.yml file into the playbook
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install python pip packages
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_packages }}"

- name: Configure pip proxy settings
  lineinfile:
    path: /etc/pip.conf
    regexp: '^proxy='
    line: "proxy={{ python_pip_proxy }}"
    insertafter: '^\[global\]$'
    state: present
  when: python_pip_proxy is defined

- name: Configure pip trusted host settings
  lineinfile:
    path: /etc/pip.conf
    regexp: '^trusted-host='
    line: "trusted-host={{ python_pip_trusted_host }}"
    insertafter: '^\[global\]$'
    state: present
  when: python_pip_trusted_host is defined

- name: Update pip to the specified version
  pip:
    name: "pip=={{ python_pip_pip_package }}"
    state: present
  when: >
    python_pip_update is defined and
    ansible_distribution_release not in ['bookworm', 'noble'] and
    ansible_os_family != 'Alpine'

- name: Install requested Python modules
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when: >
    ansible_distribution_release not in ['bookworm', 'noble'] and
    ansible_os_family != 'Alpine'


