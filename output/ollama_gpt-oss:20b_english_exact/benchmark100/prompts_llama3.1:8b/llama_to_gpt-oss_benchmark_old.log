---
- name: Import assert.yml file into the playbook
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for a specified port to become available
  ansible.builtin.wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - bootstrap_wait_for_host is defined
    - bootstrap_wait_for_host
    - ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare the system for further tasks
  become: '{{ bootstrap_become }}'
  block:
    - name: Check if connection is established
      ansible.builtin.command: "true"
      register: bootstrap_connect
      changed_when: false
    - name: Gather bootstrap facts
      ansible.builtin.import_tasks: gather_facts.yml
      when: bootstrap_connect is failed
    - name: Install bootstrap packages (raw)
      ansible.builtin.raw: '{{ bootstrap_facts_packages | join(" ") }}'
      when: not bootstrap_become
      changed_when: false

- name: Gather Ansible facts about the system
  ansible.builtin.setup:
  register: system_facts

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
  become: '{{ bootstrap_become }}'


