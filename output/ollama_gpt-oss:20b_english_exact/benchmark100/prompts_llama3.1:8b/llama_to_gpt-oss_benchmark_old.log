---
- name: Check the current version of docker-compose
  ansible.builtin.command: docker-compose --version
  register: docker_compose_vsn
  changed_when: false

- name: Extract the version number from the docker-compose output
  ansible.builtin.set_fact:
    docker_compose_current_version: >-
      {{ docker_compose_vsn.stdout | regex_search('([0-9]+\\.[0-9]+\\.[0-9]+)') }}

- name: >-
    Remove the existing docker-compose version if it's
    different from the required version
  ansible.builtin.file:
    path: "{{ docker_compose_path }}"
    state: absent
  when:
    - docker_compose_current_version is defined
    - docker_compose_current_version != docker_compose_version

- name: >-
    Download and install Docker Compose if it's not already installed or
    if the current version is outdated
  ansible.builtin.get_url:
    url: "{{ docker_compose_url }}"
    dest: "{{ docker_compose_path }}"
    mode: '0755'
  when:
    - docker_compose_current_version is not defined
    - docker_compose_current_version != docker_compose_version


