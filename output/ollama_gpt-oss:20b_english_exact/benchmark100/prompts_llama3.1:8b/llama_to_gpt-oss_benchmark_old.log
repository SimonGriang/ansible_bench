---
- hosts: all
  vars:
    helm_download_url: "{{ helm_repo_path }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}"
  tasks:
    - name: Check if the Helm binary exists at the specified path.
      stat:
        path: "{{ helm_bin_path }}"
      register: helm_check

    - name: Check the current version of Helm installed on the system.
      command: "{{ helm_bin_path }} version"
      register: helm_existing_version
      changed_when: false
      failed_when: false

    - name: Download the Helm binary from the specified repository.
      get_url:
        url: "{{ helm_download_url }}"
        dest: "/tmp/helm"
      register: helm_download
      when: >
        not helm_check.stat.exists or
        helm_existing_version.stdout is not defined or
        helm_version not in helm_existing_version.stdout

    - name: Copy the downloaded Helm binary into place at the specified path.
      copy:
        src: "/tmp/helm"
        dest: "{{ helm_bin_path }}"
        mode: '0755'
      become: true
      when: helm_download is defined and helm_download.changed


