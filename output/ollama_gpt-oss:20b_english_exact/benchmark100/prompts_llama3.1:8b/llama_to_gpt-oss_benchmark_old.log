---
- name: Import necessary tasks for package manager assert
  ansible.builtin.import_tasks: assert.yml

- name: Configure package management for package manager apk
  ansible.builtin.shell: |
    apk update
    apk upgrade -a
  when: ansible_pkg_mgr == 'apk'

- name: Configure package management for package manager apt
  ansible.builtin.shell: |
    apt-mark hold {{ packages_to_hold | join(' ') }}
    apt-get update && apt-get upgrade -y && apt-get autoremove -y
  args:
    warn: false
  when: ansible_pkg_mgr == 'apt'

- name: Update all software for package manager dnf
  ansible.builtin.dnf:
    name: '*'
    state: latest
    exclude: "{{ packages_to_exclude | join(',') }}"
  when: ansible_pkg_mgr == 'dnf'

- name: Update all software for package manager pacman
  ansible.builtin.shell: pacman -Syu --noconfirm
  when: ansible_pkg_mgr == 'pacman'

- name: Configure package management for package manager yum
  block:
    - name: Update all software using dnf
      ansible.builtin.command: dnf upgrade -y
      when: ansible_pkg_mgr_version is defined and ansible_pkg_mgr_version | int > 6
    - name: Install yum-utils for non-6 yum versions
      ansible.builtin.yum:
        name: yum-utils
        state: present
      when: ansible_pkg_mgr_version is not defined or ansible_pkg_mgr_version | int != 6
  when: ansible_pkg_mgr == 'yum'

- name: Update all software for package manager zypper
  ansible.builtin.zypper:
    name: '*'
    state: latest
  when: ansible_pkg_mgr == 'zypper'


