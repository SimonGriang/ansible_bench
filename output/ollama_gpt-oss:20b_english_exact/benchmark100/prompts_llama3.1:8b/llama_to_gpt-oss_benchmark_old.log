---
- hosts: localhost
  become: true
  tasks:
    - name: "Task 1: Create etcd group"
      group:
        name: etcd
        system: true
        state: present

    - name: "Task 2: Create etcd user"
      user:
        name: etcd
        comment: etcd user
        group: etcd
        home: /var/lib/etcd
        create_home: false
        system: true
        shell: /usr/sbin/nologin
        state: present

    - name: "Task 3: Ensure etcd systemd unit is present"
      command: systemctl enable etcd

    - name: "Task 4: Set hardening_src variable"
      set_fact:
        hardening_src: >-
          {{ (share_writable.rc == 0 and command_result.rc == 0) | ternary(
            '/usr/local/share/hardening.conf',
            '/etc/hardening.conf'
          ) }}

    - name: "Task 5: Copy hardening configuration file"
      copy:
        src: "{{ hardening_src }}"
        dest: /etc/hardening.conf
        owner: root
        group: root
        mode: '0644'
      notify: Restart systemd-sysctl

    - name: "Task 6: Flush handlers"
      meta: flush_handlers

  handlers:
    - name: Restart systemd-sysctl
      systemd:
        name: systemd-sysctl
        state: restarted
        daemon_reload: true
