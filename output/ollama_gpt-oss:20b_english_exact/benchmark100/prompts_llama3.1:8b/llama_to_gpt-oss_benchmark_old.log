---
- name: Import assert.yml from the current directory into the playbook and run it once on the localhost
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Uninstall the systemd-logger package
  package:
    name: systemd-logger
    state: absent

- name: Install rsyslog and its required packages
  package:
    name: "{{ ['rsyslog'] + rsyslog_packages | default([]) }}"
    state: present

- name: Install additional rsyslog features or packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features | default([]) }}"

- name: Configure the default rsyslog configuration if specified by the rsyslog_deploy_default_config variable
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    mode: '0644'
  notify: Restart rsyslog
  when: rsyslog_deploy_default_config | default(false)

- name: Create the /etc/rsyslog.d/ directory with proper permissions
  file:
    path: /etc/rsyslog.d
    state: directory
    mode: '0755'

- name: Configure a forward rule for rsyslog if the default configuration is not being deployed
  template:
