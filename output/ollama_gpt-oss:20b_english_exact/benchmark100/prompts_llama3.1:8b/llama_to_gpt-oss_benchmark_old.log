---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'
- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'
- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'
- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config_source }}"
    dest: "{{ rke2_config_dest }}"
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_source }}"
    dest: "{{ rke2_kubelet_config_dest }}"
    owner: root
    group: root
    mode: '0644'
  when: rke2_kubelet_config != ''
  notify: Config file changed
- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_registry_config_source }}"
    dest: "{{ rke2_registry_config_dest }}"
    owner: root
    group: root
    mode: '0644'
  when: rke2_custom_registry_mirrors != '' or rke2_custom_registry_configs != ''
  notify: Config file changed
- name: Start RKE2 service on the rest of the nodes
  service:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: true
  register: rke2_service_result
  until: rke2_service_result is succeeded
  retries: 5
  delay: 10
  notify: Service (re)started
- name: Mask other RKE2 service on the rest of the nodes
  service:
    name: "{{ item }}"
    enabled: false
    masked: true
  loop: "{{ rke2_other_services }}"
  when: item != rke2_type
- name: Wait for remaining nodes to be ready - no CNI
  command: |
    kubectl get nodes {{ item }} \
      -o jsonpath={.status.conditions[?(@.type=='Ready')].status}
  register: node_ready_status
  until: node_ready_status.stdout == 'True'
  retries: 5
  delay: 10
  loop: "{{ groups[rke2_nodes_group] }}"
- name: Wait for remaining nodes to be ready - with CNI
  command: |
    kubectl get nodes --field-selector spec.role=controlplane \
      -o jsonpath={.items[*].status.conditions[?(@.type=='Ready')].status}
  register: ready_nodes
  until: ready_nodes.stdout | regex_findall('True') | length == groups[rke2_nodes_group] | length
  retries: 5
  delay: 10


