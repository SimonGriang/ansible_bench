---
- name: Example Playbook
  hosts: all
  become: true

  vars:
    docker_user: docker
    docker_group: docker
    helm_repo: https://github.com/kubernetes-sigs/kubespray
    kubespray_version:          # <-- set this in your inventory or elsewhere
    helm_download_url: "{{ helm_repo }}/{{ kubespray_version }}/helm"

    compose_version:            # <-- set this in your inventory or elsewhere
    compose_download_url_raw: |
      https://github.com/docker/compose/releases/download/{{ compose_version }}
      /docker-compose
    compose_download_url: "{{ compose_download_url_raw | replace('\n', '') }}"

    docker_repo_raw: |
      deb [arch=amd64] https://download.docker.com/linux/{{ ansible_distribution | lower }}
      {{ ansible_lsb.codename }} stable
    docker_repo: "{{ docker_repo_raw | replace('\n', '') }}"

  tasks:
    # -----------------------------------------------------------------------
    # 1. Install Docker CE
    # -----------------------------------------------------------------------
    - name: Install Docker CE
      apt:
        name: docker-ce
        state: present
        update_cache: true
      tags: [docker]

    # -----------------------------------------------------------------------
    # 2. Create Docker user & group
    # -----------------------------------------------------------------------
    - name: Create Docker user
      user:
        name: "{{ docker_user }}"
        group: "{{ docker_group }}"
        create_home: no
        shell: /bin/bash
        state: present
      tags: [docker]

    - name: Create Docker group
      group:
        name: "{{ docker_group }}"
        state: present
      tags: [docker]

    # -----------------------------------------------------------------------
    # 3. Add Docker repository
    # -----------------------------------------------------------------------
    - name: Add Docker repository
      apt_repository:
        repo: "{{ docker_repo }}"
        state: present
        update_cache: true
      tags: [docker]

    # -----------------------------------------------------------------------
    # 4. Create daemon configuration
    # -----------------------------------------------------------------------
    - name: Create Docker daemon configuration directory
      file:
        path: /etc/docker
        state: directory
        owner: root
        group: root
        mode: '0755'
      tags: [docker]

    - name: Create Docker daemon configuration file
      copy:
        dest: /etc/docker/daemon.json
        content: |-
          {
            "experimental": true,
            "live-restore": true,
            "log-opts": {
              "max-size": "200m",
              "max-file": "5"
            },
            "storage-driver": "overlay2",
            "storage-opts": [
              "overlay2.override_kernel_check=true"
            ]
          }
      tags: [docker]

    # -----------------------------------------------------------------------
    # 5. Restart Docker service
    # -----------------------------------------------------------------------
    - name: Restart Docker service
      service:
        name: docker
        state: started
        enabled: true
      tags: [docker]

    # -----------------------------------------------------------------------
    # 6. Install Docker Compose
    # -----------------------------------------------------------------------
    - name: Install Docker Compose
      get_url:
        url: "{{ compose_download_url }}"
        dest: /usr/local/bin/docker-compose
        mode: '0755'
      tags: [docker]

    # -----------------------------------------------------------------------
    # 7. Install Helm
    # -----------------------------------------------------------------------
    - name: Install Helm
      get_url:
        url: "{{ helm_download_url }}"
        dest: /usr/local/bin/helm
        mode: '0755'
      tags: [helm]



