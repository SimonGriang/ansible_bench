---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0755'

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local_src }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0755'
  when: "{{ rke2_airgap_mode and rke2_implementation == 'copy' }}"

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: '0755'
  when: "{{ rke2_airgap_mode and rke2_implementation != 'exists' }}"

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download checksum and artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_dir }}/{{ item }}"
        mode: '0644'
      loop: "{{ rke2_artifact_files }}"
  rescue:
    - name: Copy local checksum and artifacts
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_artifacts_dir }}/{{ item | basename }}"
        mode: '0644'
      loop: "{{ rke2_local_artifact_files }}"
  when: "{{ rke2_airgap_mode and rke2_implementation == 'download' }}"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create directory for additional images tarballs
      file:
        path: "{{ rke2_additional_tarballs_dir }}"
        state: directory
        mode: '0755'
    - name: Copy RKE2 components to additional tarballs directory
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_additional_tarballs_dir }}/{{ item | basename }}"
        mode: '0644'
      loop: "{{ rke2_additional_tarballs }}"
  when: "{{ rke2_airgap_mode and rke2_implementation != 'exists' and rke2_additional_tarballs is defined and rke2_additional_tarballs | length > 0 }}"

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke2_artifacts_dir }}/{{ item }}"
    state: file
    mode: '0644'
  loop: "{{ rke2_artifact_files }}"
  when: "{{ rke2_airgap_mode and rke2_implementation == 'exists' }}"

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: "{{ rke2_fs_path }}"
  register: fs_stat

- name: Check if separate partition
  shell: "grep '^{{ rke2_fs_path }}' /proc/mounts | wc -l"
  register: partition_check

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: >-
      {% if (fs_stat.stat.writable is defined and fs_stat.stat.writable) %}
      /usr/local/bin
      {% else %}
      /opt/rke2/bin
      {% endif %}
  when: "{{ rke2_fs_path is defined }}"

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }}/rke2 --version && systemctl status rke2-server"
  register: rke2_version_output

- name: Set RKE2 versions
  set_fact:
    rke2_desired_version: "{{ rke2_version_desired }}"
    rke2_installed_version: "{{ rke2_version_output.stdout | regex_search('v([\\d\\.]+)') | first }}"
  when: rke2_version_output.stdout is defined

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "rke2_installed_version is version(rke2_desired_version, '>=')"
    fail_msg: "Installed RKE2 version {{ rke2_installed_version }} is older than desired {{ rke2_desired_version }}"

- name: Run RKE2 install script
  shell: "{{ rke2_install_script_path }} --version {{ rke2_desired_version }}"
  args:
    creates: "{{ rke2_bin_path }}/rke2"
  when: "{{ rke2_installed_version != rke2_desired_version }}"

- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_custom_manifests_src }}"
    dest: "{{ rke2_custom_manifests_dest }}"
    mode: '0644'
  when: "{{ rke2_custom_manifests is defined and rke2_custom_manifests | length > 0 }}"

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_src }}"
    dest: "{{ rke2_static_pods_dest }}"
    mode: '0644'
  when: "{{ rke2_static_pods is defined and rke2_static_pods | length > 0 }}"

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file_src }}"
    dest: "{{ rke2_env_file_dest }}"
    mode: '0644'
  when: "{{ rke2_environment_options is defined and rke2_environment_options | length > 0 }}"


