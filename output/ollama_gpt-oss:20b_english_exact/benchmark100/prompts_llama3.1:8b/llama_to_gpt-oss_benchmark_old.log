---
- name: Import Java Asserts and Setup Local Task Execution
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Bash
  ansible.builtin.package:
    name: bash
    state: present

- name: Install OpenJDK Java (Package)
  ansible.builtin.package:
    name: openjdk-8-jdk
    state: present
  environment:
    USE: "X -cups -alsa -fontconfig"
  when: java_vendor == 'openjdk'

- name: Install RPM (Local Java Source)
  ansible.builtin.dnf:
    name: "{{ java_package_path }}"
    state: present
  when: java_source == 'local' and java_format == 'rpm'

- name: Install DEB (Local Java Source)
  ansible.builtin.apt:
    name: "{{ java_package_path }}"
    state: present
    update_cache: true
  when: java_source == 'local' and java_format == 'deb'

- name: Install Oracle Java (RPM) (Repository)
  ansible.builtin.dnf:
    name: oracle-java
    state: present
  when: java_source == 'repository' and java_format == 'rpm'

- name: Configure Oracle Targz
  when: java_format == 'targz' and java_vendor == 'oracle'
  block:
    - name: Create java install directory
      ansible.builtin.file:
        path: "{{ java_install_directory }}"
        state: directory
        mode: '0755'
    - name: Unarchive java package
      ansible.builtin.unarchive:
        src: "{{ java_package_path }}"
        dest: "{{ java_install_directory }}"
        remote_src: true
        creates: "{{ java_install_directory }}/bin/java"

- name: Install Oracle Java Policy Software (Targz)
  ansible.builtin.unarchive:
    src: "{{ java_policy_package_path }}"
    dest: "{{ java_install_directory }}/lib/security"
    remote_src: true
  when: java_jce and java_version == 8 and java_vendor == 'oracle'

- name: Set Alternative (Targz)
  community.general.alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_install_directory }}/bin/java"
  when:
    - java_format == 'targz'
    - ansible_distribution != 'Alpine'
    - java_vendor == 'oracle'

- name: Find JAVA_HOME
  ansible.builtin.shell: |
    set -o pipefail
    readlink -f /usr/bin/java | sed 's:/bin/java::'
  register: java_home
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  ansible.builtin.copy:
    dest: /etc/profile.d/java_home.sh
    content: "export JAVA_HOME={{ java_home.stdout }}"
    mode: '0644'


