---
- name: Import assert.yml file
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install prerequisites
  package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  copy:
    dest: /etc/vault.d/vault.env
    content: "{{ vault_environment_settings | dict2items | map('join', '=') | join('\n') }}"
    mode: '0644'
    owner: root
    group: root

- name: Restart Vault service
  service:
    name: vault
    state: restarted

- name: Include hardening tasks
  include_tasks: hardening.yml

- name: Start and enable vault on OSS
  service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"

- name: Enable vault (non-OSS)
  service:
    name: vault
    enabled: true
  when: vault_type != "oss"


