---
- name: Create local ssh key directory for a user.
  ansible.builtin.file:
    path: "{{ user_ssh_key_dir }}"
    state: directory
    mode: '0750'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Manage the user account.
  ansible.builtin.user:
    name: "{{ user_name }}"
    comment: "{{ user_comment }}"
    group: "{{ user_group }}"
    create_home: "{{ create_home | bool }}"
    password: "{{ user_password }}"
    expire: "{{ user_password_expire | default(omit) }}"

- name: Set up the user's sudo options.
  block:
    - name: Generate sudoers file
      ansible.builtin.template:
        src: sudoers.j2
        dest: "/etc/sudoers.d/{{ user_name }}"
        mode: '0440'
        owner: root
        group: root
      when: user_sudo_options is defined
    - name: Remove sudoers file
      ansible.builtin.file:
        path: "/etc/sudoers.d/{{ user_name }}"
        state: absent
      when: user_sudo_options is not defined

- name: Generate the user's private SSH key.
  ansible.builtin.command: |
    ssh-keygen -t rsa \
      -b 4096 \
      -f {{ user_ssh_key_dir }}/id_rsa \
      -N ''
  args:
    creates: "{{ user_ssh_key_dir }}/id_rsa"
  when: user_ssh_key_manage is defined and user_ssh_key_manage

- name: Generate the user's public SSH key.
  ansible.builtin.command: |
    ssh-keygen -y \
      -f {{ user_ssh_key_dir }}/id_rsa \
      > {{ user_ssh_key_dir }}/id_rsa.pub
  args:
    creates: "{{ user_ssh_key_dir }}/id_rsa.pub"
  when: user_ssh_key_manage is defined and user_ssh_key_manage

- name: Convert the user's SSH key to PPK format.
  ansible.builtin.command: |
    puttygen {{ user_ssh_key_dir }}/id_rsa \
      -O private \
      -o {{ user_ssh_key_dir }}/id_rsa.ppk
  args:
    creates: "{{ user_ssh_key_dir }}/id_rsa.ppk"
  when: user_ssh_key_manage is defined and user_ssh_key_manage

- name: Get or set the user's home directory.
  ansible.builtin.set_fact:
    user_home: >-
      {{
        lookup('pipe', 'getent passwd ' ~ user_name ~ ' | cut -d: -f6')
          | default('/home/' ~ user_name)
      }}

- name: Create the user's .ssh directory.
  ansible.builtin.file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Deploy authorized keys for the user.
  ansible.posix.authorized_key:
    user: "{{ user_name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user_authorized_keys }}"
  when: user_authorized_keys is defined

- name: Remove unauthorized keys for the user.
  ansible.posix.authorized_key:
    user: "{{ user_name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user_unauthorized_keys }}"
  when: user_unauthorized_keys is defined

- name: Copy the generated private SSH key for the user.
  ansible.builtin.copy:
    src: "{{ user_ssh_key_dir }}/id_rsa"
    dest: "{{ user_home }}/id_rsa"
    owner: "{{ user_name }}"
    group: "{{ user_group }}"
    mode: '0400'
  when: user_copy_private_key is defined and user_copy_private_key

- name: Check the user's password validity.
  ansible.builtin.command: "chage -l {{ user_name }} | grep 'Password expires'"
  register: users_pw_valid
  changed_when: false

- name: Set the user's password validity.
  ansible.builtin.command: "chage -M {{ user_password_validity }} {{ user_name }}"
  when: user_password_validity is defined
  changed_when: false

- name: Place the private key file for the user.
  ansible.builtin.copy:
    src: "{{ user_ssh_key_dir }}/{{ item }}"
    dest: "{{ user_home }}/{{ item }}"
    owner: "{{ user_name }}"
    group: "{{ user_group }}"
    mode: '0400'
  loop: "{{ user_private_keys }}"
  when: user_private_keys is defined


