---
- name: Import assert.yml file
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: >
    ansible_connection is defined and
    ansible_connection not in ['container', 'docker', 'community.docker.docker'] and
    ansible_connection is not none and
    bootstrap_wait_for_host

- name: Prepare system
  block:
    - name: Connection test
      command: echo connection test
      register: conn_test
      ignore_errors: true
    - name: Sudo test
      command: sudo -n true
      register: sudo_test
      ignore_errors: true
  rescue:
    - name: Gather bootstrap facts
      setup:
      when: conn_test.failed
    - name: Install bootstrap packages (raw)
      raw: "{{ bootstrap_raw_command }}"
      when: sudo_test.failed
    - name: Ensure libdnf5 is present on Fedora/RedHat
      package:
        name: libdnf5
        state: present
      when: sudo_test.failed and ansible_os_family == 'RedHat' and ansible_distribution_major_version|int >= 8
  become: true

- name: Gather ansible facts
  setup:
    gather_subset: all
  become: false

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become }}"



