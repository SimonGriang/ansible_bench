---
- name: Task 1: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: "{{ 'temurin' if java_jdk_vendor == 'adoptopenjdk' else java_jdk_vendor }}"

- name: Task 2: Gather OS specific variables
  include_vars: "{{ java_jdk_vendor }}_{{ ansible_distribution | lower }}_{{ ansible_distribution_major_version }}.yml"

- name: Task 3: Gather architecture specific variables
  include_vars: architecture.yml

- name: Task 4: Set OS-specific variables (I)
  set_fact:
    java_open_jdk_home: "{{ java_open_jdk_home | default('') }}"
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('') }}"

- name: Task 5: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('') }}"

- name: Task 6: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home | default('') }}"

- name: Task 7: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "ppa:deprecated"
        state: absent
    - name: Install extra apt tools
      apt:
        name: apt-transport-https
        state: present
        update_cache: yes
    - name: Add required key repositories
      apt_key:
        url: https://example.com/key.gpg
        state: present
    - name: Add required repositories
      apt_repository:
        repo: "deb https://example.com/deb stable main"
        state: present

- name: Task 8: RedHat pre-requisites
  block:
    - name: Add required key repositories
      rpm_key:
        state: present
        key: https://example.com/key.gpg
    - name: Add required repositories
      yum_repository:
        name: example
        description: Example Repo
        baseurl: https://example.com/yum
        enabled: 1
        gpgcheck: 1
        gpgkey: https://example.com/key.gpg

- name: Task 9: Install required libs
  package:
    name:
      - libx11
      - libxext
    state: present

- name: Task 10: Install Java, Debian
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
    update_cache: yes
  when: ansible_os_family == "Debian"

- name: Task 11: Install Java, RedHat
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Task 12: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0644'

- name: Task 13: Source environment variables
  shell: source /etc/profile
  args:
    executable: /bin/bash
  when: ansible_os_family in ['Debian', 'RedHat']

- name: Task 14: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  file:
    src: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java"
    dest: "/usr/bin/java"
    state: link
    force: yes
  when: java_version | int < 11

- name: Task 15: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  file:
    src: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java"
    dest: "/usr/bin/java"
    state: link
    force: yes
  when: java_version | int >= 11


