---
- name: "Task 1: Import assert.yml"
  ansible.builtin.include_tasks: assert.yml

- name: "Task 2: Install required software"
  ansible.builtin.package:
    name: "{{ users_requirements }}"
    state: present

- name: "Task 3: Loop over users_groups"
  ansible.builtin.include_tasks: group.yml
  loop: "{{ users_groups }}"

- name: "Task 4: Ensure the /etc/sudoers.d directory is included"
  ansible.builtin.lineinfile:
    path: /etc/sudoers
    line: "{{ users_sudo_includedir }}"
    state: present
    create: true
    mode: '0440'

- name: "Task 5: Loop over users"
  ansible.builtin.include_tasks: user.yml
  loop: "{{ users }}"

- name: "Task 6: Manage cron permission"
  ansible.builtin.template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow is defined

- name: "Task 7: Check existence of /etc/cron.allow"
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is not defined


