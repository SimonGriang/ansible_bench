- name: Install epel package repositories for compatible operating systems (RedHat-based and Amazon Linux)
  yum_repository:
    name: epel
    description: Extra Packages for Enterprise Linux
    baseurl: https://dl.fedoraproject.org/pub/epel/$releasever/$basearch
    enabled: true
    gpgcheck: true
