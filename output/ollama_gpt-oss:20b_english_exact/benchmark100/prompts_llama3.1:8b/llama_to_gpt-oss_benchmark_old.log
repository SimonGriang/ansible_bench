---
- name: Restart RKE2 service on a node
  service:
    name: "{{ rke2_node_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: |
    rke2 kubectl get nodes --no-headers | grep -c 'Ready'
  register: all_ready_nodes
  retries: 100
  delay: 15
  until: all_ready_nodes.stdout | int == (groups[rke2_servers_group_name] | length)
  run_once: true
  when: not ansible_check_mode
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

- name: Wait for all pods to be ready again
  shell: |
    rke2 kubectl get pods --all-namespaces --no-headers | grep -vE 'Running|Succeeded' | wc -l
  register: all_pods_ready
  retries: 100
  delay: 15
  until: all_pods_ready.stdout | int == 0
  run_once: true
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready | bool
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"


