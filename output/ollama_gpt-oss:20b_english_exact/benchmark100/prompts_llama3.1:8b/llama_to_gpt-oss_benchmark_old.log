---
- name: Lookup bootstrap facts by running the `cat /etc/os-release` command.
  ansible.builtin.raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: Set bootstrap distribution and major version facts.
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_major_version: "{{ item.value.major_version | default('') }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: bootstrap_facts.stdout is search(item.key)

- name: Set bootstrap OS family fact.
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.value.os_family | default('') }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: bootstrap_distribution == item.key


