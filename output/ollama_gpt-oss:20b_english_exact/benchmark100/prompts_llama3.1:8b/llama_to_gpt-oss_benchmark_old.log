---
- name: Import assert.yml and run it once on localhost
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install the mysql package
  ansible.builtin.package:
    name: mysql
    state: present

- name: Configure the mysql server
  ansible.builtin.template:
    src: mysql_server.cnf.j2
    dest: "{{ mysql_config_dir }}/{{ mysql_name }}-server.cnf"
    mode: '0644'

- name: Configure the mysql client
  ansible.builtin.template:
    src: mysql_client.cnf.j2
    dest: "{{ mysql_config_dir }}/{{ mysql_name }}-client.cnf"
    mode: '0644'

- name: Initialize the mysql service
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']
  become: true
  changed_when: false

- name: Start and enable the mysql service
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Create a my.cnf file in the /root/.my.cnf directory
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf/my.cnf
    mode: '0644'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ db.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  loop_control:
    loop_var: db

- name: List databases on the target machine
  community.mysql.mysql_info:

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ db.name }}"
    state: import
    target: "{{ db.initial_import }}"
  loop: "{{ mysql_databases }}"
  loop_control:
    loop_var: db
  when: db.initial_import is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ user.name }}"
    password: "{{ user.password }}"
    priv: "{{ user.priv }}"
    host: "{{ user.host | default('localhost') }}"
    state: present
  loop: "{{ mysql_users }}"
  loop_control:
    loop_var: user

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


