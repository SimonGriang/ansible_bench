- name: Cordon and Drain the node with the specified RKE2 node name.
  ansible.builtin.command: >-
    {{ rke2_data_path }}/bin/kubectl drain {{ rke2_node_name }}
    --ignore-daemonsets --delete-local-data {{ rke2_drain_additional_args }}
  register: drain_result
  failed_when: drain_result.rc != 0
  retries: 100
  delay: 15
  until: drain_result.rc == 0

- name: Restart the RKE2 service on the specified node.
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted

- name: Wait for all nodes to be ready again.
  ansible.builtin.shell: >-
    set -o pipefail;
    {{ rke2_data_path }}/bin/kubectl get nodes --no-headers | grep -v Ready | wc -l
  register: nodes_not_ready
  changed_when: false
  retries: 100
  delay: 15
  until: nodes_not_ready.stdout == '0'

- name: Uncordon the specified RKE2 node.
  ansible.builtin.command: >-
    {{ rke2_data_path }}/bin/kubectl uncordon {{ rke2_node_name }}
  register: uncordon_result
  failed_when: uncordon_result.rc != 0
  changed_when: uncordon_result.rc == 0

- name: Wait for all pods to be ready again.
  ansible.builtin.shell: >-
    set -o pipefail;
    {{ rke2_data_path }}/bin/kubectl get pods --all-namespaces --no-headers | grep -v Running | wc -l
  register: pods_not_running
  changed_when: false
  retries: 100
  delay: 15
  until: pods_not_running.stdout == '0'

- name: Wait for all pods to pass readiness checks.
  ansible.builtin.shell: >-
    set -o pipefail;
    {{ rke2_data_path }}/bin/kubectl wait --for=condition=Ready --all | {{ rke2_wait_for_all_pods_to_be_healthy_args }}
  register: wait_result
  failed_when: wait_result.rc != 0
  changed_when: false
  retries: 100
  delay: 15
  until: wait_result.rc == 0


