---
- name: Import necessary tasks for package manager assert
  ansible.builtin.import_tasks: assert.yml

- name: Configure package management for package manager apk
  vars:
    apk_state: latest
  community.general.apk:
    name: '*'
    state: "{{ apk_state }}"
    update_cache: true
  when: ansible_pkg_mgr == 'apk'

- name: Configure package management for package manager apt
  ansible.builtin.apt:
    name: "{{ packages_to_hold | default('*') }}"
    dpkg_options: hold
    upgrade: dist
    update_cache: true
    autoremove: true
  when: ansible_pkg_mgr == 'apt'

- name: Update all software for package manager dnf
  vars:
    dnf_state: latest
  ansible.builtin.dnf:
    name: '*'
    state: "{{ dnf_state }}"
    exclude: "{{ packages_to_exclude | default('') }}"
  when: ansible_pkg_mgr == 'dnf'

- name: Update all software for package manager pacman
  community.general.pacman:
    upgrade: true
    update_cache: true
  when: ansible_pkg_mgr == 'pacman'

- name: Configure package management for package manager yum
  vars:
    yum_state: latest
  ansible.builtin.yum:
    name:
      - '*'
      - yum-utils
    state: "{{ yum_state }}"
    update_cache: true
  when: ansible_pkg_mgr == 'yum'

- name: Update all software for package manager zypper
  vars:
    zypper_state: latest
  community.general.zypper:
    name: '*'
    state: "{{ zypper_state }}"
  when: ansible_pkg_mgr == 'zypper'


