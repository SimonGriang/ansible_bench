---
- name: Import and run tasks from assert.yml playbook
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages for the service
  ansible.builtin.package:
    name: "{{ service_required_packages }}"
    state: present

- name: Configure systemd service for each item in the service_list
  ansible.builtin.copy:
    src: systemd.j2
    dest: "/etc/systemd/system/{{ item.name }}.service"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ service_list }}"
  when: ansible_service_mgr == 'systemd'
  notify: Systemctl daemon-reload

- name: Configure sysvinit service for each item in the service_list
  ansible.builtin.copy:
    src: sysvinit.j2
    dest: "/etc/init.d/{{ item.name }}"
    owner: root
    group: root
    mode: '0755'
  loop: "{{ service_list }}"
  when: ansible_service_mgr in ['sysvinit', 'upstart', 'openrc']

- name: Manage each service in the service_list
  ansible.builtin.service:
    name: "{{ item.name }}"
    state: "{{ item.state | default(omit) }}"
    enabled: "{{ item.enabled | default(omit) }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


