---
- name: Task 1
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Task 2
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Task 3
  when: ansible_selinux.status == "enabled"
  block:
    - name: Enable SELinux booleans for httpd
      ansible.posix.seboolean:
        name: "{{ item }}"
        state: yes
        persistent: yes
      loop: "{{ httpd_sebooleans }}"
    - name: Allow httpd custom port
      ansible.posix.seport:
        port: "{{ httpd_port }}"
        protocol: tcp
        state: present
      when: httpd_port is defined
    - name: Allow httpd SSL port
      ansible.posix.seport:
        port: "{{ httpd_ssl_port }}"
        protocol: tcp
        state: present
      when: httpd_ssl_port is defined

- name: Task 4
  template:
    src: "{{ httpd_config_src }}"
    dest: "/etc/httpd/conf/httpd.conf"
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Task 5
  when: ansible_os_family == "Debian"
  block:
    - name: Activate httpd modules
      command: a2enmod {{ item }}
      loop: "{{ httpd_modules_to_activate_with_command }}"
      notify: Test httpd configuration validity

- name: Task 6
  when: https_ssl_enable is defined
  import_tasks: ssl.yml

- name: Task 7
  when: httpd_locations is defined
  import_tasks: locations.yml

- name: Task 8
  when: httpd_vhosts is defined
  import_tasks: vhosts.yml

- name: Task 9
  when: ansible_os_family in ["Debian", "Suse"]
  template:
    src: "{{ httpd_ports_conf }}"
    dest: "/etc/apache2/conf-available/custom_ports.conf"
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Task 10
  when: httpd_directories is defined
  import_tasks: directories.yml

- name: Task 11
  meta: flush_handlers

- name: Task 12
  when: httpd_remove_example is defined
  file:
    path: "/var/www/html/index.html"
    state: absent

- name: Task 13
  service:
    name: "{{ httpd_service_name | default('httpd') }}"
    state: started
    enabled: true

handlers:
  - name: Test httpd configuration validity
    command: apachectl -t
    ignore_errors: true

  - name: Restart httpd
    service:
      name: "{{ httpd_service_name | default('httpd') }}"
      state: restarted


