  when: (ansible_version.full is version('2.12', '>=')) and (ansible_os_family in ['RedHat', 'Debian'])
  package:
    name: docker-ce
    state: present
    allow_downgrade: yes

- name: Install docker-compose plugin on systems where the plugin is enabled and the system meets the criteria for task 4 or 5.
  when: docker_compose_enabled | default(false)
  package:
    name: docker-compose
    state: present

- name: Install the docker-compose-plugin (with downgrade option) on systems where the plugin is enabled and the system meets the criteria for task 5.
  when: docker_compose_enabled | default(false)
  package:
