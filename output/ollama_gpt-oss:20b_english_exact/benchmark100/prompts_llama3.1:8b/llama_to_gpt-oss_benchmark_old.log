l/index.html"\n    state: absent\n\n- name: Task 13\n  service:\n    name: "{{ httpd_service_name | default(\'httpd\') }}"\n    state: started\n    enabled: true\n\nhandlers:\n  - name: Test httpd configuration validity\n    command: apachectl -t\n    ignore_errors: true\n\n  - name: Restart httpd\n    service:\n      name: "{{ httpd_service_name | default(\'httpd\') }}"\n      state: restarted' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-14T02:44:57.783040614Z', 'done': True, 'done_reason': 'stop', 'total_duration': 24236359472, 'load_duration': 171371300, 'prompt_eval_count': 2441, 'prompt_eval_duration': 1687985361, 'eval_count': 2140, 'eval_duration': 22374700487, 'model_name': 'gpt-oss:20b'} id='run--3c0db68a-384d-433b-98e4-8288833deb32-0' usage_metadata={'input_tokens': 2441, 'output_tokens': 2140, 'total_tokens': 4581}
