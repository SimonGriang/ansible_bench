---
- name: Remove Docker GPG key from trusted.gpg.d if present
  apt_key:
    state: absent
    keyring: /etc/apt/trusted.gpg.d/docker.gpg

- name: Remove old Docker apt source list
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Uninstall old versions of Docker
  package:
    name:
      - docker
      - docker-engine
      - docker.io
      - containerd.io
    state: absent

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker-legacy.list
    state: absent

- name: Install required dependencies
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: true

- name: Add or remove Docker repository
  apt_repository:
    repo: >-
      deb [arch=amd64] https://download.docker.com/linux/ubuntu
      {{ ansible_distribution_release }} stable
    state: "{{ 'present' if docker_add_repo else 'absent' }}"
    filename: docker
  notify: apt update

- name: Notify apt update handler
  meta: flush_handlers


