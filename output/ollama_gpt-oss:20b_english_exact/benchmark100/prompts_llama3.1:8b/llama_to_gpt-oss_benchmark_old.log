---
- name: Import external tasks for assertion handling
  import_tasks: assert.yml

- name: Install the cron package
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell settings for cron jobs
  lineinfile:
    path: /etc/default/cron
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    state: present

- name: Configure the system path for cron jobs
  lineinfile:
    path: /etc/default/cron
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    state: present

- name: Configure the mail-to setting for cron jobs
  lineinfile:
    path: /etc/default/cron
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    state: present

- name: Start and enable the cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    user: "{{ item.user | default(omit) }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs }}"



