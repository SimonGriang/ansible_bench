---
- name: Run OpenVPN setup tasks
  hosts: all
  gather_facts: false
  tasks:
    - name: Import the assert.yml file from the current directory.
      ansible.builtin.import_tasks: assert.yml

    - name: |-
        Install the openvpn packages specified in the openvpn_packages variable.
      ansible.builtin.package:
        name: "{{ openvpn_packages }}"
        state: present

    - name: >-
        Set up the OpenVPN server or client based on the role specified in
        the openvpn_role variable.
      ansible.builtin.import_tasks: "{{ openvpn_role }}.yml"

    - name: Start the OpenVPN service and enable it to start at boot time.
      ansible.builtin.service:
        name: openvpn
        state: started
        enabled: true


