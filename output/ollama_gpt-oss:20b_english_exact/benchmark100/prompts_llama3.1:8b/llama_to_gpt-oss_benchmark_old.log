- name: Create the directory for RKE2 manifests
  file:
    path: "{{ rke2_manifests_dir }}"
    state: directory
    mode: "0755"
    owner: root
    group: root

- name: Copy kube-vip YAML files to the RKE2 manifests directory
  copy:
    src: "templates/kube-vip/{{ item }}"
    dest: "{{ rke2_manifests_dir }}/{{ item | basename | regex_replace('.j2$', '') }}"
    mode: "0644"
  loop: "{{ lookup('fileglob', 'templates/kube-vip/*.j2', wantlist=True) }}"

- name: Copy kube-vip load balancer manifests to the RKE2 manifests directory
  copy:
    src: "templates/kube-vip-loadbalancer/{{ item }}"
    dest: "{{ rke2_manifests_dir }}/{{ item | basename | regex_replace('.j2$', '') }}"
    mode: "0644"
  loop: "{{ lookup('fileglob', 'templates/kube-vip-loadbalancer/*.j2', wantlist=True) }}"
  when: rke2_kubevip_cloud_provider_enable | bool


