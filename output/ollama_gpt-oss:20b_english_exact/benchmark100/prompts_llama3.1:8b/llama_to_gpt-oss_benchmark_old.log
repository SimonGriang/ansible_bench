---
- hosts: all
  become: true
  tasks:
    - name: |-
        Install epel package repositories for compatible operating systems
        (RedHat-based and Amazon Linux)
      yum_repository:
        name: epel
        description: Extra Packages for Enterprise Linux
        baseurl: https://dl.fedoraproject.org/pub/epel/$releasever/$basearch
        enabled: true
        gpgcheck: true
        gpgkey: "{{ epel_gpg_key }}"
      when: "ansible_os_family == 'RedHat' or ansible_distribution == 'Amazon'"
      notify: Update package cache

    - name: Install the epel GPG key
      rpm_key:
        state: present
        key: "{{ epel_gpg_key }}"
      notify: Update package cache

    - name: Install the epel-release package
      yum:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache

    - name: Install the epel-next-release package (conditional)
      yum:
        name: epel-next-release
        state: present
      when: epel_next
      notify: Update package cache

  handlers:
    - name: Update package cache
      yum:
        update_cache: true


