---
- name: Import and execute tasks from assert.yml playbook fragment
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true
- name: Install logrotate package
  package:
    name: logrotate
    state: present
- name: Configure logrotate by rendering a template
  template:
    src: "{{ logrotate_config_dir }}/{{ logrotate_config_file }}.j2"
    dest: "{{ logrotate_config_dir }}/{{ logrotate_config_file }}"
    mode: '0644'
- name: Generate logrotate.d files using a template
  template:
    src: entry.j2
    dest: "{{ logrotate_conf_dir }}/{{ item.name }}"
  loop: "{{ logrotate_entries }}"
  when: item.state != 'absent'
  loop_control:
    label: "{{ item.name }}"
- name: Remove logrotate.d files
  file:
    path: "{{ logrotate_conf_dir }}/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  when: item.state == 'absent'
  loop_control:
    label: "{{ item.name }}"
- name: Manage logrotate service
  service:
    name: "{{ logrotate_service_name }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service_name != ''


