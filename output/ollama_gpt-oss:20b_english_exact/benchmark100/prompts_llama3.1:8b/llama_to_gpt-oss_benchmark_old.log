---
- name: Import assert.yml and run it once on localhost
  ansible.builtin.include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install the dns packages
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Create the required directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0755'
  loop:
    - "{{ dns_config_dir }}"
    - "{{ dns_data_dir }}"

- name: Create the required group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Create the required user
  ansible.builtin.user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    shell: /sbin/nologin
    create_home: false
    system: true

- name: Generate the rndc key
  ansible.builtin.command: rndc-confgen -a -c /etc/bind/rndc.key
  args:
    creates: /etc/bind/rndc.key

- name: Set permissions on the rndc key file
  ansible.builtin.file:
    path: /etc/bind/rndc.key
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0600'

- name: Download the named.root file
  ansible.builtin.get_url:
    url: https://www.internic.net/domain/named.root
    dest: /etc/bind/named.root
    mode: '0644'

- name: Create the zone file
  ansible.builtin.template:
    src: zone.j2
    dest: "{{ dns_zone_file }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0644'

- name: Add zones to the configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: "{{ dns_config_file }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0644'

- name: Place the systemd override
  ansible.builtin.template:
    src: override.conf.j2
    dest: /etc/systemd/system/bind9.service.d/override.conf
    owner: root
    group: root
    mode: '0644'
  notify: Reload systemd

- name: Start and enable the DNS service
  ansible.builtin.service:
    name: bind9
    state: started
    enabled: true


