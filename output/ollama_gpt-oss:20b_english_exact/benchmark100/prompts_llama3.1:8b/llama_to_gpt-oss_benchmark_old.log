---
- name: "Task 1: Import assert.yml task"
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: "Task 2: Install using package task"
  block:
    - name: "Task 2.1: Install repository for RedHat task"
      ansible.builtin.yum_repository:
        name: hashicorp
        description: HashiCorp stable repository
        baseurl: |-
          https://rpm.releases.hashicorp.com/RHEL/$releasever/$basearch/stable
        gpgcheck: true
        gpgkey: https://rpm.releases.hashicorp.com/gpg
        enabled: true
      when: ansible_os_family == "RedHat"

    - name: "Task 2.2: Configure Debian task"
      when: ansible_os_family == "Debian"
      block:
        - name: "Task 2.2.1: Install required package gpg task"
          ansible.builtin.apt:
            name: gnupg
            state: present

        - name: "Task 2.2.2: Install apt key for Debian task"
          ansible.builtin.apt_key:
            url: https://apt.releases.hashicorp.com/gpg
            state: present

        - name: "Task 2.2.3: Install repository for Debian task"
          ansible.builtin.apt_repository:
            repo: |
              deb [arch=amd64] https://apt.releases.hashicorp.com
              $(lsb_release -cs) main
            state: present

    - name: "Task 2.3: Install hashicorp product using package task"
      block:
        - name: >-
            Task 2.3.1: Install latest hashicorp product using package task
          ansible.builtin.package:
            name: hashicorp
            state: present
          when: hashicorp_version is not defined

        - name: >-
            Task 2.3.2: Install versioned hashicorp product using package task
          ansible.builtin.package:
            name: hashicorp
            state: present
          when: hashicorp_version is not defined

- name: "Task 3: Install manually task"
  ansible.builtin.debug:
    msg: "Manual install placeholder"


