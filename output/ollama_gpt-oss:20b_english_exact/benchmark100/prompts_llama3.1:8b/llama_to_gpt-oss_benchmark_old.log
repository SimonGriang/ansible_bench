content='---\n- hosts: all\n  gather_facts: true\n  tasks:\n    - name: Import assert.yml\n      import_tasks: assert.yml\n      run_once: true\n      delegate_to: localhost\n\n    - name: Enable redis module stream (RHEL 8)\n      ansible.builtin.dnf:\n        name: redis\n        state: present\n\n    - name: Install redis\n      ansible.builtin.package:\n        name: "{{ redis_packages }}"\n        state: present\n\n    - name: Configure redis\n      ansible.builtin.template:\n        src: redis.conf.j2\n        dest: "{{ redis_config_dir }}/redis.conf"\n        owner: "{{ redis_owner }}"\n        group: "{{ redis_group }}"\n        mode: "{{ redis_mode }}"\n      notify: Restart redis\n\n    - name: Start and enable redis\n      ansible.builtin.service:\n        name: "{{ redis_service }}"\n        state: started\n        enabled: true\n\n  handlers:\n    - name: Restart redis\n      ansible.builtin.service:\n        name: "{{ redis_service }}"\n        state: restarted' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-14T02:54:35.861378591Z', 'done': True, 'done_reason': 'stop', 'total_duration': 24654590065, 'load_duration': 186513226, 'prompt_eval_count': 1721, 'prompt_eval_duration': 975907719, 'eval_count': 2279, 'eval_duration': 23490564290, 'model_name': 'gpt-oss:20b'} id='run--28c9272e-c31a-4756-8b94-51f789256a80-0' usage_metadata={'input_tokens': 1721, 'output_tokens': 2279, 'total_tokens': 4000}
