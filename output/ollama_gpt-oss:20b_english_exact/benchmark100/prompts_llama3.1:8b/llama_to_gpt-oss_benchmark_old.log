---
- name: Set the package state based on how Ansible is installed
  ansible.builtin.set_fact:
    ansible_pkg_state: >-
      "{{ (ansible_install_method | default('package')) == 'pip' |
         ternary('latest', 'present') }}"
- name: Set up Ansible on RedHat
  ansible.builtin.package:
    name:
      - ansible
      - python3
      - python3-pip
    state: "{{ ansible_pkg_state }}"
  when: ansible_os_family == 'RedHat' and ansible_distribution != 'Fedora'
- name: Set up Ansible on Fedora
  ansible.builtin.dnf:
    name:
      - ansible
      - python3
      - python3-pip
    state: "{{ ansible_pkg_state }}"
  when: ansible_distribution == 'Fedora'
- name: Set up Ansible on Ubuntu
  ansible.builtin.apt:
    name:
      - ansible
      - python3
      - python3-pip
    state: "{{ ansible_pkg_state }}"
    update_cache: true
  when: ansible_distribution == 'Ubuntu'
- name: Set up Ansible on Debian
  ansible.builtin.apt:
    name:
      - ansible
      - python3
      - python3-pip
    state: "{{ ansible_pkg_state }}"
    update_cache: true
  when: ansible_os_family == 'Debian' and ansible_distribution != 'Ubuntu'
- name: Set up Ansible using Pip
  ansible.builtin.pip:
    name: ansible
    state: "{{ ansible_pkg_state }}"
  when: (ansible_install_method | default('package')) == 'pip'


