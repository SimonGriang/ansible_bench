---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    rke2_server_taints: "{{ rke2_server_node_taints }}"
  when: rke2_server_type == 'server'

- name: Copy RKE2 config
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed
  when: >
    rke2_custom_registry_mirrors | length > 0 or
    rke2_custom_registry_configs | length > 0

- name: Register etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: >
    rke2_etcd_snapshot_file | length > 0 and
    not (services['rke2-server.service'] is defined and
         services['rke2-server.service'].state == 'disabled')

- name: Register etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: >
    rke2_etcd_snapshot_file | length > 0 and
    rke2_etcd_snapshot_s3_options is defined and
    rke2_etcd_snapshot_s3_options.access_key is defined and
    rke2_etcd_snapshot_s3_options.secret_key is defined and
    rke2_etcd_snapshot_s3_options.bucket is defined and
    rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/server/db/etcd
        state: directory
        owner: root
        group: root
        mode: '0755'
    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/etcd/etcd_snapshot.db
        owner: root
        group: root
        mode: '0600'
    - name: Restore etcd from snapshot
      command: >
        rke2 server
        --restore-from-snapshot
        /var/lib/rancher/rke2/server/db/etcd/etcd_snapshot.db
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  command: >
    rke2 server
    --restore-from-snapshot-s3
    {{ rke2_etcd_snapshot_s3_options.access_key }}
    {{ rke2_etcd_snapshot_s3_options.secret_key }}
    {{ rke2_etcd_snapshot_s3_options.bucket }}
    {{ rke2_etcd_snapshot_s3_options.snapshot_name }}
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: stopped
    enabled: false
    masked: true

- name: Wait for the first server be ready - no CNI
  shell: |
    kubectl get node {{ inventory_hostname }} \
      -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
  register: node_ready
  until: >
    node_ready.stdout == "True" and
    (kubectl get nodes -o jsonpath='{.items[*].metadata.name}' | grep -q '^$')
  retries: 30
  delay: 10

- name: Wait for the first server be ready - with CNI
  shell: |
    kubectl get nodes -o jsonpath='\
    {.items[*].status.conditions[?(@.type=="Ready")].status}'
  register: nodes_ready
  until: nodes_ready.stdout | regex_search('True')
  retries: 30
  delay: 10

- name: Restore etcd
  shell: |
    kubectl delete secret etcd-backup -n kube-system || true
    kubectl delete node $(kubectl get nodes -o jsonpath='\
    {.items[*].metadata.name}') \
    --force --grace-period=0 || true
    kubectl create -f /etc/rancher/rke2/etcd-node.yaml
  args:
    warn: false

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"
  run_once: true


