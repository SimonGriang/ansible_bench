---
- name: Configure etcd user and kernel hardening
  hosts: all
  become: true
  tasks:
    - name: Task 1: Create a system group named etcd and ensure it exists.
      group:
        name: etcd
        state: present
        system: yes

    - name: Task 2: Create a system user named etcd, assign it to the etcd group, and set its shell to /bin/nologin.
      user:
        name: etcd
        group: etcd
        groups: etcd
        system: yes
        shell: /bin/nologin
        create_home: no
        state: present

    - name: Check if /usr/local/share is writable
      command: test -w /usr/local/share
      register: share_writable
      ignore_errors: yes

    - name: Run command to get result
      command: true
      register: command_result
      ignore_errors: yes

    - name: Set source file for kernel hardening config
      set_fact:
        hardening_src: "{{ (share_writable.rc == 0 and command_result.rc == 0) | ternary('/usr/local/share/hardening.conf', '/etc/hardening.conf') }}"

    - name: Task 3: Copy the systemctl config file for kernel hardening to the /etc/sysctl.d/ directory, using a conditional source file based on the writeability of the /usr/local/share directory and the result of a command.
      copy:
        src: "{{ hardening_src }}"
        dest: /etc/sysctl.d/99-hardening.conf
        owner: root
        group: root
        mode: '0644'
      notify: Restart systemd-sysctl

    - name: Task 4: Flush the handlers to run pending tasks.
      meta: flush_handlers
  handlers:
    - name: Restart systemd-sysctl
      systemd:
        name: systemd-sysctl
        state: restarted
        daemon_reload: yes


