---
- name: Assert that systemd is being used as the init system
  ansible.builtin.assert:
    that:
      - ansible_service_mgr == 'systemd'
    fail_msg: "This role only supports systemd init system."

- name: Get the latest release of the Grafana Loki project from the GitHub API
  ansible.builtin.uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: true
  register: _latest_release_raw
  until: _latest_release_raw.status == 200
  retries: 5
  delay: 5

- name: >-
    Set promtail version to the latest release tag
    (excluding the 'v' prefix) if it's set to 'latest'
  ansible.builtin.set_fact:
    promtail_version: >-
      {{ _latest_release_raw.json.tag_name | regex_replace('^v', '') }}
  when: promtail_version == 'latest'

- name: Test if the zip local archive exists in the specified directory
  ansible.builtin.stat:
    path: "{{ local_dir }}/promtail-{{ promtail_version }}.zip"
  register: promtail_zip_stat
  when: local_dir | length > 0

- name: Assert that the local binary exists in the specified directory
  ansible.builtin.assert:
    that:
      - promtail_zip_stat.stat.exists
    fail_msg: "Promtail binary archive not found in {{ local_dir }}"
  when: local_dir | length > 0

- name: Find checksums.txt download URL from release assets
  ansible.builtin.set_fact:
    __checksums_url: >-
      {{
        _latest_release_raw.json.assets
          | selectattr('name', 'equalto', 'checksums.txt')
          | map(attribute='browser_download_url')
          | list
          | first
      }}

- name: Get the checksum list for the latest release
  ansible.builtin.uri:
    url: "{{ __checksums_url }}"
    return_content: true
  register: __promtail_checksums_raw
  until: __promtail_checksums_raw.status == 200
  retries: 5
  delay: 5

- name: Parse checksums list
  ansible.builtin.set_fact:
    __promtail_checksums: "{{ __promtail_checksums_raw.content.splitlines() }}"

- name: Get the checksum for the specified architecture
  ansible.builtin.set_fact:
    __promtail_checksum: >-
      {{
        __promtail_checksums
          | select('search', 'promtail-linux-' + arch + '\\.zip')
          | map('regex_replace', '^promtail-linux-' + arch + '\\.zip\\s+(\\S+)', '\\1')
          | list
          | first
      }}
  when: not promtail_zip_stat.stat.exists


