---  
- name: Bootstrap OS facts  
  hosts: all  
  gather_facts: false  
  tasks:  
    - name: Gather Bootstrap Facts  
      shell: cat /etc/os-release  
      register: bootstrap_facts  
      become: false  

    - name: Set Bootstrap Distribution Facts (I)  
      set_fact:  
        bootstrap_distribution: "{{ (bootstrap_facts.stdout | regex_findall('^ID=([\\w-]+)', flags='m'))[0] }}"  
        bootstrap_distribution_major_version: "{{ (bootstrap_facts.stdout | regex_findall('^VERSION_ID=([\\d\\.]+)', flags='m'))[0] }}"  
      loop: "{{ bootstrap_os_family_map | flatten }}"  
      when:  
        - bootstrap_facts.rc == 0  
        - bootstrap_distribution is not defined  
        - (bootstrap_facts.stdout | regex_search(bootstrap_search[item], flags='m'))  
      become: false  

    - name: Set Bootstrap OS Family Facts (II)  
      set_fact:  
        bootstrap_os_family: "{{ item.key }}"  
      loop: "{{ bootstrap_os_family_map | dict2items }}"  
      when:  
        - bootstrap_distribution is defined  
        - bootstrap_distribution in item.value  
      become: false


