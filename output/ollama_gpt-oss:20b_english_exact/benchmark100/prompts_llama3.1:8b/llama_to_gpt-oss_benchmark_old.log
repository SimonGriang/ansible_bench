---
- name: Import assert.yml from the current working directory
  ansible.builtin.import_tasks: assert.yml

- name: Install the MySQL package
  ansible.builtin.package:
    name: mysql
    state: present
  notify:
    - set root password
    - systemctl daemon-reexec

- name: Configure the MySQL server
  community.general.ini_file:
    dest: "{{ mysql_configuration_destination }}/server.cnf"
    section: mysqld
    options: "{{ mysql_configuration_options }}"
    mode: "0644"
  notify:
    - restart MySQL server

- name: Configure the MySQL client
  community.general.ini_file:
    dest: "{{ mysql_configuration_destination }}/client.cnf"
    section: client
    options:
      socket: "{{ mysql_socket_path }}"
    mode: "0644"

- name: Initialize the MySQL database
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  changed_when: false

- name: Start and enable the MySQL service
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place the my.cnf file
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: "0600"

- name: Create databases
  community.mysql.mysql_db:
    state: present
    name: "{{ item }}"
  with_items: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  community.mysql.mysql_user:
    state: present
    name: "{{ item.name }}"
    password: "{{ item.password }}"
  with_items: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


