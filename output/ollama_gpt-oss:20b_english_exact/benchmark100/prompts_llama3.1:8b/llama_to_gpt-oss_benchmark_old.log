---
- name: Create the RKE2 config directory.
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'
- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'
- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'
- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
- name: Copy kubelet config
  template:
    src: "{{ rke2_kubelet_config }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  when: rke2_kubelet_config is defined and rke2_kubelet_config != ''
  notify: Config file changed
- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_config_src }}"
    dest: /etc/containerd/registries.yaml
    owner: root
    group: root
    mode: '0644'
  when: (rke2_custom_registry_mirrors is defined and rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs is defined and rke2_custom_registry_configs | length > 0)
  notify: Config file changed
- name: Start RKE2 service on the rest of the nodes
  service:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: true
  register: rke2_service_result
  retries: 5
  delay: 10
  until: rke2_service_result is succeeded
  notify: Service (re)started
- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ item }}"
    masked: true
  loop: "{{ rke2_services }}"
  when: item != rke2_service_name
- name: Wait for remaining nodes to be ready - no CNI
  command: kubectl get node {{ item }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
  register: node_ready_status
  loop: "{{ groups['remaining_nodes'] }}"
  retries: 10
  delay: 15
  until: node_ready_status.stdout == "True"
- name: Wait for remaining nodes to be ready - with CNI
  command: kubectl get nodes -o jsonpath='{.items[?(@.status.conditions[?(@.type=="Ready")].status=="True")].metadata.name}'
  register: ready_nodes
  retries: 10
  delay: 15
  until: ready_nodes.stdout_lines | length >= expected_ready_nodes


