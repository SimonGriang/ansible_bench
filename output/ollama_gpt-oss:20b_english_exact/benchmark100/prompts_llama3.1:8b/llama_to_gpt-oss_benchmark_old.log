---
- name: Import assert.yml file
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install fail2ban package
  ansible.builtin.package:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Copy fail2ban filters
  when: fail2ban_filterd_path is defined
  block:
    - name: Copy fail2ban filters file
      ansible.builtin.copy:
        src: "{{ fail2ban_filterd_path }}"
        dest: /etc/fail2ban/filter.d/
        owner: root
        group: root
        mode: '0640'
    - name: Restart fail2ban service
      ansible.builtin.service:
        name: "{{ fail2ban_service }}"
        state: restarted

- name: Configure fail2ban.local
  block:
    - name: Configure fail2ban.local file
      ansible.builtin.template:
        src: fail2ban.local.j2
        dest: /etc/fail2ban/fail2ban.local
        owner: root
        mode: '0640'
    - name: Restart fail2ban service
      ansible.builtin.service:
        name: "{{ fail2ban_service }}"
        state: restarted

- name: Configure jail.local
  block:
    - name: Configure jail.local file
      ansible.builtin.template:
        src: jail.local.j2
        dest: /etc/fail2ban/jail.local
        owner: root
        mode: '0640'
    - name: Restart fail2ban service
      ansible.builtin.service:
        name: "{{ fail2ban_service }}"
        state: restarted

- name: Check the existence of the auth log file
  ansible.builtin.stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Create the auth log file if it does not exist
  ansible.builtin.file:
    path: /var/log/auth.log
    state: touch
    mode: '0640'
  when: not fail2ban_auth.stat.exists

- name: Start and enable the fail2ban service
  ansible.builtin.service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: true


