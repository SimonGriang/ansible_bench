---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "vars/{{ java_jdk_vendor }}_{{ ansible_distribution | lower }}_{{ ansible_distribution_major_version }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: architecture.yml

- name: Set OS-specific variables (I)
  set_fact:
    java_open_jdk_home: "{{ java_open_jdk_home | default(os_specific_java_home) }}"
    java_open_jdk_version: "{{ java_open_jdk_version | default(os_specific_java_version) }}"
  when: java_open_jdk_home is not defined or java_open_jdk_home is none or java_open_jdk_version is not defined or java_open_jdk_version is none

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default(os_specific_java_home_dir) }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default(os_specific_java_package) }}"
  when: java_open_jdk_home_dir is not defined or java_open_jdk_home_dir is none or java_open_jdk_package is not defined or java_open_jdk_package is none

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "{{ item }}"
        state: absent
      loop: "{{ deprecated_repos | default([]) }}"

    - name: Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ apt_extra_tools | default([]) }}"

    - name: Add required key repositories
      apt_key:
        url: "{{ item.url }}"
        state: present
      loop: "{{ required_keys | default([]) }}"

    - name: Add required repositories
      apt_repository:
        repo: "{{ item.repo }}"
        state: present
      loop: "{{ required_repos | default([]) }}"
  when: ansible_os_family == "Debian"

- name: RedHat pre-requisites
  block:
    - name: Add required key repositories
      rpm_key:
        keyserver: "{{ item.keyserver }}"
        state: present
      loop: "{{ required_keys | default([]) }}"

    - name: Add required repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        enabled: "{{ item.enabled | default(1) }}"
        gpgcheck: "{{ item.gpgcheck | default(1) }}"
        gpgkey: "{{ item.gpgkey }}"
      loop: "{{ required_repos | default([]) }}"
  when: ansible_os_family == "RedHat"

- name: Install required libs
  package:
    name: "{{ required_libs | default([]) }}"
    state: present

- name: Install Java, Debian
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
    update_cache: yes
  when: ansible_os_family == "Debian"

- name: Install Java, RedHat
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0644'

- name: Source environment variables
  shell: source /etc/profile
  args:
    executable: /bin/bash

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  file:
    src: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java"
    dest: /usr/bin/java
    state: link
    force: yes
  when: java_open_jdk_version is defined and java_open_jdk_version | int < 11

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  file:
    src: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java"
    dest: /usr/bin/java
    state: link
