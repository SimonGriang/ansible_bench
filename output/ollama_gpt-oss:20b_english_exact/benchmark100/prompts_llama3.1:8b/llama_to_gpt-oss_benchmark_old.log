        - name: Manage selinux settings
          selinux:
            state: "{{ selinux_state }}"
            policy: "{{ selinux_policy }}"
          notify: Reboot

        - name: Manage selinux booleans
          selinux_boolean:
            name: "{{ item.name }}"
            state: "{{ item.state }}"
            persistent: "{{ item.persistent | default(omit) }}"
          loop: "{{ selinux_booleans }}"
      when: >
        ansible_connection not in ['container', 'docker', 'community.docker.docker']

  handlers:
    - name: Gather facts
      setup:

    - name: Reboot
      reboot:
        reboot_timeout: 600


