  when: promtail_system_group != 'root'

- name: Create the promtail system user
  user:
    name: "{{ promtail_system_user }}"
    groups: "{{ promtail_system_group }},{{ promtail_user_additional_groups | join(',') }}"
    append: true
    state: present
  when: promtail_system_user != 'root'

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create necessary config directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0755'
  loop:
    - "{{ promtail_config_dir }}"
    - "{{ promtail_position_dir }}"

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0755'
  loop:
    - "{{ promtail_install_dir }}"
    - "{{ promtail_install_dir }}/{{ promtail_version }}"

- name: Check the existence of the promtail binary
  stat:
    path: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail"
  register: promtail_binary

- name: Download promtail binaries if necessary
  get_url:
    url: "{{ promtail_download_url }}"
    dest: >-
      {{ promtail_temp_dir }}/promtail-{{ promtail_version }}.zip
    mode: '0644'
  when: not promtail_binary.stat.exists or promtail_local_archive_exists

- name: Propagate locally distributed promtail archive if necessary
  copy:
    src: "{{ promtail_local_archive_path }}"
    dest: >-
      {{ promtail_temp_dir }}/promtail-{{ promtail_version }}.zip
    mode: '0644'
  when: promtail_local_archive_exists

- name: Download promtail binaries to controller node if necessary
  get_url:
    url: "{{ promtail_download_url }}"
    dest: >-
      {{ promtail_temp_dir }}/promtail-{{ promtail_version }}.zip
    mode: '0644'
  delegate_to: localhost
  when: promtail_binary_propagate | bool

- name: Propagate promtail binaries
  copy:
    src: >-
      {{ promtail_temp_dir }}/promtail-{{ promtail_version }}.zip
    dest: >-
      {{ promtail_install_dir }}/{{ promtail_version }}/promtail-{{ promtail_version }}.zip
    mode: '0644'
  when: promtail_binary_propagate | bool

- name: Unpack promtail binaries
  unarchive:
    src: >-
      {{ promtail_install_dir }}/{{ promtail_version }}/promtail-{{ promtail_version }}.zip
    dest: >-
      {{ promtail_install_dir }}/{{ promtail_version }}
    remote_src: yes
    creates: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail"

- name: Create a symlink to the latest version
  file:
    src: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail"
    dest: /usr/local/bin/promtail
    state: link

- name: Write the promtail configuration
  template:
    src: promtail.yml.j2
    dest: "{{ promtail_config_dir }}/promtail.yml"
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0644'

- name: Create the systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'


