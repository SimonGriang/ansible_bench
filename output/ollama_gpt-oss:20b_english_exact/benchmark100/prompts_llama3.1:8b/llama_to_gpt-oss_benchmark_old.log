---
- name: Helm installation tasks
  hosts: all
  become: true

  vars:
    helm_bin_path: /usr/local/bin/helm
    helm_repo_path: https://get.helm.sh
    helm_version: 3.12.0
    helm_platform: linux
    helm_arch: amd64
    helm_download_url: "{{ helm_repo_path }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    helm_download_path: /tmp/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz

  tasks:
    - name: Check if the Helm binary exists at the specified path
      stat:
        path: "{{ helm_bin_path }}"
      register: helm_check

    - name: Check the current version of Helm installed on the system
      command: "{{ helm_bin_path }} version --short"
      register: helm_existing_version
      failed_when: false
      changed_when: false
      when: helm_check.stat.exists

    - name: Download the Helm binary from the specified repository
      get_url:
        url: "{{ helm_download_url }}"
        dest: "{{ helm_download_path }}"
        mode: '0755'
      when: not helm_check.stat.exists or (helm_existing_version.stdout is defined and helm_existing_version.stdout != helm_version)

    - name: Copy the downloaded Helm binary into place at the specified path
      copy:
        src: "{{ helm_download_path }}"
        dest: "{{ helm_bin_path }}"
        mode: '0755'
      become: true
      when: not helm_check.stat.exists or (helm_existing_version.stdout is defined and helm_existing_version.stdout != helm_version)


