---
- name: Configure Apache web server
  hosts: all
  become: true
  vars:
    httpd_ports_conf_dest: "/etc/apache2/conf-available/custom_ports.conf"
  tasks:
    - name: Ensure Apache is installed
      package:
        name: apache2
        state: present

    - name: Ensure Apache service is enabled and started
      service:
        name: apache2
        state: started
        enabled: true

    - name: Configure custom port
      template:
        src: custom_port.j2
        dest: "{{ httpd_ports_conf_dest }}"
      notify: Reload Apache

    - name: Create a new directory
      file:
        path: /opt/myapp
        state: directory
        mode: '0755'

    - name: Copy static files to the new directory
      copy:
        src: static/
        dest: /opt/myapp/static/
        owner: root
        group: root
        mode: '0644'
        recurse: yes

  handlers:
    - name: Reload Apache
      service:
        name: apache2
        state: reloaded



