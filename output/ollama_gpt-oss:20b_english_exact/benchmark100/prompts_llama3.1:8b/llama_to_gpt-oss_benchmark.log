---  
- name: Assert that systemd is being used as the init system
  assert:
    that:
      - ansible_service_mgr == 'systemd'
    fail_msg: "This playbook requires systemd as the init system."
    success_msg: "Systemd is detected."

- name: Get the latest release of the Grafana Loki project from the GitHub API
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    return_content: yes
  register: _latest_release
  retries: 5
  delay: 2
  until: _latest_release.status == 200
  failed_when: _latest_release.status != 200

- name: Set the promtail version to the latest release tag (excluding the 'v' prefix) if it's set to 'latest'
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name | regex_replace('^v', '') }}"
  when: promtail_version == 'latest'

- name: Test if the zip local archive exists in the specified directory
  stat:
    path: "{{ promtail_local_dir }}/promtail-linux-{{ ansible_architecture }}.zip"
  register: local_archive_stat
  when: promtail_local_dir is defined

- name: Assert that the local binary exists in the specified directory
  assert:
    that:
      - local_archive_stat.stat.exists
    fail_msg: "Promtail binary archive not found in {{ promtail_local_dir }}."
  when: local_archive_stat.stat.exists is defined

- name: Get the checksum list for the latest release
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest/download/checksums.txt"
    return_content: yes
  register: __promtail_checksums
  retries: 5
  delay: 2
  until: __promtail_checksums.status == 200
  failed_when: __promtail_checksums.status != 200

- name: Get the checksum for the specified architecture
  set_fact:
    __promtail_checksum: "{{ __promtail_checksums.content | regex_findall('promtail-linux-' ~ ansible_architecture ~ '\\.zip\\s+([a-f0-9]+)') | first }}"
  when: not local_archive_stat.stat.exists


