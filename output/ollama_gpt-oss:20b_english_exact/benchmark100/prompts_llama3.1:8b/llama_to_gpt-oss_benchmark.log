---
- name: Import assert.yml and run it once on localhost
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install the dns packages
  ansible.builtin.package:
    name: bind9
    state: present

- name: Create the required directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /etc/bind
    - /var/cache/bind
    - /var/lib/bind
    - /var/log/bind

- name: Create the required group
  ansible.builtin.group:
    name: dns
    state: present

- name: Create the required user
  ansible.builtin.user:
    name: dns
    group: dns
    home: /var/lib/bind
    shell: /sbin/nologin
    state: present

- name: Generate the rndc key
  ansible.builtin.command: rndc-confgen -a -b 512 -k rndc.key
  args:
    creates: /etc/bind/rndc.key

- name: Set permissions on the rndc key file
  ansible.builtin.file:
    path: /etc/bind/rndc.key
    owner: dns
    group: dns
    mode: '0600'

- name: Download the named.root file
  ansible.builtin.get_url:
    url: "http://example.com/named.root"
    dest: /etc/bind/named.root
    mode: '0644'

- name: Create the zone file
  ansible.builtin.template:
    src: zone.j2
    dest: /etc/bind/db.example.com
    mode: '0644'

- name: Add zones to the configuration
  ansible.builtin.template:
    src: named.conf.local.j2
    dest: /etc/bind/named.conf.local
    mode: '0644'

- name: Place the systemd override
  block:
    - name: Copy systemd override file
      ansible.builtin.copy:
        src: override.conf
        dest: /etc/systemd/system/bind9.service.d/override.conf
        mode: '0644'
    - name: Reload systemd daemon
      ansible.builtin.systemd:
        daemon_reload: true

- name: Start and enable the DNS service
  ansible.builtin.systemd:
    name: bind9
    state: started
    enabled: true


