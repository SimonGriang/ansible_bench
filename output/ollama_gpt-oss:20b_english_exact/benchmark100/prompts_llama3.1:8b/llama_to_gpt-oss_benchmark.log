---
- name: Create an SSL private key
  openssl_privatekey:
    path: "{{ key_path }}"
    size: 2048
    mode: '0600'
  become: true

- name: Create an SSL Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ csr_path }}"
    privatekey_path: "{{ key_path }}"
    mode: '0644'
  become: true

- name: Create an SSL certificate
  x509_certificate:
    path: "{{ cert_path }}"
    csr_path: "{{ csr_path }}"
    mode: '0644'
  become: true

- name: Create a PKCS#12 file
  openssl_pkcs12:
    path: "{{ pkcs12_path }}"
    privatekey_path: "{{ key_path }}"
    certificate_path: "{{ cert_path }}"
    mode: '0600'
  become: true

- name: Read the private key
  slurp:
    src: "{{ key_path }}"
  register: key_content

- name: Read the certificate
  slurp:
    src: "{{ cert_path }}"
  register: cert_content

- name: Create a combined private key and certificate file
  copy:
    dest: "{{ combined_path }}"
    content: "{{ key_content.content | b64decode }}\n{{ cert_content.content | b64decode }}"
    mode: '0644'
    owner: root
    group: root
  become: true


