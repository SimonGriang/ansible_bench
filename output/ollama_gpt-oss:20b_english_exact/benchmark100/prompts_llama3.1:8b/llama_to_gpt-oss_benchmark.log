---
- name: Create an SSL private key.
  ansible.builtin.openssl_privatekey:
    path: "{{ ssl_key_path }}"
    size: 2048
    mode: "{{ ssl_key_mode }}"
    owner: "{{ ssl_key_owner }}"
    group: "{{ ssl_key_group }}"

- name: Create an SSL Certificate Signing Request (CSR).
  ansible.builtin.openssl_csr:
    path: "{{ ssl_csr_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    common_name: "{{ ssl_common_name }}"
    mode: "{{ ssl_csr_mode }}"
    owner: "{{ ssl_csr_owner }}"
    group: "{{ ssl_csr_group }}"

- name: Create SSL certificates.
  ansible.builtin.openssl_certificate:
    path: "{{ ssl_cert_path }}"
    csr_path: "{{ ssl_csr_path }}"
    provider: selfsigned
    mode: "{{ ssl_cert_mode }}"
    owner: "{{ ssl_cert_owner }}"
    group: "{{ ssl_cert_group }}"

- name: Create a PKCS#12 file.
  ansible.builtin.openssl_pkcs12:
    path: "{{ ssl_pkcs12_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    certificate_path: "{{ ssl_cert_path }}"
    friendly_name: "{{ ssl_friendly_name }}"
    mode: "{{ ssl_pkcs12_mode }}"
    owner: "{{ ssl_pkcs12_owner }}"
    group: "{{ ssl_pkcs12_group }}"

- name: Read the private key.
  ansible.builtin.slurp:
    src: "{{ ssl_key_path }}"
  register: ssl_key_content

- name: Read the certificate.
  ansible.builtin.slurp:
    src: "{{ ssl_cert_path }}"
  register: ssl_cert_content

- name: Create a combined private key and certificate file.
  ansible.builtin.copy:
    content: "{{ ssl_key_content.content | b64decode }}\n{{ ssl_cert_content.content | b64decode }}"
    dest: "{{ ssl_combined_path }}"
    mode: "{{ ssl_combined_mode }}"
    owner: "{{ ssl_combined_owner }}"
    group: "{{ ssl_combined_group }}"


