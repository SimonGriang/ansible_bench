---
- name: Task 1: Remove Docker GPG key from trusted.gpg.d if present
  file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Task 2: Remove old Docker apt source list
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Task 3: Uninstall old versions of Docker
  apt:
    name:
      - docker
      - docker-engine
      - docker.io
      - containerd.io
    state: absent
    purge: yes
    autoremove: yes

- name: Task 4: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker-legacy.list
    state: absent

- name: Task 5: Install required dependencies
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: yes

- name: Task 6: Add or remove Docker repository
  apt_repository:
    repo: "deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_distribution_release }} stable"
    state: "{{ 'present' if docker_add_repo | bool else 'absent' }}"
    filename: docker

- name: Task 7: Notify apt update handler
  debug:
    msg: "Trigger apt update handler"
  notify: apt update


