---
- name: Create the Vault group
  group:
    name: "{{ vault_group }}"
    system: true

- name: Create the Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"

- name: Create the Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0755"

- name: Download the Vault binary
  unarchive:
    src: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: true
    mode: "0755"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Check if the vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_stat

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0755"
  when: not vault_path_stat.stat.exists

- name: Create directories in vault_path
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0755"
  loop: "{{ vault_directories }}"

- name: Create data directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0755"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  openssl_privatekey:
    path: "{{ vault_tls_dir }}/vault.key"
    mode: "0600"
  register: tls_key
- name: Generate TLS certificate
  openssl_certificate:
    path: "{{ vault_tls_dir }}/vault.crt"
    provider: selfsigned
    privatekey_path: "{{ tls_key.path }}"
    mode: "0644"

- name: Set ownership of TLS material
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0644"
  loop: "{{ vault_tls_files }}"

- name: Copy the Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "/usr/bin/vault"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0755"

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  command: setcap cap_ipc_lock=ep /usr/bin/vault

- name: Touch vault.env
  file:
    path: "{{ vault_env_path }}"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0644"

- name: Create /usr/lib/systemd/system
  file:
    path: "/usr/lib/systemd/system"
    state: directory
    owner: "root"
    group: "root"
    mode: "0755"

- name: Copy the Vault service file
  copy:
    src: "{{ vault_service_src }}"
    dest: "/usr/lib/systemd/system/vault.service"
    owner: "root"
    group: "root"
    mode: "0644"

- name: Copy the Vault configuration
  copy:
    src: "{{ vault_config_src }}"
    dest: "{{ vault_config_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0644"

- name: Flush handlers
  meta: flush_handlers


