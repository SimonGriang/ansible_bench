- name: Check existence of Java certificates
  stat:
    path: "{{ item.path }}"
  loop: "{{ java_certs }}"
  register: check_java_certs

- name: Fail if Java certificates do not exist
  fail:
    msg: "Java certificate {{ item.item.path }} does not exist."
  loop: "{{ check_java_certs.results }}"
  when: not item.stat.exists

- name: Set Java keystore directory for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: java_version is defined and java_version < 11

- name: Set Java keystore directory for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: java_version is defined and java_version >= 11

- name: Import SSL certificates into Java keystore
  java_cert:
    cert_file: "{{ item.path }}"
    keystore_path: "{{ java_open_jdk_home }}/lib/security/{{ java_keystore_dir }}/cacerts"
    keystore_password: "{{ java_cert_keystore_pass }}"
    alias: "{{ item.alias | default(item.path | basename) }}"
    state: present
  loop: "{{ java_certs }}"



