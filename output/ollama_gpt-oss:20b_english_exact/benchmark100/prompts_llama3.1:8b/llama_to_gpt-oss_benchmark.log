---
- name: Ensure old versions of Docker are not installed
  ansible.builtin.dnf:
    name: "{{ item }}"
    state: absent
  loop:
    - docker
    - docker-client
    - docker-client-latest
    - docker-common
    - docker-latest
    - docker-latest-logrotate
    - docker-logrotate
    - docker-engine
    - docker-ce
    - docker-ce-cli
    - docker-ce-rootless-extras
    - docker-scan-plugin

- name: Add Docker GPG key
  ansible.builtin.rpm_key:
    state: present
    key: https://download.docker.com/linux/centos/gpg

- name: Add Docker repository
  ansible.builtin.get_url:
    url: https://download.docker.com/linux/centos/docker-ce.repo
    dest: /etc/yum.repos.d/docker-ce.repo
    mode: '0644'

- name: Configure Docker Nightly repo and Docker Test repo
  block:
    - name: Configure Docker Nightly repository
      ansible.builtin.yum_repository:
        name: docker-ce-nightly
        description: Docker CE Nightly
        baseurl: https://download.docker.com/linux/centos/7/x86_64/nightly
        gpgcheck: 1
        repo_gpgcheck: 1
        enabled: "{{ docker_yum_repo_enable_nightly | bool }}"
        gpgkey: https://download.docker.com/linux/centos/gpg
    - name: Configure Docker Test repository
      ansible.builtin.yum_repository:
        name: docker-ce-test
        description: Docker CE Test
        baseurl: https://download.docker.com/linux/centos/7/x86_64/test
        gpgcheck: 1
        repo_gpgcheck: 1
        enabled: "{{ docker_yum_repo_enable_test | bool }}"
        gpgkey: https://download.docker.com/linux/centos/gpg

- name: Configure containerd on RHEL 8
  block:
    - name: Remove runc
      ansible.builtin.dnf:
        name: runc
        state: absent
    - name: Install container-selinux
      ansible.builtin.dnf:
        name: container-selinux
        state: present
    - name: Install containerd.io
      ansible.builtin.dnf:
        name: containerd.io
        state: present


