---
- name: Update the package cache on systems that use apt
  ansible.builtin.apt:
    update_cache: true
  when: ansible_os_family == 'Debian'

- name: Update the package cache on systems that use dnf
  ansible.builtin.dnf:
    update_cache: true
  when: ansible_os_family == 'RedHat'

- name: Install the keepalived package
  ansible.builtin.package:
    name: keepalived
    state: present

- name: Create the /etc/keepalived directory with the correct permissions
  ansible.builtin.file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Create the Kubernetes API health check script for Debian-based systems
  ansible.builtin.file:
    path: /etc/keepalived/check_apiserver.sh
    state: touch
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == 'Debian'

- name: Create the Kubernetes API health check script for RHEL-based systems
  ansible.builtin.file:
    path: /usr/libexec/keepalived/check_apiserver.sh
    state: touch
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == 'RedHat'

- name: Create the RKE2 Server health check script for Debian-based systems
  ansible.builtin.file:
    path: /etc/keepalived/check_rke2server.sh
    state: touch
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == 'Debian'

- name: Create the RKE2 Server health check script for RHEL-based systems
  ansible.builtin.file:
    path: /usr/libexec/keepalived/check_rke2server.sh
    state: touch
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == 'RedHat'

- name: Create the keepalived configuration file
  ansible.builtin.file:
    path: /etc/keepalived/keepalived.conf
    state: touch
    owner: root
    group: root
    mode: '0644'

- name: Enable the keepalived service and ensure it is not masked
  ansible.builtin.systemd:
    name: keepalived
    state: started
    enabled: true
    masked: false

- name: Flush the handlers to execute any pending tasks
  ansible.builtin.meta: flush_handlers


