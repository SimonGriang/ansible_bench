--- 
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: "{{ 'temurin' if java_jdk_vendor == 'adoptopenjdk' else java_jdk_vendor }}"

- name: Gather OS specific variables
  include_vars: "vars/{{ java_jdk_vendor }}/{{ ansible_distribution | lower }}{{ ansible_distribution_major_version }}.yml"

- name: Gather architecture specific variables
  include_vars: "architecture.yml"

- name: Set OS-specific variables (I)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default(java_open_jdk_home_dir) }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default(java_open_jdk_package) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default(java_open_jdk_home_dir) }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default(java_open_jdk_package) }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "{{ item }}"
        state: absent
      loop: "{{ deprecated_repos | default([]) }}"
    - name: Install extra apt tools
      apt:
        name:
          - apt-transport-https
          - ca-certificates
          - gnupg
        state: present
        update_cache: yes
    - name: Add required key repositories
      apt_key:
        url: "{{ item }}"
        state: present
      loop: "{{ key_urls | default([]) }}"
    - name: Add required repositories
      apt_repository:
        repo: "{{ item }}"
        state: present
      loop: "{{ repo_urls | default([]) }}"
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add required key repositories
      rpm_key:
        key: "{{ item }}"
        state: present
      loop: "{{ key_urls | default([]) }}"
    - name: Add required repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        enabled: "{{ item.enabled }}"
        gpgcheck: "{{ item.gpgcheck }}"
      loop: "{{ repo_list | default([]) }}"
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  apt:
    name: "{{ java_required_libs | default([]) }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'Debian'

- name: Install Java, Debian
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0644'

- name: Source environment variables
  shell: source /etc/profile
  args:
    executable: /bin/bash

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  lineinfile:
    path: /etc/profile.d/jdk.sh
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME=/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre"
  when: java_version | int < 11

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  lineinfile:
    path: /etc/profile.d/jdk.sh
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME=/usr/lib/jvm/{{ java_open_jdk_home_dir }}"
  when: java_version | int >= 11


