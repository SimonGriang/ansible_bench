- name: Gather Bootstrap Facts
  shell: cat /etc/os-release
  register: bootstrap_facts
  become: false

- name: Set Bootstrap Distribution Facts (I)
  set_fact:
    bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_search('^ID=([a-zA-Z0-9_]+)', '\\1') }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search('^VERSION_ID=\"([0-9]+)\\.[0-9]+\"', '\\1') }}"
  loop: "{{ bootstrap_os_family_map | flatten }}"
  when: bootstrap_facts.rc == 0 and bootstrap_distribution is not defined and (bootstrap_facts.stdout | regex_search(bootstrap_search[item])) is not none

- name: Set Bootstrap OS Family Facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  when: bootstrap_distribution is defined and bootstrap_distribution in item.value
  become: false


