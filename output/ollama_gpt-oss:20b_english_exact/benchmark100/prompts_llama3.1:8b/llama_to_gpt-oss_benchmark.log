---
- name: Check all variables have been set correctly
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host (when configured)
  ansible.builtin.wait_for:
    host: "{{ ansible_ssh_host | default(inventory_hostname) }}"
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout | default(300) }}"
  when: >
    ansible_connection not in ['container',
    'docker',
    'community.docker.docker']

- name: Prepare the system
  block:
    - name: Test connectivity
      ansible.builtin.ping:
      register: _conn_test
      ignore_errors: true
    - name: Log connectivity failure
      ansible.builtin.debug:
        msg: "Connection test failed for {{ inventory_hostname }}"
      when: _conn_test.failed
      changed_when: true
    - name: Gather bootstrap facts
      ansible.builtin.include_tasks: gather_facts.yml
    - name: Install bootstrap packages
      when: bootstrap__facts_packages is defined
      loop: "{{ bootstrap__facts_packages }}"
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
  rescue:
    - name: Handle connection failure
      ansible.builtin.debug:
        msg: "Connection test failed, cannot proceed."
  always:
    - name: Ensure bootstrap facts are gathered
      ansible.builtin.include_tasks: gather_facts.yml

- name: Ensure system is prepared by issuing ansible modules
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"
  block:
    - name: Gather ansible facts
      ansible.builtin.setup:
    - name: Install required packages
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap__facts_packages }}"


