- name: Create the document root for each vhost
  file:
    path: "{{ item.docroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when: item.docroot is defined and (item.create_docroot is not defined or item.create_docroot | bool)

- name: Configure the vhosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ item.destination }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify:
    - "Test httpd configuration validity"
