---
- name: Restart RKE2 service on a node
  service:
    name: "{{ rke2_node_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: |
    kubectl get nodes --no-headers | grep -c 'Ready'
  delegate_to: "{{ (rke2_active_server | default(groups[rke2_servers_group_name] | first)) }}"
  register: all_ready_nodes
  retries: 100
  delay: 15
  until: all_ready_nodes.stdout | int == groups[rke2_servers_group_name] | length
  run_once: true
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  shell: |
    kubectl get pods --all-namespaces --no-headers | grep -vE 'Running|Succeeded' | wc -l
  delegate_to: "{{ (rke2_active_server | default(groups[rke2_servers_group_name] | first)) }}"
  register: all_pods_ready
  retries: 100
  delay: 15
  until: all_pods_ready.stdout | int == 0
  run_once: true
  when:
    - not ansible_check_mode
    - rke2_wait_for_all_pods_to_be_ready | bool


