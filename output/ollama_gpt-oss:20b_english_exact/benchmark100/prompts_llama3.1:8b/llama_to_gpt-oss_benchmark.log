---
- name: Import assert.yml file
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'container'
    - ansible_connection != 'docker'
    - ansible_connection != 'community.docker.docker'
    - ansible_connection != None
    - bootstrap_wait_for_host | bool

- name: Prepare system
  become: true
  block:
    - name: Connection test
      ansible.builtin.command: echo "connection test"
      register: conn_result
      changed_when: false
    - name: Sudo test
      ansible.builtin.command: whoami
      become: true
      register: sudo_result
      changed_when: false
  rescue:
    - name: Gather bootstrap facts
      ansible.builtin.setup:
      when: conn_result is failed
      changed_when: false
    - name: Install bootstrap packages (raw)
      ansible.builtin.raw: yum install -y {{ bootstrap_facts_packages | join(' ') }}
      when: sudo_result is failed
      changed_when: false
    - name: Ensure libdnf5 is present on Fedora/RedHat
      ansible.builtin.package:
        name: libdnf5
        state: present
      when:
        - sudo_result is failed
        - ansible_facts['os_family'] == "RedHat"
        - ansible_facts['distribution'] == "Fedora"
      changed_when: false

- name: Gather ansible facts
  ansible.builtin.setup:
  become: false
  changed_when: false

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become }}"
  changed_when: false


