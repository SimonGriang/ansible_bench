---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install the MySQL package
  ansible.builtin.package:
    name: mysql
    state: present
  notify:
    - set root password
    - systemctl daemon-reexec

- name: Configure the MySQL server
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/server.cnf"
    section: mysqld
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    mode: "0644"
  with_dict: "{{ mysql_configuration_options }}"
  notify: restart MySQL server

- name: Configure the MySQL client
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    mode: "0644"

- name: Initialize the MySQL database
  ansible.builtin.shell: "{{ mysql_initialize_command }}"
  args:
    executable: /bin/bash
  changed_when: false

- name: Start and enable the MySQL service
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place the my.cnf file
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: "0600"

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


