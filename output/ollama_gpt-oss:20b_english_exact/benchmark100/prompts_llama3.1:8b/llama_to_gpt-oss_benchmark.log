---
- name: Import assert.yml and run it once on localhost
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install the mysql package
  ansible.builtin.package:
    name: mysql
    state: present

- name: Configure the mysql server
  ansible.builtin.template:
    src: server.cnf.j2
    dest: "{{ mysql_destination }}/{{ mysql_name }}-server.cnf"
    mode: "0644"

- name: Configure the mysql client
  ansible.builtin.template:
    src: client.cnf.j2
    dest: "{{ mysql_destination }}/{{ mysql_name }}-client.cnf"
    mode: "0644"

- name: Initialize the mysql service
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_os_family == 'Alpine' or ansible_distribution == 'Archlinux'
  changed_when: false

- name: Start and enable the mysql service
  ansible.builtin.service:
    name: "{{ mysql_name }}"
    state: started
    enabled: true

- name: Flush handlers to ensure tasks are executed in the correct order
  ansible.builtin.meta: flush_handlers

- name: Create a my.cnf file in the /root/.my.cnf directory
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf/my.cnf
    mode: '0644'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: List databases on the target machine
  community.mysql.mysql_info:

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again to ensure tasks are executed in the correct order
  ansible.builtin.meta: flush_handlers


