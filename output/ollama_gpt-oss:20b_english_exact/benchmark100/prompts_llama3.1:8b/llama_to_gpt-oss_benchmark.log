---
tasks:
  - name: Import assert.yml
    import_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Enable redis module stream (RHEL 8)
    dnf:
      name: redis
      state: present

  - name: Install redis
    package:
      name: "{{ redis_packages }}"
      state: present

  - name: Configure redis
    template:
      src: redis.conf.j2
      dest: "{{ redis_config_dir }}"
      owner: "{{ redis_owner }}"
      group: "{{ redis_group }}"
      mode: "{{ redis_mode }}"
    notify: Restart redis

  - name: Start and enable redis
    service:
      name: "{{ redis_service }}"
      state: started
      enabled: true

handlers:
  - name: Restart redis
    service:
      name: "{{ redis_service }}"
      state: restarted
