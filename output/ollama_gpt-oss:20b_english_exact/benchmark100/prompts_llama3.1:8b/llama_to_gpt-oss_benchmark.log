---
- name: Load OS-specific variables based on the detected operating system
  ansible.builtin.include_vars:
    file: "{{ ansible_os_family }}.yml"

- name: Include setup tasks for RedHat-based systems
  ansible.builtin.include_tasks: redhat.yml
  when: ansible_os_family == "RedHat"

- name: Include setup tasks for Debian-based systems
  ansible.builtin.include_tasks: debian.yml
  when: ansible_os_family == "Debian"

- name: >-
    Install Docker packages on systems with Ansible version less than 2.12 or
    non-RedHat/Debian systems
  ansible.builtin.package:
    name: docker
    state: present
  when: >-
    (ansible_version.full is version('2.12', '<')) or
    (ansible_os_family not in ['RedHat', 'Debian'])

- name: >-
    Install Docker packages (with downgrade option) on systems with Ansible
    version 2.12 or higher and RedHat/Debian systems
  ansible.builtin.package:
    name: docker
    state: present
    allow_downgrade: true
  when: >-
    (ansible_version.full is version('2.12', '>=')) and
    (ansible_os_family in ['RedHat', 'Debian'])

- name: >-
    Install docker-compose plugin on systems where the plugin is enabled and
    the system meets the criteria for task 4 or 5
  ansible.builtin.package:
    name: docker-compose
    state: present
  when: >-
    docker_compose_enabled | bool and
    ((ansible_version.full is version('2.12', '<')) or
     (ansible_os_family not in ['RedHat', 'Debian']))

- name: >-
    Install docker-compose-plugin (with downgrade option) on systems where the
    plugin is enabled and the system meets the criteria for task 5
  ansible.builtin.package:
    name: docker-compose-plugin
    state: present
    allow_downgrade: true
  when: >-
    docker_compose_enabled | bool and
    (ansible_version.full is version('2.12', '>=')) and
    (ansible_os_family in ['RedHat', 'Debian'])

- name: Ensure the /etc/docker/ directory exists and has the correct permissions
  ansible.builtin.file:
    path: /etc/docker
    state: directory
    mode: '0755'

- name: >-
    Configure the Docker daemon options by copying the options to the
    daemon.json file
  ansible.builtin.copy:
    content: "{{ docker_daemon_options | to_nice_json }}"
    dest: /etc/docker/daemon.json
    mode: '0644'

- name: Ensure Docker is started and enabled at boot, if configured to do so
  ansible.builtin.service:
    name: docker
    state: started
    enabled: true
  when: docker_service_enabled | bool

- name: Notify handlers to ensure firewall rules are updated
  ansible.builtin.meta: flush_handlers

- name: Include tasks for managing docker-compose, if enabled
  ansible.builtin.include_tasks: docker_compose.yml
  when: docker_compose_enabled | bool

- name: Get information about the docker group using getent
  ansible.builtin.command: getent group docker
  register: docker_group_info
  changed_when: false

- name: Check if there are any users to add to the docker group
  ansible.builtin.debug:
    msg: "Users to add to docker group: {{ docker_users }}"
  when: docker_users is defined and docker_users | length > 0

- name: Include tasks for managing docker users, if necessary
  ansible.builtin.include_tasks: docker_users.yml
  when: docker_users is defined and docker_users | length > 0


