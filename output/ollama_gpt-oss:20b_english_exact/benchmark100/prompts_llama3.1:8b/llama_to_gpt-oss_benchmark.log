---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    rke2_server_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_server_type == 'server'

- name: Copy RKE2 config
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed
  when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)

- name: Register etcd restore from file
  set_fact:
    do_etcd_restore: true
  when:
    - rke2_etcd_snapshot_file | length > 0
    - not (services['rke2-server.service'].state == 'running' if services is defined and 'rke2-server.service' in services else false)
  vars:
    services: "{{ query('service_facts')['services'] }}"

- name: Register etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file | length > 0
    - rke2_etcd_snapshot_s3_options is defined
    - rke2_etcd_snapshot_s3_options.access_key is defined
    - rke2_etcd_snapshot_s3_options.secret_key is defined
    - rke2_etcd_snapshot_s3_options.bucket is defined
    - rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/server/db
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/snapshot.db
        owner: root
        group: root
        mode: '0600'

    - name: Restore etcd from snapshot
      command: >-
        /usr/local/bin/rke2 server --restore-snapshot
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  command: >-
    /usr/local/bin/rke2 server --restore-snapshot \
    --snapshot-s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }} \
    --snapshot-s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }} \
    --snapshot-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }} \
    --snapshot-s3-snapshot-name {{ rke2_etcd_snapshot_s3_options.snapshot_name }}
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: true
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    enabled: false
    masked: true
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Wait for the first server be ready - no CNI
  shell: >-
    kubectl get nodes \
    -o jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}' \
    | grep -q "True" && \
    ! kubectl get nodes \
    -o jsonpath='{.items[0].metadata.annotations}' | grep -q "cni"
  register: wait_no_cni
  retries: 30
  delay: 10
  until: wait_no_cni.rc == 0
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Wait for the first server be ready - with CNI
  shell: >-
    kubectl get nodes \
    -o jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}' \
    | grep -q "True"
  register: wait_with_cni
  retries: 30
  delay: 10
  until: wait_with_cni.rc == 0
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Restore etcd
  shell: >-
    kubectl delete secrets --all --namespace kube-system && \
    kubectl delete nodes --all
  register: restore_etcd
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"
  run_once: true


