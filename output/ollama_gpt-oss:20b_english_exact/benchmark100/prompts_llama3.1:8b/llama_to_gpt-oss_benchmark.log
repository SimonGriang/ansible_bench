---
- name: Create local ssh key directory for a user
  file:
    path: "{{ user.ssh_key_dir | default('/home/' + user.name + '/.ssh_keys') }}"
    state: directory
    mode: '0750'
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"

- name: Manage the user account
  user:
    name: "{{ user.name }}"
    comment: "{{ user.comment | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    create_home: "{{ user.create_home | default(true) }}"
    password: "{{ user.password | default(omit) }}"
    expires: "{{ user.password_expiration | default(omit) }}"

- name: Set up the user's sudo options
  template:
    src: "templates/{{ user.name }}.j2"
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: '0440'
    owner: root
    group: root
  when: user.sudo_options | default(false)

- name: Set up the user's sudo options
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: not user.sudo_options | default(false)

- name: Generate the user's private SSH key
  command: "ssh-keygen -t rsa -b 4096 -f {{ user.ssh_key_dir | default('/home/' + user.name + '/.ssh_keys') }}/id_rsa -N '' -q"
  creates: "{{ user.ssh_key_dir | default('/home/' + user.name + '/.ssh_keys') }}/id_rsa"
  when: user.ssh_key_management | default(false)

- name: Generate the user's public SSH key
  command: "ssh-keygen -y -f {{ user.ssh_key_dir | default('/home/' + user.name + '/.ssh_keys') }}/id_rsa > {{ user.ssh_key_dir | default('/home/' + user.name + '/.ssh_keys') }}/id_rsa.pub"
  creates: "{{ user.ssh_key_dir | default('/home/' + user.name + '/.ssh_keys') }}/id_rsa.pub"
  when: user.ssh_key_management | default(false)

- name: Convert the user's SSH key to PPK format
  command: "puttygen {{ user.ssh_key_dir | default('/home/' + user.name + '/.ssh_keys') }}/id_rsa -O private -o {{ user.ssh_key_dir | default('/home/' + user.name + '/.ssh_keys') }}/id_rsa.ppk"
  creates: "{{ user.ssh_key_dir | default('/home/' + user.name + '/.ssh_keys') }}/id_rsa.ppk"
  when: user.ssh_key_management | default(false)

- name: Get or set the user's home directory
  getent:
    database: passwd
    key: "{{ user.name }}"
  register: user_passwd_entry

- name: Get or set the user's home directory
  set_fact:
    user_home: "{{ user_passwd_entry.entries[user.name][4] | default('/home/' + user.name) }}"
  when: user_passwd_entry is defined

- name: Create the user's .ssh directory
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  when: user_home is defined

- name: Deploy authorized keys for the user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
    mode: '0600'
  loop: "{{ user.authorized_keys | default([]) }}"
  when: user.authorized_keys | default([]) | length > 0

- name: Remove unauthorized keys for the user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys | default([]) }}"
  when: user.unauthorized_keys | default([]) | length > 0

- name: Copy the generated private SSH key for the user
  copy:
    src: "{{ user.ssh_key_dir | default('/home/' + user.name + '/.ssh_keys') }}/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0400'
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
