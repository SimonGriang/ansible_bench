---
- name: Import assert.yml file into the playbook
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for a specified port to become available
  wait_for:
    host: "{{ bootstrap_wait_for_host }}"
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection not in ['container', 'docker', 'community.docker.docker'] and bootstrap_wait_for_host is defined

- name: Prepare the system for further tasks
  block:
    - name: Check if connection is established
      command: echo "connection ok"
      register: bootstrap_connect
    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml
      when: bootstrap_connect.rc != 0
    - name: Install bootstrap packages (raw)
      raw: yum install -y {{ bootstrap_facts_packages | join(' ') }}
      when: bootstrap_connect.rc != 0
  become: false

- name: Gather Ansible facts about the system
  setup:
  register: system_facts

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
  become: "{{ bootstrap_become }}"


