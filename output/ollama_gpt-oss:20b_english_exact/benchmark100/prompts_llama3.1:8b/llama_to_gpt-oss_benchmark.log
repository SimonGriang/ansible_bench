---
- name: Download RKE2 installation script
  become: true
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0755'

- name: Copy local RKE2 installation script
  become: true
  copy:
    src: "{{ local_rke2_install_script_path }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0755'
  when: airgap_mode and implementation == 'copy'

- name: Create RKE2 artifacts folder
  become: true
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: '0755'
  when: airgap_mode and implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  become: true
  block:
    - get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_path }}"
        mode: '0644'
    - get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}"
        mode: '0644'
  rescue:
    - debug:
        msg: "Fallback logic would be implemented here"
  when: airgap_mode and implementation == 'download'

- name: Airgap mode - additional images tarballs
  become: true
  block:
    - file:
        path: "{{ additional_images_dir }}"
        state: directory
        mode: '0755'
    - copy:
        src: "{{ item }}"
        dest: "{{ additional_images_dir }}/"
        mode: '0644'
      loop: "{{ additional_tarballs }}"
  when: airgap_mode and implementation != 'exists' and (additional_tarballs | default([])) | length > 0

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  become: true
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: '0755'
  when: airgap_mode and implementation == 'exists'

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: "{{ fs_path }}"
  register: fs_stats

- name: Check if separate partition
  shell: "grep -q '{{ partition }}' /proc/partitions"
  register: partition_check
  ignore_errors: true

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: >-
      {% if fs_stats.stat.isdir and partition_check.rc == 0 %}
      /usr/local/bin/rke2
      {% else %}
      /usr/bin/rke2
      {% endif %}

- name: Check RKE2 version
  shell: |
    {{ rke2_bin_path }} --version
    systemctl status rke2-server
  register: rke2_version_output

- name: Set RKE2 versions
  set_fact:
    desired_version: "{{ rke2_desired_version }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that: "installed_version is version(desired_version, '>=')"

- name: Run RKE2 install script
  become: true
  shell: "{{ rke2_install_script_path }} --version {{ desired_version }}"
  when: installed_version != desired_version

- name: Copy Custom Manifests
  become: true
  copy:
    src: "{{ custom_manifests_src }}"
    dest: "{{ custom_manifests_dest }}"
    mode: '0644'
    remote_src: yes
  when: custom_manifests_src is defined

- name: Copy Static Pods
  become: true
  copy:
    src: "{{ static_pods_src }}"
    dest: "{{ static_pods_dest }}"
    mode: '0644'
    remote_src: yes
  when: static_pods_src is defined

- name: Copy RKE2 environment file
  become: true
  copy:
    src: "{{ rke2_env_src }}"
    dest: "{{ rke2_env_dest }}"
    mode: '0644'
    remote_src: yes
  when: rke2_env_src is defined


