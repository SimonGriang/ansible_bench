---
- name: Cordon and Drain the node with the specified RKE2 node name
  ansible.builtin.shell: |
    {{ rke2_data_path }}/kubectl cordon {{ rke2_node_name }}
    {{ rke2_data_path }}/kubectl drain {{ rke2_node_name }} \
      --ignore-daemonsets --delete-local-data {{ rke2_drain_additional_args }}
  register: drain_result
  until: drain_result.rc == 0
  retries: 100
  delay: 15

- name: Restart the RKE2 service on the specified node
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted

- name: Wait for all nodes to be ready again
  ansible.builtin.command: >
    {{ rke2_data_path }}/kubectl get nodes
    -o jsonpath={.items[*].status.conditions[?(@.type=='Ready')].status}
  register: nodes_status
  changed_when: false
  until: nodes_status.stdout.find('False') == -1
  retries: 100
  delay: 15

- name: Uncordon the specified RKE2 node
  ansible.builtin.command:
    argv:
      - "{{ rke2_data_path }}/kubectl"
      - uncordon
      - "{{ rke2_node_name }}"
  changed_when: false

- name: Wait for all pods to be ready again
  ansible.builtin.command: >
    {{ rke2_data_path }}/kubectl get pods -A
    -o jsonpath={.items[*].status.conditions[?(@.type=='Ready')].status}
  register: pods_status
  changed_when: false
  until: pods_status.stdout.find('False') == -1
  retries: 100
  delay: 15

- name: Wait for all pods to pass readiness checks
  ansible.builtin.command:
    argv:
      - "{{ rke2_data_path }}/kubectl"
      - wait
      - --for=condition=Ready
      - --all
      - --timeout=0
      - "{{ rke2_wait_for_all_pods_to_be_healthy_args }}"
  register: wait_result
  changed_when: false
  until: wait_result.rc == 0
  retries: 100
  delay: 15


