---
- name: |
    Install EPEL package repository for Amazon Linux 2 or RedHat-based systems
  ansible.builtin.dnf:
    name: epel-release
    state: present
  when: |
    (ansible_distribution == "Amazon Linux" and
     ansible_distribution_version is version('2', '==')) or
    (ansible_os_family == "RedHat" and
     ansible_distribution_version is version('7', '>=') and
     ansible_distribution_version is version('10', '<='))

- name: Install the EPEL GPG key
  ansible.builtin.rpm_key:
    state: present
    key: "{{ epel_gpg_key }}"

- name: Install the EPEL-release package
  ansible.builtin.package:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Install the EPEL-next-release package (conditional)
  ansible.builtin.package:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next
  notify: Update package cache


