---
- name: Ensure /etc/openvpn/easy-rsa exists and set permissions.
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize the EasyRSA PKI directory.
  command: ./easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build the CA certificate using EasyRSA.
  command: ./easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate the Diffie-Hellman (DH) parameters using EasyRSA.
  command: ./easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build the server certificate using EasyRSA.
  command: ./easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build the client certificate using EasyRSA.
  command: ./easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate the Certificate Revocation List (CRL) using EasyRSA.
  command: ./easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate the Diffie-Hellman (DH) key using OpenVPN.
  command: openvpn --genkey --secret pki/ta.key
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Copy files to the /etc/openvpn/server directory.
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn/server/
  loop:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/dh.pem
    - /etc/openvpn/easy-rsa/pki/ta.key
    - /etc/openvpn/easy-rsa/pki/issued/server.crt
    - /etc/openvpn/easy-rsa/pki/private/server.key
    - /etc/openvpn/easy-rsa/pki/issued/client.crt
    - /etc/openvpn/easy-rsa/pki/private/client.key

- name: Copy files to the /etc/openvpn directory.
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn/
  loop:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/ta.key

- name: Place the server.conf file.
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    owner: root
    group: root
    mode: '0644'


