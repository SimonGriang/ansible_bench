  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings for the httpd service if SELinux is enabled on the target machine
  when: ansible_selinux.status == "enabled"
  block:
    - name: Enable httpd_use_cifs
      ansible.posix.seboolean:
        name: httpd_use_cifs
        state: true
        persistent: true
    - name: Enable httpd_use_nfs
      ansible.posix.seboolean:
        name: httpd_use_nfs
        state: true
        persistent: true
    - name: Enable httpd_use_fusefs
      ansible.posix.seboolean:
        name: httpd_use_fusefs
        state: true
        persistent: true
    - name: Allow httpd SSL port
      ansible.posix.seport:
        ports: "{{ httpd_ssl_port }}"
        proto: tcp
        state: present
        setype: httpd_port_t
      when: httpd_ssl_port is defined

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "{{ httpd_config_mode }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Activate specific Apache HTTP Server modules on Debian-based systems using the a2enmod command
  ansible.builtin.command:
    cmd: "a2enmod {{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  notify:
    - Test httpd configuration validity
  when: ansible_facts.os_family == 'Debian'
  changed_when: false

- name: Import tasks related to SSL configuration if the https_ssl_enable variable is defined
  ansible.builtin.import_tasks: ssl.yml
  when: https_ssl_enable is defined

- name: Import tasks related to locations configuration if the httpd_locations variable is defined
  ansible.builtin.import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import tasks related to virtual hosts configuration if the httpd_vhosts variable is defined
  ansible.builtin.import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure custom ports for the Apache HTTP Server on Debian-based and Suse-based systems
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_ports_conf_dest }}"
    mode: "{{ httpd_ports_conf_mode }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  when: ansible_facts.os_family in ['Debian', 'Suse']

- name: Import tasks related to directories configuration if the httpd_directories variable is defined
  ansible.builtin.import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Remove the default index.html file from the Apache HTTP Server's data directory if the httpd_remove_example variable is defined
  ansible.builtin.file:
    path: "{{ httpd_remove_example }}"
    state: absent
  when: httpd_remove_example is defined

- name: Start and enable the Apache HTTP Server service
  ansible.builtin.service:
    name: httpd
    state: started
    enabled: true


