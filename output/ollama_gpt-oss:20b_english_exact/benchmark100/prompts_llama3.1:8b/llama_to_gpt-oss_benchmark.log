---
- name: Configure Ansible Installation
  hosts: all
  gather_facts: true
  become: true
  tasks:
    - name: Set the package state based on how Ansible is installed.
      set_fact:
        ansible_pkg_state: "{{ 'present' if ansible_pkg_install_method == 'package' else 'absent' }}"

    - name: Set up Ansible on RedHat.
      yum:
        name:
          - python3
          - python3-pip
          - ansible
        state: "{{ ansible_pkg_state }}"
      when:
        - ansible_os_family == 'RedHat'
        - ansible_distribution != 'Fedora'

    - name: Set up Ansible on Fedora.
      dnf:
        name:
          - python3
          - python3-pip
          - ansible
        state: "{{ ansible_pkg_state }}"
      when: ansible_distribution == 'Fedora'

    - name: Set up Ansible on Ubuntu.
      apt:
        name:
          - python3
          - python3-pip
          - ansible
        state: "{{ ansible_pkg_state }}"
        update_cache: true
      when:
        - ansible_os_family == 'Debian'
        - ansible_distribution == 'Ubuntu'

    - name: Set up Ansible on Debian.
      apt:
        name:
          - python3
          - python3-pip
          - ansible
        state: "{{ ansible_pkg_state }}"
        update_cache: true
      when:
        - ansible_os_family == 'Debian'
        - ansible_distribution != 'Ubuntu'

    - name: Set up Ansible using Pip.
      pip:
        name: ansible
        state: latest
      when: ansible_pkg_install_method == 'pip'


