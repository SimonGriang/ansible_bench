---
- name: Role tasks
  hosts: all
  tasks:
    - name: Import a separate task file called assert.yml into the playbook
      import_tasks: assert.yml

    - name: Disable automatic service management on installation when the apt_autostart_state variable is set to "disabled"
      copy:
        dest: /usr/sbin/policy-rc.d
        content: "exit 101\n"
        mode: '0755'
      when: apt_autostart_state == "disabled"

    - name: Enable automatic service management on installation when the apt_autostart_state variable is set to "enabled"
      file:
        path: /usr/sbin/policy-rc.d
        state: absent
      when: apt_autostart_state == "enabled"


