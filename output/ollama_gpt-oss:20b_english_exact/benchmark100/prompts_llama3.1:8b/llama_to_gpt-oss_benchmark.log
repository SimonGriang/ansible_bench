---
- name: Ensure Helm binary is present
  hosts: all
  tasks:
    - name: Task 1
      stat:
        path: "{{ helm_bin_path }}"
      register: helm_check

    - name: Task 2
      command: "{{ helm_bin_path }} version --short"
      register: helm_existing_version
      failed_when: false
      changed_when: false

    - name: Task 3
      get_url:
        url: >-
          {{ ['https://',
                helm_repo_path,
                '/helm-',
                helm_version,
                '-',
                helm_platform,
                '-',
                helm_arch,
                '.tar.gz'] | join('') }}
        dest: /tmp/helm
        mode: "0755"
      when: >-
        (helm_check.stat.exists | default(false) == false) or
        (helm_existing_version.stdout.find(helm_version) == -1)

    - name: Task 4
      copy:
        src: /tmp/helm
        dest: "{{ helm_bin_path }}"
        mode: "0755"
      become: true
      when: >-
        (helm_check.stat.md5 | default('') !=
        (lookup('file', '/tmp/helm') | checksum))


