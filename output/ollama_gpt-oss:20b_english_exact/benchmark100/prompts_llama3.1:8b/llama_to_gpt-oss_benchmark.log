---
- name: Import and run the assert.yml file on the localhost
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: >
    Install the required packages
    with the specified package names and state
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush the handlers to ensure any pending tasks are executed
  meta: flush_handlers

- name: Configure selinux based on the conditions and variables provided
  when:
    - selinux_status is defined
    - ansible_connection not in ['container', 'docker', 'community.docker.docker']
  block:
    - name: Manage selinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot
    - name: Manage selinux booleans
      when: selinux_booleans is defined
      selinux_boolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"

handlers:
  - name: Gather facts
    meta: gather_facts

  - name: Reboot
    reboot:
      msg: "Rebooting to apply SELinux changes"
      pre_reboot_delay: 10
      reboot_timeout: 600
      post_reboot_delay: 10


