---
- name: Download RKE2 kubeconfig from master server to localhost
  fetch:
    src: "{{ master_kubeconfig_path }}"
    dest: "{{ local_kubeconfig_path }}"
    flat: yes

- name: Replace loopback IP with master server IP in kubeconfig file
  replace:
    path: "{{ local_kubeconfig_path }}"
    regexp: "(127\\.0\\.0\\.1|\\[::1\\])"
    replace: "{{ master_ip }}"
    mode: "0600"
  delegate_to: localhost
  become: false


