  changed_when: ansible_swaptotal_mb > 0

- name: Hardening | Disable Swap
  ansible.builtin.lineinfile:
    path: /etc/fstab
    regexp: '^([^#].*\\s+swap\\s+.*)$'
    state: absent
  when: vault_hardening_disable_swap | bool

- name: Hardening | Disable Core Dumps
  community.general.pam_limits:
    domain: '*'
    limit_type: "{{ item.type }}"
    limit_item: core
    value: 0
  loop:
    - type: hard
    - type: soft
  when: vault_hardening_disable_core_dumps | bool

- name: Hardening | Disable Shell Command History
  ansible.builtin.copy:
    src: vault.sh
    dest: /etc/profile.d/vault.sh
    owner: root
    group: root
    mode: '0644'
  when: vault_hardening_disable_shell_command_history | bool

- name: Hardening | Configure SELinux / AppArmor
  ansible.builtin.package:
    name: selinux-policy
    state: present

- name: Hardening | Configure SELinux / AppArmor
  ansible.posix.selinux:
    policy: targeted
    state: enforcing

- name: Hardening | Configure SELinux / AppArmor
  ansible.builtin.command: aa-enforce /etc/apparmor.d/*
  changed_when: false
  failed_when: false


