---
- name: Create local ssh key directory for a user
  file:
    path: >-
      "{{ user.ssh_key_dir | default('/home/{{ user.name }}/.ssh_keys') }}"
    state: directory
    mode: '0750'
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"

- name: Manage the user account
  user:
    name: "{{ user.name }}"
    comment: "{{ user.comment | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    create_home: "{{ user.create_home | default(true) }}"
    password: "{{ user.password | default(omit) }}"
    expires: >-
      "{{ user.password_expiration | default(omit) }}"

- name: Set up the user's sudo options
  template:
    src: "templates/{{ user.name }}.j2"
    dest: >-
      "/etc/sudoers.d/{{ user.name }}"
    mode: '0440'
    owner: root
    group: root
  when: user.sudo_options | default(false)

- name: Set up the user's sudo options
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: not user.sudo_options | default(false)

- name: Generate the user's private SSH key
  vars:
    key_file: "{{ user.ssh_key_dir | default('/home/{{ user.name }}/.ssh_keys') }}/id_rsa"
  command: >-
    ssh-keygen -t rsa -b 4096 -f "{{ key_file }}"
    -N '' -q
  creates: "{{ key_file }}"
  when: user.ssh_key_management | default(false)

- name: Generate the user's public SSH key
  vars:
    key_file: "{{ user.ssh_key_dir | default('/home/{{ user.name }}/.ssh_keys') }}/id_rsa"
    pub_file: "{{ key_file }}.pub"
  command: >-
    ssh-keygen -y -f "{{ key_file }}"
    > "{{ pub_file }}"
  creates: "{{ pub_file }}"
  when: user.ssh_key_management | default(false)

- name: Convert the user's SSH key to PPK format
  vars:
    key_file: "{{ user.ssh_key_dir | default('/home/{{ user.name }}/.ssh_keys') }}/id_rsa"
  command: >-
    puttygen "{{ key_file }}" -O private
    -o "{{ key_file }}.ppk"
  creates: "{{ key_file }}.ppk"
  when: user.ssh_key_management | default(false)

- name: Get or set the user's home directory
  getent:
    database: passwd
    key: "{{ user.name }}"
  register: user_passwd_entry

- name: Get or set the user's home directory
  vars:
    default_home: "/home/{{ user.name }}"
  set_fact:
    user_home: >-
      "{{ user_passwd_entry.entries[user.name][4] | default(default_home) }}"
  when: user_passwd_entry is defined

- name: Create the user's .ssh directory
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  when: user_home is defined

- name: Deploy authorized keys for the user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
    mode: '0600'
  loop: "{{ user.authorized_keys | default([]) }}"
  when: user.authorized_keys | default([]) | length > 0

- name: Remove unauthorized keys for the user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys | default([]) }}"
  when: user.unauthorized_keys | default([]) | length > 0

- name: Copy the generated private SSH key for the user
  vars:
    key_file: "{{ user.ssh_key_dir | default('/home/{{ user.name }}/.ssh_keys') }}/id_rsa"
  copy:
    src: "{{ key_file }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0400'
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  when: user.copy_private_key | default(false)

- name: Check the user's password validity
  vars:
    name: "{{ user.name }}"
  command: >-
    chage -l "{{ name }}"
    | grep 'Password expires'
  register: users_pw_valid
  changed_when: false
  when: user.password_validity | default(false)

- name: Set the user's password validity
  command: >-
    chage -E {{ user.password_validity_date }}
    {{ user.name }}
  when:
    - user.password_validity | default(false)
    - users_pw_valid.stdout | search('Password expires') == false

- name: Place the private key file for the user
  vars:
    key_file: "{{ user.ssh_key_dir | default('/home/{{ user.name }}/.ssh_keys') }}/{{ user.private_key_file | default('id_rsa') }}"
    dest_file: "{{ user_home }}/.ssh/{{ user.private_key_file | default('id_rsa') }}"
  copy:
    src: "{{ key_file }}"
    dest: "{{ dest_file }}"
    mode: '0400'
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  when: user.private_keys | default(false)


