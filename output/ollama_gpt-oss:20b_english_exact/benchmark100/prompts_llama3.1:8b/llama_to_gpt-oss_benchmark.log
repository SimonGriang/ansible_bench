---
- name: Task 1: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Task 2: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}_{{ ansible_distribution | lower }}_{{ ansible_distribution_major_version }}.yml"

- name: Task 3: Gather architecture specific variables
  include_vars:
    file: architecture.yml

- name: Task 4: Set OS-specific variables (I)
  set_fact:
    "{{ item.key }}": "{{ item.value }}"
  loop: "{{ vars | dict2items }}"
  when: item.value is defined and item.value is not none

- name: Task 5: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir }}"
  when: java_open_jdk_home_dir is defined and java_open_jdk_home_dir != none

- name: Task 5: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_package: "{{ java_open_jdk_package }}"
  when: java_open_jdk_package is defined and java_open_jdk_package != none

- name: Task 6: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Task 7: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "{{ item }}"
        state: absent
      loop: "{{ deprecated_debian_repos | default([]) }}"

    - name: Install extra apt tools
      apt:
        name:
          - apt-transport-https
          - ca-certificates
          - gnupg
          - wget
        state: present
        update_cache: yes

    - name: Add required key repositories
      apt_key:
        url: "{{ item }}"
        state: present
      loop: "{{ debian_key_urls | default([]) }}"

    - name: Add required repositories
      apt_repository:
        repo: "{{ item }}"
        state: present
      loop: "{{ debian_repo_urls | default([]) }}"
  when: ansible_facts['os_family'] == 'Debian'

- name: Task 8: RedHat pre-requisites
  block:
    - name: Add required key repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        gpgcheck: yes
        gpgkey: "{{ item.gpgkey }}"
      loop: "{{ redhat_key_repos | default([]) }}"

    - name: Add required repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        gpgcheck: yes
        gpgkey: "{{ item.gpgkey }}"
      loop: "{{ redhat_repo_repos | default([]) }}"
  when: ansible_facts['os_family'] == 'RedHat'

- name: Task 9: Install required libs
  package:
    name: "{{ java_required_libs | default([]) }}"
    state: present

- name: Task 10: Install Java, Debian
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
    update_cache: yes
  when: ansible_facts['os_family'] == 'Debian'

- name: Task 11: Install Java, RedHat
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present
  when: ansible_facts['os_family'] == 'RedHat'

- name: Task 12: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0644'

- name: Task 13: Source environment variables
  shell: source /etc/profile
  args:
    executable: /bin/bash

- name: Task 14: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  file:
    src: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java"
    dest: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java"
    state: link
  when: java_version is defined and java_version | int < 11

- name: Task 15: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  file:
    src: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java"
    dest: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java"
    state: link
  when: java_version is defined and java_version | int >= 11


