---
- name: >-
    Import assert.yml file for task execution and skip the rest of the
    tasks on the first run
  import_tasks: assert.yml
  run_once: true

- name: Pre-configure Debian systems for postfix installation
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: No configuration
    vtype: string

- name: Install postfix package
  package:
    name: postfix
    state: present

- name: Install postfix-mysql package if specific conditions are met
  package:
    name: postfix-mysql
    state: present
  when: >-
    'mysql' in postfix_virtual_mailbox_maps or
    'mysql' in postfix_virtual_mailbox_domains or
    'mysql' in postfix_virtual_alias_maps

- name: Configure postfix transport maps
  template:
    src: transport.j2
    dest: /etc/postfix/transport
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate postfix configuration
    - rebuild transport maps database

- name: Configure postfix header checks
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate postfix configuration
    - reload postfix

- name: Set values for the main.cf file
  set_fact:
    postfix_main_cf_entries:
      - key: recipient_access
        value: "{{ postfix_recipient_access | default([]) }}"
      - key: sender_access
        value: "{{ postfix_sender_access | default([]) }}"
      - key: mynetworks
        value: "{{ postfix_mynetworks | default([]) }}"
      - key: mydestination
        value: "{{ postfix_mydestination | default([]) }}"
      - key: relay_domains
        value: "{{ postfix_relay_domains | default([]) }}"
      - key: smtpd_recipient_restrictions
        value: "{{ postfix_smtpd_recipient_restrictions | default([]) }}"
      - key: smtpd_sender_restrictions
        value: "{{ postfix_smtpd_sender_restrictions | default([]) }}"
      - key: virtual_mailbox_domains
        value: "{{ postfix_virtual_mailbox_domains | default([]) }}"
      - key: virtual_alias_domains
        value: "{{ postfix_virtual_alias_domains | default([]) }}"

- name: Configure postfix main.cf
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate postfix configuration
    - restart postfix

- name: Configure postfix master.cf
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate postfix configuration
    - restart postfix

- name: Create a directory for TLS certificates and keys
  file:
    path: /etc/postfix/ssl
    state: directory
    owner: root
    group: root
    mode: '0700'

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_cert_src }}"
    dest: /etc/postfix/ssl/postfix_cert.pem
    owner: root
    group: root
    mode: '0644'
  notify:
    - reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_src }}"
    dest: /etc/postfix/ssl/postfix_key.pem
    owner: root
    group: root
    mode: '0600'
  notify:
    - reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    content: "{{ postfix_aliases }}"
    dest: /etc/postfix/aliases
    owner: root
    group: root
    mode: '0644'
  notify:
    - rebuild alias database
    - reload postfix

- name: Configure sender_access
  copy:
    content: "{{ postfix_sender_access }}"
    dest: /etc/postfix/sender_access
    owner: root
    group: root
    mode: '0644'
  notify:
    - rebuild sender_access database
    - reload postfix

- name: Configure recipient_access
  copy:
    content: "{{ postfix_recipient_access }}"
    dest: /etc/postfix/recipient_access
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate postfix configuration
    - rebuild recipient_access database
    - reload postfix

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_smtp_sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password
    owner: root
    group: root
    mode: '0600'
  notify:
    - rebuild sasl_password_map database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix service
  service:
    name: postfix
    state: started
    enabled: true


