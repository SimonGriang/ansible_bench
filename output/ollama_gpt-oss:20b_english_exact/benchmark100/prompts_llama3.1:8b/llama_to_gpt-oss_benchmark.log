---
- hosts: all
  gather_facts: false
  tasks:
    - name: Create a system group named etcd and ensure it exists.
      group:
        name: etcd
        state: present
        system: true

    - name: |-
        Create a system user named etd, assign it to the etcd group,
        and set its shell to /bin/nologin.
      user:
        name: etcd
        state: present
        system: true
        groups: etcd
        shell: /bin/nologin
        create_home: false
        password_lock: true

    - name: >-
        Copy the systemctl config file for kernel hardening to the
        /etc/sysctl.d/ directory, using a conditional source file based
        on the writeability of the /usr/local/share directory and the
        result of a command.
      copy:
        src: >-
          "\"{{ (lookup('pipe','test -w /usr/local/share; echo $?') | int == 0) and
            (lookup('pipe','echo ok; echo $?') | int == 0) |
            ternary('hardening.conf', 'hardening.conf.default') }}\""
        dest: /etc/sysctl.d/hardening.conf
        owner: root
        group: root
        mode: '0644'
      notify: Restart systemd-sysctl

    - name: Flush the handlers to run pending tasks.
      meta: flush_handlers

  handlers:
    - name: Restart systemd-sysctl
      service:
        name: systemd-sysctl
        state: restarted


