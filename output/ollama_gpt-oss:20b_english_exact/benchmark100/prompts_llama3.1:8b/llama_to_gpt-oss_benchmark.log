---
- name: Task 1: Import assert.yml task
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2.1: Install repository for RedHat task
  yum_repository:
    name: hashicorp
    description: Hashicorp Repository
    baseurl: https://rpm.releases.hashicorp.com/RHEL/$releasever/$basearch
    enabled: yes
    gpgcheck: yes
    repo_gpgcheck: yes
    gpgkey: https://rpm.releases.hashicorp.com/gpg
  when: ansible_os_family == "RedHat"

- name: Task 2.2: Configure Debian task
  block:
    - name: Task 2.2.1: Install required package gpg task
      apt:
        name: gpg
        state: present
        update_cache: yes
      when: ansible_os_family == "Debian"
    - name: Task 2.2.2: Install apt key for Debian task
      apt_key:
        url: https://apt.releases.hashicorp.com/gpg
        state: present
      when: ansible_os_family == "Debian"
    - name: Task 2.2.3: Install repository for Debian task
      apt_repository:
        repo: "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main"
        state: present
      when: ansible_os_family == "Debian"

- name: Task 2.3: Install hashicorp product using package task
  block:
    - name: Task 2.3.1: Install latest hashicorp product using package task
      package:
        name: "{{ hashicorp_product }}"
        state: latest
    - name: Task 2.3.2: Install versioned hashicorp product using package task
      package:
        name: "{{ hashicorp_product }}={{ hashicorp_version }}"
        state: present

- name: Task 3: Install manually task
  unarchive:
    src: "{{ hashicorp_download_url }}"
    dest: /usr/local/bin
    remote_src: yes
    creates: /usr/local/bin/{{ hashicorp_product }}


