---
- name: Import assert.yml file
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install prerequisites
  ansible.builtin.package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  ansible.builtin.include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  block:
    - name: Write environment settings to vault.env
      ansible.builtin.blockinfile:
        path: /etc/vault.d/vault.env
        block: "{{ vault_environment_settings | to_nice_yaml }}"
        create: true
        mode: '0644'
    - name: Restart vault service
      ansible.builtin.service:
        name: vault
        state: restarted

- name: Include hardening tasks
  ansible.builtin.include_tasks: hardening.yml

- name: Start and enable vault on OSS
  ansible.builtin.service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"

- name: Enable vault (non-OSS)
  ansible.builtin.service:
    name: vault
    enabled: true
  when: vault_type != "oss"


