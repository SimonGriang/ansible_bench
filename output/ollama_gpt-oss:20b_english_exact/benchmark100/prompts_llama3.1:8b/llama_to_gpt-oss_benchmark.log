---
- name: Import Java Asserts and Setup Local Task Execution
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install Bash
  package:
    name: bash
    state: present

- name: Install OpenJDK Java (Package)
  package:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM (Local Java Source)
  block:
    - name: Copy Oracle Java RPM to /tmp
      copy:
        src: oracle-java.rpm
        dest: /tmp/oracle-java.rpm
    - name: Install Oracle Java RPM from /tmp
      yum:
        name: /tmp/oracle-java.rpm
        state: present
  when: java_source == "local" and java_format == "rpm"

- name: Install DEB (Local Java Source)
  block:
    - name: Copy Oracle Java DEB to /tmp
      copy:
        src: oracle-java.deb
        dest: /tmp/oracle-java.deb
    - name: Install Oracle Java DEB
      apt:
        deb: /tmp/oracle-java.deb
        state: present
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java (RPM) (Repository)
  package:
    name: oracle-java
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Targz
  block:
    - name: Ensure Java install directory exists
      file:
        path: "{{ java_install_directory }}"
        state: directory
        mode: '0755'
    - name: Install Oracle Java Targz package
      unarchive:
        src: oracle-java.tgz
        dest: "{{ java_install_directory }}"
        remote_src: true
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java Policy Software (Targz)
  unarchive:
    src: oracle-java-policy.tgz
    dest: "{{ java_install_directory }}/lib/security"
    remote_src: true
  when:
    - java_jce == true
    - java_version == 8
    - java_vendor == "oracle"

- name: Set Alternative (Targz)
  alternatives:
    name: java
    path: "{{ java_install_directory }}/bin/java"
    priority: 200
  when:
    - java_format == "targz"
    - ansible_distribution != "Alpine"
    - java_vendor == "oracle"

- name: Find JAVA_HOME
  set_fact:
    JAVA_HOME_CMD: "readlink -f /usr/bin/java | xargs dirname | xargs dirname"
    JAVA_HOME: "{{ lookup('pipe', JAVA_HOME_CMD) }}"

- name: Set JAVA_HOME in /etc/profile.d/java_home.sh
  copy:
    dest: /etc/profile.d/java_home.sh
    content: |
      export JAVA_HOME={{ JAVA_HOME }}
    mode: '0644'


