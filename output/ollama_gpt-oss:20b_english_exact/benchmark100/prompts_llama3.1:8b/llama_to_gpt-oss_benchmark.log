  become: true
  tasks:
    - name: Install package with name stored in the 'vault_package' variable
      package:
        name: "{{ vault_package }}"
        state: present
      notify: Reload daemon on changes
  handlers:
    - name: Reload daemon on changes
      ansible.builtin.systemd:
        daemon_reload: true
      notify: Restart vault service
    - name: Restart vault service
      ansible.builtin.service:
        name: vault
        state: restarted


