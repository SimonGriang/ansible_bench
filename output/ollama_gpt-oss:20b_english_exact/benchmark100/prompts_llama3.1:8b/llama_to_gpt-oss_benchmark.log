---
- name: Import assert.yml and run it once on the localhost
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install the apache httpd package using the httpd_packages variable
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux booleans for httpd
  ansible.posix.seboolean:
    name: "{{ item.key }}"
    state: "{{ item.value }}"
    persistent: true
  loop: "{{ httpd_sebooleans | dict2items }}"
  when: ansible_selinux.status == 'enabled'

- name: Allow httpd ports
  community.general.seport:
    ports: "{{ httpd_port | default([]) + httpd_ssl_port | default([]) }}"
    proto: tcp
    setype: http_port_t
    state: present
  when: ansible_selinux.status == 'enabled'

- name: >-
    Configure the httpd service by creating a configuration file using a
    template
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "0644"

- name: Activate the httpd module on Debian systems using the a2enmod command
  ansible.builtin.command: a2enmod "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == 'Debian'
  register: a2enmod_result
  changed_when: "'already enabled' not in a2enmod_result.stderr"

- name: Import ssl.yml if the https_ssl_enable variable is true
  ansible.builtin.include_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml if the httpd_locations variable is defined
  ansible.builtin.include_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml if the httpd_vhosts variable is defined
  ansible.builtin.include_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: >-
    Configure ports by creating a configuration file using a template on Debian
    and Suse systems
  ansible.builtin.template:
    src: "{{ httpd_ports_conf.j2 }}"
    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
    mode: "0644"
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml if the httpd_directories variable is defined
  ansible.builtin.include_tasks: directories.yml
  when: httpd_directories is defined

- name: >-
    Remove the default index.html file in the httpd data directory
    if the httpd_remove_example variable is true
  ansible.builtin.file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable the httpd service
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


