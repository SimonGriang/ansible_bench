---
- name: Configure EPEL repositories
  hosts: all
  become: true
  tasks:
    - name: >-
        Install epel package repositories for compatible operating systems
        (RedHat-based and Amazon Linux)
      yum_repository:
        name: epel
        description: Extra Packages for Enterprise Linux
        baseurl: "{{ epel_baseurl }}"
        gpgcheck: 1
        gpgkey: "{{ epel_gpg_key }}"
        enabled: 1

    - name: Install the epel GPG key
      rpm_key:
        state: present
        key: "{{ epel_gpg_key }}"

    - name: Install the epel-release package
      yum:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache

    - name: Install the epel-next-release package (conditional)
      yum:
        name: epel-next-release
        state: present
      when: epel_next | bool
      notify: Update package cache

  handlers:
    - name: Update package cache
      yum:
        name: "*"
        state: latest
        update_cache: true


