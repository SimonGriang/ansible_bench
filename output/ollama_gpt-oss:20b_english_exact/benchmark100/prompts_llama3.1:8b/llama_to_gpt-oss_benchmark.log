---
- name: Create the RKE2 config directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  ansible.builtin.copy:
    src: "{{ rke2_config_src }}"
    dest: "{{ rke2_config_dest }}"
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  ansible.builtin.template:
    src: "{{ rke2_kubelet_config_template }}"
    dest: "{{ rke2_kubelet_config_dest }}"
    owner: root
    group: root
    mode: '0644'
  when: rke2_kubelet_config
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ rke2_containerd_registry_src }}"
    dest: "{{ rke2_containerd_registry_dest }}"
    owner: root
    group: root
    mode: '0644'
  when: rke2_custom_registry_mirrors or rke2_custom_registry_configs
  notify: Config file changed

- name: Start RKE2 service on the rest of the nodes
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: true
    delay: 5
    retries: 5
  notify: Service (re)started

- name: Mask other RKE2 service on the rest of the nodes
  ansible.builtin.service:
    name: "{{ item }}"
    state: masked
  loop: "{{ rke2_other_services }}"

- name: Wait for remaining nodes to be ready - no CNI
  ansible.builtin.wait_for:
    host: "{{ item }}"
    port: 6443
    state: started
    delay: 5
    timeout: 300
  loop: "{{ groups['remaining_nodes'] }}"
  register: wait_no_cni
  until: wait_no_cni is succeeded
  retries: 10
  delay: 10

- name: Wait for remaining nodes to be ready - with CNI
  ansible.builtin.shell: |
    set -o pipefail
    kubectl get nodes --no-headers | grep -c 'Ready'
  register: ready_nodes
  changed_when: false
  until: ready_nodes.stdout | int >= groups['remaining_nodes'] | length
  retries: 10
  delay: 10
  when: >
    inventory_hostname in groups['servers'] and
    (inventory_hostname == groups['servers'][0] or rke2_type == 'active')



