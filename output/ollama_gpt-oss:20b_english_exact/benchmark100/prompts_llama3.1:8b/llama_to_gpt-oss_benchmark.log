---
- name: Create the directories for the cadvisor installation
  ansible.builtin.file:
    path: /opt/cadvisor
    state: directory
    mode: '0755'
- name: Download the cadvisor binary from the internet
  ansible.builtin.get_url:
    url: https://example.com/cadvisor
    dest: /opt/cadvisor/cadvisor
    checksum: sha256:ABCDEF1234567890
    mode: '0755'
  when: lookup('fileglob', '/opt/cadvisor/*') | length == 0
- name: Copy the locally distributed cadvisor binary
  ansible.builtin.copy:
    src: cadvisor
    dest: /opt/cadvisor/cadvisor
    mode: '0755'
  when: lookup('fileglob', '/opt/cadvisor/*') | length > 0
- name: Create a symlink to the cadvisor binary
  ansible.builtin.file:
    src: /opt/cadvisor/cadvisor
    dest: /opt/cadvisor/cadvisor_symlink
    state: link
- name: Configure the cadvisor systemd service
  ansible.builtin.template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'
  when: lookup('fileglob', '/opt/cadvisor/*') | length > 0
- name: Test if the cadvisor service is active
  ansible.builtin.service_facts:
  - name: cadvisor
  set_fact:
    service_active: "{{ 'cadvisor' in ansible_facts.services and ansible_facts.services['cadvisor'].state == 'running' }}"
- name: Enable the cadvisor systemd service
  ansible.builtin.systemd:
    name: cadvisor
    enabled: true
- name: Start the cadvisor systemd service
  ansible.builtin.systemd:
    name: cadvisor
    state: started
    daemon_reload: true


