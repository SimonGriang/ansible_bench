---
- name: Import and execute tasks from assert.yml playbook fragment
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install logrotate package
  package:
    name: logrotate
    state: present

- name: Configure logrotate by rendering a template
  template:
    src: logrotate.conf.j2
    dest: "/etc/{{ logrotate_config_file_name }}"
    mode: '0644'

- name: Generate logrotate.d files using a template
  template:
    src: entry.j2
    dest: "/etc/logrotate.d/{{ item.key }}.conf"
    mode: '0644'
  loop: "{{ logrotate_entries | dict2items }}"
  when: not item.value.absent | default(false)
  loop_control:
    label: "{{ item.key }}"

- name: Remove logrotate.d files
  file:
    path: "/etc/logrotate.d/{{ item.key }}.conf"
    state: absent
  loop: "{{ logrotate_entries | dict2items }}"
  when: item.value.absent | default(false)
  loop_control:
    label: "{{ item.key }}"

- name: Manage logrotate service
  service:
    name: "{{ logrotate_service_name }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service_name | length > 0


