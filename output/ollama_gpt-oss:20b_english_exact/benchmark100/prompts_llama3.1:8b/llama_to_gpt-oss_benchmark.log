---
- name: Configure etcd and kernel hardening
  hosts: all
  become: true
  tasks:
    - name: Create a system group named etcd and ensure it exists.
      group:
        name: etcd
        state: present
        system: yes

    - name: Create a system user named etcd, assign it to the etcd group, and set its shell to /bin/nologin.
      user:
        name: etcd
        state: present
        system: yes
        groups: etcd
        shell: /bin/nologin
        create_home: no
        password_lock: yes

    - name: Copy the systemctl config file for kernel hardening to the /etc/sysctl.d/ directory, using a conditional source file based on the writeability of the /usr/local/share directory and the result of a command.
      copy:
        src: "{{ ( (lookup('pipe', 'test -w /usr/local/share; echo $?') | int == 0) and (lookup('pipe', 'echo ok; echo $?') | int == 0) ) | ternary('hardening.conf', 'hardening.conf.default') }}"
        dest: /etc/sysctl.d/hardening.conf
        owner: root
        group: root
        mode: '0644'
      notify: Restart systemd-sysctl

    - name: Flush the handlers to run pending tasks.
      meta: flush_handlers

  handlers:
    - name: Restart systemd-sysctl
      service:
        name: systemd-sysctl
        state: restarted


