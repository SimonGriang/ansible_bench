- name: >-
    Import assert.yml from the current directory into the playbook and
    run it once on the localhost
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Uninstall the systemd-logger package
  ansible.builtin.package:
    name: systemd-logger
    state: absent

- name: Install rsyslog and its required packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ ['rsyslog'] + rsyslog_packages | default([]) }}"

- name: Install additional rsyslog features or packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features | default([]) }}"

- name: >-
    Configure the default rsyslog configuration if specified by the
    rsyslog_deploy_default_config variable
  ansible.builtin.template:
    src: rsyslog.conf.j2
    dest: "{{ rsyslog_conf_path | default('/etc/rsyslog.conf') }}"
    mode: '0644'
  notify: Restart rsyslog
  when: rsyslog_deploy_default_config | bool

- name: Create the /etc/rsyslog.d/ directory with proper permissions
  ansible.builtin.file:
    path: /etc/rsyslog.d
    state: directory
    mode: '0755'

- name: >-
    Configure a forward rule for rsyslog if the default
    configuration is not being deployed
  ansible.builtin.template:
    src: forward_rule.conf.j2
    dest: >-
      {{ rsyslog_forward_rule_path |
      default('/etc/rsyslog.d/forward_rule.conf') }}
    mode: '0644'
  notify: Restart rsyslog
  when: not rsyslog_deploy_default_config | bool

- name: Configure additional rsyslog configuration files
  ansible.builtin.copy:
    content: "{{ item.value }}"
    dest: "{{ item.key }}"
    owner: root
    group: root
    mode: '0440'
  loop: "{{ rsyslog_rsyslog_d_files | dict2items }}"
  notify: Restart rsyslog

- name: Start and enable the rsyslog service
  ansible.builtin.service:
    name: rsyslog
    state: started
    enabled: true


