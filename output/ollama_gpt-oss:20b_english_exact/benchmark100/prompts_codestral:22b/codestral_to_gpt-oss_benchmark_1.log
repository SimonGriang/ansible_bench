  command: docker-compose --version
  register: docker_compose_vsn
  ignore_errors: true

- name: Set fact for current docker-compose version
  set_fact:
    docker_compose_current_version: >-
      {{
        docker_compose_vsn.stdout
        | regex_search('docker-compose version ([0-9.]+)', '\\1')
      }}
  when: docker_compose_vsn is defined and docker_compose_vsn.stdout != ""

- name: Remove existing docker-compose version if it's different
  file:
    path: "{{ docker_compose_path }}"
    state: absent
  when:
    - docker_compose_current_version is defined
    - docker_compose_current_version != docker_compose_version

- name: Install Docker Compose (if configured)
  get_url:
