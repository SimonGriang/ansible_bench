---
- name: Import assertions
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  ansible.posix.seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    persistent: true
  loop: "{{ httpd_sebooleans }}"
  when: selinux_enabled | bool

- name: Configure selinux ports
  ansible.posix.seport:
    ports: "{{ item }}"
    proto: tcp
    setype: http_port_t
    state: present
    persistent: true
  loop: "{{ [httpd_port, httpd_ssl_port] | reject('none') | list }}"
  when: selinux_enabled | bool

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "0644"
  notify:
    - Test httpd config
    - Restart httpd

- name: Activate httpd module | Debian
  ansible.builtin.command: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_facts['os_family'] == 'Debian'
  notify:
    - Test httpd config
  changed_when: false

- name: Import ssl configuration
  ansible.builtin.import_tasks: ssl.yml
  when: ssl_enabled | bool

- name: Import locations
  ansible.builtin.import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual hosts
  ansible.builtin.import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_server_root }}"
    mode: "0644"
  when: ansible_facts['os_family'] in ['Debian', 'Suse']
  notify:
    - Test httpd config
    - Restart httpd

- name: Import directories
  ansible.builtin.import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Remove default HTML
  ansible.builtin.file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


