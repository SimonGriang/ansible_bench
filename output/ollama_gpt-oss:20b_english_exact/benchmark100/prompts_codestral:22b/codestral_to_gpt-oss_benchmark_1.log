---
- name: >-
    Migrate Java JDK vendor from 'adoptopenjdk' to 'temurin' if selected
  set_fact:
    java_vendor: >-
      {{ 'temurin' if java_vendor == 'adoptopenjdk' else java_vendor }}

- name: Gather OS-specific variables for Java
  include_vars:
    file: >-
      {{ java_vendor }}/{{ ansible_os_family | lower }}.yml

- name: Gather architecture-specific variables for Java
  include_vars:
    file: architecture.yml

- name: Set OS-specific variables for Java (I)
  set_fact:
    java_package: >-
      {{ java_package | default(java_vendor + '-openjdk-' + java_version) }}
    java_home: >-
      {{ java_home | default('/usr/lib/jvm/' + java_vendor + '-' + java_version) }}

- name: Set OS and architecture-specific variables for Java (II)
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Handle Debian pre-requisites for Java
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "{{ java_deprecated_repo }}"
        state: absent
    - name: Install extra apt tools
      apt:
        name: "{{ java_extra_apt_tools }}"
        state: present
        update_cache: true
    - name: Add required key repositories
      apt_key:
        url: "{{ java_key_repo_url }}"
        state: present
    - name: Add required repositories
      apt_repository:
        repo: "{{ java_repo }}"
        state: present

- name: Handle RedHat pre-requisites for Java
  block:
    - name: Add required key repositories
      yum_repository:
        name: "{{ java_repo_name }}"
        description: "{{ java_repo_description }}"
        baseurl: "{{ java_repo_baseurl }}"
        gpgkey: "{{ java_repo_gpgkey }}"
        gpgcheck: true
    - name: Add required repositories
      yum_repository:
        name: "{{ java_repo_name }}"
        description: "{{ java_repo_description }}"
        baseurl: "{{ java_repo_baseurl }}"
        gpgkey: "{{ java_repo_gpgkey }}"
        gpgcheck: true

- name: Install required libraries for Java
  package:
    name: "{{ java_required_libraries }}"
    state: present

- name: Install Java on Debian
  apt:
    name: "{{ java_package }}"
    state: present
    update_cache: true

- name: Install Java on RedHat
  yum:
    name: "{{ java_package }}"
    state: present
    update_cache: true

- name: Export environment variables for Java
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0644'

- name: Source environment variables for Java
  shell: source /etc/profile.d/jdk.sh

- name: Correct Java version selected for Java < 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    priority: 100
    state: present

- name: Correct Java version selected for Java >= 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    priority: 200
    state: present


