- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0600'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: |-
    "{{ mysql_databases | selectattr('initial_import', 'undefined') |
    list }}"
  when: mysql_databases is defined

- name: List databases
  mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
  register: mysql_info

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases | selectattr('initial_import', 'defined') | list }}"
  when: item.name not in mysql_info.databases

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('%') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('*.*:ALL') }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers again
  meta: flush_handlers


