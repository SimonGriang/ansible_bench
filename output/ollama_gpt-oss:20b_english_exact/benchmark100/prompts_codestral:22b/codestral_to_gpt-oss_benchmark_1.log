        mode: '0755'
      when: not vault_path_stat.stat.exists and vault_path|length > 0

    - name: Create directories in vault_path
      file:
        path: "{{ item.path }}"
        state: directory
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_directories }}"

    - name: Create data directories
      file:
        path: "{{ item.path }}"
        state: directory
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_data_directories }}"

    - name: Generate TLS key and certificate
      command: >
