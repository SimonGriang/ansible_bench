        -out "{{ vault_data_directory }}/tls/server.crt"
      args:
        creates: "{{ vault_data_directory }}/tls/server.crt"
      notify: Restart vault

    - name: Set ownership of tls material
      file:
        path: "{{ item.path }}"
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_tls_files }}"

    - name: Copy Vault binary
      copy:
        src: "{{ vault_download_path }}/vault"
        dest: "{{ vault_path }}/usr/bin/vault"
        owner: root
        group: root
        mode: '0755'
