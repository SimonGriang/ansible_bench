---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Configure apk
  when: package_manager == 'apk'
  community.general.apk:
    state: latest
    update_cache: true
  notify: Reboot
  # noqa: package-latest

- name: Configure apt
  when: package_manager == 'apt'
  ansible.builtin.apt:
    pkg: "{{ update_prevent_upgrade_packages }}"
    state: present

- name: Configure apt
  when: package_manager == 'apt'
  ansible.builtin.apt:
    upgrade: "{{ update_upgrade_command }}"
    update_cache: true
    cache_valid_time: "{{ update_cache_valid_time }}"
  notify: Reboot

- name: Configure apt
  when: package_manager == 'apt' and update_autoremove | bool
  ansible.builtin.apt:
    autoremove: true

- name: Update all software (dnf)
  when: package_manager in ['dnf', 'dnf5']
  ansible.builtin.dnf:
    name: '*'
    state: latest
    exclude: "{{ update_excluded_packages }}"
  notify: Reboot
  # noqa: package-latest

- name: Update all software (pacman)
  when: package_manager == 'pacman'
  community.general.pacman:
    update_cache: true
    upgrade: true
  notify: Reboot

- name: Configure yum
  when: package_manager == 'yum'
  block:
    - name: Update all software (yum)
      ansible.builtin.yum:
        name: '*'
        state: latest
        exclude: "{{ update_excluded_packages }}"
      notify: Reboot
      # noqa: package-latest
    - name: Install yum-utils
      ansible.builtin.yum:
        name: yum-utils
        state: present
      when: distribution_major_version | int != 6

- name: Update all software (zypper)
  when: package_manager == 'zypper'
  community.general.zypper:
    name: '*'
    state: latest
  notify: Reboot
  # noqa: package-latest


