        mode: '0644'
      notify: Daemon reload

    - name: Copy vault configuration
      copy:
        src: vault.hcl
        dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
        mode: '0644'
      notify: Restart vault

    - name: Flush handlers
      meta: flush_handlers

  handlers:
    - name: Restart vault
      systemd:
        name: vault
        state: restarted
        daemon_reload: true

