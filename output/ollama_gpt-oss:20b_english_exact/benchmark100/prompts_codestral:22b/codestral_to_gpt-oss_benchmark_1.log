---
- name: Password tasks
  hosts: all
  become: true
  tasks:
    - name: password | Get efi path
      stat:
        path: /sys/firmware/efi
      register: efi_stat

    - name: password | Remove unwanted grub.cfg on EFI systems
      file:
        path: /boot/grub2/grub.cfg
        state: absent
      when: efi_stat.stat.isdir

    - name: password | Install user template
      template:
        src: 01_users.j2
        dest: /etc/grub.d/01_users
        mode: '0755'

    - name: password | EFI | add password
      blockinfile:
        path: /etc/grub2-efi.cfg
        block: |
          set superusers="{{ grub_user }}"
          password_pbkdf2 {{ grub_user }} {{ grub_password }}
        create: yes
      when: efi_stat.stat.isdir

    - name: password | MBR | add password
      blockinfile:
        path: /etc/grub2.cfg
        block: |
          set superusers="{{ grub_user }}"
          password_pbkdf2 {{ grub_user }} {{ grub_password }}
        create: yes
      when: efi_stat.stat.isdir

    - name: password | Add --unrestricted
      lineinfile:
        path: "{{ item }}"
        line: "--unrestricted"
        insertafter: EOF
      loop: "{{ grub_password_unrestricted_files }}"
      when: grub_password_unrestricted


