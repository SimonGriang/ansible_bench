---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install dns
  ansible.builtin.package:
    name: bind9
    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: bind
    group: bind
    mode: '0755'
  loop:
    - "{{ dns_data_dir }}"
    - "{{ dns_config_dir }}"

- name: Create group
  ansible.builtin.group:
    name: bind
    state: present

- name: Create user
  ansible.builtin.user:
    name: bind
    group: bind
    system: true
    shell: /sbin/nologin
    state: present

- name: Generate rndc key
  ansible.builtin.command: rndc-confgen -a -c {{ dns_config_dir }}/rndc.key -k rndc-key
  args:
    creates: "{{ dns_config_dir }}/rndc.key"

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ dns_config_dir }}/rndc.key"
    owner: bind
    group: bind
    mode: '0600'

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: https://www.internic.net/domain/named.root
    dest: "{{ dns_data_dir }}/named.root"
    mode: '0644'
  when: dns_cache_enabled

- name: Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: "{{ dns_data_dir }}/{{ item.name }}.db"
    mode: '0644'
  loop: "{{ dns_zones }}"
  when: item.type == 'primary'

- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: "{{ dns_config_dir }}/named.conf"
    mode: '0644'

- name: Place systemd override
  ansible.builtin.copy:
    dest: /etc/systemd/system/bind9.service.d/override.conf
    content: |
      [Service]
      ExecStart=
      ExecStart=/usr/sbin/named -u bind -g -c {{ dns_config_dir }}/named.conf
    mode: '0644'
