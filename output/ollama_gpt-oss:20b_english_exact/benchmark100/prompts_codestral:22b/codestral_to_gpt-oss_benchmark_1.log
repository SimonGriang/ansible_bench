- name: Configure SELinux / AppArmor
  when:
    - vault_hardening_configure_selinux_apparmor is defined
    - vault_hardening_configure_selinux_apparmor
  block:
    - name: Install selinux-policy package
      ansible.builtin.dnf:
        name: selinux-policy
        state: present
      when: ansible_facts.selinux.status == "enabled"
    - name: Set SELinux policy to targeted and enforcing
      ansible.posix.selinux:
        policy: targeted
        state: enforcing
      when: ansible_facts.selinux.status == "enabled"
    - name: Check if AppArmor is enabled
      ansible.builtin.stat:
        path: /etc/apparmor.d
      register: apparmor_dir
    - name: Enable AppArmor profile for vault binary
      community.general.apparmor_parser:
        profile: /etc/apparmor.d/usr.bin.vault
        state: enforce
      when: apparmor_dir.stat.exists


