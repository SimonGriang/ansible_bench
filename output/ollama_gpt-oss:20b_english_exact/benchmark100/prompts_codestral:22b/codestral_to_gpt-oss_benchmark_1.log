---  
- name: Task 1: Ensure /etc/openvpn/easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: "0755"

- name: Task 2: Initialize easy-rsa
  command: "{{ openvpn_easyrsa_path }} init-pki"
  args:
    chdir: /etc/openvpn/easy-rsa
  creates: /etc/openvpn/easy-rsa/pki

- name: Task 3: Build CA
  command: "{{ openvpn_easyrsa_path }} build-ca nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  creates: /etc/openvpn/easy-rsa/pki/ca.crt

- name: Task 4: Generate Diffie-Hellman parameters
  command: "{{ openvpn_easyrsa_path }} gen-dh"
  args:
    chdir: /etc/openvpn/easy-rsa
  creates: /etc/openvpn/easy-rsa/pki/dh.pem

- name: Task 5: Build server certificates
  command: "{{ openvpn_easyrsa_path }} build-server-full server nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  creates: /etc/openvpn/easy-rsa/pki/issued/server.crt

- name: Task 6: Build client certificates
  command: "{{ openvpn_easyrsa_path }} build-client-full client nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  creates: /etc/openvpn/easy-rsa/pki/issued/client.crt

- name: Task 7: Generate Certificate Revocation List
  command: "{{ openvpn_easyrsa_path }} gen-crl"
  args:
    chdir: /etc/openvpn/easy-rsa
  creates: /etc/openvpn/easy-rsa/pki/crl.pem

- name: Task 8: Generate TLS Auth Key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Task 9: Copy files to /etc/openvpn/server
  copy:
    src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
    dest: "/etc/openvpn/server/{{ item }}"
    mode: "0640"
  loop:
    - ca.crt
    - server.crt
    - server.key
    - dh.pem
    - ta.key

- name: Task 10: Copy files to /etc/openvpn
  copy:
    src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
    dest: "/etc/openvpn/{{ item }}"
    mode: "0640"
  loop:
    - ca.crt
    - client.crt
    - client.key
    - crl.pem
    - ta.key

- name: Task 11: Place server.conf
  template:
    src: server.conf.j2
    dest: "{{ openvpn_configuration_directory }}/server.conf"
    owner: root
    group: "{{ openvpn_group }}"
    mode: "0640"
  notify: Restart openvpn


