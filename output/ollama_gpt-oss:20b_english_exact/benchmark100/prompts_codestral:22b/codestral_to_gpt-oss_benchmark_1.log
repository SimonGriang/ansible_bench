---
- name: Assert role variables
  import_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if user exists
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: user_info

- name: Create user's home directory
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0755"
  when: user_info.found

- name: Configure git
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0644"
  when:
    - user_info.found
    - git_user_email is defined
    - git_user_name is defined

- name: Create repository destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0755"
  when:
    - user_info.found
    - git_repository_destination is defined

- name: Clone repositories
  git:
    repo: "{{ item.url }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    remote_user: "{{ git_username }}"
    accept_hostkey: yes
  loop: "{{ git_repositories }}"
  when:
    - user_info.found
    - git_repository_destination is defined
    - git_repositories is defined


