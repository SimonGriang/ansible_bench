---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Configure apk
  when: package_manager == 'apk'
  community.general.apk:
    state: latest
    update_cache: yes
  notify: Reboot

- name: Configure apt
  when: package_manager == 'apt'
  apt:
    pkg: "{{ update_prevent_upgrade_packages }}"
    state: present

- name: Configure apt
  when: package_manager == 'apt'
  apt:
    upgrade: "{{ update_upgrade_command }}"
    update_cache: yes
    cache_valid_time: "{{ update_cache_valid_time }}"
  notify: Reboot

- name: Configure apt
  when: package_manager == 'apt' and update_autoremove | bool
  apt:
    autoremove: yes

- name: Update all software (dnf)
  when: package_manager in ['dnf', 'dnf5']
  dnf:
    name: '*'
    state: latest
    exclude: "{{ update_excluded_packages }}"
  notify: Reboot

- name: Update all software (pacman)
  when: package_manager == 'pacman'
  pacman:
    update_cache: yes
    upgrade: yes
  notify: Reboot

- name: Configure yum
  when: package_manager == 'yum'
  block:
    - yum:
        name: '*'
        state: latest
        exclude: "{{ update_excluded_packages }}"
      notify: Reboot
    - yum:
        name: yum-utils
        state: present
      when: distribution_major_version | int != 6

- name: Update all software (zypper)
  when: package_manager == 'zypper'
  zypper:
    name: '*'
    state: latest
  notify: Reboot


