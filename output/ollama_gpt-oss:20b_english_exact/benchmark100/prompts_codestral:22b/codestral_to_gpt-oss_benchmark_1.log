---
- name: Check if Java certificates exist
  ansible.builtin.stat:
    path: "{{ item.path }}"
  loop: "{{ java_certs }}"
  register: cert_stat_results

- name: Fail if Java certificate doesn't exist
  ansible.builtin.fail:
    msg: "Some Java certificates are missing."
  when: >-
    cert_stat_results.results
    | selectattr('stat.exists', 'equalto', False)
    | list
    | length > 0

- name: Set keystore variables for Java < 11
  ansible.builtin.set_fact:
    java_keystore_dir: |-
      "{{ java_keystore_dir | default('java_keystore_dir_old') }}"
  when: java_major_version < 11

- name: Set keystore variables for Java >= 11
  ansible.builtin.set_fact:
    java_keystore_dir: |-
      "{{ java_keystore_dir | default('java_keystore_dir_new') }}"
  when: java_major_version >= 11

- name: Import SSL certificates
  community.general.java_cert:
    src: "{{ item.path }}"
    alias: "{{ item.alias }}"
    keystore: |-
      "{{ java_keystore_dir }}/{{ java_keystore_name | default('cacerts') }}"
    keystore_pass: "{{ java_keystore_password | default('changeit') }}"
    create: true
  loop: "{{ java_certs }}"


