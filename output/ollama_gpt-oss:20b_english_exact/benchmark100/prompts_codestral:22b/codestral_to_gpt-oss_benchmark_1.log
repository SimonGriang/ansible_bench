---
- name: Update all software (apt)
  apt:
    upgrade: dist
    update_cache: true
  register: apt_upgrade
  notify:
    - Reboot

- name: Update all software (yum)
  yum:
    name: '*'
    state: latest
    exclude: "{{ update_excluded_packages }}"
  register: yum_upgrade
  notify:
    - Reboot

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    exclude: "{{ update_excluded_packages }}"
  register: dnf_upgrade
  notify:
    - Reboot

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest
    exclude: "{{ update_excluded_packages }}"
  register: zypper_upgrade
  notify:
    - Reboot

- name: Update all software (pacman)
  pacman:
    update_cache: true
    upgrade: true
  register: pacman_upgrade
  notify:
    - Reboot

- name: Update all software (apk)
  apk:
    update_cache: true
    upgrade: true
  register: apk_upgrade
  notify:
    - Reboot

- name: Configure dnf
  block:
    - name: Update all software (dnf)
      ansible.builtin.dnf:
        name: '*'
        state: latest
        exclude: "{{ update_excluded_packages }}"
      notify: Reboot
      # noqa: package-latest
      when: package_manager == 'dnf'
    - name: Install dnf-plugins-core
      ansible.builtin.dnf:
        name: dnf-plugins-core
        state: present
      when: update_plugin == true and package_manager == 'dnf'

- name: Configure yum
  block:
    - name: Update all software (yum)
      ansible.builtin.yum:
        name: '*'
        state: latest
        exclude: "{{ update_excluded_packages }}"
      notify: Reboot
      # noqa: package-latest
      when: package_manager == 'yum'
    - name: Install yum-utils
      ansible.builtin.yum:
        name: yum-utils
        state: present
      when: distribution_major_version | int != 6 and package_manager == 'yum'



