---
- hosts: all
  become: true
  tasks:
    - name: Create Vault group
      group:
        name: vault_group
        state: present

    - name: Create Vault user
      user:
        name: vault_user
        group: vault_group
        create_home: false
        state: present

    - name: Create Vault download directory
      file:
        path: "{{ vault_download_path }}"
        state: directory
        owner: vault_user
        group: vault_group
        mode: '0755'

    - name: Download Vault binary
      unarchive:
        src: "{{ vault_download_url }}"
        dest: "{{ vault_download_path }}"
        remote_src: true
        creates: "{{ vault_download_path }}/vault"
      notify: Restart vault

    - name: Check if vault_path exists
      stat:
        path: "{{ vault_path }}"
      register: vault_path_stat

    - name: Create vault_path if it does not exist
      file:
        path: "{{ vault_path }}"
        state: directory
        owner: vault_user
        group: vault_group
        mode: '0755'
      when: not vault_path_stat.stat.exists and vault_path|length > 0

    - name: Create directories in vault_path
      file:
        path: "{{ item.path }}"
        state: directory
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_directories }}"

    - name: Create data directories
      file:
        path: "{{ item.path }}"
        state: directory
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_data_directories }}"

    - name: Generate TLS key and certificate
      command: >
        openssl req -new -newkey rsa:2048 -days 365 -nodes -x509
        -subj "/CN=vault" -keyout "{{ vault_data_directory }}/tls/server.key"
        -out "{{ vault_data_directory }}/tls/server.crt"
      args:
        creates: "{{ vault_data_directory }}/tls/server.crt"
      notify: Restart vault

    - name: Set ownership of tls material
      file:
        path: "{{ item.path }}"
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_tls_files }}"

    - name: Copy Vault binary
      copy:
        src: "{{ vault_download_path }}/vault"
        dest: "{{ vault_path }}/usr/bin/vault"
        owner: root
        group: root
        mode: '0755'
      notify: Restart vault

    - name: Set capabilities on /usr/bin/vault
      capabilities:
        path: "{{ vault_path }}/usr/bin/vault"
        capability: cap_ipc_lock=ep

    - name: Touch vault.env
      file:
        path: "{{ vault_path }}/etc/vault.d/vault.env"
        state: touch
        mode: '0644'
      notify: Restart vault

    - name: Create /usr/lib/systemd/system
      file:
        path: /usr/lib/systemd/system
        state: directory
        mode: '0755'

    - name: Copy Vault service file
      template:
        src: vault.service.j2
        dest: /usr/lib/systemd/system/vault.service
        mode: '0644'
      notify: Daemon reload

    - name: Copy vault configuration
      copy:
        src: vault.hcl
        dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
        mode: '0644'
      notify: Restart vault

    - name: Flush handlers
      meta: flush_handlers

  handlers:
    - name: Restart vault
      systemd:
        name: vault
        state: restarted
        daemon_reload: true

    - name: Daemon reload
      systemd:
        daemon_reload: true


