---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0755'
  when: not rke2_airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_local_install_script_path }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0755'
  when: rke2_airgap_mode and rke2_airgap_implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: "{{ rke2_artifacts_permissions }}"
  when: rke2_airgap_mode and rke2_airgap_implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download checksum file
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_dest }}"
    - name: Download artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_dest }}"
  rescue:
    - name: Copy checksum locally
      copy:
        src: "{{ rke2_local_checksum_path }}"
        dest: "{{ rke2_checksum_dest }}"
    - name: Copy artifacts locally
      copy:
        src: "{{ rke2_local_artifacts_path }}"
        dest: "{{ rke2_artifacts_dest }}"
  when: rke2_airgap_mode and rke2_airgap_implementation == 'download'

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifacts_path }}"
    dest: "{{ rke2_artifacts_dest }}"
  when: rke2_airgap_mode and rke2_airgap_implementation == 'copy'

- name: Copy additional images tarballs
  block:
    - name: Create directory for additional images
      file:
        path: "{{ rke2_additional_images_dest }}"
        state: directory
        mode: '0755'
    - name: Copy tarball images
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_additional_images_dest }}"
      loop: "{{ additional_images_tarballs }}"
  when: rke2_airgap_mode and (additional_images_tarballs | length > 0) and rke2_airgap_implementation != 'exists'

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Check artifacts permissions
      stat:
        path: "{{ rke2_artifacts_path }}"
      register: artifacts_stat
    - name: Remove write permissions from artifacts
      file:
        path: "{{ rke2_artifacts_path }}"
        mode: '0555'
      when: artifacts_stat.stat.mode is search('w')
    - name: Check install script executable
      stat:
        path: "{{ rke2_install_script_dest }}"
      register: script_stat
    - name: Make install script executable
      file:
        path: "{{ rke2_install_script_dest }}"
        mode: '0755'
      when: not script_stat.stat.mode is search('x')
    - name: Fail if install script not executable and does not exist
      fail:
        msg: "Install script missing or not executable"
      when:
        - not script_stat.stat.exists
        - not script_stat.stat.mode is search('x')
  when: rke2_airgap_mode and rke2_airgap_implementation == 'exists'

- name: Set RKE2 bin path
  block:
    - name: Populate service facts
      service_facts:
    - name: Get stats of filesystem object
      stat:
        path: "{{ rke2_bin_path }}"
      register: bin_stat
    - name: Check if separate partition
      set_fact:
        rke2_bin_path: |
          {{ bin_stat.stat.mounted | default(false) | ternary('/var/lib/rke2/bin', '/usr/local/bin') }}

- name: Check RKE2 version
  block:
    - name: Check if binary exists
      stat:
        path: "{{ rke2_bin_path }}/rke2"
      register: binary_stat
    - name: Set installed version if binary missing
      set_fact:
        rke2_version_installed: 'not installed'
      when: not binary_stat.stat.exists
    - name: Run binary --version
      command: "{{ rke2_bin_path }}/rke2 --version"
      register: binary_version
      when: binary_stat.stat.exists
    - name: Set installed version from output
      set_fact:
        rke2_version_installed: |
          {{ binary_version.stdout | regex_search('v([0-9\\.]+)', '\\1') }}
      when: binary_stat.stat.exists
    - name: Check if service active
      service_facts:
    - name: Get service binary path
      set_fact:
        rke2_service_binary: |
          {{ ansible_facts.services[rke2_service_name].status | default('') }}
      when: ansible_facts.services | has(rke2_service_name)
    - name: Run running service binary --version
      command: "{{ rke2_service_binary }} --version"
      register: running_version
      when: rke2_service_binary != ''
    - name: Set running version
      set_fact:
        rke2_version_running: |
          {{ running_version.stdout | regex_search('v([0-9\\.]+)', '\\1') }}
      when: rke2_service_binary != ''
    - name: Set running version to desired if service binary missing
      set_fact:
        rke2_version_running: "{{ rke2_version_desired }}"
      when: rke2_service_binary == ''

- name: Prevent accidental RKE2 downgrade
  fail:
    msg: |
      Downgrade not allowed: desired {{ rke2_version_desired }} < running {{ rke2_version_running }}
  when:
    - rke2_downgrades_allowed == false
    - rke2_version_desired < rke2_version_running

- name: Run RKE2 install script
  block:
    - name: Run install script with airgap variables
      command:
        argv:
          - "{{ rke2_install_script_dest }}"
          - "--airgap"
      args:
        chdir: "{{ rke2_install_script_dest | dirname }}"
      when: rke2_airgap_mode
    - name: Run install script without airgap variables
      command:
        argv:
          - "{{ rke2_install_script_dest }}"
      args:
        chdir: "{{ rke2_install_script_dest | dirname }}"
      when: not rke2_airgap_mode
  when: rke2_version_installed != rke2_version_desired

- name: Copy Custom Manifests
  copy:
    src: "{{ custom_manifests_src }}"
    dest: "{{ custom_manifests_dest }}"
    mode: '0644'
  when: custom_manifests_src is defined and custom_manifests_src | length > 0

- name: Copy Static Pods
  copy:
    src: "{{ static_pods_src }}"
    dest: "{{ static_pods_dest }}"
    mode: '0644'
  when: static_pods_src is defined and static_pods_src | length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ env_file_src }}"
    dest: "{{ env_file_dest }}"
    mode: '0644'
  when: env_file_src is defined


