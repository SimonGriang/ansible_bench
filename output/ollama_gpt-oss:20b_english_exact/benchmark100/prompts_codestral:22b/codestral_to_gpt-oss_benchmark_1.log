- name: Import assertions
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    persistent: yes
  loop: "{{ httpd_sebooleans }}"
  when: selinux_enabled | bool

- name: Configure selinux ports
  seport:
    ports: "{{ item }}"
    protocol: tcp
    state: present
    persistent: yes
  loop: "{{ [httpd_port, httpd_ssl_port] | reject('none') | list }}"
  when: selinux_enabled | bool

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
  notify:
    - Test httpd config
    - Restart httpd

- name: Activate httpd module | Debian
  command: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_facts['os_family'] == 'Debian'
  notify:
    - Test httpd config

- name: Import ssl configuration
  import_tasks: ssl.yml
  when: ssl_enabled | bool

- name: Import locations
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual hosts
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_server_root }}"
  when: ansible_facts['os_family'] in ['Debian', 'Suse']
  notify:
    - Test httpd config
    - Restart httpd

- name: Import directories
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Remove default HTML
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


