---
- name: SSL operations
  hosts: localhost
  gather_facts: false
  tasks:
    - name: Create SSL key
      community.crypto.openssl_privatekey:
        path: "{{ ssl_dir }}/{{ ssl_key_name }}"
        size: 2048
        type: RSA
        state: present
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: '0600'

    - name: Create SSL CSR
      community.crypto.openssl_csr:
        path: "{{ ssl_dir }}/{{ ssl_csr_name }}"
        privatekey_path: "{{ ssl_dir }}/{{ ssl_key_name }}"
        common_name: "{{ ssl_common_name }}"
        state: present
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: '0640'

    - name: Create SSL certificates
      community.crypto.openssl_certificate:
        path: "{{ ssl_dir }}/{{ ssl_cert_name }}"
        privatekey_path: "{{ ssl_dir }}/{{ ssl_key_name }}"
        csr_path: "{{ ssl_dir }}/{{ ssl_csr_name }}"
        provider: selfsigned
        state: present
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: '0640'

    - name: Create PKCS#12 file
      community.crypto.openssl_pkcs12:
        path: "{{ ssl_dir }}/{{ ssl_pkcs12_name }}"
        privatekey_path: "{{ ssl_dir }}/{{ ssl_key_name }}"
        certificate_path: "{{ ssl_dir }}/{{ ssl_cert_name }}"
        state: present
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: '0600'

    - name: Read private key
      ansible.builtin.slurp:
        src: "{{ ssl_dir }}/{{ ssl_key_name }}"
      register: private_key_slurp

    - name: Read certificate
      ansible.builtin.slurp:
        src: "{{ ssl_dir }}/{{ ssl_cert_name }}"
      register: certificate_slurp

    - name: Create combined private_key and certificate file
      ansible.builtin.copy:
        dest: "{{ ssl_dir }}/{{ ssl_combined_name }}"
        content: |
          {{ private_key_slurp.content | b64decode }}
          {{ certificate_slurp.content | b64decode }}
        owner: "{{ ssl_owner }}"
