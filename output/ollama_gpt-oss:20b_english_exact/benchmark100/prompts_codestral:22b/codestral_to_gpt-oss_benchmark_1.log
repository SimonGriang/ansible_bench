---
- name: Create directories
  ansible.builtin.file:
    path: /opt/cadvisor
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Download cadvisor binary
  ansible.builtin.get_url:
    url: https://example.com/cadvisor
    dest: /opt/cadvisor/cadvisor
    mode: '0755'
    checksum: sha256:abcd1234abcd1234abcd1234abcd1234

- name: Propagate locally distributed cadvisor binary
  ansible.builtin.copy:
    src: "{{ role_path }}/files/cadvisor"
    dest: /opt/cadvisor/cadvisor
    mode: '0755'
    owner: root
    group: root
  notify: Restart cadvisor

- name: Create a symlink
  ansible.builtin.file:
    src: /opt/cadvisor/cadvisor
    dest: /usr/local/bin/cadvisor
    state: link

- name: Configure cadvisor systemd service
  ansible.builtin.copy:
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'
    content: |
      [Unit]
      Description=cAdvisor
      After=network.target

      [Service]
      ExecStart=/opt/cadvisor/cadvisor
      Restart=always
      User=root

      [Install]
      WantedBy=multi-user.target
  notify: Restart cadvisor

- name: Check cadvisor service status
  ansible.builtin.command: systemctl status cadvisor
  register: cadvisor_status
  ignore_errors: true
  changed_when: false

- name: Enable cadvisor systemd service
  ansible.builtin.systemd:
    name: cadvisor
    enabled: true

- name: Start cadvisor systemd service
  ansible.builtin.systemd:
    name: cadvisor
    state: started
    daemon_reload: true


