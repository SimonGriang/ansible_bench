---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install dns
  package:
    name: bind9
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: bind
    group: bind
    mode: '0755'
  loop:
    - "{{ dns_data_dir }}"
    - "{{ dns_config_dir }}"

- name: Create group
  group:
    name: bind
    state: present

- name: Create user
  user:
    name: bind
    group: bind
    system: yes
    shell: /sbin/nologin
    state: present

- name: Generate rndc key
  command: rndc-confgen -a -c {{ dns_config_dir }}/rndc.key -k rndc-key
  args:
    creates: "{{ dns_config_dir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_config_dir }}/rndc.key"
    owner: bind
    group: bind
    mode: '0600'

- name: Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.root
    dest: "{{ dns_data_dir }}/named.root"
    mode: '0644'
  when: dns_cache_enabled

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_data_dir }}/{{ item.name }}.db"
    mode: '0644'
  loop: "{{ dns_zones }}"
  when: item.type == 'primary'

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_config_dir }}/named.conf"
    mode: '0644'

- name: Place systemd override
  copy:
    dest: /etc/systemd/system/bind9.service.d/override.conf
    content: |
      [Service]
      ExecStart=
      ExecStart=/usr/sbin/named -u bind -g -c {{ dns_config_dir }}/named.conf
  when: ansible_service_mgr == 'systemd'

- name: Start and enable dns
  service:
    name: bind9
    state: started
    enabled: yes


