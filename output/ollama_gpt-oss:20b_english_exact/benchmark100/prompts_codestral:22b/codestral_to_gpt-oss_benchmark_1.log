---
- name: Check if Helm binary exists.
  ansible.builtin.stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version.
  ansible.builtin.command: "{{ helm_bin_path }} version"
  ignore_errors: true
  changed_when: false
  register: helm_existing_version

- name: Download helm.
  ansible.builtin.unarchive:
    src: "{{ helm_repo_path }}/{{ helm_version }}/{{ helm_platform }}-{{ helm_arch }}/helm.tar.gz"
    dest: /tmp
    remote_src: true
  when: >
    not helm_check.stat.exists or
    helm_existing_version.stdout is not defined or
    helm_existing_version.stdout | regex_search(helm_version) is none
  register: helm_download

- name: Copy helm binary into place.
  ansible.builtin.copy:
    src: "/tmp/{{ helm_platform }}-{{ helm_arch }}/helm"
    dest: "{{ helm_bin_path }}"
    mode: '0755'
  when: helm_download is defined and helm_download.changed


