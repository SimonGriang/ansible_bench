---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Wait for port to be available
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: 22
    timeout: "{{ bootstrap_timeout | default(30) }}"

- name: "Task 3: Prepare system"
  block:
    - name: Test connection
      ansible.builtin.ping:
    - name: Check if sudo is available
      ansible.builtin.command: sudo -n true
      register: sudo_check
      changed_when: false
      failed_when: sudo_check.rc != 0
  rescue:
    - name: Gather bootstrap facts
      ansible.builtin.debug:
        msg: "Gathering bootstrap facts"
    - name: Install bootstrap packages using raw module
      ansible.builtin.raw: "echo 'install bootstrap packages'"
      changed_when: false
  always:
    - name: Ensure libdnf5 is present on Fedora/RedHat
      ansible.builtin.package:
        name: libdnf5
        state: present
      when:
        - ansible_facts['os_family'] == 'RedHat'
        - ansible_facts['distribution'] == 'Fedora'

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
    become: "{{ bootstrap_become | default(false) }}"
  loop: "{{ bootstrap_facts_packages }}"


