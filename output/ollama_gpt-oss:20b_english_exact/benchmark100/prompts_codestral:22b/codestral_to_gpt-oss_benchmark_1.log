---
- name: Create document root directories
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "{{ item.documentroot }}"
  when: item.documentroot is defined

- name: Configure virtual hosts
  template:
    src: "{{ item.template_src | default('vhost.j2') }}"
    dest: "{{ item.dest }}"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "{{ item.dest }}"
  notify:
    - Test httpd config
    - Restart httpd

- name: Enable virtual hosts on Debian systems
  command: a2ensite {{ item.dest | basename }}
  args:
    creates: "/etc/apache2/sites-enabled/{{ item.dest | basename }}"
  when: ansible_facts['os_family'] == 'Debian'
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "{{ item.dest }}"
  notify:
    - Test httpd config
    - Restart httpd


