---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.command: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  when: not ansible_check_mode

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_major_version: >-
      {{ bootstrap_facts.stdout | regex_search(
          '(?i)' ~ item ~ '.*VERSION_ID="([0-9]+)',
          '\\1') }}
  loop:
    - Ubuntu
    - CentOS
    - Debian
    - Fedora
  when:
    - bootstrap_facts is succeeded
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout is search(item)

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ os_family_map | dict2items }}"
  when:
    - bootstrap_distribution is defined
    - bootstrap_distribution in item.value
  vars:
    os_family_map:
      Debian:
        - Debian
        - Ubuntu
      RedHat:
        - CentOS
        - Fedora
        - RedHat


