---
- name: Generate SSL artifacts
  hosts: localhost
  gather_facts: false
  tasks:
    - name: Create SSL key
      openssl_privatekey:
        path: "{{ ssl_dir }}/{{ ssl_key_name }}"
        size: 2048
        type: RSA
        state: present
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: '0600'

    - name: Create SSL CSR
      openssl_csr:
        path: "{{ ssl_dir }}/{{ ssl_csr_name }}"
        privatekey_path: "{{ ssl_dir }}/{{ ssl_key_name }}"
        common_name: "{{ ssl_common_name }}"
        state: present
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: '0640'

    - name: Create SSL certificates
