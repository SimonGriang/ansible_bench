---
- name: Assert role variables
  ansible.builtin.import_tasks: assert.yml

- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: Check if user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ git_username }}"
  register: user_info

- name: Create user's home directory
  ansible.builtin.file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0755"
  when: user_info.found

- name: Configure git
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0644"
  when:
    - user_info.found
    - git_user_email is defined
    - git_user_name is defined

- name: Create repository destination
  ansible.builtin.file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0755"
  when:
    - user_info.found
    - git_repository_destination is defined

- name: Clone repositories
  ansible.builtin.git:
    repo: "{{ item.url }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    accept_hostkey: true
    force: yes
  loop: "{{ git_repositories }}"
  become: true
  become_user: "{{ git_username }}"
  when:
    - user_info.found
    - git_repository_destination is defined
    - git_repositories is defined


