---
- name: Disable swap
  when:
    - vault_hardening_disable_swap is defined
    - vault_hardening_disable_swap
  block:
    - name: Turn off swap
      command: swapoff -a
      args:
        warn: false
    - name: Remove swap entry from fstab
      mount:
        src: none
        fstype: swap
        path: /swapfile
        state: absent

- name: Disable core dumps
  when:
    - vault_hardening_disable_core_dumps is defined
    - vault_hardening_disable_core_dumps
  pam_limits:
    domain: "{{limit.domain}}"
    limit_type: "{{limit.limit_type}}"
    limit_item: "{{limit.limit_item}}"
    value: "{{limit.value}}"
  loop:
    -{domain:'*',limit_type:hard,limit_item:core,value:0}
    -{domain:'*',limit_type:soft,limit_item:core,value:0}
  loop_control:
    loop_var: limit

- name: Disable Shell Command History
  when:
    - vault_hardening_disable_shell_command_history is defined
    - vault_hardening_disable_shell_command_history
  copy:
    dest: /etc/profile.d/vault_history.sh
    content: |
      #!/bin/sh
      export HISTIGNORE="*vault*"
    mode: '0644'

- name: Configure SELinux / AppArmor
  when:
    - vault_hardening_configure_selinux_apparmor is defined
    - vault_hardening_configure_selinux_apparmor
  block:
    - name: Install selinux-policy package
      yum:
        name: selinux-policy
        state: present
      when: ansible_facts.selinux.status == "enabled"
    - name: Set SELinux policy to targeted and enforcing
      selinux:
        policy: targeted
        state: enforcing
      when: ansible_facts.selinux.status == "enabled"
    - name: Check if AppArmor is enabled
      stat:
        path: /etc/apparmor.d
      register: apparmor_dir
    - name: Enable AppArmor profile for vault binary
      apparmor_parser:
        profile: /etc/apparmor.d/usr.bin.vault
        state: enforce
      when: apparmor_dir.stat.exists


