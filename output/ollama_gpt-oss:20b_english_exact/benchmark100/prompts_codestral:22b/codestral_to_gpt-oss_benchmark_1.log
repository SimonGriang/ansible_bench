---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_packages }}"

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    regexp: '^index-url'
    line: "index-url = {{ python_pip_proxy }}"
    mode: '0644'
  when: python_pip_proxy is defined

- name: Trust hosts
  lineinfile:
    path: /etc/pip.conf
    regexp: '^trusted-host'
    line: "trusted-host = {{ python_pip_trusted_host }}"
    mode: '0644'
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable | default(omit) }}"
  when: python_pip_update | bool and ansible_facts['distribution'] not in ['Bookworm', 'Noble'] and ansible_facts['os_family'] != 'Alpine'

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(omit) }}"
    executable: "{{ python_pip_executable | default(omit) }}"
  loop: "{{ python_pip_modules }}"
  when: ansible_facts['distribution'] not in ['Bookworm', 'Noble'] and ansible_facts['os_family'] != 'Alpine'


