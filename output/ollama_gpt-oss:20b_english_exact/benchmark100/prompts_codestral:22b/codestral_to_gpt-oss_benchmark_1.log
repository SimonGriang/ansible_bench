    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0755"
  when:
    - user_info.found
    - git_repository_destination is defined

- name: Clone repositories
  ansible.builtin.git:
    repo: "{{ item.url }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    clone: true
    update: true
    force: false
    accept_hostkey: true
  loop: "{{ git_repositories | default([]) }}"
  become: true
  become_user: "{{ git_username }}"
  when:
    - user_info.found
    - git_repository_destination is defined
    - git_repositories is defined


