---
- name: Import assert.yml
  import_tasks: assert.yml
- name: Pre-configure Debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'No configuration'
    vtype: string
  when: ansible_os_family == 'Debian'
- name: Install postfix
  package:
    name: postfix
    state: present
- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: "'postfix-mysql' in postfix_packages | default([])"
- name: Configure postfix (transport_maps)
  template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport_maps
    mode: '0644'
  when: postfix_transport_maps_template is defined
- name: Configure postfix (header_checks)
  template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
    mode: '0644'
  when: postfix_header_checks_template is defined
- name: Setting values for main.cf
  set_fact:
    postfix_smtpd_recipient_restrictions: |
      "{{ postfix_smtpd_recipient_restrictions | default([]) }}"
    postfix_smtpd_sender_restrictions: |
      "{{ postfix_smtpd_sender_restrictions | default([]) }}"
- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify: Validate main.cf
  handlers:
    - name: Validate main.cf
      command: postconf -d -c /etc/postfix/main.cf
      register: main_cf_validate
      failed_when: main_cf_validate.rc != 0
- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify: Validate master.cf
  handlers:
    - name: Validate master.cf
      command: postconf -d -c /etc/postfix/master.cf
      register: master_cf_validate
      failed_when: master_cf_validate.rc != 0
- name: Create cert/key directory
  file:
    path: "{{ postfix_tls_dir }}"
    state: directory
    mode: '0755'
  when: postfix_tls_dir is defined
- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: |
      "{{ postfix_smtpd_tls_cert_file_dest | default('/etc/ssl/certs/postfix.pem') }}"
    mode: '0644'
  when: postfix_smtpd_tls_cert_file_source is defined
- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: |
      "{{ postfix_smtpd_tls_key_file_dest | default('/etc/ssl/private/postfix.key') }}"
    mode: '0600'
  when: postfix_smtpd_tls_key_file_source is defined
- name: Flush handlers
  meta: flush_handlers
- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
    mode: '0644'
  when: postfix_aliases is defined
- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: '0644'
  when: postfix_sender_access is defined
- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: '0644'
  when: postfix_recipient_access is defined
- name: Place sasl_password_map
  copy:
    src: "{{ postfix_smtp_sasl_password_map }}"
    dest: /etc/postfix/sasl_password_map
    mode: '0600'
  when:
    - postfix_smtp_sasl_password_map is defined
    - postfix_smtp_sasl_password_map != ''
- name: Flush handlers (again)
  meta: flush_handlers
- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true


