- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_directories }}"

- name: Configure directories
  block:
    - template:
        src: directory.conf.j2
        dest: "{{ httpd_config_directory }}/{{ item | basename }}.conf"
        mode: '0644'
      loop: "{{ httpd_directories }}"
    - command: httpd -t
      register: httpd_test
      failed_when: httpd_test.rc != 0
    - service:
        name: httpd
        state: restarted


