---
- name: "Task 1: Ensure /etc/openvpn/easy-rsa directory exists"
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: "0755"
  become: true

- name: "Task 2: Initialize easy-rsa"
  ansible.builtin.command: "{{ openvpn_easyrsa_path }} init-pki"
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki
  become: true

- name: "Task 3: Build CA"
  ansible.builtin.command: "{{ openvpn_easyrsa_path }} build-ca nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/ca.crt
  environment:
    EASYRSA_BATCH: "yes"
  become: true

- name: "Task 4: Generate Diffie-Hellman parameters"
  ansible.builtin.command: "{{ openvpn_easyrsa_path }} gen-dh"
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/dh.pem
  become: true

- name: "Task 5: Build server certificates"
  ansible.builtin.command: "{{ openvpn_easyrsa_path }} build-server-full server nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/issued/server.crt
  environment:
    EASYRSA_BATCH: "yes"
  become: true

- name: "Task 6: Build client certificates"
  ansible.builtin.command: "{{ openvpn_easyrsa_path }} build-client-full client nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/issued/client.crt
  environment:
    EASYRSA_BATCH: "yes"
  become: true

- name: "Task 7: Generate Certificate Revocation List"
  ansible.builtin.command: "{{ openvpn_easyrsa_path }} gen-crl"
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/crl.pem
  become: true

- name: "Task 8: Generate TLS Auth Key"
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key
  become: true

- name: "Task 9: Copy files to /etc/openvpn/server"
  ansible.builtin.copy:
    src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
    dest: "/etc/openvpn/server/{{ item }}"
    mode: "0640"
  loop:
    - ca.crt
    - server.crt
    - server.key
    - dh.pem
    - ta.key
  become: true

- name: "Task 10: Copy files to /etc/openvpn"
  ansible.builtin.copy:
    src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
    dest: "/etc/openvpn/{{ item }}"
    mode: "0640"
  loop:
    - ca.crt
    - client.crt
    - client.key
    - crl.pem
    - ta.key
  become: true

- name: "Task 11: Place server.conf"
  ansible.builtin.template:
    src: server.conf.j2
    dest: "{{ openvpn_configuration_directory }}/server.conf"
    owner: root
    group: "{{ openvpn_group }}"
    mode: "0640"
  notify: Restart openvpn
  become: true


