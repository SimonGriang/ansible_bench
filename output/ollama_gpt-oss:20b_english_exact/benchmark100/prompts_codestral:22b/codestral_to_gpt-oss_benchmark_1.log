content='---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  delegate_to: localhost\n  run_once: true\n\n- name: Install prerequisites\n  package:\n    name: "{{ vault_prerequisites }}"\n    state: present\n\n- name: Include installation method specific tasks\n  include_tasks: "{{ vault_installation_method }}.yml"\n\n- name: Add Vault environment variables\n  lineinfile:\n    path: /etc/vault.d/vault.env\n    line: "{{ item.name }}={{ item.value }}"\n    create: yes\n  loop: "{{ vault_environment_settings }}"\n  notify: restart vault\n\n- name: Include hardening tasks\n  include_tasks: hardening.yml\n\n- name: Start and enable vault\n  service:\n    name: vault\n    state: started\n    enabled: yes\n  when: vault_type == "oss"\n\n- name: Enable vault\n  service:\n    name: vault\n    enabled: yes\n  when: vault_type != "oss"' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-16T07:53:26.08579702Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13751795529, 'load_duration': 172245434, 'prompt_eval_count': 615, 'prompt_eval_duration': 478049350, 'eval_count': 1302, 'eval_duration': 13100574340, 'model_name': 'gpt-oss:20b'} id='run--026bb515-4409-413d-8eca-73bdac37ce6d-0' usage_metadata={'input_tokens': 615, 'output_tokens': 1302, 'total_tokens': 1917}
