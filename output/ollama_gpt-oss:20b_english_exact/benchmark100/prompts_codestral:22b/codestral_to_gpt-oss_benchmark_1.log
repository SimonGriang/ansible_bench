---
- name: Ensure apt key is not present
  file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Ensure old apt source list is not present
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure old versions of Docker are not installed
  apt:
    name:
      - docker
      - docker.io
      - docker-engine
      - docker-ce
      - docker-ce-cli
      - containerd.io
    state: absent
    purge: yes
    update_cache: no

- name: Ensure legacy repo file is not present
  file:
    path: /etc/apt/sources.list.d/docker-legacy.list
    state: absent

- name: Ensure dependencies are installed
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: yes
    cache_valid_time: 3600

- name: Add or remove Docker repository
  apt_repository:
    repo: "deb [arch=amd64] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable"
    state: "{{ 'present' if docker_add_repo else 'absent' }}"
    filename: docker
    key: "https://download.docker.com/linux/ubuntu/gpg"
    update_cache: no
  notify: apt update

- name: Ensure handlers are notified immediately to update the apt cache
  meta: flush_handlers


