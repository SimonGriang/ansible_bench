---
- name: Assert Variables
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for Host
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"
  when:
    - bootstrap_wait_for_host | bool
    - ansible_connection not in ['container', 'docker']

- name: Prepare System
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"
  block:
    - name: Test connection
      ansible.builtin.command: "true"
      register: test_connection_result
      ignore_errors: true
      changed_when: false
    - name: Debug test connection failed
      ansible.builtin.debug:
        msg: "Test connection failed"
      when: test_connection_result.failed
    - name: Gather bootstrap facts
      ansible.builtin.setup: {}
    - name: Install bootstrap packages
      ansible.builtin.raw: "{{ bootstrap_raw_install_command }}"
      register: bootstrap_raw_result
      changed_when: bootstrap_raw_result.rc == 0

- name: Ensure System Prepared
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"
  block:
    - name: Gather Ansible facts
      ansible.builtin.setup: {}
    - name: Install bootstrap packages
      ansible.builtin.package:
        name: "{{ bootstrap_packages }}"
        state: present


