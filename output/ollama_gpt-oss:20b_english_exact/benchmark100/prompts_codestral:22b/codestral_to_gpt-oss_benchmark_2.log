---
- name: Migrate Java JDK vendor from 'adoptopenjdk' to 'temurin' if selected
  ansible.builtin.set_fact:
    java_vendor: temurin
  when: java_vendor == 'adoptopenjdk'

- name: Gather OS-specific variables for Java
  ansible.builtin.include_vars: "{{ java_vendor }}/{{ ansible_os_family | lower }}.yml"

- name: Gather architecture-specific variables for Java
  ansible.builtin.include_vars: architecture.yml

- name: Set OS-specific variables for Java (I)
  ansible.builtin.set_fact:
    java_package: "{{ java_package | default(java_open_jdk_pkg) }}"
    java_version: "{{ java_version | default(java_open_jdk_version) }}"
  when: java_package is not defined

- name: Set OS and architecture-specific variables for Java (II)
  ansible.builtin.set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Handle Debian pre-requisites for Java
  when: ansible_os_family == 'Debian'
  block:
    - name: Remove deprecated repositories
      ansible.builtin.apt:
        name: "{{ item }}"
        state: absent
      loop:
        - deprecated-repo1
        - deprecated-repo2
    - name: Install extra apt tools
      ansible.builtin.apt:
        name: apt-transport-https
        state: present
        update_cache: true
    - name: Add required key repositories
      ansible.builtin.apt_key:
        url: "{{ java_key_url }}"
        state: present
    - name: Add required repositories
      ansible.builtin.apt_repository:
        repo: "{{ java_repo }}"
        state: present

- name: Handle RedHat pre-requisites for Java
  when: ansible_os_family == 'RedHat'
  block:
    - name: Add required key repositories
      ansible.builtin.rpm_key:
        state: present
        key: "{{ java_key_url }}"
    - name: Add required repositories
      ansible.builtin.yum_repository:
        name: java
        description: Java Repository
        baseurl: "{{ java_repo }}"
        enabled: true
        gpgcheck: true

- name: Install required libraries for Java
  ansible.builtin.package:
    name: "{{ java_libs }}"
    state: present

- name: Install Java on Debian
  ansible.builtin.apt:
    name: "{{ java_package }}"
    state: present
    update_cache: true
  when: ansible_os_family == 'Debian'

- name: Install Java on RedHat
  ansible.builtin.yum:
    name: "{{ java_package }}"
    state: present
    update_cache: true
  when: ansible_os_family == 'RedHat'

- name: Export environment variables for Java
  ansible.builtin.template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0644'

- name: Source environment variables for Java
  ansible.builtin.shell: source /etc/profile.d/jdk.sh
  args:
    executable: /bin/bash
  changed_when: false

- name: Correct Java version selected for Java < 11
  community.general.alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_home }}/bin/java"
    priority: "{{ java_priority }}"
  when: java_version is defined and java_version | int < 11

- name: Correct Java version selected for Java >= 11
  community.general.alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_home }}/bin/java"
    priority: "{{ java_priority }}"
  when: java_version is defined and java_version | int >= 11


