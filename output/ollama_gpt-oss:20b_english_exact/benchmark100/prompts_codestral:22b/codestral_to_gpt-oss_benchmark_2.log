---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install using package
  block:
    - name: Set up repository for RedHat/Rocky
      ansible.builtin.yum_repository:
        name: hashicorp
        description: HashiCorp Repository
        baseurl: https://rpm.releases.hashicorp.com/RHEL/$releasever/$basearch/stable
        gpgcheck: yes
        gpgkey: https://rpm.releases.hashicorp.com/gpg
        enabled: yes
    - name: Set up repository for Debian
      ansible.builtin.apt_repository:
        repo: "deb [arch=amd64] https://apt.releases.hashicorp.com $(lsb_release -cs) main"
        state: present
        filename: hashicorp
    - name: Install required packages
      ansible.builtin.package:
        name:
          - curl
          - gnupg
        state: present
    - name: Install HashiCorp products
      ansible.builtin.package:
        name: "{{ hashicorp_products }}"
        state: present
  when: hashicorp_installation_method == "package"

- name: Install manually
  unarchive:
    src: "{{ hashicorp_package_src }}"
    dest: "{{ hashicorp_install_path }}"
    remote_src: yes
    mode: '0755'
    owner: root
    group: root
  when: hashicorp_installation_method == "manual"


