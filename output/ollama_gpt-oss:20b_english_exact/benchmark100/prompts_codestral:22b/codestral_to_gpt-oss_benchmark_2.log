  retries: 30
  delay: 10
  when: rke2_wait_for_all_pods_to_be_ready
  delegate_to: >-
    "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

- name: Wait for all pods to pass readiness checks
  command: |
