    rke2_bin_path: "{{ rke2_bin_path | default('/usr/bin/rke2') }}"

- name: Check RKE2 version
  block:
    - name: Get installed version
      ansible.builtin.command: |
        {{ rke2_bin_path }} --version
      register: installed_version_cmd
      ignore_errors: true
    - name: Set installed version fact
      ansible.builtin.set_fact:
        installed_version: |
          {{ installed_version_cmd.stdout_lines[0] |
             regex_replace('^.*\\s(\\S+).*$', '\\1') }}
      when: installed_version_cmd.rc == 0
    - name: Set installed version to not installed
      ansible.builtin.set_fact:
        installed_version: "not installed"
      when: installed_version_cmd.rc != 0
    - name: Get running service version
      ansible.builtin.command: |
        {{ rke2_running_service_cmd }}
      vars:
        rke2_running_service_cmd: |
          systemctl show -p ExecStart --value rke2-server | cut -d' ' -f1 | xargs -I{} {} --version
      register: running_version_cmd
      ignore_errors: true
    - name: Set running version fact
      ansible.builtin.set_fact:
        running_version: |
          {{ running_version_cmd.stdout_lines[0] |
             regex_replace('^.*\\s(\\S+).*$', '\\1') }}
      when: running_version_cmd.rc == 0
    - name: Set running version to desired if service binary missing
      ansible.builtin.set_fact:
        running_version: "{{ desired_rke2_version }}"
      when: running_version_cmd.rc != 0
  when: true

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.fail:
    msg: |
      Desired version {{ desired_rke2_version }} is lower than running version {{ running_version }}
      and downgrades are not allowed.
  when: desired_rke2_version < running_version and not allow_downgrades

- name: Run RKE2 install script
  ansible.builtin.shell: |
    {{ rke2_install_script_dest }} {{ install_script_args | default('') }}
  args:
    executable: /bin/bash
  when:
    - installed_version == 'not installed'
    - or desired_rke2_version != installed_version
  register: install_script_result

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: |
      {{ custom_manifests_src }}
    dest: |
      {{ custom_manifests_dest }}
  when: custom_manifests_to_copy | length > 0

- name: Copy Static Pods
  ansible.builtin.copy:
    src: |
      {{ static_pods_src }}
    dest: |
      {{ static_pods_dest }}
  when: static_pods_to_copy | length > 0

- name: Copy RKE2 environment file
  ansible.builtin.copy:
    src: |
      {{ rke2_env_src }}
    dest: |
      {{ rke2_env_dest }}
  when: environment_options | length > 0


