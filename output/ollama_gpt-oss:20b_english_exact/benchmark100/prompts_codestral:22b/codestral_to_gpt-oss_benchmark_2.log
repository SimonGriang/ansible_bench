---
become: true
environment:
  RKE2_TOKEN: "{{ rke2_token }}"
block:
  - name: Create the RKE2 config directory
    ansible.builtin.file:
      path: /etc/rancher/rke2
      state: directory
      owner: root
      group: root
      mode: '0755'
  - name: Set server taints
    ansible.builtin.set_fact:
      rke2_node_taints: "{{ rke2_server_node_taints }}"
    when: rke2_type == 'server'
  - name: Set agent taints
    ansible.builtin.set_fact:
      rke2_node_taints: "{{ rke2_agent_node_taints }}"
    when: rke2_type == 'agent'
  - name: Copy RKE2 config
    ansible.builtin.copy:
      src: "{{ rke2_config }}"
      dest: /etc/rancher/rke2/config.yaml
      owner: root
      group: root
      mode: '0644'
    notify: Config file changed
  - name: Copy kubelet config
    ansible.builtin.template:
      src: templates/kubelet-config.yaml.j2
      dest: /etc/rancher/rke2/kubelet-config.yaml
      owner: root
      group: root
      mode: '0644'
    when: rke2_kubelet_config | length > 0
    notify: Config file changed
  - name: Copy Containerd Registry Configuration file
    ansible.builtin.copy:
      src: "{{ rke2_custom_registry_path }}"
      dest: /etc/rancher/rke2/registries.yaml
      owner: root
      group: root
      mode: '0644'
    when:
      - rke2_custom_registry_mirrors | length > 0
      - rke2_custom_registry_configs | length > 0
    notify: Config file changed
  - name: Start RKE2 service on the rest of the nodes
    ansible.builtin.systemd:
      name: "{{ rke2_service_name }}"
      state: started
      enabled: true
    notify: Service (re)started
  - name: Mask other RKE2 service on the rest of the nodes
    ansible.builtin.systemd:
      name: "{{ 'agent' if rke2_type == 'server' else 'server' }}"
      masked: true
      enabled: false
  - name: Wait for remaining nodes to be ready - no CNI
    ansible.builtin.shell: |
      set -o pipefail; kubectl get nodes --selector=cluster={{ rke2_cluster_group_name }} --no-headers | grep -c "Ready"
    register: node_ready_count
    vars:
      total_nodes: groups[rke2_cluster_group_name] | length
    until: node_ready_count.stdout | int == total_nodes
    retries: 30
    delay: 10
    changed_when: false
    failed_when: false
    when: rke2_cni == 'none'
  - name: Wait for remaining nodes to be ready - with CNI
    ansible.builtin.shell: |
      set -o pipefail; kubectl get nodes --selector=cluster={{ rke2_cluster_group_name }} --no-headers | grep -c "Ready"
    register: node_ready_count
    vars:
      total_nodes: groups[rke2_cluster_group_name] | length
    until: node_ready_count.stdout | int == total_nodes
    retries: 30
    delay: 10
    changed_when: false
    failed_when: false
    when: rke2_cni != 'none'


