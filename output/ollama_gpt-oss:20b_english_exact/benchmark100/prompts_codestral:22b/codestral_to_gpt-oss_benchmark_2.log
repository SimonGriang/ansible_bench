---
- name: Restart RKE2 service on a specified node
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  delegate_to: "{{ rke2_node_name }}"
  notify: "Service (re)started"

- name: Wait for all nodes to be ready
  ansible.builtin.shell: "{{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes | grep \" Ready\" | wc -l"
  register: node_ready_count
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  run_once: true
  check_mode: false
  until: node_ready_count.stdout | int == (groups[rke2_cluster_group_name] | length)
  retries: 30
  delay: 10

- name: Wait for all pods to be ready
  ansible.builtin.shell: "{{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded --ignore-not-found | wc -l"
  register: pod_ready_count
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  run_once: true
  check_mode: false
  when: rke2_wait_for_all_pods_to_be_ready | bool
  until: pod_ready_count.stdout | int == 0
  retries: 30
  delay: 10


