---
- name: Enable Backports repository
  when: ansible_facts['distribution_version'] | version_compare('9', '<')
  apt_repository:
    repo: "deb http://deb.debian.org/debian {{ ansible_facts['distribution_release'] }}-backports main"
    state: present
    filename: backports

- name: Set the default_release option
  when: ansible_facts['distribution_version'] | version_compare('9', '<')
  set_fact:
    default_release: "{{ ansible_facts['distribution_release'] }}-backports"

- name: Install Ansible
  apt:
    name: ansible
    state: "{{ ansible_package_state }}"
    default_release: "{{ default_release | default(omit) }}"



