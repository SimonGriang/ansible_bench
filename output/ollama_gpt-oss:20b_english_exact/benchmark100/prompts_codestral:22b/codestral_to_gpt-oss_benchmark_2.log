- name: Flush Handlers
  ansible.builtin.meta: flush_handlers
- name: Rolling Restart Config Change
  ansible.builtin.include_tasks: change_config.yml
  when: |
    restart_needed
- name: Final Steps
  ansible.builtin.debug:
    msg: "Final steps in cluster setup"


