---
- name: Install Keepalived
  ansible.builtin.include_tasks: keepalived.yml
  when: |
    ha_mode_enabled and
    inventory_hostname in groups['rke2_servers'] and
    ha_mode == 'keepalived'

- name: Install RKE2
  ansible.builtin.shell: |
    set -o pipefail; curl -sfL https://get.rke2.io | sh -s - --version {{ rke2_version }}
  args:
    creates: /usr/local/bin/rke2
    pipefail: true

- name: Apply CIS Hardening
  ansible.builtin.include_tasks: cis.yml
  when: |
    cis_profile is defined

- name: Identify Active Server
  ansible.builtin.include_tasks: find_active_server.yml

- name: Enable IPVS Kernel Module
  community.general.modprobe:
    name: ip_vs
    state: present
  when: |
    ipvs_enabled and
    inventory_hostname in groups['rke2_servers'] and
    ha_mode == 'kubevip' and
    ha_mode != 'keepalived'

- name: Copy Kube-vip Manifests
  ansible.builtin.copy:
    src: kube-vip.yaml
    dest: /etc/rancher/kube-vip.yaml
    mode: '0644'
  when: |
    inventory_hostname == groups['rke2_servers'][0] and
    ha_mode == 'kubevip' and
    ha_mode != 'keepalived'

- name: Copy Ingress-nginx Manifests
  ansible.builtin.copy:
    src: ingress-nginx.yaml
    dest: /etc/rancher/ingress-nginx.yaml
    mode: '0644'
  when: |
    inventory_hostname == groups['rke2_servers'][0] and
    ingress_nginx is defined

- name: Prepare First Server Node
  ansible.builtin.debug:
    msg: "Preparing first server node"
  when: |
    inventory_hostname == groups['rke2_servers'][0] and
    (active_server is not defined or groups['rke2_servers']|length == 1)

- name: Restore etcd
  ansible.builtin.include_tasks: first_server_restore.yml
  when: |
    active_server is defined and
    (inventory_hostname == active_server or
     inventory_hostname == groups['rke2_servers'][0]) and
    etcd_restore_needed

- name: Download kubeconfig
  ansible.builtin.get_url:
    url: https://{{ inventory_hostname }}:6443/pki/admin.kubeconfig
    dest: /tmp/kubeconfig
  delegate_to: localhost
  when: |
    kubeconfig_download_enabled and
    inventory_hostname == groups['rke2_servers'][0]

- name: Prepare and Join Remaining Nodes
  ansible.builtin.debug:
    msg: "Preparing and joining remaining nodes"
  when: |
    active_server is defined and
    groups['rke2_servers']|length >= 2

- name: Rolling Restart Servers
  ansible.builtin.include_tasks: rolling_restart.yml
  when: |
    installed_version != running_version and
    inventory_hostname in groups['rke2_servers']

- name: Rolling Restart Agents
  ansible.builtin.include_tasks: rolling_restart.yml
  when: |
    installed_version != running_version and
    inventory_hostname not in groups['rke2_servers']

- name: Flush Handlers
  ansible.builtin.meta: flush_handlers

- name: Rolling Restart Config Change
  ansible.builtin.include_tasks: change_config.yml
  when: |
    restart_needed

- name: Final Steps
  ansible.builtin.debug:
    msg: "Final steps in cluster setup"



