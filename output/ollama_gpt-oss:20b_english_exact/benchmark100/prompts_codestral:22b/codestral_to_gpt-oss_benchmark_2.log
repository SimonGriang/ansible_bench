---
- name: Cordon and Drain the node
  ansible.builtin.command: |
    kubectl cordon {{ inventory_hostname }} &&
    kubectl drain {{ inventory_hostname }} \
      --ignore-daemonsets \
      --delete-local-data
  when: rke2_drain_node_during_upgrade
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  changed_when: false

- name: Restart RKE2 service
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted

- name: Wait for all nodes to be ready again
  ansible.builtin.command: |
    kubectl get nodes --no-headers \
    | grep -c 'Ready'
  register: node_ready_count
  until: >-
    (node_ready_count.stdout | int) == (groups[rke2_servers_group_name] | length)
  retries: 30
  delay: 10
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  changed_when: false

- name: Uncordon the node
  ansible.builtin.command: |
    kubectl uncordon {{ inventory_hostname }}
  when: rke2_drain_node_during_upgrade
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  changed_when: false

- name: Wait for all pods to be ready again
  ansible.builtin.command: |
    kubectl get pods --all-namespaces \
    --field-selector status.phase!=Running,status.phase!=Succeeded \
    --no-headers |
    wc -l
  register: pod_not_ready
  until: pod_not_ready.stdout | int == 0
  retries: 30
  delay: 10
  when: rke2_wait_for_all_pods_to_be_ready
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  changed_when: false

- name: Wait for all pods to pass readiness checks
  ansible.builtin.command: |
    kubectl wait --for=condition=ready pod --all \
    {{ rke2_wait_for_all_pods_to_be_healthy_args }}
  when: rke2_wait_for_all_pods_to_be_healthy
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  changed_when: false


