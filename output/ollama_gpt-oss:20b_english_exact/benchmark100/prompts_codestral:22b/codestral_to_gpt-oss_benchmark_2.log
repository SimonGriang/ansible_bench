---
- name: Install Keepalived
  include_tasks: keepalived.yml
  when: ha_mode_enabled and inventory_hostname in groups['rke2_servers'] and ha_mode == 'keepalived'

- name: Install RKE2
  shell: curl -sfL https://get.rke2.io | sh -s - --version {{ rke2_version }}
  args:
    creates: /usr/local/bin/rke2

- name: Apply CIS Hardening
  include_tasks: cis.yml
  when: cis_profile is defined

- name: Identify Active Server
  include_tasks: find_active_server.yml

- name: Enable IPVS Kernel Module
  modprobe:
    name: ip_vs
    state: present
  when: ipvs_enabled and inventory_hostname in groups['rke2_servers'] and ha_mode == 'kubevip' and ha_mode != 'keepalived'

- name: Copy Kube-vip Manifests
  copy:
    src: kube-vip.yaml
    dest: /etc/rancher/kube-vip.yaml
    mode: '0644'
  when: inventory_hostname == groups['rke2_servers'][0] and ha_mode == 'kubevip' and ha_mode != 'keepalived'

- name: Copy Ingress-nginx Manifests
  copy:
    src: ingress-nginx.yaml
    dest: /etc/rancher/ingress-nginx.yaml
    mode: '0644'
  when: inventory_hostname == groups['rke2_servers'][0] and ingress_nginx is defined

- name: Prepare First Server Node
  debug:
    msg: "Preparing first server node"
  when: inventory_hostname == groups['rke2_servers'][0] and (active_server is not defined or groups['rke2_servers']|length == 1)

- name: Restore etcd
  include_tasks: first_server_restore.yml
  when: active_server is defined and (inventory_hostname == active_server or inventory_hostname == groups['rke2_servers'][0]) and etcd_restore_needed

- name: Download kubeconfig
  get_url:
    url: https://{{ inventory_hostname }}:6443/pki/admin.kubeconfig
    dest: /tmp/kubeconfig
  delegate_to: localhost
  when: kubeconfig_download_enabled and inventory_hostname == groups['rke2_servers'][0]

- name: Prepare and Join Remaining Nodes
  debug:
    msg: "Preparing and joining remaining nodes"
  when: active_server is defined and groups['rke2_servers']|length >= 2

- name: Rolling Restart Servers
  include_tasks: rolling_restart.yml
  when: installed_version != running_version and inventory_hostname in groups['rke2_servers']

- name: Rolling Restart Agents
  include_tasks: rolling_restart.yml
  when: installed_version != running_version and inventory_hostname not in groups['rke2_servers']

- name: Flush Handlers
  meta: flush_handlers

- name: Rolling Restart Config Change
  include_tasks: change_config.yml
  when: restart_needed

- name: Final Steps
  debug:
    msg: "Final steps in cluster setup"


