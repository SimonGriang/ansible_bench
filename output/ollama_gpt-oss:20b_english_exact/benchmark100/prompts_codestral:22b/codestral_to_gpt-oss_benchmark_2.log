p', 'total_duration': 30361454940, 'load_duration': 184911340, 'prompt_eval_count': 2258, 'prompt_eval_duration': 1806391815, 'eval_count': 2599, 'eval_duration': 28368675088, 'model_name': 'gpt-oss:20b'} id='run--aec47023-014d-4ddc-9f48-23aa4a95ed3f-0' usage_metadata={'input_tokens': 2258, 'output_tokens': 2599, 'total_tokens': 4857}
