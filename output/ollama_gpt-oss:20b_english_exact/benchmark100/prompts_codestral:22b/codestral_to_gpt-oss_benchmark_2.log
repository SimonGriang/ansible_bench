---
- name: Install epel
  ansible.builtin.dnf:
    name: epel-release
    state: present
  when: |
    (ansible_distribution == "Amazon" and
     ansible_distribution_version == "2") or
    (ansible_distribution in ["RedHat", "CentOS"] and
     ansible_distribution_major_version in ["7","8","9","10"])

- name: Install epel gpg key
  ansible.builtin.rpm_key:
    state: present
    key: "{{ epel_gpg_key }}"

- name: Install epel-release
  ansible.builtin.dnf:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Install epel-next-release
  ansible.builtin.dnf:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next | bool
  notify: Update package cache


