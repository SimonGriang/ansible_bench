  notify: restart keepalived

- name: Create keepalived configuration file
  become: true
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: '0644'
  notify: restart keepalived

- name: Enable and unmask keepalived service
  become: true
  systemd:
    name: keepalived
    enabled: true
    masked: false
  notify: restart keepalived

- name: Flush handlers
  become: true
  meta: flush_handlers

handlers:
  - name: restart keepalived
    service:
      name: keepalived
      state: restarted


