      systemd:
        name: rke2-server
        state: restarted
        daemon_reload: true
        environment:
          RKE2_TOKEN: "{{ rke2_token }}"
      notify: Service (re)started

    - name: "Task 11: Restore RKE2 agent service"
      systemd:
        name: rke2-agent
        state: restarted
        daemon_reload: true
        environment:
          RKE2_TOKEN: "{{ rke2_token }}"
      notify: Service (re)started

    - name: "Task 12: Wait for RKE2 agent to join the cluster"
      wait_for:
        host: "{{ rke2_master_ip }}"
        port: 9345
        timeout: 120
      when: rke2_master_ip is defined and rke2_master_ip != ''

    - name: "Task 13: Wait for RKE2 agent to be ready"
      wait_for:
        host: "{{ rke2_master_ip }}"
        port: 9345
        timeout: 120
      when: rke2_master_ip is defined and rke2_master_ip != ''

    - name: "Task 14: Remove old nodes"
      block:
        - name: Get registered nodes
          shell: kubectl get nodes -o json
          register: registered_nodes
          changed_when: false
        - name: Remove old node-password secrets
          shell: |
            nodes=$(echo "{{ registered_nodes.stdout }}" | jq -r .items[].metadata.name)
            for node in $nodes; do
              kubectl delete secret node-password-$(echo $node) -n kube-system --ignore-not-found;
            done
          changed_when: false
        - name: Remove old nodes
          shell: |
            nodes=$(echo "{{ registered_nodes.stdout }}" | jq -r .items[].metadata.name)
            for node in $nodes; do
              kubectl delete node $(echo $node) --ignore-not-found;
            done
          changed_when: false
        - name: Set Active Server variable
          set_fact:
            active_server: |
              {{ registered_nodes.stdout | from_json | json_query('items[0].metadata.name') }}
      when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

  handlers:
    - name: Config file changed
      command: systemctl daemon-reload

    - name: Service (re)started
      command: systemctl restart rke2-agent



