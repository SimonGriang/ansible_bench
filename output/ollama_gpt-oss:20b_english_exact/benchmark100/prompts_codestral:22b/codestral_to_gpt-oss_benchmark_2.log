---
tasks:
  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install mysql
    package:
      name: "{{ mysql_packages }}"
      state: present
    notify:
      - Set root password
      - Systemctl daemon-reexec

  - name: Configure mysql server
    template:
      content: "{{ mysql_configuration_options | to_nice_yaml }}"
      dest: "{{ mysql_configuration_destination }}/mysql-server.cnf"
    notify: Restart mysql server

  - name: Configure mysql client
    template:
      content: "socket={{ mysql_socket }}\n"
      dest: "{{ mysql_configuration_destination }}/mysql-client.cnf"

  - name: Initialize mysql
    command: "{{ mysql_initialize_command }}"
    when: ansible_facts['distribution'] in ['Alpine', 'Archlinux']

  - name: Start and enable mysql
    service:
      name: "{{ mysql_service }}"
      state: started
      enabled: true

  - name: Flush handlers
    meta: flush_handlers

  - name: Place my.cnf
    template:
      src: my.cnf.j2
      dest: /my.cnf
      mode: '0640'

  - name: Create databases
    mysql_db:
      name: "{{ item }}"
      state: present
      login_user: root
      login_password: "{{ mysql_root_password }}"
      login_socket: "{{ mysql_socket }}"
    loop: "{{ mysql_databases }}"
    when: mysql_databases is defined

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.priv }}"
      state: present
      login_user: root
      login_password: "{{ mysql_root_password }}"
      login_socket: "{{ mysql_socket }}"
    loop: "{{ mysql_users }}"
    when: mysql_users is defined

  - name: Flush handlers again
    meta: flush_handlers

handlers:
  - name: Set root password
    # handler implementation goes here

  - name: Systemctl daemon-reexec
    # handler implementation goes here

  - name: Restart mysql server
    # handler implementation goes here


