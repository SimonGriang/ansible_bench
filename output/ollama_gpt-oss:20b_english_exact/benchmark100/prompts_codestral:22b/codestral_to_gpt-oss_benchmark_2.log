---
- name: RKE2 configuration
  hosts: rke2_servers
  become: true
  tasks:
    - name: Task 1: Create the RKE2 config directory
      file:
        path: /etc/rancher/rke2
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Task 2: Set server taints
      set_fact:
        combined_node_taints: "{{ rke2_server_node_taints }}"
      when: rke2_type == 'server'

    - name: Task 3: Copy rke2 config
      copy:
        src: "{{ rke2_config }}"
        dest: /etc/rancher/rke2/config.yaml
        owner: root
        group: root
        mode: '0600'
      notify: Config file changed

    - name: Task 4: Copy kubelet config
      template:
        src: templates/kubelet-config.yaml.j2
        dest: /etc/rancher/rke2/kubelet-config.yaml
        owner: root
        group: root
        mode: '0600'
      when: rke2_kubelet_config is defined and rke2_kubelet_config != ''
      notify: Config file changed

    - name: Task 5: Copy Containerd Registry Configuration file
      copy:
        src: "{{ rke2_custom_registry_path }}"
        dest: /etc/rancher/rke2/registries.yaml
        owner: root
        group: root
        mode: '0600'
      when: rke2_custom_registry_mirrors is defined or rke2_custom_registry_configs is defined
      notify: Config file changed

    - name: Gather service facts
      service_facts:

    - name: Task 6: Register if we need to do a etcd restore from file
      set_fact:
        do_etcd_restore: true
      when: >
        rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != ''
        and (ansible_facts.services['rke2-server.service'] is not defined
             or ansible_facts.services['rke2-server.service'].state not in ['running', 'enabled'])

    - name: Task 7: Register if we need to do a etcd restore from s3
      set_fact:
        do_etcd_restore_from_s3: true
      when: >
        rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != ''
        and rke2_etcd_snapshot_s3_options is defined
        and rke2_etcd_snapshot_s3_options.access_key is defined
        and rke2_etcd_snapshot_s3_options.secret_key is defined
        and rke2_etcd_snapshot_s3_options.bucket is defined
        and rke2_etcd_snapshot_s3_options.snapshot_name is defined

    - name: Task 8: Restore etcd from file
      block:
        - name: Create etcd snapshot directory
          file:
            path: /var/lib/rancher/rke2/server/db
            state: directory
            owner: root
            group: root
            mode: '0700'
        - name: Copy etcd snapshot file
          copy:
            src: "{{ rke2_etcd_snapshot_file }}"
            dest: /var/lib/rancher/rke2/server/db/etcd-snapshot.db
            owner: root
            group: root
            mode: '0600'
        - name: Restore etcd from snapshot
          command: >
            rke2 server
            --restore
            --etcd-snapshot /var/lib/rancher/rke2/server/db/etcd-snapshot.db
          register: etcd_restore_output
          changed_when: etcd_restore_output.rc == 0 and etcd_restore_output.stdout != ""
      when: do_etcd_restore is defined

    - name: Task 9: Restore etcd from s3
      block:
        - name: Restore etcd from s3 snapshot
          command: >
            rke2 server
            --restore
            --etcd-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }}
            --etcd-s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }}
            --etcd-s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }}
            --etcd-s3-region {{ rke2_etcd_snapshot_s3_options.region | default('us-east-1') }}
            --etcd-s3-snapshot-name {{ rke2_etcd_snapshot_s3_options.snapshot_name }}
          register: etcd_restore_s3_output
          changed_when: etcd_restore_s3_output.rc == 0 and etcd_restore_s3_output.stdout != ""
      when: do_etcd_restore_from_s3 is defined

    - name: Task 10: Start RKE2 service on the first server
      systemd:
        name: rke2-server.service
        state: started
        enabled: true
        environment:
          RKE2_TOKEN: "{{ rke2_token }}"
      notify: Service (re)started

    - name: Task 11: Mask RKE2 agent service on the first server
      systemd:
        name: rke2-agent.service
        state: stopped
        enabled: false
        masked: true

    - name: Task 12: Wait for the first server to be ready - no CNI
      shell: |
        kubectl get node $(hostname) -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
      register: node_ready_no_cni
      until: node_ready_no_cni.stdout == "True"
      retries: 30
      delay: 10
      when: rke2_cni == 'none'

    - name: Task 13: Wait for the first server to be ready - with CNI
      shell: |
        kubectl get node $(hostname) -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
      register: node_ready_with_cni
      until: node_ready_with_cni.stdout == "True"
      retries: 30
      delay: 10
      when: rke2_cni != 'none'

    - name: Task 14: Restore etcd
      block:
        - name: Get registered nodes
          shell: kubectl get nodes -o json
          register: registered_nodes
          changed_when: false
        - name: Remove old node-password secrets
          shell: |
            for node in $(echo "{{ registered_nodes.stdout | from_json | json_query('items[*].metadata.name') }}" | tr ',' ' '); do
              kubectl delete secret node-password-{{ node }} -n kube-system --ignore-not-found;
            done
          changed_when: false
        - name: Remove old nodes
          shell: |
            for node in $(echo "{{ registered_nodes.stdout | from_json | json_query('items[*].metadata.name') }}" | tr ',' ' '); do
              kubectl delete node {{ node }} --ignore-not-found;
            done
          changed_when: false
        - name: Set Active Server variable
          set_fact:
            active_server: "{{ registered_nodes.stdout | from_json | json_query('items[0].metadata.name') }}"
      when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

  handlers:
    - name: Config file changed
      service:
        name: rke2-server.service
        state: restarted
    - name: Service (re)started
      service:
        name: rke2-server.service
        state: restarted


