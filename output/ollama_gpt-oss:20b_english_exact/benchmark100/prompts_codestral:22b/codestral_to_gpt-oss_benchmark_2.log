---
- name: Download RKE2 installation script
  ansible.builtin.get_url:
    url: |
      {{ rke2_install_script_url }}
    dest: |
      {{ rke2_install_script_dest }}
  when: not rke2_airgap_mode

- name: Copy local RKE2 installation script
  ansible.builtin.copy:
    src: |
      {{ rke2_install_script_local_src }}
    dest: |
      {{ rke2_install_script_dest }}
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'copy'

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: |
      {{ rke2_artifacts_path }}
    state: directory
    mode: "{{ rke2_artifacts_mode }}"
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download checksum file
      ansible.builtin.get_url:
        url: |
          {{ rke2_checksum_url }}
        dest: |
          {{ rke2_checksum_dest }}
    - name: Download artifacts
      ansible.builtin.get_url:
        url: |
          {{ rke2_artifacts_url }}
        dest: |
          {{ rke2_artifacts_dest }}
    - name: Verify checksum
      ansible.builtin.command: |
        {{ rke2_checksum_verify_cmd }}
      vars:
        rke2_checksum_verify_cmd: |
          sha256sum -c {{ rke2_checksum_dest }}
      register: checksum_verify
      ignore_errors: true
    - name: Download install script if checksum fails
      ansible.builtin.get_url:
        url: |
          {{ rke2_install_script_url }}
        dest: |
          {{ rke2_install_script_dest }}
      when: checksum_verify.rc != 0
  rescue:
    - name: Copy local checksum file
      ansible.builtin.copy:
        src: |
          {{ rke2_checksum_local_src }}
        dest: |
          {{ rke2_checksum_dest }}
    - name: Copy local artifacts
      ansible.builtin.copy:
        src: |
          {{ rke2_artifacts_local_src }}
        dest: |
          {{ rke2_artifacts_dest }}
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'download'

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: |
      {{ rke2_artifacts_local_src }}
    dest: |
      {{ rke2_artifacts_dest }}
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'copy'

- name: Copy additional images tarballs
  block:
    - name: Create directory for additional images
      ansible.builtin.file:
        path: |
          {{ additional_tarballs_dest }}
        state: directory
        mode: "{{ additional_tarballs_mode }}"
    - name: Copy additional tarballs
      ansible.builtin.copy:
        src: |
          {{ additional_tarballs_src }}
        dest: |
          {{ additional_tarballs_dest }}
  when:
    - rke2_airgap_mode
    - additional_tarballs_to_copy | length > 0
    - rke2_airgap_implementation != 'exists'

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Stat artifacts
      ansible.builtin.stat:
        path: |
          {{ rke2_artifacts_path }}
      register: artifacts_stat
    - name: Remove write permissions from artifacts
      ansible.builtin.file:
        path: |
          {{ rke2_artifacts_path }}
        mode: "0444"
      when: artifacts_stat.stat.mode is match('^.*[2-7].*$')
    - name: Stat install script
      ansible.builtin.stat:
        path: |
          {{ rke2_install_script_dest }}
      register: script_stat
    - name: Make install script executable
      ansible.builtin.file:
        path: |
          {{ rke2_install_script_dest }}
        mode: "0755"
      when: not script_stat.stat.exists or not script_stat.stat.mode is match('^.*[7-9].*$')
    - name: Fail if install script does not exist
      ansible.builtin.fail:
        msg: |
          Install script not found at {{ rke2_install_script_dest }}
      when: not script_stat.stat.exists
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'exists'

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: "{{ rke2_bin_path | default('/usr/bin/rke2') }}"

- name: Check RKE2 version
  block:
    - name: Get installed version
      ansible.builtin.command: |
        {{ rke2_bin_path }} --version
      register: installed_version_cmd
      ignore_errors: true
    - name: Set installed version fact
      ansible.builtin.set_fact:
        installed_version: |
          {{ installed_version_cmd.stdout_lines[0] | regex_replace('^.*\\s(\\S+).*$', '\\1') }}
      when: installed_version_cmd.rc == 0
    - name: Set installed version to not installed
      ansible.builtin.set_fact:
        installed_version: "not installed"
      when: installed_version_cmd.rc != 0
    - name: Get running service version
      ansible.builtin.command: |
        {{ rke2_running_service_cmd }}
      vars:
        rke2_running_service_cmd: |
          systemctl show -p ExecStart --value rke2-server | cut -d' ' -f1 | xargs -I{} {} --version
      register: running_version_cmd
      ignore_errors: true
    - name: Set running version fact
      ansible.builtin.set_fact:
        running_version: |
          {{ running_version_cmd.stdout_lines[0] | regex_replace('^.*\\s(\\S+).*$', '\\1') }}
      when: running_version_cmd.rc == 0
    - name: Set running version to desired if service binary missing
      ansible.builtin.set_fact:
        running_version: "{{ desired_rke2_version }}"
      when: running_version_cmd.rc != 0
  when: true

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.fail:
    msg: |
      Desired version {{ desired_rke2_version }} is lower than running version {{ running_version }} and downgrades are not allowed.
  when: desired_rke2_version < running_version and not allow_downgrades

- name: Run RKE2 install script
  ansible.builtin.shell: |
    {{ rke2_install_script_dest }} {{ install_script_args | default('') }}
  args:
    executable: /bin/bash
  when:
    - installed_version == 'not installed'
    - or desired_rke2_version != installed_version
  register: install_script_result

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: |
      {{ custom_manifests_src }}
    dest: |
      {{ custom_manifests_dest }}
  when: custom_manifests_to_copy | length > 0

- name: Copy Static Pods
  ansible.builtin.copy:
    src: |
      {{ static_pods_src }}
    dest: |
      {{ static_pods_dest }}
  when: static_pods_to_copy | length > 0

- name: Copy RKE2 environment file
  ansible.builtin.copy:
    src: |
      {{ rke2_env_src }}
    dest: |
      {{ rke2_env_dest }}
  when: environment_options | length > 0


