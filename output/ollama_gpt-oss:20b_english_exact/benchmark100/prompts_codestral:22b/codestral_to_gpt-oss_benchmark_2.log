---
- hosts: all
  become: yes
  tasks:
    - name: Update package cache
      apt:
        update_cache: yes
      when: ansible_pkg_mgr == 'apt'
    - name: Update package cache
      dnf:
        update_cache: yes
      when: ansible_pkg_mgr == 'dnf'
    - name: Install keepalived package
      package:
        name: keepalived
        state: present
    - name: Create keepalived directory
      file:
        path: /etc/keepalived
        state: directory
        owner: root
        group: root
        mode: '0755'
    - name: Create Kubernetes API health check script for Debian OS family
      template:
        src: k8s_api_check.sh.j2
        dest: /etc/keepalived/k8s_api_check.sh
        owner: root
        group: root
        mode: '0755'
      when: ansible_os_family == 'Debian'
      notify: restart keepalived
    - name: Create Kubernetes API health check script for RedHat OS family
      template:
        src: k8s_api_check.sh.j2
        dest: /usr/libexec/keepalived/k8s_api_check.sh
        owner: root
        group: root
        mode: '0755'
      when: ansible_os_family == 'RedHat'
      notify: restart keepalived
    - name: Create RKE2 Server health check script for Debian OS family
      template:
        src: rke2_server_check.sh.j2
        dest: /etc/keepalived/rke2_server_check.sh
        owner: root
        group: root
        mode: '0755'
      when: ansible_os_family == 'Debian'
      notify: restart keepalived
    - name: Create RKE2 Server health check script for RedHat OS family
      template:
        src: rke2_server_check.sh.j2
        dest: /usr/libexec/keepalived/rke2_server_check.sh
        owner: root
        group: root
        mode: '0755'
      when: ansible_os_family == 'RedHat'
      notify: restart keepalived
    - name: Create keepalived configuration file
      template:
        src: keepalived.conf.j2
        dest: /etc/keepalived/keepalived.conf
        owner: root
        group: root
        mode: '0644'
      notify: restart keepalived
    - name: Enable and unmask keepalived service
      systemd:
        name: keepalived
        enabled: yes
        masked: no
      notify: restart keepalived
    - name: Flush handlers
      meta: flush_handlers
  handlers:
    - name: restart keepalived
      service:
        name: keepalived
        state: restarted


