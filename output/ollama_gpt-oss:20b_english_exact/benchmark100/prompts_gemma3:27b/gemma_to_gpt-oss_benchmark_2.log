    dest: "{{ vault_download_path }}"
    remote_src: yes
    creates: "{{ vault_download_path }}/vault"
- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path
- name: Create vault_path if it does not exists
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
  when: not vault_check_path.stat.exists and vault_path
- name: Create directory in vault_path
  file:
    path: "{{ vault_path }}/{{ item.path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_directories }}"
- name: Create data directory
  file:
    path: "{{ vault_path }}/{{ item.path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_data_directories }}"
- name: Generate TLS key and certificate
  shell: "openssl req -new -x509 -nodes -days 365 -newkey rsa:2048 -keyout tls.key -out tls.crt -subj '/CN=localhost'"
  args:
    chdir: "{{ vault_path }}/etc/vault.d/{{ vault_data_directory }}/tls"
  creates: "{{ vault_path }}/etc/vault.d/{{ vault_data_directory }}/tls/tls.key"
  notify: Restart vault
- name: Set ownership of tls material
  file:
    path: "{{ vault_path }}/etc/vault.d/{{ vault_data_directory }}/tls/{{ item.path }}"
    state: file
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_tls_files }}"
- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: /usr/bin/vault
    owner: root
    group: root
    mode: '0755'
  notify: Restart vault
- name: Set cap_ipc_lock=ep on /usr/bin/vault
  command: setcap cap_ipc_lock=ep /usr/bin/vault
  args:
    creates: /usr/bin/vault
  changed_when: false
- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'
    preserve: yes
  notify: Restart vault
- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: '0755'
- name: Copy Vault service file
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'
  notify: Daemon reload
  when: ansible_service_mgr == 'systemd'
- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: '0644'
  notify: Restart vault
- name: Flush handlers
  meta: flush_handlers

handlers:
- name: Restart vault
  service:
    name: vault
    state: restarted
- name: Daemon reload
  command: systemctl daemon-reload


