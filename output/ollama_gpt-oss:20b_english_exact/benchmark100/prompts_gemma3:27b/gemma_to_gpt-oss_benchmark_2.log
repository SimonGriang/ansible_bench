---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    group: "{{ vault_group }}"
    shell: "{{ vault_user_shell }}"
    system: true
    createhome: false

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Download Vault binary
  unarchive:
    src: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: true
  vars:
    vault_base_url: "https://releases.hashicorp.com/vault/{{ vault_version }}"
    vault_download_url: >-
      "{{ vault_base_url }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exists
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
  when:
    - not vault_check_path.stat.exists
    - vault_path | length > 0

- name: Create directory in vault_path
  file:
    path: "{{ vault_path }}/{{ item.name }}"
    state: directory
    mode: "{{ item.mode }}"
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ vault_path }}/{{ item.name }}"
    state: directory
    mode: "{{ item.mode }}"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command: >
    openssl req -new -x509 -days 365 -nodes
    -out tls.crt -keyout tls.key
    -subj "/CN=localhost"
  args:
    chdir: "{{ vault_data_directory }}/tls"
    creates: "{{ vault_data_directory }}/tls/tls.key"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ vault_data_directory }}/tls/{{ item.name }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: /usr/bin/vault
    owner: root
    group: root
    mode: '0755'
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  command: setcap cap_ipc_lock=ep /usr/bin/vault

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'
    preserve: true
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy Vault service file
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'
  notify: Daemon reload
  when: ansible_service_mgr == 'systemd'

- name: Copy vault configuration
  template:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: '0644'
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


