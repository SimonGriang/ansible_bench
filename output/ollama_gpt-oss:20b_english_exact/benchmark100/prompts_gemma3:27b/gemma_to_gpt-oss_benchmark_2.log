---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  template:
    src: rke2-config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when:
    - rke2_custom_registry_mirrors | length > 0
    - rke2_custom_registry_configs | length > 0

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: >-
      "{{ rke2_etcd_snapshot_file is defined and
         (lookup('pipe', 'systemctl is-enabled rke2-server.service || echo disabled') not in ['enabled', 'active']) }}"

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: >-
      "{{ rke2_etcd_snapshot_file is defined and
         rke2_etcd_snapshot_s3_options is defined and
         rke2_etcd_snapshot_s3_options.access_key is defined and
         rke2_etcd_snapshot_s3_options.secret_key is defined and
         rke2_etcd_snapshot_s3_options.bucket is defined and
         rke2_etcd_snapshot_s3_options.endpoint is defined }}"

- name: Restore etcd from file
  block:
    - name: Create etcd destination directory
      file:
        path: /var/lib/rancher/rke2/server/db
        state: directory
        mode: '0755'
        owner: root
        group: root

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/snapshot.db
        owner: root
        group: root
        mode: '0644'

    - name: Run rke2 server with etcd snapshot
      shell: |
        rke2 server --server --cluster-init \
          --etcd-snapshot-file=/var/lib/rancher/rke2/server/db/snapshot.db
      args:
        creates: /var/lib/rancher/rke2/server/db/etcd
  when: do_etcd_restore

- name: Restore etcd from s3
  block:
    - name: Run rke2 server with etcd snapshot from s3
      shell: |
        rke2 server --server --cluster-init \
          --etcd-snapshot-file=s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_file }} \
          --etcd-snapshot-s3-endpoint={{ rke2_etcd_snapshot_s3_options.endpoint }} \
          --etcd-snapshot-s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }} \
          --etcd-snapshot-s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }}
      args:
        creates: /var/lib/rancher/rke2/server/db/etcd
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token | default('') }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    state: masked
    enabled: no

- name: Wait for the first server be ready - no CNI
  shell: |
    kubectl get nodes --no-headers \
      -o custom-columns=STATUS:.status.conditions[?(@.type=='Ready')].status \
      | grep -q 'True'
  register: wait_no_cni
  until: wait_no_cni.rc == 0
  retries: 30
  delay: 10

- name: Wait for the first server be ready - with CNI
  shell: |
    kubectl get nodes --no-headers \
      -o custom-columns=STATUS:.status.conditions[?(@.type=='Ready')].status \
      | grep -q 'True'
  register: wait_with_cni
  until: wait_with_cni.rc == 0
  retries: 30
  delay: 10

- name: Restore etcd
  block:
    - name: Get registered nodes
      shell: |
        kubectl get nodes \
          -o jsonpath='{.items[*].metadata.name}'
      register: registered_nodes

    - name: Set node names fact
      set_fact:
        node_names: "{{ registered_nodes.stdout.split() }}"

    - name: Delete old secrets
      shell: |
        kubectl delete secret {{ item }} -n kube-system
      loop: "{{ node_names }}"
      ignore_errors: true

    - name: Delete old nodes
      shell: |
        kubectl delete node {{ item }}
      loop: "{{ node_names }}"
      ignore_errors: true
  when: do_etcd_restore or do_etcd_restore_from_s3

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"



