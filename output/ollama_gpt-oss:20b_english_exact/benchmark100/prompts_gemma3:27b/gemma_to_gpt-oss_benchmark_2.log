---
- name: Install Keepalived when HA mode is enabled
  include_tasks: keepalived.yml
  when:
    - ha_mode_enabled
    - inventory_hostname in groups[rke2_servers_group_name]
    - rke2_api_ip is defined

- name: Download and install RKE2
  include_tasks: rke2.yml

- name: CIS Hardening
  include_tasks: cis.yml
  when:
    - rke2_cis_profile | length > 0

- name: Find Active Server
  include_tasks: find_active_server.yml

- name: Enable IPVS kernel module
  block:
    - name: Load ip_vs kernel module
      modprobe:
        name: ip_vs
        state: present
    - name: Persist ip_vs module load
      lineinfile:
        path: /etc/modules-load.d/ipvs.conf
        line: ip_vs
        create: yes
  when:
    - rke2_kubevip_ipvs_lb_enable
    - inventory_hostname in groups[rke2_servers_group_name]
    - ha_mode_enabled
    - not keepalived_enabled

- name: Copy kube-vip manifests to the masternode
  include_tasks: kubevip.yml
  when:
    - ha_mode_enabled
    - rke2_kubevip_enabled
    - not keepalived_enabled
    - inventory_hostname == (groups[rke2_servers_group_name] | first)

- name: Copy ingress-nginx manifests to the masternode
  include_tasks: ingress-nginx.yml
  when:
    - rke2_ingress_nginx_values | length > 0
    - inventory_hostname == (groups[rke2_servers_group_name] | first)

- name: Prepare very first server node in the cluster
  include_tasks: first_server.yml
  when:
    - inventory_hostname == (groups[rke2_servers_group_name] | first)
    - (active_server is not defined) or (rke2_cluster_group_name | length == 1)

- name: Restore etcd specific tasks
  include_tasks: first_server_restore.yml
  when:
    - active_server is defined
    - (inventory_hostname == active_server) or (inventory_hostname == (groups[rke2_servers_group_name] | first))
    - (do_etcd_restore is defined) or (do_etcd_restore_from_s3 is defined)

- name: Download kubeconfig to ansible localhost
  include_tasks: download_kubeconfig.yaml
  when:
    - rke2_download_kubeconf
    - inventory_hostname == (groups[rke2_servers_group_name] | first)

- name: Prepare and join remaining nodes of the cluster
  include_tasks: remaining_nodes.yml
  when:
    - active_server is defined
    - rke2_cluster_group_name | length >= 2

- name: Rolling cordon and drain restart when version changes - servers
  shell: |
    kubectl cordon {{ inventory_hostname }}
    kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data
    systemctl restart rke2-server
  when:
    - installed_version is defined
    - installed_version != rke2_version
    - inventory_hostname in groups[rke2_servers_group_name]

- name: Rolling cordon and drain restart when version changes - agents
  shell: |
    kubectl cordon {{ inventory_hostname }}
    kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data
    systemctl restart rke2-agent
  when:
    - installed_version is defined
    - installed_version != rke2_version
    - inventory_hostname not in groups[rke2_servers_group_name]

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  shell: systemctl restart rke2-server
  when:
    - rke2_restart_needed
    - inventory_hostname in groups[rke2_cluster_group_name]

- name: Final steps
  include_tasks: summary.yml


