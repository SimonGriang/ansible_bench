---
- name: Check if etcd snapshot exists
  stat:
    path: "{{ '/opt/etcd/snapshots/etcd-snapshot-' + ansible_date_time.iso8601_basic_short + '.db' }}"
  register: etcd_snapshot_file

- name: Determine if etcd snapshot restore is needed
  set_fact:
    do_etcd_restore: >-
      {{ etcd_snapshot_file is defined and
         (lookup('pipe', 'systemctl is-enabled rke2-server.service || echo disabled')
          not in ['enabled', 'active']) | bool }}

- name: Determine if etcd snapshot restore from S3 is needed
  set_fact:
    do_etcd_restore_from_s3: >-
      {{ etcd_snapshot_file is defined and
         (lookup('pipe', 'systemctl is-enabled rke2-server.service || echo disabled')
          not in ['enabled', 'active']) | bool }}

- name: Stop RKE2 service
  systemd:
    name: rke2-server
    state: stopped
  when: do_etcd_restore | default(false)

- name: Create backup directory
  file:
    path: /opt/etcd/snapshots/backup
    state: directory
    mode: '0755'
  when: do_etcd_restore | default(false)

- name: Backup current etcd data
  command: >-
    /opt/rke2/bin/etcdctl snapshot save
    /opt/etcd/snapshots/backup/etcd-snapshot-{{ ansible_date_time.iso8601_basic_short }}.db
  when: do_etcd_restore | default(false)

- name: Copy snapshot file to S3 bucket
  aws_s3:
    bucket: rke2-etcd-backups
    object: "etcd-snapshot-{{ ansible_date_time.iso8601_basic_short }}.db"
    src: "{{ '/opt/etcd/snapshots/backup/etcd-snapshot-' + ansible_date_time.iso8601_basic_short + '.db' }}"
    mode: put
  when: do_etcd_restore | default(false)

- name: Download snapshot file from S3 bucket
  aws_s3:
    bucket: rke2-etcd-backups
    object: "etcd-snapshot-{{ ansible_date_time.iso8601_basic_short }}.db"
    dest: "{{ '/opt/etcd/snapshots/backup/etcd-snapshot-' + ansible_date_time.iso8601_basic_short + '.db' }}"
    mode: get
  when: do_etcd_restore_from_s3 | default(false)

- name: Restore etcd snapshot
  command: >-
    /opt/rke2/bin/etcdctl snapshot restore
    /opt/etcd/snapshots/backup/etcd-snapshot-{{ ansible_date_time.iso8601_basic_short }}.db
    --data-dir /var/lib/rancher/rke2/server/db
  when: do_etcd_restore | default(false)

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
  when: do_etcd_restore | default(false)

- name: Verify RKE2 service is running
  command: systemctl status rke2-server
  register: etcd_status
  when: do_etcd_restore | default(false)

- name: Check etcd health
  command: /opt/rke2/bin/etcdctl endpoint health
  register: etcd_health
  when: do_etcd_restore | default(false)

- name: Check etcd health
  command: /opt/rke2/bin/etcdctl endpoint health
  register: etcd_health
  when: do_etcd_restore_from_s3 | default(false)

- name: Verify RKE2 service is running
  command: systemctl status rke2-server
  register: etcd_status
  when: do_etcd_restore_from_s3 | default(false)

