---
- name: Check if the Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: helm version
  register: helm_existing_version
  failed_when: false
  changed_when: false

- name: Download helm
  unarchive:
    src: "{{ helm_repo_path }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: "/tmp"
    remote_src: yes
  register: helm_download
  when: not helm_check.stat.exists or helm_existing_version.stdout is not search(helm_version)

- name: Copy helm binary into place
  copy:
    src: "/tmp/{{ helm_platform }}-{{ helm_arch }}/helm"
    dest: "{{ helm_bin_path }}"
    mode: "0755"
    remote_src: true
  become: true
  when: helm_download.changed


