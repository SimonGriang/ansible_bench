---
- name: Install packages
  apt:
    name:
      - curl
      - gnupg
    state: present
    update_cache: yes

- name: Add Docker GPG key
  apt_key:
    url: https://download.docker.com/linux/ubuntu/gpg
    state: present

- name: Add Docker repository
  apt_repository:
    repo: deb https://download.docker.com/linux/ubuntu bionic stable
    state: present

- name: Install Docker CE
  apt:
    name: docker-ce
    state: present
    update_cache: yes

- name: Install Docker Compose
  get_url:
    url: >-
      https://github.com/docker/compose/releases/download/1.29.2/docker-compose-
      `uname -s`-`uname -m`
    dest: /usr/local/bin/docker-compose
    mode: "0755"

- name: Start and enable Docker service
  systemd:
    name: docker
    state: started
    enabled: true

- name: Create Docker network
  command: docker network create app_network
  args:
    creates: /var/run/docker/networks/app_network

- name: Deploy services
  docker_compose:
    project_src: /opt/docker-compose
    restarted: yes

- name: Configure environment
  template:
    src: env.j2
    dest: /opt/docker-compose/.env
  notify: Restart services

- name: Install necessary packages
  apt:
    name:
      - git
      - python3
    state: present
    update_cache: yes

- name: Clone repository
  git:
    repo: https://github.com/example/project.git
    dest: /opt/project
    version: master

- name: Install dependencies
  pip:
    requirements: /opt/project/requirements.txt
    state: latest

- name: Start services
  command: docker-compose up -d
  args:
    chdir: /opt/project

- name: Verify services
  command: docker ps
  register: docker_ps
  changed_when: false

- name: Check service status
  debug:
    msg: "All services are running"
  when: docker_ps.stdout | search("web")

- name: Configure firewall
  ufw:
    rule: allow
    port: 80
    proto: tcp
  notify: Reload firewall

- name: Set environment variables
  set_fact:
    env_vars:
      - key: APP_ENV
        value: production
      - key: DB_HOST
        value: db.example.com
      - key: DB_PORT
        value: "5432"

- name: Deploy application
  shell: |
    export APP_ENV=production
    export DB_HOST=db.example.com
    export DB_PORT=5432
    docker run -d -p 80:80 myapp:latest
  args:
    executable: /bin/bash

- name: Check application status
  uri:
    url: http://localhost
    status_code: 200
  register: app_status

- name: Save status
  copy:
    content: "{{ app_status.content }}"
    dest: /tmp/app_status.txt
  when: app_status.status == 200

- name: Clean up
  file:
    path: /tmp/app_status.txt
    state: absent
  when: app_status.status == 200



