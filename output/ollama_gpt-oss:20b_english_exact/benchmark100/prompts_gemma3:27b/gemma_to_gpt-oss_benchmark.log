        aws_secret_key: "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
    - name: Restore the etcd database
      command: rke2 etcd --data-dir /etc/rancher/rke2/etcd-restore/restore
      args:
        chdir: /etc/rancher/rke2
      environment:
        RKE2_DEBUG: 'true'
  when: do_etcd_restore_from_s3 | bool

