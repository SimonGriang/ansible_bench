---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0755'
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  ansible.builtin.user:
    name: "{{ dns_owner }}"
    state: present
    system: true
    groups: "{{ dns_group }}"
    create_home: false

- name: Generate rndc key
  ansible.builtin.command: "rndc-confgen -a -c {{ dns_confdir }}/rndc.key"
  args:
    creates: "{{ dns_confdir }}/rndc.key"

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0600'

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/root.hints"
    mode: '0644'
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.zone"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
    validate: >
      named-checkzone {{ item.name }} {{ dns_datadir }}/{{ item.name }}.zone
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: "{{ dns_named_conf }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
    backup: true
    validate: "named-checkconf {{ dns_named_conf }}"
  notify: Restart dns

- name: Place systemd override
  when: ansible_service_mgr == 'systemd'
  block:
    - name: Create systemd override directory
      ansible.builtin.file:
        path: "{{ dns_service_systemd_override_dir }}"
        state: directory
        mode: '0755'
    - name: Copy systemd override file
      ansible.builtin.copy:
        src: systemd_override.conf
        dest: "{{ dns_service_systemd_override_dir }}/override.conf"
        mode: '0644'
    - name: Reload systemd daemon
      ansible.builtin.systemd:
        daemon_reload: true

- name: Start and enable dns
  ansible.builtin.service:
    name: "{{ dns_service }}"
    state: started
    enabled: true

- name: Rndc reload
  ansible.builtin.command: rndc reload
  changed_when: false

- name: Restart dns
  ansible.builtin.service:
    name: "{{ dns_service }}"
    state: restarted
    enabled: true
    daemon_reload: true


