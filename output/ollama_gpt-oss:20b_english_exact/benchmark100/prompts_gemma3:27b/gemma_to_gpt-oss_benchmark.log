---
- name: Download RKE2 kubeconfig to localhost
  fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: "{{ kubeconf_path }}"
    flat: true
  vars:
    kubeconf_path: >-
      {{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}
  when:
    - rke2_download_kubeconf | bool
    - inventory_hostname == groups[rke2_servers_group_name][0]
- name: Replace loopback IP by master server IP
  replace:
    path: "{{ kubeconf_path }}"
    regexp: "(127\\.0\\.0\\.1|\\[::1\\])"
    replace: "{{ master_ip }}"
  delegate_to: localhost
  become: false
  check_mode: false
  vars:
    kubeconf_path: >-
      {{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}
    first_server: "{{ groups[rke2_servers_group_name][0] }}"
    master_ip: >-
      {{ rke2_api_ip | default(hostvars[first_server].ansible_host) }}
  when:
    - rke2_download_kubeconf | bool
    - inventory_hostname == groups[rke2_servers_group_name][0]


