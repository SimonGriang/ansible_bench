---
- name: Download RKE2 kubeconfig to localhost
  fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    flat: yes
  when: rke2_download_kubeconf and inventory_hostname == (groups[rke2_servers_group_name] | first)

- name: Replace loopback IP by master server IP
  replace:
    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    regexp: "127\\.0\\.0\\.1|\\[::1\\]"
    replace: "{{ rke2_api_ip | default(hostvars[groups[rke2_servers_group_name] | first].ansible_host) }}"
  delegate_to: localhost
  become: false
  when: rke2_download_kubeconf and inventory_hostname == (groups[rke2_servers_group_name] | first) and not ansible_check_mode


