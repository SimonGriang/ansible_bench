---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    create_home: no
    system: yes
    state: present

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory

- name: Download Vault binary
  unarchive:
    src: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_{{ vault_architecture }}.zip"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    creates: "{{ vault_download_path }}/vault"

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exists
  file:
    path: "{{ vault_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  when:
    - not vault_check_path.stat.exists
    - vault_path != ''

- name: Create directory in vault_path
  file:
    path: "{{ vault_path }}/{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ vault_path }}/{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command: >
    openssl req -x509 -nodes -days 365 -newkey rsa:2048
    -keyout tls.key -out tls.crt -subj /CN=vault
  args:
    chdir: "{{ vault_data_directory }}/tls"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ vault_data_directory }}/tls/{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
    state: file
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: /usr/bin/vault
    owner: root
    group: root
    mode: '0755'
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  ansible.posix.setcap:
    path: /usr/bin/vault
    capabilities:
      - cap_ipc_lock=ep
    state: present

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy Vault service file
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'
  notify: Daemon reload
  when: ansible_service_mgr == 'systemd'

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: '0644'
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


