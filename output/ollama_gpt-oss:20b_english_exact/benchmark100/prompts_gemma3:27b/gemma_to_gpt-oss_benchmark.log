---
- name: Migrate from adoptopenjdk to temurin if selected
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_distribution | lower }}{{ ansible_distribution_major_version }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: architecture.yml

- name: Set OS specific variables (I)
  set_fact:
    java_open_jdk_version: "{{ java_open_jdk_version | default('11') }}"
    java_required_repositories_openjdk: "{{ java_required_repositories_openjdk | default([]) }}"
    java_required_key_repositories_openjdk: "{{ java_required_key_repositories_openjdk | default([]) }}"
    java_required_libs_openjdk: "{{ java_required_libs_openjdk | default([]) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-{{ java_open_jdk_version }}-jdk') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home_dir }}"

- name: Remove deprecated repositories (Debian)
  apt_repository:
    repo: "{{ item }}"
    state: absent
  loop: "{{ java_deprecated_repositories_adoptopenjdk | default([]) }}"
  when: ansible_facts['os_family'] == 'Debian'

- name: Install extra apt tools (Debian)
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_apt_extra_packages | default([]) }}"
  when: ansible_facts['os_family'] == 'Debian'

- name: Add required key repositories (Debian)
  apt_key:
    url: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
  when: ansible_facts['os_family'] == 'Debian'

- name: Add required repositories (Debian)
  apt_repository:
    repo: "{{ item }}"
    state: present
  loop: "{{ java_required_repositories_openjdk | default([]) }}"
  when: ansible_facts['os_family'] == 'Debian'

- name: Add required key repositories (RedHat)
  yum_key:
    key: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
  when: ansible_facts['os_family'] == 'RedHat'

- name: Add required repositories (RedHat)
  yum_repository:
    name: "{{ item.name }}"
    description: "{{ item.description | default(omit) }}"
    baseurl: "{{ item.baseurl | default(omit) }}"
    gpgcheck: "{{ item.gpgcheck | default(omit) }}"
    enabled: "{{ item.enabled | default(omit) }}"
    repo_gpgcheck: "{{ item.repo_gpgcheck | default(omit) }}"
    gpgkey: "{{ item.gpgkey | default(omit) }}"
  loop: "{{ java_required_repositories_openjdk | default([]) }}"
  when: ansible_facts['os_family'] == 'RedHat'

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libs_openjdk | default([]) }}"

- name: Install Java (Debian)
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
    version: "{{ java_open_jdk_version }}"
  when: ansible_facts['os_family'] == 'Debian'

- name: Install Java (RedHat)
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present
    version: "{{ java_open_jdk_version }}"
  when: ansible_facts['os_family'] == 'RedHat'

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0644'

- name: Source environment variables
  shell: source /etc/profile
  changed_when: false

- name: Correct java version selected (Debian, Java < 11)
  shell: alternatives --set java {{ java_home }}/bin/java
  when:
    - ansible_facts['os_family'] == 'Debian'
    - java_open_jdk_version is defined
    - (java_open_jdk_version | int) < 11

- name: Correct java version selected (Debian, Java >= 11)
  shell: alternatives --set java {{ java_home }}/bin/java
  when:
    - ansible_facts['os_family'] == 'Debian'
    - java_open_jdk_version is defined
    - (java_open_jdk_version | int) >= 11



