- name: Generate public SSH key for user
  hosts: all
  tasks:
    # 1. Produce the public key on stdout
    - name: Generate public SSH key (stdout)
      ansible.builtin.command:
        cmd: ssh-keygen -y -f "{{ user.ssh_key_directory }}/{{ user.name }}"
      register: pubkey_output
      changed_when: False
      args:
        creates: "{{ user.ssh_key_directory }}/{{ user.name }}.pub"
      when:
        - user is defined
        - user.ssh_key_directory is defined
        - user.name is defined

    # 2. Persist the key to a file, but only if it didn't already exist
    - name: Write public SSH key to file
      ansible.builtin.copy:
        dest: "{{ user.ssh_key_directory }}/{{ user.name }}.pub"
        content: "{{ pubkey_output.stdout }}"
        force: no
        mode: "0644"
      when: pubkey_output is defined



