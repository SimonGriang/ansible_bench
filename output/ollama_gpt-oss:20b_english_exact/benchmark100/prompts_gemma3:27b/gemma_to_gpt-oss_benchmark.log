---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Configure apk
  apk:
    name: '*'
    state: latest
    update_cache: yes
  notify: Reboot
  when: ansible_pkg_mgr == 'apk'

- name: Configure apt
  apt:
    name: '*'
    state: latest
    update_cache: yes
    upgrade: dist
    autoremove: "{{ apt_autoremove | default(false) }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'apt'

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    update_cache: yes
    exclude: "{{ update_excluded_packages | join(',') }}"
  notify: Reboot
  when: ansible_pkg_mgr in ['dnf', 'dnf5']

- name: Update all software (pacman)
  pacman:
    name: '*'
    state: latest
    update_cache: yes
    ignore: "{{ update_excluded_packages | join(',') }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'pacman'

- name: Configure yum
  yum:
    name: '*'
    state: latest
    update_cache: yes
    exclude: "{{ update_excluded_packages | join(',') }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'yum'

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest
    update_cache: yes
    exclude: "{{ update_excluded_packages | join(',') }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'zypper'


