---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  template:
    src: rke2_config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify: restart rke2

- name: Copy kubelet config
  template:
    src: kubelet_config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: restart kubelet

- name: Copy Containerd Registry Configuration file
  template:
    src: containerd_registry.yaml.j2
    dest: /etc/rancher/rke2/containerd_registry.yaml
    mode: '0644'
  when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)
  notify: reload containerd

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2-server
    enabled: yes
    state: started
    daemon_reload: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  register: rke2_service
  retries: 5
  delay: 10
  until: rke2_service.status == 'active'
  notify: restart rke2

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ 'rke2-agent' if rke2_type == 'server' else 'rke2-server' }}"
    enabled: no
    masked: yes

- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    kubectl get nodes -o json | \
    jq '.items[] | select(.status.conditions[] | select(.type=="Ready" and .status=="True")) | .metadata.name' | \
    grep -q '^$'
  register: wait_nodes
  retries: 30
  delay: 15
  until: wait_nodes.rc == 0
  when:
    - cni == 'none'
    - rke2_type == 'server'
    - inventory_hostname == groups['rke2_servers'][0]

- name: Wait for remaining nodes to be ready - with CNI
  shell: |
    kubectl get nodes | grep -c 'Ready' | grep -q '^{{ groups['rke2_nodes'] | length }}$'
  register: wait_nodes_cni
  retries: 30
  delay: 15
  until: wait_nodes_cni.rc == 0
  when:
    - cni != 'none'
    - rke2_type == 'server'
    - inventory_hostname == groups['rke2_servers'][0]


