---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: No configuration
    vtype: string
  when: ansible_os_family == "Debian"

- name: Install postfix
  ansible.builtin.package:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present
  when: postfix_use_mysql | default(false)

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate postfix configuration
    - rebuild postfix database
  when: transport_maps_template is defined

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate postfix configuration
    - reload postfix
  when: header_checks_template is defined

- name: Setting values for main.cf (1/2)
  ansible.builtin.set_fact:
    main_cf_param1: "{{ postfix_param1 | default('default1') }}"
    main_cf_param2: "{{ postfix_param2 | default('default2') }}"

- name: Setting values for main.cf (2/2)
  ansible.builtin.set_fact:
    main_cf_list: "{{ postfix_list | default([]) }}"
    main_cf_string: "{{ postfix_string | default('') }}"

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate postfix configuration
    - restart postfix

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate postfix configuration
    - restart postfix

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ postfix_ssl_dir | default('/etc/ssl/postfix') }}"
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_ssl_cert_src }}"
    dest: "{{ postfix_ssl_dir | default('/etc/ssl/postfix') }}/cert.pem"
    owner: root
    group: root
    mode: '0644'

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_ssl_key_src }}"
    dest: "{{ postfix_ssl_dir | default('/etc/ssl/postfix') }}/key.pem"
    owner: root
    group: root
    mode: '0600'

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure aliases
  ansible.builtin.template:
    src: aliases.j2
    dest: /etc/postfix/aliases
    owner: root
    group: root
    mode: '0644'
  when: postfix_aliases is defined

- name: Configure sender_access
  ansible.builtin.template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    owner: root
    group: root
    mode: '0644'
  when: postfix_sender_access is defined

- name: Configure recipient_access
  ansible.builtin.template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    owner: root
    group: root
    mode: '0644'
  when: postfix_recipient_access is defined

- name: Place sasl_password_map
  ansible.builtin.copy:
    content: "{{ postfix_sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password_map
    owner: root
    group: root
    mode: '0600'
  when: postfix_sasl_password_map_content is defined

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Start and enable postfix
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: true


