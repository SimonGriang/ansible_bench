---
- name: Restart the RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready
  shell: |
    ready=$(kubectl get nodes --kubeconfig /etc/rancher/rke2/rke2.yaml --no-headers | grep -c 'Ready');
    total={{ groups[rke2_cluster_group_name]|length }};
    [ $ready -eq $total ]
  retries: 100
  delay: 15
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  run_once: true

- name: Wait for all pods to be ready
  shell: |
    not_ready=$(kubectl get pods --all-namespaces --kubeconfig /etc/rancher/rke2/rke2.yaml --no-headers | grep -v 'Running\|Succeeded' | wc -l);
    [ $not_ready -eq 0 ]
  retries: 100
  delay: 15
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  run_once: true
  when:
    - rke2_wait_for_all_pods_to_be_ready | bool
    - not ansible_check_mode


