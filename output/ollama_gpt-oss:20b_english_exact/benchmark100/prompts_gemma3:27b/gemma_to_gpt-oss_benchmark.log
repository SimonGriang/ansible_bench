---
- name: Create ssh_key_directory for user
  delegate_to: localhost
  file:
    path: "{{ user.ssh_key_directory }}"
    state: directory
    mode: '0700'
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Manage user account
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment | default(omit) }}"
    create_home: "{{ user.create_home | default(true) }}"
    password: "{{ user.password | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    expires: "{{ user.expires | default(omit) }}"
  register: user_result

- name: Set sudo options for user
  template:
    src: sudoers.j2
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: '0440'
    validate: "visudo -cf %s"
  loop: "{{ users }}"
  loop_control:
    loop_var: user
    label: "{{ user.name }}"
  when: user.sudo_options is defined

- name: Remove sudo options for user
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  loop: "{{ users }}"
  loop_control:
    loop_var: user
    label: "{{ user.name }}"
  when: user.sudo_options is not defined

- name: Generate private ssh key for user
  delegate_to: localhost
  command: ssh-keygen -t rsa -b 4096 -f "{{ user.ssh_key_directory }}/{{ user.name }}.priv" -N ""
  args:
    creates: "{{ user.ssh_key_directory }}/{{ user.name }}.priv"
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Generate public ssh key for user
  delegate_to: localhost
  command: ssh-keygen -y -f "{{ user.ssh_key_directory }}/{{ user.name }}.priv" > "{{ user.ssh_key_directory }}/{{ user.name }}.pub"
  args:
    creates: "{{ user.ssh_key_directory }}/{{ user.name }}.pub"
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Convert ssh key to ppk for user
  delegate_to: localhost
  command: puttygen "{{ user.ssh_key_directory }}/{{ user.name }}.priv" -O private -o "{{ user.ssh_key_directory }}/{{ user.name }}.ppk"
  args:
    creates: "{{ user.ssh_key_directory }}/{{ user.name }}.ppk"
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Get or set the home directory for user
  getent:
    database: passwd
    key: "{{ user.name }}"
  register: getent_passwd

- name: Set fact for user's home directory
  set_fact:
    user_home: "{{ getent_passwd.entries[user.name][4] | default('/home') }}"
  when: getent_passwd is succeeded

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  when: (user.manage_ssh_key is defined and user.manage_ssh_key) or (user.private_keys is defined)

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ item }}"
  loop: "{{ user.authorized_keys | default([]) }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ user.unauthorized_keys | default([]) }}"

- name: Copy generated private ssh key for user
  copy:
    src: "{{ user.ssh_key_directory }}/{{ user.name }}.priv"
    dest: "{{ user_home }}/.ssh/{{ user.name }}.priv"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  when: user.copy_private_key is defined

- name: Check users password valid time
  shell: "awk -F: '/^{{ user.name }}:/ {print $6}' /etc/shadow"
  register: pwd_valid_time
  changed_when: false

- name: Set users password valid time
  user:
    name: "{{ user.name }}"
    expires: "{{ user.password_expire | default(omit) }}"
  when: user.password_expire is defined

- name: Place private key file for user
  copy:
    content: "{{ item.value }}"
    dest: "{{ user_home }}/.ssh/{{ item.key }}"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  loop: "{{ user.private_keys | dict2items }}"
  when: user.private_keys is defined


