---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost
- name: Wait for port to be available
  wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
    state: started
  when:
    - ansible_connection is defined
    - ansible_connection not in ['docker', 'podman', 'lxd']
    - bootstrap_wait_for_host | bool
- name: Prepare system
  block:
    - name: Test connection
      ping:
    - name: Ensure sudo access
      command: whoami
      become: true
  rescue:
    - name: Gather facts
      setup:
    - name: Install bootstrap packages via raw
      raw: "yum install -y {{ bootstrap_facts_packages | join(' ') }}"
      become: true
    - name: Ensure libdnf5 is present on RedHat systems
      yum:
        name: libdnf5
        state: present
      when: ansible_os_family == 'RedHat'
      become: true
- name: Gather ansible facts
  setup:
- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
    become: "{{ bootstrap_become }}"


