- name: gather bootstrap facts using raw command
  ansible.builtin.raw: "cat /etc/os-release"
  register: bootstrap_facts
  become: false
  gather_facts: no

- name: set bootstrap facts (I) based on OS release information
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout_lines | join(' ') | regex_search('([0-9]+)', '\\1') }}"
  loop: "{{ bootstrap_os_family_map | dict2items | map(attribute='value') | list | flatten }}"
