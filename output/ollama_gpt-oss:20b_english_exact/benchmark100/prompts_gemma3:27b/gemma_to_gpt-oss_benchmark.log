---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when:
    - ansible_selinux is defined
    - ansible_selinux.status is defined
    - ansible_connection not in ['container', 'docker']
  notify: Reboot

- name: Manage selinux booleans
  seboolean:
    name: "{{ item.name }}"
    state: "{{ item.value | default('yes') }}"
    persistent: "{{ item.persistent | default(omit) }}"
  loop: "{{ selinux_booleans }}"
  loop_control:
    label: "{{ item.name }}"
  when: selinux_booleans is defined


