  copy:  
    src: "{{ rke2_custom_manifests_path }}/{{ item }}"  
    dest: "{{ rke2_data_dir }}/{{ item }}"  
    mode: "0644"  
  loop: "{{ rke2_custom_manifests | default([]) }}"  

- name: Copy Static Pods  
  copy:  
