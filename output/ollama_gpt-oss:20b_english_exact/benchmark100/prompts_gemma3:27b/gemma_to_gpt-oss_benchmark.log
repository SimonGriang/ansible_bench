- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: >-
      "{{ bootstrap_facts.stdout | regex_search(bootstrap_search, '\\1') }}"
    bootstrap_distribution_major_version: >-
      "{{ bootstrap_facts.stdout | regex_search(bootstrap_search, '\\2') }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    loop_var: item
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout | regex_search(bootstrap_search)

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"
  when: bootstrap_distribution in item.value


