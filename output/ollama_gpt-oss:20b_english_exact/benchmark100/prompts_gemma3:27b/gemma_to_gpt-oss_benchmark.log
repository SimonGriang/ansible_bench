---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install requirements
  package:
    name: "{{ sysctl_requirements }}"
    state: present

- name: Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    sysctl_set: "{{ sysctl_set | default(true) }}"
    reload: "{{ sysctl_reload | default(true) }}"
    state: present
  loop: "{{ sysctl_items }}"
  loop_control:
    label: "{{ item.name }}"
  when:
    - sysctl_items is defined
    - item.name is defined
    - item.value is defined
    - not ansible_container


