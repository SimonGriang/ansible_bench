  run_once: true
  delegate_to: localhost

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    state: present
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    state: present
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    state: present
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service | length > 0

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
    state: present
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined



