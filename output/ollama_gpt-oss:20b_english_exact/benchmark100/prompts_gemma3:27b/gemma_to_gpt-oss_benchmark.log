---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'container'
    - bootstrap_wait_for_host | bool

- name: Prepare system
  become: false
  block:
    - name: Test connection
      become: false
      command: /bin/true
      changed_when: false
    - name: Verify sudo access
      become: false
      command: sudo -n true
      changed_when: false
  rescue:
    - name: Gather bootstrap facts
      become: false
      setup:
    - name: Install bootstrap packages (package)
      become: "{{ bootstrap_become | default(false) }}"
      package:
        name: "{{ bootstrap_facts_packages | split(',') }}"
        state: present

- name: Gather ansible facts
  become: false
  setup:

- name: Install bootstrap packages (package)
  become: "{{ bootstrap_become | default(false) }}"
  package:
    name: "{{ bootstrap_facts_packages | split(',') }}"
    state: present


