--- 
- name: Create the RKE2 config directory.
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'
    owner: root
    group: root
- name: Set server taints.
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints | default([]) }}"
  when: rke2_type == 'server'
- name: Copy rke2 config.
  template:
    src: rke2_config.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
- name: Copy kubelet config.
  template:
    src: kubelet_config.j2
    dest: /etc/rancher/rke2/kubelet.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0
- name: Copy Containerd Registry Configuration file.
  template:
    src: containerd_registry_config.j2
    dest: /etc/rancher/rke2/containerd_registry_config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)
- name: Register if we need to do a etcd restore from file.
  set_fact:
    do_etcd_restore: true
  when:
    - rke2_etcd_snapshot_file is defined
    - not ansible_facts.services.get('rke2-server.service')
- name: Register if we need to do a etcd restore from s3.
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file is defined
    - rke2_etcd_snapshot_s3_options is defined
    - rke2_etcd_snapshot_s3_options.access_key is defined
    - rke2_etcd_snapshot_s3_options.secret_key is defined
    - rke2_etcd_snapshot_s3_options.bucket is defined
- name: Restore etcd from file.
  block:
    - name: Create etcd snapshot directory
      file:
        path: "{{ rke2_etcd_snapshot_dir | default('/var/lib/rancher/rke2/server/db') }}"
        state: directory
        mode: '0700'
        owner: root
        group: root
    - name: Copy etcd snapshot
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: "{{ rke2_etcd_snapshot_dir | default('/var/lib/rancher/rke2/server/db') }}/snapshot.db"
        mode: '0600'
        owner: root
        group: root
    - name: Run rke2 server with restore
      command: >
        rke2 server --restore-snapshot
        {{ rke2_etcd_snapshot_dir | default('/var/lib/rancher/rke2/server/db') }}/snapshot.db
      become: true
  when: do_etcd_restore | default(false)
- name: Restore etcd from s3.
  block:
    - name: Run rke2 server with s3 restore
      command: >
        rke2 server
        --restore-snapshot-s3
        --s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }}
        --s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }}
        --s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }}
        --s3-region={{ rke2_etcd_snapshot_s3_options.region | default('us-east-1') }}
      become: true
  when: do_etcd_restore_from_s3 | default(false)
- name: Start RKE2 service on the first server.
  service:
    name: rke2-server.service
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started
  when: inventory_hostname == groups[rke2_cluster_group_name][0]
- name: Mask RKE2 agent service on the first server.
  service:
    name: rke2-agent.service
    state: masked
    enabled: false
  when: inventory_hostname == groups[rke2_cluster_group_name][0]
- name: Wait for the first server be ready - no CNI.
  shell: |
    kubectl get nodes -o json | grep -q 'Ready'
  register: kubectl_ready
  retries: 30
  delay: 10
  until: kubectl_ready.rc == 0
  when: inventory_hostname == groups[rke2_cluster_group_name][0] and not rke2_cni_plugin
- name: Wait for the first server be ready - with CNI.
  shell: |
    kubectl get nodes -o json | grep -q 'Ready'
  register: kubectl_ready_cni
  retries: 30
  delay: 10
  until: kubectl_ready_cni.rc == 0
  when: inventory_hostname == groups[rke2_cluster_group_name][0] and rke2_cni_plugin
- name: Restore etcd.
  shell: echo "Restoring etcd"
  when: do_etcd_restore | default(false) or do_etcd_restore_from_s3 | default(false)
- name: Set an Active Server variable.
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"



