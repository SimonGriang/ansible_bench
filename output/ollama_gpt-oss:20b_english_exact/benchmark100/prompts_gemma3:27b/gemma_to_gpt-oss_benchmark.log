---
- name: Check if all variables have been set correctly
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for host to be reachable
  wait_for:
    host: >-
      {{ ansible_ssh_host | default(ansible_host | default(inventory_hostname)) }}
    port: >-
      {{ bootstrap_port | default(22) }}
    timeout: "{{ bootstrap_timeout }}"
  when:
    - (ansible_connection not in ['container', 'docker'])
    - bootstrap_wait_for_host
  delegate_to: localhost
  become: true

- block:
    - name: Test connection using wait_for_connection
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: bootstrap_connect

    - name: Debug bootstrap_timeout variable
      debug:
        var: bootstrap_timeout
      when: not bootstrap_connect.success

    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml
  tags: prepare_system

- name: Install bootstrap packages
  raw: "{{ bootstrap_command }}"
  register: bootstrap_install_packages
  become: true
  become_user: "{{ bootstrap_user }}"
  changed_when: |-
    (ansible_facts['distribution'] in ['Alpine', 'Archlinux', 'Gentoo'] and
     bootstrap_install_packages.stdout is search('regex')) or
    (ansible_facts['distribution'] not in ['Debian', 'RedHat', 'Rocky', 'Suse'] and
     bootstrap_install_packages.stdout is not search('regex'))

- block:
    - name: Gather ansible facts
      setup:

    - name: Install bootstrap facts packages
      package:
        name: "{{ bootstrap__facts_packages }}"
        state: present
        update_cache: true
  tags: ensure_prepared


