  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Convert ssh key to ppk for user
  delegate_to: localhost
  command: |-
    puttygen "{{ user.ssh_key_directory }}/{{ user.name }}.priv" -O private -o \
