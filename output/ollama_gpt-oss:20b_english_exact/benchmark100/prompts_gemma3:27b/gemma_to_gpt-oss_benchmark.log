    path: /etc/apt/trusted.gpg.d/docker.asc
    state: absent

- name: Remove old Docker source list file
  ansible.builtin.file:
    path: "/etc/apt/sources.list.d/{{ docker_apt_ansible_distribution }}"
    state: absent

- name: Remove obsolete Docker packages
  ansible.builtin.apt:
    name: "{{ docker_obsolete_packages }}"
    state: absent
    purge: yes

- name: Remove legacy Docker repository file
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install Docker dependencies
  ansible.builtin.apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Manage Docker repository
  ansible.builtin.deb822_repository:
    filename: "{{ docker_apt_filename }}"
    state: "{{ docker_add_repo | ternary('present', 'absent') }}"
    repo: >-
      deb {{ docker_repo_url }} {{ ansible_facts.distribution }}
      {{ ansible_facts.distribution_release }} {{ docker_apt_release_channel }}
    key: "{{ docker_apt_gpg_key }}"
  notify: apt update

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


