---
- name: Check OS compatibility
  ansible.builtin.assert:
    that:
      - >-
        (ansible_facts['distribution'] == 'Amazon' and
         ansible_facts['distribution_version'] == '2') or
        (ansible_facts['distribution'] in
         ['RedHat', 'CentOS', 'Rocky', 'AlmaLinux'] and
         ansible_facts['distribution_major_version'] in
         ['7', '8', '9'])
- name: Install epel gpg key
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present
- name: Install epel-release package
  ansible.builtin.dnf:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache
- name: Install epel-next-release package
  ansible.builtin.dnf:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next | bool
  notify: Update package cache


