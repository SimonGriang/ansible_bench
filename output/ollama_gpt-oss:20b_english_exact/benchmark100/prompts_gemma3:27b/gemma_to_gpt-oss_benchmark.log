---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ini_file:
    path: "/etc/my.cnf.d/{{ mysql_name }}-server.cnf"
    section: mysqld
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    state: present
  loop: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  ini_file:
    path: "/etc/my.cnf.d/{{ mysql_name }}-client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    state: present

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'
    owner: root
    group: root

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    target: "{{ item.target | default(omit) }}"
    encoding: "{{ item.encoding | default(omit) }}"
    collation: "{{ item.collation | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: List databases
  mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  register: mysql_info_result

- name: List databases
  debug:
    var: mysql_info_result

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.target }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"
  when:
    - item.target is defined
    - item.name not in mysql_info_result.databases | map(attribute='name') | list

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    host: "{{ item.host | default('localhost') }}"
    priv: "{{ item.priv | default('*.*:ALL') }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


