---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Configure apk
  community.general.apk:
    name: '*'
    state: latest  # noqa: package-latest
    update_cache: true
  notify: Reboot
  when: ansible_pkg_mgr == 'apk'

- name: Configure apt
  ansible.builtin.apt:
    name: '*'
    state: latest  # noqa: package-latest
    update_cache: true
    upgrade: dist
    autoremove: "{{ apt_autoremove | default(false) }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'apt'

- name: Update all software (dnf)
  community.general.dnf:
    name: '*'
    state: latest  # noqa: package-latest
    update_cache: true
    exclude: "{{ update_excluded_packages | join(',') }}"
  notify: Reboot
  when: ansible_pkg_mgr in ['dnf', 'dnf5']

- name: Update all software (pacman)
  community.general.pacman:
    name: '*'
    state: latest  # noqa: package-latest
    update_cache: true
    ignore: "{{ update_excluded_packages | join(',') }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'pacman'

- name: Configure yum
  community.general.yum:
    name: '*'
    state: latest  # noqa: package-latest
    update_cache: true
    exclude: "{{ update_excluded_packages | join(',') }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'yum'

- name: Update all software (zypper)
  community.general.zypper:
    name: '*'
    state: latest  # noqa: package-latest
    update_cache: true
    exclude: "{{ update_excluded_packages | join(',') }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'zypper'


