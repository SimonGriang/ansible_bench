---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  template:
    src: rke2_config.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify: restart rke2

- name: Copy kubelet config
  template:
    src: rke2_kubelet_config.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  template:
    src: containerd_registry_config.j2
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0644'
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
  notify: restart rke2

- name: Start RKE2 service on the rest of the nodes
  service:
    name: "{{ 'rke2-server' if rke2_type == 'server' else 'rke2-agent' }}"
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token | default('') }}"
  register: rke2_service_result
  retries: 5
  delay: 10
  until: rke2_service_result is succeeded
  notify: restart rke2

- name: Mask other RKE2 service on the rest of the nodes
  service:
    name: "{{ 'rke2-agent' if rke2_type == 'server' else 'rke2-server' }}"
    state: masked
    enabled: false
  when: rke2_type in ['server', 'agent']

- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    kubectl get nodes --no-headers | grep -v 'NotReady' | wc -l
  register: ready_nodes_no_cni
  retries: 30
  delay: 10
  until: ready_nodes_no_cni.stdout|int >= rke2_expected_nodes | default(1)
  when:
    - rke2_cni == 'none'
    - rke2_active_server or rke2_first_server

- name: Wait for remaining nodes to be ready - with CNI
  shell: |
    kubectl get nodes --no-headers | grep 'Ready' | wc -l
  register: ready_nodes_with_cni
  retries: 30
  delay: 10
  until: ready_nodes_with_cni.stdout|int >= rke2_expected_nodes | default(1)
  when:
    - rke2_cni != 'none'
    - rke2_active_server or rke2_first_server



