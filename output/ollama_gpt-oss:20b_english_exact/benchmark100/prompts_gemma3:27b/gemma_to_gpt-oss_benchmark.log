---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0755'
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true
    groups: "{{ dns_group }}"
    create_home: false

- name: Generate rndc key
  command: "rndc-confgen -a -c {{ dns_confdir }}/rndc.key"
  args:
    creates: "{{ dns_confdir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0600'

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/root.hints"
    mode: '0644'
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.zone"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
    validate: >
      named-checkzone {{ item.name }} {{ dns_datadir }}/{{ item.name }}.zone
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_named_conf }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
    backup: yes
    validate: "named-checkconf {{ dns_named_conf }}"
  notify: Restart dns

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: "{{ dns_service_systemd_override_dir }}"
        state: directory
        mode: '0755'
    - name: Copy systemd override file
      copy:
        src: systemd_override.conf
        dest: "{{ dns_service_systemd_override_dir }}/override.conf"
        mode: '0644'
    - name: Reload systemd daemon
      systemd:
        daemon_reload: true
  when: ansible_service_mgr == 'systemd'

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true

- name: Rndc reload
  command: rndc reload
  when: false

- name: Restart dns
  service:
    name: "{{ dns_service }}"
    state: restarted
    enabled: true
    daemon_reload: true


