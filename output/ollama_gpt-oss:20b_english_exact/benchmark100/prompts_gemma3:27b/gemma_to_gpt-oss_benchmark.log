---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost
- name: Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present
- name: Create directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: "{{ dns_dir_mode }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"
- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present
- name: Create user
  ansible.builtin.user:
    name: "{{ dns_owner }}"
    system: true
    state: present
    group: "{{ dns_group }}"
- name: Generate rndc key
  ansible.builtin.command: "rndc-confgen -a -c {{ dns_confdir }}/rndc.key"
  args:
    creates: "{{ dns_confdir }}/rndc.key"
- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0600"
- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ dns_root_server_url }}"
    dest: "{{ dns_datadir }}/root.hints"
    mode: "0644"
  when: dns_caching_dns
  notify: Rndc reload
- name: Create zone file
  ansible.builtin.template:
    src: dns_zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.zone"
    mode: "0644"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    validate: "named-checkzone {{ item.name }} %s"
  loop: "{{ dns_zones }}"
  notify: Rndc reload
- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: "{{ dns_named_conf_path }}"
    backup: true
    mode: "0644"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    validate: "named-checkconf %s"
  notify: Restart dns
- name: Place systemd override
  when: ansible_service_mgr == 'systemd'
  block:
    - name: Create systemd override directory
      ansible.builtin.file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        state: directory
        mode: "0755"
    - name: Copy systemd override file
      ansible.builtin.template:
        src: dns_override.conf.j2
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
        mode: "0644"
    - name: Reload systemd daemon
      ansible.builtin.systemd:
        daemon_reload: true
- name: Start and enable dns
  ansible.builtin.service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


