---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true
- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present
- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    regexp: '^index-url='
    line: "index-url={{ python_pip_proxy }}"
    insertafter: "\\[global\\]"
    mode: '0644'
  when: python_pip_proxy is defined
- name: Trust hosts
  lineinfile:
    path: /etc/pip.conf
    regexp: '^trusted-host='
    line: "trusted-host={{ python_pip_trusted_host }}"
    insertafter: "\\[global\\]"
    mode: '0644'
  when: python_pip_trusted_host is defined
- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when: >
    not (ansible_facts['distribution'] == 'Debian' and
         ansible_facts['distribution_release'] == 'bookworm' or
         ansible_facts['distribution'] == 'Ubuntu' and
         ansible_facts['distribution_release'] == 'noble' or
         ansible_facts['distribution'] == 'Alpine')
- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(omit) }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  loop_control:
    label: "{{ item.name }}"
  when: >
    not (ansible_facts['distribution'] == 'Debian' and
         ansible_facts['distribution_release'] == 'bookworm' or
         ansible_facts['distribution'] == 'Ubuntu' and
         ansible_facts['distribution_release'] == 'noble' or
         ansible_facts['distribution'] == 'Alpine')


