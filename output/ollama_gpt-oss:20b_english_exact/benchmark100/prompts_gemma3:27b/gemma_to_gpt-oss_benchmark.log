---
- name: Create ssh_key_directory for user
  file:
    path: "{{ user.ssh_key_directory }}"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.manage_ssh_key is defined and user.manage_ssh_key
  delegate_to: localhost

- name: Manage user account
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment | default(omit) }}"
    home: "{{ user.home | default(omit) }}"
    create_home: "{{ user.create_home | default(omit) }}"
    password: "{{ user.password | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    expires: "{{ user.expires | default(omit) }}"
  register: user_result

- name: Set sudo options for user
  template:
    src: templates/sudoers.j2
    dest: "/etc/sudoers.d/{{ item.name }}"
    mode: '0440'
    validate: 'visudo -cf %s'
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.sudo_options is defined and item.sudo_options | length > 0

- name: Remove sudo options for user
  file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: absent
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.sudo_options is not defined or item.sudo_options | length == 0

- name: Generate private ssh key for user
  command: "ssh-keygen -t rsa -b 2048 -f {{ user.ssh_key_directory }}/{{ user.name }} -N ''"
  args:
    creates: "{{ user.ssh_key_directory }}/{{ user.name }}"
  when: user.manage_ssh_key is defined and user.manage_ssh_key
  delegate_to: localhost

- name: Generate public ssh key for user
  command: "ssh-keygen -y -f {{ user.ssh_key_directory }}/{{ user.name }} > {{ user.ssh_key_directory }}/{{ user.name }}.pub"
  args:
    creates: "{{ user.ssh_key_directory }}/{{ user.name }}.pub"
  when: user.manage_ssh_key is defined and user.manage_ssh_key
  delegate_to: localhost

- name: Convert ssh key to ppk for user
  command: "puttygen {{ user.ssh_key_directory }}/{{ user.name }} -o {{ user.ssh_key_directory }}/{{ user.name }}.ppk"
  args:
    creates: "{{ user.ssh_key_directory }}/{{ user.name }}.ppk"
  when: user.manage_ssh_key is defined and user.manage_ssh_key
  delegate_to: localhost

- name: Get user info from passwd database
  getent:
    database: passwd
    key: "{{ user.name }}"
  register: user_info
  ignore_errors: yes

- name: Set user home directory fact
  set_fact:
    user_home: "{{ user_info[0].home if user_info is defined and user_info[0] is defined else '/home' }}"

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  become: true
  become_user: "{{ user.name }}"
  when: user.manage_ssh_key is defined or user.private_keys is defined

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ item }}"
  loop: "{{ user.authorized_keys | default([]) }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ user.unauthorized_keys | default([]) }}"

- name: Copy generated private ssh key for user
  copy:
    src: "{{ user.ssh_key_directory }}/{{ user.name }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
    mode: '0600'
  when: user.copy_private_key is defined
  delegate_to: localhost

- name: Check users password valid time
  command: "chage -l {{ user.name }} | grep 'Password expires'"
  register: password_expire_info

- name: Set users password valid time
  command: "chage -M 90 {{ user.name }}"

- name: Place private key file for user
  copy:
    content: "{{ item.content }}"
    dest: "{{ user_home }}/.ssh/{{ item.key_name }}"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
    mode: '0600'
  loop: "{{ user.private_keys | default([]) }}"
  when: user.private_keys is defined


