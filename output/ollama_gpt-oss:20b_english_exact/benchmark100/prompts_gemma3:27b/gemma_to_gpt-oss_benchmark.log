---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Configure apk
  when: ansible_pkg_mgr == 'apk'
  notify: Reboot
  block:
    - name: Update apk cache
      community.general.apk:
        update_cache: true
    - name: Upgrade all apk packages
      community.general.apk:
        upgrade: true

- name: Configure apt
  when: ansible_pkg_mgr == 'apt'
  notify: Reboot
  block:
    - name: Prevent upgrades for excluded packages
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
      loop: "{{ update_excluded_packages }}"
    - name: Update apt cache
      ansible.builtin.apt:
        update_cache: true
    - name: Upgrade all apt packages
      ansible.builtin.apt:
        upgrade: dist
    - name: Autoremove if enabled
      ansible.builtin.apt:
        autoremove: true
      when: apt_autoremove | default(false)

- name: Update all software (dnf)
  when: ansible_pkg_mgr in ['dnf', 'dnf5']
  ansible.builtin.dnf:
    name: '*'
    state: present
    update_cache: true
    upgrade: true
    options: "--exclude={{ update_excluded_packages | join(' ') }}"
  notify: Reboot

- name: Update all software (pacman)
  community.general.pacman:
    update_cache: true
    upgrade: true
    options: "--exclude={{ update_excluded_packages | join(' ') }}"
    name: '*'
  notify: Reboot

- name: Configure yum
  when: ansible_pkg_mgr == 'yum'
  notify: Reboot
  block:
    - name: Update all yum packages
      ansible.builtin.yum:
        name: '*'
        state: present
        update_cache: true
        upgrade: true
        options: "--exclude={{ update_excluded_packages | join(' ') }}"

- name: Update all software (zypper)
  when: ansible_pkg_mgr == 'zypper'
  community.general.zypper:
    name: '*'
    state: present
    refresh: true
    update: true
    options: "--exclude={{ update_excluded_packages | join(' ') }}"
  notify: Reboot


