- hosts: kube_control_plane
  pre_tasks:
    - name: Wait for API server to be available
      ansible.builtin.wait_for:
        host: "{{ inventory_hostname }}"
        port: 6443
        timeout: 180
        delay: 5
        state: started
        connect_timeout: 5

    - name: Wait for all nodes to be ready
      ansible.builtin.shell: |
        set -o pipefail;
        kubectl get nodes -o json | \
        jq -r '.items[]|select(.status.conditions[]|.type=="Ready"and.status=="True")|.metadata.name' | \
        grep -q '^$'
      register: node_ready_check
      failed_when: node_ready_check.rc != 0

    - name: Wait for all nodes to be ready (again)
      ansible.builtin.shell: |
        set -o pipefail;
        kubectl get nodes -o json | \
        jq -r '.items[]|select(.status.conditions[]|.type=="Ready"and.status=="True")|.metadata.name' | \
        grep -q '^$'
      register: node_ready_check
      failed_when: node_ready_check.rc != 0

  roles:
