---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: "{{ dns_dir_mode }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    system: yes
    state: present
    group: "{{ dns_group }}"

- name: Generate rndc key
  command: "rndc-confgen -a -c {{ dns_confdir }}/rndc.key"
  args:
    creates: "{{ dns_confdir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0600"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_server_url }}"
    dest: "{{ dns_datadir }}/root.hints"
    mode: "0644"
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  template:
    src: dns_zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.zone"
    mode: "0644"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    validate: "named-checkzone {{ item.name }} %s"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_named_conf_path }}"
    backup: yes
    mode: "0644"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    validate: "named-checkconf %s"
  notify: Restart dns

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        state: directory
        mode: "0755"
    - name: Copy systemd override file
      template:
        src: dns_override.conf.j2
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
        mode: "0644"
    - name: Reload systemd daemon
      systemd:
        daemon_reload: yes
  when: ansible_service_mgr == 'systemd'

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: yes


