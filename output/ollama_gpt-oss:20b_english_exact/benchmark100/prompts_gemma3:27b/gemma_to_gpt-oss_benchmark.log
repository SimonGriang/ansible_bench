---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present
  become: true

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: git_user
  failed_when: git_user.failed and (fail_key | default(true) | bool)
  become: true

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0755"
  become: true

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0644"
  become: true

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0755"
  become: true

- name: Clone all roles
  git:
    repo: "{{ item.url }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    version: "{{ item.version | default('master') }}"
    force: "{{ item.force | default(false) }}"
  loop: "{{ git_repositories }}"
  loop_control:
    label: "{{ git_repository_destination }}/{{ item.name }}"
  become: true
  become_user: "{{ git_username }}"


