---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages
  ansible.builtin.package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  ansible.builtin.lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_TIMEOUT='
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: true
    mode: '0664'
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  ansible.builtin.lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_RECORDFAIL_TIMEOUT='
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: true
    mode: '0664'
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  ansible.builtin.lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX='
    line: 'GRUB_CMDLINE_LINUX="{{ item }}"'
    create: true
    mode: '0664'
    validate: /usr/sbin/grub2-mkconfig -v -o %s
  notify: Update grub
  loop: "{{ grub_options }}"
  loop_control:
    label: "{{ item }}"
  when: grub_options is defined and grub_options | length > 0

- name: Import password.yml
  ansible.builtin.import_tasks: password.yml
  when: grub_set_password

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


