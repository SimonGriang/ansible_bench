---
- name: lookup bootstrap facts (raw)
  raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"

- name: set bootstrap facts (I) # noqa jinja
  set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search('VERSION_ID=\"?([0-9]+)', '\\1') }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout | regex_search(item.key)
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when:
    - bootstrap_distribution is defined
    - bootstrap_distribution in item.value
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"}


