---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  template:
    src: rke2_config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: kubelet_config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: containerd_registry.yaml.j2
    dest: /etc/rancher/rke2/containerd_registry.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and (services['rke2-server.service'].state != 'enabled')

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file is defined
    - rke2_etcd_snapshot_s3_options is defined
    - rke2_etcd_snapshot_s3_options.access_key | default('') != ''
    - rke2_etcd_snapshot_s3_options.bucket | default('') != ''

- name: Restore etcd from file
  block:
    - name: Create etcd destination directory
      file:
        path: /var/lib/rancher/rke2/server/db
        state: directory
        owner: root
        group: root
        mode: '0755'
    - name: Copy etcd snapshot
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/etcd.db
        owner: root
        group: root
        mode: '0644'
    - name: Run rke2 server restore
      command: rke2 server --restore-snapshot /var/lib/rancher/rke2/server/db/etcd.db
  when: do_etcd_restore | default(false)

- name: Restore etcd from s3
  block:
    - name: Run rke2 server restore from s3
      command: >
        rke2 server
        --restore-snapshot-s3
        --restore-s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }}
        --restore-s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }}
        --restore-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }}
        --restore-s3-region {{ rke2_etcd_snapshot_s3_options.region | default('') }}
  when: do_etcd_restore_from_s3 | default(false)

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    masked: yes
    enabled: no

- name: Wait for the first server be ready - no CNI
  shell: kubectl get nodes --no-headers | grep -E 'Ready|NotReady'
  register: wait_no_cni
  retries: 30
  delay: 10
  until: "'Ready' in wait_no_cni.stdout"
  ignore_errors: yes

- name: Wait for the first server be ready - with CNI
  shell: kubectl get nodes --no-headers | grep -E 'Ready'
  register: wait_cni
  retries: 30
  delay: 10
  until: "'Ready' in wait_cni.stdout"
  ignore_errors: yes

- name: Restore etcd
  block:
    - name: Get registered nodes
      command: rke2 etcdctl member list
      register: etcd_members
    - name: Get node names
      command: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
      register: node_names
    - name: Remove old secrets
      shell: kubectl delete secret --all -n kube-system
      ignore_errors: yes
    - name: Remove old nodes
      shell: kubectl delete node --all
      ignore_errors: yes

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"



