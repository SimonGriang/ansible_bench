---
- name: Download RKE2 installation script
  get_url:
    url: >-
      {{ rke2_install_script_url }}
    dest: >-
      {{ rke2_install_script_dest }}
    mode: "0755"
  when: not airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: >-
      {{ rke2_local_script_path }}
    dest: >-
      {{ rke2_install_script_dest }}
    mode: "0755"
  when:
    - airgap_mode
    - implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: >-
      {{ rke2_artifacts_path }}
    state: directory
    mode: "0755"
  when:
    - airgap_mode
    - implementation != 'exists'

- name: |-
    Download RKE2 checksum and artifacts
    (try to download remotely first - fallback to local download and push)
  block:
    - name: Attempt remote download of checksum and artifacts
      get_url:
        url: >-
          {{ rke2_remote_checksum_url }}
        dest: >-
          {{ rke2_artifacts_path }}/checksum.txt
      register: remote_checksum_download
      failed_when: false

    - name: Attempt remote download of artifacts
      get_url:
        url: >-
          {{ rke2_remote_artifact_url }}
        dest: >-
          {{ rke2_artifacts_path }}/{{ item }}
      loop: "{{ rke2_artifact_list }}"
      register: remote_artifact_download
      failed_when: false

    - name: Copy local checksum and artifacts if remote download failed
      copy:
        src: >-
          {{ rke2_local_checksum_path }}
        dest: >-
          {{ rke2_artifacts_path }}/checksum.txt
      when: remote_checksum_download.failed

    - name: Copy local artifacts if remote download failed
      copy:
        src: >-
          {{ rke2_local_artifact_path }}/{{ item }}
        dest: >-
          {{ rke2_artifacts_path }}/{{ item }}
        mode: "0644"
      loop: "{{ rke2_artifact_list }}"
      when: remote_artifact_download.failed
  when: airgap_mode

- name: Copy local RKE2 artifacts
  copy:
    src: >-
      {{ rke2_local_artifact_path }}/{{ item }}
    dest: >-
      {{ rke2_artifacts_path }}/{{ item }}
    mode: "0644"
  loop: "{{ rke2_artifact_list }}"
  when:
    - airgap_mode
    - implementation == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: >-
      {{ item }}
    dest: >-
      {{ rke2_artifacts_path }}/{{ item | basename }}
    mode: "0644"
  loop: "{{ rke2_additional_tarballs | default([]) }}"
  when:
    - airgap_mode
    - rke2_additional_tarballs is defined

- name: |-
    Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: >-
      {{ rke2_artifacts_path }}/{{ item }}
    state: file
    mode: "0644"
  loop: "{{ rke2_artifact_list }}"
  when: airgap_mode
# only modifies permissions if they are overprivileged

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Check if separate partition
  set_fact:
    usr_local_on_separate_partition: >-
      {{ (ansible_mounts | selectattr('mount', 'equalto', '/usr/local') | list | length) > 0 }}

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: >-
      {{ '/usr/local/bin/rke2' if usr_local_on_separate_partition else '/usr/bin/rke2' }}

- name: Check RKE2 version
  command: >-
    {{ rke2_bin_path }} version
  register: rke2_version_output
  changed_when: false

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: >-
      {{ rke2_version_output.stdout | regex_search('Installed version: (\\S+)', '\\1')
      | default('') }}
    rke2_running_version: >-
      {{ rke2_version_output.stdout | regex_search('Running version: (\\S+)', '\\1')
      | default('') }}

- name: Prevent accidental RKE2 downgrade
  assert:
    that: >-
      {{ (rke2_installed_version == '' or
           rke2_running_version == '' or
           rke2_installed_version >= rke2_running_version) or
           allow_downgrade | default(false) }}
    fail_msg: >-
      Attempting to downgrade RKE2 from {{ rke2_installed_version }} to
      {{ rke2_running_version }} is not allowed.

- name: Run RKE2 install script
  shell: "{{ rke2_install_script_dest }} {{ rke2_install_args | join(' ') }}"
  environment: "{{ rke2_install_env | default({}) }}"
  args:
    chdir: "{{ rke2_install_dir }}"
  register: rke2_install_result
  changed_when: rke2_install_result.rc == 0

- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_custom_manifests_path }}/{{ item }}"
    dest: "{{ rke2_data_dir }}/{{ item }}"
    mode: "0644"
  loop: "{{ rke2_custom_manifests | default([]) }}"

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_path }}/{{ item }}"
    dest: "{{ rke2_agent_dir }}/{{ item }}"
    mode: "0644"
  loop: "{{ rke2_static_pods | default([]) }}"

- name: Copy RKE2 environment file
  copy:
    src: >-
      {{ rke2_env_file_src }}
    dest: >-
      {{ rke2_env_file_dest }}
    mode: "0644"
