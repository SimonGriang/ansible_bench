    expires: "{{ user.password_expire | default(omit) }}"
  when: user.password_expire is defined

- name: Place private key file for user
  copy:
    content: "{{ item.value }}"
    dest: "{{ user_home }}/.ssh/{{ item.key }}"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  loop: "{{ user.private_keys | dict2items }}"
  when: user.private_keys is defined


