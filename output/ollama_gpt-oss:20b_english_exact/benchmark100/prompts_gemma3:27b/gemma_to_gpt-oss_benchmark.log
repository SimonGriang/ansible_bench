---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Enable redis module stream (RHEL 8)
  ansible.builtin.command: dnf module enable redis -y
  when:
    - ansible_os_family == 'RedHat'
    - ansible_distribution_major_version == '8'
  changed_when: false

- name: Install redis
  ansible.builtin.package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  ansible.builtin.template:
    src: "redis.conf-{{ ansible_distribution }}.j2"
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_owner | default('root') }}"
    group: "{{ redis_group | default('root') }}"
    mode: "{{ redis_mode | default('0644') }}"
  notify: Restart redis

- name: Start and enable redis
  ansible.builtin.service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


