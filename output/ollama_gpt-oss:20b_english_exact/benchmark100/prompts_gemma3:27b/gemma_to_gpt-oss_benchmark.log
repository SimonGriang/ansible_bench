---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  template:
    src: rke2_config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: kubelet_config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: containerd_registry.yaml.j2
    dest: /etc/rancher/rke2/containerd_registry.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and services['rke2-server.service'].state != 'enabled'

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.access_key | default('') != '' and rke2_etcd_snapshot_s3_options.bucket | default('') != ''

- name: Restore etcd from file
  block:
    - name: Create the etcd restore directory
      file:
        path: /etc/rancher/rke2/etcd-restore
        state: directory
        owner: root
        group: root
        mode: '0755'
    - name: Copy the etcd snapshot
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /etc/rancher/rke2/etcd-restore/snapshot.db
        owner: root
        group: root
        mode: '0600'
    - name: Restore the etcd database
      command: rke2 etcd --data-dir /etc/rancher/rke2/etcd-restore/restore
      args:
        chdir: /etc/rancher/rke2
      environment:
        RKE2_DEBUG: 'true'
  when: do_etcd_restore | bool

- name: Restore etcd from s3
  block:
    - name: Download the etcd snapshot
      aws_s3:
        bucket: "{{ rke2_etcd_snapshot_s3_options.bucket }}"
        object: "{{ rke2_etcd_snapshot_s3_options.object }}"
        dest: /tmp/snapshot.db
        mode: get
        aws_access_key: "{{ rke2_etcd_snapshot_s3_options.access_key }}"
        aws_secret_key: "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
    - name: Restore the etcd database
      command: rke2 etcd --data-dir /etc/rancher/rke2/etcd-restore/restore
      args:
        chdir: /etc/rancher/rke2
      environment:
        RKE2_DEBUG: 'true'
  when: do_etcd_restore_from_s3 | bool

- name: Start the RKE2 service
  service:
    name: rke2-server
    state: started
    enabled: true

- name: Stop the RKE2 service
  service:
    name: rke2-server
    state: stopped
    enabled: false

- name: Stop the RKE2 service
  service:
    name: rke2-server
    state: stopped
    masked: true

- name: Wait for RKE2 to be ready
  shell: |
    while ! curl -s -k https://127.0.0.1:9345/healthz; do sleep 1; done
  args:
    warn: false
  register: rke2_health
  ignore_errors: true

