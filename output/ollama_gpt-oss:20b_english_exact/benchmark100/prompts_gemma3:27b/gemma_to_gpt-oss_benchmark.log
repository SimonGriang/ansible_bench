---
- name: Create the RKE2 config directory.
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  template:
    src: rke2-config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: containerd-registry.conf.j2
    dest: /etc/containerd/config.toml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)

- name: Gather service facts
  service_facts:

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and ('rke2-server.service' not in services or services['rke2-server.service'].state != 'running')

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file is defined
    - rke2_etcd_snapshot_s3_options is defined
    - rke2_etcd_snapshot_s3_options.access_key_id is defined
    - rke2_etcd_snapshot_s3_options.bucket is defined

- name: Restore etcd from file
  block:
    - name: Create etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/server/db
        state: directory
        owner: root
        group: root
        mode: '0755'
    - name: Copy etcd snapshot
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/snapshot.db
        owner: root
        group: root
        mode: '0600'
    - name: Restore etcd from snapshot file
      command: >
        rke2 server --restore-snapshot /var/lib/rancher/rke2/server/db/snapshot.db
  when: do_etcd_restore | default(false)

- name: Restore etcd from s3
  block:
    - name: Restore etcd from S3 snapshot
      command: >
        rke2 server
        --restore-snapshot-s3-access-key-id {{ rke2_etcd_snapshot_s3_options.access_key_id }}
        --restore-snapshot-s3-secret-access-key {{ rke2_etcd_snapshot_s3_options.secret_access_key | default('') }}
        --restore-snapshot-s3-region {{ rke2_etcd_snapshot_s3_options.region | default('') }}
        --restore-snapshot-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }}
        --restore-snapshot-s3-path {{ rke2_etcd_snapshot_s3_options.path | default('') }}
  when: do_etcd_restore_from_s3 | default(false)

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    state: masked
    enabled: no

- name: Wait for the first server be ready - no CNI
  shell: kubectl get nodes
  register: kubectl_nodes
  until: "'Ready' in kubectl_nodes.stdout"
  retries: 30
  delay: 10

- name: Wait for the first server be ready - with CNI
  shell: kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}'
  register: kubectl_ready_status
  until: kubectl_ready_status.stdout == "True"
  retries: 30
  delay: 10

- name: Get registered nodes
  shell: kubectl get nodes -o json
  register: registered_nodes

- name: Extract node names
  set_fact:
    node_names: "{{ registered_nodes.stdout | from_json | json_query('items[*].metadata.name') }}"

- name: Remove old secrets
  shell: kubectl delete secret --all -n kube-system
  ignore_errors: yes

- name: Remove old nodes
  shell: kubectl delete node --all
  ignore_errors: yes

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"



