  block:
    - name: Test connection
      ansible.builtin.ping:
    - name: Ensure sudo access
      ansible.builtin.command: whoami
      become: true
      changed_when: false
  rescue:
    - name: Gather facts
      ansible.builtin.setup:
    - name: Install bootstrap packages via raw
      ansible.builtin.raw: |
        yum install -y {{ bootstrap_facts_packages | join(' ') }}
      become: true
      changed_when: false
    - name: Ensure libdnf5 is present on RedHat systems
      ansible.builtin.dnf:
        name: libdnf5
        state: present
      when: ansible_os_family == 'RedHat'
      become: true

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
    become: "{{ bootstrap_become }}"


