---
- name: Load OS-specific variables
  include_vars:
    file: "{{ lookup('first_found', files) }}"
  vars:
    files:
      - "vars/{{ ansible_facts.os_family }}-{{ ansible_facts.os_distribution }}.yml"
      - "vars/{{ ansible_facts.os_family }}.yml"
      - "vars/main.yml"

- name: Include RedHat setup tasks
  include_tasks: redhat.yml
  when: ansible_facts.os_family == 'RedHat'

- name: Include Debian setup tasks
  include_tasks: debian.yml
  when: ansible_facts.os_family == 'Debian'

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: true
  when:
    - ansible_version.full is version('2.12', '<')
    - ansible_facts.os_family not in ['RedHat', 'Debian']

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: true
  notify: restart docker
  ignore_errors: true
  when:
    - ansible_version.full is version('2.12', '>=')
    - ansible_facts.os_family in ['RedHat', 'Debian']

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: true
  when:
    - docker_install_compose_plugin
    - ansible_version.full is version('2.12', '<')
    - ansible_facts.os_family not in ['RedHat', 'Debian']

- name: Install docker-compose-plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: true
  notify: restart docker
  ignore_errors: true
  when:
    - docker_install_compose_plugin
    - ansible_version.full is version('2.12', '>=')
    - ansible_facts.os_family in ['RedHat', 'Debian']

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: '0755'
  when: docker_daemon_options is defined and docker_daemon_options | length > 0

- name: Configure Docker daemon options
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_nice_json }}"
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options is defined and docker_daemon_options | length > 0

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
