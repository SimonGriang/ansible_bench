---
- name: Assert systemd as init system
  assert:
    that:
      - ansible_facts.service_mgr == "systemd"
    fail_msg: "System is not using systemd as init system."

- name: Get latest release
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
    status_code: 200
    headers: "{{ {'Authorization': 'token ' + GH_TOKEN} if (GH_USER is defined and GH_TOKEN is defined) else {} }}"
  register: _latest_release
  retries: 5
  delay: 5
  until: _latest_release.status == 200

- name: Set promtail version to {{ _latest_release.json.tag_name[1:] }}
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
  when: promtail_version == 'latest'

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.zip"
  register: promtail_binary_local_archive
  when: promtail_binary_local_dir is defined

- name: Assert local binary exists
  assert:
    that:
      - promtail_binary_local_archive.stat.exists
    fail_msg: "Local promtail binary archive not found in {{ promtail_binary_local_dir }}."
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  uri:
    url: "https://raw.githubusercontent.com/grafana/loki/release/{{ promtail_version }}/SHA256SUMS"
    return_content: yes
    status_code: 200
  register: __promtail_checksums_raw
  when: promtail_binary_local_dir is not defined

- name: Set checksum list fact
  set_fact:
    __promtail_checksums: "{{ __promtail_checksums_raw.content.splitlines() }}"
  when: promtail_binary_local_dir is not defined

- name: Get checksum for {{ go_arch }} architecture
  set_fact:
    __promtail_checksum: "{{ item.split()[0] }}"
  loop: "{{ __promtail_checksums }}"
  when:
    - promtail_binary_local_dir is not defined
    - item is search(go_arch)


