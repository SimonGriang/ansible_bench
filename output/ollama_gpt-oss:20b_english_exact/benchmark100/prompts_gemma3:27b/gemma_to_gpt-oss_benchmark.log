    at_least_one_user_to_modify: "{{ (docker_users | difference(docker_group_info.members)) | length > 0 }}"  
  when: docker_users is defined  

- name: Include docker-users tasks  
  include_tasks: docker-users.yml  
  when: at_least_one_user_to_modify is defined


