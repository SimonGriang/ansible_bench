---
- name: Check if all variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host to be reachable
  wait_for:
    host: "{{ ansible_ssh_host | default(ansible_host, inventory_hostname) }}"
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  become: "{{ bootstrap_become | default(false) }}"
  when: >
    ansible_connection not in ['container', 'docker'] and
    bootstrap_wait_for_host | bool

- name: Prepare the system
  block:
    - name: Test connection
      wait_for_connection:
      register: bootstrap_connect
    - name: Debug bootstrap_timeout if connection failed
      debug:
        var: bootstrap_timeout
      when: not bootstrap_connect.success
- import_tasks: gather_facts.yml

- name: Install bootstrap packages
  raw: echo installed
  register: bootstrap_install_packages
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_user }}"
  changed_when: >
    (ansible_distribution in ['Alpine', 'Archlinux', 'Gentoo'] and
     bootstrap_install_packages.stdout is search('installed')) or
    (ansible_distribution in ['Debian', 'RedHat', 'Rocky', 'Suse'] and
     bootstrap_install_packages.stdout is not search('installed'))

- name: Ensure system is prepared
  block:
    - name: Gather ansible facts
      setup:
    - name: Install bootstrap facts packages
      package:
        name: "{{ bootstrap__facts_packages }}"
        state: present
        update_cache: true


