---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install requirements
  ansible.builtin.package:
    name: bash
    state: present

- name: Install openjdk java (package)
  ansible.builtin.package:
    name: openjdk
    state: present
  environment:
    USE: no-ssl
  when: java_vendor == "openjdk"

- name: Install RPM
  ansible.builtin.copy:
    src: "{{ java_local_rpm }}"
    dest: /tmp/
    mode: '0644'
    owner: root
    group: root
  when: java_source == "local" and java_format == "rpm"

- name: Install RPM
  ansible.builtin.package:
    name: "/tmp/{{ java_local_rpm | basename }}"
    state: present
  when: java_source == "local" and java_format == "rpm"

- name: Install DEB
  ansible.builtin.copy:
    src: "{{ java_local_deb }}"
    dest: /tmp/
    mode: '0644'
    owner: root
    group: root
  when: java_source == "local" and java_format == "deb"

- name: Install DEB
  ansible.builtin.apt:
    deb: "/tmp/{{ java_local_deb | basename }}"
    state: present
  when: java_source == "local" and java_format == "deb"

- name: Install oracle java (rpm) (repository)
  ansible.builtin.package:
    name: "{{ java_package }}"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  ansible.builtin.file:
    path: "{{ java_install_dir }}"
    state: directory
    mode: '0755'
    owner: root
    group: root
  when: java_format == "targz" and java_vendor == "oracle"

- name: Configure oracle targz
  ansible.builtin.unarchive:
    src: "{{ java_targz_path }}"
    dest: "{{ java_install_dir }}"
    remote_src: true
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install oracle java policy software (targz)
  ansible.builtin.unarchive:
    src: "{{ java_jce_zip_path }}"
    dest: "{{ java_install_dir }}/jre/lib/security"
    remote_src: true
  when:
    - java_jce
    - java_version == 8
    - java_vendor == "oracle"

- name: Set alternative (targz)
  ansible.builtin.command:
    cmd:
      - alternatives
      - --install
      - /usr/bin/java
      - java
      - "{{ java_install_dir }}/bin/java"
      - '1'
  when:
    - java_format == "targz"
    - ansible_distribution != "Alpine"
    - java_vendor == "oracle"
  changed_when: false

- name: Find JAVA_HOME
  ansible.builtin.shell: |
    set -o pipefail; readlink -f /usr/bin/java | dirname | dirname
  register: java_home_result
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  ansible.builtin.file:
    path: /etc/profile.d/java_home.sh
    state: touch
    mode: '0644'
    owner: root
    group: root
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  ansible.builtin.lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home_result.stdout }}"
    create: true
  changed_when: false


