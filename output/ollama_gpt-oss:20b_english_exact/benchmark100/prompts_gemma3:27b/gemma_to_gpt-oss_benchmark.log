---
- name: Download RKE2 installation script
  when: not airgap
  get_url:
    url: >-
      {{ rke2_install_script_url }}
    dest: "{{ rke2_install_script_dest }}"
    mode: '0755'

- name: Copy local RKE2 installation script
  when: airgap and implementation == 'copy'
  copy:
    src: "{{ local_rke2_install_script_src }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0755'

- name: Create RKE2 artifacts folder
  when: airgap and implementation != 'exists'
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0755'

- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)
  when: airgap
  block:
    - name: Download RKE2 artifacts remotely
      get_url:
        url: >-
          {{ rke2_artifact_urls[item] }}
        dest: "{{ rke2_artifacts_path }}/{{ item }}"
        mode: '0644'
      loop: "{{ rke2_artifacts_list }}"
      register: remote_download
      ignore_errors: true

    - name: Check remote download success
      set_fact:
        artifacts_downloaded: "{{ remote_download is succeeded }}"

    - name: Download locally and push
      when: not artifacts_downloaded
      block:
        - name: Download artifacts locally
          get_url:
            url: >-
              {{ rke2_artifact_urls[item] }}
            dest: "{{ local_artifacts_path }}/{{ item }}"
            mode: '0644'
          loop: "{{ rke2_artifacts_list }}"

        - name: Copy artifacts to remote
          copy:
            src: "{{ local_artifacts_path }}/{{ item }}"
            dest: "{{ rke2_artifacts_path }}/{{ item }}"
            mode: '0644'
          loop: "{{ rke2_artifacts_list }}"

- name: Copy local RKE2 artifacts
  when: airgap and implementation == 'copy'
  copy:
    src: "{{ local_artifacts_path }}/{{ item }}"
    dest: "{{ rke2_artifacts_path }}/{{ item }}"
    mode: '0644'
  loop: "{{ rke2_artifacts_list }}"

- name: Airgap mode - additional images tarballs
  when: airgap and additional_images is defined
  copy:
    src: "{{ additional_images_path }}/{{ item }}"
    dest: "{{ rke2_artifacts_path }}/{{ item }}"
    mode: '0644'
  loop: "{{ additional_images }}"

- name: Airgap mode - ensure artifacts exist and have acceptable permissions  # only modifies permissions if they are overprivileged
  when: airgap
  block:
    - name: Stat artifact
      stat:
        path: "{{ rke2_artifacts_path }}/{{ item }}"
      register: artifact_stat
      loop: "{{ rke2_artifacts_list }}"

    - name: Adjust permissions if overprivileged
      file:
        path: "{{ rke2_artifacts_path }}/{{ item }}"
        mode: '0644'
      when: artifact_stat.results[ansible_loop.index0].stat.mode | int > 644
      loop: "{{ rke2_artifacts_list }}"

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Check if separate partition
  set_fact:
    usr_local_separate_partition: "{{ usr_local_stat.stat.mounted }}"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: >-
      {{ '/usr/local/bin/rke2' if usr_local_separate_partition else '/usr/bin/rke2' }}

- name: Check RKE2 version
  command: "{{ rke2_bin_path }} --version"
  register: rke2_version_cmd
  ignore_errors: true

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: >-
      {{ rke2_version_cmd.stdout_lines[0] | regex_search('v[0-9.]+') if rke2_version_cmd.stdout_lines else '' }}
    rke2_running_version: >-
      {{ rke2_running_version | default('') }}

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "(rke2_installed_version | version_compare(rke2_desired_version, '>=')) or force_downgrade"
    fail_msg: "Downgrade not allowed unless force_downgrade is true"

- name: Run RKE2 install script
  environment:
    INSTALL_SCRIPT_PATH: "{{ rke2_install_script_dest }}"
  shell: >-
    {{ rke2_install_script_dest }} --install-dir {{ rke2_install_dir }}
  args:
    creates: "{{ rke2_bin_path }}"

- name: Copy Custom Manifests
  copy:
    src: "{{ custom_manifests_src }}/{{ item }}"
    dest: "{{ rke2_data_dir }}/{{ item }}"
    mode: '0644'
  loop: "{{ custom_manifests_list }}"

- name: Copy Static Pods
  copy:
    src: "{{ static_pods_src }}/{{ item }}"
    dest: "{{ rke2_agent_dir }}/{{ item }}"
    mode: '0644'
  loop: "{{ static_pods_list }}"

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file_src }}"
    dest: "{{ rke2_env_file_dest }}"
    mode: '0644'


