---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: git_user_check
  failed_when: git_user_check.found == false and fail_key != false

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0644'

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Clone all roles
  git:
    repo: "{{ item.repo_url }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version }}"
    force: "{{ item.force }}"
  loop: "{{ git_repositories }}"
  loop_control:
    label: "{{ item.dest }}"
  become: true
  become_user: "{{ git_username }}"


