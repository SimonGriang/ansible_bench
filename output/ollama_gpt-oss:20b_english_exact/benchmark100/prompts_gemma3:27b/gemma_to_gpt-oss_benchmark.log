---  
- name: Task 1: gather bootstrap facts using raw command  
  raw: cat /etc/os-release  
  register: bootstrap_facts  
  become: false  

- name: Task 2: set bootstrap facts (I) based on OS release information  
  set_fact:  
    bootstrap_distribution: "{{ item }}"  
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search('VERSION_ID=([0-9]+)', '\\1') }}"  
  loop: "{{ bootstrap_os_family_map | dict2items | map(attribute='value') | list | flatten }}"  
  when:  
    - bootstrap_facts.rc == 0  
    - bootstrap_distribution is not defined  
    - bootstrap_search in bootstrap_facts.stdout  

- name: Task 3: set bootstrap facts (II) based on OS family  
  set_fact:  
    bootstrap_os_family: "{{ item.key }}"  
  loop: "{{ bootstrap_os_family_map | dict2items }}"  
  loop_control:  
    label: "{{ item.key }}"  
  when:  
    - bootstrap_distribution is defined  
    - bootstrap_distribution in item.value


