---
- name: Download RKE2 kubeconfig to localhost
  fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: "{{ kubeconf_path }}"
    flat: true
  vars:
    kubeconf_path: >-
      {{
        [rke2_download_kubeconf_path,
         rke2_download_kubeconf_file_name] | join('/')
      }}
  when:
    - rke2_download_kubeconf
    - inventory_hostname == (groups[rke2_servers_group_name] | first)

- name: Replace loopback IP by master server IP
  replace:
    path: "{{ kubeconf_path }}"
    regexp: "127\\.0\\.0\\.1|\\[::1\\]"
    replace: "{{ kubeconf_replace }}"
  vars:
    kubeconf_path: >-
      {{
        [rke2_download_kubeconf_path,
         rke2_download_kubeconf_file_name] | join('/')
      }}
    master_host: >-
      {{
        hostvars[groups[rke2_servers_group_name] | first].ansible_host
      }}
    kubeconf_replace: "{{ rke2_api_ip | default(master_host) }}"
  delegate_to: localhost
  become: false
  when:
    - rke2_download_kubeconf
    - inventory_hostname == (groups[rke2_servers_group_name] | first)
    - not ansible_check_mode


