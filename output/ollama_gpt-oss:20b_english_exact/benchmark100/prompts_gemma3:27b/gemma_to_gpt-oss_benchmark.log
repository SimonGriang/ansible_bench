---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Configure apk
  block:
    - name: Update apk cache
      apk:
        update_cache: yes
    - name: Upgrade all apk packages
      apk:
        upgrade: yes
      notify: Reboot
  when: ansible_pkg_mgr == 'apk'

- name: Configure apt
  block:
    - name: Prevent upgrades for excluded packages
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ update_excluded_packages }}"
    - name: Update apt cache
      apt:
        update_cache: yes
    - name: Upgrade all apt packages
      apt:
        upgrade: dist
      notify: Reboot
    - name: Autoremove if enabled
      apt:
        autoremove: yes
      when: apt_autoremove | default(false)
  when: ansible_pkg_mgr == 'apt'

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    update_cache: yes
    exclude: "{{ update_excluded_packages | join(' ') }}"
  notify: Reboot
  when: ansible_pkg_mgr in ['dnf', 'dnf5']

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes
    exclude: "{{ update_excluded_packages | join(' ') }}"
  notify: Reboot

- name: Configure yum
  yum:
    name: '*'
    state: latest
    exclude: "{{ update_excluded_packages | join(' ') }}"
    update_cache: yes
  notify: Reboot
  when: ansible_pkg_mgr == 'yum'

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest
    exclude: "{{ update_excluded_packages | join(' ') }}"
    refresh: yes
  notify: Reboot
  when: ansible_pkg_mgr == 'zypper'


