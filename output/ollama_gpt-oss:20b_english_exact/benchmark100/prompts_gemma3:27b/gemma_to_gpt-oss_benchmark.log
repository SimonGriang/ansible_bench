    src: "{{ rke2_config_template | default('templates/rke2-config.yaml.j2') }}"
    dest: "{{ rke2_config_path | default('/etc/rancher/rke2/config.yaml') }}"
    mode: '0644'
  notify: restart rke2
- name: Copy kubelet config
  template:
    src: "{{ rke2_kubelet_config_template | default('templates/kubelet-config.yaml.j2') }}"
    dest: "{{ rke2_kubelet_config_path | default('/etc/rancher/rke2/kubelet-config.yaml') }}"
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: restart rke2
- name: Copy Containerd Registry Configuration file
  template:
    src: "{{ rke2_registry_config_template | default('templates/containerd-registry-config.yaml.j2') }}"
    dest: "{{ rke2_registry_config_path | default('/etc/rancher/rke2/registry-config.yaml') }}"
    mode: '0644'
  when:
    - rke2_custom_registry_mirrors | length > 0
    - rke2_custom_registry_configs | length > 0
  notify: restart rke2
- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
    daemon_reload: true
  register: rke2_service_start
  retries: 5
  delay: 10
  until: rke2_service_start.changed or rke2_service_start.failed
  notify: restart rke2
- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ item }}"
    state: masked
    enabled: false
  loop:
    - rke2-agent
    - rke2-server
  when:
    - (item == 'rke2-agent' and rke2_type == 'server')
    - (item == 'rke2-server' and rke2_type == 'agent')
- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    kubectl get nodes -o json | jq -e '.items[] | \
    select(.status.conditions[] | .type=="Ready" and .status=="True") | \
    select(.status.allocatable.memory | tonumber > 0) | \
    select(.status.allocatable["ephemeral-storage"] | tonumber > 0) | \
    select(.status.allocatable.cpu | tonumber > 0) | \
    select(.metadata.labels["kubernetes.io/hostname"] != "{{ inventory_hostname }}") | \
    .metadata.name' | wc -l
  register: node_ready_count
  retries: 30
  delay: 10
  until: node_ready_count.stdout | int >= expected_node_count
  when:
    - cni == 'none'
    - is_active_server or is_first_server
- name: Wait for remaining nodes to be ready - with CNI
  shell: |
    kubectl get nodes --no-headers | grep -E 'Ready|NotReady' | grep -v 'Ready' | wc -l
  register: node_not_ready_count
  retries: 30
  delay: 10
  until: node_not_ready_count.stdout | int == 0
  when:
    - cni != 'none'
    - is_active_server or is_first_server


