---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- block:
    - name: Install repository for RedHat
      get_url:
        url: https://rpm.releases.hashicorp.com/RHEL/hashicorp.repo
        dest: /etc/yum.repos.d/hashicorp.repo
        mode: '0640'
    - block:
        - name: Install required package gpg
          package:
            name: gpg
            state: present
        - name: Install apt key for Debian
          apt_key:
            url: https://apt.releases.hashicorp.com/gpg
            keyring: /etc/apt/trusted.gpg.d/hashicorp.gpg
            state: present
            validate_certs: no
        - name: Install repository for Debian
          apt_repository:
            repo: "deb [arch={{ hashicorp_architecture_mapping[ansible_architecture] }}] https://apt.releases.hashicorp.com {{ ansible_lsb.codename }} main"
            state: present
      name: Configure debian
      when: ansible_os_family == "Debian"
  name: Install using package
  when: hashicorp_installation_method == "package"

- block:
    - name: Install latest hashicorp product using package
      package:
        name: "{{ item }}"
        state: latest
      loop: "{{ hashicorp_products }}"
      loop_control:
        label: "{{ item }}"
    - name: Install versioned hashicorp product using package
      package:
        name: "{{ item.name }}{{ version_coupler }}{{ item.version }}"
        state: present
      loop: "{{ hashicorp_products }}"
      loop_control:
        label: "{{ item.name }}"
      when: item.version is defined
  name: Install hashicorp product using package
  when: hashicorp_products is defined

- block:
    - name: Install hashicorp product manually
      unarchive:
        src: "{{ hashicorp_src }}/{{ item }}"
        dest: "{{ hashicorp_destination }}"
        group: "{{ hashicorp_group }}"
        mode: "{{ hashicorp_mode }}"
        owner: "{{ hashicorp_owner }}"
        remote_src: yes
      loop: "{{ hashicorp_products }}"
      loop_control:
        label: "{{ item }}"
  name: Install manually
  when: hashicorp_installation_method == "manual"


