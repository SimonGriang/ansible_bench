- name: Import assert tasks
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install docker-compose using a package manager
  package:
    name: docker-compose
    state: present
  when: docker_compose_installation_type == 'package'

- name: Install docker-compose as a binary
  block:
