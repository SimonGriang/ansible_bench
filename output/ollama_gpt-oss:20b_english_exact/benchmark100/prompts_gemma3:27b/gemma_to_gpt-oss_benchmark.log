---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: No configuration
    vtype: string
  when: ansible_os_family == 'Debian'

- name: Install postfix
  apt:
    name: postfix
    state: present
    update_cache: true

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: postfix_mysql_enabled

- name: Configure postfix (transport_maps)
  template:
    src: "{{ transport_maps_template }}"
    dest: /etc/postfix/transport
    owner: root
    group: root
    mode: '0644'
  notify:
    - Validate postfix configuration
    - Rebuild postfix database
  when: transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: "{{ header_checks_template }}"
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: '0644'
  notify:
    - Validate postfix configuration
    - Reload postfix
  when: header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_params: |-
      "{{ postfix_main_cf_params | default({}) | combine(
        {'myhostname': myhostname | default('')}
      ) }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf_params: |-
      "{{ postfix_main_cf_params | combine(
        {'mydomain': mydomain | default('')}
      ) }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    owner: root
    group: root
    mode: '0644'
  notify:
    - Validate postfix configuration
    - Restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: '0644'
  notify:
    - Validate postfix configuration
    - Restart postfix

- name: Creates cert/key directory
  file:
    path: "{{ tls_cert_dir }}"
    state: directory
    owner: root
    group: root
    mode: '0700'
  when: tls_cert_dir is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ tls_cert_source }}"
    dest: "{{ tls_cert_dir }}/server.crt"
    owner: root
    group: root
    mode: '0644'
  when: tls_cert_source is defined and tls_cert_dir is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ tls_key_source }}"
    dest: "{{ tls_cert_dir }}/server.key"
    owner: root
    group: root
    mode: '0600'
  when: tls_key_source is defined and tls_cert_dir is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
    owner: root
    group: root
    mode: '0644'
  notify:
    - Postfix reload

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    owner: root
    group: root
    mode: '0644'
  notify:
    - Postfix reload

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    owner: root
    group: root
    mode: '0644'
  notify:
    - Postfix reload

- name: Place sasl_password_map
  copy:
    content: "{{ sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password_map
    owner: root
    group: root
    mode: '0600'
  notify:
    - Postfix reload

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true


