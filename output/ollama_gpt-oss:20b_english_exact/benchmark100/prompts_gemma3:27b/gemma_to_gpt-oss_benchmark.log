---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'container'
    - bootstrap_wait_for_host | bool

- name: Prepare system
  block:
    - name: Test connection and sudo access
      command: true
      become: yes
  rescue:
    - name: Gather facts
      setup:
    - name: Install bootstrap packages via raw
      raw: "yum -y install {{ bootstrap_facts_packages | join(' ') }}"
      when: ansible_os_family == 'RedHat'
    - name: Ensure libdnf5 is present
      package:
        name: libdnf5
        state: present
      when: ansible_os_family == 'RedHat'

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
  become: "{{ bootstrap_become }}"



