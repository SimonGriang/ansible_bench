---
- name: Restart the RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready
  shell: "{{ rke2_data_path }}/kubectl get nodes --kubeconfig /etc/rancher/rke2/rke2.yaml --no-headers | grep -c Ready"
  register: rke2_wait_nodes
  changed_when: false
  retries: 100
  delay: 15
  until: rke2_wait_nodes.stdout | int == groups[rke2_cluster_group_name] | length
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  run_once: true

- name: Wait for all pods to be ready
  shell: "{{ rke2_data_path }}/kubectl get pods --all-namespaces --no-headers | grep -vE 'Running|Succeeded' | wc -l"
  register: rke2_wait_pods
  changed_when: false
  retries: 100
  delay: 15
  until: rke2_wait_pods.stdout | int == 0
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  run_once: true
  when: rke2_wait_for_all_pods_to_be_ready | bool and not ansible_check_mode


