---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk
    state: present
  environment:
    USE: "some_excluded_features"
  when: java_vendor == "openjdk"

- name: Install RPM
  block:
    - name: Copy RPM to /tmp
      copy:
        src: "{{ java_rpm_path }}"
        dest: /tmp/
        mode: '0644'
    - name: Install RPM package
      yum:
        name: /tmp/{{ java_rpm_path | basename }}
        state: present
  when: java_source == "local" and java_format == "rpm"

- name: Install DEB
  block:
    - name: Copy DEB to /tmp
      copy:
        src: "{{ java_deb_path }}"
        dest: /tmp/
        mode: '0644'
    - name: Install DEB package
      apt:
        deb: /tmp/{{ java_deb_path | basename }}
        state: present
  when: java_source == "local" and java_format == "deb"

- name: Install oracle java (rpm) (repository)
  yum:
    name: "{{ java_package_name }}"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  block:
    - name: Ensure installation directory exists
      file:
        path: "{{ java_install_dir }}"
        state: directory
        mode: '0755'
    - name: Extract Oracle Java archive
      unarchive:
        src: "{{ java_targz_path }}"
        dest: "{{ java_install_dir }}"
        remote_src: true
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_jce_zip_path }}"
    dest: "{{ java_install_dir }}/jre/lib/security"
    remote_src: true
  when: java_jce and java_version == 8 and java_vendor == "oracle"

- name: Set alternative (targz)
  command:
    argv:
      - alternatives
      - --set
      - java
      - "{{ java_install_dir }}/bin/java"
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  block:
    - name: Resolve java symlink
      command: readlink -f /usr/bin/java | xargs dirname | xargs dirname
      register: java_home_cmd
      changed_when: false
    - name: Set JAVA_HOME fact
      set_fact:
        JAVA_HOME: "{{ java_home_cmd.stdout }}"

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME={{ JAVA_HOME }}'
    create: true
    mode: '0755'


