---
- name: "Task 1: Migrate from adoptopenjdk to temurin if selected"
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: "Task 2: Gather OS specific variables"
  include_vars:
    file: >-
      {{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.yml

- name: "Task 3: Gather architecture specific variables"
  include_vars:
    file: architecture.yml

- name: "Task 4: Set OS specific variables (I)"
  set_fact:
    java_open_jdk_version: "{{ java_open_jdk_version | default('11') }}"
    java_required_repositories_openjdk: >-
      {{ java_required_repositories_openjdk | default([]) }}
    java_required_key_repositories_openjdk: >-
      {{ java_required_key_repositories_openjdk | default([]) }}
    java_required_libs_openjdk: >-
      {{ java_required_libs_openjdk | default([]) }}

- name: "Task 5: Set OS and architecture specific variables (II)"
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm') }}"
    java_open_jdk_package: >-
      {{ java_open_jdk_package | default('openjdk-{{ java_open_jdk_version }}-jdk') }}

- name: "Task 6: Set specific variables"
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: "Task 7: Remove deprecated repositories (Debian)"
  apt_repository:
    repo: "{{ item }}"
    state: absent
  loop: "{{ java_deprecated_repositories_adoptopenjdk | default([]) }}"
  when: ansible_os_family == "Debian"

- name: "Task 8: Install extra apt tools (Debian)"
  apt:
    name: "{{ item }}"
    state: present
    update_cache: true
  loop: "{{ java_open_jdk_apt_extra_packages | default([]) }}"
  when: ansible_os_family == "Debian"

- name: "Task 9: Add required key repositories (Debian)"
  apt_key:
    url: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
  when: ansible_os_family == "Debian"

- name: "Task 10: Add required repositories (Debian)"
  apt_repository:
    repo: "{{ item }}"
    state: present
  loop: "{{ java_required_repositories_openjdk | default([]) }}"
  when: ansible_os_family == "Debian"

- name: "Task 11: Add required key repositories (RedHat)"
  yum_key:
    key: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
  when: ansible_os_family == "RedHat"

- name: "Task 12: Add required repositories (RedHat)"
  yum_repository:
    name: "{{ item.name }}"
    description: >-
      {{ item.description | default(omit) }}
    baseurl: >-
      {{ item.baseurl | default(omit) }}
    gpgkey: >-
      {{ item.gpgkey | default(omit) }}
    enabled: >-
      {{ item.enabled | default(1) }}
    gpgcheck: >-
      {{ item.gpgcheck | default(1) }}
    repo_gpgcheck: >-
      {{ item.repo_gpgcheck | default(1) }}
  loop: "{{ java_required_repositories_openjdk | default([]) }}"
  when: ansible_os_family == "RedHat"

- name: "Task 13: Install required libs"
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libs_openjdk | default([]) }}"
  when: ansible_os_family in ['Debian', 'RedHat']

- name: "Task 14: Install Java (Debian)"
  apt:
    name: >-
      {{ java_open_jdk_package }}={{ java_open_jdk_version }}
    state: present
    update_cache: true
  when: ansible_os_family == "Debian"

- name: "Task 15: Install Java (RedHat)"
  yum:
    name: >-
      {{ java_open_jdk_package }}-{{ java_open_jdk_version }}
    state: present
  when: ansible_os_family == "RedHat"

- name: "Task 16: Export environment variables"
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0644'

- name: "Task 17: Source environment variables"
  shell: source /etc/profile
  changed_when: false

- name: "Task 18: Correct java version selected (Debian, Java < 11)"
  alternatives:
    name: java
    path: "{{ java_open_jdk_home_dir }}/bin/java"
    priority: 1
  when:
    - ansible_os_family == "Debian"
    - java_open_jdk_version is defined
    - java_open_jdk_version | int < 11

- name: "Task 19: Correct java version selected (Debian, Java >= 11)"
  alternatives:
    name: java
    path: "{{ java_open_jdk_home_dir }}/bin/java"
    priority: 2
  when:
    - ansible_os_family == "Debian"
    - java_open_jdk_version is defined
    - java_open_jdk_version | int >= 11


