---
- name: Check OS compatibility
  when: |
    (ansible_facts['distribution'] == 'Amazon' and
     ansible_facts['distribution_version'] == '2') or
    (ansible_facts['os_family'] == 'RedHat' and
     ansible_facts['distribution_major_version'] in ['7', '8', '9', '10'])
  block:
    - name: Install epel gpg key
      ansible.builtin.rpm_key:
        state: present
        key: "{{ epel_gpg_key }}"
    - name: Install epel-release package
      ansible.builtin.dnf:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache
    - name: Install epel-next-release package
      ansible.builtin.dnf:
        name: "{{ epel_next_url }}"
        state: present
      when: epel_next
      notify: Update package cache


