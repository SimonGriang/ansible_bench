---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Enable redis module stream (RHEL 8)
  command: dnf module enable redis -y
  when: ansible_os_family == 'RedHat' and ansible_distribution_major_version == '8'

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: "redis.conf-{{ ansible_distribution }}.j2"
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_owner | default('root') }}"
    group: "{{ redis_group | default('root') }}"
    mode: "{{ redis_mode | default('0644') }}"
  notify: Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


