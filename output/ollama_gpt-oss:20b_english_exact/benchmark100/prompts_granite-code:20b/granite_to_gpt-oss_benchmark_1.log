  ansible.builtin.package:
    name: "{{ packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  ansible.builtin.lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_TIMEOUT='
    line: "GRUB_TIMEOUT={{ grub_timeout | default(5) }}"
    state: present

- name: Set GRUB_RECORDFAIL_TIMEOUT
  ansible.builtin.lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_RECORDFAIL_TIMEOUT='
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout | default(5) }}"
    state: present

- name: Add options to GRUB_CMDLINE_LINUX
  ansible.builtin.replace:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX="(.*)"'
    replace: 'GRUB_CMDLINE_LINUX="\1 {{ grub_cmdline_options | default("") }}"'

- name: Import password.yml
  ansible.builtin.import_tasks: password.yml
  when: grub_set_password | bool

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


