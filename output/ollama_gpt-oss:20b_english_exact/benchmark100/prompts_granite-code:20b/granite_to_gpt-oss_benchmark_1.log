---
- name: Create group vault
  ansible.builtin.group:
    name: vault
    state: present

- name: Create user vault
  ansible.builtin.user:
    name: vault
    group: vault
    system: true
    state: present

- name: Create directory /opt/vault
  ansible.builtin.file:
    path: /opt/vault
    state: directory
    owner: vault
    group: vault
    mode: '0755'

- name: Download Vault binary
  ansible.builtin.unarchive:
    src: https://releases.hashicorp.com/vault/1.13.3/vault_1.13.3_linux_amd64.zip  # yamllint disable-line rule:line-length
    dest: /opt/vault
    remote_src: true
    creates: /opt/vault/vault

- name: Create directory /etc/vault.d
  ansible.builtin.file:
    path: /etc/vault.d
    state: directory
    owner: vault
    group: vault
    mode: '0755'

- name: Copy Vault binary
  ansible.builtin.copy:
    src: /opt/vault/vault
    dest: /usr/bin/vault
    mode: '0755'
    owner: root
    group: root

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  community.general.capabilities:
    path: /usr/bin/vault
    capability: cap_ipc_lock=ep
    state: present

- name: Create file /etc/vault.d/vault.env
  ansible.builtin.copy:
    dest: /etc/vault.d/vault.env
    content: ""
    owner: vault
    group: vault
    mode: '0644'

- name: Create directory /usr/lib/systemd/system
  ansible.builtin.file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'

- name: Copy Vault service file
  ansible.builtin.copy:
    src: vault.service
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'

- name: Copy vault configuration
  ansible.builtin.copy:
    src: vault.hcl
    dest: /etc/vault.d/vault.hcl
    owner: vault
    group: vault
    mode: '0640'

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


