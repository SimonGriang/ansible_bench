---
- name: Download and extract bundle
  get_url:
    url: "{{ bundle_url }}"
    dest: "{{ bundle_path }}"
    mode: 0644                # use a numeric mode

- name: Extract bundle
  unarchive:
    src: "{{ bundle_path }}"
    dest: "{{ bundle_dest }}"
    remote_src: true          # remote file
    mode: 0755

- name: Create temporary directory
  tempfile:
    state: directory          # create a directory
    suffix: _bundle
  register: tmp_dir

- name: Copy bundle files to temporary directory
  copy:
    src: "{{ item }}"
    dest: "{{ tmp_dir.path }}/"
    mode: 0644
  with_items:
    - "{{ bundle_dest }}/*"

- name: Set environment variables
  set_fact:
    bundle_env:
      BUNDLE_PATH: "{{ bundle_path }}"
      BUNDLE_DEST: "{{ bundle_dest }}"
      TMP_DIR: "{{ tmp_dir.path }}"

- name: Install bundle
  shell: |
    {{ bundle_env.BUNDLE_PATH }}/bundle.sh \
    {{ bundle_env.BUNDLE_DEST }}/install.sh
  args:
    chdir: "{{ bundle_env.TMP_DIR }}"
    executable: /bin/bash
  environment: "{{ bundle_env }}"
  register: install_output
  ignore_errors: true

- name: Check if bundle installation succeeded
  assert:
    that:
      - install_output.rc == 0
  when: install_output is defined

