---
- name: Install mysql
  apt:
    name: mysql-server
    state: present
    update_cache: yes

- name: Configure mysql server
  mysql_variables:
    name: max_connections
    value: 200
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"

- name: Configure mysql client
  template:
    src: client.cnf.j2
    dest: /etc/mysql/conf.d/client.cnf
    owner: root
    group: root
    mode: '0644'

- name: Initialize mysql
  mysql_db:
    name: "{{ item }}"
    state: import
    target: "/path/to/dump/{{ item }}.sql"
  loop: "{{ mysql_databases }}"

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"

- name: List databases
  shell: mysql -u root -p{{ mysql_root_password }} -e "SHOW DATABASES;"
  register: db_list
  changed_when: false

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.dump }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
    host_all: yes
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


