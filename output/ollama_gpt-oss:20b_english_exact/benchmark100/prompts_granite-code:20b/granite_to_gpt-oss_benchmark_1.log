---
- name: Cordon and Drain the node {{ rke2_node_name }}
  shell: |
    kubectl drain {{ rke2_node_name }} \
      --ignore-daemonsets \
      --delete-local-data \
      --force
  args:
    warn: false
  register: drain_result
  changed_when: drain_result.rc == 0
  failed_when: drain_result.rc not in [0, 1]
  when: rke2_drain_node_during_upgrade | default(true)

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2-server
    state: restarted
    enabled: true

- name: Wait for all nodes to be ready again
  shell: kubectl get nodes --no-headers | grep -v 'NotReady' | wc -l
  register: node_ready_count
  changed_when: false
  retries: 30
  delay: 10
  until: node_ready_count.stdout | int == ansible_play_hosts_all | length

- name: Uncordon the node {{ rke2_node_name }}
  shell: kubectl uncordon {{ rke2_node_name }}
  args:
    warn: false
  when: rke2_drain_node_during_upgrade | default(true)

- name: Wait for all pods to be ready again
  shell: |
    kubectl get pods \
      --all-namespaces \
      --no-headers | grep -v 'Running' | wc -l
  register: pod_ready_count
  changed_when: false
  retries: 30
  delay: 10
  until: pod_ready_count.stdout | int == 0
  when: rke2_wait_for_all_pods_to_be_ready | default(true)

- name: Wait for all pods to pass readiness checks
  shell: |
    kubectl get pods \
      --all-namespaces \
      --no-headers | grep -v 'Running' | grep -v 'Completed' | wc -l
  register: pod_health_count
  changed_when: false
  retries: 30
  delay: 10
