    remote_src: true

- name: Set alternative (targz)
  community.general.alternatives:
    name: java
    path: /opt/oracle/jdk/bin/java
    priority: 1

- name: Find JAVA_HOME
  ansible.builtin.command: readlink -f /usr/bin/java | sed "s:bin/java::"
  register: java_home
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  ansible.builtin.lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME={{ java_home.stdout }}"
    state: present


