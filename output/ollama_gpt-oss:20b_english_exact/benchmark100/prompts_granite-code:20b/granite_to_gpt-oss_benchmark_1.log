---
- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}/.gitconfig"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: "0755"

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: "0644"

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: "0755"

- name: Clone all roles
  git:
    repo: "{{ item }}"
    dest: "{{ git_repository_destination }}/{{ item | basename | regex_replace('\\.git$', '') }}"
    version: master
    force: yes
  loop: "{{ git_repositories }}"
  become: true
  become_user: "{{ git_username }}"


