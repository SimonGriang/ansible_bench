---
- name: "Ensure old versions of Docker are not installed"
  package:
    name: docker
    state: absent

- name: "Add Docker GPG key"
  rpm_key:
    key: https://download.docker.com/linux/centos/gpg
    state: present

- name: "Add Docker repository"
  yum_repository:
    name: docker-ce
    description: Docker CE Repository
    baseurl: https://download.docker.com/linux/centos/8/x86_64/stable
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: 1
    gpgcheck: 1
    repo_gpgcheck: 1

- name: "Configure Docker Nightly repo"
  yum_repository:
    name: docker-ce-nightly
    description: Docker CE Nightly Repository
    baseurl: https://download.docker.com/linux/centos/8/x86_64/nightly
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: 1
    gpgcheck: 1
    repo_gpgcheck: 1

- name: "Configure Docker Test repo"
  yum_repository:
    name: docker-ce-test
    description: Docker CE Test Repository
    baseurl: https://download.docker.com/linux/centos/8/x86_64/test
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: 1
    gpgcheck: 1
    repo_gpgcheck: 1

- name: "Configure containerd on RHEL 8"
  yum:
    name: containerd.io
    state: present


