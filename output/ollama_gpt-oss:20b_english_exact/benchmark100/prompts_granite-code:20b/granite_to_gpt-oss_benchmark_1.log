---
- name: Install Keepalived when HA mode is enabled
  package:
    name: keepalived
    state: present

- name: Download and install RKE2 {{ rke2_version }}
  get_url:
    url: "https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2-installer.sh"
    dest: /tmp/rke2-installer.sh
    mode: '0755'

- name: Download and install RKE2 {{ rke2_version }}
  shell: "/tmp/rke2-installer.sh install --version {{ rke2_version }}"
  args:
    creates: /usr/local/bin/rke2

- name: CIS Hardening
  shell: /usr/local/bin/cis-hardening.sh

- name: Find Active Server
  shell: /usr/local/bin/find-active-server.sh

- name: Enable IPVS kernel module
  modprobe:
    name: ip_vs
    state: present

- name: Copy kube-vip manifests to the masternode
  copy:
    src: kube-vip.yaml
    dest: /etc/kubernetes/manifests/kube-vip.yaml

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: ingress-nginx.yaml
    dest: /etc/kubernetes/manifests/ingress-nginx.yaml

- name: Prepare very first server node in the cluster
  shell: /usr/local/bin/prepare-first-server.sh

- name: Restore etcd specific tasks
  shell: /usr/local/bin/restore-etcd.sh

- name: Download kubeconfig to ansible localhost
  fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: ./kubeconfig
    flat: yes
    mode: '0644'

- name: Prepare and join remaining nodes of the cluster
  shell: /usr/local/bin/join-remaining-nodes.sh

- name: Rolling cordon and drain restart when version changes - servers
  shell: /usr/local/bin/rolling-restart-servers.sh

- name: Rolling cordon and drain restart when version changes - agents
  shell: /usr/local/bin/rolling-restart-agents.sh

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  shell: /usr/local/bin/rolling-restart-config.sh

- name: Final steps
  debug:
    msg: "Cluster setup complete."


