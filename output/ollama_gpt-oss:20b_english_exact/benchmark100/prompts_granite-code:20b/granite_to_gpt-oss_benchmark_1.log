---
- name: password | Get efi path
  ansible.builtin.stat:
    path: "{{ efi_path }}"
  register: efi_path_result

- name: password | Remove unwanted grub.cfg on EFI systems
  ansible.builtin.file:
    path: "{{ efi_path }}/grub.cfg"
    state: absent

- name: password | Install user template
  ansible.builtin.template:
    src: "user_template.j2"
    dest: "/home/{{ ansible_user }}/.config/user.conf"
    mode: '0644'

- name: password | EFI | add password
  ansible.builtin.lineinfile:
    path: "{{ efi_path }}/grub.cfg"
    line: "set superusers=\"{{ username }}\""
    state: present

- name: password | MBR | add password
  ansible.builtin.lineinfile:
    path: "/boot/grub/grub.cfg"
    line: "set superusers=\"{{ username }}\""
    state: present

- name: password | Add --unrestricted
  ansible.builtin.replace:
    path: "/etc/grub.d/40_custom"
    regexp: '(GRUB_CMDLINE_LINUX_DEFAULT=\"[^\"]*)\"'
    replace: '\1 --unrestricted"'


