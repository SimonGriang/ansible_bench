---
- name: Restore etcd - get all nodes
  ansible.builtin.command: >
    kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
  register: node_names
  changed_when: false

- name: Restore etcd - remove old nodes
  ansible.builtin.command: kubectl delete node {{ item }} --ignore-not-found
  loop: "{{ node_names.stdout.split() }}"
  register: delete_nodes
  changed_when: false


