---
- name: Lookup bootstrap facts
  ansible.builtin.command: cat /etc/os-release
  register: bootstrap_os_release_output
  changed_when: false

- name: Set bootstrap facts (I)
  ansible.builtin.set_fact: "{{ item.key }}: {{ item.value }}"
  loop:
    - key: bootstrap_distribution
      value: |
        "{{ bootstrap_os_release_output.stdout |
        regex_search('^ID=([^\\n]+)', '\\1') }}"
    - key: bootstrap_distribution_major_version
      value: |
        "{{ bootstrap_os_release_output.stdout |
        regex_search('^VERSION_ID=([^\\n]+)', '\\1') }}"

- name: Set bootstrap facts (II)
  ansible.builtin.set_fact: "{{ item.key }}: {{ item.value }}"
  loop:
    - key: bootstrap_os_family
      value: |
        "{{ bootstrap_os_release_output.stdout |
        regex_search('^ID_LIKE=([^\\n]+)', '\\1') }}"


