---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install postfix
  ansible.builtin.apt:
    name: postfix-mysql
    state: present
    update_cache: true

- name: Configure postfix (transport_maps)
  ansible.builtin.lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^header_checks'
    line: 'header_checks = regexp:/etc/postfix/header_checks'
    state: present

- name: Setting values for main.cf (1/2)
  ansible.builtin.blockinfile:
    path: /etc/postfix/main.cf
    block: |
      myhostname = mail.example.com
      inet_interfaces = all
    marker: "# {mark} ANSIBLE MANAGED BLOCK - Setting values for main.cf"

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'

- name: Creates cert/key directory
  ansible.builtin.copy:
    src: postfix.crt
    dest: /etc/postfix/certs/postfix.crt
    mode: '0600'
    owner: postfix
    group: postfix

- name: Deploy Postfix TLS server key
  ansible.builtin.meta: flush_handlers

- name: Configure aliases
  ansible.builtin.lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^sender_access'
    line: 'sender_access = regexp:/etc/postfix/sender_access'
    state: present

- name: Configure recipient_access
  ansible.builtin.template:
    src: sasl_password_map.j2
    dest: /etc/postfix/sasl_password_map
    mode: '0600'
    owner: postfix
    group: postfix

- name: Flush handlers again
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: true


