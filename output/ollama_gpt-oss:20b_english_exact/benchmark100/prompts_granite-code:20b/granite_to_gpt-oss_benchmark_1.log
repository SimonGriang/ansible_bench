---
- name: Install Keepalived when HA mode is enabled
  ansible.builtin.package:
    name: keepalived
    state: present

- name: Download and install RKE2 {{ rke2_version }}
  ansible.builtin.get_url:
    # yamllint disable-line rule:line-length
    url: "https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2-installer.sh"
    dest: /tmp/rke2-installer.sh
    mode: '0755'

- name: Download and install RKE2 {{ rke2_version }}
  ansible.builtin.command:
    cmd: "/tmp/rke2-installer.sh install --version {{ rke2_version }}"
    creates: /usr/local/bin/rke2
  changed_when: false

- name: CIS Hardening
  ansible.builtin.command:
    cmd: /usr/local/bin/cis-hardening.sh
  changed_when: false

- name: Find Active Server
  ansible.builtin.command:
    cmd: /usr/local/bin/find-active-server.sh
  changed_when: false

- name: Enable IPVS kernel module
  community.general.modprobe:
    name: ip_vs
    state: present

- name: Copy kube-vip manifests to the masternode
  ansible.builtin.copy:
    src: kube-vip.yaml
    dest: /etc/kubernetes/manifests/kube-vip.yaml
    mode: '0644'

- name: Copy ingress-nginx manifests to the masternode
  ansible.builtin.copy:
    src: ingress-nginx.yaml
    dest: /etc/kubernetes/manifests/ingress-nginx.yaml
    mode: '0644'

- name: Prepare very first server node in the cluster
  ansible.builtin.command:
    cmd: /usr/local/bin/prepare-first-server.sh
  changed_when: false

- name: Restore etcd specific tasks
  ansible.builtin.command:
    cmd: /usr/local/bin/restore-etcd.sh
  changed_when: false

- name: Download kubeconfig to ansible localhost
  ansible.builtin.fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: ./kubeconfig
    flat: true
    mode: '0644'

- name: Prepare and join remaining nodes of the cluster
  ansible.builtin.command:
    cmd: /usr/local/bin/join-remaining-nodes.sh
  changed_when: false

- name: Rolling cordon and drain restart when version changes - servers
  ansible.builtin.command:
    cmd: /usr/local/bin/rolling-restart-servers.sh
  changed_when: false

- name: Rolling cordon and drain restart when version changes - agents
  ansible.builtin.command:
    cmd: /usr/local/bin/rolling-restart-agents.sh
  changed_when: false

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Rolling restart when config files change
  ansible.builtin.command:
    cmd: /usr/local/bin/rolling-restart-config.sh
  changed_when: false

- name: Final steps
  ansible.builtin.debug:
    msg: "Cluster setup complete."



