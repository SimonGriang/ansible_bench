---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install dns
  package:
    name: dns
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ dns_directories }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    state: present

- name: Generate rndc key
  command: rndc-confgen -a -c {{ rndc_key_path }} -k {{ rndc_key_name }} -r 4096
  args:
    creates: "{{ rndc_key_path }}"

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_path }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: "0600"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_hints_url }}"
    dest: "{{ dns_root_path }}"
    mode: "0644"

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ item.dest }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: "0644"
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ named_conf_path }}"

- name: Place systemd override
  template:
    src: systemd_override.j2
    dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: yes


