---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install dns
  ansible.builtin.package:
    name: dns
    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ dns_directories }}"

- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  ansible.builtin.user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    state: present

- name: Generate rndc key
  ansible.builtin.command: rndc-confgen -a -c {{ rndc_key_path }} -k {{ rndc_key_name }} -r 4096
  args:
    creates: "{{ rndc_key_path }}"

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ rndc_key_path }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: "0600"

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ dns_hints_url }}"
    dest: "{{ dns_root_path }}"
    mode: "0644"

- name: Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: "{{ item.dest }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: "0644"
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: "{{ named_conf_path }}"
    mode: "0644"

- name: Place systemd override
  ansible.builtin.template:
    src: systemd_override.j2
    dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
    mode: "0644"

- name: Start and enable dns
  ansible.builtin.service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


