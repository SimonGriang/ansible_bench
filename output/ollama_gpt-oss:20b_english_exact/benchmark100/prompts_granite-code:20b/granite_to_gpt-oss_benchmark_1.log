    content: >-
      {{ openssl_private_key.content | b64decode }}{{ openssl_certifcate.content | b64decode }}
    mode: "{{ openssl_file_mode | default('0644') }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ openssl_certs }}"



