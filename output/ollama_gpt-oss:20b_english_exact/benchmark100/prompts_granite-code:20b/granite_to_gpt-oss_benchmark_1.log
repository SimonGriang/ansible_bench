---  
- name: Download RKE2 installation script  
  get_url:  
    url: "{{ rke2_install_bash_url }}"  
    dest: "{{ rke2_install_script_dir }}/rke2.sh"  
    mode: "0700"  
    timeout: "{{ rke2_artifact_fetch_timeout }}"  

- name: Copy local RKE2 installation script  
  copy:  
    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"  
    dest: "{{ rke2_install_script_dir }}/rke2.sh"  
    mode: "0700"  
    force: yes  

- name: Create RKE2 artifacts folder  
  file:  
    path: "{{ rke2_artifact_path }}"  
    state: directory  
    mode: "0700"  

- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)  
  shell: |
    set -e
    curl -fL "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt" -o "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
    for file in rke2-server rke2-agent rke2ctl; do
      curl -fL "{{ rke2_artifact_url }}/{{ rke2_version }}/${file}" -o "{{ rke2_artifact_path }}/${file}"
    done
    curl -fL "{{ rke2_install_bash_url }}" -o "{{ rke2_install_script_dir }}/rke2.sh"
    chmod 0700 "{{ rke2_install_script_dir }}/rke2.sh"
  args:
    creates: "{{ rke2_install_script_dir }}/rke2.sh"  
  timeout: "{{ rke2_artifact_fetch_timeout }}"  

- name: Copy local RKE2 artifacts  
  copy:  
    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"  
    dest: "{{ rke2_artifact_path }}/{{ item }}"  
    mode: "0640"  
    force: yes  
  loop: "{{ rke2_artifact_files }}"  

- name: Airgap mode - additional images tarballs  
  block:  
    - name: Create additional images tarballs folder  
      file:  
        path: "{{ rke2_tarball_images_path }}"  
        state: directory  
        mode: "0700"  
    - name: Copy additional tarball images RKE2 components  
      copy:  
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"  
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"  
        mode: "0644"  
        force: yes  
      loop: "{{ rke2_tarball_images }}"  
  when: rke2_airgap_mode and rke2_tarball_images | length > 0  

- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged  
  block:  
    - name: Register artifact  
      stat:  
        path: "{{ rke2_artifact_path }}/{{ item }}"  
      register: artifact_stat  
    - name: Make artifact read-only if writable  
      file:  
        path: "{{ rke2_artifact_path }}/{{ item }}"  
        mode: "0640"  
      when: artifact_stat.stat.mode is defined and ((artifact_stat.stat.mode | int(8)) & 2) != 0  
    - name: Register install script  
      stat:  
        path: "{{ rke2_install_script_dir }}/rke2.sh"  
      register: script_stat  
    - name: Make install script executable if writable and not executable  
      file:  
        path: "{{ rke2_install_script_dir }}/rke2.sh"  
        mode: "0700"  
      when: script_stat.stat.mode is defined and ((script_stat.stat.mode | int(8)) & 2) != 0 and ((script_stat.stat.mode | int(8)) & 1) == 0  
    - name: Fail if install script not executable  
      fail:  
        msg: "RKE2 install script is not executable."  
      when: script_stat.stat.mode is defined and ((script_stat.stat.mode | int(8)) & 1) == 0  
  loop: "{{ rke2_artifact_files }}"  
  when: rke2_airgap_mode and rke2_airgap_implementation == 'exists'  

- name: Populate service facts  
  service_facts:  

- name: Get stats of the FS object  
  stat:  
    path: /usr/local  
  register: local_fs_stat  

- name: Check if separate partition  
  debug:  
    msg: "Separate partition detected"  
  when: local_fs_stat.stat.dev != (stat_result.stat.dev if stat_result is defined else 'unknown')  

- name: Set RKE2 bin path  
  set_fact:  
    rke2_bin_path: "/usr/local/bin"  

- name: Check RKE2 version  
  command: rke2 --version  
  register: rke2_version_result  

- name: Prevent accidental RKE2 downgrade  
  assert:  
    that: rke2_version_result.stdout contains rke2_version  

- name: Run RKE2 install script  
  shell: "{{ rke2_install_script_dir }}/rke2.sh {{ rke2_install_options | default('') }}"  
  args:  
    executable: /bin/bash  

- name: Copy Custom Manifests  
  copy:  
    src: "{{ item }}"  
    dest: "{{ rke2_data_path }}/server/manifests/"  
    owner: root  
    group: root  
    mode: "0644"  
  loop: "{{ rke2_custom_manifests }}"  

- name: Copy Static Pods  
  copy:  
    src: "{{ item }}"  
    dest: "{{ rke2_data_path }}/agent/pod-manifests/"  
    owner: root  
    group: root  
    mode: "0644"  
  loop: "{{ rke2_static_pods }}"  

- name: Copy RKE2 environment file  
  template:  
    src: rke2_environment.j2  
    dest: "/etc/default/rke2-{{ rke2_type }}"  
    owner: root  
    group: root  
    mode: "0644"  


