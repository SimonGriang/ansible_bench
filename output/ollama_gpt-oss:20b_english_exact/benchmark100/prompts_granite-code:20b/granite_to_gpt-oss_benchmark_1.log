---
- name: Install mysql
  ansible.builtin.apt:
    name: mysql-server
    state: present
    update_cache: true

- name: Configure mysql server
  community.mysql.mysql_variables:
    variable: max_connections
    value: 200
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"

- name: Configure mysql client
  ansible.builtin.template:
    src: client.cnf.j2
    dest: /etc/mysql/conf.d/client.cnf
    owner: root
    group: root
    mode: '0644'

- name: Initialize mysql
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: import
    target: "/path/to/dump/{{ item }}.sql"
  loop: "{{ mysql_databases }}"

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: '0644'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"

- name: List databases
  ansible.builtin.shell: mysql -u root -p{{ mysql_root_password }} -e "SHOW DATABASES;"
  register: db_list
  changed_when: false

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.dump }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
    host_all: true
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


