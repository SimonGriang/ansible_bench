---
- name: Install fail2ban
  package:
    name: fail2ban
    state: present

- name: Copy filters in filter.d
  copy:
    src: "{{ role_path }}/files/fail2ban/filter.d/"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: '0640'

- name: Configure fail2ban.local
  ini_file:
    dest: /etc/fail2ban/fail2ban.local
    section: DEFAULT
    option: "{{ item.key }}"
    value: "{{ item.value }}"
  loop: "{{ fail2ban_local_options }}"

- name: Configure jail.local
  ini_file:
    dest: /etc/fail2ban/jail.local
    section: DEFAULT
    option: "{{ item.key }}"
    value: "{{ item.value }}"
  loop: "{{ jail_local_options }}"

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
  register: auth_log_stat

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    owner: root
    group: root
    mode: '0644'
  when: not auth_log_stat.stat.exists

- name: Start and enable fail2ban
  service:
    name: fail2ban
    state: started
    enabled: yes


