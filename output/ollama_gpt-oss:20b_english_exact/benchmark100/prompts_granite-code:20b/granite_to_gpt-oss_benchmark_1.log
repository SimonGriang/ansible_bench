---
- name: Disable swap
  ansible.builtin.command: swapoff -a
  changed_when: false
  tags: core

- name: Disable core dumps
  ansible.posix.sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    reload: true
  loop:
    - {name: fs.suid_dumpable, value: 0}
    - {name: kernel.core_pattern, value: /dev/null}
  tags: core

- name: Disable Shell Command History
  ansible.builtin.blockinfile:
    path: /etc/profile
    block: |
      HISTSIZE=0
      HISTFILE=
    create: true
    mode: "0644"
  tags: core


