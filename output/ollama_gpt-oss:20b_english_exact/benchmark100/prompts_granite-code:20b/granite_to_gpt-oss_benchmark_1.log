---
- name: "Task 1: create directories"
  ansible.builtin.file:
    path: /opt/cadvisor
    state: directory
    mode: '0755'

- name: "Task 2: download"
  ansible.builtin.get_url:
    url: "{{ cadvisor_url_part1 }}{{ cadvisor_url_part2 }}"
    dest: /opt/cadvisor/cadvisor-0.37.0
    checksum: "{{ cadvisor_checksum }}"
    mode: '0644'
  vars:
    # yamllint disable rule=line-length
    cadvisor_url_part1: >-
      https://github.com/google/cadvisor/releases/download/v0.37.0/
    cadvisor_url_part2: cadvisor-0.37.0.linux-arm64.tar.gz
    cadvisor_checksum: >-
      sha256:66134d860a6f690760368235395766608d908d7439654425793356e66e302f8a
    # yamllint enable rule=line-length

- name: "Task 3: propagate locally distributed cadvisor binary"
  ansible.builtin.copy:
    src: /home/dev/bin/cadvisor/cadvisor-0.37.0
    dest: /opt/cadvisor/cadvisor-0.37.0
    mode: '0755'

- name: "Task 4: symlink"
  ansible.builtin.file:
    src: /opt/cadvisor/cadvisor-0.37.0
    dest: /opt/cadvisor/cadvisor
    state: link

- name: "Task 5: server systemd service"
  ansible.builtin.template:
    src: systemd-system-cadvisor-service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'

- name: "Task 6: test_task"
  ansible.builtin.service_facts:
  register: service_active

- name: "Task 7: debug"
  ansible.builtin.debug:
    var: service_active

- name: "Task 8: enable server systemd"
  ansible.builtin.systemd:
    name: cadvisor.service
    enabled: true

- name: "Task 9: start server systemd"
  ansible.builtin.systemd:
    name: cadvisor.service
    state: started
    daemon_reload: true


