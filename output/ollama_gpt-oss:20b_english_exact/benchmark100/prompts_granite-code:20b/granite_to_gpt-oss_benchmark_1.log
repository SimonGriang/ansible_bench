---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  package:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/default/cron
    regexp: '^CRON_SHELL='
    line: 'CRON_SHELL=/usr/bin/bash'
    state: present

- name: Configure path
  lineinfile:
    path: /etc/default/cron
    regexp: '^CRON_PATH='
    line: 'CRON_PATH=/usr/local/bin:/usr/bin:/bin'
    state: present

- name: Configure mailto
  lineinfile:
    path: /etc/default/cron
    regexp: '^CRON_MAILTO='
    line: 'CRON_MAILTO=admin@example.com'
    state: present

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: true

- name: Schedule requested cron jobs
  cron:
    name: "Example cron job"
    minute: "0"
    hour: "*/6"
    job: "/usr/local/bin/backup.sh"
    state: present


