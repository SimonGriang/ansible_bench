---
- name: Create group vault
  group:
    name: vault
    state: present

- name: Create user vault
  user:
    name: vault
    group: vault
    system: true
    state: present

- name: Create directory /opt/vault
  file:
    path: /opt/vault
    state: directory
    owner: vault
    group: vault
    mode: '0755'

- name: Download Vault binary
  unarchive:
    src: https://releases.hashicorp.com/vault/1.13.3/vault_1.13.3_linux_amd64.zip
    dest: /opt/vault
    remote_src: yes
    creates: /opt/vault/vault

- name: Create directory /etc/vault.d
  file:
    path: /etc/vault.d
    state: directory
    owner: vault
    group: vault
    mode: '0755'

- name: Copy Vault binary
  copy:
    src: /opt/vault/vault
    dest: /usr/bin/vault
    mode: '0755'
    owner: root
    group: root

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  capabilities:
    path: /usr/bin/vault
    capability: cap_ipc_lock=ep
    state: present

- name: Create file /etc/vault.d/vault.env
  copy:
    dest: /etc/vault.d/vault.env
    content: ""
    owner: vault
    group: vault
    mode: '0644'

- name: Create directory /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'

- name: Copy Vault service file
