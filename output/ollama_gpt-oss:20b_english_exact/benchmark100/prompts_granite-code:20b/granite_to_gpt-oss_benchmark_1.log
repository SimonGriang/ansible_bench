---
- name: create | Create ssl key
  community.crypto.openssl_privatekey:
    path: ssl.key
    size: 2048
    type: RSA

- name: create | Create ssl csr
  community.crypto.openssl_csr:
    path: ssl.csr
    privatekey_path: ssl.key
    common_name: example.com
    country_name: US
    organization_name: Example Org

- name: create | Create ssl certificates
  community.crypto.x509_certificate:
    path: ssl.crt
    csr_path: ssl.csr
    privatekey_path: ssl.key
    provider: selfsigned
    selfsigned_not_after: 365

- name: create | Create PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: ssl.p12
    privatekey_path: ssl.key
    certificate_path: ssl.crt
    passphrase: changeme

- name: create | Read private key
  ansible.builtin.slurp:
    src: ssl.key
  register: private_key_content

- name: create | Read certificate
  ansible.builtin.slurp:
    src: ssl.crt
  register: certificate_content

- name: create | Create combined private_key and certificate file
  ansible.builtin.copy:
    content: |
      {{ private_key_content.content | b64decode }}
      {{ certificate_content.content | b64decode }}
    dest: ssl_combined.pem
    mode: '0600'


