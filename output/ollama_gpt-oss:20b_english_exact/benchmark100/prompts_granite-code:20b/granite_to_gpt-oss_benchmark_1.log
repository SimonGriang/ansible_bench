- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
  register: python3_11_externally_managed

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  command: mv /usr/lib/python3.11/EXTERNALLY-MANAGED /usr/lib/python3.11/EXTERNALLY-MANAGED.bak
  when: python3_11_externally_managed.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
  register: python3_12_externally_managed

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  command: mv /usr/lib/python3.12/EXTERNALLY-MANAGED /usr/lib/python3.12/EXTERNALLY-MANAGED.bak
  when: python3_12_externally_managed.stat.exists

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install python pip
  package:
    name: python3-pip
    state: present

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    line: "proxy = {{ pip_proxy }}"
    create: yes

- name: Trust hosts
  lineinfile:
    path: /etc/apt/apt.conf.d/99trust
    line: 'Acquire::https::Verify-Peer "false";'
    create: yes

- name: Update pip
  pip:
    name: pip
    state: latest

- name: Install requested modules
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_modules }}"


