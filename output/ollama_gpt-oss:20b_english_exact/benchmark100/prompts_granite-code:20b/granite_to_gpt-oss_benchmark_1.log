---
- name: Create the RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  lineinfile:
    path: /etc/rancher/rke2/config.yaml
    regexp: '^taint:'
    line: "taint: node-role.kubernetes.io/master:NoSchedule"
    create: true
  when: rke2_node_type == 'server'

- name: Set agent taints
  lineinfile:
    path: /etc/rancher/rke2/config.yaml
    regexp: '^taint:'
    line: "taint: node-role.kubernetes.io/worker:NoSchedule"
    create: true
  when: rke2_node_type == 'agent'

- name: Copy RKE2 config
  copy:
    src: templates/rke2-config.yaml
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'

- name: Copy kubelet config
  copy:
    src: templates/kubelet-config.yaml
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0644'
  when: kubelet_config_present

- name: Copy Containerd Registry Configuration file
  copy:
    src: templates/containerd-registry.yaml
    dest: /etc/rancher/rke2/containerd-registry.yaml
    mode: '0644'
  when: custom_registry

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: "rke2-{{ rke2_node_type }}.service"
    state: started
    enabled: true
  when: rke2_node_type in ['server', 'agent']

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ 'rke2-agent.service' if rke2_node_type == 'server' else 'rke2-server.service' }}"
    state: masked
  when: rke2_node_type in ['server', 'agent']

- name: Wait for remaining nodes to be ready - no CNI
  command: |
    kubectl wait --for=condition=Ready node --all --timeout=600s
  when: not cni_enabled

- name: Wait for remaining nodes to be ready - with CNI
  command: |
    kubectl wait --for=condition=Ready node --all --timeout=600s
  when: cni_enabled


