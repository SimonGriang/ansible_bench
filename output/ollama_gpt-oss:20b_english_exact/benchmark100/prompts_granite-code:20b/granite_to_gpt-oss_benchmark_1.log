---
- name: Remove EXTERNALLY-MANAGED file if we're on Debian12
  ansible.builtin.file:
    path: /etc/apt/apt.conf.d/EXTERNALLY-MANAGED
    state: absent
  when:
    - ansible_facts.os_family == 'Debian'
    - ansible_facts.distribution_version == '12'
    - lookup('pipe', 'python3 --version') | regex_search('Python 3\\.11')

- name: debian12 | Get python3 version installed
  ansible.builtin.command: python3 --version
  register: python3_version
  changed_when: false

- name: debian12 | Remove EXTERNALLY-MANAGED
  ansible.builtin.file:
    path: /etc/apt/apt.conf.d/EXTERNALLY-MANAGED
    state: absent
  when:
    - ansible_facts.os_family == 'Debian'
    - ansible_facts.distribution_version == '12'
    - python3_version.stdout is defined
    - python3_version.stdout | regex_search('Python 3\\.11')


