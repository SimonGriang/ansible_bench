- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install logrotate
  ansible.builtin.package:
    name: logrotate
    state: present

- name: Configure logrotate
  ansible.builtin.template:
    src: logrotate.conf.j2
    dest: /etc/logrotate.conf
    mode: '0644'

