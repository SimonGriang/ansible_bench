---
- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk-11-jdk
    state: present

- name: Install RPM
  yum:
    name: my-rpm-package
    state: present

- name: Install DEB
  apt:
    name: my-deb-package
    state: present
    update_cache: yes

- name: Install oracle java (rpm) (repository)
  yum:
    name: oracle-java
    state: present
    enablerepo: oraclejava

- name: Configure oracle targz
  unarchive:
    src: /tmp/oracle-java.tar.gz
    dest: /opt/oracle
    remote_src: yes

- name: Install oracle java policy software (targz)
  unarchive:
    src: /tmp/oracle-java-policy.tar.gz
    dest: /opt/oracle/policy
    remote_src: yes

- name: Set alternative (targz)
  alternatives:
    name: java
    path: /opt/oracle/jdk/bin/java
    priority: 1

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java | sed "s:bin/java::"
  register: java_home
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME={{ java_home.stdout }}"
    state: present


