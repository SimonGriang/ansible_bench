---
- name: >
    Set fact java_jdk_vendor to temurin if java_jdk_vendor equals adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: >
    Include OS specific variables based on java_jdk_vendor, ansible_distribution,
    and ansible_distribution_major_version
  include_vars:
    file: >-
      "{{ java_jdk_vendor }}/{{ ansible_distribution }}{{ ansible_distribution_major_version }}.yml"

- name: >
    Include architecture specific variables
  include_vars:
    file: >-
      "{{ java_jdk_vendor }}/{{ ansible_architecture }}.yml"

- name: >
    Set OS specific variables (I)
  set_fact:
    java_open_jdk_home_dir: "/usr/lib/jvm/{{ java_jdk_vendor }}-{{ java_open_jdk_version_major }}"

- name: >
    Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "/usr/lib/jvm/{{ java_jdk_vendor }}-{{ java_open_jdk_version_major }}-{{ ansible_architecture }}"

- name: >
    Set specific variables
  set_fact:
    java_home: "/usr/lib/jvm/{{ java_jdk_vendor }}-{{ java_open_jdk_version_major }}"

- name: >
    Add pre-requisites for Debian if ansible_os_family equals Debian
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - software-properties-common
    state: present
    update_cache: true
  when: ansible_os_family == 'Debian'

- name: >
    Add pre-requisites for RedHat if ansible_os_family equals RedHat
  yum:
    name:
      - wget
      - unzip
    state: present
  when: ansible_os_family == 'RedHat'

- name: >
    Install required libs
  package:
    name:
      - libx11-6
      - libxext6
    state: present

- name: >
    Install Java, Debian if ansible_os_family equals Debian
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
    update_cache: true
  when: ansible_os_family == 'Debian'

- name: >
    Install Java, RedHat if ansible_os_family equals RedHat
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: >
    Export environment variables
  copy:
    dest: /etc/profile.d/java.sh
    content: |
      export JAVA_HOME={{ java_home }}
      export PATH=$JAVA_HOME/bin:$PATH
    mode: '0644'

- name: >
    Source environment variables
  shell: source /etc/profile.d/java.sh

- name: >
    Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
    in java < 11 if ansible_os_family equals Debian
    and java_open_jdk_version_major is less than 11
  file:
    path: "{{ java_open_jdk_home_dir }}/jre/bin/java"
    state: link
    src: "{{ java_open_jdk_home_dir }}/bin/java"
  when:
    - ansible_os_family == 'Debian'
    - java_open_jdk_version_major | int < 11

- name: >
    Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java
    in java >= 11 if ansible_os_family equals Debian
    and java_open_jdk_version_major is greater than or equal to 11
  file:
    path: "{{ java_open_jdk_home_dir }}/bin/java"
    state: link
    src: "{{ java_open_jdk_home_dir }}/bin/java"
  when:
    - ansible_os_family == 'Debian'
    - java_open_jdk_version_major | int >= 11


