---
- name: Ensure unzip package is available
  package:
    name: unzip
    state: present

- name: Create promtail group
  group:
    name: promtail
    state: present

- name: Create the promtail user
  user:
    name: promtail
    group: promtail
    state: present

- name: Ensure directory /usr/local/bin exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Ensure directories exist
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /etc/promtail
    - /var/log/promtail

- name: Ensure directories exist
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /opt/promtail

- name: Stat path
  stat:
    path: /usr/local/bin/promtail
  register: promtail_bin

- name: Download url
  get_url:
    url: "{{ promtail_url }}"
    dest: /tmp/promtail.tar.gz
    mode: '0644'

- name: Copy src
  copy:
    src: /tmp/promtail.tar.gz
    dest: /tmp/promtail.tar.gz
    mode: '0644'

- name: Download url to localhost
  get_url:
    url: "{{ promtail_url }}"
    dest: /tmp/promtail.tar.gz
    mode: '0644'
  delegate_to: localhost

- name: Copy src
  copy:
    src: /tmp/promtail.tar.gz
    dest: /tmp/promtail.tar.gz
    mode: '0644'

- name: Unarchive src
  unarchive:
    src: /tmp/promtail.tar.gz
    dest: /opt/promtail
    remote_src: yes
    copy: no
    creates: /opt/promtail/promtail

- name: Create symlink /usr/local/bin/promtail
  file:
    src: /opt/promtail/promtail
    dest: /usr/local/bin/promtail
    state: link

- name: Template src
  template:
    src: promtail.yml.j2
    dest: /etc/promtail/promtail.yml
    mode: '0644'

- name: Template src
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'


