- name: Fetch kubeconfig
  ansible.builtin.fetch:
    src: "{{ server_kubeconfig | dirname }}/server.kubeconfig"
    dest: "./{{ inventory_hostname }}"
    flat: true
  register: fetched_kubeconfig
- name: Fail if fetch failed
  ansible.builtin.fail:
    msg: "Failed to fetch kubeconfig from {{ inventory_hostname }}"
  when: fetched_kubeconfig.failed
- name: Replace loopback IP by master server IP
  ansible.builtin.replace:
    path: "{{ rke2_download_k8s_server_ip | dirname }}/server.kubeconfig"
    regexp: "127\\.0\\.0\\.1|\\[::1\\]"
    replace: "{{ rke2_download_k8s_server_ip | dirname | replace('.kubeconfig', '') | replace('/', '') | replace('-', '') }}"
  delegate_to: localhost
  become: false
  when:
    - not ansible_check_mode
    - rke2_download_k8s_server_ip | bool
    - inventory_hostname == groups[rke2_servers_group_name][0]


