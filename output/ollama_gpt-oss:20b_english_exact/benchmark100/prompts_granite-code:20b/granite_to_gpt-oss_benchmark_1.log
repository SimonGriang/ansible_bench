---
- name: Task 1: Update apt cache
  apt:
    update_cache: yes

- name: Task 2: Update dnf cache
  dnf:
    update_cache: yes

- name: Task 3: Install packages
  package:
    name: keepalived
    state: present

- name: Task 4: Create directory for keepalived
  file:
    path: /etc/keepalived
    state: directory
    mode: '0755'

- name: Task 5: Create Kubernetes API health check script for Debian OS family
  file:
    path: /usr/local/bin/k8s_api_health_check.sh
    state: touch
    mode: '0755'

- name: Task 6: Create Kubernetes API health check script for RedHat OS famliy
  file:
    path: /usr/local/bin/k8s_api_health_check.sh
    state: touch
    mode: '0755'

- name: Task 7: Create RKE2 Server health check script for Debian OS family
  file:
    path: /usr/local/bin/rke2_server_health_check.sh
    state: touch
    mode: '0755'

- name: Task 8: Create RKE2 Server health check script for RedHat OS family
  file:
    path: /usr/local/bin/rke2_server_health_check.sh
    state: touch
    mode: '0755'

- name: Task 9: Create keepalived config file
  copy:
    dest: /etc/keepalived/keepalived.conf
    content: |
      # keepalived configuration
    mode: '0644'

- name: Task 10: Enable keepalived and make sure it is not masked
  systemd:
    name: keepalived
    enabled: yes
    masked: no
    state: started

- name: Task 11: Flush handlers
  meta: flush_handlers


