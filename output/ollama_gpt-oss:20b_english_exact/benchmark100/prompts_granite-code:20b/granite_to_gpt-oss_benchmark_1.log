---
- name: Create the RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    rke2_server_taints: "{{ rke2_server_node_taints }}"

- name: Copy rke2 config
  copy:
    src: "{{ rke2_config_source }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0600'

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_source }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0600'
  when:
    - rke2_kubelet_config is defined
    - rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_registry_config_source }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0600'
  when:
    - rke2_custom_registry_mirrors is defined
    - rke2_custom_registry_mirrors | length > 0
    - rke2_custom_registry_configs is defined
    - rke2_custom_registry_configs | length > 0

- name: Register etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file | length > 0 and (ansible_facts.services['rke2-server.service'].state | default('inactive')) == 'inactive' }}"

- name: Register etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined }}"

- name: Restore etcd from file
  block:
    - name: Create etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/server/db/etcd/snapshots
        state: directory
        mode: '0755'
    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/etcd/snapshots/
        mode: '0600'
    - name: Restore etcd from snapshot
      command: >
        rke2 server --restore-etcd /var/lib/rancher/rke2/server/db/etcd/snapshots/{{ rke2_etcd_snapshot_file | basename }}
  when: do_etcd_restore

- name: Restore etcd from s3
  command: >
    rke2 server
    --restore-s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }}
    --restore-s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }}
    --restore-s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }}
    --restore-s3-snapshot-name={{ rke2_etcd_snapshot_s3_options.snapshot_name }}
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server
    state: started
    enabled: yes
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent
    state: masked
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Wait for the first server be ready - no CNI
  shell: |
    while true; do
      mem=$(free -m | awk '/Mem:/ {print $4}');
      disk=$(df / | tail -1 | awk '{print $4}');
      pids=$(ps -e | wc -l);
      if [ "$mem" -gt 100 ] && [ "$disk" -gt 1000 ] && [ "$pids" -gt 50 ]; then break; fi
      sleep 5;
    done
  args:
    executable: /bin/bash
  register: wait_no_cni
  until: wait_no_cni.rc == 0
  retries: 60
  delay: 5
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Wait for the first server be ready - with CNI
  shell: |
    while true; do
      status=$(systemctl status rke2-server | grep "Active:" | awk '{print $2}');
      if [ "$status" == "active" ]; then
        ready=$(rke2 kubectl get nodes --no-headers | grep -c "Ready");
        if [ "$ready" -gt 0 ]; then break; fi
      fi
      sleep 5;
    done
  args:
    executable: /bin/bash
  register: wait_with_cni
  until: wait_with_cni.rc == 0
  retries: 60
  delay: 5
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Restore etcd
  block:
    - name: Remove old node password secrets
      command: >
        rke2 kubectl delete secret {{ inventory_hostname }}.node-password.rke2 -n kube-system
      ignore_errors: yes
    - name: Remove old node
      command: >
        rke2 kubectl delete node {{ inventory_hostname }}
      ignore_errors: yes
    - name: Execute rke2 server command to remove old nodes and secrets
      command: rke2 server --remove-node {{ inventory_hostname }}
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ groups[rke2_cluster_group_name][0] }}"
  delegate_facts: true



