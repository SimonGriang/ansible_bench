- name: Import assert.yml
  import_tasks: assert.yml

- name: Install python pip
  package:
    name: python-pip
    state: present

- name: Configure pip proxy
  ini_file:
    path: /etc/pip.conf
    section: global
    option: proxy
    value: "{{ pip_proxy }}"

- name: Trust hosts
  ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ trusted_hosts }}"

- name: Update pip
  pip:
    name: pip
    state: latest

- name: Install requested modules
  pip:
    name: "{{ requested_modules }}"
