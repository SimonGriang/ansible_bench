- name: Install requirements
  ansible.builtin.package:
    name: bash
    state: present

- name: Install openjdk java (package)
  ansible.builtin.package:
    name: openjdk-11-jdk
    state: present

- name: Install RPM
  ansible.builtin.dnf:
    name: mypackage.rpm
    state: present

- name: Install DEB
  ansible.builtin.apt:
    name: mypackage.deb
    state: present
    update_cache: true

- name: Install oracle java (rpm) (repository)
  ansible.builtin.dnf:
    name: oracle-java8-installer
    state: present

- name: Configure oracle targz
  ansible.builtin.unarchive:
    src: /tmp/oracle-java.tgz
    dest: /opt
    remote_src: true

- name: Install oracle java policy software (targz)
  ansible.builtin.unarchive:
