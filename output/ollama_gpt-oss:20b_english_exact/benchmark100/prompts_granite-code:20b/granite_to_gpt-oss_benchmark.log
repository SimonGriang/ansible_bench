---
- name: password | Get efi path
  ansible.builtin.stat:
    path: /boot/efi
  register: efi_path_stat

- name: password | Remove unwanted grub.cfg on EFI systems
  ansible.builtin.file:
    path: "{{ efi_path_stat.stat.path }}/grub.cfg"
    state: absent

- name: password | Install user template
  ansible.builtin.template:
    src: user_template.j2
    dest: /etc/user.conf
    mode: '0644'

- name: password | EFI | add password
  ansible.builtin.lineinfile:
    path: "{{ efi_path_stat.stat.path }}/config.txt"
    line: "password=secret"
    state: present

- name: password | MBR | add password
  ansible.builtin.lineinfile:
    path: /boot/grub/grub.cfg
    line: "password=secret"
    state: present

- name: password | Add --unrestricted
  ansible.builtin.replace:
    path: /etc/somefile
    regexp: '^(.*)$'
    replace: '\1 --unrestricted'


