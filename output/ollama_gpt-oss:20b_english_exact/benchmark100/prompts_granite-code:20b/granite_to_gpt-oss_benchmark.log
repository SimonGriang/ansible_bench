---
- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2
    state: restarted
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  shell: kubectl get nodes --no-headers | grep -v 'Ready'
  register: node_status
  failed_when: false
  changed_when: false
  until: node_status.stdout == ""
  retries: 30
  delay: 10

- name: Wait for all pods to be ready again
  shell: kubectl get pods --all-namespaces --no-headers | grep -vE 'Running|Succeeded'
  register: pod_status
  failed_when: false
  changed_when: false
  until: pod_status.stdout == ""
  retries: 30
  delay: 10


