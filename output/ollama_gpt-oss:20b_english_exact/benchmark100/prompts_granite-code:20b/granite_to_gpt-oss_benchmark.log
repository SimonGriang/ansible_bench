---
- name: Set fact java_jdk_vendor to temurin if java_jdk_vendor equals adoptopenjdk
  ansible.builtin.set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Include OS specific variables based on java_jdk_vendor, ansible_distribution, and ansible_distribution_major_version
  ansible.builtin.include_vars:
    file: >-
      "{{ java_jdk_vendor }}/{{ ansible_distribution | lower }}_{{ ansible_distribution_major_version }}.yml"

- name: Include architecture specific variables
  ansible.builtin.include_vars:
    file: "{{ ansible_architecture }}.yml"

- name: Set OS specific variables (I)
  ansible.builtin.set_fact:
    os_specific_variables: >-
      "{{ os_specific_variables | default({}) }}"

- name: Set OS and architecture specific variables (II)
  ansible.builtin.set_fact:
    os_arch_specific_variables: >-
      "{{ os_arch_specific_variables | default({}) }}"

- name: Set specific variables
  ansible.builtin.set_fact:
    specific_variables: >-
      "{{ specific_variables | default({}) }}"

- name: Add pre-requisites for Debian if ansible_os_family equals Debian
  ansible.builtin.apt:
    name: "{{ java_debian_pre_reqs }}"
    state: present
  when: ansible_os_family == 'Debian'

- name: Add pre-requisites for RedHat if ansible_os_family equals RedHat
  ansible.builtin.yum:
    name: "{{ java_redhat_pre_reqs }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  ansible.builtin.package:
    name: "{{ java_libs }}"
    state: present

- name: Install Java, Debian if ansible_os_family equals Debian
  ansible.builtin.apt:
    name: "{{ java_debian_package }}"
    state: present
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat if ansible_os_family equals RedHat
  ansible.builtin.yum:
    name: "{{ java_redhat_package }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  ansible.builtin.shell: |
    echo 'export JAVA_HOME={{ java_home }}' >> /etc/profile.d/java.sh
    echo 'export PATH=$JAVA_HOME/bin:$PATH' >> /etc/profile.d/java.sh
  args:
    creates: /etc/profile.d/java.sh

- name: Source environment variables
  ansible.builtin.shell: |
    source /etc/profile.d/java.sh
  args:
    executable: /bin/bash

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11 if ansible_os_family equals Debian and java_open_jdk_version_major is less than 11
  ansible.builtin.command: |
    ln -sf /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java
  args:
    creates: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java
  when:
    - ansible_os_family == 'Debian'
    - java_open_jdk_version_major | int < 11

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11 if ansible_os_family equals Debian and java_open_jdk_version_major is greater than or equal to 11
  ansible.builtin.command: |
    ln -sf /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
  args:
    creates: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
  when:
    - ansible_os_family == 'Debian'
    - java_open_jdk_version_major | int >= 11


