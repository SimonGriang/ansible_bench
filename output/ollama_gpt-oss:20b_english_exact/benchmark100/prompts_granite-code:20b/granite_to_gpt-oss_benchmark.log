---
- name: Create directories
  ansible.builtin.file:
    path: /opt/cadvisor
    state: directory
    mode: '0755'

- name: Download
  ansible.builtin.get_url:
    url: |
      https://github.com/google/cadvisor/releases/download/v0.37.0/cadvisor-0.37.0.linux-arm64.tar.gz
    dest: /opt/cadvisor/cadvisor-0.37.0
    checksum: |
      sha256:66134d860a6f690760368235395766608d908d7439654425793356e66e302f8a
    mode: '0644'

- name: Propagate locally distributed cadvisor binary
  ansible.builtin.copy:
    src: /home/dev/bin/cadvisor/cadvisor-0.37.0
    dest: /opt/cadvisor/cadvisor-0.37.0
    mode: '0755'

- name: Symlink
  ansible.builtin.file:
    src: /opt/cadvisor/cadvisor-0.37.0
    dest: /opt/cadvisor/cadvisor
    state: link
    mode: '0755'

- name: Server systemd service
  ansible.builtin.template:
    src: systemd-system-cadvisor-service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'

- name: Test_task
  ansible.builtin.systemd:
    name: cadvisor.service
    state: started
    enabled: true
    daemon_reload: true
  register: service_active
  changed_when: false

- name: Debug
  ansible.builtin.debug:
    var: service_active

- name: Enable server systemd
  ansible.builtin.systemd:
    name: cadvisor.service
    enabled: true

- name: Start server systemd
  ansible.builtin.systemd:
    name: cadvisor.service
    state: started
    daemon_reload: true


