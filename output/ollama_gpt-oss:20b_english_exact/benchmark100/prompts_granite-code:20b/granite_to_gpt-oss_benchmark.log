  ansible.builtin.stat:
    path: "{{ cert_path }}"
  register: cert_stat

- name: Fail
  ansible.builtin.fail:
    msg: "Certificate file does not exist."
  when: not cert_stat.stat.exists

- name: Set Fact
  ansible.builtin.set_fact:
    keystore_path: "/path/old"
    keystore_type: "JKS"
  when: java_version < 11

- name: Set Fact
  ansible.builtin.set_fact:
    keystore_path: "/path/new"
    keystore_type: "PKCS12"
  when: java_version >= 11

- name: Java Cert
  community.general.java_cert:
    keystore_path: "{{ keystore_path }}"
    cert_path: "{{ cert_path }}"
    alias: "{{ cert_alias }}"
    state: present
    keystore_pass: "{{ keystore_pass | default('') }}"


