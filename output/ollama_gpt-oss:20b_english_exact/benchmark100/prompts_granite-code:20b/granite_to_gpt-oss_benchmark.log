---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Ensure that logrotate is installed.
  ansible.builtin.package:
    name: logrotate
    state: present

- name: Template /etc/logrotate.conf using the template.
  ansible.builtin.template:
    src: logrotate.conf.j2
    dest: /etc/logrotate.conf
    mode: '0644'

- name: Template /etc/logrotate.d for item using the template.
  ansible.builtin.template:
    src: logrotate.d.j2
    dest: "/etc/logrotate.d/{{ item.name }}"
    mode: '0644'
  loop: "{{ logrotate_items }}"

- name: Remove /etc/logrotate.d for item.
  ansible.builtin.file:
    path: "/etc/logrotate.d/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_items }}"

- name: Start the logrotate service.
  ansible.builtin.service:
    name: logrotate
    state: started
    enabled: true


