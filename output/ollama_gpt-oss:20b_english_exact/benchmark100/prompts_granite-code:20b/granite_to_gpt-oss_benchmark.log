---
- name: Create the RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
- name: Set server taints
  set_fact:
    rke2_server_taints: "{{ rke2_server_node_taints }}"
- name: Copy rke2 config
  copy:
    src: "{{ rke2_config_source }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0600'
- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0600'
  when: rke2_kubelet_config is defined and rke2_kubelet_config != ""
- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_registry_config_source }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0600'
  when: >-
    rke2_custom_registry_mirrors is defined or
    rke2_custom_registry_configs is defined
- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: >-
      rke2_etcd_snapshot_file is defined and
      rke2_etcd_snapshot_file != ''
- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: >-
      {{
        rke2_etcd_snapshot_s3_options is defined and
        rke2_etcd_snapshot_s3_options.access_key is defined and
        rke2_etcd_snapshot_s3_options.secret_key is defined and
        rke2_etcd_snapshot_s3_options.bucket is defined and
        rke2_etcd_snapshot_s3_options.snapshot_name is defined
      }}
- name: Restore etcd from file
  block:
    - name: Create etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/server/db/snapshots
        state: directory
    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/snapshots/{{ inventory_hostname }}.snapshot
        mode: '0600'
    - name: Restore etcd from snapshot
      command:
        argv:
          - rke2
          - server
          - --restore-snapshot
          - /var/lib/rancher/rke2/server/db/snapshots/{{ inventory_hostname }}.snapshot
  when: do_etcd_restore is defined and do_etcd_restore
- name: Restore etcd from s3
  command:
    argv:
      - rke2
      - server
      - --restore-snapshot-s3
      - --s3-access-key
      - "{{ rke2_etcd_snapshot_s3_options.access_key }}"
      - --s3-secret-key
      - "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
      - --s3-bucket
      - "{{ rke2_etcd_snapshot_s3_options.bucket }}"
      - --s3-snapshot-name
      - "{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
  when: do_etcd_restore_from_s3 is defined and do_etcd_restore_from_s3
- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: true
- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    masked: true
- name: Wait for the first server be ready - no CNI
  wait_for_connection:
    timeout: 300
    delay: 10
- name: Wait for the first server be ready - with CNI
  shell: |
    kubectl get node {{ inventory_hostname }} \
    -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' \
    | grep -q True
  register: kube_ready
  until: kube_ready.rc == 0
  retries: 30
  delay: 10
- name: Restore etcd
  block:
    - name: Delete old node password secret
      shell: rke2 secrets delete {{ inventory_hostname }}.node-password.rke2
    - name: Delete old node
      shell: rke2 server --delete-node {{ inventory_hostname }}
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined
- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  delegate_facts: true
  loop: "{{ groups[rke2_cluster_group_name] }}"



