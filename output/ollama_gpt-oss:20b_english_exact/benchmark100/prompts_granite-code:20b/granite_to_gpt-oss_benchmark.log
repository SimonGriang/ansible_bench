  when: ansible_os_family == 'RedHat'

- name: Install required libs
  ansible.builtin.package:
    name: "{{ java_libs }}"
    state: present

- name: Install Java, Debian if ansible_os_family equals Debian
  ansible.builtin.apt:
    name: "{{ java_debian_package }}"
    state: present
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat if ansible_os_family equals RedHat
  ansible.builtin.yum:
    name: "{{ java_redhat_package }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  ansible.builtin.shell: |
    echo 'export JAVA_HOME={{ java_home }}' >> /etc/profile.d/java.sh
    echo 'export PATH=$JAVA_HOME/bin:$PATH' >> /etc/profile.d/java.sh
  args:
    creates: /etc/profile.d/java.sh

- name: Source environment variables
  ansible.builtin.shell: |
    source /etc/profile.d/java.sh
  args:
    executable: /bin/bash

- name: >-
    Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}
    /jre/bin/java in java < 11 if ansible_os_family equals Debian and
    java_open_jdk_version_major is less than 11
  ansible.builtin.command: |
    ln -sf /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java \
    /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java
  args:
    creates: >-
      /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java
  when:
    - ansible_os_family == 'Debian'
    - java_open_jdk_version_major | int < 11

- name: >-
    Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}
    /bin/java in java >= 11 if ansible_os_family equals Debian and
    java_open_jdk_version_major is greater than or equal to 11
  ansible.builtin.command: |
    ln -sf /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java \
    /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
  args:
    creates: >-
      /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
  when:
    - ansible_os_family == 'Debian'
    - java_open_jdk_version_major | int >= 11


