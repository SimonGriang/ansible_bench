---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_bash_url }}"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: "0700"
    timeout: "{{ rke2_artifact_fetch_timeout }}"

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: "0700"
    force: yes

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifact_path }}"
    state: directory
    mode: "0700"

- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)
  block:
    - name: Download sha256 checksum file
      get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
        mode: "0640"
        timeout: "{{ rke2_artifact_fetch_timeout }}"
    - name: Download RKE2 artifacts and compare with checksums
      get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"
        dest: "{{ rke2_artifact_path }}/{{ item }}"
        mode: "0640"
        timeout: "{{ rke2_artifact_fetch_timeout }}"
      loop: "{{ rke2_artifact_list | default([]) }}"
    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: "0700"
        timeout: "{{ rke2_artifact_fetch_timeout }}"
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'download'

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item }}"
    mode: "0640"
    force: yes
  with_items: "{{ rke2_artifact_list | default([]) }}"
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images tarballs folder
      file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: "0700"
    - name: Copy additional tarball images
      copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"
        mode: "0644"
        force: yes
      with_items: "{{ rke2_additional_tarball_images | default([]) }}"
  when:
    - rke2_airgap_mode
    - rke2_additional_tarball_images | length > 0

- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged
  block:
    - name: Register artifact stat
      stat:
        path: "{{ rke2_artifact_path }}/{{ item }}"
      register: artifact_stat
      loop: "{{ rke2_artifact_list | default([]) }}"
    - name: Make artifact read-only if writable
      file:
        path: "{{ rke2_artifact_path }}/{{ item }}"
        mode: "0640"
      when: artifact_stat.results[loop.index0].stat.writable
    - name: Register install script stat
      stat:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
      register: install_script_stat
    - name: Make install script executable if writeable and not executable
      file:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: "0700"
      when:
        - install_script_stat.stat.writable
        - not install_script_stat.stat.executable
    - name: Ensure install script is executable
      fail:
        msg: "RKE2 install script is not executable"
      when: not install_script_stat.stat.executable
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'exists'

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: local_stat

- name: Check if separate partition
  shell: df -h /usr/local | tail -1 | awk '{print $1}'
  register: local_device

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_install_script_dir }}/bin"

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 --version"
  register: rke2_version_output

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "rke2_version_output.stdout | regex_search('v([0-9]+\\.[0-9]+\\.[0-9]+)') | string == rke2_version"
    fail_msg: "Downgrade detected: current {{ rke2_version_output.stdout }}, desired {{ rke2_version }}"

- name: Run RKE2 install script
  command: "{{ rke2_install_script_dir }}/rke2.sh"
  args:
    chdir: "{{ rke2_install_script_dir }}"
  environment: "{{ rke2_airgap_vars | default({}) }}"

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    mode: "0644"
    owner: root
    group: root
  with_items: "{{ rke2_custom_manifests | default([]) }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/"
    mode: "0644"
    owner: root
    group: root
  with_items: "{{ rke2_static_pods | default([]) }}"

- name: Copy RKE2 environment file
  template:
    src: rke2_environment.j2
    dest: "/etc/default/rke2-{{ rke2_type }}"
    owner: root
    group: root
    mode: "0644"


