---
- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk-11-jdk
    state: present

- name: Install RPM
  yum:
    name: mypackage.rpm
    state: present

- name: Install DEB
  apt:
    name: mypackage.deb
    state: present
    update_cache: yes

- name: Install oracle java (rpm) (repository)
  yum:
    name: oracle-java8-installer
    state: present

- name: Configure oracle targz
  unarchive:
    src: /tmp/oracle-java.tgz
    dest: /opt
    remote_src: yes

- name: Install oracle java policy software (targz)
  unarchive:
    src: /tmp/oracle-java-policy.tgz
    dest: /opt
    remote_src: yes

- name: Set alternative (targz)
  alternatives:
    name: java
    path: /opt/java/bin/java
    priority: 2000

- name: Find JAVA_HOME
  shell: dirname $(dirname $(readlink -f $(which java)))
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME={{ java_home_result.stdout }}"


