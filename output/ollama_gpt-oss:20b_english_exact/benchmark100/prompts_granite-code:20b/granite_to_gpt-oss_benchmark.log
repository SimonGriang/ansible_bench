---
- name: Update apt cache
  apt:
    update_cache: yes
  when: ansible_os_family == 'Debian'

- name: Update dnf cache
  dnf:
    update_cache: yes
  when: ansible_os_family == 'RedHat'

- name: Install packages
  package:
    name: keepalived
    state: present

- name: Create directory for keepalived
  file:
    path: /etc/keepalived
    state: directory
    mode: '0755'

- name: Create Kubernetes API health check script for Debian OS family
  copy:
    dest: /usr/local/bin/k8s_api_health.sh
    content: |
      #!/usr/bin/env bash
      # Kubernetes API health check script for Debian
    mode: '0755'
  when: ansible_os_family == 'Debian'

- name: Create Kubernetes API health check script for RedHat OS famliy
  copy:
    dest: /usr/local/bin/k8s_api_health.sh
    content: |
      #!/usr/bin/env bash
      # Kubernetes API health check script for RedHat
    mode: '0755'
  when: ansible_os_family == 'RedHat'

- name: Create RKE2 Server health check script for Debian OS family
  copy:
    dest: /usr/local/bin/rke2_server_health.sh
    content: |
      #!/usr/bin/env bash
      # RKE2 Server health check script for Debian
    mode: '0755'
  when: ansible_os_family == 'Debian'

- name: Create RKE2 Server health check script for RedHat OS family
  copy:
    dest: /usr/local/bin/rke2_server_health.sh
    content: |
      #!/usr/bin/env bash
      # RKE2 Server health check script for RedHat
    mode: '0755'
  when: ansible_os_family == 'RedHat'

- name: Create keepalived config file
  copy:
    dest: /etc/keepalived/keepalived.conf
    content: |
      vrrp_instance VI_1 {
        state MASTER
        interface eth0
        virtual_router_id 51
        priority 101
        advert_int 1
        authentication {
          auth_type PASS
          auth_pass 1111
        }
        virtual_ipaddress {
          10.0.0.10
        }
      }
    mode: '0644'

- name: Enable keepalived and make sure it is not masked
  systemd:
    name: keepalived
    enabled: yes
    masked: no

- name: Flush handlers
  meta: flush_handlers


