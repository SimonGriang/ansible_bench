---
- name: Install Oracle Java 8
  become: true
  become_user: root
  block:
    - name: Add Oracle Java 8 repository
      block:
        - name: Install Oracle Java 8
          ansible.builtin.package:
            name: java-8-oracle
            state: present
          when: |
            (ansible_distribution == 'Amazon' and
             ansible_distribution_major_version == '2') or
            (ansible_os_family == 'RedHat' and
             ansible_distribution_major_version in ['7', '8', '9'])
    - name: Install Oracle Java 8 RPM-GPG-KEY
      ansible.builtin.rpm_key:
        key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-7
        state: present
    - name: Install Oracle Java 8
      ansible.builtin.package:
        name: java-8-oracle
        state: present
    - name: Set default Java 8
      when: |
        (ansible_distribution == 'Amazon' and
         ansible_distribution_major_version == '2') or
        (ansible_os_family == 'RedHat' and
         ansible_distribution_major_version in ['7', '8', '9'])
      ansible.builtin.lineinfile:
        path: /etc/profile.d/java.sh
        line: 'JAVA_HOME=/usr/java/jdk1.8.0_291-amd64'
        create: true
        mode: '0644'


