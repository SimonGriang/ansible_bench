- name: stat
  stat:
    path: "{{ cert_path }}"
  register: cert_stat

- name: fail
  fail:
    msg: "Certificate file does not exist."
  when: not cert_stat.stat.exists

- name: set_fact
  set_fact:
    keystore_path: "/path/old"
    keystore_type: "JKS"
  when: java_version < 11

- name: set_fact
  set_fact:
    keystore_path: "/path/new"
    keystore_type: "PKCS12"
  when: java_version >= 11

- name: java_cert
  java_cert:
    keystore_path: "{{ keystore_path }}"
    cert_path: "{{ cert_path }}"
    alias: "{{ cert_alias }}"
    state: present


