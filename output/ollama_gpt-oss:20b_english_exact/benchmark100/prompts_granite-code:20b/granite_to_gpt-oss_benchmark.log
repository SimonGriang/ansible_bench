---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ required_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_TIMEOUT='
    line: "GRUB_TIMEOUT={{ grub_timeout }}"

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_RECORDFAIL_TIMEOUT='
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"

- name: Add options to GRUB_CMDLINE_LINUX
  replace:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX="(.*)"'
    replace: 'GRUB_CMDLINE_LINUX="\1 {{ grub_cmdline_options }}"'

- name: Import password.yml
  import_tasks: password.yml
  when: grub_set_password | bool

- name: Flush handlers
  meta: flush_handlers


