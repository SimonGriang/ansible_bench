    owner: root
    group: root
    mode: '0644'
  when: containerd_registry_config_src is defined

- name: Start RKE2 service on the rest of the nodes
  ansible.builtin.systemd:
    name: rke2-{{ rke2_node_type }}.service
    state: started
    enabled: true
  when: rke2_node_type in ['server', 'agent']

- name: Mask other RKE2 service on the rest of the nodes
  ansible.builtin.systemd:
    name: rke2-{{ 'agent' if rke2_node_type == 'server' else 'server' }}.service
    masked: true
  when: rke2_node_type in ['server', 'agent']

- name: Wait for remaining nodes to be ready - no CNI
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: 6443
    timeout: 300
    state: started
  when: not cni_enabled | bool

- name: Wait for remaining nodes to be ready - with CNI
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: 6443
    timeout: 300
    state: started
  when: cni_enabled | bool


