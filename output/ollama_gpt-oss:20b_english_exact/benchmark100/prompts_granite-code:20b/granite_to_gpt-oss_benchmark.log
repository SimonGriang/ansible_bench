---
- name: Ensure /etc/openvpn/easy-rsa exists
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Easyrsa init-pki
  ansible.builtin.command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Easyrsa build-ca
  ansible.builtin.command: easyrsa build-ca
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Easyrsa gen-dh
  ansible.builtin.command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Easyrsa build-server-full server nopass
  ansible.builtin.command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Easyrsa build-client-full client nopass
  ansible.builtin.command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Easyrsa gen-crl
  ansible.builtin.command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Copy files to /etc/openvpn/server
  ansible.builtin.shell: |
    cp /etc/openvpn/easy-rsa/pki/ca.crt \
       /etc/openvpn/easy-rsa/pki/dh.pem \
       /etc/openvpn/easy-rsa/pki/ta.key \
       /etc/openvpn/easy-rsa/pki/issued/client.crt \
       /etc/openvpn/easy-rsa/pki/issued/server.crt \
       /etc/openvpn/easy-rsa/pki/private/ca.key \
       /etc/openvpn/easy-rsa/pki/private/client.key \
       /etc/openvpn/easy-rsa/pki/private/server.key \
       /etc/openvpn/server/
  changed_when: false

- name: Copy files to /etc/openvpn
  ansible.builtin.shell: |
    cp /etc/openvpn/easy-rsa/pki/ca.crt \
       /etc/openvpn/easy-rsa/pki/ta.key \
       /etc/openvpn/
  changed_when: false

- name: Place server.conf
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: '0644'


