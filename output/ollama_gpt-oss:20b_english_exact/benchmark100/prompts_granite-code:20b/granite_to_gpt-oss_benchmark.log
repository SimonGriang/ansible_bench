---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  package:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  package:
    name: rsyslog
    state: present

- name: Install additional rsyslog packages
  package:
    name:
      - rsyslog-relp
      - rsyslog-gnutls
    state: present

- name: Configuring default rsyslog
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: '0644'

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Configuring rsyslog forward rule
  template:
    src: rsyslog-forward.conf.j2
    dest: /etc/rsyslog.d/forward.conf
    owner: root
    group: root
    mode: '0644'

- name: Configuring additional config files
  copy:
    src: additional-configs/
    dest: /etc/rsyslog.d/
    owner: root
    group: root
    mode: '0644'
    recurse: yes

- name: Start and enable rsyslog
  service:
    name: rsyslog
    state: started
    enabled: true


