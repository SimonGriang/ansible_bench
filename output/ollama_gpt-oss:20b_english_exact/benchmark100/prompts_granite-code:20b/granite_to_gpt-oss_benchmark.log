---
- name: Install apache httpd
  package:
    name: httpd
    state: present

- name: Configure selinux
  selinux:
    policy: targeted
    state: enforcing
  when: ansible_selinux.status == "enabled"

- name: Configure selinux
  seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
  loop: "{{ sebooleans }}"
  when: ansible_selinux.status == "enabled"

- name: Configure selinux
  seport:
    ports: "{{ httpd_custom_port }}"
    protocol: tcp
    state: present
  when: ansible_selinux.status == "enabled"

- name: Configure httpd
  template:
    src: httpd.conf.j2
    dest: /etc/httpd/conf/httpd.conf
    mode: '0644'
  notify:
    - test httpd configuration validity
    - restart httpd

- name: Activate httpd module | Debian
  command: a2enmod "{{ httpd_module }}"
  when: ansible_facts['os_family'] == 'Debian'
  notify:
    - test httpd configuration validity

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: ports.conf.j2
    dest: /etc/httpd/conf/ports.conf
    mode: '0644'
  when: ansible_facts['os_family'] in ['Debian', 'Suse']
  notify:
    - test httpd configuration validity
    - restart httpd

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: httpd
    state: started
    enabled: true


