---
- name: "Create local ssh_key_directory for {{ user.name }}"
  file:
    path: "{{ users_ssh_key_directory }}"
    state: directory
    mode: "0750"

- name: "Manage user {{ user.name }}"
  user:
    name: "{{ user.name }}"
    state: present

- name: "Set sudo options for {{ user.name }}"
  template:
    src: templates/sudoers.j2
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: "0440"

- name: "Remove sudo options for {{ user.name }}"
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: sudo_options is not defined

- name: "Generate private ssh key for {{ user.name }}"
  shell: >-
    {{ ssh_keygen_command }} -f {{ users_ssh_key_directory }}/{{ user.name }}_id_rsa \
    -N ''
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}_id_rsa"

- name: "Generate public ssh key for {{ user.name }}"
  shell: >-
    {{ ssh_keygen_pubkey_command }} -f {{ users_ssh_key_directory }}/{{ user.name }}_id_rsa.pub
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}_id_rsa.pub"

- name: "Convert ssh key to ppk for {{ user.name }}"
  shell: >-
    {{ ssh_keygen_pubkey_command }} -f {{ users_ssh_key_directory }}/{{ user.name }}_id_rsa \
    -o {{ users_ssh_key_directory }}/{{ user.name }}_id_rsa.ppk
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}_id_rsa.ppk"

- name: "Get or set the home directory for {{ user.name }}"
  command: "getent passwd {{ user.name }} | awk -F: '{print $6}'"
  register: user_home
  changed_when: false

- name: "Create .ssh directory for {{ user.name }}"
  file:
    path: "{{ user_home.stdout }}/.ssh"
    state: directory
    mode: "0700"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"

- name: "Deploy authorized keys for {{ user.name }}"
  authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ item }}"
  loop: "{{ authorized_keys }}"

- name: "Remove unauthorized keys for {{ user.name }}"
  authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ unauthorized_keys }}"

- name: "Copy generated private ssh key for {{ user.name }}"
  copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}_id_rsa"
    dest: "{{ private_key_destination }}"
    mode: "0600"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"

- name: "Check users password valid time for {{ user.name }}"
  command: "chage -l {{ user.name }} | awk -F: '/Password expires/{print $2}'"
  register: password_expiry
  changed_when: false

- name: "Set users password valid time for {{ user.name }}"
  command: >-
    chage -M {{ password_max_days }} \
    -m {{ password_min_days }} \
    -W {{ password_warn_days }} {{ user.name }}

- name: "Place private key file for {{ user.name }}"
  copy:
    src: "{{ private_key_file }}"
    dest: "{{ user_home.stdout }}/.ssh/id_rsa"
    mode: "0600"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"



