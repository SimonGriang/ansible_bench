    group: "{{ git_groupname }}"
    mode: '0755'

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0644'

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0755'

- name: Clone all roles
  git:
    repo: "{{ item }}"
    dest: "{{ git_repository_destination }}"
    version: master
    accept_hostkey: true
  loop: "{{ git_repositories }}"
  become: true
  become_user: "{{ git_username }}"


