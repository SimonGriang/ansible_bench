---
- name: Ensure apt key is not present in trusted.gpg.d
  ansible.builtin.apt_key:
    state: absent
    id: "key-id"

- name: Ensure old apt source list is not present in /etc/apt/sources.list.d
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/old.list
    state: absent

- name: Ensure old versions of Docker are not installed
  ansible.builtin.apt:
    name:
      - docker.io
      - docker-engine
      - docker-ce
      - docker-ce-cli
      - containerd.io
    state: absent
    purge: true

- name: Ensure legacy repo file is not present
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/legacy.list
    state: absent

- name: Ensure dependencies are installed
  ansible.builtin.apt:
    name:
      - apt-transport-https
      - ca-certificates
      - curl
      - gnupg
      - lsb-release
    state: present
    update_cache: true

- name: Add or remove Docker repository
  ansible.builtin.apt_repository:
    repo: |
      deb [arch=amd64] https://download.docker.com/linux/ubuntu
      {{ ansible_distribution_release }} stable
    state: present
    filename: docker

- name: Ensure handlers are notified immediately to update the apt cache
  ansible.builtin.apt:
    update_cache: true
  notify: Update apt cache


