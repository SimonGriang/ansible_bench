    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  ansible.builtin.command: >-
    kubectl taint nodes {{ inventory_hostname }}
    node-role.kubernetes.io/server=:NoSchedule
  when: rke2_node_type == 'server'
  failed_when: false
  changed_when: false

- name: Set agent taints
  ansible.builtin.command: >-
    kubectl taint nodes {{ inventory_hostname }}
    node-role.kubernetes.io/agent=:NoSchedule
  when: rke2_node_type == 'agent'
  failed_when: false
  changed_when: false

- name: Copy RKE2 config
  ansible.builtin.copy:
    src: "{{ rke2_config_src | default('templates/rke2-config.yaml') }}"
    dest: "{{ rke2_config_dir | default('/etc/rancher/rke2') }}/config.yaml"
    owner: root
    group: root
    mode: '0644'

- name: Copy kubelet config
  ansible.builtin.copy:
    src: "{{ kubelet_config_src }}"
    dest: "/etc/kubernetes/kubelet.conf"
    owner: root
    group: root
    mode: '0644'
