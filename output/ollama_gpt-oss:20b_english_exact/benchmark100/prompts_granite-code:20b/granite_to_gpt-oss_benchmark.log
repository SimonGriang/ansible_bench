---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install php
  package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  shell: "{{ php_ini_command }}"
  register: php_found_ini_location

- name: Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
    mode: '0644'
  notify: Restart httpd


