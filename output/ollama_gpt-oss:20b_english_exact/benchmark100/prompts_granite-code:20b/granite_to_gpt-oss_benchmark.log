---
- name: Install cron
  package:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/crontab
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell | default('/bin/bash') }}"
    state: present

- name: Configure path
  lineinfile:
    path: /etc/crontab
    regexp: '^PATH='
    line: "PATH={{ cron_path | default('/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin') }}"
    state: present

- name: Configure mailto
  lineinfile:
    path: /etc/crontab
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto | default('root') }}"
    state: present

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: true

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default('*') }}"
    hour: "{{ item.hour | default('*') }}"
    day: "{{ item.day | default('*') }}"
    month: "{{ item.month | default('*') }}"
    weekday: "{{ item.weekday | default('*') }}"
    job: "{{ item.job }}"
    user: "{{ item.user | default(omit) }}"
    state: present
  loop: "{{ cron_jobs | default([]) }}"


