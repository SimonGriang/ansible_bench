---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install python pip
  ansible.builtin.package:
    name: python-pip
    state: present

- name: Configure pip proxy
  ansible.builtin.ini_file:
    path: /etc/pip.conf
    section: global
    option: proxy
    value: "{{ pip_proxy }}"
    mode: '0644'

- name: Trust hosts
  ansible.builtin.ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ trusted_hosts }}"
    mode: '0644'

- name: Update pip
  ansible.builtin.pip:
    name: pip
    state: latest

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ requested_modules }}"
    state: present


