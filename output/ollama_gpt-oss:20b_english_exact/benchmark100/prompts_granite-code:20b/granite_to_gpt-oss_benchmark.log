---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  package:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/profile
    regexp: '^SHELL='
    line: 'SHELL=/bin/bash'

- name: Configure path
  lineinfile:
    path: /etc/profile
    regexp: '^PATH='
    line: 'PATH=/usr/local/bin:/usr/bin:/bin'

- name: Configure mailto
  lineinfile:
    path: /etc/crontab
    regexp: '^MAILTO='
    line: 'MAILTO=admin@example.com'

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: true

- name: Schedule requested cron jobs
  cron:
    name: example_job
    minute: '0'
    hour: '*/6'
    job: /usr/bin/example_command



