---
- name: Install Keepalived when HA mode is enabled
  ansible.builtin.shell: |
    if [ "{{ ha_mode_enabled }}" = "true" ]; then
      {{ ansible_pkg_mgr }} install -y keepalived
    fi
  args:
    executable: /bin/bash
  register: keepalived_install
  changed_when: "'install' in keepalived_install.stdout"
  # noqa: command-instead-of-module

- name: Download and install RKE2 {{ rke2_version }}
  ansible.builtin.shell: |
    curl -sfL \
      https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/\
      rke2-installer.sh | \
      sh -s - --version {{ rke2_version }}
  args:
    executable: /bin/bash
  register: rke2_install
  changed_when: rke2_install.rc == 0
  # noqa: command-instead-of-module
  # noqa: risky-shell-pipe

- name: CIS Hardening
  ansible.builtin.shell: |
    /usr/local/bin/cis-hardening.sh
  args:
    executable: /bin/bash
  register: cis_hardening
  changed_when: cis_hardening.rc == 0

- name: Find Active Server
  ansible.builtin.shell: |
    kubectl get nodes \
      --selector='node-role.kubernetes.io/master' \
      -o jsonpath='{.items[0].metadata.name}'
  args:
    executable: /bin/bash
  register: active_server
  changed_when: false
  # noqa: no-changed-when

- name: Enable IPVS kernel module
  ansible.builtin.shell: |
    modprobe ipvs
    echo "ipvs" >> /etc/modules-load.d/ipvs.conf
  args:
    executable: /bin/bash
  register: ipvs_enable
  changed_when: ipvs_enable.rc == 0

- name: Copy kube-vip manifests to the masternode
  ansible.builtin.copy:
    src: kube-vip/
    dest: /etc/kubernetes/manifests/kube-vip/
    owner: root
    group: root
    mode: '0644'
  register: copy_kubevip

- name: Copy ingress-nginx manifests to the masternode
  ansible.builtin.copy:
    src: ingress-nginx/
    dest: /etc/kubernetes/manifests/ingress-nginx/
    owner: root
    group: root
    mode: '0644'
  register: copy_ingress

- name: Prepare very first server node in the cluster
  ansible.builtin.shell: |
    rke2 server --config /etc/rke2/config.yaml
  args:
    executable: /bin/bash
  register: first_server_prepare
  changed_when: first_server_prepare.rc == 0

- name: Restore etcd specific tasks
  ansible.builtin.shell: |
    rke2 etcd restore --backup /backups/etcd.tar.gz
  args:
    executable: /bin/bash
  register: etcd_restore
  changed_when: etcd_restore.rc == 0

- name: Download kubeconfig to ansible localhost
  ansible.builtin.fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: ./kubeconfig/
    flat: true

- name: Prepare and join remaining nodes of the cluster
  ansible.builtin.shell: |
    rke2 agent \
      --server https://{{ active_server.stdout }}:9345 \
      --token $(cat /etc/rancher/rke2/token)
  args:
    executable: /bin/bash
  register: join_nodes
  changed_when: join_nodes.rc == 0

- name: Rolling cordon and drain restart when version changes - servers
  ansible.builtin.shell: |
    kubectl get nodes \
      -l node-role.kubernetes.io/master \
      -o jsonpath='{.items[*].metadata.name}' | \
      xargs -I {} kubectl cordon {}
  args:
    executable: /bin/bash
  register: rolling_restart_servers
  changed_when: rolling_restart_servers.rc == 0
  # noqa: risky-shell-pipe

- name: Rolling cordon and drain restart when version changes - agents
  ansible.builtin.shell: |
    kubectl get nodes \
      -l node-role.kubernetes.io/worker \
      -o jsonpath='{.items[*].metadata.name}' | \
      xargs -I {} kubectl cordon {}
  args:
    executable: /bin/bash
  register: rolling_restart_agents
  changed_when: rolling_restart_agents.rc == 0
  # noqa: risky-shell-pipe

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Rolling restart when config files change
  ansible.builtin.shell: |
    systemctl restart rke2-server.service
  args:
    executable: /bin/bash
  register: rolling_restart_config
  changed_when: rolling_restart_config.rc == 0
  # noqa: command-instead-of-module

- name: Final steps
  ansible.builtin.debug:
    msg: "Cluster setup complete."


