---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install dns
  ansible.builtin.package:
    name: dns
    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner | default('root') }}"
    group: "{{ item.group | default('root') }}"
    mode: "{{ item.mode | default('0755') }}"
  loop: "{{ dns_directories | default([]) }}"

- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  ansible.builtin.user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    state: present
    create_home: false

- name: Generate rndc key
  ansible.builtin.command: "rndc-confgen -a -c {{ rndc_key_path }}"
  args:
    creates: "{{ rndc_key_path }}"

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ rndc_key_path }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0600'

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ hints_url }}"
    dest: "{{ dns_root_file }}"
    mode: '0644'

- name: Create zone file
  ansible.builtin.template:
    src: "{{ zone_template | default('zone.j2') }}"
    dest: "{{ item.dest }}"
    mode: '0644'
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  ansible.builtin.template:
    src: "{{ named_conf_template | default('named.conf.j2') }}"
    dest: "/etc/named.conf"
    mode: '0644'

- name: Place systemd override
  ansible.builtin.template:
    src: "{{ systemd_override_template | default('override.conf.j2') }}"
    dest: "/etc/systemd/system/dns.service.d/override.conf"
    mode: '0644'

- name: Start and enable dns
  ansible.builtin.service:
    name: dns
