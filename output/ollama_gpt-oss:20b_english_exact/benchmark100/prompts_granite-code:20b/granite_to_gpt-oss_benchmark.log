- name: check if all variables have been set correctly
  assert:
    that:
      - variable1 is defined
      - variable2 is defined
    fail_msg: "Required variables are missing."

- name: wait for host (when configured)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 22
    timeout: 300
    state: started
  when: host_configured | default(false)

- name: prepare system
  block:
    - name: test connection
      ping:
    - name: install bootstrap packages
      package:
        name:
          - git
          - curl
        state: present
      when: ansible_facts['os_family'] == 'RedHat'
  when: ansible_facts['os_family'] is defined


