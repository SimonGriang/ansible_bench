773, 'prompt_eval_count': 2211, 'prompt_eval_duration': 574369754, 'eval_count': 1845, 'eval_duration': 18959157274, 'model_name': 'gpt-oss:20b'} id='run--060f175e-119c-433f-9a04-d1cec8b64b47-0' usage_metadata={'input_tokens': 2211, 'output_tokens': 1845, 'total_tokens': 4056}
