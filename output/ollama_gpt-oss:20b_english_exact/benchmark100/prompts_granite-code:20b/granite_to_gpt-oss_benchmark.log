---
- name: Install ssl packages
  ansible.builtin.apt:
    name:
      - openssl
      - apache2
    state: present
    update_cache: true

- name: Place configuration
  ansible.builtin.template:
    src: ssl.conf.j2
    dest: /etc/apache2/sites-available/ssl.conf
    owner: root
    group: root
    mode: '0644'

- name: Configure redirect from http to https
  ansible.builtin.lineinfile:
    path: /etc/apache2/sites-available/000-default.conf
    regexp: '^# Redirect from http to https'
    line: |
      # Redirect from http to https
      Redirect permanent / https://{{ ansible_fqdn }}/
    state: present


