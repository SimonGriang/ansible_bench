    /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
  args:
    creates: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
  when:
    - ansible_os_family == 'Debian'
    - java_open_jdk_version_major | int >= 11


