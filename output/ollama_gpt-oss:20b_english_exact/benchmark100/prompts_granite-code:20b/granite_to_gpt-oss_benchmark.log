  command: "{{ rke2_install_script_dir }}/rke2.sh"
  args:
    chdir: "{{ rke2_install_script_dir }}"
  environment: "{{ rke2_airgap_vars | default({}) }}"

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    mode: "0644"
    owner: root
    group: root
  with_items: "{{ rke2_custom_manifests | default([]) }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/"
    mode: "0644"
    owner: root
    group: root
  with_items: "{{ rke2_static_pods | default([]) }}"

- name: Copy RKE2 environment file
  template:
    src: rke2_environment.j2
    dest: "/etc/default/rke2-{{ rke2_type }}"
    owner: root
    group: root
    mode: "0644"


