---
- name: Install mysql
  package:
    name: mysql-server
    state: present

- name: Configure mysql server
  copy:
    src: mysql_server.conf
    dest: /etc/mysql/mysql.conf.d/server.cnf
    owner: root
    group: root
    mode: '0644'
  notify: restart mysql

- name: Configure mysql client
  copy:
    src: mysql_client.conf
    dest: /etc/mysql/mysql.conf.d/client.cnf
    owner: root
    group: root
    mode: '0644'
  notify: restart mysql

- name: Initialize mysql
  command: mysql_install_db --user=mysql --ldata=/var/lib/mysql
  args:
    creates: /var/lib/mysql/mysql
  register: mysql_init
  changed_when: "'Initializing' in mysql_init.stdout"

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: '0644'
  notify: restart mysql

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop:
    - db1
    - db2

- name: List databases
  shell: mysql -e "SHOW DATABASES;"
  register: db_list

- name: Import database
  mysql_db:
    state: import
    name: mydb
    target: /path/to/backup.sql

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  loop:
    - { name: 'user1', password: 'pass1', priv: 'db1.*:ALL' }
    - { name: 'user2', password: 'pass2', priv: 'db2.*:ALL' }

- name: Flush handlers again
  meta: flush_handlers


