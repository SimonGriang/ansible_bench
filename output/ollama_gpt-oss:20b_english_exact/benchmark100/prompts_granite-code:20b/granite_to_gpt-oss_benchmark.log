---  
- name: Create the RKE2 config dir  
  file:  
    path: "{{ rke2_config_dir | default('/etc/rancher/rke2') }}"  
    state: directory  
    owner: root  
    group: root  
    mode: '0755'  

- name: Set server taints  
  command: "kubectl taint nodes {{ inventory_hostname }} node-role.kubernetes.io/server=:NoSchedule"  
  when: rke2_node_type == 'server'  
  ignore_errors: yes  

- name: Set agent taints  
  command: "kubectl taint nodes {{ inventory_hostname }} node-role.kubernetes.io/agent=:NoSchedule"  
  when: rke2_node_type == 'agent'  
  ignore_errors: yes  

- name: Copy RKE2 config  
  copy:  
    src: "{{ rke2_config_src | default('templates/rke2-config.yaml') }}"  
    dest: "{{ rke2_config_dir | default('/etc/rancher/rke2') }}/config.yaml"  
    owner: root  
    group: root  
    mode: '0644'  

- name: Copy kubelet config  
  copy:  
    src: "{{ kubelet_config_src }}"  
    dest: "/etc/kubernetes/kubelet.conf"  
    owner: root  
    group: root  
    mode: '0644'  
  when: kubelet_config_src is defined  

- name: Copy Containerd Registry Configuration file  
  copy:  
    src: "{{ containerd_registry_config_src }}"  
    dest: "/etc/containerd/registry.conf"  
    owner: root  
    group: root  
    mode: '0644'  
  when: containerd_registry_config_src is defined  

- name: Start RKE2 service on the rest of the nodes  
  systemd:  
    name: rke2-{{ rke2_node_type }}.service  
    state: started  
    enabled: true  
  when: rke2_node_type in ['server', 'agent']  

- name: Mask other RKE2 service on the rest of the nodes  
  systemd:  
    name: rke2-{{ 'agent' if rke2_node_type == 'server' else 'server' }}.service  
    masked: true  
  when: rke2_node_type in ['server', 'agent']  

- name: Wait for remaining nodes to be ready - no CNI  
  wait_for:  
    host: "{{ inventory_hostname }}"  
    port: 6443  
    timeout: 300  
    state: started  
  when: not cni_enabled  

- name: Wait for remaining nodes to be ready - with CNI  
  wait_for:  
    host: "{{ inventory_hostname }}"  
    port: 6443  
    timeout: 300  
    state: started  
  when: cni_enabled  


