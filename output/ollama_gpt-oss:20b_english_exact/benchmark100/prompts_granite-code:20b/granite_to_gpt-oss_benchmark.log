---
- name: Create group vault
  ansible.builtin.group:
    name: vault
    state: present

- name: Create user vault
  ansible.builtin.user:
    name: vault
    state: present
    system: true
    create_home: false
    group: vault

- name: Create directory /opt/vault
  ansible.builtin.file:
    path: /opt/vault
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Download Vault binary
  ansible.builtin.unarchive:
    src: "{{ vault_download_url }}"
    dest: /opt/vault
    remote_src: true

- name: Create directory /etc/vault.d
  ansible.builtin.file:
    path: /etc/vault.d
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy Vault binary
  ansible.builtin.copy:
    src: /opt/vault/vault
    dest: /usr/bin/vault
    mode: '0755'
    owner: root
    group: root

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  ansible.posix.capabilities:
    path: /usr/bin/vault
    capabilities: cap_ipc_lock=ep

- name: Create file /etc/vault.d/vault.env
  ansible.builtin.file:
    path: /etc/vault.d/vault.env
    state: touch
    mode: '0644'
    owner: root
    group: root

- name: Create directory /usr/lib/systemd/system
  ansible.builtin.file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy Vault service file
  ansible.builtin.copy:
    src: files/vault.service
    dest: /usr/lib/systemd/system/vault.service
    mode: '0644'
    owner: root
    group: root

- name: Copy vault configuration
  ansible.builtin.copy:
    src: files/vault.hcl
    dest: /etc/vault.d/vault.hcl
    mode: '0644'
    owner: root
    group: root

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


