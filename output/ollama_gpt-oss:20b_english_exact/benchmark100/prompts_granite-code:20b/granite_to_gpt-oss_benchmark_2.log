- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_bash_url }}"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: '0700'
    timeout: "{{ rke2_artifact_fetch_timeout }}"

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: '0700'
    force: yes

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifact_path }}"
    state: directory
    mode: '0700'

- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)
  block:
    - name: Download RKE2 checksum
      get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
        mode: '0640'
        timeout: "{{ rke2_artifact_fetch_timeout }}"

    - name: Download RKE2 artifacts and compare with checksums from {{ rke2_artifact_url }}/{{ rke2_version }}
      get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"
        dest: "{{ rke2_artifact_path }}/{{ item }}"
        mode: '0640'
        timeout: "{{ rke2_artifact_fetch_timeout }}"
        checksum: "sha256:{{ lookup('file', '{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt') }}"
      loop: "{{ rke2_artifacts }}"

    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: '0700'
        timeout: "{{ rke2_artifact_fetch_timeout }}"
  when: airgap_mode_enabled and airgap_implementation == 'download'

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item }}"
    mode: '0640'
    force: yes
  loop: "{{ rke2_artifacts }}"
  when: airgap_mode_enabled and airgap_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Create the additional images tarballs folder
      file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: '0700'

    - name: Copy the additional tarball images RKE2 components
      copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"
        mode: '0644'
        force: yes
      loop: "{{ rke2_additional_tarballs }}"
  when: airgap_mode_enabled and rke2_additional_tarballs | length > 0

- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged
  block:
    - name: Register artifacts
      stat:
        path: "{{ rke2_artifact_path }}/{{ item }}"
      register: artifact_stat
      loop: "{{ rke2_artifacts }}"

    - name: Make artifacts read-only if writeable
      file:
        path: "{{ rke2_artifact_path }}/{{ item }}"
        mode: '0640'
      when: artifact_stat.results[loop.index0].stat.mode | int(8, 10) & 0o222
      loop: "{{ rke2_artifacts }}"

    - name: Make install script executable if writeable and not executable
      file:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: '0700'
      when: (artifact_stat.results[0].stat.mode | int(8, 10) & 0o222) and not (artifact_stat.results[0].stat.mode | int(8, 10) & 0o111)

    - name: Fail if install script not executable
      fail:
        msg: "RKE2 install script is not executable"
      when: not (artifact_stat.results[0].stat.mode | int(8, 10) & 0o111)
  when: airgap_mode_enabled and airgap_implementation == 'exists'

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Check if separate partition
  set_fact:
    usr_local_is_partition: "{{ usr_local_stat.stat.isdir and not (usr_local_stat.stat.mounted) }}"

- name: Set RKE2 bin path based on the conditions
  set_fact:
    rke2_bin_path: "{{ (usr_local_is_partition | bool) | ternary('/usr/local/bin', '/usr/bin') }}"

- name: Check RKE2 version and installed and running versions
  command: "{{ rke2_bin_path }}/rke2 --version"
  register: rke2_version_output
  ignore_errors: yes

- name: Check RKE2 version and installed and running versions
  command: systemctl is-active rke2-server
  register: rke2_service_status
  ignore_errors: yes

- name: Prevent accidental RKE2 downgrade by asserting the version
  assert:
    that:
      - rke2_version_output.stdout is defined
      - rke2_version_output.stdout | regex_search('v([0-9]+\.[0-9]+\.[0-9]+)') == rke2_version
    fail_msg: "Installed RKE2 version {{ rke2_version_output.stdout }} does not match required {{ rke2_version }}"

- name: Run RKE2 install script with or without airgap variables
  shell: "{{ rke2_install_script_dir }}/rke2.sh {{ airgap_params | default('') }}"
  args:
    creates: /etc/rancher/rke2/rke2.yaml

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ rke2_custom_manifests }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ rke2_static_pods }}"

- name: Copy RKE2 environment file
  template:
    src: rke2_environment.j2
    dest: "/etc/default/rke2-{{ rke2_type }}"
    owner: root
    group: root
    mode: '0644'


