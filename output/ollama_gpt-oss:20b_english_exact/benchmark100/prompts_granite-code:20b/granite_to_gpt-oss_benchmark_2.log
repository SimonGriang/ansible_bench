tasks:
  - name: Download file
    get_url:
      url: "{{ item.url }}"
      dest: "{{ item.dest }}"
      mode: "0644"
      force: yes
    loop: "{{ files }}"
    register: download_results
  - name: Verify downloaded files
    assert:
      that:
        - download_results is defined
        - download_results.failed == false
        - download_results.results | length == files | length
        - download_results.results | filter('failed', false) | length == files | length
        - download_results.results | filter('changed', false) | length == files | length
  - name: Download and install a list of files
    get_url:
      url: "{{ item.url }}"
      dest: "{{ item.dest }}"
      mode: "0644"
      force: yes
      checksum: >-
        sha256:{{ lookup('file',
          rke2_artifact_path + '/sha256sum-' + rke2_architecture + '.txt') }}
    loop: "{{ files }}"
    register: download_results
  - name: Verify downloaded files with checksum
    assert:
      that:
        - download_results is defined
        - download_results.failed == false
        - download_results.results | length == files | length
        - download_results.results | filter('failed', false) | length == files | length
        - download_results.results | filter('changed', false) | length == files | length
  - name: Install files
    block:
      - name: Install file
        copy:
          src: "{{ item.dest }}"
          dest: "{{ item.dest }}"
          mode: "0644"
        loop: "{{ files }}"
        register: install_results
      - name: Verify installed files
        assert:
          that:
            - install_results is defined
            - install_results.failed == false
            - install_results.results | length == files | length
            - install_results.results | filter('failed', false) | length == files | length
            - install_results.results | filter('changed', false) | length == files | length
  - name: Get artifact stat
    block:
      - name: Get artifact stat
        stat:
          path: "{{ item.dest }}"
        loop: "{{ files }}"
        register: artifact_stat
      - name: Verify artifact stat
        assert:
          that:
            - artifact_stat is defined
            - artifact_stat.failed == false
            - artifact_stat.results | length == files | length
            - artifact_stat.results | filter('failed', false) | length == files | length
            - artifact_stat.results | filter('changed', false) | length == files | length
  - name: Make artifacts read-only if writeable
    file:
      path: "{{ item.dest }}"
      mode: "0644"
      state: file
    loop: "{{ files }}"
    when: >-
      ((artifact_stat.results[loop.index0].stat.mode | int(base=8))
      & 0o222) != 0
  - name: Make install script executable if writeable and not executable
    file:
      path: "{{ item.dest }}"
      mode: "0755"
      state: file
    loop: "{{ files }}"
    when: >-
      ((artifact_stat.results[loop.index0].stat.mode | int(base=8))
      & 0o222) != 0
  - name: Verify executable
    assert:
      that:
        - download_results is defined
        - download_results.failed == false
        - download_results.results | length == files | length
        - download_results.results | filter('failed', false) | length == files | length
        - download_results.results | filter('changed', false) | length == files | length


