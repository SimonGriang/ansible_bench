---
- name: Create ssl key
  openssl_privatekey:
    path: "/etc/ssl/private/{{ item.name }}.key"
    size: 2048
    mode: '0640'
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
  loop: "{{ ssl_items }}"

- name: Create ssl csr
  openssl_csr:
    path: "/etc/ssl/csr/{{ item.name }}.csr"
    privatekey_path: "/etc/ssl/private/{{ item.name }}.key"
    common_name: "{{ item.common_name }}"
    mode: '0644'
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
  loop: "{{ ssl_items }}"

- name: Create ssl certificates
  openssl_certificate:
    path: "/etc/ssl/certs/{{ item.name }}.crt"
    csr_path: "/etc/ssl/csr/{{ item.name }}.csr"
    privatekey_path: "/etc/ssl/private/{{ item.name }}.key"
    provider: selfsigned
    mode: '0644'
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
  loop: "{{ ssl_items }}"

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "/etc/ssl/pkcs12/{{ item.name }}.p12"
    privatekey_path: "/etc/ssl/private/{{ item.name }}.key"
    certificate_path: "/etc/ssl/certs/{{ item.name }}.crt"
    friendly_name: "{{ item.name }}"
    mode: '0640'
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
  loop: "{{ ssl_items }}"

- name: Read private key
  slurp:
    src: "/etc/ssl/private/{{ item.name }}.key"
  register: private_key_result
  loop: "{{ ssl_items }}"

- name: Read certificate
  slurp:
    src: "/etc/ssl/certs/{{ item.name }}.crt"
  register: certificate_result
  loop: "{{ ssl_items }}"

- name: Create combined private_key and certificate file
  copy:
    dest: "/etc/ssl/combined/{{ item.name }}.pem"
    content: "{{ private_key_result.results[loop.index0].content | b64decode + certificate_result.results[loop.index0].content | b64decode }}"
    mode: '0640'
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
  loop: "{{ ssl_items }}"


