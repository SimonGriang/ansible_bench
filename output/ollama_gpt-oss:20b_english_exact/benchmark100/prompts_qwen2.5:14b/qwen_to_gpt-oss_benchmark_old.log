- name: Check if certificates exist
  ansible.builtin.stat:
    path: "{{ item }}"
  loop: "{{ java_certs }}"
  register: certs_stat

- name: Fail if some certificate doesn't exist
  ansible.builtin.fail:
    msg: "Missing certificate: {{ certs_stat.results | selectattr('stat.exists', 'equalto', False) | map(attribute='stat.path') | list | join(', ') }}"
  when: certs_stat.results | selectattr('stat.exists', 'equalto', False) | list | length > 0

- name: Setting keystore variables in java < 11
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: java_open_jdk_version_major | int < 11

- name: Setting keystore variables in java >= 11
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: java_open_jdk_version_major | int >= 11

- name: Import SSL certificates
  java_cert:
    cert_path: "{{ item }}"
    keystore_path: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts"
    keystore_password: "{{ java_keystore_password | default('changeit') }}"
    alias: "{{ item | basename | regex_replace('\\.\\w+$', '') }}"
    state: present
  loop: "{{ java_certs }}"



