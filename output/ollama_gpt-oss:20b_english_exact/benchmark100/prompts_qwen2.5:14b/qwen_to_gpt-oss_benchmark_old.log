---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Set SELinux booleans
      seboolean:
        name: "{{ item }}"
        state: yes
        persistent: yes
      loop: "{{ selinux_booleans | default([]) }}"
    - name: Allow connections to custom ports
      seport:
        port: "{{ item }}"
        proto: tcp
        state: permissive
      loop: "{{ selinux_ports | default([]) }}"
  when: ansible_selinux.status == 'enabled'

- name: Configure httpd
  template:
    src: "{{ httpd_conf_src }}"
    dest: "{{ httpd_conf_dest }}"
  notify:
    - Test httpd configuration
    - Restart httpd

- name: Activate httpd module | Debian
  command: a2enmod {{ item }}
  notify:
    - Test httpd configuration
    - Restart httpd
  loop: "{{ httpd_modules | default([]) }}"
  when: ansible_facts.os_family == 'Debian'

- name: Import ssl.yml
  include_tasks: ssl.yml
  when: httpd_ssl_enabled

- name: Import locations.yml
  include_tasks: locations.yml
  when: httpd_locations | length > 0

- name: Import vhosts.yml
  include_tasks: vhosts.yml
  when: httpd_vhosts | length > 0

- name: Configure ports
  template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
  notify:
    - Test httpd configuration
    - Restart httpd
  when: ansible_facts.os_family in ['Debian', 'Suse']

- name: Import directories.yml
  include_tasks: directories.yml
  when: httpd_directories | length > 0

- name: Flush handlers
  flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


