- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  ansible.builtin.stat:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
  register: python311_externally_managed

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.command: mv /usr/lib/python3.11/EXTERNALLY-MANAGED /usr/lib/python3.11/EXTERNALLY-MANAGED.old
  when: python311_externally_managed.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  ansible.builtin.stat:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
  register: python312_externally_managed

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.command: mv /usr/lib/python3.12/EXTERNALLY-MANAGED /usr/lib/python3.12/EXTERNALLY-MANAGED.old
  when: python312_externally_managed.stat.exists

- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install python pip
  ansible.builtin.pip:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "proxy = {{ python_pip_proxy }}"
    state: present
  when: python_pip_proxy is defined

- name: Trust hosts
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    state: present
  when: python_pip_trusted_host is defined

- name: Update pip
  ansible.builtin.pip:
    name: pip
    state: latest
  when:
    - python_pip_update | bool
    - ansible_facts['os_family'] != "Alpine"
    - ansible_facts['lsb']['codename'] not in ['bookworm', 'noble']

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ python_pip_modules }}"
    state: present
  when:
    - ansible_facts['os_family'] != "Alpine"
    - ansible_facts['lsb']['codename'] not in ['bookworm', 'noble']


