---
- name: Create the RKE2 config directory
  file:
    path: "{{ rke2_config_dir }}"
    state: directory
    mode: '0755'

- name: Set server taints
  command: rke2 node taint add {{ rke2_taint }}
  when: rke2_type == 'server'

- name: Set agent taints
  command: rke2 node taint add {{ rke2_taint }}
  when: rke2_type == 'agent'

- name: Copy RKE2 config file
  copy:
    src: "{{ rke2_config_src }}"
    dest: "{{ rke2_config_dir }}/config.yaml"
    mode: '0644'
  notify: restart rke2

- name: Copy kubelet config file
  copy:
    src: "{{ kubelet_config_src }}"
    dest: "{{ rke2_config_dir }}/kubelet-config.yaml"
    mode: '0644'
  when: kubelet_config is defined and kubelet_config | length > 0
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ containerd_registry_src }}"
    dest: "{{ rke2_config_dir }}/containerd-registry.yaml"
    mode: '0644'
  when: containerd_registry_config is defined and containerd_registry_config | length > 0
  notify: restart rke2

- name: Start RKE2 service
  service:
    name: "{{ rke2_service }}"
    state: started
    enabled: true
  retries: 5
  delay: 10
  until: result is succeeded
  register: result
  notify: restart rke2

- name: Mask other RKE2 services
  systemd:
    name: "{{ item }}"
    masked: true
  with_items:
    - rke2-server.service
    - rke2-agent.service
  when: rke2_type == 'agent'

- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
  register: node_ready
  until: node_ready.stdout == "True"
  retries: 30
  delay: 10

- name: Wait for remaining nodes to be ready - with CNI
  shell: |
    kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
  register: node_ready_cni
  until: node_ready_cni.stdout == "True"
  retries: 30
  delay: 10


