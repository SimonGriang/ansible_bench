- name: ansible.builtin.import_tasks
  ansible.builtin.import_tasks: common.yml
  ignore_errors: true
  changed_when: false

- name: ansible.builtin.wait_for
  ansible.builtin.wait_for:
    port: 22
    host: "{{ inventory_hostname }}"
    state: started
  changed_when: false

- name: Prepare system # noqa: key-order
  block:
    - name: Test connection and sudo availability
      ansible.builtin.raw: "echo 'test'"
      register: test_result
      ignore_errors: true
      changed_when: false
    - name: Check sudo availability
      ansible.builtin.raw: "sudo -n true"
      register: sudo_result
      ignore_errors: true
      changed_when: false
  rescue:
    - name: Gather bootstrap facts
      ansible.builtin.setup:
        gather_subset: all
      changed_when: false
    - name: Install bootstrap packages using raw
      ansible.builtin.raw: "yum install -y {{ bootstrap_facts_packages | join(' ') }}"
      changed_when: false
  when: test_result is failed or sudo_result is failed

- name: Gather ansible facts
  ansible.builtin.setup:
  changed_when: false

