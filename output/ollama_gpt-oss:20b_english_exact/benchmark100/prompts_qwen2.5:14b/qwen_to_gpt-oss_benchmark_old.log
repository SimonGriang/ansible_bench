---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install python pip
  package:
    name: "{{ python_pip_name }}"
    state: present
  become: true

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    regexp: '^\\s*proxy\\s*=\\s*.*$'
    line: "proxy = {{ python_pip_proxy }}"
    insertafter: '^\\[global\\]'
    state: present
  when: python_pip_proxy is defined
  become: true

- name: Trust hosts
  lineinfile:
    path: /etc/pip.conf
    regexp: '^\\s*trusted-host\\s*=\\s*.*$'
    line: "trusted-host = {{ item }}"
    insertafter: '^\\[global\\]'
    state: present
  loop: "{{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined
  become: true

- name: Update pip
  pip:
    name: pip
    state: latest
  when: python_pip_update | bool and ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'
  become: true

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
