---
- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that:
      - ansible_facts['init_system'] == 'systemd'
    fail_msg: "System does not use systemd as init system"

- name: Get latest release of promtail
  block:
    - name: Fetch latest release info
      ansible.builtin.uri:
        url: https://api.github.com/repos/grafana/loki/releases/latest
        return_content: yes
        status_code: 200
      register: promtail_release
    - name: Set promtail_version
      ansible.builtin.set_fact:
        promtail_version: "{{ promtail_release.json.tag_name }}"

- name: Test if zip local archive exists
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}-{{ go_arch }}.zip"
  register: local_archive

- name: Assert local binary exists
  ansible.builtin.assert:
    that:
      - local_archive.stat.exists
    fail_msg: "Local binary not found at {{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}-{{ go_arch }}.zip"
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  block:
    - name: Download checksum file
      ansible.builtin.uri:
        url: https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail-{{ promtail_version }}.sha256sum
        return_content: yes
        status_code: 200
      register: promtail_checksums
    - name: Set promtail_checksums_content
      ansible.builtin.set_fact:
        promtail_checksums_content: "{{ promtail_checksums.content }}"

- name: Get checksum for specific architecture
  ansible.builtin.set_fact:
    promtail_checksum: "{{ promtail_checksums_content | regex_search('^[a-f0-9]+\\s+promtail-' + promtail_version + '-' + go_arch + '\\.zip', '\\g<0>') | regex_replace('^([a-f0-9]+).*$', '\\1') }}"



