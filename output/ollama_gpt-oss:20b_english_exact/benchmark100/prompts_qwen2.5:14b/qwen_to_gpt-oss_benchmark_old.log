---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  ansible.builtin.ini_file:
    path: /etc/mysql/my.cnf
    section: mysqld
    option: "{{ item.key }}"
    value: "{{ item.value }}"
  loop: "{{ mysql_configuration_options | dict2items }}"

- name: Configure mysql client
  ansible.builtin.ini_file:
    path: /etc/mysql/my.cnf
    section: client
    option: socket
    value: "{{ mysql_client_socket }}"

- name: Initialize mysql
  ansible.builtin.command: mysql_install_db
  when: ansible_os_family in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Place my.cnf
  ansible.builtin.copy:
    src: my.cnf
    dest: /etc/mysql/my.cnf
    mode: '0644'

- name: Create databases
  ansible.builtin.mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  when: not item.init_import | default(false)

- name: List databases
  ansible.builtin.command: mysql -u root -p{{ mysql_root_password }} -e "SHOW DATABASES;"
  register: db_list

- name: Import database
  ansible.builtin.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.import_file }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  when: item.init_import | default(false) and (item.name not in db_list.stdout)

- name: Create users
  ansible.builtin.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


