---
- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Include OS-specific variables based on distribution
  include_vars:
    file: "{{ ansible_distribution | lower }}.yml"

- name: Include architecture-specific variables
  include_vars:
    file: "{{ ansible_architecture | lower }}.yml"

- name: Set OS-specific variables (part I)
  set_fact:
    java_install_path: "/usr/lib/jvm"
  when: java_install_path is not defined or java_install_path is none

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    java_arch: "{{ ansible_architecture }}"
  when: java_arch is not defined or java_arch is none

- name: Set specific variables
  set_fact:
    java_home: "{{ java_install_path }}/java-{{ java_version }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "{{ item }}"
        state: absent
      loop: "{{ deprecated_deb_repos | default([]) }}"
    - name: Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ deb_extra_tools | default([]) }}"
    - name: Add key repositories
      apt_key:
        url: "{{ item }}"
        state: present
      loop: "{{ deb_repo_keys | default([]) }}"
    - name: Add repositories
      apt_repository:
        repo: "{{ item }}"
        state: present
      loop: "{{ deb_repos | default([]) }}"
  when: ansible_os_family == "Debian"

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: "{{ item }}"
        state: present
      loop: "{{ rhel_repo_keys | default([]) }}"
    - name: Add repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        enabled: true
        gpgcheck: true
        gpgkey: "{{ item.gpgkey }}"
      loop: "{{ rhel_repos | default([]) }}"
  when: ansible_os_family == "RedHat"

- name: Install required libraries
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libs | default([]) }}"

- name: Install Java, Debian
  apt:
    name: "{{ java_package }}"
    state: present
    update_cache: yes
  register: java_install_debian
  until: java_install_debian is succeeded
  retries: 3
  delay: 10

- name: Install Java, RedHat
  yum:
    name: "{{ java_package }}"
    state: present
    update_cache: yes
  register: java_install_redhat
  until: java_install_redhat is succeeded
  retries: 3
  delay: 10

- name: Export environment variables
  template:
    src: java_env.j2
    dest: /etc/profile.d/java.sh
    mode: '0644'

- name: Source environment variables
  shell: source /etc/profile.d/java.sh
  args:
    executable: /bin/bash
  ignore_errors: yes

- name: Correct java version selected for Java versions less than 11
  alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_home }}/bin/java"
    priority: "{{ java_version | int }}"
  when:
    - ansible_os_family == "Debian"
    - java_version | int < 11

- name: Correct java version selected for Java versions greater than or equal to 11
  alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_home }}/bin/java"
    priority: "{{ java_version | int }}"
  when:
    - ansible_os_family == "Debian"
    - java_version | int >= 11


