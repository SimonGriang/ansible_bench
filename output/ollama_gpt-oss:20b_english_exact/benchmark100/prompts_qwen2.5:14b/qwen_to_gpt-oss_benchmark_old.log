---
- name: Lookup bootstrap facts
  ansible.builtin.command: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
- name: Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: >-
      {{
        bootstrap_os_family_map[
          bootstrap_facts.stdout
          | regex_search('^ID=(.*)$', '\\1', multiline=True)
          | regex_replace('\"', '')
        ]
      }}
    bootstrap_distribution_major_version: >-
      {{
        (bootstrap_facts.stdout
          | regex_search('^VERSION_ID=(.*)$', '\\1', multiline=True)
          | regex_replace('\"', '')
        ).split('.')[0]
      }}
- name: Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ bootstrap_os_family_map[bootstrap_distribution] }}"


