---
- name: Create etcd group
  ansible.builtin.group:
    name: etcd
    state: present
    system: true

- name: Create etcd user
  ansible.builtin.user:
    name: etcd
    comment: etcd user
    group: etcd
    shell: /bin/nologin
    system: true
    state: present

- name: Check if /usr/local is writable
  ansible.builtin.command: test -w /usr/local
  register: usr_local_writable
  ignore_errors: true
  changed_when: false

- name: Determine etcd sysctl source
  ansible.builtin.set_fact:
    etcd_sysctl_src: "/usr/local/share/rke2/rke2-cis-sysctl.conf"
  when: usr_local_writable.rc == 0

- name: Determine etcd sysctl source fallback
  ansible.builtin.set_fact:
    etcd_sysctl_src: "/opt/rke2/share/rke2/rke2-cis-sysctl.conf"
  when: usr_local_writable.rc != 0

- name: Copy systemctl config file for kernel hardening
  ansible.builtin.copy:
    src: "{{ etcd_sysctl_src }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: '0600'
  notify: restart systemd-sysctl

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


