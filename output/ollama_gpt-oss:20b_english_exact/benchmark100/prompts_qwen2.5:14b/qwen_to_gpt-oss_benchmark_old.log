---
- name: Task 1: Check if Helm binary exists.
  stat:
    path: "{{ helm_path }}"
  register: helm_stat

- name: Task 2: Check Helm version.
  command: "{{ helm_path }} version --short"
  register: helm_version
  changed_when: false
  when: helm_stat.stat.exists

- name: Task 3: Download helm.
  get_url:
    url: "{{ helm_download_url }}"
    dest: "/tmp/helm"
    mode: '0755'
  register: helm_downloaded
  when: not helm_stat.stat.exists or helm_version.stdout != helm_expected_version

- name: Task 4: Copy helm binary into place.
  copy:
    src: "/tmp/helm"
    dest: "{{ helm_path }}"
    mode: '0755'
  when: helm_downloaded.changed


