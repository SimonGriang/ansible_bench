---
- name: check if all variables have been set correctly
  assert:
    that:
      - bootstrap_wait_for_host is defined
      - bootstrap_install.raw is defined
    fail_msg: "Required variables are not set."
    success_msg: "All required variables are set."

- name: wait for host (when configured)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 22
    delay: 10
    timeout: 300
  when: bootstrap_wait_for_host | bool

- name: prepare system
  block:
    - name: establish connection to the host and gather facts
      setup:
    - name: include tasks to gather bootstrap facts (raw)
      include_tasks: gather_bootstrap_facts_raw.yml
  rescue:
    - name: debug message if connection cannot be established
      debug:
        msg: "Connection to host {{ inventory_hostname }} could not be established."

- name: Install bootstrap packages (raw)
  command: "{{ bootstrap_install.raw }}"
  when: bootstrap_install.raw is defined

- name: ensure system is prepared by issuing ansible modules
  block:
    - name: gather ansible facts
      setup:
    - name: install bootstrap packages using ansible package module
      package:
        name: "{{ bootstrap_facts.packages }}"
        state: present
  when: bootstrap_facts is defined


