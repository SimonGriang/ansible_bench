---
- name: Cordon and Drain the node {{ rke2_node_name }}
  shell: |
    kubectl cordon {{ rke2_node_name }} && \
    kubectl drain {{ rke2_node_name }} --ignore-daemonsets \
      --delete-emptydir-data \
      --timeout=5m {{ rke2_drain_additional_args }}
  register: drain_result
  changed_when: drain_result.rc == 0
  until: drain_result.rc == 0
  retries: 100
  delay: 15
  ignore_errors: true

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2-server
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: |
    kubectl get nodes --no-headers -o \
      custom-columns=:.status.conditions[?(@.type=="Ready")].status
    grep -q False
  register: nodes_ready
  changed_when: false
  failed_when: false
  until: nodes_ready.rc != 0
  retries: 100
  delay: 15

- name: Uncordon the node {{ rke2_node_name }}
  shell: kubectl uncordon {{ rke2_node_name }}
  when: rke2_drain_node_during_upgrade | bool
  register: uncordon_result
  changed_when: uncordon_result.rc == 0

- name: Wait for all pods to be ready again
  shell: |
    kubectl get pods --all-namespaces --no-headers -o \
      custom-columns=:.status.phase |
      grep -vE 'Running|Succeeded' |
      grep -q .
  register: pods_ready
  changed_when: false
  failed_when: false
  until: pods_ready.rc != 0
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready | bool

- name: Wait for all pods to pass readiness checks
  shell: kubectl wait --for=condition=Ready pod --all --timeout=5s
  register: pods_ready_checks
  changed_when: false
  failed_when: false
  until: pods_ready_checks.rc == 0
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy | bool


