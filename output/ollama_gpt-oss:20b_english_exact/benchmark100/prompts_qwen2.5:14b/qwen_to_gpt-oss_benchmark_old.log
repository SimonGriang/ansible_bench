---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  block:
    - name: Test connection and sudo availability
      raw: "echo 'test'"
      register: test_result
      ignore_errors: true
    - name: Check sudo availability
      raw: "sudo -n true"
      register: sudo_result
      ignore_errors: true
  rescue:
    - name: Gather bootstrap facts
      setup:
        gather_subset: all
    - name: Install bootstrap packages using raw
      raw: "yum install -y {{ bootstrap_facts_packages | join(' ') }}"
  when: test_result is failed or sudo_result is failed

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes


