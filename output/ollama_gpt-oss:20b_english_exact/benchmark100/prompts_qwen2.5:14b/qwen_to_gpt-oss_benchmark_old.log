---  
- name: Download RKE2 installation script  
  get_url:  
    url: "{{ rke2_install_script_url }}"  
    dest: "{{ rke2_install_script_dest }}"  
    mode: "{{ rke2_install_script_mode | default('0755') }}"  
    timeout: "{{ rke2_install_script_timeout | default(30) }}"

- name: Copy local RKE2 installation script  
  copy:  
    src: "{{ rke2_local_install_script_path }}"  
    dest: "{{ rke2_install_script_dest }}"  
    mode: '0700'  
    force: yes  
  when: rke2_airgap_mode is defined and rke2_airgap_implementation is defined

- name: Create RKE2 artifacts folder  
  file:  
    path: "{{ rke2_artifacts_path }}"  
    state: directory  
    mode: '0700'  
  when: rke2_airgap_mode is defined and rke2_airgap_implementation != 'exists'

- name: Download RKE2 checksum and artifacts  
  block:  
    - name: Download checksum file  
      get_url:  
        url: "{{ rke2_checksum_url }}"  
        dest: "{{ rke2_checksum_dest }}"  
        mode: '0644'  
    - name: Download artifacts  
      get_url:  
        url: "{{ rke2_artifacts_url }}"  
        dest: "{{ rke2_artifacts_dest }}"  
        mode: '0644'  
    - name: Download install script  
      get_url:  
        url: "{{ rke2_install_script_url }}"  
        dest: "{{ rke2_install_script_dest }}"  
        mode: '0700'  
  when: rke2_airgap_mode is defined and rke2_airgap_implementation == 'download'

- name: Rescue for failed download  
  block:  
    - name: Create local temp directory  
      file:  
        path: "/tmp/rke2_download"  
        state: directory  
        mode: '0700'  
    - name: Download artifacts locally  
      get_url:  
        url: "{{ rke2_artifacts_url }}"  
        dest: "/tmp/rke2_download/artifacts"  
        mode: '0644'  
      delegate_to: localhost  
    - name: Download install script locally  
      get_url:  
        url: "{{ rke2_install_script_url }}"  
        dest: "/tmp/rke2_download/install_script"  
        mode: '0700'  
      delegate_to: localhost  
    - name: Copy artifacts to remote  
      copy:  
        src: "/tmp/rke2_download/artifacts"  
        dest: "{{ rke2_artifacts_dest }}"  
        mode: '0640'  
        force: yes  
    - name: Copy install script to remote  
      copy:  
        src: "/tmp/rke2_download/install_script"  
        dest: "{{ rke2_install_script_dest }}"  
        mode: '0700'  
        force: yes  
  rescue:  
    - name: Fail on download error  
      fail:  
        msg: "Failed to download RKE2 artifacts and install script."  

- name: Copy local RKE2 artifacts  
  copy:  
    src: "{{ rke2_local_artifacts_path }}"  
    dest: "{{ rke2_artifacts_dest }}"  
    mode: '0640'  
    force: yes  
  when: rke2_airgap_mode is defined and rke2_airgap_implementation == 'copy'

- name: Airgap mode - additional images tarballs  
  block:  
    - name: Create folder for additional images tarballs  
      file:  
        path: "{{ rke2_tarball_images_path }}"  
        state: directory  
        mode: '0755'  
    - name: Copy additional tarballs  
      copy:  
        src: "{{ item }}"  
        dest: "{{ rke2_tarball_images_path }}/{{ item | basename }}"  
        mode: '0644'  
        force: yes  
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"  
  when: rke2_airgap_mode is defined and rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation != 'exists'

- name: Ensure artifacts exist and have acceptable permissions  
  block:  
    - name: Ensure artifacts permissions  
      file:  
        path: "{{ rke2_artifacts_dest }}"  
        mode: '0640'  
        state: file  
    - name: Ensure install script permissions  
      file:  
        path: "{{ rke2_install_script_dest }}"  
        mode: '0700'  
        state: file  
  when: rke2_airgap_mode is defined and rke2_airgap_implementation == 'exists'

- name: Populate service facts  
  service_facts:

- name: Get stats of the FS object  
  stat:  
    path: /usr/local  
  register: usr_local_stat

- name: Check if separate partition  
  command: grep -q '/usr/local ' /proc/mounts  
  register: usr_local_partition_check  
  ignore_errors: yes

- name: Set RKE2 bin path  
  set_fact:  
    rke2_bin_path: "{{ '/usr/local/bin' if usr_local_partition_check.rc == 0 else '/usr/bin' }}"

- name: Check RKE2 version  
  command: "{{ rke2_bin_path }}/rke2 --version"  
  register: rke2_version_output

- name: Set RKE2 versions  
  set_fact:  
    rke2_installed_version: "{{ rke2_version_output.stdout | regex_search('v[0-9.]+') }}"  
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade  
  fail:  
    msg: "Attempted to downgrade RKE2 from {{ rke2_installed_version }} to {{ rke2_desired_version }}"  
  when: rke2_allow_downgrade is not defined or not rke2_allow_downgrade

- name: Run RKE2 install script  
  command: "{{ rke2_install_script_dest }} {{ rke2_install_script_args | default('') }}"  
  environment:  
    RKE2_AIRGAP_MODE: "{{ rke2_airgap_mode | default('') }}"  
    RKE2_AIRGAP_IMPLEMENTATION: "{{ rke2_airgap_implementation | default('') }}"  
  when: rke2_installed_version is not defined or rke2_installed_version != rke2_desired_version and not ansible_check_mode

- name: Copy Custom Manifests  
  copy:  
    src: "{{ item }}"  
    dest: "{{ rke2_data_path }}/manifests/{{ item | basename }}"  
    mode: '0644'  
    force: yes  
  loop: "{{ rke2_custom_manifests }}"  
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods  
  copy:  
    src: "{{ item }}"  
    dest: "{{ rke2_agent_pod_manifests_path }}/{{ item | basename }}"  
    mode: '0644'  
    force: yes  
  loop: "{{ rke2_static_pods }}"  
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file  
  copy:  
    src: "{{ rke2_environment_file_src }}"  
    dest: "{{ rke2_environment_file_dest }}"  
    mode: '0644'  
    force: yes  
  when: rke2_environment_options is defined and rke2_environment_options | length > 0


