---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install prerequisites
  ansible.builtin.package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  ansible.builtin.include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  ansible.builtin.blockinfile:
    path: /etc/vault.d/vault.env
    block: |
      {% for key, value in vault_environment_settings.items() %}
      {{ key }}={{ value }}
      {% endfor %}
    create: true
    mode: '0600'
  notify: Restart vault

- name: Include hardening tasks
  ansible.builtin.include_tasks: hardening.yml

- name: Start and enable vault
  ansible.builtin.service:
    name: vault
    state: started
    enabled: true
  when: vault_type == 'oss'

- name: Enable vault
  ansible.builtin.service:
    name: vault
    enabled: true
  when: vault_type != 'oss'


