---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis:8
    state: enabled

- name: Install redis
  dnf:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: redis.conf.j2
    dest: /etc/redis/redis.conf
    owner: redis
    group: redis
    mode: '0644'
  notify: restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


