---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    state: started

- name: Prepare system
  ansible.builtin.command: true
  become: true
  become_user: root
  become_method: sudo
  become_flags: -n

- name: Gather bootstrap facts
  ansible.builtin.setup:
    gather_subset: all

- name: Install bootstrap packages (raw)
  ansible.builtin.raw: "{{ bootstrap_raw_cmd }}"
  become: true
  when: bootstrap_raw_cmd is defined

- name: Ensure libdnf5 is present on Fedora/RedHat
  ansible.builtin.package:
    name: libdnf5
    state: present
  become: true
  when: ansible_os_family in ['RedHat', 'Fedora']

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_packages }}"
    state: present
    update_cache: yes
  become: true


