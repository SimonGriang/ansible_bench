---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"

- name: Install RPM
  yum:
    name: "{{ oracle_java_rpm_path }}"
    state: present

- name: Install DEB
  apt:
    deb: "{{ oracle_java_deb_path }}"
    state: present

- name: Install oracle java (rpm) (repository)
  yum:
    name: oracle-java
    state: present

- name: Configure oracle targz
  unarchive:
    src: "{{ oracle_java_targz_path }}"
    dest: "{{ oracle_java_install_dir }}"
    remote_src: yes
    creates: "{{ oracle_java_install_dir }}/bin/java"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ jce_policy_zip }}"
    dest: "{{ oracle_java_install_dir }}/jre/lib/security"
    remote_src: yes
    creates: "{{ oracle_java_install_dir }}/jre/lib/security/US_export_policy.jar"

- name: Set alternative (targz)
  alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ oracle_java_install_dir }}/bin/java"
    priority: 100
  when: not ansible_facts['os_family'] == 'Alpine'

- name: Find JAVA_HOME
  command: readlink -f $(which java)
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME={{ java_home_result.stdout | dirname | dirname }}"
    state: present


