---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: main_mailer_type
    value: No configuration
    vtype: string
    priority: low

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: >
    'mysql' in postfix_virtual_mailbox_maps or
    'mysql' in postfix_virtual_mailbox_domains or
    'mysql' in postix_virtual_alias_maps

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
  notify:
    - validate_postfix_config
    - rebuild_transport_maps

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - validate_postfix_config
    - reload_postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default(omit) }}"
    smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default(omit) }}"
  when: postfix_smtpd_recipient_restrictions is defined or postfix_smtpd_sender_restrictions is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    mynetworks: "{{ postfix_mynetworks | default(omit) }}"
    mydestination: "{{ postfix_mydestination | default(omit) }}"
    relay_domains: "{{ postfix_relay_domains | default(omit) }}"
    smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default(omit) }}"
    smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default(omit) }}"
    virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default(omit) }}"
    virtual_alias_domains: "{{ postfix_virtual_alias_domains | default(omit) }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - validate_postfix_config
    - restart_postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - validate_postfix_config
    - restart_postfix

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0644'
  notify: reload_postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_source }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0600'
  notify: reload_postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/postfix/aliases
  notify:
    - rebuild_alias_database
    - reload_postfix

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
  notify:
    - rebuild_sender_access_database
    - reload_postfix

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
  notify:
    - validate_postfix_config
    - rebuild_recipient_access_database
    - reload_postfix

- name: Place sasl_password_map
  copy:
    content: "{{ sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password_map
    mode: '0600'
  notify: rebuild_sasl_password_map_database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true


