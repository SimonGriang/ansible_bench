content='---\n- name: Ensure document root directories are created for each virtual host\n  file:\n    path: "{{ item.docroot }}"\n    state: directory\n    mode: \'0755\'\n  loop: "{{ httpd_vhosts }}"\n  when: item.docroot is defined and (item.create_docroot is not defined or item.create_docroot)\n\n- name: Create virtual host configuration files\n  template:\n    src: "{{ vhost_conf_template }}"\n    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"\n    mode: \'0644\'\n  loop: "{{ httpd_vhosts }}"\n  notify:\n    - test_apache_config\n    - restart_apache_server\n\n- name: Enable virtual hosts on Debian-based systems\n  command: "a2ensite {{ item.name }}.conf"\n  loop: "{{ httpd_vhosts }}"\n  when: ansible_os_family == \'Debian\'\n  creates: "/etc/apache2/sites-enabled/{{ item.name }}.conf"\n  notify:\n    - test_apache_config\n    - restart_apache_server' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-09T13:07:41.909953341Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14107822095, 'load_duration': 169546046, 'prompt_eval_count': 542, 'prompt_eval_duration': 145070002, 'eval_count': 1441, 'eval_duration': 13792269084, 'model_name': 'gpt-oss:20b'} id='run--83efa493-e6ed-4d3e-9641-45e8679d0c82-0' usage_metadata={'input_tokens': 542, 'output_tokens': 1441, 'total_tokens': 1983}
