---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_server_type == 'server'

- name: Copy RKE2 configuration file
  template:
    src: config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet configuration file
  template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  template:
    src: registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0644'
  when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)
  notify: Config file changed

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: (rke2_etcd_snapshot_file | length > 0) and ((service_rke2_server_state is defined and service_rke2_server_state == 'disabled') or service_rke2_server_state is undefined)

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: (rke2_etcd_snapshot_file | length > 0) and rke2_etcd_snapshot_s3_options is defined

- name: Restore etcd from file
  block:
    - name: Create the RKE2 etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/server/db/etcd
        state: directory
        mode: '0755'
    - name: Copy the etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/etcd/backup.db
        mode: '0644'
    - name: Restore etcd from the snapshot file
      command: rke2 etcd-snapshot restore --data-dir /var/lib/rancher/rke2/server/db/etcd --snapshot /var/lib/rancher/rke2/server/db/etcd/backup.db
      args:
        chdir: /var/lib/rancher/rke2/server/db/etcd
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  command: >-
    rke2 etcd-snapshot restore --data-dir /var/lib/rancher/rke2/server/db/etcd --s3
    --s3-access-key "{{ rke2_etcd_snapshot_s3_options.access_key }}"
    --s3-secret-key "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
    --s3-bucket "{{ rke2_etcd_snapshot_s3_options.bucket }}"
    --s3-snapshot-name "{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    state: stopped
    enabled: false
    masked: true

- name: Wait for the first server be ready - no CNI
  shell: kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
  register: node_ready_no_cni
  until: node_ready_no_cni.stdout == "True"
  retries: 30
  delay: 10

- name: Wait for the first server be ready - with CNI
  shell: kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
  register: node_ready_cni
  until: node_ready_cni.stdout == "True"
  retries: 30
  delay: 10

- name: Restore etcd
  block:
    - name: Get registered nodes
      command: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
      register: registered_nodes
    - name: Remove old node secrets
      command: kubectl delete secret -n kube-system {{ item }}
      loop: "{{ registered_nodes.stdout.split() }}"
    - name: Remove old nodes
      command: kubectl delete node {{ item }}
      loop: "{{ registered_nodes.stdout.split() }}"
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: inventory_hostname in groups[rke2_cluster_group_name]


