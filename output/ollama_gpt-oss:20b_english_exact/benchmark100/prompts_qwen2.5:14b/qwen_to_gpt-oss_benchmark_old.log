- name: Set alternative (targz)
  alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ oracle_java_install_dir }}/bin/java"
    priority: 100
  when: not ansible_facts['os_family'] == 'Alpine'

- name: Find JAVA_HOME
  command: readlink -f $(which java)
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME={{ java_home_result.stdout | dirname | dirname }}"
    state: present


