---
- name: Create local ssh_key_directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ user.ssh_key_directory }}"
    state: directory
    mode: '0750'
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | default(false)

- name: Manage user {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    password: "{{ user.password | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    append: "{{ user.append | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    comment: "{{ user.comment | default(omit) }}"
    create_home: "{{ user.create_home | default(omit) }}"
    home: "{{ user.home | default(omit) }}"
    system: "{{ user.system | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    gid: "{{ user.gid | default(omit) }}"
  become: true

- name: Set sudo options for {{ user.name }}
  ansible.builtin.copy:
    dest: "/etc/sudoers.d/{{ user.name }}"
    content: "{{ user.sudo_options }}"
    mode: '0640'
    validate: '/usr/sbin/visudo --check %s'
  become: true
  when: user.sudo_options is defined

- name: Remove sudo options for {{ user.name }}
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  become: true
  when: user.sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  ansible.builtin.openssh_keypair:
    path: "{{ user.ssh_key_directory }}/id_rsa"
    type: rsa
    size: 2048
    force: false
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | default(false)

- name: Generate public ssh key for {{ user.name }}
  ansible.builtin.copy:
    src: "{{ user.ssh_key_directory }}/id_rsa.pub"
    dest: "{{ user.ssh_key_directory }}/id_rsa.pub"
    mode: '0644'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | default(false)

- name: Convert ssh key to ppk for {{ user.name }}
  ansible.builtin.command:
    cmd: "puttygen {{ user.ssh_key_directory }}/id_rsa -O private -o {{ user.ssh_key_directory }}/id_rsa.ppk"
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key | default(false)

- name: Get or set the home directory for {{ user.name }}
  ansible.builtin.set_fact:
    user_home: "{{ user.home | default(omit) }}"

- name: Create .ssh directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ user.home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  become: true
  when: user.manage_ssh_key | default(false) or user.private_keys is defined

- name: Deploy authorized keys for {{ user.name }}
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys | default([]) }}"
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for {{ user.name }}
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys | default([]) }}"
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for {{ user.name }}
  ansible.builtin.copy:
    src: "{{ user.ssh_key_directory }}/id_rsa"
    dest: "{{ user.home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.copy_private_key | default(false)

- name: Check users password valid time for {{ user.name }}
  ansible.builtin.command:
    cmd: "chage -l {{ user.name }} | grep 'Password expires'"
  register: password_expiry
  when: user.password_validity_days is defined

- name: Set users password valid time for {{ user.name }}
  ansible.builtin.command:
    cmd: "chage -M {{ user.password_validity_days }} {{ user.name }}"
  when:
    - user.password_validity_days is defined
    - password_expiry.stdout | regex_search('max days') | default('') != user.password_validity_days | string

- name: Place private key file for {{ user.name }}
  ansible.builtin.copy:
    src: "{{ item.key_path }}"
    dest: "{{ user.home }}/.ssh/{{ item.filename | default(item.key_path | basename) }}"
    mode: "{{ item.mode | default('0600') }}"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  loop: "{{ user.private_keys | default([]) }}"
  when: user.private_keys is defined



