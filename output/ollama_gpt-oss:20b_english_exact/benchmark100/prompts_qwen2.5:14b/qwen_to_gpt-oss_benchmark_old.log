---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_user }}"
  register: git_user_info

- name: Create directory for git configuration
  file:
    path: "{{ git_user_home }}/.gitconfig"
    state: directory
  when:
    - git_user_info is defined
    - git_user_info.getent | length > 0
    - git_user_home is defined

- name: Place git configuration
  copy:
    src: gitconfig
    dest: "{{ git_user_home }}/.gitconfig"
  when:
    - git_user_info is defined
    - git_user_info.getent | length > 0
    - git_user_home is defined
    - git_config_file is defined

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
  when:
    - git_user_info is defined
    - git_user_info.getent | length > 0
    - repository_destination is defined

- name: Clone all roles
  git:
    repo: "{{ item }}"
    dest: "{{ repository_destination }}/{{ item | basename | regex_replace('\\.git$', '') }}"
    version: master
  loop: "{{ git_repositories }}"
  become: true
  become_user: "{{ git_user }}"
  when:
    - git_user_info is defined
    - git_user_info.getent | length > 0
    - repository_destination is defined
    - git_repositories is defined


