---
- name: Enable proxy modules in Apache
  apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  when: ansible_facts.os_family in ['Debian', 'Suse']

- name: Configure Apache locations using a template
  template:
    src: locations.conf.j2
    dest: "{{ '/etc/apache2/sites-available/locations.conf' if ansible_facts.os_family == 'Debian' else '/etc/apache2/conf.d/locations.conf' }}"
    mode: '0644'
  notify:
