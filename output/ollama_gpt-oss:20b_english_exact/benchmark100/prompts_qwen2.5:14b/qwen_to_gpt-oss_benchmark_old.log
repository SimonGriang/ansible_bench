---
- name: Install Keepalived when HA mode is enabled
  ansible.builtin.include_tasks: install_keepalived.yml
  when: ha_mode_enabled

- name: Download and install RKE2
  ansible.builtin.include_tasks: download_install_rke2.yml

- name: CIS Hardening
  ansible.builtin.include_tasks: cis_hardening.yml
  when: cis_profile is defined

- name: Find Active Server
  ansible.builtin.include_tasks: find_active_server.yml

- name: Enable IPVS kernel module
  ansible.builtin.include_tasks: enable_ipvs_module.yml
  when: kube_vip_enabled and ha_mode_enabled

- name: Copy kube-vip manifests to the masternode
  ansible.builtin.include_tasks: copy_kubevip_manifests.yml
  when: not keepalived_enabled

- name: Copy ingress-nginx manifests to the masternode
  ansible.builtin.include_tasks: copy_ingress_nginx_manifests.yml
  when: ingress_nginx_config is defined

- name: Prepare very first server node in the cluster
  ansible.builtin.include_tasks: prepare_first_server.yml

- name: Restore etcd specific tasks
  ansible.builtin.include_tasks: restore_etcd.yml
  when: etcd_restore_needed

- name: Download kubeconfig to ansible localhost
  ansible.builtin.include_tasks: download_kubeconfig.yml
  when: kubeconfig_download_enabled

- name: Prepare and join remaining nodes of the cluster
  ansible.builtin.include_tasks: join_remaining_nodes.yml
  when: active_server is defined

- name: Rolling cordon and drain restart when version changes - servers
  ansible.builtin.include_tasks: rolling_restart_servers.yml
  when: rke2_version_changed and inventory_hostname in groups['rke2_server']

- name: Rolling cordon and drain restart when version changes - agents
  ansible.builtin.include_tasks: rolling_restart_agents.yml
  when: rke2_version_changed and inventory_hostname in groups['rke2_agent']

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Rolling restart when config files change
  ansible.builtin.include_tasks: rolling_restart_config.yml
  when: config_changed

- name: Final steps
  ansible.builtin.include_tasks: final_steps.yml


