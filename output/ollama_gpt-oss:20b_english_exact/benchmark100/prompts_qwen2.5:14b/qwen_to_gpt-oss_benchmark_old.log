---
- name: Task 1: Load OS-specific vars
  include_vars:
    file: "{{ ansible_os_family | lower }}.yml"

- name: Task 2: Include RedHat-specific setup tasks
  include_tasks: setup-RedHat.yml
  when: ansible_os_family == 'RedHat'

- name: Task 3: Include Debian-specific setup tasks
  include_tasks: setup-Debian.yml
  when: ansible_os_family == 'Debian'

- name: Task 4: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_version < '2.12' or ansible_os_family not in ['RedHat', 'Debian'] }}"

- name: Task 5: Install Docker packages (with downgrade option)
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: true
  notify: restart docker
  when: (ansible_version >= '2.12') and (ansible_os_family in ['RedHat', 'Debian'])

- name: Task 6: Install docker-compose plugin
  package:
    name: docker-compose
    state: present
  notify: restart docker
  when: docker_install_compose_plugin and (ansible_version < '2.12' or ansible_os_family not in ['RedHat', 'Debian'])

- name: Task 7: Install docker-compose-plugin (with downgrade option)
  package:
    name: docker-compose
    state: present
    allow_downgrade: true
  notify: restart docker
  when: docker_install_compose_plugin and (ansible_version >= '2.12') and (ansible_os_family in ['RedHat', 'Debian'])

- name: Task 8: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: '0755'
  when: docker_daemon_options is defined

- name: Task 9: Configure Docker daemon options
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_nice_json }}"
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options is defined

- name: Task 10: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: "{{ ansible_check_mode }}"

- name: Task 11: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Task 12: Include docker-compose.yml tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Task 13: Get docker group info using getent
  getent:
    database: group
    key: docker
  register: docker_group_info

- name: Task 14: Check if there are any users to add to the docker group
  set_fact:
    docker_users_to_add: "{{ docker_users | default([]) }}"
  when: docker_users | length > 0

- name: Task 15: Include docker-users.yml tasks
  include_tasks: docker-users.yml
  when: docker_users_to_add | length > 0


