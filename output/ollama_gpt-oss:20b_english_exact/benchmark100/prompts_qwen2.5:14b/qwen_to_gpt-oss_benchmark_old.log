---  
- name: Assert usage of systemd as an init system  
  assert:  
    that:  
      - ansible_facts.service_mgr == 'systemd'  
    fail_msg: "This role requires systemd as the init system."  

- name: Get latest release of promtail  
  uri:  
    url: https://api.github.com/repos/grafana/loki/releases/latest  
    return_content: yes  
    status_code: 200  
  register: promtail_release  

- name: Set promtail_version variable  
  set_fact:  
    promtail_version: "{{ promtail_release.json.tag_name | regex_replace('^v', '') }}"  

- name: Test if zip local archive exists  
  stat:  
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}-{{ go_arch }}.zip"  
  register: promtail_zip_local  

- name: Assert local binary exists  
  assert:  
    that:  
      - promtail_zip_local.stat.exists  
    fail_msg: "Local promtail binary not found in {{ promtail_binary_local_dir }}"  
  when: promtail_binary_local_dir is defined  

- name: Get checksum list  
  uri:  
    url: "{{ promtail_release.json.assets | selectattr('name', 'search', 'sha256') | first | default({}) | attr('browser_download_url') }}"  
    return_content: yes  
    status_code: 200  
  register: promtail_checksum_list  

- name: Get checksum for specific architecture  
  set_fact:  
    promtail_checksum: "{{ promtail_checksum_list.content.splitlines() | select('match', go_arch) | first | regex_replace('^\\s*([0-9a-fA-F]+).*$', '\\1') }}"  


