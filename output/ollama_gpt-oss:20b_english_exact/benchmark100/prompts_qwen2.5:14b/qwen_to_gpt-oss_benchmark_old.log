---
- name: create | Create ssl key
  ansible.builtin.openssl_privatekey:
    path: "{{ key_dir }}/{{ inventory_hostname }}.key"
    size: 2048
    mode: '0600'
    owner: root
    group: root

- name: create | Create ssl csr
  ansible.builtin.openssl_csr:
    path: "{{ csr_dir }}/{{ inventory_hostname }}.csr"
    privatekey_path: "{{ key_dir }}/{{ inventory_hostname }}.key"
    common_name: "{{ inventory_hostname }}"
    mode: '0644'
    owner: root
    group: root

- name: create | Create ssl certificates
  ansible.builtin.openssl_certificate:
    path: "{{ cert_dir }}/{{ inventory_hostname }}.crt"
    csr_path: "{{ csr_dir }}/{{ inventory_hostname }}.csr"
    privatekey_path: "{{ key_dir }}/{{ inventory_hostname }}.key"
    provider: selfsigned
    mode: '0644'
    owner: root
    group: root

- name: create | Create PKCS#12 file
  ansible.builtin.openssl_pkcs12:
    path: "{{ pkcs12_dir }}/{{ inventory_hostname }}.p12"
    certificate_path: "{{ cert_dir }}/{{ inventory_hostname }}.crt"
    privatekey_path: "{{ key_dir }}/{{ inventory_hostname }}.key"
    state: present
    mode: '0600'
    owner: root
    group: root
    passphrase: "{{ pkcs12_passphrase | default('changeme') }}"

- name: create | Read private key
  ansible.builtin.slurp:
    src: "{{ key_dir }}/{{ inventory_hostname }}.key"
  register: private_key_b64

- name: create | Read certificate
  ansible.builtin.slurp:
    src: "{{ cert_dir }}/{{ inventory_hostname }}.crt"
  register: certificate_b64

- name: create | Create combined private_key and certificate file
  ansible.builtin.copy:
    dest: "{{ combined_dir }}/{{ inventory_hostname }}.pem"
    content: >-
      {{ private_key_b64.content | b64decode ~
        certificate_b64.content | b64decode }}
    mode: '0600'
    owner: root
    group: root


