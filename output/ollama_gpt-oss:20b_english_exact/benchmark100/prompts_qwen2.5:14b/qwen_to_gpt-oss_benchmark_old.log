---
- name: Check current docker-compose version
  command: docker-compose --version
  register: docker_compose_output
  ignore_errors: true

- name: Set fact for current Docker Compose version
  set_fact:
    current_compose_version: "{{ docker_compose_output.stdout | regex_search('docker-compose version ([^,]+)', '\\1') }}"
  when: docker_compose_output.stdout is defined

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: current_compose_version is defined and current_compose_version != docker_compose_version

- name: Install Docker Compose (if configured)
  get_url:
    url: "https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-{{ ansible_system | lower }}-{{ ansible_architecture }}"
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when: docker_compose_version is defined and ((current_compose_version is not defined) or (current_compose_version != docker_compose_version) or (current_compose_version is version_compare('lt', docker_compose_version)))


