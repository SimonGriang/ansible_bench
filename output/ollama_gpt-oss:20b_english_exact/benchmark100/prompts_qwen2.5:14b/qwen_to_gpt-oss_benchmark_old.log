---
- name: Ensure old versions of Docker are not installed
  ansible.builtin.dnf:
    name:
      - docker
      - docker-client
      - docker-client-latest
      - docker-common
      - docker-latest
      - docker-latest-logrotate
      - docker-logrotate
      - docker-engine
      - docker-selinux
      - docker-ce
      - docker-ce-cli
      - docker-ce-rootless-extras
      - docker.io
    state: absent
    autoremove: yes

- name: Add Docker GPG key
  ansible.builtin.rpm_key:
    state: present
    key: https://download.docker.com/linux/centos/gpg

- name: Add Docker repository
  ansible.builtin.yum_repository:
    name: docker-ce
    description: Docker CE Stable Repository
    baseurl: https://download.docker.com/linux/centos/$releasever/$basearch/stable
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: yes

- name: Configure Docker Nightly repo
  ansible.builtin.yum_repository:
    name: docker-ce-nightly
    description: Docker CE Nightly Repository
    baseurl: https://download.docker.com/linux/centos/$releasever/$basearch/nightly
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: yes
  when: docker_nightly_repo_enabled | default(false)

- name: Configure Docker Test repo
  ansible.builtin.yum_repository:
    name: docker-ce-test
    description: Docker CE Test Repository
    baseurl: https://download.docker.com/linux/centos/$releasever/$basearch/test
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: yes
  when: docker_test_repo_enabled | default(false)

- name: Configure containerd on RHEL 8
  block:
    - name: Ensure runc is not installed
      ansible.builtin.dnf:
        name: runc
        state: absent
    - name: Ensure container-selinux is installed
      ansible.builtin.dnf:
        name: container-selinux
        state: present
    - name: Ensure containerd.io is installed
      ansible.builtin.dnf:
        name: containerd.io
        state: present
  when: ansible_facts['os_family'] == 'RedHat' and ansible_facts['distribution_major_version'] | int == 8


