---
- name: hardening | Disable swap
  shell: |
    swapoff -a
    sed -i '/ swap / s/^/#/' /etc/fstab
  args:
    warn: false
  when: vault_hardening_disable_swap

- name: hardening | Disable swap now
  command: swapoff -a
  when: ansible_swaptotal_mb > 0

- name: hardening | Disable swap permanently
  shell: umount -a -t swap
  when: vault_hardening_disable_swap

- name: hardening | Disable core dumps
  block:
    - name: set fs.suid_dumpable to 0
      sysctl:
        name: fs.suid_dumpable
        value: 0
        state: present
        reload: yes
    - name: set kernel.core_pattern to /dev/null
      sysctl:
        name: kernel.core_pattern
        value: /dev/null
        state: present
        reload: yes
    - name: set core limit to 0
      limits:
        domain: '*'
        limit_type: core
        value: 0
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable Shell Command History
  copy:
    dest: /etc/profile.d/disable_history.sh
    content: |
      # Disable shell command history
      export HISTSIZE=0
      export HISTFILE=/dev/null
    mode: '0644'
  when: vault_hardening_disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  debug:
    msg: "Configuring SELinux and AppArmor"
  when: vault_hardening_configure_selinux_apparmor

- name: hardening | Enable SELinux
  selinux:
    state: enforcing
  when:
    - vault_hardening_configure_selinux_apparmor
    - ansible_selinux.status == "enabled"

- name: hardening | Install selinux-policy
  package:
    name: selinux-policy
    state: present
  when: vault_hardening_configure_selinux_apparmor

- name: hardening | Set SELinux policy
  selinux:
    policy: targeted
    state: enforcing
  when: vault_hardening_configure_selinux_apparmor

- name: hardening | Enable AppArmor (enforcing)
  shell: aa-enforce /etc/apparmor.d/usr.bin.vault
  when: vault_hardening_configure_selinux_apparmor


