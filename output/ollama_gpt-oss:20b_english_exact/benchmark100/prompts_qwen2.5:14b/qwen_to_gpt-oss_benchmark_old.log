---
- name: cadvisor | create directories
  file:
    path: "{{ cadvisor_install_dir | default('/opt/cadvisor') }}"
    state: directory
    mode: '0755'

- name: cadvisor | download
  get_url:
    url: "{{ cadvisor_download_url }}"
    dest: "{{ cadvisor_binary_path }}"
    mode: '0755'
    checksum: "sha256:{{ cadvisor_checksum }}"
  when: cadvisor_local_dir is not defined or cadvisor_local_dir == ""

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: "{{ cadvisor_local_dir }}/cadvisor"
    dest: "{{ cadvisor_binary_path }}"
    mode: '0755'
  when: cadvisor_local_dir is defined and cadvisor_local_dir != ""
  notify: cadvisor service restart

- name: cadvisor | symlink
  file:
    src: "{{ cadvisor_binary_path }}"
    dest: "{{ cadvisor_symlink_path | default('/usr/local/bin/cadvisor') }}"
    state: link

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'
  notify: reload systemd

- name: test_task
  command: systemctl is-active cadvisor
  register: service_active
  changed_when: false

- name: "debug: var=service_active"
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemd:
    name: cadvisor
    enabled: yes

- name: cadvisor | start server systemd
  systemd:
    name: cadvisor
    state: started

handlers:
  - name: cadvisor service restart
    systemd:
      name: cadvisor
      state: restarted

  - name: reload systemd
    command: systemctl daemon-reload
    changed_when: false


