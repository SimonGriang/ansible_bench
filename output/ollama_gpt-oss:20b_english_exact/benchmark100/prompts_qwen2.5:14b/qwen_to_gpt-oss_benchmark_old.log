    mode: '0755'
    content: |
      #!/bin/bash
      # script placeholder
  notify: restart keepalived

- name: Create RKE2 Server health check script for Debian OS family
  ansible.builtin.copy:
    dest: /usr/local/bin/rke2_server_check_deb.sh
    mode: '0755'
    content: |
      #!/bin/bash
      # script placeholder
  notify: restart keepalived

- name: Create RKE2 Server health check script for RedHat OS family
  ansible.builtin.copy:
    dest: /usr/local/bin/rke2_server_check_rhel.sh
    mode: '0755'
    content: |
      #!/bin/bash
      # script placeholder
  notify: restart keepalived

- name: Create keepalived config file
  ansible.builtin.copy:
    dest: /etc/keepalived/keepalived.conf
    mode: '0644'
    content: |
      # keepalived config placeholder
  notify: restart keepalived

- name: Enable keepalived and make sure it is not masked
  ansible.builtin.systemd:
    name: keepalived
    enabled: true
    masked: false
    state: started
  notify: restart keepalived

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


