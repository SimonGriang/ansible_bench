content='---\n- name: Check if the system is EFI\n  ansible.builtin.stat:\n    path: /sys/firmware/efi/efivars\n  register: efi_check\n\n- name: Set is_efi fact\n  ansible.builtin.set_fact:\n    is_efi: "{{ efi_check.stat.exists }}"\n\n- name: Remove the grub.cfg file if the system is EFI\n  ansible.builtin.file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: is_efi\n\n- name: Install a user template for GRUB\n  ansible.builtin.template:\n    src: 01_users.j2\n    dest: /etc/grub.d/01_users\n    owner: root\n    mode: \'0700\'\n  notify: Update GRUB\n\n- name: Add a password to the EFI GRUB configuration\n  ansible.builtin.lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: \'GRUB_ENABLE_PASSWORD=1\'\n    state: present\n  notify: Update GRUB\n\n- name: Add a password to the MBR GRUB configuration\n  ansible.builtin.lineinfile:\n    path: /etc/grub2.cfg\n    line: \'GRUB_ENABLE_PASSWORD=1\'\n    state: present\n  notify: Update GRUB\n\n- name: Add --unrestricted option to specified files\n  ansible.builtin.replace:\n    path: "{{ item }}"\n    regexp: \'CLASS="([^"]+)"\'\n    replace: \'CLASS="\\1 --unrestricted"\'\n  loop: "{{ grub_password_unrestricted_files }}"\n  when: grub_password_unrestricted | bool\n  notify: Update GRUB' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-09T11:34:40.268057881Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16559320687, 'load_duration': 154783426, 'prompt_eval_count': 615, 'prompt_eval_duration': 405978154, 'eval_count': 1696, 'eval_duration': 15997628485, 'model_name': 'gpt-oss:20b'} id='run--47f1af63-f378-47a6-82f7-2f23bcaccdda-0' usage_metadata={'input_tokens': 615, 'output_tokens': 1696, 'total_tokens': 2311}
