---
- name: Ensure the unzip package is available on the target system
  package:
    name: unzip
    state: present
    update_cache: yes

- name: Create a system group for promtail
  group:
    name: promtail
    state: present
    system: yes

- name: Create the promtail user
  user:
    name: promtail
    group: promtail
    state: present
    system: yes

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Create application directories
  file:
    path: /opt/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Check if the promtail binary exists
  stat:
    path: /opt/promtail/promtail
  register: promtail_bin

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_url }}"
    dest: /opt/promtail/promtail.tar.gz
  when: not promtail_bin.stat.exists

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_local_archive }}"
    dest: /opt/promtail/promtail.tar.gz
  when:
    - not promtail_bin.stat.exists
    - promtail_local_archive is defined

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_url }}"
    dest: "{{ playbook_dir }}/files/promtail.tar.gz"
  delegate_to: localhost
  when:
    - not promtail_bin.stat.exists
    - promtail_propagated is defined

- name: Propagate promtail binaries
  copy:
    src: "{{ playbook_dir }}/files/promtail.tar.gz"
    dest: /opt/promtail/promtail.tar.gz
  when: promtail_propagated is defined

- name: Unpack promtail binaries
  unarchive:
    src: /opt/promtail/promtail.tar.gz
    dest: /opt/promtail
    remote_src: yes
    mode: '0755'
    ignore_errors: yes

- name: Create symlink to latest version
  file:
    src: /opt/promtail/promtail
    dest: /usr/local/bin/promtail
    state: link
    force: yes

- name: Restart promtail service
  service:
    name: promtail
    state: restarted
    enabled: yes

- name: Write configuration
  template:
    src: promtail.conf.j2
    dest: /etc/promtail/promtail.yaml
    mode: '0644'
    owner: promtail
    group: promtail

- name: Restart promtail service
  service:
    name: promtail
    state: restarted
    enabled: yes

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'

- name: Restart promtail service
  service:
    name: promtail
    state: restarted
    enabled: yes


