---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present
  become: true

- name: Create directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner | default('root') }}"
    group: "{{ item.group | default('root') }}"
    mode: "{{ item.mode | default('0755') }}"
  loop: "{{ dns_dirs }}"
  become: true

- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    system: true
  become: true

- name: Create user
  ansible.builtin.user:
    name: "{{ dns_user }}"
    comment: "DNS service user"
    group: "{{ dns_group }}"
    system: true
    create_home: false
    shell: /usr/sbin/nologin
  become: true

- name: Generate rndc key
  ansible.builtin.command: >
    rndc-confgen -a -c "{{ rndc_key_path }}"
  args:
    creates: "{{ rndc_key_path }}"
  become: true

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ rndc_key_path }}"
    mode: '0600'
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
  become: true

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ hints_url }}"
    dest: "{{ dns_data_dir }}/root.hints"
    mode: '0644'
  become: true

- name: Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: "{{ dns_data_dir }}/{{ zone_name }}.zone"
    mode: '0644'
  become: true

- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: "/etc/named.conf"
    mode: '0644'
  become: true

- name: Place systemd override
  block:
    - name: Create systemd override directory
      ansible.builtin.file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        state: directory
        mode: '0755'
      become: true

    - name: Copy systemd override file
      ansible.builtin.template:
        src: override.conf.j2
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
        mode: '0644'
      become: true

- name: Start and enable dns
  ansible.builtin.service:
    name: "{{ dns_service }}"
    state: started
    enabled: true
  become: true


