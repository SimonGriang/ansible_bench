    dest: "{{ dns_data_dir }}/root.hints"
    mode: '0644'
  become: true

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_data_dir }}/{{ zone_name }}.zone"
    mode: '0644'
  become: true

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "/etc/named.conf"
    mode: '0644'
  become: true

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        state: directory
        mode: '0755'
      become: true

    - name: Copy systemd override file
      template:
        src: override.conf.j2
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
        mode: '0644'
      become: true

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true
  become: true


