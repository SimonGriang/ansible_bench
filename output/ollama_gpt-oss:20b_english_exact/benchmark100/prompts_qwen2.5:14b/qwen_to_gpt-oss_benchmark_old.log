---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ansible.builtin.copy:
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    content: "{{ mysql_configuration_options }}"
    mode: '0644'
  notify:
    - Restart mysql server

- name: Configure mysql client
  ansible.builtin.lineinfile:
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    regexp: '^socket='
    line: 'socket={{ mysql_socket }}'
    create: true
    mode: '0644'

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_os_family in ['Alpine', 'Archlinux']
  creates: /var/lib/mysql/mysql
  changed_when: false

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_name }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: '0600'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.user }}@{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('*.*:ALL') }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


