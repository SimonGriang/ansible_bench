---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install python pip
  ansible.builtin.package:
    name: "{{ python_pip_name }}"
    state: present
  become: true

- name: Configure pip proxy
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    regexp: '^\\s*proxy\\s*=\\s*.*$'
    line: proxy = {{ python_pip_proxy }}
    insertafter: '^\\[global\\]'
    state: present
  when: python_pip_proxy is defined
  become: true

- name: Trust hosts
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    regexp: '^\\s*trusted-host\\s*=\\s*.*$'
    line: trusted-host = {{ item }}
    insertafter: '^\\[global\\]'
    state: present
  loop: "{{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined
  become: true

- name: Update pip
  ansible.builtin.pip:
    name: pip
    state: present
    extra_args: --upgrade
  when:
    - python_pip_update | bool
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'
  become: true

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(omit) }}"
  loop: "{{ python_pip_modules }}"
  when:
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'
  become: true


