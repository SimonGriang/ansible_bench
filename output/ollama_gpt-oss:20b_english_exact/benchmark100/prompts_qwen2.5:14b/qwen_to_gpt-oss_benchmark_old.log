---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install prerequisites
  package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  blockinfile:
    path: /etc/vault.d/vault.env
    block: |
      {% for key, value in vault_environment_settings.items() %}
      {{ key }}={{ value }}
      {% endfor %}
    create: yes
  notify: Restart vault

- name: Include hardening tasks
  include_tasks: hardening.yml

- name: Start and enable vault
  service:
    name: vault
    state: started
    enabled: true
  when: vault_type == 'oss'

- name: Enable vault
  service:
    name: vault
    enabled: true
  when: vault_type != 'oss'


