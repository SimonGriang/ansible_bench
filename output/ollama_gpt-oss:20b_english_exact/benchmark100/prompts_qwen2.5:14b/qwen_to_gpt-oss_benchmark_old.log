---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: yes
  notify: reboot

- name: Configure apt
  apt:
    update_cache: yes
    upgrade: dist
    autoremove: yes
  notify: reboot

- name: Update all software (dnf)
  dnf:
    update_cache: yes
    upgrade: yes
    exclude:
      - package1
      - package2
  notify: reboot

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes
  notify: reboot

- name: Configure yum
  yum:
    name:
      - '*'
      - yum-utils
    state: latest
  notify: reboot

- name: Update all software (zypper)
  zypper:
    refresh: yes
    upgrade: yes
  notify: reboot


