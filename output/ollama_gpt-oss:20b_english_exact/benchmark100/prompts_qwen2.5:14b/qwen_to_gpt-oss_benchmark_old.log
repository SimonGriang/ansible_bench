---
- name: Download RKE2 kubeconfig to localhost
  when: rke2_download_kubeconf | bool and inventory_hostname == groups[rke2_servers_group_name][0]
  delegate_to: localhost
  ansible.builtin.fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    flat: yes

- name: Replace loopback IP by master server IP
  when: not ansible_check_mode and rke2_download_kubeconf | bool and inventory_hostname == groups[rke2_servers_group_name][0]
