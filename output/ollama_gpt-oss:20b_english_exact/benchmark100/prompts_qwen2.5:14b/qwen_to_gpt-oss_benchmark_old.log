---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  when: ansible_selinux.status == 'enabled'
  block:
    - name: Set SELinux booleans
      ansible.posix.seboolean:
        name: "{{ item }}"
        state: true
        persistent: true
      loop: "{{ selinux_booleans | default([]) }}"
    - name: Allow connections to custom ports
      community.general.seport:
        ports: "{{ item }}"
        proto: tcp
        state: permissive
        setype: http_port_t
      loop: "{{ selinux_ports | default([]) }}"

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_conf_src }}"
    dest: "{{ httpd_conf_dest }}"
    mode: '0644'
  notify:
    - Test httpd configuration
    - Restart httpd

- name: Activate httpd module | Debian
  ansible.builtin.command: a2enmod {{ item }}
  changed_when: false
  notify:
    - Test httpd configuration
    - Restart httpd
  loop: "{{ httpd_modules | default([]) }}"
  when: ansible_facts.os_family == 'Debian'

- name: Import ssl.yml
  ansible.builtin.include_tasks: ssl.yml
  when: httpd_ssl_enabled

- name: Import locations.yml
  ansible.builtin.include_tasks: locations.yml
  when: httpd_locations | length > 0

- name: Import vhosts.yml
  ansible.builtin.include_tasks: vhosts.yml
  when: httpd_vhosts | length > 0

- name: Configure ports
  ansible.builtin.template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
    mode: '0644'
  notify:
    - Test httpd configuration
    - Restart httpd
  when: ansible_facts.os_family in ['Debian', 'Suse']

- name: Import directories.yml
  ansible.builtin.include_tasks: directories.yml
  when: httpd_directories | length > 0

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  ansible.builtin.file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


