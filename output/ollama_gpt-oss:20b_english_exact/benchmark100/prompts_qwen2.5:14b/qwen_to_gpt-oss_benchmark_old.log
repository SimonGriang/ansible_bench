---  
- name: Import assert.yml  
  import_tasks: assert.yml

- name: Pre-configure debian systems  
  debconf:  
    name: postfix/main_mailer_type  
    question: postfix/main_mailer_type  
    value: "No configuration"  
    vtype: string  
  when: ansible_os_family == "Debian"

- name: Install postfix  
  apt:  
    name: postfix  
    state: present  
    update_cache: yes

- name: Install postfix-mysql  
  apt:  
    name: postfix-mysql  
    state: present  
  when: "'mysql' in postfix_virtual_mailbox_maps or 'mysql' in postfix_virtual_mailbox_domains or 'mysql' in postix_virtual_alias_maps"

- name: Configure postfix (transport_maps)  
  template:  
    src: transport_maps.j2  
    dest: /etc/postfix/transport_maps  
    mode: "0644"  
  notify:  
    - validate postfix config  
    - rebuild transport_maps database

- name: Configure postfix (header_checks)  
  template:  
    src: header_checks.j2  
    dest: /etc/postfix/header_checks  
    mode: "0644"  
  notify:  
    - validate postfix config  
    - reload postfix

- name: Setting values for main.cf (1/2)  
  set_fact:  
    smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default(omit) }}"  
    smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default(omit) }}"  
  when: postfix_smtpd_recipient_restrictions is defined or postfix_smtpd_sender_restrictions is defined

- name: Setting values for main.cf (2/2)  
  set_fact:  
    mynetworks: "{{ postfix_mynetworks | default(omit) }}"  
    mydestination: "{{ postfix_mydestination | default(omit) }}"  
    relay_domains: "{{ postfix_relay_domains | default(omit) }}"  
    smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default(omit) }}"  
    smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default(omit) }}"  
    virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default(omit) }}"  
    virtual_alias_domains: "{{ postfix_virtual_alias_domains | default(omit) }}"

- name: Configure postfix (main.cf)  
  template:  
    src: main_cf.j2  
    dest: /etc/postfix/main.cf  
    mode: "0644"  
  notify:  
    - validate postfix config  
    - restart postfix

- name: Configure postfix (master.cf)  
  template:  
    src: master_cf.j2  
    dest: /etc/postfix/master.cf  
    mode: "0644"  
  notify:  
    - validate postfix config  
    - restart postfix

- name: Creates cert/key directory  
  file:  
    state: directory  
    path: "{{ item }}"  
    mode: "0755"  
  loop:  
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"  
    - "{{ postfix_smtpd_tls_key_file | dirname }}"  
  when: postfix_smtpd_tls_cert_file is defined and postfix_smtpd_tls_key_file is defined

- name: Deploy Postfix TLS server certificate  
  copy:  
    src: "{{ postfix_smtpd_tls_cert_file_src }}"  
    dest: "{{ postfix_smtpd_tls_cert_file }}"  
    mode: "0644"  
  notify: reload postfix

- name: Deploy Postfix TLS server key  
  copy:  
    src: "{{ postfix_smtpd_tls_key_file_src }}"  
    dest: "{{ postfix_smtpd_tls_key_file }}"  
    mode: "0600"  
  notify: reload postfix

- name: Flush handlers  
  meta: flush_handlers

- name: Configure aliases  
  lineinfile:  
    path: /etc/aliases  
    line: "{{ item }}"  
    create: yes  
  loop: "{{ postfix_aliases | default([]) }}"  
  notify:  
    - rebuild alias database  
    - reload postfix

- name: Configure sender_access  
  lineinfile:  
    path: /etc/postfix/sender_access  
    line: "{{ item }}"  
    create: yes  
  loop: "{{ postfix_sender_access | default([]) }}"  
  notify:  
    - rebuild sender_access database  
    - reload postfix

- name: Configure recipient_access  
  lineinfile:  
    path: /etc/postfix/recipient_access  
    line: "{{ item }}"  
    create: yes  
  loop: "{{ postfix_recipient_access | default([]) }}"  
  notify:  
    - validate postfix config  
    - rebuild recipient_access database  
    - reload postfix

- name: Place sasl_password_map  
  copy:  
    content: "{{ postfix_sasl_password_map_content }}"  
    dest: /etc/postfix/sasl_password_map  
    mode: "0600"  
  notify: rebuild sasl_password_map database

- name: Flush handlers again  
  meta: flush_handlers

- name: Start and enable postfix  
  service:  
    name: postfix  
    state: started  
    enabled: yes


