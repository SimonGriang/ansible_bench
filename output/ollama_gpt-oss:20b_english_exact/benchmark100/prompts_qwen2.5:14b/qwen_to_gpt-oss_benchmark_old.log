  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  delegate_to: "{{ rke2_node_name }}"
- name: Wait for all nodes to be ready again
  ansible.builtin.shell: |
    set -o pipefail; \
    kubectl get nodes --no-headers | grep -v Ready
  register: result
  until: result.stdout == ''
  retries: 100
  delay: 15
  run_once: true
  check_mode: true
  changed_when: false
  delegate_to: "{{active_server|default(groups[rke2_servers_group_name][0])}}"
- name: Wait for all pods to be ready again
  ansible.builtin.shell: |
    set -o pipefail; \
    kubectl get pods --all-namespaces --no-headers | grep -vE 'Running|Succeeded'
  register: result
  until: result.stdout == ''
  retries: 100
  delay: 15
  run_once: true
  check_mode: true
  changed_when: false
  when: rke2_wait_for_all_pods_to_be_ready
  delegate_to: "{{active_server|default(groups[rke2_servers_group_name][0])}}"


