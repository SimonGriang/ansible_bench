---
- name: "Task 1: Create directories"
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_directories }}"

- name: "Task 2: Configure directories"
  block:
    - name: Apply directory.conf.j2 template for each directory
      ansible.builtin.template:
        src: directory.conf.j2
        dest: "/etc/httpd/conf.d/{{ item | basename }}.conf"
        mode: '0644'
      loop: "{{ httpd_directories }}"
    - name: Test httpd configuration
      ansible.builtin.command: apachectl configtest
      register: httpd_test
      changed_when: false
      failed_when: httpd_test.rc != 0
    - name: Restart httpd service
      ansible.builtin.service:
        name: httpd
        state: restarted


