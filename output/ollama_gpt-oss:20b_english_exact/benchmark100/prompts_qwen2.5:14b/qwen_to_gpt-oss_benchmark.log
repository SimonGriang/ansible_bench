---
- name: Enable proxy module on Debian
  community.general.apache2_module:
    state: present
    name: proxy
  when: ansible_os_family == 'Debian'

- name: Enable proxy_http module on Debian
  community.general.apache2_module:
    state: present
    name: proxy_http
  when: ansible_os_family == 'Debian'

- name: Enable proxy module on Suse
  ansible.builtin.copy:
    dest: /etc/httpd/conf.modules.d/zz-proxy.conf
    content: |
      LoadModule proxy_module modules/mod_proxy.so
    mode: '0644'
  when: ansible_os_family == 'Suse'

- name: Enable proxy_http module on Suse
  ansible.builtin.copy:
    dest: /etc/httpd/conf.modules.d/zz-proxy_http.conf
    content: |
      LoadModule proxy_http_module modules/mod_proxy_http.so
    mode: '0644'
  when: ansible_os_family == 'Suse'

- name: Configure locations using a template
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ item.dest }}"
    mode: "{{ item.mode | default('0644') }}"
  loop: "{{ httpd_locations }}"
  notify:
    - httpd configuration test
    - httpd restart


