---
- name: cadvisor | create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - "{{ cadvisor_install_dir }}"
    - "{{ cadvisor_bin_dir }}"

- name: cadvisor | download
  get_url:
    url: "{{ cadvisor_download_url }}"
    dest: "{{ cadvisor_bin_dir }}/cadvisor"
    mode: '0755'
    checksum: "{{ cadvisor_checksum }}"
  when: cadvisor_bin_local_dir is not defined or cadvisor_bin_local_dir == ''

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: "{{ cadvisor_bin_local_dir }}/cadvisor"
    dest: "{{ cadvisor_bin_dir }}/cadvisor"
    mode: '0755'
  when: cadvisor_bin_local_dir is defined and cadvisor_bin_local_dir != ''
  notify: cadvisor | restart service

- name: cadvisor | symlink
  file:
    src: "{{ cadvisor_bin_dir }}/cadvisor"
    dest: "/usr/local/bin/cadvisor"
    state: link
    force: yes

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'
  notify: cadvisor | reload systemd

- name: test_task
  command: systemctl is-active cadvisor
  register: service_active
  changed_when: false
  failed_when: false

- name: debug: var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  service:
    name: cadvisor
    enabled: yes

- name: cadvisor | start server systemd
  service:
    name: cadvisor
    state: started

- name: cadvisor | restart service
  service:
    name: cadvisor
    state: restarted

- name: cadvisor | reload systemd
  command: systemctl daemon-reload


