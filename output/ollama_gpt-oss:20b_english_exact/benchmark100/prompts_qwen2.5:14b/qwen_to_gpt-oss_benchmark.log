---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost

- name: Prepare system
  ansible.builtin.command: whoami
  become: yes
  become_user: root

- name: Gather bootstrap facts
  ansible.builtin.setup:

- name: Install bootstrap packages (raw)
  ansible.builtin.raw: "yum install -y {{ bootstrap_packages }}"
  when: ansible_os_family == 'RedHat'

- name: Install bootstrap packages (raw)
  ansible.builtin.raw: "apt-get update && apt-get install -y {{ bootstrap_packages }}"
  when: ansible_os_family == 'Debian'

- name: Ensure libdnf5 is present on Fedora/RedHat
  ansible.builtin.package:
    name: libdnf5
    state: present
  when: ansible_facts['distribution'] in ['Fedora', 'RedHat']

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_packages }}"
    state: present
    update_cache: yes


