---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_user }}"
  register: git_user_info

- name: Create directory for git configuration
  file:
    path: "{{ git_config_dir }}"
    state: directory
    owner: "{{ git_user }}"
  when:
    - git_user is defined
    - git_config_dir is defined
    - git_user_info is defined

- name: Place git configuration
  copy:
    src: gitconfig
    dest: "{{ git_home }}/.gitconfig"
    owner: "{{ git_user }}"
    mode: '0644'
  when:
    - git_user is defined
    - git_user_info is defined
    - git_config is defined

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_user }}"
  when:
    - repository_destination is defined
    - git_user is defined
    - git_user_info is defined

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}/{{ item.name }}"
    version: "{{ item.version | default('master') }}"
    force: true
  become: true
  become_user: "{{ git_user }}"
  loop: "{{ git_repositories }}"
  when:
    - git_user is defined
    - git_user_info is defined
    - git_repositories is defined


