---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Configure apk
  community.general.apk:
    update_cache: yes
    upgrade: yes
  notify: reboot

- name: Configure apt
  apt:
    update_cache: yes
    upgrade: safe
    auto_remove: yes
  notify: reboot

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    exclude: ['pkg1', 'pkg2']
  notify: reboot

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes
  notify: reboot

- name: Configure yum
  block:
    - name: Install yum-utils
      yum:
        name: yum-utils
        state: present
    - name: Update all packages
      yum:
        name: '*'
        state: latest
  notify: reboot

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest
    update_cache: yes
  notify: reboot


