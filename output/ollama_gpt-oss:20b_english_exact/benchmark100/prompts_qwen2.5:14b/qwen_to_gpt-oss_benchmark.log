---
- name: Enable proxy module on Debian
  ansible.builtin.apache2_module:
    state: present
    name: proxy
  when: ansible_os_family == 'Debian'

- name: Enable proxy_http module on Debian
  ansible.builtin.apache2_module:
    state: present
    name: proxy_http
  when: ansible_os_family == 'Debian'

- name: Enable proxy module on Suse
  ansible.builtin.shell: |
    echo "LoadModule proxy_module modules/mod_proxy.so" > /etc/httpd/conf.modules.d/zz-proxy.conf
  when: ansible_os_family == 'Suse'

- name: Enable proxy_http module on Suse
  ansible.builtin.shell: |
    echo "LoadModule proxy_http_module modules/mod_proxy_http.so" > /etc/httpd/conf.modules.d/zz-proxy_http.conf
  when: ansible_os_family == 'Suse'

- name: Configure locations using a template
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ item.dest }}"
    mode: "{{ item.mode | default('0644') }}"
  loop: "{{ httpd_locations }}"
  notify:
    - httpd configuration test
    - httpd restart


