---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Configure apk
  community.general.apk:
    update_cache: true
    upgrade: true
  notify: reboot

- name: Configure apt
  ansible.builtin.apt:
    update_cache: true
    upgrade: safe
    autoremove: true
  notify: reboot

- name: Update all software (dnf)
  ansible.builtin.dnf:
    name: '*'
    state: present
    exclude:
      - pkg1
      - pkg2
  notify: reboot

- name: Update all software (pacman)
  community.general.pacman:
    update_cache: true
    upgrade: true
  notify: reboot

- name: Configure yum
  notify: reboot
  block:
    - name: Install yum-utils
      ansible.builtin.yum:
        name: yum-utils
        state: present
    - name: Update all packages
      ansible.builtin.yum:
        name: '*'
        state: present

- name: Update all software (zypper)
  community.general.zypper:
    name: '*'
    state: present
    update_cache: true
  notify: reboot


