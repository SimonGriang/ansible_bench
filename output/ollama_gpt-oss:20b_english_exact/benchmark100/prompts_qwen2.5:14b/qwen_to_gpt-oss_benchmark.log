---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: >-
    Install HashiCorp products using the package manager based on the
    specified installation method and operating system.
  ansible.builtin.package:
    name: "{{ hashicorp_product }}"
    state: present

- name: Configure the HashiCorp repository for RedHat-based systems.
  ansible.builtin.yum_repository:
    name: hashicorp
    description: HashiCorp Repository
    baseurl: "{{ hashicorp_repo_baseurl }}"
    gpgcheck: 1
    gpgkey: "{{ hashicorp_repo_gpgkey }}"

- name: Set up the HashiCorp repository for Debian-based systems.
  ansible.builtin.apt_repository:
    repo: "{{ hashicorp_repo_deb }}"
    state: present

- name: Install the GPG package on Debian-based systems to manage apt keys.
  ansible.builtin.apt:
    name: gnupg
    state: present
    update_cache: true

- name: Add the HashiCorp GPG key to the system for Debian-based distributions.
  ansible.builtin.apt_key:
    url: "{{ hashicorp_repo_gpgkey }}"
    state: present

- name: >-
    Add the HashiCorp repository to the sources list for Debian-based
    distributions. Debian-based distributions.
  ansible.builtin.apt_repository:
    repo: "{{ hashicorp_repo_deb }}"
    state: present

- name: >-
    Install HashiCorp products using the package manager when a specific
    version is not provided.
  ansible.builtin.package:
    name: "{{ hashicorp_product }}"
    state: present

- name: >-
    Install HashiCorp products using the package manager with a specific
    version when provided.
  ansible.builtin.package:
    name: "{{ hashicorp_product }}"
    version: "{{ hashicorp_version }}"
    state: present

- name: >-
    Install HashiCorp products manually by unarchiving them to a specified
    destination.
  ansible.builtin.unarchive:
    src: "{{ hashicorp_archive_url }}"
    dest: "{{ hashicorp_install_dir }}"
    remote_src: true

- name: >-
    Unarchive the HashiCorp product source files to the designated
    installation directory with specific permissions and ownership settings.
  ansible.builtin.unarchive:
    src: "{{ hashicorp_archive_url }}"
    dest: "{{ hashicorp_install_dir }}"
    remote_src: true
    owner: "{{ hashicorp_user }}"
    group: "{{ hashicorp_group }}"
    mode: '0755'


