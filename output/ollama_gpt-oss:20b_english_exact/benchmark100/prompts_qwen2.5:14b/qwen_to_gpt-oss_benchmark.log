---
- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Include OS-specific variables based on distribution
  include_vars:
    file: "vars/{{ ansible_facts['distribution'] | lower }}.yml"

- name: Include architecture-specific variables
  include_vars:
    file: "vars/{{ ansible_facts['architecture'] | lower }}.yml"

- name: Set OS-specific variables (part I)
  set_fact:
    java_os_specific_vars: "{{ java_os_specific_vars | default({}) }}"
  when: java_os_specific_vars is defined

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    java_os_arch_vars: "{{ java_os_arch_vars | default({}) }}"
  when: java_os_arch_vars is defined

- name: Set specific variables
  set_fact:
    java_home: "/usr/lib/jvm/{{ java_version }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: >-
          deb http://old-repo.example.com/ubuntu {{ ansible_facts['distribution_release'] }}
          main
        state: absent

    - name: Install extra apt tools
      apt:
        name:
          - apt-transport-https
          - ca-certificates
        state: present
        update_cache: true

    - name: Add key repositories
      apt_key:
        url: https://packages.adoptium.net/apt/key.gpg
        state: present

    - name: Add repositories
      apt_repository:
        repo: >-
          deb https://packages.adoptium.net/apt {{ ansible_facts['distribution_release'] }}
          main
        state: present
        filename: adoptium
  when: ansible_facts['os_family'] == "Debian"

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        state: present
        key: https://packages.adoptium.net/centos/7/AdoptOpenJDK.key

    - name: Add repositories
      yum_repository:
        name: adoptium
        description: AdoptOpenJDK
        baseurl: https://packages.adoptium.net/centos/7/AdoptOpenJDK
        gpgcheck: true
        enabled: true
  when: ansible_facts['os_family'] == "RedHat"

- name: Install required libraries
  package:
    name: "{{ java_required_libraries }}"
    state: present
  when: java_required_libraries is defined

- name: Install Java, Debian
  block:
    - name: Update apt cache
      apt:
        update_cache: true

    - name: Install Java
      apt:
        name: "{{ java_package }}"
        state: present
  when: ansible_facts['os_family'] == "Debian"

- name: Install Java, RedHat
  block:
    - name: Update yum cache
      yum:
        update_cache: true

    - name: Install Java
      yum:
        name: "{{ java_package }}"
        state: present
  when: ansible_facts['os_family'] == "RedHat"

- name: Export environment variables
  template:
    src: java_env.j2
    dest: /etc/profile.d/java.sh
    mode: '0644'

- name: Source environment variables
  shell: source /etc/profile.d/java.sh
  args:
    executable: /bin/bash

- name: Correct java version selected for Java versions less than 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    priority: "{{ java_version | int }}"
  when:
    - ansible_facts['os_family'] == "Debian"
    - java_version is defined
    - java_version | int < 11

- name: >-
    Correct java version selected for Java versions greater than or equal to 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    priority: "{{ java_version | int }}"
  when:
    - ansible_facts['os_family'] == "Debian"
    - java_version is defined
    - java_version | int >= 11


