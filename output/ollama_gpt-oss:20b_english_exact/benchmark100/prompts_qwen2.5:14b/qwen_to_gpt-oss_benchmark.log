---
- name: Check if python is installed
  ansible.builtin.command: which python
  register: python_check
  ignore_errors: true
  changed_when: false

- name: Check if python3 is installed
  ansible.builtin.command: which python3
  register: python3_check
  ignore_errors: true
  changed_when: false

- name: Debug Python executable path
  ansible.builtin.debug:
    var: python_check.stdout

- name: Debug Python3 executable path
  ansible.builtin.debug:
    var: python3_check.stdout

- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install requirements
  ansible.builtin.yum:
    name: "{{ openssl_requirements }}"
    state: present

- name: Ensure packaging is available via dnf
  ansible.builtin.dnf:
    name: python3-packaging
    state: present

- name: Install pip packages
  ansible.builtin.pip:
    name: "{{ openssl_pip_packages }}"
    state: present

- name: Create key directory
  ansible.builtin.file:
    path: "{{ openssl_key_dir }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_user }}"
    group: "{{ openssl_group }}"

- name: Create csr directory
  ansible.builtin.file:
    path: "{{ openssl_csr_dir }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_user }}"
    group: "{{ openssl_group }}"

- name: Create crt directory
  ansible.builtin.file:
    path: "{{ openssl_crt_dir }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_user }}"
    group: "{{ openssl_group }}"

- name: Include create.yml
  ansible.builtin.include_tasks: create.yml
  loop: "{{ openssl_items }}"


