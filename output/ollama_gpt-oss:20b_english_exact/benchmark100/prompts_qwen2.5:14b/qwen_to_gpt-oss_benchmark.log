---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install requirements
  ansible.builtin.package:
    name: bash
    state: present

- name: Install openjdk java (package)
  ansible.builtin.package:
    name: openjdk
    state: present
  when:
    - java_vendor == "openjdk"

- name: Install RPM
  ansible.builtin.dnf:
    name: /opt/java/oracle-java.rpm
    state: present

- name: Install DEB
  ansible.builtin.apt:
    deb: /opt/java/oracle-java.deb
    state: present

- name: Install oracle java (rpm) (repository)
  ansible.builtin.dnf:
    name: oracle-java
    state: present

- name: Configure oracle targz
  ansible.builtin.unarchive:
    src: /opt/java/oracle-java.tar.gz
    dest: /opt/java
    remote_src: true

- name: Install oracle java policy software (targz)
  ansible.builtin.unarchive:
    src: /opt/java/jce_policy-8.zip
    dest: /opt/java
    remote_src: true

- name: Set alternative (targz)
  ansible.builtin.command: |
    readlink -f /usr/bin/java | \
    xargs -I{} update-alternatives --install /usr/bin/java java {} 200
  when:
    - ansible_os_family != "Alpine"
  changed_when: false

- name: Find JAVA_HOME
  ansible.builtin.command: readlink -f /usr/bin/java
  register: java_home_result
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  ansible.builtin.lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME={{ java_home_result.stdout }}"
    state: present


