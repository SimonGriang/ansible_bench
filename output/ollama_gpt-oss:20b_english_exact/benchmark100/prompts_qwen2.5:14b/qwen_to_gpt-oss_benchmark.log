---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: "{{ rke2_install_script_mode | default('0755') }}"
    timeout: "{{ rke2_download_timeout | default(30) }}"

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local_path }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0700'
    force: true
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0700'
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_implementation != "exists"

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download checksum file
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_path }}"
        mode: '0644'
        timeout: "{{ rke2_download_timeout | default(30) }}"
    - name: Download artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}"
        mode: '0644'
        timeout: "{{ rke2_download_timeout | default(30) }}"
    - name: Download install script
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_path }}"
        mode: '0700'
        timeout: "{{ rke2_download_timeout | default(30) }}"
  rescue:
    - name: Create artifacts directory for rescue
      file:
        path: "{{ rke2_artifacts_path }}"
        state: directory
        mode: '0700'
    - name: Copy local checksum file
      copy:
        src: "{{ rke2_checksum_local_path }}"
        dest: "{{ rke2_checksum_path }}"
        mode: '0644'
        force: true
    - name: Copy local artifacts
      copy:
        src: "{{ rke2_artifacts_local_path }}"
        dest: "{{ rke2_artifacts_path }}"
        mode: '0644'
        force: true
    - name: Copy local install script
      copy:
        src: "{{ rke2_install_script_local_path }}"
        dest: "{{ rke2_install_script_path }}"
        mode: '0700'
        force: true
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation == "download"

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local_path }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: '0640'
    force: true
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional tarballs folder
      file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: '0700'
    - name: Copy additional tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/"
        mode: '0640'
        force: true
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"
  when:
    - rke2_airgap_mode is defined
    - (rke2_airgap_copy_additional_tarballs | length) > 0
    - rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ item }}"
    state: file
    mode: '0640'
  loop: "{{ rke2_artifact_paths }}"
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation == "exists"

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: fs_stat

- name: Check if separate partition
  shell: grep " /usr/local " /proc/mounts
  register: separate_partition
  changed_when: false

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: >-
      {{ separate_partition.stdout | ternary('/usr/local/bin', '/usr/bin') }}

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 --version"
  register: rke2_installed_version
  ignore_errors: true

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_installed_version.stdout }}"
    rke2_running_version: >-
      {{ (service_facts.services['rke2-server'] | default({})).status }}
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_installed_version is not defined
      - rke2_running_version is not defined
      - rke2_installed_version >= rke2_running_version
      - rke2_allow_downgrade | default(false)
    fail_msg: "RKE2 downgrade detected. Set rke2_allow_downgrade to true to allow."

- name: Run RKE2 install script
  shell: "{{ rke2_install_script_path }} {{ rke2_install_args | default('') }}"
  args:
    executable: /bin/bash
  when:
    - rke2_installed_version is defined
    - rke2_installed_version != rke2_version_to_install
    - not ansible_check_mode

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/"
    mode: '0644'
    force: true
  loop: "{{ custom_manifests }}"
  when:
    - custom_manifests is defined
    - custom_manifests | length > 0

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}/"
    mode: '0644'
    force: true
  loop: "{{ static_pods }}"
  when:
    - static_pods is defined
    - static_pods | length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: /etc/rancher/rke2/rke2.env
    mode: '0644'
    force: true
  when:
    - rke2_environment_options is defined
    - rke2_environment_options | length > 0


