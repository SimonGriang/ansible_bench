- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  command: "kubectl get nodes --no-headers -o custom-columns=STATUS:.status.conditions[?(@.type==\"Ready\")].status | grep -q '^True$'"
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  run_once: true
  check_mode: true
  register: node_ready_check
  retries: 100
  delay: 15
  until: node_ready_check.rc == 0

- name: Wait for all pods to be ready again
  command: "kubectl get pods --all-namespaces --no-headers -o custom-columns=PHASE:.status.phase | grep -v -E 'Running|Succeeded' | wc -l | grep -q '^0$'"
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  run_once: true
  check_mode: true
  register: pods_ready_check
  retries: 100
  delay: 15
  until: pods_ready_check.rc == 0
  when: rke2_wait_for_all_pods_to_be_ready | default(false)


