---
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_facts['init_system'] == 'systemd'

- name: Get latest release of promtail
  block:
    - name: Fetch latest release JSON
      uri:
        url: https://api.github.com/repos/grafana/loki/releases/latest
        return_content: yes
      register: promtail_github_release
    - name: Set promtail_version
      set_fact:
        promtail_version: "{{ promtail_github_release.json.tag_name }}"

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}-{{ go_arch }}.zip"
  register: local_archive

- name: Assert local binary exists
  block:
    - name: Stat local binary
      stat:
        path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}-{{ go_arch }}"
      register: local_binary
    - name: Assert binary exists
      assert:
        that:
          - local_binary.stat.exists
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  block:
    - name: Fetch checksums file
      uri:
        url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail-{{ promtail_version }}.zip.sha256"
        return_content: yes
      register: promtail_checksums
    - name: Parse checksum list
      set_fact:
        promtail_checksum_list: "{{ promtail_checksums.content.splitlines() }}"

- name: Get checksum for specific architecture
  set_fact:
    promtail_checksum: "{{ (promtail_checksum_list | select('match', go_arch) | list | first).split()[0] }}"



