---
- name: Ensure the unzip package is available on the target system.
  package:
    name: unzip
    state: present
    update_cache: yes

- name: Create a system group for promtail.
  group:
    name: promtail
    state: present
    system: yes

- name: Create the promtail user.
  user:
    name: promtail
    state: present
    system: yes
    group: promtail
    create_home: no

- name: Ensure the /usr/local/bin directory exists.
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create config directories.
  file:
    path: /etc/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Create application directories.
  file:
    path: /opt/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Check if the promtail binary exists.
  stat:
    path: /usr/local/bin/promtail
  register: promtail_bin

- name: Download promtail binaries.
  get_url:
    url: "{{ promtail_url }}"
    dest: /usr/local/bin/promtail
    mode: '0755'
  when: not promtail_bin.stat.exists

- name: Propagate locally distributed promtail archive.
  copy:
    src: "{{ playbook_dir }}/files/promtail.tar.gz"
    dest: /opt/promtail/promtail.tar.gz
    mode: '0644'
  when: not promtail_bin.stat.exists and promtail_local_distributed | default(false)

- name: Download promtail binaries to controller node.
  get_url:
    url: "{{ promtail_url }}"
    dest: "{{ playbook_dir }}/files/promtail.tar.gz"
    mode: '0644'
  delegate_to: localhost
  when: not promtail_bin.stat.exists and promtail_propagated | default(false)

- name: Propagate promtail binaries.
  copy:
    src: "{{ playbook_dir }}/files/promtail.tar.gz"
    dest: /opt/promtail/promtail.tar.gz
    mode: '0644'
  when: not promtail_bin.stat.exists and promtail_propagated | default(false)

- name: Unpack promtail binaries.
  unarchive:
    src: /opt/promtail/promtail.tar.gz
    dest: /opt/promtail
    mode: '0755'
    remote_src: yes
  ignore_errors: yes
  when: not promtail_bin.stat.exists

- name: Create symlink to latest version.
  file:
    src: /opt/promtail/promtail
    dest: /usr/local/bin/promtail
    state: link
  notify: Restart promtail

- name: Write configuration.
  template:
    src: templates/promtail.yml.j2
    dest: /etc/promtail/promtail.yml
    mode: '0644'
    owner: promtail
    group: promtail
  notify: Restart promtail

- name: Create systemd service unit.
  template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
  notify: Restart promtail

- name: Restart promtail
  service:
    name: promtail
    state: restarted
    enabled: yes
  when: false  # handler placeholder to satisfy notify



