    creates: /etc/openvpn/easy-rsa/pki
  tags:
    - core

- name: Easyrsa build-ca
  ansible.builtin.command: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/ca.crt
  tags:
    - core

- name: Easyrsa gen-dh
  ansible.builtin.command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/dh.pem
  tags:
    - core

- name: Easyrsa build-server-full server nopass
  ansible.builtin.command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/issued/server.crt
  tags:
    - core

- name: Easyrsa build-client-full client nopass
  ansible.builtin.command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/issued/client.crt
  tags:
    - core

- name: Easyrsa gen-crl
  ansible.builtin.command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/crl.pem
  tags:
    - core

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  ansible.builtin.command:
    cmd: >
      openvpn --genkey
      --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key
  tags:
    - core

- name: Copy files to /etc/openvpn/server
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/
    dest: /etc/openvpn/server/
    mode: '0644'
    remote_src: true
  tags:
    - core

- name: Copy files to /etc/openvpn
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/
    dest: /etc/openvpn/
    mode: '0644'
    remote_src: true
  tags:
    - core

- name: Place server.conf
  ansible.builtin.template:
    src: templates/server.conf.j2
    dest: /etc/openvpn/server/server.conf
    mode: '0644'
  notify: restart openvpn
  tags:
    - core


