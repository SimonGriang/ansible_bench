---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - selinux:
        state: enforcing
      when: ansible_selinux.status == "enabled"
    - seport:
        ports: "{{ httpd_custom_http_port }}"
        proto: tcp
        setype: http_port_t
        state: present
      when: httpd_custom_http_port is defined
    - seport:
        ports: "{{ httpd_custom_https_port }}"
        proto: tcp
        setype: http_port_t
        state: present
      when: httpd_custom_https_port is defined

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
  notify:
    - Test httpd config
    - Restart httpd

- name: Activate httpd module | Debian
  command: a2enmod {{ item }}
  loop: "{{ httpd_modules }}"
  notify:
    - Test httpd config
  when: ansible_os_family == 'Debian'

- name: Import ssl.yml
  include_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import locations.yml
  include_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  include_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
  notify:
    - Test httpd config
    - Restart httpd
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  include_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service_name | default('httpd') }}"
    state: started
    enabled: true


