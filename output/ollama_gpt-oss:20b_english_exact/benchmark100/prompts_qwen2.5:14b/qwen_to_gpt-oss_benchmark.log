---
- name: Create the RKE2 config directory
  file:
    path: "{{ rke2_config_dir }}"
    state: directory
    mode: '0755'

- name: Create the RKE2 config file
  copy:
    content: "{{ rke2_config_content }}"
    dest: "{{ rke2_config_path }}"
    mode: '0644'
  notify: Restart RKE2 service

- name: Create the RKE2 systemd service file
  copy:
    content: "{{ rke2_systemd_content }}"
    dest: "{{ rke2_systemd_path }}"
    mode: '0644'
  notify: Restart RKE2 service

- name: Create the RKE2 binary
  copy:
    src: "{{ rke2_binary_source }}"
    dest: "{{ rke2_binary_path }}"
    mode: '0755'

- name: Create the RKE2 binary link
  file:
    src: "{{ rke2_binary_path }}"
    dest: "{{ rke2_binary_link }}"
    state: link

- name: Create the RKE2 service
  copy:
    content: "{{ rke2_service_content }}"
    dest: "{{ rke2_service_path }}"
    mode: '0644'
  notify: Restart RKE2 service

- name: Install the RKE2 service
  command: systemctl enable --now rke2.service

- name: Set the RKE2 agent token
  command: rke2 token create --role=agent --name="{{ inventory_hostname }}"
  register: rke2_token
  changed_when: rke2_token.stdout != ""

- name: Create the RKE2 agent config file
  copy:
    content: "{{ rke2_agent_config_content }}"
    dest: "{{ rke2_agent_config_path }}"
    mode: '0644'
  notify: Restart RKE2 service

- name: Create the RKE2 agent binary
  copy:
    src: "{{ rke2_agent_binary_source }}"
    dest: "{{ rke2_agent_binary_path }}"
    mode: '0755'

- name: Create the RKE2 agent binary link
  file:
    src: "{{ rke2_agent_binary_path }}"
    dest: "{{ rke2_agent_binary_link }}"
    state: link

- name: Create the RKE2 agent service
  copy:
    content: "{{ rke2_agent_service_content }}"
    dest: "{{ rke2_agent_service_path }}"
    mode: '0644'
  notify: Restart RKE2 service

- name: Install the RKE2 agent service
  command: systemctl enable --now rke2-agent.service

- name: Check the RKE2 agent status
  shell: systemctl is-active rke2-agent.service
  register: rke2_agent_status
  changed_when: false
  failed_when: rke2_agent_status.rc != 0

- name: Wait for the RKE2 agent to be ready
  shell: systemctl is-active rke2-agent.service
  register: rke2_agent_ready
  until: rke2_agent_ready.stdout == "active"
  retries: 30
  delay: 10

- name: Check the RKE2 agent health
  shell: rke2 agent health
  register: rke2_agent_health
  changed_when: false
  failed_when: rke2_agent_health.rc != 0

- name: Wait for the RKE2 agent to be healthy
  shell: rke2 agent health
  register: rke2_agent_health_status
  until: rke2_agent_health_status.stdout | int == 0
  retries: 30
  delay: 10

