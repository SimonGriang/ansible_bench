---
- name: Ensure apt key is not present in trusted.gpg.d
  file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Ensure old apt source list is not present in /etc/apt/sources.list.d
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure old versions of Docker are not installed
  apt:
    name: "{{ item }}"
    state: absent
    purge: true
  loop:
    - docker
    - docker.io
    - docker-engine
    - docker-ce
    - docker-ce-cli

- name: Ensure legacy repo file is not present
  file:
    path: /etc/apt/sources.list.d/legacy-docker.list
    state: absent

- name: Ensure dependencies are installed
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: true

- name: Add or remove Docker repository
  apt_repository:
    repo: |
      deb [arch=amd64] https://download.docker.com/linux/{{ ansible_distribution | lower }}
      {{ ansible_distribution_release }} stable
    state: "{{ docker_add_repo | ternary('present', 'absent') }}"
    filename: docker
  notify: apt update cache

- name: Ensure handlers are notified immediately to update the apt cache
  meta: flush_handlers


