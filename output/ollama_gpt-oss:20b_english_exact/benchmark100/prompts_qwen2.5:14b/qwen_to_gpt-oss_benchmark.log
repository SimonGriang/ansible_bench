---  
- name: hardening | Disable swap  
  command: swapoff -a  
  when: vault_hardening_disable_swap  

- name: hardening | Disable swap now  
  command: swapoff -a  
  when: ansible_swaptotal_mb > 0  

- name: hardening | Disable swap permanently  
  lineinfile:  
    path: /etc/fstab  
    regexp: '^\s*([^#].*swap)'  
    line: '# \1'  
    state: present  
  when: vault_hardening_disable_swap  

- name: hardening | Disable core dumps  
  shell: sysctl -w fs.suid_dumpable=0 -w kernel.core_pattern=/dev/null  
  changed_when: false  

- name: hardening | Disable Shell Command History  
  copy:  
    dest: /etc/profile.d/vault_disable_history.sh  
    content: |
      # Disable shell command history for all users
      unset HISTFILE
      HISTSIZE=0
      HISTFILESIZE=0
      shopt -s histappend
      export HISTSIZE
      export HISTFILESIZE
    mode: '0644'  
  when: vault_hardening_disable_shell_command_history  

- name: hardening | Configure SELinux / AppArmor  
  debug:  
    msg: "Configuring SELinux and AppArmor"  
  when: vault_hardening_configure_selinux_apparmor  

- name: hardening | Enable SELinux  
  selinux:  
    state: enforcing  
    policy: targeted  
  when: vault_hardening_configure_selinux_apparmor  

- name: hardening | Install selinux-policy  
  package:  
    name: selinux-policy  
    state: present  
  when: vault_hardening_configure_selinux_apparmor  

- name: hardening | Set SELinux policy  
  selinux:  
    policy: targeted  
    state: enforcing  
  when: vault_hardening_configure_selinux_apparmor  

- name: hardening | Enable AppArmor (enforcing)  
  command: aa-enforce /etc/apparmor.d/usr.bin.vault  
  when: vault_hardening_configure_selinux_apparmor  


