---
- name: Task 1: Check if Helm binary exists.
  stat:
    path: "{{ helm_binary_path }}"
  register: helm_stat

- name: Task 2: Check Helm version.
  command: "{{ helm_binary_path }} version --short"
  register: helm_version_output
  when: helm_stat.stat.exists

- name: Task 3: Download helm.
  get_url:
    url: "{{ helm_repo_url }}"
    dest: "{{ helm_download_path }}"
    mode: '0755'
  register: helm_downloaded
  when: not helm_stat.stat.exists or (helm_version_output.stdout | default('') is not regex(desired_helm_version))

- name: Task 4: Copy helm binary into place.
  copy:
    src: "{{ helm_download_path }}"
    dest: "{{ helm_binary_path }}"
    mode: '0755'
  when: helm_downloaded.changed


