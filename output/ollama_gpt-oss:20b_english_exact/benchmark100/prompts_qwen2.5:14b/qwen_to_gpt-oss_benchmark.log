---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  debconf:
    name: main_mailer_type
    value: "No configuration"
    type: string
    priority: low
  when: ansible_os_family == "Debian"

- name: Install postfix
  apt:
    name: postfix
    state: present
    update_cache: yes

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: "'mysql' in postfix_virtual_mailbox_maps or 'mysql' in postfix_virtual_mailbox_domains or 'mysql' in postix_virtual_alias_maps"

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: '0644'
  notify:
    - validate_postfix_config
    - rebuild_transport_maps

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
    - validate_postfix_config
    - reload_postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default([]) }}"
    smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default([]) }}"
  when: postfix_smtpd_recipient_restrictions is defined or postfix_smtpd_sender_restrictions is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    mynetworks: "{{ postfix_mynetworks | default([]) }}"
    mydestination: "{{ postfix_mydestination | default([]) }}"
    relay_domains: "{{ postfix_relay_domains | default([]) }}"
    smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default([]) }}"
    smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default([]) }}"
    virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default([]) }}"
    virtual_alias_domains: "{{ postfix_virtual_alias_domains | default([]) }}"

- name: Configure postfix (main.cf)
  template:
    src: main_cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - validate_postfix_config
    - restart_postfix

- name: Configure postfix (master.cf)
  template:
    src: master_cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - validate_postfix_config
    - restart_postfix

- name: Creates cert/key directory
  file:
    path: "{{ postfix_smtpd_tls_cert_file | dirname }}"
    state: directory
    mode: '0755'

- name: Creates cert/key directory
  file:
    path: "{{ postfix_smtpd_tls_key_file | dirname }}"
    state: directory
    mode: '0755'

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file_src }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0644'
  notify:
    - reload_postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file_src }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0600'
  notify:
    - reload_postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/postfix/aliases
    mode: '0644'
  notify:
    - rebuild_alias_db
    - reload_postfix

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: '0644'
  notify:
    - rebuild_sender_access_db
    - reload_postfix

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: '0644'
  notify:
    - validate_postfix_config
    - rebuild_recipient_access_db
    - reload_postfix

- name: Place sasl_password_map
  copy:
    content: "{{ sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password_map
    mode: '0644'
  notify:
    - rebuild_sasl_password_map_db

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes


