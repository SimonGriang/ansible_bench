---
- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ lookup('env','HOME') }}/.ssh/{{ user.name }}"
    state: directory
    mode: '0750'
  when: user.manage_ssh_key | default(false)
  delegate_to: localhost
  become: false

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    password: "{{ user.password | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    append: "{{ user.append | default(omit) }}"
    create_home: "{{ user.create_home | default(omit) }}"
    home: "{{ user.home | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    system: "{{ user.system | default(omit) }}"
    generate_ssh_key: "{{ user.generate_ssh_key | default(omit) }}"
    ssh_key_bits: "{{ user.ssh_key_bits | default(omit) }}"
    ssh_key_comment: "{{ user.ssh_key_comment | default(omit) }}"
    ssh_key_file: "{{ user.ssh_key_file | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    gid: "{{ user.gid | default(omit) }}"
    comment: "{{ user.comment | default(omit) }}"
    password_lock: "{{ user.password_lock | default(omit) }}"
    force: "{{ user.force | default(omit) }}"
  become: true

- name: Set sudo options for {{ user.name }}
  copy:
    dest: "/etc/sudoers.d/{{ user.name }}"
    content: "{{ user.sudo_options | default(omit) }}"
    mode: '0640'
    validate: '/usr/sbin/visudo --check %s'
  when: user.sudo_options is defined
  become: true

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudo_options is not defined
  become: true

- name: Generate private ssh key for {{ user.name }}
  openssh_keypair:
    path: "{{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa"
    type: rsa
    size: 2048
  when: user.manage_ssh_key | default(false)
  delegate_to: localhost
  become: false

- name: Generate public ssh key for {{ user.name }}
  openssh_keypair:
    path: "{{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa"
    type: rsa
    size: 2048
    public_key_only: true
  when: user.manage_ssh_key | default(false)
  delegate_to: localhost
  become: false

- name: Convert ssh key to ppk for {{ user.name }}
  command: >-
    puttygen {{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa
    -O private
    -o {{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_ppk
  when: user.manage_ssh_key | default(false)
  delegate_to: localhost
  become: false

- name: Get or set the home directory for {{ user.name }}
  set_fact:
    user_home_dir: "/home/{{ user.name }}"
  when: user.home is not defined
  become: false

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user_home_dir }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: >-
    user.manage_ssh_key | default(false)
    or (user.private_keys is defined and user.private_keys | length > 0)
  become: true

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys | default([]) }}"
  become: true

- name: Remove unauthorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys | default([]) }}"
  become: true

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ lookup('env','HOME') }}/.ssh/{{ user.name }}/id_rsa"
    dest: "{{ user_home_dir }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.copy_private_key | default(false)
  become: true

- name: Check users password valid time for {{ user.name }}
  command: |
    chage -l {{ user.name }}
  register: chage_output
  become: true

- name: Set users password valid time for {{ user.name }}
  command: |
    chage -M {{ user.password_validity_days }} {{ user.name }}
  when: >-
    user.password_validity_days is defined
    and chage_output.stdout is defined
    and (
      chage_output.stdout | regex_search('Maximum days') |
      default('') | regex_replace('Maximum days: ([0-9]+).*', '\\1') |
      int
    ) != user.password_validity_days
  become: true

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ item.path }}"
    dest: >-
      {{ user_home_dir }}/.ssh/{{ item.filename | default(item.path | basename) }}
    mode: "{{ item.mode | default('0600') }}"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  loop: "{{ user.private_keys | default([]) }}"
  become: true


