  ignore_errors: true
  changed_when: false

- name: Set RKE2 versions
  ansible.builtin.set_fact:
    rke2_installed_version: "{{ rke2_installed_version.stdout }}"
    rke2_version: "{{ rke2_installed_version.stdout | regex_replace('^.*:\\s*([0-9\\.]+).*$', '\\1') }}"
