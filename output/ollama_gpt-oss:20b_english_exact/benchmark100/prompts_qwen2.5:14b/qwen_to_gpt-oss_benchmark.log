---
- name: "Task 1: check if all variables have been set correctly"
  ansible.builtin.assert:
    that:
      - bootstrap_wait_for_host is defined
      - bootstrap_install is defined
      - bootstrap_install.raw is defined
    fail_msg: "Required bootstrap variables are missing."
    success_msg: "All required bootstrap variables are set."

- name: "Task 2: wait for host (when configured)"
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ bootstrap_host_port | default(22) }}"
    timeout: 300
  when: bootstrap_wait_for_host | bool

- name: "Task 3: prepare system"
  block:
    - name: Gather system facts
      ansible.builtin.setup:
  rescue:
    - name: Debug connection failure
      ansible.builtin.debug:
        msg: "Unable to establish connection to {{ inventory_hostname }}."

- name: "Task 4: include tasks to gather bootstrap facts (raw)"
  ansible.builtin.include_tasks: gather_bootstrap_facts_raw.yml

- name: "Task 5: Install bootstrap packages (raw)"
  ansible.builtin.raw: "{{ bootstrap_install.raw_command }}"
  when:
    - ansible_facts['os_family'] == 'RedHat'
    - bootstrap_install.raw | bool
  changed_when: false

- name: "Task 6: ensure system is prepared by issuing ansible modules"
  block:
    - name: Gather ansible facts
      ansible.builtin.setup:
    - name: Install bootstrap packages using package module
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap_facts.packages }}"



