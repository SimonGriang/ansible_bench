---
- name: Check current docker-compose version
  command: docker-compose --version
  register: docker_compose_version_output
  changed_when: false
  failed_when: false

- name: Set fact for current Docker Compose version
  set_fact:
    current_docker_compose_version: "{{ docker_compose_version_output.stdout | regex_search('docker-compose version (\\S+),') }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: current_docker_compose_version is defined and current_docker_compose_version != desired_docker_compose_version

- name: Install Docker Compose (if configured)
  get_url:
    url: "https://github.com/docker/compose/releases/download/{{ desired_docker_compose_version }}/docker-compose-{{ ansible_system | lower }}-{{ ansible_architecture }}"
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when: current_docker_compose_version is not defined or current_docker_compose_version is version(desired_docker_compose_version, '<')


