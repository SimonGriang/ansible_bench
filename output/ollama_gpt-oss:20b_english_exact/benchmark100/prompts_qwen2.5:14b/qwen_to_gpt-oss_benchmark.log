---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present
  become: yes

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ dns_directories }}"
  become: yes

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present
    system: yes
  become: yes

- name: Create user
  user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    system: yes
    shell: /sbin/nologin
    comment: DNS Service
    state: present
  become: yes

- name: Generate rndc key
  command: rndc-confgen -a -c "{{ rndc_key_path }}"
  args:
    creates: "{{ rndc_key_path }}"
  become: yes

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_path }}"
    mode: '0600'
  become: yes

- name: Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.root
    dest: "{{ dns_data_dir }}/named.root"
    mode: '0644'
  become: yes

- name: Create zone file
  template:
    src: zone.j2
    dest: "/etc/bind/zones/{{ zone_name }}.zone"
    mode: '0644'
  become: yes

- name: Add zones to configuration
  template:
    src: named.conf.zones.j2
    dest: /etc/bind/named.conf.local
    mode: '0644'
  become: yes

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: /etc/systemd/system/bind9.service.d
        state: directory
        mode: '0755'
      become: yes
