---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/default/cron
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    mode: '0644'
  notify: restart cron

- name: Configure path
  lineinfile:
    path: /etc/default/cron
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    mode: '0644'
  notify: restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/default/cron
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    mode: '0644'
  notify: restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ''

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    job: "{{ item.job }}"
    user: "{{ item.user | default(omit) }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs }}"

- name: restart cron
  service:
    name: "{{ cron_service }}"
    state: restarted
  when: cron_service is defined and cron_service != ''


