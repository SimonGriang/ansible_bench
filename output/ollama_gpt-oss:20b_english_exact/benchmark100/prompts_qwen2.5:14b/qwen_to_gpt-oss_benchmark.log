---  
- name: Create the RKE2 config directory  
  file:  
    path: "{{ rke2_config_dir }}"  
    state: directory  
    mode: '0755'  

- name: Set server taints  
  when: rke2_type == 'server'  
  command: "kubectl taint nodes $(hostname) node-role.kubernetes.io/master=true:NoSchedule"  

- name: Set agent taints  
  when: rke2_type == 'agent'  
  command: "kubectl taint nodes $(hostname) node-role.kubernetes.io/worker=true:NoSchedule"  

- name: Copy RKE2 config file  
  copy:  
    src: "{{ rke2_config_file_src }}"  
    dest: "{{ rke2_config_dir }}/config.yaml"  
    mode: '0644'  
  notify: "Restart RKE2 service"  

- name: Copy kubelet config file  
  when: kubelet_config is defined and kubelet_config != ''  
  copy:  
    src: "{{ kubelet_config_file_src }}"  
    dest: "{{ rke2_config_dir }}/kubelet-config.yaml"  
    mode: '0644'  
  notify: "Restart RKE2 service"  

- name: Copy Containerd Registry Configuration file  
  when: containerd_registry_config is defined and containerd_registry_config != ''  
  copy:  
    src: "{{ containerd_registry_config_src }}"  
    dest: "{{ rke2_config_dir }}/containerd-registry.conf"  
    mode: '0644'  
  notify: "Restart RKE2 service"  

- name: Start RKE2 service  
  when: rke2_type == 'agent'  
  service:  
    name: rke2-agent.service  
    state: started  
    enabled: true  
  register: rke2_start_result  
  until: rke2_start_result is succeeded  
  retries: 5  
  delay: 10  
  notify: "Restart RKE2 service"  

- name: Mask other RKE2 services  
  when: rke2_type == 'agent'  
  systemd:  
    name: rke2-server.service  
    masked: true  

- name: Wait for remaining nodes to be ready - no CNI  
  shell: "kubectl get nodes --no-headers | grep -v 'Ready' | wc -l"  
  register: node_ready_check_no_cni  
  until: node_ready_check_no_cni.stdout | int == 0  
  retries: 30  
  delay: 10  

- name: Wait for remaining nodes to be ready - with CNI  
  shell: "kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type==\"Ready\")].status}' | tr -d ' ' | grep -c False"  
  register: node_ready_check_with_cni  
  until: node_ready_check_with_cni.stdout | int == 0  
  retries: 30  
  delay: 10  


