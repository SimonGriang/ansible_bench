---
- name: Install Keepalived when HA mode is enabled
  apt:
    name: keepalived
    state: present
  when: ha_mode|bool and inventory_hostname in groups['rke2_server']

- name: Download and install RKE2
  get_url:
    url: "https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2.linux-amd64.tar.gz"
    dest: /tmp/rke2.tar.gz
    mode: '0644'
  register: rke2_download

- name: Install RKE2
  unarchive:
    src: /tmp/rke2.tar.gz
    dest: /usr/local
    remote_src: yes
    creates: /usr/local/bin/rke2
  when: rke2_download.changed

- name: CIS Hardening
  command: /usr/local/bin/cis_hardening.sh -p {{ cis_profile }}
  when: cis_profile is defined

- name: Find Active Server
  shell: kubectl get nodes --selector='node-role.kubernetes.io/master' --output=jsonpath='{.items[0].metadata.name}'
  register: active_server
  ignore_errors: yes

- name: Enable IPVS kernel module
  modprobe:
    name: ipvs
    state: present
  when: kubevip_enabled|bool and ha_mode|bool

- name: Copy kube-vip manifests to the masternode
  copy:
    src: files/kube-vip.yaml
    dest: /etc/rancher/rke2/kube-vip.yaml
  when: not keepalived_enabled|bool

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: files/ingress-nginx.yaml
    dest: /etc/rancher/rke2/ingress-nginx.yaml
  when: ingress_nginx_enabled|bool

- name: Prepare very first server node in the cluster
  command: rke2 server --config /etc/rancher/rke2/config.yaml
  when: active_server.stdout == inventory_hostname

- name: Restore etcd specific tasks
  command: /usr/local/bin/restore-etcd.sh
  when: etcd_restore|bool

- name: Download kubeconfig to ansible localhost
  fetch:
    src: /etc/rancher/rke2/kubeconfig.yaml
    dest: ./kubeconfig/{{ inventory_hostname }}.yaml
    flat: yes
  when: kubeconfig_download|bool

- name: Prepare and join remaining nodes of the cluster
  command: rke2 agent --server https://{{ active_server.stdout }}:9345 --token {{ rke2_token }}
  when: active_server.stdout is defined and inventory_hostname not in [active_server.stdout]

- name: Rolling cordon and drain restart when version changes - servers
  command: kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data
  when: rke2_version_changed|bool and inventory_hostname in groups['rke2_server']

- name: Rolling cordon and drain restart when version changes - agents
  command: kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data
  when: rke2_version_changed|bool and inventory_hostname in groups['rke2_agent']

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  command: systemctl restart rke2-server
  when: config_changed|bool

- name: Final steps
  debug:
    msg: "RKE2 cluster setup complete."


