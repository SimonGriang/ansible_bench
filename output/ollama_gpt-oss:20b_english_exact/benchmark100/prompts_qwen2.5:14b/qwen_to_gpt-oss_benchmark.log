---
- name: Task 1: Install Keepalived when HA mode is enabled
  package:
    name: keepalived
    state: present
  when: ha_mode_enabled and inventory_hostname in groups['rke2_server_group']

- name: Task 2: Download and install RKE2
  block:
    - name: Download RKE2 installer
      get_url:
        url: "{{ ['https://github.com/rancher/rke2/releases/download/', 
                  rke2_version, 
                  '/rke2-installer.sh'] | join('') }}"
        dest: /tmp/rke2-installer.sh
        mode: '0755'
    - name: Install RKE2
      command: /tmp/rke2-installer.sh --version {{ rke2_version }}
  when: rke2_version is defined

- name: Task 3: CIS Hardening
  shell: /usr/local/bin/cis-hardening.sh {{ cis_profile }}
  when: cis_profile is defined

- name: Task 4: Find Active Server
  shell: >
    kubectl get nodes -o json | jq -r '.items[] | 
    select(.status.conditions[] | select(.type=="Ready" and .status=="True")) | 
    .metadata.name' | head -n1
  register: active_server
  changed_when: false

- name: Task 5: Enable IPVS kernel module
  modprobe:
    name: ip_vs
  when: kubevip_enabled and ha_mode_enabled

- name: Task 6: Copy kube-vip manifests to the masternode
  copy:
    src: files/kube-vip.yaml
    dest: /etc/kubernetes/manifests/kube-vip.yaml
  when: not keepalived_enabled

- name: Task 7: Copy ingress-nginx manifests to the masternode
  copy:
    src: files/ingress-nginx.yaml
    dest: /etc/kubernetes/manifests/ingress-nginx.yaml
  when: ingress_config is defined

- name: Task 8: Prepare very first server node in the cluster
  shell: /usr/local/bin/prepare-first-node.sh
  when: inventory_hostname == active_server.stdout

- name: Task 9: Restore etcd specific tasks
  command: /usr/local/bin/restore-etcd.sh
  when: restore_etcd is defined

- name: Task 10: Download kubeconfig to ansible localhost
  fetch:
    src: /etc/rancher/rke2/kubeconfig.yaml
    dest: "{{ playbook_dir }}/kubeconfig.yaml"
  delegate_to: localhost
  when: download_kubeconfig is defined

- name: Task 11: Prepare and join remaining nodes of the cluster
  shell: /usr/local/bin/join-node.sh
  when: active_server.stdout is defined and inventory_hostname != active_server.stdout

- name: Task 12: Rolling cordon and drain restart when version changes - servers
  command: /usr/local/bin/rolling-restart-servers.sh
  when: rke2_version_changed and inventory_hostname in groups['rke2_server_group']

- name: Task 13: Rolling cordon and drain restart when version changes - agents
  command: /usr/local/bin/rolling-restart-agents.sh
  when: rke2_version_changed and inventory_hostname not in groups['rke2_server_group']

- name: Task 14: Flush handlers
  meta: flush_handlers

- name: Task 15: Rolling restart when config files change
  command: /usr/local/bin/rolling-restart-config.sh
  when: config_files_changed

- name: Task 16: Final steps
  debug:
    msg: "Playbook execution completed"



