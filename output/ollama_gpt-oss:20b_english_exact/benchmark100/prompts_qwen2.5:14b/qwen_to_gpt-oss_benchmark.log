---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  when: selinux_enabled
  block:
    - name: Set SELinux booleans
      ansible.posix.seboolean:
        name: "{{ item }}"
        state: yes
        persistent: yes
      loop: "{{ selinux_booleans }}"
    - name: Allow connections to custom ports
      ansible.posix.seport:
        port: "{{ item.port }}"
        proto: "{{ item.protocol | default('tcp') }}"
        setype: http_port_t
        state: present
      loop: "{{ selinux_ports }}"

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify:
    - Test httpd
    - Restart httpd

- name: Activate httpd module | Debian
  ansible.builtin.command: a2enmod {{ item }}
  loop: "{{ httpd_modules_debian }}"
  notify:
    - Test httpd
    - Restart httpd
  when: ansible_os_family == 'Debian'
  changed_when: false

- name: Import ssl.yml
  ansible.builtin.import_tasks: ssl.yml
  when: https_ssl_enabled

- name: Import locations.yml
  ansible.builtin.import_tasks: locations.yml
  when: httpd_locations | length > 0

- name: Import vhosts.yml
  ansible.builtin.import_tasks: vhosts.yml
  when: httpd_vhosts | length > 0

- name: Configure ports
  ansible.builtin.template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
    mode: '0644'
  notify:
    - Test httpd
    - Restart httpd
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  ansible.builtin.import_tasks: directories.yml
  when: httpd_directories | length > 0

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  ansible.builtin.file:
    path: /var/www/html/index.html
    state: absent
    mode: '0644'
  when: httpd_remove_example

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


