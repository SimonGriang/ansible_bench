---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  raw: |
    # Test connection
    if ! whoami; then
      echo "Connection test failed"
      exit 1
    fi
    # Test sudo availability
    if ! sudo -n true; then
      echo "Sudo not available, installing bootstrap packages"
      yum install -y {{ bootstrap_facts_packages | join(' ') }}
    fi

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes


