---
- name: create | Create ssl key
  openssl_privatekey:
    path: "/etc/ssl/private/{{ inventory_hostname }}.key"
    size: 2048
    state: present
    mode: '0600'
    owner: root
    group: root

- name: create | Create ssl csr
  openssl_csr:
    path: "/etc/ssl/csr/{{ inventory_hostname }}.csr"
    privatekey_path: "/etc/ssl/private/{{ inventory_hostname }}.key"
    common_name: "{{ inventory_hostname }}"
    state: present
    mode: '0644'
    owner: root
    group: root

- name: create | Create ssl certificates
  openssl_certificate:
    path: "/etc/ssl/certs/{{ inventory_hostname }}.crt"
    privatekey_path: "/etc/ssl/private/{{ inventory_hostname }}.key"
    csr_path: "/etc/ssl/csr/{{ inventory_hostname }}.csr"
    provider: selfsigned
    state: present
    mode: '0644'
    owner: root
    group: root

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    path: "/etc/ssl/p12/{{ inventory_hostname }}.p12"
    privatekey_path: "/etc/ssl/private/{{ inventory_hostname }}.key"
    certificate_path: "/etc/ssl/certs/{{ inventory_hostname }}.crt"
    state: present
    mode: '0600'
    owner: root
    group: root
    passphrase: "{{ p12_passphrase | default('changeit') }}"

- name: create | Read private key
  slurp:
    src: "/etc/ssl/private/{{ inventory_hostname }}.key"
  register: private_key_slurp

- name: create | Read certificate
  slurp:
    src: "/etc/ssl/certs/{{ inventory_hostname }}.crt"
  register: cert_slurp

- name: create | Create combined private_key and certificate file
  copy:
    dest: "/etc/ssl/combined/{{ inventory_hostname }}.pem"
    content: "{{ private_key_slurp.content | b64decode }}{{ cert_slurp.content | b64decode }}"
    mode: '0600'
    owner: root
    group: root


