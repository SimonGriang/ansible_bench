content='---\n- name: Check if the system is EFI\n  stat:\n    path: /sys/firmware/efi/efivars\n  register: efi_vars\n\n- name: Remove the grub.cfg file if the system is EFI\n  file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: efi_vars.stat.isdir | default(false)\n\n- name: Install a user template for GRUB\n  template:\n    src: 01_users.j2\n    dest: /etc/grub.d/01_users\n    owner: root\n    mode: \'0700\'\n  notify: update-grub\n\n- name: Add a password to the EFI GRUB configuration\n  lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: \'GRUB_ENABLE_PASSWORD=y\'\n    state: present\n  notify: update-grub\n\n- name: Add a password to the MBR GRUB configuration\n  lineinfile:\n    path: /etc/grub2.cfg\n    line: \'GRUB_ENABLE_PASSWORD=y\'\n    state: present\n  notify: update-grub\n\n- name: Add --unrestricted option to specified files\n  replace:\n    path: "{{ item }}"\n    regexp: \'CLASS="([^"]*)"\'\n    replace: \'CLASS="\\1 --unrestricted"\'\n    backrefs: yes\n  loop: "{{ grub_password_unrestricted_files }}"\n  when: grub_password_unrestricted | bool\n  notify: update-grub' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-19T00:57:34.715235961Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17271477294, 'load_duration': 144639329, 'prompt_eval_count': 617, 'prompt_eval_duration': 407155207, 'eval_count': 1912, 'eval_duration': 16718189453, 'model_name': 'gpt-oss:20b'} id='run--b23b47df-827f-47c1-8aaa-f2840d409a24-0' usage_metadata={'input_tokens': 617, 'output_tokens': 1912, 'total_tokens': 2529}
