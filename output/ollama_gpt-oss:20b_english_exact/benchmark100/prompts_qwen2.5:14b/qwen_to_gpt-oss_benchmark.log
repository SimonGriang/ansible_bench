9174710, 'prompt_eval_count': 506, 'prompt_eval_duration': 159608573, 'eval_count': 3212, 'eval_duration': 32123547155, 'model_name': 'gpt-oss:20b'} id='run--a9f2d6da-85e5-4b95-82db-a855f1b964d2-0' usage_metadata={'input_tokens': 506, 'output_tokens': 3212, 'total_tokens': 3718}
