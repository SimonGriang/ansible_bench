---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  ansible.builtin.template:
    src: mysql_server.cnf.j2
    dest: /etc/mysql/mysql.conf.d/mysqld.cnf
    mode: '0644'
  notify: restart mysql

- name: Configure mysql client
  ansible.builtin.lineinfile:
    dest: /etc/mysql/mysql.conf.d/client.cnf
    regexp: '^socket='
    line: 'socket=/var/run/mysqld/mysqld.sock'
    create: true
    mode: '0644'
  notify: restart mysql

- name: Initialize mysql
  ansible.builtin.command: mysql_install_db --user=mysql --ldata=/var/lib/mysql
  args:
    creates: /var/lib/mysql/mysql/user.frm
  when: >-
    ansible_facts['os_family'] == 'Alpine' or
    ansible_facts['distribution'] == 'Archlinux'
  changed_when: false

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Place my.cnf
  ansible.builtin.copy:
    src: my.cnf
    dest: /etc/mysql/my.cnf
    mode: '0644'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password | default('') }}"
  loop: "{{ mysql_databases }}"
  when: not (item.initial_import is defined and item.initial_import)

- name: List databases
  ansible.builtin.command: mysql -e "SHOW DATABASES;"
  register: mysql_databases_list
  changed_when: false

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
    login_user: root
    login_password: "{{ mysql_root_password | default('') }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password | default(omit) }}"
    priv: "{{ item.priv | default(omit) }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password | default('') }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Restart mysql
  ansible.builtin.service:
    name: mysql
    state: restarted
  when: false  # placeholder for handler notification


