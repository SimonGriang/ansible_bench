---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present
  become: true

- name: Create directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ dns_directories }}"
  become: true

- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present
    system: true
  become: true

- name: Create user
  ansible.builtin.user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    system: true
    shell: /sbin/nologin
    comment: DNS Service
    state: present
  become: true

- name: Generate rndc key
  ansible.builtin.command: rndc-confgen -a -c "{{ rndc_key_path }}"
  args:
    creates: "{{ rndc_key_path }}"
  become: true

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ rndc_key_path }}"
    mode: '0600'
  become: true

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: https://www.internic.net/domain/named.root
    dest: "{{ dns_data_dir }}/named.root"
    mode: '0644'
  become: true

- name: Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: "/etc/bind/zones/{{ zone_name }}.zone"
    mode: '0644'
  become: true

- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.zones.j2
    dest: /etc/bind/named.conf.local
    mode: '0644'
  become: true

- name: Place systemd override
  block:
    - name: Create systemd override directory
      ansible.builtin.file:
        path: /etc/systemd/system/bind9.service.d
        state: directory
        mode: '0755'
      become: true
    - name: Place override.conf
      ansible.builtin.template:
        src: override.conf.j2
        dest: /etc/systemd/system/bind9.service.d/override.conf
        mode: '0644'
      become: true

- name: Start and enable dns
  ansible.builtin.service:
    name: bind9
    state: started
    enabled: true
  become: true


