---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Set SELinux enforcing
      ansible.posix.selinux:
        state: enforcing
      when: ansible_selinux.status == "enabled"
    - name: Configure custom HTTP port
      community.general.seport:
        ports: "{{ httpd_custom_http_port }}"
        proto: tcp
        setype: http_port_t
        state: present
      when: httpd_custom_http_port is defined
    - name: Configure custom HTTPS port
      community.general.seport:
        ports: "{{ httpd_custom_https_port }}"
        proto: tcp
        setype: http_port_t
        state: present
      when: httpd_custom_https_port is defined

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify:
    - Test httpd config
    - Restart httpd

- name: Activate httpd module | Debian
  ansible.builtin.command: a2enmod {{ item }}
  loop: "{{ httpd_modules }}"
  notify:
    - Test httpd config
  when: ansible_os_family == 'Debian'
  changed_when: false

- name: Import ssl.yml
  ansible.builtin.include_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import locations.yml
  ansible.builtin.include_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  ansible.builtin.include_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  ansible.builtin.template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
    mode: '0644'
  notify:
    - Test httpd config
    - Restart httpd
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  ansible.builtin.include_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  ansible.builtin.file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
    mode: '0644'
  when: httpd_remove_example | bool

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service_name | default('httpd') }}"
    state: started
    enabled: true


