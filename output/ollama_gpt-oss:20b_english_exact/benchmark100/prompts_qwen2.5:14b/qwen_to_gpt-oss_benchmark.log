---
- name: create | Create ssl key
  community.crypto.openssl_privatekey:
    path: "{{ item.key_file }}"
    size: 2048
    state: present
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"
- name: create | Create ssl csr
  community.crypto.openssl_csr:
    path: "{{ item.csr_file }}"
    privatekey_path: "{{ item.key_file }}"
    common_name: "{{ item.common_name }}"
    mode: '0644'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"
- name: create | Create ssl certificates
  community.crypto.x509_certificate:
    path: "{{ item.cert_file }}"
    csr_path: "{{ item.csr_file }}"
    privatekey_path: "{{ item.key_file }}"
    provider: selfsigned
    mode: '0644'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"
- name: create | Create PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: "{{ item.pkcs12_file }}"
    privatekey_path: "{{ item.key_file }}"
    certificate_path: "{{ item.cert_file }}"
    friendly_name: "{{ item.friendly_name }}"
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"
- name: create | Read private key
  ansible.builtin.slurp:
    src: "{{ item.key_file }}"
  register: key_content
  loop: "{{ ssl_items }}"
- name: create | Read certificate
  ansible.builtin.slurp:
    src: "{{ item.cert_file }}"
  register: cert_content
  loop: "{{ ssl_items }}"
- name: create | Create combined private_key and certificate file
  ansible.builtin.copy:
    dest: "{{ item.combined_file }}"
    content: |
      {{ key_content.results[loop.index0].content | b64decode }}
      {{ cert_content.results[loop.index0].content | b64decode }}
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"


