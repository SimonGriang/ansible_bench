---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_server_type == 'server'

- name: Copy RKE2 configuration file
  template:
    src: rke2_config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet configuration file
  template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0644'
  when:
    - rke2_kubelet_config is defined
    - rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  template:
    src: registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0644'
  when: >-
    (rke2_custom_registry_mirrors is defined and
     rke2_custom_registry_mirrors | length > 0) or
    (rke2_custom_registry_configs is defined and
     rke2_custom_registry_configs | length > 0)
  notify: Config file changed

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when:
    - rke2_etcd_snapshot_file is defined
    - rke2_etcd_snapshot_file | length > 0
    - >-
      ('rke2-server.service' not in services) or
      (services['rke2-server.service'].state != 'running')

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file is defined
    - rke2_etcd_snapshot_file | length > 0
    - rke2_etcd_snapshot_s3_options.access_key is defined
    - rke2_etcd_snapshot_s3_options.secret_key is defined
    - rke2_etcd_snapshot_s3_options.bucket is defined
    - rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/server/db/etcd-snapshot
        state: directory
        mode: '0755'
    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/etcd-snapshot/snapshot.db
        mode: '0644'
    - name: Restore etcd from snapshot
      command: >-
        rke2 etcd restore \
        /var/lib/rancher/rke2/server/db/etcd-snapshot/snapshot.db
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  command: |
    rke2 etcd restore s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/ \
      {{ rke2_etcd_snapshot_s3_options.snapshot_name }} \
      --access-key={{ rke2_etcd_snapshot_s3_options.access_key }} \
      --secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }}
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    state: stopped
    masked: true
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Wait for the first server be ready - no CNI
  shell: |
    kubectl get node {{ inventory_hostname }} \
      -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
  register: node_ready
  until: node_ready.stdout == "True"
  retries: 30
  delay: 10
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Wait for the first server be ready - with CNI
  shell: |
    kubectl get pods -n kube-system -l app=cni \
      -o jsonpath='{.items[*].status.phase}'
  register: cni_pods
  until: >-
    cni_pods.stdout.split() | length > 0 and
    cni_pods.stdout.split() | all('Running' in _)
  retries: 30
  delay: 10
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Restore etcd
  block:
    - name: Get registered nodes
      shell: |
        kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
      register: registered_nodes
    - name: Delete node secrets
      shell: kubectl delete secret rke2-node-{{ item }}
      loop: "{{ registered_nodes.stdout.split() }}"
    - name: Delete node resources
      shell: kubectl delete node {{ item }}
      loop: "{{ registered_nodes.stdout.split() }}"
  when:
    - do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: inventory_hostname in groups[rke2_cluster_group_name]
