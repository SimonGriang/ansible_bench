---
- name: "Cordon and Drain the node {{ rke2_node_name }}"
  shell: |
    kubectl cordon {{ rke2_node_name }} && \
    kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-local-data {{ rke2_drain_additional_args | default('') }}
  register: drain_result
  until: drain_result.rc == 0
  retries: 100
  delay: 15
  changed_when: drain_result.rc == 0

- name: "Restart RKE2 service on {{ rke2_node_name }}"
  service:
    name: rke2-server
    state: restarted
  notify: "Service (re)started"

- name: "Wait for all nodes to be ready again"
  shell: |
    kubectl get nodes --no-headers | grep -v ' Ready '
  register: nodes_ready
  until: nodes_ready.rc == 1
  retries: 100
  delay: 15
  changed_when: false

- name: "Uncordon the node {{ rke2_node_name }}"
  shell: kubectl uncordon {{ rke2_node_name }}
  when: rke2_drain_node_during_upgrade | default(false)
  register: uncordon_result
  changed_when: uncordon_result.rc == 0

- name: "Wait for all pods to be ready again"
  shell: |
    kubectl get pods --all-namespaces --no-headers | grep -v ' Running\| Succeeded'
  register: pods_ready
  until: pods_ready.rc == 1
  retries: 100
  delay: 15
  changed_when: false
  when: rke2_wait_for_all_pods_to_be_ready | default(false)

- name: "Wait for all pods to pass readiness checks"
  shell: |
    kubectl get pods --all-namespaces --no-headers | grep -v ' Ready '
  register: pods_healthy
  until: pods_healthy.rc == 1
  retries: 100
  delay: 15
  changed_when: false
  when: rke2_wait_for_all_pods_to_be_healthy | default(false)


