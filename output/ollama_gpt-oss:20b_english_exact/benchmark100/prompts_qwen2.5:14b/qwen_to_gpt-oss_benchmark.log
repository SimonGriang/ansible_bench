---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install fail2ban
  ansible.builtin.package:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Copy filters in filter.d
  block:
    - name: Copy filter files
      ansible.builtin.copy:
        src: "{{ filter_src_path }}"
        dest: /etc/fail2ban/filter.d/
        mode: '0644'
        recurse: true
    - name: Restart fail2ban after filters
      ansible.builtin.service:
        name: "{{ fail2ban_service }}"
        state: restarted

- name: Configure fail2ban.local
  block:
    - name: Copy fail2ban.local
      ansible.builtin.copy:
        src: "{{ fail2ban_local_src }}"
        dest: /etc/fail2ban/fail2ban.local
        mode: '0644'
    - name: Restart fail2ban after local config
      ansible.builtin.service:
        name: "{{ fail2ban_service }}"
        state: restarted

- name: Configure jail.local
  block:
    - name: Copy jail.local
      ansible.builtin.copy:
        src: "{{ fail2ban_jail_local_src }}"
        dest: /etc/fail2ban/jail.local
        mode: '0644'
    - name: Restart fail2ban after jail config
      ansible.builtin.service:
        name: "{{ fail2ban_service }}"
        state: restarted

- name: Stat auth log file
  ansible.builtin.stat:
    path: /var/log/auth.log
  register: auth_log_stat

- name: Touch auth log file
  ansible.builtin.file:
    path: /var/log/auth.log
    state: touch
    mode: '0644'
  when: not auth_log_stat.stat.exists

- name: Start and enable fail2ban
  ansible.builtin.service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: true


