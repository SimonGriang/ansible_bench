  file:
    path: "{{ item.document_root }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when: item.document_root is defined and (item.create_docroot is not defined or item.create_docroot | bool)

- name: Create virtual host configuration files
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify:
    - Test Apache configuration
    - Restart Apache server

- name: Enable virtual hosts on Debian-based systems
  command: a2ensite {{ item.name }}.conf
  creates: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian'
  notify:
    - Test Apache configuration
    - Restart Apache server


