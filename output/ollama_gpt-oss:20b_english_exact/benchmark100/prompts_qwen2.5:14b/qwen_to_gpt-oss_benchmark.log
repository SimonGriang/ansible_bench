---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ git_user }}"
  register: git_user_info

- name: Create directory for git configuration
  ansible.builtin.file:
    path: "{{ git_config_dir }}"
    state: directory
    owner: "{{ git_user }}"
    mode: '0755'
  when:
    - git_user is defined
    - git_config_dir is defined
    - git_user_info is defined

- name: Place git configuration
  ansible.builtin.copy:
    src: gitconfig
    dest: "{{ git_home }}/.gitconfig"
    owner: "{{ git_user }}"
    mode: '0644'
  when:
    - git_user is defined
    - git_user_info is defined
    - git_config is defined

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_user }}"
    mode: '0755'
  when:
    - repository_destination is defined
    - git_user is defined
    - git_user_info is defined

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}/{{ item.name }}"
    version: "{{ item.version | default('master') }}"
    force: true
  become: true
  become_user: "{{ git_user }}"
  loop: "{{ git_repositories }}"
  when:
    - git_user is defined
    - git_user_info is defined
    - git_repositories is defined


