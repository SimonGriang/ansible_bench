---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install docker-compose package
  package:
    name: docker-compose
    state: present
  when: installation_type == 'package'

- name: Install docker-compose as a binary
  block:
    - name: Install required packages
      package:
        name: curl
        state: present
    - name: Download docker-compose binary
      get_url:
        url: https://github.com/docker/compose/releases/download/v2.12.2/docker-compose-{{ ansible_system | lower }}-{{ ansible_architecture }}
        dest: /usr/local/bin/docker-compose
        mode: '0755'
  when: installation_type == 'binary'


