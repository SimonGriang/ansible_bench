---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.command: cat /etc/os-release
  register: os_release_file
  changed_when: false

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution_name: "{{ os_release_file.stdout | regex_search('^ID=([a-zA-Z0-9_]+)', '\\1') }}"
    bootstrap_major_version: "{{ os_release_file.stdout | regex_search('VERSION_ID=\"?([0-9]+)', '\\1') }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  when: os_release_file.stdout is defined

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ bootstrap_os_family_map[bootstrap_distribution_name] }}"
  when: bootstrap_distribution_name is defined


