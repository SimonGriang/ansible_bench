- name: Install Loki
  hosts: all
  vars:
    download_dir: /opt/loki
    loki_version: "2.6.0"
  tasks:
    - name: Get the current Loki version
      command: "{{ download_dir }}/loki-linux-amd64 --version"
      register: current_loki_version
      ignore_errors: yes

    - name: Check if Loki is installed
      set_fact:
        loki_installed: "{{ (current_loki_version is succeeded) and (current_loki_version.stdout | regex_search('Loki (.*)')) | length > 0 }}"

    - name: Install dependencies
      package:
        name:
          - tar
          - wget
        state: present

    - name: Download Loki
      get_url:
        url: https://github.com/grafana/loki/releases/download/v{{ loki_version }}/loki-linux-amd64.tar.gz
        dest: "{{ download_dir }}/loki.tar.gz"
        mode: '0644'
      when: not loki_installed

    - name: Extract Loki
      unarchive:
        src: "{{ download_dir }}/loki.tar.gz"
        dest: "{{ download_dir }}"
        remote_src: yes
      when: not loki_installed

    - name: Get checksum list
      block:
        - name: Download checksum
          uri:
            url: "{{ 'https://github.com/grafana/loki/releases/download/' \
                ~ promtail_version ~ '/promtail-' ~ promtail_version ~ '.zip.sha256' }}"
            return_content: yes
        - name: Download checksum
          uri:
            url: "{{ 'https://github.com/grafana/loki/releases/download/' \
                ~ promtail_version ~ '/promtail-' ~ promtail_version ~ '.zip.sha256' }}"
            return_content: yes


