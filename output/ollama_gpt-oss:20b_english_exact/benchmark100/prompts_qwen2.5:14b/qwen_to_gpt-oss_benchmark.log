---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"

- name: Install RPM
  yum:
    name: /opt/java/oracle-java.rpm
    state: present

- name: Install DEB
  apt:
    deb: /opt/java/oracle-java.deb
    state: present

- name: Install oracle java (rpm) (repository)
  yum:
    name: oracle-java
    state: present

- name: Configure oracle targz
  unarchive:
    src: /opt/java/oracle-java.tar.gz
    dest: /opt/java
    remote_src: yes

- name: Install oracle java policy software (targz)
  unarchive:
    src: /opt/java/jce_policy-8.zip
    dest: /opt/java
    remote_src: yes

- name: Set alternative (targz)
  command: >
    readlink -f /usr/bin/java | xargs -I{} update-alternatives --install /usr/bin/java java {} 200
  when: ansible_os_family != "Alpine"

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME={{ java_home_result.stdout }}"
    state: present


