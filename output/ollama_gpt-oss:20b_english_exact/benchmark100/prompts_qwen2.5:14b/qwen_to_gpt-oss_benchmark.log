- name: Get python3 version installed
  ansible.builtin.command: python3 --version
  register: py3ver
  changed_when: false

- name: Remove EXTERNALLY-MANAGED file if we're on Debian12
  ansible.builtin.file:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
    state: absent
  when:
    - py3ver is defined
    - py3ver.stdout is search("Python 3.11")


