---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: gather_facts

- name: Flush handlers
  meta: flush_handlers

- block:
    - name: Manage selinux
      selinux:
        state: "{{ selinux_state | default('enforcing') }}"
        policy: "{{ selinux_policy | default('targeted') }}"
      notify: reboot

    - name: Manage selinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state | default('yes') }}"
        persistent: "{{ item.persistent | default('yes') }}"
      loop: "{{ selinux_booleans }}"
  name: Configure selinux
  when: ansible_selinux.status != 'enforced' and ansible_connection != 'local'


