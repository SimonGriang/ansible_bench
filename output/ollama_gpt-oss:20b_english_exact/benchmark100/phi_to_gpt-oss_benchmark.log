---
- name: 'Task 1: Import external tasks from assert.yml to be executed once on localhost'
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: 'Task 2: Install DNS-related packages'
  package:
    name: "{{ dns_packages }}"
    state: present

- name: 'Task 3: Create necessary directories for DNS configuration and data'
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0755'
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: 'Task 4: Create a group for DNS service'
  group:
    name: "{{ dns_group }}"
    state: present

- name: 'Task 5: Create a user for the DNS service'
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true

- name: 'Task 6: Generate the rndc key for DNS configuration'
  command: rndc-confgen -a -c "{{ dns_confdir }}/rndc.key"
  args:
    creates: "{{ dns_confdir }}/rndc.key"

- name: 'Task 7: Set file permissions for the rndc key'
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0640'

- name: 'Task 8: Download the root hints file if DNS caching is enabled'
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/root.hints"
    mode: '0644'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  notify: Rndc reload

- name: 'Task 9: Create primary zone files from templates'
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item }}.zone"
    validate: "named-checkzone -v {{ item }} {{ dns_datadir }}/{{ item }}.zone"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: 'Task 10: Add DNS zones to the main configuration file'
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    validate: "named-checkconf {{ dns_confdir }}/named.conf"
  notify: Restart DNS service

- name: 'Task 11: Create systemd service override if using systemd'
  block:
    - name: 'Ensure systemd override directory exists'
      file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        state: directory
        owner: root
        group: root
        mode: '0755'
    - name: 'Copy override.conf'
      copy:
        src: override.conf
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
        owner: root
        group: root
        mode: '0644'
    - name: 'Reload systemd daemon'
      systemd:
        daemon_reload: yes
  when: ansible_service_mgr == 'systemd'

- name: 'Task 12: Start and enable the DNS service'
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


