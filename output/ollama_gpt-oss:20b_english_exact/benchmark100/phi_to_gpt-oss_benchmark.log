---
- name: Import assert.yml task to perform necessary checks
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages specified by a variable
  ansible.builtin.package:
    name: "{{ service_required_packages }}"
    state: present
  notify: Gather facts

- name: Configure systemd service templates for services listed in a variable
  ansible.builtin.template:
    src: systemd.j2
    dest: "/etc/systemd/system/{{ item.name }}.service"
    mode: '0644'
  loop: "{{ service_list }}"
  when: ansible_service_mgr == 'systemd'
  notify: Systemctl daemon-reload

- name: Configure sysvinit service templates for services listed in a variable
  ansible.builtin.template:
    src: sysvinit.j2
    dest: "/etc/init.d/{{ item.name }}"
    mode: '0755'
  loop: "{{ service_list }}"
  when: ansible_service_mgr in ['sysvinit', 'upstart', 'openrc']

- name: Manage the state and enablement of services listed in a variable
  ansible.builtin.service:
    name: "{{ item.name }}"
    state: "{{ item.state | default(omit) }}"
    enabled: "{{ item.enabled | default(omit) }}"
  loop: "{{ service_list }}"
  when: item.state is defined or item.enabled is defined

- name: Flush handlers to ensure all notifications are executed
  ansible.builtin.meta: flush_handlers


