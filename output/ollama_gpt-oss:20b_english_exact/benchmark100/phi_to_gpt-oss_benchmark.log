---
- name: |
    Check the current version of Docker Compose installed on the system.
  command: docker compose version
  register: compose_version_output
  changed_when: false

- name: |
    Set a fact for the current Docker Compose version
    if it is defined and the output is not empty.
  set_fact:
    current_docker_compose_version: "{{ compose_version_output.stdout
        | regex_replace('^Docker Compose version v?', '') }}"
  when:
    - compose_version_output.stdout is defined
    - compose_version_output.stdout != ''

- name: |
    Delete the existing Docker Compose binary
    if the installed version does not match the desired version.
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when:
    - current_docker_compose_version is defined
    - current_docker_compose_version != desired_docker_compose_version

- name: |
    Download and install the specified version of Docker Compose
    if it is not already installed or if the installed version is older.
  get_url:
    url: "{{ compose_download_url }}"
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when:
    - current_docker_compose_version is not defined
    - current_docker_compose_version == ''
    - |
        current_docker_compose_version is version_compare(
            desired_docker_compose_version, '<'
        )


