---
- name: 'Load OS-specific variables based on the distribution or OS family, falling back to main.yml if specific files are not found.'
  include_vars:
    file: "{{ item }}"
  with_first_found:
    - "{{ ansible_distribution | lower }}.yml"
    - "{{ ansible_os_family | lower }}.yml"
    - "main.yml"

- name: 'Include RedHat-specific setup tasks if the OS family is RedHat.'
  include_tasks: setup-RedHat.yml
  when: ansible_os_family == 'RedHat'

- name: 'Include Debian-specific setup tasks if the OS family is Debian.'
  include_tasks: setup-Debian.yml
  when: ansible_os_family == 'Debian'

- name: 'Install Docker packages on systems not using Ansible version 2.12 or newer, or if the OS family is not RedHat or Debian.'
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: (ansible_version.full is version('2.12', '<')) or (ansible_os_family not in ['RedHat', 'Debian'])

- name: 'Install Docker packages with an option to allow downgrades on systems using Ansible version 2.12 or newer, and if the OS family is RedHat or Debian.'
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: yes
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: (ansible_version.full is version('2.12', '>=')) and (ansible_os_family in ['RedHat', 'Debian'])

- name: 'Install the Docker Compose plugin on systems not using Ansible version 2.12 or newer, or if the OS family is not RedHat or Debian, provided the docker_install_compose_plugin variable is true.'
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: (docker_install_compose_plugin | bool) and ((ansible_version.full is version('2.12', '<')) or (ansible_os_family not in ['RedHat', 'Debian']))

- name: 'Install the Docker Compose plugin with an option to allow downgrades on systems using Ansible version 2.12 or newer, and if the OS family is RedHat or Debian, provided the docker_install_compose_plugin variable is true.'
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: yes
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: (docker_install_compose_plugin | bool) and ((ansible_version.full is version('2.12', '>=')) and (ansible_os_family in ['RedHat', 'Debian']))

- name: 'Ensure the /etc/docker directory exists if there are daemon options specified.'
  file:
    path: /etc/docker
    state: directory
    mode: '0755'
  when: docker_daemon_options | length > 0

- name: 'Configure Docker daemon options by creating or updating /etc/docker/daemon.json if daemon options are specified.'
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_nice_json }}"
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options | length > 0

- name: 'Ensure the Docker service is started and enabled at boot if docker_service_manage is true.'
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: "{{ ansible_check_mode }}"
  when: docker_service_manage | bool

- name: 'Notify handlers to handle any necessary post-task actions, such as firewall adjustments.'
  meta: flush_handlers

- name: 'Include Docker Compose setup tasks if the docker_install_compose variable is true.'
  include_tasks: docker-compose.yml
  when: docker_install_compose | bool

- name: 'Retrieve Docker group information using the getent database for group entries.'
  getent:
    database: group
    key: docker
  register: docker_group_entry
  when: docker_users | length > 0

- name: 'Determine if any users need to be added to the Docker group.'
  set_fact:
    at_least_one_user_to_modify: >-
      {{ (docker_users | difference(docker_group_entry.data.members | default([]))) | length > 0 }}
  when: docker_users | length > 0

- name: 'Include tasks to modify user group memberships if any users need to be added to the Docker group.'
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify is defined


