    key: "{{ docker_group_name | default('docker') }}"
    split: ':'
  when: docker_users | length > 0

- name: Determine if any users need to be added to the Docker group
  ansible.builtin.set_fact:
    at_least_one_user_to_modify: >-
      {{
        docker_users | select('match', '^' + getent_group.split(':')[4] + '$') |
        list | length == 0
      }}
  when: docker_users | length > 0

- name: |-
    Include tasks to modify user group memberships if any users need to be added to the Docker group
  ansible.builtin.include_tasks: docker-users.yml
  when: at_least_one_user_to_modify | default(false) | bool

- name: restart docker
  ansible.builtin.service:
    name: docker
    state: restarted
  listen: restart docker


