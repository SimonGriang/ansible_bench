- name: 'Task 11: Create systemd service override if using systemd'
  block:
    - name: 'Ensure systemd override directory exists'
      file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        state: directory
        owner: root
        group: root
        mode: '0755'
    - name: 'Copy override.conf'
      copy:
        src: override.conf
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
        owner: root
        group: root
        mode: '0644'
    - name: 'Reload systemd daemon'
      systemd:
        daemon_reload: true
  when: ansible_service_mgr == 'systemd'

- name: 'Task 12: Start and enable the DNS service'
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


