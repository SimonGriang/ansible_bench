---
- name: Task 1: Install EPEL repository on supported Red Hat-based systems.
  debug:
    msg: "Installing EPEL repository on supported systems."
  when: >
    (ansible_distribution == 'Amazon' and ansible_distribution_version == '2') or
    (ansible_distribution in ['RedHat', 'CentOS', 'Rocky', 'AlmaLinux'] and
     ansible_distribution_major_version in ['7', '8', '9'])

- name: Task 2: Add the EPEL GPG key.
  ansible.builtin.rpm_key:
    state: present
    key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-9
  when: >
    (ansible_distribution == 'Amazon' and ansible_distribution_version == '2') or
    (ansible_distribution in ['RedHat', 'CentOS', 'Rocky', 'AlmaLinux'] and
     ansible_distribution_major_version in ['7', '8', '9'])
  notify: Update package cache

- name: Task 3: Install the EPEL release package.
  ansible.builtin.package:
    name: "{{ epel_url }}"
    state: present
  when: >
    (ansible_distribution == 'Amazon' and ansible_distribution_version == '2') or
    (ansible_distribution in ['RedHat', 'CentOS', 'Rocky', 'AlmaLinux'] and
     ansible_distribution_major_version in ['7', '8', '9'])
  notify: Update package cache

- name: Task 4: Optionally install the EPEL next-release package.
  ansible.builtin.package:
    name: "{{ epel_next_url }}"
    state: present
  when: >
    epel_next | bool and
    ((ansible_distribution == 'Amazon' and ansible_distribution_version == '2') or
     (ansible_distribution in ['RedHat', 'CentOS', 'Rocky', 'AlmaLinux'] and
      ansible_distribution_major_version in ['7', '8', '9']))
  notify: Update package cache


