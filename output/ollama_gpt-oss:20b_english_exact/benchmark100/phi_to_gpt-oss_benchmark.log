---
- name: Import additional tasks from assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to become available
  ansible.builtin.wait_for:
    port: "{{ port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  become: false
  when: bootstrap_wait_for_host | bool and ansible_connection != 'local'

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.command: whoami
      register: _connection_test
      ignore_errors: true
      changed_when: false

    - name: Check sudo availability
      ansible.builtin.command: sudo -n true
      register: _sudo_check
      ignore_errors: true
      changed_when: false

    - name: Gather bootstrap facts
      ansible.builtin.setup:
        gather_subset: all
      when: _connection_test is failed or _sudo_check is failed

    - name: Install bootstrap packages
      ansible.builtin.raw: |
        {% if ansible_os_family == 'RedHat' %}
        dnf -y install {{ bootstrap_facts_packages | join(' ') }} libdnf5
        {% else %}
        yum -y install {{ bootstrap_facts_packages | join(' ') }}
        {% endif %}
      become: true
      become_method: ansible.builtin.su
      become_user: root
      when: _connection_test is failed or _sudo_check is failed
      changed_when: false
  rescue:
    - name: Handle bootstrap preparation failure
      ansible.builtin.debug:
        msg: "Bootstrap preparation failed"

- name: Gather Ansible facts
  ansible.builtin.setup:
    gather_subset: all
  become: false

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
  become: "{{ bootstrap_become | bool }}"



