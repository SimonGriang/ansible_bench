---
- name: Import the assert.yml file
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required GRUB packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set the GRUB_TIMEOUT value
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_TIMEOUT='
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: yes
    mode: '0664'
    validate: /bin/sh -c 'test $? -eq 0'
  notify: update grub

- name: Set the GRUB_RECORDFAIL_TIMEOUT value
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_RECORDFAIL_TIMEOUT='
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: yes
    mode: '0664'
    validate: /bin/sh -c 'test $? -eq 0'
  notify: update grub

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX="([^"]*)"$'
    line: 'GRUB_CMDLINE_LINUX="\1 {{ item }}"'
    backrefs: yes
    create: yes
    mode: '0664'
    validate: /bin/sh -c 'test $? -eq 0'
  notify: update grub
  loop: "{{ grub_options }}"
  when: grub_options is defined and grub_options | length > 0 and not (item in lookup('file', '/etc/default/grub'))

- name: Import the password.yml tasks file if password setting is required
  import_tasks: password.yml
  when: grub_set_password

- name: Flush any pending handlers
  meta: flush_handlers


