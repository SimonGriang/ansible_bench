---
- name: Ensure the Docker apt key is removed from the trusted.gpg.d directory.
  ansible.builtin.file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Remove the old Docker apt source list from the sources.list.d directory.
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Uninstall obsolete Docker packages.
  ansible.builtin.apt:
    name:
      - docker.io
      - docker-ce
      - docker-ce-cli
      - containerd.io
    state: absent
    purge: true
    autoremove: true

- name: Remove the legacy Docker repository file.
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/legacy-docker.list
    state: absent

- name: Install necessary dependencies for Docker.
  ansible.builtin.apt:
    name:
      - apt-transport-https
      - ca-certificates
      - curl
      - gnupg
      - lsb-release
    state: present
    update_cache: true

- name: Add or remove the Docker repository based on a condition.
  ansible.builtin.apt_repository:
    repo: >
      deb [arch=amd64] https://download.docker.com/linux/ubuntu
      {{ ansible_lsb.codename }} stable
    state: "{{ docker_repo_state }}"
    filename: docker

- name: Flush handlers to update the apt cache immediately.
  ansible.builtin.meta: flush_handlers


