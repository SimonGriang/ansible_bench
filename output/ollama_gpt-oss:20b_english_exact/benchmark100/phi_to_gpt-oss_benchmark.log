---
- name: Create a system group for Vault
  group:
    name: "{{ vault_group }}"
    system: true

- name: Create a system user for Vault
  user:
    name: "{{ vault_user }}"
    group: "{{ vault_group }}"
    comment: "Vault user"
    shell: /sbin/nologin
    createhome: false

- name: Create a download directory for Vault
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: '0755'

- name: Download the Vault binary
  unarchive:
    src: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: true
    creates: "{{ vault_download_path }}/vault"
  notify: restart vault
  vars:
    vault_download_url: >-
      https://releases.hashicorp.com/vault/{{ vault_version }}/
