---
- name: Import assert.yml from a specified file
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install MySQL packages
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - set root password
    - re-execute the system daemon

- name: Configure the MySQL server configuration file
  template:
    src: my.cnf.j2
    dest: /etc/my.cnf
    mode: '0644'
  notify:
    - restart MySQL server

- name: Configure the MySQL client configuration file
  template:
    src: client.cnf.j2
    dest: /etc/mysql/conf.d/client.cnf
    mode: '0644'
  vars:
    mysql_socket: "{{ mysql_socket }}"

- name: Initialize the MySQL database if on Alpine or Archlinux
  command: mysql_install_db --user=mysql --ldata=/var/lib/mysql
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable the MySQL service
  service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers to apply previous changes
  meta: flush_handlers

- name: Place the my.cnf configuration file
  template:
    src: my.cnf.j2
    dest: /root/my.cnf
    mode: '0600'

- name: Create MySQL databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: not item.initial_import | default(false)
  no_log: true

- name: List current MySQL databases
  mysql_db:
    state: list
  register: mysql_databases_list
  no_log: true

- name: Import databases if initial import is defined and not already present
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
  loop: "{{ mysql_databases }}"
  when:
    - item.initial_import is defined
    - item.name not in mysql_databases_list.databases
  no_log: true

- name: Create MySQL users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again to apply user creation changes
  meta: flush_handlers


