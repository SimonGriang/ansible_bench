---
- name: Gather bootstrap facts by reading the /etc/os-release file
  raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  check_mode: no

- name: Set bootstrap distribution facts based on the gathered information
  set_fact:
    bootstrap_distribution: "{{ bootstrap_os_family_map[bootstrap_distribution_key] | default(bootstrap_distribution_key) }}"
    bootstrap_distribution_major_version: "{{ bootstrap_major_version }}"
  vars:
    bootstrap_os_release: "{{ bootstrap_facts.stdout }}"
    bootstrap_distribution_key: "{{ bootstrap_os_release | regex_search('PRETTY_NAME=\"([^\"]+)\"', '\\1') | lower }}"
    bootstrap_major_version: "{{ bootstrap_os_release | regex_search('VERSION_ID=\"([0-9]+)', '\\1') }}"
  when:
    - bootstrap_facts is defined
    - bootstrap_distribution is not defined
    - bootstrap_os_release is defined
    - bootstrap_distribution_key is defined
    - bootstrap_os_release | regex_search('PRETTY_NAME=\"([^\"]+)\"')

- name: Set bootstrap operating system family based on the distribution
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  when:
    - bootstrap_distribution is defined
    - bootstrap_os_family is not defined
    - bootstrap_distribution in item.value
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"



