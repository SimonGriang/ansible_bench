---
- name: Disable swap if vault_hardening_disable_swap is set and swap is currently enabled
  become: true
  when: vault_hardening_disable_swap | bool and ansible_swaptotal_mb > 0
  ansible.builtin.shell: |
    swapoff -a
    sed -i.bak '/\tswap/d' /etc/fstab
  args:
    warn: false
  changed_when: true

- name: Disable core dumps if vault_hardening_disable_core_dumps is set
  become: true
  when: vault_hardening_disable_core_dumps | bool
  ansible.builtin.copy:
    dest: /etc/security/limits.d/90-vault-hardening.conf
    content: |
      * hard core 0
      * soft core 0
    mode: '0644'
  changed_when: true

- name: Disable shell command history for vault commands if vault_hardening_disable_shell_command_history is set
  become: true
  when: vault_hardening_disable_shell_command_history | bool
  ansible.builtin.copy:
    dest: /etc/profile.d/vault_history.sh
    content: |
      export HISTIGNORE='vault*'
    mode: '0644'
  changed_when: true

- name: Configure SELinux and/or AppArmor if vault_hardening_configure_selinux_apparmor is set
  become: true
  when: vault_hardening_configure_selinux_apparmor | bool
  block:
    - name: Ensure selinux-policy is installed
      ansible.builtin.package:
        name: selinux-policy
        state: present
      when: ansible_selinux.status == 'enabled'
      changed_when: true

    - name: Set SELinux policy to enforcing
      ansible.builtin.command: setenforce 1
      when: ansible_selinux.status == 'enabled'
      changed_when: true

    - name: Enforce AppArmor profile for vault
      ansible.builtin.command: aa-enforce /etc/apparmor.d/usr.sbin.vault
      when: "'apparmor' in ansible_facts and ansible_facts.apparmor.enabled"
      failed_when: false
      changed_when: true


