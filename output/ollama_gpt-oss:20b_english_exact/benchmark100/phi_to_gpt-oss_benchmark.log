---
- name: "Task 1: Import assert.yml to ensure necessary preconditions or assertions are checked before proceeding with the main tasks."
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: "Task 2: Install vsftpd package on the target system."
  package:
    name: vsftpd
    state: present

- name: "Task 3: Configure vsftpd using a template file and set appropriate permissions."
  template:
    src: vsftpd.conf.j2
    dest: "{{ vsftpd_configuration_file }}"
    owner: root
    group: root
    mode: "{{ vsftpd_configuration_file_mode }}"
  notify: Restart vsftpd

- name: "Task 4: Ensure vsftpd service is started and enabled to run at boot."
  service:
    name: vsftpd
    state: started
    enabled: true

handlers:
  - name: Restart vsftpd
    service:
      name: vsftpd
      state: restarted


