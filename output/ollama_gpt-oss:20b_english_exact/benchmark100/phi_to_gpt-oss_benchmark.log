    name: "docker-{{ docker_edition }}"
    description: "Docker {{ docker_edition }} Repository"
    baseurl: "{{ docker_yum_repo_url }}"
    gpgcheck: yes
    gpgkey: "{{ docker_yum_gpg_key }}"
    file: "docker-{{ docker_edition }}"
  when: docker_add_repo

- name: Configure Docker Nightly repo
  replace:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^enabled\s*=\s*\d'
    replace: "enabled={{ docker_yum_repo_enable_nightly | int }}"
  when: docker_add_repo

- name: Configure Docker Test repo
  replace:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^enabled\s*=\s*\d'
    replace: "enabled={{ docker_yum_repo_enable_test | int }}"
  when: docker_add_repo

- name: Configure containerd on RHEL 8
  package:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
  loop:
    - { name: "runc", state: "absent" }
    - { name: "container-selinux", state: "present" }
    - { name: "containerd.io", state: "present" }
  when: ansible_facts['distribution_major_version'] | int == 8


