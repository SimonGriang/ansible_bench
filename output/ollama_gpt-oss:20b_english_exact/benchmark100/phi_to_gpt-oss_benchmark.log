, 'prompt_eval_duration': 476867079, 'eval_count': 3024, 'eval_duration': 28332631105, 'model_name': 'gpt-oss:20b'} id='run--225213ab-85f6-4e3f-a13e-4164161036b6-0' usage_metadata={'input_tokens': 696, 'output_tokens': 3024, 'total_tokens': 3720}
