---
- name: Create a system group for Vault
  group:
    name: "{{ vault_group }}"
    system: true

- name: Create a system user for Vault
  user:
    name: "{{ vault_user }}"
    group: "{{ vault_group }}"
    shell: "{{ vault_user_shell }}"
    system: true
    create_home: false

- name: Create a download directory for Vault
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Download the Vault binary
  unarchive:
    src: |
      https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_amd64.zip
    dest: "{{ vault_download_path }}"
    remote_src: true
    creates: "{{ vault_download_path }}/vault"
  notify: restart vault

- name: Check if the main Vault directory exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create the main Vault directory if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
  when: not vault_check_path.stat.exists

- name: Create additional directories in the main Vault directory
  file:
    path: "{{ vault_path }}/{{ item.name }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_directories }}"

- name: Create data directories for Vault
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_data_directories }}"

- name: Generate a TLS key and certificate for Vault
  openssl_certificate:
    path: "{{ vault_data_directory }}/tls/vault.crt"
    privatekey_path: "{{ vault_data_directory }}/tls/vault.key"
    privatekey_size: 2048
    privatekey_type: rsa
    common_name: vault
    self_signed: true
  notify: restart vault

- name: Set ownership of TLS files
  file:
    path: "{{ item }}"
    state: file
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0600'
  loop: "{{ vault_tls_files }}"

- name: Copy the Vault binary to the appropriate location
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    owner: root
    group: root
    mode: '0755'
  notify: restart vault

- name: Set specific capabilities on the Vault binary
  ansible.posix.setcap:
    capability: cap_ipc_lock=ep
    path: "{{ vault_path }}/usr/bin/vault"

- name: Create a vault environment file
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0640'
    preserve_times: true
  notify: restart vault

- name: Ensure the systemd system directory exists
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy the Vault service file for systemd
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'
  notify: reload systemd
  when: ansible_service_mgr == 'systemd'

- name: Copy the Vault configuration file
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: '0644'
  notify: restart vault

- name: Flush handlers to apply changes
  meta: flush_handlers


