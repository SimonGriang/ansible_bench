unt': 3968, 'eval_duration': 41085267876, 'model_name': 'gpt-oss:20b'} id='run--dbcbb6f9-f433-48ef-b88c-d0c8ccb33b42-0' usage_metadata={'input_tokens': 630, 'output_tokens': 3968, 'total_tokens': 4598}
