---
- name: Import assertion tasks
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Vault prerequisites
  ansible.builtin.package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method tasks
  ansible.builtin.include_tasks: "{{ vault_installation_method }}.yml"

- name: Add environment variables for Vault
  ansible.builtin.lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item }}"
    create: true
    mode: '0644'
  loop: "{{ vault_env_vars }}"
  notify: restart vault

- name: Include hardening tasks
  ansible.builtin.include_tasks: hardening.yml

- name: Start and enable Vault service (OSS)
  ansible.builtin.service:
    name: vault
    state: started
    enabled: true
  when: vault_type == 'oss'

- name: Enable Vault service (non-OSS)
  ansible.builtin.service:
    name: vault
    state: started
    enabled: true
  when: vault_type != 'oss'


