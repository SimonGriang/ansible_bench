---
- name: Import assertion file
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true
- name: Install cron packages
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present
- name: Configure cron shell
  ansible.builtin.lineinfile:
    path: /etc/crontab
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    state: present
  notify: restart cron service
- name: Configure cron path
  ansible.builtin.lineinfile:
    path: /etc/crontab
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    state: present
  notify: restart cron service
- name: Configure cron mailto
  ansible.builtin.lineinfile:
    path: /etc/crontab
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    state: present
  notify: restart cron service
- name: Start and enable cron service
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ''
- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    user: "{{ item.user | default(omit) }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs }}"


