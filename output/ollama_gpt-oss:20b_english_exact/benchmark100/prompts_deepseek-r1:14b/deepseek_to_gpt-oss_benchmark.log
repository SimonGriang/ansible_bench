        value: 0
    - name: Set soft core limit to 0
      ansible.builtin.pam_limits:
        domain: '*'
        limit_type: soft
        limit_item: core
        value: 0

- name: hardening | Disable Shell Command History
  when: vault_hardening_disable_shell_command_history | bool
  block:
    - name: Ensure /etc/profile.d/vault.sh exists
      ansible.builtin.file:
        path: /etc/profile.d/vault.sh
        state: touch
        mode: '0644'
    - name: Add HISTIGNORE for vault commands
      ansible.builtin.lineinfile:
        path: /etc/profile.d/vault.sh
        regexp: '^export HISTIGNORE='
        line: 'export HISTIGNORE="vault:*"'
        create: true
        mode: '0644'

- name: hardening | Configure SELinux / AppArmor
  when: vault_hardening_configure_selinux_apparmor | bool
  block:
    - name: Set SELinux to enforcing
      ansible.builtin.selinux:
        policy: targeted
        state: enforcing
    - name: Install SELinux policy packages
      ansible.builtin.package:
        name:
          - selinux-policy
          - selinux-policy-targeted
        state: present
    - name: Install AppArmor
      ansible.builtin.package:
        name: apparmor
        state: present
    - name: Enable AppArmor service
      ansible.builtin.service:
        name: apparmor
        enabled: true
        state: started
    - name: Enforce Vault AppArmor profile
      ansible.builtin.command: apparmor_parser -r /etc/apparmor.d/usr.bin.vault
      changed_when: false


