---
- name: Check if Python is installed
  ansible.builtin.command: which python
  register: python_path
  ignore_errors: true

- name: Check if Python3 is installed
  ansible.builtin.command: which python3
  register: python3_path
  ignore_errors: true

- name: Debug Python executable path
  ansible.builtin.debug:
    msg: "{{ python_path.stdout }}"
  when: python_path.rc == 0

- name: Debug Python3 executable path
  ansible.builtin.debug:
    msg: "{{ python3_path.stdout }}"
  when: python3_path.rc == 0

- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install requirements
  ansible.builtin.dnf:
    name: "{{ openssl_requirements }}"
    state: present

- name: Ensure packaging is available via dnf
  ansible.builtin.dnf:
    name: python3-packaging
    state: present

- name: Install pip packages
  ansible.builtin.pip:
    name: "{{ openssl_pip_packages }}"
    state: present

- name: Create key directory
  ansible.builtin.file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: "{{ openssl_key_directory_mode | default('0700') }}"
    owner: "{{ openssl_key_directory_owner | default('root') }}"
    group: "{{ openssl_key_directory_group | default('root') }}"

- name: Create csr directory
  ansible.builtin.file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: "{{ openssl_csr_directory_mode | default('0700') }}"
    owner: "{{ openssl_csr_directory_owner | default('root') }}"
    group: "{{ openssl_csr_directory_group | default('root') }}"

- name: Create crt directory
  ansible.builtin.file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: "{{ openssl_crt_directory_mode | default('0700') }}"
    owner: "{{ openssl_crt_directory_owner | default('root') }}"
    group: "{{ openssl_crt_directory_group | default('root') }}"

- name: Include create.yml
  ansible.builtin.include_tasks: create.yml
  loop: "{{ openssl_items }}"
  when: item.condition is defined and item.condition


