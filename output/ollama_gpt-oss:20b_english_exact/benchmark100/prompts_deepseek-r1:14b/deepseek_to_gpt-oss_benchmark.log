---
- name: Import assertion file
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install system requirements
  ansible.builtin.package:
    name: bash
    state: present

- name: Install OpenJDK Java
  when: java_vendor == "openjdk"
  ansible.builtin.package:
    name: openjdk
    state: present

- name: Install Oracle Java RPM from local
  when: java_source == "local" and java_format == "rpm"
  block:
    - name: Copy Oracle Java RPM
      ansible.builtin.copy:
        src: oracle-java.rpm
        dest: /tmp/oracle-java.rpm
        mode: '0644'
    - name: Install Oracle Java RPM
      ansible.builtin.dnf:
        name: /tmp/oracle-java.rpm
        state: present

- name: Install Oracle Java DEB from local
  when: java_source == "local" and java_format == "deb"
  block:
    - name: Copy Oracle Java DEB
      ansible.builtin.copy:
        src: oracle-java.deb
        dest: /tmp/oracle-java.deb
        mode: '0644'
    - name: Install Oracle Java DEB
      ansible.builtin.apt:
        deb: /tmp/oracle-java.deb
        state: present

- name: Install Oracle Java RPM from repository
  when: java_source == "repository" and java_format == "rpm"
  ansible.builtin.dnf:
    name: oracle-java
    state: present

- name: Configure Oracle Java targz installation
  when: java_format == "targz" and java_vendor == "oracle"
  block:
    - name: Extract Oracle Java targz
      ansible.builtin.unarchive:
        src: oracle-java.targz
        dest: /usr/lib/jvm
        remote_src: true

- name: Install Oracle Java JCE policy
  when: java_jce and java_version == 8 and java_vendor == "oracle"
  block:
    - name: Copy JCE policy
      ansible.builtin.copy:
        src: jce_policy.zip
        dest: /tmp/jce_policy.zip
        mode: '0644'
    - name: Unarchive JCE policy
      ansible.builtin.unarchive:
        src: /tmp/jce_policy.zip
        dest: /usr/lib/jvm
        remote_src: true

- name: Set Java alternative
  when: java_format == "targz" and ansible_distribution != "Alpine"
  community.general.alternatives:
    name: java
    path: /usr/lib/jvm/java-8-oracle/bin/java
    priority: 1

- name: Find Java home directory
  ansible.builtin.command: readlink -f /usr/bin/java
  register: java_bin_path
  changed_when: false

- name: Set JAVA_HOME in environment
  ansible.builtin.lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_bin_path.stdout | dirname }}"
    create: true
    mode: '0644'


