---
- name: "Task 1: Create /etc/openvpn/easy-rsa directory with correct permissions"
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: "Task 2: Initialize OpenVPN PKI structure"
  ansible.builtin.command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: "Task 3: Generate OpenVPN CA certificate"
  ansible.builtin.command: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  changed_when: false

- name: "Task 4: Generate Diffie-Hellman parameters"
  ansible.builtin.command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: "Task 5: Generate server certificate"
  ansible.builtin.command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  changed_when: false

- name: "Task 6: Generate client certificate"
  ansible.builtin.command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  changed_when: false

- name: "Task 7: Generate Certificate Revocation List"
  ansible.builtin.command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: "Task 8: Generate OpenVPN TA key"
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
