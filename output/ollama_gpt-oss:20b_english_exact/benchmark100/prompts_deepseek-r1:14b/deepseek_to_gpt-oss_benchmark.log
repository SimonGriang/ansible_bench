---
- name: Create the RKE2 configuration directory
  ansible.builtin.file:
    path: "{{ rke2_config_dir }}"
    state: directory
    mode: '0755'

- name: Set server taints
  ansible.builtin.lineinfile:
    path: "{{ rke2_config_dir }}/config.yaml"
    line: "server-taints: {{ server_taints }}"
    create: true
    mode: '0644'
  when: node_type == 'server'

- name: Set agent taints
  ansible.builtin.lineinfile:
    path: "{{ rke2_config_dir }}/config.yaml"
    line: "agent-taints: {{ agent_taints }}"
    create: true
    mode: '0644'
  when: node_type == 'agent'

- name: Copy RKE2 configuration file
  ansible.builtin.template:
    src: "templates/rke2_config.yaml.j2"
    dest: "{{ rke2_config_dir }}/config.yaml"
    mode: '0644'
  notify: Restart RKE2 service

- name: Copy Kubelet configuration file
  ansible.builtin.template:
    src: "templates/kubelet_config.yaml.j2"
    dest: "{{ kubelet_config_path }}"
    mode: '0644'
  when: kubelet_config is defined
  notify: Restart Kubelet service

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ containerd_registry_config_src }}"
    dest: "{{ containerd_registry_config_dest }}"
    mode: '0644'
  when: containerd_registry_config_src is defined
  notify: Restart Containerd service

- name: Start RKE2 service on other nodes
  ansible.builtin.service:
    name: rke2-server
    state: started
    enabled: true
  notify: Restart RKE2 service

- name: Mask other RKE2 services on nodes
  ansible.builtin.systemd:
    name: "{{ item }}"
    state: masked
  loop:
    - rke2-agent
    - rke2-server
  when: node_type == 'server' or node_type == 'agent'

- name: Wait for remaining nodes to be ready - no CNI
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: 6443
    timeout: 600
    state: started

- name: Wait for remaining nodes to be ready - with CNI
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: 6443
    timeout: 600
    state: started


