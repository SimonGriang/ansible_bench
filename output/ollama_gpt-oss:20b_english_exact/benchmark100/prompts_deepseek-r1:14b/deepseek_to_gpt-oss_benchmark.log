---
- name: Import assertion tasks
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Python pip
  ansible.builtin.package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: index-url
    value: "{{ python_pip_proxy }}"
    mode: '0644'
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ python_pip_trusted_host }}"
    mode: '0644'
  when: python_pip_trusted_host is defined

- name: Update pip
  ansible.builtin.pip:
    name: pip
    state: present
    extra_args: --upgrade
  when:
    - ansible_distribution not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'

- name: Install Python modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(omit) }}"
  loop: "{{ python_pip_modules }}"
  when:
    - ansible_distribution not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'


