---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
    - name: Manage SELinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot
    - name: Manage SELinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
        label: "{{ item.name }}"
      loop: "{{ selinux_booleans }}"
      when: selinux_booleans is defined
  when: selinux_status is defined and ansible_connection not in ['container', 'docker', 'community.docker.docker']


