---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.command:
    cmd: cat /etc/os-release
  register: os_release_raw
  changed_when: false

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: >-
      {{ os_release_raw.stdout |
          regex_search('^ID=([^\\n]+)', '\\1') |
          regex_replace('\"', '') }}
    bootstrap_version_major: >-
      {{ (os_release_raw.stdout |
          regex_search('^VERSION_ID=\"?([^\\n\"]+)\"?', '\\1')).split('.')[0] }}

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: >-
      {{ {'ubuntu': 'debian',
          'centos': 'redhat',
          'rhel': 'redhat',
          'fedora': 'redhat',
          'debian': 'debian',
          'arch': 'arch'}.get(bootstrap_distribution, 'unknown') }}



