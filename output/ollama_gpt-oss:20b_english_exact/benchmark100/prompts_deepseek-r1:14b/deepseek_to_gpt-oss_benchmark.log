---
- name: Install EPEL on compatible systems
  when: >-
    (ansible_distribution == 'Amazon' and
     ansible_distribution_version is version('2', '==')) or
    (ansible_distribution == 'RedHat' and
     ansible_distribution_version is version('7', '>=') and
     ansible_distribution_version is version('10', '<='))
  block:
    - name: Install EPEL GPG key
      ansible.builtin.rpm_key:
        state: present
        key: "{{ epel_gpg_key_url }}"
    - name: Install EPEL-release package
      ansible.builtin.dnf:
        name: "{{ epel_url }}"
        state: present
    - name: Install EPEL-next-release package
      ansible.builtin.dnf:
        name: "{{ epel_next_url }}"
        state: present
      when: epel_next | bool
    - name: Update package cache
      ansible.builtin.debug:
        msg: "Triggering package cache update"
      notify: Update package cache


