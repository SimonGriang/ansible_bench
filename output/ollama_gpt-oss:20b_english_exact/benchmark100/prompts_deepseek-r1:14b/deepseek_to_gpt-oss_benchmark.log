---
- name: Import assertion tasks from assert.yml
  import_tasks: assert.yml

- name: Install logrotate package
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  template:
    src: logrotate_config_file.j2
    dest: "{{ logrotate_config_dir }}"

- name: Generate logrotate.d configuration files
  template:
    src: "{{ item.template }}"
    dest: "{{ item.dest }}"
  loop: "{{ logrotate_entries }}"
  when: item.state != 'absent'

- name: Remove logrotate.d files for entries marked as absent
  file:
    path: "{{ item.dest }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  when: item.state == 'absent'

- name: Start and enable the logrotate service
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state | default('started') }}"
    enabled: "{{ logrotate_service_enabled | default(true) }}"
  when: logrotate_service is defined


