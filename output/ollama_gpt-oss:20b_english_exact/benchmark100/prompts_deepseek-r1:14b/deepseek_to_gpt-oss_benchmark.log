---
- name: Import assertion tasks
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install Python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  lineinfile:
    path: /etc/pip.conf
    regexp: '^\\s*index-url\\s*='
    line: "index-url = {{ python_pip_proxy }}"
    insertafter: '^\\[global\\]'
    state: present
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  lineinfile:
    path: /etc/pip.conf
    regexp: '^\\s*trusted-host\\s*='
    line: "trusted-host = {{ python_pip_trusted_host }}"
    insertafter: '^\\[global\\]'
    state: present
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: latest
  when: >
    ansible_facts.os_family != 'Alpine' and
    ansible_facts.distribution not in ['bookworm', 'noble']

- name: Install Python modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    version: "{{ item.version }}"
  loop: "{{ python_pip_modules }}"
  when: >
    ansible_facts.os_family != 'Alpine' and
    ansible_facts.distribution not in ['bookworm', 'noble']


