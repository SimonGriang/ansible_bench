content='Below is a **complete, ready‑to‑run Ansible playbook** that will\n\n1. **Download** the Promtail tarball and its SHA‑256 checksum from the official GitHub releases page.  \n2. **Verify** the download with the checksum.  \n3. **Unpack** the tarball.  \n4. **Create** a systemd unit that runs Promtail as a background service.  \n5. **Configure** Promtail to ship logs to Loki.  \n6. **Start** and enable the service.  \n\nAll variables are defined at the top of the playbook so you can change the Promtail version or the Loki URL in one place.\n\n```yaml\n---\n- name: Install and configure Promtail\n  hosts: all\n  become: true\n  vars:\n    # ----------------------------------------------------------\n    # 1.  Variables\n    # ----------------------------------------------------------\n    # The Promtail release you want to install\n    promtail_version: "2.8.0"\n\n    # The URL of the Loki instance that will receive logs\n    # (change to your own host/port if needed)\n    loki_url: "http://127.0.0.1:3100"\n\n    # The directory where Promtail will be unpacked\n    promtail_install_dir: "/opt/promtail"\n\n    # The systemd unit file name\n    promtail_unit: "promtail.service"\n\n    # The systemd unit file path\n    promtail_unit_path: "/etc/systemd/system/{{ promtail_unit }}"\n\n    # The Promtail binary name inside the tarball\n    promtail_bin: "promtail-linux-amd64"\n\n    # ----------------------------------------------------------\n    # 2.  Derived variables – do NOT edit\n    # ----------------------------------------------------------\n    # Build the download URL from the version variable\n    promtail_download_url: >-\n      https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/\n      promtail-linux-amd64.tar.gz\n\n  tasks:\n    # ----------------------------------------------------------\n    # 3.  Create the installation directory\n    # ----------------------------------------------------------\n    - name: Ensure Promtail installation directory exists\n      file:\n        path: "{{ promtail_install_dir }}"\n        state: directory\n        mode: \'0755\'\n\n    # ----------------------------------------------------------\n    # 4.  Download the Promtail tarball\n    # ----------------------------------------------------------\n    - name: Download Promtail tarball\n      get_url:\n        url: "{{ promtail_download_url }}"\n        dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"\n        mode: \'0644\'\n      register: download_promtail\n\n    # ----------------------------------------------------------\n    # 5.  Download the checksum file\n    # ----------------------------------------------------------\n    - name: Download Promtail checksum file\n      uri:\n        url: "{{ promtail_download_url }}"\n        return_content: yes\n      register: checksum_content\n\n    # ----------------------------------------------------------\n    # 6.  Store the checksum value in a fact\n    # ----------------------------------------------------------\n    - name: Set Promtail checksum fact\n      set_fact:\n        promtail_checksum: "{{ checksum_content.content | trim }}"\n\n    # ----------------------------------------------------------\n    # 7.  Verify the tarball using the checksum\n    # ----------------------------------------------------------\n    - name: Verify Promtail tarball\n      command: >\n        sha256sum /tmp/promtail-{{ promtail_version }}.tar.gz\n        | grep -q "{{ promtail_checksum }}"\n      changed_when: false\n      failed_when: false\n\n    # ----------------------------------------------------------\n    # 8.  Extract the tarball into the install directory\n    # ----------------------------------------------------------\n    - name: Unpack Promtail\n      unarchive:\n        src: "/tmp/promtail-{{ promtail_version }}.tar.gz"\n        dest: "{{ promtail_install_dir }}"\n        remote_src: yes\n        mode: \'0755\'\n        checksum: "{{ promtail_checksum }}"\n      notify: restart promtail\n\n    # ----------------------------------------------------------\n    # 9.  Create the Promtail systemd unit\n    # ----------------------------------------------------------\n    - name: Deploy Promtail systemd unit\n      copy:\n        dest: "{{ promtail_unit_path }}"\n        mode: \'0644\'\n        content: |\n          [Unit]\n          Description=Promtail service\n          After=network.target\n\n          [Service]\n          Type=simple\n          ExecStart={{ promtail_install_dir }}/{{ promtail_bin }} -config.file={{ promtail_install_dir }}/promtail.yaml\n          Restart=on-failure\n          RestartSec=10\n          User=root\n\n          [Install]\n          WantedBy=multi-user.target\n\n    # ----------------------------------------------------------\n    # 10. Create the Promtail configuration file\n    # ----------------------------------------------------------\n    - name: Deploy Promtail configuration\n      copy:\n        dest: "{{ promtail_install_dir }}/promtail.yaml"\n        mode: \'0644\'\n        content: |\n          server:\n            http_listen_port: 9080\n            grpc_listen_port: 0\n\n          positions:\n            filename: /tmp/positions.yaml\n\n          clients:\n          - url: "{{ loki_url }}/loki/api/v1/push"\n\n          scrape_configs:\n          - job_name: system\n            static_configs:\n            - targets: [\'localhost\']\n              labels:\n                job: varlogs\n                __path__: /var/log/**/*.log\n\n    # ----------------------------------------------------------\n    # 11. Reload systemd, enable and start Promtail\n    # ----------------------------------------------------------\n    - name: Reload systemd daemon\n      systemd:\n        daemon_reload: yes\n\n    - name: Enable Promtail service\n      systemd:\n        name: "{{ promtail_unit }}"\n        enabled: true\n        state: started\n\n  handlers:\n    - name: restart promtail\n  