---  
- name: Import assert.yml  
  import_tasks: assert.yml  
  run_once: true  
  delegate_to: localhost  

- name: Install mysql  
  package:  
    name: "{{ mysql_packages }}"  
    state: present  
  notify:  
    - Set root password  
    - Systemctl daemon-reexec  

- name: Configure mysql server  
  lineinfile:  
    path: /etc/my.cnf  
    regexp: "^{{ item.key }}\\s*="  
    line: "{{ item.key }}={{ item.value }}"  
    create: yes  
  loop: "{{ mysql_configuration_options }}"  
  notify: Restart mysql server  

- name: Configure mysql client  
  lineinfile:  
    path: /etc/my.cnf  
    regexp: "^socket\\s*="  
    line: "socket={{ mysql_socket_path }}"  
    create: yes  

- name: Initialize mysql  
  command: mysql_install_db  
  when: ansible_facts['distribution'] in ['Alpine', 'Archlinux']  

- name: Start and enable mysql  
  service:  
    name: mysql  
    state: started  
    enabled: true  

- name: Place my.cnf  
  template:  
    src: my.cnf.j2  
    dest: /etc/my.cnf  
    mode: '0644'  

- name: Create databases  
  mysql_db:  
    name: "{{ item }}"  
    state: present  
  loop: "{{ mysql_databases }}"  
  when: mysql_databases is defined  

- name: Create users  
  mysql_user:  
    name: "{{ item.name }}"  
    password: "{{ item.password }}"  
    host: "{{ item.host | default('%') }}"  
    priv: "{{ item.priv | default('*.*:ALL') }}"  
    state: present  
  loop: "{{ mysql_users }}"  
  when: mysql_users is defined  

- name: Flush handlers again  
  meta: flush_handlers  


