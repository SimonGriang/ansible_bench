---
- name: Restart RKE2 service on {{ rke2_node_name}}
  service:
    name: "{{ rke2_node_name }}"
    state: restarted
  notify:
    - Service (re)started

- name: Wait for all nodes to be ready again
  shell: |
    kubectl get nodes --no-headers | grep -v 'Ready' | wc -l
  register: _nodes_ready_check
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  when: ansible_check_mode == false
  retries: 100
  delay: 15
  until: _nodes_ready_check.stdout | int == 0

- name: Wait for all pods to be ready again
  shell: |
    kubectl get pods --all-namespaces --no-headers | grep -v 'Running' | wc -l
  register: _pods_ready_check
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  when:
    - ansible_check_mode == false
    - rke2_wait_for_all_pods_to_be_ready | bool
  retries: 100
  delay: 15
  until: _pods_ready_check.stdout | int == 0


