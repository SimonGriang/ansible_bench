---
- name: Create the RKE2 config directory
  file:
    path: "{{ rke2_config_dir }}"
    state: directory
    mode: "0755"

- name: Set server taints
  set_fact:
    node_taints: "{{ rke2_server_node_taints }}"
  when: "'server' in group_names"

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_src }}"
    dest: "{{ rke2_config_dir }}/config.yaml"
    mode: "0644"
  notify: restart rke2 service

- name: Copy kubelet configuration file
  copy:
    src: "{{ rke2_kubelet_config_src }}"
    dest: "{{ rke2_config_dir }}/kubelet.yaml"
    mode: "0644"
  when: rke2_kubelet_config is defined and rke2_kubelet_config | length > 0
  notify: restart rke2 service

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ containerd_registry_config_src }}"
    dest: "{{ rke2_config_dir }}/registries.yaml"
    mode: "0644"
  when: custom_registry_mirrors is defined or custom_registry_configs is defined
  notify: restart containerd

- name: Register etcd restore from file
  set_fact:
    etcd_restore_from_file: "{{ snapshot_file is defined and rke2_service_status == 'stopped' }}"

- name: Register etcd restore from S3
  set_fact:
    etcd_restore_from_s3: "{{ s3_options is defined and s3_options.s3_bucket is defined and s3_options.s3_region is defined }}"

- name: Restore etcd from file
  block:
    - name: Create etcd restore directory
      file:
        path: "{{ rke2_etcd_restore_dir }}"
        state: directory
        mode: "0755"
    - name: Copy etcd snapshot file
      copy:
        src: "{{ snapshot_file }}"
        dest: "{{ rke2_etcd_restore_dir }}/snapshot.db"
        mode: "0644"
    - name: Run etcd restore command
      command: |
        rke2 etcd --restore-from-snapshot {{ rke2_etcd_restore_dir }}/snapshot.db
      become: true
  when: etcd_restore_from_file

- name: Restore etcd from S3
  block:
    - name: Download snapshot from S3
      aws_s3:
        bucket: "{{ s3_options.s3_bucket }}"
        object: "{{ s3_options.s3_object }}"
        dest: "{{ rke2_etcd_restore_dir }}/snapshot.db"
        mode: "0644"
        region: "{{ s3_options.s3_region }}"
    - name: Run etcd restore command
      command: |
        rke2 etcd --restore-from-snapshot {{ rke2_etcd_restore_dir }}/snapshot.db
      become: true
  when: etcd_restore_from_s3

- name: Start RKE2 service
  service:
    name: rke2-server
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: restart rke2 service

- name: Mask RKE2 agent service
  systemd:
    name: rke2-agent
    masked: true
    enabled: false
    state: stopped

- name: Wait for first server to be ready (no CNI)
  shell: |
    kubectl get nodes -o json
    | jq -r '.items[0].status.conditions[] | select(.type=="Ready") | .status'
  register: node_ready_status
  until: node_ready_status.stdout == "True"
  delay: 10
  retries: 30
  when: not cni_enabled

- name: Wait for first server to be ready (with CNI)
