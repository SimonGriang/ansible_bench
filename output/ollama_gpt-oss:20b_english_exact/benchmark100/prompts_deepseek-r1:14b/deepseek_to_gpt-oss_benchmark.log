---
- name: hardening | Disable swap
  when: vault_hardening_disable_swap | bool
  block:
    - name: Disable swap immediately
      ansible.builtin.command: swapoff -a
      args:
        warn: false
      changed_when: false
    - name: Comment out swap entries in /etc/fstab
      ansible.builtin.lineinfile:
        path: /etc/fstab
        regexp: '^\s*[^#]*\s+swap\s+'
        state: absent
        backup: true

- name: hardening | Disable core dumps
  when: vault_hardening_disable_core_dumps | bool
  block:
    - name: Set hard core limit
      community.general.pam_limits:
        domain: '*'
        limit_type: hard
        limit_item: core
        value: 0
    - name: Set soft core limit
      community.general.pam_limits:
        domain: '*'
        limit_type: soft
        limit_item: core
        value: 0

- name: hardening | Disable Shell Command History
  when: vault_hardening_disable_shell_command_history | bool
  block:
    - name: Add HISTIGNORE rule to vault.sh
      ansible.builtin.lineinfile:
        path: /etc/profile.d/vault.sh
        create: true
        line: "export HISTIGNORE='*vault*'"
        mode: "0644"

- name: hardening | Configure SELinux / AppArmor
  when: vault_hardening_configure_selinux_apparmor | bool
  block:
    - name: Enable SELinux
      ansible.posix.selinux:
        state: enforcing
    - name: Install SELinux policies
      ansible.builtin.package:
        name:
          - policycoreutils
          - selinux-policy-targeted
        state: present
    - name: Install AppArmor packages
      ansible.builtin.package:
        name:
          - apparmor
          - apparmor-profiles
        state: present
    - name: Enforce AppArmor profile for Vault
      ansible.builtin.command: aa-enforce /etc/apparmor.d/usr.bin.vault
      args:
        creates: /etc/apparmor.d/usr.bin.vault.enforced
      changed_when: false


