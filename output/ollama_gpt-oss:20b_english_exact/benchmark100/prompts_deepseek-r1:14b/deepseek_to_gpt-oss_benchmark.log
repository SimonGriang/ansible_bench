---
- name: Import assertion file
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install cron package
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  ansible.builtin.lineinfile:
    path: /etc/default/cron
    regexp: '^SHELL='
    line: 'SHELL=/bin/bash'
    state: present

- name: Configure cron path environment
  ansible.builtin.lineinfile:
    path: /etc/default/cron
    regexp: '^PATH='
    line: 'PATH=/usr/bin:/usr/local/bin'
    state: present

- name: Configure cron mailto settings
  ansible.builtin.lineinfile:
    path: /etc/default/cron
    regexp: '^MAILTO='
    line: 'MAILTO=root@localhost'
    state: present

- name: Start and enable cron service
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined

- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    user: "{{ item.user | default('root') }}"
    state: present
  loop: "{{ cron_jobs }}"


