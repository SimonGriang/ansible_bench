---
- name: "Import assert.yml"
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: "Manage automatic service management"
  block:
    - name: "Copy policy-rc.d to disable apt autostart"
      copy:
        dest: /usr/sbin/policy-rc.d
        content: "exit 101"
        mode: '0755'
      when: apt_autostart_state == 'disabled'
    - name: "Remove policy-rc.d to enable apt autostart"
      file:
        path: /usr/sbin/policy-rc.d
        state: absent
      when: apt_autostart_state == 'enabled'
  when: ansible_pkg_mgr == 'apt'


