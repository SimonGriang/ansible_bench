---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare system
  block:
    - name: Test connection with a timeout
      command: ping -c 1 localhost
      async: "{{ bootstrap_timeout }}"
      poll: 0
    - name: Test sudo version
      command: sudo -V
  rescue:
    - name: Gather ansible facts
      setup:
    - name: Install bootstrap packages (package)
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      become: "{{ bootstrap_become }}"

- name: Gather ansible facts
  setup:
    gather_subset: all
  become: false

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"


