---
- name: Generate a private SSL key using OpenSSL
  community.crypto.openssl_privatekey:
    path: "{{ ssl_key_path }}"
    size: 2048
    state: present
    owner: "{{ ssl_key_owner | default('root') }}"
    group: "{{ ssl_key_group | default('root') }}"
    mode: "0600"

- name: Generate a Certificate Signing Request (CSR)
  community.crypto.openssl_csr:
    path: "{{ ssl_csr_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    common_name: "{{ ssl_common_name }}"
    state: present
    owner: "{{ ssl_csr_owner | default('root') }}"
    group: "{{ ssl_csr_group | default('root') }}"
    mode: "0644"

- name: Generate a self-signed SSL certificate
  community.crypto.x509_certificate:
    path: "{{ ssl_cert_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    csr_path: "{{ ssl_csr_path }}"
    selfsigned: true
    selfsigned_not_after: 365
    state: present
    owner: "{{ ssl_cert_owner | default('root') }}"
    group: "{{ ssl_cert_group | default('root') }}"
    mode: "0644"

- name: Create a PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: "{{ ssl_pkcs12_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    certificate_path: "{{ ssl_cert_path }}"
    state: present
    passphrase: "{{ ssl_pkcs12_password | default('changeit') }}"
    owner: "{{ ssl_pkcs12_owner | default('root') }}"
    group: "{{ ssl_pkcs12_group | default('root') }}"
    mode: "0600"

- name: Read the private key content
  ansible.builtin.set_fact:
    private_key_content: "{{ lookup('file', ssl_key_path) }}"

- name: Read the certificate content
  ansible.builtin.set_fact:
    certificate_content: "{{ lookup('file', ssl_cert_path) }}"

- name: Combine private key and certificate into a single file
  ansible.builtin.copy:
    dest: "{{ ssl_combined_path }}"
    content: "{{ private_key_content }}\n{{ certificate_content }}"
    owner: "{{ ssl_combined_owner | default('root') }}"
    group: "{{ ssl_combined_group | default('root') }}"
    mode: "0600"


