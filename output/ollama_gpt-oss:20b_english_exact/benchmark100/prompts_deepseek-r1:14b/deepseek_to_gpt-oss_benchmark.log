---
- name: Generate an OpenSSL private key
  openssl_privatekey:
    path: "{{ key_dir }}/{{ key_file }}"
    size: 2048
    state: present
    mode: "{{ key_mode | default('0600') }}"
    owner: "{{ key_owner | default('root') }}"
    group: "{{ key_group | default('root') }}"

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ key_dir }}/{{ csr_file }}"
    privatekey_path: "{{ key_dir }}/{{ key_file }}"
    common_name: "{{ common_name | default('example.com') }}"
    mode: "{{ csr_mode | default('0644') }}"
    owner: "{{ csr_owner | default('root') }}"
    group: "{{ csr_group | default('root') }}"

- name: Generate an OpenSSL X.509 certificate
  openssl_certificate:
    path: "{{ key_dir }}/{{ cert_file }}"
    privatekey_path: "{{ key_dir }}/{{ key_file }}"
    csr_path: "{{ key_dir }}/{{ csr_file }}"
    provider: selfsigned
    mode: "{{ cert_mode | default('0644') }}"
    owner: "{{ cert_owner | default('root') }}"
    group: "{{ cert_group | default('root') }}"

- name: Generate a PKCS#12 file
  openssl_pkcs12:
    path: "{{ key_dir }}/{{ pkcs12_file }}"
    privatekey_path: "{{ key_dir }}/{{ key_file }}"
    certificate_path: "{{ key_dir }}/{{ cert_file }}"
    friendly_name: "{{ friendly_name | default('mycert') }}"
    mode: "{{ pkcs12_mode | default('0600') }}"
    owner: "{{ pkcs12_owner | default('root') }}"
    group: "{{ pkcs12_group | default('root') }}"

- name: Read private key content
  set_fact:
    private_key_content: "{{ lookup('file', key_dir + '/' + key_file) }}"

- name: Read certificate content
  set_fact:
    certificate_content: "{{ lookup('file', key_dir + '/' + cert_file) }}"

- name: Create a combined private key and certificate file
  copy:
    dest: "{{ key_dir }}/{{ combined_file | default('combined.pem') }}"
    content: "{{ private_key_content + certificate_content }}"
    mode: "{{ combined_mode | default('0644') }}"
    owner: "{{ combined_owner | default('root') }}"
    group: "{{ combined_group | default('root') }}"



