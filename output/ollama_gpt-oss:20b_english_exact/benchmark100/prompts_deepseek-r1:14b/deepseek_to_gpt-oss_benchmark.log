- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: "0700"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_data_dir }}"
    - "{{ dns_config_dir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true
    group: "{{ dns_group }}"

- name: Generate rndc key
  command: rndc-confgen -a -c "{{ dns_config_dir }}/rndc.key"
  args:
    creates: "{{ dns_config_dir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_config_dir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
