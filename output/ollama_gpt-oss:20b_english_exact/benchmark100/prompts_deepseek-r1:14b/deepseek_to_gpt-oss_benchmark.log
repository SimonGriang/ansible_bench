---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install mysql
  ansible.builtin.package:
    name: "{{ packages }}"
    state: present
  notify:
    - Set mysql root password
    - Re-execute systemctl daemon

- name: Configure mysql server
  ansible.builtin.template:
    src: mysql_server.conf.j2
    dest: "{{ mysql_conf_path }}"
    mode: "0644"
  notify:
    - Restart mysql server

- name: Configure mysql client
  ansible.builtin.template:
    src: mysql_client.conf.j2
    dest: "{{ mysql_client_conf_path }}"
    mode: "0644"

- name: Initialize mysql
  ansible.builtin.shell: "{{ mysql_init_command }}"
  when: ansible_os_family in ['Alpine', 'Archlinux']
  changed_when: false

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: "/etc/my.cnf"
    mode: "{{ mycnf_mode }}"

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
    login_user: "{{ mysql_user }}"
    login_password: "{{ mysql_password }}"
  loop: "{{ databases }}"
  when: initial_import is not defined

- name: List databases
  community.mysql.mysql_db:
    login_user: "{{ mysql_user }}"
    login_password: "{{ mysql_password }}"
    state: list
    name: ""
  register: mysql_db_list

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: import
    target: "{{ initial_import_path }}/{{ item }}.sql"
    login_user: "{{ mysql_user }}"
    login_password: "{{ mysql_password }}"
  loop: "{{ databases }}"
  when: item not in mysql_db_list.databases
  notify:
    - Restart mysql server

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}@{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
    login_user: "{{ mysql_user }}"
    login_password: "{{ mysql_password }}"
  loop: "{{ mysql_users }}"
  notify:
    - Restart mysql server

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


