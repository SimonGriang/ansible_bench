- name: Install packages
  hosts: all
  become: true
  vars:
    # Debian/Ubuntu
    apt:
      packages:
        - git
        - curl
        - htop

    # RedHat/CentOS 6
    yum:
      packages:
        - git
        - curl
        - htop

    # RedHat/CentOS 7
    yum:
      packages:
        - git
        - curl
        - htop

    # RedHat/CentOS 8
    dnf:
      packages:
        - git
        - curl
        - htop

    # RedHat/CentOS 9
    yum:
      packages:
        - git
        - curl
        - htop

    # RedHat/CentOS 10
    yum:
      packages:
        - git
        - curl
