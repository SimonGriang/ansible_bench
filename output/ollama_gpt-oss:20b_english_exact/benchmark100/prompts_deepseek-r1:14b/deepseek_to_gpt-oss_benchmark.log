---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare system
  block:
    - name: Test connection with timeout
      ansible.builtin.wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"

    - name: Test sudo version
      ansible.builtin.command: sudo -V
      register: sudo_version
      changed_when: false
  rescue:
    - name: Gather facts
      ansible.builtin.setup:

    - name: Install bootstrap packages
      ansible.builtin.package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      become: "{{ bootstrap_become }}"

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"}


