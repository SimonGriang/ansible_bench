---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: "{{ 'temurin' if java_jdk_vendor == 'adoptopenjdk' else java_jdk_vendor }}"

- name: Gather OS specific variables
  include_vars:
    file: "vars/{{ java_jdk_vendor }}/{{ ansible_distribution | lower }}-{{ ansible_distribution_version | replace('.', '') }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: "vars/{{ java_jdk_vendor }}/{{ ansible_architecture }}.yml"

- name: Set OS specific variables (I)
  set_fact:
    java_version: "{{ java_version | default('17') }}"
    java_repos: "{{ java_repos | default([]) }}"
    java_libs: "{{ java_libs | default([]) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_install_path: "{{ java_install_path | default('/opt/java') }}"
    java_package_name: "{{ java_package_name | default('openjdk-{{ java_version }}-jdk') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_install_path }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "{{ item }}"
        state: absent
      loop:
        - "deb http://old.repo.example.com/debian {{ ansible_distribution_release }} main"
    - name: Install extra apt tools
      apt:
        name:
          - apt-transport-https
          - ca-certificates
        state: present
        update_cache: yes
    - name: Add key repositories
      apt_key:
        url: "{{ item }}"
        state: present
      loop:
        - "https://packages.adoptium.net/artifactory/api/gpg/key/public"
    - name: Add required repositories
      apt_repository:
        repo: "{{ item }}"
        state: present
        filename: "temurin"
      loop: "{{ java_repos }}"
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      yum_repository:
        name: "temurin"
        description: "AdoptOpenJDK Temurin Repository"
        baseurl: "{{ item.baseurl }}"
        gpgcheck: yes
        gpgkey: "{{ item.gpgkey }}"
        enabled: yes
      loop: "{{ java_repos }}"
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  package:
    name: "{{ java_libs }}"
    state: present

- name: Install Java, Debian
  apt:
    name: "{{ java_package_name }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ java_package_name }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  copy:
    dest: /etc/profile.d/java.sh
    content: |
      export JAVA_HOME={{ java_home }}
      export PATH=$JAVA_HOME/bin:$PATH
    mode: '0644'

- name: Source environment variables
  shell: source /etc/profile.d/java.sh
  args:
    executable: /bin/bash
  changed_when: false

- name: Correct java version selected for Java < 11
  alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_home }}/jre/bin/java"
    priority: 1
  when: java_version | int < 11

- name: Correct java version selected for Java >= 11
  alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_home }}/bin/java"
    priority: 1
  when: java_version | int >= 11


