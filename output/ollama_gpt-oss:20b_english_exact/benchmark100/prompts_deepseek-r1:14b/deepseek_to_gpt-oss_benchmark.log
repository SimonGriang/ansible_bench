---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install git
  ansible.builtin.package:
    name: "{{ packages }}"
    state: "{{ state }}"

- name: Check if user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ username }}"
  register: user_info
  failed_when: false

- name: Create git config directory
  ansible.builtin.file:
    path: "{{ user_home }}/.gitconfig"
    state: directory
    owner: "{{ username }}"
    group: "{{ username }}"
    mode: '0755'

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "{{ user_home }}/.gitconfig"
    owner: "{{ username }}"
    group: "{{ username }}"
    mode: '0644'

- name: Create repository destination
  ansible.builtin.file:
    path: "{{ repo_dest }}"
    state: directory
    owner: "{{ repo_owner }}"
    group: "{{ repo_group }}"
    mode: "{{ repo_mode }}"

- name: Clone all repositories
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version }}"
    force: true
    accept_hostkey: true
  loop: "{{ repositories }}"
  become: true
  become_user: "{{ item.owner }}"
  become_method: ansible.builtin.sudo


