---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner | default(dns_owner) }}"
    group: "{{ item.group | default(dns_group) }}"
    mode: "{{ item.mode | default('0755') }}"
  loop:
    - path: "{{ dns_data_dir }}"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: '0755'
    - path: "{{ dns_config_dir }}"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: '0755'

- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  ansible.builtin.user:
    name: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    system: true
    create_home: false
    state: present

- name: Generate rndc key
  ansible.builtin.command: 'rndc-confgen -a -k rndc.key -c "{{ dns_config_dir }}/rndc.key"'
  args:
    creates: "{{ dns_config_dir }}/rndc.key"

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ dns_config_dir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0600'

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: https://www.internic.net/domain/named.root
    dest: "{{ dns_data_dir }}/named.root"
    mode: '0644'
  when: dns_caching_dns

- name: Create zone file
  ansible.builtin.template:
    src: "{{ item.template }}"
    dest: "{{ dns_data_dir }}/{{ item.name }}.zone"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  ansible.builtin.template:
    src: dns.conf.j2
    dest: "{{ dns_config_dir }}/named.conf"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  notify: Restart dns

- name: Place systemd override
  ansible.builtin.template:
    src: systemd_overrides.j2
    dest: "/etc/systemd/system/{{ dns_service_name }}.service.d/override.conf"
    owner: root
    group: root
    mode: '0644'
  notify: Reload systemd
  when: use_systemd

- name: Start and enable dns
  ansible.builtin.service:
    name: "{{ dns_service_name }}"
    state: started
    enabled: true


