---
- name: Generate an OpenSSL private key
  community.crypto.openssl_privatekey:
    path: "{{ key_dir }}/{{ key_file }}"
    size: 2048
    type: RSA
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  community.crypto.openssl_csr:
    path: "{{ csr_dir }}/{{ csr_file }}"
    privatekey_path: "{{ key_dir }}/{{ key_file }}"
    common_name: "{{ common_name }}"
    mode: "{{ csr_mode }}"
    owner: "{{ csr_owner }}"
    group: "{{ csr_group }}"

- name: Generate an OpenSSL X.509 certificate
  community.crypto.openssl_certificate:
    path: "{{ cert_dir }}/{{ cert_file }}"
    csr_path: "{{ csr_dir }}/{{ csr_file }}"
    privatekey_path: "{{ key_dir }}/{{ key_file }}"
    provider: selfsigned
    days: 365
    mode: "{{ cert_mode }}"
    owner: "{{ cert_owner }}"
    group: "{{ cert_group }}"

- name: Generate a PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: "{{ pkcs12_dir }}/{{ pkcs12_file }}"
    privatekey_path: "{{ key_dir }}/{{ key_file }}"
    certificate_path: "{{ cert_dir }}/{{ cert_file }}"
    friendly_name: "{{ friendly_name }}"
    mode: "{{ pkcs12_mode }}"
    owner: "{{ pkcs12_owner }}"
    group: "{{ pkcs12_group }}"

- name: Read private key content
  set_fact:
    private_key_content: "{{ lookup('file', key_dir + '/' + key_file) }}"

- name: Read certificate content
  set_fact:
    cert_content: "{{ lookup('file', cert_dir + '/' + cert_file) }}"

- name: Create a combined private key and certificate file
  copy:
    dest: "{{ key_dir }}/{{ combined_file }}"
    content: "{{ private_key_content }}{{ cert_content }}"
    mode: "{{ combined_mode }}"
    owner: "{{ combined_owner }}"
    group: "{{ combined_group }}"


