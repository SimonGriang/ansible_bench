---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install mysql
  ansible.builtin.package:
    name: "{{ packages }}"
    state: present
  notify:
    - "root password"
    - "systemctl daemon reexecution"

- name: Configure mysql server
  ansible.builtin.template:
    src: mysql_server_options.j2
    dest: /etc/mysql/mysql.conf.d/mysqld.cnf
    mode: "0644"
  notify:
    - "mysql server restart"

- name: Configure mysql client
  ansible.builtin.template:
    src: mysql_client_options.j2
    dest: /etc/mysql/conf.d/mysql_client.cnf
    mode: "0644"

- name: Initialize mysql
  ansible.builtin.command: mysqld --initialize-insecure
  args:
    creates: /var/lib/mysql/mysql.sock
  when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: "{{ my_cnf_mode }}"

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ databases }}"
  when: initial_import is not defined

- name: List databases
  community.mysql.mysql_db:
    name: all
    state: list
  register: db_info

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: import
    target: "{{ initial_import_location }}/{{ item }}.sql"
  loop: "{{ databases }}"
  when: item not in db_info.databases

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  loop: "{{ mysql_users }}"
  notify:
    - "mysql server restart"

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


