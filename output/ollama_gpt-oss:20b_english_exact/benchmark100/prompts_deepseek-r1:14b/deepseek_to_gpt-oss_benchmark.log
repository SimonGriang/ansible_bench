---
- name: Create etcd group
  ansible.builtin.group:
    name: etcd
    state: present

- name: Create etcd user
  ansible.builtin.user:
    name: etcd
    state: present
    comment: etcd user
    shell: /bin/nologin
    group: etcd

- name: Copy systemctl config file for kernel hardening
  ansible.builtin.copy:
    src: >-
      {{ '/usr/local/share/rke2/rke2-cis-sysctl.conf' if
      (not usr_local.stat.writeable) or (partition_result.rc == 1) else
      '/opt/rke2/share/rke2/rke2-cis-sysctl.conf' }}
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: '0600'
    remote_src: true
  notify: Restart systemd-sysctl

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


