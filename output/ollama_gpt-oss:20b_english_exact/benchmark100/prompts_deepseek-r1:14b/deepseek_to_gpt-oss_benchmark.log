---
- name: Import assertion file
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install system requirements
  package:
    name: bash
    state: present
  become: true

- name: Install OpenJDK Java
  package:
    name: openjdk-11-jdk
    state: present
  become: true
  when: java_vendor == "openjdk"

- name: Install Oracle Java RPM from local
  copy:
    src: oracle-java.rpm
    dest: /tmp/oracle-java.rpm
    mode: '0644'
  become: true
  when: java_source == "local" and java_format == "rpm"

- name: Install Oracle Java RPM from local
  yum:
    name: /tmp/oracle-java.rpm
    state: present
  become: true
  when: java_source == "local" and java_format == "rpm"

- name: Install Oracle Java DEB from local
  copy:
    src: oracle-java.deb
    dest: /tmp/oracle-java.deb
    mode: '0644'
  become: true
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java DEB from local
  apt:
    deb: /tmp/oracle-java.deb
    state: present
  become: true
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java RPM from repository
  yum:
    name: oracle-java8.x86_64
    state: present
  become: true
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Java targz installation
  unarchive:
    src: oracle-java.tar.gz
    dest: /opt/java
    remote_src: true
    mode: '0755'
  become: true
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java JCE policy
  unarchive:
    src: jce_policy.zip
    dest: "{{ java_home }}"
    remote_src: true
    mode: '0755'
  become: true
  when: java_jce == true and java_version == 8 and java_vendor == "oracle"

- name: Set Java alternative
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    state: present
  become: true
  when: java_format == "targz" and distribution != "Alpine"

- name: Find Java home directory
  command: readlink -f /usr/bin/java | xargs dirname | xargs dirname
  register: java_home_result
  changed_when: false

- name: Set JAVA_HOME in environment
  copy:
    dest: /etc/profile.d/java_home.sh
    content: |
      export JAVA_HOME={{ java_home_result.stdout }}
    mode: '0755'
  become: true




