content='---\n- name: Download RKE2 installation script\n  ansible.builtin.get_url:\n    url: "{{ rke2_install_script_url }}"\n    dest: "{{ rke2_install_script_dest }}"\n    mode: \'0700\'\n  when: not airgap_mode\n\n- name: Copy local RKE2 installation script\n  ansible.builtin.copy:\n    src: "{{ rke2_install_script_local }}"\n    dest: "{{ rke2_install_script_dest }}"\n    mode: \'0700\'\n  when: airgap_mode and implementation == \'copy\'\n\n- name: Create RKE2 artifacts folder\n  ansible.builtin.file:\n    path: "{{ rke2_artifacts_dir }}"\n    state: directory\n    mode: \'0700\'\n  when: airgap_mode and implementation != \'exists\'\n\n- name: Download RKE2 checksum and artifacts\n  when: not airgap_mode\n  block:\n    - name: Download checksum\n      ansible.builtin.get_url:\n        url: "{{ rke2_checksum_url }}"\n        dest: "{{ rke2_checksum_dest }}"\n        checksum: "{{ rke2_checksum_algo }}:{{ rke2_checksum_value }}"\n        mode: \'0644\'\n    - name: Download artifacts\n      ansible.builtin.get_url:\n        url: "{{ rke2_artifact_url }}"\n        dest: "{{ rke2_artifact_dest }}"\n        checksum: "{{ rke2_artifact_algo }}:{{ rke2_artifact_value }}"\n        mode: \'0644\'\n  rescue:\n    - name: Copy local checksum\n      ansible.builtin.copy:\n        src: "{{ rke2_checksum_local }}"\n        dest: "{{ rke2_checksum_dest }}"\n        mode: \'0644\'\n    - name: Copy local artifact\n      ansible.builtin.copy:\n        src: "{{ rke2_artifact_local }}"\n        dest: "{{ rke2_artifact_dest }}"\n        mode: \'0644\'\n\n- name: Copy local RKE2 artifacts\n  ansible.builtin.copy:\n    src: "{{ rke2_artifact_local }}"\n    dest: "{{ rke2_artifact_dest }}"\n    mode: \'0640\'\n  when: airgap_mode and implementation == \'copy\'\n\n- name: Airgap mode - additional images tarballs\n  when: airgap_mode and additional_tarballs | length > 0\n  block:\n    - name: Create directory for additional images tarballs\n      ansible.builtin.file:\n        path: "{{ additional_images_dir }}"\n        state: directory\n        mode: \'0700\'\n    - name: Copy additional images tarballs\n      ansible.builtin.copy:\n        src: "{{ item }}"\n        dest: "{{ additional_images_dir }}/{{ item | basename }}"\n        mode: \'0644\'\n      loop: "{{ additional_tarballs }}"\n\n- name: Airgap mode - ensure artifacts exist and have acceptable permissions\n  when: airgap_mode and implementation == \'exists\'\n  block:\n    - name: Ensure artifacts are present\n      ansible.builtin.file:\n        path: "{{ item }}"\n        state: file\n      loop: "{{ rke2_artifacts }}"\n    - name: Set artifacts permissions to read-only\n      ansible.builtin.file:\n        path: "{{ item }}"\n        mode: \'0444\'\n      loop: "{{ rke2_artifacts }}"\n    - name: Ensure install script executable\n      ansible.builtin.file:\n        path: "{{ rke2_install_script_dest }}"\n        mode: \'0755\'\n\n- name: Populate service facts\n  ansible.builtin.service_facts:\n\n- name: Get stats of the FS object\n  ansible.builtin.stat:\n    path: /usr/local\n  register: usr_local_stat\n\n- name: Set RKE2 bin path\n  ansible.builtin.set_fact:\n    rke2_bin_path: >-\n      "{{ (usr_local_stat.stat.writable\n          and not usr_local_stat.stat.isdir)\n          | ternary(\'/usr/local/bin\', \'/usr/bin\') }}"\n\n- name: Check RKE2 version\n  ansible.builtin.command: "{{ rke2_bin_path }}/rke2 --version"\n  register: rke2_version_output\n  changed_when: false\n\n- name: Prevent accidental RKE2 downgrade\n  ansible.builtin.assert:\n    that:\n      - >-\n        rke2_version_output.stdout\n          | regex_replace(\'^v\', \'\')\n          | regex_replace(\'^.*$\', \'\')\n          == rke2_desired_version\n    fail_msg: >-\n      Version downgrade not allowed. Current: {{ rke2_version_output.stdout }}\n      Desired: {{ rke2_desired_version }}\n\n- name: Run RKE2 install script\n  ansible.builtin.shell: >-\n    {{ rke2_install_script_dest }} {{ rke2_install_script_args | default(\'\') }}\n  environment:\n    RKE2_AIRGAP: "{{ \'true\' if airgap_mode else \'false\' }}"\n  args:\n    creates: >-\n      {{ rke2_install_script_dest }}.completed\n\n- name: Copy Custom Manifests\n  ansible.builtin.template:\n    src: "{{ item.src }}"\n    dest: "{{ rke2_manifests_dir }}/{{ item.dest }}"\n    mode: \'0644\'\n  loop: "{{ custom_manifests }}"\n\n- name: Copy Static Pods\n  ansible.builtin.copy:\n    src: "{{ item }}"\n    dest: "{{ rke2_agent_pod_manifests_dir }}/{{ item | basename }}"\n    mode: \'0644\'\n  loop: "{{ static_pods }}"\n\n- name: Copy RKE2 environment file\n  ansible.builtin.template:\n    src: "{{ env_options.template }}"\n    dest: "/etc/rancher/rke2/rke2.env"\n    mode: \'0644\'\n  when: env_options is defined' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-20T18:13:00.406954395Z', 'done': True, 'done_reason': 'stop', 'total_duration': 32333916480, 'load_duration': 149618939, 'prompt_eval_count': 7904, 'prompt_eval_duration': 5582212593, 'eval_count': 2272, 'eval_duration': 26599895596, 'model_name': 'gpt-oss:20b'} id='run--87d02b2b-9596-40ad-bc94-efb1ddb25477-0' usage_metadata={'input_tokens': 7904, 'output_tokens': 2272, 'total_tokens': 10176}
