content='---\n- name: Check if Java certificates exist\n  stat:\n    path: "{{ item }}"\n  loop: "{{ java_certs }}"\n  register: cert_stat\n\n- name: Fail if Java certificates are missing\n  fail:\n    msg: "Missing certificate: {{ missing_certs }}"\n  vars:\n    missing_certs: >-\n      {{ cert_stat.results | selectattr(\'stat.exists\', \'equalto\', False) |\n         map(attribute=\'item\') | list | join(\', \') }}\n  when:\n    - >-\n      cert_stat.results | selectattr(\'stat.exists\', \'equalto\', False) |\n      list | length > 0\n\n- name: Set keystore directory for Java versions less than 11\n  set_fact:\n    java_keystore_dir: "{{ legacy_keystore_dir }}"\n  when: java_version is defined and java_version | int < 11\n\n- name: Set keystore directory for Java versions 11 or newer\n  set_fact:\n    java_keystore_dir: "{{ new_keystore_dir }}"\n  when: java_version is defined and java_version | int >= 11\n\n- name: Import SSL certificates into Java keystore\n  command: keytool\n  args:\n    argv:\n      - -importcert\n      - -file\n      - "{{ item.cert_path }}"\n      - -alias\n      - "{{ item.alias }}"\n      - -keystore\n      - "{{ java_keystore_dir }}/cacerts"\n      - -storepass\n      - "{{ java_keystore_password | default(\'changeit\') }}"\n      - -noprompt\n    creates: "{{ java_keystore_dir }}/cacerts"\n  loop: "{{ java_certs }}"' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-20T15:14:06.3171684Z', 'done': True, 'done_reason': 'stop', 'total_duration': 38043836995, 'load_duration': 164257058, 'prompt_eval_count': 941, 'prompt_eval_duration': 150515873, 'eval_count': 3449, 'eval_duration': 37727517269, 'model_name': 'gpt-oss:20b'} id='run--2dcb5c3c-9c89-4ace-9471-2d8d3ad4e1a5-0' usage_metadata={'input_tokens': 941, 'output_tokens': 3449, 'total_tokens': 4390}
