---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
  become: false
  when: ansible_connection != 'local'

- name: Prepare system
  block:
    - name: Test sudo access
      ansible.builtin.command: sudo -n true
      changed_when: false
  rescue:
    - name: Gather facts
      ansible.builtin.setup:
    - name: Install necessary packages using raw commands
      ansible.builtin.raw: "yum install -y {{ bootstrap_facts_packages | join(' ') }}"
      changed_when: false
    - name: Ensure libdnf5 is installed on RedHat
      ansible.builtin.package:
        name: libdnf5
        state: present
      when: ansible_os_family == 'RedHat'

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"



