---
- name: Import assertion file
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install cron packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ cron_packages }}"

- name: Configure cron shell
  lineinfile:
    path: /etc/crontab
    regexp: "^SHELL="
    line: "SHELL={{ cron_shell }}"
    create: true
  notify: restart cron

- name: Configure cron path
  lineinfile:
    path: /etc/crontab
    regexp: "^PATH="
    line: "PATH={{ cron_path }}"
    create: true
  notify: restart cron

- name: Configure cron mailto
  lineinfile:
    path: /etc/crontab
    regexp: "^MAILTO="
    line: "MAILTO={{ cron_mailto }}"
    create: true
  notify: restart cron

- name: Start and enable cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ''

- name: Schedule cron jobs
  cron:
    name: "{{ item.name | default(item.command) }}"
    minute: "{{ item.minute | default('*') }}"
    hour: "{{ item.hour | default('*') }}"
    day: "{{ item.day | default('*') }}"
    month: "{{ item.month | default('*') }}"
    weekday: "{{ item.weekday | default('*') }}"
    job: "{{ item.command }}"
    state: "{{ item.state | default('present') }}"
    user: "{{ item.user | default('root') }}"
  loop: "{{ cron_jobs }}"



