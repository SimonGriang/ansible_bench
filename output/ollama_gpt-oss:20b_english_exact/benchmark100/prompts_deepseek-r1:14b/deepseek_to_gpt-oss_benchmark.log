---
- name: Install unzip package
  package:
    name: unzip
    state: present

- name: Create system group for promtail
  group:
    name: "{{ promtail_group }}"
    system: yes
    state: present

- name: Create system user for promtail
  user:
    name: "{{ promtail_user }}"
    group: "{{ promtail_group }}"
    groups: "{{ promtail_additional_groups | default([]) }}"
    system: yes
    shell: /sbin/nologin
    state: present

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create config directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode | default('0755') }}"
    owner: "{{ item.owner | default(promtail_user) }}"
    group: "{{ item.group | default(promtail_group) }}"
  loop: "{{ promtail_config_dirs }}"

- name: Create application directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode | default('0755') }}"
    owner: "{{ item.owner | default(promtail_user) }}"
    group: "{{ item.group | default(promtail_group) }}"
  loop: "{{ promtail_app_dirs }}"

- name: Check promtail binary existence
  stat:
    path: "{{ promtail_binary_path }}"
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "{{ promtail_download_dest }}"
    checksum: "{{ promtail_checksum }}"
    mode: '0755'

- name: Propagate local promtail binaries
  copy:
    src: "{{ item }}"
    dest: "{{ promtail_temp_dir }}/"
    mode: '0755'
  loop: "{{ local_promtail_binaries }}"

- name: Download promtail binaries for controller node
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "{{ promtail_controller_download_dest }}"
    checksum: "{{ promtail_checksum }}"
    mode: '0755'
  delegate_to: "{{ groups['controller'][0] }}"

- name: Propagate promtail binaries
  copy:
    src: "{{ promtail_controller_download_dest }}"
    dest: "{{ promtail_temp_dir }}/"
    mode: '0755'
  delegate_to: "{{ groups['controller'][0] }}"

- name: Unpack promtail binaries
  unarchive:
    src: "{{ promtail_temp_dir }}/promtail.zip"
    dest: "{{ promtail_extract_dir }}"
    remote_src: yes

- name: Create symlink to latest promtail version
  file:
    src: "{{ promtail_extract_dir }}/{{ promtail_latest_version }}"
    dest: "{{ promtail_symlink }}"
    state: link
  notify: restart_promtail

- name: Write promtail config file
  template:
    src: promtail.yml.j2
    dest: "{{ promtail_config_path }}"
    mode: '0644'
    owner: "{{ promtail_user }}"
    group: "{{ promtail_group }}"

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
  notify: restart_promtail


