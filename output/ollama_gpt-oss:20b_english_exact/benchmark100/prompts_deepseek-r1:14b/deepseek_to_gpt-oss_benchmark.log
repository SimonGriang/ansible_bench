---
- name: Install unzip package
  package:
    name: unzip
    state: present

- name: Create system group for promtail
  group:
    name: promtail
    system: yes
    state: present

- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    groups: adm
    append: yes
    system: yes
    shell: /usr/sbin/nologin
    create_home: no

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create config directories
  file:
    path: "{{ promtail_config_dir }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Create application directories
  file:
    path: "{{ promtail_app_dir }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Check promtail binary existence
  stat:
    path: "{{ promtail_binary_path }}"
  register: promtail_binary_stat

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "{{ promtail_download_dest }}"
    checksum: "sha256:{{ promtail_checksum }}"
  register: promtail_download

- name: Propagate local promtail binaries
  copy:
    src: "{{ promtail_local_binary_src }}"
    dest: "{{ promtail_temp_dir }}"
    mode: '0755'
  register: promtail_copy_local

- name: Download promtail binaries for controller node
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "{{ promtail_controller_download_dest }}"
    checksum: "sha256:{{ promtail_checksum }}"
  delegate_to: localhost
  register: promtail_controller_download

- name: Propagate promtail binaries
  copy:
    src: "{{ promtail_controller_download_dest }}"
    dest: "{{ promtail_temp_dir }}"
  register: promtail_copy_controller

- name: Unpack promtail binaries
  unarchive:
    src: "{{ promtail_temp_dir }}/promtail.zip"
    dest: "{{ promtail_app_dir }}"
    remote_src: yes
  register: promtail_unarchive

- name: Create symlink to latest promtail version
  file:
    src: "{{ promtail_app_dir }}/promtail-{{ promtail_version }}"
    dest: /usr/local/bin/promtail
    state: link
  notify: Restart Promtail

- name: Write promtail config file
  template:
    src: templates/promtail.yml.j2
    dest: "{{ promtail_config_dir }}/promtail.yml"
    owner: promtail
    group: promtail
    mode: '0644'
  notify: Restart Promtail

- name: Create systemd service unit
  template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: Restart Promtail


