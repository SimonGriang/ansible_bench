---
- name: Generate a private SSL key using OpenSSL
  community.crypto.openssl_privatekey:
    path: "{{ key_path }}"
    size: 2048
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"
    mode: "{{ key_mode }}"

- name: Generate a Certificate Signing Request (CSR)
  community.crypto.openssl_csr:
    path: "{{ csr_path }}"
    privatekey_path: "{{ key_path }}"
    common_name: "{{ common_name }}"
    mode: "{{ csr_mode }}"

- name: Generate a self-signed SSL certificate
  community.crypto.x509_certificate:
    path: "{{ cert_path }}"
    privatekey_path: "{{ key_path }}"
    csr_path: "{{ csr_path }}"
    provider: selfsigned
    days: 365
    mode: "{{ cert_mode }}"

- name: Create a PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: "{{ pkcs12_path }}"
    privatekey_path: "{{ key_path }}"
    certificate_path: "{{ cert_path }}"
    passphrase: "{{ pkcs12_password }}"
    mode: "{{ pkcs12_mode }}"

- name: Read the private key content
  ansible.builtin.set_fact:
    private_key_content: "{{ lookup('file', key_path) }}"

- name: Read the certificate content
  ansible.builtin.set_fact:
    certificate_content: "{{ lookup('file', cert_path) }}"

- name: Combine private key and certificate into a single file
  ansible.builtin.copy:
    dest: "{{ combined_path }}"
    content: |
      {{ private_key_content }}
      {{ certificate_content }}
    owner: "{{ combined_owner }}"
    group: "{{ combined_group }}"
    mode: "{{ combined_mode }}"


