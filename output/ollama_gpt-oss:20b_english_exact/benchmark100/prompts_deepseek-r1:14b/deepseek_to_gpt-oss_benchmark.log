---
- name: Create the RKE2 configuration directory
  file:
    path: "{{ rke2_config_dir | default('/etc/rke2') }}"
    state: directory
    mode: '0755'

- name: Set server taints
  template:
    src: templates/server_taints.yaml.j2
    dest: "{{ rke2_config_dir }}/server_taints.yaml"
    mode: '0644'
  when: node_type == 'server'

- name: Set agent taints
  template:
    src: templates/agent_taints.yaml.j2
    dest: "{{ rke2_config_dir }}/agent_taints.yaml"
    mode: '0644'
  when: node_type == 'agent'

- name: Copy RKE2 configuration file
  template:
    src: templates/rke2_config.yaml.j2
    dest: "{{ rke2_config_dir }}/config.yaml"
    mode: '0644'
  notify: Restart rke2 service

- name: Copy Kubelet configuration file
  template:
    src: templates/kubelet_config.yaml.j2
    dest: "/etc/kubernetes/kubelet.conf"
    mode: '0644'
  when: kubelet_config is defined
  notify: Restart kubelet

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ custom_registry_path }}"
    dest: "/etc/containerd/registry.conf"
    mode: '0644'
  when: custom_registry_path is defined
  notify: Restart containerd

- name: Start RKE2 service on other nodes
  systemd:
    name: rke2
    state: started
    enabled: true
  notify: Restart rke2 service

- name: Mask other RKE2 services on nodes
  systemd:
    name: "{{ item }}"
    masked: true
  loop: "{{ (node_type == 'server') | ternary(['rke2-agent'], ['rke2-server']) }}"
  when: node_type in ['server', 'agent']

- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    kubectl get nodes -o json | jq '.items[] | select(.status.conditions[].type=="Ready") | .metadata.name' | grep -q '^'
  register: node_ready
  retries: 30
  delay: 10
  until: node_ready.rc == 0
  when: cni_configured is not defined or not cni_configured

- name: Wait for remaining nodes to be ready - with CNI
  shell: |
    kubectl get nodes -o json | jq '.items[] | select(.status.conditions[].type=="Ready") | .metadata.name' | grep -q '^'
  register: node_ready
  retries: 30
  delay: 10
  until: node_ready.rc == 0
  when: cni_configured is defined and cni_configured


