---
- name: Create local SSH key directory for user
  file:
    path: "/home/{{ user }}/.ssh_keys"
    state: directory
    owner: "{{ user }}"
    mode: "0750"

- name: Manage user account
  user:
    name: "{{ user }}"
    state: present
    comment: "{{ user_comment | default('') }}"
    home: "/home/{{ user }}"
    shell: "/bin/bash"
    groups: "{{ user_groups | default(omit) }}"
    append: true

- name: Set sudo options for user
  copy:
    dest: "/etc/sudoers.d/{{ user }}"
    content: "{{ sudoers_content | default('') }}"
    mode: "0440"

- name: Generate private SSH key for user
  command: ssh-keygen -t rsa -b 4096 -f {{ key_path }} -N '' -C "{{ user }}"
  args:
    creates: "{{ key_path }}"

- name: Generate public SSH key for user
  command: ssh-keygen -y -f {{ key_path }} > {{ key_path }}.pub
  args:
    creates: "{{ key_path }}.pub"

- name: Convert SSH key to ppk format for user
  command: puttygen {{ key_path }} -O private -o {{ key_path }}.ppk
  args:
    creates: "{{ key_path }}.ppk"

- name: Get or set the home directory for user
  user_info:
    user: "{{ user }}"
  register: user_info_result

- name: Create .ssh directory for user
  file:
    path: "{{ user_info_result.home | default('/home/' + user) }}/.ssh"
    state: directory
    owner: "{{ user }}"
    mode: "0700"

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user }}"
    state: present
    key: "{{ lookup('file', authorized_keys_source) }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ unauthorized_keys }}"

- name: Copy generated private SSH key for user
  copy:
    src: "{{ key_path }}"
    dest: "{{ user_info_result.home | default('/home/' + user) }}/.ssh/id_rsa"
    owner: "{{ user }}"
    mode: "0600"

- name: Check users password valid time for user
  shell: chage -l {{ user }}
  register: password_validity

- name: Set users password valid time for user
  command: chage -M {{ max_days }} -m {{ min_days }} -W {{ warn_days }} {{ user }}

- name: Place private key file for user
  copy:
    src: "{{ private_key_file }}"
    dest: "{{ user_info_result.home | default('/home/' + user) }}/.ssh/{{ private_key_file | basename }}"
    owner: "{{ user }}"
    mode: "0600"


