---
- name: install_java
  shell: |
    mkdir -p {{ java_install_path }} &&
    wget -qO {{ java_checksum_file }} {{ java_download_url }} &&
    tar -xf {{ java_checksum_file }} -C {{ java_install_path }} &&
    mv {{ java_install_path }}/{{ java_version }} \
       {{ java_install_path }}/{{ java_version_major }}
  args:
    executable: /bin/bash

- name: install_java_checksum
  shell: |
    echo {{ java_checksum }} | sha512sum -c - && \
    echo {{ java_checksum }} | sha256sum -c - && \
    echo {{ java_checksum }} | md5sum -c -
  args:
    executable: /bin/bash

- name: java_home
  include_vars:
    file: >-
      "{{ 'vars/' ~ java_jdk_vendor ~ '/' ~
      ansible_distribution | lower ~ '-' ~
      (ansible_distribution_version | replace('.', '')) ~ '.yml' }}"

