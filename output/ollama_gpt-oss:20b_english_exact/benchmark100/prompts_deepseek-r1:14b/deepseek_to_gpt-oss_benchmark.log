---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ port | int }}"
    timeout: "{{ bootstrap_timeout | int }}"
  when: >-
    ansible_connection not in ['container', 'docker',
                               'community.docker.docker']

- name: Prepare system
  block:
    - name: Test connection with a timeout
      ansible.builtin.command: ping -c 1 localhost
      async: "{{ bootstrap_timeout | int }}"
      poll: 0
      changed_when: false
    - name: Test sudo version
      ansible.builtin.command: sudo -V
      changed_when: false
  rescue:
    - name: Gather ansible facts
      ansible.builtin.setup:
    - name: Install bootstrap packages (package)
      ansible.builtin.package:
        name: "{{ bootstrap_facts_packages | default([]) }}"
        state: present
      become: "{{ bootstrap_become | bool }}"

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: all
  become: false

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages | default([]) }}"
    state: present
  become: "{{ bootstrap_become | bool }}"


