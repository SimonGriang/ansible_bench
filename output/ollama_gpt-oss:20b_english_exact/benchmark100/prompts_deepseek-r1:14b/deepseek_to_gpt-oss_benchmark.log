---
- name: >
    Task 1: Create /etc/openvpn/easy-rsa directory with correct permissions
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: "Task 2: Initialize OpenVPN PKI structure"
  command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa

- name: "Task 3: Generate OpenVPN CA certificate"
  command: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"

- name: "Task 4: Generate Diffie-Hellman parameters"
  command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa

- name: "Task 5: Generate server certificate"
  command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"

- name: "Task 6: Generate client certificate"
  command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"

- name: "Task 7: Generate Certificate Revocation List"
  command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa

- name: "Task 8: Generate OpenVPN TA key"
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: "Task 9: Copy PKI files to /etc/openvpn/server directory"
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn/server/{{ item | basename }}
    mode: '0640'
  loop:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/issued/server.crt
    - /etc/openvpn/easy-rsa/pki/private/server.key
    - /etc/openvpn/easy-rsa/pki/dh.pem
    - /etc/openvpn/easy-rsa/pki/ta.key

- name: "Task 10: Copy additional PKI files to /etc/openvpn directory"
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn/{{ item | basename }}
    mode: '0640'
  loop:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/ta.key

- name: "Task 11: Place OpenVPN server configuration file"
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    owner: root
    group: root
    mode: '0644'
  notify: restart-openvpn


