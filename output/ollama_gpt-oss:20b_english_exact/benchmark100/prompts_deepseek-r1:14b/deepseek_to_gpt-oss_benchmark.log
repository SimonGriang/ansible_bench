    file: "{{ java_jdk_vendor ~ '/' ~ ansible_distribution | lower ~ ansible_distribution_version | replace('.','') ~ '.yml' }}"

- name: Gather architecture specific variables
  ansible.builtin.include_vars:
    file: "{{ java_jdk_vendor ~ '/' ~ ansible_architecture ~ '.yml' }}"

- name: Set OS specific variables (I)
  ansible.builtin.set_fact:
    java_version: "{{ java_version | default('11') }}"
    java_repositories: "{{ java_repositories | default([]) }}"
    java_libs: "{{ java_libs | default([]) }}"

- name: Set OS and architecture specific variables (II)
  ansible.builtin.set_fact:
    java_install_path: "{{ java_install_path | default('/usr/lib/jvm') }}"
    java_package_name: "{{ java_package_name | default('openjdk-' ~ java_version ~ '-jdk') }}"

- name: Set specific variables
  ansible.builtin.set_fact:
    java_home: "{{ java_install_path }}/java-{{ java_version }}"

- name: Debian pre-requisites
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop:
    - gnupg
    - ca-certificates
    - apt-transport-https
  when: ansible_os_family == 'Debian'

- name: Add Temurin repository (Debian)
  ansible.builtin.apt_repository:
    repo: "deb https://packages.adoptium.net/artifactory/deb {{ ansible_distribution_release }} main"
    state: present
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  ansible.builtin.yum_repository:
    name: adoptium
    description: Adoptium Repository
    baseurl: https://packages.adoptium.net/artifactory/rpm/
    enabled: 1
    gpgcheck: 1
    gpgkey: https://packages.adoptium.net/artifactory/api/gpg/key/public
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_libs }}"
  when: java_libs is defined and java_libs | length > 0

- name: Install Java, Debian
  ansible.builtin.apt:
    name: "{{ java_package_name }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  ansible.builtin.yum:
    name: "{{ java_package_name }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  ansible.builtin.copy:
    dest: /etc/profile.d/java_home.sh
    content: |
      JAVA_HOME={{ java_home }}
      export JAVA_HOME
      export PATH=$JAVA_HOME/bin:$PATH
    mode: '0644'

- name: Source environment variables
  ansible.builtin.shell: source /etc/profile.d/java_home.sh
  changed_when: false

- name: Correct java version selected for Java < 11
  ansible.builtin.shell: |
    update-alternatives --install /usr/bin/java java {{ java_home }}/jre/bin/java 1
  when: java_version | int < 11
  changed_when: false

- name: Correct java version selected for Java >= 11
  ansible.builtin.shell: |
    update-alternatives --install /usr/bin/java java {{ java_home }}/bin/java 1
  when: java_version | int >= 11
  changed_when: false


