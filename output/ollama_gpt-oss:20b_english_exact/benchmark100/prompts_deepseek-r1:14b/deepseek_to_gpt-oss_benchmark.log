---
- name: Check if Java certificates exist
  stat:
    path: "{{ item.path }}"
  loop: "{{ java_certs }}"
  register: java_certs_stat

- name: Fail if Java certificates are missing
  fail:
    msg: "Missing Java certificate: {{ item.item.path }}"
  loop: "{{ java_certs_stat.results }}"
  when: not item.stat.exists

- name: Set keystore directory for Java versions less than 11
  set_fact:
    java_keystore_dir: "{{ legacy_keystore_dir }}"
  when: java_version < 11

- name: Set keystore directory for Java versions 11 or newer
  set_fact:
    java_keystore_dir: "{{ new_keystore_dir }}"
  when: java_version >= 11

- name: Import SSL certificates into Java keystore
  java_cert:
    path: "{{ item.path }}"
    alias: "{{ item.alias }}"
    keystore_path: "{{ java_keystore_dir }}"
    keystore_password: "{{ keystore_password }}"
    state: present
  loop: "{{ java_certs }}"
  register: java_certs_import
  ignore_errors: no


