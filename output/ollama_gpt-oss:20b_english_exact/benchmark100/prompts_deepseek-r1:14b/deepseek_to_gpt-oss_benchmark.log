---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: "0700"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_data_dir }}"
    - "{{ dns_config_dir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true
    group: "{{ dns_group }}"

- name: Generate rndc key
  command: rndc-confgen -a -c "{{ dns_config_dir }}/rndc.key"
  args:
    creates: "{{ dns_config_dir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_config_dir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0600"

- name: Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.root
    dest: "{{ dns_data_dir }}/named.root"
    mode: "0644"
  when: dns_caching_dns

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_data_dir }}/{{ item.name }}.zone"
    mode: "0644"
    validate: "named-checkzone {{ item.name }} {{ dns_data_dir }}/{{ item.name }}.zone"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_config_dir }}/named.conf"
    mode: "0644"
  notify: Restart dns

- name: Place systemd override
  template:
    src: dns.service.d/override.conf.j2
    dest: "/etc/systemd/system/dns.service.d/override.conf"
    mode: "0644"
  when: using_systemd
  notify: systemd daemon-reload

- name: Start and enable dns
  service:
    name: dns
    state: started
    enabled: true


