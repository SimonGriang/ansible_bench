---
- name: Create temporary directory for download
  ansible.builtin.file:
    path: "{{ tmp_dir }}"
    state: directory
    mode: '0755'
  register: tmp_dir_out

- name: Set the temporary directory
  ansible.builtin.set_fact:
    tmp_dir: "{{ tmp_dir_out.path }}"

- name: Download the latest package
  ansible.builtin.get_url:
    url: "{{ download_url }}"
    dest: "{{ tmp_dir }}/{{ download_filename }}"
    mode: '0644'
  register: download_out

- name: Create install directory
  ansible.builtin.file:
    path: "{{ install_dir }}"
    state: directory
    mode: '0755'

- name: Install the downloaded package
  ansible.builtin.dnf:
    name: "{{ tmp_dir }}/{{ download_filename }}"
    state: present

- name: Gather OS specific variables
  ansible.builtin.include_vars:
    file: "{{ file_path }}"
  vars:
    vendor_part: "{{ java_jdk_vendor }}/{{ ansible_distribution | lower }}"
    version_part: "{{ ansible_distribution_version | replace('.','') }}.yml"
    file_path: "{{ vendor_part }}{{ version_part }}"

- name: Gather Architecture specific variables
  ansible.builtin.include_vars:
    file: "{{ file_path2 }}"
  vars:
    vendor_part2: "{{ java_jdk_vendor }}/{{ ansible_architecture }}"
    file_path2: "{{ vendor_part2 }}.yml"

- name: Set the installation directory
  ansible.builtin.set_fact:
    install_dir: "{{ install_dir }}/{{ java_version }}/{{ java_home }}"

- name: Add Temurin repository (Debian)
  ansible.builtin.apt_repository:
    repo: "{{ repo_line }}"
    state: present
  vars:
    repo_line: >-
      deb https://packages.adoptium.net/artifactory/deb
      {{ ansible_distribution_release }} main

- name: Correct java version selected for Java < 11
  ansible.builtin.shell: |-
    update-alternatives --install /usr/bin/java java \
    {{ java_home }}/jre/bin/java 1
  when: java_version | int < 11
  changed_when: false

- name: Correct java version selected for Java >= 11
  ansible.builtin.shell: |-
    update-alternatives --install /usr/bin/java java \
    {{ java_home }}/bin/java 1
  when: java_version | int >= 11
  changed_when: false


