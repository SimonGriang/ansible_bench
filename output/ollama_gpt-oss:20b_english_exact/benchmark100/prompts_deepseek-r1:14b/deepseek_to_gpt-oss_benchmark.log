---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0700'
  when: not airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ local_rke2_install_script_path }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0700'
  when: airgap_mode and implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0700'
  when: airgap_mode and implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_path }}"
        mode: '0644'
        checksum: "sha256:{{ rke2_checksum_expected }}"
    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifact_url }}"
        dest: "{{ rke2_artifact_path }}"
        mode: '0644'
        checksum: "sha256:{{ rke2_artifact_checksum }}"
  rescue:
    - name: Copy local RKE2 checksum
      copy:
        src: "{{ local_rke2_checksum_path }}"
        dest: "{{ rke2_checksum_path }}"
        mode: '0644'
    - name: Copy local RKE2 artifacts
      copy:
        src: "{{ local_rke2_artifact_path }}"
        dest: "{{ rke2_artifact_path }}"
        mode: '0644'
  when: airgap_mode

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ local_rke2_artifact_path }}"
    dest: "{{ rke2_artifact_path }}"
    mode: '0640'
  when: airgap_mode and implementation == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images directory
      file:
        path: "{{ additional_images_path }}"
        state: directory
        mode: '0700'
    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ additional_images_path }}/{{ item | basename }}"
        mode: '0644'
      loop: "{{ additional_tarballs }}"
  when: airgap_mode and additional_tarballs is defined

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure artifacts are read-only
      file:
        path: "{{ rke2_artifact_path }}"
        mode: '0444'
    - name: Ensure install script is executable
      file:
        path: "{{ rke2_install_script_path }}"
        mode: '0755'
  when: airgap_mode and implementation == 'exists'

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: "/usr/local"
  register: usr_local_stat

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ usr_local_stat.stat.writable | ternary('/usr/local/bin/rke2', '/usr/bin/rke2') }}"
  when: usr_local_stat.stat.writable and not usr_local_stat.stat.is_mountpoint

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }} version --short"
  register: rke2_version_check
  changed_when: false

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "allow_downgrade or (rke2_version_check.stdout | regex_replace('^v', '') | version_compare(rke2_desired_version, '>='))"
    fail_msg: "Downgrading RKE2 is not allowed unless explicitly permitted."

- name: Run RKE2 install script
  shell: "{{ rke2_install_script_path }} {{ rke2_install_args }}"
  environment:
    RKE2_AIRGAP: "{{ airgap_mode | string }}"
  args:
    chdir: "/"
  when: rke2_install_script_path is defined

- name: Copy Custom Manifests
  template:
    src: "custom_manifest.j2"
    dest: "{{ rke2_manifests_dir }}/custom_manifest.yaml"
    mode: '0644'

- name: Copy Static Pods
  copy:
    src: "static_pods/"
    dest: "{{ rke2_agent_pod_manifests_dir }}/"
    mode: '0644'
    recurse: yes

- name: Copy RKE2 environment file
  template:
    src: "rke2_env.j2"
    dest: "{{ rke2_env_dir }}/rke2.env"
    mode: '0644'
  when: rke2_environment_options is defined


