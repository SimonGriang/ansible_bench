    # RedHat/CentOS 13
    yum:
      packages:
        - git
        - curl
        - htop

    # RedHat/CentOS 14
    yum:
      packages:
        - git
        - curl
        - htop

    # RedHat/CentOS 15
    yum:
      packages:
        - git
        - curl
        - htop

  tasks:
    # Debian/Ubuntu
    - name: Configure apt
      ansible.builtin.apt:
        name: "{{ item }}"
        state: latest
