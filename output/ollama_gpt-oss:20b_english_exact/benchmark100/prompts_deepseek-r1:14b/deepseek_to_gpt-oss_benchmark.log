---
- name: Install EPEL repository on compatible systems
  block:
    - name: Install EPEL GPG key
      rpm_key:
        key: "{{ epel_gpg_key }}"
        state: present
      notify: Update package cache
    - name: Install EPEL release package
      yum:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache
    - name: Install EPEL next release package (conditional)
      yum:
        name: "{{ epel_next_url }}"
        state: present
      when: epel_next
      notify: Update package cache
  when: (ansible_distribution == "Amazon" and ansible_distribution_major_version == "2") or (ansible_distribution == "RedHat" and ansible_distribution_major_version in ["7","8","9"])


