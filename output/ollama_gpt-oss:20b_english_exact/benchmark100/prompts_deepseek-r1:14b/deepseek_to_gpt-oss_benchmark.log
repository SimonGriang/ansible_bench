        url: "{{ rke2_artifact_url }}"
        dest: "{{ rke2_artifact_dest }}"
        checksum: "{{ rke2_artifact_algo }}:{{ rke2_artifact_value }}"
  rescue:
    - name: Copy local checksum
      copy:
        src: "{{ rke2_checksum_local }}"
        dest: "{{ rke2_checksum_dest }}"
        mode: '0644'
    - name: Copy local artifact
      copy:
        src: "{{ rke2_artifact_local }}"
        dest: "{{ rke2_artifact_dest }}"
        mode: '0644'
  when: not airgap_mode

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifact_local }}"
    dest: "{{ rke2_artifact_dest }}"
    mode: '0640'
  when: airgap_mode and implementation == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Create directory for additional images tarballs
      file:
        path: "{{ additional_images_dir }}"
        state: directory
        mode: '0700'
    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ additional_images_dir }}/{{ item | basename }}"
        mode: '0644'
      loop: "{{ additional_tarballs }}"
  when: airgap_mode and additional_tarballs | length > 0

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure artifacts are present
      file:
        path: "{{ item }}"
        state: file
      loop: "{{ rke2_artifacts }}"
    - name: Set artifacts permissions to read-only
      file:
        path: "{{ item }}"
        mode: '0444'
      loop: "{{ rke2_artifacts }}"
    - name: Ensure install script executable
      file:
        path: "{{ rke2_install_script_dest }}"
        mode: '0755'
  when: airgap_mode and implementation == 'exists'

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ (usr_local_stat.stat.writable and not usr_local_stat.stat.isdir) | ternary('/usr/local/bin', '/usr/bin') }}"

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }}/rke2 --version"
  register: rke2_version_output

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - >-
        rke2_version_output.stdout | regex_replace('^v', '') | regex_replace('^.*$', '') == rke2_desired_version
    fail_msg: >-
      Version downgrade not allowed. Current: {{ rke2_version_output.stdout }}, Desired: {{ rke2_desired_version }}

- name: Run RKE2 install script
  shell: >-
    {{ rke2_install_script_dest }} {{ rke2_install_script_args | default('') }}
  environment:
    RKE2_AIRGAP: "{{ 'true' if airgap_mode else 'false' }}"
  args:
    creates: >-
      {{ rke2_install_script_dest }}.completed

- name: Copy Custom Manifests
  template:
    src: "{{ item.src }}"
    dest: "{{ rke2_manifests_dir }}/{{ item.dest }}"
    mode: '0644'
  loop: "{{ custom_manifests }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_dir }}/{{ item | basename }}"
    mode: '0644'
  loop: "{{ static_pods }}"

- name: Copy RKE2 environment file
  template:
    src: "{{ env_options.template }}"
    dest: "/etc/rancher/rke2/rke2.env"
    mode: '0644'
  when: env_options is defined


