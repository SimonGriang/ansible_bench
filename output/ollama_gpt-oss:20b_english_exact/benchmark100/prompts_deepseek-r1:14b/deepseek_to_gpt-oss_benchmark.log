---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install using package
  block:
    - name: Install on Debian
      package:
        name: hashicorp
        state: present
      when: ansible_os_family == 'Debian'
    - name: Install on RedHat
      package:
        name: hashicorp
        state: present
      when: ansible_os_family == 'RedHat'

- name: Configure debian
  block:
    - name: Add HashiCorp GPG key
      apt_key:
        url: https://apt.releases.hashicorp.com/gpg
        state: present
      when: ansible_os_family == 'Debian'
    - name: Add HashiCorp repository
      apt_repository:
        repo: "deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
        state: present
      when: ansible_os_family == 'Debian'

- name: Install hashicorp product using package
  block:
    - name: Install latest hashicorp product
      package:
        name: hashicorp
        state: latest
      when: not hashicorp_version is defined
    - name: Install specific hashicorp product
      package:
        name: hashicorp
        state: present
        version: "{{ hashicorp_version }}"
      when: hashicorp_version is defined

- name: Install manually
  unarchive:
    src: https://releases.hashicorp.com/{{ product_name }}/{{ product_version }}/{{ product_name }}_{{ product_version }}_linux_amd64.zip
    dest: /usr/local/bin
    remote_src: yes
    mode: '0755'


