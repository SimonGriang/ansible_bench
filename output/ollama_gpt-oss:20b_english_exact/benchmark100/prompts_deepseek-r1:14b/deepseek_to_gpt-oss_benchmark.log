---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  debconf:
    name: "postfix postfix/main_mailer_type"
    value: "Internet Site"
    vtype: "select"

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
  notify:
    - validate_postfix_database
    - rebuild_postfix_database

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - validate_postfix_reload

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_recipient_access: "{{ recipient_access_map }}"
    postfix_sender_access: "{{ sender_access_map }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_mynetworks: "{{ mynetworks }}"
    postfix_mydestination: "{{ mydestination }}"
    postfix_relay_domains: "{{ relay_domains }}"
    postfix_other_settings: "{{ other_settings }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - validate_postfix_restart

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - validate_postfix_restart

- name: Creates cert/key directory
