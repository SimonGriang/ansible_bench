---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install using package
  block:
    - name: Install package on RedHat
      ansible.builtin.dnf:
        name: "{{ hashicorp_package }}"
        state: present
      when: ansible_os_family == 'RedHat'
    - name: Install package on Debian
      ansible.builtin.apt:
        name: "{{ hashicorp_package }}"
        state: present
      when: ansible_os_family == 'Debian'

- name: Configure debian
  block:
    - name: Add GPG key
      ansible.builtin.apt_key:
        url: "{{ hashicorp_gpg_url }}"
        state: present
    - name: Add repository
      ansible.builtin.apt_repository:
        repo: "{{ hashicorp_repo }}"
        state: present

- name: Install hashicorp product using package
  ansible.builtin.package:
    name: "{{ hashicorp_product }}"
    state: "{{ hashicorp_state | default('latest') }}"

- name: Install manually
  ansible.builtin.unarchive:
    src: "{{ hashicorp_manual_url }}"
    dest: "{{ hashicorp_install_dir }}"
    mode: '0755'
    remote_src: true


