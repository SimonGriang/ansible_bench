---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install git
  package:
    name: "{{ packages }}"
    state: "{{ state }}"

- name: Check if user exists
  getent:
    database: passwd
    key: "{{ username }}"
  register: user_check
  ignore_errors: true

- name: Create git config directory
  file:
    path: "{{ ansible_env.HOME }}/.gitconfig"
    state: directory
    mode: '0700'
    owner: "{{ username }}"
    group: "{{ username }}"

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "{{ ansible_env.HOME }}/.gitconfig"
    mode: '0644'
    owner: "{{ username }}"
    group: "{{ username }}"

- name: Create repository destination
  file:
    path: "{{ repos_dest }}"
    state: directory
    mode: '0755'
    owner: "{{ username }}"
    group: "{{ username }}"

- name: Clone all repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repos_dest }}/{{ item.dest }}"
    version: "{{ item.version }}"
  become: true
  become_user: "{{ username }}"
  loop: "{{ repositories }}"


