  run_once: true
  delegate_to: localhost

- name: Install php
  ansible.builtin.package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  ansible.builtin.shell: |
    php -i|grep 'Loaded Configuration File'|awk '{print $4}'
  pipefail: true
  register: php_found_ini_location
  changed_when: false
  when: php_ini_location is not defined

- name: Configure php
  ansible.builtin.template:
    src: php.ini.j2
    dest: "{{ php_found_ini_location.stdout }}"
    mode: '0644'
  notify: Restart httpd


