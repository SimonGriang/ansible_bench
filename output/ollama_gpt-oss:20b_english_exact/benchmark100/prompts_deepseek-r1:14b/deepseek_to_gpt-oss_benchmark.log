    - name: Configure yum - CentOS/RHEL 7
      ansible.builtin.yum:
        name: "{{ item }}"
        state: latest
      loop: "{{ yum.packages }}"
      # noqa: fqcn

    # RedHat/CentOS 8
    - name: Configure yum - CentOS/RHEL 8
      ansible.builtin.dnf:
        name: "{{ item }}"
