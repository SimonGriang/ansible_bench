---
- name: Import assertion tasks from assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install HashiCorp product using package
  package:
    name: "{{ hashicorp_product }}"
    state: present
  when: ansible_os_family in ['RedHat', 'Debian']

- name: Configure debian
  block:
    - name: Add HashiCorp GPG key
      apt_key:
        url: https://apt.releases.hashicorp.com/gpg
        state: present
    - name: Add HashiCorp apt repository
      apt_repository:
        repo: 'deb [arch=amd64] https://apt.releases.hashicorp.com $(lsb_release -cs) main'
        state: present
  when: ansible_os_family == 'Debian'

- name: Install hashicorp product using package
  block:
    - name: Install specific version of HashiCorp product
      package:
        name: "{{ hashicorp_product }}"
        state: present
        version: "{{ hashicorp_version }}"
      when: hashicorp_version is defined
    - name: Install latest HashiCorp product
      package:
        name: "{{ hashicorp_product }}"
        state: latest
      when: hashicorp_version is not defined

- name: Install manually
  unarchive:
    src: "{{ hashicorp_download_url }}"
    dest: "{{ hashicorp_install_dest }}"
    remote_src: yes
    mode: '0755'


