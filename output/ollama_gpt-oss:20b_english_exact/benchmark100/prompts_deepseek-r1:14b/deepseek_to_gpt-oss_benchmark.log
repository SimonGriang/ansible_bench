---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'Internet Site'
    vtype: string

- name: Install postfix
  ansible.builtin.apt:
    name: postfix
    state: present
    update_cache: true

- name: Install postfix-mysql
  ansible.builtin.apt:
    name: postfix-mysql
    state: present
    update_cache: true

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: '0644'
  notify:
    - validate_postfix
    - rebuild_transport_maps

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
    - validate_postfix
    - reload_postfix

- name: Setting values for main.cf (1/2)
  ansible.builtin.set_fact:
    postfix_recipient_access: {}
    postfix_sender_access: {}

- name: Setting values for main.cf (2/2)
  ansible.builtin.set_fact:
    postfix_mynetworks: []
    postfix_mydestination: []
    postfix_relay_domains: []
    postfix_other_settings: {}

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main_cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - validate_postfix
    - restart_postfix

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master_cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - validate_postfix
    - restart_postfix

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: root
    group: root
  loop:
    - /etc/postfix/certs
    - /etc/postfix/keys

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: server_cert.pem
    dest: /etc/postfix/certs/server_cert.pem
    mode: '0644'
  notify:
    - reload_postfix

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: server_key.pem
    dest: /etc/postfix/keys/server_key.pem
    mode: '0600'
  notify:
    - reload_postfix

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure aliases
  ansible.builtin.lineinfile:
    path: /etc/postfix/aliases
    line: "{{ item }}"
    create: true
    mode: '0644'
  loop: "{{ postfix_aliases | default([]) }}"
  notify:
    - rebuild_aliases
    - reload_postfix

- name: Configure sender_access
  ansible.builtin.copy:
    content: "{{ sender_access_content | default('') }}"
    dest: /etc/postfix/sender_access
    mode: '0644'
  notify:
    - rebuild_sender_access
    - reload_postfix

- name: Configure recipient_access
  ansible.builtin.copy:
    content: "{{ recipient_access_content | default('') }}"
    dest: /etc/postfix/recipient_access
    mode: '0644'
  notify:
    - validate_recipient_access
    - rebuild_recipient_access
    - reload_postfix

- name: Place sasl_password_map
  ansible.builtin.copy:
    content: "{{ sasl_password_map_content | default('') }}"
    dest: /etc/postfix/sasl_password
    mode: '0600'
  notify:
    - rebuild_sasl_password_map

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Start and enable postfix
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: true


