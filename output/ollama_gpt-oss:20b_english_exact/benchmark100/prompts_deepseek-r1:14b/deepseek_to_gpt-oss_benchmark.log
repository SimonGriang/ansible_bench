---
- name: "Task 1: Import assert.yml"
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: "Task 2: Configure apk"
  ansible.builtin.apk:
    update_cache: true
    upgrade: true
    state: latest
  changed_when: false

- name: "Task 3: Configure apt"
  ansible.builtin.apt:
    name: "{{ item }}"
    state: latest
    update_cache: true
    force: false
    dpkg_options: "force-confold"
  loop: "{{ apt_packages | default([]) }}"
  environment:
    DEBIAN_FRONTEND: noninteractive
  changed_when: false

- name: "Task 4: Update all software (dnf)"
  ansible.builtin.dnf:
    name: '*'
    state: latest
    exclude: "{{ dnf_exclude | default([]) }}"
  changed_when: false

- name: "Task 5: Update all software (pacman)"
  ansible.builtin.pacman:
    update_cache: true
    upgrade: true
    noconfirm: true
  changed_when: false

- name: "Task 6: Configure yum - CentOS/RHEL 6"
  ansible.builtin.dnf:
    name: '*'
    state: latest
  when: ansible_distribution_major_version == "6"
  changed_when: false

- name: "Task 6: Configure yum - non-6"
  ansible.builtin.yum:
    name: '*'
    state: latest
  when: ansible_distribution_major_version != "6"
  register: yum_update_result

- name: "Task 6: Install yum-utils"
  ansible.builtin.yum:
    name: yum-utils
    state: present
  when: ansible_distribution_major_version != "6"

- name: "Task 7: Update all software (zypper)"
  community.general.zypper:
    name: '*'
    state: latest
    refresh: true
    auto_agree_with_licenses: true
  changed_when: false


