---  
- name: Create the RKE2 config directory  
  file:  
    path: "{{ rke2_config_dir }}"  
    state: directory  
    mode: '0755'  

- name: Set server taints  
  set_fact:  
    rke2_node_taints: "{{ rke2_server_node_taints }}"  
  when: rke2_node_type == 'server'  

- name: Copy RKE2 configuration file  
  copy:  
    src: "{{ rke2_config_source }}"  
    dest: "{{ rke2_config_dir }}/config.yaml"  
    mode: '0644'  
  notify: Restart RKE2 service  

- name: Copy kubelet configuration file  
  copy:  
    src: "{{ rke2_kubelet_config_source }}"  
    dest: "{{ rke2_config_dir }}/kubelet-config.yaml"  
    mode: '0644'  
  when: rke2_kubelet_config is defined and rke2_kubelet_config != ''  
  notify: Restart RKE2 service  

- name: Copy Containerd Registry Configuration file  
  copy:  
    src: "{{ containerd_registry_config_source }}"  
    dest: "/etc/containerd/registry_config.toml"  
    mode: '0644'  
  when: containerd_registry_config is defined and containerd_registry_config != ''  
  notify: Restart Containerd  

- name: Register etcd restore from file  
  set_fact:  
    rke2_etcd_restore_from_file: "{{ rke2_etcd_snapshot_file is defined and (ansible_facts.services['rke2-server'].state != 'running') }}"  

- name: Register etcd restore from S3  
  set_fact:  
    rke2_etcd_restore_from_s3: "{{ rke2_s3_options is defined and rke2_s3_bucket is defined and rke2_s3_snapshot_key is defined }}"  

- name: Restore etcd from file  
  block:  
    - name: Ensure etcd data directory exists  
      file:  
        path: "/var/lib/rancher/rke2/server/db"  
        state: directory  
        mode: '0755'  
    - name: Copy etcd snapshot file  
      copy:  
        src: "{{ rke2_etcd_snapshot_file }}"  
        dest: "/var/lib/rancher/rke2/server/db/etcd_snapshot.db"  
        mode: '0644'  
    - name: Restore etcd from snapshot  
      command: >  
        rke2 etcd-snapshot restore  
        --data-dir /var/lib/rancher/rke2/server/db  
        --snapshot-file /var/lib/rancher/rke2/server/db/etcd_snapshot.db  
  when: rke2_etcd_restore_from_file  

- name: Restore etcd from S3  
  block:  
    - name: Download etcd snapshot from S3  
      shell: >  
        aws s3 cp s3://{{ rke2_s3_bucket }}/{{ rke2_s3_snapshot_key }}  
        /var/lib/rancher/rke2/server/db/etcd_snapshot.db  
      args:  
        creates: "/var/lib/rancher/rke2/server/db/etcd_snapshot.db"  
    - name: Restore etcd from snapshot  
      command: >  
        rke2 etcd-snapshot restore  
        --data-dir /var/lib/rancher/rke2/server/db  
        --snapshot-file /var/lib/rancher/rke2/server/db/etcd_snapshot.db  
  when: rke2_etcd_restore_from_s3  

- name: Start RKE2 service  
  service:  
    name: rke2-server  
    state: started  
    enabled: true  
    environment:  
      RKE2_TOKEN: "{{ rke2_token }}"  
  notify: Restart RKE2 service  

- name: Mask RKE2 agent service  
  systemd:  
    name: rke2-agent  
    enabled: false  
    masked: true  
    state: stopped  

- name: Wait for first server to be ready (no CNI)  
  wait_for:  
    host: "{{ inventory_hostname }}"  
    port: 6443  
    timeout: 300  
    delay: 10  
  when: rke2_cni is not defined or rke2_cni == ''  

- name: Wait for first server to be ready (with CNI)  
  wait_for:  
    host: "{{ inventory_hostname }}"  
    port: 6443  
    timeout: 300  
    delay: 10  
  when: rke2_cni is defined and rke2_cni != ''  

- name: Restore etcd  
  command: rke2 etcd-snapshot cleanup  
  when: rke2_etcd_restore_from_file or rke2_etcd_restore_from_s3  

- name: Set Active Server variable  
  set_fact:  
    rke2_active_server: "{{ groups['rke2_servers'][0] }}"  
  run_once: true  
  delegate_to: "{{ item }}"  
  loop: "{{ groups['all'] }}"  


