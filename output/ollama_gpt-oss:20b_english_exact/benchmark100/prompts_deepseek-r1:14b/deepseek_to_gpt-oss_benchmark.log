  register: docker_compose_version_output
  ignore_errors: true

- name: Set fact for docker-compose current version
  set_fact:
    docker_compose_current_version: >-
      "{{ docker_compose_version_output.stdout | regex_search(
        '([0-9]+\\.[0-9]+\\.[0-9]+)'
      ) }}"
  when: docker_compose_version_output.stdout is defined

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: >-
    docker_compose_current_version is defined and
    docker_compose_current_version != expected_docker_compose_version

- name: Install Docker Compose (if configured)
  get_url:
    url: "{{ docker_compose_download_url }}"
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when: >-
    docker_compose_current_version is not defined or
    docker_compose_current_version != expected_docker_compose_version


