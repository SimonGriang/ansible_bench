---
- name: >-
    Import assertion tasks from assert.yml for validation and run them once
    on localhost
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost
- name: >-
    Install all necessary packages required for Vault installation using the
    variable vault_prerequisites
  ansible.builtin.package:
    name: "{{ vault_prerequisites }}"
    state: present
- name: >-
    Include tasks from a file named after the installation method specified in
    the variable vault_installation_method
  ansible.builtin.include_tasks: "{{ vault_installation_method }}.yml"
- name: >-
    Add environment variables to the Vault configuration file located at
    /etc/vault.d/vault.env using the variable vault_environment_settings and
    notify the Restart vault handler
  ansible.builtin.lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item.key }}={{ item.value }}"
    create: true
    mode: "0600"
    owner: root
    group: root
  loop: "{{ vault_environment_settings | dict2items }}"
  notify: Restart vault
- name: >-
    Include security hardening tasks from the hardening.yml file
  ansible.builtin.include_tasks: hardening.yml
- name: >-
    Start and enable the Vault service only when the vault_type variable is set
    to "oss"
  ansible.builtin.service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"
- name: >-
    Enable the Vault service when the vault_type variable is not set to
    "oss"
  ansible.builtin.service:
    name: vault
    enabled: true
  when: vault_type != 'oss'


