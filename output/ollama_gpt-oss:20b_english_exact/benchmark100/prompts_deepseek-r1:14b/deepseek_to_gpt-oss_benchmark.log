- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.slurp:
    src: /etc/os-release
  register: os_release_raw

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    dist_name: >-
      {{
        (os_release_raw.content | b64decode | regex_findall('^ID=([^\\n]+)', multiline=True))[0]
          | regex_replace('\"', '')
      }}
    major_version: >-
      {{
        (os_release_raw.content | b64decode | regex_findall('^VERSION_ID=([^\\n]+)', multiline=True))[0]
          | regex_replace('\"', '')
          | regex_replace('^([0-9]+).*$', '\\1')
      }}

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    os_family: >-
      {{
        (dist_name | lower) in ['ubuntu', 'debian'] | ternary('Debian',
          (dist_name | lower) in ['centos', 'rhel', 'fedora'] | ternary('RedHat',
            (dist_name | lower) in ['arch'] | ternary('Archlinux',
              (dist_name | lower) in ['alpine'] | ternary('Alpine', 'Unknown')
            )
          )
        )
      }}


