---
- name: Import assertion file
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install cron package
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  lineinfile:
    path: /etc/default/cron
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    state: present

- name: Configure cron path environment
  lineinfile:
    path: /etc/default/cron
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    state: present

- name: Configure cron mailto settings
  lineinfile:
    path: /etc/default/cron
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    state: present

- name: Start and enable cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    job: "{{ item.job }}"
    user: "{{ item.user | default(omit) }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs }}"



