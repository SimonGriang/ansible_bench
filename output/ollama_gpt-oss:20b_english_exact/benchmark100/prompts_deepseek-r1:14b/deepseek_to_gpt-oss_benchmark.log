---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install requirements
  package:
    name: "{{ sysctl_requirements }}"
    state: present

- name: Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    reload: "{{ reload | default(false) }}"
  loop: "{{ sysctl_items }}"
  when: sysctl_items is defined and ansible_connection != 'container'


