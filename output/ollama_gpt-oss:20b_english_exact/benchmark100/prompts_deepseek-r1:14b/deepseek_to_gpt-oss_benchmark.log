---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    question: "postfix postfix/main_mailer_type"
    value: "Internet Site"
    vtype: "select"

- name: Install postfix
  ansible.builtin.package:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: '0644'
  notify:
    - validate_postfix_database
    - rebuild_postfix_database

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
    - validate_postfix_reload

- name: Setting values for main.cf (1/2)
  ansible.builtin.set_fact:
    postfix_recipient_access: "{{ recipient_access_map }}"
    postfix_sender_access: "{{ sender_access_map }}"

- name: Setting values for main.cf (2/2)
  ansible.builtin.set_fact:
    postfix_mynetworks: "{{ mynetworks }}"
    postfix_mydestination: "{{ mydestination }}"
    postfix_relay_domains: "{{ relay_domains }}"
    postfix_other_settings: "{{ other_settings }}"

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - validate_postfix_restart

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - validate_postfix_restart

- name: Creates cert/key directory
  ansible.builtin.file:
    path: /etc/postfix/ssl
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: tls_cert
    dest: /etc/postfix/ssl/server.crt
    mode: '0644'
  notify:
    - reload_postfix

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: tls_key
    dest: /etc/postfix/ssl/server.key
    mode: '0600'
  notify:
    - reload_postfix

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure aliases
  ansible.builtin.blockinfile:
    path: /etc/postfix/aliases
    block: "{{ postfix_aliases }}"
    create: true
    mode: '0644'
  notify:
    - rebuild_aliases
    - reload_postfix

- name: Configure sender_access
  ansible.builtin.template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: '0644'
  notify:
    - rebuild_sender_access
    - reload_postfix

- name: Configure recipient_access
  ansible.builtin.template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: '0644'
  notify:
    - validate_postfix
    - rebuild_recipient_access
    - reload_postfix

- name: Place sasl_password_map
  ansible.builtin.copy:
    src: sasl_password_map
    dest: /etc/postfix/sasl_passwd
    mode: '0600'
  notify:
    - rebuild_sasl_passwd_map

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Start and enable postfix
  ansible.builtin.service:
    name: postfix
