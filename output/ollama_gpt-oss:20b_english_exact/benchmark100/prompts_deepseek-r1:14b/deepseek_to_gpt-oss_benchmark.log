    url: "{{ promtail_download_url }}"
    dest: "{{ promtail_controller_download_dest }}"
    checksum: "sha256:{{ promtail_checksum }}"
  delegate_to: localhost
  register: promtail_controller_download

- name: Propagate promtail binaries
  copy:
    src: "{{ promtail_controller_download_dest }}"
    dest: "{{ promtail_temp_dir }}"
  register: promtail_copy_controller

- name: Unpack promtail binaries
  unarchive:
    src: "{{ promtail_temp_dir }}/promtail.zip"
    dest: "{{ promtail_app_dir }}"
    remote_src: yes
  register: promtail_unarchive

- name: Create symlink to latest promtail version
  file:
    src: "{{ promtail_app_dir }}/promtail-{{ promtail_version }}"
    dest: /usr/local/bin/promtail
    state: link
  notify: Restart Promtail

- name: Write promtail config file
  template:
    src: templates/promtail.yml.j2
    dest: "{{ promtail_config_dir }}/promtail.yml"
    owner: promtail
    group: promtail
    mode: '0644'
  notify: Restart Promtail

- name: Create systemd service unit
  template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: Restart Promtail


