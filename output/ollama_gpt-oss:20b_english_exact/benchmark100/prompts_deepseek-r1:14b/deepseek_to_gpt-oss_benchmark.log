---
- name: Create local SSH key directory for user
  file:
    path: "/home/{{ user }}/.ssh_keys"
    state: directory
    owner: "{{ user }}"
    mode: '0750'

- name: Manage user account
  user:
    name: "{{ user }}"
    state: "{{ user_state | default('present') }}"
    comment: "{{ user_comment | default('') }}"
    home: "{{ user_home | default('/home/' + user) }}"
    shell: "{{ user_shell | default('/bin/bash') }}"

- name: Set sudo options for user
  copy:
    dest: "/etc/sudoers.d/{{ user }}"
    content: "{{ user }} ALL=(ALL) NOPASSWD:ALL"
    mode: '0440'
    owner: root
    group: root

- name: Generate private SSH key for user
  command: "ssh-keygen -t rsa -b 4096 -f {{ key_path }} -N ''"
  args:
    creates: "{{ key_path }}"
  vars:
    key_path: "/home/{{ user }}/.ssh_keys/{{ user }}_id_rsa"

- name: Generate public SSH key for user
  command: "ssh-keygen -y -f {{ key_path }} > {{ key_path }}.pub"
  args:
    creates: "{{ key_path }}.pub"
  vars:
    key_path: "/home/{{ user }}/.ssh_keys/{{ user }}_id_rsa"

- name: Convert SSH key to ppk format for user
  command: "puttygen {{ key_path }} -O private -o {{ key_path }}.ppk"
  args:
    creates: "{{ key_path }}.ppk"
  vars:
    key_path: "/home/{{ user }}/.ssh_keys/{{ user }}_id_rsa"

- name: Get or set the home directory for user
  set_fact:
    user_home: "{{ user_home | default('/home/' + user) }}"

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user }}"
    group: "{{ user }}"

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user }}"
    state: present
    key: "{{ item }}"
  loop: "{{ authorized_keys | default([]) }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ unauthorized_keys | default([]) }}"

- name: Copy generated private SSH key for user
  copy:
    src: "/home/{{ user }}/.ssh_keys/{{ user }}_id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user }}"
    group: "{{ user }}"

- name: Check users password valid time for user
  command: "chage -l {{ user }}"
  register: chage_output

- name: Set users password valid time for user
  command: "chage -M {{ password_max_age | default(90) }} -m {{ password_min_age | default(0) }} -W {{ password_warning | default(7) }} {{ user }}"

- name: Place private key file for user
  copy:
    src: "{{ private_key_source }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user }}"
    group: "{{ user }}"


