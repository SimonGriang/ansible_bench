---
- name: Check Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_check

- name: Check Helm version
  command: helm version
  register: helm_existing_version
  changed_when: false
  failed_when: false

- name: Download helm
  unarchive:
    src: "https://get.helm.sh/helm-{{ desired_version }}-linux-amd64.tar.gz"
    dest: /tmp
    remote_src: yes
  when: not helm_check.stat.exists or (helm_existing_version.stdout and desired_version not in helm_existing_version.stdout)
  register: helm_download

- name: Copy helm binary into place
  copy:
    src: /tmp/linux-amd64/helm
    dest: /usr/local/bin/helm
    mode: '0755'
  become: true
  when: helm_download.changed


