    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: index-url
    value: "{{ python_pip_proxy }}"
  when: python_pip_proxy is defined

- name: Trust hosts
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
  when:
    - python_pip_update | bool
    - not (
        (ansible_facts['distribution'] in ['Debian', 'Ubuntu'] and
         (ansible_facts['distribution_version'] == '12' or
          ansible_facts['distribution_version'] == '24.04')) or
        ansible_facts['os_family'] == 'Alpine'
      )

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('latest') }}"
  loop: "{{ python_pip_modules }}"
  when:
    - not (
        (ansible_facts['distribution'] in ['Debian', 'Ubuntu'] and
         (ansible_facts['distribution_version'] == '12' or
          ansible_facts['distribution_version'] == '24.04')) or
        ansible_facts['os_family'] == 'Alpine'
      )


