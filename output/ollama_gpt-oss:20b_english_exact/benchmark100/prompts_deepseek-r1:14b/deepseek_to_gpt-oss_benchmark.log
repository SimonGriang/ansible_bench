---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Set SELinux boolean
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
      loop: "{{ selinux_booleans | default([]) }}"
    - name: Allow SELinux port
      seport:
        ports: "{{ item.ports }}"
        proto: "{{ item.proto | default('tcp') }}"
        setype: http_port_t
        state: present
      loop: "{{ selinux_ports | default([]) }}"
  when: selinux_enabled | bool

- name: Configure httpd
  template:
    src: "{{ httpd_conf_source }}"
    dest: "{{ httpd_conf_dest }}"
    mode: '0644'
  notify:
    - test httpd config
    - restart httpd

- name: Activate httpd module | Debian
  command: a2enmod {{ item }}
  args:
    creates: "/etc/apache2/mods-enabled/{{ item }}.load"
  loop: "{{ debian_modules | default([]) }}"
  changed_when: false

- name: Import ssl.yml
  import_tasks: ssl.yml

- name: Import locations.yml
  import_tasks: locations.yml

- name: Import vhosts.yml
  import_tasks: vhosts.yml

- name: Configure ports
  template:
    src: "{{ httpd_ports_source }}"
    dest: "{{ httpd_ports_dest }}"
    mode: '0644'
  notify:
    - test httpd config
    - restart httpd
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  import_tasks: directories.yml

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service_name | default('httpd') }}"
    state: started
    enabled: true


