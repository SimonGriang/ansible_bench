- name: Install Java on all hosts
  hosts: all
  become: true
  vars:
    java_home: "{{ java_home }}"
    java_home_bin: "{{ java_home_bin }}"
    java_version: "{{ java_version }}"
    java_version_major: "{{ java_version_major }}"
    java_version_minor: "{{ java_version_minor }}"
    java_version_patch: "{{ java_version_patch }}"
    java_version_full: "{{ java_version_full }}"
    java_vendor: "{{ java_vendor }}"
    java_arch: "{{ java_arch }}"
    java_install_path: "{{ java_install_path }}"
    java_install_path_bin: "{{ java_install_path_bin }}"
    java_download_url: "{{ java_download_url }}"
    java_download_checksum: "{{ java_download_checksum }}"
    java_download_checksum_type: "{{ java_download_checksum_type }}"
    java_download_checksum_file: "{{ java_download_checksum_file }}"
    java_checksum_file: "{{ java_checksum_file }}"
    java_checksum_type: "{{ java_checksum_type }}"
    java_checksum: "{{ java_checksum }}"
    java_checksum_file_md5: "{{ java_checksum_file_md5 }}"
    java_checksum_file_sha256: "{{ java_checksum_file_sha256 }}"
    java_checksum_file_sha512: "{{ java_checksum_file_sha512 }}"
    java_checksum_md5: "{{ java_checksum_md5 }}"
    java_checksum_sha256: "{{ java_checksum_sha256 }}"
    java_checksum_sha512: "{{ java_checksum_sha512 }}"
  tasks:
    - name: install_java
      shell: "mkdir -p {{ java_install_path }} && \
              wget -qO {{ java_checksum_file }} {{ java_download_url }} && \
              tar -xf {{ java_checksum_file }} -C {{ java_install_path }} && \
              mv {{ java_install_path }}/{{ java_version }} {{ java_install_path }}/{{ java_version_major }}"
