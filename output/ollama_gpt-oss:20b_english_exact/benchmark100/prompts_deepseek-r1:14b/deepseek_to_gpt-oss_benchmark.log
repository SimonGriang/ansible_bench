---
- name: Set docker variables
  set_fact:
    docker_version: "5:24.0.7~3-0~centos-linux_kernel-6"
    docker_packages:
      - docker-ce
      - docker-ce-cli
      - containerd.io
      - docker-buildx-plugin
      - docker-compose-plugin

- name: Install Docker and dependencies
  become: true
  ansible.builtin.dnf:
    name: "{{ docker_packages }}"
    state: present
    disable_gpg_check: true
  register: dnf_output
  ignore_errors: true

- name: Check for errors in dnf installation
  ansible.builtin.debug:
    msg: "Error installing Docker packages: {{ dnf_output.msg }}"
  when: dnf_output.failed

- name: Install Docker using yum if dnf fails
  become: true
  block:
    - name: Update all software using dnf on CentOS 7
      ansible.builtin.dnf:
        name: '*'
        state: latest
        update_cache: true
    - name: Update all software using yum on CentOS 8
      ansible.builtin.yum:
        name: '*'
        state: latest
        update_cache: true
  when: dnf_output.failed

- name: Start and enable Docker service
  become: true
  ansible.builtin.service:
    name: docker
    state: started
    enabled: true

- name: Install Docker Compose
  become: true
  ansible.builtin.get_url:
    url: |
      https://github.com/docker/compose/releases/download/v2.5.0/docker-compose-linux-x86_64
    dest: /usr/local/bin/docker-compose
    mode: '0755'

- name: Verify Docker installation
  become: true
  ansible.builtin.shell: docker --version
  register: docker_version_output
  changed_when: false

- name: Print Docker version
  ansible.builtin.debug:
    var: docker_version_output.stdout

- name: Install pip
  become: true
  ansible.builtin.pip:
    name: pip
    state: latest
    executable: pip3


