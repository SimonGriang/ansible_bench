---
- block:
    - name: Ensure Promtail installation directory exists
      file:
        path: "{{ promtail_install_dir }}"
        state: directory
        mode: '0755'
      become: true

    - name: Download Promtail tarball
      get_url:
        url: "{{ promtail_download_url }}"
        dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
        mode: '0644'
      register: download_promtail
      become: true

    - name: Download Promtail checksum file
      uri:
        url: "{{ promtail_download_url }}"
        return_content: true
      register: checksum_content

    - name: Set Promtail checksum fact
      set_fact:
        promtail_checksum: "{{ checksum_content.content | trim }}"

    - name: Verify Promtail tarball
      shell: |
        sha256sum /tmp/promtail-{{ promtail_version }}.tar.gz | grep -q "{{ promtail_checksum }}"
      changed_when: false
      failed_when: false

    - name: Unpack Promtail
      unarchive:
        src: "/tmp/promtail-{{ promtail_version }}.tar.gz"
        dest: "{{ promtail_install_dir }}"
        remote_src: true
        mode: '0755'
        checksum: "{{ promtail_checksum }}"
      notify: restart promtail
      become: true

    - name: Deploy Promtail systemd unit
      copy:
        dest: "{{ promtail_unit_path }}"
        mode: '0644'
        content: |
          [Unit]
          Description=Promtail service
          After=network.target

          [Service]
          Type=simple
          ExecStart={{ promtail_install_dir }}/{{ promtail_bin }} \\
          -config.file={{ promtail_install_dir }}/promtail.yaml
          Restart=on-failure
          RestartSec=10
          User=root

          [Install]
          WantedBy=multi-user.target
      become: true

    - name: Deploy Promtail configuration
      copy:
        dest: "{{ promtail_install_dir }}/promtail.yaml"
        mode: '0644'
        content: |
          server:
            http_listen_port: 9080
            grpc_listen_port: 0

          positions:
            filename: /tmp/positions.yaml

          clients:
          - url: "{{ loki_url }}/loki/api/v1/push"

          scrape_configs:
          - job_name: system
            static_configs:
            - targets: ['localhost']
              labels:
                job: varlogs
                __path__: /var/log/**/*.log
      become: true

    - name: Reload systemd daemon
      systemd:
        daemon_reload: true
      become: true

    - name: Enable Promtail service
      systemd:
        name: "{{ promtail_unit }}"
        enabled: true
        state: started
      become: true

  vars:
    promtail_version: "2.8.0"
    loki_url: "http://127.0.0.1:3100"
    promtail_install_dir: "/opt/promtail"
    promtail_unit: "promtail.service"
    promtail_unit_path: "/etc/systemd/system/{{ promtail_unit }}"
    promtail_bin: "promtail-linux-amd64"
    promtail_download_url: >-
      https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/
      promtail-linux-amd64.tar.gz

  handlers:
    - name: restart promtail
      systemd:
        name: "{{ promtail_unit }}"
        state: restarted
      become: true



