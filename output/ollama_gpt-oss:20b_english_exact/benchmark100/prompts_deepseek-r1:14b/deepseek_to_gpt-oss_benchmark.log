---
- name: Cadvisor | create directories
  ansible.builtin.file:
    path: /opt/cadvisor
    state: directory
    mode: '0755'
    recurse: true

- name: Cadvisor | download
  ansible.builtin.get_url:
    url: https://example.com/cadvisor
    dest: /opt/cadvisor/cadvisor
    mode: '0755'
    checksum: >-
      sha256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

- name: Cadvisor | propagate locally distributed cadvisor binary
  ansible.builtin.copy:
    src: /local/path/cadvisor
    dest: /opt/cadvisor/cadvisor
    mode: '0755'
  notify: restart cadvisor

- name: Cadvisor | symlink
  ansible.builtin.file:
    src: /opt/cadvisor/cadvisor
    dest: /usr/local/bin/cadvisor
    state: link

- name: Cadvisor | server systemd service
  ansible.builtin.template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'

- name: Test_task
  ansible.builtin.service:
    name: cadvisor
    state: started
  register: service_active

- name: Debug: var=service_active
  ansible.builtin.debug:
    var: service_active

- name: Cadvisor | enable server systemd
  ansible.builtin.service:
    name: cadvisor
    enabled: true

- name: Cadvisor | start server systemd
  ansible.builtin.service:
    name: cadvisor
    state: started


