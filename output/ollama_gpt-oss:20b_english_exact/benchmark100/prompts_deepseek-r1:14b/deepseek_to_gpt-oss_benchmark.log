---
- name: Validate all variables are set correctly
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host to be available
  wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ wait_port }}"
    timeout: "{{ wait_timeout }}"

- name: Prepare system for bootstrap
  block:
    - name: Test connection
      ping:
    - name: Gather facts
      setup:
    - name: Install raw bootstrap packages
      raw: "{{ bootstrap_install_cmd }}"
  rescue:
    - name: Handle connection failures
      debug:
        msg: "Connection failed. Skipping bootstrap."

- name: Ensure system preparation with Ansible modules
  block:
    - name: Gather facts
      setup:
    - name: Install packages for Debian
      apt:
        name: "{{ bootstrap_packages }}"
        state: present
      when: ansible_os_family == 'Debian'
    - name: Install packages for RedHat
      yum:
        name: "{{ bootstrap_packages }}"
        state: present
      when: ansible_os_family == 'RedHat'
    - name: Ensure system is fully prepared
      debug:
        msg: "System preparation complete."


