ation': 46719472152, 'model_name': 'gpt-oss:20b'} id='run--b7732260-76ef-4035-b083-bbcb96538b6f-0' usage_metadata={'input_tokens': 3399, 'output_tokens': 4167, 'total_tokens': 7566}
