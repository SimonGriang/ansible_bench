---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: yes
  changed_when: false

- name: Configure apt
  apt:
    update_cache: yes
    upgrade: dist
    dpkg_options: "force-confdef,force-confold"
  environment:
    DEBIAN_FRONTEND: noninteractive

- name: Update all software (dnf)
  dnf:
    name: "*"
    state: latest
    exclude: "package1,package2"

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes

- name: Configure yum - CentOS/RHEL 6
  dnf:
    name: "*"
    state: latest
  when: ansible_distribution_major_version == "6"

- name: Configure yum - non-6
  yum:
    name: yum-utils
    state: present
  when: ansible_distribution_major_version != "6"

- name: Configure yum - non-6 update
  yum:
    name: "*"
    state: latest
  when: ansible_distribution_major_version != "6"

- name: Update all software (zypper)
  zypper:
    name: "*"
    state: latest


