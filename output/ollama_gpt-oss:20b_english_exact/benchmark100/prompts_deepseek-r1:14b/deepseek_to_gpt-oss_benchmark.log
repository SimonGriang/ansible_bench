---
- name: Validate all variables are set correctly
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host to be available
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ wait_port | default(22) }}"
    timeout: "{{ wait_timeout | default(30) }}"

- name: Prepare system for bootstrap
  block:
    - name: Test connection
      ansible.builtin.ping:
    - name: Handle connection failures
      ansible.builtin.fail:
        msg: "Connection failed"
      when: ansible_connection is not defined
    - name: Gather facts
      ansible.builtin.setup:
    - name: Install raw bootstrap packages
      ansible.builtin.package:
        name: "{{ bootstrap_raw_packages }}"
        state: present

- name: Ensure system preparation with Ansible modules
  block:
    - name: Gather facts
      ansible.builtin.setup:
    - name: Install bootstrap packages based on OS family
      ansible.builtin.package:
        name: "{{ bootstrap_packages[ansible_facts['os_family']] }}"
        state: present
    - name: Ensure system is fully prepared
      ansible.builtin.assert:
        that: true




