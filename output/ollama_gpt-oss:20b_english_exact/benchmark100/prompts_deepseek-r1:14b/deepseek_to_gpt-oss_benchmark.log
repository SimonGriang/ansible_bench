---
- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: "{{ rke2_data_dir }}/manifests"
    state: directory
    mode: "0755"
    owner: "{{ rke2_user }}"
    group: "{{ rke2_group }}"

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    src: "templates/kube-vip-config.yaml"
    dest: "{{ rke2_data_dir }}/kube-vip-config.yaml"
    mode: "0644"
    owner: "{{ rke2_user }}"
    group: "{{ rke2_group }}"

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    src: "templates/kube-vip-loadbalancer.yaml"
    dest: "{{ rke2_data_dir }}/kube-vip-loadbalancer.yaml"
    mode: "0644"
    owner: "{{ rke2_user }}"
    group: "{{ rke2_group }}"
  when: kubevip_cloud_provider_enabled|bool


