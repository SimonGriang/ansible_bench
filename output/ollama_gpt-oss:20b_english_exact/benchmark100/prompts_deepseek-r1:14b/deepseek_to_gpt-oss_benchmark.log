---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: yes
  changed_when: false

- name: Configure apt
  apt:
    upgrade: dist
    update_cache: yes
    force: yes
    dpkg_options: 'force-confdef,force-confold'
  changed_when: false

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    exclude: ['package1', 'package2']
  changed_when: false

- name: Update cache and all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes
  changed_when: false

- name: Configure yum
  block:
    - name: Update all software using dnf on CentOS/RHEL 6
      dnf:
        name: '*'
        state: latest
      changed_when: false
      when: ansible_distribution_major_version == '6'
    - name: Install yum-utils on non-6
      yum:
        name: yum-utils
        state: present
      changed_when: false
      when: ansible_distribution_major_version != '6'
    - name: Update all software using yum on non-6
      yum:
        name: '*'
        state: latest
      changed_when: false
      when: ansible_distribution_major_version != '6'
  when: ansible_distribution in ['CentOS', 'RedHat']

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest
  changed_when: false


