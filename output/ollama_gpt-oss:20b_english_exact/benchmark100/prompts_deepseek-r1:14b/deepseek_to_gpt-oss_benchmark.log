---
- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: /etc/rancher/rke2/manifest
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    src: templates/kube-vip/
    dest: /etc/rancher/rke2/kube-vip/
    mode: '0644'
    recurse: true

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    src: templates/kube-vip-lb/
    dest: /etc/rancher/rke2/kube-vip-lb/
    mode: '0644'
    recurse: true
  when:
    - kube_vip_cloud_provider_enabled is defined
    - kube_vip_cloud_provider_enabled


