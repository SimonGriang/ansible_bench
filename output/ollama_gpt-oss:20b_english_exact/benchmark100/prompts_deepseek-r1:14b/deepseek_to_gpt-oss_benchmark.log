---
- name: Install EPEL repository on compatible systems
  when: |
    (ansible_facts['distribution'] == 'Amazon' and
     ansible_facts['distribution_major_version'] == '2') or
    (ansible_facts['distribution'] == 'RedHat' and
     ansible_facts['distribution_major_version'] | int in [7,8,9])
  debug:
    msg: "Proceeding with EPEL repository installation on this system."

- name: Install EPEL GPG key
  when: |
    (ansible_facts['distribution'] == 'Amazon' and
     ansible_facts['distribution_major_version'] == '2') or
    (ansible_facts['distribution'] == 'RedHat' and
     ansible_facts['distribution_major_version'] | int in [7,8,9])
  rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present
  notify: Update package cache

- name: Install EPEL release package
  when: |
    (ansible_facts['distribution'] == 'Amazon' and
     ansible_facts['distribution_major_version'] == '2') or
    (ansible_facts['distribution'] == 'RedHat' and
     ansible_facts['distribution_major_version'] | int in [7,8,9])
  yum:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Install EPEL next release package (conditional)
  when: |
    epel_next and
    ((ansible_facts['distribution'] == 'Amazon' and
      ansible_facts['distribution_major_version'] == '2') or
     (ansible_facts['distribution'] == 'RedHat' and
      ansible_facts['distribution_major_version'] | int in [7,8,9]))
  yum:
    name: "{{ epel_next_url }}"
    state: present
  notify: Update package cache


