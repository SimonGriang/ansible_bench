---
- name: Import assertion file
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Enable Redis module stream for RHEL 8
  ansible.builtin.dnf:
    name: redis:8.0
    state: enabled

- name: Install Redis package
  ansible.builtin.package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure Redis settings
  ansible.builtin.template:
    src: "redis.conf-{{ ansible_distribution }}.j2"
    dest: "/etc/redis/redis.conf"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart Redis

- name: Start and enable Redis service
  ansible.builtin.service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


