---
- name: Check if Java certificates exist
  stat:
    path: "{{ item }}"
  loop: "{{ java_certs }}"
  register: cert_stat

- name: Fail if Java certificates are missing
  fail:
    msg: "Missing certificate: {{ cert_stat.results | selectattr('stat.exists', 'equalto', False) | map(attribute='item') | list | join(', ') }}"
  when: cert_stat.results | selectattr('stat.exists', 'equalto', False) | list | length > 0

- name: Set keystore directory for Java versions less than 11
  set_fact:
    java_keystore_dir: "{{ legacy_keystore_dir }}"
  when: java_version is defined and java_version | int < 11

- name: Set keystore directory for Java versions 11 or newer
  set_fact:
    java_keystore_dir: "{{ new_keystore_dir }}"
  when: java_version is defined and java_version | int >= 11

- name: Import SSL certificates into Java keystore
  command: >
    keytool -importcert
    -file {{ item.cert_path }}
    -alias {{ item.alias }}
    -keystore {{ java_keystore_dir }}/cacerts
    -storepass {{ java_keystore_password | default('changeit') }}
    -noprompt
  args:
    creates: "{{ java_keystore_dir }}/cacerts"
  loop: "{{ java_certs }}"



