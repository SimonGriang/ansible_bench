    # 1️⃣  Set RKE2 bin path – multiline
    # ------------------------------------------------------------
    - name: Set RKE2 bin path
      set_fact:
        rke2_bin_path: >-
          "{{ usr_local_stat.stat.writable | ternary(
          '/usr/local/bin/rke2',
          '/usr/bin/rke2'
          ) }}"
      when: usr_local_stat.stat.writable and not usr_local_stat.stat.is_mountpoint

    - name: Install RKE2 binary
      copy:
        src: "{{ rke2_install_dir }}/rke2"
        dest: "{{ rke2_bin_path }}"
        mode: '0755'
      when: not airgap_mode

    - name: Create RKE2 config directory
      file:
        path: "{{ rke2_config_dir }}"
        state: directory
        mode: '0755'
      when: airgap_mode

    - name: Copy RKE2 config
      copy:
        src: "rke2.conf"
        dest: "{{ rke2_config_dir }}/rke2.conf"
        mode: '0644'
      when: airgap_mode

    - name: Copy RKE2 manifest
      copy:
        src: "rke2.yaml"
        dest: "{{ rke2_config_dir }}/rke2.yaml"
        mode: '0644'
      when: airgap_mode

    # ------------------------------------------------------------
    # Generate token – command split into two lines
    # ------------------------------------------------------------
    - name: Generate RKE2 token
      command: >-
        {{ rke2_bin_path }} token generate --name rke2 --config {{ rke2_config_dir }}/rke2.conf
      register: rke2_token
      changed_when: false
      when: airgap_mode

    - name: Copy RKE2 token
      copy:
        content: "{{ rke2_token.stdout }}"
        dest: "{{ rke2_config_dir }}/rke2.token"
        mode: '0644'
      when: airgap_mode

    # ------------------------------------------------------------
    # Install RKE2 agent – command split into two lines
    # ------------------------------------------------------------
    - name: Install RKE2 agent
      command: >-
        {{ rke2_bin_path }} install --name rke2 --config {{ rke2_config_dir }}/rke2.conf --token-file {{ rke2_config_dir }}/rke2.token
      changed_when: false
      when: airgap_mode

    # ------------------------------------------------------------
    # Install RKE2 server – command split into two lines
    # ------------------------------------------------------------
    - name: Install RKE2 server
      command: >-
        {{ rke2_bin_path }} install --name rke2 --config {{ rke2_config_dir }}/rke2.conf
      changed_when: false
      when: not airgap_mode

    - name: Check RKE2 version
      shell: "{{ rke2_bin_path }} version --short"
      register: rke2_version_output
      changed_when: false

    - name: Verify RKE2 version
      assert:
        that:
          - "{{ rke2_version_output.stdout == rke2_version }}"
        fail_msg: "RKE2 version does not match expected version"
      when: rke2_version_output.stdout != rke2_version

    # ------------------------------------------------------------
    # 2️⃣  Reset RKE2 bin path – multiline
    # ------------------------------------------------------------
    - name: Set RKE2 bin path
      set_fact:
        rke2_bin_path: >-
          "{{ usr_local_stat.stat.writable | ternary(
          '/usr/local/bin/rke2',
          '/usr/bin/rke2'
          ) }}"
      when: usr_local_stat.stat.writable and not usr_local_stat.stat.is_mountpoint

    # ------------------------------------------------------------
    # 3️⃣  Prevent accidental RKE2 downgrade – multiline + recurse
    # ------------------------------------------------------------
    - name: Prevent accidental RKE2 downgrade
      assert:
        that:
