---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: "{{ 'temurin' if java_jdk_vendor == 'adoptopenjdk' else java_jdk_vendor }}"

- name: Gather OS specific variables
  include_vars:
    file: "vars/{{ java_jdk_vendor }}-{{ ansible_distribution | lower }}-{{ ansible_distribution_version | regex_replace('^([0-9]+).*', '\\1') }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: "vars/{{ ansible_architecture | lower }}.yml"

- name: Set OS specific variables (I)
  set_fact:
    java_version: "{{ java_version | default('11') }}"
    java_repositories: "{{ java_repositories | default([]) }}"
    java_libs: "{{ java_libs | default([]) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_install_path: "{{ java_install_path | default('/opt/java') }}"
    java_pkg_name: "{{ java_pkg_name | default('temurin-' + java_version + '-jdk') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_install_path }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "{{ item }}"
        state: absent
      loop: "{{ deprecated_repos | default([]) }}"

    - name: Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ apt_tools | default([]) }}"

    - name: Add key repositories
      apt_key:
        url: "{{ item }}"
        state: present
      loop: "{{ key_repos | default([]) }}"

    - name: Add required repositories
      apt_repository:
        repo: "{{ item }}"
        state: present
      loop: "{{ required_repos | default([]) }}"
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        gpgcheck: yes
        gpgkey: "{{ item.gpgkey }}"
      loop: "{{ key_repos | default([]) }}"

    - name: Add required repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        gpgcheck: yes
        gpgkey: "{{ item.gpgkey }}"
      loop: "{{ required_repos | default([]) }}"
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  package:
    name: "{{ java_libs }}"
    state: present

- name: Install Java, Debian
  apt:
    name: "{{ java_pkg_name }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ java_pkg_name }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  copy:
    dest: /etc/profile.d/java.sh
    content: |
      export JAVA_HOME={{ java_home }}
      export PATH=$JAVA_HOME/bin:$PATH
    mode: '0644'

- name: Source environment variables
  command: source /etc/profile.d/java.sh
  args:
    executable: /bin/bash

- name: Correct java version selected for Java < 11
  alternatives:
    name: java
    path: "{{ java_home }}/jre/bin/java"
    state: present
    priority: 2000
  when: java_version is defined and java_version | int < 11

- name: Correct java version selected for Java >= 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    state: present
    priority: 2000
  when: java_version is defined and java_version | int >= 11


