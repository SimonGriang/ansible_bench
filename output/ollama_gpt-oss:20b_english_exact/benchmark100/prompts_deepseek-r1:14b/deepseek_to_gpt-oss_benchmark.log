---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0700'
  when: airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ local_rke2_script_path }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0700'
  when:
    - airgap_mode
    - implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: '0700'
  when:
    - airgap_mode
    - implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - get_url:
        url: "{{ remote_checksum_url }}"
        dest: "{{ remote_checksum_path }}"
        mode: '0640'
    - get_url:
        url: "{{ remote_artifact_url }}"
        dest: "{{ artifact_path }}"
        mode: '0640'
        checksum: "{{ rke2_artifact_checksum }}"
  rescue:
    - copy:
        src: "{{ local_checksum_path }}"
        dest: "{{ remote_checksum_path }}"
        mode: '0640'
    - copy:
        src: "{{ local_artifact_path }}"
        dest: "{{ artifact_path }}"
        mode: '0640'
  when: airgap_mode

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ local_artifact_path }}"
    dest: "{{ artifact_path }}"
    mode: '0640'
  when:
    - airgap_mode
    - implementation == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - file:
        path: "{{ additional_images_dir }}"
        state: directory
        mode: '0700'
    - copy:
        src: "{{ item }}"
        dest: "{{ additional_images_dir }}/"
        mode: '0640'
      loop: "{{ additional_tarballs }}"
  when:
    - airgap_mode
    - additional_tarballs is defined

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - file:
        path: "{{ artifact_path }}"
        mode: '0400'
    - file:
        path: "{{ rke2_install_script_path }}"
        mode: '0700'
  when:
    - airgap_mode
    - implementation == 'exists'

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: >-
      {% if usr_local_stat.stat.writable and usr_local_stat.stat.mounted %}
        /usr/local/bin
      {% else %}
        /usr/bin
      {% endif %}

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 --version"
  register: rke2_version_output

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - not downgrade_allowed
    msg: "Downgrade not allowed unless explicitly permitted."
  vars:
    downgrade_allowed: "{{ allow_downgrade | default(false) }}"

- name: Run RKE2 install script
  shell: "{{ rke2_install_script_path }}"
  environment:
    RKE2_AIRGAP: "{{ airgap_mode | bool | ternary('true', 'false') }}"

- name: Copy Custom Manifests
  template:
    src: custom_manifests.j2
    dest: "{{ rke2_manifests_dir }}/custom.yaml"

- name: Copy Static Pods
  copy:
    src: static_pods/
    dest: "{{ rke2_agent_pod_manifests_dir }}/"

- name: Copy RKE2 environment file
  template:
    src: rke2_env.j2
    dest: "{{ rke2_env_dir }}/rke2.env"
    mode: '0640'
  when: rke2_env_options is defined


