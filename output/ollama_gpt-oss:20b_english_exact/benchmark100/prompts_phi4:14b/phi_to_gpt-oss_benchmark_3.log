---
- name: >-
    Enable the Backports repository for Debian systems with a version less
    than 9
  apt_repository:
    repo: >-
      deb http://deb.debian.org/debian
      {{ ansible_distribution_release }}-backports main
    state: present
    update_cache: true
  when:
    - ansible_distribution == 'Debian'
    - ansible_distribution_version is version('9', '<')

- name: >-
    Set the default release to Backports for Debian systems with a version less
    than 9
  set_fact:
    ansible_default_release: "{{ ansible_distribution_release }}-backports"
  when:
    - ansible_distribution == 'Debian'
    - ansible_distribution_version is version('9', '<')

- name: >-
    Install the Ansible package, using the Backports release if applicable
  apt:
    name: ansible
    state: "{{ ansible_package_state }}"
    default_release: >-
      {{ ansible_default_release | default(omit) }}
  when:
    - ansible_distribution == 'Debian'
    - ansible_distribution_version is version('9', '<')


