---
- name: Import assert.yml as a standalone task
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure SELinux
  block:
    - name: Manage SELinux
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot
    - name: Manage SELinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      when: selinux_booleans is defined
      loop_control:
        label: "{{ item.name }}"
  when: ansible_selinux.status is defined and ansible_connection not in ['container', 'docker', 'community.docker.docker']


