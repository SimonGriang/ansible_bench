---
- name: Import assert.yml tasks
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install HashiCorp products using the package installation method
  block:
    - name: Add HashiCorp repository for RedHat/Rocky
      when: ansible_facts.os_family == "RedHat"
      block:
        - name: Download HashiCorp repo file
          ansible.builtin.get_url:
            url: https://rpm.releases.hashicorp.com/RHEL/hashicorp.repo
            dest: /etc/yum.repos.d/hashicorp.repo
            mode: '0644'
        - name: Ensure HashiCorp repo file permissions
          ansible.builtin.file:
            path: /etc/yum.repos.d/hashicorp.repo
            mode: '0644'
    - name: Add HashiCorp repository for Debian
      when: ansible_facts.os_family == "Debian"
      block:
        - name: Install gnupg package
          ansible.builtin.apt:
            name: gnupg
            state: present
            update_cache: yes
        - name: Import HashiCorp GPG key
          ansible.builtin.apt_key:
            url: https://rpm.releases.hashicorp.com/gpg
            state: present
        - name: Add HashiCorp repository
          ansible.builtin.apt_repository:
            repo: "deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_facts.lsb.codename }} main"
            state: present
    - name: Install HashiCorp products
      ansible.builtin.package:
        name: "{{ item.name }}{{ ':' + item.version if item.version is defined else '' }}"
        state: present
      loop: "{{ hashicorp_products }}"
  when: installation_method == "package"

- name: Install HashiCorp products manually
  block:
    - name: Unarchive HashiCorp product
      ansible.builtin.unarchive:
        src: "{{ item.source }}"
        dest: "{{ item.dest }}"
        remote_src: true
        owner: "{{ item.owner | default('root') }}"
        group: "{{ item.group | default('root') }}"
        mode: "{{ item.mode | default('0755') }}"
      loop: "{{ hashicorp_products }}"
  when: installation_method == "manual"


