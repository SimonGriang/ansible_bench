---
- name: Cordon and Drain the node during RKE2 upgrade
  ansible.builtin.command:
    cmd: "kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-emptydir-data"
  register: drain
  retries: 100
  delay: 15
  until: drain.rc == 0
  when: rke2_drain_node_during_upgrade
  delegate_to: active_server

- name: Restart the RKE2 service on the node
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify:
    - Service (re)started

- name: Wait for all nodes to be ready again
  ansible.builtin.command:
    cmd: "kubectl get nodes --no-headers | grep -c 'Ready'"
  register: result
  retries: 100
  delay: 15
  until: result.stdout | int == (groups[rke2_cluster_group_name] | length)
  delegate_to: active_server
  run_once: true

- name: Uncordon the node after the upgrade
  ansible.builtin.command:
    cmd: "kubectl uncordon {{ rke2_node_name }}"
  when: rke2_drain_node_during_upgrade
  delegate_to: active_server
  run_once: true

- name: Wait for all pods to be ready again
  ansible.builtin.command:
    cmd: "kubectl get pods --all-namespaces --no-headers | grep -vE 'Running|Succeeded' | wc -l"
  register: pod_count
  retries: 100
  delay: 15
  until: pod_count.stdout | int == 0
  when: rke2_wait_for_all_pods_to_be_ready
  delegate_to: active_server
  run_once: true

- name: Wait for all pods to pass readiness checks
  ansible.builtin.command:
    cmd: "kubectl wait --for=condition=Ready pods --all {{ rke2_wait_for_all_pods_to_be_healthy_args }}"
  retries: 100
  delay: 15
  until: result.rc == 0
  register: result
  when: rke2_wait_for_all_pods_to_be_healthy
  delegate_to: active_server
  run_once: true



