---
- name: Import assertion task file
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Uninstall systemd-logger
  package:
    name: systemd-logger
    state: absent

- name: Install rsyslog package
  package:
    name: "{{ rsyslog_packages }}"
    state: "{{ rsyslog_package_state }}"

- name: Install additional rsyslog packages
  package:
    name: "{{ item }}"
    state: "{{ rsyslog_package_state }}"
  loop: "{{ rsyslog_features }}"

- name: Configure default rsyslog settings
  template:
    src: "{{ rsyslog_config_file_format }}.j2"
    dest: "{{ rsyslog_dest_conf_file }}"
  when: rsyslog_deploy_default_config
  notify: restart rsyslog

- name: Ensure rsyslog configuration directory exists
  file:
    path: /etc/rsyslog.d/
    state: directory
    mode: '0755'

- name: Configure rsyslog forwarding rule
  template:
    src: forward_rule.conf.j2
    dest: "/etc/rsyslog.d/{{ rsyslog_forward_rule_name }}.conf"
  when: not rsyslog_deploy_default_config
  notify: restart rsyslog

- name: Configure additional rsyslog configuration files
  copy:
    dest: "/etc/rsyslog.d/{{ item.key }}.conf"
    content: "{{ item.value.content | default(item.value) }}"
    mode: '0644'
    state: present
  loop: "{{ rsyslog_rsyslog_d_files | dict2items }}"
  when: item.value.state | default('present') == 'present'
  notify: restart rsyslog

- name: Start and enable rsyslog service
  service:
    name: "{{ rsyslog_service }}"
    state: started
    enabled: true


