---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - set root password
    - daemon-reload

- name: Configure mysql server
  ini_file:
    path: "{{ mysql_configuration_destination }}"
    section: "{{ mysql_name }}"
    option: "{{ item.key }}"
    value: "{{ item.value }}"
  loop: "{{ mysql_configuration_options | dict2items }}"
  notify:
    - set root password
    - daemon-reload

- name: Configure mysql client
  ini_file:
    path: "{{ mysql_configuration_destination }}"
    section: client
    option: socket
    value: "{{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  meta: flush_handlers


