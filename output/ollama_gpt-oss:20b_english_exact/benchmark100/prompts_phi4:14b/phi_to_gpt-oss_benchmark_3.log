            mode: '0644'
    - name: Add HashiCorp repository for Debian
      when: ansible_facts.os_family == "Debian"
      block:
        - name: Install gnupg package
          ansible.builtin.apt:
            name: gnupg
            state: present
            update_cache: true
        - name: Import HashiCorp GPG key
          ansible.builtin.apt_key:
            url: https://rpm.releases.hashicorp.com/gpg
            state: present
