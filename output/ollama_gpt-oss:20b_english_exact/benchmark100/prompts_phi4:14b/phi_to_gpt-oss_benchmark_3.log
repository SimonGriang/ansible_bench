        state: present
      loop: "{{ hashicorp_products }}"
  when: installation_method == "package"

- name: Install HashiCorp products manually
  block:
    - name: Unarchive HashiCorp product
      ansible.builtin.unarchive:
        src: "{{ item.source }}"
        dest: "{{ item.dest }}"
        remote_src: true
        owner: "{{ item.owner | default('root') }}"
        group: "{{ item.group | default('root') }}"
        mode: "{{ item.mode | default('0755') }}"
      loop: "{{ hashicorp_products }}"
  when: installation_method == "manual"


