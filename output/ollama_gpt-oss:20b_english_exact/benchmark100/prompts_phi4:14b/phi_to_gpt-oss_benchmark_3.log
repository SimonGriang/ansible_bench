---
- name: Download and install RKE2 version
  vars:
    base_url: "https://github.com/rancher/rke2/releases/download/"
    suffix: "/rke2.linux-amd64.tar.gz"
  ansible.builtin.get_url:
    url: "{{ base_url + rke2_version + suffix }}"
    dest: "/tmp/rke2.tar.gz"
    mode: '0644'
  when: rke2_version is defined

- name: Unarchive RKE2 package
  ansible.builtin.unarchive:
    remote_src: true
    src: /tmp/rke2.tar.gz
    dest: /
  remote_user: root
  when: rke2_version is defined

- name: Find the master node name
  ansible.builtin.command:
    argv:
      - kubectl
      - get
      - nodes
      - -l
      - node-role.kubernetes.io/master
      - -o
      - jsonpath={.items[0].metadata.name}
  register: master_node_name
  changed_when: false
  when: rke2_version is defined

- name: Find the agent node name
  ansible.builtin.command:
    argv:
      - kubectl
      - get
      - nodes
      - -l
      - node-role.kubernetes.io/agent
      - -o
      - jsonpath={.items[0].metadata.name}
  register: agent_node_name
  changed_when: false
  when: rke2_version is defined

- name: Unarchive RKE2 agent
  ansible.builtin.unarchive:
    remote_src: true
    src: /tmp/rke2.tar.gz
    dest: /
  remote_user: root
  when: rke2_version is defined

- name: Agent
  ansible.builtin.command:
    argv:
      - /usr/local/bin/rke2
      - agent
      - --node-name
      - "{{ agent_node_name.stdout }}"
  remote_user: root
  changed_when: false
  when: rke2_version is defined

- name: Agent Agent
  ansible.builtin.command:
    argv:
      - /usr/local/bin/rke2
      - agent
      - --node-name
      - "{{ agent_node_name.stdout }}"
  remote_user: root
  changed_when: false
  when: rke2_version is defined


