  when: not rke2_airgap_mode

- name: |
    Copy local RKE2 installation script if in airgap mode using the 'copy' method
  copy:
    src: "{{ rke2_local_script_path }}"
    dest: "/usr/local/bin/rke2"
    mode: "0755"
    force: true
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'copy'

- name: |
    Create RKE2 artifacts folder if in airgap mode and the
    implementation is not 'exists'
  file:
    path: "{{ rke2_airgap_artifacts_dir }}"
    state: directory
    mode: "0755"
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation != 'exists'

- name: |
    Download RKE2 checksum and artifacts with a fallback mechanism for airgap mode
    using the 'download' method
  block:
    - name: Download checksum
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_airgap_artifacts_dir }}/sha256sum.txt"
        mode: "0644"
      register: checksum_download

    - name: Download artifacts
      get_url:
        url: "{{ rke2_artifact_url }}"
        dest: "{{ rke2_airgap_artifacts_dir }}/rke2.tar.gz"
        mode: "0644"
      register: artifact_download

  rescue:
    - name: Copy checksum locally
      copy:
        src: "{{ rke2_local_checksum_path }}"
        dest: "{{ rke2_airgap_artifacts_dir }}/sha256sum.txt"
        mode: "0644"
        force: true

    - name: Copy artifacts locally
      copy:
        src: "{{ rke2_local_artifact_path }}"
        dest: "{{ rke2_airgap_artifacts_dir }}/rke2.tar.gz"
        mode: "0644"
        force: true
  when: rke2_airgap_mode

- name: Copy local RKE2 artifacts if in airgap mode using the 'copy' method
  copy:
    src: "{{ rke2_local_artifacts_dir }}/{{ item }}"
    dest: "{{ rke2_airgap_artifacts_dir }}/{{ item }}"
    mode: "0644"
    force: true
  loop: "{{ rke2_artifacts_list }}"
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'copy'

- name: |
    Handle additional tarballs in airgap mode if not using 'exists' implementation
  block:
    - name: Create directory for additional tarballs
      file:
        path: "{{ rke2_airgap_additional_tarballs_dir }}"
        state: directory
        mode: "0755"

    - name: Copy additional tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_airgap_additional_tarballs_dir }}/{{ item | basename }}"
        mode: "0644"
        force: true
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation != 'exists'
    - rke2_airgap_copy_additional_tarballs | length > 0

- name: |
    Ensure artifacts exist and have acceptable permissions in airgap mode
    with 'exists' implementation
  block:
    - name: Ensure RKE2 artifacts are present
      file:
        path: "{{ rke2_airgap_artifacts_dir }}/{{ item }}"
        state: file
        mode: "0644"
      loop: "{{ rke2_artifacts_list }}"

    - name: Ensure installation script is executable
      file:
        path: "/usr/local/bin/rke2"
        state: file
        mode: "0755"
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'exists'

- name: Populate service facts to gather information about system services
  service_facts:

- name: Get filesystem statistics for the /usr/local directory
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Check if /usr/local is on a separate partition
  shell: |
    if grep -q '^/usr/local ' /proc/mounts; then
      echo 0
    else
      echo 1
    fi
  register: local_separate_partition
  changed_when: false

- name: Determine the RKE2 binary path based on filesystem checks
  set_fact:
    rke2_binary_path: >-
      "{{ (usr_local_stat.stat.writable | bool or
         local_separate_partition.stdout == '0') |
         ternary('/usr/local/bin/rke2', '/usr/bin/rke2') }}"

- name: Check the installed and running RKE2 versions
  block:
    - name: Get installed RKE2 version
      command: "{{ rke2_binary_path }} version --short"
      register: installed_version
      changed_when: false

    - name: Get running RKE2 service status
      command: systemctl is-active rke2-server.service
      register: running_status
      changed_when: false

    - name: Set RKE2 version information
      set_fact:
        rke2_version_info:
          installed: "{{ installed_version.stdout }}"
          running: "{{ running_status.stdout }}"
  when: not ansible_check_mode

- name: Set RKE2 version facts based on the version check results
  set_fact:
    rke2_installed_version: "{{ rke2_version_info.installed }}"
    rke2_running_version: "{{ rke2_version_info.running }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade unless explicitly allowed
  assert:
    that:
      - >-
        rke2_allow_downgrade | default(false) or
        (rke2_version | version_compare(rke2_running_version, '>=' ))
    fail_msg: |
      Downgrading RKE2 from {{ rke2_running_version }} to {{ rke2_version }} is not
      allowed.
  when: rke2_version is defined and rke2_running_version is defined

- name: Run RKE2 install script if the version needs to be updated
  block:
    - name: Install RKE2
      command: "{{ rke2_binary_path }} install"
      environment:
        INSTALL_RKE2_VERSION: "{{ rke2_version }}"
      args:
        creates: "/etc/rancher/rke2/rke2.conf"
  when:
    - rke2_version is defined
    - rke2_running_version is defined
    - rke2_version != rke2_running_version

- name: Copy custom manifests if they are defined
  copy:
    src: "{{ item }}"
    dest: "/var/lib/rancher/rke2/server/manifests/{{ item | basename }}"
    mode: "0644"
  loop: "{{ rke2_custom_manifests }}"
  when:
    - rke2_custom_manifests is defined
    - rke2_custom_manifests | length > 0

- name: Copy static pods if they are defined
  copy:
    src: "{{ item }}"
    dest: "/var/lib/rancher/rke2/agent/pod-manifests/{{ item | basename }}"
    mode: "0644"
  loop: "{{ rke2_static_pods }}"
  when:
    - rke2_static_pods is defined
    - rke2_static_pods | length > 0

- name: Copy RKE2 environment file if environment options are defined
  copy:
    src: "{{ rke2_env_file }}"
    dest: "/etc/rancher/rke2/rke2.conf"
    mode: "0644"
  when:
    - rke2_env_file is defined
    - rke2_env_file | length > 0


