---
- name: Install Keepalived when HA mode is enabled
  package:
    name: keepalived
    state: present
  when:
    - rke2_ha_mode is defined
    - rke2_ha_mode
    - rke2_keepalived_enabled is defined
    - rke2_keepalived_enabled
    - inventory_hostname in groups['rke2_servers']
    - api_ip is defined

- name: Download and install RKE2 version
  get_url:
    url: "https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2.linux-amd64.tar.gz"
    dest: "/tmp/rke2.tar.gz"
    mode: '0644'
  when: rke2_version is defined

- name: Download and install RKE2 version
  unarchive:
    src: "/tmp/rke2.tar.gz"
    dest: "/opt/rke2"
    remote_src: yes
  when: rke2_version is defined

- name: Apply CIS Hardening
  include_role:
    name: cis-hardening
  when: cis_profile is defined

- name: Find Active Server
  command: "kubectl get nodes -l node-role.kubernetes.io/master -o jsonpath='{.items[0].metadata.name}'"
  register: active_server
  when: groups['rke2_servers'] | length > 1

- name: Enable IPVS kernel module
  modprobe:
    name: ip_vs
    state: present
  when:
    - kubevip_ipvs_enabled is defined
    - kubevip_ipvs_enabled
    - inventory_hostname in groups['rke2_servers']
    - rke2_ha_mode is defined
    - rke2_ha_mode
    - not rke2_keepalived_enabled

- name: Copy kube-vip manifests to the masternode
  copy:
    src: files/kube-vip.yaml
    dest: /etc/rancher/rke2/config.yaml
  when:
    - kubevip_enabled is defined
    - kubevip_enabled
    - not rke2_keepalived_enabled
    - inventory_hostname == active_server.stdout

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: files/ingress-nginx.yaml
    dest: /etc/rancher/rke2/config.yaml
  when:
    - ingress_nginx_values is defined
    - ingress_nginx_values | length > 0
    - inventory_hostname == active_server.stdout

- name: Prepare very first server node in the cluster
  command: "rke2 server --config /etc/rancher/rke2/config.yaml"
  when:
    - groups['rke2_servers'] | length == 1
    - or active_server.stdout == ""

- name: Restore etcd specific tasks
  command: "etcdctl snapshot restore /path/to/backup.db"
  when:
    - active_server.stdout != ""
    - inventory_hostname == active_server.stdout or inventory_hostname == first_server_hostname
    - etcd_restore is defined

- name: Download kubeconfig to ansible localhost
  fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: ./kubeconfig
    flat: yes
  when:
    - download_kubeconfig is defined
    - download_kubeconfig
    - inventory_hostname == first_server_hostname

- name: Prepare and join remaining nodes of the cluster
  command: "rke2 agent --server https://{{ active_server.stdout }}:9345 --token {{ join_token }}"
  when:
    - active_server.stdout != ""
    - groups['rke2_servers'] | length >= 2

- name: Rolling cordon and drain restart when version changes - servers
  command: "kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data"
  when:
    - rke2_version_changed is defined
    - rke2_version_changed
    - inventory_hostname in groups['rke2_servers']

- name: Rolling cordon and drain restart when version changes - agents
  command: "kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data"
  when:
    - rke2_version_changed is defined
    - rke2_version_changed
    - inventory_hostname in groups['rke2_agents']

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  command: "systemctl restart rke2-server"
  when:
    - config_changed is defined
    - config_changed

- name: Final steps
  debug:
    msg: "Cluster setup complete."


