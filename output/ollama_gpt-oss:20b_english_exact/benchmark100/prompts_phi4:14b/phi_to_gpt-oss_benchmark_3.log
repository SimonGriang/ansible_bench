---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    mode: '0755'

- name: Set server-specific node taints
  set_fact:
    rke2_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Template the RKE2 configuration file
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    mode: '0600'
  notify: Config file changed

- name: Template the kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    mode: '0600'
  when: rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Configure Containerd registry settings
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    mode: '0600'
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
  notify: Config file changed

- name: Gather service facts
  service_facts:

- name: Determine if an etcd restore from a file is necessary
  set_fact:
    do_etcd_restore: >-
      "{{ rke2_etcd_snapshot_file | length > 0 and
         (services['rke2-server.service'].state not in ['running', 'enabled']) }}"
  when: rke2_etcd_snapshot_file | length > 0

- name: Determine if an etcd restore from S3 is necessary
  set_fact:
    do_etcd_restore_from_s3: >-
      "{{ rke2_etcd_snapshot_file | length > 0 and
         rke2_etcd_snapshot_s3_bucket | length > 0 and
         rke2_etcd_snapshot_s3_access_key | length > 0 and
         rke2_etcd_snapshot_s3_secret_key | length > 0 }}"
  when: rke2_etcd_snapshot_file | length > 0

- name: Restore etcd from a snapshot file
  block:
    - name: Create snapshot directory
      file:
        path: /var/lib/rancher/rke2/server/db/restore
        state: directory
        owner: root
        mode: '0755'
    - name: Copy snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/restore/{{ rke2_etcd_snapshot_file }}
        owner: root
        mode: '0600'
    - name: Execute restore command
      command:
        argv:
          - rke2
          - server
          - --restore-snapshot
          - /var/lib/rancher/rke2/server/db/restore/{{ rke2_etcd_snapshot_file }}
      register: restore_file_result
      changed_when: restore_file_result.rc != 0
  when: do_etcd_restore

- name: Restore etcd from an S3 snapshot
  block:
    - name: Execute restore command with S3 options
      command:
        argv:
          - rke2
          - server
          - --restore-snapshot-s3
          - --s3-bucket
          - "{{ rke2_etcd_snapshot_s3_bucket }}"
          - --s3-access-key
          - "{{ rke2_etcd_snapshot_s3_access_key }}"
          - --s3-secret-key
          - "{{ rke2_etcd_snapshot_s3_secret_key }}"
      register: restore_s3_result
      changed_when: restore_s3_result.rc != 0
  when: do_etcd_restore_from_s3

- name: Start the RKE2 server service
  systemd:
    name: rke2-server.service
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask the RKE2 agent service
  service:
    name: rke2-agent.service
    state: stopped
    enabled: false
    masked: true

- name: Wait for the first server to be ready without CNI
  shell: |
    kubectl get nodes -o jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}'
  register: ready_status_no_cni
  until: ready_status_no_cni.stdout == "True"
  retries: 100
  delay: 15
  when: rke2_cni == 'none'

- name: Wait for the first server to be ready with CNI
  shell: |
    kubectl get nodes -o jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}'
  register: ready_status_with_cni
  until: ready_status_with_cni.stdout == "True"
  retries: 40
  delay: 15
  when: rke2_cni != 'none'

- name: Clean up old nodes and secrets if restoring etcd
  shell: |
    OLD_NODES=$(kubectl get nodes -o jsonpath='{.items[*].metadata.name}')
    for NODE in $OLD_NODES; do
      kubectl delete node $NODE --ignore-not-found
      kubectl delete secret -n kube-system \
        $(kubectl get secret -n kube-system -l node-name=$NODE -o name) \
        --ignore-not-found
    done
  when: do_etcd_restore or do_etcd_restore_from_s3

- name: Set the active server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: inventory_hostname in groups[rke2_cluster_group_name]
  delegate_to: "{{ inventory_hostname }}"


