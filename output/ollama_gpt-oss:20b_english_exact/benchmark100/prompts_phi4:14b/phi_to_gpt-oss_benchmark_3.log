---
- name: Update the package manager cache
  apt:
    update_cache: yes
  when: ansible_pkg_mgr == 'apt'
- name: Update the package manager cache
  dnf:
    update_cache: yes
  when: ansible_pkg_mgr == 'dnf'
- name: Install the keepalived package
  package:
    name: keepalived
    state: present
- name: Create the keepalived configuration directory
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: '0755'
- name: Create a Kubernetes API health check script for Debian systems
  template:
    src: check_apiserver.sh.j2
    dest: /etc/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == 'Debian'
  notify: restart keepalived
- name: Create a Kubernetes API health check script for RedHat systems
  template:
    src: check_apiserver.sh.j2
    dest: /usr/libexec/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == 'RedHat'
  notify: restart keepalived
- name: Create an RKE2 Server health check script for Debian systems
  template:
    src: check_rke2server.sh.j2
    dest: /etc/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == 'Debian'
  notify: restart keepalived
- name: Create an RKE2 Server health check script for RedHat systems
  template:
    src: check_rke2server.sh.j2
    dest: /usr/libexec/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == 'RedHat'
  notify: restart keepalived
- name: Create the keepalived configuration file
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: '0644'
  notify: restart keepalived
- name: Enable keepalived service and ensure it is not masked
  systemd:
    name: keepalived
    enabled: yes
    masked: no
    state: started
  notify: restart keepalived
- name: Flush handlers to apply changes
  meta: flush_handlers


