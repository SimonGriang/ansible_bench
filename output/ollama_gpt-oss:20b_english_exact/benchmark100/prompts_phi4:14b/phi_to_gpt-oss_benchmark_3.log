---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install bash package
  ansible.builtin.package:
    name: bash
    state: present

- name: Install OpenJDK package
  ansible.builtin.package:
    name: "{{ java_openjdk_package }}"
    state: present
  environment:
    JAVA_HOME: "/usr/lib/jvm/{{ java_openjdk_package }}"
  when: java_vendor == "openjdk"

- name: Copy Oracle Java RPM package to /tmp and install it
  ansible.builtin.shell: |
    cp "{{ java_local_rpm_path }}" /tmp/"{{ java_local_rpm_name }}"
    yum localinstall -y /tmp/"{{ java_local_rpm_name }}"
  args:
    creates: /tmp/"{{ java_local_rpm_name }}"
  when: java_source_local and java_format == "rpm"

- name: Copy Oracle Java DEB package to /tmp and install it
  ansible.builtin.apt:
    deb: "/tmp/{{ java_local_deb_name }}"
    update_cache: yes
    state: present
  when: java_source_local and java_format == "deb"

- name: Install Oracle Java RPM package from repository
  ansible.builtin.yum:
    name: "{{ java_oracle_package }}"
    state: present
  when: java_source_repo and java_format == "rpm"

- name: >-
    Ensure installation directory exists, install Oracle Java tarball,
    and set permissions
  ansible.builtin.shell: |
    mkdir -p "{{ java_install_dir }}"
    tar -xzf "{{ java_tarball_path }}" -C "{{ java_install_dir }}"
    chmod -R 755 "{{ java_install_dir }}"
  args:
    creates: "{{ java_install_dir }}/bin/java"
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java JCE policy from tarball
  ansible.builtin.shell: |
    mkdir -p "{{ java_install_dir }}/jre/lib/security"
    unzip -o "{{ jce_zip_path }}" -d "{{ java_install_dir }}/jre/lib/security"
  args:
    creates: "{{ java_install_dir }}/jre/lib/security/java.security"
  when: java_version == 8 and jce_enabled and java_vendor == "oracle"

- name: Set Oracle Java as default alternative
  ansible.builtin.alternatives:
    name: java
    path: "{{ java_install_dir }}/bin/java"
    priority: 2000
  when:
    - java_format == "targz"
    - distro != "alpine"
    - java_vendor == "oracle"

- name: Determine JAVA_HOME directory
  ansible.builtin.shell: |
    set -o pipefail
    readlink -f $(which java) | sed 's:/bin/java$::'
  register: java_home_result
  changed_when: false

- name: Set JAVA_HOME environment variable in /etc/profile.d/java_home.sh
  ansible.builtin.lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home_result.stdout }}"
    create: true
    mode: '0644'


