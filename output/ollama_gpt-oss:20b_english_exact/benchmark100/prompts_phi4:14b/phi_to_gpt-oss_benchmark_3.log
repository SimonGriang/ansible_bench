---
- name: Set the desired package state
  ansible.builtin.set_fact:
    package_state: "{{ 'present' if desired_state == 'install' else 'absent' }}"

- name: Setup Ansible on RedHat systems, excluding Fedora, using the package manager
  ansible.builtin.yum:
    name: ansible-core
    state: "{{ package_state }}"
  when:
    - ansible_os_family == 'RedHat'
    - ansible_distribution != 'Fedora'
    - desired_state == 'install'
  tags: install

- name: Setup Ansible on Fedora
  ansible.builtin.dnf:
    name: ansible-core
    state: "{{ package_state }}"
  when:
    - ansible_distribution == 'Fedora'
    - desired_state == 'install'
  tags: install

- name: Setup Ansible on Debian-based systems
  ansible.builtin.apt:
    name: ansible-core
    state: "{{ package_state }}"
  when:
    - ansible_os_family == 'Debian'
    - desired_state == 'install'
  tags: install

- name: Remove Ansible on Debian-based systems
  ansible.builtin.apt:
    name: ansible-core
    state: absent
  when:
    - ansible_os_family == 'Debian'
    - desired_state == 'remove'
  tags: remove

- name: Remove Ansible on RedHat-based systems
  ansible.builtin.yum:
    name: ansible-core
    state: absent
  when:
    - ansible_os_family == 'RedHat'
    - desired_state == 'remove'
  tags: remove

- name: Install the ansible package via pip
  ansible.builtin.pip:
    name: ansible-core
    state: "{{ package_state }}"
  when: desired_state == 'install'
  tags: install


