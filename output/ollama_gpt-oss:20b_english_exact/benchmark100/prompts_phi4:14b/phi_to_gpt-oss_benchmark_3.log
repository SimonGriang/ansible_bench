---
- name: Task 1
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    mode: '0755'
- name: Task 2
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_node_type == 'server'
- name: Task 3
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_node_type == 'agent'
- name: Task 4
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    mode: '0600'
  notify: Config file changed
- name: Task 5
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    mode: '0600'
  when: rke2_kubelet_config is defined and rke2_kubelet_config | length > 0
  notify: Config file changed
- name: Task 6
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    mode: '0600'
  when: rke2_custom_registry_path is defined and rke2_custom_registry_path | length > 0
  notify: Config file changed
- name: Task 7
  service:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  register: rke2_service_result
  until: rke2_service_result is succeeded
  retries: 10
  delay: 3
  notify: Service (re)started
- name: Task 8
  service:
    name: "{{ item }}"
    state: masked
    enabled: no
  loop:
    - rke2-agent.service
    - rke2-server.service
  when: rke2_node_type != item.split('-')[1].split('.')[0]
- name: Task 9
  shell: kubectl get nodes --no-headers | grep -q 'Ready'
  register: node_ready_no_cni
  until: node_ready_no_cni.rc == 0
  retries: 100
  delay: 15
  when: rke2_node_type == 'server' and rke2_is_active_server | default(false)
- name: Task 10
  shell: kubectl get nodes --no-headers | grep -c 'Ready'
  register: node_ready_with_cni
  until: node_ready_with_cni.stdout | int == rke2_expected_node_count
  retries: 100
  delay: 15
  when: rke2_node_type == 'server' and rke2_is_active_server | default(false) and not ansible_check_mode


