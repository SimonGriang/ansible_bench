---
- name: Import the assert.yml file from the localhost and ensure it runs only once
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install the necessary cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure the shell environment for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    state: present
    mode: "0600"
  notify: restart cron service

- name: Configure the PATH environment variable for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    state: present
    mode: "0600"
  notify: restart cron service

- name: Configure the MAILTO environment variable for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    state: present
    mode: "0600"
  notify: restart cron service

- name: Ensure the cron service is started and enabled
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ''

- name: Schedule the specified cron jobs
  cron:
    name: "{{ item.name | default(item) }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    job: "{{ item.job }}"
    user: "{{ item.user | default(omit) }}"
    state: "{{ item.state | default('present') }}"
    cron_file: "{{ item.cron_file | default(omit) }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined


