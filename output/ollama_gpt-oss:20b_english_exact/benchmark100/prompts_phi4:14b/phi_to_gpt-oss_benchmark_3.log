---
- name: Restart the RKE2 service on a specified node.
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again.
  ansible.builtin.shell: |
    set -o pipefail
    kubectl get nodes --no-headers |
    grep -c 'Ready' |
    grep -q '^{{ groups[rke2_cluster_group_name] | length }}$'
  register: result
  delegate_to: "{{ groups['rke2_cluster_group_name'][0] }}"
  run_once: true
  until: result.rc == 0
  retries: 100
  delay: 15
  when: not ansible_check_mode
  changed_when: false

- name: Wait for all pods to be ready again.
  ansible.builtin.shell: |
    set -o pipefail
    kubectl get pods --all-namespaces --no-headers |
    awk '{print $3}' |
    grep -v -E 'Running|Succeeded' |
    wc -l |
    grep -q '^0$'
  register: pod_result
  delegate_to: "{{ groups['rke2_cluster_group_name'][0] }}"
  run_once: true
  until: pod_result.rc == 0
  retries: 100
  delay: 15
  when:
    - rke2_wait_for_all_pods_to_be_ready is defined
    - rke2_wait_for_all_pods_to_be_ready | bool
    - not ansible_check_mode
  changed_when: false


