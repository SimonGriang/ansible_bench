---
- name: Task 1: Create the RKE2 configuration directory with appropriate permissions
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Task 2: Set server node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Task 3: Set agent node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Task 4: Deploy the RKE2 configuration file
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed

- name: Task 5: Deploy the kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  when: rke2_kubelet_config is defined and rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Task 6: Deploy the Containerd registry configuration file
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  when: rke2_custom_registry_path is defined and rke2_custom_registry_path | length > 0
  notify: Config file changed

- name: Task 7: Start the RKE2 service on all nodes
  service:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
    retries: 10
    delay: 3
  notify: Service (re)started

- name: Task 8: Mask other RKE2 services on non-applicable nodes
  service:
    name: "{{ item }}"
    state: masked
    enabled: no
  loop:
    - rke2-agent.service
    - rke2-server.service
  when:
    - rke2_type == 'server' and item == 'rke2-agent.service'
    - rke2_type == 'agent' and item == 'rke2-server.service'

- name: Task 9: Verify node readiness without CNI
  shell: |
    kubectl get nodes --no-headers -o custom-columns=:.status.conditions[?(@.type=="Ready")].status | grep -q True &&
    kubectl get nodes --no-headers -o custom-columns=:.status.conditions[?(@.type=="MemoryPressure")].status | grep -q False &&
    kubectl get nodes --no-headers -o custom-columns=:.status.conditions[?(@.type=="DiskPressure")].status | grep -q False &&
    kubectl get nodes --no-headers -o custom-columns=:.status.conditions[?(@.type=="PIDAvailable")].status | grep -q True &&
    kubectl get nodes --no-headers -o custom-columns=:.status.conditions[?(@.type=="NetworkUnavailable")].status | grep -q False
  register: node_readiness_no_cni
  until: node_readiness_no_cni.rc == 0
  retries: 100
  delay: 15
  when:
    - rke2_type == 'server'
    - (rke2_is_active_server | default(false)) or (rke2_is_first_server | default(false))

- name: Task 10: Verify node readiness with CNI
  shell: |
    kubectl get nodes --no-headers | grep -c 'Ready'
  register: node_readiness_cni
  until: node_readiness_cni.stdout | int == rke2_expected_nodes
  retries: 100
  delay: 15
  when:
    - rke2_type == 'server'
    - (rke2_is_active_server | default(false)) or (rke2_is_first_server | default(false))
    - ansible_check_mode == false



