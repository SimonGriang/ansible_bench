---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/crontab
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
  notify: restart cron

- name: Configure path
  lineinfile:
    path: /etc/crontab
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
  notify: restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/crontab
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
  notify: restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ""

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    job: "{{ item.job }}"
    user: "{{ item.user | default(omit) }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined


