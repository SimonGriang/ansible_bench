---
- name: Determine the package state based on the installation method
  set_fact:
    package_state: >-
      "{{ 'present' if ansible_install_method == 'package' else 'absent' }}"

- name: >-
    Setup Ansible on RedHat systems,
    excluding Fedora, using the package manager
  yum:
    name: ansible
    state: "{{ package_state }}"
  when:
    - ansible_os_family == 'RedHat'
    - ansible_distribution != 'Fedora'
    - ansible_install_method == 'package'

- name: Setup Ansible on Fedora using the package manager
  dnf:
    name: ansible
    state: "{{ package_state }}"
  when:
    - ansible_distribution == 'Fedora'
    - ansible_install_method == 'package'

- name: Setup Ansible on Ubuntu using the package manager
  apt:
    name: ansible
    state: "{{ package_state }}"
    update_cache: true
  when:
    - ansible_distribution == 'Ubuntu'
    - ansible_install_method == 'package'

- name: Setup Ansible on Debian using the package manager
  apt:
    name: ansible
    state: "{{ package_state }}"
    update_cache: true
  when:
    - ansible_distribution == 'Debian'
    - ansible_install_method == 'package'

- name: Setup Ansible using Pip
  pip:
    name: ansible
    state: "{{ package_state }}"
  when:
    - ansible_install_method == 'pip'


