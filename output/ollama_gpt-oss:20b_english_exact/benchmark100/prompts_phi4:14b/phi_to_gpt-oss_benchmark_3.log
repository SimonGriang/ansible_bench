- name: Restart the RKE2 service on a specified node.
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again.
  shell: "kubectl get nodes --no-headers | grep -c 'Ready' | grep -q '^{{ groups[rke2_cluster_group_name]|length }}$'"
