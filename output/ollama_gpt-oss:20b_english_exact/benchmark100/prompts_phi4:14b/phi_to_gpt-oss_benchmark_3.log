---
- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: /etc/rancher/rke2/manifests
    state: directory
    owner: root
    group: root
    mode: '0700'

- name: Copy kube-vip files to the first server
  vars:
    manifest_path: "/etc/rancher/rke2/manifests"
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: >-
      {{ manifest_path }}/{{ item | basename | regex_replace('.j2$', '') }}
    mode: '0664'
  loop: "{{ lookup('fileglob', 'templates/kube-vip-*.j2', wantlist=True) }}"

- name: Copy kube-vip load balancer manifests to the first server
  vars:
    manifest_path: "/etc/rancher/rke2/manifests"
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: >-
      {{ manifest_path }}/{{ item | basename | regex_replace('.j2$', '') }}
    mode: '0664'
  loop: "{{ lookup('fileglob', 'templates/kube-vip-lb-*.j2', wantlist=True) }}"
  when: cloud_provider_enabled | default(false)


