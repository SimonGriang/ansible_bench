---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - set root password
    - daemon-reload

- name: Configure mysql server
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}"
    section: "{{ mysql_name }}"
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    mode: '0644'
  loop: "{{ mysql_configuration_options | dict2items }}"
  notify:
    - set root password
    - daemon-reload

- name: Configure mysql client
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    mode: '0644'

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']
  changed_when: false

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


