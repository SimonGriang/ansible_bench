---
- name: Create user with uid 1000 and home directory /home/{{ user_name }}
  ansible.builtin.user:
    name: "{{ user_name }}"
    uid: 1000
    state: present
    create_home: true
    home: "/home/{{ user_name }}"
    system: false
    groups: "sudo"

- name: Add users with uid 1000 to sudo group
  ansible.builtin.user:
    name: "{{ item.name }}"
    uid: 1000
    state: present
    create_home: true
    home: "{{ item.home }}"
    system: false
    groups: "{{ item.groups }}"
  loop: "{{ users }}"

- name: Ensure sudoers.d entry for each user
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: touch
    mode: "0440"
    owner: root
    group: root
  loop: "{{ users }}"
  when: item.sudo is defined and item.sudo

- name: Remove sudoers.d entry for each user
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: absent
  loop: "{{ users }}"
  when: item.sudo is defined and not item.sudo

- name: Create SSH key for each user
  ansible.builtin.command:
    argv:
      - ssh-keygen
      - -t
      - rsa
      - -b
      - '2048'
      - -f
      - "{{ ssh_keys_dir }}/{{ item.name }}"
      - -N
      - ''
      - -q
    creates: "{{ ssh_keys_dir }}/{{ item.name }}"
  loop: "{{ users }}"

- name: Create public key file for each user
  ansible.builtin.command:
    argv:
      - sh
      - -c
      - |
        cat {{ ssh_keys_dir }}/{{ item.name }}.pub \
          > {{ ssh_keys_dir }}/{{ item.name }}.pub
    creates: "{{ ssh_keys_dir }}/{{ item.name }}.pub"
  loop: "{{ users }}"

- name: Ensure public key file for each user
  ansible.builtin.command:
    argv:
      - sh
      - -c
      - |
        cat {{ ssh_keys_dir }}/{{ item.name }}.pub \
          > {{ ssh_keys_dir }}/{{ item.name }}.pub
    creates: "{{ ssh_keys_dir }}/{{ item.name }}.pub"
  loop: "{{ users }}"

- name: Set password validity period for users if a specific duration is defined
  ansible.builtin.set_fact:
    password_validity: >-
      {{ user_passwords[item.name] | default(0) | int + (
          item.password_validity_days | int
      ) }}
  loop: "{{ users }}"

- name: Create authorized_keys file for each user
  ansible.builtin.file:
    path: "/home/{{ item.name }}/.ssh/authorized_keys"
    state: touch
    mode: "0600"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
  loop: "{{ users }}"
  when: item.ssh_key is defined and item.ssh_key

- name: Add public key to authorized_keys for each user
  ansible.builtin.file:
    path: "/home/{{ item.name }}/.ssh/authorized_keys"
    state: touch
    mode: "0600"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
