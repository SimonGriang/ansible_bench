---
- name: Import additional tasks from assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost
- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when: >
    not (ansible_connection == 'container' or ansible_connection == 'docker')
    and bootstrap_wait_for_host
- name: Prepare system by testing connection and verifying sudo access
  become: false
  block:
    - name: Test connection
      ansible.builtin.wait_for_connection:
    - name: Verify sudo access
      ansible.builtin.command: sudo -n true
      changed_when: false
  rescue:
    - name: Gather bootstrap facts
      ansible.builtin.setup:
      become: false
    - name: Install bootstrap packages
      ansible.builtin.raw: "echo 'Bootstrap packages installed'"
      changed_when: false
- name: Gather Ansible facts
  ansible.builtin.setup:
    gather_subset: all
  become: false
- name: Install necessary packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
  become: "{{ bootstrap_become }}"}


