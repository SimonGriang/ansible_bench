---
- name: Migrate the Java JDK vendor from adoptopenjdk to temurin if selected
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Gather OS-specific variables for the Java JDK
  include_vars:
    first_found:
      files:
        - "java-{{ java_jdk_vendor }}-{{ ansible_distribution | lower }}-{{ ansible_distribution_version | replace('.', '') }}.yml"
        - "java-{{ java_jdk_vendor }}-{{ ansible_distribution | lower }}.yml"
        - "java-{{ java_jdk_vendor }}.yml"

- name: Gather architecture-specific variables for the Java JDK
  include_vars:
    first_found:
      files:
        - "java-{{ java_jdk_vendor }}-{{ ansible_architecture }}.yml"
        - "java-{{ java_jdk_vendor }}.yml"

- name: Set OS-specific Java variables
  set_fact:
    java_package_os: "{{ java_package_os | default(java_package) }}"
  when: java_package_os is not defined or java_package_os == None

- name: Set OS and architecture-specific Java variables
  set_fact:
    java_package_os_arch: "{{ java_package_os_arch | default(java_package_os) }}"
  when: java_package_os_arch is not defined or java_package_os_arch == None

- name: Set specific Java variables
  set_fact:
    java_home: "/usr/lib/jvm/java-{{ java_version }}"

- name: Handle Debian pre-requisites for Java installation
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: 'ppa:debian/old-repo'
        state: absent
    - name: Install extra packages
      apt:
        name:
          - apt-transport-https
          - ca-certificates
        state: present
        update_cache: yes
    - name: Add key repository
      apt_key:
        url: https://packages.adoptium.net/apt/key.gpg
        state: present
    - name: Add required repository
      apt_repository:
        repo: "deb https://packages.adoptium.net/apt/$(lsb_release -cs) main"
        state: present
  when: ansible_os_family == 'Debian'

- name: Handle RedHat pre-requisites for Java installation
  block:
    - name: Add key repository
      rpm_key:
        key: https://packages.adoptium.net/centos/$releasever/$(arch)/gpg
        state: present
    - name: Add required repository
      yum_repository:
        name: adoptium
        description: AdoptOpenJDK
        baseurl: https://packages.adoptium.net/centos/$releasever/$(arch)/main
        gpgcheck: yes
        gpgkey: https://packages.adoptium.net/centos/$releasever/$(arch)/gpg
  when: ansible_os_family == 'RedHat'

- name: Install required libraries for Java
  package:
    name:
      - libx11-6
      - libxext6
    state: present

- name: Install Java on Debian systems
  apt:
    name: "{{ java_package }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'Debian'

- name: Install Java on RedHat systems
  yum:
    name: "{{ java_package }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'RedHat'

- name: Export Java environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0755'

- name: Source Java environment variables
  shell: source /etc/profile.d/jdk.sh
  args:
    executable: /bin/bash

- name: Correct Java version selection for versions less than 11 on Debian systems
  alternatives:
    name: java
    path: "/usr/lib/jvm/java-{{ java_version }}-openjdk-amd64/bin/java"
    priority: 1
  when:
    - ansible_os_family == 'Debian'
    - java_version | int < 11

- name: Correct Java version selection for versions 11 or greater on Debian systems
  alternatives:
    name: java
    path: "/usr/lib/jvm/java-{{ java_version }}-openjdk-amd64/bin/java"
    priority: 1
  when:
    - ansible_os_family == 'Debian'
    - java_version | int >= 11


