---
- name: "Generate SSL private key files for each item"
  community.crypto.openssl_privatekey:
    path: "{{ item.key_path }}"
    mode: "{{ item.permissions }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"
- name: "Generate SSL CSR (Certificate Signing Request) files for each item"
  community.crypto.openssl_csr:
    path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    common_name: "{{ item.common_name }}"
    mode: "{{ item.permissions }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"
- name: "Generate SSL certificates for each item"
  community.crypto.x509_certificate:
    path: "{{ item.cert_path }}"
    csr_path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    mode: "{{ item.permissions }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"
- name: "Create PKCS#12 files for each item"
  community.crypto.openssl_pkcs12:
    path: "{{ item.pkcs12_path }}"
    privatekey_path: "{{ item.key_path }}"
    certificate_path: "{{ item.cert_path }}"
    friendly_name: "{{ item.friendly_name }}"
    mode: "{{ item.permissions }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"
- name: "Read and register the content of the private key files for each item"
  ansible.builtin.slurp:
    src: "{{ item.key_path }}"
  register: private_key_contents
  loop: "{{ ssl_items }}"
- name: "Read and register the content of the certificate files for each item"
  ansible.builtin.slurp:
    src: "{{ item.cert_path }}"
  register: certificate_contents
  loop: "{{ ssl_items }}"
- name: "Combine private key and certificate content into a single file"
  ansible.builtin.copy:
    dest: "{{ item.combined_path }}"
    content: |
      {{ private_key_contents.results[loop.index0].content | b64decode }}
      {{ certificate_contents.results[loop.index0].content | b64decode }}
    mode: "{{ item.permissions }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"


