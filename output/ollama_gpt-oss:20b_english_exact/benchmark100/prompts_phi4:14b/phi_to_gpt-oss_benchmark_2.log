---
- name: Import assert tasks
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages for sysctl
  ansible.builtin.package:
    name: "{{ sysctl_requirements }}"
    state: present

- name: Configure sysctl settings
  ansible.posix.sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    reload: "{{ sysctl_reload | bool }}"
  loop: "{{ sysctl_items }}"
  loop_control:
    label: "{{ item.name }}"
  when: >
    sysctl_set | bool
    and (
      ansible_virtualization_type is not defined
      or ansible_virtualization_type not in ['docker', 'lxc', 'container']
    )
    and item.name is defined
    and item.value is defined


