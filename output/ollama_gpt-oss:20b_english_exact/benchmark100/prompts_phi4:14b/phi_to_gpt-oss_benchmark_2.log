---
- name: Import assert.yml tasks file to be executed once on the localhost
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required software packages based on the users_requirements variable
  package:
    name: "{{ users_requirements }}"
    state: present
  when: users_requirements | length > 0

- name: Loop through the users_groups variable and include tasks from group.yml for each group
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item }}"

- name: Ensure the /etc/sudoers file includes the /etc/sudoers.d directory
  lineinfile:
    path: /etc/sudoers
    line: '@includedir /etc/sudoers.d'
    regexp: '^@includedir /etc/sudoers.d'
    validate: 'visudo -cf %s'

- name: Loop through the users variable and include tasks from user.yml for each user
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item }}"

- name: Manage cron permissions by creating or updating /etc/cron.allow with a template
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow

- name: Remove the /etc/cron.allow file if cron permissions are not required
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


