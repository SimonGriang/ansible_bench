- name: Remove the "externally managed" file from the /etc/apt/apt.conf.d/ directory on Debian 12.
  file:
    path: /etc/apt/apt.conf.d/externally-managed
    state: absent
  when: ansible_distribution == 'Debian' and ansible_distribution_version is version('12', '==')

- name: Ensure that Pip is installed on the target system.
  package:
    name: "{{ pip_package }}"
    state: present

- name: Ensure the `python3-packaging` package is installed using dnf.
  dnf:
    name: python3-packaging
    state: present
  when: ansible_pkg_mgr == 'dnf'

- name: Install specified Python packages using Pip.
  pip:
    name: "{{ pip_install_packages }}"
    state: present


