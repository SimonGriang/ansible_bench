---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages for OpenSSL
  package:
    name: "{{ openssl_requirements }}"
    state: present

- name: Install pip packages
  pip:
    name: "{{ openssl_pip_packages }}"
    state: present
  when: openssl_pip_packages is defined and openssl_pip_packages | length > 0

- name: Create a directory for OpenSSL keys
  file:
    path: "{{ openssl_key_dir }}"
    state: directory
    mode: '0700'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create a directory for OpenSSL Certificate Signing Requests (CSRs)
  file:
    path: "{{ openssl_csr_dir }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create a directory for OpenSSL certificates
  file:
    path: "{{ openssl_cert_dir }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include the create.yml task file for each item in openssl_items
  include_tasks: create.yml
  loop: "{{ openssl_items }}"
  when: openssl_items is defined and openssl_items | length > 0


