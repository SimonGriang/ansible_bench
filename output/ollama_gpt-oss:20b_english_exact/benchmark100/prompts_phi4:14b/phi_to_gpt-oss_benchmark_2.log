---
- name: Ensure group is managed
  ansible.builtin.group:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    gid: "{{ item.gid | default(omit) }}"
    system: "{{ item.system | default(omit) }}"
  loop: "{{ groups }}"
  loop_control:
    label: "{{ item.name }}"

- name: Configure sudo options for a specific group using a template
  ansible.builtin.template:
    src: sudo_group.j2
    dest: "/etc/sudoers.d/{{ item.name | replace('.', 'dot') }}"
    mode: "0640"
    validate: "visudo -cf %s"
  when: item.sudo_options is defined
  loop: "{{ groups }}"
  loop_control:
    label: "{{ item.name }}"


