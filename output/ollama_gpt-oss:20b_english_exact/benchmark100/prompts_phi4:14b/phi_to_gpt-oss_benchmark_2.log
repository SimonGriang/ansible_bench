---
- name: Ensure the directory /etc/openvpn/easy-rsa exists with appropriate permissions
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'
  become: true

- name: Initialize the PKI directory using EasyRSA
  command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Build a CA certificate using EasyRSA without a passphrase
  command: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Generate a Diffie-Hellman parameters file using EasyRSA
  command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Build a server certificate using EasyRSA without a passphrase
  command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Build a client certificate using EasyRSA without a passphrase
  command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Generate a Certificate Revocation List using EasyRSA
  command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Generate a TLS auth key using OpenVPN
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  become: true

- name: Copy necessary EasyRSA files to /etc/openvpn/server
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item.src }}
    dest: /etc/openvpn/server/{{ item.dest }}
    mode: "{{ item.mode }}"
  loop:
    - { src: 'ca.crt', dest: 'ca.crt', mode: '0644' }
    - { src: 'dh.pem', dest: 'dh.pem', mode: '0644' }
    - { src: 'ta.key', dest: 'ta.key', mode: '0600' }
    - { src: 'server.crt', dest: 'server.crt', mode: '0644' }
    - { src: 'server.key', dest: 'server.key', mode: '0600' }
    - { src: 'client.crt', dest: 'client.crt', mode: '0644' }
    - { src: 'client.key', dest: 'client.key', mode: '0600' }
  become: true

- name: Copy necessary EasyRSA files to /etc/openvpn
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item.src }}
    dest: /etc/openvpn/{{ item.dest }}
    mode: "{{ item.mode }}"
  loop:
    - { src: 'ca.crt', dest: 'ca.crt', mode: '0644' }
    - { src: 'ta.key', dest: 'ta.key', mode: '0600' }
  become: true

- name: Deploy the OpenVPN server configuration file
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server/server.conf
    owner: root
    group: root
    mode: '0644'
  notify: restart openvpn
  become: true


