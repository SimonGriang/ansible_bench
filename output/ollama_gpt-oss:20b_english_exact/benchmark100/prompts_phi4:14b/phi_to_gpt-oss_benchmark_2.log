---
- name: >-
    Task 1: Collect the OS release information from the bootstrap server without
    making changes.
  command: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_user }}"

- name: >-
    Task 2: Set bootstrap facts for distribution and major version.
  set_fact:
    bootstrap_distribution: >-
      {{ bootstrap_facts.stdout | regex_findall('PRETTY_NAME=\"([^\"]+)\"') |
      first | regex_replace('^([a-zA-Z]+) .*$', '\\1') }}
    bootstrap_distribution_major_version: >-
      {{ bootstrap_facts.stdout | regex_findall('PRETTY_NAME=\"([^\"]+)\"') |
      first | regex_replace('^.* ([0-9]+).*$', '\\1') }}
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - >-
        bootstrap_facts.stdout | regex_findall('PRETTY_NAME=\"([^\"]+)\"') |
        length > 0
    - >-
        (bootstrap_facts.stdout | regex_findall('PRETTY_NAME=\"([^\"]+)\"') |
         first | regex_replace('^([a-zA-Z]+) .*$', '\\1')) in bootstrap__os_family_map
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user }}"

- name: >-
    Task 3: Set bootstrap facts for the OS family.
  set_fact:
    bootstrap_os_family: >-
      {{ bootstrap__os_family_map[bootstrap_distribution] | default('Unknown') }}
  when: bootstrap_distribution is defined
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user }}"



