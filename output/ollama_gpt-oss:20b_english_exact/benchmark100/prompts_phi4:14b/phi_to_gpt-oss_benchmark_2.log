- name: Create authorized_keys file for each user
  file:
    path: "/home/{{ item.name }}/.ssh/authorized_keys"
    state: touch
    mode: "0600"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
  loop: "{{ users }}"
  when: item.ssh_key is defined and item.ssh_key == true

- name: Add public key to authorized_keys for each user
  file:
    path: "/home/{{ item.name }}/.ssh/authorized_keys"
    state: touch
    mode: "0600"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
  loop: "{{ users }}"
  when: item.ssh_key is defined and item.ssh_key == true

- name: Remove authorized_keys file for each user
  file:
    path: "/home/{{ item.name }}/.ssh/authorized_keys"
    state: absent
  loop: "{{ users }}"
  when: item.ssh_key is defined and item.ssh_key == false

- name: Copy public key to each user
  copy:
    src: "{{ ssh_keys_dir }}/{{ item.name }}.pub"
    dest: "/home/{{ item.name }}/.ssh/authorized_keys"
    mode: "0600"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
  loop: "{{ users }}"
  when: item.ssh_key is defined and item.ssh_key == true

- name: Ensure password expires after a specific number of days
  shell: |
    grep 'Password expires'
  loop: "{{ users }}"

- name: Set password validity period for users if a specific duration is defined
  set_fact:
    password_validity: >-
      {{ user_passwords[item.name] | default(0) | int + (
          item.password_validity_days | int
      ) }}
  loop: "{{ users }}"

- name: Copy public key to each user
  copy:
    src: "{{ ssh_keys_dir }}/{{ item.name }}.pub"
    dest: "/home/{{ item.name }}/.ssh/authorized_keys"
    mode: "0600"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
  loop: "{{ users }}"
  when: item.ssh_key is defined and item.ssh_key == true


