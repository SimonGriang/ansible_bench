---
- name: Download RKE2 installation script if not in airgap mode
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0755'
    timeout: 60
  when: not rke2_airgap_mode

- name: Copy local RKE2 installation script if in airgap mode
  copy:
    src: "{{ rke2_local_install_script }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0755'
    force: yes
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'copy'

- name: Create RKE2 artifacts folder if in airgap mode and the implementation is not 'exists'
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: '0755'
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation != 'exists'

- name: Download RKE2 checksum and artifacts with a fallback mechanism for airgap mode using the 'download' method
  block:
    - name: Download checksum file
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_artifacts_dir }}/checksum.txt"
        mode: '0644'
        timeout: 60
    - name: Download artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}/{{ item }}"
        dest: "{{ rke2_artifacts_dir }}/{{ item }}"
        mode: '0644'
        timeout: 60
      loop: "{{ rke2_artifact_files }}"
  rescue:
    - name: Copy checksum file from local
      copy:
        src: "{{ rke2_local_checksum_file }}"
        dest: "{{ rke2_artifacts_dir }}/checksum.txt"
        mode: '0644'
        force: yes
    - name: Copy artifacts from local
      copy:
        src: "{{ rke2_local_artifacts_dir }}/{{ item }}"
        dest: "{{ rke2_artifacts_dir }}/{{ item }}"
        mode: '0644'
        force: yes
      loop: "{{ rke2_artifact_files }}"
  when: rke2_airgap_mode

- name: Copy local RKE2 artifacts if in airgap mode using the 'copy' method
  copy:
    src: "{{ rke2_local_artifacts_dir }}/{{ item }}"
    dest: "{{ rke2_artifacts_dir }}/{{ item }}"
    mode: '0644'
    force: yes
  loop: "{{ rke2_artifact_files }}"
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'copy'

- name: Handle additional tarballs in airgap mode if not using 'exists' implementation
  block:
    - name: Create directory for additional tarballs
      file:
        path: "{{ rke2_additional_tarballs_dir }}"
        state: directory
        mode: '0755'
    - name: Copy additional tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_additional_tarballs_dir }}/{{ item | basename }}"
        mode: '0644'
        force: yes
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation != 'exists'
    - rke2_airgap_copy_additional_tarballs | length > 0

- name: Ensure artifacts exist and have acceptable permissions in airgap mode with 'exists' implementation
  block:
    - name: Ensure artifact files exist
      file:
        path: "{{ rke2_artifacts_dir }}/{{ item }}"
        state: file
        mode: '0644'
      loop: "{{ rke2_artifact_files }}"
    - name: Ensure installation script is executable
      file:
        path: "{{ rke2_install_script_path }}"
        state: file
        mode: '0755'
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == 'exists'

- name: Populate service facts to gather information about system services
  service_facts:

- name: Get filesystem statistics for the /usr/local directory
  command: "stat -f -c '%s %i' /usr/local"
  register: usr_local_stat

- name: Check if /usr/local is on a separate partition
  command: "grep -w '/usr/local' /proc/mounts"
  register: usr_local_mount
  ignore_errors: true

- name: Set flag for separate partition
  set_fact:
    usr_local_on_separate_partition: "{{ usr_local_mount.rc == 0 }}"

- name: Determine the RKE2 binary path based on filesystem checks
  set_fact:
    rke2_bin_path: >-
      {% if usr_local_on_separate_partition or not usr_local_stat.stat.isdir %}
      {{ rke2_bin_path_local }}
      {% else %}
      {{ rke2_bin_path_default }}
      {% endif %}

- name: Check the installed and running RKE2 versions
  block:
    - name: Get installed RKE2 version
      command: "{{ rke2_bin_path }} --version"
      register: rke2_installed_version
    - name: Check if RKE2 service is active
      command: "systemctl is-active rke2-server"
      register: rke2_service_status
      ignore_errors: true
    - name: Set RKE2 version info
      set_fact:
        rke2_version_info:
          installed: "{{ rke2_installed_version.stdout }}"
          running: "{{ rke2_service_status.rc == 0 }}"
  register: rke2_version_check

- name: Set RKE2 version facts based on the version check results
  set_fact:
    rke2_installed_version: "{{ rke2_version_check.result.rke2_version_info.installed }}"
    rke2_running_version: "{{ rke2_version_check.result.rke2_version_info.running }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade unless explicitly allowed
  assert:
    that:
      - rke2_desired_version is version(rke2_running_version, '>=')
      - rke2_allow_downgrade | bool
    fail_msg: "Downgrade of RKE2 is not allowed without explicit permission."

- name: Run RKE2 install script if the version needs to be updated
  block:
    - name: Install RKE2
      command: "{{ rke2_install_script_path }} install --yes"
      environment:
        PATH: "/usr/local/bin:/usr/bin"
      register: rke2_install_result
  when:
    - rke2_desired_version != rke2_installed_version

- name: Copy custom manifests if they are defined
  copy:
    src: "{{ item }}"
    dest: "/etc/rancher/rke2/custom-manifests/{{ item | basename }}"
    mode: '0644'
    force: yes
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy static pods if they are defined
  copy:
    src: "{{ item }}"
    dest: "/var/lib/rancher/rke2/agent/pod-manifests/{{ item | basename }}"
    mode: '0644'
    force: yes
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file if environment options are defined
  copy:
    src: "{{ rke2_env_file_local }}"
    dest: "/etc/rancher/rke2/rke2.env"
    mode: '0644'
    force: yes
  when: rke2_env_options | length > 0


