- name: |
    Gather bootstrap facts by reading the `/etc/os-release` file
    without privilege escalation
  raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: |
    Set bootstrap distribution and major version facts
    based on the gathered information
  set_fact:
    bootstrap_distribution: |
      "{{ bootstrap_os_family_map[
        bootstrap_facts.stdout.split('PRETTY_NAME=')[1].split(' ')[0]
      ] | default(bootstrap_distribution) }}"
    bootstrap_distribution_major_version: |
      "{{ bootstrap_facts.stdout | regex_search(
        'VERSION_ID=\"?([0-9]+)', '\\1'
      ) | default(bootstrap_distribution_major_version) }}"
  when: |
    bootstrap_facts.rc == 0 and
    bootstrap_distribution is not defined and
    bootstrap_search[
      bootstrap_facts.stdout.split('PRETTY_NAME=')[1].split(' ')[0]
    ] is defined
  changed_when: false

- name: |
    Determine and set the bootstrap OS family based on distribution
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"
  when: item.value is search(bootstrap_distribution)
  changed_when: false


