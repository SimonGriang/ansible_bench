' and ansible_facts['yum_version'] != '6'\n\n- name: Update all zypper packages to latest state\n  zypper:\n    name: '*'\n    state: latest\n  notify: Reboot\n  when: ansible_pkg_mgr == 'zypper'" additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-15T04:43:52.53667074Z', 'done': True, 'done_reason': 'stop', 'total_duration': 38825488926, 'load_duration': 157252636, 'prompt_eval_count': 632, 'prompt_eval_duration': 462863696, 'eval_count': 3784, 'eval_duration': 38204591453, 'model_name': 'gpt-oss:20b'} id='run--593aefb7-ef49-4372-815b-0ccc3a7a3583-0' usage_metadata={'input_tokens': 632, 'output_tokens': 3784, 'total_tokens': 4416}
