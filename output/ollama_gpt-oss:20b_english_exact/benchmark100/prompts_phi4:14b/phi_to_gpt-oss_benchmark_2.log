- name: Copy Nginx config
  template:
    src:{{httpd_vhosts_directory}}/{{item.servername|default(item.name)}}.conf
    dest:{{httpd_vhosts_directory}}/{{item.servername|default(item.name)}}.conf
    mode: "0644"
