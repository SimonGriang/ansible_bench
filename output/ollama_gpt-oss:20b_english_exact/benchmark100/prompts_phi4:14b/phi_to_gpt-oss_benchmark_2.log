---
- name: Download the RKE2 kubeconfig file to a specified path on localhost
  ansible.builtin.fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: |-
      {{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}
    flat: true
  delegate_to: localhost
  when:
    - rke2_download_kubeconf | bool
    - inventory_hostname == groups[rke2_servers_group_name][0]

- name: |
    Replace loopback IP addresses in the downloaded kubeconfig file
    with the master server IP
  ansible.builtin.replace:
    path: |-
      {{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}
    regexp: '127\.0\.0\.1|\[::1\]'
    replace: >-
      {{ rke2_api_ip | default(
      hostvars[groups[rke2_servers_group_name][0]]
      .ansible_default_ipv4.address) }}
    mode: '0600'
  delegate_to: localhost
  when:
    - not ansible_check_mode
    - rke2_download_kubeconf
    - inventory_hostname == groups[rke2_servers_group_name][0]


