---
- name: >-
    Remove the "externally managed" file from the /etc/apt/apt.conf.d/
    directory on Debian 12.
  ansible.builtin.file:
    path: /etc/apt/apt.conf.d/externally-managed
    state: absent
  when:
    - ansible_distribution == 'Debian'
    - ansible_distribution_version is version('12', '==')

- name: Ensure that Pip is installed on the target system.
  ansible.builtin.package:
    name: "{{ pip_package }}"
    state: present

- name: Ensure the `python3-packaging` package is installed using dnf.
  ansible.builtin.dnf:
    name: python3-packaging
    state: present
  when: ansible_pkg_mgr == 'dnf'

- name: Install specified Python packages using Pip.
  ansible.builtin.pip:
    name: "{{ pip_install_packages }}"
    state: present


