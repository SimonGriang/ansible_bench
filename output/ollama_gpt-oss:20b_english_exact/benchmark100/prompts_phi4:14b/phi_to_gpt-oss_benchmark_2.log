---
- name: Create user with uid 1000 and home directory /home/{{ user_name }}
  user:
    name: "{{ user_name }}"
    uid: 1000
    state: present
    create_home: true
    home: "/home/{{ user_name }}"
    system: false
    groups: "sudo"

- name: >-
    Add users with uid 1000 and home directory /home/{{ user_name }} to sudo group
  user:
    name: "{{ item.name }}"
    uid: 1000
    state: present
    create_home: true
    home: "{{ item.home }}"
    system: false
    groups: "{{ item.groups }}"
  loop: "{{ users }}"

- name: >-
    Ensure sudoers.d entry for each user
  file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: touch
    mode: "0440"
    owner: root
    group: root
  loop: "{{ users }}"
  when: item.sudo is defined and item.sudo == true

- name: >-
    Remove sudoers.d entry for each user
  file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: absent
  loop: "{{ users }}"
  when: item.sudo is defined and item.sudo == false

- name: Create SSH key for each user
  command: |
    ssh-keygen -t rsa -b 2048 -f {{ ssh_keys_dir }}/{{ item.name }} -N "" -q
  creates: "{{ ssh_keys_dir }}/{{ item.name }}"
  loop: "{{ users }}"

- name: Create public key file for each user
  command: |
    cat {{ ssh_keys_dir }}/{{ item.name }}.pub > \
        {{ ssh_keys_dir }}/{{ item.name }}.pub
  creates: "{{ ssh_keys_dir }}/{{ item.name }}.pub"
  loop: "{{ users }}"

- name: Ensure public key file for each user
  command: |
    cat {{ ssh_keys_dir }}/{{ item.name }}.pub > \
        {{ ssh_keys_dir }}/{{ item.name }}.pub
  creates: "{{ ssh_keys_dir }}/{{ item.name }}.pub"
  loop: "{{ users }}"

- name: >-
    Set password validity period for users if a specific duration is defined
  set_fact:
    password_validity: >-
      {{ user_passwords[item.name] | default(0) | int + (
          item.password_validity_days | int
      ) }}
  loop: "{{ users }}"

- name: >-
    Create authorized_keys file for each user
  file:
    path: "/home/{{ item.name }}/.ssh/authorized_keys"
    state: touch
    mode: "0600"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
  loop: "{{ users }}"
  when: item.ssh_key is defined and item.ssh_key == true

- name: >-
    Add public key to authorized_keys for each user
  file:
    path: "/home/{{ item.name }}/.ssh/authorized_keys"
    state: touch
    mode: "0600"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
  loop: "{{ users }}"
  when: item.ssh_key is defined and item.ssh_key == true

- name: >-
    Remove authorized_keys file for each user
  file:
    path: "/home/{{ item.name }}/.ssh/authorized_keys"
    state: absent
  loop: "{{ users }}"
  when: item.ssh_key is defined and item.ssh_key == false

- name: >-
    Copy public key to each user
  copy:
    src: "{{ ssh_keys_dir }}/{{ item.name }}.pub"
    dest: "/home/{{ item.name }}/.ssh/authorized_keys"
    mode: "0600"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
  loop: "{{ users }}"
  when: item.ssh_key is defined and item.ssh_key == true

- name: >-
    Ensure password expires after a specific number of days
  shell: |
    grep 'Password expires'
  loop: "{{ users }}"

- name: >-
    Set password validity period for users if a specific duration is defined
  set_fact:
    password_validity: >-
      {{ user_passwords[item.name] | default(0) | int + (
          item.password_validity_days | int
      ) }}
  loop: "{{ users }}"

- name: >-
    Copy public key to each user
  copy:
    src: "{{ ssh_keys_dir }}/{{ item.name }}.pub"
    dest: "/home/{{ item.name }}/.ssh/authorized_keys"
    mode: "0600"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
  loop: "{{ users }}"
  when: item.ssh_key is defined and item.ssh_key == true


