---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install the git package
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if the specified git user exists in the system
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: git_user
  failed_when: false

- name: Create a directory for the git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    mode: "0755"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when: git_user.found

- name: Place the git configuration file
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    mode: "0644"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when: git_user.found

- name: Create the repository destination directory
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    mode: "0755"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when: git_user.found and git_repository_destination is defined

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: >-
      {{ git_repository_destination }}/{{ item.name |
      default(item.repo | basename) }}
    version: "{{ item.version | default(omit) }}"
    accept_hostkey: true
    force: "{{ item.force | default(false) | bool }}"
  become: true
  become_user: "{{ git_username }}"
  loop: "{{ git_repositories }}"
  when: git_user.found and git_repository_destination is defined


