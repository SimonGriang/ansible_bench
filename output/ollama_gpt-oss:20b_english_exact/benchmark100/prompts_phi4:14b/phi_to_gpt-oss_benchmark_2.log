---
- name: "Task 1: Import the assert.yml file to be executed once on the localhost."
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: "Task 2: Configure apk package manager."
  when: ansible_pkg_mgr == 'apk'
  block:
    - name: Update apk package cache
      ansible.builtin.command: apk update
      changed_when: false
    - name: Upgrade all apk packages
      ansible.builtin.command: apk upgrade
      notify: reboot

- name: "Task 3: Configure apt package manager."
  when: ansible_pkg_mgr == 'apt'
  block:
    - name: Hold selected packages
      apt:
        pkg: "{{ apt_hold_packages }}"
        state: present
        hold: yes
      when: apt_hold_packages is defined
    - name: Update apt cache
      ansible.builtin.command: apt update
      changed_when: false
    - name: Upgrade all apt packages
      ansible.builtin.command: apt upgrade -y
      notify: reboot
    - name: Autoremove apt packages
      ansible.builtin.command: apt autoremove -y
      when: apt_autoremove | default(false)
      notify: reboot

- name: "Task 4: Update all software using dnf package manager."
  when: ansible_pkg_mgr in ['dnf', 'dnf5']
  block:
    - name: Update dnf packages
      ansible.builtin.dnf:
        name: '*'
        state: latest
        exclude: "{{ dnf_exclude_packages }}"
        update_cache: yes
      notify: reboot

- name: "Task 5: Update all software using pacman package manager."
  when: ansible_pkg_mgr == 'pacman'
  block:
    - name: Update pacman packages
      pacman:
        update_cache: yes
        upgrade: yes
      notify: reboot

- name: "Task 6: Configure yum package manager."
  when: ansible_pkg_mgr == 'yum'
  block:
    - name: Yum update for version 6
      when: ansible_distribution_major_version == '6'
      yum:
        name: '*'
        state: latest
      notify: reboot
    - name: Yum update for other versions
      when: ansible_distribution_major_version != '6'
      yum:
        name: '*'
        state: latest
      notify: reboot
    - name: Install yum-utils for other versions
      when: ansible_distribution_major_version != '6'
      yum:
        name: yum-utils
        state: present

- name: "Task 7: Update all software using zypper package manager."
  when: ansible_pkg_mgr == 'zypper'
  block:
    - name: Update zypper packages
      zypper:
        name: '*'
        state: latest
      notify: reboot


