---
- name: Task 1: Create a directory for SSH keys if user management is enabled
  file:
    path: "{{ ssh_keys_dir }}"
    state: directory
    mode: "0700"
  when: user_management_enabled | default(false)

- name: Task 2: Manage user accounts, ensuring they are created or updated with specified parameters
  user:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    comment: "{{ item.comment | default(omit) }}"
    home: "{{ item.home | default(omit) }}"
    shell: "{{ item.shell | default(omit) }}"
    groups: "{{ item.groups | default(omit) }}"
  loop: "{{ users }}"
  register: user_result

- name: Task 3: Set sudo privileges for users if specified in their configuration
  template:
    src: "templates/sudoers.j2"
    dest: "/etc/sudoers.d/{{ item.name }}"
    mode: "0440"
  loop: "{{ users }}"
  when: item.sudo_options is defined

- name: Task 4: Remove sudo privileges for users if not specified in their configuration
  file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: absent
  loop: "{{ users }}"
  when: item.sudo_options is not defined

- name: Task 5: Generate a private SSH key for users who require SSH key management
  command: "ssh-keygen -t rsa -b 2048 -f {{ ssh_keys_dir }}/{{ item.name }}.pem -N ''"
  loop: "{{ users }}"
  when: item.ssh_key_management is defined and item.ssh_key_management
  creates: "{{ ssh_keys_dir }}/{{ item.name }}.pem"

- name: Task 6: Generate a public SSH key for users who require SSH key management
  command: "ssh-keygen -y -f {{ ssh_keys_dir }}/{{ item.name }}.pem > {{ ssh_keys_dir }}/{{ item.name }}.pub"
  loop: "{{ users }}"
  when: item.ssh_key_management is defined and item.ssh_key_management
  creates: "{{ ssh_keys_dir }}/{{ item.name }}.pub"

- name: Task 7: Convert the SSH key to a PPK format for users who require SSH key management
  command: "puttygen {{ ssh_keys_dir }}/{{ item.name }}.pem -O private -o {{ ssh_keys_dir }}/{{ item.name }}.ppk"
  loop: "{{ users }}"
  when: item.ssh_key_management is defined and item.ssh_key_management
  creates: "{{ ssh_keys_dir }}/{{ item.name }}.ppk"

- name: Task 8: Determine the home directory for users, defaulting to /home if the user is not found
  set_fact:
    user_homes: "{{ user_homes | default({}) | combine({ (item.name): (ansible_facts.getent_passwd[item.name] is defined) | ternary(ansible_facts.getent_passwd[item.name][4], '/home') }) }}"
  loop: "{{ users }}"

- name: Task 9: Create an .ssh directory in the user's home directory if SSH key management is enabled or private keys need to be set
  file:
    path: "{{ user_homes[item.name] }}/.ssh"
    state: directory
    mode: "0700"
  loop: "{{ users }}"
  when: item.ssh_key_management is defined and item.ssh_key_management or item.copy_private_key is defined

- name: Task 10: Deploy authorized SSH keys for users if specified
  authorized_key:
    user: "{{ item.name }}"
    state: present
    key: "{{ item.authorized_keys | join('\n') }}"
  loop: "{{ users }}"
  when: item.authorized_keys is defined

- name: Task 11: Remove unauthorized SSH keys from users if specified
  authorized_key:
    user: "{{ item.name }}"
    state: absent
    key: "{{ item.unauthorized_keys | join('\n') }}"
  loop: "{{ users }}"
  when: item.unauthorized_keys is defined

- name: Task 12: Copy generated private SSH keys to the user's .ssh directory if specified
  copy:
    src: "{{ ssh_keys_dir }}/{{ item.name }}.pem"
    dest: "{{ user_homes[item.name] }}/.ssh/{{ item.name }}_id_rsa"
    mode: "0600"
  loop: "{{ users }}"
  when: item.copy_private_key is defined

- name: Task 13: Check the password validity period for users
  shell: "chage -l {{ item.name }} | grep 'Password expires'"
  register: pass_exp
  loop: "{{ users }}"

- name: Task 14: Set the password validity period for users if a specific duration is defined
  command: "chage -M {{ item.password_validity_days }} {{ item.name }}"
  loop: "{{ users }}"
  when: item.password_validity_days is defined

- name: Task 15: Place additional private key files in the user's .ssh directory if specified
  copy:
    src: "{{ item.additional_private_keys }}"
    dest: "{{ user_homes[item.name] }}/.ssh/"
    mode: "0600"
  loop: "{{ users }}"
  when: item.additional_private_keys is defined


