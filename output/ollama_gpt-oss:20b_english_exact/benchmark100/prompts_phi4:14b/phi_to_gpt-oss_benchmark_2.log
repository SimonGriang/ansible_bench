---
- name: Import an additional task file to assert conditions
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Pre-configure Debian systems for Postfix
  ansible.builtin.debconf:
    name: postfix
    question: main_mailer_type
    value: 'No configuration'
    vtype: string
  when: ansible_facts['os_family'] == 'Debian'

- name: Install Postfix
  ansible.builtin.package:
    name: postfix
    state: present

- name: Conditionally install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present
  when:
    - >
      postfix_virtual_mailbox_maps is defined and
      'mysql' in postfix_virtual_mailbox_maps
    - >
      postfix_virtual_mailbox_domains is defined and
      'mysql' in postfix_virtual_mailbox_domains
    - >
      postix_virtual_alias_maps is defined and
      'mysql' in postix_virtual_alias_maps

- name: Configure Postfix transport maps
  ansible.builtin.template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport
    mode: '0644'
  when: postfix_transport_maps_template is defined
  notify:
    - validate configuration
    - rebuild transport maps database

- name: Configure Postfix header checks
  ansible.builtin.template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
    mode: '0644'
  when: postfix_header_checks_template is defined
  notify:
    - validate configuration
    - reload Postfix

- name: Set values for Postfix main.cf (part 1)
  ansible.builtin.set_fact:
    postfix_smtpd_recipient_restrictions: >-
      {{ postfix_recipient_access | default([]) }}
    postfix_smtpd_sender_restrictions: >-
      {{ postfix_sender_access | default([]) }}
  when: postfix_recipient_access is defined or postfix_sender_access is defined

- name: Set values for Postfix main.cf (part 2)
  ansible.builtin.set_fact:
    postfix_mynetworks: >-
      {{ mynetworks | default([]) }}
    postfix_mydestination: >-
      {{ mydestination | default([]) }}
    postfix_relay_domains: >-
      {{ relay_domains | default([]) }}
    postfix_smtpd_recipient_restrictions: >-
      {{ smtpd_recipient_restrictions | default([]) }}
    postfix_smtpd_sender_restrictions: >-
      {{ smtpd_sender_restrictions | default([]) }}
    postfix_virtual_mailbox_domains: >-
      {{ virtual_mailbox_domains | default([]) }}
    postfix_virtual_alias_domains: >-
      {{ virtual_alias_domains | default([]) }}
  when:
    - mynetworks is defined
    - mydestination is defined
    - relay_domains is defined
    - smtpd_recipient_restrictions is defined
    - smtpd_sender_restrictions is defined
    - virtual_mailbox_domains is defined
    - virtual_alias_domains is defined

- name: Configure Postfix main.cf
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - validate configuration
    - restart Postfix

- name: Configure Postfix master.cf
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - validate configuration
    - restart Postfix

- name: Create directories for TLS certificates and keys
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - "{{ postfix_tls_cert_dir }}"
    - "{{ postfix_tls_key_dir }}"
  when: postfix_tls_cert_dir is defined or postfix_tls_key_dir is defined

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_tls_cert_src }}"
    dest: "{{ postfix_tls_cert_dest }}"
    mode: '0644'
  when: postfix_tls_cert_src is defined and postfix_tls_cert_dest is defined
  notify: reload Postfix

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_tls_key_src }}"
    dest: "{{ postfix_tls_key_dest }}"
    mode: '0600'
  when: postfix_tls_key_src is defined and postfix_tls_key_dest is defined
  notify: reload Postfix

- name: Flush Postfix handlers
  ansible.builtin.meta: flush_handlers

- name: Configure Postfix aliases
  ansible.builtin.lineinfile:
    path: "{{ postfix_aliases_path }}"
    line: "{{ item }}"
    state: present
  loop: "{{ postfix_aliases }}"
  when: postfix_aliases is defined
  notify:
    - rebuild alias database
    - reload Postfix

- name: Configure Postfix sender access
  ansible.builtin.lineinfile:
    path: "{{ postfix_sender_access_path }}"
    line: "{{ item }}"
    state: present
  loop: "{{ postfix_sender_access }}"
  when: postfix_sender_access is defined
  notify:
    - rebuild sender access database
    - reload Postfix

- name: Configure Postfix recipient access
  ansible.builtin.lineinfile:
    path: "{{ postfix_recipient_access_path }}"
    line: "{{ item }}"
    state: present
  loop: "{{ postfix_recipient_access }}"
  when: postfix_recipient_access is defined
  notify:
    - validate configuration
    - rebuild recipient access database
    - reload Postfix

- name: Place SASL password map
  ansible.builtin.copy:
    content: "{{ postfix_smtp_sasl_password_map }}"
    dest: "{{ postfix_sasl_password_map_path }}"
    mode: '0600'
  when:
    - postfix_smtp_sasl_password_map is defined
    - postfix_sasl_password_map_path is defined
    - postfix_smtp_sasl_password_map | length > 0
  notify: rebuild sasl_password_map database

- name: Flush Postfix handlers again
  ansible.builtin.meta: flush_handlers

- name: Start and enable Postfix service
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: true


