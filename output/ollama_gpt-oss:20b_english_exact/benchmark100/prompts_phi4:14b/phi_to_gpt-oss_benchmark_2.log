---
- name: Check if Java certificates exist on the system
  ansible.builtin.stat:
    path: "{{ item }}"
  loop: "{{ java_certificates }}"
  register: certs_stat

- name: Fail the playbook if any Java certificate is missing
  ansible.builtin.fail:
    msg: "Missing Java certificates: {{ missing_certs | join(', ') }}"
  when: missing_certs | length > 0
  vars:
    missing_certs: >-
      {{ certs_stat.results | selectattr('stat.exists', 'equalto', False)
         | map(attribute='item') | list }}

- name: Set keystore directory variables for Java versions less than 11
  ansible.builtin.set_fact:
    keystore_dir: "/etc/ssl/java/legacy"
  when: java_version < 11

- name: Set keystore directory variables for Java versions 11 and above
  ansible.builtin.set_fact:
    keystore_dir: "/etc/ssl/java/modern"
  when: java_version >= 11

- name: Import SSL certificates into the Java keystore
  community.general.java_cert:
    keystore: "{{ keystore_dir }}"
    certificate: "{{ item }}"
    state: present
    keystore_pass: "{{ keystore_pass }}"
  loop: "{{ java_certificates }}"


