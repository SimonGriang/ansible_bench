---
- name: Import assert.yml from a specified file
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install MySQL packages
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - set mysql root password
    - systemd daemon-reload

- name: Configure the MySQL server configuration file
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: '0640'
  notify: restart mysql

- name: Configure the MySQL client configuration file
  lineinfile:
    path: /etc/mysql/client.cnf
    regexp: '^socket='
    line: "socket={{ mysql_socket }}"
    create: yes
  notify: restart mysql

- name: Initialize the MySQL database if on Alpine or Archlinux
  block:
    - name: Ensure MySQL data directory exists
      file:
        path: /var/lib/mysql
        state: directory
        owner: mysql
        group: mysql
        mode: '0755'
    - name: Initialize MySQL data directory
      command: mysql_install_db --user=mysql --ldata=/var/lib/mysql
      args:
        creates: /var/lib/mysql/mysql
  when: ansible_facts['distribution'] in ['Alpine', 'Archlinux']

- name: Start and enable the MySQL service
  service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers to apply previous changes
  meta: flush_handlers

- name: Place the my.cnf configuration file
  template:
    src: my.cnf.j2
    dest: "{{ ansible_env.HOME }}/my.cnf"
    owner: root
    group: root
    mode: '0600'

- name: Create MySQL databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: item.initial_import is not defined
  no_log: true

- name: List current MySQL databases
  mysql_db:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    state: list
  register: mysql_db_list
  no_log: true

- name: Import databases if initial import is defined and not already present
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
  loop: "{{ mysql_databases }}"
  when: (item.initial_import is defined) and (item.name not in mysql_db_list.databases)
  no_log: true

- name: Create MySQL users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('*.*:ALL') }}"
    state: present
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again to apply user creation changes
  meta: flush_handlers


