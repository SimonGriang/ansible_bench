---
- name: Import additional task files for assertions
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Manage automatic service management for APT
  block:
    - name: Disable automatic service management on installation
      file:
        path: /usr/sbin/policy-rc.d
        state: file
        content: |
          exit 101
        mode: '0755'
      when: apt_autostart_state == 'disabled'

    - name: Enable automatic service management on installation
      file:
        path: /usr/sbin/policy-rc.d
        state: absent
      when: apt_autostart_state == 'enabled'
  when: ansible_pkg_mgr == 'apt'


