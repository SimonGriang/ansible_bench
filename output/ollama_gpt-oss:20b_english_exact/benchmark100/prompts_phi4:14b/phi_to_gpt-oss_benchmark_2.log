---
- name: "Task 1: Create a system group for Vault."
  ansible.builtin.group:
    name: "{{ vault_group }}"
    system: true

- name: "Task 2: Create a system user for Vault."
  ansible.builtin.user:
    name: "{{ vault_user }}"
    group: "{{ vault_group }}"
    shell: "{{ vault_user_shell }}"
    system: true

- name: "Task 3: Create a download directory for Vault."
  ansible.builtin.file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: root
    group: root
    mode: "0755"

- name: "Task 4: Download the Vault binary."
  ansible.builtin.unarchive:
    src: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_{{ vault_arch }}.zip"  # yamllint disable-line rule:line-length
    dest: "{{ vault_download_path }}"
    remote_src: true
    creates: "{{ vault_download_path }}/vault"
  notify: restart vault

- name: "Task 5: Check if the main Vault directory exists."
  ansible.builtin.stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: "Task 6: Create the main Vault directory if it does not exist."
  ansible.builtin.file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0755"
  when: not vault_check_path.stat.exists

- name: "Task 7: Create additional directories in the main Vault directory."
  ansible.builtin.file:
    path: "{{ vault_path }}/{{ item.name }}"
    state: directory
    owner: "{{ item.owner | default(vault_user) }}"
    group: "{{ item.group | default(vault_group) }}"
    mode: "{{ item.mode | default('0755') }}"
  loop: "{{ vault_directories }}"

- name: "Task 8: Create data directories for Vault."
  ansible.builtin.file:
    path: "{{ vault_path }}/{{ item.path }}"
    state: directory
    owner: "{{ item.owner | default(vault_user) }}"
    group: "{{ item.group | default(vault_group) }}"
    mode: "{{ item.mode | default('0755') }}"
  loop: "{{ vault_data_directories }}"

- name: "Task 9: Generate a TLS key and certificate for Vault."
  notify: restart vault
  block:
    - name: Generate TLS private key
      community.crypto.openssl_privatekey:
        path: "{{ vault_data_directory }}/tls/vault.key"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: "0600"
        size: 2048
    - name: Generate TLS certificate
      community.crypto.x509_certificate:
        path: "{{ vault_data_directory }}/tls/vault.crt"
        privatekey_path: "{{ vault_data_directory }}/tls/vault.key"
        provider: selfsigned
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: "0644"

- name: "Task 10: Set ownership of TLS files."
  ansible.builtin.file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0640"
  loop: "{{ vault_tls_files }}"

- name: "Task 11: Copy the Vault binary to the appropriate location."
  ansible.builtin.copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    owner: root
    group: root
    mode: "0755"
  notify: restart vault

- name: "Task 12: Set specific capabilities on the Vault binary."
  community.general.set_cap:
    path: "{{ vault_path }}/usr/bin/vault"
    capabilities: "cap_ipc_lock=ep"
    state: present

- name: "Task 13: Create a vault environment file."
  ansible.builtin.copy:
    content: "{{ vault_env_content | default('') }}"
    dest: "{{ vault_path }}/etc/vault.d/vault.env"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "0640"
    preserve: true
  notify: restart vault

- name: "Task 14: Ensure the systemd system directory exists."
  ansible.builtin.file:
    path: "/usr/lib/systemd/system"
    state: directory
    owner: root
    group: root
    mode: "0755"

- name: "Task 15: Copy the Vault service file for systemd."
  ansible.builtin.template:
    src: "vault.service.j2"
    dest: "/usr/lib/systemd/system/vault.service"
    owner: root
    group: root
    mode: "0644"
  notify: reload systemd
  when: ansible_service_mgr == 'systemd'

- name: "Task 16: Copy the Vault configuration file."
  ansible.builtin.copy:
    src: "vault.hcl"
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: "0644"
  notify: restart vault

- name: "Task 17: Flush handlers to apply changes."
  ansible.builtin.meta: flush_handlers


