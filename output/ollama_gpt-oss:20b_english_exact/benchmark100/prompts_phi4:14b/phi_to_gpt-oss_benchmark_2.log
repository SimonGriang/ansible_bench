---
- name: Task 1: Check if all necessary variables have been set correctly
  import_tasks: assert_variables.yml
  delegate_to: localhost
  run_once: true

- name: Task 2: Wait for the host to become available if specified in the configuration
  wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ wait_port | default(22) }}"
    timeout: "{{ wait_timeout | default(30) }}"
  when:
    - connection_type != 'container'
    - wait_for_host | default(false)
  delegate_to: localhost
  become: "{{ become | default(false) }}"

- name: Task 3: Prepare the system by ensuring connectivity and installing necessary packages
  block:
    - name: Test connection to host
      ping:
      register: ping_result
      ignore_errors: true

    - name: Debug connection timeout
      debug:
        msg: "Connection to host timed out after {{ connection_timeout | default(30) }} seconds."
      when: ping_result.failed

    - name: Gather facts
      setup:

    - name: Install packages on RedHat
      yum:
        name: "{{ packages }}"
        state: present
      when: ansible_os_family == 'RedHat'
      become: true

    - name: Install packages on Debian
      apt:
        name: "{{ packages }}"
        state: present
        update_cache: yes
      when: ansible_os_family == 'Debian'
      become: true
  become: "{{ become | default(false) }}"

- name: Task 4: Ensure the system is fully prepared by executing necessary Ansible modules
  block:
    - name: Gather facts
      setup:

