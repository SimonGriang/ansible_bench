---
- name: Import additional tasks from a file
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Enable the Redis module for RHEL 8
  dnf:
    name: redis:8
    state: enabled
  when: ansible_facts['distribution'] == 'RedHat' and ansible_facts['distribution_major_version'] == '8'

- name: Install Redis packages
  dnf:
    name: "{{ redis_packages }}"
    state: present

- name: Configure Redis with a template
  template:
    src: redis.j2
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: restart redis

- name: Start and enable the Redis service
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes


