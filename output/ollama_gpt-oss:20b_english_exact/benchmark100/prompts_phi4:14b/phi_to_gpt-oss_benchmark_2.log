- name: Check for the existence of the EXTERNALLY-MANAGED file for Python 3.11
  ansible.builtin.stat:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
  register: python311_externally_managed

- name: Rename the EXTERNALLY-MANAGED file for Python 3.11 if it exists
  ansible.builtin.command: mv /usr/lib/python3.11/EXTERNALLY-MANAGED /usr/lib/python3.11/EXTERNALLY-MANAGED.old
  args:
    creates: /usr/lib/python3.11/EXTERNALLY-MANAGED.old
  when: python311_externally_managed.stat.exists

- name: Check for the existence of the EXTERNALLY-MANAGED file for Python 3.12
  ansible.builtin.stat:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
  register: python312_externally_managed

- name: Rename the EXTERNALLY-MANAGED file for Python 3.12 if it exists
  ansible.builtin.command: mv /usr/lib/python3.12/EXTERNALLY-MANAGED /usr/lib/python3.12/EXTERNALLY-MANAGED.old
  args:
    creates: /usr/lib/python3.12/EXTERNALLY-MANAGED.old
  when: python312_externally_managed.stat.exists

- name: Import tasks from assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install Python pip
  ansible.builtin.pip:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    regexp: '^index-url'
    line: "index-url={{ python_pip_proxy }}"
    state: present
  when: python_pip_proxy is defined

- name: Configure trusted hosts for pip
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    regexp: '^trusted-host'
    line: "trusted-host={{ python_pip_trusted_host }}"
    state: present
  when: python_pip_trusted_host is defined

- name: Update pip to the latest version
  ansible.builtin.pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when:
    - python_pip_update | bool
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'

- name: Install requested Python modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    version: "{{ item.version }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  when:
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'


