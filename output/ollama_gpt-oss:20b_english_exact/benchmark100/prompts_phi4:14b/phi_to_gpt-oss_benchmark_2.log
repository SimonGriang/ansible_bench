---
- name: Ensure the system is using systemd as the init system
  assert:
    that:
      - ansible_service_mgr == 'systemd'
    fail_msg: "This playbook only works with systemd"

- name: Retrieve the latest release information for Grafana Loki
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
    headers:
      Authorization: "token {{ lookup('env', 'GITHUB_TOKEN') }}"
    status_code: 200
    validate_certs: yes
  register: loki_release
  retries: 5
  delay: 5
  until: loki_release.status == 200

- name: Set promtail_version fact
  set_fact:
    promtail_version: "{{ loki_release.json.tag_name }}"
  when: promtail_version == 'latest'

- name: Verify the existence of a local promtail binary archive
  stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.tar.gz"
  register: promtail_binary
  when: promtail_binary_local_dir is defined

- name: Assert promtail binary archive exists
  assert:
    that:
      - promtail_binary.stat.exists
    fail_msg: "Promtail binary archive not found in {{ promtail_binary_local_dir }}"
  when: promtail_binary_local_dir is defined

- name: Download promtail checksum
  set_fact:
    promtail_checksum: >-
      {{
        lookup('url',
          'https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail-{{ promtail_version }}.tar.gz.sha256')
        | regex_search('^([0-9a-f]+)\\s+promtail-{{ promtail_version }}.tar.gz$', '\\1', multiline=True)
      }}
  when: promtail_binary_local_dir is not defined

- name: Download promtail binary
  get_url:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail-{{ promtail_version }}.tar.gz"
    dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
    checksum: "sha256:{{ promtail_checksum }}"
  when: promtail_binary_local_dir is not defined


