---
- name: Import the assert.yml file as a task to be run once on the localhost
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Update apk package cache without marking the task as changed
  community.general.apk:
    update_cache: yes
  changed_when: false
  when: ansible_pkg_mgr == 'apk'

- name: Upgrade all apk packages
  community.general.apk:
    upgrade: yes
  notify: Reboot
  when: ansible_pkg_mgr == 'apk'

- name: Hold selected packages from upgrading
  apt:
    name: '{{ packages_to_hold | default([]) }}'
    state: hold
  when: ansible_pkg_mgr == 'apt'

- name: Update and upgrade all apt packages with environment settings
  apt:
    update_cache: yes
    upgrade: dist
  environment:
    LANG: C
    LC_ALL: C
  notify: Reboot
  when: ansible_pkg_mgr == 'apt'

- name: Autoremove unused apt packages
  apt:
    autoremove: yes
  notify: Reboot
  when: ansible_pkg_mgr == 'apt'

- name: Update all dnf packages to latest state excluding specified packages
  community.general.dnf:
    name: '*'
    state: latest
    exclude: '{{ packages_to_exclude | default([]) }}'
  notify: Reboot
  when: ansible_pkg_mgr in ['dnf', 'dnf5']

- name: Update pacman package cache
  community.general.pacman:
    update_cache: yes
  when: ansible_pkg_mgr == 'pacman'

- name: Upgrade all pacman packages
  community.general.pacman:
    upgrade: yes
  notify: Reboot
  when: ansible_pkg_mgr == 'pacman'

- name: Update all yum packages to latest state (YUM 6)
  yum:
    name: '*'
    state: latest
  notify: Reboot
  when: ansible_pkg_mgr == 'yum' and ansible_facts['yum_version'] == '6'

- name: Update all yum packages to latest state (YUM other)
  yum:
    name: '*'
    state: latest
  notify: Reboot
  when: ansible_pkg_mgr == 'yum' and ansible_facts['yum_version'] != '6'

- name: Install yum-utils
  yum:
    name: yum-utils
    state: present
  when: ansible_pkg_mgr == 'yum' and ansible_facts['yum_version'] != '6'

- name: Update all zypper packages to latest state
  zypper:
    name: '*'
    state: latest
  notify: Reboot
  when: ansible_pkg_mgr == 'zypper'


