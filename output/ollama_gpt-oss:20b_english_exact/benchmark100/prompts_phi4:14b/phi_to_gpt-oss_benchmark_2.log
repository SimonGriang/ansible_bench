---
- name: Enable Apache2 modules
  apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  when: ansible_facts.os_family in ['Debian', 'Suse']

- name: Configure Apache2 locations
  template:
    src: location.conf.j2
    dest: "/etc/apache2/conf.d/{{ item }}.conf"
    mode: '0644'
  loop: "{{ httpd_locations }}"
  notify:
    - Validate HTTPD configuration
    - Restart HTTPD


