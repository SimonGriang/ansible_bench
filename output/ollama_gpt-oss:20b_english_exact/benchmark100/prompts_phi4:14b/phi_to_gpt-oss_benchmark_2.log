---
- name: Create document root directories for HTTP virtual hosts
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: "0755"
  loop: "{{ httpd_vhosts }}"
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - item.create_docroot is not defined or item.create_docroot != false

- name: Configure virtual host configuration files using templates
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.servername | default(item.name) }}.conf"
    mode: "0644"
  loop: "{{ httpd_vhosts }}"
  notify:
    - Test HTTPD configuration
    - Restart HTTPD service

- name: Enable virtual hosts on Debian-based systems
  command: a2ensite {{ item.servername | default(item.name) }}.conf
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian'
  notify:
    - Test HTTPD configuration
    - Restart HTTPD service


