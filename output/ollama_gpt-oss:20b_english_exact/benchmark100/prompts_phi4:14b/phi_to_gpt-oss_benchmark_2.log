---
- name: Import assertions
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install logrotate package
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  template:
    src: "{{ logrotate_config_file }}"
    dest: "{{ logrotate_config_directory }}/{{ logrotate_config_file | basename }}"
    mode: "0644"

- name: Generate logrotate.d configuration files
  template:
    src: "entry.j2"
    dest: "{{ logrotate_confd_directory }}/{{ item.name }}.conf"
  loop: "{{ logrotate_entries }}"
  when: item.state != 'absent'

- name: Remove logrotate.d configuration files
  file:
    path: "{{ logrotate_confd_directory }}/{{ item.name }}.conf"
    state: absent
  loop: "{{ logrotate_entries }}"
  when: item.state == 'absent'

- name: Ensure logrotate service is running and enabled
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service is defined


