- name: Set flag for separate partition
  set_fact:
    usr_local_on_separate_partition: "{{ usr_local_mount.rc == 0 }}"

- name: Determine the RKE2 binary path based on filesystem checks
  set_fact:
    rke2_bin_path: >-
      {% if usr_local_on_separate_partition or not usr_local_stat.stat.isdir %}
      {{ rke2_bin_path_local }}
      {% else %}
      {{ rke2_bin_path_default }}
      {% endif %}

- name: Check the installed and running RKE2 versions
  block:
    - name: Get installed RKE2 version
      command: "{{ rke2_bin_path }} --version"
      register: rke2_installed_version
    - name: Check if RKE2 service is active
      command: "systemctl is-active rke2-server"
      register: rke2_service_status
      ignore_errors: true
    - name: Set RKE2 version info
      set_fact:
        rke2_version_info:
          installed: "{{ rke2_installed_version.stdout }}"
          running: "{{ rke2_service_status.rc == 0 }}"
  register: rke2_version_check

- name: Set RKE2 version facts based on the version check results
  set_fact:
    rke2_installed_version: "{{ rke2_version_check.result.rke2_version_info.installed }}"
    rke2_running_version: "{{ rke2_version_check.result.rke2_version_info.running }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade unless explicitly allowed
  assert:
    that:
      - rke2_desired_version is version(rke2_running_version, '>=')
      - rke2_allow_downgrade | bool
    fail_msg: "Downgrade of RKE2 is not allowed without explicit permission."

- name: Run RKE2 install script if the version needs to be updated
  block:
    - name: Install RKE2
      command: "{{ rke2_install_script_path }} install --yes"
      environment:
        PATH: "/usr/local/bin:/usr/bin"
      register: rke2_install_result
  when:
    - rke2_desired_version != rke2_installed_version

- name: Copy custom manifests if they are defined
  copy:
    src: "{{ item }}"
    dest: "/etc/rancher/rke2/custom-manifests/{{ item | basename }}"
    mode: '0644'
    force: yes
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy static pods if they are defined
  copy:
    src: "{{ item }}"
    dest: "/var/lib/rancher/rke2/agent/pod-manifests/{{ item | basename }}"
    mode: '0644'
    force: yes
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file if environment options are defined
  copy:
    src: "{{ rke2_env_file_local }}"
    dest: "/etc/rancher/rke2/rke2.env"
    mode: '0644'
    force: yes
  when: rke2_env_options | length > 0


