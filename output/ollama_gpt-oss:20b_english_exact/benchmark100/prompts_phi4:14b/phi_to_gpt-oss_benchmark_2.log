content='---\n- name: Download the RKE2 kubeconfig file to a specified path on localhost\n  ansible.builtin.fetch:\n    src: /etc/rancher/rke2/rke2.yaml\n    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    flat: yes\n  delegate_to: localhost\n  when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]\n\n- name: Replace loopback IP addresses in the downloaded kubeconfig file with the master server IP\n  ansible.builtin.replace:\n    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    regexp: \'127\\.0\\.0\\.1|\\[::1\\]\'\n    replace: "{{ rke2_api_ip | default(hostvars[groups[rke2_servers_group_name][0]][\'ansible_default_ipv4\'][\'address\']) }}"\n    mode: \'0600\'\n  delegate_to: localhost\n  when: not ansible_check_mode and rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]' additional_kwargs={} response_metadata={'model': 'gpt-oss:20b', 'created_at': '2025-10-15T06:56:44.357432439Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14118560577, 'load_duration': 176266973, 'prompt_eval_count': 622, 'prompt_eval_duration': 480097033, 'eval_count': 1372, 'eval_duration': 13460894947, 'model_name': 'gpt-oss:20b'} id='run--dc4bad45-63f1-44fc-9ad5-1663e02cf146-0' usage_metadata={'input_tokens': 622, 'output_tokens': 1372, 'total_tokens': 1994}
