---
- name: Check if the Helm binary exists at the specified path
  ansible.builtin.stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Retrieve the current Helm version installed on the system
  ansible.builtin.command: "{{ helm_bin_path }} version"
  register: helm_existing_version
  failed_when: false
  changed_when: false

- name: >-
    Download the specified version of Helm if it does not exist or
    if the version is outdated
  ansible.builtin.unarchive:
    src: "{{ helm_repo_path }}"
    dest: "/tmp/helm"
    remote_src: true
  register: helm_download
  when:
    - helm_check.stat.exists is false
    - helm_existing_version.stdout is not search(helm_version)

- name: Install the downloaded Helm binary in the appropriate location
  ansible.builtin.copy:
    src: "/tmp/helm/{{ helm_bin_path | basename }}"
    dest: "{{ helm_bin_path }}"
    mode: '0755'
  become: true
  when: helm_download.changed
  changed_when: false


