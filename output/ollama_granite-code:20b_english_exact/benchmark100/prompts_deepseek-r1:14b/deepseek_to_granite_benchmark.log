---
- name: "Import assert.yml"
  import_tasks: assert.yml
  tags: [always]

- name: "Pre-configure debian systems"
  block:
    - name: " Debian | Install required package to handle mail configuration"
      ansible.builtin.apt:
        name: debian-mailx
        state: present
      when: ansible_os_family == "Debian"

    - name: "Debian | Pre-configure postfix for debian"
      ansible.builtin.debconf:
        name: postfix
        question: "{{ item.question }}"
        value: "{{ item.value }}"
        vtype: "{{ item.vtype }}"
      loop:
        - question: postfix/mailname
          value: "{{ ansible_hostname }}"
          vtype: string
        - question: postfix/main_mailer_type
          value: "Internet Site"
          vtype: string
  when:
    - ansible_os_family == "Debian"
    - ansible_virtualization_type != "docker"
  tags: ["postfix", "debian"]

- name: "Install postfix"
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop:
    - postfix
  tags: ["postfix", "packages"]

- name: "Install postfix-mysql"
  ansible.builtin.package:
    name: postfix-mysql
    state: present
  when: postfix_mysql_enabled | bool
  tags: ["postfix", "packages"]

- name: "Configure postfix (transport_maps)"
  ansible.builtin.template:
    src: postfix/transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: "0644"
    owner: root
    group: root
    validate: '/usr/bin/postmap %s'
  when: postfix_transport_maps_enabled | bool
  notify: [ "restart postfix" ]
  tags: ["postfix", "config"]

- name: "Configure postfix (header_checks)"
  ansible.builtin.template:
    src: postfix/header_checks.j2
    dest: /etc/postfix/header_checks
    mode: "0644"
    owner: root
    group: root
    validate: '/usr/bin/postmap %s'
  when: postfix_header_checks_enabled | bool
  notify: [ "reload postfix" ]
  tags: ["postfix", "config"]

- name: "Setting values for main.cf (1/2)"
  ansible.builtin.set_fact:
    postfix_maincf_recipient_restrictions: "{{ lookup('file', 'lookup/postfix_maincf_recipient_restrictions.yml') }}"
  tags: ["postfix", "config"]

- name: "Setting values for main.cf (2/2)"
  ansible.builtin.set_fact:
    postfix_maincf_sender_restrictions: "{{ lookup('file', 'lookup/postfix_maincf_sender_restrictions.yml') }}"
  tags: ["postfix", "config"]

- name: "Configure postfix (main.cf)"
  ansible.builtin.template:
    src: postfix/main.cf.j2
    dest: /etc/postfix/main.cf
    mode: "0644"
    owner: root
    group: root
  notify: [ "validate postfix", "restart postfix" ]
  tags: ["postfix", "config"]

- name: "Configure postfix (master.cf)"
  ansible.builtin.template:
    src: postfix/master.cf.j2
    dest: /etc/postfix/master.cf
    mode: "0644"
    owner: root
    group: root
  notify: [ "restart postfix" ]
  tags: ["postfix", "config"]

- name: "Creates cert/key directory"
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: "0750"
    owner: postfix
    group: postfix
  loop:
    - /etc/postfix/cert
    - /etc/postfix/key
  tags: ["postfix", "tls", "config"]

- name: "Deploy Postfix TLS server certificate"
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/postfix/cert/{{ item | basename }}
    mode: "0640"
    owner: postfix
    group: postfix
  loop: "{{ postfix_tls_server_cert }}"
  notify: [ "reload postfix" ]
  when: postfix_tls_enabled | bool
  tags: ["postfix", "tls", "config"]

- name: "Deploy Postfix TLS server key"
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/postfix/key/{{ item | basename }}
    mode: "0640"
    owner: postfix
    group: postfix
  loop: "{{ postfix_tls_server_key }}"
  notify: [ "reload postfix" ]
  when: postfix_tls_enabled | bool
  tags: ["postfix", "tls", "config"]

- name: "Flush handlers"
  ansible.builtin.meta: flush_handlers

- name: "Configure aliases"
  ansible.builtin.lineinfile:
    path: /etc/aliases
    regexp: "^{{ item.key }}:"
    line: "{{ item.key }}: {{ item.value }}"
    mode: "0644"
    owner: root
    group: root
  loop: "{{ postfix_aliases | dict2items }}"
  notify: [ "rebuild postfix aliases", "reload postfix" ]
  tags: ["postfix", "aliases", "config"]

- name: "Configure sender_access"
  ansible.builtin.lineinfile:
    path: /etc/postfix/sender_access
    regexp: "^{{ item.key }}:"
    line: "{{ item.key }}: {{ item.value }}"
    mode: "0644"
    owner: root
    group: root
  loop: "{{ postfix_sender_access | dict2items }}"
  notify: [ "rebuild postfix sender_access", "reload postfix" ]
  tags: ["postfix", "sender_access", "config"]

- name: "Configure recipient_access"
  ansible.builtin.lineinfile:
    path: /etc/postfix/recipient_access
    regexp: "^{{ item.key }}:"
    line: "{{ item.key }}: {{ item.value }}"
    mode: "0644"
    owner: root
    group: root
  loop: "{{ postfix_recipient_access | dict2items }}"
  notify: [ "validate postfix", "rebuild postfix recipient_access", "reload postfix" ]
  tags: ["postfix", "recipient_access", "config"]

- name: "Place sasl_password_map"
  ansible.builtin.copy:
    content: "{{ lookup('file', 'lookup/postfix_sasl_password_map.yml') }}"
    dest: /etc/postfix/sasl_password_map
    mode: "0640"
    owner: root
    group: root
  notify: [ "rebuild sasl_password_map" ]
  tags: ["postfix", "sasl", "config"]

- name: "Flush handlers again"
  ansible.builtin.meta: flush_handlers

- name: "Start and enable postfix"
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: true
  tags: ["postfix", "service"]
