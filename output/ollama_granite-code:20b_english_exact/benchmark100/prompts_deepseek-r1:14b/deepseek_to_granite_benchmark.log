---
- name: Import assertion tasks
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required software packages
  ansible.builtin.package:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ users_requirements }}"
  when:
    - users_requirements is defined
    - users_requirements | length > 0

- name: Manage user groups
  ansible.builtin.include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    loop_var: group

- name: Configure sudoers directory inclusion
  block:
    - name: Add /etc/sudoers.d directory to /etc/sudoers file
      ansible.builtin.lineinfile:
        path: /etc/sudoers
        line: "#includedir /etc/sudoers.d"
        state: present
        validate: visudo -cf %s

    - name: Deploy /etc/sudoers.d directory
      ansible.builtin.template:
        src: sudoers.d/{{ item.name }}
        dest: /etc/sudoers.d/{{ item.name }}
        mode: "0440"
        validate: visudo -cf %s
      loop: "{{ users_groups }}"
      loop_control:
        loop_var: group
  when: users_sudoers_include_dir

- name: Manage user configurations
  ansible.builtin.include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    loop_var: user

- name: Configure cron allow permissions
  ansible.builtin.template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: "0644"
  when: users_cron_allow

- name: Remove cron allow file if not needed
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


