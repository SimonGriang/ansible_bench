---
- name: HTTP Server configuration
  hosts: all
  tasks:
    - name: Create directories
      file:
        path: "{{ item.path }}"
        state: directory
        mode: 0755
      loop: "{{ httpd_directories }}"
      notify:
        - Test httpd configuration validity
        - Restart httpd

    - name: Configure directories
      template:
        src: directory.conf.j2
        dest: "{{ httpd_config_dir }}/{{ item.name }}.conf"
        mode: 0644
      loop: "{{ httpd_directories }}"
      notify:
        - Test httpd configuration validity
        - Restart httpd

 handlers:
  - name: Test httpd configuration validity
    command: httpd -t
    notify: Restart httpd

  - name: Restart httpd
    service:
      name: httpd
      state: restarted


