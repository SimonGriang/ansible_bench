---
- import_tasks: assert.yml
- block:
    - name: "Install HashiCorp product using package manager"
      package:
        name: "{{ hashcorp_product }}"
        state: present
      register: install_product
      until: install_product is succeeded
      retries: 5
      delay: 20
      when: hashcorp_install_method == "package"
    - name: "Configure Debian-specific settings for HashiCorp product installation"
      apt_key:
        url: "{{ hashcorp_apt_key_url }}"
        state: present
      when: ansible_os_family == "Debian"
    - name: "Add apt repository for HashiCorp product"
      apt_repository:
        repo: "{{ hashcorp_apt_repo }}"
        state: present
        update_cache: yes
      when: ansible_os_family == "Debian"
    - name: "Install HashiCorp products using package manager"
      package:
        name: "{{ hashcorp_product }}"
        state: "{{ hashcorp_install_version | ternary('specific', 'latest') }}"
      register: install_product
      until: install_product is succeeded
      retries: 5
      delay: 20
      when: hashcorp_install_method == "package"
    - name: "Install HashiCorp product manually by extracting files"
      unarchive:
        dest: "{{ hashcorp_install_dest }}"
        owner: "{{ hashcorp_install_owner | default(omit) }}"
        group: "{{ hashcorp_install_group | default(omit) }}"
        mode: "{{ hashcorp_install_mode | default(omit) }}"
        remote_src: yes
        src: "{{ hashcorp_install_src }}"
      when: hashcorp_install_method == "manual"
  always:
    - name: "Include assert.yml"
      import_tasks: assert.yml


