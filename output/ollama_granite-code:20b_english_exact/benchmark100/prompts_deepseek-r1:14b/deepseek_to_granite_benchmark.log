---
- name: "RKE2 configuration"
  hosts: "cluster"
  gather_facts: false

  tasks:
    - name: "Task 1: Create the RKE2 config directory"
      file:
        path: "/etc/rke2"
        state: "directory"
        owner: "root"
        group: "root"
        mode: "0755"

    - name: "Task 2: Set server taints"
      command: "kubectl taint node {{ inventory_hostname }} {{ rke2_server_node_taints }} --effect NoSchedule"
      when: "rke2_server_node_taints is defined"

    - name: "Task 3: Copy RKE2 configuration file"
      copy:
        src: "{{ rke2_config_src }}"
        dest: "/etc/rke2/rke2.yaml"
        owner: "root"
        group: "root"
        mode: "0644"
        backup: true
      notify: "Handler: restart rke2 service"

    - name: "Task 4: Copy kubelet configuration file"
      copy:
        src: "{{ rke2_kubelet_config_src }}"
        dest: "/var/lib/rke2/agent/etc/kubelet-config.yaml"
        owner: "root"
        group: "root"
        mode: "0644"
        backup: true
      when: "rke2_kubelet_config is defined"
      notify: "Handler: restart rke2 service"

    - name: "Task 5: Copy Containerd Registry Configuration file"
      copy:
        src: "{{ rke2_registry_config_src }}"
        dest: "/etc/docker/daemon.json"
        owner: "root"
        group: "root"
        mode: "0644"
        backup: true
      when: "rke2_registry_config is defined"
      notify: "Handler: restart rke2 service"

    - name: "Task 6: Register etcd restore from file"
      set_fact:
        etcd_restore_from_file: true
      when:
        - "rke2_snapshot_file is defined"
        - "rke2_snapshot_file != ''"
        - "(rke2_state == 'absent') or (rke2_state == 'restore')"
        - "(rke2_service_status.stdout == ' active')"
      changed_when: false

    - name: "Task 7: Register etcd restore from S3"
      set_fact:
        etcd_restore_from_s3: true
      when:
        - "rke2_s3_access_key is defined"
        - "rke2_s3_secret_key is defined"
        - "rke2_s3_bucket_name is defined"
        - "rke2_s3_bucket_name != ''"
        - "rke2_s3_bucket_path is defined"
        - "rke2_s3_bucket_path != ''"
