    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: "0644"
  when: users_cron_allow

- name: Remove cron allow file if not needed
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


