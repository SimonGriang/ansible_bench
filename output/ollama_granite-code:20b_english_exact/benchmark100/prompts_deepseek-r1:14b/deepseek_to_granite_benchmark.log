---
- name: Bootstrap
  tasks:
    - name: lookup bootstrap facts (raw)
      raw: cat /etc/os-release
      register: bootstrap_facts
      changed_when: false
      vars:
        ansible_user: '{{ bootstrap_user }}'

    - name: set bootstrap facts (I)
      loop: '{{ bootstrap__os_family_map }}'
      loop_control:
        label: '{{ item.key }}'
      set_fact:
        bootstrap_distribution: '{{ item.key }}'
        bootstrap_distribution_major_version: '{{
          bootstrap_facts.stdout |
          from_yaml |
          regex_replace("^(.*) \\(.*\\)$", "\\1") |
          regex_replace("^(.*)\\.(\\d+).*$", "\\1") }}'
      become: '{{ bootstrap_become | default(omit) }}'

    - name: set bootstrap facts (II)
      loop: '{{ bootstrap__os_family_map }}'
      loop_control:
        label: '{{ item.key }}'
      set_fact:
        bootstrap_os_family: '{{ item.value }}'
      become: '{{ bootstrap_become | default(omit) }}'


