---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify: Set root password, Systemctl daemon-reexec

- name: Configure mysql server
  loop: "{{ mysql_configuration_options }}"
  ini_file:
    path: /etc/mysql/my.cnf
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0644
    backup: yes
  loop_control:
    label: "Configure {{ item.section }} {{ item.option }}"
  notify: Restart mysql server

- name: Configure mysql client
  ini_file:
    path: /etc/mysql/my.cnf
    section: client
    option: socket
    value: /var/run/mysqld/mysqld.sock
    mode: 0644
    backup: yes

- name: Initialize mysql
  command: mysql_install_db
  when:
    - ansible_os_family == "Debian"
    - ansible_distribution == "Ubuntu"
    - ansible_distribution_version == "20.04"
  changed_when: false

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644
    backup: yes

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  no_log: yes
  when: mysql_databases is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default(omit) }}"
    state: present
  loop: "{{ mysql_users }}"
  no_log: yes
  when: mysql_users is defined

- name: Flush handlers again
  meta: flush_handlers


