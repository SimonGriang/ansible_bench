---
- name: Install EPEL
  block:
    - name: Install EPEL GPG key
      rpm_key:
        key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-8
        state: present

    - name: Install EPEL-release package
      yum:
        name: "{{ epel_url }}"
        state: present

    - name: Install EPEL-next-release package
      yum:
        name: "{{ epel_next_url }}"
        state: present
      when: epel_next

    - name: Update package cache
      meta: flush_handlers
  when:
    - ansible_distribution == "Amazon" and ansible_distribution_major_version == "2"
    - ansible_os_family == "RedHat" and ansible_distribution_major_version in ["7", "8", "9", "10"]


