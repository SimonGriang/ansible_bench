            ETCDCTL_KEY_FILE: "/var/lib/rke2/agent/etc/kubernetes/admin.conf"
      when: "etcd_restore_from_file|bool"

    - name: "Task 9: Restore etcd from S3"
      block:
        - name: "9.1 Copy snapshot file from S3 to backup directory"
