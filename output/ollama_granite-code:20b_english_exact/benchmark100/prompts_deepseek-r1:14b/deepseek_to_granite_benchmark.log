---
- import_tasks: assert.yml
- name: Task 2 - Install git
  package:
    name: git
    state: "{{ git_package_state }}"
    update_cache: "{{ omit }}"
- name: Task 3 - Check if user exists
  command: >
    getent passwd {{ git_user }}
  register: user_check
  failed_when:
    - user_check.rc != 0
    - "user_check.rc != 1"
  changed_when: false
- name: Task 4 - Create git config directory
  file:
    path: "{{ git_user_home }}/.config/git"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
    mode: 0750
- name: Task 5 - Place git configuration
  template:
    src: gitconfig.j2
    dest: "{{ git_user_home }}/.config/git/config"
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
    mode: 0640
- name: Task 6 - Create repository destination
  file:
    path: "{{ git_repo_dest }}/{{ item.dest }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
    mode: 0750
  with_items: "{{ git_repos }}"
- name: Task 7 - Clone all repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repo_dest }}/{{ item.dest }}"
    version: "{{ item.version | default(omit) }}"
    force: "{{ git_clone_force | default(omit) }}"
    recursive: "{{ git_clone_recursive | default(omit) }}"
    update: "{{ git_clone_update | default(omit) }}"
    accept_hostkey: "{{ git_clone_accept_hostkey | default(omit) }}"
    depth: "{{ git_clone_depth | default(omit) }}"
    umask: "{{ git_clone_umask | default(omit) }}"
    track_submodules: "{{ git_clone_track_submodules | default(omit) }}"
  with_items: "{{ git_repos }}"


