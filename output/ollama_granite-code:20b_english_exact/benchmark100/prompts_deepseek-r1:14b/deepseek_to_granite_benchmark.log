---
- name: Restore etcd
  hosts: node
  tasks:
    - name: Get all node names
      shell: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
      register: node_names

    - name: Remove old nodes
      shell: kubectl delete node {{ item }}
      with_items: "{{ node_names.stdout_lines }}"
      when: item not in groups[rke2_cluster_group_name]
