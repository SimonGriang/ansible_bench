---

- name: Task 1 - Import assert.yml
  import_tasks: assert.yml

- name: Task 2 - Uninstall conflicting systemd-logger
  package:
    name: systemd-logger
    state: absent
  notify: Restart rsyslog handler

- name: Task 3 - Install rsyslog
  package:
    name: "{{ rsyslog_packages }}"
    state: "{{ rsyslog_package_state }}"
  notify: Restart rsyslog handler

- name: Task 4 - Install additional rsyslog packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features }}"
  notify: Restart rsyslog handler

- name: Task 5 - Configuring default rsyslog
  template:
    src: "{{ rsyslog_config_file_format }}"
    dest: "{{ rsyslog_dest_conf_file }}"
    owner: root
    group: root
    mode: 0644
  notify: Restart rsyslog handler

- name: Task 6 - Make configuration directory
  file:
    path: /etc/rsyslog.d/
    state: directory
    mode: 0755

- name: Task 7 - Configuring rsyslog forward rule
  template:
    src: forward_rule.conf.j2
    dest: /etc/rsyslog.d/{{ rsyslog_forward_rule_name }}.conf
    owner: root
    group: root
    mode: 0644
  when: not rsyslog_deploy_default_config
  notify: Restart rsyslog handler

- name: Task 8 - Configuring additional config files
  copy:
    src: "{{ item.value.src }}"
    dest: /etc/rsyslog.d/{{ item.key }}
    owner: root
    group: root
    mode: "{{ item.value.mode | default(omit) }}"
  loop: "{{ rsyslog_rsyslog_d_files | dict2items }}"
  when: item.value.state == "present"
  notify: Restart rsyslog handler

- name: Task 9 - Start and enable rsyslog
  service:
    name: "{{ rsyslog_service }}"
    state: started
    enabled: true


