---
- name: HTTP server configuration
  hosts: all
  tasks:
    - name: Create directories
      file:
        path: "{{ item.path }}"
        state: directory
        mode: 0755
      loop: "{{ httpd_directories }}"
      notify:
        - Test httpd configuration validity
        - Restart httpd

    - name: Configure directories
      template:
        src: directory.conf.j2
        dest: "{{ httpd_conf_dir }}/{{ item.name }}.conf"
        mode: 0644
      loop: "{{ httpd_directories }}"
      notify:
        - Test httpd configuration validity
        - Restart httpd
  handlers:
    - name: Test httpd configuration validity
      command: httpd -t
      notify: Restart httpd

    - name: Restart httpd
      service:
        name: httpd
        state: restarted
  vars:
    httpd_conf_dir: /etc/httpd/conf.d
    httpd_directories:
      - name: foo
        path: /var/www/foo
      - name: bar
        path: /var/www/bar


