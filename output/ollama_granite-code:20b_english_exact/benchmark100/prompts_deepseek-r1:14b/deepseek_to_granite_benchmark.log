        java_home: "{{ java_openjdk_install_path }}/{{ java_version }}"

    - name: Debian pre-requisites
      block:
        - name: Remove deprecated repositories
          apt_repository:
            repo: "{{ item }}"
            state: absent
          with_items: "{{ java_apt_deprecated_repositories }}"

        - name: Install extra apt tools
          apt:
            name: "{{ item }}"
            state: present
          with_items: "{{ java_apt_extra_tools }}"

        - name: Add key repositories
          apt_key:
            url: "{{ item }}"
            state: present
          with_items: "{{ java_apt_key_repositories }}"

        - name: Add required repositories
          apt_repository:
            repo: "{{ item }}"
            state: present
          with_items: "{{ java_apt_repositories }}"
      when: ansible_os_family == "Debian"

    - name: RedHat pre-requisites
      block:
        - name: Add key repositories
          get_url:
            url: "{{ item }}"
            dest: "/etc/yum.repos.d/{{ item | basename }}"
          with_items: "{{ java_yum_key_repositories }}"

        - name: Add required repositories
          copy:
            content: "{{ item }}"
            dest: "/etc/yum.repos.d/{{ item | basename }}"
          with_items: "{{ java_yum_repositories }}"
      when: ansible_os_family == "RedHat"

    - name: Install required libs
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ java_libs }}"

    - name: Install Java, Debian
      apt:
        name: "{{ java_package }}"
        state: present
        update_cache: true
      when: ansible_os_family == "Debian"

    - name: Install Java, RedHat
      yum:
        name: "{{ java_package }}"
        state: present
      when: ansible_os_family == "RedHat"

    - name: Export environment variables
      template:
        src: java.sh.j2
        dest: "{{ java_alternatives_path }}/java.sh"
        mode: 0755

    - name: Source environment variables
      shell:
        cmd: "source {{ java_alternatives_path }}/java.sh"
        executable: /bin/bash

    - name: Correct java version selected for Java < 11
      alternatives:
        name: java
        link: /usr/bin/java
        path: "{{ java_home }}/bin/java"
      when: java_version | float < 11

    - name: Correct java version selected for Java >= 11
      alternatives:
        name: java
        link: /usr/bin/java
        path: /usr/lib/jvm/java-11-openjdk-$(uname -m)/bin/java
      when: java_version | float >= 11


