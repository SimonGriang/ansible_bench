---
- name: Include assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  selinux:
    policy: "{{ selinux_policy }}"
    state: "{{ selinux_state }}"
  when: selinux_enabled

- name: Configure httpd
  template:
    src: "{{ httpd_conf_src }}"
    dest: "{{ httpd_conf_dest }}"
    mode: 0644
  notify: [httpd restart, httpd configtest]

- name: Activate httpd module | Debian
  command: a2enmod {{ item }}
  changed_when: false
  with_items: "{{ httpd_modules }}"
  when: ansible_os_family == 'Debian'

- name: Include ssl.yml
  import_tasks: ssl.yml
  when: ssl_enabled

- name: Include locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Include vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: ports.conf.j2
    dest: /etc/apache2/ports.conf
  notify: [httpd restart, httpd configtest]
  when: ansible_os_family == 'Debian' or ansible_os_family == 'Suse'

- name: Include directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


