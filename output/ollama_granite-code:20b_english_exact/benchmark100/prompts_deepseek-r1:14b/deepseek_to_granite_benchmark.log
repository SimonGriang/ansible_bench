---
- name: cadvisor | create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: 0755
  loop:
    - /opt/cadvisor
    - /etc/systemd/system/cadvisor.service.d

- name: cadvisor | download
  get_url:
    url: https://github.com/google/cadvisor/releases/download/v0.37.0/cadvisor
    dest: /opt/cadvisor/cadvisor
    owner: root
    group: root
    mode: 0755
    checksum: sha256:6c0fb91629885628367f765f2f68df60a302a8d28815c40324256e02747b0367

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: /opt/cadvisor/cadvisor
    dest: /usr/local/bin/cadvisor
    owner: root
    group: root
    mode: 0755
    remote_src: true
  notify: restart cadvisor

- name: cadvisor | symlink
  file:
    src: /usr/local/bin/cadvisor
    dest: /usr/bin/cadvisor
    owner: root
    group: root
    state: link

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    owner: root
    group: root
    mode: 0644
  notify: restart cadvisor

- name: test_task
  shell: systemctl is-active cadvisor
  register: service_active
  changed_when: false

- name: debug: var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemd:
    name: cadvisor
    enabled: yes

- name: cadvisor | start server systemd
  systemd:
    name: cadvisor
    state: started
    enabled: yes


