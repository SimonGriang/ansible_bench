---
- name: Install Docker Compose package
  ansible.builtin.package:
    name: docker-compose
    state: present
  when: docker_compose_install_type == "package"

- name: Install Docker Compose binary
  block:
    - name: Install required packages
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      with_items: "{{ docker_compose_binary_required_packages }}"

    - name: Download Docker Compose binary
      ansible.builtin.get_url:
        url: "{{ docker_compose_binary_url }}"
        dest: /usr/local/bin/docker-compose
        mode: "0755"
  when: docker_compose_install_type == "binary"

- name: Import assertion tasks
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost


