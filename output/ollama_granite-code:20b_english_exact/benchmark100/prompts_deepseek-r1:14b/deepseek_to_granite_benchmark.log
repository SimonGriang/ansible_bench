nt': 475, 'eval_duration': 8604049322, 'model_name': 'granite-code:20b'} id='run--9dd17643-c34a-43d3-9efa-1c14aca2b060-0' usage_metadata={'input_tokens': 617, 'output_tokens': 475, 'total_tokens': 1092}
