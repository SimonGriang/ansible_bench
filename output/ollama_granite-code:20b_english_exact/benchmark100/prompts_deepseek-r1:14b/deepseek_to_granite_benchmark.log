---
- name: Generate OpenSSL private key
  openssl_privatekey:
    path: "{{ key_path }}/private/{{ key_name }}.key"
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"

- name: Generate OpenSSL Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ key_path }}/csr/{{ key_name }}.csr"
    privatekey_path: "{{ key_path }}/private/{{ key_name }}.key"
    common_name: "{{ key_common_name }}"
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"

- name: Generate OpenSSL X.509 certificate
  openssl_certificate:
    path: "{{ key_path }}/public/{{ key_name }}.crt"
    privatekey_path: "{{ key_path }}/private/{{ key_name }}.key"
    csr_path: "{{ key_path }}/csr/{{ key_name }}.csr"
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"

- name: Generate PKCS#12 file
  openssl_pkcs12:
    path: "{{ key_path }}/pkcs12/{{ key_name }}.pfx"
    friendly_name: "{{ key_friendly_name }}"
    privatekey_path: "{{ key_path }}/private/{{ key_name }}.key"
    certificate_path: "{{ key_path }}/public/{{ key_name }}.crt"
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"

- name: Read private key content
  slurp:
    src: "{{ key_path }}/private/{{ key_name }}.key"
  register: private_key_content

- name: Read certificate content
  slurp:
    src: "{{ key_path }}/public/{{ key_name }}.crt"
  register: certificate_content

- name: Create a combined private key and certificate file
  copy:
    content: "{{ private_key_content['content'] }}{{ certificate_content['content'] }}"
    dest: "{{ key_path }}/combined/{{ key_name }}.pem"
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"


