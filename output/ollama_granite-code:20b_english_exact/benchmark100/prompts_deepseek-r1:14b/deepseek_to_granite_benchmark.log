---
- name:aps_ keepsalived
  hosts:
    - localhost
  tasks:
    - name: Update apt cache
      apt:
        update_cache: yes
        cache_valid_time: 3600
      when: ansible_os_family == 'Debian'
    - name: Update dnf cache
      dnf:
        update_cache: yes
      when: ansible_os_family == 'RedHat'
    - name: Install packages
      package:
        name: keepalived
        state: present
    - name: Create directory for keepalived
      file:
        path: /etc/keepalived
        state: directory
        owner: root
        group: root
        mode: 0755
    - name: Create Kubernetes API health check script for Debian OS family
      template:
        src: keepalived-kube-api.sh.j2
        dest: /etc/keepalived/keepalived-kube-api.sh
        mode: 0755
        owner: root
        group: root
      notify: restart keepalived
      when: ansible_os_family == 'Debian'
    - name: Create Kubernetes API health check script for RedHat OS famliy
      template:
        src: keepalived-kube-api.sh.j2
        dest: /etc/keepalived/keepalived-kube-api.sh
        mode: 0755
        owner: root
        group: root
      notify: restart keepalived
      when: ansible_os_family == 'RedHat'
    - name: Create RKE2 Server health check script for Debian OS family
      template:
        src: keepalived-rke2-server.sh.j2
        dest: /etc/keepalived/keepalived-rke2-server.sh
        mode: 0755
        owner: root
        group: root
      notify: restart keepalived
      when: ansible_os_family == 'Debian'
    - name: Create RKE2 Server health check script for RedHat OS family
      template:
        src: keepalived-rke2-server.sh.j2
        dest: /etc/keepalived/keepalived-rke2-server.sh
        mode: 0755
        owner: root
        group: root
      notify: restart keepalived
      when: ansible_os_family == 'RedHat'
    - name: Create keepalived config file
      template:
        src: keepalived.conf.j2
        dest: /etc/keepalived/keepalived.conf
        mode: 0644
        owner: root
        group: root
      notify: restart keepalived
    - name: Enable keepalived and make sure it is not masked
      systemd:
        name: keepalived
        enabled: yes
        state: started
      notify: restart keepalived
    - name: Flush handlers
      meta: flush_handlers


