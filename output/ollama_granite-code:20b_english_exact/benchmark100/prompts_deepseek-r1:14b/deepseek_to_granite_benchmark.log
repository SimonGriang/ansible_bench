---
- name: Validate all variables are set correctly
  hosts: all
  tasks:
    - name: Import and run assert.yml file
      import_tasks: assert.yml

- name: Wait for host to be available
  hosts: all
  tasks:
    - name: Wait for host to become available
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
        sleep: "{{ bootstrap_wait_for_host_sleep }}"

- name: Prepare system for bootstrap
  hosts: all
  tasks:
    - name: Test connection
      ping:

    - name: Handle connection failures
      fail:
        msg: Connection failed
      when: not ansible_ssh_thrift_fd

    - name: Gather facts
      setup:

    - name: Install raw bootstrap packages
      package:
        name: "{{ bootstrap_packages }}"
        state: present

- name: Ensure system preparation with Ansible modules
  hosts: all
  tasks:
    - name: Gather facts
      setup:

    - name: Install packages based on detected OS family
      package:
        name: "{{ bootstrap_packages }}"
        state: present
      when: ansible_os_family == "Debian"

    - name: Install packages based on detected OS family
      package:
        name: "{{ bootstrap_packages }}"
        state: present
      when: ansible_os_family == "RedHat"


