---
- name: Install and configure SSL
  hosts: all
  tasks:
    - name: Install SSL packages
      package:
        name: "{{ httpd_ssl_packages }}"
        state: present
    - name: Place SSL configuration
      template:
        src: ssl.conf.j2
        dest: "{{ httpd_config_directory }}/ssl.conf"
        mode: 0644
      notify:
        - Test httpd configuration validity
        - Restart httpd
    - name: Configure redirect from http to https
      template:
        src: default_vhost.conf.j2
        dest: "{{ httpd_config_directory }}/{{ default_vhost_conf }}"
        mode: 0644
      notify:
        - Test httpd configuration validity
        - Restart httpd
  vars:
    httpd_config_directory: /etc/httpd
    default_vhost_conf: 000-default.conf


