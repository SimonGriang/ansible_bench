---
- import_tasks: assert.yml

- name: Task 2 - Install mysql
  package:
    name: "{{ packages }}"
    state: present
  notify:
  - root password
  - systemctl daemon-reload

- name: Task 3 - Configure mysql server
  ini_file:
    dest: /etc/mysql/my.cnf
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0644
    backup: yes
  loop:
    - section: mysqld
      option: bind-address
      value: 0.0.0.0
    - section: mysqld
      option: sql_mode
      value: "{{ sql_mode }}"
  notify: restart mysql

- name: Task 4 - Configure mysql client
  ini_file:
    dest: /etc/mysql/my.cnf
    section: client
    option: socket
    value: /var/run/mysqld/mysqld.sock
    mode: 0644
    backup: yes

- name: Task 5 - Initialize mysql
  command: mysql_install_db
  args:
    creates: /var/lib/mysql/mysql

- name: Task 6 - Start and enable mysql
  service:
    name: "{{ service_name }}"
    state: started
    enabled: yes

- name: Task 7 - Flush handlers
  meta: flush_handlers

- name: Task 8 - Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644

- name: Task 9 - Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ databases }}"
  when: initial_import is not defined

- name: Task 10 - List databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ databases }}"
  register: mysql_db_check

- name: Task 11 - Import database
  command: "mysql -u root {{ item }} < {{ initial_import }}/"
  loop: "{{ mysql_db_check.results }}"
  changed_when: false
  when:
    - initial_import is defined
    - item.changed

- name: Task 12 - Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
    update_password: "{{ item.update_password | default('always') }}"
  loop: "{{ users }}"
  notify: restart mysql

- name: Task 13 - Flush handlers again
  meta: flush_handlers


