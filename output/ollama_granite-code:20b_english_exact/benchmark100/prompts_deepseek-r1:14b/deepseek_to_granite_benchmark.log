---
- name: Promtail Installation
  hosts: all
  tasks:
    - name: Install unzip package
      apt:
        name: unzip
        state: present

    - name: Create system group for promtail
      group:
        name: promtail
        state: present

    - name: Create system user for promtail
      user:
        name: promtail
        group: promtail
        groups: adm,dialout,cdrom,floppy,sudo,audio,video,plugdev,netdev,games,users,input,netdev,ssh
        append: yes
        createhome: yes
        shell: /bin/bash

    - name: Ensure /usr/local/bin directory exists
      file:
        path: /usr/local/bin
        state: directory
        owner: root
        group: root
        mode: 0755

    - name: Create config directories
      file:
        path: "{{ item }}"
        state: directory
        owner: promtail
        group: promtail
        mode: 0750
      with_items:
        - /etc/promtail
        - /etc/promtail/positions
        - /etc/promtail/scrape_configs

    - name: Create application directories
      file:
        path: "{{ item }}"
        state: directory
        owner: promtail
        group: promtail
        mode: 0755
      with_items:
        - /usr/local/promtail
        - /usr/local/promtail/positions
        - /var/log/promtail

    - name: Check promtail binary existence
      stat:
        path: /usr/local/bin/promtail
      register: promtail_binary

    - name: Download promtail binaries
      get_url:
        url: "{{ item.url }}"
        dest: "{{ item.dest }}"
        owner: promtail
        group: promtail
        mode: 0640
        checksum: "{{ item.checksum }}"
      with_items:
        - url: https://github.com/grafana/loki/releases/download/v2.3.0/promtail-linux-amd64.zip
          dest: /tmp/promtail-linux-amd64.zip
          checksum: sha256:1234567890abcdef
        - url: https://github.com/grafana/loki/releases/download/v2.3.0/promtail-linux-arm64.zip
          dest: /tmp/promtail-linux-arm64.zip
          checksum: sha256:0987654321fedcba
      when: not promtail_binary.stat.exists

    - name: Propagate local promtail binaries
      copy:
        src: "{{ item }}"
        dest: /tmp
        owner: promtail
        group: promtail
        mode: 0640
      with_items:
        - /usr/local/bin/promtail
        - /usr/local/promtail/positions
        - /var/log/promtail
      when: not promtail_binary.stat.exists

    - name: Download promtail binaries for controller node
      get_url:
        url: "{{ item }}"
        dest: /tmp
      with_items:
        - https://github.com/grafana/loki/releases/download/v2.3.0/promtail-linux-amd64.zip
        - https://github.com/grafana/loki/releases/download/v2.3.0/promtail-linux-arm64.zip

    - name: Propagate promtail binaries
      copy:
        src: /tmp/promtail-linux-amd64.zip
        dest: /tmp
        owner: promtail
        group: promtail
        mode: 0640
      when: not promtail_binary.stat.exists

    - name: Unpack promtail binaries
      unarchive:
        src: /tmp/promtail-linux-amd64.zip
        dest: /tmp
        owner: promtail
        group: promtail
        mode: 0750
        remote_src: yes
      when: not promtail_binary.stat.exists

    - name: Create symlink to latest promtail version
      file:
        src: /tmp/promtail-linux-amd64
        dest: /usr/local/bin/promtail
        owner: promtail
        group: promtail
        state: link
      notify: restart promtail
      when: not promtail_binary.stat.exists

    - name: Write promtail config file
      template:
        src: promtail.yml.j2
        dest: /etc/promtail/promtail.yml
        owner: root
        group: promtail
        mode: 0640
      notify: restart promtail

    - name: Create systemd service unit
      template:
        src: promtail.service.j2
        dest: /etc/systemd/system/promtail.service
        owner: root
        group: root
        mode: 0644
      notify: restart promtail

  handlers:
    - name: restart promtail
      systemd:
        name: promtail
        state: restarted


