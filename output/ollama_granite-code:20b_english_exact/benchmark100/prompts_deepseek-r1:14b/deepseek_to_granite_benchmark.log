---
- name: locations | Enable modules
  apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  notify: httpd configuration test
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"

- name: locations | Configure locations
  template:
    src: "{{ item.template }}"
    dest: "/etc/httpd/conf.d/{{ item.filename }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ httpd_locations }}"
  notify: httpd restart
  tags:
    - configuration


