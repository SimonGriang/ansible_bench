- name: Task 1 - Import assert.yml
  import_tasks: assert.yml

- name: Task 2 - Uninstall conflicting systemd-logger
  ansible.builtin.package:
    name: systemd-logger
    state: absent
  notify: Restart rsyslog handler

- name: Task 3 - Install rsyslog
  ansible.builtin.package:
    name: "{{ rsyslog_packages }}"
    state: "{{ rsyslog_package_state }}"
  notify: Restart rsyslog handler

- name: Task 4 - Install additional rsyslog packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features }}"
  notify: Restart rsyslog handler

- name: Task 5 - Configuring default rsyslog
  ansible.builtin.template:
    src: "{{ rsyslog_config_file_format }}"
    dest: "{{ rsyslog_dest_conf_file }}"
    owner: root
    group: root
