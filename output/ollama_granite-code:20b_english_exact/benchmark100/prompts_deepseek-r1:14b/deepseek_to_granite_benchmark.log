---
- name: Include tasks for Keepalived installation
  include_tasks: keepalived.yml
  when: ha_enabled and ha_mode != "none" and groups['keepalived'] is defined

- name: Download and install RKE2
  command: /usr/bin/rke2-install.sh --version v1.24.5+rke2r1

- name: Include tasks for CIS hardening
  include_tasks: cis.yml
  when: cis_profile is defined

- name: Find active server
  command: /bin/hostname

- name: Enable IPVS kernel module
  modprobe:
    name: ip_vs
    state: present
  when: ha_enabled and ha_mode != "none" and groups['keepalived'] is defined

- name: Copy kube-vip manifests
  command: /bin/cp /path/to/kube-vip.yaml /etc/kubernetes/manifests
  when: ha_enabled and ha_mode != "none" and groups['kube_control_plane'] is defined and groups['kube_node'] is defined

- name: Copy ingress-nginx manifests
