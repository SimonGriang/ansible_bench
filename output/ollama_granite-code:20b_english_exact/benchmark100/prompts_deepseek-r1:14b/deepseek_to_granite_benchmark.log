content='---\n- name: Check Java certificates\n  hosts: all\n  tasks:\n    - name: Verify Java certificates\n      stat:\n        path: "{{ item }}"\n      loop: "{{ java_certs }}"\n      register: java_certs_stats\n    - name: Fail if Java certificates are missing\n      fail:\n        msg: "Missing Java certificate: {{ item.item }}"\n      loop: "{{ java_certs_stats.results }}"\n      when: not item.stat.exists\n\n- name: Set keystore directory\n  hosts: all\n  tasks:\n    - name: Set keystore directory for Java versions less than 11\n      set_fact:\n        java_keystore_dir: "/etc/ssl/certs"\n      when: ansible_distribution_major_version | int < 11\n    - name: Set keystore directory for Java versions 11 or newer\n      set_fact:\n        java_keystore_dir: "/etc/ssl/certs/java"\n      when: ansible_distribution_major_version | int >= 11\n\n- name: Import SSL certificates into Java keystore\n  hosts: all\n  tasks:\n    - name: Import SSL certificates into Java keystore\n      java_import_certificate:\n        certificate_path: "{{ item.path }}"\n        alias: "{{ item.alias }}"\n        keystore_path: "{{ java_keystore_dir }}/java-cacerts"\n        keystore_pass: "changeit"\n        state: present\n      loop: "{{ ssl_certs }}"' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-10T09:34:46.298214181Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4927778854, 'load_duration': 30268688, 'prompt_eval_count': 490, 'prompt_eval_duration': 159563116, 'eval_count': 303, 'eval_duration': 4737234050, 'model_name': 'granite-code:20b'} id='run--9bbf535a-d1a0-4d43-b2d2-22a73208dfe2-0' usage_metadata={'input_tokens': 490, 'output_tokens': 303, 'total_tokens': 793}
