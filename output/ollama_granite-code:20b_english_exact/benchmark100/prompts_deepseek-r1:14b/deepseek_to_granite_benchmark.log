---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: "{{ dns_dir_mode }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_config_dir }}"
    - "{{ dns_data_dir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true

- name: Generate rndc key
  shell: "dnssec-keygen -C -r /dev/urandom -a HMAC-MD5 -b 512 -n HOST {{ dns_config_dir }}/rndc.key"
  args:
    creates: "{{ dns_config_dir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_config_dir }}/rndc.key"
    owner: root
    group: "{{ dns_group }}"
    mode: "0640"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_ hints }}"
    dest: "{{ dns_data_dir }}/root.hints"
    mode: "0644"
  when: dns_caching_dns

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_data_dir }}/{{ item }}.db"
    mode: "0644"
    validate: "/usr/sbin/rndc checkzone -q {{ item }}.db"
    owner: root
    group: "{{ dns_group }}"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_config_dir }}/named.conf"
    mode: "0644"
    owner: root
    group: "{{ dns_group }}"
  notify: Restart dns

- name: Place systemd override
  template:
    src: systemd.j2
    dest: "{{ dns_config_dir }}/systemd.conf"
    mode: "0644"
  notify: Reload systemd
  when: dns_systemd_units

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


