ount': 463, 'eval_duration': 8105068100, 'model_name': 'granite-code:20b'} id='run--be5fc31d-c9a6-4bce-8e95-eebeb90235fd-0' usage_metadata={'input_tokens': 447, 'output_tokens': 463, 'total_tokens': 910}
