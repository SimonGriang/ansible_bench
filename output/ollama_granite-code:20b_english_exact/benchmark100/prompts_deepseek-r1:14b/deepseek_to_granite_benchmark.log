---
- name: Task 1 - Import assert.yml file
  import_tasks: assert.yml
  run_once: true

- name: Task 2 - Enable Redis module stream for RHEL 8
  when: ansible_distribution == "CentOS" and ansible_distribution_major_version | int >= 8
  block:
    - name: Enable Redis module stream
      dnf:
        name: redis
        enablerepo: powertools

- name: Task 3 - Install Redis package
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Task 4 - Configure Redis settings
  template:
    src: redis.conf-{{ ansible_distribution }}.j2
    dest: /etc/redis.conf
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: restart redis

- name: Task 5 - Start and enable Redis service
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


