---
- name: gather_facts | Lookup bootstrap facts
  setup:
    filter: ansible_local
    gather_subset: ansible_local
    fact_path: "/etc/ansible/facts.d"

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    ansible_distribution: "{{ ansible_local.system. distribution }}"
    ansible_distribution_major_version: "{{ ansible_local.system.distribution_major_version }}"

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    ansible_os_family: "{{ _os_family[ansible_distribution] | default(ansible_distribution) }}"
  vars:
    _os_family:
      Debian: Debian
      RedHat: RedHat
      CentOS: RedHat
      Fedora: RedHat
      default: "{{ ansible_distribution }}"



