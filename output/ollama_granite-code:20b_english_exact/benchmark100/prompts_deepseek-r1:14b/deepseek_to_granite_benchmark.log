---
- name: Create OpenSSL private key
  openssl_privatekey:
    path: "{{ key_dir }}/{{ key_name }}.key"
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"

- name: Create OpenSSL CSR
  openssl_csr:
    path: "{{ key_dir }}/{{ key_name }}.csr"
    privatekey_path: "{{ key_dir }}/{{ key_name }}.key"
    common_name: "{{ key_CN }}"
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"

- name: Create OpenSSL X509 certificate
  openssl_certificate:
    path: "{{ key_dir }}/{{ key_name }}.crt"
    privatekey_path: "{{ key_dir }}/{{ key_name }}.key"
    csr_path: "{{ key_dir }}/{{ key_name }}.csr"
    provider: selfsigned
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ key_dir }}/{{ key_name }}.p12"
    privatekey_path: "{{ key_dir }}/{{ key_name }}.key"
    certificate_path: "{{ key_dir }}/{{ key_name }}.crt"
    friendly_name: "{{ key_CN }}"
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"

- name: Read private key content
  slurp:
    src: "{{ key_dir }}/{{ key_name }}.key"
  register: private_key_content

- name: Read certificate content
  slurp:
    src: "{{ key_dir }}/{{ key_name }}.crt"
  register: certificate_content

- name: Create combined private key and certificate file
  copy:
    content: "{{ private_key_content['content'] }}{{ certificate_content['content'] }}"
    dest: "{{ key_dir }}/{{ key_name }}_combined.pem"
    mode: "{{ key_mode }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"


