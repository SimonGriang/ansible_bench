---
- import_tasks: assert.yml
- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify: Set root password
- name: Configure mysql server
  ini_file:
    dest: /etc/mysql/my.cnf
    section: server
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0644
    backup: yes
  with_items: "{{ mysql_configuration_options }}"
  notify: Restart mysql server
- name: Configure mysql client
  ini_file:
    dest: /etc/mysql/my.cnf
    section: client
    option: socket
    value: /var/run/mysqld/mysqld.sock
    mode: 0644
    backup: yes
- name: Initialize mysql
  command: mysql_install_db
  args:
    creates: /var/lib/mysql/mysql
  when: ansible_os_family == "Debian"
- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes
- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644
- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  with_items: "{{ mysql_databases }}"
  when: mysql_databases is defined
- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items: "{{ mysql_users }}"
  when: mysql_users is defined
- name: Flush handlers again
  meta: flush_handlers


