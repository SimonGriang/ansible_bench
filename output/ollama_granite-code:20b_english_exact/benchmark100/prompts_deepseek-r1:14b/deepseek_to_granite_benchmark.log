---
- name: Task 1 - Import assertion file
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Task 3 - Configure cron shell
  lineinfile:
    path: /etc/cron.d/cron
    regexp: "^SHELL="
    line: "SHELL={{ cron_shell }}"
    state: present
    backup: true
  notify: restart cron

- name: Task 4 - Configure cron path
  lineinfile:
    path: /etc/cron.d/cron
    regexp: "^PATH="
    line: "PATH={{ cron_path }}"
    state: present
    backup: true
  notify: restart cron

- name: Task 5 - Configure cron mailto
  lineinfile:
    path: /etc/cron.d/cron
    regexp: "^MAILTO="
    line: "MAILTO={{ cron_mailto }}"
    state: present
    backup: true
  notify: restart cron

- name: Task 6 - Start and enable cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service | length > 0

- name: Task 7 - Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    state: present
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "Schedule {{ item.name }} cron job"


