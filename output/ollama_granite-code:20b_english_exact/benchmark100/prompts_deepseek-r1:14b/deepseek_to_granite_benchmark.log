content='---\n- name: Create docroot directories for each virtual host\n  file:\n    path: "{{ httpd_vhosts_directory }}/{{ item.name }}/docroot"\n    state: directory\n    mode: 0755\n  when:\n    - httpd_vhosts is defined\n    - item.documentroot is defined\n    - create_docroot\n  loop: "{{ httpd_vhosts }}"\n\n- name: Configure virtual host settings\n  template:\n    src: vhost_conf_template\n    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"\n    mode: 0644\n  loop: "{{ httpd_vhosts }}"\n\n- name: Enable virtual hosts on Debian systems\n  command: a2ensite {{ item.name }}.conf\n  args:\n    creates: "/etc/apache2/sites-enabled/{{ item.name }}.conf"\n  notify: Test httpd configuration validity\n  notify: Restart httpd\n  loop: "{{ httpd_vhosts }}"\n  when: ansible_os_family == "Debian"' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-20T00:17:28.597317893Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4349488597, 'load_duration': 40935811, 'prompt_eval_count': 505, 'prompt_eval_duration': 190485361, 'eval_count': 229, 'eval_duration': 4116327091, 'model_name': 'granite-code:20b'} id='run--59988723-2b80-40a4-81f4-c1578759b461-0' usage_metadata={'input_tokens': 505, 'output_tokens': 229, 'total_tokens': 734}
