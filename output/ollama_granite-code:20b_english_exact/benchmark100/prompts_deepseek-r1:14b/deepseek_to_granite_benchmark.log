---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - bootstrap_connection not in [ "container", "docker", "community.docker.docker" ]
    - not bootstrap_skip_tags | select | match("wait")

- name: Prepare system
  block:
    - name: Test connection
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: connection_gather_result
      until: connection_gather_result is succeeded
      retries: 10

    - name: Test sudo version
      command: sudo --version
      changed_when: false
      register: sudo_version_result
      failed_when:
        - sudo_version_result.rc != 0
        - bootstrap_skip_tags | select | match("sudo")
      when: not bootstrap_skip_tags | select | match("sudo")

    - name: Gather ansible facts
      setup: # without become
        gather_subset: all

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      become: "{{ bootstrap_become }}"
      register: bootstrap_packages_result
      until: bootstrap_packages_result is succeeded
      retries: 10
      delay: 5
      when: not bootstrap_skip_tags | select | match("packages")
  rescue:
    - name: Gather ansible facts
      setup: # without become
        gather_subset: all

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      become: "{{ bootstrap_become }}"
      register: bootstrap_packages_result
      until: bootstrap_packages_result is succeeded
      retries: 10
      delay: 5
      when: not bootstrap_skip_tags | select | match("packages")

- name: Gather ansible facts
  setup: # without become
    gather_subset: all

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"
  register: bootstrap_packages_result
  until: bootstrap_packages_result is succeeded
  retries: 10
  delay: 5
  when: not bootstrap_skip_tags | select | match("packages")


