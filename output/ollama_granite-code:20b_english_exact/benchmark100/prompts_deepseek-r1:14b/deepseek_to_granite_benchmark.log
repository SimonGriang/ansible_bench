          with_items: "{{ java_yum_key_repositories }}"

        - name: Add required repositories
          copy:
            content: "{{ item }}"
            dest: "/etc/yum.repos.d/{{ item | basename }}"
          with_items: "{{ java_yum_repositories }}"
      when: ansible_os_family == "RedHat"

    - name: Install required libs
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ java_libs }}"

    - name: Install Java, Debian
      apt:
        name: "{{ java_package }}"
        state: present
        update_cache: true
      when: ansible_os_family == "Debian"

    - name: Install Java, RedHat
      yum:
        name: "{{ java_package }}"
        state: present
      when: ansible_os_family == "RedHat"

    - name: Export environment variables
      template:
        src: java.sh.j2
        dest: "{{ java_ alternatives_path }}/java.sh"
        mode: 0755

    - name: Source environment variables
      shell:
        cmd: "source {{ java_alternatives_path }}/java.sh"
        executable: /bin/bash

    - name: Correct java version selected for Java < 11
      alternatives:
        name: java
        link: /usr/bin/java
        path: "{{ java_home }}/bin/java"
      when: java_version | float < 11

    - name: Correct java version selected for Java >= 11
      alternatives:
        name: java
        link: /usr/bin/java
        path: /usr/lib/jvm/java-11-openjdk-$(uname -m)/bin/java
      when: java_version | float >= 11


