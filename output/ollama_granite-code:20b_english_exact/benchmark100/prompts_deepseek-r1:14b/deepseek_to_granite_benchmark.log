          vars:
            ansible_python_interpreter: "python3"
      when: "rke2_cni != 'none'"

    - name: "Task 14: Restore etcd"
      block:
        - name: "14.1 Clean up old etcd data"
          file:
            path: "/var/lib/rke2/agent/etc/etcd"
            state: "absent"

        - name: "14.2 Clean up old etcd data"
          file:
            path: "/etc/kubernetes/pki"
            state: "absent"

        - name: "14.3 Clean up old etcd data"
          file:
            path: "/etc/cni/net.d"
            state: "absent"

