    name: "{{ logrotate_packages }}"
    state: present
  tags:
    - logrotate
    - logrotate_packages

- name: Configure logrotate
  template:
    src: "{{ logrotate_config_file }}.j2"
    dest: "{{ logrotate_config_file }}"
    mode: 0644
  tags:
    - logrotate
    - logrotate_config

- name: Generate logrotate.d files
  template:
    src: "{{ item.name }}.j2"
    dest: "{{ logrotate_config_dir }}/{{ item.name }}"
    mode: 0644
  with_items: "{{ logrotate_entries }}"
  loop_control:
    label: "Generate logrotate.d/{{ item.name }}"
  tags:
    - logrotate
    - logrotate_config
    - logrotate_config_logrotate_d
  when: item.absent is not defined or not item.absent

- name: Remove logrotate.d files
  file:
    path: "{{ logrotate_config_dir }}/{{ item.name }}"
    state: absent
  with_items: "{{ logrotate_entries }}"
  loop_control:
    label: "Remove logrotate.d/{{ item.name }}"
  tags:
    - logrotate
    - logrotate_config
    - logrotate_config_logrotate_d
  when: item.absent is defined and item.absent

- name: Start logrotate
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  tags:
    - logrotate
    - logrotate_service


