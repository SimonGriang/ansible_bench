---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Pre-configure debian systems
  block:
    - name: Configure debconf settings for postfix on Debian systems
      ansible.builtin.debconf:
        name: "{{ item.name }}"
        value: "{{ item.value }}"
        vtype: "{{ item.vtype }}"
      loop:
        - name: postfix
          value: "postfix"
          vtype: string
        - name: postfix/main_mailer_type
          value: "Internet Site"
          vtype: string
  when: ansible_os_family == 'Debian'

- name: Install postfix
  ansible.builtin.package:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present
  when: postfix_mysql_config|bool

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: "0644"
    owner: root
    group: root
    validate: '/usr/sbin/postmap %s'
  notify: restart postfix
  no_log: yes

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: "0644"
    owner: root
    group: root
    validate: '/usr/sbin/postconf -c "header_checks=regexp:/etc/postfix/header_checks"'
  notify: reload postfix
  no_log: yes

- name: Setting values for main.cf (1/2)
  ansible.builtin.set_fact:
    postfix_main_cf_recipient_restrictions: "{{ lookup('file', 'recipient_restrictions.j2') }}"
  no_log: yes

- name: Setting values for main.cf (2/2)
  ansible.builtin.set_fact:
    postfix_main_cf_sender_restrictions: "{{ lookup('file', 'sender_restrictions.j2') }}"
  no_log: yes

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: "0644"
    owner: root
    group: root
    validate: '/usr/sbin/postconf -c %s'
  notify: restart postfix
  no_log: yes

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: "0644"
    owner: root
    group: root
    validate: '/usr/sbin/postconf -c %s'
  notify: restart postfix
  no_log: yes

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ postfix_tls_cert_dir }}"
    state: directory
    owner: "{{ postfix_tls_cert_owner }}"
    group: "{{ postfix_tls_cert_group }}"
    mode: "{{ postfix_tls_cert_mode }}"

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_tls_server_cert }}"
    dest: "{{ postfix_tls_cert_file }}"
    owner: "{{ postfix_tls_cert_owner }}"
    group: "{{ postfix_tls_cert_group }}"
    mode: "{{ postfix_tls_cert_mode }}"
    validate: '/usr/sbin/postmaphash %s'
  notify: reload postfix
  no_log: yes

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_tls_server_key }}"
    dest: "{{ postfix_tls_key_file }}"
    owner: "{{ postfix_tls_key_owner }}"
    group: "{{ postfix_tls_key_group }}"
    mode: "{{ postfix_tls_key_mode }}"
  notify: reload postfix
  no_log: yes

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure aliases
  ansible.builtin.blockinfile:
    path: /etc/aliases
    block: "{{ lookup('file', 'aliases.j2') }}"
    create: yes
    mode: "0644"
    owner: root
    group: root
    validate: '/usr/bin/newaliases -v'
  notify:
    - reload postfix
    - rebuild postfix aliases
  no_log: yes

- name: Configure sender_access
  ansible.builtin.template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: "0644"
    owner: root
    group: root
    validate: '/usr/sbin/postconf -c "sender_access=regexp:/etc/postfix/sender_access"'
  notify:
    - reload postfix
    - rebuild postfix sender_access
  no_log: yes

- name: Configure recipient_access
  ansible.builtin.template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: "0644"
    owner: root
    group: root
    validate: '/usr/sbin/postconf -c "recipient_access=regexp:/etc/postfix/recipient_access"'
  notify:
    - reload postfix
    - rebuild postfix recipient_access
    - validate postfix recipient_access
  no_log: yes

- name: Place sasl_password_map
  ansible.builtin.copy:
    content: "{{ lookup('file', 'sasl_password_map.j2') }}"
    dest: "{{ postfix_sasl_password_map }}"
    owner: root
    group: root
    mode: "0640"
    backup: yes
  notify:
    - rebuild sasl_password_map
  no_log: yes

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Start and enable postfix
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: yes
