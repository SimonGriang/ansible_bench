---
- name: "CIS - 2.2.1 Ensure etcd group is created"
  ansible.builtin.group:
    name: etcd
    state: present

- name: "CIS - 2.2.2 Ensure etcd user is created"
  ansible.builtin.user:
    name: etcd
    shell: /bin/nologin
    group: etcd
    comment: etcd user
    state: present

- name: "CIS - 2.2.3 Ensure etcd directories are created"
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: etcd
    group: etcd
    mode: 0750
  loop:
    - /var/lib/etcd
    - /etc/kubernetes/manifests

- name: "CIS - 2.2.4 Ensure etcd key directories are created"
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: etcd
    group: etcd
    mode: 0700
  loop:
    - /etc/kubernetes/ssl/etcd
    - /var/lib/etcd

- name: "CIS - 2.2.5 Ensure etcd data directory permissions are set to 700"
  ansible.builtin.file:
    path: /var/lib/etcd
    state: directory
    owner: etcd
