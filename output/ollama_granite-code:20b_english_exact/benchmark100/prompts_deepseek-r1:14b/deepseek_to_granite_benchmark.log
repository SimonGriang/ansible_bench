---

- name: Assert
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Install system requirements
  package:
    name: bash
    state: present

- when: java_vendor == "openjdk"
  block:
    - name: Install OpenJDK Java
      package:
        name: "{{ java_package }}"
        state: present

- when:
    - java_source == "local"
    - java_format == "rpm"
  block:
    - name: Copy and install Oracle Java RPM package
      copy:
        src: "{{ java_local_path }}"
        dest: /tmp
      notify: Install Oracle Java RPM package
    - name: Install Oracle Java RPM package
      package:
        name: /tmp/{{ java_filename }}
        state: present

- when:
    - java_source == "local"
    - java_format == "deb"
  block:
    - name: Copy and install Oracle Java DEB package
      copy:
        src: "{{ java_local_path }}"
        dest: /tmp
      notify: Install Oracle Java DEB package
    - name: Install Oracle Java DEB package
      apt:
        deb: /tmp/{{ java_filename }}
        state: present

- when:
    - java_source == "repository"
    - java_format == "rpm"
  block:
    - name: Install Oracle Java RPM package
      package:
        name: "{{ java_package }}"
        state: present

- when:
    - java_format == "targz"
    - java_vendor == "oracle"
  block:
    - name: Extract and install Oracle Java targz package
      unarchive:
        src: "{{ java_local_path }}"
        dest: /opt
        remote_src: yes
      notify: Configure Oracle Java targz installation
    - name: Configure Oracle Java targz installation
      command: alternatives --install /usr/bin/java java /opt/jdk1.8.0_{{ java_version }} /usr/bin/java{{ java_version }} 1
      args:
        creates: /etc/ alternatives/java
      notify: Install Oracle Java JCE policy
    - name: Install Oracle Java JCE policy
      copy:
        src: "{{ java_jce_local_path }}"
        dest: /tmp
      notify: Set Java alternative
    - name: Set Java alternative
      alternatives:
        name: java
        link: /usr/bin/java
        path: /opt/jdk1.8.0_{{ java_version }}/bin/java

- when:
    - java_format == "targz"
    - java_vendor == "oracle"
  block:
    - name: Find Java home directory
      command: readlink -f /usr/bin/java
      register: java_home
    - name: Set JAVA_HOME in environment
      lineinfile:
        dest: /etc/profile.d/java_home.sh
        line: 'export JAVA_HOME="{{ java_home.stdout }}"'
        create: yes


