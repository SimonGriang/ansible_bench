content='---\n- name: Check if Java certificates exist\n  stat:\n    path: "{{ item }}"\n  loop: "{{ java_certs }}"\n  register: java_certs_stat\n\n- name: Fail if Java certificates are missing\n  fail:\n    msg: "Java certificate {{ item }} is missing"\n  loop: "{{ java_certs }}"\n  when: not item.stat.exists\n\n- name: Set keystore directory for Java versions less than 11\n  set_fact:\n    java_keystore_dir: /usr/lib/jvm/java-8-openjdk/jre/lib/security\n  when: ansible_distribution_major_version | int < 11\n\n- name: Set keystore directory for Java versions 11 or newer\n  set_fact:\n    java_keystore_dir: /etc/ssl/certs\n  when: ansible_distribution_major_version | int >= 11\n\n- name: Import SSL certificates into Java keystore\n  become: yes\n  java_import_certificate:\n    path: "{{ item.path }}"\n    alias: "{{ item.alias }}"\n    keystore: "{{ java_keystore_dir }}/java/cacerts"\n    keystore_pass: changeit\n    state: present\n  loop: "{{ java_certs }}"\n  notify: restart java' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-20T00:38:31.36847068Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4342437997, 'load_duration': 25522843, 'prompt_eval_count': 490, 'prompt_eval_duration': 159081468, 'eval_count': 268, 'eval_duration': 4156425159, 'model_name': 'granite-code:20b'} id='run--804fdd86-bb17-4a64-834c-cef0392b83d1-0' usage_metadata={'input_tokens': 490, 'output_tokens': 268, 'total_tokens': 758}
