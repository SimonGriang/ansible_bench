---
- name: "RKE2 Bootstrap Playbook"
  tasks:
    - name: "Task 1: Create the RKE2 config directory"
      file:
        path: /etc/rke2
        state: directory
        owner: root
        group: root
        mode: 0755
    - name: "Task 2: Set server taints"
      command: "kubectl taint nodes --all node-role.kubernetes.io/master-"
      when: rke2_server
    - name: "Task 3: Copy RKE2 configuration file"
      copy:
        src: "{{ rke2_config_src }}"
        dest: /etc/rke2/config.yaml
        owner: root
        group: root
        mode: 0644
        backup: yes
      notify: restart rke2 service
    - name: "Task 4: Copy kubelet configuration file"
      copy:
        src: "{{ rke2_kubelet_config_src }}"
        dest: /var/lib/rke2/agent/etc/kubelet/kubelet-config.yaml
        owner: root
        group: root
        mode: 0644
        backup: yes
      when: rke2_kubelet_config | length > 0
      notify: restart rke2 service
    - name: "Task 5: Copy Containerd Registry Configuration file"
      copy:
        src: "{{ item }}"
        dest: /etc/rke2/registries.yaml
        owner: root
        group: root
        mode: 0644
        backup: yes
      register: rke2_registries
      until: not rke2_registries.changed
      when: rke2_registries_mirrors | length > 0 or rke2_registries_configs | length > 0
      notify: restart rke2 service
    - name: "Task 6: Register etcd restore from file"
      set_fact:
        etcd_local_restore: true
      when:
        - rke2_snapshot_file is defined
        - rke2_snapshot_file | length > 0
        - rke2_service_status.stdout == "active"
    - name: "Task 7: Register etcd restore from S3"
      set_fact:
        etcd_s3_restore: true
      when:
        - rke2_s3_access_key is defined
        - rke2_s3_secret_key is defined
        - rke2_s3_bucket is defined
        - rke2_s3_bucket | length > 0
        - rke2_s3_endpoint is defined
        - rke2_s3_endpoint | length > 0
        - rke2_service_status.stdout == "active"
    - name: "Task 8: Restore etcd from file"
      block:
        - name: "8a: Create etcd data directory"
          file:
            path: /var/lib/rke2/etc/etcd
            state: directory
            owner: root
            group: root
            mode: 0700
        - name: "8b: Create etcd data backup directory"
          file:
            path: /var/lib/rke2/backup/etcd
            state: directory
            owner: root
            group: root
            mode: 0700
        - name: "8c: Copy snapshot file to backup directory"
          copy:
            src: "{{ rke2_snapshot_file }}"
            dest: /var/lib/rke2/backup/etcd/
            owner: root
            group: root
            mode: 0600
            backup: yes
        - name: "8d: Restore etcd snapshot"
          command: "rke2 etcd snapshot restore --name {{ inventory_hostname }} --config-file /etc/rke2/config.yaml --backup-dir /var/lib/rke2/backup/etcd --snapshot-name {{ rke2_snapshot_file | basename }} --insecure-skip-tls-verify"
      vars:
        ansible_ssh_pipelining: yes
      when: etcd_local_restore is defined and etcd_local_restore
    - name: "Task 9: Restore etcd from S3"
      block:
        - name: "9a: Create etcd data backup directory"
          file:
            path: /var/lib/rke2/backup/etcd
            state: directory
            owner: root
            group: root
            mode: 0700
        - name: "9b: Restore etcd snapshot"
          command: "rke2 etcd snapshot restore --name {{ inventory_hostname }} --config-file /etc/rke2/config.yaml --backup-dir /var/lib/rke2/backup/etcd --s3 --s3-access-key {{ rke2_s3_access_key }} --s3-secret-key {{ rke2_s3_secret_key }} --s3-bucket {{ rke2_s3_bucket }} --s3-endpoint {{ rke2_s3_endpoint }} --s3-skip-ssl-verify --s3-prefix {{ rke2_s3_prefix }} --insecure-skip-tls-verify"
      vars:
        ansible_ssh_pipelining: yes
      when: etcd_s3_restore is defined and etcd_s3_restore
    - name: "Task 10: Start RKE2 service"
      service:
        name: rke2-server
        state: started
        enabled: yes
        env:
          RKE2_TOKEN: "{{ rke2_token }}"
      notify: restart rke2 service
    - name: "Task 11: Mask RKE2 agent service"
      service:
        name: rke2-agent
        enabled: no
        state: stopped
    - name: "Task 12: Wait for first server to be ready (no CNI)"
      uri:
        url: https://localhost:6443/readyz
        method: GET
        validate_certs: no
        return_content: yes
      register: api_status
      until: api_status.content == "ok"
      retries: 60
      delay: 5
      no_log: yes
      when:
        - not rke2_cni
        - inventory_hostname == groups['rke2_cluster'][0]
    - name: "Task 13: Wait for first server to be ready (with CNI)"
      uri:
        url: https://localhost:6443/readyz
        method: GET
        validate_certs: no
        return_content: yes
      register: api_status
      until: api_status.content == "ok"
      retries: 60
      delay: 5
      no_log: yes
      when:
        - rke2_cni
        - inventory_hostname == groups['rke2_cluster'][0]
    - name: "Task 14: Restore etcd"
      block:
        - name: "14a: Cleanup old etcd data"
          file:
            path: /var/lib/rke2/agent/etc/kubernetes/etcd
            state: absent
        - name: "14b: Cleanup old etcd data"
          file:
            path: /var/lib/rke2/agent/etc/kubernetes/manifests/etcd.yaml
            state: absent
        - name: "14c: Cleanup old etcd data"
          file:
            path: /etc/cni/net.d/10- etcd.conflist
            state: absent
        - name: "14d: Cleanup old etcd data"
          file:
            path: /etc/cni/net.d/20-__:__CNI_QY__
            state: absent
        - name: "14e: Cleanup old etcd data"
          file:
            path: /etc/kubernetes/Manifests/etcd.yaml
            state: absent
      when:
        - (etcd_local_restore is defined and etcd_local_restore) or (etcd_s3_restore is defined and etcd_s3_restore)
    - name: "Task 15: Set Active Server variable"
      set_fact:
        rke2_active_server: "{{ inventory_hostname }}"
      delegate_to: "{{ item }}"
      delegate_facts: yes
      run_once: true
      with_items: "{{ groups['rke2_cluster'] }}"


