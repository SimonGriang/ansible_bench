---
- name: Generate private SSL key
  community.crypto.openssl_privatekey:
    path: /etc/ssl/private/example.com.key
    owner: root
    group: wheel
    mode: "0600"

- name: Generate CSR
  community.crypto.openssl_csr:
    path: /etc/ssl/csr/example.com.csr
    privatekey_path: /etc/ssl/private/example.com.key
    common_name: example.com
    organization_name: Example, Inc.
    country_name: US
    email_address: admin@example.com
    subject_alt_name:
      - DNS:example.com
      - DNS:www.example.com
    owner: root
    group: wheel
    mode: "0644"

- name: Generate self-signed SSL certificate
  community.crypto.x509_certificate:
    path: /etc/ssl/certs/example.com.crt
    privatekey_path: /etc/ssl/private/example.com.key
    csr_path: /etc/ssl/csr/example.com.csr
    owner: root
    group: wheel
    mode: "0644"

- name: Create PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: /etc/ssl/certs/example.com.p12
    privatekey_path: /etc/ssl/private/example.com.key
    certificate_path: /etc/ssl/certs/example.com.crt
    owner: root
    group: wheel
    mode: "0600"

- name: Read private key content
  ansible.builtin.slurp:
    src: /etc/ssl/private/example.com.key
  register: private_key

- name: Read certificate content
  ansible.builtin.slurp:
    src: /etc/ssl/certs/example.com.crt
  register: certificate

- name: Combine private key and certificate
  ansible.builtin.assemble:
    src: /etc/ssl/combined
    dest: /etc/ssl/combined/example.com.pem
    owner: root
    group: wheel
    mode: "0644"
    files:
      - /etc/ssl/private/example.com.key
      - /etc/ssl/certs/example.com.crt


