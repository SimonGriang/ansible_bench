---
- name: Remove Docker GPG key from trusted.gpg.d directory
  file:
    path: /etc/apt/trusted.gpg.d/docker-key.asc
    state: absent

- name: Remove old Docker source list from sources.list.d directory
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Remove obsolete Docker packages
  apt:
    name: docker
    state: absent

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install required dependencies
  apt:
    name: [apt-transport-https, ca-certificates, python3-debian]
    state: present

- name: Manage Docker repository
  deb822_repository:
    filename: docker
    name: docker
    state: "{{ 'present' if docker_add_repo else 'absent' }}"
    mode: 0644
    update_cache: true
    repo: "deb [arch={{ host_architecture }}] https://download.docker.com/linux/{{ ansible_distribution | lower }} {{ ansible_distribution_release }} stable"

- name: Flush handlers to update apt cache
  meta: flush_handlers


