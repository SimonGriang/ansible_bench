---

- name: Task 1 - Import assertion file
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Task 3 - Configure cron shell
  lineinfile:
    path: /etc/cron.conf
    regexp: "^SHELL="
    line: "SHELL=/bin/bash"
    state: present
    backup: true
  notify: restart cron

- name: Task 4 - Configure cron path
  lineinfile:
    path: /etc/cron.conf
    regexp: "^PATH="
    line: "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    state: present
    backup: true
  notify: restart cron

- name: Task 5 - Configure cron mailto
  lineinfile:
    path: /etc/cron.conf
    regexp: "^MAILTO="
    line: "MAILTO=root"
    state: present
    backup: true
  notify: restart cron

- name: Task 6 - Start and enable cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service

- name: Task 7 - Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    state: "{{ item.state }}"
  loop: "{{ cron_jobs }}"


