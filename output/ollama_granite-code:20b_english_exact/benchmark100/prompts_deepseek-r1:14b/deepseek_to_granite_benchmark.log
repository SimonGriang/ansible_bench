  when: ansible_distribution == "CentOS" and ansible_distribution_major_version == "8"
  tags:
  - skip_ansible_lint
  block:
  - name: Enable Redis module stream
    dnf:
      name: redis
      enablerepo: powertools
      state: present

- name: Install Redis
  tags:
  - skip_ansible_lint
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure Redis settings
  template:
