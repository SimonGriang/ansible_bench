          - "https://apt.releases.hashicorp.com/gpg"
        java_apt_keys:
          - "6A030B96CAA293F97B511D524334BDFFC84C328D"
        java_yum_repositories:
          - "https://yum.oracle.com/public-yum-ol7.repo"
        java_yum_keys:
          - "http://yum.oracle.com/RPM-GPG-KEY-oracle-ol7"
        java_libs:
          - liberation-fonts
          - libasound2
          - libatk-bridge2.0-0
          - libatk-wrapper
          - libXrender1
          - libXtst6
          - libxi6
          - libxtst6
          - rtl-math
    - name: Set OS and architecture specific variables (II)
      set_fact:
        java_package: "openjdk-{{ java_version }}"
        java_alternative: "/usr/lib/jvm/java-{{ java_version }}-openjdk-{{ java_arch }}-{% if ansible_os_family == 'Debian' %}jdk{% endif %}/"
        java_jre_home: "{{ java_alternative }}"
    - name: Install all required system libraries for OpenJDK
      package:
        name: "{{ java_libs }}"
        state: present
      when: java_libs is defined
    - name: Install OpenJDK on Debian-based systems using apt
      apt:
        name: "{{ java_package }}"
        state: present
        update_cache: yes
        cache_valid_time: 3600
        install_recommends: no
      when: ansible_os_family == "Debian"
    - name: Install OpenJDK on RedHat-based systems using yum
      yum:
        name: "{{ java_package }}"
        state: present
      when: ansible_os_family == "RedHat"
    - name: Create a configuration file to set Java environment variables
      copy:
        dest: /etc/profile.d/java.sh
        content: |
          export JAVA_HOME="{{ java_home }}"
          export PATH="{{ java_home }}/bin:$PATH"
      when: java_home is defined
    - name: Source the newly created environment variables file to apply changes
      shell: source /etc/profile.d/java.sh
      when: java_home is defined
    - name: Set the alternatives for java command to point to the JRE bin directory for Java versions less than 11
      alternatives:
        name: java
        path: "{{ java_jre_home }}/bin/java"
      when: java_version is version('11', '<')
    - name: Set the alternatives for java command to point to the bin directory for Java versions 11 and above
      alternatives:
        name: java
        path: "{{ java_home }}/bin/java"
      when: java_version is version('11', '>=')


