---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Enable Redis module stream for RHEL 8
  when: ansible_distribution == "CentOS" and ansible_distribution_major_version == "8"
  tags:
  - skip_ansible_lint
  block:
  - name: Enable Redis module stream
    dnf:
      name: redis
      enablerepo: powertools
      state: present

- name: Install Redis
  tags:
  - skip_ansible_lint
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure Redis settings
  template:
    src: redis.conf-{{ ansible_distribution }}.j2
    dest: /etc/redis.conf
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart Redis

- name: Start and enable Redis service
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


