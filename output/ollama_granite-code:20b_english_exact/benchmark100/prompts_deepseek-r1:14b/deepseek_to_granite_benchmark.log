---
- name: Create RKE2 configuration directory
  file:
    path: /etc/kubernetes/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  command: >
    rke2-server taint --taint-key node-role.kubernetes.io/server --taint-value "true:NoSchedule"
  when: rke2_type == "server"

- name: Set agent taints
  command: >
    rke2-server taint --taint-key node-role.kubernetes.io/agent --taint-value "true:NoSchedule"
  when: rke2_type == "agent"

- name: Copy RKE2 configuration file
  template:
    src: rke2.yaml.j2
    dest: /etc/kubernetes/rke2/rke2.yaml
    owner: root
    group: root
    mode: '0644'
  notify:
  - restart rke2

- name: Copy Kubelet configuration file
  template:
    src: kubelet.conf.j2
    dest: /var/lib/kubelet/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify:
  - restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: containerd-registry.service
    dest: /etc/systemd/system/containerd-registry.service
    owner: root
    group: root
    mode: '0644'
  notify:
  - restart containerd-registry

- name: Start RKE2 service on other nodes
  service:
    name: rke2-server
    state: started
    enabled: true
  when: inventory_hostname != ansible_play_hosts[0]
  notify:
  - restart rke2

- name: Mask other RKE2 services on nodes
  systemd:
    name: rke2-server
    enabled: false
    state: stopped
  when: rke2_type == "server"

- name: Mask other RKE2 services on nodes
  systemd:
    name: rke2-agent
    enabled: false
    state: stopped
  when: rke2_type == "agent"

- name: Wait for remaining nodes to be ready - no CNI
  command: >
    rke2-kubectl get node {{ inventory_hostname }}
    --kubeconfig /etc/kubernetes/rke2/rke2.yaml
  register: node_status
  until: node_status.stdout != ""
  retries: 60
  delay: 10
  when: rke2_cni == "none"

- name: Wait for remaining nodes to be ready - with CNI
  command: >
    rke2-kubectl get node {{ inventory_hostname }}
    --kubeconfig /etc/kubernetes/rke2/rke2.yaml
  register: node_status
  until: node_status.stdout != ""
  retries: 60
  delay: 10
  when: rke2_cni != "none"


