---
- name: Create local SSH key directory for user
  file:
    path: "/home/{{ user }}/.ssh"
    owner: "{{ user }}"
    group: "{{ user }}"
    mode: 0700
    state: directory

- name: Manage user account
  user:
    name: "{{ user }}"
    state: "{{ user_state }}"
    comment: "{{ user_comment }}"
    home: "{{ user_home }}"
    shell: "{{ user_shell }}"

- name: Set sudo options for user
  copy:
    dest: "/etc/sudoers.d/{{ user }}"
    content: "{{ sudoers_content }}"
    mode: 0440
    owner: root
    group: root
  when: sudoers_content is defined

- name: Generate private SSH key for user
  command: "ssh-keygen -t {{ ssh_key_type }} -b {{ ssh_key_bits }} -f /home/{{ user }}/.ssh/id_rsa -q -N ''"
  args:
    creates: "/home/{{ user }}/.ssh/id_rsa"

- name: Generate public SSH key for user
  command: "ssh-keygen -y -f /home/{{ user }}/.ssh/id_rsa > /home/{{ user }}/.ssh/id_rsa.pub"
  args:
    creates: "/home/{{ user }}/.ssh/id_rsa.pub"

- name: Convert SSH key to ppk format for user
  command: "puttygen /home/{{ user }}/.ssh/id_rsa -O private-openssh -o /home/{{ user }}/.ssh/id_rsa.ppk"
  args:
    creates: "/home/{{ user }}/.ssh/id_rsa.ppk"

- name: Get or set the home directory for user
  stat:
    path: "/home/{{ user }}"
  register: user_home_stat

- name: Create .ssh directory for user
  file:
    path: "/home/{{ user }}/.ssh"
    owner: "{{ user }}"
    group: "{{ user }}"
    mode: 0700
    state: directory
  when: not user_home_stat.stat.exists

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user }}"
    key: "{{ item }}"
    state: present
  with_items: "{{ authorized_keys }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user }}"
    key: "{{ item }}"
    state: absent
  with_items: "{{ unauthorized_keys }}"

- name: Copy generated private SSH key for user
  copy:
    src: "/home/{{ user }}/.ssh/id_rsa"
    dest: "/home/{{ user }}/.ssh/id_rsa"
    owner: "{{ user }}"
    group: "{{ user }}"

- name: Check users password valid time for user
  user:
    name: "{{ user }}"
    password_valid_days: "{{ password_valid_days }}"
  register: user_password_info

- name: Set users password valid time for user
  user:
    name: "{{ user }}"
    password_valid_days: "{{ password_valid_days }}"
  when: user_password_info.changed

- name: Place private key file for user
  copy:
    src: "{{ item }}"
    dest: "/home/{{ user }}/.ssh/"
    owner: "{{ user }}"
    group: "{{ user }}"
    mode: 0600
  with_items: "{{ private_key_files }}"


