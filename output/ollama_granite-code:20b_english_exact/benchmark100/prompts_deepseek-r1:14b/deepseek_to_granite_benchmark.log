---
- import_tasks: assert.yml
- name: Install mysql
  package:
    name: "{{ packages }}"
    state: present
  notify: root password
  notify: systemctl daemon-reload
- name: Configure mysql server
  lineinfile:
    dest: /etc/mysql/my.cnf
    line: "{{ item }}"
    regexp: "^{{ item.split('=')[0] }}="
    state: present
  loop: "{{ mysql_server_config }}"
  notify: mysql server restart
- name: Configure mysql client
  lineinfile:
    dest: /etc/mysql/my.cnf
    line: "socket = /var/run/mysqld/mysqld.sock"
    regexp: "^socket ="
    state: present
- name: Initialize mysql
  shell: mysql_install_db
  args:
    creates: /var/lib/mysql/mysql
- name: Start and enable mysql
  service:
    name: "{{ service_name }}"
    state: started
    enabled: yes
- name: Flush handlers
  meta: flush_handlers
- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644
- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ databases }}"
  when: initial_import is not defined
- name: List databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ databases }}"
  register: db_exists
- name: Import database
  mysql_db:
    name: "{{ item }}"
    state: import
    target: "{{ initial_import }}/{{ item }}.sql"
  loop: "{{ databases }}"
  when: db_exists.changed
- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  loop: "{{ mysql_users }}"
  notify: mysql server restart
- name: Flush handlers again
  meta: flush_handlers


