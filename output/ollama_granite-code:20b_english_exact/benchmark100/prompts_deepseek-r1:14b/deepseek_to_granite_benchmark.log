---
- import_playbook: assert.yml

- name: Task 2 - Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Task 3 - Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode | default(omit) }}"
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
  loop:
    - path: /var/lib/dns
      mode: "0755"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
    - path: "{{ dns_config_directory }}"
      mode: "0755"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"

- name: Task 4 - Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Task 5 - Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: yes
    groups: "{{ dns_group }}"

- name: Task 6 - Generate rndc key
  shell: "dnssec-keygen -C -r /dev/urandom -a HMAC-MD5 -b 512 -n HOST {{ dns_config_directory }}/rndc.key"

- name: Task 7 - Set permissions on rndc key file
  file:
    path: "{{ dns_config_directory }}/rndc.key*"
    mode: "0600"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"

- name: Task 8 - Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.cache
    dest: "{{ dns_config_directory }}/root. hints"
    mode: "0644"
  when: dns_caching_dns

- name: Task 9 - Create zone file
  template:
    src: "{{ item.src }}"
    dest: "{{ dns_config_directory }}/{{ item.dest }}"
    mode: "0644"
    validate: "/usr/sbin/rndc checkzone -q {{ item.dest }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - src: db.j2
      dest: example.com.db
    - src: db.j2
      dest: example.org.db
  notify: Rndc reload

- name: Task 10 - Add zones to configuration
  assemble:
    src: "{{ dns_config_directory }}"
    dest: "{{ dns_config_directory }}/{{ dns_config_file }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  notify: Restart dns

- name: Task 11 - Place systemd override
  template:
    src: systemd.j2
    dest: "{{ dns_config_directory }}/systemd.conf"
