p', 'total_duration': 9820143852, 'load_duration': 38833935, 'prompt_eval_count': 631, 'prompt_eval_duration': 475717592, 'eval_count': 461, 'eval_duration': 9303520327, 'model_name': 'granite-code:20b'} id='run--4ff34174-a3e5-422a-ba25-f9a22d8ddbcd-0' usage_metadata={'input_tokens': 631, 'output_tokens': 461, 'total_tokens': 1092}
