---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - connection is not defined or connection not in ["container", "docker", "community.docker.docker"]

- name: Prepare system
  block:
    - name: Test connection
      command: "true"
      changed_when: false
      timeout: "{{ bootstrap_timeout }}"
    - name: Test sudo version
      command: "sudo --version"
      changed_when: false
      timeout: "{{ bootstrap_timeout }}"
  rescue:
    - name: Gather facts
      setup:
    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      when: bootstrap_facts_packages is defined
      become: "{{ bootstrap_become }}"

- name: Gather ansible facts
  setup:
    fact_path: null
  become: false

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  when: bootstrap_facts_packages is defined
  become: "{{ bootstrap_become }}"


