---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_url }}/rke2-install.sh"
    dest: "{{ rke2_bin_path }}"
    mode: "0700"
  when: airgap and rke2_install_script_impl == "url"
  tags:
    - rke2

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_url }}/rke2-install.sh"
    dest: "{{ rke2_bin_path }}"
    mode: "0700"
  when: airgap and rke2_install_script_impl == "copy"
  tags:
    - rke2

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: "0700"
  when: airgap and rke2_artifacts_impl == "create"
  tags:
    - rke2

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum
      get_url:
        url: "{{ rke2_url }}/rke2-checksums.txt"
        dest: "{{ rke2_artifacts_path }}/rke2-checksums.txt"
      register: rke2_checksum_dl
      until: rke2_checksum_dl is succeeded
      retries: 3
      delay: 10
      delegate_to: localhost
      check_mode: false
      run_once: true

    - name: Verify RKE2 checksum
      command: >
        sha256sum -c {{ rke2_artifacts_path }}/rke2-checksums.txt
      args:
        warn: false
      changed_when: false
      register: rke2_checksum_verify
      failed_when: >
        rke2_checksum_verify.rc != 0 and "CKSUM" not in rke2_checksum_verify.stdout
      delegate_to: localhost
      check_mode: false
      run_once: true

    - name: Download RKE2 artifacts
      get_url:
        url: "{{ item.url }}"
        dest: "{{ item.path }}"
        mode: "0640"
      with_items: "{{ rke2_artifacts }}"
      loop_control:
        label: "{{ item.path }}"
      register: rke2_artifacts_dl
      until: rke2_artifacts_dl is succeeded
      retries: 3
      delay: 10
      delegate_to: localhost
      check_mode: false
      run_once: true

    - name: Fallback to local download
      copy:
        src: "{{ item.src }}"
        dest: "{{ item.dest }}"
        mode: "0640"
      with_items: "{{ rke2_artifacts }}"
      loop_control:
        label: "{{ item.dest }}"
      when: >
        rke2_artifacts_dl is failed and
        item.src is defined
      delegate_to: localhost
      run_once: true
  when: airgap and rke2_artifacts_impl == "url"
  tags:
    - rke2

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "0640"
  with_items: "{{ rke2_artifacts }}"
  loop_control:
    label: "{{ item.dest }}"
  when: airgap and rke2_artifacts_impl == "copy"
  tags:
    - rke2

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images folder
      file:
        path: "{{ rke2_airgap_images_path }}"
        state: directory
      delegate_to: localhost
      check_mode: false
      run_once: true

    - name: Copy additional images
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_airgap_images_path }}/"
      with_items: "{{ rke2_airgap_additional_tarballs }}"
      loop_control:
        label: "{{ item }}"
      delegate_to: localhost
      check_mode: false
      run_once: true
  when: airgap and rke2_airgap_additional_tarballs | length > 0
  tags:
    - rke2

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure artifacts exist
      stat:
        path: "{{ item }}"
      register: rke2_airgap_stat_result
      failed_when: >
        not rke2_airgap_stat_result.stat.exists
      with_items:
        - "{{ rke2_bin_path }}/rke2-install.sh"
        - "{{ rke2_artifacts_path }}/rke2.yaml"
      run_once: true
      delegate_to: localhost
      check_mode: false
      tags:
        - rke2

    - name: Set artifact permissions
      file:
        path: "{{ item.item }}"
        mode: "{{ item.stat.mode | string | regex_replace('^.*(7[0-5][0-5]).*$', '\\1') }}"
        group: "{{ item.stat.group }}"
        owner: "{{ item.stat.owner }}"
      with_items: "{{ rke2_airgap_stat_result.results }}"
      run_once: true
      delegate_to: localhost
      check_mode: false
      tags:
        - rke2

    - name: Set install script permissions
      file:
        path: "{{ rke2_bin_path }}/rke2-install.sh"
        mode: "0700"
      run_once: true
      delegate_to: localhost
      check_mode: false
      tags:
        - rke2
  when: airgap and rke2_artifacts_impl == "exists"
  tags:
    - rke2

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: "/usr/local"
  register: rke2_usr_local_stat_result
  check_mode: false

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin"
  when: >
    not rke2_usr_local_stat_result.stat.writeable and
    "usr_local_partition" in rke2_service_facts and
    "Mountpoint" in rke2_service_facts["usr_local_partition"] and
    rke2_service_facts["usr_local_partition"]["Mountpoint"] != "" and
    rke2_service_facts["usr_local_partition"]["Mountpoint"] != "/"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/bin"
  when: >
    not rke2_usr_local_stat_result.stat.writeable and
    "usr_local_partition" in rke2_service_facts and
    "Mountpoint" in rke2_service_facts["usr_local_partition"] and
    rke2_service_facts["usr_local_partition"]["Mountpoint"] == "/"

- name: Check RKE2 version
  shell: >
    set -o nounset -o pipefail &&
    {{ rke2_bin_path }}/rke2 version | grep -Eo 'rke2 v.*' | tr -d 'rke2 v' | awk -F '.' '{print $1"."$2}'
  args:
    warn: false
  changed_when: false
  register: rke2_installed_version

- name: Check RKE2 version
  shell: >
    set -o nounset -o pipefail &&
    echo "{{ rke2_version }}" | tr -d 'rke2 v' | awk -F '.' '{print $1"."$2}'
  changed_when: false
  register: rke2_running_version

- name: Prevent accidental RKE2 downgrade
  assert:
    that: >
      "{{ rke2_running_version.stdout }}" == "{{ rke2_installed_version.stdout }}"
    fail_msg: >
      Downgrade of RKE2 is not allowed unless explicitly permitted. Either downgrade rke2-server or allow downgrade with `rke2_allow_downgrade: true`
  when:
    - rke2_allow_downgrade | default(false) | bool
    - rke2_running_version.stdout is version_compare(rke2_installed_version.stdout, operator='!=')

- name: Run RKE2 install script
  command: >
    {{ rke2_bin_path }}/rke2-install.sh
      --install-system- Agent=true,Server=true,Force=true
      --insecure-port {{ rke2_insecure_port }}
      --port {{ rke2_port }}
      --token {{ rke2_token }}
      {% if rke2_url is defined %}--url {{ rke2_url }}{% endif %}
      {% if rke2_ca_password is defined %}--cluster-ca-cert-path {{ rke2_config_path }}/rke2-ca.crt{% endif %}
      {% if rke2_service_option_extra_args is defined %}--service-option {{ rke2_service_option_extra_args }}{% endif %}
      {% if rke2_extra_args is defined %}{{ rke2_extra_args }}{% endif %}
      {% if rke2_install_script_extra_args is defined %}{{ rke2_install_script_extra_args }}{% endif %}
  environment:
    INSTALL_RKE2_TYPE: {% if airgap %}airgap{% else %}online{% endif %}
    RKE2_VERSION: "{{ rke2_version }}"
    RKE2_CHECKSUM: "{{ rke2_checksum }}"
    RKE2_URL: "{{ rke2_url }}"
    SYSTEMD_UNITS: {% if rke2_config_systemd %}--disable{% else %}--enable{% endif %}
    AUDITD_UNITS: {% if rke2_config_auditd %}--disable{% else %}--enable{% endif %}
    KUBEADM_UNITS: {% if rke2_config_kubeadm %}--disable{% else %}--enable{% endif %}
    CERTS_LOCATION: "{{ rke2_config_path }}"
    INSECURE: {% if rke2_insecure %}--insecure{% endif %}
    AUDIT_LOG_PATH: "{{ rke2_config_path }}/audit-log.json"
    RKE2_ARTIFACTS_PATH: "{{ rke2_artifacts_path }}"
  when: airgap

