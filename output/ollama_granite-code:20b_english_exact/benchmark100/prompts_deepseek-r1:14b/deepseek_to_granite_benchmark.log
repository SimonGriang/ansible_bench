---
- name: Install unzip package
  apt:
    name: unzip
    state: present
  tags:
    - unzip

- name: Create system group for promtail
  become: true
  group:
    name: "{{ promtail_system_group }}"
    state: present
  tags:
    - promtail
    - group

- name: Create system user for promtail
  become: true
  user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    groups: "{{ promtail_system_additional_groups }}"
    createhome: true
    shell: /usr/sbin/nologin
    system: true
  tags:
    - promtail
    - user

- name: Ensure /usr/local/bin directory exists
  become: true
  file:
    path: /usr/local/bin
    state: directory
    owner: root
    group: root
    mode: 0755
  tags:
    - directory
    - promtail

- name: Create config directories
  become: true
  file:
    path: "{{ promtail_config_dir }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0750
  tags:
    - directory
    - promtail

- name: Create application directories
  become: true
  file:
    path: "{{ promtail_positions_dir }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0750
  tags:
    - directory
    - promtail

- name: Check promtail binary existence
  stat:
    path: "{{ promtail_install_dir }}/{{ promtail_system_binary }}"
  register: promtail_binary
  tags:
    - promtail
    - binary

- name: Download promtail binaries
  become: true
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_download_file }}"
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0640
    checksum: "{{ promtail_checksum }}"
  register: promtail_download
  until: promtail_download is succeeded
  retries: 3
  delay: 10
  tags:
    - promtail
    - download

- name: Propagate local promtail binaries
  become: true
  copy:
    src: "{{ promtail_tmp_dir }}/{{ item }}"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_install_dir }}/{{ item }}"
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0750
  loop:
    - "{{ promtail_system_binary }}"
    - "{{ promtail_system_binary }}.sha256"
  tags:
    - promtail
    - binary

- name: Download promtail binaries for controller node
  become: true
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_download_file }}"
    mode: 0640
    checksum: "{{ promtail_checksum }}"
  register: promtail_download
  until: promtail_download is succeeded
  retries: 3
  delay: 10
  tags:
    - promtail
    - download

- name: Propagate promtail binaries
  become: true
  copy:
    src: "{{ promtail_tmp_dir }}/{{ promtail_download_file }}"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_install_dir }}/{{ promtail_download_file }}"
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0750
  tags:
    - promtail
    - binary

- name: Unpack promtail binaries
  become: true
  unarchive:
    src: "{{ promtail_tmp_dir }}/{{ promtail_install_dir }}/{{ promtail_download_file }}"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_install_dir }}"
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    remote_src: true
  tags:
    - promtail
    - binary

- name: Create symlink to latest promtail version
  become: true
  file:
    src: "{{ promtail_install_dir }}/{{ promtail_system_binary }}-{{ promtail_version }}"
    dest: "{{ promtail_install_dir }}/{{ promtail_system_binary }}"
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    state: link
  notify: restart promtail
  tags:
    - promtail
    - binary

- name: Write promtail config file
  become: true
  template:
    src: promtail.yml.j2
    dest: "{{ promtail_config_dir }}/promtail.yml"
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0640
  notify: restart promtail
  tags:
    - promtail
    - config

- name: Create systemd service unit
  become: true
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: 0644
  notify: restart promtail
  tags:
    - promtail
    - systemd
