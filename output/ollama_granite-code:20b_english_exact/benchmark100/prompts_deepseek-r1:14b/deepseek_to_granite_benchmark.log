  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  selinux:
    policy: "{{ selinux_policy }}"
    state: "{{ selinux_state }}"
  notify: Reboot
  when: selinux_state != "disabled"

- name: Manage selinux booleans
  seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    persistent: true
  loop: "{{ selinux_booleans }}"
  notify: Reboot
  when: selinux_booleans is defined



