---
- name: Check if sealed
  hashivault_is_sealed:
  register: hashivault_is_sealed
- name: Unseal with all keys
  hashivault_unseal:
    key: "{{ item }}"
  loop: "{{ hashivault_seal_keys }}"
  when: hashivault_is_sealed['sealed']
- name: Enable kv v2 secret engine at default path
  hashivault_secret_enable:
    backend: kv
    version: 2
- name: Write database config
  hashivault_secret:
    secret: database/config
    data:
      plugin_name: mysql-database-plugin
      connection_url: "{{ hashivault_database_url }}"
      allowed_roles: "{{ hashivault_allowed_roles }}"
      username: "{{ hashivault_user }}"
      password: "{{ hashivault_password }}"
- name: Create policy to allow read on database
  hashivault_policy_write:
    name: allow_read
    rules: path "database/data/*" { capabilities = ["read"] }
- name: Write role with database read capability
  hashivault_role_write:
    name: readonly
    policy_document: allow_read
- name: Write user with readonly role
  hashivault_user_write:
    name: readonly
    password: "{{ hashivault_password }}"
    policies: readonly


