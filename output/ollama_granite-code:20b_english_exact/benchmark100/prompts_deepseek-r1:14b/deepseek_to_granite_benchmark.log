---
- name: Get latest release and set promtail version
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    return_content: yes
    status_code: 200
    body_format: json
  register: latest_release_raw

- name: Set promtail_version
  set_fact:
    promtail_version: "{{ latest_release_raw.json.tag_name }}"

- name: Test if zip local archive exists and assert local binary exists
  stat:
    path: "{{ promtail_local_dir }}/promtail_{{ promtail_version }}_{{ promtail_system_architecture }}.zip"
  register: local_archive_binary

- name: Get checksum list and set checksum for target architecture
  uri:
    url: https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail_checksums.txt
    method: GET
    return_content: yes
    status_code: 200
    body_format: text
  register: promtail_checksums_raw

- name: Set checksum for target architecture
  set_fact:
    promtail_checksum: "{{ promtail_checksums_raw.content.split('\n') | selectattr('split','equalto', promtail_system_architecture) | first | last }}"

- name: Assert usage of systemd as an init system
  assert:
    that: ansible_service_broker_init_system == "systemd"
    msg: "This role only supports systemd as init system."


