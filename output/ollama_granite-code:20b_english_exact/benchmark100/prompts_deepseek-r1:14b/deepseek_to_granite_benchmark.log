---
- name: Preboot Tasks
  tasks:
    - name: Stat /sys/firmware/efi/efivars
      stat:
        path: /sys/firmware/efi/efivars/
      register: efi_status

    - name: Remove GRUB config on EFI systems
      file:
        path: /boot/grub2/grub.cfg
        state: absent
      when: efi_status.stat.exists

    - name: Install custom user template for GRUB
      copy:
        src: 01_users.j2
        dest: /etc/grub.d/01_users
        mode: 0755

    - name: Add EFI password protection to GRUB
      lineinfile:
        path: /etc/grub2-efi.cfg
        line: "password_pbkdf2 {{ item }}"
      loop:
        - my_account_name
        - my_account_name2

    - name: Add MBR password protection to GRUB
      lineinfile:
        path: /etc/grub2.cfg
        line: "password_pbkdf2 {{ item }}"
      loop:
        - my_account_name
        - my_account_name2

    - name: Add unrestricted access to GRUB password entries
      lineinfile:
        path: "{{ item }}"
        line: "--unrestricted"
      loop:
        - /etc/grub2-efi.cfg
        - /etc/grub2.cfg


