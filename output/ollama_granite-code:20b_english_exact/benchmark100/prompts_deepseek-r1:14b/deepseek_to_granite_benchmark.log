---
- name: hardening | Disable swap
  ansible.builtin.command: swapoff -a
  changed_when: false
  when: vault_hardening_disable_swap
  tags:
    - hardening

- name: hardening | Disable core dumps
  community.general.pam_limits:
    domain: "{{ item }}"
    limit_type: both
    limit_item: core
    value: "0"
  loop: "{{ ansible_play_hosts }}"
  when: vault_hardening_disable_core_dumps
  tags:
    - hardening

- name: hardening | Disable Shell Command History
  ansible.builtin.lineinfile:
    path: /etc/profile.d/vault.sh
    line: "export history=-1"
    create: true
    owner: root
    group: root
    mode: "0644"
  when: vault_hardening_disable_shell_command_history
  tags:
    - hardening

- name: hardening | Configure SELinux / AppArmor
  ansible.builtin.command: "{{ item }}"
  loop:
    - sed -i 's/SELINUX=enforcing/SELINUX=permissive/g' /etc/selinux/config
    - setenforce 0
    - yum -y install libselinux-python
    - semodule -i /usr/share/selinux/permissive/vault.pp
    - aa-status
    - aa-enforce
  when: vault_hardening_configure_selinux_apparmor
  tags:
    - hardening


