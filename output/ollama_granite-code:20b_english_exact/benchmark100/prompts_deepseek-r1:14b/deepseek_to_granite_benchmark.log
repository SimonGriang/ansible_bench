---
- name: Create RKE2 manifests directory
  ansible.builtin.file:
    path: "{{ rke2_data_dir }}/manifests"
    state: directory
    mode: "0755"
    owner: root
    group: root

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_dir }}/"
    mode: "0644"
  loop:
    - "kube-vip.yaml"
    - "kube-vip-cloud-provider.yaml"

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    src: "kube-vip-loadbalancer.yaml"
    dest: "{{ rke2_data_dir }}/"
    mode: "0644"
  when: kubevip_cloud_provider != ""


