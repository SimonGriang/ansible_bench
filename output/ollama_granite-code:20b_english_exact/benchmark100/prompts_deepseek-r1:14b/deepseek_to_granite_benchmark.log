    state: "{{ user_state }}"
    comment: "{{ user_comment }}"
    home: "{{ user_home }}"
    shell: "{{ user_shell }}"

- name: Set sudo options for user
  template:
    src: sudoers.j2
    dest: "/etc/sudoers.d/{{ user }}"
    owner: root
    group: root
    mode: "0440"
  when: user_sudoers is defined

- name: Generate private SSH key for user
  command: "ssh-keygen -t {{ ssh_key_type }} -b {{ ssh_key_bits }} -C {{ ssh_key_comment }} -f {{ ssh_key_file }} -N ''"
  args:
    creates: "{{ ssh_key_file }}"

- name: Generate public SSH key for user
  command: "ssh-keygen -y -f {{ ssh_key_file }} > {{ ssh_key_file }}.pub"
  args:
    creates: "{{ ssh_key_file }}.pub"

- name: Convert SSH key to ppk format for user
  command: "puttygen {{ ssh_key_file }} -O private-openssh -o {{ ssh_key_file }}.ppk"
  args:
    creates: "{{ ssh_key_file }}.ppk"

- name: Get or set the home directory for user
  shell: |
    if ! getent passwd {{ user }} > /dev/null; then
      echo "/home"
    else
      getent passwd {{ user }} | cut -d: -f6
    fi
  register: user_home
  changed_when: false

- name: Create .ssh directory for user
  file:
    path: "~/.ssh"
    state: directory
    owner: "{{ user }}"
    mode: "0700"

- name: Deploy authorized keys for user
  copy:
    dest: "~/.ssh/authorized_keys"
    content: "{{ item }}"
    owner: "{{ user }}"
    mode: "0600"
  with_items: "{{ user_authorized_keys }}"

- name: Remove unauthorized keys for user
  lineinfile:
    path: "~/.ssh/authorized_keys"
    state: absent
    regexp: "^{{ item }}$"
  with_items: "{{ user_unauthorized_keys }}"

- name: Copy generated private SSH key for user
  copy:
    src: "{{ ssh_key_file }}"
    dest: "~/"
    owner: "{{ user }}"
    mode: "0600"

- name: Check users password valid time for user
  command: "chage -l {{ user }}"
  register: user_password_info
  changed_when: false

- name: Set users password valid time for user
  command: "chage -d {{ user_password_valid_time }} {{ user }}"

- name: Place private key file for user
  copy:
    src: "{{ item }}"
    dest: "~/.ssh/"
    owner: "{{ user }}"
    mode: "0600"
  with_items: "{{ user_private_key_files }}"


