- name: Restore etcd - get all nodes
  command: kubectl get node -o jsonpath='{.items[*].metadata.name}'
  register: node_names

- name: Restore etcd - remove old nodes
  command: kubectl delete node {{ item }}
  loop: "{{ node_names.stdout_lines }}"
  when: item not in groups[rke2_cluster_group_name]


