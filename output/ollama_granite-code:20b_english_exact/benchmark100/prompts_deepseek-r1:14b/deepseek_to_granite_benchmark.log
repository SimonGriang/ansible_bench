---
- name: Task 1 - Remove old Docker versions
  yum:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Task 2 - Add Docker GPG key
  rpm_key:
    key: "{{ docker_yum_gpg_key }}"
    state: present
  when: docker_add_repo

- name: Task 3 - Add Docker repository
  get_url:
    url: "{{ docker_yum_repo_url }}"
    dest: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    owner: root
    group: root
    mode: "0644"
  when: docker_add_repo

- name: Task 4 - Configure Docker Nightly repo
  ini_file:
    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    section: docker-ce-nightly
    option: enabled
    value: "{{ docker_yum_repo_enable_nightly }}"
    mode: "0644"
  when: docker_add_repo

- name: Task 5 - Configure Docker Test repo
  ini_file:
    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    section: docker-ce-test
    option: enabled
    value: "{{ docker_yum_repo_enable_test }}"
    mode: "0644"
  when: docker_add_repo

- name: Task 6 - Configure containerd on RHEL 8
  block:
    - name: Remove runc package
      yum:
        name: runc
        state: absent

    - name: Ensure container-selinux is installed
      yum:
        name: container-selinux
        state: present

    - name: Ensure containerd.io is installed
      yum:
        name: containerd.io
        state: present
  when: ansible_facts.distribution_major_version == 8


