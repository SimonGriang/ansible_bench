          loop:
            - "/var/lib/rke2/agent/etc/etcd"
            - "/etc/rke2/backup"

        - name: "8.2 Copy snapshot file from local host to backup directory"
          copy:
            src: "{{ rke2_snapshot_file }}"
            dest: "/etc/rke2/backup/"
            owner: "root"
            group: "root"
            mode: "0644"

        - name: "8.3 Copy snapshot file from backup directory to etcd directory"
          command: "cp /etc/rke2/backup/{{ rke2_snapshot_file }} /var/lib/rke2/agent/etc/etcd"
