---
- import_tasks: assert.yml
- name: Task 2 - install using package
  block:
    - name: Task 2 - apt install on Debian
      apt:
        name: "{{ hashicorp_product }}"
        state: present
        update_cache: true
        cache_valid_time: 3600
      register: apt_result
      until: apt_result is succeeded
      when: ansible_os_family == "Debian"
    - name: Task 2 - dnf install on Fedora
      dnf:
        name: "{{ hashicorp_product }}"
        state: present
      register: dnf_result
      until: dnf_result is succeeded
      when: ansible_os_family == "RedHat"
    - name: Task 2 - yum install on RHEL
      yum:
        name: "{{ hashicorp_product }}"
        state: present
      register: yum_result
      until: yum_result is succeeded
      when: ansible_os_family == "RedHat"
  tags:
    - always
- name: Task 3 - configure debian
  block:
    - name: Task 3 - add GPG key
      apt_key:
        url: "{{ hashicorp_gpg_key_url }}"
        state: present
    - name: Task 3 - add apt repository
      apt_repository:
        repo: "{{ hashicorp_apt_repo }}"
        state: present
        filename: hashicorp
      notify: Task 3 - update apt cache
  tags:
    - always
  notify: Task 3 - update apt cache
- name: Task 4 - install hashicorp product using package
  block:
    - name: Task 4 - install latest version
      package:
        name: "{{ hashicorp_product }}"
        state: latest
      when: hashicorp_version == "latest"
    - name: Task 4 - install specific version
      package:
        name: "{{ hashicorp_product }}"
        state: present
        version: "{{ hashicorp_version }}"
      when: hashicorp_version != "latest"
  tags:
    - always
- name: Task 5 - install manually
  unarchive:
    src: "{{ hashicorp_url }}"
    dest: "{{ hashicorp_dest }}"
    remote_src: true
    mode: 0755
    owner: root
    group: root
  tags:
    - always


