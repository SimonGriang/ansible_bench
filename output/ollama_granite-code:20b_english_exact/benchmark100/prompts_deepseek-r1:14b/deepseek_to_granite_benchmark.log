---
- name: rke2-install
  tasks:
    - name: Create the RKE2 configuration directory
      file:
        path: /etc/rke2
        state: directory
        owner: root
        group: root
        mode: 0755
    - name: Set server taints
      command: rke2 taint --effect=ovy:NoSchedule --key=node-role.kubernetes.io/server
      when: rke2_node_type == "server"
    - name: Set agent taints
      command: rke2 taint --effect=ovy:NoSchedule --key=node-role.kubernetes.io/agent
      when: rke2_node_type == "agent"
    - name: Copy RKE2 configuration file
      template:
        src: rke2.yaml.j2
        dest: /etc/rke2/rke2.yaml
        owner: root
        group: root
        mode: 0644
      notify: restart rke2
    - name: Copy Kubelet configuration file
      template:
        src: kubelet.conf.j2
        dest: /var/lib/rke2/agent/etc/kubelet.conf
        owner: root
        group: root
        mode: 0644
      when: kubelet_config is defined
      notify: restart rke2
    - name: Copy Containerd Registry Configuration file
      template:
        src: containerd-registry.conf.j2
        dest: /etc/docker/daemon.json
        owner: root
        group: root
        mode: 0644
      when: containerd_registry is defined
      notify: restart docker
    - name: Start RKE2 service on other nodes
      service:
        name: rke2-agent
        state: started
        enabled: true
      when: groups['rke2_agent']
      notify: restart rke2
    - name: Mask other RKE2 services on nodes
      service:
        name: "{{ item }}"
        enabled: false
      loop:
        - rke2-server
        - rke2-agent
      when: groups['rke2_server']
    - name: Wait for remaining nodes to be ready - no CNI
      command: rke2-ctlPlane-join-check
      register: join_check_output
      until: join_check_output.stdout == "All nodes are ready."
      retries: 60
      delay: 10
      when: not rke2_cni
    - name: Wait for remaining nodes to be ready - with CNI
      command: rke2-ctlplane-join-check
      register: join_check_output
      until: join_check_output.stdout == "All nodes are ready."
      retries: 60
      delay: 10
      when: rke2_cni


