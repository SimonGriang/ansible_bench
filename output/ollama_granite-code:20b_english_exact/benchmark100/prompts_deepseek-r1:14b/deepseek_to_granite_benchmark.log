- Last generated (faulty) playbook:
---
- name: Task 1
  import_tasks: assert.yml

- name: Task 2
  package:
    name: systemd-logger
    state: absent
  notify: Restart rsyslog handler

- name: Task 3
  package:
    name: "{{ rsyslog_packages }}"
    state: "{{ rsyslog_package_state }}"
  notify: Restart rsyslog handler

- name: Task 4
  package:
    name: "{{ item }}"
    state: "{{ rsyslog_package_state }}"
  loop: "{{ rsyslog_features }}"
  notify: Restart rsyslog handler

- name: Task 5
  template:
    src: "{{ rsyslog_config_file_format }}"
    dest: "{{ rsyslog_dest_conf_file }}"
    owner: root
    group: root
    mode: 0644
  notify: Restart rsyslog handler

- name: Task 6
  file:
    path: /etc/rsyslog.d/
    state: directory
    mode: 0755

- name: Task 7
  template:
    src: forward_rule.conf.j2
    dest: /etc/rsyslog.d/{{ rsyslog_forward_rule_name }}.conf
    owner: root
    group: root
    mode: 0644
  notify: Restart rsyslog handler
  when: not rsyslog_deploy_default_config

- name: Task 8
  copy:
    src: "{{ item.value.src }}"
    dest: "/etc/rsyslog.d/{{ item.key }}.conf"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rsyslog_rsyslog_d_files | dict2items }}"
  notify: Restart rsyslog handler
  when: item.value.state == "present"

- name: Task 9
  service:
    name: "{{ rsyslog_service }}"
    state: started
    enabled: true


