---
- name: "rke2-install : RKE2 install"
  block:
    - name: Task 1 - Download RKE2 installation script
      get_url:
        url: "https://raw.githubusercontent.com/rke2/rke2/master/install.sh"
        dest: "/tmp/install.sh"
        mode: "0700"
      when: not airgap_mode

    - name: Task 2 - Copy local RKE2 installation script
      copy:
        src: "{{ rke2_airgap_install_script }}"
        dest: "/tmp/install.sh"
        mode: "0700"
      when: airgap_mode and rke2_airgap_install_script_implementation == "copy"

    - name: Task 3 - Create RKE2 artifacts folder
      file:
        path: "{{ rke2_airgap_base_path }}/artifacts"
        state: "directory"
        mode: "0700"
      when: airgap_mode and rke2_airgap_artifacts_implementation != "exists"

    - name: Task 4 - Download RKE2 checksum and artifacts
      block:
        - name: Download RKE2 checksum file
          get_url:
            url: "{{ rke2_checksum_url }}"
            dest: "{{ rke2_airgap_base_path }}/artifacts/rke2-checksums.txt"

        - name: Download RKE2 artifacts
          get_url:
            url: "{{ item.url }}"
            dest: "{{ rke2_airgap_base_path }}/artifacts/{{ item.dest }}"
            checksum: "sha256:{{ item.checksum }}"
          with_items: "{{ rke2_airgap_artifacts }}"
      rescue:
        - name: Fallback to local download
          copy:
            src: "{{ item.src }}"
            dest: "{{ rke2_airgap_base_path }}/artifacts/{{ item.dest }}"
          with_items: "{{ rke2_airgap_artifacts }}"
      when: airgap_mode

    - name: Task 5 - Copy local RKE2 artifacts
      copy:
        src: "{{ item.src }}"
        dest: "{{ rke2_airgap_base_path }}/artifacts/{{ item.dest }}"
        mode: "0640"
      with_items: "{{ rke2_airgap_artifacts }}"
      when: airgap_mode and rke2_airgap_artifacts_implementation == "copy"

    - name: Task 6 - Airgap mode - additional images tarballs
      block:
        - name: Create RKE2 additional images folder
          file:
            path: "{{ rke2_airgap_base_path }}/images"
            state: "directory"
            mode: "0700"

        - name: Copy additional tarballs
          copy:
            src: "{{ item }}"
            dest: "{{ rke2_airgap_base_path }}/images/"
          with_items: "{{ rke2_airgap_additional_images_tarballs }}"
      when: airgap_mode and rke2_airgap_additional_images_tarballs | length > 0

    - name: Task 7 - Airgap mode - ensure artifacts exist and have acceptable permissions
      block:
        - name: Stat RKE2 artifacts
          stat:
            path: "{{ rke2_airgap_base_path }}/artifacts"
          register: rke2_airgap_stat_artifacts

        - name: Stat RKE2 install script
          stat:
            path: "{{ rke2_airgap_base_path }}/install.sh"
          register: rke2_airgap_stat_install_script

        - name: Ensure artifacts are read-only
          file:
            path: "{{ rke2_airgap_base_path }}/artifacts"
            mode: "0550"
          changed_when: false

        - name: Ensure install.sh is executable
          file:
            path: "{{ rke2_airgap_base_path }}/install.sh"
            mode: "0700"
          changed_when: false
      when: airgap_mode and rke2_airgap_artifacts_implementation == "exists"

    - name: Task 8 - Populate service facts
      service_facts:

    - name: Task 9 - Get stats of the FS object
      stat:
        path: /usr/local
      register: stat_usr_local

    - name: Task 10 - Set RKE2 bin path
      set_fact:
        bin_dir: "/usr/local/bin"
      when: stat_usr_local.stat.isdir and stat_usr_local.stat.writeable

    - name: Task 11 - Check RKE2 version
      block:
        - name: Get installed RKE2 version
          command: "{{ bin_dir }}/rke2 version --short"
          failed_when: false
          changed_when: false
          register: installed_rke2_version

        - name: Get running RKE2 version
          command: "curl --silent localhost:9345/version.txt"
          failed_when: false
          changed_when: false
          register: running_rke2_version

        - name: Compare RKE2 versions
          set_fact:
            rke2_allow_downgrade: "{{ installed_rke2_version.stdout is version(running_rke2_version.stdout, '<') }}"

        - name: Assert RKE2 downgrade is allowed
          assert:
            that: rke2_allow_downgrade
            fail_msg: "RKE2 downgrade is not allowed. Please upgrade RKE2 before proceeding."
          when: rke2_allow_downgrade | bool

        - name: Clean RKE2 version strings
          set_fact:
            installed_rke2_version: "{{ installed_rke2_version.stdout | regex_replace('^v', '') }}"
            running_rke2_version: "{{ running_rke2_version.stdout | regex_replace('^v', '') }}"
      when: rke2_allow_downgrade | bool
  always:
    - name: Task 12 - Prevent accidental RKE2 downgrade
      debug:
        msg: "Downgrades are disabled. Please upgrade RKE2 before proceeding."
      failed_when: rke2_allow_downgrade | bool

    - name: Task 13 - Run RKE2 install script
      command: "bash /tmp/install.sh"
      environment:
        INSTALL_RKE2_TYPE: "agent"
        AIRGAP_MODE: "{{ airgap_mode | bool }}"
        AIRGAP_BASE_PATH: "{{ rke2_airgap_base_path }}"
        INSTALL_RKE2_VERSION: "{{ rke2_version }}"
        INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"
        INSTALL_RKE2_ETCD: "{{ rke2_etcd }}"
        INSTALL_RKE2_ETCD_VERSION: "{{ rke2_etcd_version }}"
        INSTALL_RKE2_KUBEADM: "{{ rke2_kubeadm }}"
        INSTALL_RKE2_KUBEADM_VERSION: "{{ rke2_kubeadm_version }}"
        AIRGAP_IMAGE_TAG_PREFIX: "{{ rke2_airgap_image_tag_prefix }}"
        AIRGAP_IMAGE_VERSION: "{{ rke2_airgap_image_version }}"
        AIRGAP_COMMAND: "{{ rke2_airgap_command }}"
        AIRGAP_INSTALL_SCRIPT: "{{ rke2_airgap_install_script }}"
        AIRGAP_INSTALL_SCRIPT_IMPLEMENTATION: "{{ rke2_airgap_install_script_implementation }}"
        AIRGAP_ARTIFACTS_IMPLEMENTATION: "{{ rke2_airgap_artifacts_implementation }}"
        AIRGAP_ADDITIONAL_IMAGE_TARBALLS: "{{ rke2_airgap_additional_images_tarballs }}"


