---

- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install Python pip
  ansible.builtin.package:
    name: "{{ python_pip_packages }}"
    state: present
  when: python_pip_packages is defined

- name: Configure pip proxy settings
  ansible.builtin.ini_file:
    path: /etc/pip.conf
    section: global
    option: index-url
    value: "{{ python_pip_proxy }}"
    mode: "0644"
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  ansible.builtin.ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ python_pip_trusted_host }}"
    mode: "0644"
  when: python_pip_trusted_host is defined

- name: Update pip
  ansible.builtin.pip:
    name: python
    state: latest
    skip_existing: true
  when: >
    ansible_distribution != 'Bookworm' and
    ansible_distribution != 'Noble' and
    ansible_os_family != 'alpine'

- name: Install Python modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    version: "{{ item.version }}"
    state: "{{ item.state }}"
  loop: "{{ python_pip_modules }}"
  when: >
    ansible_distribution != 'Bookworm' and
    ansible_distribution != 'Noble' and
    ansible_os_family != 'alpine'


