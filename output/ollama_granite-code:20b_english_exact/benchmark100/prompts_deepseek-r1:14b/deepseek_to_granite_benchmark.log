---
- name: Task 1 - Import assertion file
  ansible.builtin.include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Install cron package
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Task 3 - Configure cron shell environment
  community.general.cronvar:
    name: SHELL
    value: /bin/bash

- name: Task 4 - Configure cron path environment
  community.general.cronvar:
    name: PATH
    value: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

- name: Task 5 - Configure cron mailto settings
  community.general.cronvar:
    name: MAILTO
    value: "root"

- name: Task 6 - Start and enable cron service
  ansible.builtin.service:
    name: cron
    state: started
    enabled: "{{ cron_service is defined }}"

- name: Task 7 - Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    state: present
  with_items: "{{ cron_jobs }}"


