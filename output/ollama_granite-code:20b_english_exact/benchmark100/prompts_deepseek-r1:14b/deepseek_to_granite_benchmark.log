---
- name: Create directory for RKE2 manifests
  ansible.builtin.file:
    path: /var/lib/rke2/agent/manifests
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    src: /path/to/kube-vip.yaml
    dest: /var/lib/rke2/agent/manifests/kube-vip.yaml
    owner: root
    group: root
    mode: '0644'

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    src: /path/to/kube-vip-lb.yaml
    dest: /var/lib/rke2/agent/manifests/kube-vip-lb.yaml
    owner: root
    group: root
    mode: '0644'
  when: cloud_provider is defined and cloud_provider == "aws"


