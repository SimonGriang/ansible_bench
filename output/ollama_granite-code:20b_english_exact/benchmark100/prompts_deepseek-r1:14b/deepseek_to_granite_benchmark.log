---
- name: Task 1
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2
  package:
    name: "{{ php_packages }}"
    state: present

- name: Task 3
  shell: "php --info | grep 'Configuration File' | awk '{print $3}'"
  register: php_found_ini_location
  changed_when: false
  when: php_ini_location is not defined

- name: Task 4
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
    mode: 0644
  notify: Restart httpd


