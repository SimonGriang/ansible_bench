---
- name: Include tasks for Keepalived installation
  include_tasks: keepalived.yml
  when: ha_enabled and ha_mode != "none" and groups['keepalived'] is defined

- name: Download and install RKE2
  command: /usr/bin/rke2-install.sh --version v1.24.5+rke2r1

- name: Include tasks for CIS hardening
  include_tasks: cis.yml
  when: cis_profile is defined

- name: Find active server
  command: /bin/hostname

- name: Enable IPVS kernel module
  modprobe:
    name: ip_vs
    state: present
  when: ha_enabled and ha_mode != "none" and groups['keepalived'] is defined

- name: Copy kube-vip manifests
  command: /bin/cp /path/to/kube-vip.yaml /etc/kubernetes/manifests
  when: ha_enabled and ha_mode != "none" and groups['kube_control_plane'] is defined and groups['kube_node'] is defined

- name: Copy ingress-nginx manifests
  command: /bin/cp /path/to/ingress-nginx.yaml /etc/kubernetes/manifests
  when: ingress_nginx_values is defined

- name: Prepare first server node
  command: /bin/hostname

- name: Perform etcd restore
  command: /usr/local/bin/etcd-restore.sh
  when: restore_cluster is defined

- name: Download kubeconfig
  fetch:
    src: /etc/kubernetes/admin.conf
    dest: "{{ playbook_dir }}/kubeconfig"
    flat: true
  when: download_kubeconfig is defined

- name: Join remaining nodes
  command: /usr/local/bin/rke2-join.sh --token <JOIN_TOKEN>
  when: groups['kube_node'] is defined and groups['kube_control_plane'] is defined

- name: Perform rolling restart of servers
  command: /usr/local/bin/rke2-rolling-restart.sh
  when: groups['kube_node'] is defined and groups['kube_control_plane'] is defined

- name: Perform rolling restart of agents
  command: /usr/local/bin/rke2-rolling-restart-agent.sh
  when: groups['kube_node'] is defined and groups['kube_control_plane'] is defined

- name: Flush handlers
  meta: flush_handlers

- name: Perform rolling restart when config changes
  command: /usr/local/bin/rke2-rolling-restart.sh
  when: groups['kube_node'] is defined and groups['kube_control_plane'] is defined

- name: Perform final steps
  debug:
    msg: "All tasks completed successfully!"


