---
- name: Java role tasks
  tasks:
    - name: Set the java_jdk_vendor fact to temurin if currently set to adoptopenjdk
      set_fact:
        java_jdk_vendor: temurin
      when: java_jdk_vendor == "adoptopenjdk"

    - name: Include variable files based on the java_jdk_vendor and the detected OS distribution and version
      include_vars: "{{ item }}"
      with_first_found:
        - files:
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_distribution }}-{{ ansible_distribution_version }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_distribution }}-{{ ansible_distribution_release }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_distribution }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_os_family }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_system }}.yml"
            - "{{ java_jdk_vendor }}.yml"
          skip: true

    - name: Include variable files based on the detected architecture
      include_vars: "{{ item }}"
      with_first_found:
        - files:
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_architecture }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-x86_64.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-amd64.yml"
            - "{{ java_jdk_vendor }}-x86_64.yml"
            - "{{ java_jdk_vendor }}-amd64.yml"
          skip: true

    - name: Set OS specific variables (I)
      set_fact:
        java_version: "11"
        java_apt_repositories:
          - "deb http://deb.debian.org/debian {{ ansible_distribution_release }} main contrib non-free"
          - "deb-src http://deb.debian.org/debian {{ ansible_distribution_release }} main contrib non-free"
          - "deb http://security.debian.org/debian-security {{ ansible_distribution_release }}/updates main contrib non-free"
          - "deb-src http://security.debian.org/debian-security {{ ansible_distribution_release }}/updates main contrib non-free"
        java_apt_key_repositories:
          - "https://apt.releases.hashicorp.com/gpg"
        java_apt_keys:
          - "6A030B96CAA293F97B511D524334BDFFC84C328D"
        java_yum_repositories:
          - "https://yum.oracle.com/public-yum-ol7.repo"
        java_yum_keys:
          - "http://yum.oracle.com/RPM-GPG-KEY-oracle-ol7"
        java_libs:
          - liberation-fonts
          - libasound2
          - libatk-bridge2.0-0
          - libatk-wrapper
          - libXrender1
          - libXtst6
          - libxi6
          - libxtst6
          - rtl-math

    - name: Set OS and architecture specific variables (II)
      set_fact:
        java_package: "openjdk-{{ java_version }}"
        java_alternative: "/usr/lib/jvm/java-{{ java_version }}-openjdk-{{ java_arch }}-{% if ansible_os_family == 'Debian' %}jdk{% endif %}/"

    - name: Set the java_home fact to point to the OpenJDK installation directory
      set_fact:
        java_home: "{{ java_alternative }}"

    - name: For Debian-based systems, remove deprecated repositories, install extra apt tools, add key repositories, and add required repositories
      apt:
        update_cache: yes
        cache_valid_time: 3600
        name:
          - apt-transport-https
          - ca-certificates
          - gnupg
          - software-properties-common
        state: present
      when: ansible_os_family == "Debian"

    - name: For RedHat-based systems, add key repositories and required repositories
      yum:
        name:
          - ca-certificates
          - glibc
          - glibc-devel
          - krb5-libs
          - libXext
          - libXrender
          - libcom_err
          - libselinux
          - libX11
          - libxt
          - nss
          - libresolv
          - fontconfig
          - freetype
          - libXft
          - libXrender
          - libasound
          - libxi
        state: present
      when: ansible_os_family == "RedHat"

    - name: Install all required system libraries for OpenJDK
      package:
        name: "{{ java_libs }}"
        state: present
      when: java_libs is defined

