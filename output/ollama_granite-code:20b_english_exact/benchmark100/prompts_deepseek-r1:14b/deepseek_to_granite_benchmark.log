---
- name: Include tasks for installing Keepalived
  include_tasks: keepalived.yml
  when: ha_enabled and ha_keepalived_install and inventory_hostname == groups['kube_control_plane'][0]

- name: Download and install RKE2
  command: /usr/bin/rke2-install.sh --version v1.23.5+rke2r1

- name: Include tasks for CIS hardening
  include_tasks: cis.yml
  when: cis_profile is defined

- name: Include tasks to find active server
  include_tasks: find_active_server.yml

- name: Enable IPVS kernel module
  modprobe:
    name: ip_vs
    state: present
  when: ha_enabled and ha_mode == "ipvs"

- name: Include tasks to copy kube-vip manifests
  include_tasks: kube-vip.yml
  when: ha_enabled and ha_mode == "kube-vip"

- name: Include tasks to copy ingress-nginx manifests
  include_tasks: ingress-nginx.yml
  when: ingress_nginx_values is defined

- name: Include tasks to prepare the first server node
  include_tasks: first_server.yml
  when: inventory_hostname == groups['kube_control_plane'][0]

- name: Include tasks for etcd restore
  include_tasks: etcd_restore.yml
  when: ha_enabled and ha_etcd_restore

- name: Include tasks to download kubeconfig
  include_tasks: download_kubeconfig.yml
  when: download_kubeconfig

- name: Include tasks to join remaining nodes
  include_tasks: join_nodes.yml
  when: active_server is defined

- name: Include tasks for rolling restart of servers
  include_tasks: rolling_restart_servers.yml
  when: ha_enabled and ha_version_changed

- name: Include tasks for rolling restart of agents
  include_tasks: rolling_restart_agents.yml
  when: ha_enabled and ha_version_changed

- name: Flush handlers
  meta: flush_handlers

- name: Include tasks for rolling restart when config changes
  include_tasks: rolling_restart_config.yml
  when: ha_enabled and ha_config_changed

- name: Include tasks for final steps
  include_tasks: summary.yml


