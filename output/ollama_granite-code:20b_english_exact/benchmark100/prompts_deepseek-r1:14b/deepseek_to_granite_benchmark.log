---
- name: Assert usage of systemd as an init system
  assert:
    that: ansible_service_mgr == "systemd"
    msg: "Systemd must be used as an init system."

- name: Get latest release and set promtail version
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    return_content: yes
    body_format: json
  register: latest_release

- name: Set promtail version
  set_fact:
    promtail_version: "{{ latest_release.json.tag_name }}"

- name: Test if zip local archive exists and assert local binary exists
  stat:
    path: "{{ promtail_local_dir }}/promtail_{{ promtail_version }}_linux_{{ promtail_system_architecture }}.zip"
  register: local_archive_exists

- name: Assert local binary exists
  assert:
    that: promtail_local_dir is defined and local_archive_exists.stat.exists
    msg: "Local binary archive does not exist."

- name: Get checksum list and set checksum for target architecture
  uri:
    url: "https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/promtail_{{ promtail_version }}_checksums.txt"
    method: GET
    return_content: yes
  register: checksum_list

- name: Set checksum for target architecture
  set_fact:
    promtail_checksum: "{{ checksum_list.content | regex_findall('SHA256: .*' + promtail_system_architecture + ' ([0-9a-zA-Z]+)') | first }}"
  when: promtail_system_architecture == "amd64" or promtail_system_architecture == "arm64"

- name: Add promtail repository
  apt_repository:
    repo:deb https://apt.grafana.com stable main
  become: yes

- name: Install promtail
  apt:
    name: promtail
    state: latest
    update_cache: yes
  become: yes


