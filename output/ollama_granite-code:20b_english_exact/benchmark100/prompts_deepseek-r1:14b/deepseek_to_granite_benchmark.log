---
- name: locations | Enable modules
  tags:
    - configuration
    - locations
  block:
    - name: locations | Enable modules | Debian and Suse-based systems
      ansible.builtin.apt:
        name: "{{ item.name }}"
        state: present
      loop: "{{ httpd_locations }}"
      when: ansible_os_family == "Debian" or ansible_os_family == "Suse"
      notify: restart apache

    - name: locations | Enable modules | RHEL-based systems
      ansible.builtin.yum:
        name: "{{ item.name }}"
        state: present
      loop: "{{ httpd_locations }}"
      when: ansible_os_family == "RedHat"
      notify: restart apache

- name: locations | Configure locations
  tags:
    - configuration
    - locations
  block:
    - name: locations | Configure locations
      ansible.builtin.template:
        src: "httpd.conf.j2"
        dest: "/etc/httpd/conf.d/{{ item.filename }}"
        mode: "0644"
      loop: "{{ httpd_locations }}"
      notify: restart apache



