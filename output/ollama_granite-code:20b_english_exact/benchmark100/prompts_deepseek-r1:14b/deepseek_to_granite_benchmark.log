---
- name: Set package state based on Ansible installation
  set_fact:
    ansible_package_state: "{{ 'present' if ansible_installed_via_package else 'absent' }}"
  tags:
    - always

- name: Set up Ansible on RedHat
  include_tasks: setup-RedHat.yml
  when: ansible_os_family == "RedHat" and ansible_distribution != "Fedora" and ansible_installed_via_package
  tags:
    - RedHat

- name: Set up Ansible on Fedora
  include_tasks: setup-Fedora.yml
  when: ansible_distribution == "Fedora" and ansible_installed_via_package
  tags:
    - Fedora

- name: Set up Ansible on Ubuntu
  include_tasks: setup-Ubuntu.yml
  when: ansible_distribution == "Ubuntu" and ansible_installed_via_package
  tags:
    - Ubuntu

- name: Set up Ansible on Debian
  include_tasks: setup-Debian.yml
  when: ansible_distribution == "Debian" and ansible_installed_via_package
  tags:
    - Debian

- name: Set up Ansible using Pip
  include_tasks: setup-pip.yml
  when: not ansible_installed_via_package
  tags:
    - pip


