- name: Configure sudoers directory inclusion
  block:
    - name: Add /etc/sudoers.d directory to /etc/sudoers file
      lineinfile:
        path: /etc/sudoers
        line: "#includedir /etc/sudoers.d"
        state: present
      register: sudoers_includedir
    - name: Deploy /etc/sudoers.d directory
      template:
        src: sudoers.d/README.md
        dest: /etc/sudoers.d/README.md
    - name: Validate sudoers changes
      command: visudo -cf /etc/sudoers
      changed_when: false
    - name: Deploy /etc/sudoers.d directory
      template:
        src: sudoers.d/{{ item.name }}
        dest: /etc/sudoers.d/{{ item.name }}
        validate: '/usr/sbin/visudo -cf %s'
      with_items: "{{ users_sudoers_d }}"
  when: users_sudoers_d is defined and users_sudoers_d|length > 0

- include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    loop_var: user

- name: Configure cron allow permissions
  block:
    - name: Generate /etc/cron.allow file
      template:
        src: cron.allow.j2
        dest: /etc/cron.allow
        mode: 0644
    - name: Deploy /etc/cron.allow file
      copy:
        src: /etc/cron.allow
        dest: /etc/cron.allow
  when: users_cron_allow

- name: Remove cron allow file if not needed
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


