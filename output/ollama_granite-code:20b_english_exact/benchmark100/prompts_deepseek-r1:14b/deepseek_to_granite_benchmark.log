---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- wait_for:
    port: "{{ item.port }}"
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: "{{ item.delegate_to }}"
  loop: "{{ query('dict', port=ssh_port) }}"
  connection: local
  when: item.when is not defined or item.when

- name: prepare system
  connection: local
  become: false
  block:

    - name: test connection
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"

    - name: test sudo
      command: sudo -v
      register: sudo_access
      changed_when: false

    - name: gather facts
      setup:
      when: not sudo_access.rc is defined or sudo_access.rc != 0

    - name: install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      when:
        - bootstrap_facts_packages is defined
        - not sudo_access.rc is defined or sudo_access.rc != 0

    - name: install libdnf5 on RedHat
      raw: dnf -y install libdnf5
      register: install_libdnf5
      until: install_libdnf5 is succeeded
      retries: 10
      delay: 10
      when:
        - ansible_os_family == "RedHat"
        - bootstrap_facts_packages is defined
        - not sudo_access.rc is defined or sudo_access.rc != 0

- name: gather ansible facts
  setup:
  become: false

- name: install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  when:
    - bootstrap_facts_packages is defined


