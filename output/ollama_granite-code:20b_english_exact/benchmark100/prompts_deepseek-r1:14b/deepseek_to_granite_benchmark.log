---
- name: Restart RKE2 service on {{ rke2_node_name}}
  service:
    name: rke2
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  delegate_to: "{{ item }}"
  async: 15
  poll: 0
  until:
    - item is not failed
  loop: "{{ groups[rke2_servers_group_name] }}"
  retries: 100
  register: result
  run_once: true
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  delegate_to: "{{ item }}"
  async: 15
  poll: 0
  until:
    - item is not failed
  loop: "{{ groups[rke2_servers_group_name] }}"
  retries: 100
  register: result
  run_once: true
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready



