content='---\n- name: Bootstrap\n  hosts: all\n  gather_facts: false\n\n  tasks:\n    - name: lookup bootstrap facts (raw)\n      raw: cat /etc/os-release\n      register: bootstrap_facts\n      changed_when: false\n      vars:\n        ansible_user: "{{ bootstrap_user }}"\n\n    - name: set bootstrap facts (I)\n      loop: "{{ bootstrap__os_family_map|dict2items }}"\n      set_fact:\n        bootstrap_distribution: "{{ item.value.distribution | regex_search(\'(ID=.*|DISTRIB_ID=)(.*)\', \'\\\\2\') | regex_replace(\'\\"\', \'\') }}"\n        bootstrap_distribution_major_version: "{{ item.value.distribution | regex_search(\'(VERSION_ID=)(.*)\', \'\\\\2\') | regex_replace(\'\\"\', \'\') }}"\n      when: bootstrap_facts.stdout is search(item.value.version_id_regex)\n      vars:\n        ansible_become: "{{ item.value.become | default(omit) }}"\n\n    - name: set bootstrap facts (II)\n      loop: "{{ bootstrap__os_family_map|dict2items }}"\n      set_fact:\n        bootstrap_os_family: "{{ item.key }}"\n      when: bootstrap_facts.stdout is search(item.value.version_id_regex)\n      vars:\n        ansible_become: "{{ item.value.become | default(omit) }}"' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-19T23:56:23.540109335Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5867763172, 'load_duration': 47205419, 'prompt_eval_count': 489, 'prompt_eval_duration': 193789987, 'eval_count': 305, 'eval_duration': 5626039356, 'model_name': 'granite-code:20b'} id='run--a4d4c86f-0330-4c7d-9a17-1052a4bb3674-0' usage_metadata={'input_tokens': 489, 'output_tokens': 305, 'total_tokens': 794}
