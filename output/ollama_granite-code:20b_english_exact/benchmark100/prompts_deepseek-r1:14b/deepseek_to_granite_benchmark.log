---
- name: "RKE2 configuration"
  hosts: "cluster"
  gather_facts: false

  tasks:
    - name: "Task 1: Create the RKE2 config directory"
      file:
        path: "/etc/rke2"
        state: "directory"
        owner: "root"
        group: "root"
        mode: "0755"

    - name: "Task 2: Set server taints"
      command: "kubectl taint node {{ inventory_hostname }} {{ rke2_server_node_taints }} --effect NoSchedule"
      when: "rke2_server_node_taints is defined"

    - name: "Task 3: Copy RKE2 configuration file"
      copy:
        src: "{{ rke2_config_src }}"
        dest: "/etc/rke2/rke2.yaml"
        owner: "root"
        group: "root"
        mode: "0644"
        backup: true
      notify: "Handler: restart rke2 service"

    - name: "Task 4: Copy kubelet configuration file"
      copy:
        src: "{{ rke2_kubelet_config_src }}"
        dest: "/var/lib/rke2/agent/etc/kubelet-config.yaml"
        owner: "root"
        group: "root"
        mode: "0644"
        backup: true
      when: "rke2_kubelet_config is defined"
      notify: "Handler: restart rke2 service"

    - name: "Task 5: Copy Containerd Registry Configuration file"
      copy:
        src: "{{ rke2_registry_config_src }}"
        dest: "/etc/docker/daemon.json"
        owner: "root"
        group: "root"
        mode: "0644"
        backup: true
      when: "rke2_registry_config is defined"
      notify: "Handler: restart rke2 service"

    - name: "Task 6: Register etcd restore from file"
      set_fact:
        etcd_restore_from_file: true
      when:
        - "rke2_snapshot_file is defined"
        - "rke2_snapshot_file != ''"
        - "(rke2_state == 'absent') or (rke2_state == 'restore')"
        - "(rke2_service_status.stdout == ' active')"
      changed_when: false

    - name: "Task 7: Register etcd restore from S3"
      set_fact:
        etcd_restore_from_s3: true
      when:
        - "rke2_s3_access_key is defined"
        - "rke2_s3_secret_key is defined"
        - "rke2_s3_bucket_name is defined"
        - "rke2_s3_bucket_name != ''"
        - "rke2_s3_bucket_path is defined"
        - "rke2_s3_bucket_path != ''"
        - "(rke2_state == 'absent') or (rke2_state == 'restore')"
        - "(rke2_service_status.stdout == ' active')"
      changed_when: false

    - name: "Task 8: Restore etcd from file"
      block:
        - name: "8.1 Create directories for etcd snapshot backup"
          file:
            path: "{{ item }}"
            state: "directory"
            owner: "root"
            group: "root"
            mode: "0750"
          loop:
            - "/var/lib/rke2/agent/etc/etcd"
            - "/etc/rke2/backup"

        - name: "8.2 Copy snapshot file from local host to backup directory"
          copy:
            src: "{{ rke2_snapshot_file }}"
            dest: "/etc/rke2/backup/"
            owner: "root"
            group: "root"
            mode: "0644"

        - name: "8.3 Copy snapshot file from backup directory to etcd directory"
          command: "cp /etc/rke2/backup/{{ rke2_snapshot_file }} /var/lib/rke2/agent/etc/etcd"
          register: "rke2_etcd_snapshot_copy"
          until: "rke2_etcd_snapshot_copy.rc == 0"
          retries: "5"
          delay: "10"
          changed_when: false

        - name: "8.4 Perform etcd snapshot restore"
          command: "rke2 etcdrbackup snapshot-restore --name {{ inventory_hostname }} --config-file /etc/rke2/rke2.yaml"
          environment:
            ETCDCTL_ENDPOINTS: "https://localhost:2379"
            ETCDCTL_CA_FILE: "/var/lib/rke2/agent/etc/kubernetes/admin.conf"
            ETCDCTL_CERT_FILE: "/var/lib/rke2/agent/etc/kubernetes/admin.conf"
            ETCDCTL_KEY_FILE: "/var/lib/rke2/agent/etc/kubernetes/admin.conf"
      when: "etcd_restore_from_file|bool"

    - name: "Task 9: Restore etcd from S3"
      block:
        - name: "9.1 Copy snapshot file from S3 to backup directory"
          command: "aws s3 cp s3://{{ rke2_s3_bucket_name }}{{ rke2_s3_bucket_path }}{{ rke2_snapshot_file }} /etc/rke2/backup/"
          environment:
            AWS_ACCESS_KEY_ID: "{{ rke2_s3_access_key }}"
            AWS_SECRET_ACCESS_KEY: "{{ rke2_s3_secret_key }}"
          register: "rke2_s3_copy_snapshot"
          until: "rke2_s3_copy_snapshot.rc == 0"
          retries: "5"
          delay: "10"
          changed_when: false

        - name: "9.2 Copy snapshot file from backup directory to etcd directory"
          command: "cp /etc/rke2/backup/{{ rke2_snapshot_file }} /var/lib/rke2/agent/etc/etcd"
          register: "rke2_etcd_snapshot_copy"
          until: "rke2_etcd_snapshot_copy.rc == 0"
          retries: "5"
          delay: "10"
          changed_when: false

        - name: "9.3 Perform etcd snapshot restore"
          command: "rke2 etcdrbackup snapshot-restore --name {{ inventory_hostname }} --config-file /etc/rke2/rke2.yaml"
          environment:
            ETCDCTL_ENDPOINTS: "https://localhost:2379"
            ETCDCTL_CA_FILE: "/var/lib/rke2/agent/etc/kubernetes/admin.conf"
            ETCDCTL_CERT_FILE: "/var/lib/rke2/agent/etc/kubernetes/admin.conf"
            ETCDCTL_KEY_FILE: "/var/lib/rke2/agent/etc/kubernetes/admin.conf"
      when: "etcd_restore_from_s3|bool"

    - name: "Task 10: Start RKE2 service"
      block:
        - name: "10.1 Set RKE2_TOKEN environment variable"
          set_fact:
            environment:
              RKE2_TOKEN: "{{ rke2_token }}"

        - name: "10.2 Start RKE2 server service"
          service:
            name: "rke2-server"
            state: "started"
            enabled: true
      always:
        - name: "10.3 Remove RKE2_TOKEN environment variable"
          set_fact:
            environment: {}

    - name: "Task 11: Mask RKE2 agent service"
      service:
        name: "rke2-agent"
        enabled: false
        state: "stopped"

    - name: "Task 12: Wait for first server to be ready (no CNI)"
      block:
        - name: "12.1 Wait for RKE2 server service to report ready"
          wait_for:
            host: "{{ ansible_host }}"
            port: "6443"
            state: "started"
            timeout: "{{ rke2_ready_timeout }}"
            connect_timeout: "5"
          vars:
            ansible_python_interpreter: "python3"
      when: "rke2_cni == 'none'"

    - name: "Task 13: Wait for first server to be ready (with CNI)"
      block:
        - name: "13.1 Wait for RKE2 server service to report ready"
          wait_for:
            host: "{{ ansible_host }}"
            port: "11443"
            state: "started"
            timeout: "{{ rke2_ready_timeout }}"
            connect_timeout: "5"
          vars:
            ansible_python_interpreter: "python3"
      when: "rke2_cni != 'none'"

    - name: "Task 14: Restore etcd"
      block:
        - name: "14.1 Clean up old etcd data"
          file:
            path: "/var/lib/rke2/agent/etc/etcd"
            state: "absent"

        - name: "14.2 Clean up old etcd data"
          file:
            path: "/etc/kubernetes/pki"
            state: "absent"

        - name: "14.3 Clean up old etcd data"
          file:
            path: "/etc/cni/net.d"
            state: "absent"

        - name: "14.4 Clean up old etcd data"
          file:
            path: "/etc/sysctl.d"
            state: "absent"

        - name: "14.5 Clean up old etcd data"
          file:
            path: "/var/lib/cni"
            state: "absent"

        - name: "14.6 Clean up old etcd data"
          file:
            path: "/opt/cni"
            state: "absent"

        - name: "14.7 Clean up old etcd data"
          file:
            path: "/etc/kubernetes"
            state: "absent"

        - name: "14.8 Clean up old etcd data"
          file:
            path: "/run/secrets/kubernetes.io"
            state: "absent"
      when: "(etcd_restore_from_file|bool) or (etcd_restore_from_s3|bool)"

    - name: "Task 15: Set Active Server variable"
      set_fact:
        rke2_active_server: "{{ inventory_hostname }}"
      delegate_to: "localhost"
      run_once: true
      changed_when: false
