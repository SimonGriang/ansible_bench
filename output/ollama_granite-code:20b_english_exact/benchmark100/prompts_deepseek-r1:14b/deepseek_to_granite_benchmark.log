---
- name: Check if all variables are correctly configured
  import_playbook: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for host to be available
  wait_for_connection:
    timeout: 30
  retries: 10

- name: Prepare system for bootstrap
  block:
    - name: Test connection
      ping:

    - name: Handle connection failures
      fail:
        msg: Connection failed
      when: ansible_ssh_thrift_errors | length > 0

    - name: Gather facts
      setup:

    - name: Install raw bootstrap packages
      package:
        name: "{{ bootstrap_packages }}"
        state: present
  rescue:
    - name: Handle bootstrap failure
      fail:
        msg: Bootstrap failed

- name: Ensure system preparation with Ansible modules
  block:
    - name: Gather facts
      setup:

    - name: Install packages based on detected OS family
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ bootstrap_packages }}"
      when: ansible_os_family == "Debian"

    - name: Ensure the system is fully prepared
      command: /usr/bin/true
  rescue:
    - name: Handle Ansible module failure
      fail:
        msg: Ansible module failed


