- name: Check if Helm binary exists
  stat:
    path: /opt/colatey/bin/helm
  register: helm_check

- name: Check Helm version
  command: /opt/colatey/bin/helm version
  register: helm_existing_version

- name: Download helm
  unarchive:
    src: https://get.helm.sh/helm-v3.2.1-linux-amd64.tar.gz
    dest: /opt/colatey/bin
    remote_src: true
  when: helm_check.stat.exists == false or helm_existing_version.stdout != "version.BuildInfo{Version:\"v3.2.1\", GitCommit:\"f11f682f9d815ff89f38b9539f484a936959528e\", GitTreeState:\"clean\", GoVersion:\"go1.13.12\", Compiler:\"gc\", Platform:\"linux/amd64\"}"

- name: Copy helm binary into place
  copy:
    src: /opt/colatey/bin/linux-amd64/helm
    dest: /opt/colatey/bin/helm
    owner: root
    group: root
    mode: 0755
  when: helm_download.changed == true


