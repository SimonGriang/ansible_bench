---
- name: Update apt cache
  apt:
    update_cache: yes

- name: Update dnf cache
  dnf:
    update_cache: yes

- name: Install packages
  package:
    name: keepalived
    state: present

- name: Create directory for keepalived
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Create Kubernetes API health check script for Debian OS family
  block:
    - name: Copy health check script
      copy:
        src: /path/to/health_check_script.sh
        dest: /usr/local/bin/health_check_script.sh
        owner: root
        group: root
        mode: 0755
    - name: Notify keepalived to restart
      systemd:
        name: keepalived
        daemon_reload: yes
        state: restarted
  when: ansible_os_family == "Debian"

- name: Create Kubernetes API health check script for RedHat OS famliy
  block:
    - name: Copy health check script
      copy:
        src: /path/to/health_check_script.sh
        dest: /usr/local/bin/health_check_script.sh
        owner: root
        group: root
        mode: 0755
    - name: Notify keepalived to restart
      systemd:
        name: keepalived
        daemon_reload: yes
        state: restarted
  when: ansible_os_family == "RedHat"

- name: Create RKE2 Server health check script for Debian OS family
  block:
    - name: Copy health check script
      copy:
        src: /path/to/health_check_script.sh
        dest: /usr/local/bin/health_check_script.sh
        owner: root
        group: root
        mode: 0755
    - name: Notify keepalived to restart
      systemd:
        name: keepalived
        daemon_reload: yes
        state: restarted
  when: ansible_os_family == "Debian"

- name: Create RKE2 Server health check script for RedHat OS family
  block:
    - name: Copy health check script
      copy:
        src: /path/to/health_check_script.sh
        dest: /usr/local/bin/health_check_script.sh
        owner: root
        group: root
        mode: 0755
    - name: Notify keepalived to restart
      systemd:
        name: keepalived
        daemon_reload: yes
        state: restarted
  when: ansible_os_family == "RedHat"

- name: Create keepalived config file
  template:
    src: /path/to/keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: 0644
  notify: restart keepalived

- name: Enable keepalived and make sure it is not masked
  systemd:
    name: keepalived
    enabled: yes
    masked: no
  notify: restart keepalived

- name: Flush handlers
  meta: flush_handlers


