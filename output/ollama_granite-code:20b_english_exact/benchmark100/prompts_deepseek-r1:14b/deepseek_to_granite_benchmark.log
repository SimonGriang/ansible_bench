---
- name: Task 1 | locations | Enable modules
  apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  notify: httpd configuration test
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"

- name: Task 2 | locations | Configure locations
  template:
    src: "httpd.conf.j2"
    dest: "/etc/httpd/conf.d/{{ item }}.conf"
    mode: "0644"
  loop: "{{ httpd_locations }}"
  notify: httpd restart
  register: httpd_configuration

- name: Task 2 | locations | Verify configuration and restart Apache
  meta: flush_handlers


