---

- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  selinux:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    persistent: true
  loop: "{{ httpd_sebooleans }}"
  when:
    - ansible_selinux.status == "enabled"
    - item.name in (httpd_seboolean_http_port_can_connect_to_http_port, httpd_seboolean_http_port_can_connect_to_https_port)

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify:
    - restart httpd
    - test httpd config

- name: Activate httpd module | Debian
  command: "a2enmod {{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when:
    - ansible_os_family == "Debian"
    - item not in (httpd_modules_to_disable_with_command | default([]))

- import_tasks: ssl.yml
  when: https_ssl_enable

- import_tasks: locations.yml
  when: httpd_locations is defined

- import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_config_src }}"
    dest: "{{ httpd_ports_config_dest }}"
    mode: 0644
  notify:
    - restart httpd
    - test httpd config
  when:
    - ansible_os_family in [ "Debian", "Suse" ]

- import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_directory }}/html/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


