---

- import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2 - Configure apk
  apk:
    update_cache: yes
    name: '*'
    state: latest
  changed_when: false

- name: Task 3 - Configure apt
  apt:
    upgrade: no
    update_cache: yes
    name: '*'
    state: latest
    cache_valid_time: 3600
  environment:
    DEBIAN_FRONTEND: noninteractive

- name: Task 4 - Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    exclude: kernel,kernel-headers
  when: ansible_os_family == "RedHat"

- name: Task 5 - Update all software (pacman)
  pacman:
    update_cache: yes
    name: '*'
  when: ansible_os_family == "Archlinux"

- name: Task 6 - Configure yum
  block:
  - name: yum -y update
    yum:
      name: '*'
      state: latest
  - name: install yum-utils
    yum:
      name: yum-utils
      state: latest
    when: ansible_distribution != "CentOS" or ansible_distribution_major_version != "6"
  when: ansible_os_family == "RedHat"

- name: Task 7 - Update all software (zypper)
  zypper:
    name: '*'
    state: latest
  when: ansible_os_family == "Suse"


