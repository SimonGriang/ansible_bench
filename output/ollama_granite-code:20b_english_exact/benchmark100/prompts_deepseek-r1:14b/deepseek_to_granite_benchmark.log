---
- import_tasks: assert.yml
- name: Install cron package
  package:
    name: "{{ cron_packages }}"
    state: present
- name: Configure cron shell environment
  lineinfile:
    path: /etc/cron.d/env
    line: "SHELL={{ cron_shell }}"
    create: true
- name: Configure cron path environment
  lineinfile:
    path: /etc/cron.d/env
    line: "PATH={{ cron_path }}"
    create: true
- name: Configure cron mailto settings
  lineinfile:
    path: /etc/cron.d/mailto
    line: "MAILTO={{ cron_mailto }}"
    create: true
- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: "{{ cron_service is defined }}"
- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default(omit) }}"
  loop: "{{ cron_jobs }}"


