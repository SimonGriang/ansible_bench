fy: restart mysql\n\n- name: Task 13 - Flush handlers again\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-10T08:50:19.853917374Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16446778306, 'load_duration': 33779343, 'prompt_eval_count': 1415, 'prompt_eval_duration': 7226452, 'eval_count': 589, 'eval_duration': 16404839380, 'model_name': 'granite-code:20b'} id='run--f4e304fc-6bd4-434b-b522-84499b2de00f-0' usage_metadata={'input_tokens': 1415, 'output_tokens': 589, 'total_tokens': 2004} 21%|██        | 21/100 [19:47<1:41:35, 77.16s/it]
