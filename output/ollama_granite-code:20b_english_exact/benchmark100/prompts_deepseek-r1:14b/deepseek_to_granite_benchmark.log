:40.275374696Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10029003216, 'load_duration': 37463278, 'prompt_eval_count': 637, 'prompt_eval_duration': 377803810, 'eval_count': 574, 'eval_duration': 9612794159, 'model_name': 'granite-code:20b'} id='run--7b39074a-5a45-4fe5-b3cd-bcaceb578a95-0' usage_metadata={'input_tokens': 637, 'output_tokens': 574, 'total_tokens': 1211}
