---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install prerequisites
  ansible.builtin.package:
    name: "{{ vault_prerequisites }}"
    state: present
  tags:
    - vault

- name: Include installation method specific tasks
  ansible.builtin.include_tasks: "{{ vault_installation_method }}.yml"
  tags:
    - vault

- name: Add Vault environment variables
  ansible.builtin.lineinfile:
    path: /etc/vault.d/vault.env
    regexp: "^{{ item.key }}="
    line: "{{ item.key }}={{ item.value }}"
    state: present
  notify: Restart vault
  with_dict: "{{ vault_environment_settings }}"
  tags:
    - vault

- name: Include hardening tasks
  ansible.builtin.import_tasks: hardening.yml
  tags:
    - vault

- name: Start and enable vault (for OSS type)
  ansible.builtin.service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"
  tags:
    - vault

- name: Enable vault (for non-OSS type)
  ansible.builtin.service:
    name: vault
    enabled: true
  when: vault_type != "oss"
  tags:
    - vault


