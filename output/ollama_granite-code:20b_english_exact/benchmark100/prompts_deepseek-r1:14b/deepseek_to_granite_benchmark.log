      get_url:
        url: "{{ item.url }}"
        dest: "{{ item.path }}"
        mode: 0640
      with_items: "{{ rke2_artifacts }}"
      loop_control:
        label: "{{ item.path }}"
      register: rke2_artifacts_dl
      until: rke2_artifacts_dl is succeeded
      retries: 3
      delay: 10
      delegate_to: localhost
      check_mode: false
      run_once: true

