ommand: /usr/local/bin/rke2-rolling-restart.sh\n  when: groups[\'kube_node\'] is defined and groups[\'kube_control_plane\'] is defined\n\n- name: Perform final steps\n  debug:\n    msg: "All tasks completed successfully!"' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-10T10:14:03.990783572Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17037581175, 'load_duration': 20086613, 'prompt_eval_count': 1618, 'prompt_eval_duration': 7381190, 'eval_count': 630, 'eval_duration': 17009362779, 'model_name': 'granite-code:20b'} id='run--30803c68-ff6a-4459-b966-f469079aef45-0' usage_metadata={'input_tokens': 1618, 'output_tokens': 630, 'total_tokens': 2248}
