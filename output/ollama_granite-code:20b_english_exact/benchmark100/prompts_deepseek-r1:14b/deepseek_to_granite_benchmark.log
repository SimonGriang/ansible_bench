---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  apk:
    update_cache: yes
    update_cache_only: yes
    upgrade: no
    upgrade_only: no

- name: Configure apt
  apt:
    upgrade: "no"
    update_cache: yes
    cache_valid_time: 3600
    dpkg_options: "--force-confold"
    force_apt_get: yes
  environment:
    DEBIAN_FRONTEND: "noninteractive"

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    exclude: python-*,openssh-server,bind-utils,openssh,openssl
  when: ansible_distribution == "Fedora"

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes

- name: Configure yum
  dnf:
    name: '*'
    state: latest
  when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "6"

- name: Configure yum
  yum:
    name: '*'
    state: latest
    update_cache: yes
  when: ansible_os_family == "RedHat" and ansible_distribution_major_version != "6"

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest


