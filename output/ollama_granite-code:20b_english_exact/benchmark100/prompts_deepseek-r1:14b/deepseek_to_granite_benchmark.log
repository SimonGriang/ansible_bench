---
- name: Include assert.yml
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present
  when:
    - grub_packages is defined
    - grub_packages | length > 0

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: ^GRUB_TIMEOUT=.*
    line: GRUB_TIMEOUT="{{ grub_timeout }}"
    backrefs: yes

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: ^GRUB_RECORDFAIL_TIMEOUT=.*
    line: GRUB_RECORDFAIL_TIMEOUT="{{ grub_recordfail_timeout }}"
    backrefs: yes

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    path: /etc/default/grub
    regexp: ^GRUB_CMDLINE_LINUX=.*
    line: GRUB_CMDLINE_LINUX="{{ grub_options }}"
    backrefs: yes
  when:
    - grub_options is defined
    - grub_options | length > 0

- name: Include password.yml
  import_tasks: password.yml
  when:
    - grub_set_password is defined
    - grub_set_password

- name: Flush handlers
  meta: flush_handlers


