    - name: "Migrate adoptopenjdk to temurin (if selected)"
      set_fact:
        java_jdk_vendor: "temurin"
      when: "java_jdk_vendor == 'adoptopenjdk'"

    - name: "Gather OS specific variables"
      include_vars: "{{ item }}"
      with_first_found:
        - files:
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_distribution_major_version }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_system }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_distribution }}.yml"
            - "{{ java_jdk_vendor }}.yml"
          skip: true

    - name: "Gather architecture specific variables"
      include_vars: "architecture.yml"

    - name: "Set OS-specific variables (I)"
      set_fact:
        java_open_jdk_major_version: "{{ _java_open_jdk_major_version | default(omit) }}"
        java_open_jdk_pkg: "{{ _java_open_jdk_pkg | default(omit) }}"
        java_open_jdk_pkg_url: "{{ _java_open_jdk_pkg_url | default(omit) }}"
      when: "{{ item }} is defined and {{ item }} | length > 0"
      with_items:
        - "{{ java_open_jdk_major_version }}"
        - "{{ java_open_jdk_pkg }}"
        - "{{ java_open_jdk_pkg_url }}"

    - name: "Set OS and architecture specific variables (II)"
      set_fact:
        java_open_jdk_home_dir: "{{ _java_open_jdk_home_dir | default(omit) }}"
        java_open_jdk_pkg: "{{ _java_open_jdk_pkg | default(omit) }}"
      when: "{{ item }} is defined and {{ item }} | length > 0"
      with_items:
        - "{{ java_open_jdk_home_dir }}"
        - "{{ java_open_jdk_pkg }}"

    - name: "Set specific variables"
      set_fact:
        java_home: "{{ java_open_jdk_home }}"

    - name: "Debian pre-requisites"
      block:
        - name: "Removing deprecated repositories"
          apt_repository:
            repo: "deb http://ppa.launchpad.net/webupd8team/java/ubuntu xenial main"
            state: "absent"

        - name: "Installing extra apt tools"
          apt:
            name:
              - "software-properties-common"
              - "apt-transport-https"
              - "ca-certificates"
              - "gnupg"
            state: "present"

        - name: "Adding required key repositories"
          apt_key:
            url: "{{ item.url }}"
            id: "{{ item.id }}"
            state: "present"
          with_items: "{{ java_debian_apt_keys }}"

        - name: "Adding required repositories"
          apt_repository:
            repo: "{{ item }}"
            state: "present"
          with_items: "{{ java_debian_apt_repositories }}"

    - name: "RedHat pre-requisites"
      block:
        - name: "Adding required key repositories"
          get_url:
            url: "{{ item.url }}"
            dest: "/etc/yum.repos.d/{{ item.file_name }}"
            owner: "root"
            group: "root"
            mode: "0644"
          with_items: "{{ java_redhat_yum_repos }}"

        - name: "Adding required repositories"
          command: "yum-config-manager --add-repo {{ item }}"
          with_items: "{{ java_redhat_yum_repositories }}"

    - name: "Install required libs"
      package:
        name: "{{ item }}"
        state: "present"
      with_items: "{{ java_libs }}"

    - name: "Install Java, Debian"
      apt:
        name: "{{ java_open_jdk_pkg }}"
        state: "present"
        update_cache: true
      when: "java_install_flavor == 'openjdk' and ansible_os_family == 'Debian'"

    - name: "Install Java, RedHat"
      yum:
        name: "{{ java_open_jdk_pkg }}"
        state: "present"
      when: "java_install_flavor == 'openjdk' and ansible_os_family == 'RedHat'"

    - name: "Export environment variables"
      template:
        src: "jdk.sh.j2"
        dest: "/etc/profile.d/jdk.sh"
        mode: "0644"

    - name: "Source environment variables"
      shell: "source /etc/profile"
      args:
        executable: "/bin/bash"

    - name: "Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11"
      alternatives:
        name: "java"
        path: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java"
      when: "java_version is version('11', '<')"

    - name: "Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11"
      alternatives:
        name: "java"
        path: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java"
      when: "java_version is version('11', '>=')"


