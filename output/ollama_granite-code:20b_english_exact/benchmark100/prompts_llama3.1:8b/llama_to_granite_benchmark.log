---
- name: Configure httpd
  hosts: localhost
  vars:
    httpd_config_directory: /etc/httpd/conf.d
    httpd_directories:
      - path: /var/www/html
        mode: "0755"
        state: directory
      - path: /var/www/files
        mode: "0750"
        state: directory
      - path: /var/www/public
        mode: "0755"
        state: directory
  tasks:
    - name: Create necessary directories for HTTP server
      file:
        path: "{{ item.path }}"
        mode: "{{ item.mode }}"
        state: "{{ item.state }}"
        label: "{{ item.path }}"
      loop: "{{ httpd_directories }}"

    - name: Configure directory configurations for HTTP server
      template:
        src: directory.conf.j2
        dest: "{{ httpd_config_directory }}/{{ item.path | basename }}.conf"
      loop: "{{ httpd_directories }}"
      notify: Test httpd configuration validity, Restart httpd
  handlers:
    - name: Test httpd configuration validity
      command: httpd -t
      notify: Restart httpd

    - name: Restart httpd
      service:
        name: httpd
        state: restarted


