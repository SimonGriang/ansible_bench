---
- name: Create the directory for RKE2 manifests
  file:
    path: /var/lib/rke2/server/manifests
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Copy kube-vip YAML files to the RKE2 manifests directory
  copy:
    src: "{{ item }}"
    dest: /var/lib/rke2/server/manifests
    mode: preserve
  with_items:
    - /path/to/kube-vip.yaml.j2
    - /path/to/kube-vip-arp.yaml.j2

- name: Copy kube-vip load balancer manifests to the RKE2 manifests directory
  copy:
    src: "{{ item }}"
    dest: /var/lib/rke2/server/manifests
    mode: preserve
  with_items:
    - /path/to/kube-vip-cloud-provider.yaml.j2
  when: rke2_kubevip_cloud_provider_enable


