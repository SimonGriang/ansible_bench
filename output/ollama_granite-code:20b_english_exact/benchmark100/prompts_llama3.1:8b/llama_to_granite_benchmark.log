---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install nginx package
  package:
    name: nginx
    state: present

- name: Place customized nginx.conf file
  template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    validate: nginx -t -c %s
    mode: 0644

- name: Ensure /etc/nginx/conf.d directory exists and is correctly configured
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: 0755

- name: Place customized default.conf file
  template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: 0644
  notify: Restart nginx

- name: Start and enable nginx service
  service:
    name: nginx
    state: started
    enabled: true


