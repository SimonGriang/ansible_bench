    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_file }}"
    owner: root
    group: root
    mode: "0644"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Activate Apache HTTP Server modules
  ansible.builtin.command: "a2enmod {{ item }}"
  args:
    creates: "{{ httpd_module_enabled_dir }}/{{ item }}.load"
  notify: Test httpd configuration validity
  with_items: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == 'Debian'

- name: Configure SSL for Apache HTTP Server
  import_tasks: ssl.yml
  when: https_ssl_enable is defined

- name: Configure locations for Apache HTTP Server
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Configure virtual hosts for Apache HTTP Server
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure custom ports for Apache HTTP Server
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: /etc/apache2/ports.conf
    owner: root
    group: root
    mode: "0644"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  when: ansible_os_family in ['Debian', 'Suse']

- name: Configure directories for Apache HTTP Server
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Remove default index.html file
  ansible.builtin.file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example is defined

- name: Start and enable Apache HTTP Server service
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


