---
- name: Initialize OpenVPN PKI directory
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: "0755"

- name: Initialize EasyRSA PKI directory
  ansible.builtin.command: /etc/openvpn/easy-rsa/easyrsa init-pki
  args:
    creates: /etc/openvpn/easy-rsa/pki

- name: Build CA certificate
  ansible.builtin.command: /etc/openvpn/easy-rsa/easyrsa build-ca nopass
  args:
    creates: /etc/openvpn/easy-rsa/pki/ca.crt

- name: Generate DH parameters
  ansible.builtin.command: /etc/openvpn/easy-rsa/easyrsa gen-dh
  args:
    creates: /etc/openvpn/easy-rsa/pki/dh.pem

- name: Build server certificate
  ansible.builtin.command: /etc/openvpn/easy-rsa/easyrsa build-server-full server nopass
  args:
    creates: /etc/openvpn/easy-rsa/pki/issued/server.crt

- name: Build client certificate
  ansible.builtin.command: /etc/openvpn/easy-rsa/easyrsa build-client-full client nopass
  args:
    creates: /etc/openvpn/easy-rsa/pki/issued/client.crt

- name: Generate CRL
  ansible.builtin.command: /etc/openvpn/easy-rsa/easyrsa gen-crl
  args:
    creates: /etc/openvpn/easy-rsa/pki/crl.pem

- name: Generate DH key
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to server directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/{{ item }}
    remote_src: true
  loop:
    - ca.crt
    - dh.pem
    - ta.key
    - issued/server.crt
    - private/server.key
    - issued/client.crt
    - private/client.key

- name: Copy files to OpenVPN directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/{{ item }}
    remote_src: true
  loop:
    - ca.crt
    - ta.key

- name: Place server.conf file
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    owner: root
    group: root
    mode: "0644"


