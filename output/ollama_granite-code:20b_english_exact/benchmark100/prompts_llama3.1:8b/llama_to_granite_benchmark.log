---
- name: Configure httpd vhosts
  hosts: all
  tasks:
    - name: Create the document root for each vhost
      file:
        path: "{{ item.documentroot }}"
        state: directory
        mode: 0755
      loop: "{{ httpd_vhosts }}"
      when: item.documentroot is defined and (item.create_docroot is not defined or item.create_docroot)

    - name: Configure the vhosts
      template:
        src: "{{ vhost_conf_template }}"
        dest: "/etc/httpd/conf.d/{{ item.name }}.conf"
        mode: 0644
      loop: "{{ httpd_vhosts }}"
      notify:
        - Test httpd configuration validity
        - Restart httpd


