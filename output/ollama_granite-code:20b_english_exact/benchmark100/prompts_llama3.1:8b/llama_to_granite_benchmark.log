---
- name: Configure package management
  import_tasks: assert.yml
  when: ansible_pkg_mgr == "apk"

- name: Configure package management
  apt:
    update_cache: yes
    cache_valid_time: 86400
    upgrade: dist
    autoremove: yes
  when: ansible_pkg_mgr == "apt"

- name: Update all software
  dnf:
    name: '*'
    state: latest
    exclude: kernel, kernel-headers
  when: ansible_pkg_mgr == "dnf"

- name: Update all software
  pacman:
    update_cache: yes
    upgrade: yes
  when: ansible_pkg_mgr == "pacman"

- name: Configure package management
  yum:
    name: '*'
    state: latest
    exclude: kernel, kernel-headers
  when: ansible_pkg_mgr == "yum" and ansible_distribution_major_version != "6"

- name: Ensure yum-utils is installed
  yum:
    name: yum-utils
    state: latest
  when: ansible_pkg_mgr == "yum" and ansible_distribution_major_version == "6"

- name: Update all software
  zypper:
    name: '*'
    state: latest
  when: ansible_pkg_mgr == "zypper"


