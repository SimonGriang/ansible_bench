---
- name: Hardening | Disable Swap
  command: swapoff -a
  when:
    - ansible_swaptotal_mb > 0
    - vault_hardening_disable_swap

- name: Hardening | Disable Core Dumps
  pam_limits:
    domain: "{{ item }}"
    limit_type: "{{ item }}"
    limit_item: core
    value: 0
  loop:
    - hard
    - soft
  when: vault_hardening_disable_core_dumps

- name: Hardening | Disable Shell Command History
  copy:
    dest: /etc/profile.d/vault.sh
    content: |
      export HISTCONTROL=ignoreboth
  when: vault_hardening_disable_shell_command_history

- name: Hardening | Configure SELinux / AppArmor
  block:
    - name: Install selinux-policy package
      package:
        name: selinux-policy
        state: present

    - name: Set SELinux policy to targeted and state to enforcing
      command: setenforce Enforcing

    - name: Enforce AppArmor
      command: aa-enforce
  when: ansible_selinux.status == "enabled"



