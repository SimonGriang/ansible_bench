 'load_duration': 39171590, 'prompt_eval_count': 1536, 'prompt_eval_duration': 9020505, 'eval_count': 546, 'eval_duration': 11587283890, 'model_name': 'granite-code:20b'} id='run--7f1bfed2-196a-4b12-97b7-7deee17acf48-0' usage_metadata={'input_tokens': 1536, 'output_tokens': 546, 'total_tokens': 2082}
