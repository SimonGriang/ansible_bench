      set_fact:
        java_open_jdk_home_dir: "{{ _java_open_jdk_home_dir | default(omit) }}"
        java_open_jdk_pkg: "{{ _java_open_jdk_pkg | default(omit) }}"
      when: "{{ item }} is defined and {{ item }} | length > 0"
      with_items:
        - "{{ java_open_jdk_home_dir }}"
        - "{{ java_open_jdk_pkg }}"

    - name: "Set specific variables"
      set_fact:
        java_home: "{{ java_open_jdk_home }}"

    - name: "Debian pre-requisites"
      block:
        - name: "Removing deprecated repositories"
          apt_repository:
            repo: "deb http://ppa.launchpad.net/webupd8team/java/ubuntu xenial main"
            state: "absent"

        - name: "Installing extra apt tools"
          apt:
            name:
              - "software-properties-common"
              - "apt-transport-https"
              - "ca-certificates"
              - "gnupg"
            state: "present"

        - name: "Adding required key repositories"
          apt_key:
            url: "{{ item.url }}"
            id: "{{ item.id }}"
            state: "present"
          with_items: "{{ java_debian_apt_keys }}"

        - name: "Adding required repositories"
          apt_repository:
            repo: "{{ item }}"
            state: "present"
          with_items: "{{ java_debian_apt_repositories }}"

    - name: "RedHat pre-requisites"
      block:
        - name: "Adding required key repositories"
          get_url:
            url: "{{ item.url }}"
            dest: "/etc/yum.repos.d/{{ item.file_name }}"
            owner: "root"
            group: "root"
            mode: "0644"
          with_items: "{{ java_redhat_yum_repos }}"

