---
- import_playbook: assert.yml
  connection: local
  run_once: true

- name: Install required packages for selinux
  ansible.builtin.package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure selinux
  when:
    - selinux is defined
    - not selinux.container_role
    - not selinux.docker_container
  block:
    - name: Manage selinux policy
      ansible.posix.selinux:
        policy: "{{ selinux.policy }}"
        state: "{{ selinux.state }}"
      notify: Reboot

    - name: Manage selinux booleans
      ansible.posix.seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      when: selinux_booleans is defined
      notify: Reboot


