---
- name: Import cron configuration
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages for cron service
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell environment for cron service
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^SHELL='
    line: 'SHELL="{{ cron_shell }}"'
  notify: restart cron

- name: Configure system path for cron service
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^PATH='
    line: 'PATH="{{ cron_path }}"'
  notify: restart cron

- name: Configure mailto parameter for cron service
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^MAILTO='
    line: 'MAILTO="{{ cron_mailto }}"'
  notify: restart cron

- name: Start and enable the cron service
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service

- name: Schedule the requested cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    state: "{{ item.state }}"
  loop: "{{ cron_jobs }}"
  notify: restart cron


