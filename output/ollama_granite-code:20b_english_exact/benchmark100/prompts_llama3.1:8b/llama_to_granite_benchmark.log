---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true

- name: Install prerequisites
  ansible.builtin.package:
    name: "{{ vault_prerequisites }}"
    state: present
  tags: ["vault"]

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"
  tags: ["vault"]

- name: Add Vault environment variables
  ansible.builtin.template:
    src: vault.env.j2
    dest: /etc/vault.d/vault.env
    mode: "0644"
  notify: restart vault
  tags: ["vault"]

- name: Include hardening tasks
  include_tasks: hardening.yml
  tags: ["vault"]

- name: Start and enable vault on OSS
  when: vault_type == "oss"
  block:
    - name: Start and enable vault service
      ansible.builtin.service:
        name: vault
        state: started
        enabled: true
      tags: ["vault"]

- name: Enable vault (non-OSS)
  when: vault_type != "oss"
  block:
    - name: Enable vault service
      ansible.builtin.service:
        name: vault
        enabled: true
      tags: ["vault"]


