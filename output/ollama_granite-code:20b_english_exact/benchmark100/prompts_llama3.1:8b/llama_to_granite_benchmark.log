          uri:
            url: "{{ rke2_url_scheme }}://{{ ansible_host }}:{{ rke2_api_port }}/ping"
            method: GET
            status_code: 200
            return_content: yes
            body_format: json
            body:
              ping: ping
          register: rke2_ping
          until: rke2_ping.json.ping == "pong"
          retries: 30
          delay: 10
        - name: "Start rke2-server.service"
          service:
            name: rke2-server
            state: started
            env:
              RKE2_TOKEN: "{{ rke2_token }}"
      when: rke2_server_type == "server" and inventory_hostname == groups[rke2_server_group_name][0]
    - name: "Mask RKE2 agent service on first server"
      service:
        name: rke2-agent
        enabled: no
      when: rke2_server_type == "server" and inventory_hostname == groups[rke2_server_group_name][0]
    - name: "Wait for first server be ready - no CNI"
      uri:
        url: "{{ rke2_url_scheme }}://{{ ansible_host }}:{{ rke2_api_port }}/nodes/{{ ansible_host }}"
        method: GET
        status_code: 200
        return_content: yes
        body_format: json
        body:
          address: "{{ ansible_host }}"
      register: rke2_node
      until: rke2_node.json.status.nodeInfo.conditions[0].type == "Ready" and rke2_node.json.status.nodeInfo.plugins == []
      retries: 60
      delay: 10
      when: rke2_server_type == "server" and inventory_hostname == groups[rke2_server_group_name][0] and not rke2_cni | bool
    - name: "Wait for first server be ready - with CNI"
      uri:
        url: "{{ rke2_url_scheme }}://{{ ansible_host }}:{{ rke2_api_port }}/nodes/{{ ansible_host }}"
        method: GET
        status_code: 200
        return_content: yes
        body_format: json
        body:
          address: "{{ ansible_host }}"
      register: rke2_node
      until: rke2_node.json.status.nodeInfo.conditions[0].type == "Ready"
      retries: 60
      delay: 10
      when: rke2_server_type == "server" and inventory_hostname == groups[rke2_server_group_name][0] and rke2_cni | bool
    - name: "Restore etcd"
      block:
        - name: "Remove old secrets"
          shell: |
            kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get secrets -A | grep -v 'default\|kube-public\|kube-system' | awk '{print $1 "/" $2}' | xargs kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete secret -A
          args:
            executable: /bin/bash
        - name: "Remove old nodes"
          shell: |
            kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o json | jq -r '.items[].metadata.name' | grep -v '{{ ansible_host }}' | xargs kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete node -f
          args:
            executable: /bin/bash
        - name: "Create new nodes"
          shell: |
            kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o json | jq -r '.items[].metadata.name' | grep -v '{{ ansible_host }}' | xargs kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete node -f
          args:
            executable: /bin/bash
      when: rke2_etcd_local | bool
    - name: "Set an Active Server variable"
      set_fact:
        active_server: "{{ inventory_hostname }}"
      delegate_to: "{{ item }}"
      delegate_facts: true
      loop: "{{ groups[rke2_server_group_name] }}"
