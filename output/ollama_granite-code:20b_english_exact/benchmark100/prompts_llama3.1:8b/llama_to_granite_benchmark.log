---
- name: Bootstrap server
  hosts: all
  tasks:
    - name: Check all variables have been set correctly
      include_tasks: assert.yml
    - name: Wait for host
      wait_for:
        port: "{{ ansible_port }}"
        host: "{{ ansible_ssh_host|default(inventory_hostname) }}"
        timeout: "{{ bootstrap_timeout }}"
      when: ansible_connection not in ["container", "docker", "community.docker.docker"]
    - name: Prepare the system
      block:
        - name: Check connection
          register: connection_test
          failed_when: connection_test.stderr | length > 0
        - name: Gather bootstrap facts
          include_tasks: gather_facts.yml
        - name: Install bootstrap packages
          include_tasks: install_bootstrap_packages.yml
          when: bootstrap__facts_packages is defined and bootstrap__facts_packages | length > 0
      rescue:
        - name: Debug connection test
          debug:
            msg: "{{ connection_test.stderr }}"
    - name: Ensure system is prepared by issuing ansible modules
      become: "{{ bootstrap_ become }}"
      become_user: "{{ bootstrap_become_user }}"
      block:
        - name: Gather ansible facts
          ansible.builtin.setup:
            gather_subset: all
        - name: Install required packages
          ansible.builtin.package:
            name: "{{ bootstrap__facts_packages }}"
            state: present
          when: bootstrap__facts_packages is defined and bootstrap__facts_packages | length > 0
          loop: "{{ bootstrap__facts_packages }}"
          loop_control:
            loop_var: bootstrap__facts_packages


