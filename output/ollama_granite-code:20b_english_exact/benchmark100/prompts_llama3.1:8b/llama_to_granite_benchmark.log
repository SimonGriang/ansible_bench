---
- name: Bootstrap
  hosts: all
  gather_facts: false
  tasks:
    - name: Gather basic system facts
      raw: "cat /etc/os-release"
      register: bootstrap_facts
      become: false

    - name: Set distribution name and major version
      set_fact:
        bootstrap_distribution: "{{ bootstrap_facts.stdout_lines | select('match','^NAME=\"(.*)\"') | first | regex_replace('^NAME=\"(.*)\"', '\\1') }}"
        bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout_lines | select('match','^VERSION_ID=\"(.*)\"') | first | regex_replace('^VERSION_ID=\"(.*)\"', '\\1') }}"
      loop: "{{ bootstrap_facts.stdout_lines }}"
      loop_control:
        label: "{{ bootstrap_facts.stdout_lines | select('match','^NAME=\"(.*)\"') | first | regex_replace('^NAME=\"(.*)\"', '\\1') }}"

    - name: Set operating system family
      set_fact:
        bootstrap_os_family: "{{ bootstrap_distribution | regex_replace('(.*)', bootstrap_os_family_map) }}"
      loop: "{{ bootstrap_distribution }}"
      loop_control:
        label: "{{ bootstrap_distribution | regex_replace('(.*)', bootstrap_os_family_map) }}"


