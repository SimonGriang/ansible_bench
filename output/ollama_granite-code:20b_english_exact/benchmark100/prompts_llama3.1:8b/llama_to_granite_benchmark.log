---
- include_tasks: keepalived.yml
  when: ha_mode and rke2_servers_group in group_names
- include_tasks: rke2.yml
- include_tasks: cis.yml
  when: cis_profile is defined
- include_tasks: find_active_server.yml
- include_tasks: kernel_modules.yml
  when: ha_mode and rke2_ipvs_lb
- include_tasks: kubevip.yml
  when: ha_mode and rke2_ipvs_lb
- include_tasks: ingress-nginx.yml
  when: rke2_ingress_nginx_values is defined
- include_tasks: first_server.yml
  when: rke2_servers_group in group_names and (active_server is not defined or groups[rke2_servers_group] | length == 1)
- include_tasks: first_server_restore.yml
  when: rke2_servers_group in group_names and active_server is defined and (groups[rke2_servers_group] | length == 1 or groups[rke2_servers_group] | last == inventory_hostname) and rke2_etcd_restore
- include_tasks: download_kubeconfig.yaml
  when: rke2_servers_group in group_names and download_kubeconfig
- include_tasks: remaining_nodes.yml
  when: rke2_servers_group in group_names and active_server is defined and groups[rke2_servers_group] | length > 1
- include_tasks: rolling_restart.yml
  loop: "{{ groups[rke2_servers_group] }}"
  loop_control:
    loop_var: inventory_hostname
  when: rke2_servers_group in group_names and rke2_version != 'latest' and rke2_installed
- include_tasks: rolling_restart.yml
  loop: "{{ groups[rke2_agents_group] }}"
  loop_control:
    loop_var: inventory_hostname
  when: rke2_agents_group in group_names and rke2_version != 'latest' and rke2_installed
- meta: flush_handlers
- include_tasks: change_config.yml
  loop: "{{ groups[rke2_servers_group] + groups[rke2_agents_group] }}"
  loop_control:
    loop_var: inventory_hostname
  when: (rke2_servers_group in group_names or rke2_agents_group in group_names) and rke2_config_files_changed and rke2_restart_flag
- include_tasks: summary.yml


