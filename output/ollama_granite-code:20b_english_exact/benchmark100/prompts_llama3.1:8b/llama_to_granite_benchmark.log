---
- name: Install the dns packages
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Create the required directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: named
    group: named
    mode: "0755"
  loop:
    - /etc/named
    - /etc/named/data
    - /etc/named/dynamic
    - /etc/systemd/system/named.service.d

- name: Create the required group
  ansible.builtin.group:
    name: named
    state: present

- name: Create the required user
  ansible.builtin.user:
    name: named
    group: named
    shell: /usr/sbin/nologin
    state: present

- name: Generate the rndc key
  ansible.builtin.command: rndc-confgen -a -c /etc/named/rndc.conf
  args:
    creates: /etc/named/rndc.key

- name: Set permissions on the rndc key file
  ansible.builtin.file:
    path: /etc/named/rndc.key
    owner: named
    group: named
    mode: "0640"

- name: Download the named.root file
  ansible.builtin.get_url:
    url: "{{ dns_root_hints }}"
    dest: /etc/named/named.root
    mode: "0644"

- name: Create the zone file
  ansible.builtin.template:
    src: named.conf.j2
    dest: /etc/named/named.conf
    mode: "0644"
    validate: /usr/sbin/rndc checkconf %s

- name: Add zones to the configuration
  ansible.builtin.template:
    src: named.zones.j2
    dest: /etc/named/data/zones.db
    mode: "0644"
    validate: /usr/sbin/rndc checkzone %s

- name: Place the systemd override
  ansible.builtin.copy:
    src: override.conf
    dest: /etc/systemd/system/named.service.d/override.conf
    mode: "0644"
  notify: reload daemon

- name: Start and enable the DNS service
  ansible.builtin.service:
    name: named
    state: started
    enabled: true


