---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Install using package
  block:
    - name: Task 2.1 - Install repository for RedHat
      import_tasks: tasks/2.1.yml
      when: ansible_os_family == "RedHat" or ansible_os_family == "Rocky"

    - name: Task 2.2 - Configure Debian
      block:
        - name: Task 2.2.1 - Install required package gpg
          package:
            name: gpg
            state: present

        - name: Task 2.2.2 - Install apt key for Debian
          apt_key:
            url: https://apt.releases.hashicorp.com/gpg
            state: present

        - name: Task 2.2.3 - Install repository for Debian
          copy:
            src: hashicorp.list
            dest: /etc/apt/sources.list.d/hashicorp.list
      when: ansible_os_family == "Debian"

    - name: Task 2.3 - Install hashicorp product using package
      block:
        - name: Task 2.3.1 - Install latest hashicorp product using package
          package:
            name: hashicorp-product
            state: latest

        - name: Task 2.3.2 - Install versioned hashicorp product using package
          package:
            name: hashicorp-product
            version: "{{ version }}"
            state: present
      when: install_method == "package"
  when: install_method == "package"

- name: Task 3 - Install manually
  block:
    - name: Task 3.1 - Download hashicorp product
      get_url:
        url: "https://releases.hashicorp.com/hashicorp-product/{{ version }}/hashicorp-product-{{ version }}-{{ ansible_system | lower }}-{{ ansible_userspace_bits }}.tar.gz"
        dest: /tmp/hashicorp-product.tar.gz

    - name: Task 3.2 - Unpack hashicorp product
      unarchive:
        src: /tmp/hashicorp-product.tar.gz
        dest: /tmp
        remote_src: true
  when: install_method == "manual"


