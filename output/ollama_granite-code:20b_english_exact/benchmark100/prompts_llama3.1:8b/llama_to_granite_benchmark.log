---
- name: Task 1 - Enable Apache2 modules
  become: true
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"
  community.general.apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  notify: restart apache

- name: Task 2 - Configure Apache2 locations
  become: true
  template:
    src: location.conf.j2
    dest: /etc/httpd/conf.d/{{ item.name }}.conf
    mode: "0644"
  loop: "{{ httpd_locations }}"
  notify: restart apache


