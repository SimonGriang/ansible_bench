    docker_compose_current_version: "{{ docker_compose_vsn.stdout | regex_search('([0-9]+.[0-9]+.[0-9]+)') }}"

- name: Remove existing docker-compose version
  file:
    path: "{{ docker_compose_path }}"
    state: absent
  when: docker_compose_current_version != docker_compose_version

- name: Download and install Docker Compose
  get_url:
    url: "{{ docker_compose_url }}"
    dest: "{{ docker_compose_path }}"
    mode: 0755
  when: docker_compose_current_version != docker_compose_version or docker_compose_current_version == ""


