---
- name: Create SSL keys, CSR, certificates, and PKCS#12 file
  hosts: localhost
  tasks:
    - name: Create SSL private key
      openssl_privatekey:
        path: /path/to/private/key.pem
        chmod: "0600"
        owner: root
        group: root

    - name: Create SSL CSR
      openssl_csr:
        path: /path/to/csr.csr
        privatekey_path: /path/to/private/key.pem
        common_name: example.com
        chmod: "0644"
        owner: root
        group: root

    - name: Create SSL certificates
      openssl_certificate:
        path: /path/to/certs.pem
        privatekey_path: /path/to/private/key.pem
        csr_path: /path/to/csr.csr
        provider: selfsigned
        chmod: "0644"
        owner: root
        group: root

    - name: Create PKCS#12 file
      openssl_pkcs12:
        path: /path/to/pkcs12.pfx
        privatekey_path: /path/to/private/key.pem
        certificate_path: /path/to/certs.pem
        friendly_name: example
        chmod: "0600"
        owner: root
        group: root

    - name: Read private key
      slurp:
        src: /path/to/private/key.pem
      register: private_key

    - name: Read certificate
      slurp:
        src: /path/to/certs.pem
      register: certificate

    - name: Create combined private key and certificate file
      copy:
        content: "{{ private_key['content'] }}{{ certificate['content'] }}"
        dest: /path/to/combined.pem
        chmod: "0600"
        owner: root
        group: root


