---
- name: Task 1 - Import assert.yml task
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Install using package
  block:
    - name: Task 2.1 - Install repository for RedHat
      ansible.builtin.yum:
        name: https://releases.hashicorp.com/vagrant/2.2.20/vagrant_2.2.20_x86_64.rpm
        state: present
      when: ansible_os_family == "RedHat" or ansible_os_family == "Rocky"

    - name: Task 2.2 - Configure Debian
      block:
        - name: Task 2.2.1 - Install required package gpg
          ansible.builtin.apt:
            name: gpg
            state: present

        - name: Task 2.2.2 - Install apt key for Debian
          ansible.builtin.apt_key:
            url: https://apt.releases.hashicorp.com/gpg
            state: present

        - name: Task 2.2.3 - Install repository for Debian
          ansible.builtin.apt_repository:
            repo: deb [arch=amd64] https://apt.releases.hashicorp.com/vagrant/apt/debian bullseye main
            state: present
      when: ansible_os_family == "Debian"

    - name: Task 2.3 - Install hashicorp product using package
      block:
        - name: Task 2.3.1 - Install latest hashicorp product using package
          ansible.builtin.package:
            name: vagrant
            state: latest
          when: hashicorp_installation_method == "package" and hashicorp_version == "latest"

        - name: Task 2.3.2 - Install versioned hashicorp product using package
          ansible.builtin.package:
            name: "vagrant-{{ hashicorp_version }}"
            state: present
          when: hashicorp_installation_method == "package" and hashicorp_version != "latest"
  when: hashicorp_installation_method == "package"

- name: Task 3 - Install manually
  block:
    - name: Task 3.1 - Download and unpack hashicorp product manually
      ansible.builtin.unarchive:
        src: https://releases.hashicorp.com/vagrant/{{ hashicorp_version }}/vagrant_{{ hashicorp_version }}_x86_64.zip
        dest: /usr/bin
        remote_src: true
  when: hashicorp_installation_method == "manual"


