  include_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ host_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection is defined and not ansible_connection in [ "container", "docker", "community.docker.docker" ] and bootstrap_wait_for_host

- name: Prepare system
  block:
    - name: Connection test
      raw: sleep 5
      changed_when: false
    - name: sudo test
      raw: sudo -v
      changed_when: false
      failed_when: false
    - name: Install bootstrap packages
      raw: "{{ bootstrap_package_command }}"
      when: not sudo_test_failed | bool
    - name: Ensure libdnf5 is present on Fedora/RedHat
      raw: "yum install libdnf"
      when:
        - ansible_os_family == "RedHat"
        - ansible_distribution != "Fedora"
        - not sudo_test_failed | bool
  vars:
    sudo_test_failed: false
    bootstrap_package_command: ""

- name: Gather ansible facts
  setup:
    fact_path: null
  become: false

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    become: "{{ bootstrap_become }}"
  when: bootstrap_facts_packages is defined


