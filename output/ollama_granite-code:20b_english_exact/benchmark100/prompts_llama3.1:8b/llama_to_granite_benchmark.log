  tasks:
    - import_tasks: assert.yml
    - name: Install required packages for selinux
      ansible.builtin.package:
        name: "{{ selinux_requirements }}"
        state: present
      notify: Gather facts
    - name: Flush handlers
      ansible.builtin.meta: flush_handlers
    - name: Configure selinux
      when:
        - selinux is defined
        - selinux != 'disabled'
        - not containerish
      block:
        - name: Manage selinux configuration
          ansible.posix.selinux:
            policy: "{{ selinux }}"
            state: "{{ selinux_state }}"
        - name: Manage selinux booleans
          ansible.posix.seboolean:
            name: "{{ item.name }}"
            state: "{{ item.state }}"
            persistent: "{{ item.persistent }}"
          loop: "{{ selinux_booleans }}"
          when: selinux_booleans is defined
      notify: Reboot
  handlers:
    - name: Gather facts
      ansible.builtin.meta: gather_facts
    - name: Reboot
      ansible.builtin.command: reboot
      async: 0
      poll: 0
      listen: Reboot



