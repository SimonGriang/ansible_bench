content='---\n- import_playbook: assert.yml\n  run_once: true\n  delegate_to: localhost\n\n- name: Install required packages for the service\n  package:\n    name: "{{ service_required_packages }}"\n    state: present\n\n- name: Configure systemd service for each item in the service_list\n  template:\n    src: systemd.j2\n    dest: /etc/systemd/system/{{ item.name }}.service\n    mode: "0644"\n  notify: Systemctl daemon-reload\n  when: ansible_service_mgr == "systemd"\n\n- name: Configure sysvinit service for each item in the service_list\n  template:\n    src: sysvinit.j2\n    dest: /etc/init.d/{{ item.name }}\n    mode: "0755"\n  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]\n\n- name: Manage each service in the service_list\n  service:\n    name: "{{ item.name }}"\n    state: "{{ item.state | default(omit) }}"\n    enabled: "{{ item.enabled | default(omit) }}"\n  with_items: "{{ service_list }}"\n\n- name: Flush handlers\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-23T23:53:11.140853956Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6630082060, 'load_duration': 43808509, 'prompt_eval_count': 2072, 'prompt_eval_duration': 585365983, 'eval_count': 270, 'eval_duration': 5999372873, 'model_name': 'granite-code:20b'} id='run--ec1f1746-7be7-4562-8ced-1184a3ee5b8e-0' usage_metadata={'input_tokens': 2072, 'output_tokens': 270, 'total_tokens': 2342}
