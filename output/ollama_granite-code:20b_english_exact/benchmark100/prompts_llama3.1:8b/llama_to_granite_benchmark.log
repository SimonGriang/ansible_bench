---
- name: Import necessary tasks for package manager assert
  import_tasks: assert.yml

- name: Configure package management for package manager apk
  apk:
    update_cache: yes
    upgrade: yes
    state: latest

- name: Configure package management for package manager apt
  apt:
    upgrade: dist
    update_cache: yes
    autoremove: yes

- name: Update all software for package manager dnf
  dnf:
    name: '*'
    state: latest
    exclude: kernel, kernel-headers, kernel-devel

- name: Update all software for package manager pacman
  pacman:
    update_cache: yes
    upgrade: yes

- name: Configure package management for package manager yum
  yum:
    name: '*'
    state: latest
    exclude: kernel, kernel-headers, kernel-devel
  when:
    - ansible_distribution == "CentOS"
    - ansible_distribution_version != "6"
  become: yes
  tags:
    - skip_ansible_lint

- name: Configure package management for package manager yum
  yum:
    name: '*'
    state: latest
    exclude: kernel, kernel-headers, kernel-devel
    enablerepo: dnf-plugins-core
  when:
    - ansible_distribution == "CentOS"
    - ansible_distribution_version == "6"
  become: yes
  tags:
    - skip_ansible_lint

- name: Ensure yum-utils is installed for non-6 yum versions
  yum:
    name: yum-utils
    state: present
  when:
    - ansible_distribution == "CentOS"
    - ansible_distribution_version != "6"
  become: yes
  tags:
    - skip_ansible_lint

- name: Update all software for package manager zypper
  zypper:
    name: '*'
    state: latest


