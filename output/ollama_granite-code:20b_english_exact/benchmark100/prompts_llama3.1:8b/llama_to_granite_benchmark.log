---
- name: Create Vault directories
  hosts: localhost
  tasks:
    - name: Create the Vault group
      group:
        name: "{{ vault_group }}"
        system: true

    - name: Create the Vault user
      user:
        name: "{{ vault_user }}"
        shell: "{{ vault_user_shell }}"
        group: "{{ vault_group }}"

    - name: Create the Vault download directory
      file:
        path: "{{ vault_download_path }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0755
        state: directory

    - name: Download the Vault binary
      unarchive:
        src: "{{ vault_download_url }}"
        dest: "{{ vault_download_path }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0755
        remote_src: true

    - name: Check if vault_path exists
      stat:
        path: "{{ vault_path }}"
      register: vault_path_stats

    - name: Create vault_path if it does not exist
      file:
        path: "{{ vault_path }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0755
        state: directory
      when: not vault_path_stats.stat.exists

    - name: Create directories in vault_path
      file:
        path: "{{ vault_path }}/{{ item }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0750
        state: directory
      with_items: "{{ vault_directories }}"

    - name: Create data directories
      file:
        path: "{{ item }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0700
        state: directory
      with_items: "{{ vault_data_directories }}"

    - name: Generate TLS key and certificate
      command: "openssl req -x509 -newkey rsa:4096 -keyout {{ vault_tls_path }}/server.key -out {{ vault_tls_path }}/server.crt -nodes -subj '/CN=localhost'"
      args:
        creates: "{{ vault_tls_path }}/server.crt"

    - name: Set ownership of TLS material
      file:
        path: "{{ item }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0640
      with_items: "{{ vault_tls_files }}"

    - name: Copy the Vault binary
      copy:
        src: "{{ vault_download_path }}/vault"
        dest: "{{ vault_bin_path }}/vault"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0755

    - name: Set cap_ipc_lock=ep on /usr/bin/vault
      capabilities:
        path: "{{ vault_bin_path }}/vault"
        capability: cap_ipc_lock=ep
        state: present

    - name: Touch vault.env
      file:
        path: "{{ vault_touch_file }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0644
        state: touch

    - name: Create /usr/lib/systemd/system
      file:
        path: /usr/lib/systemd/system
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0755
        state: directory

    - name: Copy the Vault service file
      copy:
        src: vault.service
        dest: /usr/lib/systemd/system/vault.service
        owner: root
        group: root
        mode: 0644

    - name: Copy the Vault configuration
      copy:
        src: vault.hcl
        dest: "{{ vault_config_path }}/vault.hcl"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0640

    - name: Flush handlers
      meta: flush_handlers


