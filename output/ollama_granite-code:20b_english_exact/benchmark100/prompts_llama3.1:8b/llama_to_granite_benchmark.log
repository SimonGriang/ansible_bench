---
- name: Check existence of Java certificates
  stat:
    path: "{{ java_cert_path }}"
  loop: "{{ java_certs }}"
  loop_control:
    loop_var: java_cert_path
  register: check_java_certs

- name: Fail if Java certificates do not exist
  fail:
    msg: "Java certificate {{ java_cert_path }} does not exist"
  loop: "{{ check_java_certs.results }}"
  loop_control:
    loop_var: check_java_cert
  when: not check_java_cert.stat.exists

- name: Set Java keystore directory for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: java_version.stdout | int < 11

- name: Set Java keystore directory for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: java_version.stdout | int >= 11

- name: Import SSL certificates into Java keystore
  java_cert:
    path: "{{ java_cert_path }}"
   Cert_path: "{{ java_open_jdk_home }}/jre/lib/security/cacerts"
    keystore_path: "{{ java_keystore_dir }}/cacerts"
    keystore_pass: "{{ java_cert_keystore_pass }}"
    state: present
  loop: "{{ java_certs }}"
  loop_control:
    loop_var: java_cert_path


