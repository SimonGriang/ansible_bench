---
- name: "RKE2 preparation"
  tasks:
    - name: "Create /etc/rancher/rke2 directory"
      file:
        path: /etc/rancher/rke2
        owner: root
        group: root
        mode: 0755
        state: directory
    - name: "Set server taints"
      command: >
        rke2 server --taints "{{ rke2_server_node_taints }}"
      when: rke2_agent_type == "server"
    - name: "Copy RKE2 config"
      template:
        src: "{{ rke2_config }}"
        dest: /etc/rancher/rke2/config.yaml
        owner: root
        group: root
        mode: 0600
      notify: "Config file changed"
    - name: "Copy kubelet config"
      template:
        src: "templates/kubelet-config.yaml.j2"
        dest: /etc/rancher/rke2/kubelet-config.yaml
        owner: root
        group: root
        mode: 0600
      notify: "Config file changed"
      when: rke2_kubelet_config | length > 0
    - name: "Copy Containerd Registry Configuration file"
      copy:
        src: "{{ rke2_custom_registry_path }}"
        dest: /etc/rancher/rke2/registries.yaml
        owner: root
        group: root
        mode: 0600
      notify: "Config file changed"
      when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
    - name: "Register etcd restore from file"
      set_fact:
        do_etcd_restore: true
      when: rke2_etcd_snapshot_file | length > 0 and rke2_etcd_local | bool and rke2_server_type == "server" and rke2_service_enabled | bool
    - name: "Register etcd restore from s3"
      set_fact:
        do_etcd_restore_from_s3: true
      when: rke2_etcd_snapshot_file | length > 0 and rke2_etcd_local | bool and rke2_etcd_snapshot_s3_options.access_key | length > 0 and rke2_etcd_snapshot_s3_options.secret_key | length > 0 and rke2_etcd_snapshot_s3_options.bucket | length > 0 and rke2_etcd_snapshot_s3_options.snapshot_name | length > 0
    - name: "Restore etcd from file"
      block:
        - name: "Create RKE2 etcd snapshot directory"
          file:
            path: "{{ rke2_data_dir }}/rke2/server/db/snapshots"
            owner: root
            group: root
            mode: 0755
            state: directory
        - name: "Copy etcd snapshot file"
          copy:
            src: "{{ rke2_etcd_snapshot_file }}"
            dest: "{{ rke2_data_dir }}/rke2/server/db/snapshots/{{ rke2_etcd_snapshot_file | basename }}"
            owner: root
            group: root
            mode: 0600
        - name: "Restore etcd from snapshot file"
          command: >
            rke2 server --restore --config {{ rke2_data_dir }}/rke2/server/db/snapshots/current/config.yaml
          args:
            creates: "{{ rke2_data_dir }}/rke2/server/db/snapshots/current/member/snap"
      when: do_etcd_restore | bool
    - name: "Restore etcd from s3"
      command: >
        rke2 server --s3-snapshot --config {{ rke2_data_dir }}/rke2/server/db/snapshots/current/config.yaml
      when: do_etcd_restore_from_s3 | bool
    - name: "Start RKE2 service on first server"
      block:
        - name: "Wait for first server"
          uri:
            url: "{{ rke2_url_scheme }}://{{ ansible_host }}:{{ rke2_api_port }}/ping"
            method: GET
            status_code: 200
            return_content: yes
            body_format: json
            body:
              ping: ping
          register: rke2_ping
          until: rke2_ping.json.ping == "pong"
          retries: 30
          delay: 10
        - name: "Start rke2-server.service"
          service:
            name: rke2-server
            state: started
            env:
              RKE2_TOKEN: "{{ rke2_token }}"
      when: rke2_server_type == "server" and inventory_hostname == groups[rke2_server_group_name][0]
    - name: "Mask RKE2 agent service on first server"
      service:
        name: rke2-agent
        enabled: no
      when: rke2_server_type == "server" and inventory_hostname == groups[rke2_server_group_name][0]
    - name: "Wait for first server be ready - no CNI"
      uri:
        url: "{{ rke2_url_scheme }}://{{ ansible_host }}:{{ rke2_api_port }}/nodes/{{ ansible_host }}"
        method: GET
        status_code: 200
        return_content: yes
        body_format: json
        body:
          address: "{{ ansible_host }}"
      register: rke2_node
      until: rke2_node.json.status.nodeInfo.conditions[0].type == "Ready" and rke2_node.json.status.nodeInfo.plugins == []
      retries: 60
      delay: 10
      when: rke2_server_type == "server" and inventory_hostname == groups[rke2_server_group_name][0] and not rke2_cni | bool
    - name: "Wait for first server be ready - with CNI"
      uri:
        url: "{{ rke2_url_scheme }}://{{ ansible_host }}:{{ rke2_api_port }}/nodes/{{ ansible_host }}"
        method: GET
        status_code: 200
        return_content: yes
        body_format: json
        body:
          address: "{{ ansible_host }}"
      register: rke2_node
      until: rke2_node.json.status.nodeInfo.conditions[0].type == "Ready"
      retries: 60
      delay: 10
      when: rke2_server_type == "server" and inventory_hostname == groups[rke2_server_group_name][0] and rke2_cni | bool
    - name: "Restore etcd"
      block:
        - name: "Remove old secrets"
          shell: |
            kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get secrets -A | grep -v 'default\|kube-public\|kube-system' | awk '{print $1 "/" $2}' | xargs kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete secret -A
          args:
            executable: /bin/bash
        - name: "Remove old nodes"
          shell: |
            kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o json | jq -r '.items[].metadata.name' | grep -v '{{ ansible_host }}' | xargs kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete node -f
          args:
            executable: /bin/bash
        - name: "Create new nodes"
          shell: |
            kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o json | jq -r '.items[].metadata.name' | grep -v '{{ ansible_host }}' | xargs kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete node -f
          args:
            executable: /bin/bash
      when: rke2_etcd_local | bool
    - name: "Set an Active Server variable"
      set_fact:
        active_server: "{{ inventory_hostname }}"
      delegate_to: "{{ item }}"
      delegate_facts: true
      loop: "{{ groups[rke2_server_group_name] }}"


