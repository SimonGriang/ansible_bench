---
- name: Task 1
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2
  package:
    name: mysql
    state: present

- name: Task 3
  template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: "{{ mysql_config_file }}"
    mode: 0644
    owner: root
    group: root
  notify: restart mysql
  with_dict: "{{ mysql_configuration_options }}"

- name: Task 4
  template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: "{{ mysql_config_file }}"
    mode: 0644
    owner: root
    group: root
  notify: restart mysql

- name: Task 5
  command: "{{ mysql_initialize_command }}"
  when: ansible_os_family == "alpine" or ansible_os_family == "archlinux"

- name: Task 6
  service:
    name: mysql
    state: started
    enabled: yes

- name: Task 7
  meta: flush_handlers

- name: Task 8
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0644
    owner: root
    group: root

- name: Task 9
  mysql_db:
    name: "{{ item.name }}"
    state: present
  with_items: "{{ mysql_databases }}"

- name: Task 10
  mysql_info:

- name: Task 11
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
  with_items: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Task 12
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items: "{{ mysql_users }}"

- name: Task 13
  meta: flush_handlers


