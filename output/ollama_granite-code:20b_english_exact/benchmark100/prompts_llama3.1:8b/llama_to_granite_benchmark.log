---
- name: promtail
  tasks:
    - name: Install unzip package and update cache if necessary
      apt:
        name: unzip
        update_cache: "{{ promtail_apt_update_cache }}"
        state: present

    - name: Create promtail system group if necessary
      group:
        name: "{{ promtail_system_group }}"
        state: present
      when: promtail_system_group != "root"

    - name: Create the promtail system user
      user:
        name: "{{ promtail_system_user }}"
        group: "{{ promtail_system_group }}"
        groups: "{{ promtail_user_additional_groups }}"
        state: present
      when: promtail_system_user != "root"

    - name: Ensure the /usr/local/bin directory exists
      file:
        path: /usr/local/bin
        state: directory
        mode: 0755

    - name: Create necessary config directories
      file:
        path: "{{ item }}"
        state: directory
        owner: "{{ promtail_system_user }}"
        group: "{{ promtail_system_group }}"
        mode: 0750
      loop:
        - "{{ promtail_config_dir }}"
        - "{{ promtail_positions_dir }}"

    - name: Create application directories
      file:
        path: "{{ promtail_install_dir }}/{{ item }}"
        state: directory
        owner: "{{ promtail_system_user }}"
        group: "{{ promtail_system_group }}"
        mode: 0750
      loop:
        - bin
        - "{{ promtail_version }}"

    - name: Check the existence of the promtail binary
      stat:
        path: "{{ promtail_install_dir }}/bin/promtail"
      register: promtail_bin

    - name: Download promtail binaries if necessary
      get_url:
        url: "{{ promtail_download_url }}"
        dest: "{{ promtail_temp_dir }}/{{ promtail_download_filename }}"
        mode: 0640
      when: not promtail_bin.stat.exists or promtail_bin_propagate

    - name: Propagate locally distributed promtail archive if necessary
      copy:
        src: "{{ promtail_local_download_url }}"
        dest: "{{ promtail_temp_dir }}/{{ promtail_download_filename }}"
        mode: 0640
      when: promtail_local_download_url is defined and not promtail_bin.stat.exists or promtail_bin_propagate

    - name: Download promtail binaries to controller node if necessary
      copy:
        src: "{{ promtail_temp_dir }}/{{ promtail_download_filename }}"
        dest: "{{ promtail_install_dir }}/{{ promtail_version }}/{{ promtail_download_filename }}"
        mode: 0640
      when: promtail_binary_propagate

    - name: Propagate promtail binaries
      unarchive:
        src: "{{ promtail_install_dir }}/{{ promtail_version }}/{{ promtail_download_filename }}"
        dest: "{{ promtail_install_dir }}/{{ promtail_version }}/"
        mode: 0750
      when: promtail_binary_propagate

    - name: Unpack promtail binaries
      unarchive:
        src: "{{ promtail_install_dir }}/{{ promtail_version }}/{{ promtail_download_filename }}"
        dest: "{{ promtail_install_dir }}/bin/"
        remote_src: true
        mode: 0750

    - name: Create a symlink to the latest version
      file:
        src: "{{ promtail_install_dir }}/bin/promtail"
        dest: "{{ promtail_install_dir }}/bin/latest"
        state: link

    - name: Write the promtail configuration
      copy:
        content: "{{ promtail_config }}"
        dest: "{{ promtail_config_dir }}/{{ promtail_config_filename }}"
        owner: "{{ promtail_system_user }}"
        group: "{{ promtail_system_group }}"
        mode: 0640

    - name: Create the systemd service unit
      copy:
        content: |
          [Unit]
          Description=Prometheus log agent
          After=network.target
          StartLimitIntervalSec=0
          [Service]
          Type=simple
          User={{ promtail_system_user }}
          Group={{ promtail_system_group }}
          Environment="PROMTAIL_CONFIG={{ promtail_config_dir }}/{{ promtail_config_filename }}"
          ExecStart={{ promtail_install_dir }}/bin/promtail --config.file=$PROMTAIL_CONFIG
          [Install]
          WantedBy=multi-user.target
        dest: /etc/systemd/system/promtail.service
        owner: root
        group: root
        mode: 0644


