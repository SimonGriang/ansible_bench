    - '@'
  when: vault_hardening_disable_core_dumps

- name: Hardening | Disable Shell Command History
  copy:
    src: vault.sh
    dest: /etc/profile.d/vault.sh
    mode: '0644'
  when: vault_hardening_disable_shell_command_history

- name: Hardening | Configure SELinux / AppArmor
  block:
    - name: Install selinux-policy package
      ansible.builtin.package:
        name: selinux-policy
        state: present

    - name: Set SELinux policy to targeted and state to enforcing
      ansible.posix.selinux:
        policy: targeted
        state: enforcing

    - name: Enforce AppArmor
      command: aa-enforce
      changed_when: false
  when: vault_hardening_configure_selinux_apparmor


