- name: Set up GRUB password
  block:
    - name: Get the path to the efi variables directory
      ansible.builtin.stat:
        path: /sys/firmware/efi/efivars/
      register: grub_efi

    - name: Remove grub.cfg on EFI systems
      ansible.builtin.file:
        path: /boot/grub2/grub.cfg
        state: absent
      when: grub_efi.stat.exists

    - name: Install a user template for grub
      ansible.builtin.template:
        src: 01_users.j2
        dest: /etc/grub.d/01_users
        owner: root
        group: root
        mode: "0755"
      notify: Update grub

    - name: Add password to grub configuration on EFI systems
      ansible.builtin.lineinfile:
        path: /etc/grub2-efi.cfg
        line: password --unrestricted
        insertafter: EOF
      notify: Update grub
      when: grub_efi.stat.exists

    - name: Add password to grub configuration on MBR systems
      ansible.builtin.lineinfile:
        path: /etc/grub2.cfg
        line: password --unrestricted
        insertafter: EOF
      notify: Update grub
      when: grub_efi.stat.exists

    - name: Modify grub configuration to allow unrestricted access
      ansible.builtin.replace:
        path: "{{ item }}"
        regexp: '^password'
        replace: 'password --unrestricted'
      loop: "{{ grub_password_unrestricted_files }}"
      when: grub_password_unrestricted
      notify: Update grub
  vars:
    grub_password_unrestricted: true
    grub_password_unrestricted_files:
      - /etc/grub2-efi.cfg
      - /etc/grub2.cfg
  handlers:
    - name: Update grub
      ansible.builtin.command: grub2-mkconfig -o /boot/grub2/grub.cfg


