ation': 9494140196, 'model_name': 'granite-code:20b'} id='run--7af2f0a3-43b7-467d-8025-1bd356c81d21-0' usage_metadata={'input_tokens': 1272, 'output_tokens': 457, 'total_tokens': 1729}
