---

- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  ansible.posix.selinux:
    state: "{{ httpd_selinux_state }}"
    policy: "{{ httpd_selinux_policy }}"
    setype: "{{ httpd_setype }}"
    seuser: "{{ httpd_seuser }}"
  when: selinux_enabled_status | bool

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    owner: root
    group: root
    mode: 0644
  notify: restart httpd

- name: Activate httpd modules
  ansible.builtin.command: a2enmod {{ httpd_modules_to_activate_with_command }}
  when: ansible_os_family == 'Debian'

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  ansible.builtin.template:
    src: "{{ httpd_ports_conf.j2 }}"
    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
    owner: root
    group: root
    mode: 0644
  when: ansible_os_family == 'Debian' or ansible_os_family == 'Suse'
  notify: restart httpd

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Remove default index.html
  ansible.builtin.file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


