---
- import_tasks: assert.yml
- name: Install requirements for sysctl
  package:
    name: "{{ sysctl_requirements }}"
    state: present
  when: sysctl_requirements is defined
- name: Set sysctl settings
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
