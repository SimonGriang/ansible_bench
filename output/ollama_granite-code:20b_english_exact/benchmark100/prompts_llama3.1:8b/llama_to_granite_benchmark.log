---
- name: Apache ssl configuration
  hosts: all
  tasks:
    - name: Install Apache ssl packages
      yum:
        name: "{{ httpd_ssl_packages }}"
        state: present
    - name: Place ssl configuration file
      template:
        src: ssl.conf.j2
        dest: "{{ httpd_config_directory }}/ssl.conf"
        mode: "0644"
      notify: restart httpd
    - name: Configure default vhost to redirect from http to https
      template:
        src: default-ssl.conf.j2
        dest: "{{ httpd_config_directory }}/default-ssl.conf"
        mode: "0644"
      notify: restart httpd
  handlers:
    - name: restart httpd
      service:
        name: httpd
        state: restarted
