---
- import_tasks: assert.yml
  run_once: true
- name: Install python pip packages
  pip:
    name: "{{ python_pip_packages }}"
- name: Configure pip proxy settings
  when: python_pip_proxy is defined
  block:
    - copy:
        dest: /etc/pip.conf
        content: |
          [global]
          proxy = {{ python_pip_proxy }}
- name: Configure pip trusted host settings
  when: python_pip_trusted_host is defined
  block:
    - copy:
        dest: /etc/pip.conf
        content: |
          [global]
          trusted-host = {{ python_pip_trusted_host }}
- name: Update pip to the specified version
  when: python_pip_update is defined and ansible_distribution_release not in ["bookworm", "noble"] and ansible_os_family != "Alpine"
  pip:
    name: "{{ python_pip_pip_package }}"
    state: latest
- name: Install requested Python modules
  when: ansible_distribution_release not in ["bookworm", "noble"] and ansible_os_family != "Alpine"
  pip:
    name: "{{ python_pip_modules }}"


