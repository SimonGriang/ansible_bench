---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install the dns packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop:
    - bind
    - bind-utils

- name: Create the required directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: named
    group: named
    mode: "0755"
  loop:
    - /etc/named
    - /var/lib/named

- name: Create the required group
  ansible.builtin.group:
    name: named
    state: present

- name: Create the required user
  ansible.builtin.user:
    name: named
    group: named
    home: /var/lib/named
    shell: /sbin/nologin
    createhome: false
    system: true

- name: Generate the rndc key
  ansible.builtin.shell: rndc-confgen -a -c /etc/named/rndc.conf
  args:
    creates: /etc/named/rndc.key

- name: Set permissions on the rndc key file
  ansible.builtin.file:
    path: /etc/named/rndc.key
    owner: named
    group: named
    mode: "0644"

- name: Download the named.root file
  ansible.builtin.get_url:
    url: "{{ bind_root_hint }}"
    dest: /etc/named/named.root
    mode: "0644"
    owner: named
    group: named

- name: Create the zone file
  ansible.builtin.template:
    src: zone.j2
    dest: /etc/named/zones.config
    owner: named
    group: named
    mode: "0644"

- name: Add zones to the configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: /etc/named.conf
    owner: root
    group: root
    mode: "0644"
  notify: restart named

- name: Place the systemd override
  ansible.builtin.template:
    src: named.service.j2
    dest: /etc/systemd/system/named.service
    owner: root
    group: root
    mode: "0644"
  notify: reload daemon

- name: Start and enable the DNS service
  ansible.builtin.service:
    name: named
    state: started
    enabled: true


