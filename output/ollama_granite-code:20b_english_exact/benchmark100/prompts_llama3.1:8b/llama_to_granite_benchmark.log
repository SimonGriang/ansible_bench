---

- name: "Import assert.yml"
  import_tasks: assert.yml
  run_once: true

- name: "Install httpd"
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: "Configure selinux"
  selinux:
    state: "{{ 'disabled' if httpd_selinux_state == 'disabled' else 'permissive' }}"
  when:
    - httpd_selinux_state | default('disabled') != 'disabled'
    - ansible_selinux.status == 'enabled'

- name: "Configure httpd"
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
    owner: root
    group: root

- name: "Activate httpd modules"
  command: "a2enmod {{ httpd_modules_to_activate_with_command }}"
  register: "apache_httpd_modules_activated"
  changed_when: "'To activate the new modules' in apache_httpd_modules_activated.stdout"
  when:
    - ansible_os_family == 'Debian'

- name: "Import ssl.yml"
  import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: "Import locations.yml"
  import_tasks: locations.yml
  when:
    - httpd_locations is defined

- name: "Import vhosts.yml"
  import_tasks: vhosts.yml
  when:
    - httpd_vhosts is defined

- name: "Configure ports"
  template:
    src: "{{ httpd_ports_conf.j2 }}"
    dest: "{{ httpd_server_root ~ '/' ~ httpd_ports_conf }}"
    mode: 0644
    owner: root
    group: root
  when:
    - ansible_os_family == 'Debian' or ansible_os_family == 'Suse'

- name: "Import directories.yml"
  import_tasks: directories.yml
  when:
    - httpd_directories is defined

- name: "Remove default index.html"
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when:
    - httpd_remove_example | bool

- name: "Start and enable httpd"
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


