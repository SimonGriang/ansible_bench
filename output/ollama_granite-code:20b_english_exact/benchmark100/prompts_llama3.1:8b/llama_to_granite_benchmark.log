---
- name: Cadvisor Installation
  hosts: all
  tasks:
    - name: Create the /opt/cadvisor directory
      file:
        path: /opt/cadvisor
        state: directory
        mode: '0755'

    - name: Download the cadvisor binary
      get_url:
        url: https://github.com/google/cadvisor/releases/download/v0.44.0/cadvisor
        dest: /opt/cadvisor/cadvisor
        mode: '0755'
        checksum: sha256:c30095f40043d634f161432655905996e654a9c66921e46028b3485171e05135
      register: download_binary
      until: download_binary is successful
      retries: 5
      delay: 10
      when: download_binary.stat.exists == False

    - name: Copy the locally distributed cadvisor binary
      copy:
        src: /path/to/local/cadvisor
        dest: /opt/cadvisor/cadvisor
        mode: '0755'
      when: download_binary.stat.exists == False

    - name: Create a symlink to the cadvisor binary
      file:
        src: /opt/cadvisor/cadvisor
        dest: /usr/local/bin/cadvisor
        state: link

    - name: Configure the cadvisor systemd service
      template:
        src: templates/cadvisor.service.j2
        dest: /etc/systemd/system/cadvisor.service
      when: download_binary.stat.exists == False

    - name: Test if the cadvisor service is active
      command: systemctl is-active cadvisor
      register: service_active

    - name: Enable the cadvisor systemd service
      systemd:
        name: cadvisor
        enabled: yes

    - name: Start the cadvisor systemd service
      systemd:
        name: cadvisor
        state: started
        daemon_reload: yes


