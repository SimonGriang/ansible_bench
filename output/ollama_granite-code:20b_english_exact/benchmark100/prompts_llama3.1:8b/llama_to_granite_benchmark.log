---
- name: Perform maintenance on RKE2 node
  hosts: rke2_node
  vars:
    rke2_data_path: /var/lib/rke2
    rke2_node_name: "example-node"
    rke2_drain_additional_args: "--force --ignore-daemonsets"
    rke2_service_name: rke2-server
    rke2_cluster_group_name: mycluster
    rke2_wait_for_all_pods_to_be_healthy_args: "--timeout 360"
  tasks:
    - name: Cordon and drain the node
      command: "{{ rke2_data_path }}/bin/kubectl cordon {{ rke2_node_name }} && {{ rke2_data_path }}/bin/kubectl drain {{ rke2_node_name }} {{ rke2_drain_additional_args }}"
      retries: 100
      delay: 15
      register: drain_output
      until: drain_output.stderr == ""

    - name: Restart RKE2 service
      service:
        name: "{{ rke2_service_name }}"
        state: restarted

    - name: Wait for all nodes to be ready again
      command: "{{ rke2_data_path }}/bin/kubectl wait --for=condition=Ready node --all --timeout=5m"
      retries: 100
      delay: 15
      register: ready_output
      until: ready_output.stderr == ""

    - name: Uncordon the node
      command: "{{ rke2_data_path }}/bin/kubectl uncordon {{ rke2_node_name }}"

    - name: Wait for all pods to be ready again
      command: "{{ rke2_data_path }}/bin/kubectl wait --for=condition=Ready pod --all --timeout=5m"
      retries: 100
      delay: 15
      register: pod_ready_output
      until: pod_ready_output.stderr == ""

    - name: Wait for all pods to pass readiness checks
      command: "{{ rke2_data_path }}/bin/kubectl wait --for=condition=Ready pod --all {{ rke2_wait_for_all_pods_to_be_healthy_args }}"
      retries: 100
      delay: 15
      register: pod_health_output
      until: pod_health_output.stderr == ""


