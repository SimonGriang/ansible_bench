---
- import_tasks: assert.yml
- name: Install cron package
  package:
    name: "{{ cron_packages }}"
    state: present
  tags:
    - cron
- name: Configure shell settings for cron jobs
  lineinfile:
    path: /etc/cron.conf
    line: "SHELL={{ cron_shell }}"
  tags:
    - cron
- name: Configure system path for cron jobs
  lineinfile:
    path: /etc/cron.conf
    line: "PATH={{ cron_path }}"
  tags:
    - cron
- name: Configure mail-to setting for cron jobs
  lineinfile:
    path: /etc/cron.conf
    line: "MAILTO={{ cron_mailto }}"
  tags:
    - cron
- name: Start and enable cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  tags:
    - cron
- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    state: present
  loop: "{{ cron_jobs }}"
  tags:
    - cron


