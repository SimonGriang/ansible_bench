---

- name: Task 1
  include_tasks: assert.yml

- name: Task 2
  package:
    name: "{{ mysql_package }}"
    state: present
  notify:
   - mysql root password changed
   - systemctl daemon-reexec

- name: Task 3
  ini_file:
    path: "{{ mysql_configuration_destination }}/server.cnf"
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: "{{ mysql_configuration_mode }}"
    no_extra_spaces: "{{ mysql_configuration_no_extra_spaces }}"
    backup: "{{ mysql_configuration_backup }}"
  loop: "{{ mysql_configuration_options }}"
  loop_control:
    label: "Configure MySQL server: {{ item.section }}.{{ item.option }}"
  notify: restart mysql

- name: Task 4
  ini_file:
    path: "{{ mysql_configuration_destination }}/client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    mode: "{{ mysql_configuration_mode }}"
    no_extra_spaces: "{{ mysql_configuration_no_extra_spaces }}"
    backup: "{{ mysql_configuration_backup }}"

- name: Task 5
  shell: "{{ mysql_initialize_command }}"
  args:
    creates: "{{ mysql_UNIX_socket }}"
  when: mysql_platform == "Linux"

- name: Task 6
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Task 7
  meta: flush_handlers

- name: Task 8
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0600

- name: Task 9
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  loop_control:
    label: "Create database {{ item.name }}"
  no_log: yes

- name: Task 10
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    host: "{{ item.host }}"
    state: present
  loop: "{{ mysql_users }}"
  loop_control:
    label: "Create user {{ item.name }}@{{ item.host }}"
  no_log: yes

- name: Task 11
  meta: flush_handlers


