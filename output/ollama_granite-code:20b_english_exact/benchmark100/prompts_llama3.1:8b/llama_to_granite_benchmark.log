---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Wait for port 22 to become available
  wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  when:
    - inventory_hostname != 'localhost'
    - bootstrap_wait_for_host
    - connection != 'container'
    - connection != 'docker'
    - connection != 'community.docker.docker'

- block:
    - name: Gather bootstrap facts
      setup:
      register: bootstrap_connect

    - name: Include gather_facts.yml
      include_tasks: gather_facts.yml
      when: not bootstrap_connect.unreachable

  when: connection != 'local'

- block:
    - name: Check if sudo is available
      raw: test -e /usr/bin/sudo
      changed_when: false
      failed_when: false
      register: sudo_availability

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        update_cache: true
      become: "{{ bootstrap_become }}"
      when: sudo_availability.rc != 0
  when: connection != 'local'

- name: Gather Ansible facts about the system
  setup:
  register: system_facts

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: true
  become: "{{ bootstrap_become }}"
  when: connection == 'local'


