---
- name: Task 1 - Set package state based on Ansible installation
  hosts: all
  tasks:
    - name: Set package state for Ansible
      package:
        name: ansible
        state: "{{ 'present' if ansible_installation_method == 'package' else 'absent' }}"

- name: Task 2 - Set up Ansible on RedHat
  hosts: redhat
  tasks:
    - name: Install package dependencies for Ansible
      package:
        name: "{{ item }}"
        state: present
      with_items:
        - python-setuptools
    - name: Install Ansible
      package:
        name: ansible
        state: present

- name: Task 3 - Set up Ansible on Fedora
  hosts: fedora
  tasks:
    - name: Install package dependencies for Ansible
      package:
        name: "{{ item }}"
        state: present
      with_items:
        - python-setuptools
    - name: Install Ansible
      package:
        name: ansible
        state: present

- name: Task 4 - Set up Ansible on Ubuntu
  hosts: ubuntu
  tasks:
    - name: Install package dependencies for Ansible
      apt:
        name: "{{ item }}"
        state: present
      with_items:
        - python-pip
        - python-setuptools
    - name: Install Ansible
      apt:
        name: ansible
        state: present

- name: Task 5 - Set up Ansible on Debian
  hosts: debian
  tasks:
    - name: Install package dependencies for Ansible
      apt:
        name: "{{ item }}"
        state: present
      with_items:
        - python-pip
        - python-setuptools
    - name: Install Ansible
      apt:
        name: ansible
        state: present

- name: Task 6 - Set up Ansible using Pip
  hosts: all
  tasks:
    - name: Install Python setuptools
      package:
        name: python-setuptools
        state: present
    - name: Install pip
      easy_install:
        name: pip
    - name: Install Ansible via pip
      pip:
        name: ansible
        state: present


