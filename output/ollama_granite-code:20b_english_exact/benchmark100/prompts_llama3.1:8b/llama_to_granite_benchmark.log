---
- name: Load OS-specific variables
  include_vars: "{{ item }}"
  with_first_found:
    - files:
      - "{{ ansible_os_family }}.yml"
      - "default.yml"
      paths:
      - ../vars

- name: Include setup tasks for RedHat-based systems
  include_tasks: RedHat.yml
  when: ansible_os_family == "RedHat"

- name: Include setup tasks for Debian-based systems
  include_tasks: Debian.yml
  when: ansible_os_family == "Debian"

- name: Install Docker packages on systems with Ansible version less than 2.12 or non-RedHat/Debian systems
  package:
    name: docker
    state: present
  when: not (ansible_version.full | version_compare('2.12', '>=') and (ansible_os_family == "RedHat" or ansible_os_family == "Debian"))

- name: Install Docker packages (with downgrade option) on systems with Ansible version 2.12 or higher and RedHat/Debian systems
  package:
    name: docker
    state: present
    allow_downgrade: yes
  when: ansible_version.full | version_compare('2.12', '>=') and (ansible_os_family == "RedHat" or ansible_os_family == "Debian")

- name: Install the docker-compose plugin on systems where the plugin is enabled and the system meets the criteria for task 4 or 5
  shell: docker plugin install docker-compose
  when: docker_enable_compose and (not (ansible_version.full | version_compare('2.12', '>=') and (ansible_os_family == "RedHat" or ansible_os_family == "Debian")) or (ansible_version.full | version_compare('2.12', '>=') and (ansible_os_family == "RedHat" or ansible_os_family == "Debian")))

- name: Install the docker-compose-plugin (with downgrade option) on systems where the plugin is enabled and the system meets the criteria for task 5
  shell: docker plugin install --alias docker-compose docker-compose
  when: docker_enable_compose and ansible_version.full | version_compare('2.12', '>=') and (ansible_os_family == "RedHat" or ansible_os_family == "Debian")

- name: Ensure the /etc/docker/ directory exists and has the correct permissions
  file:
    path: /etc/docker/
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Configure the Docker daemon options by copying the options to the daemon.json file
  template:
    src: daemon.json.j2
    dest: /etc/docker/daemon.json
    owner: root
    group: root
    mode: 0644
  notify: restart docker

- name: Ensure Docker is started and enabled at boot, if configured to do so
  service:
    name: docker
    state: started
    enabled: yes
  when: docker_service_enabled and docker_service_started

- name: Notify handlers to ensure firewall rules are updated
  meta: flush_handlers

- name: Include tasks for managing docker-compose, if enabled
  include: docker_compose.yml
  when: docker_enable_compose

- name: Get information about the docker group using getent
  command: getent group docker
  changed_when: false
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  set_fact:
    docker_users_to_add: "{{ docker_users_to_add | default([]) + [item] }}"
  with_items: "{{ query('command', 'getent passwd | cut -d: -f1') }}"
  when: item not in docker_group_info.stdout_lines

- name: Include tasks for managing docker users, if necessary
  include: docker_users.yml
  when: docker_users_to_add is defined and docker_users_to_add | length > 0


