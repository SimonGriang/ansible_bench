- name: Task 1
  tags: [debian, suse]
  become: true
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
  loop:
    - libapache2-mod-proxy
    - libapache2-mod-proxy-http
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"

- name: Task 2
  become: true
  ansible.builtin.template:
    src: location.conf.j2
    dest: "/etc/apache2/conf-available/{{ item.name }}.conf"
    mode: "0644"
  loop: "{{ httpd_locations }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  tags: [configuration]


