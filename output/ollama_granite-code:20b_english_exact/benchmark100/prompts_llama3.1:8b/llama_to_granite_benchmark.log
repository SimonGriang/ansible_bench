---

- name: Import and run assert.yml file
  hosts: localhost
  tasks:
  - import_playbook: assert.yml
  tags:
  - always

- name: Install required packages
  hosts: all
  tasks:
  - name: Install packages
    package:
      name: "{{ selinux_requirements }}"
      state: present
  - name: Trigger handler
    changed_when: true
    notify:
    - Gather facts
  handlers:
  - name: Gather facts
    setup:
  tags:
  - packages

- name: Maintain the system
  hosts: all
  tasks:
  - name: Flush handlers
    meta: flush_handlers
  tags:
  - maintain

- name: Configure selinux
  hosts: all
  tasks:
  - name: Manage selinux
    selinux:
      state: "{{ selinux_state }}"
      policy: "{{ selinux_policy }}"
    notify: Reboot
  - name: Manage selinux booleans
    selinux_boolean:
      name: "{{ item.name }}"
      state: "{{ item.state }}"
      persistent: "{{ item.persistent }}"
