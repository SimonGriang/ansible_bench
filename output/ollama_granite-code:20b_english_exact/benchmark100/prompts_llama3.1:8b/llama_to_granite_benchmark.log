p', 'total_duration': 12251036123, 'load_duration': 33832787, 'prompt_eval_count': 1744, 'prompt_eval_duration': 14049581, 'eval_count': 549, 'eval_duration': 12202080417, 'model_name': 'granite-code:20b'} id='run--4caccd64-6fd0-4d92-85df-8f1c5c5e3638-0' usage_metadata={'input_tokens': 1744, 'output_tokens': 549, 'total_tokens': 2293}
