---
- name: Postfix configuration
  hosts: all
  tasks:
    - name: Import assert.yml
      import_tasks: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Pre-configure Debian systems for postfix installation
      debconf:
        name: postfix
        question: postfix/main_mailer_type
        value: "No configuration"
        vtype: string
      when: ansible_os_family == "Debian"

    - name: Install postfix package
      package:
        name: postfix
        state: present

    - name: Install postfix-mysql package if specific conditions are met
      package:
        name: postfix-mysql
        state: present
      when: postfix_virtual_mailbox_maps ismatch "mysql" or postfix_virtual_mailbox_domains ismatch "mysql" or postfix_virtual_alias_maps ismatch "mysql"

    - name: Configure postfix transport maps
      template:
        src: postfix/transport
        dest: /etc/postfix/transport
        mode: 0644
      notify:
        - validate postfix configuration
        - rebuild transport maps database
        - restart postfix

    - name: Configure postfix header checks
      template:
        src: postfix/header_checks
        dest: /etc/postfix/header_checks
        mode: 0644
      notify:
        - validate postfix configuration
        - reload postfix

    - name: Set values for the main.cf file
      set_fact:
        postfix_main_cf:
          - "recipient_access = {{ postfix_recipient_access }}"
          - "sender_access = {{ postfix_sender_access }}"
          - "mynetworks = {{ postfix_mynetworks }}"
          - "mydestination = {{ postfix_mydestination }}"
          - "relay_domains = {{ postfix_relay_domains }}"
          - "smtpd_recipient_restrictions = {{ postfix_smtpd_recipient_restrictions }}"
          - "smtpd_sender_restrictions = {{ postfix_smtpd_sender_restrictions }}"
          - "virtual_mailbox_domains = {{ postfix_virtual_mailbox_domains }}"
          - "virtual_alias_domains = {{ postfix_virtual_alias_domains }}"

    - name: Configure postfix main.cf
      template:
        src: postfix/main.cf
        dest: /etc/postfix/main.cf
        mode: 0644
      notify:
        - validate postfix configuration
        - restart postfix

    - name: Configure postfix master.cf
      template:
        src: postfix/master.cf
        dest: /etc/postfix/master.cf
        mode: 0644
      notify:
        - validate postfix configuration
        - restart postfix

    - name: Create directory for TLS certificates and keys
      file:
        path: "{{ item }}"
        state: directory
        mode: 0755
      loop:
        - /etc/postfix/tls
        - /etc/postfix/tls/ca
        - /etc/postfix/tls/cert
        - /etc/postfix/tls/key

    - name: Deploy Postfix TLS server certificate
      copy:
        src: "{{ postfix_smtpd_tls_cert_file }}"
        dest: /etc/postfix/tls/cert/server.crt
        mode: 0644
      notify: reload postfix

    - name: Deploy Postfix TLS server key
      copy:
        src: "{{ postfix_smtpd_tls_key_file }}"
        dest: /etc/postfix/tls/key/server.key
        mode: 0644
      notify: reload postfix

    - name: Flush handlers
      meta: flush_handlers

    - name: Configure aliases
      copy:
        content: "{{ postfix_aliases }}"
        dest: /etc/postfix/aliases
        mode: 0644
      notify:
        - rebuild alias database
        - reload postfix

    - name: Configure sender_access
      copy:
        content: "{{ postfix_sender_access }}"
        dest: /etc/postfix/sender_access
        mode: 0644
      notify:
        - rebuild sender_access database
        - reload postfix

    - name: Configure recipient_access
      copy:
        content: "{{ postfix_recipient_access }}"
        dest: /etc/postfix/recipient_access
        mode: 0644
      notify:
        - validate postfix configuration
        - rebuild recipient_access database
        - reload postfix

    - name: Place sasl_password_map
      copy:
        content: "{{ postfix_smtp_sasl_password_map_content }}"
        dest: "{{ postfix_smtp_sasl_password_map }}"
        mode: 0644
      notify:
        - rebuild sasl_password_map database

    - name: Flush handlers again
      meta: flush_handlers

    - name: Start and enable postfix service
      service:
        name: postfix
        state: started
        enabled: true


