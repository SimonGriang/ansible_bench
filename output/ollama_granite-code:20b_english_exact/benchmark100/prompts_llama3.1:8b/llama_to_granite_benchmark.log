  ansible.builtin.shell: "kubectl get nodes -o jsonpath='{.items[*].metadata.name}'"
  register: node_names
  changed_when: false

- name: Remove old nodes from the cluster
  with_items: "{{ node_names.stdout_lines }}"
  when: item not in groups[rke2_cluster_group_name]
  ansible.builtin.shell: "kubectl delete node {{ item }}"
  changed_when: false


