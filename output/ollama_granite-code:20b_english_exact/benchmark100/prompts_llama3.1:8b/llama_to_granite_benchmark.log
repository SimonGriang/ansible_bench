---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Enable redis module stream (RHEL 8)
  when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"
  yum:
    name: redis
    state: present

- name: Task 3 - Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Task 4 - Configure redis
  template:
    src: redis.conf.j2
    dest: "{{ redis_conf_dir }}/redis.conf"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart redis

- name: Task 5 - Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


