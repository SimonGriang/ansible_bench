---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- package:
    name: mysql
    state: present

- template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: "{{ mysql_config_file }}"
    mode: 0644
    owner: root
    group: root
  notify: restart mysql
  with_dict: "{{ mysql_configuration_options }}"

- template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: "{{ mysql_config_file }}"
    mode: 0644
    owner: root
    group: root
  notify: restart mysql

- command: "{{ mysql_initialize_command }}"
  when: ansible_os_family == "alpine" or ansible_os_family == "archlinux"

- service:
    name: mysql
    state: started
    enabled: yes

- meta: flush_handlers

- template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0644
    owner: root
    group: root

- mysql_db:
    name: "{{ item.name }}"
    state: present
  with_items: "{{ mysql_databases }}"

- mysql_info:

- mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
  with_items: "{{ mysql_databases }}"
  when: item.initial_import is defined

- mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items: "{{ mysql_users }}"

- meta: flush_handlers


