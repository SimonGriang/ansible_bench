---
- name: Assert that systemd is being used as init system
  assert:
    that: ansible_service_mgr == "systemd"
    msg: "This playbook must be run on a host using systemd as the init system."

- name: Get the latest release of the Grafana Loki project from the GitHub API
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
  register: _latest_release
  until: _latest_release.status == 200
  retries: 5
  delay: 10

- name: Set the promtail version to the latest release tag
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
  when: promtail_version == "latest"

- name: Test if the zip local archive exists in the specified directory
  stat:
    path: "{{ promtail_local_dir }}/promtail-linux-{{ promtail_arch }}.zip"
  register: _local_zip

- name: Assert that the local binary exists in the specified directory
  assert:
    that: _local_zip.stat.exists
    msg: "Local archive promtail-linux-{{ promtail_arch }}.zip not found. Run promtail_download.yml first."
  when: _local_zip.stat.isdir is not defined

- name: Get the checksum list for the latest release
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
    body_format: json
  register: _latest_release
  until: _latest_release.status == 200
  retries: 5
  delay: 10

- name: Get the checksum for the specified architecture
  set_fact:
    __promtail_checksum: "{{ item.sha256 }}"
  when: item.name == "promtail-linux-{{ promtail_arch }}.zip"
  loop: "{{ _latest_release.json.assets }}"
  run_once: yes
  delegate_to: localhost
  connection: local
  no_log: yes
  when: _local_zip.stat.isdir is not defined




