---
- name: Create Vault directories
  hosts: all
  tasks:
    - name: Create the Vault group
      group:
        name: "{{ vault_group }}"
        system: true

    - name: Create the Vault user
      user:
        name: "{{ vault_user }}"
        shell: "{{ vault_user_shell }}"
        group: "{{ vault_group }}"

    - name: Create the Vault download directory
      file:
        path: "{{ vault_download_path }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0755
        state: directory

    - name: Download Vault binary
      unarchive:
        src: https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_amd64.zip
        dest: "{{ vault_download_path }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0755
        remote_src: true

    - name: Check if vault_path exists
      stat:
        path: "{{ vault_path }}"
      register: vault_path_stat

    - name: Create vault_path if it does not exist
      file:
        path: "{{ vault_path }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0755
        state: directory
      when: not vault_path_stat.stat.exists

    - name: Create directories in vault_path
      file:
        path: "{{ vault_path }}/{{ item }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0750
        state: directory
      with_items: "{{ vault_directories }}"

    - name: Create data directories
      file:
        path: "{{ item }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0700
        state: directory
      with_items: "{{ vault_data_directories }}"

    - name: Generate TLS key and certificate
      command: openssl req -x509 -newkey rsa:4096 -keyout {{ vault_tls_files.key }} -out {{ vault_tls_files.cert }} -days 3650 -nodes -subj "/CN=vault"
      args:
        creates: "{{ vault_tls_files.key }}"

    - name: Set ownership of TLS material
      file:
        path: "{{ item }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        state: file
      with_items: "{{ vault_tls_files.all }}"

    - name: Copy Vault binary
      copy:
        src: "{{ vault_download_path }}/vault"
        dest: /usr/bin/vault
        owner: root
        group: root
        mode: 0755
      notify: Restart Vault

    - name: Set cap_ipc_lock=ep on /usr/bin/vault
      capabilities:
        path: /usr/bin/vault
        capability: cap_ipc_lock=ep
        state: present
      notify: Restart Vault

    - name: Touch vault.env
      file:
        path: /etc/vault.env
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0640
        state: touch

    - name: Create /usr/lib/systemd/system
      file:
        path: /usr/lib/systemd/system
        owner: root
        group: root
        mode: 0755
        state: directory

    - name: Copy Vault service file
      copy:
        src: vault.service
        dest: /usr/lib/systemd/system/vault.service
        owner: root
        group: root
        mode: 0644
      notify: Restart Vault

    - name: Copy Vault configuration
      template:
        src: vault.hcl.j2
        dest: /etc/vault.d/vault.hcl
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0640
      notify: Restart Vault

    - name: Flush handlers
      meta: flush_handlers


