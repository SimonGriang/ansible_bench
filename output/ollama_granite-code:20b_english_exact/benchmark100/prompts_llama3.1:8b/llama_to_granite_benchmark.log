---
- name: Restart RKE2 service
  service:
    name: rke2-server
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: "kubectl get node -o jsonpath='{range .items[*]}{.metadata.name} ' | wc -l"
  args:
    executable: /bin/bash
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_servers_group_name] }}"
  register: all_ready_nodes
  until: (all_ready_nodes.stdout | int == rke2_servers | length) or (item == groups[rke2_servers_group_name] | last)
  retries: 100
  delay: 15
  changed_when: false
  check_mode: no

- name: Wait for all pods to be ready again
  shell: "kubectl get pods --all-namespaces -o jsonpath='{range .items[*]}{.status.phase} ' | grep -v Running | grep -v Succeeded | wc -l"
  args:
    executable: /bin/bash
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_servers_group_name] }}"
  register: all_pods_ready
  until: (all_pods_ready.stdout | int == 0) or (item == groups[rke2_servers_group_name] | last)
  retries: 100
  delay: 15
  changed_when: false
  check_mode: no
  when: rke2_wait_for_all_pods_to_be_ready
