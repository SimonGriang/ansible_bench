---

- name: Task 1
  include_tasks: assert.yml

- name: Task 2
  package:
    name: "{{ mysql_package }}"
    state: present
  notify: set root password, systemctl daemon-reexec

- name: Task 3
  ini_file:
    dest: "{{ mysql_configuration_destination }}/server.cnf"
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0644
    backup: yes
  loop: "{{ mysql_configuration_options }}"
  notify: restart mysql

- name: Task 4
  ini_file:
    dest: "{{ mysql_configuration_destination }}/client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    mode: 0644
    backup: yes

- name: Task 5
  shell: "{{ mysql_initialize_command }}"
  args:
    warn: false
  changed_when: false
  when: mysql_platform == "Linux"

- name: Task 6
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Task 7
  meta: flush_handlers

- name: Task 8
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0644

- name: Task 9
  mysql_db:
    name: "{{ item.name }}"
    state: present
  no_log: yes
  loop: "{{ mysql_databases }}"

- name: Task 10
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  no_log: yes
  loop: "{{ mysql_users }}"

- name: Task 11
  meta: flush_handlers


