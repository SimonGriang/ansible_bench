- import_tasks: assert.yml
  delegate_to: localhost
  run_once: yes

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: present
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version | int == 8

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  copy:
