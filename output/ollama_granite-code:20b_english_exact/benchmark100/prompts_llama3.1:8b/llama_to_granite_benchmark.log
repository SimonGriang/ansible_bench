---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ openssl_requirements }}"
    state: present
  register: install_packages
  until: install_packages is success
  retries: 5
  delay: 2

- name: Install pip packages
  pip:
    name: "{{ openssl_pip_packages }}"
    state: present
  register: install_pip_packages
  until: install_pip_packages is success
  retries: 5
  delay: 2
  when: openssl_pip_packages|length > 0

- name: Create the key directory
  file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: "{{ openssl_directory_mode }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create the csr directory
  file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: "{{ openssl_directory_mode }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create the crt directory
  file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: "{{ openssl_directory_mode }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include create.yml tasks
  include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item_name
  when: openssl_items is defined and openssl_items|length > 0


