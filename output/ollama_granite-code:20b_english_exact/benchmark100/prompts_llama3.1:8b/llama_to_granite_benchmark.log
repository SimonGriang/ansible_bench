- name: Configure Apache vhosts
  hosts: all
  tasks:
    - name: Create document root directories
      file:
        path: "/var/www/{{ item.servername | urlsplit('hostname') }}"
        state: directory
        mode: 0755
      loop: "{{ httpd_vhosts }}"
    - name: Configure vhost configuration files
      template:
        src: "{{ vhost_conf_template }}"
        dest: "/etc/apache2/sites-available/{{ item.servername | urlsplit('hostname') }}.conf"
      loop: "{{ httpd_vhosts }}"
    - name: Enable vhosts on Debian systems
      command: a2ensite "{{ item.servername | urlsplit('hostname') }}.conf"
      loop: "{{ httpd_vhosts }}"
      when: ansible_os_family == "Debian"


