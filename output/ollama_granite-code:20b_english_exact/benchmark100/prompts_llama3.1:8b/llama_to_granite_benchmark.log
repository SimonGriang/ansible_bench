- name: Ensure old versions of Docker are not installed
  ansible.builtin.yum:
    name: docker-engine
    state: absent

- name: Add Docker GPG key
  ansible.builtin.apt_key:
    url: https://download.docker.com/linux/centos/gpg
    id: 060A61C58B969C75
    state: present

- name: Add Docker repository
  ansible.builtin.copy:
    dest: /etc/yum.repos.d/docker-ce.repo
    content: |
      [docker-ce-stable]
      name=Docker CE Stable - $basearch
      baseurl=https://download.docker.com/linux/centos/7/$basearch/stable
      enabled=1
      gpgcheck=1
      gpgkey=https://download.docker.com/linux/centos/gpg

- name: Configure Docker Nightly repo and Docker Test repo
  ansible.builtin.copy:
    dest: /etc/yum.repos.d/docker-ce-nightly.repo
    content: |
      [docker-ce-nightly]
      name=Docker CE Nightly - $basearch
      baseurl=https://download.docker.com/linux/centos/7/$basearch/nightly
      enabled={{ docker_yum_repo_enable_nightly }}
      gpgcheck=1
      gpgkey=https://download.docker.com/linux/centos/gpg

- name: Configure Docker Test repo
  ansible.builtin.copy:
    dest: /etc/yum.repos.d/docker-ce-test.repo
    content: |
      [docker-ce-test]
      name=Docker CE Test - $basearch
      baseurl=https://download.docker.com/linux/centos/7/$basearch/test
      enabled={{ docker_yum_repo_enable_test }}
      gpgcheck=1
      gpgkey=https://download.docker.com/linux/centos/gpg

- name: Configure containerd on RHEL 8
  ansible.builtin.yum:
    name: "{{ item }}"
    state: present
  loop:
    - runc
    - container-selinux
    - containerd.io


