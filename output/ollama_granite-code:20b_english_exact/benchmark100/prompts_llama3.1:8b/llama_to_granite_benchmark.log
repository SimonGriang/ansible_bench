---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: yes

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: present
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version | int == 8

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  copy:
    src: redis.conf.j2
    dest: /etc/redis.conf
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes



