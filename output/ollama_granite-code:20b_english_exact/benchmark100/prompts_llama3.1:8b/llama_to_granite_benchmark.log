---
- name: Initialize RKE2
  hosts: localhost
  tasks:
    - name: Create the RKE2 config directory
      file:
        path: /etc/rancher/rke2
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Set server taints
      set_fact:
        combined_node_taints: "{{ rke2_server_node_taints }}"
      when: rke2_type == "server"

    - name: Set agent taints
      set_fact:
        combined_node_taints: "{{ rke2_agent_node_taints }}"
      when: rke2_type == "agent"

    - name: Copy RKE2 config
      copy:
        src: "{{ rke2_config_file_src }}"
        dest: "{{ rke2_config_file_dest }}"
        owner: root
        group: root
        mode: '0644'
        backup: yes
      notify: Config file changed

    - name: Copy kubelet config
      copy:
        content: "{{ rke2_kubelet_config }}"
        dest: "{{ rke2_kubelet_config_file }}"
        owner: root
        group: root
        mode: '0644'
        backup: yes
      when: rke2_kubelet_config != ""
      notify: Config file changed

    - name: Copy Containerd Registry Configuration file
      copy:
        src: "{{ item.src }}"
        dest: "{{ item.dest }}"
        owner: root
        group: root
        mode: '0644'
        backup: yes
      when: (rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != "")
      loop:
        - { src: "{{ rke2_system_default_registry_mirrors }}", dest: "{{ rke2_system_default_registry_mirrors_file }}" }
        - { src: "{{ rke2_system_default_registry_configs }}", dest: "{{ rke2_system_default_registry_configs_file }}" }
      notify: Config file changed

    - name: Start RKE2 service on the rest of the nodes
      service:
        name: rke2
        state: started
        enabled: yes
        daemon_reload: yes
        sleep: 5
        retries: 10
      notify: Service (re)started
      when: rke2_type != "server"

    - name: Mask other RKE2 service on the rest of the nodes
      service:
        name: rke2
        enabled: no
      when: rke2_type != "server"

    - name: Wait for remaining nodes to be ready - no CNI
      command: sleep 10
      when: rke2_type != "server"

    - name: Wait for remaining nodes to be ready - with CNI
      command: sleep 10
      when: rke2_type == "server" and rke2_cni == "false"

    - name: Wait for remaining nodes to be ready - with CNI
      command: sleep 10
      when: rke2_type == "server" and rke2_cni == "true" and inventory_hostname == groups[rke2_server_group][0]

    - name: Wait for remaining nodes to be ready - with CNI
      command: sleep 10
      when: rke2_type == "server" and rke2_cni == "true" and inventory_hostname != groups[rke2_server_group][0]


