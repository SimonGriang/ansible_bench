---
- name: Install packages required by GRUB
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Configure GRUB_TIMEOUT value in /etc/default/grub
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: true
    mode: "0664"
  notify: Update grub

- name: Configure GRUB_RECORDFAIL_TIMEOUT value in /etc/default/grub
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: true
    mode: "0664"
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX in /etc/default/grub
  replace:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX=.*$'
    replace: 'GRUB_CMDLINE_LINUX="{{ grub_options | join(" ") }}"'
    backup: true
  loop: "{{ grub_options }}"
  loop_control:
    label: "Adding {{ item }} to GRUB_CMDLINE_LINUX"
  notify: Update grub
  when:
    - grub_options is defined
    - grub_options | length > 0

- name: Import password file to set GRUB password
  import_playbook: password.yml
  vars:
    test_name: grub-timeout-1
  when: grub_set_password | bool

- name: Flush handlers to ensure all notified handlers are executed
  meta: flush_handlers


