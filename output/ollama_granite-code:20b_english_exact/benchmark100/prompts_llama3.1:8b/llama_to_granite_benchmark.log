- name: Check if docker-compose is installed
  command: docker-compose --version
  register: docker_compose_vsn
  changed_when: false
  ignore_errors: true

- name: Set current version
  set_fact:
    docker_compose_current_version: "{{ docker_compose_vsn.stdout | regex_search('^docker-compose version v([0-9]+\\.[0-9]+\\.[0-9]+), build .*$') | regex_replace('^docker-compose version v([0-9]+\\.[0-9]+\\.[0-9]+).*$', 'v\\1') }}"

- name: Remove existing docker-compose version if different
  file:
    path: "{{ docker_compose_path }}"
    state: absent
  when: docker_compose_current_version != docker_compose_version

- name: Download and install Docker Compose
  get_url:
    url: "{{ docker_compose_url }}"
    dest: "{{ docker_compose_path }}"
    mode: 0755
  when: docker_compose_current_version is not defined or docker_compose_current_version != docker_compose_version


