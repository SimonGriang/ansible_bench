---

- import_tasks: assert.yml

- name: Wait for port 22 to become available
  ansible.builtin.wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  connection: local
  when:
    - bootstrap_wait_for_host
    - connection not in [ "container", "docker", "community.docker.docker" ]

- block:
    - name: Gather bootstrap facts
      ansible.builtin.include_tasks: gather_facts.yml
      when: not bootstrap_facts

    - name: Include assert.yml
      ansible.builtin.import_tasks: assert.yml

    - name: Check if sudo is available
      ansible.builtin.raw: sudo -V
      changed_when: false
      failed_when: false
      register: bootstrap_connect

    - name: Install bootstrap packages
      ansible.builtin.package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
        update_cache: true
      become: "{{ bootstrap_become }}"
      when: bootstrap_connect.rc != 0
  when: connection not in [ "container", "docker", "community.docker.docker" ]

- name: Gather Ansible facts about the system
  ansible.builtin.setup:
    gather_subset: all
  register: system_facts

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
  become: "{{ bootstrap_become }}"


