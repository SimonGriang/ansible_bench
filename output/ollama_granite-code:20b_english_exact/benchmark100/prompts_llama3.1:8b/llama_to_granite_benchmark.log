    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
  when: promtail_version == "latest"

- name: Get the checksum list for the latest release
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    return_content: yes
    status_code: 200
    body_format: json
    timeout: 30
    follow_redirects: yes
    body: {}
  register: _release
  until: _release.status == 200
  retries: 5
  delay: 10

- name: Get the checksum for the specified architecture
  set_fact:
    __promtail_checksum: "{{ item.sha256 }}"
  loop: "{{ _release.json.assets }}"
  when: not _local_zip.stat.exists and promtail_local_dir | length == 0
  until: __promtail_checksum is defined
  retries: 5
  delay: 10
  no_log: yes

- name: Test if the zip local archive exists in the specified directory
  stat:
    path: "{{ promtail_local_dir }}/promtail-linux-{{ promtail_arch }}.zip"
  register: _local_zip

- name: Assert that the local binary exists in the specified directory
  assert:
    that:
      - _local_zip.stat.exists
    msg: "promtail binary archive does not exist in {{ promtail_local_dir }}."
  when: not _local_zip.stat.exists and promtail_local_dir | length > 0


