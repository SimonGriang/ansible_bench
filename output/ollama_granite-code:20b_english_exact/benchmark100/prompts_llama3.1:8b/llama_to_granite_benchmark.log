---
- name: Playbook for PHP configuration
  hosts: all
  tasks:
    - name: Import assert.yml
      ansible.builtin.import_tasks: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Install PHP packages
      ansible.builtin.package:
        name: "{{ php_packages }}"

    - name: Find php.ini location
      ansible.builtin.shell:
        cmd: |
          set -o pipefail && {{ php_ini_command }} 2>&1 | grep -v "^;"
      args:
        executable: /bin/bash
      register: php_found_ini_location

    - name: Configure PHP settings
      ansible.builtin.template:
        src: php.ini.j2
        dest: "{{ php_found_ini_location.stdout | default(php_ini_location) }}"
        mode: "0644"
      notify: restart httpd
  handlers:
    - name: restart httpd
      ansible.builtin.service:
        name: httpd
        state: restarted


