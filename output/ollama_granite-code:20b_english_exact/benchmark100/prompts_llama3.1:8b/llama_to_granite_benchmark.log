---
- name: Ensure old versions of Docker are not installed
  yum:
    name: docker
    state: absent

- name: Add Docker GPG key
  rpm_key:
    key: https://download.docker.com/linux/centos/gpg
    state: present

- name: Add Docker repository
  get_url:
    url: https://download.docker.com/linux/centos/docker-ce.repo
    dest: /etc/yum.repos.d/docker-ce.repo

- name: Configure Docker Nightly repo
  ini_file:
    path: /etc/yum.repos.d/docker-ce.repo
    section: docker-ce-nightly
    option: enabled
    value: "{{ docker_yum_repo_enable_nightly }}"
    mode: 0644
    no_extra_spaces: yes
  when: docker_yum_repo_enable_nightly

- name: Configure Docker Test repo
  ini_file:
    path: /etc/yum.repos.d/docker-ce.repo
    section: docker-ce-test
    option: enabled
    value: "{{ docker_yum_repo_enable_test }}"
    mode: 0644
    no_extra_spaces: yes
  when: docker_yum_repo_enable_test

- name: Configure containerd on RHEL 8
  yum:
    name: "{{ item }}"
    state: present
  with_items:
    - runc
    - container-selinux
    - containerd.io
  when: ansible_distribution == "Red Hat Enterprise Linux" and ansible_distribution_major_version == "8"


