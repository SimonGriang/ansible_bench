        group: "{{ vault_group }}"

    - name: Create the Vault download directory
      file:
        path: "{{ vault_download_path }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0755
        state: directory

    - name: Download Vault binary
      unarchive:
        src: https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_amd64.zip
        dest: "{{ vault_download_path }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0755
        remote_src: true

    - name: Check if vault_path exists
      stat:
        path: "{{ vault_path }}"
      register: vault_path_stat

    - name: Create vault_path if it does not exist
      file:
        path: "{{ vault_path }}"
