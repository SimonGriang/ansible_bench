---
- name: Install epel package repositories
  hosts: all
  tasks:
    - name: Install epel package repositories for RedHat-based and Amazon Linux
      command: dnf install epel-release
      when: ansible_os_family == "RedHat" or ansible_distribution == "Amazon"
      notify: Update package cache

    - name: Install epel GPG key
      command: rpm --import {{ epel_gpg_key }}

    - name: Install epel-release package
      command: yum install {{ epel_url }}
      notify: Update package cache

    - name: Install epel-next-release package
      command: yum install {{ epel_next }}
      notify: Update package cache
      when: epel_next is defined

  handlers:
    - name: Update package cache
      yum:
        updates: yes
        security: yes


