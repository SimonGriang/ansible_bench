---

- import_tasks: assert.yml

- name: Install the cron package
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell settings for cron jobs
  lineinfile:
    path: /etc/crontab
    regexp: '^(#*)?SHELL='
    line: 'SHELL={{ cron_shell }}'

- name: Configure the system path for cron jobs
  lineinfile:
    path: /etc/crontab
    regexp: '^(#*)?PATH='
    line: 'PATH={{ cron_path }}'

