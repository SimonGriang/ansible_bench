- name: Restart RKE2 service
  service:
    name: rke2
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: |
    until [ $(kubectl get nodes | tail -n +2 | grep -c "Ready") -eq {{ all_ready_nodes.stdout }} ]; do
      sleep 15
    done
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_servers_group_name] }}"
  when: not ansible_check_mode
  register: all_ready_nodes

- name: Wait for all pods to be ready again
  shell: |
    until [ $(kubectl get pods --all-namespaces | tail -n +2 | grep -cv "Running\|Succeeded") -eq 0 ]; do
      sleep 15
    done
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_servers_group_name] }}"
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready
  register: all_pods_ready


