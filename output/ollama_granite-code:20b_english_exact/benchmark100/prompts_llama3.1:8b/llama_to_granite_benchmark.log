---
- name: Download RKE2 installation script
  get_url:
    url: https://github.com/rke2/rke2/releases/download/v1.21.2+rke2r1/rke2-install.sh
    dest: /var/tmp/rke2-install.sh
    mode: "0755"

- name: Copy local RKE2 installation script
  copy:
    src: /path/to/local/rke2-install.sh
    dest: /var/tmp/rke2-install.sh
    mode: "0755"
  when: airgap_mode and implementation == "copy"

- name: Create RKE2 artifacts folder
  file:
    path: /path/to/artifacts/folder
    state: directory
    mode: "0755"
  when: airgap_mode and implementation != "exists"

- name: Download RKE2 checksum and artifacts
  get_url:
    url: https://github.com/rke2/rke2/releases/download/v1.21.2+rke2r1/rke2-images.linux-amd64.tar.gz
    dest: /path/to/artifacts/folder/rke2-images.linux-amd64.tar.gz
    mode: "0755"
  when: airgap_mode and implementation == "download"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images folder
      file:
        path: /path/to/artifacts/folder/additonal-images
        state: directory
        mode: "0755"
    - name: Copy additional tarballs
      copy:
        src: /path/to/local/additional-tarballs
        dest: /path/to/artifacts/folder/additonal-images
        mode: "0755"
  when: airgap_mode and implementation != "exists" and additonal_tarballs

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: /path/to/artifacts/folder
    state: directory
    mode: "0755"
  when: airgap_mode and implementation == "exists"

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /var/lib/rke2/agent/etc/rke2-config.yaml
  register: rke2_config_stats

- name: Check if separate partition
  command: grep "/dev/" /proc/mounts
  register: separate_partition_check

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin"
  when: (rke2_config_stats.stat.executable is undefined or not rke2_config_stats.stat.executable) and separate_partition_check.stdout == ""

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/opt/rke2/bin"
  when: (rke2_config_stats.stat.executable is undefined or not rke2_config_stats.stat.executable) and separate_partition_check.stdout != ""

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 version"
  register: rke2_version_check
  changed_when: false

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version_check.stdout_lines[0] }}"
  when: rke2_version_check.stdout != ""

- name: Set RKE2 versions
  set_fact:
    rke2_desired_version: "v1.21.2+rke2r1"
  when: rke2_version_check.stdout == ""

- name: Prevent accidental RKE2 downgrade
  assert:
    that: "rke2_installed_version is version_compare(rke2_desired_version, '>=')"
    msg: "RKE2 downgrades are not allowed"

- name: Run RKE2 install script
  command: "{{ rke2_bin_path }}/rke2-install.sh --version {{ rke2_desired_version }} --type server --system-docker-version {{ system_docker_version }} --docker-socket {{ docker_socket }} --debug --config /var/lib/rke2/agent/etc/rke2-config.yaml"
  when: rke2_installed_version != rke2_desired_version

- name: Copy Custom Manifests
  copy:
    src: /path/to/custom/manifests
    dest: /var/lib/rke2/agent/etc/kubernetes/manifests
    mode: "0600"
  when: custom_manifests

- name: Copy Static Pods
  copy:
    src: /path/to/static/pods
    dest: /etc/kubernetes/manifests
    mode: "0600"
  when: static_pods

- name: Copy RKE2 environment file
  copy:
    src: /path/to/rke2-environment
    dest: /var/lib/rke2/agent/etc/rke2-env.sh
    mode: "0644"
  when: environment_options


