    mode: "{{ openssl_directory_mode }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create crt directory
  file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: "{{ openssl_directory_mode }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- include: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: openssl_item


