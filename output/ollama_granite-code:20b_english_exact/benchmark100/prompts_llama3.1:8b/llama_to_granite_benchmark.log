- name: HTTPD vhosts configuration
  hosts: localhost
  tasks:
    - name: Create the document root directory for each vhost
      file:
        path: "{{ item.documentroot }}"
        state: directory
        mode: "{{ item.mode | default(0755) }}"
      loop: "{{ httpd_vhosts }}"
