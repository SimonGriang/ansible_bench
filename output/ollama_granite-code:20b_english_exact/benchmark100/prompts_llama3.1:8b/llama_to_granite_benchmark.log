content='---\n- name: Check if Helm binary exists\n  stat:\n    path: "{{ helm_bin_path }}"\n  register: helm_check\n\n- name: Check the current version of Helm\n  command: "{{ helm_bin_path }} version --client --short"\n  register: helm_existing_version\n  failed_when: false\n  changed_when: false\n\n- name: Download Helm binary\n  get_url:\n    url: "{{ helm_repo_path }}"\n    dest: /tmp\n    mode: 0755\n  when: not helm_check.stat.exists or helm_existing_version.stdout != helm_version\n\n- name: Copy Helm binary into place\n  copy:\n    src: /tmp/helm\n    dest: "{{ helm_bin_path }}"\n    mode: 0755\n    remote_src: true\n  become: true\n  when: helm_check.stat.changed' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-13T17:18:56.836635658Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4560732726, 'load_duration': 40488906, 'prompt_eval_count': 858, 'prompt_eval_duration': 10988639, 'eval_count': 194, 'eval_duration': 4507833522, 'model_name': 'granite-code:20b'} id='run--48ec26e2-0be0-4827-a26c-43e36b260794-0' usage_metadata={'input_tokens': 858, 'output_tokens': 194, 'total_tokens': 1052}
