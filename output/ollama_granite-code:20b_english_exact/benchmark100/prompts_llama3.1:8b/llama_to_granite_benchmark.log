---
- name: Verify the RKE2 prerequisites
  hosts: node
  tasks:
  - name: Download RKE2 installation script
    get_url:
      url: https://github.com/rke2/rke2/releases/download/v1.22.5%2Brke2r1/rke2-install.sh
      dest: /var/lib/rke2/install.sh
      mode: 0755
  - name: Copy local RKE2 installation script
    copy:
      src: /path/to/local/rke2-install.sh
      dest: /var/lib/rke2/install.sh
      mode: 0755
    when: airgap_mode and implementation == "copy"
  - name: Create RKE2 artifacts folder
    file:
      path: /var/lib/rke2/artifacts
      state: directory
      mode: 0755
    when: airgap_mode and implementation != "exists"
  - name: Download RKE2 checksum and artifacts
    get_url:
      url: https://github.com/rke2/rke2/releases/download/v1.22.5%2Brke2r1/rke2-checksums.txt
      dest: /var/lib/rke2/artifacts/rke2-checksums.txt
      mode: 0755
    when: airgap_mode and implementation == "download"
  - name: Airgap mode - additional images tarballs
    block:
    - name: Create additional images tarballs directory
      file:
        path: /var/lib/rke2/artifacts/additional_images
        state: directory
        mode: 0755
    - name: Copy RKE2 components to additional images tarballs directory
      copy:
        src: /path/to/additional/images/tarballs
        dest: /var/lib/rke2/artifacts/additional_images
        mode: 0755
    when: airgap_mode and implementation != "exists" and additional_tarballs|length > 0
  - name: Airgap mode - ensure artifacts exist and have acceptable permissions
    file:
      path: /var/lib/rke2/artifacts
      state: directory
      mode: 0755
    when: airgap_mode and implementation == "exists"
  - name: Populate service facts
    service_facts:
  - name: Get stats of the FS object
    stat:
      path: /var/lib/rke2
    register: rke2_fs_obj
  - name: Check if separate partition
    shell: grep " /var/lib/rke2 " /proc/mounts
    register: rke2_separate_partition
    failed_when: rke2_separate_partition.rc not in [0, 1]
  - name: Set RKE2 bin path
    set_fact:
      rke2_bin_path: "/usr/local/bin"
    when: rke2_fs_obj.stat.pw_uid != 0 or rke2_separate_partition.rc == 0
  - name: Set RKE2 bin path
    set_fact:
      rke2_bin_path: "/bin"
    when: rke2_fs_obj.stat.pw_uid == 0 or rke2_separate_partition.rc == 1
  - name: Check RKE2 version
    shell: |
      {{ rke2_bin_path }}/rke2 version | awk '{print $3}'
    register: rke2_installed_version
    changed_when: false
  - name: Set RKE2 versions
    set_fact:
      rke2_installed_major_version: "{{ rke2_installed_version.stdout | regex_replace('^v', '') | regex_replace('\\+rke2r.*$','') }}"
      rke2_desired_major_version: "{{ desired_version | regex_replace('^v', '') | regex_replace('\\+rke2r.*$','') }}"
  - name: Prevent accidental RKE2 downgrade
    assert:
      that:
      - rke2_desired_major_version | int <= rke2_installed_major_version | int
      fail_msg: "RKE2 downgrades are not supported. desried RKE2 version: {{ desired_version }}, installed RKE2 version: {{ rke2_installed_version.stdout }}"
      success_msg: "Good: Desired RKE2 version is greater than or equal to installed version."
  - name: Run RKE2 install script
    shell: |
      {{ rke2_bin_path }}/rke2 install \
      --ignore-docker-version \
      --rke-image rke/rke2:{{ desired_version }} \
      --system-image rke/rke2-runtime:{{ desired_version }} \
      --service-option "flannel=false"
    when: rke2_installed_major_version != rke2_desired_major_version
  - name: Copy Custom Manifests
    copy:
      src: /path/to/custom/manifests
      dest: /var/lib/rke2/server/manifests
      mode: 0644
    when: custom_manifests|length > 0
  - name: Copy Static Pods
    copy:
      src: /path/to/static/pods
      dest: /var/lib/rke2/agent/pod-manifests
      mode: 0644
    when: static_pods|length > 0
  - name: Copy RKE2 environment file
    copy:
      src: /path/to/rke2-env-file.yaml
      dest: /etc/rke2/rke2-env.yaml
      mode: 0644
    when: env_options|length > 0


