---
- hosts: all
  tasks:
  - name: Install epel package repositories for compatible operating systems (RedHat-based and Amazon Linux).
    yum:
      name: epel-release
      state: present
    when: ansible_os_family == "RedHat" or ansible_distribution == "Amazon"
  - name: Install the epel GPG key.
    rpm_key:
      key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ epel_gpg_key }}
      state: present
  - name: Install the epel-release package.
    get_url:
      url: "{{ epel_url }}"
      dest: /etc/yum.repos.d/epel.repo
      mode: 0644
    notify: Update package cache
  - name: Install the epel-next-release package (conditional).
    yum:
      name: epel-next-release
      state: present
    when: epel_next
    notify: Update package cache
  handlers:
  - name: Update package cache
    yum:
      update_cache: yes


