---
- name: "User management"
  hosts: all
  vars:
    users_requirements:
      - package1
      - package2
    users_groups:
      - group1
      - group2
    users:
      - user1
      - user2
    users_sudo_includedir: "/etc/sudoers.d"
    users_cron_allow: []
  tasks:
    - import_tasks: assert.yml
    - name: "Install required software"
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ users_requirements }}"
    - name: "Loop over users_groups"
      include_tasks: group.yml
      loop: "{{ users_groups }}"
    - name: "Ensure the /etc/sudoers.d directory is included"
      lineinfile:
        path: /etc/sudoers
        line: "{{ users_sudo_includedir }}"
        state: present
    - name: "Loop over users"
      include_tasks: user.yml
      loop: "{{ users }}"
    - name: "Manage cron permission"
      template:
        src: cron.allow.j2
        dest: /etc/cron.allow
        mode: 0644
      when: users_cron_allow is defined
    - name: "Check existence of /etc/cron.allow"
      file:
        path: /etc/cron.allow
        state: absent
      when: users_cron_allow is not defined


