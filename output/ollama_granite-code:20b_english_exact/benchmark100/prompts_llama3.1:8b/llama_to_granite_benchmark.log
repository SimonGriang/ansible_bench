content='---\n\n- name: Import and run assert.yml file\n  hosts: localhost\n  tasks:\n  - import_playbook: assert.yml\n  tags:\n  - always\n\n- name: Install required packages\n  hosts: all\n  tasks:\n  - name: Install packages\n    package:\n      name: "{{ selinux_requirements }}"\n      state: present\n  - name: Trigger handler\n    changed_when: true\n    notify:\n    - Gather facts\n  handlers:\n  - name: Gather facts\n    setup:\n  tags:\n  - packages\n\n- name: Maintain the system\n  hosts: all\n  tasks:\n  - name: Flush handlers\n    meta: flush_handlers\n  tags:\n  - maintain\n\n- name: Configure selinux\n  hosts: all\n  tasks:\n  - name: Manage selinux\n    selinux:\n      state: "{{ selinux_state }}"\n      policy: "{{ selinux_policy }}"\n    notify: Reboot\n  - name: Manage selinux booleans\n    selinux_boolean:\n      name: "{{ item.name }}"\n      state: "{{ item.state }}"\n      persistent: "{{ item.persistent }}"\n    with_items: "{{ selinux_booleans }}"\n  when:\n  - selinux_status is defined\n  - connection not in [ \'container\', \'docker\', \'community.docker.docker\' ]\n  tags:\n  - selinux\n\n- name: Reboot the system\n  hosts: all\n  tasks:\n  - name: Reboot the system\n    command: reboot\n    async: 0\n    poll: 0\n    ignore_errors: true\n  when:\n  - selinux_reboot\n  tags:\n  - selinux\n...' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-13T17:09:21.383661742Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7714480349, 'load_duration': 31671932, 'prompt_eval_count': 614, 'prompt_eval_duration': 478975456, 'eval_count': 346, 'eval_duration': 7200505859, 'model_name': 'granite-code:20b'} id='run--e7d5ccd6-4981-4804-8127-6fdffa98e18b-0' usage_metadata={'input_tokens': 614, 'output_tokens': 346, 'total_tokens': 960}
