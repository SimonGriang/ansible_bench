  when: java_os_specific_vars['java_open_jdk_home_dir'] is defined and java_os_specific_vars['java_open_jdk_home_dir']

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Debian pre-requisites
  block:
    - name: Removing deprecated repositories
      apt_repository:
        repo: "deb http://security.debian.org {{ ansible_distribution_release }}/updates main"
        state: absent

    - name: Installing extra apt tools
      apt:
        name: "{{ item }}"
        state: present
      loop:
        - apt-transport-https
        - ca-certificates
        - curl
        - software-properties-common

    - name: Adding required key repositories
      apt_key:
        url: "{{ item }}"
        state: present
      loop:
        - https://download.docker.com/linux/debian/gpg
        - https://apt.releases.hashicorp.com/gpg

    - name: Adding required repositories
      apt_repository:
        repo: "{{ item }}"
        state: present
      loop:
        - deb [arch=amd64] https://download.docker.com/linux/debian {{ ansible_distribution_release }} stable
        - deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main

  when: ansible_os_family == "Debian"

- name: RedHat pre-requisites
  block:
    - name: Adding required key repositories
      get_url:
        url: "{{ item }}"
        dest: /etc/yum.repos.d/
      loop:
        - https://download.docker.com/linux/centos/gpg
        - https://rpm.releases.hashicorp.com/gpg

    - name: Adding required repositories
      get_url:
        url: "{{ item }}"
        dest: /etc/yum.repos.d/
      loop:
        - https://download.docker.com/linux/centos/docker-ce.repo
        - https://rpm.releases.hashicorp.com/rpm/centos/{{ ansible_distribution_major_version }}/hashiCorp.repo

  when: ansible_os_family == "RedHat"

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_libs }}"

- name: Install Java, Debian
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
  when: ansible_os_family == "Debian"

- name: Install Java, RedHat
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
  when: java_environment_variables is defined and java_environment_variables

- name: Source environment variables
  shell: . /etc/profile

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  alternatives:
    name: java
    link: /usr/bin/java
    path: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
    priority: 1
  when: ansible_java_version is version('11', '<')

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  alternatives:
    name: java
    link: /usr/bin/java
    path: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java
    priority: 1
  when: ansible_java_version is version('11', '>=')


