---
- name: "rke2-install"
  tasks:
    - name: "Create the RKE2 config directory"
      file:
        path: "/etc/rancher/rke2"
        owner: "root"
        group: "root"
        mode: "0755"
        state: "directory"
    - name: "Set server taints"
      set_fact:
        combined_node_taints: "{{ rke2_server_node_taints }}"
      when: "rke2_type == 'server'"
    - name: "Set agent taints"
      set_fact:
        combined_node_taints: "{{ rke2_agent_node_taints }}"
      when: "rke2_type == 'agent'"
    - name: "Copy RKE2 config"
      copy:
        src: "{{ rke2_config_file_src }}"
        dest: "{{ rke2_config_file_dest }}"
        owner: "root"
        group: "root"
        mode: "0644"
      notify: "Config file changed"
    - name: "Copy kubelet config"
      copy:
        src: "templates/kubelet.conf.j2"
        dest: "/var/lib/kubelet/config.yaml"
        owner: "root"
        group: "root"
        mode: "0644"
      when: "rke2_kubelet_config != ''"
      notify: "Config file changed"
    - name: "Copy Containerd Registry Configuration file"
      copy:
        src: "{{ rke2_custom_registry_config_file_src }}"
        dest: "{{ rke2_custom_registry_config_file_dest }}"
        owner: "root"
        group: "root"
        mode: "0644"
      when: "(rke2_custom_registry_mirrors != []) or (rke2_custom_registry_configs != [])"
      notify: "Config file changed"
    - name: "Start RKE2 service on the rest of the nodes"
      service:
        name: "{{ rke2_service_name }}"
        state: "started"
        enabled: true
      retries: "{{ rke2_service_start_retries }}"
      delay: "{{ rke2_service_start_delay }}"
      loop: "{{ groups[rke2_group_name] }}"
      when: "(rke2_type == 'agent') and (inventory_hostname != groups[rke2_server_group_name][0])"
      notify: "Service (re)started"
    - name: "Mask other RKE2 service on the rest of the nodes"
      service:
        name: "{{ item }}"
        enabled: false
        state: "stopped"
      loop: "{{ query('service_facts', rke2_service_name ~ '.service') | json_query('[*].service') | difference([rke2_service_name ~ '.service']) }}"
      when: "(rke2_type == 'agent') and (inventory_hostname != groups[rke2_server_group_name][0])"
    - name: "Wait for remaining nodes to be ready - no CNI"
      uri:
        url: "https://localhost:6443/readyz?timeout=30s"
        validate_certs: false
      register: "api_response"
      until: "(api_response.status == 404) or (api_response.status == 200)"
      retries: "{{ rke2_ready_retries }}"
      delay: "{{ rke2_ready_delay }}"
      loop: "{{ groups[rke2_group_name] }}"
      loop_control:
        label: "{{ item }}"
      when: "(rke2_type == 'agent') and (inventory_hostname != groups[rke2_server_group_name][0]) and (rke2_cni_type == '')"
    - name: "Wait for remaining nodes to be ready - with CNI"
      uri:
        url: "https://localhost:6443/readyz?timeout=30s"
        validate_certs: false
      register: "api_response"
      until: "(api_response.status == 404) or (api_response.status == 200)"
      retries: "{{ rke2_ready_retries }}"
      delay: "{{ rke2_ready_delay }}"
      when: "(rke2_type == 'agent') and (inventory_hostname == groups[rke2_server_group_name][0]) and (rke2_cni_type != '')"



