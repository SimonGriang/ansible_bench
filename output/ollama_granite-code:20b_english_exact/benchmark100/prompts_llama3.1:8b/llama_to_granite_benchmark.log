---
- name: Run assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install mysql package
  package:
    name: mysql
    state: present

- name: Configure mysql server
  template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: "{{ mysql_config_file_path }}"
    mode: 0644
    owner: root
    group: root
  notify: restart mysql

- name: Configure mysql client
  template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: "{{ mysql_config_file_path }}"
    mode: 0644
    owner: root
    group: root

- name: Initialize mysql service
  command: "{{ mysql_initialize_command }}"
  when: ansible_os_family in ["Alpine", "Archlinux"]
  notify: restart mysql

- name: Start and enable mysql service
  service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Create my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0644
    owner: root
    group: root

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: List databases
  mysql_info:
    type: database
  register: databases

- name: Import databases
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default(omit) }}"
    host: "{{ item.host | default(omit) }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


