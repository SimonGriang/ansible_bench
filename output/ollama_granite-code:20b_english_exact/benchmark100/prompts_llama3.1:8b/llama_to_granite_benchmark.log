---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install mysql package
  ansible.builtin.package:
    name: mysql
    state: present

- name: Configure mysql server
  ansible.builtin.template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: "{{ mysql_config_file_path }}"
    mode: "0644"
    owner: root
    group: root
  notify: restart mysql

- name: Configure mysql client
  ansible.builtin.template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: "{{ mysql_config_file_path }}"
    mode: "0644"
    owner: root
    group: root

- name: Initialize mysql service
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_os_family in ["Alpine", "Archlinux"]
  changed_when: false
  notify: restart mysql

- name: Start and enable mysql service
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Create my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: "0644"
    owner: root
    group: root

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: List databases
  community.mysql.mysql_info:
    type: database
  register: databases

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default(omit) }}"
    host: "{{ item.host | default(omit) }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


