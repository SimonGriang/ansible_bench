---
- name: Bootstrap Playbook
  tasks:
    - name: Lookup bootstrap facts
      raw: cat /etc/os-release
      register: bootstrap_facts

    - name: Set bootstrap distribution and major version facts
      set_fact:
        bootstrap_distribution: "{{ bootstrap_facts.stdout | from_yaml | selectattr('key', 'equalto', 'NAME') | first | default({}) | selectattr('value', 'defined') | first | default({}) |  get_item('value') }}"
        bootstrap_major_version: "{{ bootstrap_facts.stdout | from_yaml | selectattr('key', 'equalto', 'VERSION_ID') | first | default({}) | selectattr('value', 'defined') | first | default({}) |  get_item('value') }}"
      loop: "{{ bootstrap__os_family_map | dict2items }}"
      when:
        - bootstrap_facts.stdout | from_yaml | selectattr('key', 'equalto', item.key) | list | length > 0
        - bootstrap_facts.stdout | from_yaml | selectattr('key', 'equalto', item.key) | first | default({}) | selectattr('value', 'defined') | list | length > 0
        - bootstrap_facts.stdout | from_yaml | selectattr('key', 'equalto', item.key) | first | default({}) | selectattr('value', 'defined') | first | default({}) | get_item('value') is defined
      loop_control:
        label: "Setting bootstrap {{ item.key }} fact"

    - name: Set bootstrap OS family fact
      set_fact:
        bootstrap_os_family: "{{ item.key }}"
      loop: "{{ bootstrap__os_family_map | dict2items }}"
      when:
        - bootstrap_facts.stdout | from_yaml | selectattr('key', 'equalto', item.key) | list | length > 0
        - bootstrap_facts.stdout | from_yaml | selectattr('key', 'equalto', item.key) | first | default({}) | selectattr('value', 'defined') | list | length > 0
        - bootstrap_facts.stdout | from_yaml | selectattr('key', 'equalto', item.key) | first | default({}) | selectattr('value', 'defined') | first | default({}) | get_item('value') is defined
      loop_control:
        label: "Setting bootstrap {{ item.key }} OS family fact"



