---
- name: Git Configuration
  hosts: localhost
  tasks:
    - name: Include assert.yml
      include_role:
        name: assert.yml
    - name: Install git package
      package:
        name: "{{ git_packages }}"
        state: present
    - name: Check if user exists
      command: "getent passwd {{ git_username }}"
      register: user_exists
      ignore_errors: true
    - name: Create directory for git configuration
      file:
        path: "/home/{{ git_username }}"
        state: directory
        owner: "{{ git_username }}"
        group: "{{ git_groupname }}"
        mode: "0755"
      when: user_exists is succeeded
    - name: Configure git
      template:
        src: gitconfig.j2
        dest: "/home/{{ git_username }}/.gitconfig"
        mode: "0644"
      when: user_exists is succeeded and git_user_email is defined and git_user_name is defined and git_username is defined
    - name: Create repository destination
      file:
        path: "{{ git_repository_destination }}"
        state: directory
        owner: "{{ git_username }}"
        group: "{{ git_groupname }}"
        mode: "0755"
      when: user_exists is succeeded
    - name: Clone repositories
      git:
        repo: "{{ item.repo }}"
        dest: "{{ git_repository_destination }}/{{ item.dest }}"
        version: "{{ item.version | default('HEAD') }}"
        force: "{{ item.force | default(false) }}"
        become_user: "{{ git_username }}"
      with_items: "{{ git_repositories }}"
      when: user_exists is succeeded and git_repositories is defined and git_repository_destination is defined


