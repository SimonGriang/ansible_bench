---
- name: Install unzip package and update cache if necessary
  apt:
    name: unzip
    update_cache: "{{ promtail_apt_update_cache }}"

- name: Create promtail system group if necessary
  group:
    name: "{{ promtail_system_group }}"
    state: present
  when: promtail_system_group != "root"

- name: Create the promtail system user
  user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    groups: "{{ promtail_user_additional_groups }}"
    state: present
  when: promtail_system_user != "root"

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: 0755

- name: Create necessary config directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0750
  loop:
    - "{{ promtail_config_dir }}"
    - "{{ promtail_positions_dir }}"

- name: Create application directories
  file:
    path: "{{ promtail_install_dir }}/{{ item }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0750
  loop:
    - "promtail-{{ promtail_version }}"
    - "promtail-{{ promtail_version }}.linux-amd64"

- name: Check the existence of the promtail binary
  stat:
    path: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}/promtail"
  register: promtail_binary

- name: Download promtail binaries if necessary
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "{{ promtail_temp_dir }}/{{ promtail_download_url | basename }}"
    mode: 0644
  when: not promtail_binary.stat.exists or promtail_binary_propagate

- name: Propagate locally distributed promtail archive if necessary
  copy:
    src: "{{ promtail_local_download_dir }}/{{ promtail_download_url | basename }}"
    dest: "{{ promtail_temp_dir }}/{{ promtail_download_url | basename }}"
    mode: 0644
  when: promtail_local_download_dir is defined and not promtail_binary.stat.exists and promtail_binary_propagate

- name: Download promtail binaries to controller node if necessary
  copy:
    src: "{{ promtail_temp_dir }}/{{ promtail_download_url | basename }}"
    dest: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}/{{ promtail_download_url | basename }}"
    mode: 0644
  when: promtail_binary_propagate

- name: Propagate promtail binaries
  copy:
    src: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}/{{ promtail_download_url | basename }}"
    dest: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}.linux-amd64/promtail"
    remote_src: true
    mode: 0755
  when: promtail_binary_propagate

- name: Unpack promtail binaries
  unarchive:
    src: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}/{{ promtail_download_url | basename }}"
    dest: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}.linux-amd64"
    remote_src: true
    mode: 0755

- name: Create a symlink to the latest version
  file:
    src: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}.linux-amd64/promtail"
    dest: /usr/local/bin/promtail
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    state: link

- name: Write the promtail configuration
  copy:
    content: "{{ promtail_config }}"
    dest: "{{ promtail_config_dir }}/promtail.yml"
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0640

- name: Create the systemd service unit
  copy:
    content: "{{ promtail_systemd_unit }}"
    dest: "{{ promtail_systemd_dir }}/promtail.service"
    owner: root
    group: root
    mode: 0644


