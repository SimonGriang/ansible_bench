b', 'created_at': '2025-10-24T01:02:12.46401295Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14891605048, 'load_duration': 33643973, 'prompt_eval_count': 1854, 'prompt_eval_duration': 537791791, 'eval_count': 619, 'eval_duration': 14318494575, 'model_name': 'granite-code:20b'} id='run--cc2dda49-c7ee-4f07-9663-373478321bce-0' usage_metadata={'input_tokens': 1854, 'output_tokens': 619, 'total_tokens': 2473}
