---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install Apache HTTP Server
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux for httpd
  block:
    - name: Enable SELinux booleans
      ansible.builtin.seboolean:
        name: "{{ item }}"
        state: yes
        persistent: yes
      with_items: "{{ httpd_sebooleans }}"

    - name: Allow httpd connections to custom ports
      ansible.builtin.seboolean:
        name: httpd_can_network_connect
        state: yes
        persistent: yes

    - name: Allow httpd connections to SSL ports
      ansible.builtin.seboolean:
        name: httpd_can_network_connect_ssl
        state: yes
        persistent: yes
  when: ansible_selinux.status == 'enabled'

- name: Configure Apache HTTP Server
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "{{ httpd_config_mode }}"
    owner: root
    group: root
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Activate Apache HTTP Server modules
  block:
    - name: Activate modules with a2enmod
      ansible.builtin.command: "a2enmod {{ item }}"
      notify: Test httpd configuration validity
      with_items: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == 'Debian'

- name: Configure SSL
  ansible.builtin.import_tasks: ssl.yml
  when: https_ssl_enable is defined

- name: Configure locations
  ansible.builtin.import_tasks: locations.yml
  when: httpd_locations is defined

- name: Configure virtual hosts
  ansible.builtin.import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  block:
    - name: Configure ports
      ansible.builtin.template:
        src: "{{ httpd_ports_conf }}"
        dest: /etc/apache2/ports.conf
        mode: 0644
        owner: root
        group: root
      notify:
        - Test httpd configuration validity
        - Restart httpd
  when: ansible_os_family in [ 'Debian', 'Suse' ]

- name: Configure directories
  ansible.builtin.import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Remove index.html
  ansible.builtin.file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example is defined

- name: Start and enable Apache HTTP Server service
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


