---
- name: Configure user accounts
  hosts: all
  tasks:
    - name: Create local ssh key directory for a user
      file:
        path: "/home/{{ johndoe.name }}/.ssh"
        state: directory
        mode: 0750
        owner: "{{ johndoe.name }}"
        group: "{{ johndoe.group }}"

    - name: Manage the user account
      user:
        name: "{{ johndoe.name }}"
        comment: "{{ johndoe.comment }}"
        group: "{{ johndoe.group }}"
        create_home: "{{ johndoe.create_home | default(omit) }}"
        password: "{{ johndoe_password }}"
        password_lock: "{{ johndoe.password_lock | default(omit) }}"
        state: "{{ johndoe.state | default(omit) }}"

    - name: Set up the user's sudo options
      template:
        src: sudoers.j2
        dest: "/etc/sudoers.d/{{ johndoe.name }}"
        mode: 0440
        owner: root
        group: root
      when: johndoe_sudo_options is defined

    - name: Generate the user's private SSH key
      command: ssh-keygen -t rsa -b 4096 -f "/home/{{ johndoe.name }}/.ssh/id_rsa" -q -N ""
      args:
        creates: "/home/{{ johndoe.name }}/.ssh/id_rsa"
      when: johndoe_ssh_key_management

    - name: Generate the user's public SSH key
      command: ssh-keygen -y -f "/home/{{ johndoe.name }}/.ssh/id_rsa" > "/home/{{ johndoe.name }}/.ssh/id_rsa.pub"
      args:
        creates: "/home/{{ johndoe.name }}/.ssh/id_rsa.pub"
      when: johndoe_ssh_key_management

    - name: Convert the user's SSH key to PPK format
      command: ssh-keygen -p -P "" -f "/home/{{ johndoe.name }}/.ssh/id_rsa"
      args:
        creates: "/home/{{ johndoe.name }}/.ssh/id_rsa.ppk"
      when: johndoe_ssh_key_management

    - name: Get or set the user's home directory
      get_user:
        name: "{{ johndoe.name }}"
      register: johndoe_home_directory

    - name: Create the user's .ssh directory
      file:
        path: "/home/{{ johndoe.name }}/.ssh"
        state: directory
        mode: 0700
        owner: "{{ johndoe.name }}"
        group: "{{ johndoe.group | default(omit) }}"

    - name: Deploy authorized keys for the user
      authorized_key:
        user: "{{ johndoe.name }}"
        key: "{{ item }}"
        state: present
      with_items: "{{ johndoe_authorized_keys }}"
      when: johndoe_authorized_keys is defined

    - name: Remove unauthorized keys for the user
      authorized_key:
        user: "{{ johndoe.name }}"
        key: "{{ item }}"
        state: absent
      with_items: "{{ johndoe_unauthorized_keys }}"
      when: johndoe_unauthorized_keys is defined

    - name: Copy the generated private SSH key for the user
      copy:
        src: "/home/{{ johndoe.name }}/.ssh/id_rsa"
        dest: "/home/{{ johndoe.name }}/.ssh/id_rsa"
        mode: 0400
        owner: "{{ johndoe.name }}"
        group: "{{ johndoe.group | default(omit) }}"
      when: johndoe_copy_private_key is defined

    - name: Check the user's password validity
      command: chage -n 0 "{{ johndoe.name }}"
      register: users_pw_valid
      changed_when: false
      ignore_errors: true
      when: johndoe_password_validity is defined

    - name: Set the user's password validity
      command: chage -d {{ johndoe_password_validity }} "{{ johndoe.name }}"
      when: johndoe_password_validity is defined and users_pw_valid.rc != 0

    - name: Place the private key file for the user
      copy:
        src: "/home/{{ johndoe.name }}/.ssh/id_rsa"
        dest: "/home/{{ johndoe.name }}/.ssh/id_rsa"
        mode: 0400
        owner: "{{ johndoe.name }}"
        group: "{{ johndoe.group | default(omit) }}"
      when: johndoe_private_keys is defined


