---
- name: Bootstrap
  hosts: all
  gather_facts: false

  tasks:
    - name: Execute a shell command to display the /etc/os-release file
      command: cat /etc/os-release
      register: bootstrap_facts
      changed_when: false
      become: false

    - name: Set Bootstrap Distribution Facts
      set_fact:
        bootstrap_distribution: "{{ item.split('=')[1] }}"
        bootstrap_distribution_major_version: "{{ item.split('=')[2] }}"
      loop: "{{ bootstrap_facts.stdout_lines }}"
      when:
        - bootstrap_facts.rc == 0
        - bootstrap_distribution is not defined
        - "'{{ item }}' is search('^NAME=\"{{ bootstrap_search[bootstrap_os_family] }}\"')"

    - name: Set Bootstrap OS Family Facts
      set_fact:
        bootstrap_os_family: "{{ item.key }}"
      loop: "{{ bootstrap_os_family_map | dict2items }}"
      when: " bootstrap_distribution is in item.value"
      become: false
