        dest: /etc/openvpn/server/{{ item }}
        remote_src: true
      loop:
        - ca.crt
        - dh.pem
        - ta.key
        - issued/server.crt
        - private/server.key
        - issued/client.crt
        - private/client.key

    - name: Copy files to the /etc/openvpn directory
      copy:
        src: /etc/openvpn/easy-rsa/pki/{{ item }}
        dest: /etc/openvpn/{{ item }}
        remote_src: true
      loop:
        - ca.crt
        - ta.key

    - name: Place the server.conf file
      template:
        src: server.conf.j2
        dest: /etc/openvpn/server.conf
        owner: root
        group: root
        mode: "0644"


