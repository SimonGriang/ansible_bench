---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install the mysql package
  package:
    name: mysql
    state: present

- name: Configure the mysql server
  template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: "{{ mysql_config_file }}"
    mode: 0644
    owner: root
    group: root
  notify: restart mysql
  with_dict: "{{ mysql_configuration_options }}"

- name: Configure the mysql client
  template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: "{{ mysql_config_file }}"
    mode: 0644
    owner: root
    group: root
  notify: restart mysql

- name: Initialize the mysql service
  command: "{{ mysql_initialize_command }}"
  when: ansible_os_family == "alpine" or ansible_os_family == "archlinux"

- name: Start and enable the mysql service
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers to ensure tasks are executed in the correct order
  meta: flush_handlers

- name: Create a my.cnf file in the /root/.my.cnf directory
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0644
    owner: root
    group: root

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  with_items: "{{ mysql_databases }}"

- name: List databases on the target machine
  mysql_info:

- name: Import databases
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
  with_items: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items: "{{ mysql_users }}"

- name: Flush handlers again to ensure tasks are executed in the correct order
  meta: flush_handlers


