---
- name: Configure postfix
  hosts: all
  tasks:
    - import_tasks: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Pre-configure Debian systems for postfix installation
      become: true
      when: ansible_os_family == "Debian"
      changed_when: false
      register: result
      ansible.builtin.debconf:
        name: "postfix"
        question: "postfix/mailer_type"
        value: "No configuration"
        vtype: "string"

    - name: Install postfix package
      become: true
      ansible.builtin.package:
        name: "postfix"
        state: "present"

    - name: Install postfix-mysql package if specific conditions are met
      become: true
      ansible.builtin.package:
        name: "postfix-mysql"
        state: "present"
      when:
        - postfix_virtual_mailbox_maps is defined and "mysql" in postfix_virtual_mailbox_maps
        - postfix_virtual_mailbox_domains is defined and "mysql" in postfix_virtual_mailbox_domains
        - postfix_virtual_alias_maps is defined and "mysql" in postfix_virtual_alias_maps

    - name: Configure postfix transport maps
      become: true
      ansible.builtin.template:
        src: "transport.j2"
        dest: "/etc/postfix/transport"
        mode: "0644"
        validate: "/usr/sbin/postconf -t -c %s"
      notify:
        - Validate configuration of postfix transport maps
        - Rebuild transport maps database

    - name: Configure postfix header checks
      become: true
      ansible.builtin.template:
        src: "header_checks.j2"
        dest: "/etc/postfix/header_checks"
        mode: "0644"
        validate: "/usr/sbin/postconf -t -c %s"
      notify:
        - Validate configuration of postfix header checks
        - reload postfix

    - name: Set values for the main.cf file
      become: true
      ansible.builtin.lineinfile:
        path: "/etc/postfix/main.cf"
        regexp: "^{{ item.key }} ="
        line: "{{ item.key }} = {{ item.value }}"
        state: "present"
        mode: "0644"
        backup: true
      loop: "{{ postfix_main_cf_values | dict2items }}"
      notify:
        - Validate configuration of postfix main.cf
        - restart postfix

    - name: Configure postfix master.cf
      become: true
      ansible.builtin.template:
        src: "master.cf.j2"
        dest: "/etc/postfix/master.cf"
        mode: "0644"
        validate: "/usr/sbin/postconf -t -c %s"
      notify:
        - Validate configuration of postfix master.cf
        - restart postfix

    - name: Create a directory for TLS certificates and keys
      become: true
      ansible.builtin.file:
        path: "{{ item }}"
        state: "directory"
        mode: "0750"
      loop:
        - "/etc/postfix/tls"
        - "/etc/postfix/tls/private"
        - "/etc/postfix/tls/certs"

    - name: Deploy Postfix TLS server certificate
      become: true
      ansible.builtin.copy:
        src: "{{ postfix_tls_server_cert }}"
        dest: "{{ postfix_tls_server_cert_file }}"
        mode: "0644"
        backup: true
      notify:
        - reload postfix

    - name: Deploy Postfix TLS server key
      become: true
      ansible.builtin.copy:
        src: "{{ postfix_tls_server_key }}"
        dest: "{{ postfix_tls_server_key_file }}"
        mode: "0644"
        backup: true
      notify:
        - reload postfix

    - name: Flush handlers
      ansible.builtin.meta: flush_handlers

    - name: Configure aliases
      become: true
      ansible.builtin.copy:
        content: "{{ postfix_aliases }}"
        dest: "/etc/aliases"
        backup: true
      notify:
        - Rebuild alias database
        - reload postfix

    - name: Configure sender_access
      become: true
      ansible.builtin.copy:
        content: "{{ postfix_sender_access }}"
        dest: "/etc/postfix/sender_access"
        backup: true
      notify:
        - Rebuild sender_access database
        - reload postfix

    - name: Configure recipient_access
      become: true
      ansible.builtin.copy:
        content: "{{ postfix_recipient_access }}"
        dest: "/etc/postfix/recipient_access"
        backup: true
      notify:
        - Validate configuration of postfix recipient_access
        - Rebuild recipient_access database
        - reload postfix

    - name: Place sasl_password_map
      become: true
      ansible.builtin.copy:
        dest: "{{ postfix_smtp_sasl_password_map }}"
        content: "{{ postfix_smtp_sasl_password_map_content }}"
        backup: true
      notify:
        - Rebuild sasl_password_map database

    - name: Flush handlers again
      ansible.builtin.meta: flush_handlers

    - name: Start and enable postfix service
      become: true
      ansible.builtin.service:
        name: "postfix"
        state: "started"
        enabled: true


