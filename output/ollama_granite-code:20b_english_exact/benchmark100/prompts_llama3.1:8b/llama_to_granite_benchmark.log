  hosts: all
  tasks:
    - name: Install package
      package:
        name: "{{ vault_package }}"
        state: present

- name: Reload daemon on changes
  hosts: all
  tasks:
    - name: Reload daemon
      meta: reload_daemon

- name: Restart vault service
  hosts: all
  tasks:
    - name: Restart vault service
      service:
        name: vault
        state: restarted


