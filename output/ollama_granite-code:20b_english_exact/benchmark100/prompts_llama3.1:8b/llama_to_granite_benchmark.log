on': 11461669665, 'model_name': 'granite-code:20b'} id='run--c2d635f6-9ee6-4a0c-ba95-89d93b582ad5-0' usage_metadata={'input_tokens': 1049, 'output_tokens': 494, 'total_tokens': 1543}
