---
- name: Task 1 - Enable Backports repository for Debian versions older than 9
  apt_repository:
    repo: "deb http://http.debian.net/debian {{ ansible_distribution_release }}-backports main contrib non-free"
    state: present
  when: ansible_distribution == "Debian" and ansible_distribution_version < "9"

- name: Task 2 - Set default_release option for older Debian versions
  apt:
    default_release: "{{ ansible_distribution_release }}-backports"
  when: ansible_distribution == "Debian" and ansible_distribution_version < "9"

- name: Task 3 - Install Ansible package with default release
  apt:
    name: ansible
    state: present
    default_release: "{{ ansible_distribution_release }}-backports"
  when: ansible_distribution == "Debian" and ansible_distribution_version < "9"


