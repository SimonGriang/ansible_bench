- name: "Update the package cache"
  apt:
    update_cache: yes
    cache_valid_time: 3600
  when: ansible_pkg_mgr == "apt"

- name: "Update the package cache"
  dnf:
    update_cache: yes
  when: ansible_pkg_mgr == "dnf"

- name: "Install keepalived package"
  package:
    name: keepalived
    state: present

- name: "Create /etc/keepalived directory"
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: 0755

- name: "Create Kubernetes API health check script for Debian-based systems"
  template:
    src: check_apiserver.sh.j2
    dest: /etc/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: 0755
  when: ansible_os_family == "Debian"

- name: "Create Kubernetes API health check script for RHEL-based systems"
  template:
    src: check_apiserver.sh.j2
    dest: /usr/libexec/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: 0755
  when: ansible_os_family == "RedHat"

- name: "Create RKE2 Server health check script for Debian-based systems"
  template:
    src: check_rke2server.sh.j2
    dest: /etc/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: 0755
  when: ansible_os_family == "Debian"

- name: "Create RKE2 Server health check script for RHEL-based systems"
  template:
    src: check_rke2server.sh.j2
    dest: /usr/libexec/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: 0755
  when: ansible_os_family == "RedHat"

- name: "Create keepalived configuration file"
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: 0644

- name: "Enable keepalived service"
  service:
    name: keepalived
    enabled: yes

- name: "Flush handlers to restart keepalived service"
  meta: flush_handlers


