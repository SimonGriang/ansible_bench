---

- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Uninstall systemd-logger package
  package:
    name: systemd-logger
    state: absent

- name: Install rsyslog and its required packages
  package:
    name: "{{ rsyslog_packages }}"
    state: present

- name: Install additional rsyslog features or packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features }}"

- name: Configure default rsyslog configuration
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: 0644
  notify: Restart rsyslog
  when: rsyslog_deploy_default_config

- name: Create /etc/rsyslog.d/ directory
  file:
    path: /etc/rsyslog.d/
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Configure forward rule for rsyslog
  template:
    src: forward_rule.conf.j2
    dest: /etc/rsyslog.d/30-forward.conf
    owner: root
    group: root
    mode: 0644
  notify: Restart rsyslog
  when: not rsyslog_deploy_default_config

- name: Configure additional rsyslog configuration files
  copy:
    content: "{{ item.content }}"
    dest: "{{ item.dest }}"
    owner: root
    group: root
    mode: 0440
  loop: "{{ rsyslog_rsyslog_d_files }}"
  notify: Restart rsyslog

- name: Start and enable rsyslog service
  service:
    name: rsyslog
    state: started
    enabled: true


