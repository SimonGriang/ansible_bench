---
- name: Create system directories for the HTTP server
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - path: /etc/httpd/conf/sites-enabled
      mode: 0755
      owner: root
      group: root
    - path: /etc/httpd/conf/sites-available
      mode: 0755
      owner: root
      group: root
    - path: /var/www
      mode: 0755
      owner: root
      group: root
    - path: /var/www/html
      mode: 0755
      owner: root
      group: root
    - path: /var/log/httpd
      mode: 0755
      owner: root
      group: root
    - path: /var/run/httpd
      mode: 0755
      owner: root
      group: root

- name: Configure directory configurations for HTTP server
  template:
    src: directory.conf.j2
    dest: /etc/httpd/conf/conf.d/{{ item.filename }}
    mode: "{{ item.mode }}"
  loop:
    - filename: directory1.conf
      mode: 0644
    - filename: directory2.conf
