---
- import_playbook: assert.yml

- name: Task 2 - Install logrotate package
  package:
    name: logrotate
    state: present

- name: Task 3 - Configure logrotate
  template:
    src: "{{ logrotate_config_file }}.j2"
    dest: /etc/logrotate.d/{{ logrotate_config_file }}
    mode: 0644

- name: Task 4 - Generate logrotate.d files
  template:
    src: entry.j2
    dest: /etc/logrotate.d/{{ item.name }}
    mode: 0644
    force: "{{ item. absent is not defined or not item.absent }}"
  loop: "{{ logrotate_entries }}"
  loop_control:
    label: "{{ item.name }}"

- name: Task 5 - Remove logrotate.d files
  file:
    path: /etc/logrotate.d/{{ item.name }}
    state: absent
  loop: "{{ logrotate_entries }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.absent is defined and item.absent

- name: Task 6 - Manage logrotate service
  service:
    name: "{{ logrotate_service_name }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service_name != ""


