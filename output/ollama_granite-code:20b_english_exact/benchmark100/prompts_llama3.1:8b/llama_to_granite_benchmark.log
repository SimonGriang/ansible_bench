---
- name: Create /etc/rancher/rke2 directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  command: >
    {{ rke2_bin_dir }}/rke2 server --set-node-taints="{{ rke2_server_node_taints }}"
  environment:
    RKE2_TOKEN: '{{ rke2_token }}'
  register: set_node_taints
  changed_when:
    - set_node_taints.stdout_lines | length > 0
    - set_node_taints.stdout_lines[0] != "Node taints updated successfully"
  when:
    - rke2_server_node_taints is defined
    - rke2_server_type == "server"

- name: Copy RKE2 config
  template:
    src: '{{ rke2_config }}'
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: '{{ rke2_custom_registry_path }}'
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed
  when:
    - rke2_custom_registry_mirrors | length > 0
    - rke2_custom_registry_configs | length > 0

- name: Register etcd restore from file
  set_fact:
    do_etcd_restore: true
  when:
    - rke2_etcd_snapshot_file | length > 0
    - rke2_services['rke2-server.service'] is not defined or rke2_services['rke2-server.service']['status'] == 'disabled'

- name: Register etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file | length > 0
    - rke2_etcd_snapshot_s3_options['access_key'] is defined
    - rke2_etcd_snapshot_s3_options['secret_key'] is defined
    - rke2_etcd_snapshot_s3_options['bucket'] is defined
    - rke2_etcd_snapshot_s3_options['snapshot_name'] is defined

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rke2/agent/etc/etcd/snapshots. young
        state: directory
        owner: root
        group: root
        mode: '0700'

    - name: Copy etcd snapshot backup file
      copy:
        src: '{{ rke2_etcd_snapshot_file }}'
        dest: /var/lib/rke2/agent/etc/etcd/snapshots/{{ rke2_etcd_snapshot_file | basename }}
        owner: root
        group: root
        mode: '0600'

    - name: Restore etcd from snapshot
      command: >
        {{ rke2_bin_dir }}/rke2 server --etcd-snapshot-restore
        {{ rke2_etcd_snapshot_file | basename }}
      environment:
        RKE2_TOKEN: '{{ rke2_token }}'
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Restore etcd from s3
      command: >
        {{ rke2_bin_dir }}/rke2 server --etcd-snapshot-s3-restore
        {{ rke2_etcd_snapshot_s3_options['access_key'] }}
        {{ rke2_etcd_snapshot_s3_options['secret_key'] }}
        {{ rke2_etcd_snapshot_s3_options['bucket'] }}
        {{ rke2_etcd_snapshot_s3_options['endpoint'] }}
        {{ rke2_etcd_snapshot_s3_options['region'] }}
        {{ rke2_etcd_snapshot_s3_options['snapshot_name'] }}
        {{ rke2_etcd_snapshot_s3_options['prefix'] }}
      environment:
        RKE2_TOKEN: '{{ rke2_token }}'
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  block:
    - name: Start RKE2 service
      service:
        name: rke2-server
        state: started
        enabled: true
        env:
          RKE2_TOKEN: '{{ rke2_token }}'
      notify: Service (re)started
  when: rke2_server_type == "server"

- name: Mask RKE2 agent service on the first server
  block:
    - name: Mask RKE2 agent service
      service:
        name: rke2-agent
        enabled: false
        state: stopped
  when: rke2_server_type == "server"

- name: Wait for the first server be ready - no CNI
  block:
    - name: Wait for the first server to be ready
      command: >
        kubectl get node {{ inventory_hostname }}
      environment:
        KUBECONFIG: '{{ rke2_kubeconfig_localhost }}'
      register: node_ready
      until:
        - node_ready.stdout_lines | length > 0
        - node_ready.stdout_lines[0] | regex_search('(?i)ready')
        - node_ready.stdout_lines[0] | regex_search('(?i)no cni')
      retries: 60
      delay: 10
  when: rke2_server_type == "server"

- name: Wait for the first server be ready - with CNI
  block:
    - name: Wait for the first server to be ready
      command: >
        kubectl get node {{ inventory_hostname }}
      environment:
        KUBECONFIG: '{{ rke2_kubeconfig_localhost }}'
      register: node_ready
      until:
        - node_ready.stdout_lines | length > 0
        - node_ready.stdout_lines[0] | regex_search('(?i)ready')
      retries: 60
      delay: 10
  when: rke2_server_type == "server"

- name: Restore etcd
  block:
    - name: Remove old secrets and nodes
      command: >
        kubectl --kubeconfig {{ rke2_kubeconfig_localhost }}
        delete secrets -n kube-system,kube-public
        {{ item }}-etcd-secret
        {{ item }}-controlplane
        {{ item }}-kube-apiserver
        {{ item }}-kube-controller-manager
        {{ item }}-kube-scheduler
      loop:
        - '{{ inventory_hostname}}'
      args:
        warn: false
      changed_when: false

    - name: Create new nodes
      command: >
        kubectl --kubeconfig {{ rke2_kubeconfig_localhost }}
        delete node {{ item }}
      loop:
        - '{{inventory_hostname}}'
      args:
        warn: false
      changed_when: false
  when: do_etcd_restore is defined

- name: Set an Active Server variable
  delegate_to: '{{ item }}'
  delegate_facts: true
  loop:
    - '{{groups[rke2_cluster_group_name]|list}}'
  run_once: true
  when: rke2_server_type == "server"


