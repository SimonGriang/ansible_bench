---
- name: Download RKE2 kubeconfig from master server to localhost
  fetch:
    src: /etc/kubernetes/admin.conf
    dest: "{{ playbook_dir }}/kubeconfig"
    flat: yes

- name: Replace loopback IP with master server IP in kubeconfig file
  replace:
    path: "{{ playbook_dir }}/kubeconfig"
    regexp: '127.0.0.1|([0:]+:){7}[0:]'
    replace: "{{ hostvars[groups['kubernetes-master'][0]].ansible_host }}"
    mode: 0600
    delegate_to: localhost
    become: false


