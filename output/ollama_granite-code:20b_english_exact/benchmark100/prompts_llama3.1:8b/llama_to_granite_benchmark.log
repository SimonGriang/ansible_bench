te-code:20b', 'created_at': '2025-10-24T00:14:05.601642067Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10892359475, 'load_duration': 38457975, 'prompt_eval_count': 657, 'prompt_eval_duration': 466962376, 'eval_count': 551, 'eval_duration': 10385632424, 'model_name': 'granite-code:20b'} id='run--c8d96ab5-8f6e-480e-b07b-1854ec002bca-0' usage_metadata={'input_tokens': 657, 'output_tokens': 551, 'total_tokens': 1208}
