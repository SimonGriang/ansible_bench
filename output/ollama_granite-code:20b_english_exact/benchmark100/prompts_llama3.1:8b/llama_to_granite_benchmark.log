---
- name: "Java installation"
  become: true
  block:
    - name: "Import Java asserts and setup local task execution"
      import_tasks: assert.yml
    - name: "Install Bash"
      package:
        name: bash
    - name: "Install OpenJDK Java (Package)"
      package:
        name: openjdk
        state: present
        env:
          USE: "X -cups -alsa -fontconfig"
      when:
        - java_vendor == "openjdk"
    - name: "Install RPM (Local Java Source)"
      block:
        - name: "Copy oracle java rpm package"
          copy:
            src: "{{ java_local_path }}"
            dest: /tmp
            mode: 0644
        - name: "Install oracle java rpm package"
          yum:
            name: /tmp/{{ java_rpm }}
            state: present
      when:
        - java_source == "local"
        - java_format == "rpm"
    - name: "Install DEB (Local Java Source)"
      block:
        - name: "Copy oracle java deb package"
          copy:
            src: "{{ java_local_path }}"
            dest: /tmp
            mode: 0644
        - name: "Install oracle java deb package"
          apt:
            deb: /tmp/{{ java_deb }}
            state: present
      when:
        - java_source == "local"
        - java_format == "deb"
    - name: "Install Oracle Java (RPM) (Repository)"
      package:
        name: oracle-java
        state: present
      when:
        - java_source == "repository"
        - java_format == "rpm"
    - name: "Configure Oracle Targz"
      block:
        - name: "Ensure java_install_directory exists"
          file:
            path: "{{ java_install_directory }}"
            state: directory
        - name: "Install oracle java targz package"
          unarchive:
            src: "{{ java_local_path }}"
            dest: "{{ java_install_directory }}"
            remote_src: true
      when:
        - java_format == "targz"
        - java_vendor == "oracle"
    - name: "Install Oracle Java Policy Software (Targz)"
      package:
        name: jce
        state: present
      when:
        - java_jce == true
        - java_version == 8
        - java_vendor == "oracle"
    - name: "Set Alternative (Targz)"
      block:
        - name: "Set java alternative"
          alternatives:
            name: java
            link: /usr/bin/java
            path: "{{ java_install_directory }}/java-{{ java_version }}-oracle/{{ java_vendor_path }}/bin/java"
      when:
        - java_format == "targz"
        - ansible_distribution != "Alpine"
        - java_vendor == "oracle"
    - name: "Find JAVA_HOME"
      shell: "readlink -f /usr/bin/java"
      register: java_home
    - name: "Set JAVA_HOME in /etc/environment"
      lineinfile:
        path: /etc/profile.d/java_home.sh
        line: "export JAVA_HOME={{ java_home.stdout }}"
        create: true


