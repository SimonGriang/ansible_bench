---
- name: Task 1 - Set the package state based on how Ansible is installed
  hosts: all
  tasks:
    - name: Set package state for Ansible based on installation method
      package:
        name: ansible
        state: "{{ 'present' if ansible_installation_method == 'package' else 'absent' }}"

- name: Task 2 - Set up Ansible on RedHat
  hosts: RedHat
  tasks:
    - name: Ensure required packages are installed for RedHat
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ ansible_redhat_dependencies }}"
    - name: Install Ansible
      package:
        name: ansible
        state: present

- name: Task 3 - Set up Ansible on Fedora
  hosts: Fedora
  tasks:
    - name: Ensure required packages are installed for Fedora
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ ansible_fedora_dependencies }}"
    - name: Install Ansible
      package:
        name: ansible
        state: present

- name: Task 4 - Set up Ansible on Ubuntu
  hosts: Ubuntu
  tasks:
    - name: Ensure required packages are installed for Ubuntu
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ ansible_ubuntu_dependencies }}"
    - name: Install Ansible
      apt:
        name: ansible
        state: present

- name: Task 5 - Set up Ansible on Debian
  hosts: Debian
  tasks:
    - name: Ensure required packages are installed for Debian
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ ansible_debian_dependencies }}"
    - name: Install Ansible
      apt:
        name: ansible
        state: present

- name: Task 6 - Set up Ansible using Pip
  hosts: all
  tasks:
    - name: Ensure pip is installed
      package:
        name: pip
        state: present
      when: ansible_installation_method == 'pip'
    - name: Install Ansible using pip
      pip:
        name: ansible
        state: present
      when: ansible_installation_method == 'pip'


