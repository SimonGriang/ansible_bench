---
- name: Create local ssh key directory for a user
  file:
    path: "/home/user/.ssh"
    state: directory
    mode: 0750
    owner: user
    group: user

- name: Manage the user account
  user:
    name: user
    comment: User Comment
    group: users
    create_home: true
    password: password
    password_lock: true
    state: present

- name: Set up the user's sudo options
  template:
    src: sudoers.j2
    dest: "/etc/sudoers.d/user"
    mode: 0440
    owner: root
    group: root
  when: user.sudo_options is defined

- name: Remove the sudo configuration file for the user
  file:
    path: "/etc/sudoers.d/user"
    state: absent
  when: user.sudo_options is not defined

- name: Generate the user's private SSH key
  command: "ssh-keygen -t rsa -b 4096 -f /home/user/.ssh/id_rsa -q -N ''"
  args:
    creates: "/home/user/.ssh/id_rsa"

- name: Generate the user's public SSH key
  command: "ssh-keygen -y -f /home/user/.ssh/id_rsa > /home/user/.ssh/id_rsa.pub"

- name: Convert the user's SSH key to PPK format
  command: "ssh-keygen -p -P '' -f /home/user/.ssh/id_rsa"

- name: Get or set the user's home directory
  get_user:
    name: user
  register: user_info

- name: Create the user's .ssh directory
  file:
    path: "/home/user/.ssh"
    state: directory
    mode: 0700
    owner: user
    group: user

- name: Deploy authorized keys for the user
  authorized_key:
    user: user
    key: "{{ item }}"
  with_items: "{{ user.authorized_keys }}"
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for the user
  authorized_key:
    user: user
    key: "{{ item }}"
    state: absent
  with_items: "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys is defined

- name: Copy the generated private SSH key for the user
  copy:
    src: "/home/user/.ssh/id_rsa"
    dest: "/home/user/.ssh/id_rsa"
    mode: 0400
  when: user.copy_private_key is defined

- name: Check the user's password validity
  command: "chage -n 0 user"
  register: users_pw_valid

- name: Set the user's password validity
  command: "chage -d 0 user"
  when: user.password_validity is defined and users_pw_valid.stdout == "0"

- name: Place the private key file for the user
  copy:
    src: "/home/user/.ssh/id_rsa"
    dest: "/home/user/.ssh/id_rsa"
    mode: 0400
  when: user.private_keys is defined


