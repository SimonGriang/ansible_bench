---
- name: git
  hosts: all
  tasks:
  - name: Import assert.yml role
    ansible.builtin.import_role:
      name: assert

  - name: Install git package
    ansible.builtin.package:
      name: "{{ git_packages }}"
      state: present

  - name: Check if a user exists
    ansible.builtin.shell: "getent passwd {{ git_username | default('', true) }}"
    register: user_exists
    failed_when: user_exists.rc > 1
    changed_when: false
    when: git_username is defined

  - name: Create a directory for git configuration
    ansible.builtin.file:
      path: "/home/{{ git_username }}"
      owner: "{{ git_username }}"
      group: "{{ git_groupname | default('', true) }}"
      state: directory
    when: user_exists.rc == 0 and git_username is defined

  - name: Configure git
    ansible.builtin.template:
      src: gitconfig.j2
      dest: "/home/{{ git_username }}/.gitconfig"
      mode: "0644"
    when: user_exists.rc == 0 and git_user_email is defined and git_user_name is defined and git_username is defined

  - name: Create the repository destination
    ansible.builtin.file:
      path: "{{ git_repository_destination }}"
      owner: "{{ git_username }}"
      group: "{{ git_groupname | default('', true) }}"
      state: directory
    when: user_exists.rc == 0 and git_username is defined

  - name: Clone all specified repositories
    ansible.builtin.git:
      repo: "{{ item.repo }}"
      dest: "{{ git_repository_destination }}/{{ item.dest | default(item.repo | urlsplit('path') | basename, true) }}"
      version: "{{ item.version | default('HEAD', true) }}"
      force: true
      become_user: "{{ git_username }}"
    with_items: "{{ git_repositories }}"
    when: user_exists.rc == 0 and git_repositories is defined and git_repository_destination is defined


