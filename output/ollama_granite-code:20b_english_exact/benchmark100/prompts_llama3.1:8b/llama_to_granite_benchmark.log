---
- name: Load OS-specific variables
  include_vars:
    file: "{{ item }}"
    name: os_specific_vars
  with_first_found:
    - ../vars/{{ ansible_os_family }}.yml
    - ../vars/main.yml

- name: Include setup tasks for RedHat-based systems
  include_tasks: RedHat.yml
  when: ansible_os_family == "RedHat"

- name: Include setup tasks for Debian-based systems
  include_tasks: Debian.yml
  when: ansible_os_family == "Debian"

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: present
  when:
    - not ansible_local.system.is_ ContainerBuilder
    - not (ansible_version.full | version_compare('2.12', '>=') and (ansible_os_family == "RedHat" or ansible_os_family == "Debian"))

- name: Install Docker packages (with downgrade option)
  package:
    name: "{{ docker_packages }}"
    state: present
    allow_downgrade: yes
  when:
    - ansible_local.system.is_ContainerBuilder
    - (ansible_version.full | version_compare('2.12', '>=') and (ansible_os_family == "RedHat" or ansible_os_family == "Debian"))

- name: Install docker-compose plugin
  shell: "ansible-playbook docker_compose.yml"
  when:
    - docker_install_compose | bool
    - not (ansible_version.full | version_compare('2.12', '>=') and (ansible_os_family == "RedHat" or ansible_os_family == "Debian"))

- name: Install docker-compose-plugin (with downgrade option)
  shell: "ansible-playbook docker_compose.yml"
  when:
    - docker_install_compose | bool
    - ansible_local.system.is_ContainerBuilder
    - (ansible_version.full | version_compare('2.12', '>=') and (ansible_os_family == "RedHat" or ansible_os_family == "Debian"))

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: 0755

- name: Configure Docker daemon options
  template:
    src: daemon.json.j2
    dest: /etc/docker/daemon.json
    mode: 0644
  notify: restart docker

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: started
    enabled: "{{ docker_service_enabled }}"

- name: Notify handlers to update firewall rules
  meta: flush_handlers

- name: Include tasks for managing docker-compose
  include_tasks: docker_compose.yml
  when: docker_install_compose | bool

- name: Get information about the docker group
  command: getent group docker
