content='---\n\n- name: Task 1\n  include_tasks: assert.yml\n\n- name: Task 2\n  package:\n    name: "{{ mysql_package }}"\n    state: present\n  notify: set root password, systemctl daemon-reexec\n\n- name: Task 3\n  ini_file:\n    dest: "{{ mysql_configuration_destination }}/server.cnf"\n    section: "{{ item.section }}"\n    option: "{{ item.option }}"\n    value: "{{ item.value }}"\n    mode: 0644\n    backup: yes\n  loop: "{{ mysql_configuration_options }}"\n  notify: restart mysql\n\n- name: Task 4\n  ini_file:\n    dest: "{{ mysql_configuration_destination }}/client.cnf"\n    section: client\n    option: socket\n    value: "{{ mysql_socket }}"\n    mode: 0644\n    backup: yes\n\n- name: Task 5\n  shell: "{{ mysql_initialize_command }}"\n  args:\n    warn: false\n  changed_when: false\n  when: mysql_platform == "Linux"\n\n- name: Task 6\n  service:\n    name: "{{ mysql_service }}"\n    state: started\n    enabled: yes\n\n- name: Task 7\n  meta: flush_handlers\n\n- name: Task 8\n  template:\n    src: my.cnf.j2\n    dest: /root/.my.cnf\n    mode: 0644\n\n- name: Task 9\n  mysql_db:\n    name: "{{ item.name }}"\n    state: present\n  no_log: yes\n  loop: "{{ mysql_databases }}"\n\n- name: Task 10\n  mysql_user:\n    name: "{{ item.name }}"\n    password: "{{ item.password }}"\n    priv: "{{ item.priv }}"\n    state: present\n  no_log: yes\n  loop: "{{ mysql_users }}"\n\n- name: Task 11\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-13T18:27:04.259090642Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8413439165, 'load_duration': 32844479, 'prompt_eval_count': 787, 'prompt_eval_duration': 502626703, 'eval_count': 415, 'eval_duration': 7876878818, 'model_name': 'granite-code:20b'} id='run--eccb0680-0cab-4b8c-ac24-7e2b8a98fadb-0' usage_metadata={'input_tokens': 787, 'output_tokens': 415, 'total_tokens': 1202}
