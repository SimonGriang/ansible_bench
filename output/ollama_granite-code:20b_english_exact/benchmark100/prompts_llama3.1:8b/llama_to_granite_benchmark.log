---
- name: Bootstrap Server
  tasks:
    - name: Gather basic system facts
      raw: "cat /etc/os-release"
      become: false
      register: bootstrap_facts
      changed_when: false

    - name: Set distribution name and major version
      set_fact:
        bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_findall(bootstrap_distribution_regex)[0] }}"
        bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_findall(bootstrap_distribution_major_version_regex)[0] }}"
      loop: "{{ bootstrap_facts.stdout_lines }}"
      loop_control:
        label: "{{ bootstrap_os_family_map | keys() | list }}"

    - name: Set operating system family
      set_fact:
        bootstrap_os_family: "{{ item.key }}"
      loop: "{{ bootstrap_os_family_map | dict2items }}"
      when: item.value == bootstrap_distribution

    - name: Set operating system family
      set_fact:
        bootstrap_os_family: "Other"
      when: bootstrap_distribution not in bootstrap_os_family_map



