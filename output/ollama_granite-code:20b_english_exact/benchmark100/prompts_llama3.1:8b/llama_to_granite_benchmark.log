---
- name: Pre-configure GRUB timeout, recordfail, and options
  hosts: all
  tasks:
    - import_playbook: assert.yml
    - name: Install packages required by GRUB
      package:
        name: "{{ grub_packages }}"
        state: present
    - name: Configure GRUB_TIMEOUT value
      lineinfile:
        path: /etc/default/grub
        line: "GRUB_TIMEOUT={{ grub_timeout }}"
        create: true
        mode: "0664"
      notify: Update grub
    - name: Configure GRUB_RECORDFAIL_TIMEOUT value
      lineinfile:
        path: /etc/default/grub
        line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
        create: true
        mode: "0664"
      notify: Update grub
    - name: Add options to GRUB_CMDLINE_LINUX
      replace:
        path: /etc/default/grub
        regexp: '^GRUB_CMDLINE_LINUX=.*$'
        replace: 'GRUB_CMDLINE_LINUX=" {{ grub_options | join(" ") }}"'
        mode: "0664"
      loop: "{{ grub_options }}"
      loop_control:
        label: "{{ grub_options }}"
      when: grub_options is defined and grub_options | length > 0
      notify: Update grub
    - import_playbook: password.yml
      when: grub_set_password
    - name: Flush handlers
      meta: flush_handlers
  handlers:
    - name: Update grub
      command: grub2-mkconfig -o /boot/grub2/grub.cfg


