---
- name: Create RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: 0755

- name: Set server taints
  command: >
    rke2 server taints --taints {{ rke2_server_node_taints }}
  changed_when: false

- name: Copy rke2 config
  copy:
    src: "{{ rke2_config_file_src }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: 0600

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_file_src }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: 0600
  when: rke2_kubelet_config != ""

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_config_file_src }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: 0600
  when: rke2_custom_registry_mirrors or rke2_custom_registry_configs

- name: Register if we need to do a etcd restore from file
  changed_when: false
  register: do_etcd_restore
  failed_when: false
  when:
    - rke2_etcd_snapshot_file is defined
    - rke2_etcd_snapshot_file != ""
    - rke2_etcd_snapshot_file | length > 0
  shell: |
    systemctl status --no-pager rke2-server.service | grep -q " Active: active (running)"
    if [ $? -eq 0 ]; then
      if [ -d /var/lib/rke2/agent/etc/kubernetes/manifests ]; then
        echo "false"
      else
        echo "true"
      fi
    else
      echo "false"
    fi
  args:
    executable: bash

- name: Register if we need to do a etcd restore from s3
  changed_when: false
  register: do_etcd_restore_from_s3
  failed_when: false
  when:
    - rke2_etcd_snapshot_s3_options.access_key is defined
    - rke2_etcd_snapshot_s3_options.secret_key is defined
    - rke2_etcd_snapshot_s3_options.bucket is defined
    - rke2_etcd_snapshot_s3_options.snapshot_name is defined
  shell: |
    if [ -d /var/lib/rke2/agent/etc/kubernetes/manifests ]; then
      echo "false"
    else
      echo "true"
    fi
  args:
    executable: bash

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rke2/agent/etc/kubernetes/snapshots
        state: directory
        owner: root
        group: root
        mode: 0755
    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file_src }}"
        dest: /var/lib/rke2/agent/etc/kubernetes/snapshots/snapshot.db
        owner: root
        group: root
        mode: 0600
    - name: Restore etcd from snapshot
      command: >
        rke2 server etcd-snapshot restore --name {{ inventory_hostname }} --config-file /etc/rancher/rke2/config.yaml
      changed_when: true
      register: rke2_restore_from_file_cmd_result
      until: not rke2_restore_from_file_cmd_result.failed
      retries: 3
      delay: 10
  when: do_etcd_restore.stdout == "true"

- name: Restore etcd from s3
  when: do_etcd_restore_from_s3.stdout == "true"
  block:
    - name: Restore etcd from s3
      command: >
        rke2 server etcd-snapshot restore --name {{ inventory_hostname }} --config-file /etc/rancher/rke2/config.yaml --s3 {{ rke2_etcd_snapshot_s3_options.access_key }}:{{ rke2_etcd_snapshot_s3_options.secret_key }}@s3-{{ rke2_etcd_snapshot_s3_options.bucket }}.amazonaws.com/{{ rke2_etcd_snapshot_s3_options.snapshot_name }}
      changed_when: true
      register: rke2_restore_from_s3_cmd_result
      until: not rke2_restore_from_s3_cmd_result.failed
      retries: 3
      delay: 10

- name: Start RKE2 service on first server
  service:
    name: rke2-server
    state: started
    enabled: true

- name: Mask RKE2 agent service on first server
  service:
    name: rke2-agent
    enabled: false

- name: Wait for first server be ready - no CNI
  when: not rke2_install_cni
  block:
    - name: Wait for server to be ready - no CNI
      command: >
        timeout -s KILL 20 rke2-server --config-file /etc/rancher/rke2/config.yaml --write-kubeconfig /etc/kubernetes/admin.conf
      register: rke2_server_cmd_result
      changed_when: true
      until: not rke2_server_cmd_result.failed
      retries: 3
      delay: 10

- name: Wait for first server be ready - with CNI
  when: rke2_install_cni
  block:
    - name: Wait for server to be ready - with CNI
      command: >
        timeout -s KILL 20 rke2-server --config-file /etc/rancher/rke2/config.yaml --write-kubeconfig /etc/kubernetes/admin.conf --install-cni
      register: rke2_server_cmd_result
      changed_when: true
      until: not rke2_server_cmd_result.failed
      retries: 3
      delay: 10

- name: Restore etcd
  when: do_etcd_restore.stdout == "true" or do_etcd_restore_from_s3.stdout == "true"
  block:
    - name: Remove old <node>.node-password.rke2 secrets
      delegate_to: "{{ item }}"
      delegate_facts: true
      with_items: "{{ groups[rke2_cluster_group_name] }}"
      run_once: true
      no_log: true
      ignore_errors: true
      shell: |
        if [ -f /etc/kubernetes/node-password.rke2 ]; then
          rm -f /etc/kubernetes/node-password.rke2
        fi
    - name: Remove old nodes and secrets
      command: >
        rke2 server --config-file /etc/rancher/rke2/config.yaml remove-node --name {{ inventory_hostname }}
      changed_when: true
      register: rke2_remove_node_cmd_result
      until: not rke2_remove_node_cmd_result.failed
      retries: 3
      delay: 10
      run_once: true
      no_log: true

- name: Set Active Server variable
  delegate_to: "{{ item }}"
  delegate_facts: true
  with_items: "{{ groups[rke2_cluster_group_name] }}"
  run_once: true
  no_log: true
  when: inventory_hostname == item
  set_fact:
    active_server: "{{ inventory_hostname }}"



