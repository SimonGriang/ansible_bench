---
- name: Task 1 - Import the assert.yml file
  ansible.builtin.import_tasks: assert.yml

- name: Task 2 - Install Apache HTTPD server
  ansible.builtin.package:
    name: httpd
    state: present

- name: Task 3 - Configure SELinux settings
  ansible.posix.selinux:
    policy: target
    state: disabled

- name: Task 4 - Configure the Apache HTTPD server using a template
  ansible.builtin.template:
    src: /etc/httpd/conf/httpd.conf
    dest: /etc/httpd/conf/httpd.conf
    mode: '0644'

- name: Task 6 - Import the SSL configuration tasks
  ansible.builtin.import_tasks: ssl.yml

- name: Task 7 - Import the location configuration tasks
  ansible.builtin.import_tasks: locations.yml

- name: Task 8 - Import the virtual host configuration tasks
  ansible.builtin.import_tasks: vhosts.yml

- name: Task 9 - Configure ports
  ansible.builtin.lineinfile:
    path: /etc/httpd/conf/httpd.conf
    regexp: "^Listen "
    line: "Listen {{ ports_http}}"

- name: Task 10 - Import the directory configuration tasks
  ansible.builtin.import_tasks: directories.yml

- name: Task 11 - Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Task 12 - Remove the default HTML file from the HTTPD server
  ansible.builtin.file:
    path: /var/www/html/index.html
    state: absent

- name: Task 13 - Start and enable the HTTPD server
  ansible.builtin.service:
    name: httpd
    state: started
    enabled: true


