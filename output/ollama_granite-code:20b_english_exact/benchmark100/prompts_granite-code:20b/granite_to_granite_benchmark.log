---
- import_tasks: assert.yml
- name: Task 2 - Install dns
  package:
    name: dns
    state: present
- name: Task 3 - Create directories
  file:
    path: /var/lib/named/{{ item.path }}
    owner: named
    group: named
    mode: "{{ item.mode }}"
    state: directory
  loop:
    - { path: 'data', mode: '0755' }
    - { path: 'dynamic', mode: '0755' }
    - { path: 'config', mode: '0750' }
- name: Task 4 - Create group
  group:
    name: named
    state: present
- name: Task 5 - Create user
  user:
    name: named
    group: named
    createhome: yes
- name: Task 6 - Generate rndc key
  command: rndc-confgen -a -c /etc/named/rndc.conf
- name: Task 7 - Set permissions on rndc key file
  file:
    path: /etc/named/rndc.key
    owner: named
    group: named
    mode: '0640'
- name: Task 8 - Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.cache
    dest: /var/lib/named/data/named.root
    mode: '0644'
- name: Task 9 - Create zone file
  template:
    src: zones.j2
    dest: /var/lib/named/data/{{ item.domain }}
    mode: '0644'
  loop: "{{ dns_zones }}"
- name: Task 10 - Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named/named.conf
    mode: '0644'
- name: Task 11 - Place systemd override
  template:
    src: systemd-override.j2
    dest: /etc/systemd/system/named.service.d/override.conf
    mode: '0644'
- name: Task 12 - Start and enable dns
  systemd:
    name: named
    state: started
    enabled: yes


