---
- name: Create ssl key
  openssl_privatekey:
    path: /etc/ssl/private/example.com.key

- name: Create ssl csr
  openssl_csr:
    path: /etc/ssl/csr/example.com.csr
    privatekey_path: /etc/ssl/private/example.com.key
    common_name: example.com

- name: Create ssl certificates
  openssl_certificate:
    path: /etc/ssl/certs/example.com.crt
    privatekey_path: /etc/ssl/private/example.com.key
    csr_path: /etc/ssl/csr/example.com.csr
    provider: selfsigned

- name: Create PKCS#12 file
  openssl_pkcs12:
    action: export
    path: /etc/ssl/certs/example.com.pfx
    privatekey_path: /etc/ssl/private/example.com.key
    certificate_path: /etc/ssl/certs/example.com.crt
    friendly_name: example.com

- name: Read private key
  openssl_privatekey:
    path: /etc/ssl/private/example.com.key
    state: stats

- name: Read certificate
  openssl_certificate:
    path: /etc/ssl/certs/example.com.crt
    state: stats

- name: Create combined private_key and certificate file
  copy:
    content: "{{ item.content }}"
    dest: "{{ item.dest }}"
  with_items:
    - content: "{{ lookup('file', '/etc/ssl/private/example.com.key') }}"
      dest: "/etc/ssl/combined/example.com.pem"
    - content: "{{ lookup('file', '/etc/ssl/certs/example.com.crt') }}"
      dest: "/etc/ssl/combined/example.com.pem"


