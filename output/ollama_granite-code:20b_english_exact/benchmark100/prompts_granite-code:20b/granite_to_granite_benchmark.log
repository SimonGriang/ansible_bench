---
- name: Lookup bootstrap facts
  ansible.builtin.setup:
    gather_subset: all
    fact_path: "{{ bootstrap_facts_dir }}"

- name: Set bootstrap facts (I)
  ansible.builtin.set_fact:
    ansible_ssh_private_key_file: "{{ item }}"
  loop: "{{ query('fileglob', '{{ bootstrap_facts_dir }}/*.pem') }}"

- name: Set bootstrap facts (II)
  ansible.builtin.set_fact:
    ansible_ssh_common_args: "-i {{ item }}"
  loop: "{{ query('fileglob', '{{ bootstrap_facts_dir }}/*.pem') }}"


