      until: not rke2_remove_node_cmd_result.failed
      retries: 3
      delay: 10
      run_once: true
      no_log: true

- name: Set Active Server variable
  delegate_to: "{{ item }}"
  delegate_facts: true
  with_items: "{{ groups[rke2_cluster_group_name] }}"
  run_once: true
  no_log: true
  when: inventory_hostname == item
  set_fact:
    active_server: "{{ inventory_hostname }}"



