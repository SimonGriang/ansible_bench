---

- name: Task 1
  import_tasks: assert.yml

- name: Task 2
  apt:
    name: "{{ item }}"
    state: present
  with_items:
    - apt-transport-https
    - ca-certificates
    - curl
    - software-properties-common
    - python-pip

- name: Task 3
  sysctl:
    name: net.ipv4.ip_forward
    value: '1'
    state: present
    reload: yes


