        dest: /etc/keepalived/rke2_server_health_check.sh
        mode: 0755
      when: ansible_os_family == "RedHat"

    - name: Create keepalived config file
      template:
        src: /path/to/keepalived.conf.j2
        dest: /etc/keepalived/keepalived.conf
