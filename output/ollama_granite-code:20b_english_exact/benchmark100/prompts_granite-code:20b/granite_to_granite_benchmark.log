        timeout -s KILL 20 rke2-server --config-file /etc/rancher/rke2/config.yaml --write-kubeconfig /etc/kubernetes/admin.conf --install-cni
      register: rke2_server_cmd_result
      changed_when: true
      until: not rke2_server_cmd_result.failed
      retries: 3
      delay: 10

