---
- name: Install required software
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ users_requirements }}"

- name: Loop over users_groups
  include: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ group.name }}"

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "@includedir {{ users_sudo_includedir }}"
    regexp: "^(@|#)includedir"
    state: present
    validate: visudo -cf %s
  when: users_sudo_includedir is defined

- name: Loop over users
  include: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ user.name }}"

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: "0644"
  when: users_cron_allow

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


