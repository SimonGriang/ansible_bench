  command: "{{ ssh_keygen_command }}"
  args:
    creates: "{{ user.home }}/.ssh/id_rsa"

- name: Generate public ssh key for {{ user.name }}
  command: "{{ ssh_keygen_pubkey_command }}"
  args:
    creates: "{{ user.home }}/.ssh/id_rsa.pub"

- name: Convert ssh key to ppk for {{ user.name }}
  command: "{{ ssh_keygen_pubkey_command }} -e -m ppk"
  args:
    creates: "{{ user.home }}/.ssh/id_rsa.ppk"

- name: Get or set the home directory for {{ user.name }}
  command: getent passwd {{ user.name }}
  changed_when: false
  register: ent

- name: Set the base home directory for {{ user.name }}
  set_fact:
    basehome: "{{ ent.stdout.split(':')[5] }}"

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ basehome }}/.ssh"
    state: directory
    mode: "0700"

- name: Deploy authorized keys for {{ user.name }}
  copy:
    content: "{{ item }}"
    dest: "{{ basehome }}/.ssh/authorized_keys"
    backup: yes
  with_items: "{{ user.authorized_keys }}"

- name: Remove unauthorized keys for {{ user.name }}
  lineinfile:
    path: "{{ basehome }}/.ssh/authorized_keys"
    state: absent
    regexp: "{{ item }}"
  with_items: "{{ user.unauthorized_keys }}"

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ user.home }}/.ssh/id_rsa"
    dest: "{{ item }}"
    backup: yes
  with_items: "{{ user.private_key_destination }}"

- name: Check users password valid time for {{ user.name }}
  shell: awk -F: '$1 ~ /{{ user.name }}/ {print $7}' /etc/shadow
  changed_when: false
  register: shadow

- name: Set users password valid time for {{ user.name }}
  shell: chage --lastday="{{ user.password_valid_time }}" {{ user.name }}
  when: shadow.stdout != ""

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ item }}"
    dest: "{{ basehome }}/.ssh/"
    backup: yes
  with_items: "{{ user.private_key_file }}"



