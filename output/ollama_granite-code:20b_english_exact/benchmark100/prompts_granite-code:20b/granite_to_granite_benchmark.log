---

- name: 'Ensure unzip package is available'
  package:
    name: 'unzip'
    state: 'present'

- name: 'Create promtail group'
  group:
    name: 'promtail'
    state: 'present'

- name: 'Create the promtail user'
  user:
    name: 'promtail'
    group: 'promtail'
    shell: '/usr/sbin/nologin'
    state: 'present'

- name: 'Ensure /usr/local/bin exists'
  file:
    path: '/usr/local/bin'
    state: 'directory'

- name: 'Create config directories'
  file:
    path: '/etc/ promtail/positions'
    state: 'directory'

- name: 'Create application dirs'
  file:
    path: '/opt/promtail/inactive'
    state: 'directory'

- name: 'Check promtail binary'
  stat:
    path: '/usr/local/bin/promtail'
  register: 'promtail_binary'

- name: 'Download promtail binaries'
  get_url:
    url: 'https://github.com/grafana/loki/releases/download/v2.3.0/promtail-linux-amd64.zip'
    dest: '/tmp/promtail.zip'
  when: not promtail_binary.stat.exists

- name: 'Propagate locally distributed promtail archive'
  copy:
    src: '/tmp/promtail.zip'
    dest: '/opt/promtail/inactive/promtail.zip'
    mode: '0644'
  when: not promtail_binary.stat.exists

- name: 'Download promtail binaries to controller node'
  get_url:
    url: 'https://github.com/grafana/loki/releases/download/v2.3.0/promtail-linux-amd64.zip'
    dest: '/tmp/promtail.zip'
  delegate_to: 'localhost'
  when: not promtail_binary.stat.exists

- name: 'Propagate promtail binaries'
  copy:
    src: '/tmp/promtail.zip'
    dest: '/opt/promtail/inactive/promtail.zip'
    mode: '0644'
  when: not promtail_binary.stat.exists

- name: 'Unpack promtail binaries'
  unarchive:
    src: '/opt/promtail/inactive/promtail.zip'
    dest: '/usr/local/bin'
    remote_src: 'true'
  when: not promtail_binary.stat.exists

- name: 'Create symlink to latest version'
  file:
    src: '/usr/local/bin/promtail-linux-amd64'
    dest: '/usr/local/bin/promtail'
    state: 'link'
  when: not promtail_binary.stat.exists

- name: 'Write config'
  template:
    src: 'promtail.yml.j2'
    dest: '/etc/promtail/promtail.yml'
    mode: '0644'

- name: 'Create systemd service unit'
  template:
    src: 'promtail.service.j2'
    dest: '/etc/systemd/system/promtail.service'
    mode: '0644'


