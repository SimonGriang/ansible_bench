---
- import_tasks: assert.yml
- name: Task 2 - Install Apache HTTPD server
  yum:
    name: httpd
    state: present
- name: Task 3 - Configure SELinux settings
  selinux:
    policy: target
    state: disabled
- name: Task 4 - Configure Apache HTTPD server using a template
  template:
    src: /etc/httpd/conf/httpd.conf
    dest: /etc/httpd/conf/httpd.conf
    mode: '0644'
- name: Task 5 - Activate HTTPD module on Debian systems
  command: /usr/sbin/apachectl -M
  when: ansible_os_family == "Debian"
- import_tasks: ssl.yml
- import_tasks: locations.yml
- import_tasks: vhosts.yml
- name: Task 9 - Configure ports
  lineinfile:
    path: /etc/httpd/conf/httpd.conf
    regexp: "^Listen "
    line: "Listen {{ ports_http }}"
- import_tasks: directories.yml
- name: Task 11 - Flush handlers
  meta: flush_handlers
- name: Task 12 - Remove default HTML file from HTTPD server
  file:
    path: /var/www/html/index.html
    state: absent
- name: Task 13 - Start and enable HTTPD server
  service:
    name: httpd
    state: started
    enabled: true


