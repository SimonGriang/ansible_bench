---
- name: Task 1
  import_tasks: assert.yml

- name: Task 2
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Task 3
  template:
    src: "{{ mysql_configuration_template }}"
    dest: "{{ mysql_configuration_destination }}"
    mode: 0644
    owner: root
    group: root
    validate: /usr/sbin/mysqld --verbose --help --wsrep-new-cluster --wsrep-cluster-name=%
  notify: restart mysql

- name: Task 4
  template:
    src: "{{ mysql_configuration_template }}"
    dest: "{{ mysql_configuration_destination }}"
    mode: 0644
    owner: root
    group: root
  notify: restart mysql

- name: Task 5
  shell: "mysqld --initialize-insecure --user=mysql"
  args:
    creates: "/var/lib/mysql/ib_buffer_pool"

- name: Task 6
  service:
    name: mysql
    state: started
    enabled: true

- name: Task 7
  meta: flush_handlers

- name: Task 8
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: 0600

- name: Task 9
  mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
  with_items: "{{ mysql_databases }}"

- name: Task 10
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: "{{ item.state }}"
  with_items: "{{ mysql_users }}"

- name: Task 11
  meta: flush_handlers


