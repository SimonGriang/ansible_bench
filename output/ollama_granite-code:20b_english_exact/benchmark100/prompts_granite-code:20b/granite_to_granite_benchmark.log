---
- import_tasks: assert.yml

- name: Task 2 - Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present
  tags: grub

- name: Task 3 - Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: "^GRUB_TIMEOUT="
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
  tags: grub

- name: Task 4 - Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: "^GRUB_RECORDFAIL_TIMEOUT="
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
  tags: grub

- name: Task 5 - Add options to GRUB_CMDLINE_LINUX
  replace:
    path: /etc/default/grub
    regexp: '(^GRUB_CMDLINE_LINUX=)(.*)$'
    replace: '\1"{{ \2 }} {{ grub_extra_options }}"'
  tags: grub

- import_tasks: password.yml
  when: grub_set_password
  tags: grub

- name: Task 7 - Flush handlers
  meta: flush_handlers


