---
- name: Create group vault
  group:
    name: vault
    state: present

- name: Create user vault
  user:
    name: vault
    group: vault
    home: /opt/vault
    state: present

- name: Create directory /opt/vault
  file:
    path: /opt/vault
    state: directory
    owner: vault
    group: vault
    mode: 0755

- name: Download Vault binary
  unarchive:
    src: https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_amd64.zip
    dest: /opt/vault
    remote_src: yes
    owner: vault
    group: vault
    mode: 0755

- name: Create directory /etc/vault.d
  file:
    path: /etc/vault.d
    state: directory
    owner: root
    group: vault
    mode: 0750

- name: Copy Vault binary
  copy:
    src: /opt/vault/vault
    dest: /usr/bin/vault
    owner: root
    group: root
    mode: 0755

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  capabilities:
    path: /usr/bin/vault
    capability: cap_ipc_lock=ep
    state: present

- name: Create file /etc/vault.d/vault.env
  copy:
    dest: /etc/vault.d/vault.env
    content: ""
    owner: root
    group: vault
    mode: 0640

- name: Create directory /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Copy Vault service file
  copy:
    src: vault.service
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: 0644

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: /etc/vault.d/vault.hcl
    owner: root
    group: vault
    mode: 0640

- name: Flush handlers
  meta: flush_handlers



