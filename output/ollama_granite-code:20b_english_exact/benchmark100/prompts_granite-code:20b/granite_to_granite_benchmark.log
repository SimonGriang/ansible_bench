, 'prompt_eval_duration': 811800379, 'eval_count': 1739, 'eval_duration': 37935072284, 'model_name': 'granite-code:20b'} id='run--ff82855c-64d3-4002-8451-1d26e96db4d4-0' usage_metadata={'input_tokens': 1113, 'output_tokens': 1739, 'total_tokens': 2852}
