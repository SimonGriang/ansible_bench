- name: Task 1 - Import assert.yml
  import_tasks: assert.yml

- name: Task 2 - Install python pip
  package:
    name: python-pip
    state: present

- name: Task 3 - Configure pip proxy
  ini_file:
    path: /etc/pip.conf
    section: global
    option: proxy
    value: "{{ http_proxy }}"
    state: present

- name: Task 4 - Trust hosts
  ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ https_proxy | urlsplit('hostname') }}"
    state: present

- name: Task 5 - Update pip.
  pip:
    name: pip
    state: latest

- name: Task 6 - Install requested modules
  pip:
    name: "{{ item }}"
    state: present
  loop:
    - docker
    - docker-compose


