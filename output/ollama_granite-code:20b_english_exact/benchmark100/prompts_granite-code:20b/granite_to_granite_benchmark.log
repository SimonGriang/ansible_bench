---
- name: Install apache httpd
  package:
    name: httpd
    state: present

- name: Configure selinux
  selinux:
    state: "{{ selinux_state | default('permissive') }}"
    policy: "{{ selinux_policy | default('targeted') }}"
    setype: "{{ selinux_type | default('http_port_t') }}"
  notify: Test httpd configuration validity
  when: selinux_role == 'httpd'

- name: Configure httpd
  template:
    src: httpd.conf.j2
    dest: /etc/httpd/conf/httpd.conf
  notify: Restart httpd
  when: httpd_template is defined

- name: Activate httpd module | Debian
  command: "apache2ctl -M {{ item }}"
  notify: Test httpd configuration validity
  with_items: "{{ httpd_modules }}"
  when: ansible_os_family == 'Debian' and httpd_modules is defined

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: ports.conf.j2
    dest: /etc/httpd/conf.d/ports.conf
  notify: Restart httpd
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: httpd
    state: started
    enabled: true


