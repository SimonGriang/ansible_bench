---
- name: Set fact java_jdk_vendor to temurin if java_jdk_vendor equals adoptopenjdk
  ansible.builtin.set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Include OS specific variables based on java_jdk_vendor, ansible_distribution, and ansible_distribution_major_version
  ansible.builtin.include_vars:
    file: "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
    name: java_jdk_os_specific_variables

- name: Include architecture specific variables
  ansible.builtin.include_vars:
    file: "{{ java_jdk_vendor }}-{{ ansible_architecture }}.yml"
    name: java_jdk_architecture_specific_variables

- name: Set OS specific variables (I)
  ansible.builtin.set_fact:
    java_open_jdk_os_specific_variables: "{{ java_jdk_os_specific_variables[java_jdk_vendor][ansible_distribution][ansible_distribution_major_version] }}"

- name: Set OS and architecture specific variables (II)
  ansible.builtin.set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_os_specific_variables['home_dir'] }}"
    java_open_jdk_version_major: "{{ java_open_jdk_os_specific_variables['version_major'] }}"
    java_open_jdk_version_minor: "{{ java_open_jdk_os_specific_variables['version_minor'] }}"
    java_open_jdk_version_patch: "{{ java_open_jdk_os_specific_variables['version_patch'] }}"
    java_open_jdk_version_build: "{{ java_open_jdk_os_specific_variables['version_build'] }}"
    java_open_jdk_package: "{{ java_open_jdk_os_specific_variables['package'] }}"
    java_open_jdk_url_base: "{{ java_open_jdk_os_specific_variables['url_base'] }}"
    java_open_jdk_checksum: "{{ java_open_jdk_os_specific_variables['checksum'] }}"

- name: Set specific variables
  ansible.builtin.set_fact:
    java_open_jdk_version: "{{ java_open_jdk_version_major }}u{{ java_open_jdk_version_minor }}-b{{ java_open_jdk_version_build }}"
    java_open_jdk_download_url: "{{ java_open_jdk_url_base }}{{ java_open_jdk_version }}{{ java_open_jdk_package }}"

- name: Add pre-requisites for Debian if ansible_os_family equals Debian
  ansible.builtin.apt:
    name: "{{ java_open_jdk_os_specific_variables['apt_update_packages'] }}"
    state: present
    update_cache: true
    cache_valid_time: 600
  when:
    - ansible_os_family == "Debian"

- name: Add pre-requisites for RedHat if ansible_os_family equals RedHat
  ansible.builtin.yum:
    name: "{{ java_open_jdk_os_specific_variables['yum_update_packages'] }}"
    state: present
  when:
    - ansible_os_family == "RedHat"

- name: Install required libs
  ansible.builtin.package:
    name: "{{ java_open_jdk_os_specific_variables['required_libs'] }}"
    state: present

- name: Install Java, Debian if ansible_os_family equals Debian
  ansible.builtin.apt:
    deb: "{{ java_open_jdk_download_url }}"
    state: present
  when:
    - ansible_os_family == "Debian"

- name: Install Java, RedHat if ansible_os_family equals RedHat
  ansible.builtin.get_url:
    url: "{{ java_open_jdk_download_url }}"
    dest: /tmp
    mode: 0444
  when:
    - ansible_os_family == "RedHat"

- name: Export environment variables
  ansible.builtin.export:
    name: JAVA_HOME
    value: /usr/lib/jvm/{{ java_open_jdk_home_dir }}
  when:
    - ansible_os_family == "Debian"

- name: Source environment variables
  ansible.builtin.shell:
    cmd: . /etc/environment
    executable: /bin/bash
  when:
    - ansible_os_family == "Debian"

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11 if ansible_os_family equals Debian and java_open_jdk_version_major is less than 11
  ansible.builtin.alternatives:
    name: java
    path: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
  when:
    - ansible_os_family == "Debian"
    - java_open_jdk_version_major is version('11', '<')

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11 if ansible_os_family equals Debian and java_open_jdk_version_major is greater than or equal to 11
  ansible.builtin.alternatives:
    name: java
    path: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java
  when:
    - ansible_os_family == "Debian"
    - java_open_jdk_version_major is version('11', '>=')


