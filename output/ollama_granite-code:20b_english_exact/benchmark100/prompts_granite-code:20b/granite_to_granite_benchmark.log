---

- name: "Ensure apt key is not present in trusted.gpg.d"
  apt_key:
    id: "{{ item }}"
    state: absent
  with_items:
    - 0EBFCD88
    - 6084F728
    - 24FF569C
    - 6A030B0183B943640AC8653F73C700D82195766C
  tags:
    - apt
    - docker

- name: "Ensure old apt source list is not present in /etc/apt/sources.list.d"
  file:
    path: "/etc/apt/sources.list.d/{{ item }}"
    state: absent
  with_items:
    - docker.list
    - docker-engine.list
    - docker.io.list
  tags:
    - apt
    - docker

- name: "Ensure old versions of Docker are not installed"
  apt:
    name: docker
    state: absent
    purge: yes
  tags:
    - apt
    - docker

- name: "Ensure legacy repo file is not present"
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent
  tags:
    - apt
    - docker

- name: "Ensure dependencies are installed"
  apt:
    name: "{{ item }}"
    state: present
  with_items:
    - apt-transport-https
    - ca-certificates
    - curl
    - software-properties-common
    - python3-pip
    - python3-setuptools
  tags:
    - apt
    - docker

- name: "Add or remove Docker repository"
  apt_repository:
    filename: docker
    repo: "deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_distribution_release }} stable"
    state: present
    update_cache: yes
  tags:
    - apt
    - docker

- name: "Ensure handlers are notified immediately to update the apt cache"
  meta: flush_handlers
  tags:
    - apt
    - docker


