---
- name: Install and configure fail2ban
  hosts: all
  tasks:
    - name: Install fail2ban
      package:
        name: fail2ban
        state: present

    - name: Copy filters in filter.d
      copy:
        src: "{{ item }}"
        dest: /etc/fail2ban/filter.d
        owner: root
        group: root
        mode: "0640"
      with_fileglob:
        - /tmp/filter.d/*

    - name: Configure fail2ban.local
      ini_file:
        path: /etc/fail2ban/fail2ban.local
        section: "{{ item.section }}"
        option: "{{ item.option }}"
        value: "{{ item.value }}"
        mode: "0640"
        owner: root
        group: root
      with_items:
        - section: Definition
          option: loglevel
          value: INFO
        - section: Definition
          option: logtarget
          value: /var/log/fail2ban.log

    - name: Configure jail.local
      ini_file:
        path: /etc/fail2ban/jail.local
        section: "{{ item.section }}"
        option: "{{ item.option }}"
        value: "{{ item.value }}"
        mode: "0640"
        owner: root
        group: root
      with_items:
        - section: DEFAULT
          option: bantime
          value: 86400
        - section: DEFAULT
          option: findtime
          value: 1800
        - section: DEFAULT
          option: maxretry
          value: 3

    - name: Stat auth log file
      stat:
        path: /var/log/auth.log
      register: auth_log_file

    - name: Touch auth log file
      file:
        path: /var/log/auth.log
        state: touch
        owner: root
        group: root
        mode: "0640"
      when: not auth_log_file.stat.exists

    - name: Start and enable fail2ban
      service:
        name: fail2ban
        state: started
        enabled: true


