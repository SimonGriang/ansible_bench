---
- name: Ensure /etc/openvpn/easy-rsa exists
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: "0755"

- name: Initialize PKI of easyrsa
  ansible.builtin.shell: easyrsa init-pki

- name: Build CA for easyrsa
  ansible.builtin.shell: easyrsa build-ca

- name: Generate DH parameters
  ansible.builtin.shell: easyrsa gen-dh

- name: Build server key and certificate
  ansible.builtin.shell: easyrsa build-server-full server nopass

- name: Build client key and certificate
  ansible.builtin.shell: easyrsa build-client-full client nopass

- name: Generate certificate revocation list
  ansible.builtin.shell: easyrsa gen-crl

- name: Generate openvpn key
  ansible.builtin.shell: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy ca.crt, dh.pem, ta.key, issued/client.crt, issued/server.crt, private/ca.key, private/client.key, private/server.key to /etc/openvpn/server
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/openvpn/server
    mode: "0644"
  loop:
    - ca.crt
    - dh.pem
    - ta.key
    - issued/client.crt
    - issued/server.crt
    - private/ca.key
    - private/client.key
    - private/server.key

- name: Copy ca.crt, ta.key to /etc/openvpn
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/openvpn
    mode: "0644"
  loop:
    - ca.crt
    - ta.key

- name: Place server.conf from server.conf.j2 to /etc/openvpn/server.conf
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: "0644"


