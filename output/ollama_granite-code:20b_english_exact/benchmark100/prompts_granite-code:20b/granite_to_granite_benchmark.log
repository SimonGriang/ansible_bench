  ansible.builtin.apt:
    name: bash
    state: present

- name: Install openjdk java (package)
  ansible.builtin.apt:
    name: openjdk-11-jdk
    state: present

- name: Install RPM
  ansible.builtin.apt:
    name: rpm
    state: present

- name: Install DEB
  ansible.builtin.apt:
    name: deb
    state: present

- name: Install oracle java (rpm) (repository)
  ansible.builtin.yum:
    name: java-1.8.0-oracle
    state: present

- name: Configure oracle targz
  ansible.builtin.unarchive:
    src: /path/to/oracle-java.tar.gz
    dest: /opt/
    remote_src: yes

- name: Install oracle java policy software (targz)
  ansible.builtin.unarchive:
    src: /path/to/policy-java.tar.gz
    dest: /opt/
    remote_src: yes

- name: Set alternative (targz)
  ansible.builtin.alternatives:
    name: java
    link: /usr/bin/java
    path: /opt/java/bin/java

- name: Find JAVA_HOME
  ansible.builtin.command:
    cmd: update-alternatives --get-selections | grep java
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  ansible.builtin.lineinfile:
    path: /etc/environment
    line: 'JAVA_HOME="{{ java_home_result.stdout.split()[1] }}"'


