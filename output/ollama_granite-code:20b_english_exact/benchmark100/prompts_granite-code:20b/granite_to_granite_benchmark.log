        path: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
      when: install_script_stat.stat.mode != "0700"
    - fail:
        msg: "Install script is not executable."
      when: install_script_stat.stat.executable == false

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: local_stat

- name: Check if separate partition
  set_fact:
    separate_partition: "{{ local_stat.stat.dev != '/dev/mapper/vg--vg-root' }}"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin/rke2"
  when: not separate_partition

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/opt/rke2/bin/rke2"
  when: separate_partition

- name: Check RKE2 version
  command: "{{ rke2_bin_path }} version"
  changed_when: false
  register: rke2_current

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_current.stdout is version(rke2_version, '>=')
    msg: "RKE2 is already at or newer than the requested version {{ rke2_version }}."

- name: Run RKE2 install script
  become: true
  shell: |
    if [ -n "{{ airgap_mode_extra_vars }}" ]; then
      export {{ airgap_mode_extra_vars }}
    fi
    curl -sfL {{ rke2_install_bash_url }} | sh -s -- {{ rke2_install_script_args }}
  args:
    warn: false
    executable: bash
  register: rke2_install_script

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_custom_manifests }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_static_pods }}"

- name: Copy RKE2 environment file
  template:
    src: rke2_environment.j2
    dest: /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: 0644


