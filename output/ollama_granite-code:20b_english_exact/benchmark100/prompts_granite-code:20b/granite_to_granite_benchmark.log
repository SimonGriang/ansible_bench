---

- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ git_username }}"

- name: Create directory for git configuration
  ansible.builtin.file:
    path: "~{{ git_username }}/{{ git_homedir_subfolder }}/git-config"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: "0755"

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "~{{ git_username }}/{{ git_homedir_subfolder }}/git-config/gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: "0755"

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ item.value.repo }}"
    dest: "{{ git_repository_destination }}/{{ item.key }}"
    version: "{{ item.value.version }}"
    update: "{{ item.value.update | default(omit) }}"
    force: "{{ item.value.force | default(omit) }}"
    executable: "{{ item.value.executable | default(omit) }}"
    become_user: "{{ git_username }}"
  with_dict: "{{ git_repositories }}"


