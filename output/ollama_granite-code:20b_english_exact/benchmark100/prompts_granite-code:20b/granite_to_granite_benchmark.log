content='```yaml\n---\n- name: Install and configure fail2ban\n  hosts: all\n  tasks:\n    - name: Install fail2ban\n      package:\n        name: fail2ban\n        state: present\n\n    - name: Copy filters in filter.d\n      copy:\n        src: "{{ item }}"\n        dest: /etc/fail2ban/filter.d\n        owner: root\n        group: root\n        mode: 0640\n      with_fileglob:\n        - /tmp/filter.d/*\n\n    - name: Configure fail2ban.local\n      ini_file:\n        path: /etc/fail2ban/fail2ban.local\n        section: "{{ item.section }}"\n        option: "{{ item.option }}"\n        value: "{{ item.value }}"\n        mode: 0640\n        owner: root\n        group: root\n      with_items:\n        - section:Definition\n          option: loglevel\n          value: INFO\n        - section:Definition\n          option: logtarget\n          value: /var/log/fail2ban.log\n\n    - name: Configure jail.local\n      ini_file:\n        path: /etc/fail2ban/jail.local\n        section: "{{ item.section }}"\n        option: "{{ item.option }}"\n        value: "{{ item.value }}"\n        mode: 0640\n        owner: root\n        group: root\n      with_items:\n        - section:DEFAULT\n          option: bantime\n          value: 86400\n        - section:DEFAULT\n          option: findtime\n          value: 1800\n        - section:DEFAULT\n          option: maxretry\n          value: 3\n\n    - name: Stat auth log file\n      stat:\n        path: /var/log/auth.log\n      register: auth_log_file\n\n    - name: Touch auth log file\n      file:\n        path: /var/log/auth.log\n        state: touch\n        owner: root\n        group: root\n        mode: 0640\n      when: not auth_log_file.stat.exists\n\n    - name: Start and enable fail2ban\n      service:\n        name: fail2ban\n        state: started\n        enabled: true\n```' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-23T00:50:04.272535657Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8448128399, 'load_duration': 36803078, 'prompt_eval_count': 544, 'prompt_eval_duration': 393357975, 'eval_count': 459, 'eval_duration': 8016754729, 'model_name': 'granite-code:20b'} id='run--2595ae39-e7f5-4dc6-bfc6-96268ed5a6a8-0' usage_metadata={'input_tokens': 544, 'output_tokens': 459, 'total_tokens': 1003}
