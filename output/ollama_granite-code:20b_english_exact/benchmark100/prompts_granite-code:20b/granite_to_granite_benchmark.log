---
- import_tasks: assert.yml
- name: "Task 1: Pre-configure debian systems"
  apt:
    name: "{{ item }}"
    state: present
  loop:
  - PolicyKit1
  - libsasl2-modules-mysql
  - python3-mysqldb
- name: "Task 2: Install postfix"
  apt:
    name: "{{ item }}"
    state: present
  loop:
  - postfix
  - postfix-mysql
- name: "Task 3: Configure postfix (transport_maps)"
  copy:
    content: ""
    dest: /etc/postfix/transport_maps
    force: false
    group: root
    mode: 0644
    owner: root
    setype: etc_t
    src: /etc/postfix/transport_maps
- name: "Task 4: Configure postfix (header_checks)"
  copy:
    content: ""
    dest: /etc/postfix/header_checks
    force: false
    group: root
    mode: 0644
    owner: root
    setype: etc_t
    src: /etc/postfix/header_checks
- name: "Task 5: Setting values for main.cf (1/2)"
  lineinfile:
    dest: /etc/postfix/main.cf
    insertafter: "#mydestination"
    line: "relayhost = [smtp.example.com]"
    state: present
- name: "Task 6: Configure postfix (main.cf)"
  lineinfile:
    dest: /etc/postfix/main.cf
    insertafter: "relayhost = [smtp.example.com]"
    line: "smtp_generic_maps = hash:/etc/postfix/generic"
    state: present
- name: "Task 7: Deploy Postfix TLS server certificate"
  copy:
    dest: /etc/postfix/cert/server.pem
    group: root
    mode: 0644
    owner: root
    setype: etc_t
    src: /etc/postfix/cert/server.pem
- name: "Task 8: Deploy Postfix TLS server key"
  copy:
    dest: /etc/postfix/private/server.key
    group: root
    mode: 0640
    owner: root
    setype: etc_t
    src: /etc/postfix/private/server.key
- name: "Task 9: Flush handlers"
  meta: flush_handlers
- name: "Task 10: Start and enable postfix"
  service:
    name: postfix
    state: started
    enabled: true


