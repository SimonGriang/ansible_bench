---
- name: Configure apk
  apk:
    name: "{{ item }}"
    state: present
  with_items:
    - assert-apk

- name: Configure apk
  apk:
    update_cache: yes

- name: Configure apk
  apk:
    name: "*"
    update_cache: yes
    upgrade: yes

- name: Configure apt
  apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
    upgrade: no
  with_items:
    - assert-apt
    - apt-transport-https

- name: Configure apt
  apt:
    upgrade: dist

- name: Configure apt
  apt:
    autoremove: yes

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes

- name: Configure yum
  yum:
    name: '*'
    state: latest
  when: ansible_distribution_major_version == "6"

- name: Configure yum
  yum:
    name: '*'
    state: latest
    exclude: kernel,kernel-headers
  when: ansible_distribution_major_version != "6"

- name: Configure yum
  yum:
    name: yum-utils
    state: present

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest


