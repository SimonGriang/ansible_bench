---

- import_tasks: assert.yml

- name: Task 2 - Install php
  package:
    name: "{{ php_packages }}"
    state: present

- name: Task 3 - Find used php.ini
  shell: "{{ php_ini_command }}"
  register: php_found_ini_location

- name: Task 4 - Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
    mode: 0644
  notify: Restart httpd
  when: php_changed | default(false)


