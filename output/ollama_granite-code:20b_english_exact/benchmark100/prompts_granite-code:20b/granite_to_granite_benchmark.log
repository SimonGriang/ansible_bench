  hosts: localhost
  connection: local
  vars:
    ansible_python_interpreter: /usr/bin/python3
  tasks:
    - name: Install Keepalived
      ansible.builtin.apt:
        name: keepalived
        state: present
      when: ha_mode is enabled
    - name: Download and install RKE2
      ansible.builtin.get_url:
        url: https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2.yaml
        dest: /var/lib/rke2/rke2.yaml
      when: ha_mode is not enabled
    - name: Apply CIS Benchmark hardening
      ansible.builtin.command: bash /var/lib/rke2/scripts/cis-hardening.sh
      when: cis_benchmark_hardening is enabled
    - name: Find Active Server
      ansible.builtin.shell: |
        # Your shell command here
      register: active_server
    - name: Enable IPVS kernel module
      ansible.builtin.shell: |
        # Your shell command here
      when: kube_vip_load_balancer is enabled
    - name: Copy kube-vip manifests
      ansible.builtin.copy:
        src: /path/to/kube-vip-manifests
        dest: /etc/kubernetes/manifests
      when: kube_vip_load_balancer is enabled
    - name: Copy ingress-nginx manifests
      ansible.builtin.copy:
        src: /path/to/ingress-nginx-manifests
        dest: /etc/kubernetes/manifests
    - name: Prepare very first server node
      ansible.builtin.shell: |
        # Your shell command here
      when: first_server is enabled
    - name: Restore etcd specific tasks
      ansible.builtin.shell: |
        # Your shell command here
      when: restore_etcd is enabled
    - name: Download kubeconfig
      ansible.builtin.shell: |
        # Your shell command here
    - name: Prepare and join remaining nodes
      ansible.builtin.shell: |
        # Your shell command here
    - name: Rolling cordon and drain restart - servers
      ansible.builtin.shell: |
        # Your shell command here
      when: version_changed is enabled
    - name: Rolling cordon and drain restart - agents
      ansible.builtin.shell: |
        # Your shell command here
      when: version_changed is enabled
    - name: Flush handlers
      ansible.builtin.meta: flush_handlers
    - name: Rolling restart when config files change
      ansible.builtin.shell: |
        # Your shell command here
      when: config_files_changed is enabled
    - name: Final steps
      ansible.builtin.debug:
        msg: |
          Playbook execution completed successfully.
          - Number of servers: {{ groups['servers'] | length }}
          - Number of agents: {{ groups['agents'] | length }}
          - RKE2 version: {{ rke2_version }}



