---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/bin/python3.11
  register: python311_managed_binary

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  command: mv /usr/bin/python3.11 /usr/bin/python3.11_OLD
  args:
    warn: false
  when: python311_managed_binary.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/bin/python3.12
  register: python312_managed_binary

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  command: mv /usr/bin/python3.12 /usr/bin/python3.12_OLD
  args:
    warn: false
  when: python312_managed_binary.stat.exists

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install python pip
  package:
    name: python-pip
    state: present

- name: Configure pip proxy
  command: pip config set proxy {{ http_proxy }}

- name: Trust hosts
  command: pip trust hosts

- name: Update pip.
  command: pip install --upgrade pip

- name: Install requested modules
  pip:
    name: "{{ item }}"
    state: present
  loop:
    - docker
    - requests


