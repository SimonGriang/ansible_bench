---
- name: password | Get efi path
  stat:
    path: /boot/efi
  register: efi_path

- name: password | Remove unwanted grub.cfg on EFI systems
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_path.stat.exists

- name: password | Install user template
  template:
    src: user.conf.j2
    dest: /etc/user.conf

- name: password | EFI | add password
  lineinfile:
    path: /boot/efi/EFI/refind/refind.conf
    line: "password={{ lookup('file', '/etc/shadow') | regex_findall('^{{ item }}:')[0].split(':')[1] }}"
  with_items:
    - root
    - home

- name: password | MBR | add password
  lineinfile:
    path: /boot/grub2/grub.cfg
    line: "password={{ lookup('file', '/etc/shadow') | regex_findall('^{{ item }}:')[0].split(':')[1] }}"
  with_items:
    - root
    - home
  when: efi_path.stat.exists == false

- name: password | Add --unrestricted
  replace:
    path: /etc/pam.d/common-auth
    regexp: 'password.*pam_succeed_if.so'
    replace: 'password sufficient pam_succeed_if.so user notingroup unreserved'


