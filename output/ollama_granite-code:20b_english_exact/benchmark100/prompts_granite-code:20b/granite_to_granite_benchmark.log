---
- name: Download RKE2 kubeconfig to localhost
  become: false
  run_once: true
  when:
    - rke2_download_kubeconf
    - inventory_hostname == groups[rke2_servers_group_name][0]
  delegate_to: localhost
  block:
    - name: Create kubeconfig directory
      file:
        path: "{{ rke2_download_kubeconf_path }}"
        state: directory
        mode: "0755"

    - name: Download kubeconfig file
      get_url:
        url: "{{ rke2_api_url }}/kubeconfig/plane"
        dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
        mode: "0644"
        force: true
        flat: yes

- name: Replace loopback IP by master server IP
  become: false
  run_once: true
  when:
    - not ansible_check_mode
    - rke2_download_kubeconf
    - inventory_hostname == groups[rke2_servers_group_name][0]
  delegate_to: localhost
  block:
    - name: Replace loopback IP by master server IP
      replace:
        path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
        regexp: '127\.0\.0\.1|\[::1\]'
        replace: "{{ rke2_api_ip | default(groups[rke2_servers_group_name][0]) }}"


