---
- name: Task 1 - Install mysql
  apt:
    name: mysql-server
    state: present

- name: Task 2 - Configure mysql server
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf

- name: Task 3 - Configure mysql client
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf

- name: Task 4 - Initialize mysql
  shell: mysqld --initialize-insecure --user=mysql
  args:
    creates: /var/lib/mysql/ib_buffer_pool

- name: Task 5 - Start and enable mysql
  systemd:
    name: mysql
    state: started
    enabled: yes

- name: Task 6 - Flush handlers
  meta: flush_handlers

- name: Task 7 - Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf

- name: Task 8 - Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  with_items:
    - wordpress

- name: Task 9 - List databases
  mysql_db:
    name: "{{ item }}"
    state: present
  with_items:
    - wordpress

- name: Task 10 - Import database
  mysql_db:
    name: wordpress
    state: import
    target: /tmp/wordpress.sql

- name: Task 11 - Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items:
    - name: wordpress
      password: password
      priv: "wordpress.*:ALL"

- name: Task 12 - Flush handlers again
  meta: flush_handlers
