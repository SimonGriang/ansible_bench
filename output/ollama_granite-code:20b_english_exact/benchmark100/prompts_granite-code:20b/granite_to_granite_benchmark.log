---
- name: Check if certificates exists
  stat:
    path: "{{ java_cert_truststore_location }}{{ java_cert_truststore_filename }}"
  register: java_cert_truststore_file_stat

- name: Fail if some cert doesn't exist
  fail:
    msg: "Java Cert Truststore is missing! Expected at: {{ java_cert_truststore_location }}{{ java_cert_truststore_filename }}"
  when: not java_cert_truststore_file_stat.stat.exists

- name: Setting keystore variables in java < 11
  set_fact:
    java_cert_keystore_location: "{{ java_cert_truststore_location }}"
    java_cert_keystore_filename: "{{ java_cert_truststore_filename }}"
  when: java_cert_java_version.stdout | version_compare('11', '<')

- name: Setting keystore variables in java >= 11
  set_fact:
    java_cert_keystore_location: "{{ java_cert_truststore_location }}"
    java_cert_keystore_filename: "{{ java_cert_truststore_filename }}"
  when: java_cert_java_version.stdout | version_compare('11', '>=')

- name: Import SSL certificates
  java_cert:
    cert_path: "{{ java_cert_truststore_location }}{{ java_cert_truststore_filename }}"
    name: "{{ item.name }}"
    executable: "{{ java_cert_import_executable }}"
    state: present
  with_items: "{{ java_certs }}"


