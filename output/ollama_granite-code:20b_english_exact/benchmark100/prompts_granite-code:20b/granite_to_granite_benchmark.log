---
- import_tasks: assert.yml
- name: Task 2 - Uninstall conflicting systemd-logger
  yum:
    name: systemd-logger
    state: absent
- name: Task 3 - Install rsyslog
  yum:
    name: rsyslog
    state: present
- name: Task 4 - Install additional rsyslog packages
  yum:
    name: "{{ item }}"
    state: present
  loop:
  - rsyslog-mysql
  - rsyslog-pgsql
- name: Task 5 - Configuring default rsyslog
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    mode: 0644
    owner: root
    group: root
- name: Task 6 - Make configuration directory
  file:
    path: /etc/rsyslog.d
    state: directory
- name: Task 7 - Configuring rsyslog forward rule
  copy:
    content: '{{ rsyslog_forward_rule }}'
    dest: /etc/rsyslog.d/30-ForwardRule.conf
    mode: 0644
    owner: root
    group: root
- name: Task 8 - Configuring additional config files
  template:
    src: '{{ item }}.j2'
    dest: /etc/rsyslog.d/{{ item }}
    mode: 0644
    owner: root
    group: root
  loop:
  - 40-imfile-rule
- name: Task 9 - Start and enable rsyslog
  service:
    name: rsyslog
    state: started
    enabled: yes


