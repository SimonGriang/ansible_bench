---
- name: Run RKE2 tasks
  hosts: all
  tasks:
    - name: Create the RKE2 config dir
      file:
        path: /etc/kubernetes/rke2
        state: directory
        owner: root
        group: root
        mode: 0755

    - name: Set server taints
      command: |
        echo "node-role.kubernetes.io/master:NoSchedule" > /etc/kubernetes/rke2/server-taints.txt
      when: is_server

    - name: Set agent taints
      command: |
        echo "node-role.kubernetes.io/agent:NoSchedule" > /etc/kubernetes/rke2/agent-taints.txt
      when: is_agent

    - name: Copy RKE2 config
      copy:
        src: rke2.yaml
        dest: /etc/kubernetes/rke2/rke2.yaml
        owner: root
        group: root
        mode: 0644

    - name: Copy kubelet config
      copy:
        src: kubelet.conf
        dest: /etc/kubernetes/rke2/kubelet.conf
        owner: root
        group: root
        mode: 0644
      when: kubelet_conf_template is defined

    - name: Copy Containerd Registry Configuration file
      copy:
        src: containerd-registry.yaml
        dest: /etc/kubernetes/rke2/containerd-registry.yaml
        owner: root
        group: root
        mode: 0644
      when: containerd_registry_template is defined

    - name: Start RKE2 service on the rest of the nodes
      systemd:
        name: rke2-service
        state: started

    - name: Mask other RKE2 service on the rest of the nodes
      systemd:
        name: rke2-service
        state: stopped
        enabled: no
      when: is_server

    - name: Wait for remaining nodes to be ready - no CNI
      command: |
        /usr/local/bin/kubectl wait --for=condition=Ready node --all
      when: cni is not defined

    - name: Wait for remaining nodes to be ready - with CNI
      command: |
        /usr/local/bin/kubectl wait --for=condition=Ready node --all
      when: cni is defined


