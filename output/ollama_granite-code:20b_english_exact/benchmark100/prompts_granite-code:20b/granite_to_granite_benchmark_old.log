- name: Task 3 - Install epel-release
  package:
    name: "{{ epel_url }}"
    state: present
  notify: update package cache

- name: Task 4 - Install epel-next-release
  package:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next
  notify: update package cache


