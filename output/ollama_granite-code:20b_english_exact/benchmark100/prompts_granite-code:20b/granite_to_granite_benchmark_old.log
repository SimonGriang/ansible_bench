---
- name: Set the package state based on how Ansible is installed
  package:
    name: "{{ item }}"
    state: present
  with_items:
    - ansible
    - ansible-base
  when: ansible_pkg_mgr == "yum" or ansible_pkg_mgr == "dnf"

- name: Set up Ansible on RedHat
  yum:
    name: "{{ item }}"
    state: present
  with_items:
    - ansible
    - ansible-base
  when: ansible_os_family == "RedHat"

- name: Set up Ansible on Fedora
  dnf:
    name: "{{ item }}"
    state: present
  with_items:
    - ansible
    - ansible-base
  when: ansible_os_family == "Fedora"

- name: Set up Ansible on Ubuntu
  apt:
    name: "{{ item }}"
    state: present
  with_items:
    - ansible
    - python-ansible
  when: ansible_os_family == "Debian"

- name: Set up Ansible on Debian
  apt:
    name: "{{ item }}"
    state: present
  with_items:
    - ansible
    - python-ansible
  when: ansible_os_family == "Debian"

- name: Set up Ansible using Pip
  pip:
    name: ansible
    state: present
  when: ansible_pkg_mgr != "yum" and ansible_pkg_mgr != "dnf" and ansible_pkg_mgr != "apt"


