---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: "/path/to/python3.11"
  register: python3.11_stat

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  command:
    cmd: "mv /path/to/python3.11 /path/to/python3.11_old"
  when: python3.11_stat.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: "/path/to/python3.12"
  register: python3.12_stat

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  command:
    cmd: "mv /path/to/python3.12 /path/to/python3.12_old"
  when: python3.12_stat.stat.exists

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install python pip
  package:
    name: pip

- name: Configure pip proxy
  command:
    cmd: "pip config set proxy http://proxy.server:port"

- name: Trust hosts
  command:
    cmd: "pip trust hosts"

- name: Update pip
  command:
    cmd: "pip install --upgrade pip"

- name: Install requested modules
  pip:
    name: "{{ item }}"
  with_items:
    - module1
    - module2


