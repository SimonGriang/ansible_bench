---
- name: Task 1
  import_tasks: assert.yml

- name: Task 2
  when: ansible_pkg_mgr == "apt"
  block:
    - name: Manage automatic service management
      ansible.builtin.copy:
        content: "exit 101"
        dest: /etc/init/policy-rc.d
        mode: "755"
      when: apt_autostart_state == "disabled"

    - name: Manage automatic service management
      ansible.builtin.file:
        path: /etc/init/policy-rc.d
        state: absent
      when: apt_autostart_state == "enabled"
