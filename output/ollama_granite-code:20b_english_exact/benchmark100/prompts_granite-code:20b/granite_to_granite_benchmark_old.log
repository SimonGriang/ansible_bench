---
- name: Refresh apt cache
  ansible.builtin.apt:
    update_cache: yes
    cache_valid_time: 3600

- name: Refresh dnf cache
  ansible.builtin.dnf:
    update_cache: yes
    cache_valid_time: 3600

- name: Install packages
  ansible.builtin.apt:
    name: keepalived
    state: present
  when: ansible_os_family == "Debian"

- name: Install packages
  ansible.builtin.dnf:
    name: keepalived
    state: present
  when: ansible_os_family == "RedHat"

- name: Create directory for keepalived
  ansible.builtin.file:
    path: /etc/keepalived
    state: directory

- name: Create Kubernetes API health check script for Debian OS family
  ansible.builtin.copy:
    dest: /usr/local/bin/k8s_api_health_check.sh
    content: |
      #!/bin/bash
      # Script content for Debian OS family
    mode: 0755
  when: ansible_os_family == "Debian"

- name: Create Kubernetes API health check script for RedHat OS famliy
  ansible.builtin.copy:
    dest: /usr/local/bin/k8s_api_health_check.sh
    content: |
      #!/bin/bash
      # Script content for RedHat OS family
    mode: 0755
  when: ansible_os_family == "RedHat"

- name: Create RKE2 Server health check script for Debian OS family
  ansible.builtin.copy:
    dest: /usr/local/bin/rke2_server_health_check.sh
    content: |
      #!/bin/bash
      # Script content for Debian OS family
    mode: 0755
  when: ansible_os_family == "Debian"

- name: Create RKE2 Server health check script for RedHat OS family
  ansible.builtin.copy:
    dest: /usr/local/bin/rke2_server_health_check.sh
    content: |
      #!/bin/bash
      # Script content for RedHat OS family
    mode: 0755
  when: ansible_os_family == "RedHat"

- name: Create keepalived config file
  ansible.builtin.copy:
    dest: /etc/keepalived/keepalived.conf
    content: |
      # Configuration content for keepalived

- name: Enable keepalived and make sure it is not masked
  ansible.builtin.systemd:
    name: keepalived
    state: started
    enabled: yes

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


