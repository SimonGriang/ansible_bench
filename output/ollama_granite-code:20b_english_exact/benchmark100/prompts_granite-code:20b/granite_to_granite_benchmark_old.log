---
- name: Install and configure fail2ban
  hosts: all
  tasks:
    - name: Install fail2ban
      ansible.builtin.apt:
        name: fail2ban
        state: present
    - name: Copy filters in filter.d
      ansible.builtin.copy:
        src: "{{ item }}"
        dest: /etc/fail2ban/filter.d
        owner: root
        group: root
        mode: "0640"
      loop:
        - /path/to/filter1.conf
        - /path/to/filter2.conf
    - name: Configure fail2ban.local
      ansible.builtin.ini_file:
        path: /etc/fail2ban/fail2ban.local
        section: "{{ item.section }}"
        option: "{{ item.option }}"
        value: "{{ item.value }}"
        mode: "0640"
        owner: root
        group: root
      loop:
        - section: Definition
          option: loglevel
          value: INFO
        - section: Definition
          option: logtarget
          value: /var/log/fail2ban.log
    - name: Configure jail.local
      ansible.builtin.ini_file:
        path: /etc/fail2ban/jail.local
        section: "{{ item.section }}"
        option: "{{ item.option }}"
        value: "{{ item.value }}"
        mode: "0640"
        owner: root
        group: root
      loop:
        - section: defaults
          option: banaction
          value: iptables-multiport
        - section: defaults
          option: bansequence
          value: "100"
    - name: Stat auth log file
      ansible.builtin.stat:
        path: /var/log/auth.log
      register: auth_log_file
    - name: Touch auth log file
      ansible.builtin.file:
        path: /var/log/auth.log
        state: touch
        owner: root
        group: adm
        mode: "0640"
      when: not auth_log_file.stat.exists
    - name: Start and enable fail2ban
      ansible.builtin.service:
        name: fail2ban
        state: started
        enabled: true


