---
- name: Task 1 - Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Task 2 - Install apache httpd
  ansible.builtin.apt:
    name: httpd
    state: present

- name: Task 3 - Configure selinux
  ansible.posix.selinux:
    policy: target
    state: permissive

- name: Task 4 - Configure httpd
  ansible.builtin.template:
    src: /etc/httpd/conf/httpd.conf
    dest: /etc/httpd/conf/httpd.conf
    mode: "0644"
    owner: root
    group: root

- name: Task 5 - Activate httpd module | Debian
  ansible.builtin.command: /usr/sbin/httpd -t
  when: ansible_os_family == "Debian"

- name: Task 6 - Import ssl.yml
  ansible.builtin.import_tasks: ssl.yml

- name: Task 7 - Import locations.yml
  ansible.builtin.import_tasks: locations.yml

- name: Task 8 - Import vhosts.yml
  ansible.builtin.import_tasks: vhosts.yml

- name: Task 9 - Configure ports
  ansible.builtin.template:
    src: /etc/httpd/conf.d/ports.conf
    dest: /etc/httpd/conf.d/ports.conf
    mode: "0644"
    owner: root
    group: root

- name: Task 10 - Import directories.yml
  ansible.builtin.import_tasks: directories.yml

- name: Task 11 - Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Task 12 - Removing default html
  ansible.builtin.file:
    path: /var/www/html/index.html
    state: absent

- name: Task 13 - Start and enable httpd
  ansible.builtin.service:
    name: httpd
    state: started
    enabled: true


