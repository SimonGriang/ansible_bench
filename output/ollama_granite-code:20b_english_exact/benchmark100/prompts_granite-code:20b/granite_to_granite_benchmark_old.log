---
- name: Prepare RKE2
  hosts: all
  become: true
  tasks:
    - name: Install Keepalived package when High Availability (HA) mode is enabled
      apt:
        name: keepalived
        state: present
      when: ha_mode_enabled

    - name: Download and install RKE2 {{ rke2_version }}
      get_url:
        url: https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2.yml
        dest: /tmp/rke2.yml

    - name: Apply CIS Benchmark hardening for RKE2
      command: cis-hardening rke2.yml

    - name: Find Active Server
      command: find_active_server.sh

    - name: Enable IPVS kernel module
      command: modprobe ip_vs

    - name: Copy kube-vip manifests to the masternode
      copy:
        src: kube-vip.yml
        dest: /tmp/kube-vip.yml

    - name: Copy ingress-nginx manifests to the masternode
      copy:
        src: ingress-nginx.yml
        dest: /tmp/ingress-nginx.yml

    - name: Prepare very first server node in the cluster
      command: prepare_first_server.sh

    - name: Restore etcd specific tasks
      command: restore_etcd.sh
      when: restore_options_enabled

    - name: Download kubeconfig to ansible localhost
      fetch:
        src: /etc/kubernetes/admin.conf
        dest: /tmp/kubeconfig
        flat: yes

    - name: Prepare and join remaining nodes of the cluster
      command: prepare_and_join_remaining_nodes.sh

    - name: Rolling cordon and drain restart when version changes - servers
      command: rolling_restart_servers.sh
      when: version_changed

    - name: Rolling cordon and drain restart when version changes - agents
      command: rolling_restart_agents.sh
      when: version_changed

    - name: Flush handlers
      meta: flush_handlers

    - name: Rolling restart when config files change
      command: rolling_restart_config_files.sh
      when: config_files_changed

    - name: Final steps
      command: final_steps.sh


