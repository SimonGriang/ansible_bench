---
- name: Install hashicorp products
  become: yes
  when: hashicorp_products is defined and hashicorp_installation_method == "package"
  block:
    - name: Install latest hashicorp product using package
      ansible.builtin.apt:
        name: "{{ item.name }}"
        state: latest
      loop: "{{ hashicorp_products }}"
      when: item.version is not defined
    - name: Install versioned hashicorp product using package
      ansible.builtin.apt:
        name: "{{ item.name }}={{ item.version }}"
        state: present
      loop: "{{ hashicorp_products }}"
      when: item.version is defined
  when: hashicorp_installation_method == "manual"
  block:
    - name: Install hashicorp product manually
      ansible.builtin.unarchive:
        src: "{{ item.url }}"
        dest: "{{ item.dest }}"
        remote_src: yes
      loop: "{{ hashicorp_products }}"
    - name: Set file permissions manually
      ansible.builtin.file:
        path: "{{ item.dest }}"
        mode: "{{ item.mode }}"
      loop: "{{ hashicorp_products }}"


