---
- name: Set fact java_jdk_vendor to temurin if java_jdk_vendor equals adoptopenjdk
  ansible.builtin.set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Include OS specific variables based on java_jdk_vendor, ansible_distribution, and ansible_distribution_major_version
  ansible.builtin.include_vars:
    file: "java/{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
    name: java_os_specific_variables

- name: Include architecture specific variables
  ansible.builtin.include_vars:
    file: "java/{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_architecture }}.yml"
    name: java_arch_specific_variables

- name: Set OS specific variables (I)
  ansible.builtin.set_fact:
    java_open_jdk_version_pkg: "{{ java_os_specific_variables.java_open_jdk_version_pkg }}"
    java_open_jdk_home_dir: "{{ java_os_specific_variables.java_open_jdk_home_dir }}"
    java_jdk_pkg: "{{ java_os_specific_variables.java_jdk_pkg }}"

- name: Set OS and architecture specific variables (II)
  ansible.builtin.set_fact:
    java_open_jdk_version_major: "{{ java_arch_specific_variables.java_open_jdk_version_major }}"
    java_open_jdk_version_minor: "{{ java_arch_specific_variables.java_open_jdk_version_minor }}"
    java_open_jdk_version_patch: "{{ java_arch_specific_variables.java_open_jdk_version_patch }}"

- name: Set specific variables
  ansible.builtin.set_fact:
    java_java_home: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}"
    java_java_package: "java-{{ java_open_jdk_version_major }}-{{ java_open_jdk_version_minor }}-OPENJDK"
    java_java_package_state: "{{ java_jdk_pkg_state }}"
    java_alternatives_path: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java"

- name: Add pre-requisites for Debian if ansible_os_family equals Debian
  ansible.builtin.apt:
    name: "{{ java_os_specific_variables.java_apt_dependencies }}"
    state: present
    update_cache: true
    cache_valid_time: 3600
  when: ansible_os_family == "Debian"

- name: Add pre-requisites for RedHat if ansible_os_family equals RedHat
  ansible.builtin.yum:
    name: "{{ java_os_specific_variables.java_yum_dependencies }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Install required libs
  ansible.builtin.package:
    name: "{{ java_os_specific_variables.java_required_libs }}"
    state: present

- name: Install Java, Debian if ansible_os_family equals Debian
  ansible.builtin.apt:
    name: "{{ java_java_package }}"
    state: "{{ java_java_package_state }}"
    update_cache: true
    cache_valid_time: 3600
  when: ansible_os_family == "Debian"

- name: Install Java, RedHat if ansible_os_family equals RedHat
  ansible.builtin.yum:
    name: "{{ java_java_package }}"
    state: "{{ java_java_package_state }}"
  when: ansible_os_family == "RedHat"

- name: Export environment variables
  ansible.builtin.copy:
    dest: /etc/profile.d/jdk.sh
    content: "export JAVA_HOME={{ java_java_home }}\nexport PATH=$JAVA_HOME/bin:$PATH\n"
    mode: 0644

- name: Source environment variables
  ansible.builtin.lineinfile:
    path: /etc/profile
    line: "source /etc/profile.d/jdk.sh"
    regexp: '^source /etc/profile.d/jdk.sh$'
    state: present

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11 if ansible_os_family equals Debian and java_open_jdk_version_major is less than 11
  ansible.builtin. alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_java_home }}/jre/bin/java"
  when: ansible_os_family == "Debian" and java_open_jdk_version_major < 11

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11 if ansible_os_family equals Debian and java_open_jdk_version_major is greater than or equal to 11
  ansible.builtin. alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_java_home }}/bin/java"
  when: ansible_os_family == "Debian" and java_open_jdk_version_major >= 11


