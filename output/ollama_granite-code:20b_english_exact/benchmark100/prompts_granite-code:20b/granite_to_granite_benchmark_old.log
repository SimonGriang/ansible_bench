---

- name: Configure apk
  hosts: all
  tasks:
    - name: Import assert.yml
      import_tasks: assert.yml
    - name: Update cache (apk)
      apk:
        update_cache: yes
        update_cache_extra_args: yes
    - name: Update all software (apk)
      apk:
        name: '*'
        state: latest
    - name: Prevent upgrade for selected packages
      apk:
        name:
          - package1
          - package2
        update_cache: yes
        upgrade: no
    - name: Update all software (apt)
      apt:
        upgrade: dist
    - name: Apt autoremove (apt)
      apt:
        autoremove: yes
    - name: Update all software (dnf)
      dnf:
        name: '*'
        state: latest
    - name: Update all software (pacman)
      pacman:
        upgrade: yes
    - name: Update all software (yum/6)
      yum:
        name: '*'
        state: latest
      when: ansible_distribution_major_version == "6"
    - name: Update yum non-6
      yum:
        name: '*'
        state: latest
      when: ansible_distribution_major_version != "6"
    - name: Install yum-utils
      yum:
        name: yum-utils
        state: present
    - name: Update all software (zypper)
      zypper:
        name: '*'
        state: latest


