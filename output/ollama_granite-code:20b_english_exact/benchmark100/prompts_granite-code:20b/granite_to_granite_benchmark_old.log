    country_name: US
    organization_name: Example
    email_address: webmaster@example.com
    common_name: www.example.com
  tags: create

- name: create | Create ssl certificates
  openssl_certificate:
    path: /tmp/ssl/certs/server.crt
    privatekey_path: /tmp/ssl/private/server.key
    csr_path: /tmp/ssl/csr/server.csr
    provider: selfsigned
  tags: create

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    action: export
    path: /tmp/ssl/certs/server.pfx
    privatekey_path: /tmp/ssl/private/server.key
    certificate_path: /tmp/ssl/certs/server.crt
    state: present
  tags: create

- name: create | Read private key
  openssl_privatekey:
    path: /tmp/ssl/private/server.key
    state: absent
  tags: create

- name: create | Read certificate
  openssl_certificate:
    path: /tmp/ssl/certs/server.crt
    state: absent
  tags: create

- name: create | Create combined private_key and certificate file
  copy:
    dest: /tmp/ssl/server.pem
    content: "{{ lookup('file', '/tmp/ssl/private/server.key') }}\n{{ lookup('file', '/tmp/ssl/certs/server.crt') }}"
    mode: 0600
  tags: create


