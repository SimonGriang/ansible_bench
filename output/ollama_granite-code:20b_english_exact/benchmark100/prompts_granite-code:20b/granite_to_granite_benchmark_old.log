---

- import_tasks: assert.yml

- name: Task 2 - Install required packages
  ansible.builtin.package:
    name: "{{ item.name }}"
    state: present
  with_items: "{{ required_packages }}"
  when: ansible_os_family == item.family
  notify: restart service

- name: Task 3 - Configure systemd service
  ansible.builtin.template:
    src: "service.systemd.j2"
    dest: "/etc/systemd/system/{{ service_name }}.service"
  notify: restart service
  when: ansible_service_mgr == "systemd"

- name: Task 4 - Configure sysvinit service
  ansible.builtin.template:
    src: "service.sysvinit.j2"
    dest: "/etc/init.d/{{ service_name }}"
  notify: restart service
  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]

- name: Task 5 - Manage service
  ansible.builtin.service:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    enabled: "{{ item.enabled }}"
  with_items: "{{ service_list }}"
  notify: restart service

- name: Task 6 - Flush handlers
  ansible.builtin.meta: flush_handlers


