---
- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"

- name: Create directory for git configuration
  file:
    path: "{{ git_username }}/.gitconfig.d/"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: 0750

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: 0640

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: 0750

- name: Clone all roles
  git:
    repo: "{{ item }}"
    dest: "{{ git_repository_destination }}"
    version: master
    force: yes
    recursive: yes
    clone: yes
    update: yes
   ssh_key_user: "{{ git_username }}"
  loop: "{{ git_repositories }}"
  loop_control:
    label: "Cloning {{ item }}"


