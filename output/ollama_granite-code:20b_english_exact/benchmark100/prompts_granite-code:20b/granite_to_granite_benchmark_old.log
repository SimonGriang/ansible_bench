- name: Restart and wait for RKE2 cluster nodes
  hosts: all
  tasks:
    - name: Restart RKE2 service
      service:
        name: rke2-server
        state: restarted
      become: true
    - name: Wait for all nodes to be ready
      command: >
        /var/lib/rke2/bin/rke2ctl --config /etc/kubernetes/rke2/rke2.yaml
        wait --timeout 5m node
        --all
    - name: Wait for all pods to be ready
      command: >
        /var/lib/rke2/bin/rke2ctl --config /etc/kubernetes/rke2/rke2.yaml
        wait --timeout 5m pod
        --all --namespace=default


