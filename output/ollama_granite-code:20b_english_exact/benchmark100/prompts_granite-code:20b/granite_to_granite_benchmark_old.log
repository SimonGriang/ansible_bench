---
- name: "Install required software"
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  tags:
    - packages

- name: "Loop over users_groups"
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ group.name }}"
  tags:
    - groups

- name: "Ensure /etc/sudoers.d directory is included"
  lineinfile:
    path: /etc/sudoers
    line: "@includedir {{ users_sudo_includedir }}"
    regexp: "^(@|#)includedir"
    state: present
    validate: visudo -cf %s
  tags:
    - sudoers

- name: "Loop over users"
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ user.name }}"
  tags:
    - users

- name: "Manage cron permission"
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: "0644"
  when: users_cron_allow
  tags:
    - cron

- name: "Check existence of /etc/cron.allow"
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow
  tags:
    - cron


