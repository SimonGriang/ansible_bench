- name: Fail if some cert doesn't exist
  fail:
    msg: "Java keystore certs directory doesn't exist: {{ java_keystore_path }}/{{ java_keystore_certs_dir }}/"
  when: not java_keystore_certs_stat.stat.exists

- name: Setting keystore variables in java < 11
  set_fact:
    java_keystore_certs: "{{ java_keystore_path }}/{{ java_keystore_certs_dir }}/"
    java_keystore_certs_glob: "*.crt"
    java_keystore_private_keys_glob: "*.key"
  when: java_version.stdout | version_compare('11', '<')

- name: Setting keystore variables in java >= 11
  set_fact:
