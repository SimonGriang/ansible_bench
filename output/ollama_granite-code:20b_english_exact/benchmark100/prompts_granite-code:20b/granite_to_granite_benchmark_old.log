---
- name: password
  hosts: all
  tasks:
    - name: Get efi path
      stat:
        path: /boot/efi
      register: efi_path
    - name: Remove unwanted grub.cfg on EFI systems
      file:
        path: /boot/grub2/grub.cfg
        state: absent
      when: efi_path.stat.exists
    - name: Install user template
      template:
        src: user.j2
        dest: /etc/user.conf
    - name: Add password to EFI configuration
      lineinfile:
        path: /etc/efi.conf
        line: password
    - name: Add password to MBR configuration
      lineinfile:
        path: /etc/mbr.conf
        line: password
    - name: Add --unrestricted
      replace:
        path: /etc/sudoers
        regexp: '^%sudo'
        line: '%sudo ALL=(ALL:ALL) NOPASSWD: ALL'


