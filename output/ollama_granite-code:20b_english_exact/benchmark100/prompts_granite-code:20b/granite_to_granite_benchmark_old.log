---
- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ users_ssh_key_directory }}"
    state: directory
    mode: 0750

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    state: present
    comment: "{{ user.comment | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    password: "{{ user.password | default(omit) }}"
    update_password: "{{ user.update_password | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    move_home: "{{ user.move_home | default(omit) }}"
    generate_ssh_key: "{{ user.generate_ssh_key | default(omit) }}"
    ssh_key_type: "{{ user.ssh_key_type | default(omit) }}"
    ssh_key_bits: "{{ user.ssh_key_bits | default(omit) }}"
    ssh_key_file: "{{ user.ssh_key_file | default(omit) }}"
    ssh_key_passphrase: "{{ user.ssh_key_passphrase | default(omit) }}"

- name: Set sudo options for {{ user.name }}
  template:
    src: sudoers.d.j2
    dest: /etc/sudoers.d/{{ user.name }}
    owner: root
    group: root
    mode: 0440
    validate: '/usr/sbin/visudo -cf %s'
  when: sudo_options is defined

- name: Remove sudo options for {{ user.name }}
  file:
    path: /etc/sudoers.d/{{ user.name }}
    state: absent
  when: sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  command: "{{ ssh_keygen_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}/.ssh/id_rsa"

- name: Generate public ssh key for {{ user.name }}
  command: "{{ ssh_keygen_pubkey_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}/.ssh/id_rsa.pub"

- name: Convert ssh key to ppk for {{ user.name }}
  command: "{{ ssh_keygen_pubkey_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}/.ssh/id_rsa.ppk"

- name: Get or set the home directory for {{ user.name }}
  shell: "getent passwd {{ user.name }} | cut -d: -f6"
  register: user_home_directory
  changed_when: false

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user_home_directory.stdout }}/.ssh"
    state: directory
    mode: 0700

- name: Deploy authorized keys for {{ user.name }}
  copy:
    content: "{{ item.content | b64decode }}"
    dest: "{{ user_home_directory.stdout }}/.ssh/authorized_keys"
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
    mode: "{{ item.mode | default(omit) }}"
  loop: "{{ user.authorized_keys | default([]) }}"

- name: Remove unauthorized keys for {{ user.name }}
  copy:
    content: "{{ item.content | b64decode }}"
    dest: "{{ user_home_directory.stdout }}/.ssh/authorized_keys"
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
    mode: "{{ item.mode | default(omit) }}"
  loop: "{{ user.unauthorized_keys | default([]) }}"
  register: unauthorized_keys_removed

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}/.ssh/id_rsa"
    dest: "{{ item.destination }}"
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
    mode: "{{ item.mode | default(omit) }}"
  loop: "{{ user.copy_private_ssh_key | default([]) }}"

- name: Check users password valid time for {{ user.name }}
  shell: "awk -F: '$1 == \""{{ user.name }}"\" {print $2;exit}' /etc/shadow"
  register: user_password_valid_time
  changed_when: false

- name: Set users password valid time for {{ user.name }}
  command: "chage -d {{ user_password_valid_time.stdout }} {{ user.name }}"
  when: user.password_valid_time is defined

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ item.src }}"
    dest: "{{ user_home_directory.stdout }}/.ssh/{{ item.name }}"
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
    mode: "{{ item.mode | default(omit) }}"
  loop: "{{ user.private_key_files | default([]) }}"


