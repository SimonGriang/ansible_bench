---
- name: lookup bootstrap facts
  command: cat /etc/os-release
  changed_when: false
  register: bootstrap_os_release

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.split('=')[1] }}"
    bootstrap_distribution_major_version: "{{ item.split('=')[1].split('.')[0] }}"
  with_items:
    - "{{ bootstrap_os_release.stdout_lines }}"
  when: item.split('=')[0] == 'NAME' or item.split('=')[0] == 'VERSION_ID'

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.split('=')[1] }}"
  with_items:
    - "{{ bootstrap_os_release.stdout_lines }}"
  when: item.split('=')[0] == 'ID'



