---
- name: Ensure /etc/openvpn/easy-rsa exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: "0755"

- name: Initialize PKI of easyrsa
  shell: easyrsa init-pki
  changed_when: false

- name: Build CA for easyrsa
  shell: easyrsa build-ca nopass
  changed_when: false

- name: Generate DH parameters
  shell: easyrsa gen-dh
  changed_when: false

- name: Build server key and certificate
  shell: easyrsa build-server-full server nopass
  changed_when: false

- name: Build client key and certificate
  shell: easyrsa build-client-full client nopass
  changed_when: false

- name: Generate certificate revocation list
  shell: easyrsa gen-crl
  changed_when: false

- name: Generate openvpn key
  shell: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  changed_when: false

- name: Copy ca.crt, dh.pem, ta.key, issued/client.crt, issued/server.crt, private/ca.key, private/client.key, private/server.key to /etc/openvpn/server
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn/server
    mode: "0644"
  with_items:
    - ca.crt
    - dh.pem
    - ta.key
    - issued/client.crt
    - issued/server.crt
    - private/ca.key
    - private/client.key
    - private/server.key

- name: Copy ca.crt, ta.key to /etc/openvpn
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn
    mode: "0644"
  with_items:
    - ca.crt
    - ta.key

- name: Place server.conf from server.conf.j2 to /etc/openvpn/server.conf
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: "0644"


