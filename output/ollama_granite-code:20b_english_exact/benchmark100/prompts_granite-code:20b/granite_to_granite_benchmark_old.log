---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Task 2 - Uninstall conflicting systemd-logger
  yum:
    name: systemd-logger
    state: absent
  tags: task2

- name: Task 3 - Install rsyslog
  yum:
    name: rsyslog
    state: present
  tags: task3

- name: Task 4 - Install additional rsyslog packages
  yum:
    name: "{{ item }}"
    state: present
  with_items:
    - rsyslog-mmjsonparse
    - rsyslog-imprule-save
    - rsyslog-imprule-rm
    - rsyslog-elasticsearch
    - rsyslog-Forward
  tags: task4

- name: Task 5 - Configuring default rsyslog
  copy:
    src: /etc/rsyslog.conf
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: 0644
  tags: task5

- name: Task 6 - Make configuration directory
  file:
    path: /etc/rsyslog.d
    state: directory
    owner: root
    group: root
    mode: 0755
  tags: task6

- name: Task 7 - Configuring rsyslog forward rule
  copy:
    src: /etc/rsyslog.d/30-log shipping.conf
    dest: /etc/rsyslog.d/30-logshipping.conf
    owner: root
    group: root
    mode: 0644
  tags: task7

- name: Task 8 - Configuring additional config files
  copy:
    src: /etc/rsyslog.d/30-logshipping-files.conf
    dest: /etc/rsyslog.d/30-logshipping-files.conf
    owner: root
    group: root
    mode: 0644
  tags: task8

- name: Task 9 - Start and enable rsyslog
  service:
    name: rsyslog
    state: started
    enabled: yes
  tags: task9


