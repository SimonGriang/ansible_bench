---
- import_tasks: assert.yml
- name: Task 2 - Install python pip
  package:
    name: python-pip
    state: present
- name: Task 3 - Configure pip proxy
  ini_file:
    dest: /etc/pip.conf
    section: global
    option: proxy
    value: "{{ proxy_url }}"
    mode: 0644
    state: "{{ 'present' if proxy_url is defined else 'absent' }}"
- name: Task 4 - Trust hosts
  ini_file:
    dest: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ host_url }}"
    mode: 0644
