    path: /var/lib/rke2/agent/manifests
    state: directory
    mode: '0755'

- name: Copy kube-vip files to first server
  copy:
    src: /path/to/kube-vip/files/
    dest: /var/lib/rke2/agent/manifests/
    mode: '0644'

- name: Copy kube-vip load balancer manifests to first server
  copy:
    src: /path/to/kube-vip/load_balancer_manifests/
    dest: /var/lib/rke2/agent/manifests/
    mode: '0644'
  when: rke2_kubevip_cloud_provider_enable


