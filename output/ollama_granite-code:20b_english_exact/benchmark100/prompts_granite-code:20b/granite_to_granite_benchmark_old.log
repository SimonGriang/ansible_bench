---
- name: Run RKE2 tasks
  block:
    - name: Create the RKE2 config dir
      file:
        path: /etc/rancher/rke2
        state: directory

    - name: Set server taints
      command: rke2 server --taints="{{ rke2_server_node_taints }}"
      changed_when: false

    - name: Copy rke2 config
      copy:
        src: "{{ rke2_config_src }}"
        dest: /etc/rancher/rke2/config.yaml
        mode: 0600
      when: rke2_config_src is defined

    - name: Copy kubelet config
      copy:
        src: "{{ rke2_kubelet_config_src }}"
        dest: /etc/rancher/rke2/kubelet-config.yaml
        mode: 0600
      when: rke2_kubelet_config_src is defined

    - name: Copy Containerd Registry Configuration file
      copy:
        src: "{{ rke2_registries_config_src }}"
        dest: /etc/rancher/rke2/registries.yaml
        mode: 0600
      when: rke2_registries_config_src is defined

    - name: Register if we need to do a etcd restore from file
      set_fact:
        do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file !=None and rke2_etcd_snapshot_file != '' and rke2_etcd_snapshot_s3_options is not defined }}"
      when: rke2_etcd_snapshot_s3_options is not defined

    - name: Register if we need to do a etcd restore from s3
      set_fact:
        do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.access_key != None and rke2_etcd_snapshot_s3_options.access_key != '' and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.secret_key != None and rke2_etcd_snapshot_s3_options.secret_key != '' and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.bucket != None and rke2_etcd_snapshot_s3_options.bucket != '' and rke2_etcd_snapshot_s3_options.snapshot_name is defined and rke2_etcd_snapshot_s3_options.snapshot_name != None and rke2_etcd_snapshot_s3_options.snapshot_name != '' }}"

    - name: Restore etcd from file
      block:
        - name: Create snapshot directory
          file:
            path: /var/lib/rke2/agent/etc/etcd/snapshots.db
            state: directory
          become: true

        - name: Copy etcd snapshot file
          copy:
            src: "{{ rke2_etcd_snapshot_file }}"
            dest: "/var/lib/rke2/agent/etc/etcd/snapshots.db/snapshot.db"
            mode: 0644
          become: true

        - name: Restore etcd from snapshot
          command: rke2 server --etcd-snapshot-restore {{ rke2_etcd_snapshot_file }}
          changed_when: false
      when: do_etcd_restore is defined

    - name: Restore etcd from s3
      command: rke2 server --s3-backup-bucket {{ rke2_etcd_snapshot_s3_options.bucket }} --s3-backup-access-key {{ rke2_etcd_snapshot_s3_options.access_key }} --s3-backup-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }} --s3-backup-region {{ rke2_etcd_snapshot_s3_options.region }} --s3-backup-endpoint {{ rke2_etcd_snapshot_s3_options.endpoint }} --s3-backup-insecure {{ rke2_etcd_snapshot_s3_options.insecure }} --s3-backup-snapshot-name {{ rke2_etcd_snapshot_s3_options.snapshot_name }} --s3-backup-prefix {{ rke2_etcd_snapshot_s3_options.prefix }} --s3-backup-strip-prefix {{ rke2_etcd_snapshot_s3_options.strip_prefix }} --s3-backup-delimiter {{ rke2_etcd_snapshot_s3_options.delimiter }} --etcd-snapshot-restore
      changed_when: false
      when: do_etcd_restore_from_s3 is defined

    - name: Start RKE2 service on the first server
      service:
        name: rke2-server.service
        state: started
        enabled: true
      when: inventory_hostname == groups[rke2_server_group_name][0]

    - name: Mask RKE2 agent service on the first server
      service:
        name: rke2-agent.service
        enabled: false
      when: inventory_hostname == groups[rke2_server_group_name][0]

    - name: Wait for the first server be ready - no CNI
      wait_for:
        host: "{{ hostvars[groups[rke2_server_group_name][0]]['ansible_host'] }}"
        port: 6443
        connect_timeout: 5
        timeout: 300
        state: started
      when: rke2_cni == "none"

    - name: Wait for the first server be ready - with CNI
      wait_for:
        host: "{{ hostvars[groups[rke2_server_group_name][0]]['ansible_host'] }}"
        port: 6443
        connect_timeout: 5
        timeout: 300
        state: started
      when: rke2_cni != "none"

    - name: Restore etcd
      block:
        - name: Remove old <node>.node-password.rke2 secrets
          command: rke2 secrets remove-file --name {{ item }}.node-password.rke2
          changed_when: false
          with_items: "{{ groups[rke2_server_group_name] }}"

        - name: Remove old nodes and secrets
          command: rke2 server --etcd-snapshot-restore --name {{ inventory_hostname }}
          changed_when: false
          register: rke2_server_output

        - name: Print server output
          debug:
            var: rke2_server_output.stdout_lines
      when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

    - name: Set an Active Server variable
      delegate_to: "{{ item }}"
      delegate_facts: true
      run_once: true
      with_items: "{{ groups[rke2_server_group_name] }}"
