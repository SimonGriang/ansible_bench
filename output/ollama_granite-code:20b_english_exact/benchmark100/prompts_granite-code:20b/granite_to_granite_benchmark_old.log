---

- name: Task 1 - Create group vault
  group:
    name: vault
    state: present

- name: Task 2 - Create user vault
  user:
    name: vault
    groups: vault
    append: yes
    shell: /bin/false
    createhome: no
    state: present

- name: Task 3 - Create directory /opt/vault
  file:
    path: /opt/vault
    owner: root
    group: vault
    state: directory

- name: Task 4 - Download Vault binary
  unarchive:
    src: https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_amd64.zip
    dest: /opt/vault
    remote_src: yes
    owner: root
    group: vault

- name: Task 5 - Create directory /etc/vault.d
  file:
    path: /etc/vault.d
    owner: root
    group: vault
    state: directory

- name: Task 6 - Copy Vault binary
  copy:
    src: /opt/vault/vault
    dest: /usr/bin/vault
    owner: root
    group: root
    mode: 0755

- name: Task 7 - Set cap_ipc_lock=ep on /usr/bin/vault
  capabilities:
    path: /usr/bin/vault
    capability: cap_ipc_lock=ep
    state: present

- name: Task 8 - Create file /etc/vault.d/vault.env
  copy:
    dest: /etc/vault.d/vault.env
    content: |
      SKIP_SETCAP=1
      VAULT_ADDR=http://127.0.0.1:8200

- name: Task 9 - Create directory /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    owner: root
    group: root
    state: directory

- name: Task 10 - Copy Vault service file
  copy:
    src: vault.service
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: 0644

- name: Task 11 - Copy vault configuration
  copy:
    src: vault.hcl
    dest: /etc/vault.d/vault.hcl
    owner: root
    group: vault
    mode: 0640

- name: Task 12 - Flush handlers
  meta: flush_handlers



