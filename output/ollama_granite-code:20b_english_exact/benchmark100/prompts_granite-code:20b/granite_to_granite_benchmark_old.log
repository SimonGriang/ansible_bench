---
- import_tasks: assert.yml
- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
- name: Configure mysql server
  ansible.builtin.mysql_config:
    dest: "{{ mysql_configuration_destination }}"
    name: "{{ mysql_name }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_configuration_options }}"
- name: Configure mysql client
  ansible.builtin.mysql_config:
    dest: "{{ mysql_configuration_destination }}"
    name: "{{ mysql_name }}"
    socket: "{{ mysql_socket }}"
- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  changed_when: false
- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true
- name: Flush handlers
  ansible.builtin.meta: flush_handlers
- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: "0600"
    owner: root
    group: root
- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  loop: "{{ mysql_users }}"
- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


