---
- import_tasks: assert.yml
- name: Task 2 - Install dns
  package:
    name: dns
    state: present
- name: Task 3 - Create directories
  file:
    path: "/etc/named/{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop:
    - { path: 'dynamic', owner: 'root', group: 'named', mode: '0755' }
    - { path: 'dynamic/primary', owner: 'named', group: 'named', mode: '0750' }
    - { path: 'dynamic/primary/master', owner: 'named', group: 'named', mode: '0755' }
    - { path: 'dynamic/primary/slave', owner: 'named', group: 'named', mode: '0755' }
    - { path: 'static', owner: 'named', group: 'named', mode: '0755' }
    - { path: 'keys', owner: 'root', group: 'root', mode: '0755' }
- name: Task 4 - Create group
  group:
    name: "{{ dns_group }}"
    state: present
- name: Task 5 - Create user
  user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    shell: /usr/sbin/nologin
    state: present
- name: Task 6 - Generate rndc key
  command: rndc-confgen -a -c /etc/named/ rndc.key
- name: Task 7 - Set permissions on rndc key file
  file:
    path: /etc/named/rndc.key
    owner: root
    group: named
    mode: 0640
- name: Task 8 - Get the hints/root file
  get_url:
    url: "{{ item.url }}"
    dest: /etc/named/named.root
    owner: named
    group: named
    mode: 0644
  loop:
    - { url: 'https://www.internic.net/domain/named.cache', dest: named.root }
    - { url: 'https://www.internic.net/domain/named.cache', dest: hints }
- name: Task 9 - Create zone file
  template:
    src: zone.j2
    dest: "/etc/named/static/{{ item }}.zone"
    owner: named
    group: named
    mode: 0644
  loop: "{{ dns_zones }}"
- name: Task 10 - Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named/named.conf
    owner: root
    group: root
    mode: 0644
  notify: restart dns
- name: Task 11 - Place systemd override
  template:
    src: systemd.j2
    dest: /etc/systemd/system/multi-user.target.wants/dns.service
    owner: root
    group: root
    mode: 0644
  notify: restart dns
- name: Task 12 - Start and enable dns
  systemd:
    name: dns
    state: started
    enabled: true


