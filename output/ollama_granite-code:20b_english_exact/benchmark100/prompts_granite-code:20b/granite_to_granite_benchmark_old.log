content='```yaml\n---\n- name: lookup bootstrap facts\n  command: cat /etc/os-release\n  changed_when: false\n  register: bootstrap_os_release\n\n- name: set bootstrap facts (I)\n  set_fact:\n    bootstrap_distribution: "{{ item.split(\'=\')[1] }}"\n    bootstrap_distribution_major_version: "{{ item.split(\'=\')[1].split(\'.\')[0] }}"\n  with_items:\n    - "{{ bootstrap_os_release.stdout_lines }}"\n  when: item.split(\'=\')[0] == \'NAME\' or item.split(\'=\')[0] == \'VERSION_ID\'\n\n- name: set bootstrap facts (II)\n  set_fact:\n    bootstrap_os_family: "{{ item.split(\'=\')[1] }}"\n  with_items:\n    - "{{ bootstrap_os_release.stdout_lines }}"\n  when: item.split(\'=\')[0] == \'ID\'\n```' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-12T16:26:17.458543428Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4331895410, 'load_duration': 24302704, 'prompt_eval_count': 431, 'prompt_eval_duration': 186411252, 'eval_count': 207, 'eval_duration': 4120018061, 'model_name': 'granite-code:20b'} id='run--3c9a3515-9169-4609-a282-94c9104fc4c4-0' usage_metadata={'input_tokens': 431, 'output_tokens': 207, 'total_tokens': 638}
