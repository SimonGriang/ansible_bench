  when: java_version.stdout | version_compare('11', '<')

- name: Setting keystore variables in java >= 11
  set_fact:
    java_keystore_certs: "{{ java_keystore_path }}/{{ java_keystore_certs_dir }}/"
    java_keystore_certs_glob: "*.crt"
    java_keystore_private_keys_glob: "*.key"
    java_keystore_private_keys: "{{ java_keystore_path }}/{{ java_keystore_private_keys_dir }}/"
  when: java_version.stdout | version_compare('11', '>=')

- name: Import SSL certificates
  java_cert:
    cert_path: "{{ java_keystore_certs }}"
    cert_file: "{{ java_keystore_certs_glob }}"
    key_path: "{{ java_keystore_private_keys | default(omit) }}"
    key_file: "{{ java_keystore_private_keys_glob | default(omit) }}"
    key_pass: "{{ java_keystore_password }}"
    name: "{{ java_keystore_alias }}"
    owner: "{{ java_keystore_owner }}"
    group: "{{ java_keystore_group }}"
    mode: "{{ java_keystore_mode }}"
    state: "{{ java_keystore_state }}"
    java_home: "{{ java_alternative_install_path }}"
  no_log: "{{ not java_keystore_show_debug_logs }}"


