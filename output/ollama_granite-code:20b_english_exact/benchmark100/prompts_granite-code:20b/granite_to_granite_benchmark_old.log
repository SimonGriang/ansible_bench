---
- name: "RKE2 configuration"
  hosts: "all"
  tasks:
    - name: "Create the RKE2 config dir"
      ansible.builtin.file:
        path: "/etc/rke2"
        state: "directory"
    - name: "Set server taints"
      ansible.builtin.command:
        cmd: "kubectl taint node {{ inventory_hostname }} rke2-server=true:NoSchedule --overwrite"
        warn: "false"
      when: "rke2_server_node"
    - name: "Set agent taints"
      ansible.builtin.command:
        cmd: "kubectl taint node {{ inventory_hostname }} rke2-agent=true:NoSchedule --overwrite"
        warn: "false"
      when: "not rke2_server_node"
    - name: "Copy RKE2 config"
      ansible.builtin.copy:
        src: "rke2.yaml"
        dest: "/etc/rke2/rke2.yaml"
    - name: "Copy kubelet config"
      ansible.builtin.copy:
        src: " kubelet.conf"
        dest: "/var/lib/rke2/agent/etc/kubelet.conf"
      when: "rke2_server_node"
    - name: "Copy Containerd Registry Configuration file"
      ansible.builtin.copy:
        src: "registry.conf"
        dest: "/etc/coredns/registry.conf"
      when: "rke2_custom_registry"
    - name: "Start RKE2 service on the rest of the nodes"
      ansible.builtin. systemd:
        name: "rke2-service"
        state: "started"
      when: "inventory_hostname != groups['rke2_masters'][0]"
    - name: "Mask other RKE2 service on the rest of the nodes"
      ansible.builtin.systemd:
        name: "rke2-service"
        enabled: "false"
      when: "inventory_hostname != groups['rke2_masters'][0]"
    - name: "Wait for remaining nodes to be ready - no CNI"
      ansible.builtin.command:
        cmd: "kubectl wait --for=condition=Ready node --timeout=60s {{ inventory_hostname }}"
      when: "not rke2_cni"
    - name: "Wait for remaining nodes to be ready - with CNI"
      ansible.builtin.command:
        cmd: "kubectl wait --for=condition=Ready node --timeout=60s {{ inventory_hostname }}"
      when: "rke2_cni"



