ion': 8764693310, 'model_name': 'granite-code:20b'} id='run--296ea044-0576-4fb8-b4c1-30b97bb24bc5-0' usage_metadata={'input_tokens': 370, 'output_tokens': 475, 'total_tokens': 845}
