---
- name: Install bash
  apt:
    name: bash
    state: present

- name: Install openjdk java (package)
  apt:
    name: openjdk-11-jdk
    state: present

- name: Install RPM
  yum:
    name: rpm
    state: present

- name: Install DEB
  apt:
    name: deb
    state: present

- name: Install oracle java (rpm) (repository)
  yum:
    name: java-1.8.0-oracle
    state: present

- name: Configure oracle targz
  unarchive:
    src: /path/to/jdk-8u265-linux-x64.tar.gz
    dest: /opt
    remote_src: yes

- name: Install oracle java policy software (targz)
  unarchive:
    src: /path/to/jce_policy-8.zip
    dest: /opt
    remote_src: yes

- name: Set alternative (targz)
  alternatives:
    name: java
    path: /opt/jdk1.8.0_265/bin/java

- name: Find JAVA_HOME
  command: update-alternatives --query java
  register: java_home_output

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    line: 'JAVA_HOME={{ java_home_output.stdout.split(" ")[5] }}'




