- name: lookup bootstrap facts
  raw: ansible -m setup
  register: bootstrap_facts

- name: set bootstrap facts (I) # noqa jinja
  set_fact:
    bootstrap_distribution: "{{ bootstrap__os_family_map[item].distribution }}"
    bootstrap_distribution_major_version: "{{ bootstrap__os_family_map[item].distribution_major_version }}"
  loop: "{{ bootstrap_facts.ansible_facts.ansible_os_family|default('Debian') }}"
  when:
    - bootstrap__os_family_map[item].distribution is defined

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ bootstrap__os_family_map[item].os_family }}"
  loop: "{{ bootstrap_facts.ansible_facts.ansible_os_family|default('Debian') }}"
  when:
    - bootstrap__os_family_map[item].os_family is defined


