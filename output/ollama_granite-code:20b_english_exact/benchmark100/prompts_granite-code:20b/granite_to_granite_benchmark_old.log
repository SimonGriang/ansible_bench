---

- name: Pre-configure debian systems
  include_tasks: assert.yml

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    owner: root
    group: root
    mode: 0644

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: 0644

- name: "Setting values for main.cf (1/2)"
  lineinfile:
    path: /etc/postfix/main.cf
    line: "{{ item }}"
    insertbefore: BOF
    create: yes
  with_items:
    - "smtp_tls_wrappermode = no"
    - "smtp_sasl_auth_enable = yes"
    - "smtp_sasl_password_maps = lmdb:/etc/postfix/sasl_password"

- name: "Setting values for main.cf (2/2)"
  lineinfile:
    path: /etc/postfix/main.cf
    line: "{{ item }}"
    insertbefore: BOF
    create: yes
  with_items:
    - "smtp_sasl_security_options = noanonymous"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    owner: root
    group: root
    mode: 0644

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: 0644

- name: Creates cert/key directory
  file:
    path: /etc/postfix/cert
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Deploy Postfix TLS server certificate
  copy:
    src: server.pem
    dest: /etc/postfix/cert/server.pem
    owner: root
    group: root
    mode: 0644

- name: Deploy Postfix TLS server key
  copy:
    src: server.key
    dest: /etc/postfix/cert/server.key
    owner: root
    group: root
    mode: 0600

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
    owner: root
    group: root
    mode: 0644

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    owner: root
    group: root
    mode: 0644

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    owner: root
    group: root
    mode: 0644

- name: Place sasl_password_map
  template:
    src: sasl_password.j2
    dest: /etc/postfix/sasl_password
    owner: root
    group: root
    mode: 0640

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes


