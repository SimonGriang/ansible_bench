      ansible.builtin. systemd:
        name: "rke2-service"
        state: "started"
      when: "inventory_hostname != groups['rke2_masters'][0]"
    - name: "Mask other RKE2 service on the rest of the nodes"
      ansible.builtin.systemd:
        name: "rke2-service"
        enabled: "false"
      when: "inventory_hostname != groups['rke2_masters'][0]"
    - name: "Wait for remaining nodes to be ready - no CNI"
      ansible.builtin.command:
        cmd: "kubectl wait --for=condition=Ready node --timeout=60s {{ inventory_hostname }}"
      when: "not rke2_cni"
    - name: "Wait for remaining nodes to be ready - with CNI"
      ansible.builtin.command:
        cmd: "kubectl wait --for=condition=Ready node --timeout=60s {{ inventory_hostname }}"
      when: "rke2_cni"



