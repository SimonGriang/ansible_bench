---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  yum:
    name: systemd-logger
    state: absent
  tags: task2

- name: Install rsyslog
  yum:
    name: rsyslog
    state: present
  tags: task3

- name: Install additional rsyslog packages
  yum:
    name: "{{ item }}"
    state: present
  with_items:
    - rsyslog-mmjsonparse
    - rsyslog-imprule-save
    - rsyslog-imprule-rm
    - rsyslog-elasticsearch
    - rsyslog-Forward
  tags: task4

- name: Configuring default rsyslog
  copy:
    src: /etc/rsyslog.conf
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: '0644'
  tags: task5

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d
    state: directory
    owner: root
    group: root
    mode: '0755'
  tags: task6

- name: Configuring rsyslog forward rule
  copy:
    src: /etc/rsyslog.d/30-logshipping.conf
    dest: /etc/rsyslog.d/30-logshipping.conf
    owner: root
    group: root
    mode: '0644'
  tags: task7

- name: Configuring additional config files
  copy:
    src: /etc/rsyslog.d/30-logshipping-files.conf
    dest: /etc/rsyslog.d/30-logshipping-files.conf
    owner: root
    group: root
    mode: '0644'
  tags: task8

- name: Start and enable rsyslog
  service:
    name: rsyslog
    state: started
    enabled: yes
  tags: task9
