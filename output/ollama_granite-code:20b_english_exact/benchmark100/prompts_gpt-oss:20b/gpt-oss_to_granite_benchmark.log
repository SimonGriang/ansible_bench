    owner: root
  when: not promtail_binary.stat.exists and promtail_binary_local_dir != "" and not promtail_propagation

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_dist_url }}"
    dest: "{{ ansible_tmp_dir }}"
    force: true
    checksum: "{{ promtail_custom_checksum | default(__promtail_checksum) }}"
  delegate_to: localhost
  run_once: true
  when: promtail_propagation

- name: Propagate promtail binaries
  copy:
    src: "{{ ansible_tmp_dir }}/promtail-linux-{{ go_arch }}.zip"
    dest: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail-linux-{{ go_arch }}.zip"
    mode: 0755
  when: promtail_propagation

- name: Unpack promtail binaries
  unarchive:
    src: "{{ ansible_tmp_dir }}/promtail-linux-{{ go_arch }}.zip"
    dest: "{{ promtail_install_dir }}/{{ promtail_version }}"
    creates: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail-linux-{{ go_arch }}"
    mode: 0755
    remote_src: true
