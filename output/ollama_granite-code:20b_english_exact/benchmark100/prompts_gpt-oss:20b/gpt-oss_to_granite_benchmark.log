    include_tasks: tasks/copy_kubevip_manifests.yml
    when: inventory_hostname == groups[rke2_servers_group_name][0] and rke2_ha_mode and rke2_ha_mode_kubevip and not rke2_ha_mode_keepalived
  - name: Copy ingress-nginx manifests to the masternode
    include_tasks: tasks/copy_ingress_nginx_manifests.yml
    when: rke2_ingress_nginx_values is defined and rke2_ingress_nginx_values | length > 0 and inventory_hostname == groups[rke2_servers_group_name][0]
  - name: Prepare very first server node in the cluster
