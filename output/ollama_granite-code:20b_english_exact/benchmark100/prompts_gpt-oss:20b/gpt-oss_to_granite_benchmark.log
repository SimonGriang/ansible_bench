---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install required software
  package:
    name: "{{ users_requirements }}"
    state: present
  when:
    - users_requirements is defined
    - users_requirements | length > 0

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ group.name }}"
    loop_var: group
  when:
    - users_groups is defined

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "#includedir /etc/sudoers.d"
    regexp: "^#includedir"
    state: present
  notify:
    - Validate sudoers

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ user.name }}"
    loop_var: user
  when:
    - users is defined

- name: Manage cron permission
  template:
    dest: /etc/cron.allow
    group: root
    mode: 0644
    owner: root
    src: cron.allow.j2
  when: users_cron_allow

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


