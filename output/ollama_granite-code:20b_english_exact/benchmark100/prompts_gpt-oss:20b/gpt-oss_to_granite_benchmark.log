            {% endif %}
            {% if rke2_rotate_control_plane_token %}
            --rotate-controlplane-token
            {% endif %}
          environment:
            INSTALL_RKE2_VERSION: "{{ rke2_version }}"
            INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"
            INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"
            INSTALL_RKE2_METHOD:{% if rke2_airgap_mode %} airgap{% else %} registering{% endif %}
      when: not ansible_check_mode and rke2_version != installed_version
  when: not ansible_check_mode and rke2_version != "not installed"

- name: Copy Custom Manifests
  ansible.builtin.template:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    owner: root
    group: root
    mode: "0644"
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

