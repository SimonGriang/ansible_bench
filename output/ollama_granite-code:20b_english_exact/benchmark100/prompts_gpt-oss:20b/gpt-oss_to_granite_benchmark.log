        enabled: false
        masked: true
      loop:
        - agent
        - server
      when: inventory_hostname == active_server or inventory_hostname == rke2_servers_group_name[0]
      loop_control:
        label: "Masking other rke2-{{ item }}.service unit"
      vars:
        ansible_ssh_pipelining: yes
      with_items: "{{ groups['rke2_servers_group_name'] | difference([inventory_hostname]) | reject('match', rke2_type) | list }}"

    - name: Wait for remaining nodes to be ready - no CNI
      command: >
        {{ rke2_kubectl }} get node {{ item }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
        {% if not ansible_check_mode %}
        retries=10 delay=10
        until=changed
        register: changed
        changed_when: "'True' in changed.stdout or 'Unknown' in changed.stdout"
        failed_when: "changed.rc != 0 and changed.rc != 2"
        {% endif %}
      loop: "{{ groups[rke2_cluster_group_name] }}"
      when: rke2_cni == 'none' and (inventory_hostname == active_server or inventory_hostname == rke2_servers_group_name[0])

    - name: Wait for remaining nodes to be ready - with CNI
      command: >
        bash -c '
          expected=$(kubectl get node | grep " Ready" | wc -l)
          actual=0
          until [[ $actual -ge $expected ]]; do
            sleep 5
            actual=$(kubectl get node | grep " Ready" | wc -l)
          done
        '
      when: not ansible_check_mode and rke2_cni != 'none' and (inventory_hostname == active_server or inventory_hostname == rke2_servers_group_name[0])

  handlers:
    - name: Config file changed
      systemd:
        name: "{{ rke2_service_name }}"
        daemon_reload: true
      vars:
        ansible_ssh_pipelining: yes

    - name: Service (re)started
      systemd:
        name: "{{ rke2_service_name }}"
        daemon_reload: true
        state: started
      vars:
        ansible_ssh_pipelining: yes
