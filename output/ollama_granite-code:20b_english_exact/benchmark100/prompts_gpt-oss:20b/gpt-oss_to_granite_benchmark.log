}"\n        mode: "0640"\n        force: true\n      loop: "{{ rke2_artifact }}"\n      when: rke2_airgap_mode and rke2_airgap_implementation == "copy"\n\n    - name: Airgap mode - additional images tarballs\n      ansible.builtin.block:\n        - name: Create directory for additional images\n          ansible.builtin.file:\n            path: "{{ rke2_tarball_images_path }}"\n            state: directory\n            mode: "0700"\n        - name: Copy additional image tarballs\n          ansible.builtin.copy:\n            src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"\n            dest: "{{ rke2_tarball_images_path }}/{{ item }}"\n            mode: "0644"\n            force: true\n          loop: "{{ rke2_airgap_copy_additional_tarballs }}"\n      when: rke2_airgap_mode and rke2_airgap_implementation != "exists" and rke2_airgap_copy_additional_tarballs | length > 0\n\n    - name: Airgap mode - ensure artifacts exist and have acceptable permissions\n      ansible.builtin.block:\n        - name: Stat artifacts\n          ansible.builtin.stat:\n            path: "{{ rke2_artifact_path }}/{{ item }}"\n          register: artifacts\n        - name: Stat installation script\n          ansible.builtin.stat:\n            path: "{{ rke2_install_script_dir }}/rke2.sh"\n          register: install_script\n      when: rke2_airgap_mode and rke2_airgap_implementation == "exists"\n\n    - name: Populate service facts\n      ansible.builtin.service_facts:\n\n    - name: Get stats of the FS object\n      ansible.builtin.stat:\n        path: /usr/local\n      register: usr_local\n\n    - name: Check if separate partition\n      ansible.builtin.command: grep \'/usr/local \' /proc/mounts\n      changed_when: false\n      failed_when: partition_result.rc >= 2\n      register: partition_result\n\n    - name: Set RKE2 bin path\n      ansible.builtin.set_fact:\n        rke2_bin_path: /usr/local/bin/rke2\n      when: not usr_local.stat.writeable or partition_result.rc == 1\n\n    - name: Set RKE2 bin path\n      ansible.builtin.set_fact:\n        rke2_bin_path: /opt/rke2/bin/rke2\n      when: usr_local.stat.writeable and partition_result.rc == 0\n\n    - name: Check RKE2 version\n      ansible.builtin.shell: |\n        installed_version="$(\n          [[ -f "{{ rke2_bin_path }}" ]] &&\n          "{{ rke2_bin_path }}" version |& head -n1 | cut -d\' \' -f3 ||\n          echo "{{ rke2_version }}"\n        )"\n        running_version="$(\n          if systemctl is-active --quiet {{ rke2_service_name }} && [[ -f /run/rke2/version ]]; then\n            cat /run/rke2/version\n          elif systemctl is-enabled --quiet {{ rke2_service_name }} && [[ -f /run/rke2/version ]]; then\n            cat /run/rke2/version\n          else\n            echo "{{ rke2_version }}"\n          fi\n        )"\n        echo \'{"installed_version": "\'${installed_version}\'", "running_version": "\'${running_version}\'"}\'\n      args:\n        executable: /bin/bash\n      register: versions_check\n      changed_when: versions_check.stdout != ""\n\n    - name: Set RKE2 versions\n      ansible.builtin.set_fact:\n        installed_version: "{{ versions_check.stdout | from_json | json_query(\'installed_version\') }}"\n        running_version: "{{ versions_check.stdout | from_json | json_query(\'running_version\') }}"\n      =,\n     ___' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-17T03:27:37.485935286Z', 'done': True, 'done_reason': 'stop', 'total_duration': 71337091937, 'load_duration': 34559682, 'prompt_eval_count': 6009, 'prompt_eval_duration': 1674582259, 'eval_count': 1999, 'eval_duration': 69625935699, 'model_name': 'granite-code:20b'} id='run--ecf0e83d-fb1e-44ec-88cb-3db743d66807-0' usage_metadata={'input_tokens': 6009, 'output_tokens': 1999, 'total_tokens': 8008}
