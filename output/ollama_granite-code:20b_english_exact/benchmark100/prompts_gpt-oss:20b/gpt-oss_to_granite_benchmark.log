---
- name: Create Vault group
  ansible.builtin.group:
    name: "{{ vault_group }}"
    system: true

- name: Create Vault user
  ansible.builtin.user:
    name: "{{ vault_user }}"
    home: ""
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    create_home: false
    system: true

- name: Create Vault download directory
  ansible.builtin.file:
    path: "{{ vault_download_path }}"
    owner: "{{ vault_user }}:{{ vault_group }}"
    mode: 0755
    state: directory

- name: Download Vault binary
  ansible.builtin.unarchive:
    src: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
    dest: "{{ vault_download_path }}"
    remote_src: true
    validate_certs: false
    list_files: true
    mode: 0644
    owner: root
    group: root
    creates: "{{ vault_download_path }}/vault"

- name: Check if vault_path exists
  ansible.builtin.stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exist
  ansible.builtin.file:
    path: "{{ vault_path }}"
    owner: "{{ vault_user }}:{{ vault_group }}"
    mode: 0755
    state: directory
  when: not vault_check_path.stat.exists and vault_path | length > 0

- name: Create directory in vault_path
  ansible.builtin.file:
    path: "{{ item.name }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_directories }}"

- name: Create data directory
  ansible.builtin.file:
    path: "{{ item.name }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  ansible.builtin.command: "openssl req -x509 -sha256 -newkey rsa:2048 -nodes -keyout {{ vault_data_directory }}/tls/tls.key -out {{ vault_data_directory }}/tls/tls.crt -subj '/CN=localhost'"
  args:
    creates: "{{ vault_data_directory }}/tls/tls.key"
  notify: Restart vault

- name: Set ownership of tls material
  ansible.builtin.file:
    path: "{{ item.name }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  ansible.builtin.copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    remote_src: true
    owner: root
    group: root
    mode: 0755
    notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  community.general.capabilities:
    path: "{{ vault_path }}/usr/bin/vault"
    capability: cap_ipc_lock+ep
    state: present
    changed_when: false

- name: Touch vault.env
  ansible.builtin.file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    owner: "{{ vault_user }}:{{ vault_group }}"
    mode: 0644
    state: touch
    modification_time: preserve
    access_time: preserve
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  ansible.builtin.file:
    path: /usr/lib/systemd/system
    owner: root
    group: root
    mode: 0755

- name: Copy Vault service file
  ansible.builtin.template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: 0644
    notify: Daemon reload
  when: ansible_service_mgr == "systemd"

- name: Copy vault configuration
  ansible.builtin.copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: 0644
    force: false
    notify: Restart vault

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


