---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    name: postfix/main_mailer_type
    value: No configuration
    vtype: string

- name: Ensure postfix package is present
  ansible.builtin.package:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present
  when:
  - postfix_virtual_mailbox_maps is defined and "mysql" in postfix_virtual_mailbox_maps
  - or postfix_virtual_mailbox_domains is defined and "mysql" in postfix_virtual_mailbox_domains
  - or postix_virtual_alias_maps is defined and "mysql" in postix_virtual_alias_maps

- name: Render transport_maps template
  ansible.builtin.template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport
    mode: 0644
    backup: true
  notify:
  - Validate configuration
  - Rebuild transport_maps database
  when: postfix_transport_maps_template is defined

- name: Render header_checks template
  ansible.builtin.template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
    mode: 0644
    backup: true
  notify:
  - Validate configuration
  - Reload postfix
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf (1/2)
  ansible.builtin.set_fact:
    _postfix_smtpd_recipient_restrictions_check_recipient_access: "{{ (postfix_recipient_access is defined) | ternary('yes', 'no') }}"
    _postfix_smtpd_sender_restrictions_check_sender_access: "{{ (postfix_sender_access is defined) | ternary('yes', 'no') }}"

- name: Setting values for main.cf (2/2)
  ansible.builtin.set_fact:
    _postfix_mynetworks: "{{ postfix_mynetworks | default([]) | union(postfix_mynetworks_fact) | union(postfix_mynetworks_ipv4_fact) | union(postfix_mynetworks_ipv6_fact) }}"
    _postfix_mydestination: "{{ postfix_mydestination | default([]) | union(postfix_mydestination_fact) }}"
    _postfix_relay_domains: "{{ postfix_relay_domains | default([]) | union(postfix_relay_domains_fact) }}"
    _postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default([]) | union([_postfix_smtpd_recipient_restrictions_check_recipient_access, _postfix_smtpd_recipient_restrictions_fact, _postfix_smtpd_recipient_restrictions_default_fact]) }}"
    _postfix_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default([]) | union([_postfix_smtpd_sender_restrictions_check_sender_access, _postfix_smtpd_sender_restrictions_fact, _postfix_smtpd_sender_restrictions_default_fact]) }}"
    _postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default([]) | union(postfix_virtual_mailbox_domains_fact) }}"
    _postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains | default([]) | union(postfix_virtual_alias_domains_fact) }}"
    _postfix_virtual_alias_maps: "{{ postfix_virtual_alias_maps | default([]) | union(postfix_virtual_alias_maps_fact) }}"
    _postfix_virtual_mailbox_maps: "{{ postfix_virtual_mailbox_maps | default([]) | union(postfix_virtual_mailbox_maps_fact) }}"

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 0644
    backup: true
  notify:
  - Validate configuration
  - Restart postfix

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: 0644
    backup: true
  notify:
  - Validate configuration
  - Restart postfix

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ postfix_smtpd_tls_cert_file | dirname }}"
    state: directory
    mode: 0700
  when:
  - postfix_smtpd_tls_cert_file is defined
  - and postfix_smtpd_tls_key_file is defined

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: 0600
  notify: Reload postfix
  when: postfix_smtpd_tls_cert_file_source is defined

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: 0600
  notify: Reload postfix
  when: postfix_smtpd_tls_key_file_source is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure aliases
  ansible.builtin.lineinfile:
    path: "{{ postfix_alias_path }}"
    create: true
    mode: 0644
    line: "{{ item.name }}: {{ item.destination }}"
    regexp: "^{{ item.name }}:"
    state: present
  loop: "{{ postfix_aliases }}"
  notify:
  - Rebuild alias database
  - Reload postfix

- name: Configure sender_access
  ansible.builtin.lineinfile:
    path: "{{ postfix_sender_access_path }}"
    create: true
    mode: 0644
    line: "{{ item.domain }} {{ item.action }}"
    regexp: "^{{ item.domain }} {{ item.action }}$"
    state: present
  loop: "{{ postfix_sender_access }}"
  notify:
  - Rebuild sender_access database
  - Reload postfix

- name: Configure recipient_access
  ansible.builtin.lineinfile:
    path: "{{ postfix_recipient_access_path }}"
    create: true
    mode: 0644
    line: "{{ item.domain }} {{ item.action }}"
    regexp: "^{{ item.domain }} {{ item.action }}$"
    state: present
  loop: "{{ postfix_recipient_access }}"
  notify:
  - Validate configuration
  - Rebuild recipient_access database
  - Reload postfix

- name: Place sasl_password_map
  ansible.builtin.copy:
    content: "{{ postfix_smtp_sasl_password_map_content }}"
    dest: "{{ postfix_smtp_sasl_password_map }}"
    mode: 0600
  notify: Rebuild sasl_password_map database
  when:
  - postfix_smtp_sasl_password_map is defined
  - and postfix_smtp_sasl_password_map_content is defined

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Start and enable postfix
  ansible.builtin.service:
    name: "{{ postfix_service }}"
    state: started
    enabled: true


