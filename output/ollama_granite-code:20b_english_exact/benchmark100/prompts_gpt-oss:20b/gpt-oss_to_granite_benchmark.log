---
- name: Lookup bootstrap facts
  ansible.builtin.raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  check_mode: false

- name: Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: "NA"
  loop: "{{ bootstrap_os_family_map | dict2items | flatten | unique }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout is match("PRETTY_NAME=.*")
    - bootstrap_facts.stdout is match(bootstrap_search[item] | default(item))
  become: false
  no_log: true

- name: Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  when:
    - bootstrap_distribution is defined in item
    - bootstrap_distribution in item.value
  become: false
  no_log: true


