---
- name: Task 1
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
  - Set root password
  - Systemctl daemon-reexec

- name: Task 3
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: "0644"
    no_log: true
  loop: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Task 4
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    mode: "0644"
    no_log: true

- name: Task 5
  ansible.builtin.command:
    cmd: "{{ mysql_initialize_command }}"
    creates: /var/lib/mysql/mysql
  when: ansible_os_family in [Alpine, Archlinux]

- name: Task 6
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Task 7
  ansible.builtin.meta: flush_handlers

- name: Task 8
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: "0640"

- name: Task 9
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    target: "{{ item.target | defaultomit }}"
    encoding: "{{ item.encoding | defaultomit }}"
    collation: "{{ item.collation | defaultomit }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    no_log: true
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined
  no_log: true

- name: Task 10
  community.mysql.mysql_info:
    filter: databases
    login_unix_socket: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    no_log: true
  register: mysql_info
  no_log: true

- name: Task 11
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  when:
  - mysql_databases is defined
  - item.initial_import is defined
  - item.name not in mysql_info.databases

- name: Task 12
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | defaultomit }}"
    host: "{{ item.host | defaultomit }}"
    host_all: "{{ item.host_all | defaultomit }}"
    update_password: "{{ item.update_password | defaultomit }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    no_log: true
  loop: "{{ mysql_users }}"
  when: mysql_users is defined
  no_log: true

- name: Task 13
  ansible.builtin.meta: flush_handlers


