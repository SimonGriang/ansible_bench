    until: all_ready_nodes.stdout | int == groups[rke2_cluster_group_name] | length
    retries: 100
    delay: 15
    delegate_to: "{{ active_server if active_server is defined else first_server }}"
    run_once: true
    check_mode: false

- name: Wait for all pods to be ready again
  hosts: rke2_servers
  tasks:
  - name: Wait for all pods to be ready again
    ansible.builtin.shell: |
      {{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods --all-namespaces -o jsonpath='{.items[*].status.phase}' 2>/dev/null | grep -Ev 'Running|Succeeded' || true
    register: all_pods_ready
    until: all_pods_ready.stdout | int == 0
    retries: 100
    delay: 15
    delegate_to: "{{ active_server if active_server is defined else first_server }}"
    run_once: true
    check_mode: false
    when: rke2_wait_for_all_pods_to_be_ready


