---
- name:Imports
  import_tasks: assert.yml
  tags: dns_import

- name:Install dns
  package:
    name: "{{ dns_packages }}"
    state: present
  tags: dns_install

- name:Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode | default(omit) }}"
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
  loop:
    - path: "{{ dns_datadir }}"
      mode: "1770"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
    - path: "{{ dns_confdir }}"
      mode: "0755"
      owner: "root"
      group: "root"
  loop_control:
    label: "{{ item.path }}"
  tags: dns_directories

- name:Create group
  group:
    name: "{{ dns_group }}"
    state: present
  tags: dns_group

- name:Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true
  tags: dns_user

- name:Generate rndc key
  command: rndc-confgen -a -c {{ dns_confdir }}
  args:
    creates: "{{ dns_confdir }}/rndc.key"
  changed_when: false
  tags: dns_rndc_key

- name:Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0640"
  tags: dns_rndc_key

- name:Get the hints/root file
  get_url:
    url: "https://www.internic.net/domain/named.root"
    dest: "{{ dns_datadir }}/named.root"
    validate_certs: "{{ dns_validate_certs }}"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns
  notify: Rndc reload
  tags: dns_hints

- name:Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.db"
    validate: named-checkzone {{ item.name }} %s
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop: "{{ dns_zones }}"
  loop_control:
    label: "{{ item.name }}"
  notify: Rndc reload
  tags: dns_zones

- name:Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    validate: named-checkconf -zj %s
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    backup: true
  notify: Restart dns
  tags: dns_configuration

- block:
    - name:Create systemd override directory
      file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        state: directory
        mode: "0755"

    - name:Place systemd override
      copy:
        src: override.conf
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
        owner: "root"
        group: "root"
        mode: "0644"
      register: _dns_unit_file

    - name:Reload systemd daemon
      systemd:
        daemon_reload: true
      when: _dns_unit_file is changed
  when: ansible_service_mgr == "systemd"
  tags: dns_systemd

- name:Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true
  tags: dns_service


