---
- name: Check if all variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  when:
    - not connection | default(False) | bool
    - bootstrap_wait_for_host | default(True) | bool

- name: Prepare system
  block:
    - name: Test connection to host
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: connection_test
      changed_when: false

    - name: Include gather_facts.yml
      import_tasks: gather_facts.yml

    - name: Execute raw shell commands
      raw: "{{ bootstrap_install.raw }}"
      register: bootstrap_install_raw
      changed_when: "'changed' in bootstrap_install_raw.stdout_lines or bootstrap_install_raw.rc != 0"
      become: "{{ bootstrap_become | default(omit) }}"
      become_user: "{{ bootstrap_become_user | default(omit) }}"
      when: bootstrap_install.raw | default(None)
  rescue:
    - name: Connection test failed
      debug:
        msg: "Connection test failed, timeout value is {{ bootstrap_timeout }}"
      changed_when: true
  always:
    - name: Include gather_facts.yml
      import_tasks: gather_facts.yml

    - name: Execute raw shell commands
      raw: "{{ bootstrap_install.raw }}"
      register: bootstrap_install_raw
      changed_when: "'changed' in bootstrap_install_raw.stdout_lines or bootstrap_install_raw.rc != 0"
      become: "{{ bootstrap_become | default(omit) }}"
      become_user: "{{ bootstrap_become_user | default(omit) }}"
      when: bootstrap_install.raw | default(None)

- name: Ensure system is prepared by issuing ansible modules
  become: "{{ bootstrap_become | default(omit) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"
  block:
    - name: Gather Ansible facts
      setup:

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap__facts_packages }}"
        state: present
        update_cache: true
      register: bootstrap_install_package
      until: bootstrap_install_package is succeeded
      retries: 5
      delay: 10
      when: bootstrap__facts_packages | length > 0


