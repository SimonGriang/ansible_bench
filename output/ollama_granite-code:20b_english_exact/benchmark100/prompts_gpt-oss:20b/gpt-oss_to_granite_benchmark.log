---
- name: Role tasks
  import_tasks: assert.yml
  delegate_to: localhost
  tags: [always]

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present
  tags: [cron]

- name: Configure shell
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    create: true
    mode: "0600"
    notify: Restart cron
  tags: [cron]

- name: Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    create: true
    mode: "0600"
    notify: Restart cron
  tags: [cron]

- name: Configure mailto
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    create: true
    mode: "0600"
    notify: Restart cron
  tags: [cron]

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service | length > 0
  tags: [cron]

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    special_time: "{{ item.special_time | default(omit) }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default(omit) }}"
    user: "{{ item.user | default(omit) }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined
  tags: [cron]


