---
- name: Ensure /etc/openvpn/easy-rsa exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Easyrsa init-pki
  command: "{{ openvpn_easyrsa_path }}/easyrsa init-pki"
  args:
    chdir: /etc/openvpn/easy-rsa
  register: easyrsa_init_pki_command
  changed_when: easyrsa_init_pki_command.stdout_lines | length > 0
  failed_when: easyrsa_init_pki_command.stderr_lines | length > 0

- name: Easyrsa build-ca
  command: "{{ openvpn_easyrsa_path }}/easyrsa build-ca nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  register: easyrsa_build_ca_command
  changed_when: easyrsa_build_ca_command.stdout_lines | length > 0
  failed_when: easyrsa_build_ca_command.stderr_lines | length > 0

- name: Easyrsa gen-dh
  command: "{{ openvpn_easyrsa_path }}/easyrsa gen-dh"
  args:
    chdir: /etc/openvpn/easy-rsa
  register: easyrsa_gen_dh_command
  changed_when: easyrsa_gen_dh_command.stdout_lines | length > 0
  failed_when: easyrsa_gen_dh_command.stderr_lines | length > 0

- name: Easyrsa build-server-full server nopass
  command: "{{ openvpn_easyrsa_path }}/easyrsa build-server-full server nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  register: easyrsa_build_server_full_command
  changed_when: easyrsa_build_server_full_command.stdout_lines | length > 0
  failed_when: easyrsa_build_server_full_command.stderr_lines | length > 0

- name: Easyrsa build-client-full client nopass
  command: "{{ openvpn_easyrsa_path }}/easyrsa build-client-full client nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  register: easyrsa_build_client_full_command
  changed_when: easyrsa_build_client_full_command.stdout_lines | length > 0
  failed_when: easyrsa_build_client_full_command.stderr_lines | length > 0

- name: Easyrsa gen-crl
  command: "{{ openvpn_easyrsa_path }}/easyrsa gen-crl"
  args:
    chdir: /etc/openvpn/easy-rsa
  register: easyrsa_gen_crl_command
  changed_when: easyrsa_gen_crl_command.stdout_lines | length > 0
  failed_when: easyrsa_gen_crl_command.stderr_lines | length > 0

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to /etc/openvpn/server
  copy:
    src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
    dest: "/etc/openvpn/server/{{ item }}"
    mode: 0640
    remote_src: true
  loop:
    - ca.crt
    - dh.pem
    - ta.key
    - issued/client.crt
    - issued/server.crt
    - private/ca.key
    - private/client.key
    - private/server.key

- name: Copy files to /etc/openvpn
  copy:
    src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
    dest: "/etc/openvpn/{{ item }}"
    mode: 0640
    remote_src: true
  loop:
    - ca.crt
    - ta.key

- name: Place server.conf
  template:
    src: server.conf.j2
    dest: "{{ openvpn_configuration_directory }}/server.conf"
    owner: root
    group: "{{ openvpn_group }}"
    mode: 0640
  notify: Restart openvpn


