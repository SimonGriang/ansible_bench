---
- import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost
- name: Install using package
  package:
    name: "{{ hashicorp_products }}"
    state: present
  when: hashicorp_products is defined
- name: Install repository for RedHat
  copy:
    content: "{{ hashicorp_repo_rpm }}"
    dest: /etc/yum.repos.d/hashcorp.repo
    owner: root
    group: root
    mode: 0644
  when: hashicorp_products is defined and (ansible_os_family == "RedHat" or ansible_os_family == "Rocky")
- name: Configure debian
  set_fact:
    hashicorp_repo_debian_architecture: "amd64"
  when: hashicorp_repo_debian_architecture is undefined and ansible_architecture == "x86_64"
- name: Configure debian
  set_fact:
    hashicorp_repo_debian_architecture: "i386"
  when: hashicorp_repo_debian_architecture is undefined and ansible_architecture == "i686"
- name: Install required package gpg
  package:
    name: gpg
    state: present
  when: hashicorp_products is defined and ansible_os_family == "Debian"
- name: Install apt key for Debian
  apt_key:
    url: https://apt.releases.hashicorp.com/gpg
    state: present
    validate_certs: no
  when: hashicorp_products is defined and ansible_os_family == "Debian"
- name: Install repository for Debian
  apt_repository:
    repo: "deb [arch={{ hashicorp_repo_debian_architecture }}] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
    state: present
    update_cache: yes
  when: hashicorp_products is defined and ansible_os_family == "Debian"
- name: Install hashicorp product using package
  package:
    name: "{{ hashicorp_products }}"
    state: present
  when: hashicorp_products is defined
- name: Install latest hashicorp product using package
  package:
    name: "{{ item.name }}"
    state: latest
  loop: "{{ hashicorp_products }}"
  when: hashicorp_products is defined and item.version is undefined
- name: Install versioned hashicorp product using package
  package:
    name: "{{ item.name }}"
    state: present
    version: "{{ item.version }}"
  loop: "{{ hashicorp_products }}"
  when: hashicorp_products is defined and item.version is defined
- name: Install manually
  unarchive:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    group: "{{ item.group | default(omit) }}"
    mode: "{{ item.mode | default(omit) }}"
    owner: "{{ item.owner | default(omit) }}"
    remote_src: yes
  loop: "{{ hashicorp_products }}"
  when: hashicorp_products is defined and item.src is defined
- name: Install hashicorp product manually
  unarchive:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    group: "{{ item.group | default(omit) }}"
    mode: "{{ item.mode | default(omit) }}"
    owner: "{{ item.owner | default(omit) }}"
    remote_src: yes
  loop: "{{ hashicorp_products }}"
  when: hashicorp_products is defined and item.src is defined


