---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ bootstrap_wait_for_host | ternary(ansible_port, 22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when: connection is defined and not connection == 'docker' and bootstrap_wait_for_host

- name: Prepare system
  ansible.builtin.block:
    - name: Test connection
      ansible.builtin.wait_for:
        timeout: "{{ bootstrap_timeout }}"
    - name: Check sudo
      ansible.builtin.command: sudo --version
      register: bootstrap_install
      changed_when: false
    - name: Gather bootstrap facts
      ansible.builtin.include_tasks: gather_facts.yml
    - name: Install bootstrap packages
      ansible.builtin.raw: "{{ bootstrap_install.raw }}"
      changed_when: >
        bootstrap_install.stdout is not search(bootstrap_install.stdout_regex)
      register: bootstrap_install_packages
  when: bootstrap_install is not skip_tags

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: all
    gather_timeout: "{{ bootstrap_timeout }}"
  become: false

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: true
    state: present
    become: "{{ bootstrap_become }}"


