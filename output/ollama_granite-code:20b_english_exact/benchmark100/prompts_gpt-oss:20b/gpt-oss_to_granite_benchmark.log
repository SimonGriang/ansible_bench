---
- name: Lookup bootstrap facts
  ansible.builtin.raw:
    path: /etc/os-release
    # Do not run in become mode
    become: false
    # Do not report changed status
    changed_when: false
  register: bootstrap_facts
  # Do not report changed status
  changed_when: false

- name: Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout_lines | selectattr(' match', 'search', '^VERSION_ID=([0-9]+)') | map(attribute='line') | first | default('NA', true) }}"
  loop: "{{ bootstrap_os_family_map | dict2items | map(attribute='key') | list | flatten }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout is defined
    - ("{{ bootstrap_facts.stdout | from_yaml | json_query('PRETTY_NAME') }}" | regex_search(bootstrap_search[item] | default(item))) or (bootstrap_search[item] is undefined)

- name: Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  when: "'{{ bootstrap_distribution }}' in {{ item.value | list }}"


