  - name: Download kubeconfig to ansible localhost
    include_tasks: tasks/download_kubeconfig.yaml
    when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]
  - name: Prepare and join remaining nodes of the cluster
    include_tasks: tasks/prepare_remaining_nodes.yml
    when: active_server is defined and groups[rke2_cluster_group_name] | length > 1
  - name: Rolling cordon and drain restart when version changes - servers
    include_tasks: tasks/rolling_cordon_and_drain_restart_servers.yml
    loop: "{{ groups[rke2_servers_group_name] }}"
    loop_control:
      loop_var: node
    when: node == inventory_hostname and installed_version is defined and installed_version != "not installed" and rke2_version is defined and rke2_version != running_version
  - name: Rolling cordon and drain restart when version changes - agents
    include_tasks: tasks/rolling_cordon_and_drain_restart_agents.yml
    loop: "{{ groups[rke2_agents_group_name] }}"
    loop_control:
      loop_var: node
    when: node == inventory_hostname and inventory_hostname not in groups[rke2_servers_group_name] and installed_version is defined and installed_version != "not installed" and rke2_version is defined and rke2_version != running_version
  - name: Flush handlers
    meta: flush_handlers
  - name: Rolling restart when config files change
    include_tasks: tasks/rolling_restart_when_config_files_change.yml
    loop: "{{ groups[rke2_cluster_group_name] }}"
    loop_control:
      loop_var: node
    when: node == inventory_hostname and rke2_restart_needed
