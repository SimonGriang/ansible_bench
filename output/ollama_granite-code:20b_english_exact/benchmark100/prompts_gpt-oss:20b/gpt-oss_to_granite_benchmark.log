    loop: "{{ groups[rke2_agents_group_name] }}"
    loop_control:
      loop_var: node
    when: node == inventory_hostname and inventory_hostname not in groups[rke2_servers_group_name] and installed_version is defined and installed_version != "not installed" and rke2_version is defined and rke2_version != running_version
