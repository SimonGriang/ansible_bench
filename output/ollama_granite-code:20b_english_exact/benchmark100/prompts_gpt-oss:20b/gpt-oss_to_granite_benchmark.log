---
- name: Create RKE2 config dir
  file:
    path: /etc/rancher/rke2
    owner: root
    group: root
    mode: '0755'
    state: directory

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == "server"

- name: Copy rke2 config
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
    notify: Config file changed

- name: Copy kubelet config
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
    notify: Config file changed
  when: rke2_kubelet_config != ""

- name: Copy Containerd Registry Configuration file
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
    notify: Config file changed
  when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: (rke2_etcd_snapshot_file != "") and ((rke2_service is not defined) or (rke2_service.enabled | bool == false))

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: (rke2_etcd_snapshot_file != "") and (rke2_etcd_snapshot_s3_options is defined) and (rke2_etcd_snapshot_s3_options['access_key'] != "") and (rke2_etcd_snapshot_s3_options['secret_key'] != "") and (rke2_etcd_snapshot_s3_options['bucket'] != "") and (rke2_etcd_snapshot_s3_options['snapshot_name'] != "")

- name: Restore etcd from file
  command: rke2 server --cluster-reset --cluster-reset-restore-path={{ rke2_etcd_snapshot_destination_dir }}/{{ rke2_etcd_snapshot_file }} --token={{ rke2_token }}
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  command: rke2 server --cluster-reset --etcd-s3 --etcd-s3-access-key={{ rke2_etcd_snapshot_s3_options['access_key'] }} --etcd-s3-secret-key={{ rke2_etcd_snapshot_s3_options['secret_key'] }} --etcd-s3-bucket={{ rke2_etcd_snapshot_s3_options['bucket'] }} --etcd-s3-endpoint={{ rke2_etcd_snapshot_s3_options['endpoint'] }} --etcd-s3-region={{ rke2_etcd_snapshot_s3_options['region'] }} --etcd-s3-endpoint-ca={{ rke2_etcd_snapshot_s3_options['endpoint_ca'] }} --etcd-s3-folder={{ rke2_etcd_snapshot_s3_options['folder'] }} --etcd-s3-skip-ssl-verify={{ rke2_etcd_snapshot_s3_options['skip_ssl_verify'] }} --etcd-s3-snapshot-name={{ rke2_etcd_snapshot_s3_options['snapshot_name'] }} --token={{ rke2_token }}
  when: do_etcd_restore_from_s3 is defined


