---
- name: disable swap
  block:
    - name: disable swap immediately
      ansible.builtin.command:
        cmd: swapoff -a
      when: ansible_swaptotal_mb > 0
    - name: remove swap entry permanently
      ansible.posix.mount:
        name: swap
        state: absent
  when: vault_hardening_disable_swap
- name: disable core dumps
  loop:
    - limit_type: hard
      limit_item: core
      value: '0'
    - limit_type: soft
      limit_item: core
      value: '0'
  loop_control:
    label: "{{ limit_item }}"
  community.general.pam_limits:
    domain: '*'
    limit_type: "{{ limit_type }}"
    limit_item: "{{ limit_item }}"
    value: "{{ value }}"
  when: vault_hardening_disable_core_dumps
- name: disable shell command history
  ansible.builtin.copy:
    dest: /etc/profile.d/vault.sh
    content: export HISTIGNORE="&:vault*"
    mode: '0644'
    owner: root
    group: root
  when: vault_hardening_disable_shell_command_history
- name: configure selinux / apparmor
  block:
    - name: install selinux-policy package
      ansible.builtin.package:
        name: selinux-policy
        state: present
    - name: set selinux policy to targeted and state to enforcing
      ansible.posix.selinux:
        policy: targeted
        state: enforcing
    - name: enforce aa-profile for vault
      ansible.builtin.command:
        cmd: aa-enforce /etc/apparmor.d/usr.bin.vault
      when: ansible_apparmor.status == "enabled"
  when: vault_hardening_configure_selinux_apparmor and ansible_selinux.status == "enabled"


