            dest: "{{ rke2_install_script_dir }}/rke2.sh"
        - name: Copy local artifacts directory
          ansible.builtin.copy:
            src: "{{ rke2_airgap_copy_sourcepath }}/"
            dest: "{{ rke2_artifact_path }}/"
            mode: "0640"
            directory_mode: "0750"
