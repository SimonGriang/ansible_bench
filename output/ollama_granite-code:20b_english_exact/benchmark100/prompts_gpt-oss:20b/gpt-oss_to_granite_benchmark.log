  - Set root password
  - Systemctl daemon-reexec

- name: Configure mysql server
  loop: "{{ mysql_configuration_options }}"
  community.general.ini_file:
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: "0644"
    label: "{{ item.option }}"
  notify: Restart mysql server
  no_log: true

- name: Configure mysql client
  community.general.ini_file:
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    mode: "0644"

- name: Initialize mysql
  when:
  - ansible_distribution in mysql_initialize_command_distributions
  - not mysql_socket is match("/var/run/mysqld/mysqld.sock")
  command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/mysql

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: "0640"

- name: Create databases
  when: mysql_databases is defined
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    target: "{{ item.target | default(omit) }}"
    encoding: "{{ item.encoding | default(omit) }}"
    collation: "{{ item.collation | default(omit) }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    no_log: true
  loop: "{{ mysql_databases }}"

- name: Create users
  when: mysql_users is defined
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    state: present
    password: "{{ item.password | default(omit) }}"
    privileges: "{{ item.privileges | default(omit) }}"
    host: "{{ item.host | default(omit) }}"
    host_all: "{{ item.host_all | default(omit) }}"
    update_password: "{{ item.update_password | default(omit) }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    no_log: true
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


