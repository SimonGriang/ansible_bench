---
- name: Task 1
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2
  package:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Task 3
  copy:
    src: "{{ fail2ban_filterd_path }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: 0640
  notify: Restart fail2ban
  when: fail2ban_filterd_path is defined

- name: Task 4
  ini_file:
    path: /etc/fail2ban/fail2ban.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0640
    label: "{{ item.option }}"
  loop: "{{ fail2ban_base_configuration + fail2ban_configuration }}"
  notify: Restart fail2ban

- name: Task 5
  ini_file:
    path: /etc/fail2ban/jail.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0640
    label: "{{ item.option }}"
  loop: "{{ fail2ban_base_jail_configuration + fail2ban_jail_configuration }}"
  notify: Restart fail2ban

- name: Task 6
  stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Task 7
  file:
    path: /var/log/auth.log
    state: touch
    mode: 0640
  when: fail2ban_auth.stat.exists is defined and not fail2ban_auth.stat.exists

- name: Task 8
  service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: true


