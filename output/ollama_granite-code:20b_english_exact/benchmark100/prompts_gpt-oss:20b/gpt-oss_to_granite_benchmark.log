---
- name: lookup bootstrap facts
  ansible.builtin.raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  tags:
    - bootstrap

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: "{{ bootstrap__distribution_versions[item] }}"
  loop: "{{ bootstrap__os_family_map.values() | flatten }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout is match(bootstrap__search[item] | default(item))
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"
  tags:
    - bootstrap

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map.items() }}"
  when: item.value | list contains bootstrap_distribution
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"
  tags:
    - bootstrap


