---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  ansible.builtin.getent:
    database: passwd
    key: git_username
  register: getent_passwd
  when: git_username is defined
  no_log: true
  failed_when: false

- name: Create directory for git configuration
  ansible.builtin.file:
    path: "/home/{{ git_username }}"
    state: directory
    mode: 0755
    owner: "{{ git_username }}"
    group: "{{ git_groupname | default(omit) }}"
  when: getent_passwd is defined and getent_passwd[git_username] != "none"

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    mode: 0644
  no_log: true
  when: git_user_email is defined and git_user_name is defined and git_username is defined and getent_passwd is defined and getent_passwd[git_username] != "none"

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ git_repository_destination }}"
    state: directory
    mode: 0750
    owner: "{{ git_username }}"
    group: "{{ git_groupname | default(omit) }}"
  when: git_username is defined and git_repository_destination is defined and getent_passwd is defined and getent_passwd[git_username] != "none"

- name: Clone all roles
  loop: "{{ git_repositories }}"
  loop_control:
    label: "{{ item.dest }}"
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}/{{ item.dest }}"
    version: "{{ item.version | default(omit) }}"
    force: "{{ item.force | default(git_force) }}"
    accept_hostkey: true
    become: true
    become_user: "{{ git_username }}"
  no_log: true
  when: git_repositories is defined and git_repository_destination is defined and git_username is defined and getent_passwd is defined and getent_passwd[git_username] != "none"


