          [[ -f "{{ rke2_bin_path }}" ]] &&
          "{{ rke2_bin_path }}" version |& head -n1 | cut -d' ' -f3 ||
          echo "{{ rke2_version }}"
        )"
        running_version="$(
          if systemctl is-active --quiet {{ rke2_service_name }} && [[ -f /run/rke2/version ]]; then
            cat /run/rke2/version
          elif systemctl is-enabled --quiet {{ rke2_service_name }} && [[ -f /run/rke2/version ]]; then
            cat /run/rke2/version
          else
            echo "{{ rke2_version }}"
          fi
        )"
        echo '{"installed_version": "'${installed_version}'", "running_version": "'${running_version}'"}'
      args:
        executable: /bin/bash
      register: versions_check
      changed_when: versions_check.stdout != ""

    - name: Set RKE2 versions
      ansible.builtin.set_fact:
        installed_version: "{{ versions_check.stdout | from_json | json_query('installed_version') }}"
        running_version: "{{ versions_check.stdout | from_json | json_query('running_version') }}"
      when: not ansible_check_mode

    - name: Prevent accidental RKE2 downgrade
      ansible.builtin.assert:
        that:
          - "{{ rke2_version_clean }}" == "{{ running_version_clean }}" or
          - rke2_allow_downgrade
        fail_msg: >
          Current running version {{ running_version }} does not match desired version {{ rke2_version }}.
          To downgrade, change variable rke2_allow_downgrade to true in defaults/main.yml or provide --extra-vars '{"rke2_allow_downgrade": true}' on the command line.
        success_msg: Current running version matches desired version.
      when: not ansible_check_mode and rke2_version != 'not installed'

    - name: Run RKE2 install script
      ansible.builtin.shell: >
        if [[ "{{ rke2_version_clean }}" != "{{ running_version_clean }}" ]]; then
          if [[ "{{ rke2_airgap_mode }}" == "true" ]]; then
            INSTALL_RKE2_ARTIFACT_PATH="{{ rke2_artifact_path }}" \
            INSTALL_RKE2_AGENT_IMAGES_DIR="{{ rke2_tarball_images_path }}" \
            INSTALL_RKE2_METHOD="{{ rke2_airgap_implementation }}" \
            sh "{{ rke2_install_script_dir }}/rke2.sh";
          else
            INSTALL_RKE2_VERSION="{{ rke2_version }}" \
            INSTALL_RKE2_CHANNEL_URL="{{ rke2_channel_url }}" \
            INSTALL_RKE2_CHANNEL="{{ rke2_channel }}" \
            INSTALL_RKE2_METHOD="{{ rke2_airgap_implementation }}" \
            sh "{{ rke2_install_script_dir }}/rke2.sh";
          fi
        fi
      register: rke2_install_result
      changed_when: rke2_install_result.stdout != ""
      when: not ansible_check_mode and rke2_version != installed_version

    - name: Copy Custom Manifests
      ansible.builtin.template:
        src: "{{ item }}"
        dest: "{{ rke2_data_path }}/server/manifests/"
        owner: root
        group: root
        mode: "0644"
      loop: "{{ rke2_custom_manifests }}"
      when: rke2_custom_manifests | length > 0

    - name: Copy Static Pods
      ansible.builtin.copy:
        src: "{{ item }}"
        dest: "{{ rke2_data_path }}/agent/pod-manifests/"
        owner: root
        group: root
        mode: "0644"
      loop: "{{ rke2_static_pods }}"
      when: rke2_static_pods is defined and rke2_static_pods | length > 0

    - name: Copy RKE2 environment file
