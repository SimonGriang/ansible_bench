---
- name: Create local ssh_key_directory for {{ user.name }}
  become: false
  file:
    path: "{{ users_ssh_key_directory }}"
    state: directory
    mode: "0750"
  delegate_to: localhost
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    comment: "{{ user.comment | default(omit) }}"
    create_home: "{{ user.create_home | default(omit) }}"
    password: "{{ user.password | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    state: "{{ user.state | default('present') }}"

- name: Set sudo options for {{ user.name }}
  template:
    src: sudo.j2
    dest: "/etc/sudoers.d/{{ user.name | replace('.', 'dot') }}"
    mode: "0640"
  when: user.sudo_options is defined

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name | replace('.', 'dot') }}"
    state: absent
  when: user.sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  become: false
  command: "{{ users_ssh_keygen_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}"
  delegate_to: localhost
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Generate public ssh key for {{ user.name }}
  become: false
  command: "{{ users_ssh_keygen_pubkey_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}.pub"
  delegate_to: localhost
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Convert ssh key to ppk for {{ user.name }}
  become: false
  command: "ssh-keygen -e -m {{ users_ssh_keygen_format }} -f {{ users_ssh_key_directory }}/{{ user.name }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}.ppk"
  delegate_to: localhost
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Get or set the home directory for {{ user.name }}
  command: getent passwd {{ user.name }}
  args:
    warn: false
  register: users_get_home_directory
  changed_when: false

- set_fact:
    users_home_directory: "{{ users_get_home_directory.stdout.split(':')[5] | default('/home') }}"
  when: users_get_home_directory.stdout is defined

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ users_home_directory }}/{{ user.name }}/.ssh"
    state: directory
    mode: "0700"
  become: true
  become_user: "{{ user.name }}"
  when: (user.manage_ssh_key is defined and user.manage_ssh_key) or (user.private_keys is defined)

- name: Deploy authorized keys for {{ user.name }}
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    path: "{{ users_home_directory }}/{{ user.name }}/.ssh/authorized_keys"
  loop: "{{ user.authorized_keys | default([]) }}"
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for {{ user.name }}
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    path: "{{ users_home_directory }}/{{ user.name }}/.ssh/authorized_keys"
    state: absent
  loop: "{{ user.unauthorized_keys | default([]) }}"
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}"
    dest: "{{ users_home_directory }}/{{ user.name }}/.ssh/id_rsa"
    mode: "0400"
    owner: "{{ user.name }}"
  when: users_manage_user is defined and user.copy_private_key

- name: Check users password valid time for {{ user.name }}
  shell: awk -F: '$1 == "{{ user.name }}" {print $2}' /etc/shadow | cut -d$ --fields=4
  changed_when: false
  register: users_get_pw_valid
  when: user.state is not defined or user.state != "absent"

- set_fact:
    users_pw_valid: "{{ users_get_pw_valid.stdout | int }}"
  when: users_get_pw_valid.stdout is defined

- name: Set users password valid time for {{ user.name }}
  command: chage -M {{ user.password_validity_days }} {{ user.name }}
  when: users_pw_valid is defined and users_pw_valid != user.password_validity_days

- name: Place private key file for {{ user.name }}
  copy:
    dest: "{{ users_home_directory }}/{{ user.name }}/.ssh/{{ item.name }}"
    content: "{{ item.content }}"
    mode: "0400"
    owner: "{{ user.name }}"
  loop: "{{ user.private_keys | default([]) }}"
  when: user.private_keys is defined


