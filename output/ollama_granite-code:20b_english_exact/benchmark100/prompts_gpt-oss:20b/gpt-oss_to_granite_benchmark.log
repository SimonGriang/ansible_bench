---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- block:
    - name: Update apk cache
      community.general.apk:
        update_cache: true
      changed_when: false
    - name: Upgrade apk packages
      community.general.apk:
        upgrade: true
      notify: Reboot
  when: ansible_pkg_mgr == "apk"

- block:
    - name: Hold selected packages
      ansible.builtin.dpkg_selections:
        name: "{{ item }}"
        selection: hold
      loop: "{{ update_excluded_packages }}"
    - name: Update apt cache
      ansible.builtin.apt:
        update_cache: true
        upgrade: "{{ update_upgrade_command }}"
        cache_valid_time: "{{ update_cache_valid_time }}"
      environment:
        DEBIAN_FRONTEND: nointeractive
      notify: Reboot
    - name: Autoremove packages
      ansible.builtin.apt:
        autoremove: "{{ update_autoremove }}"
  when: ansible_pkg_mgr == "apt"

- name: Update all software
  ansible.builtin.dnf:
    name: '*'
    state: latest
    exclude: "{{ update_excluded_packages }}"
  notify: Reboot
  when: ansible_pkg_mgr == "dnf" or ansible_pkg_mgr == "dnf5"

- name: Update all software
  community.general.pacman:
    update_cache: true
    upgrade: true
  notify: Reboot
  when: ansible_pkg_mgr == "pacman"

- block:
    - name: Upgrade all packages
      ansible.builtin.dnf:
        name: '*'
        state: latest
        exclude: "{{ update_excluded_packages }}"
      notify: Reboot
    - name: Install yum-utils
      ansible.builtin.package:
        name: yum-utils
        state: present
  when: ansible_pkg_mgr == "yum"

- name: Update all software
  community.general.zypper:
    name: '*'
    state: latest
  notify: Reboot
  when: ansible_pkg_mgr == "zypper"


