---
- name: Import assert.yml
  import_tasks: assert.yml
- name: Install python pip
  ansible.builtin.package:
    name: "{{ python_pip_packages }}"
    state: present
- name: Configure pip proxy
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "index-url = {{ python_pip_proxy }}"
    create: true
    mode: "0644"
  when: python_pip_proxy is defined
- name: Trust hosts
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    create: true
    mode: "0644"
  when: python_pip_trusted_host is defined
- name: Update pip
  ansible.builtin.pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable | default(omit) }}"
    update_cache: true
  when: python_pip_update and not (ansible_distribution == "Bookworm" or ansible_distribution == "Noble") and not (ansible_os_family == "Alpine")
- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(omit) }}"
    executable: "{{ python_pip_executable | default(omit) }}"
  loop: "{{ python_pip_modules }}"
  when: not (ansible_distribution == "Bookworm" or ansible_distribution == "Noble") and not (ansible_os_family == "Alpine")


