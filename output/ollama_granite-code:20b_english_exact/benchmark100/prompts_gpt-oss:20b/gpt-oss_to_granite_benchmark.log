---
- name: Prepare system
  block:
    - name: Import assert.yml
      ansible.builtin.import_tasks: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Wait for port to be available
      ansible.builtin.wait_for:
        port: 22
        timeout: "{{ bootstrap_timeout }}"
      when: ansible_connection is defined and not ansible_connection == 'container' and bootstrap_wait_for_host

    - name: Test connection
      ansible.builtin.wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: bootstrap_connect
      changed_when: false

    - name: Test sudo
      ansible.builtin.command: sudo --version
      changed_when: false
  rescue:
    - name: Gather bootstrap facts
      ansible.builtin.include_tasks: gather_facts.yml
    - name: Install bootstrap packages (raw)
      ansible.builtin.raw: "{{ bootstrap_install.raw }}"
      executable: /bin/sh
      register: bootstrap_install_packages
      changed_when: "'already installed' in bootstrap_install_packages.stdout or (ansible_os_family == 'Debian' and 'All packages are up to date' in bootstrap_install_packages.stdout)"
      failed_when: bootstrap_install_packages.stderr or (ansible_os_family == 'RedHat' and ' cannot be installed' in bootstrap_install_packages.stdout and bootstrap_install_packages.rc != 0)
    - name: Ensure libdnf5 is present on Fedora/RedHat
      ansible.builtin.raw: dnf install -y python3-libdnf5
      changed_when: false
      when: ansible_os_family == 'RedHat'
    - name: Gather ansible facts
      ansible.builtin.setup:
      become: false
  always:
    - name: Gather ansible facts
      ansible.builtin.setup:
      become: false

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages.split() }}"
    state: present
    update_cache: true
    become: "{{ bootstrap_become }}"


