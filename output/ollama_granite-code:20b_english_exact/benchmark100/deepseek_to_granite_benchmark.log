---
- name: Import assert.yml
  import_tasks: assert.yml
  tags:
    - bootstrap

- name: Wait for port to be available
  wait_for:
    port: "{{ item.port }}"
    host: "{{ item.host }}"
    search_regex: open
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  loop: "{{ query('dict', hostvars[inventory_hostname]['ansible_facts']['all_ listening_ports']) }}"
  loop_control:
    label: "{{ item.host }}:{{ item.port }}"
  when: item. protocol == 'tcp'
  changed_when: false
  tags:
    - bootstrap

- name: Prepare system
  block:
    - name: Test connection
      command: echo ok
      changed_when: false
    - name: Test sudo access
      command: sudo echo ok
      changed_when: false
    - name: Install python
      raw: "yum install -y python"
      when: ansible_os_family == "RedHat"
    - name: Install python
      raw: "apt install -y python"
      when: ansible_os_family == "Debian"
    - name: Ensure libdnf5 is installed
      raw: "yum install -y libdnf5"
      when: ansible_os_family == "RedHat"
  tags:
    - bootstrap

- name: Gather ansible facts
  setup:
    gather_subset: all
  become: false
  tags:
    - bootstrap

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"
  tags:
    - bootstrap


