---
- name: cadvisor | create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: '0755'
  loop:
    - /opt/cadvisor
    - /etc/systemd/system/cadvisor.service.d

- name: cadvisor | download
  get_url:
    url: https://github.com/google/cadvisor/releases/download/v0.36.0/cadvisor
    dest: /opt/cadvisor/cadvisor
    checksum: "sha256:{{ cadvisor_sha256sum }}"
    mode: '0755'

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: /tmp/cadvisor
    dest: /opt/cadvisor/cadvisor
    owner: root
    group: root
    mode: '0755'
    remote_src: true
  notify: restart cadvisor

- name: cadvisor | symlink
  file:
    src: /opt/cadvisor/cadvisor
    dest: /usr/local/bin/cadvisor
    owner: root
    group: root
    state: link

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    owner: root
    group: root
    mode: '0644'
  notify: restart cadvisor

- name: test_task
  service_facts:

- name: debug | var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemd:
    name: cadvisor
    enabled: yes

- name: cadvisor | start server systemd
  systemd:
    name: cadvisor
    state: started
    daemon_reload: yes


