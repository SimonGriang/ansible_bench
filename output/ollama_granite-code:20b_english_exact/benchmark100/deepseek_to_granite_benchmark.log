---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Install prerequisites
  package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Task 3 - Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Task 4 - Add Vault environment variables
  lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item.key }}={{ item.value }}"
    create: true
  loop: "{{ vault_environment_settings | dict2items }}"
  notify: Restart vault

- name: Task 5 - Include hardening tasks
  include_tasks: hardening.yml

- name: Task 6 - Start and enable vault (for OSS type)
  service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"

- name: Task 7 - Enable vault (for non-OSS type)
  service:
    name: vault
    enabled: true
  when: vault_type != "oss"


