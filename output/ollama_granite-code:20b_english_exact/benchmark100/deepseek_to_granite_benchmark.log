---
- name: Include OS-specific variables
  include_vars: "{{ item }}"
  with_first_found:
    - files:
      - "{{ ansible_os_family }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
      - "{{ ansible_os_family }}-{{ ansible_distribution }}.yml"
      - "{{ ansible_os_family }}-{{ ansible_os_family }}.yml"
      - "{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
      - "{{ ansible_distribution }}.yml"
      - "{{ ansible_os_family }}.yml"
      paths:
      - vars

- name: Include OS family specific tasks
  include_tasks: "{{ item }}"
  with_first_found:
    - files:
      - "{{ ansible_os_family }}.yml"
      paths:
      - tasks

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_version.full is version('2.12', '<') }}"
  when: ansible_os_family != "Windows"

- name: Install Docker packages with downgrade option
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    update_cache: yes
    cache_valid_time: 3600
  notify: restart docker
  ignore_errors: "{{ ansible_version.full is version('2.12', '>=') }}"
  when: ansible_os_family != "Windows"

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_version.full is version('2.12', '<') }}"
  when: docker_install_compose_plugin and ansible_os_family != "Windows"

- name: Install docker-compose-plugin with downgrade option
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    update_cache: yes
    cache_valid_time: 3600
  notify: restart docker
  ignore_errors: "{{ ansible_version.full is version('2.12', '>=') }}"
  when: docker_install_compose_plugin and ansible_os_family != "Windows"

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    state: directory
    mode: 0755
  when: docker_daemon_options is defined

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options | to_json }}"
    dest: /etc/docker/daemon.json
    mode: 0644
  notify: restart docker
  when: docker_daemon_options is defined

- name: Ensure Docker service is started and enabled
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: yes
  when: docker_service_manage

- name: Flush handlers to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose.yml tasks
  include: docker-compose.yml
  when: docker_install_compose

- name: Get docker group information
  getent:
    database: group
    key: docker

- name: Set fact for user modification
  set_fact:
    docker_user_modifications_required: true
  when: docker_users is defined and docker_group.docker is not defined

- name: Include docker-users.yml tasks
  include: docker-users.yml
  when: docker_user_modifications_required is defined and docker_user_modifications_required



