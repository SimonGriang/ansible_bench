}"\n  notify: restart mysql\n\n- name: Task 13 - Flush handlers again\n  meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-10T08:49:03.387605892Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13102007751, 'load_duration': 29622950, 'prompt_eval_count': 662, 'prompt_eval_duration': 417423428, 'eval_count': 595, 'eval_duration': 12653560576, 'model_name': 'granite-code:20b'} id='run--0922d0b8-070a-4e72-aaf8-1b52675ef3e5-0' usage_metadata={'input_tokens': 662, 'output_tokens': 595, 'total_tokens': 1257}
