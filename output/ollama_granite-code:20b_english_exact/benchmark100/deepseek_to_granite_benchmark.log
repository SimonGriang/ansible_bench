---
- name: Task 1
  import_tasks: assert.yml
  run_once: true

- name: Task 2
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Task 3
  meta: flush_handlers

- name: Task 4
  when: selinux_status is defined and (ansible_connection != 'container' and ansible_connection != 'docker' and ansible_connection != 'community.docker.docker')
  block:
    - name: Task 4.1
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Task 4.2
      selinux:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
        label: "{{ item.name }}"
      loop: "{{ selinux_booleans }}"
      when: selinux_booleans is defined
      no_log: true

  handlers:
    - name: Reboot
      command: reboot
      async: 0
      poll: 0
      ignore_errors: true
      when: ansible_connection != 'container' and ansible_connection != 'docker' and ansible_connection != 'community.docker.docker'



