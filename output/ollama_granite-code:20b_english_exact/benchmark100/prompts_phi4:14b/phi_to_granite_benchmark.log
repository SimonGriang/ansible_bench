---
- name: Ensure local directory exists for storing SSH keys of users with SSH key management enabled
  file:
    path: "{{ ssh_key_directory }}"
    owner: "{{ ansible_user_id }}"
    group: "{{ ansible_user_id }}"
    mode: 0700
    state: directory
  when: ssh_key_management_enabled

- name: Create or update user accounts with specified attributes
  user:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    comment: "{{ item.comment }}"
    home: "{{ item.home }}"
    shell: "{{ item.shell }}"
    groups: "{{ item.groups }}"
  register: user_creation_result
  when: item.state != "absent"

- name: Configure sudo privileges for users with sudo options defined
  copy:
    dest: /etc/sudoers.d/{{ item.name }}
    content: "{{ item.sudoers_content }}"
    owner: root
    group: root
    mode: 0440
  when: item.sudoers_content is defined

- name: Delete sudoers file for users with sudo options not defined
  file:
    path: /etc/sudoers.d/{{ item.name }}
    state: absent
  when: item.sudoers_content is not defined

- name: Create private SSH key for users with SSH key management enabled
  command: "ssh-keygen -q -N '' -f {{ ssh_key_directory }}/{{ item.name }}"
  register: private_key_creation_result
  changed_when: "'Enter pass phrase' in private_key_creation_result.stdout"
  when: ssh_key_management_enabled and item.name not in ssh_keys_present.stdout_lines

- name: Create public SSH key for users with SSH key management enabled
  command: "ssh-keygen -y -f {{ ssh_key_directory }}/{{ item.name }} > {{ ssh_key_directory }}/{{ item.name }}.pub"
  register: public_key_creation_result
  changed_when: "'Enter pass phrase' in public_key_creation_result.stdout"
  when: ssh_key_management_enabled and item.name not in ssh_keys_present.stdout_lines

- name: Convert SSH key to PPK format for users with SSH key management enabled
  command: "puttygen {{ ssh_key_directory }}/{{ item.name }} -o {{ ssh_key_directory }}/{{ item.name }}.ppk -O private-ssh-key -passphrase ''"
  register: ppk_conversion_result
  changed_when: "'Enter pass phrase' in ppk_conversion_result.stdout"
  when: ssh_key_management_enabled and item.name not in ssh_keys_present.stdout_lines

- name: Retrieve or set the base home directory for users
  command: "getent passwd {{ item.name }} | cut -d: -f6"
  register: home_directory_result
  changed_when: false
  ignore_errors: true
  when: item.home == "auto"

- name: Create .ssh directory in the user's home directory if necessary
  file:
    path: "{{ home_directory_result.stdout }}/.ssh"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
    mode: 0700
    state: directory
  when: (ssh_key_management_enabled or item.ssh_private_key is defined) and item.home == "auto"

- name: Add specified authorized SSH keys to the user's authorized_keys file
  copy:
    dest: "{{ home_directory_result.stdout }}/.ssh/authorized_keys"
    content: "{{ item.ssh_authorized_keys }}"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
    mode: 0600
  when: item.ssh_authorized_keys is defined

- name: Remove specified unauthorized SSH keys from the user's authorized_keys file
  lineinfile:
    path: "{{ home_directory_result.stdout }}/.ssh/authorized_keys"
    regexp: '.*{{ item.unauthorized_ssh_keys }}$'
    state: absent
  when: item.unauthorized_ssh_keys is defined

- name: Copy generated private SSH keys to the user's .ssh directory if specified
  copy:
    dest: "{{ home_directory_result.stdout }}/.ssh/{{ item.name }}"
    content: "{{ item.ssh_private_key }}"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
    mode: 0600
  when: item.ssh_private_key is defined

- name: Retrieve the current password validity period for users
  command: "getent shadow {{ item.name }} | cut -d: -f4"
  register: password_validity_period_result
  changed_when: false
  when: item.password_validity_days is defined

- name: Set the password validity period for users if specified
  user:
    name: "{{ item.name }}"
    password_validity_days: "{{ item.password_validity_days }}"
  when: item.password_validity_days is defined and item.password_validity_days != password_validity_period_result.stdout

- name: Place additional private key files in the user's .ssh directory if specified
  copy:
    dest: "{{ home_directory_result.stdout }}/.ssh/{{ item.name }}.{{ item.ssh_private_key_extension }}"
    content: "{{ item.ssh_private_key }}"
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
    mode: 0600
  when: item.ssh_private_key is defined and item.ssh_private_key_extension is defined




