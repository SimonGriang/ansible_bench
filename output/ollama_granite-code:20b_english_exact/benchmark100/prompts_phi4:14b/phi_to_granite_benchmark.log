        - root
        - "@{{ ansible_user_id }}"
      when: vault_hardening_disable_core_dumps

    - name: Disable shell command history for vault commands
      copy:
        dest: /etc/profile.d/vault_history.sh
        content: |
          if [ "$ historical" = "1" ]; then
            export historical=
          else
            export historical=history
          fi
          alias ls='ls --color=auto'
          alias ll='ls -l'
          alias l='ls -lA1'
          alias grep='grep --color=auto'
          alias egrep='egrep --color=auto'
          alias fgrep='fgrep --color=auto'
          alias vault='history -a; history -c; history -d {{ historical }}'
        mode: 0644
        owner: root
        group: root
      when: vault_hardening_disable_shell_command_history

    - name: Configure SELinux
      block:
        - name: Install selinux-policy
          package:
            name: selinux-policy
            state: present

        - name: Set selinux-policy to enforcing
          selinux:
            policy: targeted
            state: enforcing
      when: ansible_selinux.status == "enabled" and vault_hardening_configure_selinux_apparmor

    - name: Configure AppArmor
      apparmor:
        name: vault
        state: enforcing
        profile: "{{ vault_apparmor_profile }}"
      when: vault_hardening_configure_selinux_apparmor
  when: vault_hardening_enabled


