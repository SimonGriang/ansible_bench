---
- name: HTTPD configuration
  hosts: all
  tasks:
    - name: Create document root directories
      file:
        path: "{{ httpd_vhosts[item].documentroot }}"
        state: directory
        owner: "{{ httpd_vhosts[item].owner | default(omit) }}"
        group: "{{ httpd_vhosts[item].group | default(omit) }}"
        mode: "{{ httpd_vhosts[item].mode | default(omit) }}"
      loop: "{{ httpd_vhosts }}"
      when:
        - httpd_vhosts is defined
        - httpd_vhosts[item].documentroot is defined
        - httpd_vhosts[item].create_docroot | default(true)
      notify:
        - Test HTTPD configuration
        - Restart HTTPD

    - name: Configure virtual host configuration files
      template:
        src: "{{ vhost_conf_template }}"
        dest: "{{ httpd_vhosts_directory }}/{{ httpd_vhosts[item].servername }}.conf"
        owner: root
        group: root
        mode: 0644
      loop: "{{ httpd_vhosts }}"
      notify:
        - Test HTTPD configuration
        - Restart HTTPD

    - name: Enable virtual hosts on Debian-based systems
      command: a2ensite {{ httpd_vhosts[item].servername }}.conf
      loop: "{{ httpd_vhosts }}"
      when: ansible_os_family == 'Debian'
      notify:
        - Test HTTPD configuration
        - Restart HTTPD


