---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install bash package
  package:
    name: bash
    state: present

- name: Install OpenJDK
  package:
    name: "{{ java_openjdk_package }}"
    state: present
    env:
      JAVA_HOME: "{{ java_home }}"
  when:
    - java_vendor == "openjdk"

- name: Copy Oracle Java RPM package to /tmp and install
  copy:
    src: "{{ java_oracle_rpm }}"
    dest: /tmp
  when:
    - java_source == "local"
    - java_format == "rpm"
  notify:
    - Install Oracle Java

- name: Copy Oracle Java DEB package to /tmp and install
  copy:
    src: "{{ java_oracle_deb }}"
    dest: /tmp
  when:
    - java_source == "local"
    - java_format == "deb"
  notify:
    - Install Oracle Java

- name: Install Oracle Java RPM package
  package:
    name: "{{ java_oracle_package }}"
    state: present
  when:
    - java_source == "repository"
    - java_format == "rpm"

- name: Ensure Oracle Java installation directory exists
  file:
    path: "{{ java_oracle_home }}"
    state: directory
    owner: root
    group: root
    mode: 0755
  when:
    - java_format == "targz"
    - java_vendor == "oracle"

- name: Extract Oracle Java tarball to installation directory
  unarchive:
    src: "{{ java_oracle_targz }}"
    dest: "{{ java_oracle_home }}"
    owner: root
    group: root
    mode: 0755
  when:
    - java_format == "targz"
    - java_vendor == "oracle"
  notify:
    - Install Oracle Java Cryptography Extension (JCE) policy software

- name: Install Oracle Java Cryptography Extension (JCE) policy software
  unarchive:
    src: "{{ java_jce_zip }}"
    dest: /usr/java
    owner: root
    group: root
    mode: 0644
  when:
    - java_version == "8"
    - java_jce == "yes"
    - java_vendor == "oracle"
  notify:
    - Set Java as default alternative

- name: Set Java as default alternative
  alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_oracle_home }}/bin/java"
  when:
    - java_format == "targz"
    - java_distribution != "alpine"
    - java_vendor == "oracle"

- name: Determine JAVA_HOME directory
  shell: |
    readlink -f `which java`
  register: java_home_output

- name: Set JAVA_HOME environment variable in /etc/profile.d/java_home.sh
  lineinfile:
    dest: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home_output.stdout }}"
    create: true
    mode: 0644


