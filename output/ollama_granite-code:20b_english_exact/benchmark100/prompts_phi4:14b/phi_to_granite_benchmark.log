---
- name: Set up RKE2 configuration
  tasks:
    - name: Create RKE2 configuration directory
      file:
        path: /etc/rancher/rke2
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Template RKE2 configuration file
      template:
        src: "{{ rke2_config }}"
        dest: /etc/rancher/rke2/config.yaml
        owner: root
        group: root
        mode: '0600'
      notify: Config file changed

    - name: Template kubelet configuration file
      template:
        src: templates/kubelet-config.yaml.j2
        dest: /etc/rancher/rke2/kubelet-config.yaml
        owner: root
        group: root
        mode: '0600'
      when: rke2_kubelet_config != ""
      notify: Config file changed

    - name: Configure Containerd registry settings
      copy:
        src: "{{ rke2_custom_registry_path }}"
        dest: /etc/rancher/rke2/registries.yaml
        owner: root
        group: root
        mode: '0600'
      when: rke2_custom_registry_mirrors is defined or rke2_custom_registry_configs is defined
      notify: Config file changed

    - name: Restore etcd from snapshot file
      block:
        - name: Create snapshot directory
          file:
            path: /opt/rke2/snapshots
            state: directory
            owner: root
            group: root
            mode: '0755'

        - name: Copy snapshot file
          copy:
            src: "{{ rke2_etcd_snapshot }}"
            dest: /opt/rke2/snapshots
            owner: root
            group: root
            mode: '0600'

        - name: Restore etcd from snapshot
          command: rke2 server --upload-snapshot {{ rke2_etcd_snapshot }}
          changed_when: true
      when: do_etcd_restore

    - name: Restore etcd from S3 snapshot
      command: rke2 server --s3-snapshot-name {{ rke2_etcd_snapshot }} --s3-bucket {{ rke2_s3_bucket }} --s3-endpoint {{ rke2_s3_endpoint }} --s3-access-key {{ rke2_s3_access_key }} --s3-secret-key {{ rke2_s3_secret_key }}
      changed_when: true
      when: do_etcd_restore_from_s3

    - name: Start RKE2 server service
      service:
        name: rke2-server.service
        state: started
        enabled: true
        env:
          RKE2_TOKEN: "{{ rke2_token }}"
      notify: Service (re)started

    - name: Mask RKE2 agent service
      service:
        name: rke2-agent.service
        enabled: false
        masked: true

    - name: Wait for server readiness (no CNI)
      command: kubectl wait --for=condition=Ready node {{ inventory_hostname }}
      retries: 100
      delay: 15
      when: rke2_cni == 'none'

    - name: Wait for server readiness (with CNI)
      command: kubectl get node {{ inventory_hostname }}
      retries: 40
      delay: 15
      when: rke2_cni != 'none'

    - name: Clean up old nodes and secrets
      block:
        - name: Get registered node names
          command: kubectl get node -o jsonpath='{range.items[*].metadata}{.name} {end}'
          register: rke2_registered_nodes

        - name: Get node names present in inventory
          command: hostname
          register: rke2_inventory_nodes

        - name: Delete old secrets
          command: kubectl delete secret -n kube-system {{ item }}
          with_items:
            - rke2-machine-bootstrap
            - rke2-node-token
          ignore_errors: true

        - name: Identify nodes no longer present
          set_fact:
            rke2_nodes_to_delete: "{{ rke2_registered_nodes.stdout_lines | difference(rke2_inventory_nodes.stdout_lines) }}"

        - name: Delete old nodes
          command: kubectl delete node {{ item }}
          with_items: "{{ rke2_nodes_to_delete }}"
          ignore_errors: true
      when: do_etcd_restore or do_etcd_restore_from_s3

    - name: Set active server variable
      add_host:
        name: active_server
        ansible_host: "{{ hostvars[inventory_hostname]['ansible_host'] }}"
        groups: rke2_cluster_group_name

- name: handlers
  handlers:
    - name: Config file changed
      debug:
        msg: "RKE2 config file changed"

    - name: Service (re)started
      debug:
        msg: "RKE2 service restarted"
