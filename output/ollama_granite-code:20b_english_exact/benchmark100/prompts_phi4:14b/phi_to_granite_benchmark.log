      when: not (bootstrap_container | default(False) or bootstrap_docker | default(False)) and bootstrap_install_bootstrap

    - name: Gather Ansible facts
      setup:
      when: bootstrap_gather_facts

    - name: Install necessary packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        update_cache: yes
      become: "{{ bootstrap_become }}"



