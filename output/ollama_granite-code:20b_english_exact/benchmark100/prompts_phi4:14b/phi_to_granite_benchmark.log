---
- name: "cadvisor | Create necessary directories for cadvisor"
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: root
    group: root
  loop:
    - "{{ cadvisor_data_dir }}"
    - "{{ cadvisor_log_dir }}"
  become: yes

- name: "cadvisor | Download cadvisor binary from {{ cadvisor_download_url }}"
  ansible.builtin.get_url:
    url: "{{ cadvisor_download_url }}"
    dest: "{{ cadvisor_binary_install_dir }}/cadvisor"
    owner: root
    group: root
    mode: 0755
    checksum: "sha256:{{ cadvisor_checksum }}"
  when: cadvisor_binary_local_dir is not defined
  become: yes

- name: "cadvisor | Copy locally distributed cadvisor binary"
  ansible.builtin.copy:
    src: "{{ cadvisor_binary_local_dir }}/cadvisor"
    dest: "{{ cadvisor_binary_install_dir }}/cadvisor"
    owner: root
    group: root
    mode: 0755
  notify: restart cadvisor
  when: cadvisor_binary_local_dir is defined
  become: yes

- name: "cadvisor | Create symbolic link to cadvisor binary"
  ansible.builtin.file:
    src: "{{ cadvisor_binary_install_dir }}/cadvisor"
    dest: "{{ cadvisor_install_dir }}/bin/cadvisor"
    owner: root
    group: root
    state: link
  become: yes

- name: "cadvisor | Deploy systemd service file for cadvisor server"
  ansible.builtin.template:
    src: "cadvisor.service.j2"
    dest: "{{ cadvisor_service_file_dir }}/cadvisor.service"
    owner: root
    group: root
    mode: 0644
  notify: restart cadvisor
  become: yes

- name: "cadvisor | Test if cadvisor service is active"
  ansible.builtin.shell: "systemctl status {{ cadvisor_service_name }} | grep -q 'Active: active (running)'"
  register: service_status
  changed_when: false
  failed_when: false
  become: yes

- name: "cadvisor | Debug the output of service activity check"
  ansible.builtin.debug:
    var: service_status

- name: "cadvisor | Enable cadvisor systemd service to start on boot"
  ansible.builtin.systemd:
    name: "{{ cadvisor_service_name }}"
    enabled: yes
  become: yes

- name: "cadvisor | Start cadvisor systemd service immediately"
  ansible.builtin.systemd:
    name: "{{ cadvisor_service_name }}"
    state: started
    daemon_reload: yes
  become: yes


