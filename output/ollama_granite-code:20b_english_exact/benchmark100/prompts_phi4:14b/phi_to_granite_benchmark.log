---
- name: Service configuration
  tasks:
    - import_tasks: assert.yml
    - name: Install required packages
      package:
        name: "{{ service_required_packages }}"
        state: present
      notify: Gather facts
    - name: Configure systemd services
      template:
        src: systemd.j2
        dest: "/etc/systemd/system/{{ item.name }}.service"
        mode: 0644
      loop: "{{ service_list }}"
      notify: Systemctl daemon-reload
      when: service_manager == "systemd"
    - name: Configure sysvinit services
      template:
        src: sysvinit.j2
        dest: "/etc/init.d/{{ item.name }}"
        mode: 0755
      loop: "{{ service_list }}"
      when: service_manager in ["sysvinit", "upstart", "openrc"]
    - name: Manage service state and enablement
      service:
        name: "{{ item.name }}"
        state: "{{ item.state | default(omit) }}"
        enabled: "{{ item.enabled | default(omit) }}"
      loop: "{{ service_list }}"
      when: item.state is defined or item.enabled is defined
    - name: Flush handlers
      meta: flush_handlers


