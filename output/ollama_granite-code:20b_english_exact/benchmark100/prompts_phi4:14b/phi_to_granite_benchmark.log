        - bootstrap_distribution is not defined
        - bootstrap_os_release['NAME'] in bootstrap_os_family_map
        - bootstrap_os_release['PRETTY_NAME'] | regex_search(bootstrap_os_family_map[bootstrap_os_release['NAME']])
    - name: Set bootstrap operating system family based on the distribution.
      set_fact:
        bootstrap_os_family: "{{ item.value }}"
      loop: "{{ bootstrap_os_family_map | dict2items }}"
      when:
        - bootstrap_facts.stdout_lines is defined
        - bootstrap_distribution is defined


