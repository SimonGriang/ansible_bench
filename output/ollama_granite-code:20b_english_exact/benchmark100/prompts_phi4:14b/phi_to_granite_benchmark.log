content='---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  run_once: yes\n  delegate_to: localhost\n\n- name: Install prerequisites for Vault\n  package:\n    name: "{{ vault_prerequisites }}"\n    state: present\n\n- name: Include installation method-specific tasks\n  include_tasks: "{{ vault_installation_method }}.yml"\n\n- name: Add environment variables for Vault\n  lineinfile:\n    path: /etc/vault.d/vault.env\n    regexp: "^{{ item.key }}="\n    line: "{{ item.key }}={{ item.value }}"\n    create: yes\n  loop: "{{ vault_environment_variables | dict2items }}"\n  notify: restart Vault\n\n- name: Include hardening tasks\n  include_tasks: hardening.yml\n\n- name: Start and enable Vault service for OSS\n  service:\n    name: vault\n    state: started\n    enabled: yes\n  when: vault_type == "oss"\n\n- name: Enable Vault service for non-OSS versions\n  service:\n    name: vault\n    enabled: yes\n  when: vault_type != "oss"' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-14T18:12:14.794834343Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4637656750, 'load_duration': 32577915, 'prompt_eval_count': 582, 'prompt_eval_duration': 364869525, 'eval_count': 244, 'eval_duration': 4239135091, 'model_name': 'granite-code:20b'} id='run--9c559347-a623-4b9e-9285-bdaee63968a0-0' usage_metadata={'input_tokens': 582, 'output_tokens': 244, 'total_tokens': 826}
