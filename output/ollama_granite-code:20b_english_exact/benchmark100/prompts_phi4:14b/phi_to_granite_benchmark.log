---
- name: Download RKE2 kubeconfig file
  ansible.builtin.fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: "{{ rke2_download_kubeconf_path | default('/tmp') }}/{{ rke2_download_kubeconf_file_name | default('kubeconfig') }}"
    flat: true
    when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]
  delegate_to: localhost
  run_once: true

- name: Replace loopback IP addresses in kubeconfig file
  ansible.builtin.replace:
    path: "{{ rke2_download_kubeconf_path | default('/tmp') }}/{{ rke2_download_kubeconf_file_name | default('kubeconfig') }}"
    regexp: '127.0.0.1|([::1])'
    replace: "{{ rke2_api_ip | default(hostvars[groups[rke2_servers_group_name][0]].ansible_host) }}"
    mode: 0600
    backup: true
    when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]
  delegate_to: localhost
  run_once: true



