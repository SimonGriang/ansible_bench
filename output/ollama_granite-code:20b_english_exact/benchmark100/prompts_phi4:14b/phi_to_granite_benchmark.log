---
- name: Ensure the system is using systemd as the init system
  assert:
    that: ansible_service_mgr == "systemd"
    msg: "This playbook only works with systemd."

- name: Get latest release information for Grafana Loki
  uri:
    url: https://api.github.com/repos/grafana/loki/releases
    return_content: yes
    validate_certs: no
    status_code: 200
    body_format: json
    url_username: "{{ lookup('env', 'GH_USERNAME') }}"
    url_password: "{{ lookup('env', 'GH_TOKEN') }}"
  register: release_info
  until: release_info.json | length > 0
  retries: 5
  delay: 2
  when: promtail_version == "latest"

- name: Verify local promtail binary archive
  stat:
    path: "{{ promtail_binary_local_dir }}/promtail"
  register: promtail_binary
  when: promtail_binary_local_dir is defined

- name: Fetch checksum list for specified version
  url:
    url: https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/SHA256SUMS
    return_content: yes
    status_code: 200
    body_format: text
  register: sha256sums
  when: promtail_binary_local_dir is not defined

- name: Verify checksum for promtail binary
  get_url:
    url: https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/promtail_{{ promtail_system_arch }}.zip
    dest: "{{ promtail_download_dir }}/promtail_{{ promtail_system_arch }}.zip"
    checksum: "sha256:{{ sha256sums.content.split(' ')[1] }}"
    mode: 0644


