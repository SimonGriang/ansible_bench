 defined\n\n- name: Set the password validity period for users if specified\n  user:\n    name: "{{ item.name }}"\n    password_validity_days: "{{ item.password_validity_days }}"\n  when: item.password_validity_days is defined and item.password_validity_days != password_validity_period_result.stdout\n\n- name: Place additional private key files in the user\'s .ssh directory if specified\n  copy:\n    dest: "{{ home_directory_result.stdout }}/.ssh/{{ item.name }}.{{ item.ssh_private_key_extension }}"\n    content: "{{ item.ssh_private_key }}"\n    owner: "{{ item.name }}"\n    group: "{{ item.name }}"\n    mode: 0600\n  when: item.ssh_private_key is defined and item.ssh_private_key_extension is defined' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-14T18:58:28.09020438Z', 'done': True, 'done_reason': 'stop', 'total_duration': 33336320405, 'load_duration': 34404004, 'prompt_eval_count': 2696, 'prompt_eval_duration': 214153492, 'eval_count': 1268, 'eval_duration': 33085836174, 'model_name': 'granite-code:20b'} id='run--40a48758-6c93-4813-b6d9-03c450d9f7d5-0' usage_metadata={'input_tokens': 2696, 'output_tokens': 1268, 'total_tokens': 3964}
