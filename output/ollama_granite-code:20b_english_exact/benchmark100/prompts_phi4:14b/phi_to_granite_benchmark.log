---

- name: Create etcd group
  ansible.builtin.group:
    name: etcd
    state: present

- name: Create etcd user
  ansible.builtin.user:
    name: etcd
    group: etcd
    shell: /bin/nologin
    comment: etcd user
    state: present

- name: Copy kernel hardening sysctl configuration file
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: 0600
    owner: root
    group: root
    notify: Restart systemd-sysctl
  loop:
    - /usr/local/share/rke2/rke2-cis-sysctl.conf
    - /opt/rke2/share/rke2/rke2-cis-sysctl.conf
  register: kernel_hardening_sysctl_configuration
  changed_when: kernel_hardening_sysctl_configuration.src != kernel_hardening_sysctl_configuration.dest
  when:
    - ansible_connection != "container"
    - (ansible_local is not defined or ansible_local.system.partition is not defined or ansible_local.system.partition == "primary")
  tags:
    - CIS-2.1
    - CIS-2.2
