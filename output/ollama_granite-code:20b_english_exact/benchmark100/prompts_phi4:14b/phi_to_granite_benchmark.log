---

- import_tasks: assert.yml
  delegate_to: localhost

- name: Install PHP
  ansible.builtin.package:
    name: "{{ php_packages }}"
    state: present

- name: Find php.ini location
  ansible.builtin.shell: "{{ php_ini_command }}"
  register: php_found_ini_location
  changed_when: false
  when: php_ini_location is not defined

- name: Configure php.ini
  ansible.builtin.template:
    src: php.ini.j2
    dest: "{{ php_found_ini_location.stdout }}"
    mode: "0644"
  notify: restart httpd


