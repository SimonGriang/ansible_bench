---
- name: rke2-install
  vars:
    rke2_url: https://github.com/rke2/rke2/releases/download/v1.23.6%2Brke2r1/rke2-install.sh
    rke2_checksum_url: https://github.com/rke2/rke2/releases/download/v1.23.6%2Brke2r1/sha256sum-amd64.txt
    rke2_airgap_install_script_path: /path/to/rke2-install.sh
    rke2_airgap_tarball_dir: /path/to/airgap/tarballs
    rke2_airgap_images_dir: /path/to/airgap/images
    rke2_additional_images_dir: /path/to/additional/images
    rke2_binary_path: /usr/local/bin/rke2
    rke2_config_file: /etc/rke2/rke2.yaml
    rke2_custom_manifests:
      - /path/to/custom/manifest1.yaml
      - /path/to/custom/manifest2.yaml
    rke2_static_pods:
      - /path/to/static/pod1.yaml
      - /path/to/static/pod2.yaml
    rke2_env_file: /path/to/rke2-env-file.sh
    rke2_version: v1.23.6+rke2r1
    rke2_allow_downgrade: false
  tasks:
    - name: Download RKE2 installation script if not in airgap mode
      when: not rke2_airgap_mode
      get_url:
        url: "{{ rke2_url }}"
        dest: "{{ rke2_airgap_install_script_path }}"
        mode: "0755"
        timeout: 30
    - name: Copy local RKE2 installation script if in airgap mode
      when: rke2_airgap_mode and rke2_airgap_implementation == "copy"
      copy:
        src: "{{ rke2_airgap_install_script_path }}"
        dest: "{{ rke2_airgap_install_script_path }}"
        mode: "0755"
        force: true
    - name: Create RKE2 artifacts folder if in airgap mode and the implementation is not 'exists'
      when: rke2_airgap_mode and rke2_airgap_implementation != "exists"
      file:
        path: "{{ rke2_airgap_tarball_dir }}"
        state: directory
        mode: "0755"
    - name: Download RKE2 checksum and artifacts with a fallback mechanism for airgap mode
      when: rke2_airgap_mode
      block:
        - name: Download checksum file
          get_url:
            url: "{{ rke2_checksum_url }}"
            dest: "{{ rke2_airgap_tarball_dir }}/sha256sum-amd64.txt"
            mode: "0644"
        - name: Download RKE2 artifacts
          get_url:
            url: "{{ item.url }}"
            dest: "{{ rke2_airgap_tarball_dir }}/{{ item.dest }}"
            checksum: "sha256:{{ item.checksum }}"
            mode: "0644"
            timeout: 30
          loop:
            - url: "{{ rke2_url }}"
              dest: rke2-install.sh
              checksum: "{{ rke2_checksum }}"
            - url: https://github.com/rke2/rke2/releases/download/v1.23.6%2Brke2r1/rke2-Linux-amd64.tar.gz
              dest: rke2-Linux-amd64.tar.gz
              checksum: "{{ rke2_checksum_linux_amd64 }}"
            - url: https://github.com/rke2/rke2/releases/download/v1.23.6%2Brke2r1/rke2-Windows-amd64.tar.gz
              dest: rke2-Windows-amd64.tar.gz
              checksum: "{{ rke2_checksum_windows_amd64 }}"
            - url: https://github.com/rke2/rke2/releases/download/v1.23.6%2Brke2r1/rke2-darwin-amd64.tar.gz
              dest: rke2-darwin-amd64.tar.gz
              checksum: "{{ rke2_checksum_darwin_amd64 }}"
          until: item is succeeded
          retries: 3
          delay: 10
        - name: Download RKE2 checksum
          command: "curl -sfL {{ rke2_checksum_url }} | grep -Po '(?<=  )[0-9a-f]{64}  {{ rke2_airgap_tarball_dir }}/rke2-install.sh'"
          register: rke2_checksum_output
          failed_when:
            - rke2_checksum_output.rc != 0
            - "'{{ rke2_airgap_tarball_dir }}/rke2-install.sh' not in rke2_checksum_output.stdout"
          changed_when: false
        - name: Download RKE2 installation script
          command: "curl -sfL {{ rke2_url }} -o {{ rke2_airgap_tarball_dir }}/rke2-install.sh"
          args:
            warn: false
          register: rke2_install_output
          failed_when:
            - rke2_install_output.rc != 0
            - "'saved to' not in rke2_install_output.stderr"
          changed_when: false
        - name: Validate RKE2 installation script checksum
          shell: "grep -Po '(?<=  )[0-9a-f]{64}  {{ rke2_airgap_tarball_dir }}/rke2-install.sh' {{ rke2_airgap_tarball_dir }}/sha256sum-amd64.txt | grep -wF {{ rke2_checksum }}"
          changed_when: false
        - name: Retry to download RKE2 installation script if it's not in the checksum
          when: "'{{ rke2_airgap_tarball_dir }}/rke2-install.sh' not in rke2_checksum_output.stdout"
          block:
            - name: Download RKE2 installation script
              get_url:
                url: "{{ rke2_url }}"
                dest: "{{ rke2_airgap_tarball_dir }}/rke2-install.sh"
                mode: "0644"
              register: rke2_install_fallback
              until: rke2_install_fallback is succeeded
              retries: 3
              delay: 10
            - name: Validate RKE2 installation script checksum
              shell: "grep -Po '(?<=  )[0-9a-f]{64}  {{ rke2_airgap_tarball_dir }}/rke2-install.sh' {{ rke2_airgap_tarball_dir }}/sha256sum-amd64.txt | grep -wF {{ rke2_checksum }}"
              changed_when: false
    - name: Copy local RKE2 artifacts if in airgap mode
      when: rke2_airgap_mode and rke2_airgap_implementation == "copy"
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_airgap_images_dir }}"
        mode: "0644"
        force: true
      loop:
        - "{{ rke2_airgap_tarball_dir }}/rke2-Linux-amd64.tar.gz"
        - "{{ rke2_airgap_tarball_dir }}/rke2-Windows-amd64.tar.gz"
        - "{{ rke2_airgap_tarball_dir }}/rke2-darwin-amd64.tar.gz"
    - name: Handle additional tarballs in airgap mode
      when: rke2_airgap_mode and rke2_airgap_implementation != "exists"
      block:
        - name: Create additional images directory
          file:
            path: "{{ rke2_additional_images_dir }}"
            state: directory
            mode: "0755"
        - name: Copy additional tarballs
          copy:
            src: "{{ item }}"
            dest: "{{ rke2_additional_images_dir }}"
            mode: "0644"
            force: true
          loop: "{{ rke2_airgap_copy_additional_tarballs }}"
    - name: Ensure artifacts exist and have acceptable permissions in airgap mode
      when: rke2_airgap_mode and rke2_airgap_implementation == "exists"
      block:
        - name: Check if RKE2 artifacts exist
          stat:
            path: "{{ rke2_airgap_images_dir }}/rke2-Linux-amd64.tar.gz"
          register: rke2_linux_amd64_stat
        - name: Check if RKE2 artifacts exist
          stat:
            path: "{{ rke2_airgap_images_dir }}/rke2-Windows-amd64.tar.gz"
          register: rke2_windows_amd64_stat
        - name: Check if RKE2 artifacts exist
          stat:
            path: "{{ rke2_airgap_images_dir }}/rke2-darwin-amd64.tar.gz"
          register: rke2_darwin_amd64_stat
        - name: Check if RKE2 artifacts exist
          stat:
            path: "{{ rke2_airgap_install_script_path }}"
          register: rke2_install_script_stat
        - name: Adjust permissions on RKE2 artifacts
          file:
            path: "{{ rke2_airgap_images_dir }}"
            state: directory
            recurse: true
            mode: "0644"
        - name: Check if RKE2 installation script is executable
          stat:
            path: "{{ rke2_airgap_install_script_path }}"
            follow: false
          register: rke2_install_script_exec
        - name: Set RKE2 version facts
          set_fact:
            rke2_installed_version: "{{ rke2_version }}"
            rke2_running_version: "{{ rke2_version }}"


