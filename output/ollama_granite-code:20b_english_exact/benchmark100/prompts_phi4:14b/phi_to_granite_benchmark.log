content='---\n- import_tasks: assert.yml\n  run_once: true\n  delegate_to: localhost\n\n- name: install software\n  package:\n    name: "{{ users_requirements }}"\n    state: present\n  when: users_requirements|length > 0\n\n- include_tasks: group.yml\n  loop: "{{ users_groups }}"\n  loop_control:\n    label: "{{ item.name }}"\n\n- name: include cron.allow\n  lineinfile:\n    path: /etc/sudoers\n    regexp: \'^#?includedir\\s+/etc/sudoers.d\'\n    line: \'#includedir /etc/sudoers.d\'\n    validate: visudo -cf %s\n  when: users_cron_allow\n\n- name: remove cron.allow\n  file:\n    path: /etc/cron.allow\n    state: absent\n  when: not users_cron_allow\n\n- include_tasks: user.yml\n  loop: "{{ users }}"\n  loop_control:\n    label: "{{ item.name }}"' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-14T18:54:57.873172367Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3940495213, 'load_duration': 27227650, 'prompt_eval_count': 692, 'prompt_eval_duration': 391233463, 'eval_count': 220, 'eval_duration': 3521122646, 'model_name': 'granite-code:20b'} id='run--20d4070a-5e0b-4dfd-bc70-603a13e51208-0' usage_metadata={'input_tokens': 692, 'output_tokens': 220, 'total_tokens': 912}
