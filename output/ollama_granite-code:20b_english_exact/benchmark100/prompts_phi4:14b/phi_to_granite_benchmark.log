---
- name: Check if all necessary variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for the host to become available if specified in the configuration
  wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ ansible_port | default(22) }}"
    state: started
    timeout: "{{ wait_for_connection_timeout }}"
  when:
    - ansible_connection != 'container'
    - wait_for_connection is sameas true

- name: Prepare the system by ensuring connectivity and installing necessary packages
  block:
    - name: Test the connection to the host
      connection_test:
        timeout: "{{ connection_timeout }}"
      register: connection_test_result
      ignore_errors: true

    - name: Provide a debug message with the timeout value if connection fails
      debug:
        msg: "Connection to the host failed. Timeout value is {{ connection_timeout }}."
      when: connection_test_result is failed

    - name: Ensure connectivity
      wait_for_connection:
        timeout: "{{ connection_timeout }}"
      when: connection_test_result is failed

    - name: Install necessary packages using raw commands
      command: "{{ item }}"
      with_items: "{{ install_packages }}"
      register: install_packages_result
      changed_when: install_packages_result is changed
      when:
        - os_family != 'Debian'
        - os_family != 'RedHat'

    - name: Install necessary packages using package module
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ install_packages }}"
      register: install_packages_result
      changed_when: install_packages_result is changed
      when:
        - os_family == 'Debian'
        - os_family == 'RedHat'

    - name: Ensure become is configured correctly
      assert:
        that:
          - ansible_become is sameas true
          - ansible_become_user is sameas "{{ become_user }}"
          - ansible_become_method is sameas "{{ become_method }}"
      when: become_user is defined and become_method is defined
  when: install_packages is defined

- name: Ensure the system is fully prepared by executing necessary Ansible modules
  block:
    - name: Gather Ansible facts
      setup:

    - name: Install required packages using package module
      package:
        name: "{{ item }}"
        state: present
        update_cache: true
      with_items: "{{ install_packages }}"
      register: install_packages_result
      changed_when: install_packages_result is changed
  when: install_packages is defined


