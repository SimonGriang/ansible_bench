---
- import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- wait_for_connection:
    timeout: "{{ bootstrap_timeout }}"
  when: not bootstrap_wait_for_host or not (ansible_connection in ["ssh", "network_cli", "paramiko", "local"])
  connection: local

- block:
    - name: bootstrap | test connection
      command: "true"
      register: connection_test
      changed_when: no
      ignore_errors: yes

    - name: bootstrap | check for sudo
      command: "true"
      register: sudo_test
      changed_when: no
      args:
       Executable: /bin/sudo
      when: connection_test is failed

    - name: bootstrap | gather bootstrap facts
      setup:
      when: connection_test is failed or sudo_test is failed

    - name: bootstrap | install bootstrap packages
      raw: >
        {% if ansible_os_family == "RedHat" %}
        yum install -y libdnf5
        {% elif ansible_os_family == "Debian" %}
        apt-get install -y sudo
        {% endif %}
      when: connection_test is failed or sudo_test is failed
  become: "{{ bootstrap_become }}"

- name: bootstrap | gather ansible facts
  setup:
    fact_path: "/etc/ansible/facts.d"
  become: no

- name: bootstrap | install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: yes
  become: "{{ bootstrap_become }}"


