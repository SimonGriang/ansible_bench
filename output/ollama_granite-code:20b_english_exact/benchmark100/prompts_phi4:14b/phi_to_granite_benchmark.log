content='---\n- name: Determine package state based on installation method\n  set_fact:\n    package_state: "{{ \'present\' if ansible_install_method == \'package\' else \'absent\' }}"\n\n- name: Setup Ansible on RedHat systems, excluding Fedora, using the package manager\n  include_tasks: setup-RedHat.yml\n  when: ansible_os_family == "RedHat" and ansible_distribution != "Fedora" and ansible_install_method == "package"\n\n- name: Setup Ansible on Fedora using the package manager\n  include_tasks: setup-Fedora.yml\n  when: ansible_distribution == "Fedora" and ansible_install_method == "package"\n\n- name: Setup Ansible on Ubuntu using the package manager\n  include_tasks: setup-Ubuntu.yml\n  when: ansible_distribution == "Ubuntu" and ansible_install_method == "package"\n\n- name: Setup Ansible on Debian using the package manager\n  include_tasks: setup-Debian.yml\n  when: ansible_os_family == "Debian" and ansible_install_method == "package"\n\n- name: Setup Ansible using Pip\n  include_tasks: setup-Pip.yml\n  when: ansible_install_method == "pip"' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-14T19:52:45.742858475Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5412858165, 'load_duration': 44346253, 'prompt_eval_count': 513, 'prompt_eval_duration': 200965687, 'eval_count': 274, 'eval_duration': 5166729480, 'model_name': 'granite-code:20b'} id='run--4836f516-55df-4dcb-96fc-b3b5d8c1d3d3-0' usage_metadata={'input_tokens': 513, 'output_tokens': 274, 'total_tokens': 787}
