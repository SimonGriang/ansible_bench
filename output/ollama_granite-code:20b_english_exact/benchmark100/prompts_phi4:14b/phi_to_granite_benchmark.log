---
- name: Install EPEL repository package
  hosts: all
  tasks:
    - name: Install EPEL repository package
      when: ansible_distribution == "Amazon" or (ansible_os_family == "RedHat" and ansible_distribution_major_version | int in [7, 8, 9, 10])
      block:
        - name: Add EPEL GPG key
          rpm_key:
            key: "{{ epel_gpg_key }}"
            state: present

        - name: Install EPEL-release package
          package:
            name: "{{ epel_url }}"
            state: present
          notify:
            - Update package cache

        - name: Install EPEL-next-release package
          package:
            name: "{{ epel_next_url }}"
            state: present
          when: epel_next
          notify:
            - Update package cache
      handlers:
        - name: Update package cache
          apt:
            update_cache: true
          when: ansible_os_family == "Debian"

        - name: Update package cache
          yum:
            update_cache: true
          when: ansible_os_family == "RedHat"


