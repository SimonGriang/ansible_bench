---

- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk package manager
  apk:
    update_cache: yes
    upgrade: yes
    notify: reboot

- name: Configure apt package manager
  apt:
    upgrade: yes
    update_cache: yes
    cache_valid_time: 3600
    autoremove: yes
    notify: reboot
  environment:
    DEBIAN_FRONTEND: noninteractive
    dpkg_options: '--force-confold --force-confdef'
   apt_upgrade: safe

- name: Update all software using dnf package manager
  dnf:
    name: '*'
    state: latest
    exclude: "{{ omit_packages | default(omit) }}"
    update_cache: yes
    notify: reboot

- name: Update all software using pacman package manager
  pacman:
    update_cache: yes
    upgrade: yes
    notify: reboot

- name: Configure yum package manager
  yum:
    name: '*'
    state: latest
    update_cache: yes
    notify: reboot
  when: ansible_distribution_major_version == "6"

- name: Configure yum package manager
  yum:
    name: '*'
    state: latest
    update_cache: yes
    notify: reboot
    yum: name=yum-utils
  when: ansible_distribution_major_version != "6"

- name: Update all software using zypper package manager
  zypper:
    name: '*'
    state: latest
    update_cache: yes
    notify: reboot


