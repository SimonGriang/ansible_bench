---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true
- name: Pre-configure Debian systems for Postfix
  when: ansible_os_family == 'Debian'
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'No configuration'
    vtype: string
- name: Install Postfix
  package:
    name: postfix
    state: present
- name: Conditionally install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined and 'mysql' in postfix_virtual_mailbox_maps or postfix_virtual_mailbox_domains is defined and 'mysql' in postfix_virtual_mailbox_domains or postix_virtual_alias_maps is defined and 'mysql' in postix_virtual_alias_maps
- name: Configure Postfix transport maps
  template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport
    mode: 0644
  notify: validate configuration and rebuild transport maps database
- name: Configure Postfix header checks
  template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
    mode: 0644
  notify: validate configuration and reload Postfix
- name: Set values for Postfix main.cf (part 1)
  set_fact:
    postfix_recipient_restrictions: "{{ 'permit_mynetworks, permit_sasl_authenticated' if postfix_recipient_access is defined else omit }}"
    postfix_sender_restrictions: "{{ 'permit_mynetworks, permit_sasl_authenticated' if postfix_sender_access is defined else omit }}"
- name: Set values for Postfix main.cf (part 2)
  set_fact:
    postfix_mynetworks: "{{ '127.0.0.0/8 {{ ansible_default_ipv4.network }}/{{ ansible_default_ipv4.netmask }}" + (',' + postfix_mynetworks_additional if postfix_mynetworks_additional is defined else '') + '}' if postfix_mynetworks is defined else omit }}"
    postfix_mydestination: "{{ 'localhost,{{ ansible_fqdn }} {{ ansible_hostname }} {{ ansible_all_ipv4_addresses }}' + (',' + postfix_mydestination_additional if postfix_mydestination_additional is defined else '') + '}' if postfix_mydestination is defined else omit }}"
    postfix_relay_domains: "{{ ansible_fqdn + (',' + postfix_relay_domains_additional if postfix_relay_domains_additional is defined else '') + '}' if postfix_relay_domains is defined else omit }}"
    postfix_smtpd_recipient_restrictions: "{{ postfix_recipient_restrictions + (',' + postfix_smtpd_recipient_restrictions_additional if postfix_smtpd_recipient_restrictions_additional is defined else '') + '}' if postfix_smtpd_recipient_restrictions is defined else omit }}"
    postfix_smtpd_sender_restrictions: "{{ postfix_sender_restrictions + (',' + postfix_smtpd_sender_restrictions_additional if postfix_smtpd_sender_restrictions_additional is defined else '') + '}' if postfix_smtpd_sender_restrictions is defined else omit }}"
    postfix_virtual_mailbox_domains: "{{ 'mysql:/etc/postfix/mysql-virtual-domains.cf' if postfix_virtual_mailbox_domains is defined else omit }}"
    postfix_virtual_alias_domains: "{{ 'mysql:/etc/postfix/mysql-virtual-domains.cf' if postix_virtual_alias_domains is defined else omit }}"
- name: Configure Postfix main.cf
  template:
    src: postfix/main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 0644
  notify: validate configuration and restart Postfix
- name: Configure Postfix master.cf
  template:
    src: postfix/master.cf.j2
    dest: /etc/postfix/master.cf
    mode: 0644
  notify: validate configuration and restart Postfix
- name: Create directories for TLS certificates and keys
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
  loop:
    - /etc/postfix/tls/server
    - /etc/postfix/sasl_password
- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_src }}"
    dest: /etc/postfix/tls/server/cert
    mode: 0644
  notify: reload Postfix
  when: postfix_smtpd_tls_cert_src is defined
- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_src }}"
    dest: /etc/postfix/tls/server/key
    mode: 0600
  notify: reload Postfix
  when: postfix_smtpd_tls_key_src is defined
- name: Flush Postfix handlers
  meta: flush_handlers
- name: Configure Postfix aliases
  lineinfile:
    path: /etc/aliases
    line: "{{ item.alias }}: {{ item.destination }}"
    regexp: "^{{ item.alias }}:"
    state: "{{ item.state }}"
  loop: "{{ postfix_aliases }}"
  when: postfix_aliases is defined
  notify: rebuild alias database and reload Postfix
- name: Configure Postfix sender access
  lineinfile:
    path: /etc/postfix/sender_access
    line: "{{ item.value.line }}"
    regexp: "^{{ item.value.regexp }}:"
    state: "{{ item.state }}"
  loop: "{{ postfix_sender_access|dict2items }}"
  when: postfix_sender_access is defined
  notify: rebuild sender access database and reload Postfix
- name: Configure Postfix recipient access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: "{{ item.value.line }}"
    regexp: "^{{ item.value.regexp }}:"
    state: "{{ item.state }}"
  loop: "{{ postfix_recipient_access|dict2items }}"
  when: postfix_recipient_access is defined
  notify: validate configuration, rebuild recipient access database, and reload Postfix
- name: Place SASL password map
  copy:
    dest: /etc/postfix/sasl_password
    content: "{{ postfix_smtp_sasl_password_map }}"
    mode: 0600
  notify: rebuild sasl_password_map database
  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map|length > 0
- name: Flush Postfix handlers again
  meta: flush_handlers
- name: Start and enable Postfix service
  service:
    name: postfix
    state: started
    enabled: true


