      service:
        name: "{{ item.name }}"
        state: "{{ item.state | default(omit) }}"
        enabled: "{{ item.enabled | default(omit) }}"
      loop: "{{ service_list }}"
      when: item.state is defined or item.enabled is defined
    - name: Flush handlers
      meta: flush_handlers


