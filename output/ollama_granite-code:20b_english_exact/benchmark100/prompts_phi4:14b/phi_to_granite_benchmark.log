---

- name: Configure Grub
  block:
    - name: Check if the system is EFI
      stat:
        path: /boot/efi
      register: efi_path

    - name: Remove unwanted grub.cfg for EFI systems
      file:
        path: /boot/grub2/grub.cfg
        state: absent
      when: efi_path.stat.exists

    - name: Install user template for Grub
      copy:
        src: /path/to/user_template
        dest: /etc/grub.d/01_user
        owner: root
        group: root
        mode: 0644
      notify: update grub

    - name: Add password to EFI Grub configuration
      lineinfile:
        path: /etc/grub2-efi.cfg
        line: 'password --grub'
      notify: update grub
      when: efi_path.stat.exists

    - name: Add password to MBR Grub configuration
      lineinfile:
        path: /etc/grub2.cfg
        line: 'password --grub'
      notify: update grub
      when: efi_path.stat.exists

    - name: Modify files to add --unrestricted class
      lineinfile:
        path: "{{ item }}"
        line: 'CLASS="--unrestricted"'
      loop:
        - /path/to/file1
        - /path/to/file2
      notify: update grub

  when: efi_path.stat.exists


