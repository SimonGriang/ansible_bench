---
- name: Generate SSL private keys, CSRs, certificates, PKCS#12 files, and combined private key and certificate files
  tasks:
    - name: Generate SSL private key files
      community.crypto.openssl_privatekey:
        path: "{{ ssl_private_key_file_ paths[item] }}"
        mode: "{{ file_permission }}"
        owner: "{{ file_owner }}"
        group: "{{ file_group }}"
      loop: "{{ query('range', 0, number_of_items) }}"
      loop_control:
        loop_var: item

    - name: Generate SSL CSR files
      community.crypto.openssl_csr:
        path: "{{ ssl_csr_file_paths[item] }}"
        privatekey_path: "{{ ssl_private_key_file_paths[item] }}"
        common_name: "{{ common_name }}"
        mode: "{{ file_permission }}"
        owner: "{{ file_owner }}"
        group: "{{ file_group }}"
      loop: "{{ query('range', 0, number_of_items) }}"
      loop_control:
        loop_var: item

    - name: Generate SSL certificates
      community.crypto.x509_certificate:
        path: "{{ ssl_certificate_file_paths[item] }}"
        privatekey_path: "{{ ssl_private_key_file_paths[item] }}"
        csr_path: "{{ ssl_csr_file_paths[item] }}"
        mode: "{{ file_permission }}"
        owner: "{{ file_owner }}"
        group: "{{ file_group }}"
      loop: "{{ query('range', 0, number_of_items) }}"
      loop_control:
        loop_var: item

    - name: Create PKCS#12 files
      community.crypto.openssl_pkcs12:
        path: "{{ pkcs12_file_paths[item] }}"
        privatekey_path: "{{ ssl_private_key_file_paths[item] }}"
        certificate_path: "{{ ssl_certificate_file_paths[item] }}"
        friendly_name: "{{ pkcs12_friendly_name }}"
        mode: "{{ file_permission }}"
        owner: "{{ file_owner }}"
        group: "{{ file_group }}"
      loop: "{{ query('range', 0, number_of_items) }}"
      loop_control:
        loop_var: item

    - name: Read private key file content
      ansible.builtin.slurp:
        src: "{{ ssl_private_key_file_paths[item] }}"
      register: private_key_content
      loop: "{{ query('range', 0, number_of_items) }}"
      loop_control:
        loop_var: item

    - name: Read certificate file content
      ansible.builtin.slurp:
        src: "{{ ssl_certificate_file_paths[item] }}"
      register: certificate_content
      loop: "{{ query('range', 0, number_of_items) }}"
      loop_control:
        loop_var: item

    - name: Create combined private key and certificate file
      ansible.builtin.copy:
        dest: "{{ combined_file_path }}"
        content: "{{ private_key_content[item].content }}{{ certificate_content[item].content }}"
        mode: "{{ file_permission }}"
        owner: "{{ file_owner }}"
        group: "{{ file_group }}"
      loop: "{{ query('range', 0, number_of_items) }}"
      loop_control:
        loop_var: item



