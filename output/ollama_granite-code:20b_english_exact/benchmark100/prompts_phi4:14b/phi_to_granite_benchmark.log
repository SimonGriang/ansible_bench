    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: not ansible_version.full | version_compare('2.12', '<') or ansible_os_family not in ["RedHat", "Debian"] and docker_install_compose_plugin

- name: Install Docker Compose plugin with allow_downgrade option
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: true
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: ansible_version.full | version_compare('2.12', '>=') and ansible_os_family in ["RedHat", "Debian"] and docker_install_compose_plugin

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    state: directory
    mode: 0755
  when: docker_daemon_options != {}

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options | to_json }}"
    dest: /etc/docker/daemon.json
    mode: 0644
    owner: root
    group: root
  notify: restart docker
  when: docker_daemon_options != {}

- name: Ensure Docker service is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: "{{ ansible_check_mode }}"
  when: docker_service_manage

- name: Flush handlers
  meta: flush_handlers

- name: Include Docker Compose setup tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Retrieve Docker group information
  getent:
    database: group
    key: docker
    split: ":"
  when: docker_users | length > 0

- name: Determine if any users need to be added to Docker group
  set_fact:
    at_least_one_user_to_modify: true
  when: docker_users | length > 0 and docker_users not in getent_group_docker.split(':')

- name: Include tasks to modify user group memberships
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify is defined


