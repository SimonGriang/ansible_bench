      set_fact:
        bootstrap_distribution: "{{ bootstrap_facts.stdout | from_json | json_query('body.PRETTY_NAME') | regex_replace('(.*) \\(.*\\)', '\\1') | regex_replace('(.*)\\s*\\(.)\\)', '\\1') }}"
        bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | from_json | json_query('body.VERSION_ID') }}"
      when: bootstrap_facts.rc == 0 and bootstrap_facts.stdout | from_json | json_query('body.PRETTY_NAME') is defined and bootstrap_distribution is not defined and (bootstrap_facts.stdout | from_json | json_query('body.PRETTY_NAME') | regex_replace('(.*) \\(.*\\)', '\\1') | regex_replace('(.*)\\s*\\(.)\\)', '\\1')) in bootstrap__os_family_map
      become: "{{ bootstrap_become }}"
      become_user: "{{ bootstrap_become_user }}"

    - name: Set bootstrap facts for OS family
      set_fact:
        bootstrap_os_family: "{{ item.value }}"
      when: bootstrap_distribution is defined and bootstrap_os_family is not defined
      with_dict: "{{ bootstrap__os_family_map }}"
      become: "{{ bootstrap_become }}"
      become_user: "{{ bootstrap_become_user }}"


