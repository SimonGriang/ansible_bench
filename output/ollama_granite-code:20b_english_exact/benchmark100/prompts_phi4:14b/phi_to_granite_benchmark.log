      notify: Gather facts
    - name: Configure systemd services
      template:
        src: systemd.j2
        dest: "/etc/systemd/system/{{ item.name }}.service"
        mode: "0644"
      loop: "{{ service_list }}"
      notify: Systemctl daemon-reload
      when: service_manager == "systemd"
    - name: Configure sysvinit services
      template:
