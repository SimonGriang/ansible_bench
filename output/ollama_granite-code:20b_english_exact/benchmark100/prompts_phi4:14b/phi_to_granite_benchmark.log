---

- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages
  ansible.builtin.package:
    name: "{{ sysctl_requirements }}"
    state: present

- name: Configure sysctl settings
  ansible.posix.sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: "{{ sysctl_set | default(omit) }}"
    reload: "{{ sysctl_reload | default(omit) }}"
    sysctl_file: /etc/sysctl.d/98-ansible.conf
    sysctl_set: "{{ sysctl_set | default(omit) }}"
    sysctl_reload: "{{ sysctl_reload | default(omit) }}"
    loop_control:
      label: "{{ item.name }}"
  when:
    - sysctl_items is defined
    - item.name is defined
    - item.value is defined
  loop: "{{ sysctl_items }}"



