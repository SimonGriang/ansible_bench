---
- name: "Java installation"
  block:
    - name: "Migrate the Java JDK vendor from adoptopenjdk to temurin if selected"
      set_fact:
        java_jdk_vendor: "temurin"
      when: java_jdk_vendor == "adoptopenjdk"
    - name: "Gather OS-specific variables for the Java JDK"
      include_vars: "{{ item }}"
      with_first_found:
        - files:
          - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_distribution }}-{{ ansible_distribution_release }}.yml"
          - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_distribution }}.yml"
          - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_os_family }}.yml"
          - "{{ java_jdk_vendor }}-{{ ansible_system }}.yml"
          - "{{ java_jdk_vendor }}.yml"
          - defaults/main.yml
          paths:
          - vars
          skip: true
    - name: "Gather architecture-specific variables for the Java JDK"
      include_vars: "{{ item }}"
      with_first_found:
        - files:
          - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_architecture }}-{{ ansible_distribution }}-{{ ansible_distribution_release }}.yml"
          - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_architecture }}-{{ ansible_distribution }}.yml"
          - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_architecture }}-{{ ansible_os_family }}.yml"
          - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_architecture }}.yml"
          - "{{ java_jdk_vendor }}-{{ ansible_system }}.yml"
          - "{{ java_jdk_vendor }}.yml"
          - defaults/main.yml
          paths:
          - vars
          skip: true
    - name: "Set OS-specific Java variables"
      set_fact:
        __java_package: "{{ __java_packages[ansible_system] | first }}"
        __java_package_url: "{{ __java_package_url_dicts[ansible_system] | first }}"
        __java_apt_key: "{{ __java_apt_keys[ansible_system] }}"
        __java_apt_repositories: "{{ __java_apt_repositories[ansible_system] }}"
      when: __java_package is undefined or __java_package_url is undefined or __java_apt_key is undefined or __java_apt_repositories is undefined
    - name: "Set OS and architecture-specific Java variables"
      set_fact:
        __java_package: "{{ __java_packages[ansible_system][ansible_architecture] | first }}"
        __java_package_url: "{{ __java_package_url_dicts[ansible_system][ansible_architecture] | first }}"
        __java_apt_key: "{{ __java_apt_keys[ansible_system][ansible_architecture] }}"
        __java_apt_repositories: "{{ __java_apt_repositories[ansible_system][ansible_architecture] }}"
      when: __java_package is undefined or __java_package_url is undefined or __java_apt_key is undefined or __java_apt_repositories is undefined
    - name: "Set specific Java variables"
      set_fact:
        java_home: "{{ __java_home }}"
    - name: "Handle Debian pre-requisites for Java installation"
      block:
        - name: "Remove deprecated repositories"
          apt_repository:
            state: absent
            repo: "{{ item }}"
          with_items: "{{ __java_deprecated_apt_repositories }}"
        - name: "Install extra packages"
          apt:
            state: present
            update_cache: true
            name: "{{ __java_extra_packages }}"
        - name: "Add key repositories"
          apt_key:
            url: "{{ __java_apt_key }}"
          when: __java_apt_key is defined
        - name: "Add required repositories"
          apt_repository:
            repo: "{{ item }}"
            state: present
          with_items: "{{ __java_apt_repositories }}"
      when: ansible_os_family == 'Debian'
    - name: "Handle RedHat pre-requisites for Java installation"
      block:
        - name: "Add key repositories"
          rpm_key:
            state: present
            key: "{{ __java_rpm_key }}"
          when: __java_rpm_key is defined
        - name: "Add required repositories"
          yum:
            name: "{{ item }}"
            state: present
          with_items: "{{ __java_yum_repositories }}"
      when: ansible_os_family == 'RedHat'
    - name: "Install required libraries for Java"
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ __java_packages[ansible_system] | difference(['java-11-openjdk', 'java-1.8.0-openjdk']) }}"
      register: java_libs_result
      until: java_libs_result is succeeded
    - name: "Install Java"
      block:
        - name: "Install Java on Debian systems"
          apt:
            state: present
            update_cache: true
            name: "{{ __java_package }}"
          register: java_result
          until: java_result is succeeded
        - name: "Install Java on RedHat systems"
          yum:
            name: "{{ __java_package }}"
            state: present
          register: java_result
          until: java_result is succeeded
      when: ansible_os_family == 'Debian' or ansible_os_family == 'RedHat'
    - name: "Export Java environment variables"
      template:
        src: jdk.sh.j2
        dest: /etc/profile.d/jdk.sh
        mode: "0644"
      when: java_home is defined
    - name: "Source Java environment variables"
      shell: "source /etc/profile.d/jdk.sh"
      when: java_home is defined
    - name: "Correct Java version selection for versions less than 11 on Debian systems"
      alternatives:
        name: java
        path: /usr/lib/jvm/java-1.8.0-openjdk-amd64/jre/bin/java
      when: ansible_os_family == 'Debian' and java_version_float < 11
    - name: "Correct Java version selection for versions 11 or greater on Debian systems"
      alternatives:
        name: java
        path: /usr/lib/jvm/java-11-openjdk-amd64/bin/java
      when: ansible_os_family == 'Debian' and java_version_float >= 11
