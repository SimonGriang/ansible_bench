              dest: rke2-Linux-amd64.tar.gz
              checksum: "{{ rke2_checksum_linux_amd64 }}"
            - url: https://github.com/rke2/rke2/releases/download/v1.23.6%2Brke2r1/rke2-Windows-amd64.tar.gz
              dest: rke2-Windows-amd64.tar.gz
              checksum: "{{ rke2_checksum_windows_amd64 }}"
            - url: https://github.com/rke2/rke2/releases/download/v1.23.6%2Brke2r1/rke2-darwin-amd64.tar.gz
              dest: rke2-darwin-amd64.tar.gz
