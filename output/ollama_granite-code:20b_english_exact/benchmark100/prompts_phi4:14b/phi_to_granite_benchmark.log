---
- name: Task 1
  block:
    - name: Ensure Apache2 modules are present
      become: true
      ansible.builtin.apache2_module:
        name: "{{ item }}"
        state: present
      loop:
        - proxy
        - proxy_http
      notify: restart apache2
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"

- name: Task 2
  block:
    - name: Copy template configuration files
      become: true
      ansible.builtin.copy:
        src: location.conf.j2
        dest: "{{ httpd_config_path }}/{{ item.url | urlsplit('path') | last }}.conf"
        mode: 0644
      loop: "{{ httpd_locations }}"
      notify: validate and restart apache2
  when: httpd_locations is defined and httpd_locations | length > 0


