- name: Bootstrap Playbook
  tasks:
    - name: Gather bootstrap facts
      raw:cat /etc/os-release
      register: bootstrap_facts
      changed_when: false

    - name: Set bootstrap distribution and major version facts
      set_fact:
        bootstrap_distribution: "{{ bootstrap_facts.stdout_lines | selectattr('split','equalto', '=') | list | first | split('=') | last | lower }}"
        bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout_lines | selectattr('split','equalto', '=') | list | first | split('=') | last | regex_replace('^([0-9]+).*$','\\1') }}"
      when:
        - bootstrap_facts.rc == 0
        - bootstrap_distribution is not defined
        - bootstrap_facts.stdout_lines | selectattr('split','equalto', '=') | list | first | split('=') | last is match(bootstrap_search[item])
      loop: "{{ bootstrap_os_family_map }}"
      loop_control:
        label: "{{ bootstrap_os_family_map[item] }}"

    - name: Determine and set the bootstrap OS family
      set_fact:
        bootstrap_os_family: "{{ bootstrap_os_family_map[item] }}"
      loop: "{{ bootstrap_os_family_map }}"
      loop_control:
        label: "{{ bootstrap_os_family_map[item] }}"
      when:
        - bootstrap_distribution is defined
        - bootstrap_os_family is not defined
        - bootstrap_distribution in bootstrap_os_family_map[item]


