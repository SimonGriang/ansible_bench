---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true

- name: Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell environment for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^#?SHELL='
    line: "SHELL={{ cron_shell }}"
    mode: 0600
  notify: restart cron

- name: Configure PATH environment variable for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^#?PATH='
    line: "PATH={{ cron_path }}"
    mode: 0600
  notify: restart cron

- name: Configure MAILTO environment variable for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^#?MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    mode: 0600
  notify: restart cron

- name: Ensure cron service is started and enabled
  service:
    name: "{{ cron_service.name | defaultomit }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service.name | length > 0

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    user: "{{ item.user | defaultomit }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute | defaultomit }}"
    hour: "{{ item.hour | defaultomit }}"
    day: "{{ item.day | defaultomit }}"
    month: "{{ item.month | defaultomit }}"
    weekday: "{{ item.weekday | defaultomit }}"
    state: "{{ item.state | defaultpresent }}"
  loop: "{{ cron_jobs | default([]) }}"
  when: cron_jobs is defined


