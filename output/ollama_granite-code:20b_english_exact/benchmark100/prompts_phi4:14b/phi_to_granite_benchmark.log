---
- name: Generate SSL keys and certificates
  tasks:
    - name: Create SSL key for each item
      community.crypto.openssl_privatekey:
        path: "{{ ssl_key_path }}"
        mode: "{{ ssl_key_mode }}"
        owner: "{{ ssl_key_owner }}"
        group: "{{ ssl_key_group }}"

    - name: Create SSL CSR for each item
      community.crypto.openssl_csr:
        path: "{{ ssl_csr_path }}"
        privatekey_path: "{{ ssl_key_path }}"
        mode: "{{ ssl_csr_mode }}"
        owner: "{{ ssl_csr_owner }}"
        group: "{{ ssl_csr_group }}"

    - name: Create SSL certificates for each item
      community.crypto.x509_certificate:
        path: "{{ ssl_cert_path }}"
        privatekey_path: "{{ ssl_key_path }}"
        csr_path: "{{ ssl_csr_path }}"
        mode: "{{ ssl_cert_mode }}"
        owner: "{{ ssl_cert_owner }}"
        group: "{{ ssl_cert_group }}"

    - name: Create PKCS#12 file for each item
      community.crypto.openssl_pkcs12:
        path: "{{ ssl_pkcs12_path }}"
        privatekey_path: "{{ ssl_key_path }}"
        certificate_path: "{{ ssl_cert_path }}"
        mode: "{{ ssl_pkcs12_mode }}"
        owner: "{{ ssl_pkcs12_owner }}"
        group: "{{ ssl_pkcs12_group }}"

    - name: Read private key for each item
      ansible.builtin.slurp:
        src: "{{ ssl_key_path }}"
      register: private_key

    - name: Read certificate for each item
      ansible.builtin.slurp:
        src: "{{ ssl_cert_path }}"
      register: certificate

    - name: Create a combined private key and certificate file for each item
      ansible.builtin.copy:
        dest: "{{ ssl_combined_path }}"
        content: "{{ private_key['content'] + certificate['content'] }}"
        mode: "{{ ssl_combined_mode }}"
        owner: "{{ ssl_combined_owner }}"
        group: "{{ ssl_combined_group }}"


