---
- import_tasks: assert.yml
- name: Install Apache HTTP server
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present
- block:
  - name: Enable specified SELinux booleans
    ansible.builtin.seboolean:
      name: "{{ item }}"
      state: yes
      persistent: yes
    loop: "{{ httpd_sebooleans }}"
  - name: Allow connections to custom ports using SELinux ports configuration
    ansible.builtin.seport:
      ports: "{{ item }}"
      proto: tcp
      setype: http_port_t
      state: present
    loop:
    - "{{ httpd_port }}"
    - "{{ httpd_ssl_port }}"
  when: ansible_selinux.status == "enabled"
- name: Configure main Apache HTTP server configuration file
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "{{ httpd_config_mode }}"
    owner: root
    group: root
    seuser: system_u
    serole: object_r
    setype: httpd_config_t
    selevel: s0
  notify:
  - Test Apache HTTP server configuration
  - Restart Apache HTTP server
- name: Activate specified Apache HTTP server modules on Debian systems
  ansible.builtin.shell: "a2enmod {{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  args:
    creates: "{{ httpd_module_config_file }}"
  when:
  - ansible_os_family == "Debian"
  - httpd_modules_to_activate_with_command | length > 0
  notify:
  - Test Apache HTTP server configuration
- import_tasks: ssl.yml
  when: https_ssl_enable
- import_tasks: locations.yml
  when: httpd_locations is defined
- import_tasks: vhosts.yml
  when: httpd_vhosts is defined
- block:
  - name: Configure ports
    ansible.builtin.template:
      src: "{{ httpd_ports_conf }}"
      dest: "{{ httpd_conf_ roots }}/ports.conf"
      mode: "0644"
      owner: root
      group: root
      seuser: system_u
      serole: object_r
      setype: httpd_config_t
      selevel: s0
    notify:
    - Test Apache HTTP server configuration
    - Restart Apache HTTP server
  when:
  - ansible_os_family in [ "Debian", "SUSE" ]
  - httpd_ports_conf is defined
- import_tasks: directories.yml
  when: httpd_directories is defined
- name: Flush all pending handlers
  ansible.builtin.meta: flush_handlers
- name: Remove default HTML index file if specified
  ansible.builtin.file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example
- name: Start and enable Apache HTTP server service
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


