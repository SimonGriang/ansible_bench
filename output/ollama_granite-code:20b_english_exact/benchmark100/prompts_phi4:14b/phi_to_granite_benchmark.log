ide.conf\n    - name: Reload systemd\n      ansible.builtin.systemd:\n        daemon_reload: true\n  when: ansible_service_mgr == "systemd"\n- name: Start and enable DNS service\n  ansible.builtin.service:\n    name: "{{ dns_service }}"\n    state: started\n    enabled: true' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-14T18:14:33.111265847Z', 'done': True, 'done_reason': 'stop', 'total_duration': 18733998993, 'load_duration': 35513379, 'prompt_eval_count': 2844, 'prompt_eval_duration': 1842007437, 'eval_count': 615, 'eval_duration': 16855502163, 'model_name': 'granite-code:20b'} id='run--2a8779cf-4413-4770-86a9-a309af736d08-0' usage_metadata={'input_tokens': 2844, 'output_tokens': 615, 'total_tokens': 3459}
