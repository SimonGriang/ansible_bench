  loop_control:
    label: "{{ item.name }}"

- name: Ensure /etc/sudoers includes /etc/sudoers.d
  ansible.builtin.lineinfile:
    path: /etc/sudoers
    regexp: '^#?includedir\s+/etc/sudoers.d'
    line: '#includedir /etc/sudoers.d'
    validate: visudo -cf %s
  when: users_cron_allow

- name: Remove /etc/cron.allow if not needed
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow

- name: Include user.yml tasks for each user
  ansible.builtin.include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"


