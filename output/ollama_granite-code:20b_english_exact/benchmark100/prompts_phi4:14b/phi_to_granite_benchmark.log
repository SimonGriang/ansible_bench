---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true

- name: Install cron packages
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell environment for cron
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^#?SHELL='
    line: "SHELL={{ cron_shell }}"
    mode: "0600"
  notify: restart cron

- name: Configure PATH environment variable for cron
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^#?PATH='
    line: "PATH={{ cron_path }}"
    mode: "0600"
  notify: restart cron

- name: Configure MAILTO environment variable for cron
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^#?MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    mode: "0600"
  notify: restart cron

- name: Ensure cron service is started and enabled
  ansible.builtin.service:
    name: "{{ cron_service.name | default omit }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service.name | length > 0

- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    user: "{{ item.user | default omit }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute | default omit }}"
    hour: "{{ item.hour | default omit }}"
    day: "{{ item.day | default omit }}"
    month: "{{ item.month | default omit }}"
    weekday: "{{ item.weekday | default omit }}"
    state: "{{ item.state | default present }}"
  loop: "{{ cron_jobs | default([]) }}"
  when: cron_jobs is defined


