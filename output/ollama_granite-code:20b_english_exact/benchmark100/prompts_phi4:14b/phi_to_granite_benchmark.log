- Last generated (faulty) playbook:
---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: install software
  package:
    name: "{{ users_requirements }}"
    state: present
  when: users_requirements|length > 0

- include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item.name }}"

- name: include cron.allow
  lineinfile:
    path: /etc/sudoers
    regexp: '^#?includedir\s+/etc/sudoers.d'
    line: '#includedir /etc/sudoers.d'
    validate: visudo -cf %s
  when: users_cron_allow

- name: remove cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow

- include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"


