---
- name: Task 1
  become: true
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"
  community.general.apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http

- name: Task 2
  become: true
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item.name }}.conf"
    mode: "0644"
  loop: "{{ httpd_locations }}"
  loop_control:
    label: "Configuring {{ item.name }} location"
  notify: Test HTTPD configuration and restart HTTPD service


