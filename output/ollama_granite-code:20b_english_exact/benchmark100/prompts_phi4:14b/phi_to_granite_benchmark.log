---
- name: Create the RKE2 manifests directory
  file:
    path: "/var/lib/rke2/server/manifests"
    owner: root
    group: root
    mode: '0700'
    state: directory

- name: Copy kube-vip files to the first server
  copy:
    src: "{{ item }}"
    dest: "/var/lib/rke2/server/manifests/{{ item | basename | replace('.j2', '') }}"
    owner: root
    group: root
    mode: '0664'
  with_fileglob:
    - files/kube-vip/*

- name: Copy kube-vip load balancer manifests to the first server
  when: cloud_provider_feature_enabled
  copy:
    src: "{{ item }}"
    dest: "/var/lib/rke2/server/manifests/{{ item | basename | replace('.j2', '') }}"
    owner: root
    group: root
    mode: '0664'
  with_fileglob:
    - files/kube-vip-cloud-provider/*


