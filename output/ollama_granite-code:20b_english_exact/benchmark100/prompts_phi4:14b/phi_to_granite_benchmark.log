---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install the logrotate package using variables that specify the package names.
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate by creating a template configuration file from a Jinja2 template.
  template:
    src: "{{ logrotate_config_file }}"
    dest: "{{ logrotate_config_directory }}"
    mode: "0644"
  notify: restart logrotate

- name: Generate logrotate.d configuration files for each log entry, ensuring they are only created if they should exist.
  template:
    src: entry.j2
    dest: "{{ logrotate_confd_directory }}/{{ item.name }}"
    mode: "0644"
  loop: "{{ logrotate_entries }}"
  loop_control:
    label: "Generating logrotate.d configuration for {{ item.name }}"
  when: item.state is not defined or item.state != "absent"
  notify: restart logrotate

- name: Remove logrotate.d configuration files for entries that are explicitly marked for removal.
  file:
    path: "{{ logrotate_confd_directory }}/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  loop_control:
    label: "Removing logrotate.d configuration for {{ item.name }}"
  when: item.state is defined and item.state == "absent"
  notify: restart logrotate

- name: Start the logrotate service, ensuring it is enabled and in the desired state.
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service is defined


