content='---\n\n- name: Remove obsolete Docker packages\n  yum:\n    name: "{{ docker_obsolete_packages }}"\n    state: absent\n\n- name: Add Docker GPG key\n  rpm_key:\n    key: "{{ docker_yum_gpg_key }}"\n    state: present\n  when: docker_add_repo\n\n- name: Add Docker repository\n  copy:\n    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    content: |\n      [docker-ce-stable]\n      name=Docker {{ docker_edition }} Stable - $basearch\n     baseurl={{ docker_yum_repo_url }}\n      enabled=1\n      gpgcheck=1\n      gpgkey={{ docker_yum_gpg_key }}\n      repo_gpgcheck=1\n      skip_if_unavailable=1\n  when: docker_add_repo\n\n- name: Configure Docker Nightly repo\n  replace:\n    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    regexp: \'^\\[docker-ce-nightly\\]\'\n    replace: \'[docker-ce-nightly]\'\n  when: docker_add_repo and docker_yum_repo_enable_nightly\n\n- name: Configure Docker Test repo\n  replace:\n    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    regexp: \'^\\[docker-ce-test\\]\'\n    replace: \'[docker-ce-test]\'\n  when: docker_add_repo and docker_yum_repo_enable_test\n\n- name: Configure containerd on RHEL 8\n  yum:\n    name: "{{ item }}"\n    state: present\n  when: ansible_distribution == "RedHat" and ansible_distribution_major_version | int == 8\n  with_items:\n    - runc\n    - container-selinux\n    - containerd.io' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-14T18:22:57.273746209Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9046807525, 'load_duration': 34871759, 'prompt_eval_count': 652, 'prompt_eval_duration': 519725092, 'eval_count': 403, 'eval_duration': 8491232624, 'model_name': 'granite-code:20b'} id='run--d9d2080b-9b6f-4b36-af9e-d833025a3e7e-0' usage_metadata={'input_tokens': 652, 'output_tokens': 403, 'total_tokens': 1055}
_______________________________________Cleaned LLM Output:_______________________________________ 
---

- name: Remove obsolete Docker packages
  yum:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Add Docker GPG key
  rpm_key:
    key: "{{ docker_yum_gpg_key }}"
    state: present
  when: docker_add_repo

- name: Add Docker repository
  copy:
    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    content: |
      [docker-ce-stable]
      name=Docker {{ docker_edition }} Stable - $basearch
     baseurl={{ docker_yum_repo_url }}
      enabled=1
      gpgcheck=1
      gpgkey={{ docker_yum_gpg_key }}
      repo_gpgcheck=1
      skip_if_unavailable=1
  when: docker_add_repo

- name: Configure Docker Nightly repo
  replace:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^\[docker-ce-nightly\]'
    replace: '[docker-ce-nightly]'
  when: docker_add_repo and docker_yum_repo_enable_nightly

- name: Configure Docker Test repo
  replace:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^\[docker-ce-test\]'
    replace: '[docker-ce-test]'
  when: docker_add_repo and docker_yum_repo_enable_test

- name: Configure containerd on RHEL 8
  yum:
    name: "{{ item }}"
    state: present
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version | int == 8
  with_items:
    - runc
    - container-selinux
    - containerd.io


