---
- name: Task 1
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify: set root password
  notify: restart mysqld

- name: Task 3
  template:
    src: mysql.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: 0644
  notify: restart mysqld

- name: Task 4
  lineinfile:
    path: /etc/mysql/my.cnf
    line: "socket = {{ mysql_socket }}"
    regexp: '^socket = '
  notify: restart mysqld

- name: Task 5
  command: mysql_install_db
  args:
    creates: /var/lib/mysql/mysql
  when: ansible_distribution == "Alpine" or ansible_distribution == "Archlinux"

- name: Task 6
  service:
    name: mysql
    state: started
    enabled: yes

- name: Task 7
  meta: flush_handlers

- name: Task 8
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: 0600

- name: Task 9
  mysql_db:
    name: "{{ item.name }}"
    state: present
    encoding: "{{ item.encoding | default(omit) }}"
    collate: "{{ item.collate | default(omit) }}"
  no_log: True
  with_items: "{{ mysql_databases }}"
  when: item.import is not defined

- name: Task 10
  mysql_db:
    name: "{{ item.name }}"
  no_log: True
  with_items: "{{ mysql_databases }}"
  when: item.import is not defined

- name: Task 11
  mysql_db:
    name: "{{ item.name }}"
    target: "{{ item.import.target }}"
    state: import
  no_log: True
  with_items: "{{ mysql_databases }}"
  when: item.import is defined and item.import.target is defined and item.name not in (mysql_databases | map(attribute='name') | list)

- name: Task 12
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default(omit) }}"
    state: present
  no_log: True
  with_items: "{{ mysql_users }}"

- name: Task 13
  meta: flush_handlers


