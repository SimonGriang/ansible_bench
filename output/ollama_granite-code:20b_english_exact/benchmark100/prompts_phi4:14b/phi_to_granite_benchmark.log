---
- name: Cordon and Drain the node during RKE2 upgrade
  ansible.builtin.shell: kubectl cordon --dry-run={{ rke2_cordon_and_drain_command_dry_run }} {{ rke2_node_name }} | kubectl drain --force --ignore-daemonsets --delete-local-data -- grace-period=-1 --timeout=600s
  args:
    executable: /bin/bash
  register: drain
  changed_when: "'configmap/node- labels' in drain.stdout"
  until: drain is succeeded
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_active_server }}"
  run_once: true
  when: rke2_drain_node_during_upgrade

- name: Restart the RKE2 service
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  ansible.builtin.shell: kubectl wait --for=condition=Ready node --all --timeout=60s
  args:
    executable: /bin/bash
  register: result
  changed_when: false
  until: (result.rc == 0)
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_active_server }}"
  run_once: true

- name: Uncordon the node after the upgrade
  ansible.builtin.shell: kubectl uncordon {{ rke2_node_name }}
  args:
    executable: /bin/bash
  delegate_to: "{{ rke2_active_server }}"
  run_once: true
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  ansible.builtin.shell: kubectl wait --for=condition=Ready pod --all --timeout=60s
  args:
    executable: /bin/bash
  register: result
  changed_when: false
  until: (result.rc == 0)
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_active_server }}"
  run_once: true
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  ansible.builtin.shell: kubectl wait {{ rke2_wait_for_all_pods_to_be_healthy_args }}
  args:
    executable: /bin/bash
  register: result
  changed_when: false
  until: (result.rc == 0)
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_active_server }}"
  run_once: true
  when: rke2_wait_for_all_pods_to_be_healthy



