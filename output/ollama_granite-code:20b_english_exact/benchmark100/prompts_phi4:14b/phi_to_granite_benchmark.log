---
- name: "Set up keepalived for high availability"
  hosts: nodes
  tasks:
    - name: "Update package manager cache"
      ansible.builtin.apt:
        update_cache: true
        cache_valid_time: 3600
      when: ansible_pkg_mgr == "apt"
    - name: "Install keepalived package"
      ansible.builtin.package:
        name: keepalived
        state: present
    - name: "Create directory for keepalived configuration files"
      ansible.builtin.file:
        path: /etc/keepalived
        state: directory
        mode: "0755"
        owner: root
        group: root
    - name: "Create Kubernetes API health check script for Debian systems"
      ansible.builtin.template:
        src: check_apiserver.sh.j2
        dest: /etc/keepalived/check_apiserver.sh
        mode: "0755"
        owner: root
        group: root
      notify: "Restart keepalived"
      when: ansible_os_family == "Debian"
    - name: "Create Kubernetes API health check script for RedHat systems"
      ansible.builtin.template:
        src: check_apiserver.sh.j2
        dest: /usr/libexec/keepalived/check_apiserver.sh
        mode: "0755"
        owner: root
        group: root
      notify: "Restart keepalived"
      when: ansible_os_family == "RedHat"
    - name: "Create RKE2 Server health check script for Debian systems"
      ansible.builtin.template:
        src: check_rke2server.sh.j2
        dest: /etc/keepalived/check_rke2server.sh
        mode: "0755"
        owner: root
        group: root
      notify: "Restart keepalived"
      when: ansible_os_family == "Debian"
    - name: "Create RKE2 Server health check script for RedHat systems"
      ansible.builtin.template:
        src: check_rke2server.sh.j2
        dest: /usr/libexec/keepalived/check_rke2server.sh
        mode: "0755"
        owner: root
        group: root
      notify: "Restart keepalived"
      when: ansible_os_family == "RedHat"
    - name: "Create keepalived configuration file"
      ansible.builtin.template:
        src: keepalived.conf.j2
        dest: /etc/keepalived/keepalived.conf
        mode: "0644"
        owner: root
        group: root
      notify: "Restart keepalived"
    - name: "Enable keepalived service"
      ansible.builtin.systemd:
        name: keepalived
        enabled: true
        masked: false
      notify: "Restart keepalived"
  handlers:
    - name: "Restart keepalived"
      ansible.builtin.systemd:
        name: keepalived
        state: restarted


