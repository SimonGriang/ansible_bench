---
- name: Import the assertions defined in `assert.yml` ensuring they are executed on the localhost and only once to validate the playbook's environment and prerequisites.
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install the logrotate package on the target system using the package names specified in the variable `logrotate_packages`, ensuring it is present on the system.
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Use the Jinja2 template file specified by `logrotate_config_file` to generate the logrotate configuration file, saving it to the directory specified by `logrotate_config_directory` with appropriate permissions.
  template:
    src: "{{ logrotate_config_file }}"
    dest: "{{ logrotate_config_directory }}"
    mode: "0644"
  notify: restart logrotate

- name: For each log entry defined in `logrotate_entries`, create a configuration file from the `entry.j2` template in the directory specified by `logrotate_confd_directory`. Only generate files for entries that are not marked as "absent".
  template:
    src: entry.j2
    dest: "{{ logrotate_confd_directory }}/{{ item.name }}"
    mode: "0644"
  loop: "{{ logrotate_entries }}"
  loop_control:
    label: "Generating logrotate.d configuration for {{ item.name }}"
  when: item.state is not defined or item.state != "absent"
  notify: restart logrotate

- name: Identify log entries in `logrotate_entries` marked as "absent" and remove their corresponding configuration files from the directory specified by `logrotate_confd_directory`.
  file:
    path: "{{ logrotate_confd_directory }}/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  loop_control:
    label: "Removing logrotate.d configuration for {{ item.name }}"
  when: item.state is defined and item.state == "absent"
  notify: restart logrotate

- name: If a logrotate service is defined, ensure it is started and enabled by using the variables `logrotate_service`, `logrotate_service_state`, and `logrotate_service_enabled` to set its state and enabled status.
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service is defined


