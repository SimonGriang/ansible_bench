---
- name: Restart RKE2 service
  systemd:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for nodes to be ready again
  shell: |
    kubectl get node --selector=node-role.kubernetes.io/worker -o json | jq '.items | length'
  args:
    executable: /bin/bash
  register: node_count
  until: node_count.stdout | int == groups['rke2_cluster_group_name'] | length
  retries: 100
  delay: 15
  delegate_to: "{{ item }}"
  run_once: true
  changed_when: false
  check_mode: no
  with_items:
    - "{{ groups['rke2_active_server'] }}"

- name: Wait for all pods to be ready again
  shell: |
    kubectl wait --for=condition=Ready pod --all --timeout=60s
  args:
    executable: /bin/bash
  register: pod_status
  until: pod_status.rc == 0
  retries: 100
  delay: 15
  delegate_to: "{{ item }}"
  run_once: true
  changed_when: false
  check_mode: no
  when: rke2_wait_for_all_pods_to_be_ready
  with_items:
    - "{{ groups['rke2_active_server'] }}"


