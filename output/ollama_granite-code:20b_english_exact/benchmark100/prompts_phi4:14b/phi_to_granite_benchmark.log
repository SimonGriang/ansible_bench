---

- name: "Python pip management"
  block:
    - name: "Task 1: Check for the existence of the EXTERNALLY-MANAGED file for Python 3.11"
      stat:
        path: /usr/lib/python3.11/EXTERNALLY-MANAGED
      register: python_3_11_managed_externally

    - name: "Task 2: Rename the EXTERNALLY-MANAGED file for Python 3.11 if it exists"
      copy:
        src: /usr/lib/python3.11/EXTERNALLY-MANAGED
        dest: /usr/lib/python3.11/EXTERNALLY-MANAGED.old
        backup: yes
      when: python_3_11_managed_externally.stat.exists

    - name: "Task 3: Check for the existence of the EXTERNALLY-MANAGED file for Python 3.12"
      stat:
        path: /usr/lib/python3.12/EXTERNALLY-MANAGED
      register: python_3_12_managed_externally

    - name: "Task 4: Rename the EXTERNALLY-MANAGED file for Python 3.12 if it exists"
      copy:
        src: /usr/lib/python3.12/EXTERNALLY-MANAGED
        dest: /usr/lib/python3.12/EXTERNALLY-MANAGED.old
        backup: yes
      when: python_3_12_managed_externally.stat.exists

    - name: "Task 5: Import tasks from assert.yml"
      import_tasks: assert.yml
      delegate_to: localhost
      run_once: yes

    - name: "Task 6: Install Python pip"
      package:
        name: "{{ python_pip_packages }}"
        state: present

    - name: "Task 7: Configure pip proxy settings"
      lineinfile:
        path: /etc/pip.conf
        line: "index-url = {{ python_pip_proxy }}"
        create: yes
      when: python_pip_proxy is defined

    - name: "Task 8: Configure trusted hosts for pip"
      lineinfile:
        path: /etc/pip.conf
        line: "trusted-host = {{ python_pip_trusted_host }}"
        create: yes
      when: python_pip_trusted_host is defined

    - name: "Task 9: Update pip to the latest version"
      package:
        name: "{{ python_pip_pip_package }}"
        state: "{{ python_pip_pip_state }}"
        executable: "{{ python_pip_executable }}"
      when: python_pip_update and not (ansible_distribution_release in ["bookworm", "noble"]) and not (ansible_os_family == "Alpine")

    - name: "Task 10: Install requested Python modules"
      pip:
        name: "{{ item.name }}"
        state: "{{ item.state | default('present') }}"
        version: "{{ item.version | defaultomit }}"
        executable: "{{ python_pip_executable }}"
      loop: "{{ python_pip_modules }}"
      when: not (ansible_distribution_release in ["bookworm", "noble"]) and not (ansible_os_family == "Alpine")
  when: python_pip_manage


