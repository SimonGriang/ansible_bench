---
- name: Task 1
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Task 3
  meta: flush_handlers

- name: Task 4
  when:
  - ansible_selinux.status is defined
  - not (ansible_connection | regex_search("container|docker|community.docker.docker"))
  block:
  - name: Task 4a
    selinux:
      state: "{{ selinux_state }}"
      policy: "{{ selinux_policy }}"
    notify: Reboot
  - name: Task 4b
    selinuxboolean:
      name: "{{ item.name }}"
      state: "{{ item.state }}"
      persistent: "{{ item.persistent }}"
    loop: "{{ selinux_booleans }}"
    loop_control:
      label: "{{ item.name }}"


