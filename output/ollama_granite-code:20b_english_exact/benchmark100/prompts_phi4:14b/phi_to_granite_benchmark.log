---
- name: Ensure unzip package is installed
  ansible.builtin.apt:
    name: unzip
    update_cache: "{{ promtail_apt_update_cache }}"
    state: present
  tags:
    - promtail

- name: Create Promtail group
  ansible.builtin.group:
    name: "{{ promtail_system_group }}"
    state: present
  when: promtail_system_group != "root"
  tags:
    - promtail

- name: Create Promtail user
  ansible.builtin.user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    groups: "{{ promtail_user_additional_groups }}"
    shell: /usr/sbin/nologin
    createhome: false
  when: promtail_system_user != "root"
  tags:
    - promtail

- name: Ensure /usr/local/bin directory exists
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    mode: 0755
  tags:
    - promtail

- name: Create Promtail directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: "{{ promtail_system_group }}"
    mode: 0770
  loop:
    - "{{ promtail_config_dir }}"
    - "{{ promtail_config_dir }}/file_sd"
    - "{{ promtail_positions_dir }}"
  tags:
    - promtail

- name: Create Promtail application directories
  ansible.builtin.file:
    path: "{{ promtail_install_dir }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0755
  tags:
    - promtail

- name: Check Promtail binary
  ansible.builtin.stat:
    path: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}"
  register: promtail_binary
  tags:
    - promtail

- name: Download Promtail binaries if not present locally
  ansible.builtin.get_url:
    url: "{{ promtail_dist_url }}"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_dst_name }}"
    checksum: "{{ promtail_custom_checksum | default(omit) }}"
    mode: 0644
  when: not promtail_binary.stat.exists and promtail_local_dir is not defined
  tags:
    - promtail

- name: Propagate a locally distributed Promtail archive
  ansible.builtin.copy:
    src: "{{ promtail_local_dir }}/{{ promtail_tmp_name }}"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_dst_name }}"
    mode: 0644
  when: not promtail_binary.stat.exists and promtail_local_dir is defined
  tags:
    - promtail

- name: Download Promtail binaries to controller node
  ansible.builtin.get_url:
    url: "{{ promtail_dist_url }}"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_dst_name }}"
    mode: 0644
  delegate_to: localhost
  run_once: true
  when: promtail_binary_propagate
  tags:
    - promtail

- name: Propagate Promtail binaries across nodes
  ansible.builtin.copy:
    src: "{{ promtail_tmp_dir }}/{{ promtail_dst_name }}"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_dst_name }}"
    mode: 0644
  when: promtail_binary_propagate
  tags:
    - promtail

- name: Unpack Promtail binaries
  ansible.builtin.unarchive:
    src: "{{ promtail_tmp_dir }}/{{ promtail_dst_name }}"
    dest: "{{ promtail_install_dir }}"
    creates: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}"
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    remote_src: true
  when: not promtail_binary.stat.exists
  tags:
    - promtail

- name: Create symlink to latest version of Promtail
  ansible.builtin.file:
    src: "{{ promtail_install_dir }}/promtail-{{ promtail_version }}"
    dest: /usr/local/bin/promtail
    owner: root
    group: root
    state: link
  notify: Restart Promtail
  tags:
    - promtail

- name: Write Promtail configuration file
  ansible.builtin.template:
    src: promtail.yaml.j2
    dest: "{{ promtail_config_dir }}/promtail.yaml"
    owner: root
    group: "{{ promtail_system_group }}"
    mode: 0640
  notify: Restart Promtail
  tags:
    - promtail

- name: Create systemd service unit for Promtail
  ansible.builtin.template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: 0644
  notify: Restart Promtail
  tags:
    - promtail


