---
- name: Initialize Vault
  block:
    - name: Create system group for Vault
      group:
        name: "{{ vault_group }}"
        state: present

    - name: Create system user for Vault
      user:
        name: "{{ vault_user }}"
        group: "{{ vault_group }}"
        shell: "{{ vault_user_shell }}"
        createhome: false

    - name: Create download directory for Vault
      file:
        path: "{{ vault_download_path }}"
        state: directory
        owner: root
        group: root
        mode: 0755

    - name: Download Vault binary
      unarchive:
        src: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_amd64.zip"
        dest: "{{ vault_download_path }}"
        owner: root
        group: root
        mode: 0755
        remote_src: true

    - name: Create main Vault directory
      file:
        path: "{{ vault_path }}"
        state: directory
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: 0750
      when: not vault_check_path.stat.exists

    - name: Create additional directories in Vault directory
      file:
        path: "{{ vault_path }}/{{ item.path }}"
        state: directory
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_directories }}"
      when: not vault_check_path.stat.exists

    - name: Create data directories for Vault
      file:
        path: "{{ vault_path }}/{{ item.path }}"
        state: directory
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_data_directories }}"
      when: not vault_check_path.stat.exists

    - name: Generate TLS key and certificate for Vault
      shell: |
        openssl req -x509 -newkey rsa:4096 -nodes -keyout {{ vault_path }}/{{ item.key }} -out {{ vault_path }}/{{ item.cert }}
        chmod 600 {{ vault_path }}/{{ item.key }} {{ vault_path }}/{{ item.cert }}
      loop: "{{ vault_tls_files }}"
      args:
        creates: "{{ vault_path }}/{{ item.cert }}"
      notify: restart Vault

    - name: Set ownership of TLS files
      file:
        path: "{{ vault_path }}/{{ item.path }}"
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_tls_files }}"

    - name: Copy Vault binary to appropriate location
      copy:
        src: "{{ vault_download_path }}/vault"
        dest: "{{ vault_path }}/usr/bin/vault"
        owner: root
        group: root
        mode: 0755
      notify: restart Vault

    - name: Set capabilities on Vault binary
      capabilities:
        path: "{{ vault_path }}/usr/bin/vault"
        capability: cap_ipc_lock=ep
        state: present
      notify: restart Vault

    - name: Create vault environment file
      copy:
        dest: "{{ vault_path }}/etc/vault.d/vault.env"
        content: |
          VAULT_ADDR=http://127.0.0.1:8200
        owner: root
        group: root
        mode: 0640
      notify: restart Vault

    - name: Ensure systemd system directory exists
      file:
        path: /usr/lib/systemd/system
        state: directory
        owner: root
        group: root
        mode: 0755

    - name: Copy Vault service file for systemd
      template:
        src: vault.service.j2
        dest: /usr/lib/systemd/system/vault.service
        owner: root
        group: root
        mode: 0644
      notify: reload systemd
      when: vault_service_manager == "systemd"

    - name: Copy Vault configuration file
      template:
        src: vault.hcl.j2
        dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
        owner: root
        group: root
        mode: 0640
      notify: restart Vault
  handlers:
    - name: restart Vault
      systemd:
        name: vault
        daemon_reload: "{{ 'yes' if vault_service_manager == 'systemd' else 'no' }}"
        state: restarted
      when: vault_service_manager == "systemd"
    - name: reload systemd
      systemd:
        name: systemd
        daemon_reload: yes
      when: vault_service_manager == "systemd"


