ation\n    - Restart Apache HTTP server\n  when:\n  - ansible_os_family in [ "Debian", "SUSE" ]\n  - httpd_ports_conf is defined\n- import_tasks: directories.yml\n  when: httpd_directories is defined\n- name: Flush all pending handlers\n  ansible.builtin.meta: flush_handlers\n- name: Remove default HTML index file if specified\n  ansible.builtin.file:\n    path: "{{ httpd_data_dir }}/index.html"\n    state: absent\n  when: httpd_remove_example\n- name: Start and enable Apache HTTP server service\n  ansible.builtin.service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: yes' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-14T19:01:08.743700969Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14907559302, 'load_duration': 36448853, 'prompt_eval_count': 1005, 'prompt_eval_duration': 606856725, 'eval_count': 686, 'eval_duration': 14262829557, 'model_name': 'granite-code:20b'} id='run--9724a4d1-498e-4f4f-8418-3d0a62e7513c-0' usage_metadata={'input_tokens': 1005, 'output_tokens': 686, 'total_tokens': 1691}
