---
- name: Include tasks for installing Keepalived if RKE2 is running in HA mode with Keepalived enabled.
  include_tasks: "install-keepalived.yml"
  when:
    - rke2_ha_enabled | bool
    - rke2_keepalived_enabled | bool
    - inventory_hostname in groups['rke2_servers']
    - rke2_api_ip != None

- name: Include tasks for downloading and installing a specified version of RKE2.
  include_tasks: "download-and-install-rke2.yml"

- name: Include tasks for applying CIS hardening profiles if a CIS profile is defined.
  include_tasks: "apply-cis-hardening.yml"
  when:
    - rke2_cis_profile != None

- name: Include tasks for identifying the active server within the RKE2 cluster.
  include_tasks: "find-active-server.yml"

- name: Include tasks for enabling the IPVS kernel module if KubeVip IPVS load balancing is enabled.
  include_tasks: "enable-ipvs-kernel-module.yml"
  when:
    - rke2_kubevip_ipvs | bool
    - inventory_hostname in groups['rke2_servers']
    - rke2_ha_enabled | bool
    - rke2_keepalived_enabled == false

- name: Include tasks for copying kube-vip manifests to the master node.
  include_tasks: "copy-kube-vip-manifests.yml"
  when:
    - rke2_ha_enabled | bool
    - rke2_kubevip_enabled | bool
    - rke2_keepalived_enabled == false

- name: Include tasks for copying ingress-nginx manifests to the master node.
  include_tasks: "copy-ingress-nginx-manifests.yml"
  when:
    - rke2_ingress_nginx_values != None
    - rke2_ingress_nginx_values != ""

- name: Include tasks for preparing the first server node in the cluster.
  include_tasks: "prepare-first-server-node.yml"
  when:
    - rke2_first_server_node == inventory_hostname
    - rke2_server_count >= 1

- name: Include tasks for restoring etcd if specified.
  include_tasks: "restore-etcd.yml"
  when:
    - rke2_active_server != None
    - rke2_active_server == inventory_hostname or rke2_first_server_node == inventory_hostname
    - rke2_etcd_restore != None

- name: Include tasks for downloading the kubeconfig to the Ansible localhost.
  include_tasks: "download-kubeconfig.yml"
  when:
    - rke2_download_kubeconfig_enabled | bool
    - rke2_first_server_node == inventory_hostname

- name: Include tasks for preparing and joining remaining nodes to the cluster.
  include_tasks: "prepare-and-join-remaining-nodes.yml"
  when:
    - rke2_active_server != None
    - rke2_server_count >= 2

- name: Include tasks for performing a rolling cordon and drain restart on server nodes when the RKE2 version changes.
  include_tasks: "rolling-cordon-and-drain-restart-servers.yml"
  when:
    - rke2_version_changed | bool
    - inventory_hostname in groups['rke2_servers']

- name: Include tasks for performing a rolling cordon and drain restart on agent nodes when the RKE2 version changes.
  include_tasks: "rolling-cordon-and-drain-restart-agents.yml"
  when:
    - rke2_version_changed | bool
    - inventory_hostname in groups['rke2_agents']

- name: Flush handlers to ensure all triggered handlers are executed.
  meta: flush_handlers

- name: Include tasks for performing a rolling restart on all cluster nodes when configuration changes are detected.
  include_tasks: "rolling-restart-when-config-files-change.yml"

- name: Include tasks for finalizing the setup or configuration process.
  include_tasks: "final-steps.yml"


