---
- name: Install EPEL repository
  hosts: all
  tasks:
    - name: Ensure EPEL repository is installed
      when:
        - ansible_distribution == "Amazon" and ansible_distribution_major_version == "2"
        - ansible_distribution == "RedHat" and ansible_distribution_major_version in ["7", "8", "9"]
      block:
        - name: Add EPEL GPG key
          ansible.builtin.rpm_key:
            key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-8
            state: present

        - name: Install EPEL release package
          ansible.builtin.package:
            name: "{{ epel_url }}"
            state: present
          notify: Update package cache

        - name: Install EPEL next-release package
          ansible.builtin.package:
            name: "{{ epel_next_url }}"
            state: present
          notify: Update package cache

      vars:
        epel_url: https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm
        epel_next_url: https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm
        epel_next: true  # Set to true to install EPEL next-release package

  handlers:
    - name: Update package cache
      ansible.builtin.apt:
        update_cache: yes
        cache_valid_time: 3600



