---
- name: RKE2 Configuration
  tasks:
    - name: Create RKE2 configuration directory
      file:
        path: /etc/rancher/rke2
        state: directory
        owner: root
        group: root
        mode: "0755"

    - name: Set server node taints
      set_fact:
        combined_node_taints: "{{ rke2_server_node_taints }}"
      when: rke2_type == "server"

    - name: Set agent node taints
      set_fact:
        combined_node_taints: "{{ rke2_agent_node_taints }}"
      when: rke2_type == "agent"

    - name: Deploy RKE2 configuration file
      template:
        src: "{{ rke2_config }}"
        dest: /etc/rancher/rke2/config.yaml
        owner: root
        group: root
        mode: "0600"
      notify: Config file changed

    - name: Deploy kubelet configuration file
      template:
        src: kubelet-config.yaml.j2
        dest: /etc/rancher/rke2/kubelet-config.yaml
        owner: root
        group: root
        mode: "0600"
      notify: Config file changed
      when: rke2_kubelet_config | length > 0

    - name: Deploy Containerd registry configuration file
      template:
        src: "{{ rke2_custom_registry_path }}"
        dest: /etc/rancher/rke2/registries.yaml
        owner: root
        group: root
        mode: "0600"
      notify: Config file changed
      when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

    - name: Start RKE2 service
      service:
        name: "{{ rke2_service_name }}"
        state: started
        enabled: true
      environment:
        RKE2_TOKEN: "{{ rke2_token }}"
      notify: Service (re)started
      until: rke2_service_started is succeeded
      retries: 10
      delay: 3
      register: rke2_service_started

    - name: Mask other RKE2 services
      service:
        name: "{{ item }}"
        enabled: false
        masked: true
      loop: "{{ rke2_other_services }}"
      when: rke2_type != "server"

    - name: Verify node readiness without CNI
      shell: |
        # Command to verify node readiness without CNI
      args:
        executable: /bin/bash
      register: node_readiness_without_cni
      until: node_readiness_without_cni is succeeded
      retries: 100
      delay: 15
      changed_when: false
      when: rke2_type == "server" or rke2_type == "first_server" and not rke2_is_check_mode

    - name: Verify node readiness with CNI
      shell: |
        # Command to verify node readiness with CNI
      args:
        executable: /bin/bash
      register: node_readiness_with_cni
      until: node_readiness_with_cni is succeeded
      retries: 100
      delay: 15
      changed_when: false
      when: rke2_type == "server" or rke2_type == "first_server" and not rke2_is_check_mode

- name: handlers
  handlers:
    - name: Config file changed
      debug:
        msg: "RKE2 configuration file changed"

    - name: Service (re)started
      debug:
        msg: "RKE2 service restarted"


