---
- name: Import tasks from assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true
- name: Install DNS packages
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present
- name: Create DNS directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0755'
  with_items:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"
- name: Create DNS group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present
- name: Create DNS user
  ansible.builtin.user:
    name: "{{ dns_owner }}"
    state: present
    system: true
- name: Generate rndc key
  ansible.builtin.command: rndc-confgen -a
  args:
    creates: /etc/rndc.key
- name: Set rndc key file permissions
  ansible.builtin.file:
    path: /etc/rndc.key
    owner: root
    group: root
    mode: '0640'
- name: Download root hints file
  ansible.builtin.get_url:
    url: "{{ dns_root_hints_url }}"
    dest: /etc/bind/root.hints
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  notify:
    - Rndc reload
- name: Create primary zone files
  ansible.builtin.template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item }}.db"
    validate: named-checkzone {{ item }} %s
  with_items: "{{ dns_zones }}"
  notify:
    - Rndc reload
- name: Create named.conf file
  ansible.builtin.template:
    src: named.conf.j2
    dest: /etc/bind/named.conf
    validate: named-checkconf %s
  notify:
    - Restart DNS service
- name: Create systemd service override
  block:
    - name: Create override directory
      ansible.builtin.file:
        path: /etc/systemd/system/{{ dns_service }}.service.d
        state: directory
    - name: Copy override file
      ansible.builtin.copy:
        src: override.conf
        dest: /etc/systemd/system/{{ dns_service }}.service.d/override.conf
    - name: Reload systemd
      ansible.builtin.systemd:
        daemon_reload: true
  when: ansible_service_mgr == "systemd"
- name: Start and enable DNS service
  ansible.builtin.service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


