        - "{{ rke2_airgap_tarball_dir }}/rke2-darwin-amd64.tar.gz"
    - name: Handle additional tarballs in airgap mode
      when: rke2_airgap_mode and rke2_airgap_implementation != "exists"
      block:
        - name: Create additional images directory
          file:
            path: "{{ rke2_additional_images_dir }}"
            state: directory
            mode: "0755"
        - name: Copy additional tarballs
          copy:
            src: "{{ item }}"
            dest: "{{ rke2_additional_images_dir }}"
            mode: "0644"
            force: true
          loop: "{{ rke2_airgap_copy_additional_tarballs }}"
    - name: Ensure artifacts exist and have acceptable permissions in airgap mode
      when: rke2_airgap_mode and rke2_airgap_implementation == "exists"
      block:
        - name: Check if RKE2 artifacts exist
          stat:
            path: "{{ rke2_airgap_images_dir }}/rke2-Linux-amd64.tar.gz"
          register: rke2_linux_amd64_stat
        - name: Check if RKE2 artifacts exist
          stat:
            path: "{{ rke2_airgap_images_dir }}/rke2-Windows-amd64.tar.gz"
          register: rke2_windows_amd64_stat
        - name: Check if RKE2 artifacts exist
          stat:
            path: "{{ rke2_airgap_images_dir }}/rke2-darwin-amd64.tar.gz"
          register: rke2_darwin_amd64_stat
        - name: Check if RKE2 artifacts exist
          stat:
            path: "{{ rke2_airgap_install_script_path }}"
          register: rke2_install_script_stat
        - name: Adjust permissions on RKE2 artifacts
          file:
            path: "{{ rke2_airgap_images_dir }}"
            state: directory
            recurse: true
            mode: "0644"
        - name: Check if RKE2 installation script is executable
          stat:
            path: "{{ rke2_airgap_install_script_path }}"
            follow: false
          register: rke2_install_script_exec
        - name: Set RKE2 version facts
          set_fact:
            rke2_installed_version: "{{ rke2_version }}"
            rke2_running_version: "{{ rke2_version }}"



