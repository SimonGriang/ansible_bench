---
- name: Vault hardening
  block:
    - name: Disable swap
      command: swapoff -a
      when: ansible_swaptotal_mb > 0 and vault_hardening_disable_swap

    - name: Remove swapfile from /etc/fstab
      lineinfile:
        path: /etc/fstab
        regexp: '^swap'
        state: absent
      when: ansible_swaptotal_mb > 0 and vault_hardening_disable_swap

    - name: Disable core dumps
      pam_limits:
        domain: "{{ item }}"
        limit_type: both
        limit_item: core
        value: '0'
