---
- name: Perform SELinux configuration
  hosts: all
  tasks:
    - import_tasks: assert.yml
    - name: Install SELinux packages
      ansible.builtin.package:
        name: "{{ selinux_requirements }}"
        state: present
      notify: Gather facts
    - name: Flush handlers
      ansible.builtin.meta: flush_handlers
    - name: Configure SELinux
      ansible.posix.selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      when: ansible_selinux.status is defined and not (ansible_container_platform is defined or ansible_virtualization_type == "docker")
      notify: Reboot
    - name: Manage SELinux booleans
      ansible.posix.seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      when: selinux_booleans is defined
      label: "{{ item.name }}"


