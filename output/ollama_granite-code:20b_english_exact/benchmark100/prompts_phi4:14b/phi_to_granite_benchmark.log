---
- import_tasks: assert.yml
- name: Install the git package
  package:
    name: "{{ git_packages }}"
    state: present
- name: Check if git user exists in system
  getent:
    database: passwd
    key: "{{ git_username }}"
    fail_key: false
- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    mode: 0700
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when:
    - getent_passwd["{{ git_username }}"] is defined
- name: Place git configuration file
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when:
    - getent_passwd["{{ git_username }}"] is defined
    - git_user_email is defined
    - git_user_name is defined
- name: Create repository destination directory
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    mode: 0755
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when:
    - getent_passwd["{{ git_username }}"] is defined
    - git_repository_destination is defined
- name: Clone repositories
  git:
    repo: "{{ item.value.repo }}"
    dest: "{{ git_repository_destination }}/{{ item.value.dest }}"
    version: "{{ item.value.version | default(omit) }}"
    accept_hostkey: true
    force: "{{ item.value.force | default(false) }}"
    key_file: "{{ item.value.key_file | default(omit) }}"
    recursive: "{{ item.value.recursive | default(omit) }}"
    remote: "{{ item.value.remote | default(omit) }}"
    update: "{{ item.value.update | default(omit) }}"
    user: "{{ git_username }}"
  with_dict: "{{ git_repositories }}"
  when:
    - git_repositories is defined
    - git_repository_destination is defined
    - getent_passwd["{{ git_username }}"] is defined


