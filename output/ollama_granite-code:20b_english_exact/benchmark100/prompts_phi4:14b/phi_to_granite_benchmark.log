- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- when: hashicorp_install_method == "package"
  block:
    - name: Download HashiCorp GPG key
      ansible.builtin.get_url:
        url: "{{ hashicorp_gpg_key_url }}"
        dest: "{{ hashicorp_download_dir }}/gpg-key-hashi-CORP.asc"
        mode: "0644"

    - name: Import HashiCorp GPG key
      ansible.builtin.command: gpg --import {{ hashicorp_download_dir }}/gpg-key-hashi-CORP.asc

    - name: Configure HashiCorp repository (RedHat / Rocky)
      ansible.builtin.copy:
        dest: /etc/yum.repos.d/hashcorp.repo
        content: |
          [hashcorp]
          name=HashiCorp Repository
          baseurl={{ hashicorp_repo_url }}
          enabled=1
          gpgcheck=1
          gpgkey={{ hashicorp_gpg_key_url }}
        mode: "0644"
      when: ansible_os_family == "RedHat" or ansible_os_family == "Rocky"

    - name: Configure HashiCorp repository (Debian)
      ansible.builtin.apt_repository:
        repo: deb {{ hashicorp_repo_url }}
        filename: hashcorp
        update_cache: true
        state: present
      when: ansible_os_family == "Debian"

    - name: Install HashiCorp products
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ hashicorp_products }}"
      register: hashicorp_package_install
      until: hashicorp_package_install is success
      retries: "{{ hashicorp_retries }}"
      delay: "{{ hashicorp_delay }}"

    - name: Install latest version of HashiCorp products
      ansible.builtin.package:
        name: "{{ item }}"
        state: latest
      loop: "{{ hashicorp_products }}"
      when: hashicorp_install_method == "package" and hashicorp_products_latest | bool
  when: hashicorp_products is defined and hashicorp_products | length > 0

- when: hashicorp_install_method == "manual"
  block:
    - name: Download and extract HashiCorp products
      ansible.builtin.unarchive:
        src: "{{ hashicorp_download_url }}"
        dest: "{{ hashicorp_download_dir }}"
        owner: root
        group: root
        mode: "0755"
        remote_src: true
      register: hashicorp_manual_install
      until: hashicorp_manual_install is success
      retries: "{{ hashicorp_retries }}"
      delay: "{{ hashicorp_delay }}"
  when: hashicorp_products is defined and hashicorp_products | length > 0


