    path: "{{ java_certs[item].src }}"
  loop: "{{ java_certs }}"
  register: java_certs_stats

- name: Fail if any Java certificate is missing
  ansible.builtin.fail:
    msg: "Java certificate {{ item.item.src }} missing"
  loop: "{{ java_certs_stats.results }}"
  when: not item.stat.exists

- name: Set keystore directory variables for Java versions < 11
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_keystores[0].dest | dirname }}"
  when: java_version.stdout | version_compare('11', '<')

- name: Set keystore directory variables for Java versions >= 11
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_keystores[1].dest | dirname }}"
  when: java_version.stdout | version_compare('11', '>=')

- name: Import SSL certificates into the Java keystore
  community.general.java_cert:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    storepass: "{{ java_keystore_pass }}"
    keypass: "{{ java_keystore_pass }}"
    name: "{{ item.name }}"
  loop: "{{ java_certs }}"
  when: item.src is defined


