---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages for OpenSSL
  package:
    name: "{{ openssl_requirements }}"
    state: present
  when: openssl_requirements is defined and openssl_requirements | length > 0

- name: Install pip packages
  pip:
    name: "{{ openssl_pip_packages }}"
  when: openssl_pip_packages is defined and openssl_pip_packages | length > 0

- name: Create directory for OpenSSL keys
  file:
    path: "{{ openssl_key_path }}"
    state: directory
    mode: 0700
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create directory for OpenSSL CSRs
  file:
    path: "{{ openssl_csr_path }}"
    state: directory
    mode: 0755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create directory for OpenSSL certificates
  file:
    path: "{{ openssl_cert_path }}"
    state: directory
    mode: 0755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: openssl_item
  when: openssl_items is defined and openssl_items | length > 0


