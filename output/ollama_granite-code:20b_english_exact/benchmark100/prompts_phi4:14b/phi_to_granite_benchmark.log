---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify: Set root password and restart mysql

- name: Configure mysql server
  community.mysql.mysql_variables:
    config_file: "{{ mysql_configuration_destination }}"
    variable: "{{ item.key }}"
    value: "{{ item.value }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_configuration_options | dict2items }}"
  no_log: true

- name: Configure mysql client
  community.mysql.mysql_variables:
    config_file: "{{ mysql_configuration_destination }}"
    variable: socket
    value: "{{ mysql_socket }}"
    section: client
    login_user: root
    login_password: "{{ mysql_root_password }}"

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  args:
    creates: "{{ mysql_datadir }}/mysql"
  when: ansible_os_family == "Debian"

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_os_family == "Archlinux"

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: "0640"

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    encoding: "{{ item.encoding | default(omit) }}"
    collation: "{{ item.collation | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    state: present
    host: "{{ item.host | default(omit) }}"
    priv: "{{ item.priv | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


