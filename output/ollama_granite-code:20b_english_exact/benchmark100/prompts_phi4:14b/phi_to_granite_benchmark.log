---

- name: Import assert.yml tasks file
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install PHP
  ansible.builtin.package:
    name: "{{ php_packages }}"
    state: present

- name: Find php.ini location
  ansible.builtin.shell: |
    {{ php_ini_command }}
  changed_when: false
  when: php_ini_location is not defined
  register: php_found_ini_location

- name: Configure php.ini
  ansible.builtin.template:
    src: php.ini.j2
    dest: "{{ php_found_ini_location.stdout }}"
    mode: "0644"
  notify: restart httpd


