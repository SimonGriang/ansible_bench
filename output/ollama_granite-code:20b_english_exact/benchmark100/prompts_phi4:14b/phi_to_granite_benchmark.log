---
- name: Remove Docker apt key and old source list file
  file:
    path: "{{ item }}"
    state: absent
  loop:
    - /etc/apt/trusted.gpg.d/docker-ce.gpg
    - /etc/apt/sources.list.d/docker.list

- name: Uninstall obsolete Docker packages
  apt:
    name: docker-ce
    state: absent

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install necessary dependencies for Docker
  apt:
    name: software-properties-common
    state: present

- name: Add or remove Docker repository based on a condition
  apt_repository:
    repo: "deb [arch=amd64] https://download.docker.com/linux/ubuntu xenial stable"
    state: present
  when: docker_repository == "add"

- name: Flush handlers to update the apt cache
  meta: flush_handlers


