- name: rke2-install
  vars:
    rke2_url: https://github.com/rke2/rke2/releases/download/v1.23.6%2Brke2r1/rke2-install.sh
    rke2_checksum_url: https://github.com/rke2/rke2/releases/download/v1.23.6%2Brke2r1/sha256sum-amd64.txt
    rke2_airgap_install_script_path: /path/to/rke2-install.sh
    rke2_airgap_tarball_dir: /path/to/airgap/tarballs
    rke2_airgap_images_dir: /path/to/airgap/images
    rke2_additional_images_dir: /path/to/additional/images
    rke2_binary_path: /usr/local/bin/rke2
    rke2_config_file: /etc/rke2/rke2.yaml
    rke2_custom_manifests:
      - /path/to/custom/manifest1.yaml
      - /path/to/custom/manifest2.yaml
    rke2_static_pods:
      - /path/to/static/pod1.yaml
      - /path/to/static/pod2.yaml
    rke2_env_file: /path/to/rke2-env-file.sh
    rke2_version: v1.23.6+rke2r1
    rke2_allow_downgrade: false
  tasks:
    - name: Download RKE2 installation script if not in airgap mode
      when: not rke2_airgap_mode
      get_url:
        url: "{{ rke2_url }}"
        dest: "{{ rke2_airgap_install_script_path }}"
        mode: "0755"
        timeout: 30
    - name: Copy local RKE2 installation script if in airgap mode
      when: rke2_airgap_mode and rke2_airgap_implementation == "copy"
      copy:
        src: "{{ rke2_airgap_install_script_path }}"
        dest: "{{ rke2_airgap_install_script_path }}"
        mode: "0755"
        force: true
    - name: Create RKE2 artifacts folder if in airgap mode and the implementation is not 'exists'
      when: rke2_airgap_mode and rke2_airgap_implementation != "exists"
      file:
        path: "{{ rke2_airgap_tarball_dir }}"
        state: directory
        mode: "0755"
    - name: Download RKE2 checksum and artifacts with a fallback mechanism for airgap mode
      when: rke2_airgap_mode
      block:
        - name: Download checksum file
          get_url:
            url: "{{ rke2_checksum_url }}"
            dest: "{{ rke2_airgap_tarball_dir }}/sha256sum-amd64.txt"
            mode: "0644"
        - name: Download RKE2 artifacts
          get_url:
            url: "{{ item.url }}"
            dest: "{{ rke2_airgap_tarball_dir }}/{{ item.dest }}"
            checksum: "sha256:{{ item.checksum }}"
            mode: "0644"
            timeout: 30
          loop:
            - url: "{{ rke2_url }}"
              dest: rke2-install.sh
              checksum: "{{ rke2_checksum }}"
