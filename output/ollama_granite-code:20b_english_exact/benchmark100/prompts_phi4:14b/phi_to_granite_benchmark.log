---
- name: "Include assert.yml"
  import_tasks: assert.yml
  run_once: true
- name: "Install cron"
  package:
    name: "{{ cron_packages }}"
    state: present
- name: "Configure shell"
  lineinfile:
    path: /etc/cron.d/env
    regexp: "^SHELL="
    line: "SHELL={{ cron_shell }}"
    state: present
    mode: 0644
    backup: true
  notify: restart cron
- name: "Configure path"
  lineinfile:
    path: /etc/cron.d/env
    regexp: "^PATH="
    line: "PATH={{ cron_path }}"
    state: present
    mode: 0644
    backup: true
  notify: restart cron
- name: "Configure mailto"
  lineinfile:
    path: /etc/cron.d/env
    regexp: "^MAILTO="
    line: "MAILTO={{ cron_mailto }}"
    state: present
    mode: 0644
    backup: true
  notify: restart cron
- name: "Start and enable cron"
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service | length > 0
- name: "Schedule requested cron jobs"
  cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    state: present
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined


