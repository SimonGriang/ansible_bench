---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify: Set root password and restart mysql

- name: Configure mysql server
  mysql_variables:
    config_file: "{{ mysql_configuration_destination }}"
    variable: "{{ item.key }}"
    value: "{{ item.value }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_configuration_options|dict2items }}"
  no_log: true

- name: Configure mysql client
  mysql_variables:
    config_file: "{{ mysql_configuration_destination }}"
    variable: "socket"
    value: "{{ mysql_socket }}"
    section: client
    login_user: root
    login_password: "{{ mysql_root_password }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: "{{ mysql_datadir }}/mysql"
  when: ansible_os_family == "Debian"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_os_family == "Archlinux"

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    encoding: "{{ item.encoding | default(omit) }}"
    collation: "{{ item.collation | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    state: present
    host: "{{ item.host | default(omit) }}"
    priv: "{{ item.priv | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  meta: flush_handlers


