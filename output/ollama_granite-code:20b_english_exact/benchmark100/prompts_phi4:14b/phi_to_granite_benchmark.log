---
- name: Import common assertions for the httpd role
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install the apache httpd package
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings for httpd
  block:
    - name: Modify SELinux boolean settings
      ansible.posix.seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: true
      with_items: "{{ httpd_sebooleans }}"

    - name: Allow connections to custom ports
      community.general.seport:
        port: "{{ item }}"
        proto: tcp
        setype: http_port_t
        state: present
      with_items:
        - "{{ httpd_port }}"
        - "{{ httpd_ssl_port }}"
  when: selinux_enabled_status

- name: Configure the httpd main configuration file
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "0644"
  notify: Test configuration and restart httpd

- name: Activate httpd modules using a command
  ansible.builtin.command: "httpd -M {{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  notify: Test configuration and restart httpd
  when: ansible_os_family == "Debian"

- name: Import SSL configuration tasks
  ansible.builtin.import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import location configuration tasks
  ansible.builtin.import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual host configuration tasks
  ansible.builtin.import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports using a template
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    mode: "0644"
  notify: Test configuration and restart httpd
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"

- name: Import directory configuration tasks
  ansible.builtin.import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush all pending handlers
  ansible.builtin.meta: flush_handlers

- name: Remove the default index.html file
  ansible.builtin.file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable the httpd service
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


