---
- name: Prepare Load Balancer with keepalived
  hosts:lb
  vars:
    ansible_ssh_pipelining: yes
  tasks:
    - name: Update package cache
      package:
        update_cache: yes
      when: ansible_os_family == "Debian"
      register: pkg_result
      until: pkg_result is success
      retries: 5
      delay: 20
      tags:
        - always

    - name: Install keepalived package
      package:
        name: keepalived
        state: present
      tags:
        - packages

    - name: Create keepalived directory
      file:
        path: /etc/keepalived
        owner: root
        group: root
        mode: 0755
        state: directory
      tags:
        - configuration

    - name: Create Kubernetes API health check script for Debian OS family
      template:
        src: k8s-api-check.sh.j2
        dest: /etc/keepalived/k8s_api_check.sh
        owner: root
        group: root
        mode: 0755
      notify: restart keepalived
      tags:
        - configuration

    - name: Create Kubernetes API health check script for RedHat OS family
      template:
        src: k8s-api-check.sh.j2
        dest: /usr/libexec/keepalived/k8s_api_check.sh
        owner: root
        group: root
        mode: 0755
      notify: restart keepalived
      tags:
        - configuration

    - name: Create RKE2 Server health check script for Debian OS family
      template:
        src: rke2-server-check.sh.j2
        dest: /etc/keepalived/rke2_server_check.sh
        owner: root
        group: root
        mode: 0755
      notify: restart keepalived
      tags:
        - configuration

    - name: Create RKE2 Server health check script for RedHat OS family
      template:
        src: rke2-server-check.sh.j2
        dest: /usr/libexec/keepalived/rke2_server_check.sh
        owner: root
        group: root
        mode: 0755
      notify: restart keepalived
      tags:
        - configuration

    - name: Create keepalived configuration file
      template:
        src: keepalived.conf.j2
        dest: /etc/keepalived/keepalived.conf
        owner: root
        group: root
        mode: 0644
      notify: restart keepalived
      tags:
        - configuration

    - name: Enable and unmask keepalived service
      service:
        name: keepalived
        enabled: yes
        state: started
        masked: no
      notify: restart keepalived
      tags:
        - configuration

    - name: Flush handlers
      meta: flush_handlers

  handlers:
    - name: restart keepalived
      service:
        name: keepalived
        state: restarted



