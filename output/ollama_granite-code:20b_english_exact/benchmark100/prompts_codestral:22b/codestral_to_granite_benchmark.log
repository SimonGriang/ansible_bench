      src: "{{ rke2_local_install_src }}"
      dest: "{{ rke2_install_dest }}"
      mode: 0755
    when: rke2_airgap_enabled and rke2_airgap_impl == "copy"
  - name: Create RKE2 artifacts folder
    file:
      path: "{{ rke2_install_dest }}"
      state: directory
      mode: 0755
