---
- name: "RKE2 installation"
  block:
  - name: Download RKE2 installation script
    get_url:
      url: "{{ rke2_url }}"
      dest: "{{ rke2_install_dest }}"
      mode: 0755
    when: not rke2_airgap_enabled
  - name: Copy local RKE2 installation script
    copy:
      src: "{{ rke2_local_install_src }}"
      dest: "{{ rke2_install_dest }}"
      mode: 0755
    when: rke2_airgap_enabled and rke2_airgap_impl == "copy"
  - name: Create RKE2 artifacts folder
    file:
      path: "{{ rke2_install_dest }}"
      state: directory
      mode: 0755
    when: rke2_airgap_enabled and rke2_airgap_impl != "exists"
  - name: Download RKE2 checksum and artifacts
    block:
    - name: Download checksum
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_install_dest }}/rke2-checksums.txt"
    - name: Download artifacts
      get_url:
        url: "{{ rke2_url }}"
        dest: "{{ rke2_install_dest }}"
      until:
      - rke2_checksums_url not in rke2_install_dest + '/rke2-checksums.txt'
      retries: 4
      delay: 5
    - name: Copy local checksum
      copy:
        src: "{{ rke2_local_checksum_src }}"
        dest: "{{ rke2_install_dest }}/rke2-checksums.txt"
      when: rke2_airgap_impl == "copy"
    - name: Copy local artifacts
      copy:
        src: "{{ rke2_local_install_src }}"
        dest: "{{ rke2_install_dest }}"
      when: rke2_airgap_impl == "copy"
    - name: Compare checksum
      command: "grep {{ rke2_url }} {{ rke2_install_dest }}/rke2-checksums.txt | sha256sum -c -"
      failed_when: false
      changed_when: false
    - name: Download install script
      get_url:
        url: "{{ rke2_url }}"
        dest: "{{ rke2_install_dest }}"
      when: rke2_checksums_url not in rke2_install_dest + '/rke2-checksums.txt'
    when: rke2_airgap_enabled and rke2_airgap_impl == "download"
  - name: Copy local RKE2 artifacts
    copy:
      src: "{{ rke2_local_install_src }}"
      dest: "{{ rke2_install_dest }}"
      mode: 0755
    when: rke2_airgap_enabled and rke2_airgap_impl == "copy"
  - name: Copy additional images tarballs
    block:
    - name: Create RKE2 images folder
      file:
        path: "{{ rke2_images_dest }}"
        state: directory
        mode: 0755
    - name: Copy tarball images RKE2 components
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_images_dest }}"
        mode: 0644
      loop: "{{ rke2_airgap_tarball_images_src }}"
      when:
      - rke2_airgap_impl != "exists"
      - item != rke2_local_install_src
    when: rke2_airgap_enabled and rke2_airgap_tarball_images_src | length > 0
  - name: Ensure artifacts exist and have acceptable permissions
    block:
    - name: Check if artifacts exist
      stat:
        path: "{{ rke2_install_dest }}"
      register: rke2_binary
    - name: Check if artifacts have write permissions
      stat:
        path: "{{ rke2_install_dest }}"
        follow: false
      register: rke2_binary_stats
    - name: Set artifacts permissions
      file:
        path: "{{ rke2_install_dest }}"
        mode: a-w
      when: rke2_binary_stats.stat.mode != "0755"
    - name: Check if install script is executable
      stat:
        path: "{{ rke2_install_dest }}"
        follow: false
      register: rke2_binary_stats
    - name: Make install script executable
      file:
        path: "{{ rke2_install_dest }}"
        mode: a+x
      when: rke2_binary_stats.stat.mode != "0755"
    - name: Check if install script is executable
      stat:
        path: "{{ rke2_install_dest }}"
        follow: false
      register: rke2_binary_stats
    - name: Fail if install script is not executable
      fail:
        msg: "Install script {{ rke2_install_dest }} is not executable"
      when: not rke2_binary_stats.stat.executable
    - name: Fail if install script does not exist
      fail:
        msg: "Install script {{ rke2_install_dest }} does not exist"
      when: not rke2_binary.stat.exists
    when: rke2_airgap_enabled and rke2_airgap_impl == "exists"
  - name: Set RKE2 bin path
    block:
    - name: Populate service facts
      service_facts:
    - name: Get stats of filesystem object
      stat:
        path: /run
      register: mount_run
    - name: Check if separate partition
      set_fact:
        rke2_bin_path: /opt/rke2/rke2
        separate_partition: "{{ mount_run.stat.fstype == 'overlay' }}"
      when: '"rke2" in services'
    - name: Set RKE2 bin path
      set_fact:
        rke2_bin_path: /var/lib/rke2/bin
      when: rke2_bin_path is not defined
  - name: Check RKE2 version
    block:
    - name: Check if binary exists
      stat:
        path: "{{ rke2_bin_path }}"
      register: rke2_binary
    - name: Set installed version
      set_fact:
        installed_version: not installed
      when: not rke2_binary.stat.exists
    - name: Get running version
      shell: "{{ rke2_bin_path }} --version"
      register: rke2_version
      failed_when: false
      changed_when: false
      when: installed_version is not defined
    - name: Set running version
      set_fact:
        running_version: "{{ rke2_version.stdout }}"
      when: rke2_version is defined
    - name: Set running version
      set_fact:
        running_version: "{{ desired_version }}"
      when: desired_version is defined and desired_version == running_version
    - name: Prevent accidental RKE2 downgrade
      fail:
        msg: >
          Desired version {{ desired_version }} must not be less than running
          version {{ running_version }}.
      failed_when: desired_version is version_compare(running_version, "<") and not rke2_allow_downgrade
    - name: Prevent accidental RKE2 downgrade
      debug:
        msg: >
          Desired version {{ desired_version }} must not be less than running
          version {{ running_version }}.
      failed_when: desired_version is version_compare(running_version, "<") and not rke2_allow_downgrade
    when: rke2_version is not defined or desired_version is not defined or desired_version != running_version
  - name: Run RKE2 install script
    block:
    - name: Run install script with airgap variables
      shell: "{{ rke2_install_dest }} install --local-path {{ rke2_install_dest }} --airgap-vars"
      when: rke2_airgap_enabled
    - name: Run install script without airgap variables
      shell: "{{ rke2_install_dest }} install --local-path {{ rke2_install_dest }}"
      when: not rke2_airgap_enabled
    - name: Check if RKE2 binary exists
      stat:
        path: "{{ rke2_bin_path }}"
      register: rke2_binary
    - name: Check if RKE2 binary is executable
      stat:
        path: "{{ rke2_bin_path }}"
        follow: false
      register: rke2_binary_stats
    - name: Fail if RKE2 binary does not exist
      fail:
        msg: "RKE2 binary {{ rke2_bin_path }} does not exist"
      when: not rke2_binary.stat.exists
    - name: Fail if RKE2 binary is not executable
      fail:
        msg: "RKE2 binary {{ rke2_bin_path }} is not executable"
      when: not rke2_binary_stats.stat.executable
    when: installed_version is not defined or desired_version is not defined or installed_version != desired_version
  always:
  - name: Clean up RKE2 install script
    file:
      path: "{{ rke2_install_dest }}"
      state: absent



