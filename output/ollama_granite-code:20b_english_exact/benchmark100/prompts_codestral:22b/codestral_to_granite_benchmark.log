---

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  when: ansible_selinux.status == "enabled"
  ansible.posix.selinux:
    policy: "targeted"
    state: "permissive"
  changed_when: false

- name: Allow httpd to connect to port 80 and 443
  ansible.posix.seport:
    ports: "{{ item }}"
    proto: "tcp"
    setype: "http_port_t"
    state: "present"
  with_items:
    - "{{ httpd_port }}"
    - "{{ httpd_ssl_port }}"

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "0644"
  notify: Test and restart httpd

- name: Activate httpd modules | Debian
  when: ansible_os_family == "Debian"
  ansible.builtin.command: "a2enmod {{ item }}"
  with_items: "{{ httpd_modules_to_activate_with_command }}"
  notify: Test httpd configuration

- name: Import ssl.yml
  when: https_enable
  ansible.builtin.import_tasks: ssl.yml

- name: Import locations.yml
  when: httpd_locations is defined
  ansible.builtin.import_tasks: locations.yml

- name: Import vhosts.yml
  when: httpd_vhosts is defined
  ansible.builtin.import_tasks: vhosts.yml

- name: Configure ports
  when: ansible_os_family in ["Debian", "Suse"]
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_server_root ~ '/' ~ httpd_ports_conf }}"
    mode: "0644"
  notify: Test and restart httpd

- name: Import directories.yml
  when: httpd_directories is defined
  ansible.builtin.import_tasks: directories.yml

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  when: httpd_remove_example
  ansible.builtin.file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


