---
- name: Create local SSH key directory for user
  ansible.builtin.file:
    path: /home/user/.ssh
    state: directory
    mode: 0750
  become: true
  delegate_to: localhost
  run_once: true
  when: manage_ssh_key is defined and manage_ssh_key

- name: Manage user account
  ansible.builtin.user:
    name: user
    state: present
    comment: User
    create_home: true
    password: "{{ user.password }}"
    uid: "{{ user.uid | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    home: "{{ user.home | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    update_password: "{{ user.update_password | default(omit) }}"
    expires: "{{ user.expires | default(omit) }}"
    system: "{{ user.system | default(omit) }}"

- name: Set sudo options for user
  ansible.builtin.template:
    src: sudo.j2
    dest: /etc/sudoers.d/user
    mode: 0640
    validate: /usr/sbin/visudo --check --file %s
  become: true
  when: sudo_options is defined

- name: Remove sudo options for user
  ansible.builtin.file:
    path: /etc/sudoers.d/user
    state: absent
  become: true
  when: sudo_options is not defined

- name: Generate private SSH key for user
  ansible.builtin.command: "{{ users_ssh_keygen_command }}"
  args:
    creates: /home/user/.ssh/id_ed25519
  become: false
  delegate_to: localhost
  run_once: true
  when: manage_ssh_key is defined and manage_ssh_key

- name: Generate public SSH key for user
  ansible.builtin.shell: "{{ users_ssh_keygen_pubkey_command }}"
  args:
    creates: /home/user/.ssh/id_ed25519.pub
  become: false
  delegate_to: localhost
  run_once: true
  when: manage_ssh_key is defined and manage_ssh_key

- name: Convert private SSH key to ppk format for user
  ansible.builtin.shell: ssh-keygen -e -f "{{ users_ssh_key_directory }}/user" -C "Generated by Ansible role robertdebock.users"
  args:
    creates: /home/user/.ssh/id_ed25519.ppk
  become: false
  delegate_to: localhost
  run_once: true
  when: manage_ssh_key is defined and manage_ssh_key

- name: Get or set home directory for user
  ansible.builtin.getent:
    database: hosts
    key: user
    split: ":"
  become: true
  delegate_to: localhost
  run_once: true
  register: getent_hosts

- name: Create .ssh directory for user
  ansible.builtin.file:
    path: /home/user/.ssh
    state: directory
    mode: 0700
    owner: user
  become: true
  when: manage_ssh_key is defined and manage_ssh_key or private_keys is defined

- name: Deploy authorized keys for user
  ansible.posix.authorized_key:
    user: user
    key: "{{ authorized_keys }}"
  become: true
  when: authorized_keys is defined

- name: Remove unauthorized keys for user
  ansible.posix.authorized_key:
    user: user
    key: "{{ unauthorized_keys }}"
    state: absent
  become: true
  when: unauthorized_keys is defined

- name: Copy generated private SSH key for user
  ansible.builtin.copy:
    src: /path/to/generated/key
    dest: /home/user/.ssh/id_ed25519
    owner: user
    mode: 0400
  become: true
  when: copy_private_key is defined and copy_private_key

- name: Check password valid time for user
  ansible.builtin.command: awk 'BEGIN { FS = ":" } $1 == "user" { print $5 }' /etc/shadow
  become: true
  register: password_valid_time
  changed_when: false

- name: Set password valid time for user
  ansible.builtin.command: chage -M "{{ user.password_validity_days }}" user
  become: true
  when: password_validity_days is defined and password_valid_time.stdout != password_validity_days

- name: Place private key file for user
  ansible.builtin.copy:
    content: "{{ private_keys.content }}"
    dest: /home/user/.ssh/id_ed25519
    owner: user
    mode: 0400
  become: true
  when: private_keys is defined


