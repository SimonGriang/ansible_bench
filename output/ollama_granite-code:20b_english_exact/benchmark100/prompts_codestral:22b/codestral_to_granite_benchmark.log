        chdir: /etc/openvpn/easy-rsa
        creates: /etc/openvpn/easy-rsa/pki
      environment:
        EASYRSA_BATCH: "yes"

    - name: Build CA
      command: "{{ openvpn_easyrsa_path }} build-ca nopass"
      args:
        chdir: /etc/openvpn/easy-rsa
        creates: /etc/openvpn/easy-rsa/pki/ca.crt
      environment:
        EASYRSA_BATCH: "yes"

    - name: Generate Diffie-Hellman parameters
      command: "{{ openvpn_easyrsa_path }} gen-dh"
      args:
        chdir: /etc/openvpn/easy-rsa
        creates: /etc/openvpn/easy-rsa/pki/dh.pem

    - name: Build server certificates
      command: "{{ openvpn_easyrsa_path }} build-server-full server nopass"
      args:
        chdir: /etc/openvpn/easy-rsa
        creates: /etc/openvpn/easy-rsa/pki/issued/server.crt
      environment:
        EASYRSA_BATCH: "yes"

    - name: Build client certificates
      command: "{{ openvpn_easyrsa_path }} build-client-full client nopass"
      args:
        chdir: /etc/openvpn/easy-rsa
        creates: /etc/openvpn/easy-rsa/pki/issued/client.crt
      environment:
        EASYRSA_BATCH: "yes"

    - name: Generate Certificate Revocation List
      command: "{{ openvpn_easyrsa_path }} gen-crl"
      args:
        chdir: /etc/openvpn/easy-rsa
        creates: /etc/openvpn/easy-rsa/pki/crl.pem

    - name: Generate TLS Auth Key
      command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
      args:
        creates: /etc/openvpn/easy-rsa/pki/ta.key

    - name: Copy files to /etc/openvpn/server
      copy:
        src: "{{ item }}"
        dest: /etc/openvpn/server
        owner: root
        group: "{{ openvpn_group }}"
        mode: 0644
      loop:
        - /etc/openvpn/easy-rsa/pki/ca.crt
        - /etc/openvpn/easy-rsa/pki/dh.pem
        - /etc/openvpn/easy-rsa/pki/issued/server.crt
        - /etc/openvpn/easy-rsa/pki/private/server.key
        - /etc/openvpn/easy-rsa/pki/crl.pem

    - name: Copy files to /etc/openvpn
      copy:
        src: "{{ item }}"
        dest: /etc/openvpn
        owner: root
        group: "{{ openvpn_group }}"
        mode: 0644
      loop:
        - /etc/openvpn/easy-rsa/pki/ca.crt
        - /etc/openvpn/easy-rsa/pki/dh.pem
        - /etc/openvpn/easy-rsa/pki/issued/client.crt
        - /etc/openvpn/easy-rsa/pki/private/client.key

    - name: Place server.conf
      template:
        src: server.conf.j2
        dest: "{{ openvpn_configuration_directory }}/server.conf"
        owner: root
        group: "{{ openvpn_group }}"
        mode: 0640
      notify: Restart openvpn

    - name: Ensure openvpn is enabled and running
      service:
        name: "{{ openvpn_service_name }}"
        state: started
        enabled: true

- name: Restart openvpn
  service:
    name: "{{ openvpn_service_name }}"
    state: restarted


