---

- import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: "^#?SHELL="
    line: "SHELL={{ cron_shell }}"
    state: present
    create: true
    mode: 0600
    backup: true
  notify: Restart cron

- name: Configure path
  lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: "^#?PATH="
    line: "PATH={{ cron_path }}"
    state: present
    create: true
    mode: 0600
    backup: true
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    dest: "{{ cron_configuration }}"
    regexp: "^#?MAILTO="
    line: "MAILTO={{ cron_mailto }}"
    state: present
    create: true
    mode: 0600
    backup: true
  notify: Restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    special_time: "{{ item.special_time | default(omit) }}"
    state: "{{ item.state | default('present') }}"
    user: "{{ item.user | default(omit) }}"
  with_ cron_jobs
  when: cron_jobs is defined


