---
- name: Configure httpd virtual hosts
  hosts: localhost
  tasks:
    - name: Create directory for each virtual host
      file:
        path: "{{ httpd_vhosts_directory }}/{{ item.documentroot | dirname }}"
        state: directory
        mode: "0755"
      loop: "{{ httpd_vhosts }}"
      when:
        - httpd_vhosts is defined
        - item.documentroot is defined
        - item.create_docroot | default(true) | bool
      notify: Test httpd configuration and restart httpd

    - name: Configure vhosts
      template:
        src: "{{ vhost_conf_template }}"
        dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
        mode: "0644"
      loop: "{{ httpd_vhosts }}"
      notify: Test httpd configuration and restart httpd

  handlers:
    - name: Test httpd configuration and restart httpd
      command: httpd -t
      changed_when: false
      notify: Restart httpd

    - name: Restart httpd
      service:
        name: httpd
        state: restarted


