---
- name: Bootstrap Playbook
  tasks:
    - name: lookup bootstrap facts
      raw: uname -a
      register: bootstrap_facts
      changed_when: false
      check_mode: false
      become: false

    - name: set bootstrap facts (I)
      set_fact:
        bootstrap_distribution: "{{ bootstrap_facts['stdout'] | regex_search('^(?P<distribution>\\w+) .*(?P<version>\\d+\\.\\d+)') | regex_replace('^(.*)$', '\\g<distribution>') }}"
        bootstrap_distribution_version: "{{ bootstrap_facts['stdout'] | regex_search('^(?P<distribution>\\w+) .*(?P<version>\\d+\\.\\d+)') | regex_replace('^(.*)$', '\\g<version>') }}"
        bootstrap_os_family: "{{ bootstrap_facts['stdout'] | regex_search('^(?P<distribution>\\w+) .*(?P<version>\\d+\\.\\d+)') | regex_replace('^(.*)$', '\\g<distribution>') | regex_replace('(debian|ubuntu)', 'debian') }}"
      when: bootstrap_facts['rc'] == 0 and bootstrap_distribution is not defined and bootstrap_facts['stdout'] | regex_search('^(?P<distribution>\\w+) .*(?P<version>\\d+\\.\\d+)')
      become: "{{ bootstrap_become }}"
      become_user: "{{ bootstrap_become_user }}"

    - name: set bootstrap facts (II)
      set_fact:
        bootstrap_os_family: "{{ item.os_family }}"
      when: bootstrap_distribution == item.pattern
      with_items:
        - { pattern: 'Darwin', os_family: 'Darwin' }
        - { pattern: 'CentOS', os_family: 'RedHat' }
        - { pattern: 'Red Hat Enterprise Linux Server', os_family: 'RedHat' }
        - { pattern: 'Scientific Linux', os_family: 'RedHat' }
        - { pattern: 'Debian', os_family: 'Debian' }
        - { pattern: 'Fedora', os_family: 'RedHat' }
        - { pattern: 'Ubuntu', os_family: 'Debian' }


