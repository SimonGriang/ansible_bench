---
- name: Generate RKE2 cluster
  hosts: localhost
  tasks:
    - name: Create RKE2 config directory
      file:
        path: /etc/rancher/rke2
        owner: root
        group: root
        mode: 0755
        state: directory

    - name: Set server taints
      when: rke2_type == "server"
      command: "kubectl taint nodes --all {{ rke2_server_node_taints }}"

    - name: Set agent taints
      when: rke2_type == "agent"
      command: "kubectl taint nodes --all {{ rke2_agent_node_taints }}"

    - name: Copy RKE2 config
      template:
        src: "{{ rke2_config }}"
        dest: /etc/rancher/rke2/config.yaml
        owner: root
        group: root
        mode: 0644
      notify: Config file changed

    - name: Copy kubelet config
      template:
        src: templates/kubelet-config.yaml.j2
        dest: /etc/rancher/rke2/kubelet-config.yaml
        owner: root
        group: root
        mode: 0644
      notify: Config file changed
      when: rke2_kubelet_config != ""

    - name: Copy Containerd Registry Configuration file
      template:
        src: "{{ rke2_custom_registry_path }}"
        dest: /etc/rancher/rke2/registries.yaml
        owner: root
        group: root
        mode: 0644
      notify: Config file changed
      when: rke2_custom_registry_mirrors is defined or rke2_custom_registry_configs is defined

    - name: Start RKE2 service on the rest of the nodes
      systemd:
        name: "{{ rke2_service_name }}"
        state: started
        enabled: true
        env:
          RKE2_TOKEN: "{{ rke2_token }}"
      notify: Service (re)started

    - name: Mask other RKE2 service on the rest of the nodes
      systemd:
        name: "{{ 'agent' if rke2_type == 'server' else 'server' }}.service"
        enabled: false
        state: stopped
        masked: true

    - name: Wait for remaining nodes to be ready - no CNI
      shell: "kubectl get node {{ inventory_hostname }} -ojsonpath='{.status.conditions[?(@.type==\"Ready\")].status}' | grep -q 'True' || exit 1"
      register: node_ready
