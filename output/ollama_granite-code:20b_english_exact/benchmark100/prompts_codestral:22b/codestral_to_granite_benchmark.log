---

- name: Import assert.yml
  import_tasks: assert.yml
  tags:
    - always

- name: Ensure bash is installed
  package:
    name: bash
    state: present
  tags:
    - java
    - openjdk
    - oracle

- name: Install openjdk java (package)
  package:
    name: "{{ java_openjdk_package }}"
    state: present
    env:
      USE: "X -cups -alsa -fontconfig"
  when:
    - java_vendor == "openjdk"
    - java_source == "package"
  tags:
    - java
    - openjdk

- name: Install RPM
  copy:
    src: "{{ java_package }}"
    dest: "/tmp/{{ java_package |basename }}"
    mode: 0644
  when:
    - java_source == "local"
    - java_format == "rpm"
  tags:
    - java
    - oracle

- name: Install DEB
  copy:
    src: "{{ java_package }}"
    dest: "/tmp/{{ java_package |basename }}"
    mode: 0644
  when:
    - java_source == "local"
    - java_format == "deb"
  tags:
    - java
    - oracle

- name: Install oracle java (rpm) (repository)
  package:
    name: "{{ java_oracle_package }}"
    state: present
  when:
    - java_source == "repository"
    - java_format == "rpm"
  tags:
    - java
    - oracle

- name: Configure oracle targz
  file:
    path: "{{ java_install_directory }}"
    state: directory
    mode: 0755
  when:
    - java_format == "targz"
    - java_vendor == "oracle"
  tags:
    - java
    - oracle

- name: Install oracle java policy software (targz)
  unarchive:
    src: "jce_policy-{{ java_version }}.zip"
    dest: "{{ java_install_directory }}"
    copy: no
  when:
    - java_jce == true
    - java_version == "8"
    - java_vendor == "oracle"
  tags:
    - java
    - oracle

- name: Set alternative (targz)
  alternatives:
    name: java
    link: /usr/bin/java
    path: "{{ java_install_directory }}/bin/java"
  when:
    - java_format == "targz"
    - not ansible_local.system.alpine
    - java_vendor == "oracle"
  tags:
    - java
    - oracle

- name: Find JAVA_HOME
  shell: "readlink -f /usr/bin/java | sed 's:bin/java$::'"
  register: java_home_register
  changed_when: false
  tags:
    - java
    - openjdk
    - oracle

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    dest: /etc/profile.d/java_home.sh
    line: 'JAVA_HOME="{{ java_home_register.stdout }}"'
    create: yes
    mode: 0644
    owner: root
    group: root
    state: present
  tags:
    - java
    - openjdk
    - oracle


