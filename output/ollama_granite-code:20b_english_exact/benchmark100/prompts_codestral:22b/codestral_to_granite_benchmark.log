---

- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes

- name: Configure apk
  when: ansible_pkg_mgr == "apk"
  block:
    - name: Update cache
      apk:
        update_cache: yes
        upgrade: yes
      notify: Reboot

  handlers:
    - name: Reboot
      command: reboot

- name: Configure apt
  when: ansible_pkg_mgr == "apt"
  block:
    - name: Prevent upgrade for selected packages
      dpkg_selections:
        name: "{{ update_excluded_packages }}"
        selection: hold

    - name: Update cache
      apt:
        update_cache: yes
        cache_valid_time: "{{ update_cache_valid_time }}"
        upgrade: "{{ update_upgrade_command }}"
      notify: Reboot

    - name: Autoremove
      apt:
        autoremove: yes
      when: update_autoremove

  handlers:
    - name: Reboot
      command: reboot

- name: Update all software (dnf)
  when: ansible_pkg_mgr == "dnf" or ansible_pkg_mgr == "dnf5"
  block:
    - name: Update software
      dnf:
        name: "*"
        exclude: "{{ update_excluded_packages }}"
        update_only: yes
      notify: Reboot

  handlers:
    - name: Reboot
      command: reboot

- name: Update all software (pacman)
  when: ansible_pkg_mgr == "pacman"
  block:
    - name: Update cache
      pacman:
        update_cache: yes
        upgrade: yes
      notify: Reboot

  handlers:
    - name: Reboot
      command: reboot

- name: Configure yum
  when: ansible_pkg_mgr == "yum"
  block:
    - name: Update software
      yum:
        name: "*"
        exclude: "{{ update_excluded_packages }}"
        update_only: yes
      notify: Reboot

    - name: Install yum-utils
      yum:
        name: yum-utils
      when: ansible_distribution_major_version != "6"

  handlers:
    - name: Reboot
      command: reboot

- name: Update all software (zypper)
  when: ansible_pkg_mgr == "zypper"
  block:
    - name: Update software
      zypper:
        name: "*"
        update_only: yes
      notify: Reboot

  handlers:
    - name: Reboot
      command: reboot


