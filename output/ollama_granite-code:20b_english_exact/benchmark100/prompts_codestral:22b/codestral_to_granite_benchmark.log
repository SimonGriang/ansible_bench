---
- name: Install Vault
  hosts: all
  tasks:
    - name: Create Vault directories
      ansible.builtin.file:
        path: "{{ item.path }}"
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
        state: directory
      loop:
        - path: /etc/vault.d
          owner: root
          group: root
          mode: "0755"
        - path: /var/lib/vault
          owner: vault
          group: vault
          mode: "0750"
        - path: /var/log/vault
          owner: vault
          group: vault
          mode: "0750"

    - name: Download Vault binary
      ansible.builtin.unarchive:
        src: https://releases.hashicorp.com/vault/1.9.2/vault_1.9.2_linux_amd64.zip
        dest: /tmp
        remote_src: true
      become: true
      become_user: root

    - name: Copy Vault binary
      ansible.builtin.copy:
        src: /tmp/vault
        dest: /usr/bin/vault
        owner: root
        group: root
        mode: "0755"
      notify: Restart vault

    - name: Set capabilities on /usr/bin/vault
      community.general.capabilities:
        path: /usr/bin/vault
        capability: cap_ipc_lock=ep
        state: present
      become: true

    - name: Touch vault.env
      ansible.builtin.file:
        path: /etc/vault.d/vault.env
        owner: root
        group: root
        mode: "0644"
        state: touch
      notify: Restart vault

    - name: Copy Vault service file
      ansible.builtin.template:
        src: vault.service.j2
        dest: /usr/lib/systemd/system/vault.service
        owner: root
        group: root
        mode: "0644"
      notify: Daemon reload

    - name: Copy vault configuration
      ansible.builtin.copy:
        src: vault.hcl
        dest: /etc/vault.d/vault.hcl
        owner: root
        group: root
        mode: "0640"
      notify: Restart vault

    - name: Flush handlers
      ansible.builtin.meta: flush_handlers


