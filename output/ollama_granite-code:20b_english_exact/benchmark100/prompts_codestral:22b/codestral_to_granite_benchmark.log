---
- name: Upgrade node
  block:
  - name: Cordon and Drain the node
    command: "kubectl drain {{ inventory_hostname }} --ignore-daemonsets=true --delete-local-data=true --force --grace-period=-1"
    delegate_to: "{{ active_server }}"
    when: rke2_drain_node_during_upgrade
    register: drain_node_result
    until: drain_node_result is succeeded
    retries: 3
    delay: 10
    changed_when: false

  - name: Restart RKE2 service
    service:
      name: "{{ rke2_service_name }}"
      state: restarted
    when: rke2_drain_node_during_upgrade

  - name: Wait for all nodes to be ready again
    command: "kubectl wait --for=jsonpath='{.items[*].status.conditions[?(@.type==\"Ready\")].status}'=True --all node --timeout=600s"
    delegate_to: "{{ active_server }}"
    when: rke2_drain_node_during_upgrade
    register: wait_for_nodes_result
    until: wait_for_nodes_result is succeeded
    retries: 30
    delay: 10
    changed_when: false

  - name: Uncordon the node
    command: "kubectl uncordon {{ inventory_hostname }}"
    delegate_to: "{{ active_server }}"
    when: rke2_drain_node_during_upgrade
    register: uncordon_node_result
    until: uncordon_node_result is succeeded
    retries: 3
    delay: 10
    changed_when: false

  - name: Wait for all pods to be ready again
    command: "kubectl wait --for=condition=Ready --all pod --timeout=600s"
    delegate_to: "{{ active_server }}"
    when: rke2_wait_for_all_pods_to_be_ready
    register: wait_for_pods_result
    until: wait_for_pods_result is succeeded
    retries: 30
    delay: 10
    changed_when: false

  - name: Wait for all pods to pass readiness checks
    command: "kubectl wait {{ rke2_wait_for_all_pods_to_be_healthy_args }}"
    delegate_to: "{{ active_server }}"
    when: rke2_wait_for_all_pods_to_be_healthy
    register: wait_for_pods_health_result
    until: wait_for_pods_health_result is succeeded
    retries: 30
    delay: 10
    changed_when: false



