---
- name: Playbook for configuring httpd
  hosts: all
  tasks:
    - name: Create directories
      file:
        path: "{{ item }}"
        state: directory
        mode: "0755"
      loop: "{{ httpd_directories }}"
      loop_control:
        label: "Create directory {{ item }}"

    - name: Configure directories
      template:
        src: directory.conf.j2
        dest: "{{ httpd_config_directory }}"
        mode: "0644"
      notify: Restart httpd
      loop: "{{ httpd_directories }}"
      loop_control:
        label: "Configure directory {{ item }}"

  handlers:
    - name: Restart httpd
      service:
        name: httpd
        state: restarted


