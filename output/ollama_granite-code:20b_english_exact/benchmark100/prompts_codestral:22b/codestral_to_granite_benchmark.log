---
- name: Assert usage of systemd as an init system
  assert:
    that: ansible_service_mgr == "systemd"
    msg: "This module only works with systemd"

- name: Get the latest release version of Promtail from GitHub
  uri:
    url: https://api.github.com/repos/grafana/promtail/releases
    return_content: yes
    force_basic_auth: yes
    url_username: "{{ lookup('env','GH_USER') }}"
    url_password: "{{ lookup('env','GH_TOKEN') }}"
  register: github_release
  run_once: true
  delegate_to: localhost
  when: promtail_version == "latest"

- name: Check if the local Promtail binary archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/promtail"
  register: promtail_local_binary
  delegate_to: localhost
  run_once: true
  when: promtail_binary_local_dir is defined

- name: Get the checksum for the Promtail binary
  uri:
    url: "https://github.com/grafana/promtail/releases/download/v{{ promtail_version }}/SHA256SUMS"
    return_content: yes
    force_basic_auth: yes
    url_username: "{{ lookup('env','GH_USER') }}"
    url_password: "{{ lookup('env','GH_TOKEN') }}"
  register: promtail_checksum
  run_once: true
  delegate_to: localhost
  when: promtail_binary_local_dir is not defined




