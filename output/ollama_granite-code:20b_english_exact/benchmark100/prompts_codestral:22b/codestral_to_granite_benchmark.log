---

- name: logrotate
  hosts: all
  vars:
    logrotate_packages:
      - logrotate
    logrotate_service: logrotate
    logrotate_service_state: started
    logrotate_service_enabled: yes
    logrotate_config_directory: /etc
    logrotate_config_file: logrotate.conf
    logrotate_confd_directory: /etc/logrotate.d
    logrotate_entries:
      - name: someapp
        logs:
          - "/var/log/someapp/*.log"
        options:
          - missingok
          - rotate 5
          - compress
          - delaycompress
          - notifempty
  tasks:
    - import_tasks: tasks/assert.yml
    - name: install logrotate
      package:
        name: "{{ logrotate_packages }}"
        state: present
    - name: configure logrotate
      template:
        src: tasks/logrotate_config_file.j2
        dest: "{{ logrotate_config_directory }}/{{ logrotate_config_file }}"
        mode: 0644
    - name: generate logrotate.d files
      template:
        src: tasks/entry.j2
        dest: "{{ logrotate_confd_directory }}/{{ item.name }}"
        mode: 0644
      loop: "{{ logrotate_entries }}"
      when:
        - logrotate_entries is defined
        - item.state is not defined or item.state != 'absent'
    - name: remove logrotate.d files
      file:
        path: "{{ logrotate_confd_directory }}/{{ item.name }}"
        state: absent
      loop: "{{ logrotate_entries }}"
      when:
        - logrotate_entries is defined
        - item.state is defined
        - item.state == 'absent'
    - name: start logrotate
      service:
        name: "{{ logrotate_service }}"
        state: "{{ logrotate_service_state }}"
        enabled: "{{ logrotate_service_enabled }}"
      when: logrotate_service != ""


