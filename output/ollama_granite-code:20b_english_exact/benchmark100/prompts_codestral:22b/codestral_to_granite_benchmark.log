---
- name: Import assertions
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  ansible.posix.seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    persistent: true
  loop: "{{ httpd_sebooleans }}"
  when: ansible_selinux.status == "enabled"

- name: Configure selinux (custom ports)
  community.general.seport:
    ports: "{{ item }}"
    state: present
  loop:
    - "{{ httpd_port }}"
    - "{{ httpd_ssl_port }}"
  when:
    - ansible_selinux.status == "enabled"
    - httpd_ssl_port is defined

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "0644"
  notify: Test and restart httpd

- name: Activate httpd module | Debian
  ansible.builtin.command: "httpd -M {{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  notify: Test and restart httpd
  when: ansible_os_family == "Debian"

- name: Import ssl configuration
  ansible.builtin.import_tasks: ssl.yml
  when: httpd_ssl

- name: Import locations
  ansible.builtin.import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual hosts
  ansible.builtin.import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_server_root }}"
    mode: "0644"
  notify: Test and restart httpd
  when:
    - ansible_os_family == "Debian" or ansible_os_family == "Suse"

- name: Import directories
  ansible.builtin.import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Remove default HTML
  ansible.builtin.file:
    path: "{{ httpd_data_directory }}"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


