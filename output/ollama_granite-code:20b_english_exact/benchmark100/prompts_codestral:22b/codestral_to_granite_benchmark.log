---

- name: Assert Variables
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for Host
  wait_for_connection:
    connect_timeout: "{{ bootstrap_timeout }}"
    sleep: 5
    timeout: "{{ bootstrap_timeout }}"
    port: "{{ bootstrap_host_port | default(22) }}"
  delegate_to: localhost
  when:
    - not connection | default('docker') | contains('container')
    - bootstrap_wait_for_host | default(true)

- block:
    - name: Test connection
      ping:

    - name: Gather bootstrap facts
      setup:

    - name: Install bootstrap packages
      raw: "{{ bootstrap_package_command }}"
      register: bootstrap_package_result
      changed_when: "'changed' in bootstrap_package_result.stdout"
      until: bootstrap_package_result is succeeded
      retries: "{{ bootstrap_package_retries }}"
      delay: "{{ bootstrap_package_delay }}"
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user }}"
  environment: "{{ bootstrap_environment }}"

- block:
    - name: Gather Ansible facts
      setup:

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_package_list }}"
        state: present
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user }}"
  environment: "{{ bootstrap_environment }}"


