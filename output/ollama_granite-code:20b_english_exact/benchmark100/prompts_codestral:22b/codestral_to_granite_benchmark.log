---

- import_tasks: assert.yml

- name: Install dns
  package:
    name:dns
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: named
    group: named
    mode: 0755
  with_items:
  - /var/lib/named
  - /etc/named.conf.d
  - /var/lib/named/data
  - /var/lib/named/data/named.cache
  - /var/lib/named/data/named.run
  - /var/lib/named/data/named.conf

- name: Create group
  group:
    name: named
    state: present

- name: Create user
  user:
    name: named
    group: named
    system: yes
    state: present

- name: Generate rndc key
  command: rndc-confgen -a -b 512 -c /var/lib/named/data/ rndc.key
  args:
    creates: /var/lib/named/data/rndc.key

- name: Set permissions on rndc key file
  file:
    path: /var/lib/named/data/rndc.key
    owner: named
    group: named
    mode: 0640

- name: Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.cache
    dest: /var/lib/named/data/hints.root
    mode: 0644
    owner: named
    group: named
  when: caching_dns

- name: Create zone file
  template:
    src: zone.j2
    dest: "/var/lib/named/data/{{ item.name }}.zone"
    owner: named
    group: named
    mode: 0644
  with_items: "{{ dns_zones }}"
  when: item.type == "primary"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named.conf.d/zones.conf
    owner: root
    group: root
    mode: 0644

- name: Place systemd override
  copy:
    src: named.conf
    dest: /etc/systemd/system/named.service.d/override.conf
    owner: root
    group: root
    mode: 0644
  when: ansible_service_mgr == "systemd"

- name: Start and enable dns
  service:
    name: dns
    state: started
    enabled: yes


