---
- name: Task 1 - Import assert.yml
  include_tasks: assert.yml

- name: Task 2 - Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: enabled
  when: ansible_distribution == "Red Hat Enterprise Linux" and ansible_distribution_major_version == "8"

- name: Task 3 - Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Task 4 - Configure redis
  template:
    src: redis.conf.j2
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart redis

- name: Task 5 - Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true



