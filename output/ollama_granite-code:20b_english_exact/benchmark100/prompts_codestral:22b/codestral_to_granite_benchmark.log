    creates: "{{ mysql_pid_file }}"
  when: ansible_os_family in ["Alpine", "Archlinux"]

- name: Task 6 - Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Task 7 - Flush handlers
  meta: flush_handlers

- name: Task 8 - Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/my.cnf
    mode: 0640

- name: Task 9 - Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    encoding: "{{ item.encoding | default(omit) }}"
    collate: "{{ item.collate | default(omit) }}"
  with_items: "{{ mysql_databases }}"
  no_log: true
  when: mysql_databases is defined

- name: Task 10 - Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    host: "{{ item.host | default(omit) }}"
    state: present
    priv: "{{ item.priv | default(omit) }}"
  with_items: "{{ mysql_users }}"
  no_log: true
  when: mysql_users is defined

- name: Task 11 - Flush handlers again
  meta: flush_handlers


