- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Install docker-compose package
  package:
    name: "{{ docker_compose_package_name }}"
    state: present
  when: docker_compose_installation_type == "package"

- name: Task 3 - Install docker-compose as a binary
  block:
    - name: Install required packages
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ docker_compose_binary_required_packages }}"

    - name: Download docker-compose binary
      get_url:
        url: "{{ docker_compose_url }}"
        dest: /usr/local/bin/docker-compose
        mode: "0755"
  when: docker_compose_installation_type == "binary"


