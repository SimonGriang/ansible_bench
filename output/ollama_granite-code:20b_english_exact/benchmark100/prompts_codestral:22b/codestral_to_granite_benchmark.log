---
- name: Task 1 - Download RKE2 kubeconfig to localhost
  become: false
  run_once: "{{ rke2_download_kubeconf }}"
  delegate_to: localhost
  when: rke2_download_kubeconf and rke2_server_is_first
  fetch:
    src: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    flat: true
    mode: '0600'

- name: Task 2 - Replace loopback IP by master server IP
  become: false
  run_once: "{{ rke2_download_kubeconf }}"
  delegate_to: localhost
  when: rke2_download_kubeconf and rke2_server_is_first
  replace:
    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    regexp: '127.0.0.1|([0:]+:){7}[0:]'
    replace: "{{ rke2_api_ip | default(ansible_host) }}"
    backup: yes
    mode: '0600'


