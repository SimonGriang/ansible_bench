      jdk_major_version: "{{ java_variables.jdk_major_version | default(omit) }}"

  - name: Set OS and architecture-specific variables for Java (II)
    set_fact:
      java_home: "{{ java_open_jdk_home }}"

  - name: Handle Debian pre-requisites for Java
    block:
    - name: Remove deprecated repositories (Debian)
      apt_repository:
        repo: "deb http://security.debian.org/debian-security {{ ansible_distribution_release }}/updates main"
        state: absent
      when: ansible_distribution == "Debian"
    - name: Install extra apt tools
      apt:
        name: "{{ packages }}"
        state: present
        update_cache: true
      vars:
        packages:
        - apt-transport-https
        - ca-certificates
        - curl
        - gnupg
        - software-properties-common
    - name: Add required key repositories (Debian)
      apt_key:
        url: "{{ item }}"
        state: present
      loop:
      - https://apt.releases.hashicorp.com/gpg
      - https://apt.kubernetes.io/gpg
    - name: Add required repositories (Debian)
      apt_repository:
        repo: "{{ item }}"
        state: present
      loop:
      - deb https://apt.releases.hashicorp.com/debian {{ ansible_distribution_release }} main
      - deb https://apt.kubernetes.io/ kubernetes-xenial main
    when: ansible_os_family == 'Debian'

  - name: Handle RedHat pre-requisites for Java
    block:
    - name: Add required key repositories (RedHat)
      rpm_key:
        key: "{{ item }}"
        state: present
      loop:
      - https://rpm.releases.hashicorp.com/gpg
      - https://packages.cloud.google.com/yum/doc/apt-key.gpg
    - name: Add required repositories (RedHat)
      get_url:
        url: "{{ item }}"
        dest: /etc/yum.repos.d/
      loop:
      - https://rpm.releases.hashicorp.com/rpm/free/RPM-GPG-KEY-hashiCorp
      - https://rpm.releases.hashicorp.com/rpm/steroids/RPM-GPG-KEY-hashiCorp
      - https://packages.cloud.google.com/yum/doc/rpm-package-key.gpg
    when: ansible_os_family == 'RedHat'

  - name: Install required libraries for Java
    package:
      name: "{{ packages }}"
      state: present
    vars:
      packages: "{{ java_variables.required_libs }}"

  - name: Install Java on Debian
    apt:
      name: "{{ java_package }}"
      state: present
    when: ansible_os_family == 'Debian'

  - name: Install Java on RedHat
    yum:
      name: "{{ java_package }}"
      state: present
    when: ansible_os_family == 'RedHat'

  - name: Export environment variables for Java
    template:
      src: jdk.sh.j2
      dest: /etc/profile.d/jdk.sh
      mode: 0644
    become: true

  - name: Source environment variables for Java
    shell: source /etc/profile.d/jdk.sh

  - name: Correct Java version selected for Java < 11
    alternatives:
      name: java
      link: /usr/bin/java
      path: "{{ java_open_jdk_home }}/bin/java"
    when: java_major_version < 11

  - name: Correct Java version selected for Java >= 11
    alternatives:
      name: java
      link: /usr/bin/java
      path: "{{ java_open_jdk_home }}/bin/java"
    when: java_major_version >= 11
