---
- hosts: localhost
  tasks:
    - import_tasks: assert.yml
    - name: Task 2 - Install mysql
      package:
        name: "{{ mysql_packages }}"
        state: present
      notify:
        - mysql_restart_daemon
    - name: Task 3 - Configure mysql server
     ini_file:
        dest: /etc/mysql/mysql.conf.d/mysql-server.cnf
        section: "{{ item.section }}"
        option: "{{ item.option }}"
        value: "{{ item.value }}"
        mode: 0644
        no_extra_spaces: yes
      loop: "{{ mysql_configuration_options }}"
      notify:
        - mysql_restart_daemon
    - name: Task 4 - Configure mysql client
      ini_file:
        dest: /etc/mysql/mysql.conf.d/mysql-client.cnf
        section: client
        option: socket
        value: "{{ mysql_socket }}"
        mode: 0644
        no_extra_spaces: yes
    - name: Task 5 - Initialize mysql
      shell: "{{ mysql_initialize_command }}"
      when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"
    - name: Task 6 - Start and enable mysql
      service:
        name: mysql
        state: started
        enabled: yes
    - name: Task 7 - Flush handlers
      meta: flush_handlers
    - name: Task 8 - Place my.cnf
      template:
        src: /root/my.cnf.j2
        dest: /root/.my.cnf
        mode: 0600
    - name: Task 9 - Create databases
      mysql_db:
        name: "{{ item.name }}"
        state: present
        encoding: "{{ item.encoding | default(omit) }}"
        collation: "{{ item.collation | default(omit) }}"
        login_user: root
        login_password: "{{ mysql_root_password }}"
      loop: "{{ mysql_databases }}"
      when: mysql_databases is defined and item.initial_import is not defined
    - name: Task 10 - List databases
      mysql_db:
        name: "{{ item.name }}"
        state: present
        encoding: "{{ item.encoding | default(omit) }}"
        collation: "{{ item.collation | default(omit) }}"
        login_user: root
        login_password: "{{ mysql_root_password }}"
      loop: "{{ mysql_databases }}"
      when: mysql_databases is defined and item.initial_import is defined
    - name: Task 11 - Import database
      mysql_db:
        name: "{{ item.name }}"
        state: import
        target: "{{ item.initial_import }}"
        login_user: root
        login_password: "{{ mysql_root_password }}"
      loop: "{{ mysql_databases }}"
      when: mysql_databases is defined and item.initial_import is defined
    - name: Task 12 - Create users
      mysql_user:
        name: "{{ item.name }}"
        password: "{{ item.password }}"
        host: "{{ item.host }}"
        state: present
        login_user: root
        login_password: "{{ mysql_root_password }}"
      loop: "{{ mysql_users }}"
      when: mysql_users is defined
    - name: Task 13 - Flush handlers again
      meta: flush_handlers


