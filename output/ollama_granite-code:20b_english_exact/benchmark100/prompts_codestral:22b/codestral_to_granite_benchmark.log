---
- name: Task 1
  hosts: all
  tasks:
    - name: Enable modules
      become: true
      when: ansible_os_family == "Debian" or ansible_os_family == "Suse"
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
      with_items:
        - libapache2-mod-proxy
        - libapache2-mod-proxy-http
      notify:
        - Test httpd configuration validity
        - Restart httpd
  handlers:
    - name: Test httpd configuration validity
      become: true
      ansible.builtin.command: httpd -t
    - name: Restart httpd
      become: true
      ansible.builtin.service:
        name: httpd
        state: restarted
- name: Task 2
  hosts: all
  tasks:
    - name: Configure locations
      become: true
      ansible.builtin.template:
        src: location.conf.j2
        dest: "{{ httpd_config_directory }}/{{ item.url | urlsplit('path') | basename }}"
        mode: 0644
      with_items: "{{ httpd_locations }}"
      notify:
        - Test httpd configuration validity
        - Restart httpd


