        msg: "RKE2 binary {{ rke2_bin_path }} is not executable"
      when: not rke2_binary_stats.stat.executable
    when: installed_version is not defined or desired_version is not defined or installed_version != desired_version
  always:
  - name: Clean up RKE2 install script
    file:
      path: "{{ rke2_install_dest }}"
      state: absent



