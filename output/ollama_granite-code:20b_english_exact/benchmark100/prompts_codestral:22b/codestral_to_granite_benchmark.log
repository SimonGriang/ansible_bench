---
- name: Create SSL key
  openssl_privatekey:
    path: "{{ ssl_key_path }}"
    owner: "{{ ssl_file_owner }}"
    group: "{{ ssl_file_group }}"
    mode: 0600

- name: Create SSL CSR
  openssl_csr:
    path: "{{ ssl_csr_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    common_name: "{{ ssl_common_name }}"
    owner: "{{ ssl_file_owner }}"
    group: "{{ ssl_file_group }}"
    mode: 0640

- name: Create SSL certificates
  openssl_certificate:
    path: "{{ ssl_cert_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    csr_path: "{{ ssl_csr_path }}"
    ownca_path: "{{ ssl_ca_cert_path }}"
    ownca_privatekey_path: "{{ ssl_ca_key_path }}"
    provider: ownca
    owner: "{{ ssl_file_owner }}"
    group: "{{ ssl_file_group }}"
    mode: 0640

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ ssl_pkcs12_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    certificate_path: "{{ ssl_cert_path }}"
    owner: "{{ ssl_file_owner }}"
    group: "{{ ssl_file_group }}"
    mode: 0600

- name: Read private key
  slurp:
    src: "{{ ssl_key_path }}"
  register: private_key_data

- name: Read certificate
  slurp:
    src: "{{ ssl_cert_path }}"
  register: certificate_data

- name: Create combined private_key and certificate file
  copy:
    content: "{{ private_key_data['content'] }}{{ certificate_data['content'] }}"
    dest: "{{ ssl_combined_path }}"
    owner: "{{ ssl_file_owner }}"
    group: "{{ ssl_file_group }}"
    mode: 0600


