    - when: ansible_os_family == "RedHat" and ansible_distribution == "Rocky"
      block:
        - name: RedHat | Rocky | Set up HashiCorp repository
          shell: |
            dnf config-manager --add-repo https://rpm.releases.hashicorp.com/{{ hashicorp_product }}
    - when: ansible_os_family == "RedHat"
      block:
        - name: RedHat | Set up HashiCorp repository
          shell: |
            yum install -y yum-utils
            yum-config-manager --add-repo https://rpm.releases.hashicorp.com/{{ hashicorp_product }}
    - when: ansible_os_family == "Debian"
      block:
        - name: Debian | Set up HashiCorp repository
          shell: |
            apt-get update && apt-get install -y apt-transport-https ca-certificates curl software-properties-common
            curl -fsSL https://apt.releases.hashicorp.com/gpg | apt-key add -
            apt-add-repository "deb https://apt.releases.hashicorp.com/{{ hashicorp_product }} $(lsb_release -cs) main"
    - name: Install HashiCorp package
      package:
        name: "{{ hashicorp_product }}"
        state: present
    - name: Start HashiCorp service
      service:
        name: "{{ hashicorp_product }}"
        state: started
  run_once: yes

- when: hashicorp_installation_method == "manual"
  block:
    - name: Unarchive HashiCorp package
      unarchive:
        src: "{{ hashicorp_package_url }}"
        dest: /usr/bin/
        remote_src: yes
        mode: "0755"
        owner: root
        group: root
  run_once: yes


