- name: Disable core dumps
  tags: [vault, security]
  pam_limits:
    limits: '{{ item }}'
    domain: '{{ item.domain | default(omit) }}'
    limit_type: '{{ item.limit_type | default(omit) }}'
  loop:
    - { limit: core, value: '0', filename: core }
    - { limit: data, value: '0', filename: core }
  when: vault_hardening_disable_core_dumps|bool

- name: Disable Shell Command History
  tags: [vault, security]
  copy:
    dest: /etc/profile.d/vault-histignore.sh
    content: |
      export HISTIGNORE="ls:cd:cd ..:cd -:history"
    mode: 0644
  when: vault_hardening_disable_shell_command_history|bool

- name: Configure SELinux / AppArmor
  tags: [vault, security]
  block:
    - name: Check if SELinux is enabled
      command: getenforce
      register: selinux_status
      changed_when: false

    - name: Install selinux-policy package
      package:
        name: selinux-policy
        state: present
      when: '"Enforcing" in selinux_status.stdout'

    - name: Set SELinux policy to targeted and enforcing
      command: setenforce 1
      when: '"Enforcing" in selinux_status.stdout'

    - name: Check if AppArmor is enabled
      command: apparmor_status
      register: apparmor_status
      changed_when: false

    - name: Enable AppArmor profile for vault binary
      command: aa-enable /usr/bin/vault
      when: '"enabled" in apparmor_status.stdout'
  when: vault_hardening_configure_selinux_apparmor|bool


