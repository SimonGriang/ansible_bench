---
- name: Install epel
  package:
    name: epel-release
    state: present
  when:
    - ansible_distribution == "Amazon"
    - ansible_distribution_major_version in [ "7", "8", "9", "10" ]
  notify: Update package cache

- name: Install epel gpg key
  rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install epel-release
  get_url:
    url: "{{ epel_url }}"
    dest: /etc/yum.repos.d/epel.repo
  notify: Update package cache

- name: Install epel-next-release
  get_url:
    url: "{{ epel_next_url }}"
    dest: /etc/yum.repos.d/epel-next.repo
  when: epel_next
  notify: Update package cache


