---
- import_tasks: assert.yml

- name: Pre-configure Debian systems
  when: ansible_os_family == 'Debian'
  block:
    - name: Configure debconf for Postfix
      debconf:
        name: postfix
        question: postfix/main_mailer_type
        value: 'No configuration'
        vtype: string

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when:
    - postfix_mysql_server is defined
    - postfix_mysql_user is defined
    - postfix_mysql_password is defined
    - postfix_mysql_database is defined
    - postfix_mysql_map_table is defined
    - postfix_mysql_destinations_table is defined
    - postfix_mysql_virtual_domains_table is defined
    - postfix_mysql_virtual_users_table is defined
    - postfix_mysql_virtual_aliases_table is defined
    - postfix_mysql_transport_maps_table is defined
    - postfix_mysql_header_checks_table is defined
    - (postfix_mysql_server | length > 0) and (postfix_mysql_user | length > 0) and (postfix_mysql_password | length > 0) and (postfix_mysql_database | length > 0)

- name: Configure postfix (transport_maps)
  template:
    src: "{{ postfix_transport_maps_template }}"
    dest: "{{ postfix_transport_maps_file }}"
    mode: "{{ postfix_transport_maps_file_mode }}"
    owner: "{{ postfix_root_group }}"
    group: "{{ postfix_root_group }}"
  register: postfix_transport_maps
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: "{{ postfix_header_checks_template }}"
    dest: "{{ postfix_header_checks_file }}"
    mode: "{{ postfix_header_checks_file_mode }}"
    owner: "{{ postfix_root_group }}"
    group: "{{ postfix_root_group }}"
  register: postfix_header_checks
  when: postfix_header_checks_template is defined


