---
- name: Create directories
  file:
    path: "{{ app_dir }}/cadvisor"
    owner: "{{ app_user }}"
    group: "{{ app_user }}"
    mode: 0755
    state: directory

- name: Download cadvisor binary
  get_url:
    url: https://github.com/google/cadvisor/releases/download/v0.41.0/cadvisor
    dest: "{{ app_dir }}/cadvisor/cadvisor"
    owner: "{{ app_user }}"
    group: "{{ app_user }}"
    mode: 0755
    checksum: "sha256:{{ cadvisor_sha256sum }}"
  when: cadvisor_binary_local is not defined

- name: Propagate locally distributed cadvisor binary
  copy:
    src: "{{ cadvisor_binary_local }}"
    dest: "{{ app_dir }}/cadvisor/cadvisor"
    owner: "{{ app_user }}"
    group: "{{ app_user }}"
    mode: 0755
  when: cadvisor_binary_local is defined

- name: Create symlink
  file:
    src: "{{ app_dir }}/cadvisor/cadvisor"
    dest: "{{ bin_dir }}/cadvisor"
    owner: "{{ app_user }}"
    group: "{{ app_user }}"
    state: link

- name: Configure cadvisor systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    owner: root
    group: root
    mode: 0644
  notify: Restart cadvisor

- name: Check cadvisor service status
  shell: "systemctl status cadvisor"
  register: service_status

- name: Enable cadvisor systemd service
  systemd:
    name: cadvisor
    enabled: true

- name: Start cadvisor systemd service
  systemd:
    name: cadvisor
    state: started
    daemon_reload: true


