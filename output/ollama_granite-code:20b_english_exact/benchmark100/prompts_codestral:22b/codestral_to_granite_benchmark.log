---

- name: Configure git users
  hosts: all
  tasks:
    - import_tasks: assert.yml

    - name: Install git
      package:
        name: "{{ git_packages }}"
        state: present
      become: yes
      register: git_ installation

    - name: Check if user exists
      getent:
        database: passwd
        key: "{{ git_username }}"
      become: no
      register: user_exists

    - name: Create user's home directory
      file:
        path: "/home/{{ git_username }}"
        owner: "{{ git_username }}"
        group: "{{ git_username }}"
        mode: 0755
        state: directory
      when: user_exists.getent.{{ git_username }} is defined
      become: yes

    - name: Configure git
      template:
        src: gitconfig.j2
        dest: "/home/{{ git_username }}/.gitconfig"
        owner: "{{ git_username }}"
        group: "{{ git_username }}"
      when:
        - user_exists.getent.{{ git_username }} is defined
        - git_user_email is defined
        - git_user_name is defined
        - git_config_template is defined
      become: yes

    - name: Create repository destination
      file:
        path: "{{ git_repository_destination }}"
        owner: "{{ git_username }}"
        group: "{{ git_username }}"
        mode: 0755
        state: directory
      when:
        - user_exists.getent.{{ git_username }} is defined
        - git_repository_destination is defined
      become: yes

    - name: Clone repositories
      git:
        repo: "{{ item }}"
        dest: "{{ git_repository_destination }}"
        version: "{{ git_repository_version | default(omit) }}"
        force: "{{ git_repository_force | default(omit) }}"
        recursive: "{{ git_repository_recursive | default(omit) }}"
      loop: "{{ git_repositories }}"
      become: yes
      become_user: "{{ git_username }}"
      when:
        - user_exists.getent.{{ git_username }} is defined
        - git_repository_destination is defined
        - git_repositories is defined
      ignore_errors: yes


