- name: Task 3
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: "^SHELL"
    line: "SHELL={{ cron_shell }}"
    state: present
    create: true
    mode: "0600"
  notify: Restart cron

- name: Task 4
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: "^PATH"
    line: "PATH={{ cron_path }}"
    state: present
    create: true
