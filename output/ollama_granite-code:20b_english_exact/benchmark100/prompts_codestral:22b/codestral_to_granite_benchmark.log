ipt {{ rke2_install_dest }} does not exist"\n      when: not rke2_binary.stat.exists\n    when: rke2_airgap_enabled and rke2_airgap_impl == "exists"\n  - name: Set RKE2 bin path\n    block:\n    - name: Populate service facts\n      service_facts:\n    - name: Get stats of filesystem object\n      stat:\n        path: /run\n      register: mount_run\n    - name: Check if separate partition\n      set_fact:\n        rke2_bin_path: /opt/rke2/rke2\n        separate_partition: "{{ mount_run.stat.fstype == \'overlay\' }}"\n      when: \'"rke2" in services\'\n    - name: Set RKE2 bin path\n      set_fact:\n        rke2_bin_path: /var/lib/rke2/bin\n      when: rke2_bin_path is not defined\n  - name: Check RKE2 version\n    block:\n    - name: Check if binary exists\n      stat:\n        path: "{{ rke2_bin_path }}"\n      register: rke2_binary\n    - name: Set installed version\n      set_fact:\n        installed_version: not installed\n      when: not rke2_binary.stat.exists\n    - name: Get running version\n      shell: "{{ rke2_bin_path }} --version"\n      register: rke2_version\n      failed_when: false\n      changed_when: false\n      when: installed_version is not defined\n    - name: Set running version\n      set_fact:\n        running_version: "{{ rke2_version.stdout }}"\n      when: rke2_version is defined\n    - name: Set running version\n      set_fact:\n        running_version: "{{ desired_version }}"\n      when: desired_version is defined and desired_version == running_version\n    - name: Prevent accidental RKE2 downgrade\n      fail:\n        msg: >\n          Desired version {{ desired_version }} must not be less than running\n          version {{ running_version }}.\n      failed_when: desired_version is version_compare(running_version, "<") and not rke2_allow_downgrade\n    - name: Prevent accidental RKE2 downgrade\n      debug:\n        msg: >\n          Desired version {{ desired_version }} must not be less than running\n          version {{ running_