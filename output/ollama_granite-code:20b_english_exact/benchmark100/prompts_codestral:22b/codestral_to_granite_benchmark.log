---

- import_tasks: assert.yml

- name: Install requirements
  package:
    name: "{{ sysctl_requirements }}"
    state: present

- name: Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: "{{ 'present' if sysctl_set | bool else 'absent' }}"
    reload: "{{ sysctl_reload | bool }}"
  loop: "{{ sysctl_items }}"
  when: >
    item.name is defined
    and item.value is defined
