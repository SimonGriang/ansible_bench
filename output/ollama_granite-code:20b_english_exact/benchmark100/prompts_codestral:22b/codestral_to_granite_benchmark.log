---
- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: "{{ helm_bin_path }} version --client"
  ignore_errors: yes
  changed_when: no
  register: helm_existing_version

- name: Download helm
  unarchive:
    src: "{{ helm_repo_path }}/helm/v{{ helm_version }}/{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: /tmp
    mode: 0644
    remote_src: yes
  when: helm_check.stat.exists == False or helm_existing_version.stdout.find("v{{ helm_version }}") == -1
  register: helm_download

- name: Copy helm binary into place
  copy:
    src: /tmp/{{ helm_platform }}-{{ helm_arch }}/helm
    dest: "{{ helm_bin_path }}"
    mode: 0755
  when: helm_download.changed == True


