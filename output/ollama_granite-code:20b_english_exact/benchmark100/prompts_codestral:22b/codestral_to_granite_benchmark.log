---
- name: Check if Java certificates exist
  stat:
    path: "{{ item.path }}"
  loop: "{{ java_certs }}"
  register: java_certs_stat

- name: Fail if Java certificate doesn't exist
  fail:
    msg: "Java certificate {{ item.item.path }} doesn't exist"
  loop: "{{ java_certs_stat.results }}"
  when: item.stat.exists == False

- name: Set keystore variables for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old | default('/etc/ssl/certs') }}"
  when: java_version.major < 11

- name: Set keystore variables for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new | default('/etc/ssl/certs') }}"
  when: java_version.major >= 11

- name: Import SSL certificates
  java_cert:
    cert_path: "{{ item.path }}"
    name: "{{ item.alias | default(omit) }}"
    keystore_path: "{{ java_keystore_dir }}/java/cacerts"
    keystore_password: "{{ java_keystore_password }}"
    state: present
  loop: "{{ java_certs }}"


