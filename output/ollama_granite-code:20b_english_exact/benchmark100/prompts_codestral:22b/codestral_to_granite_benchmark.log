---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /path/to/python3.11/EXTERNALLY-MANAGED
  register: python3_11_managed_file

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  command: mv /path/to/python3.11/EXTERNALLY-MANAGED /path/to/python3.11/EXTERNALLY-MANAGED.old
  when: python3_11_managed_file.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /path/to/python3.12/EXTERNALLY-MANAGED
  register: python3_12_managed_file

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  command: mv /path/to/python3.12/EXTERNALLY-MANAGED /path/to/python3.12/EXTERNALLY-MANAGED.old
  when: python3_12_managed_file.stat.exists

- import_tasks: assert.yml

- name: Install python pip
  command: "{{ python_pip_executable }} install {{ python_pip_packages | join(' ') }}"

- name: Configure pip proxy
  command: "{{ python_pip_executable }} config set global.proxy {{ python_pip_proxy }}"
  when: python_pip_proxy is defined

- name: Trust hosts
  command: "{{ python_pip_executable }} config set global.trusted-host {{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined

- name: Update pip
  command: "{{ python_pip_executable }} install --upgrade pip"
  when: python_pip_update and not (ansible_os_family == "Debian" and ansible_distribution == "bookworm") and not (ansible_os_family == "Debian" and ansible_distribution == "noble") and not ansible_os_family == "Alpine"

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version }}"
    executable: "{{ python_pip_executable }}"
  with_items: "{{ python_pip_modules }}"
  when: not (ansible_os_family == "Debian" and ansible_distribution == "bookworm") and not (ansible_os_family == "Debian" and ansible_distribution == "noble") and not ansible_os_family == "Alpine"


