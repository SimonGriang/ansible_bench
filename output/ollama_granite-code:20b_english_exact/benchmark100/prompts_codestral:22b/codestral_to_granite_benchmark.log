content='---\n\n- import_tasks: assert.yml\n\n- name: Install dns\n  package:\n    name:dns\n    state: present\n\n- name: Create directories\n  file:\n    path: "{{ item }}"\n    state: directory\n    owner: named\n    group: named\n    mode: 0755\n  with_items:\n  - /var/lib/named\n  - /etc/named.conf.d\n  - /var/lib/named/data\n  - /var/lib/named/data/named.cache\n  - /var/lib/named/data/named.run\n  - /var/lib/named/data/named.conf\n\n- name: Create group\n  group:\n    name: named\n    state: present\n\n- name: Create user\n  user:\n    name: named\n    group: named\n    system: yes\n    state: present\n\n- name: Generate rndc key\n  command: rndc-confgen -a -b 512 -c /var/lib/named/data/ rndc.key\n  args:\n    creates: /var/lib/named/data/rndc.key\n\n- name: Set permissions on rndc key file\n  file:\n    path: /var/lib/named/data/rndc.key\n    owner: named\n    group: named\n    mode: 0640\n\n- name: Get the hints/root file\n  get_url:\n    url: https://www.internic.net/domain/named.cache\n    dest: /var/lib/named/data/hints.root\n    mode: 0644\n    owner: named\n    group: named\n  when: caching_dns\n\n- name: Create zone file\n  template:\n    src: zone.j2\n    dest: "/var/lib/named/data/{{ item.name }}.zone"\n    owner: named\n    group: named\n    mode: 0644\n  with_items: "{{ dns_zones }}"\n  when: item.type == "primary"\n\n- name: Add zones to configuration\n  template:\n    src: named.conf.j2\n    dest: /etc/named.conf.d/zones.conf\n    owner: root\n    group: root\n    mode: 0644\n\n- name: Place systemd override\n  copy:\n    src: named.conf\n    dest: /etc/systemd/system/named.service.d/override.conf\n    owner: root\n    group: root\n    mode: 0644\n  when: ansible_service_mgr == "systemd"\n\n- name: Start and enable dns\n  service:\n    name: dns\n    state: started\n    enabled: yes' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-15T21:47:50.87538541Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11642286486, 'load_duration': 32344210, 'prompt_eval_count': 667, 'prompt_eval_duration': 476651702, 'eval_count': 574, 'eval_duration': 11132103570, 'model_name': 'granite-code:20b'} id='run--6f59c100-a1be-4c62-85ad-550b60a04eee-0' usage_metadata={'input_tokens': 667, 'output_tokens': 574, 'total_tokens': 1241}
