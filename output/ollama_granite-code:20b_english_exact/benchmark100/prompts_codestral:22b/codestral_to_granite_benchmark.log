content='---\n- name: Check if Helm binary exists\n  stat:\n    path: "{{ helm_bin_path }}"\n  register: helm_check\n\n- name: Check Helm version\n  command: "{{ helm_bin_path }} version --client"\n  ignore_errors: yes\n  changed_when: no\n  register: helm_existing_version\n\n- name: Download helm\n  unarchive:\n    src: "{{ helm_repo_path }}/helm/v{{ helm_version }}/{{ helm_platform }}-{{ helm_arch }}.tar.gz"\n    dest: /tmp\n    mode: "0644"\n    remote_src: yes\n  when: helm_check.stat.exists == false or helm_existing_version.stdout.find("v{{ helm_version }}") == -1\n  register: helm_download\n\n- name: Copy helm binary into place\n  copy:\n    src: /tmp/{{ helm_platform }}-{{ helm_arch }}/helm\n    dest: "{{ helm_bin_path }}"\n    mode: "0755"\n  when: helm_download.changed | bool' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-15T22:07:13.925009383Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4933716437, 'load_duration': 52014850, 'prompt_eval_count': 1011, 'prompt_eval_duration': 12734951, 'eval_count': 233, 'eval_duration': 4868229600, 'model_name': 'granite-code:20b'} id='run--08dc6f07-f19c-40d2-95c9-1c4ed2740e38-0' usage_metadata={'input_tokens': 1011, 'output_tokens': 233, 'total_tokens': 1244}
