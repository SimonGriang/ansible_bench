---
- name: Create document root directories
  file:
    path: "{{ item.documentroot }}"
    state: directory
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
    mode: "{{ item.mode | default(omit) }}"
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Creating document root directory {{ item.documentroot }}"
  when: item.documentroot is defined and item.state|default('enabled') != 'disabled'

- name: Configure virtual hosts
  template:
    src: "httpd.conf.j2"
    dest: "/etc/httpd/conf.d/{{ item.servername | regex_replace('[^A-Za-z0-9._-]', '_') }}.conf"
    mode: "0644"
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Configuring virtual host {{ item.servername }}"
  notify: Test configuration and restart httpd
  when: item.documentroot is defined and item.state|default('enabled') != 'disabled'

- name: Enable virtual hosts on Debian systems
  command: "a2ensite {{ item.servername | regex_replace('[^A-Za-z0-9._-]', '_') }}.conf"
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Enabling virtual host {{ item.servername }}"
  notify: Test configuration and restart httpd
  when: item.documentroot is defined and item.state|default('enabled') != 'disabled' and ansible_os_family == 'Debian'


