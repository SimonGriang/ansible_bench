- name: "Create ssl key"
  openssl_privatekey:
    path: /etc/ssl/private/example.com.key
    mode: 0600
    owner: root
    group: root

- name: "Create ssl csr"
  openssl_csr:
    path: /etc/ssl/csr/example.com.csr
    privatekey_path: /etc/ssl/private/example.com.key
    mode: 0600
    owner: root
    group: root

