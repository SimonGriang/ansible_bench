---
- name: Install requirements
  package:
    name: "{{ openssl_requirements }}"
    state: present
  tags: openssl_requirements

- name: Install pip packages
  pip:
    name: "{{ openssl_pip_packages }}"
    state: present
  tags: openssl_pip_packages

- name: Create key directory
  file:
    path: "{{ openssl_key_path }}"
    state: directory
    mode: 0700
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  tags: openssl_create_key_directory

- name: Create csr directory
  file:
    path: "{{ openssl_csr_path }}"
    state: directory
    mode: 0755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  tags: openssl_create_csr_directory

- name: Create crt directory
  file:
    path: "{{ openssl_crt_path }}"
    state: directory
    mode: 0755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  tags: openssl_create_crt_directory

- name: Create OpenSSL certificates
  include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: openssl_item
    label: "{{ openssl_item.name }}"
  tags: openssl_create_item


