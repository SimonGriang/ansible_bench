---
- import_tasks: assert.yml
- name: Task 2 - Install nginx
  package:
    name: nginx
    state: present
- name: Task 3 - Place nginx.conf
  template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    validate: nginx -t -c %s
  notify: restart nginx
- name: Task 4 - Ensure /etc/nginx/conf.d exists
  file:
    path: /etc/nginx/conf.d
    state: directory
    owner: root
    group: root
    mode: 0755
- name: Task 5 - Place default.conf
  template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    validate: nginx -t -c %s
  notify: restart nginx
- name: Task 6 - Start and enable nginx
  service:
    name: nginx
    state: started
    enabled: true


