---

- name: Bootstrap | Gather facts
  gather_facts:
    no_log: True
    # gather_subset: all
    #  fact_path: /tmp
  tasks:
    - name: Lookup bootstrap facts
      raw: "cat /etc/os-release"
      register: bootstrap_facts
      changed_when: False
      # when: not bootstrap_facts.stat.exists
      # delegate_to: localhost
      # run_once: True
      # become: no
      # become_user: root
    - name: Set bootstrap facts (I)
      loop: "{{ bootstrap_os_family_map }}"
      when:
        - bootstrap_facts is succeeded
        - bootstrap_distribution is not defined
        - bootstrap_facts.stdout is search(item.regex)
      set_fact:
        bootstrap_distribution: "{{ item.distribution }}"
        bootstrap_distribution_major_version: "{{ item.major }}"
    - name: Set bootstrap facts (II)
      loop: "{{ bootstrap_os_family_map }}"
      when:
        - bootstrap_facts is succeeded
        - bootstrap_distribution is defined
        - bootstrap_distribution in item.values
      set_fact:
        bootstrap_os_family: "{{ item.family }}"
      become: no
  vars:
    bootstrap_os_family_map:
      - regex: "Scientific Linux"
        family: "Scientific"
        distribution: "Scientific"
        major: "8"
      - regex: "CentOS Linux"
        family: "CentOS"
        distribution: "CentOS"
        major: "8"
      - regex: "Red Hat Enterprise Linux Server"
