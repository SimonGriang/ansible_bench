---
- name: "RKE2 Setup"
  hosts: localhost
  connection: local
  vars:
    ansible_python_interpreter: /usr/bin/python3
  tasks:
    - name: "Install Keepalived"
      import_tasks: "keepalived.yml"
      when: ha_mode == "keepalived" and groups['RKE2_servers'] is defined and inventory_hostname in groups['RKE2_servers']
    - name: "Install RKE2"
      import_tasks: "rke2.yml"
    - name: "Apply CIS Hardening"
      import_tasks: "cis.yml"
      when: cis_profile is defined
    - name: "Identify Active Server"
      import_tasks: "find_active_server.yml"
    - name: "Enable IPVS Kernel Module"
      import_tasks: "ipvs.yml"
      when: ipvs_enabled and ha_mode == "kubevip" and groups['RKE2_servers'] is defined and inventory_hostname in groups['RKE2_servers'] and groups['RKE2_servers'] | length > 1
    - name: "Copy Kube-vip Manifests"
      import_tasks: "kubevip.yml"
      when: groups['RKE2_servers'] is defined and inventory_hostname == groups['RKE2_servers'][0] and ha_mode == "kubevip" and groups['RKE2_servers'] | length > 1
    - name: "Copy Ingress-nginx Manifests"
      import_tasks: "ingress-nginx.yml"
      when: groups['RKE2_servers'] is defined and inventory_hostname == groups['RKE2_servers'][0] and ingress_nginx_values is defined
    - name: "Prepare First Server Node"
      import_tasks: "first_server.yml"
      when: groups['RKE2_servers'] is defined and inventory_hostname == groups['RKE2_servers'][0] and active_server is not defined or groups['RKE2_servers'] | length == 1
    - name: "Restore etcd"
      import_tasks: "first_server_restore.yml"
      when: active_server is defined and (inventory_hostname == active_server or (groups['RKE2_servers'] is defined and inventory_hostname == groups['RKE2_servers'][0])) and etcd_restore
    - name: "Download kubeconfig"
      import_tasks: "kubeconfig.yml"
      when: groups['RKE2_servers'] is defined and inventory_hostname == groups['RKE2_servers'][0] and download_kubeconfig
    - name: "Prepare and Join Remaining Nodes"
      import_tasks: "join_servers.yml"
      when: active_server is defined and groups['RKE2_servers'] is defined and groups['RKE2_servers'] | length > 1
    - name: "Rolling Restart Servers"
      import_tasks: "rolling_restart.yml"
      when: installed_version != running_version and groups['RKE2_servers'] is defined
    - name: "Rolling Restart Agents"
      import_tasks: "rolling_restart.yml"
      when: installed_version != running_version and groups['RKE2_servers'] is not defined
    - name: "Flush Handlers"
      meta: flush_handlers
    - name: "Rolling Restart Config Change"
      import_tasks: "change_config.yml"
      when: restart_needed



