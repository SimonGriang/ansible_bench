  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != "" and rke2_type == "server" and not rke2_server_service_enabled

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != "" and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined and rke2_type == "server" and not rke2_server_service_enabled

- block:
    - name: Create etcd snapshot restore directory
      file:
        path: "{{ rke2_etcd_snapshot_dir }}"
        state: directory
        owner: root
        group: root
        mode: 0755

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: "{{ rke2_etcd_snapshot_dir }}/{{ rke2_etcd_snapshot_file | basename }}"
        owner: root
        group: root
        mode: 0600

    - name: Restore etcd from snapshot
      command: rke2 server --etcd-snapshot --s3-backup-path {{ rke2_etcd_snapshot_dir }}/{{ rke2_etcd_snapshot_file | basename }}
      register: rke2_service_output
      changed_when: "rke2_service_output.stdout != '' and 'Level:   info' in rke2_service_output.stdout"
  when: do_etcd_restore is defined and do_etcd_restore

- block:
    - name: Restore etcd from s3
      command: rke2 server --etcd-snapshot --s3-backup-path s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }}
      environment:
        ETCD_S3_ACCESS_KEY: "{{ rke2_etcd_snapshot_s3_options.access_key }}"
        ETCD_S3_SECRET_KEY: "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
        ETCD_S3_ENDPOINT: "{{ rke2_etcd_snapshot_s3_options.endpoint }}"
        ETCD_S3_BUCKET: "{{ rke2_etcd_snapshot_s3_options.bucket }}"
        ETCD_S3_PREFIX: "{{ rke2_etcd_snapshot_s3_options.prefix }}"
        ETCD_S3_ENDPOINT_CA: "{{ rke2_etcd_snapshot_s3_options.endpoint_ca }}"
        ETCD_S3_SKIP_SSL_VERIFY: "{{ rke2_etcd_snapshot_s3_options.skip_ssl_verify }}"
      register: rke2_service_output
      changed_when: "rke2_service_output.stdout != '' and 'Level:   info' in rke2_service_output.stdout"
  when: do_etcd_restore_from_s3 is defined and do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  service:
    name: rke2-server.service
    state: started
    enabled: true
    env:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent.service
    enabled: false
    masked: true

- name: Wait for the first server to be ready - no CNI
  uri:
    url: https://localhost:6443/readyz
    method: GET
    validate_certs: no
  register: api_ready
  until: api_ready.status == 200
  retries: 60
  delay: 10
  when: rke2_cni == "none"

- name: Wait for the first server to be ready - with CNI
  uri:
    url: https://localhost:6443/readyz
    method: GET
    validate_certs: no
  register: api_ready
  until: api_ready.status == 200
  retries: 60
  delay: 10
  when: rke2_cni != "none"

- name: Restore etcd
  block:
    - name: Get RKE2 server nodes
      command: kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o json
      register: rke2_server_nodes

    - name: Set RKE2 server node list
      set_fact:
        rke2_server_node_list: "{{ rke2_server_nodes['stdout'] | from_json }}"

    - name: Remove old node-password secrets
      command: kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete secret "{{ item['metadata']['name'] }}-node-password" -n kube-system
      loop: "{{ rke2_server_node_list['items'] }}"
      no_log: true

    - name: Remove old nodes
      command: kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml delete node "{{ item['metadata']['name'] }}"
      loop: "{{ rke2_server_node_list['items'] }}"
      no_log: true

    - name: Set Active Server
      set_fact:
        rke2_active_server: "{{ rke2_server_node_list['items'][0]['metadata']['name'] }}"
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined


