    java_open_jdk_package: "java-1.8.0-openjdk"
  when:
    - java_jdk_vendor == "openjdk"
    - java_open_jdk_version == "8"
    - ansible_architecture == "x86_64"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Remove deprecated repositories
  apt_repository:
    repo: "{{ item }}"
    state: absent
  with_items: "{{ java_deprecated_repositories_adoptopenjdk }}"
  when:
    - java_jdk_vendor == "adoptopenjdk"
    - ansible_os_family == "Debian"

- name: Install extra apt tools
  apt:
    name: "{{ item }}"
    state: present
  with_items: "{{ java_open_jdk_apt_extra_packages }}"
  when:
    - java_jdk_vendor == "openjdk"
    - ansible_os_family == "Debian"

- name: Add required key repositories
  apt_key:
    url: "{{ item }}"
    state: present
  with_items: "{{ java_open_jdk_apt_key_repositories }}"
  when:
    - java_jdk_vendor == "openjdk"
    - ansible_os_family == "Debian"

- name: Add required repositories
  apt_repository:
    repo: "{{ item }}"
    state: present
  with_items: "{{ java_open_jdk_apt_repositories }}"
  when:
    - java_jdk_vendor == "openjdk"
    - ansible_os_family == "Debian"

- name: Add required key repositories
  rpm_key:
    key: "{{ item }}"
    state: present
  with_items: "{{ java_open_jdk_rpm_key_repositories }}"
  when:
    - java_jdk_vendor == "openjdk"
    - ansible_os_family == "RedHat"

- name: Add required repositories
  yum:
    name: "{{ item }}"
    state: present
  with_items: "{{ java_open_jdk_yum_repositories }}"
  when:
    - java_jdk_vendor == "openjdk"
    - ansible_os_family == "RedHat"

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ java_open_jdk_required_libs }}"
  when: java_open_jdk_required_libs | length > 0

- name: Install Java (Debian)
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
    version: "{{ java_open_jdk_version }}"
  when:
    - java_jdk_vendor == "openjdk"
    - ansible_os_family == "Debian"

- name: Install Java (RedHat)
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present
    version: "{{ java_open_jdk_version }}"
  when:
    - java_jdk_vendor == "openjdk"
    - ansible_os_family == "RedHat"

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: "0644"
  when: java_open_jdk_home is defined

- name: Source environment variables
  shell: source /etc/profile
  when: java_open_jdk_home is defined


