    - seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: true
      loop: "{{ selinux_booleans }}"
      when: selinux_status == "enabled"
      tags:
        - selinux

    - seport:
        ports: "{{ item.port }}"
        proto: "{{ item.proto }}"
        setype: "{{ item.setype }}"
        state: "{{ item.state }}"
      loop: "{{ selinux_ports }}"
      when: selinux_status == "enabled"
      tags:
        - selinux
  tags:
    - selinux

- name: Task 4 - Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "0644"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  tags:
    - config

