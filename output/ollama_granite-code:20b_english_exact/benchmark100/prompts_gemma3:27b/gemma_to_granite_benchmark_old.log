---
- name: Check if all variables have been set correctly.
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for host to be reachable
  wait_for_connection:
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection != "container/docker" and bootstrap_wait_for_host

- block:
    - name: Test connection
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: bootstrap_connect

    - name: Debug bootstrap_timeout
      debug:
        var: bootstrap_timeout
      when: not bootstrap_connect
  always:
    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml

- name: Install bootstrap packages
  raw: "{{ bootstrap_install_packages }}"
  changed_when: >
    bootstrap_install_packages is regex('alpine|archlinux|gentoo')
    or bootstrap_install_packages not in bootstrap__facts_packages['ansible_system']
  become: true
  become_user: "{{ bootstrap_user }}"

- block:
    - name: Gather ansible facts
      setup:

    - name: Install required packages
      package:
        name: "{{ bootstrap__facts_packages['ansible_system'] }}"
        state: present
        update_cache: true
  always:
    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml


