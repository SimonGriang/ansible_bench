---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required software
  package:
    name: "{{ users_requirements }}"
    state: present
  when:
    - users_requirements is defined

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item.group_name }}"
  when:
    - users_groups is defined

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "#includedir {{ users_sudo_includedir }}"
    state: present
    validate: visudo -cf %s
  when:
    - users_sudo_includedir is defined

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  when:
    - users is defined

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0644
  when:
    - users_cron_allow is defined
    - users_cron_allow

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when:
    - users_cron_allow is defined
    - not users_cron_allow


