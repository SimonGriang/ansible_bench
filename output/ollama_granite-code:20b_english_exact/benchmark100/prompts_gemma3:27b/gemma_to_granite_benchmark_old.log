---
- name: lookup bootstrap facts
  become: "{{ bootstrap_become |default(omit) }}"
  become_user: "{{ bootstrap_become_user |default(omit) }}"
  raw: cat /etc/os-release
  changed_when: false
  register: bootstrap_facts

- name: set bootstrap facts (I) # noqa jinja
  become: "{{ bootstrap_become |default(omit) }}"
  become_user: "{{ bootstrap_become_user |default(omit) }}"
  set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout |regex_search('^VERSION_ID=\"([0-9.-]+)') |regex_replace('^VERSION_ID=\"(.*)', '\\1') }}"
  loop: "{{ bootstrap__os_family_map |dict2items }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - "item.key in bootstrap_facts.stdout_lines[0]"
  no_log: "{{ bootstrap_no_log |default(true) }}"

- name: set bootstrap facts (II)
  become: "{{ bootstrap_become |default(omit) }}"
  become_user: "{{ bootstrap_become_user |default(omit) }}"
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map |dict2items }}"
  when: "bootstrap_distribution in item.value"
  no_log: "{{ bootstrap_no_log |default(true) }}"


