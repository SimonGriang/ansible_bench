---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: vault
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    createhome: no

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    owner: vault
    group: vault
    mode: 0755
    state: directory

- name: Download Vault binary
  unarchive:
    src: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
    dest: "{{ vault_download_path }}"
    owner: vault
    group: vault
  notify: Restart vault

- name: Stat vault_path
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exists
  file:
    path: "{{ vault_path }}"
    owner: vault
    group: vault
    mode: 0755
    state: directory
  when: vault_check_path.stat.exists == false and vault_path != ""

- name: Create directory in vault_path
  file:
    path: "{{ vault_path }}/{{ item.path }}"
    owner: vault
    group: vault
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ vault_path }}/{{ item.path }}"
    owner: vault
    group: vault
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command: openssl req -newkey rsa:2048 -nodes -keyout tls.key -x509 -days 3650 -out tls.crt -subj "/CN=localhost"
  args:
    chdir: "{{ vault_data_directory }}/tls/"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ vault_data_directory }}/tls/{{ item }}"
    owner: vault
    group: vault
    mode: 0640
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: /usr/bin/vault
    owner: root
    group: root
    mode: 0755
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  capabilities:
    path: /usr/bin/vault
    capability: cap_ipc_lock=ep
    state: present

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    owner: vault
    group: vault
    mode: 0644
    state: touch
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    owner: root
    group: root
    mode: 0755
    state: directory

- name: Copy Vault service file
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: 0644
  when: vault_service_manager == "systemd"
  notify: Daemon reload

- name: Copy vault configuration
  template:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: 0644
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


