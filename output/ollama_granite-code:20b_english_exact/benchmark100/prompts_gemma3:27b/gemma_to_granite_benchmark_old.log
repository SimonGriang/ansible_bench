---
- name: Download RKE2 installation script
  get_url:
    url: https://get.rke2.io
    dest: /tmp/rke2-install.sh
    mode: 0755
  when: airgap and implementation == "url"

- name: Copy local RKE2 installation script
  copy:
    src: /local/path/rke2-install.sh
    dest: /tmp/rke2-install.sh
    mode: 0755
  when: airgap and implementation == "copy"

- name: Create RKE2 artifacts folder
  file:
    path: /var/lib/rke2/agent/artifacts
    state: directory
  when: airgap and implementation != "exists"

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download checksum
      get_url:
        url: https://github.com/rke2/rke2/releases/download/v1.2.8/rke2-CHECKSUM
        dest: /tmp/rke2-checksum
    - name: Download artifacts
      unarchive:
        src: https://github.com/rke2/rke2/releases/download/v1.2.8/rke2.linux-amd64.tar.gz
        dest: /var/lib/rke2/agent/artifacts
        remote_src: true
  rescue:
    - name: Download local checksum
      copy:
        src: /local/path/rke2-checksum
        dest: /tmp/rke2-checksum
    - name: Download local artifacts
      unarchive:
        src: /local/path/rke2.linux-amd64.tar.gz
        dest: /var/lib/rke2/agent/artifacts
        remote_src: true

- name: Copy local RKE2 artifacts
  copy:
    src: /local/path/rke2.linux-amd64.tar.gz
    dest: /var/lib/rke2/agent/artifacts/rke2.linux-amd64.tar.gz
  when: airgap and implementation == "copy"

- name: Copy additional tarball images for RKE2 components
  copy:
    src: "{{ item }}"
    dest: /var/lib/rke2/agent/artifacts/
  with_items: "{{ airgap_images }}"
  when: airgap_images is defined

- name: Ensure artifacts exist and have appropriate permissions
  file:
    path: "{{ item }}"
    mode: 0644
  with_items:
    - /var/lib/rke2/agent/artifacts/rke2.linux-amd64.tar.gz
    - /tmp/rke2-checksum
  when: airgap

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: local_fs_stats

- name: Check if separate partition
  set_fact:
    separate_partition: "{{ (local_fs_stats.stat.dev != '/dev/mapper/vg--vg0-usr--local') }}"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin/rke2"
  when: separate_partition

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/bin/rke2"
  when: not separate_partition

- name: Check RKE2 version
  command: "{{ rke2_bin_path }} version"
  register: rke2_version_output

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version_output.stdout_lines[0] }}"
    rke2_running_version: "{{ rke2_version_output.stdout_lines[1] }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that: rke2_running_version == rke2_installed_version
    fail_msg: "RKE2 accidental downgrade not allowed"
    success_msg: "RKE2 running version matches installed version"
  when: not allow_downgrade

- name: Run RKE2 install script
  command: "{{ rke2_bin_path }} install --upgrade --system-agent --debug --log-level {{ log_level }} --rke-image {{ rke_image }} {{ extra_args }}"
  environment:
    INSTALL_RKE2_TYPE: "agent"
    RKE2_DATA_DIR: "/var/lib/rke2/agent"

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: /var/lib/rke2/agent/manifests/
  with_items: "{{ custom_manifests }}"
  when: custom_manifests is defined

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: /etc/kubernetes/manifests/
  with_items: "{{ static_pods }}"
  when: static_pods is defined

- name: Copy RKE2 environment file
  copy:
    content: |
      no_proxy="{{ no_proxy | default('') }}"
      http_proxy="{{ http_proxy | default('') }}"
      https_proxy="{{ https_proxy | default('') }}"
      HTTP_PROXY="{{ http_proxy | default('') }}"
      HTTPS_PROXY="{{ https_proxy | default('') }}"
    dest: /etc/environment


