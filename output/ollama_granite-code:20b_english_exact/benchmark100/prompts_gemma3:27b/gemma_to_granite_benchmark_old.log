  when: ansible_os_family == "RedHat" and ansible_distribution_major_version in ["7", "8", "9", "10"] or ansible_os_family == "Amazon"
  block:
    - name: Install epel gpg key
      ansible.builtin.get_url:
        url: "{{ epel_gpg_key }}"
        dest: /etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL
        mode: 0644
        owner: root
        group: root
      when: epel_gpg_key is defined

    - name: Install epel-release package
      ansible.builtin.package:
        name: epel-release
        state: present
      when: epel_url is defined
      notify: Update package cache

    - name: Install epel-next-release package
      ansible.builtin.package:
        name: epel-next-release
        state: present
      when: epel_next_url is defined and epel_next
      notify: Update package cache
  vars:
    epel_gpg_key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-8
    epel_url: https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm
    epel_next_url: https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm
  handlers:
    - name: Update package cache
      ansible.builtin.apt:
        update_cache: yes
        cache_valid_time: 3600


