---
- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == "server"

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == "agent"

- name: Copy RKE2 config
  template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/rke2.yaml
    mode: '0644'
  notify: restart rke2

- name: Copy kubelet config
  template:
    src: kubelet.conf.j2
    dest: /var/lib/kubelet/config.yaml
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  template:
    src: containerd-registry.yaml.j2
    dest: /etc/rancher/rke2/agent/etc/containerd/config.toml
    mode: '0644'
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
  notify: restart rke2

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    daemon_reload: yes
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  retries: 20
  delay: 10
  register: result
  until: result is succeeded
  notify: restart rke2

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ item }}"
    state: stopped
    enabled: no
    masked: yes
  loop:
    - rke2-agent
    - rke2-server
  when: rke2_type == "server"

- name: Wait for remaining nodes to be ready - no CNI
  shell: >
    until [[ $(timeout 5 kubectl get nodes --request-timeout=3s -o json | jq '.items[].status.conditions[] | select(.type=="MemoryPressure" and .status=="False") | select(.type=="DiskPressure" and .status=="False") | select(.type=="PIDPressure" and .status=="False") | select(.type=="Ready" and .status=="True") | select(.type=="NodeControllerMemoryPressure" and .status=="False") | select(.type=="Nodeload15" and .status=="False") | select(.type=="NodeHasNoDiskPressure" and .status=="True") | select(.type=="NodeHasNoMemoryPressure" and .status=="True") | select(.type=="NodePIDPressure" and .status=="False") | select(.type=="NodeNetworkUnavailable" and .status=="False") | select(.type=="NodeReady" and .status=="True") | select(.type=="Memory available" and .status=="True")' | wc -l) -ge {{ groups['all'] | length }} ]]; do sleep 1; done
  args:
    warn: false
  register: task_result
  until: task_result is succeeded
  retries: 60
  delay: 10
  when: rke2_cni == "none" and (rke2_type == "server" or rke2_type == "first_server")
  notify: restart rke2

- name: Wait for remaining nodes to be ready - with CNI
  shell: until [[ $(timeout 5 kubectl get nodes --request-timeout=3s -o json | jq '.items[].status.conditions[] | select(.type=="Ready" and .status=="True") | select(.type=="NodeControllerMemoryPressure" and .status=="False") | select(.type=="Nodeload15" and .status=="False") | select(.type=="NodeHasNoDiskPressure" and .status=="True") | select(.type=="NodeHasNoMemoryPressure" and .status=="True") | select(.type=="NodePIDPressure" and .status=="False") | select(.type=="NodeNetworkUnavailable" and .status=="False") | select(.type=="NodeReady" and .status=="True") | select(.type=="Memory available" and .status=="True")' | wc -l) -ge {{ groups['all'] | length }} ]]; do sleep 1; done
  args:
    warn: false
  register: task_result
  until: task_result is succeeded
  retries: 60
  delay: 10
  when: rke2_cni != "none" and (rke2_type == "server" or rke2_type == "first_server")
  notify: restart rke2


