content='---\n- name: create directories\n  file:\n    path: /opt/cadvisor\n    owner: root\n    group: root\n    mode: 0755\n    state: directory\n\n- name: download cadvisor\n  get_url:\n    url: "{{ cadvisor_download }}"\n    dest: "/opt/cadvisor/cadvisor-{{ cadvisor_version }}"\n    owner: root\n    group: root\n    mode: 0755\n    checksum: "sha256:{{ cadvisor_checksum }}"\n  when: cadvisor_binary_local_dir == ""\n\n- name: propagate locally distributed cadvisor binary\n  copy:\n    src: "{{ cadvisor_binary_local_dir }}/cadvisor-{{ cadvisor_version }}"\n    dest: "/opt/cadvisor/cadvisor-{{ cadvisor_version }}"\n    owner: root\n    group: root\n    mode: 0755\n    notify: restart cadvisor\n  when: cadvisor_binary_local_dir != ""\n\n- name: symlink cadvisor\n  file:\n    src: "/opt/cadvisor/cadvisor-{{ cadvisor_version }}"\n    dest: /opt/cadvisor/cadvisor\n    owner: root\n    group: root\n    state: link\n    force: true\n\n- name: server systemd service\n  template:\n    src: systemd-system-cadvisor-service.j2\n    dest: /etc/systemd/system/cadvisor.service\n    owner: root\n    group: root\n    mode: 0644\n    notify: restart cadvisor\n\n- name: test_task\n  shell: "systemctl is-active cadvisor.service"\n  register: service_active\n  changed_when: false\n\n- name: debug\n  debug:\n    var: service_active\n\n- name: cadvisor | enable server systemd\n  systemd:\n    name: cadvisor.service\n    enabled: true\n\n- name: cadvisor | start server systemd\n  systemd:\n    name: cadvisor.service\n    daemon_reload: true\n    state: started\n    enabled: true' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-11T12:56:42.433475943Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9514876879, 'load_duration': 32793382, 'prompt_eval_count': 811, 'prompt_eval_duration': 566004190, 'eval_count': 434, 'eval_duration': 8914424200, 'model_name': 'granite-code:20b'} id='run--f0bbe98c-dbbd-4b5e-b241-9ed97f01aead-0' usage_metadata={'input_tokens': 811, 'output_tokens': 434, 'total_tokens': 1245}
