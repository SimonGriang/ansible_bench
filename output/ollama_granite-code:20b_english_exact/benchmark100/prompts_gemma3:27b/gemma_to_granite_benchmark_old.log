---
- name: strict_follow_ instructions
  hosts: all
  tasks:
    - name: Change the history log so it does not contain the word "vault"
      command: "sed -i '/vault/d' /root/.bash_history"
      args:
        warn: false

    - name: Set the file permissions to 0644, owner to root, and group to root
      file:
        path: /root/.bash_history
        mode: 0644
        owner: root
        group: root

    - name: Configure SELinux / AppArmor
      when:
        - vault_hardening_configure_selinux_apparmor
        - ansible_selinux.status == "enabled"
      block:
        - name: Install the selinux-policy package
          package:
            name: selinux-policy
            state: present

        - name: Set the SELinux policy to targeted and state to enforcing
          command: selinux-policy --set-policy targeted

    - name: Configure AppArmor
      when: ansible_apparmor.status == "enabled"
      block:
        - name: Install the apparmor-parser package
          package:
            name: apparmor-parser
            state: present

        - name: Enable AppArmor
          command: apparmor_parser -r /etc/apparmor.d/usr.sbin.nginx
          args:
            warn: false


