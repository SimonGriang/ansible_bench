---
- name: Get RKE2 nodes
  command: kubectl get nodes -o jsonpath='{.items[*].metadata.name}' --kubeconfig=/path/to/kubeconfig
  register: node_names

- name: Remove old RKE2 nodes
  ignore_errors: true
  command: kubectl delete node {{ item }} --kubeconfig=/path/to/kubeconfig
  with_items: "{{ node_names.stdout_lines }}"
  when: item not in groups[rke2_cluster_group_name]


