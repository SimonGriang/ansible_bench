---
- name: Manage user account
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment | default(omit) }}"
    createhome: "{{ user.createhome | default(omit) }}"
    password: "{{ user.password | default(omit) }}"
    update_password: "{{ user.update_password | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    expires: "{{ user.expires | default(omit) }}"
  register: user_module

- name: Set sudo options for user
  template:
    src: sudoers.j2
    dest: /etc/sudoers.d/{{ user.name }}
    validate: '/usr/sbin/visudo -cf %s'
    owner: root
    group: root
    mode: 0440
  loop: "{{ user.sudoers }}"
  loop_control:
    label: "user {{ user.name }} sudoers entry"
  become: true
  when:
    - user.sudoers is defined
    - user.sudoers|length > 0

- name: Remove sudo options for user
  file:
    path: /etc/sudoers.d/{{ user.name }}
    state: absent
  become: true
  when:
    - user.sudoers is defined
    - user.sudoers|length == 0

- name: Generate private ssh key for user
  command: >
    ssh-keygen -q -t rsa -b 4096 -f {{ user.ssh_key_file }} -N ''
    creates={{ user.ssh_key_file }}
  args:
    creates: "{{ user.ssh_key_file }}"
  delegate_to: localhost
  become: false
  when:
    - user.manage_ssh_key is defined
    - user.manage_ssh_key

- name: Generate public ssh key for user
  command: >
    ssh-keygen -y -f {{ user.ssh_key_file }} > {{ user.ssh_key_file }}.pub
    creates={{ user.ssh_key_file }}.pub
  args:
    creates: "{{ user.ssh_key_file }}.pub"
  delegate_to: localhost
  become: false
  when:
    - user.manage_ssh_key is defined
    - user.manage_ssh_key

- name: Convert ssh key to ppk for user
  command: >
    ssh-keygen -f {{ user.ssh_key_file }} -p -m ppk -N ''
    creates={{ user.ssh_key_file }}.ppk
  args:
    creates: "{{ user.ssh_key_file }}.ppk"
  delegate_to: localhost
  become: false
  when:
    - user.manage_ssh_key is defined
    - user.manage_ssh_key

- name: Get or set the home directory for user
  become: true
  when:
    - user.manage_ssh_key is defined
    - user.manage_ssh_key
    - user.copy_private_key is defined
    - user.copy_private_key
  block:
    - name: Query user home directory
      command: >
        getent passwd {{ user.name }} | cut -d: -f6
      changed_when: false
      failed_when: false
      register: user_home_query

    - name: Set user home directory fact
      set_fact:
        user_home: "{{ user_home_query.stdout }}"
      when:
        - user_home_query.stdout != ""

    - name: Set default user home directory
      set_fact:
        user_home: /home
      when:
        - user_home_query.stdout == ""

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: 0700
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  become: true
  when:
    - (user.manage_ssh_key is defined and user.manage_ssh_key) or
      (user.copy_private_key is defined and user.copy_private_key)

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
    path: "{{ user_home }}/.ssh/authorized_keys"
  loop: "{{ user.authorized_keys }}"
  loop_control:
    label: "user {{ user.name }} authorized key {{ item }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
    path: "{{ user_home }}/.ssh/authorized_keys"
  loop: "{{ user.unauthorized_keys }}"
  loop_control:
    label: "user {{ user.name }} unauthorized key {{ item }}"

- name: Copy generated private ssh key for user
  copy:
    src: "{{ user.ssh_key_file }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
  become: true
  when:
    - user.copy_private_key is defined
    - user.copy_private_key

