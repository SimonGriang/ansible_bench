---
- name: Create document roots for virtual hosts
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Creating document root for {{ item.name }}"
  when: item.create_docroot|default(True) and item.documentroot|default(None)

- name: Configure virtual hosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory ~ '/' ~ item.name ~ '.conf' }}"
    mode: 0644
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Configuring virtual host {{ item.name }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Enable virtual hosts
  command: a2ensite {{ item.name }}.conf
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Enabling virtual host {{ item.name }}"
  register: a2ensite
  changed_when: "'Enabled' in a2ensite.stdout"
  when: ansible_os_family == 'Debian' and a2ensite.stdout is not search("Enabled")
  notify:
    - Test httpd configuration validity
    - Restart httpd


