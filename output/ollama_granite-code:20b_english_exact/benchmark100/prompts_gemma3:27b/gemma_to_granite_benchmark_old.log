---
- name: Enable Apache modules
  become: true
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"
  ansible.builtin.apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http

- name: Configure Apache locations
  become: true
