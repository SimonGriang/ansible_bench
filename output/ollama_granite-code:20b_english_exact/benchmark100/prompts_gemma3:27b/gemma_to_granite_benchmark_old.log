---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- block:
    - name: Configure SELinux booleans
      ansible.posix.seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: true
      loop: "{{ httpd_sebooleans }}"
      when: item.name is defined

    - name: Allow httpd port
      ansible.posix.seport:
        ports: "{{ httpd_port | string }}
              {{ httpd_ssl_port | string }}"
        proto: tcp
        setype: httpd_port_t
        state: present
