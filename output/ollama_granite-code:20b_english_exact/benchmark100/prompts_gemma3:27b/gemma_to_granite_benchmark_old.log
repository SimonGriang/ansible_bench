---
- name: Create RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == "server"

- name: Copy rke2 config
  template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/rke2.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: kubelet.conf.j2
    dest: /etc/rancher/rke2/kubelet.conf
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: containerd-registry.conf.j2
    dest: /etc/rancher/rke2/agent/etc/containerd/registry.conf
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and rke2_services["rke2-server.service"].enabled == true

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.region is defined

- name: Restore etcd from file
  block:
  - name: Create etcd snapshot destination directory
    file:
      path: "{{ rke2_data_dir }}/snapshots"
      state: directory
      owner: root
      group: root
      mode: '0700'

  - name: Copy etcd snapshot
    copy:
      src: "{{ rke2_etcd_snapshot_file }}"
      dest: "{{ rke2_data_dir }}/snapshots/restore.db"
      owner: root
      group: root
      mode: '0600'

  - name: Run rke2 server etcd snapshot restore command
    command: >
      /usr/local/bin/rke2 server --config {{ rke2_data_dir }}/rke2.yaml
      --upload-snapshots --disable-snapshots
      --etcd-snapshot-restore --etcd-snapshot-path {{ rke2_data_dir }}/snapshots/restore.db
    environment:
      ETCDCTL_ENDPOINTS: https://127.0.0.1:2379
      ETCDCTL_CA_FILE: /var/lib/rancher/rke2/agent/etc/kubernetes/ssl/admin.pem
      ETCDCTL_CERT_FILE: /var/lib/rancher/rke2/agent/etc/kubernetes/ssl/admin-client.pem
      ETCDCTL_KEY_FILE: /var/lib/rancher/rke2/agent/etc/kubernetes/ssl/admin-client-key.pem
      RKE2_TOKEN: "{{ rke2_token }}"
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
  - name: Run rke2 server etcd snapshot restore command
    command: >
      /usr/local/bin/rke2 server --config {{ rke2_data_dir }}/rke2.yaml
      --upload-snapshots --disable-snapshots
      --etcd-snapshot-restore
      --etcd-s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }}
      --etcd-s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }}
      --etcd-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }}
      --etcd-s3-endpoint {{ rke2_etcd_snapshot_s3_options.endpoint }}
      --etcd-s3-region {{ rke2_etcd_snapshot_s3_options.region }}
      --etcd-s3-timeout {{ rke2_etcd_snapshot_s3_options.timeout_seconds }}
    environment:
      ETCDCTL_ENDPOINTS: https://127.0.0.1:2379
      ETCDCTL_CA_FILE: /var/lib/rancher/rke2/agent/etc/kubernetes/ssl/admin.pem
      ETCDCTL_CERT_FILE: /var/lib/rancher/rke2/agent/etc/kubernetes/ssl/admin-client.pem
      ETCDCTL_KEY_FILE: /var/lib/rancher/rke2/agent/etc/kubernetes/ssl/admin-client-key.pem
      RKE2_TOKEN: "{{ rke2_token }}"
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: true
    daemon_reload: true
    env:
      RKE2_TOKEN: "{{ rke2_token }}"
    scope: machine
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    enabled: false
    masked: true

- name: Wait for the first server be ready - no CNI
  command: >
    kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
    --insecure-skip-tls-verify get nodes
  register: result
  until: result.stdout.find("Ready") != -1
  retries: 60
  delay: 10
  changed_when: false
  when: rke2_network_plugin != "cni"

- name: Wait for the first server be ready - with CNI
  command: >
    kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
    --insecure-skip-tls-verify get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
  register: result
  until: result.stdout == "True"
  retries: 60
  delay: 10
  changed_when: false
  when: rke2_network_plugin == "cni"

- name: Restore etcd
  block:
  - name: Get registered nodes
    command: >
      kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
      get nodes -o jsonpath='{.items[*].metadata.name}'
    register: result
    changed_when: false

  - name: Get node names
    command: >
      kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
      get nodes -o jsonpath='{.items[*].spec.hostname}'
    register: result_names
    changed_when: false

  - name: Remove old secrets
    command: >
      kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
      delete secret {{ item }}
    loop: "{{ result.stdout_lines }}"
    loop_control:
      label: "secret {{ item }}"
    ignore_errors: true

  - name: Remove old nodes
    command: >
      kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
      delete node {{ item }}
    loop: "{{ result_names.stdout_lines }}"
    loop_control:
      label: "node {{ item }}"
    ignore_errors: true
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  delegate_to: "{{ item }}"
  delegate_facts: true
  loop: "{{ groups[rke2_cluster_group_name] }}"
  run_once: true
  when: rke2_type == "server"


