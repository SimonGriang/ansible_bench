- name: Task 1 - Enable the Backports repository for Debian
  apt_repository:
    repo: "deb http://http.debian.net/debian {{ ansible_distribution_release }}-backports main contrib non-free"
    filename: "{{ ansible_distribution_release }}-backports"
    state: present
  when: ansible_os_family == "Debian" and ansible_distribution_version | version_compare("9", "<")

- name: Task 2 - Set the default_release fact for older Debian versions
  set_fact:
    ansible_default_release: "{{ ansible_distribution_release }}-backports"
  when: ansible_os_family == "Debian" and ansible_distribution_version | version_compare("9", "<")

- name: Task 3 - Install Ansible
  apt:
    name: "ansible"
    state: "{{ ansible_package_state }}"
    default_release: "{{ ansible_default_release | default(omit) }}"


