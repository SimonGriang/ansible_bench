---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost
- block:
  - name: Install using package
    package:
      name: "{{ hashicorp_products }}"
      state: present
  when: hashicorp_installation_method == "package"
- block:
  - name: Install repository for RedHat
    get_url:
      url: "{{ hashicorp_apt_repo_url }}"
      dest: /etc/yum.repos.d/hashicorp.repo
      mode: 0640
  when: ansible_os_family == "RedHat"
- block:
  - name: Configure debian
    apt:
      update_cache: yes
  when: ansible_os_family == "Debian"
- block:
  - name: Install required package gpg
    package:
      name: gpg
      state: present
  when: ansible_os_family == "Debian"
- block:
  - name: Install apt key for Debian
    apt_key:
      url: "{{ hashicorp_apt_key_url }}"
      state: present
      ignore_errors: yes
  when: ansible_os_family == "Debian"
- block:
  - name: Install repository for Debian
    apt_repository:
      repo: "{{ hashicorp_apt_repo_url }}"
      update_cache: yes
      state: present
      filename: hashicorp
  when: ansible_os_family == "Debian"
- block:
  - name: Install hashicorp product using package
    package:
      name: "{{ item.name }}"
      state: present
    loop: "{{ hashicorp_products }}"
  when: hashicorp_products is defined
- block:
  - name: Install latest hashicorp product using package
    package:
      name: "{{ item.name }}"
      state: latest
    loop: "{{ hashicorp_products }}"
    loop_control:
      label: "Install {{ item.name }}"
  when: hashicorp_products is defined
- block:
  - name: Install versioned hashicorp product using package
    package:
      name: "{{ version_coupler }}{{ item.name }}"
      state: present
    loop: "{{ hashicorp_products }}"
    loop_control:
      label: "Install {{ item.name }} version {{ item.version }}"
  when: hashicorp_products is defined and ( item.version is defined and item.version | length > 0 )
- block:
  - name: Install manually
    unarchive:
      src: "{{ hashicorp_src }}"
      dest: "{{ hashicorp_dest }}"
      group: "{{ hashicorp_group }}"
      mode: "{{ hashicorp_mode }}"
      owner: "{{ hashicorp_owner }}"
    loop: "{{ hashicorp_products }}"
    loop_control:
      label: "Install {{ item.name }} from {{ hashicorp_src }} to {{ hashicorp_dest }}"
  when: hashicorp_installation_method == "manual"


