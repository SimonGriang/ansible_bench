---
- name: Restart and wait for RKE2
  tasks:
    - name: Restart the RKE2 service
      service:
        name: "{{ rke2_service_name }}"
        state: restarted
      notify: Service (re)started
    - name: Wait for all nodes to be ready
      shell: >
        {{ rke2_data_path }}/data/bin/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml
        get nodes --selector=node-role.kubernetes.io/worker
        -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' | wc -l
      args:
        chdir: "{{ rke2_data_path }}"
        executable: /bin/bash
      register: node_ready_count
      until: node_ready_count.stdout | int == group_names[rke2_cluster_group_name] | length
      retries: 100
      delay: 15
      delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
      run_once: true
    - name: Wait for all pods to be ready
      shell: >
        {{ rke2_data_path }}/data/bin/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml
        get pods --all-namespaces --field-selector=status.phase!=Running,status.phase!=Succeeded
        -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' | wc -l
      args:
        chdir: "{{ rke2_data_path }}"
        executable: /bin/bash
      register: pod_not_ready_count
      until: pod_not_ready_count.stdout | int == 0
      retries: 100
      delay: 15
      delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
      run_once: true
      when: rke2_wait_for_all_pods_to_be_ready
      changed_when: false

