---

- name: Task 1 - Import assert.yml
  include_tasks: assert.yml
  tags:
  - always

- name: Task 2 - Install cron
  package:
    name: "{{ cron_packages }}"
    state: present
  tags:
  - cron

- name: Task 3 - Configure shell
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    create: true
    mode: 0600
    notify: Restart cron
  tags:
  - cron

- name: Task 4 - Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    create: true
    mode: 0600
    notify: Restart cron
  tags:
  - cron

- name: Task 5 - Configure mailto
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    create: true
    mode: 0600
    notify: Restart cron
  tags:
  - cron

- name: Task 6 - Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service | length > 0
  tags:
  - cron

- name: Task 7 - Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
    state: "{{ item.state }}"
    user: "{{ item.user }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined
  tags:
  - cron


