---
- name: Assert systemd as init system
  assert:
    that: ansible_service_mgr == "systemd"
    msg: "Systemd must be used as init system!"

- name: Get latest release
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    return_content: yes
    status_code: 200
    body_format: json
    body:
      per_page: 1
    headers:
      Accept: application/vnd.github+json
      User-Agent: "Ansible"
      Authorization: "token {{ lookup('env','GH_TOKEN') }}"
  register: _latest_release
  until: _latest_release.json is defined
  retries: 5
  delay: 10

- set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
  when: promtail_version == "latest"

- stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.linux-{{ go_arch }}.zip"
  register: promtail_binary_local_archive

- assert:
    that: promtail_binary_local_archive.stat.exists
    msg: "promtail binary archive does not exist in {{ promtail_binary_local_dir }}"
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  uri:
    url: https://raw.githubusercontent.com/grafana/loki/ {{ promtail_version }}/debian/ena/SHA256SUMS
    method: GET
    return_content: yes
    status_code: 200
    body_format: raw
  register: __promtail_checksums
  when: promtail_binary_local_dir is not defined

- set_fact:
    __promtail_checksum: "{{ __promtail_checksums.content | regex_findall( promtail_version + '.linux-{{ go_arch }}.zip' + '(.*?)$' )[0][1] }}"
  when: promtail_binary_local_dir is not defined
