---
- name: Join a RKE2 cluster
  hosts: localhost
  connection: local
  gather_facts: no
  tasks:
    - name: Get join command from the RKE2 server
      command: rke2 join --config cluster.yaml
      register: join_command

    - name: Copy join command to the other nodes
      copy:
        content: "{{ join_command.stdout }}"
        dest: /var/tmp/join-command.sh
      delegate_to: "{{ item }}"
      loop: "{{ groups['node'] }}"

    - name: Run the join command on the new nodes
      command: sh /var/tmp/join-command.sh
      delegate_to: "{{ item }}"
      loop: "{{ groups['node'] }}"

- name: Waiting for all nodes to be ready
  hosts: localhost
  connection: local
  gather_facts: no
  tasks:
    - name: Wait for all nodes to be ready
      command: kubectl get nodes
      until: "'Ready' in node_info.stdout"
      retries: 30
      delay: 10
      delegate_to: "{{ item }}"
      loop: "{{ groups['node'] }}"

- name: "Service (re)started" handler
  hosts: localhost
  connection: local
  gather_facts: no
  tasks:
    - name: "Service (re)started"
      shell: sleep 2 && /bin/systemctl daemon-reload && sleep 2 && /bin/systemctl restart rke2-server
      async: 1
      poll: 0
      delegate_to: "{{ item }}"
      loop: "{{ groups['node'] }}"


