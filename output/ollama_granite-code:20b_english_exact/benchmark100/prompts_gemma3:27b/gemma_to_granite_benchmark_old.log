---
- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: "helm version --client"
  failed_when: false
  changed_when: false
  register: helm_existing_version

- name: Download Helm
  unarchive:
    src: "https://get.helm.sh/helm-v{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: "/tmp"
    remote_src: true
  when: not helm_check.stat.exists or helm_existing_version.stdout.find("v{{ helm_version }}") == -1
  register: helm_download

- name: Copy Helm binary into place
  copy:
    src: "/tmp/{{ helm_platform }}-{{ helm_arch }}/helm"
    dest: "{{ helm_bin_path }}"
    mode: "0755"
    remote_src: true
  when: helm_download.changed
  become: true


