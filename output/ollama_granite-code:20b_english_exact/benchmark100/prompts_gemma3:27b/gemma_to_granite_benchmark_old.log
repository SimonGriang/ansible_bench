---
- name: Task 1 - Enable Apache modules
  community.general.apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"

- name: Task 2 - Configure Apache locations
  template:
    src: location.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item.name }}.conf"
    mode: "0644"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  loop: "{{ httpd_locations }}"


