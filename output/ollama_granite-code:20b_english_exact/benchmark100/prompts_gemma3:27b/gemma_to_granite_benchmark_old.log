---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Enable redis module stream (RHEL 8)
  when:
    - ansible_os_family == "RedHat"
    - ansible_distribution_major_version | int == 8
  block:
    - name: Enable redis module stream
      ansible.builtin.dnf:
        name: "redis"
        state: present

- name: Install redis
  ansible.builtin.package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  ansible.builtin.template:
    src: "redis.conf-{{ ansible_distribution }}.j2"
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_user }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_configuration_file_mode }}"
  notify: Restart redis

- name: Start and enable redis
  ansible.builtin.service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes


