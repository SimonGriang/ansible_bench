---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/mailer_type
    value: 'No configuration'
    vtype: string
  when: ansible_os_family == 'Debian'
  tags: [always]

- name: Install postfix
  package:
    name: postfix
    state: present
  tags: [packages]

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined or postfix_virtual_domains is defined
  tags: [packages]

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: 0644
    owner: root
    group: root
    validate: '/usr/sbin/postmap -c %s'
  notify: validate postal configuration
  when: postfix_transport_maps_template is defined
  tags: [configuration,transport_maps]

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: 0644
    owner: root
    group: root
    validate: '/usr/sbin/postconf -c %s'
  notify: validate postal configuration
  when: postfix_header_checks_template is defined
  tags: [configuration,header_checks]

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_smtp_generic_maps: "{{ lookup('file', postfix_main_cf_smtp_generic_maps_source) }}"
  when: postfix_main_cf_smtp_generic_maps_source is defined
  tags: [always]

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf_smtp_generic_maps: []
  when: not postfix_main_cf_smtp_generic_maps_source is defined
  tags: [always]

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 0644
    owner: root
    group: root
    validate: '/usr/sbin/postconf -c %s'
  notify: validate postal configuration
  tags: [configuration,main.cf]

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: 0644
    owner: root
    group: root
    validate: '/usr/sbin/postconf -c %s'
  notify: validate postal configuration
  tags: [configuration,master.cf]

- name: Creates cert/key directory
  file:
    path: "{{ postfix_tls_cert_file | dirname }}"
    state: directory
    owner: root
    group: root
    mode: 0755
  when: postfix_tls_cert_file is defined or postfix_tls_key_file is defined
  tags: [tls,files]

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_cert_file }}"
    dest: /etc/postfix/server.crt
    mode: 0644
    owner: root
    group: root
  when: postfix_tls_cert_file is defined
  tags: [tls,files]

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_file }}"
    dest: /etc/postfix/server.key
    mode: 0600
    owner: root
    group: root
  when: postfix_tls_key_file is defined
  tags: [tls,files]

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
    mode: 0644
    owner: root
    group: root
    validate: 'newaliases -v -f %s'
  tags: [aliases,files]

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: 0644
    owner: root
    group: root
  when: postfix_sender_access is defined
  tags: [sender_access,files]

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: 0644
    owner: root
    group: root
  when: postfix_recipient_access is defined
  tags: [recipient_access,files]

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: /etc/postfix/sasl_password_map
    mode: 0640
    owner: root
    group: root
    force: false
  when: postfix_sasl_password_map is defined
  tags: [sasl_password_map,files]

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true
  tags: [service]


