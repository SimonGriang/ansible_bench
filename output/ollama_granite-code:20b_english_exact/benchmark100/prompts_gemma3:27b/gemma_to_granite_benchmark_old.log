---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  run_once: true
  when: ansible_connection is defined and not ansible_connection == "container" and bootstrap_wait_for_host

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.ping:

    - name: Verify sudo access
      ansible.builtin.command: sudo -v
      changed_when: false
  rescue:
    - name: Gather bootstrap facts
      ansible.builtin.setup:
      register: bootstrap_facts

    - name: Install bootstrap packages
      ansible.builtin.package:
        name: "{{ bootstrap_facts_packages | join(',') }}"
        state: present
      become: "{{ bootstrap_become }}"

- name: Gather ansible facts
  ansible.builtin.setup:
  when: not bootstrap_wait_for_host
  delegate_to: localhost
  run_once: true

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages | join(',') }}"
    state: present
  become: "{{ bootstrap_become }}"
  when: bootstrap_facts_packages | length > 0


