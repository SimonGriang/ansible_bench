asks: directories.yml\n  when: httpd_directories is defined\n  tags:\n    - directories\n\n- name: Task 11 - Flush handlers\n  meta: flush_handlers\n\n- name: Task 12 - Removing default html\n  file:\n    path: "{{ httpd_data_dir }}/index.html"\n    state: absent\n  when: httpd_remove_example\n  tags:\n    - example\n\n- name: Task 13 - Start and enable httpd\n  service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: true\n  tags:\n    - service' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-11T13:40:03.163631553Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17013900269, 'load_duration': 32281097, 'prompt_eval_count': 868, 'prompt_eval_duration': 672884401, 'eval_count': 693, 'eval_duration': 16306965056, 'model_name': 'granite-code:20b'} id='run--1676b54f-e328-47ba-9b45-3d7ae08254fa-0' usage_metadata={'input_tokens': 868, 'output_tokens': 693, 'total_tokens': 1561}
