---
- name: Check OS compatibility
  hosts: all
  tasks:
    - name: Verify if the system is Amazon Linux 2 or a RedHat-based distribution with major version 7, 8, or 9.
      assert:
        that:
          - ansible_distribution == "Amazon" and ansible_distribution_major_version == "2"
          - ansible_os_family == "RedHat" and ansible_distribution_major_version in ["7", "8", "9"]
        fail_msg: "Unsupported OS version."
        success_msg: "OS version is compatible."

- name: Install epel gpg key
  hosts: all
  tasks:
    - name: Install the EPEL GPG key using the variable epel_gpg_key and ensure it's present.
      rpm_key:
        key: "{{ epel_gpg_key }}"
        state: present

- name: Install epel-release package
  hosts: all
  tasks:
    - name: Install the epel-release package using the variable epel_url and ensure it's present. Notify the handler Update package cache after installation.
      yum:
        name: "{{ epel_url }}"
        state: present
      notify:
        - Update package cache

- name: Install epel-next-release package
  hosts: all
  tasks:
    - name: Install the epel-next-release package using the variable epel_next_url and ensure it's present, but only if the variable epel_next is true. Notify the handler Update package cache after installation.
      yum:
        name: "{{ epel_next_url }}"
        state: present
      notify:
        - Update package cache
      when: epel_next

handlers:
  - name: Update package cache
    yum:
      update_cache: yes


