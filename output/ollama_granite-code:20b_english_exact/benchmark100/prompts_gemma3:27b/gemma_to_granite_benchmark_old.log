  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes
- name: Task 7 - Flush handlers
  meta: flush_handlers
- name: Task 8 - Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'
