---
- name: Load variables for the OS
  include_vars:
    file: "{{ item }}"
    name: docker_tasks
  loop:
    - "{{ role_path }}/vars/{{ ansible_facts.os_family }}{{ ansible_facts.distribution_major_version }}.yml"
    - "{{ role_path }}/vars/{{ ansible_facts.os_family }}.yml"
    - "{{ role_path }}/vars/main.yml"
  tags:
    - always

- name: Include RedHat-specific setup tasks
  include_tasks: redhat.yml
  when: ansible_facts.os_family == "RedHat"
  tags:
    - redhat

- name: Include Debian-specific setup tasks
  include_tasks: debian.yml
  when: ansible_facts.os_family == "Debian"
  tags:
    - debian

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    update_cache: true
    cache_valid_time: "{{ docker_package_cache_valid_time }}"
  when:
    - docker_version.stdout is not defined or
      docker_version.stdout | version_compare('1.10.0', '<')
    - not ansible_facts.os_family == "RedHat" or
      ansible_facts.distribution == "Fedora"
    - not ansible_facts.os_family == "Debian" or
      ansible_facts.distribution == "Ubuntu"
  notify: restart docker
  ignore_errors: true
  tags:
    - packages

- name: Install Docker packages (with downgrade option)
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: true
    update_cache: true
    cache_valid_time: "{{ docker_package_cache_valid_time }}"
  when:
    - docker_version.stdout is defined and
      docker_version.stdout | version_compare('1.10.0', '>=')
    - ansible_facts.os_family == "RedHat" or
      ansible_facts.os_family == "Debian"
  notify: restart docker
  ignore_errors: true
  tags:
    - packages

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  when:
    - docker_install_compose_plugin
    - docker_version.stdout is not defined or
      docker_version.stdout | version_compare('1.10.0', '<')
    - not ansible_facts.os_family == "RedHat" or
      ansible_facts.distribution == "Fedora"
    - not ansible_facts.os_family == "Debian" or
      ansible_facts.distribution == "Ubuntu"
  notify: restart docker
  ignore_errors: true
  tags:
    - packages

- name: Install docker-compose-plugin (with downgrade option)
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: true
  when:
    - docker_install_compose_plugin
    - docker_version.stdout is defined and
      docker_version.stdout | version_compare('1.10.0', '>=')
    - ansible_facts.os_family == "RedHat" or
      ansible_facts.os_family == "Debian"
  notify: restart docker
  ignore_errors: true
  tags:
    - packages

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    owner: root
    group: root
    mode: 0755
  when: docker_daemon_options.keys() | length > 0
  tags:
    - config
    - docker_config

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options_json }}"
    dest: /etc/docker/daemon.json
    owner: root
    group: root
    mode: 0644
  when: docker_daemon_options.keys() | length > 0
  notify: restart docker
  tags:
    - config
    - docker_config

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: true
  tags:
    - docker_service

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose
  tags:
    - docker_compose

- name: Get docker group info using getent
  getent:
    database: group
    key: docker
  register: docker_group_info
  tags:
    - docker_users

- name: Check if there are any users to add to the docker group
  set_fact:
    at_least_one_user_to_modify: "{{ (docker_users | difference(docker_group_info.keys) | length != 0) or (docker_group_info.keys | difference(docker_users) | length != 0) }}"
  when: docker_users | length > 0
  tags:
    - docker_users

- name: Include docker-users tasks
  include_tasks: docker-users.yml
  when: docker_users | length > 0 and at_least_one_user_to_modify
  tags:
    - docker_users


