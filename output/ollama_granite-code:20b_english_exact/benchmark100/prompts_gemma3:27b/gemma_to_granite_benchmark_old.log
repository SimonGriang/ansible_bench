---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2 - Install fail2ban
  ansible.builtin.package:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Task 3 - Copy filters in filter.d
  ansible.builtin.copy:
    src: "{{ fail2ban_filterd_path }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: "0640"
  notify: Restart fail2ban
  when: fail2ban_filterd_path is defined

- name: Task 4 - Configure fail2ban.local
  ansible.builtin.ini_file:
    path: /etc/fail2ban/fail2ban.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: "0640"
    backup: true
  loop: "{{ fail2ban_base_configuration + fail2ban_configuration }}"
  notify: Restart fail2ban

- name: Task 5 - Configure jail.local
  ansible.builtin.ini_file:
    path: /etc/fail2ban/jail.local
    section: "[{{ item.section }}]"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: "0640"
    backup: true
  loop: "{{ fail2ban_base_jail_configuration + fail2ban_jail_configuration }}"
  notify: Restart fail2ban

- name: Task 6 - Stat auth log file
  ansible.builtin.stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Task 7 - Touch auth log file
  ansible.builtin.file:
    path: /var/log/auth.log
    state: touch
    mode: "0640"
  when: fail2ban_auth.stat.exists == false

- name: Task 8 - Start and enable fail2ban
  ansible.builtin.service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: true


