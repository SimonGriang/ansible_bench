    dest: /etc/aliases
    mode: 0644
    owner: root
    group: root
    validate: 'newaliases -v -f %s'
  tags: [aliases,files]

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: 0644
    owner: root
