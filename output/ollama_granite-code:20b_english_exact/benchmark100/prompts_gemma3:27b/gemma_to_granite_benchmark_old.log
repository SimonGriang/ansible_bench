---
- import_tasks: assert.yml
- name: Task 2 - Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec
- name: Task 3 - Configure mysql server
  ini_file:
    dest: /etc/mysql/{{ mysql_name }}/my.cnf
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0644
    no_extra_spaces: yes
    state: "{{ item.state }}"
  loop: "{{ mysql_configuration_options }}"
- name: Task 4 - Configure mysql client
  ini_file:
    dest: /etc/mysql/{{ mysql_name }}/my.cnf
    section: client
    option: socket
    value: /var/run/mysqld/{{ mysql_name }}.sock
    mode: 0644
    no_extra_spaces: yes
    state: present
- name: Task 5 - Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/{{ mysql_name }}/mysql
- name: Task 6 - Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes
- name: Task 7 - Flush handlers
  meta: flush_handlers
- name: Task 8 - Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640
- name: Task 9 - Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state | default(omit) }}"
    target: "{{ item.target | default(omit) }}"
    encoding: "{{ item.encoding | default(omit) }}"
    collation: "{{ item.collation | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"
- name: Task 10 - List databases
  mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  register: mysql_databases_list
- name: Task 11 - Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.target }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"
  when: item.target is defined and item.name not in mysql_databases_list.databases
- name: Task 12 - Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default(omit) }}"
    host: "{{ item.host | default(omit) }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"
- name: Task 13 - Flush handlers again
  meta: flush_handlers



