---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify: Set root password, Systemctl daemon-reexec

- name: Configure mysql server
  ini_file:
    path: /etc/mysql/{{ mysql_name }}/my.cnf
    section: server
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    mode: 0644
    no_extra_spaces: yes
    state: present
  loop: "{{ mysql_configuration_options|dict2items }}"
  notify: Restart mysql server

- name: Configure mysql client
  ini_file:
    path: /etc/mysql/{{ mysql_name }}/my.cnf
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    mode: 0644
    no_extra_spaces: yes
    state: present

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_os_family in [ "Alpine", "Archlinux" ]

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    encoding: "{{ item.encoding | default(omit) }}"
    collate: "{{ item.collate | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    state: present
    host: "{{ item.host | default(omit) }}"
    priv: "{{ item.priv | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


