---
- include_tasks: keepalived.yml
  when:
    - rke2_ha_mode | bool
    - groups[rke2_servers_group_name] is defined
    - rke2_api_ip is defined
    - inventory_hostname in groups[rke2_servers_group_name]
- include_tasks: rke2.yml
- include_tasks: cis.yml
  when:
    - rke2_cis_profile is defined
    - rke2_cis_profile | length > 0
- include_tasks: find_active_server.yml
- include_tasks: ipvs.yml
  when:
    - rke2_kubevip_ipvs_lb_enable | bool
    - groups[rke2_servers_group_name] is defined
    - rke2_ha_mode | bool
    - "keepalived_state is not defined"
- include_tasks: kubevip.yml
  when:
    - rke2_ha_mode | bool
    - rke2_kubevip_ipvs_lb_enable is not defined
    - groups[rke2_servers_group_name] | length > 0
- include_tasks: ingress-nginx.yml
  when:
    - rke2_ingress_nginx_values is defined
    - rke2_ingress_nginx_values | length > 0
- include_tasks: first_server.yml
  when:
    - groups[rke2_servers_group_name] is defined
    - (rke2_active_server is not defined or groups[rke2_cluster_group_name] | length == 1)
    - inventory_hostname == groups[rke2_servers_group_name][0]
- include_tasks: first_server_restore.yml
  when:
    - rke2_active_server is defined
    - (inventory_hostname == groups[rke2_servers_group_name][0] or inventory_hostname == rke2_active_server)
    - rke2_active_server_restore is defined
- include_tasks: download_kubeconfig.yaml
  when:
    - rke2_download_kubeconf | bool
    - groups[rke2_servers_group_name] is defined
    - inventory_hostname == groups[rke2_servers_group_name][0]
- include_tasks: remaining_nodes.yml
  when:
    - rke2_active_server is defined
    - groups[rke2_cluster_group_name] | length >= 2
- name: Rolling cordon and drain restart on servers
  include_tasks: rolling-restart.yml
  vars:
    rke2_service_group: "{{ rke2_servers_group_name }}"
    reason: "version changed to {{ rke2_version }}"
    when:
      - installed_version is defined
      - installed_version != rke2_version
  when:
    - rke2_ha_mode | bool
- name: Rolling cordon and drain restart on agents
  include_tasks: rolling-restart.yml
  vars:
    rke2_service_group: "{{ rke2_agents_group_name }}"
    reason: "version changed to {{ rke2_version }}"
    when:
      - installed_version is defined
      - installed_version != rke2_version
      - inventory_hostname not in groups[rke2_servers_group_name]
  when:
    - rke2_ha_mode | bool
- name: Flush handlers
  meta: flush_handlers
- name: Rolling restart when config files change
  include_tasks: rolling-restart.yml
  vars:
    rke2_service_group: "{{ rke2_cluster_group_name }}"
    reason: "config file has changed"
  when:
    - rke2_restart_needed | bool
- include_tasks: summary.yml


