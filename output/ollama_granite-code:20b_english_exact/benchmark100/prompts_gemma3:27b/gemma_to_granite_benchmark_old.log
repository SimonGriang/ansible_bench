---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- block:
    - name: Configure SELinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: true
      with_items: "{{ httpd_sebooleans }}"
      when: item.name is defined

    - name: Allow httpd port
      seport:
        ports: "{{ httpd_port | string }}
              {{ httpd_ssl_port | string }}"
        proto: tcp
        setype: httpd_port_t
        state: present
      when: httpd_port is defined or httpd_ssl_port is defined
  when: ansible_selinux.status == "enabled"

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify: Test and restart httpd

- block:
    - name: Activate httpd modules
      command: "a2enmod {{ item }}"
      loop: "{{ httpd_modules_to_activate_with_command }}"
      when: ansible_os_family == "Debian"
  when: httpd_modules_to_activate_with_command is defined

- import_tasks: ssl.yml
  when: https_ssl_enable | bool

- import_tasks: locations.yml
  when: httpd_locations is defined

- import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- block:
    - name: Configure httpd ports
      template:
        src: httpd_ports_conf.j2
        dest: "{{ httpd_ports_conf }}"
        mode: 0644
      notify: Test and restart httpd
  when:
    - ansible_os_family == "Debian" or ansible_os_family == "Suse"
  tags:
    - httpd_ports

- import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


