---
- import_tasks: assert.yml
- name: Wait for port to be available
  wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection is defined and not ansible_connection == 'container' and bootstrap_wait_for_host
- block:
  - name: Prepare system
    raw: test -e /usr/bin/python || ( {{ bootstrap_python_executable }} -m ensurepip && {{ bootstrap_python_executable }} -m pip install --upgrade pip && {{ bootstrap_python_executable }} -m pip install --upgrade setuptools )
    changed_when: false
    failed_when: false
  - name: Gather ansible facts
    setup:
  - name: Install bootstrap packages
    package:
      name: "{{ bootstrap_facts_packages }}"
      update_cache: true
      become: "{{ bootstrap_become }}"
  rescue:
  - name: Gather ansible facts
    setup:
  - name: Install bootstrap packages
    package:
      name: "{{ bootstrap_facts_packages }}"
      update_cache: true
      become: "{{ bootstrap_become }}"
  - name: Ensure libdnf5 is present on RedHat-based systems
    package:
      name: libdnf
      state: present
    when: ansible_os_family == "RedHat"



