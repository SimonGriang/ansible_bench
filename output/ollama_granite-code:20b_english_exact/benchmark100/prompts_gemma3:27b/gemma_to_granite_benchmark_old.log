---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present
  tags: dns

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_dirmode }}"
  with_items:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"
  tags: dns

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present
  tags: dns

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true
  tags: dns

- name: Generate rndc key
  command: rndc-confgen -a -o {{ dns_confdir }}/rndc.key
  args:
    creates: "{{ dns_confdir }}/rndc.key"
  notify: Rndc reload
  tags: dns

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: root
    group: "{{ dns_group }}"
    mode: 0640
  tags: dns

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints }}"
    dest: "{{ dns_datadir }}/root.hints"
    mode: 0644
    owner: root
    group: "{{ dns_group }}"
  when: dns_caching_dns
  notify: Rndc reload
  tags: dns

- name: Create zone file
  template:
    src: named.j2
    dest: "{{ dns_datadir }}/{{ item.zone }}"
    owner: root
    group: "{{ dns_group }}"
    mode: 0640
  with_items: "{{ dns_zones }}"
  notify: Rndc reload
  tags: dns

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    owner: root
    group: root
    mode: 0644
  notify: Restart dns
  tags: dns

- name: Place systemd override
  copy:
    dest: /etc/systemd/system/{{ dns_service }}.service.d/override.conf
    content: |
      [Service]
      ExecStart=
      ExecStart=/usr/sbin/named -f -g
  notify: Reload systemd daemon
  when: ansible_os_family == "Debian"
  tags: dns

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true
  tags: dns


