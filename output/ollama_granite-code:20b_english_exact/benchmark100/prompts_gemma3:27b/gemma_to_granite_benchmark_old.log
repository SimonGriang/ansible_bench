---
- name: Set java_jdk_vendor fact
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Include OS specific variables
  include_vars: "{{ item }}"
  with_first_found:
    - files:
        - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
        - "{{ java_jdk_vendor }}-{{ ansible_distribution }}.yml"
        - "{{ java_jdk_vendor }}.yml"
      skip: true
  tags:
    - always

- name: Include architecture specific variables
  include_vars: "{{ item }}"
  with_first_found:
    - files:
        - architecture.yml
      skip: true
  tags:
    - always

- name: Set OS specific variables
  set_fact:
    java_open_jdk_version: "{{ java_open_jdk_version_default }}"
    java_open_jdk_apt_extra_packages: []
    java_open_jdk_apt_key_repositories: "{{ java_required_key_repositories_openjdk }}"
    java_open_jdk_apt_repositories: "{{ java_required_repositories_openjdk }}"
    java_open_jdk_home_dir: "/opt/java"
    java_open_jdk_package: "openjdk"
    java_open_jdk_required_libs: []
  when: java_jdk_vendor == "openjdk"
  tags:
    - always

- name: Set OS and architecture specific variables
  set_fact:
    java_open_jdk_home_dir: "/usr/lib/jvm/java"
    java_open_jdk_package: "java-1.8.0-openjdk"
  when:
    - java_jdk_vendor == "openjdk"
    - java_open_jdk_version == "8"
    - ansible_architecture == "x86_64"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Remove deprecated repositories
  apt_repository:
    repo: "{{ item }}"
    state: absent
  with_items: "{{ java_deprecated_repositories_adoptopenjdk }}"
  when:
    - java_jdk_vendor == "adoptopenjdk"
    - ansible_os_family == "Debian"

- name: Install extra apt tools
  apt:
    name: "{{ item }}"
    state: present
  with_items: "{{ java_open_jdk_apt_extra_packages }}"
  when:
    - java_jdk_vendor == "openjdk"
    - ansible_os_family == "Debian"

- name: Add required key repositories
  apt_key:
    url: "{{ item }}"
    state: present
  with_items: "{{ java_open_jdk_apt_key_repositories }}"
  when:
    - java_jdk_vendor == "openjdk"
    - ansible_os_family == "Debian"

- name: Add required repositories
  apt_repository:
    repo: "{{ item }}"
    state: present
  with_items: "{{ java_open_jdk_apt_repositories }}"
  when:
    - java_jdk_vendor == "openjdk"
    - ansible_os_family == "Debian"


