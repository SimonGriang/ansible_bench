---
- name: Run git setup tasks
  hosts: all
  tasks:
    - import_tasks: assert.yml
    - name: Install git
      package:
        name: "{{ git_packages }}"
        state: present
    - name: See if the specified user exists
      getent:
        database: passwd
        key: "{{ git_username }}"
      register: user_check
      failed_when: user_check.failed and fail_key|default(true)
    - name: Create directory for git configuration
      file:
        path: /home/{{ git_username }}
        state: directory
        owner: "{{ git_username }}"
        group: "{{ git_username }}"
        mode: 0755
    - name: Place git configuration
      template:
        src: gitconfig.j2
        dest: /home/{{ git_username }}/.gitconfig
        owner: "{{ git_username }}"
        group: "{{ git_username }}"
        mode: 0644
    - name: Create repository_destination
      file:
        path: "{{ git_repository_destination }}"
        state: directory
        owner: "{{ git_username }}"
        group: "{{ git_username }}"
        mode: 0755
    - name: Clone all roles
      become: "{{ git_ become_for_clone }}"
      become_user: "{{ git_username }}"
      git:
        repo: "{{ item.url }}"
        dest: "{{ git_repository_destination }}/{{ item.dest | default(item.url | urlsplit('path') | basename) }}"
        version: "{{ item.version | defaultomit }}"
        force: "{{ item.force | defaultomit }}"
      loop: "{{ git_repositories }}"
      loop_control:
        label: "Cloning {{ item.dest | default(item.url | urlsplit('path') | basename) }} into {{ git_repository_destination }}"


