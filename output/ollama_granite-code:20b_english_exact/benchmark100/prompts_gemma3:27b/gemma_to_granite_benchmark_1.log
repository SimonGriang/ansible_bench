  command: "ansible-playbook rolling-restart.yml -i {{ rke2_cluster_group_name }} --extra-vars '{\"rke2_drain_timeout\":{{ rke2_drain_timeout }},\"rke2_server_group_name\":\"{{ rke2_servers_group_name }}\",\"rke2_version\":\"{{ rke2_version }}\"}'"
