---
- name: Remove old Docker packages
  yum:
    name: "{{ docker_obsolete_packages }}"
    state: absent
  tags:
    - docker-package-clean

- name: Add Docker GPG key
  rpm_key:
    key: "{{ docker_yum_gpg_key }}"
    state: present
  when: docker_add_repo
  tags:
    - docker-gpg-key

- name: Add Docker repository
  copy:
    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    content: |
      [docker-{{ docker_edition }}]
      name=Docker {{ docker_edition }} Repository
      baseurl={{ docker_yum_repo_url }}
      enabled=1
      gpgcheck=1
      gpgkey={{ docker_yum_gpg_key }}
      [docker-{{ docker_edition }}-nightly]
      name=Docker {{ docker_edition }} Nightly Repository
      baseurl={{ docker_yum_repo_url }}
      enabled={{ docker_yum_repo_enable_nightly }}
      gpgcheck=1
      gpgkey={{ docker_yum_gpg_key }}
      [docker-{{ docker_edition }}-test]
      name=Docker {{ docker_edition }} Test Repository
      baseurl={{ docker_yum_repo_url }}
      enabled={{ docker_yum_repo_enable_test }}
      gpgcheck=1
      gpgkey={{ docker_yum_gpg_key }}
  when: docker_add_repo
  tags:
    - docker-repository

- name: Configure containerd on RHEL 8
  block:
    - name: Ensure runc is uninstalled
      yum:
        name: runc
        state: absent
      tags:
        - containerd-clean

    - name: Ensure container-selinux is installed
      yum:
        name: container-selinux
        state: present
      tags:
        - containerd-package

    - name: Ensure containerd.io is installed
      yum:
        name: containerd.io
        state: present
      tags:
        - containerd-package
  when: ansible_facts.distribution_major_version == 8
  tags:
    - containerd-package
    - containerd-clean




