---

- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2 - Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Task 3 - Create directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ item.mode }}"
  loop:
    - path: "{{ dns_datadir }}"
      mode: "{{ dns_datadir_mode | default(0755) }}"
    - path: "{{ dns_confdir }}"
      mode: "{{ dns_confdir_mode | default(0755) }}"

- name: Task 4 - Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Task 5 - Create user
  ansible.builtin.user:
    name: "{{ dns_owner }}"
    state: present
    system: true

- name: Task 6 - Generate rndc key
  ansible.builtin.command: rndc-confgen -a -b 512 -c {{ dns_confdir }}/rndc.key
  args:
    creates: "{{ dns_confdir }}/rndc.key"
  notify: Rndc reload

- name: Task 7 - Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: root
    group: "{{ dns_group }}"
    mode: "0640"

- name: Task 8 - Get the hints/root file
  ansible.builtin.get_url:
    url: https://www.internic.net/domain/named.cache
    dest: "{{ dns_datadir }}/root.hints"
    mode: "0644"
    owner: root
    group: "{{ dns_group }}"
  when: dns_caching_dns
  notify: Rndc reload

- name: Task 9 - Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.zone"
    mode: "0644"
    owner: root
    group: "{{ dns_group }}"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Task 10 - Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    validate: named-checkconf -z -f %s
    backup: true
  notify: Restart dns

- name: Task 11 - Place systemd override
  ansible.builtin.copy:
    dest: /etc/systemd/system/dns.service.d/override.conf
    content: |
      [Service]
      Restart=on-failure
  notify: reload systemd
  when: ansible_service_mgr == "systemd"

- name: Task 12 - Start and enable dns
  ansible.builtin.service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


