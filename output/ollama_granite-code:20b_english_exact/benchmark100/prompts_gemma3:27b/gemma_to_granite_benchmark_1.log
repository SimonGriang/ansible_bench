content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  delegate_to: localhost\n  run_once: true\n\n- name: Install cron\n  package:\n    name: "{{ cron_packages }}"\n    state: present\n\n- name: Configure shell\n  lineinfile:\n    path: "{{ cron_configuration }}"\n    line: "SHELL={{ cron_shell }}"\n    create: true\n    mode: 0600\n    notify: Restart cron\n\n- name: Configure path\n  lineinfile:\n    path: "{{ cron_configuration }}"\n    line: "PATH={{ cron_path }}"\n    create: true\n    mode: 0600\n    notify: Restart cron\n\n- name: Configure mailto\n  lineinfile:\n    path: "{{ cron_configuration }}"\n    line: "MAILTO={{ cron_mailto }}"\n    create: true\n    mode: 0600\n    notify: Restart cron\n\n- name: Start and enable cron\n  service:\n    name: "{{ cron_service }}"\n    state: started\n    enabled: true\n  when: cron_service | length > 0\n\n- name: Schedule requested cron jobs\n  cron:\n    name: "{{ item.name }}"\n    minute: "{{ item.minute | default(omit) }}"\n    hour: "{{ item.hour | default(omit) }}"\n    day: "{{ item.day | default(omit) }}"\n    month: "{{ item.month | default(omit) }}"\n    weekday: "{{ item.weekday | default(omit) }}"\n    special_time: "{{ item.special_time | default(omit) }}"\n    job: "{{ item.job }}"\n    state: "{{ item.state | default(omit) }}"\n    user: "{{ item.user | default(omit) }}"\n  loop: "{{ cron_jobs }}"\n  loop_control:\n    label: "{{ item.name }}"\n  when: cron_jobs is defined\n```' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-21T13:19:03.463305306Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8921253209, 'load_duration': 29424911, 'prompt_eval_count': 733, 'prompt_eval_duration': 556802859, 'eval_count': 402, 'eval_duration': 8333796051, 'model_name': 'granite-code:20b'} id='run--edd7f32b-d20a-4efd-8e7b-5eb1e721ccba-0' usage_metadata={'input_tokens': 733, 'output_tokens': 402, 'total_tokens': 1135}
