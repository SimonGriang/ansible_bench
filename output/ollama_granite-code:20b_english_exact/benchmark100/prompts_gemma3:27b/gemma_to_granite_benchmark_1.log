---
- name: Create Vault directories
  become: true
  block:
    - name: Create group
      group:
        name: "{{ vault_group }}"
        state: present

    - name: Create user
      user:
        name: "{{ vault_user }}"
        group: "{{ vault_group }}"
        shell: "{{ vault_user_shell }}"
        create_home: no

    - name: Create download directory
      file:
        path: "{{ vault_download_path }}"
        state: directory
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: "0755"

    - name: Download Vault
      unarchive:
        src: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
        dest: "{{ vault_download_path }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"

    - name: Stat vault path
      stat:
        path: "{{ vault_path }}"
      register: vault_check_path

    - name: Create vault_path if it does not exists
      file:
        path: "{{ vault_path }}"
        state: directory
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: "0755"
      when:
        - not vault_check_path.stat.exists
        - vault_path | length > 0

    - name: Create directories in vault_path
      file:
        path: "{{ vault_path }}/{{ item.path }}"
        state: directory
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_directories }}"

    - name: Create data directories in vault_path
      file:
        path: "{{ vault_path }}/{{ item.path }}"
        state: directory
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_data_directories }}"

    - name: Generate TLS key and certificate
      command: "openssl req -newkey rsa:2048 -nodes -keyout tls.key -x509 -days 365 -out tls.crt -subj \"/CN={{ ansible_hostname }}\""
      args:
        chdir: "{{ vault_data_directory }}/tls/"
      notify: Restart vault

    - name: Set ownership of tls material
      file:
        path: "{{ vault_data_directory }}/tls/{{ item }}"
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: "{{ vault_tls_file_mode }}"
      loop: "{{ vault_tls_files }}"

    - name: Copy Vault binary
      copy:
        src: "{{ vault_download_path }}/vault"
        dest: /usr/bin/vault
        owner: root
        group: root
        mode: "0755"
      notify: Restart vault

    - name: Set cap_ipc_lock=ep on /usr/bin/vault
      capabilities:
        path: /usr/bin/vault
        capability: cap_ipc_lock=ep
        state: present

    - name: Touch vault.env
      file:
        path: "{{ vault_path }}/etc/vault.d/vault.env"
        state: file
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: "0644"
        modification_time: preserve
        access_time: preserve
      notify: Restart vault

    - name: Create /usr/lib/systemd/system
      file:
        path: /usr/lib/systemd/system
        state: directory
        owner: root
        group: root
        mode: "0755"

    - name: Copy Vault service file
      template:
        src: vault.service.j2
        dest: /usr/lib/systemd/system/vault.service
        owner: root
        group: root
        mode: "0644"
      when: vault_service_manager == "systemd"
      notify: Daemon reload

    - name: Copy vault configuration
      template:
        src: vault.hcl
        dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
        owner: root
        group: root
        mode: "0644"
      notify: Restart vault

    - name: Flush handlers
      meta: flush_handlers


