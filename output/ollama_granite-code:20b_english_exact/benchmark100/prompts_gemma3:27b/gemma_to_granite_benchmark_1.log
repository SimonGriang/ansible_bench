---

- name: Manage group
  ansible.builtin.group:
    name: "{{ group.name }}"
    state: "{{ group.state | default('present') }}"
    gid: "{{ group.gid | default(omit) }}"
    system: "{{ group.system | default(omit) }}"

- name: Set sudo options for group
  ansible.builtin.template:
    src: sudo_group.j2
    dest: "/etc/sudoers.d/{{ group.name | replace('.', 'dot') }}"
    mode: "0640"
  loop: "{{ group.sudo_options }}"
  loop_control:
    label: "{{ group.name }}"
  when: group.sudo_options is defined


