    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ item.mode | default(0755) }}"
  loop:
    - path: "{{ dns_datadir }}"
      mode: "{{ dns_datadir_mode | default(0755) }}"
    - path: "{{ dns_confdir }}"
      mode: "{{ dns_confdir_mode | default(0755) }}"

- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  ansible.builtin.user:
    name: "{{ dns_owner }}"
    state: present
    system: true

- name: Generate rndc key
  ansible.builtin.command: rndc-confgen -a -b 512 -c {{ dns_confdir }}/rndc.key
  args:
    creates: "{{ dns_confdir }}/rndc.key"
  notify: Rndc reload

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: root
    group: "{{ dns_group }}"
    mode: "0640"

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: https://www.internic.net/domain/named.cache
    dest: "{{ dns_datadir }}/root.hints"
    mode: "0644"
    owner: root
    group: "{{ dns_group }}"
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.zone"
    mode: "0644"
    owner: root
    group: "{{ dns_group }}"
  loop: "{{ dns_zones }}"
