---
- name: "Java"
  tasks:
    - name: "Set the java_jdk_vendor fact to 'temurin' if it's currently set to 'adoptopenjdk'"
      set_fact:
        java_jdk_vendor: "temurin"
      when: java_jdk_vendor == "adoptopenjdk"

    - name: "Include OS specific variables"
      include_vars: "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
      when: java_jdk_vendor != "adoptopenjdk"

    - name: "Include architecture specific variables"
      include_vars: "architecture.yml"

    - name: "Set OS specific variables (I)"
      set_fact:
        java_open_jdk_version: "{{ java_open_jdk_version | default('11') }}"
        java_open_jdk_apt_extra_packages: "{{ java_open_jdk_apt_extra_packages | default([]) }}"
        java_open_jdk_apt_repositories: "{{ java_open_jdk_apt_repositories | default([]) }}"
        java_open_jdk_apt_key_repositories: "{{ java_open_jdk_apt_key_repositories | default([]) }}"
        java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/java-11-openjdk-{{ java_architecture }}') }}"
        java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-11-jdk') }}"

    - name: "Set OS and architecture specific variables (II)"
      set_fact:
        java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/java-11-openjdk-{{ java_architecture }}') }}"
        java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-11-jdk') }}"

    - name: "Set specific variables"
      set_fact:
        java_home: "{{ java_open_jdk_home }}"

    - name: "Remove deprecated repositories (Debian)"
      apt_repository:
        state: absent
        repo: "{{ item.repo }}"
      loop: "{{ java_deprecated_repositories_adoptopenjdk }}"
      when: ansible_os_family == "Debian"

    - name: "Install extra apt tools (Debian)"
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ java_open_jdk_apt_extra_packages }}"
      when: ansible_os_family == "Debian" and java_open_jdk_apt_extra_packages | length > 0

    - name: "Add required key repositories (Debian)"
      apt_key:
        keyserver: "{{ item.server }}"
        id: "{{ item.id }}"
      loop: "{{ java_required_key_repositories_openjdk }}"
      register: java_required_key_repositories_added
      until: java_required_key_repositories_added is succeeded
      when: ansible_os_family == "Debian" and java_required_key_repositories_openjdk | length > 0

    - name: "Add required repositories (Debian)"
      apt_repository:
        filename: "java"
        repo: "deb {{ item.repo }} {{ ansible_distribution_release }} main"
        state: present
      loop: "{{ java_required_repositories_openjdk }}"
      register: java_required_repositories_added
      until: java_required_repositories_added is succeeded
      when: ansible_os_family == "Debian" and java_required_repositories_openjdk | length > 0

    - name: "Add required key repositories (RedHat)"
      rpm_key:
        key: "{{ item.id }}"
        keyserver: "{{ item.server }}"
        state: present
      loop: "{{ java_required_key_repositories_openjdk }}"
      register: java_required_key_repositories_added
      until: java_required_key_repositories_added is succeeded
      when: ansible_os_family == "RedHat" and java_required_key_repositories_openjdk | length > 0

    - name: "Add required repositories (RedHat)"
      yum_repository:
        name: "java"
        description: "Java"
        baseurl: "{{ item.repo }}"
        gpgcheck: yes
        gpgkey: "{{ item.id }}"
      loop: "{{ java_required_repositories_openjdk }}"
      register: java_required_repositories_added
      until: java_required_repositories_added is succeeded
      when: ansible_os_family == "RedHat" and java_required_repositories_openjdk | length > 0

    - name: "Install required libs"
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ java_required_libs_openjdk }}"
      register: java_required_libs_installed
      until: java_required_libs_installed is succeeded

    - name: "Install Java (Debian)"
      apt:
        name: "{{ java_open_jdk_package }}"
        state: present
        update_cache: yes
      when: ansible_os_family == "Debian"

    - name: "Install Java (RedHat)"
      yum:
        name: "{{ java_open_jdk_package }}"
        state: present
      when: ansible_os_family == "RedHat"

    - name: "Export environment variables"
      template:
        src: jdk.sh.j2
        dest: /etc/profile.d/jdk.sh
        owner: root
        group: root
        mode: 0644
      when: java_create_profile_file | bool

    - name: "Source environment variables"
      shell: "source /etc/profile"
      args:
        executable: /bin/bash
      when: java_create_profile_file | bool

    - name: "Correct java version selected (Debian, Java < 11)"
      command: update-alternatives --set java /usr/lib/jvm/java-1.8.0-openjdk-amd64/jre/bin/java
      when: ansible_os_family == "Debian" and java_open_jdk_version | version_compare('11', '<')

    - name: "Correct java version selected (Debian, Java >= 11)"
      command: update-alternatives --set java /usr/lib/jvm/java-11-openjdk-amd64/bin/java
      when: ansible_os_family == "Debian" and java_open_jdk_version | version_compare('11', '>=')
