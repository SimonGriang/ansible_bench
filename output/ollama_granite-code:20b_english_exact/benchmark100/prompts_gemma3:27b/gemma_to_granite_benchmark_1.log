---
- name: "Harden Vault"
  hosts: "localhost"
  gather_facts: False

  tasks:
    - name: "Delete 'vault' from shell history"
      lineinfile:
        regexp: "^vault"
        state: "absent"
        path: "/root/.bash_history"
      become: True

    - name: "Set file permissions for /root/.bash_history"
      file:
        path: "/root/.bash_history"
        mode: "0644"
        owner: "root"
        group: "root"
      become: True

    - name: "Configure SELinux / AppArmor"
      block:
        - name: "Install selinux-policy package"
          package:
            name: "selinux-policy"
            state: "present"
          become: True

        - name: "Set SELinux policy to 'targeted' and state to 'enforcing'"
          selinux:
            policy: "targeted"
            state: "enforcing"
          become: True
      when: "vault_hardening_configure_selinux_apparmor and ansible_selinux.status == 'enabled'"

      block:
        - name: "Install apparmor-parser package"
          package:
            name: "apparmor-parser"
            state: "present"
          become: True

        - name: "Load AppArmor profiles"
          command: "apparmor_parser -r /etc/apparmor.d/usr.sbin.vaultd"
          become: True
      when: "ansible_apparmor.status == 'enabled'"


