    - proxy_http
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"
  tags:
    - apache

- name: Task 2
  become: true
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item.name }}"
    mode: "0644"
  loop: "{{ httpd_locations }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  tags:
    - apache


