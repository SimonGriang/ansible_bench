---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost
- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
  - Set root password
  - Systemctl daemon-reexec
- name: Configure mysql server
  template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: /etc/mysql/conf.d/{{ mysql_name }}-server.cnf
    mode: 0644
    owner: root
    group: root
  notify: Restart mysql server
  no_log: true
- name: Configure mysql client
  template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: /etc/mysql/conf.d/{{ mysql_name }}-client.cnf
    mode: 0644
    owner: root
    group: root
  no_log: true
- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_os_family in ["Alpine", "Archlinux"]
- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true
- name: Flush handlers
  meta: flush_handlers
- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640
- name: Create databases
  mysql_db:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
    name: "{{ item.name }}"
    state: present
  with_items: "{{ mysql_databases }}"
- name: Create users
  mysql_user:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items: "{{ mysql_users }}"
- name: Flush handlers again
  meta: flush_handlers


