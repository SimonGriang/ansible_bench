content='---\n- name: Download RKE2 kubeconfig to localhost\n  hosts: localhost\n  tasks:\n    - name: Download RKE2 kubeconfig\n      fetch:\n        src: /etc/rancher/rke2/rke2.yaml\n        dest: "{{ rke2_download_kubeconf_path | mandatory }}/{{ rke2_download_kubeconf_file_name | mandatory }}"\n        flat: yes\n      when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]\n\n- name: Replace loopback IP by master server IP\n  hosts: localhost\n  tasks:\n    - name: Replace loopback IP by master server IP\n      replace:\n        path: "{{ rke2_download_kubeconf_path | mandatory }}/{{ rke2_download_kubeconf_file_name | mandatory }}"\n        regexp: \'127.0.0.1|([0-9a-fA-F]*):([0-9a-fA-F]*):([0-9a-fA-F]*):([0-9a-fA-F]*)/127.0.0.1|([0-9a-fA-F]*):([0-9a-fA-F]*):([0-9a-fA-F]*):([0-9a-fA-F]*)\'\n        replace: "{{ rke2_api_ip | default(groups[rke2_servers_group_name][0]) }}"\n        delegate_to: localhost\n        become: false\n        ansible_check_mode: yes\n        when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-21T12:33:31.797509557Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8198235615, 'load_duration': 29688976, 'prompt_eval_count': 667, 'prompt_eval_duration': 427245034, 'eval_count': 375, 'eval_duration': 7740579401, 'model_name': 'granite-code:20b'} id='run--4ee37248-760d-40ac-8b02-9c2a6dee1e7e-0' usage_metadata={'input_tokens': 667, 'output_tokens': 375, 'total_tokens': 1042}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Download RKE2 kubeconfig to localhost
  hosts: localhost
  tasks:
    - name: Download RKE2 kubeconfig
      fetch:
        src: /etc/rancher/rke2/rke2.yaml
        dest: "{{ rke2_download_kubeconf_path | mandatory }}/{{ rke2_download_kubeconf_file_name | mandatory }}"
        flat: yes
      when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]

- name: Replace loopback IP by master server IP
  hosts: localhost
  tasks:
    - name: Replace loopback IP by master server IP
      replace:
        path: "{{ rke2_download_kubeconf_path | mandatory }}/{{ rke2_download_kubeconf_file_name | mandatory }}"
        regexp: '127.0.0.1|([0-9a-fA-F]*):([0-9a-fA-F]*):([0-9a-fA-F]*):([0-9a-fA-F]*)/127.0.0.1|([0-9a-fA-F]*):([0-9a-fA-F]*):([0-9a-fA-F]*):([0-9a-fA-F]*)'
        replace: "{{ rke2_api_ip | default(groups[rke2_servers_group_name][0]) }}"
        delegate_to: localhost
        become: false
        ansible_check_mode: yes
        when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]


