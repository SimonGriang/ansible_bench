- name: Task 5
  ansible.builtin.template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'
    notify: Restart nginx

- name: Task 6
  ansible.builtin.service:
    name: nginx
    state: started
    enabled: true


