---
- name: Create RKE2 directories and files
  hosts: all
  tasks:
    - name: Create RKE2 config directory
      file:
        path: /etc/rancher/rke2
        state: directory
        mode: '0755'

    - name: Set server taints
      set_fact:
        combined_node_taints: "{{ rke2_server_node_taints }}"
      when: rke2_type == 'server'

    - name: Set agent taints
      set_fact:
        combined_node_taints: "{{ rke2_agent_node_taints }}"
      when: rke2_type == 'agent'

    - name: Copy RKE2 config
      template:
        src: rke2.yaml.j2
        dest: /etc/rancher/rke2/rke2.yaml
        mode: '0644'
        owner: root
        group: root
      notify: restart rke2 service

    - name: Copy kubelet config
      template:
        src: kubelet.conf.j2
        dest: /var/lib/rke2/agent/etc/kubelet/kubelet-config.yaml
        mode: '0644'
        owner: root
        group: root
      when: rke2_kubelet_config | length > 0
      notify: restart rke2 service

    - name: Copy Containerd Registry Configuration file
      template:
        src: containerd-registry.conf.j2
        dest: /etc/rancher/rke2/agent/etc/containerd/registry.toml
        mode: '0644'
        owner: root
        group: root
      when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
      notify: restart rke2 service

    - name: Start RKE2 service on the rest of the nodes
      systemd:
        name: rke2-server.service
        state: started
        enabled: yes
      environment:
        RKE2_TOKEN: "{{ rke2_token }}"
      retries: 10
      delay: 20
      register: result
      until: result is succeeded
      notify: restart rke2 service

    - name: Mask other RKE2 service on the rest of the nodes
      systemd:
        name: "{{ item }}"
        enabled: no
        masked: yes
      loop:
        - rke2-agent.service
        - rke2-server.service
      when: rke2_type == 'server'

    - name: Wait for remaining nodes to be ready - no CNI
      shell: >
        kubectl wait --for=condition=MemoryPressure --for=condition=DiskPressure --for=condition=PIDPressure --for=condition=Ready node --all;
        while [ "$(kubectl get node | tail -n +2 | grep -c NotReady)" != "0" ]; do echo "Waiting for all nodes to be ready


