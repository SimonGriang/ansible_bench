---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Pre-configure debian systems
  become: true
  become_method: sudo
  when: ansible_os_family == "Debian"
  debconf:
    name: postfix
    question: postfix/mailer_type
    value: "No configuration"
    vtype: string

- name: Install postfix
  become: true
  become_method: sudo
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  become: true
  become_method: sudo
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined or postfix_virtual_domains is defined

- name: Configure postfix (transport_maps)
  become: true
  become_method: sudo
  template:
    src: "transport_maps.j2"
    dest: "{{ postfix_transport_maps }}"
    mode: "0644"
    owner: root
    group: root
  notify:
    - restart postfix
    - rebuild postfix database
  when: postfix_transport_maps is defined

- name: Configure postfix (header_checks)
  become: true
  become_method: sudo
  template:
    src: "header_checks.j2"
    dest: "{{ postfix_header_checks }}"
    mode: "0644"
    owner: root
    group: root
  notify:
    - restart postfix
    - reload postfix
  when: postfix_header_checks is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_smtp_sasl_auth_enable: "{{ postfix_smtp_sasl_auth_enable | default(omit) }}"
    postfix_main_cf_relayhost: "{{ postfix_relayhost | default(omit) }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf_smtp_sasl_password: "{{ postfix_smtp_sasl_password | default(omit) }}"
    postfix_main_cf_smtp_sasl_user: "{{ postfix_smtp_sasl_user | default(omit) }}"
    postfix_main_cf_smtp_tls_ca_file: "{{ postfix_smtp_tls_ca_file | default(omit) }}"
    postfix_main_cf_smtp_tls_cert_file: "{{ postfix_smtp_tls_cert_file | default(omit) }}"
    postfix_main_cf_smtp_tls_key_file: "{{ postfix_smtp_tls_key_file | default(omit) }}"
    postfix_main_cf_smtp_tls_note_starttls: "{{ postfix_smtp_tls_note_starttls | default(omit) }}"
    postfix_main_cf_smtp_use_tls: "{{ postfix_smtp_use_tls | default(omit) }}"
    postfix_main_cf_smtp_sasl_mechanism: "{{ postfix_smtp_sasl_mechanism | default(omit) }}"

- name: Configure postfix (main.cf)
  become: true
  become_method: sudo
  template:
    src: "main.cf.j2"
    dest: "{{ postfix_main_cf }}"
    mode: "0644"
    owner: root
    group: root
  notify:
    - restart postfix
    - reload postfix
  when: postfix_main_cf is defined

- name: Configure postfix (master.cf)
  become: true
  become_method: sudo
  template:
    src: "master.cf.j2"
    dest: "{{ postfix_master_cf }}"
    mode: "0644"
    owner: root
    group: root
  notify:
    - restart postfix
    - reload postfix
  when: postfix_master_cf is defined

- name: Creates cert/key directory
  become: true
  become_method: sudo
  file:
    path: "{{ postfix_tls_cert_file | dirname }}"
    state: directory
    owner: root
    group: root
    mode: "0755"
  when: postfix_smtp_tls_cert_file is defined and postfix_smtp_tls_key_file is defined

- name: Deploy Postfix TLS server certificate
  become: true
  become_method: sudo
  copy:
    src: "{{ postfix_smtp_tls_cert_file }}"
    dest: "{{ postfix_tls_cert_file }}"
    mode: "0644"
    owner: postfix
    group: postfix
  when: postfix_smtp_tls_cert_file is defined and postfix_smtp_tls_key_file is defined

- name: Deploy Postfix TLS server key
  become: true
  become_method: sudo
  copy:
    src: "{{ postfix_smtp_tls_key_file }}"
    dest: "{{ postfix_tls_key_file }}"
    mode: "0600"
    owner: postfix
    group: postfix
  when: postfix_smtp_tls_cert_file is defined and postfix_smtp_tls_key_file is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  become: true
  become_method: sudo
  template:
    src: "aliases.j2"
    dest: "{{ postfix_aliases }}"
    mode: "0644"
    owner: root
    group: root
  when: postfix_aliases is defined

- name: Configure sender_access
  become: true
  become_method: sudo
  template:
    src: "sender_access.j2"
    dest: "{{ postfix_sender_access }}"
    mode: "0644"
    owner: root
    group: root
  when: postfix_sender_access is defined

- name: Configure recipient_access
  become: true
  become_method: sudo
  template:
    src: "recipient_access.j2"
    dest: "{{ postfix_recipient_access }}"
    mode: "0644"
    owner: root
    group: root
  when: postfix_recipient_access is defined

- name: Place sasl_password_map
  become: true
  become_method: sudo
  copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: "{{ postfix_sasl_password_map_file }}"
    owner: root
    group: root
    mode: "0600"
  when: postfix_sasl_password_map is defined

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  become: true
  become_method: sudo
  service:
    name: postfix
    state: started
    enabled: true


