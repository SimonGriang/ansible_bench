---

- name: Check OS compatibility
  hosts: all
  tasks:
    - name: Verify if the system is Amazon Linux 2 or a RedHat-based distribution with major version 7, 8, or 9
      assert:
        that:
          - ((ansible_distribution == "Amazon") and (ansible_distribution_major_version == "2")) or
            ((ansible_os_family == "RedHat") and (ansible_distribution_major_version | int in [7, 8, 9]))
        msg: "Unsupported OS version"

- name: Install epel gpg key
  hosts: all
  tasks:
    - name: Install the EPEL GPG key
      rpm_key:
        key: "{{ epel_gpg_key }}"
        state: present

- name: Install epel-release package
  hosts: all
  tasks:
    - name: Install the epel-release package
      yum:
        name: "{{ epel_url }}"
        state: present
      notify:
        - Update package cache
  handlers:
    - name: Update package cache
      yum:
        update_cache: yes

- name: Install epel-next-release package
  hosts: all
  tasks:
    - name: Install the epel-next-release package
      yum:
        name: "{{ epel_next_url }}"
        state: present
      notify:
        - Update package cache
      when: epel_next
  handlers:
    - name: Update package cache
      yum:
        update_cache: yes


