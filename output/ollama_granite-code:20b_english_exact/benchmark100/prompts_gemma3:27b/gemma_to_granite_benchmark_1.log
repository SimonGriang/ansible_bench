---
- import_tasks: assert.yml
- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - "Set root password"
    - "Systemctl daemon-reexec"
- name: Configure mysql server
 ini_file:
    dest: /etc/mysql/mysql.conf.d/{{ mysql_name }}-server.cnf
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0644
    no_extra_spaces: yes
    state: "{{ item.state | default(omit) }}"
  loop: "{{ mysql_configuration_options }}"
  notify: "Systemctl daemon-reexec"
- name: Configure mysql client
  ini_file:
    dest: /etc/mysql/mysql.conf.d/{{ mysql_name }}-client.cnf
    section: client
    option: socket
    value: /var/run/mysqld/{{ mysql_name }}.sock
    mode: 0644
    no_extra_spaces: yes
    state: present
  notify: "Systemctl daemon-reexec"
- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: "{{ mysql_socket }}"
  when: ansible_os_family == "Debian"
  notify: "Systemctl daemon-reexec"
- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes
- name: Flush handlers
  meta: flush_handlers
- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640
- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state | default(omit) }}"
    target: "{{ item.target | default(omit) }}"
    encoding: "{{ item.encoding | default(omit) }}"
    collation: "{{ item.collation | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password | default(omit) }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"
  no_log: yes
  when: mysql_databases | length > 0
- name: List databases
  mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password | default(omit) }}"
    login_unix_socket: "{{ mysql_socket }}"
  register: mysql_databases_list
- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    target: "{{ item.target }}"
    state: import
    login_user: root
    login_password: "{{ mysql_root_password | default(omit) }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"
  no_log: yes
  when:
    - mysql_databases | length > 0
    - item.target is defined
    - mysql_databases_list.databases | selectattr('name', 'equalto', item.name) | list | count == 0
- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password | default(omit) }}"
    priv: "{{ item.priv | default(omit) }}"
    host: "{{ item.host | default(omit) }}"
    state: "{{ item.state | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password | default(omit) }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"
  no_log: yes
  when: mysql_users | length > 0
- name: Flush handlers again
  meta: flush_handlers


