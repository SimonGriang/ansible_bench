---

- name: Task 1 - Import assert.yml
  include_tasks: assert.yml

- name: Task 2 - Configure apk
  when: ansible_pkg_mgr == "apk"
  block:
    - name: Update apk cache
      apk:
        update_cache: yes
    - name: Upgrade apk packages
      apk:
        upgrade: yes
      notify: Reboot
  handlers:
    - name: Reboot
      command: /bin/systemctl reboot --no-block
      async: 0
      poll: 0
      changed_when: false

- name: Task 3 - Configure apt
  when: ansible_pkg_mgr == "apt"
  block:
    - name: Prevent upgrades for excluded packages
      dpkg_selections:
        name: "{{ update_excluded_packages }}"
        selection:hold
    - name: Update apt cache
      apt:
        update_cache: yes
    - name: Upgrade apt packages
      apt:
        upgrade: yes
        autoremove: "{{ apt_autoremove }}"
      notify: Reboot
    - name: Release hold on excluded packages
      dpkg_selections:
        name: "{{ update_excluded_packages }}"
        selection:install

- name: Task 4 - Update all software (dnf)
  when: ansible_pkg_mgr == "dnf" or ansible_pkg_mgr == "dnf5"
  block:
    - name: Update all software
      dnf:
        name: '*'
        exclude: "{{ update_excluded_packages }}"
        update_only: yes
      notify: Reboot

- name: Task 5 - Update all software (pacman)
  when: ansible_pkg_mgr == "pacman"
  block:
    - name: Update all software
      pacman:
        update_cache: yes
        upgrade: yes
      notify: Reboot

- name: Task 6 - Configure yum
  when: ansible_pkg_mgr == "yum"
  block:
    - name: Update yum cache
      yum:
        update_cache: yes
    - name: Upgrade yum packages
      yum:
        name: '*'
        exclude: "{{ update_excluded_packages }}"
        update_only: yes
      notify: Reboot

- name: Task 7 - Update all software (zypper)
  when: ansible_pkg_mgr == "zypper"
  block:
    - name: Update all software
      zypper:
        name: '*'
        update_only: yes
      notify: Reboot


