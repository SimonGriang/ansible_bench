---

- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Task 2 - Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Task 3 - Configure selinux
  selinux:
    state: "{{ (ansible_selinux.status == 'enabled') | ternary('permissive', 'disabled') }}"
    policy: targeted
  when: ansible_selinux.status == "enabled"

- name: Task 3 - Configure selinux booleans
  seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    persistent: yes
  with_items: "{{ httpd_sebooleans }}"
  when: ansible_selinux.status == "enabled"

- name: Task 3 - Configure selinux ports
  seport:
    ports: "{{ item }}"
    proto: tcp
    state: present
  with_items:
    - "{{ httpd_port | string }}"
    - "{{ httpd_ssl_port | string }}"
  when: ansible_selinux.status == "enabled"

- name: Task 4 - Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify: Test and restart httpd

- name: Task 5 - Activate httpd module | Debian
  command: a2enmod {{ item }}
  with_items: "{{ httpd_modules_to_activate_with_command }}"
  notify: Test and restart httpd
  when: ansible_os_family == "Debian"

- name: Task 6 - Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Task 7 - Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Task 8 - Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Task 9 - Configure ports
  template:
    src: httpd_ports_conf.j2
    dest: "{{ httpd_server_root }}/conf.d/ports.conf"
    mode: 0644
  notify: Test and restart httpd
  when: ansible_os_family in [ "Debian", "Suse" ]

- name: Task 10 - Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Task 11 - Flush handlers
  meta: flush_handlers

- name: Task 12 - Removing default html
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Task 13 - Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


