---
- name: Create RKE2 config directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: "0755"

- name: Set server taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == "server"

- name: Copy rke2 config
  ansible.builtin.template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/rke2.yaml
    owner: root
    group: root
    mode: "0644"
  notify: Config file changed

- name: Copy kubelet config
  ansible.builtin.template:
    src: kubelet.conf.j2
    dest: /var/lib/rancher/rke2/agent/etc/kubelet/kubelet-config.yaml
    owner: root
    group: root
    mode: "0644"
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  ansible.builtin.template:
    src: registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: "0644"
  notify: Config file changed
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

- name: Register if we need to do a etcd restore from file
  ansible.builtin.set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and rke2_service_enabled and rke2_type == "server"

- name: Register if we need to do a etcd restore from s3
  ansible.builtin.set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined and rke2_service_enabled and rke2_type == "server"

- name: Restore etcd from file
  ansible.builtin.block:
    - name: Create etcd snapshot destination directory
      ansible.builtin.file:
        path: /var/lib/rancher/rke2/server/db/snapshots
        state: directory
        owner: root
        group: root
        mode: "0755"

    - name: Copy etcd snapshot file
      ansible.builtin.copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/snapshots/etcd-snapshot.db
        owner: root
        group: root
        mode: "0644"

    - name: Run rke2 server etcd restore command
      ansible.builtin.shell: |
        RKE2_ETCD_SNAPSHOT=true RKE2_ETCD_SNAPSHOT_ENDPOINT=unix://{{ rke2_data_dir }}/db/snapshots/etcd-snapshot.db /var/lib/rancher/rke2/bin/rke2 server --config /etc/rancher/rke2/rke2.yaml
      args:
        creates: /etc/kubernetes/static-pod-resources/etcd-member/snap
      notify: Service (re)started
  when: do_etcd_restore is defined and do_etcd_restore

- name: Restore etcd from s3
  ansible.builtin.shell: |
    RKE2_ETCD_SNAPSHOT=true RKE2_ETCD_SNAPSHOT_ENDPOINT=s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_file }} /var/lib/rancher/rke2/bin/rke2 server --config /etc/rancher/rke2/rke2.yaml
  args:
    creates: /etc/kubernetes/static-pod-resources/etcd-member/snap
  notify: Service (re)started
  when: do_etcd_restore_from_s3 is defined and do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  ansible.builtin.shell: |
    export RKE2_TOKEN="{{ rke2_token }}"
    /var/lib/rancher/rke2/bin/rke2 server --config /etc/rancher/rke2/rke2.yaml
  environment:
    PATH: /bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
  notify: Service (re)started
  when: rke2_type == "server"

- name: Mask RKE2 agent service on the first server
  ansible.builtin.systemd:
    name: rke2-agent.service
    enabled: no
    state: stopped
    masked: yes
  when: rke2_type == "server"

- name: Wait for the first server be ready - no CNI
  ansible.builtin.shell: |
    kubectl wait --for=condition=Ready node {{ inventory_hostname }} --timeout=60s
  environment:
    KUBECONFIG: /etc/kubernetes/admin.conf
  register: rke2_wait_result
  until: rke2_wait_result.rc == 0
  retries: 120
  delay: 1
  changed_when: false
  when: rke2_cni == "none"

- name: Wait for the first server be ready - with CNI
  ansible.builtin.shell: |
    kubectl wait --for=condition=Ready node {{ inventory_hostname }} --timeout=60s
  environment:
    KUBECONFIG: /etc/kubernetes/admin.conf
  register: rke2_wait_result
  until: rke2_wait_result.rc == 0
  retries: 120
  delay: 1
  changed_when: false
  when: rke2_cni != "none"

- name: Restore etcd
  ansible.builtin.block:
    - name: Get registered nodes
      ansible.builtin.shell: kubectl get node -o jsonpath='{.items[*].metadata.name}'
      environment:
        KUBECONFIG: /etc/kubernetes/admin.conf
      register: rke2_registered_nodes

    - name: Get node names
      ansible.builtin.shell: hostname -s
      register: rke2_registered_names

    - name: Remove old secrets
      ansible.builtin.shell: "kubectl delete secret {{ item }} --ignore-not-found=true"
      environment:
        KUBECONFIG: /etc/kubernetes/admin.conf
      with_items:
        - etcd-client-tls
        - etcd-server-tls
        - etcd-peer-tls
      changed_when: false

    - name: Remove old nodes
      ansible.builtin.shell: "kubectl delete node {{ item }} --ignore-not-found=true"
      environment:
        KUBECONFIG: /etc/kubernetes/admin.conf
      with_items: "{{ rke2_registered_nodes.stdout_lines }}"
      changed_when: false

    - name: Add new node
      ansible.builtin.shell: "kubectl replace --force -f /etc/kubernetes/static-pod-resources/etcd-member/kube-apiserver-pod.yaml"
      environment:
        KUBECONFIG: /etc/kubernetes/admin.conf
      changed_when: false
  when: rke2_type == "agent"


