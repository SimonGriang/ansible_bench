---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Pre-configure debian systems
  become: true
  become_method: sudo
  when: ansible_os_family == "Debian"
  debconf:
    name: postfix
    question: postfix/mailer_type
    value: "No configuration"
    vtype: string

- name: Install postfix
  become: true
  become_method: sudo
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  become: true
  become_method: sudo
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined or postfix_virtual_domains is defined

- name: Configure postfix (transport_maps)
  become: true
  become_method: sudo
  template:
    src: "transport_maps.j2"
    dest: "{{ postfix_transport_maps }}"
    mode: "0644"
    owner: root
    group: root
  notify:
    - restart postfix
    - rebuild postfix database
  when: postfix_transport_maps is defined

- name: Configure postfix (header_checks)
  become: true
  become_method: sudo
  template:
    src: "header_checks.j2"
    dest: "{{ postfix_header_checks }}"
    mode: "0644"
    owner: root
    group: root
  notify:
    - restart postfix
    - reload postfix
  when: postfix_header_checks is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_smtp_sasl_auth_enable: "{{ postfix_smtp_sasl_auth_enable | default(omit) }}"
    postfix_main_cf_relayhost: "{{ postfix_relayhost | default(omit) }}"
    # 


