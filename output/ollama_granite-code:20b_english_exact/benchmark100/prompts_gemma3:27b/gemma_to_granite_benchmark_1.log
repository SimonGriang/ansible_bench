    - import_tasks: assert.yml
    - name: Install git
      package:
        name: "{{ git_packages }}"
        state: present
    - name: See if the specified user exists
      getent:
        database: "passwd"
        key: "{{ git_username }}"
      register: user_check
      failed_when: fail_key and user_check.failed
    - name: Create directory for git configuration
      file:
        path: "/home/{{ git_username }}/.config"
        owner: "{{ git_username }}"
        group: "{{ git_username }}"
        mode: 0750
        state: directory
    - name: Place git configuration
      template:
        src: gitconfig.j2
        dest: "/home/{{ git_username }}/.gitconfig"
        owner: "{{ git_username }}"
        group: "{{ git_username }}"
        mode: 0640
    - name: Create repository_destination
      file:
        path: "{{ git_repository_destination }}"
        owner: "{{ git_username }}"
        group: "{{ git_username }}"
        mode: 0750
        state: directory
    - name: Clone all roles
      git:
        repo: "{{ item.url }}"
        dest: "{{ item.dest }}"
        version: "{{ item.version }}"
        force: "{{ item.force }}"
      become_user: "{{ git_username }}"
      loop: "{{ git_repositories }}"
      loop_control:
        label: "{{ item.dest }}"


