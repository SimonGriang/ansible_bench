ister: mysql_databases_list\n- name: Import database\n  mysql_db:\n    name: "{{ item.name }}"\n    target: "{{ item.target }}"\n    state: import\n    login_user: root\n    login_password: "{{ mysql_root_password | default(omit) }}"\n    login_unix_socket: "{{ mysql_socket }}"\n  loop: "{{ mysql_databases }}"\n  no_log: yes\n  when:\n    - mysql_databases | length > 0\n    - item.target is defined\n    - mysql_databases_list.databases | selectattr(\'name\', \'equalto\', item.name) | list | count == 0\n- name: Create users\n  mysql_user:\n    name: "{{ item.name }}"\n    password: "{{ item.password | default(omit) }}"\n    priv: "{{ item.priv | default(omit) }}"\n    host: "{{ item.host | default(omit) }}"\n    state: "{{ item.state | default(omit) }}"\n    login_user: root\n    login_password: "{{ mysql_root_password | default(omit) }}"\n    login_unix_socket: "{{ mysql_socket }}"\n  loop: "{{ mysql_users }}"\n  no_log: yes\n  when: mysql_users | length > 0\n- name: Flush handlers again\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-21T11:39:43.085442681Z', 'done': True, 'done_reason': 'stop', 'total_duration': 22184287039, 'load_duration': 34666827, 'prompt_eval_count': 1910, 'prompt_eval_duration': 151307896, 'eval_count': 840, 'eval_duration': 21996535963, 'model_name': 'granite-code:20b'} id='run--8d791f1f-644d-4a45-8ada-7477caf352f4-0' usage_metadata={'input_tokens': 1910, 'output_tokens': 840, 'total_tokens': 2750}
