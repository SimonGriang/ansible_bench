---

- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: "{{ cron_configuration }}"
    create: true
    mode: 0600
    regexp: "^SHELL="
    line: "SHELL={{ cron_shell }}"
    state: present
  notify: Restart cron

- name: Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    create: true
    mode: 0600
    regexp: "^PATH="
    line: "PATH={{ cron_path }}"
    state: present
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    path: "{{ cron_configuration }}"
    create: true
    mode: 0600
    regexp: "^MAILTO="
    line: "MAILTO={{ cron_mailto }}"
    state: present
  notify: Restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service | length > 0

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default(omit) }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined


