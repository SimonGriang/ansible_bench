---
- name: Download RKE2 installation script
  get_url:
    url: https://github.com/rke2/rke2/releases/download/v1.22.7%2Brke2r1/rke2-install.sh
    dest: /var/tmp/rke2-install.sh
    mode: 0755
    force: true

- name: Copy local RKE2 installation script
  copy:
    src: /path/to/local/rke2-install.sh
    dest: /var/tmp/rke2-install.sh
    mode: 0755
    force: true

- name: Create RKE2 artifacts folder
  file:
    path: /var/lib/rke2/agent/artifacts
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 artifacts
      get_url:
        url: https://github.com/rke2/rke2/releases/download/v1.22.7%2Brke2r1/rke2-artifacts.tar.gz
        dest: /var/lib/rke2/agent/artifacts/rke2-artifacts.tar.gz
        mode: 0644
    - name: Download RKE2 checksum
      get_url:
        url: https://github.com/rke2/rke2/releases/download/v1.22.7%2Brke2r1/sha256sum-rke2-artifacts.txt
        dest: /var/lib/rke2/agent/artifacts/sha256sum-rke2-artifacts.txt
        mode: 0644
  rescue:
    - name: Download RKE2 artifacts locally
      copy:
        src: /path/to/local/rke2-artifacts.tar.gz
        dest: /var/lib/rke2/agent/artifacts/rke2-artifacts.tar.gz
        mode: 0644
    - name: Download RKE2 checksum locally
      copy:
        src: /path/to/local/sha256sum-rke2-artifacts.txt
        dest: /var/lib/rke2/agent/artifacts/sha256sum-rke2-artifacts.txt
        mode: 0644

- name: Copy local RKE2 artifacts
  copy:
    src: /path/to/local/rke2-artifacts.tar.gz
    dest: /var/lib/rke2/agent/artifacts/rke2-artifacts.tar.gz
    mode: 0644

- name: Copy additional tarball images for RKE2 components
  copy:
    src: /path/to/local/additional-images.tar.gz
    dest: /var/lib/rke2/agent/artifacts/additional-images.tar.gz
    mode: 0644

- name: Ensure RKE2 artifacts exist and have appropriate permissions
  file:
    path: /var/lib/rke2/agent/artifacts
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: local_fs_obj

- name: Check if separate partition
  set_fact:
    separate_partition: "{{ local_fs_obj.stat.exists and (local_fs_obj.stat.fstype != 'ext4') }}"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin/rke2"
  when: not separate_partition

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/var/lib/rke2/bin/rke2"
  when: separate_partition

- name: Check RKE2 version
  command: "{{ rke2_bin_path }} version"
  register: rke2_version_raw
  changed_when: false

- name: Set RKE2 versions
  set_fact:
    installed_rke2_version: "{{ rke2_version_raw.stdout | regex_search('^rke2 version v([0-9.]+)', '\\1') }}"
    running_rke2_version: "{{ rke2_version_raw.stdout | regex_search('^rke2 version v([0-9.]+)', '\\1') }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that: "installed_rke2_version is version_compare(running_rke2_version, operator='==')"
    msg: Downgrades are not allowed, run rke2-downgrade to downgrade RKE2

- name: Run RKE2 install script
  command: "{{ rke2_bin_path }} install --insecure-options=all --debug --rke2-version {{ installed_rke2_version }}"
  environment:
    INSTALL_RKE2_TYPE: airgap
    RKE2_URL: https://my.local.registry/v2/rke2/manifests/v1.22.7%2Brke2r1
    RKE2_VERSION: v1.22.7+rke2r1
    RKE2_TOKEN: "abc123"
    RKE2_ARTIFACT_PATH: /var/lib/rke2/agent/artifacts
    RKE2_CIS_weep_REPORT_OUTPUT_PATH: /var/log/rke2/cis-weep-report.log
    RKE2_CIS_weep_LIST_PATH: /var/lib/rke2/agent/cis-weep-list.json

- name: Copy Custom Manifests
  copy:
    src: /path/to/custom-manifests/
    dest: /var/lib/rke2/agent/manifests/
    mode: 0644

- name: Copy Static Pods
  copy:
    src: /path/to/static-pods/
    dest: /etc/kubernetes/manifests/
    mode: 0644

- name: Copy RKE2 environment file
  template:
    src: rke2-env.j2
    dest: /etc/sysconfig/rke2-env
    mode: 0644



