uration': 37673990, 'prompt_eval_count': 673, 'prompt_eval_duration': 576485682, 'eval_count': 408, 'eval_duration': 9275257457, 'model_name': 'granite-code:20b'} id='run--487c2378-4be9-42b0-8d84-3fb5c6f08734-0' usage_metadata={'input_tokens': 673, 'output_tokens': 408, 'total_tokens': 1081}
