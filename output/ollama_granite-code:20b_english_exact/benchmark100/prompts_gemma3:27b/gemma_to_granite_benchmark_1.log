---
- name: Check if all variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host to be reachable
  wait_for_connection:
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  connection: local
  when:
    - ansible_connection != "container/docker"
    - bootstrap_wait_for_host

- name: Prepare the system
  block:
    - name: Test connection
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: bootstrap_connect

    - name: Debug timeout
      debug:
        var: bootstrap_timeout
      when: not bootstrap_connect

  always:
    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml

- name: Install bootstrap packages
  block:
    - name: Install bootstrap packages
      raw: "{{ bootstrap_install_packages }}"
      changed_when:
        - bootstrap_install_packages is search("alpine|archlinux|gentoo")
        - "'{{ bootstrap_install_packages }}' not in bootstrap_connect.stdout"
      failed_when:
        - bootstrap_install_packages is search("debian|redhat|rocky|suse")
        - "'{{ bootstrap_install_packages }}' in bootstrap_connect.stdout"
      become: "{{ bootstrap_become_for_install_packages }}"
      become_user: "{{ bootstrap_user }}"
      register: bootstrap_install_packages
  when: bootstrap_install_packages is defined

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:

    - name: Install packages
      package:
        name: "{{ bootstrap__facts_packages }}"
        state: present
        update_cache: true
      when: bootstrap__facts_packages is defined
  when: bootstrap_install_packages is not defined


