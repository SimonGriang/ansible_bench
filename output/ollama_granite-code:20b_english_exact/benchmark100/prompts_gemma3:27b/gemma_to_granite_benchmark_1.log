---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: ^GRUB_TIMEOUT=
    line: GRUB_TIMEOUT="{{ grub_timeout }}"
    create: true
    mode: 0664
    notify: Update grub
  vars:
    grub_timeout: 10

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: ^GRUB_RECORDFAIL_TIMEOUT=
    line: GRUB_RECORDFAIL_TIMEOUT="{{ grub_recordfail_timeout }}"
    create: true
    mode: 0664
    notify: Update grub
  vars:
    grub_recordfail_timeout: 0

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    path: /etc/default/grub
    regexp: ^GRUB_CMDLINE_LINUX=
    line: "GRUB_CMDLINE_LINUX '{{ grub_options | join(' ') }}'"
    create: true
    mode: 0664
    validate: '/usr/sbin/grub2-editenv %s'
    notify: Update grub
  vars:
    grub_options: []
  when: grub_options | length > 0
  loop_control:
    label: "Adding {{ item }} to GRUB_CMDLINE_LINUX"

- name: Import password.yml
  import_tasks: password.yml
  when: grub_set_password

- name: Flush handlers
  meta: flush_handlers


