- name: Task 1
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2
  ansible.builtin.package:
    name: nginx
    state: present

- name: Task 3
  ansible.builtin.template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: '0644'
    validate: nginx -t -c %s
    notify: Restart nginx

- name: Task 4
