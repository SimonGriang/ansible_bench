---

- import_tasks: assert.yml

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - not ansible_connection.startswith('container')
    - bootstrap_wait_for_host

- name: Prepare system
  block:
    - name: Test connection
      ping:

    - name: Test sudo
      command: sudo echo OK

    - name: Gather bootstrap facts
      setup:

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        update_cache: yes
        become: "{{ bootstrap_become }}"
      register: bootstrap_install_facts_result
      until: bootstrap_install_facts_result is succeeded
      retries: 5
      delay: 20

    - name: Check libdnf present
      package:
        name: libdnf
        state: present
      when: ansible_os_family == "RedHat"

  rescue:
    - name: Gather bootstrap facts
      setup:

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        update_cache: yes
        become: "{{ bootstrap_become }}"
      register: bootstrap_install_facts_result
      until: bootstrap_install_facts_result is succeeded
      retries: 5
      delay: 20

    - name: Check libdnf present
      package:
        name: libdnf
        state: present
      when: ansible_os_family == "RedHat"

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: yes
    become: "{{ bootstrap_become }}"


