---
- name: Load OS-specific variables
  include_vars: "{{ item }}"
  with_first_found:
    - files:
      - "{{ ansible_facts.os_family }}-{{ ansible_facts.distribution }}-{{ ansible_facts.distribution_major_version }}.yml"
      - "{{ ansible_facts.os_family }}-{{ ansible_facts.distribution }}.yml"
      - "{{ ansible_facts.os_family }}-{{ ansible_facts.distribution_major_version }}.yml"
      - "{{ ansible_facts.os_family }}.yml"
      - defaults/main.yml
      paths:
      - ../vars

- name: Include RedHat setup tasks
  include_tasks: redhat.yml
  when: ansible_facts.os_family == 'RedHat'

- name: Include Debian setup tasks
  include_tasks: debian.yml
  when: ansible_facts.os_family == 'Debian'

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: not (ansible_facts.os_family == 'RedHat' or ansible_facts.os_family == 'Debian')

- name: Install Docker packages (with downgrade option)
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: yes
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: (ansible_facts.os_family == 'RedHat' or ansible_facts.os_family == 'Debian') and (ansible_version.full | version_compare('2.12', '>='))

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: docker_install_compose_plugin and not (ansible_facts.os_family == 'RedHat' or ansible_facts.os_family == 'Debian') and (ansible_version.full | version_compare('2.12', '<'))

- name: Install docker-compose-plugin (with downgrade option)
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: yes
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: docker_install_compose_plugin and (ansible_facts.os_family == 'RedHat' or ansible_facts.os_family == 'Debian') and (ansible_version.full | version_compare('2.12', '>='))

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: 0755
  when: docker_daemon_options_dict|length > 0

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options_json }}"
    dest: /etc/docker/daemon.json
    mode: 0644
  notify: restart docker
  when: docker_daemon_options_dict|length > 0

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: "{{ ansible_check_mode }}"

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose tasks
  include: docker_compose.yml
  when: docker_install_compose

- name: Get docker group info using getent
  getent:
    database: group
    key: docker

- name: Check if there are any users to add to the docker group
  set_fact:
    at_least_one_user_to_modify: "{{ True if docker_users|length > 0 and docker_group.stdout_lines|length > 1 else False }}"

- name: Include docker-users tasks
  include: docker_users.yml
  when: at_least_one_user_to_modify is defined and at_least_one_user_to_modify


