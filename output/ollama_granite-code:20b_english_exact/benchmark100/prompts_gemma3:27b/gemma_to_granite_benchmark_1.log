---
- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: helm version
  register: helm_existing_version
  failed_when: false
  changed_when: false
  when: not helm_check.stat.exists

- name: Download helm
  unarchive:
    src: "{{ helm_download_url }}"
    dest: /tmp
    remote_src: true
  register: helm_download
  when: not helm_check.stat.exists or helm_existing_version.stdout.split('\n')[0] != 'version.BuildInfo{Version:"' + helm_version + '"'

- name: Copy helm binary into place
  copy:
    src: /tmp/{{ helm_repo_path }}/{{ helm_platform }}/{{ helm_arch }}/helm
    dest: "{{ helm_bin_path }}"
    mode: 0755
    remote_src: true
  become: true
  when: helm_download.changed



