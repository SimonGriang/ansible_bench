---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true

- block:
  - name: Install using package
    package:
      name: "{{ hashicorp_products }}"
      state: present
  when: hashicorp_installation_method == "package"

- block:
  - name: Install repository for RedHat
    get_url:
      url: "{{ hashicorp_repo_url }}"
      dest: /etc/yum.repos.d/hashicorp.repo
      mode: 0640
  when: ansible_os_family == "RedHat"

- block:
  - name: Configure debian
    apt:
      update_cache: yes
  when: ansible_os_family == "Debian"

- block:
  - name: Install required package gpg
    package:
      name: gpg
      state: present
  when: ansible_os_family == "Debian"

- block:
  - name: Install apt key for Debian
    apt_key:
      url: https://apt.releases.hashicorp.com/gpg
      state: present
      ignore_errors: yes
  when: ansible_os_family == "Debian"

- block:
  - name: Install repository for Debian
    apt_repository:
      repo: "deb {{ hashicorp_repo_url }} {{ ansible_distribution_release }} main"
      filename: hashicorp
      architecture: "{{ hashicorp_architecture_mapping[ansible_architecture] | default(ansible_architecture) }}"
  when: ansible_os_family == "Debian"

- block:
  - name: Install hashicorp product using package
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ hashicorp_products }}"
    loop_control:
      label: "Install {{ item }}"
  when: hashicorp_installation_method == "package" and hashicorp_products is defined

- block:
  - name: Install latest hashicorp product using package
    package:
      name: "{{ item.name }}"
      state: present
    loop: "{{ hashicorp_products }}"
    loop_control:
      label: "Install {{ item.name }}"
  when: hashicorp_installation_method == "package" and hashicorp_products is defined and item.version is not defined

- block:
  - name: Install versioned hashicorp product using package
    package:
      name: "{{ item.name }}{{ version_coupler }}{{ item.version }}"
      state: present
    loop: "{{ hashicorp_products }}"
    loop_control:
      label: "Install {{ item.name }}{{ version_coupler }}{{ item.version }}"
  when: hashicorp_installation_method == "package" and hashicorp_products is defined and item.version is defined

- block:
  - name: Install hashicorp product manually
    unarchive:
      src: "{{ hashicorp_src }}"
      dest: "{{ hashicorp_dest }}"
      group: "{{ hashicorp_group }}"
      mode: "{{ hashicorp_mode }}"
      owner: "{{ hashicorp_owner }}"
    loop: "{{ hashicorp_products }}"
    loop_control:
      label: "Install {{ item.name }}"
  when: hashicorp_installation_method == "manual"
