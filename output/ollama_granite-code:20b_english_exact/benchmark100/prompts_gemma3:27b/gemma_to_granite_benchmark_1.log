\'content\'] + openssl_certifcate[\'content\'] }}"\n    mode: 640\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n  loop: "{{ openssl_items }}"' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-21T12:07:08.986860833Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16159300911, 'load_duration': 34879924, 'prompt_eval_count': 953, 'prompt_eval_duration': 749291716, 'eval_count': 615, 'eval_duration': 15373918001, 'model_name': 'granite-code:20b'} id='run--d5047cdc-bcf0-411f-bcda-08d32a961db8-0' usage_metadata={'input_tokens': 953, 'output_tokens': 615, 'total_tokens': 1568}
