content='---\n- name: Configure Logrotate\n  hosts: all\n  tasks:\n    - name: Install logrotate\n      yum:\n        name: logrotate\n        state: present\n\n    - name: Create logrotate configuration files\n      template:\n        src: logrotate.d/{{ item.name }}.j2\n        dest: /etc/logrotate.d/{{ item.name }}\n        owner: root\n        group: root\n        mode: 0644\n      loop: "{{ logrotate_entries }}"\n      loop_control:\n        label: "Creating logrotate configuration file for {{ item.name }}"\n      when: item.state is not defined or item.state != "absent"\n\n    - name: Remove logrotate configuration files\n      file:\n        path: /etc/logrotate.d/{{ item.name }}\n        state: absent\n      loop: "{{ logrotate_entries }}"\n      loop_control:\n        label: "Removing logrotate configuration file for {{ item.name }}"\n      when: item.state is defined and item.state == "absent"' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-21T11:58:22.054412062Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6520143692, 'load_duration': 32720474, 'prompt_eval_count': 1728, 'prompt_eval_duration': 1269088855, 'eval_count': 217, 'eval_duration': 5216927420, 'model_name': 'granite-code:20b'} id='run--bab6780e-a07d-4c79-a042-d78291cf9cd9-0' usage_metadata={'input_tokens': 1728, 'output_tokens': 217, 'total_tokens': 1945}
