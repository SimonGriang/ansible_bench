---
- name: Join the RKE2 cluster
  hosts: node
  tasks:
    - name: Join the RKE2 cluster
      command: rke2 join --token <token> --server https://<server-ip>:9345
      register: join_output
      changed_when: "'This node has been successfully added to the cluster' in join_output.stdout"
      until: join_output.rc == 0
