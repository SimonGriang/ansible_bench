---
- import_tasks: assert.yml

- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  ansible.builtin.getent:
    database: "passwd"
    key: "{{ git_username }}"
  register: user_check
  failed_when: fail_key and user_check.failed

- name: Create directory for git configuration
  ansible.builtin.file:
    path: "/home/{{ git_username }}/.config"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0750"
    state: directory

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0640"

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ git_repository_destination }}"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0750"
    state: directory

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ item.url }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version }}"
    force: "{{ item.force }}"
  become_user: "{{ git_username }}"
  loop: "{{ git_repositories }}"
  loop_control:
    label: "{{ item.dest }}"


