---
- name: Install Keepalived
  include_tasks: keepalived.yml
  when: rke2_ha_enabled and rke2_servers_group_name in group_names and rke2_api_ip is defined
  tags:
    - always

- name: Download and install RKE2
  include_tasks: rke2.yml
  tags:
    - rke2

- name: CIS Hardening
  include_tasks: cis.yml
  when: rke2_cis_profile|length > 0
  tags:
    - cis

- name: Find Active Server
  include_tasks: find_active_server.yml
  tags:
    - rke2

- name: Enable IPVS kernel module
  include_tasks: ipvs.yml
  when: >
    rke2_kubevip_ipvs_lb_enable and
    rke2_servers_group_name in group_names and
    rke2_ha_enabled and
    not rke2_kubevip_use_keepalived
  tags:
    - rke2

- name: Copy kube-vip manifests to the masternode
  include_tasks: kubevip.yml
  when: >
    rke2_ha_enabled and
    rke2_kubevip_ipvs_lb_enable and
    not rke2_kubevip_use_keepalived
  tags:
    - rke2

- name: Copy ingress-nginx manifests to the masternode
  include_tasks: ingress-nginx.yml
  when: >
    rke2_ingress_nginx_values is defined and
    rke2_ingress_nginx_values|length > 0
  tags:
    - rke2

- name: Prepare very first server node in the cluster
  include_tasks: first_server.yml
  when: >
    rke2_servers_group_name in group_names and
    (rke2_active_server is not defined or group_names|length == 1)
  tags:
    - rke2

- name: Restore etcd specific tasks
  include_tasks: first_server_restore.yml
  when: >
    rke2_active_server is defined and
    (rke2_servers_group_name in group_names or rke2_servers_group_name == inventory_hostname) and
    (do_etcd_restore is defined or do_etcd_restore_from_s3 is defined)
  tags:
    - rke2

- name: Download kubeconfig to ansible localhost
  include_tasks: download_kubeconfig.yaml
  when: >
    rke2_download_kubeconf and
    rke2_servers_group_name in group_names
  tags:
    - rke2

- name: Prepare and join remaining nodes of the cluster
  include_tasks: remaining_nodes.yml
  when: >
    rke2_active_server is defined and
    group_names|length > 1
  tags:
    - rke2

- name: Rolling cordon and drain restart when version changes - servers
  command: "ansible-playbook rolling-restart.yml -i {{ rke2_cluster_group_name }} --extra-vars '{\"rke2_drain_timeout\":{{ rke2_drain_timeout }},\"rke2_server_group_name\":\"{{ rke2_servers_group_name }}\",\"rke2_version\":\"{{ rke2_version }}\"}'"
  register: r
  changed_when: "'changed:\n  ok: ' in r.stdout"
  when: >
    rke2_servers_group_name in group_names and
    rke2_installed_version is defined and
    rke2_installed_version != rke2_version
  tags:
    - rke2

- name: Rolling cordon and drain restart when version changes - agents
  command: "ansible-playbook rolling-restart.yml -i {{ rke2_cluster_group_name }} --extra-vars '{\"rke2_drain_timeout\":{{ rke2_drain_timeout }},\"rke2_server_group_name\":\"{{ rke2_agents_group_name }}\",\"rke2_version\":\"{{ rke2_version }}\"}'"
  register: r
  changed_when: "'changed:\n  ok: ' in r.stdout"
  when: >
    rke2_agents_group_name in group_names and
    rke2_installed_version is defined and
    rke2_installed_version != rke2_version and
    rke2_servers_group_name not in group_names
  tags:
    - rke2

- name: Flush handlers
  meta: flush_handlers
  tags:
    - rke2

- name: Rolling restart when config files change
  command: "ansible-playbook rolling-restart.yml -i {{ rke2_cluster_group_name }} --extra-vars '{\"rke2_drain_timeout\":{{ rke2_drain_timeout }},\"rke2_server_group_name\":\"{{ rke2_servers_group_name }}\"}'"
  register: r
  changed_when: "'changed:\n  ok: ' in r.stdout"
  when: >
    rke2_servers_group_name in group_names and
    rke2_restart_needed
  tags:
    - rke2

- name: Final steps
  include_tasks: summary.yml
  tags:
    - summary


