---
- name: Ensure easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: "0755"

- name: Initialize easy-rsa PKI
  shell: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki

- name: Build the Certificate Authority
  shell: easyrsa build-ca nopass
  environment:
    EASYRSA_BATCH: "yes"
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/ca.crt

- name: Generate Diffie-Hellman parameters
  shell: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/dh.pem

- name: Build the server certificate
  shell: easyrsa build-server-full server nopass
  environment:
    EASYRSA_BATCH: "yes"
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/issued/server.crt

- name: Build the client certificate
  shell: easyrsa build-client-full client nopass
  environment:
    EASYRSA_BATCH: "yes"
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/issued/client.crt

- name: Generate the Certificate Revocation List
  shell: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/crl.pem

- name: Generate TLS authentication key
  shell: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy PKI files to the server configuration directory
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/{{ item }}
    owner: root
    group: root
    mode: "0640"
  with_items:
    - ca.crt
    - dh.pem
    - ta.key
    - client.crt
    - server.crt
    - ca.key
    - client.key
    - server.key

- name: Copy ca.crt and ta.key to /etc/openvpn
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/{{ item }}
    owner: root
    group: root
    mode: "0640"
  with_items:
    - ca.crt
    - ta.key

- name: Place the server configuration file
  template:
    src: server.conf.j2
    dest: "{{ openvpn_configuration_directory }}/server.conf"
    owner: root
    group: root
    mode: "0640"
  notify: Restart openvpn


