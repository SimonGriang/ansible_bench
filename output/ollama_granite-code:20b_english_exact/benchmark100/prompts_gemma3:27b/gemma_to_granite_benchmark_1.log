ation': 25451402321, 'load_duration': 44399256, 'prompt_eval_count': 1239, 'prompt_eval_duration': 1207969269, 'eval_count': 925, 'eval_duration': 24197692657, 'model_name': 'granite-code:20b'} id='run--6a4437f4-dce2-4a7c-80bc-755108ec2740-0' usage_metadata={'input_tokens': 1239, 'output_tokens': 925, 'total_tokens': 2164}
