---
- name: Create ssh_key_directory for user
  file:
    path: "/home/{{ user.name }}/.ssh"
    state: directory
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
    mode: 0700
  become: true
  when:
    - user.manage_ssh_key is defined
    - user.manage_ssh_key

- name: Manage user account
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment | default(omit) }}"
    create_home: "{{ user.create_home | default(omit) }}"
    password: "{{ user.password | default(omit) }}"
    update_password: "{{ user.update_password | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    expires: "{{ user.expires | default(omit) }}"
  become: true
  register: user_account_management

- name: Set sudo options for user
  template:
    src: sudoers.j2
    dest: /etc/sudoers.d/{{ user.name }}
    validate: '/usr/sbin/visudo -cf %s'
    owner: root
    group: root
    mode: 0440
  become: true
  loop: "{{ user.sudoers }}"
  loop_control:
    label: "Set sudoers entry for {{ user.name }} (item: {{ item.name }})"
  when:
    - user.sudoers is defined
    - user.sudoers

- name: Remove sudo options for user
  file:
    path: /etc/sudoers.d/{{ user.name }}
    state: absent
  become: true
  loop: "{{ user.sudoers }}"
  loop_control:
    label: "Remove sudoers entry for {{ user.name }} (item: {{ item.name }})"
  when:
    - user.sudoers is defined
    - user.sudoers
    - item.name is not defined

- name: Generate private ssh key for user
  command: "ssh-keygen -b 2048 -t rsa -f /home/{{ user.name }}/.ssh/id_rsa -q -N ''"
  args:
    creates: "/home/{{ user.name }}/.ssh/id_rsa"
  delegate_to: localhost
  become: true
  run_once: true
  when:
    - user.manage_ssh_key is defined
    - user.manage_ssh_key

- name: Generate public ssh key for user
  command: "ssh-keygen -y -f /home/{{ user.name }}/.ssh/id_rsa > /home/{{ user.name }}/.ssh/id_rsa.pub"
  delegate_to: localhost
  become: true
  run_once: true
  when:
    - user.manage_ssh_key is defined
    - user.manage_ssh_key

- name: Convert ssh key to ppk for user
  command: "ssh-keygen -p -f /home/{{ user.name }}/.ssh/id_rsa -m PEM > /home/{{ user.name }}/.ssh/id_rsa.ppk"
  delegate_to: localhost
  become: true
  run_once: true
  when:
    - user.manage_ssh_key is defined
    - user.manage_ssh_key

- name: Get or set the home directory for user
  block:
    - name: Query system for home directory
      command: getent passwd {{ user.name }}
      become: true
      register: user_home_directory
      changed_when: false

    - name: Set base home directory fact
      set_fact:
        user_home_directory: "{{ user_home_directory.stdout_lines[0].split(':')[5] }}"
  when: user_account_management is changed or user.home is defined

- name: Create .ssh directory for user
  file:
    path: "/home/{{ user.name }}/.ssh"
    state: directory
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
    mode: 0700
  become: true
  when:
    - user_account_management is changed or user.manage_ssh_key is defined
    - user.manage_ssh_key or user.private_keys is defined

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item.key }}"
    path: "{{ user.home }}/.ssh/authorized_keys"
    state: "{{ item.state | default('present') }}"
    exclusive: "{{ item.exclusive | default(omit) }}"
    manage_dir: false
  loop: "{{ user.authorized_keys }}"
  loop_control:
    label: "Deploy authorized_keys entry for {{ user.name }} (item: {{ item.key }})"
  become: true

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item.key }}"
    path: "{{ user.home }}/.ssh/authorized_keys"
    state: absent
    exclusive: "{{ item.exclusive | default(omit) }}"
    manage_dir: false
  loop: "{{ user.unauthorized_keys }}"
  loop_control:
    label: "Remove unauthorized_keys entry for {{ user.name }} (item: {{ item.key }})"
  become: true

- name: Copy generated private ssh key for user
  copy:
    src: "/home/{{ user.name }}/.ssh/id_rsa"
    dest: "{{ user.home }}/.ssh/id_rsa"
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
    mode: 0600
  become: true
  when:
    - user.copy_private_key is defined
    - user.copy_private_key

- name: Check users password valid time
  command: "getent shadow {{ user.name }}"
  become: true
  register: user_password_valid_time
  changed_when: false

- name: Set users password valid time
  command: "chage -d {{ user_password_valid_time.stdout_lines[0].split(':')[1] }} {{ user.name }}"
  become: true
  when:
    - user.password_valid_time is defined
    - user.password_valid_time
    - user_password_valid_time.stdout_lines[0] is defined

- name: Place private key file for user
  copy:
    content: "{{ item.content }}"
    dest: "{{ user.home }}/.ssh/{{ item.filename }}"
    owner: "{{ user.name }}"
    group: "{{ user.group | default(user.name) }}"
    mode: 0600
  loop: "{{ user.private_keys }}"
  loop_control:
    label: "Place private key file for {{ user.name }} (item: {{ item.filename }})"
  become: true
  when:
    - user.private_keys is defined
    - user.private_keys


