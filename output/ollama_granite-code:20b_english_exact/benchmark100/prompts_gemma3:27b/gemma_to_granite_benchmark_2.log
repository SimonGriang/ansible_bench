  run_once: yes
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- meta: flush_handlers

- name: Configure selinux
  selinux:
    policy: "{{ selinux_policy | default(omit) }}"
    state: "{{ selinux_state | default(omit) }}"
  when:
  - ansible_selinux.status is defined
  - ansible_connection != 'container'
  notify: Reboot

- name: Manage selinux booleans
  selinux:
    name: "{{ item.name }}"
    state: "{{ item.state | default('yes') }}"
    persistent: "{{ item.persistent | default(omit) }}"
  loop: "{{ selinux_booleans | default([]) }}"
  loop_control:
    label: "{{ item.name }}"
  when: selinux_booleans is defined


