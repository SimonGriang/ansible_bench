---
- name: Assert
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: "openjdk-{{ java_version }}"
    state: present
    env:
      USE: "=-demo,-corretto"
  when: java_vendor == "openjdk"

- name: Install RPM
  copy:
    src: "{{ java_local_rpm }}"
    dest: /tmp/
  when: java_source == "local" and java_format == "rpm"

- name: Install DEB
  copy:
    src: "{{ java_local_deb }}"
    dest: /tmp/
  when: java_source == "local" and java_format == "deb"

- name: Install oracle java (rpm) (repository)
  package:
    name: "java-{{ java_version }}-oracle"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  block:
    - name: Create installation directory
      file:
        path: "{{ java_install_dir }}"
        state: directory
    - name: Extract archive
      unarchive:
        src: "{{ java_local_targz }}"
        dest: "{{ java_install_dir }}"
        remote_src: true
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_local_jce_zip }}"
    dest: "{{ java_install_dir }}/jre/lib/security"
    remote_src: true
  when: java_jce and java_version == "8" and java_vendor == "oracle"

- name: Set alternative (targz)
  alternatives:
    name: java
    link: /etc/alternatives/java
    path: "{{ java_install_dir }}/jre/bin/java"
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java
  register: java_bin_path

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME=$(dirname $(readlink -f /usr/bin/java))"
    create: true


