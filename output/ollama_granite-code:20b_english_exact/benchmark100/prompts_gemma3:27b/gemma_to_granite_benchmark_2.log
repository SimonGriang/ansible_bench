  tasks:
  - name: Conditionally execute tasks
    yum:
      name: '*'
      state: latest
    when: ansible_distribution == "Amazon" or (ansible_distribution == "RedHat" and ansible_distribution_major_version in ["7", "8", "9", "10"])

- name: Install epel gpg key
  hosts: all
  tasks:
  - name: Install EPEL GPG key
    rpm_key:
      key: "{{ epel_gpg_key }}"
      state: present

- name: Install epel-release package
  hosts: all
  tasks:
  - name: Install epel-release package
    yum:
      name: "{{ epel_url }}"
      state: present
    notify:
    - Update package cache

- name: Install epel-next-release package
  hosts: all
  tasks:
  - name: Install epel-next-release package
    yum:
      name: "{{ epel_next_url }}"
      state: present
    notify:
    - Update package cache
    when: epel_next

- name: handlers
  hosts: all
  handlers:
  - name: Update package cache
    yum:
      update_cache: yes



