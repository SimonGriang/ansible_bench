---
- name: hashicorp_products_installation
  tasks:
    - import_tasks: assert.yml
    - block:
        - name: hashicorp_products_package_manager
          package:
            name: "{{ hashicorp_products }}"
            state: present
      when: hashicorp_installation_method == "package"
    - block:
        - name: hashicorp_repository_redhat
          get_url:
            url: "{{ hashicorp_debian_repo_url }}"
            dest: /etc/yum.repos.d/hashicorp.repo
            mode: 0640
      when: ansible_os_family == "RedHat"
    - block:
        - name: hashicorp_package_debian
          apt:
            update_cache: true
            state: present
      when: hashicorp_installation_method == "package" and ansible_os_family == "Debian"
    - block:
        - name: hashicorp_apt_key_debian
          apt_key:
            url: "{{ hashicorp_apt_key_url }}"
            state: present
            validate_certs: no
      when: hashicorp_installation_method == "package" and ansible_os_family == "Debian"
    - block:
        - name: hashicorp_apt_repository_debian
          apt_repository:
            repo: "deb {{ hashicorp_debian_repo_url }} {{ ansible_distribution_release | lower }} main"
            state: present
            filename: hashicorp
      when: hashicorp_installation_method == "package" and ansible_os_family == "Debian"
    - block:
        - name: hashicorp_products_package_manager
          package:
            name: "{{ hashicorp_products }}"
            state: present
      when: hashicorp_products is defined
    - block:
        - name: hashicorp_products_package_manager_latest
          package:
            name: "{{ item.name }}"
            state: latest
          loop: "{{ hashicorp_products }}"
          loop_control:
            label: "Install latest {{ item.name }}"
      when: hashicorp_products is defined
    - block:
        - name: hashicorp_products_package_manager_version
          package:
            name: "{{ version_coupler }}"
            state: present
          loop: "{{ hashicorp_products }}"
          loop_control:
            label: "Install version {{ item.version }} of {{ item.name }}"
      when: hashicorp_products is defined and item.version is defined
      vars:
        version_coupler: "{{ item.name }}{{ hashicorp_version_coupler }}{{ item.version }}"
    - block:
        - name: hashicorp_products_manual
          unarchive:
            src: "{{ hashicorp_src }}"
            dest: "{{ hashicorp_dest }}"
            group: "{{ hashicorp_group | default(omit) }}"
            mode: "{{ hashicorp_mode | default(omit) }}"
            owner: "{{ hashicorp_owner | default(omit) }}"
          loop: "{{ hashicorp_products }}"
          loop_control:
            label: "Install {{ item.name }} manually"
      when: hashicorp_installation_method == "manual"


