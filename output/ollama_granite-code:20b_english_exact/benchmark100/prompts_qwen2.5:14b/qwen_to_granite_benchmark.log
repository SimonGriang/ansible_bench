---
- name: Cordon and Drain the node {{ rke2_node_name }}
  shell: |
    export KUBECONFIG="{{ rke2_data_path }}/kube_config_cluster.yml"
    kubectl cordon {{ rke2_node_name }}
    kubectl drain {{ rke2_node_name }} {{ rke2_drain_additional_args }} --ignore-daemonsets --timeout=600s --retry-after=15s
  retries: 100
  delay: 15
  register: task1_result
  until: task1_result is succeeded
  changed_when: true

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2-server
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: |
    export KUBECONFIG="{{ rke2_data_path }}/kube_config_cluster.yml"
    kubectl wait node --for=condition=Ready --all
  retries: 100
  delay: 15
  register: task3_result
  until: task3_result is succeeded
  changed_when: true
  when: rke2_wait_for_all_nodes_to_be_ready

- name: Uncordon the node {{ rke2_node_name }}
  shell: |
    export KUBECONFIG="{{ rke2_data_path }}/kube_config_cluster.yml"
    kubectl uncordon {{ rke2_node_name }}
  changed_when: true
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
