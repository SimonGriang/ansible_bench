---
- name: selinux_pre_checks
  import_tasks: assert.yml
  tags:
    - selinux_pre_checks

- name: install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: gather_facts

- name: flush handlers
  meta: flush_handlers

- name: Configure selinux
  when:
    - selinux_status == "enabled"
    - (ansible_connection == "local" or ansible_user_dir == "/root")
  block:
    - name: manage selinux
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: reboot

    - name: manage selinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.name }}"



