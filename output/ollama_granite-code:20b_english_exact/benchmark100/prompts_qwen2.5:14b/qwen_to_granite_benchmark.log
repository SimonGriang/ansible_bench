---
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_service_mgr == "systemd"
    fail_msg: "This role only works with systemd as an init system."
    success_msg: "Systemd is used as init system."

- name: Get latest release of promtail
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: true
  register: promtail_release_info

- name: Set promtail_version variable
  set_fact:
    promtail_version: "{{ promtail_release_info['json']['tag_name'] }}"

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.{{ go_arch }}.zip"
  register: promtail_binary_stat

- name: Assert local binary exists
  assert:
    that:
      - promtail_binary_stat.stat.exists
    fail_msg: "Local binary does not exist."
    success_msg: "Local binary exists."
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/assets/{{ promtail_release_info['json']['assets'][0]['id'] }}
    return_content: true
  register: promtail_checksum_info

- name: Set promtail_checksum variable
  set_fact:
    promtail_checksum: "{{ item.split(' ')[0] }}"
  when: item.startswith(go_arch)
  with_items:
    - "{{ promtail_checksum_info['content'] | b64decode | split('\n') }}"


