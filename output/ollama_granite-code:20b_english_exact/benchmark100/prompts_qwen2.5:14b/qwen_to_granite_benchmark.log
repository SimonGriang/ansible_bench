- import_tasks: assert.yml
- name: Task 2 - Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present
- name: Task 3 - Create directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_dir_mode }}"
  loop:
    - "{{ dns_data_dir }}"
    - "{{ dns_config_dir }}"
    - "{{ dns_override_dir }}"
- name: Task 4 - Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    system: true
    state: present
- name: Task 5 - Create user
  ansible.builtin.user:
    name: "{{ dns_user }}"
    system: true
