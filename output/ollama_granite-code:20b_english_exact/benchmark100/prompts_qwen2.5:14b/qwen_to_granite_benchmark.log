---
- name: Configure virtual hosts
  hosts: all
  tasks:
    - name: Ensure document root directories are created for each virtual host
      file:
        path: "{{ item.documentroot }}"
        state: directory
        owner: "{{ item.owner | default(omit) }}"
        group: "{{ item.group | default(omit) }}"
        mode: 0755
      loop: "{{ httpd_vhosts }}"
      when: item.documentroot is defined and (item.create_docroot is undefined or item.create_docroot)

    - name: Create virtual host configuration files
      template:
        src: "{{ vhost_conf_template }}"
        dest: "{{ httpd_vhosts_directory }}{{ item.servername }}.conf"
        owner: root
        group: root
        mode: 0644
      loop: "{{ httpd_vhosts }}"
      notify:
        - test Apache configuration
        - restart Apache

    - name: Enable virtual hosts on Debian-based systems
      command: a2ensite {{ item.servername }}.conf
      args:
        creates: /etc/apache2/sites-enabled/{{ item.servername }}.conf
      loop: "{{ httpd_vhosts }}"
      when: ansible_os_family == 'Debian'
      notify:
        - test Apache configuration
        - restart Apache


