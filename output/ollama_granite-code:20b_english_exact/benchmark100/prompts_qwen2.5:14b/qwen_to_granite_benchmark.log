---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  raw: test -e /usr/bin/python || (apt -qqy update && apt install -qqy python-simplejson)
  register:bootstrap_result
  changed_when: "'failed' in bootstrap_result"
  failed_when: bootstrap_result.stderr != "" and "E: Repository 'http://archive.ubuntu.com/ubuntu bionic InRelease' changed its OpenPGP key" not in bootstrap_result.stderr
  until: bootstrap_result is succeeded
  retries: 10
  delay: 20
  run_once: true
  delegate_to: localhost
  when: not (ansible_connection == "local" or ansible_sudo_ executable.endswith('sudo'))

- name: Gather ansible facts
  setup:
    gather_subset: all
  delegate_to: localhost

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
  when: bootstrap_facts_packages is defined



