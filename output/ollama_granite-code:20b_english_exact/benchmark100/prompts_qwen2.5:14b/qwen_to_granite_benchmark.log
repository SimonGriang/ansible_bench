: 6362446, 'eval_count': 456, 'eval_duration': 10904270125, 'model_name': 'granite-code:20b'} id='run--68c4e9eb-4ded-45c2-ac28-95e4426b527a-0' usage_metadata={'input_tokens': 1144, 'output_tokens': 456, 'total_tokens': 1600}
