---
- name: "Check if python3.11 EXTERNALLY-MANAGED file exists"
  stat:
    path: "/opt/rh/python311/root/usr/bin/python3.11"
  register: python311_stat_result

- name: "Rename python3.11 EXTERNALLY-MANAGED file if it exists"
  copy:
    src: "/opt/rh/python311/root/usr/bin/python3.11"
    dest: "/opt/rh/python311/root/usr/bin/python3.11.old"
    remote_src: true
  when: python311_stat_result.stat.exists

- name: "Check if python3.12 EXTERNALLY-MANAGED file exists"
  stat:
    path: "/opt/rh/python312/root/usr/bin/python3.12"
  register: python312_stat_result

- name: "Rename python3.12 EXTERNALLY-MANAGED file if it exists"
  copy:
    src: "/opt/rh/python312/root/usr/bin/python3.12"
    dest: "/opt/rh/python312/root/usr/bin/python3.12.old"
    remote_src: true
  when: python312_stat_result.stat.exists

- import_tasks: assert.yml

- name: "Install python pip"
  package:
    name: "python{{ item.version }}"
    state: "{{ item.state }}"
  with_items: "{{ python_pip_packages }}"

- name: "Configure pip proxy"
  ini_file:
    path: /etc/pip.conf
    section: global
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    state: "{{ item.state }}"
  with_items:
    - key: http_proxy
      value: "{{ python_pip_proxy }}"
      state: "{{ 'present' if python_pip_proxy is defined else 'absent' }}"
    - key: https_proxy
      value: "{{ python_pip_proxy }}"
      state: "{{ 'present' if python_pip_proxy is defined else 'absent' }}"
  when: python_pip_proxy is defined

- name: "Trust hosts"
  ini_file:
    path: /etc/pip.conf
    section: global
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    state: "{{ item.state }}"
  with_items:
    - key: trusted_host
      value: "{{ python_pip_trusted_host }}"
      state: "{{ 'present' if python_pip_trusted_host is defined else 'absent' }}"
    - key: trusted_hosts
      value: "{{ python_pip_trusted_host }}"
      state: "{{ 'present' if python_pip_trusted_host is defined else 'absent' }}"
  when: python_pip_trusted_host is defined

- name: "Update pip"
  command: "pip{{ python_pip_version }} install --upgrade"
  args:
    warn: false
  register: pip_upgrade
  changed_when: pip_upgrade.stdout is not search("Default environment")
  when: python_pip_update | bool and (ansible_distribution != "Alpine" and ansible_os_family != "Bookworm" and ansible_os_family != "Noble")

- name: "Install requested modules"
  pip:
    executable: "pip{{ python_pip_version }}"
    name: "{{ item.name }}"
    version: "{{ item.version }}"
    state: "{{ item.state }}"
  with_items: "{{ python_pip_modules }}"
  when: (ansible_distribution != "Alpine" and ansible_os_family != "Bookworm" and ansible_os_family != "Noble")


