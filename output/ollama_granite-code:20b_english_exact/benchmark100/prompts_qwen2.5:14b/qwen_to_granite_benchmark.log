---
- name: Task 1 - Enable proxy modules in Apache
  block:
    - name: Enable proxy modules
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
      loop:
        - apache2
        - libapache2-mod-proxy-html
        - libapache2-mod-proxy-http
      when: ansible_os_family == "Debian"
    - name: Enable proxy modules
      community.general.zypper:
        name: "{{ item }}"
        state: present
      loop:
        - apache2
        - libapache2-mod-proxy-html
        - libapache2-mod-proxy-http
      when: ansible_os_family == "Suse"
    - name: Enable proxy modules
      ansible.builtin.yum:
        name: "{{ item }}"
        state: present
      loop:
        - httpd
        - mod_proxy_html
        - mod_proxy_http
      when: ansible_os_family == "RedHat"
  notify: Test Apache configuration
  handlers:
    - name: restart apache
      ansible.builtin.service:
        name: apache
        state: restarted

- name: Task 2 - Configure Apache locations using a template
  ansible.builtin.template:
    src: "apache.conf.j2"
    dest: "/etc/apache2/sites-available/example.com.conf"
    mode: "0644"
  notify: restart apache


