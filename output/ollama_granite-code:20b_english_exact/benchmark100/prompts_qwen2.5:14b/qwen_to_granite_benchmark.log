---
- import_tasks: assert.yml
  tags:
    - always

- name: Pre-configure debian systems
  become: true
  when: ansible_os_family == "Debian"
  block:
    - name: Set main_mailer_type to "No configuration"
      lineinfile:
        path: /etc/update-manager/release-upgrades
        regexp: '^main_mailer_type='
        line: 'main_mailer_type=No configuration'
        mode: 0644
      register: _update_manager_release_upgrades
    - name: Update update-manager release upgrade settings
      command: DEBIAN_FRONTEND=noninteractive dpkg-reconfigure -plow update-manager
      when: _update_manager_release_upgrades is changed
  tags:
    - configuration

- name: Install postfix
  become: true
  package:
    name: "{{ postfix_package_name }}"
    state: present
  tags:
    - packages

- name: Install postfix-mysql
  become: true
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined and "mysql" in postfix_virtual_mailbox_maps or postfix_virtual_mailbox_domains is defined and "mysql" in postfix_virtual_mailbox_domains or postix_virtual_alias_maps is defined and "mysql" in postix_virtual_alias_maps
  tags:
    - packages

- name: Configure postfix (transport_maps)
  become: true
  when: postfix_transport_maps is defined
  block:
    - name: Render transport_maps template
      template:
        src: transport_maps.j2
        dest: /etc/postfix/transport_maps
        mode: 0644
        validate: /usr/sbin/postmap %s
      register: postfix_transport_maps_template
    - name: Validate transport_maps configuration
      command: postmap /etc/postfix/transport_maps
      changed_when: false
      failed_when: _postmap_transport_maps.stdout_lines | length > 0
      notify: reload postfix
  handlers:
    - name: reload postfix
      become: true
      service:
        name: postfix
        state: restarted
  tags:
    - configuration

- name: Configure postfix (header_checks)
  become: true
  when: postfix_header_checks is defined
  block:
    - name: Render header_checks template
      template:
        src: header_checks.j2
        dest: /etc/postfix/header_checks
        mode: 0755
        validate: /usr/sbin/postmap %s
      register: postfix_header_checks_template
    - name: Validate header_checks configuration
      command: postmap /etc/postfix/header_checks
      changed_when: false
      failed_when: _postmap_header_checks.stdout_lines | length > 0
      notify: reload postfix
  handlers:
    - name: reload postfix
      become: true
      service:
        name: postfix
        state: restarted
  tags:
    - configuration

- name: Setting values for main.cf (1/2)
  become: true
  when: postfix_smtpd_recipient_restrictions is defined or postfix_smtpd_sender_restrictions is defined
  block:
    - name: Set fact for postfix_smtpd_recipient_restrictions
      set_fact:
        _postfix_smtpd_recipient_restrictions_fact: "{{ postfix_smtpd_recipient_restrictions }}"
    - name: Set fact for postfix_smtpd_sender_restrictions
      set_fact:
        _postfix_smtpd_sender_restrictions_fact: "{{ postfix_smtpd_sender_restrictions }}"
  tags:
    - configuration

- name: Setting values for main.cf (2/2)
  become: true
  when: postfix_mynetworks is defined or postfix_mydestination is defined or postfix_relay_domains is defined or _postfix_smtpd_recipient_restrictions_fact is defined or _postfix_smtpd_sender_restrictions_fact is defined or postfix_virtual_mailbox_domains is defined or postfix_virtual_alias_domains is defined
  block:
    - name: Set fact for postfix_mynetworks
      set_fact:
        _postfix_mynetworks_fact: "{{ postfix_mynetworks }}"
    - name: Set fact for postfix_mydestination
      set_fact:
        _postfix_mydestination_fact: "{{ postfix_mydestination }}"
    - name: Set fact for postfix_relay_domains
      set_fact:
        _postfix_relay_domains_fact: "{{ postfix_relay_domains }}"
    - name: Set fact for postfix_smtpd_recipient_restrictions
      set_fact:
        _postfix_smtpd_recipient_restrictions_fact: "{{ _postfix_smtpd_recipient_restrictions_fact }}"
    - name: Set fact for postfix_smtpd_sender_restrictions
      set_fact:
        _postfix_smtpd_sender_restrictions_fact: "{{ _postfix_smtpd_sender_restrictions_fact }}"
    - name: Set fact for postfix_virtual_mailbox_domains
      set_fact:
        _postfix_virtual_mailbox_domains_fact: "{{ postfix_virtual_mailbox_domains }}"
    - name: Set fact for postfix_virtual_alias_domains
      set_fact:
        _postfix_virtual_alias_domains_fact: "{{ postfix_virtual_alias_domains }}"
  tags:
    - configuration

- name: Configure postfix (main.cf)
  become: true
  when: postfix_mynetworks is defined or postfix_mydestination is defined or postfix_relay_domains is defined or _postfix_smtpd_recipient_restrictions_fact is defined or _postfix_smtpd_sender_restrictions_fact is defined or postfix_virtual_mailbox_domains is defined or postfix_virtual_alias_domains is defined
  block:
    - name: Render main.cf template
      template:
        src: main.cf.j2
        dest: /etc/postfix/main.cf
        mode: 0644
        validate: postconf -t -f %s
      register: postfix_main_cf_template
    - name: Reload postfix
      service:
        name: postfix
        state: restarted
  tags:
    - configuration

- name: Configure postfix (master.cf)
  become: true
  when: postfix_smtp_tls_wrappermode is defined
  block:
    - name: Render master.cf template
      template:
        src: master.cf.j2
        dest: /etc/postfix/master.cf
        mode: 0644
        validate: postconf -t -f %s
      register: postfix_master_cf_template
    - name: Reload postfix
      service:
        name: postfix
        state: restarted
  tags:
    - configuration

- name: Creates cert/key directory
  become: true
  when: postfix_smtpd_tls_cert_file is defined and postfix_smtpd_tls_key_file is defined
  block:
    - name: Create directories for TLS certificates and keys
      file:
        path: "{{ item }}"
        state: directory
        mode: 0700
      loop:
        - "{{ postfix_smtpd_tls_cert_file | dirname }}"
        - "{{ postfix_smtpd_tls_key_file | dirname }}"
  tags:
    - configuration

- name: Deploy Postfix TLS server certificate
  become: true
  when: postfix_smtpd_tls_cert_file is defined
  block:
    - name: Deploy Postfix TLS server certificate
      copy:
        src: "{{ postfix_smtpd_tls_cert_file }}"
        dest: "{{ postfix_smtpd_tls_cert_file }}"
        mode: 0644
        validate: postconf -e %s
      register: postfix_smtpd_tls_cert_file_copy
    - name: Reload postfix
      service:
        name: postfix
        state: restarted
      when: postfix_smtpd_tls_cert_file_copy is changed
  tags:
    - configuration

- name: Deploy Postfix TLS server key
  become: true
  when: postfix_smtpd_tls_key_file is defined
  block:
    - name: Deploy Postfix TLS server key
      copy:
        src: "{{ postfix_smtpd_tls_key_file }}"
        dest: "{{ postfix_smtpd_tls_key_file }}"
        mode: 0640
        validate: postconf -e %s
      register: postfix_smtpd_tls_key_file_copy
    - name: Reload postfix
      service:
        name: postfix
        state: restarted
      when: postfix_smtpd_tls_key_file_copy is changed
  tags:
    - configuration

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  become: true
  when: postfix_aliases is defined
  block:
    - name: Render aliases template
      template:
        src: aliases.j2
        dest: /etc/aliases
        mode: 0644
        validate: newaliases -v -f %s
      register: postfix_aliases_template
    - name: Rebuild alias database
      command: newaliases -v -f /etc/aliases
      changed_when: false
      notify: reload postfix
  handlers:
    - name: reload postfix
      become: true
      service:
        name: postfix
        state: restarted
  tags:
    - configuration

- name: Configure sender_access
  become: true
  when: postfix_sender_access is defined
  block:
    - name: Render sender_access template
      template:
        src: sender_access.j2
        dest: /etc/postfix/sender_access
        mode: 0644
        validate: postmap %s
      register: postfix_sender_access_template
    - name: Rebuild sender_access database
      command: postmap /etc/postfix/sender_access
      changed_when: false
      notify: reload postfix
  handlers:
    - name: reload postfix
      become: true
      service:
        name: postfix
        state: restarted
  tags:
    - configuration

- name: Configure recipient_access
  become: true
  when: postfix_recipient_access is defined
  block:
    - name: Render recipient_access template
      template:
        src: recipient_access.j2
        dest: /etc/postfix/recipient_access
        mode: 0644
        validate: postmap %s
      register: postfix_recipient_access_template
    - name: Rebuild recipient_access database
      command: postmap /etc/postfix/recipient_access
      changed_when: false
      notify: reload postfix
  handlers:
    - name: reload postfix
      become: true
      service:
        name: postfix
        state: restarted
  tags:
    - configuration

- name: Place sasl_password_map
  become: true
  when: postfix_sasl_password_map is defined
  block:
    - name: Render sasl_password_map template
      copy:
        content: "{{ postfix_sasl_password_map }}"
        dest: /etc/postfix/sasl_password_map
        mode: 0644
        validate: postmap %s
      register: postfix_sasl_password_map_template
    - name: Rebuild sasl_password_map database
      command: postmap /etc/postfix/sasl_password_map
      changed_when: false
      notify: reload postfix
  handlers:
    - name: reload postfix
      become: true
      service:
        name: postfix
        state: restarted
  tags:
    - configuration

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  become: true
  service:
    name: postfix
    state: started
    enabled: true


