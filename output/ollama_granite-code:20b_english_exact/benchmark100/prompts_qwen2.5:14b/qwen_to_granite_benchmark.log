---

- name: Task 1 - Import assert.yml
  include_tasks: assert.yml

- name: Task 2 - Install using package
  package:
    name: "{{ hashicorp_products }}"
    state: present
  when: hashicorp_use_package

- name: Task 3 - Install repository for RedHat
  yum_repository:
    name: hashicorp
    description: HashiCorp {{ hashicorp_products }}
    baseurl: "{{ hashicorp_repo_url }}"
    gpgcheck: no
    enabled: yes
    state: present
  when:
    - ansible_os_family == "RedHat"
    - hashicorp_use_package

- name: Task 4 - Configure debian
  apt_repository:
    filename: hashicorp
    repo: "deb {{ hashicorp_repo_url }} {{ ansible_distribution_release | lower }} main"
    state: present
  when:
    - ansible_os_family == "Debian"
    - hashicorp_use_package

- name: Task 5 - Install required package gpg
  package:
    name: gpg
    state: present
  when:
    - ansible_os_family == "Debian"
    - hashicorp_use_package

- name: Task 6 - Install apt key for Debian
  apt_key:
    url: https://apt.releases.hashicorp.com/gpg
    state: present
  when:
    - ansible_os_family == "Debian"
    - hashicorp_use_package

- name: Task 7 - Install repository for Debian
  apt_repository:
    filename: hashicorp
    repo: "deb {{ hashicorp_repo_url }} {{ ansible_distribution_release | lower }} main"
    state: present
  when:
    - ansible_os_family == "Debian"
    - hashicorp_use_package

- name: Task 8 - Install hashicorp product using package
  package:
    name: "{{ hashicorp_products }}"
    state: present
    version: "{{ hashicorp_version | default(omit) }}"
  when:
    - hashicorp_use_package
    - hashicorp_version is not defined or hashicorp_version == ""

- name: Task 9 - Install versioned hashicorp product using package
  package:
    name: "{{ hashicorp_products }}"
    state: present
    version: "{{ hashicorp_version }}"
  when:
    - hashicorp_use_package
    - hashicorp_version is defined and hashicorp_version != ""

- name: Task 10 - Install manually
  unarchive:
    src: "{{ hashicorp_url }}"
    dest: "{{ hashicorp_dest }}"
    owner: root
    group: root
    mode: "0755"
  when:
    - not hashicorp_use_package

- name: Task 11 - Install hashicorp product manually
  unarchive:
    src: "{{ hashicorp_url }}"
    dest: "{{ hashicorp_dest }}"
    owner: root
    group: root
    mode: "0755"
  when:
    - not hashicorp_use_package


