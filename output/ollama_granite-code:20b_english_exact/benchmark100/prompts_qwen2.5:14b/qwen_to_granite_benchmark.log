---
- name: rke2-install
  tasks:
  - name: Download RKE2 installation script
    get_url:
      url: https://github.com/rke2/rke2/releases/download/v1.23.15%2Brke2r1/rke2-install.sh
      dest: /usr/local/bin/rke2-install.sh
      mode: 0755
      timeout: 60
  - name: Copy local RKE2 installation script
    copy:
      src: files/rke2-install.sh
      dest: /usr/local/bin/rke2-install.sh
      mode: 0700
      force: yes
    when: rke2_airgap_mode and rke2_airgap_implementation == "copy"
  - name: Create RKE2 artifacts folder
    file:
      path: /usr/local/share/rke2/server/artifacts
      state: directory
      mode: 0700
    when: rke2_airgap_mode and rke2_airgap_implementation != "exists"
  - name: Download RKE2 checksum and artifacts
    block:
    - name: Download checksum file
      get_url:
        url: https://github.com/rke2/rke2/releases/download/v1.23.15%2Brke2r1/sha256sum-amd64.txt
        dest: /usr/local/share/rke2/server/artifacts/sha256sum-amd64.txt
        timeout: 60
    - name: Download artifacts
      get_url:
        url: https://github.com/rke2/rke2/releases/download/v1.23.15%2Brke2r1/rke2-amd64.tar.gz
        dest: /usr/local/share/rke2/server/artifacts/rke2-amd64.tar.gz
        timeout: 60
    - name: Download install script
      get_url:
        url: https://github.com/rke2/rke2/releases/download/v1.23.15%2Brke2r1/rke2-install.sh
        dest: /usr/local/share/rke2/server/artifacts/rke2-install.sh
        timeout: 60
    when: rke2_airgap_mode and rke2_airgap_implementation == "download"
  - name: Rescue for failed download
    block:
    - name: Create rescue directory
      file:
        path: /usr/local/share/rke2/server/artifacts
        state: directory
        mode: 0700
    - name: Download rescue artifacts
      get_url:
        url: https://github.com/rke2/rke2/releases/download/v1.23.15%2Brke2r1/rke2-amd64.tar.gz
        dest: /usr/local/share/rke2/server/artifacts/rke2-amd64.tar.gz
