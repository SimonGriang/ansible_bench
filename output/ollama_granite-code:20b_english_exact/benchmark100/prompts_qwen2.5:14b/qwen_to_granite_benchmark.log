---

- name: Task 1, Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2, Install python pip
  pip:
    name: "{{ python_pip_name }}"
    executable: pip{{ python_pip_executable_version }}

- name: Task 3, Configure pip proxy
  block:
    - name: "Add proxy to /etc/pip.conf"
      lineinfile:
        dest: /etc/pip.conf
        line: "proxy={{ python_pip_proxy }}"
        create: yes
  when: python_pip_proxy is defined

- name: Task 4, Trust hosts
  block:
    - name: "Add trusted host to /etc/pip.conf"
      lineinfile:
        dest: /etc/pip.conf
        line: "trusted-host={{ python_pip_trusted_host }}"
        create: yes
  when: python_pip_trusted_host is defined

- name: Task 5, Update pip
  pip:
    name: pip
    executable: pip{{ python_pip_executable_version }}
    state: latest
  when: python_pip_update and not ( ansible_distribution == " bookworm" or ansible_distribution == "noble" ) and not ( ansible_os_family == "Alpine" )

- name: Task 6, Install requested modules
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default(omit) }}"
    state: "{{ item.state | default('present') }}"
    executable: pip{{ python_pip_executable_version }}
  loop: "{{ python_pip_modules }}"
  when: not ( ansible_distribution == "bookworm" or ansible_distribution == "noble" ) and not ( ansible_os_family == "Alpine" )


