---
- import_tasks: assert.yml

- name: Task 2 - Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Task 3 - Create directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_dir_mode }}"
  loop:
    - "{{ dns_data_dir }}"
    - "{{ dns_config_dir }}"
    - "{{ dns_override_dir }}"

- name: Task 4 - Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    system: true
    state: present

- name: Task 5 - Create user
  ansible.builtin.user:
    name: "{{ dns_user }}"
    system: true
    group: "{{ dns_group }}"
    home: "{{ dns_data_dir }}"
    createhome: false

- name: Task 6 - Generate rndc key
  ansible.builtin.shell: rndc-confgen -a
  args:
    creates: "{{ dns_key_file }}"

- name: Task 7 - Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ dns_key_file }}"
    mode: "0600"

- name: Task 8 - Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ dns_root_hints }}"
    dest: "{{ dns_data_dir }}/root.hints"

- name: Task 9 - Create zone file
  ansible.builtin.template:
    src: named.{{ dns_type }}.j2
    dest: "{{ dns_config_dir }}/named.{{ dns_type }}"
    mode: "{{ dns_file_mode }}"
  notify: restart dns

- name: Task 10 - Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: "{{ dns_config_dir }}/named.conf"
    mode: "{{ dns_file_mode }}"
  notify: restart dns

- name: Task 11 - Place systemd override
  ansible.builtin.copy:
    src: "{{ dns_systemd_override }}"
    dest: "{{ dns_override_dir }}/{{ dns_service_name }}.conf"
    mode: "{{ dns_file_mode }}"
  notify: restart dns

- name: Task 12 - Start and enable dns
  ansible.builtin.service:
    name: "{{ dns_service_name }}"
    state: started
    enabled: true


