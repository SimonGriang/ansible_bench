---

- name: "RKE2 | Create config dir"
  file:
    path: "{{ rke2_config_dir }}"
    state: directory
    owner: root
    group: root
    mode: 0755

- name: "RKE2 | Set server taints"
  command: >
    {{ bin_dir }}/kubectl taint nodes --all node-role.kubernetes.io/control-plane:NoSchedule --overwrite
  when:
    - rke2_type == "server"

- name: "RKE2 | Set agent taints"
  command: >
    {{ bin_dir }}/kubectl taint nodes --all node-role.kubernetes.io/control-plane:NoExecute --overwrite
  when:
    - rke2_type == "agent"

- name: "RKE2 | Copy RKE2 config file"
  template:
    src: "rke2.yml.j2"
    dest: "{{ rke2_config_dir }}/rke2.yml"
    owner: root
    group: root
    mode: 0644
  register: rke2_config_file

- name: "RKE2 | Copy kubelet config file"
  template:
    src: "kubelet.conf.j2"
    dest: "{{ rke2_config_dir }}/kubelet.conf"
    owner: root
    group: root
    mode: 0644
  when:
    - kubelet_arg_node_labels is defined
  register: kubelet_config_file

- name: "RKE2 | Copy Containerd Registry Configuration file"
  template:
    src: "registry.conf.j2"
    dest: "{{ rke2_config_dir }}/registry.conf"
    owner: root
    group: root
    mode: 0644
  when:
    - containerd_registry_mirrors is defined
    - containerd_registry_configs is defined
  register: containerd_config_file

- name: "RKE2 | Start RKE2 service"
  systemd:
    name: rke2-server
    state: started
    daemon_reload: yes
  register: rke2_service

- name: "RKE2 | Mask other RKE2 services"
  systemd:
    name: "{{ item }}"
    enabled: no
    state: stopped
    masked: yes
  loop:
    - rke2-agent
    - rke2-server
    - rke2-update
  when:
    - rke2_type == "agent"

- name: "RKE2 | Wait for remaining nodes to be ready - no CNI"
  command: >
    {{ bin_dir }}/kubectl wait node --for condition=Ready --timeout=60s --all
  args:
    warn: false
  register: wait_result
  until:
    - wait_result is succeeded
  retries: 60
  delay: 2

- name: "RKE2 | Wait for remaining nodes to be ready - with CNI"
  command: >
    {{ bin_dir }}/kubectl wait --for=jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 
    node --all
  args:
    warn: false
  register: wait_result
  until:
    - wait_result is succeeded
    - wait_result.stdout == "True"
  retries: 60
