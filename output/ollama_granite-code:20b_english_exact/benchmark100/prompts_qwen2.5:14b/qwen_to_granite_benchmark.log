---

- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Install required software
  package:
    name: "{{ item.name }}"
    state: present
  loop: "{{ users_requirements }}"
  when:
    - users_requirements is defined
    - users_requirements | length > 0

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  when:
    - users_groups is defined

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "#includedir {{ users_sudo_includedir }}"
    state: present
  when:
    - users_sudo_includedir is defined
    - users_sudo_includedir | length > 0

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users }}"
  when:
    - users is defined

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
  when:
    - users_cron_allow is defined

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when:
    - users_cron_allow is not defined


