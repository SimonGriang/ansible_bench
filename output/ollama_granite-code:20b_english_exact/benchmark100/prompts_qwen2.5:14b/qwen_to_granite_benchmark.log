ode:20b', 'created_at': '2025-10-08T13:55:34.852554066Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11845089612, 'load_duration': 33129549, 'prompt_eval_count': 587, 'prompt_eval_duration': 513742299, 'eval_count': 495, 'eval_duration': 11297635274, 'model_name': 'granite-code:20b'} id='run--a7743992-d6f3-4d7c-944a-a62fe124c714-0' usage_metadata={'input_tokens': 587, 'output_tokens': 495, 'total_tokens': 1082}
