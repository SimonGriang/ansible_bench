ration': 30034171, 'prompt_eval_count': 680, 'prompt_eval_duration': 419408787, 'eval_count': 554, 'eval_duration': 11797303280, 'model_name': 'granite-code:20b'} id='run--81e31827-b2bb-42a5-a8d7-a6faeb07883d-0' usage_metadata={'input_tokens': 680, 'output_tokens': 554, 'total_tokens': 1234}
