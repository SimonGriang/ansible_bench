---
- name: Check if certificates exist
  stat:
    path: "{{ item }}"
  loop: "{{ java_certs }}"
  register: java_certs_stat_result

- name: Fail if some certificate doesn't exist
  fail:
    msg: "Certificate {{ item }} doesn't exist"
  loop: "{{ java_certs }}"
  when: not item.stat.exists

- name: Setting keystore variables in java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: java_open_jdk_version_major | int < 11

- name: Setting keystore variables in java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: java_open_jdk_version_major | int >= 11

- name: Import SSL certificates
  java_cert:
    executable: "{{ java_open_jdk_home }}/bin/keytool"
    state: present
    alias: "{{ item.alias | default(omit) }}"
    certificate_path: "{{ item.certificate_path | default(omit) }}"
    certificate_url: "{{ item.certificate_url | default(omit) }}"
    dynamic: "{{ item.dynamic | default(omit) }}"
    express_protocol_enabled: "{{ item.express_protocol_enabled | default(omit) }}"
    key_algorithm: "{{ item.key_algorithm | default(omit) }}"
    key_password: "{{ item.key_password | default(omit) }}"
    keystore: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts"
    keystore_password: "{{ java_keystore_password }}"
    keystore_type: jks
    owner: "{{ java_owner }}"
    path: "{{ item.path | default(omit) }}"
    private_key_path: "{{ item.private_key_path | default(omit) }}"
    private_key_url: "{{ item.private_key_url | default(omit) }}"
    privatekey_passphrase: "{{ item.privatekey_passphrase | default(omit) }}"
    state: "{{ item.state | default(omit) }}"
    trustcacerts: "{{ item.trustcacerts | default(omit) }}"
    truststore_path: "{{ item.truststore_path | default(omit) }}"
    truststore_password: "{{ item.truststore_password | default(omit) }}"
    truststore_type: jks
    unsafe_writes: "{{ item.unsafe_writes | default(omit) }}"
    validate_certs: "{{ item.validate_certs | default(omit) }}"
  loop: "{{ java_certs }}"



