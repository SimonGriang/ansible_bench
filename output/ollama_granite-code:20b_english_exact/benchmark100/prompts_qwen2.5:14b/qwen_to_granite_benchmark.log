---

- import_tasks: assert.yml

- name: Pre-configure debian systems
  lineinfile:
    path: /etc/update-manager/release-upgrades
    regexp: '^#?main_mailer_type='
    line: 'main_mailer_type="No configuration"'
    backrefs: yes
  when: ansible_os_family == "Debian"

- name: Install postfix
  package:
    name: postfix
    state: present
  notify: restart postfix

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined or postfix_virtual_mailbox_domains is defined or postix_virtual_alias_maps is defined
  notify: restart postfix

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: "0644"
    owner: root
    group: root
  notify:
    - validate configuration
    - rebuild transport_maps database
    - restart postfix

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: "0644"
    owner: root
    group: root
  notify:
    - validate configuration
    - reload postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default([]) }}"
  when: postfix_smtpd_recipient_restrictions is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf:
      - { key: mynetworks, value: "{{ postfix_mynetworks | default([]) }}" }
      - { key: mydestination, value: "{{ postfix_mydestination | default([]) }}" }
      - { key: relay_domains, value: "{{ postfix_relay_domains | default([]) }}" }
      - { key: smtpd_recipient_restrictions, value: "{{ postfix_smtpd_recipient_restrictions }}" }
      - { key: smtpd_sender_restrictions, value: "{{ postfix_smtpd_sender_restrictions | default([]) }}" }
      - { key: virtual_mailbox_domains, value: "{{ postfix_virtual_mailbox_domains | default([]) }}" }
      - { key: virtual_alias_domains, value: "{{ postfix_virtual_alias_domains | default([]) }}" }

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: "0644"
    owner: root
    group: root
  notify:
    - validate configuration
    - restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: "0644"
    owner: root
    group: root
  notify: restart postfix

- name: Creates cert/key directory
  file:
    path: /etc/postfix/cert
    state: directory
    mode: "0755"
    owner: root
    group: root
  when: postfix_smtpd_tls_cert_file is defined or postfix_smtpd_tls_key_file is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file }}"
    dest: /etc/postfix/cert/server.pem
    mode: "0644"
    owner: postfix
    group: postfix
  notify: reload postfix
  when: postfix_smtpd_tls_cert_file is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file }}"
    dest: /etc/postfix/cert/server.key
    mode: "0600"
    owner: postfix
    group: postfix
  notify: reload postfix
  when: postfix_smtpd_tls_key_file is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/postfix/aliases
    mode: "0644"
    owner: root
    group: root
  notify:
    - rebuild alias database
    - reload postfix

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
