---
- name: Task 1 - Enable proxy and proxy_http modules on Debian and Suse systems
  block:
    - name: Debian | Enable proxy module
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
      loop:
        - libapache2-mod-proxy-html
        - libapache2-mod-proxy-http
        - libapache2-mod-proxy
      notify: restart apache
    - name: Suse | Enable proxy module
      ansible.builtin.zypper:
        name: "{{ item }}"
        state: present
      loop:
        - libapache2-mod_proxy
        - libapache2-mod_proxy_http
        - libapache2-mod_proxy_wstunnel
      notify: restart apache
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"

- name: Task 2 - Configure locations using a template
  template:
    src: location.conf.j2
    dest: /etc/httpd/conf.d/location.conf
    mode: "0644"
  notify: configtest and restart apache


