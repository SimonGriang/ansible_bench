      copy:
        src: files/rke2-amd64.tar.gz
        dest: /var/lib/rke2/agent/artifacts/rke2-amd64.tar.gz
        mode: "0640"
        force: yes

    - name: Copy rescue local install script
      copy:
        src: files/rke2-install.sh
        dest: /var/lib/rke2/agent/artifacts/rke2-install.sh
        mode: "0640"
        force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation == "download" and not download_checksum.changed and not download_artifacts.changed and not download_install_script.changed

- name: Copy local RKE2 artifacts
  copy:
    src: files/rke2-amd64.tar.gz
    dest: /var/lib/rke2/agent/artifacts/rke2-amd64.tar.gz
    mode: "0640"
    force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images folder
      file:
        path: /var/lib/rke2/agent/artifacts/additional-images
        state: directory
        mode: "0700"

    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: /var/lib/rke2/agent/artifacts/additional-images/
        mode: "0640"
        force: yes
      with_items: "{{ rke2_airgap_copy_additional_tarballs }}"
  when: rke2_airgap_mode and rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure artifacts exist
      file:
        path: "{{ item }}"
        state: file
        mode: "0640"
      loop:
        - /var/lib/rke2/agent/artifacts/sha256sum-amd64.txt
        - /var/lib/rke2/agent/artifacts/rke2-amd64.tar.gz
        - /var/lib/rke2/agent/artifacts/rke2-install.sh

    - name: Check artifact permissions
      stat:
        path: "{{ item }}"
      register: artifact_permissions
      loop:
        - /var/lib/rke2/agent/artifacts/sha256sum-amd64.txt
        - /var/lib/rke2/agent/artifacts/rke2-amd64.tar.gz
        - /var/lib/rke2/agent/artifacts/rke2-install.sh

    - name: Fix artifact permissions
      file:
        path: "{{ item.stat.path }}"
        mode: "0640"
      loop: "{{ artifact_permissions.results }}"
      when: item.stat.mode | string not in ["0640", "0600"]
  when: rke2_airgap_mode and rke2_airgap_implementation == "exists"

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: fs_object_stats

- name: Check if separate partition
  shell: grep /usr/local /proc/mounts
  register: separate_partition_check
  changed_when: false

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin/rke2"
  when:
    - "'rke2' in services"
    - fs_object_stats.stat.exists
    - separate_partition_check.rc == 1

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/opt/rke2/bin/rke2"
  when:
    - "'rke2' in services"
    - fs_object_stats.stat.exists
    - separate_partition_check.rc == 0

- name: Check RKE2 version
  command: "{{ rke2_bin_path }} version --client"
  changed_when: false
  register: rke2_installed_version

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_installed_version.stdout_lines[1] }}"
    rke2_running_version: "{{ rke2_installed_version.stdout_lines[2] }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  fail:
    msg: "Newer RKE2 version already installed on host. RKE2 downgrades are disabled by default. Use rke2_allow_downgrade to enable them."
  when: rke2_installed_version.stdout is version_compare(rke2_running_version, '<') and not rke2_allow_downgrade

- name: Run RKE2 install script
  command: >
    {{ rke2_bin_path }} install --install-image "{{ rke2_image_url }}" --upload-server "{{ rke2_upgrade_server_url }}" --upgrade
  environment:
    RKE2_RELEASE_VERSION: "{{ rke2_upgrade_version }}"
    RKE2_INSTALL_IMAGE_TAG: "{{ rke2_image_tag }}"
    RKE2_INSTALL_ARM64: "{{ rke2_arm64 }}"
    RKE2_INSTALL_AIRgap: "true"
    RKE2_INSTALL_ceb: "false"
    RKE2_TARBALL_PATH: "{{ rke2_airgap_tarball_path }}"
    RKE2_CHECKSUM: "{{ rke2_airgap_checksum_path }}"
    RKE2_EXPERIMENTAL: "{{ rke2_experimental }}"
    RKE2_VERSION: "{{ rke2_version }}"
  when:
    - not ansible_check_mode
    - rke2_upgrade
    - rke2_installed_version.stdout is version_compare(rke2_running_version, '<')

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: /var/lib/rke2/agent/pod-manifests/
    mode: "0640"
    owner: root
    group: root
  with_fileglob:
    - files/manifests/*.yaml
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: /etc/kubernetes/manifests/
    mode: "0644"
    owner: root
    group: root
  with_fileglob:
    - files/static-pods/*
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  template:
    src: files/rke2.env.j2
    dest: /var/lib/rke2/rke2.env
    mode: "0640"
    owner: root
    group: root
  when: rke2_environment_options is defined and rke2_environment_options | length > 0


