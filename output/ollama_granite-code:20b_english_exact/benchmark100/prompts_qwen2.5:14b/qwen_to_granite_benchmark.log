---
- name: Create directory for storing RKE2 server-side manifests
  file:
    path: "{{ rke2_manifests_dir }}"
    state: directory
    mode: 0750

- name: Copy kube-vip files to first server
  copy:
    src: "kube-vip/{{ item }}"
    dest: "{{ rke2_manifests_dir }}/{{ item | replace('.j2', '') }}"
    mode: 0640
  with_items:
    - kube-vip.yaml.j2
    - kube-vip-config.yaml.j2

- name: Copy kube-vip load balancer manifests to first server
  when: cloud_provider_enabled
  copy:
    src: "kube-vip-loadbalancer/{{ item }}"
    dest: "{{ rke2_manifests_dir }}/{{ item | replace('.j2', '') }}"
    mode: 0640
  with_items:
    - kube-vip-loadbalancer.yaml.j2
    - kube-vip-cloud-provider.yaml.j2


