---
- name: cadvisor | create directories
  file:
    path: "{{ cadvisor_install_dir }}/{{ item }}"
    owner: root
    group: root
    state: directory
  loop:
    - db
    - log

- name: cadvisor | download
  unarchive:
    src: "https://github.com/google/cadvisor/releases/download/v{{ cadvisor_version }}/cadvisor-{{ cadvisor_version }}.linux-arm64.tar.gz"
    dest: "{{ cadvisor_install_dir }}"
    remote_src: true
    owner: root
    group: root
    mode: 0644
  register: downloaded
  until: downloaded is succeeded
  retries: 3
  delay: 10
  when: cadvisor_local_dir is not defined

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: "{{ cadvisor_local_dir }}/cadvisor"
    dest: "{{ cadvisor_install_dir }}/cadvisor/cadvisor"
    owner: root
    group: root
    mode: 0755
  notify: cadvisor | server systemd service
  when: cadvisor_local_dir is defined

- name: cadvisor | symlink
  file:
    src: "{{ cadvisor_install_dir }}/cadvisor/cadvisor"
    dest: /usr/local/bin/cadvisor
    owner: root
    group: root
    state: link

- name: cadvisor | server systemd service
  template:
    src: templates/cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    owner: root
    group: root
    mode: 0644
  notify:
    - cadvisor | enable server systemd
    - cadvisor | start server systemd

- name: test_task
  service_facts:

- name: debug | var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemd:
    name: cadvisor.service
    enabled: true
    daemon_reload: true

- name: cadvisor | start server systemd
  systemd:
    name: cadvisor.service
    state: started


