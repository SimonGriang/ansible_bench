---

- import_tasks: assert.yml
- name: Uninstall conflicting systemd-logger
  package:
    name: systemd-logger
    state: absent
  tags:
    - rsyslog

- name: Install rsyslog
  package:
    name: "{{ rsyslog_package_name }}"
    state: "{{ rsyslog_package_state }}"
  register: rsyslog_install_package
  until: rsyslog_install_package is succeeded
  retries: 5
  delay: 20
  tags:
    - rsyslog

- name: Install additional rsyslog packages
  package:
    name: "{{ item }}"
    state: present
  register: rsyslog_install_package
  until: rsyslog_install_package is succeeded
  retries: 5
  delay: 20
  with_items: "{{ rsyslog_features }}"
  tags:
    - rsyslog

- block:
    - name: Render default rsyslog config
      template:
        src: rsyslog.conf.j2
        dest: /etc/rsyslog.conf
        mode: 0644
        owner: root
        group: root
      register: rsyslog_config
    - name: Deploy default rsyslog config
      command: /bin/systemctl restart rsyslog
      when: rsyslog_config.changed
  when: rsyslog_deploy_default_config | bool
  tags:
    - rsyslog

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d/
    state: directory
    owner: root
    group: root
    mode: 0755
  tags:
    - rsyslog

- block:
    - name: Render rsyslog forward rule config
      template:
        src: forward.conf.j2
        dest: /etc/rsyslog.d/30-forward.conf
        mode: 0644
        owner: root
        group: root
      register: rsyslog_config
    - name: Deploy rsyslog forward rule config
      command: /bin/systemctl restart rsyslog
      when: rsyslog_config.changed
  when: not rsyslog_deploy_default_config | bool
  tags:
    - rsyslog

- name: Configuring additional config files
  copy:
    src: "{{ item }}"
    dest: /etc/rsyslog.d/
    mode: 0644
    owner: root
    group: root
  with_items: "{{ rsyslog_config_files }}"
  tags:
    - rsyslog

- name: Start and enable rsyslog
  service:
    name: rsyslog
    state: started
    enabled: yes
  tags:
    - rsyslog


