---
- name: Create RKE2 directories
  file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: 0755
  loop:
    - /etc/rancher/rke2
    - /etc/cni/net.d
    - /opt/cni/bin

- name: Set server taints
  command: >
    kubectl taint nodes --all node-role.kubernetes.io/control-plane:NoSchedule
  when: rke2_type == "server"

- name: Set agent taints
  command: >
    kubectl taint nodes --all node-role.kubernetes.io/control-plane:NoExecute
  when: rke2_type == "agent"

- name: Copy RKE2 config
  copy:
    src: /path/to/rke2.yaml
    dest: /etc/rancher/rke2/rke2.yaml
  notify: restart rke2

- name: Copy kubelet config
  copy:
    src: /path/to/kubelet.conf
    dest: /etc/kubernetes/kubelet.conf
  notify: restart rke2
  when: kubelet_arg_list is not null

- name: Copy Containerd Registry Configuration
  copy:
    src: /path/to/regsitry.yaml
    dest: /etc/rancher/rke2/registry.yaml
  notify: restart rke2
  when: containerd_registry_mirrors is defined

- name: Start RKE2 service
  service:
    name: rke2-server
    state: started
  notify: restart rke2

- name: Mask other RKE2 services
  command: >
    systemctl mask rke2-agent
  when: rke2_type == "server"

- name: Wait for remaining nodes to be ready - no CNI
  command: >
    kubectl wait --for=condition=Ready node
  retries: 100
  delay: 10
  when: rke2_type == "server" and cni == "none"

- name: Wait for remaining nodes to be ready - with CNI
  command: >
    kubectl wait --for=condition=Ready node
  retries: 100
  delay: 10
  when: rke2_type == "server" and cni != "none"


