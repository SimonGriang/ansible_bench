le AppArmor enforcement for the vault binary if it is currently enabled\n      tags: skip_ansible_lint\n      command: aa-enforce /usr/local/bin/vault\n      when: ansible_apparmor.enforcing | default(false) | bool' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-18T16:57:59.99958489Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16218003973, 'load_duration': 35114731, 'prompt_eval_count': 1493, 'prompt_eval_duration': 11903056, 'eval_count': 577, 'eval_duration': 16169639555, 'model_name': 'granite-code:20b'} id='run--53851f59-d2f7-44c0-92f1-f0f1413afc9b-0' usage_metadata={'input_tokens': 1493, 'output_tokens': 577, 'total_tokens': 2070}
