---
- name: Bootstrap
  tasks:
    - name: Lookup bootstrap facts
      command: cat /etc/os-release
      register: bootstrap_facts
      changed_when: false

    - name: Set bootstrap facts (I)
      set_fact:
        bootstrap_distribution: "{{ bootstrap_os_family_map[bootstrap_facts['stdout'] | from_json | json_query('NAME') | lower ] }}"
