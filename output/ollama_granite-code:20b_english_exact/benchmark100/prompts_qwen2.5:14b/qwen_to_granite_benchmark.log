---
- name: Task 1
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Task 2
  command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki

- name: Task 3
  command: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/ca.crt

- name: Task 4
  command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/dh2048.pem

- name: Task 5
  command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/server.crt

- name: Task 6
  command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/client.crt

- name: Task 7
  command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/crl.pem

- name: Task 8
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Task 9
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn/server
    mode: 0600
  with_items:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/ta.key
    - /etc/openvpn/easy-rsa/pki/dh2048.pem
    - /etc/openvpn/easy-rsa/pki/server.crt
    - /etc/openvpn/easy-rsa/pki/server.key
    - /etc/openvpn/easy-rsa/pki/crl.pem

- name: Task 10
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn
    mode: 0600
  with_items:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/ta.key
    - /etc/openvpn/easy-rsa/pki/dh2048.pem
    - /etc/openvpn/easy-rsa/pki/server.crt
    - /etc/openvpn/easy-rsa/pki/server.key
    - /etc/openvpn/easy-rsa/pki/crl.pem

- name: Task 11
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
  notify: restart openvpn


