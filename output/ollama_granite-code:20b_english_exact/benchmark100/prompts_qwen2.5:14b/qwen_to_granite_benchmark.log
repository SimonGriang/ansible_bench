---
- name: Create SSL keys, CSRs, certificates, PKCS#12 file, and combined private_key and certificate files
  become: yes
  with_items:
    - { key_file: "item1_key", csr_file: "item1_csr", cert_file: "item1_cert", pkcs12_file: "item1_pkcs12", combined_file: "item1_combined", owner: "owner1", group: "group1", common_name: "common_name1", friendly_name: "friendly_name1" }
    - { key_file: "item2_key", csr_file: "item2_csr", cert_file: "item2_cert", pkcs12_file: "item2_pkcs12", combined_file: "item2_combined", owner: "owner2", group: "group2", common_name: "common_name2", friendly_name: "friendly_name2" }
  tasks:
    - name: Create ssl key
      openssl_privatekey:
        path: "{{ item.key_file }}"
        mode: 640
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
      loop: "{{ items }}"
    - name: Create ssl csr
      openssl_csr:
        path: "{{ item.csr_file }}"
        privatekey_path: "{{ item.key_file }}"
        mode: 644
        common_name: "{{ item.common_name }}"
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
      loop: "{{ items }}"
    - name: Create ssl certificates
      openssl_certificate:
        path: "{{ item.cert_file }}"
        privatekey_path: "{{ item.key_file }}"
        csr_path: "{{ item.csr_file }}"
        mode: 644
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
      loop: "{{ items }}"
    - name: Create PKCS#12 file
      openssl_pkcs12:
        path: "{{ item.pkcs12_file }}"
        privatekey_path: "{{ item.key_file }}"
        certificate_path: "{{ item.cert_file }}"
        mode: 640
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        friendly_name: "{{ item.friendly_name }}"
      loop: "{{ items }}"
    - name: Read private key
      slurp:
        src: "{{ item.key_file }}"
      loop: "{{ items }}"
    - name: Read certificate
      slurp:
        src: "{{ item.cert_file }}"
      loop: "{{ items }}"
    - name: Create combined private_key and certificate file
      copy:
        dest: "{{ item.combined_file }}"
        content: "{{ private_key.content + certificate.content }}"
        mode: 640
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
      loop: "{{ items }}"


