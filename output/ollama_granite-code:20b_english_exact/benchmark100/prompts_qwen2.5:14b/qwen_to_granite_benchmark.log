---
- name: Bootstrap | Gather facts
  hosts: all
  tasks:
    - name: Lookup bootstrap facts
      ansible.builtin.setup:
        filter: ansible_local
        fact_path: /etc/ansible/facts.d
        gather_subset: all

    - name: Set bootstrap facts (I)
      ansible.builtin.set_fact:
        bootstrap_distribution: "{{ ansible_local.system.distribution }}"
        bootstrap_distribution_major_version: "{{ item.regex | regex_search(ansible_local.system.distribution_version, '\\d+(\\.\\d+)?$') }}"
      loop: "{{ bootstrap_os_family_map }}"
      when: ansible_local.system.distribution is defined
      delegate_to: localhost
      run_once: true

    - name: Set bootstrap facts (II)
      ansible.builtin.set_fact:
        bootstrap_os_family: "{{ item.value }}"
      loop: "{{ bootstrap_os_family_map }}"
      when:
        - bootstrap_distribution is defined
        - bootstrap_distribution in item.key
      delegate_to: localhost
      run_once: true


