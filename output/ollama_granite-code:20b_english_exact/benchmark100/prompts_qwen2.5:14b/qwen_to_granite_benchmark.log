---
- name: Check if Helm binary exists
  stat:
    path: /tmp/helm
  register: helm_binary

- name: Check Helm version
  command: helm version
  args:
    warn: false
  register: helm_version
  when: helm_binary.stat.exists

- name: Download helm
  get_url:
    url: https://get.helm.sh/helm-v3.5.0-linux-amd64.tar.gz
    dest: /tmp/helm.tar.gz
  when: not helm_binary.stat.exists or helm_version.stdout is version('3.5.0', '<')

- name: Unpack helm
  unarchive:
    src: /tmp/helm.tar.gz
    dest: /tmp
    remote_src: true
  when: not helm_binary.stat.exists or helm_version.stdout is version('3.5.0', '<')

- name: Copy helm binary into place
  copy:
    src: /tmp/linux-amd64/helm
    dest: /usr/local/bin/helm
    mode: 0755
    remote_src: true
  when: not helm_binary.stat.exists or helm_version.stdout is version('3.5.0', '<')



