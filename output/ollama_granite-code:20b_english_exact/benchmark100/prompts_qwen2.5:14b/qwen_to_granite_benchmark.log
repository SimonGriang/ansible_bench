- name: Install requirements
  ansible.builtin.package:
    name: "{{ sysctl_requirements }}"
    state: present
  when: sysctl_requirements is defined

- name: Set sysctl setting
  ansible.posix.sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: "{{ item.state | default('present') }}"
    reload: "{{ item.reload | default(omit) }}"
    sysctl_file: /etc/sysctl.d/99-ansible.conf
    sysctl_set: "{{ item.sysctl_set | default(omit) }}"
  loop: "{{ sysctl_items }}"
  when: sysctl_items is defined and not ansible_container_environment


