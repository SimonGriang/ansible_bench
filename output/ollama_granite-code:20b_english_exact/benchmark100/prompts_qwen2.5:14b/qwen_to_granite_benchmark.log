---
- name: Perform initial validations and checks on the localhost
  import_tasks: assert.yml

- name: Install software packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  when: users_requirements is defined

- name: Manage groups
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    loop_var: group_name
  when: users_groups is defined

- name: Add entry to /etc/sudoers to include /etc/sudoers.d
  lineinfile:
    path: /etc/sudoers
    line: "#includedir {{ users_sudo_includedir }}"
    state: present
  when: users_sudo_includedir is defined

- name: Manage users
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    loop_var: user_name
  when: users is defined

- name: Template cron.allow
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
  when: users_cron_allow is defined

- name: Ensure /etc/cron.allow does not exist
  file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is not defined


