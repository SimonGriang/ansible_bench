---
- name: "Bootstrap"
  vars:
    ansible_ssh_user: "root"
  block:
    - name: "Assert that all required variables are set correctly before proceeding with the playbook tasks."
      assert:
        that:
          - "bootstrap_wait_for_host is defined"
          - "bootstrap_host is defined"
          - "bootstrap_port is defined"
          - "bootstrap_hostname is defined"
          - "bootstrap_install is defined"
          - "bootstrap_install_raw is defined"
          - "bootstrap_gather_facts is defined"
          - "bootstrap_gather_facts_raw is defined"
          - "bootstrap_ansible_facts is defined"
          - "bootstrap_ansible_facts_ packages is defined"
    - name: "Wait for host (when configured)."
      wait_for:
        host: "{{ bootstrap_host }}"
        port: "{{ bootstrap_port }}"
        search_regex: "{{ bootstrap_hostname }}"
      when: "bootstrap_wait_for_host"
    - name: "Prepare system"
      block:
        - name: "Establish connection to host and gather facts."
          delegate_to: "localhost"
          block:
            - name: "Try to connect to host {{ bootstrap_host }} on port {{ bootstrap_port }}."
              wait_for:
                host: "{{ bootstrap_host }}"
                port: "{{ bootstrap_port }}"
                timeout: 1
              register: "connection_test"
            - name: "Gather facts if connection was successful."
              setup:
              when: "connection_test.connected"
            - name: "Debug connection failure."
              debug:
                msg: "Could not connect to host {{ bootstrap_host }} on port {{ bootstrap_port }}.
                Is the host accessible?"
              when: "not connection_test.connected"
        - name: "Include tasks to gather bootstrap facts (raw)."
          include_tasks: "bootstrap_facts_raw.yml"
        - name: "Install bootstrap packages (raw)."
          when: "{{ bootstrap_install_raw }}"
          block:
            - name: "Install bootstrap packages."
              raw: "{{ bootstrap_install }}"
      rescue:
        - name: "Install bootstrap packages (ansible module)."
          when: "not bootstrap_install_raw"
          block:
            - name: "Ensure system is prepared by gathering ansible facts."
              setup:
              when: "bootstrap_gather_facts_raw"
            - name: "Install bootstrap packages."
              ansible.builtin.package:
                name: "{{ bootstrap_install }}"
                state: "present"


