---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/cron.allow
    line: "{{ cron_shell }}"
    create: true
    mode: 0600
    notify: Restart cron
  when: cron_shell is defined and cron_shell | length > 0

- name: Configure path
  lineinfile:
    path: /etc/cron.allow
    line: "{{ cron_path }}"
    create: true
    mode: 0600
    notify: Restart cron
  when: cron_path is defined and cron_path | length > 0

- name: Configure mailto
  lineinfile:
    path: /etc/cron.allow
    line: "{{ cron_mailto }}"
    create: true
    mode: 0600
    notify: Restart cron
  when: cron_mailto is defined and cron_mailto | length > 0

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service | length > 0

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    special_time: "{{ item.schedule | default(omit) }}"
    job: "{{ item.command }}"
    state: present
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined and cron_jobs | length > 0


