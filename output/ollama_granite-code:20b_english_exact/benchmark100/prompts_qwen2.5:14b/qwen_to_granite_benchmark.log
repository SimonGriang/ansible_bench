ation': 10670032320, 'model_name': 'granite-code:20b'} id='run--21a5707c-3b4d-4a74-9606-81ce47fadb7b-0' usage_metadata={'input_tokens': 545, 'output_tokens': 409, 'total_tokens': 954}
