---
- name: Restore etcd - get all nodes
  command: "kubectl get node -o jsonpath='{range .items[*].metadata}{.name} {end}'"
  register: rke2_etcd_cluster_nodes
  changed_when: false

- name: Restore etcd - remove old nodes
  command: "kubectl delete node {{ item }}"
  with_items:
    - "{{ rke2_etcd_cluster_nodes.stdout_lines | difference(rke2_group_names) }}"
  when:
    - rke2_etcd_cluster_nodes.stdout_lines | length > 0
  notify: restart etcd



