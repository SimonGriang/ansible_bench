    update_password: "{{ user.update_password | default('always') }}"
    expires: "{{ user.password_validity_days }}"
    groups: "{{ user.groups | join(',') }}"
    append: "{{ user.groups_append | default(omit) }}"
    removed_groups: "{{ user.removed_groups | join(',') }}"
    force: "{{ user.force | default(omit) }}"
    create_home: "{{ user.create_home | default(omit) }}"
    move_home: "{{ user.move_home | default(omit) }}"
    ssh_key: "{{ user.ssh_key | default(omit) }}"
    generate_ssh_key: "{{ user.generate_ssh_key | default(omit) }}"
    ssh_key_file: "{{ user.ssh_key_file | default(omit) }}"
    ssh_key_type: "{{ user.ssh_key_type | default(omit) }}"
    ssh_key_passphrase: "{{ user.ssh_key_passphrase | default(omit) }}"
    ssh_key_bits: "{{ user.ssh_key_bits | default(omit) }}"
    ssh_key_comment: "{{ user.ssh_key_comment | default(omit) }}"
    system: "{{ user.system | default(omit) }}"
    become_user: "{{ user.become_user | default(omit) }}"
    become_method: "{{ user.become_method | default(omit) }}"
    become_exe: "{{ user.become_exe | default(omit) }}"

- name: Set sudo options for {{ user.name }}
  template:
    src: sudoers.d.j2
    dest: /etc/sudoers.d/user-{{ user.name }}
    validate: '/usr/sbin/visudo -cf %s'
    mode: '0640'
    owner: root
    group: root
  when: user.sudo

- name: Remove sudo options for {{ user.name }}
  file:
    path: /etc/sudoers.d/user-{{ user.name }}
    state: absent
  when: not user.sudo

- name: Generate private ssh key for {{ user.name }}
  user:
    name: "{{ user.name }}"
    generate_ssh_key: yes
    ssh_key_file: .ssh/id_rsa
  become: false
  when: user.manage_ssh_key

- name: Generate public ssh key for {{ user.name }}
  user:
    name: "{{ user.name }}"
    generate_ssh_key: yes
    ssh_key_file: .ssh/id_rsa
    ssh_key_type: rsa
    ssh_key_bits: 4096
  become: false
  when: user.manage_ssh_key

- name: Convert ssh key to ppk for {{ user.name }}
  command: "ssh-keygen -p -f ~/.ssh/id_rsa -N '' -e -m pkcs1"
  args:
    creates: "~{{ user.name }}/.ssh/id_rsa.ppk"
  become: false
  when: user.manage_ssh_key

- name: Get or set the home directory for {{ user.name }}
  command: getent passwd {{ user.name }} | cut -d: -f6 || true
  changed_when: false
  register: user_home

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "~{{ user.name }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.manage_ssh_key or user.private_keys is defined
  become: true

- name: Deploy authorized keys for {{ user.name }}
  copy:
    content: "{{ item }}"
    dest: "~{{ user.name }}/.ssh/authorized_keys"
    backup: yes
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  with_fileglob:
    - "{{ user.authorized_keys }}/*"
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for {{ user.name }}
  lineinfile:
    dest: "~{{ user.name }}/.ssh/authorized_keys"
    state: absent
    regexp: "^{{ item }}$"
  with_items:
    - "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "~{{ user.name }}/.ssh/id_rsa"
    dest: "~{{ user.name }}/.ssh/id_rsa.generated"
    backup: yes
  when: user.copy_private_key

- name: Check users password valid time for {{ user.name }}
  shell: "chage -l {{ user.name }} | grep 'Password valid until' | awk -F': ' '{print $2;}'"
  changed_when: false
  register: user_password_valid_days

- name: Set users password valid time for {{ user.name }}
  shell: "chage -M {{ user.password_validity_days }} {{ user.name }}"
  when: user_password_valid_days.stdout != user.password_validity_days and user.password_validity_days is defined

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ item }}"
    dest: "~{{ user.name }}/.ssh/"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  with_fileglob:
    - "{{ user.private_keys }}/*"
