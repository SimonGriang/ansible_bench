---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - "Set root password"
    - "Systemctl daemon-reexec"

- name: Task 3 - Configure mysql server
  lineinfile:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    regexp: "{{ item.regexp }}"
    line: "{{ item.line }}"
    state: present
  loop: "{{ mysql_configuration_options }}"
  notify: "Restart mysql server"

- name: Task 4 - Configure mysql client
  lineinfile:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    regexp: "^socket"
    line: "socket = /var/run/mysqld/mysqld.sock"
    state: present

- name: Task 5 - Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/mysql

- name: Task 6 - Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Task 7 - Flush handlers
  meta: flush_handlers

- name: Task 8 - Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf

- name: Task 9 - Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    encoding: "{{ item.encoding | default(omit) }}"
   collation: "{{ item.collation | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"

- name: Task 10 - Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    state: present
   priv: "{{ item.priv | default(omit) }}"
    host: "{{ item.host | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"

- name: Task 11 - Flush handlers again
  meta: flush_handlers


