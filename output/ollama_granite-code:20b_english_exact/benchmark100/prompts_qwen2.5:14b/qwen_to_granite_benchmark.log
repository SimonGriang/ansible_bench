---

- name: Remove Docker apt key from trusted.gpg.d
  file:
    path: /etc/apt/trusted.gpg.d/docker-key.asc
    state: absent

- name: Remove old Docker source list file from sources.list.d
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Uninstall old versions of Docker
  apt:
    name: docker
    state: absent

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install necessary dependencies for Docker
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Add or remove Docker repository
  apt_repository:
    repo: "deb [arch=amd64] https://download.docker.com/linux/debian {{ ansible_distribution_release }} stable"
    state: "{{ 'absent' if docker_add_repo is sameas false else 'present' }}"
  notify: apt update

- name: Flush handlers to update apt cache
  meta: flush_handlers


