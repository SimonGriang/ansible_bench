op', 'total_duration': 14435466495, 'load_duration': 32659587, 'prompt_eval_count': 1995, 'prompt_eval_duration': 14108180, 'eval_count': 511, 'eval_duration': 14387224461, 'model_name': 'granite-code:20b'} id='run--4c717ea2-adac-48c3-b948-2680cf3b6612-0' usage_metadata={'input_tokens': 1995, 'output_tokens': 511, 'total_tokens': 2506}
