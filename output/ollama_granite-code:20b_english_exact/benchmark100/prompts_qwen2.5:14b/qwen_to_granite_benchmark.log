            - name: Try to connect to host {{ bootstrap_host }} on port {{ bootstrap_port }}.
              wait_for:
                host: "{{ bootstrap_host }}"
                port: "{{ bootstrap_port }}"
                timeout: 1
              register: connection_test
            - name: Gather facts if connection was successful.
              setup:
              when: connection_test.connected
            - name: Debug connection failure.
              debug:
                msg: Could not connect to host {{ bootstrap_host }} on port {{ bootstrap_port }}. Is the host accessible?
              when: not connection_test.connected
        - name: Include tasks to gather bootstrap facts (raw).
          include_tasks: bootstrap_facts_raw.yml
        - name: Install bootstrap packages (raw).
          when: bootstrap_install_raw
          block:
            - name: Install bootstrap packages.
              raw: "{{ bootstrap_install }}"
      rescue:
        - name: Install bootstrap packages (ansible module).
          when: not bootstrap_install_raw
          block:
            - name: Ensure system is prepared by gathering ansible facts.
              setup:
              when: bootstrap_gather_facts_raw
            - name: Install bootstrap packages.
              ansible.builtin.package:
                name: "{{ bootstrap_install }}"
                state: present


