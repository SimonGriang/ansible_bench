---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: ^GRUB_TIMEOUT=
    line: GRUB_TIMEOUT="{{ grub_timeout }}"
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: ^GRUB_RECORDFAIL_TIMEOUT=
    line: GRUB_RECORDFAIL_TIMEOUT="{{ grub_recordfail_timeout }}"
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  when: grub_options is defined and grub_options|length > 0
  block:
    - name: Read /etc/default/grub
      command: cat /etc/default/grub
      register: grub_config

    - name: Set GRUB_CMDLINE_LINUX
      lineinfile:
        path: /etc/default/grub
        regexp: ^GRUB_CMDLINE_LINUX=
        line: GRUB_CMDLINE_LINUX="{{ grub_config.stdout | regex_replace('^.*GRUB_CMDLINE_LINUX=\"(.*)\".*$', '\\1') }} {{ grub_options | join(' ') }}"
      notify: Update grub

- name: Import password.yml
  when: grub_set_password
  import_tasks: password.yml

- name: Flush handlers
  meta: flush_handlers



