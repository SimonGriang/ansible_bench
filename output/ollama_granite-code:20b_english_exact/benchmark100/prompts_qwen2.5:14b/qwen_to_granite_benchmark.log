---
- name: Ensure old versions of Docker are not installed
  yum:
    name: "{{ item }}"
    state: absent
  with_items:
    - docker
    - docker-client
    - docker-client-latest
    - docker-common
    - docker-latest
    - docker-latest-logrotate
    - docker-logrotate
    - docker-engine

- name: Add Docker GPG key
  ansible.builtin.apt_key:
    url: https://download.docker.com/linux/ubuntu/gpg
    state: present

- name: Add Docker repository
  ansible.builtin.apt_repository:
    repo: "deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_distribution_release }} stable"
    state: present

- name: Configure Docker Nightly repo
  ansible.builtin.copy:
    content: |
      [docker-nightly]
      name=Docker Nightly
      baseurl=https://download.docker.com/linux/centos/7/x86_64/stable/nightly/
      enabled=1
     gpgcheck=1
      gpgkey=https://download.docker.com/linux/centos/gpg
    dest: /etc/yum.repos.d/docker-nightly.repo

- name: Configure Docker Test repo
  ansible.builtin.copy:
    content: |
      [docker-test]
      name=Docker Test
      baseurl=https://download.docker.com/linux/centos/7/x86_64/stable/test/
      enabled=1
      gpgcheck=1
      gpgkey=https://download.docker.com/linux/centos/gpg
    dest: /etc/yum.repos.d/docker-test.repo

- name: Configure containerd on RHEL 8
  ansible.builtin. yum:
    name: "{{ item }}"
    state: present
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"
  with_items:
    - container-selinux
    - containerd.io


