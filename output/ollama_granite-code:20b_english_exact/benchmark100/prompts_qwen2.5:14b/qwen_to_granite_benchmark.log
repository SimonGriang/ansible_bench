---
- name: hardening | Disable swap
  command: swapoff -a
  when: vault_hardening_disable_swap

- name: hardening | Disable swap now
  command: swapoff -a
  when: ansible_swaptotal_mb > 0 and vault_hardening_disable_swap

- name: hardening | Disable swap permanently
  mount:
    name: swap
    state: absent
  when: vault_hardening_disable_swap

- name: hardening | Disable core dumps
  pam_limits:
    domain: "{{ item }}"
    limit_type: core
    limit_item: hard
    value: 0
  loop: "{{ ansible_domain | default('localhost') }}"
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable Shell Command History
  copy:
    dest: /etc/profile.d/vault-hardening.sh
    content: |
      export HISTCONTROL=ignoreboth
      export HISTSIZE=0
  when: vault_hardening_disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  tags: skip_ansible_lint
  when: vault_hardening_configure_selinux_apparmor
  block:
    - name: hardening | Enable SELinux
      command: setenforce 1
      when: ansible_selinux.status == "enabled"

    - name: hardening | Install selinux-policy
      package:
        name: selinux-policy
        state: present
      when: ansible_selinux.status == "enabled"

    - name: hardening | Set SELinux policy
      selinux:
        policy: targeted
        state: "{{ 'enforcing' if (ansible_selinux.status == 'enabled' and ansible_selinux.enforcing) else 'permissive' }}"
      when: ansible_selinux.status == "enabled"

    - name: hardening | Enable AppArmor (enforcing)
      tags: skip_ansible_lint
      command: aa-enforce /usr/local/bin/vault
      when: ansible_apparmor.enforcing | default(false) | bool



