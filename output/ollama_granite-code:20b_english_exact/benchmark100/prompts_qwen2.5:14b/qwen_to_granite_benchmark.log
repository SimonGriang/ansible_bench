---
- name: Check if the system is using EFI firmware
  stat:
    path: /sys/firmware/efi/efivars
  register: efi_status

- name: Remove the grub.cfg file if the system is detected as EFI-based
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_status.stat.exists

- name: Install a user-defined template for GRUB
  copy:
    src: /path/to/template/file
    dest: /etc/grub.d/01_users
    owner: root
    mode: "0700"
  notify: Update GRUB

- name: Insert a line to enable a password for GRUB in the EFI configuration file
  lineinfile:
    path: /etc/grub2-efi.cfg
    line: password_grub=your_password
  notify: Update GRUB

- name: Insert a line to enable a password for GRUB in the MBR configuration file
  lineinfile:
    path: /etc/grub2.cfg
    line: password_grub=your_password
  notify: Update GRUB

- name: Replace occurrences of CLASS=" with CLASS=" --unrestricted in specified files
  replace:
    path: "{{ item }}"
    regexp: 'CLASS=".*'
    replace: 'CLASS=" --unrestricted'
  loop: "{{ grub_password_unrestricted_files }}"
  when: grub_password_unrestricted
  notify: Update GRUB


