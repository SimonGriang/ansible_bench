---
- name: RKE2 config
  hosts: rke2_cluster_group_name
  tasks:
    - name: Create the RKE2 config directory
      file:
        path: /etc/rancher/rke2
        state: directory
    - name: Set server taints
      set_fact:
        combined_node_taints: "{{ rke2_server_node_taints | combine({'effect': 'NoSchedule'}) }}"
      when: rke2_server_type == "server"
    - name: Copy RKE2 configuration file
      template:
        src: rke2.yaml.j2
        dest: /etc/rancher/rke2/config.yaml
        owner: root
        group: root
        mode: '0644'
      notify: Config file changed
    - name: Copy kubelet configuration file
      template:
        src: kubelet-config.yaml.j2
        dest: /etc/rancher/rke2/kubelet-config.yaml
        owner: root
        group: root
        mode: '0644'
      notify: Config file changed
      when: rke2_kubelet_config is not empty
    - name: Copy Containerd Registry Configuration file
      template:
        src: containerd-registries.yaml.j2
        dest: /etc/rancher/rke2/registries.yaml
        owner: root
        group: root
        mode: '0644'
      notify: Config file changed
      when: rke2_custom_registry_mirrors is defined or rke2_custom_registry_configs is defined
    - name: Register if we need to do a etcd restore from file
      set_fact:
        do_etcd_restore: true
      when: rke2_etcd_snapshot_file is not empty and (rke2_server_type is not defined or not rke2_server_type == "server")
    - name: Register if we need to do a etcd restore from s3
      set_fact:
        do_etcd_restore_from_s3: true
      when: rke2_etcd_snapshot_file is not empty and rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined
    - name: Restore etcd from file
      block:
        - name: Create the RKE2 etcd snapshot directory
          file:
            path: /var/lib/rke2/server/db/snapshots
            state: directory
        - name: Copy etcd snapshot file
          copy:
            src: "{{ rke2_etcd_snapshot_file }}"
            dest: /var/lib/rke2/server/db/snapshots/snapshot.db
            owner: root
            group: root
            mode: '0644'
        - name: Restore etcd from snapshot file
          command: rke2 etcd snapshot restore /var/lib/rke2/server/db/snapshots/snapshot.db --name=rke2-server --config-file /etc/rancher/rke2/config.yaml
          register: snapshot_restore_cmd
          changed_when: snapshot_restore_cmd.stdout_lines[0] == "Recovered 1444 entries in 184.796µs (56.64 MB/s)"
          until: snapshot_restore_cmd is succeeded
      when: do_etcd_restore is defined
    - name: Restore etcd from s3
      block:
        - name: Restore etcd from S3 snapshot
          shell: >
            curl
            -L
            -o /var/lib/rke2/server/db/snapshots/s3_restore.db
            -u {{ rke2_etcd_snapshot_s3_options.access_key }}:{{ rke2_etcd_snapshot_s3_options.secret_key }}
            {{ rke2_etcd_snapshot_s3_options.endpoint }}{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }}
          register: snapshot_restore_cmd
          changed_when: snapshot_restore_cmd.stdout_lines[0] == "Recovered 1444 entries in 184.796µs (56.64 MB/s)"
          until: snapshot_restore_cmd is succeeded
      when: do_etcd_restore_from_s3 is defined
    - name: Start RKE2 service on the first server
      block:
        - name: Start and enable rke2-server.service
          service:
            name: rke2-server
            state: started
            enabled: true
          environment:
            RKE2_TOKEN: "{{ rke2_token }}"
    - name: Mask RKE2 agent service on the first server
      service:
        name: rke2-agent
        state: stopped
        enabled: false
      when: rke2_server_type == "server"
    - name: Wait for the first server be ready - no CNI
      command: >
        rke2ctl
        --config /etc/rancher/rke2/config.yaml
        --insecure-skip-tls-verify
        -n rke2-cluster-join
        token list -o json
      register: rke2_command
      until: rke2_command is succeeded and rke2_command.stdout|from_json|json_query('data[0].status.conditions[?type==`Ready`].status') == ["True"]
      retries: 30
      delay: 10
      changed_when: false
      when: rke2_install_type == "agent"
    - name: Wait for the first server be ready - with CNI
      command: >
        rke2ctl
        --config /etc/rancher/rke2/config.yaml
        --insecure-skip-tls-verify
        -n rke2-cluster-join
        token list -o json
      register: rke2_command
      until: rke2_command is succeeded and rke2_command.stdout|from_json|json_query('data[0].status.conditions[?type==`Ready`].status') == ["True"]
      retries: 30
      delay: 10
      changed_when: false
      when: rke2_install_type == "agent" and not rke2_disable_cni
    - name: Restore etcd
      block:
        - name: Get registered nodes
          command: >
            rke2ctl
            --config /etc/rancher/rke2/config.yaml
            --insecure-skip-tls-verify
            -n rke2-cluster-join
            token list -o json
          register: rke2_command
          changed_when: false
        - name: Remove old node secrets
          with_items: "{{ rke2_command.stdout|from_json|json_query('data[*].token') }}"
          loop_control:
            label: "Removing node secret {{ item }}"
          changed_when: false
          command: >
            rke2ctl
            --config /etc/rancher/rke2/config.yaml
            --insecure-skip-tls-verify
            -n rke2-cluster-join
            token remove -t {{ item }}
        - name: Remove old nodes
          with_items: "{{ rke2_command.stdout|from_json|json_query('data[*].token') }}"
          loop_control:
            label: "Removing node {{ item }}"
          changed_when: false
          command: >
            rke2ctl
            --config /etc/rancher/rke2/config.yaml
            --insecure-skip-tls-verify
            -n rke2-cluster-join
            node remove -t {{ item }}
      when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined
    - name: Set an Active Server variable
      set_fact:
        active_server: "{{ inventory_hostname }}"
      when: rke2_server_type == "server"
  handlers:
    - name: Config file changed
      community.general.ini_file:
        path: /etc/rancher/rke2/config.yaml
        section: "cluster"
        option: "ignore-docker-version"
        value: "{{ rke2_ignore_docker_version }}"
        mode: '0644'
        backup: true
        no_extra_spaces: true
        create: false


