      service:
        name: rke2-agent
        state: stopped
        enabled: false
      when: rke2_server_type == "server"
    - name: Wait for the first server be ready - no CNI
      command: >
        rke2ctl
        --config /etc/rancher/rke2/config.yaml
        --insecure-skip-tls-verify
        -n rke2-cluster-join
        token list -o json
      register: rke2_command
      until: rke2_command is succeeded and rke2_command.stdout|from_json|json_query('data[0].status.conditions[?type==`Ready`].status') == ["True"]
      retries: 30
      delay: 10
      changed_when: false
      when: rke2_install_type == "agent"
    - name: Wait for the first server be ready - with CNI
      command: >
        rke2ctl
        --config /etc/rancher/rke2/config.yaml
        --insecure-skip-tls-verify
        -n rke2-cluster-join
        token list -o json
      register: rke2_command
      until: rke2_command is succeeded and rke2_command.stdout|from_json|json_query('data[0].status.conditions[?type==`Ready`].status') == ["True"]
      retries: 30
      delay: 10
      changed_when: false
      when: rke2_install_type == "agent" and not rke2_disable_cni
    - name: Restore etcd
      block:
        - name: Get registered nodes
          command: >
            rke2ctl
            --config /etc/rancher/rke2/config.yaml
            --insecure-skip-tls-verify
            -n rke2-cluster-join
            token list -o json
          register: rke2_command
          changed_when: false
        - name: Remove old node secrets
          with_items: "{{ rke2_command.stdout|from_json|json_query('data[*].token') }}"
          loop_control:
            label: "Removing node secret {{ item }}"
          changed_when: false
          command: >
            rke2ctl
            --config /etc/rancher/rke2/config.yaml
            --insecure-skip-tls-verify
            -n rke2-cluster-join
            token remove -t {{ item }}
        - name: Remove old nodes
          with_items: "{{ rke2_command.stdout|from_json|json_query('data[*].token') }}"
          loop_control:
            label: "Removing node {{ item }}"
          changed_when: false
          command: >
            rke2ctl
            --config /etc/rancher/rke2/config.yaml
            --insecure-skip-tls-verify
            -n rke2-cluster-join
            node remove -t {{ item }}
      when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined
    - name: Set an Active Server variable
      set_fact:
        active_server: "{{ inventory_hostname }}"
      when: rke2_server_type == "server"
  handlers:
    - name: Config file changed
      community.general.ini_file:
        path: /etc/rancher/rke2/config.yaml
        section: "cluster"
        option: "ignore-docker-version"
        value: "{{ rke2_ignore_docker_version }}"
        mode: '0644'
        backup: true
        no_extra_spaces: true
        create: false


