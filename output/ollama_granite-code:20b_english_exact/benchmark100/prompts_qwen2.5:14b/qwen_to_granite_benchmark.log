    - /etc/openvpn/easy-rsa/pki/dh2048.pem
    - /etc/openvpn/easy-rsa/pki/server.crt
    - /etc/openvpn/easy-rsa/pki/server.key
    - /etc/openvpn/easy-rsa/pki/crl.pem

- name: Task 10
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn
    mode: "0600"
  with_items:
    - /etc/openvpn/easy-rsa/pki/ca.crt
