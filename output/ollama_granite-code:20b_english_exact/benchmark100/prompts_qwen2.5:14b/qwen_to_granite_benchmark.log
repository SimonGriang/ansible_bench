---
- import_tasks: assert.yml
- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present
- name: Configure shell
  lineinfile:
    dest: /etc/cron.conf
    regexp: "^{{ item.key }}"
    line: "{{ item.key }}={{ item.value }}"
    state: present
  loop:
    - key: SHELL
      value: "{{ cron_shell }}"
    - key:SHELL
      value: /usr/local/bin/nologin
  notify: restart cron
- name: Configure path
  lineinfile:
    dest: /etc/cron.conf
    regexp: "^{{ item.key }}"
    line: "{{ item.key }}={{ item.value }}"
    state: present
  loop:
    - key: PATH
      value: "{{ cron_path }}"
    - key: PATH
      value: /sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
  notify: restart cron
- name: Configure mailto
  lineinfile:
    dest: /etc/cron.conf
    regexp: "^{{ item.key }}"
    line: "{{ item.key }}={{ item.value }}"
    state: present
  loop:
    - key: MAILTO
      value: "{{ cron_mailto }}"
    - key: MAILTO
      value: root
  notify: restart cron
- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ""
- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute }}"
