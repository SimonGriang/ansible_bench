---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install python pip
  pip:
    name: python-pip
    executable: pip{{ python_executable_suffix }}

- name: Configure pip proxy
  when: python_pip_proxy is defined
  block:
    - name: Set proxy in pip.conf
      copy:
        dest: /etc/pip.conf
        content: |
          [global]
          proxy = {{ python_pip_proxy }}
        mode: 0644
        backup: yes

- name: Trust hosts
  when: python_pip_trusted_host is defined
  block:
    - name: Set trusted host in pip.conf
      copy:
        dest: /etc/pip.conf
        content: |
          [global]
          trusted-host = {{ python_pip_trusted_host }}
        mode: 0644
        backup: yes

- name: Update pip
  when: python_pip_update and (ansible_distribution_release != 'bookworm') and (ansible_distribution_release != 'noble') and (ansible_os_family != 'Alpine')
  pip:
    name: pip
    executable: pip{{ python_executable_suffix }}
    state: latest

- name: Install requested modules
  when: (ansible_distribution_release != 'bookworm') and (ansible_distribution_release != 'noble') and (ansible_os_family != 'Alpine')
  pip:
    name: "{{ item.name }}"
    executable: pip{{ python_executable_suffix }}
    version: "{{ item.version }}"
    state: "{{ item.state }}"
  loop: "{{ python_pip_modules }}"
  loop_control:
    label: "Installing python module {{ item.name }}"


