---
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_service_mgr == "systemd"
    fail_msg: "Systemd must be used as init system."
    success_msg: "Systemd is used as init system."

- name: Get latest release of promtail
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: true
  register: promtail_latest_release

- name: Set promtail_version
  set_fact:
    promtail_version: "{{ promtail_latest_release.json.tag_name }}"

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.{{ go_arch }}.zip"
  register: promtail_local_archive

- name: Assert local binary exists
  assert:
    that:
      - promtail_binary_local_dir is defined
      - promtail_local_archive.stat.exists
    fail_msg: "Local archive does not exist."
    success_msg: "Local archive exists."

- name: Get checksum list
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/assets/{{ promtail_latest_release.json.assets[0].id }}
    return_content: true
  register: promtail_latest_release_checksum

- name: Set promtail_checksum
  set_fact:
    promtail_checksum: "{{ promtail_latest_release_checksum.json.content | b64decode | regex_findall('(?<=\s)[a-fA-F0-9]{64}(?=\s)') | first }}"



