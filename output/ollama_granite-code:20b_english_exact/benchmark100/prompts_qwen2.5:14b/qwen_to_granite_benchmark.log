---
- import_tasks: assert.yml
- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present
- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_user }}"
- name: Create directory for git configuration
  file:
    path: "~{{ git_user }}/{{ git_config_directory }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: git_config_directory is defined and git_user_exists is defined and git_user_exists.stdout_lines | length > 0
- name: Place git configuration
  copy:
    dest: "~{{ git_user }}/{{ git_config_directory }}/{{ git_config_file }}"
    src: "{{ git_config_src }}"
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: git_config_src is defined and git_config_file is defined and git_config_directory is defined and git_user_exists is defined and git_user_exists.stdout_lines | length > 0
- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: git_repository_destination is defined and git_user_exists is defined and git_user_exists.stdout_lines | length > 0
- name: Clone all roles
  become: "{{ git_become_for_clone }}"
  become_user: "{{ git_user }}"
  git:
    dest: "{{ git_repository_destination }}/{{ item.name | urlsplit('path') | basename }}"
    repo: "{{ item.repo }}"
    version: "{{ item.version | default(omit) }}"
  with_items: "{{ git_repositories }}"
  when: git_repositories is defined and git_repository_destination is defined and git_user_exists is defined and git_user_exists.stdout_lines | length > 0


