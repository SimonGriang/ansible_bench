---

- import_tasks: assert.yml

- name: Install requirements
  package:
    name: bash
    state: present
  tags:
    - always

- block:
    - name: Install openjdk java (package)
      package:
        name: openjdk
        state: present
      when: java_vendor == "openjdk"
  tags:
    - package

- block:
    - name: Install Oracle Java RPM package from a local source
      package:
        name:
          - java-1.8.0-oracle-jRockit-1.8.0.111-1.x86_64.rpm
        state: present
        disable_gpg_check: yes
      when: java_vendor == "oracle"
  tags:
    - rpm

- block:
    - name: Install Oracle Java DEB package from a local source
      apt:
        deb: /tmp/java.deb
      when: java_vendor == "oracle"
  tags:
    - deb

- block:
    - name: Install Oracle Java RPM package from a repository
      package:
        name:
          - java-1.8.0-oracle-jRockit-1.8.0.111-1.x86_64.rpm
        state: present
        disable_gpg_check: yes
      when: java_vendor == "oracle"
  tags:
    - repository

- block:
    - name: Install Oracle Java TARGZ package and ensure the installation directory exists
      unarchive:
        src: /tmp/java.tar.gz
        dest: /opt/java
        remote_src: yes
      when: java_vendor == "oracle"
  tags:
    - targz

- block:
    - name: Install Oracle Java JCE policy files for Java 8
      unarchive:
        src: /tmp/UnlimitedJCEPolicyJDK8.zip
        dest: /opt/java
        remote_src: yes
      when: java_vendor == "oracle"
  tags:
    - targz

- block:
    - name: Set alternative for the java binary when using a TARGZ installation and not on Alpine Linux
      alternatives:
        name: java
        link: /usr/bin/java
        path: /opt/java/jdk1.8.0_131/bin/java
      when: java_vendor == "oracle" and not ansible_os_family == "alpine"
  tags:
    - targz

- block:
    - name: Determine the JAVA_HOME directory using the readlink command
      command: readlink -f /usr/bin/java
      register: java_home_directory
    - name: Set JAVA_HOME in /etc/environment
      lineinfile:
        path: /etc/environment
        line: "JAVA_HOME={{ java_home_directory.stdout }}"
        state: present
        create: yes
  tags:
    - environment


