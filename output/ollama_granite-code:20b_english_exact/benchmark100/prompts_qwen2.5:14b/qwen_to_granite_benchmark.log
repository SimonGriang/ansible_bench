---

- name: "httpd : Import assert.yml"
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: "httpd : Install apache httpd"
  package:
    name: "{{ httpd_packages }}"
    state: present
  register: httpd_install

- name: "httpd : Configure selinux"
  block:
    - seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: yes
      with_items:
        - { name: httpd_can_network_connect, state: yes }
        - { name: httpd_can_network_connect_db, state: yes }
        - { name: httpd_enable_cgi, state: yes }
        - { name: httpd_setrlimit, state: yes }

    - seport:
        ports: "{{ item.port }}"
        proto: "{{ item.proto }}"
        setype: "{{ item.setype }}"
        state: "{{ item.state }}"
      with_items: "{{ httpd_ports }}"
      when: item.port is defined
  when:
    - httpd_selinux_enabled | bool

- name: "httpd : Configure httpd"
  template:
    src: "httpd.conf.j2"
    dest: "{{ httpd_conf_file }}"
    mode: 0644
    owner: root
    group: root
  notify:
    - "httpd : Test and restart service"
    - "httpd : reload service"

- name: "httpd : Activate httpd module | Debian"
  command: "a2enmod {{ item }}"
  notify:
    - "httpd : Test and restart service"
    - "httpd : reload service"
  with_items: "{{ httpd_modules }}"
  when:
    - httpd_modules is defined
    - httpd_system_version is version('2.2', '<')
    - ansible_os_family == "Debian"

- name: "httpd : Import ssl.yml"
  import_tasks: ssl.yml
  when:
    - httpd_ssl | bool

- name: "httpd : Import locations.yml"
  import_tasks: locations.yml
  when:
    - httpd_locations | length > 0

- name: "httpd : Import vhosts.yml"
  import_tasks: vhosts.yml
  when:
    - httpd_vhosts | length > 0

- name: "httpd : Configure ports"
  template:
    src: "ports.conf.j2"
    dest: "{{ httpd_ports_file }}"
    mode: 0644
    owner: root
    group: root
  notify:
    - "httpd : Test and restart service"
    - "httpd : reload service"
  when:
    - ansible_os_family == "Debian" or ansible_os_family == "Suse"

- name: "httpd : Import directories.yml"
  import_tasks: directories.yml
  when:
    - httpd_directories | length > 0

- name: "httpd : Flush handlers"
  meta: flush_handlers

- name: "httpd : Removing default html"
  file:
    path: "{{ httpd_docroot }}/"
    state: absent
  when:
    - httpd_remove_example | bool

- name: "httpd : Start and enable httpd"
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


