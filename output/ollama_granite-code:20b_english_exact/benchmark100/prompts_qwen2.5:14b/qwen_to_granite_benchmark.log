---
- name: Ensure unzip is present
  package:
    name: unzip
    state: present
  when: promtail_update_package_cache

- name: Create promtail group
  group:
    name: promtail
    state: present
  when: promtail_group_name != "root"

- name: Create promtail user
  user:
    name: promtail
    group: promtail
    groups: "{{ promtail_ supplementary_groups }}"
    state: present
  when: promtail_user_name != "root"

- name: Ensure promtail directories exists
  file:
    path: "{{ item }}"
    owner: promtail
    group: promtail
    mode: 0755
    state: directory
  loop:
    - /usr/local/bin
    - /etc/promtail
    - /etc/promtail/positions
    - /etc/promtail/ssl

- name: Check if promtail binary exists
  stat:
    path: /usr/local/bin/promtail
  register: promtail_binary

- name: Download promtail binaries
  unarchive:
    src: https://github.com/grafana/promtail/releases/download/v{{ promtail_version }}/promtail-linux-amd64.zip
    dest: /usr/local/bin
    remote_src: true
  when: not promtail_binary.stat.exists and promtail_url == ""

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_local_url }}"
    dest: /usr/local/bin
    owner: root
    group: root
    mode: 0755
  when: not promtail_binary.stat.exists and promtail_local_url != ""

- name: Download promtail binaries to controller node
  unarchive:
    src: https://github.com/grafana/promtail/releases/download/v{{ promtail_version }}/promtail-linux-amd64.zip
    dest: /tmp
    remote_src: true
  when: not promtail_binary.stat.exists and promtail_url != "" and not promtail_propagate

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail-linux-amd64
    dest: /usr/local/bin
    owner: root
    group: root
    mode: 0755
  when: not promtail_binary.stat.exists and promtail_propagate

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail-linux-amd64.zip
    dest: /usr/local/bin
    remote_src: true
  when: not promtail_binary.stat.exists and promtail_propagate

- name: Create symlink to latest version
  file:
    src: /usr/local/bin/promtail-linux-amd64
    dest: /usr/local/bin/promtail
    owner: root
    group: root
    state: link
  notify: restart promtail

- name: Write configuration
  template:
    src: promtail.yml.j2
    dest: /etc/promtail/promtail.yml
    owner: promtail
    group: promtail
    mode: 0640
  notify: restart promtail

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: 0644
  notify: restart promtail


