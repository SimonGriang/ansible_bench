---
- name: Task 1 - Download RKE2 kubeconfig
  hosts: rke2_servers_group_name
  tasks:
    - name: Download RKE2 kubeconfig to localhost
      fetch:
        src: /etc/rancher/rke2/rke2.yaml
        dest: "{{ rke2_download_kubeconf_path }}{{ rke2_download_kubeconf_file_name }}"
        flat: yes
      when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]

- name: Task 2 - Replace loopback IP by master server IP
  hosts: localhost
  tasks:
    - name: Replace loopback IP by master server IP
      replace:
        path: "{{ rke2_download_kubeconf_path }}{{ rke2_download_kubeconf_file_name }}"
        regexp: '127.0.0.1|([0:]+:){7}1'
        replace: "{{ rke2_api_ip | default(hostvars[groups[rke2_servers_group_name][0]].ansible_default_ipv4.address) }}"
      when: not ansible_check_mode and rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]


