- import_tasks: assert.yml
  delegate_to: localhost

- wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    connect_timeout: "{{ bootstrap_timeout }}"
  when:
  - bootstrap_port is defined
  - inventory_hostname != 'localhost'
  - not bootstrap_force_localhost

- name: Prepare system
  raw: |
    {{ bootstrap_python }} -c "import os, json; f = open('/etc/ansible/facts.d/bootstrap.json', 'w'); f.write(json.dumps({ 'ansible_user_dir': os.path.expanduser('~') })); f.close()"
    creates: /etc/ansible/facts.d/bootstrap.json
  when: not bootstrap_skip_tags | selectattr('name','equalto','bootstrap-prepare') | list | length == 0

- name: Gather bootstrap facts
  setup:
    filter: ansible_user_dir
  when:
  - not bootstrap_skip_tags | selectattr('name','equalto','bootstrap-prepare') | list | length == 0
  - not bootstrap_force_localhost

- name: Install bootstrap packages (raw)
  raw: "{{ bootstrap_package_command }} {{ item }}"
  with_items: "{{ bootstrap_packages }}"
  when:
  - not bootstrap_skip_tags | selectattr('name','equalto','bootstrap-install-packages') | list | length == 0
  - bootstrap_packages is defined
  - bootstrap_packages | length > 0
  - not bootstrap_force_localhost

- name: Ensure libdnf5 is present on Fedora/RedHat
  package:
