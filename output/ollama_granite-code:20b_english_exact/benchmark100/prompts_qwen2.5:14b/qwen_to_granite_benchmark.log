- import_tasks: assert.yml

- name: "Enable redis module stream (RHEL 8)"
  dnf:
    name: "redis"
    enable: "yes"
    state: "present"
  become: true
  when:
    - ansible_distribution == "RedHat"
    - ansible_distribution_major_version | int == 8
