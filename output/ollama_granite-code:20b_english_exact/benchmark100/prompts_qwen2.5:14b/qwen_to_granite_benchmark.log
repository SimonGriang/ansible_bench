---
- name: Check if python is installed
  command: python --version
  register: python_version
  ignore_errors: true

- name: Check if python3 is installed
  command: python3 --version
  register: python3_version
  ignore_errors: true

- name: Debug Python executable path
  debug:
    msg: "Python executable path: {{ python_version.executable }}"
  when: python_version is defined and python_version.executable is defined

- name: Debug Python3 executable path
  debug:
    msg: "Python3 executable path: {{ python3_version.executable }}"
  when: python3_version is defined and python3_version.executable is defined

- include_tasks: assert.yml

- name: Install requirements
  dnf:
    name: "{{ openssl_requirements }}"
    state: present
  when: ansible_os_family == "Fedora"

- name: Ensure packaging is available via dnf
  dnf:
    name: python3-packaging
    state: present
  when: ansible_os_family == "Fedora"

- name: Install pip packages
  pip:
    name: "{{ openssl_pip_packages }}"
    executable: pip3

- name: Create key directory
  file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: "{{ openssl_directory_mode }}"
    owner: "{{ openssl_directory_owner }}"
    group: "{{ openssl_directory_group }}"

- name: Create csr directory
  file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: "{{ openssl_directory_mode }}"
    owner: "{{ openssl_directory_owner }}"
    group: "{{ openssl_directory_group }}"

- name: Create crt directory
  file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: "{{ openssl_directory_mode }}"
    owner: "{{ openssl_directory_owner }}"
    group: "{{ openssl_directory_group }}"

- include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item


