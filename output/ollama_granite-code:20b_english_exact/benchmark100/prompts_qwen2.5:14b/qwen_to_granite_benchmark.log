---

- import_tasks: assert.yml

- name: Task 2 - Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Task 3 - Configure mysql server
  ini_file:
    dest: /etc/mysql/my.cnf
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0644
    backup: yes
  with_items: "{{ mysql_configuration_options }}"

- name: Task 4 - Configure mysql client
  ini_file:
    dest: /etc/mysql/my.cnf
    section: client
    option: socket
    value: /var/run/mysqld/mysqld.sock
    mode: 0644
    backup: yes

- name: Task 5 - Initialize mysql
  command: "{{ item }}"
  args:
    creates: /var/lib/mysql/user.frm
  with_items:
    - mysql_install_db
    - mysqld --initialize-insecure
  when: ansible_os_family == "Debian" or ansible_os_family == "RedHat"

- name: Task 6 - Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Task 7 - Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: 0644

- name: Task 8 - Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  with_items: "{{ mysql_databases }}"
  when: item.import_file is not defined

- name: Task 8 - Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.import_file }}"
  with_items: "{{ mysql_databases }}"
  when: item.import_file is defined

- name: Task 9 - List databases
  command: mysql -e "SHOW DATABASES;"
  changed_when: false
  register: mysql_databases_list

- name: Task 10 - Import database
  command: mysql -u root {{ item.name }} < {{ item.import_file }}
  with_items: "{{ mysql_databases }}"
  when: item.import_file is defined and item.name not in mysql_databases_list.stdout_lines

- name: Task 11 - Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items: "{{ mysql_users }}"

- name: Task 12 - Flush handlers
  meta: flush_handlers

- name: Task 13 - Flush handlers again
  meta: flush_handlers


