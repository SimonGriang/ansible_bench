---
- name: Apply CIS Benchmark tasks
  hosts: all
  tasks:
    - name: Create etcd group
      group:
        name: etcd
        state: present

    - name: Create etcd user
      user:
        name: etcd
        comment: etcd user
        group: etcd
        shell: /bin/nologin
        state: present

    - name: Copy systemctl config file for kernel hardening
      copy:
        src: "{{ item }}"
        dest: /etc/sysctl.d/60-rke2-cis.conf
        mode: 0600
      loop:
        - /usr/local/share/rke2/rke2-cis-sysctl.conf
        - /opt/rke2/share/rke2/rke2-cis-sysctl.conf
      register: rke2_cis_sysctl_config
      notify: restart systemd-sysctl

    - name: Flush handlers
      meta: flush_handlers

  handlers:
    - name: restart systemd-sysctl
      systemd:
        name: systemd-sysctl
        state: restarted


