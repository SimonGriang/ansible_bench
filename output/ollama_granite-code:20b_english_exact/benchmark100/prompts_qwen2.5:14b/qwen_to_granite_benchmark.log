---

- import_tasks: assert.yml
  tags:
    - mysql_server
    - mysql_server_install

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  tags:
    - mysql_server
    - mysql_server_install

- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/my.cnf.d/mysql_server.cnf
    line: "{{ item.line }}"
    regexp: "{{ item.regexp }}"
    state: present
    create: true
  with_items: "{{ mysql_configuration_options }}"
  notify: restart mysql
  tags:
    - mysql_server
    - mysql_server_config

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/my.cnf.d/mysql_client.cnf
    line: "socket = {{ mysql_socket }}"
    create: true
  notify: restart mysql
  tags:
    - mysql_client
    - mysql_client_config

- name: Initialize mysql
  command: mysql_install_db --user=mysql --basedir=/usr --datadir=/var/lib/mysql/ --defaults-file=/etc/mysql/my.cnf
  when: ansible_distribution in [ "Alpine", "Archlinux" ]
  tags:
    - mysql_server
    - mysql_server_install

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: true
  tags:
    - mysql_server
    - mysql_server_install

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644
    owner: root
    group: root
  notify: restart mysql
  tags:
    - mysql_server
    - mysql_server_config

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    encoding: "{{ item.encoding | default('utf8') }}"
    lc_ Collate: "{{ item.lc_Collate | default('utf8_general_ci') }}"
    lc_ctype: "{{ item.lc_ctype | default('utf8_general_ci') }}"
  with_items: "{{ mysql_databases }}"
  when: item.import is not defined or item.import
  no_log: true
  tags:
    - mysql_server
    - mysql_server_create_databases

- name: List databases
  mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_databases }}"
  when: item.import is defined and item.import
  no_log: true
  tags:
    - mysql_server
    - mysql_server_list_databases

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.import }}"
  with_items: "{{ mysql_databases }}"
  when: item.import is defined and item.import
  no_log: true
  tags:
    - mysql_server
    - mysql_server_import_databases

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    state: present
    host: "{{ item.host | default(omit) }}"
   priv: "{{ item.priv | default(omit) }}"
    append_privs: "{{ item.append_privs | default(omit) }}"
    encrypted: "{{ item.encrypted | default(omit) }}"
    update_password: "{{ item.update_password | default(omit) }}"
  with_items: "{{ mysql_users }}"
  no_log: true
  tags:
    - mysql_server
    - mysql_server_create_users

- name: Flush handlers
  meta: flush_handlers

- name: Flush handlers again
  meta: flush_handlers



