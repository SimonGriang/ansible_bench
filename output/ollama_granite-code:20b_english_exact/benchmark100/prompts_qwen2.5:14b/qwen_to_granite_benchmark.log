  command: "kubectl drain {{ rke2_node_name }} --ignore-daemonsets --force --grace-period {{ rke2_drain_grace_period }} --timeout {{ rke2_drain_timeout }} {{ rke2_drain_additional_args }} --kubeconfig=/etc/kubernetes/admin.conf"
  args:
    chdir: "{{ rke2_data_path }}"
  register: drain_result
  until: drain_result is succeeded
  retries: 100
  delay: 15
  changed_when: false
  check_mode: false

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2-server
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  command: "kubectl wait node --for condition=Ready --all --kubeconfig=/etc/kubernetes/admin.conf"
  retries: 100
  delay: 15
  changed_when: false
  check_mode: false

- name: Uncordon the node {{ rke2_node_name }}
  command: "kubectl uncordon {{ rke2_node_name }} --kubeconfig=/etc/kubernetes/admin.conf"
  args:
    chdir: "{{ rke2_data_path }}"
  when: rke2_drain_node_during_upgrade
  changed_when: false
  check_mode: false

- name: Wait for all pods to be ready again
  command: "kubectl wait pod --all --for condition=Ready --kubeconfig=/etc/kubernetes/admin.conf"
  retries: 100
  delay: 15
  changed_when: false
  check_mode: false
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  command: "kubectl wait pod --all --for condition=Ready --timeout=60s --kubeconfig=/etc/kubernetes/admin.conf"
  retries: 100
  delay: 15
  changed_when: false
  check_mode: false
  when: rke2_wait_for_all_pods_to_be_healthy


