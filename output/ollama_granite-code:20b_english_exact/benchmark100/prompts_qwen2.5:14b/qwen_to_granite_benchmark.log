- name: Install epel gpg key
  ansible.builtin.rpm_key:
    key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-8
  when: ansible_os_family == "RedHat"

- name: Install epel
  ansible.builtin.yum:
    name: "epel-release{{ epel_next | ternary('', '-next') }}"
