---
- name: Create document root directories for each virtual host
  file:
    path: "{{ item.documentroot }}"
    state: directory
    owner: root
    group: root
    mode: 0755
  loop: "{{ httpd_vhosts }}"
  when: item.create_docroot is undefined or item.create_docroot

- name: Configure virtual hosts using a template
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    owner: root
    group: root
    mode: 0644
  register: httpd_configuration
  notify: restart httpd
  loop: "{{ httpd_vhosts }}"


