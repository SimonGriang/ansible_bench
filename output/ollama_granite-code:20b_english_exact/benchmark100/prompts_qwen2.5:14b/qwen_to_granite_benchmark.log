e': True, 'done_reason': 'stop', 'total_duration': 16816290486, 'load_duration': 26650193, 'prompt_eval_count': 3114, 'prompt_eval_duration': 1912126479, 'eval_count': 521, 'eval_duration': 14876346250, 'model_name': 'granite-code:20b'} id='run--5a9d91aa-5ece-4652-808c-7732ca0e0e2d-0' usage_metadata={'input_tokens': 3114, 'output_tokens': 521, 'total_tokens': 3635}
