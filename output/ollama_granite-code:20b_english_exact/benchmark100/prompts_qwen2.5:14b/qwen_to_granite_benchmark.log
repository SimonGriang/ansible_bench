---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes

- name: Configure apk
  package:
    update_cache: yes
    upgrade: yes
  notify: Reboot host

- name: Configure apt
  apt:
    update_cache: yes
    upgrade: yes
    autoremove: yes
    dpkg_options: "--force-confold --force-confdef"
  notify: Reboot host

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    exclude: kernel,kernel-headers
  notify: Reboot host

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes
  notify: Reboot host

- name: Configure yum
  yum:
    name: '*'
    state: latest
  notify: Reboot host
  when: ansible_pkg_mgr == "yum"

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest
  notify: Reboot host


