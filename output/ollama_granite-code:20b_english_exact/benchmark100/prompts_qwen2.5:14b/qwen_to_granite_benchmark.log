---
- name: hardening | Disable swap temporarily and permanently if vault_hardening_disable_swap is true
  command: swapoff -a
  when: vault_hardening_disable_swap

- name: hardening | Disable swap now if swap is currently enabled
  command: swapoff -a
  when: ansible_swaptotal_mb > 0 and vault_hardening_disable_swap

- name: hardening | Disable swap permanently by unmounting the swap partition if vault_hardening_disable_swap is true
  mount:
    name: swap
    state: absent
  when: vault_hardening_disable_swap

- name: hardening | Disable core dumps for all domains if vault_hardening_disable_core_dumps is true
  pam_limits:
    domain: "{{ item }}"
    limit_type: core
    limit_item: hard
    value: 0
  loop: "{{ ansible_domain | default('localhost') }}"
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable shell command history if vault_hardening_disable_shell_command_history is true
  copy:
    dest: /etc/profile.d/vault-hardening.sh
    content: |
      export HISTCONTROL=ignoreboth
      export HISTSIZE=0
  when: vault_hardening_disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor if vault_hardening_configure_selinux_apparmor is true
  tags: skip_ansible_lint
  when: vault_hardening_configure_selinux_apparmor
  block:
    - name: hardening | Enable SELinux if it is currently enabled
      command: setenforce 1
      when: ansible_selinux.status == "enabled"

    - name: hardening | Install selinux-policy package if not installed
      package:
        name: selinux-policy
        state: present
      when: ansible_selinux.status != "enabled"

    - name: hardening | Set SELinux policy to targeted and enforce it
      selinux:
        policy: targeted
        state: "{{ 'enforcing' if (ansible_selinux.status == 'enabled' and ansible_selinux.enforcing) else 'permissive' }}"
      when: ansible_selinux.status == "enabled"

    - name: hardening | Enable AppArmor enforcement for the vault binary if it is currently enabled
      tags: skip_ansible_lint
      command: aa-enforce /usr/local/bin/vault
      when: ansible_apparmor.enforcing | default(false) | bool


