---
- name: Create SSL Keys
  hosts: all
  tasks:
    - name: Create ssl key
      openssl_privatekey:
        path: "{{ item.ssl_key }}"
        size: 2048
        mode: "0600"
        owner: "{{ item.user }}"
        group: "{{ item.group }}"
      with_items: "{{ ssl_config }}"

    - name: Create ssl csr
      openssl_csr:
        path: "{{ item.ssl_csr }}"
        privatekey_path: "{{ item.ssl_key }}"
        common_name: "{{ item.common_name }}"
        mode: "0600"
        owner: "{{ item.user }}"
        group: "{{ item.group }}"
      with_items: "{{ ssl_config }}"

    - name: Create ssl certificates
      openssl_certificate:
        path: "{{ item.ssl_crt }}"
        privatekey_path: "{{ item.ssl_key }}"
        csr_path: "{{ item.ssl_csr }}"
        provider: selfsigned
        mode: "0600"
        owner: "{{ item.user }}"
        group: "{{ item.group }}"
      with_items: "{{ ssl_config }}"

    - name: Create PKCS#12 file
      openssl_pkcs12:
        action: export
        privatekey_path: "{{ item.ssl_key }}"
        certificate_path: "{{ item.ssl_crt }}"
        path: "{{ item.ssl_p12 }}"
        iteration: 3
        mode: "0600"
        owner: "{{ item.user }}"
        group: "{{ item.group }}"
      with_items: "{{ ssl_config }}"

    - name: Read private key
      slurp:
        src: "{{ item.ssl_key }}"
      register: private_key
      with_items: "{{ ssl_config }}"

    - name: Read certificate
      slurp:
        src: "{{ item.ssl_crt }}"
      register: certificate
      with_items: "{{ ssl_config }}"

    - name: Create combined private_key and certificate file
      copy:
        dest: "{{ item.ssl_combined }}"
        content: "{{ private_key['content'] }}{{ certificate['content'] }}"
        mode: "0600"
        owner: "{{ item.user }}"
        group: "{{ item.group }}"
      with_items: "{{ ssl_config }}"


