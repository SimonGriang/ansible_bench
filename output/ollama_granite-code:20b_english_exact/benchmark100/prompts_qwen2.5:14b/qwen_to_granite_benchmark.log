---

- import_tasks: assert.yml

- name: Install requirements
  package:
    name: bash
    state: present

- block:
    - name: Install openjdk java (package)
      package:
        name: openjdk
        state: present
  when: java_vendor == "openjdk"

- name: Install RPM
  package:
    name: "{{ java_package }}"
    state: present
    src: "{{ java_package_url }}"
    validate_certs: no
  when: java_vendor == "oracle" and java_package_type == "rpm"

- name: Install DEB
  package:
    name: "{{ java_package }}"
    state: present
    src: "{{ java_package_url }}"
    validate_certs: no
  when: java_vendor == "oracle" and java_package_type == "deb"

- name: Install oracle java (rpm) (repository)
  package:
    name: oracle-java
    state: present
  when: java_vendor == "oracle" and java_package_type == "rpm" and java_package_url == ""

- name: Configure oracle targz
  unarchive:
    src: "{{ java_package_url }}"
    dest: /opt
    remote_src: yes
    creates: /opt/jdk
  when: java_vendor == "oracle" and java_package_type == "targz"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_jce_url }}"
    dest: /opt/jdk/jre/lib/security
    remote_src: yes
  when: java_vendor == "oracle" and java_package_type == "targz"

- name: Set alternative (targz)
  alternatives:
    name: java
    link: /usr/bin/java
    path: /opt/jdk/bin/java
  when: java_package_type == "targz" and not ansible_os_family == "alpine"

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java
  register: java_home

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: ^JAVA_HOME=
    line: JAVA_HOME="{{ java_home.stdout }}"




