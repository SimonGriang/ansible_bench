---
- name: Backports repository for older Debian versions
  apt_repository:
    filename: "{{ ansible_distribution_release }}-backports"
    repo: "deb http://http.debian.net/debian {{ ansible_distribution_release }}-backports main contrib non-free"
    state: present
  when: ansible_distribution == "Debian" and ansible_distribution_version | int < 9

- name: Set default_release for older Debian versions
  set_fact:
    ansible_default_release: "{{ ansible_distribution_release }}-backports"
  when: ansible_distribution == "Debian" and ansible_distribution_version | int < 9

- name: Install Ansible for older Debian versions
  apt:
    name: ansible
    state: "{{ ansible_package_state }}"
    default_release: "{{ ansible_default_release }}"
  when: ansible_distribution == "Debian" and ansible_distribution_version | int < 9


