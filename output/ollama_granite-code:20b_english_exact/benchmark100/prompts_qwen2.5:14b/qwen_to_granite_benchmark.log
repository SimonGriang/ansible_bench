---
- import_tasks: assert.yml
- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present
- name: Configure shell
  lineinfile:
    path: /etc/cron.d/anisible
    line: "SHELL={{ cron_shell }}"
    create: true
    mode: 0600
    notify: Restart cron
  when: cron_shell is defined and cron_shell
- name: Configure path
  lineinfile:
    path: /etc/cron.d/anisible
    line: "PATH={{ cron_path }}"
    create: true
    mode: 0600
    notify: Restart cron
  when: cron_path is defined and cron_path
- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/anisible
    line: "MAILTO={{ cron_mailto }}"
    create: true
    mode: 0600
    notify: Restart cron
  when: cron_mailto is defined and cron_mailto
- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service
- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    special_time: "{{ item.special_time | default(omit) }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    user: "{{ item.user | default(omit) }}"
    state: "{{ item.state | default(omit) }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"


