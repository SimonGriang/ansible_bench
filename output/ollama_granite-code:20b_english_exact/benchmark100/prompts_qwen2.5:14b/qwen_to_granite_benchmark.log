  package:
    name: "{{ redis_packages }}"
    state: present
  become: true
  tags:
    - redis

- name: "Configure redis"
  template:
    src: redis.conf.j2
    dest: /etc/redis.conf
    owner: redis
    group: redis
    mode: 0644
  become: true
  notify: restart redis
  tags:
    - redis

- name: "Start and enable redis"
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes
  become: true
  tags:
    - redis


