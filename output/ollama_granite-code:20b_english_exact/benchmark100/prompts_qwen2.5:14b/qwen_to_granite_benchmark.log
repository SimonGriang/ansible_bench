---
- name: Create ssl key
  openssl_privatekey:
    path: "{{ item.ssl_key }}"
    mode: 640
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
  loop: "{{ create_ssl_certs_items }}"

- name: Create ssl csr
  openssl_csr:
    path: "{{ item.ssl_csr }}"
    privatekey_path: "{{ item.ssl_key }}"
    mode: 644
    common_name: "{{ item.common_name }}"
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
  loop: "{{ create_ssl_certs_items }}"

- name: Create ssl certificates
  openssl_certificate:
    path: "{{ item.ssl_certificate }}"
    privatekey_path: "{{ item.ssl_key }}"
    csr_path: "{{ item.ssl_csr }}"
    mode: 644
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
  loop: "{{ create_ssl_certs_items }}"

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ item.pkcs12_path }}"
    privatekey_path: "{{ item.ssl_key }}"
    certificate_path: "{{ item.ssl_certificate }}"
    friendly_name: "{{ item.friendly_name }}"
    mode: 640
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
  loop: "{{ create_ssl_certs_items }}"

- name: Read private key
  slurp:
    src: "{{ item.ssl_key }}"
  register: private_key_content
  loop: "{{ create_ssl_certs_items }}"

- name: Read certificate
  slurp:
    src: "{{ item.ssl_certificate }}"
  register: certificate_content
  loop: "{{ create_ssl_certs_items }}"

- name: Create combined private_key and certificate file
  copy:
    dest: "{{ item.combined_path }}"
    content: "{{ private_key_content['content'] + certificate_content['content'] }}"
    mode: 640
    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
  loop: "{{ create_ssl_certs_items }}"


