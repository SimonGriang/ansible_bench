---
- name: "RKE2 Tasks"
  tasks:
    - name: "Install Keepalived when HA mode is enabled"
      apt:
        name: keepalived
        state: present
      when: ha_mode and rke2_server_group in group_names
    - name: "Download and install RKE2"
      get_url:
        url: https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/rke2.yml
        dest: /var/lib/rke2/rke2.yml
    - name: "CIS Hardening"
      command: "rke2-cis-hardening -p {{ cis_profile }}"
      when: cis_profile is defined
    - name: "Find Active Server"
      shell: "curl -k -s -w '%{url_effective}' -o /dev/null -u 'kubeadmin' 'https://{{ rke2_server_url }}:9345.{{ rke2_domain }}'"
      register: rke2_active_server
    - name: "Enable IPVS kernel module"
      modprobe:
        name: ip_vs
        state: present
      when: kubevip_mode and ha_mode
    - name: "Copy kube-vip manifests to the masternode"
      copy:
        src: "{{ kubevip_manifests_url }}"
        dest: /var/lib/rke2/kube-vip.yml
      when: not ha_mode
    - name: "Copy ingress-nginx manifests to the masternode"
      copy:
        src: https://raw.githubusercontent.com/kubernetes/ingress-nginx/controller-v1.0.0/deploy/static/provider/baremetal/deploy.yaml
        dest: /var/lib/rke2/ingress-nginx.yml
      when: ingress_nginx_config is defined
    - name: "Prepare very first server node in the cluster"
      shell: |
        rke2 server --config /var/lib/rke2/rke2.yml --token {{ rke2_token }} --controlplane
        sleep 10
      args:
        creates: /etc/rancher/rke2/rke2.yaml
      environment:
        RKE2_ETCD: "true"
        KUBECONFIG: /etc/rancher/rke2/rke2.yaml
      register: rke2_init_output
      until: rke2_init_output.stderr == ""
      retries: 10
      delay: 10
      changed_when: false
    - name: "Restore etcd specific tasks"
      shell: |
        rke2 etcd-snapshot restore --config /var/lib/rke2/rke2.yml --name {{ rke2_active_server }}
        sleep 10
        systemctl enable rke2-server.service
        systemctl start rke2-server.service
        sleep 10
      args:
        creates: /etc/rancher/rke2/rke2.yaml
      environment:
        KUBECONFIG: /etc/rancher/rke2/rke2.yaml
      when: rke2_etcd_snapshot is defined and rke2_etcd_snapshot != ""
    - name: "Download kubeconfig to ansible localhost"
      fetch:
        src: "/etc/rancher/rke2/rke2.yaml"
        dest: "{{ ansible_user_dir }}/"
        flat: yes
      when: download_kubeconfig
    - name: "Prepare and join remaining nodes of the cluster"
      shell: |
        rke2 server --config /var/lib/rke2/rke2.yml --token {{ rke2_token }} --worker
        sleep 10
      args:
        creates: /etc/rancher/rke2/rke2.yaml
      environment:
        KUBECONFIG: /etc/rancher/rke2/rke2.yaml
      when: rke2_active_server is defined
    - name: "Rolling cordon and drain restart when version changes - servers"
      shell: |
        rke2 upgrade --config /var/lib/rke2/rke2.yml --ignore-docker-version
      environment:
        KUBECONFIG: /etc/rancher/rke2/rke2.yaml
      register: rke2_upgrade_output
      until: rke2_upgrade_output.stderr == ""
      retries: 10
      delay: 10
      changed_when: false
    - name: "Rolling cordon and drain restart when version changes - agents"
      shell: |
        rke2 upgrade --config /var/lib/rke2/rke2.yml --ignore-docker-version --server {{ rke2_active_server }}
      environment:
        KUBECONFIG: /etc/rancher/rke2/rke2.yaml
      register: rke2_upgrade_output
      until: rke2_upgrade_output.stderr == ""
      retries: 10
      delay: 10
      changed_when: false
    - name: "Flush handlers"
      meta: flush_handlers
    - name: "Rolling restart when config files change"
      shell: |
        rke2 restart --config /var/lib/rke2/rke2.yml --force --cluster-reset
        sleep 10
        systemctl enable rke2-server.service
        systemctl start rke2-server.service
        sleep 10
      environment:
        KUBECONFIG: /etc/rancher/rke2/rke2.yaml
      register: rke2_upgrade_output
      until: rke2_upgrade_output.stderr == ""
      retries: 10
      delay: 10
      changed_when: false
    - name: "Final steps"
      shell: |
        rke2 rotate-token --config /var/lib/rke2/rke2.yml
        sleep 10
        systemctl enable rke2-server.service
        systemctl start rke2-server.service
        sleep 10
        if [ -f "/etc/systemd/system/rke2-server.service" ]; then
          systemctl daemon-reload
          sleep 10
          systemctl restart rke2-server.service
        else
          docker restart rke2-server
        fi
      environment:
        KUBECONFIG: /etc/rancher/rke2/rke2.yaml


