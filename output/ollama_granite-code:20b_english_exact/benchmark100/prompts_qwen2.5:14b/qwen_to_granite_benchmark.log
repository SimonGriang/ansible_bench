---
- name: Install Keepalived when HA mode is enabled
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Install Keepalived
    apt:
      name: keepalived
      state: present
    when: ha_mode and rke2_group == "server"
  tags:
  - always

- name: Download and install RKE2
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Download and install RKE2
    command: snap install rke2 --channel {{ rke2_channel }} --classic
    register: download_rke2
  - name: Check if RKE2 is installed
    command: rke2 version
    changed_when: false
  - name: Set rke2.yaml configuration
    template:
      src: rke2.yaml.j2
      dest: /var/lib/rke2/config.yaml
      owner: root
      group: root
      mode: 0644
    notify:
    - Restart RKE2
  - name: Check if rke2.yaml is configured
    stat:
      path: /var/lib/rke2/config.yaml
    register: rke2_yaml
  - name: Start RKE2 service
    systemd:
      name: rke2-server
      state: started
      enabled: yes
  tags:
  - always

- name: CIS Hardening
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Perform CIS Hardening
    command: cis-hardening --profile {{ cis_profile }}
    when: cis_profile is defined
  tags:
  - always

- name: Find Active Server
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Identify the active server in the RKE2 cluster
    command: rke2-active-server
  tags:
  - always

- name: Enable IPVS kernel module
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Enable the IPVS kernel module when using Kube-VIP and HA mode
    modprobe:
      name: ip_vs
      state: present
    when: kubevip_mode and ha_mode
  tags:
  - always

- name: Copy kube-vip manifests to the masternode
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Copy Kube-VIP manifests to the main server node when not using Keepalived
    copy:
      src: kubevip.yaml
      dest: /var/lib/rke2/manifests/kubevip.yaml
    when: not ha_mode
  tags:
  - always

- name: Copy ingress-nginx manifests to the masternode
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Copy the ingress-nginx manifests to the main server node if the configuration is defined
    copy:
      src: ingress-nginx.yaml
      dest: /var/lib/rke2/manifests/ingress-nginx.yaml
    when: ingress_nginx_config is defined
  tags:
  - always

- name: Prepare very first server node in the cluster
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Prepare the very first server node in the cluster for initial setup
    command: rke2-server --bootstrap
  tags:
  - always

- name: Restore etcd specific tasks
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Restore etcd specific tasks if etcd needs to be restored
    command: rke2-etcd-restore --backup-dir /var/lib/rke2/etcd-backup.tar.gz
  tags:
  - always

- name: Download kubeconfig to ansible localhost
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Download the kubeconfig to the Ansible control machine if enabled
    fetch:
      src: /etc/kubernetes/admin.conf
      dest: /tmp/kubeconfig
      flat: yes
  tags:
  - always

- name: Prepare and join remaining nodes of the cluster
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Prepare and join remaining nodes of the cluster if the active server is defined
    command: rke2-server
  when: rke2_active_server is defined
  tags:
  - always

- name: Rolling cordon and drain restart when version changes - servers
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Perform rolling restart for servers when the RKE2 version changes
    command: rke2-rolling-restart
  tags:
  - always

- name: Rolling cordon and drain restart when version changes - agents
  hosts: rke2_agent
  tasks:
  - name: Perform rolling restart for agents when the RKE2 version changes
    command: rke2-rolling-restart
  tags:
  - always

- name: Flush handlers
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Flush all handlers at this point
    meta: flush_handlers
  tags:
  - always

- name: Rolling restart when config files change
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Perform rolling restart when configuration files change
    command: rke2-rolling-restart
  tags:
  - always

- name: Final steps
  hosts: rke2_server:!rke2_server:1
  tasks:
  - name: Final steps to complete the playbook execution
    command: rke2-server --upload- cert
  tags:
  - always


