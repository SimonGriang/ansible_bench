---
- name: check if all variables have been set correctly
  ansible.builtin.assert:
    that:
      - api_url is defined
      - api_user is defined
      - api_password is defined
      - project_name is defined

- name: wait for host (when configured)
  ansible.builtin.wait_for:
    host: "{{ api_url | urlsplit('hostname') }}"
    port: "{{ api_url | urlsplit('port') | default(80) }}"
    connect_timeout: 10
    state: started
  when: bootstrap_wait_for_host

- name: prepare system
  block:
    - name: establish connection to host
      ansible.builtin.fail:
        msg: "Could not connect to host: {{ api_url | urlsplit('hostname') }}."
      changed_when: false
      register: connection
      until: connection is succeeded
      retries: 10
      delay: 5

    - name: gather facts
      ansible.builtin.setup:
      when: connection is succeeded
  rescue:
    - name: connection failed
      ansible.builtin.debug:
        msg: "Could not connect to host: {{ api_url | urlsplit('hostname') }}."

- name: include tasks to gather bootstrap facts (raw)
  ansible.builtin.include_tasks: tasks/bootstrap-facts.yml

- name: install bootstrap packages (raw).
  ansible.builtin.raw: "{{ bootstrap_install.raw[ansible_os_family] }}"
  changed_when: false
  when: bootstrap_install.raw is defined

- name: ensure system is prepared by issuing ansible modules.
  block:
    - name: gather ansible facts
      ansible.builtin.setup:

    - name: install bootstrap packages
      ansible.builtin.package:
        name: "{{ bootstrap_install.ansible[ansible_os_family][item] }}"
        state: present
      loop: "{{ bootstrap_facts.packages_to_install }}"
      when: bootstrap_install.ansible is defined
  when: bootstrap_install.ansible is defined


