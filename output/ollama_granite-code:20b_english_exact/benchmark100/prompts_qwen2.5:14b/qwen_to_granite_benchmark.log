---
- import_tasks: assert.yml
- name: Remove conflicting systemd-logger
  package:
    name: systemd-logger
    state: absent
  tags:
    - rsyslog
- name: Install rsyslog
  package:
    name: "{{ rsyslog_package_name }}"
    state: "{{ rsyslog_package_state }}"
  tags:
    - rsyslog
- name: Install additional rsyslog packages
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ rsyslog_features }}"
  tags:
    - rsyslog
- name: Configuring default rsyslog
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: 0644
  when: rsyslog_deploy_default_config
  notify: restart rsyslog
  tags:
    - rsyslog
- name: Make configuration directory
  file:
    path: /etc/rsyslog.d/
    state: directory
    owner: root
    group: root
    mode: 0755
  tags:
    - rsyslog
- name: Configuring rsyslog forward rule
  template:
    src: 02-forward.conf.j2
    dest: /etc/rsyslog.d/02-forward.conf
    owner: root
    group: root
    mode: 0644
  when: not rsyslog_deploy_default_config
  notify: restart rsyslog
  tags:
    - rsyslog
- name: Configuring additional config files
  copy:
    src: "{{ item }}"
    dest: /etc/rsyslog.d/
    owner: root
    group: root
    mode: 0644
  with_fileglob:
    - ../files/rsyslog.d/*.conf
  notify: restart rsyslog
  tags:
    - rsyslog
- name: Start and enable rsyslog
  service:
    name: rsyslog
    state: started
    enabled: true
  tags:
    - rsyslog


