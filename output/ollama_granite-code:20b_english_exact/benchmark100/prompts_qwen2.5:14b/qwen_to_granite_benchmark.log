---
- name: Task 1
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: "0755"

- name: Task 2
  ansible.builtin.command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki

- name: Task 3
  ansible.builtin.command: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/ca.crt

- name: Task 4
  ansible.builtin.command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/dh2048.pem

- name: Task 5
  ansible.builtin.command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/server.crt

- name: Task 6
  ansible.builtin.command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/client.crt

- name: Task 7
  ansible.builtin.command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/crl.pem

- name: Task 8
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Task 9
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/openvpn/server
    mode: "0600"
  with_items:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/ta.key
    - /etc/openvpn/easy-rsa/pki/dh2048.pem
    - /etc/openvpn/easy-rsa/pki/server.crt
    - /etc/openvpn/easy-rsa/pki/server.key
    - /etc/openvpn/easy-rsa/pki/crl.pem

- name: Task 10
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/openvpn
    mode: "0600"
  with_items:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/ta.key
    - /etc/openvpn/easy-rsa/pki/dh2048.pem
    - /etc/openvpn/easy-rsa/pki/server.crt
    - /etc/openvpn/easy-rsa/pki/server.key
    - /etc/openvpn/easy-rsa/pki/crl.pem

- name: Task 11
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
  notify: restart openvpn


