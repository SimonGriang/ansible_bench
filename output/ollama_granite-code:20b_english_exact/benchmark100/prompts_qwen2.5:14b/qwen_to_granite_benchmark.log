---
- name: Run tasks for installing Java
  block:
    - name: Update java_jdk_vendor to temurin if it is adoptopenjdk
      set_fact:
        java_jdk_vendor: temurin
      when: java_jdk_vendor == "adoptopenjdk"

    - name: Include OS-specific variables based on distribution
      include_vars: "{{ java_os_variables_file }}"
      when: java_os_variables_file is defined

    - name: Include architecture-specific variables
      include_vars: "{{ java_arch_variables_file }}"
      when: java_arch_variables_file is defined

    - name: Set OS-specific variables (part I)
      set_fact:
        java_os_VARIABLE: value
      when: java_os_VARIABLE is not none

    - name: Set OS and architecture-specific variables (part II)
      set_fact:
        java_os_VARIABLE: value
      when: java_os_VARIABLE is not none

    - name: Set specific variables
      set_fact:
        java_home: "{{ java_openjdk_home }}"

    - name: Debian pre-requisites
      block:
        - name: Remove deprecated repositories
          apt_repository:
            repo: "deb http://http.debian.net/debian {{ ansible_distribution_release }}-backports main contrib non-free"
            state: absent
        - name: Install extra apt tools
          apt:
            name: "{{ item }}"
            state: present
          loop:
            - apt-transport-https
            - ca-certificates
            - curl
            - gnupg2
            - software-properties-common
        - name: Add key repositories
          apt_key:
            url: "{{ item }}"
            state: present
          loop:
            - https://download.iaas.uio.no/uh-iaas/rpm/debian/RPM-GPG-KEY-uh-iaas
            - https://download.iaas.uio.no/uh-iaas/rpm/debian/RPM-GPG-KEY-ua-adop
        - name: Add repositories
          apt_repository:
            repo: "deb https://download.iaas.uio.no/uh-iaas/debian {{ ansible_distribution_release }} main"
            state: present
      when: ansible_os_family == "Debian"

    - name: RedHat pre-requisites
      block:
        - name: Add key repositories
          get_url:
            url: "{{ item }}"
            dest: /etc/yum/RPM-GPG-KEY-uh-iaas
            mode: 0644
          loop:
            - https://download.iaas.uio.no/uh-iaas/rpm/debian/RPM-GPG-KEY-uh-iaas
            - https://download.iaas.uio.no/uh-iaas/rpm/debian/RPM-GPG-KEY-ua-adop
        - name: Add repositories
          template:
            src: java.repo.j2
            dest: /etc/yum.repos.d/java.repo
      when: ansible_os_family == "RedHat"

    - name: Install required libraries
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ java_required_libs }}"
      when: java_required_libs is defined

    - name: Install Java, Debian
      block:
        - name: Update apt cache
          apt:
            update_cache: yes
            cache_valid_time: 3600
        - name: Install Java
          apt:
            name: openjdk-11-jdk
            state: present
        - name: Check if package is installed
          shell: dpkg -l openjdk-11-jdk | grep ^ii | wc -l
          register: openjdk_11_jdk_package_check
        - name: Fail if package is not installed
          fail:
            msg: "Java package was not installed"
          when: openjdk_11_jdk_package_check.stdout | int == 0
      when: ansible_os_family == "Debian"

    - name: Install Java, RedHat
      block:
        - name: Update yum cache
          yum:
            update_cache: yes
            cache_valid_time: 3600
        - name: Install Java
          yum:
            name: java-1.8.0-openjdk
            state: present
        - name: Check if package is installed
          shell: yum list installed | grep "java-1.8.0-openjdk" | wc -l
          register: java_1_8_0_openjdk_package_check
        - name: Fail if package is not installed
          fail:
            msg: "Java package was not installed"
          when: java_1_8_0_openjdk_package_check.stdout | int == 0
      when: ansible_os_family == "RedHat"

    - name: Export environment variables
      template:
        src: java_env.sh.j2
        dest: /etc/profile.d/java_env.sh
      when: ansible_os_family == "Debian"

    - name: Source environment variables
      shell: . /etc/profile.d/java_env.sh
      when: ansible_os_family == "Debian"

    - name: Correct java version selected for Java versions less than 11
      shell: update-alternatives --set java /usr/lib/jvm/java-1.8.0-openjdk-amd64/jre/bin/java
      when: ansible_os_family == "Debian" and java_version < 11

    - name: Correct java version selected for Java versions greater than or equal to 11
      shell: update-alternatives --set java /usr/lib/jvm/java-11-openjdk-amd64/bin/java
      when: ansible_os_family == "Debian" and java_version >= 11

  when: java_required


