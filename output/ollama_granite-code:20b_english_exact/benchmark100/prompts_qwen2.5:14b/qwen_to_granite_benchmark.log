---
- name: Create SSL Keys
  hosts: all
  tasks:
    - name: Create ssl key
      openssl_privatekey:
        path: "{{ item.ssl_key }}"
        size: 2048
        mode: 0600
        owner: "{{ item.user }}"
        group: "{{ item.group }}"
      with_items: "{{ ssl_config }}"

    - name: Create ssl csr
      openssl_csr:
        path: "{{ item.ssl_csr }}"
        privatekey_path: "{{ item.ssl_key }}"
        common_name: "{{ item.common_name }}"
        mode: 0600
        owner: "{{ item.user }}"
        group: "{{ item.group }}"
      with_items: "{{ ssl_config }}"

    - name: Create ssl certificates
      openssl_ certificate:
        path: "{{ item.ssl_crt }}"
        privatekey_path: "{{ item.ssl_key }}"
        csr_path: "{{ item.ssl_csr }}"
        provider: selfsigned
        mode: 0600
        owner: "{{ item.user }}"
        group: "{{ item.group }}"
      with_items: "{{ ssl_config }}"

    - name: Create PKCS#12 file
      openssl_ pkcs12:
        action: export
        privatekey_path: "{{ item.ssl_key }}"
        certificate_path: "{{ item.ssl_crt }}"
        path: "{{ item.ssl_p12 }}"
        iteration: 3
