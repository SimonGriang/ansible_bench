---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  ansible.posix.selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when: selinux_enabled | bool

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "0644"
  notify:
    - test config
    - restart service

- name: Activate httpd module | Debian
  ansible.builtin.command: a2enmod {{ item }}
  loop: "{{ httpd_modules }}"
  notify: test config

- name: Import ssl.yml
  ansible.builtin.import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import locations.yml
  ansible.builtin.import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  ansible.builtin.import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  ansible.builtin.template:
    src: "{{ httpd_ports_config_src }}"
    dest: "{{ httpd_ports_config_dest }}"
    mode: "0644"
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"
  notify:
    - test config
    - restart service

- name: Import directories.yml
  ansible.builtin.import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  ansible.builtin.file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


