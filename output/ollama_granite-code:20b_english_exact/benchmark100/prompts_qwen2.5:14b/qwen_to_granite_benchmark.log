    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  ansible.builtin.lineinfile:
    path: /etc/cron.allow
    line: "{{ cron_shell }}"
    create: true
    mode: "0600"
    notify: Restart cron
  when: cron_shell is defined and cron_shell | length > 0

- name: Configure path
  ansible.builtin.lineinfile:
    path: /etc/cron.allow
    line: "{{ cron_path }}"
    create: true
    mode: "0600"
    notify: Restart cron
  when: cron_path is defined and cron_path | length > 0

- name: Configure mailto
