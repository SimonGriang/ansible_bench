content='---\n- name: Check current docker-compose version\n  command: docker-compose --version\n  register: current_docker_compose_version\n\n- name: Set fact for current Docker Compose version\n  set_fact:\n    current_docker_compose_version: "{{ current_docker_compose_version.stdout | regex_replace(\'^Docker Compose version v([0-9]+.[0-9]+.[0-9]+), build .*$\', \'\\\\1\') }}"\n\n- name: Delete existing docker-compose version if it\'s different\n  file:\n    path: /usr/local/bin/docker-compose\n    state: absent\n  when: current_docker_compose_version.stdout != docker_compose_version\n\n- name: Install Docker Compose (if configured)\n  get_url:\n    url: https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-Linux-x86_64\n    dest: /usr/local/bin/docker-compose\n    mode: 0755\n  when: current_docker_compose_version.stdout != docker_compose_version or docker_compose_version not in current_docker_compose_version.stdout' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-08T13:37:27.338210817Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5400337217, 'load_duration': 36497880, 'prompt_eval_count': 425, 'prompt_eval_duration': 187320586, 'eval_count': 261, 'eval_duration': 5175110222, 'model_name': 'granite-code:20b'} id='run--29bb33a4-fd18-4bec-965a-a4c47a289c91-0' usage_metadata={'input_tokens': 425, 'output_tokens': 261, 'total_tokens': 686}
