---

- name: Task 1
  block:
    - name: Update java_jdk_vendor to temurin if it is adoptopenjdk
      set_fact:
        java_jdk_vendor: temurin
      when: java_jdk_vendor == "adoptopenjdk"
  when: java_jdk_vendor is defined

- name: Task 2
  include_vars:
    file: "{{ item }}"
    name: java_variables
  with_first_found:
    - ../vars/{{ ansible_distribution | lower }}-{{ java_version }}.yml
    - ../vars/{{ ansible_os_family | lower }}-{{ java_version }}.yml
    - ../vars/{{ ansible_distribution | lower }}-{{ ansible_architecture }}.yml
    - ../vars/{{ ansible_os_family | lower }}-{{ ansible_architecture }}.yml
    - ../vars/{{ ansible_distribution | lower }}.yml
    - ../vars/{{ ansible_os_family | lower }}.yml
    - ../vars/main.yml
  tags:
    - always

- name: Task 3
  include_vars:
    file: ../vars/{{ java_jdk_vendor | lower }}.yml
    name: java_variables
  tags:
    - always

- name: Task 4
  block:
    - name: Set OS-specific variables (part I)
      set_fact:
        java_apt_keyring: "deb http://keyserver.ubuntu.com:80 {{ ansible_distribution_release }}-security main"
      when: ansible_os_family == "Debian"

- name: Task 5
  block:
    - name: Set OS and architecture-specific variables (part II)
      set_fact:
        java_apt_repository: "deb http://deb.debian.org/debian {{ ansible_distribution_release }} main contrib non-free"
      when: ansible_distribution == "Debian" and ansible_architecture == "x86_64"

- name: Task 6
  block:
    - name: Set specific variables
      set_fact:
        java_home: "{{ java_openjdk_home }}"

- name: Task 7
  block:
    - name: Debian pre-requisites
      apt:
        update_cache: true
        name: "{{ item }}"
        state: present
      with_items:
        - software-properties-common
  when: ansible_os_family == "Debian"

- name: Task 8
  block:
    - name: RedHat pre-requisites
      yum:
        name: "{{ item }}"
        state: present
      with_items:
        - yum-utils
  when: ansible_os_family == "RedHat"

- name: Task 9
  block:
    - name: Install required libraries
      apt:
        name: "{{ item }}"
        state: present
        update_cache: true
      with_items: "{{ java_apt_extra_packages }}"
  when: ansible_os_family == "Debian"

- name: Task 10
  block:
    - name: Install Java, Debian
      apt:
        name: "{{ java_apt_package }}"
        state: present
        install_recommends: false
        update_cache: true
      register: java_apt_result
    - name: Check that package is installed
      debug:
        msg: "{{ java_apt_package }} installed {{ java_apt_result }}"
  when: ansible_os_family == "Debian"

- name: Task 11
  block:
    - name: Install Java, RedHat
      yum:
        name: "{{ java_yum_package }}"
        state: present
      register: java_yum_result
    - name: Check that package is installed
      debug:
        msg: "{{ java_yum_package }} installed {{ java_yum_result }}"
  when: ansible_os_family == "RedHat"

- name: Task 12
  block:
    - name: Export environment variables
      template:
        src: ../templates/java_env.j2
        dest: /etc/profile.d/java_env.sh
        mode: 0644
  tags:
    - skip_ansible_lint

- name: Task 13
  block:
    - name: Source environment variables
      shell: source /etc/profile.d/java_env.sh
  tags:
    - skip_ansible_lint

- name: Task 14
  block:
    - name: Correct java version selected for Java versions less than 11
      shell: update-alternatives --set java /usr/lib/jvm/java-1.{{ java_version }}-openjdk-amd64/jre/bin/java
      args:
        creates: /etc/alternatives/java
  when: ansible_os_family == "Debian" and java_version < 11

- name: Task 15
  block:
    - name: Correct java version selected for Java versions greater than or equal to 11
      shell: update-alternatives --set java /usr/lib/jvm/java-{{ java_version }}-openjdk-amd64/bin/java
      args:
        creates: /etc/alternatives/java
  when: ansible_os_family == "Debian" and java_version >= 11


