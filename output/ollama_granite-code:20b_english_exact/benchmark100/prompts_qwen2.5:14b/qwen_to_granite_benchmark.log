- name: Install additional rsyslog packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features }}"
  tags:
    - rsyslog
- name: Configuring default rsyslog
  ansible.builtin.template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: "0644"
  when: rsyslog_deploy_default_config
  notify: restart rsyslog
  tags:
    - rsyslog
- name: Make configuration directory
  ansible.builtin.file:
    path: /etc/rsyslog.d/
    state: directory
    owner: root
    group: root
    mode: "0755"
  tags:
    - rsyslog
- name: Configuring rsyslog forward rule
  ansible.builtin.template:
    src: 02-forward.conf.j2
    dest: /etc/rsyslog.d/02-forward.conf
    owner: root
    group: root
    mode: "0644"
  when: not rsyslog_deploy_default_config
  notify: restart rsyslog
  tags:
    - rsyslog
- name: Configuring additional config files
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/rsyslog.d/
    owner: root
    group: root
    mode: "0644"
  loop:
    - ../files/rsyslog.d/*.conf
  notify: restart rsyslog
  tags:
    - rsyslog
- name: Start and enable rsyslog
  ansible.builtin.service:
    name: rsyslog
    state: started
    enabled: true
  tags:
    - rsyslog


