---
- name: Promtail installation tasks
  hosts: all
  tasks:
    - name: Ensure unzip package is available
      package:
        name: unzip
        state: present
      when: ansible_os_family == "Debian"

    - name: Ensure unzip package is available
      package:
        name: unzip
        state: present
      when: ansible_os_family == "RedHat"

    - name: Create system group for promtail
      group:
        name: promtail
        state: present
      become: true

    - name: Create promtail user
      user:
        name: promtail
        group: promtail
        state: present
      become: true

    - name: Ensure /usr/local/bin directory exists
      file:
        path: /usr/local/bin
        state: directory
        owner: promtail
        group: promtail
        mode: 0755
      become: true

    - name: Create config directories
      file:
        path: "{{ item }}"
        state: directory
        owner: promtail
        group: promtail
        mode: 0750
      loop:
        - /etc/promtail
        - /etc/promtail/positions
        - /etc/promtail/client
      become: true

    - name: Create application directories
      file:
        path: "{{ item }}"
        state: directory
        owner: promtail
        group: promtail
        mode: 0755
      loop:
        - /usr/local/promtail
        - /usr/local/promtail/positions
      become: true

    - name: Check if promtail binary exists
      stat:
        path: /usr/local/bin/promtail
      register: promtail_binary

    - name: Download promtail binaries
      get_url:
        url: https://github.com/grafana/loki/releases/download/v2.3.0/promtail-linux-amd64.zip
        dest: /tmp/promtail.zip
        mode: 0444
      when: promtail_binary.stat.exists == false and promtail_binary_distribute == "download"
      become: true

    - name: Propagate locally distributed promtail archive
      copy:
        src: /path/to/local/promtail.zip
        dest: /tmp/promtail.zip
        mode: 0444
      when: promtail_binary.stat.exists == false and promtail_binary_distribute == "local"
      become: true

    - name: Download promtail binaries to controller node
      get_url:
        url: https://github.com/grafana/loki/releases/download/v2.3.0/promtail-linux-amd64.zip
        dest: /tmp/promtail.zip
        mode: 0444
      when: promtail_binary.stat.exists == false and promtail_binary_distribute == "propagate"
      delegate_to: localhost
      become: true

    - name: Propagate promtail binaries
      copy:
        src: /tmp/promtail.zip
        dest: /usr/local/bin/promtail.zip
        owner: promtail
        group: promtail
        mode: 0444
      when: promtail_binary.stat.exists == false and promtail_binary_distribute == "propagate"
      become: true

    - name: Unpack promtail binaries
      unarchive:
        src: /usr/local/bin/promtail.zip
        dest: /usr/local/promtail
        owner: promtail
        group: promtail
        mode: 0755
        remote_src: true
      when: promtail_binary.stat.exists == false
      become: true

    - name: Create symlink to latest version
      file:
        src: /usr/local/promtail/promtail
        dest: /usr/local/bin/promtail
        owner: promtail
        group: promtail
        state: link
      notify: restart promtail
      become: true

    - name: Write configuration
      template:
        src: promtail.yml.j2
        dest: /etc/promtail/promtail.yml
        owner: promtail
        group: promtail
        mode: 0640
      notify: restart promtail
      become: true

    - name: Create systemd service unit
      template:
        src: promtail.service.j2
        dest: /etc/systemd/system/promtail.service
        owner: root
        group: root
        mode: 0644
      notify: restart promtail
      become: true

  handlers:
    - name: restart promtail
      systemd:
        name: promtail
        daemon_reload: true
        state: restarted


