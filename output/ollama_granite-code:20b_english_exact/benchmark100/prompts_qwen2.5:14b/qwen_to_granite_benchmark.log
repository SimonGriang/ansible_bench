ile for {{ user.name }}\n  copy:\n    src: "{{ item }}"\n    dest: "{{ user_home.stdout }}/.ssh/"\n    mode: 0600\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n  with_items: "{{ user.private_keys }}"\n  when: user.private_keys is defined' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-08T14:12:34.7591616Z', 'done': True, 'done_reason': 'stop', 'total_duration': 40586086592, 'load_duration': 42811089, 'prompt_eval_count': 2556, 'prompt_eval_duration': 2167417412, 'eval_count': 1269, 'eval_duration': 38374461608, 'model_name': 'granite-code:20b'} id='run--2adde702-1d05-4d94-bd51-89473efb45ce-0' usage_metadata={'input_tokens': 2556, 'output_tokens': 1269, 'total_tokens': 3825}
