          register: snapshot_restore_cmd
          changed_when: snapshot_restore_cmd.stdout_lines[0] == "Recovered 1444 entries in 184.796µs (56.64 MB/s)"
          until: snapshot_restore_cmd is succeeded
      when: do_etcd_restore is defined
