---
- name: Restart RKE2 service
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  delegate_to: "{{ item }}"
  loop: "{{ query('inventory_hostnames', rke2_servers_group_name) }}"
  when: active_server is not defined

- name: Restart RKE2 service
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  delegate_to: "{{ active_server }}"
  loop: "{{ query('inventory_hostnames', rke2_servers_group_name) }}"
  when: active_server is defined

- name: Wait for all nodes to be ready again
  ansible.builtin.command: >
    kubectl get nodes
    --kubeconfig /etc/kubernetes/admin.conf
    --request-timeout=30s
    --output=jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}'
  register: result
  until:
    - result.stdout_lines | select('match', 'Ready') | list | count == result.stdout_lines | count
    - result.stdout_lines | count == query('inventory_hostnames', rke2_servers_group_name) | count
  retries: 100
  delay: 15
  delegate_to: "{{ item }}"
  loop: "{{ query('inventory_hostnames', rke2_servers_group_name) }}"
  changed_when: false
  check_mode: true

- name: Wait for all pods to be ready again
  ansible.builtin.command: >
    kubectl get pods
    --all-namespaces
    --kubeconfig /etc/kubernetes/admin.conf
    --request-timeout=30s
    --output=jsonpath='{range .items[*]}{.metadata.namespace}{"/"}{.metadata.name}{"\t"}{.status.phase}{"\n"}{end}'
  register: result
  until:
    - result.stdout_lines | select('match', 'Running') | list | count + result.stdout_lines | select('match', 'Succeeded') | list | count == result.stdout_lines | count
  retries: 100
  delay: 15
  delegate_to: "{{ item }}"
  loop: "{{ query('inventory_hostnames', rke2_servers_group_name) }}"
  changed_when: false
  check_mode: "{{ rke2_wait_for_all_pods_to_be_ready }}"


