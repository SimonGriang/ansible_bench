content='---\n- name: Configure virtual hosts\n  hosts: all\n  tasks:\n    - name: Ensure document root directories are created for each virtual host\n      file:\n        path: "{{ item.documentroot }}"\n        state: directory\n        owner: "{{ item.owner | default(omit) }}"\n        group: "{{ item.group | default(omit) }}"\n        mode: 0755\n      loop: "{{ httpd_vhosts }}"\n      when: item.documentroot is defined and (item.create_docroot is undefined or item.create_docroot)\n\n    - name: Create virtual host configuration files\n      template:\n        src: "{{ vhost_conf_template }}"\n        dest: "{{ httpd_vhosts_directory }}{{ item.servername }}.conf"\n        owner: root\n        group: root\n        mode: 0644\n      loop: "{{ httpd_vhosts }}"\n      notify:\n        - test Apache configuration\n        - restart Apache\n\n    - name: Enable virtual hosts on Debian-based systems\n      command: a2ensite {{ item.servername }}.conf\n      args:\n        creates: /etc/apache2/sites-enabled/{{ item.servername }}.conf\n      loop: "{{ httpd_vhosts }}"\n      when: ansible_os_family == \'Debian\'\n      notify:\n        - test Apache configuration\n        - restart Apache' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-18T17:34:18.205462967Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6692166739, 'load_duration': 39016694, 'prompt_eval_count': 525, 'prompt_eval_duration': 485585656, 'eval_count': 284, 'eval_duration': 6166519032, 'model_name': 'granite-code:20b'} id='run--85b1dba3-af19-4fa5-8256-0676e93dc70d-0' usage_metadata={'input_tokens': 525, 'output_tokens': 284, 'total_tokens': 809}
