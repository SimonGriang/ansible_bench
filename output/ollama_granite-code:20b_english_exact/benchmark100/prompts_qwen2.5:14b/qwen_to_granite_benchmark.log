---

- import_tasks: assert.yml

- name: Wait for port to be available
  wait_for:
    port: "{{ item }}"
    timeout: "{{ bootstrap_timeout }}"
  loop: "{{ query('extract', hostvars[inventory_hostname], 'ansible_port') }}"

- name: Prepare system
  raw: test -e /usr/bin/python || (apt -qqy update && apt install -qqy python sudo)
  register: result
  changed_when: result.stdout_lines | length > 0
  failed_when: (result.stdout_lines | length > 1) or
               (result.stdout_lines[0] != "stdin: is not a tty")

- name: Gather ansible facts
  setup: filter=ansible_local
  delegate_to: localhost
  run_once: true

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: true
  become: true


