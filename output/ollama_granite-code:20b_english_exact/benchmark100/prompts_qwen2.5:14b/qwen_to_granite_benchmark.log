---
- name: cadvisor | create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: "0755"
  loop:
    - "/opt/cadvisor"
    - "/etc/systemd/system"

- name: cadvisor | download
  get_url:
    url: "https://github.com/google/cadvisor/releases/download/v0.37.0/cadvisor"
    dest: "/opt/cadvisor/cadvisor"
    owner: root
    group: root
    mode: "0755"
    checksum: "sha256:{{cadvisor_sha256sum}}"
  when: not cadvisor_local_dir

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: "{{cadvisor_local_dir}}/"
    dest: "/opt/cadvisor"
    owner: root
    group: root
    mode: "0755"
  notify: "cadvisor | restart server systemd"
  when: cadvisor_local_dir

- name: cadvisor | symlink
  file:
    src: "/opt/cadvisor/cadvisor"
    dest: "/usr/local/bin/cadvisor"
    owner: root
    group: root
    state: link

- name: cadvisor | server systemd service
  template:
    src: "cadvisor.service.j2"
    dest: "/etc/systemd/system/cadvisor.service"
    owner: root
    group: root
    mode: "0644"
  notify: "cadvisor | restart server systemd"

- name: test_task
  service:
    name: "cadvisor"
    state: started
  register: service_active

- name: debug | var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemd:
    name: "cadvisor"
    enabled: true

- name: cadvisor | start server systemd
  systemd:
    name: "cadvisor"
    state: started
    daemon_reload: true


