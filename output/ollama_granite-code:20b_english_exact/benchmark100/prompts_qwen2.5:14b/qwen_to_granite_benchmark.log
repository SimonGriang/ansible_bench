---

- name: Keepalived configuration
  hosts: all
  tasks:
    - name: Update apt cache
      apt:
        update_cache: yes
    - name: Update dnf cache
      dnf:
        update_cache: yes
    - name: Install packages
      package:
        name: keepalived
        state: present
    - name: Create directory for keepalived
      file:
        path: /etc/keepalived
        state: directory
        mode: '0755'
    - name: Create Kubernetes API health check script for Debian OS family
      copy:
        dest: /etc/keepalived/k8s_api_check.sh
        content: |
          #! /bin/bash
          curl -k -s https://localhost:6443/livez/ping
        mode: '0755'
      notify: restart keepalived
    - name: Create Kubernetes API health check script for RedHat OS famliy
      copy:
        dest: /etc/keepalived/k8s_api_check.sh
        content: |
          #! /bin/bash
          curl -k -s https://localhost:6443/livez/ping
        mode: '0755'
      notify: restart keepalived
    - name: Create RKE2 Server health check script for Debian OS family
      copy:
        dest: /etc/keepalived/rke2_server_check.sh
        content: |
          #! /bin/bash
          curl -k -s https://localhost:9345/livez/ping
        mode: '0755'
      notify: restart keepalived
    - name: Create RKE2 Server health check script for RedHat OS family
      copy:
        dest: /etc/keepalived/rke2_server_check.sh
        content: |
          #! /bin/bash
          curl -k -s https://localhost:9345/livez/ping
        mode: '0755'
      notify: restart keepalived
    - name: Create keepalived config file
      template:
        src: keepalived.conf.j2
        dest: /etc/keepalived/keepalived.conf
      notify: restart keepalived
    - name: Enable keepalived and make sure it is not masked
      systemd:
        name: keepalived
        state: started
        enabled: yes
        masked: no
      notify: restart keepalived
  handlers:
    - name: restart keepalived
      service:
        name: keepalived
        state: restarted

- name: Flush handlers
  meta: flush_handlers


