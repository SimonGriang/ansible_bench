---
- import_tasks: assert.yml
- name: Manage automatic service management
  ansible.builtin.service:
    name: "{{ item }}"
    enabled: "{{ apt_autostart_state }}"
  loop: "{{ apt_service_list }}"
  when: ansible_os_family == "Debian"
- name: Disable automatic service management on installation
  ansible.builtin.copy:
    content: exit 101
    dest: /usr/sbin/policy-rc.d
    mode: "0755"
  when: ansible_os_family == "Debian" and apt_autostart_state == "disabled"
- name: Enable automatic service management on installation
  ansible.builtin.file:
    path: /usr/sbin/policy-rc.d
    state: absent
  when: ansible_os_family == "Debian" and apt_autostart_state == "enabled"


