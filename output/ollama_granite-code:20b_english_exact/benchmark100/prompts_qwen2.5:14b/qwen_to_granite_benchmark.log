  ansible.builtin.template:
    src: "{{ logrotate_config_file }}.j2"
    dest: "{{ logrotate_config_directory }}"
  when: logrotate_config_template is defined
- name: Generate logrotate.d files
  ansible.builtin.template:
    src: "{{ item.name }}.j2"
    dest: "{{ logrotate_config_directory }}/{{ item.name }}"
  loop: "{{ logrotate_entries }}"
  when: item.state is not defined or item.state != "absent"
- name: Remove logrotate.d files
  ansible.builtin.file:
