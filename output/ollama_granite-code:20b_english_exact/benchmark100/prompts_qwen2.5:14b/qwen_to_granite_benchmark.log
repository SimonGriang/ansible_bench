content='---\n- name: Check if Helm binary exists\n  ansible.builtin.stat:\n    path: /tmp/helm\n  register: helm_binary\n\n- name: Download helm\n  ansible.builtin.get_url:\n    url: https://get.helm.sh/helm-v3.5.0-linux-amd64.tar.gz\n    dest: /tmp/helm.tar.gz\n  when: not helm_binary.stat.exists\n\n- name: Unpack helm\n  ansible.builtin.unarchive:\n    src: /tmp/helm.tar.gz\n    dest: /tmp\n    remote_src: true\n  when: not helm_binary.stat.exists\n\n- name: Copy helm binary into place\n  ansible.builtin.copy:\n    src: /tmp/linux-amd64/helm\n    dest: /usr/local/bin/helm\n    mode: "0755"\n    remote_src: true\n  when: not helm_binary.stat.exists' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-08T13:49:00.087868372Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5606670761, 'load_duration': 33008710, 'prompt_eval_count': 1546, 'prompt_eval_duration': 928428478, 'eval_count': 214, 'eval_duration': 4643739442, 'model_name': 'granite-code:20b'} id='run--2ff0d020-7046-4b60-9986-92f3835f5a03-0' usage_metadata={'input_tokens': 1546, 'output_tokens': 214, 'total_tokens': 1760} 30%|███       | 30/100 [27:45<58:36, 50.24s/it]
