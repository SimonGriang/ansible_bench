    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    line: "{{ item.option }} = {{ item.value }}"
    regexp: "^{{ item.option }}"
    state: present
  loop: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  ansible.builtin.lineinfile:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    line: "socket = {{ mysql_socket }}"
    regexp: "^socket"
    state: present

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/mysql

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_daemon }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
  notify: Flush handlers again

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    encoding: "{{ item.encoding | default(omit) }}"
    collate: "{{ item.collate | default(omit) }}"
  loop: "{{ mysql_databases }}"
  register: mysql_created_databases
  changed_when: mysql_created_databases.changed

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    state: present
    host: "{{ item.host | default(omit) }}"
    check_implicit_admin: true
    priv: "{{ item.priv | default(omit) }}"
  loop: "{{ mysql_users }}"
  register: mysql_created_users
  changed_when: mysql_created_users.changed

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


