---
- import_tasks: assert.yml
- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present
- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_dir_mode }}"
  loop:
    - "{{ dns_data_dir }}"
    - "{{ dns_config_dir }}"
    - "{{ dns_override_dir }}"
- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present
- name: Create user
  user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    home: "{{ dns_data_dir }}"
    shell: "{{ dns_shell }}"
    state: present
- name: Generate rndc key
  shell: rndc-confgen -a -c {{ dns_config_dir }}/rndc.conf -k {{ dns_key_file }} -r {{ dns_key_name }}
- name: Set permissions on rndc key file
  file:
    path: "{{ dns_key_file }}"
    mode: "{{ dns_key_mode }}"
    owner: root
    group: root
- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_ hints }}"
    dest: "{{ dns_data_dir }}/root.hints"
- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_data_dir }}/{{ item.name }}.{{ dns_zone_ext }}"
    owner: root
    group: "{{ dns_group }}"
    mode: "{{ dns_file_mode }}"
  loop: "{{ dns_zones }}"
- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_config_dir }}/named.conf"
    owner: root
    group: "{{ dns_group }}"
    mode: "{{ dns_file_mode }}"
- name: Place systemd override
  copy:
    src: override.conf
    dest: "{{ dns_override_dir }}/override.conf"
    owner: root
    group: root
    mode: "{{ dns_file_mode }}"
- name: Start and enable dns
  systemd:
    name: named
    state: started
    enabled: yes



