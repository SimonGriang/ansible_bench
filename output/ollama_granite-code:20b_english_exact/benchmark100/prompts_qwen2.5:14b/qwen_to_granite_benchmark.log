---
- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_binary

- name: Check Helm version
  command: "{{ helm_bin_path }} version --client"
  register: helm_version
  when: helm_binary.stat.exists

- name: Download helm
  get_url:
    url: "{{ helm_repository_url }}/helm-v{{ helm_version_target }}-linux-amd64.tar.gz"
    dest: "{{ helm_download_path }}"
  when: not helm_binary.stat.exists or helm_version.stdout is version(helm_version_target, '<')

- name: Copy helm binary into place
  copy:
    src: "{{ helm_download_path }}/linux-amd64/helm"
    dest: "{{ helm_bin_path }}"
    mode: 0755
  when: not helm_binary.stat.exists or helm_version.stdout is version(helm_version_target, '<')



