---
- name: HTTPD configuration
  hosts: all
  tasks:
    - name: Create directories for HTTPD
      file:
        path: "{{ item.path }}"
        state: directory
        mode: "0755"
      loop: "{{ httpd_directories }}"

    - name: Configure HTTPD directories
      template:
        src: directory.conf.j2
        dest: "{{ httpd_config_directory }}/{{ item.name }}.conf"
        mode: "0644"
      loop: "{{ httpd_directories }}"
      notify:
        - Test httpd configuration validity
        - Restart httpd

handlers:
  - name: Test httpd configuration validity
    command: httpd -t
    when: httpd_test_configuration
    changed_when: false

  - name: Restart httpd
    service:
      name: httpd
      state: restarted
      enabled: true


