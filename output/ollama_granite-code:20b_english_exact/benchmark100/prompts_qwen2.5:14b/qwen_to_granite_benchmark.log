---
- name: Check if python is installed
  command: python --version
  changed_when: false

- name: Check if python3 is installed
  command: python3 --version
  changed_when: false

- name: Debug Python executable path
  debug:
    msg: "Python executable found at {{ ansible_python.executable }}"
  when: ansible_python.executable is defined

- name: Debug Python3 executable path
  debug:
    msg: "Python3 executable found at {{ ansible_python3.executable }}"
  when: ansible_python3.executable is defined

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install requirements
  dnf:
    name: "{{ openssl_requirements }}"
    state: present

- name: Ensure packaging is available via dnf
  dnf:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    name: "{{ openssl_pip_packages }}"
    state: present

- name: Create key directory
  file:
    path: "{{ openssl_key_dir }}"
    state: directory
    mode: "{{ openssl_dir_mode }}"
    owner: "{{ openssl_root_owner }}"
    group: "{{ openssl_root_owner }}"

- name: Create csr directory
  file:
    path: "{{ openssl_csr_dir }}"
    state: directory
    mode: "{{ openssl_dir_mode }}"
    owner: "{{ openssl_root_owner }}"
    group: "{{ openssl_root_owner }}"

- name: Create crt directory
  file:
    path: "{{ openssl_crt_dir }}"
    state: directory
    mode: "{{ openssl_dir_mode }}"
    owner: "{{ openssl_root_owner }}"
    group: "{{ openssl_root_owner }}"

- name: Include create.yml
  include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item


