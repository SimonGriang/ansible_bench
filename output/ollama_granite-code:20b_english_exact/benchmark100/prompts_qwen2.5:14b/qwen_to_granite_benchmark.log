---
- name: Import assert.yml
  import_tasks: assert.yml
  tags:
    - always

- name: Install using package
  package:
    name: "{{ hashicorp_products }}"
    state: present
  when: hashicorp_use_package
  tags:
    - hashicorp

- name: Install repository for RedHat
  command: dnf config-manager --set-enabled {{ hashicorp_repo_name }}
  args:
    warn: false
  register: hashicorp_dnf_config_manager
  changed_when: hashicorp_dnf_config_manager.stdout is search("Overall completion status")
  when:
    - hashicorp_use_dnf
    - ansible_os_family == "RedHat"
  tags:
    - hashicorp

- name: Configure debian
  set_fact:
    hashicorp_apt_repository: "deb {{ hashicorp_apt_url }} {{ ansible_distribution_release }} main"
  when: ansible_os_family == "Debian"
  tags:
    - hashicorp

- name: Install required package gpg
  package:
    name: gpg
    state: present
  when:
    - hashicorp_apt_key_id is defined
    - hashicorp_apt_key_id != ""
    - ansible_os_family == "Debian"
  tags:
    - hashicorp

- name: Install apt key for Debian
  apt_key:
    url: "{{ hashicorp_apt_key_url }}"
    id: "{{ hashicorp_apt_key_id }}"
    state: present
  when:
    - hashicorp_apt_key_id is defined
    - hashicorp_apt_key_id != ""
    - ansible_os_family == "Debian"
  tags:
    - hashicorp

- name: Install repository for Debian
  apt_repository:
    repo: "{{ hashicorp_apt_repository }}"
    state: present
    filename: hashicorp
  when:
    - hashicorp_apt_key_id is defined
    - hashicorp_apt_key_id != ""
    - ansible_os_family == "Debian"
  tags:
    - hashicorp

- name: Install hashicorp product using package
  package:
    name: "{{ hashicorp_products }}"
    state: present
  when:
    - hashicorp_product_version is not defined
    - hashicorp_product_version == ""
    - hashicorp_use_package
  tags:
    - hashicorp

- name: Install versioned hashicorp product using package
  package:
    name: "{{ hashicorp_products }}={{ hashicorp_product_version }}"
    state: present
  when:
    - hashicorp_product_version is defined
    - hashicorp_product_version != ""
    - hashicorp_use_package
  tags:
    - hashicorp

- name: Install manually
  unarchive:
    src: "{{ hashicorp_product_url }}"
    dest: "{{ hashicorp_product_install_dest }}"
    owner: root
    group: root
    mode: "u=rwX,g=rX,o=rX"
    remote_src: true
  when: hashicorp_use_manual_install
  tags:
    - hashicorp

- name: Install hashicorp product manually
  unarchive:
    src: "{{ hashicorp_product_url }}"
    dest: "{{ hashicorp_product_install_dest }}"
    owner: root
    group: root
    mode: "u=rwX,g=rX,o=rX"
    remote_src: true
  when:
    - hashicorp_product_version is not defined
    - hashicorp_product_version == ""
    - hashicorp_use_manual_install
  tags:
    - hashicorp


