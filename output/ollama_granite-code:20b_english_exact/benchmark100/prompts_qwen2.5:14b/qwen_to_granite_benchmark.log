---
- name: Task 1 - Ensure document root directories are created for each virtual host
  file:
    path: "{{ item.docroot | default(omit) }}"
    state: directory
    mode: 0755
  loop: "{{ httpd_vhosts }}"
  when: item.create_docroot | default(True)

- name: Task 2 - Create virtual host configuration files
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.servername | regex_replace('[:.]', '_') }}.conf"
    mode: 0644
  loop: "{{ httpd_vhosts }}"
  notify: Test Apache configuration and restart Apache

- name: Task 3 - Enable virtual hosts on Debian-based systems
  command: a2ensite {{ item.servername | regex_replace('[:.]', '_') }}.conf
  args:
    creates: /etc/apache2/sites-enabled/{{ item.servername | regex_replace('[:.]', '_') }}.conf
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian'
  notify: Test Apache configuration and restart Apache


