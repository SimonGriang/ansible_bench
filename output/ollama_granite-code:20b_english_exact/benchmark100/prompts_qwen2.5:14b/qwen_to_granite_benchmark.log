content='---\n- name: Create the RKE2 config directory\n  file:\n    path: /etc/rancher/rke2\n    state: directory\n\n- name: Set server taints\n  set_fact:\n    combined_node_taints: "{{ rke2_server_node_taints }}"\n  when: rke2_server_type == "server"\n\n- name: Copy RKE2 configuration file\n  template:\n    src: rke2-config.yaml.j2\n    dest: /etc/rancher/rke2/config.yaml\n  notify: Config file changed\n\n- name: Copy kubelet configuration file\n  template:\n    src: kubelet-config.yaml.j2\n    dest: /etc/rancher/rke2/kubelet-config.yaml\n  vars:\n    kubelet_config: "{{ rke2_kubelet_config }}"\n  notify: Config file changed\n  when: kubelet_config|length > 0\n\n- name: Copy Containerd Registry Configuration file\n  template:\n    src: registries.yaml.j2\n    dest: /etc/rancher/rke2/registries.yaml\n  vars:\n    custom_registry_mirrors: "{{ rke2_custom_registry_mirrors }}"\n    custom_registry_configs: "{{ rke2_custom_registry_configs }}"\n  notify: Config file changed\n  when: custom_registry_mirrors|length > 0 or custom_registry_configs|length > 0\n\n- name: Register if we need to do a etcd restore from file\n  set_fact:\n    do_etcd_restore: true\n  when: rke2_etcd_snapshot_file|length > 0 and rke2_server_type == "server" and rke2_service_enabled.stdout != "enabled"\n\n- name: Register if we need to do a etcd restore from s3\n  set_fact:\n    do_etcd_restore_from_s3: true\n  when: rke2_etcd_snapshot_file|length > 0 and rke2_server_type == "server" and rke2_service_enabled.stdout != "enabled" and rke2_etcd_snapshot_s3_options.access_key|length > 0 and rke2_etcd_snapshot_s3_options.secret_key|length > 0 and rke2_etcd_snapshot_s3_options.bucket|length > 0 and rke2_etcd_snapshot_s3_options.snapshot_name|length > 0\n\n- name: Restore etcd from file\n  block:\n  - name: Create RKE2 etcd snapshot directory\n    file:\n      path: "{{ rke2_data_dir }}/etcd-snapshots"\n      state: directory\n      owner: root\n      group: root\n      mode: 0755\n\n  - name: Copy etcd snapshot file\n    copy:\n      src: "{{ rke2_etcd_snapshot_file }}"\n      dest: "{{ rke2_data_dir }}/etcd-snapshots/"\n      owner: root\n      group: root\n      mode: 0644\n\n  - name: Restore etcd from snapshot file\n    command: "rke2 etcd snapshot restore {{ rke2_etcd_snapshot_file | basename }}"\n    environment:\n      ETCDCTL_ENDPOINTS: "https://127.0.0.1:2379"\n      ETCDCTL_CERT_FILE: "/etc/ssl/certs/etcd/client.crt"\n      ETCDCTL_KEY_FILE: "/etc/ssl/certs/etcd/client.key"\n      ETCDCTL_CA_FILE: "/etc/ssl/certs/etcd/ca.crt"\n  when: do_etcd_restore is defined\n\n- name: Restore etcd from s3\n  block:\n  - name: Restore etcd from S3 snapshot\n    shell: |\n      export AWS_ACCESS_KEY_ID="{{ rke2_etcd_snapshot_s3_options.access_key }}"\n      export AWS_SECRET_ACCESS_KEY="{{ rke2_etcd_snapshot_s3_options.secret_key }}"\n      rke2 etcd snapshot restore s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }}\n    environment:\n      ETCDCTL_ENDPOINTS: "https://127.0.0.1:2379"\n      ETCDCTL_CERT_FILE: "/etc/ssl/certs/etcd/client.crt"\n      ETCDCTL_KEY_FILE: "/etc/ssl/certs/etcd/client.key"\n      ETCDCTL_CA_FILE: "/etc/ssl/certs/etcd/ca.crt"\n  when: do_etcd_restore_from_s3 is defined\n\n- name: Start RKE2 service on the first server\n  block:\n  - name: Start and enable rke2-server service\n    service:\n      name: rke2-server\n      state: started\n      enabled: true\n    environment:\n      RKE2_TOKEN: "{{ rke2_token }}"\n  - name: Mask rke2-agent service\n    service:\n      name: rke2-agent\n      enabled: false\n      masked: true\n  when: rke2_server_type == "server"\n\n- name: Wait for the first server be ready - no CNI\n  when: rke2_server_type == "server"\n  wait_for:\n    host: "{{ inventory_hostname }}"\n    port: 6443\n    connect_timeout: 5\n    state: started\n    timeout: 600\n\n- name: Wait for the first server be ready - with CNI\n  when: rke2_server_type == "server" and cni_plugin_mode == "cni"\n  wait_for:\n    host: "{{ inventory_hostname }}"\n    port: 6443\n    connect_timeout: 5\n    state: started\n    timeout: 1200\n\n- name: Restore etcd\n  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined\n  block:\n  - name: Get registered nodes\n    uri:\n      url: https://127.0.0.1:9345/rke2/api/management/v3/nodes\n      method: GET\n      validate_certs: no\n      url_password: "{{ rke2_token }}"\n      url_user: "admin"\n      return_content: yes\n    register: rke2_registered_nodes\n\n  - name: Remove old node secrets\n    with_items: "{{ rke2_registered_nodes.json.data }}"\n    loop_control:\n      loop_var: remove_node\n    no_log: yes\n    shell: |\n      export ETCDCTL_ENDPOINTS="https://127.0.0.1:2379"\n      export ETCDCTL_CERT_FILE="/etc/ssl/certs/etcd/client.crt"\n      export ETCDCTL_KEY_FILE="/etc/ssl/certs/etcd/client.key"\n      export ETCDCTL_CA_FILE="/etc/ssl/certs/etcd/ca.crt"\n      export ETCDCTL_API=3\n      etcdctl user remove {{ remove_node.name }} || true\n      etcdctl role revoke-permission {{ remove_node.name }} --prefix=true || true\n      etcdctl role delete {{ remove_node.name }} || true\n      etcdctl rm {{ remove_node.controlPlaneEndpoint.address }} || true\n\n  - name: Remove old nodes\n    with_items: "{{ rke2_registered_nodes.json.data }}"\n    loop_control:\n      loop_var: remove_node\n    no_log: yes\n    shell: |\n      export ETCDCTL_ENDPOINTS="https://127.0.0.1:2379"\n      export ETCDCTL_CERT_FILE="/etc/ssl/certs/etcd/client.crt"\n      export ETCDCTL_KEY_FILE="/etc/ssl/certs/etcd/client.key"\n      export ETCDCTL_CA_FILE="/etc/ssl/certs/etcd/ca.crt"\n      export ETCDCTL_API=3\n      etcdctl del /nodes/{{ remove_node.name }} || true\n\n- name: Set an Active Server variable\n  when: rke2_server_type == "server"\n  set_fact:\n    active_server: "{{ inventory_hostname }}"' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-08T14:38:59.341536079Z', 'done':