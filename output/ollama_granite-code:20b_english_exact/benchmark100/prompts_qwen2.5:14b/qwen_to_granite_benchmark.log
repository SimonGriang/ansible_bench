        dest: /var/lib/rke2/agent/artifacts/rke2-install.sh
        mode: "0640"
        force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation == "download" and not download_checksum.changed and not download_artifacts.changed and not download_install_script.changed

