- import_tasks: assert.yml
  delegate_to: localhost

- name: Install docker-compose as a binary
  block:
    - name: Install required packages
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ docker_compose_binary_install_packages }}"
    - name: Download binary
      get_url:
        url: "{{ docker_compose_binary_url }}"
        dest: /usr/local/bin/docker-compose
        mode: "0755"
  when: docker_compose_install_type == "binary"

- name: Install docker-compose package
  package:
    name: docker-compose
    state: present
  when: docker_compose_install_type == "package"


