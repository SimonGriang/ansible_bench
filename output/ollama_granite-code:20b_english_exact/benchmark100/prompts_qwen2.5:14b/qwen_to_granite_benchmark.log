- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
    sleep: 10
    sleep_timeout: 5
    timeout: 60

- name: Wait for all nodes to be ready again
  command: "kubectl get nodes --request-timeout=3s -o json"
  register: result
  until: result.stdout | from_json | json_query('items[*].status.conditions[?type==`Ready`].status') | unique | sort | last == 'True'
  retries: 100
  delay: 15
  delegate_to: "{{ active_server if active_server is defined else omit }}"
  run_once: true
  check_mode: true
  changed_when: false

- name: Wait for all pods to be ready again
  command: "kubectl get pods --all-namespaces --request-timeout=3s -o json"
  register: result
  until: result.stdout | from_json | json_query('items[*].status.phase') | unique | sort | last in ['Running', 'Succeeded']
  retries: 100
  delay: 15
  delegate_to: "{{ active_server if active_server is defined else omit }}"
  run_once: true
  check_mode: "{{ rke2_wait_for_all_pods_to_be_ready | default(false) }}"
  changed_when: false


