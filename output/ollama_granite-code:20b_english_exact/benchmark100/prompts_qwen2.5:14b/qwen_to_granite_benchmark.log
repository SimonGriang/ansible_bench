---

- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present
  notify: Test and restart apache

- block:

  - name: Set selinux booleans
    seboolean:
      name: "{{ item }}"
      state: yes
      persistent: yes
    loop: "{{ setype_booleans }}"

  - name: Set selinux ports
    seport:
      ports: "{{ item }}"
      proto: tcp
      setype: http_port_t
      state: present
    loop: "{{ httpd_seport_http | union(httpd_seport_https) }}"
    when:
      - selinux_is_enabled | bool

  when:
    - httpd_can_selinux | bool

- name: Template main httpd configuration file
  template:
    src: "httpd.conf.j2"
    dest: "{{ httpd_conf_file }}"
    owner: root
    group: root
    mode: 0644
  notify: Test and restart apache

- name: Activate httpd module | Debian
  command: "a2enmod {{ item }}"
  notify: Test and restart apache
  with_items: "{{ httpd_modules }}"
  when:
    - httpd_modules is defined
    - httpd_is_debian | bool

- import_tasks: ssl.yml
  when:
    - https_ssl_enabled | bool

- import_tasks: locations.yml
  when:
    - httpd_locations is defined

- import_tasks: vhosts.yml
  when:
    - httpd_vhosts is defined

- name: Template ports configuration file
  template:
    src: "ports.conf.j2"
    dest: "/etc/services"
    owner: root
    group: root
    mode: 0644
  notify: Test and restart apache
  when:
    - httpd_is_debian | bool
    - httpd_is_suse | bool

- import_tasks: directories.yml
  when:
    - httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_docroot }}/index.html"
    state: absent
  when:
    - httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


