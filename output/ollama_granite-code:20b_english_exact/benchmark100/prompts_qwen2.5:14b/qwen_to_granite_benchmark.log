---
- name: bootstrap
  tasks:
    - name: Lookup bootstrap facts
      gather_facts:
        gather_subset: all
        no_log: True
    - name: Set bootstrap facts (I)
      set_fact:
        distribution_name: "{{ ansible_facts['os_family'] | lower }}"
        distribution_major_version: "{{ item.regex }}"
      loop: "{{ bootstrap_os_family_map }}"
      when: "(ansible_facts['distribution'] | lower) is match(item.regex)"
    - name: Set bootstrap facts (II)
      set_fact:
        distribution_name: "{{ item.key | lower }}"
      loop: "{{ bootstrap_os_family_map }}"
      when: >
        (ansible_facts['distribution'] | lower) is match(item.value.regex) and
        (ansible_facts['distribution_release'] | lower) is match(item.value.regex_version)
    - name: Set bootstrap facts (III)
      set_fact:
        os_family: "{{ item.value.family | lower }}"
      loop: "{{ bootstrap_os_family_map }}"
      when: >
        (ansible_facts['distribution'] | lower) is match(item.value.regex) and
        (ansible_facts['distribution_release'] | lower) is match(item.value.regex_version)


