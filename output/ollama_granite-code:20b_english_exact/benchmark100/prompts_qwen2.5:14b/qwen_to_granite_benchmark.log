---
- name: Check python3.11 EXTERNALLY-MANAGED file
  stat:
    path: /usr/src/python3.11/EXTERNALLY-MANAGED
  register: python311_externally_managed_stat

- name: Rename python3.11 EXTERNALLY-MANAGED file
  when: python311_externally_managed_stat.stat.exists
  command: mv /usr/src/python3.11/EXTERNALLY-MANAGED /usr/src/python3.11/EXTERNALLY-MANAGED.old

- name: Check python3.12 EXTERNALLY-MANAGED file
  stat:
    path: /usr/src/python3.12/EXTERNALLY-MANAGED
  register: python312_externally_managed_stat

- name: Rename python3.12 EXTERNALLY-MANAGED file
  when: python312_externally_managed_stat.stat.exists
  command: mv /usr/src/python3.12/EXTERNALLY-MANAGED /usr/src/python3.12/EXTERNALLY-MANAGED.old

- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true

- name: Install python pip
  when: python_pip_packages is defined
  pip:
    name: "{{ python_pip_packages }}"
    executable: pip3
    extra_args: '--ignore-installed --upgrade'

- name: Configure pip proxy
  when: python_pip_proxy is defined
  ini_file:
    path: /etc/pip.conf
    section: global
    option: proxy
    value: "{{ python_pip_proxy }}"
    mode: 0644
    no_extra_spaces: true
    create: true

- name: Trust hosts
  when: python_pip_trusted_host is defined
  ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ python_pip_trusted_host }}"
    mode: 0644
    no_extra_spaces: true
    create: true

- name: Update pip
  when: python_pip_update | default(false) | bool and ansible_distribution != 'bookworm' and ansible_distribution != 'noble' and ansible_os_family != 'Alpine'
  pip:
    name: pip
    executable: pip3
    extra_args: '--upgrade --no-cache-dir --no-warn-script-location'

- name: Install requested modules
  when: python_pip_modules is defined and ansible_distribution != 'bookworm' and ansible_distribution != 'noble' and ansible_os_family != 'Alpine'
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default(omit) }}"
    executable: pip3
  loop: "{{ python_pip_modules }}"


