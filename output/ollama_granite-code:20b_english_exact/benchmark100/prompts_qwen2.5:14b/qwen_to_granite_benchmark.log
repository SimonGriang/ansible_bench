---
- import_tasks: assert.yml
- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present
- name: Configure shell
  lineinfile:
    dest: /etc/cron.conf
    regexp: '^#?SHELL='
    line: 'SHELL={{ cron_shell }}'
    state: present
    mode: 0644
  notify: restart cron
- name: Configure path
  lineinfile:
    dest: /etc/cron.conf
    regexp: '^#?PATH='
    line: 'PATH={{ cron_path }}'
    state: present
    mode: 0644
  notify: restart cron
- name: Configure mailto
  lineinfile:
    dest: /etc/cron.conf
    regexp: '^#?MAILTO='
    line: 'MAILTO={{ cron_mailto }}'
    state: present
    mode: 0644
  notify: restart cron
- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service
- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    special_time: "{{ item.special_time | default(omit) }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs }}"


