---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ item.port }}"
    timeout: "{{ bootstrap_timeout }}"
    connect_timeout: "{{ bootstrap_timeout }}"
    state: started
  when: item.wait
  with_items: "{{ query('extract', hostvars[inventory_hostname], ['wait_for', 'port']) }}"

- name: Prepare system
  raw: >
    (sleep 2 && whoami) | grep root || (sleep 2 && whoami) | grep root || (sleep 10 && whoami) | grep root || exit 1
    && sleep 5
    && [[ -z $(getent group adm) ]] && exit 1
    && [[ -z $(getent group sudo) ]] && exit 1
  changed_when: false
  when: hostvars[inventory_hostname].ansible_connection != "container"

- name: Gather bootstrap facts
  setup:
    gather_subset: all
  when: hostvars[inventory_hostname].ansible_connection != "container" and hostvars[inventory_hostname].ansible_virtualization_type != "docker"

- name: Install bootstrap packages (raw)
  raw: "yum install -y {{ item.name }}"
  changed_when: false
  register: result
  until: result is succeeded
  retries: 5
  delay: 2
  with_items:
    - "{{ query('extract', hostvars[inventory_hostname], ['yum', 'name']) }}"
  when:
    - hostvars[inventory_hostname].ansible_os_family == "RedHat"
    - hostvars[inventory_hostname].yum.changed

- name: Ensure libdnf5 is present on Fedora/RedHat
  package:
    name: libdnf5
    state: present
  when: hostvars[inventory_hostname].ansible_distribution == "Fedora" or hostvars[inventory_hostname].ansible_os_family == "RedHat"

- name: Gather ansible facts
  setup:
    gather_subset: all

- name: Install bootstrap packages (package)
  package:
    name: "{{ item.name }}"
    state: present
    update_cache: "{{ item.update_cache | default(omit) }}"
  when: item.install
  with_items:
    - "{{ query('extract', hostvars[inventory_hostname], ['package', 'name']) }}"


