- name: "CIS - 2.2.1 - 2.2.4 - 2.2.5 - 2.2.6 - 2.2.7 - 2.2.8"
  hosts: all
  become: true
  tasks:
    - name: "2.2.1 - Create etcd group"
      group:
        name: etcd
        state: present

    - name: "2.2.2 - Create etcd user"
      user:
        name: etcd
        group: etcd
        comment: "etcd user"
        shell: /bin/nologin

    - name: "2.2.3 - Copy systemctl config file for kernel hardening"
      copy:
        src: "{{ item }}"
        dest: /etc/sysctl.d/60-rke2-cis.conf
        mode: "0600"
      loop:
        - /usr/local/share/rke2/rke2-cis-sysctl.conf
        - /opt/rke2/share/rke2/rke2-cis-sysctl.conf
      register: rke2_cis_2_3_copy
      notify: restart_systemd_sysctl
      when:
        - rke2_install_type == "archive"
        - rke2_partition_check_2_3 | bool

    - name: "2.2.4 - Flush handlers"
      meta: flush_handlers

    - name: "2.2.5 - Create etcd group"
      group:
