---
- name: Task 1 - Enable proxy modules in Apache
  block:
    - name: Debian | Enable proxy modules
      apt:
        name: "{{ item }}"
        state: present
      loop:
        - apache2-bin
        - libapache2-mod-proxy-html
        - libapache2-mod-proxy-http
        - libapache2-mod-proxy
      when: ansible_os_family == "Debian"
    - name: Suse | Enable proxy modules
      zypper:
        name: "{{ item }}"
        state: present
      loop:
        - apache2-proxy
        - apache2-proxy_http
      when: ansible_os_family == "Suse"
  notify: restart apache

- name: Task 2 - Configure Apache locations
  template:
    src: path/to/template/file.conf.j2
    dest: /etc/apache2/sites-available/file.conf
