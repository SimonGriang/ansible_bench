---

- import_tasks: assert.yml

- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ git_user }}"
    split: ":"

- name: Create directory for git configuration
  ansible.builtin.file:
    path: "/home/{{ git_user }}/.config/git"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when:
    - git_user in getent_passwd
    - git_user_email is defined
    - git_user_name is defined

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "/home/{{ git_user }}/.config/git/config"
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when:
    - git_user in getent_passwd
    - git_user_email is defined
    - git_user_name is defined

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ git_repositories_dest }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when:
    - git_user in getent_passwd
    - git_repositories is defined

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ item.url }}"
    dest: "{{ git_repositories_dest }}/{{ item.name }}"
    version: "{{ item.version | default(omit) }}"
    depth: "{{ item.depth | default(omit) }}"
    update: "{{ item.update | default(omit) }}"
    executable: "{{ git_executable | default(omit) }}"
    force: "{{ item.force | default(omit) }}"
    recursive: "{{ item.recursive | default(omit) }}"
    track_path: "{{ item.track_path | default(omit) }}"
    key_file: "{{ item.key_file | default(omit) }}"
    ssh_common_args: "{{ item.ssh_common_args | default(omit) }}"
    become: "{{ git_become | default(omit) }}"
    become_user: "{{ git_become_user | default(omit) }}"
    become_method: "{{ git_become_method | default(omit) }}"
  with_items: "{{ git_repositories }}"
  when:
    - git_user in getent_passwd
    - git_repositories is defined
  loop_control:
    label: "Cloning {{ item.url }}"


