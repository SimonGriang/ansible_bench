content='---\n- name: Create local ssh_key_directory for {{ user.name }}\n  file:\n    path: "~{{ user.name }}/.ssh"\n    state: directory\n    mode: 0750\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n  become: false\n  when: user.manage_ssh_key\n\n- name: Manage user {{ user.name }}\n  user:\n    name: "{{ user.name }}"\n    state: "{{ user.state }}"\n    password: "{{ user.password }}"\n    update_password: "{{ user.update_password }}"\n    append: "{{ user.append }}"\n    groups: "{{ user.groups }}"\n    remove_groups: "{{ user.remove_groups }}"\n    createhome: "{{ user.createhome }}"\n    move_home: "{{ user.move_home }}"\n    force: "{{ user.force }}"\n    password_lock: "{{ user.password_lock }}"\n    KeePassWallet: "{{ user.KeePassWallet }}"\n    KeePassDesc: "{{ user.KeePassDesc }}"\n    generate_ssh_key: "{{ user.manage_ssh_key }}"\n    ssh_key_bits: "{{ user.ssh_key_bits }}"\n    ssh_key_type: "{{ user.ssh_key_type }}"\n    ssh_key_file: ".ssh/id_rsa"\n    ssh_key_passphrase: "{{ user.ssh_key_passphrase }}"\n    ssh_key_comment: "{{ user.name }}@{{ ansible_host }}"\n\n- name: Set sudo options for {{ user.name }}\n  template:\n    src: sudoers.d.j2\n    dest: /etc/sudoers.d/{{ user.name }}\n    validate: /usr/sbin/visudo -cf %s\n    mode: 0640\n    owner: root\n    group: root\n  become: true\n  when: user.sudo\n\n- name: Remove sudo options for {{ user.name }}\n  file:\n    path: /etc/sudoers.d/{{ user.name }}\n    state: absent\n  become: true\n  when: not user.sudo\n\n- name: Generate private ssh key for {{ user.name }}\n  command: ssh-keygen -b {{ user.ssh_key_bits }} -t {{ user.ssh_key_type }} -N \'\' -f {{ user.ssh_key_file }}\n  args:\n    creates: "~{{ user.name }}/{{ user.ssh_key_file }}"\n    chdir: "~{{ user.name }}"\n  become: false\n  when: user.manage_ssh_key\n\n- name: Generate public ssh key for {{ user.name }}\n  command: ssh-keygen -y -f {{ user.ssh_key_file }}\n  args:\n    creates: "~{{ user.name }}/{{ user.ssh_key_file }}.pub"\n    chdir: "~{{ user.name }}"\n  become: false\n  when: user.manage_ssh_key\n\n- name: Convert ssh key to ppk for {{ user.name }}\n  command: puttygen {{ user.ssh_key_file }} -O private-openssh -o {{ user.ssh_key_file }}.ppk\n  args:\n    creates: "~{{ user.name }}/{{ user.ssh_key_file }}.ppk"\n    chdir: "~{{ user.name }}"\n  become: false\n  when: user.manage_ssh_key\n\n- name: Get or set the home directory for {{ user.name }}\n  command: getent passwd {{ user.name }} | cut -d: -f6\n  register: user_home\n  failed_when: user_home.stdout == \'\'\n  changed_when: false\n\n- name: Create .ssh directory for {{ user.name }}\n  file:\n    path: "{{ user_home.stdout }}/.ssh"\n    state: directory\n    mode: 0700\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n  become: true\n  when: user.manage_ssh_key or user.private_keys is defined\n\n- name: Deploy authorized keys for {{ user.name }}\n  authorized_key:\n    user: "{{ user.name }}"\n    key: "{{ item }}"\n    state: present\n  with_items: "{{ user.authorized_keys }}"\n  when: user.authorized_keys is defined\n\n- name: Remove unauthorized keys for {{ user.name }}\n  authorized_key:\n    user: "{{ user.name }}"\n    key: "{{ item }}"\n    state: absent\n  with_items: "{{ user.unauthorized_keys }}"\n  when: user.unauthorized_keys is defined\n\n- name: Copy generated private ssh key for {{ user.name }}\n  copy:\n    src: "~{{ user.name }}/{{ user.ssh_key_file }}"\n    dest: "{{ user_home.stdout }}/.ssh/{{ user.ssh_key_file }}"\n    mode: 0600\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n  become: true\n  when: user.copy_private_key\n\n- name: Check users password valid time for {{ user.name }}\n  shell: chage -l {{ user.name }} | grep ^Password | cut -d":" -f3\n  args:\n    creates: "~{{ user.name }}/{{ user.ssh_key_file }}"\n    chdir: "~{{ user.name }}"\n  register: password_valid_time\n  become: true\n  when: user.password_validity_days is defined\n\n- name: Set users password valid 