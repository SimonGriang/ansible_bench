- name: Task 1 - Enable proxy and proxy_http modules on Debian and Suse systems
  tags: task1
  block:
    - name: Install required packages
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
      with_items:
        - libapache2-mod-proxy
        - libapache2-mod-proxy-http
      when: ansible_os_family == "Debian"
    - name: Install required packages
      ansible.builtin.yum:
        name: "{{ item }}"
        state: present
      with_items:
        - mod_proxy
        - mod_proxy_http
      when: ansible_os_family == "Suse"

- name: Task 2 - Configure locations
  tags: task2
  template:
    src: location.conf.j2
    dest: /etc/httpd/conf.d/location.conf
    mode: 0644
  notify: httpd configuration test and restart


