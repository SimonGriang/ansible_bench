---
- name: Disable swap
  tags:
    - disable_swap
  block:
    - name: Disable swap temporarily
      command: swapoff -a
      when: vault_hardening_disable_swap

    - name: Disable swap permanently
      mount:
        name: swap
        state: absent
      when: vault_hardening_disable_swap

- name: Disable core dumps
  tags:
    - disable_core_dumps
  block:
    - name: Set core dump limits to 0 for all domains
      pam_limits:
        domain: "{{ item }}"
        limit_type: core
        limit_item: core
        value: 0
      loop:
        - "core"
        - "*"
      when: vault_hardening_disable_core_dumps

- name: Disable Shell Command History
  tags:
    - disable_shell_command_history
  block:
    - name: Disable shell command history
      copy:
        dest: /etc/profile.d/disable_shell_history.sh
        content: "export HISTCONTROL=ignoreboth"
        mode: 0644
      when: vault_hardening_disable_shell_command_history

- name: Configure SELinux / AppArmor
  tags:
    - configure_selinux_apparmor
  block:
    - name: Enable SELinux
      selinux:
        state: enforcing
      when: vault_hardening_configure_selinux_apparmor

    - name: Install selinux-policy
      package:
        name: selinux-policy
        state: present
      when: vault_hardening_configure_selinux_apparmor

- name: Enable AppArmor (enforcing)
  tags:
    - enable_apparmor
  block:
    - name: Enable AppArmor for vault binary
      command: aa-exec {{ ansible_procpath }}/vault -M /etc/apparmor.d/bin/vault
      when: vault_hardening_configure_selinux_apparmor


