      when: bootstrap_facts['stdout'] | length > 0

    - name: Set bootstrap facts (II)
      set_fact:
        bootstrap_os_family: "{{ bootstrap_os_family_map[bootstrap_facts['stdout'] | from_json | json_query('ID') | lower ] }}"
      when: bootstrap_facts['stdout'] | length > 0


