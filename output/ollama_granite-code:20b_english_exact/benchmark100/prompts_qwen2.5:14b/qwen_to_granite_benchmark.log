---
- import_tasks: assert.yml

- name: Task 2 - Install fail2ban
  package:
    name: "{{ fail2ban_packages }}"
    state: present
  tags:
    - packages

- name: Task 3 - Copy filters in filter.d
  copy:
    src: "{{ item }}"
    dest: /etc/fail2ban/filter.d/
    mode: 0644
  with_fileglob:
    - ../filter.d/*.conf
  notify: restart fail2ban
  tags:
    - config

- name: Task 4 - Configure fail2ban.local
  template:
    src: ../config/fail2ban.local.j2
    dest: /etc/fail2ban/fail2ban.local
    mode: 0644
  notify: restart fail2ban
  tags:
    - config

- name: Task 5 - Configure jail.local
  template:
    src: ../config/jail.local.j2
    dest: /etc/fail2ban/jail.local
    mode: 0644
  notify: restart fail2ban
  tags:
    - config

- name: Task 6 - Stat auth log file
  stat:
    path: /var/log/auth.log
  register: auth_log_stat

- name: Task 7 - Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    mode: 0644
  when: not auth_log_stat.stat.exists

- name: Task 8 - Start and enable fail2ban
  service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: yes
  tags:
    - service


