---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    home: /dev/null
    shell: "{{ vault_user_shell }}"
    groups: "{{ vault_group }}"

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Download Vault binary
  unarchive:
    src: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: true
    owner: root
  notify: Restart vault

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_stat

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: vault_path_stat.stat.exists == false and vault_path != ""

- name: Create directory in vault_path
  file:
    path: "{{ vault_path }}/{{ item.path }}"
    state: directory
    mode: 0755
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ vault_data_directory }}/{{ item.path }}"
    state: directory
    mode: 0755
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  shell: >
    openssl req -new -newkey rsa:2048 -days 1095 -nodes -x509
    -subj "/C={{ vault_country }}/ST={{ vault_state }}/L={{ vault_location }}/O={{ vault_organization }}/OU={{ vault_organizational_unit }}/CN={{ inventory_hostname }}"
    -keyout {{ vault_data_directory }}/tls/vault.key -out {{ vault_data_directory }}/tls/vault.crt &&
    chmod 0640 {{ vault_data_directory }}/tls/vault.*
  args:
    creates: "{{ vault_data_directory }}/tls/vault.crt"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ vault_data_directory }}/tls/{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  with_items: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: 0755
    owner: root
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  capabilities:
    path: /usr/bin/vault
    capability: cap_ipc_lock=ep
    state: present
  changed_when: false

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    mode: 0644
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: 0755

- name: Copy Vault service file
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: 0644
  notify: Daemon reload
  when: vault_service_manager == "systemd"

- name: Copy vault configuration
  template:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: 0644
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


