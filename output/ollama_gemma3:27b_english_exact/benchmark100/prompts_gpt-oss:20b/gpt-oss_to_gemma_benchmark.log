---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout | default(300) }}"
  when:
    - ansible_connection != 'container'
    - ansible_connection != 'docker'
    - bootstrap_wait_for_host | bool

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.ping
      timeout: "{{ bootstrap_timeout | default(300) }}"
      ignore_errors: true

    - name: Check sudo availability
      ansible.builtin.command: sudo --version
      register: sudo_check
      ignore_errors: true
      changed_when: false

    - name: Gather bootstrap facts and install packages
      block:
        - name: Include gather_facts.yml
          ansible.builtin.include_tasks: gather_facts.yml

        - name: Install bootstrap packages (raw)
          ansible.builtin.command: "{{ bootstrap_install.raw }}"
          register: bootstrap_install_packages
          changed_when: bootstrap_install_packages.rc != 0

        - name: Assert bootstrap package installation success (Alpine/Archlinux/Gentoo)
          ansible.builtin.assert:
            that:
              - bootstrap_install_packages.stdout | regex_search(bootstrap_install.stdout_regex)
            fail_msg: "Bootstrap package installation failed (Alpine/Archlinux/Gentoo)"
            success_msg: "Bootstrap package installation successful (Alpine/Archlinux/Gentoo)"
          when: ansible_os_family in ["Alpine", "Archlinux", "Gentoo"]

        - name: Assert bootstrap package installation success (Debian/RedHat/Rocky/Suse)
          ansible.builtin.assert:
            that:
              - bootstrap_install_packages.stdout | not regex_search(bootstrap_install.stdout_regex)
            fail_msg: "Bootstrap package installation failed (Debian/RedHat/Rocky/Suse)"
            success_msg: "Bootstrap package installation successful (Debian/RedHat/Rocky/Suse)"
          when: ansible_os_family in ["Debian", "RedHat", "Rocky", "Suse"]
      when: sudo_check.rc != 0 or sudo_check.failed

- name: Gather ansible facts
  ansible.builtin.setup:
    become: false

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
    become: "{{ bootstrap_become | default(true) }}"


