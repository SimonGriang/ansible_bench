---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    name: postfix
    question: main_mailer_type
    value: "No configuration"
  when: ansible_os_family == "Debian"

- name: Install postfix
  ansible.builtin.package:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present
  when:
    - postfix_virtual_mailbox_maps is defined
    - 'mysql' in postfix_virtual_mailbox_maps
  ignore_errors: true

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport
    mode: 0644
  notify:
    - Validate configuration
    - Rebuild transport_maps database
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
    mode: 0644
  notify:
    - Validate configuration
    - Reload postfix
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf (1/2)
  ansible.builtin.set_fact:
    _postfix_smtpd_recipient_restrictions_check_recipient_access: "{{ 'check_recipient_access' in postfix_recipient_access }}"
    _postfix_smtpd_sender_restrictions_check_sender_access: "{{ 'check_sender_access' in postfix_sender_access }}"

- name: Setting values for main.cf (2/2)
  ansible.builtin.set_fact:
    _postfix_mynetworks: "{{ postfix_mynetworks | default([]) | map('list') | join(' ') }}"
    _postfix_mydestination: "{{ postfix_mydestination | default([]) | map('list') | join(' ') }}"
    _postfix_relay_domains: "{{ postfix_relay_domains | default([]) | map('list') | join(' ') }}"
    _postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default([]) | map('list') | join(' ') }}"
    _postfix_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default([]) | map('list') | join(' ') }}"
    _postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default([]) | map('list') | join(' ') }}"
    _postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains | default([]) | map('list') | join(' ') }}"

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 0644
  notify:
    - Validate configuration
    - Restart postfix
  register: main_cf_result
  failed_when: main_cf_result.rc != 0 and 'postconf' in main_cf_result.stderr

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: 0644
  notify:
    - Validate configuration
    - Restart postfix
  register: master_cf_result
  failed_when: master_cf_result.rc != 0 and 'postconf' in master_cf_result.stderr

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ postfix_smtpd_tls_cert_file | dirname }}"
    state: directory
    mode: 0700
  when:
    - postfix_smtpd_tls_cert_file is defined
    - postfix_smtpd_tls_key_file is defined

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: 0600
  notify: Reload postfix
  when: postfix_smtpd_tls_cert_file_source is defined

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: 0600
  notify: Reload postfix
  when: postfix_smtpd_tls_key_file_source is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure aliases
  ansible.builtin.lineinfile:
    path: "{{ postfix_alias_path }}"
    line: "{{ item.name }}: {{ item.destination }}"
    create: yes
    mode: 0644
  notify:
    - Rebuild alias database
    - Reload postfix
  loop: "{{ postfix_aliases }}"

- name: Configure sender_access
  ansible.builtin.lineinfile:
    path: "{{ postfix_sender_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    create: yes
    mode: 0644
  notify:
    - Rebuild sender_access database
    - Reload postfix
  loop: "{{ postfix_sender_access }}"

- name: Configure recipient_access
  ansible.builtin.lineinfile:
    path: "{{ postfix_recipient_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    create: yes
    mode: 0644
  notify:
    - Validate configuration
    - Rebuild recipient_access database
    - Reload postfix
  loop: "{{ postfix_recipient_access }}"

- name: Place sasl_password_map
  ansible.builtin.copy:
    dest: "{{ postfix_smtp_sasl_password_map }}"
    content: "{{ postfix_smtp_sasl_password_map_content }}"
    mode: 0600
  notify: Rebuild sasl_password_map database
  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map != ""

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Start and enable postfix
  ansible.builtin.systemd:
    name: "{{ postfix_service }}"
    state: started
    enabled: yes


