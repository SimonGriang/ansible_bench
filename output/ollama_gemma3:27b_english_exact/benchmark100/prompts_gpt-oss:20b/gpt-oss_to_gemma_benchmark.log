---
- name: check if all variables have been set correctly
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: wait for host (when configured)
  wait_for:
    port: "{{ bootstrap_ssh_port | default(22) }}"
    timeout: "{{ bootstrap_timeout | default(300) }}"
  become: "{{ bootstrap_become | default(false) }}"
  when:
    - bootstrap_wait_for_host | bool
    - ansible_connection != 'container'
    - ansible_connection != 'docker'

- name: prepare system
  block:
    - name: Test connection to host
      wait_for_connection:
        timeout: "{{ bootstrap_timeout | default(300) }}"
      register: connection_test_result
      changed_when: false
  rescue:
    - name: Debug connection timeout
      debug:
        msg: "Connection test failed with timeout: {{ bootstrap_timeout | default(300) }}"
      changed_when: true
  always:
    - name: Gather raw bootstrap facts
      include_tasks: gather_facts.yml
    - name: Execute raw bootstrap install commands
      command: "{{ bootstrap_install.raw }}"
      shell: /bin/sh
      register: bootstrap_install_result
      changed_when:
        - ansible_os_family == "Debian" and bootstrap_install_result.stdout | regex_search("apt-get install")
        - ansible_os_family == "RedHat" and bootstrap_install_result.stdout | regex_search("yum install")
        - ansible_os_family == "Suse" and bootstrap_install_result.stdout | regex_search("zypper install")
      become: "{{ bootstrap_become | default(false) }}"
      become_user: "{{ bootstrap_become_user | default(null) }}"

- name: ensure system is prepared by issuing ansible modules.
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(null) }}"
  block:
    - name: Gather Ansible facts
      setup:
        gather_subset:
          - all
    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap__facts_packages }}"
        state: present
        update_cache: true


