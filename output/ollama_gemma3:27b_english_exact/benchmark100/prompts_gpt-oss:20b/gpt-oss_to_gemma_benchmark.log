---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Modify SELinux booleans
      seboolean:
        name: "{{ item }}"
        state: true
        persistent: true
      loop: "{{ httpd_sebooleans }}"

    - name: Allow HTTPD port through firewall
      firewalld:
        port: "{{ httpd_port }}/tcp"
        permanent: true
        state: enabled
      when:
        - ansible_facts['distribution'] == "RedHat"
        - ansible_facts['distribution'] == "CentOS"
        - ansible_facts['distribution'] == "Rocky"
        - ansible_facts['distribution'] == "AlmaLinux"

    - name: Allow HTTPD SSL port through firewall
      firewalld:
        port: "{{ httpd_ssl_port }}/tcp"
        permanent: true
        state: enabled
      when:
        - ansible_facts['distribution'] == "RedHat"
        - ansible_facts['distribution'] == "CentOS"
        - ansible_facts['distribution'] == "Rocky"
        - ansible_facts['distribution'] == "AlmaLinux"
        - httpd_ssl_port is defined
  when: ansible_facts['selinux']['status'] == "enabled"

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Activate httpd module | Debian
  command: a2enmod "{{ item }}"
  register: a2enmod_result
  changed_when: a2enmod_result.rc != 0
  notify:
    - Test httpd configuration validity
  when:
    - ansible_facts['distribution'] == "Debian"
    - ansible_facts['distribution'] == "Ubuntu"
  loop: "{{ httpd_modules_to_activate_with_command }}"

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf }}.j2"
    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
    mode: 0644
  notify:
    - Test httpd configuration validity
    - Restart httpd
  when: ansible_facts['distribution_family'] in ["Debian", "RedHat", "Suse"]

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


