---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
    state: started
  when: ansible_connection is defined and ansible_connection != 'container' and bootstrap_wait_for_host

- name: Test connection
  block:
    - name: Test connection
      ansible.builtin.wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: bootstrap_connect
      no_log: true
      delegate_to: localhost
      run_once: true
      changed_when: false

    - name: Test sudo
      ansible.builtin.command:
        cmd: sudo --version
      changed_when: false
      delegate_to: localhost
      run_once: true

  rescue:
    - name: Gather bootstrap facts
      ansible.builtin.include_tasks:
        file: gather_facts.yml

    - name: Install bootstrap packages (raw)
      ansible.builtin.raw:
        cmd: "{{ bootstrap_install.raw }}"
        executable: /bin/sh
      register: bootstrap_install_packages
      changed_when:
        - ansible_os_family == "Debian" and bootstrap_install_packages.rc != 0
        - ansible_os_family == "RedHat" and bootstrap_install_packages.rc != 0
        - ansible_os_family == "Suse" and bootstrap_install_packages.rc != 0
        - ansible_os_family == "Darwin" and bootstrap_install_packages.rc != 0

    - name: Ensure libdnf5 is present on Fedora/RedHat
      ansible.builtin.raw:
        cmd: dnf install -y python3-libdnf5
        executable: /bin/sh
      when: ansible_os_family == "RedHat"

- name: Gather ansible facts
  ansible.builtin.setup:
  become: false

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages.split() }}"
    state: present
    update_cache: true
    become: "{{ bootstrap_become }}"

