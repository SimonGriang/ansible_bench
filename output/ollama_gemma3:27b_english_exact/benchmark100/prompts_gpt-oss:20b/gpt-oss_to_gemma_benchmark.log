    fail_msg: "Downgrade to version {{ rke2_version }} is not allowed. Current running version is {{ running_version }}.  Allow downgrade using rke2_allow_downgrade=true."
    success_msg: "Version check passed. Desired version {{ rke2_version }} is greater than or equal to running version {{ running_version }}."
  when: not ansible_check_mode

- name: Run RKE2 install script
  block:
    - name: Run installation script (airgap)
      ansible.builtin.shell:
        cmd: "{{ rke2_install_script_dir }}/rke2.sh --airgap-artifacts-path={{ rke2_artifact_path }} --airgap-images-dir={{ rke2_tarball_images_path }} --airgap-method=local"
      environment:
        INSTALL_RKE2_ARTIFACT_PATH: "{{ rke2_artifact_path }}"
        INSTALL_RKE2_AGENT_IMAGES_DIR: "{{ rke2_tarball_images_path }}"
        INSTALL_RKE2_METHOD: "local"
      when: rke2_airgap_mode
    - name: Run installation script (online)
      ansible.builtin.shell:
        cmd: "{{ rke2_install_script_dir }}/rke2.sh"
      environment:
        INSTALL_RKE2_VERSION: "{{ rke2_version }}"
        INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"
        INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"
        INSTALL_RKE2_METHOD: "default"
      when: not rke2_airgap_mode
  when: not ansible_check_mode and rke2_version != installed_version

- name: Copy Custom Manifests
  ansible.builtin.template:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/{{ item | basename }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/{{ item | basename }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods is defined and rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  ansible.builtin.template:
    src: rke2_environment.j2
    dest: /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: 0644
  when: rke2_environment_options | length > 0


