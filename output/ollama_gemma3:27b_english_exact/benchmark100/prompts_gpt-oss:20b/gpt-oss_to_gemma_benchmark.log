    repo: "deb https://releases.hashicorp.com/{{ ansible_distribution_release }} main"
    state: present
    filename: hashicorp
  when: ansible_os_family == "Debian"

- name: Install hashicorp product using package
  package:
    name: "{{ item.name }}"
    state: present
    version: "{{ item.version | default('latest') }}"
  loop: "{{ hashicorp_products }}"

- name: Install latest hashicorp product using package
  package:
    name: "{{ item.name }}"
    state: present
  loop: "{{ hashicorp_products | selectattr('version', 'equalto', none) }}"

- name: Install versioned hashicorp product using package
  package:
    name: "{{ item.name }}"
    state: present
    version: "{{ item.version }}"
  loop: "{{ hashicorp_products | selectattr('version', 'defined') }}"

- name: Install manually
  block:
    - name: Create destination directory
      file:
        path: "{{ hashicorp_destination }}"
        state: directory
        mode: '0755'
        owner: "{{ hashicorp_owner }}"
        group: "{{ hashicorp_group }}"
  delegate_to: localhost

- name: Install hashicorp product manually
  block:
    - name: Extract tarball
      unarchive:
        src: "{{ hashicorp_src }}"
        dest: "{{ hashicorp_destination }}"
        remote_src: true
        owner: "{{ hashicorp_owner }}"
        group: "{{ hashicorp_group }}"
        mode: '0755'
  loop: "{{ hashicorp_products }}"


