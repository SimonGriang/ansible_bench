  ansible.builtin.template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    mode: '0644'
  when:
    - git_user_email is defined
    - git_user_name is defined
    - git_username is defined
    - getent_passwd is defined
    - getent_passwd[git_username] != 'none'

