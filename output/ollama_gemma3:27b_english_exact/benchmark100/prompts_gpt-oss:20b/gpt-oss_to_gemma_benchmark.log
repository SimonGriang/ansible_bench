ost: "{{ item.host }}"\n    host_all: "{{ item.host_all }}"\n    update_password: "{{ item.update_password | default(omit) }}"\n    login_user: root\n    login_unix_socket: "{{ mysql_socket }}"\n    login_password: "{{ mysql_root_password }}"\n    no_log: true\n  loop: "{{ mysql_users }}"\n  when: mysql_users is defined\n\n- name: Flush handlers again\n  handlers: []\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-17T20:44:26.170424933Z', 'done': True, 'done_reason': 'stop', 'total_duration': 44381266650, 'load_duration': 211579751, 'prompt_eval_count': 1791, 'prompt_eval_duration': 6446171715, 'eval_count': 672, 'eval_duration': 37722113415, 'model_name': 'gemma3:27b'} id='run--92d13485-84f0-4eaf-a45b-463e956915ac-0' usage_metadata={'input_tokens': 1791, 'output_tokens': 672, 'total_tokens': 2463}
