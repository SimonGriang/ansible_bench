---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    state: directory
  loop:
    - path: "{{ dns_datadir }}"
      mode: "1770"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
    - path: "{{ dns_confdir }}"
      mode: "0755"
      owner: root
      group: root
  loop_control:
    label: "{{ item.path }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true

- name: Generate rndc key
  command: rndc-confgen -a -c {{ dns_confdir }}
  args:
    creates: "{{ dns_confdir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0640"

- name: Get the hints/root file
  uri:
    url: https://www.internic.net/domain/named.root
    dest: "{{ dns_datadir }}/named.root"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    validate_certs: "{{ dns_validate_certs }}"
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.db"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  with_items: "{{ dns_zones }}"
  when: item.type is undefined or item.type == "primary"
  loop_control:
    label: "{{ item.name }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    backup: yes
  validate: named-checkconf -zj %s
  notify: Restart dns

- name: Place systemd override
  block:
    - name: Create directory for override
      file:
        path: /etc/systemd/system/{{ dns_service }}.service.d
        mode: "0755"
        state: directory
    - name: Copy override file
      copy:
        src: override.conf
        dest: /etc/systemd/system/{{ dns_service }}.service.d/override.conf
        owner: root
        group: root
        mode: "0644"
    - name: Reload systemd daemon
      systemd:
        daemon_reload: true
      changed_when: false
  when: ansible_service_mgr == "systemd"

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


