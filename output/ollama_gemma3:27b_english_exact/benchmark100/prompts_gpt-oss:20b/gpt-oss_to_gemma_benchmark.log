ible.builtin.copy:\n    dest: "/home/{{ user.name }}/.ssh/{{ item.filename }}"\n    content: "{{ item.content }}"\n    mode: \'400\'\n    owner: "{{ user.name }}"\n    group: "{{ user.group }}"\n  loop: "{{ user.private_keys | default([]) }}"\n  when: user.private_keys is defined\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-17T18:45:00.731814413Z', 'done': True, 'done_reason': 'stop', 'total_duration': 87126820362, 'load_duration': 198285767, 'prompt_eval_count': 2970, 'prompt_eval_duration': 10124133952, 'eval_count': 1317, 'eval_duration': 76802883778, 'model_name': 'gemma3:27b'} id='run--845bbac0-a5fa-4e15-ba6f-1a59e5e2308c-0' usage_metadata={'input_tokens': 2970, 'output_tokens': 1317, 'total_tokens': 4287}
