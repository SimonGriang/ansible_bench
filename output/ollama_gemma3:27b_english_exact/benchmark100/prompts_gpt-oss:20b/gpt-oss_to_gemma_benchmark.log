content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  delegate_to: localhost\n  run_once: true\n\n- name: Enable redis module stream (RHEL 8)\n  dnf:\n    name: redis\n    state: enabled\n  when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"\n\n- name: Install redis\n  package:\n    name: "{{ redis_packages }}"\n    state: present\n\n- name: Configure redis\n  template:\n    src: redis.conf-{{ ansible_distribution }}.j2\n    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"\n    owner: "{{ redis_owner }}"\n    group: "{{ redis_group }}"\n    mode: "{{ redis_mode }}"\n    notify: Restart redis\n\n- name: Start and enable redis\n  service:\n    name: "{{ redis_service }}"\n    state: started\n    enabled: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-17T18:19:09.535957154Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14639916897, 'load_duration': 206703561, 'prompt_eval_count': 543, 'prompt_eval_duration': 1346906624, 'eval_count': 226, 'eval_duration': 13084511388, 'model_name': 'gemma3:27b'} id='run--031c199b-8958-428f-82b3-db404221c08a-0' usage_metadata={'input_tokens': 543, 'output_tokens': 226, 'total_tokens': 769}
