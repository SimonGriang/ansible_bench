---

  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install prerequisites
    package:
      name: "{{ vault_prerequisites }}"
      state: present

  - name: Include installation method specific tasks
    include_tasks: "{{ vault_installation_method }}.yml"

  - name: Add Vault environment variables
    lineinfile:
      path: /etc/vault.d/vault.env
      line: "{{ item.name }}={{ item.value }}"
      create: yes
      regexp: "^{{ item.name }}=(.*)$"
      mode: '0644'
    loop: "{{ vault_environment_settings }}"
    notify: Restart vault

  - name: Include hardening tasks
    include_tasks: hardening.yml

  - name: Start and enable vault
    systemd:
      name: vault
      state: started
      enabled: yes
    when: vault_type == "oss"

  - name: Enable vault
    systemd:
      name: vault
      state: enabled
    when: vault_type != "oss"


