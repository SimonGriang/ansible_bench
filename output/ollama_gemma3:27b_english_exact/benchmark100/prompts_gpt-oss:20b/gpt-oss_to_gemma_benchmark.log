---
  - name: Import assert.yml
    ansible.builtin.import_tasks:
      file: assert.yml
      run_once: true
      delegate_to: localhost

  - name: Install required packages
    ansible.builtin.package:
      name: "{{ selinux_requirements }}"
      state: present
    notify: Gather facts

  - name: Flush handlers
    ansible.builtin.meta:
      flush_handlers:

  - name: Configure selinux
    block:
      - name: Set SELinux state and policy
        ansible.posix.selinux:
          state: "{{ selinux_state }}"
          policy: "{{ selinux_policy }}"
        notify: Reboot

      - name: Manage SELinux booleans
        ansible.posix.selinux_boolean:
          name: "{{ item.name }}"
          state: "{{ item.state | default('yes') }}"
          persistent: true
        loop: "{{ selinux_booleans | default([]) }}"
        loop_control:
          label: "{{ item.name }}"
        when: selinux_booleans is defined
    when: ansible_selinux.status is defined and not (ansible_connection == 'container' or ansible_connection == 'docker')


