---
- name: Create the RKE2 manifests directory
  file:
    path: "{{ rke2_data_path }}/server/manifests"
    owner: root
    group: root
    mode: '0700'
    state: directory

- name: Copy kube-vip files to first server
  template:
    src: templates/kube-vip/kube-vip.yml.j2
    dest: "{{ rke2_data_path }}/server/manifests/kube-vip.yml"
    owner: root
    group: root
    mode: '0664'

- name: Copy kube-vip rbac files to first server
  template:
    src: templates/kube-vip/kube-vip-rbac.yml.j2
    dest: "{{ rke2_data_path }}/server/manifests/kube-vip-rbac.yml"
