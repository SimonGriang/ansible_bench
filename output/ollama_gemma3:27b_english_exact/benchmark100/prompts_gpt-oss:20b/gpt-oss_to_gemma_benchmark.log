      loop: "{{ rke2_artifact }}"
      loop_control:
        exclude: "'sha256sum*'"

    - name: Download installation script locally
      ansible.builtin.get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"

    - name: Copy local artifacts to remote host
