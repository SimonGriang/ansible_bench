---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install using package
  package:
    name: "{{ item.name }}"
    state: present
    version: "{{ item.version | default('latest') }}"
  loop: "{{ hashicorp_products }}"

- name: Install repository for RedHat
  block:
    - name: Download HashiCorp repository
      get_url:
        url: "https://releases.hashicorp.com/gpgkey.asc"
        dest: /tmp/hashicorp.gpg.key
    - name: Add HashiCorp repository
      yum_repository:
        name: hashicorp
        description: HashiCorp Repository
        baseurl: "https://releases.hashicorp.com/{{ ansible_distribution }}/{{ ansible_distribution_major_version }}/x86_64/"
        gpg_key: /tmp/hashicorp.gpg.key
        state: present
  when: ansible_os_family in ["RedHat", "Rocky"]

- name: Configure debian
  block:
    - name: Add HashiCorp APT repository
      apt_repository:
        repo: "deb https://releases.hashicorp.com/{{ ansible_distribution_release }} main"
        state: present
        filename: hashicorp
  when: ansible_os_family == "Debian"

- name: Install required package gpg
  package:
    name: gpg
    state: present
  when: ansible_os_family == "Debian"

- name: Install apt key for Debian
  apt_key:
    url: "https://releases.hashicorp.com/gpgkey"
    state: present
    validate_certs: false
  when: ansible_os_family == "Debian"

- name: Install repository for Debian
  apt_repository:
    repo: "deb https://releases.hashicorp.com/{{ ansible_distribution_release }} main"
    state: present
    filename: hashicorp
  when: ansible_os_family == "Debian"

- name: Install hashicorp product using package
  package:
    name: "{{ item.name }}"
    state: present
    version: "{{ item.version | default('latest') }}"
  loop: "{{ hashicorp_products }}"

- name: Install latest hashicorp product using package
  package:
    name: "{{ item.name }}"
    state: present
  loop: "{{ hashicorp_products | selectattr('version', 'equalto', none) }}"

- name: Install versioned hashicorp product using package
  package:
    name: "{{ item.name }}"
    state: present
    version: "{{ item.version }}"
  loop: "{{ hashicorp_products | selectattr('version', 'defined') }}"

- name: Install manually
  block:
    - name: Create destination directory
      file:
        path: "{{ hashicorp_destination }}"
        state: directory
        mode: '0755'
        owner: "{{ hashicorp_owner }}"
        group: "{{ hashicorp_group }}"
  delegate_to: localhost

- name: Install hashicorp product manually
  block:
    - name: Extract tarball
      unarchive:
        src: "{{ hashicorp_src }}"
        dest: "{{ hashicorp_destination }}"
        remote_src: true
        owner: "{{ hashicorp_owner }}"
        group: "{{ hashicorp_group }}"
        mode: '0755'
  loop: "{{ hashicorp_products }}"


