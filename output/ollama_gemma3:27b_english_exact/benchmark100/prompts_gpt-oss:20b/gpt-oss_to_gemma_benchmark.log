---

  - name: Import assert.yml
    include_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Configure apk
    when: ansible_pkg_mgr == "apk"
    block:
      - name: Update apk cache
        community.general.apk:
          update_cache: true
          cache_valid_time: 3600
        register: apk_update_cache
        changed_when: false

      - name: Upgrade all packages
        community.general.apk:
          upgrade: true
        register: apk_upgrade
        notify: Reboot
        when: apk_upgrade.changed
    when: ansible_pkg_mgr == "apk"

  - name: Configure apt
    when: ansible_pkg_mgr == "apt"
    block:
      - name: Hold selected packages
        ansible.builtin.dpkg_selections:
          name: "{{ item }}"
          state: hold
        loop: "{{ update_excluded_packages }}"

      - name: Update all packages
        ansible.builtin.apt:
          update_cache: true
          upgrade: "{{ update_upgrade_command }}"
          cache_valid_time: "{{ update_cache_valid_time }}"
          dpkg_options: "DEBIAN_FRONTEND: nointeractive"
        register: apt_update
        notify: Reboot
        when: apt_update.changed

      - name: Autoremove packages
        ansible.builtin.apt:
          autoremove: true
        when: update_autoremove | bool
    when: ansible_pkg_mgr == "apt"

  - name: Update all software (dnf)
    when: ansible_pkg_mgr == "dnf" or ansible_pkg_mgr == "dnf5"
    ansible.builtin.dnf:
      name: "*"
      state: latest
      exclude: "{{ update_excluded_packages }}"
    register: dnf_update
    notify: Reboot
    when: dnf_update.changed

  - name: Update all software (pacman)
    when: ansible_pkg_mgr == "pacman"
    community.general.pacman:
      update_cache: true
      upgrade: true
    register: pacman_update
    notify: Reboot
    when: pacman_update.changed

  - name: Configure yum
    when: ansible_pkg_mgr == "yum"
    block:
      - name: Update all software (yum - RHEL/CentOS 6)
        when: ansible_distribution_major_version == "6"
        ansible.builtin.dnf:
          name: "*"
          state: latest
          exclude: "{{ update_excluded_packages }}"
        register: yum_update_6
        notify: Reboot
        when: yum_update_6.changed

      - name: Update all software (yum - other)
        ansible.builtin.dnf:
          name: "*"
          state: latest
          exclude: "{{ update_excluded_packages }}"
        register: yum_update_other
        notify: Reboot
        when: yum_update_other.changed

      - name: Install yum-utils
        ansible.builtin.package:
          name: yum-utils
          state: present


