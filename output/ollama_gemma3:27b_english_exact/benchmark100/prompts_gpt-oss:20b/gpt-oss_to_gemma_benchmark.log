---
- name: Create the RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  copy:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: "Config file changed"

- name: Copy kubelet config
  copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  when: rke2_kubelet_config
  notify: "Config file changed"

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  when: rke2_custom_registry_mirrors or rke2_custom_registry_configs
  notify: "Config file changed"

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file and (rke2_server is not defined or rke2_server.state != 'started')

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file and rke2_etcd_snapshot_s3_options is defined and \
        rke2_etcd_snapshot_s3_options.access_key is defined and \
        rke2_etcd_snapshot_s3_options.secret_key is defined and \
        rke2_etcd_snapshot_s3_options.bucket is defined and \
        rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  command: "rke2 server --cluster-reset --cluster-reset-restore-path {{ rke2_etcd_snapshot_file }}"
  args:
    creates: /var/lib/rke2/etcd/db
  when: do_etcd_restore
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"

- name: Restore etcd from s3
  command: "rke2 server --cluster-reset --etcd-s3 --access-key {{ rke2_etcd_snapshot_s3_options.access_key }} \
            --secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }} --bucket {{ rke2_etcd_snapshot_s3_options.bucket }} \
            --snapshot-name {{ rke2_etcd_snapshot_s3_options.snapshot_name }} --endpoint {{ rke2_etcd_snapshot_s3_options.endpoint }} \
            --region {{ rke2_etcd_snapshot_s3_options.region }} --endpoint-ca {{ rke2_etcd_snapshot_s3_options.endpoint_ca }} \
            --folder {{ rke2_etcd_snapshot_s3_options.folder }} --skip-ssl-verify {{ rke2_etcd_snapshot_s3_options.skip_ssl_verify }}"
  when: do_etcd_restore_from_s3
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server
    state: started
    enabled: true
    daemon_reload: true
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  notify: "Service (re)started"

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent
    state: stopped
    enabled: false
    masked: true

- name: Wait for the first server be ready - no CNI
  command: "kubectl get node {{ rke2_node_name }}"
  register: node_status
  until: "'Ready' in node_status.stdout and 'DiskPressure' not in node_status.stdout and 'PIDPressure' not in node_status.stdout"
  retries: 100
  delay: 15
  when: not ansible_check_mode and rke2_cni == 'none'

- name: Wait for the first server be ready - with CNI
  command: "kubectl get nodes | grep {{ rke2_node_name }}"
  register: node_status
  until: "'Ready' in node_status.stdout"
  retries: 40
  delay: 15
  when: not ansible_check_mode and rke2_cni != 'none'

- name: Restore etcd
  block:
    - name: Get registered nodes
      command: "kubectl get nodes --no-headers"
      register: registered_nodes

    - name: Gather all node names from inventory
      set_fact:
        all_node_names: "{{ hostvars | map(attribute='inventory_hostname') | list }}"

    - name: Delete old node-password secrets
      kubernetes.core.k8s:
        api_version: v1
        kind: Secret
        namespace: kube-system
        name: "{{ item }}"
        state: absent
      loop: "{{ all_node_names | difference(registered_nodes.stdout_lines) }}"

    - name: Delete old node objects
      kubernetes.core.k8s:
        api_version: v1
        kind: Node
        name: "{{ item }}"
        state: absent
      loop: "{{ all_node_names | difference(registered_nodes.stdout_lines) }}"
  when: false

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ groups[rke2_cluster_group_name][0] }}"
  delegate_facts: true


