tin.copy:\n    dest: "/home/{{ user.name }}/.ssh/{{ item.filename }}"\n    content: "{{ item.content }}"\n    mode: \'400\'\n    owner: "{{ user.name }}"\n    group: "{{ user.group }}"\n  loop: "{{ user.private_keys | default([]) }}"\n  when: user.private_keys is defined\n' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-17T18:42:02.841260596Z', 'done': True, 'done_reason': 'stop', 'total_duration': 87379267437, 'load_duration': 224214093, 'prompt_eval_count': 2970, 'prompt_eval_duration': 10621655038, 'eval_count': 1313, 'eval_duration': 76531613824, 'model_name': 'gemma3:27b'} id='run--93f86bd0-5a8d-4462-bcc4-520407ed433c-0' usage_metadata={'input_tokens': 2970, 'output_tokens': 1313, 'total_tokens': 4283}
