---
- name: Remove any packages listed in the variable `docker_obsolete_packages` to avoid conflicts with newer Docker releases.
  yum:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Import the GPG key specified by `docker_yum_gpg_key` into the system's RPM keyring, but only when `docker_add_repo` evaluates to true.
  rpm_key:
    key: "{{ docker_yum_gpg_key }}"
    state: present
  when: docker_add_repo

- name: Download the Docker repository file from the URL defined in `docker_yum_repo_url` and place it at `/etc/yum.repos.d/docker-{{ docker_edition }}.repo` with root ownership and 0644 permissions, conditioned on `docker_add_repo` being true.
  get_url:
    url: "{{ docker_yum_repo_url }}"
    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    owner: root
    group: root
    mode: 0644
  when: docker_add_repo

- name: In the Docker repository file, enable or disable the nightly repository section (`docker-{{ docker_edition }}-nightly`) by setting the `enabled` option to the value of `docker_yum_repo_enable_nightly`, with 0644 permissions and no extra spaces, only when `docker_add_repo` is true.
  lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^\[docker-{{ docker_edition }}-nightly\]$'
    line: '[docker-{{ docker_edition }}-nightly]'
    state: present
  when: docker_add_repo
- name: In the Docker repository file, enable or disable the nightly repository section (`docker-{{ docker_edition }}-nightly`) by setting the `enabled` option to the value of `docker_yum_repo_enable_nightly`, with 0644 permissions and no extra spaces, only when `docker_add_repo` is true.
  lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^enabled = '
    line: 'enabled = {{ docker_yum_repo_enable_nightly | bool }}'
    state: present
  when: docker_add_repo

- name: In the Docker repository file, enable or disable the test repository section (`docker-{{ docker_edition }}-test`) by setting the `enabled` option to the value of `docker_yum_repo_enable_test`, with 0644 permissions and no extra spaces, only when `docker_add_repo` is true.
  lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^\[docker-{{ docker_edition }}-test\]$'
    line: '[docker-{{ docker_edition }}-test]'
    state: present
  when: docker_add_repo
- name: In the Docker repository file, enable or disable the test repository section (`docker-{{ docker_edition }}-test`) by setting the `enabled` option to the value of `docker_yum_repo_enable_test`, with 0644 permissions and no extra spaces, only when `docker_add_repo` is true.
  lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^enabled = '
    line: 'enabled = {{ docker_yum_repo_enable_test | bool }}'
    state: present
  when: docker_add_repo

- name: Configure containerd on RHEL 8.
  block:
    - name: Remove the `runc` package.
      yum:
        name: runc
        state: absent

    - name: Install the `container-selinux` package.
      yum:
        name: container-selinux
        state: present

    - name: Install the `containerd.io` package.
      yum:
        name: containerd.io
        state: present
  when: ansible_facts.distribution_major_version | int == 8


