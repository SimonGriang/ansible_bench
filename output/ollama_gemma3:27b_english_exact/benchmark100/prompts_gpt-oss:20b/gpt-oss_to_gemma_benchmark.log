ible.builtin.copy:\n    dest: "/home/{{ user.name }}/.ssh/{{ item.filename }}"\n    content: "{{ item.content }}"\n    mode: \'400\'\n    owner: "{{ user.name }}"\n    group: "{{ user.group }}"\n  loop: "{{ user.private_keys | default([]) }}"\n  when: user.private_keys is defined\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-17T18:43:31.873059521Z', 'done': True, 'done_reason': 'stop', 'total_duration': 87353315056, 'load_duration': 200848383, 'prompt_eval_count': 2970, 'prompt_eval_duration': 10043116415, 'eval_count': 1317, 'eval_duration': 77108425888, 'model_name': 'gemma3:27b'} id='run--cd2c733d-3f7b-4428-932b-49119865a19e-0' usage_metadata={'input_tokens': 2970, 'output_tokens': 1317, 'total_tokens': 4287}
