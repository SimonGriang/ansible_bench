---
- name: Cordon and Drain the node {{ rke2_node_name }}
  shell: |
    set -o pipefail
    {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml cordon {{ rke2_node_name }}
    {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml drain {{ rke2_node_name }} --ignore-daemonsets --delete-local-data {{ rke2_drain_additional_args }}
  register: drain
  retries: 100
  delay: 15
  run_once: true
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  when: rke2_drain_node_during_upgrade

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: |
    {{ rke2_data_path }}/kubectl get nodes | grep " Ready" | wc -l
  register: all_ready_nodes
  retries: 100
  delay: 15
  run_once: true
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  until: all_ready_nodes.stdout == groups[rke2_cluster_group_name] | length | string

- name: Uncordon the node {{ rke2_node_name }}
  shell: |
    set -o pipefail
    {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml uncordon {{ rke2_node_name }}
  run_once: true
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  when: rke2_drain_node_during_upgrade
  changed_when: false

- name: Wait for all pods to be ready again
  shell: |
    {{ rke2_data_path }}/kubectl get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded --ignore-not-found | wc -l
  register: all_pods_ready
  retries: 100
  delay: 15
  run_once: true
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  until: all_pods_ready.stdout == "0"
  when: rke2_wait_for_all_pods_to_be_ready
  changed_when: false

- name: Wait for all pods to pass readiness checks
  shell: |
    {{ rke2_data_path }}/kubectl wait {{ rke2_wait_for_all_pods_to_be_healthy_args }}
  run_once: true
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  retries: 100
  delay: 15
  until: true
  when: rke2_wait_for_all_pods_to_be_healthy
  changed_when: false


