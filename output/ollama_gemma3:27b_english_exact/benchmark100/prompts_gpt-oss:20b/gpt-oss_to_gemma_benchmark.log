---
- name: Download RKE2 installation script
  ansible.builtin.get_url:
    url: "{{ rke2_install_bash_url }}"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    timeout: "{{ rke2_artifact_fetch_timeout }}"
  when: not rke2_airgap_mode

- name: Copy local RKE2 installation script
  ansible.builtin.copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation == 'copy'

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifact_path }}"
    state: directory
    mode: 0700
  when: rke2_airgap_mode and rke2_airgap_implementation != 'exists'

- name: Download RKE2 checksum and artifacts (try remote first – fallback to local download and push)
  block:
    - name: Download SHA256 checksum file
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
        mode: 0640
        force: yes

    - name: Download RKE2 artifacts
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"
        dest: "{{ rke2_artifact_path }}/{{ item }}"
        mode: 0640
        force: yes
        checksum_file: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
      loop: "{{ rke2_artifact }}"
      loop_control:
        exclude: "'sha256sum*'"

    - name: Download RKE2 installation script
      ansible.builtin.get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
  rescue:
    - name: Pause for cancellation
      ansible.builtin.pause:
        seconds: 7

    - name: Create local copy directory
      ansible.builtin.file:
        path: "{{ rke2_airgap_copy_sourcepath }}"
        state: directory
        mode: 0750
        owner: "{{ ansible_user_id }}"

    - name: Download checksum file locally
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_airgap_copy_sourcepath }}/sha256sum-{{ rke2_architecture }}.txt"

    - name: Download artifacts locally
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"
        dest: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
      loop: "{{ rke2_artifact }}"
      loop_control:
        exclude: "'sha256sum*'"

    - name: Download installation script locally
      ansible.builtin.get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"

    - name: Copy local artifacts to remote host
      ansible.builtin.copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/"
        dest: "{{ rke2_artifact_path }}/"
        remote_src: yes

    - name: Copy local installation script to remote host
      ansible.builtin.copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
  when: rke2_airgap_mode and rke2_airgap_implementation == 'download'

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item }}"
    mode: 0640
    force: yes
  loop: "{{ rke2_artifact }}"
  when: rke2_airgap_mode and rke2_airgap_implementation == 'copy'

- name: Airgap mode – additional images tarballs
  block:
    - name: Create directory for tarballs
      ansible.builtin.file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: 0700

    - name: Copy additional tarballs
      ansible.builtin.copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"
        mode: 0644
        force: yes
  loop: "{{ rke2_airgap_copy_additional_tarballs }}"
  when: rke2_airgap_mode and rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation != 'exists'

- name: Airgap mode – ensure artifacts exist and have acceptable permissions
  block:
    - name: Stat artifacts
      ansible.builtin.stat:
        path: "{{ rke2_artifact_path }}/{{ item }}"
      register: artifacts
      loop: "{{ rke2_artifact }}"

    - name: Stat installation script
      ansible.builtin.stat:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
      register: install_script

    - name: Check if artifacts are writable
      ansible.builtin.set_fact:
        artifacts_writeable: "{{ artifacts.results | json_query('[?stat.mode & 0220] | length > 0') }}"

    - name: Change artifact mode if writable
      ansible.builtin.file:
        path: "{{ rke2_artifact_path }}/{{ item }}"
        mode: 0640
      loop: "{{ rke2_artifact }}"
      when: artifacts_writeable

    - name: Ensure installation script is executable
      ansible.builtin.file:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
      when: install_script.stat.mode & 0111 == 0 and install_script.stat.mode & 0220 != 0

    - name: Fail if installation script is not executable
      ansible.builtin.fail:
        msg: "Installation script at {{ rke2_install_script_dir }}/rke2.sh must be executable."
      when: install_script.stat.mode & 0111 == 0
  when: rke2_airgap_mode and rke2_airgap_implementation == 'exists'

- name: Populate service facts
  ansible.builtin.service_facts:

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local
  register: usr_local

- name: Check if separate partition
  ansible.builtin.shell: grep '/usr/local ' /proc/mounts
  register: partition_result
  ignore_errors: yes
  changed_when: false

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: "{{ '/usr/local/bin/rke2' if not usr_local.stat.exists or partition_result.rc == 1 else '/opt/rke2/bin/rke2' }}"

- name: Check RKE2 version
  ansible.builtin.shell: |
    if command -v rke2 > /dev/null; then
      echo "{\"installed_version\": \"$(rke2 --version)\"}"
    elif systemctl is-active --quiet rke2; then
      pid=$(systemctl show rke2 -p MainPID)
      binary=$(readlink -f /proc/$pid/exe)
      echo "{\"running_version\": \"$(basename $binary --version)\"}"
    else
      echo "{\"installed_version\": \"not installed\", \"running_version\": \"not installed\"}"
    fi
  register: versions_check

- name: Set RKE2 versions
  ansible.builtin.set_fact:
    installed_version: "{{ versions_check.stdout | from_json | json_query('installed_version') }}"
    running_version: "{{ versions_check.stdout | from_json | json_query('running_version') }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - rke2_version == "not installed" or (rke2_version_clean | version_compare(running_version_clean, '>='))
    fail_msg: "Downgrade to version {{ rke2_version }} is not allowed. Current running version is {{ running_version }}.  Allow downgrade using rke2_allow_downgrade=true."
    success_msg: "Version check passed. Desired version {{ rke2_version }} is greater than or equal to running version {{ running_version }}."
  when: not ansible_check_mode

- name: Run RKE2 install script
  block:
    - name: Run installation script (airgap)
      ansible.builtin.shell:
        cmd: "{{ rke2_install_script_dir }}/rke2.sh --airgap-artifacts-path={{ rke2_artifact_path }} --airgap-images-dir={{ rke2_tarball_images_path }} --airgap-method=local"
      environment:
        INSTALL_RKE2_ARTIFACT_PATH: "{{ rke2_artifact_path }}"
        INSTALL_RKE2_AGENT_IMAGES_DIR: "{{ rke2_tarball_images_path }}"
        INSTALL_RKE2_METHOD: "local"
      when: rke2_airgap_mode
    - name: Run installation script (online)
      ansible.builtin.shell:
        cmd: "{{ rke2_install_script_dir }}/rke2.sh"
      environment:
        INSTALL_RKE2_VERSION: "{{ rke2_version }}"
        INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"
        INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"
        INSTALL_RKE2_METHOD: "default"
      when: not rke2_airgap_mode
  when: not ansible_check_mode and rke2_version != installed_version

- name: Copy Custom Manifests
  ansible.builtin.template:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/{{ item | basename }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/{{ item | basename }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods is defined and rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  ansible.builtin.template:
    src: rke2_environment.j2
    dest: /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: 0644
  when: rke2_environment_options | length > 0


