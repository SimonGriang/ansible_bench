---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
    run_once: true
    delegate: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    create: true
  loop: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    create: true

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/mysql
  when: ansible_distribution in ["Alpine", "Archlinux"]

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Place my.cnf
  file:
    path: /root/.my.cnf
    src: my.cnf.j2
    mode: '0640'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    target: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    encoding: "{{ item.encoding | default('utf8mb4') }}"
    collation: "{{ item.collation | default('utf8mb4_unicode_ci') }}"
    no_log: true
  loop: "{{ mysql_databases | default([]) }}"
  when: mysql_databases is defined

- name: List databases
  community.mysql.mysql_info:
    target: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    filter: databases
    no_log: true
  register: mysql_info

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases | default([]) }}"
  when:
    - item.initial_import is defined
    - item.name not in mysql_info.databases

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('*.*') }}"
    host: "{{ item.host | default('%') }}"
    host_all: "{{ item.host_all | default(false) }}"
    update_password: "{{ item.update_password | default(true) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    target: "{{ mysql_socket }}"
    no_log: true
  loop: "{{ mysql_users | default([]) }}"
  when: mysql_users is defined

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: true


