---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ansible.builtin.lineinfile:
    path: /etc/mysql/my.cnf
    regexp: "^{{ item.key }}"
    line: "{{ item.key }} = {{ item.value }}"
    state: present
  with_dict: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  ansible.builtin.lineinfile:
    path: /etc/mysql/my.cnf
    regexp: "^socket ="
    line: "socket = {{ mysql_client_socket }}"
    state: present

- name: Initialize mysql
  ansible.builtin.command: mysql_install_db --user=mysql
  become: true
  when: ansible_distribution in ["Alpine", "Archlinux"]

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: "0644"

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.user }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    host: "{{ item.host }}"
    state: present
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


