---
- name: hardening | Disable swap
  swapoff:
    path: all
  when: vault_hardening_disable_swap

- name: hardening | Disable core dumps
  lineinfile:
    path: /etc/security/limits.conf
    regexp: '^.*core.*'
    line: '* soft core 0'
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable core dumps
  lineinfile:
    path: /etc/security/limits.conf
    regexp: '^.*core.*'
    line: '* hard core 0'
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable Shell Command History
  copy:
    dest: /etc/profile.d/vault.sh
    content: |
      HISTIGNORE+=":vault*"
  when: vault_hardening_disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  block:
    - name: Enable SELinux
      selinux:
        state: enforcing
      when: ansible_selinux_enabled and vault_hardening_configure_selinux_apparmor

    - name: Install SELinux policies
      package:
        name: policycoreutils-python-utils
        state: present
      when: ansible_selinux_enabled and vault_hardening_configure_selinux_apparmor

    - name: Install AppArmor profiles
      package:
        name: apparmor-profiles
        state: present
      when: ansible_apparmor_enabled and vault_hardening_configure_selinux_apparmor

    - name: Enforce AppArmor profile for Vault
      apparmor:
        profile: /etc/apparmor.d/vault
        state: enforce
      when: ansible_apparmor_enabled and vault_hardening_configure_selinux_apparmor
  when: vault_hardening_configure_selinux_apparmor


