    path: "{{ key_dir }}/private.key"
    type: rsa
    size: 2048
    force: true
    owner: "{{ owner }}"
    group: "{{ group }}"
    mode: 0600

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ key_dir }}/csr.pem"
    private_key: "{{ key_dir }}/private.key"
    subject:
      common_name: "{{ common_name }}"
    force: true
    owner: "{{ owner }}"
    group: "{{ group }}"
    mode: 0600

- name: Generate an OpenSSL X.509 certificate
  openssl_certificate:
    path: "{{ key_dir }}/certificate.pem"
    private_key: "{{ key_dir }}/private.key"
    csr: "{{ key_dir }}/csr.pem"
    days: 365
    force: true
    owner: "{{ owner }}"
    group: "{{ group }}"
    mode: 0600

- name: Generate a PKCS#12 file
  openssl_pkcs12:
    path: "{{ key_dir }}/pkcs12.p12"
    private_key: "{{ key_dir }}/private.key"
    certificate: "{{ key_dir }}/certificate.pem"
    name: "{{ friendly_name }}"
    force: true
    owner: "{{ owner }}"
    group: "{{ group }}"
    mode: 0600

- name: Read private key content
  slurp:
    src: "{{ key_dir }}/private.key"
  register: private_key_content

- name: Read certificate content
  slurp:
    src: "{{ key_dir }}/certificate.pem"
  register: certificate_content

- name: Create a combined private key and certificate file
  copy:
    content: "{{ private_key_content.content }}\n{{ certificate_content.content }}"
    dest: "{{ key_dir }}/combined.pem"
    owner: "{{ owner }}"
    group: "{{ group }}"
    mode: 0600


