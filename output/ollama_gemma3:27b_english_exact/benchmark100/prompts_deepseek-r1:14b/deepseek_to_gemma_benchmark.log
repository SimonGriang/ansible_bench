  with_items: "{{ groups['rke2_nodes'] }}"

- name: Wait for remaining nodes to be ready - with CNI
  when: cni_configured
  wait_for:
    host: "{{ item }}"
    port: 6443
    timeout: 600
  with_items: "{{ groups['rke2_nodes'] }}"


