---

- name: Validate all variables are set correctly
  include_tasks: assert.yml
  delegate_to: localhost

- name: Wait for host to be available
  ansible.builtin.wait_for:
    port: 22
    timeout: 5

- name: Prepare system for bootstrap
  block:
    - name: Test connection
      ansible.builtin.ping:
    - name: Handle connection failures
      ansible.builtin.fail:
        msg: "Connection to host failed."
      when: ansible_ping_failed is defined and ansible_ping_failed
    - name: Gather facts
      ansible.builtin.setup:
    - name: Install raw bootstrap packages
      ansible.builtin.package:
        name:
          - curl
          - wget
        state: present
  rescue:
    - name: Log failure
      ansible.builtin.debug:
        msg: "System preparation failed."

- name: Ensure system preparation with Ansible modules
  block:
    - name: Gather facts again
      ansible.builtin.setup:
    - name: Install packages based on OS family
      ansible.builtin.package:
        name:
          - python3
          - python3-pip
        state: present
      when: ansible_os_family == "Debian" or ansible_os_family == "Ubuntu"
    - name: Install packages based on OS family (RedHat)
      ansible.builtin.package:
        name:
          - python3
          - python3-pip
        state: present
      when: ansible_os_family == "RedHat" or ansible_os_family == "CentOS"
    - name: Ensure system is fully prepared
      ansible.builtin.debug:
        msg: "System is fully prepared."


