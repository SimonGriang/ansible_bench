---

- name: Remove externally managed from Debian 12
  include_tasks: remove_externally_managed.yml
  when: ansible_facts['distribution'] == 'Debian' and ansible_facts['distribution_version'] == '12'

- name: Ensure Pip is installed.
  apt:
    name: "{{ pip_package }}"
    state: present
  become: true

- name: Ensure packaging is available via dnf
  dnf:
    name: python3-packaging
    state: present
  become: true
  when: ansible_pkg_mgr == 'dnf'

- name: Ensure pip_install_packages are installed.
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default(omit) }}"
    virtualenv: "{{ item.virtualenv | default(omit) }}"
    state: "{{ item.state | default('present') }}"
    extra_args: "{{ item.extra_args | default(omit) }}"
  loop: "{{ pip_install_packages }}"
  become: true


