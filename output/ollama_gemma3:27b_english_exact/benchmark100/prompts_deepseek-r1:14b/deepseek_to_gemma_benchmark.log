---
- name: Enable Backports repository
  apt_repository:
    repo: deb http://deb.debian.org/debian {{ ansible_distribution_release }} main contrib non-free
    state: present
    filename: backports
    update_cache: yes

- name: Set the default_release option for older Debian versions
  set_fact:
    default_release: "{{ ansible_distribution_release }}-backports"
  when: ansible_distribution == "Debian" and ansible_distribution_major_version == "9"

- name: Install Ansible
  apt:
    name: ansible
    state: present
    update_cache: yes
    default_release: "{{ default_release }}"
  when: default_release is defined


