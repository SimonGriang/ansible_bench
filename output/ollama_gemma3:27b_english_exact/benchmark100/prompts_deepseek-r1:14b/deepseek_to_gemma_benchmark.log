---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_url }}"
    dest: /tmp/rke2-install.sh
    mode: 0700
  when: not airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local }}"
    dest: /tmp/rke2-install.sh
    mode: 0700
  when: airgap_mode

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: 0700
  when: airgap_mode and not rke2_artifacts_exists

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ rke2_checksum_url }}"
    dest: /tmp/rke2-checksum.txt
    validate_certs: "{{ rke2_validate_certs }}"
  register: download_checksum
  retries: 3
  delay: 5
  until: download_checksum is succeeded
  ignore_errors: true
- name: Download RKE2 artifacts
  get_url:
    url: "{{ rke2_artifacts_url }}"
    dest: "{{ rke2_artifacts_dir }}"
    validate_certs: "{{ rke2_validate_certs }}"
    checksum: "sha256:/tmp/rke2-checksum.txt"
  register: download_artifacts
  retries: 3
  delay: 5
  until: download_artifacts is succeeded
  ignore_errors: true
- name: Fallback to local artifacts
  block:
    - name: Copy local artifacts
      copy:
        src: "{{ rke2_artifacts_local }}"
        dest: "{{ rke2_artifacts_dir }}"
        mode: 0644
  when: download_artifacts is failed

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local }}"
    dest: "{{ rke2_artifacts_dir }}"
    mode: 0640
  when: airgap_mode

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images directory
      file:
        path: "{{ rke2_additional_images_dir }}"
        state: directory
        mode: 0755
    - name: Copy additional images tarballs
      copy:
        src: "{{ rke2_additional_images_local }}"
        dest: "{{ rke2_additional_images_dir }}"
        mode: 0644
  when: airgap_mode and rke2_additional_images_local

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure artifacts are read-only
      file:
        path: "{{ rke2_artifacts_dir }}"
        state: directory
        mode: 0555
    - name: Ensure install script is executable
      file:
        path: /tmp/rke2-install.sh
        mode: 0700
  when: airgap_mode and rke2_artifacts_exists

- name: Populate service facts
  setup:
    filter: ansible_service_units

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stats

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin
  when: usr_local_stats.stat.exists and usr_local_stats.stat.writable
- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /opt/rke2/bin
  when: not usr_local_stats.stat.exists or not usr_local_stats.stat.writable

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 --version"
  register: rke2_version_output
  ignore_errors: true

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_version_output.rc == 0
      - (rke2_allow_downgrade or (rke2_installed_version is version_compare(rke2_desired_version, '>=') ))
    msg: "RKE2 downgrade not allowed unless explicitly permitted."
  when: rke2_version_output.rc == 0 and rke2_installed_version is defined

- name: Run RKE2 install script
  command: /tmp/rke2-install.sh
  environment:
    RKE2_ARTIFACTS_DIR: "{{ rke2_artifacts_dir }}"
    RKE2_BIN_PATH: "{{ rke2_bin_path }}"
  when: not rke2_installed

- name: Copy Custom Manifests
  template:
    src: custom-manifests.yaml.j2
    dest: "{{ rke2_manifests_dir }}/custom-manifests.yaml"
  when: rke2_custom_manifests is defined

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_local }}"
    dest: "{{ rke2_agent_pod_manifests_dir }}"
    mode: 0644
  when: rke2_static_pods_local is defined

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_environment_file_local }}"
    dest: "/etc/rke2/rke2.yaml"
    mode: 0644
  when: rke2_environment_file_local is defined


