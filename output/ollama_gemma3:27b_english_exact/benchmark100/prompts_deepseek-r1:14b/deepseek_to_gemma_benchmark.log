  when: custom_registry is defined
  copy:
    src: "{{ custom_registry }}"
    dest: /etc/containerd/config.toml
    mode: '0644'
    owner: root
    group: root
  notify: restart containerd

- name: Start RKE2 service on other nodes
  when: inventory_hostname != groups['rke2_master'][0]
  systemd:
    name: rke2-server
    state: started
    enabled: yes
  notify: restart rke2

- name: Mask other RKE2 services on nodes
  systemd:
    name: "{{ 'rke2-agent' if node_type == 'agent' else 'rke2-server' }}"
