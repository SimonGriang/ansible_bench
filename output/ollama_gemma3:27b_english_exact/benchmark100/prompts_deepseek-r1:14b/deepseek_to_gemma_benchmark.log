---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Set SELinux boolean
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
      loop: "{{ selinux_booleans }}"

    - name: Allow httpd connections
      firewalld:
        service: http
        permanent: true
        state: enabled
      when:
        - ansible_facts['distribution'] == "CentOS"
        - ansible_facts['distribution'] == "RedHat"

    - name: Allow https connections
      firewalld:
        service: https
        permanent: true
        state: enabled
      when:
        - ansible_facts['distribution'] == "CentOS"
        - ansible_facts['distribution'] == "RedHat"
  when: ansible_facts['enforcing'] == '1'

- name: Configure httpd
  template:
    src: httpd.conf.j2
    dest: "{{ httpd_config }}"
    mode: 0644
  notify:
    - configtest
    - restart httpd

- name: Activate httpd module | Debian
  command: a2enmod "{{ item }}"
  changed_when: false
  loop: "{{ httpd_modules }}"
  when:
    - ansible_facts['distribution'] == "Debian"
    - ansible_facts['distribution'] == "Ubuntu"

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: httpd_ssl.enabled

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations.defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts.defined

- name: Configure ports
  template:
    src: ports.conf.j2
    dest: "{{ httpd_ports_config }}"
  notify:
    - configtest
    - restart httpd
  when:
    - ansible_facts['distribution'] == "Debian"
    - ansible_facts['distribution'] == "Suse"

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories.defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_default_html }}"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


