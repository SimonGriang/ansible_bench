    notify: mysql server restart

  - name: Configure mysql client
    lineinfile:
      path: /etc/mysql/my.cnf
      line: "socket = /var/run/mysqld/mysqld.sock"
      state: present

  - name: Initialize mysql
    command: "{{ mysql_init_command }}"
    args:
      creates: /var/lib/mysql/mysql.sock
    when: ansible_distribution in ["Alpine", "Archlinux"]

  - name: Start and enable mysql
    service:
      name: "{{ service_name }}"
      state: started
      enabled: yes

  - name: Flush handlers
    meta: flush_handlers

  - name: Place my.cnf
    template:
      src: my.cnf.j2
      dest: /etc/mysql/my.cnf
      mode: '0644'

  - name: Create databases
    mysql_db:
      name: "{{ item }}"
      state: present
    loop: "{{ databases }}"
    when: not initial_import

  - name: List databases
    mysql_db:
      name: "{{ item }}"
      state: present
    loop: "{{ databases }}"
    register: db_check
    ignore_errors: true

  - name: Import database
    command: "mysql -u root -p'{{ mysql_root_password }}' -e \"source {{ initial_import }}/{{ item }}.sql\""
    loop: "{{ databases }}"
    when: not initial_import and db_check.rc != 0

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.priv }}"
      host: "{{ item.host }}"
    loop: "{{ users }}"
    notify: mysql server restart

  - name: Flush handlers again
    meta: flush_handlers


