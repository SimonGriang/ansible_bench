  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: index-url
    value: "{{ python_pip_proxy }}"
    create: true
  when: python_pip_proxy is defined

- name: Trust hosts
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ python_pip_trusted_host }}"
    create: true
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
  when: python_pip_update is true and ansible_distribution != "Debian" and \
        ansible_distribution != "Ubuntu" and ansible_distribution != "Alpine"

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: present
    label: "{{ item.name }}"
  loop: "{{ python_pip_modules }}"
  when: ansible_distribution != "Debian" and ansible_distribution != "Ubuntu" and \
        ansible_distribution != "Alpine"


