---
- name: Create local SSH key directory for user
  file:
    path: "{{ ssh_key_dir }}"
    state: directory
    owner: "{{ user_name }}"
    mode: '0750'

- name: Manage user account
  user:
    name: "{{ user_name }}"
    state: "{{ user_state }}"
    comment: "{{ user_comment }}"
    home: "{{ user_home }}"
    shell: "{{ user_shell }}"
    createhome: yes

- name: Set sudo options for user
  copy:
    dest: "/etc/sudoers.d/{{ user_name }}"
    content: "{{ sudo_content }}"
    owner: root
    group: root
    mode: '0440'
  when: sudo_content is defined

- name: Generate private SSH key for user
  command: "ssh-keygen -t rsa -N '' -f {{ ssh_private_key_path }}"
  args:
    creates: "{{ ssh_private_key_path }}"

- name: Generate public SSH key for user
  command: "ssh-keygen -y -f {{ ssh_private_key_path }} > {{ ssh_public_key_path }}"
  args:
    creates: "{{ ssh_public_key_path }}"

- name: Convert SSH key to ppk format for user
  command: "puttygen {{ ssh_private_key_path }} -O private-ppk -o {{ ssh_ppk_key_path }}"
  args:
    creates: "{{ ssh_ppk_key_path }}"
  when: create_ppk

- name: Get or set the home directory for user
  set_fact:
    user_home: "{{ user_home | default('/home/' + user_name) }}"

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    owner: "{{ user_name }}"
    mode: '0700'

- name: Deploy authorized keys for user
  copy:
    dest: "{{ user_home }}/.ssh/authorized_keys"
    content: "{{ authorized_keys_content }}"
    owner: "{{ user_name }}"
    mode: '0600'

- name: Remove unauthorized keys for user
  lineinfile:
    path: "{{ user_home }}/.ssh/authorized_keys"
    regexp: "{{ unauthorized_key_regexp }}"
    state: absent

- name: Copy generated private SSH key for user
  copy:
    src: "{{ ssh_private_key_path }}"
    dest: "{{ user_home }}/{{ ssh_private_key_name }}"
    owner: "{{ user_name }}"
    mode: '0600'

- name: Check users password valid time for user
  shell: "chage -l {{ user_name }} | grep 'Password expires'"
  register: password_expiry
  ignore_errors: true

- name: Set users password valid time for user
  user:
    name: "{{ user_name }}"
    password_expires: "{{ password_expiry_days }}"
  when: password_expiry_days is defined

- name: Place private key file for user
  copy:
    src: "{{ ssh_private_key_path }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    owner: "{{ user_name }}"
    mode: '0600'


