---

- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: bootstrap_connection_type == 'tcp'

- name: Prepare system
  block:
    - name: Test connection
      ping:
    - name: Test sudo access
      command: sudo -n true
      register: sudo_test
      ignore_errors: true
    - name: Gather facts and install packages (if connection/sudo fails)
      block:
        - name: Gather facts
          setup:
        - name: Install necessary packages (RedHat)
          package:
            name: libdnf5
            state: present
          when: ansible_os_family == "RedHat"
          become: true
      when: sudo_test.rc != 0
  become: true

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"


