---
- name: Restart RKE2 service on {{ rke2_node_name}}
  service:
    name: rke2-server
    state: restarted
  notify: "Service (re)started"

- name: Wait for all nodes to be ready again
  command: kubectl get nodes -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}'
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  retries: 100
  delay: 15
  register: node_status
  until: node_status.stdout == "True\nTrue\nTrue\nTrue\nTrue\n"
  when: ansible_check_mode == false

- name: Wait for all pods to be ready again
  command: kubectl get pods --all-namespaces -o jsonpath='{range .items[*]}{.status.phase}{"\n"}{end}'
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  retries: 100
  delay: 15
  register: pod_status
  until: pod_status.stdout == "Running\nRunning\nRunning\nRunning\nRunning\nRunning\nRunning\nRunning\n"
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready


