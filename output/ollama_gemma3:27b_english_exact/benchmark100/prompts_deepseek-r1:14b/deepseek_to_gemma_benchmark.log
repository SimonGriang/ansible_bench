---

- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install git
  package:
    name: git
    state: present

- name: Check if user exists
  command: id -u "{{ ansible_user }}"
  register: user_check
  ignore_errors: true

- name: Create git config directory
  file:
    path: "/home/{{ ansible_user }}/.gitconfig"
    state: directory
    mode: '0700'
    owner: "{{ ansible_user }}"
    group: "{{ ansible_user }}"

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ ansible_user }}/.gitconfig"
    mode: '0600'
    owner: "{{ ansible_user }}"
    group: "{{ ansible_user }}"

- name: Create repository destination
  file:
    path: "/home/{{ ansible_user }}/repositories"
    state: directory
    mode: '0755'
    owner: "{{ ansible_user }}"
    group: "{{ ansible_user }}"

- name: Clone all repositories
  git:
    repo: "{{ item.repo }}"
    dest: "/home/{{ ansible_user }}/repositories/{{ item.name }}"
    version: "{{ item.version }}"
    owner: "{{ ansible_user }}"
    group: "{{ ansible_user }}"
  loop:
    - name: repo1
      repo: https://github.com/example/repo1.git
      version: main
    - name: repo2
      repo: https://github.com/example/repo2.git
      version: develop
    - name: repo3
      repo: https://github.com/example/repo3.git
      version: release


