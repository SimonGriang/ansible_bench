content='```yaml\n---\n- name: Create /etc/openvpn/easy-rsa directory with correct permissions\n  file:\n    path: /etc/openvpn/easy-rsa\n    state: directory\n    mode: 0755\n\n- name: Initialize OpenVPN PKI structure\n  command: /usr/sbin/easyrsa init-pki\n  args:\n    creates: /etc/openvpn/easy-rsa/pki\n\n- name: Generate OpenVPN CA certificate\n  command: /usr/sbin/easyrsa build-ca nopass\n  environment:\n    EASYRSA_BATCH: "yes"\n\n- name: Generate Diffie-Hellman parameters\n  command: /usr/sbin/easyrsa gen-dh\n  environment:\n    EASYRSA_BATCH: "yes"\n\n- name: Generate server certificate\n  command: /usr/sbin/easyrsa build-server-full nopass\n  environment:\n    EASYRSA_BATCH: "yes"\n\n- name: Generate client certificate\n  command: /usr/sbin/easyrsa build-client-full nopass\n  environment:\n    EASYRSA_BATCH: "yes"\n\n- name: Generate Certificate Revocation List\n  command: /usr/sbin/easyrsa gen-crl\n  environment:\n    EASYRSA_BATCH: "yes"\n\n- name: Generate OpenVPN TA key\n  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key\n  args:\n    creates: /etc/openvpn/easy-rsa/pki/ta.key\n\n- name: Copy PKI files to /etc/openvpn/server directory\n  copy:\n    src: /etc/openvpn/easy-rsa/pki/{ca.crt,dh.pem,issued/{server.crt,server.key}}\n    dest: /etc/openvpn/server/\n    mode: 0640\n\n- name: Copy additional PKI files to /etc/openvpn directory\n  copy:\n    src: /etc/openvpn/easy-rsa/pki/ca.crt\n    dest: /etc/openvpn/\n    mode: 0640\n\n- name: Place OpenVPN server configuration file\n  template:\n    src: server.conf.j2\n    dest: /etc/openvpn/server.conf\n    owner: root\n    group: root\n    mode: 0644\n  notify: restart openvpn\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-19T20:53:38.765925894Z', 'done': True, 'done_reason': 'stop', 'total_duration': 35999392428, 'load_duration': 226078002, 'prompt_eval_count': 1348, 'prompt_eval_duration': 4337303278, 'eval_count': 565, 'eval_duration': 31435100710, 'model_name': 'gemma3:27b'} id='run--e90d0a72-09d4-422c-b118-50692f76f852-0' usage_metadata={'input_tokens': 1348, 'output_tokens': 565, 'total_tokens': 1913}
