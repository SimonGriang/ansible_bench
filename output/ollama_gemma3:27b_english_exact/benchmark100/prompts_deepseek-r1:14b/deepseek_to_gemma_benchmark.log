---
- name: Install unzip package
  package:
    name: unzip
    state: present

- name: Create system group for promtail
  group:
    name: promtail
    state: present
    system: yes

- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    system: yes
    createhome: false
    shell: /sbin/nologin

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  file:
    path: "{{ promtail_config_dir }}"
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'

- name: Create application directories
  file:
    path: "{{ promtail_app_dir }}"
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'

- name: Check promtail binary existence
  stat:
    path: "{{ promtail_binary_path }}"
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_distribution_url }}"
    dest: /tmp/promtail.zip
    validate_certs: yes
  when: not promtail_binary.stat.exists

- name: Propagate local promtail binaries
  copy:
    src: /tmp/promtail.zip
    dest: "{{ promtail_app_dir }}/promtail.zip"
    owner: promtail
    group: promtail
    mode: '0644'
  when: not promtail_binary.stat.exists

- name: Download promtail binaries for controller node
  get_url:
    url: "{{ promtail_distribution_url }}"
    dest: /tmp/promtail.zip
    validate_certs: yes
  delegate_to: localhost
  when: inventory_hostname == groups['controller'][0]

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail.zip
    dest: "{{ promtail_app_dir }}/promtail.zip"
    owner: promtail
    group: promtail
    mode: '0644'
  delegate_to: localhost
  when: not promtail_binary.stat.exists

- name: Unpack promtail binaries
  unarchive:
    src: "{{ promtail_app_dir }}/promtail.zip"
    dest: "{{ promtail_app_dir }}"
    remote_src: yes
    owner: promtail
    group: promtail

- name: Create symlink to latest promtail version
  file:
    src: "{{ promtail_app_dir }}/promtail"
    dest: "{{ promtail_binary_path }}"
    state: link
    force: yes
  notify: restart promtail

- name: Write promtail config file
  template:
    src: promtail.conf.j2
    dest: "{{ promtail_config_file }}"
    owner: promtail
    group: promtail
    mode: '0644'
  notify: restart promtail

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: restart promtail


