---
- name: Create the RKE2 config directory
  file:
    path: /etc/rke2/
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server taints
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: Pod
      metadata:
        name: rke2-taint-check
        labels:
          node-role.kubernetes.io/server: ""
      spec:
        containers:
        - name: rke2-taint-check
          image: busybox
          command: ["/bin/sh", "-c", "sleep 3600"]
        nodeSelector:
          node-role.kubernetes.io/server: ""
  when: ansible_node_role == 'server'

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_file }}"
    dest: /etc/rke2/config.yaml
    mode: '0644'
    owner: root
    group: root
  notify:
    - restart rke2

- name: Copy kubelet configuration file
  copy:
    src: "{{ rke2_kubelet_config }}"
    dest: /etc/rke2/kubelet.yaml
    mode: '0644'
    owner: root
    group: root
  when: rke2_kubelet_config is defined and rke2_kubelet_config != ""
  notify:
    - restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_config }}"
    dest: /etc/rke2/containerd/config.toml
    mode: '0644'
    owner: root
    group: root
  when: rke2_containerd_config is defined and rke2_containerd_config != ""
  notify:
    - restart rke2

- name: Register etcd restore from file
  set_fact:
    etcd_restore_from_file: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != '' and ansible_service_mgr == 'systemd' and ansible_facts.service_status.rke2.active == 'inactive' }}"

- name: Register etcd restore from S3
  set_fact:
    etcd_restore_from_s3: "{{ rke2_etcd_s3_bucket is defined and rke2_etcd_s3_bucket != '' and rke2_etcd_s3_prefix is defined and rke2_etcd_s3_prefix != '' and ansible_service_mgr == 'systemd' and ansible_facts.service_status.rke2.active == 'inactive' }}"

- name: Restore etcd from file
  block:
    - name: Create etcd restore directory
      file:
        path: /var/lib/rke2/etcd/snapshot
        state: directory
        mode: '0755'
        owner: root
        group: root

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rke2/etcd/snapshot/snapshot.db
        mode: '0644'
        owner: root
        group: root

    - name: Restore etcd from file
      command: rke2 etcd-snapshot restore
      changed_when: true
  when: etcd_restore_from_file

- name: Restore etcd from S3
  block:
    - name: Restore etcd from S3
      command: rke2 etcd-snapshot restore --s3-bucket {{ rke2_etcd_s3_bucket }} --s3-prefix {{ rke2_etcd_s3_prefix }}
      changed_when: true
  when: etcd_restore_from_s3

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    env:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify:
    - restart rke2

- name: Mask RKE2 agent service
  systemd:
    name: rke2-agent
    state: stopped
    masked: yes

- name: Wait for first server to be ready (no CNI)
  wait_for:
    host: localhost
    port: 6443
    timeout: 600
  when: rke2_cni_plugin is not defined or rke2_cni_plugin == ""

- name: Wait for first server to be ready (with CNI)
  wait_for:
    host: localhost
    port: 6443
    timeout: 600
  when: rke2_cni_plugin is defined and rke2_cni_plugin != ""

- name: Restore etcd
  block:
    - name: Clean up old nodes and secrets
      command: rke2 etcd-snapshot cleanup
      changed_when: true
  when: etcd_restore_from_file or etcd_restore_from_s3

- name: Set Active Server variable
  set_fact:
    active_server: "{{ ansible_hostname }}"
  delegate_to: localhost
  run_once: true


