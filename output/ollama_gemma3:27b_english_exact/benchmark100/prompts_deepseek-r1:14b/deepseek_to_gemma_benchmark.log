---
- name: Migrate adoptopenjdk to temurin
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Gather OS specific variables
  include_vars: "vars/{{ java_jdk_vendor }}_{{ ansible_os_family }}_{{ ansible_distribution_version }}.yml"

- name: Gather architecture specific variables
  include_vars: "vars/{{ ansible_architecture }}.yml"

- name: Set OS specific variables (I)
  set_fact:
    openjdk_version: "{{ openjdk_version | default('11') }}"
    openjdk_repo: "{{ openjdk_repo | default('') }}"
    openjdk_libs: "{{ openjdk_libs | default('') }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    openjdk_install_path: "{{ openjdk_install_path | default('/usr/lib/jvm') }}"
    openjdk_package_name: "{{ openjdk_package_name | default('openjdk-11-jre') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ openjdk_install_path }}/{{ openjdk_package_name }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "deb http://ppa.launchpad.net/webupd8/java/ubuntu {{ ansible_distribution_release }} main"
        state: absent
      when: ansible_os_family == 'Debian'

    - name: Install extra apt tools
      apt:
        name:
          - software-properties-common
        state: present
      when: ansible_os_family == 'Debian'

    - name: Add key repositories
      apt_key:
        url: https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x46181433FBB75451
        state: present
      when: ansible_os_family == 'Debian'

    - name: Add required repositories
      apt_repository:
        repo: "deb http://ppa.launchpad.net/openjdk-ppa/ppa/ubuntu {{ ansible_distribution_release }} main"
        state: present
      when: ansible_os_family == 'Debian'
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: https://download.opensuse.org/repositories/devel:/java:/openjdk/RPM-GPG-KEY
        state: present
      when: ansible_os_family == 'RedHat'

    - name: Add required repositories
      yum_repository:
        name: openjdk
        description: OpenJDK Repository
        baseurl: https://download.opensuse.org/repositories/devel:/java:/openjdk/
        gpgcheck: yes
        gpgkey: https://download.opensuse.org/repositories/devel:/java:/openjdk/RPM-GPG-KEY
        enabled: yes
      when: ansible_os_family == 'RedHat'
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  apt:
    name: "{{ openjdk_libs | split(',') }}"
    state: present
  when: ansible_os_family == 'Debian'

- name: Install required libs
  yum:
    name: "{{ openjdk_libs | split(',') }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Install Java, Debian
  apt:
    name: "{{ openjdk_package_name }}"
    state: present
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ openjdk_package_name }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  copy:
    dest: /etc/profile.d/java.sh
    content: |
      export JAVA_HOME={{ java_home }}
      export PATH=$JAVA_HOME/bin:$PATH
    mode: 0755

- name: Source environment variables
  shell: source /etc/profile.d/java.sh
  args:
    executable: /bin/bash

- name: Correct java version selected for Java < 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    priority: 100
  when: openjdk_version | version_compare('<', '11')

- name: Correct java version selected for Java >= 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    priority: 100
  when: openjdk_version | version_compare('>=', '11')


