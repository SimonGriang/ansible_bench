\n  meta: flush_handlers\n\n- name: Removing default html\n  file:\n    path: "{{ httpd_default_html }}"\n    state: absent\n  when: httpd_remove_example\n\n- name: Start and enable httpd\n  service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-19T21:51:29.578463072Z', 'done': True, 'done_reason': 'stop', 'total_duration': 52771665746, 'load_duration': 187640849, 'prompt_eval_count': 5399, 'prompt_eval_duration': 16193174599, 'eval_count': 652, 'eval_duration': 36389168130, 'model_name': 'gemma3:27b'} id='run--9e3ca7dc-a5f5-487d-9511-5b121a6d820b-0' usage_metadata={'input_tokens': 5399, 'output_tokens': 652, 'total_tokens': 6051}
