---
  - name: Include OS-specific variables
    include_vars:
      file: "vars/{{ ansible_distribution }}.yml"
      name: os_vars
    ignore_errors: true

  - name: Include OS family specific tasks
    include_tasks: "os_family_{{ ansible_os_family }}.yml"
    ignore_errors: true

  - name: Install Docker packages
    package:
      name: "{{ docker_packages }}"
      state: "{{ docker_packages_state }}"
    notify: restart docker
    ignore_errors: true
    when: ansible_version.major < 2 and (ansible_os_family != 'RedHat' and ansible_os_family != 'Debian') or \
          (ansible_os_family == 'RedHat' or ansible_os_family == 'Debian') and ansible_version.major < 2

  - name: Install Docker packages with downgrade option
    package:
      name: "{{ docker_packages }}"
      state: "{{ docker_packages_state }}"
    notify: restart docker
    ignore_errors: true
    when: ansible_version.major >= 2 and (ansible_os_family == 'RedHat' or ansible_os_family == 'Debian')

  - name: Install docker-compose plugin
    package:
      name: "{{ docker_compose_package }}"
      state: "{{ docker_compose_package_state }}"
    notify: restart docker
    ignore_errors: true
    when: docker_install_compose_plugin and (ansible_version.major < 2 and \
          (ansible_os_family != 'RedHat' and ansible_os_family != 'Debian')) or \
          (ansible_os_family == 'RedHat' or ansible_os_family == 'Debian') and ansible_version.major < 2

  - name: Install docker-compose-plugin with downgrade option
    package:
      name: "{{ docker_compose_package }}"
      state: "{{ docker_compose_package_state }}"
    notify: restart docker
    ignore_errors: true
    when: docker_install_compose_plugin and ansible_version.major >= 2 and \
          (ansible_os_family == 'RedHat' or ansible_os_family == 'Debian')

  - name: Ensure /etc/docker directory exists
    file:
      path: /etc/docker
      mode: 0755
      state: directory
    when: docker_daemon_options is defined and docker_daemon_options

  - name: Configure Docker daemon options
    copy:
      dest: /etc/docker/daemon.json
      content: "{{ docker_daemon_options | to_json }}"
    notify: restart docker
    when: docker_daemon_options is defined and docker_daemon_options

  - name: Ensure Docker service is started and enabled
    service:
      name: docker
      state: "{{ docker_service_state }}"
      enabled: "{{ docker_service_enabled }}"
    ignore_errors: true
    when: docker_service_manage

  - name: Flush handlers to avoid firewall conflicts
    meta: flush_handlers

  - name: Include docker-compose.yml tasks
    include_tasks: docker-compose.yml
    when: docker_install_compose

  - name: Get docker group information
    command: getent group docker
    register: docker_group_info
    changed_when: false
    when: docker_users is defined and docker_users

  - name: Set fact for user modification
    set_fact:
      docker_group_needs_modification: true
    when: docker_users is defined and docker_users and docker_group_info.stdout.find(user) == -1

  - name: Include docker-users.yml tasks
    include_tasks: docker-users.yml
    when: docker_users is defined and docker_users and docker_group_needs_modification


