---
- name: Install Keepalived when HA mode is enabled
  include_tasks: keepalived.yml
  when: ha_enabled

- name: Download and install RKE2
  include_tasks: rke2_install.yml

- name: Perform CIS hardening when a CIS profile is defined
  include_tasks: cis_hardening.yml
  when: cis_profile_defined

- name: Find and identify the active server in the cluster
  include_tasks: find_active_server.yml

- name: Enable IPVS kernel module
  include_tasks: enable_ipvs.yml
  when: ha_enabled and ipvs_enabled

- name: Copy kube-vip manifests to the master node
  include_tasks: copy_kube_vip_manifests.yml
  when: ha_enabled and kube_vip_enabled

- name: Copy ingress-nginx manifests to the master node
  include_tasks: copy_ingress_nginx_manifests.yml
  when: ingress_nginx_values_defined

- name: Prepare the first server node
  include_tasks: prepare_first_server.yml
  when: is_first_server

- name: Perform etcd restore tasks
  include_tasks: etcd_restore.yml
  when: etcd_restore_required

- name: Download the kubeconfig file to the Ansible localhost
  include_tasks: download_kubeconfig.yml
  when: download_kubeconfig_enabled

- name: Prepare and join remaining cluster nodes
  include_tasks: join_remaining_nodes.yml
  when: active_server_defined

- name: Perform rolling restart of servers
  include_tasks: rolling_restart_servers.yml
  when: version_changes

- name: Perform rolling restart of agents
  include_tasks: rolling_restart_agents.yml
  when: version_changes

- name: Flush handlers
  meta: flush_handlers

- name: Perform rolling restart when config changes
  include_tasks: rolling_restart_config_changes.yml
  when: config_changes_detected

- name: Perform final steps
  include_tasks: final_steps.yml


