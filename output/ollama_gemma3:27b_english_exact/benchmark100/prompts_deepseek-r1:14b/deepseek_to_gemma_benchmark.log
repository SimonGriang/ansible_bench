---

  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost

  - name: Configure apk
    apk:
      update_cache: yes
      upgrade: yes
    register: apk_result
    ignore_errors: yes
    changed_when: false

  - name: Configure apt
    apt:
      upgrade: dist
      autoremove: yes
      autoclean: yes
      hold:
        - kernel*
    become: yes

  - name: Update all software (dnf)
    dnf:
      name: '*'
      state: latest
      exclude:
        - kernel*
        - grub*
    become: yes

  - name: Update all software (pacman)
    pacman:
      update_cache: yes
      upgrade: yes

  - name: Configure yum
    block:
      - name: Check OS version
        setup:
        register: ansible_facts

      - name: Update all software (dnf)
        dnf:
          name: '*'
          state: latest
        when: ansible_facts.distribution == "CentOS" or ansible_facts.distribution == "RedHat" and ansible_facts.distribution_version | int >= 7
        become: yes

      - name: Update all software (yum)
        yum:
          name: '*'
          state: latest
        when: ansible_facts.distribution == "CentOS" or ansible_facts.distribution == "RedHat" and ansible_facts.distribution_version | int < 7
        become: yes

      - name: Install yum-utils
        yum:
          name: yum-utils
          state: present
        when: ansible_facts.distribution == "CentOS" or ansible_facts.distribution == "RedHat" and ansible_facts.distribution_version | int < 7
        become: yes
    become: yes

  - name: Update all software (zypper)
    zypper:
      name: '*'
      state: latest
      update_cache: yes


