    when: dns_caching_dns

  - name: Create zone file
    template:
      src: "zone.j2"
      dest: "{{ dns_data_dir }}/{{ item }}.db"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: '0644'
    loop: "{{ dns_zones }}"
    notify: Rndc reload

  - name: Add zones to configuration
    template:
      src: "named.conf.j2"
      dest: "{{ dns_conf_dir }}/named.conf"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
