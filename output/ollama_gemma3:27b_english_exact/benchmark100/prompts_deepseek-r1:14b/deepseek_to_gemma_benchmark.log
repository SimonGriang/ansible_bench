---

- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install using package
  block:
    - name: Install using apt (Debian/Ubuntu)
      apt:
        name: "{{ hashicorp_package }}"
        state: present
      when: ansible_os_family == "Debian"

    - name: Install using yum (RedHat/CentOS)
      yum:
        name: "{{ hashicorp_package }}"
        state: present
      when: ansible_os_family == "RedHat"

    - name: Install using dnf (Fedora)
      dnf:
        name: "{{ hashicorp_package }}"
        state: present
      when: ansible_os_family == "Fedora"
  become: true

- name: Configure debian
  block:
    - name: Add GPG key
      apt_key:
        url: "{{ hashicorp_gpg_key }}"
        state: present
      become: true

    - name: Add apt repository
      apt_repository:
        repo: "{{ hashicorp_apt_repo }}"
        state: present
        filename: hashicorp
      become: true
      when: ansible_os_family == "Debian"

- name: Install hashicorp product using package
  block:
    - name: Install latest version
      package:
        name: "{{ hashicorp_package }}"
        state: latest
      become: true
      when: hashicorp_version is not defined

