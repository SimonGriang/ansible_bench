    group:
      name: "{{ dns_group }}"
      state: present

  - name: Create user
    user:
      name: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      system: true
      state: present

  - name: Generate rndc key
    command:
      cmd: "rndc-confgen -a -k rndc.key -n"
    args:
      creates: "{{ dns_conf_dir }}/rndc.key"

