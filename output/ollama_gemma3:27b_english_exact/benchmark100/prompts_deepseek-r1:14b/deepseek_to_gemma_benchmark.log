---

- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost

- name: Install git
  ansible.builtin.package:
    name: git
    state: present

- name: Check if user exists
  ansible.builtin.command: id -u "{{ ansible_user }}"
  register: user_check
  ignore_errors: true
  changed_when: false

- name: Create git config directory
  ansible.builtin.file:
    path: "/home/{{ ansible_user }}/.gitconfig"
    state: directory
    mode: '0700'
    owner: "{{ ansible_user }}"
    group: "{{ ansible_user }}"

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "/home/{{ ansible_user }}/.gitconfig"
    mode: '0600'
    owner: "{{ ansible_user }}"
    group: "{{ ansible_user }}"

- name: Create repository destination
  ansible.builtin.file:
    path: "/home/{{ ansible_user }}/repositories"
    state: directory
    mode: '0755'
    owner: "{{ ansible_user }}"
    group: "{{ ansible_user }}"

- name: Clone all repositories
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "/home/{{ ansible_user }}/repositories/{{ item.name }}"
    version: "{{ item.version }}"
    owner: "{{ ansible_user }}"
    group: "{{ ansible_user }}"
  loop:
    - name: repo1
      repo: https://github.com/example/repo1.git
      version: main
    - name: repo2
      repo: https://github.com/example/repo2.git
      version: develop
    - name: repo3
      repo: https://github.com/example/repo3.git
      version: release


