content='```yaml\n---\n\n- name: Check if Java certificates exist\n  stat:\n    path: "{{ item }}"\n  register: java_cert_status\n  with_items: "{{ java_certs }}"\n\n- name: Fail if Java certificates are missing\n  fail:\n    msg: "Java certificate missing at path: {{ item.item }}"\n  when: item.stat.exists == false\n  with_items: "{{ java_cert_status.results }}"\n\n- name: Set keystore directory for Java versions less than 11\n  set_fact:\n    java_keystore_dir: "/opt/java/legacy_keystore"\n  when: java_version < 11\n\n- name: Set keystore directory for Java versions 11 or newer\n  set_fact:\n    java_keystore_dir: "/opt/java/new_keystore"\n  when: java_version >= 11\n\n- name: Import SSL certificates into Java keystore\n  command: "keytool -importcert -alias {{ item.alias }} -file {{ item.path }} -keystore {{ java_keystore_dir }}/keystore.jks -storepass {{ keystore_password }}"\n  with_items: "{{ ssl_certs }}"\n  args:\n    creates: "{{ java_keystore_dir }}/keystore.jks"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-19T22:08:40.64769273Z', 'done': True, 'done_reason': 'stop', 'total_duration': 18264260232, 'load_duration': 199129748, 'prompt_eval_count': 484, 'prompt_eval_duration': 1725801904, 'eval_count': 302, 'eval_duration': 16338822410, 'model_name': 'gemma3:27b'} id='run--0dd74e59-2754-48da-99b6-b0e50b0f8ae0-0' usage_metadata={'input_tokens': 484, 'output_tokens': 302, 'total_tokens': 786}
