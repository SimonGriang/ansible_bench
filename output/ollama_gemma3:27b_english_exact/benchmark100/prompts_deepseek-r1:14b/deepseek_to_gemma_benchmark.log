---

  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install required packages
    package:
      name: "{{ selinux_requirements }}"
      state: present
    notify: Gather facts

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure selinux
    when: selinux_status is defined and connection != 'container' and connection != 'docker' and connection != 'community.docker.docker'
    block:
      - name: Manage SELinux settings
        selinux:
          state: "{{ selinux_state }}"
          policy: "{{ selinux_policy }}"
        notify: Reboot

      - name: Manage SELinux booleans
        when: selinux_booleans is defined
        with_items: "{{ selinux_booleans }}"
        selinux:
          name: "{{ item }}"
          state: yes
          persistent: true


