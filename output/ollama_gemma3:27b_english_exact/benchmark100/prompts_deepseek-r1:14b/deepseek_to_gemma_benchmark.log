ser_name }}"\n    mode: \'0600\'\n\n- name: Check users password valid time for user\n  shell: "chage -l {{ user_name }} | grep \'Password expires\'"\n  register: password_expiry\n  ignore_errors: true\n\n- name: Set users password valid time for user\n  user:\n    name: "{{ user_name }}"\n    password_expires: "{{ password_expiry_days }}"\n  when: password_expiry_days is defined\n\n- name: Place private key file for user\n  copy:\n    src: "{{ ssh_private_key_path }}"\n    dest: "{{ user_home }}/.ssh/id_rsa"\n    owner: "{{ user_name }}"\n    mode: \'0600\'\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-19T21:36:59.956424879Z', 'done': True, 'done_reason': 'stop', 'total_duration': 47442864145, 'load_duration': 202515187, 'prompt_eval_count': 770, 'prompt_eval_duration': 2493698750, 'eval_count': 791, 'eval_duration': 44745440893, 'model_name': 'gemma3:27b'} id='run--fa38d0e1-f870-41b7-8c98-07d238108a2e-0' usage_metadata={'input_tokens': 770, 'output_tokens': 791, 'total_tokens': 1561}
