re it is not masked\n    systemd:\n      name: keepalived\n      enabled: yes\n      masked: no\n    become: yes\n    notify: restart keepalived\n\n  - name: Flush handlers\n    meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-19T22:51:41.865803066Z', 'done': True, 'done_reason': 'stop', 'total_duration': 38143548005, 'load_duration': 200697802, 'prompt_eval_count': 649, 'prompt_eval_duration': 2023937501, 'eval_count': 674, 'eval_duration': 35917749836, 'model_name': 'gemma3:27b'} id='run--fb9bd1eb-add2-482b-a54b-3deb896560b0-0' usage_metadata={'input_tokens': 649, 'output_tokens': 674, 'total_tokens': 1323}
