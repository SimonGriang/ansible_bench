': True, 'done_reason': 'stop', 'total_duration': 77361593170, 'load_duration': 183305738, 'prompt_eval_count': 2401, 'prompt_eval_duration': 8094572172, 'eval_count': 1285, 'eval_duration': 69082240370, 'model_name': 'gemma3:27b'} id='run--da000a43-b98e-492c-8c6b-cfde2153b951-0' usage_metadata={'input_tokens': 2401, 'output_tokens': 1285, 'total_tokens': 3686}
