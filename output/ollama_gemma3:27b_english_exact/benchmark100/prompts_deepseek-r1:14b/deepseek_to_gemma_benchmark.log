---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  apt:
    update_cache: yes
    cache_valid_time: 3600
  when: ansible_os_family == "Debian"

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: virtual_mailbox_mappings or virtual_domains_mysql

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
  notify:
    - validate postfix transport_maps
    - rebuild postfix database

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - validate postfix header_checks
    - reload postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_recipient_restrictions: "{{ postfix_recipient_restrictions | default([]) + ['permit_mynetworks', 'permit_sasl_authenticated', 'reject_unauth_destination'] }}"
    postfix_sender_restrictions: "{{ postfix_sender_restrictions | default([]) + ['permit_mynetworks', 'reject_unauth_destination'] }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_mynetworks: "{{ postfix_mynetworks | default([]) }}"
    postfix_mydestination: "{{ postfix_mydestination | default([]) }}"
    postfix_relay_domains: "{{ postfix_relay_domains | default([]) }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - validate postfix main.cf
    - restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - validate postfix master.cf
    - restart postfix

- name: Creates cert/key directory
  file:
    path: "{{ postfix_tls_key_dir }}"
    state: directory
    mode: '0750'
    owner: root
    group: root

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_cert_file }}"
    dest: "{{ postfix_tls_cert_file }}"
    owner: root
    group: root
    mode: '0644'
  notify:
    - reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_file }}"
    dest: "{{ postfix_tls_key_file }}"
    owner: root
    group: root
    mode: '0600'
  notify:
    - reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: "{{ item }}"
    state: present
  with_items: "{{ postfix_aliases }}"
  notify:
    - rebuild postfix alias database
    - reload postfix

- name: Configure sender_access
  copy:
    dest: /etc/postfix/sender_access
    content: "{{ postfix_sender_access_content }}"
  notify:
    - rebuild postfix sender_access database
    - reload postfix

- name: Configure recipient_access
  copy:
    dest: /etc/postfix/recipient_access
    content: "{{ postfix_recipient_access_content }}"
  notify:
    - validate postfix recipient_access
    - rebuild postfix recipient_access database
    - reload postfix

- name: Place sasl_password_map
  copy:
    dest: /etc/postfix/sasl_password_map
    content: "{{ postfix_sasl_password_map_content }}"
  notify:
    - rebuild postfix sasl_password_map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes


