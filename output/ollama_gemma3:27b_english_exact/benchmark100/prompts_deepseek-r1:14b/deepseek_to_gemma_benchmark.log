---

- name: Import assertion file
  assert:
    path: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install system requirements
  package:
    name: bash
    state: present

- name: Install OpenJDK Java
  package:
    name: default-jdk
    state: present
  when: java_vendor == "openjdk"

- name: Copy and install Oracle Java RPM from local
  copy:
    src: "{{ java_source_file }}"
    dest: /tmp/{{ java_source_file }}
  when: java_source == "local" and java_format == "rpm"
  
- name: Install Oracle Java RPM from local
  package:
    name: /tmp/{{ java_source_file }}
    state: present
  when: java_source == "local" and java_format == "rpm"

- name: Copy and install Oracle Java DEB from local
  copy:
    src: "{{ java_source_file }}"
    dest: /tmp/{{ java_source_file }}
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java DEB from local
  package:
    name: /tmp/{{ java_source_file }}
    state: present
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java RPM from repository
  package:
    name: java-{{ java_version }}-oracle
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Java targz installation
  unarchive:
    src: "{{ java_source_file }}"
    dest: /opt
    remote_src: yes
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java JCE policy
  copy:
    src: jce_policy
    dest: /usr/java/{{ java_version }}/lib/security/
  when: java_jce is defined and java_version == 8 and java_vendor == "oracle"

- name: Set Java alternative
  alternatives:
    name: java
    path: /opt/java/{{ java_version }}/bin/java
  when: java_format == "targz" and ansible_distribution != "Alpine"

- name: Find Java home directory
  stat:
    path: /usr/bin/java
  register: java_path

- name: Set JAVA_HOME in environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: export JAVA_HOME={{ java_path.stat.dirname }}/..
    create: yes


