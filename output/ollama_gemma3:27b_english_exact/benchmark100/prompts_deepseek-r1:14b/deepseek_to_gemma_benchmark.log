---
- name: Import assertion file
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell
  lineinfile:
    path: /etc/cron.d/00_custom
    line: "SHELL=/bin/bash"
    create: yes
  notify: restart cron

- name: Configure cron path
  lineinfile:
    path: /etc/cron.d/00_custom
    line: "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    create: yes
  notify: restart cron

- name: Configure cron mailto
  lineinfile:
    path: /etc/cron.d/00_custom
    line: "MAILTO={{ cron_mailto }}"
    create: yes
  notify: restart cron

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined and cron_service == true

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    user: "{{ item.user }}"
    job: "{{ item.job }}"
    state: present
  loop: "{{ cron_jobs }}"


