      cmd: "rndc-confgen -a -k rndc.key -n"
    args:
      creates: "{{ dns_conf_dir }}/rndc.key"

  - name: Set permissions on rndc key file
    file:
      path: "{{ dns_conf_dir }}/rndc.key"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: '0640'

  - name: Get the hints/root file
    get_url:
      url: "https://raw.githubusercontent.com/robnelson/dns-root-hints/master/root.hints"
      dest: "{{ dns_data_dir }}/root.hints"
      mode: '0644'
    when: dns_caching_dns

  - name: Create zone file
    template:
      src: "zone.j2"
      dest: "{{ dns_data_dir }}/{{ item }}.db"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: '0644'
    loop: "{{ dns_zones }}"
    notify: Rndc reload

  - name: Add zones to configuration
    template:
      src: "named.conf.j2"
      dest: "{{ dns_conf_dir }}/named.conf"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: '0644'
    notify: Restart dns

  - name: Place systemd override
    template:
      src: "named.conf.override.j2"
      dest: "/etc/systemd/system/named.conf.d/override.conf"
      owner: root
      group: root
      mode: '0644'
    when: use_systemd
    notify: Reload systemd

  - name: Start and enable dns
    service:
      name: named
      state: started
      enabled: true


