---

- name: Create the RKE2 configuration directory
  file:
    path: /etc/rke2/
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server taints
  when: node_type == 'server'
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: Pod
      metadata:
        name: rke2-taint-server
        namespace: kube-system
        labels:
          node-role.kubernetes.io/server: ""
      spec:
        containers:
        - name: rke2-taint
          image: busybox
          command: ["sleep", "3600"]
          resources:
            requests:
              cpu: "100m"
              memory: "100Mi"

- name: Set agent taints
  when: node_type == 'agent'
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: Pod
      metadata:
        name: rke2-taint-agent
        namespace: kube-system
        labels:
          node-role.kubernetes.io/agent: ""
      spec:
        containers:
        - name: rke2-taint
          image: busybox
          command: ["sleep", "3600"]
          resources:
            requests:
              cpu: "100m"
              memory: "100Mi"

- name: Copy RKE2 configuration file
  template:
    src: rke2.yaml.j2
    dest: /etc/rke2/config.yaml
    mode: '0644'
    owner: root
    group: root
  notify: restart rke2

- name: Copy Kubelet configuration file
  when: kubelet_config is defined
  template:
    src: kubelet.yaml.j2
    dest: /var/lib/kubelet/config.yaml
    mode: '0644'
    owner: root
    group: root
  notify: restart kubelet

