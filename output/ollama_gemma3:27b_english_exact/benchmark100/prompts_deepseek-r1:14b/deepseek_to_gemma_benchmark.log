---

- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that: ansible_service_mgr == "systemd"
    msg: "This playbook requires systemd as the init system."

- name: Get latest release and set promtail version
  ansible.builtin.uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
  register: latest_release
  changed_when: false
- name: Get latest release and set promtail version
  ansible.builtin.set_fact:
    promtail_version: "{{ latest_release.json.tag_name }}"

- name: Test if zip local archive exists and assert local binary exists
  ansible.builtin.stat:
    path: "{{ promtail_local_archive }}"
  register: promtail_archive
- name: Test if zip local archive exists and assert local binary exists
  ansible.builtin.assert:
    that: promtail_archive.stat.exists
    msg: "Promtail local archive does not exist."

- name: Get checksum list and set checksum for target architecture
  ansible.builtin.uri:
    url: https://github.com/grafana/loki/releases/download/{{ promtail_version }}/checksums.txt
    return_content: yes
  register: checksums_file
  changed_when: false
- name: Get checksum list and set checksum for target architecture
  ansible.builtin.set_fact:
    checksums: "{{ checksums_file.content | split('\n') }}"
- name: Get checksum list and set checksum for target architecture
  ansible.builtin.set_fact:
    promtail_checksum: "{{ checksums | select('match', '{{ promtail_architecture }}\\s+[0-9a-f]+') | first | split(' ')[1] }}"


