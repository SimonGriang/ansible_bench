  template:
    src: custom-manifests.yaml.j2
    dest: "{{ rke2_manifests_dir }}/custom-manifests.yaml"
  when: rke2_custom_manifests is defined

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_local }}"
    dest: "{{ rke2_agent_pod_manifests_dir }}"
    mode: 0644
  when: rke2_static_pods_local is defined

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_environment_file_local }}"
    dest: "/etc/rke2/rke2.yaml"
    mode: 0644
  when: rke2_environment_file_local is defined


