004Z', 'done': True, 'done_reason': 'stop', 'total_duration': 81179629869, 'load_duration': 9552071862, 'prompt_eval_count': 908, 'prompt_eval_duration': 2794033678, 'eval_count': 1289, 'eval_duration': 68832692816, 'model_name': 'gemma3:27b'} id='run--09bf5c1a-d959-48c4-9ea4-fca342c899fb-0' usage_metadata={'input_tokens': 908, 'output_tokens': 1289, 'total_tokens': 2197}
