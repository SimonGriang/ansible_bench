---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install logrotate
  ansible.builtin.package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  ansible.builtin.template:
    src: "{{ logrotate_config_file }}.j2"
    dest: "{{ logrotate_config_dir }}/{{ logrotate_config_file }}"
    owner: root
    group: root
    mode: 0644

- name: Generate logrotate.d files
  ansible.builtin.template:
    src: "{{ item.template }}.j2"
    dest: "{{ logrotate_config_dir }}/{{ item.name }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ logrotate_entries }}"
  when: item.absent is not defined or item.absent == false

- name: Remove logrotate.d files
  ansible.builtin.file:
    path: "{{ logrotate_config_dir }}/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  when: item.absent == true

- name: Start logrotate
  ansible.builtin.service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state | default('started') }}"
    enabled: "{{ logrotate_service_enabled | default(true) }}"
  when: logrotate_service is defined


