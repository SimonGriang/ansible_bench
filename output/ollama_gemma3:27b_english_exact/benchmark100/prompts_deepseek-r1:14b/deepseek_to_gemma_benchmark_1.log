---
- name: Validate all variables are set correctly
  include_tasks: assert.yml
  delegate_to: localhost

- name: Wait for host to be available
  ansible.builtin.wait_for:
    port: 22
    timeout: 60

- name: Prepare system for bootstrap
  block:
    - name: Test connection
      ansible.builtin.ping:
      register: ping_result
      ignore_errors: true

    - name: Handle connection failure
      ansible.builtin.fail:
        msg: "Host is unreachable. Ping failed: {{ ping_result }}"
      when: ping_result is failed

    - name: Gather facts
      ansible.builtin.setup:
      register: facts_result

    - name: Install raw bootstrap packages
      ansible.builtin.package:
        name:
          - curl
          - openssh-client
        state: present
  become: true

- name: Ensure system preparation with Ansible modules
  block:
    - name: Gather facts again
      ansible.builtin.setup:
      register: facts_result2

    - name: Install packages based on OS family (Debian/Ubuntu)
      ansible.builtin.apt:
        name:
          - python3
          - python3-pip
        state: present
      when: ansible_os_family == "Debian"
      become: true

    - name: Install packages based on OS family (RedHat/CentOS/AlmaLinux)
      ansible.builtin.yum:
        name:
          - python3
          - python3-pip
        state: present
      when: ansible_os_family == "RedHat"
      become: true


