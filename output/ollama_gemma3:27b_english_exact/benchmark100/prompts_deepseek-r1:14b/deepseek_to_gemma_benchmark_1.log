---
- name: Remove Docker GPG key from trusted.gpg.d directory
  file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Remove old Docker source list from sources.list.d directory
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Remove obsolete Docker packages
  apt:
    name:
      - docker
      - docker-engine
      - docker.io
    state: absent
    purge: true

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker.list.old
    state: absent

- name: Install required dependencies
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: yes

- name: Manage Docker repository
  deb822_repository:
    name: docker
    key: https://download.docker.com/linux/ubuntu/gpg
    deb: https://download.docker.com/linux/ubuntu/ {{ ansible_distribution_release }} stable
    state: present
  when: docker_add_repo

- name: Flush handlers to update apt cache
  meta: flush_handlers


