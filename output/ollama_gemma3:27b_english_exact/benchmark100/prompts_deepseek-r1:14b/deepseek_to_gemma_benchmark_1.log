---
  - name: Import assert.yml
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Wait for port to be available
    wait_for:
      port: "{{ bootstrap_port }}"
      timeout: "{{ bootstrap_timeout }}"
    when: bootstrap_connection_type == 'tcp'

  - name: Prepare system
    block:
      - name: Test connection
        ping:
      - name: Test sudo access
        command: sudo -n true
        ignore_errors: true
    rescue:
      - name: Gather facts
        setup:
      - name: Install necessary packages (RedHat)
        package:
          name: libdnf5
          state: present
        when: ansible_os_family == "RedHat"
        become: true
      - name: Install necessary packages (Debian)
        package:
          name: apt-transport-https
          state: present
        when: ansible_os_family == "Debian"
        become: true

  - name: Gather ansible facts
    setup:

  - name: Install bootstrap packages (package)
    package:
      name: "{{ bootstrap_facts_packages }}"
      state: present
    become: "{{ bootstrap_become }}"


