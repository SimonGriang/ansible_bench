content="```yaml\n---\n- name: Check if EFI firmware exists on the system\n  stat:\n    path: /sys/firmware/efi/efivars/\n  register: efi_check\n\n- name: Remove GRUB configuration file on EFI systems\n  file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: efi_check.stat.exists\n\n- name: Install custom user template for GRUB\n  copy:\n    src: 01_users.j2\n    dest: /etc/grub.d/01_users\n    mode: 0755\n\n- name: Add EFI password protection to GRUB\n  lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: password_pbkdf2 my_secure_password\n    create: yes\n  when: efi_check.stat.exists\n\n- name: Add MBR password protection to GRUB\n  lineinfile:\n    path: /etc/grub2.cfg\n    line: password_pbkdf2 my_secure_password\n    create: yes\n  when: not efi_check.stat.exists\n\n- name: Add unrestricted access to GRUB password entries\n  lineinfile:\n    path: /etc/grub.d/01_users\n    regexp: '^GRUB_ENABLE_PASSWORD='\n    line: GRUB_ENABLE_PASSWORD=true\n    create: yes\n```" additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-09T22:01:11.875930483Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16263945318, 'load_duration': 197976255, 'prompt_eval_count': 505, 'prompt_eval_duration': 422927543, 'eval_count': 333, 'eval_duration': 15642344469, 'model_name': 'gemma3:27b'} id='run--b605fa09-ba60-45bd-9074-a3d6951a7a92-0' usage_metadata={'input_tokens': 505, 'output_tokens': 333, 'total_tokens': 838}
