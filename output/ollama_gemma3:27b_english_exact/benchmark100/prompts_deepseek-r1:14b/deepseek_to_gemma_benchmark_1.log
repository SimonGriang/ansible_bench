22:01.512879448Z', 'done': True, 'done_reason': 'stop', 'total_duration': 29717435951, 'load_duration': 214177267, 'prompt_eval_count': 647, 'prompt_eval_duration': 623095134, 'eval_count': 572, 'eval_duration': 28878865386, 'model_name': 'gemma3:27b'} id='run--957046e9-95aa-425f-81f6-3a21b69f71e4-0' usage_metadata={'input_tokens': 647, 'output_tokens': 572, 'total_tokens': 1219}
