---
- name: Install EPEL GPG key
  rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install EPEL release package
  yum:
    name: epel-release
    state: present
  when: ansible_distribution in ["Amazon", "RedHat"] and ansible_distribution_major_version in ["7", "8", "9"]

- name: Install EPEL next release package (conditional)
  yum:
    name: epel-next-release
    state: present
    update_cache: yes
  when: epel_next == true

- name: Update package cache
  yum:
    update_cache: yes
  listen: "Update package cache"


