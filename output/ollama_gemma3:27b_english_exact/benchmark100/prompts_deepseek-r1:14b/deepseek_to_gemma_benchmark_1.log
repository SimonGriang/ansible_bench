---
- name: hardening | Disable swap
  swapoff:
    path: all
  when: vault_hardening_disable_swap

- name: hardening | Disable core dumps
  pam_limits:
    domain: '*'
    limit_type: hard
    limit_item: core
    limit_value: 0
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable core dumps
  pam_limits:
    domain: '*'
    limit_type: soft
    limit_item: core
    limit_value: 0
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable Shell Command History
  copy:
    dest: /etc/profile.d/vault.sh
    content: |
      HISTIGNORE+=":history-vault*"
    owner: root
    group: root
    mode: 0755
  when: vault_hardening_disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  block:
    - name: Enable SELinux
      selinux:
        state: enforcing
      when: vault_hardening_configure_selinux_apparmor

    - name: Install SELinux policies
      package:
        name: policycoreutils-export-import-policydata
        state: present
      when: vault_hardening_configure_selinux_apparmor

    - name: Ensure AppArmor profiles are enabled
      command: apparmor_parser -R /etc/apparmor.d/vault
      ignore_errors: yes
      when: vault_hardening_configure_selinux_apparmor
  when: vault_hardening_configure_selinux_apparmor


