---

  - name: Create docroot directories for each virtual host
    file:
      path: "{{ item.documentroot }}"
      mode: 0755
      state: directory
    when: httpd_vhosts is defined and item.documentroot is defined and create_docroot
    loop: "{{ httpd_vhosts }}"

  - name: Configure virtual host settings
    template:
      src: "{{ vhost_conf_template }}"
      dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
      mode: 0644
    loop: "{{ httpd_vhosts }}"

  - name: Enable virtual hosts on Debian systems
    command: a2ensite {{ item.name }}.conf
    when: ansible_os_family == "Debian"
    creates: /etc/apache2/sites-enabled/{{ item.name }}.conf
    notify:
      - Test httpd configuration validity
      - Restart httpd
    loop: "{{ httpd_vhosts }}"


