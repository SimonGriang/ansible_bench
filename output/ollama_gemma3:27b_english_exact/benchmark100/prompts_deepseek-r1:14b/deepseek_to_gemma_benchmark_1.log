content='```yaml\n---\n- name: Generate a private SSL key\n  openssl_private_key:\n    path: "{{ ssl_key_path }}"\n    size: 2048\n    owner: "{{ ssl_user }}"\n    group: "{{ ssl_group }}"\n    mode: 0600\n\n- name: Generate a Certificate Signing Request (CSR)\n  openssl_csr:\n    path: "{{ ssl_csr_path }}"\n    private_key: "{{ ssl_key_path }}"\n    common_name: "{{ ssl_common_name }}"\n    owner: "{{ ssl_user }}"\n    group: "{{ ssl_group }}"\n    mode: 0600\n\n- name: Generate a self-signed SSL certificate\n  openssl_certificate:\n    path: "{{ ssl_cert_path }}"\n    private_key: "{{ ssl_key_path }}"\n    csr: "{{ ssl_csr_path }}"\n    owner: "{{ ssl_user }}"\n    group: "{{ ssl_group }}"\n    mode: 0600\n\n- name: Create a PKCS#12 file\n  openssl_pkcs12:\n    path: "{{ ssl_pkcs12_path }}"\n    private_key: "{{ ssl_key_path }}"\n    certificate: "{{ ssl_cert_path }}"\n    owner: "{{ ssl_user }}"\n    group: "{{ ssl_group }}"\n    mode: 0600\n\n- name: Read the private key content\n  slurp:\n    src: "{{ ssl_key_path }}"\n  register: private_key_content\n\n- name: Read the certificate content\n  slurp:\n    src: "{{ ssl_cert_path }}"\n  register: certificate_content\n\n- name: Combine private key and certificate into a single file\n  copy:\n    content: "{{ private_key_content.content }}\\n{{ certificate_content.content }}"\n    dest: "{{ ssl_combined_path }}"\n    owner: "{{ ssl_user }}"\n    group: "{{ ssl_group }}"\n    mode: 0600\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-09T22:53:29.897312626Z', 'done': True, 'done_reason': 'stop', 'total_duration': 25046042403, 'load_duration': 225448467, 'prompt_eval_count': 507, 'prompt_eval_duration': 446988670, 'eval_count': 463, 'eval_duration': 24371991293, 'model_name': 'gemma3:27b'} id='run--2d6bf2a6-cbdc-405f-9141-952baaa5b642-0' usage_metadata={'input_tokens': 507, 'output_tokens': 463, 'total_tokens': 970}
