---

- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: yes
  become: yes
  no_log: yes

- name: Configure apt
  apt:
    upgrade: safe
    update_cache: yes
    package_hold:
      - kernel-headers
      - kernel-image
  become: yes
  no_log: yes

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    exclude:
      - kernel*
      - glibc*
  become: yes
  no_log: yes

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes
  become: yes
  no_log: yes

- name: Configure yum
  block:
    - name: Check OS release
      setup:
      become: yes

    - name: Update all software (dnf)
      dnf:
        name: '*'
        state: latest
      become: yes
      when: ansible_distribution_major_version == "7" or ansible_distribution_major_version == "8"

    - name: Install yum-utils
      yum:
        name: yum-utils
        state: present
      become: yes
      when: ansible_distribution_major_version == "6"

    - name: Update all software (yum)
      yum:
        name: '*'
        state: latest
      become: yes
      when: ansible_distribution_major_version == "6"
  no_log: yes

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest
  become: yes
  no_log: yes


