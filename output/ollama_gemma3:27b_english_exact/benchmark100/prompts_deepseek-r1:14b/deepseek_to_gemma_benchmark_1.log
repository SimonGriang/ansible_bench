---

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ packages }}"
    state: present
  notify:
    - root_password
    - systemctl_daemon_reexecute

- name: Configure mysql server
  copy:
    dest: /etc/mysql/my.cnf
    content: "{{ mysql_server_config }}"
    owner: root
    group: root
    mode: '0644'
  notify:
    - mysql_restart

- name: Configure mysql client
  copy:
    dest: /etc/mysql/my.cnf.d/client.cnf
    content: "{{ mysql_client_config }}"
    owner: root
    group: root
    mode: '0644'

- name: Initialize mysql
  command: "{{ mysql_init_command }}"
  args:
    creates: /var/lib/mysql/mysql.sock
  when: ansible_distribution in ["Alpine", "Archlinux"]

- name: Start and enable mysql
  service:
    name: "{{ service_name }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: "{{ my_cnf_mode }}"
  notify:
    - mysql_restart

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ databases }}"
  when: not initial_import

- name: List databases
  mysql_db:
    login_unix_socket: /var/run/mysqld/mysqld.sock
    state: list
  register: existing_databases

- name: Import database
  shell: "mysql -u root -p'{{ mysql_root_password }}' -e 'source {{ initial_import }};'"
  when: not initial_import and existing_databases.databases|length == 0

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    host: "{{ item.host }}"
    state: present
  loop: "{{ users }}"
  notify:
    - mysql_restart

- name: Flush handlers again
  meta: flush_handlers


