---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost

- name: Install prerequisites
  ansible.builtin.apt:
    name: "{{ vault_prerequisites }}"
    state: present
  become: true

- name: Include installation method specific tasks
  ansible.builtin.include_tasks: "{{ vault_installation_method }}.yml"
  become: true

- name: Add Vault environment variables
  ansible.builtin.lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item.key }}={{ item.value }}"
    create: true
    mode: '0644'
  with_dict: "{{ vault_environment_settings }}"
  notify: Restart vault
  become: true

- name: Include hardening tasks
  ansible.builtin.include_tasks: hardening.yml
  become: true

- name: Start and enable vault (for OSS type)
  ansible.builtin.systemd:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"
  become: true

- name: Enable vault (for non-OSS type)
  ansible.builtin.systemd:
    name: vault
    enabled: true
  when: vault_type != "oss"
  become: true


