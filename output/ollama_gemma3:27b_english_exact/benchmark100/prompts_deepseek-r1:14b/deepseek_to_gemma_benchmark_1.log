---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: "{{ dns_directory_mode }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_data_directory }}"
    - "{{ dns_configuration_directory }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    system: yes
    state: present

- name: Generate rndc key
  command: rndc-confgen -a -k rndc-key -n {{ inventory_hostname }}
  args:
    creates: "{{ dns_configuration_directory }}/rndc-key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_configuration_directory }}/rndc-key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0600'

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_data_directory }}/root.hints"
    mode: '0644'
  when: dns_caching_dns

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_data_directory }}/{{ item }}.db"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_configuration_directory }}/named.conf"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  notify: Restart dns

- name: Place systemd override
  template:
    src: systemd.conf.j2
    dest: /etc/systemd/system/named.service.d/override.conf
  when: dns_use_systemd
  notify: Reload systemd

- name: Start and enable dns
  service:
    name: named
    state: started
    enabled: yes


