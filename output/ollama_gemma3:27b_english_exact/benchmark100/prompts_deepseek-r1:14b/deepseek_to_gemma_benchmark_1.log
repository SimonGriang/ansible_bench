---
  - name: Import assert.yml
    include_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Wait for port to be available
    wait_for:
      port: "{{ bootstrap_port }}"
      timeout: "{{ bootstrap_timeout }}"
    when:
      - bootstrap_connection != "container"
      - bootstrap_connection != "docker"
      - bootstrap_connection != "community.docker.docker"

  - name: Prepare system
    block:
      - name: Test connection
        ping:
        timeout: "{{ bootstrap_timeout }}"
      - name: Test sudo version
        command: sudo -V
        register: sudo_version
        changed_when: false
        failed_when: sudo_version.rc != 0
    rescue:
      - name: Gather facts
        setup:
      - name: Install bootstrap packages (package)
        package:
          name: "{{ bootstrap_rescue_packages }}"
          state: present
        become: true

  - name: Gather ansible facts
    setup:
    become: false

  - name: Install bootstrap packages (package)
    package:
      name: "{{ bootstrap_facts_packages }}"
      state: present
    become: "{{ bootstrap_become }}"


