---

- name: lookup bootstrap facts (raw)
  raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  vars:
    ansible_user: "{{ bootstrap_user }}"

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value.ID }}"
    bootstrap_distribution_major_version: "{{ item.value.VERSION_ID | regex_search('^([0-9]+)', '\\1') }}"
  with_items: "{{ bootstrap__os_family_map }}"
  when: bootstrap_facts.stdout | regex_search(item.value.PRETTY_NAME, ignorecase=True)
  become: "{{ bootstrap_become | default(false) }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  with_items: "{{ bootstrap__os_family_map }}"
  when: bootstrap_distribution is defined and bootstrap_distribution in item.value.distributions
  become: "{{ bootstrap_become | default(false) }}"


