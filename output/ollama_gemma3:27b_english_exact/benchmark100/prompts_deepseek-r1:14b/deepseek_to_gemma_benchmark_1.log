content='```yaml\n---\n- name: Configure Vault Authentication\n  hosts: all\n  become: true\n  tasks:\n    - name: Install Vault CLI\n      ansible.builtin.package:\n        name: vault\n        state: present\n\n    - name: Configure Vault Address\n      ansible.builtin.lineinfile:\n        path: /etc/vault.d/config.hcl\n        line: "address = \\"http://{{ vault_address }}:8200\\""\n        create: true\n\n    - name: Configure Vault Token\n      ansible.builtin.lineinfile:\n        path: /etc/vault.d/config.hcl\n        line: "token = \\"{{ vault_token }}\\""\n        create: true\n\n    - name: Write Vault CA Certificate\n      ansible.builtin.copy:\n        dest: /etc/vault.d/ca.pem\n        content: "{{ vault_ca_cert }}"\n        mode: \'0644\'\n\n    - name: Configure Vault TLS\n      ansible.builtin.lineinfile:\n        path: /etc/vault.d/config.hcl\n        line: "tls_ca_file = \\"/etc/vault.d/ca.pem\\""\n        create: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-09T21:51:37.60440623Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15362320161, 'load_duration': 212999032, 'prompt_eval_count': 1519, 'prompt_eval_duration': 1396213574, 'eval_count': 282, 'eval_duration': 13751219836, 'model_name': 'gemma3:27b'} id='run--2c3bbe4e-b605-40a9-be0e-3b7dd1dfef05-0' usage_metadata={'input_tokens': 1519, 'output_tokens': 282, 'total_tokens': 1801}
