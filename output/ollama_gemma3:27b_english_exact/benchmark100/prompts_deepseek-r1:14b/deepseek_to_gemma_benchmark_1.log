---
- name: Generate a private SSL key
  openssl_private_key:
    path: "{{ ssl_key_path }}"
    size: 2048
    owner: "{{ ssl_user }}"
    group: "{{ ssl_group }}"
    mode: 0600

- name: Generate a Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ ssl_csr_path }}"
    private_key: "{{ ssl_key_path }}"
    common_name: "{{ ssl_common_name }}"
    owner: "{{ ssl_user }}"
    group: "{{ ssl_group }}"
    mode: 0600

- name: Generate a self-signed SSL certificate
  openssl_certificate:
    path: "{{ ssl_cert_path }}"
    private_key: "{{ ssl_key_path }}"
    csr: "{{ ssl_csr_path }}"
    owner: "{{ ssl_user }}"
    group: "{{ ssl_group }}"
    mode: 0600

- name: Create a PKCS#12 file
  openssl_pkcs12:
    path: "{{ ssl_pkcs12_path }}"
    private_key: "{{ ssl_key_path }}"
    certificate: "{{ ssl_cert_path }}"
    owner: "{{ ssl_user }}"
    group: "{{ ssl_group }}"
    mode: 0600

- name: Read the private key content
  slurp:
    src: "{{ ssl_key_path }}"
  register: private_key_content

- name: Read the certificate content
  slurp:
    src: "{{ ssl_cert_path }}"
  register: certificate_content

- name: Combine private key and certificate into a single file
  copy:
    content: "{{ private_key_content.content }}\n{{ certificate_content.content }}"
    dest: "{{ ssl_combined_path }}"
    owner: "{{ ssl_user }}"
    group: "{{ ssl_group }}"
    mode: 0600


