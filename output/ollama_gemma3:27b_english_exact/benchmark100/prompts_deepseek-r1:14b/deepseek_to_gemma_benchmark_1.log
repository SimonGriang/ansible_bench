content='```yaml\n---\n\n- name: gather_facts | Lookup bootstrap facts\n  ansible.builtin.command: cat /etc/os-release\n  register: os_release\n  changed_when: false\n\n- name: gather_facts | Set bootstrap facts (I)\n  ansible.builtin.set_fact:\n    distribution_name: "{{ os_release.stdout | regex_search(\'^NAME=(.*)\', \'\\\\1\') | regex_replace(\'"\', \'\') }}"\n    distribution_major_version: "{{ os_release.stdout | regex_search(\'^VERSION_ID=(.*)\', \'\\\\1\') | split(\'=\')[1] | split(\'.\')[0] }}"\n\n- name: gather_facts | Set bootstrap facts (II)\n  ansible.builtin.set_fact:\n    os_family: "{{\n      \'Debian\' if distribution_name in [\'Debian\', \'Ubuntu\']\n      else \'RedHat\' if distribution_name in [\'CentOS\', \'Rocky\', \'AlmaLinux\', \'Red Hat Enterprise Linux\']\n      else \'Suse\' if distribution_name in [\'openSUSE\', \'SUSE Linux Enterprise Server\']\n      else \'Other\'\n    }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-09T22:46:08.780786943Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13179973777, 'load_duration': 180720951, 'prompt_eval_count': 365, 'prompt_eval_duration': 357301755, 'eval_count': 259, 'eval_duration': 12640925094, 'model_name': 'gemma3:27b'} id='run--4f84d443-b666-480d-ac5b-29af5de5042a-0' usage_metadata={'input_tokens': 365, 'output_tokens': 259, 'total_tokens': 624}
