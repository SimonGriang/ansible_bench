- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: /var/lib/rke2/manifests
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    src: files/kube-vip/
    dest: /var/lib/rke2/manifests/
    owner: root
    group: root
    mode: '0644'

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    src: files/kube-vip-lb/
    dest: /var/lib/rke2/manifests/
    owner: root
    group: root
    mode: '0644'
  when: cloud_provider_enabled


