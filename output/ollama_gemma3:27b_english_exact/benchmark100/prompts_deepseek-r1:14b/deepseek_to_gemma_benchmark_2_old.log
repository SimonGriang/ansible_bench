---

  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Pre-configure debian systems
    apt:
      update_cache: yes
      cache_valid_time: 3600
    when: ansible_os_family == "Debian"

  - name: Install postfix
    apt:
      name: postfix
      state: present

  - name: Install postfix-mysql
    apt:
      name: postfix-mysql
      state: present
    when: postfix_mysql_configured

  - name: Configure postfix (transport_maps)
    template:
      src: transport_maps.conf.j2
      dest: /etc/postfix/transport_maps
    notify:
      - validate postfix
      - rebuild postfix database

  - name: Configure postfix (header_checks)
    template:
      src: header_checks.conf.j2
      dest: /etc/postfix/header_checks
    notify:
      - validate postfix
      - reload postfix

  - name: Setting values for main.cf (1/2)
    set_fact:
      postfix_recipient_restrictions: "{{ postfix_recipient_restrictions | default([]) + ['check_sender_access hash:/etc/postfix/sender_access'] }}"

  - name: Setting values for main.cf (2/2)
    set_fact:
      postfix_mynetworks: "{{ postfix_mynetworks | default([]) + ['127.0.0.0/8'] }}"
      postfix_mydestination: "{{ postfix_mydestination | default([]) + ['localhost', 'localhost.localdomain'] }}"

  - name: Configure postfix (main.cf)
    template:
      src: main.cf.j2
      dest: /etc/postfix/main.cf
    notify:
      - validate postfix
      - restart postfix

  - name: Configure postfix (master.cf)
    template:
      src: master.cf.j2
      dest: /etc/postfix/master.cf
    notify:
      - validate postfix
      - restart postfix

  - name: Creates cert/key directory
    file:
      path: "{{ postfix_tls_cert_dir }}"
      state: directory
      owner: root
      group: root
      mode: '0750'

  - name: Deploy Postfix TLS server certificate
    copy:
      src: "{{ postfix_tls_cert_file }}"
      dest: "{{ postfix_tls_cert_file }}"
      owner: root
      group: root
      mode: '0644'
    notify:
      - reload postfix

  - name: Deploy Postfix TLS server key
    copy:
      src: "{{ postfix_tls_key_file }}"
      dest: "{{ postfix_tls_key_file }}"
      owner: root
      group: root
      mode: '0600'
    notify:
      - reload postfix

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure aliases
    lineinfile:
      path: /etc/aliases
      line: "{{ item }}"
      state: present
    with_items: "{{ postfix_aliases }}"
    notify:
      - rebuild postfix database
      - reload postfix

  - name: Configure sender_access
    copy:
      dest: /etc/postfix/sender_access
      content: "{{ postfix_sender_access_content }}"
    notify:
      - rebuild postfix database
      - reload postfix

  - name: Configure recipient_access
    copy:
      dest: /etc/postfix/recipient_access
      content: "{{ postfix_recipient_access_content }}"
    notify:
      - validate postfix
      - rebuild postfix database
      - reload postfix

  - name: Place sasl_password_map
    copy:
      dest: /etc/postfix/sasl_password_map
      content: "{{ postfix_sasl_password_map_content }}"
    notify:
      - rebuild postfix map

  - name: Flush handlers again
    meta: flush_handlers

  - name: Start and enable postfix
    service:
      name: postfix
      state: started
      enabled: yes


