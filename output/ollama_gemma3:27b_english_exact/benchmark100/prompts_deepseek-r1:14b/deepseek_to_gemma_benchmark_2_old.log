---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  selinux:
    state: present
    policy: targeted
    boolean_value:
      - name: httpd_can_network_connect
        value: yes
      - name: httpd_can_network_bind
        value: yes
      - name: httpd_use_nfs
        value: yes
  when: ansible_selinux.status == "enabled"

- name: Configure httpd
  template:
    src: httpd.conf.j2
    dest: "{{ httpd_config }}"
    mode: 0644
  notify:
    - configtest
    - restart httpd

- name: Activate httpd module | Debian
  command: a2enmod {{ item }}
  with_items: "{{ httpd_modules }}"
  changed_when: false
  when: ansible_os_family == "Debian"

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: enable_ssl

- name: Import locations.yml
  import_tasks: locations.yml
  when: locations_defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: vhosts_defined

- name: Configure ports
  template:
    src: ports.conf.j2
    dest: "{{ httpd_ports_config }}"
    mode: 0644
  notify:
    - configtest
    - restart httpd
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directories.yml
  import_tasks: directories.yml
  when: directories_defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_docroot }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service_name }}"
    state: started
    enabled: yes


