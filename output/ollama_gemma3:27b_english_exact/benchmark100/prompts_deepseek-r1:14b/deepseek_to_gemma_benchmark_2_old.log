    owner: root
    group: root
  notify: Restart RKE2

- name: Copy kubelet configuration file
  copy:
    src: "{{ rke2_kubelet_config }}"
    dest: /etc/rke2/kubelet.yaml
    mode: '0644'
    owner: root
    group: root
  when: rke2_kubelet_config is defined and rke2_kubelet_config != ""
  notify: Restart RKE2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_config }}"
    dest: /etc/rke2/containerd/config.toml
    mode: '0644'
    owner: root
    group: root
  when: rke2_containerd_config is defined and rke2_containerd_config != ""
  notify: Restart RKE2

- name: Register etcd restore from file
  set_fact:
    etcd_restore_from_file_needed: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != '' and ansible_service_mgr == 'systemd' and (lookup('file', '/var/lib/rke2/etcd/db') is undefined or lookup('file', '/var/lib/rke2/etcd/db') == '') }}"

- name: Register etcd restore from S3
  set_fact:
    etcd_restore_from_s3_needed: "{{ rke2_etcd_s3_bucket is defined and rke2_etcd_s3_bucket != '' and rke2_etcd_s3_prefix is defined and rke2_etcd_s3_prefix != '' and rke2_etcd_s3_region is defined and rke2_etcd_s3_region != '' }}"

- name: Restore etcd from file
  block:
    - name: Create etcd restore directory
      file:
        path: /tmp/etcd-restore
        state: directory
        mode: '0755'

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /tmp/etcd-restore/etcd.db
        mode: '0644'

    - name: Restore etcd from file
      command: "rke2 etcd-snapshot restore --file /tmp/etcd-restore/etcd.db"
      changed_when: true
  when: etcd_restore_from_file_needed
  become: true

- name: Restore etcd from S3
  block:
    - name: Restore etcd from S3
      command: "rke2 etcd-snapshot restore --s3-bucket {{ rke2_etcd_s3_bucket }} --s3-prefix {{ rke2_etcd_s3_prefix }} --s3-region {{ rke2_etcd_s3_region }}"
      changed_when: true
  when: etcd_restore_from_s3_needed
  become: true

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    env:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Restart RKE2

- name: Mask RKE2 agent service
  systemd:
    name: rke2-agent
    state: stopped
    masked: yes
  when: ansible_hostname in groups['rke2_servers']

- name: Wait for first server to be ready (no CNI)
  wait_for:
    host: localhost
    port: 6443
    timeout: 300
  when: rke2_cni_plugin is not defined or rke2_cni_plugin == ""
  delegate_to: localhost

- name: Wait for first server to be ready (with CNI)
  wait_for:
    host: localhost
    port: 6443
    timeout: 300
  when: rke2_cni_plugin is defined and rke2_cni_plugin != ""
  delegate_to: localhost

- name: Restore etcd
  block:
    - name: Clean up old nodes
      command: "rke2 etcd-snapshot prune"
      changed_when: true
    - name: Clean up secrets
      command: "rke2 secrets prune"
      changed_when: true
  when: etcd_restore_from_file_needed or etcd_restore_from_s3_needed
  become: true

- name: Set Active Server variable
  set_fact:
    active_server: "{{ ansible_hostname }}"
  delegate_to: localhost
  run_once: true


