- name: locations | Enable modules
  ansible.builtin.shell: |
    a2enmod proxy
    a2enmod proxy_http
  become: true
  when: ansible_os_family in ["Debian", "Suse"]

- name: locations | Configure locations
  ansible.builtin.template:
    src: templates/location.conf.j2
    dest: "{{ httpd_config_dir }}/location_{{ item.name }}.conf"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ httpd_locations }}"
  notify:
    - httpd configuration test
    - httpd restart


