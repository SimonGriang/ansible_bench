---

- name: Create the RKE2 configuration directory
  file:
    path: /etc/rke2/
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server taints
  lineinfile:
    path: /etc/rke2/config.yaml
    regexp: '^node-labels:'
    line: 'node-labels:\n  node-role: server'
  when: node_type == 'server'

- name: Set agent taints
  lineinfile:
    path: /etc/rke2/config.yaml
    regexp: '^node-labels:'
    line: 'node-labels:\n  node-role: agent'
  when: node_type == 'agent'

- name: Copy RKE2 configuration file
  template:
    src: rke2.yaml.j2
    dest: /etc/rke2/config.yaml
    mode: '0644'
    owner: root
    group: root
  notify: restart rke2

- name: Copy Kubelet configuration file
  template:
    src: kubelet.yaml.j2
    dest: /var/lib/kubelet/config.yaml
    mode: '0644'
    owner: root
    group: root
  when: kubelet_config is defined
  notify: restart kubelet

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ container_registry_config }}"
    dest: /etc/containerd/config.toml
    mode: '0644'
    owner: root
    group: root
  when: container_registry_config is defined
  notify: restart containerd

- name: Start RKE2 service on other nodes
  systemd:
    name: rke2-server
    enabled: true
    state: started
  delegate_to: localhost
  run_once: true
  with_items: "{{ groups['all'] }}"
  loop_control:
    loop_var: node
  when: node != inventory_hostname

- name: Mask other RKE2 services on nodes
  systemd:
    name: "{{ item }}"
    masked: true
  with_items:
    - rke2-agent
    - rke2-server
  when: node_type != item.split('-')[-1]

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    host: "{{ item }}"
    port: 6443
    timeout: 600
  with_items: "{{ groups['nodes'] }}"
  when: not cni_configured

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    host: "{{ item }}"
    port: 6443
    timeout: 600
  with_items: "{{ groups['nodes'] }}"
  when: cni_configured


