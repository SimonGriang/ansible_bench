---

- name: Import assertion file
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install cron package
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  lineinfile:
    path: /etc/cron.d/000_environment
    line: "SHELL=/bin/bash"
    create: yes

- name: Configure cron path environment
  lineinfile:
    path: /etc/cron.d/000_environment
    line: "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    create: yes

- name: Configure cron mailto settings
  lineinfile:
    path: /etc/cron.d/000_environment
    line: "MAILTO={{ cron_mailto }}"
    create: yes

- name: Start and enable cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    user: "{{ item.user | default('root') }}"
  loop: "{{ cron_jobs }}"


