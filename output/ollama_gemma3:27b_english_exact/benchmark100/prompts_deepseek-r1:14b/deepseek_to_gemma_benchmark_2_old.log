---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install using package
  block:
    - name: Install using package - Debian/Ubuntu
      when: ansible_os_family == "Debian"
      package:
        name: "{{ hashicorp_package }}"
        state: present
        update_cache: true
    - name: Install using package - RedHat/CentOS/AlmaLinux/Rocky Linux
      when: ansible_os_family == "RedHat"
      package:
        name: "{{ hashicorp_package }}"
        state: present
        update_cache: true
    - name: Install using package - SUSE
      when: ansible_os_family == "Suse"
      package:
        name: "{{ hashicorp_package }}"
        state: present
        update_cache: true
  become: true

- name: Configure debian
  block:
    - name: Add GPG key
      apt_key:
        url: "{{ hashicorp_gpg_key }}"
        state: present
      become: true
      when: ansible_os_family == "Debian"
    - name: Add apt repository
      apt_repository:
        repo: "{{ hashicorp_apt_repo }}"
        state: present
        update_cache: true
      become: true
      when: ansible_os_family == "Debian"

- name: Install hashicorp product using package
  block:
    - name: Install latest version
      package:
        name: "{{ hashicorp_package }}"
        state: latest
      become: true
      when: hashicorp_version is not defined
    - name: Install specific version
      package:
        name: "{{ hashicorp_package }}-{{ hashicorp_version }}"
        state: present
      become: true
      when: hashicorp_version is defined

- name: Install manually
  block:
    - name: Download HashiCorp product
      get_url:
        url: "{{ hashicorp_download_url }}"
        dest: "/tmp/{{ hashicorp_package }}.tar.gz"
        mode: '0644'
    - name: Create destination directory
      file:
        path: "{{ hashicorp_install_dir }}"
        state: directory
        mode: '0755'
      become: true
    - name: Extract HashiCorp product
      unarchive:
        src: "/tmp/{{ hashicorp_package }}.tar.gz"
        dest: "{{ hashicorp_install_dir }}"
        remote_src: yes
      become: true
    - name: Set permissions
      file:
        path: "{{ hashicorp_install_dir }}"
        state: directory
        mode: '0755'
        recurse: true
      become: true


