': 1267, 'eval_duration': 69211399674, 'model_name': 'gemma3:27b'} id='run--7159154e-8761-4e44-a9c6-4d9b1f7fa528-0' usage_metadata={'input_tokens': 927, 'output_tokens': 1267, 'total_tokens': 2194}
