---

  - name: Import assert.yml
    import_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Manage automatic service management
    block:
      - name: Disable automatic service management
        when: ansible_pkg_mgr == "apt" and apt_autostart_state == "disabled"
        copy:
          dest: /usr/sbin/policy-rc.d
          content: "exit 101"
          mode: 0755
      - name: Enable automatic service management
        when: ansible_pkg_mgr == "apt" and apt_autostart_state == "enabled"
        file:
          path: /usr/sbin/policy-rc.d
          state: absent


