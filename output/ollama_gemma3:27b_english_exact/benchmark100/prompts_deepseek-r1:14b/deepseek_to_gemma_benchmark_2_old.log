---

  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install required packages
    package:
      name: "{{ selinux_requirements }}"
      state: present
    notify: Gather facts

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure selinux
    selinux:
      state: "{{ selinux_state }}"
      policy: "{{ selinux_policy }}"
    notify: Reboot
  
  - name: Manage SELinux Booleans
    seboolean:
      name: "{{ item.name }}"
      state: "{{ item.state }}"
    loop: "{{ selinux_booleans | default([]) }}"
    notify: Reboot


