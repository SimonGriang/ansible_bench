---
- name: Migrate adoptopenjdk to temurin
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Gather OS specific variables
  include_vars:
    file: "vars/{{ java_jdk_vendor }}_{{ ansible_os_family }}_{{ ansible_distribution_version }}.yml"
  ignore_errors: true

- name: Gather architecture specific variables
  include_vars:
    file: "vars/{{ ansible_architecture }}.yml"
  ignore_errors: true

- name: Set OS specific variables (I)
  set_fact:
    java_version: "{{ java_version | default('8') }}"
    java_repositories: "{{ java_repositories | default([]) }}"
    java_libs: "{{ java_libs | default([]) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_install_path: "{{ java_install_path | default('/usr/lib/jvm') }}"
    java_package_name: "{{ java_package_name | default('openjdk-11-jre-headless') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_install_path }}/{{ java_version }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "deb http://apt.adoptopenjdk.net/ {{ ansible_distribution_release }} main"
        state: absent
      when: ansible_os_family == "Debian"

    - name: Install extra apt tools
      apt:
        name:
          - apt-transport-https
          - ca-certificates
        state: present
      when: ansible_os_family == "Debian"

    - name: Add key repositories
      apt_key:
        url: https://packages.adoptium.net/artifactory/api/gpg/key/public
        state: present
      when: ansible_os_family == "Debian"

    - name: Add required repositories
      apt_repository:
        repo: "deb https://packages.adoptium.net/artifactory/eclipse-temurin/{{ java_version }}/{{ ansible_distribution_codename }} main"
        state: present
        filename: temurin
      when: ansible_os_family == "Debian"
  when: ansible_os_family == "Debian"

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        state: present
        key: https://packages.adoptium.net/artifactory/api/gpg/key/public

    - name: Add required repositories
      yum_repository:
        name: adoptium
        description: Adoptium Eclipse Temurin Repository
        baseurl: https://packages.adoptium.net/artifactory/eclipse-temurin/{{ java_version }}/{{ ansible_distribution_major_version }}/$basearch
        gpgcheck: yes
        enabled: yes
  when: ansible_os_family == "RedHat"

- name: Install required libs
  package:
    name: "{{ java_libs }}"
    state: present

- name: Install Java, Debian
  apt:
    name: "{{ java_package_name }}"
    state: present
    update_cache: yes
  when: ansible_os_family == "Debian"

- name: Install Java, RedHat
  yum:
    name: "{{ java_package_name }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Export environment variables
  copy:
    dest: /etc/profile.d/java.sh
    content: |
      export JAVA_HOME={{ java_home }}
      export PATH=$JAVA_HOME/bin:$PATH
    owner: root
    group: root
    mode: 0755

- name: Source environment variables
  command: source /etc/profile.d/java.sh
  become: true

- name: Correct java version selected for Java < 11
