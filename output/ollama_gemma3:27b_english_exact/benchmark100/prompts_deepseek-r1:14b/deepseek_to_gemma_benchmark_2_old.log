---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: 0700
  when: rke2_airgap_mode and not rke2_airgap_local_script

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_airgap_local_script_path }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: 0700
  when: rke2_airgap_mode and rke2_airgap_local_script

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: 0700
  when: rke2_airgap_mode and not rke2_airgap_exists

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ item.url }}"
    dest: "{{ item.dest }}"
    checksum: "{{ item.checksum }}"
    validate_certs: "{{ rke2_validate_certs }}"
  with_items: "{{ rke2_artifacts }}"
  register: download_result
  retries: 3
  delay: 5
  until: download_result.changed == false
  ignore_errors: yes

- name: Download RKE2 checksum and artifacts - fallback to local
  copy:
    src: "{{ item.local_src }}"
    dest: "{{ item.dest }}"
    remote_src: yes
  with_items: "{{ rke2_artifacts }}"
  when: download_result.failed

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: 0640
    remote_src: yes
  with_items: "{{ rke2_artifacts }}"
  when: rke2_airgap_mode and rke2_airgap_copy

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_airgap_images_dir }}"
    remote_src: yes
  with_items: "{{ rke2_airgap_additional_tarballs }}"
  when: rke2_airgap_mode and rke2_airgap_additional_tarballs

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ item }}"
    state: file
    mode: "{{ '0640' if item.endswith('.tar.gz') else '0700' }}"
  with_items:
    - "{{ rke2_install_script_dest }}"
    - "{{ rke2_artifacts_dir | glob('*.tar.gz') }}"

- name: Populate service facts
  setup:
    filter: ansible_service_units

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stats

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin/rke2
  when: usr_local_stats.stat.exists and usr_local_stats.stat.writable

- name: Set RKE2 bin path - alternative path
  set_fact:
    rke2_bin_path: /opt/rke2/bin/rke2
  when: not (usr_local_stats.stat.exists and usr_local_stats.stat.writable)

- name: Check RKE2 version
  command: "{{ rke2_bin_path }} --version"
  register: rke2_version_output
  ignore_errors: true

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_allow_downgrade or (rke2_installed_version is version_compare(rke2_desired_version, '>='))
    msg: "Downgrade of RKE2 is not allowed unless explicitly permitted."
  when: rke2_installed_version is defined and rke2_desired_version is defined

- name: Run RKE2 install script
  command: "{{ rke2_install_script_dest }} -- --kubelet-config /etc/rke2/kubelet.yaml"
  environment:
    RKE2_AIRGAP_MODE: "{{ rke2_airgap_mode }}"
    RKE2_ARTIFACTS_DIR: "{{ rke2_artifacts_dir }}"
    RKE2_INSTALL_SCRIPT_DEST: "{{ rke2_install_script_dest }}"

- name: Copy Custom Manifests
  template:
    src: custom-manifests.yaml.j2
    dest: "{{ rke2_manifests_dir }}/custom-manifests.yaml"

- name: Copy Static Pods
  copy:
    src: static-pods/
    dest: "{{ rke2_agent_pod_manifests_dir }}"
    mode: 0644

- name: Copy RKE2 environment file
  copy:
    src: rke2-env.conf
    dest: /etc/rke2/rke2.env
    mode: 0644
  when: rke2_env_options is defined


