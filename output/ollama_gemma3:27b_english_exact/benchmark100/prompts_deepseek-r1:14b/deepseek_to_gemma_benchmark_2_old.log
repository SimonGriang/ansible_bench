---
- name: Restart RKE2 service on {{ rke2_node_name}}
  service:
    name: rke2-server
    state: restarted
  notify: "Service (re)started"

- name: Wait for all nodes to be ready again
  command: kubectl get nodes -o wide
  delegate_to: "{{ rke2_servers_group_name | first }}"
  retries: 100
  delay: 15
  register: node_status
  until: node_status.rc == 0
  when: ansible_check_mode == false

- name: Wait for all pods to be ready again
  command: kubectl get pods --all-namespaces -o wide
  delegate_to: "{{ rke2_servers_group_name | first }}"
  retries: 100
  delay: 15
  register: pod_status
  until: pod_status.rc == 0
  when: ansible_check_mode == false and rke2_wait_for_all_pods_to_be_ready


