---

  - name: Update apt cache
    apt:
      update_cache: yes
    when: ansible_os_family == "Debian"

  - name: Update dnf cache
    dnf:
      update_cache: yes
    when: ansible_os_family == "RedHat"

  - name: Install packages
    package:
      name: keepalived
      state: present

  - name: Create directory for keepalived
    file:
      path: /etc/keepalived
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Create Kubernetes API health check script for Debian OS family
    copy:
      dest: /usr/local/bin/check_k8s_api.sh
      content: |
        #!/bin/bash
        kubectl get pods --namespace=kube-system | grep -q kube-apiserver
        if [ $? -eq 0 ]; then
          exit 0
        else
          exit 1
        fi
      mode: '0755'
    when: ansible_os_family == "Debian"
    notify: restart keepalived

  - name: Create Kubernetes API health check script for RedHat OS famliy
    copy:
      dest: /usr/local/bin/check_k8s_api.sh
      content: |
        #!/bin/bash
        kubectl get pods --namespace=kube-system | grep -q kube-apiserver
        if [ $? -eq 0 ]; then
          exit 0
        else
          exit 1
        fi
      mode: '0755'
    when: ansible_os_family == "RedHat"
    notify: restart keepalived

  - name: Create RKE2 Server health check script for Debian OS family
    copy:
      dest: /usr/local/bin/check_rke2_server.sh
      content: |
        #!/bin/bash
        systemctl is-active rke2-server
        if [ $? -eq 0 ]; then
          exit 0
        else
          exit 1
        fi
      mode: '0755'
    when: ansible_os_family == "Debian"
    notify: restart keepalived

  - name: Create RKE2 Server health check script for RedHat OS family
    copy:
      dest: /usr/local/bin/check_rke2_server.sh
      content: |
        #!/bin/bash
        systemctl is-active rke2-server
        if [ $? -eq 0 ]; then
          exit 0
        else
          exit 1
        fi
      mode: '0755'
    when: ansible_os_family == "RedHat"
    notify: restart keepalived

  - name: Create keepalived config file
    template:
      src: keepalived.conf.j2
      dest: /etc/keepalived/keepalived.conf
    notify: restart keepalived

  - name: Enable keepalived and make sure it is not masked
    systemd:
      name: keepalived
      enabled: yes
      masked: no
    notify: restart keepalived

  - name: Flush handlers
    meta: flush_handlers


