---

- name: Import assertion file
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell
  lineinfile:
    path: /etc/cron.d/000_custom
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
  notify: restart cron

- name: Configure cron path
  lineinfile:
    path: /etc/cron.d/000_custom
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
  notify: restart cron

- name: Configure cron mailto
  lineinfile:
    path: /etc/cron.d/000_custom
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
  notify: restart cron

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: true
  when: cron_service is defined and cron_service

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    user: "{{ item.user }}"
    job: "{{ item.job }}"
    state: present
  loop: "{{ cron_jobs }}"


