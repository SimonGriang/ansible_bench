    - name: Cordon the node
      command: kubectl cordon {{ rke2_node_name }}
      changed_when: false
      ignore_errors: true

    - name: Drain the node
      command: kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-local-data --force
      ignore_errors: true

    - name: Wait for node to be drained
      wait_for:
        path: /tmp/node_drained
        timeout: 800
      loop: 100
      delay: 15
      register: wait_result
      until: wait_result.changed
      run_once: true
      delegate_to: localhost
      become: false

    - name: Set flag that node has been drained
      file:
        path: /tmp/node_drained
        state: touch
      delegate_to: localhost
      become: false


