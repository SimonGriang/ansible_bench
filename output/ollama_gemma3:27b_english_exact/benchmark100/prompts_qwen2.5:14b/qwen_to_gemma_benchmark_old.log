---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install php
  ansible.builtin.package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  ansible.builtin.shell: "find / -name php.ini 2>/dev/null | head -n 1"
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  ansible.builtin.template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
  notify: restart httpd


