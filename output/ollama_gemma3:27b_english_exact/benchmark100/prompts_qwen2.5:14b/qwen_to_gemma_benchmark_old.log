content='```yaml\n---\n\n- name: Check if certificates exist\n  stat:\n    path: "{{ item }}"\n  with_items: "{{ java_certs }}"\n  register: cert_check\n\n- name: Fail if some certificate doesn\'t exist\n  fail:\n    msg: "Certificate {{ item }} does not exist."\n  loop: "{{ java_certs }}"\n  when: cert_check.results[loop.index - 1].stat.exists == false\n\n- name: Setting keystore variables in java < 11\n  set_fact:\n    java_keystore_dir: "{{ java_keystore_dir_old }}"\n  when: java_open_jdk_version_major < 11\n\n- name: Setting keystore variables in java >= 11\n  set_fact:\n    java_keystore_dir: "{{ java_keystore_dir_new }}"\n  when: java_open_jdk_version_major >= 11\n\n- name: Import SSL certificates\n  java_cert:\n    path: "{{ item }}"\n    keystore: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts"\n    keystore_password: changeit\n  with_items: "{{ java_certs }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-08T11:18:04.315496808Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15514698743, 'load_duration': 198330373, 'prompt_eval_count': 542, 'prompt_eval_duration': 525040365, 'eval_count': 283, 'eval_duration': 14789952681, 'model_name': 'gemma3:27b'} id='run--a9682a29-5a08-4d77-8337-ccbb4cc24b4c-0' usage_metadata={'input_tokens': 542, 'output_tokens': 283, 'total_tokens': 825}
