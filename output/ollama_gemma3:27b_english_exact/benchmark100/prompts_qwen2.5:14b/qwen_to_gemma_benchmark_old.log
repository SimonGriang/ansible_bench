content='```yaml\n---\n- name: Ensure the unzip package is available on the target system.\n  ansible.builtin.package:\n    name: unzip\n    state: present\n    update_cache: true\n\n- name: Create a system group for promtail.\n  ansible.builtin.group:\n    name: promtail\n    state: present\n    system: true\n\n- name: Create the promtail user.\n  ansible.builtin.user:\n    name: promtail\n    group: promtail\n    system: true\n    createhome: false\n\n- name: Ensure the /usr/local/bin directory exists.\n  ansible.builtin.file:\n    path: /usr/local/bin\n    state: directory\n    mode: \'0755\'\n\n- name: Create config directories.\n  ansible.builtin.file:\n    path: /etc/promtail\n    state: directory\n    mode: \'0755\'\n    owner: promtail\n    group: promtail\n\n- name: Create application directories.\n  ansible.builtin.file:\n    path: /opt/promtail\n    state: directory\n    mode: \'0755\'\n    owner: promtail\n    group: promtail\n\n- name: Check if the promtail binary exists.\n  ansible.builtin.stat:\n    path: /opt/promtail/promtail\n  register: promtail_binary\n\n- name: Download promtail binaries.\n  ansible.builtin.get_url:\n    url: "https://github.com/grafana/promtail/releases/latest/download/promtail-{{ ansible_architecture }}"\n    dest: /opt/promtail/promtail\n    mode: \'0755\'\n  when: not promtail_binary.stat.exists\n\n- name: Propagate locally distributed promtail archive.\n  ansible.builtin.copy:\n    src: files/promtail-{{ ansible_architecture }}\n    dest: /opt/promtail/promtail\n    mode: \'0755\'\n  when: not promtail_binary.stat.exists\n\n- name: Download promtail binaries to controller node.\n  ansible.builtin.get_url:\n    url: "https://github.com/grafana/promtail/releases/latest/download/promtail-{{ ansible_architecture }}"\n    dest: files/promtail-{{ ansible_architecture }}\n  when: not promtail_binary.stat.exists\n\n- name: Propagate promtail binaries.\n  ansible.builtin.copy:\n    src: files/promtail-{{ ansible_architecture }}\n    dest: /opt/promtail/promtail\n    mode: \'0755\'\n  when: not promtail_binary.stat.exists\n\n- name: Unpack promtail binaries.\n  ansible.builtin.unarchive:\n    src: /opt/promtail/promtail\n    dest: /opt/promtail\n    remote_src: yes\n    creates: /opt/promtail/promtail\n    ignore_errors: yes\n    check_mode: no\n\n- name: Create symlink to latest version.\n  ansible.builtin.file:\n    src: /opt/promtail/promtail\n    dest: /usr/local/bin/promtail\n    state: link\n  notify: restart promtail\n\n- name: Write configuration.\n  ansible.builtin.template:\n    src: templates/promtail.yml.j2\n    dest: /etc/promtail/promtail.yml\n    mode: \'0644\'\n    owner: promtail\n    group: promtail\n  notify: restart promtail\n\n- name: Create systemd service unit.\n  ansible.builtin.template:\n    src: templates/promtail.service.j2\n    dest: /etc/systemd/system/promtail.service\n    mode: \'0644\'\n  notify: restart promtail\n\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-08T10:28:01.282421816Z', 'done': True, 'done_reason': 'stop', 'total_duration': 51652207525, 'load_duration': 205195693, 'prompt_eval_count': 843, 'prompt_eval_duration': 898379295, 'eval_count': 896, 'eval_duration': 50547071664, 'model_name': 'gemma3:27b'} id='run--6497e1bf-adbf-407e-8e5d-5cfd0764fecf-0' usage_metadata={'input_tokens': 843, 'output_tokens': 896, 'total_tokens': 1739}
