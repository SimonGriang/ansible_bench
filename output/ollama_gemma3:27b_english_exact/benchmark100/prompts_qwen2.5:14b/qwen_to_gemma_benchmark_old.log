---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ dns_directory }}"
    state: directory
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0750'
    recurse: yes

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present
    system: yes

- name: Create user
  user:
    name: "{{ dns_user }}"
    system: yes
    group: "{{ dns_group }}"
    createhome: false

- name: Generate rndc key
  command: "rndc-confgen -a -k rndc-key"
  args:
    creates: "{{ rndc_key_file }}"

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_file }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0640'

- name: Get the hints/root file
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ root_hints_file }}"
    mode: '0644'

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_directory }}/{{ zone_file_name }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0644'

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_config_file }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0644'

- name: Place systemd override
  file:
    path: "{{ systemd_override_dir }}"
    state: directory
    mode: '0755'

- name: Place systemd override file
  copy:
    src: systemd.conf
    dest: "{{ systemd_override_file }}"
    owner: root
    group: root
    mode: '0644'

- name: Start and enable dns
  systemd:
    name: "{{ dns_service }}"
    state: started
    enabled: yes


