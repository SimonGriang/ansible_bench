---

  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install git
    package:
      name: "{{ git_packages }}"
      state: present

  - name: See if the specified user exists
    getent:
      database: passwd
      key: "{{ git_user }}"
    register: user_exists

  - name: Create directory for git configuration
    file:
      path: "{{ git_config_dir }}"
      state: directory
      owner: "{{ git_user }}"
      group: "{{ git_user }}"
      mode: '0755'
    when: user_exists.passwd is defined and git_user is defined and git_config_dir is defined

  - name: Place git configuration
    copy:
      src: files/gitconfig
      dest: "{{ git_config_dir }}/.gitconfig"
      owner: "{{ git_user }}"
      group: "{{ git_user }}"
      mode: '0644'
    when: user_exists.passwd is defined and git_user is defined and git_config_dir is defined and gitconfig_file is defined

  - name: Create repository_destination
    file:
      path: "{{ repository_destination }}"
      state: directory
      owner: "{{ git_user }}"
      group: "{{ git_user }}"
      mode: '0755'
    when: user_exists.passwd is defined and git_user is defined and repository_destination is defined

  - name: Clone all roles
    git:
      repo: "{{ item }}"
      dest: "{{ repository_destination }}/{{ item | split('/') | last }}"
      clone: yes
      update: yes
      force: yes
      accept_hostkey: yes
    with_items: "{{ git_repositories }}"
    become: yes
    become_user: "{{ git_user }}"


