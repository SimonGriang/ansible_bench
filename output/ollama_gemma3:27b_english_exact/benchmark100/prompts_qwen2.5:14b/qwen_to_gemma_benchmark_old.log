---

- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install vsftpd
  apt:
    name: vsftpd
    state: present

- name: Configure vsftpd
  template:
    src: vsftpd.conf.j2
    dest: /etc/vsftpd.conf
    owner: root
    group: root
    mode: 0644
  notify: Restart vsftpd

- name: Start and enable vsftpd
  service:
    name: vsftpd
    state: started
    enabled: true


