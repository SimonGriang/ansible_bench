---
- name: Manage group {{ group.name }}
  ansible.builtin.group:
    name: "{{ group.name }}"
    state: "{{ group.state | default('present') }}"
    gid: "{{ group.gid | default(None) }}"
    system: "{{ group.system | default(False) }}"

- name: Set sudo options for group {{ group.name }}
  when: group.sudo_options is defined
  block:
    - name: Copy sudoers file
      ansible.builtin.copy:
        dest: "/etc/sudoers.d/{{ group.name }}"
        content: "{{ group.sudo_options | to_nice_yaml }}"
        owner: root
        group: root
        mode: "0440"
    - name: Stat sudoers file
      ansible.builtin.stat:
        path: "/etc/sudoers.d/{{ group.name }}"
      register: sudoers_file
    - name: Validate sudoers file
      ansible.builtin.command:
        cmd: "visudo -cf /etc/sudoers.d/{{ group.name }}"
      when: sudoers_file.stat.exists
      changed_when: true
      failed_when: false


