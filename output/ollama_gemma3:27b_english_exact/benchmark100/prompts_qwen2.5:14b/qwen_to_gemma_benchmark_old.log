---
- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Include OS-specific variables based on distribution
  include_vars:
    file: "vars/{{ ansible_distribution }}.yml"
    name: java_os_vars

- name: Include architecture-specific variables
  include_vars:
    file: "vars/{{ ansible_architecture }}.yml"
    name: java_arch_vars

- name: Set OS-specific variables (part I)
  set_fact:
    java_pkg_name: "{{ java_os_vars.java_pkg_name | default(omit) }}"
    java_state: "{{ java_os_vars.java_state | default(omit) }}"

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    java_arch_pkg_name: "{{ java_arch_vars.java_arch_pkg_name | default(omit) }}"
    java_arch_state: "{{ java_arch_vars.java_arch_state | default(omit) }}"

- name: Set specific variables
  set_fact:
    java_home: /usr/lib/jvm/java-{{ java_version }}-openjdk-amd64

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: ppa:webupd8/java
        state: absent
      when: ansible_distribution == "Debian"

    - name: Install extra apt tools
      apt:
        name: software-properties-common
        state: present
      when: ansible_distribution == "Debian"

    - name: Add key repositories
      apt_key:
        url: https://keyserver.ubuntu.com/pks/lookup?search=0x46181433FBB75451
        state: present
      when: ansible_distribution == "Debian"

    - name: Add repositories
      apt_repository:
        repo: deb http://ppa.launchpad.net/openjdk-r/ppa/ubuntu {{ ansible_distribution_release }} main
        state: present
        filename: openjdk
      when: ansible_distribution == "Debian"
  when: ansible_distribution == "Debian"

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: https://download.java.net/openjdk/latest/GPG-KEY-OpenJDK
        state: present
      when: ansible_distribution == "RedHat"

    - name: Add repositories
      yum_repository:
        name: openjdk
        description: OpenJDK Repository
        baseurl: https://download.java.net/openjdk/latest/
        gpgcheck: yes
        gpgkey: https://download.java.net/openjdk/latest/GPG-KEY-OpenJDK
        enabled: yes
      when: ansible_distribution == "RedHat"
  when: ansible_distribution == "RedHat"

- name: Install required libraries
  apt:
    name:
      - ca-certificates
      - gnupg
    state: present
  when: ansible_distribution == "Debian"

- name: Install Java, Debian
  apt:
    name: "{{ java_pkg_name }}"
    state: "{{ java_state }}"
    update_cache: yes
  when: ansible_distribution == "Debian"

- name: Install Java, RedHat
  yum:
    name: "{{ java_pkg_name }}"
    state: "{{ java_state }}"
    update_cache: yes
  when: ansible_distribution == "RedHat"

- name: Export environment variables
  template:
    src: templates/java_env.sh.j2
    dest: /etc/profile.d/java.sh
    mode: 0755

- name: Source environment variables
  shell: source /etc/profile.d/java.sh
  args:
    executable: /bin/bash

- name: Correct java version selected for Java versions less than 11
  alternatives:
    name: java
    path: /usr/lib/jvm/java-{{ java_version }}-openjdk-amd64/bin/java
    state: present
  when: ansible_distribution == "Debian" and java_version|int < 11

- name: Correct java version selected for Java versions greater than or equal to 11
  alternatives:
    name: java
    path: /usr/lib/jvm/java-{{ java_version }}-openjdk-amd64/bin/java
    state: present
  when: ansible_distribution == "Debian" and java_version|int >= 11


