content='```yaml\n---\n\n  - name: Import assert.yml\n    include_tasks: assert.yml\n    delegate_to: localhost\n    run_once: true\n\n  - name: Install python pip\n    package:\n      name: python-pip\n      state: present\n\n  - name: Configure pip proxy\n    lineinfile:\n      path: /etc/pip.conf\n      line: "proxy = {{ python_pip_proxy }}"\n    when: python_pip_proxy is defined\n\n  - name: Trust hosts\n    lineinfile:\n      path: /etc/pip.conf\n      line: "trusted-host = {{ python_pip_trusted_host }}"\n    when: python_pip_trusted_host is defined\n\n  - name: Update pip\n    pip:\n      name: pip\n      state: latest\n    when:\n      - python_pip_update\n      - ansible_distribution_release != "bookworm"\n      - ansible_distribution_release != "noble"\n      - ansible_os_family != "Alpine"\n\n  - name: Install requested modules\n    pip:\n      name: "{{ item.name }}"\n      state: "{{ item.state | default(\'present\') }}"\n      version: "{{ item.version | default(omit) }}"\n    loop: "{{ python_pip_modules }}"\n    when:\n      - ansible_distribution_release != "bookworm"\n      - ansible_distribution_release != "noble"\n      - ansible_os_family != "Alpine"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-08T10:33:24.986777156Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17931751636, 'load_duration': 222793888, 'prompt_eval_count': 539, 'prompt_eval_duration': 506580608, 'eval_count': 335, 'eval_duration': 17201209227, 'model_name': 'gemma3:27b'} id='run--cc4135b7-5fcc-40cc-ad45-ff8101772002-0' usage_metadata={'input_tokens': 539, 'output_tokens': 335, 'total_tokens': 874}
