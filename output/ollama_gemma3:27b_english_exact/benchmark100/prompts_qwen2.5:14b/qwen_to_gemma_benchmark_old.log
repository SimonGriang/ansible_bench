- name: Create directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: '0755'
  loop: "{{ httpd_directories }}"

- name: Configure directories
  ansible.builtin.template:
    src: directory.conf.j2
    dest: "{{ item }}/directory.conf"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ httpd_directories }}"
  notify:
    - test httpd configuration
    - restart httpd

- name: test httpd configuration
  ansible.builtin.command:
    cmd: apachectl configtest
  changed_when: false

- name: restart httpd
  ansible.builtin.service:
    name: httpd
    state: restarted


