---
- name: Enable proxy modules in Apache
  ansible.builtin.shell: |
    a2enmod proxy
    a2enmod proxy_http
  become: true
  when: ansible_os_family in ["Debian", "Suse"]

- name: Configure Apache locations using a template
  ansible.builtin.template:
    src: locations.conf.j2
    dest: /etc/apache2/conf-available/locations.conf
    owner: root
    group: root
    mode: '0644'
  become: true
  notify:
    - Test Apache configuration
    - Restart Apache


