content='```yaml\n---\n\n  - name: Import assert.yml\n    include_tasks: assert.yml\n\n  - name: Install required packages\n    package:\n      name: "{{ service_required_packages }}"\n      state: present\n    notify: Gather facts\n\n  - name: Configure systemd service\n    when: service_manager == "systemd"\n    template:\n      src: systemd.j2\n      dest: "/etc/systemd/system/{{ item.name }}.service"\n      mode: 0644\n    with_items: "{{ service_list }}"\n    notify: Systemctl daemon-reload\n\n  - name: Configure sysvinit service\n    when: service_manager in ["sysvinit", "upstart", "openrc"]\n    template:\n      src: sysvinit.j2\n      dest: "/etc/init.d/{{ item.name }}"\n      mode: 0755\n    with_items: "{{ service_list }}"\n\n  - name: Manage service\n    service:\n      name: "{{ item.name }}"\n      state: "{{ item.state | default(\'started\') }}"\n      enabled: "{{ item.enabled | default(true) }}"\n    with_items: "{{ service_list }}"\n\n  - name: Flush handlers\n    meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-08T09:24:51.097194929Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17579331850, 'load_duration': 194834213, 'prompt_eval_count': 566, 'prompt_eval_duration': 773162164, 'eval_count': 296, 'eval_duration': 16610226398, 'model_name': 'gemma3:27b'} id='run--31019159-f9d1-4b3e-a872-ab6808f14851-0' usage_metadata={'input_tokens': 566, 'output_tokens': 296, 'total_tokens': 862}
