---

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted

- name: Wait for all nodes to be ready again
  command: kubectl get nodes -o wide
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  register: node_status
  retries: 100
  delay: 15
  until: "Ready" in node_status.stdout
  run_once: true
  check_mode: true

- name: Wait for all pods to be ready again
  command: kubectl get pods -A -o wide
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  register: pod_status
  retries: 100
  delay: 15
  until: "Running" in pod_status.stdout or "Succeeded" in pod_status.stdout
  run_once: true
  check_mode: "{{ rke2_wait_for_all_pods_to_be_ready | default(false) }}"


