content='```yaml\n---\n\n- name: Assert usage of systemd as an init system\n  ansible.builtin.assert:\n    that: ansible_service_mgr == "systemd"\n    fail_msg: "This playbook requires systemd as the init system."\n\n- name: Get latest release of promtail\n  ansible.builtin.uri:\n    url: https://api.github.com/repos/grafana/loki/releases/latest\n    return_content: true\n  register: latest_release\n  changed_when: false\n  \n- name: Get latest release of promtail\n  ansible.builtin.set_fact:\n    promtail_version: "{{ latest_release.json.tag_name | regex_replace(\'^v\', \'\') }}"\n\n- name: Test if zip local archive exists\n  ansible.builtin.stat:\n    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.{{ go_arch }}.zip"\n  register: promtail_zip_stat\n\n- name: Assert local binary exists\n  ansible.builtin.assert:\n    that:\n      - promtail_binary_local_dir is defined\n      - promtail_zip_stat.stat.exists\n    fail_msg: "Local promtail binary archive does not exist."\n\n- name: Get checksum list\n  ansible.builtin.uri:\n    url: https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail-{{ promtail_version }}.{{ go_arch }}.zip.sha256\n    return_content: true\n  register: checksum_file\n  changed_when: false\n\n- name: Get checksum for specific architecture\n  ansible.builtin.set_fact:\n    promtail_checksum: "{{ checksum_file.content | regex_search(\'^[0-9a-f]{64}\\\\s.*$\', multiline=True) | split(\' \', 1) | first }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-08T10:24:52.183660951Z', 'done': True, 'done_reason': 'stop', 'total_duration': 25935730550, 'load_duration': 202126523, 'prompt_eval_count': 490, 'prompt_eval_duration': 473580046, 'eval_count': 451, 'eval_duration': 25259186955, 'model_name': 'gemma3:27b'} id='run--9186b365-54db-4174-8132-151a7e0850c2-0' usage_metadata={'input_tokens': 490, 'output_tokens': 451, 'total_tokens': 941}
