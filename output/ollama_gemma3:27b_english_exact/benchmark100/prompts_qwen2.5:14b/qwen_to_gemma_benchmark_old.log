- name: Check if Helm binary exists.
  stat:
    path: /usr/local/bin/helm
  register: helm_check

- name: Check Helm version.
  command: helm version --short
  register: helm_version
  when: helm_check.stat.exists

- name: Download helm.
  get_url:
    url: https://get.helm.sh/helm-v3.14.3-linux-amd64.tar.gz
    dest: /tmp/helm-v3.14.3-linux-amd64.tar.gz
  when: not helm_check.stat.exists or (helm_version.stdout is version('3.14.3', '<'))

- name: Copy helm binary into place.
  unarchive:
    src: /tmp/helm-v3.14.3-linux-amd64.tar.gz
    dest: /usr/local/bin
    remote_src: yes
  when: not helm_check.stat.exists or (helm_version.stdout is version('3.14.3', '<'))


