---
- name: Install epel
  package:
    name: epel-release
    state: absent
  become: true

- name: Install epel gpg key
  rpm_key:
    key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-7
    state: present
  become: true

- name: Install epel-release
  package:
    name: epel-release
    state: present
  become: true

- name: Install epel-next-release
  package:
    name: epel-next-release
    state: present
  become: true
  notify: Update package cache
  when: epel_next == true

