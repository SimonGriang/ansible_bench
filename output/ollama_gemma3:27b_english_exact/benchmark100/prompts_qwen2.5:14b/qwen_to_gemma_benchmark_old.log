    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file != "" and rke2_etcd_snapshot_s3_options is defined

- name: Restore etcd from file
  block:
    - name: Create the RKE2 etcd snapshot directory
      file:
        path: /var/lib/rke2/etcd/snapshots
        state: directory
        mode: '0755'
    - name: Copy the etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rke2/etcd/snapshots/
    - name: Restore etcd from the snapshot file
      command: rke2 etcd-snapshot restore
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Restore etcd from an S3 snapshot
      command: rke2 etcd-snapshot restore
      environment:
        AWS_ACCESS_KEY_ID: "{{ rke2_etcd_snapshot_s3_options.access_key }}"
        AWS_SECRET_ACCESS_KEY: "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
        AWS_REGION: "{{ rke2_etcd_snapshot_s3_options.region }}"
        S3_BUCKET: "{{ rke2_etcd_snapshot_s3_options.bucket }}"
        S3_SNAPSHOT_NAME: "{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    daemon_reload: yes
  when: inventory_hostname == groups['rke2_servers'][0]
  environment:
    RKE2_TOKEN: "{{ rke2_server_token }}"

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent
    state: stopped
    masked: yes
    daemon_reload: yes
  when: inventory_hostname == groups['rke2_servers'][0]

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: /var/lib/rke2/server/node-status.json
    timeout: 600
  when: inventory_hostname == groups['rke2_servers'][0] and rke2_use_cni == false

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: /var/lib/rke2/server/node-status.json
    timeout: 600
  when: inventory_hostname == groups['rke2_servers'][0] and rke2_use_cni == true

- name: Restore etcd
  block:
    - name: Get registered nodes
      command: kubectl get nodes -o json
      register: kubectl_get_nodes
      changed_when: false
    - name: Remove old node secrets and nodes
      command: kubectl delete node {{ item }}
      loop: "{{ kubectl_get_nodes.stdout | from_json | map(attribute='metadata.name') }}"
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: localhost
  run_once: true
  when: inventory_hostname in groups['rke2_cluster_group_name']


