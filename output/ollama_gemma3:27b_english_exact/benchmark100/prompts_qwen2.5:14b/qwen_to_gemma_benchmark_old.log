---
- name: Ensure old versions of Docker are not installed.
  apt:
    name:
      - docker
      - docker.io
    state: absent
  become: true
  when: ansible_os_family == "Debian"

- name: Ensure old versions of Docker are not installed.
  yum:
    name:
      - docker
      - docker-engine
    state: absent
  become: true
  when: ansible_os_family == "RedHat"

- name: Add Docker GPG key.
  apt_key:
    url: https://download.docker.com/linux/ubuntu/gpg
    state: present
  become: true
  when: ansible_os_family == "Debian"

- name: Add Docker repository.
  apt_repository:
    repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_distribution_release }} stable
    state: present
  become: true
  when: ansible_os_family == "Debian"

- name: Add Docker repository.
  yum_repository:
    name: docker-ce
    description: Docker CE Repository
    baseurl: https://download.docker.com/linux/centos/
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: yes
  become: true
  when: ansible_os_family == "RedHat"

- name: Configure Docker Nightly repo.
  yum_repository:
    name: docker-ce-nightly
    description: Docker CE Nightly Repository
    baseurl: https://download.docker.com/linux/centos/nightly/
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: "{{ docker_nightly_enabled }}"
  become: true
  when: ansible_os_family == "RedHat"

- name: Configure Docker Test repo.
  yum_repository:
    name: docker-ce-test
    description: Docker CE Test Repository
    baseurl: https://download.docker.com/linux/centos/test/
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: "{{ docker_test_enabled }}"
  become: true
  when: ansible_os_family == "RedHat"

- name: Configure containerd on RHEL 8.
  block:
    - name: Remove runc
      yum:
        name: runc
        state: absent
      become: true
      when: ansible_distribution_major_version == "8" and ansible_os_family == "RedHat"

    - name: Install container-selinux
      yum:
        name: container-selinux
        state: present
      become: true
      when: ansible_distribution_major_version == "8" and ansible_os_family == "RedHat"

    - name: Install containerd.io
      yum:
        name: containerd.io
        state: present
      become: true
      when: ansible_distribution_major_version == "8" and ansible_os_family == "RedHat"
  when: ansible_os_family == "RedHat"


