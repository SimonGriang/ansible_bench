  ansible.builtin.command:
    cmd: curl -sfL https://get.rke2.io | sh -s -- --version "{{ rke2_version }}"
  register: rke2_install
  changed_when: "'Installation Complete' in rke2_install.stdout"

- name: CIS Hardening
  ansible.builtin.import_tasks:
    file: cis_hardening.yml
  when: cis_profile is defined

- name: Find Active Server
  ansible.builtin.command:
    cmd: kubectl get svc -n kube-system kube-vip -o jsonpath='{.status.loadBalancer.ingress[0].ip}'
  register: active_server
  changed_when: false
  ignore_errors: true
  when: ha_mode and not rke2_server_group

- name: Enable IPVS kernel module
  ansible.builtin.modprobe:
    name: ipvs
    state: present
  when: ha_mode and not rke2_server_group

- name: Copy kube-vip manifests to the masternode
  ansible.builtin.copy:
    src: files/kube-vip/
    dest: /tmp/kube-vip/
    owner: root
    group: root
    mode: '0755'
  when: not ha_mode and not rke2_server_group

- name: Copy ingress-nginx manifests to the masternode
  ansible.builtin.copy:
    src: files/ingress-nginx/
    dest: /tmp/ingress-nginx/
    owner: root
    group: root
    mode: '0755'
  when: ingress_nginx_config is defined

- name: Prepare very first server node in the cluster
  ansible.builtin.import_tasks:
    file: prepare_first_node.yml
  when: rke2_server_group and not ha_mode

- name: Restore etcd specific tasks
  ansible.builtin.import_tasks:
    file: restore_etcd.yml
  when: restore_etcd

- name: Download kubeconfig to ansible localhost
  ansible.builtin.command:
    cmd: kubectl config view --minify --output=/tmp/kubeconfig
  register: kubeconfig_download
  changed_when: kubeconfig_download.rc == 0
  when: download_kubeconfig

- name: Prepare and join remaining nodes of the cluster
  ansible.builtin.import_tasks:
    file: join_cluster.yml
  when: active_server.stdout is defined and rke2_server_group

- name: Rolling cordon and drain restart when version changes - servers
  ansible.builtin.import_tasks:
    file: rolling_restart_servers.yml
  when: rke2_version_change and rke2_server_group

- name: Rolling cordon and drain restart when version changes - agents
  ansible.builtin.import_tasks:
    file: rolling_restart_agents.yml
  when: rke2_version_change and not rke2_server_group

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Rolling restart when config files change
  ansible.builtin.import_tasks:
    file: rolling_restart_config_change.yml
  when: config_files_changed

- name: Final steps
  ansible.builtin.import_tasks:
    file: final_steps.yml


