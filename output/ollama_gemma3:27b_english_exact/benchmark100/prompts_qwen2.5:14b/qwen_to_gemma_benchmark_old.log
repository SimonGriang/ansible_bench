---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  command: "ping -c 1 localhost"
  register: ping_result
  ignore_errors: true
  changed_when: false
  failed_when: ping_result.rc != 0 and 'ping' in ping_result.stderr

- name: Gather bootstrap facts and install necessary packages
  block:
    - name: Gather ansible facts
      setup:
    - name: Install bootstrap packages (package)
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
        update_cache: yes
  when: ping_result.rc != 0

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
