---
  - name: Create the RKE2 config directory
    file:
      path: "{{ rke2_config_dir }}"
      state: directory
      mode: '0755'
      owner: root
      group: root

  - name: Set server taints
    kubernetes.core.k8s:
      kubeconfig: "{{ kubeconfig }}"
      resource: nodes
      name: "{{ item.node }}"
      state: present
      definition:
        metadata:
          labels:
            node-role.kubernetes.io/server: ""
        spec:
          taints:
          - key: "node-role.kubernetes.io/server"
            value: ""
            effect: NoSchedule
    loop: "{{ rke2_server_nodes }}"
    when: rke2_type == 'server'

  - name: Set agent taints
    kubernetes.core.k8s:
      kubeconfig: "{{ kubeconfig }}"
      resource: nodes
      name: "{{ item.node }}"
      state: present
      definition:
        metadata:
          labels:
            node-role.kubernetes.io/agent: ""
        spec:
          taints:
          - key: "node-role.kubernetes.io/agent"
            value: ""
            effect: NoSchedule
    loop: "{{ rke2_agent_nodes }}"
    when: rke2_type == 'agent'

  - name: Copy RKE2 config file
    copy:
      src: "{{ rke2_config_file }}"
      dest: "{{ rke2_config_dir }}/config.yaml"
      owner: root
      group: root
      mode: '0644'
    notify: restart rke2

  - name: Copy kubelet config file
    copy:
      src: "{{ kubelet_config_file }}"
      dest: "{{ rke2_config_dir }}/kubelet.config"
      owner: root
      group: root
      mode: '0644'
    when: kubelet_config_file is defined and kubelet_config_file != ""
    notify: restart rke2

  - name: Copy Containerd Registry Configuration file
    copy:
      src: "{{ containerd_registry_config_file }}"
      dest: "{{ rke2_config_dir }}/containerd-registry.conf"
      owner: root
      group: root
      mode: '0644'
    when:
      - containerd_registry_config_file is defined
      - containerd_registry_config_file != ""
    notify: restart rke2

  - name: Start RKE2 service
    systemd:
      name: rke2-server
      state: restarted
      daemon_reload: yes
      enabled: yes
    retries: 5
    delay: 10
    notify: restart rke2
    ignore_errors: yes

  - name: Mask other RKE2 services
    systemd:
      name: "{{ item }}"
      masked: yes
      enabled: no
    loop: "{{ rke2_masked_services }}"
    ignore_errors: yes

  - name: Wait for remaining nodes to be ready - no CNI
    kubernetes.core.k8s_info:
      kubeconfig: "{{ kubeconfig }}"
      resource: nodes
      name: "{{ item.node }}"
      state: present
    loop: "{{ rke2_server_nodes }}"
    register: node_info
    until: node_info.resources[0].status.conditions | selectattr('type', 'equalto', 'Ready') | list | length > 0
    retries: 30
    delay: 10

  - name: Wait for remaining nodes to be ready - with CNI
    kubernetes.core.k8s_info:
      kubeconfig: "{{ kubeconfig }}"
      resource: nodes
      name: "{{ item.node }}"
      state: present
    loop: "{{ rke2_server_nodes }}"
    register: node_info
    until: node_info.resources[0].status.conditions | selectattr('type', 'equalto', 'Ready') | list | length > 0 and node_info.resources[0].status.conditions | selectattr('type', 'equalto', 'NetworkUnavailable') | list | length == 0
    retries: 30
    delay: 10


