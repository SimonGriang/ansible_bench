content='```yaml\n---\n\n- name: Check if python is installed\n  command: which python\n  register: python_check\n  ignore_errors: true\n\n- name: Check if python3 is installed\n  command: which python3\n  register: python3_check\n  ignore_errors: true\n\n- name: Debug Python executable path\n  debug:\n    msg: "Python executable path: {{ python_check.stdout }}"\n  when: python_check.stdout\n\n- name: Debug Python3 executable path\n  debug:\n    msg: "Python3 executable path: {{ python3_check.stdout }}"\n  when: python3_check.stdout\n\n- name: Import assert.yml\n  include_tasks: assert.yml\n\n- name: Install requirements\n  pip:\n    requirements: "{{ openssl_requirements }}"\n  when: openssl_requirements\n\n- name: Ensure packaging is available via dnf\n  dnf:\n    name: python3-packaging\n    state: present\n  become: true\n\n- name: Install pip packages\n  pip:\n    name: "{{ openssl_pip_packages }}"\n    state: present\n  when: openssl_pip_packages\n\n- name: Create key directory\n  file:\n    path: "{{ openssl_key_dir }}"\n    state: directory\n    mode: \'0700\'\n    owner: root\n    group: root\n  become: true\n\n- name: Create csr directory\n  file:\n    path: "{{ openssl_csr_dir }}"\n    state: directory\n    mode: \'0700\'\n    owner: root\n    group: root\n  become: true\n\n- name: Create crt directory\n  file:\n    path: "{{ openssl_crt_dir }}"\n    state: directory\n    mode: \'0700\'\n    owner: root\n    group: root\n  become: true\n\n- name: Include create.yml\n  include_tasks: create.yml\n  loop: "{{ openssl_items }}"\n  loop_control:\n    loop_var: item\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-08T10:48:14.376431362Z', 'done': True, 'done_reason': 'stop', 'total_duration': 25232071248, 'load_duration': 205411406, 'prompt_eval_count': 599, 'prompt_eval_duration': 666831719, 'eval_count': 463, 'eval_duration': 24357999146, 'model_name': 'gemma3:27b'} id='run--a17da908-fa32-4cfe-ac92-0f4f6f9647bb-0' us