content='```yaml\n---\n\n- name: Import assert.yml\n  include_tasks: assert.yml\n  delegate_to: localhost\n\n- name: Wait for port to be available\n  wait_for:\n    port: "{{ bootstrap_port }}"\n    timeout: "{{ bootstrap_timeout }}"\n\n- name: Prepare system\n  command: "ping -c 1 localhost"\n  register: ping_result\n  ignore_errors: true\n  changed_when: false\n  failed_when: ping_result.rc != 0 and \'ping\' in ping_result.stderr\n  \n- name: Gather bootstrap facts and install necessary packages\n  block:\n    - name: Gather ansible facts\n      setup:\n    - name: Install bootstrap packages (package)\n      package:\n        name: "{{ bootstrap_facts_packages }}"\n        state: present\n        update_cache: yes\n  when: ping_result.rc != 0\n\n- name: Gather ansible facts\n  setup:\n\n- name: Install bootstrap packages (package)\n  package:\n    name: "{{ bootstrap_facts_packages }}"\n    state: present\n    update_cache: yes\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-08T10:06:18.354896204Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14983138715, 'load_duration': 208908404, 'prompt_eval_count': 489, 'prompt_eval_duration': 525689979, 'eval_count': 255, 'eval_duration': 14246871248, 'model_name': 'gemma3:27b'} id='run--e0c83c60-cf57-496c-a1eb-e2c9dede953e-0' usage_metadata={'input_tokens': 489, 'output_tokens': 255, 'total_tokens': 744}
