---
- name: Create document root directories for each virtual host
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when: httpd_vhosts is defined and httpd_vhosts | length > 0

- name: Configure virtual hosts using a template
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"
  when: httpd_vhosts is defined and httpd_vhosts | length > 0

- name: Test httpd configuration validity
  ansible.builtin.command: apachectl configtest
  changed_when: false
  when: httpd_vhosts is defined and httpd_vhosts | length > 0

- name: Restart httpd service
  ansible.builtin.service:
    name: httpd
    state: restarted
  when: httpd_vhosts is defined and httpd_vhosts | length > 0


