---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  ansible.builtin.stat:
    path: /python3.11/EXTERNALLY-MANAGED
  register: python311_managed_file

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.file:
    path: /python3.11/EXTERNALLY-MANAGED
    state: absent
    name: /python3.11/EXTERNALLY-MANAGED.old
  when: python311_managed_file.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  ansible.builtin.stat:
    path: /python3.12/EXTERNALLY-MANAGED
  register: python312_managed_file

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.file:
    path: /python3.12/EXTERNALLY-MANAGED
    state: absent
    name: /python3.12/EXTERNALLY-MANAGED.old
  when: python312_managed_file.stat.exists

- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost

- name: Install python pip
  ansible.builtin.package:
    name: python3-pip
    state: present

- name: Configure pip proxy
  ansible.builtin.copy:
    dest: /etc/pip.conf
    content: "[global]\nproxy = {{ python_pip_proxy }}\n"
  when: python_pip_proxy is defined

- name: Trust hosts
  ansible.builtin.copy:
    dest: /etc/pip.conf
    content: "[global]\ntrusted-host = {{ python_pip_trusted_host }}\n"
  when: python_pip_trusted_host is defined

- name: Update pip.
  ansible.builtin.command: python3 -m pip install --upgrade pip
  when: python_pip_update and ansible_distribution != "Debian" and \
        ansible_distribution_release != "bookworm" and \
        ansible_distribution_release != "noble" and \
        ansible_distribution != "Alpine"

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ python_pip_modules }}"
    state: present
  when: python_pip_modules and ansible_distribution != "Debian" and \
        ansible_distribution_release != "bookworm" and \
        ansible_distribution_release != "noble" and \
        ansible_distribution != "Alpine"


