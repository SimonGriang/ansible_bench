---

  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Pre-configure debian systems
    apt:
      update_cache: yes
      cache_valid_time: 3600
    when: ansible_os_family == "Debian"

  - name: Install postfix
    apt:
      name: postfix
      state: present
    become: yes

  - name: Install postfix-mysql
    apt:
      name: postfix-mysql
      state: present
    become: yes
    when:
      - postfix_virtual_mailbox_maps is defined
      - postfix_virtual_mailbox_domains is defined
      - postfix_virtual_alias_maps is defined
      - "'mysql' in postfix_virtual_mailbox_maps"
      - "'mysql' in postfix_virtual_mailbox_domains"
      - "'mysql' in postfix_virtual_alias_maps"

  - name: Configure postfix (transport_maps)
    template:
      src: transport.conf.j2
      dest: /etc/postfix/transport
    notify:
      - validate postfix configuration
      - rebuild transport_maps database

  - name: Configure postfix (header_checks)
    template:
      src: header_checks.conf.j2
      dest: /etc/postfix/header_checks
    notify:
      - validate postfix configuration
      - reload postfix

  - name: Setting values for main.cf (1/2)
    set_fact:
      smtpd_recipient_restrictions_list: "{{ smtp_recipient_restrictions | default([]) }}"
      smtpd_sender_restrictions_list: "{{ smtp_sender_restrictions | default([]) }}"
    when:
      - smtp_recipient_restrictions is defined
      - smtp_sender_restrictions is defined

  - name: Setting values for main.cf (2/2)
    set_fact:
      mynetworks: "{{ mynetworks | default([]) }}"
      mydestination: "{{ mydestination | default([]) }}"
      relay_domains: "{{ relay_domains | default([]) }}"
      smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions_list + ['reject_unauth_destination'] | unique }}"
      smtpd_sender_restrictions: "{{ smtpd_sender_restrictions_list + ['reject_unknown_sender_domain'] | unique }}"
      virtual_mailbox_domains: "{{ virtual_mailbox_domains | default([]) }}"
      virtual_alias_domains: "{{ virtual_alias_domains | default([]) }}"

  - name: Configure postfix (main.cf)
    template:
      src: main.conf.j2
      dest: /etc/postfix/main.cf
    notify:
      - validate postfix configuration
      - restart postfix

  - name: Configure postfix (master.cf)
    template:
      src: master.conf.j2
      dest: /etc/postfix/master.cf
    notify:
      - validate postfix configuration
      - restart postfix

  - name: Creates cert/key directory
    file:
      path: "{{ item }}"
      state: directory
      owner: root
      group: root
      mode: '0755'
    loop:
      - "{{ postfix_smtpd_tls_cert_dir }}"
      - "{{ postfix_smtpd_tls_key_dir }}"
    become: yes

  - name: Deploy Postfix TLS server certificate
    copy:
      src: "{{ postfix_smtpd_tls_cert_file }}"
      dest: "{{ postfix_smtpd_tls_cert_file }}"
      owner: root
      group: root
      mode: '0644'
    notify:
      - reload postfix

  - name: Deploy Postfix TLS server key
    copy:
      src: "{{ postfix_smtpd_tls_key_file }}"
      dest: "{{ postfix_smtpd_tls_key_file }}"
      owner: root
      group: root
      mode: '0600'
    notify:
      - reload postfix

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure aliases
    lineinfile:
      path: /etc/aliases
      line: "{{ item }}"
      create: yes
    loop: "{{ postfix_aliases }}"
    notify:
      - rebuild alias database
      - reload postfix

  - name: Configure sender_access
    copy:
      dest: /etc/postfix/sender_access
      content: "{{ postfix_sender_access_content }}"
    notify:
      - rebuild sender_access database
      - reload postfix

  - name: Configure recipient_access
    copy:
      dest: /etc/postfix/recipient_access
      content: "{{ postfix_recipient_access_content }}"
    notify:
      - validate postfix configuration
      - rebuild recipient_access database
      - reload postfix

  - name: Place sasl_password_map
    copy:
      dest: /etc/postfix/sasl_password_map
      content: "{{ postfix_sasl_password_map_content }}"
    notify:
      - rebuild sasl_password_map database

  - name: Flush handlers again
    meta: flush_handlers

  - name: Start and enable postfix
    service:
      name: postfix
      state: started
      enabled: yes


