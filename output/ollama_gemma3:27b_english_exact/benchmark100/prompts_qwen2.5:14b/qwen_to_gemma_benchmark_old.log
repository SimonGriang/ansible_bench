---
- name: hardening | Disable swap
  ansible.builtin.meta:
    end_host: true
  when: vault_hardening_disable_swap

- name: hardening | Disable swap now
  ansible.builtin.command: swapoff -a
  when: vault_hardening_disable_swap and ansible_facts.swap_enabled

- name: hardening | Disable swap permanently
  ansible.builtin.mount:
    path: "{{ item }}"
    state: absent
  loop: "{{ ansible_facts.mounts | selectattr('mountpoint', 'defined') | selectattr('device', 'match', '^/dev/.*') | map(attribute='mountpoint') | list }}"
  when: vault_hardening_disable_swap

