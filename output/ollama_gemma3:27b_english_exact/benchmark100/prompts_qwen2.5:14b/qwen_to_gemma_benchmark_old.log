---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: "0755"
    timeout: 300

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_local_install_script }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: "0700"
    force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: "0700"
  when: rke2_airgap_mode and rke2_airgap_implementation != "exists"

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download Checksum
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_artifacts_path }}/rke2.sha256"
        mode: "0644"
        timeout: 300
    - name: Download Artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}/rke2.tar.gz"
        mode: "0644"
        timeout: 300
    - name: Download Install Script
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_dest }}"
        mode: "0755"
        timeout: 300
  when: rke2_airgap_mode and rke2_airgap_implementation == "download"

- name: Rescue for failed download
  block:
    - name: Create rescue directory
      file:
        path: "{{ rke2_local_artifacts_path }}"
        state: directory
        mode: "0700"
    - name: Download artifacts locally
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_local_artifacts_path }}/rke2.tar.gz"
        mode: "0644"
        timeout: 300
    - name: Download install script locally
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_local_install_script }}"
        mode: "0755"
        timeout: 300
    - name: Copy local artifacts to remote
      copy:
        src: "{{ rke2_local_artifacts_path }}/rke2.tar.gz"
        dest: "{{ rke2_artifacts_path }}/rke2.tar.gz"
        mode: "0644"
    - name: Copy local install script to remote
      copy:
        src: "{{ rke2_local_install_script }}"
        dest: "{{ rke2_install_script_dest }}"
        mode: "0755"
  when: rke2_airgap_mode and rke2_airgap_implementation == "download"

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifacts_path }}/rke2.tar.gz"
    dest: "{{ rke2_artifacts_path }}/rke2.tar.gz"
    mode: "0640"
    force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ rke2_airgap_copy_additional_tarballs }}"
    dest: "{{ rke2_tarball_images_path }}"
    mode: "0644"
    force: yes
  when: rke2_airgap_mode and rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  stat:
    path: "{{ rke2_artifacts_path }}/rke2.tar.gz"
    get_checksum: yes
  register: rke2_artifact_stat
  when: rke2_airgap_mode and rke2_airgap_implementation == "exists"

- name: Populate service facts
  setup:
    gather_subset:
      - services

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Check if separate partition
  shell: grep -c /usr/local /proc/mounts
  register: separate_partition
  changed_when: false

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin
  when: usr_local_stat.stat.exists and separate_partition.stdout == "0"

- name: Check RKE2 version
  shell: |
    rke2 --version 2>&1 | grep -Po '(?<=version\s)\S+'
  register: rke2_version
  ignore_errors: true

- name: Set RKE2 versions
  set_fact:
    installed_rke2_version: "{{ rke2_version.stdout | default('unknown') }}"
    running_rke2_version: "{{ rke2_version.stdout | default('unknown') }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  fail:
    msg: "Downgrading RKE2 is not allowed. Current version: {{ running_rke2_version }}, Attempted version: {{ rke2_version_to_install }}"
  when: rke2_version_to_install != "latest" and installed_rke2_version != "unknown" and installed_rke2_version > rke2_version_to_install

- name: Run RKE2 install script
  shell: |
    {{ rke2_install_script_dest }} --version
  args:
    executable: /bin/bash
  when: rke2_version_to_install != installed_rke2_version and not ansible_check_mode

- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_custom_manifests }}"
    dest: "{{ rke2_data_path }}"
    mode: "0644"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods }}"
    dest: "{{ rke2_agent_pod_manifests_path }}"
    mode: "0644"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_environment_file }}"
    dest: "{{ rke2_environment_file_dest }}"
    mode: "0644"
  when: rke2_environment_options | length > 0


