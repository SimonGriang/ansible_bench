---

- name: hardening | Disable swap
  ansible.builtin.meta:
    end_host: true
  when: vault_hardening_disable_swap

- name: hardening | Disable swap now
  ansible.builtin.command: swapoff -a
  when: vault_hardening_disable_swap and ansible_facts.swap_enabled

- name: hardening | Disable swap permanently
  ansible.builtin.mount:
    path: "{{ item }}"
    state: absent
  loop: "{{ ansible_facts.mounts | selectattr('mountpoint', 'defined') | selectattr('device', 'match', '^/dev/.*') | map(attribute='mountpoint') | list }}"
  when: vault_hardening_disable_swap

- name: hardening | Disable core dumps
  ansible.builtin.command: ulimit -c 0
  when: vault_hardening_disable_core_dumps

- name: hardening | Disable Shell Command History
  ansible.builtin.copy:
    dest: /etc/profile.d/disable_history.sh
    content: |
      HISTSIZE=0
      HISTFILESIZE=0
      export HISTSIZE HISTFILESIZE
  when: vault_hardening_disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  ansible.builtin.meta:
    end_host: true
  when: vault_hardening_configure_selinux_apparmor

- name: hardening | Enable SELinux
  ansible.builtin.package:
    name: selinux-policy
    state: present
  when: vault_hardening_configure_selinux_apparmor

- name: hardening | Install selinux-policy
  ansible.builtin.package:
    name: selinux-policy
    state: present

- name: hardening | Set SELinux policy
  ansible.builtin.selinux:
    policy: targeted
    state: enforcing

- name: hardening | Enable AppArmor (enforcing)
  ansible.builtin.apparmor:
    profile: /etc/apparmor.d/vault
    state: enforce


