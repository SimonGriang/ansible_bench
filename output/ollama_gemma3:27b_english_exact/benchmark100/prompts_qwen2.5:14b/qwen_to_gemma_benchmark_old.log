---

- name: Enable proxy and proxy_http modules on Debian and Suse systems
  become: true
  ansible.builtin.lineinfile:
    path: /etc/apache2/mods-available/proxy.load
    regexp: '^#LoadModule proxy_module'
    line: 'LoadModule proxy_module modules/mod_proxy.so'
    state: present
  when: ansible_os_family == "Debian"

- name: Enable proxy and proxy_http modules on Debian and Suse systems
  become: true
  ansible.builtin.lineinfile:
    path: /etc/apache2/mods-available/proxy_http.load
    regexp: '^#LoadModule proxy_http_module'
    line: 'LoadModule proxy_http_module modules/mod_proxy_http.so'
    state: present
  when: ansible_os_family == "Debian"

- name: Enable proxy and proxy_http modules on Debian and Suse systems
  become: true
  ansible.builtin.lineinfile:
    path: /etc/httpd/conf.modules.d/00-proxy.conf
    regexp: '^#LoadModule proxy_module'
    line: 'LoadModule proxy_module modules/mod_proxy.so'
    state: present
  when: ansible_os_family == "Suse"

- name: Enable proxy and proxy_http modules on Debian and Suse systems
  become: true
  ansible.builtin.lineinfile:
    path: /etc/httpd/conf.modules.d/00-proxy_http.conf
    regexp: '^#LoadModule proxy_http_module'
    line: 'LoadModule proxy_http_module modules/mod_proxy_http.so'
    state: present
  when: ansible_os_family == "Suse"

- name: Configure locations using a template
  become: true
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
  loop: "{{ httpd_locations }}"
  notify:
    - httpd configuration test
    - httpd restart


