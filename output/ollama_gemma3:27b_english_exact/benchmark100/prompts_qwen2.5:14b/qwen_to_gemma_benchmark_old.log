---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    connect_timeout: "{{ bootstrap_timeout }}"
    delay: 2
    state: started

- name: Prepare system
  become: true
  become_user: root
  become_method: sudo
  connection: ssh
  ansible.builtin.shell: |
    set -o pipefail
    echo "Testing connection and sudo"

- name: Gather bootstrap facts
  ansible.builtin.setup:
  when: ansible_failed_result is defined

- name: Install bootstrap packages (raw)
  ansible.builtin.raw: |
    {% if ansible_os_family == "Debian" %}
      apt-get update && apt-get install -y --no-install-recommends curl gnupg2
    {% elif ansible_os_family == "RedHat" %}
      yum install -y curl gnupg2
    {% endif %}

- name: Ensure libdnf5 is present on Fedora/RedHat
  ansible.builtin.package:
    name: libdnf5
    state: present
  when: ansible_os_family == "RedHat"

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name:
      - python3
      - python3-pip
    state: present
  become: true
  become_user: root
  become_method: sudo
  when: ansible_failed_result is not defined


