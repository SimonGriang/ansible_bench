    state: directory
    mode: '0700'
    owner: root
    group: root
  become: true

- name: Create csr directory
  file:
    path: "{{ openssl_csr_dir }}"
    state: directory
    mode: '0700'
    owner: root
    group: root
  become: true

- name: Create crt directory
  file:
    path: "{{ openssl_crt_dir }}"
    state: directory
    mode: '0700'
    owner: root
    group: root
  become: true

- name: Include create.yml
  include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item


