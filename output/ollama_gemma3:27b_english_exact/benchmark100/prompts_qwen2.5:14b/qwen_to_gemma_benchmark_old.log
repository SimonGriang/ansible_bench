---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Set selinux httpd boolean
      sebool:
        name: httpd_can_network_connect
        state: true
    - name: Allow custom ports
      firewalld:
        port: "{{ httpd_custom_port }}/tcp"
        permanent: true
        state: enabled
      when: ansible_os_family == "RedHat" and httpd_custom_port is defined

- name: Configure httpd
  template:
    src: httpd.conf.j2
    dest: "{{ httpd_config_file }}"
  notify:
    - test httpd config
    - restart httpd

- name: Activate httpd module | Debian
  block:
    - name: Enable module
      command: a2enmod "{{ item }}"
      loop: "{{ httpd_modules }}"
      notify:
        - test httpd config
        - restart httpd
      changed_when: false
  when: ansible_os_family == "Debian"

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: httpd_ssl_enabled

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined and httpd_locations | length > 0

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined and httpd_vhosts | length > 0

- name: Configure ports
  template:
    src: ports.conf.j2
    dest: "{{ httpd_ports_file }}"
  notify:
    - test httpd config
    - restart httpd
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined and httpd_directories | length > 0

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_default_html_path }}"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


