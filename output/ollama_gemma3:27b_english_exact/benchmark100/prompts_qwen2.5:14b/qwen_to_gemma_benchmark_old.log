---
- name: create | Create ssl key
  ansible.builtin.file:
    path: "{{ item.path }}/{{ item.name }}.key"
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    state: touch
  loop: "{{ ssl_items }}"

- name: create | Create ssl csr
  ansible.builtin.file:
    path: "{{ item.path }}/{{ item.name }}.csr"
    mode: '0644'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    state: touch
  loop: "{{ ssl_items }}"

- name: create | Create ssl certificates
  ansible.builtin.file:
    path: "{{ item.path }}/{{ item.name }}.crt"
    mode: '0644'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    state: touch
  loop: "{{ ssl_items }}"

- name: create | Create PKCS#12 file
  ansible.builtin.file:
    path: "{{ item.path }}/{{ item.name }}.p12"
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    state: touch
  loop: "{{ ssl_items }}"

- name: create | Read private key
  ansible.builtin.slurp:
    src: "{{ item.path }}/{{ item.name }}.key"
  register: private_key_result
  loop: "{{ ssl_items }}"

- name: create | Read certificate
  ansible.builtin.slurp:
    src: "{{ item.path }}/{{ item.name }}.crt"
  register: certificate_result
  loop: "{{ ssl_items }}"

- name: create | Create combined private_key and certificate file
  ansible.builtin.copy:
    dest: "{{ item.path }}/{{ item.name }}.pem"
    content: "{{ private_key_result[loop.index].content }}\n{{ certificate_result[loop.index].content }}"
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"


