    file:
      path: "{{ item }}"
      state: directory
      owner: root
      group: root
      mode: '0755'
    loop:
      - "{{ postfix_smtpd_tls_cert_dir }}"
      - "{{ postfix_smtpd_tls_key_dir }}"
