          - key: "node-role.kubernetes.io/agent"
            value: ""
            effect: NoSchedule
    loop: "{{ rke2_agent_nodes }}"
    when: rke2_type == 'agent'

  - name: Copy RKE2 config file
    copy:
      src: "{{ rke2_config_file }}"
      dest: "{{ rke2_config_dir }}/config.yaml"
      owner: root
      group: root
      mode: '0644'
    notify: restart rke2

  - name: Copy kubelet config file
    copy:
      src: "{{ kubelet_config_file }}"
      dest: "{{ rke2_config_dir }}/kubelet.config"
      owner: root
      group: root
      mode: '0644'
    when: kubelet_config_file is defined and kubelet_config_file != ""
    notify: restart rke2

  - name: Copy Containerd Registry Configuration file
    copy:
      src: "{{ containerd_registry_config_file }}"
      dest: "{{ rke2_config_dir }}/containerd-registry.conf"
      owner: root
      group: root
      mode: '0644'
    when:
