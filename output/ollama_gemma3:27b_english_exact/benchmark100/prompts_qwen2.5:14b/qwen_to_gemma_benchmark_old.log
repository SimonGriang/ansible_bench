---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: yes
  notify: Reboot System

- name: Configure apt
  apt:
    update_cache: yes
    upgrade: yes
    autoremove: yes
    prevent_upgrade:
      - kernel*
  notify: Reboot System

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    exclude:
      - kernel*
  notify: Reboot System

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes
  notify: Reboot System

- name: Configure yum
  yum:
    name: '*'
    state: latest
    update_cache: yes
  when: ansible_pkg_mgr == "yum"
  register: yum_result
  until: yum_result is succeeded
  become: true
  notify: Reboot System

- name: Install yum-utils if needed
  yum:
    name: yum-utils
    state: present
  become: true
  when: ansible_pkg_mgr == "yum" and yum_result is failed

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest
    update_cache: yes
  notify: Reboot System


