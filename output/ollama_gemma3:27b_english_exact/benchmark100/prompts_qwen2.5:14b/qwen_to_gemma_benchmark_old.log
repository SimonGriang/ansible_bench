---

  - name: Install epel
    package:
      name: epel-release
      state: present
    become: true
    when: ansible_distribution in ["Amazon", "RedHat", "CentOS"] and ansible_distribution_major_version in ["7", "8", "9"]

  - name: Install epel gpg key
    rpm_key:
      key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-7
      state: present
    become: true

  - name: Install epel-release
    package:
      name: epel-release
      state: present
    become: true

  - name: Install epel-next-release
    package:
      name: epel-next-release
      state: present
    become: true
    when: epel_next is defined and epel_next == true
    notify: Update package cache


