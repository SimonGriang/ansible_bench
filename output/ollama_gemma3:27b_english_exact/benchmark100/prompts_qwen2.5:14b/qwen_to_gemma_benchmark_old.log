- name: Install DEB
  package:
    deb: /tmp/java.deb
    state: present
  when: java_vendor == "oracle" and ansible_os_family == "Debian"

- name: Install oracle java (rpm) (repository)
  yum:
    name: java-1.8.0-openjdk
