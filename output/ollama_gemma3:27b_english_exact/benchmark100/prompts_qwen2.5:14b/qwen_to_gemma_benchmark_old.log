---
- name: create | Create ssl key
  openssl_private_key:
    path: "{{ ssl_key_path }}"
    size: 2048
    type: rsa
    passphrase: "{{ ssl_passphrase }}"
  owner: "{{ ssl_owner }}"
  group: "{{ ssl_group }}"
  mode: '0600'

- name: create | Create ssl csr
  openssl_csr:
    path: "{{ ssl_csr_path }}"
    private_key: "{{ ssl_key_path }}"
    common_name: "{{ inventory_hostname }}"
    state: present
  owner: "{{ ssl_owner }}"
  group: "{{ ssl_group }}"
