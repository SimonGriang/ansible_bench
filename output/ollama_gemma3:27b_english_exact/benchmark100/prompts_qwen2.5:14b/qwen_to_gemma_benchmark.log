content='```yaml\n---\n- name: Ensure document root directories are created for each virtual host\n  ansible.builtin.file:\n    path: "{{ item.docroot }}"\n    state: directory\n    mode: \'0755\'\n  loop: "{{ httpd_vhosts }}"\n  when: item.docroot is defined and (create_docroot is not defined or create_docroot)\n\n- name: Create virtual host configuration files\n  ansible.builtin.template:\n    src: vhost_conf_template\n    dest: "{{ httpd_vhosts_directory }}/{{ item.servername }}.conf"\n    mode: \'0644\'\n  loop: "{{ httpd_vhosts }}"\n  notify:\n    - test apache configuration\n    - restart apache\n\n- name: Enable virtual hosts on Debian-based systems\n  ansible.builtin.command: a2ensite "{{ item.servername }}.conf"\n  loop: "{{ httpd_vhosts }}"\n  when: ansible_os_family == \'Debian\'\n  creates: "/etc/apache2/sites-enabled/{{ item.servername }}.conf"\n  notify:\n    - test apache configuration\n    - restart apache\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-18T13:58:45.311610485Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16222825016, 'load_duration': 201898117, 'prompt_eval_count': 510, 'prompt_eval_duration': 1640025695, 'eval_count': 272, 'eval_duration': 14379776825, 'model_name': 'gemma3:27b'} id='run--0cd2a2c7-7b81-42f9-bfc1-80cc7cb3d51a-0' usage_metadata={'input_tokens': 510, 'output_tokens': 272, 'total_tokens': 782}
