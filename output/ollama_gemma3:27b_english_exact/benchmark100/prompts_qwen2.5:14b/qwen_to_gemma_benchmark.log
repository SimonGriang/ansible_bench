      mode: "{{ ssl_csr_mode | default('0600') }}"

  - name: create | Create ssl certificates
    openssl_certificate:
      path: "{{ ssl_cert_path }}"
      private_key: "{{ ssl_key_path }}"
      csr: "{{ ssl_csr_path }}"
      owner: "{{ ssl_cert_owner | default('root') }}"
