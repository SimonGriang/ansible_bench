---

  - name: Import assert.yml
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install logrotate
    package:
      name: "{{ logrotate_packages }}"
      state: present

  - name: Configure logrotate
    template:
      src: "{{ logrotate_config_file }}"
      dest: "{{ logrotate_config_directory }}/logrotate.conf"

  - name: Generate logrotate.d files
    loop: "{{ logrotate_entries }}"
    when: logrotate_entries is defined and item.state is not defined or item.state != "absent"
    template:
      src: "logrotate.d/{{ item.name }}.j2"
      dest: "{{ logrotate_config_directory }}/{{ item.name }}"

  - name: Remove logrotate.d files
    loop: "{{ logrotate_entries }}"
    when: logrotate_entries is defined and item.state == "absent"
    file:
      path: "{{ logrotate_config_directory }}/{{ item.name }}"
      state: absent

  - name: Start logrotate
    service:
      name: "{{ logrotate_service }}"
      state: "{{ logrotate_service_state }}"
      enabled: "{{ logrotate_service_enabled }}"
    when: logrotate_service is defined


