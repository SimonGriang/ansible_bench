n: do_etcd_restore or do_etcd_restore_from_s3\n    when: do_etcd_restore or do_etcd_restore_from_s3\n\n  - name: Set an Active Server variable\n    set_fact:\n      active_server: "{{ inventory_hostname }}"\n    delegate_to: localhost\n    when: inventory_hostname in groups[\'rke2_cluster_group_name\']\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-18T15:19:55.816689842Z', 'done': True, 'done_reason': 'stop', 'total_duration': 86680660803, 'load_duration': 213627182, 'prompt_eval_count': 2690, 'prompt_eval_duration': 8587986785, 'eval_count': 1362, 'eval_duration': 77877521133, 'model_name': 'gemma3:27b'} id='run--8cab7abf-f54e-46da-a8f2-50444fe1c11e-0' usage_metadata={'input_tokens': 2690, 'output_tokens': 1362, 'total_tokens': 4052}
