- name: Include architecture-specific variables
  include_vars:
    file: "vars/{{ ansible_architecture }}.yml"
    name: java_arch_vars

- name: Set OS-specific variables (part I)
  set_fact:
    java_pkg_name: "{{ java_os_vars.java_pkg_name | default(omit) }}"
    java_state: "{{ java_os_vars.java_state | default(omit) }}"

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    java_arch_pkg_name: "{{ java_arch_vars.java_arch_pkg_name | default(omit) }}"
    java_arch_state: "{{ java_arch_vars.java_arch_state | default(omit) }}"

- name: Set specific variables
  set_fact:
    java_home: /usr/lib/jvm/java-{{ java_version }}

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: 'ppa:webupd8/java'
        state: absent
    - name: Install extra apt tools
      apt:
        name: software-properties-common
        state: present
    - name: Add key repositories
      apt_key:
        url: https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x48836387586B6A64
        state: present
    - name: Add repositories
      apt_repository:
        repo: 'deb http://ppa.launchpad.net/openjdk-r/ppa/ubuntu {{ ansible_distribution_release }} main'
        state: present
      when: ansible_distribution == 'Ubuntu'
  become: true
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: https://download.java.net/java/jdk11/GPG-KEY-java
        state: present
    - name: Add repositories
      yum_repository:
        name: java-{{ java_version }}
        description: Java {{ java_version }} repository
        baseurl: https://download.java.net/java/{{ java_version }}/
        gpgcheck: yes
        gpgkey: https://download.java.net/java/jdk11/GPG-KEY-java
        enabled: yes
  become: true
  when: ansible_os_family == 'RedHat'

- name: Install required libraries
  apt:
    name:
      - ca-certificates
      - gnupg
    state: present
  become: true
  when: ansible_os_family == 'Debian'

- name: Install Java, Debian
  block:
    - name: Update apt cache
      apt:
        update_cache: yes
        cache_valid_time: 3600
      become: true
    - name: Install Java
      apt:
        name: "{{ java_pkg_name }}"
        state: present
      become: true
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  block:
    - name: Update yum cache
      yum:
        update_cache: yes
        cache_valid_time: 3600
      become: true
    - name: Install Java
      yum:
        name: "{{ java_pkg_name }}"
        state: present
      become: true
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  template:
    src: java_env.j2
    dest: /etc/profile.d/java.sh
  become: true

- name: Source environment variables
  shell: source /etc/profile.d/java.sh
  become: true

- name: Correct java version selected for Java versions less than 11
  alternatives:
    name: java
    path: /usr/lib/jvm/java-{{ java_version }}/bin/java
    state: auto
  become: true
  when: ansible_os_family == 'Debian' and java_version|int < 11

- name: Correct java version selected for Java versions greater than or equal to 11
  alternatives:
    name: java
    path: /usr/lib/jvm/java-{{ java_version }}/bin/java
    state: auto
  become: true
  when: ansible_os_family == 'Debian' and java_version|int >= 11
