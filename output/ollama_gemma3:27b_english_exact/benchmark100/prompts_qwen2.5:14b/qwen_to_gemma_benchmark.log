---

- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    connect_timeout: "{{ bootstrap_timeout }}"
    delay: 2
    state: started

- name: Prepare system
  become: true
  become_user: root
  become_method: sudo
  connection: ssh
  tasks:
    - name: Test connection
      ping:
    - name: Test sudo
      command: sudo -n true
      register: sudo_test
      ignore_errors: true
      changed_when: false
      failed_when: sudo_test.rc != 0 and sudo_test.rc != 1

- name: Gather bootstrap facts
  setup:
    filter: ansible_distribution*
  when: sudo_test.rc != 0 and sudo_test.rc != 1

- name: Install bootstrap packages (raw)
  raw: "{{ item }}"
  become: true
  become_user: root
  loop:
    - "apt-get update"
    - "apt-get install -y curl gnupg2"
  when: ansible_os_family == "Debian"
  ignore_errors: true

- name: Install bootstrap packages (raw)
  raw: "{{ item }}"
  become: true
  become_user: root
  loop:
    - "yum install -y curl"
    - "dnf install -y curl"
  when: ansible_os_family == "RedHat"
  ignore_errors: true

- name: Ensure libdnf5 is present on Fedora/RedHat
  package:
    name: libdnf5
    state: present
  become: true
  become_user: root
  when: ansible_distribution in ["Fedora", "RedHat"]

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name:
      - curl
      - gnupg
    state: present
  become: true
  become_user: root
  when: ansible_os_family != "RedHat"


