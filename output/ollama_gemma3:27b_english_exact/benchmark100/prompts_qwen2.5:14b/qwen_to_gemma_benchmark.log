---

- name: gather_facts | Lookup bootstrap facts
  setup:
    filter: ansible_distribution*
  register: bootstrap_facts

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ bootstrap_facts.ansible_facts.ansible_distribution }}"
    bootstrap_distribution_major_version: "{{ item.version | regex_search('^\\d+(\\.\\d+)?') }}"
  loop:
    - { version: bootstrap_facts.ansible_facts.ansible_distribution_version }
  when: bootstrap_facts.ansible_facts.ansible_distribution is defined

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ bootstrap_os_family_map[bootstrap_distribution] }}"
  vars:
    bootstrap_os_family_map:
      Amazon: RedHat
      CentOS: RedHat
      Debian: Debian
      Fedora: RedHat
      RedHat: RedHat
      Ubuntu: Debian
      SUSE: SUSE
      openSUSE: SUSE
  when: bootstrap_distribution is defined


