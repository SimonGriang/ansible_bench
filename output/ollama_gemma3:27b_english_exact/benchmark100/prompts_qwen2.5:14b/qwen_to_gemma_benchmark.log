---

  - name: Import assert.yml
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Configure apk
    apk:
      update_cache: true
      upgrade: true
    notify: Reboot System

  - name: Configure apt
    apt:
      prevent_upgrade:
        - kernel*
      update_cache: true
      upgrade: dist
      autoremove: true
    notify: Reboot System

  - name: Update all software (dnf)
    dnf:
      name: '*'
      exclude: kernel*
      state: latest
    notify: Reboot System

  - name: Update all software (pacman)
    pacman:
      update_cache: true
      upgrade: true
    notify: Reboot System

  - name: Configure yum
    yum:
      name: '*'
      state: latest
    when: ansible_pkg_mgr == "yum"
    register: yum_update_result
    until: yum_update_result.changed == false
    notify: Reboot System

  - name: Install yum-utils if not present
    yum:
      name: yum-utils
      state: present
    when: ansible_pkg_mgr == "yum" and yum_update_result.changed

  - name: Update all software (zypper)
    zypper:
      name: '*'
      state: latest
    notify: Reboot System

  handlers:
    - name: Reboot System
      reboot:
        msg: "Reboot initiated by Ansible"
        connect_timeout: 5
        reboot_timeout: 300
        pre_delay: 0


