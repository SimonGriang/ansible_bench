content='```yaml\n---\n- name: Import assert.yml\n  ansible.builtin.import_tasks: assert.yml\n  delegate_to: localhost\n  run_once: true\n\n- name: Install php\n  ansible.builtin.package:\n    name: "{{ php_packages }}"\n    state: present\n\n- name: Find used php.ini\n  ansible.builtin.shell: "find / -name php.ini 2>/dev/null"\n  register: php_found_ini_location\n  when: php_ini_location is not defined\n\n- name: Configure php\n  ansible.builtin.template:\n    src: php.ini.j2\n    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"\n    mode: \'0644\'\n  notify: restart httpd\n  changed_when: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-18T15:01:54.611263398Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13969834180, 'load_duration': 207178400, 'prompt_eval_count': 756, 'prompt_eval_duration': 2658410226, 'eval_count': 201, 'eval_duration': 11103017160, 'model_name': 'gemma3:27b'} id='run--1c0dc356-15fe-4501-b60a-40f92a9ac37f-0' usage_metadata={'input_tokens': 756, 'output_tokens': 201, 'total_tokens': 957}
