---

- name: Check if all variables have been set correctly
  assert:
    that:
      - bootstrap_wait_for_host is defined
      - bootstrap_install is defined
      - bootstrap_install.raw is defined
      - bootstrap_facts_file is defined

- name: Wait for host (when configured)
  ansible.builtin.wait_for_connection:
    host: "{{ inventory_hostname }}"
    port: 22
    timeout: 300
  when: bootstrap_wait_for_host | bool

- name: Prepare system
  block:
    - name: Gather facts
      ansible.builtin.setup:
    - name: Include tasks to gather bootstrap facts (raw)
      ansible.builtin.include_tasks: "{{ bootstrap_facts_file }}"
    - name: Install bootstrap packages (raw)
      ansible.builtin.raw: "{{ bootstrap_install.raw }}"
      become: true
      when: ansible_facts.os_family == "Debian"
  rescue:
    - name: Debug message if connection fails
      ansible.builtin.debug:
        msg: "Failed to connect to host or gather facts."

- name: Ensure system is prepared by issuing ansible modules.
  block:
    - name: Gather ansible facts
      ansible.builtin.setup:
    - name: Install bootstrap packages
      ansible.builtin.package:
        name: "{{ bootstrap_install.packages }}"
        state: present
      become: true


