---

- name: Enable proxy and proxy_http modules on Debian and Suse systems
  become: true
  ansible.builtin.apache2_module:
    name: proxy
    state: present
  when: ansible_os_family in ["Debian", "Suse"]

- name: Enable proxy and proxy_http modules on Debian and Suse systems
  become: true
  ansible.builtin.apache2_module:
    name: proxy_http
    state: present
  when: ansible_os_family in ["Debian", "Suse"]

- name: Configure locations using a template
  become: true
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ item.destination }}"
    mode: "{{ item.mode }}"
  loop: "{{ httpd_locations }}"
  notify:
    - httpd configuration test
    - httpd restart


