---
- name: Lookup bootstrap facts
  command: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_search('NAME=\"(.*)\"', '\\1') }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search('VERSION_ID=\"(.*)\"', '\\1') | split('.') | first }}"

- name: Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ bootstrap_os_family_map.get(bootstrap_distribution, 'Unknown') }}"
  vars:
    bootstrap_os_family_map:
      Ubuntu: Ubuntu
      Debian: Debian
      CentOS: RedHat
      RedHat: RedHat
      AlmaLinux: RedHat
      RockyLinux: RedHat
      Fedora: RedHat
      SUSE: SUSE
      Amazon: Amazon
      OracleLinux: RedHat
      Archlinux: Archlinux
      Alpine: Alpine
      Gentoo: Gentoo
      openSUSE: SUSE
      Kali: Debian
      Mint: Ubuntu


