---
- name: Ensure apt key is not present in trusted.gpg.d
  file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Ensure old apt source list is not present in /etc/apt/sources.list.d
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure old versions of Docker are not installed.
  apt:
    name: docker.io
    state: absent
    purge: yes

- name: Ensure legacy repo file is not present.
  file:
    path: /etc/apt/sources.list.d/docker.list.old
    state: absent

- name: Ensure dependencies are installed.
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: yes

- name: Add or remove Docker repository.
  block:
    - name: Add Docker repository
      apt_repository:
        repo: deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable
        state: present
        filename: docker
      when: docker_add_repo
    - name: Remove Docker repository
      apt_repository:
        repo: deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable
        state: absent
        filename: docker
      when: not docker_add_repo
  notify: apt update

- name: Ensure handlers are notified immediately to update the apt cache.
  meta:
    flush_handlers: true


