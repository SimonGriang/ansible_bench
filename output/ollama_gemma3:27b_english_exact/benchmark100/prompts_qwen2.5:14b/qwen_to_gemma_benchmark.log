---

- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  shell: "ping -c 1 localhost && sudo -n true"
  ignore_errors: true
  register: prepare_result
  changed_when: false
  failed_when: prepare_result.rc > 1
  
- name: Gather bootstrap facts and install necessary packages
  raw: |
    apt-get update && apt-get install -y python3 python3-pip
  become: yes
  when: prepare_result.rc > 0

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes


