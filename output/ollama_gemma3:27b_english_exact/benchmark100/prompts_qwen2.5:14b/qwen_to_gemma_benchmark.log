  ansible.builtin.template:
    src: httpd.conf.j2
    dest: "{{ httpd_config }}"
  notify:
    - test httpd configuration
    - restart httpd

- name: Activate httpd module | Debian
  block:
    - name: Activate Apache modules
      command: a2enmod "{{ item }}"
      with_items: "{{ httpd_modules }}"
      notify:
        - test httpd configuration
        - restart httpd
  when: ansible_os_family == "Debian"

- name: Import ssl.yml
  ansible.builtin.import_tasks: ssl.yml
  when: httpd_ssl_enabled

- name: Import locations.yml
  ansible.builtin.import_tasks: locations.yml
  when: httpd_locations

- name: Import vhosts.yml
  ansible.builtin.import_tasks: vhosts.yml
  when: httpd_vhosts

- name: Configure ports
  ansible.builtin.template:
    src: ports.conf.j2
    dest: "{{ httpd_ports_file }}"
  notify:
    - test httpd configuration
    - restart httpd
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directories.yml
  ansible.builtin.import_tasks: directories.yml
  when: httpd_directories

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  ansible.builtin.file:
    path: "{{ httpd_default_html_path }}"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


