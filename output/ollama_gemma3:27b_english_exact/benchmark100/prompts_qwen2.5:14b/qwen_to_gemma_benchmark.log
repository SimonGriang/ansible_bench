---

- name: Create the RKE2 config directory
  file:
    path: "{{ rke2_config_dir }}"
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server taints
  kubernetes.core.k8s:
    kubeconfig: "{{ kubeconfig }}"
    resource: node
    name: "{{ inventory_hostname }}"
    taints:
      - key: "node-role.kubernetes.io/server"
        value: ""
        effect: "NoSchedule"
    state: present
  when: rke2_type == 'server'

- name: Set agent taints
  kubernetes.core.k8s:
    kubeconfig: "{{ kubeconfig }}"
    resource: node
    name: "{{ inventory_hostname }}"
    taints:
      - key: "node-role.kubernetes.io/agent"
        value: ""
        effect: "NoSchedule"
  when: rke2_type == 'agent'

- name: Copy RKE2 config file
  copy:
    src: "{{ rke2_config_file }}"
    dest: "{{ rke2_config_dir }}/config.yaml"
    owner: root
    group: root
    mode: '0644'
  notify: restart rke2

- name: Copy kubelet config file
  copy:
    src: "{{ kubelet_config_file }}"
    dest: "{{ rke2_config_dir }}/kubelet.conf"
    owner: root
    group: root
    mode: '0644'
  when: kubelet_config_file is defined and kubelet_config_file != ""
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ containerd_registry_config_file }}"
    dest: "{{ rke2_config_dir }}/containerd_registry.conf"
    owner: root
    group: root
    mode: '0644'
  when: containerd_registry_config_file is defined and containerd_registry_config_file != ""
  notify: restart rke2

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    daemon_reload: yes
  retries: 5
  delay: 5
  until: systemd -q is-active rke2-server
  notify: rke2 restart

- name: Mask other RKE2 services
  systemd:
    name: "{{ item }}"
    masked: yes
    daemon_reload: yes
  loop:
    - rke2-agent
    - rke2-cri
  when: rke2_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  kubernetes.core.k8s_info:
    kubeconfig: "{{ kubeconfig }}"
    api_version: v1
    kind: Node
    name: "{{ inventory_hostname }}"
    namespace: default
    field_selector: spec.unschedulable=false
    wait: true
    wait_timeout: 600
    retries: 60
    delay: 10
  register: node_ready_no_cni

- name: Wait for remaining nodes to be ready - with CNI
  kubernetes.core.k8s_info:
    kubeconfig: "{{ kubeconfig }}"
    api_version: v1
    kind: Node
    name: "{{ inventory_hostname }}"
    namespace: default
    field_selector: spec.unschedulable=false,status.conditions[?(@.type=='Ready')].status=='True'
    wait: true
    wait_timeout: 600
    retries: 60
    delay: 10
  register: node_ready_cni


