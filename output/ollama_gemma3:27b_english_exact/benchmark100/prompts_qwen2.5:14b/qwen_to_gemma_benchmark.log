---

  - name: Check current docker-compose version.
    command: docker-compose --version
    register: docker_compose_version_check
    ignore_errors: true

  - name: Set fact for current Docker Compose version.
    set_fact:
      current_docker_compose_version: "{{ docker_compose_version_check.stdout | regex_search('docker-compose version (.*)', '\\1') | default('') }}"

  - name: Delete existing docker-compose version if it's different.
    file:
      path: /usr/local/bin/docker-compose
      state: absent
    when: current_docker_compose_version != docker_compose_version

  - name: Install Docker Compose (if configured).
    get_url:
      url: "https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-{{ docker_compose_version }}"
      dest: /usr/local/bin/docker-compose
      mode: 0755
    when: docker_compose_version is defined


