---

- name: Check if python is installed
  command: which python
  register: python_check
  ignore_errors: true

- name: Check if python3 is installed
  command: which python3
  register: python3_check
  ignore_errors: true

- name: Debug Python executable path
  debug:
    msg: "Python executable path: {{ python_check.stdout }}"
  when: python_check.stdout

- name: Debug Python3 executable path
  debug:
    msg: "Python3 executable path: {{ python3_check.stdout }}"
  when: python3_check.stdout

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install requirements
  pip:
    requirements: "{{ openssl_requirements }}"
  when: openssl_requirements

- name: Ensure packaging is available via dnf
  dnf:
    name: python3-packaging
    state: present
  become: true

- name: Install pip packages
  pip:
    name: "{{ openssl_pip_packages }}"
    state: present
  become: true
  when: openssl_pip_packages

- name: Create key directory
  file:
    path: "{{ openssl_key_dir }}"
    state: directory
    mode: '0700'
    owner: "{{ openssl_user }}"
    group: "{{ openssl_group }}"
  become: true

- name: Create csr directory
  file:
    path: "{{ openssl_csr_dir }}"
    state: directory
    mode: '0700'
    owner: "{{ openssl_user }}"
    group: "{{ openssl_group }}"
  become: true

- name: Create crt directory
  file:
    path: "{{ openssl_crt_dir }}"
    state: directory
    mode: '0700'
    owner: "{{ openssl_user }}"
    group: "{{ openssl_group }}"
  become: true

- name: Include create.yml
  include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item


