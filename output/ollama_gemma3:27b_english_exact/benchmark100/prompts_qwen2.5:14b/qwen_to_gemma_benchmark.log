---

- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ local_ssh_key_directory }}"
    state: directory
    mode: 0750
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    password: "{{ user.password | default(omit) }}"
    shell: "{{ user.shell | default('/bin/bash') }}"
    createhome: "{{ user.createhome | default(true) }}"
    groups: "{{ user.groups | default([]) }}"
    append: true
    sudo: "{{ user.sudo | default(false) }}"

- name: Set sudo options for {{ user.name }}
  copy:
    dest: "/etc/sudoers.d/{{ user.name }}"
    content: "{{ user.sudo_content }}"
    mode: 0640
  when: user.sudo_content
  validate: /usr/sbin/visudo --check

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: not user.sudo_content

- name: Generate private ssh key for {{ user.name }}
  command:
    cmd: ssh-keygen -t rsa -N "" -f "{{ local_ssh_key_path }}"
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Generate public ssh key for {{ user.name }}
  command:
    cmd: ssh-keygen -t rsa -N "" -f "{{ local_ssh_key_path }}" -Y
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Convert ssh key to ppk for {{ user.name }}
  command:
    cmd: putgen -i "{{ local_ssh_key_path }}" -o "{{ local_ssh_key_ppk_path }}" -f ssh
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Get or set the home directory for {{ user.name }}
  set_fact:
    user_home: "{{ ansible_facts.users[user.name].home }}"
  when: ansible_facts.users[user.name] is defined
  ignore_errors: true

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: 0700
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.manage_ssh_key or user.private_keys is defined

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys | default([]) }}"

- name: Remove unauthorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys | default([]) }}"

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ local_ssh_key_path }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.copy_private_key

- name: Check users password valid time for {{ user.name }}
  command: "chage -l {{ user.name }}"
  register: chage_output
  ignore_errors: true

- name: Set users password valid time for {{ user.name }}
  command: "chage -M {{ user.password_validity_days }} {{ user.name }}"
  when: user.password_validity_days is defined and chage_output.stdout is defined and user.password_validity_days != chage_output.stdout | regex_search('Last password change.*' + user.password_validity_days)
  ignore_errors: true

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ local_ssh_key_path }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.private_keys is defined


