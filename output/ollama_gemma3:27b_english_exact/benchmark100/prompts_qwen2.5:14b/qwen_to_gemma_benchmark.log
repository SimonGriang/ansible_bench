  block:
    - name: Download RKE2 checksum
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_dest }}"
        timeout: 60
    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}"
        timeout: 60
    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_dest }}"
        mode: '0755'
        timeout: 60
  when: rke2_airgap_mode and rke2_airgap_implementation == "download"

- name: Rescue for failed download
  block:
    - name: Create rescue directory
      file:
        path: "{{ rke2_rescue_path }}"
        state: directory
        mode: '0700'
    - name: Download RKE2 artifacts locally
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_rescue_path }}/artifacts.tar.gz"
        timeout: 60
    - name: Download RKE2 install script locally
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_rescue_path }}/rke2.sh"
        mode: '0755'
        timeout: 60
    - name: Copy local artifacts to remote host
      copy:
        src: "{{ rke2_rescue_path }}/artifacts.tar.gz"
        dest: "{{ rke2_artifacts_path }}"
        mode: '0640'
        force: yes
    - name: Copy local install script to remote host
      copy:
        src: "{{ rke2_rescue_path }}/rke2.sh"
        dest: "{{ rke2_install_script_dest }}"
        mode: '0700'
        force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation == "download"

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifacts }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: '0640'
    force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_tarball_images_path }}"
    mode: '0640'
  with_items: "{{ rke2_airgap_copy_additional_tarballs }}"
  when: rke2_airgap_mode and rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  stat:
    path: "{{ rke2_artifacts_path }}"
  register: rke2_artifacts_stat
  when: rke2_airgap_mode and rke2_airgap_implementation == "exists"

- name: Ensure RKE2 install script exists and has acceptable permissions
  stat:
    path: "{{ rke2_install_script_dest }}"
  register: rke2_install_script_stat
  when: rke2_airgap_mode and rke2_airgap_implementation == "exists"

- name: Fix RKE2 artifacts permissions
  file:
    path: "{{ rke2_artifacts_path }}"
    mode: '0640'
  when: rke2_airgap_mode and rke2_airgap_implementation == "exists" and rke2_artifacts_stat.stat.mode != '0640'

- name: Fix RKE2 install script permissions
  file:
    path: "{{ rke2_install_script_dest }}"
    mode: '0700'
  when: rke2_airgap_mode and rke2_airgap_implementation == "exists" and rke2_install_script_stat.stat.mode != '0700'

- name: Populate service facts
  setup:
    filter: ansible_service_units
  delegate_to: localhost

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Check if separate partition
  shell: grep /usr/local /proc/mounts
  register: mount_check
  ignore_errors: yes

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin/rke2
  when: usr_local_stat.stat.exists and mount_check.rc == 0

- name: Check RKE2 version
  shell: /usr/local/bin/rke2 version
  register: rke2_version
  ignore_errors: yes

- name: Set RKE2 versions
  set_fact:
    installed_rke2_version: "{{ rke2_version.stdout | regex_search('rke2 version (.*)', '\\1') | default('') }}"
    running_rke2_version: "{{ rke2_version.stdout | default('') }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  fail:
    msg: "Attempting to downgrade RKE2 from {{ installed_rke2_version }} to {{ rke2_version }} is not allowed unless explicitly permitted."
  when: installed_rke2_version and rke2_version and installed_rke2_version != rke2_version and not rke2_allow_downgrade

- name: Run RKE2 install script
  shell: "{{ rke2_install_script_dest }}"
  args:
    executable: /bin/bash
  environment:
    RKE2_AIRGAP_MODE: "{{ rke2_airgap_mode | bool }}"
    RKE2_AIRGAP_IMPLEMENTATION: "{{ rke2_airgap_implementation }}"
  when: installed_rke2_version != running_rke2_version and not ansible_check_mode

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_manifests_path }}"
    mode: '0640'
  with_items: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}"
    mode: '0640'
  with_items: "{{ rke2_static_pods }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_environment_file }}"
    dest: "{{ rke2_environment_file_dest }}"
    mode: '0640'
  when: rke2_environment_options is defined and rke2_environment_options | length > 0


