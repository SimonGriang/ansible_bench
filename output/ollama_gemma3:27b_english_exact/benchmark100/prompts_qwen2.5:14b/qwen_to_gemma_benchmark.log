---

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ dns_data_dir }}"
    state: directory
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0750'
    recurse: yes

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present
    system: yes

- name: Create user
  user:
    name: "{{ dns_user }}"
    system: yes
    group: "{{ dns_group }}"
    createhome: false

- name: Generate rndc key
  command: "rndc-confgen -a -k rndc-key -n ."
  args:
    chdir: "{{ dns_data_dir }}"
  register: rndc_key_gen

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_data_dir }}/rndc-key"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0600'

- name: Get the hints/root file
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ dns_data_dir }}/named.root"
    mode: '0644'

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_data_dir }}/{{ zone_name }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0644'

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_config_file }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0644'

- name: Place systemd override
  file:
    path: "{{ dns_systemd_override_dir }}"
    state: directory
    mode: '0755'

- name: Place systemd override file
  copy:
    src: named.service.j2
    dest: "{{ dns_systemd_override_dir }}/named.service"
    owner: root
    group: root
    mode: '0644'

- name: Start and enable dns
  systemd:
    name: named
    state: restarted
    enabled: yes


