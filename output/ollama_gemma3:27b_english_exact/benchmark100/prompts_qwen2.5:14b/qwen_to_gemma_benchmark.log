---
- name: Create etcd group
  group:
    name: etcd
    state: present

- name: Create etcd user
  user:
    name: etcd
    comment: etcd user
    group: etcd
    shell: /bin/nologin
    system: yes

- name: Copy systemctl config file for kernel hardening
  stat:
    path: /usr/local
  register: usr_local_stat

- name: Copy systemctl config file for kernel hardening
  stat:
    path: /opt/rke2
  register: opt_rke2_stat
  when: opt_rke2_stat.stat.exists

- name: Copy systemctl config file for kernel hardening
  copy:
    src: /usr/local/share/rke2/rke2-cis-sysctl.conf
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: 0600
  when: usr_local_stat.stat.exists and usr_local_stat.stat.writable
  notify: Restart systemd-sysctl

- name: Copy systemctl config file for kernel hardening
  copy:
    src: /opt/rke2/share/rke2/rke2-cis-sysctl.conf
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: 0600
  when: opt_rke2_stat.stat.exists and not usr_local_stat.stat.writable
  notify: Restart systemd-sysctl

- name: Flush handlers
  meta: flush_handlers


