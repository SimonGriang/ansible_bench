---

  - name: Create the RKE2 config directory
    file:
      path: /etc/rancher/rke2
      state: directory
      mode: '0755'

  - name: Set server taints
    set_fact:
      combined_node_taints: "{{ rke2_server_node_taints }}"
    when: ansible_processor_cores == '1' and ansible_memtotal_mb < 2048

  - name: Copy RKE2 configuration file
    template:
      src: rke2.yaml.j2
      dest: /etc/rancher/rke2/config.yaml
      mode: '0644'
    notify: Config file changed

  - name: Copy kubelet configuration file
    template:
      src: kubelet.yaml.j2
      dest: /etc/rancher/rke2/kubelet-config.yaml
      mode: '0644'
    when: rke2_kubelet_config != ""
    notify: Config file changed

  - name: Copy Containerd Registry Configuration file
    template:
      src: registries.yaml.j2
      dest: /etc/rancher/rke2/registries.yaml
      mode: '0644'
    when: rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != ""
    notify: Config file changed

  - name: Register if we need to do a etcd restore from file
    set_fact:
      do_etcd_restore: true
    when: rke2_etcd_snapshot_file != "" and ansible_service_mgr == "systemd" and (rke2_server_service_state is undefined or rke2_server_service_state == "disabled")

  - name: Register if we need to do a etcd restore from s3
    set_fact:
      do_etcd_restore_from_s3: true
    when: rke2_etcd_snapshot_file != "" and rke2_etcd_snapshot_s3_options is defined

  - name: Restore etcd from file
    block:
      - name: Create the RKE2 etcd snapshot directory
        file:
          path: /var/lib/rke2/etcd/snapshots
          state: directory
          mode: '0755'

      - name: Copy the etcd snapshot file
        copy:
          src: "{{ rke2_etcd_snapshot_file }}"
          dest: /var/lib/rke2/etcd/snapshots/
          mode: '0644'

      - name: Restore etcd from the snapshot file
        command: rke2 etcd-snapshot restore /var/lib/rke2/etcd/snapshots/
        args:
          creates: /var/lib/rke2/etcd/db/member/config.json
    when: do_etcd_restore

  - name: Restore etcd from s3
    command: rke2 etcd-snapshot restore s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }} --access-key {{ rke2_etcd_snapshot_s3_options.access_key }} --secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }}
    when: do_etcd_restore_from_s3

  - name: Start RKE2 service on the first server
    systemd:
      name: rke2-server
      state: started
      enabled: yes
      daemon_reload: yes
    environment:
      RKE2_TOKEN: "{{ rke2_server_token }}"
    when: inventory_hostname == groups['rke2_cluster_group_name'][0]

  - name: Mask RKE2 agent service on the first server
    systemd:
      name: rke2-agent
      state: stopped
      masked: yes
      daemon_reload: yes
    when: inventory_hostname == groups['rke2_cluster_group_name'][0]

  - name: Wait for the first server be ready - no CNI
    wait_for:
      path: /var/run/rke2/server/node.status
      timeout: 300
    when: inventory_hostname == groups['rke2_cluster_group_name'][0]

  - name: Wait for the first server be ready - with CNI
    wait_for:
      path: /var/run/rke2/server/node.status
      timeout: 300
    when: inventory_hostname == groups['rke2_cluster_group_name'][0]

  - name: Restore etcd
    block:
      - name: Get registered nodes
        command: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
        register: registered_nodes
        changed_when: false

      - name: Remove old node secrets
        file:
          path: /etc/rke2/node/node.key
          state: absent
        when: do_etcd_restore or do_etcd_restore_from_s3

      - name: Remove old nodes
        command: kubectl delete node {{ item }}
        loop: "{{ registered_nodes.stdout.split(' ') }}"
        ignore_errors: yes
        when: do_etcd_restore or do_etcd_restore_from_s3
    when: do_etcd_restore or do_etcd_restore_from_s3

  - name: Set an Active Server variable
    set_fact:
      active_server: "{{ inventory_hostname }}"
    delegate_to: localhost
    when: inventory_hostname in groups['rke2_cluster_group_name']


