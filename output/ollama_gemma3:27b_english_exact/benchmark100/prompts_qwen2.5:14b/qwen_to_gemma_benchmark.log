---
- name: Cordon and Drain the node {{ rke2_node_name }}
  command: >-
    kubectl cordon {{ rke2_node_name }} &&
    kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-emptydir-data {{ rke2_drain_additional_args }}
  register: drain_result
  retries: 100
  delay: 15
  until: drain_result.rc == 0

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2-server
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  command: kubectl get nodes -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}'
  register: node_status
  retries: 100
  delay: 15
  until: node_status.stdout == "True\nTrue\nTrue\n" or node_status.stdout == "True\nTrue\n" or node_status.stdout == "True\n"

- name: Uncordon the node {{ rke2_node_name }}
  command: kubectl uncordon {{ rke2_node_name }}
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  command: kubectl get pods --all-namespaces -o jsonpath='{range .items[*]}{.status.phase}{"\n"}{end}'
  register: pod_status
  retries: 100
  delay: 15
  until: pod_status.stdout == "Running\nRunning\nRunning\n" or pod_status.stdout == "Running\nRunning\n" or pod_status.stdout == "Running\n"
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  command: kubectl wait --for=condition=ready --all --timeout=1800s
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy


