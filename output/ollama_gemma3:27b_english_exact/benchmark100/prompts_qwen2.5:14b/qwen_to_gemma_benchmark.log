---

- name: Java | Install OpenJDK implementation
  apt:
    name: openjdk-11-jdk
    state: present
  become: true

- name: Java | Import certificates into Java Keystore
  command: keytool -import -alias {{ item.alias }} -file {{ item.file }} -keystore {{ item.keystore }} -storepass {{ item.storepass }}
  with_items: "{{ java_certs }}"
  become: true
  when: java_certs is defined


