---
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install required packages
    package:
      name: "{{ selinux_requirements }}"
      state: present
    notify: gather_facts

  - name: Flush handlers
    meta: flush_handlers

  - name: Configure selinux
    block:
      - name: Manage selinux
        selinux:
          state: "{{ selinux_state }}"
          policy: "{{ selinux_policy }}"
        notify: reboot_system

      - name: Manage selinux booleans
        seboolean:
          name: "{{ item.name }}"
          state: "{{ item.state }}"
          persistent: "{{ item.persistent }}"
        loop: "{{ selinux_booleans }}"
    when: ansible_selinux_enabled | bool and ansible_connection != 'local'


