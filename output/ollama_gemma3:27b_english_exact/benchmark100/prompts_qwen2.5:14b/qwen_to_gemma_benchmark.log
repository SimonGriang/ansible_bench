    import_tasks: assert.yml

  - name: Install cron
    package:
      name: "{{ cron_packages }}"
      state: present

  - name: Configure shell
    lineinfile:
      path: /etc/cron.d/custom_cron
      line: "SHELL={{ cron_shell }}"
      create: yes
      state: present
    file:
      path: /etc/cron.d/custom_cron
      mode: 0600
    notify: Restart cron

  - name: Configure path
    lineinfile:
      path: /etc/cron.d/custom_cron
      line: "PATH={{ cron_path }}"
      create: yes
      state: present
    file:
      path: /etc/cron.d/custom_cron
      mode: 0600
    notify: Restart cron

  - name: Configure mailto
    lineinfile:
      path: /etc/cron.d/custom_cron
      line: "MAILTO={{ cron_mailto }}"
      create: yes
      state: present
    file:
      path: /etc/cron.d/custom_cron
      mode: 0600
    notify: Restart cron

  - name: Start and enable cron
    service:
      name: cron
      state: started
      enabled: yes
    when: cron_service is defined and cron_service != ""

  - name: Schedule requested cron jobs
    cron:
      name: "{{ item.name }}"
      minute: "{{ item.minute | default('*') }}"
      hour: "{{ item.hour | default('*') }}"
      day: "{{ item.day | default('*') }}"
      month: "{{ item.month | default('*') }}"
      weekday: "{{ item.weekday | default('*') }}"
      job: "{{ item.command }}"
      user: root
    loop: "{{ cron_jobs }}"


