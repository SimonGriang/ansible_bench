---

  - name: Import assert.yml
    import_tasks: assert.yml

  - name: Install requirements
    package:
      name: bash
      state: present

  - name: Install openjdk java (package)
    package:
      name: openjdk
      state: present
    when: java_vendor == "openjdk"

  - name: Install RPM
    package:
      deb: /tmp/java.rpm
      state: present
    when: java_vendor == "oracle" and ansible_pkg_mgr == "yum"

  - name: Install DEB
    package:
      deb: /tmp/java.deb
      state: present
    when: java_vendor == "oracle" and ansible_pkg_mgr == "apt"

  - name: Install oracle java (rpm) (repository)
    yum:
      name: java-1.8.0-openjdk
      state: present
    when: java_vendor == "oracle" and ansible_pkg_mgr == "yum"

  - name: Configure oracle targz
    block:
      - name: Create installation directory
        file:
          path: "{{ java_install_dir }}"
          state: directory
          mode: 0755
      - name: Extract Oracle Java TARGZ
        unarchive:
          src: /tmp/java.tar.gz
          dest: "{{ java_install_dir }}"
          remote_src: yes
    when: java_vendor == "oracle" and java_install_method == "targz"

  - name: Install oracle java policy software (targz)
    copy:
      src: /tmp/policy.jar
      dest: "{{ java_install_dir }}/jre/lib/security/"
    when: java_vendor == "oracle" and java_install_method == "targz"

  - name: Set alternative (targz)
    alternatives:
      name: java
      path: "{{ java_install_dir }}/bin/java"
      state: present
    when: java_vendor == "oracle" and java_install_method == "targz" and ansible_distribution != "Alpine"

  - name: Find JAVA_HOME
    shell: "readlink -f $(which java) | sed 's/\/bin\/java//'"
    register: java_home_result
    changed_when: false

  - name: Set JAVA_HOME in /etc/environment
    lineinfile:
      path: /etc/environment
      line: 'JAVA_HOME="{{ java_home_result.stdout }}"'
      state: present
      create: yes


