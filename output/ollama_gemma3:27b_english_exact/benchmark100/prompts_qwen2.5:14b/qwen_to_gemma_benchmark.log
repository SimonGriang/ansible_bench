---

  - name: create | Create ssl key
    openssl_private_key:
      path: "{{ ssl_key_path }}"
      size: "{{ ssl_key_size | default(2048) }}"
      type: "{{ ssl_key_type | default('rsa') }}"
      owner: "{{ ssl_key_owner | default('root') }}"
      group: "{{ ssl_key_group | default('root') }}"
      mode: "{{ ssl_key_mode | default('0600') }}"

  - name: create | Create ssl csr
    openssl_csr:
      path: "{{ ssl_csr_path }}"
      private_key: "{{ ssl_key_path }}"
      common_name: "{{ ansible_fqdn }}"
      owner: "{{ ssl_csr_owner | default('root') }}"
      group: "{{ ssl_csr_group | default('root') }}"
      mode: "{{ ssl_csr_mode | default('0600') }}"

  - name: create | Create ssl certificates
    openssl_certificate:
      path: "{{ ssl_cert_path }}"
      private_key: "{{ ssl_key_path }}"
      csr: "{{ ssl_csr_path }}"
      owner: "{{ ssl_cert_owner | default('root') }}"
      group: "{{ ssl_cert_group | default('root') }}"
      mode: "{{ ssl_cert_mode | default('0644') }}"

  - name: create | Create PKCS#12 file
    openssl_pkcs12:
      path: "{{ ssl_pkcs12_path }}"
      private_key: "{{ ssl_key_path }}"
      certificate: "{{ ssl_cert_path }}"
      owner: "{{ ssl_pkcs12_owner | default('root') }}"
      group: "{{ ssl_pkcs12_group | default('root') }}"
      mode: "{{ ssl_pkcs12_mode | default('0600') }}"

  - name: create | Read private key
    slurp:
      src: "{{ ssl_key_path }}"
      marker: "# BEGIN PRIVATE KEY"
      end_marker: "# END PRIVATE KEY"
    register: ssl_key_content

  - name: create | Read certificate
    slurp:
      src: "{{ ssl_cert_path }}"
      marker: "# BEGIN CERTIFICATE"
      end_marker: "# END CERTIFICATE"
    register: ssl_cert_content

  - name: create | Create combined private_key and certificate file
