    delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
    retries: 100
    delay: 15
    register: pod_status
    until: pod_status.rc == 0
    run_once: true
    check_mode: "{{ rke2_wait_for_all_pods_to_be_ready | default(false) }}"


