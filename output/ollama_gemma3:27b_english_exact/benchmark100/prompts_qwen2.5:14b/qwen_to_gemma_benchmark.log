---

  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install git
    package:
      name: "{{ git_packages }}"
      state: present

  - name: See if the specified user exists
    getent:
      database: passwd
      key: "{{ git_user }}"
    register: user_exists

  - name: Create directory for git configuration
    file:
      path: "{{ git_user_home }}/.config"
      state: directory
      owner: "{{ git_user }}"
      group: "{{ git_user }}"
      mode: '0700'
    when: user_exists.passwd and git_user_home is defined and git_user is defined

  - name: Place git configuration
    copy:
      src: files/gitconfig
      dest: "{{ git_user_home }}/.config/gitconfig"
      owner: "{{ git_user }}"
      group: "{{ git_user }}"
      mode: '0600'
    when: user_exists.passwd and git_user_home is defined and git_user is defined and gitconfig_source is defined

  - name: Create repository_destination
    file:
      path: "{{ repository_destination }}"
      state: directory
      owner: "{{ git_user }}"
      group: "{{ git_user }}"
      mode: '0755'
    when: user_exists.passwd and repository_destination is defined and git_user is defined

  - name: Clone all roles
    git:
      repo: "{{ item }}"
      dest: "{{ repository_destination }}/{{ item | split('/') | last }}"
      clone: yes
      update: yes
      force: yes
      accept_hostkey: yes
      key_file: "{{ git_key_file }}"
    become: yes
    become_user: "{{ git_user }}"
    with_items: "{{ git_repositories }}"
    when: user_exists.passwd and git_repositories is defined and repository_destination is defined and git_user is defined


