      owner: root
      group: root
      mode: '0600'
    notify:
      - rebuild sasl_password_map database

  - name: Flush handlers again
    meta: flush_handlers

  - name: Start and enable postfix
    service:
      name: postfix
      state: started
      enabled: yes


