---

- name: lookup bootstrap facts (raw)
  raw: cat /etc/os-release
  register: os_release_raw

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ os_release_raw.stdout | regex_search('NAME=\"(.*)\"', '\\1') }}"
    bootstrap_version: "{{ os_release_raw.stdout | regex_search('VERSION=\"(.*)\"', '\\1') | regex_replace('^([0-9]+).*$', '\\1') }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ bootstrap__os_family_map.get(bootstrap_distribution, 'unknown') }}"
  vars:
    bootstrap__os_family_map:
      "Ubuntu": "Debian"
      "Debian": "Debian"
      "CentOS": "RedHat"
      "RedHat": "RedHat"
      "Rocky": "RedHat"
      "AlmaLinux": "RedHat"
      "Fedora": "RedHat"
      "SLES": "Suse"
      "openSUSE": "Suse"


