---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Easyrsa init-pki
  command: /usr/sbin/easyrsa init-pki
  args:
    creates: /etc/openvpn/easy-rsa/pki

- name: Easyrsa build-ca
  command: /usr/sbin/easyrsa build-ca nopass
  args:
    creates: /etc/openvpn/easy-rsa/pki/ca.crt

- name: Easyrsa gen-dh
  command: /usr/sbin/easyrsa gen-dh
  args:
    creates: /etc/openvpn/easy-rsa/pki/dh.pem

- name: Easyrsa build-server-full server nopass
  command: /usr/sbin/easyrsa build-server-full server nopass
  args:
    creates: /etc/openvpn/easy-rsa/pki/issued/server.crt

- name: Easyrsa build-client-full client nopass
  command: /usr/sbin/easyrsa build-client-full client nopass
  args:
    creates: /etc/openvpn/easy-rsa/pki/issued/client.crt

- name: Easyrsa gen-crl
  command: /usr/sbin/easyrsa gen-crl
  args:
    creates: /etc/openvpn/easy-rsa/pki/crl.pem

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to /etc/openvpn/server
  copy:
    src: /etc/openvpn/easy-rsa/pki/issued/server.crt
    dest: /etc/openvpn/server/server.crt
    mode: 0644
  become: true
- copy:
    src: /etc/openvpn/easy-rsa/pki/private/server.key
    dest: /etc/openvpn/server/server.key
    mode: 0600
  become: true
- copy:
    src: /etc/openvpn/easy-rsa/pki/ca.crt
    dest: /etc/openvpn/server/ca.crt
    mode: 0644
  become: true

- name: Copy files to /etc/openvpn
  copy:
    src: /etc/openvpn/easy-rsa/pki/ca.crt
    dest: /etc/openvpn/ca.crt
    mode: 0644
  become: true
- copy:
    src: /etc/openvpn/easy-rsa/pki/dh.pem
    dest: /etc/openvpn/dh.pem
    mode: 0644
  become: true
- copy:
    src: /etc/openvpn/easy-rsa/pki/crl.pem
    dest: /etc/openvpn/crl.pem
    mode: 0644
  become: true

- name: Place server.conf
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
  notify: restart openvpn


