---

  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install cron
    package:
      name: "{{ cron_packages }}"
      state: present

  - name: Configure shell
    lineinfile:
      path: /etc/cron.d/custom
      line: "SHELL=/bin/bash"
      mode: '0644'
    notify:
      - restart cron

  - name: Configure path
    lineinfile:
      path: /etc/cron.d/custom
      line: "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
      mode: '0644'
    notify:
      - restart cron

  - name: Configure mailto
    lineinfile:
      path: /etc/cron.d/custom
      line: "MAILTO={{ mailto_address }}"
      mode: '0644'
    notify:
      - restart cron

  - name: Start and enable cron
    service:
      name: "{{ cron_service }}"
      state: started
      enabled: yes
    when: cron_service is defined and cron_service != ""

  - name: Schedule requested cron jobs
    cron:
      name: "{{ item.name }}"
      minute: "{{ item.minute }}"
      hour: "{{ item.hour }}"
      day: "{{ item.day }}"
      month: "{{ item.month }}"
      weekday: "{{ item.weekday }}"
      state: "{{ item.state }}"
      job: "{{ item.job }}"
    loop: "{{ cron_jobs }}"


