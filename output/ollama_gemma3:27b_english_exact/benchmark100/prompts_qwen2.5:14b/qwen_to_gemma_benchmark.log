---
- name: Install Keepalived when HA mode is enabled
  ansible.builtin.package:
    name: keepalived
    state: present
  when: ha_mode and rke2_server_group

- name: Download and install RKE2
  ansible.builtin.command:
    cmd: curl -sfL https://get.rke2.io | sh -
  args:
    creates: /usr/local/bin/rke2
  environment:
    RKE2_VERSION: "{{ rke2_version }}"

- name: CIS Hardening
  ansible.builtin.import_tasks:
    file: cis_hardening.yml
  when: cis_profile is defined

- name: Find Active Server
  ansible.builtin.command: rke2-serverctl status
  register: rke2_status
  changed_when: false

- name: Enable IPVS kernel module
  ansible.builtin.modprobe:
    name: ipvs
    state: present
  when: kube_vip and ha_mode

- name: Copy kube-vip manifests to the masternode
  ansible.builtin.copy:
    src: files/kube-vip/
    dest: /tmp/kube-vip/
    owner: root
    group: root
    mode: '0755'
  when: not ha_mode

- name: Copy ingress-nginx manifests to the masternode
  ansible.builtin.copy:
    src: files/ingress-nginx/
    dest: /tmp/ingress-nginx/
    owner: root
    group: root
    mode: '0755'
  when: ingress_nginx_config is defined

- name: Prepare very first server node in the cluster
  ansible.builtin.command: rke2 server --config /etc/rke2/config.yaml
  args:
    creates: /var/lib/rke2/server/node-internal.crt
  environment:
    RKE2_VERSION: "{{ rke2_version }}"

- name: Restore etcd specific tasks
  ansible.builtin.import_tasks:
    file: restore_etcd.yml
  when: restore_etcd

- name: Download kubeconfig to ansible localhost
  ansible.builtin.command: rke2 kubectl --kubeconfig /etc/rke2/rke2.yaml get nodes
  register: kubeconfig_check
  changed_when: false
  delegate_to: localhost
  when: download_kubeconfig

- name: Prepare and join remaining nodes of the cluster
  ansible.builtin.command: rke2 agent --server "{{ active_server }}" --token "{{ rke2_token }}" --config /etc/rke2/config.yaml
  environment:
    RKE2_VERSION: "{{ rke2_version }}"
  when: active_server is defined

- name: Rolling cordon and drain restart when version changes - servers
  ansible.builtin.import_tasks:
    file: rolling_restart_servers.yml
  when: rke2_version_changed

- name: Rolling cordon and drain restart when version changes - agents
  ansible.builtin.import_tasks:
    file: rolling_restart_agents.yml
  when: rke2_version_changed

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Rolling restart when config files change
  ansible.builtin.import_tasks:
    file: rolling_restart_config.yml
  when: config_files_changed

- name: Final steps
  ansible.builtin.command: echo "Playbook execution completed"
  changed_when: false


