---

- name: cadvisor | create directories
  ansible.builtin.file:
    path: "{{ cadvisor_install_dir }}"
    state: directory
    mode: '0755'

- name: cadvisor | download
  ansible.builtin.get_url:
    url: "{{ cadvisor_download_url }}"
    dest: "/tmp/cadvisor"
    checksum: "{{ cadvisor_checksum }}"
  when: cadvisor_local_binary is not defined

- name: cadvisor | propagate locally distributed cadvisor binary
  ansible.builtin.copy:
    src: "{{ cadvisor_local_binary }}"
    dest: "{{ cadvisor_install_dir }}/cadvisor"
    mode: '0755'
  notify: restart cadvisor
  when: cadvisor_local_binary is defined

- name: cadvisor | symlink
  ansible.builtin.file:
    src: "{{ cadvisor_install_dir }}/cadvisor"
    dest: "/usr/local/bin/cadvisor"
    state: link
    force: true

- name: cadvisor | server systemd service
  ansible.builtin.template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'
  notify: restart cadvisor

- name: test_task
  ansible.builtin.systemd:
    name: cadvisor
    state: started
  register: service_active

- name: debug: var=service_active
  ansible.builtin.debug:
    var: service_active

- name: cadvisor | enable server systemd
  ansible.builtin.systemd:
    name: cadvisor
    enabled: yes

- name: cadvisor | start server systemd
  ansible.builtin.systemd:
    name: cadvisor
    state: started
    enabled: yes


