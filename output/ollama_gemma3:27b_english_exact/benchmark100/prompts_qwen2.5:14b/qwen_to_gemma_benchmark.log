    url: "https://github.com/grafana/loki/releases/download/v2.9.0/promtail-linux-amd64"
    dest: files/promtail-linux-amd64
  when: not promtail_binary.stat.exists

- name: Propagate promtail binaries.
  ansible.builtin.copy:
    src: files/promtail-linux-amd64
    dest: /opt/promtail/promtail
    mode: '0755'
  when: not promtail_binary.stat.exists

- name: Unpack promtail binaries.
  ansible.builtin.unarchive:
    src: files/promtail-linux-amd64
    dest: /opt/promtail/
    remote_src: false
    creates: /opt/promtail/promtail
    ignore_errors: true
  when: not promtail_binary.stat.exists

- name: Create symlink to latest version.
  ansible.builtin.file:
    src: /opt/promtail/promtail
    dest: /usr/local/bin/promtail
    state: link
    force: true
  notify: restart promtail

- name: Write configuration.
  ansible.builtin.template:
    src: templates/promtail.yml.j2
    dest: /etc/promtail/promtail.yml
    owner: promtail
    group: promtail
    mode: '0644'
  notify: restart promtail

- name: Create systemd service unit.
  ansible.builtin.template:
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: restart promtail


