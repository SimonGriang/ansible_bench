---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    home: false
    shell: "{{ vault_user_shell }}"
    groups: "{{ vault_group }}"
    state: present

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Download Vault binary
  get_url:
    url: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}/vault"
    owner: root
    group: root
    mode: '0755'

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_exists

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: not vault_path_exists.stat.exists and vault_path is defined

- name: Create directory in vault_path
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  openssl_certificate:
    path: "{{ vault_data_directory }}/tls/vault.pem"
    key_path: "{{ vault_data_directory }}/tls/vault.key"
    days: 1095
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setcap:
    cap: cap_ipc_lock=ep
    path: /usr/bin/vault
  changed_when: false

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    mode: '0644'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'

- name: Copy Vault service file
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: '0644'
  notify: Daemon reload
  when: ansible_service_manager == "systemd"

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: '0644'
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


