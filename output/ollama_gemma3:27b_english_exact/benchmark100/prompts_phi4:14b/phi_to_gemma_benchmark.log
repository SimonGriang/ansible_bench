content='```yaml\n---\n\n  - name: Create document root directories for HTTP virtual hosts\n    file:\n      path: "{{ item.documentroot }}"\n      state: directory\n      owner: "{{ httpd_vhost_owner | default(\'root\') }}"\n      group: "{{ httpd_vhost_group | default(\'root\') }}"\n      mode: \'0755\'\n    loop: "{{ httpd_vhosts | default([]) }}"\n    when: httpd_vhosts is defined and item.documentroot is defined and item.create_docroot != false\n\n  - name: Configure virtual host configuration files using templates\n    template:\n      src: "{{ vhost_conf_template }}"\n      dest: "{{ httpd_vhosts_directory }}/{{ item.servername }}.conf"\n      owner: "{{ httpd_vhost_owner | default(\'root\') }}"\n      group: "{{ httpd_vhost_group | default(\'root\') }}"\n      mode: \'0644\'\n    loop: "{{ httpd_vhosts | default([]) }}"\n    notify:\n      - test httpd configuration\n      - restart httpd\n\n  - name: Enable virtual hosts on Debian-based systems\n    command: a2ensite {{ item.servername }}.conf\n    loop: "{{ httpd_vhosts | default([]) }}"\n    when: ansible_os_family == \'Debian\'\n    notify:\n      - test httpd configuration\n      - restart httpd\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-14T15:15:18.271690162Z', 'done': True, 'done_reason': 'stop', 'total_duration': 20329979231, 'load_duration': 204348952, 'prompt_eval_count': 560, 'prompt_eval_duration': 1503866345, 'eval_count': 326, 'eval_duration': 18620797103, 'model_name': 'gemma3:27b'} id='run--14f14879-bd56-4310-adf1-3c0dd3b5bc0e-0' usage_metadata={'input_tokens': 560, 'output_tokens': 326, 'total_tokens': 886}
