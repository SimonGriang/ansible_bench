    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
  register: python312_externally_managed_exists

- name: Rename the EXTERNALLY-MANAGED file for Python 3.12 if it exists
  file:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
    state: absent
    name: /usr/lib/python3.12/EXTERNALLY-MANAGED.old
  when: python312_externally_managed_exists.stat.exists

- name: Import tasks from assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  lineinfile:
    path: /etc/pip.conf
    line: "index-url = {{ python_pip_proxy }}"
    create: yes
    state: present
  when: python_pip_proxy is defined

- name: Configure trusted hosts for pip
  lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    create: yes
    state: present
  when: python_pip_trusted_host is defined

- name: Update pip to the latest version
  package:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when: python_pip_update and ansible_distribution_release not in ["bookworm", "noble"] and ansible_os_family != "Alpine"

- name: Install requested Python modules
  package:
    name: "{{ python_pip_modules }}"
    state: present
    executable: "{{ python_pip_executable }}"
  when: ansible_distribution_release not in ["bookworm", "noble"] and ansible_os_family != "Alpine"


