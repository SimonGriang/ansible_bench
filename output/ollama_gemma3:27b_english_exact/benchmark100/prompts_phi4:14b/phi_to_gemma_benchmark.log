content='```yaml\n---\n- name: Install the EPEL repository package\n  block:\n    - name: Install the GPG key for the EPEL repository\n      ansible.builtin.rpm_key:\n        key: "{{ epel_gpg_key }}"\n        state: present\n\n    - name: Install the EPEL-release package and notify the handler to update the package cache\n      ansible.builtin.package:\n        name: "{{ epel_url }}"\n        state: present\n      notify: Update package cache\n\n  when: ansible_facts.distribution in ["Amazon", "RedHat", "CentOS", "Rocky", "AlmaLinux"] and ansible_facts.distribution_major_version in ["7", "8", "9", "10"]\n\n- name: Optionally install the EPEL-next-release package if the `epel_next` variable is set, and notify the handler to update the package cache\n  block:\n    - name: Install the EPEL-next-release package\n      ansible.builtin.package:\n        name: "{{ epel_next_url }}"\n        state: present\n      notify: Update package cache\n  when: epel_next\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-14T18:00:56.842877882Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17343234746, 'load_duration': 197221249, 'prompt_eval_count': 779, 'prompt_eval_duration': 2576078908, 'eval_count': 262, 'eval_duration': 14568443317, 'model_name': 'gemma3:27b'} id='run--1abcec85-1f23-4e5a-9c05-4fec1de886cf-0' usage_metadata={'input_tokens': 779, 'output_tokens': 262, 'total_tokens': 1041}
