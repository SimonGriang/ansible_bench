---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install MySQL packages
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - set_mysql_root_password
    - restart_mysql_systemd

- name: Configure the MySQL server configuration file
  copy:
    dest: /etc/mysql/my.cnf.d/server.cnf
    content: "{{ mysql_configuration_options }}"
    owner: root
    group: root
    mode: 0644
  notify:
    - restart_mysql_server

- name: Configure the MySQL client configuration file
  lineinfile:
    path: /etc/mysql/my.cnf.d/client.cnf
    line: "socket={{ mysql_socket }}"
    create: true

- name: Initialize the MySQL database if on Alpine or Archlinux
  command: "mysql_install_db --user=mysql"
  become: true
  when: ansible_os_family in ["Alpine", "Archlinux"]
  args:
    creates: /var/lib/mysql/mysql.sock

- name: Start and enable the MySQL service
  service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  handlers:
    - name: set_mysql_root_password
      command: mysqladmin -u root password '{{ mysql_root_password }}'
    - name: restart_mysql_systemd
      systemd:
        name: mysql
        state: restarted
    - name: restart_mysql_server
      service:
        name: mysql
        state: restarted

- name: Place the my.cnf configuration file
  template:
    src: my.cnf.j2
    dest: /root/my.cnf
    owner: root
    group: root
    mode: 0644

- name: Create MySQL databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  when: not item.initial_import

- name: List current MySQL databases
  mysql_query:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    query: "SHOW DATABASES;"
  register: mysql_databases_list

- name: Import databases if initial import is defined and not already present
  shell: "mysql -u root -p'{{ mysql_root_password }}' -e \"SOURCE {{ item.initial_import }};\""
  loop: "{{ mysql_databases }}"
  when: item.initial_import and item.initial_import not in mysql_databases_list.query
  args:
    creates: "/tmp/mysql_import_complete"

- name: Create MySQL users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  handlers:
    - name: set_mysql_root_password
      command: mysqladmin -u root password '{{ mysql_root_password }}'
    - name: restart_mysql_systemd
      systemd:
        name: mysql
        state: restarted
    - name: restart_mysql_server
      service:
        name: mysql
        state: restarted


