---

- name: Install EPEL repository on supported Red Hat-based systems
  ansible.builtin.block:
    - name: Add the EPEL GPG key
      ansible.builtin.rpm_key:
        key: https://dl.fedoraproject.org/gpg/RPM-GPG-KEY-fedora-release-stable
        state: present
    - name: Install the EPEL release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache
    - name: Optionally install the EPEL next-release package
      ansible.builtin.package:
        name: "{{ epel_next_url }}"
        state: present
      notify: Update package cache
  when: ansible_facts['distribution'] in ['Amazon', 'RedHat'] and ansible_facts['distribution_version'] in ['7', '8', '9', '2']

handlers:
  - name: Update package cache
    ansible.builtin.command: yum makecache fast
    become: true


