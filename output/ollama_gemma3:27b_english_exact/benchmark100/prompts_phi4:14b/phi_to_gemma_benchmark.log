---
- name: Import assert tasks
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for bootstrap port
  wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when: bootstrap_wait_for_host and ansible_connection != 'network_cli' and ansible_connection != 'ssh'

- name: Prepare bootstrap system
  block:
    - name: Test connection
      ping:
      ignore_errors: true

    - name: Check for sudo
      command: sudo -n true
      ignore_errors: true
      register: sudo_check

    - name: Gather bootstrap facts
      setup:
      when: sudo_check.rc != 0
      register: bootstrap_facts

    - name: Install bootstrap packages (Debian/Ubuntu)
      raw: apt-get update && apt-get install -y --no-install-recommends {{ bootstrap_facts_packages | join(' ') }}
      become: true
      when: ansible_os_family == "Debian" and sudo_check.rc != 0

    - name: Install bootstrap packages (RedHat)
      raw: yum install -y {{ bootstrap_facts_packages | join(' ') }}
      become: true
      when: ansible_os_family == "RedHat" and sudo_check.rc != 0

    - name: Install libdnf5 (RedHat)
      raw: yum install -y libdnf5
      become: true
      when: ansible_os_family == "RedHat" and sudo_check.rc != 0

  rescue:
    - name: Handle bootstrap errors
      debug:
        msg: "Bootstrap preparation failed."

- name: Gather Ansible facts
  setup:

- name: Install bootstrap facts packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
  become: "{{ bootstrap_become }}"


