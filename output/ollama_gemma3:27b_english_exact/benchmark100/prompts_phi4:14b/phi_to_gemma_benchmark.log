resent\n          update_cache: yes\n    when: ansible_os_family == "Debian"\n\n  - name: Handle RedHat pre-requisites for Java installation\n    block:\n      - name: Add key repositories\n        rpm_key:\n          key: "{{ java_combined_vars.java_key_url }}"\n          state: present\n\n      - name: Add required repositories\n        yum_repository:\n          name: "{{ java_combined_vars.java_repo_name }}"\n          description: "{{ java_combined_vars.java_repo_description }}"\n          baseurl: "{{ java_combined_vars.java_repo_url }}"\n          gpgcheck: yes\n          gpgkey: "{{ java_combined_vars.java_key_url }}"\n          enabled: yes\n    when: ansible_os_family == "RedHat"\n\n  - name: Install required libraries for Java\n    package:\n      name: "{{ java_combined_vars.java_libraries }}"\n      state: present\n\n  - name: Install Java on Debian systems\n    apt:\n      name: "{{ java_combined_vars.java_package_name }}"\n      state: present\n      update_cache: yes\n    when: ansible_os_family == "Debian"\n\n  - name: Install Java on RedHat systems\n    yum:\n      name: "{{ java_combined_vars.java_package_name }}"\n      state: present\n      update_cache: yes\n    when: ansible_os_family == "RedHat"\n\n  - name: Export Java environment variables\n    template:\n      src: jdk.sh.j2\n      dest: /etc/profile.d/jdk.sh\n      mode: 0755\n\n  - name: Source Java environment variables\n    shell: source /etc/profile.d/jdk.sh\n    args:\n      executable: /bin/bash\n\n  - name: Correct Java version selection for versions less than 11 on Debian systems\n    alternatives:\n      name: java\n      path: "{{ java_home }}/bin/java"\n      state: auto\n    when: ansible_os_family == "Debian" and java_version < 11\n\n  - name: Correct Java version selection for versions 11 or greater on Debian systems\n    alternatives:\n      name: java\n      path: "{{ java_home }}/bin/java"\n      state: auto\n    when: ansible_os_family == "Debian" and java_version >= 11\