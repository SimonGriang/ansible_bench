---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install the git package
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if the specified git user exists in the system
  getent:
    database: passwd
    key: "{{ git_username }}"
    register: git_user_info
  ignore_errors: true

- name: Create a directory for the git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0700'
  when: git_user_info.passwd is defined and git_user_info.passwd[git_username] is defined

- name: Place the git configuration file
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0600'
  when: git_user_info.passwd is defined and git_user_info.passwd[git_username] is defined

- name: Create the repository destination directory
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'
  when: git_user_info.passwd is defined and git_user_info.passwd[git_username] is defined and git_repository_destination is defined

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    version: "{{ item.version | default(omit) }}"
    accept_hostkey: yes
    force: yes
    user: "{{ git_username }}"
  loop: "{{ git_repositories }}"


