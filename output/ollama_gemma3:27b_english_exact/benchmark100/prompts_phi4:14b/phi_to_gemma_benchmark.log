  ansible.builtin.wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when: bootstrap_wait_for_host and ansible_connection != 'network_cli' and \
        ansible_connection != 'ssh'

- name: Prepare bootstrap system
  block:
    - name: Test connection
      ansible.builtin.ping:
      ignore_errors: true

    - name: Check for sudo
      ansible.builtin.command: sudo -n true
      ignore_errors: true
      register: sudo_check

    - name: Gather bootstrap facts
      ansible.builtin.setup:
      when: sudo_check.rc != 0
      register: bootstrap_facts

    - name: Install bootstrap packages (Debian/Ubuntu)
      ansible.builtin.raw: apt-get update && apt-get install -y --no-install-recommends \
           {{ bootstrap_facts_packages | join(' ') }}
      become: true
      when: ansible_os_family == "Debian" and sudo_check.rc != 0

    - name: Install bootstrap packages (RedHat)
      ansible.builtin.raw: yum install -y {{ bootstrap_facts_packages | join(' ') }}
      become: true
      when: ansible_os_family == "RedHat" and sudo_check.rc != 0

    - name: Install libdnf5 (RedHat)
      ansible.builtin.raw: yum install -y libdnf5
      become: true
      when: ansible_os_family == "RedHat" and sudo_check.rc != 0

  rescue:
    - name: Handle bootstrap errors
      ansible.builtin.debug:
        msg: "Bootstrap preparation failed."

- name: Gather Ansible facts
  ansible.builtin.setup:

- name: Install bootstrap facts packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
  become: "{{ bootstrap_become }}"


