---

- name: Install SSL packages
  package:
    name: "{{ httpd_ssl_packages }}"
    state: present

- name: Place SSL configuration file
  template:
    src: ssl.conf.j2
    dest: "{{ httpd_config_directory }}/ssl.conf"
    owner: root
    group: root
    mode: 0644
  notify:
    - validate httpd config
    - restart httpd

- name: Configure HTTP to HTTPS redirect
  template:
    src: default_vhost.conf.j2
    dest: "{{ httpd_config_directory }}/default_vhost_conf"
    owner: root
    group: root
    mode: 0644
  notify:
    - validate httpd config
    - restart httpd


