---
- name: Import assert tasks
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install bash
  package:
    name: bash
    state: present

- name: Install OpenJDK
  package:
    name: "{{ java_openjdk_package }}"
    state: present
  when: java_vendor == "openjdk"
  environment:
    http_proxy: "{{ http_proxy }}"
    https_proxy: "{{ https_proxy }}"
    no_proxy: "{{ no_proxy }}"

- name: Copy Oracle Java RPM
  copy:
    src: "{{ java_oracle_rpm }}"
    dest: /tmp/{{ java_oracle_rpm }}
  when: java_source == "local" and java_format == "rpm"

- name: Install Oracle Java RPM
  package:
    name: /tmp/{{ java_oracle_rpm }}
    state: present
  when: java_source == "local" and java_format == "rpm"

- name: Copy Oracle Java DEB
  copy:
    src: "{{ java_oracle_deb }}"
    dest: /tmp/{{ java_oracle_deb }}
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java DEB
  apt:
    deb: /tmp/{{ java_oracle_deb }}
    state: present
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java RPM from repository
  package:
    name: "{{ java_oracle_package }}"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Ensure installation directory exists
  file:
    path: "{{ java_install_dir }}"
    state: directory
    mode: '0755'
  when: java_format == "targz" and java_vendor == "Oracle"

- name: Install Oracle Java tarball
  unarchive:
    src: "{{ java_oracle_tarball }}"
    dest: "{{ java_install_dir }}"
    remote_src: yes
  when: java_format == "targz" and java_vendor == "Oracle"

- name: Set directory permissions
  file:
    path: "{{ java_install_dir }}"
    state: directory
    mode: '0755'
    recurse: yes
  when: java_format == "targz" and java_vendor == "Oracle"

- name: Install JCE policy software
  unarchive:
    src: "{{ java_jce_tarball }}"
    dest: "{{ java_install_dir }}"
    remote_src: yes
  when: java_version == "8" and java_jce_enabled and java_vendor == "Oracle"

- name: Set Java as default alternative
  alternatives:
    name: java
    path: "{{ java_install_dir }}/bin/java"
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "Oracle"

- name: Determine JAVA_HOME
  shell: "readlink -f $(which java)"
  register: java_home_path

- name: Set JAVA_HOME in /etc/profile.d/java_home.sh
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME="{{ java_home_path.stdout }}"'
    create: yes
    state: present


