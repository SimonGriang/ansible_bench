---

  - name: Import additional tasks from a file
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Enable the Redis module for RHEL 8
    dnf:
      name: redis
      state: present
    when: ansible_distribution == "Red Hat Enterprise Linux" and ansible_distribution_major_version == "8"

  - name: Install Redis packages
    package:
      name: "{{ redis_packages }}"
      state: present

  - name: Configure Redis with a template
    template:
      src: redis.conf.j2
      dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
      owner: "{{ redis_owner }}"
      group: "{{ redis_group }}"
      mode: "{{ redis_mode }}"
    notify: Restart Redis

  - name: Start and enable the Redis service
    service:
      name: "{{ redis_service }}"
      state: started
      enabled: true


