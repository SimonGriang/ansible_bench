---

  - name: Import the assert.yml file
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Configure apk package manager
    when: ansible_pkg_mgr == "apk"
    apk:
      update_cache: yes
      changed_when: false
    notify: Reboot

  - name: Configure apt package manager
    when: ansible_pkg_mgr == "apt"
    apt_preferences:
      packages: "{{ apt_hold_packages }}"
      state: hold
    apt:
      update_cache: yes
      upgrade: dist
      autoremove: "{{ apt_autoremove | default(false) }}"
    notify: Reboot

  - name: Update all software using dnf package manager
    when: ansible_pkg_mgr in ["dnf", "dnf5"]
    dnf:
      name: "*"
      exclude: "{{ dnf_exclude_packages | default([]) }}"
      state: latest
    notify: Reboot

  - name: Update all software using pacman package manager
    when: ansible_pkg_mgr == "pacman"
    pacman:
      update_cache: yes
      upgrade: yes
    notify: Reboot

  - name: Configure yum package manager
    when: ansible_pkg_mgr == "yum"
    block:
      - name: Update all software using yum (version 6)
        yum:
          name: "*"
          state: latest
        when: ansible_distribution_major_version == "6"
        notify: Reboot

      - name: Update all software using yum (other versions)
        yum:
          name: "*"
          state: latest
        when: ansible_distribution_major_version != "6"
        yum_command: yum -y install yum-utils
        notify: Reboot

  - name: Update all software using zypper package manager
    when: ansible_pkg_mgr == "zypper"
    zypper:
      name: "*"
      state: latest
    notify: Reboot


