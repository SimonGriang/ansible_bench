---
- name: Update the package manager cache
  package:
    update_cache: true
  become: true

- name: Install the keepalived package
  package:
    name: keepalived
    state: present
  become: true

- name: Create a directory for keepalived configuration files
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: '0755'
  become: true

- name: Create a Kubernetes API health check script for Debian systems
  template:
    src: templates/check_apiserver.sh.j2
    dest: /etc/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: '0755'
  become: true
  when: ansible_os_family == "Debian"
  notify: restart keepalived

- name: Create a Kubernetes API health check script for RedHat systems
  template:
    src: templates/check_apiserver.sh.j2
    dest: /usr/libexec/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: '0755'
  become: true
  when: ansible_os_family == "RedHat"
  notify: restart keepalived

- name: Create an RKE2 Server health check script for Debian systems
  template:
    src: templates/check_rke2server.sh.j2
    dest: /etc/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: '0755'
  become: true
  when: ansible_os_family == "Debian"
  notify: restart keepalived

- name: Create an RKE2 Server health check script for RedHat systems
  template:
    src: templates/check_rke2server.sh.j2
    dest: /usr/libexec/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: '0755'
  become: true
  when: ansible_os_family == "RedHat"
  notify: restart keepalived

- name: Create the keepalived configuration file
  template:
    src: templates/keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: '0644'
  become: true
  notify: restart keepalived

- name: Enable keepalived service and ensure it is not masked
  systemd:
    name: keepalived
    enabled: true
    masked: false
    state: started
  become: true
  notify: restart keepalived

- name: Flush handlers to apply changes
  meta: flush_handlers


