---

  - name: Import assert tasks
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install Vault prerequisites
    package:
      name: "{{ vault_prerequisites }}"
      state: present

  - name: Include installation method tasks
    include_tasks: "{{ vault_installation_method }}.yml"

  - name: Add Vault environment variables
    lineinfile:
      path: /etc/vault.d/vault.env
      line: "{{ item }}"
      create: yes
      state: present
    with_items: "{{ vault_env_vars }}"
    notify: restart vault

  - name: Include hardening tasks
    include_tasks: hardening.yml

  - name: Start and enable Vault OSS service
    service:
      name: vault
      state: started
      enabled: yes
    when: vault_type == "oss"

  - name: Enable Vault service (non-OSS)
    service:
      name: vault
      enabled: yes
    when: vault_type != "oss"


