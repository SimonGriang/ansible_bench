---

  - name: Restart the RKE2 service on a specified node.
    service:
      name: "{{ rke2_service_name }}"
      state: restarted
    notify: "Service (re)started"

  - name: Wait for all nodes to be ready again.
    shell: kubectl get nodes -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}' | grep True | wc -l
    register: ready_nodes
    until: ready_nodes.stdout == "{{ rke2_cluster_group_name | length }}"
    retries: 100
    delay: 15
    delegate_to: "{{ inventory_hostname }}"
    run_once: true
    skip_check: true

  - name: Wait for all pods to be ready again.
    shell: kubectl get pods --all-namespaces -o jsonpath='{range .items[*]}{.status.phase}{"\n"}{end}' | grep -E 'Running|Succeeded' | wc -l
    register: ready_pods
    until: ready_pods.stdout == "{{ rke2_total_pods }}"
    retries: 100
    delay: 15
    delegate_to: "{{ inventory_hostname }}"
    run_once: true
    skip_check: true
    when: rke2_wait_for_all_pods_to_be_ready is defined


