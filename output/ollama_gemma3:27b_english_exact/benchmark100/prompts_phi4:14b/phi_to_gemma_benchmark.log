- name: Download RKE2 installation script if not in airgap mode.
  command: curl -sSL https://get.rke2.io | sh
  become: true
  when: not rke2_airgap_mode

- name: Copy local RKE2 installation script if in airgap mode using the 'copy' method.
  copy:
    src: "{{ rke2_install_script }}"
    dest: /tmp/rke2-install.sh
    mode: 0755
  become: true
  when: rke2_airgap_mode and rke2_airgap_implementation == 'copy'
  force: yes

- name: Create RKE2 artifacts folder if in airgap mode and the implementation is not 'exists'.
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: 0755
  become: true
  when: rke2_airgap_mode and rke2_airgap_implementation != 'exists'

- name: Download RKE2 checksum and artifacts with a fallback mechanism for airgap mode using the 'download' method.
  block:
    - name: Download RKE2 checksum file
      ansible.builtin.uri:
        url: "{{ rke2_checksum_url }}"
        dest: /tmp/rke2-checksum.txt
      become: true
      retries: 3
      delay: 5
      register: download_checksum

    - name: Download RKE2 artifacts
      ansible.builtin.uri:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_dir }}"
        validate_certs: false
      become: true
      retries: 3
      delay: 5
      register: download_artifacts

    rescue:
      - name: Download RKE2 artifacts locally
        copy:
          src: "{{ rke2_local_artifacts_dir }}/"
          dest: "{{ rke2_artifacts_dir }}/"
          remote_src: yes
        become: true
      - name: Copy local checksum file
        copy:
          src: "{{ rke2_local_checksum_file }}"
          dest: /tmp/rke2-checksum.txt
        become: true


