---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/cron.conf
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
  notify: restart cron

- name: Configure path
  lineinfile:
