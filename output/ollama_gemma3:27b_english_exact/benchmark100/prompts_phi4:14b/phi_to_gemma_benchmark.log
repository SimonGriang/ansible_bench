---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Set server-specific node taints
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: Node
      metadata:
        name: "{{ inventory_hostname }}"
        labels:
          node-role.kubernetes.io/server: ""
      spec:
        taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Template the RKE2 configuration file
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed

- name: Template the kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: 0600
  when: rke2_kubelet_config != ""
  notify: Config file changed

- name: Configure Containerd registry settings
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: 0600
  when: rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != ""
  notify: Config file changed

- name: Determine if an etcd restore from a file is necessary
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != "" and ansible_facts.services['rke2-server.service'].state != 'running' and ansible_facts.services['rke2-server.service'].enabled == false

- name: Determine if an etcd restore from S3 is necessary
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != "" and rke2_s3_endpoint is defined and rke2_s3_bucket is defined

- name: Restore etcd from a snapshot file
  command: "rke2 server --restore-from-snapshot={{ rke2_etcd_snapshot_file }}"
  register: etcd_restore_result
  changed_when: etcd_restore_result.rc != 0
  when: do_etcd_restore

- name: Restore etcd from an S3 snapshot
  command: "rke2 server --restore-from-snapshot={{ rke2_etcd_snapshot_file }} --s3-endpoint={{ rke2_s3_endpoint }} --s3-bucket={{ rke2_s3_bucket }} --s3-key={{ rke2_s3_key }}"
  register: etcd_restore_s3_result
  changed_when: etcd_restore_s3_result.rc != 0
  when: do_etcd_restore_from_s3

- name: Start the RKE2 server service
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
    env:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask the RKE2 agent service
  systemd:
    name: rke2-agent.service
    state: stopped
    enabled: no
    masked: yes

- name: Wait for the first server to be ready without CNI
  kubernetes.core.k8s_info:
    kind: Node
    name: "{{ inventory_hostname }}"
    namespace: default
    kubeconfig: /etc/rancher/rke2/rke2.yaml
    wait: yes
    wait_timeout: 900
    retries: 100
    delay: 15
  when: rke2_cni == 'none'

- name: Wait for the first server to be ready with CNI
  kubernetes.core.k8s_info:
    kind: Node
    name: "{{ inventory_hostname }}"
    namespace: default
    kubeconfig: /etc/rancher/rke2/rke2.yaml
    wait: yes
    wait_timeout: 600
    retries: 40
    delay: 15
  when: rke2_cni != 'none'

- name: Clean up old nodes and secrets if restoring etcd
  block:
    - name: Get registered node names
      command: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
      register: registered_nodes
      changed_when: false

    - name: Identify nodes no longer present
      set_fact:
        nodes_to_remove: "{{ registered_nodes.stdout_lines | difference(node_names) }}"

    - name: Delete associated secrets and nodes
      kubernetes.core.k8s:
        state: absent
        definition:
          apiVersion: v1
          kind: Secret
          metadata:
            name: "{{ item }}"
          type: kubernetes.io/service-account-token
      loop: "{{ nodes_to_remove }}"
      ignore_errors: yes
  when: do_etcd_restore or do_etcd_restore_from_s3

- name: Set the active server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"


