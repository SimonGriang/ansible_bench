---

  - name: Remove obsolete Docker packages
    yum:
      name: "{{ docker_obsolete_packages }}"
      state: absent

  - name: Add Docker GPG key
    rpm_key:
      key: "{{ docker_yum_gpg_key }}"
      state: present
    when: docker_add_repo

  - name: Add Docker repository
    yum_repository:
      name: docker-{{ docker_edition }}
      description: Docker Repository
      baseurl: "{{ docker_yum_repo_url }}"
      gpgcheck: yes
      gpgkey: "{{ docker_yum_gpg_key }}"
      enabled: yes
      state: present
    when: docker_add_repo

  - name: Configure Docker Nightly repo
    lineinfile:
      path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
      regexp: '^\[nightly\]$'
      line: "[nightly]"
      state: present
    when: docker_add_repo and docker_yum_repo_enable_nightly

  - name: Configure Docker Test repo
    lineinfile:
      path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
      regexp: '^\[test\]$'
      line: "[test]"
      state: present
    when: docker_add_repo and docker_yum_repo_enable_test

  - name: Configure containerd on RHEL 8
    block:
      - name: Ensure runc is not installed
        yum:
          name: runc
          state: absent
      - name: Ensure container-selinux is installed
        yum:
          name: container-selinux
          state: present
      - name: Ensure containerd.io is installed
        yum:
          name: containerd.io
          state: present
    when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"


