nd: Secret\n          metadata:\n            name: "{{ item }}"\n          type: kubernetes.io/service-account-token\n      loop: "{{ nodes_to_remove }}"\n      ignore_errors: yes\n  when: do_etcd_restore or do_etcd_restore_from_s3\n\n- name: Set the active server variable\n  set_fact:\n    active_server: "{{ inventory_hostname }}"\n  delegate_to: "{{ item }}"\n  loop: "{{ groups[rke2_cluster_group_name] }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-14T16:42:41.352441237Z', 'done': True, 'done_reason': 'stop', 'total_duration': 92499720894, 'load_duration': 219214321, 'prompt_eval_count': 2997, 'prompt_eval_duration': 9534712361, 'eval_count': 1401, 'eval_duration': 82743727483, 'model_name': 'gemma3:27b'} id='run--e5a75b09-f98c-4f95-a133-557b7de4e7cf-0' usage_metadata={'input_tokens': 2997, 'output_tokens': 1401, 'total_tokens': 4398}
