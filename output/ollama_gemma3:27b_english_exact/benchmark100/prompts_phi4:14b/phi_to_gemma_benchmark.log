---

  - name: Gather bootstrap facts
    raw: cat /etc/os-release
    register: bootstrap_facts
    changed_when: false
    no_log: true

  - name: Set bootstrap distribution facts
    set_fact:
      bootstrap_distribution: "{{ item.distribution }}"
      bootstrap_distribution_major_version: "{{ item.major_version | regex_search('(\\d+)') }}"
    with_items:
      - distribution: "{{ bootstrap_facts.stdout | regex_search('^NAME=\"([^\"]+)\"', '\\1') }}"
        major_version: "{{ bootstrap_facts.stdout | regex_search('VERSION_ID=\"([^\"]+)\"', '\\1') }}"
    when:
      - bootstrap_facts.rc == 0
      - bootstrap_distribution is not defined
      - bootstrap_facts.stdout | regex_search('PRETTY_NAME=\"([^\"]+)\"', '\\1') | lower == 'ubuntu' or bootstrap_facts.stdout | regex_search('PRETTY_NAME=\"([^\"]+)\"', '\\1') | lower == 'debian' or bootstrap_facts.stdout | regex_search('PRETTY_NAME=\"([^\"]+)\"', '\\1') | lower == 'centos' or bootstrap_facts.stdout | regex_search('PRETTY_NAME=\"([^\"]+)\"', '\\1') | lower == 'rhel' or bootstrap_facts.stdout | regex_search('PRETTY_NAME=\"([^\"]+)\"', '\\1') | lower == 'fedora'

  - name: Set bootstrap operating system family
    set_fact:
      bootstrap_os_family: "{{ item.family }}"
    with_items:
      - family: "Debian"
        distributions:
          - Ubuntu
          - Debian
      - family: "RedHat"
        distributions:
          - CentOS
          - RHEL
          - Fedora
    when: bootstrap_distribution is defined


