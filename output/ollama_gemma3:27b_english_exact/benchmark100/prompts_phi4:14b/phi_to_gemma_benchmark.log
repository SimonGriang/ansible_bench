- name: Generate SSL private key files for each item
  community.crypto.openssl_privatekey:
    path: "{{ item.private_key_path }}"
    size: "{{ item.key_size | default(2048) }}"
    type: rsa
    permissions: "{{ item.key_permissions | default('0600') }}"
    owner: "{{ item.key_owner | default('root') }}"
    group: "{{ item.key_group | default('root') }}"
  loop: "{{ ssl_items }}"

- name: Generate SSL CSR (Certificate Signing Request) files for each item
  community.crypto.openssl_csr:
    path: "{{ item.csr_path }}"
    private_key_path: "{{ item.private_key_path }}"
    common_name: "{{ item.common_name }}"
    permissions: "{{ item.csr_permissions | default('0600') }}"
    owner: "{{ item.csr_owner | default('root') }}"
    group: "{{ item.csr_group | default('root') }}"
  loop: "{{ ssl_items }}"

- name: Generate SSL certificates for each item
  community.crypto.x509_certificate:
    path: "{{ item.cert_path }}"
    private_key_path: "{{ item.private_key_path }}"
    csr_path: "{{ item.csr_path }}"
    permissions: "{{ item.cert_permissions | default('0644') }}"
    owner: "{{ item.cert_owner | default('root') }}"
    group: "{{ item.cert_group | default('root') }}"
  loop: "{{ ssl_items }}"

- name: Create PKCS#12 files for each item
  community.crypto.openssl_pkcs12:
    path: "{{ item.pkcs12_path }}"
    private_key_path: "{{ item.private_key_path }}"
    certificate_path: "{{ item.cert_path }}"
    friendly_name: "{{ item.friendly_name }}"
    permissions: "{{ item.pkcs12_permissions | default('0600') }}"
    owner: "{{ item.pkcs12_owner | default('root') }}"
    group: "{{ item.pkcs12_group | default('root') }}"
  loop: "{{ ssl_items }}"

- name: Read and register the content of the private key files for each item
  ansible.builtin.slurp:
    src: "{{ item.private_key_path }}"
  register: private_key_content
  loop: "{{ ssl_items }}"

- name: Read and register the content of the certificate files for each item
  ansible.builtin.slurp:
    src: "{{ item.cert_path }}"
  register: certificate_content
  loop: "{{ ssl_items }}"

- name: Combine the registered private key and certificate content into a single file for each item
  ansible.builtin.copy:
    dest: "{{ item.combined_path }}"
    content: |
      {{ private_key_content.results[loop.index0].content | b64decode }}
      {{ certificate_content.results[loop.index0].content | b64decode }}
    permissions: "{{ item.combined_permissions | default('0644') }}"
    owner: "{{ item.combined_owner | default('root') }}"
    group: "{{ item.combined_group | default('root') }}"
  loop: "{{ ssl_items }}"


