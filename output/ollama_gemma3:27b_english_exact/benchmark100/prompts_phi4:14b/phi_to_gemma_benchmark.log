---

- name: Disable swap if vault_hardening_disable_swap is set and swap is currently enabled
  command: swapoff -a
  become: true
  when: vault_hardening_disable_swap
  ignore_errors: true
  register: swapoff_result
- name: Ensure swap is not mounted permanently
  mount:
    path: /swapfile
    state: absent
    fstab: no
  become: true
  when: vault_hardening_disable_swap and swapoff_result.rc == 0

- name: Disable core dumps if vault_hardening_disable_core_dumps is set
  pam_limits:
    domain: '*'
    limit_type: soft
    limit_item: core
    limit_value: 0
    state: present
  become: true
  when: vault_hardening_disable_core_dumps

- name: Disable core dumps if vault_hardening_disable_core_dumps is set
  pam_limits:
    domain: '*'
    limit_type: hard
    limit_item: core
    limit_value: 0
    state: present
  become: true
  when: vault_hardening_disable_core_dumps

- name: Disable shell command history for vault commands if vault_hardening_disable_shell_command_history is set
  copy:
    dest: /etc/profile.d/vault_no_history.sh
    content: |
      # Ignore vault commands in history
      HISTIGNORE+=":vault:"
    mode: 0755
  become: true
  when: vault_hardening_disable_shell_command_history

- name: Configure SELinux and/or AppArmor if vault_hardening_configure_selinux_apparmor is set
  block:
    - name: Ensure selinux-policy is installed
      package:
        name: selinux-policy
        state: present
      become: true
      when: ansible_selinux.status == "enabled" and vault_hardening_configure_selinux_apparmor
    - name: Set SELinux policy to enforcing
      selinux:
        policy: enforcing
      become: true
      when: ansible_selinux.status == "enabled" and vault_hardening_configure_selinux_apparmor
  when: vault_hardening_configure_selinux_apparmor


