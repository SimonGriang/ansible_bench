---
- name: Import assert tasks
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for bootstrap port
  wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when: not (inventory_hostname | is_container or inventory_hostname | is_docker) and bootstrap_wait_for_host

- name: Prepare system
  block:
    - name: Wait for connection
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"

    - name: Verify sudo access
      command: "sudo -n true"
      register: sudo_test
      ignore_errors: true
      changed_when: false
      failed_when: sudo_test.rc != 0

  rescue:
    - name: Gather bootstrap facts
      setup:
        filter: ansible_facts.*
      become: false

    - name: Install bootstrap packages (raw)
      raw: "apt-get update && apt-get install -y {{ bootstrap_facts_packages | join(' ') }}"
      become: false
      when: ansible_distribution == "Debian" or ansible_distribution == "Ubuntu"

    - name: Install bootstrap packages (raw)
      raw: "yum install -y {{ bootstrap_facts_packages | join(' ') }}"
      become: false
      when: ansible_distribution == "RedHat" or ansible_distribution == "CentOS"

- name: Gather Ansible facts
  setup:
    filter: ansible_facts.*
  become: false

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
  become: "{{ bootstrap_become }}"


