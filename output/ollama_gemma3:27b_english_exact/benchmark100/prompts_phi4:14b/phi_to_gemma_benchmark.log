---
- name: Gather bootstrap facts
  raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: Set bootstrap distribution and major version facts
  set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_distribution_major_version: "{{ item.value | regex_search('(\\d+)') | first }}"
  with_items: "{{ bootstrap_facts.stdout | from_yaml | dict(PRETTY_NAME) }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout | regex_search('^' + bootstrap_search[item.key] + '$')

- name: Determine and set the bootstrap OS family
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  with_items: "{{ bootstrap_os_family_map | dict }}"
  loop_control:
    label: "Processing OS family: {{ item.key }}"
  when: bootstrap_distribution in bootstrap_os_family_map[item.key]


