---
- name: Load OS-specific variables
  include_vars:
    file: "vars/{{ ansible_os_family }}.yml"
    name: os_vars
  ignore_errors: yes

- name: Load main variables if OS-specific file is not found
  include_vars:
    file: "vars/main.yml"
    name: os_vars
  when: os_vars is not defined

- name: Include RedHat-specific setup tasks
  include_tasks: setup-RedHat.yml
  when: ansible_os_family == 'RedHat'

- name: Include Debian-specific setup tasks
  include_tasks: setup-Debian.yml
  when: ansible_os_family == 'Debian'

- name: Install Docker packages (older Ansible or non-RedHat/Debian)
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: yes
  when: ansible_version.major < 2 or ansible_os_family not in ['RedHat', 'Debian']

- name: Install Docker packages (newer Ansible and RedHat/Debian)
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: true
  notify: restart docker
  ignore_errors: yes
  when: ansible_version.major >= 2 and ansible_os_family in ['RedHat', 'Debian']

- name: Install Docker Compose plugin (older Ansible or non-RedHat/Debian)
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: yes
  when: ansible_version.major < 2 or ansible_os_family not in ['RedHat', 'Debian'] and docker_install_compose_plugin

- name: Install Docker Compose plugin (newer Ansible and RedHat/Debian)
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: true
  notify: restart docker
  ignore_errors: yes
  when: ansible_version.major >= 2 and ansible_os_family in ['RedHat', 'Debian'] and docker_install_compose_plugin

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    mode: 0755
  when: docker_daemon_options | length > 0

- name: Configure Docker daemon options
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_json(indent=2) }}"
    mode: 0644
  notify: restart docker
  when: docker_daemon_options | length > 0

- name: Ensure Docker service is started and enabled
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: yes
  when: docker_service_manage

- name: Flush handlers
  meta: flush_handlers

- name: Include Docker Compose setup tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Retrieve Docker group information
  getent:
    database: group
    key: docker
  register: docker_group
  when: docker_users | length > 0

- name: Determine if any users need to be added to the Docker group
  set_fact:
    at_least_one_user_to_modify: "{{ docker_users | difference(docker_group.group.members | map('int')) | length > 0 }}"
  when: docker_users | length > 0

- name: Include tasks to modify user group memberships
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify is defined


