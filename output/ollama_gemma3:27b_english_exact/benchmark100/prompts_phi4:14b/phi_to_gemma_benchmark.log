---
  - name: Migrate the Java JDK vendor from adoptopenjdk to temurin if selected
    set_fact:
      java_jdk_vendor: "temurin"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Gather OS-specific variables for the Java JDK
    include_vars:
      file: "vars/{{ ansible_os_family }}.yml"
      name: java_os_vars
    with_first_found:
      - "{{ role_path }}/vars/java_vars_{{ ansible_os_family }}.yml"
      - "{{ role_path }}/vars/java_vars_default.yml"

  - name: Gather architecture-specific variables for the Java JDK
    include_vars:
      file: "vars/{{ ansible_architecture }}.yml"
      name: java_arch_vars
    with_first_found:
      - "{{ role_path }}/vars/java_vars_{{ ansible_architecture }}.yml"
      - "{{ role_path }}/vars/java_vars_default.yml"

  - name: Set OS-specific Java variables
    set_fact:
      java_os_specific_vars: "{{ java_os_vars | default({}) }}"
    when: java_os_specific_vars is not defined

  - name: Set OS and architecture-specific Java variables
    set_fact:
      java_combined_vars: "{{ java_os_vars | combine(java_arch_vars) }}"
    when: java_combined_vars is not defined

  - name: Set specific Java variables
    set_fact:
      java_home: "{{ java_combined_vars.java_home | default('') }}"

  - name: Handle Debian pre-requisites for Java installation
    block:
      - name: Remove deprecated repositories
        apt_repository:
          repo: ppa:webupd8/java
          state: absent

      - name: Install extra packages
        apt:
          name:
            - software-properties-common
            - apt-transport-https
          state: present
          update_cache: yes

      - name: Add key repositories
        apt_key:
          url: "{{ java_combined_vars.java_key_url }}"
          state: present

      - name: Add required repositories
        apt_repository:
          repo: "{{ java_combined_vars.java_repo_url }}"
          state: present
          update_cache: yes
    when: ansible_os_family == "Debian"

  - name: Handle RedHat pre-requisites for Java installation
    block:
      - name: Add key repositories
        rpm_key:
          key: "{{ java_combined_vars.java_key_url }}"
          state: present

      - name: Add required repositories
        yum_repository:
          name: "{{ java_combined_vars.java_repo_name }}"
          description: "{{ java_combined_vars.java_repo_description }}"
          baseurl: "{{ java_combined_vars.java_repo_url }}"
          gpgcheck: yes
          gpgkey: "{{ java_combined_vars.java_key_url }}"
          enabled: yes
    when: ansible_os_family == "RedHat"

  - name: Install required libraries for Java
    package:
      name: "{{ java_combined_vars.java_libraries }}"
      state: present

  - name: Install Java on Debian systems
    apt:
      name: "{{ java_combined_vars.java_package_name }}"
      state: present
      update_cache: yes
    when: ansible_os_family == "Debian"

  - name: Install Java on RedHat systems
    yum:
      name: "{{ java_combined_vars.java_package_name }}"
      state: present
      update_cache: yes
    when: ansible_os_family == "RedHat"

  - name: Export Java environment variables
    template:
      src: jdk.sh.j2
      dest: /etc/profile.d/jdk.sh
      mode: 0755

  - name: Source Java environment variables
    shell: source /etc/profile.d/jdk.sh
    args:
      executable: /bin/bash

  - name: Correct Java version selection for versions less than 11 on Debian systems
    alternatives:
      name: java
      path: "{{ java_home }}/bin/java"
      state: auto
    when: ansible_os_family == "Debian" and java_version < 11

  - name: Correct Java version selection for versions 11 or greater on Debian systems
    alternatives:
      name: java
      path: "{{ java_home }}/bin/java"
      state: auto
    when: ansible_os_family == "Debian" and java_version >= 11
