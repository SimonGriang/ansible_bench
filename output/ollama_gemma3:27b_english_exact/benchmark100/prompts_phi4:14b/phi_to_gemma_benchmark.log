nd: Secret\n          metadata:\n            name: "{{ item }}"\n          type: kubernetes.io/service-account-token\n      loop: "{{ nodes_to_remove }}"\n      ignore_errors: yes\n  when: do_etcd_restore or do_etcd_restore_from_s3\n\n- name: Set the active server variable\n  set_fact:\n    active_server: "{{ inventory_hostname }}"\n  delegate_to: "{{ item }}"\n  loop: "{{ groups[rke2_cluster_group_name] }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-14T16:41:07.461023368Z', 'done': True, 'done_reason': 'stop', 'total_duration': 92097036217, 'load_duration': 189052526, 'prompt_eval_count': 2997, 'prompt_eval_duration': 9881584890, 'eval_count': 1401, 'eval_duration': 82025097700, 'model_name': 'gemma3:27b'} id='run--dcb6a794-7b4b-4fb6-b345-2f7521ff75be-0' usage_metadata={'input_tokens': 2997, 'output_tokens': 1401, 'total_tokens': 4398}
