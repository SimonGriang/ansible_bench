---

- name: Assert systemd is the init system
  ansible.builtin.assert:
    that:
      - ansible_service_mgr == 'systemd'
    fail_msg: "This playbook only works with systemd."
    success_msg: "Systemd is the init system."

- name: Retrieve the latest release information for Grafana Loki
  ansible.builtin.uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    method: GET
    headers:
      Authorization: "Bearer {{ github_token }}"
      Accept: application/vnd.github+json
    validate_certs: true
    retries: 5
    delay: 2
  register: loki_release
  when: promtail_version == "latest"
  
- name: Set promtail_version fact
  ansible.builtin.set_fact:
    promtail_version: "{{ loki_release.json.tag_name | regex_replace('^v', '') }}"
  when:
    - promtail_version == "latest"
    - loki_release.status == 200

- name: Verify the existence of a local promtail binary archive
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.linux-amd64"
  register: promtail_local_stat
  when: promtail_binary_local_dir is defined

- name: Assert local promtail binary exists
  ansible.builtin.assert:
    that:
      - promtail_local_stat.stat.exists
    msg: "Local promtail binary archive not found at {{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.linux-amd64"
  when:
    - promtail_binary_local_dir is defined
    - not promtail_local_stat.stat.exists

- name: Download and verify the checksum for the promtail binary
  ansible.builtin.url:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail-{{ promtail_version }}.linux-amd64.sha256"
    dest: "/tmp/promtail-{{ promtail_version }}.linux-amd64.sha256"
    mode: '0644'
  register: checksum_download
  when: not promtail_binary_local_dir


