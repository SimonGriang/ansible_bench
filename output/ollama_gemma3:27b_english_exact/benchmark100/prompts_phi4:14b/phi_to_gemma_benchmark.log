, 'done': True, 'done_reason': 'stop', 'total_duration': 37017914483, 'load_duration': 195391561, 'prompt_eval_count': 1240, 'prompt_eval_duration': 4072444149, 'eval_count': 540, 'eval_duration': 32748965310, 'model_name': 'gemma3:27b'} id='run--0beb4b80-24a1-45b5-96d6-c2fba5a593cc-0' usage_metadata={'input_tokens': 1240, 'output_tokens': 540, 'total_tokens': 1780}
