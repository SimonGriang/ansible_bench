    create: yes
    owner: root
    group: root
    mode: '0644'
    insertafter: EOF

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ["Alpine", "Archlinux"]

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  handlers:
    - set_mysql_root_password
    - restart_mysql

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
