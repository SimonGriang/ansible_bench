---
- name: Create the RKE2 configuration directory with appropriate permissions
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Set server node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_node_type == 'server'

- name: Set agent node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_node_type == 'agent'

- name: Deploy the RKE2 configuration file
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed

- name: Deploy the kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: 0600
  when: rke2_kubelet_config != ""
  notify: Config file changed

- name: Deploy the Containerd registry configuration file
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: 0600
  when: rke2_custom_registry_path != ""
  notify: Config file changed

- name: Start the RKE2 service on all nodes
  systemd:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: yes
    daemon_reload: yes
  retries: 10
  delay: 3
  register: rke2_service_status
  notify: Service (re)started

- name: Mask other RKE2 services on non-applicable nodes
  systemd:
    name: "{{ item }}"
    state: masked
    enabled: false
  loop:
    - rke2-agent.service
    - rke2-server.service
  when: (rke2_node_type == 'server' and item == 'rke2-agent.service') or (rke2_node_type == 'agent' and item == 'rke2-server.service')

- name: Verify node readiness without CNI
  shell: |
    kubectl get nodes -o wide | awk '{print $1}' | while read node; do
      kubectl describe node "$node" | grep -q "MemoryPressure\|DiskPressure\|PIDPressure\|CNI"
      if [ $? -eq 0 ]; then
        echo "Node $node is not ready"
        exit 1
      fi
    done
  retries: 100
  delay: 15
  register: node_readiness_check
  when: ansible_host == ansible_first_server
  ignore_errors: true

- name: Verify node readiness with CNI
  shell: kubectl get nodes -o wide | grep Ready | wc -l
  retries: 100
  delay: 15
  register: node_count
  when: ansible_host == ansible_first_server and not ansible_check
  ignore_errors: true


