---

- name: Install Keepalived when HA mode is enabled
  include_tasks: install_keepalived.yml
  when: rke2_ha_mode and rke2_keepalived_enabled and inventory_hostname in groups['rke2_servers'] and rke2_api_ip is defined

- name: Download and install RKE2 version
  include_tasks: download_install_rke2.yml

- name: Apply CIS Hardening
  include_tasks: apply_cis_hardening.yml
  when: cis_profile is defined

- name: Find Active Server
  include_tasks: find_active_server.yml

- name: Enable IPVS kernel module
  include_tasks: enable_ipvs_kernel_module.yml
  when: 
    kubevip_ipvs_enabled and 
    inventory_hostname in groups['rke2_servers'] and 
    rke2_ha_mode and 
    not rke2_keepalived_enabled

- name: Copy kube-vip manifests to the masternode
  include_tasks: copy_kube_vip_manifests.yml
  when: 
    rke2_ha_mode and 
    kubevip_enabled and 
    not rke2_keepalived_enabled

- name: Copy ingress-nginx manifests to the masternode
  include_tasks: copy_ingress_nginx_manifests.yml
  when: ingress_nginx_values is defined and ingress_nginx_values | length > 0

- name: Prepare very first server node in the cluster
  include_tasks: prepare_first_server_node.yml
  when: 
    (rke2_cluster_size == 1) or 
    (active_server is not defined)

- name: Restore etcd specific tasks
  include_tasks: restore_etcd.yml
  when: 
    active_server is defined and 
    (inventory_hostname == active_server) or 
    (rke2_cluster_size == 1) and 
    etcd_restore is defined

- name: Download kubeconfig to ansible localhost
  include_tasks: download_kubeconfig.yml
  when: 
    download_kubeconfig_enabled and 
    (rke2_cluster_size == 1) or 
    (inventory_hostname == active_server)

- name: Prepare and join remaining nodes of the cluster
  include_tasks: prepare_join_remaining_nodes.yml
  when: 
    active_server is defined and 
    rke2_cluster_size > 1

- name: Rolling cordon and drain restart when version changes - servers
  include_tasks: rolling_cordon_drain_restart_servers.yml
  when: rke2_version_changed

- name: Rolling cordon and drain restart when version changes - agents
  include_tasks: rolling_cordon_drain_restart_agents.yml
  when: rke2_version_changed

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  include_tasks: rolling_restart_config_change.yml
  when: config_files_changed

- name: Final steps
  include_tasks: final_steps.yml


