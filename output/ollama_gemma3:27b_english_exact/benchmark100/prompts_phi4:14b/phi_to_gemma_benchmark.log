---

- name: Check if Java certificates exist on the system
  stat:
    path: "{{ item }}"
    state: file
  with_items:
    - /path/to/certificate1.pem
    - /path/to/certificate2.pem
    - /path/to/certificate3.pem
  register: java_certs_check

- name: Fail the playbook if any Java certificate is missing
  fail:
    msg: "Missing Java certificate: {{ item.item }} - state: {{ item.stat.exists }}"
  loop: "{{ java_certs_check.results }}"
  when: not item.stat.exists

- name: Set keystore directory variables for Java versions less than 11
  set_fact:
    keystore_dir: "/opt/java/keystore_pre11"
  when: java_version < 11

- name: Set keystore directory variables for Java versions 11 and above
  set_fact:
    keystore_dir: "/opt/java/keystore_11plus"
  when: java_version >= 11

- name: Import SSL certificates into the Java keystore
  java_cert:
    path: "{{ item }}"
    keystore: "{{ keystore_dir }}/truststore.jks"
    keystore_password: "changeit"
    truststore_password: "changeit"
  with_items:
    - /path/to/certificate1.pem
    - /path/to/certificate2.pem
    - /path/to/certificate3.pem


