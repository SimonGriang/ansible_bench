content='```yaml\n---\n\n  - name: Import assert tasks\n    import_tasks: assert.yml\n    delegate_to: localhost\n    run_once: true\n\n  - name: Install Apache HTTP server\n    ansible.builtin.package:\n      name: "{{ httpd_packages }}"\n      state: present\n\n  - name: Configure SELinux\n    ansible.builtin.selinux:\n      state: enabled\n      booleans: "{{ httpd_sebooleans }}"\n      ports:\n        - port: "{{ httpd_port }}"\n          protocol: tcp\n        - port: "{{ httpd_ssl_port }}"\n          protocol: tcp\n    when: ansible_facts.selinux.status == \'enabled\'\n\n  - name: Configure Apache HTTP server\n    ansible.builtin.template:\n      src: "{{ httpd_config_src }}"\n      dest: "{{ httpd_config_dest }}"\n      owner: root\n      group: root\n      mode: \'0644\'\n    notify:\n      - config validity testing\n      - restart httpd\n\n  - name: Activate Apache HTTP modules (Debian)\n    ansible.builtin.command: a2enmod "{{ httpd_modules_to_activate_with_command }}"\n    changed_when: false\n    when: ansible_facts.os_family == \'Debian\'\n    notify:\n      - config validity testing\n      - restart httpd\n\n  - name: Import SSL configuration tasks\n    import_tasks: ssl.yml\n    when: https_ssl_enable\n\n  - name: Import location configuration tasks\n    import_tasks: locations.yml\n    when: httpd_locations is defined\n\n  - name: Import virtual host configuration tasks\n    import_tasks: vhosts.yml\n    when: httpd_vhosts is defined\n\n  - name: Configure ports (Debian/SUSE)\n    ansible.builtin.template:\n      src: "{{ httpd_ports_conf }}"\n      dest: "/etc/httpd/ports.conf"\n      owner: root\n      group: root\n      mode: \'0644\'\n    when: ansible_facts.os_family in [\'Debian\', \'Suse\']\n    notify:\n      - config validity testing\n      - restart httpd\n\n  - name: Import directory configuration tasks\n    import_tasks: directories.yml\n    when: httpd_directories is defined\n\n  - name: Flush handlers\n    ansible.builtin.meta: flush_handlers\n\n  - name: Remove example index file\n    ansible.builtin.file:\n      path: "{{ httpd_data_dir }}/index.html"\n      state: absent\n    when: httpd_remove_example\n\n  - name: Start and enable Apache HTTP server\n    ansible.builtin.service:\n      name: "{{ httpd_service }}"\n      state: started\n      enabled: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-14T15:51:20.221613513Z', 'done': True, 'done_reason': 'stop', 'total_duration': 39335208644, 'load_duration': 174839498, 'prompt_eval_count': 995, 'prompt_eval_duration': 3254222910, 'eval_count': 649, 'eval_duration': 35904589022, 'model_name': 'gemma3:27b'} id='run--0e2d32e7-c26a-4ced-b758-2a032e98d0c9-0' usage_metadata={'input_tokens': 995, 'output_tokens': 649, 'total_tokens': 1644}
