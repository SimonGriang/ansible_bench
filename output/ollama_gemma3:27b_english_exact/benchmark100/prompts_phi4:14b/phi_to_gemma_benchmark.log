---
- name: Import external tasks from assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install DNS-related packages
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Create necessary directories for DNS configuration and data
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0755'
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create a group for DNS service
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Create a user for the DNS service
  ansible.builtin.user:
    name: "{{ dns_owner }}"
    system: true
    state: present

- name: Generate the rndc key for DNS configuration
  ansible.builtin.command:
    cmd: rndc-confgen -a -k rndc-key
    creates: /etc/rndc.key

- name: Set file permissions for the rndc key
  ansible.builtin.file:
    path: /etc/rndc.key
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0640'

- name: Download the root hints file if DNS caching is enabled
  ansible.builtin.get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ dns_datadir }}/db.root"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  notify: Rndc reload

- name: Create primary zone files from templates
  ansible.builtin.template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item }}.db"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add DNS zones to the main configuration file
  ansible.builtin.template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  notify: Restart DNS service

- name: Create systemd service override if using systemd
  block:
    - name: Create systemd override directory
      ansible.builtin.file:
        path: /etc/systemd/system/{{ dns_service }}.d
        state: directory
        mode: '0755'
    - name: Copy systemd override file
      ansible.builtin.copy:
        src: override.conf
        dest: /etc/systemd/system/{{ dns_service }}.d/override.conf
        mode: '0644'
    - name: Reload systemd
      ansible.builtin.systemd:
        daemon_reload: true
  when: service_manager == 'systemd'

- name: Start and enable the DNS service
  ansible.builtin.service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


