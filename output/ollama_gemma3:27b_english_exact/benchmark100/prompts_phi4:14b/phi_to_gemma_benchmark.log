---

  - name: Import the assert.yml file from the localhost
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install the necessary cron packages
    package:
      name: "{{ cron_packages }}"
      state: present

  - name: Configure the shell environment for cron
    lineinfile:
      path: "{{ cron_configuration }}"
      line: "SHELL={{ cron_shell }}"
      mode: "0600"
    notify: restart cron

  - name: Configure the PATH environment variable for cron
    lineinfile:
      path: "{{ cron_configuration }}"
      line: "PATH={{ cron_path }}"
      mode: "0600"
    notify: restart cron

  - name: Configure the MAILTO environment variable for cron
    lineinfile:
      path: "{{ cron_configuration }}"
      line: "MAILTO={{ cron_mailto }}"
      mode: "0600"
    notify: restart cron

  - name: Ensure the cron service is started and enabled
    service:
      name: "{{ cron_service }}"
      state: started
      enabled: true
    when: cron_service is defined and cron_service != ""

  - name: Schedule the specified cron jobs
    cron:
      name: "{{ item.name }}"
      job: "{{ item.job }}"
      minute: "{{ item.minute }}"
      hour: "{{ item.hour }}"
      day: "{{ item.day }}"
      month: "{{ item.month }}"
      weekday: "{{ item.weekday }}"
      user: "{{ item.user }}"
    loop: "{{ cron_jobs }}"
    when: cron_jobs is defined


