content='```yaml\n---\n- name: Check if Helm binary exists\n  stat:\n    path: "{{ helm_bin_path }}"\n  register: helm_check\n\n- name: Retrieve existing Helm version\n  command: "{{ helm_bin_path }} version"\n  failed_when: false\n  changed_when: false\n  register: helm_existing_version\n\n- name: Download Helm binary\n  unarchive:\n    remote_src: "{{ helm_repo_path }}"\n    dest: /tmp/\n    creates: "{{ helm_bin_path }}"\n    extra_opts: [--strip]\n  register: helm_download\n  when: not helm_check.stat.exists or helm_existing_version.stdout != helm_version\n\n- name: Install Helm binary\n  copy:\n    src: /tmp/helm\n    dest: "{{ helm_bin_path }}"\n    mode: 0755\n  become: true\n  when: helm_download is changed\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-14T14:34:02.054894687Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14178614078, 'load_duration': 163566139, 'prompt_eval_count': 593, 'prompt_eval_duration': 1959962304, 'eval_count': 218, 'eval_duration': 12053979747, 'model_name': 'gemma3:27b'} id='run--8953d996-b8e0-42ae-a9ac-de6034082ccf-0' usage_metadata={'input_tokens': 593, 'output_tokens': 218, 'total_tokens': 811}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Retrieve existing Helm version
  command: "{{ helm_bin_path }} version"
  failed_when: false
  changed_when: false
  register: helm_existing_version

- name: Download Helm binary
  unarchive:
    remote_src: "{{ helm_repo_path }}"
    dest: /tmp/
    creates: "{{ helm_bin_path }}"
    extra_opts: [--strip]
  register: helm_download
  when: not helm_check.stat.exists or helm_existing_version.stdout != helm_version

- name: Install Helm binary
  copy:
    src: /tmp/helm
    dest: "{{ helm_bin_path }}"
    mode: 0755
  become: true
  when: helm_download is changed


