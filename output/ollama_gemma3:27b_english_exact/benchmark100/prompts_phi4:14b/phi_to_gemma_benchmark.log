---
- name: Import assert.yml task
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  ansible.builtin.package:
    name: "{{ service_required_packages }}"
    state: present
  notify: Gather facts

- name: Configure systemd service templates
  when: ansible_service_mgr == "systemd"
  ansible.builtin.template:
    src: systemd.j2
    dest: "/etc/systemd/system/{{ item.name }}.service"
    mode: 0644
  with_items: "{{ service_list }}"
  notify: Systemctl daemon-reload

- name: Configure sysvinit service templates
  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]
  ansible.builtin.template:
    src: sysvinit.j2
    dest: "/etc/init.d/{{ item.name }}"
    mode: 0755
  with_items: "{{ service_list }}"

- name: Manage the state and enablement of services
  with_items: "{{ service_list }}"
  ansible.builtin.service:
    name: "{{ item.name }}"
    state: "{{ item.state | default(omit) }}"
    enabled: "{{ item.enabled | default(omit) }}"

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


