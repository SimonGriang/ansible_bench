---

  - name: Check variable configuration
    import_tasks: assert_variables.yml
    delegate_to: localhost
    run_once: true

  - name: Wait for host to become available
    wait_for:
      port: "{{ wait_port | default(22) }}"
      timeout: "{{ wait_timeout | default(60) }}"
    when: connection != 'container' and wait_for_host | bool
    connection: local
    become: "{{ become_user | default(None) }}"
    become_method: "{{ become_method | default(None) }}"
    become_privileges_escalate: "{{ become_privileges_escalate | default(False) }}"

  - name: Prepare the system
    block:
      - name: Test connection to host
        ping:
        register: connection_result
        ignore_errors: true

      - name: Debug connection failure
        debug:
          msg: "Connection to host failed. Timeout: {{ wait_timeout | default(60) }}"
        when: connection_result.failed

      - name: Gather facts
        setup:
        become: "{{ become_user | default(None) }}"
        become_method: "{{ become_method | default(None) }}"
        become_privileges_escalate: "{{ become_privileges_escalate | default(False) }}"

      - name: Install packages using raw command (if needed)
        command: "{{ item }}"
        when: ansible_os_family == "Darwin"
        with_items: "{{ packages }}"
        become: "{{ become_user | default(None) }}"
        become_method: "{{ become_method | default(None) }}"
        become_privileges_escalate: "{{ become_privileges_escalate | default(False) }}"

      - name: Install packages using package module
        package:
          name: "{{ item }}"
          state: present
          update_cache: yes
        with_items: "{{ packages }}"
        become: "{{ become_user | default(None) }}"
        become_method: "{{ become_method | default(None) }}"
        become_privileges_escalate: "{{ become_privileges_escalate | default(False) }}"


