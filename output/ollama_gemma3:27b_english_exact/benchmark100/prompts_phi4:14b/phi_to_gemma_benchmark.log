content='```yaml\n---\n\n- name: Determine if the system is EFI.\n  stat:\n    path: /sys/firmware/efi/efivars\n  register: is_efi\n\n- name: Remove unwanted grub.cfg for EFI systems.\n  file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: is_efi.stat.exists\n\n- name: Install a user template for Grub.\n  copy:\n    src: files/grub.cfg.template\n    dest: /etc/grub.d/40_custom\n    mode: \'0755\'\n  notify: update_grub\n\n- name: Add a password to the EFI Grub configuration.\n  lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: \'set superusers="your_username"\'\n    create: yes\n  when: is_efi.stat.exists\n  notify: update_grub\n\n- name: Add a password to the MBR Grub configuration.\n  lineinfile:\n    path: /etc/grub2.cfg\n    line: \'set superusers="your_username"\'\n    create: yes\n  when: is_efi.stat.exists\n  notify: update_grub\n\n- name: Modify files to add --unrestricted class.\n  lineinfile:\n    path: "{{ item }}"\n    regexp: \'CLASS \'\n    line: \'CLASS --unrestricted\'\n  with_items:\n    - /etc/grub.d/40_custom\n  notify: update_grub\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-14T13:39:44.530086121Z', 'done': True, 'done_reason': 'stop', 'total_duration': 22108097230, 'load_duration': 197389144, 'prompt_eval_count': 537, 'prompt_eval_duration': 1749988696, 'eval_count': 361, 'eval_duration': 20158288168, 'model_name': 'gemma3:27b'} id='run--73732850-30f4-43bd-9a6f-78aaf1d11308-0' usage_metadata={'input_tokens': 537, 'output_tokens': 361, 'total_tokens': 898}
