---

- name: Create a directory for SSH keys if user management is enabled
  file:
    path: "{{ ssh_key_directory }}"
    state: directory
    mode: '0700'
  when: user_management_enabled

- name: Manage user accounts, ensuring they are created or updated with specified parameters
  user:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    comment: "{{ item.comment | default('') }}"
    home: "{{ item.home | default('/home/' + item.name) }}"
    shell: "{{ item.shell | default('/bin/bash') }}"
    groups: "{{ item.groups | default([]) }}"
    append: yes
  with_items: "{{ users }}"
  register: user_result

- name: Set sudo privileges for users if specified in their configuration
  copy:
    dest: "/etc/sudoers.d/{{ item.name }}"
    content: "{{ item.sudo }}"
    mode: '0440'
  with_items: "{{ users }}"
  when: item.sudo is defined

- name: Remove sudo privileges for users if not specified in their configuration
  file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: absent
  with_items: "{{ users }}"
  when: item.sudo is not defined

- name: Generate a private SSH key for users who require SSH key management
  command:
    cmd: "ssh-keygen -t rsa -b 2048 -N '' -f {{ ssh_key_path }}/{{ item.name }}_id_rsa"
  with_items: "{{ users }}"
  when: item.ssh_key_management_enabled and not lookup('file', '{{ ssh_key_path }}/{{ item.name }}_id_rsa', errors='ignore')
  register: ssh_keygen_private_result

- name: Generate a public SSH key for users who require SSH key management
  command:
    cmd: "ssh-keygen -t rsa -b 2048 -N '' -f {{ ssh_key_path }}/{{ item.name }}_id_rsa -y > {{ ssh_key_path }}/{{ item.name }}_id_rsa.pub"
  with_items: "{{ users }}"
  when: item.ssh_key_management_enabled and not lookup('file', '{{ ssh_key_path }}/{{ item.name }}_id_rsa.pub', errors='ignore')
  register: ssh_keygen_public_result

- name: Convert the SSH key to a PPK format for users who require SSH key management
  command:
    cmd: "puttygen {{ ssh_key_path }}/{{ item.name }}_id_rsa -o {{ ssh_key_path }}/{{ item.name }}_id_rsa.ppk"
  with_items: "{{ users }}"
  when: item.ssh_key_management_enabled and not lookup('file', '{{ ssh_key_path }}/{{ item.name }}_id_rsa.ppk', errors='ignore')
  register: puttygen_result

- name: Determine the home directory for users, defaulting to /home if the user is not found
  command: "id -u {{ item.name }}"
  with_items: "{{ users }}"
  register: user_info
  ignore_errors: true
  when: item.home is not defined
  changed_when: false
  failed_when: user_info.rc != 0

- name: Create an .ssh directory in the user's home directory if SSH key management is enabled or private keys need to be set
  file:
    path: "{{ item.home }}/.ssh"
    state: directory
    mode: '0700'
  with_items: "{{ users }}"
  when: item.ssh_key_management_enabled or item.private_keys is defined

- name: Deploy authorized SSH keys for users if specified
  lineinfile:
    path: "{{ item.home }}/.ssh/authorized_keys"
    line: "{{ key }}"
    create: yes
  with_items: "{{ users }}"
  loop_control:
    loop_var: key
  when: item.authorized_keys is defined

- name: Remove unauthorized SSH keys from users if specified
  lineinfile:
    path: "{{ item.home }}/.ssh/authorized_keys"
    regexp: "{{ key }}"
    state: absent
  with_items: "{{ users }}"
  loop_control:
    loop_var: key
  when: item.unauthorized_keys is defined

- name: Copy generated private SSH keys to the user's .ssh directory if specified
  copy:
    src: "{{ ssh_key_path }}/{{ item.name }}_id_rsa"
    dest: "{{ item.home }}/.ssh/id_rsa"
    mode: '0600'
  with_items: "{{ users }}"
  when: item.copy_private_key is defined

- name: Check the password validity period for users
  command: "chage -l {{ item.name }}"
  with_items: "{{ users }}"
  register: chage_result
  ignore_errors: true
  changed_when: false
  failed_when: chage_result.rc != 0

- name: Set the password validity period for users if a specific duration is defined
  command: "chage -M {{ item.password_validity_days }} {{ item.name }}"
  with_items: "{{ users }}"
  when: item.password_validity_days is defined and item.password_validity_days != chage_result.stdout | regex_search('Maximum password age') | regex_replace('Maximum password age: ', '') | int

- name: Place additional private key files in the user's .ssh directory if specified
  copy:
    src: "{{ item.key_file }}"
    dest: "{{ item.home }}/.ssh/{{ item.key_file | basename }}"
    mode: '0600'
  with_items: "{{ users }}"
  when: item.additional_keys is defined


