---
- name: Create a system group for Vault
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create a system user for Vault
  user:
    name: "{{ vault_user }}"
    group: "{{ vault_group }}"
    shell: "{{ vault_user_shell }}"
    state: present

- name: Create a download directory for Vault
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Download the Vault binary
  get_url:
    url: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}/vault.zip"
    validate_certs: false
  register: vault_download_result
  until: vault_download_result.changed == false
  retries: 3
  delay: 5

- name: Unarchive the Vault binary
  unarchive:
    src: "{{ vault_download_path }}/vault.zip"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    creates: "{{ vault_download_path }}/vault"

- name: Set ownership and permissions on Vault binary
  file:
    path: "{{ vault_download_path }}/vault"
    owner: root
    group: root
    mode: '0755'

- name: Check if the main Vault directory exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create the main Vault directory if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
  when: not vault_check_path.stat.exists

- name: Create additional directories in the main Vault directory
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
  loop: "{{ vault_directories }}"

- name: Create data directories for Vault
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
  loop: "{{ vault_data_directories }}"

- name: Generate a TLS key and certificate for Vault
  openssl_certificate:
    path: "{{ vault_data_directory }}/tls/vault.pem"
    cert_file: "{{ vault_data_directory }}/tls/vault.pem"
    key_file: "{{ vault_data_directory }}/tls/vault.key"
    common_name: "{{ vault_common_name }}"
    state: present
  notify: restart vault

- name: Set ownership of TLS files
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0600'
  loop: "{{ vault_tls_files }}"

- name: Copy the Vault binary to the appropriate location
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    owner: root
    group: root
    mode: '0755'
  notify: restart vault

- name: Set specific capabilities on the Vault binary
  setcap:
    path: "{{ vault_path }}/usr/bin/vault"
    cap_list: "cap_ipc_lock=ep"
    state: present

- name: Create a vault environment file
  copy:
    dest: "{{ vault_path }}/etc/vault.d/vault.env"
    content: "{{ vault_env_content }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'
  notify: restart vault

- name: Ensure the systemd system directory exists
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy the Vault service file for systemd
  template:
    src: templates/vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'
  notify: reload systemd

- name: Copy the Vault configuration file
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: '0644'
  notify: restart vault

- name: Flush handlers to apply changes
  meta: flush_handlers


