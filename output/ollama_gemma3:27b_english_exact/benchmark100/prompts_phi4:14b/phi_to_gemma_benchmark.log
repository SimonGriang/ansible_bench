tion': 218459655, 'prompt_eval_count': 2368, 'prompt_eval_duration': 8208572533, 'eval_count': 1134, 'eval_duration': 67892211425, 'model_name': 'gemma3:27b'} id='run--822f0714-c4d7-499d-8141-6cad623c24be-0' usage_metadata={'input_tokens': 2368, 'output_tokens': 1134, 'total_tokens': 3502}
