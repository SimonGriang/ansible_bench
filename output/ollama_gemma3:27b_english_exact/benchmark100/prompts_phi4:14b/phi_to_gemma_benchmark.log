      name: "{{ item }}"
      state: "{{ rsyslog_package_state }}"
    loop: "{{ rsyslog_features }}"

  - name: Configure default rsyslog settings
    template:
      src: "{{ rsyslog_config_file_format }}"
      dest: "{{ rsyslog_dest_conf_file }}"
    when: rsyslog_deploy_default_config
    notify: Restart rsyslog

  - name: Ensure rsyslog configuration directory exists
    file:
      path: /etc/rsyslog.d/
      state: directory
      mode: '0755'

  - name: Configure rsyslog to forward logs
    template:
      src: forward_rule.conf.j2
      dest: "/etc/rsyslog.d/{{ rsyslog_forward_rule_name }}"
    when: not rsyslog_deploy_default_config
    notify: Restart rsyslog

  - name: Configure additional rsyslog configuration files
    block:
      - name: Create/Update rsyslog config file
        copy:
          dest: "/etc/rsyslog.d/{{ item.name }}"
          content: "{{ item.content | default('') }}"
          owner: root
          group: adm
          mode: '0644'
        when: item.state == 'present'
      - name: Validate rsyslog config file
        command: rsyslogd -N1 -f /etc/rsyslog.d/{{ item.name }}
        changed_when: false
        failed_when: false
        register: rsyslog_validation
        when: item.validate and item.state == 'present'
    loop: "{{ rsyslog_rsyslog_d_files }}"
    notify: Restart rsyslog

  - name: Start and enable rsyslog service
    service:
      name: "{{ rsyslog_service }}"
      state: started
      enabled: true


