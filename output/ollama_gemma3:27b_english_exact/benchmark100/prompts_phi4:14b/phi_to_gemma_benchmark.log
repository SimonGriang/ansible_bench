- name: Check the current version of Docker Compose installed on the system.
  command: docker-compose version
  register: docker_compose_version_check
  changed_when: false

- name: Set a fact for the current Docker Compose version if it is defined and the output is not empty.
  set_fact:
    current_docker_compose_version: "{{ docker_compose_version_check.stdout | regex_search('docker-compose version (.*)', '\\1') | trim }}"
  when: docker_compose_version_check.stdout is defined and docker_compose_version_check.stdout != ""

- name: Delete the existing Docker Compose binary if the installed version does not match the desired version.
  file:
