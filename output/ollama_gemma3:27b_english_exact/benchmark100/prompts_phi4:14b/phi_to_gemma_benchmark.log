n        mode: \'0755\'\n    - name: Copy systemd override file\n      copy:\n        src: override.conf\n        dest: /etc/systemd/system/{{ dns_service }}.d/override.conf\n        mode: \'0644\'\n    - name: Reload systemd\n      systemd:\n        daemon_reload: true\n  when: service_manager == \'systemd\'\n\n- name: Start and enable the DNS service\n  service:\n    name: "{{ dns_service }}"\n    state: started\n    enabled: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-14T13:32:33.903504726Z', 'done': True, 'done_reason': 'stop', 'total_duration': 46866789076, 'load_duration': 222223792, 'prompt_eval_count': 808, 'prompt_eval_duration': 2912218560, 'eval_count': 733, 'eval_duration': 43730968633, 'model_name': 'gemma3:27b'} id='run--510b1ae5-0db5-4f47-83fa-b538e4f94c4a-0' usage_metadata={'input_tokens': 808, 'output_tokens': 733, 'total_tokens': 1541}
