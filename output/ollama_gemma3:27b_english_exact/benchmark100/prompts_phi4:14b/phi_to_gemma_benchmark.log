---

- name: Collect the OS release information from the bootstrap server without making changes.
  command: cat /etc/os-release
  register: bootstrap_facts
  user: "{{ bootstrap_user }}"
  changed_when: false

- name: Set bootstrap facts for distribution and major version.
  set_fact:
    bootstrap_distribution: "{{ item.distribution }}"
    bootstrap_distribution_major_version: "{{ item.major_version }}"
  with_items:
    - distribution: "{{ bootstrap_facts.stdout_lines | select('match', 'PRETTY_NAME=\"(.+?)\"') | map('regex_replace', 'PRETTY_NAME=\"(.+?)\"', '\\1') | first }}"
      major_version: "{{ bootstrap_facts.stdout_lines | select('match', 'VERSION_ID=\"(.+?)\"') | map('regex_replace', 'VERSION_ID=\"(.+?)\"', '\\1') | split('.')[0] }}"
  when: bootstrap_facts.rc == 0 and bootstrap_distribution is not defined and bootstrap_facts.stdout | regex_search('PRETTY_NAME=')
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

- name: Set bootstrap facts for the OS family.
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  with_items: "{{ bootstrap__os_family_map }}"
  when: bootstrap_distribution is defined and bootstrap_os_family is not defined
  loop_control:
    check: continue
