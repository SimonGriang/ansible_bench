---

- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
    delegate_to: localhost
    run_once: true

- name: Install HashiCorp products using package installation
  ansible.builtin.block:
    - name: Download HashiCorp repository configuration (RedHat/Rocky)
      ansible.builtin.get_url:
        url: "{{ hashicorp_repo_url }}"
        dest: /tmp/hashicorp.repo
        mode: '0644'
      when: ansible_os_family in ["RedHat", "Rocky"]

    - name: Configure HashiCorp repository (RedHat/Rocky)
      ansible.builtin.copy:
        src: /tmp/hashicorp.repo
        dest: /etc/yum.repos.d/hashicorp.repo
        owner: root
        group: root
        mode: '0644'
      when: ansible_os_family in ["RedHat", "Rocky"]

    - name: Ensure GPG package is installed (Debian)
      ansible.builtin.package:
        name: gnupg
        state: present
      when: ansible_os_family == "Debian"

    - name: Import HashiCorp GPG key (Debian)
      ansible.builtin.apt_key:
        url: "{{ hashicorp_gpg_key_url }}"
        state: present
      when: ansible_os_family == "Debian"

    - name: Configure HashiCorp repository (Debian)
      ansible.builtin.apt_repository:
        repo: "deb {{ hashicorp_repo_base_url }} {{ ansible_distribution_release }} main"
        state: present
      when: ansible_os_family == "Debian"

    - name: Install HashiCorp products
      ansible.builtin.package:
        name: "{{ hashicorp_products }}"
        state: present
  when: installation_method == "package"

- name: Install HashiCorp products manually
  ansible.builtin.block:
    - name: Download and extract HashiCorp products
      ansible.builtin.unarchive:
        src: "{{ hashicorp_source_url }}"
        dest: "{{ hashicorp_destination }}"
        owner: "{{ hashicorp_owner }}"
        group: "{{ hashicorp_group }}"
        mode: '0755'
  when: installation_method == "manual"


