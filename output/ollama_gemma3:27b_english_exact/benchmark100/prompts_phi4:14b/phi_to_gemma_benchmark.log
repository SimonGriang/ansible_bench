---
- name: Import common assertions for the httpd role.
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install the apache httpd package.
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings for httpd if SELinux is enabled.
  ansible.posix.seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
  with_items: "{{ httpd_sebooleans }}"
  when: ansible_selinux.status == 'enabled'

- name: Configure SELinux ports if SELinux is enabled.
  community.general.seport:
    port: "{{ httpd_port }}"
    protocol: tcp
    state: present
    setype: http_port_t
  when: ansible_selinux.status == 'enabled'

- name: Configure SELinux SSL ports if SELinux is enabled.
  community.general.seport:
    port: "{{ httpd_ssl_port }}"
    protocol: tcp
    state: present
    setype: https_port_t
  when: ansible_selinux.status == 'enabled'

- name: Configure the httpd main configuration file using a template.
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
  notify:
    - test httpd configuration
    - restart httpd

- name: Activate httpd modules using a command on Debian systems.
  ansible.builtin.command: a2enmod "{{ item }}"
  with_items: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == "Debian"
  notify:
    - test httpd configuration

- name: Import SSL configuration tasks if HTTPS is enabled.
  ansible.builtin.import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import location configuration tasks if locations are defined.
  ansible.builtin.import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual host configuration tasks if virtual hosts are defined.
  ansible.builtin.import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports using a template on Debian and Suse systems.
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: /etc/httpd/ports.conf
  notify:
    - test httpd configuration
    - restart httpd
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directory configuration tasks if directories are defined.
  ansible.builtin.import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush all pending handlers.
  ansible.builtin.meta: flush_handlers

- name: Remove the default index.html file if specified.
  ansible.builtin.file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example

- name: Start and enable the httpd service.
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


