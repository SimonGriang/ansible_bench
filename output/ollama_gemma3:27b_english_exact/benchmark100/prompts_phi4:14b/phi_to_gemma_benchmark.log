---
- name: Import assertion tasks
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Pre-configure Debian systems for Postfix
  become: true
  debconf:
    name: postfix
    question: main_mailer_type
    value: "No configuration"
  when: ansible_os_family == "Debian"

- name: Install Postfix
  become: true
  package:
    name: postfix
    state: present

- name: Conditionally install postfix-mysql
  become: true
  package:
    name: postfix-mysql
    state: present
  when:
    - postfix_virtual_mailbox_maps is defined
    - postfix_virtual_mailbox_domains is defined
    - postfix_virtual_alias_maps is defined
    - (postfix_virtual_mailbox_maps | lower == 'mysql') or \
      (postfix_virtual_mailbox_domains | lower == 'mysql') or \
      (postfix_virtual_alias_maps | lower == 'mysql')

- name: Configure Postfix transport maps
  become: true
  template:
    src: transport
    dest: /etc/postfix/transport
  notify: validate_transport_maps

- name: Configure Postfix header checks
  become: true
  template:
    src: header_checks
    dest: /etc/postfix/header_checks
  notify: reload_postfix

- name: Set values for Postfix main.cf (part 1)
  set_fact:
    postfix_recipient_restrictions: "{{ postfix_recipient_restrictions | default('') }}"
    postfix_sender_access: "{{ postfix_sender_access | default('') }}"

- name: Set values for Postfix main.cf (part 2)
  set_fact:
    mynetworks: "{{ postfix_mynetworks | default('') }}"
    mydestination: "{{ postfix_mydestination | default('') }}"
    relay_domains: "{{ postfix_relay_domains | default('') }}"
    smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default('') }}"
    smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default('') }}"
    virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default('') }}"
    virtual_alias_domains: "{{ postfix_virtual_alias_domains | default('') }}"

- name: Configure Postfix main.cf
  become: true
  template:
    src: main.cf
    dest: /etc/postfix/main.cf
  notify:
    - validate_main_cf
    - restart_postfix

- name: Configure Postfix master.cf
  become: true
  template:
    src: master.cf
    dest: /etc/postfix/master.cf
  notify:
    - validate_master_cf
    - restart_postfix

- name: Create directories for TLS certificates and keys
  become: true
  file:
    path: "{{ postfix_tls_cert_dir }}"
    state: directory
    mode: '0755'
  when: postfix_tls_cert_dir is defined and postfix_tls_cert_dir

- name: Deploy Postfix TLS server certificate
  become: true
  copy:
    src: "{{ postfix_tls_cert_source }}"
    dest: "{{ postfix_tls_cert_dest }}"
  notify: reload_postfix
  when: postfix_tls_cert_source is defined and postfix_tls_cert_source

- name: Deploy Postfix TLS server key
  become: true
  copy:
    src: "{{ postfix_tls_key_source }}"
    dest: "{{ postfix_tls_key_dest }}"
  notify: reload_postfix
  when: postfix_tls_key_source is defined and postfix_tls_key_source

- name: Flush Postfix handlers
  meta: flush_handlers

- name: Configure Postfix aliases
  become: true
  lineinfile:
    path: "{{ postfix_aliases_path }}"
    line: "{{ postfix_aliases }}"
  notify:
    - rebuild_alias_db
    - reload_postfix
  when: postfix_aliases is defined

- name: Configure Postfix sender access
  become: true
  lineinfile:
    path: "{{ postfix_sender_access_path }}"
    line: "{{ postfix_sender_access }}"
  notify:
    - rebuild_sender_access_db
    - reload_postfix
  when: postfix_sender_access is defined

- name: Configure Postfix recipient access
  become: true
  lineinfile:
    path: "{{ postfix_recipient_access_path }}"
    line: "{{ postfix_recipient_access }}"
  notify:
    - validate_recipient_access
    - rebuild_recipient_access_db
    - reload_postfix
  when: postfix_recipient_access is defined

- name: Place SASL password map
  become: true
  copy:
    dest: "{{ postfix_sasl_password_map }}"
    content: "{{ postfix_smtp_sasl_password_map }}"
  notify: rebuild_sasl_password_map_db
  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map

- name: Flush Postfix handlers again
  meta: flush_handlers

- name: Start and enable Postfix service
  become: true
  service:
    name: postfix
    state: started
    enabled: true


