he password validity period for users if a specific duration is defined\n  command: "chage -M {{ item.password_validity_days }} {{ item.name }}"\n  with_items: "{{ users }}"\n  when: item.password_validity_days is defined and item.password_validity_days != chage_result.stdout | regex_search(\'Maximum password age\') | regex_replace(\'Maximum password age: \', \'\') | int\n\n- name: Place additional private key files in the user\'s .ssh directory if specified\n  copy:\n    src: "{{ item.key_file }}"\n    dest: "{{ item.home }}/.ssh/{{ item.key_file | basename }}"\n    mode: \'0600\'\n  with_items: "{{ users }}"\n  when: item.additional_keys is defined\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-14T15:43:24.571650023Z', 'done': True, 'done_reason': 'stop', 'total_duration': 89899412053, 'load_duration': 214650011, 'prompt_eval_count': 2877, 'prompt_eval_duration': 9446193155, 'eval_count': 1390, 'eval_duration': 80237204607, 'model_name': 'gemma3:27b'} id='run--eeb2c81e-954c-493c-9a5a-d943c2f6b9d8-0' usage_metadata={'input_tokens': 2877, 'output_tokens': 1390, 'total_tokens': 4267}
