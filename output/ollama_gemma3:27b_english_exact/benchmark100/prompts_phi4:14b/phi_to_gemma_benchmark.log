---

- name: Retrieve all node names from an etcd cluster
  shell: kubectl --kubeconfig {{ kubeconfig_file }} get nodes -o jsonpath='{.items[*].metadata.name}'
  register: etcd_nodes

- name: Delete old nodes from the etcd cluster
  shell: kubectl --kubeconfig {{ kubeconfig_file }} delete node {{ item }}
  with_items: "{{ etcd_nodes.stdout_lines | difference(cluster_nodes) }}"
  ignore_errors: yes


