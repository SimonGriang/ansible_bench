---

  - name: Cordon and Drain the node during RKE2 upgrade
    command: kubectl cordon {{ rke2_node_name }}
    delegate_to: "{{ ansible_host }}"
    when: rke2_drain_node_during_upgrade
    register: drain
    retries: 100
    delay: 15
    until: drain.rc == 0
  
  - name: Restart the RKE2 service on the node
    ansible.builtin.service:
      name: "{{ rke2_service_name }}"
      state: restarted
    notify: Service (re)started

  - name: Wait for all nodes to be ready again
    command: kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' | grep true | wc -l
    delegate_to: "{{ ansible_host }}"
    register: ready_nodes
    retries: 100
    delay: 15
    until: ready_nodes.stdout == "{{ rke2_cluster_group_name }}"
    run_once: true

  - name: Uncordon the node after the upgrade
    command: kubectl uncordon {{ rke2_node_name }}
    delegate_to: "{{ ansible_host }}"
    when: rke2_drain_node_during_upgrade
    run_once: true

  - name: Wait for all pods to be ready again
    command: kubectl get pods -A -o jsonpath='{.items[?(@.status.phase!="Running" && @.status.phase!="Succeeded")].metadata.name}' | wc -l
    delegate_to: "{{ ansible_host }}"
    register: not_ready_pods
    retries: 100
    delay: 15
    until: not_ready_pods.stdout == "0"
    when: rke2_wait_for_all_pods_to_be_ready
    run_once: true

  - name: Wait for all pods to pass readiness checks
    command: kubectl wait --timeout=0s --for=condition=ready {{ rke2_wait_for_all_pods_to_be_healthy_args }}
    delegate_to: "{{ ansible_host }}"
    retries: 100
    delay: 15
    when: rke2_wait_for_all_pods_to_be_healthy
    run_once: true


