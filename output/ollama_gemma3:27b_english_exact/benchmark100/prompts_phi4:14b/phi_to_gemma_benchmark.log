---
- name: Enable Apache modules proxy and proxy_http
  community.general.apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  when: ansible_os_family in ['Debian', 'Suse']

- name: Configure Apache locations using a template
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_locations }}"
  loop_control:
    label: "Configuring location {{ item.name }}"
  notify:
    - test httpd configuration
    - restart httpd


