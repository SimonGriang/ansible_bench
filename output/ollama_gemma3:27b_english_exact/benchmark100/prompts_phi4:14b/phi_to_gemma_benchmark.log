- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required software packages
  ansible.builtin.package:
    name: "{{ users_requirements }}"
    state: present
  when: users_requirements | length > 0

- name: Loop through users_groups and include group.yml
  ansible.builtin.include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item }}"

- name: Ensure /etc/sudoers includes /etc/sudoers.d
  ansible.builtin.lineinfile:
    path: /etc/sudoers
    regexp: '^#include /etc/sudoers.d'
    line: '#include /etc/sudoers.d'
    validate: 'visudo -cf %s'

- name: Loop through users and include user.yml
  ansible.builtin.include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item }}"

- name: Manage cron permissions with template
  ansible.builtin.template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0644
  when: users_cron_allow

- name: Remove /etc/cron.allow if cron permissions are not required
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


