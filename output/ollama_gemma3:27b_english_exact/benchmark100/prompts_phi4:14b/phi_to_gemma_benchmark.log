  when: grub_options is defined and grub_options | length > 0
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX=(.*)$'
    line: "GRUB_CMDLINE_LINUX=\g<1> {{ item }}"
    validate: /bin/sh -eu /etc/default/grub
    mode: 0664
  loop: "{{ grub_options }}"
  notify: update grub

