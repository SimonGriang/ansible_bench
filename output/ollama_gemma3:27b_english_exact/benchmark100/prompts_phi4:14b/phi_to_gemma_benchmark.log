---

  - name: Enable Apache2 modules
    ansible.builtin.package:
      name:
        - libapache2-mod-proxy
        - libapache2-mod-proxy-http
      state: present
    become: true
    when: ansible_os_family in ['Debian', 'Suse']

  - name: Configure Apache2 locations
    ansible.builtin.template:
      src: location.conf.j2
      dest: "/etc/apache2/conf-available/{{ item.name }}.conf"
      mode: '0644'
    loop: "{{ httpd_locations }}"
    become: true
    notify:
      - validate httpd configuration
      - restart httpd


