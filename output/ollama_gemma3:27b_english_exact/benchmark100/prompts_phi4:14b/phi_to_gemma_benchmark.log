---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  lineinfile:
    path: /etc/pip.conf
    state: present
    create: yes
    section: global
    line: "index-url = {{ python_pip_proxy }}"
  when: python_pip_proxy is defined

- name: Set trusted hosts for pip
  lineinfile:
    path: /etc/pip.conf
    state: present
    create: yes
    section: global
    line: "trusted-host = {{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined

- name: Update pip to the latest version
  package:
    name: "{{ python_pip_pip_package }}"
    state: latest
  when:
    - python_pip_update
    - ansible_distribution_release != "bookworm"
    - ansible_distribution_release != "noble"
    - ansible_os_family != "Alpine"

- name: Install requested Python pip modules
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when:
    - ansible_distribution_release != "bookworm"
    - ansible_distribution_release != "noble"
    - ansible_os_family != "Alpine"


