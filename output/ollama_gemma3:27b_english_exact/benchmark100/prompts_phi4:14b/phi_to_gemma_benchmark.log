content='---\n- name: Check if Java certificates exist on the system\n  stat:\n    path: "{{ item }}"\n    state: file\n  with_items:\n    - /path/to/certificate1.pem\n    - /path/to/certificate2.pem\n    - /path/to/certificate3.pem\n  register: java_certs_check\n\n- name: Fail the playbook if any Java certificate is missing\n  fail:\n    msg: "Missing Java certificate: {{ item.item }} - state: {{ item.stat.exists }}"\n  loop: "{{ java_certs_check.results }}"\n  when: not item.stat.exists\n\n- name: Set keystore directory variables for Java versions less than 11\n  set_fact:\n    keystore_dir: "/opt/java/keystore_pre11"\n  when: java_version < 11\n\n- name: Set keystore directory variables for Java versions 11 and above\n  set_fact:\n    keystore_dir: "/opt/java/keystore_11plus"\n  when: java_version >= 11\n\n- name: Import SSL certificates into the Java keystore\n  java_cert:\n    path: "{{ item }}"\n    keystore: "{{ keystore_dir }}/truststore.jks"\n    keystore_password: "changeit"\n    truststore_password: "changeit"\n  with_items:\n    - /path/to/certificate1.pem\n    - /path/to/certificate2.pem\n    - /path/to/certificate3.pem\n' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-14T16:10:43.729231427Z', 'done': True, 'done_reason': 'stop', 'total_duration': 23644708398, 'load_duration': 176121811, 'prompt_eval_count': 1018, 'prompt_eval_duration': 3333184432, 'eval_count': 359, 'eval_duration': 20134034550, 'model_name': 'gemma3:27b'} id='run--f5cd2152-56ce-45fe-934b-2efd71ba69fe-0' usage_metadata={'input_tokens': 1018, 'output_tokens': 359, 'total_tokens': 1377}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Check if Java certificates exist on the system
  stat:
    path: "{{ item }}"
    state: file
  with_items:
    - /path/to/certificate1.pem
    - /path/to/certificate2.pem
    - /path/to/certificate3.pem
  register: java_certs_check

- name: Fail the playbook if any Java certificate is missing
  fail:
    msg: "Missing Java certificate: {{ item.item }} - state: {{ item.stat.exists }}"
  loop: "{{ java_certs_check.results }}"
  when: not item.stat.exists

- name: Set keystore directory variables for Java versions less than 11
  set_fact:
    keystore_dir: "/opt/java/keystore_pre11"
  when: java_version < 11

- name: Set keystore directory variables for Java versions 11 and above
  set_fact:
    keystore_dir: "/opt/java/keystore_11plus"
  when: java_version >= 11

- name: Import SSL certificates into the Java keystore
  java_cert:
    path: "{{ item }}"
    keystore: "{{ keystore_dir }}/truststore.jks"
    keystore_password: "changeit"
    truststore_password: "changeit"
  with_items:
    - /path/to/certificate1.pem
    - /path/to/certificate2.pem
    - /path/to/certificate3.pem


