- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - set_mysql_root_password
    - restart_mysql

- name: Configure mysql server
  template:
    src: mysql.conf.j2
    dest: "{{ mysql_configuration_destination }}"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ mysql_configuration_options }}"
  loop_control:
    loop_var: item
  vars:
    mysql_name: "{{ item.name }}"
    mysql_value: "{{ item.value }}"

