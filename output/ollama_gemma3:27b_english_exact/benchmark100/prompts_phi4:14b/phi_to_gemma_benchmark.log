n  ansible.builtin.template:\n    src: "{{ httpd_ports_conf }}"\n    dest: /etc/httpd/ports.conf\n  notify:\n    - test httpd configuration\n    - restart httpd\n  when: ansible_os_family in ["Debian", "Suse"]\n\n- name: Import directory configuration tasks if directories are defined.\n  ansible.builtin.import_tasks: directories.yml\n  when: httpd_directories is defined\n\n- name: Flush all pending handlers.\n  ansible.builtin.meta: flush_handlers\n\n- name: Remove the default index.html file if specified.\n  ansible.builtin.file:\n    path: /var/www/html/index.html\n    state: absent\n  when: httpd_remove_example\n\n- name: Start and enable the httpd service.\n  ansible.builtin.service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-14T15:22:06.585569793Z', 'done': True, 'done_reason': 'stop', 'total_duration': 54524051269, 'load_duration': 196069252, 'prompt_eval_count': 3280, 'prompt_eval_duration': 10346525288, 'eval_count': 787, 'eval_duration': 43980241344, 'model_name': 'gemma3:27b'} id='run--0bad3130-0d51-4b29-ae96-aeca6fbb00f3-0' usage_metadata={'input_tokens': 3280, 'output_tokens': 787, 'total_tokens': 4067}
