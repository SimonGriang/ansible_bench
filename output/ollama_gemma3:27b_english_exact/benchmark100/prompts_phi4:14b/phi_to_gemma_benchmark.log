---
- name: Ensure the directory /etc/openvpn/easy-rsa exists with appropriate permissions.
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Initialize the PKI directory using EasyRSA.
  command: /usr/bin/easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Build a CA certificate using EasyRSA without a passphrase.
  command: /usr/bin/easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Generate a Diffie-Hellman parameters file using EasyRSA.
  command: /usr/bin/easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Build a server certificate using EasyRSA without a passphrase.
  command: /usr/bin/easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Build a client certificate using EasyRSA without a passphrase.
  command: /usr/bin/easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Generate a Certificate Revocation List using EasyRSA.
  command: /usr/bin/easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Generate a TLS auth key using OpenVPN.
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  become: true

- name: Copy necessary EasyRSA files to /etc/openvpn/server.
  copy:
    src: "/etc/openvpn/easy-rsa/pki/ca.crt"
    dest: "/etc/openvpn/server/ca.crt"
    owner: root
    group: root
    mode: 0644
  become: true
- name: Copy necessary EasyRSA files to /etc/openvpn/server.
  copy:
    src: "/etc/openvpn/easy-rsa/pki/dh.pem"
    dest: "/etc/openvpn/server/dh.pem"
    owner: root
    group: root
    mode: 0644
  become: true
- name: Copy necessary EasyRSA files to /etc/openvpn/server.
  copy:
    src: "/etc/openvpn/easy-rsa/pki/ta.key"
    dest: "/etc/openvpn/server/ta.key"
    owner: root
    group: root
    mode: 0644
  become: true
- name: Copy necessary EasyRSA files to /etc/openvpn/server.
  copy:
    src: "/etc/openvpn/easy-rsa/pki/issued/server.crt"
    dest: "/etc/openvpn/server/server.crt"
    owner: root
    group: root
    mode: 0644
  become: true
- name: Copy necessary EasyRSA files to /etc/openvpn/server.
  copy:
    src: "/etc/openvpn/easy-rsa/pki/private/server.key"
    dest: "/etc/openvpn/server/server.key"
    owner: root
    group: root
    mode: 0644
  become: true
- name: Copy necessary EasyRSA files to /etc/openvpn.
  copy:
    src: "/etc/openvpn/easy-rsa/pki/ca.crt"
    dest: "/etc/openvpn/ca.crt"
    owner: root
    group: root
    mode: 0644
  become: true
- name: Copy necessary EasyRSA files to /etc/openvpn.
  copy:
    src: "/etc/openvpn/easy-rsa/pki/ta.key"
    dest: "/etc/openvpn/ta.key"
    owner: root
    group: root
    mode: 0644
  become: true

- name: Deploy the OpenVPN server configuration file.
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    owner: root
    group: root
    mode: 0644
  notify: restart openvpn
  become: true



