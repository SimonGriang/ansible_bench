- name: Include OS-specific setup tasks for Debian
  include_tasks: setup-Debian.yml
  when: ansible_os_family == "Debian"

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: true
  when: ansible_version.major < 2 and ansible_os_family != "RedHat" and \
        ansible_os_family != "Debian"

- name: Install Docker packages with downgrade option
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    update_cache: true
    downgrade: true
  notify: restart docker
  when: ansible_version.major >= 2 and \
        (ansible_os_family == "RedHat" or ansible_os_family == "Debian")

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: true
  when: docker_install_compose_plugin and \
        (ansible_version.major < 2 or \
         (ansible_os_family != "RedHat" and ansible_os_family != "Debian"))

- name: Install docker-compose-plugin with downgrade option
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    update_cache: true
    downgrade: true
  notify: restart docker
  when: docker_install_compose_plugin and ansible_version.major >= 2 and \
        (ansible_os_family == "RedHat" or ansible_os_family == "Debian")

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker
    state: directory
    mode: 0755
  when: docker_daemon_options is defined and docker_daemon_options | length > 0

- name: Configure Docker daemon options
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_json }}"
  notify: restart docker
  when: docker_daemon_options is defined and docker_daemon_options | length > 0

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: true
  when: docker_service_manage

- name: Ensure handlers are notified now to avoid firewall conflicts.
  meta: flush_handlers

- name: Include docker-compose tasks
  include_tasks: docker-compose.yml
