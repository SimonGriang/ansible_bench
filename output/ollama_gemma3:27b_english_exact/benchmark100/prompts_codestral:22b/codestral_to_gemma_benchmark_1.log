---

  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install python pip
    pip:
      name: "{{ python_pip_packages }}"
      state: present

  - name: Configure pip proxy
    lineinfile:
      path: /etc/pip.conf
      line: "index-url = {{ python_pip_proxy }}"
      mode: 0644
    when: python_pip_proxy is defined

  - name: Trust hosts
    lineinfile:
      path: /etc/pip.conf
      line: "trusted-host = {{ python_pip_trusted_host }}"
      mode: 0644
    when: python_pip_trusted_host is defined

  - name: Update pip
    pip:
      name: "{{ python_pip_pip_package }}"
      state: "{{ python_pip_pip_state }}"
      executable: "{{ python_pip_executable }}"
    when:
      - python_pip_update
      - ansible_distribution != "Debian" or (ansible_distribution == "Debian" and ansible_distribution_release in ["bookworm", "noble"]) == false
      - ansible_os_family != "Alpine"

  - name: Install requested modules
    pip:
      name: "{{ item.name }}"
      state: "{{ item.state | default('present') }}"
      version: "{{ item.version }}"
      executable: "{{ python_pip_executable }}"
    loop: "{{ python_pip_modules }}"
    loop_control:
      label: "{{ item.name }}"
    when:
      - ansible_distribution != "Debian" or (ansible_distribution == "Debian" and ansible_distribution_release in ["bookworm", "noble"]) == false
      - ansible_os_family != "Alpine"


