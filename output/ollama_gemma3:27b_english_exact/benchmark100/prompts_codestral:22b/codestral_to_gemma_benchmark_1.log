---

  - name: lookup bootstrap facts (raw)
    raw: cat /etc/os-release
    register: bootstrap_facts
    changed_when: false

  - name: set bootstrap facts (I)
    set_fact:
      bootstrap_distribution: "{{ item.value }}"
    with_items:
      - { value: "Ubuntu", key: "debian" }
      - { value: "Debian", key: "debian" }
      - { value: "CentOS", key: "redhat" }
      - { value: "RedHat", key: "redhat" }
      - { value: "Rocky", key: "redhat" }
      - { value: "AlmaLinux", key: "redhat" }
    when:
      - bootstrap_facts.rc == 0
      - bootstrap_distribution is not defined
      - bootstrap_facts.stdout | regex_search('^NAME="Ubuntu"', ignorecase=true) or bootstrap_facts.stdout | regex_search('^ID=debian"', ignorecase=true) or bootstrap_facts.stdout | regex_search('^ID=centos"', ignorecase=true) or bootstrap_facts.stdout | regex_search('^ID=redhat"', ignorecase=true) or bootstrap_facts.stdout | regex_search('^ID=rocky"', ignorecase=true) or bootstrap_facts.stdout | regex_search('^ID=almalinux"', ignorecase=true)
    become: "{{ bootstrap_become | default(false) }}"
    become_user: "{{ bootstrap_become_user | default('') }}"

  - name: set bootstrap facts (II)
    set_fact:
      bootstrap_os_family: "{{ item.value }}"
    with_items:
      - { value: "debian", key: "debian" }
      - { value: "redhat", key: "redhat" }
    when:
      - bootstrap_distribution == "Ubuntu"
      - bootstrap_distribution == "Debian"
      - bootstrap_distribution == "CentOS"
      - bootstrap_distribution == "RedHat"
      - bootstrap_distribution == "Rocky"
      - bootstrap_distribution == "AlmaLinux"
    become: "{{ bootstrap_become | default(false) }}"
    become_user: "{{ bootstrap_become_user | default('') }}"


