---
- name: SSL Certificate Management
  hosts: localhost
  become: true
  vars:
    ssl_dir: /etc/ssl/certs
    ssl_key_name: example.key
    ssl_csr_name: example.csr
    ssl_cert_name: example.crt
    ssl_pkcs12_name: example.p12
    ssl_combined_name: example.combined
    ssl_owner: root
    ssl_group: root
    ssl_common_name: example.com

  tasks:
    - name: Create SSL key
      openssl_private_key:
        path: "{{ ssl_dir }}/{{ ssl_key_name }}"
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: 0600
      register: ssl_key_result

    - name: Create SSL CSR
      openssl_csr:
        path: "{{ ssl_dir }}/{{ ssl_csr_name }}"
        private_key: "{{ ssl_dir }}/{{ ssl_key_name }}"
        common_name: "{{ ssl_common_name }}"
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: 0640
      register: ssl_csr_result

    - name: Create SSL certificates
      openssl_certificate:
        path: "{{ ssl_dir }}/{{ ssl_cert_name }}"
        private_key: "{{ ssl_dir }}/{{ ssl_key_name }}"
        csr: "{{ ssl_dir }}/{{ ssl_csr_name }}"
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: 0640
      register: ssl_cert_result

    - name: Create PKCS#12 file
      openssl_pkcs12:
        path: "{{ ssl_dir }}/{{ ssl_pkcs12_name }}"
        private_key: "{{ ssl_dir }}/{{ ssl_key_name }}"
        certificate: "{{ ssl_dir }}/{{ ssl_cert_name }}"
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: 0600
      register: ssl_pkcs12_result

    - name: Read private key
      slurp:
        src: "{{ ssl_dir }}/{{ ssl_key_name }}"
      register: ssl_key_content

    - name: Read certificate
      slurp:
        src: "{{ ssl_dir }}/{{ ssl_cert_name }}"
      register: ssl_cert_content

    - name: Create combined private_key and certificate file
      copy:
        dest: "{{ ssl_dir }}/{{ ssl_combined_name }}"
        content: "{{ ssl_key_content.content }}\n{{ ssl_cert_content.content }}"
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: 0600


