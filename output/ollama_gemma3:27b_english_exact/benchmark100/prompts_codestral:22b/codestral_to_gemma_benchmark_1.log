---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  ansible.builtin.stat:
    path: "/opt/python3.11/EXTERNALLY-MANAGED"
  register: python311_file

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.file:
    path: "/opt/python3.11/EXTERNALLY-MANAGED"
    state: absent
    name: "/opt/python3.11/EXTERNALLY-MANAGED.old"
  when: python311_file.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  ansible.builtin.stat:
    path: "/opt/python3.12/EXTERNALLY-MANAGED"
  register: python312_file

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.file:
    path: "/opt/python3.12/EXTERNALLY-MANAGED"
    state: absent
    name: "/opt/python3.12/EXTERNALLY-MANAGED.old"
  when: python312_file.stat.exists

- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install python pip
  ansible.builtin.package:
    name: python3-pip
    state: present

- name: Configure pip proxy
  ansible.builtin.pip_config:
    proxy: "{{ python_pip_proxy }}"
  when: python_pip_proxy is defined

- name: Trust hosts
  ansible.builtin.pip_config:
    trusted_host: "{{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined

- name: Update pip
  ansible.builtin.package:
    name: python3-pip
    state: latest
  when: python_pip_update and ansible_distribution != "Debian" and \
        ansible_distribution_release != "bookworm" and \
        ansible_distribution_release != "noble" and \
        ansible_os_family != "Alpine"
  become: true

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  when: ansible_distribution != "Debian" and \
        ansible_distribution_release != "bookworm" and \
        ansible_distribution_release != "noble" and \
        ansible_os_family != "Alpine"


