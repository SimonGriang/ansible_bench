---

  - name: Migrate Java JDK vendor from 'adoptopenjdk' to 'temurin' if selected
    ansible.builtin.set_fact:
      java_vendor: temurin
    when: java_vendor == 'adoptopenjdk'

  - name: Gather OS-specific variables for Java
    ansible.builtin.include_vars:
      file: "os_{{ ansible_os_family }}.yml"
      name: java_os_vars

  - name: Gather architecture-specific variables for Java
    ansible.builtin.include_vars:
      file: "architecture.yml"
      name: java_arch_vars

  - name: Set OS-specific variables for Java (I)
    ansible.builtin.set_fact:
      java_bin_dir: "{{ java_os_vars.java_bin_dir | default('') }}"
      java_lib_dir: "{{ java_os_vars.java_lib_dir | default('') }}"
      java_include_dir: "{{ java_os_vars.java_include_dir | default('') }}"

  - name: Set OS and architecture-specific variables for Java (II)
    ansible.builtin.set_fact:
      java_home: "{{ java_open_jdk_home }}"

  - name: Handle Debian pre-requisites for Java
    ansible.builtin.block:
      - name: Remove deprecated repositories
        ansible.builtin.apt_repository:
          repo: ppa:webupd8/java
          state: absent
        when: ansible_os_family == 'Debian'

      - name: Install extra apt tools
        ansible.builtin.apt:
          name:
            - software-properties-common
          state: present
        when: ansible_os_family == 'Debian'

      - name: Add required key repositories
        ansible.builtin.apt_key:
          url: https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x46181433FBB75451
          state: present
        when: ansible_os_family == 'Debian'

      - name: Add required repositories
        ansible.builtin.apt_repository:
          repo: deb http://ppa.launchpad.net/openjdk-ppa/ppa/ubuntu {{ ansible_distribution_release }} main
          state: present
        when: ansible_os_family == 'Debian'

    when: ansible_os_family == 'Debian'

  - name: Handle RedHat pre-requisites for Java
    ansible.builtin.block:
      - name: Add required key repositories
        ansible.builtin.rpm_key:
          key: https://download.oracle.com/otn-pub/sun-jdk/GPG-KEY-JDK
          state: present
        when: ansible_os_family == 'RedHat'

      - name: Add required repositories
        ansible.builtin.yum_repository:
          name: oracle-java
          description: Oracle Java Repository
          baseurl: https://yum.oracle.com/repo/OracleLinux/OL{{ ansible_distribution_major_version }}/primary/
          gpgcheck: yes
          gpgkey: https://download.oracle.com/otn-pub/sun-jdk/GPG-KEY-JDK
        when: ansible_os_family == 'RedHat'
    when: ansible_os_family == 'RedHat'

  - name: Install required libraries for Java
    ansible.builtin.package:
      name:
        - findbugs
        - junit
      state: present

  - name: Install Java on Debian
    ansible.builtin.apt:
      name: "{{ java_package_name }}"
      state: present
    when: ansible_os_family == 'Debian'

  - name: Install Java on RedHat
    ansible.builtin.yum:
      name: "{{ java_package_name }}"
      state: present
    when: ansible_os_family == 'RedHat'

  - name: Export environment variables for Java
    ansible.builtin.template:
      src: jdk.sh.j2
      dest: /etc/profile.d/jdk.sh
      mode: 0755

  - name: Source environment variables for Java
    ansible.builtin.shell:
      cmd: source /etc/profile.d/jdk.sh
      executable: /bin/bash

  - name: Correct Java version selected for Java < 11
    ansible.builtin.alternatives:
      name: java
      path: "{{ java_home }}/bin/java"
      state: present
    when: java_version < 11

  - name: Correct Java version selected for Java >= 11
    ansible.builtin.alternatives:
      name: java
      path: "{{ java_home }}/bin/java"
      state: present
    when: java_version >= 11


