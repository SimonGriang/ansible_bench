- name: Assert Variables
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for Host
  when:
    - connection != 'container'
    - connection != 'docker'
    - bootstrap_wait_for_host | bool
  ansible.builtin.wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout | default(300) }}"
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(root) }}"

- name: Prepare System
  block:
    - name: Test Connection
      ansible.builtin.ping:
      register: connection_test
      ignore_errors: true

    - name: Note Connection Failure
      ansible.builtin.debug:
        msg: "Connection test failed."
      when: connection_test.failed

    - name: Gather Bootstrap Facts
      ansible.builtin.setup:
      become: "{{ bootstrap_become | default(false) }}"
      become_user: "{{ bootstrap_become_user | default(root) }}"

    - name: Install Bootstrap Packages (Raw)
      ansible.builtin.raw: "{{ bootstrap_packages_raw_command }}"
      register: bootstrap_packages_raw_result
      changed_when: bootstrap_packages_raw_result.rc != 0
      become: "{{ bootstrap_become | default(false) }}"
      become_user: "{{ bootstrap_become_user | default(root) }}"


