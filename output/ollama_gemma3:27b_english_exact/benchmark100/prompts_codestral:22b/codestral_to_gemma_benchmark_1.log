        path: /sys/firmware/efi
      register: efi_path

    - name: password | Remove unwanted grub.cfg on EFI systems
      file:
        path: /boot/efi/EFI/ubuntu/grub.cfg
        state: absent
      when: efi_path.stat.exists

    - name: password | Install user template
      template:
        src: 01_users.j2
        dest: /etc/grub.d/01_users
        mode: 0755

    - name: password | EFI | add password
      lineinfile:
        path: /etc/grub2-efi.cfg
        line: "set password={{ grub_password }}"
        insertafter: EOF
        state: present
      when: efi_path.stat.exists

    - name: password | MBR | add password
      lineinfile:
        path: /etc/grub2.cfg
        line: "set password={{ grub_password }}"
        insertafter: EOF
        state: present
      when: not efi_path.stat.exists

    - name: password | Add --unrestricted
      lineinfile:
        path: "{{ item }}"
        regexp: '^GRUB_CMDLINE_LINUX='
        line: "{{ item | regex_replace('GRUB_CMDLINE_LINUX=', 'GRUB_CMDLINE_LINUX="--unrestricted"') }}"
        state: present
      loop: "{{ grub_password_unrestricted_files }}"
      when: grub_password_unrestricted


