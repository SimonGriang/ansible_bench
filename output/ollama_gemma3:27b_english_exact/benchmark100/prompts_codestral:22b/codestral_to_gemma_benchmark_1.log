---
- name: Ensure unzip package is installed
  apt:
    name: unzip
    state: present
    update_cache: "{{ promtail_apt_update_cache }}"

- name: Create promtail group
  group:
    name: promtail_system_group
    state: present
    system: yes
  when: promtail_system_group != "root"

- name: Create promtail user
  user:
    name: promtail_system_user
    group: promtail_system_group
    additional_groups: "{{ promtail_user_additional_groups }}"
    shell: /usr/sbin/nologin
    system: yes
    createhome: false
  when: promtail_system_user != "root"

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: 0755

- name: Create configuration directories
  file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: promtail_system_group
    mode: 0770
  loop:
    - "{{ promtail_config_dir }}"
    - "{{ promtail_config_file_sd_dir }}"
    - "{{ promtail_positions_directory }}"

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: promtail_system_group
    mode: 0755
  loop:
    - "{{ promtail_install_dir }}"
    - "{{ promtail_install_dir }}/{{ promtail_version }}"

- name: Check promtail binary
  stat:
    path: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail-{{ promtail_go_arch }}"
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_dist_url }}"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_version }}_promtail-{{ promtail_go_arch }}.zip"
    checksum: "{{ promtail_custom_checksum | default(__promtail_checksum) }}"
  when:
    - not promtail_binary.stat.exists
    - promtail_binary_local_dir == ""
    - promtail_binary_propagate == false

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_binary_local_dir }}/{{ promtail_version }}_promtail-{{ promtail_go_arch }}.zip"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_version }}_promtail-{{ promtail_go_arch }}.zip"
  when:
    - not promtail_binary.stat.exists
    - promtail_binary_local_dir != ""
    - promtail_binary_propagate == false

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_dist_url }}"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_version }}_promtail-{{ promtail_go_arch }}.zip"
    checksum: "{{ promtail_custom_checksum | default(__promtail_checksum) }}"
  when: promtail_binary_propagate == true

- name: Propagate promtail binaries
  copy:
    src: "{{ promtail_tmp_dir }}/{{ promtail_version }}_promtail-{{ promtail_go_arch }}.zip"
    dest: "{{ promtail_tmp_dir }}/{{ promtail_version }}_promtail-{{ promtail_go_arch }}.zip"
  when: promtail_binary_propagate == true

- name: Unpack promtail binaries
  unarchive:
    src: "{{ promtail_tmp_dir }}/{{ promtail_version }}_promtail-{{ promtail_go_arch }}.zip"
    dest: "{{ promtail_install_dir }}/{{ promtail_version }}"
    creates: "{{ promtail_install_dir }}/{{ promtail_version }}"
    remote_src: yes
    mode: 0755

- name: Create symlink to latest version
  file:
    src: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail-{{ promtail_go_arch }}"
    dest: /usr/local/bin/promtail
    state: link
    mode: 0755
  notify: Restart promtail

- name: Write config
  template:
    src: config.j2
    dest: "{{ promtail_config_file }}"
    owner: root
    group: promtail_system_group
    mode: 0644
  notify: Restart promtail
  args:
    creates: "{{ promtail_config_file }}"

- name: Create systemd service unit
  template:
    src: "{{ promtail_systemd_service_template_file }}"
    dest: /etc/systemd/system/{{ promtail_systemd_service }}
    mode: 0644
  notify: Restart promtail


