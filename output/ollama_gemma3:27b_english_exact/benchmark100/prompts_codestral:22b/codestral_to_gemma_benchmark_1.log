content='```yaml\n---\n\n  - name: Check if Helm binary exists\n    stat:\n      path: "{{ helm_bin_path }}"\n    register: helm_check\n\n  - name: Check Helm version\n    command: "{{ helm_bin_path }} version"\n    ignore_errors: yes\n    register: helm_existing_version\n    changed_when: false\n\n  - name: Download helm\n    unarchive:\n      remote_src: true\n      src: "{{ helm_repo_path }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"\n      dest: /tmp\n      creates: "{{ helm_bin_path }}"\n    register: helm_download\n    when: helm_check.stat.exists == false or helm_existing_version.stdout != "version.BuildInfo{Version:\\"{{ helm_version }}\\", GitCommit:\\"{{ helm_commit }}\\", GitTreeState:\\"clean\\", BuildDate:\\"{{ helm_build_date }}\\"}"\n\n  - name: Copy helm binary into place\n    copy:\n      src: "/tmp/{{ helm_platform }}-{{ helm_arch }}/helm"\n      dest: "{{ helm_bin_path }}"\n      mode: \'0755\'\n    when: helm_download.changed\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-15T17:36:41.724724951Z', 'done': True, 'done_reason': 'stop', 'total_duration': 18029734998, 'load_duration': 192166956, 'prompt_eval_count': 574, 'prompt_eval_duration': 1833946638, 'eval_count': 291, 'eval_duration': 16002393355, 'model_name': 'gemma3:27b'} id='run--b13b0f0d-07e5-4b40-8bca-e5ecfb95cbf7-0' usage_metadata={'input_tokens': 574, 'output_tokens': 291, 'total_tokens': 865}
