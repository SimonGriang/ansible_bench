      bootstrap_distribution: "{{ item.value }}"
    with_items:
      - { value: "Ubuntu", key: "debian" }
      - { value: "Debian", key: "debian" }
      - { value: "CentOS", key: "redhat" }
      - { value: "RedHat", key: "redhat" }
      - { value: "Rocky", key: "redhat" }
      - { value: "AlmaLinux", key: "redhat" }
