---

  - name: gather_facts | Lookup bootstrap facts
    raw: cat /etc/os-release
    register: bootstrap_facts
    changed_when: false

  - name: gather_facts | Set bootstrap facts (I)
    set_fact:
      bootstrap_distribution: "{{ item.value }}"
      bootstrap_version_major: "{{ item.value | regex_search('VERSION_ID=(\\d+\\.\\d+)') | regex_replace('VERSION_ID=(\\d+\\.\\d+)', '\\1') | split('.')[0] | int }}"
    loop: "{{ bootstrap_os_family_map }}"
    when: bootstrap_facts.rc == 0 and bootstrap_distribution is not defined and bootstrap_facts.stdout | regex_search('^NAME=')

  - name: gather_facts | Set bootstrap facts (II)
    set_fact:
      bootstrap_os_family: "{{ item.key }}"
    loop: "{{ bootstrap_os_family_map }}"
    when: bootstrap_distribution in item.value


