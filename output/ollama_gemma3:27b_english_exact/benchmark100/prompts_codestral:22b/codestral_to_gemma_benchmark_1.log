    become: "{{ bootstrap_become | default(false) }}"
    become_user: "{{ bootstrap_become_user | default('') }}"

  - name: set bootstrap facts (II)
    set_fact:
      bootstrap_os_family: "{{ item.value }}"
    with_items:
      - { value: "debian", key: "debian" }
