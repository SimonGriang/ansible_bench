---
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install dns
    package:
      name:
        - bind9
        - bind9utils
        - dnsutils
      state: present

  - name: Create directories
    file:
      path: "{{ dns_data_dir }}"
      state: directory
      mode: '0750'
      owner: "{{ dns_user }}"
      group: "{{ dns_group }}"
      recurse: yes

  - name: Create group
    group:
      name: "{{ dns_group }}"
      state: present

  - name: Create user
    user:
      name: "{{ dns_user }}"
      group: "{{ dns_group }}"
      system: yes
      createhome: no

  - name: Generate rndc key
    command: rndc-confgen -a -k rndc-key -n default -c /etc/bind/rndc.key
    args:
      creates: /etc/bind/rndc.key

  - name: Set permissions on rndc key file
    file:
      path: /etc/bind/rndc.key
      owner: "{{ dns_user }}"
      group: "{{ dns_group }}"
      mode: '0640'

  - name: Get the hints/root file
    uri:
      url: "{{ hints_root_url }}"
      dest: "{{ dns_data_dir }}/db.root"
      mode: '0644'
    when: caching_dns == true

  - name: Create zone file
    template:
      src: zone.j2
      dest: "{{ dns_data_dir }}/{{ zone }}.db"
      mode: '0644'
      owner: "{{ dns_user }}"
      group: "{{ dns_group }}"
    loop: "{{ primary_zones }}"
    when: primary_zone == true

  - name: Add zones to configuration
    template:
      src: named.conf.j2
      dest: /etc/bind/named.conf.local
      owner: "{{ dns_user }}"
      group: "{{ dns_group }}"
      mode: '0644'

  - name: Place systemd override
    copy:
      src: bind9.service
      dest: /etc/systemd/system/bind9.service.d/override.conf
    when: ansible_service_mgr == 'systemd'

  - name: Start and enable dns
    service:
      name: bind9
      state: started
      enabled: yes


