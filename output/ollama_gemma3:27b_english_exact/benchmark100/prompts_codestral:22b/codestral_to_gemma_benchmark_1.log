content='```yaml\n---\n\n  - name: Create document root directories\n    file:\n      path: "{{ item.documentroot }}"\n      state: directory\n      owner: "{{ item.owner | default(\'root\') }}"\n      group: "{{ item.group | default(\'root\') }}"\n      mode: \'0755\'\n    loop: "{{ httpd_vhosts }}"\n    loop_control:\n      label: "Creating document root: {{ item.documentroot }}"\n    when: item.documentroot is defined\n\n  - name: Configure virtual hosts\n    template:\n      src: vhost.conf.j2\n      dest: "{{ item.vhost_file }}"\n      mode: \'0644\'\n    loop: "{{ httpd_vhosts }}"\n    loop_control:\n      label: "Configuring virtual host: {{ item.server_name }}"\n    notify:\n      - syntax check apache config\n      - restart httpd\n\n  - name: Enable virtual hosts on Debian systems\n    cmd: a2ensite "{{ item.vhost_file }}"\n    creates: /etc/apache2/sites-enabled/{{ item.vhost_file }}\n    when: ansible_os_family == "Debian"\n    loop: "{{ httpd_vhosts }}"\n    loop_control:\n      label: "Enabling virtual host: {{ item.server_name }}"\n    notify:\n      - syntax check apache config\n      - restart httpd\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-15T18:18:18.02243005Z', 'done': True, 'done_reason': 'stop', 'total_duration': 19765090473, 'load_duration': 211845063, 'prompt_eval_count': 585, 'prompt_eval_duration': 1849254901, 'eval_count': 325, 'eval_duration': 17703327694, 'model_name': 'gemma3:27b'} id='run--c6d44d98-bf23-4370-9f2f-a3b28f52664f-0' usage_metadata={'input_tokens': 585, 'output_tokens': 325, 'total_tokens': 910}
