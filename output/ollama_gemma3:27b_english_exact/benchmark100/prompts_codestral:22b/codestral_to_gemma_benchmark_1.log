---

  - name: Import assert.yml
    include_tasks: assert.yml
    delegate_to: localhost

  - name: Install requirements
    pip:
      requirements: "{{ openssl_requirements }}"
    become: true

  - name: Install pip packages
    pip:
      name: "{{ openssl_pip_packages }}"
    become: true

  - name: Create key directory
    file:
      path: "{{ openssl_key_dir }}"
      state: directory
      mode: '0700'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
    become: true

  - name: Create csr directory
    file:
      path: "{{ openssl_csr_dir }}"
      state: directory
      mode: '0755'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
    become: true

  - name: Create crt directory
    file:
      path: "{{ openssl_crt_dir }}"
      state: directory
      mode: '0755'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
    become: true

  - name: Include create.yml
    include_tasks: create.yml
    loop: "{{ openssl_items }}"
    loop_control:
      loop_var: item


