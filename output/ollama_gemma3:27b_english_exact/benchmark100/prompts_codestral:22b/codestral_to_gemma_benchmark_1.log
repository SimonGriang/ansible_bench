---
- name: MySQL Configuration and Initialization
  hosts: all
  become: true
  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml

    - name: Install mysql
      package:
        name: "{{ mysql_packages }}"
        state: present
      notify:
        - set_mysql_root_password
        - reload_mysql

    - name: Configure mysql server
      ini_file:
        path: /etc/mysql/mysql-server.cnf
        section: "{{ item.section }}"
        option: "{{ item.option }}"
        value: "{{ item.value }}"
        state: present
      loop: "{{ mysql_configuration_options }}"
      notify:
        - restart_mysql

    - name: Configure mysql client
      ini_file:
        path: /etc/mysql/mysql-client.cnf
        section: client
        option: socket
        value: "{{ mysql_socket }}"
        state: present

    - name: Initialize mysql
      command: "{{ mysql_initialize_command }}"
      when: ansible_os_family in ["Alpine", "Archlinux"]

    - name: Start and enable mysql
      service:
        name: mysql
        state: started
        enabled: true

    - name: Flush handlers
      meta: flush_handlers

    - name: Place my.cnf
      template:
        src: my.cnf.j2
        dest: /root/.my.cnf
        owner: root
        group: root
        mode: '0644'

    - name: Create databases
      mysql_db:
        name: "{{ item.name }}"
        state: present
        login_user: root
        login_password: "{{ mysql_root_password }}"
      loop: "{{ mysql_databases }}"
      when: mysql_databases is defined and item.initial_import is not defined

    - name: List databases
      mysql_query:
        login_user: root
        login_password: "{{ mysql_root_password }}"
        query: "SHOW DATABASES;"
      register: mysql_info

    - name: Import database
      mysql_db:
        name: "{{ item.name }}"
        state: present
        login_user: root
        login_password: "{{ mysql_root_password }}"
        import_file: "{{ item.import_file }}"
      loop: "{{ mysql_databases }}"
      when: mysql_databases is defined and item.initial_import is defined and item.import_file is defined

    - name: Create users
      mysql_user:
        name: "{{ item.name }}"
        password: "{{ item.password }}"
        priv: "{{ item.priv }}"
        host: "{{ item.host }}"
        login_user: root
        login_password: "{{ mysql_root_password }}"
      loop: "{{ mysql_users }}"
      when: mysql_users is defined

    - name: Flush handlers again
      meta: flush_handlers


