      mode: '0644'
      owner: "{{ dns_user }}"
      group: "{{ dns_group }}"
    loop: "{{ primary_zones }}"
    when: primary_zone == true

  - name: Add zones to configuration
    template:
      src: named.conf.j2
      dest: /etc/bind/named.conf.local
      owner: "{{ dns_user }}"
      group: "{{ dns_group }}"
      mode: '0644'

  - name: Place systemd override
    copy:
      src: bind9.service
      dest: /etc/systemd/system/bind9.service.d/override.conf
    when: ansible_service_mgr == 'systemd'

  - name: Start and enable dns
    service:
      name: bind9
      state: started
      enabled: yes


