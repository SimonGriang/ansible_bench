r }}/{{ ssl_combined_name }}"\n        content: "{{ ssl_key_content.content }}\\n{{ ssl_cert_content.content }}"\n        owner: "{{ ssl_owner }}"\n        group: "{{ ssl_group }}"\n        mode: "0600"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-15T17:57:36.476735518Z', 'done': True, 'done_reason': 'stop', 'total_duration': 46970548847, 'load_duration': 200652575, 'prompt_eval_count': 2356, 'prompt_eval_duration': 7848459993, 'eval_count': 686, 'eval_duration': 38920254579, 'model_name': 'gemma3:27b'} id='run--022f19c8-7864-48e7-af36-01503025ee6e-0' usage_metadata={'input_tokens': 2356, 'output_tokens': 686, 'total_tokens': 3042}
