---

- name: Import assertions
  import_assertions:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"

- name: Configure selinux
  seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
  loop: "{{ httpd_sebooleans }}"

- name: Configure selinux ports
  seport:
    port: "{{ httpd_port }}"
    protocol: tcp
    state: present
  when: httpd_port is defined

- name: Configure selinux ssl ports
  seport:
    port: "{{ httpd_ssl_port }}"
    protocol: tcp
    state: present
  when: httpd_ssl_port is defined

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
  notify:
    - test httpd configuration
    - restart httpd

- name: Activate httpd module | Debian
  command: a2enmod "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == "Debian"
  notify:
    - test httpd configuration

- name: Import ssl configuration
  import_tasks: ssl.yml
  when: httpd_ssl_enabled

- name: Import locations
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual hosts
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_server_root }}/ports.conf"
  when: ansible_os_family in ["Debian", "Suse"]
  notify:
    - test httpd configuration
    - restart httpd

- name: Import directories
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Remove default HTML
  file:
    path: "{{ httpd_data_directory }}"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


