---

- name: Create directories
  file:
    path: "{{ cadvisor_dir }}"
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Download cadvisor binary
  get_url:
    url: "{{ cadvisor_url }}"
    dest: "{{ cadvisor_binary }}"
    mode: '0755'
  when: cadvisor_local_binary is not defined or not cadvisor_local_binary
  register: download_result
  until: download_result is succeeded
  retries: 3
  delay: 5

- name: Propagate locally distributed cadvisor binary
  copy:
    src: "{{ cadvisor_local_binary }}"
    dest: "{{ cadvisor_binary }}"
    mode: '0755'
    owner: root
    group: root
  when: cadvisor_local_binary is defined
  notify:
    - restart cadvisor

- name: Create a symlink
  file:
    src: "{{ cadvisor_binary }}"
    dest: "{{ cadvisor_symlink }}"
    state: link
    force: yes

- name: Configure cadvisor systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
  notify:
    - restart cadvisor

- name: Check cadvisor service status
  shell: systemctl status cadvisor
  register: cadvisor_status
  ignore_errors: true

- name: Enable cadvisor systemd service
  systemd:
    name: cadvisor
    enabled: yes

- name: Start cadvisor systemd service
  systemd:
    name: cadvisor
    state: started
  register: start_result
  until: start_result.status.ActiveState == 'active'
  retries: 3
  delay: 5


