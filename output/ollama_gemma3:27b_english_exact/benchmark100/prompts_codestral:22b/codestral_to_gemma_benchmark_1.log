---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install required packages
  ansible.builtin.package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure selinux
  block:
    - name: Manage SELinux state and policy
      ansible.posix.selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      when: selinux_state is defined
      notify: Reboot system
    - name: Manage SELinux booleans
      ansible.builtin.set_fact:
        selinux_booleans_list: "{{ selinux_booleans | default([]) }}"
      when: selinux_booleans is defined
    - name: Set SELinux booleans
      ansible.builtin.selinux_boolean:
        name: "{{ item.name }}"
        state: "{{ item.state | default('true') }}"
        persistent: "{{ item.persistent | default(true) }}"
      loop: "{{ selinux_booleans_list }}"
      when: selinux_booleans is defined
  when:
    - selinux_state is defined
    - ansible_connection != 'container'
    - ansible_connection != 'docker'
    - ansible_connection != 'community.docker.docker'


