- name: Remove externally managed
  import_tasks: debian_12_tasks.yml
  when: ansible_distribution == "Debian" and ansible_distribution_version == "12"

- name: Ensure Pip is installed
  apt:
    name: "{{ pip_package }}"
    state: present
  become: true

- name: Ensure packaging is available
  apt:
    name: python3-packaging
    state: present
  become: true

- name: Ensure pip_install_packages are installed
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default(omit) }}"
    virtualenv: "{{ item.virtualenv | default(omit) }}"
    state: present
    extra_args: "{{ item.extra_args | default(omit) }}"
    executable: "{{ item.virtualenv | default(pip_executable) }}"
  loop: "{{ pip_install_packages }}"
  become: true


