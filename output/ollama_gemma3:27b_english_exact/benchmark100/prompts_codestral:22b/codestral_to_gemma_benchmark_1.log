    chdir: /etc/openvpn/easy-rsa
    environment:
      EASYRSA_BATCH: "yes"
  when: not ansible_file.stat.exists('/etc/openvpn/easy-rsa/pki/issued/server.crt')

- name: Build client certificates
  ansible.builtin.command:
    cmd: "{{ openvpn_easyrsa_path }} build-client-full client nopass"
    chdir: /etc/openvpn/easy-rsa
    environment:
      EASYRSA_BATCH: "yes"
  when: not ansible_file.stat.exists('/etc/openvpn/easy-rsa/pki/issued/client.crt')

- name: Generate Certificate Revocation List
  ansible.builtin.command:
    cmd: "{{ openvpn_easyrsa_path }} gen-crl"
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_file.stat.exists('/etc/openvpn/easy-rsa/pki/crl.pem')

- name: Generate TLS Auth Key
  ansible.builtin.command:
