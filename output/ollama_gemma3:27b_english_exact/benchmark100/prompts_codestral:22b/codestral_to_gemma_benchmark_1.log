---
- name: Create a local SSH key directory for a specific user if manage_ssh_key is defined and set to true.
  ansible.builtin.file:
    path: "{{ users_ssh_key_directory }}"
    state: directory
    mode: 0750
  when: manage_ssh_key is defined and manage_ssh_key

- name: Manage a user account based on the provided details.
  ansible.builtin.user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment | default('') }}"
    create_home: "{{ user.create_home | default(true) }}"
    password: "{{ user.password | default('') }}"
    uid: "{{ user.uid | default(null) }}"
    group: "{{ user.group | default(null) }}"
    groups: "{{ user.groups | default([]) }}"
    home: "{{ user.home | default(null) }}"
    shell: "{{ user.shell | default('/bin/bash') }}"
    update_password: "{{ user.update_password | default(on_create) }}"
    expires: "{{ user.expires | default(null) }}"
    system: "{{ user.system | default(false) }}"

- name: Set sudo options for a specific user if sudo_options are defined.
  ansible.builtin.template:
    src: sudo.j2
    dest: /etc/sudoers.d/{{ user.name }}
    mode: 0640
    validate: /usr/sbin/visudo --check --file %s
  when: sudo_options is defined

- name: Remove sudo options for a specific user if sudo_options are not defined.
  ansible.builtin.file:
    path: /etc/sudoers.d/{{ user.name }}
    state: absent
  when: not sudo_options is defined

- name: Generate a private SSH key for a specific user if manage_ssh_key is defined and set to true.
  ansible.builtin.command: "{{ users_ssh_keygen_command }}"
  args:
    chdir: "{{ users_ssh_key_directory }}"
  when: manage_ssh_key is defined and manage_ssh_key

- name: Generate a public SSH key for a specific user if manage_ssh_key is defined and set to true.
  ansible.builtin.shell: "{{ users_ssh_keygen_pubkey_command }}"
  args:
    chdir: "{{ users_ssh_key_directory }}"
  when: manage_ssh_key is defined and manage_ssh_key

- name: Convert the private SSH key to a ppk format for a specific user if manage_ssh_key is defined and set to true.
  ansible.builtin.shell: 'ssh-keygen -e -f "{{ users_ssh_key_directory }}/{{ user.name }}" -C "Generated by Ansible role robertdebock.users"'
  args:
    chdir: "{{ users_ssh_key_directory }}"
  when: manage_ssh_key is defined and manage_ssh_key

- name: Get or set the home directory for a specific user.
  ansible.builtin.getent:
    database: passwd
    key: "{{ user.name }}"
    output: home
  register: user_home
  when: user_home is not defined

- name: Create a .ssh directory for a specific user if manage_ssh_key is defined and set to true or if private_keys are defined.
  ansible.builtin.file:
    path: "{{ user.home }}/.ssh"
    state: directory
    mode: 0700
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  become: true
  when: manage_ssh_key is defined and manage_ssh_key or private_keys is defined

- name: Deploy authorized keys for a specific user if authorized_keys are defined.
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ authorized_keys }}"
  when: authorized_keys is defined

- name: Remove unauthorized keys for a specific user if unauthorized_keys are defined.
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ unauthorized_keys }}"
  when: unauthorized_keys is defined

- name: Copy a generated private SSH key for a specific user to their .ssh directory if copy_private_key is defined and set to true.
  ansible.builtin.copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}"
    dest: "{{ user.home }}/.ssh/id_rsa"
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
    mode: 0400
  when: copy_private_key is defined and copy_private_key

- name: Check the password valid time for a specific user.
  ansible.builtin.command: 'awk '\''BEGIN { FS = ":" } $1 == "{{ user.name }}" { print $5 }'\'' /etc/shadow'
  register: password_valid_time
  changed_when: false

- name: Set the password valid time for a specific user if password_validity_days is defined and the current password valid time does not match the desired password valid time.
  ansible.builtin.command: 'chage -M "{{ user.password_validity_days }}" "{{ user.name }}"'
  when: password_validity_days is defined and password_valid_time.stdout != password_validity_days

- name: Place a private key file for a specific user in their .ssh directory if private_keys are defined.
  ansible.builtin.copy:
    dest: "{{ user.home }}/.ssh/id_rsa"
    content: "{{ item.content }}"
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
    mode: 0400
  loop: "{{ private_keys }}"
  when: private_keys is defined


