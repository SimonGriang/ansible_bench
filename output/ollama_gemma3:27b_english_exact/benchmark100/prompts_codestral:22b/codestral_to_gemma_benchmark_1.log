---
- name: Create a local SSH key directory for a specific user if manage_ssh_key is defined and set to true.
  ansible.builtin.file:
    path: "{{ users_ssh_key_directory }}"
    state: directory
    mode: 0750
  when: manage_ssh_key is defined and manage_ssh_key

- name: Manage a user account based on the provided details.
  ansible.builtin.user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment | default('') }}"
    create_home: "{{ user.create_home | default(true) }}"
    password: "{{ user.password | default('') }}"
    uid: "{{ user.uid | default(null) }}"
    group: "{{ user.group | default(null) }}"
    groups: "{{ user.groups | default([]) }}"
    home: "{{ user.home | default(null) }}"
    shell: "{{ user.shell | default('/bin/bash') }}"
    update_password: "{{ user.update_password | default(on_create) }}"
    expires: "{{ user.expires | default(null) }}"
    system: "{{ user.system | default(false) }}"

- name: Set sudo options for a specific user if sudo_options are defined.
  ansible.builtin.template:
    src: sudo.j2
    dest: /etc/sudoers.d/{{ user.name }}
    mode: 0640
    validate: /usr/sbin/visudo --check --file %s
  when: sudo_options is defined

- name: Remove sudo options for a specific user if sudo_options are not defined.
  ansible.builtin.file:
    path: /etc/sudoers.d/{{ user.name }}
    state: absent
  when: not sudo_options is defined

- name: Generate a private SSH key for a specific user if manage_ssh_key is defined and set to true.
  ansible.builtin.command: "{{ users_ssh_keygen_command }}"
  args:
    chdir: "{{ users_ssh_key_directory }}"
  when: manage_ssh_key is defined and manage_ssh_key

- name: Generate a public SSH key for a specific user if manage_ssh_key is defined and set to true.
  ansible.builtin.shell: "{{ users_ssh_keygen_pubkey_command }}"
  args:
    chdir: "{{ users_ssh_key_directory }}"
  when: manage_ssh_key is defined and manage_ssh_key

