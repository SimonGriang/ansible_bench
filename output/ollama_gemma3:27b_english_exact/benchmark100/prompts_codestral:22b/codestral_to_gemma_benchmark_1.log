content="```yaml\n---\n- name: Disable swap\n  command: swapoff -a\n  when: vault_hardening_disable_swap\n  ignore_errors: yes\n\n- name: Remove swap entry from fstab\n  mount:\n    path: swap\n    state: absent\n  when: vault_hardening_disable_swap\n\n- name: Disable core dumps\n  pam_limits:\n    domain: '*'\n    limit_type: soft\n    limit_item: core\n    limit_value: 0\n  when: vault_hardening_disable_core_dumps\n\n- name: Disable core dumps\n  pam_limits:\n    domain: '*'\n    limit_type: hard\n    limit_item: core\n    limit_value: 0\n  when: vault_hardening_disable_core_dumps\n\n- name: Disable Shell Command History\n  copy:\n    src: disable_history.sh\n    dest: /etc/profile.d/disable_history.sh\n    mode: 0755\n  when: vault_hardening_disable_shell_command_history\n\n- name: Configure SELinux / AppArmor\n  block:\n    - name: Check if SELinux is enabled\n      command: sestatus\n      register: selinux_status\n      ignore_errors: yes\n\n    - name: Install selinux-policy and set policy to targeted enforcing\n      package:\n        name: selinux-policy\n        state: present\n      when: selinux_status.rc == 0\n\n    - name: Set SELinux policy to targeted enforcing\n      command: setenforce 1\n      when: selinux_status.rc == 0\n\n    - name: Check if AppArmor is enabled\n      command: apparmor_status\n      register: apparmor_status\n      ignore_errors: yes\n\n    - name: Enable AppArmor profile for vault\n      command: apparmor_parser -r /etc/apparmor.d/usr.sbin.vault\n      when: apparmor_status.rc == 0\n  when: vault_hardening_configure_selinux_apparmor\n```" additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-15T16:34:22.326237434Z', 'done': True, 'done_reason': 'stop', 'total_duration': 28065109026, 'load_duration': 190208626, 'prompt_eval_count': 565, 'prompt_eval_duration': 1922210400, 'eval_count': 472, 'eval_duration': 25951701543, 'model_name': 'gemma3:27b'} id='run--8a39136e-9ecb-48ce-8802-b5a3c6609028-0'