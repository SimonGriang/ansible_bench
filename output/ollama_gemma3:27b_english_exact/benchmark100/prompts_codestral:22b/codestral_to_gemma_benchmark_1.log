content='```yaml\n---\n- name: Assert usage of systemd as an init system\n  assert:\n    that: ansible_service_mgr == "systemd"\n    msg: "This module only works with systemd"\n\n- name: Get the latest release version of Promtail from GitHub\n  uri:\n    url: "https://api.github.com/repos/grafana/loki/releases/latest"\n    user: "{{ lookup(env, \'GH_USER\') }}"\n    password: "{{ lookup(env, \'GH_TOKEN\') }}"\n    return_content: yes\n  register: github_release\n  delegate_to: localhost\n  run_once: true\n  vars:\n    release_version: "{{ github_release.json.tag_name }}"\n\n- name: Check if the local Promtail binary archive exists\n  stat:\n    path: "{{ promtail_binary_local_dir }}/promtail-{{ release_version }}-{{ go_arch }}.tar.gz"\n  register: promtail_binary\n  delegate_to: localhost\n  run_once: true\n  when: promtail_binary_local_dir is defined\n  failed_when: not promtail_binary.stat.exists\n  vars:\n    release_version: "{{ github_release.json.tag_name }}"\n  msg: "When using \'promtail_binary_local_dir\' please ensure that the binary exists"\n\n- name: Get the checksum for the Promtail binary\n  stat:\n    path: "{{ promtail_binary_local_dir }}/promtail-{{ release_version }}-{{ go_arch }}.tar.gz"\n  register: promtail_checksum_file\n  delegate_to: localhost\n  run_once: true\n  when: promtail_binary_local_dir is defined\n  vars:\n    release_version: "{{ github_release.json.tag_name }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-15T18:02:29.377790823Z', 'done': True, 'done_reason': 'stop', 'total_duration': 25762625140, 'load_duration': 198233594, 'prompt_eval_count': 567, 'prompt_eval_duration': 1984089232, 'eval_count': 427, 'eval_duration': 23578614742, 'model_name': 'gemma3:27b'} id='run--742378b0-b9bb-479f-aaf8-78ad3086c512-0' usage_metadata={'input_tokens': 567, 'output_tokens': 427, 'total_tokens': 994}
