---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Initialize easy-rsa
  ansible.builtin.command:
    cmd: "{{ openvpn_easyrsa_path }} init-pki"
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_file.stat.exists('/etc/openvpn/easy-rsa/pki')

- name: Build CA
  ansible.builtin.command:
    cmd: "{{ openvpn_easyrsa_path }} build-ca nopass"
    chdir: /etc/openvpn/easy-rsa
    environment:
      EASYRSA_BATCH: "yes"
  when: not ansible_file.stat.exists('/etc/openvpn/easy-rsa/pki/ca.crt')

- name: Generate Diffie-Hellman parameters
  ansible.builtin.command:
    cmd: "{{ openvpn_easyrsa_path }} gen-dh"
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_file.stat.exists('/etc/openvpn/easy-rsa/pki/dh.pem')

- name: Build server certificates
  ansible.builtin.command:
    cmd: "{{ openvpn_easyrsa_path }} build-server-full server nopass"
    chdir: /etc/openvpn/easy-rsa
    environment:
      EASYRSA_BATCH: "yes"
  when: not ansible_file.stat.exists('/etc/openvpn/easy-rsa/pki/issued/server.crt')

- name: Build client certificates
  ansible.builtin.command:
    cmd: "{{ openvpn_easyrsa_path }} build-client-full client nopass"
    chdir: /etc/openvpn/easy-rsa
    environment:
      EASYRSA_BATCH: "yes"
  when: not ansible_file.stat.exists('/etc/openvpn/easy-rsa/pki/issued/client.crt')

- name: Generate Certificate Revocation List
  ansible.builtin.command:
    cmd: "{{ openvpn_easyrsa_path }} gen-crl"
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_file.stat.exists('/etc/openvpn/easy-rsa/pki/crl.pem')

- name: Generate TLS Auth Key
  ansible.builtin.command:
    cmd: "openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key"
  when: not ansible_file.stat.exists('/etc/openvpn/easy-rsa/pki/ta.key')

- name: Copy files to /etc/openvpn/server
  ansible.builtin.copy:
    src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
    dest: "/etc/openvpn/server/{{ item }}"
    owner: root
    group: "{{ openvpn_group }}"
    mode: '0644'
  loop:
    - ca.crt
    - dh.pem
    - crl.pem
    - ta.key

- name: Copy files to /etc/openvpn
  ansible.builtin.copy:
    src: "/etc/openvpn/easy-rsa/pki/{{ item }}"
    dest: "/etc/openvpn/{{ item }}"
    owner: root
    group: "{{ openvpn_group }}"
    mode: '0644'
  loop:
    - ca.crt
    - crl.pem

- name: Place server.conf
  ansible.builtin.template:
    src: server.conf.j2
    dest: "{{ openvpn_configuration_directory }}/server.conf"
    owner: root
    group: "{{ openvpn_group }}"
    mode: '0640'
  notify: Restart openvpn


