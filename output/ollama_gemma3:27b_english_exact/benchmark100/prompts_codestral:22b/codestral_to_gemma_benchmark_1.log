---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  when: ansible_pkg_mgr == "apk"
  apk:
    update_cache: yes
    upgrade: yes
  notify: Reboot

- name: Configure apt
  when: ansible_pkg_mgr == "apt"
  apt:
    update_cache:
      apt_cache_valid_time: "{{ update_cache_valid_time }}"
    upgrade: "{{ update_upgrade_command }}"
    autoremove: "{{ update_autoremove }}"
  notify: Reboot

- name: Update all software (dnf)
  when: ansible_pkg_mgr in ["dnf", "dnf5"]
  dnf:
    name: "*"
    exclude: "{{ update_excluded_packages }}"
    state: latest
  notify: Reboot

- name: Update all software (pacman)
  when: ansible_pkg_mgr == "pacman"
  pacman:
    update_cache: yes
    upgrade: yes
  notify: Reboot

- name: Configure yum
  when: ansible_pkg_mgr == "yum"
  block:
    - name: Install yum-utils
      yum:
        name: yum-utils
        state: present
      when: ansible_distribution_major_version != "6"
    - name: Update all software (yum)
      yum:
        name: "*"
        exclude: "{{ update_excluded_packages }}"
        state: latest
  notify: Reboot

- name: Update all software (zypper)
  when: ansible_pkg_mgr == "zypper"
  zypper:
    name: "*"
    state: latest
  notify: Reboot


