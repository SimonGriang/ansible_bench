:30.697981106Z', 'done': True, 'done_reason': 'stop', 'total_duration': 35279123092, 'load_duration': 189001699, 'prompt_eval_count': 650, 'prompt_eval_duration': 2256375239, 'eval_count': 593, 'eval_duration': 32832827039, 'model_name': 'gemma3:27b'} id='run--5b251ace-b8aa-4619-b960-a8fcf877fa32-0' usage_metadata={'input_tokens': 650, 'output_tokens': 593, 'total_tokens': 1243}
