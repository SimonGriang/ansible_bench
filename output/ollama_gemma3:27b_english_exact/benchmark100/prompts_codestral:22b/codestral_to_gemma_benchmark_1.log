---
- name: create | Create ssl key
  openssl_privatekey:
    path: /etc/ssl/private/example.key
    mode: 0600
    owner: root
    group: root

- name: create | Create ssl csr
  openssl_csr:
    path: /etc/ssl/private/example.csr
    private_key: /etc/ssl/private/example.key
    mode: 0600
    owner: root
    group: root

- name: create | Create ssl certificates
  x509_certificate:
    path: /etc/ssl/private/example.crt
    private_key: /etc/ssl/private/example.key
    csr: /etc/ssl/private/example.csr
    mode: 0600
    owner: root
    group: root

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    path: /etc/ssl/private/example.p12
    private_key: /etc/ssl/private/example.key
    certificate: /etc/ssl/private/example.crt
    mode: 0600
    owner: root
    group: root

- name: create | Read private key
  slurp:
    src: /etc/ssl/private/example.key
  register: private_key_content

- name: create | Read certificate
  slurp:
    src: /etc/ssl/private/example.crt
  register: certificate_content

- name: create | Create combined private_key and certificate file
  copy:
    dest: /etc/ssl/private/example.pem
    content: "{{ private_key_content.content }}\n{{ certificate_content.content }}"
    mode: 0600
    owner: root
    group: root


