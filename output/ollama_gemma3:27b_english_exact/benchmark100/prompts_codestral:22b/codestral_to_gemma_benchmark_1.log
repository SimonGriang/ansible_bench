---
- name: Bootstrap Playbook
  hosts: all
  become: false
  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml

    - name: Wait for port to be available
      wait_for:
        port: 22
        timeout: "{{ bootstrap_timeout }}"
        state: started

    - name: Prepare system
      block:
        - name: Test connection
          ping:
          ignore_errors: true

        - name: Check sudo availability
          command: "sudo -n true"
          register: sudo_check
          ignore_errors: true
          changed_when: false
          failed_when: sudo_check.rc != 0 and sudo_check.rc != 1

        - name: Gather bootstrap facts and install packages
          block:
            - name: Gather bootstrap facts
              setup:
              delegate_to: localhost

            - name: Install bootstrap packages
              raw: "{{ item }}"
              with_items:
                - yum
                - dnf
                - apt
              become: true
              when: sudo_check.rc != 0
          when: sudo_check.rc != 0

        - name: Ensure libdnf5 is present
          package:
            name: libdnf5
            state: present
          when: ansible_facts['os_family'] == "RedHat" or ansible_facts['distribution'] == "Fedora"
      rescue:
        - name: Handle preparation failures
          debug:
            msg: "System preparation failed. Check logs for details."

    - name: Gather ansible facts
      setup:

    - name: Install bootstrap packages (package)
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      become: "{{ bootstrap_become }}"


