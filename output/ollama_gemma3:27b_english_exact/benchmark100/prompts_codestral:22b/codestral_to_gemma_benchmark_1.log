---
- name: Vault Deployment
  hosts: all
  become: true
  vars:
    vault_download_path: /opt/vault_download
    vault_path: /opt/vault
    vault_data_directory: "{{ vault_path }}/data"
    vault_directories:
      - name: config
        owner: vault_user
        group: vault_group
        mode: '0755'
    vault_data_directories:
      - name: file
        owner: vault_user
        group: vault_group
        mode: '0755'
    vault_tls_files:
      - path: "{{ vault_data_directory }}/tls/vault.key"
        owner: vault_user
        group: vault_group
        mode: '0600'
      - path: "{{ vault_data_directory }}/tls/vault.crt"
        owner: vault_user
        group: vault_group
        mode: '0644'

  tasks:
    - name: Create Vault group
      ansible.builtin.group:
        name: vault_group
        state: present

    - name: Create Vault user
      ansible.builtin.user:
        name: vault_user
        group: vault_group
        createhome: false
        state: present

    - name: Create Vault download directory
      ansible.builtin.file:
        path: "{{ vault_download_path }}"
        state: directory
        owner: vault_user
        group: vault_group
        mode: '0755'

    - name: Download Vault binary
      ansible.builtin.unarchive:
        src: https://releases.hashicorp.com/vault/1.15.7/vault_1.15.7_linux_amd64.zip
        dest: "{{ vault_download_path }}"
        remote_src: yes
        creates: "{{ vault_download_path }}/vault"
        owner: root
        group: root
        mode: '0755'

    - name: Check if vault_path exists
      ansible.builtin.stat:
        path: "{{ vault_path }}"
      register: vault_path_stat

    - name: Create vault_path if it does not exist
      ansible.builtin.file:
        path: "{{ vault_path }}"
        state: directory
        owner: vault_user
        group: vault_group
        mode: '0755'
      when: not vault_path_stat.stat.exists and vault_path|length > 0

    - name: Create directories in vault_path
      ansible.builtin.file:
        path: "{{ vault_path }}/{{ item.name }}"
        state: directory
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_directories }}"

    - name: Create data directories
      ansible.builtin.file:
        path: "{{ vault_path }}/{{ item.name }}"
        state: directory
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_data_directories }}"

    - name: Generate TLS key and certificate
      ansible.builtin.command:
        cmd: "openssl req -new -x509 -keyout {{ vault_data_directory }}/tls/vault.key -out {{ vault_data_directory }}/tls/vault.crt -days 365 -subj '/CN=vault.example.com'"
      args:
        creates: "{{ vault_data_directory }}/tls/vault.crt"
      notify: Restart vault

    - name: Set ownership of tls material
      ansible.builtin.file:
        path: "{{ item.path }}"
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_tls_files }}"

    - name: Copy Vault binary
      ansible.builtin.copy:
        src: "{{ vault_download_path }}/vault"
        dest: "{{ vault_path }}/usr/bin/vault"
        remote_src: yes
        owner: root
        group: root
        mode: '0755'
      notify: Restart vault

    - name: Set capabilities on /usr/bin/vault
      community.general.capabilities:
        path: /usr/bin/vault
        capabilities:
          - cap_ipc_lock=ep

    - name: Touch vault.env
      ansible.builtin.file:
        path: "{{ vault_path }}/etc/vault.d/vault.env"
        state: touch
        owner: vault_user
        group: vault_group
        mode: '0644'
      notify: Restart vault

    - name: Create /usr/lib/systemd/system
      ansible.builtin.file:
        path: /usr/lib/systemd/system
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Copy Vault service file
      ansible.builtin.copy:
        src: vault.service.j2
        dest: /usr/lib/systemd/system/vault.service
        owner: root
        group: root
        mode: '0644'
      notify: Daemon reload

    - name: Copy vault configuration
      ansible.builtin.copy:
        src: vault.hcl
        dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
        owner: vault_user
        group: vault_group
        mode: '0644'
      notify: Restart vault

    - name: Flush handlers
      ansible.builtin.meta:
        flush_handlers: true


