  tasks:
    - name: Restart RKE2 service on a specified node
      ansible.builtin.service:
        name: "{{ rke2_service_name }}"
        state: restarted
      notify: Service (re)started

    - name: Wait for all nodes to be ready
      ansible.builtin.shell:
        cmd: "{{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes | grep \" Ready\" | wc -l"
        register: kubectl_node_status
      loop: "{{ rke2_cluster_group_name }}"
      delegate_to: "{{ item }}"
      run_once: true
      until: kubectl_node_status.stdout == "{{ rke2_cluster_group_name | length }}"
      check_mode: false
      become: true

