---
- name: Configure MySQL Server
  hosts: all
  become: true
  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml
      once: true

    - name: Install mysql
      package:
        name: "{{ mysql_packages }}"
        state: present
      notify:
        - Set root password
        - Systemctl daemon-reexec

    - name: Configure mysql server
      copy:
        dest: "{{ mysql_configuration_destination }}/mysql-server.cnf"
        content: "{{ mysql_configuration_options }}"
      notify:
        - Restart mysql server

    - name: Configure mysql client
      copy:
        dest: "{{ mysql_configuration_destination }}/mysql-client.cnf"
        content: "
[client]
socket = {{ mysql_socket }}
"

    - name: Initialize mysql
      command: "{{ mysql_initialize_command }}"
      when: ansible_distribution in ["Alpine", "Archlinux"]

    - name: Start and enable mysql
      service:
        name: "{{ mysql_service }}"
        state: started
        enabled: true

    - name: Flush handlers
      meta: flush_handlers

    - name: Place my.cnf
      template:
        src: my.cnf.j2
        dest: /etc/my.cnf
        mode: '0640'

    - name: Create databases
      mysql_db:
        name: "{{ item }}"
        state: present
        login_user: root
        login_password: "{{ mysql_root_password }}"
        socket: "{{ mysql_socket }}"
      loop: "{{ mysql_databases | default([]) }}"
      when: mysql_databases is defined

    - name: Create users
      mysql_user:
        name: "{{ item.name }}"
        password: "{{ item.password }}"
        priv: "{{ item.priv }}"
        state: present
        login_user: root
        login_password: "{{ mysql_root_password }}"
        socket: "{{ mysql_socket }}"
      loop: "{{ mysql_users | default([]) }}"
      when: mysql_users is defined

    - name: Flush handlers again
      meta: flush_handlers


