        validate_certs: false
    - name: Download artifacts
      ansible.builtin.get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_dir }}"
        validate_certs: false
    - name: Checksum verification
      ansible.builtin.command: sha256sum {{ rke2_checksum_file_dest }}
      register: checksum_result
    - name: Compare checksums
      ansible.builtin.fail:
        msg: "Checksum mismatch detected!"
      when: checksum_result.stdout != rke2_expected_checksum
    - name: Download RKE2 install script from URL on checksum failure
      ansible.builtin.get_url:
        url: "{{ rke2_install_url }}"
        dest: "{{ rke2_install_script_dest }}"
      when: checksum_result.stdout != rke2_expected_checksum
      ignore_errors: true
    - name: Locally download checksum file and artifacts on remote download failure
      block:
        - name: Local checksum file
          ansible.builtin.copy:
            src: "{{ rke2_checksum_file_local_src }}"
            dest: "{{ rke2_checksum_file_dest }}"
        - name: Local artifacts
          ansible.builtin.copy:
            src: "{{ rke2_artifacts_local_src }}"
            dest: "{{ rke2_artifacts_dir }}"
      when: checksum_result.stdout != rke2_expected_checksum
  when: rke2_airgap_mode == true and rke2_airgap_implementation == 'download'

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "{{ rke2_artifacts_local_src }}"
    dest: "{{ rke2_artifacts_dir }}"
  when: rke2_airgap_mode == true and rke2_airgap_implementation == 'copy'

- name: Copy additional images tarballs
  block:
    - name: Create additional images directory
      ansible.builtin.file:
        path: "{{ rke2_additional_images_dir }}"
        state: directory
        mode: '0755'
    - name: Copy additional tarballs
      ansible.builtin.copy:
        src: "{{ rke2_additional_images_local_src }}"
        dest: "{{ rke2_additional_images_dir }}"
  when: rke2_airgap_mode == true and rke2_additional_images | length > 0 and rke2_airgap_implementation != 'exists'

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Check artifact permissions
      ansible.builtin.stat:
        path: "{{ rke2_artifacts_dir }}"
        get_checksum: true
      register: artifact_stat
    - name: Change artifact permissions to read-only
      ansible.builtin.file:
        path: "{{ rke2_artifacts_dir }}"
        mode: '0555'
      when: artifact_stat.stat.mode & 0o222 != 0
    - name: Make install script executable
      ansible.builtin.file:
        path: "{{ rke2_install_script_dest }}"
        mode: '0755'
      when: artifact_stat.stat.mode & 0o111 == 0
    - name: Fail if install script does not exist or is not executable
      ansible.builtin.fail:
        msg: "Install script does not exist or is not executable!"
      when: artifact_stat.stat.exists == false or artifact_stat.stat.mode & 0o111 == 0
  when: rke2_airgap_mode == true and rke2_airgap_implementation == 'exists'

- name: Set RKE2 bin path
  block:
    - name: Populate service facts
      ansible.builtin.setup:
        filter: ansible_facts.service_facts
    - name: Get stats of the filesystem object
      ansible.builtin.stat:
        path: /var/lib/rancher/rke2/bin
      register: rke2_bin_stat
    - name: Check if separate partition
      ansible.builtin.set_fact:
        rke2_separate_partition: "{{ rke2_bin_stat.stat.exists }}"
    - name: Set RKE2 bin path
      ansible.builtin.set_fact:
        rke2_bin_path: "/var/lib/rancher/rke2/bin"
  delegate_to: localhost

- name: Check RKE2 version
  block:
    - name: Check if RKE2 binary exists
      ansible.builtin.stat:
        path: "{{ rke2_bin_path }}/rke2"
      register: rke2_binary_stat
    - name: Check RKE2 version
      ansible.builtin.command: "{{ rke2_bin_path }}/rke2 --version"
      register: rke2_version_output
      ignore_errors: true
      changed_when: false
    - name: Set installed version
      ansible.builtin.set_fact:
        installed_rke2_version: "{{ rke2_version_output.stdout | regex_search('rke2 version (.*)', '\\1') | default('not installed') }}"
    - name: Check running RKE2 service
      ansible.builtin.command: systemctl is-active rke2
      register: rke2_service_status
      ignore_errors: true
      changed_when: false
    - name: Check running RKE2 binary if service is active
      ansible.builtin.command: "{{ rke2_bin_path }}/rke2 --version"
      register: rke2_running_version_output
      ignore_errors: true
      changed_when: false
      when: rke2_service_status.stdout == 'active'
    - name: Set running version
      ansible.builtin.set_fact:
        running_rke2_version: "{{ rke2_running_version_output.stdout | regex_search('rke2 version (.*)', '\\1') | default(desired_rke2_version) }}"
  delegate_to: localhost

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.fail:
    msg: "Downgrade of RKE2 is not allowed!"
  when: desired_rke2_version | version_compare(running_rke2_version, '<') and allow_downgrades == false

- name: Run RKE2 install script
  block:
    - name: Run RKE2 install script with airgap variables
      ansible.builtin.command: "{{ rke2_install_script_dest }} --airgap"
      environment:
        RKE2_AIRGAP: "true"
        RKE2_ARTIFACTS_DIR: "{{ rke2_artifacts_dir }}"
    - name: Run RKE2 install script without airgap variables
      ansible.builtin.command: "{{ rke2_install_script_dest }}"
  when: installed_rke2_version == 'not installed' or installed_rke2_version != desired_rke2_version

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: "{{ custom_manifests_src }}"
    dest: "{{ custom_manifests_dest }}"
  when: custom_manifests_src is defined and custom_manifests_src != ''

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ static_pods_src }}"
    dest: "{{ static_pods_dest }}"
  when: static_pods_src is defined and static_pods_src != ''

- name: Copy RKE2 environment file
  ansible.builtin.copy:
    src: "{{ rke2_env_file_src }}"
    dest: "{{ rke2_env_file_dest }}"
  when: rke2_env_file_src is defined and rke2_env_file_src != ''


