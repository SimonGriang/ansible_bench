---
- name: RKE2 Configuration and Setup
  hosts: all
  become: true
  vars:
    rke2_server_node_taints: ""
  tasks:
    - name: Create the RKE2 config directory
      ansible.builtin.file:
        path: /etc/rancher/rke2
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Set server taints
      ansible.builtin.set_fact:
        combined_node_taints: "{{ rke2_server_node_taints }}"
      when: rke2_type == 'server'

    - name: Copy rke2 config
      ansible.builtin.copy:
        src: "{{ rke2_config }}"
        dest: /etc/rancher/rke2/config.yaml
        owner: root
        group: root
        mode: '0600'
      notify: Config file changed

    - name: Copy kubelet config
      ansible.builtin.copy:
        src: templates/kubelet-config.yaml.j2
        dest: /etc/rancher/rke2/kubelet-config.yaml
        owner: root
        group: root
        mode: '0600'
      notify: Config file changed
      when: rke2_kubelet_config != ""

    - name: Copy Containerd Registry Configuration file
      ansible.builtin.copy:
        src: "{{ rke2_custom_registry_path }}"
        dest: /etc/rancher/rke2/registries.yaml
        owner: root
        group: root
        mode: '0600'
      notify: Config file changed
      when: rke2_custom_registry_mirrors or rke2_custom_registry_configs

    - name: Register if we need to do a etcd restore from file
      ansible.builtin.set_fact:
        do_etcd_restore: true
      when: rke2_etcd_snapshot_file != "" and not (rke2_server_service_running or rke2_server_service_disabled)

    - name: Register if we need to do a etcd restore from s3
      ansible.builtin.set_fact:
        do_etcd_restore_from_s3: true
      when: rke2_etcd_snapshot_file != "" and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined

    - name: Restore etcd from file
      block:
        - name: Create etcd snapshot directory
          ansible.builtin.file:
            path: /var/lib/rke2/etcd/snapshots
            state: directory
            owner: root
            group: root
            mode: '0755'

        - name: Copy etcd snapshot file
          ansible.builtin.copy:
            src: "{{ rke2_etcd_snapshot_file }}"
            dest: /var/lib/rke2/etcd/snapshots/
            owner: root
            group: root
            mode: '0644'

        - name: Restore etcd from snapshot
          ansible.builtin.command:
            cmd: rke2 server --restore-from-snapshot
          register: etcd_restore_result
          changed_when: etcd_restore_result.rc != 0
      when: do_etcd_restore is defined

    - name: Restore etcd from s3
      block:
        - name: Restore etcd from s3 snapshot
          ansible.builtin.command:
            cmd: rke2 server --restore-from-s3 --etcd-s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }} --etcd-s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }} --etcd-s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }} --etcd-s3-snapshot-name={{ rke2_etcd_snapshot_s3_options.snapshot_name }}
          register: etcd_restore_s3_result
          changed_when: etcd_restore_s3_result.rc != 0
      when: do_etcd_restore_from_s3 is defined

    - name: Start RKE2 service on the first server
      ansible.builtin.systemd:
        name: rke2-server.service
        state: started
        enabled: true
        env:
          RKE2_TOKEN: "{{ rke2_token }}"
      notify: Service (re)started
      when: inventory_hostname == groups['rke2_servers'][0]

    - name: Mask RKE2 agent service on the first server
      ansible.builtin.systemd:
        name: rke2-agent.service
        state: stopped
        masked: true
      when: inventory_hostname == groups['rke2_servers'][0]

    - name: Wait for the first server to be ready - no CNI
      ansible.builtin.command:
        cmd: kubectl get nodes -o wide
      register: node_status_no_cni
      until: node_status_no_cni.rc == 0
      retries: 60
      delay: 10
      when: rke2_cni == 'none' and inventory_hostname == groups['rke2_servers'][0]

    - name: Wait for the first server to be ready - with CNI
      ansible.builtin.command:
        cmd: kubectl get nodes -o wide
      register: node_status_with_cni
      until: node_status_with_cni.rc == 0
      retries: 60
      delay: 10
      when: rke2_cni != 'none' and inventory_hostname == groups['rke2_servers'][0]

    - name: Restore etcd
      block:
        - name: Get registered nodes
          ansible.builtin.command:
            cmd: kubectl get nodes -o name
          register: registered_nodes
          changed_when: false

        - name: Remove old node-password secrets
          ansible.builtin.command:
            cmd: kubectl delete secret -n kube-system $(kubectl get secrets -n kube-system | grep node-password | awk '{print $1}')
          ignore_errors: true
          changed_when: false

        - name: Remove old nodes
          ansible.builtin.command:
            cmd: kubectl delete node $(kubectl get nodes | grep -v master | awk '{print $1}')
          ignore_errors: true
          changed_when: false

        - name: Set Active Server variable
          ansible.builtin.set_fact:
            active_server: "{{ inventory_hostname }}"
      when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

  handlers:
    - name: Config file changed
      ansible.builtin.systemd:
        name: rke2-server.service
        state: restarted

    - name: Service (re)started
      ansible.builtin.systemd:
        name: rke2-server.service
        state: restarted


