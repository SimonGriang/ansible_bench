              rke2_etcd_snapshot_s3_options.bucket }} --etcd-s3-access-key={{
              rke2_etcd_snapshot_s3_options.access_key }} --etcd-s3-secret-key={{
              rke2_etcd_snapshot_s3_options.secret_key }} --etcd-s3-snapshot-name={{
