---
- name: Update package cache
  ansible.builtin.apt:
    update_cache: true
  become: true
  when: ansible_os_family == "Debian"

- name: Update package cache
  ansible.builtin.dnf:
    update_cache: true
  become: true
  when: ansible_os_family == "RedHat"

- name: Install keepalived package
  ansible.builtin.package:
    name: keepalived
    state: present
  become: true

- name: Create keepalived directory
  ansible.builtin.file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: '0755'
  become: true

- name: Create Kubernetes API health check script for Debian OS family
  ansible.builtin.template:
    src: kubernetes_api_health_check.sh.j2
    dest: /etc/keepalived/kubernetes_api_health_check.sh
    owner: root
    group: root
    mode: '0755'
  become: true
  notify: restart keepalived
  when: ansible_os_family == "Debian"

- name: Create Kubernetes API health check script for RedHat OS family
  ansible.builtin.template:
    src: kubernetes_api_health_check.sh.j2
    dest: /usr/libexec/keepalived/kubernetes_api_health_check.sh
    owner: root
    group: root
    mode: '0755'
  become: true
  notify: restart keepalived
  when: ansible_os_family == "RedHat"

- name: Create RKE2 Server health check script for Debian OS family
  ansible.builtin.template:
    src: rke2_server_health_check.sh.j2
    dest: /etc/keepalived/rke2_server_health_check.sh
    owner: root
    group: root
    mode: '0755'
  become: true
  notify: restart keepalived
  when: ansible_os_family == "Debian"

- name: Create RKE2 Server health check script for RedHat OS family
  ansible.builtin.template:
    src: rke2_server_health_check.sh.j2
    dest: /usr/libexec/keepalived/rke2_server_health_check.sh
    owner: root
    group: root
    mode: '0755'
  become: true
  notify: restart keepalived
  when: ansible_os_family == "RedHat"

- name: Create keepalived configuration file
  ansible.builtin.template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: '0644'
  become: true
  notify: restart keepalived

- name: Enable and unmask keepalived service
  ansible.builtin.systemd:
    name: keepalived
    enabled: true
    masked: false
  become: true
  notify: restart keepalived

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true


