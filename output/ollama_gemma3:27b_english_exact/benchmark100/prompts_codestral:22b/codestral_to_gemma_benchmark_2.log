---
- name: Assert role variables
  ansible.builtin.include_tasks: assert.yml

- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: Check if user exists
  ansible.builtin.command: id "{{ git_username }}"
  register: user_exists
  ignore_errors: true

- name: Create user's home directory
  ansible.builtin.file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0700'
  when: user_exists.rc == 0

- name: Configure git
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0600'
  when:
    - user_exists.rc == 0
    - git_user_email is defined
    - git_user_name is defined
    - lookup('file', 'templates/gitconfig.j2') is defined

- name: Create repository destination
  ansible.builtin.file:
    path: "{{ git_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'
  when:
    - user_exists.rc == 0
    - git_destination is defined

- name: Clone repositories
  ansible.builtin.git:
    repo: "{{ item }}"
    dest: "{{ git_destination }}"
    user: "{{ git_username }}"
    force: true
  with_items: "{{ git_repositories }}"
  when:
    - user_exists.rc == 0
    - git_destination is defined
    - git_repositories is defined


