---

  - name: Enable Backports repository
    block:
      - name: Check Debian version
        command: lsb_release -cs
        register: debian_version
        changed_when: false

      - name: Add Backports repository
        apt_repository:
          repo: deb http://deb.debian.org/debian {{ debian_version.stdout }}-backports main
          state: present
          filename: backports
        when: debian_version.stdout|int < 9

  - name: Set the default_release option
    block:
      - name: Set default_release
        apt_preference:
          release: "{{ debian_version.stdout }}-backports"
        when: debian_version.stdout|int < 9

  - name: Install Ansible
    apt:
      name: ansible
      state: "{{ ansible_package_state }}"
      update_cache: yes


