- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if user exists
  command: id "{{ git_username }}"
  register: user_exists
  ignore_errors: true

- name: Create user's home directory
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: 0700
  when: user_exists.rc == 0

- name: Configure git
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
