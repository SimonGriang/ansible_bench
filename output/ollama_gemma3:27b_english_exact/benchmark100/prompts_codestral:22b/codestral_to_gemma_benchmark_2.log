---
  - name: Cordon and Drain the node
    command: kubectl cordon {{ inventory_hostname }} && kubectl drain {{ inventory_hostname }} --ignore-daemonsets --force
    when: rke2_drain_node_during_upgrade
    delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

  - name: Restart RKE2 service
    systemd:
      name: "{{ rke2_service_name }}"
      state: restarted

  - name: Wait for all nodes to be ready again
    command: kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' | grep true | wc -l
    register: ready_nodes_count
    until: ready_nodes_count.stdout == "{{ rke2_node_count }}"
    retries: 60
    delay: 10
    delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

  - name: Uncordon the node
    command: kubectl uncordon {{ inventory_hostname }}
    when: rke2_drain_node_during_upgrade
    delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

  - name: Wait for all pods to be ready again
    command: kubectl get pods --all-namespaces -o jsonpath='{.items[?(@.status.phase!="Running" && @.status.phase!="Succeeded")].metadata.name}' | wc -l
    register: pending_pods_count
    until: pending_pods_count.stdout == "0"
    retries: 60
    delay: 10
    when: rke2_wait_for_all_pods_to_be_ready
    delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

  - name: Wait for all pods to pass readiness checks
    command: kubectl wait --timeout={{ rke2_wait_for_all_pods_to_be_healthy_timeout }} --for=condition=available {{ rke2_wait_for_all_pods_to_be_healthy_args }}
    when: rke2_wait_for_all_pods_to_be_healthy
    delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"


