---
- name: RKE2 Configuration and Service Management
  hosts: all
  become: true
  tasks:
    - name: Create the RKE2 config directory
      file:
        path: /etc/rancher/rke2
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Set server taints
      when: rke2_type == 'server'
      ansible.builtin.shell: |
        echo "{{ rke2_server_node_taints }}" > /etc/sysconfig/node-taints
      args:
        executable: /bin/bash

    - name: Set agent taints
      when: rke2_type == 'agent'
      ansible.builtin.shell: |
        echo "{{ rke2_agent_node_taints }}" > /etc/sysconfig/node-taints
      args:
        executable: /bin/bash

    - name: Copy RKE2 config
      ansible.builtin.copy:
        src: "{{ rke2_config }}"
        dest: /etc/rancher/rke2/config.yaml
        owner: root
        group: root
        mode: '0644'
      notify: Config file changed

    - name: Copy kubelet config
      ansible.builtin.template:
        src: templates/kubelet-config.yaml.j2
        dest: /etc/rancher/rke2/kubelet-config.yaml
        owner: root
        group: root
        mode: '0644'
      when: rke2_kubelet_config != ""
      notify: Config file changed

    - name: Copy Containerd Registry Configuration file
      ansible.builtin.copy:
        src: "{{ rke2_custom_registry_path }}"
        dest: /etc/rancher/rke2/registries.yaml
        owner: root
        group: root
        mode: '0644'
      when: rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != ""
      notify: Config file changed

    - name: Start RKE2 service on the rest of the nodes
      ansible.builtin.systemd:
        name: "{{ rke2_service_name }}"
        state: started
        enabled: true
        env:
          RKE2_TOKEN: "{{ rke2_token }}"
      notify: Service (re)started

    - name: Mask other RKE2 service on the rest of the nodes
      ansible.builtin.systemd:
        name: "{{ rke2_service_name }}"
        state: stopped
        masked: true
      when: rke2_type == 'server' and rke2_service_name == 'rke2-agent' or \
            rke2_type == 'agent' and rke2_service_name == 'rke2-server'

    - name: Wait for remaining nodes to be ready - no CNI
      ansible.builtin.shell: |
        set -ex
        until kubectl get nodes -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}' | grep -q "True"
        do
          sleep 5
        done
      args:
        executable: /bin/bash
      when: rke2_cni == 'none' and rke2_cluster_group_name is defined

    - name: Wait for remaining nodes to be ready - with CNI
      ansible.builtin.shell: |
        set -ex
        until kubectl get nodes -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}' | \
        grep -q "^True$" | wc -l | grep -q "{{ rke2_node_count }}"
        do
          sleep 5
        done
      args:
        executable: /bin/bash
      when: rke2_cni != 'none' and rke2_cluster_group_name is defined

  handlers:
    - name: Config file changed
      ansible.builtin.systemd:
        name: "{{ rke2_service_name }}"
        state: restarted

