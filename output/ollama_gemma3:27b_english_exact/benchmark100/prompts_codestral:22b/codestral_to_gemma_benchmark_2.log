      ansible.builtin.setup:
        filter: ansible_facts.service_facts
    - name: Get stats of the filesystem object
      ansible.builtin.stat:
        path: /var/lib/rancher/rke2/bin
      register: rke2_bin_stat
    - name: Check if separate partition
      ansible.builtin.set_fact:
        rke2_separate_partition: "{{ rke2_bin_stat.stat.exists }}"
    - name: Set RKE2 bin path
      ansible.builtin.set_fact:
        rke2_bin_path: "/var/lib/rancher/rke2/bin"
  delegate_to: localhost

- name: Check RKE2 version
  block:
    - name: Check if RKE2 binary exists
      ansible.builtin.stat:
        path: "{{ rke2_bin_path }}/rke2"
      register: rke2_binary_stat
    - name: Check RKE2 version
      ansible.builtin.command: "{{ rke2_bin_path }}/rke2 --version"
      register: rke2_version_output
      ignore_errors: true
      changed_when: false
    - name: Set installed version
      ansible.builtin.set_fact:
        installed_rke2_version: "{{ rke2_version_output.stdout | regex_search('rke2 version (.*)', '\\1') | default('not installed') }}"
    - name: Check running RKE2 service
      ansible.builtin.command: systemctl is-active rke2
      register: rke2_service_status
      ignore_errors: true
      changed_when: false
    - name: Check running RKE2 binary if service is active
      ansible.builtin.command: "{{ rke2_bin_path }}/rke2 --version"
      register: rke2_running_version_output
      ignore_errors: true
      changed_when: false
      when: rke2_service_status.stdout == 'active'
    - name: Set running version
      ansible.builtin.set_fact:
        running_rke2_version: "{{ rke2_running_version_output.stdout | regex_search('rke2 version (.*)', '\\1') | default(desired_rke2_version) }}"
  delegate_to: localhost

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.fail:
    msg: "Downgrade of RKE2 is not allowed!"
  when: desired_rke2_version | version_compare(running_rke2_version, '<') and allow_downgrades == false

- name: Run RKE2 install script
  block:
    - name: Run RKE2 install script with airgap variables
      ansible.builtin.command: "{{ rke2_install_script_dest }} --airgap"
