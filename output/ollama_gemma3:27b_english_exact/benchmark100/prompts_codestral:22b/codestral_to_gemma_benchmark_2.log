---

  - name: Import assert.yml
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install nginx
    package:
      name: nginx
      state: present

  - name: Place nginx.conf
    template:
      src: nginx.conf.j2
      dest: /etc/nginx/nginx.conf
    notify: Restart nginx
    register: nginx_config_result
    when: nginx_config_result is not defined or nginx_config_result.changed

  - name: Ensure /etc/nginx/conf.d exists
    file:
      path: /etc/nginx/conf.d
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Place default.conf
    template:
      src: default.conf.j2
      dest: /etc/nginx/conf.d/default.conf
    notify: Restart nginx
    register: default_config_result
    when: default_config_result is not defined or default_config_result.changed

  - name: Start and enable nginx
    service:
      name: nginx
      state: started
      enabled: true


