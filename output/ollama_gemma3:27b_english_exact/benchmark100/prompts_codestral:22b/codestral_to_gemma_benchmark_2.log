---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install using package
  block:
    - name: Add HashiCorp repository (RedHat/Rocky)
      when: ansible_os_family == "RedHat" or ansible_os_family == "Rocky"
      yum_repository:
        name: hashicorp
        description: HashiCorp Repository
        baseurl: https://rpm.releases.hashicorp.com
        gpg_key: https://releases.hashicorp.com/gpg

    - name: Add HashiCorp repository (Debian)
      when: ansible_os_family == "Debian"
      apt_repository:
        repo: "deb https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
        state: present
        filename: hashicorp

    - name: Update package cache (RedHat/Rocky)
      when: ansible_os_family == "RedHat" or ansible_os_family == "Rocky"
      yum:
        name: '*'
        state: latest
        update_cache: yes

    - name: Update package cache (Debian)
      when: ansible_os_family == "Debian"
      apt:
        update_cache: yes

    - name: Install HashiCorp products
      package:
        name: "{{ hashicorp_products }}"
        state: present
  when: hashicorp_installation_method == "package"

- name: Install manually
  block:
    - name: Download HashiCorp products
      get_url:
        url: "{{ item.url }}"
        dest: "/tmp/{{ item.filename }}"
        mode: '0644'
      loop: "{{ hashicorp_manual_downloads }}"

    - name: Extract HashiCorp products
      unarchive:
        src: "/tmp/{{ item.filename }}"
        dest: "{{ item.destination }}"
        remote_src: yes
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
  when: hashicorp_installation_method == "manual"


