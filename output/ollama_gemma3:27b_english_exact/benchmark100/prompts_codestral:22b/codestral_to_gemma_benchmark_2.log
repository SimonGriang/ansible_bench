---
  - name: Import assert.yml
    import_playbook: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install cron
    package:
      name: "{{ cron_packages }}"
      state: present

  - name: Configure shell
    lineinfile:
      path: "{{ cron_configuration }}"
      regexp: "^SHELL"
      line: "SHELL={{ cron_shell }}"
      create: yes
      mode: 0600
    notify: Restart cron

  - name: Configure path
    lineinfile:
      path: "{{ cron_configuration }}"
      regexp: "^PATH"
      line: "PATH={{ cron_path }}"
      create: yes
      mode: 0600
    notify: Restart cron

  - name: Configure mailto
    lineinfile:
      path: "{{ cron_configuration }}"
      regexp: "^MAILTO"
      line: "MAILTO={{ cron_mailto }}"
      create: yes
      mode: 0600
    notify: Restart cron

  - name: Start and enable cron
    systemd:
      name: "{{ cron_service }}"
      state: started
      enabled: yes
    when: cron_service is defined and cron_service != ""

  - name: Schedule requested cron jobs
    cron:
      name: "{{ item.name }}"
      minute: "{{ item.minute }}"
      hour: "{{ item.hour }}"
      day: "{{ item.day }}"
      month: "{{ item.month }}"
      weekday: "{{ item.weekday }}"
      special_time: "{{ item.special_time }}"
      job: "{{ item.job }}"
      state: "{{ item.state | default('present') }}"
      user: "{{ item.user }}"
    loop: "{{ cron_jobs | default([]) }}"


