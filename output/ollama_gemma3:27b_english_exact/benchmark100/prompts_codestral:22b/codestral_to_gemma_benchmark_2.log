---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    create: yes
    mode: 0600
  notify: Restart cron

- name: Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    create: yes
    mode: 0600
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    mode: 0600
  notify: Restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ""

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute | default('*') }}"
    hour: "{{ item.hour | default('*') }}"
    day: "{{ item.day | default('*') }}"
    month: "{{ item.month | default('*') }}"
    weekday: "{{ item.weekday | default('*') }}"
    special_time: "{{ item.special_time | default('') }}"
    state: "{{ item.state | default('present') }}"
    user: "{{ item.user | default(ansible_user_id) }}"
  loop: "{{ cron_jobs | default([]) }}"
  when: cron_jobs is defined


