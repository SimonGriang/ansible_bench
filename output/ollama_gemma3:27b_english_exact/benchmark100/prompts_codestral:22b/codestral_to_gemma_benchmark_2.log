---

- name: Install Keepalived
  include_tasks: keepalived.yml
  when: ha_mode_enabled and inventory_hostname in groups['RKE2 servers'] and ha_mode == 'Keepalived'

- name: Install RKE2
  include_tasks: install_rke2.yml

- name: Apply CIS Hardening
  include_tasks: cis.yml
  when: cis_profile is defined

- name: Identify Active Server
  include_tasks: find_active_server.yml

- name: Enable IPVS Kernel Module
  include_tasks: enable_ipvs.yml
  when: ipvs_enabled and inventory_hostname in groups['RKE2 servers'] and ha_mode == 'Kubevip' and ha_mode != 'Keepalived'

- name: Copy Kube-vip Manifests
  include_tasks: copy_kube_vip_manifests.yml
  when: inventory_hostname == groups['RKE2 servers'][0] and ha_mode == 'Kubevip' and ha_mode != 'Keepalived'

- name: Copy Ingress-nginx Manifests
  include_tasks: copy_ingress_nginx_manifests.yml
  when: inventory_hostname == groups['RKE2 servers'][0] and ingress_nginx_values is defined

- name: Prepare First Server Node
  include_tasks: prepare_first_server_node.yml
  when: inventory_hostname == groups['RKE2 servers'][0] and (active_server is not defined or len(groups['RKE2 servers']) == 1)

- name: Restore etcd
  include_tasks: first_server_restore.yml
  when: active_server is defined and (inventory_hostname == active_server or inventory_hostname == groups['RKE2 servers'][0]) and etcd_restore_needed

- name: Download kubeconfig
  include_tasks: download_kubeconfig.yml
  when: kubeconfig_download_enabled and inventory_hostname == groups['RKE2 servers'][0]

- name: Prepare and Join Remaining Nodes
  include_tasks: prepare_join_remaining_nodes.yml
  when: active_server is defined and len(groups['RKE2 servers']) > 1

- name: Rolling Restart Servers
  include_tasks: rolling_restart.yml
  when: installed_version != running_version_servers

- name: Rolling Restart Agents
  include_tasks: rolling_restart.yml
  when: installed_version != running_version_agents and inventory_hostname not in groups['RKE2 servers']

- name: Flush Handlers
  meta: flush_handlers

- name: Rolling Restart Config Change
  include_tasks: change_config.yml
  when: restart_needed_config_change

- name: Final Steps
  include_tasks: final_steps.yml


