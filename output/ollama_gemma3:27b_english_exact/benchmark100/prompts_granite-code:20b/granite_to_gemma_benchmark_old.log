---

- name: password | Get efi path
  stat:
    path: /sys/firmware/efi/efivars
  register: efi_path

- name: password | Remove unwanted grub.cfg on EFI systems
  file:
    path: /boot/grub/grub.cfg
    state: absent
  when: efi_path.stat.exists

- name: password | Install user template
  template:
    src: user.j2
    dest: /etc/pam.d/common-password
    mode: 0644

- name: password | EFI | add password
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX='
    line: "GRUB_CMDLINE_LINUX=\"{{ grub_cmdline_efi }}\""
    state: present
  when: efi_path.stat.exists

- name: password | MBR | add password
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX='
    line: "GRUB_CMDLINE_LINUX=\"{{ grub_cmdline_mbr }}\""
    state: present
  when: not efi_path.stat.exists

- name: password | Add --unrestricted
  replace:
    path: /etc/pam.d/common-password
    regexp: 'auth.*sufficient pam_unix.so'
    replace: 'auth    sufficient pam_unix.so try_first_pass nullok sha512 shadow remember=5'


