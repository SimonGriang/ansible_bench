---
  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install mysql
    package:
      name: "{{ mysql_packages }}"
      state: present

  - name: Configure mysql server
    template:
      src: mysql.conf.j2
      dest: "{{ mysql_configuration_destination }}/my.cnf"
      owner: root
      group: root
      mode: 0644
    notify: restart mysql

  - name: Configure mysql client
    template:
      src: mysql.conf.j2
      dest: "{{ mysql_configuration_destination }}/my.cnf"
      owner: root
      group: root
      mode: 0644
    notify: restart mysql

  - name: Initialize mysql
    command: "{{ mysql_initialize_command }}"
    changed_when: true

  - name: Start and enable mysql
    service:
      name: mysql
      state: started
      enabled: yes

  - name: Flush handlers
    meta: flush_handlers

  - name: Place my.cnf
    copy:
      src: my.cnf.j2
      dest: /root/.my.cnf
      owner: root
      group: root
      mode: 0600

  - name: Create databases
    mysql_db:
      name: "{{ item }}"
      state: present
    loop: "{{ mysql_databases }}"

  - name: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.priv }}"
      host: "{{ item.host }}"
      state: present
    loop: "{{ mysql_users }}"

  - name: Flush handlers again
    meta: flush_handlers


