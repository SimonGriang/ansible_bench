---
- name: create | Create ssl key
  ansible.builtin.openssl_key:
    path: "{{ ssl_key_path }}"
    size: "{{ ssl_key_size }}"

- name: create | Create ssl csr
  ansible.builtin.openssl_csr:
    path: "{{ ssl_csr_path }}"
    private_key: "{{ ssl_key_path }}"
    subj: "{{ ssl_csr_subject }}"

- name: create | Create ssl certificates
  ansible.builtin.openssl_cert:
    path: "{{ ssl_cert_path }}"
    csr: "{{ ssl_csr_path }}"
    private_key: "{{ ssl_key_path }}"
    days: "{{ ssl_cert_days }}"
    self_signed: true

- name: create | Create PKCS#12 file
  ansible.builtin.openssl_pkcs12:
    path: "{{ ssl_pkcs12_path }}"
    private_key: "{{ ssl_key_path }}"
    certificate: "{{ ssl_cert_path }}"
    password: "{{ ssl_pkcs12_password }}"

- name: create | Read private key
  ansible.builtin.slurp:
    src: "{{ ssl_key_path }}"
  register: ssl_key_file

- name: create | Read certificate
  ansible.builtin.slurp:
    src: "{{ ssl_cert_path }}"
  register: ssl_cert_file

- name: create | Create combined private_key and certificate file
  ansible.builtin.copy:
    content: "{{ ssl_key_file.content }}\n{{ ssl_cert_file.content }}"
    dest: "{{ ssl_combined_path }}"
    mode: '0644'


