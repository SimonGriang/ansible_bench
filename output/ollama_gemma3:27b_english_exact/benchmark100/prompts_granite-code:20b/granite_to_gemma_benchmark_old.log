---
- name: Install fail2ban
  package:
    name: fail2ban
    state: present

- name: Copy filters in filter.d
  copy:
    src: files/filters/
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: 0640
    remote_src: yes

- name: Configure fail2ban.local
  ini_file:
    path: /etc/fail2ban/fail2ban.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
  loop:
    - section: DEFAULT
      option: ignoreip
      value: 127.0.0.1/8
    - section: DEFAULT
      option: bantime
      value: 600
    - section: DEFAULT
      option: findtime
      value: 600
    - section: DEFAULT
      option: maxretry
      value: 3

- name: Configure jail.local
  ini_file:
    path: /etc/fail2ban/jail.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
  loop:
    - section: ssh
      option: enabled
      value: true
    - section: ssh
      option: port
      value: ssh
    - section: ssh
      option: logpath
      value: /var/log/auth.log
    - section: ssh
      option: backend
      value: auto

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
  register: auth_log

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    owner: root
    group: root
    mode: 0640
    state: touch
  when: not auth_log.stat.exists

- name: Start and enable fail2ban
  service:
    name: fail2ban
    state: started
    enabled: yes


