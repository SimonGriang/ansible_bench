---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install dns
  package:
    name: bind9
    state: present

- name: Create directories
  file:
    path: "{{ dns_directory }}"
    state: directory
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0750'
    recurse: yes

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    home: "{{ dns_directory }}"
    shell: /bin/false
    createhome: false
    state: present

- name: Generate rndc key
  command: rndc-confgen -a -k rndc-key -n {{ dns_domain }}
  args:
    creates: "{{ dns_directory }}/rndc-key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_directory }}/rndc-key"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0600'

