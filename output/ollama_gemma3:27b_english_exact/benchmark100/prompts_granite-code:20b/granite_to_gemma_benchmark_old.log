---

- name: Ensure old versions of Docker are not installed.
  apt:
    name: docker.io
    state: absent
  become: true
  when: ansible_os_family == "Debian"

- name: Add Docker GPG key.
  apt_key:
    url: https://download.docker.com/linux/ubuntu/gpg
    state: present
  become: true
  when: ansible_os_family == "Debian"

- name: Add Docker repository.
  apt_repository:
    repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_distribution_release }} stable
    state: present
  become: true
  when: ansible_os_family == "Debian"

- name: Configure Docker Nightly repo.
  apt_repository:
    repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_distribution_release }} nightly
    state: present
  become: true
  when: ansible_os_family == "Debian"

- name: Configure Docker Test repo.
  apt_repository:
    repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_distribution_release }} test
    state: present
  become: true
  when: ansible_os_family == "Debian"

- name: Configure containerd on RHEL 8.
  yum:
    name: containerd
    state: present
  become: true
  when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"


