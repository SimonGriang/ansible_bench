---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install dns
  package:
    name: bind9
    state: present

- name: Create directories
  file:
    path: "{{ dns_directory }}"
    state: directory
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0750'
    recurse: yes

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    home: "{{ dns_directory }}"
    shell: /bin/false
    createhome: false
    state: present

- name: Generate rndc key
  command: rndc-confgen -a -k rndc-key -n {{ dns_domain }}
  args:
    creates: "{{ dns_directory }}/rndc-key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_directory }}/rndc-key"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0600'

- name: Get the hints/root file
  get_url:
    url: "{{ hints_root_url }}"
    dest: /tmp/named.root
    mode: '0644'
  register: hints_root_download

- name: Copy hints/root file
  copy:
    src: /tmp/named.root
    dest: "{{ dns_directory }}/named.root"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0644'
  when: hints_root_download.changed

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_directory }}/{{ item }}.db"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0640'
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_directory }}/named.conf"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0640'

- name: Place systemd override
  template:
    src: bind9.service.j2
    dest: /etc/systemd/system/bind9.service.d/override.conf
    owner: root
    group: root
    mode: '0644'

- name: Start and enable dns
  systemd:
    name: bind9
    state: restarted
    enabled: yes


