---

  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install required packages
    package:
      name:
        - python3
        - python3-pip
      state: present

  - name: Configure systemd service
    template:
      src: service.j2
      dest: /etc/systemd/system/my_service.service
    when: ansible_service_mgr == "systemd"
    notify:
      - restart my_service

  - name: Configure sysvinit service
    template:
      src: service.j2
      dest: /etc/init.d/my_service
    when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]
    notify:
      - restart my_service

  - name: Manage service
    service:
      name: "{{ item.name }}"
      state: "{{ item.state }}"
      enabled: "{{ item.enabled }}"
    loop: "{{ service_list }}"

  - name: Flush handlers
    meta: flush_handlers


