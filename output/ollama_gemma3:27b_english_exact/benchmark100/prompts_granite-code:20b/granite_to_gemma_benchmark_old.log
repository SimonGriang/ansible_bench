- name: Import assert.yml
  include_tasks: assert.yml

- name: Install cron
  package:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/shells
    line: /bin/bash
    create: yes

- name: Configure path
  lineinfile:
    path: /etc/environment
    line: PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    create: yes

- name: Configure mailto
  lineinfile:
    path: /etc/aliases
    line: "root: your_email@example.com"
    create: yes
  notify:
    - newaliases

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: true

- name: Schedule requested cron jobs
  cron:
    name: "your_cron_job"
    user: root
    minute: "0"
    hour: "0"
    day: "*"
    month: "*"
    weekday: "*"
    job: "your_command_here"


