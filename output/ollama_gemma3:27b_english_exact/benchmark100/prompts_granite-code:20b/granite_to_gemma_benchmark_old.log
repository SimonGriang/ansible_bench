    get_url:
      url: https://github.com/grafana/loki/releases/download/v2.9.0/promtail-linux-amd64.tar.gz
      dest: /tmp/promtail-linux-amd64.tar.gz

  - name: Propagate promtail binaries
    copy:
      src: /tmp/promtail-linux-amd64.tar.gz
      dest: /var/lib/promtail/promtail-linux-amd64.tar.gz

  - name: Unpack promtail binaries
    unarchive:
      src: /var/lib/promtail/promtail-linux-amd64.tar.gz
      dest: /var/lib/promtail
      remote_src: yes

