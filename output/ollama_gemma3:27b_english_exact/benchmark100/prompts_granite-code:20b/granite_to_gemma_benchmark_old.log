---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install python pip
  package:
    name: python3-pip
    state: present

- name: Configure pip proxy
  ini_file:
    path: /etc/pip.conf
    section: global
    option: proxy
    value: "{{ pip_proxy }}"
    create: yes

- name: Trust hosts
  ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ trusted_hosts }}"
    create: yes

- name: Update pip.
  pip:
    name: pip
    state: latest

- name: Install requested modules
  pip:
    name: "{{ requested_modules }}"
    state: present


