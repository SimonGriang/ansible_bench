---
  - name: Update apt cache
    apt:
      update_cache: yes
    become: yes
    when: ansible_os_family == "Debian"

  - name: Update dnf cache
    dnf:
      update_cache: yes
    become: yes
    when: ansible_os_family == "RedHat"

  - name: Install packages
    package:
      name: keepalived
      state: present
    become: yes

  - name: Create directory for keepalived
    file:
      path: /etc/keepalived
      state: directory
      owner: root
      group: root
      mode: '0755'
    become: yes

  - name: Create Kubernetes API health check script for Debian OS family
    copy:
      dest: /usr/local/bin/k8s_api_health.sh
      content: |
        #!/bin/bash
        kubectl get pods -n kube-system | grep -q kube-apiserver
        exit $?
      mode: '0755'
    become: yes
    when: ansible_os_family == "Debian"

  - name: Create Kubernetes API health check script for RedHat OS famliy
    copy:
      dest: /usr/local/bin/k8s_api_health.sh
      content: |
        #!/bin/bash
        kubectl get pods -n kube-system | grep -q kube-apiserver
        exit $?
      mode: '0755'
    become: yes
    when: ansible_os_family == "RedHat"

  - name: Create RKE2 Server health check script for Debian OS family
    copy:
      dest: /usr/local/bin/rke2_server_health.sh
      content: |
        #!/bin/bash
        systemctl is-active rke2-server > /dev/null 2>&1
        exit $?
      mode: '0755'
    become: yes
    when: ansible_os_family == "Debian"

  - name: Create RKE2 Server health check script for RedHat OS family
    copy:
      dest: /usr/local/bin/rke2_server_health.sh
      content: |
        #!/bin/bash
        systemctl is-active rke2-server > /dev/null 2>&1
        exit $?
      mode: '0755'
    become: yes
    when: ansible_os_family == "RedHat"

  - name: Create keepalived config file
    copy:
      dest: /etc/keepalived/keepalived.conf
      content: |
        vrrp_instance VI_1 {
            state MASTER
            interface eth0
            virtual_router_id 51
            priority 100
            advert_int 1
        }
    become: yes

  - name: Enable keepalived and make sure it is not masked
    systemd:
      name: keepalived
      enabled: true
      masked: false
    become: yes

  - name: Flush handlers
    meta: flush_handlers


