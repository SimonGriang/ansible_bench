- name: Create the RKE2 manifests directory
  file:
    path: /opt/rke2/manifests
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy kube-vip files to first server
  copy:
    src: files/kube-vip/
    dest: /opt/rke2/manifests/kube-vip/
    owner: root
    group: root
    mode: '0644'

- name: Copy kube-vip load balancer manifests to first server
  copy:
    src: files/kube-vip/loadbalancer/
    dest: /opt/rke2/manifests/kube-vip/loadbalancer/
    owner: root
    group: root
    mode: '0644'
  when: rke2_kubevip_cloud_provider_enable


