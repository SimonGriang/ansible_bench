---

- name: Enable redis module stream (RHEL 8)
  command: "dnf module enable redis -y"
  become: true
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"

- name: Install redis
  package:
    name: redis
    state: present
  become: true

- name: Configure redis
  copy:
    src: redis.conf
    dest: /etc/redis.conf
    owner: redis
    group: redis
    mode: '0644'
  become: true
  notify: restart redis

- name: Start and enable redis
  service:
    name: redis
    state: started
    enabled: true
  become: true



