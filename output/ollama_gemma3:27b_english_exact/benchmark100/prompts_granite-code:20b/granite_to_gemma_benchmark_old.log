---

- name: import assert.yml
  include_tasks: assert.yml

- name: install logrotate
  package:
    name: logrotate
    state: present

- name: configure logrotate
  template:
    src: templates/logrotate.conf.j2
    dest: /etc/logrotate.conf
    owner: root
    group: root
    mode: 0644

- name: generate logrotate.d files
  template:
    src: templates/logrotate.d/{{ item.name }}.j2
    dest: /etc/logrotate.d/{{ item.name }}
    owner: root
    group: root
    mode: 0644
  loop: "{{ logrotate_configs }}"

- name: remove logrotate.d files
  file:
    path: /etc/logrotate.d/{{ item.name }}
    state: absent
  loop: "{{ logrotate_configs }}"

- name: start logrotate
  service:
    name: logrotate
    state: started
    enabled: true


