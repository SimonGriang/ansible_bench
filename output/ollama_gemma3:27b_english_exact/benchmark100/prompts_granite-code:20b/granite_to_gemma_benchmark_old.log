- name: Configure apk
  import_tasks: assert.yml

- name: Configure apk
  apk:
    update_cache: yes

- name: Configure apk
  apk:
    upgrade: all

- name: Configure apt
  apt:
    pin:
      name: "*"
      version: "0.1"
      release: ""
      priority: "-1"
    state: present

- name: Configure apt
  apt:
    upgrade: dist
    update_cache: yes

- name: Configure apt
  apt:
    autoremove: yes

- name: Update all software (dnf)
  dnf:
    update_only: yes

- name: Update all software (pacman)
  pacman:
    update_cache: yes
    upgrade: yes

- name: Update all software (yum/6)
  yum:
    name: "*"
    state: latest
  when: ansible_distribution_major_version == "6"

- name: Update yum non-6
  yum:
    name: "*"
    state: latest
  when: ansible_distribution_major_version != "6"

- name: Configure yum
  yum:
    name: yum-utils
    state: present

- name: Update all software (zypper)
  zypper:
    name: "*"
    state: latest
    update_cache: yes


