---

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install cron
  package:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/shells
    line: /bin/bash
    create: yes

- name: Configure path
  lineinfile:
    path: /etc/environment
    line: PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    create: yes

- name: Configure mailto
  lineinfile:
    path: /etc/aliases
    line: "root: your_email@example.com"
