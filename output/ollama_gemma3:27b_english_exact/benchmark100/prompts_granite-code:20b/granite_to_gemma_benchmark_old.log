---

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Configure postfix (transport_maps)
  lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^transport_maps ='
    line: 'transport_maps = hash:/etc/postfix/transport'
    state: present

- name: Configure postfix (header_checks)
  lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^header_checks ='
    line: 'header_checks = regexp:/etc/postfix/header_checks'
    state: present

- name: "Setting values for main.cf (1/2)"
  lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^myhostname ='
    line: 'myhostname = {{ ansible_fqdn }}'
    state: present

- name: "Setting values for main.cf (2/2)"
  lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^mydomain ='
    line: 'mydomain = {{ ansible_domain }}'
    state: present

- name: Configure postfix (main.cf)
  lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^myorigin ='
    line: 'myorigin = $mydomain'
    state: present

- name: Creates cert/key directory
  file:
    path: /etc/ssl/private
    state: directory
    mode: '0700'

- name: Deploy Postfix TLS server certificate
  copy:
    src: files/tls.pem
    dest: /etc/ssl/certs/tls.pem
    mode: '0644'

- name: Deploy Postfix TLS server key
  copy:
    src: files/tls.key
    dest: /etc/ssl/private/tls.key
    mode: '0600'

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    src: files/aliases
    dest: /etc/aliases
    mode: '0644'

- name: Configure sender_access
  copy:
    src: files/sender_access
    dest: /etc/postfix/sender_access
    mode: '0644'

- name: Configure recipient_access
  copy:
    src: files/recipient_access
    dest: /etc/postfix/recipient_access
    mode: '0644'

- name: Place sasl_password_map
  copy:
    src: files/sasl_password_map
    dest: /etc/postfix/sasl_password_map
    mode: '0600'

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes


