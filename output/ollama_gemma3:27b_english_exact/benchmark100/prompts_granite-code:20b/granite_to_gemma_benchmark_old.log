---

- name: Create group vault
  group:
    name: vault
    state: present

- name: Create user vault
  user:
    name: vault
    group: vault
    state: present
    createhome: false

- name: Create directory /opt/vault
  file:
    path: /opt/vault
    state: directory
    owner: vault
    group: vault
    mode: '0755'

- name: Download Vault binary
  get_url:
    url: https://releases.hashicorp.com/vault/1.14.3/vault_1.14.3_linux_amd64.zip
    dest: /opt/vault/vault_1.14.3_linux_amd64.zip
    owner: vault
    group: vault

- name: Create directory /etc/vault.d
  file:
    path: /etc/vault.d
    state: directory
    owner: vault
    group: vault
    mode: '0755'

- name: Copy Vault binary
  unarchive:
    src: /opt/vault/vault_1.14.3_linux_amd64.zip
    dest: /opt/vault
    remote_src: yes
    owner: vault
    group: vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  become: true
  become_user: root
  command: setcap cap_ipc_lock=ep /usr/bin/vault

- name: Create file /etc/vault.d/vault.env
  file:
    path: /etc/vault.d/vault.env
    state: touch
    owner: vault
    group: vault
    mode: '0644'

- name: Create directory /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy Vault service file
  copy:
    src: files/vault.service
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'
  notify:
    - restart vault

- name: Copy vault configuration
  copy:
    src: files/vault.hcl
    dest: /etc/vault.d/vault.hcl
    owner: vault
    group: vault
    mode: '0644'
  notify:
    - restart vault

- name: Flush handlers
  meta: flush_handlers


