---

- name: Install mysql
  ansible.builtin.package:
    name: mysql-server
    state: present

- name: Configure mysql server
  ansible.builtin.copy:
    src: mysql.conf.d
    dest: /etc/mysql/mysql.conf.d/
    owner: root
    group: root
    mode: '0644'
  notify: restart mysql

- name: Configure mysql client
  ansible.builtin.copy:
    src: my.cnf
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'
  notify: restart mysql

- name: Initialize mysql
  ansible.builtin.shell: mysql_secure_installation
  args:
    creates: /etc/mysql/debian.conf

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.copy:
    src: my.cnf
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'
  notify: restart mysql

- name: Create databases
  ansible.builtin.mysql_db:
    name: "{{ item }}"
    state: present
  loop:
    - database1
    - database2

- name: List databases
  ansible.builtin.shell: mysql -u root -p'your_root_password' -e "SHOW DATABASES;"
  register: databases
  changed_when: false

- name: Import database
  ansible.builtin.shell: mysql -u root -p'your_root_password' database1 < /path/to/database1.sql
  args:
    creates: /path/to/database1.sql

- name: Create users
  ansible.builtin.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    host: '%'
    state: present
  loop:
    - { name: 'user1', password: 'password1', priv: '*.*' }
    - { name: 'user2', password: 'password2', priv: 'database1.*' }

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


