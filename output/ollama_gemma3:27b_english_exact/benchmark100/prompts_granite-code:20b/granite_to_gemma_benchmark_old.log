content='```yaml\n---\n\n- name: Import assert.yml\n  include_tasks: assert.yml\n\n- name: Install apache httpd\n  package:\n    name: httpd\n    state: present\n\n- name: Configure selinux\n  selinux:\n    state: enforcing\n\n- name: Configure httpd\n  template:\n    src: httpd.conf.j2\n    dest: /etc/httpd/conf/httpd.conf\n  notify: restart httpd\n\n- name: Activate httpd module | Debian\n  when: ansible_os_family == "Debian"\n  lineinfile:\n    path: /etc/apache2/mods-enabled/http2.conf\n    regexp: \'^#.*\'\n    line: a2enmod http2\n  notify: restart apache2\n\n- name: Import ssl.yml\n  include_tasks: ssl.yml\n\n- name: Import locations.yml\n  include_tasks: locations.yml\n\n- name: Import vhosts.yml\n  include_tasks: vhosts.yml\n\n- name: Configure ports\n  firewalld:\n    port: 80/tcp\n    permanent: true\n    state: enabled\n  notify: restart httpd\n\n- name: Import directories.yml\n  include_tasks: directories.yml\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Removing default html\n  file:\n    path: /var/www/html/index.html\n    state: absent\n\n- name: Start and enable httpd\n  service:\n    name: httpd\n    state: started\n    enabled: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-12T14:03:43.100926565Z', 'done': True, 'done_reason': 'stop', 'total_duration': 22446269498, 'load_duration': 182463573, 'prompt_eval_count': 545, 'prompt_eval_duration': 1802686030, 'eval_count': 363, 'eval_duration': 20459887404, 'model_name': 'gemma3:27b'} id='run--25c46984-5dd3-4b1b-84c4-9f0b09689418-0' usage_metadata={'input_tokens': 545, 'output_tokens': 363, 'total_tokens': 908}
