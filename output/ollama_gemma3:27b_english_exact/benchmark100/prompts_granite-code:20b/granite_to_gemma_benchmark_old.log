---

  - name: Set fact java_jdk_vendor to temurin if java_jdk_vendor equals adoptopenjdk
    set_fact:
      java_jdk_vendor: temurin
    when: java_jdk_vendor == 'adoptopenjdk'

  - name: Include OS specific variables based on java_jdk_vendor, ansible_distribution, and ansible_distribution_major_version
    include_vars:
      file: "vars/{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.yml"
    ignore_errors: true

  - name: Include architecture specific variables
    include_vars:
      file: "vars/architecture_{{ ansible_architecture }}.yml"
    ignore_errors: true

  - name: Set OS specific variables (I)
    set_fact:
      java_open_jdk_home_dir: "/usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk"

  - name: Set OS and architecture specific variables (II)
    set_fact:
      java_pkg_name: "{{ java_pkg_name_base }}{{ java_architecture }}"

  - name: Set specific variables
    set_fact:
      java_pkg_name_base: "openjdk-{{ java_open_jdk_version }}-jre"

  - name: Add pre-requisites for Debian if ansible_os_family equals Debian
    apt:
      name:
        - openjdk-{{ java_open_jdk_version }}-jre-headless
        - ca-certificates
      state: present
    when: ansible_os_family == 'Debian'

  - name: Add pre-requisites for RedHat if ansible_os_family equals RedHat
    yum:
      name:
        - java-{{ java_open_jdk_version }}-openjdk-headless
        - ca-certificates
      state: present
    when: ansible_os_family == 'RedHat'

  - name: Install required libs
    package:
      name:
        - libstdc++6
      state: present

  - name: Install Java, Debian if ansible_os_family equals Debian
    apt:
      name: "{{ java_pkg_name }}"
      state: present
    when: ansible_os_family == 'Debian'

  - name: Install Java, RedHat if ansible_os_family equals RedHat
    yum:
      name: "{{ java_pkg_name }}"
      state: present
    when: ansible_os_family == 'RedHat'

  - name: Export environment variables
    environment:
      JAVA_HOME: "{{ java_open_jdk_home_dir }}"
      PATH: "{{ JAVA_HOME }}/bin:{{ PATH }}"

  - name: Source environment variables
    shell: source /etc/profile
    args:
      executable: /bin/bash
    changed_when: false

  - name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11 if ansible_os_family equals Debian and java_open_jdk_version_major is less than 11
    lineinfile:
      path: /usr/bin/java
      regexp: '^/usr/lib/jvm/.*jre/bin/java$'
      line: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java"
    when: ansible_os_family == 'Debian' and java_open_jdk_version_major < 11

  - name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11 if ansible_os_family equals Debian and java_open_jdk_version_major is greater than or equal to 11
    lineinfile:
      path: /usr/bin/java
      regexp: '^/usr/lib/jvm/.*bin/java$'
      line: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java"
    when: ansible_os_family == 'Debian' and java_open_jdk_version_major >= 11


