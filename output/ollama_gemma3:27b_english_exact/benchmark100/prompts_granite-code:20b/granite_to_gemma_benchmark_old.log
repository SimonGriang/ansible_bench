---

  - name: Cordon and Drain the node {{ rke2_node_name }}
    kubernetes.core.k8s:
      state: present
      api_version: apps/v1
      kind: DaemonSet
      name: kube-proxy
      namespace: kube-system
      drain_node: true
      node_name: "{{ rke2_node_name }}"
    when: rke2_drain_node_during_upgrade

  - name: Restart RKE2 service on {{ rke2_node_name }}
    systemd:
      name: rke2-server
      state: restarted
    remote_user: root

  - name: Wait for all nodes to be ready again
    kubernetes.core.k8s_info:
      api_version: v1
      kind: Node
      namespace: default
    register: nodes
    until: nodes.resources is defined and nodes.resources | length == ansible_managed.inventory.all_hosts | length
    retries: 30
    delay: 10

  - name: Uncordon the node {{ rke2_node_name }}
    kubernetes.core.k8s:
      state: present
      api_version: apps/v1
      kind: DaemonSet
      name: kube-proxy
      namespace: kube-system
      uncordon_node: true
      node_name: "{{ rke2_node_name }}"
    when: rke2_drain_node_during_upgrade

  - name: Wait for all pods to be ready again
    kubernetes.core.k8s_info:
      api_version: v1
      kind: Pod
      namespace: default
    register: pods
    until: pods.resources is defined and pods.resources | length == ansible_managed.inventory.all_hosts | length
    retries: 30
    delay: 10
    when: rke2_wait_for_all_pods_to_be_ready

  - name: Wait for all pods to pass readiness checks
    kubernetes.core.k8s_info:
      api_version: v1
      kind: Pod
      namespace: default
    register: pods_health
    until: pods_health.resources is defined and pods_health.resources | length == ansible_managed.inventory.all_hosts | length
    retries: 30
    delay: 10
    when: rke2_wait_for_all_pods_to_be_healthy


