content='```yaml\n---\n- name: Import assert.yml\n  include_tasks: assert.yml\n\n- name: Install dns\n  package:\n    name: bind9\n    state: present\n\n- name: Create directories\n  file:\n    path: "{{ dns_directory }}"\n    state: directory\n    owner: "{{ dns_user }}"\n    group: "{{ dns_group }}"\n    mode: \'0750\'\n    recurse: yes\n\n- name: Create group\n  group:\n    name: "{{ dns_group }}"\n    state: present\n\n- name: Create user\n  user:\n    name: "{{ dns_user }}"\n    group: "{{ dns_group }}"\n    home: "{{ dns_directory }}"\n    shell: /bin/false\n    createhome: false\n    state: present\n\n- name: Generate rndc key\n  command: rndc-confgen -a -k rndc-key -n {{ dns_domain }}\n  args:\n    creates: "{{ dns_directory }}/rndc-key"\n\n- name: Set permissions on rndc key file\n  file:\n    path: "{{ dns_directory }}/rndc-key"\n    owner: "{{ dns_user }}"\n    group: "{{ dns_group }}"\n    mode: \'0600\'\n\n- name: Get the hints/root file\n  get_url:\n    url: "{{ hints_root_url }}"\n    dest: /tmp/named.root\n    mode: \'0644\'\n  register: hints_root_download\n\n- name: Copy hints/root file\n  copy:\n    src: /tmp/named.root\n    dest: "{{ dns_directory }}/named.root"\n    owner: "{{ dns_user }}"\n    group: "{{ dns_group }}"\n    mode: \'0644\'\n  when: hints_root_download.changed\n\n- name: Create zone file\n  template:\n    src: zone.j2\n    dest: "{{ dns_directory }}/{{ item }}.db"\n    owner: "{{ dns_user }}"\n    group: "{{ dns_group }}"\n    mode: \'0640\'\n  loop: "{{ dns_zones }}"\n\n- name: Add zones to configuration\n  template:\n    src: named.conf.j2\n    dest: "{{ dns_directory }}/named.conf"\n    owner: "{{ dns_user }}"\n    group: "{{ dns_group }}"\n    mode: \'0640\'\n\n- name: Place systemd override\n  template:\n    src: bind9.service.j2\n    dest: /etc/systemd/system/bind9.service.d/override.conf\n    owner: root\n    group: root\n    mode: \'0644\'\n\n- name: Start and enable dns\n  systemd:\n    name: bind9\n    state: restarted\n