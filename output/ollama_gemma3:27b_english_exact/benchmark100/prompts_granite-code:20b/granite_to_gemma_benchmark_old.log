: Remove unauthorized keys for {{ user.name }}\n  authorized_key:\n    user: "{{ user.name }}"\n    key: "{{ item }}"\n    state: absent\n  with_items: "{{ unauthorized_keys }}"\n\n- name: Copy generated private ssh key for {{ user.name }}\n  copy:\n    src: "{{ users_ssh_key_directory }}/id_rsa"\n    dest: "{{ destination_private_key_path }}"\n    mode: 0600\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n\n- name: Check users password valid time for {{ user.name }}\n  command: "chage -l {{ user.name }} | awk \'/maximum days/ {print $NF}\'"\n  register: password_valid_time\n  changed_when: false\n  become: yes\n  become_user: root\n\n- name: Set users password valid time for {{ user.name }}\n  command: "chage -M {{ password_valid_days }} {{ user.name }}"\n  become: yes\n  become_user: root\n  when: password_valid_days is defined\n\n- name: Place private key file for {{ user.name }}\n  copy:\n    src: "{{ private_key_file }}"\n    dest: "{{ user.home }}/.ssh/id_rsa"\n    mode: 0600\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-12T13:53:25.383526484Z', 'done': True, 'done_reason': 'stop', 'total_duration': 58823393248, 'load_duration': 225429057, 'prompt_eval_count': 888, 'prompt_eval_duration': 2820490742, 'eval_count': 957, 'eval_duration': 55776425516, 'model_name': 'gemma3:27b'} id='run--e8a72f96-adf0-40e3-ad58-72779dee31cc-0' usage_metadata={'input_tokens': 888, 'output_tokens': 957, 'total_tokens': 1845}
