---

- name: Install cron
  ansible.builtin.package:
    name: cron
    state: present

- name: Configure shell
  ansible.builtin.lineinfile:
    path: /etc/crontab
    line: SHELL=/bin/bash
    state: present

- name: Configure path
  ansible.builtin.lineinfile:
    path: /etc/crontab
    line: PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    state: present

- name: Configure mailto
  ansible.builtin.lineinfile:
    path: /etc/crontab
    line: MAILTO=root
    state: present

- name: Start and enable cron
  ansible.builtin.service:
    name: cron
    state: started
    enabled: true

- name: Schedule requested cron jobs
  ansible.builtin.cron:
    name: "Custom cron jobs"
    job: "echo 'This is a custom cron job'"
    minute: "*"
    hour: "*"
    day: "*"
    month: "*"
    weekday: "*"


