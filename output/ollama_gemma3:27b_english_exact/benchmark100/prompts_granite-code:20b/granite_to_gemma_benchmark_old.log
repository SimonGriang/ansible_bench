---
- name: Install Keepalived when HA mode is enabled
  package:
    name: keepalived
    state: present
  when: ha_mode_enabled

- name: Download and install RKE2 {{ rke2_version }}
  block:
    - name: Download RKE2
      get_url:
        url: "https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/rke2.tar.gz"
        dest: /tmp/rke2.tar.gz
    - name: Install RKE2
      command:
        cmd: "tar -xzf /tmp/rke2.tar.gz -C /usr/local/bin rke2"
      args:
        creates: /usr/local/bin/rke2
  
- name: CIS Hardening
  import_tasks: cis_hardening.yml

- name: Find Active Server
  command: kubectl get pods -n kube-system -l component=kube-apiserver -o jsonpath='{.items[0].status.podIP}'
  register: active_server
  changed_when: false

- name: Enable IPVS kernel module
  modprobe:
    name: ipvs
    state: present

- name: Copy kube-vip manifests to the masternode
  copy:
    src: files/kube-vip/
    dest: /tmp/kube-vip/
    remote_src: yes

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: files/ingress-nginx/
    dest: /tmp/ingress-nginx/
    remote_src: yes

- name: Prepare very first server node in the cluster
  import_tasks: prepare_first_server.yml

- name: Restore etcd specific tasks
  import_tasks: restore_etcd.yml
  when: restore_options

- name: Download kubeconfig to ansible localhost
  command: kubectl config view --minify --output='$' > kubeconfig
  delegate_to: localhost
  run_once: true

- name: Prepare and join remaining nodes of the cluster
  import_tasks: prepare_remaining_nodes.yml

- name: Rolling cordon and drain restart when version changes - servers
  import_tasks: rolling_restart_servers.yml
  when: version_changed

- name: Rolling cordon and drain restart when version changes - agents
  import_tasks: rolling_restart_agents.yml
  when: version_changed

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  import_tasks: rolling_restart_config_change.yml

- name: Final steps
  import_tasks: final_steps.yml


