---

  - name: Ensure unzip package is available
    package:
      name: unzip
      state: present

  - name: Create promtail group
    group:
      name: promtail
      state: present

  - name: Create the promtail user
    user:
      name: promtail
      group: promtail
      state: present

  - name: Ensure /usr/local/bin exists
    file:
      path: /usr/local/bin
      state: directory
      mode: '0755'

  - name: Create config directories
    file:
      path: /etc/promtail
      state: directory
      mode: '0755'
      owner: promtail
      group: promtail

  - name: Create application dirs
    file:
      path: /var/lib/promtail
      state: directory
      mode: '0755'
      owner: promtail
      group: promtail

  - name: Check promtail binary
    stat:
      path: /usr/local/bin/promtail
    register: promtail_binary

  - name: Download promtail binaries
    get_url:
      url: https://github.com/grafana/loki/releases/download/v2.9.0/promtail-linux-amd64.tar.gz
      dest: /tmp/promtail-linux-amd64.tar.gz
    when: promtail_binary.stat.exists == false

  - name: Propagate locally distributed promtail archive
    copy:
      src: /tmp/promtail-linux-amd64.tar.gz
      dest: /tmp/promtail-linux-amd64.tar.gz

  - name: Download promtail binaries to controller node
    get_url:
      url: https://github.com/grafana/loki/releases/download/v2.9.0/promtail-linux-amd64.tar.gz
      dest: /tmp/promtail-linux-amd64.tar.gz

  - name: Propagate promtail binaries
    copy:
      src: /tmp/promtail-linux-amd64.tar.gz
      dest: /var/lib/promtail/promtail-linux-amd64.tar.gz

  - name: Unpack promtail binaries
    unarchive:
      src: /var/lib/promtail/promtail-linux-amd64.tar.gz
      dest: /var/lib/promtail
      remote_src: yes

  - name: Create symlink to latest version
    file:
      src: /var/lib/promtail/promtail-linux-amd64/promtail
      dest: /usr/local/bin/promtail
      state: link
      force: yes

  - name: Write config
    template:
      src: promtail.conf.j2
      dest: /etc/promtail/promtail.conf
      owner: promtail
      group: promtail

  - name: Create systemd service unit
    template:
      src: promtail.service.j2
      dest: /etc/systemd/system/promtail.service
      owner: root
      group: root


