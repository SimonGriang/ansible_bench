---

- name: check if all variables have been set correctly
  assert:
    that:
      - my_variable is defined
    fail_msg: "my_variable is not defined"
    success_msg: "All variables are defined"

- name: wait for host (when configured)
  wait_for:
    host: "{{ ansible_host }}"
    port: 22
    timeout: 5
  when: ansible_host is defined

- name: prepare system
  block:
    - name: test connection
      ping:

    - name: install bootstrap packages (Debian/Ubuntu)
      apt:
        name:
          - curl
          - python3
          - python3-pip
        state: present
      when: ansible_os_family == "Debian"

    - name: install bootstrap packages (RedHat/CentOS/AlmaLinux/Rocky Linux)
      yum:
        name:
          - curl
          - python3
          - python3-pip
        state: present
