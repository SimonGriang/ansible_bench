      path: /etc/promtail
      state: directory
      mode: '0755'
      owner: promtail
      group: promtail

  - name: Create application dirs
    file:
      path: /var/lib/promtail
      state: directory
      mode: '0755'
      owner: promtail
      group: promtail

  - name: Check promtail binary
    stat:
      path: /usr/local/bin/promtail
    register: promtail_binary

  - name: Download promtail binaries
    get_url:
      url: https://github.com/grafana/loki/releases/download/v2.9.0/promtail-linux-amd64.tar.gz
      dest: /tmp/promtail-linux-amd64.tar.gz
    when: promtail_binary.stat.exists == false

  - name: Propagate locally distributed promtail archive
    copy:
      src: /tmp/promtail-linux-amd64.tar.gz
      dest: /tmp/promtail-linux-amd64.tar.gz

