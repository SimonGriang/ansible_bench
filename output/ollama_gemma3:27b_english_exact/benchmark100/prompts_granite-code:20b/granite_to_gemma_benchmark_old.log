---

- name: lookup bootstrap facts
  command: cat /etc/os-release
  register: os_release_output
  changed_when: false

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_distribution_major_version: "{{ item.key }}"
  loop: "{{ os_release_output.stdout_lines | dict }}"
  when: "'VERSION_ID' in os_release_output.stdout_lines"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  loop:
    - { 'key': 'ID', 'value': 'debian' }
    - { 'key': 'ID', 'value': 'ubuntu' }
    - { 'key': 'ID', 'value': 'centos' }
    - { 'key': 'ID', 'value': 'rhel' }
    - { 'key': 'ID', 'value': 'fedora' }
    - { 'key': 'ID', 'value': 'suse' }
  when: os_release_output.stdout | regex_search('ID=')
