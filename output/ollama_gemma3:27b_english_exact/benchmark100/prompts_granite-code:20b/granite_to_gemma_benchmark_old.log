---

- name: Import assert.yml
  include_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  apt:
    name: systemd-logger
    state: absent
  become: true
  when: ansible_distribution == "Ubuntu" or ansible_distribution == "Debian"

- name: Install rsyslog
  apt:
    name: rsyslog
    state: present
  become: true
  when: ansible_distribution == "Ubuntu" or ansible_distribution == "Debian"

- name: Install additional rsyslog packages
  apt:
    name:
      - rsyslog-gnutls
      - rsyslog-relp
    state: present
  become: true
  when: ansible_distribution == "Ubuntu" or ansible_distribution == "Debian"

- name: Configuring default rsyslog
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
  become: true
  notify: restart rsyslog

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d
    state: directory
    owner: root
    group: root
    mode: 0755
  become: true

- name: Configuring rsyslog forward rule
  template:
    src: forward.conf.j2
    dest: /etc/rsyslog.d/forward.conf
  become: true
  notify: restart rsyslog

- name: Configuring additional config files
  template:
    src: additional.conf.j2
    dest: /etc/rsyslog.d/additional.conf
  become: true
  notify: restart rsyslog

- name: Start and enable rsyslog
  service:
    name: rsyslog
    state: started
    enabled: true
  become: true


