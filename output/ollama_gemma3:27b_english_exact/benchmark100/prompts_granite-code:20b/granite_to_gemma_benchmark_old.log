---

- name: Create the RKE2 config dir
  file:
    path: /etc/rke2/
    state: directory
    mode: '0755'

- name: Set server taints
  when: inventory_hostname in groups['rke2_servers']
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: PodDisruptionBudget
      metadata:
        name: rke2-server-pdb
        labels:
          app: rke2
      spec:
        minAvailable: 1
        selector:
          matchLabels:
            app: rke2

- name: Set agent taints
  when: inventory_hostname in groups['rke2_agents']
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: PodDisruptionBudget
      metadata:
        name: rke2-agent-pdb
        labels:
          app: rke2
      spec:
        minAvailable: 1
        selector:
          matchLabels:
            app: rke2

- name: Copy RKE2 config
  copy:
    src: rke2.yaml
    dest: /etc/rke2/rke2.yaml
    owner: root
    group: root
    mode: '0644'

- name: Copy kubelet config
  when: kubelet_config.stat.exists
  copy:
    src: "{{ kubelet_config.path }}"
    dest: /etc/kubernetes/kubelet.conf
    owner: root
    group: root
    mode: '0644'
  register: kubelet_config
  stat:
    path: "{{ kubelet_config_path }}"

- name: Copy Containerd Registry Configuration file
  when: custom_registry_used
  copy:
    src: containerd_mirror.json
    dest: /etc/containerd/mirror.json
    owner: root
    group: root
    mode: '0644'

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2-server
    state: started
    enabled: yes
  when: inventory_hostname not in groups['rke2_servers']

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: rke2-agent
    masked: yes
  when: inventory_hostname not in groups['rke2_servers']

- name: Wait for remaining nodes to be ready - no CNI
  when: not cni_used and inventory_hostname not in groups['rke2_servers']
  wait_for:
    path: /var/run/rke2/server/node.local
    timeout: 300

- name: Wait for remaining nodes to be ready - with CNI
  when: cni_used and inventory_hostname not in groups['rke2_servers']
  wait_for:
    path: /var/run/rke2/server/node.local
    timeout: 300


