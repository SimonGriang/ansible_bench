---
- name: Disable swap
  swapoff:
    path: all

- name: Disable core dumps
  shell:
    command: ulimit -c 0
    executable: /bin/bash

- name: Disable Shell Command History
  lineinfile:
    path: /etc/bash.bashrc
    regexp: 'HISTSIZE='
    line: 'HISTSIZE=0'
    create: yes
  notify:
    - restart bash
  
- name: Disable Shell Command History
  lineinfile:
    path: /etc/profile
    regexp: 'HISTSIZE='
    line: 'HISTSIZE=0'
    create: yes
  notify:
    - restart bash

- name: restart bash
  meta: flush_handlers
  
- name: restart bash
  shell: source /etc/bash.bashrc
  ignore_errors: yes
  changed_when: false


