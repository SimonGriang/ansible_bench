---
- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ users_ssh_key_directory }}"
    mode: 0750
    state: directory

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    state: present
    comment: "{{ user.comment }}"
    shell: "{{ user.shell }}"
    home: "{{ user.home }}"
    create_home: "{{ user.create_home }}"

- name: Set sudo options for {{ user.name }}
  template:
    src: sudoers.d.j2
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: 0440
    validate: visudo -cf %s
  when: sudo_options is defined

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  command: "{{ ssh_keygen_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/id_rsa"
  become: yes
  become_user: "{{ user.name }}"

- name: Generate public ssh key for {{ user.name }}
  command: "{{ ssh_keygen_pubkey_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/id_rsa.pub"
  become: yes
  become_user: "{{ user.name }}"

- name: Convert ssh key to ppk for {{ user.name }}
  command: "{{ ssh_keygen_pubkey_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/id_rsa.ppk"
  become: yes
  become_user: "{{ user.name }}"

- name: Get or set the home directory for {{ user.name }}
  command: "getent passwd {{ user.name }} | cut -d: -f6"
  register: user_home
  changed_when: false
  become: yes
  become_user: root
  
- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user.home }}/.ssh"
    mode: 0700
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
    state: directory

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  with_items: "{{ authorized_keys }}"

- name: Remove unauthorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  with_items: "{{ unauthorized_keys }}"

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ users_ssh_key_directory }}/id_rsa"
    dest: "{{ destination_private_key_path }}"
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.name }}"

- name: Check users password valid time for {{ user.name }}
  command: "chage -l {{ user.name }} | awk '/maximum days/ {print $NF}'"
  register: password_valid_time
  changed_when: false
  become: yes
  become_user: root

- name: Set users password valid time for {{ user.name }}
  command: "chage -M {{ password_valid_days }} {{ user.name }}"
  become: yes
  become_user: root
  when: password_valid_days is defined

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ private_key_file }}"
    dest: "{{ user.home }}/.ssh/id_rsa"
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.name }}"


