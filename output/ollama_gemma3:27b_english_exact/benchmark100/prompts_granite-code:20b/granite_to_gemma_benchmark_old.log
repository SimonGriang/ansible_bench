---
- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ git_username }}"
  register: user_exists

- name: Create directory for git configuration
  ansible.builtin.file:
    path: "/home/{{ git_username }}/.gitconfig"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0700'

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0600'

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0700'

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ item }}"
    dest: "{{ repository_destination }}"
    user: "{{ git_username }}"
  loop: "{{ git_repositories }}"


