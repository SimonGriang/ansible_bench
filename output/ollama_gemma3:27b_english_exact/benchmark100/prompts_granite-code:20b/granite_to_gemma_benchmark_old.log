---

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install prerequisites
  ansible.builtin.package:
    name:
      - unzip
      - curl
    state: present

- name: Include installation method specific tasks
  ansible.builtin.include_tasks:
    file: "{{ vault_type }}/install.yml"
    vars:
      vault_url: "{{ vault_url }}"
      vault_token: "{{ vault_token }}"

- name: Add Vault environment variables
  ansible.builtin.lineinfile:
    path: /etc/environment
    line: "export VAULT_ADDR={{ vault_url }}"
    create: yes
    state: present

- name: Add Vault environment variables
  ansible.builtin.lineinfile:
    path: /etc/environment
    line: "export VAULT_TOKEN={{ vault_token }}"
    create: yes
    state: present

- name: Include hardening tasks
  ansible.builtin.include_tasks:
    file: hardening.yml

- name: Start and enable vault
  ansible.builtin.service:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable vault
  ansible.builtin.service:
    name: vault
    state: started
  when: vault_type != "oss"


