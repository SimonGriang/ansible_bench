---
- name: Create the RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: PodDisruptionBudget
      metadata:
        name: rke2-pdb
        labels:
          app: rke2
      spec:
        minAvailable: 1
        selector:
          matchLabels:
            app: rke2
  when: rke2_server_node_taints is defined and rke2_server_node_taints != ""

- name: Copy rke2 config
  copy:
    src: "{{ rke2_config_file }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0600'

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_file }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0600'
  when: rke2_kubelet_config is defined and rke2_kubelet_config != ""

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_file }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0600'
  when: rke2_custom_registry_mirrors is defined or rke2_custom_registry_configs is defined

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != "" and ansible_service_mgr == 'systemd' and ansible_facts['service_rke2_server'] is defined and ansible_facts['service_rke2_server'].status.ActiveState != 'active'

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_s3_options.access_key is defined
    - rke2_etcd_snapshot_s3_options.secret_key is defined
    - rke2_etcd_snapshot_s3_options.bucket is defined
    - rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rke2/etcd/snapshots
        state: directory
        mode: '0755'

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rke2/etcd/snapshots/snapshot.db
        mode: '0644'

    - name: Restore etcd from snapshot
      command: "rke2 etcd snapshot restore"
  when: do_etcd_restore is defined and do_etcd_restore

- name: Restore etcd from s3
  block:
    - name: Restore etcd from s3
      command: "rke2 server --restore-from-s3"
      environment:
        RKE2_S3_ACCESS_KEY: "{{ rke2_etcd_snapshot_s3_options.access_key }}"
        RKE2_S3_SECRET_KEY: "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
        RKE2_S3_BUCKET: "{{ rke2_etcd_snapshot_s3_options.bucket }}"
        RKE2_S3_SNAPSHOT_NAME: "{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
  when: do_etcd_restore_from_s3 is defined and do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server
    state: started
    enabled: yes
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent
    masked: yes
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - no CNI
  wait_for:
    host: 127.0.0.1
    port: 10250
    delay: 10
    timeout: 600
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - with CNI
  wait_for:
    host: 127.0.0.1
    port: 10250
    delay: 10
    timeout: 600
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Restore etcd
  block:
    - name: Remove old <node>.node-password.rke2 secrets
      file:
        path: "/var/lib/rke2/secrets/{{ inventory_hostname }}.node-password.rke2"
        state: absent

    - name: Remove old nodes
      command: "rke2 server --remove-old-nodes"

    - name: Restore etcd
      command: "rke2 server --restore-etcd"
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ groups['rke2_cluster_group_name'][0] }}"
  run_once: true
