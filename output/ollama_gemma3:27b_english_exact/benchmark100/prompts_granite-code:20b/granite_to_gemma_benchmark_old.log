---
- name: Configure apk
  import_tasks: assert.yml

- name: Configure apk
  community.general.apk:
    update_cache: true

- name: Configure apk
  community.general.apk:
    upgrade: all

- name: Configure apt
  ansible.builtin.apt:
    pin:
      name: "*"
      version: "0.1"
      release: ""
      priority: "-1"
    state: present

- name: Configure apt
  ansible.builtin.apt:
    upgrade: dist
    update_cache: true

- name: Configure apt
  ansible.builtin.apt:
    autoremove: true

- name: Update all software (dnf)
  ansible.builtin.dnf:
    update_only: true

- name: Update all software (pacman)
  community.general.pacman:
    update_cache: true
    upgrade: true

- name: Update all software (yum/6)
  ansible.builtin.yum:
    name: "*"
    state: latest
  when: ansible_distribution_major_version == "6"

- name: Update yum non-6
  ansible.builtin.yum:
    name: "*"
    state: latest
  when: ansible_distribution_major_version != "6"

- name: Configure yum
  ansible.builtin.yum:
    name: yum-utils
    state: present

- name: Update all software (zypper)
  community.general.zypper:
    name: "*"
    state: latest
    update_cache: true


