---
- name: Install cron
  ansible.builtin.package:
    name: cron
    state: present

- name: Configure shell
  ansible.builtin.lineinfile:
    path: /etc/crontab
    line: SHELL=/bin/bash
    state: present

- name: Configure path
  ansible.builtin.lineinfile:
    path: /etc/crontab
    line: PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    state: present

- name: Configure mailto
  ansible.builtin.lineinfile:
    path: /etc/crontab
    line: MAILTO=""
    state: present

- name: Start and enable cron
  ansible.builtin.service:
    name: cron
    state: started
    enabled: true

- name: Schedule requested cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    user: "{{ item.user }}"
    job: "{{ item.job }}"
    state: present
  loop: "{{ cron_jobs }}"


