---
- name: Restart RKE2 service on {{ rke2_node_name }}
  systemd:
    name: rke2-server
    state: restarted

- name: Wait for all nodes to be ready again
  kubernetes.core.k8s:
    kubeconfig: "{{ kubeconfig }}"
    api_version: v1
    kind: Node
    namespace: default
    state: present
  register: nodes
  until: nodes.resources | length == var_node_count
  retries: 10
  delay: 5

- name: Wait for all pods to be ready again
  kubernetes.core.k8s:
    kubeconfig: "{{ kubeconfig }}"
    api_version: v1
    kind: Pod
    namespace: all
    state: present
  register: pods
  until: pods.resources | selectattr('status.phase', 'in', ['Running', 'Succeeded']) | list | length == var_pod_count
  retries: 20
  delay: 5


