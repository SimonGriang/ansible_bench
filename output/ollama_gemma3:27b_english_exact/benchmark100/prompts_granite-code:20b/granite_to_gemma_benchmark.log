---
  - name: Update apt cache
    apt:
      update_cache: yes
    become: yes
    when: ansible_os_family == "Debian"

  - name: Update dnf cache
    dnf:
      update_cache: yes
    become: yes
    when: ansible_os_family == "RedHat"

  - name: Install packages
    package:
      name: keepalived
      state: present
    become: yes

  - name: Create directory for keepalived
    file:
      path: /etc/keepalived
      state: directory
      owner: root
      group: root
      mode: '0755'
    become: yes

  - name: Create Kubernetes API health check script for Debian OS family
    copy:
      dest: /usr/local/bin/k8s_api_health_check.sh
      content: |
        #!/bin/bash
        kubectl get pods -n kube-system | grep -q kube-apiserver
        exit $?
    mode: '0755'
    when: ansible_os_family == "Debian"
    become: yes

  - name: Create Kubernetes API health check script for RedHat OS famliy
    copy:
      dest: /usr/local/bin/k8s_api_health_check.sh
      content: |
        #!/bin/bash
        kubectl get pods -n kube-system | grep -q kube-apiserver
        exit $?
    mode: '0755'
    when: ansible_os_family == "RedHat"
    become: yes

  - name: Create RKE2 Server health check script for Debian OS family
    copy:
      dest: /usr/local/bin/rke2_server_health_check.sh
      content: |
        #!/bin/bash
        systemctl is-active rke2-server
        exit $?
    mode: '0755'
    when: ansible_os_family == "Debian"
    become: yes

  - name: Create RKE2 Server health check script for RedHat OS family
    copy:
      dest: /usr/local/bin/rke2_server_health_check.sh
      content: |
        #!/bin/bash
        systemctl is-active rke2-server
        exit $?
    mode: '0755'
    when: ansible_os_family == "RedHat"
    become: yes

  - name: Create keepalived config file
    copy:
      dest: /etc/keepalived/keepalived.conf
      content: |
        vrrp_script chk_k8s_api {
          script /usr/local/bin/k8s_api_health_check.sh
          interval 2
          weight 2
        }

        vrrp_instance VI_1 {
          state MASTER
          interface eth0
          virtual_router_id 51
          priority 100
          advert_int 1
          authentication {
            auth_type PASS
            auth_pass 1111
          }
          track_script {
            chk_k8s_api
          }
        }
    become: yes

  - name: Enable keepalived and make sure it is not masked
    systemd:
      name: keepalived
      enabled: yes
      masked: no
    become: yes

  - name: Flush handlers
    meta: flush_handlers


