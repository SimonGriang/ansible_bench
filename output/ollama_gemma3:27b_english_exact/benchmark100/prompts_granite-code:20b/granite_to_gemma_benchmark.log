    name: openjdk
    state: present

- name: Install RPM
  package:
    name: rpm
    state: present

- name: Install DEB
  package:
    name: deb
    state: present

- name: Install oracle java (rpm) (repository)
  yum:
    name: oracle-java
    state: present

- name: Configure oracle targz
  shell: |
    tar -xzvf oracle-java.tar.gz -C /opt
  args:
    chdir: /tmp

- name: Install oracle java policy software (targz)
  shell: |
    tar -xzvf oracle-java-policy.tar.gz -C /opt
  args:
    chdir: /tmp

- name: Set alternative (targz)
  shell: |
    update-alternatives --install /usr/bin/java java /opt/oracle-java/bin/java 1
  ignore_errors: false

- name: Find JAVA_HOME
  shell: |
    find / -name javac -print0 | xargs -0 dirname
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    line: JAVA_HOME={{ java_home_result.stdout }}
    create: yes


