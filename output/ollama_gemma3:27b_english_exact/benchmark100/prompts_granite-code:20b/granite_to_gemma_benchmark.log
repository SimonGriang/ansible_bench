---
- name: Ensure unzip package is available
  package:
    name: unzip
    state: present

- name: Create promtail group
  group:
    name: promtail
    state: present

- name: Create the promtail user
  user:
    name: promtail
    group: promtail
    state: present

- name: Ensure /usr/local/bin exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Create application dirs
  file:
    path: /var/lib/promtail
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail

- name: Check promtail binary
  stat:
    path: /usr/local/bin/promtail
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: https://github.com/grafana/promtail/releases/latest/download/promtail-{{ ansible_architecture }}
    dest: /tmp/promtail-{{ ansible_architecture }}
  when: not promtail_binary.stat.exists

- name: Propagate locally distributed promtail archive
  copy:
    src: /tmp/promtail-{{ ansible_architecture }}
    dest: /tmp/promtail-{{ ansible_architecture }}
    remote_src: yes
  when: not promtail_binary.stat.exists

- name: Download promtail binaries to controller node
  get_url:
    url: https://github.com/grafana/promtail/releases/latest/download/promtail-{{ ansible_architecture }}
    dest: /tmp/promtail-{{ ansible_architecture }}

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail-{{ ansible_architecture }}
    dest: /tmp/promtail-{{ ansible_architecture }}
    remote_src: yes

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail-{{ ansible_architecture }}
    dest: /tmp/
    remote_src: yes

- name: Create symlink to latest version
  file:
    src: /tmp/promtail-linux-amd64
    dest: /usr/local/bin/promtail
    state: link

- name: Write config
  template:
    src: promtail.conf.j2
    dest: /etc/promtail/promtail.conf
    owner: promtail
    group: promtail

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root


