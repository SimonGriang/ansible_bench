---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install vsftpd
  ansible.builtin.apt:
    name: vsftpd
    state: present

- name: Configure vsftpd
  ansible.builtin.copy:
    src: vsftpd.conf
    dest: /etc/vsftpd.conf
    owner: root
    group: root
    mode: '0644'
  notify: Restart vsftpd

- name: Restart vsftpd
  ansible.builtin.service:
    name: vsftpd
    state: restarted


