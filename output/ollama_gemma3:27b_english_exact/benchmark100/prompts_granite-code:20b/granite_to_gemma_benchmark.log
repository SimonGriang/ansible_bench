---
- name: Ensure /etc/openvpn/easy-rsa exists
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Easyrsa init-pki
  ansible.builtin.command: /usr/share/easy-rsa/3/easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Easyrsa build-ca
  ansible.builtin.command: /usr/share/easy-rsa/3/easyrsa build-ca
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Easyrsa gen-dh
  ansible.builtin.command: /usr/share/easy-rsa/3/easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Easyrsa build-server-full server nopass
  ansible.builtin.command: /usr/share/easy-rsa/3/easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Easyrsa build-client-full client nopass
  ansible.builtin.command: /usr/share/easy-rsa/3/easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Easyrsa gen-crl
  ansible.builtin.command: /usr/share/easy-rsa/3/easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  become: true

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  become: true

- name: Copy files to /etc/openvpn/server
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/openvpn/server/
    owner: root
    group: root
    mode: '0644'
  loop:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/dh.pem
    - /etc/openvpn/easy-rsa/pki/ta.key
    - /etc/openvpn/easy-rsa/issued/client.crt
    - /etc/openvpn/easy-rsa/issued/server.crt
    - /etc/openvpn/easy-rsa/private/ca.key
    - /etc/openvpn/easy-rsa/private/client.key
    - /etc/openvpn/easy-rsa/private/server.key

- name: Copy files to /etc/openvpn
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/openvpn/
    owner: root
    group: root
    mode: '0644'
  loop:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/ta.key

- name: Place server.conf
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    owner: root
    group: root
    mode: '0644'


