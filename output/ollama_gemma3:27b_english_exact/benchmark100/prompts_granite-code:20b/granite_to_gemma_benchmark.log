    dest: /etc/rancher/rke2/config.yaml
    mode: '0600'

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_file }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0600'
  when: rke2_kubelet_config is defined and rke2_kubelet_config != ""

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_registries_file }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0600'
  when: (rke2_custom_registry_mirrors is defined and rke2_custom_registry_mirrors != "") or (rke2_custom_registry_configs is defined and rke2_custom_registry_configs != "")

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != "" and ansible_service_mgr == 'systemd' and (ansible_facts.services['rke2-server.service'].state != 'running' or ansible_facts.services['rke2-server.service'].status.ActiveState != 'active')

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rke2/etcd/snapshots
        state: directory
        mode: '0755'

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rke2/etcd/snapshots/snapshot.db
        mode: '0644'

    - name: Restore etcd from snapshot
      command: rke2 etcd snapshot restore
      changed_when: true
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  command: rke2 etcd snapshot restore --s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }} --s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }} --s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }} --s3-snapshot-name={{ rke2_etcd_snapshot_s3_options.snapshot_name }}
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server
    state: started
    enabled: yes
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent
    masked: yes
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: /var/lib/rke2/server/node-ca.crt
    timeout: 300
  when: inventory_hostname == groups['rke2_cluster_group_name'][0] and rke2_use_cni is defined and rke2_use_cni == false

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: /var/lib/rke2/server/node-ca.crt
    timeout: 300
  when: inventory_hostname == groups['rke2_cluster_group_name'][0] and (rke2_use_cni is undefined or rke2_use_cni == true)

- name: Restore etcd
  command: rke2 etcd snapshot restore
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ groups['rke2_cluster_group_name'][0] }}"
  delegate_facts: true


