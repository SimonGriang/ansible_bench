---

- name: Cordon and Drain the node {{ rke2_node_name }}
  kubernetes.core.k8s:
    kubeconfig: "{{ rke2_kubeconfig }}"
    name: "{{ rke2_node_name }}"
    state: cordoned
  when: rke2_drain_node_during_upgrade

- name: Cordon and Drain the node {{ rke2_node_name }}
  kubernetes.core.k8s:
    kubeconfig: "{{ rke2_kubeconfig }}"
    name: "{{ rke2_node_name }}"
    drain: true
  when: rke2_drain_node_during_upgrade

- name: Restart RKE2 service on {{ rke2_node_name }}
  systemd:
    name: rke2-server
    state: restarted
    daemon_reload: yes
  remote_host: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  kubernetes.core.k8s_info:
    kubeconfig: "{{ rke2_kubeconfig }}"
  register: k8s_nodes
  until: k8s_nodes.nodes | selectattr('conditions', 'find', {'type': 'Ready', 'status': 'True'}) | list | length == k8s_nodes.nodes | length
  retries: 30
  delay: 10

- name: Uncordon the node {{ rke2_node_name }}
  kubernetes.core.k8s:
    kubeconfig: "{{ rke2_kubeconfig }}"
    name: "{{ rke2_node_name }}"
    state: uncordoned
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  kubernetes.core.k8s_info:
    kubeconfig: "{{ rke2_kubeconfig }}"
    namespace: default
  register: k8s_pods
  until: k8s_pods.pods | selectattr('status.phase', 'eq', 'Running') | list | length == k8s_pods.pods | length
  retries: 30
  delay: 10
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  kubernetes.core.k8s_info:
    kubeconfig: "{{ rke2_kubeconfig }}"
    namespace: default
  register: k8s_pods
  until: k8s_pods.pods | selectattr('status.conditions', 'find', {'type': 'Ready', 'status': 'True'}) | list | length == k8s_pods.pods | length
  retries: 30
  delay: 10
  when: rke2_wait_for_all_pods_to_be_healthy


