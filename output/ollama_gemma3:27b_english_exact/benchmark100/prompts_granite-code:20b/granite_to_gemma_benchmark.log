---

- name: Create the RKE2 config dir
  file:
    path: /etc/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  command: kubectl taint nodes {{ ansible_hostname }} node-role.kubernetes.io/server=true:NoSchedule
  changed_when: true
  ignore_errors: true
  when: inventory_hostname in groups['servers']

- name: Set agent taints
  command: kubectl taint nodes {{ ansible_hostname }} node-role.kubernetes.io/agent=true:NoSchedule
  changed_when: true
  ignore_errors: true
  when: inventory_hostname in groups['agents']

- name: Copy RKE2 config
  copy:
    src: files/rke2.yaml
    dest: /etc/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'

- name: Copy kubelet config
  copy:
    src: files/kubelet.conf
    dest: /var/lib/kubelet/config.yaml
    owner: root
    group: root
    mode: '0644'
  when: lookup('file', 'files/kubelet.conf', errors='ignore') != ''

- name: Copy Containerd Registry Configuration file
  copy:
    src: files/containerd_registry.conf
    dest: /etc/containerd/config.toml.d/00-custom-registry.conf
    owner: root
    group: root
    mode: '0644'
  when: custom_registry is defined and custom_registry

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2-server
    state: started
    enabled: yes
  when: inventory_hostname not in groups['servers']

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: rke2-agent
    masked: yes
  when: inventory_hostname not in groups['servers']

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    host: "{{ ansible_hostname }}"
    port: 6443
    delay: 10
    timeout: 300
  when: inventory_hostname not in groups['servers'] and not cni_used

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    host: "{{ ansible_hostname }}"
    port: 6443
    delay: 10
    timeout: 300
  when: inventory_hostname not in groups['servers'] and cni_used


