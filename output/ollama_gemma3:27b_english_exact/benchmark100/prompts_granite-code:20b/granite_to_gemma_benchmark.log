---

- name: Install mysql
  package:
    name: mysql-server
    state: present

- name: Configure mysql server
  copy:
    src: mysql.conf.d
    dest: /etc/mysql/mysql.conf.d/
    owner: root
    group: root
    mode: '0644'
  notify: restart mysql

- name: Configure mysql client
  copy:
    src: my.cnf
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'
  notify: restart mysql

- name: Initialize mysql
  command: mysql_secure_installation
  become: yes
  changed_when: false

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  copy:
    src: my.cnf
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'
  notify: restart mysql

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop:
    - database1
    - database2

- name: List databases
  mysql_query:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    query: SHOW DATABASES;
  register: databases

- name: Import database
  shell: mysql -u root -p'{{ mysql_root_password }}' database1 < /path/to/database1.sql
  args:
    creates: /path/to/database1.sql

- name: Create users
  mysql_user:
    name: "{{ item.user }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    host: "%"
    state: present
  loop:
    - { user: 'user1', password: 'password1', priv: '*.*' }
    - { user: 'user2', password: 'password2', priv: 'database1.*' }

- name: Flush handlers again
  meta: flush_handlers


