---

  - name: create | Create ssl key
    openssl_key:
      path: "{{ ssl_key_path }}"
      size: "{{ ssl_key_size | default(2048) }}"
      type: rsa

  - name: create | Create ssl csr
    openssl_csr:
      path: "{{ ssl_csr_path }}"
      key_path: "{{ ssl_key_path }}"
      subject: "{{ ssl_subject }}"
      days: "{{ ssl_csr_days | default(365) }}"

  - name: create | Create ssl certificates
    openssl_certificate:
      path: "{{ ssl_certificate_path }}"
      csr_path: "{{ ssl_csr_path }}"
      key_path: "{{ ssl_key_path }}"
      days: "{{ ssl_certificate_days | default(365) }}"
      self_signed: true

  - name: create | Create PKCS#12 file
    openssl_pkcs12:
      path: "{{ ssl_pkcs12_path }}"
      key_path: "{{ ssl_key_path }}"
      certificate_path: "{{ ssl_certificate_path }}"
      password: "{{ ssl_pkcs12_password }}"

  - name: create | Read private key
    slurp:
      src: "{{ ssl_key_path }}"
    register: ssl_key_content

  - name: create | Read certificate
    slurp:
      src: "{{ ssl_certificate_path }}"
    register: ssl_certificate_content

  - name: create | Create combined private_key and certificate file
    copy:
      content: "{{ ssl_key_content.content }}\n{{ ssl_certificate_content.content }}"
      dest: "{{ ssl_combined_file_path }}"


