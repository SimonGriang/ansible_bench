---
- name: Stat
  ansible.builtin.stat:
    path: "{{ item }}"
  register: cert_status
  loop:
    - /path/to/certificate.pem
    - /path/to/private_key.pem

- name: Fail
  ansible.builtin.fail:
    msg: "Certificate or private key does not exist!"
  when: not cert_status.stat.exists

- name: Setting keystore variables in java < 11
  ansible.builtin.set_fact:
    keytool_alias: "{{ cert_alias }}"
  when: java_version < 11

- name: Setting keystore variables in java >= 11
  ansible.builtin.set_fact:
    keytool_alias: "{{ cert_alias }}"
  when: java_version >= 11

- name: Import SSL certificates
  community.general.java_cert:
    key_store: "{{ keystore_path }}"
    key_store_password: "{{ keystore_password }}"
    certificate: "{{ item }}"
    alias: "{{ keytool_alias }}"
  loop:
    - /path/to/certificate.pem


