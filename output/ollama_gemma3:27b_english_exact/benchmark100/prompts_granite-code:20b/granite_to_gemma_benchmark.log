      option: enabled
      value: true
    - section: [ssh]
      option: port
      value: ssh
    - section: [ssh]
      option: logpath
      value: /var/log/auth.log

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
  register: auth_log

