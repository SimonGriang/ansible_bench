---

- name: Enable redis module stream (RHEL 8)
  community.general.dnf_module_enable:
    name: redis
    state: enabled
  become: true
  when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"

- name: Install redis
  ansible.builtin.package:
    name: redis
    state: present
  become: true

- name: Configure redis
  ansible.builtin.copy:
    src: redis.conf
    dest: /etc/redis.conf
    owner: redis
    group: redis
    mode: '0644'
  become: true
  notify: restart redis

- name: Start and enable redis
  ansible.builtin.service:
    name: redis
    state: started
    enabled: true
  become: true



