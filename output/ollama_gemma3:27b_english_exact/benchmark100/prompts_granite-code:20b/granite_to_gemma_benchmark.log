---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  ansible.builtin.apt:
    name: systemd-logger
    state: absent
  become: true
  when: ansible_distribution == "Debian" or ansible_distribution == "Ubuntu"

- name: Install rsyslog
  ansible.builtin.apt:
    name: rsyslog
    state: present
  become: true
  when: ansible_distribution == "Debian" or ansible_distribution == "Ubuntu"

- name: Install additional rsyslog packages
  ansible.builtin.apt:
    name:
      - rsyslog-gnutls
      - rsyslog-relp
    state: present
  become: true
  when: ansible_distribution == "Debian" or ansible_distribution == "Ubuntu"

- name: Configuring default rsyslog
  ansible.builtin.template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
  become: true
  notify: restart rsyslog

- name: Make configuration directory
  ansible.builtin.file:
    path: /etc/rsyslog.d
    state: directory
    owner: root
    group: root
    mode: '0755'
  become: true

- name: Configuring rsyslog forward rule
  ansible.builtin.template:
    src: forward.conf.j2
    dest: /etc/rsyslog.d/forward.conf
  become: true
  notify: restart rsyslog

- name: Configuring additional config files
  ansible.builtin.copy:
    src: files/
    dest: /etc/rsyslog.d/
    owner: root
    group: root
    mode: '0644'
  become: true
  notify: restart rsyslog

- name: Start and enable rsyslog
  ansible.builtin.service:
    name: rsyslog
    state: started
    enabled: true
  become: true


