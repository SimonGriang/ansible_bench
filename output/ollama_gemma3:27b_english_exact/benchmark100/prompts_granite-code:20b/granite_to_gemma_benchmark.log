---

  - name: Install and configure Promtail
    assert:
      that: ansible_service_mgr == "systemd"
      fail_msg: "This module only works with systemd."

  - name: Retrieve the latest release of Promtail
    uri:
      url: https://api.github.com/repos/grafana/loki/releases/latest
      return_content: yes
    register: promtail_release

  - name: Set the Promtail version to the latest release
    set_fact:
      promtail_version: "{{ promtail_release.json.tag_name }}"


