---
- name: create | Create ssl key
  community.crypto.openssl_privatekey:
    path: "{{ openssl_key_directory }}/{{ item.name }}"
    mode: 0644
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ openssl_items }}"

- name: create | Create ssl csr
  community.crypto.openssl_csr:
    path: "{{ openssl_csr_directory }}/{{ item.common_name }}.csr"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}"
    common_name: "{{ item.common_name }}"
    mode: 0644
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ openssl_items }}"

- name: create | Create ssl certificates
  community.crypto.x509_certificate:
    path: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}"
    csr_path: "{{ openssl_csr_directory }}/{{ item.common_name }}.csr"
    provider: "{{ item.name }}"
    mode: 0644
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ openssl_items }}"

- name: create | Create PKCS#12 file
  community.crypto.openssl_pkcs12:
    action: export
    path: "{{ openssl_key_directory }}/{{ item.name }}.p12"
    friendly_name: "{{ item.name }}"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}"
    certificate_path: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    state: present
    mode: 0644
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ openssl_items }}"

- name: create | Read private key
  ansible.builtin.slurp:
    src: "{{ openssl_key_directory }}/{{ item.name }}"
  register: openssl_private_key
  loop: "{{ openssl_items }}"

- name: create | Read certificate
  ansible.builtin.slurp:
    src: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
  register: openssl_certifcate
  loop: "{{ openssl_items }}"

- name: create | Create combined private_key and certificate file
  ansible.builtin.copy:
    dest: "{{ openssl_key_directory }}/{{ item.name }}.pem"
    content: "{{ openssl_private_key.content | b64decode }}\n{{ openssl_certifcate.content | b64decode }}"
    mode: 0644
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ openssl_items }}"


