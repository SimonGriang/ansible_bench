- name: create directories
  ansible.builtin.file:
    path: /opt/cadvisor
    state: directory
    mode: '0755'

- name: download
  ansible.builtin.get_url:
    url: https://github.com/google/cadvisor/releases/download/v0.37.0/cadvisor-0.37.0.linux-arm64.tar.gz
    dest: /opt/cadvisor/cadvisor-0.37.0.tar.gz
    checksum: sha256:66134d860a6f690760368235395766608d908d7439654425793356e66e302f8a

- name: propagate locally distributed cadvisor binary
  ansible.builtin.copy:
    src: /home/dev/bin/cadvisor/cadvisor-0.37.0
    dest: /opt/cadvisor/cadvisor-0.37.0
    mode: '0755'

- name: symlink
  ansible.builtin.file:
    src: /opt/cadvisor/cadvisor-0.37.0
    dest: /opt/cadvisor/cadvisor
    state: link

- name: server systemd service
  ansible.builtin.template:
    src: systemd-system-cadvisor-service.j2
    dest: /etc/systemd/system/cadvisor.service

- name: test_task
  ansible.builtin.shell: systemctl is-active cadvisor.service
  register: service_active
  ignore_errors: true

- name: debug
  ansible.builtin.debug:
    var: service_active

- name: enable server systemd
  ansible.builtin.systemd:
    name: cadvisor.service
    enabled: true

- name: start server systemd
  ansible.builtin.systemd:
    name: cadvisor.service
    state: started
    daemon_reload: true


