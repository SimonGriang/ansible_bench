---

- name: Set the package state based on how Ansible is installed.
  ansible.builtin.set_fact:
    ansible_package_state: "present"
  when: ansible_pkg_mgr == "yum" or ansible_pkg_mgr == "dnf" or ansible_pkg_mgr == "apt"

- name: Set up Ansible on RedHat.
  ansible.builtin.yum:
    name: ansible
    state: "{{ ansible_package_state }}"
  when: ansible_os_family == "RedHat"

- name: Set up Ansible on Fedora.
  ansible.builtin.dnf:
    name: ansible
    state: "{{ ansible_package_state }}"
  when: ansible_distribution == "Fedora"

- name: Set up Ansible on Ubuntu.
  ansible.builtin.apt:
    name: ansible
    state: "{{ ansible_package_state }}"
    update_cache: yes
  when: ansible_distribution == "Ubuntu"

- name: Set up Ansible on Debian.
  ansible.builtin.apt:
    name: ansible
    state: "{{ ansible_package_state }}"
    update_cache: yes
  when: ansible_distribution == "Debian"

- name: Set up Ansible using Pip.
  ansible.builtin.pip:
    name: ansible
    state: present
  when: ansible_pkg_mgr is not defined or ansible_pkg_mgr == "pip"


