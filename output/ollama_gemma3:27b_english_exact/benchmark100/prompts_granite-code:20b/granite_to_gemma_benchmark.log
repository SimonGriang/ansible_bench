l_duration': 8338649431, 'eval_count': 529, 'eval_duration': 29961237120, 'model_name': 'gemma3:27b'} id='run--1894b001-f2bb-41f7-b91a-c0319fea8913-0' usage_metadata={'input_tokens': 2562, 'output_tokens': 529, 'total_tokens': 3091}
