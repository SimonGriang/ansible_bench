---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_bash_url }}"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    timeout: "{{ rke2_artifact_fetch_timeout }}"

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    force: yes

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifact_path }}"
    state: directory
    mode: 0700

- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)
  block:
    - name: Download sha256 checksum file
      get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
        mode: 0640
        timeout: "{{ rke2_artifact_fetch_timeout }}"
    - name: Download RKE2 artifacts and compare with checksums
      get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}"
        dest: "{{ rke2_artifact_path }}"
        timeout: "{{ rke2_artifact_fetch_timeout }}"
    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
        timeout: "{{ rke2_artifact_fetch_timeout }}"
  when: airgap_mode and airgap_implementation == 'download'

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item }}"
    mode: 0640
    force: yes
  loop:
    - rke2
    - rke2-images
  when: airgap_mode and airgap_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images tarballs folder
      file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: 0700
    - name: Copy additional tarball images RKE2 components
      copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"
        mode: 0644
        force: yes
  loop:
    - cri-o.tar.gz
    - containerd.tar.gz
  when: airgap_mode and rke2_tarball_images_list is defined

- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged
  block:
    - name: Register artifacts
      stat:
        path: "{{ rke2_artifact_path }}/{{ item }}"
      register: artifact_stat
    - name: Check if artifact is writeable
      fail:
        msg: "Artifact {{ rke2_artifact_path }}/{{ item }} is writeable. Please ensure correct permissions."
      when: artifact_stat.stat.mode & 0222 != 0
    - name: Make artifact read-only
      file:
        path: "{{ rke2_artifact_path }}/{{ item }}"
        mode: 0640
      when: artifact_stat.stat.mode & 0222 != 0
    - name: Check if install script is writeable and not executable
      fail:
        msg: "Install script is writeable but not executable."
      when: artifact_stat.stat.path == "{{ rke2_install_script_dir }}/rke2.sh" and artifact_stat.stat.mode & 0222 != 0 and artifact_stat.stat.mode & 0111 == 0
    - name: Make install script executable
      file:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
      when: artifact_stat.stat.path == "{{ rke2_install_script_dir }}/rke2.sh" and artifact_stat.stat.mode & 0222 != 0 and artifact_stat.stat.mode & 0111 == 0
  loop:
    - rke2
    - rke2-images
    - "{{ rke2_install_script_dir }}/rke2.sh"
  when: airgap_mode and airgap_implementation == 'exists'

- name: Populate service facts
  setup:
    filter: ansible_service_units

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Check if separate partition
  set_fact:
    separate_partition: "{{ ansible_mounts | selectattr('mount', 'equalto', '/usr/local') | list | length == 0 }}"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin/rke2
  when: separate_partition

- name: Check RKE2 version
  command: rke2 --version
  register: rke2_version_check
  ignore_errors: true

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_version_check.rc == 0
      - rke2_version_check.stdout is version_compare(rke2_version, rke2_version_check.stdout)
    msg: "Attempted to downgrade RKE2.  Please verify version compatibility."

- name: Run RKE2 install script
  command: "{{ rke2_install_script_dir }}/rke2.sh --{{ rke2_type }} --airgap {{ rke2_airgap_variables }}"
  args:
    creates: /etc/rke2/config.yaml

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_custom_manifests }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_static_pods }}"

- name: Copy RKE2 environment file
  template:
    src: rke2_environment.j2
    dest: /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: 0644


