---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Configure postfix (transport_maps)
  lineinfile:
    path: /etc/postfix/transport_maps
    line: "example.com smtp:[127.0.0.1]"
    create: yes

- name: Configure postfix (header_checks)
  lineinfile:
    path: /etc/postfix/header_checks
    line: "^Subject:.*spam.*"
    create: yes

- name: "Setting values for main.cf (1/2)"
  lineinfile:
    path: /etc/postfix/main.cf
    regexp: "^myhostname ="
    line: "myhostname = mail.example.com"
    create: yes

- name: "Setting values for main.cf (2/2)"
  lineinfile:
    path: /etc/postfix/main.cf
    regexp: "^mydomain ="
    line: "mydomain = example.com"
    create: yes

- name: Configure postfix (main.cf)
  lineinfile:
    path: /etc/postfix/main.cf
    regexp: "^myorigin ="
    line: "myorigin = $mydomain"
    create: yes

- name: Creates cert/key directory
  file:
    path: /etc/postfix/ssl
    state: directory
    mode: '0755'

- name: Deploy Postfix TLS server certificate
  copy:
    src: files/tls/server.crt
    dest: /etc/postfix/ssl/server.crt
    mode: '0644'

- name: Deploy Postfix TLS server key
  copy:
    src: files/tls/server.key
    dest: /etc/postfix/ssl/server.key
    mode: '0600'

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/aliases
    regexp: "^postmaster:"
    line: "postmaster: root"
    create: yes

- name: Configure sender_access
  lineinfile:
    path: /etc/postfix/sender_access
    line: "user@example.com DISCARD"
    create: yes

- name: Configure recipient_access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: "user@example.com REJECT"
    create: yes

- name: Place sasl_password_map
  copy:
    src: files/sasl_password_map
    dest: /etc/postfix/sasl_password_map
    mode: '0600'

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes


