---

  - name: Import assert.yml
    include_tasks: assert.yml

  - name: Install dns
    package:
      name: bind9
      state: present

  - name: Create directories
    file:
      path: "{{ dns_directory }}"
      state: directory
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: '0755'

  - name: Create group
    group:
      name: "{{ dns_group }}"
      state: present

  - name: Create user
    user:
      name: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      home: "{{ dns_directory }}"
      shell: /bin/false
      createhome: false
      state: present

  - name: Generate rndc key
    command: rndc-confgen -a -k rndc-key -n .
    args:
      creates: /etc/bind/rndc.key

  - name: Set permissions on rndc key file
    file:
      path: /etc/bind/rndc.key
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: '0640'

  - name: Get the hints/root file
    get_url:
      url: "{{ hints_root_url }}"
      dest: /etc/bind/named.root
      mode: '0644'

  - name: Create zone file
    template:
      src: zone.j2
      dest: "{{ dns_directory }}/{{ item }}.db"
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: '0644'
    loop: "{{ dns_zones }}"

  - name: Add zones to configuration
    template:
      src: named.conf.j2
      dest: /etc/bind/named.conf.local
      owner: "{{ dns_owner }}"
      group: "{{ dns_group }}"
      mode: '0644'

  - name: Place systemd override
    template:
      src: bind9.service.j2
      dest: /etc/systemd/system/bind9.service.d/override.conf
      owner: root
      group: root
      mode: '0644'

  - name: Start and enable dns
    systemd:
      name: bind9
      state: restarted
      enabled: yes


