    owner: root
    group: root
    mode: 0640
    remote_src: yes

- name: Configure fail2ban.local
  ini_file:
    path: /etc/fail2ban/fail2ban.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    state: present
  loop:
    - section: DEFAULT
      option: ignoreip
      value: 127.0.0.1/8
    - section: DEFAULT
      option: bantime
      value: 600
    - section: DEFAULT
      option: findtime
      value: 600
    - section: DEFAULT
      option: maxretry
      value: 3

