ration': 27554879963, 'model_name': 'gemma3:27b'} id='run--4a0f6ac2-a6a7-4190-825d-6250e27e37e6-0' usage_metadata={'input_tokens': 2115, 'output_tokens': 486, 'total_tokens': 2601}
