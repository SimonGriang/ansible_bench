      shell: kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' | grep -c "True"
      delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
      retries: 100
      delay: 15
      register: all_ready_nodes
      until: all_ready_nodes.stdout == "{{ rke2_node_count }}"
      run_once: true
      when: ansible_check_mode == false

    - name: Wait for all pods to be ready again
      shell: kubectl get pods --all-namespaces -o jsonpath='{.items[?(@.status.phase!="Running" && @.status.phase!="Succeeded")].metadata.name}' | wc -l
      delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
      retries: 100
      delay: 15
      register: all_pods_ready
      until: all_pods_ready.stdout == "0"
      run_once: true
      when:
        - ansible_check_mode == false
        - rke2_wait_for_all_pods_to_be_ready


