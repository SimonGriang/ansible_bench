---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install the mysql package
  ansible.builtin.package:
    name: mysql
    state: present

- name: Configure the mysql server
  ansible.builtin.copy:
    dest: "{{ mysql_name }}-server.cnf"
    content: "{{ mysql_configuration_options | join('\n') }}"

- name: Configure the mysql client
  ansible.builtin.copy:
    dest: "{{ mysql_name }}-client.cnf"
    content: "[client]\nsocket = {{ mysql_socket }}"

- name: Initialize the mysql service
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ["Alpine", "Archlinux"]
  changed_when: true

- name: Start and enable the mysql service
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Create a my.cnf file in the /root/.my.cnf directory
  ansible.builtin.template:
    path: /root/.my.cnf
    src: my.cnf.j2
    mode: '0644'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: List databases on the target machine
  community.mysql.mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    host: "{{ item.host }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


