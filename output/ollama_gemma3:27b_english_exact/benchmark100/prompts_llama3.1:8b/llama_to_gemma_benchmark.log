---
- name: Import assert.yml task
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install using package task
  block:
    - name: Install repository for RedHat task
      yum_repository:
        name: hashicorp
        description: HashiCorp Repository
        baseurl: https://rpm.releases.hashicorp.com/
        gpgcheck: yes
        gpgkey: https://rpm.releases.hashicorp.com/gpg
      when: ansible_os_family == "RedHat"

    - name: Configure Debian task
      block:
        - name: Install required package gpg task
          apt_get:
            name: gnupg
            state: present
          become: true

        - name: Install apt key for Debian task
          apt_key:
            url: https://releases.hashicorp.com/gpg
            state: present
          become: true

        - name: Install repository for Debian task
          apt_repository:
            repo: deb https://releases.hashicorp.com/ {{ ansible_distribution_release }} main
            state: present
            filename: hashicorp
          become: true
      when: ansible_os_family == "Debian"

    - name: Install hashicorp product using package task
      block:
        - name: Install latest hashicorp product using package task
          package:
            name: "{{ hashicorp_product }}"
            state: latest
          become: true

        - name: Install versioned hashicorp product using package task
          package:
            name: "{{ hashicorp_product }}-{{ hashicorp_version }}"
            state: present
          become: true
      when: installation_method == "package"
  when: installation_method == "package"

- name: Install manually task
  block:
    - name: Download and unpack the Hashicorp product
      unarchive:
        src: "{{ hashicorp_download_url }}"
        dest: /tmp/
        remote_src: yes
        creates: /tmp/{{ hashicorp_product }}
      when: installation_method == "manual"
  when: installation_method == "manual"


