      get_url:
        url: https://github.com/google/cadvisor/releases/download/v0.8.3/cadvisor_0.8.3_linux_amd64.tar.gz
        dest: /tmp/cadvisor_0.8.3_linux_amd64.tar.gz
        checksum: sha256:f9f14a8a1d84327e1b7a766341144293666178365e779c72e89883044e311b73
