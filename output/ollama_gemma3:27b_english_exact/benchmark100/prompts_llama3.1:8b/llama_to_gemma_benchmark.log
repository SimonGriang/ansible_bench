inux\n      package:\n        name: container-selinux\n        state: present\n\n    - name: Install containerd.io\n      package:\n        name: containerd.io\n        state: present\n' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-13T13:09:26.624615207Z', 'done': True, 'done_reason': 'stop', 'total_duration': 40502536685, 'load_duration': 191430378, 'prompt_eval_count': 1276, 'prompt_eval_duration': 4207242975, 'eval_count': 632, 'eval_duration': 36102589567, 'model_name': 'gemma3:27b'} id='run--3c131251-9f8b-4c4c-8a94-abbc0d76413e-0' usage_metadata={'input_tokens': 1276, 'output_tokens': 632, 'total_tokens': 1908}
