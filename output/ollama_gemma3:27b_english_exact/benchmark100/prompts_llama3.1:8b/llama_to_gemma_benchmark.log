---

  - name: Create an SSL private key
    openssl_privatekey:
      path: /etc/ssl/private/example.key
      size: 2048
      state: present
      owner: root
      group: root
      mode: 0600

  - name: Create an SSL Certificate Signing Request (CSR)
    openssl_csr:
      path: /etc/ssl/example.csr
      private_key: /etc/ssl/private/example.key
      state: present
      owner: root
      group: root
      mode: 0600
      country_name: US
      state_name: California
      locality_name: San Francisco
      organization_name: Example Inc
      organizational_unit_name: IT Department
      common_name: example.com
      email_address: admin@example.com

  - name: Create an SSL certificate
    x509_certificate:
      path: /etc/ssl/example.crt
      private_key: /etc/ssl/private/example.key
      csr: /etc/ssl/example.csr
      state: present
      owner: root
      group: root
      mode: 0600

  - name: Create a PKCS#12 file
    openssl_pkcs12:
      path: /etc/ssl/example.p12
      private_key: /etc/ssl/private/example.key
      certificate: /etc/ssl/example.crt
      state: present
      owner: root
      group: root
      mode: 0600

  - name: Read the private key
    slurp:
      src: /etc/ssl/private/example.key
    register: private_key_content

  - name: Read the certificate
    slurp:
      src: /etc/ssl/example.crt
    register: certificate_content

  - name: Create a combined private key and certificate file
    copy:
      dest: /etc/ssl/example.pem
      content: "{{ private_key_content.content }}\n{{ certificate_content.content }}"
      owner: root
      group: root
      mode: 0644


