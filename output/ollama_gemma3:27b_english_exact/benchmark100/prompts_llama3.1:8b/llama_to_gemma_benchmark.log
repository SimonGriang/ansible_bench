---
- name: Install Keepalived when HA mode is enabled
  include_playbook: keepalived.yml
  when: ha_mode_enabled and rke2_servers_group

- name: Download and install RKE2 {{ rke2_version }}
  include_playbook: rke2.yml

- name: CIS Hardening
  include_playbook: cis.yml
  when: cis_profile is defined

- name: Find Active Server
  include_playbook: find_active_server.yml

- name: Enable IPVS kernel module
  modprobe:
    name: ipvs
    state: present
  when: ha_mode_enabled and ipvs_lb_enabled and rke2_servers_group

- name: Copy kube-vip manifests to the masternode
  include_playbook: kubevip.yml
  when: ha_mode_enabled and ipvs_lb_enabled and rke2_servers_group and inventory_hostname == groups['rke2_servers_group'][0]

- name: Copy ingress-nginx manifests to the masternode
  include_playbook: ingress-nginx.yml
  when: ingress_nginx_values is defined and rke2_servers_group and inventory_hostname == groups['rke2_servers_group'][0]

- name: Prepare very first server node in the cluster
  include_playbook: first_server.yml
  when: (active_server is not defined or cluster_size == 1) and rke2_servers_group and inventory_hostname == groups['rke2_servers_group'][0]

- name: Restore etcd specific tasks
  include_playbook: first_server_restore.yml
  when: active_server is defined and (inventory_hostname == groups['rke2_servers_group'][0] or inventory_hostname == groups['rke2_servers_group'][-1]) and etcd_restore_required

- name: Download kubeconfig to ansible localhost
  include_playbook: download_kubeconfig.yaml
  when: kubeconfig_download_required and rke2_servers_group and inventory_hostname == groups['rke2_servers_group'][0]

- name: Prepare and join remaining nodes of the cluster
  include_playbook: remaining_nodes.yml
  when: active_server is defined and cluster_size > 1

- name: Rolling cordon and drain restart when version changes - servers
  include_playbook: rolling_restart.yml
  loop: "{{ rke2_servers_group }}"
  when: version_changed and rke2_installed

- name: Rolling cordon and drain restart when version changes - agents
  include_playbook: rolling_restart.yml
  loop: "{{ rke2_agent_group }}"
  when: version_changed and rke2_installed

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  include_playbook: change_config.yml
  loop: "{{ rke2_servers_group + rke2_agent_group }}"
  when: config_files_changed and rke2_restart_required

- name: Final steps
  include_playbook: summary.yml


