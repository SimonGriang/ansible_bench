---
- name: Enable specific Apache2 modules
  community.general.apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  when: ansible_os_family in ["Debian", "Suse"]

- name: Configure Apache2 locations
  template:
    src: location.conf.j2
    dest: "{{ httpd_config_dir }}/{{ item.name }}.conf"
    mode: 0644
    label: "{{ item.name }}"
  loop: "{{ httpd_locations }}"
  notify:
    - test httpd
    - restart httpd


