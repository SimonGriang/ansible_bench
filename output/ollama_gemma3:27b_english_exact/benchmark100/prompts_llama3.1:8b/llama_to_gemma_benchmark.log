- name: Import assert.yml and run it once on localhost
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install the dns packages
  ansible.builtin.package:
    name: bind9
    state: present

- name: Create the required directories
  ansible.builtin.file:
    path: /var/named
    state: directory
    owner: bind
    group: bind
    mode: '0755'

- name: Create the required group
  ansible.builtin.group:
    name: bind
    state: present

- name: Create the required user
  ansible.builtin.user:
    name: bind
    group: bind
    system: yes
    createhome: no

- name: Generate the rndc key
  ansible.builtin.command:
    cmd: rndc-confgen -a -k rndc-key
    creates: /etc/rndc.key

- name: Set permissions on the rndc key file
  ansible.builtin.file:
    path: /etc/rndc.key
    owner: bind
    group: bind
    mode: '0640'

- name: Download the named.root file
  ansible.builtin.get_url:
    url: https://data.dns.google/dns/named.root
    dest: /var/named/named.root
    owner: bind
    group: bind
    mode: '0644'

- name: Create the zone file
  ansible.builtin.template:
    src: zone.j2
    dest: /var/named/db.example.com
    owner: bind
    group: bind
    mode: '0644'

- name: Add zones to the configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: /etc/bind/named.conf.local
    owner: bind
    group: bind
    mode: '0644'

- name: Place the systemd override
  ansible.builtin.copy:
    src: bind.service.j2
    dest: /etc/systemd/system/bind9.service.d/override.conf
  notify: Reload systemd daemon

- name: Start and enable the DNS service
  ansible.builtin.systemd:
    name: bind9
    state: started
    enabled: yes


