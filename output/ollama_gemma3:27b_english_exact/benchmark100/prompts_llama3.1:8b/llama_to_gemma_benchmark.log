---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install the MySQL package
  package:
    name: mysql-server
    state: present
  notify:
    - set root password
    - systemctl daemon-reexec

- name: Configure the MySQL server
  ini_file:
    path: "{{ mysql_server_cnf }}"
    section: mysqld
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    state: present
  loop: "{{ mysql_configuration_options }}"
  notify:
    - restart mysql

- name: Configure the MySQL client
  ini_file:
    path: "{{ mysql_client_cnf }}"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    state: present

- name: Initialize the MySQL database
  shell: "{{ mysql_initialize_command }}"
  when: mysql_initialize_command is defined

- name: Start and enable the MySQL service
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

