    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Remove old Docker apt source list
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Uninstall old versions of Docker
  apt:
    name:
      - docker
      - docker-engine
      - docker.io
    state: absent
    purge: true

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker.list.old
    state: absent

- name: Install required dependencies
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: yes

- name: Add or remove Docker repository
  block:
    - name: Add Docker repository
      apt_repository:
        repo: deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian bookworm stable
        state: present
        filename: docker
    - name: Update apt cache
      apt:
        update_cache: yes
  when: docker_add_repo

- name: Notify apt update handler
  meta: flush_handlers


