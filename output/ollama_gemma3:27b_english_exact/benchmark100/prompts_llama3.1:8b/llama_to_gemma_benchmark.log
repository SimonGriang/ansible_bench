m }}"\n    port: 6443\n    state: started\n    timeout: 600\n  loop: "{{ groups[\'rke2_nodes\'] }}"\n  retries: 30\n  delay: 10\n  when: inventory_hostname == groups[\'rke2_nodes\'][0] or inventory_hostname == groups[\'rke2_nodes\'][1]\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-13T15:44:13.779782228Z', 'done': True, 'done_reason': 'stop', 'total_duration': 51084920607, 'load_duration': 9420269653, 'prompt_eval_count': 790, 'prompt_eval_duration': 2454103247, 'eval_count': 752, 'eval_duration': 39209784629, 'model_name': 'gemma3:27b'} id='run--1a21b246-bc15-4048-ba2c-09a13e3f6f90-0' usage_metadata={'input_tokens': 790, 'output_tokens': 752, 'total_tokens': 1542}
