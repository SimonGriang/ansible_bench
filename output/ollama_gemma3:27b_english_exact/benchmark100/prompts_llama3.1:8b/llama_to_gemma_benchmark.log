---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Set server taints
  kubernetes.core.k8s:
    state: present
    definition:
      apiVersion: v1
      kind: Node
      metadata:
        name: "{{ inventory_hostname }}"
        labels:
          node-role.kubernetes.io/server: ""
      spec:
        taints:
          - key: "rke2-server"
            value: "{{ rke2_server_node_taints }}"
            effect: NoSchedule
  when: "'server' in group_names"

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: 0600
  notify: "Config file changed"

- name: Copy kubelet config
  copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: 0600
  notify: "Config file changed"
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: 0600
  notify: "Config file changed"
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

- name: Register etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file | length > 0 and ansible_facts['service_exists']('rke2-server.service') is undefined or ansible_facts['service_status']('rke2-server.service') is undefined or ansible_facts['service_status']('rke2-server.service') is disabled

- name: Register etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file | length > 0 and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rke2/etcd/snapshots
        state: directory
        owner: root
        group: root
        mode: 0755

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rke2/etcd/snapshots/snapshot.db
        owner: root
        group: root
        mode: 0644

    - name: Restore etcd from snapshot
      command: rke2 etcd snapshot restore
  when: do_etcd_restore

- name: Restore etcd from s3
  block:
    - name: Restore etcd from s3 snapshot
      command: rke2 etcd snapshot restore --s3-options='{"access_key":"{{ rke2_etcd_snapshot_s3_options.access_key }}", "secret_key":"{{ rke2_etcd_snapshot_s3_options.secret_key }}", "bucket":"{{ rke2_etcd_snapshot_s3_options.bucket }}", "snapshot_name":"{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"}'
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server
    state: started
    enabled: true
    daemon_reload: true
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  notify: "Service (re)started"
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent
    masked: true
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - no CNI
  command: kubectl get nodes -o wide
  register: kubectl_output
  until: "'Ready' in kubectl_output.stdout and 'CNI' not in kubectl_output.stdout"
  retries: 60
  delay: 10
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - with CNI
  command: kubectl get nodes -o wide
  register: kubectl_output
  until: "'Ready' in kubectl_output.stdout"
  retries: 60
  delay: 10
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Restore etcd
  meta:
    end_host: true
  block:
    - name: Remove old secrets and nodes
      command: kubectl delete secrets -A
      ignore_errors: true

    - name: Remove old nodes
      command: kubectl delete node --grace-period=0 --force
      ignore_errors: true

    - name: Create new nodes
      command: kubectl apply -f /etc/rancher/rke2/nodes.yaml
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  with_items: "{{ groups['rke2_cluster_group_name'] }}"


