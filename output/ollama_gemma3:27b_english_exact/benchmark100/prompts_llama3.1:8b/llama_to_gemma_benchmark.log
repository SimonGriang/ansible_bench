---
- name: Import Java Asserts and Setup Local Task Execution
  include_tasks: assert.yml
  run_once: true

- name: Install Bash
  package:
    name: bash
    state: present

- name: Install OpenJDK Java (Package)
  package:
    name: openjdk-8-jdk
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM (Local Java Source)
  copy:
    src: "{{ java_rpm_package }}"
    dest: /tmp/{{ java_rpm_package }}
  when: java_source == "local" and java_format == "rpm"

- name: Install RPM (Local Java Source)
  package:
    name: /tmp/{{ java_rpm_package }}
    state: present
  when: java_source == "local" and java_format == "rpm"

- name: Install DEB (Local Java Source)
  copy:
    src: "{{ java_deb_package }}"
    dest: /tmp/{{ java_deb_package }}
  when: java_source == "local" and java_format == "deb"

- name: Install DEB (Local Java Source)
  apt:
    deb: /tmp/{{ java_deb_package }}
    state: present
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java (RPM) (Repository)
  package:
    name: oracle-java
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Targz
  file:
    path: "{{ java_install_directory }}"
    state: directory
    mode: '0755'
  when: java_format == "targz" and java_vendor == "oracle"

- name: Configure Oracle Targz
  unarchive:
    src: "{{ java_targz_package }}"
    dest: "{{ java_install_directory }}"
    remote_src: yes
    creates: "{{ java_install_directory }}/{{ java_targz_package | regex_replace('.tar.gz$', '') }}"
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java Policy Software (Targz)
  unarchive:
    src: "{{ java_jce_package }}"
    dest: "{{ java_install_directory }}"
    remote_src: yes
    creates: "{{ java_install_directory }}/{{ java_jce_package | regex_replace('.tar.gz$', '') }}"
  when: java_jce is defined and java_jce and java_version == "8" and java_vendor == "oracle"

- name: Set Alternative (Targz)
  alternatives:
    name: java
    path: "{{ java_install_directory }}/bin/java"
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Set Alternative (Targz)
  alternatives:
    name: javac
    path: "{{ java_install_directory }}/bin/javac"
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  shell: "readlink -f /usr/bin/java | sed 's/\/bin\/java//'"
  register: java_home_output

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME="{{ java_home_output.stdout }}"'
    create: yes
    state: present


