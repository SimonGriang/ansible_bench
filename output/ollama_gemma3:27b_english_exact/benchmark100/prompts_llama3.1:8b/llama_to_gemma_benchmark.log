    password_expiration: "{{ user_password_expiration }}"

- name: Set up the user's sudo options
  ansible.builtin.template:
    src: sudoers.j2
    dest: "/etc/sudoers.d/{{ user_name }}"
    mode: '0440'
  when: sudo_options is defined

- name: Remove sudo configuration file
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ user_name }}"
    state: absent
  when: sudo_options is not defined

- name: Generate the user's private SSH key
  ansible.builtin.command: "ssh-keygen -t rsa -N '' -f {{ ssh_key_dir }}/id_rsa"
  args:
    creates: "{{ ssh_key_dir }}/id_rsa"
  when: ssh_key_management

- name: Generate the user's public SSH key
  ansible.builtin.command: "ssh-keygen -t rsa -N '' -f {{ ssh_key_dir }}/id_rsa -Y"
  args:
    creates: "{{ ssh_key_dir }}/id_rsa.pub"
  when: ssh_key_management

- name: Convert the user's SSH key to PPK format
  ansible.builtin.command: "ssh-keygen -p -f {{ ssh_key_dir }}/id_rsa -m PEM"
  args:
    creates: "{{ ssh_key_dir }}/id_rsa.ppk"
  when: ssh_key_management

- name: Get or set the user's home directory
  ansible.builtin.setup:
    filter: ansible_facts.users
  register: user_facts
  delegate_to: localhost
  run_once: true

- name: Create the user's .ssh directory
  ansible.builtin.file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Deploy authorized keys for the user
  ansible.posix.authorized_key:
    user: "{{ user_name }}"
    key: "{{ item }}"
    state: present
  with_items: "{{ authorized_keys }}"

- name: Remove unauthorized keys for the user
  ansible.posix.authorized_key:
    user: "{{ user_name }}"
    key: "{{ item }}"
    state: absent
  with_items: "{{ unauthorized_keys }}"

- name: Copy the generated private SSH key for the user
  ansible.builtin.copy:
    src: "{{ ssh_key_dir }}/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0400'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"
  when: copy_private_key

- name: Check the user's password validity
  ansible.builtin.command: "chage -l {{ user_name }}"
  register: users_pw_valid
  ignore_errors: true

- name: Set the user's password validity
  ansible.builtin.command: "chage -d {{ password_valid_days }} {{ user_name }}"
  when: password_validity is defined and users_pw_valid.rc != 0

- name: Place the private key file for the user
  ansible.builtin.copy:
    src: "{{ ssh_key_dir }}/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0400'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"
  when: private_keys is defined


