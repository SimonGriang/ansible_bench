- name: Create the directory for RKE2 manifests
  file:
    path: /var/lib/rke2/manifests
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy kube-vip YAML files to the RKE2 manifests directory
  copy:
    src: templates/kube-vip.yaml.j2
    dest: /var/lib/rke2/manifests/kube-vip.yaml
    remote_src: yes

- name: Copy kube-vip load balancer manifests to the RKE2 manifests directory
  copy:
    src: templates/kube-vip-loadbalancer.yaml.j2
    dest: /var/lib/rke2/manifests/kube-vip-loadbalancer.yaml
    remote_src: yes
  when: rke2_kubevip_cloud_provider_enable


