---
- name: Restore etcd node names
  kubernetes.core.k8s:
    command: get nodes
    output_format: json
  register: node_names_result

- name: Set node_names variable
  set_fact:
    node_names: "{{ node_names_result.resources | map(attribute='metadata.name') | list }}"

