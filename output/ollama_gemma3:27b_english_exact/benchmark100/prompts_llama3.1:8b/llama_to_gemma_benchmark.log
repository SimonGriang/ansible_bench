---
- name: Import necessary tasks for package manager assert
  import_tasks: assert.yml

- name: Configure package management for package manager apk
  apk:
    update_cache: yes
    upgrade: yes

- name: Configure package management for package manager apt
  apt:
    prevent_upgrades:
      - kernel*
    upgrade: yes
    autoremove: yes

- name: Update all software for package manager dnf
  dnf:
    name: '*'
    exclude:
      - kernel*
    state: latest

- name: Update all software for package manager pacman
  pacman:
    update_cache: yes
    upgrade: yes

- name: Configure package management for package manager yum
  block:
    - name: Ensure yum-utils is installed for non-6 yum versions
      yum:
        name: yum-utils
        state: present
      when: ansible_distribution_major_version != "6"

    - name: Update all software using dnf
      dnf:
        name: '*'
        state: latest
  when: ansible_distribution == "CentOS" or ansible_distribution == "RedHat"

- name: Update all software for package manager zypper
  zypper:
    name: '*'
    state: latest


