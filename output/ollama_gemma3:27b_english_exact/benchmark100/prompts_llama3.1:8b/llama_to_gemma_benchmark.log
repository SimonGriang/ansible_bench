---
- name: Update the package cache on systems that use apt
  apt:
    update_cache: yes
  become: yes
  when: ansible_pkg_mgr == "apt"

- name: Update the package cache on systems that use dnf
  dnf:
    update_cache: yes
  become: yes
  when: ansible_pkg_mgr == "dnf"

- name: Install the keepalived package
  package:
    name: keepalived
    state: present
  become: yes

- name: Create the /etc/keepalived directory with the correct permissions
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: 0755
  become: yes

- name: Create the Kubernetes API health check script for Debian-based systems
  copy:
    dest: /etc/keepalived/check_apiserver.sh
    content: |
      #!/bin/bash
      set -e
      
      # Check if kubectl is installed
      if ! command -v kubectl &> /dev/null; then
        echo "kubectl is not installed."
        exit 1
      fi
      
      # Attempt to get the version from the Kubernetes API
      kubectl version --client > /dev/null 2>&1
      
      if [ $? -eq 0 ]; then
        echo "Kubernetes API is healthy."
        exit 0
      else
        echo "Kubernetes API is unhealthy."
        exit 1
      fi
    mode: 0755
  become: yes
  when: ansible_os_family == "Debian"

- name: Create the Kubernetes API health check script for RHEL-based systems
  copy:
    dest: /usr/libexec/keepalived/check_apiserver.sh
    content: |
      #!/bin/bash
      set -e
      
      # Check if kubectl is installed
      if ! command -v kubectl &> /dev/null; then
        echo "kubectl is not installed."
        exit 1
      fi
      
      # Attempt to get the version from the Kubernetes API
      kubectl version --client > /dev/null 2>&1
      
      if [ $? -eq 0 ]; then
        echo "Kubernetes API is healthy."
        exit 0
      else
        echo "Kubernetes API is unhealthy."
        exit 1
      fi
    mode: 0755
  become: yes
  when: ansible_os_family == "RedHat"

- name: Create the RKE2 Server health check script for Debian-based systems
  copy:
    dest: /etc/keepalived/check_rke2server.sh
    content: |
      #!/bin/bash
      set -e

      # Check if curl is installed
      if ! command -v curl &> /dev/null; then
        echo "curl is not installed."
        exit 1
      fi

      # Check if the RKE2 server is reachable
      if curl -s --fail http://localhost:6443 > /dev/null; then
        echo "RKE2 server is healthy."
        exit 0
      else
        echo "RKE2 server is unhealthy."
        exit 1
      fi
    mode: 0755
  become: yes
  when: ansible_os_family == "Debian"

- name: Create the RKE2 Server health check script for RHEL-based systems
  copy:
    dest: /usr/libexec/keepalived/check_rke2server.sh
    content: |
      #!/bin/bash
      set -e

      # Check if curl is installed
      if ! command -v curl &> /dev/null; then
        echo "curl is not installed."
        exit 1
      fi

      # Check if the RKE2 server is reachable
      if curl -s --fail http://localhost:6443 > /dev/null; then
        echo "RKE2 server is healthy."
        exit 0
      else
        echo "RKE2 server is unhealthy."
        exit 1
      fi
    mode: 0755
  become: yes
  when: ansible_os_family == "RedHat"

- name: Create the keepalived configuration file
  copy:
    dest: /etc/keepalived/keepalived.conf
    content: |
      vrrp_instance VI_1 {
          state MASTER
          interface eth0
          virtual_router_id 51
          priority 100
          advert_int 1
      }
    mode: 0644
  become: yes

- name: Enable the keepalived service and ensure it is not masked
  systemd:
    name: keepalived
    enabled: yes
    masked: no
  become: yes

- name: Flush the handlers to execute any pending tasks
  meta: flush_handlers
