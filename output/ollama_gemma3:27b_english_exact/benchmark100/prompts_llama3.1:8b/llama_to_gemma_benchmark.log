---
- name: Import and run assert.yml
  import_playbook: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install the required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: "Gather facts"

- name: Flush the handlers
  meta: flush_handlers

- name: Configure selinux
  when: connection != "container" and connection != "docker" and connection != "community.docker.docker"
  block:
    - name: Manage selinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: "Reboot"

    - name: Manage selinux booleans
      when: selinux_booleans is defined
      selinux_boolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistence: "{{ item.persistence }}"
      loop: "{{ selinux_booleans }}"
