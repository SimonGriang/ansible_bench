- name: Create the /etc/keepalived directory with the correct permissions
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: 0755
  become: yes

- name: Create the Kubernetes API health check script for Debian-based systems
  copy:
    dest: /etc/keepalived/check_apiserver.sh
    content: |
      #!/bin/bash
      set -e
      if ! kubectl get pods --all-namespaces | grep -q running; then
        exit 1
      else
        exit 0
      fi
    owner: root
    group: root
    mode: 0755
  become: yes
  when: ansible_os_family == "Debian"

- name: Create the Kubernetes API health check script for RHEL-based systems
  copy:
    dest: /usr/libexec/keepalived/check_apiserver.sh
    content: |
      #!/bin/bash
      set -e
      if ! kubectl get pods --all-namespaces | grep -q running; then
        exit 1
      else
        exit 0
      fi
    owner: root
    group: root
    mode: 0755
  become: yes
  when: ansible_os_family == "RedHat"

- name: Create the RKE2 Server health check script for Debian-based systems
  copy:
    dest: /etc/keepalived/check_rke2server.sh
    content: |
      #!/bin/bash
      set -e
      if ! systemctl is-active rke2-server; then
        exit 1
      else
        exit 0
      fi
    owner: root
    group: root
    mode: 0755
  become: yes
  when: ansible_os_family == "Debian"

- name: Create the RKE2 Server health check script for RHEL-based systems
  copy:
    dest: /usr/libexec/keepalived/check_rke2server.sh
    content: |
      #!/bin/bash
      set -e
      if ! systemctl is-active rke2-server; then
        exit 1
      else
        exit 0
      fi
    owner: root
    group: root
    mode: 0755
  become: yes
  when: ansible_os_family == "RedHat"

- name: Create the keepalived configuration file
  copy:
    dest: /etc/keepalived/keepalived.conf
    content: |
      vrrp_script chk_apiserver {
        script /etc/keepalived/check_apiserver.sh
        interval 2
        weight 2
      }
      vrrp_instance VI_1 {
        state MASTER
        interface eth0
        virtual_router_id 51
        priority 100
        advert_int 1
        authentication {
          auth_type PASS
          auth_pass 1111
        }
        track_script {
          chk_apiserver
        }
      }
  become: yes

- name: Enable the keepalived service and ensure it is not masked
  systemd:
    name: keepalived
    enabled: yes
    masked: no
  become: yes

- name: Flush the handlers to execute any pending tasks
  meta: flush_handlers


