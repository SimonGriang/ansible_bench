---

  - name: Import external tasks for assertion handling
    import_tasks: assert.yml

  - name: Install the cron package
    package:
      name: "{{ cron_packages }}"
      state: present

  - name: Configure shell settings for cron jobs
    lineinfile:
      path: /etc/crontab
      regexp: '^SHELL='
      line: "SHELL={{ cron_shell }}"

  - name: Configure the system path for cron jobs
    lineinfile:
      path: /etc/crontab
      regexp: '^PATH='
      line: "PATH={{ cron_path }}"

  - name: Configure the mail-to setting for cron jobs
    lineinfile:
      path: /etc/crontab
      regexp: '^MAILTO='
      line: "MAILTO={{ cron_mailto }}"

  - name: Start and enable the cron service
    service:
      name: "{{ cron_service }}"
      state: started
      enabled: true

  - name: Schedule cron jobs
    cron:
      name: "{{ item.name }}"
      minute: "{{ item.minute }}"
      hour: "{{ item.hour }}"
      day: "{{ item.day }}"
      month: "{{ item.month }}"
      weekday: "{{ item.weekday }}"
      user: "{{ item.user }}"
      job: "{{ item.job }}"
      state: present
    loop: "{{ cron_jobs }}"


