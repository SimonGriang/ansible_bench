- name: Install EPEL package repository
  ansible.builtin.command:
    cmd: "yum install -y epel-release"
  become: true
  when: ansible_distribution in ["Amazon", "RedHat"] and ansible_distribution_major_version in ["7", "8", "9", "10"]

- name: Install the EPEL GPG key
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present
  become: true

- name: Install the EPEL-release package
  ansible.builtin.package:
    name: "{{ epel_url }}"
    state: present
  become: true
  notify: Update package cache

- name: Install the EPEL-next-release package (conditional)
  ansible.builtin.package:
    name: "{{ epel_next_url }}"
    state: present
  become: true
  when: epel_next
  notify: Update package cache


