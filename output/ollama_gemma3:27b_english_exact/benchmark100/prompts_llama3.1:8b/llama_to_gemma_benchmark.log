---
- name: Cordon and Drain the node with the specified RKE2 node name.
  shell: "{{ rke2_data_path }}/kubectl cordon {{ rke2_node_name }}"
  retries: 100
  delay: 15
- name: Cordon and Drain the node with the specified RKE2 node name.
  shell: "{{ rke2_data_path }}/kubectl drain {{ rke2_node_name }} {{ rke2_drain_additional_args }}"
  retries: 100
  delay: 15

- name: Restart the RKE2 service on the specified node.
  systemd:
    name: "{{ rke2_service_name }}"
    state: restarted

- name: Wait for all nodes to be ready again.
  shell: "{{ rke2_data_path }}/kubectl get nodes -o wide --field-selector status.ready=true -n {{ rke2_cluster_group_name }}"
  retries: 100
  delay: 15
  register: node_ready_check
  until: node_ready_check.rc == 0

- name: Uncordon the specified RKE2 node.
  shell: "{{ rke2_data_path }}/kubectl uncordon {{ rke2_node_name }}"
  retries: 100
  delay: 15

- name: Wait for all pods to be ready again.
  shell: "{{ rke2_data_path }}/kubectl get pods --all-namespaces -o wide"
  retries: 100
  delay: 15
  register: pod_ready_check
  until: pod_ready_check.rc == 0

- name: Wait for all pods to pass readiness checks.
  shell: "{{ rke2_data_path }}/kubectl wait --for=condition=ready pod --all --namespace={{ rke2_cluster_group_name }} {{ rke2_wait_for_all_pods_to_be_healthy_args }}"
  retries: 100
  delay: 15


