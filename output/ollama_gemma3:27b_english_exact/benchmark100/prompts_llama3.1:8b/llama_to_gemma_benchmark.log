---
- name: Create etcd group
  group:
    name: etcd
    state: present

- name: Create etcd user
  user:
    name: etcd
    group: etcd
    shell: /bin/nologin
    system: yes

- name: Copy kernel hardening config
  copy:
    src: "{{ '/usr/local/share/kernel_hardening.conf' if ansible_facts['os_family'] == 'Debian' and ansible_facts['distribution'] == 'Ubuntu' else '/etc/sysctl.d/kernel_hardening.conf' }}"
    dest: /etc/sysctl.d/kernel_hardening.conf
    owner: root
    group: root
    mode: 0644
  notify: Restart systemd-sysctl
  when: ansible_facts['os_family'] == 'Debian'

- name: Flush handlers
  meta: flush_handlers


