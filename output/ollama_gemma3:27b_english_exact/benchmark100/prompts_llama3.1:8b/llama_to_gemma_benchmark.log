---

- name: Create an SSL private key
  openssl_private_key:
    path: /etc/ssl/private/example.key
    size: 2048
    owner: root
    group: root
    mode: 0600

- name: Create an SSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/private/example.csr
    private_key: /etc/ssl/private/example.key
    common_name: example.com
    owner: root
    group: root
    mode: 0600

- name: Create SSL certificates
  openssl_certificate:
    path: /etc/ssl/certs/example.crt
    private_key: /etc/ssl/private/example.key
    csr: /etc/ssl/private/example.csr
    provider: selfsigned
    owner: root
    group: root
    mode: 0644

- name: Create a PKCS#12 file
  openssl_pkcs12:
    path: /etc/ssl/private/example.p12
    private_key: /etc/ssl/private/example.key
    certificate: /etc/ssl/certs/example.crt
    name: example.com
    owner: root
    group: root
    mode: 0600

- name: Read the private key
  slurp:
    src: /etc/ssl/private/example.key
  register: private_key_content

- name: Read the certificate
  slurp:
    src: /etc/ssl/certs/example.crt
  register: certificate_content

- name: Create a combined private key and certificate file
  copy:
    content: "{{ private_key_content.content }}\n{{ certificate_content.content }}"
    dest: /etc/ssl/private/example.pem
    owner: root
    group: root
    mode: 0644


