content='```yaml\n---\n\n- name: Import assert.yml file\n  include_tasks: assert.yml\n  run_once: true\n\n- name: Install prerequisites\n  apt:\n    name: "{{ vault_prerequisites }}"\n    state: present\n  become: true\n\n- name: Include installation method specific tasks\n  include_tasks: "{{ vault_installation_method }}.yml"\n  become: true\n\n- name: Add Vault environment variables\n  lineinfile:\n    path: /etc/vault.d/vault.env\n    line: "{{ item }}"\n    create: yes\n  loop: "{{ vault_environment_settings }}"\n  become: true\n  notify: Restart vault\n\n- name: Include hardening tasks\n  include_tasks: hardening.yml\n  become: true\n\n- name: Start and enable vault on OSS\n  systemd:\n    name: vault\n    state: started\n    enabled: yes\n  when: vault_type == "oss"\n  become: true\n\n- name: Enable vault (non-OSS)\n  systemd:\n    name: vault\n    enabled: yes\n  when: vault_type != "oss"\n  become: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-23T19:31:32.269460422Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15876234170, 'load_duration': 193504746, 'prompt_eval_count': 507, 'prompt_eval_duration': 1682408443, 'eval_count': 262, 'eval_duration': 13998964518, 'model_name': 'gemma3:27b'} id='run--f761eab5-32b1-4da5-a710-750d9162c789-0' usage_metadata={'input_tokens': 507, 'output_tokens': 262, 'total_tokens': 769}
