---
- name: Cadvisor Installation
  hosts: all
  become: true

  tasks:
    - name: Create the directories for the cadvisor installation
      file:
        path: /opt/cadvisor
        state: directory
        mode: '0755'

    - name: Download the cadvisor binary from the internet
      get_url:
        url: https://github.com/google/cadvisor/releases/download/v0.8.3/cadvisor_0.8.3_linux_amd64.tar.gz
        dest: /tmp/cadvisor_0.8.3_linux_amd64.tar.gz
        checksum: sha256:f9f14a8a1d84327e1b7a766341144293666178365e779c72e89883044e311b73
      when: not (lookup('fileglob', '/opt/cadvisor/*') | length > 0)

    - name: Extract cadvisor binary
      unarchive:
        src: /tmp/cadvisor_0.8.3_linux_amd64.tar.gz
        dest: /opt/cadvisor
        remote_src: yes
      when: not (lookup('fileglob', '/opt/cadvisor/*') | length > 0)

    - name: Copy the locally distributed cadvisor binary
      copy:
        src: files/cadvisor
        dest: /opt/cadvisor/cadvisor
        mode: '0755'
      when: lookup('fileglob', 'files/cadvisor*') | length > 0

    - name: Create a symlink to the cadvisor binary
      file:
        src: /opt/cadvisor/cadvisor
        dest: /usr/local/bin/cadvisor
        state: link

    - name: Configure the cadvisor systemd service
      template:
        src: templates/cadvisor.service.j2
        dest: /etc/systemd/system/cadvisor.service
      when: lookup('fileglob', 'files/cadvisor*') | length > 0

    - name: Test if the cadvisor service is active
      systemd:
        name: cadvisor
        state: started
      register: service_status
      ignore_errors: true

    - name: Set service_active variable
      set_fact:
        service_active: "{{ service_status.status.ActiveState == 'active' }}"

    - name: Enable the cadvisor systemd service
      systemd:
        name: cadvisor
        enabled: yes
        state: started

    - name: Start the cadvisor systemd service
      systemd:
        name: cadvisor
        state: restarted
        daemon_reload: yes


