---
- name: Import assert.yml file
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install fail2ban package
  package:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Copy fail2ban filters
  copy:
    src: "{{ fail2ban_filterd_path }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: "0640"
  when: fail2ban_filterd_path is defined
  notify: restart fail2ban

- name: Configure fail2ban.local
  copy:
    dest: /etc/fail2ban/fail2ban.local
    content: "{{ fail2ban_base_configuration | join('\n') + '\n' + fail2ban_configuration | join('\n') }}"
    owner: root
    mode: "0640"
  notify: restart fail2ban

- name: Configure jail.local
  copy:
    dest: /etc/fail2ban/jail.local
    content: "{{ fail2ban_base_jail_configuration | join('\n') + '\n' + fail2ban_jail_configuration | join('\n') }}"
    owner: root
    mode: "0640"
  notify: restart fail2ban

- name: Check the existence of the auth log file
  stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Create the auth log file if it does not exist
  file:
    path: /var/log/auth.log
    mode: "0640"
  when: fail2ban_auth.exists is not defined or not fail2ban_auth.exists

- name: Start and enable the fail2ban service
  service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: true


