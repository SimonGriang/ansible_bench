---
- name: Set the package state based on how Ansible is installed.
  ansible.builtin.set_fact:
    ansible_package_state: "installed"
  when: ansible_installation_method == "package"

- name: Set up Ansible on RedHat.
  ansible.builtin.yum:
    name:
      - python3
      - ansible
    state: present
  become: true
  when: ansible_os_family == "RedHat" and ansible_distribution != "Fedora"

- name: Set up Ansible on Fedora.
  ansible.builtin.dnf:
    name:
      - python3
      - ansible
    state: present
  become: true
  when: ansible_os_family == "RedHat" and ansible_distribution == "Fedora"

- name: Set up Ansible on Ubuntu.
  ansible.builtin.apt:
    name:
      - python3
      - ansible
    state: present
    update_cache: yes
  become: true
  when: ansible_os_family == "Debian" and ansible_distribution == "Ubuntu"

- name: Set up Ansible on Debian.
  ansible.builtin.apt:
    name:
      - python3
      - ansible
    state: present
    update_cache: yes
  become: true
  when: ansible_os_family == "Debian" and ansible_distribution != "Ubuntu"

- name: Set up Ansible using Pip.
  ansible.builtin.pip:
    name: ansible
    state: present
  become: true
  when: ansible_installation_method == "pip"


