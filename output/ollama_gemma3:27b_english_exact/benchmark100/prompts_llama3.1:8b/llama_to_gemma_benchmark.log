ason': 'stop', 'total_duration': 42950510990, 'load_duration': 230186483, 'prompt_eval_count': 576, 'prompt_eval_duration': 1575151914, 'eval_count': 591, 'eval_duration': 41144661652, 'model_name': 'gemma3:27b'} id='run--91c0cbce-a353-48c0-b205-ebba15f3cd0a-0' usage_metadata={'input_tokens': 576, 'output_tokens': 591, 'total_tokens': 1167}
