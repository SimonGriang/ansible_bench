---
- name: Restore etcd node names
  hosts: localhost
  gather_facts: false
  tasks:
    - name: Get node names
      command: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
      register: node_names_result
      changed_when: false

    - name: Set node_names variable
      set_fact:
        node_names: "{{ node_names_result.stdout.split(' ') }}"

- name: Remove old nodes from the cluster
  hosts: localhost
  gather_facts: false
  tasks:
    - name: Remove old nodes
      command: kubectl delete node {{ item }}
      loop: "{{ node_names | select('not in', groups[rke2_cluster_group_name] | default([]) ) }}"
      ignore_errors: true


