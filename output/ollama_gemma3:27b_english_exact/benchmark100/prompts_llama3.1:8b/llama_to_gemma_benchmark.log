---
- name: OpenSSL Configuration
  hosts: all
  become: true
  vars:
    openssl_requirements: []
    openssl_pip_packages: []
    openssl_key_directory: "/etc/openssl/keys"
    openssl_csr_directory: "/etc/openssl/csr"
    openssl_crt_directory: "/etc/openssl/crt"
    openssl_file_owner: "root"
    openssl_file_group: "root"
    openssl_items: []

  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Install required packages
      package:
        name: "{{ openssl_requirements }}"
        state: present

    - name: Install pip packages
      pip:
        name: "{{ openssl_pip_packages }}"
      when: openssl_pip_packages | length > 0

    - name: Create the key directory
      file:
        path: "{{ openssl_key_directory }}"
        mode: '0755'
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"
        state: directory

    - name: Create the csr directory
      file:
        path: "{{ openssl_csr_directory }}"
        mode: '0755'
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"
        state: directory

    - name: Create the crt directory
      file:
        path: "{{ openssl_crt_directory }}"
        mode: '0755'
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"
        state: directory

    - name: Include create.yml tasks
      include_tasks: create.yml
      loop: "{{ openssl_items }}"
      loop_control:
        loop_var: item
      when: openssl_items is defined and openssl_items | length > 0


