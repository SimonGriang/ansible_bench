- Last generated (faulty) playbook: 
---
- name: Import assert.yml task
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install using package task
  block:
    - name: Install repository for RedHat task
      when: ansible_os_family == "RedHat"
      yum_repository:
        name: hashicorp
        description: HashiCorp Linux Repositories
        baseurl: https://rpm.releases.hashicorp.com/
        gpgcheck: true
        gpgkey: https://rpm.releases.hashicorp.com/HAZKEY.gpg
        enabled: true

    - name: Configure Debian task
      block:
        - name: Install required package gpg
          apt_get:
            name: gnupg
            state: present
          become: true

        - name: Install apt key for Debian task
          apt_key:
            url: https://apt.releases.hashicorp.com/hashicorp.gpg.key
            state: present
          become: true

        - name: Install repository for Debian task
          apt_repository:
            repo: deb https://apt.releases.hashicorp.com/ {{ ansible_distribution }} main
            state: present
            filename: hashicorp
          become: true
      when: ansible_os_family == "Debian"

    - name: Install hashicorp product using package task
      block:
        - name: Install latest hashicorp product using package task
          package:
            name: "{{ hashicorp_product }}"
            state: latest
          become: true
          when: hashicorp_version is not defined

        - name: Install versioned hashicorp product using package task
          package:
            name: "{{ hashicorp_product }}"
            version: "{{ hashicorp_version }}"
            state: present
          become: true
          when: hashicorp_version is defined
  when: hashicorp_install_method == "package"

- name: Install manually task
  block:
    - name: Download and unpack the Hashicorp product
      unarchive:
        src: "{{ hashicorp_download_url }}"
        dest: /tmp/
        remote_src: yes
        creates: /tmp/{{ hashicorp_product }}
      when: hashicorp_install_method == "manual"
  when: hashicorp_install_method == "manual"


