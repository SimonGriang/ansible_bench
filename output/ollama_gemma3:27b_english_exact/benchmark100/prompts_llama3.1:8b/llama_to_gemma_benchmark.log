---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install the nginx package
  ansible.builtin.package:
    name: nginx
    state: present

- name: Place a customized nginx.conf file
  ansible.builtin.template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: '0644'
  register: nginx_config
  until: nginx_config.changed == false
  # validate: "nginx -t -c %s" # Removed conflicting action

- name: Ensure the /etc/nginx/conf.d directory exists
  ansible.builtin.file:
    path: /etc/nginx/conf.d
    state: directory
    mode: '0755'

- name: Place a customized default.conf file
  ansible.builtin.template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'
  notify: Restart nginx

- name: Start and enable the nginx service
  ansible.builtin.service:
    name: nginx
    state: started
    enabled: true


