---
- name: Create the document root for each vhost
  ansible.builtin.file:
    path: "{{ item.docroot }}"
    state: directory
    mode: "0755"
  when: item.docroot is defined and (item.create_docroot is not defined or
    item.create_docroot)
  loop: "{{ httpd_vhosts }}"

- name: Configure the vhosts
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ item.conf_dir }}/{{ item.name }}.conf"
    mode: "0644"
  loop: "{{ httpd_vhosts }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd


