---

- name: Import necessary tasks from assert.yml for the httpd role
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install the Apache HTTP Server on the target machine
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings for the httpd service if SELinux is enabled on the target machine
  ansible.builtin.seboolean:
    name: "{{ item }}"
    state: true
    onboot: true
  loop: "{{ httpd_sebooleans }}"
  when: ansible_selinux.enabled
  ignore_errors: true

- name: Allow connections to custom ports
  ansible.builtin.firewalld:
    port: "{{ httpd_port }}/tcp"
    permanent: true
    state: enabled
  when: ansible_os_family == "RedHat" and httpd_port is defined
  ignore_errors: true

- name: Allow connections to SSL port
  ansible.builtin.firewalld:
    port: "{{ httpd_ssl_port }}/tcp"
    permanent: true
    state: enabled
  when: ansible_os_family == "RedHat" and httpd_ssl_port is defined
  ignore_errors: true

- name: Configure the Apache HTTP Server on the target machine
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_file }}"
    owner: root
    group: root
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Activate specific Apache HTTP Server modules on Debian-based systems
  ansible.builtin.command: "a2enmod {{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == "Debian"
  notify: Test httpd configuration validity

- name: Import tasks related to SSL configuration if the https_ssl_enable variable is defined
  import_tasks: ssl.yml
  when: https_ssl_enable is defined

- name: Import tasks related to locations configuration if the httpd_locations variable is defined
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import tasks related to virtual hosts configuration if the httpd_vhosts variable is defined
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure custom ports for the Apache HTTP Server on Debian-based and Suse-based systems
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_ports_file }}"
    owner: root
    group: root
    mode: '0644'
  when: ansible_os_family in ["Debian", "Suse"]
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Import tasks related to directories configuration if the httpd_directories variable is defined
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers to ensure that any pending handlers are executed
  ansible.builtin.meta: flush_handlers

- name: Remove the default index.html file from the Apache HTTP Server's data directory
  ansible.builtin.file:
    path: "{{ httpd_default_index_html }}"
    state: absent
  when: httpd_remove_example is defined

- name: Start and enable the Apache HTTP Server service
  ansible.builtin.service:
    name: "{{ httpd_service_name }}"
    state: started
    enabled: true


