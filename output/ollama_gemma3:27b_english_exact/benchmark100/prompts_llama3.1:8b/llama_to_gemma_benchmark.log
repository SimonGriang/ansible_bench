, 'eval_count': 512, 'eval_duration': 31942769505, 'model_name': 'gemma3:27b'} id='run--19eed43b-a0e1-466c-a70b-23f4ffc327ac-0' usage_metadata={'input_tokens': 536, 'output_tokens': 512, 'total_tokens': 1048}
