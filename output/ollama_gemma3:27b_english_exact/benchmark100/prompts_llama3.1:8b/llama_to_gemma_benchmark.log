---

- name: Hardening | Disable Swap
  ansible.builtin.swapoff:
    path: all
  when: vault_hardening_disable_swap | bool

- name: Hardening | Disable Core Dumps
  community.general.pam_limits:
    limit_type: hard
    limit_item: core
    limit_value: 0
  when: vault_hardening_disable_core_dumps | bool
  loop:
    - limit_type: soft
      limit_item: core
      limit_value: 0

- name: Hardening | Disable Shell Command History
  ansible.builtin.copy:
    src: vault.sh
    dest: /etc/profile.d/
    mode: '0644'
  when: vault_hardening_disable_shell_command_history | bool

- name: Hardening | Configure SELinux / AppArmor
  ansible.builtin.package:
    name: selinux-policy
    state: present
  become: true

- name: Hardening | Configure SELinux / AppArmor
  ansible.posix.selinux:
    policy: targeted
    state: enforcing
  become: true

- name: Hardening | Configure SELinux / AppArmor
  ansible.builtin.command: aa-enforce
  become: true


