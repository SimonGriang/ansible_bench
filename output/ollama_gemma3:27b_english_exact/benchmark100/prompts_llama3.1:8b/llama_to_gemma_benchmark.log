---

- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install the apache httpd package
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: If selinux is enabled, configure it
  selinux:
    state: enabled
    policy: targeted
    sebooleans: "{{ httpd_sebooleans }}"
    port: "{{ httpd_port }}"
    ssl_port: "{{ httpd_ssl_port }}"
  when: ansible_selinux.status == 'enabled'

- name: Configure the httpd service
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"

- name: Activate the httpd module
  command: a2enmod {{ httpd_modules_to_activate_with_command }}
  when: ansible_distribution == "Debian" or ansible_distribution == "Ubuntu"

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf.j2 }}"
    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
  when: ansible_distribution == "Debian" or ansible_distribution == "Suse"

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Remove the default index.html file
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable the httpd service
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


