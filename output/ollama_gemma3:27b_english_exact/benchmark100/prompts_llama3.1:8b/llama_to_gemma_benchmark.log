content='```yaml\n---\n- name: Import assert.yml and run it once on localhost\n  include_tasks: assert.yml\n\n- name: Install the dns packages\n  package:\n    name:\n      - bind9\n      - bind9utils\n      - dnsutils\n    state: present\n\n- name: Create the required directories\n  file:\n    path: "{{ item }}"\n    state: directory\n    owner: root\n    group: root\n    mode: \'0755\'\n  loop:\n    - /etc/bind\n    - /var/cache/bind\n\n- name: Create the required group\n  group:\n    name: bind\n    state: present\n\n- name: Create the required user\n  user:\n    name: bind\n    group: bind\n    home: /var/cache/bind\n    shell: /sbin/nologin\n    createhome: false\n\n- name: Generate the rndc key\n  command: rndc-confgen -a -k rndc-key\n  args:\n    creates: /etc/rndc.key\n\n- name: Set permissions on the rndc key file\n  file:\n    path: /etc/rndc.key\n    owner: bind\n    group: bind\n    mode: \'0640\'\n\n- name: Download the named.root file\n  get_url:\n    url: https://data.iana.org/root.hints\n    dest: /var/cache/bind/named.root\n    owner: bind\n    group: bind\n    mode: \'0644\'\n\n- name: Create the zone file\n  template:\n    src: zone.j2\n    dest: /etc/bind/db.example.com\n    owner: bind\n    group: bind\n    mode: \'0644\'\n\n- name: Add zones to the configuration\n  template:\n    src: named.conf.j2\n    dest: /etc/bind/named.conf.local\n    owner: bind\n    group: bind\n    mode: \'0644\'\n\n- name: Place the systemd override\n  template:\n    src: bind9.service.j2\n    dest: /etc/systemd/system/bind9.service.d/override.conf\n  notify:\n    - reload systemd\n\n- name: Start and enable the DNS service\n  systemd:\n    name: bind9\n    state: started\n    enabled: yes\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-13T12:42:51.782902679Z', 'done': True, 'done_reason': 'stop', 'total_duration': 36393326137, 'load_duration': 208505226, 'prompt_eval_count': 1291, 'prompt_eval_duration': 4322884560, 'eval_count': 552, 'eval_duration': 31860093566, 'model_name': 'gemma3:27b'} id='run--195dfdd0-f623-4dd8-ac80-4797856ee2a9-0' usage_metadata={'input_tokens': 1291, 'output_tokens': 552, 'total_tokens': 1843}
