---
- name: Install unzip package and update cache if necessary.
  become: true
  apt:
    name: unzip
    state: present
    update_cache: "{{ promtail_apt_update_cache }}"

- name: Create promtail system group if necessary.
  become: true
  group:
    name: "{{ promtail_system_group }}"
    state: present
    system: true
  when: promtail_system_group != "root"

- name: Create the promtail system user.
  become: true
  user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    groups: "{{ promtail_user_additional_groups }}"
    system: true
    createhome: false
  when: promtail_system_user != "root"

- name: Ensure the /usr/local/bin directory exists.
  become: true
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create necessary config directories.
  become: true
  file:
    path: "{{ promtail_config_dir }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0755'

- name: Create necessary positions directories.
  become: true
  file:
    path: "{{ promtail_positions_dir }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0755'

- name: Create application directories.
  become: true
  file:
    path: "{{ promtail_install_dir }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0755'

- name: Check the existence of the promtail binary.
  stat:
    path: "{{ promtail_install_dir }}/promtail"
  register: promtail_binary_exists

- name: Download promtail binaries if necessary.
  become: true
  get_url:
    url: "{{ promtail_binary_url }}"
    dest: /tmp/promtail.zip
    mode: '0644'
  when: not promtail_binary_exists.stat.exists

- name: Propagate locally distributed promtail archive if necessary.
  become: true
  copy:
    src: "{{ promtail_local_archive }}"
    dest: /tmp/promtail.zip
    mode: '0644'
  when: promtail_local_archive is defined and promtail_local_archive

- name: Download promtail binaries to controller node if necessary.
  get_url:
    url: "{{ promtail_binary_url }}"
    dest: /tmp/promtail.zip
    mode: '0644'
  when: promtail_binary_propagate

- name: Propagate promtail binaries.
  become: true
  copy:
    src: /tmp/promtail.zip
    dest: "{{ promtail_install_dir }}/promtail.zip"
    mode: '0644'
  when: promtail_binary_propagate

- name: Unpack promtail binaries.
  become: true
  unarchive:
    src: "{{ promtail_install_dir }}/promtail.zip"
    dest: "{{ promtail_install_dir }}"
    remote_src: yes

- name: Create a symlink to the latest version.
  become: true
  file:
    src: "{{ promtail_install_dir }}/promtail"
    dest: /usr/local/bin/promtail
    state: link

- name: Write the promtail configuration.
  become: true
  template:
    src: promtail.conf.j2
    dest: "{{ promtail_config_dir }}/promtail.conf"
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0644'

- name: Create the systemd service unit.
  become: true
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0644'


