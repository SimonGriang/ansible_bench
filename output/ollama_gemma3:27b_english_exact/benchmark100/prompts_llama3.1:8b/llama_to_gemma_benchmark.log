---

  - name: Ensure old versions of Docker are not installed.
    yum:
      name:
        - docker
        - docker-engine
        - docker-common
      state: absent

  - name: Add Docker GPG key.
    rpm_key:
      key: https://download.docker.com/linux/centos/docker-ce.key
      state: present

  - name: Add Docker repository.
    yum_repository:
      name: docker-ce
      description: Docker CE Repository
      baseurl: https://download.docker.com/linux/centos/{{ ansible_distribution_major_version }}/$basearch/
      gpgcheck: yes
      gpgkey: https://download.docker.com/linux/centos/docker-ce.key

  - name: Configure Docker Nightly repo and Docker Test repo.
    yum_repository:
      name: docker-ce-nightly
      description: Docker CE Nightly Repository
      baseurl: https://download.docker.com/linux/centos/{{ ansible_distribution_major_version }}/$basearch/
      gpgcheck: yes
      gpgkey: https://download.docker.com/linux/centos/docker-ce.key
      enabled: "{{ docker_yum_repo_enable_nightly }}"
    when: docker_yum_repo_enable_nightly

  - name: Configure Docker Test repo.
    yum_repository:
      name: docker-ce-test
      description: Docker CE Test Repository
      baseurl: https://download.docker.com/linux/centos/{{ ansible_distribution_major_version }}/$basearch/
      gpgcheck: yes
      gpgkey: https://download.docker.com/linux/centos/docker-ce.key
      enabled: "{{ docker_yum_repo_enable_test }}"
    when: docker_yum_repo_enable_test

  - name: Configure containerd on RHEL 8.
    block:
      - name: Remove runc
        yum:
          name: runc
          state: absent

      - name: Install container-selinux
        yum:
          name: container-selinux
          state: present

      - name: Install containerd.io
        yum:
          name: containerd.io
          state: present
    when: ansible_distribution_major_version == "8"


