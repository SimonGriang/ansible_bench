---
- name: Install EPEL package repository for Amazon Linux 2 or RedHat-based systems.
  ansible.builtin.shell: |
    if [ "$(cat /etc/os-release | grep -i 'amazon linux')" == "amazon linux" ] || [ "$(cat /etc/redhat-release | head -n 1)" == "Red Hat Enterprise Linux" ]; then
      if [[ $(cat /etc/redhat-release | head -n 1 | cut -d'.' -f2) == "7" || $(cat /etc/redhat-release | head -n 1 | cut -d'.' -f2) == "8" || $(cat /etc/redhat-release | head -n 1 | cut -d'.' -f2) == "9" || $(cat /etc/redhat-release | head -n 1 | cut -d'.' -f2) == "10" ]]; then
        yum install -y epel-release
      fi
    fi
  become: true
  when: ansible_os_family == "RedHat"

- name: Install the EPEL GPG key.
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present
  become: true

- name: Install the EPEL-release package.
  ansible.builtin.package:
    name: "{{ epel_url }}"
    state: present
  become: true
  notify: Update package cache

- name: Install the EPEL-next-release package (conditional).
  ansible.builtin.package:
    name: "{{ epel_next_url }}"
    state: present
  become: true
  when: epel_next
  notify: Update package cache


