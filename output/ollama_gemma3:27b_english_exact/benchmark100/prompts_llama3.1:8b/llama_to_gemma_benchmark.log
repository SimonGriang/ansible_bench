---
- name: Install epel package repositories for compatible operating systems (RedHat-based and Amazon Linux)
  become: true
  package:
    name: epel-release
    state: absent
  when: ansible_os_family in ["RedHat", "Amazon"]

- name: Install the epel GPG key
  become: true
  rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install the epel-release package
  become: true
  package:
    name: epel-release
    state: present
  notify: Update package cache

- name: Install the epel-next-release package (conditional)
  become: true
  package:
    name: epel-next-release
