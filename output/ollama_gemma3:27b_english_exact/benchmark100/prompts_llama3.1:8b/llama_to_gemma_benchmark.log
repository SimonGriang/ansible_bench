 #!/bin/bash\n      set -e\n      if ! systemctl is-active rke2-server; then\n        exit 1\n      else\n        exit 0\n      fi\n    owner: root\n    group: root\n    mode: 0755\n  become: yes\n  when: ansible_os_family == "RedHat"\n\n- name: Create the keepalived configuration file\n  copy:\n    dest: /etc/keepalived/keepalived.conf\n    content: |\n      vrrp_script chk_apiserver {\n        script /etc/keepalived/check_apiserver.sh\n        interval 2\n        weight 2\n      }\n      vrrp_instance VI_1 {\n        state MASTER\n        interface eth0\n        virtual_router_id 51\n        priority 100\n        advert_int 1\n        authentication {\n          auth_type PASS\n          auth_pass 1111\n        }\n        track_script {\n          chk_apiserver\n        }\n      }\n  become: yes\n\n- name: Enable the keepalived service and ensure it is not masked\n  systemd:\n    name: keepalived\n    enabled: yes\n    masked: no\n  become: yes\n\n- name: Flush the handlers to execute any pending tasks\n  meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-13T16:01:52.632629357Z', 'done': True, 'done_reason': 'stop', 'total_duration': 55529417368, 'load_duration': 210327114, 'prompt_eval_count': 936, 'prompt_eval_duration': 3143570035, 'eval_count': 930, 'eval_duration': 52173022680, 'model_name': 'gemma3:27b'} id='run--2aa3432c-6bca-4467-b926-eed53e18cac4-0' usage_metadata={'input_tokens': 936, 'output_tokens': 930, 'total_tokens': 1866}
