---
- name: OpenSSL Configuration
  hosts: localhost
  become: true
  vars:
    openssl_requirements: []
    openssl_pip_packages: []
    openssl_key_directory: "/etc/ssl/private"
    openssl_csr_directory: "/etc/ssl/csr"
    openssl_crt_directory: "/etc/ssl/certs"
    openssl_file_owner: "root"
    openssl_file_group: "root"
    openssl_items: []

  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml
      delegate_to: localhost
      run_once: true

    - name: Install required packages
      package:
        name: "{{ openssl_requirements }}"
        state: present

    - name: Install pip packages
      pip:
        name: "{{ openssl_pip_packages }}"
      when: openssl_pip_packages | length > 0

    - name: Create the key directory
      file:
        path: "{{ openssl_key_directory }}"
        mode: '0750'
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"
        state: directory

    - name: Create the csr directory
      file:
        path: "{{ openssl_csr_directory }}"
        mode: '0750'
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"
        state: directory

    - name: Create the crt directory
      file:
        path: "{{ openssl_crt_directory }}"
        mode: '0750'
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"
        state: directory

    - name: Include the create.yml tasks
      include_tasks: create.yml
      loop: "{{ openssl_items }}"
      loop_control:
        loop_var: item
      when: openssl_items | length > 0


