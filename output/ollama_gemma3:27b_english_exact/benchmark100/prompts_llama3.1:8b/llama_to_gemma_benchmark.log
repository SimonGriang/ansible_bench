content='```yaml\n---\n\n- name: Download RKE2 installation script\n  get_url:\n    url: "{{ rke2_install_url }}"\n    dest: "{{ rke2_install_script_dest }}"\n    mode: \'0755\'\n\n- name: Copy local RKE2 installation script\n  copy:\n    src: "{{ rke2_install_script_local }}"\n    dest: "{{ rke2_install_script_dest }}"\n    mode: \'0755\'\n  when: rke2_airgap and rke2_implementation == \'copy\'\n\n- name: Create RKE2 artifacts folder\n  file:\n    path: "{{ rke2_artifacts_dir }}"\n    state: directory\n    mode: \'0755\'\n  when: rke2_airgap and rke2_implementation != \'exists\'\n\n- name: Download RKE2 checksum and artifacts\n  get_url:\n    url: "{{ rke2_artifacts_url }}"\n    dest: "{{ rke2_artifacts_dir }}"\n    mode: \'0644\'\n  when: rke2_airgap and rke2_implementation == \'download\'\n  rescue:\n    - name: Fallback to local download and push\n      command: "rsync -avz {{ rke2_local_artifacts_dir }}/ {{ rke2_artifacts_dir }}"\n      args:\n        creates: "{{ rke2_artifacts_dir }}"\n      \n\n- name: Airgap mode - additional images tarballs\n  copy:\n    src: "{{ rke2_additional_tarballs }}"\n    dest: "{{ rke2_artifacts_dir }}"\n    mode: \'0644\'\n  when: rke2_airgap and rke2_implementation != \'exists\' and rke2_additional_tarballs\n\n- name: Airgap mode - ensure artifacts exist and have acceptable permissions\n  file:\n    path: "{{ rke2_artifacts_dir }}"\n    state: directory\n    mode: \'0755\'\n  when: rke2_airgap and rke2_implementation == \'exists\'\n\n- name: Populate service facts\n  service_facts:\n\n- name: Get stats of the FS object\n  stat:\n    path: /usr/local\n  register: rke2_usr_local_stats\n\n- name: Check if separate partition\n  shell: grep -q \'^/usr/local$\' /etc/fstab\n  register: rke2_separate_partition\n  ignore_errors: true\n\n- name: Set RKE2 bin path\n  set_fact:\n    rke2_bin_path: /opt/rke2\n  when: not rke2_usr_local_stats.writable or rke2_separate_partition.rc != 0\n  \n- name: Check RKE2 version\n  shell: |\n    rke2 --version 2>&1 || systemctl status rke2 2>&1 | grep -i \'Active: active\'\n  register: rke2_version_check\n  ignore_errors: true\n\n- name: Set RKE2 versions\n  set_fact:\n    rke2_installed_version: "{{ rke2_version_check.stdout | regex_search(\'rke2 version (.*)\', \'\\\\1\') | default(\'\') }}"\n\n- name: Prevent accidental RKE2 downgrade\n  assert:\n    that:\n      - rke2_installed_version is version(rke2_desired_version, \'>=\')\n    msg: "Attempting to downgrade RKE2 from {{ rke2_installed_version }} to {{ rke2_desired_version }} is not allowed."\n\n- name: Run RKE2 install script\n  shell: |\n    {{ rke2_install_script_dest }} --desired-version={{ rke2_desired_version }} --channel={{ rke2_channel }} --cluster-name={{ rke2_cluster_name }}\n  when: rke2_installed_version != rke2_desired_version\n\n- name: Copy Custom Manifests\n  copy:\n    src: "{{ rke2_custom_manifests_src }}"\n    dest: "{{ rke2_manifests_dir }}"\n    mode: \'0644\'\n  when: rke2_custom_manifests_src\n\n- name: Copy Static Pods\n  copy:\n    src: "{{ rke2_static_pods_src }}"\n    dest: "{{ rke2_static_pods_dir }}"\n    mode: \'0644\'\n  when: rke2_static_pods_src\n\n- name: Copy RKE2 environment file\n  copy:\n    src: "{{ rke2_environment_file_src }}"\n    dest: "{{ rke2_environment_file_dest }}"\n    mode: \'0644\'\n  when: rke2_environment_options\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-13T15:20:15.523384659Z', 'done': True, 'done_reason': 'stop', 'total_duration': 81912700896, 'load_duration': 203407491, 'prompt_eval_count': 1056, 'prompt_eval_duration': 3482721963, 'eval_count': 1114, 'eval_duration': 78225303953, 'model_name': 'gemma3:27b'} id='run--66257d86-6841-40d6-85e5-2805db4cf18f-0' usage_metadata={'input_tokens': 1056, 'output_tokens': 1114, 'total_tokens': 2170}
