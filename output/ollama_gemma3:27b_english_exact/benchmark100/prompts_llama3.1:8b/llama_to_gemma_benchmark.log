---
  - name: Load OS-specific variables
    include_vars: "{{ ansible_os_family }}.yml"

  - name: Include setup tasks for RedHat-based systems
    include_tasks: RedHat_setup.yml
    when: ansible_os_family == "RedHat"

  - name: Include setup tasks for Debian-based systems
    include_tasks: Debian_setup.yml
    when: ansible_os_family == "Debian"

  - name: Install Docker packages
    package:
      name: docker.io
      state: present
    when: ansible_version.major < 2 and ansible_os_family not in ["RedHat", "Debian"]

  - name: Install Docker packages (with downgrade option)
    package:
      name: docker.io
      state: present
      version: "{{ docker_version }}"
    when: ansible_version.major >= 2 and ansible_os_family in ["RedHat", "Debian"]

  - name: Install the docker-compose plugin
    package:
      name: docker-compose
      state: present
    when: docker_compose_plugin_enabled and (ansible_version.major < 2 or ansible_os_family not in ["RedHat", "Debian"])

  - name: Install the docker-compose-plugin (with downgrade option)
    package:
      name: docker-compose
      state: present
      version: "{{ docker_compose_version }}"
    when: docker_compose_plugin_enabled and ansible_version.major >= 2 and ansible_os_family in ["RedHat", "Debian"]

  - name: Ensure the /etc/docker/ directory exists and has the correct permissions
    file:
      path: /etc/docker/
      state: directory
      mode: '0755'

  - name: Configure the Docker daemon options
    copy:
      src: daemon.json
      dest: /etc/docker/daemon.json
      owner: root
      group: root
      mode: '0644'

  - name: Ensure Docker is started and enabled at boot
    service:
      name: docker
      state: started
      enabled: yes
    when: docker_start_and_enable

  - name: Notify handlers to ensure firewall rules are updated
    meta: flush_handlers

  - name: Include tasks for managing docker-compose, if enabled
    include_tasks: docker-compose.yml
    when: docker_compose_manage

  - name: Get information about the docker group using getent
    command: getent group docker
    register: docker_group_info
    ignore_errors: true

  - name: Check if there are any users to add to the docker group
    set_fact:
      users_to_add_to_docker_group: "{{ docker_group_info.stdout | default('') | length > 0 }}"

  - name: Include tasks for managing docker users, if necessary
    include_tasks: docker_users.yml
    when: users_to_add_to_docker_group


