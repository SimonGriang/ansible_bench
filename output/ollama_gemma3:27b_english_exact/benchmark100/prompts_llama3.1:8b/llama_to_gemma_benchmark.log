---

  - name: Create an SSL private key
    openssl_private_key:
      path: "{{ ssl_private_key_path }}"
      size: 2048
      state: present
      owner: "{{ ssl_owner }}"
      group: "{{ ssl_group }}"
      mode: '0600'

  - name: Create an SSL Certificate Signing Request (CSR)
    openssl_csr:
      path: "{{ ssl_csr_path }}"
      private_key: "{{ ssl_private_key_path }}"
      common_name: "{{ ssl_common_name }}"
      state: present
      owner: "{{ ssl_owner }}"
      group: "{{ ssl_group }}"
      mode: '0600'

  - name: Create SSL certificates
    openssl_certificate:
      path: "{{ ssl_certificate_path }}"
      csr: "{{ ssl_csr_path }}"
      provider: selfsigned
      state: present
      owner: "{{ ssl_owner }}"
      group: "{{ ssl_group }}"
      mode: '0644'

  - name: Create a PKCS#12 file
    openssl_pkcs12:
      path: "{{ ssl_pkcs12_path }}"
      private_key: "{{ ssl_private_key_path }}"
      certificate: "{{ ssl_certificate_path }}"
      name: "{{ ssl_pkcs12_name }}"
      state: present
      owner: "{{ ssl_owner }}"
      group: "{{ ssl_group }}"
      mode: '0600'

  - name: Read the private key
    slurp:
      src: "{{ ssl_private_key_path }}"
    register: ssl_private_key_content

  - name: Read the certificate
    slurp:
      src: "{{ ssl_certificate_path }}"
    register: ssl_certificate_content

  - name: Create a combined private key and certificate file
    copy:
      content: "{{ ssl_private_key_content.content }}\n{{ ssl_certificate_content.content }}"
      dest: "{{ ssl_combined_path }}"
      owner: "{{ ssl_owner }}"
      group: "{{ ssl_group }}"
      mode: '0644'


