---

  - name: Check existence of Java certificates
    stat:
      path: "{{ item }}"
      state: file
    with_items: "{{ java_certs }}"
    register: check_java_certs

  - name: Fail if Java certificates do not exist
    fail:
      msg: "Java certificate {{ item.item }} does not exist."
    when: item.stat.exists is not defined or not item.stat.exists
    with_items: "{{ check_java_certs.results }}"

  - name: Set Java keystore directory for Java < 11
    set_fact:
      java_keystore_dir: "{{ java_keystore_dir_old }}"
    when: java_version|int < 11

  - name: Set Java keystore directory for Java >= 11
    set_fact:
      java_keystore_dir: "{{ java_keystore_dir_new }}"
    when: java_version|int >= 11

  - name: Import SSL certificates into Java keystore
    java_cert:
      keystore: "{{ java_keystore_dir }}/truststore.jks"
      password: "{{ java_cert_keystore_pass }}"
      certificate: "{{ item }}"
      alias: "{{ item | basename | regex_replace('.pem$', '') | regex_replace('.crt$', '') }}"
      state: present
      java_home: "{{ java_open_jdk_home }}"
    with_items: "{{ java_certs }}"


