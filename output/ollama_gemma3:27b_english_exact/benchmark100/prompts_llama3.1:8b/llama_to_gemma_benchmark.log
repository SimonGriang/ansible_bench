---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install the required packages for selinux
  ansible.builtin.package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush the handlers to ensure all pending tasks are executed
  ansible.builtin.meta:
    flush_handlers: true

- name: Configure selinux based on the selinux state and policy
  ansible.posix.selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when: selinux_state == 'enabled' and ansible_connection != 'container' and ansible_connection != 'docker'
  notify: Reboot

- name: Manage selinux booleans
  ansible.posix.seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    persistence: "{{ item.persistence }}"
  loop: "{{ selinux_booleans | default([]) }}"


