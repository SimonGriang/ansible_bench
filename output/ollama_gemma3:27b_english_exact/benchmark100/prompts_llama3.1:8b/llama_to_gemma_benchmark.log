---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install the MySQL package
  package:
    name: mysql-server
    state: present
  notify:
    - set_root_password
    - systemctl_daemon_reexec

- name: Configure the MySQL server
  ini_file:
    path: "{{ mysql_server_cnf }}"
    section: mysqld
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    create: yes
  loop: "{{ mysql_configuration_options }}"
  notify:
    - restart_mysql

- name: Configure the MySQL client
  ini_file:
    path: "{{ mysql_client_cnf }}"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    create: yes

- name: Initialize the MySQL database
  shell: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ["Alpine", "Archlinux"]

- name: Start and enable the MySQL service
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place the my.cnf file
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    host: "{{ item.host }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  meta: flush_handlers

