 name: Flush handlers\n  ansible.builtin.meta: flush_handlers\n\n- name: Remove default index.html\n  ansible.builtin.file:\n    path: "{{ httpd_default_index_path }}"\n    state: absent\n  when: httpd_remove_example is defined\n\n- name: Start and enable httpd service\n  ansible.builtin.service:\n    name: "{{ httpd_service_name }}"\n    state: started\n    enabled: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-23T21:05:46.766854518Z', 'done': True, 'done_reason': 'stop', 'total_duration': 46823772669, 'load_duration': 222768462, 'prompt_eval_count': 1203, 'prompt_eval_duration': 4386942170, 'eval_count': 702, 'eval_duration': 42212397681, 'model_name': 'gemma3:27b'} id='run--9cb5bfaf-3f3c-4280-a383-36a40e69cbdf-0' usage_metadata={'input_tokens': 1203, 'output_tokens': 702, 'total_tokens': 1905}
