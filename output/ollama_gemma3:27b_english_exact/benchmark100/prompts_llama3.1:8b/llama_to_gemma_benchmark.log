---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install openvpn packages
  apt:
    name: "{{ openvpn_packages }}"
    state: present
  become: true

- name: Set up OpenVPN server or client
  import_tasks: "{{ openvpn_role }}.yml"
  become: true

- name: Start and enable OpenVPN service
  systemd:
    name: openvpn
    state: started
    enabled: true
  become: true


