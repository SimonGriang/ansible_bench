---
- name: Install required SSL packages
  package:
    name: "{{ httpd_ssl_packages }}"
    state: present

- name: Place SSL configuration file
  copy:
    src: ssl.conf.j2
    dest: "{{ httpd_config_directory }}/ssl.conf"
    mode: 0644
  notify: restart apache

- name: Configure HTTP to HTTPS redirect
  copy:
    src: "{{ default_vhost_conf }}"
    dest: "{{ httpd_config_directory }}/{{ default_vhost_filename }}"
    mode: 0644
  notify: restart apache


