      set -e

      # Check if curl is installed
      if ! command -v curl &> /dev/null; then
        echo "curl is not installed."
        exit 1
      fi

      # Check if the RKE2 server is reachable
      if curl -s --fail http://localhost:6443 > /dev/null; then
        echo "RKE2 server is healthy."
        exit 0
      else
        echo "RKE2 server is unhealthy."
        exit 1
      fi
    mode: 0755
  become: yes
  when: ansible_os_family == "RedHat"

- name: Create the keepalived configuration file
  copy:
    dest: /etc/keepalived/keepalived.conf
    content: |
      vrrp_instance VI_1 {
          state MASTER
          interface eth0
          virtual_router_id 51
          priority 100
          advert_int 1
      }
    mode: 0644
  become: yes

- name: Enable the keepalived service and ensure it is not masked
  systemd:
    name: keepalived
    enabled: yes
    masked: no
  become: yes

- name: Flush the handlers to execute any pending tasks
  meta: flush_handlers


