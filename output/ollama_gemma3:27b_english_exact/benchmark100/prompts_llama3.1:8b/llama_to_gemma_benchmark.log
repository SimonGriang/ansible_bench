  ansible.builtin.package:
    name: openjdk-11-jdk
    state: present

- name: Import certificates into Java Keystore
  ansible.builtin.command:
    cmd: keytool -import -alias {{ item.alias }} -file {{ item.file }}
      -keystore {{ item.keystore }} -storepass {{ item.storepass }}
  loop: "{{ java_certs }}"
  when: java_certs is defined
  changed_when: true


