---

- name: Check all variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host (when configured)
  wait_for:
    host: "{{ ansible_ssh_host | default(inventory_hostname) }}"
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout | default(300) }}"
  when: ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare the system
  block:
    - name: Check connection
      ping:
      register: connection_result

    - name: Log debug message if connection fails
      debug:
        msg: "Connection check failed. Proceeding with preparation assuming initial state."
      when: not connection_result.success

    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml

    - name: Install bootstrap packages
      import_tasks: install_packages.yml
      when: bootstrap__facts_packages is defined
  
- name: Ensure system is prepared by issuing ansible modules
  become: "{{ bootstrap__become | default(true) }}"
  become_user: "{{ bootstrap__become_user | default(root) }}"
  package:
    name: "{{ bootstrap__facts_packages | default([]) }}"
    state: present
  loop: "{{ bootstrap__facts_packages | default([]) }}"
  when: bootstrap__facts_packages is defined


