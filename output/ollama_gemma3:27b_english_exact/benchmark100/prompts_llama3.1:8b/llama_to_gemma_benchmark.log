ost: "{{ item }}"\n    port: 6443\n    state: started\n    timeout: 600\n  loop: "{{ groups[\'rke2_nodes\'] }}"\n  retries: 30\n  delay: 10\n  when: inventory_hostname == groups[\'rke2_nodes\'][0] or inventory_hostname == groups[\'rke2_nodes\'][1]\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-13T15:45:01.446420974Z', 'done': True, 'done_reason': 'stop', 'total_duration': 46176001042, 'load_duration': 205356097, 'prompt_eval_count': 1652, 'prompt_eval_duration': 5410081839, 'eval_count': 755, 'eval_duration': 40558274083, 'model_name': 'gemma3:27b'} id='run--ba8c8849-8a7f-440c-b043-acf1e3b86cfb-0' usage_metadata={'input_tokens': 1652, 'output_tokens': 755, 'total_tokens': 2407}
