---

- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_url }}"
    dest: "/tmp/rke2_install.sh"
    mode: '0755'

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_local_install_path }}"
    dest: "/tmp/rke2_install.sh"
    mode: '0755'
  when: rke2_airgap and rke2_implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: '0755'
  when: rke2_airgap and rke2_implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ rke2_airgap_artifacts_url }}"
    dest: "{{ rke2_artifacts_dir }}"
    mode: '0644'
  when: rke2_airgap and rke2_implementation == 'download'
  rescue:
    - name: Fallback to local download and push
      command: "rsync -avz {{ rke2_local_artifacts_path }}/ {{ rke2_artifacts_dir }}/"
      args:
        creates: "{{ rke2_artifacts_dir }}/rke2"

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ rke2_airgap_tarballs_path }}"
    dest: "{{ rke2_airgap_tarballs_dir }}"
    mode: '0644'
  when: rke2_airgap and rke2_implementation != 'exists' and rke2_airgap_tarballs_to_copy

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: '0755'
  when: rke2_airgap and rke2_implementation == 'exists'

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: rke2_usr_local_stats

- name: Check if separate partition
  shell: grep -q '^/var/lib/rke2$' /proc/mounts
  register: rke2_separate_partition
  ignore_errors: true

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin
  when: rke2_usr_local_stats.writable and rke2_separate_partition.rc == 0
  
- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /opt/rke2/bin
  when: not rke2_usr_local_stats.writable or rke2_separate_partition.rc != 0

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }}/rke2 --version | grep 'rke2 version' | awk '{print $3}'"
  register: rke2_installed_version
  ignore_errors: true

- name: Set RKE2 versions
  set_fact:
    rke2_desired_version: "{{ rke2_version }}"
    rke2_installed_version_string: "{{ rke2_installed_version.stdout | default('') }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_installed_version_string is version(rke2_desired_version, '>=')
    fail_msg: "Attempted to downgrade RKE2. Desired version {{ rke2_desired_version }} is older than installed version {{ rke2_installed_version_string }}"

- name: Run RKE2 install script
  shell: "/tmp/rke2_install.sh --version={{ rke2_version }}"
  when: rke2_installed_version_string != rke2_desired_version
  
- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_custom_manifests_path }}"
    dest: "{{ rke2_manifests_dir }}"
    mode: '0644'
  when: rke2_custom_manifests_path is defined

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_path }}"
    dest: "{{ rke2_static_pods_dir }}"
    mode: '0644'
  when: rke2_static_pods_path is defined

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_environment_file_path }}"
    dest: "/etc/rke2/rke2.yaml"
    mode: '0644'
  when: rke2_environment_options is defined


