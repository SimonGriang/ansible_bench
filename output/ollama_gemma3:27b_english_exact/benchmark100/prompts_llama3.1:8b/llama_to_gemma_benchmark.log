  ansible.builtin.set_fact:
    active_server: "{{ ansible_hostname }}"
  when:
    - ansible_hostname in groups['rke2_servers_group_name']
    - "'rke2-server' in ansible_service_units"
  delegate_to: "{{ groups['rke2_cluster_group_name'][0] }}"


