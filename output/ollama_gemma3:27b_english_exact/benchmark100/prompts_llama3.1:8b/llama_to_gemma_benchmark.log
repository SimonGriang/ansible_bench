---
- name: Import assert.yml and run it once on localhost
  include_tasks: assert.yml

- name: Install the dns packages
  package:
    name:
      - bind9
      - bind9utils
      - dnsutils
    state: present

- name: Create the required directories
  file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: '0755'
  loop:
    - /etc/bind
    - /var/cache/bind

- name: Create the required group
  group:
    name: bind
    state: present

- name: Create the required user
  user:
    name: bind
    group: bind
    home: /var/cache/bind
    shell: /sbin/nologin
    createhome: no

- name: Generate the rndc key
  command: rndc-confgen -a -k rndc-key
  args:
    creates: /etc/rndc.key

- name: Set permissions on the rndc key file
  file:
    path: /etc/rndc.key
    owner: bind
    group: bind
    mode: '0640'

- name: Download the named.root file
  get_url:
    url: https://data.iana.org/root.hints
    dest: /var/cache/bind/named.root
    owner: bind
    group: bind
    mode: '0644'

- name: Create the zone file
  template:
    src: zone.j2
    dest: /etc/bind/db.example.com
    owner: bind
    group: bind
    mode: '0644'

- name: Add zones to the configuration
  template:
    src: named.conf.j2
    dest: /etc/bind/named.conf.local
    owner: bind
    group: bind
    mode: '0644'

- name: Place the systemd override
  template:
    src: bind9.service.j2
    dest: /etc/systemd/system/bind9.service.d/override.conf
  notify:
    - reload systemd

- name: Start and enable the DNS service
  systemd:
    name: bind9
    state: started
    enabled: yes


