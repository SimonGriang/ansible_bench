---
- name: Import task list for validation
  import_tasks: assert.yml
  run_once: true

- name: Install vsftpd package
  package:
    name: vsftpd
    state: present

- name: Configure vsftpd service
  copy:
    dest: /etc/vsftpd/vsftpd.conf
    mode: 0644
    owner: root
    group: root
  notify: restart vsftpd

- name: Start and enable vsftpd service
  service:
    name: vsftpd
    state: started
    enabled: true
  
handlers:
  - name: restart vsftpd
    service:
      name: vsftpd
      state: restarted


