    raw: cat /etc/os-release
    register: bootstrap_facts
    become: false

  - name: Extract and set the distribution name and major version
    set_fact:
      bootstrap_distribution: "{{ item.split('=')[1].strip().replace('"', '') }}"
      bootstrap_distribution_major_version: "{{ item.split('=')[1].split('.')[0].strip().replace('"', '') }}"
    loop: "{{ bootstrap_facts.stdout_lines | select('match', 'VERSION_ID') | map('split', '=') }}"
    when: bootstrap_facts.stdout is defined

  - name: Identify and set the operating system family
    set_fact:
      bootstrap_os_family: "{{ item.value }}"
    loop: "{{ bootstrap_os_family_map | dict2items }}"
    loop_control:
      label: "{{ item.key }}"
    when: bootstrap_distribution is defined and bootstrap_os_family_map is defined


