content='```yaml\n---\n- name: Create the document root for each vhost\n  ansible.builtin.file:\n    path: "{{ item.docroot }}"\n    state: directory\n    mode: 0755\n    owner: root\n    group: root\n  when: item.docroot is defined and (item.create_docroot is not defined or item.create_docroot)\n  loop: "{{ httpd_vhosts }}"\n\n- name: Configure the vhosts\n  ansible.builtin.template:\n    src: "{{ vhost_conf_template }}"\n    dest: "{{ item.destination }}/{{ item.name }}.conf"\n    mode: 0644\n  loop: "{{ httpd_vhosts }}"\n  notify:\n    - Test httpd configuration validity\n    - Restart httpd\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-23T21:30:24.195303099Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13174240441, 'load_duration': 193224969, 'prompt_eval_count': 381, 'prompt_eval_duration': 2052788108, 'eval_count': 187, 'eval_duration': 10927017323, 'model_name': 'gemma3:27b'} id='run--36c72721-944d-46e6-b5b6-e9ffe8d4246f-0' usage_metadata={'input_tokens': 381, 'output_tokens': 187, 'total_tokens': 568}
