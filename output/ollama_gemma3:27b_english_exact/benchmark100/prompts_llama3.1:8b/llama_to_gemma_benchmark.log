---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Set server taints
  when: inventory_hostname in groups['rke2_servers']
  ansible.builtin.lineinfile:
    path: /etc/rancher/rke2/config.yaml
    regexp: '^node-taints:'
    line: "node-taints: {{ rke2_server_node_taints | default('') }}"
    create: true

- name: Copy RKE2 config
  ansible.builtin.template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed

- name: Copy kubelet config
  ansible.builtin.template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: 0600
  when: rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: 0600
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
  notify: Config file changed

- name: Register etcd restore from file
  ansible.builtin.set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file | length > 0 and not (rke2_server is defined and rke2_server.status == 'disabled')

- name: Register etcd restore from s3
  ansible.builtin.set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file | length > 0 and rke2_etcd_snapshot_s3_options is defined and \
        rke2_etcd_snapshot_s3_options.access_key is defined and \
        rke2_etcd_snapshot_s3_options.secret_key is defined and \
        rke2_etcd_snapshot_s3_options.bucket is defined and \
        rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rke2/etcd/snapshots
        state: directory
        owner: root
        group: root
        mode: 0755

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rke2/etcd/snapshots/snapshot.db
        owner: root
        group: root
        mode: 0644

    - name: Restore etcd from snapshot
      command: rke2 etcd-snapshot restore
  when: do_etcd_restore

- name: Restore etcd from s3
  block:
    - name: Restore etcd from s3 snapshot
      command: rke2 etcd-snapshot restore --s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }} \
              --s3-key {{ rke2_etcd_snapshot_s3_options.snapshot_name }} \
              --s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }} \
              --s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }}
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  ansible.builtin.systemd:
    name: rke2-server.service
    state: started
    enabled: true
    env:
      RKE2_TOKEN: "{{ rke2_token }}"
  when: inventory_hostname == groups['rke2_servers'][0]
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  ansible.builtin.systemd:
    name: rke2-agent.service
    masked: true
  when: inventory_hostname == groups['rke2_servers'][0]

- name: Wait for the first server be ready - no CNI
  ansible.builtin.command: kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'
  register: kubectl_output
  until: kubectl_output.stdout.find('Ready') != -1 and kubectl_output.stdout.find('cni') == -1
  when: inventory_hostname == groups['rke2_servers'][0]

- name: Wait for the first server be ready - with CNI
  ansible.builtin.command: kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'
  register: kubectl_output
  until: kubectl_output.stdout.find('Ready') != -1
  when: inventory_hostname == groups['rke2_servers'][0]

- name: Restore etcd
  block:
    - name: Remove old secrets and nodes
      command: kubectl delete secrets --all --namespace kube-system
      ignore_errors: true

    - name: Remove old nodes
      command: kubectl delete nodes --all
      ignore_errors: true

    - name: Create new nodes
      command: kubectl apply -f /etc/kubernetes/manifests/kube-apiserver.yaml
      ignore_errors: true
  when: do_etcd_restore

- name: Set an Active Server variable
  ansible.builtin.set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"
