---
- name: Import assert.yml file
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection not in ["container", "docker", "community.docker.docker"]
    - ansible_connection != None
    - bootstrap_wait_for_host

- name: Prepare system
  become: true
  block:
    - name: Connection test
      ping:
      register: connection_test
      ignore_errors: true

    - name: Gather bootstrap facts
      setup:
      when: connection_test.failed

    - name: Sudo test
      command: sudo -n true
      register: sudo_test
      ignore_errors: true

    - name: Install bootstrap packages (raw)
      raw: yum install -y bootstrap-package
      when: sudo_test.failed and ansible_os_family == "RedHat"

    - name: Ensure libdnf5 is present on Fedora/RedHat
      package:
        name: libdnf5
        state: present
      when: sudo_test.failed and ansible_os_family == "RedHat"
      become: true

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  become: "{{ bootstrap_become }}"
  loop: "{{ bootstrap_facts_packages }}"


