---

- name: Lookup bootstrap facts by running the `cat /etc/os-release` command
  command: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: Set bootstrap distribution and major version facts
  set_fact:
    bootstrap_distribution: "{{ item.value.ID }}"
    bootstrap_major_version: "{{ item.value.VERSION_ID.split('.')[0] }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: bootstrap_facts.stdout | regex_search('^NAME=\"' + item.key + '\"')

- name: Set bootstrap OS family fact
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: bootstrap_facts.stdout | regex_search('^NAME=\"' + item.key + '\"')


