---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip packages
  ansible.builtin.pip:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  ansible.builtin.copy:
    dest: /etc/pip.conf
    content: |
      [global]
      proxy = {{ python_pip_proxy }}
  when: python_pip_proxy is defined
  mode: '0644'

- name: Configure pip trusted host settings
  ansible.builtin.copy:
    dest: /etc/pip.conf
    content: |
      [global]
      trusted-host = {{ python_pip_trusted_host }}
  when: python_pip_trusted_host is defined
  mode: '0644'

- name: Update pip to the specified version
  ansible.builtin.pip:
    name: "{{ python_pip_pip_package }}"
    state: present
  when:
    - python_pip_update is defined
    - ansible_distribution_release != "bookworm"
    - ansible_distribution_release != "noble"
    - ansible_os_family != "Alpine"

- name: Install requested Python modules
  ansible.builtin.pip:
    name: "{{ python_pip_modules }}"
    state: present
  when:
    - ansible_distribution_release != "bookworm"
    - ansible_distribution_release != "noble"
    - ansible_os_family != "Alpine"


