put\n  until: kubectl_output.stdout.find(\'Ready\') != -1\n  when: inventory_hostname == groups[\'rke2_servers\'][0]\n\n- name: Restore etcd\n  block:\n    - name: Remove old secrets and nodes\n      command: kubectl delete secrets --all --namespace kube-system\n      ignore_errors: true\n\n    - name: Remove old nodes\n      command: kubectl delete nodes --all\n      ignore_errors: true\n\n    - name: Create new nodes\n      command: kubectl apply -f /etc/kubernetes/manifests/kube-apiserver.yaml\n      ignore_errors: true\n  when: do_etcd_restore\n\n- name: Set an Active Server variable\n  ansible.builtin.set_fact:\n    active_server: "{{ inventory_hostname }}"\n  delegate_to: "{{ item }}"\n  loop: "{{ groups[rke2_cluster_group_name] }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-23T22:18:57.19204342Z', 'done': True, 'done_reason': 'stop', 'total_duration': 96379318420, 'load_duration': 197819495, 'prompt_eval_count': 2947, 'prompt_eval_duration': 9544068337, 'eval_count': 1513, 'eval_duration': 86635995188, 'model_name': 'gemma3:27b'} id='run--d160072c-2de7-41e8-a31a-6932ce51c220-0' usage_metadata={'input_tokens': 2947, 'output_tokens': 1513, 'total_tokens': 4460}
