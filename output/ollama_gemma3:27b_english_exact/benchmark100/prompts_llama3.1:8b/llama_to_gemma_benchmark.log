- name: Enable Backports repository for Debian versions older than 9.
  apt_repository:
    repo: deb http://deb.debian.org/debian {{ ansible_distribution_release }} backports main contrib non-free
    state: present
  when: ansible_distribution == "Debian" and ansible_distribution_release|int < 9

- name: Set default_release option for older Debian versions.
