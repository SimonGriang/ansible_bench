    state: present
    update_cache: yes
    default_release: "{{ ansible_distribution_release }}"
  when: ansible_distribution == "Debian" and ansible_distribution_release|int < 9

- name: Install Ansible package with default release.
  apt:
    name: ansible
    state: present
    update_cache: yes
  when: ansible_distribution == "Debian"


