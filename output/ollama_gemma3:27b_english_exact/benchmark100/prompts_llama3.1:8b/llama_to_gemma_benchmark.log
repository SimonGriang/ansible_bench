n      host: "{{ item }}"\n      port: 6443\n      timeout: 300\n    loop: "{{ groups[\'rke2_nodes\'] }}"\n    retries: 20\n    delay: 10\n    when: inventory_hostname == groups[\'rke2_nodes\'][0] or inventory_hostname == groups[\'rke2_nodes\'][1]\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-23T22:32:45.332667151Z', 'done': True, 'done_reason': 'stop', 'total_duration': 49244656127, 'load_duration': 6215663589, 'prompt_eval_count': 790, 'prompt_eval_duration': 2415031582, 'eval_count': 726, 'eval_duration': 40612951381, 'model_name': 'gemma3:27b'} id='run--a2940220-e1fe-438b-8b13-8a477499987a-0' usage_metadata={'input_tokens': 790, 'output_tokens': 726, 'total_tokens': 1516}
