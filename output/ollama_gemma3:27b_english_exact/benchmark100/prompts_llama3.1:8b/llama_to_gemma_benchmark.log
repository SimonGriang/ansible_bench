---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config_file }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: "{{ rke2_kubelet_config_template }}"
    dest: /var/lib/kubelet/config.yaml
    owner: root
    group: root
    mode: '0644'
  when: rke2_kubelet_config != ""
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_config }}"
    dest: /etc/containerd/config.toml
    owner: root
    group: root
    mode: '0644'
  when: (rke2_custom_registry_mirrors is defined and rke2_custom_registry_mirrors != "") or \
        (rke2_custom_registry_configs is defined and rke2_custom_registry_configs != "")
  notify: Config file changed

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2-server
    state: started
    enabled: true
    daemon_reload: true
  retries: 5
  delay: 10
  notify: Service (re)started

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ item }}"
    masked: true
  loop: "{{ rke2_other_services }}"
  when: item != rke2_type

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    host: "{{ item }}"
    port: 6443
    state: started
    timeout: 600
  loop: "{{ groups['rke2_nodes'] }}"
  retries: 30
  delay: 10

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    host: "{{ item }}"
    port: 6443
    state: started
    timeout: 600
  loop: "{{ groups['rke2_nodes'] }}"
  retries: 30
  delay: 10
  when: inventory_hostname == groups['rke2_nodes'][0] or \
        inventory_hostname == groups['rke2_nodes'][1]


