---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install the mysql package
  package:
    name: mysql
    state: present

- name: Configure the mysql server
  copy:
    dest: "{{ mysql_name }}-server.cnf"
    content: "{{ mysql_configuration_options | join('\n') }}"
    owner: root
    group: root
    mode: 0644

- name: Configure the mysql client
  copy:
    dest: "{{ mysql_name }}-client.cnf"
    content: "[client]\nsocket = {{ mysql_socket }}"
    owner: root
    group: root
    mode: 0644

- name: Initialize the mysql service
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ["Alpine", "Archlinux"]

- name: Start and enable the mysql service
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Create a my.cnf file in the /root/.my.cnf directory
  template:
    path: /root/.my.cnf
    src: my.cnf.j2
    owner: root
    group: root
    mode: 0644

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: List databases
  community.mysql.mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
  register: mysql_databases_info

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    import: "{{ item.initial_import }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    host: "{{ item.host }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


