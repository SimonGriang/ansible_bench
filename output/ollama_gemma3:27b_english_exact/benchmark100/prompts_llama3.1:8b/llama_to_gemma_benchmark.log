- name: Create specified directories with the correct permissions.
  ansible.builtin.file:
    path: "{{ item.path }}"
    mode: "{{ item.mode }}"
    state: directory
    owner: root
    group: root
  loop:
    - path: /var/www/html
      mode: '0755'
    - path: /var/log/httpd
      mode: '0755'

- name: Configure directory configurations for HTTP server.
  ansible.builtin.template:
    src: directory.conf.j2
    dest: /etc/httpd/conf.d/{{ item.name }}.conf
    mode: '0644'
  loop:
    - name: default
      path: /var/www/html
    - name: logs
      path: /var/log/httpd


