---

  - name: Import and execute tasks from assert.yml playbook fragment
    import_playbook: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Install logrotate package
    package:
      name: logrotate
      state: present

  - name: Configure logrotate by rendering a template
    template:
      src: "{{ logrotate_config_dir }}/{{ logrotate_config_file_name }}.j2"
      dest: "{{ logrotate_config_file_path }}"
      mode: 0644

  - name: Generate logrotate.d files using a template
    template:
      src: "{{ logrotate_config_dir }}/entry.j2"
      dest: "{{ logrotate_conf_d_dir }}/{{ item.name }}"
      mode: 0644
      when: item.absent is not defined or not item.absent
    loop: "{{ logrotate_entries }}"
    labels: "{{ logrotate_entry_name }}"

  - name: Remove logrotate.d files
    file:
      path: "{{ logrotate_conf_d_dir }}/{{ item.name }}"
      state: absent
    loop: "{{ logrotate_entries }}"
    when: item.absent is defined and item.absent
    labels: "{{ logrotate_entry_name }}"

  - name: Manage logrotate service
    service:
      name: "{{ logrotate_service_name }}"
      state: "{{ logrotate_service_state }}"
      enabled: "{{ logrotate_service_enabled }}"
    when: logrotate_service_name


