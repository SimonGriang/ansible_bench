---
- name: Import assert.yml file for task execution and skip the rest of the tasks on the first run.
  import_tasks: assert.yml
  run_once: true

- name: Pre-configure Debian systems for postfix installation.
  debconf:
    name: postfix
    question: mailer_type
    value: "No configuration"
  when: ansible_os_family == "Debian"

- name: Install postfix package.
  package:
    name: postfix
    state: present

- name: Install postfix-mysql package if specific conditions are met.
  package:
    name: postfix-mysql
    state: present
  when:
    - postfix_virtual_mailbox_maps is defined
    - "mysql" in postfix_virtual_mailbox_maps
    - postfix_virtual_mailbox_domains is defined
    - "mysql" in postfix_virtual_mailbox_domains
    - postfix_virtual_alias_maps is defined
    - "mysql" in postfix_virtual_alias_maps

- name: Configure postfix transport maps.
  template:
    src: transport
    dest: /etc/postfix/transport
  notify:
    - validate_transport_map
    - rebuild_transport_map

- name: Configure postfix header checks.
  template:
    src: header_checks
    dest: /etc/postfix/header_checks
  notify:
    - validate_header_checks
    - reload_postfix

- name: Set values for the main.cf file.
  set_fact:
    postfix_main_cf_rules:
      - "recipient_access_maps = {{ postfix_recipient_access | default('') }}"
      - "sender_access_maps = {{ postfix_sender_access | default('') }}"
      - "mynetworks = {{ postfix_mynetworks | default('') }}"
      - "mydestination = {{ postfix_mydestination | default('') }}"
      - "relay_domains = {{ postfix_relay_domains | default('') }}"
      - "smtpd_recipient_restrictions = {{ postfix_smtpd_recipient_restrictions | default('') }}"
      - "smtpd_sender_restrictions = {{ postfix_smtpd_sender_restrictions | default('') }}"
      - "virtual_mailbox_domains = {{ postfix_virtual_mailbox_domains | default('') }}"
      - "virtual_alias_domains = {{ postfix_virtual_alias_domains | default('') }}"

- name: Configure postfix main.cf.
  template:
    src: main.cf
    dest: /etc/postfix/main.cf
  notify:
    - validate_main_cf
    - restart_postfix

- name: Configure postfix master.cf.
  template:
    src: master.cf
    dest: /etc/postfix/master.cf
  notify:
    - validate_master_cf
    - restart_postfix

- name: Create a directory for TLS certificates and keys.
  file:
    path: /etc/postfix/tls
    state: directory
    mode: '0750'
    owner: root
    group: root

- name: Deploy Postfix TLS server certificate.
  copy:
    src: "{{ postfix_tls_server_certificate }}"
    dest: /etc/postfix/tls/server.crt
    mode: '0644'
    owner: root
    group: root
  notify:
    - reload_postfix

- name: Deploy Postfix TLS server key.
  copy:
    src: "{{ postfix_tls_server_key }}"
    dest: /etc/postfix/tls/server.key
    mode: '0600'
    owner: root
    group: root
  notify:
    - reload_postfix

- name: Flush handlers.
  meta: flush_handlers

- name: Configure aliases.
  copy:
    content: "{{ postfix_aliases }}"
    dest: /etc/aliases
  notify:
    - rebuild_aliases
    - reload_postfix

- name: Configure sender_access.
  copy:
    content: "{{ postfix_sender_access }}"
    dest: /etc/postfix/sender_access
  notify:
    - rebuild_sender_access
    - reload_postfix

- name: Configure recipient_access.
  copy:
    content: "{{ postfix_recipient_access }}"
    dest: /etc/postfix/recipient_access
  notify:
    - validate_recipient_access
    - rebuild_recipient_access
    - reload_postfix

- name: Place sasl_password_map.
  copy:
    content: "{{ postfix_smtp_sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password_map
  notify:
    - rebuild_sasl_password_map

- name: Flush handlers again.
  meta: flush_handlers

- name: Start and enable postfix service.
  service:
    name: postfix
    state: started
    enabled: yes


