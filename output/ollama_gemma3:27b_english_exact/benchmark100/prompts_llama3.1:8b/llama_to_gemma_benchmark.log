---

  - name: Import assert.yml
    include_tasks: assert.yml
    delegate_to: localhost

  - name: Uninstall systemd-logger
    package:
      name: systemd-logger
      state: absent

  - name: Install rsyslog and required packages
    package:
      name: "{{ rsyslog_packages }}"
      state: present

  - name: Install additional rsyslog features
    package:
      name: "{{ item }}"
      state: present
    loop: "{{ rsyslog_features }}"

  - name: Configure default rsyslog configuration
    template:
      src: rsyslog.conf.j2
      dest: /etc/rsyslog.conf
      mode: 0644
    notify: Restart rsyslog
    when: rsyslog_deploy_default_config

  - name: Create /etc/rsyslog.d/ directory
    file:
      path: /etc/rsyslog.d/
      state: directory
      mode: 0755

  - name: Configure forward rule for rsyslog
    template:
      src: forward_rule.conf.j2
      dest: /etc/rsyslog.d/forward_rule.conf
      mode: 0644
    notify: Restart rsyslog
    when: not rsyslog_deploy_default_config

  - name: Configure additional rsyslog configuration files
    copy:
      dest: "/etc/rsyslog.d/{{ item.name }}"
      content: "{{ item.content }}"
      owner: root
      group: root
      mode: 0440
    notify: Restart rsyslog
    loop: "{{ rsyslog_rsyslog_d_files }}"

  - name: Start and enable rsyslog service
    service:
      name: rsyslog
      state: started
      enabled: yes


