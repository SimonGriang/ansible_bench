---
- name: Ensure old versions of Docker are not installed.
  package:
    name:
      - docker
      - docker-engine
      - docker.io
    state: absent

- name: Add Docker GPG key.
  apt_key:
    url: https://download.docker.com/linux/ubuntu/gpg
    state: present
  when: ansible_os_family == "Debian"

- name: Add Docker GPG key.
  rpm_key:
    url: https://download.docker.com/linux/centos/gpg
    state: present
  when: ansible_os_family == "RedHat"

- name: Add Docker repository.
  apt_repository:
    repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu focal stable
    state: present
  when: ansible_os_family == "Debian"

- name: Add Docker repository.
  yum_repository:
    name: docker-ce
    description: Docker CE Repository
    baseurl: https://download.docker.com/linux/centos/
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: yes
  when: ansible_os_family == "RedHat"

- name: Configure Docker Nightly repo and Docker Test repo.
  yum_repository:
    name: docker-ce-nightly
    description: Docker CE Nightly Repository
    baseurl: https://download.docker.com/linux/centos/
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: "{{ docker_yum_repo_enable_nightly }}"
  when: ansible_os_family == "RedHat"

- name: Configure Docker Nightly repo and Docker Test repo.
  yum_repository:
    name: docker-ce-test
    description: Docker CE Test Repository
    baseurl: https://download.docker.com/linux/centos/
    gpgcheck: yes
    gpgkey: https://download.docker.com/linux/centos/gpg
    enabled: "{{ docker_yum_repo_enable_test }}"
  when: ansible_os_family == "RedHat"

- name: Configure containerd on RHEL 8.
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"
  block:
    - name: Remove runc
      package:
        name: runc
        state: absent

    - name: Install container-selinux
      package:
        name: container-selinux
        state: present

    - name: Install containerd.io
      package:
        name: containerd.io
        state: present


