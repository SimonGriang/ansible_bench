put\n  until: kubectl_output.stdout.find(\'Ready\') != -1\n  when: inventory_hostname == groups[\'rke2_servers\'][0]\n\n- name: Restore etcd\n  block:\n    - name: Remove old secrets and nodes\n      command: kubectl delete secrets --all --namespace kube-system\n      ignore_errors: true\n\n    - name: Remove old nodes\n      command: kubectl delete nodes --all\n      ignore_errors: true\n\n    - name: Create new nodes\n      command: kubectl apply -f /etc/kubernetes/manifests/kube-apiserver.yaml\n      ignore_errors: true\n  when: do_etcd_restore\n\n- name: Set an Active Server variable\n  ansible.builtin.set_fact:\n    active_server: "{{ inventory_hostname }}"\n  delegate_to: "{{ item }}"\n  loop: "{{ groups[rke2_cluster_group_name] }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-23T22:17:19.114512813Z', 'done': True, 'done_reason': 'stop', 'total_duration': 98685675526, 'load_duration': 194885368, 'prompt_eval_count': 2947, 'prompt_eval_duration': 9582270403, 'eval_count': 1513, 'eval_duration': 88906731288, 'model_name': 'gemma3:27b'} id='run--1b8b1659-2d4b-4aa3-a4ee-84a40b0a35ee-0' usage_metadata={'input_tokens': 2947, 'output_tokens': 1513, 'total_tokens': 4460}
