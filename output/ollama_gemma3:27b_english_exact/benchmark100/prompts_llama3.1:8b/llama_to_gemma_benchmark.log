    - systemctl daemon-reexec

- name: Configure the MySQL server
  ini_file:
    path: "{{ mysql_server_cnf }}"
    section: mysqld
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    state: present
  loop: "{{ mysql_configuration_options }}"
  notify:
    - restart mysql

- name: Configure the MySQL client
  ini_file:
    path: "{{ mysql_client_cnf }}"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    state: present

- name: Initialize the MySQL database
  shell: "{{ mysql_initialize_command }}"
  when: mysql_initialize_command is defined

- name: Start and enable the MySQL service
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place the my.cnf file
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    host: "{{ item.host }}"
    state: present
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  meta: flush_handlers


