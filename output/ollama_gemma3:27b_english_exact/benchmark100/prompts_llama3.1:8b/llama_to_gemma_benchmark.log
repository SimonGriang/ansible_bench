content='```yaml\n---\n- name: Install epel package repositories for compatible operating systems (RedHat-based and Amazon Linux)\n  become: true\n  package:\n    name: epel-release\n    state: absent\n  when: ansible_os_family in ["RedHat", "Amazon"]\n\n- name: Install the epel GPG key\n  become: true\n  rpm_key:\n    key: "{{ epel_gpg_key }}"\n    state: present\n\n- name: Install the epel-release package\n  become: true\n  package:\n    name: epel-release\n    state: present\n  notify: Update package cache\n\n- name: Install the epel-next-release package (conditional)\n  become: true\n  package:\n    name: epel-next-release\n    state: present\n  when: epel_next\n  notify: Update package cache\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-13T12:27:00.731457426Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13002631379, 'load_duration': 182406739, 'prompt_eval_count': 403, 'prompt_eval_duration': 1561133997, 'eval_count': 202, 'eval_duration': 11258562613, 'model_name': 'gemma3:27b'} id='run--270635f1-ae15-475b-ad4f-23d2f360275d-0' usage_metadata={'input_tokens': 403, 'output_tokens': 202, 'total_tokens': 605}
