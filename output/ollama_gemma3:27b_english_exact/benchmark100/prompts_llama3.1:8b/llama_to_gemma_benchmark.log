---

  - name: Import assert.yml
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Wait for port to become available
    wait_for:
      port: 22
      timeout: "{{ bootstrap_timeout }}"
    when:
      - ansible_connection != "container"
      - ansible_connection != "docker"
      - ansible_connection != "community.docker.docker"
      - bootstrap_wait_for_host is defined

  - name: Prepare the system
    block:
      - name: Check connection and sudo
        command: "test -x /usr/bin/sudo"
        register: bootstrap_connect
        ignore_errors: true

      - name: Gather bootstrap facts
        include_tasks: gather_facts.yml
        when: bootstrap_connect.rc != 0

      - name: Install bootstrap packages (raw)
        raw: apt-get update && apt-get install -y --no-install-recommends curl python3 python3-pip
        become: true
        when: bootstrap_connect.rc != 0
    
  - name: Gather Ansible facts
    setup:
      filter: ansible_facts.os_family
    
  - name: Install bootstrap packages (package)
    package:
      name: "{{ bootstrap_facts_packages }}"
      state: present
      update_cache: true
    become: "{{ bootstrap_become }}"


