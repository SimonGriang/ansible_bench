---
  - name: Migrate adoptopenjdk to temurin (if selected)
    set_fact:
      java_jdk_vendor: "temurin"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Gather OS specific variables
    include_vars: "os_specific.yml"
    when: java_jdk_vendor is defined

  - name: Gather architecture specific variables
    include_vars: "architecture.yml"

  - name: Set OS-specific variables (I)
    set_fact:
      java_open_jdk_name: "{{ java_open_jdk_name | default(omit) }}"
      java_open_jdk_version: "{{ java_open_jdk_version | default(omit) }}"
      java_open_jdk_architecture: "{{ java_open_jdk_architecture | default(omit) }}"

  - name: Set OS and architecture specific variables (II)
    set_fact:
      java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default(omit) }}"
      java_open_jdk_package: "{{ java_open_jdk_package | default(omit) }}"

  - name: Set specific variables
    set_fact:
      java_home: "{{ java_open_jdk_home }}"

  - name: Debian pre-requisites
    block:
      - name: Remove deprecated repositories
        apt_repository:
          repo: 'deb http://security.debian.org/debian-security bullseye-security main'
          state: absent
        when: ansible_os_family == "Debian"
      - name: Install extra apt tools
        apt:
          name:
            - software-properties-common
            - apt-transport-https
          state: present
        when: ansible_os_family == "Debian"
      - name: Add required key repositories
        apt_key:
          url: https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x46181433FBB75451
          state: present
        when: ansible_os_family == "Debian"
      - name: Add required repositories
        apt_repository:
          repo: 'deb https://ppa.launchpad.net/openjdk-ppa/ppa/ubuntu jammy main'
          state: present
        when: ansible_os_family == "Debian"
    when: ansible_os_family == "Debian"

  - name: RedHat pre-requisites
    block:
      - name: Add required key repositories
        rpm_key:
          key: https://download.java.net/openjdk/latest/GPG-KEY-OpenJDK
          state: present
        when: ansible_os_family == "RedHat"
      - name: Add required repositories
        yum_repository:
          name: openjdk
          description: OpenJDK Repository
          baseurl: https://download.java.net/openjdk/latest/
          gpgcheck: yes
          gpgkey: https://download.java.net/openjdk/latest/GPG-KEY-OpenJDK
          enabled: yes
        when: ansible_os_family == "RedHat"
    when: ansible_os_family == "RedHat"

  - name: Install required libs
    apt:
      name:
        - ca-certificates
        - libstdc++6
      state: present
    when: ansible_os_family == "Debian"

  - name: Install Java, Debian
    apt:
      name: "{{ java_open_jdk_package }}"
      state: present
    when: ansible_os_family == "Debian"

  - name: Install Java, RedHat
    yum:
      name: "{{ java_open_jdk_package }}"
      state: present
    when: ansible_os_family == "RedHat"

  - name: Export environment variables
    template:
      src: jdk.sh.j2
      dest: /etc/profile.d/jdk.sh
      mode: '0755'

  - name: Source environment variables
    shell: "source /etc/profile"

  - name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
    file:
      src: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
      dest: /usr/bin/java
      state: link
      force: yes
    when: ansible_distribution == "Ubuntu" and java_open_jdk_version is defined and java_open_jdk_version | int < 11

  - name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
    file:
      src: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java
      dest: /usr/bin/java
      state: link
      force: yes
    when: ansible_distribution == "Ubuntu" and java_open_jdk_version is defined and java_open_jdk_version | int >= 11


