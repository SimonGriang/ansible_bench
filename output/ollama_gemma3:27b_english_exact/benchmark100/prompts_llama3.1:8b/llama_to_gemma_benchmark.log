---
- name: Import assert tasks
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Apache HTTP Server
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings
  ansible.builtin.seboolean:
    name: "{{ item }}"
    state: true
  loop: "{{ httpd_sebooleans }}"
  when: ansible_selinux.enabled

- name: Configure custom ports (SELinux)
  ansible.builtin.seboolean:
    name: httpd_can_network_connect_custom
    state: true
  when:
    - ansible_selinux.enabled
    - httpd_port is defined

- name: Configure SSL port (SELinux)
  ansible.builtin.seboolean:
    name: httpd_can_network_connect_ssl
    state: true
  when:
    - ansible_selinux.enabled
    - httpd_ssl_port is defined

- name: Configure Apache HTTP Server
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Activate Apache modules (Debian)
  ansible.builtin.command: a2enmod "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == "Debian"
  notify: Test httpd configuration validity

- name: Import SSL tasks
  import_tasks: ssl.yml
  when: https_ssl_enable is defined

- name: Import locations tasks
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual hosts tasks
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure custom ports
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_ports_dest }}"
    mode: '0644'
  when:
    - ansible_os_family == "Debian"
    - ansible_os_family == "Suse"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Import directories tasks
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Remove default index.html
  ansible.builtin.file:
    path: "{{ httpd_default_index_path }}"
    state: absent
  when: httpd_remove_example is defined

- name: Start and enable httpd service
  ansible.builtin.service:
    name: "{{ httpd_service_name }}"
    state: started
    enabled: true


