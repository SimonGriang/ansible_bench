---
- name: Create the Vault group
  group:
    name: "{{ vault_group }}"
    system: true

- name: Create the Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"

- name: Create the Vault download directory
  file:
    path: "{{ vault_download_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Download the Vault binary
  get_url:
    url: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}/vault"
    mode: '0755'
  register: vault_download

- name: Set ownership and mode of downloaded binary
  file:
    path: "{{ vault_download.dest }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Check if the vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_stat

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  when: not vault_path_stat.stat.exists

- name: Create directories in vault_path
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  loop: "{{ vault_directories }}"

- name: Create data directories
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  openssl_certificate:
    path: "{{ vault_tls_path }}/vault.pem"
    cert_file: "{{ vault_tls_path }}/vault.pem"
    key_file: "{{ vault_tls_path }}/vault.key"
    common_name: "{{ vault_common_name }}"
    days: 3650
    state: present

- name: Set ownership of TLS material
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0600'
  loop: "{{ vault_tls_files }}"

- name: Copy the Vault binary
  copy:
    src: "{{ vault_download.dest }}"
    dest: "{{ vault_binary_destination }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setcap:
    cap: cap_ipc_lock=ep
    path: /usr/bin/vault

- name: Touch vault.env
  file:
    path: "{{ vault_env_file }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'
    state: touch

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    owner: root
    group: root
    mode: '0755'
    state: directory

- name: Copy the Vault service file
  copy:
    src: "{{ vault_service_file_src }}"
    dest: "{{ vault_service_file_dest }}"
    owner: root
    group: root
    mode: '0644'

- name: Copy the Vault configuration
  copy:
    src: "{{ vault_config_file_src }}"
    dest: "{{ vault_config_file_dest }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'

- name: Flush handlers
  meta: flush_handlers


