---
- name: Create logrotate configuration files
  ansible.builtin.copy:
    dest: "/etc/logrotate.d/{{ item.name }}"
    content: "{{ item.content }}"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ logrotate_entries }}"
  when: item.state == 'present'

- name: Ensure logrotate configuration files are present
  ansible.builtin.stat:
    path: "/etc/logrotate.d/{{ item.name }}"
  loop: "{{ logrotate_entries }}"
  register: logrotate_files
  loop_control:
    loop_var: item

- name: Remove logrotate configuration files
  ansible.builtin.file:
    path: "/etc/logrotate.d/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  when: item.state == 'absent'

- name: Check for existing logrotate.d files
  ansible.builtin.find:
    paths: /etc/logrotate.d
    patterns: "*"
    recurse: false
  register: logrotate_d_files

- name: Remove logrotate.d files
  ansible.builtin.file:
    path: "/etc/logrotate.d/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  when: item.state == 'absent'


