---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Enable redis module stream (RHEL 8)
  when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"
  command: dnf module enable redis
  become: true

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present
  become: true

- name: Configure redis
  template:
    src: redis.conf-{{ ansible_distribution }}.j2
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_configuration_owner }}"
    group: "{{ redis_configuration_group }}"
    mode: "{{ redis_configuration_mode }}"
  notify: Restart redis
  become: true

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true
  become: true


