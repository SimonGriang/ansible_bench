---
  - name: Import assert.yml
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Configure apk
    apk:
      update_cache: yes
      upgrade: yes
    when: ansible_pkg_mgr == "apk"
    notify: Reboot

  - name: Configure apt
    apt:
      update_cache: yes
      upgrade: yes
      autoremove: "{{ apt_autoremove | default(false) }}"
      autoclean: yes
      exclude: "{{ update_excluded_packages | default([]) }}"
    when: ansible_pkg_mgr == "apt"
    notify: Reboot

  - name: Update all software (dnf)
    dnf:
      name: "*"
      state: latest
      exclude: "{{ update_excluded_packages | default([]) }}"
    when: ansible_pkg_mgr == "dnf" or ansible_pkg_mgr == "dnf5"
    notify: Reboot

  - name: Update all software (pacman)
    pacman:
      update_cache: yes
      upgrade: yes
    when: ansible_pkg_mgr == "pacman"
    notify: Reboot

  - name: Configure yum
    yum:
      name: "*"
      state: latest
      exclude: "{{ update_excluded_packages | default([]) }}"
      update_cache: yes
    when: ansible_pkg_mgr == "yum"
    notify: Reboot

  - name: Update all software (zypper)
    zypper:
      name: "*"
      state: latest
    when: ansible_pkg_mgr == "zypper"
    notify: Reboot


