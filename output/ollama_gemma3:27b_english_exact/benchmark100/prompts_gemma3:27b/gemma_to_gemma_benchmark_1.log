y:\n    src: "{{ rke2_custom_manifests_local }}"\n    dest: "{{ rke2_data_dir }}/manifests/"\n    remote_src: yes\n  when: rke2_custom_manifests_local is defined\n\n- name: Copy Static Pods\n  ansible.builtin.copy:\n    src: "{{ rke2_static_pods_local }}"\n    dest: "{{ rke2_agent_dir }}/"\n    remote_src: yes\n  when: rke2_static_pods_local is defined\n\n- name: Copy RKE2 environment file\n  ansible.builtin.copy:\n    src: "{{ rke2_env_file_local }}"\n    dest: "/etc/rke2/rke2.yaml"\n  when: rke2_env_file_local is defined\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-11T09:31:52.869274804Z', 'done': True, 'done_reason': 'stop', 'total_duration': 92692429606, 'load_duration': 228328465, 'prompt_eval_count': 2730, 'prompt_eval_duration': 8855898959, 'eval_count': 1440, 'eval_duration': 83606937901, 'model_name': 'gemma3:27b'} id='run--782f8e97-de8e-42ba-9f3b-6a957bcf64e3-0' usage_metadata={'input_tokens': 2730, 'output_tokens': 1440, 'total_tokens': 4170}
