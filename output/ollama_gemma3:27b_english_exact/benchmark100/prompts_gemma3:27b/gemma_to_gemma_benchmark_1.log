---

  - name: Check if all variables have been set correctly
    import_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Wait for host to be reachable
    local_connection: true
    become: true
    when: ansible_connection != 'container' and ansible_connection != 'docker' and bootstrap_wait_for_host
    wait_for:
      port: 22
      host: "{{ ansible_ssh_host | default(ansible_host | default(inventory_hostname)) }}"
      timeout: "{{ bootstrap_timeout }}"

  - name: Prepare the system
    block:
      - name: Test connection
        wait_for_connection:
        register: bootstrap_connect

      - name: Debug bootstrap_timeout
        debug:
          msg: "Connection failed. Check bootstrap_timeout value."
        when: bootstrap_connect.failed

      - name: gather_facts.yml
        import_tasks: gather_facts.yml
    always:

  - name: Install bootstrap packages
    raw: "{{ bootstrap_install_command }}"
    shell: true
    register: bootstrap_install_packages
    become: true
    changed_when:
      - ansible_os_family == "Alpine" and bootstrap_install_packages.stdout | regex_search(bootstrap_stdout_regex)
      - ansible_os_family == "Archlinux" and bootstrap_install_packages.stdout | regex_search(bootstrap_stdout_regex)
      - ansible_os_family == "Gentoo" and bootstrap_install_packages.stdout | regex_search(bootstrap_stdout_regex)
      - ansible_os_family not in ["Debian", "RedHat", "Rocky", "Suse"] and bootstrap_install_packages.stdout | regex_search(bootstrap_stdout_regex)
    user: "{{ bootstrap_user }}"

  - name: Ensure system is prepared by issuing ansible modules
    block:
      - name: Gather ansible facts
        setup:

      - name: Install bootstrap packages
        package:
          name: "{{ bootstrap__facts_packages }}"
          state: present
          update_cache: true


