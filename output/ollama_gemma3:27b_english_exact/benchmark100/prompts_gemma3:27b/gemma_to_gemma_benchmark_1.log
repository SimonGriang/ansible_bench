---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Pre-configure debian systems
  when: ansible_os_family == "Debian"
  debconf:
    name: postfix
    question: config_directory
    value: ""
    template: "netselect"
  ignore_errors: true

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: virtual_mailbox_maps is defined or domains_using_mysql is defined

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    owner: root
    group: root
    mode: 0644
  notify:
    - validate postfix configuration
    - rebuild postfix database
  when: template_transport_maps is defined

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: 0644
  notify:
    - validate postfix configuration
    - reload postfix
  when: template_header_checks is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    main_cf_myhostname: "{{ ansible_fqdn }}"
    main_cf_mydomain: "{{ ansible_domain }}"
    main_cf_myorigin: "$mydomain"
    main_cf_mydestination: "$myhostname"
    main_cf_relayhost: ""
    main_cf_mynetworks: "127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128"
