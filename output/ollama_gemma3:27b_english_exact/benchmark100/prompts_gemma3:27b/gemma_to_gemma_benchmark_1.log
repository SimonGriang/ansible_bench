content='```yaml\n---\n\n- name: Download RKE2 kubeconfig to localhost\n  fetch:\n    src: /etc/rancher/rke2/rke2.yaml\n    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    flat: yes\n  when: rke2_download_kubeconf and ansible_hostname == rke2_servers_group_name[0]\n\n- name: Replace loopback IP by master server IP\n  replace:\n    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    regexp: \'127\\.0\\.0\\.1|::1\'\n    replace: "{{ rke2_api_ip | default(ansible_host) }}"\n  delegate_to: localhost\n  become: false\n  ansible_check_mode: false\n  when: rke2_download_kubeconf and ansible_hostname == rke2_servers_group_name[0]\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-11T09:27:17.317875547Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15074010468, 'load_duration': 199999483, 'prompt_eval_count': 653, 'prompt_eval_duration': 2134287393, 'eval_count': 244, 'eval_duration': 12738381442, 'model_name': 'gemma3:27b'} id='run--7f9c9cc6-4107-4636-b641-116a36dbfec1-0' usage_metadata={'input_tokens': 653, 'output_tokens': 244, 'total_tokens': 897}
