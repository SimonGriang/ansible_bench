---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  copy:
    dest: "{{ mysql_name }}-server.cnf"
    content: "{{ mysql_configuration_options | join('\n') }}"
    owner: root
    group: root
    mode: 0644

- name: Configure mysql client
  copy:
    dest: "{{ mysql_name }}-client.cnf"
    content: "socket = {{ mysql_socket }}"
    owner: root
    group: root
    mode: 0644

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/mysql.sock
  when: ansible_distribution in ["Alpine", "Archlinux"]

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
    encoding: "{{ item.encoding }}"
    collation: "{{ item.collation }}"
  loop: "{{ mysql_databases }}"

- name: List databases
  mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
    db_name: "*"
  register: mysql_databases_info
  changed_when: false
  failed_when: false

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
    import_file: "{{ item.import_file }}"
  loop: "{{ mysql_databases }}"
  when: mysql_initial_import_target is defined and item.import_file is defined and item.import_file != "" and item.state != 'present'

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


