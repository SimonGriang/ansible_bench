opy:\n    src: "{{ rke2_custom_manifests_local }}"\n    dest: "{{ rke2_data_dir }}/manifests/"\n    remote_src: yes\n  when: rke2_custom_manifests_local is defined\n\n- name: Copy Static Pods\n  ansible.builtin.copy:\n    src: "{{ rke2_static_pods_local }}"\n    dest: "{{ rke2_agent_dir }}/"\n    remote_src: yes\n  when: rke2_static_pods_local is defined\n\n- name: Copy RKE2 environment file\n  ansible.builtin.copy:\n    src: "{{ rke2_env_file_local }}"\n    dest: "/etc/rke2/rke2.yaml"\n  when: rke2_env_file_local is defined\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-11T09:33:30.663801552Z', 'done': True, 'done_reason': 'stop', 'total_duration': 96138889143, 'load_duration': 214366217, 'prompt_eval_count': 2730, 'prompt_eval_duration': 8942854138, 'eval_count': 1442, 'eval_duration': 86979584737, 'model_name': 'gemma3:27b'} id='run--ce7ec1bc-0d25-4eaf-8b89-558bf20adfaf-0' usage_metadata={'input_tokens': 2730, 'output_tokens': 1442, 'total_tokens': 4172}
