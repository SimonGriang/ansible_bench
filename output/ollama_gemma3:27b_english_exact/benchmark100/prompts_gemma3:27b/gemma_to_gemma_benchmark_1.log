---
- name: Create promtail system group
  ansible.builtin.group:
    name: "{{ promtail_system_group }}"
    state: present

- name: Create promtail directory
  ansible.builtin.file:
    path: "{{ promtail_directory }}"
    state: directory
    owner: "{{ promtail_system_group }}"
    group: "{{ promtail_system_group }}"
    mode: '0755'

- name: Create promtail user
  ansible.builtin.user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    additional_groups: "{{ promtail_user_additional_groups }}"
    shell: /usr/sbin/nologin
    createhome: false
    state: present
  when: promtail_system_user != "root"


