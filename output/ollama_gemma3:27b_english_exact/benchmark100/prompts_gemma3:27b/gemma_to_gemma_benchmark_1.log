fcate.content | b64decode }}"\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n    mode: \'0640\'\n  loop: "{{ items }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-11T08:31:45.510066672Z', 'done': True, 'done_reason': 'stop', 'total_duration': 45723127729, 'load_duration': 194240124, 'prompt_eval_count': 1757, 'prompt_eval_duration': 5660396800, 'eval_count': 709, 'eval_duration': 39867789997, 'model_name': 'gemma3:27b'} id='run--fe27d49f-5e88-4fac-aafb-ca89eff12033-0' usage_metadata={'input_tokens': 1757, 'output_tokens': 709, 'total_tokens': 2466}
