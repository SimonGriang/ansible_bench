content='```yaml\n---\n\n- name: Import assert.yml\n  import_tasks: assert.yml\n  delegate_to: localhost\n  run_once: true\n\n- name: Install python pip\n  package:\n    name: "{{ python_pip_packages }}"\n    state: present\n\n- name: Configure pip proxy\n  copy:\n    dest: /etc/pip.conf\n    content: |\n      [global]\n      index-url = {{ python_pip_proxy }}\n    mode: 0644\n  when: python_pip_proxy is defined\n\n- name: Trust hosts\n  copy:\n    dest: /etc/pip.conf\n    content: |\n      [global]\n      trusted-host = {{ python_pip_trusted_host }}\n    mode: 0644\n  when: python_pip_trusted_host is defined\n\n- name: Update pip\n  pip:\n    name: "{{ python_pip_pip_package }}"\n    state: "{{ python_pip_pip_state }}"\n    executable: "{{ python_pip_executable }}"\n  when: ansible_distribution != "Debian" or (ansible_distribution == "Debian" and ansible_distribution_release not in ["bookworm", "noble"]) or ansible_os_family != "Alpine"\n\n- name: Install requested modules\n  pip:\n    name: "{{ item.name }}"\n    state: "{{ item.state | default(\'present\') }}"\n    version: "{{ item.version | default(omit) }}"\n    executable: "{{ python_pip_executable }}"\n  loop: "{{ python_pip_modules }}"\n  loop_control:\n    label: "{{ item.name }}"\n  when: ansible_distribution != "Debian" or (ansible_distribution == "Debian" and ansible_distribution_release not in ["bookworm", "noble"]) or ansible_os_family != "Alpine"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-11T08:11:25.77282685Z', 'done': True, 'done_reason': 'stop', 'total_duration': 26973697305, 'load_duration': 204504045, 'prompt_eval_count': 686, 'prompt_eval_duration': 2362726564, 'eval_count': 424, 'eval_duration': 24404061220, 'model_name': 'gemma3:27b'} id='run--7ebb4b8d-b41b-42ef-a22b-cfcaaa3a6388-0' usage_metadata={'input_tokens': 686, 'output_tokens': 424, 'total_tokens': 1110}
