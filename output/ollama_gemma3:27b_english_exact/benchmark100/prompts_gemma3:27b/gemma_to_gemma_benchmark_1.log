---
- name: lookup bootstrap facts (raw)
  raw: cat /etc/os-release
  register: bootstrap_facts
  ansible_user: bootstrap_user
  check_mode: false

- name: set bootstrap facts (I) # noqa jinja
  set_fact:
    bootstrap_distribution: "{{ item.value | regex_search('^NAME=\"([^\"]+)\"', '\\1') }}"
    bootstrap_distribution_major_version: "{{ item.value | regex_search('VERSION_ID=\"([^\"]+)\"', '\\1') | split('.') | first }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - item.value | regex_search('PRETTY_NAME=\"([^\"]+)\"', '\\1')
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(None) }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: bootstrap_distribution in item.value
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(None) }}"
