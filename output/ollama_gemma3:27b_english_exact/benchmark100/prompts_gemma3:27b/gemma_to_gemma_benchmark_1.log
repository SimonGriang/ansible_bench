---
- name: Install dependencies
  package:
    name:
      - python3
      - python3-pip
    state: present

- name: Install docker-compose
  pip:
    name: docker-compose
    state: present

- name: Pull docker image
  docker_image:
    name: vault
    source: pull

- name: Create vault directory
  file:
    path: /opt/vault
    state: directory
    mode: '0755'

- name: Copy docker-compose.yml
  copy:
    src: docker-compose.yml
    dest: /opt/vault/docker-compose.yml

- name: Start Vault container
  docker_compose:
    project_src: /opt/vault
    state: present

- name: Enable vault (Non-OSS)
  block:
    - name: Check vault_type
      fail:
        msg: "Vault type is OSS. Skipping non-OSS enablement."
      when: vault_type == "oss"
  rescue:
    - name: Enable Vault Non-OSS
      command: "echo 'Enabling non-oss vault features'"
      changed_when: true
      register: enable_non_oss
      ignore_errors: true


