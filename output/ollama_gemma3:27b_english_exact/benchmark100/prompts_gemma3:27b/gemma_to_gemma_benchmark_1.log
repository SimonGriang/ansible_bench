---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Pre-configure debian systems
  when: ansible_os_family == "Debian"
  debconf:
    name: postfix
    question: config_directory
    value: ""
    template: "netselect"
  ignore_errors: true

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: virtual_mailbox_maps is defined or domains_using_mysql is defined

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    owner: root
    group: root
    mode: 0644
  notify:
    - validate postfix configuration
    - rebuild postfix database
  when: template_transport_maps is defined

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: 0644
  notify:
    - validate postfix configuration
    - reload postfix
  when: template_header_checks is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    main_cf_myhostname: "{{ ansible_fqdn }}"
    main_cf_mydomain: "{{ ansible_domain }}"
    main_cf_myorigin: "$mydomain"
    main_cf_mydestination: "$myhostname"
    main_cf_relayhost: ""
    main_cf_mynetworks: "127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128"
  when:
    - main_cf_myhostname is not defined
    - main_cf_mydomain is not defined

- name: Setting values for main.cf (2/2)
  set_fact:
    main_cf_virtual_alias_maps: "{{ virtual_alias_maps | default([]) }}"
    main_cf_virtual_mailbox_domains: "{{ virtual_mailbox_domains | default([]) }}"
    main_cf_virtual_mailbox_maps: "{{ virtual_mailbox_maps | default([]) }}"
    main_cf_alias_maps: "{{ alias_maps | default([]) }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    owner: root
    group: root
    mode: 0644
  notify:
    - validate postfix configuration
    - restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: 0644
  notify:
    - validate postfix configuration
    - restart postfix

- name: Creates cert/key directory
  file:
    path: "{{ postfix_tls_certs_dir }}"
    state: directory
    owner: root
    group: root
    mode: 0755
  when: postfix_tls_certs_dir is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_cert_src }}"
    dest: "{{ postfix_tls_cert_dest }}"
    owner: root
    group: root
    mode: 0644
  when: postfix_tls_cert_src is defined and postfix_tls_cert_dest is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_src }}"
    dest: "{{ postfix_tls_key_dest }}"
    owner: root
    group: root
    mode: 0600
  when: postfix_tls_key_src is defined and postfix_tls_key_dest is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: "{{ item }}"
    create: yes
  with_items: "{{ aliases }}"

- name: Configure sender_access
  lineinfile:
    path: /etc/postfix/sender_access
    line: "{{ item }}"
    create: yes
  with_items: "{{ sender_access }}"

- name: Configure recipient_access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: "{{ item }}"
    create: yes
  with_items: "{{ recipient_access }}"

- name: Place sasl_password_map
  copy:
    content: "{{ sasl_password_map_content | default('') }}"
    dest: /etc/postfix/sasl_password_map
    owner: root
    group: root
    mode: 0600

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes
