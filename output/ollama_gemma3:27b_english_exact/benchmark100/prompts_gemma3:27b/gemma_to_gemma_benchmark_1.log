---
- name: create directories
  file:
    path: /opt/cadvisor
    state: directory
    mode: 0755

- name: download cadvisor
  get_url:
    url: "{{ cadvisor_download }}"
    dest: /opt/cadvisor/cadvisor-{{ cadvisor_version }}
    checksum: "{{ cadvisor_checksum }}"
    mode: 0755
  when: cadvisor_binary_local_dir == ""

- name: propagate locally distributed cadvisor binary
  copy:
    src: "{{ cadvisor_binary_local_dir }}/cadvisor-{{ cadvisor_version }}"
    dest: /opt/cadvisor/cadvisor-{{ cadvisor_version }}
    mode: 0755
    owner: root
    group: root
  notify: restart cadvisor
  when: cadvisor_binary_local_dir != ""

- name: symlink cadvisor
  file:
    src: /opt/cadvisor/cadvisor-{{ cadvisor_version }}
    dest: /opt/cadvisor/cadvisor
    state: link
    force: yes

- name: server systemd service
  template:
    src: systemd-system-cadvisor-service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: 0644
  notify: restart cadvisor

- name: test_task
  shell: systemctl is-active cadvisor.service
  register: service_active
  ignore_errors: yes
  check_mode: no

- name: debug
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemd:
    name: cadvisor.service
    enabled: yes
    state: enabled

- name: cadvisor | start server systemd
  systemd:
    name: cadvisor.service
    state: started
    daemon_reload: yes


