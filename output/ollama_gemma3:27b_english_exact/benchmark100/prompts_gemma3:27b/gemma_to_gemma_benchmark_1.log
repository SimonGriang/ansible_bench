---
- name: Create document roots for virtual hosts
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - item.create_docroot

- name: Configure virtual hosts
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Enable virtual hosts
  ansible.builtin.command: "a2ensite {{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian'
  register: a2ensite_result
  until: a2ensite_result.rc == 0
  notify:
    - Test httpd configuration validity
    - Restart httpd
  ignore_errors: true


