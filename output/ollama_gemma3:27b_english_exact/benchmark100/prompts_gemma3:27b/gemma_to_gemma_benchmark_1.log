content='```yaml\n---\n- name: Create document roots for virtual hosts\n  ansible.builtin.file:\n    path: "{{ item.documentroot }}"\n    state: directory\n    mode: \'0755\'\n  loop: "{{ httpd_vhosts }}"\n  when:\n    - httpd_vhosts is defined\n    - item.documentroot is defined\n    - item.create_docroot\n\n- name: Configure virtual hosts\n  ansible.builtin.template:\n    src: "{{ vhost_conf_template }}"\n    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"\n    mode: \'0644\'\n  loop: "{{ httpd_vhosts }}"\n  notify:\n    - Test httpd configuration validity\n    - Restart httpd\n\n- name: Enable virtual hosts\n  ansible.builtin.command: "a2ensite {{ item.name }}.conf"\n  loop: "{{ httpd_vhosts }}"\n  when: ansible_os_family == \'Debian\'\n  register: a2ensite_result\n  until: a2ensite_result.rc == 0\n  notify:\n    - Test httpd configuration validity\n    - Restart httpd\n  ignore_errors: true\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-11T08:18:56.743107399Z', 'done': True, 'done_reason': 'stop', 'total_duration': 21702851439, 'load_duration': 210238009, 'prompt_eval_count': 1575, 'prompt_eval_duration': 5280707504, 'eval_count': 287, 'eval_duration': 16210717378, 'model_name': 'gemma3:27b'} id='run--acf0dddf-f189-4657-894f-027898204045-0' usage_metadata={'input_tokens': 1575, 'output_tokens': 287, 'total_tokens': 1862}
