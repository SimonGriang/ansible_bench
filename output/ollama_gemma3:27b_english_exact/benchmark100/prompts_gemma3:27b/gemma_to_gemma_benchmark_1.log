    with_items: "{{ java_certs }}"
    register: check_java_certs

  - name: Fail if Java Certificate Doesn't Exist
    fail:
      msg: "Java certificate does not exist: {{ item.item }}"
    when: not item.stat.exists
    with_items: "{{ check_java_certs.results }}"

  - name: Set Keystore Directory for Java < 11
    set_fact:
      java_keystore_dir: "{{ java_keystore_dir_old }}"
    when: java_keystore_dir is not defined or java_keystore_dir is none and java_open_jdk_version_major < 11

  - name: Set Keystore Directory for Java >= 11
    set_fact:
      java_keystore_dir: "{{ java_keystore_dir_new }}"
    when: java_keystore_dir is not defined or java_keystore_dir is none and java_open_jdk_version_major >= 11

  - name: Import SSL Certificates into Java Keystore
    java_cert:
      path: "{{ item }}"
      keystore: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/truststore.jks"
      password: "{{ java_cert_keystore_pass }}"
      alias: "{{ item | regex_replace('[^a-zA-Z0-9_]', '') }}"
      state: present
      create: yes
    with_items: "{{ java_certs }}"


