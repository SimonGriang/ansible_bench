---
- name: Create vault directory
  ansible.builtin.file:
    path: "{{ vault_directory }}"
    state: directory
    mode: '0700'
    owner: root
    group: root

- name: Copy vault file
  ansible.builtin.copy:
    src: "{{ vault_file_src }}"
    dest: "{{ vault_file_dest }}"
    owner: root
    group: root
    mode: '0600'

- name: Secure vault file
  ansible.builtin.shell:
    cmd: "find / -name 'vault' -print0 | xargs -0 grep -i 'password'"
  register: vault_history_check
  changed_when: "'vault' in vault_history_check.stdout"
  ignore_errors: true

- name: Configure SELinux / AppArmor
  ansible.builtin.block:
    - name: Install selinux-policy package
      ansible.builtin.package:
        name: selinux-policy
        state: present
      when: vault_hardening_configure_selinux_apparmor and ansible_selinux.status == "enabled"

    - name: Set SELinux policy to targeted and state to enforcing
      ansible.builtin.selinux:
        policy: targeted
        state: enforcing
      when: vault_hardening_configure_selinux_apparmor and ansible_selinux.status == "enabled"
