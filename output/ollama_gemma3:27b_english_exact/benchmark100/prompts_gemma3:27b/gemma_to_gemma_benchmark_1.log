---
- name: Download RKE2 installation script
  ansible.builtin.get_url:
    url: "{{ rke2_install_url }}"
    dest: /tmp/rke2-install.sh
    mode: '0755'
  when: rke2_airgap is defined and not rke2_airgap

- name: Copy local RKE2 installation script
  ansible.builtin.copy:
    src: "{{ rke2_install_script_local }}"
    dest: /tmp/rke2-install.sh
    mode: '0755'
  when: rke2_airgap is defined and rke2_airgap and rke2_implementation == 'copy'

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0755'
  when: rke2_airgap is defined and rke2_airgap and rke2_implementation != 'exists'

- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)
  block:
    - name: Attempt remote download of RKE2 artifacts
      ansible.builtin.get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}/"
        validate_certs: false
      register: remote_download_result
      ignore_errors: true

    - name: Fallback to local download and push
      block:
        - name: Copy local artifacts
          ansible.builtin.copy:
            src: "{{ rke2_artifacts_local }}"
            dest: "{{ rke2_artifacts_path }}/"
            remote_src: yes
        - name: Copy local checksum
          ansible.builtin.copy:
            src: "{{ rke2_checksum_local }}"
            dest: "{{ rke2_checksum_path }}"
            remote_src: yes
      when: remote_download_result.failed
  when: rke2_airgap is defined and rke2_airgap

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "{{ rke2_artifacts_local }}"
    dest: "{{ rke2_artifacts_path }}/"
    remote_src: yes
  when: rke2_airgap is defined and rke2_airgap and rke2_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  ansible.builtin.copy:
    src: "{{ rke2_additional_images_local }}"
    dest: "{{ rke2_artifacts_path }}/"
    remote_src: yes
  when: rke2_airgap is defined and rke2_airgap and rke2_additional_images_local is defined

- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged
  ansible.builtin.file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0755'
  when: rke2_airgap is defined and rke2_airgap

- name: Populate service facts
  ansible.builtin.service_facts:

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local
  register: usr_local_stats

- name: Check if separate partition
  ansible.builtin.set_fact:
    rke2_usr_local_separate_partition: "{{ usr_local_stats.df.mountpoint == '/usr/local' }}"

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: "/usr/local/bin/rke2"
  when: rke2_usr_local_separate_partition

- name: Check RKE2 version
  ansible.builtin.command: rke2 --version
  register: rke2_version_output
  ignore_errors: true

- name: Set RKE2 versions
  ansible.builtin.set_fact:
    rke2_installed_version: "{{ rke2_version_output.stdout | regex_search('rke2 version (.*)', '\\1') | default('unknown') }}"
    rke2_running_version: "{{ rke2_running_version | default('unknown') }}"

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - rke2_installed_version is version(rke2_target_version, '>=')
    msg: "Attempting to downgrade RKE2 from {{ rke2_installed_version }} to {{ rke2_target_version }} is not allowed."
  when: rke2_target_version is defined and (rke2_allow_downgrade is not defined or not rke2_allow_downgrade)

- name: Run RKE2 install script
  ansible.builtin.shell:
    cmd: /tmp/rke2-install.sh
  environment:
    RKE2_TARGET_VERSION: "{{ rke2_target_version }}"
    RKE2_CHANNEL: "{{ rke2_channel }}"

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: "{{ rke2_custom_manifests_local }}"
    dest: "{{ rke2_data_dir }}/manifests/"
    remote_src: yes
  when: rke2_custom_manifests_local is defined

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ rke2_static_pods_local }}"
    dest: "{{ rke2_agent_dir }}/"
    remote_src: yes
  when: rke2_static_pods_local is defined

- name: Copy RKE2 environment file
  ansible.builtin.copy:
    src: "{{ rke2_env_file_local }}"
    dest: "/etc/rke2/rke2.yaml"
  when: rke2_env_file_local is defined


