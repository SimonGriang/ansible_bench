---

  - name: gather bootstrap facts using raw command
    raw: cat /etc/os-release
    register: bootstrap_facts
    ignore_errors: true
    no_log: false
    become: false
    gather_facts: false

  - name: set bootstrap facts (I) based on OS release information
    set_fact:
      bootstrap_distribution: "{{ item.0 }}"
      bootstrap_distribution_major_version: "{{ item.1 | regex_search('^([0-9]+)', '\\1') | default('') }}"
    with_items:
      - [ "ubuntu", "20" ]
      - [ "debian", "11" ]
      - [ "centos", "7" ]
      - [ "redhat", "8" ]
      - [ "rocky", "8" ]
      - [ "alma", "8" ]
    when: bootstrap_facts.rc == 0 and bootstrap_distribution is not defined
    vars:
      bootstrap_search: "{{ bootstrap_facts.stdout | lower | search(item.0) }}"

  - name: set bootstrap facts (II) based on OS family
    set_fact:
      bootstrap_os_family: "{{ item.0 }}"
    with_items: "{{ bootstrap_os_family_map.items() }}"
    loop_control:
      label: "{{ item.0 }}"
    when: bootstrap_distribution in item.1


