---
  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Wait for port to be available
    wait_for:
      port: "{{ bootstrap_port | default(22) }}"
      timeout: "{{ bootstrap_timeout | default(300) }}"
    when: ansible_connection is defined and ansible_connection != 'container' and bootstrap_wait_for_host is true

  - name: Prepare system
    block:
      - name: Test connection and sudo
        command: echo "Testing connection and sudo"
        register: test_result
        changed_when: false
        failed_when: test_result.rc != 0
    rescue:
      - name: Gather facts
        setup:
          gather_subset:
            - hardware
            - network
            - virtualization
      - name: Install bootstrap packages via raw
        raw: "yum install -y {{ bootstrap_rescue_packages | default('') }}"
        when: ansible_os_family == "RedHat"
      - name: Ensure libdnf5 is present
        package:
          name: libdnf5
          state: present
        when: ansible_os_family == "RedHat"

  - name: Gather ansible facts
    setup:

  - name: Install bootstrap packages (package)
    package:
      name: "{{ bootstrap_facts_packages | default([]) }}"
      state: present
      update_cache: true
      become: "{{ bootstrap_become | default(true) }}"
