    state: directory
  when: not vault_check_path.stat.exists and vault_path

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
    state: directory
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command:
    cmd: "openssl req -x509 -newkey rsa:4096 -keyout tls.key -out tls.crt -days 365 -nodes -subj '/CN=vault.local'"
    chdir: "{{ vault_data_directory }}/tls/"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: /usr/bin/vault
    owner: root
    group: root
    mode: 0755
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setcap:
    cap: cap_ipc_lock=ep
    path: /usr/bin/vault
    state: present

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0644
    state: touch
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    owner: root
    group: root
    mode: 0755
    state: directory

- name: Copy Vault service file
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: 0644
  notify: Daemon reload
  when: ansible_service_manager == "systemd"

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: 0644
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


