---
- name: Configure RKE2 nodes
  hosts: all
  become: true
  tasks:
    - name: Install required packages
      package:
        name:
          - curl
          - iptables
        state: present

    - name: Restart RKE2 service
      service:
        name: rke2-server
        state: restarted
      notify: "Service (re)started"

    - name: Wait for all nodes to be ready
      wait_for:
        host: "{{ inventory_hostname }}"
        port: 6443
        state: started
        timeout: 300


