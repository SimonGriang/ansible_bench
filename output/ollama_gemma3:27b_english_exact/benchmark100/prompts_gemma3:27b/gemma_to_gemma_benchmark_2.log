---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify: restart rke2

- name: Copy kubelet config
  template:
    src: kubelet.yaml.j2
    dest: /etc/rancher/rke2/kubelet.yaml
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  template:
    src: containerd-mirror.conf.j2
    dest: /etc/containerd/config.toml.d/00-rancher-mirror.conf
    mode: '0644'
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
  notify: restart rke2

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    daemon_reload: yes
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  retries: 5
  delay: 10
  register: rke2_start_result
  notify: restart rke2

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ item }}"
    masked: yes
    disabled: yes
  loop:
    - rke2-agent
    - rke2-cri-socket
  when: rke2_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    kubectl get nodes -o wide | grep Ready | awk '{print $1}' | wc -l
  register: ready_nodes_no_cni
  until: ready_nodes_no_cni.stdout == "{{ rke2_node_count }}"
  retries: 60
  delay: 10
  when: rke2_cni == 'none' and ansible_hostname == rke2_server_address or ansible_hostname == rke2_first_server_address

- name: Wait for remaining nodes to be ready - with CNI
  shell: |
    kubectl get nodes -o wide | grep Ready | awk '{print $1}' | wc -l
  register: ready_nodes_with_cni
  until: ready_nodes_with_cni.stdout == "{{ rke2_node_count }}"
  retries: 60
  delay: 10
  when: rke2_cni != 'none' and ansible_hostname == rke2_server_address or ansible_hostname == rke2_first_server_address


