---
  tasks:
    - name: Restart the RKE2 service
      service:
        name: "{{ rke2_service_name }}"
        state: restarted
      notify: Service (re)started

    - name: Wait for all nodes to be ready
      shell: "kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' | grep -c true"
      delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
      retries: 100
      delay: 15
      until: "{{ rke2_data_path }} kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' | grep -c true == {{ rke2_cluster_group_name | length }}"
      run_once: true

    - name: Wait for all pods to be ready
      shell: "{{ rke2_data_path }} kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods --all-namespaces -o jsonpath='{.items[?(@.status.phase!="Running" && @.status.phase!="Succeeded")].metadata.name}' | wc -l"
      delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
      retries: 100
      delay: 15
      until: "{{ rke2_data_path }} kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods --all-namespaces -o jsonpath='{.items[?(@.status.phase!="Running" && @.status.phase!="Succeeded")].metadata.name}' | wc -l == 0"
      run_once: true
      when: rke2_wait_for_all_pods_to_be_ready and not ansible_check_mode


