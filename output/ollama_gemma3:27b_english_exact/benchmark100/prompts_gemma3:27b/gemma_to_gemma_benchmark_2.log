            flat: yes
        - name: Copy to remote hosts
          copy:
            src: "{{ rke2_checksum_file }}"
            dest: "{{ rke2_checksum_file }}"
      when: remote_download.rc != 0
  when: airgap_mode

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local }}"
    dest: "{{ rke2_artifacts_path }}"
    remote_src: yes
  when: airgap_mode and implementation == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_artifacts_path }}"
    remote_src: yes
  loop: "{{ rke2_additional_images }}"
  when: airgap_mode

- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged
  file:
    path: "{{ rke2_artifacts_path }}/{{ item }}"
    mode: '0644'
  loop: "{{ rke2_artifacts }}"
  when: airgap_mode

- name: Populate service facts
  setup:
    filter: ansible_service_*

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stats

- name: Check if separate partition
  set_fact:
    separate_usr_local: usr_local_stats.df.mount != '/'

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin/rke2
  when: not separate_usr_local

- name: Check RKE2 version
  command: rke2 --version
  register: rke2_version
  ignore_errors: yes

- name: Set RKE2 versions
  set_fact:
    installed_rke2_version: "{{ rke2_version.stdout | regex_search('rke2 version (.*)', '\\1') | default('unknown') }}"
    running_rke2_version: "{{ installed_rke2_version }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - installed_rke2_version == desired_rke2_version
    msg: "Attempting to downgrade RKE2 from {{ installed_rke2_version }} to {{ desired_rke2_version }}.  This is not allowed unless explicitly authorized."
  when: allow_downgrade is not defined or not allow_downgrade

- name: Run RKE2 install script
  command: /tmp/rke2_install.sh -- --kubelet-version {{ kubelet_version }}
  environment:
    RKE2_VERSION: "{{ desired_rke2_version }}"
  when: airgap_mode and implementation == 'copy'

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_manifests_path }}"
    remote_src: yes
  loop: "{{ rke2_custom_manifests }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_manifests_path }}"
    remote_src: yes
  loop: "{{ rke2_static_pods }}"

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: /etc/rke2/rke2.yaml


