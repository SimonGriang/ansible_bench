          ansible.builtin.apt_repository:
            repo: deb [signed-by=/etc/apt/keyrings/hashicorp.gpg] https://releases.hashicorp.com {{ hashicorp_architecture_mapping[ansible_architecture] }} {{ ansible_distribution_release }} main
            state: present
            filename: hashicorp
