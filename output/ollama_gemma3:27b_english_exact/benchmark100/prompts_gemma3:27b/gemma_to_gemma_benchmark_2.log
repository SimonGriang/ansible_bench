---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "-jmx-remote -jmx-remote-ssl"

- name: Install RPM
  copy:
    src: "{{ java_source_rpm }}"
    dest: /tmp/java.rpm
  when: java_source == "local" and java_format == "rpm"
  
- name: Install RPM package
  package:
    name: /tmp/java.rpm
    state: present
  when: java_source == "local" and java_format == "rpm"

- name: Install DEB
  copy:
    src: "{{ java_source_deb }}"
    dest: /tmp/java.deb
  when: java_source == "local" and java_format == "deb"

- name: Install DEB package
  package:
    name: /tmp/java.deb
    state: present
  when: java_source == "local" and java_format == "deb"

- name: Install oracle java (rpm) (repository)
  package:
    name: java
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  file:
    path: "{{ java_install_dir }}"
    state: directory
    mode: '0755'
  when: java_format == "targz" and java_vendor == "oracle"

- name: Extract oracle targz
  unarchive:
    src: "{{ java_source_targz }}"
    dest: "{{ java_install_dir }}"
    remote_src: yes
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_jce_source }}"
    dest: "{{ java_install_dir }}/jre/lib/security/"
    remote_src: yes
  when: java_jce and java_version == "8" and java_vendor == "oracle"

- name: Set alternative (targz)
  alternatives:
    name: java
    path: "{{ java_install_dir }}/bin/java"
    state: auto
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  shell: "readlink -f /usr/bin/java"
  register: java_path
  changed_when: false

- name: Extract JAVA_HOME directory
  set_fact:
    java_home: "{{ java_path.stdout | dirname }}"

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME="{{ java_home }}"'
