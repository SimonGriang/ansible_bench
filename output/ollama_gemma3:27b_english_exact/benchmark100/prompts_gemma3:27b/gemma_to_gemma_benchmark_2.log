---

  - name: Enable the Backports repository for Debian
    apt_repository:
      repo: deb http://deb.debian.org/debian {{ ansible_distribution_release }} backports
      state: present
      filename: backports
    when: ansible_distribution == 'Debian' and ansible_distribution_major_version|int < 9
    become: true

  - name: Set the default_release fact for older Debian versions
    set_fact:
      ansible_default_release: "{{ ansible_distribution_release }}-backports"
    when: ansible_distribution == 'Debian' and ansible_distribution_major_version|int < 9

  - name: Install Ansible
    apt:
      name: ansible
      state: "{{ ansible_package_state }}"
      release: "{{ ansible_default_release }}"
    become: true


