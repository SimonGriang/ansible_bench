      - name: my_app_1
        port: 8080
      - name: my_app_2
        port: 9000

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: "/etc/init.d/{{ item.name }}"
    mode: 0755
  loop: "{{ service_list }}"
  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]


