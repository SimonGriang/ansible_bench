---

- name: Check OS compatibility
  ansible.builtin.setup:
    gather_subset:
      - '!hardware'
  register: ansible_facts
  tags:
    - compatibility

- name: Install epel gpg key
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present
  tags:
    - epel

- name: Install epel-release package
  ansible.builtin.yum:
    name: epel-release
    state: present
    update_cache: false
  notify: Update package cache
  tags:
    - epel

- name: Install epel-next-release package
  ansible.builtin.yum:
    name: epel-next-release
    state: present
    update_cache: false
  when: epel_next
  notify: Update package cache
  tags:
    - epel
    - epel-next


