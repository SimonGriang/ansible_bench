content='---\n- name: Check for EFI directory\n  ansible.builtin.stat:\n    path: /sys/firmware/efi/efivars/\n  register: grub_efi\n\n- name: Remove existing grub.cfg on EFI systems\n  ansible.builtin.file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: grub_efi.stat.exists\n\n- name: Install user template for grub\n  ansible.builtin.template:\n    src: 01_users.j2\n    dest: /etc/grub.d/01_users\n    owner: root\n    group: root\n    mode: 0644\n  notify: Update grub\n\n- name: Add password to grub configuration on EFI systems\n  ansible.builtin.lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"\n    regexp: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"\n    insertafter: EOF\n    create: true\n  when: grub_efi.stat.exists\n  notify: Update grub\n\n- name: Add password to grub configuration on MBR systems\n  ansible.builtin.lineinfile:\n    path: /etc/grub2.cfg\n    line: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"\n    regexp: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"\n    insertafter: EOF\n    create: true\n  when: grub_efi.stat.exists\n  notify: Update grub\n\n- name: Add --unrestricted flag to grub configuration\n  ansible.builtin.replace:\n    path: "{{ item }}"\n    regexp: \'CLASS .*\'\n    replace: \'\\g<0> --unrestricted\'\n  with_items: "{{ grub_password_unrestricted_files }}"\n  when: grub_password_unrestricted\n  notify: Update grub\n' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-21T06:56:33.806604214Z', 'done': True, 'done_reason': 'stop', 'total_duration': 32115359666, 'load_duration': 198236793, 'prompt_eval_count': 2365, 'prompt_eval_duration': 7114711135, 'eval_count': 458, 'eval_duration': 24800966399, 'model_name': 'gemma3:27b'} id='run--60e5a6cc-b41d-4a5d-8179-4055e4735ea9-0' usage_metadata={'input_tokens': 2365, 'output_tokens': 458, 'total_tokens': 2823}
