---
- name: Install dependencies
  apt:
    name:
      - python3-pip
    state: present
    update_cache: yes

- name: Install docker-compose
  pip:
    name: docker-compose
    state: present

- name: Pull docker image
  docker_image:
    name: vault:latest
    pull: yes

- name: Create vault directory
  file:
    path: /opt/vault
    state: directory
    mode: '0755'

- name: Copy docker-compose.yml
  copy:
    src: docker-compose.yml
    dest: /opt/vault/docker-compose.yml

- name: Start Vault container
  docker_compose:
    project_src: /opt/vault
    state: present

- name: Enable vault (Non-OSS)
  command: "echo 'false'"
  when: vault_type != "oss"


