    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: List databases
  community.mysql.mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
    query: "SHOW DATABASES;"
  register: mysql_databases_list

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
    import_file: "{{ item.import_target }}"
  loop: "{{ mysql_databases }}"
  when: item.import_target is defined and item.import_target != ""

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges | default('*.*') }}"
    host: "{{ item.host | default('%') }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


