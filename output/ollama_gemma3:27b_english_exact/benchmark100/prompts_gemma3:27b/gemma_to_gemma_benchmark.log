---
  - name: Import assert.yml
    include_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Install apache httpd
    package:
      name: "{{ httpd_packages }}"
      state: present

  - name: Configure selinux
    block:
      - name: Set SELinux booleans
        seboolean:
          name: "{{ item.name }}"
          state: "{{ item.state }}"
        loop: "{{ httpd_sebooleans }}"

      - name: Allow httpd connections on custom ports
        firewalld:
          port: "{{ item }}"
          permanent: true
          state: enabled
        loop:
          - "{{ httpd_port }}"
          - "{{ httpd_ssl_port }}"
        when:
          - ansible_facts['distribution'] == "CentOS"
          - ansible_facts['distribution'] == "RedHat"

    when: ansible_facts['selinux']['enabled']

  - name: Configure httpd
    template:
      src: "{{ httpd_config_src }}"
      dest: "{{ httpd_config_dest }}"
      mode: 0644
    notify:
      - test httpd configuration
      - restart httpd

  - name: Activate httpd module | Debian
    command: a2enmod "{{ item }}"
    loop: "{{ httpd_modules_to_activate_with_command }}"
    when:
      - ansible_facts['distribution'] == "Debian"
      - ansible_facts['distribution'] == "Ubuntu"

  - name: Import ssl.yml
    include_tasks: ssl.yml
    when: https_ssl_enable

  - name: Import locations.yml
    include_tasks: locations.yml
    when: httpd_locations is defined

  - name: Import vhosts.yml
    include_tasks: vhosts.yml
    when: httpd_vhosts is defined

  - name: Configure ports
    template:
      src: "{{ httpd_ports_conf.j2 }}"
      dest: "{{ httpd_ports_conf }}"
      mode: 0644
    notify:
      - test httpd configuration
      - restart httpd
    when:
      - ansible_facts['distribution'] == "Debian"
      - ansible_facts['distribution'] == "Ubuntu"
      - ansible_facts['distribution'] == "Suse"

  - name: Import directories.yml
    include_tasks: directories.yml
    when: httpd_directories is defined

  - name: Flush handlers
    meta: flush_handlers

  - name: Removing default html
    file:
      path: "{{ httpd_data_directory }}/index.html"
      state: absent
    when: httpd_remove_example

  - name: Start and enable httpd
    service:
      name: "{{ httpd_service }}"
      state: started
      enabled: true


