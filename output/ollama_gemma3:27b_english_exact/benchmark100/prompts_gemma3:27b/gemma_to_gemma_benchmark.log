- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Pre-configure debian systems
  become: true
  debconf:
    name: postfix
    question: mailtype
    value: "No configuration"
  when: ansible_os_family == "Debian"

- name: Install postfix
  become: true
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  become: true
  apt:
    name: postfix-mysql
    state: present
  when: virtual_mailbox_maps | bool or domains_using_mysql | bool

- name: Configure postfix (transport_maps)
  become: true
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    owner: root
    group: root
    mode: 0644
  notify:
    - validate postfix
    - rebuild postfix database
  when: transport_maps_template is defined

- name: Configure postfix (header_checks)
  become: true
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: 0644
  notify:
    - validate postfix
    - reload postfix
  when: header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    myhostname: "{{ ansible_hostname }}"
    mydomain: "{{ ansible_domain }}"
    myorigin: "$mydomain"
    relayhost: ""
  when:
    - myhostname is not defined
    - mydomain is not defined
    - myorigin is not defined
    - relayhost is not defined

- name: Setting values for main.cf (2/2)
  set_fact:
    mynetworks: "{{ mynetworks | default([]) }}"
    home_mailbox: "{{ home_mailbox | default('/home/$user') }}"
    virtual_mailbox_domains: "{{ virtual_mailbox_domains | default([]) }}"
    virtual_mailbox_maps: "{{ virtual_mailbox_maps | default([]) }}"
    virtual_alias_maps: "{{ virtual_alias_maps | default([]) }}"
    sender_canonical_maps: "{{ sender_canonical_maps | default([]) }}"

- name: Configure postfix (main.cf)
  become: true
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    owner: root
    group: root
    mode: 0644
  notify:
    - validate postfix
    - restart postfix

- name: Configure postfix (master.cf)
  become: true
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: 0644
  notify:
    - validate postfix
    - restart postfix

- name: Creates cert/key directory
  become: true
  file:
    path: "{{ postfix_tls_key_dir }}"
    state: directory
    owner: root
    group: root
    mode: 0755
  when: postfix_tls_key_dir is defined

- name: Deploy Postfix TLS server certificate
  become: true
  copy:
    src: "{{ postfix_tls_cert_src }}"
    dest: "{{ postfix_tls_cert_dest }}"
    owner: root
    group: root
    mode: 0644
  when: postfix_tls_cert_src is defined

- name: Deploy Postfix TLS server key
  become: true
  copy:
    src: "{{ postfix_tls_key_src }}"
    dest: "{{ postfix_tls_key_dest }}"
    owner: root
    group: root
    mode: 0600
  when: postfix_tls_key_src is defined

- name: Flush handlers
  handlers:
    - name: validate postfix
      command: postfix check
    - name: rebuild postfix database
      command: postmap /etc/postfix/transport_maps
    - name: reload postfix
      command: postfix reload
    - name: restart postfix
      command: systemctl restart postfix

- name: Configure aliases
  become: true
  lineinfile:
    path: /etc/aliases
    line: "{{ item }}"
    create: yes
  loop: "{{ postfix_aliases }}"

- name: Configure sender_access
  become: true
  lineinfile:
    path: /etc/postfix/sender_access
    line: "{{ item }}"
    create: yes
  loop: "{{ sender_access_entries }}"

- name: Configure recipient_access
  become: true
  lineinfile:
    path: /etc/postfix/recipient_access
    line: "{{ item }}"
    create: yes
  loop: "{{ recipient_access_entries }}"

- name: Place sasl_password_map
  become: true
  copy:
    dest: /etc/postfix/sasl_password_map
    content: "{{ sasl_password_map_content }}"
    owner: root
    group: root
    mode: 0600

- name: Flush handlers again
  handlers:
    - name: validate postfix
      command: postfix check
    - name: rebuild postfix database
      command: postmap /etc/postfix/transport_maps
    - name: reload postfix
      command: postfix reload
    - name: restart postfix
      command: systemctl restart postfix

- name: Start and enable postfix
  become: true
  service:
    name: postfix
    state: started
    enabled: yes


