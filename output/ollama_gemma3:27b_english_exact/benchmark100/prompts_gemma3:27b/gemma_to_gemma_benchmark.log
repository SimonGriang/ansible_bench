---

- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "-jre-doc -jre-src"

- name: Install RPM
  package:
    name: "{{ java_source }}/{{ java_package }}"
    state: present
  when: java_source == "local" and java_format == "rpm"
  become: true
  become_method: sudo
  before_task:
    - name: Copy RPM to /tmp/
      copy:
        src: "{{ java_package }}"
        dest: /tmp/
        remote_src: true

- name: Install DEB
  package:
    name: "{{ java_source }}/{{ java_package }}"
    state: present
  when: java_source == "local" and java_format == "deb"
  become: true
  become_method: sudo
  before_task:
    - name: Copy DEB to /tmp/
      copy:
        src: "{{ java_package }}"
        dest: /tmp/
        remote_src: true

- name: Install oracle java (rpm) (repository)
  package:
    name: java
    state: present
  when: java_source == "repository" and java_format == "rpm"
  become: true
  become_method: sudo

- name: Configure oracle targz
  block:
    - name: Ensure installation directory exists
      file:
        path: "{{ java_install_dir }}"
        state: directory
        mode: '0755'
    - name: Extract targz archive
      unarchive:
        src: "{{ java_package }}"
        dest: "{{ java_install_dir }}"
        remote_src: true
  when: java_format == "targz" and java_vendor == "oracle"
  become: true
  become_method: sudo

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_jce_package }}"
    dest: "{{ java_install_dir }}"
    remote_src: true
  when: java_jce and java_version == "8" and java_vendor == "oracle"
  become: true
  become_method: sudo

- name: Set alternative (targz)
  alternatives:
    name: java
    path: "{{ java_install_dir }}/bin/java"
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"
  become: true
  become_method: sudo

- name: Find JAVA_HOME
  shell: "readlink -f /usr/bin/java | sed 's/\/bin\/java//'"
  register: java_home_result
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  block:
    - name: Create /etc/profile.d directory if it doesn't exist
      file:
        path: /etc/profile.d
        state: directory
        mode: '0755'
    - name: Create /etc/profile.d/java_home.sh
      copy:
        dest: /etc/profile.d/java_home.sh
        content: |
          export JAVA_HOME={{ java_home_result.stdout }}
        mode: '0644'
  become: true
  become_method: sudo


