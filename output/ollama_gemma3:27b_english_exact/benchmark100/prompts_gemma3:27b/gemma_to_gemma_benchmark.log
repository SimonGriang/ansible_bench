---

  - name: Import assert.yml
    import_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Wait for port to be available
    wait_for:
      port: "{{ bootstrap_port | default(22) }}"
      timeout: "{{ bootstrap_timeout | default(300) }}"
    when: ansible_connection is defined and ansible_connection != 'container' and bootstrap_wait_for_host is true

  - name: Prepare system
    block:
      - name: Test connection and sudo access
        command: echo "Testing connection and sudo"
        become: true
        ignore_errors: true
    rescue:
      - name: Gather facts
        setup:
      - name: Install bootstrap packages via raw
        raw: yum install -y {{ bootstrap_facts_packages | join(' ') }}
        become: true
        when: ansible_os_family == "RedHat"
      - name: Ensure libdnf5 is present on RedHat-based systems
        package:
          name: libdnf5
          state: present
        become: true
        when: ansible_os_family == "RedHat"

  - name: Gather ansible facts
    setup:

  - name: Install bootstrap packages (package)
    package:
      name: "{{ bootstrap_facts_packages | default([]) }}"
      state: present
      update_cache: true
      become: "{{ bootstrap_become | default(true) }}"


