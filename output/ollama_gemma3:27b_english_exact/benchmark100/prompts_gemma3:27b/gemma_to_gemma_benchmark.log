  - name: Wait for port to be available
    wait_for:
      port: "{{ ansible_port | default(22) }}"
      timeout: "{{ bootstrap_timeout | default(300) }}"
    when: ansible_connection is defined and ansible_connection != 'container' and bootstrap_wait_for_host
    become: false

  - name: Prepare system
    shell: "test -f /etc/os-release && sudo -n true"
    register: prepare_system_result
    failed_when: prepare_system_result.rc != 0
    become: false
    rescue:
      - name: Gather bootstrap facts
        setup:
          filter: ansible_facts.bootstrap_*
      - name: Install bootstrap packages (package)
        package:
          name: "{{ bootstrap_facts_packages }}"
          state: present
        become: true

  - name: Gather ansible facts
    setup:
    become: false

  - name: Install bootstrap packages (package)
    package:
      name: "{{ bootstrap_facts_packages | default([]) }}"
      state: present
    become: "{{ bootstrap_become | default(false) }}"


