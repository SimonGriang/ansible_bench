---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0750"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  ansible.builtin.user:
    name: "{{ dns_owner }}"
    system: true
    createhome: false
    group: "{{ dns_group }}"

- name: Generate rndc key
  ansible.builtin.command: rndc-confgen -a -k rndc.key -n
  args:
    creates: "{{ dns_confdir }}/rndc.key"
  become: true
  become_user: root

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0600"

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/named.root"
    mode: "0644"
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.zone }}.db"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0644"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0644"
  notify: Restart dns
  register: named_conf_result
  failed_when: named_conf_result.rc != 0

- name: Place systemd override
  block:
    - name: Create systemd override directory
      ansible.builtin.file:
        path: /etc/systemd/system/{{ dns_service }}.service.d
        state: directory
        mode: "0755"
    - name: Copy systemd override file
      ansible.builtin.copy:
        src: systemd_override.conf
        dest: /etc/systemd/system/{{ dns_service }}.service.d/override.conf
        mode: "0644"
    - name: Reload systemd daemon
      ansible.builtin.systemd:
        daemon_reload: true
  when: ansible_service_mgr == "systemd"

- name: Start and enable dns
  ansible.builtin.service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


