    content: "{{ openssl_private_key.content | b64decode }}\n{{ openssl_certifcate.content | b64decode }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
    mode: 0600
  loop: "{{ openssl_certificates }}"


