- name: Check for EFI directory
  ansible.builtin.stat:
    path: /sys/firmware/efi/efivars/
  register: grub_efi

- name: Remove existing grub.cfg on EFI systems
  ansible.builtin.file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: grub_efi.stat.exists

- name: Install user template for grub
  ansible.builtin.template:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    owner: root
    group: root
    mode: 0644
  notify: Update grub

- name: Add password to grub configuration on EFI systems
  ansible.builtin.lineinfile:
    path: /etc/grub2-efi.cfg
    line: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"
    regexp: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"
    insertafter: EOF
    create: true
  when: grub_efi.stat.exists
  notify: Update grub

- name: Add password to grub configuration on MBR systems
  ansible.builtin.lineinfile:
    path: /etc/grub2.cfg
    line: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"
    regexp: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"
    insertafter: EOF
    create: true
  when: grub_efi.stat.exists
  notify: Update grub

