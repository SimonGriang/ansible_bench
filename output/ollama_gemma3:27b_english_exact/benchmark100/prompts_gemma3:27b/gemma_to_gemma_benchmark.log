content='```yaml\n---\n\n  - name: Update apt cache\n    apt:\n      update_cache: yes\n    when: ansible_pkg_mgr == "apt"\n\n  - name: Update dnf cache\n    dnf:\n      update_cache: yes\n    when: ansible_pkg_mgr == "dnf"\n\n  - name: Install packages\n    package:\n      name: keepalived\n      state: present\n\n  - name: Create directory for keepalived\n    file:\n      path: /etc/keepalived\n      owner: root\n      group: root\n      mode: 0755\n      state: directory\n\n  - name: Create Kubernetes API health check script for Debian OS family\n    template:\n      src: check_apiserver.sh.j2\n      dest: /etc/keepalived/check_apiserver.sh\n      owner: root\n      group: root\n      mode: 0755\n    notify: Restart keepalived\n    when: ansible_os_family == "Debian"\n\n  - name: Create Kubernetes API health check script for RedHat OS famliy\n    template:\n      src: check_apiserver.sh.j2\n      dest: /usr/libexec/keepalived/check_apiserver.sh\n      owner: root\n      group: root\n      mode: 0755\n    notify: Restart keepalived\n    when: ansible_os_family == "RedHat"\n\n  - name: Create RKE2 Server health check script for Debian OS family\n    template:\n      src: check_rke2server.sh.j2\n      dest: /etc/keepalived/check_rke2server.sh\n      owner: root\n      group: root\n      mode: 0755\n    notify: Restart keepalived\n    when: ansible_os_family == "Debian"\n\n  - name: Create RKE2 Server health check script for RedHat OS family\n    template:\n      src: check_rke2server.sh.j2\n      dest: /usr/libexec/keepalived/check_rke2server.sh\n      owner: root\n      group: root\n      mode: 0755\n    notify: Restart keepalived\n    when: ansible_os_family == "RedHat"\n\n  - name: Create keepalived config file\n    template:\n      src: keepalived.conf.j2\n      dest: /etc/keepalived/keepalived.conf\n      owner: root\n      group: root\n      mode: 0644\n    notify: Restart keepalived\n\n  - name: Enable keepalived and make sure it is not masked\n    systemd:\n      name: keepalived\n      enabled: yes\n      masked: no\n    notify: Restart keepalived\n\n  - name: Flush handlers\n    meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-21T10:21:16.85985989Z', 'done': True, 'done_reason': 'stop', 'total_duration': 42218409409, 'load_duration': 183255097, 'prompt_eval_count': 882, 'prompt_eval_duration': 2756926985, 'eval_count': 659, 'eval_duration': 39277569602, 'model_name': 'gemma3:27b'} id='run--4bca5b2d-5a17-4f0f-b539-d4d1eafa1aa2-0' usage_metadata={'input_tokens': 882, 'output_tokens': 659, 'total_tokens': 1541}
