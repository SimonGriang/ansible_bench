content='```yaml\n---\n\n  - name: gather bootstrap facts using raw command\n    raw: cat /etc/os-release\n    register: bootstrap_facts\n    ignore_errors: true\n    no_log: false\n    become: false\n    gather_facts: false\n\n  - name: set bootstrap facts (I) based on OS release information\n    set_fact:\n      bootstrap_distribution: "{{ item.0 }}"\n      bootstrap_distribution_major_version: "{{ item.1 | regex_search(\'^\\\\d+(\\\\.\\\\d+)?$\') | first }}"\n    loop: "{{ bootstrap_os_family_map | dict2items }}"\n    when:\n      - bootstrap_facts.rc == 0\n      - bootstrap_distribution is not defined\n      - bootstrap_facts.stdout | lower | regex_search(bootstrap_search[loop_control.key], ignorecase=True)\n    loop_control:\n      key: "{{ item.0 }}"\n\n  - name: set bootstrap facts (II) based on OS family\n    set_fact:\n      bootstrap_os_family: "{{ item.0 }}"\n    loop: "{{ bootstrap_os_family_map | dict2items }}"\n    when: bootstrap_distribution in item.1\n    loop_control:\n      label: "{{ item.0 }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-21T07:01:15.663632484Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17987641383, 'load_duration': 222513882, 'prompt_eval_count': 580, 'prompt_eval_duration': 1937368426, 'eval_count': 291, 'eval_duration': 15826685375, 'model_name': 'gemma3:27b'} id='run--64c75f34-cbd6-4f24-affe-65fe3b6f5e84-0' usage_metadata={'input_tokens': 580, 'output_tokens': 291, 'total_tokens': 871}
