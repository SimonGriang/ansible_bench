---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  copy:
    dest: /etc/pip.conf
    content: |
      [global]
      index-url = {{ python_pip_proxy }}
    mode: 0644
  when: python_pip_proxy is defined

- name: Trust hosts
  copy:
    dest: /etc/pip.conf
    content: |
      [global]
      trusted-host = {{ python_pip_trusted_host }}
    mode: 0644
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when: ansible_distribution != "Debian" or ansible_distribution_release != "bookworm"
  when: ansible_distribution != "Debian" or ansible_distribution_release != "noble"
  when: ansible_os_family != "Alpine"

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(omit) }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  loop_control:
    label: "{{ item.name }}"
  when: ansible_distribution != "Debian" or ansible_distribution_release != "bookworm"
  when: ansible_distribution != "Debian" or ansible_distribution_release != "noble"
  when: ansible_os_family != "Alpine"


