content='```yaml\n---\n  tasks:\n    - name: Restart the RKE2 service\n      service:\n        name: "{{ rke2_service_name }}"\n        state: restarted\n      notify: Service (re)started\n\n    - name: Wait for all nodes to be ready\n      shell: |\n        kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o jsonpath="{.items[*].status.conditions[?(@.type==\'Ready\')].status}" | grep -c "True"\n      register: ready_nodes\n      until: ready_nodes.stdout == "{{ rke2_cluster_group_name | length }}"\n      retries: 100\n      delay: 15\n      delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"\n      run_once: true\n\n    - name: Wait for all pods to be ready\n      shell: |\n        kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods --all-namespaces -o jsonpath="{.items[*].status.phase}" | grep -v \'Running\\|Succeeded\' | wc -l\n      register: pending_pods\n      until: pending_pods.stdout == "0"\n      retries: 100\n      delay: 15\n      delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"\n      run_once: true\n      when: rke2_wait_for_all_pods_to_be_ready | bool and not ansible_check_mode\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-21T10:25:40.577642536Z', 'done': True, 'done_reason': 'stop', 'total_duration': 26161511312, 'load_duration': 212864708, 'prompt_eval_count': 723, 'prompt_eval_duration': 2482931285, 'eval_count': 376, 'eval_duration': 23463803905, 'model_name': 'gemma3:27b'} id='run--431e2907-3a37-4b6c-b476-b526523af25c-0' usage_metadata={'input_tokens': 723, 'output_tokens': 376, 'total_tokens': 1099}
