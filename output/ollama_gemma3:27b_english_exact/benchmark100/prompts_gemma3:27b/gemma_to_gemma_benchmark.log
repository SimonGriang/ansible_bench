---
  - name: Check if all variables have been set correctly
    import_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - name: Wait for host to be reachable
    local_connection: true
    become: true
    when: ansible_connection != "container" and ansible_connection != "docker" and bootstrap_wait_for_host
    wait_for:
      port: 22
      host: "{{ ansible_ssh_host | default(ansible_host) | default(inventory_hostname) }}"
      timeout: "{{ bootstrap_timeout }}"

  - name: Prepare the system
    block:
      - name: Test connection
        wait_for_connection:
        register: bootstrap_connect

      - name: Debug bootstrap_timeout if connection fails
        debug:
          msg: "Connection failed. Check bootstrap_timeout variable."
        when: bootstrap_connect.failed

      - name: Gather bootstrap facts
        import_tasks: gather_facts.yml
    always:
      - name: Gather facts
        setup:
          gather_subset:
            - hardware
            - network
            - virtualization

  - name: Install bootstrap packages
    raw: "{{ bootstrap_install_command }}"
    shell: "{{ bootstrap_install_command }}"
    register: bootstrap_install_packages
    become: true
    changed_when:
      - ansible_facts['os_family'] in ['Alpine', 'Archlinux', 'Gentoo'] and bootstrap_install_packages.stdout | regex_search(bootstrap_expected_stdout_regex)
      - ansible_facts['os_family'] not in ['Alpine', 'Archlinux', 'Gentoo'] and bootstrap_install_packages.stdout | regex_search(bootstrap_expected_stdout_regex) == False
    vars:
      bootstrap_user: "{{ bootstrap_user | default('root') }}"

  - name: Ensure system is prepared by issuing ansible modules
    block:
      - name: Gather ansible facts
        setup:

      - name: Install packages
        package:
          name: "{{ bootstrap__facts_packages }}"
          state: present
          update_cache: true


