---

- name: Create ssh_key_directory for user
  file:
    path: "{{ ssh_key_directory }}"
    state: directory
    mode: '0700'
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Manage user account
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment | default('') }}"
    home: "{{ user.home | default('/home/' + user.name) }}"
    create_home: yes
    password: "{{ user.password | default('') }}"
    uid: "{{ user.uid | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    shell: "{{ user.shell | default('/bin/bash') }}"
    expiry: "{{ user.expiry | default(omit) }}"
  register: user_result

- name: Set sudo options for user
  template:
    src: sudoers.j2
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: '0440'
    validate: visudo -cf %s
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"

- name: Remove sudo options for user
  file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: absent
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.sudo is not defined

- name: Generate private ssh key for user
  command: "ssh-keygen -t rsa -N '' -f {{ ssh_private_key_path }}"
  args:
    creates: "{{ ssh_private_key_path }}"
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Generate public ssh key for user
  command: "ssh-keygen -y -f {{ ssh_private_key_path }} > {{ ssh_public_key_path }}"
  args:
    creates: "{{ ssh_public_key_path }}"
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Convert ssh key to ppk for user
  command: "ssh-keygen -p -f {{ ssh_private_key_path }} -m PEM"
  args:
    creates: "{{ ssh_private_key_path }}"
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Get or set the home directory for user
  command: getent passwd {{ user.name }}
  register: user_info
  changed_when: false
  failed_when: user_info.rc != 0
  ignore_errors: true
  
- name: Set user home directory fact
  set_fact:
    user_home: "{{ user_info.stdout | regex_search(':\\/home\\/([a-zA-Z0-9_-]+)') | first | default('/home/' + user.name) }}"
  when: user_info.rc == 0

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.manage_ssh_key is defined or private_keys is defined

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys }}"

- name: Copy generated private ssh key for user
  copy:
    src: "{{ ssh_private_key_path }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.copy_private_key is defined

- name: Check users password valid time
  command: "chage -l {{ user.name }}"
  register: chage_output
  ignore_errors: true
  changed_when: false

- name: Set users password valid time
  command: "chage -M {{ user.password_max_age }} {{ user.name }}"
  when: user.password_max_age is defined

- name: Place private key file for user
  copy:
    content: "{{ item.private_key }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  loop: "{{ user.private_keys }}"
  when: user.private_keys is defined


