---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify: restart rke2

- name: Copy kubelet config
  template:
    src: kubelet.yaml.j2
    dest: /etc/rancher/rke2/kubelet.yaml
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  template:
    src: containerd-registry-mirrors.conf.j2
    dest: /etc/containerd/config.toml
    mode: '0644'
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
  notify: restart rke2

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    daemon_reload: yes
    retries: 5
    delay: 10
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  register: rke2_service_result
  notify: restart rke2

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ item }}"
    masked: yes
    disabled: yes
  loop:
    - rke2-agent
    - rke2-cri-socket
  when: rke2_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  shell: |
    kubectl get nodes -o wide | grep -q "Ready" && kubectl get nodes -o wide | grep -q "Memory" && kubectl get nodes -o wide | grep -q "Disk" && kubectl get nodes -o wide | grep -q "PID" && ! kubectl get pods -n kube-system -l k8s-app=kube-dns -o wide | grep -q "CNI"
  register: node_ready_no_cni
  until: node_ready_no_cni.rc == 0
  retries: 30
  delay: 10
  when: rke2_cni == 'none' and (inventory_hostname == groups['rke2_server'][0] or inventory_hostname == groups['rke2_first_server'][0])

- name: Wait for remaining nodes to be ready - with CNI
  shell: kubectl get nodes -o wide | grep "Ready" | wc -l
  register: node_ready_cni
  until: node_ready_cni.stdout == "{{ rke2_node_count }}"
  retries: 30
  delay: 10
  when: rke2_cni != 'none' and (inventory_hostname == groups['rke2_server'][0] or inventory_hostname == groups['rke2_first_server'][0])


