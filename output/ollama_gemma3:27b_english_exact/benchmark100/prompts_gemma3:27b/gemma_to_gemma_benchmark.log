---

  - name: Import assert.yml
    import_tasks: assert.yml
    run_once: true
    delegate_to: localhost

  - block:
    - name: Install repository for RedHat
      copy:
        dest: /etc/yum.repos.d/hashicorp.repo
        content: "{{ lookup('file', 'files/hashicorp.repo') }}"
        mode: 0640
      when: ansible_os_family == "RedHat" or ansible_os_family == "Rocky"

    - name: Configure debian
      block:
        - name: Install required package gpg
          package:
            name: gpg
            state: present

        - name: Install apt key for Debian
          apt_key:
            url: https://releases.hashicorp.com/gpg
            state: present
            validate_certs: false

        - name: Install repository for Debian
          apt_repository:
            repo: deb https://releases.hashicorp.com {{ ansible_distribution_release }} main
            state: present
            filename: hashicorp
            arch: "{{ hashicorp_architecture_mapping[ansible_architecture] }}"
      when: ansible_os_family == "Debian"

    - name: Install hashicorp product using package
      block:
        - name: Install latest hashicorp product using package
          package:
            name: "{{ item }}"
            state: latest
          loop: "{{ hashicorp_products }}"
          labels:
            - "Install latest"

        - name: Install versioned hashicorp product using package
          package:
            name: "{{ item + version_coupler + hashicorp_versions[item] }}"
            state: present
          loop: "{{ hashicorp_products }}"
          when: hashicorp_versions[item] is defined
          labels:
            - "Install versioned"
      when: hashicorp_installation_method == "package"

  - block:
    - name: Install hashicorp product manually
      unarchive:
        src: "{{ hashicorp_src[item] }}"
        dest: "{{ hashicorp_dest }}"
        group: "{{ hashicorp_group }}"
        mode: "{{ hashicorp_mode }}"
        owner: "{{ hashicorp_owner }}"
      loop: "{{ hashicorp_products }}"
      when: hashicorp_installation_method == "manual"


