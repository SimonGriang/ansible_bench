content='```yaml\n---\n\n  - name: Check Java Certificate Existence\n    stat:\n      path: "{{ item }}"\n    register: check_java_certs\n    with_items: "{{ java_certs }}"\n\n  - name: Fail if Java Certificate Doesn\'t Exist\n    fail:\n      msg: "Java certificate {{ item }} does not exist."\n    when: check_java_certs.results[loop.index].stat.exists == false\n    with_items: "{{ java_certs }}"\n\n  - name: Set Keystore Directory for Java < 11\n    set_fact:\n      java_keystore_dir: "{{ java_keystore_dir_old }}"\n    when: java_keystore_dir is not defined or java_keystore_dir is none and java_open_jdk_version_major < 11\n\n  - name: Set Keystore Directory for Java >= 11\n    set_fact:\n      java_keystore_dir: "{{ java_keystore_dir_new }}"\n    when: java_keystore_dir is not defined or java_keystore_dir is none and java_open_jdk_version_major >= 11\n\n  - name: Import SSL Certificates into Java Keystore\n    java_cert:\n      path: "{{ item }}"\n      keystore: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/truststore.jks"\n      keystore_pass: "{{ java_cert_keystore_pass }}"\n      alias: "{{ item | basename | regex_replace(\'.*\\\\.(.*)$\', \'\\\\1\') }}"\n      state: present\n      create: yes\n    with_items: "{{ java_certs }}"\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-21T09:17:53.586475413Z', 'done': True, 'done_reason': 'stop', 'total_duration': 26396851422, 'load_duration': 4844077723, 'prompt_eval_count': 679, 'prompt_eval_duration': 2305516565, 'eval_count': 378, 'eval_duration': 19246506864, 'model_name': 'gemma3:27b'} id='run--81fcd7ba-a683-4c51-8786-f8be45c5b7ac-0' usage_metadata={'input_tokens': 679, 'output_tokens': 378, 'total_tokens': 1057}
