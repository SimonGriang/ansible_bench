---
  - name: Migrate from adoptopenjdk to temurin if selected
    set_fact:
      java_jdk_vendor: "temurin"
    when: java_jdk_vendor == "adoptopenjdk"

  - name: Gather OS specific variables
    include_vars:
      file: "os_variables.yml"
    when:
      - java_jdk_vendor is defined
      - ansible_distribution is defined
      - ansible_distribution_major_version is defined

  - name: Gather architecture specific variables
    include_vars:
      file: "architecture.yml"

  - name: Set OS specific variables (I)
    set_fact:
      java_open_jdk_version: "{{ java_open_jdk_version | default('11') }}"
      java_open_jdk_repositories: "{{ java_open_jdk_repositories | default([]) }}"
      java_open_jdk_libs: "{{ java_open_jdk_libs | default([]) }}"

  - name: Set OS and architecture specific variables (II)
    set_fact:
      java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/java') }}"
      java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-11-jdk') }}"

  - name: Set specific variables
    set_fact:
      java_home: "{{ java_open_jdk_home }}"

  - name: Remove deprecated repositories (Debian)
    apt_repository:
      repo: "{{ item }}"
      state: absent
    loop: "{{ java_deprecated_repositories_adoptopenjdk | default([]) }}"
    when: ansible_distribution == "Debian" or ansible_distribution == "Ubuntu"

  - name: Install extra apt tools (Debian)
    apt:
      name: "{{ java_open_jdk_apt_extra_packages | default([]) }}"
      state: present
    when:
      - ansible_distribution == "Debian"
      - ansible_distribution == "Ubuntu"
      - java_open_jdk_apt_extra_packages is defined

  - name: Add required key repositories (Debian)
    apt_key:
      url: "{{ item }}"
      state: present
    loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
    when: ansible_distribution == "Debian" or ansible_distribution == "Ubuntu"

  - name: Add required repositories (Debian)
    apt_repository:
      repo: "{{ item }}"
      state: present
    loop: "{{ java_required_repositories_openjdk | default([]) }}"
    when: ansible_distribution == "Debian" or ansible_distribution == "Ubuntu"

  - name: Add required key repositories (RedHat)
    rpm_key:
      key: "{{ item }}"
      state: present
    loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
    when: ansible_distribution in ["RedHat", "CentOS", "AlmaLinux", "Rocky"]

  - name: Add required repositories (RedHat)
    yum_repository:
      name: "{{ item.name }}"
      description: "{{ item.description }}"
      baseurl: "{{ item.baseurl }}"
      enabled: "{{ item.enabled | default(true) }}"
      gpgcheck: "{{ item.gpgcheck | default(true) }}"
      gpgkey: "{{ item.gpgkey | default('') }}"
    loop: "{{ java_required_repositories_openjdk | default([]) }}"
    when: ansible_distribution in ["RedHat", "CentOS", "AlmaLinux", "Rocky"]

  - name: Install required libs
    package:
      name: "{{ java_required_libs_openjdk | default([]) }}"
      state: present

  - name: Install Java (Debian)
    apt:
      name: "{{ java_open_jdk_package }}"
      state: present
    when:
      - ansible_distribution == "Debian"
      - ansible_distribution == "Ubuntu"

  - name: Install Java (RedHat)
    yum:
      name: "{{ java_open_jdk_package }}"
      state: present
    when:
      - ansible_distribution in ["RedHat", "CentOS", "AlmaLinux", "Rocky"]

  - name: Export environment variables
    template:
      src: jdk.sh.j2
      dest: /etc/profile.d/jdk.sh
      mode: 0755

  - name: Source environment variables
    command: source /etc/profile
    changed_when: false

  - name: Correct java version selected (Debian, Java < 11)
    alternatives:
      name: java
      path: "/usr/lib/jvm/java-8-openjdk-amd64/jre/bin/java"
      state: present
    when:
      - ansible_distribution in ["Debian", "Ubuntu"]
      - java_open_jdk_version | int < 11

  - name: Correct java version selected (Debian, Java >= 11)
    alternatives:
      name: java
      path: "/usr/lib/jvm/java-11-openjdk-amd64/jre/bin/java"
      state: present
    when:
      - ansible_distribution in ["Debian", "Ubuntu"]
      - java_open_jdk_version | int >= 11


