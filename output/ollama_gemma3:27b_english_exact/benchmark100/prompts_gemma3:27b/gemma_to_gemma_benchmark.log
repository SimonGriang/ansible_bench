  command: "ssh-keygen -p -f {{ ssh_private_key_path }} -m PEM"
  args:
    creates: "{{ ssh_private_key_path }}"
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Get or set the home directory for user
  command: getent passwd {{ user.name }}
  register: user_info
  changed_when: false
  failed_when: user_info.rc != 0
  ignore_errors: true

- name: Set user home directory fact
  set_fact:
    user_home: "{{ user_info.stdout | regex_search(':\\/home\\/([a-zA-Z0-9_-]+)') | first | default('/home/' + user.name) }}"
  when: user_info.rc == 0

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.manage_ssh_key is defined or private_keys is defined

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys }}"

- name: Copy generated private ssh key for user
  copy:
    src: "{{ ssh_private_key_path }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.copy_private_key is defined

- name: Check users password valid time
  command: "chage -l {{ user.name }}"
  register: chage_output
  ignore_errors: true
  changed_when: false

- name: Set users password valid time
  command: "chage -M {{ user.password_max_age }} {{ user.name }}"
  when: user.password_max_age is defined

- name: Place private key file for user
  copy:
    content: "{{ item.private_key }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  loop: "{{ user.private_keys }}"
  when: user.private_keys is defined


