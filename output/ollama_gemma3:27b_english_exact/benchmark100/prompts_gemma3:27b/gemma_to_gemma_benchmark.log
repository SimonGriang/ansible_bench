---
- name: Install dirmngr
  ansible.builtin.apt:
    name: dirmngr
    state: present

- name: Add Ansible PPA repository
  ansible.builtin.apt_repository:
    repo: ppa:ansible/ansible
    state: present
  become: true
  when: ansible_distribution == "Ubuntu" or ansible_distribution == "Debian"

- name: Install Ansible package
  ansible.builtin.apt:
    name: ansible
    state: "{{ ansible_package_state }}"
  become: true
  when: ansible_package_state is defined


