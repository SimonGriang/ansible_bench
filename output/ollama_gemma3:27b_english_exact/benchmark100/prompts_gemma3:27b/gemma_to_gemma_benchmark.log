---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: user_check
  failed_when: not user_check.passwd and fail_key

- name: Create directory for git configuration
  file:
    path: /home/{{ git_username }}
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0700'

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: /home/{{ git_username }}/.gitconfig
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0600'

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Clone all roles
