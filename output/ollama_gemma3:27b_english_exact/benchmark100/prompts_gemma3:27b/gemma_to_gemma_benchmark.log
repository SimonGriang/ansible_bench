content='---\n- name: Manage group\n  group:\n    name: "{{ group.name }}"\n    state: "{{ group.state | default(\'present\') }}"\n    gid: "{{ group.gid | default(omit) }}"\n    system: "{{ group.system | default(omit) }}"\n\n- name: Set sudo options for group\n  when: group.sudo_options is defined\n  block:\n    - template:\n        src: sudo_group.j2\n        dest: "/etc/sudoers.d/{{ group.name | replace(\'.\', \'dot\') }}"\n        mode: "0640"\n    - command: visudo -c -f /etc/sudoers.d/{{ group.name | replace(\'.\', \'dot\') }}\n      changed_when: true\n' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-21T08:51:21.142388805Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11302458927, 'load_duration': 215201368, 'prompt_eval_count': 720, 'prompt_eval_duration': 70577192, 'eval_count': 173, 'eval_duration': 11015551244, 'model_name': 'gemma3:27b'} id='run--5a028bf1-6c9d-44ca-aa3e-5bcc7db90665-0' usage_metadata={'input_tokens': 720, 'output_tokens': 173, 'total_tokens': 893}
