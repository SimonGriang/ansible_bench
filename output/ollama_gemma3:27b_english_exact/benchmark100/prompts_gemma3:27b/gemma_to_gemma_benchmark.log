---

  - name: Create the RKE2 config directory
    file:
      path: /etc/rancher/rke2
      state: directory
      owner: root
      group: root
      mode: '0755'

  - name: Set server taints
    set_fact:
      combined_node_taints: "{{ rke2_server_node_taints | join(',') }}"
    when: rke2_type == 'server'

  - name: Copy rke2 config
    template:
      src: rke2.yaml.j2
      dest: /etc/rancher/rke2/rke2.yaml
      owner: root
      group: root
      mode: '0644'
    notify: Config file changed

  - name: Copy kubelet config
    template:
      src: kubelet.yaml.j2
      dest: /etc/rancher/rke2/kubelet.yaml
      owner: root
      group: root
      mode: '0644'
    notify: Config file changed
    when: rke2_kubelet_config | length > 0

  - name: Copy Containerd Registry Configuration file
    template:
      src: containerd-mirror.yaml.j2
      dest: /etc/containerd/config.toml.d/mirror.conf
      owner: root
      group: root
      mode: '0644'
    notify: Config file changed
    when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

  - name: Register if we need to do a etcd restore from file
    set_fact:
      do_etcd_restore: true
    when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != "" and rke2_server is not defined or rke2_server == "false"

  - name: Register if we need to do a etcd restore from s3
    set_fact:
      do_etcd_restore_from_s3: true
    when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != "" and rke2_etcd_snapshot_s3_options is defined

  - name: Restore etcd from file
    command: >
      rke2 server --snapshot-file {{ rke2_etcd_snapshot_file }}
    when: do_etcd_restore
    args:
      creates: /etc/rancher/rke2/etcd/db
    become: true

  - name: Restore etcd from s3
    command: >
      rke2 server --snapshot-s3-options "{{ rke2_etcd_snapshot_s3_options }}" --snapshot-file "{{ rke2_etcd_snapshot_file }}"
    when: do_etcd_restore_from_s3
    args:
      creates: /etc/rancher/rke2/etcd/db
    become: true

  - name: Start RKE2 service on the first server
    systemd:
      name: rke2-server.service
      state: started
      enabled: true
      env:
        RKE2_TOKEN: "{{ rke2_token }}"
    when: ansible_hostname == groups['rke2_cluster_group_name'][0]
    notify: Service (re)started
    become: true

  - name: Mask RKE2 agent service on the first server
    systemd:
      name: rke2-agent.service
      state: masked
      enabled: false
    when: ansible_hostname == groups['rke2_cluster_group_name'][0]
    become: true

  - name: Wait for the first server be ready - no CNI
    shell: kubectl get pods -A -o wide
    register: kubectl_output
    until: "'Running' in kubectl_output.stdout and 'kube-system/coredns' in kubectl_output.stdout"
    timeout: 300
    when: ansible_hostname == groups['rke2_cluster_group_name'][0]

  - name: Wait for the first server be ready - with CNI
    shell: kubectl get pods -A -o wide
    register: kubectl_output
    until: "'Ready' in kubectl_output.stdout and 'kube-system/coredns' in kubectl_output.stdout"
    timeout: 300
    when: ansible_hostname == groups['rke2_cluster_group_name'][0]

  - name: Restore etcd
    command: rke2 etcd-snapshot restore
    become: true

  - name: Set an Active Server variable
    set_fact:
      active_server: "{{ ansible_hostname }}"
    delegate_to: "{{ groups['rke2_cluster_group_name'][0] }}"


