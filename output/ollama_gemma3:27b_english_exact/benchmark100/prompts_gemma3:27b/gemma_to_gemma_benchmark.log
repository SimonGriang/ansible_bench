---
- name: Download RKE2 installation script
  command: curl -sSL https://get.rke2.io | sh
  register: rke2_install_script
  changed_when: rke2_install_script.rc != 0
  when: rke2_airgap is not defined or not rke2_airgap

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local }}"
    dest: /tmp/rke2_install.sh
    mode: '0755'
  when: rke2_airgap is defined and rke2_airgap and rke2_implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0755'
  when: rke2_airgap is defined and rke2_airgap and rke2_implementation != 'exists'

- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)
  block:
    - name: Attempt remote download
      command: curl -sSL "{{ rke2_checksum_url }}" -o "{{ rke2_checksum_file }}"
      register: remote_download
      ignore_errors: true

    - name: Fallback to local download and push
      block:
        - name: Download locally
          fetch:
            src: "{{ rke2_checksum_local }}"
            dest: "{{ rke2_checksum_file }}"
            flat: yes
        - name: Copy artifacts
          copy:
            src: "{{ rke2_artifacts_local }}"
            dest: "{{ rke2_artifacts_path }}"
            remote_src: yes
            mode: '0755'
      when: remote_download.rc != 0
  when: rke2_airgap is defined and rke2_airgap

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local }}"
    dest: "{{ rke2_artifacts_path }}"
    remote_src: yes
    mode: '0755'
  when: rke2_airgap is defined and rke2_airgap and rke2_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_artifacts_path }}"
    remote_src: yes
    mode: '0755'
  loop: "{{ rke2_additional_images }}"
  when: rke2_airgap is defined and rke2_airgap

- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged
  file:
    path: "{{ rke2_artifacts_path }}/{{ item }}"
    mode: '0755'
  loop: "{{ rke2_artifact_files }}"
  when: rke2_airgap is defined and rke2_airgap

- name: Populate service facts
  setup:
    filter: ansible_service_units
    gather_subset: '!all'

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: usr_local_stats

- name: Check if separate partition
  set_fact:
    rke2_separate_usr_local: "{{ usr_local_stats.fstype != 'ext4' and usr_local_stats.fstype != 'xfs' }}"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin/rke2"

- name: Check RKE2 version
  command: rke2 --version
  register: rke2_version
  ignore_errors: true

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version.stdout | regex_search('rke2 version (.*)') | default('') | trim }}"
    rke2_running_version: "{{ rke2_version.stdout | regex_search('rke2 version (.*)') | default('') | trim }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_desired_version is not defined or rke2_desired_version == rke2_installed_version
    msg: "Attempting to downgrade RKE2 is not allowed unless explicitly permitted."

- name: Run RKE2 install script
  command: sh /tmp/rke2_install.sh
  environment:
    RKE2_VERSION: "{{ rke2_desired_version }}"
  when: rke2_airgap is defined and rke2_airgap

- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_custom_manifests_src }}"
    dest: "{{ rke2_data_dir }}"
    remote_src: yes
    mode: '0644'
  when: rke2_custom_manifests_src is defined

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_src }}"
    dest: "{{ rke2_agent_dir }}"
    remote_src: yes
    mode: '0644'
  when: rke2_static_pods_src is defined

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: /etc/rke2/rke2.yaml
    mode: '0644'
  when: rke2_env_file is defined
