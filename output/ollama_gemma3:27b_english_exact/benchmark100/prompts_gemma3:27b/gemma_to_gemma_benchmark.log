24, 'load_duration': 207800510, 'prompt_eval_count': 1422, 'prompt_eval_duration': 4432433736, 'eval_count': 557, 'eval_duration': 33445231357, 'model_name': 'gemma3:27b'} id='run--9e9ebdaf-60cd-4fff-9b46-99f5f603cd51-0' usage_metadata={'input_tokens': 1422, 'output_tokens': 557, 'total_tokens': 1979}
