    dest: "{{ postfix_tls_cert_dest }}"
    owner: root
    group: root
    mode: 0644
  when: postfix_tls_cert_src is defined

- name: Deploy Postfix TLS server key
  become: true
  copy:
    src: "{{ postfix_tls_key_src }}"
    dest: "{{ postfix_tls_key_dest }}"
    owner: root
    group: root
    mode: 0600
  when: postfix_tls_key_src is defined

- name: Flush handlers
  handlers:
    - name: validate postfix
      command: postfix check
    - name: rebuild postfix database
      command: postmap /etc/postfix/transport_maps
    - name: reload postfix
      command: postfix reload
    - name: restart postfix
      command: systemctl restart postfix

- name: Configure aliases
  become: true
  lineinfile:
    path: /etc/aliases
    line: "{{ item }}"
    create: yes
  loop: "{{ postfix_aliases }}"

- name: Configure sender_access
  become: true
  lineinfile:
