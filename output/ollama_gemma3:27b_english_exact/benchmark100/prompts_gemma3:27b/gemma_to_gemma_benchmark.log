---
- name: Install promtail packages
  package:
    name:
      - promtail
    state: present

- name: Configure promtail configuration file
  template:
    src: promtail.conf.j2
    dest: /etc/promtail/promtail.conf
    owner: root
    group: root
    mode: '0644'
  notify: Restart promtail

- name: Create the promtail user
  user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    additional_groups: "{{ promtail_user_additional_groups }}"
    shell: /usr/sbin/nologin
    createhome: false
  when: promtail_system_user != "root"

- name: Restart promtail
  service:
    name: promtail
    state: restarted
  when: restart_promtail | bool


