---

  - name: Import assert.yml
    include_tasks: assert.yml
    delegate_to: localhost
    run_once: true

  - name: Configure apk
    apk:
      update_cache: yes
      upgrade: yes
    when: ansible_pkg_mgr == "apk"
    notify: Reboot

  - name: Configure apt
    apt:
      update_cache: yes
      upgrade: yes
      autoremove: "{{ apt_autoremove | default(false) }}"
      autoclean: yes
      exclude: "{{ update_excluded_packages | default([]) }}"
    when: ansible_pkg_mgr == "apt"
    notify: Reboot

  - name: Update all software (dnf)
    dnf:
      update_cache: yes
      update_only: yes
      exclude: "{{ update_excluded_packages | default([]) }}"
    when: ansible_pkg_mgr in ["dnf", "dnf5"]
    notify: Reboot

  - name: Update all software (pacman)
    pacman:
      update_cache: yes
      upgrade: yes
    when: ansible_pkg_mgr == "pacman"
    notify: Reboot

  - name: Configure yum
    yum:
      name: '*'
      state: latest
      exclude: "{{ update_excluded_packages | default([]) }}"
    when: ansible_pkg_mgr == "yum" and ansible_distribution == "CentOS" and ansible_distribution_major_version == "6"
    notify: Reboot

  - name: Configure yum
    yum:
      name: '*'
      state: latest
      exclude: "{{ update_excluded_packages | default([]) }}"
    when: ansible_pkg_mgr == "yum" and (ansible_distribution != "CentOS" or ansible_distribution_major_version != "6")
    notify: Reboot

  - name: Update all software (zypper)
    zypper:
      name: '*'
      state: latest
      exclude: "{{ update_excluded_packages | default([]) }}"
    when: ansible_pkg_mgr == "zypper"
    notify: Reboot


