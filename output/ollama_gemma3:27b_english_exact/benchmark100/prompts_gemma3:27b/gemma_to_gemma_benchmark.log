    state: present
  tags:
    - epel

- name: Install epel-release package
  ansible.builtin.yum:
    name: epel-release
    state: present
    update_cache: false
  notify: Update package cache
  tags:
    - epel

- name: Install epel-next-release package
  ansible.builtin.yum:
    name: epel-next-release
    state: present
    update_cache: false
  when: epel_next
  notify: Update package cache
  tags:
    - epel
    - epel-next


