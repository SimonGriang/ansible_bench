---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0750"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    system: true
    createhome: false
    group: "{{ dns_group }}"

- name: Generate rndc key
  command: rndc-confgen -a -k rndc.key -n
  args:
    creates: "{{ dns_confdir }}/rndc.key"
  become: true
  become_user: root

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0600"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/named.root"
    mode: "0644"
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.zone }}.db"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0644"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0644"
  notify: Restart dns
  register: named_conf_result
  failed_when: named_conf_result.rc != 0

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: /etc/systemd/system/{{ dns_service }}.service.d
        state: directory
        mode: "0755"
    - name: Copy systemd override file
      copy:
        src: systemd_override.conf
        dest: /etc/systemd/system/{{ dns_service }}.service.d/override.conf
        mode: "0644"
    - name: Reload systemd daemon
      systemd:
        daemon_reload: true
  when: ansible_service_mgr == "systemd"

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


