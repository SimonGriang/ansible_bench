ver.key\n\n- name: Copy ca.crt and ta.key to /etc/openvpn\n  ansible.builtin.copy:\n    src: /etc/openvpn/easy-rsa/pki/{{ item }}\n    dest: /etc/openvpn/{{ item }}\n    mode: 0640\n  loop:\n    - ca.crt\n    - ta.key\n\n- name: Place the server configuration file\n  ansible.builtin.template:\n    src: server.conf.j2\n    dest: "{{ openvpn_configuration_directory }}/server.conf"\n    owner: root\n    group: root\n    mode: 0640\n  notify: Restart openvpn\n```' additional_kwargs={} response_metadata={'model': 'gemma3:27b', 'created_at': '2025-10-21T07:59:00.016251834Z', 'done': True, 'done_reason': 'stop', 'total_duration': 54206344129, 'load_duration': 210869342, 'prompt_eval_count': 2000, 'prompt_eval_duration': 6266393544, 'eval_count': 837, 'eval_duration': 47728388598, 'model_name': 'gemma3:27b'} id='run--2a64eb61-734c-4f20-ace0-8467cd6831fb-0' usage_metadata={'input_tokens': 2000, 'output_tokens': 837, 'total_tokens': 2837}
