---
- ansible.builtin.import_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  ansible.builtin.yum:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  ansible.builtin.yum:
    name: rsyslog
    state: present

- name: Install additional rsyslog packages
  ansible.builtin.yum:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features }}"

- name: Configuring default rsyslog
  ansible.builtin.template:
    src: default.conf.j2
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: '0640'
  when: rsyslog_deploy_default_config

- name: Make configuration directory
  ansible.builtin.file:
    path: /etc/rsyslog.d/
    state: directory
    mode: '0750'

- name: Configuring rsyslog forward rule
  ansible.builtin.template:
    src: forward.conf.j2
    dest: /etc/rsyslog.d/49-forward.conf
    owner: root
    group: root
    mode: '0640'
  when: not rsyslog_deploy_default_config

- name: Configuring additional config files
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/rsyslog.d/
    owner: root
    group: root
    mode: '0640'
  loop: "{{ rsyslog_configs }}"

- name: Start and enable rsyslog
  ansible.builtin.systemd:
    name: rsyslog
    state: started
    enabled: true

