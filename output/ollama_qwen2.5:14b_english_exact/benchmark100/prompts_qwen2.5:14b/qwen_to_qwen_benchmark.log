---
- import_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
    - name: Set SELinux state and policy
      selinux:
        policy: "{{ selinux_policy }}"
        state: "{{ selinux_state }}"
      when: selinux_state is defined and selinux_policy is defined

    - name: Manage SELinux booleans
      selboolean:
        name: "{{ item.0 }}"
        state: "{{ item.1 }}"
        persistent: yes
      loop: "{{ selinux_booleans|dict2items }}"
      when: selinux_booleans is defined

