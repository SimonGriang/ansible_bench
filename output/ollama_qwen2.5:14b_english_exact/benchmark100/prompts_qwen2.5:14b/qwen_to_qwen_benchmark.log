---
- import_tasks: assert.yml

- name: Pre-configure debian systems
  lineinfile:
    path: /etc/dpkg/dpkg.cfg.d/01_nocdrom
    regexp: '^force-conf[im]'
    line: 'force-confdef'
    create: yes

- name: Install postfix
  apt:
    name: postfix
    state: present
    update_cache: yes

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: (postfix_virtual_mailbox_maps is defined) or (postfix_virtual_mailbox_domains is defined) or (postfix_virtual_alias_maps is defined)

- name: Configure postfix (transport_maps)
  template:
    src: postfix_transport_maps
    dest: /etc/postfix/transport
  notify: validate_transport_maps
  notify: rebuild_transport_maps

- name: Configure postfix (header_checks)
  template:
    src: postfix_header_checks
    dest: /etc/postfix/header_checks
  notify: validate_header_checks
  notify: postfix_reload

- name: Setting values for main.cf (1/2)
  set_fact:
    smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions | default('permit_mynetworks, reject_unauth_destination') | bool }}"
    smtpd_sender_restrictions: "{{ smtpd_sender_restrictions | default('permit_mynetworks, permit_sasl_authenticated, reject_unknown_sender_domain') | bool }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    mynetworks: "{{ mynetworks | default('127.0.0.0/8') }}"
    mydestination: "{{ mydestination | default('localhost') }}"
    relay_domains: "{{ relay_domains | default('') }}"
    smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions | default('permit_mynetworks, reject_unauth_destination') | bool }}"
    smtpd_sender_restrictions: "{{ smtpd_sender_restrictions | default('permit_mynetworks, permit_sasl_authenticated, reject_unknown_sender_domain') | bool }}"
    virtual_mailbox_domains: "{{ virtual_mailbox_domains | default('') }}"
    virtual_alias_domains: "{{ virtual_alias_domains | default('') }}"

- name: Configure postfix (main.cf)
  template:
    src: postfix_main.cf
    dest: /etc/postfix/main.cf
  notify: validate_main_cf
  notify: postfix_restart

- name: Configure postfix (master.cf)
  template:
    src: postfix_master.cf
    dest: /etc/postfix/master.cf
  notify: validate_master_cf
  notify: postfix_restart

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: 0700
  with_items:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
  notify: postfix_reload

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
  notify: postfix_reload

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    src: aliases
    dest: /etc/postfix/aliases
  notify: newaliases
  notify: postfix_reload

- name: Configure sender_access
  copy:
    src: sender_access
    dest: /etc/postfix/sender_access
  notify: postmap_sender_access
  notify: postfix_reload

- name: Configure recipient_access
  copy:
    src: recipient_access
    dest: /etc/postfix/recipient_access
  notify: postmap_recipient_access
  notify: validate_recipient_access
  notify: postfix_reload

- name: Place sasl_password_map
  copy:
    src: sasl_password_map
    dest: /etc/postfix/sasl_password_map
  notify: postmap_sasl_password_map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes

