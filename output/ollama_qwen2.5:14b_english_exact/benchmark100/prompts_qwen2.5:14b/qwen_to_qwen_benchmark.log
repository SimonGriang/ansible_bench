---
- name: cadvisor | create directories
  file:
    path: "{{ cadvisor_install_dir }}"
    state: directory
    mode: '0755'

- name: cadvisor | download
  get_url:
    url: "{{ cadvisor_download_url }}"
    dest: "{{ cadvisor_binary_path }}.tgz"
    sha256sum: "{{ cadvisor_binary_sha256 }}"
  when: cadvisor_local_path is not defined

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: "{{ cadvisor_local_path }}"
    dest: "{{ cadvisor_binary_path }}"
  when: cadvisor_local_path is defined
  notify: restart cadvisor service

- name: cadvisor | symlink
  file:
    src: "{{ cadvisor_binary_path }}"
    dest: /usr/local/bin/cadvisor
    state: link

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service

- name: test_task
  systemd:
    name: cadvisor
    state: started
    enabled: yes
  register: service_active

- name: debug: var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemd:
    name: cadvisor
    enabled: yes

- name: cadvisor | start server systemd
  systemd:
    name: cadvisor
    state: started

