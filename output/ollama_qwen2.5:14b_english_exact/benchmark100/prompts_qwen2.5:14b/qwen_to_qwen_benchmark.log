- import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    state: started

- name: Prepare system
  raw: whoami; sudo -n -l
  register: prepare_system_result
  changed_when: False
  failed_when: False
  delegate_to: localhost
  when: prepare_system_result.stdout is defined and prepare_system_result.rc == 0

- name: Gather bootstrap facts
  setup:
  when: prepare_system_result.stdout is not defined or prepare_system_result.rc != 0

- name: Install bootstrap packages (package)
  yum:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ bootstrap_facts_packages }}"
  when: prepare_system_result.stdout is not defined or prepare_system_result.rc != 0

