      when: ansible_swaps.total > 0 and vault_hardening_disable_swap | default(false)
      block:
        - name: Unmount swap partition
          command: swapoff -a
          changed_when: "'swap' in ansible_swaps.total"
        - name: Remove swap line from /etc/fstab
          lineinfile:
            path: /etc/fstab
            regexp: '^[^#].*swap.*'
            state: absent
          notify: reload fstab

- name: hardening | Disable core dumps
  when: vault_hardening_disable_core_dumps | default(false)
  block:
    - name: Set core dump limits to 0
      lineinfile:
        path: /etc/security/limits.conf
        line: '* hard core 0'
        create: yes
        state: present

- name: hardening | Disable Shell Command History
  when: vault_hardening_disable_shell_command_history | default(false)
  block:
    - name: Create /etc/profile.d/disable_history.sh
      template:
        src: disable_history.sh.j2
        dest: /etc/profile.d/disable_history.sh
        mode: '0755'

- name: hardening | Configure SELinux / AppArmor
  when: vault_hardening_configure_selinux_apparmor | default(false)
  block:
    - name: Enable SELinux
      block:
        - name: Check if SELinux is installed
          package:
            name: selinux-policy
            state: present
          register: selinux_installed

        - name: Install SELinux policy package
          package:
            name: selinux-policy
            state: present
          when: not selinux_installed.changed

        - name: Set SELinux policy
          command: setsebool -P enforcing 1
          notify: reload selinux

    - name: Enable AppArmor (enforcing)
      block:
        - name: Check if AppArmor is installed
          package:
            name: apparmor
            state: present
          register: apparmor_installed

        - name: Enable AppArmor enforcement
          command: aa-enabled --enforce /usr/bin/vault
          when: apparmor_installed.changed

