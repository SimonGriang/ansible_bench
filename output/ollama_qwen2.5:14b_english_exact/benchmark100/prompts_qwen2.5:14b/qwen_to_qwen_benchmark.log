---
- import_tasks: assert.yml
  name: Import the assert.yml file which is used for assertions.
  remote_user: localhost

- name: Install PHP
  ansible.builtin.yum:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  ansible.builtin.shell: php --ini | grep "Loaded Configuration File" | cut -d: -f2
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  ansible.builtin.template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
  notify: restart httpd

