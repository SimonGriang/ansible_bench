---
- name: Ensure apt key is not present in trusted.gpg.d
  ansible.builtin.file:
    path: /etc/apt/trusted.gpg.d/docker.asc
    state: absent

- name: Ensure old apt source list is not present in /etc/apt/sources.list.d
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure old versions of Docker are not installed
  ansible.builtin.package:
    name: docker-ce
    state: absent
  when: ansible_facts.packages|length > 0

- name: Ensure legacy repo file is not present
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure dependencies are installed
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop:
    - apt-transport-https
    - ca-certificates
    - python3-debian

- name: Add or remove Docker repository
  ansible.builtin.apt_key:
    url: https://download.docker.com/linux/{{ ansible_os_family }}/gpg
    state: "{{ docker_add_repo|default('present') }}"
  notify: update cache

- name: Add or remove Docker repository
  ansible.builtin.repo:
    filename: /etc/apt/sources.list.d/docker.list
    state: "{{ docker_add_repo|default('present') }}"
    url: "{{ 'deb [arch={{ ansible_facts.platform.linux_distribution.release_arch }}] https://download.docker.com/linux/{{ ansible_os_family }} {{ ansible_facts.os.release|replace(" ",".") }} stable' }}"
  notify: update cache

- name: Ensure handlers are notified immediately to update the apt cache
  ansible.builtin.meta:
    flush_handlers: true

