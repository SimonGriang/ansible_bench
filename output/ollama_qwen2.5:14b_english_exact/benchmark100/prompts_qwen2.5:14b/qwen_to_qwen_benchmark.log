---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_server_type == 'server'

- name: Copy RKE2 configuration file
  copy:
    src: templates/rke2-config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0640'
  notify: "Config file changed"

- name: Copy kubelet configuration file
  copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0640'
  when: rke2_kubelet_config is defined and rke2_kubelet_config | length > 0
  notify: "Config file changed"

- name: Copy Containerd Registry Configuration file
  copy:
    src: templates/registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0640'
  when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)
  notify: "Config file changed"

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ (rke2_etcd_snapshot_file | length > 0) and ((rke2_server_type == 'server') or rke2_etcd_snapshot_file is not defined) }}"
  when: rke2_etcd_snapshot_file is defined

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ (rke2_etcd_snapshot_file | length > 0) and (rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined) }}"
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/agent/snapshots
        state: directory
        mode: '0750'
    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/snapshots/etcd-snapshot.tar.gz
        owner: root
        group: root
        mode: '0640'
    - name: Restore etcd from snapshot file
      command: >
        /usr/local/bin/etcd-snapshot restore /var/lib/rancher/rke2/agent/snapshots/etcd-snapshot.tar.gz
        --data-dir=/var/lib/rancher/rke2/data
      when: do_etcd_restore | bool
  when: do_etcd_restore | bool

- name: Restore etcd from s3
  block:
    - name: Ensure s3cmd is installed
      apt:
        name: s3cmd
        state: present
      when: ansible_os_family == "Debian"
    - name: Ensure s3cmd is installed
      yum:
        name: s3cmd
        state: present
      when: ansible_os_family == "RedHat"
    - name: Download etcd snapshot from s3
      command: >
        s3cmd get s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }} /var/lib/rancher/rke2/agent/snapshots/etcd-snapshot.tar.gz
      args:
        creates: /var/lib/rancher/rke2/agent/snapshots/etcd-snapshot.tar.gz
    - name: Restore etcd from snapshot file
      command: >
        /usr/local/bin/etcd-snapshot restore /var/lib/rancher/rke2/agent/snapshots/etcd-snapshot.tar.gz
        --data-dir=/var/lib/rancher/rke2/data
      when: do_etcd_restore_from_s3 | bool
  when: do_etcd_restore_from_s3 | bool

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    enabled: yes
    state: started
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    enabled: no
    state: masked
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: /var/lib/rancher/rke2/data/ready
    state: present
    sleep: 5
    timeout: 600
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: /var/lib/rancher/rke2/data/ready-cni
    state: present
    sleep: 5
    timeout: 600
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Restore etcd
  block:
    - name: Get registered nodes
      shell: kubectl get nodes -o json
      register: nodes
    - name: Remove old node secrets
      shell: kubectl delete secret {{ item.metadata.name }} --namespace=kube-system
      loop: "{{ nodes.stdout | from_json | json_query('items[?spec.unschedulable==`true`].metadata.name') }}"
    - name: Remove old nodes
      shell: kubectl delete node {{ item.metadata.name }}
      loop: "{{ nodes.stdout | from_json | json_query('items[?spec.unschedulable==`true`].metadata.name') }}"
  when: do_etcd_restore | bool or do_etcd_restore_from_s3 | bool

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: inventory_hostname in groups['rke2_cluster_group_name']

