---
- import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ cron_packages|default([]) }}"

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "SHELL={{ cron_shell }}"
    create: yes
    regexp: "^SHELL="
    mode: '0600'
  notify: Restart cron

- name: Configure path
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "PATH={{ cron_path }}"
    create: yes
    regexp: "^PATH="
    mode: '0600'
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    regexp: "^MAILTO="
    mode: '0600'
  notify: Restart cron

- name: Start and enable cron
  service:
    name: "{{ item }}"
    enabled: yes
    state: started
  loop: "{{ cron_service|default([]) }}"
  when: item is defined and item != ""

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.schedule.minute|default('0') }}"
    hour: "{{ item.schedule.hour|default('0') }}"
    day: "{{ item.schedule.day|default('*') }}"
    month: "{{ item.schedule.month|default('*') }}"
    weekday: "{{ item.schedule.weekday|default('*') }}"
    job: "{{ item.command }}"
  loop: "{{ cron_jobs|default([]) }}"

