---
- import_tasks: assert.yml
  vars:
    ansible_host: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  when: ansible_os_family == 'RedHat'
  seboolean:
    name: httpd_can_network_connect
    state: on
    persistent: yes

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
  notify: test_config
  notify: restart_service

- name: Activate httpd module | Debian
  when: ansible_os_family == 'Debian'
  command: a2enmod "{{ item }}"
  with_items: "{{ httpd_modules }}"
  notify: test_config

- name: Import ssl.yml
  when: https_ssl_enable|default(false)
  import_tasks: ssl.yml

- name: Import locations.yml
  when: httpd_locations|default({})
  import_tasks: locations.yml

- name: Import vhosts.yml
  when: httpd_vhosts|default({})
  import_tasks: vhosts.yml

- name: Configure ports
  when: ansible_os_family in ['Debian', 'Suse']
  template:
    src: "{{ httpd_ports_config_src }}"
    dest: "{{ httpd_ports_config_dest }}"
  notify: test_config
  notify: restart_service

- name: Import directories.yml
  when: httpd_directories|default({})
  import_tasks: directories.yml

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  when: httpd_remove_example|default(false)
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent

- name: Start and enable httpd
  service:
    name: httpd
    state: started
    enabled: yes

