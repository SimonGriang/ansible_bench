---
- name: Ensure old versions of Docker are not installed
  yum:
    name: docker
    state: absent
  when: ansible_os_family == 'RedHat' and ansible_distribution_major_version == '7'
- name: Ensure old versions of Docker are not installed
  apt:
    name: docker
    state: absent
  when: ansible_os_family == 'Debian' and ansible_distribution_major_version == '7'
- name: Add Docker GPG key
  apt_key:
    url: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/gpg
    state: present
  when: ansible_os_family == 'Debian'
- name: Add Docker GPG key
  rpm_key:
    key: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/gpg
    state: present
  when: ansible_os_family == 'RedHat'
- name: Add Docker repository
  apt_repository:
    filename: /etc/apt/sources.list.d/docker.list
    repo: "deb [arch=amd64] https://download.docker.com/linux/{{ ansible_distributionLowerCase }} {{ ansible_distribution_release }} stable"
    state: present
  when: ansible_os_family == 'Debian'
- name: Add Docker repository
  yum_repository:
    name: docker
    description: Docker Release Repository
    baseurl: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/{{ ansible_distribution_release }}
    enabled: true
    gpgcheck: true
    gpgkey: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/gpg
    state: present
  when: ansible_os_family == 'RedHat'
- name: Configure Docker Nightly repo
  apt_repository:
    filename: /etc/apt/sources.list.d/docker-nightly.list
    repo: "deb [arch=amd64] https://download.docker.com/linux/{{ ansible_distributionLowerCase }} {{ ansible_distribution_release }} nightly"
    state: present
  when: ansible_os_family == 'Debian' and docker_repo_nightly | bool
- name: Configure Docker Nightly repo
  yum_repository:
    name: docker-nightly
    description: Docker Nightly Release Repository
    baseurl: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/{{ ansible_distribution_release }}/nightly
    enabled: true
    gpgcheck: true
    gpgkey: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/gpg
    state: present
  when: ansible_os_family == 'RedHat' and docker_repo_nightly | bool
- name: Configure Docker Test repo
  apt_repository:
    filename: /etc/apt/sources.list.d/docker-test.list
    repo: "deb [arch=amd64] https://download.docker.com/linux/{{ ansible_distributionLowerCase }} {{ ansible_distribution_release }} test"
    state: present
  when: ansible_os_family == 'Debian' and docker_repo_test | bool
- name: Configure Docker Test repo
  yum_repository:
    name: docker-test
    description: Docker Test Release Repository
    baseurl: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/{{ ansible_distribution_release }}/test
    enabled: true
    gpgcheck: true
    gpgkey: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/g.gpg
    state: present
  when: ansible_os_family == 'RedHat' and docker_repo_test | bool
- name: Configure containerd on RHEL 8
  yum:
    name: runc
    state: absent
  when: ansible_os_family == 'RedHat' and ansible_distribution_major_version == '8'
- name: Configure containerd on RHEL 8
  yum:
    name: container-selinux
    state: present
  when: ansible_os_family == 'RedHat' and ansible_distribution_major_version == '8'
- name: Configure containerd on RHEL 8
  yum:
    name: containerd.io
    state: present
  when: ansible_os_family == 'RedHat' and ansible_distribution_major_version == '8'

