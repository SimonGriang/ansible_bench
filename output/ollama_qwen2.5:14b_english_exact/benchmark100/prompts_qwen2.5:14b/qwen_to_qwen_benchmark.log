- name: Set the package state based on how Ansible is installed
  ansible.builtin.set_fact:
    ansible_package_state: "{{ 'package' if ansible_local.ansible is defined else 'pip' }}"

- name: Set up Ansible on RedHat
  ansible.builtin.include_tasks: setup-RedHat.yml
  when: ansible_package_state == 'package' and ansible_facts.os_family == 'RedHat' and not ansible_facts.is_fedora

- name: Set up Ansible on Fedora
  ansible.builtin.include_tasks: setup-Fedora.yml
  when: ansible_package_state == 'package' and ansible_facts.os_family == 'RedHat' and ansible_facts.is_fedora

- name: Set up Ansible on Ubuntu
  ansible.builtin.include_tasks: setup-Ubuntu.yml
  when: ansible_package_state == 'package' and ansible_facts.os_family == 'Debian' and ansible_facts.lsb_distrib_id == 'Ubuntu'

- name: Set up Ansible on Debian
  ansible.builtin.include_tasks: setup-Debian.yml
  when: ansible_package_state == 'package' and ansible_facts.os_family == 'Debian' and ansible_facts.lsb_distrib_id == 'Debian'

- name: Set up Ansible using Pip
  ansible.builtin.include_tasks: setup-pip.yml
  when: ansible_package_state == 'pip'

