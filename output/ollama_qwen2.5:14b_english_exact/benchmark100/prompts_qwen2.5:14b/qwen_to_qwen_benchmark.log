---
- name: Install Keepalived when HA mode is enabled
  ansible.builtin.package:
    name: keepalived
    state: present
  when: rke2_ha_mode|default(false) and rke2_server_group == 'rke2-server'

- name: Download and install RKE2
  ansible.builtin.get_url:
    url: https://update.rke2.io/{{ rke2_version }}/rke2-install
    dest: /usr/local/bin/rke2
    mode: '0755'
  register: rke2_install_result
  when: rke2_version is defined

- name: Perform CIS Hardening
  ansible.builtin.include_tasks: cis-hardening.yml
  when: rke2_cis_profile is defined

- name: Find Active Server
  ansible.builtin.command: kubectl get nodes -o jsonpath="{.items[0].metadata.name}"
  register: active_server_result
  when: rke2_active_server is not defined

- name: Enable IPVS kernel module
  ansible.builtin.kmod:
    name: ip_vs
    state: present
  when: rke2_use_kube_vip and rke2_ha_mode

- name: Copy kube-vip manifests to the masternode
  ansible.builtin.copy:
    src: kube-vip-manifests.yml
    dest: /opt/rke2-manifests/kube-vip.yml
  when: not rke2_use_keepalived

- name: Copy ingress-nginx manifests to the masternode
  ansible.builtin.copy:
    src: ingress-nginx-manifests.yml
    dest: /opt/rke2-manifests/ingress-nginx.yml
  when: rke2_ingress_nginx_config is defined

- name: Prepare very first server node in the cluster
  ansible.builtin.include_tasks: first-server-node.yml
  when: rke2_first_server_node

- name: Restore etcd specific tasks
  ansible.builtin.include_tasks: etcd-restore.yml
  when: rke2_etcd_restore

- name: Download kubeconfig to ansible localhost
  ansible.builtin.get_url:
    url: "https://{{ rke2_active_server }}/v1/{{ rke2_kubeconfig }}"
    dest: "{{ rke2_kubeconfig_path }}"
  when: rke2_download_kubeconfig

- name: Prepare and join remaining nodes of the cluster
  ansible.builtin.include_tasks: join-cluster.yml
  when: rke2_active_server is defined

- name: Perform rolling restart for servers when the RKE2 version changes
  ansible.builtin.include_tasks: rolling-restart-servers.yml
  when: rke2_version_changed

- name: Perform rolling restart for agents when the RKE2 version changes
  ansible.builtin.include_tasks: rolling-restart-agents.yml
  when: rke2_version_changed

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Perform rolling restart when configuration files change
  ansible.builtin.include_tasks: rolling-restart-config-change.yml
  when: rke2_config_files_changed

- name: Final steps
  ansible.builtin.include_tasks: final-steps.yml


