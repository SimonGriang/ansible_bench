---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Manage automatic service management
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  notify: set_apt_autostart
  loop:
    - systemd-sysv
    - policyrcd

- name: Disable automatic service management on installation
  block:
    - name: Write policy-rc.d file to disable autostart
      ansible.builtin.copy:
        dest: /usr/sbin/policy-rc.d
        content: "exit 101\n"
        mode: '0755'
      when: apt_autostart_state == "disabled"

- name: Enable automatic service management on installation
  block:
    - name: Remove policy-rc.d file to enable autostart
      ansible.builtin.file:
        path: /usr/sbin/policy-rc.d
        state: absent
      when: apt_autostart_state == "enabled"


