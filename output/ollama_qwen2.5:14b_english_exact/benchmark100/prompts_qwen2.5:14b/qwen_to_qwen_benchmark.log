---
- name: Load OS-specific vars
  include_vars:
    file: "{{ lookup('file', 'vars/{{ ansible_os_family }}.yaml.j2', errors='ignore') }}"

- name: Include RedHat-specific setup tasks
  when: ansible_os_family == "RedHat"
  include_tasks: setup-RedHat.yml

- name: Include Debian-specific setup tasks
  when: ansible_os_family == "Debian"
  include_tasks: setup-Debian.yml

- name: Install Docker packages
  apt:
    name: "{{ item }}"
    state: "{{ docker_packages_state }}"
    force_apt_get: yes
    allow_downgrade: no
  notify: restart docker
  with_items: "{{ docker_packages }}"
  when: ansible_version | version_compare('2.12', '<') or ansible_os_family not in ['RedHat', 'Debian']
  ignore_errors: true

- name: Install Docker packages (with downgrade option)
  apt:
    name: "{{ item }}"
    state: "{{ docker_packages_state }}"
    force_apt_get: yes
    allow_downgrade: yes
  notify: restart docker
  with_items: "{{ docker_packages }}"
  when: ansible_version | version_compare('2.12', '>=') and ansible_os_family in ['RedHat', 'Debian']

- name: Install docker-compose plugin
  when: docker_install_compose_plugin and ansible_version | version_compare('2.12', '<') or ansible_os_family not in ['RedHat', 'Debian']
  apt:
    name: "{{ docker_compose_plugin }}"
    state: present
    force_apt_get: yes
    allow_downgrade: no
    ignore_errors: true

- name: Install docker-compose-plugin (with downgrade option)
  when: docker_install_compose_plugin and ansible_version | version_compare('2.12', '>=') and ansible_os_family in ['RedHat', 'Debian']
  apt:
    name: "{{ docker_compose_plugin }}"
    state: present
    force_apt_get: yes
    allow_downgrade: yes

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: '0750'
  when: docker_daemon_options is defined

- name: Configure Docker daemon options
  template:
    src: docker_daemon_options.j2
    dest: /etc/docker/daemon.json
    owner: root
    group: root
    mode: '0644'
  when: docker_daemon_options is defined
  notify: restart docker

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  when: docker_service_state == 'started' or docker_service_enabled == 'true'
  ignore_errors: "{{ ansible_check_mode }}"

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose.yml tasks
  when: docker_install_compose
  include_tasks: docker-compose.yml

- name: Get docker group info using getent
  getent:
    database: group
    key: docker
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  set_fact:
    users_to_add: "{{ lookup('ansible.builtin.file', users_file) | from_json }}"
  when: users_file is defined

- name: Include docker-users.yml tasks
  when: users_to_add is defined
  include_tasks: docker-users.yml

