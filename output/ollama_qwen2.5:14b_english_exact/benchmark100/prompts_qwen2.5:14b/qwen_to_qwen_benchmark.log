tion': 95954320, 'prompt_eval_count': 620, 'prompt_eval_duration': 356386810, 'eval_count': 462, 'eval_duration': 8597877132, 'model_name': 'qwen2.5:14b'} id='run--1a51681d-4f86-4ae6-92f9-983fb890c2fb-0' usage_metadata={'input_tokens': 620, 'output_tokens': 462, 'total_tokens': 1082}
