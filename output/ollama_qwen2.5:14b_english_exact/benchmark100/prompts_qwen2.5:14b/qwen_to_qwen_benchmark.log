---
- name: Lookup bootstrap facts
  shell: cat /etc/os-release
  register: bootstrap_facts

- name: Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ bootstrap_os_family_map[bootstrap_facts.stdout_lines|select('match', '^ID=')|map('extract', {'ID': ''})|list|first] }}"
    bootstrap_distribution_major_version: "{{ bootstrap_os_family_map[bootstrap_facts.stdout_lines|select('match', '^VERSION_ID=')|map('extract', {'VERSION_ID': ''})|map('regex_replace', '^"(.*)"$', '\\1')|map('regex_replace', '^([^.]+).+', '\\1')|list|first|default('unknown') }}"

- name: Set bootstrap facts (II)
