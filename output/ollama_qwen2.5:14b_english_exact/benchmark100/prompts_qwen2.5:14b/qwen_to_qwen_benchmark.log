---
- import_tasks: assert.yml

- name: Pre-configure debian systems
  package:
    name: postfix
    state: present
  when: ansible_os_family == 'Debian'
  register: postfix_installed
  delegate_to: localhost
  block:
    - name: Write main_mailer_type to prevent prompts
      lineinfile:
        path: /etc/postfix/main.cf
        line: 'main_mailer_type = No configuration'
        create: yes
      when: postfix_installed.changed

- name: Install postfix
  apt:
    name: postfix
    state: present
  when: ansible_os_family == 'Debian'
- name: Install postfix
  yum:
    name: postfix
    state: present
  when: ansible_os_family == 'RedHat'

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined or postfix_virtual_mailbox_domains is defined or postix_virtual_alias_maps is defined
  when: ansible_os_family == 'Debian'
- name: Install postfix-mysql
  yum:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined or postfix_virtual_mailbox_domains is defined or postix_virtual_alias_maps is defined
  when: ansible_os_family == 'RedHat'

- name: Configure postfix (transport_maps)
  template:
    src: templates/postfix.transport.j2
    dest: /etc/postfix/transport
  notify: validate_transport_maps
  notify: rebuild_transport_maps

- name: Configure postfix (header_checks)
  template:
    src: templates/postfix.header_checks.j2
    dest: /etc/postfix/header_checks
  notify: validate_header_checks
  notify: postfix_reload

- name: Setting values for main.cf (1/2)
  set_fact:
    smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions | default('permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination') }}"
    smtpd_sender_restrictions: "{{ smtpd_sender_restrictions | default('permit_mynetworks, permit_sasl_authenticated, reject_unknown_sender_domain, reject_unauth_pipelining') }}"
  when: smtpd_recipient_restrictions is defined or smtpd_sender_restrictions is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    mynetworks: "{{ mynetworks }}"
    mydestination: "{{ mydestination | default('localhost') }}"
    relay_domains: "{{ relay_domains | default('') }}"
    smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions | default('permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination') }}"
    smtpd_sender_restrictions: "{{ smtpd_sender_restrictions | default('permit_mynetworks, permit_sasl_authenticated, reject_unknown_sender_domain, reject_unauth_pipelining') }}"
    virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains }}"
    virtual_alias_domains: "{{ postfix_virtual_alias_domains }}"

- name: Configure postfix (main.cf)
  template:
    src: templates/postfix.main.j2
    dest: /etc/postfix/main.cf
  notify: validate_main_cf
  notify: postfix_restart

- name: Configure postfix (master.cf)
  template:
    src: templates/postfix.master.j2
    dest: /etc/postfix/master.cf
  notify: validate_master_cf
  notify: postfix_restart

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: 0700
  with_items:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_cert_src }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: 0600
  notify: postfix_reload

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_src }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: 0600
  notify: postfix_reload

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/postfix/aliases
    line: "{{ item.key }}: {{ item.value }}"
    create: yes
  with_dict: "{{ postfix_aliases }}"
  notify: build_aliases_database
  notify: postfix_reload

- name: Configure sender_access
