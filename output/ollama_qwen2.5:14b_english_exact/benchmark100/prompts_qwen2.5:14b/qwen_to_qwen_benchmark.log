---
- import_tasks: assert.yml
- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present
- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: "/var/cache/bind", mode: "0755", owner: "root", group: "bind" }
    - { path: "/etc/bind", mode: "0755", owner: "root", group: "bind" }
- name: Create group
  group:
    name: bind
    system: true
- name: Create user
  user:
    name: bind
    system: true
    group: bind
- name: Generate rndc key
  command: "dnssec-keygen -a HMAC-MD5 -b 128 -n HOST -r /dev/urandom -k /etc/bind/rndc.key"
  args:
    creates: /etc/bind/rndc.key
- name: Set permissions on rndc key file
  file:
    path: /etc/bind/rndc.key
    mode: "0600"
    owner: root
    group: bind
- name: Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.root
    dest: /etc/bind/db.root.hints
    mode: "0644"
    owner: root
    group: bind
- name: Create zone file
  template:
    src: zone.j2
    dest: /etc/bind/db.mydomain
- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/bind/named.conf
- name: Place systemd override
  file:
    path: /etc/systemd/system/named.service.d
    state: directory
    mode: "0755"
    owner: root
    group: root
  notify: Restart DNS service
- name: Start and enable dns
  systemd:
    name: named
    state: started
    enabled: yes

