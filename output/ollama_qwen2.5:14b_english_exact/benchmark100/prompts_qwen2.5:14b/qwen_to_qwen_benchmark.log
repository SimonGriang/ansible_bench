  notify: reboot_required

- name: Configure package management for yum
  ansible.builtin.yum:
    name: ansible_pkg_mgr
    state: latest
  notify: reboot_required

- name: Update all software using zypper
  ansible.builtin.zypper:
    name: ansible_pkg_mgr
    state: latest
  notify: reboot_required

- name: Prevent upgrade for selected packages and update all software for apt
  ansible.builtin.apt:
    upgrade: safe
  notify: reboot_required
  register: apt_upgrade_result
- name: Autoremove unused packages for apt
  ansible.builtin.apt:
    autoremove: yes
  notify: reboot_required 25%|██▌       | 25/100 [22:26<49:58, 39.98s/it]

