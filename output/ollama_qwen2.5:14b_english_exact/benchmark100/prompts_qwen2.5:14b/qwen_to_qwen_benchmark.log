---
- name: group | Manage group {{ group.name }}
  group:
    name: "{{ group.name }}"
    state: "{{ group.state }}"
    gid: "{{ group.gid }}"
    system: "{{ group.system }}"

- name: group | Set sudo options for group {{ group.name }}
  block:
    - name: Template sudoers file for group {{ group.name }}
      template:
        src: "sudoers.j2"
        dest: "/etc/sudoers.d/{{ group.name }}"
      vars:
        group_sudo_options: "{{ group.sudo_options }}"
      notify: Validate sudoers file
    - name: Ensure sudoers file is valid
      command: visudo -c -f /etc/sudoers.d/{{ group.name }}
      when: group.sudo_options is defined
      register: sudoers_check
      failed_when: sudoers_check.rc != 0
      changed_when: sudoers_check|changed
      notify: Notify admin on sudoers error
  when: group.sudo_options is defined

