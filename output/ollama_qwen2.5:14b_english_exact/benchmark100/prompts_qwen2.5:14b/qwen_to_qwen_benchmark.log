---
- name: Enable proxy and proxy_http modules on Debian and Suse systems
  block:
    - name: Enable proxy module on Debian
      ansible.builtin.a2enmod:
        modname: proxy
      when: ansible_os_family == "Debian"
      notify: httpd configuration test

    - name: Enable proxy_http module on Debian
      ansible.builtin.a2enmod:
        modname: proxy_http
      when: ansible_os_family == "Debian"
      notify: httpd configuration test

- name: Enable proxy and proxy_http modules on Suse systems
  block:
    - name: Enable proxy module on Suse
      ansible.builtin.yum:
        name: "@mod_proxy"
        state: enabled
      when: ansible_os_family == "Suse"
      notify: httpd configuration test

    - name: Enable proxy_http module on Suse
      ansible.builtin.yum:
        name: "@mod_proxy_http"
        state: enabled
      when: ansible_os_family == "Suse"
      notify: httpd configuration test

- name: Configure locations using a template
  ansible.builtin.template:
    dest: "/etc/httpd/conf/{{ item.key }}"
    src: "location.conf.j2"
    mode: "{{ item.value.mode }}"
  loop: "{{ httpd_locations | dict2items }}"
  notify: httpd configuration test

- name: Include location configurations
  ansible.builtin.import_tasks:
    file: "/etc/httpd/conf/{{ item.key }}"
  loop: "{{ httpd_locations | dict2items }}"

