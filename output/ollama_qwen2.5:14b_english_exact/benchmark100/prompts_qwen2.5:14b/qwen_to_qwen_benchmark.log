---
- name: lookup bootstrap facts (raw)
  ansible.builtin.slurp:
    path: /etc/os-release
  register: os_release_raw

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ (os_release_raw.content | b64decode | regex_search('^PRETTY_NAME=([^\\n]*)', '\\1')) }}"
    bootstrap_distribution_major_version: "{{ (bootstrap_distribution | regex_replace('^(\\d+(?:\\.\\d+){0,2}).*', '\\1')) }}"

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ bootstrap__os_family_map[bootstrap_distribution] | default('unknown') }}"
  vars:
    bootstrap__os_family_map:  # Ensure this is defined as needed

  # To address the yamllint 'new-line-at-end-of-file' issue
  # (Ensure the playbook ends with a newline)

  # (Ensure the playbook ends with a newline)
