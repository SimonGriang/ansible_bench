---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Easyrsa init-pki
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa init-pki"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: ansible.builtin.stat(path='{{ easy_rsa_path }}/pki/private/ca.key').exists is not defined

- name: Easyrsa build-ca
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa build-ca nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: ansible.builtin.stat(path='{{ easy_rsa_path }}/pki/ca.crt').exists is not defined

- name: Easyrsa gen-dh
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa gen-dh"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: ansible.builtin.stat(path='{{ easy_rsa_path }}/pki/dh.pem').exists is not defined

- name: Easyrsa build-server-full server nopass
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa build-server-full server nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: ansible.builtin.stat(path='{{ easy_rsa_path }}/pki/issued/server.crt').exists is not defined

- name: Easyrsa build-client-full client nopass
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa build-client-full client nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: ansible.builtin.stat(path='{{ easy_rsa_path }}/pki/issued/client.crt').exists is not defined

- name: Easyrsa gen-crl
  ansible.builtin.command: "{{ easy_rsa_path }}/easyrsa gen-crl"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: ansible.builtin.stat(path='{{ easy_rsa_path }}/pki/crl.pem').exists is not defined

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to /etc/openvpn/server
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/openvpn/server/{{ item | ansible.builtin.basename }}
    mode: '0600'
  with_items:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/ta.key
    - /etc/openvpn/easy-rsa/pki/dh.pem
    - /etc/openvpn/easy-rsa/pki/issued/server.crt
    - /etc/openvpn/easy-rsa/pki/private/server.key

- name: Copy files to /etc/openvpn
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/openvpn/{{ item | ansible.builtin.basename }}
    mode: '0600'
  with_items:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/dh.pem
    - /etc/openvpn/easy-rsa/pki/crl.pem

- name: Place server.conf
  ansible.builtin.template:
    src: templates/server.conf.j2
    dest: /etc/openvpn/server/server.conf
  notify: restart openvpn

