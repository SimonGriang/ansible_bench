---
- name: Cordon and Drain the node {{ rke2_node_name }}
  block:
    - name: Cordon the node
      kubectl:
        command: cordon
        args:
          - "{{ rke2_node_name }}"
        api_version: "{{ rke2_data_path }}core/v1"
        kubeconfig: "{{ rke2_data_path }}kubeconfig"

    - name: Drain the node
      kubectl:
        command: drain
        args:
          - "{{ rke2_node_name }}"
          - "--delete-local-data"
          - "--ignore-daemonsets"
          - "--force"
          - "--grace-period=60"
          - "--timeout=60s"
          - "--ignore-mirror-pods"
          - "--ignore-pdb"
          - "--delete-emptydir-dir=true"
          - "{{ rke2_drain_additional_args }}"
        api_version: "{{ rke2_data_path }}core/v1"
        kubeconfig: "{{ rke2_data_path }}kubeconfig"
        retries: 100
        delay: 15
        until: kubectl.stdout.find("success") != -1

- name: Restart RKE2 service on {{ rke2_node_name }}
  shell: systemctl restart rke2-server
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  kubectl:
    command: get
    args:
      - nodes
      - "{{ rke2_node_name }}"
      - -o=jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
    retries: 100
    delay: 15
  until: kubectl.stdout == "True"

- name: Uncordon the node {{ rke2_node_name }}
  kubectl:
    command: uncordon
    args:
      - "{{ rke2_node_name }}"
    api_version: "{{ rke2_data_path }}core/v1"
    kubeconfig: "{{ rke2_data_path }}kubeconfig"
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  kubectl:
    command: get
    args:
      - pods
      - -o=jsonpath='{range .items[*]}{.status.containerStatuses[*].ready}{"\n"}{end}'
    retries: 100
    delay: 15
  until: kubectl.stdout.find("False") == -1
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  kubectl:
    command: wait
    args:
      - --for=condition=Ready
      - --timeout=100s
      - --all
      - pods
    retries: 100
    delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy


