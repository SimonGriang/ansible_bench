---
- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  when: inventory_hostname == rke2_node_name

- name: Wait for all nodes to be ready again
  shell: kubectl get nodes --no-headers -o custom-columns=STATUS:.status.conditions[-1].type
  register: node_status
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  until: node_status.stdout.find('Ready') != -1
  retries: 100
  delay: 15
  check_mode: yes
  run_once: yes

- name: Wait for all pods to be ready again
  shell: kubectl get pods --all-namespaces -o custom-columns=STATUS:.status.phase
  register: pod_status
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  until: pod_status.stdout.find('Running') != -1 and pod_status.stdout.find('Succeeded') != -1
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready | default(false)

