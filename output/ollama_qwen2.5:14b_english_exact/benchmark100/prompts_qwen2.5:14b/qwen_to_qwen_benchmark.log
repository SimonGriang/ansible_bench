---
- name: Enable proxy modules in Apache
  block:
    - name: Enable proxy module on Debian systems
      ansible.builtin.apache2ctl:
        module: proxy
        args: enable
      when: ansible_os_family == "Debian"
    - name: Enable proxy module on Suse systems
      ansible.builtin.apache2ctl:
        module: proxy
        args: enable
      when: ansible_os_family == "Suse"
    - name: Enable proxy_http module on Debian systems
      ansible.builtin.apache2ctl:
        module: proxy_http
        args: enable
      when: ansible_os_family == "Debian"
    - name: Enable proxy_http module on Suse systems
      ansible.builtin.apache2ctl:
        module: proxy_http
        args: enable
      when: ansible_os_family == "Suse"

- name: Configure Apache locations using a template
  block:
    - name: Ensure template file is placed in the correct directory
      ansible.builtin.template:
        src: apache_locations.conf.j2
        dest: /etc/apache2/sites-available/custom_locations.conf
        owner: root
        group: root
        mode: '0644'
      notify: test_apache_configuration
    - name: Ensure template file is placed in the correct directory (Suse variant)
      ansible.builtin.template:
        src: apache_locations.conf.j2
        dest: /etc/httpd/conf.d/custom_locations.conf
        owner: root
        group: root
        mode: '0644'
      notify: test_apache_configuration
      when: ansible_os_family == "Suse"

  notify: restart_apache_server

