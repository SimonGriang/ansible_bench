---
- import_tasks: assert.yml
  name: Import assert.yml
  remote_user: root
  run_once: true
  when: inventory_hostname == groups['all'][0]

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Set selinux booleans
      selinuxBoolean:
        name: "{{ item }}"
        state: on
      loop: "{{ httpd_selinux_booleans }}"
      when: ansible_os_family == 'RedHat' and httpd_selinux_enabled|bool == True

    - name: Allow connections to custom ports
      firewalld:
        service: http
        permanent: yes
        state: enabled
        zone: public
        port: "{{ item }}"
      loop: "{{ httpd_firewall_ports }}"
      when: ansible_os_family == 'RedHat' and httpd_firewall_enabled|bool == True

  when: httpd_selinux_enabled|bool == True or httpd_firewall_enabled|bool == True

- name: Configure httpd
  template:
    src: "{{ httpd_template_src }}"
    dest: "{{ httpd_template_dest }}"
  notify: test_httpd

- name: Configure httpd (part 2)
  notify: restart_httpd

- name: Activate httpd module | Debian
  command: a2enmod "{{ item }}"
  loop: "{{ httpd_enabled_modules }}"
  when: ansible_os_family == 'Debian'
  notify: test_httpd

- name: Activate httpd module (part 2) | Debian
  notify: restart_httpd

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: httpd_https_enabled|bool == True

- name: Import locations.yml
  import_tasks: locations.yml
  when: locations_enabled|bool == True

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: vhosts_enabled|bool == True

- name: Configure ports
  template:
    src: "{{ httpd_ports_template_src }}"
    dest: "{{ httpd_ports_template_dest }}"
  notify: test_httpd

- name: Configure ports (part 2)
  notify: restart_httpd
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  import_tasks: directories.yml
  when: directories_enabled|bool == True

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_default_html }}"
    state: absent
  when: httpd_remove_example|bool == True

- name: Start and enable httpd
  systemd:
    name: "{{ httpd_service }}"
    enabled: yes
    state: started

