---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    delay: 5
    state: started
  when: "'ansible_posix' in ansible_facts and ansible_os_family != 'RedHat'"

- name: Prepare system
  local_action: command true
  sudo: yes
  sudo_user: root
  run_once: true
  when: "'ansible_posix' in ansible_facts

- name: Gather bootstrap facts
  setup:
  when: ansible_posix is defined

- name: Install bootstrap packages (raw)
  raw: test -f /etc/redhat-release && echo 'redhat' || echo 'unknown'
  register: os_family
  changed_when: false

- name: Ensure libdnf5 is present on Fedora/RedHat
  when: os_family.stdout == 'redhat'
  yum:
    name: libdnf5
    state: present

- name: Gather ansible facts
  setup: {}

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ bootstrap_packages }}"
  notify: update_cache
  when: os_family.stdout == 'redhat'

- name: Gather ansible facts
  setup: {}

