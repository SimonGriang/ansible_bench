---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install fail2ban
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ fail2ban_packages }}"

- name: Copy filters in filter.d
  copy:
    src: "{{ item }}"
    dest: "/etc/fail2ban/filter.d/{{ item | basename }}"
    mode: '0644'
  loop: "{{ custom_filters }}"
  notify: restart_fail2ban

- name: Configure fail2ban.local
  lineinfile:
    path: /etc/fail2ban/fail2ban.local
    regexp: '^{{ item.regexp }}'
    line: "{{ item.line }}"
    create: yes
    mode: '0644'
  loop: "{{ fail2ban_local_settings }}"
  notify: restart_fail2ban

- name: Configure jail.local
  copy:
    src: "{{ item.src }}"
    dest: /etc/fail2ban/jail.local
    mode: '0644'
  loop: "{{ jail_configs }}"
  notify: restart_fail2ban

- name: Stat auth log file
  stat:
    path: /var/log/auth.log

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    mode: '0640'

- name: Start and enable fail2ban
  systemd:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: true

