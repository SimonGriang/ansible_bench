---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip
  package:
    name: "{{ python_pip_package }}"
    state: present

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    line: "proxy = {{ python_pip_proxy }}"
    create: yes
  when: python_pip_proxy is defined

- name: Trust hosts
  lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    create: yes
  when: python_pip_trusted_host is defined

- name: Update pip
  command: pip install --upgrade pip
  when: python_pip_update and distribution_release != 'bookworm' and distribution_release != 'noble' and ansible_os_family != 'Alpine'

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version }}"
    state: "{{ item.state }}"
  loop: "{{ python_pip_modules }}"
  when: distribution_release != 'bookworm' and distribution_release != 'noble' and ansible_os_family != 'Alpine'

