---
- name: Enable proxy modules in Apache
  ansible.builtin.a2enmod:
    modnames: ["proxy", "proxy_http"]
  become: yes
  when: ansible_facts['os_family'] in ['Debian', 'Suse']

- name: Copy Apache configuration template to correct directory
  ansible.builtin.template:
    src: apache_locations.conf.j2
    dest: /etc/apache2/conf-available/my_locations.conf
    owner: root
    group: root
    mode: '0644'
  notify: test apache configuration
  become: yes

- name: Enable the newly created configuration file
  ansible.builtin.file:
    path: /etc/apache2/conf-enabled/my_locations.conf
    src: /etc/apache2/conf-available/my_locations.conf
    state: link
    force: yes
    group: root
    mode: '0755'
  become: yes
  notify: test apache configuration

- name: Ensure Apache configuration is correct
  ansible.builtin.uri:
    url: http://localhost/server-info
    return_content: yes
  register: apache_info
  become: yes
  notify: restart apache

- name: Ensure the newly created file is readable by the webserver
  ansible.builtin.file:
    path: /etc/apache2/conf-enabled/my_locations.conf
    mode: '0644'
  become: yes
  notify: test apache configuration

 _handlers:
  - name: test apache configuration
    ansible.builtin.command: apachectl configtest
    become: yes

  - name: restart apache
    ansible.builtin.service:
      name: apache2
      state: restarted
    become: yes

