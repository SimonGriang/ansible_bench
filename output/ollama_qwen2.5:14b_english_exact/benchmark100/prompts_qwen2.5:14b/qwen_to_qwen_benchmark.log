---
- import_tasks: assert.yml
  remote_addr: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  when: selinux_enabled
  block:
    - name: Modify SELinux booleans
      seboolean:
        name: "{{ item.key }}"
        state: "{{ item.value }}"
      loop: "{{ selinux_booleans|dict2items }}"
    - name: Allow connections to custom ports
      seport:
        port: "{{ item.ports }}"
        proto: tcp
        state: present
      loop: "{{ selinux_ports|dict2items }}"

- name: Configure httpd
  template:
    src: "{{ httpd_main_conf_src }}"
    dest: "{{ httpd_main_conf_dest }}"
  notify: test_httpd

- name: Configure httpd
  template:
    src: "{{ httpd_main_conf_src }}"
    dest: "{{ httpd_main_conf_dest }}"
  notify: restart_httpd

- name: Activate httpd module | Debian
  when: ansible_os_family == 'Debian'
  command: a2enmod {{ item }}
  loop: "{{ httpd_modules }}"
  notify: test_httpd

- name: Activate httpd module | Debian
  when: ansible_os_family == 'Debian'
  command: a2enmod {{ item }}
  loop: "{{ httpd_modules }}"
  notify: restart_httpd

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_enabled

- name: Import locations.yml
  import_tasks: locations.yml
  when: locations_defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: vhosts_defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf_src }}"
    dest: "{{ httpd_ports_conf_dest }}"
  notify: test_httpd
  when: ansible_os_family in ['Debian', 'Suse']

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf_src }}"
    dest: "{{ httpd_ports_conf_dest }}"
  notify: restart_httpd
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  import_tasks: directories.yml
  when: directories_defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_default_html }}"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes

