---
- name: create | Create ssl key
  copy:
    content: "{{ item.key_content }}"
    dest: "{{ item.key_path }}"
    mode: '0640'
    owner: root
    group: root
  with_items: "{{ ssl_info[:10] if ssl_info|length > 10 else ssl_info }}"
  register: ssl_key

- name: create | Create ssl csr
  command: "openssl req -new -key {{ item.key_path }} -out {{ item.csr_path }} -subj /CN={{ item.common_name }}"
  args:
    creates: "{{ item.csr_path }}"
    warn: false
  with_items: "{{ ssl_info[:10] if ssl_info|length > 10 else ssl_info }}"
  register: ssl_csr

- name: create | Create ssl certificates
  command: "openssl x509 -req -in {{ item.csr_path }} -signkey {{ item.key_path }} -out {{ item.certificate_path }}"
  args:
    creates: "{{ item.certificate_path }}"
    warn: false
  with_items: "{{ ssl_info[:10] if ssl_info|length > 10 else ssl_info }}"
  register: ssl_certificate

- name: create | Create PKCS#12 file
  command: "openssl pkcs12 -export -in {{ item.certificate_path }} -inkey {{ item.key_path }} -out {{ item.pkcs12_path }} -name {{ item.friendly_name }} -CAfile {{ item.ca_path }} -caname {{ item.ca_name }}"
  args:
    creates: "{{ item.pkcs12_path }}"
    warn: false
  with_items: "{{ ssl_info[:10] if ssl_info|length > 10 else ssl_info }}"
  register: ssl_pkcs12
  changed_when: "'-ERROR' not in ansible_stdout"

- name: create | Read private key
  command: "openssl rsa -noout -modulus -in {{ item.key_path }}"
  with_items: "{{ ssl_info[:10] if ssl_info|length > 10 else ssl_info }}"
  register: ssl_private_key

- name: create | Read certificate
  command: "openssl x509 -noout -modulus -in {{ item.certificate_path }}"
  with_items: "{{ ssl_info[:10] if ssl_info|length > 10 else ssl_info }}"
  register: ssl_certificate_info

- name: create | Create combined private_key and certificate file
  copy:
    content: "{{ item.private_key_content }}\n{{ item.certificate_content }}"
    dest: "{{ item.combined_path }}"
    mode: '0640'
    owner: root
    group: root
  with_items: "{{ ssl_info[:10] if ssl_info|length > 10 else ssl_info }}"
  register: ssl_combined_file

