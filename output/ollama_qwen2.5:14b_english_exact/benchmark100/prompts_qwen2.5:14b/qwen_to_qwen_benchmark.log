---
- name: Ensure the unzip package is available on the target system
  package:
    name: "{{ item }}"
    state: present
  loop:
    - unzip
  when: ansible_os_family == 'Debian' or ansible_os_family == 'RedHat'
  notify: update_package_cache

- name: Create a system group for promtail
  group:
    name: promtail
    system: true
    gid: "{{ promtail_gid | default(omit) }}"
    state: present
  when: promtail_group != 'root'

- name: Create the promtail user
  user:
    name: promtail
    system: true
    group: promtail
    uid: "{{ promtail_uid | default(omit) }}"
    state: present
  when: promtail_user != 'root'

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
    owner: root
    group: root
  when: promtail_bin_dir == '/usr/local/bin'

- name: Create config directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0750'
    owner: promtail
    group: promtail
  loop:
    - /etc/promtail
    - /etc/promtail/agent

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0750'
    owner: promtail
    group: promtail
  loop:
    - /opt/promtail
    - /opt/promtail/bin

- name: Check if the promtail binary exists
  stat:
    path: /opt/promtail/bin/promtail
  register: promtail_binary_exists

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_url }}"
    dest: /opt/promtail/promtail.tar.gz
    mode: '0644'
    force_basic_auth: true
  when: >
    promtail_binary_exists.stat.exists == false and
    promtail_local_distribution == false and
    promtail_propagation == true

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_local_path }}"
    dest: /opt/promtail/promtail.tar.gz
    mode: '0644'
  when: >
    promtail_binary_exists.stat.exists == false and
    promtail_local_distribution == true

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_url }}"
    dest: /opt/promtail/promtail.tar.gz
    mode: '0644'
    force_basic_auth: true
  when: >
    promtail_binary_exists.stat.exists == false and
    promtail_local_distribution == false and
    promtail_propagation == false

- name: Propagate promtail binaries
  copy:
    src: "{{ promtail_local_path }}"
    dest: /opt/promtail/promtail.tar.gz
    mode: '0644'
  when: >
    promtail_binary_exists.stat.exists == false and
    promtail_local_distribution == false and
    promtail_propagation == true

- name: Unpack promtail binaries
  unarchive:
    src: /opt/promtail/promtail.tar.gz
    dest: /opt/promtail/bin
    remote_src: true
    create: true
    mode: '0755'
    owner: promtail
    group: promtail
    no_errors: true
    extra_opts: "--strip-components=1"

- name: Create symlink to latest version
  file:
    src: /opt/promtail/bin/promtail
    dest: /usr/local/bin/promtail
    state: link
    force: true
    mode: '0755'
  notify: restart_promtail_service

- name: Write configuration
  template:
    src: promtail.conf.j2
    dest: /etc/promtail/agent/promtail.yaml
    mode: '0640'
    owner: promtail
    group: promtail
  notify: restart_promtail_service

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
    owner: root
    group: root
  notify: restart_promtail_service

