---
- name: Lookup bootstrap facts
  command: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  check_mode: false

- name: Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ bootstrap_os_family_map[bootstrap_facts.stdout.splitlines()[0].split('=')[1].strip('\"')] }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout.splitlines()[1].split('=')[1].strip('\"').split('.')[0] }}"
  vars:
    bootstrap_os_family_map:
      Debian: debian
      Ubuntu: debian
      CentOS: rhel
      Fedora: rhel
  no_log: false

- name: Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ bootstrap_os_family_map[bootstrap_distribution] }}"
  no_log: false

