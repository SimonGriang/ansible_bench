  ansible.builtin.dnf:
    name: redis
    state: installed
    enablerepo: crb
    enable: true
  when: ansible_distribution_major_version == "8"

- name: Install redis
  ansible.builtin.package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  ansible.builtin.template:
    src: "redis.conf.j2"
    dest: "{{ redis_conf_dir }}/{{ redis_conf_file }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_conf_mode }}"
  notify: restart_redis

- name: Start and enable redis
  ansible.builtin.service:
    name: "{{ redis_service }}"
    state: started
    enabled: true

