Create combined private_key and certificate file\n  copy:\n    content: "{{ private_key_contents.stdout }}\\n{{ certificate_contents.stdout }}"\n    dest: "{{ item.path }}/{{ item.name }}.combined.pem"\n    mode: \'0600\'\n    owner: root\n    group: root\n  with_items: "{{ inventory_hostname_ssl_files }}"\n  tags:\n    - ssl\n    - combined' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-18T06:55:41.202562284Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10786923681, 'load_duration': 77129491, 'prompt_eval_count': 574, 'prompt_eval_duration': 267540717, 'eval_count': 641, 'eval_duration': 10430760205, 'model_name': 'qwen2.5:14b'} id='run--c4c97f8b-b06c-475c-aa0c-52d56761f7bf-0' usage_metadata={'input_tokens': 574, 'output_tokens': 641, 'total_tokens': 1215}
