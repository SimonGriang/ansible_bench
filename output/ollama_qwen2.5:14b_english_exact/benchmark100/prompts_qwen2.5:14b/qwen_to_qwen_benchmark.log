when: false\n  when: rke2_wait_for_all_pods_to_be_ready\n\n- name: Wait for all pods to pass readiness checks\n  shell: >\n    kubectl wait --for=condition=ready --timeout=120s pods --all-namespaces --all\n  register: pods_healthy\n  retries: 100\n  delay: 15\n  until: pods_healthy.rc == 0\n  changed_when: false\n  when: rke2_wait_for_all_pods_to_be_healthy\n\n#' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-18T07:36:06.018682664Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12637544699, 'load_duration': 88616469, 'prompt_eval_count': 1531, 'prompt_eval_duration': 84376097, 'eval_count': 697, 'eval_duration': 12452095108, 'model_name': 'qwen2.5:14b'} id='run--f9d5acfc-bdbb-4e98-8963-bcbca655ee39-0' usage_metadata={'input_tokens': 1531, 'output_tokens': 697, 'total_tokens': 2228}
