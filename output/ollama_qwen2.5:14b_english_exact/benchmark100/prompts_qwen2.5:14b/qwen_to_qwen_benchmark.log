---
- name: Ensure the unzip package is available on the target system
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop:
    - unzip
  when: ansible_os_family == "RedHat" or ansible_os_family == "Debian"
  register: package_result
  changed_when: package_result.changed
  notify: update_package_cache

- name: Create a system group for promtail
  ansible.builtin.group:
    name: promtail
    system: yes
    state: present
  when: group_name != 'root'

- name: Create the promtail user
  ansible.builtin.user:
    name: promtail
    system: yes
    state: present
    group: promtail
  when: user_name != 'root'

- name: Ensure the /usr/local/bin directory exists
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: promtail
    group: promtail
  with_items:
    - { path: /etc/promtail, mode: '0750' }
    - { path: /etc/promtail/client, mode: '0750' }
    - { path: /etc/promtail/instance, mode: '0750' }
    - { path: /etc/promtail/template, mode: '0750' }

- name: Create application directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: promtail
    group: promtail
  with_items:
    - { path: /var/lib/promtail, mode: '0750' }
    - { path: /var/lib/promtail/client, mode: '0750' }
    - { path: /var/lib/promtail/instance, mode: '0750' }
    - { path: /var/log/promtail, mode: '0750' }

- name: Check if the promtail binary exists
  ansible.builtin.stat:
    path: /usr/local/bin/promtail
  register: promtail_binary_check

- name: Download promtail binaries
  ansible.builtin.get_url:
    url: "{{ promtail_url }}"
    dest: /tmp/promtail.tar.gz
    mode: '0644'
  when: promtail_binary_check.stat.exists == False and promtail_local_distribution == False and promtail_propagation == False

- name: Propagate locally distributed promtail archive
  ansible.builtin.copy:
    src: "{{ promtail_local_archive }}"
    dest: /tmp/promtail.tar.gz
    mode: '0644'
  when: promtail_binary_check.stat.exists == False and promtail_local_distribution == True and promtail_propagation == False

- name: Download promtail binaries to controller node
  ansible.builtin.get_url:
    url: "{{ promtail_url }}"
    dest: /tmp/promtail.tar.gz
    mode: '0644'
  when: promtail_binary_check.stat.exists == False and promtail_local_distribution == False and promtail_propagation == True

- name: Propagate promtail binaries
  ansible.builtin.copy:
    src: "{{ promtail_local_archive }}"
    dest: /tmp/promtail.tar.gz
    mode: '0644'
  when: promtail_binary_check.stat.exists == False and promtail_local_distribution == True and promtail_propagation == True

- name: Unpack promtail binaries
  ansible.builtin.unarchive:
    src: /tmp/promtail.tar.gz
    dest: /var/lib/promtail/
