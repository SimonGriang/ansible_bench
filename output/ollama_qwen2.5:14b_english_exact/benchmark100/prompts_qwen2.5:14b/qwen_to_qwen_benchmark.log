  systemd:
    name: rke2
    enabled: yes
    state: started
    daemon_reload: yes
    masked: no
  register: rke2_start_result
  until: rke2_start_result|succeeded
  retries: 60
  delay: 10
  notify: restart_rke2

- name: Mask other RKE2 services
  when: rke2_type != 'agent'
  systemd:
    name: rke2-agent
    enabled: no
    state: masked
  notify: restart_rke2

