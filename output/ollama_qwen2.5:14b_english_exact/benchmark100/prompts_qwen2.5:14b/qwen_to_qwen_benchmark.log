tion': 7087381769, 'load_duration': 93117639, 'prompt_eval_count': 622, 'prompt_eval_duration': 257910918, 'eval_count': 473, 'eval_duration': 6723086701, 'model_name': 'qwen2.5:14b'} id='run--92b7559b-ad5d-4608-99a0-52c7c7228595-0' usage_metadata={'input_tokens': 622, 'output_tokens': 473, 'total_tokens': 1095}
