---
- import_tasks: assert.yml

- name: Install requirements
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ sysctl_requirements }}"

- name: Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    reload: yes
  loop: "{{ sysctl_items }}"
  when:
    - item is defined
    - ansible_local.container_type is not defined
  no_log: false

  # To ensure there is a new line at the end of the file

