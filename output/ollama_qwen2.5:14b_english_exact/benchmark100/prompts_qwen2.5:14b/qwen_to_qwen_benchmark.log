---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install mysql
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_packages }}"
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ansible.builtin.lineinfile:
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    regexp: "^#{{ item.option }}"
    line: "{{ item.option }} = {{ item.value }}"
  with_items: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  ansible.builtin.lineinfile:
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    insertbefore: EOF
    regexp: "^socket"
    line: "socket={{ mysql_socket }}"

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0600

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_host: localhost
  loop: "{{ mysql_databases }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.database }}.*:{{ item.privileges }}"
    login_user: root
    login_host: localhost
  with_items: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

