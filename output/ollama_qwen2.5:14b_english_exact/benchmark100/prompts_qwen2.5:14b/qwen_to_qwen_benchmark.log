---
- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_binary_exists

- name: Check Helm version
  command: /usr/local/bin/helm version --short
  when: helm_binary_exists.stat.exists
  register: helm_version_output

- name: Download helm
  get_url:
    url: "https://get.helm.sh/helm-v{{ helm_version }}/linux-amd64.tar.gz"
    dest: /tmp/helm.tar.gz
  vars:
    helm_version: "3.9.0"  # Example version, replace with actual logic to determine the latest version if needed
  when: not helm_binary_exists.stat.exists or helm_version_output.stdout.find("version.BuildInfo") == -1

- name: Copy helm binary into place
  copy:
    src: /tmp/helm.tar.gz
    dest: /usr/local/bin/helm
    mode: '0755'
  when: not helm_binary_exists.stat.exists or helm_version_output.stdout.find("version.BuildInfo") == -1
  register: copy_helm_binary
  notify: Extract Helm binary

- name: Extract Helm binary
  become: yes
  shell: |
    mkdir -p /usr/local/bin
    tar -xzf /tmp/helm.tar.gz -C /usr/local/bin
  notify: Clean up tarball

- name: Clean up tarball
  file:
    path: /tmp/helm.tar.gz
    state: absent

