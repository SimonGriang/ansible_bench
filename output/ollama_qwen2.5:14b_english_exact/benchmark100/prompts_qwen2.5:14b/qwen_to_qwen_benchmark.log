---
- name: create | Create ssl key
  openssl_privatekey:
    state: present
    path: "{{ ssl_key_dir }}/{{ ssl_key_name }}"
    mode: "{{ ssl_key_perms }}"
    owner: "{{ ssl_key_owner }}"
  become: yes
  loop: "{{ ssl_keys }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes
  changed_when: ssl_key_result|changed
  register: ssl_key_result

- name: create | Create ssl csr
  openssl_csr:
    state: present
    privatekey_path: "{{ ssl_key_dir }}/{{ ssl_key_name }}"
    common_name: "{{ item.common_name }}"
    path: "{{ ssl_csr_dir }}/{{ ssl_csr_name }}"
    mode: "{{ ssl_csr_perms }}"
    owner: "{{ ssl_csr_owner }}"
  become: yes
  loop: "{{ ssl_csrs }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes
  changed_when: ssl_csr_result|changed
  register: ssl_csr_result

- name: create | Create ssl certificates
  openssl_certificate:
    provider: selfsigned
    csr_path: "{{ ssl_csr_dir }}/{{ ssl_csr_name }}"
    privatekey_path: "{{ ssl_key_dir }}/{{ ssl_key_name }}"
    path: "{{ ssl_cert_dir }}/{{ ssl_cert_name }}"
    mode: "{{ ssl_cert_perms }}"
    owner: "{{ ssl_cert_owner }}"
    days: 365
  become: yes
  loop: "{{ ssl_certs }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes
  changed_when: ssl_cert_result|changed
  register: ssl_cert_result

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    state: present
    name: "{{ item.p12_filename }}"
    certificate: "{{ ssl_cert_dir }}/{{ ssl_cert_name }}"
    privatekey: "{{ ssl_key_dir }}/{{ ssl_key_name }}"
    password: "{{ item.p12_password }}"
    dest: "{{ ssl_p12_dir }}/{{ item.p12_filename }}"
    mode: "{{ ssl_p12_perms }}"
    owner: "{{ ssl_p12_owner }}"
  become: yes
  loop: "{{ ssl_p12_files }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes
  changed_when: ssl_p12_result|changed
  register: ssl_p12_result

- name: create | Read private key
  command: "openssl rsa -noout -text -in {{ ssl_key_dir }}/{{ ssl_key_name }} | base64 -w 0"
  loop: "{{ ssl_keys }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes
  register: ssl_key_content

- name: create | Read certificate
  command: "openssl x509 -in {{ ssl_cert_dir }}/{{ ssl_cert_name }} -text -noout | base64 -w 0"
  loop: "{{ ssl_certs }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes
  register: ssl_cert_content

- name: create | Create combined private_key and certificate file
  copy:
    content: "{{ ssl_key_content.stdout + ssl_cert_content.stdout }}"
    dest: "{{ ssl_combined_dir }}/{{ item.combined_filename }}"
    mode: "{{ ssl_combined_perms }}"
    owner: "{{ ssl_combined_owner }}"
  loop: "{{ ssl_combined_files }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes
  become: yes
  register: ssl_combined_result

