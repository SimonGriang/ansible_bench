---
- import_tasks: assert.yml
  name: Import the assert.yml file which is used for assertions.
  remote_addr: localhost

- name: Install PHP
  package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  shell: php -i | grep "Configuration File \(php\.ini\)" | awk -F': ' '{print $2}'
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
  notify: restart httpd

