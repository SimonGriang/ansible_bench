---
- import_tasks: assert.yml

- name: Install git
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ git_packages }}"

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_user }}"
  register: user_check

- name: Create directory for git configuration
  file:
    path: "{{ git_config_dir }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_group }}"
    mode: '0755'
  when: user_check.is_unlocked and git_config_dir is defined

- name: Place git configuration
  template:
    src: git-config.j2
    dest: "{{ git_config_dir }}/.gitconfig"
    owner: "{{ git_user }}"
    group: "{{ git_group }}"
    mode: '0644'
  when: user_check.is_unlocked and git_config_dir is defined and git_config_template is defined

- name: Create repository_destination
  file:
    path: "{{ git_repo_destination }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_group }}"
    mode: '0755'
  when: user_check.is_unlocked and git_repo_destination is defined

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    version: "{{ item.version }}"
    dest: "{{ git_repo_destination }}/{{ item.name }}"
    accept_hostkey: yes
    update: yes
  loop: "{{ git_repositories }}"
  when: user_check.is_unlocked and git_repo_destination is defined
  become: yes
  become_user: "{{ git_user }}"


