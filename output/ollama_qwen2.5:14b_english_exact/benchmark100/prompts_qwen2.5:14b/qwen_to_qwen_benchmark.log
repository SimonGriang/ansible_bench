  when: rke2_installed_version != rke2_running_version and not ansible_check_mode|bool
  environment:
    RKE2_AIRGAP: "{{ rke2_airgap_mode }}"
    RKE2_AIRGAP_IMPLEMENTATION: "{{ rke2_airgap_implementation }}"
    RKE2_AIRGAP_COPY_ADDITIONAL_TARBALLS: "{{ rke2_airgap_copy_additional_tarballs|join(',') }}"

- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_custom_manifests_path }}/{{ item }}"
    dest: "{{ rke2_data_path }}/{{ item }}"
    mode: '0644'
    owner: root
    group: root
    force: yes
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests|length > 0

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_path }}/{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}/{{ item }}"
    mode: '0644'
    owner: root
    group: root
    force: yes
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods|length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: "{{ rke2_data_path }}/rke2.env"
    mode: '0644'
    owner: root
    group: root
    force: yes
  when: rke2_env_vars|length > 0

