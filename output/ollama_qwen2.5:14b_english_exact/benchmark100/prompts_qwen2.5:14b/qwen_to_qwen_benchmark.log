---
- import_tasks: assert.yml
  name: Import the assert.yml file to handle assertions
  remote_user: localhost

- name: Configure package management for apk
  ansible.builtin.yml:
    - name: Update apk cache and upgrade all software
      ansible.builtin.package:
        name: ansible_pkg_mgr
        state: latest
      notify: reboot_required

- name: Configure package management for apt
  ansible.builtin.yml:
    - name: Prevent upgrade for selected packages and update all software
      ansible.builtin.apt:
        upgrade: safe
      notify: reboot_required
    - name: Autoremove unused packages
      ansible.builtin.apt:
        autoremove: yes

- name: Update all software using dnf
  ansible.builtin.yml:
    - name: Update all software excluding certain packages
      ansible.builtin.yum:
        name: "dnf"
        state: latest
        exclude: kernel*

- name: Update all software using pacman
  ansible.builtin.yml:
    - name: Update all software
      ansible.builtin.pacman:
        sync: sysup

- name: Configure package management for yum
  ansible.builtin.yml:
    - name: Update all software and install yum-utils if needed
      ansible.builtin.yum:
        name: ansible_pkg_mgr
        state: latest
      notify: reboot_required

- name: Update all software using zypper
  ansible.builtin.yml:
    - name: Update all software
      ansible.builtin.zypper:
        name: ansible_pkg_mgr
        state: latest
      notify: reboot_required

