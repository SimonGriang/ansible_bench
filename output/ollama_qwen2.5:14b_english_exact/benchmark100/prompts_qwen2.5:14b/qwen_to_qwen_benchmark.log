---
- name: Install Keepalived when HA mode is enabled
  when: ha_mode_enabled and rke2_server_group
  block:
    - name: Ensure Keepalived is installed
      apt:
        name: keepalived
        state: present
        update_cache: yes

- name: Download and install RKE2
  block:
    - name: Download RKE2 binary
      get_url:
        url: https://github.com/rke2-io/rke2/releases/download/{{ rke2_version }}/rke2 {{ rke2_version }}.linux.amd64
        dest: /usr/local/bin/rke2
        mode: u=rwx,go=rx
    - name: Install RKE2 service
      command: /usr/local/bin/rke2 install --write-k3s-conf --write-k3s-service --write-rke2-defaults --write-rke2-systemd --write-rke2-service

- name: CIS Hardening
  when: cis_profile is defined
  block:
    - name: Apply CIS hardening rules
      ansible.builtin.template:
        src: cis-hardening.yml.j2
        dest: /etc/rancher/rke2/cluster.yml
        mode: 0644

- name: Find Active Server
  block:
    - name: Identify active server
      command: rke2-agent token get --url=https://{{ active_server_ip }}:6443
      register: active_server

- name: Enable IPVS kernel module
  when: use_kubevip and ha_mode_enabled
  block:
    - name: Load IPVS kernel module
      command: modprobe ip_vs

- name: Copy kube-vip manifests to the masternode
  when: not use_keepalived
  block:
    - name: Copy kube-vip manifests
      copy:
        src: kube-vip/kube-vip.yaml
        dest: /etc/rancher/rke2/kube-vip.yaml
        mode: 0644

- name: Copy ingress-nginx manifests to the masternode
  when: ingress_nginx_config is defined
  block:
    - name: Copy ingress-nginx manifests
      copy:
        src: ingress-nginx/ingress-nginx.yaml
        dest: /etc/rancher/rke2/ingress-nginx.yaml
        mode: 0644

- name: Prepare very first server node in the cluster
  block:
    - name: Initialize the first server node
      command: rke2 server --write-kubeconfig /etc/rancher/rke2/rke2.yaml

- name: Restore etcd specific tasks
  when: etcd_restore
  block:
    - name: Restore etcd data
      command: rke2 etcd restore /path/to/etcd/backup

- name: Download kubeconfig to ansible localhost
  when: download_kubeconfig
  block:
    - name: Download kubeconfig
      fetch:
        src: /etc/rancher/rke2/rke2.yaml
        dest: /tmp/rke2.yaml
        flat: yes

- name: Prepare and join remaining nodes of the cluster
  when: active_server is defined
  block:
    - name: Prepare and join remaining nodes
      command: rke2 agent --server=https://{{ active_server_ip }}:6443 --write-kubeconfig /etc/rancher/rke2/rke2.yaml

- name: Rolling cordon and drain restart when version changes - servers
  when: rke2_version_changed and rke2_server_group
  block:
    - name: Cordon and drain servers
      command: kubectl drain {{ server_name }} --ignore-daemonsets

- name: Rolling cordon and drain restart when version changes - agents
  when: rke2_version_changed and rke2_agent_group
  block:
    - name: Cordon and drain agents
      command: kubectl drain {{ agent_name }} --ignore-daemonsets

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  when: config_files_changed
  block:
    - name: Restart RKE2 service
      command: systemctl restart rke2

- name: Final steps
  block:
    - name: Finalize cluster setup
      command: rke2 status

