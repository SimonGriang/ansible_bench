---
- ansible.builtin.import_tasks: assert.yml

- name: Install dns
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.perm }}"
    owner: "{{ item.user }}"
    group: "{{ item.group }}"
  loop:
    - {path: "/etc/named", perm: "0750", user: "root", group: "root"}
    - {path: "/var/named", perm: "0770", user: "named", group: "named"}

- name: Create group
  ansible.builtin.group:
    name: "named"
    system: true

- name: Create user
  ansible.builtin.user:
    name: "named"
    system: true
    createhome: false

- name: Generate rndc key
  ansible.builtin.command: "dnssec-keygen -r /dev/urandom -a HMAC-SHA512 -b 752 -n USER named"
  register: rndc_key
  changed_when: "'Knamed.++' in rndc_key.stdout"
  failed_when: "'Knamed.++' not in rndc_key.stdout"

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: "{{ item.key_file }}"
    mode: "0600"
    owner: "root"
    group: "named"
  loop:
    - {key_file: "/etc/rndc.key"}

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "https://www.internic.net/domain/named.root"
    dest: "/var/named/data/named.root.hints"
    mode: "0644"

- name: Create zone file
  ansible.builtin.template:
    src: "zones.j2"
    dest: "/var/named/{{ item.zone }}.db"
    mode: "0644"
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  ansible.builtin.template:
    src: "named.conf.j2"
    dest: "/etc/named.conf"
    mode: "0644"

- name: Place systemd override
  ansible.builtin.copy:
    src: "named.conf.d/journal-overrides.conf"
    dest: "/etc/systemd/system/named.service.d/journal-overrides.conf"
    mode: "0644"

- name: Start and enable dns
  ansible.builtin.systemd:
    name: "named"
    state: started
    enabled: true

