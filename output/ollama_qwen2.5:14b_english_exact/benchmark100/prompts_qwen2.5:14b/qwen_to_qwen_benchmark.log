---
- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that:
      - ansible_systemd is defined
      - ansible_systemd == "True"

- name: Get latest release of promtail
  ansible.builtin.set_fact:
    promtail_version: "{{ (result.json.tag_name | regex_replace('^v', '')) }}"
  vars:
    result: "{{ (ansible_facts.github_api_url ~ '/repos/grafana/loki/releases/latest').get().json }}"
  when: promtail_version is not defined

- name: Test if zip local archive exists
  ansible.builtin.stat:
    path: "{{ promtail_version }}-{{ go_arch }}.zip"
  register: promtail_zip_local_archive
  when: promtail_version is defined

- name: Assert local binary exists
  ansible.builtin.assert:
    that:
      - promtail_binary_local_dir is defined
      - promtail_binary_local_dir | stat is defined
  when: promtail_binary_local_dir is defined

