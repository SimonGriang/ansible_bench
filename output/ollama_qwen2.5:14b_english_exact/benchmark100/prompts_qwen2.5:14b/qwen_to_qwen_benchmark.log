      apt:
        name: apt-transport-https
      when: ansible_os_family == 'Debian'
    - name: Add key repositories
      apt_key:
        url: "{{ item.url }}"
        state: present
      loop: "{{ jdk_repositories_keys | default([]) }}"
      when: ansible_os_family == 'Debian'
    - name: Add repositories
      apt_repository:
        filename: "{{ item.filename }}"
        repo: "{{ item.repo }}"
        state: present
      loop: "{{ jdk_repositories | default([]) }}"
      when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: "{{ item.key }}"
        state: present
      loop: "{{ jdk_repositories_keys | default([]) }}"
      when: ansible_os_family == 'RedHat'
    - name: Add repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        enabled: "{{ item.enabled }}"
        gpgcheck: "{{ item.gpgcheck }}"
        state: present
      loop: "{{ jdk_repositories | default([]) }}"
      when: ansible_os_family == 'RedHat'

- name: Install required libraries
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ jdk_required_libraries | default([]) }}"
  when: item is defined

- name: Install Java, Debian
  block:
    - name: Update cache
      apt:
        update_cache: yes
      when: ansible_os_family == 'Debian'
    - name: Install package
      apt:
        name: "{{ item.package }}"
        state: present
      loop: "{{ jdk_packages | default([]) }}"
      when: ansible_os_family == 'Debian'
    - name: Check package installation
      apt:
        name: "{{ item.package }}"
        state: present
      loop: "{{ jdk_packages | default([]) }}"
      when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  block:
    - name: Update cache
      yum:
        name: "*"
        update_cache: yes
      when: ansible_os_family == 'RedHat'
    - name: Install package
      yum:
        name: "{{ item.package }}"
        state: present
      loop: "{{ jdk_packages | default([]) }}"
      when: ansible_os_family == 'RedHat'
    - name: Check package installation
      yum:
        name: "{{ item.package }}"
        state: present
      loop: "{{ jdk_packages | default([]) }}"
      when: ansible_os_family == 'RedHat'

- name: Export environment variables
  template:
    src: "templates/java_env_template.j2"
    dest: "/etc/profile.d/java_env.sh"
    mode: 0755
    owner: root
    group: root

- name: Source environment variables
  shell: source /etc/profile.d/java_env.sh

- name: Correct java version selected for Java versions less than 11
  command: "update-alternatives --set java {{ java_home }}/bin/java"
  when: ansible_os_family == 'Debian' and jdk_version_major == '8'

- name: Correct java version selected for Java versions greater than or equal to 11
  command: "update-alternatives --set java {{ java_home }}/bin/java"
  when: ansible_os_family == 'Debian' and jdk_version_major == '11' 62%|██████▏   | 62/100 [57:06<45:44, 72.21s/it]

