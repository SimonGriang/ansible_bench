---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_server_type == 'server'

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_template }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0640'
  notify: "Config file changed"

- name: Copy kubelet configuration file
  copy:
    src: "{{ rke2_kubelet_config_template }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0640'
  notify: "Config file changed"
  when: (rke2_kubelet_config is defined) and (rke2_kubelet_config != "")

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_template }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0640'
  notify: "Config file changed"
  when: (rke2_custom_registry_mirrors is defined) or (rke2_custom_registry_configs is defined)

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: (rke2_etcd_snapshot_file is defined) and (rke2_etcd_snapshot_file != "") and ((rke2_server_service_status | default('disabled')) == 'disabled' or (rke2_server_service_status is not defined))

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: (rke2_etcd_snapshot_file is defined) and (rke2_etcd_snapshot_file != "") and
        (rke2_etcd_snapshot_s3_options.access_key is defined) and
        (rke2_etcd_snapshot_s3_options.secret_key is defined) and
        (rke2_etcd_snapshot_s3_options.bucket is defined) and
        (rke2_etcd_snapshot_s3_options.snapshot_name is defined)

- name: Restore etcd from file
  block:
    - name: Create the RKE2 etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/agent/etcd-snapshots
        state: directory
        mode: '0750'
    - name: Copy the etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/etcd-snapshots/etcd-snapshot.bin
        mode: '0640'
    - name: Restore etcd from snapshot file
      shell: |
        rke2-etcd-snapshot restore /var/lib/rancher/rke2/agent/etcd-snapshots/etcd-snapshot.bin
        --data-dir=/var/lib/rancher/rke2/data
        --log-level=info
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Set etcd snapshot s3 options
      set_fact:
        snapshot_s3_options: "{{ rke2_etcd_snapshot_s3_options }}"
    - name: Restore etcd from s3 snapshot
      shell: |
        rke2-etcd-snapshot restore s3://{{ snapshot_s3_options.bucket }}/{{ snapshot_s3_options.snapshot_name }}
        --data-dir=/var/lib/rancher/rke2/data
        --log-level=info
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server.service
    enabled: yes
    state: started
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent.service
    enabled: no
    state: masked
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: "http://{{ groups['rke2_cluster_group_name'][0] }}:9345/v1/health"
    timeout: 120
  when: (inventory_hostname == groups['rke2_cluster_group_name'][0]) and (rke2_cni is not defined)

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: "http://{{ groups['rke2_cluster_group_name'][0] }}:9345/v1/health?timeout=15s"
    timeout: 120
  when: (inventory_hostname == groups['rke2_cluster_group_name'][0]) and (rke2_cni is defined)

- name: Restore etcd
  block:
    - name: Get registered nodes
      shell: kubectl get nodes -o json
      register: nodes
    - name: Remove old node secrets and nodes
      shell: >
        kubectl delete node "{{ item }}"
        kubectl delete secrets "{{ item }}-token-{{ secrets['items'][0]['metadata']['name'].split('-')[1] }}"
      with_items: "{{ nodes['stdout'] | from_json | json_query('items[*].metadata.name') }}"
  when: (do_etcd_restore is defined) or (do_etcd_restore_from_s3 is defined)

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: inventory_hostname in groups['rke2_cluster_group_name']

