---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    state: started
  delegate_to: localhost
  when: bootstrap_port is defined and bootstrap_port|int > 0

- name: Prepare system
  ansible.builtin.ping:
  become: yes
  become_user: root
  become_method: sudo
  become_flags: '-n'
  check_mode: no
  when: ansible_check_mode != 'True'

- name: Gather bootstrap facts
  ansible.builtin.setup:
  register: bootstrap_facts
  failed_when: false
  rescue:
    - name: Gather bootstrap facts (rescue)
      ansible.builtin.setup:
      register: bootstrap_facts
      failed_when: false

- name: Install bootstrap packages (raw)
  ansible.builtin.raw: "{{ bootstrap_raw_command }}"
  when: ansible_os_family == 'Debian' or ansible_os_family == 'RedHat'

- name: Ensure libdnf5 is present on Fedora/RedHat
  ansible.builtin.package:
    name: libdnf5
    state: present
  when: ansible_os_family == 'RedHat'

- name: Gather ansible facts
  ansible.builtin.setup:
  register: ansible_facts

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ bootstrap_packages }}"
  when: bootstrap_packages is defined

