---
- import_tasks: assert.yml

- name: Install requirements
  package:
    name:
      - bash
    state: present

- name: Install openjdk java (package)
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ java_packages }}"
  when: java_vendor == "openjdk"

- name: Install RPM
  package:
    name: "/usr/share/java/oracle-jdk-{{ java_version }}-rpm.rpm"
    state: present
  when: java_vendor == "oracle" and java_package_format == "rpm" and java_package_source == "local"

- name: Install DEB
  package:
    name: "/usr/share/java/oracle-jdk-{{ java_version }}-deb.deb"
    state: present
  when: java_vendor == "oracle" and java_package_format == "deb" and java_package_source == "local"

- name: Install oracle java (rpm) (repository)
  package:
    name: "{{ oracle_java_rpm_repo_package }}"
    state: present
  when: java_vendor == "oracle" and java_package_format == "rpm" and java_package_source == "repository"

- name: Configure oracle targz
  block:
    - name: Ensure installation directory exists
      file:
        path: /usr/lib/jvm/java-{{ java_version }}-oracle
        state: directory
        mode: '0755'
    - name: Install Oracle Java TARGZ package
      shell: tar -xzf /usr/share/java/oracle-jdk-{{ java_version }}-targz.tar.gz -C /usr/lib/jvm/
      args:
        creates: /usr/lib/jvm/java-{{ java_version }}-oracle

- name: Install oracle java policy software (targz)
  block:
    - name: Ensure installation directory exists
      file:
        path: /usr/java/jce
        state: directory
        mode: '0755'
    - name: Install Oracle Java JCE policy files for Java 8
      shell: tar -xzf /usr/share/java/oracle-java-jce-{{ java_version }}.tar.gz -C /usr/java/jce/

- name: Set alternative (targz)
  alternatives:
    name: java
    path: /usr/lib/jvm/java-{{ java_version }}-oracle/bin/java
    link: /usr/bin/java
    priority: 1
  when: java_vendor == "oracle" and java_package_format == "targz" and ansible_distribution != "Alpine"

- name: Find JAVA_HOME
  shell: readlink -f /usr/bin/java | sed "s:bin/java::"
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    line: "JAVA_HOME={{ java_home_result.stdout }}"
    create: yes
  # Ensure a newline is present at the end of the file

