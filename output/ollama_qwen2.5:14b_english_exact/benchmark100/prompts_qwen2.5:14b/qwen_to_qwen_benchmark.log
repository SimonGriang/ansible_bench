---
- import_tasks: assert.yml

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    state: started

- name: Prepare system
  raw: who && /bin/whoami
  register: test_connection
  changed_when: false
  failed_when: test_connection.rc != 0
  delegate_to: localhost
  when: test_connection.rc != 0
  gather_facts: no
  raw: "apt-get update && apt-get install -y python sudo"
  delegate_to: localhost
  when: test_connection.rc != 0

- name: Gather ansible facts
  setup: {}

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  when: bootstrap_facts_packages is defined
  become: true
  become_method: sudo
  apt:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  when: ansible_os_family == 'Debian'
  become: true
  become_method: sudo
  yum:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  when: ansible_os_family == 'RedHat'
  become: true
  become_method: sudo

