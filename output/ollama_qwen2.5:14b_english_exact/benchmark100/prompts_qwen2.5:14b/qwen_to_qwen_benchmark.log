    owner: "{{ ssl_p12_owner }}"
  become: true
  loop: "{{ ssl_p12_files }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: true
  changed_when: ssl_p12_result is changed
  register: ssl_p12_result

- name: create | Read private key
  command: "openssl rsa -noout -text -in {{ ssl_key_dir }}/{{ ssl_key_name }} | base64 -w 0"
  loop: "{{ ssl_keys }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: true
  register: ssl_key_content

- name: create | Read certificate
  command: "openssl x509 -in {{ ssl_cert_dir }}/{{ ssl_cert_name }} -text -noout | base64 -w 0"
  loop: "{{ ssl_certs }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: true
  register: ssl_cert_content

- name: create | Create combined private_key and certificate file
  copy:
    content: "{{ ssl_key_content.stdout + ssl_cert_content.stdout }}"
    dest: "{{ ssl_combined_dir }}/{{ item.combined_filename }}"
    mode: "{{ ssl_combined_perms }}"
    owner: "{{ ssl_combined_owner }}"
  loop: "{{ ssl_combined_files }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: true
  become: true
  register: ssl_combined_result

