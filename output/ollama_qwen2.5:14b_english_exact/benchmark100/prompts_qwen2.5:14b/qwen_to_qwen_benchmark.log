---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_path }}"
    mode: '0644'
    timeout: 30

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_local_install_script }}"
    dest: "{{ rke2_install_path }}"
    mode: '0700'
    force: true
  when: rke2_airgap_mode and rke2_airgap_implementation

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    mode: '0700'
    state: directory
  when: rke2_airgap_mode and rke2_airgap_implementation != "exists"

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_artifacts_path }}/{{ rke2_checksum_filename }}"
        mode: '0644'
        timeout: 30
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"

    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifact_url }}"
        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_filename }}"
        mode: '0644'
        timeout: 30
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"

    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_path }}"
        mode: '0644'
        timeout: 30
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"
  when: rke2_airgap_mode and rke2_airgap_implementation == "download"

- name: Rescue for failed download
  block:
    - name: Create directory for RKE2
      file:
        path: "{{ rke2_artifacts_path }}"
        mode: '0700'
        state: directory

    - name: Download RKE2 artifacts and install script locally
      block:
        - name: Download RKE2 artifacts
          get_url:
            url: "{{ rke2_artifact_url }}"
            dest: "{{ rke2_local_artifact_path }}/{{ rke2_artifact_filename }}"
            mode: '0644'
            timeout: 30

        - name: Download RKE2 install script
          get_url:
            url: "{{ rke2_install_script_url }}"
            dest: "{{ rke2_local_install_path }}"
            mode: '0644'
            timeout: 30
      register: download_result
      failed_when: false

    - name: Copy RKE2 artifacts to remote host
      copy:
        src: "{{ rke2_local_artifact_path }}/{{ rke2_artifact_filename }}"
        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_filename }}"
        mode: '0640'
        force: true
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"

    - name: Copy RKE2 install script to remote host
      copy:
        src: "{{ rke2_local_install_path }}"
        dest: "{{ rke2_install_path }}"
        mode: '0644'
        force: true
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"
  rescue:
    - name: Create directory for RKE2
      file:
        path: "{{ rke2_artifacts_path }}"
        mode: '0700'
        state: directory

    - name: Download RKE2 artifacts and install script locally
      block:
        - name: Download RKE2 artifacts
          get_url:
            url: "{{ rke2_artifact_url }}"
            dest: "{{ rke2_local_artifact_path }}/{{ rke2_artifact_filename }}"
            mode: '0644'
            timeout: 30

        - name: Download RKE2 install script
          get_url:
            url: "{{ rke2_install_script_url }}"
            dest: "{{ rke2_local_install_path }}"
            mode: '0644'
            timeout: 30
      register: download_result
      failed_when: false

    - name: Copy RKE2 artifacts to remote host
      copy:
        src: "{{ rke2_local_artifact_path }}/{{ rke2_artifact_filename }}"
        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_filename }}"
        mode: '0640'
        force: true
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"

    - name: Copy RKE2 install script to remote host
      copy:
        src: "{{ rke2_local_install_path }}"
        dest: "{{ rke2_install_path }}"
        mode: '0644'
        force: true
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"
  when: rke2_airgap_mode and rke2_airgap_implementation == "download"

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifact_path }}/{{ rke2_artifact_filename }}"
    dest: "{{ rke2_artifacts_path }}/{{ rke2_artifact_filename }}"
    mode: '0640'
    force: true
  when: rke2_airgap_mode and rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create folder for additional images tarballs
      file:
        path: "{{ rke2_tarball_images_path }}"
        mode: '0700'
        state: directory
      when: rke2_airgap_mode and rke2_airgap_copy_additional_tarballs|length > 0 and rke2_airgap_implementation != "exists"

    - name: Copy additional images tarballs to RKE2 tarball images path
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_tarball_images_path }}"
        mode: '0640'
        force: true
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"
      when: rke2_airgap_mode and rke2_airgap_copy_additional_tarballs|length > 0 and rke2_airgap_implementation != "exists"
  when: rke2_airgap_mode and rke2_airgap_copy_additional_tarballs|length > 0 and rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure RKE2 artifacts exist
      file:
        path: "{{ rke2_artifacts_path }}/{{ rke2_artifact_filename }}"
        mode: '0640'
        state: file
      when: rke2_airgap_mode and rke2_airgap_implementation == "exists"

    - name: Ensure RKE2 install script exists
      file:
        path: "{{ rke2_install_path }}"
        mode: '0644'
        state: file
      when: rke2_airgap_mode and rke2_airgap_implementation == "exists"

    - name: Ensure RKE2 artifacts permissions are acceptable
      file:
        path: "{{ rke2_artifacts_path }}/{{ rke2_artifact_filename }}"
        mode: '0640'
        state: file
      when: rke2_airgap_mode and rke2_airgap_implementation == "exists" and rke2_artifacts_path.stat.mode != 4160

    - name: Ensure RKE2 install script permissions are acceptable
      file:
        path: "{{ rke2_install_path }}"
        mode: '0644'
        state: file
      when: rke2_airgap_mode and rke2_airgap_implementation == "exists" and rke2_install_path.stat.mode != 4164
  when: rke2_airgap_mode and rke2_airgap_implementation == "exists"

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Check if separate partition
  shell: "grep '/usr/local' /proc/mounts"
  register: partition_check
  changed_when: false
  failed_when: false

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_artifacts_path if partition_check.rc == 0 else '/usr/local/bin' }}"

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }}/rke2 version"
  register: rke2_version
  changed_when: false
  failed_when: false

- name: Set RKE2 versions
  set_fact:
    installed_rke2_version: "{{ rke2_version.stdout_lines[1] }}"
    running_rke2_version: "{{ rke2_version.stdout_lines[2] }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  block:
    - name: Prevent RKE2 downgrade
      debug:
        msg: "Accidental RKE2 downgrade detected. Install version {{ installed_rke2_version }} is not allowed to go down to version {{ running_rke2_version }}"
      when: installed_rke2_version != running_rke2_version and rke2_allow_downgrade != true
  when: not ansible_check_mode

- name: Run RKE2 install script
  shell: "{{ rke2_bin_path }}/rke2 install --version {{ running_rke2_version }} {{ rke2_install_args }}"
  when: running_rke2_version != installed_rke2_version and not ansible_check_mode
  register: rke2_install_result
  changed_when: true
  failed_when: false
  environment:
    RKE2_AIRGAP_MODE: "{{ rke2_airgap_mode }}"
    RKE2_AIRGAP_IMPLEMENTATION: "{{ rke2_airgap_implementation }}"

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}"
    mode: '0640'
    force: true
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests|length > 0

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}"
    mode: '0640'
    force: true
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods|length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_environment_file }}"
    dest: "{{ rke2_environment_path }}"
    mode: '0640'
    force: true
  when: rke2_environment_options|length > 0 and rke2_environment_options != ""

