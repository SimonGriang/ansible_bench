---
- name: Create the RKE2 config directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  k8s_raw:
    cmd: patch
    name: "/api/v1/nodes/{{ inventory_hostname }}"
    patch: '{"spec":{"taints":[{"key":"rke2.io/role","value":"server","effect":"NoSchedule"}]}}'
    api_version: v1
    kubeconfig: /etc/rancher/rke2/rke2.yaml
  when: rke2_type == "server"

- name: Set agent taints
  k8s_raw:
    cmd: patch
    name: "/api/v1/nodes/{{ inventory_hostname }}"
    patch: '{"spec":{"taints":[{"key":"rke2.io/role","value":"agent","effect":"NoSchedule"}]}}'
    api_version: v1
    kubeconfig: /etc/rancher/rke2/rke2.yaml
  when: rke2_type == "agent"

- name: Copy RKE2 config file
  copy:
    src: rke2-config.yml
    dest: /etc/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: restart_rke2

- name: Copy kubelet config file
  copy:
    src: kubelet-config.yml
    dest: /etc/systemd/system/kubelet.service.d/10-kubelet-config.yml
    owner: root
    group: root
    mode: '0644'
  notify: restart_rke2
  when: kubelet_config is defined and kubelet_config != "None"

- name: Copy Containerd Registry Configuration file
  copy:
    src: containerd-config.yml
    dest: /etc/rancher/rke2/95-containerd-registry.yml
    owner: root
    group: root
    mode: '0644'
  notify: restart_rke2
  when: containerd_config is defined and containerd_config != "None"

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    daemon_reload: yes
  when: rke2_type == "server"
  notify: restart_rke2
  retries: 30
  delay: 10

- name: Mask other RKE2 services
  systemd:
    name: "{{ item }}"
    state: masked
  when: rke2_type != "server"
  with_items:
    - rke2-agent
    - rke2-node

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    path: /var/lib/rancher/rke2/agent/kubelet/kubelet-flags
    state: present
    sleep: 10
    timeout: 300

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    path: /var/run/secrets/kubernetes.io/serviceaccount/token
    state: present
    sleep: 10
    timeout: 300

