---
- import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "SHELL={{ shell }}"
    create: yes
    mode: 0644
  notify: restart_cron

- name: Configure path
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "PATH={{ path }}"
    create: yes
    mode: 0644
  notify: restart_cron

- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "MAILTO={{ mailto }}"
    create: yes
    mode: 0644
  notify: restart_cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: "{{ cron_service is defined and cron_service|length > 0 | bool }}"
  when: cron_service is defined and cron_service|length > 0 | bool

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    state: "{{ item.state }}"
  with_items: "{{ cron_jobs }}"
  when: cron_jobs is defined
  notify: restart_cron

- name: Ensure cron.conf exists
  file:
    path: /etc/cron.d/cron.conf
    state: touch
    mode: 0644
  notify: restart_cron

- name: Restart cron
  handler: service
  service:
    name: cron
    state: restarted

