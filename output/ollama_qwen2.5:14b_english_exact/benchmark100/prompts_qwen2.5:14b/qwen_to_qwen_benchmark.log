---
- import_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  notify: gather_facts
  with_items: "{{ selinux_requirements }}"

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when: ansible_facts.system.selinux.is_selinux_enabled == 1 and ansible_facts.system.selinux.selinux_mode != "permissive"
  block:
    - name: Manage selinux
      selinux:
        policy: "{{ selinux_policy }}"
        state: "{{ selinux_state }}"
      notify: reboot_system

    - name: Manage selinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      with_items: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.name }}"

