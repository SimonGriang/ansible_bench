---
- name: Check if python is installed
  command: which python
  register: python_check
  changed_when: False
  failed_when: False

- name: Check if python3 is installed
  command: which python3
  register: python3_check
  changed_when: False
  failed_when: False

- name: Debug Python executable path
  debug:
    msg: "{{ python_check.stdout }}"
  when: python_check.stdout is defined

- name: Debug Python3 executable path
  debug:
    msg: "{{ python3_check.stdout }}"
  when: python3_check.stdout is defined

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install requirements
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ openssl_requirements }}"

- name: Ensure packaging is available via dnf
  package:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    name: "{{ item }}"
    state: present
  with_items: "{{ openssl_pip_packages }}"

- name: Create key directory
  file:
    path: "{{ openssl_key_path }}"
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Create csr directory
  file:
    path: "{{ openssl_csr_path }}"
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Create crt directory
  file:
    path: "{{ openssl_crt_path }}"
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Include create.yml
  include_tasks: create.yml
  loop: "{{ openssl_items }}"

