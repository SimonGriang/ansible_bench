---
- import_playbook: assert.yml
  name: Task 1: Import assert.yml
  run_once: true
  remote_user: root
  host: localhost

- name: Task 2: Install prerequisites
  become: true
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ vault_prerequisites }}"

- name: Task 3: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Task 4: Add Vault environment variables
  become: true
  lineinfile:
    path: /etc/vault.d/vault.env
    create: yes
    line: "{{ item }}"
  loop: "{{ vault_environment_settings }}"
  notify: Restart vault

- name: Task 5: Include hardening tasks
  include_tasks: hardening.yml

- name: Task 6: Start and enable vault
  when: vault_type == "oss"
  become: true
  service:
    name: vault
    state: started
    enabled: yes

- name: Task 7: Enable vault
  when: vault_type != "oss"
  become: true
  service:
    name: vault
    enabled: yes

