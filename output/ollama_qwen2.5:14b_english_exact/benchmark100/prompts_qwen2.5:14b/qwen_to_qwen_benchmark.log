---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip
  package:
    name: "{{ python_pip }}"
    state: present

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    line: "proxy = {{ python_pip_proxy }}"
    create: true
  when: python_pip_proxy is defined

- name: Trust hosts
  lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ item }}"
    create: true
  loop: "{{ python_pip_trusted_host | default([]) }}"
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: latest
  when: python_pip_update == True and ansible_factsDistributionRelease != "bookworm" and ansible_factsDistributionRelease != "noble" and ansible_os_family != "Alpine"

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version }}"
    state: "{{ item.state }}"
  loop: "{{ python_pip_modules | default([]) }}"
  when: ansible_factsDistributionRelease != "bookworm" and ansible_factsDistributionRelease != "noble" and ansible_os_family != "Alpine"

