---
- name: Task 1: check if all variables have been set correctly
  ansible.builtin.assert:
    that:
      - bootstrap_required_variables|length > 0
    msg: "All required variables must be set before proceeding."

- name: Task 2: wait for host (when configured)
  ansible.builtin.wait_for:
    host: "{{ bootstrap_host }}"
    port: "{{ bootstrap_port }}"
    delay: 5
    timeout: 60
    state: started
  when: bootstrap_wait_for_host|default(false)

- name: Task 3: prepare system
  block:
    - name: Establish a connection to the host and gather facts
      ansible.builtin.setup:
        gather_subset:
          - all
      delegate_to: localhost
      register: system_facts
      changed_when: false
      failed_when: false
    - name: Include tasks to gather bootstrap facts (raw)
      ansible.builtin.raw:
        cmd: "{{ bootstrap_raw_facts_command }}"
      register: raw_facts
      changed_when: false
      failed_when: false
  rescue:
    - name: Display debug message if connection cannot be established
      ansible.builtin.debug:
        msg: "Failed to establish a connection or gather facts."

- name: Task 5: Install bootstrap packages (raw)
  ansible.builtin.raw:
    cmd: "{{ bootstrap_install_raw }}"
  when: ansible_os_family == "RedHat" or ansible_os_family == "Debian"

- name: Task 6: ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      ansible.builtin.setup:
        gather_subset:
          - all
    - name: Install bootstrap packages
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap_packages }}"
  when: ansible_os_family == "RedHat" or ansible_os_family == "Debian"

