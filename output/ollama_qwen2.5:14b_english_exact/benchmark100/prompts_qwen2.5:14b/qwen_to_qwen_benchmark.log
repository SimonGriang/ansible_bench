    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Download Vault binary
  unarchive:
    src: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    owner: root

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_check

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: vault_path_check.stat.exists is not defined or vault_path_check.stat.exists == false and vault_path is defined

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  openssl_certificate:
    path: "{{ vault_data_directory }}/tls/vault.crt"
    privatekey_path: "{{ vault_data_directory }}/tls/vault.key"
    provider: selfsigned
    days: 1095
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item }}"
    owner: "{{ item_owner }}"
    group: "{{ item_group }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
  notify: Restart vault

