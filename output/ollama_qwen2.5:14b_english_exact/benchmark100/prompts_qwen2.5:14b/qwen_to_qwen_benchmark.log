content='---\n- import_tasks: assert.yml\n\n- name: Install required packages\n  package:\n    name: "{{ service_required_packages }}"\n    state: present\n  notify: Gather facts\n\n- name: Configure systemd service\n  template:\n    src: systemd.j2\n    dest: /etc/systemd/system/{{ item.name }}.service\n  when: service_manager == \'systemd\'\n  notify: Systemctl daemon-reload\n  with_items: "{{ service_list }}"\n\n- name: Configure sysvinit service\n  template:\n    src: sysvinit.j2\n    dest: /etc/init.d/{{ item.name }}\n  when:\n    - service_manager in [\'sysvinit\', \'upstart\', \'openrc\']\n  with_items: "{{ service_list }}"\n\n- name: Manage service\n  service:\n    name: "{{ item.name }}"\n    enabled: "{{ item.enabled | default(\'yes\') | bool }}"\n    state: "{{ item.state | default(\'started\') }}"\n  with_items: "{{ service_list }}"\n\n- name: Flush handlers\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-18T06:34:55.222804462Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3515154603, 'load_duration': 88780293, 'prompt_eval_count': 554, 'prompt_eval_duration': 248663607, 'eval_count': 222, 'eval_duration': 3168006251, 'model_name': 'qwen2.5:14b'} id='run--020b27ce-94c2-4e52-a2c3-4910c54dd3e5-0' usage_metadata={'input_tokens': 554, 'output_tokens': 222, 'total_tokens': 776}
