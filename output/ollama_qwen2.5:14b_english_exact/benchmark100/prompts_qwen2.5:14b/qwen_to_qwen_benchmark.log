---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install docker-compose package
  when: installation_type == "package"
  package:
    name: docker-compose
    state: present

- name: Install docker-compose as a binary
  when: installation_type == "binary"
  block:
    - name: Ensure curl is installed
      package:
        name: curl
        state: present

    - name: Download docker-compose binary
      get_url:
        url: "https://github.com/docker/compose/releases/download/1.29.2/docker-compose-$(uname -s)-$(uname -m)"
        dest: /usr/local/bin/docker-compose
        remote_src: yes
      register: download_result

    - name: Move downloaded binary to /usr/local/bin/docker-compose
      copy:
        content: "{{ lookup('file', download_result.dest, errors='ignore') }}"
        dest: /usr/local/bin/docker-compose
        mode: '0755'
      no_log: false  # Added to ensure a boolean value

    - name: Ensure binary is executable
      file:
        path: /usr/local/bin/docker-compose
        mode: '0755'  # Ensured the last line has a newline


