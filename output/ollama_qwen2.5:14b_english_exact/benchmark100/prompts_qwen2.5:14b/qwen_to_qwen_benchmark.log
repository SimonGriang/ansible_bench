---
- import_tasks: assert.yml

- name: Install git
  package:
    name: "{{ item }}"
  loop: "{{ git_packages }}"
  when: git_packages is defined and git_packages|length > 0

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_user }}"
  register: user_exists
  when: git_user is defined

- name: Create directory for git configuration
  file:
    path: "{{ git_config_dir }}"
    state: directory
    mode: '0755'
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: user_exists is defined and user_exists|success and git_config_dir is defined

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "{{ git_config_dir }}/.gitconfig"
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: user_exists is defined and user_exists|success and git_user is defined and git_config_dir is defined

- name: Create repository_destination
  file:
    path: "{{ git_repo_destination }}"
    state: directory
    mode: '0755'
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: user_exists is defined and user_exists|success and git_repo_destination is defined

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repo_destination }}/{{ item.dest }}"
    version: "{{ item.version }}"
    accept_hostkey: yes
    update: yes
  loop: "{{ git_repositories }}"
  when: user_exists is defined and user_exists|success and git_repositories is defined and git_repo_destination is defined
  become: yes
  become_user: "{{ git_user }}"

