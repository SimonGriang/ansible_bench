---
- import_tasks: assert.yml

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: installed
    enablerepo: crb
    enable: true
  when: ansible_os_family == 'RedHat' and ansible_distribution_major_version == '8'

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: "redis.conf.j2"
    dest: "/etc/redis/{{ redis_service }}/redis.conf"
    owner: redis
    group: redis
    mode: '0644'
  notify: restart_redis  # Assuming the handler name might be 'restart_redis' based on the task description

- name: Start and enable redis
  systemd:
    name: "{{ redis_service }}"
    state: started
    enabled: true


