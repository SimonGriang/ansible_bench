    group: "{{ item.group }}"
  with_items: "{{ ssl_items }}"

- name: create | Create ssl certificates
  openssl_certificate:
    path: "{{ item.cert_path }}"
    csr_path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    mode: '0644'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    provider: selfsigned
  with_items: "{{ ssl_items }}"

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    export: true
    name: "{{ item.friendly_name }}"
    base_dn: "{{ item.base_dn }}"
    cacert_dir: "{{ item.cacert_dir }}"
    cert: "{{ item.cert_path }}"
    chain: "{{ item.chain }}"
    key: "{{ item.key_path }}"
    out: "{{ item.pkcs12_path }}"
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ ssl_items }}"

- name: create | Read private key
  slurp:
    src: "{{ item.key_path }}"
  register: private_key_content
  with_items: "{{ ssl_items }}"

- name: create | Read certificate
  slurp:
    src: "{{ item.cert_path }}"
  register: certificate_content
  with_items: "{{ ssl_items }}"

- name: create | Create combined private_key and certificate file
  copy:
    content: "{{ lookup('file', item.key_path) }}{{ lookup('file', item.cert_path) }}"
    dest: "{{ item.combined_path }}"
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ ssl_items }}"
  vars:
    combined_content: >-
      {{ lookup('file', item.key_path) }}
      {{ lookup('file', item.cert_path) }}


