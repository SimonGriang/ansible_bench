- name: Configuring additional config files
  copy:
    src: "{{ item }}"
    dest: /etc/rsyslog.d/
    owner: root
    group: root
    mode: '0640'
  loop: "{{ rsyslog_configs }}"

- name: Start and enable rsyslog
  systemd:
    name: rsyslog
    state: started
    enabled: true


