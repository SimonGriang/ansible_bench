content='---\n- import_tasks: assert.yml\n\n- name: Install required packages\n  package:\n    name: "{{ item }}"\n    state: present\n  notify: gather_facts\n  with_items: "{{ selinux_requirements }}"\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Configure selinux\n  when: ansible_facts.system.selinux.is_selinux_enabled == 1 and ansible_facts.system.selinux.selinux_mode != "permissive"\n  block:\n    - name: Manage selinux\n      selinux:\n        policy: "{{ selinux_policy }}"\n        state: "{{ selinux_state }}"\n      notify: reboot_system\n\n    - name: Manage selinux booleans\n      seboolean:\n        name: "{{ item.name }}"\n        state: "{{ item.state }}"\n        persistent: "{{ item.persistent }}"\n      loop: "{{ selinux_booleans }}"\n      loop_control:\n        label: "{{ item.name[:10] }}"  # Adjusted label to comply with line length rules\n\n#' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-07T21:19:40.050200257Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3704464195, 'load_duration': 96872576, 'prompt_eval_count': 859, 'prompt_eval_duration': 66052739, 'eval_count': 206, 'eval_duration': 3534024770, 'model_name': 'qwen2.5:14b'} id='run--b394d407-8071-4613-b5ed-91453f49ff0c-0' usage_metadata={'input_tokens': 859, 'output_tokens': 206, 'total_tokens': 1065}
