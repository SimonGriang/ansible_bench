---
- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Include OS-specific variables based on distribution
  include_tasks: "{{ ansible_distribution | lower }}-specific.yml"

- name: Include architecture-specific variables
  include_vars: arch-{{ ansible_architecture | lower }}.yml

- name: Set OS-specific variables (part I)
  set_fact:
    java_package_name: "{{ java_package_name | default('openjdk-{{ java_version }}-jdk') }}"
    java_version: "{{ java_version | default('11') }}"
  when: java_package_name is not none and java_version is not none

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    java_home: "{{ java_home | default('/usr/lib/jvm/java-{{ java_version }}-{{ java_jdk_vendor }}') }}"
  when: java_home is not none

- name: Set specific variables
  set_fact:
    java_home: /usr/lib/jvm/java-{{ java_version }}-{{ java_jdk_vendor }}

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt:
        purge: yes
        name: "{{ item }}"
      loop: [ 'deb.sury.org-java', 'debian-archive-jdk' ]
      when: ansible_facts['os_family'] == 'Debian' and ansible_distribution_release not in ['bullseye', 'bookworm']

    - name: Install extra apt tools
      apt:
        name: apt-transport-https
        state: present
      when: ansible_facts['os_family'] == 'Debian' and ansible_distribution_release not in ['bullseye', 'bookworm']

    - name: Add key repositories
      apt_key:
        url: https://packages.{{ java_jdk_vendor }}.io/gpg
        state: present
      when: ansible_facts['os_family'] == 'Debian' and ansible_distribution_release not in ['bullseye', 'bookworm']

    - name: Add repositories
      apt_repository:
        repo: "deb https://packages.{{ java_jdk_vendor }}.io/{{ java_jdk_vendor }}-{{ java_version }} {{ ansible_distribution_release }} main"
        state: present
      when: ansible_facts['os_family'] == 'Debian' and ansible_distribution_release not in ['bullseye', 'bookworm']

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: https://packages.{{ java_jdk_vendor }}.io/gpg
        state: present

    - name: Add repositories
      yum_repository:
        name: "{{ java_jdk_vendor }}-{{ java_version }}"
        description: "{{ java_jdk_vendor }} {{ java_version }} repository"
        baseurl: "https://packages.{{ java_jdk_vendor }}.io/{{ java_jdk_vendor }}-{{ java_version }}/$releasever"
        gpgcheck: yes
        enabled: yes
        state: present

- name: Install required libraries
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_libraries }}"
  when: java_libraries is defined and java_libraries | length > 0

- name: Install Java, Debian
  block:
    - name: Update cache
      apt:
        update_cache: yes

    - name: Install Java
      apt:
        name: "{{ java_package_name }}"
        state: present

    - name: Check package installation status
      shell: dpkg -s {{ java_package_name }}
      register: check_java_installation
      changed_when: '"Status: install ok installed" not in check_java_installation.stdout'
  when: ansible_facts['os_family'] == 'Debian'

- name: Install Java, RedHat
  block:
    - name: Update cache
      yum:
        name: '*'
        state: latest

    - name: Install Java
      yum:
        name: "{{ java_package_name }}"
        state: present

    - name: Check package installation status
      shell: rpm -q {{ java_package_name }}
      register: check_java_installation
      changed_when: '"package {{ java_package_name }} is not installed" in check_java_installation.stderr'
  when: ansible_facts['os_family'] == 'RedHat'

- name: Export environment variables
  template:
    src: environment-variables.j2
    dest: /etc/profile.d/javaenv.sh

- name: Source environment variables
  shell: source /etc/profile.d/javaenv.sh

- name: Correct java version selected for Java versions less than 11
  shell: update-alternatives --set java /usr/lib/jvm/java-{{ java_version }}-{{ java_jdk_vendor }}/jre/bin/java
