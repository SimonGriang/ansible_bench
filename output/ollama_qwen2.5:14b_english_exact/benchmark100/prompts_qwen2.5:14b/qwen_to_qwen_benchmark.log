---
- name: group | Manage group {{ group.name }}
  group:
    name: "{{ group.name }}"
    state: "{{ group.state }}"
    gid: "{{ group.gid | default(None) }}"
    system: "{{ group.system | default('false') | bool }}"

- name: group | Set sudo options for group {{ group.name }}
  block:
    - name: Ensure sudoers file is backed up
      copy:
        src: /etc/sudoers
        dest: /etc/sudoers.bak
        remote_src: yes
      when: group.sudo_options is defined

    - name: Render sudoers file with Jinja2 template
      template:
        src: sudoers.j2
        dest: /tmp/sudoers.new
      when: group.sudo_options is defined

    - name: Validate rendered sudoers file
      command: visudo -c -s < /tmp/sudoers.new
      register: sudoers_validation
      when: group.sudo_options is defined

    - name: Update sudoers file with validated content
      copy:
        src: /tmp/sudoers.new
        dest: /etc/sudoers
        mode: "0440"
        owner: root
        group: root
        backup: yes
      when:
        - group.sudo_options is defined
        - sudoers_validation.rc == 0


