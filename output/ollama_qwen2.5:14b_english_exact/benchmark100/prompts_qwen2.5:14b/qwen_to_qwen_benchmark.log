---
- name: Update apt cache
  apt:
    update_cache: true
  when: ansible_os_family == "Debian"

- name: Update dnf cache
  yum:
    update_cache: true
  when: ansible_os_family == "RedHat"

- name: Install packages
  package:
    name: keepalived
    state: present

- name: Create directory for keepalived
  file:
    path: /etc/keepalived
    state: directory
    mode: '0755'

- name: Create Kubernetes API health check script for Debian OS family
  template:
    src: templates/kubernetes-api-check.sh.j2
    dest: /usr/local/bin/kubernetes-api-check.sh
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == "Debian"
  notify: restart_keepalived

- name: Create Kubernetes API health check script for RedHat OS family
  template:
    src: templates/kubernetes-api-check.sh.j2
    dest: /usr/local/bin/kubernetes-api-check.sh
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == "RedHat"
  notify: restart_keepalived

- name: Create RKE2 Server health check script for Debian OS family
  template:
    src: templates/rke2-server-check.sh.j2
    dest: /usr/local/bin/rke2-server-check.sh
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == "Debian"
  notify: restart_keepalived

- name: Create RKE2 Server health check script for RedHat OS family
  template:
    src: templates/rke2-server-check.sh.j2
    dest: /usr/local/bin/rke2-server-check.sh
    owner: root
    group: root
    mode: '0755'
  when: ansible_os_family == "RedHat"
  notify: restart_keepalived

- name: Create keepalived config file
  template:
    src: templates/keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: '0644'
  notify: restart_keepalived

- name: Enable keepalived and make sure it is not masked
  systemd:
    name: keepalived
    enabled: true
    masked: false
  notify: restart_keepalived

- name: Flush handlers
  meta: flush_handlers

