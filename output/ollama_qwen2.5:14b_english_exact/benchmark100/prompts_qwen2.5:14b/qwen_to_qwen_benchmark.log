tion=Ready\n      - --timeout=100s\n      - --all\n      - pods\n    retries: 100\n    delay: 15\n  when: rke2_wait_for_all_pods_to_be_healthy\n\n#' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-07T20:58:30.07359254Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10946791361, 'load_duration': 72494454, 'prompt_eval_count': 1354, 'prompt_eval_duration': 132435008, 'eval_count': 612, 'eval_duration': 10728141535, 'model_name': 'qwen2.5:14b'} id='run--a6bbfefa-3d3e-4a3a-a0b3-bcbc0a9ab9cf-0' usage_metadata={'input_tokens': 1354, 'output_tokens': 612, 'total_tokens': 1966} 72%|███████▏  | 72/100 [2:15:23<44:45, 95.91s/it] 
