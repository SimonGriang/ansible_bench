---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.slurp:
    path: /etc/os-release
  register: os_release_content

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ os_release_content.content | b64decode | from_json | json_query('ID') }}"
  vars:
    bootstrap_major_version: "{{ os_release_content.content | b64decode | from_json | json_query('VERSION_ID') | regex_replace('([0-9]+)\\..*', '\\1') }}"
    bootstrap_os_family_map:
      - CentOS: centos
      - RedHat: rhel
      - Ubuntu: ubuntu
      - Debian: debian
  loop: "{{ bootstrap_os_family_map[:1] }}"
  loop_control:
    loop_var: item
  when: item[1] == bootstrap_distribution
  register: bootstrap_major_version_result

- name: gather_facts | Set bootstrap facts (I) - Extract major version
  set_fact:
    bootstrap_major_version: "{{ item.result.bootstrap_major_version }}"
  loop: "{{ bootstrap_major_version_result.results }}"
  when: item is defined

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  loop: "{{ bootstrap_os_family_map }}"
  loop_control:
    loop_var: item
  when: bootstrap_distribution == item.key

