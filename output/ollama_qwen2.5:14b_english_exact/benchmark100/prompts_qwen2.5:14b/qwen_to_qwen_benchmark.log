---
- name: Update apt cache
  apt:
    update_cache: yes
  when: ansible_os_family == "Debian"

- name: Update dnf cache
  yum:
    update_cache: yes
  when: ansible_os_family == "RedHat"

- name: Install packages
  package:
    name: keepalived
    state: present

- name: Create directory for keepalived
  file:
    path: /etc/keepalived
    state: directory
    mode: '0755'

- name: Create Kubernetes API health check script for Debian OS family
  template:
    src: templates/kubernetes_api_check.sh.j2
    dest: /etc/keepalived/kubernetes_api_check.sh
    owner: root
    group: root
    mode: '0755'
  notify: restart_keepalived
  when: ansible_os_family == "Debian"

- name: Create Kubernetes API health check script for RedHat OS family
  template:
    src: templates/kubernetes_api_check.sh.j2
    dest: /etc/keepalived/kubernetes_api_check.sh
    owner: root
    group: root
    mode: '0755'
  notify: restart_keepalived
  when: ansible_os_family == "RedHat"

- name: Create RKE2 Server health check script for Debian OS family
  template:
    src: templates/rke2_server_check.sh.j2
    dest: /etc/keepalived/rke2_server_check.sh
    owner: root
    group: root
    mode: '0755'
  notify: restart_keepalived
  when: ansible_os_family == "Debian"

- name: Create RKE2 Server health check script for RedHat OS family
  template:
    src: templates/rke2_server_check.sh.j2
    dest: /etc/keepalived/rke2_server_check.sh
    owner: root
    group: root
    mode: '0755'
  notify: restart_keepalived
  when: ansible_os_family == "RedHat"

- name: Create keepalived config file
  template:
    src: templates/keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: '0644'
  notify: restart_keepalived

- name: Enable keepalived and make sure it is not masked
  systemd:
    name: keepalived
    enabled: yes
    masked: no
  notify: restart_keepalived

- name: Flush handlers
  meta: flush_handlers

