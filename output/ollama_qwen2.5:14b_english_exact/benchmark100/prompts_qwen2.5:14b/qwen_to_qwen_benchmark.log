content='---\n- name: Check if the system is EFI\n  ansible.builtin.file:\n    path: /sys/firmware/efi/efivars\n    state: directory\n  register: efi_system\n  changed_when: false\n\n- name: Remove the grub.cfg file if the system is EFI\n  ansible.builtin.file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: efi_system.stat.isdir\n\n- name: Install a user template for GRUB\n  ansible.builtin.copy:\n    src: templates/grub_user_template\n    dest: /etc/grub.d/01_users\n    owner: root\n    group: root\n    mode: 0700\n  notify: update_grub\n\n- name: Add a password to the EFI GRUB configuration\n  ansible.builtin.lineinfile:\n    path: /etc/grub2-efi.cfg\n    regexp: \'^set superusers="root"\'\n    line: \'set superusers="root"\\npassword_pbkdf2 root ...\'\n  notify: update_grub\n  when: efi_system.stat.isdir\n\n- name: Add a password to the MBR GRUB configuration\n  ansible.builtin.lineinfile:\n    path: /etc/grub2.cfg\n    regexp: \'^set superusers="root"\'\n    line: \'set superusers="root"\\npassword_pbkdf2 root ...\'\n  notify: update_grub\n  when: not efi_system.stat.isdir\n\n- name: Add --unrestricted option to specified files\n  ansible.builtin.replace:\n    path: "{{ item }}"\n    regexp: \'CLASS="([^"]*)"\'\n    replace: \'CLASS="{{ "\\1 --unrestricted" }}\'\n  notify: update_grub\n  when: grub_password_unrestricted\n  with_items: "{{ grub_password_unrestricted_files }}"\n  loop_control:\n    loop_var: item\n\n- name: Ensure GRUB update handler is defined\n  ansible.builtin.meta:\n    flush_handlers:' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-07T18:57:43.613118499Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14727945801, 'load_duration': 105168979, 'prompt_eval_count': 576, 'prompt_eval_duration': 125247473, 'eval_count': 422, 'eval_duration': 7280157926, 'model_name': 'qwen2.5:14b'} id='run--c89b073b-ae6e-4b8a-a8a1-5bb1f18ec609-0' usage_metadata={'input_tokens': 576, 'output_tokens': 422