---
- name: Set the package state based on how Ansible is installed
  ansible.builtin.set_fact:
    ansible_package_state: "{{ 'package' if ansible_local.ansible._install == 'pip' else 'pip'}}"

- name: Set up Ansible on RedHat
  ansible.builtin.import_tasks: setup-RedHat.yml
  when: ansible_package_state == 'package' and ansible_facts['os_family'] == 'RedHat' and ansible_facts['distribution'] != 'Fedora'

- name: Set up Ansible on Fedora
  ansible.builtin.import_tasks: setup-Fedora.yml
  when: ansible_package_state == 'package' and ansible_facts['os_family'] == 'RedHat' and ansible_facts['distribution'] == 'Fedora'

- name: Set up Ansible on Ubuntu
  ansible.builtin.import_tasks: setup-Ubuntu.yml
  when: ansible_package_state == 'package' and ansible_facts['os_family'] == 'Debian' and ansible_facts['distribution'] == 'Ubuntu'

- name: Set up Ansible on Debian
  ansible.builtin.import_tasks: setup-Debian.yml
  when: ansible_package_state == 'package' and ansible_facts['os_family'] == 'Debian' and ansible_facts['distribution'] == 'Debian'

- name: Set up Ansible using Pip
  ansible.builtin.import_tasks: setup-pip.yml
  when: ansible_package_state == 'pip'

