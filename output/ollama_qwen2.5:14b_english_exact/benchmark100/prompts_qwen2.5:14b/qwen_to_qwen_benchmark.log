---
- name: Ensure old versions of Docker are not installed
  ansible.builtin.package:
    name: "{{ item }}"
    state: absent
  loop:
    - docker-engine
    - docker-ce-old
    - docker.io-old

- name: Add Docker GPG key
  ansible.builtin.get_url:
    url: "https://download.docker.com/linux/{{ ansible_distribution.lower() }}/gpg"
    dest: /usr/share/keyrings/docker-archive-keyring.gpg
    mode: "0644"

- name: Add Docker repository
  ansible.builtin.get_url:
    url: "https://download.docker.com/linux/{{ ansible_distribution.lower() }}/repository.txt"
    dest: /etc/apt/sources.list.d/docker.list
  when: ansible_os_family == "Debian"

- name: Add Docker repository
  ansible.builtin.get_url:
    url: "https://download.docker.com/linux/{{ ansible_distribution.lower() }}/repository.rpm"
    dest: /etc/yum.repos.d/docker.repo
  when: ansible_os_family == "RedHat"

- name: Configure Docker Nightly repo
  ansible.builtin.block:
    - name: Add Docker Nightly GPG key
      ansible.builtin.get_url:
        url: "https://download.docker.com/linux/{{ ansible_distribution.lower() }}/nightly/gpg"
        dest: /usr/share/keyrings/docker-nightly-archive-keyring.gpg
        mode: "0644"
    - name: Add Docker Nightly repository
      ansible.builtin.get_url:
        url: "https://download.docker.com/linux/{{ ansible_distribution.lower() }}/nightly/repository.txt"
        dest: /etc/apt/sources.list.d/docker-nightly.list
      when: ansible_os_family == "Debian"
    - name: Add Docker Nightly repository
      ansible.builtin.get_url:
        url: "https://download.docker.com/linux/{{ ansible_distribution.lower() }}/nightly/repository.rpm"
        dest: /etc/yum.repos.d/docker-nightly.repo
      when: ansible_os_family == "RedHat"
  when: docker_configure_nightly | bool

- name: Configure Docker Test repo
  ansible.builtin.block:
    - name: Add Docker Test GPG key
      ansible.builtin.get_url:
        url: "https://download.docker.com/linux/{{ ansible_distribution.lower() }}/test/gpg"
        dest: /usr/share/keyrings/docker-test-archive-keyring.gpg
        mode: "0644"
    - name: Add Docker Test repository
      ansible.builtin.get_url:
        url: "https://download.docker.com/linux/{{ ansible_distribution.lower() }}/test/repository.txt"
        dest: /etc/apt/sources.list.d/docker-test.list
      when: ansible_os_family == "Debian"
    - name: Add Docker Test repository
      ansible.builtin.get_url:
        url: "https://download.docker.com/linux/{{ ansible_distribution.lower() }}/test/repository.rpm"
        dest: /etc/yum.repos.d/docker-test.repo
      when: ansible_os_family == "RedHat"
  when: docker_configure_test | bool

- name: Configure containerd on RHEL 8
  ansible.builtin.package:
    name: runc
    state: absent
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"
  become: true

- name: Configure containerd on RHEL 8
  ansible.builtin.package:
    name: container-selinux
    state: present
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"
  become: true

- name: Configure containerd on RHEL 8
  ansible.builtin.package:
    name: containerd.io
    state: present
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"
  become: true

