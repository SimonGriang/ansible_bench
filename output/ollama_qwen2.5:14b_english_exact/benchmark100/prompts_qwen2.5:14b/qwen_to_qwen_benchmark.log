---
- import_tasks: assert.yml
  name: Import assert.yml to handle assertions and validations

- name: Install the required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ sysctl_requirements }}"
  when: sysctl_requirements is defined and sysctl_requirements | length > 0

- name: Set sysctl setting
  sysctl:
    name: "{{ item.key }}"
    value: "{{ item.value }}"
    state: present
    reload: yes
  loop: "{{ sysctl_items }}"
  when: sysctl_items is defined and sysctl_items | length > 0 and not ansible_facts['containerized']
  #

