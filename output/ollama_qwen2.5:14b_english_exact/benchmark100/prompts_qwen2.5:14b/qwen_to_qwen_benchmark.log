---
- import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ cron_packages | default([]) }}"

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/cron-config
    line: "SHELL={{ cron_shell }}"
    create: yes
    mode: '0600'
    regexp: '^SHELL='
    state: present
  notify: Restart cron

- name: Configure path
  lineinfile:
    path: /etc/cron.d/cron-config
    line: "PATH={{ cron_path }}"
    create: yes
    mode: '0600'
    regexp: '^PATH='
    state: present
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/cron-config
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    mode: '0600'
    regexp: '^MAILTO='
    state: present
  notify: Restart cron

- name: Start and enable cron
  service:
    name: cron
    enabled: true
    state: started
  when: cron_service is defined and cron_service | length > 0

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.schedule.minute | default('0') }}"
    hour: "{{ item.schedule.hour | default('0') }}"
    day: "{{ item.schedule.day | default('*') }}"
    month: "{{ item.schedule.month | default('*') }}"
    weekday: "{{ item.schedule.weekday | default('*') }}"
    job: "{{ item.command }}"
  loop: "{{ cron_jobs | default([]) }}"

