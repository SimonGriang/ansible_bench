uration': 20666378030, 'model_name': 'qwen2.5:14b'} id='run--35441e42-50be-489c-aafa-18dfcb22b4a4-0' usage_metadata={'input_tokens': 1901, 'output_tokens': 1004, 'total_tokens': 2905}
