---
- name: Create the RKE2 config directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  k8s_raw:
    cmd: patch
    name: /api/v1/nodes/{{ inventory_hostname }}
    patch: '{"spec":{"taints":[{"key":"rke2.io/role","value":"server","effect":"NoSchedule"}]}}'
    api_version: v1
    kubeconfig: /etc/rancher/rke2/rke2.yaml
    when: rke2_type == 'server'

- name: Set agent taints
  k8s_raw:
    cmd: patch
    name: /api/v1/nodes/{{ inventory_hostname }}
    patch: '{"spec":{"taints":[{"key":"rke2.io/role","value":"agent","effect":"NoSchedule"}]}}'
    api_version: v1
    kubeconfig: /etc/rancher/rke2/rke2.yaml
    when: rke2_type == 'agent'

- name: Copy RKE2 config file
  copy:
    src: rke2-config.yml
    dest: /etc/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: restart_rke2

- name: Copy kubelet config file
  copy:
    src: kubelet-config.yml
    dest: /etc/systemd/system/kubelet.service.d/10-kubelet-config.yml
