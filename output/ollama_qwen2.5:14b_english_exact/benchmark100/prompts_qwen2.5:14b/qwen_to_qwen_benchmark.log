- name: Ensure document root directories are created for each virtual host
  file:
    path: "{{ item.docroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when: item.docroot is defined and (item.create_docroot is not defined or item.create_docroot == True)

- name: Create virtual host configuration files
  template:
    src: vhost_conf_template
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify: test_apache_conf
  notify: restart_apache

- name: Enable virtual hosts on Debian-based systems
  command: a2ensite "{{ item.name }}"
  args:
    creates: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian'
  notify: test_apache_conf
  notify: restart_apache

