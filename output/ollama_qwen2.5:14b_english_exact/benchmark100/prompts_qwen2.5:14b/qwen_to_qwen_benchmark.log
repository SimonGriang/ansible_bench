---
- name: Create the RKE2 config directory
  file:
    path: /etc/rke2/config
    state: directory
    mode: '0755'

- name: Set server taints
  when: rke2_type == 'server'
  k8s_raw:
    api_version: node.k8s.io/v1
    kind: Node
    namespace: ""
    name: "{{ inventory_hostname }}"
    operation: patch
    type: strategic
    value: |
      {
        "spec": {
          "taints": [
            {
              "effect": "NoSchedule",
              "key": "node-role.kubernetes.io/control-plane",
              "value": "true"
            }
          ]
        }
      }

- name: Set agent taints
  when: rke2_type == 'agent'
  k8s_raw:
    api_version: node.k8s.io/v1
    kind: Node
    namespace: ""
    name: "{{ inventory_hostname }}"
    operation: patch
    type: strategic
    value: |
      {
        "spec": {
          "taints": [
            {
              "effect": "NoSchedule",
              "key": "node-role.kubernetes.io/worker",
              "value": "true"
            }
          ]
        }
      }

- name: Copy RKE2 config file
  copy:
    src: /path/to/rke2-config.yml
    dest: /etc/rke2/config/rke2-config.yml
  notify: restart_rke2

- name: Copy kubelet config file
  when: kubelet_config is defined and kubelet_config is not ''
  copy:
    src: /path/to/kubelet-config.yml
    dest: /etc/rke2/config/kubelet-config.yml
  notify: restart_rke2

- name: Copy Containerd Registry Configuration file
  when: containerd_registry_config is defined and containerd_registry_config is not ''
  copy:
    src: /path/to/containerd-registry-config.yml
    dest: /etc/rke2/config/containerd-registry-config.yml
  notify: restart_rke2

- name: Start RKE2 service
  systemd:
    name: rke2
    enabled: yes
    state: started
    daemon_reload: yes
    masked: no
  register: rke2_start_result
  until: rke2_start_result is succeeded
  retries: 60
  delay: 10
  notify: restart_rke2

- name: Mask other RKE2 services
  when: rke2_type != 'agent'
  systemd:
    name: rke2-agent
    enabled: no
    state: masked
  notify: restart_rke2

- name: Wait for remaining nodes to be ready - no CNI
  when: not cni_initialization
  shell: kubectl get nodes -o json | jq '.items[] | select(.metadata.name != "{{ inventory_hostname }}") | .status.conditions[] | select(.type == "Ready") | .status'
  register: nodes_ready
  until: nodes_ready.stdout.find("True") != -1
  retries: 60
  delay: 10

- name: Wait for remaining nodes to be ready - with CNI
  when: cni_initialization
  shell: kubectl get nodes -o json | jq '.items[] | select(.metadata.name != "{{ inventory_hostname }}") | .status.conditions[] | select(.type == "Ready") | .status'
  register: nodes_ready_cni
  until: nodes_ready_cni.stdout.find("True") != -1
  retries: 60
  delay: 10

