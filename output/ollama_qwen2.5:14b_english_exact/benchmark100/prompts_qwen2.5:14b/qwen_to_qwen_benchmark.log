---
- name: Java | Install OpenJDK implementation
  ansible.builtin.apt:
    name: default-jdk
    state: present
  when: ansible_os_family == "Debian"

- name: Java | Install OpenJDK implementation
  ansible.builtin.yum:
    name: java-1.8.0-openjdk-devel
    state: present
  when: ansible_os_family == "RedHat"

- name: Java | Import certificates into Java Keystore
  ansible.builtin.shell: |
    {{ item }}
  with_items: "{{ java_certs }}"
  when:
    - java_certs is defined
    - java_certs|length > 0
  args:
    creates: /etc/java-cacerts
  register: import_certs_result

- name: Ensure import certificates into Java Keystore was successful
  ansible.builtin.fail:
    msg: "Failed to import certificate {{ item.item }}: {{ item.stderr }}"
  when: import_certs_result.results|map(attribute='rc')|any
  with_items: "{{ import_certs_result.results }}"

