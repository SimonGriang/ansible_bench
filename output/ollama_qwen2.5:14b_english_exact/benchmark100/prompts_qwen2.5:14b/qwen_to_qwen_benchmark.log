---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Easyrsa init-pki
  command: "{{ openvpn_bin }}easyrsa init-pki"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/private/ca.key').exists)

- name: Easyrsa build-ca
  command: "{{ openvpn_bin }}easyrsa build-ca nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/ca.crt').exists)

- name: Easyrsa gen-dh
  command: "{{ openvpn_bin }}easyrsa gen-dh"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/dh.pem').exists)

- name: Easyrsa build-server-full server nopass
  command: "{{ openvpn_bin }}easyrsa build-server-full server nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/issued/server.crt').exists)

- name: Easyrsa build-client-full client nopass
  command: "{{ openvpn_bin }}easyrsa build-client-full client nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/issued/client.crt').exists)

- name: Easyrsa gen-crl
  command: "{{ openvpn_bin }}easyrsa gen-crl"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='/etc/openvpn/easy-rsa/pki/crl.pem').exists)

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  command: "{{ openvpn_bin }}openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key"
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to /etc/openvpn/server
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/{{ item }}
    mode: 0644
  with_items:
    - ca.crt
    - dh.pem
    - server.crt
    - server.key
    - ta.key
  notify: restart openvpn

- name: Copy files to /etc/openvpn
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/{{ item }}
    mode: 0644
  with_items:
    - ca.crt
    - dh.pem
    - ta.key
  notify: restart openvpn

- name: Place server.conf
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
  notify: restart openvpn

