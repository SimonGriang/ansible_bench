---
- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that: ansible_systemd is defined

- name: Get latest release of promtail
  ansible.builtin.uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
    status_code: 200
  register: promtail_release
  vars:
    promtail_version: "{{ (promtail_release.json | json_query('tag_name'))[0] }}"

- name: Test if zip local archive exists
  ansible.builtin.stat:
    path: "{{ promtail_version }}-{{ go_arch }}.zip"
  register: promtail_archive_stat

- name: Assert local binary exists
  ansible.builtin.assert:
    that:
      - promtail_binary_local_dir is defined
      - promtail_binary_local_dir is directory
      - promtail_binary_local_dir is exists

- name: Get checksum list
  ansible.builtin.uri:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/checksums.txt"
    return_content: yes
    status_code: 200
  register: promtail_checksum_list

- name: Get checksum for specific architecture
  ansible.builtin.set_fact:
    promtail_checksum: "{{ promtail_checksum_list.content | b64decode | community.general.regexp_search('promtail-linux-' + go_arch + '\\.zip\\s*(.*)') | first }}"

