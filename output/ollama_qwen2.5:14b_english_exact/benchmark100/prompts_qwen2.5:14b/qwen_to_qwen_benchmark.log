---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install docker-compose package
  package:
    name: docker-compose
    state: present
  when: installation_type == "package"

- name: Install docker-compose as a binary
  block:
    - name: Ensure dependencies are installed
      package:
        name: "{{ item }}"
        state: present
      with_items:
        - curl
        - unzip
    - name: Download and install docker-compose binary
      get_url:
        url: "https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-{{ docker_compose_version }}-{{ system_arch }}.tar.gz"
        dest: /usr/local/bin/docker-compose.tar.gz
      register: download_result
    - name: Extract and install docker-compose binary
      unarchive:
        src: /usr/local/bin/docker-compose.tar.gz
        dest: /usr/local/bin/
        remote_src: yes
      args:
        creates: /usr/local/bin/docker-compose
    - name: Set executable permissions on docker-compose binary
      file:
        path: /usr/local/bin/docker-compose
        mode: 'u+x'
        owner: root
        group: root
  when: installation_type == "binary"

