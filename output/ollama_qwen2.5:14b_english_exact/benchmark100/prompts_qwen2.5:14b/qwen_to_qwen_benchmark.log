---
- name: Create local ssh_key_directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ user.ssh_key_directory }}"
    state: directory
    mode: 0750
  when: user.manage_ssh_key
  run_once: true
  delegate_to: localhost
  become: false

- name: Manage user {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    state: "{{ user.state }}"
    password: "{{ user.password }}"
    update_password: "{{ user.update_password }}"
    uid: "{{ user.uid }}"
    gid: "{{ user.gid }}"
    groups: "{{ user.groups }}"
    shell: "{{ user.shell }}"
    create_home: "{{ user.create_home }}"
    system: "{{ user.system }}"
    expires: "{{ user.expires }}"
    move_home: "{{ user.move_home }}"
    generate_larger_than: "{{ user.generate_larger_than }}"
    force: "{{ user.force }}"

- name: Set sudo options for {{ user.name }}
  ansible.builtin.template:
    src: "templates/sudoers.d.j2"
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: 0640
  when: user.sudo_options is defined
  register: sudo_options_result
  failed_when: sudo_options_result is failed
  notify: Validate sudoers.d file

- name: Remove sudo options for {{ user.name }}
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  ansible.builtin.shell: >
    ssh-keygen -t rsa -b 4096 -f {{ user.ssh_key_directory }}/{{ user.name }} -q -N ""
  when: user.manage_ssh_key
  run_once: true
  delegate_to: localhost
  become: false

- name: Generate public ssh key for {{ user.name }}
  ansible.builtin.shell: >
    ssh-keygen -y -f {{ user.ssh_key_directory }}/{{ user.name }} > {{ user.ssh_key_directory }}/{{ user.name }}.pub
  when: user.manage_ssh_key
  run_once: true
  delegate_to: localhost
  become: false

- name: Convert ssh key to ppk for {{ user.name }}
  ansible.builtin.shell: >
    puttygen {{ user.ssh_key_directory }}/{{ user.name }} -o {{ user.ssh_key_directory }}/{{ user.name }}.ppk -q
  when: user.manage_ssh_key
  run_once: true
  delegate_to: localhost
  become: false

- name: Get or set the home directory for {{ user.name }}
  ansible.builtin.stat:
    path: "{{ user.home_directory }}"
  register: home_directory_stat

- name: Create .ssh directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ user.home_directory }}/.ssh"
    state: directory
    mode: 0700
  when: user.manage_ssh_key or user.private_keys is defined
  become: true

- name: Deploy authorized keys for {{ user.name }}
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ item }}"
  with_items: "{{ user.authorized_keys }}"
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for {{ user.name }}
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item }}"
  with_items: "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for {{ user.name }}
  ansible.builtin.copy:
    src: "{{ user.ssh_key_directory }}/{{ user.name }}"
    dest: "{{ user.home_directory }}/.ssh/id_rsa"
    mode: 0600
  when: user.copy_private_key
  become: true

- name: Check users password valid time for {{ user.name }}
  ansible.builtin.shell: >
    chage -l {{ user.name }} | grep "Password expires"
  register: password_validity
  changed_when: false

- name: Set users password valid time for {{ user.name }}
  ansible.builtin.shell: >
    chage -M {{ user.password_validity_days }} {{ user.name }}
  when: user.password_validity_days is defined and password_validity.stdout is not defined

- name: Place private key file for {{ user.name }}
  ansible.builtin.copy:
    src: "{{ user.private_keys[0] }}"
    dest: "{{ user.home_directory }}/.ssh/id_rsa"
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.private_keys is defined

