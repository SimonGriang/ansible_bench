---
- name: Download RKE2 kubeconfig to localhost
  copy:
    src: /etc/rancher/rke2/rke2.yaml
    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    remote_src: yes
  when: rke2_download_kubeconf|d(False)|bool and inventory_hostname == groups['rke2_servers_group_name'][0]

- name: Replace loopback IP by master server IP
  command: "{{ ansible_env.HOME }}/.local/bin/kubeseal --format kube --regex '{{ rke2_api_ip|default(groups['rke2_servers_group_name'][0].ansible_host) }}' --find '{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}' | sponge '{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}'"
  register: replace_loopback_ip
  vars:
    ansible_check_mode: false
  when: not ansible_check_mode and rke2_download_kubeconf|d(False)|bool and inventory_hostname == groups['rke2_servers_group_name'][0']


