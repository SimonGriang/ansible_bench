---
- name: Ensure dirmngr is installed (gnupg dependency)
  package:
    name: dirmngr
    state: present

- name: Add ansible repository
  apt_repository:
    repo: 'ppa:ansible/ansible'
    state: present
  when: ansible_os_family == "Debian"

- name: Add ansible repository
  yum_repository:
    name: ansible
    description: Ansible Repository
    baseurl: https://repos.fedorapeople.org/repos/openstack-ansible/testing/epel-7/
    gpgcheck: false
    enabled: true
  when: ansible_os_family == "RedHat"

- name: Install Ansible
  package:
    name: ansible
    state: "{{ ansible_package_state | default('latest') }}"  # Line break intentionally kept to ensure compliance with yamllint's new-line-at-end-of-file rule

