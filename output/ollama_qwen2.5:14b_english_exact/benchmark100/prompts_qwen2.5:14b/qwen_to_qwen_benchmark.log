---
- name: Create document root directories for each virtual host
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  when: item.create_docroot is undefined or item.create_docroot|default(true)
  loop: "{{ httpd_vhosts }}"
  register: docroot_creation

- name: Configure virtual hosts using a template
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"
  notify: test and restart httpd

