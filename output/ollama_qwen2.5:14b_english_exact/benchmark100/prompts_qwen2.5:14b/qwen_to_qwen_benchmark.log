---
- name: Cordon and Drain the node {{ rke2_node_name }}
  command: kubectl cordon {{ rke2_node_name }}
  register: cordon_result
  retries: 100
  delay: 15
  until: cordon_result.rc == 0
  changed_when: false

- name: Cordon and Drain the node {{ rke2_node_name }}
  command: >
    kubectl drain {{ rke2_node_name }}
    --delete-local-data=true
    --ignore-daemonsets=true
    --force
    --timeout=5m
    --delete-emptydir-data
    --privileged=true
    --drain-via-admission-webhook
    --delete-detached
    --ignore-pdb
    --pod-eviction-timeout=5m
    --skip-confirmed
    --grace-period=10
    --timeout=5m
    --ignore-mirror-pods
    --ignore-singular-pods
    --ignore-sync-owners
    --ignore-uninitialized-pods
    --rke2-data-path="{{ rke2_data_path }}"
    {{ rke2_drain_additional_args | regex_replace('^(?!\s*$).', '--') }}
  register: drain_result
  retries: 100
  delay: 15
  until: drain_result.rc == 0
  changed_when: false

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: >
    kubectl get nodes -o json | jq -r '.items[] | select(.status.conditions[] | select(.type == "Ready" and .status == "True")).metadata.name'
  register: nodes_ready
  retries: 100
  delay: 15
  until: nodes_ready.stdout_lines | length == nodes_ready.results[0].stdout_lines | length
  changed_when: false

- name: Uncordon the node {{ rke2_node_name }}
  command: kubectl uncordon {{ rke2_node_name }}
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  shell: >
    kubectl get pods --all-namespaces -o json | jq -r '.items[] | select(.status.containerStatuses[].ready == true) | .metadata.name'
  register: pods_ready
  retries: 100
  delay: 15
  until: pods_ready.stdout_lines | length == pods_ready.results[0].stdout_lines | length
  changed_when: false
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  shell: >
    kubectl wait --for=condition=ready --timeout=120s pods --all-namespaces --all
  register: pods_healthy
  retries: 100
  delay: 15
  until: pods_healthy.rc == 0
  changed_when: false
  when: rke2_wait_for_all_pods_to_be_healthy


