---
- import_tasks: assert.yml
  name: Import the assert.yml file to handle assertions
  remote_user: localhost

- name: Configure package management for apk
  ansible.builtin.yum:
    name: apk-tools-upgrade
    state: latest
  notify: reboot

- name: Configure package management for apt
  block:
    - ansible.builtin.apt:
        name: "{{ packages }}"
        state: present
        upgrade: false
    - ansible.builtin.apt:
        update_cache: yes
        autoremove: yes
  notify: reboot

- name: Update all software using dnf
  ansible.builtin.yum:
    name: "*"
    state: latest
    exclude: kernel*
  notify: reboot

- name: Update all software using pacman
  ansible.builtin.yum:
    name: "@core"
    state: latest
  notify: reboot

- name: Configure package management for yum
  block:
    - ansible.builtin.yum:
        name: "@*"
        state: latest
    - ansible.builtin.yum:
        name: yum-utils
        state: present
        when: yum_utils_installed == "false"
  notify: reboot

- name: Update all software using zypper
  ansible.builtin.yum:
    name: "*"
    state: latest
  notify: reboot

