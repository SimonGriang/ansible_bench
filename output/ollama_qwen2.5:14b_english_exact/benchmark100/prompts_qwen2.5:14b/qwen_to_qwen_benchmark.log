---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  ansible.builtin.file:
    path: /usr/local/bin/python3.11/EXTERNALLY-MANAGED
    state: file
    mode: '0644'

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.file:
    src: /usr/local/bin/python3.11/EXTERNALLY-MANAGED
    dest: /usr/local/bin/python3.11/EXTERNALLY-MANAGED.old
    state: link
  when: ansible.builtin.stat(file="/usr/local/bin/python3.11/EXTERNALLY-MANAGED").exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  ansible.builtin.file:
    path: /usr/local/bin/python3.12/EXTERNALLY-MANAGED
    state: file
    mode: '0644'

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.file:
    src: /usr/local/bin/python3.12/EXTERNALLY-MANAGED
    dest: /usr/local/bin/python3.12/EXTERNALLY-MANAGED.old
    state: link
  when: ansible.builtin.stat(file="/usr/local/bin/python3.12/EXTERNALLY-MANAGED").exists

- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  ansible_become: true

- name: Install python pip
  ansible.builtin.pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_packages }}"
  when: python_pip_packages is defined and python_pip_packages | length > 0

- name: Configure pip proxy
  ansible.builtin.template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: '0644'
  when: python_pip_proxy is defined and python_pip_proxy | length > 0

- name: Trust hosts
  ansible.builtin.block:
    - name: Configure trusted hosts
      ansible.builtin.lineinfile:
        path: /etc/pip.conf
        regexp: '^trusted-host\s+'
        line: "trusted-host = {{ python_pip_trusted_host }}"
        create: yes
  when: python_pip_trusted_host is defined and python_pip_trusted_host | length > 0

- name: Update pip
  ansible.builtin.pip:
    name: pip
    state: latest
    extra_args: "--upgrade --no-cache-dir"
  when: python_pip_update | bool and ansible_facts['os_info']['name'] not in ['bookworm', 'noble', 'Alpine']

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when: python_pip_modules is defined and python_pip_modules | length > 0 and ansible_facts['os_info']['name'] not in ['bookworm', 'noble', 'Alpine']

