---
- name: create | Create ssl key
  openssl_pkcs12:
    state: present
  become: yes
  vars:
    ssl_key_dir: "{{ item.ssl_key_dir }}"
    ssl_key_name: "{{ item.ssl_key_name }}"
    ssl_key_perms: "{{ item.ssl_key_perms }}"
    ssl_key_owner: "{{ item.ssl_key_owner }}"
  register: ssl_key_result
  loop: "{{ ssl_keys }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes
  changed_when: ssl_key_result.changed

- name: create | Create ssl csr
  openssl_csr:
    state: present
    privatekey_path: "{{ ssl_key_dir }}/{{ ssl_key_name }}"
    common_name: "{{ item.common_name }}"
  become: yes
  vars:
    ssl_csr_dir: "{{ item.ssl_csr_dir }}"
    ssl_csr_name: "{{ item.ssl_csr_name }}"
    ssl_csr_perms: "{{ item.ssl_csr_perms }}"
    ssl_csr_owner: "{{ item.ssl_csr_owner }}"
  register: ssl_csr_result
  loop: "{{ ssl_csrs }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes
  changed_when: ssl_csr_result.changed

- name: create | Create ssl certificates
  openssl_certificate:
    provider: selfsigned
    csr_path: "{{ ssl_csr_dir }}/{{ ssl_csr_name }}"
    privatekey_path: "{{ ssl_key_dir }}/{{ ssl_key_name }}"
    cert_path: "{{ ssl_cert_dir }}/{{ ssl_cert_name }}"
    days: 365
  become: yes
  vars:
    ssl_cert_dir: "{{ item.ssl_cert_dir }}"
    ssl_cert_name: "{{ item.ssl_cert_name }}"
    ssl_cert_perms: "{{ item.ssl_cert_perms }}"
    ssl_cert_owner: "{{ item.ssl_cert_owner }}"
  register: ssl_cert_result
  loop: "{{ ssl_certs }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes
  changed_when: ssl_cert_result.changed

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    state: present
    name: "{{ item.p12_filename }}"
    certificate: "{{ ssl_cert_dir }}/{{ ssl_cert_name }}"
    privatekey: "{{ ssl_key_dir }}/{{ ssl_key_name }}"
    password: "{{ item.p12_password }}"
    dest: "{{ ssl_p12_dir }}/{{ item.p12_filename }}"
  become: yes
  vars:
    ssl_p12_dir: "{{ item.ssl_p12_dir }}"
    ssl_p12_perms: "{{ item.ssl_p12_perms }}"
    ssl_p12_owner: "{{ item.ssl_p12_owner }}"
  register: ssl_p12_result
  loop: "{{ ssl_p12_files }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes
  changed_when: ssl_p12_result.changed

- name: create | Read private key
  command: "openssl rsa -noout -text -in {{ ssl_key_dir }}/{{ ssl_key_name }} | base64 -w 0"
  register: ssl_key_content
  loop: "{{ ssl_keys }}"
  delegate_to: "{{ item.inventory_hostname }}"
  delegate_facts: yes

