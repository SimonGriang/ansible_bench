---
- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_directories }}"
  tags:
    - directories

- name: Configure directories
  block:
    - name: Apply template to directory configuration
      template:
        src: directory.conf.j2
        dest: "{{ item }}"
      loop: "{{ httpd_directories }}"
      tags:
        - directories

    - name: Test httpd configuration
      command: /usr/sbin/httpd -t
      changed_when: false
      tags:
        - directories

    - name: Restart httpd service
      service:
        name: httpd
        state: restarted
      tags:
        - directories

