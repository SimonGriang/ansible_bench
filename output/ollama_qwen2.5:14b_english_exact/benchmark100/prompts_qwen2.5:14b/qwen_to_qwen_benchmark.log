---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Easyrsa init-pki
  command: "{{ easy_rsa_path }}/easyrsa init-pki"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='{{ easy_rsa_path }}/pki/private/ca.key').exists)

- name: Easyrsa build-ca
  command: "{{ easy_rsa_path }}/easyrsa build-ca nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='{{ easy_rsa_path }}/pki/ca.crt').exists)

- name: Easyrsa gen-dh
  command: "{{ easy_rsa_path }}/easyrsa gen-dh"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='{{ easy_rsa_path }}/pki/dh.pem').exists)

- name: Easyrsa build-server-full server nopass
  command: "{{ easy_rsa_path }}/easyrsa build-server-full server nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='{{ easy_rsa_path }}/pki/issued/server.crt').exists)

- name: Easyrsa build-client-full client nopass
  command: "{{ easy_rsa_path }}/easyrsa build-client-full client nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='{{ easy_rsa_path }}/pki/issued/client.crt').exists)

- name: Easyrsa gen-crl
  command: "{{ easy_rsa_path }}/easyrsa gen-crl"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not (stat(path='{{ easy_rsa_path }}/pki/crl.pem').exists)

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to /etc/openvpn/server
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn/server/{{ item | basename }}
    mode: 0600
  with_items:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/ta.key
    - /etc/openvpn/easy-rsa/pki/dh.pem
    - /etc/openvpn/easy-rsa/pki/issued/server.crt
    - /etc/openvpn/easy-rsa/pki/private/server.key

- name: Copy files to /etc/openvpn
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn/{{ item | basename }}
    mode: 0600
  with_items:
    - /etc/openvpn/easy-rsa/pki/ca.crt
    - /etc/openvpn/easy-rsa/pki/dh.pem
    - /etc/openvpn/easy-rsa/pki/crl.pem

- name: Place server.conf
  template:
    src: templates/server.conf.j2
    dest: /etc/openvpn/server/server.conf
  notify: restart openvpn

