- name: Install repository for RedHat
  include_tasks: redhat_repo.yml

- name: Configure debian
  include_tasks: debian_repo.yml

- name: Install required package gpg
  apt:
    name: software-properties-common
    state: present
  when: ansible_os_family == "Debian"

- name: Install apt key for Debian
  apt_key:
    url: https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x4396a4d8e6ba2156
    state: present
  when: ansible_os_family == "Debian"

- name: Install repository for Debian
  apt_repository:
    filename: /etc/apt/sources.list.d/hashicorp.list
    filename_deb: /etc/apt/sources.list.d/hashicorp.list
    filename_src: /etc/apt/sources.list.d/hashicorp.list
    repo: 'deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} {{ ansible_distribution_version }}'
    state: present
  when: ansible_os_family == "Debian"

- name: Install hashicorp product using package
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ hashicorp_products }}"
  when: ansible_os_family in ['Debian', 'RedHat']

- name: Install versioned hashicorp product using package
  package:
    name: "{{ item }}={{ version }}"
    state: present
  loop: "{{ hashicorp_products }}"
  when: version is defined and ansible_os_family in ['Debian', 'RedHat']

- name: Install manually
  include_tasks: manual_install.yml

- name: Install hashicorp product manually
  unarchive:
    src: "{{ item }}"
    dest: "{{ destination }}"
    remote_src: yes
    owner: root
    group: root
    mode: '0755'
  loop: "{{ hashicorp_products }}"
  when: ansible_os_family in ['Debian', 'RedHat']

