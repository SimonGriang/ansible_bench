    password_expiration_days_after_change: "{{ user.password_expiration_days_after_change }}"
    password_expiration_days_before_change: "{{ user.password_expiration_days_before_change }}"
    password_expiration_days_after_expiration: "{{ user.password_expiration_days_after_expiration }}"
    password_expiration_days_before_expiration: "{{ user.password_expiration_days_before_expiration }}"

- name: Set sudo options for {{ user.name }}
  ansible.builtin.copy:
    content: "{{ user.sudo_options }}"
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: '0640'
    owner: root
    group: root
    remote_src: false
  when: user.sudo_options is defined
  register: sudo_options_set
  changed_when: sudo_options_set.changed
  notify: Validate sudoers.d file

- name: Remove sudo options for {{ user.name }}
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  ansible.builtin.command: ssh-keygen -t rsa -b {{ user.ssh_key_bits }} -f {{ user.ssh_key_file }} -N ""
  args:
    creates: "{{ user.ssh_key_file }}"
  when: user.manage_ssh_key|default(false)
  remote_user: "{{ user.name }}"
  run_once: true
  delegate_to: localhost
  become: false

- name: Generate public ssh key for {{ user.name }}
  ansible.builtin.command: ssh-keygen -y -f {{ user.ssh_key_file }} > {{ user.ssh_key_file }}.pub
  args:
    creates: "{{ user.ssh_key_file }}.pub"
  when: user.manage_ssh_key|default(false)
  remote_user: "{{ user.name }}"
  run_once: true
  delegate_to: localhost
  become: false

- name: Convert ssh key to ppk for {{ user.name }}
  ansible.builtin.command: puttygen {{ user.ssh_key_file }} -o {{ user.ssh_key_file }}.ppk -ssh
  args:
    creates: "{{ user.ssh_key_file }}.ppk"
  when: user.manage_ssh_key|default(false)
  remote_user: "{{ user.name }}"
  run_once: true
  delegate_to: localhost
  become: false

- name: Get or set the home directory for {{ user.name }}
  ansible.builtin.stat:
    path: "{{ user.home }}"
  register: home_directory
  when: user.state == 'present'
  changed_when: home_directory.stat.exists == false

- name: Create .ssh directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ user.home }}/.ssh"
    state: directory
    mode: '0700'
  when: user.manage_ssh_key|default(false) or user.private_keys is defined
  become: true

- name: Deploy authorized keys for {{ user.name }}
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys }}"
  when: user.authorized_keys is defined
  become: true

- name: Remove unauthorized keys for {{ user.name }}
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys is defined
  become: true

- name: Copy generated private ssh key for {{ user.name }}
  ansible.builtin.copy:
    src: "{{ user.ssh_key_file }}"
    dest: "{{ user.home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.copy_private_key|default(false)

- name: Check users password valid time for {{ user.name }}
  ansible.builtin.command: chage -l {{ user.name }}
  register: password_valid_time
  changed_when: false

- name: Set users password valid time for {{ user.name }}
  ansible.builtin.command: chage -M {{ user.password_validity_days }} {{ user.name }}
  when: user.password_validity_days is defined and password_valid_time.stdout.find("Password expires") == -1

- name: Place private key file for {{ user.name }}
  ansible.builtin.copy:
