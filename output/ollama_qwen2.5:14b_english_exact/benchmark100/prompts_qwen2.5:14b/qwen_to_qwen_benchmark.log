---
- import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  template:
    src: mysql-server.conf.j2
    dest: /etc/mysql/mysql.conf.d/mysql-server.cnf
    owner: root
    group: root
    mode: '0644'
    vars:
      mysql_configuration_options: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  template:
    src: mysql-client.conf.j2
    dest: /etc/mysql/conf.d/mysql-client.cnf
    owner: root
    group: root
    mode: '0644'
    vars:
      mysql_socket: "{{ mysql_socket }}"

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  systemd:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    src: my.cnf
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases | select('search', '^name: ') | map('extract', ['name']) | list }}"
  when: item.import_db is undefined
  loop_control:
    extended: true

- name: List databases
  mysql_db:
    name: "*"
    state: list

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.import_db }}"
  loop: "{{ mysql_databases }}"
  when: item.import_db is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privilege }}"
    state: present
