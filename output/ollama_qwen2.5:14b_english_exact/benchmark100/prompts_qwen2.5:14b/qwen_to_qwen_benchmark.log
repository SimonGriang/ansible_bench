---
- name: Install epel
  yum_repository:
    name: epel
    description: EPEL
    baseurl: https://dl.fedoraproject.org/pub/epel/$releasever/$(arch)/
    enabled: yes
    gpgcheck: yes
    gpgkey: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}
  when: ansible_os_family == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9']
  when: ansible_distribution == 'Amazon' and ansible_lsb.release == '2'

- name: Install epel gpg key
  package:
    name: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}
    state: present
  when: ansible_os_family == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9']
  when: ansible_distribution == 'Amazon' and ansible_lsb.release == '2'

- name: Install epel-release
  package:
    name: epel-release
    state: present
  notify: update_package_cache
  when: ansible_os_family == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9']
  when: ansible_distribution == 'Amazon' and ansible_lsb.release == '2'

- name: Install epel-next-release
  package:
    name: epel-next-release
    state: present
  notify: update_package_cache
  when: epel_next | default(false) and (ansible_os_family == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9'])
  when: epel_next | default(false) and (ansible_distribution == 'Amazon' and ansible_lsb.release == '2')

