---
- name: Enable proxy and proxy_http modules on Debian and Suse systems
  ansible.builtin.a2enmod:
    mod_names: ["proxy", "proxy_http"]
  when: ansible_facts.os_family in ['Debian', 'Suse']

- name: Enable proxy and proxy_http modules on Debian and Suse systems
  ansible.builtin.module:
    name: a2enmod
    args: "--mods-enabled proxy proxy_http"
  when: ansible_facts.os_family in ['Debian', 'Suse']
  register: proxy_modules_enabled
  changed_when: proxy_modules_enabled.changed

- name: Configure locations using a template
  ansible.builtin.template:
    dest: "{{ item.dest }}"
    src: "location.conf.j2"
    mode: "{{ item.mode }}"
  with_items: "{{ httpd_locations }}"
  notify: httpd configuration test and restart

- name: Configure locations using a template
  ansible.builtin.template:
    dest: /etc/apache2/sites-available/location.conf
    src: location.conf.j2
    mode: 0644
  when: ansible_facts.os_family == 'Debian'
  notify: httpd configuration test and restart

- name: Configure locations using a template
  ansible.builtin.template:
    dest: /etc/apache2/conf-available/location.conf
    src: location.conf.j2
    mode: 0644
