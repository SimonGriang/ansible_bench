---
- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_binary_exists

- name: Check Helm version
  command: /usr/local/bin/helm version --short
  when: helm_binary_exists.stat.exists
  register: helm_version
  changed_when: False

- name: Download helm
  get_url:
    url: "https://get.helm.sh/helm-v{{ helm_version.stdout.split(',')[0].split(':')[1].strip()[1:] }}-{{ ansible_system }}-amd64.tar.gz"
    dest: "/tmp/helm.tar.gz"
  when: not helm_binary_exists.stat.exists or helm_version.stdout.split(',')[0].split(':')[1].strip()[1:] < "v3.8.0"

- name: Copy helm binary into place
  copy:
    src: /tmp/helm.tar.gz
    dest: /usr/local/bin/helm
    remote_src: yes
  when: not helm_binary_exists.stat.exists or helm_version.stdout.split(',')[0].split(':')[1].strip()[1:] < "v3.8.0"
  register: helm_copy_result
  notify: make_helm_executable

- name: Extract helm binary from tar.gz
  unarchive:
    src: /tmp/helm.tar.gz
    dest: /usr/local/bin/
    remote_src: yes
  when: not helm_binary_exists.stat.exists or helm_version.stdout.split(',')[0].split(':')[1].strip()[1:] < "v3.8.0"

handlers:
  - name: make_helm_executable
    file:
      path: /usr/local/bin/helm
      mode: '0755'

