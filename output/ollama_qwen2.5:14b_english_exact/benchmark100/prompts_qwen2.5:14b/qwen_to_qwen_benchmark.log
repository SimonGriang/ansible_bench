---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    create_home: no
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    system: yes
    state: present

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    recurse: yes

- name: Download Vault binary
  unarchive:
    src: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    creates: "{{ vault_download_path }}/vault"
  register: vault_binary_downloaded
  when: vault_binary_url is defined

- name: Check if vault_path exists
  file:
    path: "{{ vault_path }}"
    state: directory
    check_mode: no
  register: vault_path_exists

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    recurse: yes
  when: vault_path_exists.stat.exists is not defined and vault_path is defined

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    state: directory
    mode: 0755
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item.path }}"
    state: directory
    mode: 0755
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  block:
    - name: Ensure directory exists
      file:
        path: "{{ vault_data_directory }}/tls/"
        state: directory
        mode: 0755
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        recurse: yes

    - name: Generate TLS key
      command: openssl genrsa -out {{ vault_data_directory }}/tls/{{ vault_tls_key }} 2048
      args:
        creates: "{{ vault_data_directory }}/tls/{{ vault_tls_key }}"
      notify: Restart vault

    - name: Generate TLS certificate
      command: openssl req -x509 -new -nodes -key {{ vault_data_directory }}/tls/{{ vault_tls_key }} -days 1095 -out {{ vault_data_directory }}/tls/{{ vault_tls_cert }} -subj "/C=US/ST=California/L=San Francisco/O=Company Name/CN=Vault"
      args:
        creates: "{{ vault_data_directory }}/tls/{{ vault_tls_cert }}"
      notify: Restart vault
  when: vault_data_directory is defined

- name: Set ownership of tls material
  file:
    path: "{{ item.path }}"
    state: file
    mode: 0644
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: 0755
    owner: root
    group: root
    remote_src: yes
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  file:
    path: "{{ vault_path }}/usr/bin/vault"
    mode: 0755
    capabilitiestate: present
    capabilities:
      - ipc_lock
    selevel: "s0"
    selabel: "system_u:object_r:bin_t:s0"
    setype: "bin_t"
    seuser: "root"
    selevel: "s0"
  when: ansible_kernel == 'Linux'
  no_log: yes

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    mode: 0644
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: 0755

- name: Copy Vault service file
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: 0644
  notify: Daemon reload
  when: ansible_service_mgr == 'systemd'

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: 0644
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers

