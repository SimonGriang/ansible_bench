---
- name: Check if the system is EFI
  command: test -d /sys/firmware/efi/efivars
  register: efi_check
  changed_when: False
  failed_when: False

- name: Remove the grub.cfg file if the system is EFI
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_check.rc == 0

- name: Install a user template for GRUB
  copy:
    src: templates/01_users
    dest: /etc/grub.d/01_users
    mode: 0700
    owner: root
    group: root
  notify: update-grub

- name: Add a password to the EFI GRUB configuration
  lineinfile:
    path: /etc/grub2-efi.cfg
    regexp: '^set superusers="[^"]*"'
    line: 'set superusers="root"\nset superuser_password={{ grub_password }}'
  when: efi_check.rc == 0
  notify: update-grub

- name: Add a password to the MBR GRUB configuration
  lineinfile:
    path: /etc/grub2.cfg
    regexp: '^set superusers="[^"]*"'
    line: 'set superusers="root"\nset superuser_password={{ grub_password }}'
  notify: update-grub

- name: Add --unrestricted option to specified files
  replace:
    path: "{{ item }}"
    regexp: 'CLASS="([^"]*)"'
    replace: 'CLASS="\1 --unrestricted"'
  with_items: "{{ grub_password_unrestricted_files }}"
  notify: update-grub
  when: grub_password_unrestricted == True

