---
- name: Create document root directories for each virtual host
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  when: item.create_docroot is not defined or item.create_docroot is true
  with_items: "{{ httpd_vhosts }}"
  key_order: [name, with_items]

- name: Configure virtual hosts using a template
  block:
    - name: Ensure virtual host configuration file exists
      ansible.builtin.template:
        src: "{{ vhost_conf_template }}"
        dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
      notify: restart httpd
    - name: Test httpd configuration
      ansible.builtin.command: httpd -t
      when: ansible_os_family == 'RedHat'
      changed_when: false
      notify: restart httpd
    - name: Test apache2 configuration
      ansible.builtin.command: apache2ctl configtest
      when: ansible_os_family == 'Debian'
      changed_when: false
      notify: restart httpd
  with_items: "{{ httpd_vhosts }}"
  key_order: [name, block]

- name: Restart httpd service
  ansible.builtin.service:
    name: httpd
    state: restarted
  when: ansible_os_family == 'RedHat'
  listen: restart httpd

- name: Restart apache2 service
  ansible.builtin.service:
    name: apache2
    state: restarted
  when: ansible_os_family == 'Debian'
  listen: restart httpd

