---
- import_tasks: assert.yml

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  when: java_vendor == 'openjdk'
  package:
    name: "{{ java_version }}-openjdk"
    state: present

- name: Install RPM
  when: java_package == 'rpm'
  package:
    name: "{{ lookup('env', 'PWD') }}/{{ java_version }}-linux-x64.rpm"
    state: present
    force: true

- name: Install DEB
  when: java_package == 'deb'
  package:
    name: "{{ lookup('env', 'PWD') }}/{{ java_version }}-linux-x64.deb"
    state: present
    force: true

- name: Install oracle java (rpm) (repository)
  when: java_package == 'rpm' and java_repository is defined
  yum:
    name: "{{ java_repository }}"
    state: present

- name: Configure oracle targz
  when: java_package == 'targz'
  block:
    - name: Ensure installation directory exists
      file:
        path: /opt/java
        state: directory
        owner: root
        group: root

    - name: Install Oracle Java TARGZ package
      unarchive:
        src: "{{ lookup('env', 'PWD') }}/{{ java_version }}-linux-x64.tar.gz"
        dest: /opt/java
        remote_src: true

- name: Install oracle java policy software (targz)
  when: java_package == 'targz' and java_version == 'jdk1.8.0_{{ java_update }}'
  block:
    - name: Ensure policy directory exists
      file:
        path: /usr/java/jdk1.8.0_{{ java_update }}_amd64/jre/lib/security
        state: directory
        owner: root
        group: root

    - name: Copy java policy files
      copy:
        src: "{{ lookup('env', 'PWD') }}/jce_policy-8.zip"
        dest: /usr/java/jdk1.8.0_{{ java_update }}_amd64/jre/lib/security/jce_policy-8.zip
        owner: root
        group: root

- name: Set alternative (targz)
  when: java_package == 'targz' and ansible_facts['ansible_distribution'] != 'Alpine'
  alternatives:
    name: java
    path: /usr/java/jdk1.8.0_{{ java_update }}_amd64/bin/java
    link: /etc/alternatives/java
    priority: 100

- name: Find JAVA_HOME
  shell: readlink -f /usr/bin/java | sed "s:/jre/bin/java$::"
  register: java_home

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    line: "JAVA_HOME={{ java_home.stdout }}"
    create: true


