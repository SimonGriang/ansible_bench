  when: rsyslog_deploy_default_config is false

- name: Configuring additional config files
  copy:
    src: "{{ item.src }}"
    dest: /etc/rsyslog.d/{{ item.dest }}
    mode: '0644'
    owner: root
    group: root
  loop: "{{ additional_configs }}"

- name: Start and enable rsyslog
  systemd:
    name: rsyslog
    state: started
    enabled: yes

