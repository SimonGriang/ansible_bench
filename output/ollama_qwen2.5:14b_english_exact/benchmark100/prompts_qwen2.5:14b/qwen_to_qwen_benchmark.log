---
- name: create | Create ssl key
  openssl_privatekey:
    path: "{{ item.path }}/{{ item.name }}.key"
    size: 2048
    mode: '0600'
    owner: root
    group: root
  with_items: "{{ inventory_hostname_ssl_files }}"
  tags:
    - ssl
    - key

- name: create | Create ssl csr
  openssl_csr:
    path: "{{ item.path }}/{{ item.name }}.csr"
    privatekey_path: "{{ item.path }}/{{ item.name }}.key"
    common_name: "{{ item.name }}"
    mode: '0600'
    owner: root
    group: root
  with_items: "{{ inventory_hostname_ssl_files }}"
  tags:
    - ssl
    - csr

- name: create | Create ssl certificates
  openssl_certificate:
    path: "{{ item.path }}/{{ item.name }}.crt"
    privatekey_path: "{{ item.path }}/{{ item.name }}.key"
    csr_path: "{{ item.path }}/{{ item.name }}.csr"
    provider: selfsigned
    mode: '0600'
    owner: root
    group: root
  with_items: "{{ inventory_hostname_ssl_files }}"
  tags:
    - ssl
    - certificate

- name: create | Create PKCS#12 file
  command: "openssl pkcs12 -export -in {{ item.path }}/{{ item.name }}.crt -inkey {{ item.path }}/{{ item.name }}.key -out {{ item.path }}/{{ item.name }}.p12 -name {{ item.name }} -CAfile /etc/ssl/certs/ca-certificates.crt -caname root -passout pass:{{ item.password }}"
  register: pkcs12_creation
  with_items: "{{ inventory_hostname_ssl_files }}"
  become: yes
  become_user: root
  tags:
    - ssl
    - pkcs12

- name: create | Read private key
  command: "openssl rsa -in {{ item.path }}/{{ item.name }}.key -outform der | base64 -w 0"
  register: private_key_contents
  with_items: "{{ inventory_hostname_ssl_files }}"
  tags:
    - ssl
    - private_key

- name: create | Read certificate
  command: "openssl x509 -in {{ item.path }}/{{ item.name }}.crt -outform der | base64 -w 0"
  register: certificate_contents
  with_items: "{{ inventory_hostname_ssl_files }}"
  tags:
    - ssl
    - certificate

- name: create | Create combined private_key and certificate file
  copy:
    content: "{{ private_key_contents.stdout }}\n{{ certificate_contents.stdout }}"
    dest: "{{ item.path }}/{{ item.name }}.combined.pem"
    mode: '0600'
    owner: root
    group: root
  with_items: "{{ inventory_hostname_ssl_files }}"
  tags:
    - ssl
    - combined

