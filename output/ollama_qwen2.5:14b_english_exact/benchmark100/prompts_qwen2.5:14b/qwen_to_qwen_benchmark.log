---
- import_tasks: assert.yml
  name: Import the assert.yml file to perform pre-execution checks.

- name: Install the cron package as specified by the variable cron_packages.
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Set the shell environment variable in the cron configuration file.
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "SHELL={{ shell }}"
    mode: '0644'
    create: yes
  notify: restart cron

- name: Set the path environment variable in the cron configuration file.
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "PATH={{ path }}"
    mode: '0644'
    create: yes
  notify: restart cron

- name: Set the mailto environment variable in the cron configuration file.
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "MAILTO={{ mailto }}"
    mode: '0644'
    create: yes
  notify: restart cron

- name: Start the cron service and ensure it is enabled on boot.
  service:
    name: "{{ cron_service }}"
    enabled: yes
    state: started
  when: cron_service is defined and cron_service != ''

- name: Schedule cron jobs as defined in the cron_jobs variable.
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    special_time: "{{ item.special_time }}"
    state: "{{ item.state }}"
  with_items: "{{ cron_jobs }}"
  when: cron_jobs is defined and cron_jobs|length > 0

- name: Define the restart cron handler.
  service:
    name: cron
    state: restarted
  listen: restart cron

