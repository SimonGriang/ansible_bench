---
- import_tasks: assert.yml
  args:
    remote_src: true
  run_once: true

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  when: ansible_facts['ansible_os_family'] == 'RedHat' and ansible_facts['ansible_selinux']['status'] == 'enabled'
  set_fact:
    selinux_booleans: >
      {'httpd_can_network_connect': true,
       'httpd_can_network_connect_db': true,
       'httpd_unified': true}

- name: Configure selinux
  when: ansible_facts['ansible_os_family'] == 'RedHat' and ansible_facts['ansible_selinux']['status'] == 'enabled'
  selinux_boolean:
    name: "{{ item.0 }}"
    state: "{{ item.1 }}"
  loop: "{{ selinux_booleans | dict2items }}"

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    owner: root
    group: root
    mode: '0644'
  notify: test_config
  notify: restart_service

- name: Activate httpd module | Debian
  when: ansible_facts['ansible_os_family'] == 'Debian'
  shell: a2enmod "{{ item }}"
  loop: "{{ httpd_modules }}"
  notify: test_config

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  when: ansible_facts['ansible_os_family'] in ['Debian', 'Suse']
  template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
    owner: root
    group: root
    mode: '0644'
  notify: test_config
  notify: restart_service

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    enabled: true
    state: started

