---
- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  when: inventory_hostname == rke2_node_name

- name: Wait for all nodes to be ready again
  command: kubectl get nodes --no-headers | awk '!/NotReady/ {print $1}'
  register: nodes_ready
  delegate_to: "{{ active_server | default((groups[rke2_servers_group_name] | list)[0]) }}"
  retries: 100
  delay: 15
  until: nodes_ready.stdout.strip() | length > 0
  check_mode: true
  changed_when: false

- name: Wait for all pods to be ready again
  command: kubectl get pods --all-namespaces --field-selector=status.phase!=Failed,status.phase!=Unknown --no-headers | awk '!/0/ {print $1}'
  register: pods_ready
  delegate_to: "{{ active_server | default((groups[rke2_servers_group_name] | list)[0]) }}"
  retries: 100
  delay: 15
  until: pods_ready.stdout.strip() | length > 0
  when: rke2_wait_for_all_pods_to_be_ready | default(false)
  check_mode: true
  changed_when: false

