---
- name: lookup bootstrap facts (raw)
  ansible.builtin.slurp:
    path: /etc/os-release
  register: os_release_raw

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ os_release_raw.content | b64decode | regex_search('NAME="?([^"]+)"?', '\\1') }}"
    bootstrap_major_version: "{{ os_release_raw.content | b64decode | regex_search('VERSION_ID="?([^"]+)"?', '\\1') | int | version_compare('"="', '0', '"<"', '10') | regex_replace('^\\d+\\\\.(\\d+).*$', '\\1') }}"

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ lookup('dict', bootstrap__os_family_map)['{{ bootstrap_distribution }}'] if bootstrap_distribution in lookup('dict', bootstrap__os_family_map) else 'unknown' }}"

