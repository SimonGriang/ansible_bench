---
- name: Ensure document root directories are created for each virtual host
  file:
    path: "{{ item.document_root }}"
    state: directory
    mode: '0755'
    owner: 'root'
    group: 'root'
  loop: "{{ httpd_vhosts }}"
  when: item.create_docroot is not defined or item.create_docroot is defined and item.create_docroot is true

- name: Create virtual host configuration files
  template:
    src: vhost_conf_template
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify: test_apache_configuration
  notify: restart_apache_server

- name: Enable virtual hosts on Debian-based systems
  command: a2ensite "{{ item.name }}"
  args:
    creates: /etc/apache2/sites-enabled/{{ item.name }}.conf
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian'
  notify: test_apache_configuration
  notify: restart_apache_server

