---
- name: hardening | Disable swap
  when: vault_hardening_disable_swap|default(false)
  block:
    - name: hardening | Disable swap now
      command: swapoff -a
      when: ansible_swaps|length > 0

    - name: hardening | Disable swap permanently
      block:
        - name: Unmount swap partition
          command: swapoff /dev/{{ item }}
          loop: "{{ ansible_swaps }}"
          when: ansible_swaps|length > 0

        - name: Comment out swap in /etc/fstab
          lineinfile:
            path: /etc/fstab
            state: present
            regexp: "^{{ item }} swap "
            line: "#{{ item }} swap "
          loop: "{{ ansible_swaps }}"
          when: ansible_swaps|length > 0

- name: hardening | Disable core dumps
  when: vault_hardening_disable_core_dumps|default(false)
  block:
    - name: Set core dump limits to 0
      lineinfile:
        path: /etc/security/limits.conf
        state: present
        regexp: "^\* +hard +core +0"
        line: "*\thard\tcore\t0"
      notify: reload sysctl

- name: hardening | Disable Shell Command History
  when: vault_hardening_disable_shell_command_history|default(false)
  block:
    - name: Create /etc/profile.d/disable_history.sh
      template:
        src: disable_history.sh.j2
        dest: /etc/profile.d/disable_history.sh
        mode: '0755'

- name: hardening | Configure SELinux / AppArmor
  when: vault_hardening_configure_selinux_apparmor|default(false)
  block:
    - name: hardening | Enable SELinux
      block:
        - name: hardening | Install selinux-policy
          package:
            name: selinux-policy
            state: present

        - name: hardening | Set SELinux policy
          lineinfile:
            path: /etc/selinux/config
            state: present
            regexp: "^SELINUX="
            line: "SELINUX=enforcing"
          notify: reboot

    - name: hardening | Enable AppArmor (enforcing)
      block:
        - name: Enable AppArmor enforcement for vault
          command: aa-enforce /usr/bin/vault
          when: ansible_facts.bin_vault.exists|default(false)

