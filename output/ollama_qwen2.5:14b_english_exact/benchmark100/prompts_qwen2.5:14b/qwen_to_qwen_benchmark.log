---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_dir }}"
    mode: '0700'
    timeout: 30

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_local_install_script }}"
    dest: "{{ rke2_install_dir }}"
    mode: '0700'
    owner: root
    group: root
    force: yes
  when: rke2_airgap_mode is defined and rke2_airgap_implementation is defined

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0700'
    owner: root
    group: root
  when: rke2_airgap_mode is defined and rke2_airgap_implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_artifacts_path }}/rke2.sha256"
        mode: '0700'
    - name: Download RKE2 artifacts
      get_url:
        url: "{{ item.url }}"
        dest: "{{ rke2_artifacts_path }}/{{ item.filename }}"
        mode: '0700'
      loop: "{{ rke2_artifacts }}"
    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_artifacts_path }}/rke2-install"
        mode: '0700'
  when: rke2_airgap_mode is defined and rke2_airgap_implementation == 'download'

- name: Rescue for failed download
  block:
    - name: Create directory for local download
      file:
        path: "{{ rke2_local_artifacts_path }}"
        state: directory
        mode: '0700'
    - name: Download RKE2 artifacts locally
      get_url:
        url: "{{ item.url }}"
        dest: "{{ rke2_local_artifacts_path }}/{{ item.filename }}"
        mode: '0700'
      loop: "{{ rke2_artifacts }}"
    - name: Download RKE2 install script locally
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_local_artifacts_path }}/rke2-install"
        mode: '0700'
    - name: Copy local RKE2 artifacts to remote hosts
      copy:
        src: "{{ rke2_local_artifacts_path }}/{{ item.filename }}"
        dest: "{{ rke2_artifacts_path }}/{{ item.filename }}"
        mode: '0640'
        owner: root
        group: root
        force: yes
      loop: "{{ rke2_artifacts }}"
  rescue: true
  when: rke2_airgap_mode is defined and rke2_airgap_implementation == 'download'

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ item.src }}"
    dest: "{{ rke2_artifacts_path }}/{{ item.dest }}"
    mode: '0640'
    owner: root
    group: root
    force: yes
  loop: "{{ rke2_artifacts }}"
  when: rke2_airgap_mode is defined and rke2_airgap_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Create folder for additional images tarballs
      file:
        path: "{{ rke2_images_path }}"
        state: directory
        mode: '0700'
    - name: Copy additional images tarballs to RKE2 tarball images path
      copy:
        src: "{{ rke2_images_src }}"
        dest: "{{ rke2_images_path }}/{{ item.dest }}"
        mode: '0640'
        owner: root
        group: root
        force: yes
      loop: "{{ rke2_images }}"
  when: rke2_airgap_mode is defined and rke2_airgap_copy_additional_tarballs|length > 0 and rke2_airgap_implementation != 'exists'

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure artifacts exist
      file:
        path: "{{ rke2_artifacts_path }}"
        state: directory
        mode: '0700'
        owner: root
        group: root
    - name: Ensure RKE2 install script exists
      file:
        path: "{{ rke2_install_dir }}"
        state: file
        mode: '0700'
        owner: root
        group: root
    - name: Check and modify permissions if too permissive
      stat:
        path: "{{ rke2_artifacts_path }}"
      register: artifact_stat
      changed_when: false
      when: not artifact_stat.stat.mode|int == 448
  when: rke2_airgap_mode is defined and rke2_airgap_implementation == 'exists'

- name: Populate service facts
  ansible.builtin.service_facts: {}

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local

- name: Check if separate partition
  ansible.builtin.shell: "grep -e '^/usr/local ' /proc/mounts"
  register: is_mounted
  changed_when: false

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: "{{ rke2_install_dir }}/rke2-install"
  when: is_mounted.stdout_lines

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }} --version"
  register: rke2_version

- name: Set RKE2 versions
  ansible.builtin.set_fact:
    rke2_installed_version: "{{ rke2_version.stdout.split(' ')[1] }}"
    rke2_running_version: "{{ lookup('pipe', rke2_bin_path + ' version') }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.fail:
    msg: "Cannot downgrade RKE2 as {{ rke2_installed_version }} is installed and {{ rke2_running_version }} is running"
  when: rke2_installed_version != rke2_running_version and not rke2_allow_downgrade

- name: Run RKE2 install script
  shell: "{{ rke2_bin_path }} install server --kubeconfig /etc/rancher/rke2/rke2.yaml --write-kubeconfig-mode 0644 --token {{ rke2_token }} --tls-san {{ rke2_tls_san }}"
  when: rke2_installed_version != rke2_running_version and not ansible_check_mode
  environment:
    RKE2_AIRGAP: "{{ rke2_airgap_mode }}"
    RKE2_AIRGAP_IMPLEMENTATION: "{{ rke2_airgap_implementation }}"
    RKE2_AIRGAP_COPY_ADDITIONAL_TARBALLS: "{{ rke2_airgap_copy_additional_tarballs|join(',') }}"

- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_custom_manifests_path }}/{{ item }}"
    dest: "{{ rke2_data_path }}/{{ item }}"
    mode: '0644'
    owner: root
    group: root
    force: yes
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests|length > 0

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_path }}/{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}/{{ item }}"
    mode: '0644'
    owner: root
    group: root
    force: yes
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods|length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: "{{ rke2_data_path }}/rke2.env"
    mode: '0644'
    owner: root
    group: root
    force: yes
  when: rke2_env_vars|length > 0

