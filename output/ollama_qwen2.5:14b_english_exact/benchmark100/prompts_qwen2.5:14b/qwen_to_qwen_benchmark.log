---
- import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/my.cnf
    regexp: '^{{ item.key }}'
    line: "{{ item.key }} = {{ item.value }}"
  with_dict: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/conf.d/client.cnf
    regexp: '^socket'
    line: 'socket = /var/run/mysqld/mysqld.sock'

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  systemd:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    dest: /etc/mysql/conf.d/my.cnf
    mode: 0644
    content: |
      [mysqld]
      max_connections = 200
      key_buffer_size = 16M

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases | select('search', '^dbname_') | map('extract', hash_keys(mysql_databases)) | list }}"
  loop_control:
    extended: true

- name: List databases
  command: mysql -e 'show databases;'
  register: databases_list
  changed_when: false

- name: Import database
  command: mysql {{ item.name }} < {{ item.import_file }}
  loop: "{{ mysql_databases | selectattr('import', 'defined') | list }}"
  when: "'{{ item.name }}' not in databases_list.stdout.splitlines()"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privilege }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers
  meta: flush_handlers

- name: Flush handlers again
  meta: flush_handlers


