---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/local/lib/python3.11/EXTERNALLY-MANAGED
  register: python3_11_file_exists

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  when: python3_11_file_exists.stat.exists
  file:
    path: /usr/local/lib/python3.11/EXTERNALLY-MANAGED
    dest: /usr/local/lib/python3.11/EXTERNALLY-MANAGED.old
    state: link

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/local/lib/python3.12/EXTERNALLY-MANAGED
  register: python3_12_file_exists

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  when: python3_12_file_exists.stat.exists
  file:
    path: /usr/local/lib/python3.12/EXTERNALLY-MANAGED
    dest: /usr/local/lib/python3.12/EXTERNALLY-MANAGED.old
    state: link

- name: Import assert.yml
  import_tasks: assert.yml
  remote_src: yes
  vars:
    ansible_host: localhost

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  when: python_pip_proxy is defined
  copy:
    dest: /etc/pip.conf
    content: |
      [global]
      proxy = {{ python_pip_proxy }}

- name: Trust hosts
  when: python_pip_trusted_host is defined
  lineinfile:
    path: /etc/pip.conf
    regexp: '^trusted-host = '
    line: 'trusted-host = {{ python_pip_trusted_host }}'

- name: Update pip
  when: python_pip_update and ansible_distribution != 'bookworm' and ansible_distribution != 'noble' and ansible_os_family != 'Alpine'
  command: pip install --upgrade pip
  args:
    creates: /usr/local/bin/pip

- name: Install requested modules
  when: ansible_distribution != 'bookworm' and ansible_distribution != 'noble' and ansible_os_family != 'Alpine'
  pip:
    name: "{{ item }}"
    requirements_file: "{{ python_pip_modules }}"
  with_items: "{{ python_pip_modules }}"

