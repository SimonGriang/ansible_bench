---
- name: Remove externally managed from Debian 12
  file:
    path: /etc/exm_conf_file
    state: absent
  when: ansible_facts['os_family'] == 'Debian' and ansible_distribution_major_version == '12'

- name: Ensure Pip is installed
  ansible.builtin.package:
    name: python3-pip
    state: present
  when: ansible_facts['os_family'] == 'Debian' and ansible_distribution_major_version == '12'

- name: Ensure packaging is available via dnf
  ansible.builtin.package:
    name: python3-packaging
    state: present
  when: ansible_facts['os_family'] == 'RedHat' and ansible_distribution_major_version == '8'

- name: Ensure pip_install_packages are installed
  ansible.builtin.pip:
    name: "{{ item.package }}"
    version: "{{ item.version | default('') }}"
    virtualenv: "{{ item.virtualenv | default('') }}"
    extra_args: "{{ item.extra_args | default('') }}"
  loop: "{{ pip_install_packages }}"
  when: ansible_facts['os_family'] == 'Debian' and ansible_distribution_major_version == '12'

