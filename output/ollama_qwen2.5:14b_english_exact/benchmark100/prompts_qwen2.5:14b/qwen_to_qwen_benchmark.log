---
- name: Check if python is installed
  command: which python
  register: python_check
  changed_when: False
  failed_when: False

- name: Check if python3 is installed
  command: which python3
  register: python3_check
  changed_when: False
  failed_when: False

- name: Debug Python executable path
  debug:
    msg: "Python executable found at {{ python_check.stdout }}"

- name: Debug Python3 executable path
  debug:
    msg: "Python3 executable found at {{ python3_check.stdout }}"

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install requirements
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_requirements }}"

- name: Ensure packaging is available via dnf
  package:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_pip_packages }}"

- name: Create key directory
  file:
    path: "{{ item.key_dir }}"
    state: directory
    mode: 'u+rwx,o+rx,u-w'
    owner: "{{ item.key_dir_owner }}"
    group: "{{ item.key_dir_group }}"
  loop: "{{ openssl_items }}"

- name: Create csr directory
  file:
    path: "{{ item.csr_dir }}"
    state: directory
    mode: 'u+rwx,o+rx,u-w'
    owner: "{{ item.csr_dir_owner }}"
    group: "{{ item.csr_dir_group }}"
  loop: "{{ openssl_items }}"

- name: Create crt directory
  file:
    path: "{{ item.crt_dir }}"
    state: directory
    mode: 'u+rwx,o+rx,u-w'
    owner: "{{ item.crt_dir_owner }}"
    group: "{{ item.crt_dir_group }}"
  loop: "{{ openssl_items }}"

- name: Include create.yml
  include_tasks: create.yml
  loop: "{{ openssl_items }}"

