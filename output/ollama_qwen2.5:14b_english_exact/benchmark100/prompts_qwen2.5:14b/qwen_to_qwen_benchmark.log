---
- ansible.builtin.import_tasks: assert.yml

- name: Install mysql
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_packages }}"
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ansible.builtin.lineinfile:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    line: "{{ item.option }} = {{ item.value }}"
  loop: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  ansible.builtin.lineinfile:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    line: "socket = {{ mysql_socket_location }}"

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_facts["os_family"] in ['Alpine', 'Arch']
  changed_when: false

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: '0600'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
  loop: "{{ mysql_databases }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.user }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


