---
- name: Import preflight tasks for promtail installation
  ansible.builtin.import_tasks: preflight.yml
  tags:
    - promtail_install
    - promtail

- name: Import installation tasks for promtail
  ansible.builtin.import_tasks: install.yml
  become: true
  tags:
    - promtail_install
    - promtail

- name: Ensure promtail service is started and enabled
  ansible.builtin.systemd:
    name: "{{ promtail_systemd_service }}"
    state: started
    enabled: true
  become: true
  notify: reload_systemd
  tags:
    - promtail_run
    - promtail

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Reload systemd
  ansible.builtin.systemd:
    daemon_reload: true
  tags:
    - promtail_run
    - promtail


