---
- name: Enable Apache2 modules
  when: ansible_os_family in ['Debian', 'Suse']
  package:
    name:
      - libapache2-mod-proxy
      - libapache2-mod-proxy-http
    state: present
  notify: validate_httpd_config

- name: Configure Apache2 locations
  template:
    src: location.conf.j2
    dest: /etc/apache2/sites-available/{{ item.name }}.conf
    owner: root
    group: root
    mode: 0644
  with_items: "{{ httpd_locations }}"
  notify: validate_httpd_config
  notify: restart_httpd

- name: Include additional tasks for other OS
  import_tasks: os_specific_tasks.yml
  when: ansible_os_family not in ['Debian', 'Suse']

 _handlers:
    - name: validate_httpd_config
      service:
        name: apache2
        state: reloaded

    - name: restart_httpd
      service:
        name: apache2
        state: restarted

