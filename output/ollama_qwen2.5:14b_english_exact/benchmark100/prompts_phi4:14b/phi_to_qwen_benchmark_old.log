---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Task 2: Install necessary prerequisites for Vault
  package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Task 3: Include tasks specific to the installation method
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Task 4: Add environment variables for Vault
  lineinfile:
    path: /etc/vault.d/vault.env
    create: yes
    line: "{{ item }}"
    mode: '0640'
    owner: root
    group: root
  with_items: "{{ vault_environment_variables }}"
  notify: restart_vault

- name: Task 5: Include additional hardening tasks
  include_tasks: hardening.yml

- name: Task 6: Start and enable Vault service for Open Source Software (OSS)
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Task 7: Enable Vault service for non-OSS versions
  service:
    name: vault
    enabled: yes
  when: vault_type != "oss"

