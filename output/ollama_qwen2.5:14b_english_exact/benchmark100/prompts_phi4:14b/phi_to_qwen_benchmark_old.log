---
- name: Import assert.yml and run on localhost
  import_tasks: assert.yml
  remote_addr: localhost

- name: Install required software packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements | default([]) }}"
  when: users_requirements | length > 0

- name: Include tasks for each group
  include_tasks: group.yml
  loop: "{{ users_groups | default([]) }}"
  loop_control:
    loop_var: group
  name: "Process group {{ group }}"

- name: Ensure /etc/sudoers includes /etc/sudoers.d
  lineinfile:
    path: /etc/sudoers
    line: "#includedir /etc/sudoers.d"
    regexp: "^#includedir /etc/sudoers.d$"
    validate: 'visudo -cf %s'

- name: Include tasks for each user
  include_tasks: user.yml
  loop: "{{ users | default([]) }}"
  loop_control:
    loop_var: user
  name: "Process user {{ user }}"

- name: Manage /etc/cron.allow permissions
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow | default(false)

- name: Remove /etc/cron.allow if cron permissions are not required
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow | default(false)


