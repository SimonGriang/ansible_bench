52645Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8155416935, 'load_duration': 104617280, 'prompt_eval_count': 1428, 'prompt_eval_duration': 77302742, 'eval_count': 483, 'eval_duration': 7966039666, 'model_name': 'qwen2.5:14b'} id='run--2c2c793b-2761-42f8-a6da-45ff84fbe4f6-0' usage_metadata={'input_tokens': 1428, 'output_tokens': 483, 'total_tokens': 1911}
