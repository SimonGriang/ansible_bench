  when: "'rke2-server' in service_facts.services and service_facts.services['rke2-server'].state == 'running' and 'rke2_server' in group_names"
  delegate_to: "{{ inventory_hostname }}"
  delegate_facts: true
  no_log: false
  register: determination_result

