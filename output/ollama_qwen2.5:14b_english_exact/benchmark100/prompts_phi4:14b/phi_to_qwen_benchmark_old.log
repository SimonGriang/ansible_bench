---
- name: Check for the existence of the EXTERNALLY-MANAGED file for Python 3.11
  ansible.builtin.file:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
    state: file
  register: python_3_11_externally_managed_exists

- name: Rename the EXTERNALLY-MANAGED file for Python 3.11 if it exists
  ansible.builtin.file:
    src: /usr/lib/python3.11/EXTERNALLY-MANAGED
    dest: /usr/lib/python3.11/EXTERNALLY-MANAGED.old
    state: link
  when: python_3_11_externally_managed_exists.stat is defined and python_3_11_externally_managed_exists.stat.exists

- name: Check for the existence of the EXTERNALLY-MANAGED file for Python 3.12
  ansible.builtin.file:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
    state: file
  register: python_3_12_externally_managed_exists

- name: Rename the EXTERNALLY-MANAGED file for Python 3.12 if it exists
  ansible.builtin.file:
    src: /usr/lib/python3.12/EXTERNALLY-MANAGED
    dest: /usr/lib/python3.12/EXTERNALLY-MANAGED.old
    state: link
  when: python_0_3_12_externally_managed_exists.stat is defined and python_0_3_12_externally_managed_exists.stat.exists

- name: Import tasks from assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Python pip
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_packages }}"

- name: Configure pip proxy settings
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "index-url = {{ python_pip_proxy }}"
    create: true
  when: python_pip_proxy is defined

- name: Configure trusted hosts for pip
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    create: true
  when: python_pip_trusted_host is defined

- name: Update pip to the latest version
  ansible.builtin.pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
    extra_args: "--upgrade"
  when: python_pip_update is true and ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

- name: Install requested Python modules
  ansible.builtin.pip:
    name: "{{ item.module }}"
    state: "{{ item.state }}"
    version: "{{ item.version }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  when: ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

