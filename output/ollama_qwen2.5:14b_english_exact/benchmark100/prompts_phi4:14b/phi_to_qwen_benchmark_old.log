e2_kubevip_enabled|default(false) and not rke2_keepalived_enabled|default(false)\n  block:\n    - name: Copy kube-vip manifests to master\n      copy:\n        src: "{{ item }}"\n        dest: /etc/rke2/kube-vip-{{ item.split(\'/\')[-1] }}\n      loop: "{{ rke2_kubevip_manifests }}"\n\n- name: Copy ingress-nginx manifests to the masternode\n  when: ingress_nginx_values is defined and ingress_nginx_values|length > 0\n  block:\n    - name: Copy ingress-nginx manifests to master\n      copy:\n        src: "{{ item }}"\n        dest: /etc/rke2/ingress-nginx-{{ item.split(\'/\')[-1] }}\n      loop: "{{ ingress_nginx_values }}"\n\n- name: Prepare very first server node in the cluster\n  when: active_server is not defined or (active_server is defined and (active_server == inventory_hostname or active_server == first_server_node))\n  block:\n    - name: Prepare first server node\n      command: /usr/local/bin/rke2 prepare --server --etcd --kube-context rke2@rke2 --kubeconfig /etc/rke2/kubeconfig\n\n- name: Restore etcd specific tasks\n  when: active_server is defined and (active_server == inventory_hostname or active_server == first_server_node) and rke2_etcd_restore_enabled|default(false)\n  block:\n    - name: Restore etcd\n      command: /usr/local/bin/rke2 restore etcd --kubeconfig /etc/rke2/kubeconfig\n\n- name: Download kubeconfig to ansible localhost\n  when: rke2_download_kubeconfig_enabled|default(false) and (active_server is defined and active_server == inventory_hostname)\n  block:\n    - name: Download kubeconfig\n      get_url:\n        url: "http://{{ rke2_api_ip }}/v1/kubeconfig"\n        dest: /home/{{ ansible_user }}/kubeconfig\n\n- name: Prepare and join remaining nodes of the cluster\n  when: active_server is defined and rke2_server_count|int > 1\n  block:\n    - name: Prepare and join remaining nodes\n      command: /usr/local/bin/rke2 prepare --join --server --kube-context rke2@rke2 --kubeconfig /etc/rke2/kubeconfig\n\n- name: Rolling cordon and drain r