---
- name: Determine if the system is EFI
  command: test -d /sys/firmware/efi
  register: is_efi
  changed_when: false

- name: Remove unwanted grub.cfg for EFI systems
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: is_efi.is_changed

- name: Install a user template for Grub
  template:
    src: grub.cfg.j2
    dest: /boot/grub2/grub.cfg
    owner: root
    group: root
    mode: '0644'
  notify: update-grub

- name: Add a password to the EFI Grub configuration
  lineinfile:
    path: /etc/grub2-efi.cfg
    regexp: '^set superusers="root"$'
    line: 'set superusers="root"\nif [ -s /boot/grub2/user.cfg ]; then\n  export GRUB2_PASSWORD_COMMAND="true"\n  set superusers="root"\n  set superuser_password_file=/boot/grub2/user.cfg\nfi'
  when: is_efi.is_changed
  notify: update-grub

- name: Add a password to the MBR Grub configuration
  lineinfile:
    path: /etc/grub2.cfg
    regexp: '^set superusers="root"$'
    line: 'set superusers="root"\nif [ -s /boot/grub2/user.cfg ]; then\n  export GRUB2_PASSWORD_COMMAND="true"\n  set superusers="root"\n  set superuser_password_file=/boot/grub2/user.cfg\nfi'
  when: not is_efi.is_changed
  notify: update-grub

- name: Modify files to add --unrestricted class
  lineinfile:
    path: "{{ item }}"
    regexp: '^(CLASS=)(.*)$'
    line: '\1\2 --unrestricted'
  with_items:
    - /etc/grub.d/10_linux
    - /etc/grub.d/30_os-prober
  notify: update-grub

