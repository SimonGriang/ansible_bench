content='---\n- import_tasks: assert.yml\n  delegate_to: localhost\n\n- name: Install the required SELinux packages\n  package:\n    name: "{{ selinux_requirements }}"\n    state: present\n  notify: Gather facts\n\n- name: Flush the handlers\n  ansible.builtin.meta:\n    flush_handlers: yes\n\n- name: Configure SELinux settings\n  ansible.posix.selinux:\n    persistent: yes\n    state: "{{ selinux_state }}"\n    policy: "{{ selinux_policy }}"\n  when:\n    - ansible_selinux.status is defined\n    - ansible_connection != \'docker\'\n    - ansible_connection != \'lxc\'\n  notify: Reboot\n\n- name: Manage SELinux booleans\n  ansible.posix.seboolean:\n    name: "{{ item.0 }}"\n    state: "{{ item.1.state }}"\n    persistent: "{{ item.1.pers }}"\n  loop: "{{ selinux_booleans|dict2items }}"\n  when: selinux_booleans is defined\n  loop_control:\n    label: "{{ item.0 }}"' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-14T07:06:48.497761408Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3453854948, 'load_duration': 97200084, 'prompt_eval_count': 589, 'prompt_eval_duration': 248764129, 'eval_count': 215, 'eval_duration': 3095567517, 'model_name': 'qwen2.5:14b'} id='run--f49e1001-4afa-4c98-9684-88ebb8b87965-0' usage_metadata={'input_tokens': 589, 'output_tokens': 215, 'total_tokens': 804}
