---
- import_tasks: assert.yml
 delegate_to: localhost

- name: Configure apk package manager
  block:
    - name: Update package cache
      apk:
        update_cache: yes
        options:
          - --available
      changed_when: false
    - name: Upgrade all software
      apk:
        upgrade: yes
        options:
          - --available
      notify: Reboot system
  when: ansible_pkg_mgr == 'apk'

- name: Configure apt package manager
  block:
    - name: Hold selected packages from upgrading
      apt:
        name: "{{ item }}"
        state: hold
      loop: "{{ apt_hold_packages }}"
      when: apt_hold_packages is defined and apt_hold_packages | length > 0
    - name: Update and upgrade all software
      apt:
        upgrade: dist
        options:
          - '--option=Dpkg::Options::=--force-confdef'
          - '--option=Dpkg::Options::=--force-confold'
      notify: Reboot system
    - name: Autoremove packages if specified
      apt:
        autoremove: yes
      when: apt_autoremove
      notify: Reboot system
  when: ansible_pkg_mgr == 'apt'

- name: Update all software using dnf package manager
  block:
    - name: Update all software
      dnf:
        name: '*'
        state: latest
        exclude: "{{ dnf_exclude | default([]) | join(',') }}"
      notify: Reboot system
  when: ansible_pkg_mgr in ['dnf', 'dnf5']

- name: Update all software using pacman package manager
  block:
    - name: Update package cache
      pacman:
        update_cache: yes
    - name: Upgrade all software
      pacman:
        sync: '@'
      notify: Reboot system
  when: ansible_pkg_mgr == 'pacman'

- name: Configure yum package manager
  block:
    - name: Update all software
      yum:
        name: '*'
        state: latest
      notify: Reboot system
    - name: Install yum-utils
      yum:
        name: yum-utils
      when: ansible_distribution_major_version != '6'
  when: ansible_pkg_mgr == 'yum'

- name: Update all software using zypper package manager
  block:
    - name: Update all software
      zypper:
        name: '*'
        state: latest
      notify: Reboot system
  when: ansible_pkg_mgr == 'zypper'

