---
- name: Import assert.yml tasks
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for specified port to be available
  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection not in ['docker', 'docker_engine', 'lxc', 'lxd', 'podman']
    - bootstrap_wait_for_host | lower == "true"

- name: Prepare the system by testing connection and verifying sudo access
  block:
    - name: Test the connection
      wait_for_connection:
        timeout: 30
    - name: Verify sudo access
      command: whoami
      args:
        warn: no
      changed_when: false
      failed_when: "'root' not in output"
  rescue:
    - name: Gather bootstrap facts
      setup:
        gather_subset: "!all"
        gather_timeout: 10
    - name: Install bootstrap packages
      raw: "{{ item }}"
      with_items:
        - apt-get update
        - apt-get install -y --no-install-recommends python3 python3-pip
        - yum update -y
        - yum install -y python3 python3-pip

- name: Gather Ansible facts
  setup:

- name: Install necessary packages
  package:
    name: "{{ item }}"
    state: present
    update_cache: yes
  with_items: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become == 'true' }}"

