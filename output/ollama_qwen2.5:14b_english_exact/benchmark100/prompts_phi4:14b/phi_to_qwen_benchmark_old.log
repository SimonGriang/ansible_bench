content='---\n- name: Restart the RKE2 service\n  service:\n    name: "{{ rke2_service_name }}"\n    state: restarted\n  notify: Service (re)started\n\n- name: Wait for all nodes to be ready again\n  shell: kubectl get nodes --no-headers | grep \' Ready\' | wc -l\n  register: node_count\n  until: node_count.stdout | int == groups[\'rke2_cluster_group_name\'] | length\n  retries: 100\n  delay: 15\n  delegate_to: ansible_hostname\n  when: not ansible_check_mode\n\n- name: Wait for all pods to be ready again\n  shell: kubectl get pods --no-headers | awk \'BEGIN { exit_code=0 } /Running|Succeeded/ { next } { exit_code=1; print } END { exit exit_code }\'\n  register: pod_status\n  until: pod_status.rc == 0\n  retries: 100\n  delay: 15\n  delegate_to: ansible_hostname\n  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready is defined' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-14T08:31:47.912601123Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5037082471, 'load_duration': 97065058, 'prompt_eval_count': 531, 'prompt_eval_duration': 145288300, 'eval_count': 245, 'eval_duration': 4785441365, 'model_name': 'qwen2.5:14b'} id='run--0419355f-ccd8-4db6-b277-931a252e8515-0' usage_metadata={'input_tokens': 531, 'output_tokens': 245, 'total_tokens': 776}
