---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_packages }}"
  notify:
    - set_mysql_root_password
    - systemd_daemon_reload

- name: Configure mysql server
  lineinfile:
    path: "{{ mysql_configuration_destination }}"
    regexp: '^{{ item.name }}'
    line: "{{ item.name }} = {{ item.value }}"
  loop: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  lineinfile:
    path: "{{ mysql_configuration_destination }}"
    regexp: '^# ?socket'
    line: "socket={{ mysql_socket }}"
    insertafter: EOF
  block:
    - name: Create mysql client section if not exists
      lineinfile:
        path: "{{ mysql_configuration_destination }}"
        line: "[client]"
        insertafter: EOF
        create: true
        regexp: '^client$'

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    check_implicit_admin: true
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    check_implicit_admin: true
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  meta: flush_handlers


