---
- name: Create a system group for Vault
  group:
    name: "{{ vault_group }}"
    system: true
    state: present

- name: Create a system user for Vault
  user:
    name: "{{ vault_user }}"
    group: "{{ vault_group }}"
    shell: "{{ vault_user_shell }}"
    system: true
    state: present

- name: Create a download directory for Vault
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Download the Vault binary
  unarchive:
    src: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: true
    owner: root
    group: root
    mode: '0755'
    creates: "{{ vault_path }}/usr/bin/vault"

- name: Check if the main Vault directory exists
  file:
    path: "{{ vault_path }}"
    state: directory
    get_file_stat: true
  register: vault_check_path

- name: Create the main Vault directory if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: vault_check_path.stat is not defined or not vault_check_path.stat.exists

- name: Create additional directories in the main Vault directory
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_directories }}"

- name: Create data directories for Vault
  file:
    path: "{{ vault_path }}/{{ item }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_data_directories }}"

- name: Generate a TLS key and certificate for Vault
  shell: >
    openssl req -new -newkey rsa:2048 -days 365 -nodes -x509 -subj "/C=US/ST=California/L=San Francisco/O=HashiCorp/CN=vault" -keyout {{ vault_path }}/data/tls/{{ item.key }} -out {{ vault_path }}/data/tls/{{ item.certificate }}
  loop: "{{ vault_tls }}"
  notify: Restart Vault

- name: Set ownership of TLS files
  file:
    path: "{{ vault_path }}/data/tls/{{ item.key }}"
    mode: '0644'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_tls_files }}"
  no_log: false

- name: Copy the Vault binary to the appropriate location
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
    owner: root
    group: root
  notify: Restart Vault

- name: Set specific capabilities on the Vault binary
  file:
    path: "{{ vault_path }}/usr/bin/vault"
    attributes: cap_ipc_lock=ep

- name: Create a vault environment file
  copy:
    dest: "{{ vault_path }}/etc/vault.d/vault.env"
    mode: '0644'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    content: |
      VAULT_ADDR=http://127.0.0.1:8200
      VAULT_API_ADDR=http://127.0.0.1:8200
      VAULT_DEV_ROOT_TOKEN_ID=root
      VAULT_DEV_LISTEN_ADDRESS=127.0.0.1:8200
    preserve: true
  notify: Restart Vault

- name: Ensure the systemd system directory exists
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy the Vault service file for systemd
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: '0644'
    owner: root
    group: root
  when: ansible_systemd is defined
  notify: Reload Systemd

- name: Copy the Vault configuration file
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: '0644'
    owner: root
    group: root
  notify: Restart Vault

- name: Flush handlers to apply changes
  meta: flush_handlers

