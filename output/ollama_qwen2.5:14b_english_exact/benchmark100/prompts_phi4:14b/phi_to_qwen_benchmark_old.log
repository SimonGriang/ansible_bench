---
- name: Enable the Backports repository for Debian systems with a version less than 9
  apt_repository:
    repo: "deb http://deb.debian.org/debian {{ ansible_facts.os_release.version_id }}-backports main"
    state: present
  when: ansible_facts.os_family == 'Debian' and ansible_facts.os_release.version_id is version('9', '<')

- name: Set the default release to Backports for Debian systems with a version less than 9
  set_fact:
    ansible_default_release: "{{ ansible_facts.os_release.version_id }}-backports"
  when: ansible_facts.os_family == 'Debian' and ansible_facts.os_release.version_id is version('9', '<')

- name: Install the Ansible package, using the Backports release if applicable
  apt:
    name: ansible
    state: "{{ ansible_package_state }}"
    default_release: "{{ ansible_default_release }}"
  when: ansible_facts.os_family == 'Debian' and ansible_facts.os_release.version_id is version('9', '<')


