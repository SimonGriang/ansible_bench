---
- import_tasks: assert.yml
  delegate_to: localhost
  when: "'once' in inventory_hostname"

- name: Ensure bash package is installed
  package:
    name: bash
    state: present

- name: Install OpenJDK if java_vendor is openjdk
  ansible.builtin.package:
    name: "{{ java_openjdk_package }}"
    state: present
  when: java_vendor == "openjdk"
  environment:
    JAVA_HOME: "/usr/lib/jvm/{{ java_openjdk_package }}"
    PATH: "$PATH:/usr/lib/jvm/{{ java_openjdk_package }}/bin"

- name: Copy and install local Oracle Java RPM
  copy:
    src: "{{ java_rpm }}"
    dest: /tmp/java.rpm
  when: java_source == "local" and java_format == "rpm"
  notify: install_oracle_java_rpm

- name: Copy and install local Oracle Java DEB
  copy:
    src: "{{ java_deb }}"
    dest: /tmp/java.deb
  when: java_source == "local" and java_format == "deb"
  notify: install_oracle_java_deb

- name: Install Oracle Java RPM from repository
  ansible.builtin.package:
    name: "{{ java_oracle_package }}"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Ensure installation directory exists and install Oracle Java tarball
  block:
    - file:
        path: "{{ java_install_dir }}"
        state: directory
        mode: '0755'
      when: java_format == "targz" and java_vendor == "oracle"
    - ansible.builtin.unarchive:
        src: "{{ java_targz }}"
        dest: "{{ java_install_dir }}"
        remote_src: yes
      when: java_format == "targz" and java_vendor == "oracle"
    - file:
        path: "{{ java_install_dir }}"
        mode: '0755'
      when: java_format == "targz" and java_vendor == "oracle"
  notify: set_java_default

- name: Install Oracle Java Cryptography Extension (JCE) policy software
  unarchive:
    src: "{{ java_jce_targz }}"
    dest: /usr/java/jce
    remote_src: yes
  when: java_version == 8 and java_jce_enabled and java_vendor == "oracle"

- name: Set Java as default alternative
  command: update-alternatives --install /usr/bin/java java {{ java_install_dir }}/bin/java 1
