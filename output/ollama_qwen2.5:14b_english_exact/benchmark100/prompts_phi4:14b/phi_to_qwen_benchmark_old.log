---
- name: Ensure the system is using systemd as the init system
  assert:
    that:
      - ansible_service_mgr == "systemd"
    fail_msg: "This playbook only works with systemd as the init system."

- name: Retrieve the latest release information for Grafana Loki
  uri:
    url: "{{ 'https://api.github.com/repos/grafana/loki/releases/latest' if promtail_version == 'latest' else 'https://api.github.com/repos/grafana/loki/releases/tags/' ~ promtail_version }}"
    method: GET
    return_content: yes
    status_code: 200
    validate_certs: yes
    headers:
      Authorization: "Bearer {{ github_token }}"
  register: release_info
  retries: 5
  delay: 5
  until: release_info.status == 200
  when: promtail_version == "latest"
  failed_when: release_info.status != 200

- name: Set promtail_version fact based on release tag name
  set_fact:
    promtail_version: "{{ release_info.json.tag_name }}"
  when: promtail_version == "latest"

- name: Verify the existence of a local promtail binary archive
  stat:
    path: "{{ promtail_binary_local_dir }}/{{ promtail_version }}/promtail-linux-amd64.zip"
  register: promtail_binary_exists
  when: promtail_binary_local_dir is defined
  failed_when: not promtail_binary_exists.stat.exists

- name: Download and verify the checksum for the promtail binary if not using a local binary
  block:
    - name: Fetch the checksum list from the GitHub release page
      set_fact:
        checksum_list_url: "{{ lookup('url', 'https://github.com/grafana/loki/releases/download/{{ promtail_version }}/checksums.txt').split('\n')[0].split(' ')[0] }}"
    - name: Extract the checksum for the specified architecture
      set_fact:
        promtail_checksum: "{{ lookup('url', 'https://github.com/grafana/loki/releases/download/{{ promtail_version }}/checksums.txt').split('\n')[0].split(' ')[1] }}"
  when: promtail_binary_local_dir is not defined


