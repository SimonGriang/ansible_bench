---
- name: Install Keepalived when HA mode is enabled
  when: rke2_ha_mode | default(False) and rke2_keepalived_enabled | default(False) and rke2_api_ip is defined and inventory_hostname in groups['rke2_servers']
  block:
    - name: Ensure epel repository is installed
      yum:
        name: epel-release
        state: present
    - name: Install keepalived
      yum:
        name: keepalived
        state: present

- name: Download and install RKE2 version
  block:
    - name: Download RKE2 binary
      get_url:
        url: "https://github.com/rke2/release/releases/download/v{{ rke2_version }}/rke2-install-{{ ansible_distribution|lower }}-{{ ansible_distribution_version|replace('.', '_') }}.{{ ansible_architecture }}.tar.gz"
        dest: /usr/local/bin/rke2
    - name: Make RKE2 binary executable
      file:
        path: /usr/local/bin/rke2
        mode: 'u+x'
    - name: Install RKE2 binary
      command: /usr/local/bin/rke2 install

- name: Apply CIS Hardening
  when: rke2_cis_profile is defined and rke2_cis_profile | length > 0
  block:
    - name: Apply CIS Hardening profiles
      command: /usr/local/bin/rke2 cisp apply --profile "{{ rke2_cis_profile }}"

- name: Find Active Server
  block:
    - name: Get active server from rke2 API
      uri:
        url: "http://{{ rke2_api_ip }}/v1/cluster/active"
        method: GET
        status_code: 200
        return_content: yes
      register: active_server
    - name: Set active server fact
      set_fact:
        active_server: "{{ active_server.json.active_server }}"

- name: Enable IPVS kernel module
  when: rke2_kubevip_ipvs_enabled | default(False) and inventory_hostname in groups['rke2_servers'] and rke2_ha_mode | default(False) and not rke2_keepalived_enabled | default(False)
  block:
    - name: Enable IPVS kernel module
      command: modprobe ip_vs

- name: Copy kube-vip manifests to the masternode
  when: rke2_ha_mode | default(False) and rke2_kubevip_enabled | default(False) and not rke2_keepalived_enabled | default(False)
  block:
    - name: Copy kube-vip manifests to master
      copy:
        src: "{{ item }}"
        dest: /etc/rke2/kube-vip-{{ item.split('/')[-1] }}
      loop: "{{ rke2_kubevip_manifests }}"

- name: Copy ingress-nginx manifests to the masternode
  when: ingress_nginx_values is defined and ingress_nginx_values | length > 0
  block:
    - name: Copy ingress-nginx manifests to master
      copy:
        src: "{{ item }}"
        dest: /etc/rke2/ingress-nginx-{{ item.split('/')[-1] }}
      loop: "{{ ingress_nginx_values }}"

- name: Prepare very first server node in the cluster
  when: active_server is not defined or (active_server is defined and (active_server == inventory_hostname or active_server == first_server_node))
  block:
    - name: Prepare first server node
      command: /usr/local/bin/rke2 prepare --server --etcd --kube-context rke2@rke2 --kubeconfig /etc/rke2/kubeconfig

- name: Restore etcd specific tasks
  when: active_server is defined and (active_server == inventory_hostname or active_server == first_server_node) and rke2_etcd_restore_enabled | default(False)
  block:
    - name: Restore etcd
      command: /usr/local/bin/rke2 restore etcd --kubeconfig /etc/rke2/kubeconfig

- name: Download kubeconfig to ansible localhost
  when: rke2_download_kubeconfig_enabled | default(False) and (active_server is defined and active_server == inventory_hostname)
  block:
    - name: Download kubeconfig
      get_url:
        url: "http://{{ rke2_api_ip }}/v1/kubeconfig"
        dest: /home/{{ ansible_user }}/kubeconfig

- name: Prepare and join remaining nodes of the cluster
  when: active_server is defined and rke2_server_count | int > 1
  block:
    - name: Prepare and join remaining nodes
      command: /usr/local/bin/rke2 prepare --join --server --kube-context rke2@rke2 --kubeconfig /etc/rke2/kubeconfig

- name: Rolling cordon and drain restart when version changes - servers
  when: rke2_version_changed | default(False) and inventory_hostname in groups['rke2_servers']
  block:
    - name: Cordon server node
      command: /usr/local/bin/rke2 cordon
    - name: Drain and restart server node
      command: /usr/local/bin/rke2 drain --force

- name: Rolling cordon and drain restart when version changes - agents
  when: rke2_version_changed | default(False) and inventory_hostname in groups['rke2_agents']
  block:
    - name: Cordon agent node
      command: /usr/local/bin/rke2 cordon
    - name: Drain and restart agent node
      command: /usr/local/bin/rke2 drain --force

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  when: rke2_config_files_changed | default(False)
  block:
    - name: Rolling restart on config change
      command: /usr/local/bin/rke2 restart --force

- name: Final steps
  block:
    - name: Finalize setup
      command: /usr/local/bin/rke2 finalize

