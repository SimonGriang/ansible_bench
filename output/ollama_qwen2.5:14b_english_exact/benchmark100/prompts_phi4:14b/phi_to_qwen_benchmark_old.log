---
- name: Remove obsolete Docker packages
  yum:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Add Docker GPG key
  when: docker_add_repo is true
  shell: rpm --import {{ docker_yum_gpg_key }}

- name: Add Docker repository
  when: docker_add_repo is true
  copy:
    content: "[docker-{{ docker_edition }}]\nname=Docker {{ docker_edition }} - {{ ansible_distribution | lower }}\nbaseurl={{ docker_yum_repo_url }}\nenabled=1\ngpgcheck=1\ngpgkey={{ docker_yum_gpg_key }}"
    dest: /etc/yum.repos.d/docker-{{ docker_edition }}.repo

- name: Configure Docker Nightly repo
  when: docker_add_repo is true
  lineinfile:
    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    regexp: '^enabled=1$'
    line: 'enabled={{ docker_yum_repo_enable_nightly|bool|int }}'
    backrefs: yes
    state: present
  notify: regenerate_package_cache

- name: Configure Docker Test repo
  when: docker_add_repo is true
  lineinfile:
    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    regexp: '^test=1$'
    line: 'test={{ docker_yum_repo_enable_test|bool|int }}'
    backrefs: yes
    state: present
  notify: regenerate_package_cache

- name: Configure containerd on RHEL 8
  when: ansible_distribution_major_version == '8'
  block:
    - name: Ensure runc package is absent
      yum:
        name: runc
        state: absent

    - name: Ensure container-selinux is installed
      yum:
        name: container-selinux
        state: present

    - name: Ensure containerd.io is installed
      yum:
        name: containerd.io
        state: present



