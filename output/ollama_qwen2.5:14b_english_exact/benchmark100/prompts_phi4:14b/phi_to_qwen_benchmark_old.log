---
- name: Retrieve all node names from an etcd cluster
  shell: kubectl get etcd --namespace=etcd-cluster -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' --kubeconfig=/path/to/kubeconfig
  register: etcd_node_names

- name: Delete old nodes from the etcd cluster
  shell: kubectl delete etcd "{{ item }}" --namespace=etcd-cluster --kubeconfig=/path/to/kubeconfig
  loop: "{{ query('iterable', etcd_node_names.results | json_query('[].stdout_lines') | difference(query('iterable', etcd_cluster_nodes))) }}"
  ignore_errors: yes

