---
- name: Migrate the Java JDK vendor from adoptopenjdk to temurin if selected
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS-specific variables for the Java JDK
  include_vars:
    file: "{{ item }}"
  with_first_found:
    - "vars/{{ ansible_distribution }}-{{ ansible_distribution_version }}-{{ java_jdk_vendor }}.yml"
    - "vars/{{ ansible_distribution }}-{{ java_jdk_vendor }}.yml"
    - "vars/{{ ansible_os_family }}-{{ java_jdk_vendor }}.yml"
    - "vars/{{ java_jdk_vendor }}.yml"

- name: Gather architecture-specific variables for the Java JDK
  include_vars:
    file: "{{ item }}"
  with_first_found:
    - "vars/{{ ansible_architecture }}.yml"
    - "vars/default.yml"

- name: Set OS-specific Java variables
  set_fact:
    java_package_version: "{{ item }}"
  when: java_package_version is not defined or java_package_version is None
  loop:
    - "{{ os_specific_java_version }}"

- name: Set OS and architecture-specific Java variables
  set_fact:
    java_package_version: "{{ item }}"
  when: java_package_version is not defined or java_package_version is None
  loop:
    - "{{ os_and_architecture_specific_java_version }}"

- name: Set specific Java variables
  set_fact:
    java_home: "/usr/lib/jvm/{{ java_package_version }}"

- name: Handle Debian pre-requisites for Java installation
  block:
    - name: Remove deprecated repositories
      apt:
        name: "{{ item }}"
        state: absent
      loop: "{{ java_deprecated_repositories }}"
    - name: Install extra packages
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ java_extra_packages }}"
    - name: Add key repositories
      apt_key:
        url: "{{ item }}"
      loop: "{{ java_key_repositories }}"
    - name: Add required repositories
      apt_repository:
        filename: "{{ item }}"
        state: present
      loop: "{{ java_required_repositories }}"
  when: ansible_os_family == "Debian"

- name: Handle RedHat pre-requisites for Java installation
  block:
    - name: Add key repositories
      rpm_key:
        key: "{{ item }}"
        state: present
      loop: "{{ java_key_repositories }}"
    - name: Add required repositories
      yum_repository:
        file: "{{ item }}"
        state: present
      loop: "{{ java_required_repositories }}"
  when: ansible_os_family == "RedHat"

- name: Install required libraries for Java
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libraries }}"

- name: Install Java on Debian systems
  apt:
    name: "{{ java_package }}"
    state: present
    update_cache: yes
  when: ansible_os_family == "Debian"

- name: Install Java on RedHat systems
  yum:
    name: "{{ java_package }}"
    state: present
    update_cache: yes
  when: ansible_os_family == "RedHat"

- name: Export Java environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh

- name: Source Java environment variables
  shell: source /etc/profile.d/jdk.sh

- name: Correct Java version selection for versions less than 11 on Debian systems
  command: alternatives --set java /usr/lib/jvm/{{ java_package_version }}/jre/bin/java
  when: ansible_os_family == "Debian" and java_package_version is version("<", "11")

- name: Correct Java version selection for versions 11 or greater on Debian systems
  command: alternatives --set java /usr/lib/jvm/{{ java_package_version }}-{{ java_version }}/bin/java
  when: ansible_os_family == "Debian" and java_package_version is version(">=", "11")

