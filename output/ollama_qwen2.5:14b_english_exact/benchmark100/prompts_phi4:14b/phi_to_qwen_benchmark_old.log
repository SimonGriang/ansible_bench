---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Pre-configure Debian systems for Postfix
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: "No configuration"
    vtype: select
  when: ansible_os_family == 'Debian'

- name: Install Postfix
  apt:
    name: postfix
    state: present
  when: ansible_os_family == 'Debian'

- name: Conditionally install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps|default('') is defined and postfix_virtual_mailbox_maps|default('') == 'mysql' or postfix_virtual_mailbox_domains|default('') is defined and postfix_virtual_mailbox_domains|default('') == 'mysql' or postix_virtual_alias_maps|default('') is defined and postix_virtual_alias_maps|default('') == 'mysql'

- name: Configure Postfix transport maps
  template:
    src: templates/{{ postfix_transport_maps_template }}.j2
    dest: /etc/postfix/transport
  when: postfix_transport_maps_template is defined
  notify: validate postfix configuration and rebuild transport maps

- name: Configure Postfix header checks
  template:
    src: templates/{{ postfix_header_checks_template }}.j2
    dest: /etc/postfix/header_checks
  when: postfix_header_checks_template is defined
  notify: validate postfix configuration and reload postfix

- name: Set values for Postfix main.cf (part 1)
  set_fact:
    postfix_main_recipient_restrictions: "{{ postfix_recipient_access|default('')|d('') }}"
    postfix_main_sender_restrictions: "{{ postfix_sender_access|default('')|d('') }}"

- name: Set values for Postfix main.cf (part 2)
  set_fact:
    postfix_main_mynetworks: "{{ postfix_mynetworks|default('')|d('') }}"
    postfix_main_mydestination: "{{ postfix_mydestination|default('')|d('') }}"
    postfix_main_relay_domains: "{{ postfix_relay_domains|default('')|d('') }}"
    postfix_main_smtpd_recipient_restrictions: "{{ postfix_main_recipient_restrictions|d('') }}"
    postfix_main_smtpd_sender_restrictions: "{{ postfix_main_sender_restrictions|d('') }}"
    postfix_main_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains|default('')|d('') }}"
    postfix_main_virtual_alias_domains: "{{ postfix_virtual_alias_domains|default('')|d('') }}"

- name: Configure Postfix main.cf
  template:
    src: templates/main.cf.j2
    dest: /etc/postfix/main.cf
  notify: validate postfix configuration and restart postfix

- name: Configure Postfix master.cf
  template:
    src: templates/master.cf.j2
    dest: /etc/postfix/master.cf
  notify: validate postfix configuration and restart postfix

- name: Create directories for TLS certificates and keys
  file:
    path: "{{ postfix_tls_directory|default('') }}"
    state: directory
    mode: 0755
  when: postfix_tls_source is defined and postfix_tls_source is not ''

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_source }}"
    dest: "{{ postfix_tls_path|default('') }}"
    mode: 0600
  when: postfix_tls_source is defined and postfix_tls_source is not ''
  notify: postfix reload

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_source }}"
    dest: "{{ postfix_tls_key_path|default('') }}"
    mode: 0600
  when: postfix_tls_key_source is defined and postfix_tls_key_source is not ''
  notify: postfix reload

- name: Flush Postfix handlers
  meta: flush_handlers

- name: Configure Postfix aliases
  lineinfile:
    path: "{{ postfix_aliases_path|default('') }}"
    regexp: "^(?:alias|{{ postfix_aliases_path|basename }}):\s*"
    line: "{{ item }}"
    create: yes
  with_items: "{{ postfix_aliases|default('')|d([]) }}"
  when: postfix_aliases|default('') is defined
  notify: postfix aliases database rebuild and reload

- name: Configure Postfix sender access
  lineinfile:
    path: "{{ postfix_sender_access_path|default('') }}"
    regexp: "^(?:alias|{{ postfix_sender_access_path|basename }}):\s*"
    line: "{{ item }}"
    create: yes
  with_items: "{{ postfix_sender_access|default('')|d([]) }}"
  when: postfix_sender_access|default('') is defined
  notify: postfix sender access database rebuild and reload

- name: Configure Postfix recipient access
  lineinfile:
    path: "{{ postfix_recipient_access_path|default('') }}"
    regexp: "^(?:alias|{{ postfix_recipient_access_path|basename }}):\s*"
    line: "{{ item }}"
    create: yes
  with_items: "{{ postfix_recipient_access|default('')|d([]) }}"
  when: postfix_recipient_access|default('') is defined
  notify: validate postfix configuration, postfix recipient access database rebuild and reload

- name: Place SASL password map
  copy:
    src: "{{ postfix_smtp_sasl_password_map_source|default('') }}"
    dest: "{{ postfix_smtp_sasl_password_map_path|default('') }}"
    mode: 0600
  when: postfix_smtp_sasl_password_map_source is defined and postfix_smtp_sasl_password_map_source is not ''
  notify: postfix sasl_password_map rebuild

- name: Flush Postfix handlers again
  meta: flush_handlers

- name: Start and enable Postfix service
  systemd:
    name: postfix
    state: started
    enabled: yes


