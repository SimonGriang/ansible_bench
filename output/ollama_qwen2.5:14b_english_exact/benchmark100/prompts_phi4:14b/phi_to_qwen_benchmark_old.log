---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install MySQL packages
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify: set_mysql_root_password
  notify: restart_mysql

- name: Configure MySQL server configuration file
  lineinfile:
    path: /etc/mysql/my.cnf
    line: "{{ item }}"
    create: yes
    mode: 0644
  with_items: "{{ mysql_configuration_options }}"
  notify: restart_mysql

- name: Configure MySQL client configuration file
  lineinfile:
    path: /etc/mysql/conf.d/client.cnf
    line: "socket={{ mysql_socket }}"
    create: yes
    mode: 0644

- name: Initialize MySQL database if on Alpine or Archlinux
  command: "{{ mysql_initdb_command }}"
  args:
    chdir: /var/lib/mysql
  when: ansible_facts.distribution in ['Alpine', 'Archlinux']
  notify: restart_mysql

- name: Start and enable the MySQL service
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place the my.cnf configuration file
  template:
    src: my.cnf.j2
    dest: /root/my.cnf
    mode: 0600

- name: Create MySQL databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    check_implicit_admin: yes
    login_host: localhost
  with_items: "{{ mysql_databases }}"
  when: item.import is not defined
  register: created_databases
  ignore_errors: yes

- name: List current MySQL databases
  shell: mysql -u root -p{{ mysql_root_password }} -Nse 'show databases'
  register: existing_databases
  when: mysql_databases is defined
  ignore_errors: yes

- name: Import databases if initial import is defined and not already present
  shell: mysql -u root -p{{ mysql_root_password }} {{ item.name }} < {{ item.import }}
  when: item.import is defined and item.name not in existing_databases.stdout
  with_items: "{{ mysql_databases }}"

- name: Create MySQL users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  with_items: "{{ mysql_users }}"
  register: created_users
