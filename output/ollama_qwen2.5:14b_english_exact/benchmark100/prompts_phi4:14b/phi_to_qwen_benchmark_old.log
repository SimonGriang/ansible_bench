---
- name: Disable swap if vault_hardening_disable_swap is set and swap is currently enabled
  ansible.builtin.command: swapoff -a
  when: vault_hardening_disable_swap and ansible_swaps.active

- name: Disable core dumps if vault_hardening_disable_core_dumps is set
  ansible.builtin.lineinfile:
    path: /etc/security/limits.conf
    regexp: '^@vault_hardening_disable_core_dumps=true\n'
    line: '* hard core 0\n* soft core 0'
    state: present
  when: vault_hardening_disable_core_dumps

- name: Disable shell command history for vault commands if vault_hardening_disable_shell_command_history is set
  ansible.builtin.template:
    src: disable_vault_history.sh.j2
    dest: /etc/profile.d/disable_vault_history.sh
    mode: '0755'
  when: vault_hardening_disable_shell_command_history

- name: Configure SELinux and/or AppArmor if vault_hardening_configure_selinux_apparmor is set
  block:
    - name: Ensure selinux-policy is installed
      ansible.builtin.package:
        name: selinux-policy
        state: present
      when: ansible_os_family == 'RedHat' and vault_hardening_configure_selinux_apparmor

    - name: Set SELinux policy to enforcing
      ansible.builtin.seboolean:
        name: selinux
        state: True
        persistent: True
      when: ansible_os_family == 'RedHat' and vault_hardening_configure_selinux_apparmor

    - name: Enforce AppArmor profile for vault
      ansible.builtin.apparmor_profile:
        name: vault
        state: enforced
      when: ansible_os_family == 'Debian' and vault_hardening_configure_selinux_apparmor

