        dest: "{{ item.dest }}"
        mode: '0644'
        timeout: 60
      loop: "{{ rke2_artifacts }}"
      when: rke2_airgap_mode and rke2_airgap_implementation == 'download'
      register: rke2_artifacts_download
      until: rke2_artifacts_download.status == 200
      retries: 5
      delay: 10

    - name: Fallback to local download
