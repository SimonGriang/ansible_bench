---
- name: Create the RKE2 manifests directory
  file:
    path: /opt/rke2/manifests
    state: directory
    owner: root
    group: root
    mode: 0700

- name: Copy kube-vip files to the first server
  copy:
    src: "{{ item }}"
    dest: /opt/rke2/manifests/clusterd.yaml
    mode: 0664
  with_items:
    - templates/clusterd.yaml.j2
  notify: restart kube-vip

- name: Copy kube-vip load balancer manifests to the first server
  copy:
    src: "{{ item }}"
    dest: /opt/rke2/manifests/{{ item | basename | regex_replace('.j2$', '') }}
    mode: 0664
  when: kube_vip_cloud_provider_enabled
  with_items:
    - templates/kube-vip-lb-cloud-provider-aws.yaml.j2
    - templates/kube-vip-lb-cloud-provider-gcp.yaml.j2
  notify: restart kube-vip

