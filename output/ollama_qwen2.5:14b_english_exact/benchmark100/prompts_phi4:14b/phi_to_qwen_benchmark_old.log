---
- import_tasks: assert.yml
  when: True
  run_once: true

- name: Install the necessary cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure the shell environment for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    mode: '0600'
    create: yes
  notify: restart cron

- name: Configure the PATH environment variable for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    mode: '0600'
    create: yes
  notify: restart cron

- name: Configure the MAILTO environment variable for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    mode: '0600'
    create: yes
  notify: restart cron

- name: Ensure the cron service is started and enabled
  service:
    name: "{{ cron_service | default('') }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service | length > 0

- name: Schedule the specified cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    special_weekdays: "{{ item.special_weekdays | default('') }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs | default([]) }}"
  when: cron_jobs | length > 0

