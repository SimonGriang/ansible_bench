---
- name: Import additional tasks from assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for a specific port to be available
  ansible.builtin.wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection not in ['docker', 'ssh']
    - bootstrap_wait_for_host

- name: Test connection and check for sudo availability
  block:
    - name: Test the connection
      ansible.builtin.ping:
    - name: Check for sudo availability
      ansible.builtin.shell: sudo -l
      register: sudo_check
      changed_when: false
      failed_when: false
  rescue:
    - name: Gather bootstrap facts
      ansible.builtin.raw: facter
      register: bootstrap_facts
      delegate_to: localhost
    - name: Install bootstrap packages
      ansible.builtin.raw: |
        case {{ ansible_distribution }} in
        RedHat*)
          yum -y install libdnf5
          ;;
        Debian|Ubuntu)
          apt-get update && apt-get install -y curl
          ;;
        esac
      when: bootstrap_facts is defined
  always:
    - name: Ensure a new line at the end of the file
      meta: end_play

- name: Gather Ansible facts
  ansible.builtin.setup:
  become: false

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become | bool }}"


