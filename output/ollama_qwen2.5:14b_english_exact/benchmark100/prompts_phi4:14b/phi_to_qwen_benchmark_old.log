    mode: '0600'
  loop: "{{ ssl_items }}"
  register: ssl_key

- name: Create SSL CSR for each item
  community.crypto.openssl_csr:
    path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    subject:
      CN: "{{ item.common_name }}"
      O: "{{ item.organization }}"
      L: "{{ item.locality }}"
      ST: "{{ item.state }}"
      C: "{{ item.country }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0600'
  loop: "{{ ssl_items }}"
  register: ssl_csr

- name: Create SSL certificates for each item
  community.crypto.x509_certificate:
    path: "{{ item.cert_path }}"
    privatekey_path: "{{ item.key_path }}"
    csr_path: "{{ item.csr_path }}"
    selfsigned: yes
    valid_from: '19700101000000'
    valid_to: '20380101000000'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0644'
  loop: "{{ ssl_items }}"
  register: ssl_cert

- name: Create PKCS#12 file for each item
  community.crypto.openssl_pkcs12:
