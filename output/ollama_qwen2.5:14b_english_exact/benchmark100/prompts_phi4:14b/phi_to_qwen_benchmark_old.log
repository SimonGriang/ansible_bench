---
- name: Import assertion task
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install logrotate package
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  template:
    src: "{{ logrotate_config_file }}"
    dest: "{{ logrotate_config_directory }}/logrotate.conf"
    owner: root
    group: root
    mode: '0644'

- name: Generate logrotate.d configuration files
  template:
    src: entry.j2
    dest: "{{ item.dest }}"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ logrotate_entries | rejectattr('state', 'equalto', 'absent') | list }}"
  when: item.dest is defined

- name: Remove logrotate.d configuration files
  file:
    path: "{{ item.dest }}"
    state: absent
  loop: "{{ logrotate_entries | selectattr('state', 'equalto', 'absent') | list }}"

- name: Start the logrotate service
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"

