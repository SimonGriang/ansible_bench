---
- name: Create SSL key for each item
  community.crypto.openssl_privatekey:
    path: "{{ item.key_path }}"
    size: 2048
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0600'
  loop: "{{ ssl_items }}"
  register: ssl_key

- name: Create SSL CSR for each item
  community.crypto.openssl_csr:
    path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    subject:
      CN: "{{ item.common_name }}"
      O: "{{ item.organization }}"
      L: "{{ item.locality }}"
      ST: "{{ item.state }}"
      C: "{{ item.country }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0600'
  loop: "{{ ssl_items }}"
  register: ssl_csr

- name: Create SSL certificates for each item
  community.crypto.x509_certificate:
    path: "{{ item.cert_path }}"
    privatekey_path: "{{ item.key_path }}"
    csr_path: "{{ item.csr_path }}"
    selfsigned: yes
    valid_from: '19700101000000'
    valid_to: '20380101000000'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0644'
  loop: "{{ ssl_items }}"
  register: ssl_cert

- name: Create PKCS#12 file for each item
  community.crypto.openssl_pkcs12:
    state: present
    path: "{{ item.pkcs12_path }}"
    privatekey_path: "{{ item.key_path }}"
    certificate_path: "{{ item.cert_path }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0600'
  loop: "{{ ssl_items }}"
  register: ssl_pkcs12

- name: Read private key for each item
  ansible.builtin.slurp:
    src: "{{ item.key_path }}"
  loop: "{{ ssl_items }}"
  register: ssl_key_content

- name: Read certificate for each item
  ansible.builtin.slurp:
    src: "{{ item.cert_path }}"
  loop: "{{ ssl_items }}"
  register: ssl_cert_content

- name: Create a combined private key and certificate file for each item
  ansible.builtin.copy:
    content: "{{ item.ssl_key_content.content + '\n' + (item.ssl_cert_content.content | b64decode) }}"
    dest: "{{ item.combined_path }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0644'
  loop: "{{ ssl_items }}"
  loop_control:
    extended: true
  vars:
    ssl_key_content: "{{ ssl_key_content.results[item.index] }}"
    ssl_cert_content: "{{ ssl_cert_content.results[item.index] }}"
    combined_path: "{{ item.combined_path }}"


