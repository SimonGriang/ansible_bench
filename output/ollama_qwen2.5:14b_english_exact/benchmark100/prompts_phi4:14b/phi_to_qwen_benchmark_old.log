---
- name: Check the current version of Docker Compose installed on the system
  command: docker-compose version --short
  register: docker_compose_version
  changed_when: false

- name: Set a fact for the current Docker Compose version if it is defined and the output is not empty
  set_fact:
    docker_compose_version_fact: "{{ docker_compose_version.stdout | default('') }}"
  when: docker_compose_version.stdout | default('') | length > 0

- name: Delete the existing Docker Compose binary if the installed version does not match the desired version
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: docker_compose_version_fact is defined and docker_compose_version_fact != 'desired_version'

- name: Download and install the specified version of Docker Compose if it is not already installed or if the installed version is older
  get_url:
    url: "https://github.com/docker/compose/releases/download/desired_version/docker-compose-$(uname -s)-$(uname -m)"
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when: docker_compose_version_fact is not defined or docker_compose_version_fact == '' or docker_compose_version_fact < 'desired_version'

