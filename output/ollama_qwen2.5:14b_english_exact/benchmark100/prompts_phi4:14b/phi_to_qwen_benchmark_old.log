---
- name: Import the assert.yml tasks file
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install HashiCorp products using the package installation method
  when: installation_method == "package"
  block:
    - name: Download HashiCorp repository configuration for RedHat/Rocky
      ansible.builtin.get_url:
        url: "{{ hashicorp_repo_url }}"
        dest: /etc/yum.repos.d/{{ hashicorp_repo_filename }}
        mode: 0644
      when: ansible_facts['os_family'] == "RedHat" or ansible_facts['os_family'] == "Rocky"

    - name: Ensure gnupg package is installed for Debian systems
      ansible.builtin.package:
        name: gnupg
        state: present
      when: ansible_facts['os_family'] == "Debian"

    - name: Import HashiCorp GPG key for Debian systems
      ansible.builtin.command: apt-key add -
      args:
        creates: /etc/apt/trusted.gpg.d/hashicorp.gpg
      stdin: "{{ hashicorp_gpg_key }}"
      when: ansible_facts['os_family'] == "Debian"

    - name: Configure HashiCorp repository for Debian systems
      ansible.builtin.get_url:
        url: "{{ hashicorp_repo_url }}"
        dest: /etc/apt/sources.list.d/hashicorp.list
        mode: 0644
      when: ansible_facts['os_family'] == "Debian"

    - name: Install HashiCorp products using package manager
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ hashicorp_products }}"
      when: ansible_facts['os_family'] == "RedHat" or ansible_facts['os_family'] == "Rocky" or ansible_facts['os_family'] == "Debian"

- name: Install HashiCorp products manually
  when: installation_method == "manual"
  block:
    - name: Download and extract HashiCorp products
      ansible.builtin.unarchive:
        src: "{{ hashicorp_product_source }}"
        dest: "{{ hashicorp_product_destination }}"
        remote_src: yes
        owner: "{{ hashicorp_product_owner }}"
        group: "{{ hashicorp_product_group }}"
        mode: "{{ hashicorp_product_mode }}"

