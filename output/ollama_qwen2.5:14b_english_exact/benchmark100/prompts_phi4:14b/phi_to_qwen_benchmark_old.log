---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'
    owner: root

- name: Set server-specific node taints
  set_fact:
    node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Template the RKE2 configuration file
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0600'
    owner: root
  notify: Config file changed

- name: Template the kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0600'
    owner: root
  notify: Config file changed
  when: rke2_kubelet_config is not empty

- name: Configure Containerd registry settings
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0600'
    owner: root
  notify: Config file changed
  when: rke2_custom_registry_mirrors is defined or rke2_custom_registry_configs is defined

- name: Determine if an etcd restore from a file is necessary
  set_fact:
    do_etcd_restore: true
  when: etcd_snapshot_file is defined and (rke2_service_state == 'absent' or rke2_service_state == 'disabled')

- name: Determine if an etcd restore from S3 is necessary
  set_fact:
    do_etcd_restore_from_s3: true
  when: etcd_snapshot_file is defined and etcd_s3_bucket is defined and etcd_s3_region is defined and etcd_s3_key is defined and etcd_s3_access_key is defined and etcd_s3_secret_key is defined

- name: Restore etcd from a snapshot file
  block:
    - name: Create snapshot directory
      file:
        path: /var/lib/rancher/rke2/agent/etcd-snapshots
        state: directory
        mode: '0755'
        owner: root

    - name: Copy snapshot file
      copy:
        src: "{{ etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/etcd-snapshots/snapshot.db
        mode: '0644'
        owner: root

    - name: Restore etcd from snapshot file
      shell: rke2 server restore /var/lib/rancher/rke2/agent/etcd-snapshots/snapshot.db
      changed_when: ansible_rc != 0
      register: etcd_restore_from_file
  when: do_etcd_restore is true

- name: Restore etcd from an S3 snapshot
  shell: rke2 server restore s3://{{ etcd_s3_bucket }}/{{ etcd_s3_key }} --region={{ etcd_s3_region }} --access-key={{ etcd_s3_access_key }} --secret-key={{ etcd_s3_secret_key }}
  changed_when: ansible_rc != 0
  register: etcd_restore_from_s3
  when: do_etcd_restore_from_s3 is true

- name: Start the RKE2 server service
  service:
    name: rke2-server
    enabled: true
    state: started
    environment:
      - RKE2_TOKEN={{ rke2_token }}
  notify: Service (re)started

- name: Mask the RKE2 agent service
  service:
    name: rke2-agent
    masked: true

- name: Wait for the first server to be ready without CNI
  block:
    - name: Check server readiness status without CNI
      shell: kubectl -n kube-system get service rke2-server | grep 127.0.0.1:6443 | grep -v NotReady | grep -v "False"
      register: server_ready
      retries: 100
      delay: 15
      until: server_ready is succeeded
      when: rke2_cni == 'none'

- name: Wait for the first server to be ready with CNI
  block:
    - name: Check server readiness status with CNI
      shell: kubectl -n kube-system get nodes | grep Ready
      register: server_ready
      retries: 40
      delay: 15
      until: server_ready is succeeded
      when: rke2_cni is not 'none'

- name: Clean up old nodes and secrets if restoring etcd
  block:
    - name: Retrieve registered node names
      shell: kubectl get nodes -o json | jq -r '.items[].metadata.name'
      register: registered_nodes

    - name: Identify nodes no longer present
      set_fact:
        deleted_nodes: "{{ deleted_nodes|default([]) + [item] }}"
      loop: "{{ registered_nodes.results|map(attribute='stdout_lines')|map('split', ' ')|flatten }}"
      when: item not in existing_nodes

    - name: Delete secrets for nodes no longer present
      shell: kubectl delete secrets -n kube-system {{ item }}
      loop: "{{ deleted_nodes }}"
      when: do_etcd_restore is true or do_etcd_restore_from_s3 is true

    - name: Delete nodes no longer present
      shell: kubectl delete node {{ item }}
      loop: "{{ deleted_nodes }}"
      when: do_etcd_restore is true or do_etcd_restore_from_s3 is true
  when: do_etcd_restore is true or do_etcd_restore_from_s3 is true

- name: Set the active server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  delegate_facts: true
  loop: "{{ groups['rke2_cluster_group_name'] }}" 71%|███████   | 71/100 [1:22:20<1:14:56, 155.04s/it]

