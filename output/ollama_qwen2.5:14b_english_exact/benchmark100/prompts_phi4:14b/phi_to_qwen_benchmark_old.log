---
- name: Import common assertions for the httpd role
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install the apache httpd package
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings for httpd if SELinux is enabled
  when: ansible_facts['os_family'] == 'RedHat'
  block:
    - name: Modify SELinux boolean settings
      seboolean:
        name: "{{ item.key }}"
        state: "{{ item.value }}"
        persist: true
      loop: "{{ httpd_sebooleans }}"

    - name: Allow connections to custom ports if SELinux is enabled
      seport:
        port: "{{ item.port }}"
        proto: "{{ item.proto }}"
        selevel: "{{ item.selevel }}"
        selabel: "{{ item.selabel }}"
        seport: "{{ item.setype }}"
        serole: "{{ item.serole }}"
        setype: "{{ item.setype }}"
        sestore: "{{ item.sestore }}"
      loop: "{{ httpd_ports }}"

- name: Configure the httpd main configuration file using a template
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    owner: root
    group: root
    mode: '0644'
  notify: test httpd config
  notify: restart httpd

- name: Activate httpd modules using a command on Debian systems
  when: ansible_facts['os_family'] == 'Debian'
  command: "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  notify: test httpd config

- name: Import SSL configuration tasks if HTTPS is enabled
  when: https_ssl_enable
  import_tasks: ssl.yml

- name: Import location configuration tasks if locations are defined
  when: httpd_locations|length > 0
  import_tasks: locations.yml

- name: Import virtual host configuration tasks if virtual hosts are defined
  when: httpd_vhosts|length > 0
  import_tasks: vhosts.yml

- name: Configure ports using a template on Debian and Suse systems
  when: ansible_facts['os_family'] in ['Debian', 'Suse']
  template:
    src: "{{ httpd_ports_conf }}"
    dest: /etc/httpd/conf/ports.conf
    owner: root
    group: root
    mode: '0644'
  notify: test httpd config
  notify:
    - restart httpd

- name: Import directory configuration tasks if directories are defined
  when: httpd_directories|length > 0
  import_tasks: directories.yml

- name: Flush all pending handlers
  meta: flush_handlers

- name: Remove the default index.html file if specified
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable the httpd service
  service:
    name: "{{ httpd_service }}"
    enabled: true
    state: started

# Fixing the duplication of the "notify" key as per yamllint requirements:
- name: Configure the httpd main configuration file using a template
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    owner: root
    group: root
    mode: '0644'
  notify: [test httpd config, restart httpd]

- name: Configure ports using a template on Debian and Suse systems
  when: ansible_facts['os_family'] in ['Debian', 'Suse']
  template:
    src: "{{ httpd_ports_conf }}"
    dest: /etc/httpd/conf/ports.conf
    owner: root
    group: root
    mode: '0644'
  notify: [test httpd config, restart httpd]

