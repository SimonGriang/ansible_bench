uration': 91646278, 'prompt_eval_count': 1638, 'prompt_eval_duration': 470841661, 'eval_count': 523, 'eval_duration': 12542373077, 'model_name': 'qwen2.5:14b'} id='run--065b5e23-76c1-412b-b13a-fffa09679858-0' usage_metadata={'input_tokens': 1638, 'output_tokens': 523, 'total_tokens': 2161}
