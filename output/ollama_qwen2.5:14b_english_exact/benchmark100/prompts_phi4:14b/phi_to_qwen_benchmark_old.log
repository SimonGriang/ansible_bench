---
- import_tasks: ansible.builtin.import_tasks
  delegate_to: localhost

- name: Uninstall the systemd-logger package
  ansible.builtin.yum:
    name: systemd-logger
    state: absent
  when: ansible_os_family == 'RedHat'

- name: Install the rsyslog package
  ansible.builtin.package:
    name: "{{ item }}"
    state: "{{ rsyslog_package_state }}"
  loop: "{{ rsyslog_packages }}"
  when: ansible_os_family == 'RedHat'

- name: Install additional rsyslog packages
  ansible.builtin.package:
    name: "{{ item.package }}"
    state: "{{ rsyslog_package_state }}"
  loop: "{{ rsyslog_features }}"
  when: ansible_os_family == 'RedHat'

- name: Configure the default rsyslog settings
  ansible.builtin.template:
    src: "rsyslog.conf.j2"
    dest: "{{ rsyslog_dest_conf_file }}"
    mode: '0644'
  notify: restart rsyslog
  when: rsyslog_deploy_default_config

- name: Ensure rsyslog configuration directory exists
  ansible.builtin.file:
    path: /etc/rsyslog.d/
    state: directory
    mode: '0755'

- name: Configure rsyslog to forward logs
  ansible.builtin.template:
    src: forward_rule.conf.j2
    dest: /etc/rsyslog.d/{{ rsyslog_forward_rule_name }}
    mode: '0644'
  notify: restart rsyslog
  when: not rsyslog_deploy_default_config

- name: Configure additional rsyslog configuration files
  block:
    - name: Create or update rsyslog files in /etc/rsyslog.d/
      ansible.builtin.copy:
        content: "{{ item.content | b64decode }}"
        dest: "/etc/rsyslog.d/{{ item.name }}"
        mode: "{{ item.mode }}"
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
      notify: restart rsyslog
      loop: "{{ rsyslog_rsyslog_d_files }}"
      when: item.state == 'present'

- name: Start and enable the rsyslog service
  ansible.builtin.systemd:
    name: "{{ rsyslog_service }}"
    enabled: true
    state: started

