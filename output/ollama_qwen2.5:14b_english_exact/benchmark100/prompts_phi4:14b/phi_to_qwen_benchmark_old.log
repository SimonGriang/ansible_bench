---
- import_tasks: assert.yml
  remote_src: yes
  vars:
    ansible_host: localhost

- name: Install cron
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ cron_packages }}"
  when: cron_packages is defined

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "SHELL={{ cron_shell }}"
    create: yes
    regexp: "^SHELL="
    backup: yes
  notify: restart cron
  when: cron_shell is defined

- name: Configure path
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "PATH={{ cron_path }}"
    create: yes
    regexp: "^PATH="
    backup: yes
  notify: restart cron
  when: cron_path is defined

- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    regexp: "^MAILTO="
    backup: yes
  notify: restart cron
  when: cron_mailto is defined

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service|length > 0

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined
  notify: restart cron

- name: Ensure cron configuration file exists
  file:
    path: /etc/cron.d/cron_config
    state: touch
  when: cron_shell is defined or cron_path is defined or cron_mailto is defined

