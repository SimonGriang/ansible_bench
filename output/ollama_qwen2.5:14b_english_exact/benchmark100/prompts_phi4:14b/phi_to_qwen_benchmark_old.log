---
- name: Gather bootstrap facts
  raw: cat /etc/os-release
  register: bootstrap_facts
  become: false

- name: Set bootstrap distribution and major version facts
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ lookup('community.general.json_query', bootstrap_facts.stdout, map_keys=true)['ID'] }}"
  when: bootstrap_facts.rc == 0 and bootstrap_distribution is undefined
  loop: "{{ bootstrap_os_family_map.keys() }}"
  loop_control:
    label: "{{ item }}"
  register: bootstrap_distribution_result
  become: false

- name: Set bootstrap distribution and major version facts
  ansible.builtin.set_fact:
    bootstrap_distribution_major_version: "{{ lookup('community.general.json_query', bootstrap_facts.stdout, map_keys=true)['VERSION_ID'].split('.')[0] }}"
  when: bootstrap_facts.rc == 0 and bootstrap_distribution is undefined
  loop: "{{ bootstrap_os_family_map.keys() }}"
  loop_control:
    label: "{{ item }}"
  when: bootstrap_facts.stdout | regex_search("^PRETTY_NAME.*{{ bootstrap_search[bootstrap_os_family_map[item]].pattern }}", "multiline")
  become: false

- name: Determine bootstrap OS family
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  when: bootstrap_distribution in item.value
  loop: "{{ bootstrap_os_family_map.items() }}"
  become: false

