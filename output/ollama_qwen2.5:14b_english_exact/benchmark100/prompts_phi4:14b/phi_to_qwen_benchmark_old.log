e_reason': 'stop', 'total_duration': 10259222052, 'load_duration': 108537328, 'prompt_eval_count': 1095, 'prompt_eval_duration': 81223255, 'eval_count': 412, 'eval_duration': 10059855028, 'model_name': 'qwen2.5:14b'} id='run--e5302309-4d5c-4008-9d3f-517430f15dd9-0' usage_metadata={'input_tokens': 1095, 'output_tokens': 412, 'total_tokens': 1507}
