---
- name: Ensure a group is managed with a specific name and state
  ansible.builtin.group:
    name: "{{ group_name }}"
    state: "{{ group_state | default('present') }}"
    gid: "{{ group_gid | default('') }}"
    system: "{{ group_system | default('no') }}"

- name: Configure sudo options for a specific group using a template
  ansible.builtin.template:
    src: sudo_group.j2
    dest: /etc/sudoers.d/{{ group_name | regex_replace('\\.', 'dot') }}
    mode: 0640
  when: group.sudo_options is defined
  loop: "{{ groups }}"
  loop_control:
    loop_var: group_name

