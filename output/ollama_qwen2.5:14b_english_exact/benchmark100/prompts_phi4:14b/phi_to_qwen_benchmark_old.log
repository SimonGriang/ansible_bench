---
- import_tasks: assert.yml

- name: Install the git package
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if the specified git user exists in the system
  getent:
    database: passwd
    key: "{{ git_username }}"
    no_fail: true

- name: Create a directory for the git configuration
  file:
    path: /home/{{ git_username }}
    state: directory
    mode: 0755
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when: git_username is defined and git_username is search_bin_files(git_username)

- name: Place the git configuration file
  template:
    src: gitconfig.j2
    dest: /home/{{ git_username }}/.gitconfig
    mode: 0644
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when: git_username is defined and git_username is search_bin_files(git_username)

- name: Create the repository destination directory
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    mode: 0755
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when: git_repository_destination is defined and git_username is search_bin_files(git_username)

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version | default(None) }}"
    accept_hostkey: true
    force: "{{ item.force | default(false) }}"
    update: true
    clone: true
    ssh_key: "{{ item.ssh_key | default(None) }}"
    http_user: "{{ item.http_user | default(None) }}"
    http_pass: "{{ item.http_pass | default(None) }}"
  with_items: "{{ git_repositories }}"
  become: yes
  become_user: "{{ git_username }}"
  when: git_repositories is defined and git_username is search_bin_files(git_username)

