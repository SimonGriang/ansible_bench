---
- name: Ensure the directory /etc/openvpn/client exists with appropriate permissions and ownership
  file:
    path: /etc/openvpn/client
    state: directory
    mode: 0750
    owner: root
    group: "{{ openvpn_group }}"
    recurse: yes

- name: Deploy the client configuration file for OpenVPN
  template:
    src: client.conf.j2
    dest: "{{ openvpn_configuration_directory }}/client.conf"
    owner: root
    group: "{{ openvpn_group }}"
    mode: 0640
  notify: restart openvpn

