content='---\n- name: Gather bootstrap facts\n  raw: cat /etc/os-release\n  register: bootstrap_facts\n  become: false\n\n- name: Set bootstrap distribution and major version facts\n  ansible.builtin.set_fact:\n    bootstrap_distribution: "{{ lookup(\'community.general.json_query\', bootstrap_facts.stdout, map_keys=true)[\'ID\'] }}"\n    bootstrap_distribution_major_version: "{{ lookup(\'community.general.json_query\', bootstrap_facts.stdout, map_keys=true)[\'VERSION_ID\'].split(\'.\')[0] }}"\n  when:\n    - bootstrap_facts.rc == 0\n    - bootstrap_distribution is undefined\n    - bootstrap_facts.stdout | regex_search(\'^PRETTY_NAME.*{{ bootstrap_search[bootstrap_os_family_map[item]].pattern }}\', \'multiline\')\n  loop: "{{ bootstrap_os_family_map.keys() }}"\n  loop_control:\n    label: "{{ item }}"\n  become: false\n\n- name: Determine bootstrap OS family\n  ansible.builtin.set_fact:\n    bootstrap_os_family: "{{ item.key }}"\n  when: bootstrap_distribution in item.value\n  loop: "{{ bootstrap_os_family_map.items() }}"\n  become: false' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-14T07:16:48.009000657Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4557074962, 'load_duration': 90829161, 'prompt_eval_count': 561, 'prompt_eval_duration': 279167530, 'eval_count': 226, 'eval_duration': 4181554702, 'model_name': 'qwen2.5:14b'} id='run--503c2cca-bb9a-44a9-b8b4-8af509dd1eed-0' usage_metadata={'input_tokens': 561, 'output_tokens': 226, 'total_tokens': 787}
