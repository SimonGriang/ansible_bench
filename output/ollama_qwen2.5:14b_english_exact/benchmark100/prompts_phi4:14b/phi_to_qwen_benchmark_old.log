---
- name: Check if Java certificates exist on the system
  stat:
    path: "{{ item }}"
  register: java_certificates
  with_items:
    - /usr/java/jdk1.8.0_281-amd64/jre/lib/security/cacerts
    - /usr/java/jdk11.0.10-amd64/lib/security/cacerts

- name: Fail the playbook if any Java certificate is missing
  fail:
    msg: "Java certificate {{ item.item }} is missing."
  when: item.stat.exists == False
  with_items: "{{ java_certificates.results }}"

- name: Set keystore directory variables for Java versions less than 11
  set_fact:
    keystore_dir: /usr/java/jdk1.8.0_281-amd64/jre/lib/security
  when: ansible_local.java.version < '11'

- name: Set keystore directory variables for Java versions 11 and above
  set_fact:
    keystore_dir: /usr/java/jdk11.0.10-amd64/lib/security
  when: ansible_local.java.version >= '11'

- name: Import SSL certificates into the Java keystore
  java_cert:
    path: "{{ item.path }}"
    keystore: "{{ item.keystore }}"
    alias: "{{ item.alias }}"
    storepass: "{{ item.storepass }}"
    action: import
    state: present
  with_items:
    - { path: /etc/ssl/certs/mycert.cer, keystore: "{{ keystore_dir }}/cacerts", alias: mycert, storepass: changeit }

