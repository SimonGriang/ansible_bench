        key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}
        state: present

    - name: Install the EPEL release package
      ansible_builtin_package:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache

    - name: Optionally install the EPEL next-release package
      ansible_builtin_package:
        name: "{{ epel_next_url }}"
        state: present
      when: epel_next | bool

  when:
    - ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2'
    - (ansible_distribution == 'RedHat' or (ansible_os_family == 'RedHat' and ansible_distribution != 'Amazon')) and ansible_distribution_major_version in ['7', '8', '9']

  become: yes

  handlers:
    - name: Update package cache
      ansible.builtin.meta:
        name: flush_handlers

