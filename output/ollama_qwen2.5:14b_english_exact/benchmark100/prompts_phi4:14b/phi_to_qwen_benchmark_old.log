---
- name: Create a directory for SSH keys if user management is enabled.
  ansible.builtin.file:
    path: /etc/ssh_keys
    state: directory
    mode: '0700'
  when: user_management_enabled

- name: Manage user accounts, ensuring they are created or updated with specified parameters.
  ansible.builtin.user:
    name: "{{ item.username }}"
    state: "{{ item.state }}"
    comment: "{{ item.comment }}"
    home: "{{ item.home_directory }}"
    shell: "{{ item.shell }}"
    groups: "{{ item.groups | join(',') }}"
  loop: "{{ users }}"
  register: user_management_result

- name: Set sudo privileges for users if specified in their configuration.
  ansible.builtin.template:
    src: templates/sudoers.j2
    dest: /etc/sudoers.d/{{ item.username }}
    mode: '0440'
  loop: "{{ users }}"
  when: item.sudo_options is defined and item.sudo_options | length > 0

- name: Remove sudo privileges for users if not specified in their configuration.
  ansible.builtin.file:
    path: /etc/sudoers.d/{{ item.username }}
    state: absent
  loop: "{{ users }}"
  when: item.sudo_options is not defined

- name: Generate a private SSH key for users who require SSH key management.
  ansible.builtin.command: ssh-keygen -q -N '' -f /etc/ssh_keys/{{ item.username }} -t rsa
  loop: "{{ users }}"
  args:
    creates: /etc/ssh_keys/{{ item.username }}
  when: item.ssh_key_management_enabled

- name: Generate a public SSH key for users who require SSH key management.
  ansible.builtin.command: ssh-keygen -y -f /etc/ssh_keys/{{ item.username }} > /etc/ssh_keys/{{ item.username }}.pub
  loop: "{{ users }}"
  args:
    creates: /etc/ssh_keys/{{ item.username }}.pub
  when: item.ssh_key_management_enabled

- name: Convert the SSH key to a PPK format for users who require SSH key management.
  ansible.builtin.command: puttygen /etc/ssh_keys/{{ item.username }} -o /etc/ssh_keys/{{ item.username }}.ppk -O private
  loop: "{{ users }}"
  args:
    creates: /etc/ssh_keys/{{ item.username }}.ppk
  when: item.ssh_key_management_enabled

- name: Determine the home directory for users, defaulting to /home if the user is not found.
  ansible.builtin.stat:
    path: "/home/{{ item.username }}"
  register: home_directory_check
  loop: "{{ users }}"
  when: item.home_directory == "" or item.home_directory is not defined

- name: Create an .ssh directory in the user's home directory if SSH key management is enabled or private keys need to be set.
  ansible.builtin.file:
    path: "{{ item.home_directory }}/.ssh"
    state: directory
    mode: '0700'
  loop: "{{ users }}"
  when: item.ssh_key_management_enabled or item.private_keys is defined
  register: ssh_directory_creation

- name: Deploy authorized SSH keys for users if specified.
  ansible.builtin.lineinfile:
    path: "{{ item.home_directory }}/.ssh/authorized_keys"
    line: "{{ lookup('file', '/etc/ssh_keys/' ~ item.username ~ '.pub') }}"
    create: yes
    mode: '0600'
  loop: "{{ users }}"
  when: item.authorized_keys is defined and item.authorized_keys | length > 0

- name: Remove unauthorized SSH keys from users if specified.
  ansible.builtin.lineinfile:
    path: "{{ item.home_directory }}/.ssh/authorized_keys"
    line: "{{ lookup('file', '/etc/ssh_keys/' ~ item.username ~ '.pub') }}"
    state: absent
  loop: "{{ users }}"
  when: item.unauthorized_keys is defined and item.unauthorized_keys | length > 0

- name: Copy generated private SSH keys to the user's .ssh directory if specified.
  ansible.builtin.copy:
    src: "/etc/ssh_keys/{{ item.username }}"
    dest: "{{ item.home_directory }}/.ssh/id_rsa"
    mode: '0600'
  loop: "{{ users }}"
  when: item.copy_private_key is defined and item.copy_private_key

- name: Check the password validity period for users.
  ansible.builtin.shell: awk -F: '($1 == "{{ item.username }}") {print $3}' /etc/shadow
  register: password_validity_check
  loop: "{{ users }}"
  changed_when: false

- name: Set the password validity period for users if a specific duration is defined.
  ansible.builtin.shell: chage -M {{ item.password_validity_days }} {{ item.username }}
  loop: "{{ users }}"
  when: item.password_validity_days is defined and password_validity_check.stdout != item.password_validity_days

- name: Place additional private key files in the user's .ssh directory if specified.
  ansible.builtin.copy:
    src: "{{ item.private_key_path }}"
    dest: "{{ item.home_directory }}/.ssh/"
    mode: '0600'
  loop: "{{ users }}"
  when: item.private_key_path is defined

