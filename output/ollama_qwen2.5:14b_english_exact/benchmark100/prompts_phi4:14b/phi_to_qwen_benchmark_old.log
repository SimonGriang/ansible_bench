---
- name: Check if the Helm binary exists at the specified path
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Retrieve the current Helm version installed on the system
  command: "{{ helm_bin_path }}/helm version --client"
  failed_when: false
  changed_when: false
  register: helm_existing_version

- name: Download the specified version of Helm if it does not exist or if the version is outdated
  unarchive:
    src: "{{ helm_repo_path }}/helm-v{{ helm_version }}-linux-amd64.tar.gz"
    dest: /tmp
    remote_src: yes
  when: helm_check.stat.exists == False or helm_existing_version.stdout is search("Version: v{{ helm_version }}") == False
  register: helm_download

- name: Install the downloaded Helm binary in the appropriate location
  copy:
    src: /tmp/linux-amd64/helm
    dest: "{{ helm_bin_path }}"
    mode: 0755
  become: true
  when: helm_download is changed

