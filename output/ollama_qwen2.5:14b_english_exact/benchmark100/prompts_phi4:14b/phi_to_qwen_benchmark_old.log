      when: rke2_airgap_mode and rke2_airgap_implementation != 'exists' and rke2_airgap_copy_additional_tarballs|length > 0

- name: Ensure artifacts exist and have acceptable permissions in airgap mode with 'exists' implementation
  block:
    - name: Ensure RKE2 artifacts exist
      file:
        path: "{{ item.dest }}"
        state: file
        mode: '0644'
      loop: "{{ rke2_artifacts }}"
      when: rke2_airgap_mode and rke2_airgap_implementation == 'exists'

    - name: Ensure RKE2 installation script is executable
      file:
        path: "{{ rke2_installer_path }}"
        mode: '0755'
      when: rke2_airgap_mode and rke2_airgap_implementation == 'exists'

- name: Populate service facts to gather information about system services
  ansible.builtin.setup:
    filter: service.*
  register: service_facts
  changed_when: false

- name: Get filesystem statistics for the /usr/local directory
  ansible.builtin.stat:
    path: /usr/local
  register: filesystem_stat
  changed_when: false

- name: Check if /usr/local is on a separate partition
  ansible.builtin.shell: "grep /usr/local /proc/mounts | grep -v '^ /usr/local '"
  register: is_usr_local_on_separate_partition
  changed_when: false

- name: Determine the RKE2 binary path based on filesystem checks
  ansible.builtin.set_fact:
    rke2_binary_path: "{{ rke2_binary_path_usrlib }}"
  when: not filesystem_stat.stat.isdir or is_usr_local_on_separate_partition.stdout_lines|length > 0
  vars:
    rke2_binary_path_usrlib: /usr/local/bin/rke2

- name: Check the installed and running RKE2 versions
  ansible.builtin.shell: "if [ -x {{ rke2_binary_path }} ]; then {{ rke2_binary_path }} version; fi"
  register: rke2_version
  changed_when: false

- name: Set RKE2 version facts based on the version check results
  ansible.builtin.set_fact:
    rke2_installed_version: "{{ rke2_version.stdout|from_json|json_query('Server.Version') }}"
    rke2_running_version: "{{ rke2_version.stdout|from_json|json_query('Server.Version') }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade unless explicitly allowed
  ansible.builtin.assert:
    that:
      - rke2_running_version is not defined or rke2_running_version >= rke2_version_required
    msg: "RKE2 downgrade is not allowed unless explicitly permitted."
  when: rke2_running_version is defined and rke2_running_version < rke2_version_required

- name: Run RKE2 install script if the version needs to be updated
  block:
    - name: Set environment variables for RKE2 installation
      ansible.builtin.set_fact:
        rke2_install_env: "{{ 'RKE2_VERSION=' + rke2_version_required + ' ' + rke2_installer_path }}"

    - name: Run RKE2 install script
      ansible.builtin.shell: "{{ rke2_install_env }} {{ rke2_installer_path }} install"
      register: rke2_install
      changed_when: true
  when: rke2_running_version is not defined or rke2_running_version < rke2_version_required

- name: Copy custom manifests if they are defined
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_manifests_dir }}"
    mode: '0644'
    force: true
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests|length > 0

- name: Copy static pods if they are defined
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_dir }}"
    mode: '0644'
    force: true
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods|length > 0

- name: Copy RKE2 environment file if environment options are defined
  ansible.builtin.copy:
    src: "{{ rke2_environment_file }}"
    dest: "{{ rke2_environment_dest }}"
    mode: '0644'
    force: true
  when: rke2_environment_file is defined and rke2_environment_file != ""
  # Ensuring a newline at the end of the file


