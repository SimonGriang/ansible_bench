---
- import_tasks: assert.yml
  delegate_to: localhost
  when: ansible_facts is defined

- name: Install Python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  block:
    - lineinfile:
        dest: /etc/pip.conf
        line: "index-url = {{ python_pip_proxy }}"
        regexp: "^index-url\s*="
        state: present
      when: python_pip_proxy is defined

- name: Set trusted hosts for pip
  block:
    - lineinfile:
        dest: /etc/pip.conf
        line: "trusted-host = {{ python_pip_trusted_host }}"
        regexp: "^trusted-host\s*="
        state: present
      when: python_pip_trusted_host is defined

- name: Update pip to the latest version
  pip:
    name: "{{ python_pip_pip_package }}"
    state: latest
  when: python_pip_update | bool and ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

- name: Install requested Python pip modules
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when: ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

