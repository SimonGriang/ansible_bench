---
- name: Determine the package state based on the installation method
  set_fact:
    ansible_package_state: "{{ 'present' if ansible_facts['distribution'] is search('RedHat|Fedora|Debian|Ubuntu') else 'absent' }}"

- name: Setup Ansible on RedHat systems, excluding Fedora, using the package manager
  when: ansible_facts['distribution'] == 'RedHat' and ansible_package_state == 'present'
  yum:
    name: ansible
    state: present

- name: Setup Ansible on Fedora using the package manager
  when: ansible_facts['distribution'] == 'Fedora' and ansible_package_state == 'present'
  dnf:
    name: ansible
    state: present

- name: Setup Ansible on Ubuntu using the package manager
  when: ansible_facts['distribution'] == 'Ubuntu' and ansible_package_state == 'present'
  apt:
    name: ansible
    state: present

- name: Setup Ansible on Debian using the package manager
  when: ansible_facts['distribution'] == 'Debian' and ansible_package_state == 'present'
  apt:
    name: ansible
    state: present

- name: Setup Ansible using Pip
  when: ansible_package_state == 'absent'
  pip:
    name: ansible
    state: present

