---
- name: Install EPEL repository
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present
  when: ansible_os_family == 'RedHat' and ansible_distribution_version in ['7', '8', '9', '10'] or ansible_os_family == 'Amazon'
  notify: Update package cache

- name: Install EPEL-release package
  ansible.builtin.package:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Optionally install EPEL-next-release package
  ansible.builtin.package:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next | default(false)
  notify: Update package cache

- name: Install EPEL GPG key
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present
  notify: Update package cache

