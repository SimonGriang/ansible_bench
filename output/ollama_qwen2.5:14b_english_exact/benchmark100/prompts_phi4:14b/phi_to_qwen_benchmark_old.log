    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_data_directories }}"

- name: Generate a TLS key and certificate for Vault
  shell: >
    openssl req -new -newkey rsa:2048 -days 365 -nodes -x509 -subj "/C=US/ST=California/L=San Francisco/O=HashiCorp/CN=vault" -keyout {{ vault_path }}/data/tls/{{ item.key }} -out {{ vault_path }}/data/tls/{{ item.certificate }}
  loop: "{{ vault_tls }}"
  notify: Restart Vault

- name: Set ownership of TLS files
  file:
    path: "{{ vault_path }}/data/tls/{{ item.key }}"
    mode: '0644'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_tls_files }}"

- name: Copy the Vault binary to the appropriate location
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
    owner: root
    group: root
  notify: Restart Vault

- name: Set specific capabilities on the Vault binary
  file:
    path: "{{ vault_path }}/usr/bin/vault"
    attributes: cap_ipc_lock=ep

- name: Create a vault environment file
  copy:
    dest: "{{ vault_path }}/etc/vault.d/vault.env"
    mode: '0644'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    content: |
      VAULT_ADDR=http://127.0.0.1:8200
      VAULT_API_ADDR=http://127.0.0.1:8200
      VAULT_DEV_ROOT_TOKEN_ID=root
      VAULT_DEV_LISTEN_ADDRESS=127.0.0.1:8200
    preserve: true
  notify: Restart Vault

- name: Ensure the systemd system directory exists
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy the Vault service file for systemd
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: '0644'
    owner: root
    group: root
  when: ansible_systemd is defined
  notify: Reload Systemd

- name: Copy the Vault configuration file
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: '0644'
    owner: root
    group: root
  notify: Restart Vault

- name: Flush handlers to apply changes
  meta: flush_handlers

