---
- name: Create document root directories for Apache virtual hosts
  file:
    state: directory
    path: "{{ item.documentroot }}"
  loop: "{{ httpd_vhosts|default([]) }}"
  when:
    - httpd_vhosts|length > 0
    - item.documentroot is defined
    - item.create_docroot is not defined or item.create_docroot|bool

- name: Configure Apache virtual hosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ httpd_vhosts|default([]) }}"
  notify: Test httpd configuration validity
  notify: Restart httpd
  when:
    - httpd_vhosts|length > 0
    - item.name is defined

