- import_tasks: assert.yml
  delegate_to: localhost

- name: Install docker-compose package
  apt:
    name: docker-compose
    state: present
  when: docker_compose_installation_type == "package"

- name: Install docker-compose as a binary
  block:
    - name: Ensure required packages are installed
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ docker_compose_binary_required_packages }}"
      when: docker_compose_installation_type == "binary"

    - name: Download and install docker-compose binary
      get_url:
        url: "{{ docker_compose_url }}"
        dest: /usr/local/bin/docker-compose
        mode: '0755'
      when: docker_compose_installation_type == "binary"

