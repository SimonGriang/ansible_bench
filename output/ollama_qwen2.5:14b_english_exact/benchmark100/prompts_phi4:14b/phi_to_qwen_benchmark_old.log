---
- import_tasks: assert.yml
  vars:
    ansible_python_interpreter: auto
  remote_addr: localhost

- name: Install required packages for OpenSSL
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_requirements | default([]) }}"

- name: Install pip packages if the list openssl_pip_packages is not empty
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_pip_packages | default([]) }}"
  when: openssl_pip_packages | length > 0

- name: Create a directory for OpenSSL keys
  file:
    path: /etc/ssl/private
    state: directory
    mode: '0700'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create a directory for OpenSSL CSRs
  file:
    path: /etc/ssl/csr
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create a directory for OpenSSL certificates
  file:
    path: /etc/ssl/certs
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include the create.yml task file for each item in openssl_items
  include_tasks: create.yml
  loop: "{{ openssl_items | default([]) }}"
  when: openssl_items | length > 0

