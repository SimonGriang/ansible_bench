---
- name: Import assert.yml task
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ service_required_packages }}"
    state: present
  notify: Gather facts

- name: Configure systemd service templates
  template:
    src: systemd.j2
    dest: /etc/systemd/system/{{ item.name }}.service
    mode: 0644
  when: service_manager == 'systemd'
  with_items: "{{ service_list }}"
  notify: Systemctl daemon-reload

- name: Configure sysvinit service templates
  template:
    src: sysvinit.j2
    dest: /etc/init.d/{{ item.name }}
    mode: 0755
  when: service_manager in ['sysvinit', 'upstart', 'openrc']
  with_items: "{{ service_list }}"

- name: Manage state and enablement of services
  systemd:
    name: "{{ item.name }}"
    state: "{{ item.state|default('started') }}"
    enabled: "{{ item.enabled|default('yes')|bool }}"
  when: item.state is defined or item.enabled is defined
  with_items: "{{ service_list }}"

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

