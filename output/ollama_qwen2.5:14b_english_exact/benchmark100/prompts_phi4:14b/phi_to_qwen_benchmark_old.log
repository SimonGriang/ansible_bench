---
- name: Install EPEL repository on supported Red Hat-based systems
  block:
    - name: Add the EPEL GPG key
      ansible.builtin.rpm_key:
        key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}
        state: present

    - name: Install the EPEL release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache

    - name: Optionally install the EPEL next-release package
      ansible.builtin.package:
        name: "{{ epel_next_url }}"
        state: present
      when: epel_next | default(false)

  when:
    - ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2'
    - ansible_distribution == 'RedHat' and (ansible_distribution_major_version == '7' or ansible_distribution_major_version == '8' or ansible_distribution_major_version == '9')

  become: yes

- name: Install EPEL repository on supported Red Hat-based systems
  block:
    - name: Add the EPEL GPG key
      ansible.builtin.rpm_key:
        key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}
        state: present

    - name: Install the EPEL release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache

    - name: Optionally install the EPEL next-release package
      ansible.builtin.package:
        name: "{{ epel_next_url }}"
        state: present
      when: epel_next | default(false)

  when:
    - ansible_os_family == 'RedHat' and (ansible_distribution == 'CentOS' or ansible_distribution == 'Oracle')
    - (ansible_distribution_major_version == '7' or ansible_distribution_major_version == '8' or ansible_distribution_major_version == '9')

  become: yes

  handlers:
    - name: Update package cache
      ansible.builtin.meta: flush_handlers

