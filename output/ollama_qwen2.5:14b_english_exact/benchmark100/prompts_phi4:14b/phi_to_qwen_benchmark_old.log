pt_eval_duration': 538948466, 'eval_count': 1006, 'eval_duration': 21462418666, 'model_name': 'qwen2.5:14b'} id='run--75112ddf-01bc-4f6f-80a0-be258092b08c-0' usage_metadata={'input_tokens': 1088, 'output_tokens': 1006, 'total_tokens': 2094}
