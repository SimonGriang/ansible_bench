me: Create MySQL users\n  mysql_user:\n    name: "{{ item.name }}"\n    host: "{{ item.host }}"\n    password: "{{ item.password }}"\n    priv: "{{ item.privileges }}"\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n  with_items: "{{ mysql_users }}"\n  register: created_users\n  ignore_errors: yes\n\n- name: Flush handlers again\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-14T07:07:21.816853609Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11375770549, 'load_duration': 93209039, 'prompt_eval_count': 745, 'prompt_eval_duration': 350502611, 'eval_count': 580, 'eval_duration': 10921901897, 'model_name': 'qwen2.5:14b'} id='run--a1141ad6-ea3f-4ab3-b4ad-5758bb2eabc2-0' usage_metadata={'input_tokens': 745, 'output_tokens': 580, 'total_tokens': 1325}
