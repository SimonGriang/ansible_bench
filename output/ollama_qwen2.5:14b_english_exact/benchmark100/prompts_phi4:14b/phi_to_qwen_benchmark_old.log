---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install DNS-related packages
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create necessary directories for DNS configuration and data
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create group for DNS service
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user for the DNS service
  user:
    name: "{{ dns_owner }}"
    state: present
    system: yes

- name: Generate the rndc key for DNS configuration
  command: "rndc-confgen -a -k rndc.key -p 953"
  args:
    creates: "/etc/named/rndc.key"
  register: rndc_key

- name: Set file permissions for the rndc key
  file:
    path: "/etc/named/rndc.key"
    mode: '0640'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"

- name: Download the root hints file if DNS caching is enabled
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ dns_confdir }}/db.root"
    mode: '0644'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_cache_enabled | bool
  notify: Rndc reload

- name: Create primary zone files from templates
  template:
    src: "zones/{{ item.name }}.j2"
    dest: "{{ dns_datadir }}/{{ item.name }}"
    mode: '0644'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  with_items: "{{ dns_zones }}"
  register: zone_files
  notify: Rndc reload
  when: item.type == "primary"
  changed_when: "'Validation succeeded' in named_checkzone.stdout"

- name: Add DNS zones to the main configuration file
  template:
    src: "named.conf.j2"
    dest: "{{ dns_confdir }}/named.conf"
    mode: '0644'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  notify: DNS service restart
  changed_when: "'Syntax check succeeded' in named_checkconf.stdout"

- name: Create systemd service override if using systemd
  block:
    - name: Create systemd service override directory
      file:
        path: "/etc/systemd/system/{{ dns_service }}.d"
        state: directory
        mode: '0755'
        owner: root
        group: root

    - name: Copy override.conf file
      copy:
        src: "systemd/override.conf"
        dest: "/etc/systemd/system/{{ dns_service }}.d/override.conf"
        mode: '0644'
        owner: root
        group: root

    - name: Reload systemd
      command: systemctl daemon-reload
  when: "'systemd' in ansible_service_manager"

- name: Start and enable the DNS service
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: yes

