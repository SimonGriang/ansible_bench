---
- name: Create the RKE2 configuration directory with appropriate permissions
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_node_type == 'server'

- name: Set agent node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_node_type == 'agent'

- name: Deploy the RKE2 configuration file
  copy:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed

- name: Deploy the kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed
  when: rke2_kubelet_config is defined

- name: Deploy the Containerd registry configuration file
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed
  when: rke2_custom_registry_config is defined

- name: Start the RKE2 service on all nodes
  systemd:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: yes
    masked: no
    daemon_reload: yes
    environment: "RKE2_TOKEN={{ rke2_token }}"
    max_retries: 10
    delay_start: 3
  notify: Service (re)started

- name: Mask other RKE2 services on non-applicable nodes
  systemd:
    name: "{{ item }}"
    state: masked
    enabled: no
    masked: yes
  loop:
    - rke2-agent.service
    - rke2-server.service
  when: rke2_node_type != item.split('.')[1]

- name: Verify node readiness without CNI
  shell: >
    kubectl get nodes --no-headers -o custom-columns=STATUS:.status.conditions[?(@.type=="Ready")].status | grep -v 'Unknown' | grep -v 'False' | wc -l &&
    kubectl get nodes --no-headers -o custom-columns=STATUS:.status.conditions[?(@.type=="MemoryPressure")].status | grep -v 'True' | wc -l &&
    kubectl get nodes --no-headers -o custom-columns=STATUS:.status.conditions[?(@.type=="DiskPressure")].status | grep -v 'True' | wc -l &&
    kubectl get nodes --no-headers -o custom-columns=STATUS:.status.conditions[?(@.type=="PIDPressure")].status | grep -v 'True' | wc -l
  register: node_readiness
  retries: 100
  delay: 15
  until: node_readiness.stdout | int >= 1
  when: rke2_is_active_server or (rke2_node_type == 'server' and rke2_is_first_server)
  check_mode: no

- name: Verify node readiness with CNI
  shell: >
    kubectl get nodes --no-headers -o custom-columns=STATUS:.status.conditions[?(@.type=="Ready")].status | grep -v 'Unknown' | grep -v 'False' | wc -l
  register: cni_node_readiness
  retries: 100
  delay: 15
  until: cni_node_readiness.stdout | int >= rke2_expected_node_count
  when: rke2_is_active_server and rke2_node_type == 'server'
  check_mode: no

- name: Ensure the file has a newline at the end


