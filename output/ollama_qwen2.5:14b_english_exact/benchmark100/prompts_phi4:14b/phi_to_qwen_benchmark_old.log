---
- name: Generate SSL private key files for each item
  community.crypto.openssl_privatekey:
    path: "{{ item.path }}"
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"
  vars:
    ssl_items:
      - path: /etc/ssl/private/private.key
        mode: '0600'
        owner: 'root'
        group: 'root'
      - path: /etc/ssl/private/private2.key
        mode: '0600'
        owner: 'root'
        group: 'root'

- name: Generate SSL CSR (Certificate Signing Request) files for each item
  community.crypto.openssl_csr:
    path: "{{ item.path }}"
    privatekey_path: "{{ item.privatekey_path }}"
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    common_name: "{{ item.common_name }}"
  loop: "{{ csr_items }}"
  vars:
    csr_items:
      - path: /etc/ssl/csr/csr.csr
        privatekey_path: /etc/ssl/private/private.key
        mode: '0600'
        owner: 'root'
        group: 'root'
        common_name: 'example.com'
      - path: /etc/ssl/csr/csr2.csr
        privatekey_path: /etc/ssl/private/private2.key
        mode: '0600'
        owner: 'root'
        group: 'root'
        common_name: 'example2.com'

- name: Generate SSL certificates for each item
  community.crypto.x509_certificate:
    path: "{{ item.path }}"
    privatekey_path: "{{ item.privatekey_path }}"
    csr_path: "{{ item.csr_path }}"
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    valid_from: '365 days'
  loop: "{{ cert_items }}"
  vars:
    cert_items:
      - path: /etc/ssl/certs/cert.crt
        privatekey_path: /etc/ssl/private/private.key
        csr_path: /etc/ssl/csr/csr.csr
        mode: '0600'
        owner: 'root'
        group: 'root'
      - path: /etc/ssl/certs/cert2.crt
        privatekey_path: /etc/ssl/private/private2.key
        csr_path: /etc/ssl/csr/csr2.csr
        mode: '0600'
        owner: 'root'
        group: 'root'

- name: Create PKCS#12 files for each item
  community.crypto.openssl_pkcs12:
    path: "{{ item.path }}"
    export_privatekey: yes
    export_chain: no
    certificate: "{{ item.certificate }}"
    privatekey: "{{ item.privatekey }}"
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    friendly_name: "{{ item.friendly_name }}"
  loop: "{{ pkcs12_items }}"
  vars:
    pkcs12_items:
      - path: /etc/ssl/pkcs12/pkcs12.p12
        certificate: /etc/ssl/certs/cert.crt
        privatekey: /etc/ssl/private/private.key
        mode: '0600'
        owner: 'root'
        group: 'root'
        friendly_name: 'example.com'
      - path: /etc/ssl/pkcs12/pkcs122.p12
        certificate: /etc/ssl/certs/cert2.crt
        privatekey: /etc/ssl/private/private2.key
        mode: '0600'
        owner: 'root'
        group: 'root'
        friendly_name: 'example2.com'

- name: Read and register the content of the private key files for each item
  ansible.builtin.slurp:
    src: "{{ item.path }}"
  loop: "{{ ssl_items }}"
  register: private_keys

- name: Read and register the content of the certificate files for each item
  ansible.builtin.slurp:
    src: "{{ item.path }}"
  loop: "{{ cert_items }}"
  register: certificates

- name: Combine the registered private key and certificate content into a single file for each item
  ansible.builtin.copy:
    content: "{{ private_keys.results[item.i].stdout + certificates.results[item.i].stdout }}"
    dest: "{{ item.path }}"
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ cert_items }}"
  vars:
    cert_items:
      - path: /etc/ssl/combined/combined.crt
        mode: '0600'
        owner: 'root'
        group: 'root'
      - path: /etc/ssl/combined/combined2.crt
        mode: '0600'
        owner: 'root'
        group: 'root'

