- name: Cordon and Drain the node during RKE2 upgrade
  shell: kubectl cordon "{{ rke2_node_name }}" && kubectl drain "{{ rke2_node_name }}" --ignore-daemonsets --delete-local-data --force
  register: drain_result
  retries: 100
  delay: 15
  when: rke2_drain_node_during_upgrade
  delegate_to: "{{ inventory_hostname }}"
  run_once: true

- name: Restart the RKE2 service on the node
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started
  when: rke2_drain_node_during_upgrade

- name: Wait for all nodes to be ready again
  shell: kubectl get nodes -l rke2-cluster-group={{ rke2_cluster_group_name }} -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{","}{end}' | grep -E '^(Ready,)+$'
  register: nodes_ready
  retries: 100
  delay: 15
  delegate_to: "{{ inventory_hostname }}"
  run_once: true

- name: Uncordon the node after the upgrade
  shell: kubectl uncordon "{{ rke2_node_name }}"
  when: rke2_drain_node_during_upgrade
  delegate_to: "{{ inventory_hostname }}"
  run_once: true

- name: Wait for all pods to be ready again
  shell: kubectl get pods -o json | jq -r '.items | map(select(.status.phase != "Running" and .status.phase != "Succeeded")) | length' | grep '^0$'
  register: pods_ready
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready
  delegate_to: "{{ inventory_hostname }}"
  run_once: true

- name: Wait for all pods to pass readiness checks
  shell: kubectl wait --for=condition=ready --timeout=15s "{{ rke2_wait_for_all_pods_to_be_healthy_args }}"
  register: pods_healthy
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy
  delegate_to: "{{ inventory_hostname }}"
  run_once: true


