n    owner: root\n    group: root\n    mode: 0644\n  notify: restart openvpn' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-14T07:17:54.899981262Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13373374093, 'load_duration': 102531281, 'prompt_eval_count': 856, 'prompt_eval_duration': 471571946, 'eval_count': 589, 'eval_duration': 12785684827, 'model_name': 'qwen2.5:14b'} id='run--d2f01800-5c99-456b-b99e-f2804586bb29-0' usage_metadata={'input_tokens': 856, 'output_tokens': 589, 'total_tokens': 1445}
