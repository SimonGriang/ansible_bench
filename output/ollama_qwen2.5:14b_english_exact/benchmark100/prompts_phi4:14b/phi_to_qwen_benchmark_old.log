---
- name: Task 1: Check if all necessary variables have been set correctly
  import_tasks: check_variables.yml
  delegate_to: localhost
  run_once: true

- name: Task 2: Wait for the host to become available if specified in the configuration
  wait_for:
    port: 22
    timeout: 30
  when: connection != 'docker' and wait_for_host_enabled
  connection: local
  become: false

- name: Task 3: Prepare the system by ensuring connectivity and installing necessary packages
  block:
    - name: Test the connection to the host
      shell: echo > /dev/tcp/{{ ansible_host }}/22
      register: connection_test_result
      failed_when: connection_test_result is not defined
      changed_when: false
      when: connection != 'docker' and wait_for_host_enabled

    - name: Provide debug message if connection fails
      debug:
        msg: "Connection failed with a timeout of {{ timeout_value }}"
      when: connection_test_result is failed

    - name: Gather facts
      ansible_facts: {}
      when: ansible_facts is not defined

    - name: Install necessary packages using raw command
      raw: "{{ raw_package_command }}"
      when: ansible_os_family == 'RedHat' and raw_package_command is defined

    - name: Install necessary packages using Ansible's package module
      package:
        name: "{{ ansible_package_name }}"
        state: present
      when: ansible_os_family == 'Debian' and ansible_package_name is defined
  when: become_enabled

- name: Task 4: Ensure the system is fully prepared by executing necessary Ansible modules
  block:
    - name: Gather Ansible facts
      ansible_facts: {}

    - name: Install required packages
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ ansible_required_packages }}"
  when: become_enabled

