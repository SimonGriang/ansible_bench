---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ selinux_requirements[:8] }}"
  notify: Gather facts
  loop_control:
    extended: yes
  when: "'9' in selinux_requirements | map('community.general.item_index') | list"

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ selinux_requirements[8:] }}"
  notify: Gather facts
  loop_control:
    extended: yes
  when: "'9' in selinux_requirements | map('community.general.item_index') | list"

- name: Flush handlers
  meta: flush_handlers

- name: Configure SELinux
  block:
    - name: Manage SELinux
      set_fact:
        selinux_status: "{{ ansible_selinux.status }}"
      when: ansible_selinux.status is defined and ansible_connection not in ['container', 'docker', 'community.docker.docker']
      notify: Reboot

    - name: Manage SELinux booleans
      seboolean:
        name: "{{ item.key }}"
        state: "{{ item.value.state }}"
        persistent: "{{ item.value.persistent }}"
      loop: "{{ selinux_booleans | dict2items }}"
      loop_control:
        label: "{{ item.key }}"
      when: selinux_booleans is defined
