---
- name: Check if Java certificates exist on the system
  stat:
    path: "{{ item }}"
  loop: "{{ java_certificates }}"
  register: java_certificates_check

- name: Fail the playbook if any Java certificate is missing
  fail:
    msg: "Java certificate {{ item.item }} is missing."
  when: not item.stat.exists
  loop: "{{ java_certificates_check.results }}"

- name: Set keystore directory variables for Java versions less than 11
  set_fact:
    keystore_dir: "/usr/java/jdk1.8.0_{{ java_version }}/jre/lib/security"
  when: java_major_version < 11

- name: Set keystore directory variables for Java versions 11 and above
  set_fact:
    keystore_dir: "/usr/java/jdk-{{ java_version }}/lib/security"
  when: java_major_version >= 11

- name: Import SSL certificates into the Java keystore
  java_cert:
    action: import
    alias: "{{ item.alias }}"
    cert_file: "{{ item.cert_file }}"
    keystore: "{{ keystore_dir }}/{{ keystore_file }}"
    keystore_password: "{{ keystore_password }}"
  loop: "{{ java_certificates }}"
  register: java_keystore_import_results
  when: item.exists == true
  loop_control:
    extended: true

