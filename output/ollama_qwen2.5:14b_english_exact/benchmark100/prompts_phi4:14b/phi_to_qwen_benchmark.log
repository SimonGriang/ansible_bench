---
- name: Determine if the system is EFI.
  command: test -d /sys/firmware/efi
  register: is_efi
  changed_when: false
  failed_when: false

- name: Remove unwanted grub.cfg for EFI systems.
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: is_efi is succeeded

- name: Install a user template for Grub.
  template:
    src: user/grub.cfg.j2
    dest: /etc/grub.d/40_custom
    owner: root
    group: root
    mode: '0755'
  notify: update-grub

- name: Add a password to the EFI Grub configuration.
  lineinfile:
    path: /etc/grub2-efi.cfg
    regexp: '^set superusers="root"'
    line: 'set superusers="root"\npassword_pbkdf2 root {{ grub_password_hash }}'
    insertafter: '^set superusers="root"'
    backup: yes
  when: is_efi is succeeded
  notify: update-grub

- name: Add a password to the MBR Grub configuration.
  lineinfile:
    path: /etc/grub2.cfg
    regexp: '^set superusers="root"'
    line: 'set superusers="root"\npassword_pbkdf2 root {{ grub_password_hash }}'
    insertafter: '^set superusers="root"'
    backup: yes
  when: is_efi is failed
  notify: update-grub

- name: Modify files to add --unrestricted class.
  lineinfile:
    path: "{{ item }}"
    regexp: '(^CLASS=)(.+?)$'
    line: '\g<1>\g<2> --unrestricted'
    insertafter: '^CLASS='
    backup: yes
  with_items:
    - /etc/grub.d/10_linux
    - /etc/grub.d/30_os-prober
  notify: update-grub


