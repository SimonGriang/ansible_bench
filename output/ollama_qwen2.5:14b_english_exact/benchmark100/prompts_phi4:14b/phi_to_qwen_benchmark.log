- Last generated (faulty) playbook:
---
- name: Create necessary directories for cadvisor
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: root
    group: root
  loop:
    - /var/lib/cadvisor
    - /etc/cadvisor
  become: true

- name: Download the cadvisor binary from a specified URL
  get_url:
    url: "{{ cadvisor_url }}"
    checksum: "{{ cadvisor_checksum }}"
    dest: "{{ cadvisor_binary_dir }}/cadvisor"
    mode: '0755'
  when: cadvisor_binary_local_dir is not defined
  become: true

- name: Copy a locally distributed cadvisor binary if available
  copy:
    src: "{{ cadvisor_binary_local_dir }}/cadvisor"
    dest: "{{ cadvisor_binary_dir }}/cadvisor"
    mode: '0755'
    owner: root
    group: root
  notify: restart cadvisor
  when: cadvisor_binary_local_dir is defined

- name: Create a symbolic link to the cadvisor binary
  ansible.builtin.file:
    src: "{{ cadvisor_binary_dir }}/cadvisor"
    dest: /usr/local/bin/cadvisor
    state: link
  become: true

- name: Deploy the systemd service file for the cadvisor server
  ansible.builtin.template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: '0644'
  notify: restart cadvisor

- name: Test if the cadvisor service is active
  shell: systemctl is-active --quiet cadvisor
  register: cadvisor_service_status
  changed_when: false
  failed_when: false

- name: Debug the output of the service activity check
  debug:
    msg: "{{ cadvisor_service_status.stdout }}"

- name: Enable the cadvisor systemd service to start on boot
  ansible.builtin.systemd:
    name: cadvisor
    enabled: true
  become: true

- name: Start the cadvisor systemd service immediately
  ansible.builtin.systemd:
    name: cadvisor
    state: started
    daemon_reload: true
  become: true


