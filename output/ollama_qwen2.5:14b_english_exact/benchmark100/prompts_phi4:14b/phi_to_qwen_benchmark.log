---
- name: Create directory for SSH keys if user management is enabled
  file:
    path: /etc/ssh_keys
    state: directory
    mode: '0700'
  when: user_management_enabled

- name: Manage user accounts
  user:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    comment: "{{ item.comment | default('') }}"
    home: "{{ item.home | default('/home/{{ item.name }}') }}"
    shell: "{{ item.shell | default('/bin/bash') }}"
    groups: "{{ item.groups | default([]) }}"
    append: true
    update_password: 'always'
  loop: "{{ users }}"
  register: user_management_result

- name: Set sudo privileges for users if specified
  template:
    src: "{{ item.user }}.sudoers.j2"
    dest: "/etc/sudoers.d/{{ item.user }}"
    owner: root
    group: root
    mode: '0440'
  loop: "{{ users | selectattr('sudo', 'defined') | list }}"
  when: item.sudo is defined

- name: Remove sudo privileges for users if not specified
  file:
    path: "/etc/sudoers.d/{{ item.user }}"
    state: absent
  loop: "{{ users | selectattr('sudo', 'undefined') | list }}"
  when: item.sudo is undefined

- name: Generate a private SSH key for users who require SSH key management
  ansible.builtin.shell: >
    if [ ! -f /etc/ssh_keys/{{ item.name }}/id_rsa ]; then
      ssh-keygen -q -N "" -t rsa -f /etc/ssh_keys/{{ item.name }}/id_rsa
    fi
  loop: "{{ users | selectattr('ssh_key_management', 'defined') | selectattr('ssh_key_management', 'equalto', true) | list }}"
  register: ssh_key_generation
