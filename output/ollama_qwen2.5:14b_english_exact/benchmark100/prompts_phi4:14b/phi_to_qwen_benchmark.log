---
- name: Create a system group for Vault
  group:
    name: "{{ vault_group }}"
    system: true

- name: Create a system user for Vault
  user:
    name: "{{ vault_user }}"
    group: "{{ vault_group }}"
    shell: "{{ vault_user_shell }}"
    system: true

- name: Create a download directory for Vault
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Download the Vault binary
  unarchive:
    src: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: true
    owner: root
    group: root
    mode: '0755'
    creates: "{{ vault_path }}/usr/bin/vault"

- name: Check if the main Vault directory exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create the main Vault directory if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
  when: not vault_check_path.stat.exists

- name: Create additional directories in the main Vault directory
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_directories }}"

- name: Create data directories for Vault
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_data_directories }}"

- name: Generate a TLS key and certificate for Vault
  command: >
    openssl req -x509 -newkey rsa:4096 -keyout {{ item.key }} -out {{ item.cert }}
    -days 365 -nodes -subj "/CN=vault" -reqexts SAN -extensions SAN
    -config <(cat /etc/ssl/openssl.cnf <(printf "[SAN]\nsubjectAltName=DNS:localhost"))
  args:
    creates: "{{ item.key }}"
  loop: "{{ vault_tls_files }}"
  notify: restart vault

- name: Set ownership of TLS files
  file:
    path: "{{ item.path }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_tls_files }}"

- name: Copy the Vault binary to the appropriate location
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    owner: root
    group: root
    mode: '0755'
  notify: restart vault

- name: Set specific capabilities on the Vault binary
  command: setcap cap_ipc_lock=ep {{ vault_path }}/usr/bin/vault
  args:
    creates: "{{ vault_path }}/usr/bin/vault"

- name: Create a vault environment file
  copy:
    content: |
      VAULT_ADDR=http://127.0.0.1:8200
      VAULT_API_ADDR=http://127.0.0.1:8200
    dest: "{{ vault_path }}/etc/vault.d/vault.env"
    owner: root
    group: root
    mode: '0644'
    attributes: mtime,ctime
  notify: restart vault

- name: Ensure the systemd system directory exists
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy the Vault service file for systemd
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'
  notify: reload systemd

- name: Copy the Vault configuration file
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: '0644'
  notify: restart vault

- name: Flush handlers to apply changes
  meta: flush_handlers


