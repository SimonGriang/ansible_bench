---
- name: Create the RKE2 configuration directory with appropriate permissions
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Set server node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_node_type == "server"

- name: Set agent node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_node_type == "agent"

- name: Deploy the RKE2 configuration file
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed

- name: Deploy the kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: 0600
  when: rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Deploy the Containerd registry configuration file
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: 0600
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_auth | length > 0
  notify: Config file changed

- name: Start the RKE2 service on all nodes
  systemd:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: yes
    daemon_reload: yes
    masked: no
    force_reload: yes
    timeout: 60
    try_restart: yes
    max_retries: 10
    delay_start: 3
  notify: Service (re)started

- name: Mask other RKE2 services on non-applicable nodes
  systemd:
    name: "{{ item }}"
    state: masked
    enabled: no
  loop:
    - rke2-agent.service
    - rke2-server.service
  when: rke2_node_type != "server" and rke2_node_type != "agent"

- name: Verify node readiness without CNI
  shell: >
    kubectl get nodes -o json | jq -r '.items[] | select(.spec.taints[]? | .key == "node.cloudprovider.kubernetes.io/uninitialized").status.conditions[] | select(.type == "Ready").status == "True"'
  register: node_readiness_result
  until: node_readiness_result.stdout == "True"
  retries: 100
  delay: 15
  when: active_server or first_server_node
  changed_when: false

- name: Verify node readiness with CNI
  shell: >
    kubectl get nodes -o json | jq -r '.items | length'
  register: node_count_result
  until: node_count_result.stdout | int == expected_node_count
  retries: 100
  delay: 15
  when: active_server and not check_mode
  changed_when: false


