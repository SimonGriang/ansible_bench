---
- import_tasks: assert.yml
  remote_user: localhost

- name: Install fail2ban
  package:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Copy filters in filter.d
  copy:
    src: "{{ item }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: 0640
  loop: "{{ query('community.general.item_find', fail2ban_filterd_path) }}"
