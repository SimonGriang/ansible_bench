---
- import_tasks: assert.yml
  when: ansible_local.assert is defined

- name: Install the necessary cron packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ cron_packages }}"

- name: Configure the shell environment for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    mode: "0600"
    create: yes
    owner: "root"
    group: "root"
  notify: restart_cron_service

- name: Configure the PATH environment variable for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    mode: "0600"
    create: yes
    owner: "root"
    group: "root"
  notify: restart_cron_service

- name: Configure the MAILTO environment variable for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    mode: "0600"
    create: yes
    owner: "root"
    group: "root"
  notify: restart_cron_service

- name: Ensure the cron service is started and enabled
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: "{{ cron_service is defined and cron_service != '' }}"
  when: cron_service is defined and cron_service != ''

- name: Schedule the specified cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    special_days: "{{ item.special_days }}"
    state: "{{ item.state }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined

