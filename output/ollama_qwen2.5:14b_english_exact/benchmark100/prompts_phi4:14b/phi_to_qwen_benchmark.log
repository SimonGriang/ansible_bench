---
- name: Import assert.yml tasks file
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install HashiCorp products using package installation method
  block:
    - name: Ensure HashiCorp repository is added for RedHat or Rocky
      ansible.builtin.get_url:
        url: "{{ hashicorp_repo_url }}"
        dest: /etc/yum.repos.d/{{ item }}
        mode: '0644'
      loop: "{{ hashicorp_repo_files }}"
      when: ansible_os_family == 'RedHat' or ansible_os_family == 'Rocky'
      become: yes

    - name: Ensure GPG package is installed for Debian systems
      ansible.builtin.package:
        name: "{{ debian_gpg_package }}"
        state: present
      when: ansible_os_family == 'Debian'
      become: yes

    - name: Import HashiCorp GPG key for Debian systems
      ansible.builtin.shell: "curl -s https://keybase.io/hashicorp.zip | apt-key add -"
      when: ansible_os_family == 'Debian'
      become: yes

    - name: Add HashiCorp repository for Debian systems
      ansible.builtin.get_url:
        url: "{{ hashicorp_repo_url }}"
        dest: /etc/apt/sources.list.d/{{ item }}
        mode: '0644'
      loop: "{{ hashicorp_repo_files }}"
      when: ansible_os_family == 'Debian'
      become: yes

    - name: Update package lists
      ansible.builtin.package:
        name: "{{ apt_update_packages }}"
        state: present
      when: ansible_os_family == 'Debian'
      become: yes

    - name: Install HashiCorp products
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ hashicorp_products }}"
      become: yes

  when: installation_method == "package"

- name: Install HashiCorp products manually
  block:
    - name: Download and extract HashiCorp products
      ansible.builtin.unarchive:
        src: "{{ hashicorp_products_src }}"
        dest: "{{ hashicorp_products_dest }}"
        remote_src: yes
        owner: "{{ user_name }}"
        group: "{{ user_name }}"
        mode: '0755'
  when: installation_method == "manual"

