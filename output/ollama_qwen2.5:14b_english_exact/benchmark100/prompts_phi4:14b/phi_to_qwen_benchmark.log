---
- name: Install EPEL repository on supported Red Hat-based systems
  block:
    - name: Add the EPEL GPG key
      ansible.builtin.rpm_key:
        key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}
        state: present
      when: ansible_os_family == 'RedHat' and ansible_distribution_version | version_compare('>=7') or ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2'

    - name: Install the EPEL release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache
      when: ansible_os_family == 'RedHat' and ansible_distribution_version | version_compare('>=7') or ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2'

    - name: Optionally install the EPEL next-release package
      ansible.builtin.package:
        name: "{{ epel_next_url }}"
        state: present
      notify: Update package cache
      when: epel_next | bool

  vars:
    epel_url: "https://dl.fedoraproject.org/pub/epel/epel-release-latest-{{ ansible_distribution_major_version }}.noarch.rpm"
    epel_next_url: "https://dl.fedoraproject.org/pub/epel/next/epel-release-next-latest-{{ ansible_distribution_major_version }}.noarch.rpm"

handlers:
  - name: Update package cache
    ansible.builtin.meta:
      updated_cache: yes

