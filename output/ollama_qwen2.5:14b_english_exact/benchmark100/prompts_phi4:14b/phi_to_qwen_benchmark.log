---
- import_tasks: assert.yml
  remote_addr: localhost

- name: Install required packages for OpenSSL
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_requirements }}"

- name: Install pip packages if openssl_pip_packages is not empty
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_pip_packages }}"
  when: openssl_pip_packages|length > 0

- name: Create directory for OpenSSL keys
  file:
    path: "{{ item }}"
    state: directory
    mode: '0700'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop:
    - /etc/ssl/private

- name: Create directory for OpenSSL CSRs
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop:
    - /etc/ssl/csr

- name: Create directory for OpenSSL certificates
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop:
    - /etc/ssl/certs

- name: Include create.yml for each item in openssl_items
  import_tasks: create.yml
  loop: "{{ openssl_items }}"
  when: openssl_items is defined and openssl_items|length > 0

