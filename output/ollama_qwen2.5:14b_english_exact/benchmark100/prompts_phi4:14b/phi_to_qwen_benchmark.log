  loop: "{{ bootstrap_os_family_map.keys() }}"
  register: distribution_facts
  when: bootstrap_os_family_map[item] is search(bootstrap_os_release['PRETTY_NAME'])

- name: Set bootstrap operating system family
  set_fact:
    bootstrap_os_family: "{{ item }}"
  when:
    - distribution_facts is defined
    - distribution_facts.results|map(attribute='ansible_facts.bootstrap_distribution')|select('defined')|list|length > 0
  loop: "{{ distribution_facts.results|json_query('[].ansible_facts.bootstrap_distribution')|flatten|unique }}"
