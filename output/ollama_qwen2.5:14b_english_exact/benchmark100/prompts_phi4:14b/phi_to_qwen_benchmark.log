---
- name: Import assert.yml only once and delegate to localhost
  import_tasks: assert.yml
  delegate_to: localhost
  when: ansible_playbook_dir is defined

- name: Install Python pip using the specified package name
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings if the proxy is defined
  lineinfile:
    path: /etc/pip.conf
    line: "index-url = {{ python_pip_proxy }}"
    create: yes
    regexp: "^index-url = "
  when: python_pip_proxy is defined

- name: Set trusted hosts for pip if specified
  lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    create: yes
    regexp: "^trusted-host = "
  when: python_pip_trusted_host is defined

- name: Update pip to the latest version under specific conditions
  command: "{{ python_pip_pip_package }} install --upgrade pip"
  when: python_pip_update == True and (distribution_release is not defined or distribution_release not in ['bookworm', 'noble']) and ansible_os_family != "Alpine"

- name: Install requested Python pip modules based on conditions
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when: (distribution_release is not defined or distribution_release not in ['bookworm', 'noble']) and ansible_os_family != "Alpine"

