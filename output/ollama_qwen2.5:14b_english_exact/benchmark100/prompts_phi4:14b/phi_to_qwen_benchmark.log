---
- name: Task 1: Check if all necessary variables have been set correctly
  import_tasks: variable_assertions.yml
  delegate_to: localhost

- name: Task 2: Wait for the host to become available if specified in the configuration
  wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ wait_for_timeout | default(300) }}"
  when:
    - connection is not defined or connection != 'docker'
    - wait_for is defined and wait_for | bool
