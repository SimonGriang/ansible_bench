---
- name: Migrate the Java JDK vendor from adoptopenjdk to temurin if selected
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS-specific variables for the Java JDK
  include_vars:
    file: "{{ item }}"
  with_first_found:
    - files:
        - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_version }}.yml"
        - "{{ java_jdk_vendor }}-{{ ansible_distribution }}.yml"
        - "{{ java_jdk_vendor }}.yml"

- name: Gather architecture-specific variables for the Java JDK
  include_vars:
    file: "{{ item }}"
  with_first_found:
    - files:
        - "{{ java_jdk_vendor }}-{{ ansible_architecture }}.yml"
        - "{{ java_jdk_vendor }}.yml"

- name: Set OS-specific Java variables
  set_fact:
    java_os_vars: "{{ lookup('vars', 'java_os_vars', default=None) }}"
  when: java_os_vars is undefined or java_os_vars is None

- name: Set OS and architecture-specific Java variables
  set_fact:
    java_os_arch_vars: "{{ lookup('vars', 'java_os_arch_vars', default=None) }}"
  when: java_os_arch_vars is undefined or java_os_arch_vars is None

- name: Set specific Java variables
  set_fact:
    java_home: "/usr/lib/jvm/{{ java_package_name }}"

- name: Handle Debian pre-requisites for Java installation
  block:
    - name: Remove deprecated repositories
      apt:
        state: absent
        purge: yes
        name: "{{ item }}"
      loop: "{{ java_deprecated_repos }}"
      when: ansible_facts['os_family'] == 'Debian' and java_deprecated_repos | length > 0

    - name: Install extra packages
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ java_extra_packages }}"
      when: ansible_facts['os_family'] == 'Debian' and java_extra_packages | length > 0

    - name: Add key repositories
      apt_key:
        url: "{{ item }}"
      loop: "{{ java_key_repos }}"
      when: ansible_facts['os_family'] == 'Debian' and java_key_repos | length > 0

    - name: Add required repositories
      apt_repository:
        filename: "{{ item.filename }}"
        repo: "{{ item.repo }}"
        state: present
      loop: "{{ java_required_repos }}"
      when: ansible_facts['os_family'] == 'Debian' and java_required_repos | length > 0

- name: Handle RedHat pre-requisites for Java installation
  block:
    - name: Add key repositories
      rpm_key:
        key: "{{ item }}"
      loop: "{{ java_key_repos }}"
      when: ansible_facts['os_family'] == 'RedHat' and java_key_repos | length > 0

    - name: Add required repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        state: present
      loop: "{{ java_required_repos }}"
      when: ansible_facts['os_family'] == 'RedHat' and java_required_repos | length > 0

- name: Install required libraries for Java
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libs }}"

- name: Install Java on Debian systems
  apt:
    name: "{{ java_package_name }}"
    state: present
    update_cache: yes
  when: ansible_facts['os_family'] == 'Debian'

- name: Install Java on RedHat systems
  yum:
    name: "{{ java_package_name }}"
    state: present
    update_cache: yes
  when: ansible_facts['os_family'] == 'RedHat'

- name: Export Java environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh

- name: Source Java environment variables
  shell: source /etc/profile.d/jdk.sh

- name: Correct Java version selection for versions less than 11 on Debian systems
  command: alternatives --install /usr/bin/java java /usr/lib/jvm/{{ java_package_name }}/bin/java {{ java_priority }}
  when: ansible_facts['os_family'] == 'Debian' and java_version | version_compare('11', '<')

- name: Correct Java version selection for versions 11 or greater on Debian systems
  command: alternatives --set java /usr/lib/jvm/{{ java_package_name }}/bin/java
  when: ansible_facts['os_family'] == 'Debian' and java_version | version_compare('11', '>=')

