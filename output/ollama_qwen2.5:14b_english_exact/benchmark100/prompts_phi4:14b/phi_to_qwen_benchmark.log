---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server-specific node taints
  set_fact:
    server_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Template the RKE2 configuration file
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0600'
    owner: root
    group: root
  notify: Config file changed

- name: Template the kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0600'
    owner: root
    group: root
  when: rke2_kubelet_config|length > 0
  notify: Config file changed

- name: Configure Containerd registry settings
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0600'
    owner: root
    group: root
  when: rke2_custom_registry_mirrors|length > 0 or rke2_custom_registry_configs|length > 0
  notify: Config file changed

- name: Determine if an etcd restore from a file is necessary
  set_fact:
    do_etcd_restore: "{{ (rke2_etcd_snap_file is defined) and (rke2_server_service_state == 'inactive' or rke2_server_service_state == 'disabled') }}"
  when: rke2_etcd_snap_file is defined

- name: Determine if an etcd restore from S3 is necessary
  set_fact:
    do_etcd_restore_from_s3: "{{ (rke2_etcd_s3_bucket is defined) and (rke2_etcd_s3_access_key is defined) and (rke2_etcd_s3_secret_key is defined) and (rke2_etcd_s3_region is defined) and (rke2_etcd_s3_object is defined) }}"
  when: rke2_etcd_s3_bucket is defined and rke2_etcd_s3_access_key is defined and rke2_etcd_s3_secret_key is defined and rke2_etcd_s3_region is defined and rke2_etcd_s3_object is defined

- name: Restore etcd from a snapshot file
  block:
    - name: Create the snapshot directory
      file:
        path: "{{ rke2_etcd_snap_dir }}"
        state: directory
        mode: '0755'
        owner: root
        group: root
    - name: Copy the snapshot file
      copy:
        src: "{{ rke2_etcd_snap_file }}"
        dest: "{{ rke2_etcd_snap_dir }}/{{ rke2_etcd_snap_file | basename }}"
        mode: '0644'
        owner: root
        group: root
    - name: Execute rke2 server restore command
      shell: rke2 server etcd-snapshot restore --file "{{ rke2_etcd_snap_dir }}/{{ rke2_etcd_snap_file | basename }}"
      register: rke2_restore_etcd
      changed_when: rke2_restore_etcd.rc != 0
  when: do_etcd_restore

- name: Restore etcd from an S3 snapshot
  shell: rke2 server etcd-snapshot restore --s3-bucket "{{ rke2_etcd_s3_bucket }}" --s3-object "{{ rke2_etcd_s3_object }}"
  register: rke2_restore_etcd_s3
  changed_when: rke2_restore_etcd_s3.rc != 0
  when: do_etcd_restore_from_s3

- name: Start the RKE2 server service
  service:
    name: rke2-server.service
    enabled: true
    state: started
    environment: "RKE2_TOKEN={{ rke2_token }}"
  notify: Service (re)started

- name: Mask the RKE2 agent service
  systemd:
    name: rke2-agent.service
    masked: true

- name: Wait for the first server to be ready without CNI
  shell: kubectl get nodes -l node-role.kubernetes.io/control-plane=true -o json | jq -r '.items[0].status.conditions[] | select(.type=="Ready") | .status' | grep -q "True"
  register: ready_status
  until: ready_status.stdout == "True"
  retries: 100
  delay: 15
  when: rke2_cni == 'none'

- name: Wait for the first server to be ready with CNI
  shell: kubectl get nodes -l node-role.kubernetes.io/control-plane=true -o json | jq -r '.items[0].status.conditions[] | select(.type=="Ready") | .status' | grep -q "True"
  register: ready_status
  until: ready_status.stdout == "True"
  retries: 40
  delay: 15
  when: rke2_cni != 'none'

- name: Clean up old nodes and secrets if restoring etcd
  block:
    - name: Gather registered node names
      shell: kubectl get nodes -o json | jq -r '.items[].metadata.name'
      register: node_names
    - name: Identify nodes no longer present
      set_fact:
        nodes_to_delete: "{{ node_names.stdout_lines | difference([ inventory_hostname ]) }}"
    - name: Delete associated secrets and nodes
      block:
        - name: Delete node secrets
          shell: kubectl delete secrets -l node.kubernetes.io/node={{ item }}
          loop: "{{ nodes_to_delete }}"
        - name: Delete node
          shell: kubectl delete node {{ item }}
          loop: "{{ nodes_to_delete }}"
  when: do_etcd_restore or do_etcd_restore_from_s3

- name: Set the active server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  delegate_facts: true
  loop: "{{ groups[rke2_cluster_group_name] }}"
  #

