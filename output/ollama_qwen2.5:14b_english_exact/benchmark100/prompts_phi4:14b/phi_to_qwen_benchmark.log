- name: Gather bootstrap facts
  raw: cat /etc/os-release
  register: bootstrap_facts
  check_mode: false
  changed_when: false

- name: Set bootstrap distribution facts
  set_fact:
    bootstrap_distribution: "{{ bootstrap_os_family_map[item] }}"
    bootstrap_distribution_major_version: "{{ bootstrap_os_release['PRETTY_NAME'] | regex_replace('^[^0-9.]*([0-9]+\\.[0-9]+).*$', '\\1') }}"
  when:
    - bootstrap_facts is defined
