---
- name: Gather bootstrap facts
  raw: cat /etc/os-release
  register: bootstrap_facts
  become: false

- name: Set bootstrap distribution and major version facts
  set_fact:
    bootstrap_distribution: "{{ bootstrap_os_family_map[item].distribution }}"
    bootstrap_distribution_major_version: "{{ bootstrap_os_family_map[item].version }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout | search(bootstrap_search[item])
  loop: "{{ bootstrap_os_family_map.keys() }}"
  become: false

- name: Determine and set bootstrap OS family
  set_fact:
    bootstrap_os_family: "{{ item.value.os_family }}"
  loop: "{{ bootstrap_os_family_map }}"
  loop_control:
    label: "{{ item.value.os_family }}"
  when: "'{{ bootstrap_distribution }}' in {{ item.value.distribution }}"
  become: false

