        mode: '0644'
        timeout: 60
      with_items: "{{ rke2_artifacts }}"
      register: rke2_artifacts_download
      failed_when: false

    - name: Fallback download locally and push to remote
      block:
        - name: Download RKE2 artifacts locally
          get_url:
            url: "{{ rke2_artifacts_url }}/{{ item.name }}"
            dest: /tmp/{{ item.name }}
            mode: '0644'
            timeout: 60
          with_items: "{{ rke2_artifacts }}"
          when: rke2_artifacts_download.results[item.sha256].failed
          register: rke2_local_artifacts_download

        - name: Push local artifacts to remote
          synchronize:
            src: /tmp/{{ item.name }}
            dest: /var/lib/rancher/rke2/artifacts/{{ item.name }}
            delete: yes
            checksum: yes
          with_items: "{{ rke2_local_artifacts_download.results }}"
          when: rke2_artifacts_download.results[item.sha256].failed
      when: rke2_artifacts_download.results[item.sha256].failed

    - name: Retry downloading RKE2 installation script
      get_url:
        url: "{{ rke2_installer_url }}"
        dest: /var/lib/rancher/rke2/bin/rke2-install
        mode: '0755'
        timeout: 60
      when: rke2_artifacts_download.results[item.sha256].failed

