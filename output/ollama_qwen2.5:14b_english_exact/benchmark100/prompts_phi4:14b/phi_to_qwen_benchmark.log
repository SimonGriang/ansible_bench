---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Pre-configure Debian systems for Postfix
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: "No configuration"
    vtype: select
  when: ansible_os_family == 'Debian'

- name: Install Postfix
  apt:
    name: postfix
    state: present
  become: yes

- name: Conditionally install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined or postfix_virtual_mailbox_domains is defined or postix_virtual_alias_maps is defined
  become: yes

- name: Configure Postfix transport maps
  template:
    src: postfix_transport_maps.j2
    dest: /etc/postfix/transport
    owner: root
    group: root
    mode: '0644'
  notify: validate_transport_maps
  when: postfix_transport_maps_template is defined

- name: Configure Postfix header checks
  template:
    src: postfix_header_checks.j2
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: '0644'
  notify: validate_header_checks
  when: postfix_header_checks_template is defined

- name: Set values for Postfix main.cf (part 1)
  set_fact:
    postfix_main_recipient_access: "{{ postfix_recipient_access|d('') }}"
    postfix_main_sender_access: "{{ postfix_sender_access|d('') }}"

- name: Set values for Postfix main.cf (part 2)
  set_fact:
    postfix_main_mynetworks: "{{ postfix_mynetworks|d('') }}"
    postfix_main_mydestination: "{{ postfix_mydestination|d('') }}"
    postfix_main_relay_domains: "{{ postfix_relay_domains|d('') }}"
    postfix_main_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions|d('') }}"
    postfix_main_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions|d('') }}"
    postfix_main_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains|d('') }}"
    postfix_main_virtual_alias_domains: "{{ postfix_virtual_alias_domains|d('') }}"

- name: Configure Postfix main.cf
  template:
    src: postfix_main.cf.j2
    dest: /etc/postfix/main.cf
    owner: root
    group: root
    mode: '0644'
  notify: validate_main_cf
  notify: restart_postfix

- name: Configure Postfix master.cf
  template:
    src: postfix_master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: '0644'
  notify: validate_master_cf
  notify: restart_postfix

- name: Create directories for TLS certificates and keys
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - "{{ postfix_tls_cert_dir|default('/etc/postfix/tls') }}"
    - "{{ postfix_tls_key_dir|default('/etc/postfix/tls') }}"
  when: postfix_tls_cert_source or postfix_tls_key_source

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_cert_source }}"
    dest: "{{ postfix_tls_cert_dest|default('/etc/postfix/tls/postfix.pem') }}"
    owner: root
    group: root
    mode: '0644'
  notify: reload_postfix
  when: postfix_tls_cert_source

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_source }}"
    dest: "{{ postfix_tls_key_dest|default('/etc/postfix/tls/postfix.key') }}"
    owner: root
    group: root
    mode: '0644'
  notify: reload_postfix
  when: postfix_tls_key_source

- name: Flush Postfix handlers
  meta: flush_handlers

- name: Configure Postfix aliases
  lineinfile:
    path: "{{ postfix_aliases_path }}"
    line: "{{ item }}"
  loop: "{{ postfix_aliases|default([]) }}"
  notify: rebuild_aliases_database
  notify: reload_postfix
  when: postfix_aliases is defined

- name: Configure Postfix sender access
  lineinfile:
    path: "{{ postfix_sender_access_path }}"
    line: "{{ item }}"
  loop: "{{ postfix_sender_access|default([]) }}"
  notify: rebuild_sender_access_database
  notify: reload_postfix
  when: postfix_sender_access is defined

- name: Configure Postfix recipient access
  lineinfile:
    path: "{{ postfix_recipient_access_path }}"
    line: "{{ item }}"
  loop: "{{ postfix_recipient_access|default([]) }}"
  notify: validate_recipient_access
  notify: rebuild_recipient_access_database
  notify: reload_postfix
  when: postfix_recipient_access is defined

- name: Place SASL password map
  copy:
    content: "{{ postfix_smtp_sasl_password_map }}"
    dest: "{{ postfix_smtp_sasl_password_map_path }}"
    mode: '0644'
  notify: rebuild_sasl_password_map_database
  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map|length > 0

- name: Flush Postfix handlers again
  meta: flush_handlers

- name: Start and enable Postfix service
  systemd:
    name: postfix
    state: started
    enabled: yes
  become: yes


