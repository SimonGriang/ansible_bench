---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install MySQL packages
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - set_mysql_root_password
    - restart_mysql

- name: Configure MySQL server configuration file
  copy:
    dest: /etc/mysql/my.cnf
    content: "{{ item }}"
    mode: '0644'
  with_items: "{{ mysql_configuration_options }}"
  notify:
    - restart_mysql

- name: Configure MySQL client configuration file
  lineinfile:
    path: /etc/mysql/conf.d/client.cnf
    line: "socket={{ mysql_socket }}"
    create: yes
    mode: '0644'

- name: Initialize MySQL database if on Alpine or Archlinux
  command: mysql_install_db --user=mysql
  when: ansible_os_family in ['Alpine', 'Archlinux']
  args:
    creates: /var/lib/mysql

- name: Start and enable MySQL service
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place the my.cnf configuration file
  template:
    src: my.cnf.j2
    dest: /root/my.cnf
    mode: '0600'

- name: Create MySQL databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_host }}"
    login_port: "{{ mysql_port }}"
    ssl_cert: "{{ mysql_ssl_cert }}"
    ssl_key: "{{ mysql_ssl_key }}"
    ssl_ca: "{{ mysql_ssl_ca }}"
  with_items: "{{ mysql_databases }}"
  when: item.initial_import is not defined
  ignore_errors: yes

- name: List current MySQL databases
  shell: mysql -u root -p{{ mysql_root_password }} -h {{ mysql_host }} -P {{ mysql_port }} -e 'show databases;'
  register: mysql_databases_list
  ignore_errors: yes

- name: Import databases if initial import is defined and not already present
  shell: mysql -u root -p{{ mysql_root_password }} -h {{ mysql_host }} -P {{ mysql_port }} {{ item.database }} < {{ item.target }}
  when: item.initial_import is defined and item.database not in mysql_databases_list.stdout_lines

- name: Create MySQL users
  mysql_user:
    name: "{{ item.user }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
  with_items: "{{ mysql_users }}"
  ignore_errors: yes

- name: Flush handlers again
  meta: flush_handlers

