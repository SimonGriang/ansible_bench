---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install the Apache HTTP server
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux if enabled
  when: ansible_facts.system.selinux.enabled
  block:
    - name: Enable specified SELinux booleans
      ansible.builtin.seboolean:
        name: "{{ item }}"
        state: on
        persist: yes
      loop: "{{ httpd_sebooleans }}"
    - name: Allow connections to custom ports in SELinux
      ansible.builtin.seport:
        port: "{{ item }}"
        proto: tcp
        setype: httpd
        state: present
      loop:
        - "{{ httpd_port }}"
        - "{{ httpd_ssl_port | default('443') }}"

- name: Configure the main Apache HTTP server configuration file
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    owner: root
    group: root
    mode: '0644'
    notify: validate httpd configuration
  notify: restart httpd

- name: Activate specified Apache HTTP server modules on Debian systems
  when: ansible_facts.system.codename is defined
  shell: "{{ item }}"
  notify: validate httpd configuration
  loop: "{{ httpd_modules_to_activate_with_command | default([]) }}"
  changed_when: false

- name: Import SSL configuration tasks if HTTPS is enabled
  when: https_ssl_enable
  import_tasks: ssl.yml

- name: Import location configuration tasks if locations are defined
  when: httpd_locations is defined
  import_tasks: locations.yml

- name: Import virtual host configuration tasks if virtual hosts are defined
  when: httpd_vhosts is defined
  import_tasks: vhosts.yml

- name: Configure ports for Debian and SUSE systems
  when: ansible_facts.system.codename is defined or ansible_facts.system.os_family == "Suse"
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_ports_conf_dest }}"
    owner: root
    group: root
    mode: '0644'
    notify: validate httpd configuration

- name: Import directory configuration tasks if directories are defined
  when: httpd_directories is defined
  import_tasks: directories.yml

- name: Flush all pending handlers
  ansible.builtin.meta: flush_handlers

- name: Remove the default HTML index file if specified
  when: httpd_remove_example
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent

- name: Start and enable the Apache HTTP server service
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    enabled: yes
    state: started

