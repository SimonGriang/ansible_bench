---
- name: Task 1: Check if all necessary variables have been set correctly
  import_tasks: variable_assertions.yml
  delegate_to: localhost

- name: Task 2: Wait for the host to become available if specified in the configuration
  wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ wait_for_timeout | default(300) }}"
  when:
    - connection is not defined or connection != 'docker'
    - wait_for is defined and wait_for | bool
  connection: local
  become: "{{ become | default('yes') }}"
  become_user: root

- name: Task 3: Prepare the system by ensuring connectivity and installing necessary packages
  block:
    - name: Test connection to the host
      ping:
      register: ping_result
      delegate_to: localhost
      connection: local
    - name: Provide a debug message with the timeout value
      debug:
        msg: "Connection to the host timed out after {{ wait_for_timeout | default(300) }} seconds."
      when: ping_result is not defined
    - name: Gather facts about the system
      setup:
      delegate_to: localhost
      connection: local
      when: ping_result is defined
    - name: Install necessary packages
      raw: "{{ 'yum makecache' if ansible_os_family == 'RedHat' else 'apt-get update' }}"
      when: ansible_os_family is defined and ansible_os_family != 'NILinuxSO'
      register: package_update
      delegate_to: localhost
      connection: local
      become: "{{ become | default('yes') }}"
    - name: Install necessary packages using ansible module
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ package_to_install | default([]) }}"
      when: ansible_os_family is defined
      become: "{{ become | default('yes') }}"

- name: Task 4: Ensure the system is fully prepared by executing necessary Ansible modules
  block:
    - name: Gather Ansible facts
      setup:
    - name: Install required packages
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ package_to_install | default([]) }}"
      when: package_to_install is defined

