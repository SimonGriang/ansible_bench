---
- name: Create the RKE2 manifests directory
  file:
    path: /etc/rancher/rke2/manifests
    state: directory
    mode: 0700
    owner: root
    group: root

- name: Copy kube-vip files to the first server
  copy:
    src: "{{ item }}"
    dest: /etc/rancher/rke2/manifests/{{ item | replace('.j2','') }}
    mode: 0664
  with_items:
    - kube-vip-ds.yml.j2
    - kube-vip-svc.yml.j2

- name: Copy kube-vip load balancer manifests to the first server
  block:
    - copy:
        src: "{{ item }}"
        dest: /etc/rancher/rke2/manifests/{{ item | replace('.j2','') }}
        mode: 0664
      when: cloud_provider_feature_enabled
  with_items:
    - kube-vip-lb-aws.yml.j2
    - kube-vip-lb-azure.yml.j2
    - kube-vip-lb-gcp.yml.j2
    - kube-vip-lb-ovh.yml.j2
    - kube-vip-lb-vsphere.yml.j2

