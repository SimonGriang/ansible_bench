---
- import_tasks: assert.yml
  delegate_to: localhost
  when: inventory_hostname == 'once'

- name: Ensure the bash package is installed
  package:
    name: bash
    state: present

- name: Install OpenJDK package if java_vendor is set to "openjdk"
  package:
    name: "{{ java_openjdk_package }}"
    state: present
  when: java_vendor == "openjdk"

- name: Copy Oracle Java RPM package to /tmp and install it
  when: java_source == "local" and java_format == "rpm"
  become: yes
  block:
    - name: Copy RPM package to /tmp
      copy:
        src: "{{ java_rpm_package }}"
        dest: /tmp
    - name: Install Oracle Java RPM
      package:
        name: "/tmp/{{ java_rpm_package | basename }}"
        state: present

- name: Copy Oracle Java DEB package to /tmp and install it
  when: java_source == "local" and java_format == "deb"
  become: yes
  block:
    - name: Copy DEB package to /tmp
      copy:
        src: "{{ java_deb_package }}"
        dest: /tmp
    - name: Install Oracle Java DEB
      apt:
        deb: /tmp/{{ java_deb_package | basename }}
        state: present

- name: Install Oracle Java RPM package from repository
  when: java_source == "repo" and java_format == "rpm"
  package:
    name: "{{ java_oracle_package }}"
    state: present

- name: Ensure Oracle Java installation directory exists and install tarball
  when: java_format == "targz" and java_vendor == "oracle"
  become: yes
  block:
    - name: Ensure installation directory exists
      file:
        path: "{{ java_install_dir }}"
        state: directory
        mode: 0755
    - name: Extract Oracle Java tarball
      unarchive:
        src: "{{ java_targz_package }}"
        dest: "{{ java_install_dir }}"
        remote_src: yes
    - name: Set directory permissions
      file:
        path: "{{ java_install_dir }}"
        mode: 0755

- name: Install Oracle Java Cryptography Extension (JCE) policy software
  when: java_format == "targz" and java_vendor == "oracle" and java_version == "8" and jce_enabled
  become: yes
  block:
    - name: Ensure JCE installation directory exists
      file:
        path: "{{ jce_install_dir }}"
        state: directory
        mode: 0755
    - name: Extract JCE zip file
      unarchive:
        src: "{{ jce_zip_package }}"
        dest: "{{ jce_install_dir }}"
        remote_src: yes
    - name: Set directory permissions for JCE
      file:
        path: "{{ jce_install_dir }}"
        mode: 0755

- name: Set Java as default alternative
  command: update-alternatives --install /usr/bin/java java "{{ java_install_dir }}/bin/java" 1
  when: java_format == "targz" and ansible_distribution is not "Alpine" and java_vendor == "oracle"
  become: yes

- name: Determine JAVA_HOME directory by finding the real path of the Java binary
  command: readlink -f /usr/bin/java
  register: java_home_path

- name: Set JAVA_HOME environment variable in /etc/profile.d/java_home.sh
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home_path.stdout }}"
    create: yes
    mode: 0644

