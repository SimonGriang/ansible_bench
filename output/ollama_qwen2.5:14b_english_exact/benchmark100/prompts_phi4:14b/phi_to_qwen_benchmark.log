---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Initialize PKI directory using EasyRSA
  command: "{{ easyrsa_path }}/easyrsa init-pki"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build a CA certificate using EasyRSA without a passphrase
  command: "{{ easyrsa_path }}/easyrsa build-ca nopass"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate a Diffie-Hellman parameters file using EasyRSA
  command: "{{ easyrsa_path }}/easyrsa gen-dh"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build a server certificate using EasyRSA without a passphrase
  command: "{{ easyrsa_path }}/easyrsa build-server-full server nopass"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build a client certificate using EasyRSA without a passphrase
  command: "{{ easyrsa_path }}/easyrsa build-client-full client nopass"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate a Certificate Revocation List using EasyRSA
  command: "{{ easyrsa_path }}/easyrsa gen-crl"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate a TLS auth key using OpenVPN
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy necessary EasyRSA files to /etc/openvpn/server
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item.src }}
    dest: /etc/openvpn/server/{{ item.dest }}
    mode: "{{ item.mode }}"
    owner: root
    group: root
  with_items:
    - { src: "ca.crt", dest: "ca.crt", mode: "0644" }
    - { src: "dh.pem", dest: "dh.pem", mode: "0644" }
    - { src: "ta.key", dest: "ta.key", mode: "0600" }
    - { src: "issued/server.crt", dest: "server.crt", mode: "0644" }
    - { src: "private/server.key", dest: "server.key", mode: "0600" }

- name: Copy necessary EasyRSA files to /etc/openvpn
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item.src }}
    dest: /etc/openvpn/{{ item.dest }}
    mode: "{{ item.mode }}"
    owner: root
    group: root
  with_items:
    - { src: "ca.crt", dest: "ca.crt", mode: "0644" }
    - { src: "ta.key", dest: "ta.key", mode: "0600" }

- name: Deploy the OpenVPN server configuration file
  template:
    src: openvpn.conf.j2
    dest: /etc/openvpn/server/openvpn.conf
    mode: 0644
  notify: restart_openvpn_server

