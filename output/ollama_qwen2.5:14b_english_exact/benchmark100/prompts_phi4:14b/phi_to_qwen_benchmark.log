- name: Set server node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_node_type == 'server'

- name: Set agent node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_node_type == 'agent'

