---
- name: Ensure the system is using systemd as the init system
  assert:
    that:
      - ansible_service_mgr == "systemd"
    msg: "This playbook only works with systemd as the init system."

- name: Retrieve the latest release information for Grafana Loki
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    headers:
      Authorization: "Bearer {{ github_token }}"
    status_code: 200
    validate_certs: yes
    retries: 5
    timeout: 10
  register: loki_release
  when: promtail_version == "latest"
  delegate_to: localhost
  run_once: yes

- name: Verify the existence of a local promtail binary archive
  stat:
    path: "{{ promtail_binary_local_dir }}/{{ promtail_version }}-{{ promtail_architecture }}.tar.gz"
  register: promtail_local_binary
  when: promtail_binary_local_dir is defined
  failed_when: promtail_local_binary.stat.exists == False
  changed_when: promtail_local_binary.stat.exists == False
  msg: "Local promtail binary archive does not exist at {{ promtail_binary_local_dir }}/{{ promtail_version }}-{{ promtail_architecture }}.tar.gz"

- name: Download and verify the checksum for the promtail binary if not using a local binary
  set_fact:
    promtail_checksum_url: "{{ lookup('url', 'https://raw.githubusercontent.com/grafana/loki/' + loki_release.json.tag_name + '/builds/sha256sum.txt', split=True) }}"
  when: promtail_binary_local_dir is not defined
  vars:
    loki_release: "{{ lookup('url', 'https://api.github.com/repos/grafana/loki/releases/latest', split=True, validate_certs=True) }}"

