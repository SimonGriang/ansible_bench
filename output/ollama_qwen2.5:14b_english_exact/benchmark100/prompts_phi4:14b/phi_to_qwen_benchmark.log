- name: Rename the EXTERNALLY-MANAGED file for Python 3.11 if it exists
  ansible.builtin.rename:
    src: /usr/lib/python3.11/EXTERNALLY-MANAGED
    dest: /usr/lib/python3.11/EXTERNALLY-MANAGED.old
  when: python_3_11_externally_managed.stat is defined and python_3_11_externally_managed.stat.exists

- name: Check for the existence of the EXTERNALLY-MANAGED file for Python 3.12
  ansible.builtin.file:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
    state: file
  register: python_3_12_externally_managed

- name: Rename the EXTERNALLY-MANAGED file for Python 3.12 if it exists
  ansible.builtin.rename:
    src: /usr/lib/python3.12/EXTERNALLY-MANAGED
    dest: /usr/lib/python3.12/EXTERNALLY-MANAGED.old
  when: python_3_12_externally_managed.stat is defined and python_3_12_externally_managed.stat.exists

- name: Import tasks from assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Python pip
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_packages }}"
  become: yes

- name: Configure pip proxy settings
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    regexp: '^index-url'
    line: "index-url {{ python_pip_proxy }}"
  when: python_pip_proxy is defined

- name: Configure trusted hosts for pip
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    regexp: '^trusted-host'
    line: "trusted-host {{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined

- name: Update pip to the latest version
  ansible.builtin.package:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state | ternary('latest', 'present') }}"
    executable: "{{ python_pip_executable }}"
  when: python_pip_update == true and ansible_facts['os_family'] != "Alpine" and ansible_facts['distribution_release'] not in ["bookworm", "noble"]

- name: Install requested Python modules
  ansible.builtin.pip:
    name: "{{ item.module }}"
    version: "{{ item.version }}"
    state: "{{ item.state }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  when: ansible_facts['os_family'] != "Alpine" and ansible_facts['distribution_release'] not in ["bookworm", "noble"]

