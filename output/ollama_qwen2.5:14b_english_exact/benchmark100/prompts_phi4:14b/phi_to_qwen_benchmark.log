  template:
    src: "{{ item.user }}.sudoers.j2"
    dest: "/etc/sudoers.d/{{ item.user }}"
    owner: root
    group: root
    mode: '0440'
  loop: "{{ users | selectattr('sudo', 'defined') | list }}"
  when: item.sudo is defined

- name: Remove sudo privileges for users if not specified
  file:
    path: "/etc/sudoers.d/{{ item.user }}"
    state: absent
  loop: "{{ users | selectattr('sudo', 'undefined') | list }}"
  when: item.sudo is undefined

