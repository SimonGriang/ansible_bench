---
- name: Import assert.yml and run on localhost
  import_tasks: assert.yml  # Comment for task description
  remote_addr: localhost

- name: Install required software packages based on users_requirements
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  when: users_requirements|length > 0  # Comment for task description

- name: Include group.yml tasks for each group
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item }}"
  # with_items is unnecessary here and was a mistake in the original playbook  # Comment for task description

- name: Ensure /etc/sudoers includes /etc/sudoers.d
  lineinfile:
    path: /etc/sudoers
    line: '%{{ item }} ALL=(ALL) NOPASSWD:ALL'
    regexp: '^%{{ item }} ALL='
    validate: 'visudo -cf /dev/null'
  loop: "{{ users_groups }}"
  when: "'{{ item }}' is defined"  # Comment for task description

- name: Include user.yml tasks for each user
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  # with_items is unnecessary here and was a mistake in the original playbook  # Comment for task description

- name: Manage cron permissions using template
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow  # Comment for task description

- name: Remove /etc/cron.allow if cron permissions are not required
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow  # Comment for task description


