---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install the required SELinux packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush the handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Configure SELinux settings
  ansible.posix.selinux:
    persistent: yes
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when:
    - ansible_selinux.status is defined
    - ansible_connection != 'docker'
    - ansible_connection != 'lxc'
  notify: Reboot

- name: Manage SELinux booleans
  ansible.posix.seboolean:
    name: "{{ item.0 }}"
    state: "{{ item.1.value }}"
    persistent: "{{ item.1.pers }}"
  loop: "{{ selinux_booleans|dict2items }}"
  when: selinux_booleans is defined
  loop_control:
    label: "{{ item.0 }}"
  notify: Gather facts

