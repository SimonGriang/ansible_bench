---
- name: Disable swap if vault_hardening_disable_swap is set and swap is currently enabled
  when: vault_hardening_disable_swap and (ansible_swaps | map(attribute='swap')) | any
  command: swapoff -a
  register: disable_swap_result
  changed_when: disable_swap_result.stdout_lines is defined
  notify: disable swap permanently

- name: Disable core dumps if vault_hardening_disable_core_dumps is set
  when: vault_hardening_disable_core_dumps
  lineinfile:
    path: /etc/security/limits.conf
    line: "*       hard    core    0"
    create: yes
  notify: reload pam limits

- name: Disable shell command history for vault commands if vault_hardening_disable_shell_command_history is set
  when: vault_hardening_disable_shell_command_history
  template:
    src: disable_vault_history.sh.j2
    dest: /etc/profile.d/disable_vault_history.sh
    mode: '0755'

- name: Configure SELinux and/or AppArmor if vault_hardening_configure_selinux_apparmor is set
  when: vault_hardening_configure_selinux_apparmor
  block:
    - name: Ensure selinux-policy is installed
      package:
        name: selinux-policy
        state: present
      when: ansible_system == "Linux" and ansible_os_family == "RedHat"

    - name: Set SELinux policy to enforcing
      lineinfile:
        path: /etc/selinux/config
        regexp: '^SELINUX='
        line: 'SELINUX=enforcing'
      when: ansible_system == "Linux" and ansible_os_family == "RedHat" and ansible_selinux|default(false)

    - name: Enforce AppArmor profile for vault
      command: aa-enforce /etc/apparmor.d/{{ vault_apparmor_profile }}
      when: ansible_system == "Linux" and vault_apparmor_profile is defined

  notify: restart vault service

