---
- name: Create SSL key for each item
  community.crypto.openssl_privatekey:
    path: "{{ item.key_path }}"
    size: 2048
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0600'
  loop: "{{ ssl_items }}"
  register: ssl_keys

- name: Create SSL CSR for each item
  community.crypto.openssl_csr:
    path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    subject: "{{ item.subject }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0600'
  loop: "{{ ssl_items }}"
  register: ssl_csrs

- name: Create SSL certificates for each item
  community.crypto.x509_certificate:
    path: "{{ item.cert_path }}"
    privatekey_path: "{{ item.key_path }}"
    csr_path: "{{ item.csr_path }}"
    provider: selfsigned
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0600'
  loop: "{{ ssl_items }}"
  register: ssl_certs

- name: Create PKCS#12 file for each item
  community.crypto.openssl_pkcs12:
    path: "{{ item.pkcs12_path }}"
    name: "{{ item.common_name }}"
    privatekey_path: "{{ item.key_path }}"
    certificate_path: "{{ item.cert_path }}"
    export_key: yes
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0600'
  loop: "{{ ssl_items }}"
  register: ssl_pkcs12

- name: Read private key for each item
  ansible.builtin.slurp:
    src: "{{ item.key_path }}"
  loop: "{{ ssl_items }}"
  register: private_key_content

- name: Read certificate for each item
  ansible.builtin.slurp:
    src: "{{ item.cert_path }}"
  loop: "{{ ssl_items }}"
  register: cert_content

- name: Create a combined private key and certificate file for each item
  ansible.builtin.copy:
    content: "{{ item.private_key_content.content | b64decode }}{{ item.cert_content.content | b64decode }}"
    dest: "{{ item.combined_path }}"
    mode: '0600'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"
  register: combined_files

