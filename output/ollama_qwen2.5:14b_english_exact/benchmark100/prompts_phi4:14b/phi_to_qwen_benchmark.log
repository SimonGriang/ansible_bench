---
- name: Ensure the unzip package is installed
  apt:
    name: unzip
    state: present
  when: promtail_apt_update_cache == 'true'
  register: unzip_installed
  notify: update_cache

- name: Create a group for Promtail
  group:
    name: "{{ promtail_system_group }}"
    state: present
  when: promtail_system_group != "root"

- name: Create a user for Promtail
  user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    groups: "{{ promtail_user_additional_groups }}"
    create_home: "{{ 'yes' if promtail_system_user == 'root' else 'no' }}"
    shell: /usr/sbin/nologin
    system: yes
  when: promtail_system_user != "root"

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: 0755

- name: Create necessary configuration directories for Promtail
  file:
    path: "{{ item }}"
    state: directory
    mode: 0770
    owner: root
    group: "{{ promtail_system_group }}"
  with_items:
    - /etc/promtail
    - /etc/promtail/file_sd
    - /etc/promtail/positions

- name: Create application directories for Promtail
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
  with_items:
    - /usr/local/promtail
    - /var/lib/promtail
    - /var/log/promtail

- name: Check if the Promtail binary exists
  stat:
    path: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail"
  register: promtail_binary

- name: Download Promtail binaries if not present locally
  get_url:
    url: "{{ promtail_dist_url }}"
    dest: "{{ promtail_tmp_dir }}/promtail.tar.gz"
    checksum: "{{ promtail_custom_checksum | default('SKIP') }}"
  when: not promtail_binary.stat.exists

- name: Propagate a locally distributed Promtail archive
  copy:
    src: "{{ promtail_local_dir }}/promtail.tar.gz"
    dest: "{{ promtail_tmp_dir }}/promtail.tar.gz"
  when: not promtail_binary.stat.exists and promtail_local_dir is defined

- name: Download Promtail binaries to the controller node
  get_url:
    url: "{{ promtail_dist_url }}"
    dest: "{{ promtail_tmp_dir }}/promtail.tar.gz"
    checksum: "{{ promtail_custom_checksum | default('SKIP') }}"
  when: promtail_binary_propagate == True

- name: Propagate Promtail binaries across nodes
  copy:
    src: "{{ promtail_tmp_dir }}/promtail.tar.gz"
    dest: "{{ promtail_tmp_dir }}/promtail.tar.gz"
  when: promtail_binary_propagate == True

- name: Unpack the Promtail binaries
  unarchive:
    src: "{{ promtail_tmp_dir }}/promtail.tar.gz"
    dest: "{{ promtail_install_dir }}/{{ promtail_version }}"
    remote_src: yes
  register: promtail_extracted
  when: not promtail_binary.stat.exists
  notify: symlink_promtail

- name: Create a symlink to the latest version of Promtail
  file:
    src: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail"
    dest: /usr/local/bin/promtail
    state: link
  when: not promtail_binary.stat.exists
  notify: restart_promtail

- name: Write the Promtail configuration file
  template:
    src: promtail-config.j2
    dest: /etc/promtail/promtail-config.yml
  notify: restart_promtail

- name: Create a systemd service unit for Promtail
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
  notify: restart_promtail


