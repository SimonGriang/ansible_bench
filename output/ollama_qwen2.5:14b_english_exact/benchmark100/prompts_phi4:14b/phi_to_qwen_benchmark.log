---
- name: Install Keepalived when HA mode is enabled
  ansible.builtin.include_tasks: "tasks/keepalived-install.yml"
  when:
    - rke2_ha_mode
    - rke2_keepalived_enabled
    - rke2_api_ip is defined
    - inventory_hostname in groups['rke2_servers']

- name: Download and install RKE2 version
  ansible.builtin.include_tasks: "tasks/rke2-install.yml"
  vars:
    rke2_version: "{{ rke2_version }}"

- name: Apply CIS Hardening
  ansible.builtin.include_tasks: "tasks/cis-hardening.yml"
  when: rke2_cis_profile is defined

- name: Find Active Server
  ansible.builtin.include_tasks: "tasks/find-active-server.yml"

- name: Enable IPVS kernel module
  ansible.builtin.include_tasks: "tasks/ipvs-enable.yml"
  when:
    - rke2_kubevip_ipvs_enabled
    - inventory_hostname in groups['rke2_servers']
    - not rke2_keepalived_enabled
    - rke2_ha_mode

- name: Copy kube-vip manifests to the masternode
  ansible.builtin.include_tasks: "tasks/kube-vip-copy.yml"
  when:
    - rke2_ha_mode
    - rke2_kubevip_ipvs_enabled
    - not rke2_keepalived_enabled

- name: Copy ingress-nginx manifests to the masternode
  ansible.builtin.include_tasks: "tasks/ingress-nginx-copy.yml"
  when:
    - rke2_ingress_nginx_values is defined
    - rke2_ingress_nginx_values | length > 0

- name: Prepare very first server node in the cluster
  ansible.builtin.include_tasks: "tasks/prepare-first-server.yml"
  when: rke2_active_server is not defined or groups['rke2_servers'] | length == 1

- name: Restore etcd specific tasks
  ansible.builtin.include_tasks: "tasks/etcd-restore.yml"
  when:
    - rke2_active_server is defined
    - inventory_hostname == rke2_active_server or groups['rke2_servers'] | length == 1
    - rke2_etcd_restore is defined

- name: Download kubeconfig to ansible localhost
  ansible.builtin.include_tasks: "tasks/kubeconfig-download.yml"
  when: rke2_download_kubeconfig and groups['rke2_servers'] | length == 1

- name: Prepare and join remaining nodes of the cluster
  ansible.builtin.include_tasks: "tasks/prepare-join-remaining.yml"
  when: rke2_active_server is defined and groups['rke2_servers'] | length > 1

- name: Rolling cordon and drain restart when version changes - servers
  ansible.builtin.include_tasks: "tasks/rolling-cordon-restart-servers.yml"
  when:
    - rke2_active_server is defined
    - inventory_hostname in groups['rke2_servers']
    - rke2_version is changed

- name: Rolling cordon and drain restart when version changes - agents
  ansible.builtin.include_tasks: "tasks/rolling-cordon-restart-agents.yml"
  when:
    - rke2_active_server is defined
    - inventory_hostname in groups['rke2_agents']
    - rke2_version is changed

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Rolling restart when config files change
  ansible.builtin.include_tasks: "tasks/rolling-restart.yml"
  when:
    - rke2_active_server is defined
    - inventory_hostname in groups['rke2_servers']
      or inventory_hostname in groups['rke2_agents']
    - rke2_config_files_changed

- name: Final steps
  ansible.builtin.include_tasks: "tasks/final-steps.yml"

