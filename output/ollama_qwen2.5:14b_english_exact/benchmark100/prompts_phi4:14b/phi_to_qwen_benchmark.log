---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install logrotate package
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate with template
  template:
    src: "{{ logrotate_config_file }}"
    dest: "{{ logrotate_config_directory }}/logrotate.conf"
    owner: root
    group: root
    mode: '0644'

- name: Generate logrotate.d configuration files
  template:
    src: entry.j2
    dest: "{{ logrotate_confd_directory }}/{{ item.filename }}"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ logrotate_entries | rejectattr('absent', 'defined') | list }}"
  when: logrotate_confd_directory is defined

- name: Remove logrotate.d configuration files for entries marked as absent
  file:
    path: "{{ logrotate_confd_directory }}/{{ item.filename }}"
    state: absent
  loop: "{{ logrotate_entries | selectattr('absent', 'defined') | list }}"
  when: logrotate_confd_directory is defined

- name: Start and enable the logrotate service
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled | default('yes', true) }}"

