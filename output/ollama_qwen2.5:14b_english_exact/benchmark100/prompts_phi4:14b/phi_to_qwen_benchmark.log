  file:
    path: "{{ item.home }}/.ssh"
    state: directory
    mode: '0700'
  loop: "{{ users | selectattr('ssh_key_management', 'defined') | selectattr('ssh_key_management', 'equalto', true) | list }}"
  when: item.ssh_key_management | defined and item.ssh_key_management | bool or item.private_keys | defined

