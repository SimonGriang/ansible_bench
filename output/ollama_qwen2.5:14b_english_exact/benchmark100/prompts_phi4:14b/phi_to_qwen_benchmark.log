---
- import_tasks: assert.yml
  remote_addr: localhost
  delegate_to: localhost
  run_once: true

- name: Install necessary prerequisites for Vault
  package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include tasks specific to the installation method
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add environment variables for Vault
  lineinfile:
    path: /etc/vault.d/vault.env
    create: yes
    line: "{{ item }}"
    regexp: "{{ item }}"
    state: present
  with_items: "{{ vault_env_vars }}"
  notify: restart vault

- name: Include additional hardening tasks
  include_tasks: hardening.yml

- name: Start and enable Vault service for Open Source Software (OSS)
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable Vault service for non-OSS versions
  service:
    name: vault
