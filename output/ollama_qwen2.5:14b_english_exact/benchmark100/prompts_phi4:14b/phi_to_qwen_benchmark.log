---
- name: Enable Apache2 modules
  when: ansible_facts.os_family in ['Debian', 'Suse']
  block:
    - lineinfile:
        path: /etc/apache2/mods-available/proxy.load
        line: LoadModule proxy_module /usr/lib/apache2/modules/mod_proxy.so
        create: yes
      notify: validate_httpd_config
    - lineinfile:
        path: /etc/apache2/mods-available/proxy_http.load
        line: LoadModule proxy_http_module /usr/lib/apache2/modules/mod_proxy_http.so
        create: yes
      notify: validate_httpd_config

- name: Configure Apache2 locations
  template:
    src: location.conf.j2
    dest: /etc/apache2/sites-available/{{ item }}
    owner: root
    group: root
    mode: 0644
  with_items: "{{ httpd_locations }}"
  notify: validate_httpd_config
  notify: restart_httpd

