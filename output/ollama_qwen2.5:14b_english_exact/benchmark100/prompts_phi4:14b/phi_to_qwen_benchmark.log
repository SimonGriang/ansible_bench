\n  register: combined_files' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-24T15:44:58.420483013Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12253314748, 'load_duration': 98289960, 'prompt_eval_count': 657, 'prompt_eval_duration': 375512317, 'eval_count': 515, 'eval_duration': 11771638157, 'model_name': 'qwen2.5:14b'} id='run--e2a2c379-7ab0-4e94-9369-9dfdb49c47b1-0' usage_metadata={'input_tokens': 657, 'output_tokens': 515, 'total_tokens': 1172}
