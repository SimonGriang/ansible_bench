---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install DNS-related packages
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create necessary directories for DNS configuration and data
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"
  loop_control:
    extended: true

- name: Create group for DNS service
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user for the DNS service
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true

- name: Generate the rndc key for DNS configuration
  command: "{{ item }}"
  args:
    creates: "{{ item.split('key-file=').pop() }}"
  loop:
    - rndc-confgen -a -b 256 -k rndc -r /dev/urandom -n /etc/rndc.key
    - openssl enc -aes-256-ecb -in /etc/rndc.key -out /etc/rndc.key -k rndcpassword -p -a -md sha512
  loop_control:
    extended: true

- name: Set file permissions for the rndc key
  file:
    path: /etc/rndc.key
    mode: '0640'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    state: file

- name: Download the root hints file if DNS caching is enabled
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ dns_confdir }}/db.root"
    mode: '0644'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    when: dns_caching
  notify: Rndc reload

- name: Create primary zone files from templates
  template:
    src: "{{ item }}/zone.j2"
    dest: "{{ dns_datadir }}/{{ item }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add DNS zones to the main configuration file
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  notify: Dns restart

- name: Create systemd service override if using systemd
  block:
    - name: Create directory for service overrides
      file:
        path: /etc/systemd/system/named.service.d
        state: directory

    - name: Copy override file
      copy:
        src: override.conf
        dest: /etc/systemd/system/named.service.d/override.conf
        mode: '0644'
  when: "'systemd' in ansible_service_manager"

- name: Start and enable the DNS service
  service:
    name: "{{ dns_service }}"
    enabled: true
    state: started


