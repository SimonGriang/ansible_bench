- name: Generate a private SSH key for users who require SSH key management
  ansible.builtin.shell: >
    if [ ! -f /etc/ssh_keys/{{ item.name }}/id_rsa ]; then
      ssh-keygen -q -N "" -t rsa -f /etc/ssh_keys/{{ item.name }}/id_rsa
    fi
  loop: "{{ users | selectattr('ssh_key_management', 'defined') | selectattr('ssh_key_management', 'equalto', true) | list }}"
  register: ssh_key_generation
  when: item.ssh_key_management is defined and item.ssh_key_management is true

- name: Generate a public SSH key for users who require SSH key management
  ansible.builtin.shell: >
    if [ ! -f /etc/ssh_keys/{{ item.name }}/id_rsa.pub ]; then
      ssh-keygen -y -f /etc/ssh_keys/{{ item.name }}/id_rsa > /etc/ssh_keys/{{ item.name }}/id_rsa.pub
    fi
  loop: "{{ users | selectattr('ssh_key_management', 'defined') | selectattr('ssh_key_management', 'equalto', true) | list }}"
  when: item.ssh_key_management is defined and item.ssh_key_management is true

- name: Convert the SSH key to a PPK format for users who require SSH key management
  ansible.builtin.shell: >
    if [ ! -f /etc/ssh_keys/{{ item.name }}/id_rsa.ppk ]; then
      puttygen /etc/ssh_keys/{{ item.name }}/id_rsa -o /etc/ssh_keys/{{ item.name }}/id_rsa.ppk -O private
    fi
  loop: "{{ users | selectattr('ssh_key_management', 'defined') | selectattr('ssh_key_management', 'equalto', true) | list }}"
  when: item.ssh_key_management is defined and item.ssh_key_management is true

- name: Determine the home directory for users, defaulting to /home if the user is not found
  ansible.builtin.shell: >
    if id -u {{ item.name }} &>/dev/null; then
      echo $(getent passwd {{ item.name }} | cut -d: -f6)
    else
      echo "/home"
    fi
  register: home_directory
  loop: "{{ users }}"
  changed_when: false

- name: Create an .ssh directory in the user's home directory if SSH key management is enabled or private keys need to be set
  file:
    path: "{{ item.home }}/.ssh"
    state: directory
    mode: '0700'
  loop: "{{ users | selectattr('ssh_key_management', 'defined') | selectattr('ssh_key_management', 'equalto', true) | list }}"
  when: item.ssh_key_management is defined and item.ssh_key_management is true or item.private_keys is defined

- name: Deploy authorized SSH keys for users if specified
  lineinfile:
    path: "{{ item.home }}/.ssh/authorized_keys"
    line: "{{ lookup('file', '/etc/ssh_keys/{{ item.name }}/id_rsa.pub') }}"
    create: yes
    mode: '0600'
  loop: "{{ users | selectattr('ssh_keys', 'defined') | list }}"
  when: item.ssh_keys is defined

- name: Remove unauthorized SSH keys from users if specified
  lineinfile:
    path: "{{ item.home }}/.ssh/authorized_keys"
    regexp: "{{ lookup('file', '/etc/ssh_keys/{{ item.name }}/id_rsa.pub') }}"
    state: absent
  loop: "{{ users | selectattr('unauthorized_ssh_keys', 'defined') | list }}"
  when: item.unauthorized_ssh_keys is defined

- name: Copy generated private SSH keys to the user's .ssh directory if specified
  copy:
    src: "/etc/ssh_keys/{{ item.name }}/id_rsa"
    dest: "{{ item.home }}/.ssh/id_rsa"
    mode: '0600'
  loop: "{{ users | selectattr('ssh_key_management', 'defined') | selectattr('ssh_key_management', 'equalto', true) | list }}"
  when: item.ssh_key_management is defined and item.ssh_key_management is true and item.copy_private_key is defined

- name: Check the password validity period for users
  ansible.builtin.shell: >
    awk -F: '($1 == "{{ item.name }}") {print $3}' /etc/shadow
  loop: "{{ users }}"
  register: password_validity_period
  changed_when: false

- name: Set the password validity period for users if a specific duration is defined
  ansible.builtin.shell: >
    chage --maxdays {{ item.validity_days }} {{ item.name }}
  loop: "{{ users | selectattr('validity_days', 'defined') | list }}"
  when: item.validity_days is defined

- name: Place additional private key files in the user's .ssh directory if specified
  copy:
    src: "{{ item.key_file }}"
    dest: "{{ item.home }}/.ssh/{{ item.key_file | basename }}"
    mode: '0600'
  loop: "{{ users | selectattr('additional_private_keys', 'defined') | map('extract', hash=item, path='additional_private_keys') | list }}"
  when: item.additional_private_keys is defined

