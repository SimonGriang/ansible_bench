---
- name: Generate SSL private key files for each item
  community.crypto.openssl_privatekey:
    path: "{{ item.key_path }}"
    mode: "{{ item.key_mode }}"
    owner: "{{ item.key_owner }}"
    group: "{{ item.key_group }}"
  loop: "{{ ssl_items }}"
  register: private_keys

- name: Generate SSL CSR files for each item
  community.crypto.openssl_csr:
    path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    mode: "{{ item.csr_mode }}"
    owner: "{{ item.csr_owner }}"
    group: "{{ item.csr_group }}"
    common_name: "{{ item.common_name }}"
  loop: "{{ ssl_items }}"
  register: csrs

- name: Generate SSL certificates for each item
  community.crypto.x509_certificate:
    path: "{{ item.crt_path }}"
    privatekey_path: "{{ item.key_path }}"
    csr_path: "{{ item.csr_path }}"
    mode: "{{ item.crt_mode }}"
    owner: "{{ item.crt_owner }}"
    group: "{{ item.crt_group }}"
    signing_privatekey_path: "{{ item.key_path }}"
    signing_cert_path: "{{ item.crt_path }}"
  loop: "{{ ssl_items }}"
  register: certificates

- name: Create PKCS#12 files for each item
  community.crypto.openssl_pkcs12:
    path: "{{ item.pkcs12_path }}"
    privatekey_path: "{{ item.key_path }}"
    certificate_path: "{{ item.crt_path }}"
    mode: "{{ item.pkcs12_mode }}"
    owner: "{{ item.pkcs12_owner }}"
    group: "{{ item.pkcs12_group }}"
    friendly_name: "{{ item.pkcs12_friendly_name }}"
  loop: "{{ ssl_items }}"
  register: pkcs12_files

- name: Read and register the content of the private key files for each item
  ansible.builtin.slurp:
    src: "{{ item.key_path }}"
  loop: "{{ ssl_items }}"
  register: private_key_content

- name: Read and register the content of the certificate files for each item
  ansible.builtin.slurp:
    src: "{{ item.crt_path }}"
  loop: "{{ ssl_items }}"
  register: certificate_content

- name: Combine the registered private key and certificate content into a single file for each item
  ansible.builtin.copy:
    content: "{{ (private_key_content.results[item.index].stdout + certificate_content.results[item.index].stdout) | b64decode }}"
    dest: "{{ item.bundle_path }}"
    mode: "{{ item.bundle_mode }}"
    owner: "{{ item.bundle_owner }}"
    group: "{{ item.bundle_group }}"
  loop: "{{ ssl_items }}"
  register: combined_files

