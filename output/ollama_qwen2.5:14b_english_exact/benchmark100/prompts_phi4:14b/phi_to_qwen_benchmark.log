---
- name: Restart the RKE2 service
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  ansible.builtin.shell: kubectl get nodes --no-headers | grep -q ' Ready' && echo $(kubectl get nodes --no-headers | grep ' Ready' | wc -l)
  register: node_count
  until: node_count.stdout | int == groups[rke2_cluster_group_name] | length
  retries: 100
  delay: 15
  delegate_to: localhost
  when: not ansible_check_mode
  environment:
    PIPESTATUS: '0'

- name: Wait for all pods to be ready again
  ansible.builtin.shell: kubectl get pods --no-headers | grep -E -q ' Running| Completed' && echo $(kubectl get pods --no-headers | grep -E ' Running| Completed' | wc -l)
  register: pod_count
  until: pod_count.stdout | int == groups[rke2_cluster_group_name] | length
  retries: 100
  delay: 15
  delegate_to: localhost
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready is defined
  environment:
    PIPESTATUS: '0'


