---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Enable the Redis module for RHEL 8
  dnf:
    name: redis
    state: enabled
  when: ansible_distribution == 'RedHat' and ansible_distribution_major_version == '8'

- name: Install Redis packages
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ redis_packages }}"
  when: ansible_os_family == 'RedHat'

- name: Configure Redis with a template
  template:
    src: redis_config.j2
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: restart_redis

- name: Start and enable the Redis service
  systemd:
    name: "{{ redis_service }}"
    state: started
    enabled: true


