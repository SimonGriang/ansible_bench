---
- name: Collect the OS release information from the bootstrap server
  shell: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  failed_when: false
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"
  run_once: true
  delegate_to: "{{ bootstrap_server }}"
  delegate_facts: true

- name: Set bootstrap facts for distribution and major version
  set_fact:
    bootstrap_distribution: "{{ bootstrap_facts.stdout_lines.PRETTY_NAME.split()[0] }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout_lines.PRETTY_NAME.split()[1].split('.')[0] }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is undefined
    - bootstrap_facts.stdout_lines.PRETTY_NAME | match('PRETTY_NAME')
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

- name: Set bootstrap facts for the OS family
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  loop: "{{ bootstrap__os_family_map }}"
  when: bootstrap_distribution is defined
  register: os_family_result
  changed_when: false
  failed_when: false
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

