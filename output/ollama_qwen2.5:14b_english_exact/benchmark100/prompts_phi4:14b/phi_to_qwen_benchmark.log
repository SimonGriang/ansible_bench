    - name: Gather bootstrap facts
      setup:
  become: false

- name: Gather Ansible facts
  setup:
  become: false

- name: Install necessary packages
  package:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become | default(true) }}"

