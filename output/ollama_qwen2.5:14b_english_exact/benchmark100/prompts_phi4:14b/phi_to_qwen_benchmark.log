\n\n        - name: Push local artifacts to remote\n          synchronize:\n            src: /tmp/{{ item.name }}\n            dest: /var/lib/rancher/rke2/artifacts/{{ item.name }}\n            delete: yes\n            checksum: yes\n          with_items: "{{ rke2_local_artifacts_download.results }}"\n          when: rke2_artifacts_download.results[item.sha256].failed\n      when: rke2_artifacts_download.results[item.sha256].failed\n\n    - name: Retry downloading RKE2 installation script\n      get_url:\n        url: "{{ rke2_installer_url }}"\n        dest: /var/lib/rancher/rke2/bin/rke2-install\n        mode: \'0755\'\n        timeout: 60\n      when: rke2_artifacts_download.results[item.sha256].failed\n\n- name: Copy local RKE2 artifacts if in airgap mode using the \'copy\' method\n  copy:\n    src: "{{ item.src }}"\n    dest: /var/lib/rancher/rke2/artifacts/{{ item.dest }}\n    mode: \'0644\'\n    force: true\n  with_items: "{{ rke2_artifacts }}"\n  when: rke2_airgap_mode and rke2_airgap_implementation == \'copy\'\n\n- name: Handle additional tarballs in airgap mode if not using \'exists\' implementation\n  block:\n    - name: Create RKE2 additional tarballs directory\n      file:\n        path: /var/lib/rke2/additional-tarballs\n        state: directory\n        mode: \'0755\'\n      when: rke2_airgap_mode and rke2_airgap_implementation != \'exists\'\n\n    - name: Copy additional tarballs to the RKE2 additional tarballs directory\n      copy:\n        src: "{{ item }}"\n        dest: /var/lib/rke2/additional-tarballs/{{ item.split(\'/\')[-1] }}\n        mode: \'0644\'\n        force: true\n      with_items: "{{ rke2_airgap_copy_additional_tarballs }}"\n      when: rke2_airgap_mode and rke2_airgap_implementation != \'exists\'\n\n- name: Ensure artifacts exist and have acceptable permissions in airgap mode with \'exists\' implementation\n  block:\n    - name: Ensure RKE2 artifacts directory exists\n      file:\n        path: /var/lib/rke2/artifacts\n        state: directory\n        mode: \'0755\'\n      when: rke2_airgap_mode and rke2_airgap_implementation == \'exists\'\n\n    - name: Ensure RKE2 installation script has executable permissions\n      file:\n        path: /var/lib/rancher/rke2/bin/rke2-install\n        mode: \'0755\'\n      when: rke2_airgap_mode and rke2_airgap_implementation == \'exists\'\n\n- name: Populate service facts\n  service_facts:\n\n- name: Get filesystem statistics for the /usr/local directory\n  command: stat -fc \'%i %s %a %b %c %d %g %h %i %k %l %n %o %u %X %Y %Z\' /usr/local\n  register: fs_stat\n\n- name: Check if /usr/local is on a separate partition\n  command: cat /proc/mounts | grep \'/usr/local \'\n  register: mount_info\n  changed_when: false\n  failed_when: false\n\n- name: Determine the RKE2 binary path based on filesystem checks\n  set_fact:\n    rke2_bin_path: "{{ \'/var/lib/rancher/rke2/bin\' if mount_info.stdout.strip() else \'/usr/local/bin\' }}"\n  when: fs_stat.stdout.split()[5] != \'0\'\n\n- name: Check the installed and running RKE2 versions\n  command: /var/lib/rancher/rke2/bin/rke2-install query\n  register: rke2_query\n  changed_when: false\n  failed_when: false\n\n- name: Set RKE2 version facts based on the version check results\n  set_fact:\n    rke2_installed_version: "{{ rke2_query.stdout }}"\n  when: not ansible_check_mode\n\n- name: Prevent accidental RKE2 downgrade unless explicitly allowed\n  assert:\n    that:\n      - rke2_required_version is version(\'>=\', rke2_installed_version)\n    msg: "Downgrade of RKE2 from {{ rke2_installed_version }} to {{ rke2_required_version }} is not allowed unless explicitly permitted."\n\n- name: Run RKE2 install script if the version needs to be updated\n  block:\n    - name: Run RKE2 install script\n      shell: /var/lib/rancher/rke2/bin/rke2-install install --token \'{{ rke2_token }}\' --channel \'{{ rke2_channel }}\' --cluster-cidr \'{{ rke2_cluster_cidr }}\' --service-cidr \'{{ rke2_service_cidr }}\' --kubelet-arg=\'node-ip={{ rke2_node_ip }}\' --kubelet-arg=\'node-label={{ rke2_node_label }}\'\n      when: rke2_required_version is version(\'!=\', rke2_installed_version)\n      environment:\n        RKE2_AIRGAP: "{{ \'true\' if rke2_airgap_mode else \'false\' }}"\n        RKE2_AIRGAP_IMPLEMENTATION: "{{ rke2_airgap_implementation }}"\n        RKE2_ADDITIONAL_TARBALLS: "{{ \'/var/lib/rke2/additional-tarballs\' if rke2_airgap_copy_additional_tarballs|length > 0 else \'\' }}"\n        RKE2_ARTIFACTS_DIR: "/var/lib/rancher/rke2/artifacts"\n  when: rke2_required_version is version(\'!=\', rke2_installed_version)\n\n- name: Copy custom manifests if they are defined\n  copy:\n    src: "{{ item }}"\n    dest: /etc/rancher/rke2/manifests/\n    mode: \'0644\'\n    force: true\n  with_items: "{{ rke2_custom_manifests }}"\n  when: rke2_custom_manifests|length > 0\n\n- name: Copy static pods if they are defined\n  copy:\n    src: "{{ item }}"\n    dest: /etc/kubernetes/manifests/\n    mode: \'0644\'\n    force: true\n  with_items: "{{ rke2_static_pods }}"\n  when: rke2_static_pods|length > 0\n\n- name: Copy RKE2 environment file if environment options are defined\n  copy:\n    src: "{{ rke2_env_file }}"\n    dest: /etc/rancher/rke2/rke2-env\n    mode: \'0644\'\n    force: true\n  when: rke2_env_file is defined and rke2_env_file != ""' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-24T16:09:12.550201583Z', 'done': True, 'done_reason': 'stop', 'total_duration': 44861556975, 'load_duration': 88599455, 'prompt_eval_count': 1402, 'prompt_eval_duration': 763997959, 'eval_count': 2017, 'eval_duration': 44001730939, 'model_name': 'qwen2.5:14b'} id='run--ffb793f2-d1f0-4344-8c67-f1ff22973a3a-0' usage_metadata={'input_tokens': 1402, 'output_tokens': 2017, 'total_tokens': 3419}
