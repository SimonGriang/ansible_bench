---
- import_tasks: assert.yml

- name: Install the git package
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if the git user exists in the system
  getent:
    database: passwd
    key: "{{ git_username }}"
    fail_key_absent: false

- name: Create a directory for the git configuration
  file:
    path: /home/{{ git_username }}
    state: directory
    mode: '0755'
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when: >
    git_username is defined and
    git_username in lookup('getent', 'passwd', 'filter={{ git_username }}')

- name: Place the git configuration file
  template:
    src: gitconfig.j2
    dest: /home/{{ git_username }}/.gitconfig
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0644'
  when: >
    git_username is defined and
    git_username in lookup('getent', 'passwd', 'filter={{ git_username }}')

- name: Create the repository destination directory
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    mode: '0755'
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
  when: >
    git_username is defined and
    git_repository_destination is defined and
    git_username in lookup('getent', 'passwd', 'filter={{ git_username }}')

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version | default('master') }}"
    accept_hostkey: yes
    force: "{{ item.force | default('no') }}"
    update: yes
    clone: yes
    remote: origin
  loop: "{{ git_repositories }}"
  when: >
    git_username is defined and
    git_repository_destination is defined and
    git_username in lookup('getent', 'passwd', 'filter={{ git_username }}')

