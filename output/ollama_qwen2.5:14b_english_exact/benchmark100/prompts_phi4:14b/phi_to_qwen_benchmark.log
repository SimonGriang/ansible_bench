---
- name: Load OS-specific variables
  include_vars:
    file: "{{ 'vars/' ~ ansible_distribution ~ '.yml' | default('vars/main.yml') }}"

- name: Include RedHat setup tasks
  include_tasks: setup-RedHat.yml
  when: ansible_os_family == 'RedHat'

- name: Include Debian setup tasks
  include_tasks: setup-Debian.yml
  when: ansible_os_family == 'Debian'

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  when: ansible_version < '2.12' or ansible_os_family not in ['RedHat', 'Debian']

- name: Install Docker packages with allow_downgrade
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: true
  notify: restart docker
  when: ansible_version >= '2.12' and ansible_os_family in ['RedHat', 'Debian']

- name: Install Docker Compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  when: ansible_version < '2.12' and docker_install_compose_plugin and ansible_os_family not in ['RedHat', 'Debian']

- name: Install Docker Compose plugin with allow_downgrade
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: true
  notify: restart docker
  when: ansible_version >= '2.12' and docker_install_compose_plugin and ansible_os_family in ['RedHat', 'Debian']

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    state: directory
    mode: '0755'
  when: docker_daemon_options is defined

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options | to_json }}"
    dest: /etc/docker/daemon.json
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options is defined

- name: Ensure Docker service is started and enabled
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled | bool }}"
  ignore_errors: yes
  when: docker_service_manage | bool

- name: Flush handlers
  meta: flush_handlers

- name: Include Docker Compose setup tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose | bool

- name: Retrieve Docker group information
  getent:
    database: group
    key: docker
    split: ':'
  when: docker_users is defined

- name: Determine if any users need to be added to the Docker group
  set_fact:
    at_least_one_user_to_modify: true
  when: docker_users | difference(docker_group_members) | length > 0

- name: Include tasks to modify user group memberships
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify is defined


