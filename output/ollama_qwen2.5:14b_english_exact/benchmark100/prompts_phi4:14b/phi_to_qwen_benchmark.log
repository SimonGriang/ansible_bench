---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk package manager
  ansible.builtin.package:
    name: "*"
    state: latest
    update_cache: yes
  when: ansible_pkg_mgr == "apk"
  notify: reboot

- name: Configure apt package manager
  block:
    - ansible.builtin.apt:
        state: held
        name: "{{ item }}"
      loop: "{{ apt_hold_packages | default([]) | bool }}"
      when: ansible_pkg_mgr == "apt"
      notify: reboot

    - ansible.builtin.apt:
        update_cache: yes
        upgrade: yes
        environment:
          DEBIAN_FRONTEND: noninteractive
      when: ansible_pkg_mgr == "apt"
      notify: reboot

    - ansible.builtin.apt:
        autoremove: "{{ apt_autoremove | default('false') | bool }}"
      when: ansible_pkg_mgr == "apt"
      notify: reboot

- name: Update all software using dnf package manager
  ansible.builtin.package:
    name: "*"
    state: latest
    exclude: "{{ dnf_exclude | default([]) }}"
  when: ansible_pkg_mgr == "dnf" or ansible_pkg_mgr == "dnf5"
  notify: reboot

- name: Update all software using pacman package manager
  ansible.builtin.package:
    name: "@system"
    state: present
  when: ansible_pkg_mgr == "pacman"
  notify: reboot

- name: Configure yum package manager
  block:
    - ansible.builtin.package:
        name: "*"
        state: latest
      when: ansible_pkg_mgr == "yum" and ansible_distribution_major_version == "6"
      notify: reboot

    - ansible.builtin.package:
        name: "*"
        state: latest
      when: ansible_pkg_mgr == "yum" and ansible_distribution_major_version != "6"
      notify: reboot

    - ansible.builtin.package:
        name: "yum-utils"
        state: present
      when: ansible_pkg_mgr == "yum" and ansible_distribution_major_version != "6"
      notify: reboot

- name: Update all software using zypper package manager
  ansible.builtin.package:
    name: "*"
    state: latest
  when: ansible_pkg_mgr == "zypper"
  notify: reboot

- name: Final line to ensure new line at end of file

