---
- name: Import additional tasks from assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for a specific port to be available
  wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection not in ['docker', 'podman', 'lxc']
    - bootstrap_wait_for_host

- name: Test connection and check for sudo availability
  block:
    - name: Test the connection
      ping:
    - name: Check sudo availability
      command: whoami | grep root
      changed_when: false
      failed_when: false
      register: sudo_check
    - name: Gather bootstrap facts
      setup:
        gather_subset: "!all"
      when: sudo_check is failed
    - name: Install necessary bootstrap packages
      raw: "{{ item }}"
      with_items:
        - "dnf -y update && dnf -y install python3-dnf-plugins-core libdnf5"
      when:
        - ansible_facts['os_family'] == 'RedHat'
        - sudo_check is failed
      register: bootstrap_packages
      failed_when: false
      changed_when: false
    - name: Install necessary bootstrap packages for other OS families
      raw: "{{ item }}"
      with_items:
        - "apt-get update && apt-get install -y python3-apt"
      when:
        - ansible_facts['os_family'] != 'RedHat'
        - sudo_check is failed
      register: bootstrap_packages
      failed_when: false
      changed_when: false

- name: Gather Ansible facts
  setup:
    gather_subset: "!all"
    become: no

- name: Install bootstrap packages
  yum:
    name: "{{ item }}"
    state: present
    update_cache: yes
    become: "{{ bootstrap_become }}"
  with_items: "{{ bootstrap_facts_packages }}"
  when: ansible_facts['os_family'] == 'RedHat'
  register: installed_packages
  failed_when: false
  changed_when: false

- name: Install bootstrap packages
  apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
    become: "{{ bootstrap_become }}"
  with_items: "{{ bootstrap_facts_packages }}"
  when: ansible_facts['os_family'] != 'RedHat'
  register: installed_packages
  failed_when: false
  changed_when: false

