---
- import_tasks: assert.yml
  remote_src: yes
  vars:
    ansible_host: localhost

- name: Install mysql
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_packages }}"
  notify:
    - set_mysql_root_password
    - systemd-reload

- name: Configure mysql server
  template:
    src: "{{ mysql_configuration_destination }}"
    dest: "{{ mysql_configuration_destination }}"
    mode: '0644'
  notify:
    - set_mysql_root_password
    - systemd-reload
  vars:
    mysql_name: "{{ mysql_name }}"
    mysql_configuration_options: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  lineinfile:
    path: "{{ mysql_configuration_destination }}"
    regexp: '^socket\s*='
    line: "socket={{ mysql_socket }}"
    insertafter: EOF
  notify:
    - set_mysql_root_password
    - systemd-reload

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_facts["os_family"] in ['Alpine', 'Archlinux']
  notify:
    - set_mysql_root_password
    - systemd-reload

- name: Start and enable mysql
  systemd:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    check_implicit_admin: yes
    login_host: localhost
  with_items: "{{ mysql_databases }}"
  no_log: "{{ 'true' if mysql_root_password else 'false' }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    check_implicit_admin: yes
    login_host: localhost
  with_items: "{{ mysql_users }}"
  no_log: "{{ 'true' if mysql_root_password else 'false' }}"

- name: Flush handlers again
  meta: flush_handlers

