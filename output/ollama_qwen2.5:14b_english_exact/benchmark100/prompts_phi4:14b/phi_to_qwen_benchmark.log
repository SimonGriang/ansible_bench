---
- name: Create document root directories for HTTP virtual hosts
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts|default([]) }}"
  when:
    - item is defined
    - item.documentroot is defined
    - create_docroot is not defined or create_docroot is not false

- name: Configure virtual host configuration files using templates
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts|default([]) }}"
  notify:
    - test httpd config
    - restart httpd service

- name: Enable virtual hosts on Debian-based systems
  become: yes
  shell: a2ensite {{ item.name }}.conf
  loop: "{{ httpd_vhosts|default([]) }}"
  when: ansible_os_family == 'Debian'
  notify:
    - test httpd config
    - restart httpd service

