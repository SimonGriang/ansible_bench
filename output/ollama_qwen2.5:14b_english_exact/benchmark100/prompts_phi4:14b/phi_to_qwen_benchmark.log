m.mode }}"\n    owner: root\n    group: root\n  with_items:\n    - { src: "ca.crt", dest: "ca.crt", mode: "0644" }\n    - { src: "ta.key", dest: "ta.key", mode: "0600" }\n\n- name: Deploy the OpenVPN server configuration file\n  template:\n    src: openvpn.conf.j2\n    dest: /etc/openvpn/server/openvpn.conf\n    mode: 0644\n  notify: restart_openvpn_server' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-24T15:28:40.023702298Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16135292801, 'load_duration': 96540018, 'prompt_eval_count': 856, 'prompt_eval_duration': 439159166, 'eval_count': 706, 'eval_duration': 15589527657, 'model_name': 'qwen2.5:14b'} id='run--bb4a349a-e472-44f7-a0a1-322b3c77e9ed-0' usage_metadata={'input_tokens': 856, 'output_tokens': 706, 'total_tokens': 1562}
