---
- name: Install the EPEL repository package when system is Amazon Linux 2 or Red Hat-based systems
  when: ansible_os_family == "RedHat" and (ansible_distribution_major_version in ['7', '8', '9', '10'] or ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2')
  block:
    - name: Install EPEL GPG key
      ansible.builtin.rpm_key:
        key: "{{ epel_gpg_key }}"
        state: present

    - name: Install EPEL-release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache

- name: Install the GPG key for the EPEL repository
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install the EPEL-release package
  ansible.builtin.package:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Optionally install the EPEL-next-release package if epel_next variable is set
  when: epel_next | default(false)
  ansible.builtin.package:
    name: "{{ epel_next_url }}"
    state: present
  notify: Update package cache

- name: Update package cache
  ansible.builtin.yum:
    name: "@repolist"
    state: list
  listen: Update package cache
