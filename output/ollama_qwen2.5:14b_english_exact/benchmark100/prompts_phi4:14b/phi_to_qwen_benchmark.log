---
- name: Install Ansible
  package:
    name: ansible
    state: "{{ ansible_package_state }}"
  become: true
  when: ansible_distribution == "CentOS" or ansible_distribution == "Fedora"

- name: Enable EPEL repository
  yum:
    name: "{{ ansible_epel_repo_name }}"
    state: enabled
  become: true
  when: ansible_distribution == "CentOS" or ansible_distribution == "Fedora"

- name: Install Ansible
  apt:
    name: ansible
    state: "{{ ansible_package_state }}"
  become: true
  when: ansible_distribution == "Ubuntu"


