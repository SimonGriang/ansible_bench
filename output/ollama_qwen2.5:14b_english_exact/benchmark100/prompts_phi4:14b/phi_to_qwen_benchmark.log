---
- name: Gather bootstrap facts
  raw: cat /etc/os-release
  register: bootstrap_facts
  check_mode: false
  changed_when: false

- name: Set bootstrap distribution facts
  set_fact:
    bootstrap_distribution: "{{ bootstrap_os_family_map[item] }}"
    bootstrap_distribution_major_version: "{{ bootstrap_os_release['PRETTY_NAME'] | regex_replace('^[^0-9.]*([0-9]+\\.[0-9]+).*$', '\\1') }}"
  when:
    - bootstrap_facts is defined
    - bootstrap_distribution is not defined
  loop: "{{ bootstrap_os_family_map.keys() }}"
  register: distribution_facts
  when: bootstrap_os_family_map[item] is search(bootstrap_os_release['PRETTY_NAME'])

- name: Set bootstrap operating system family
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  when:
    - distribution_facts is defined
    - distribution_facts.results|map(attribute='ansible_facts.bootstrap_distribution')|select('defined')|list|length > 0
  loop: "{{ distribution_facts.results|json_query('[].ansible_facts.bootstrap_distribution')|flatten|unique }}"
  loop_control:
    loop_var: item

