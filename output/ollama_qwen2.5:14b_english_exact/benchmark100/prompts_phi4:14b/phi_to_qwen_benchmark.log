---
- import_tasks: assert.yml
  remote_src: yes
  vars:
    ansible_host: localhost

- name: Install cron
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ cron_packages }}"

- name: Configure shell
  lineinfile:
    path: /etc/cron.conf
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    create: yes
  notify: restart cron

- name: Configure path
  lineinfile:
    path: /etc/cron.conf
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    create: yes
  notify: restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/cron.conf
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    create: yes
  notify: restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ""

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined

- name: Ensure cron is running
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is not defined or cron_service == ""

