---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk package manager
  ansible.builtin.package:
    name: "*"
    state: latest
    update_cache: yes
  when: ansible_pkg_mgr == "apk"
  notify: reboot

- name: Configure apt package manager
  block:
    - ansible.builtin.apt:
        state: held
        name: "{{ item }}"
      loop: "{{ apt_hold_packages }}"
      when: ansible_pkg_mgr == "apt"
      notify: reboot

    - ansible.builtin.apt:
        update_cache: yes
        upgrade: yes
        environment:
          DEBIAN_FRONTEND: noninteractive
      when: ansible_pkg_mgr == "apt"
      notify: reboot

    - ansible.builtin.apt:
        autoremove: yes
      when: ansible_pkg_mgr == "apt" and apt_autoremove
      notify: reboot

- name: Update all software using dnf package manager
  ansible.builtin.package:
    name: "*"
    state: latest
    exclude: "{{ dnf_exclude }}"
  when: ansible_pkg_mgr == "dnf" or ansible_pkg_mgr == "dnf5"
  notify: reboot

