ion': 281272698, 'eval_count': 417, 'eval_duration': 10924546920, 'model_name': 'qwen2.5:14b'} id='run--766ac14c-f0a4-4957-b0de-e39b07c1832f-0' usage_metadata={'input_tokens': 1110, 'output_tokens': 417, 'total_tokens': 1527}
