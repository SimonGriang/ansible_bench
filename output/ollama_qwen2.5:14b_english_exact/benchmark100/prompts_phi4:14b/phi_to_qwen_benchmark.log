---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for the specified port to be available
  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection != "docker"
    - ansible_connection != "docker-engine"
    - bootstrap_wait_for_host | default(true)

