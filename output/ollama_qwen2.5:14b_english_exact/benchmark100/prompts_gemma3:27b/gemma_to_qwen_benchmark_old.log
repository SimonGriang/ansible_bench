---
- import_tasks: assert.yml
  run_once: true
  when: inventory_hostname == 'localhost'

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: "{{ java_version }}-openjdk"
    state: present
  when: java_vendor == 'openjdk'
  environment:
    USE: '-X'

- name: Install RPM
  block:
    - name: Copy RPM file to /tmp/
      copy:
        src: "{{ java_rpm }}"
        dest: /tmp/oracle-java.rpm
    - name: Install Oracle Java RPM
      package:
        name: /tmp/oracle-java.rpm
        state: present
  when: java_source == 'local' and java_format == 'rpm'

- name: Install DEB
  block:
    - name: Copy DEB file to /tmp/
      copy:
        src: "{{ java_deb }}"
        dest: /tmp/oracle-java.deb
    - name: Install Oracle Java DEB
      package:
        name: /tmp/oracle-java.deb
        state: present
  when: java_source == 'local' and java_format == 'deb'

- name: Install oracle java (rpm) (repository)
  package:
    name: "{{ oracle_java_rpm }}"
    state: present
  when: java_source == 'repository' and java_format == 'rpm'

- name: Configure oracle targz
  block:
    - name: Ensure installation directory exists
      file:
        path: "{{ oracle_targz_dir }}"
        state: directory
        mode: '0755'
    - name: Extract Oracle Java archive
      unarchive:
        src: "{{ oracle_targz }}"
        dest: "{{ oracle_targz_dir }}"
        remote_src: yes
  when: java_format == 'targz' and java_vendor == 'oracle'

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ jce_zip }}"
    dest: /usr/java/jce/
    remote_src: yes
  when: java_jce == true and java_version == '8' and java_vendor == 'oracle'

- name: Set alternative (targz)
  command: alternatives --install /usr/bin/java java /usr/java/jdk1.8.0_{{ jce_version }}/bin/java 100
  when: java_format == 'targz' and ansible_distribution != 'Alpine' and java_vendor == 'oracle'

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java
  register: java_bin_path
  changed_when: false
  when: java_format == 'targz' and java_vendor == 'oracle'

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_bin_path.stdout | dirname }}"
    create: yes
  when: java_format == 'targz' and java_vendor == 'oracle'

