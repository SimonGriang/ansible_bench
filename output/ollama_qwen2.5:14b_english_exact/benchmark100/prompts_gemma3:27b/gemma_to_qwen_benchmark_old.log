---
- name: Check Java Certificate Existence
  stat:
    path: "{{ item }}"
  register: check_java_certs
  loop: "{{ java_certs }}"

- name: Fail if Java Certificate Doesn't Exist
  fail:
    msg: "Java certificate {{ item.item }} does not exist."
  when: not item.stat.exists
  loop: "{{ check_java_certs.results }}"

- name: Set Keystore Directory for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: (java_keystore_dir is not defined) or (java_keystore_dir == None) and java_open_jdk_version_major < 11

- name: Set Keystore Directory for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: (java_keystore_dir is not defined) or (java_keystore_dir == None) and java_open_jdk_version_major >= 11

- name: Import SSL Certificates into Java Keystore
  java_cert:
    cert: "{{ item }}"
    keystore: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/{{ java_keystore_name }}"
    keystore_password: "{{ java_cert_keystore_pass }}"
    alias: "{{ item | basename | regex_replace('\\\\.[^.]+$', '') }}"
    state: present
  loop: "{{ java_certs }}"

