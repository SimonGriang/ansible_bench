- name: Configure sysvinit service
  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]
  template:
    src: sysvinit.j2
    dest: /etc/init.d/{{ item.name }}
    owner: root
    group: root
    mode: 0755
  loop: "{{ service_list }}"
  notify: restart service
  tags:
    - sysvinit
    - service
  register: sysvinit_result

- name: Ensure sysvinit service is enabled
  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]
  sysv_setdefaults:
    name: "{{ item.name }}"
    default_runlevel: 2345
    enabled: yes
  loop: "{{ service_list }}"
  notify: restart service
  tags:
    - sysvinit
    - service
  when: sysvinit_result.changed
  register: sysvinit_enable_result

- name: Ensure sysvinit service is started
  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]
  service:
    name: "{{ item.name }}"
    state: started
    enabled: yes
  loop: "{{ service_list }}"
  tags:
    - sysvinit
    - service
  when: sysvinit_enable_result.changed

