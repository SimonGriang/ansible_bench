---
- name: Ensure the easy-rsa directory exists
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize the easy-rsa PKI
  ansible.builtin.command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  register: init_pki_result
  changed_when: "'PKI init' in init_pki_result.stdout"

- name: Build the Certificate Authority (CA)
  ansible.builtin.command: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'
  register: build_ca_result
  changed_when: "'Certificate Authority is created' in build_ca_result.stdout"

- name: Generate Diffie-Hellman parameters
  ansible.builtin.command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  register: gen_dh_result
  changed_when: "'Diffie-Hellman parameters' in gen_dh_result.stdout"

- name: Build the server certificate
  ansible.builtin.command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'
  register: build_server_cert_result
  changed_when: "'server certificate and key' in build_server_cert_result.stdout"

- name: Build the client certificate
  ansible.builtin.command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'
  register: build_client_cert_result
  changed_when: "'client certificate and key' in build_client_cert_result.stdout"

- name: Generate the Certificate Revocation List (CRL)
  ansible.builtin.command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  register: gen_crl_result
  changed_when: "'CRL created' in gen_crl_result.stdout"

- name: Generate TLS authentication key
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    chdir: /etc/openvpn/easy-rsa
  register: gen_tls_auth_result
  changed_when: "'TLS Auth Key' in gen_tls_auth_result.stdout"

- name: Copy PKI files to the server configuration directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/{{ item }}
    owner: root
    group: root
    mode: '0640'
  with_items:
    - ca.crt
    - dh.pem
    - ta.key
    - client.crt
    - server.crt
    - ca.key
    - client.key
    - server.key

- name: Copy ca.crt and ta.key to /etc/openvpn
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/{{ item }}
    owner: root
    group: root
    mode: '0640'
  with_items:
    - ca.crt
    - ta.key

- name: Place the server configuration file
  ansible.builtin.template:
    src: server.conf.j2
    dest: "{{ openvpn_configuration_directory }}/server.conf"
    owner: root
    group: root
    mode: '0640'
  notify: Restart openvpn


