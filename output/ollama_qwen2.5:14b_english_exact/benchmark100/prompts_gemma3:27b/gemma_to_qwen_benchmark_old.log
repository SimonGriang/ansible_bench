---
- name: Enable the Backports repository for Debian
  apt:
    repo: "deb http://deb.debian.org/debian {{ ansible_facts.os_release.version|default('jessie', true) }}-backports main"
    filename: "backports.{{ ansible_facts.os_release.version|default('jessie', true) }}.list"
  when: ansible_facts.os_family == 'Debian' and ansible_facts.os_release.version_int < 9
  notify: update_apt_cache

- name: Set the default_release fact for older Debian versions
  set_fact:
    ansible_default_release: "{{ 'jessie-backports' if ansible_facts.os_release.version_int < 9 else 'stable-backports' }}"
  when: ansible_facts.os_family == 'Debian' and ansible_facts.os_release.version_int < 9

- name: Install Ansible
  apt:
    name: ansible
    state: "{{ ansible_package_state|default('latest') }}"
    version: "{{ ansible_default_release }}"
  when: ansible_facts.os_family == 'Debian' and ansible_facts.os_release.version_int < 9

- name: Include handler to update apt cache
  include_tasks: update_apt_cache.yml
  listen: update_apt_cache

