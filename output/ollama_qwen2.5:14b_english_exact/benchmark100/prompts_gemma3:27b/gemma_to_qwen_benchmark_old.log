---
- name: Install Keepalived when HA mode is enabled
  include_tasks: keepalived.yml
  when: rke2_ha_mode and inventory_hostname in groups[rke2_servers_group_name] and rke2_api_ip is defined

- name: Download and install RKE2
  include_tasks: rke2.yml
  vars:
    rke2_version: "{{ rke2_version }}"

- name: CIS Hardening
  include_tasks: cis.yml
  when: rke2_cis_profile|length > 0

- name: Find Active Server
  include_tasks: find_active_server.yml

- name: Enable IPVS kernel module
  include_tasks: ipvs.yml
  when: rke2_kubevip_ipvs_lb_enable and inventory_hostname in groups[rke2_servers_group_name] and rke2_ha_mode and not rke2_use_keepalived

- name: Copy kube-vip manifests to the masternode
  include_tasks:
    - kubevip.yml
    - copy_kubevip.yml
  when: rke2_ha_mode and rke2_kubevip and not rke2_use_keepalived and groups[rke2_servers_group_name|first]

- name: Copy ingress-nginx manifests to the masternode
  include_tasks:
    - ingress-nginx.yml
    - copy_ingress_nginx.yml
  when: rke2_ingress_nginx_values|length > 0 and groups[rke2_servers_group_name|first]

- name: Prepare very first server node in the cluster
  include_tasks: first_server.yml
  when: inventory_hostname in groups[rke2_servers_group_name] and (rke2_active_server is not defined or groups[rke2_cluster_group_name]|length == 1)

- name: Restore etcd specific tasks
  include_tasks: first_server_restore.yml
  when: rke2_active_server is defined and (inventory_hostname == rke2_active_server or inventory_hostname in groups[rke2_servers_group_name]) and (rke2_do_etcd_restore is defined or rke2_do_etcd_restore_from_s3 is defined)

- name: Download kubeconfig to ansible localhost
  include_tasks: download_kubeconfig.yaml
  when: rke2_download_kubeconf and inventory_hostname in groups[rke2_servers_group_name|first]

- name: Prepare and join remaining nodes of the cluster
  include_tasks: remaining_nodes.yml
  when: rke2_active_server is defined and groups[rke2_cluster_group_name]|length >= 2

- name: Rolling cordon and drain restart when version changes - servers
  include_tasks: rolling_restart_servers.yml
  when: rke2_installed_version is defined and rke2_installed_version != rke2_version and inventory_hostname in groups[rke2_servers_group_name]

- name: Rolling cordon and drain restart when version changes - agents
  include_tasks: rolling_restart_agents.yml
  when: rke2_installed_version is defined and rke2_installed_version != rke2_version and inventory_hostname not in groups[rke2_servers_group_name] and inventory_hostname in groups[rke2_agents_group_name]

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  include_tasks: rolling_restart.yml
  when: rke2_restart_needed

- name: Final steps
  include_tasks: summary.yml

