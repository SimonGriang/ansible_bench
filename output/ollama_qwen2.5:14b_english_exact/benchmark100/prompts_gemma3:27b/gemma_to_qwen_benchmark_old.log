---
- import_tasks: assert.yml
  remote_src: yes
  run_once: true
  delegate_to: localhost

- name: Configure apk
  block:
    - name: Update apk cache and upgrade all software
      apk:
        update_cache: yes
        upgrade: yes
        yes: yes
      notify: Reboot

- name: Configure apt
  block:
    - name: Prevent upgrades for excluded packages
      apt:
        name: "{{ item }}"
        state: present
        upgrade: never
      loop: "{{ update_excluded_packages }}"
      when: "'{{ ansible_facts.packages|d({})[item] }}' is version '2.0', 'version'"

    - name: Update apt cache and upgrade all software
      apt:
        update_cache: yes
        upgrade: dist
        autoremove: "{{ apt_autoremove | d(False) | bool }}"
      notify: Reboot

- name: Update all software (dnf)
  dnf:
    name: "*"
    state: latest
    update_excludes: "{{ update_excluded_packages }}"
  notify: Reboot
  when: ansible_facts.packages is version 'dnf' or ansible_facts.packages is version 'dnf5'

- name: Update all software (pacman)
  pacman:
    sync:
      - "--refresh"
      - "--sysupgrade"
  notify: Reboot
  when: ansible_facts.packages is version 'pacman'

- name: Configure yum
  block:
    - name: Update yum cache and upgrade all software
      yum:
        name: "*"
        state: latest
        update_excludes: "{{ update_excluded_packages }}"
      notify: Reboot

    - name: Handle different yum versions
      block:
        - name: Handle yum version 6
          yum:
            name: "*"
            state: latest
            update_excludes: "{{ update_excluded_packages }}"
            update_cache: yes
          when: ansible_facts.packages is version '6', 'version'
          notify: Reboot

        - name: Handle yum version other than 6
          yum:
            name: "*"
            state: latest
            update_excludes: "{{ update_excluded_packages }}"
          when: ansible_facts.packages is version '6', 'version', 'ne'
          notify: Reboot

- name: Update all software (zypper)
  zypper:
    name: "*"
    state: latest
  notify: Reboot
  when: ansible_facts.packages is version 'zypper'

