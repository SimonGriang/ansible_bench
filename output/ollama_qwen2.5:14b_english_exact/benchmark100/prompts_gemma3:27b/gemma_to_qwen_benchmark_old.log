---
- import_tasks: assert.yml
  remote_src: yes
  run_once: true
  delegate_to: localhost

- name: Configure apk
  block:
    - name: Update apk cache and upgrade all software
      apk:
        update_cache: yes
        upgrade: yes
        yes: yes
      notify: Reboot

- name: Configure apt
  block:
    - name: Prevent upgrades for excluded packages
      apt:
        name: "{{ item }}"
        state: present
        upgrade: never
      loop: "{{ update_excluded_packages }}"
      when: "'{{ ansible_facts.packages|d({})[item] }}' is version '2.0'"

    - name: Update apt cache and upgrade all software
      apt:
        update_cache: yes
        upgrade: dist
        autoremove: "{{ apt_autoremove|bool }}"
      notify: Reboot

- name: Update all software (dnf)
  dnf:
    name: "*"
    state: latest
    update_excludes: "{{ update_excluded_packages }}"
