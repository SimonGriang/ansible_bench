  ansible.builtin.meta: eval="when: ansible_facts['os_family'] == 'RedHat' and (ansible_facts['distribution_major_version'] in ['7', '8', '9', '10'] or ansible_facts['distribution'] == 'Amazon')"

- name: Install epel gpg key
  ansible.builtin.yum_key:
    state: present
    key: "{{ epel_gpg_key }}"

- name: Install epel-release package
  ansible.builtin.yum:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Install epel-next-release package
  ansible.builtin.yum:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next | bool
  notify: Update package cache


