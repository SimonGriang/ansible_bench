d: no\n  notify: Restart keepalived\n\n- name: Flush handlers\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-10T22:56:01.08960566Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10883058109, 'load_duration': 85879376, 'prompt_eval_count': 856, 'prompt_eval_duration': 315643339, 'eval_count': 606, 'eval_duration': 10469806726, 'model_name': 'qwen2.5:14b'} id='run--3967c317-8806-4b7e-bf2d-f16de90be7e7-0' usage_metadata={'input_tokens': 856, 'output_tokens': 606, 'total_tokens': 1462}
