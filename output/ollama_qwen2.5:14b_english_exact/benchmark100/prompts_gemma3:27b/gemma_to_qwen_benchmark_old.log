---
- import_tasks: assert.yml
  run_once: true
  remote_addr: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/mysql_name-server.cnf
    regexp: '^#?{{ item.key }}'
    line: "{{ item.key }} = {{ item.value }}"
    create: yes
  with_dict: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/mysql_name-client.cnf
    regexp: '^#?socket'
    line: "socket = {{ mysql_socket }}"
    create: yes

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_host: localhost
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_port: "{{ mysql_socket | int }}"
  with_items: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.username }}"
