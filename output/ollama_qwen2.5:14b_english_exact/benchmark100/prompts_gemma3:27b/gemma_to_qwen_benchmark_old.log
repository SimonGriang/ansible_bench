content='---\n- import_tasks: assert.yml\n\n- name: Install python pip\n  package:\n    name: "{{ python_pip_packages }}"\n    state: present\n\n- name: Configure pip proxy\n  block:\n    - name: Ensure pip configuration directory exists\n      file:\n        path: /etc/pip.conf\n        state: directory\n        mode: \'0755\'\n    - name: Configure pip proxy settings\n      lineinfile:\n        path: /etc/pip.conf\n        line: "index-url = {{ python_pip_proxy }}"\n        state: present\n  when: python_pip_proxy is defined\n  notify: restart_pip\n\n- name: Trust hosts\n  block:\n    - name: Ensure pip configuration directory exists\n      file:\n        path: /etc/pip.conf\n        state: directory\n        mode: \'0755\'\n    - name: Set trusted hosts\n      lineinfile:\n        path: /etc/pip.conf\n        line: "trusted-host = {{ python_pip_trusted_host }}"\n        state: present\n  when: python_pip_trusted_host is defined\n  notify: restart_pip\n\n- name: Update pip\n  pip:\n    name: "{{ python_pip_pip_package }}"\n    state: "{{ python_pip_pip_state }}"\n    executable: "{{ python_pip_executable }}"\n  when: ansible_facts[\'os_info\'][\'name\'] not in [\'Debian\', \'bookworm\', \'noble\', \'Alpine\']\n  register: update_pip_result\n\n- name: Install requested modules\n  pip:\n    name: "{{ item.name }}"\n    version: "{{ item.version }}"\n    state: "{{ item.state }}"\n    executable: "{{ python_pip_executable }}"\n  loop: "{{ python_pip_modules }}"\n  when: ansible_facts[\'os_info\'][\'name\'] not in [\'Debian\', \'bookworm\', \'noble\', \'Alpine\']\n  notify: restart_pip\n  label: "{{ item.name }}"\n\n#' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-10T22:06:49.658567948Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7526027250, 'load_duration': 87841060, 'prompt_eval_count': 1218, 'prompt_eval_duration': 91579187, 'eval_count': 416, 'eval_duration': 7334283868, 'model_name': 'qwen2.5:14b'} id='run--3c12c5a0-d755-4630-b44a-d2c01e07af0d-0' usage_metadata={'input_tokens': 1218, 'output_tokens': 416, 'total_tokens': 1634}
