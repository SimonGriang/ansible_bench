  template:
    src: vsftpd.conf.j2
    dest: "{{ vsftpd_configuration_file }}"
    owner: root
    group: root
    mode: "{{ vsftpd_configuration_file_mode }}"
  notify: Restart vsftpd

- name: Start and enable vsftpd service
  systemd:
    name: vsftpd
    state: started
    enabled: yes

