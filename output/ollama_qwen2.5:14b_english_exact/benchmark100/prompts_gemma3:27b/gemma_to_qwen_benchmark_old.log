---
- import_tasks: assert.yml
  remote_user: localhost

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  block:
    - name: Ensure pip configuration directory exists
      file:
        path: /etc/pip.conf
        state: directory
        mode: '0755'
    - name: Configure pip proxy settings
      lineinfile:
        path: /etc/pip.conf
        line: "index-url = {{ python_pip_proxy }}"
        state: present
  when: python_pip_proxy is defined
  notify: restart_pip

- name: Trust hosts
  block:
    - name: Ensure pip configuration directory exists
      file:
        path: /etc/pip.conf
        state: directory
        mode: '0755'
    - name: Set trusted hosts
      lineinfile:
        path: /etc/pip.conf
        line: "trusted-host = {{ python_pip_trusted_host }}"
        state: present
  when: python_pip_trusted_host is defined
  notify: restart_pip

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when: ansible_facts['os_info']['name'] not in ['Debian', 'bookworm', 'noble', 'Alpine']

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version }}"
    state: "{{ item.state }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  when: ansible_facts['os_info']['name'] not in ['Debian', 'bookworm', 'noble', 'Alpine']
  notify: restart_pip
  label: "{{ item.name }}"

