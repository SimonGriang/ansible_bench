---
- ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true
  name: Import assert.yml

- name: Install required packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure selinux
  when:
    - ansible_selinux.status is defined
    - not ansible_local.containerized
  block:
    - name: Manage SELinux state
      ansible.posix.selinux:
        policy: "{{ selinux_policy }}"
        state: "{{ selinux_state }}"
      notify: Reboot

- name: Manage selinux booleans
  when: selinux_booleans is defined
  block:
    - name: Set SELinux booleans
      ansible.posix.seboolean:
        name: "{{ item.boolean }}"
        state: "{{ item.state | default('yes') }}"
        persistent: "{{ item.persists | default(False) }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.boolean }}"

