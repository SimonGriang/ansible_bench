---
- name: lookup bootstrap facts (raw)
  raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  become: "{{ bootstrap_become|default(false) }}"
  become_user: "{{ bootstrap_become_user|default('root') }}"
  ansible_user: bootstrap_user

- name: set bootstrap facts (I) # noqa jinja
  set_fact:
    bootstrap_distribution: "{{ item.value.matched_distribution }}"
    bootstrap_distribution_major_version: "{{ item.value.major_version }}"
  loop: "{{ lookup('dict', bootstrap__os_family_map) }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - item.value.current_os is search(bootstrap_facts.stdout)
  register: _temp
  loop_control:
    label: "{{ item.key }}"
  vars:
    matched_distribution: "{{ item.key }}"
    major_version: "{{ item.value.current_os.split()[1].split('.')[0] }}"
  become: "{{ bootstrap_become|default(false) }}"
  become_user: "{{ bootstrap_become_user|default('root') }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.0 }}"
  loop: "{{ lookup('dict', bootstrap__os_family_map) | dict2items }}"
  when: bootstrap_distribution is defined and bootstrap_distribution in item.value.value
  loop_control:
    label: "{{ item.0 }}"
  become: "{{ bootstrap_become|default(false) }}"
  become_user: "{{ bootstrap_become_user|default('root') }}"

