---
- import_tasks: assert.yml
  delegate_to: localhost
  when: true
  run_once: true

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ selinux_requirements|default([]) }}"
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when:
    - ansible_selinux.status is defined
    - ansible_connection != 'docker'
    - ansible_connection != 'lxc'
  block:
    - name: Enable or disable selinux
      ansible.builtin.selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

- name: Manage selinux booleans
  when: selinux_booleans is defined
  block:
    - name: Set selinux booleans
      ansible.builtin.seboolean:
        name: "{{ item.key }}"
        value: "{{ item.value | default('yes') }}"
        persistent: yes
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.key }}"

