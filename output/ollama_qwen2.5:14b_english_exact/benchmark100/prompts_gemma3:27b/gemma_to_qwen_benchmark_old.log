n  when: >\n    ansible_distribution not in [\'Debian\'] and\n    ansible_distribution_release not in [\'bookworm\', \'noble\'] and\n    ansible_os_family != \'Alpine\'\n  loop_control:\n    label: "{{ item.name }}"' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-10T21:53:44.046609768Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10952784087, 'load_duration': 88307321, 'prompt_eval_count': 1706, 'prompt_eval_duration': 56891680, 'eval_count': 611, 'eval_duration': 10795634317, 'model_name': 'qwen2.5:14b'} id='run--9f824fec-cbe5-49c0-8856-47f33dee799a-0' usage_metadata={'input_tokens': 1706, 'output_tokens': 611, 'total_tokens': 2317}
