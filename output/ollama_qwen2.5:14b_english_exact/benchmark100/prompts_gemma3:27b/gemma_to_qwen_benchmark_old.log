---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_url }}"
    dest: "{{ rke2_install_script_path }}"
  when: not airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ local_rke2_install_script }}"
    dest: "{{ rke2_install_script_path }}"
  when: airgap_mode and rke2_artifact_implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0755'
  when: airgap_mode and rke2_artifact_implementation != 'exists'

- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)
  block:
    - name: Download RKE2 artifacts and checksums remotely
      get_url:
        url: "{{ item.url }}"
        dest: "{{ item.dest }}"
      loop: "{{ rke2_artifacts }}"
      when: airgap_mode and rke2_artifact_implementation == 'remote'
    - name: Download RKE2 artifacts locally and push
      block:
        - name: Download RKE2 artifact locally
          get_url:
            url: "{{ item.url }}"
            dest: "{{ download_path }}/{{ item.dest | basename }}"
          loop: "{{ rke2_artifacts }}"
        - name: Copy downloaded RKE2 artifact to remote
          copy:
            src: "{{ download_path }}/{{ item.dest | basename }}"
            dest: "{{ item.dest }}"
          loop: "{{ rke2_artifacts }}"
      when: airgap_mode and rke2_artifact_implementation == 'local'

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ local_rke2_artifact_path }}/{{ item }}"
    dest: "{{ rke2_artifacts_path }}/{{ item }}"
  loop: "{{ rke2_artifacts }}"
  when: airgap_mode and rke2_artifact_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ rke2_additional_images_tarball }}"
    dest: "{{ rke2_artifacts_path }}/{{ rke2_additional_images_tarball | basename }}"
  when: airgap_mode and rke2_additional_images_tarball is defined

- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged
  file:
    path: "{{ item }}"
    state: file
    mode: '0644'
  loop: "{{ rke2_artifacts }}"
  when: airgap_mode

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: fs_stat

- name: Check if separate partition
  command: "stat -f -c '%t' /usr/local"
  register: fs_partition
  changed_when: false
  failed_when: false

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_path | default('/usr/local/bin/rke2') }}"
  when: fs_partition.stdout == 'hfs' or fs_stat.stat.dev != 0

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }} version --output json"
  register: rke2_version
  changed_when: false
  failed_when: false

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version.stdout | json_query('Server.Version') }}"
    rke2_running_version: "{{ rke2_version.stdout | json_query('Server.Version') }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "'{{ rke2_running_version }}' >= '{{ rke2_target_version }}' or rke2_allow_downgrade"
    msg: "Downgrade to '{{ rke2_target_version }}' is not allowed unless rke2_allow_downgrade is true"

- name: Run RKE2 install script
