- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_path | default('/usr/local/bin/rke2') }}"
  when: fs_partition.stdout == 'hfs' or fs_stat.stat.dev != 0

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }} version --output json"
  register: rke2_version
  changed_when: false
  failed_when: false

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version.stdout | json_query('Server.Version') }}"
    rke2_running_version: "{{ rke2_version.stdout | json_query('Server.Version') }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "'{{ rke2_running_version }}' >= '{{ rke2_target_version }}' or rke2_allow_downgrade"
    msg: "Downgrade to '{{ rke2_target_version }}' is not allowed unless rke2_allow_downgrade is true"

- name: Run RKE2 install script
  shell: >
    {{ rke2_bin_path }} install server --write-kubeconfig-mode 644 --kube-config /etc/rancher/rke2/rke2.yaml
    --token {{ rke2_token }} --server https://{{ rke2_server }}:{{ rke2_server_port }} --tls-san {{ rke2_server }}
    --docker-opt disable-legacy-registries=true --docker-opt experimental-features=true --docker-opt log-level=debug
    --docker-opt log-opt max-size=10m --docker-opt log-opt max-file=3 --docker-opt storage-driver=overlay2
    --docker-opt default-ulimit=stack:1024000000 --docker-opt default-ulimit=nofile:500000
    --docker-opt default-ulimit=memlock:100000000 --docker-opt default-ulimit=core:100000000 --docker-opt default-ulimit=nofile:500000
    --docker-opt default-ulimit=nproc:500000 --docker-opt default-ulimit=as:1000000000 --docker-opt default-ulimit=rss:1000000000
    --kubelet-arg='image-gc-high-threshold=90' --kubelet-arg='image-gc-low-threshold=80'
    --kubelet-arg='eviction-hard=memory.available<100Mi,nodefs.available<10%' --kubelet-arg='eviction-minimum-reclaim=image-fds:300,image-unused:200,nodefs:100Mi'
    --kubelet-arg='eviction-max-extensions=image-fds:50,image-unused:75,nodefs:50Mi' --kubelet-arg='kube-api-qps=20'
    --kubelet-arg='kube-api-burst=40' --kubelet-arg='container-log-max-size=10m' --kubelet-arg='container-log-max-files=3'
    --kubelet-arg='image-pull-progress-deadline=5m' --kubelet-arg='eviction-soft=image-fds:300,image-unused:200,nodefs:100Mi'
    --kubelet-arg='eviction-soft-grace-period=image-fds:1m30s,image-unused:1m30s,nodefs:1m30s'
  environment:
    RKE2_VERSION: "{{ rke2_target_version }}"
    RKE2_TOKEN: "{{ rke2_token }}"
    RKE2_SERVER: "{{ rke2_server }}"
    RKE2_SERVER_PORT: "{{ rke2_server_port }}"
    RKE2_TLS_SAN: "{{ rke2_server }}"

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_dir }}/{{ item | basename }}"
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests is defined

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pod_dir }}/{{ item }}"
    dest: "{{ rke2_agent_dir }}/{{ item }}"
  loop: "{{ rke2_static_pod_manifests }}"
  when: rke2_static_pod_manifests is defined

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: "{{ rke2_env_file_path }}"
    mode: '0644'
  when: rke2_env_file is defined 70%|███████   | 70/100 [1:03:02<50:19, 100.64s/it]

