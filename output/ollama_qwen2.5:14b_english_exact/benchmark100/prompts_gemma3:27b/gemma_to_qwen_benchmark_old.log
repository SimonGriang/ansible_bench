---
- name: Create ssh_key_directory for user
  ansible.builtin.file:
    path: "{{ lookup('env','HOME') }}/.ssh_keys"
    state: directory
    mode: '0700'
  when: user_manage_ssh_key|default(false) == true
  run_once: true
  delegate_to: localhost

- name: Manage user account
  ansible.builtin.user:
    name: "{{ user.name }}"
    comment: "{{ user.comment }}"
    home: "{{ user.home }}"
    create_home: "{{ user.create_home|default(true) }}"
    password: "{{ user.password }}"
    uid: "{{ user.uid|default('') }}"
    group: "{{ user.group|default('') }}"
    shell: "{{ user.shell }}"
    state: "{{ user.state }}"
    expiry: "{{ user.expiry|default('') }}"
    system: "{{ user.system|default(false) }}"
    move_home: "{{ user.move_home|default(false) }}"
  register: user_result

- name: Set sudo options for user
  ansible.builtin.template:
    src: sudoers.j2
    dest: "/etc/sudoers.d/{{ item }}"
    owner: root
    group: root
    mode: '0440'
  when: user.sudoers|default({}) is defined
  loop: "{{ user.sudoers }}"
  loop_control:
    label: "{{ item }}"

- name: Remove sudo options for user
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ item }}"
    state: absent
  when: user.sudoers|default({}) is not defined
  loop: "{{ lookup('ansible.builtin.fileglob', '/etc/sudoers.d/*') }}"
  loop_control:
    label: "{{ item }}"

- name: Generate private ssh key for user
  ansible.builtin.command: ssh-keygen -q -N '' -t rsa -f "{{ lookup('env','HOME') }}/.ssh_keys/id_rsa"
  when: user_manage_ssh_key|default(false) == true
  delegate_to: localhost
  changed_when: false

- name: Generate public ssh key for user
  ansible.builtin.command: cat "{{ lookup('env','HOME') }}/.ssh_keys/id_rsa.pub"
  when: user_manage_ssh_key|default(false) == true
  delegate_to: localhost
  changed_when: false
  register: public_key

- name: Convert ssh key to ppk for user
  ansible.builtin.command: ssh-keygen -p -m PKCS8 -f "{{ lookup('env','HOME') }}/.ssh_keys/id_rsa"
  when: user_manage_ssh_key|default(false) == true
  delegate_to: localhost
  changed_when: false

- name: Get or set the home directory for user
  block:
    - name: Get the user's home directory
      ansible.builtin.command: getent passwd {{ user.name }} | cut -d: -f6
      register: home_dir
      changed_when: false
    - name: Set a fact for the base directory
      ansible.builtin.set_fact:
        user_home_dir: "{{ home_dir.stdout }}"
      when: home_dir.stdout != ""
    - name: Default to /home if user not found
      ansible.builtin.set_fact:
        user_home_dir: /home
      when: home_dir.stdout == ""

- name: Create .ssh directory for user
  ansible.builtin.file:
    path: "{{ user_home_dir }}/.ssh"
    state: directory
    mode: '0700'
  when: user_manage_ssh_key|default(false) == true or user.private_keys|default([]) != []
  become_user: "{{ user.name }}"

- name: Deploy authorized keys for user
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys }}"
  when: user.authorized_keys|default([]) != []

- name: Remove unauthorized keys for user
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys|default([]) != []

- name: Copy generated private ssh key for user
  ansible.builtin.copy:
    src: "{{ lookup('env','HOME') }}/.ssh_keys/id_rsa"
    dest: "{{ user_home_dir }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user_copy_private_key|default(false) == true

- name: Check users password valid time
  ansible.builtin.shell: grep '^{{ user.name }}:' /etc/shadow | cut -d: -f3
  register: password_valid_time
  changed_when: false

- name: Set users password valid time
  ansible.builtin.user:
    name: "{{ user.name }}"
    password_days: "{{ user.password_valid_time }}"
    password_expire: "{{ user.password_valid_time }}"
  when: user.password_valid_time is defined

- name: Place private key file for user
  ansible.builtin.copy:
    content: "{{ user.private_key }}"
    dest: "{{ user_home_dir }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.private_keys|default(false) == true

