---
- name: Migrate from adoptopenjdk to temurin if selected
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
    name: os_vars

- name: Gather architecture specific variables
  include_vars:
    file: architecture.yml

- name: Set OS specific variables (I)
  set_fact:
    java_open_jdk_version: "{{ default(java_open_jdk_version, '11') }}"
    java_openjdk_repo_deb: "{{ default(java_openjdk_repo_deb, 'deb http://deb.debian.org/debian buster-backports main') }}"
    java_openjdk_repo_rpm: "{{ default(java_openjdk_repo_rpm, 'https://repo1.maven.org/maven2/com/sun/java-wrappers/1.8.0/java-wrappers-1.8.0-1.8.0.312-3.el7.noarch.rpm') }}"
    java_required_key_repositories_openjdk: "{{ default(java_required_key_repositories_openjdk, ['https://packages.java.net/java/']) }}"
    java_required_repositories_openjdk: "{{ default(java_required_repositories_openjdk, ['https://packages.java.net/java']) }}"
    java_deprecated_repositories_adoptopenjdk: "{{ default(java_deprecated_repositories_adoptopenjdk, ['deb http://packages.adoptopenjdk.net/ stable jdk', 'deb http://packages.adoptopenjdk.net/ nightly jdk']) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ default(java_open_jdk_home_dir, '/usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk') }}"
    java_open_jdk_package: "{{ default(java_open_jdk_package, 'openjdk-{{ java_open_jdk_version }}-jdk') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Remove deprecated repositories (Debian)
  apt:
    name: "{{ item }}"
    state: absent
  loop: "{{ java_deprecated_repositories_adoptopenjdk }}"
  when:
    - ansible_distribution in ['Debian', 'Ubuntu']
    - item is defined

- name: Install extra apt tools (Debian)
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_apt_extra_packages }}"
  when:
    - ansible_distribution in ['Debian', 'Ubuntu']
    - item is defined

- name: Add required key repositories (Debian)
  apt_key:
    url: "{{ item }}"
  loop: "{{ java_required_key_repositories_openjdk }}"
  when:
    - ansible_distribution in ['Debian', 'Ubuntu']
    - item is defined

- name: Add required repositories (Debian)
  apt_repository:
    filename: "/etc/apt/sources.list.d/java-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}-openjdk.list"
    filename_deb: "{{ java_openjdk_repo_deb }}"
  when:
    - ansible_distribution in ['Debian', 'Ubuntu']
    - item is defined

- name: Add required key repositories (RedHat)
  rpm_key:
    key: "{{ item }}"
  loop: "{{ java_required_key_repositories_openjdk }}"
  when:
    - ansible_distribution_family == "RedHat"
    - item is defined

- name: Add required repositories (RedHat)
  yum_repository:
    name: "java-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}-openjdk"
    description: "Java OpenJDK Repository"
    baseurl: "{{ java_openjdk_repo_rpm }}"
    enabled: 1
    gpgcheck: 1
    gpgkey: "{{ java_required_key_repositories_openjdk }}"
  when:
    - ansible_distribution_family == "RedHat"
    - item is defined

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libs_openjdk }}"
  when:
    - item is defined

- name: Install Java (Debian)
  apt:
    name: "{{ java_open_jdk_package }}={{ java_open_jdk_version }}"
    state: present
  when:
    - ansible_distribution in ['Debian', 'Ubuntu']
    - item is defined

- name: Install Java (RedHat)
  yum:
    name: "{{ java_open_jdk_package }}={{ java_open_jdk_version }}"
    state: present
  when:
    - ansible_distribution_family == "RedHat"
    - item is defined

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh

- name: Source environment variables
  shell: source /etc/profile

- name: Correct java version selected (Debian, Java < 11)
  command: update-alternatives --set java "/usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk-amd64/bin/java"
  when:
    - ansible_distribution in ['Debian', 'Ubuntu']
    - java_open_jdk_version is version_compare("<", "11")

- name: Correct java version selected (Debian, Java >= 11)
  command: update-alternatives --set java "/usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk-amd64/bin/java"
  when:
    - ansible_distribution in ['Debian', 'Ubuntu']
    - java_open_jdk_version is version_compare(">=", "11")

