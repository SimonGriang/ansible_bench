    path: "{{ cron_configuration }}"
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    create: yes
    mode: 0600
  notify: Restart cron

- name: Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    create: yes
    mode: 0600
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    mode: 0600
  notify: Restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    enabled: true
    state: started
  when: cron_service is defined and cron_service|length > 0

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined
  with_items: "{{ cron_jobs }}"

