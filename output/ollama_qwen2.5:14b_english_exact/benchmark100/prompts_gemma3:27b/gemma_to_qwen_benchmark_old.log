content='---\n- name: Restart the RKE2 service\n  service:\n    name: "{{ rke2_service_name }}"\n    state: restarted\n  notify: Service (re)started\n\n- name: Wait for all nodes to be ready\n  shell: "{{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o json | jq \'.items | length as $len | map(select(.status.readyReplicas == $len)) | length\' | awk \'{print $1}\'"\n  register: ready_nodes_count\n  until: ready_nodes_count.stdout | int == groups[rke2_cluster_group_name] | length\n  retries: 100\n  delay: 15\n  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"\n  run_once: true\n\n- name: Wait for all pods to be ready\n  shell: "{{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods --all-namespaces -o json | jq \'.items | length as $len | map(select(.status.phase != "Running" and .status.phase != "Succeeded")) | length\' | awk \'{print $1}\'"\n  register: not_ready_pods_count\n  until: not_ready_pods_count.stdout | int == 0\n  retries: 100\n  delay: 15\n  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"\n  run_once: true\n  when: rke2_wait_for_all_pods_to_be_ready | default(false) and not ansible_check_mode' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-10T22:57:04.435606784Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6544422764, 'load_duration': 82317182, 'prompt_eval_count': 699, 'prompt_eval_duration': 336489234, 'eval_count': 355, 'eval_duration': 6120124636, 'model_name': 'qwen2.5:14b'} id='run--48eb2209-a6f9-47d8-b52c-403dfb3cbaa2-0' usage_metadata={'input_tokens': 699, 'output_tokens': 355, 'total_tokens': 1054}
