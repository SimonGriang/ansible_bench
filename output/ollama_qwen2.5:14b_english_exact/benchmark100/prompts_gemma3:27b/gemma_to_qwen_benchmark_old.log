---
- import_tasks: assert.yml
  remote_src: true
  run_once: true
  delegate_to: localhost

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/mailname
    answer: "{{ ansible_fqdn }}"
  when: ansible_os_family == 'Debian'
  register: debconf_postfix

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    answer: 'No configuration'
  when: ansible_os_family == 'Debian'
  delegate_to: localhost
  changed_when: false

- name: Install postfix
  apt:
    name: postfix
    state: present
  when: ansible_os_family == 'Debian'

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: (postfix_virtual_mailbox_maps_mysql_enable | bool) or (postfix_virtual_domains_mysql_enable | bool)

- name: Configure postfix (transport_maps)
  template:
    src: templates/postfix_transport_maps.j2
    dest: /etc/postfix/transport
  notify: validate_postfix_transport_maps
  when: (postfix_transport_maps_template | default('')) | length > 0

- name: Configure postfix (header_checks)
  template:
    src: templates/postfix_header_checks.j2
    dest: /etc/postfix/header_checks
  notify: validate_postfix_header_checks
  when: (postfix_header_checks_template | default('')) | length > 0

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_facts: "{{ postfix_main_cf_facts | default({}) | combine(postfix_main_cf_facts_1) }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf_facts: "{{ postfix_main_cf_facts | default({}) | combine(postfix_main_cf_facts_2) }}"
  when: (postfix_main_cf_facts_2 | default({})) | count > 0

- name: Configure postfix (main.cf)
  template:
    src: templates/postfix_main.cf.j2
    dest: /etc/postfix/main.cf
  notify: validate_postfix_main_cf
  notify: restart_postfix

- name: Configure postfix (master.cf)
  template:
    src: templates/postfix_master.cf.j2
    dest: /etc/postfix/master.cf
  notify: validate_postfix_master_cf
  notify:
    - restart_postfix

- name: Creates cert/key directory
  file:
    path: "{{ postfix_cert_key_dir | default('/etc/postfix') }}"
    state: directory
  when: postfix_cert_key_dir is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_cert_key_src }}"
    dest: "{{ postfix_cert_key_dir | default('/etc/postfix') }}/postfix.pem"
  when: postfix_cert_key_src is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_cert_key_src }}"
    dest: "{{ postfix_cert_key_dir | default('/etc/postfix') }}/postfix-key.pem"
  when: postfix_cert_key_src is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  command: newaliases
  notify: validate_aliases

- name: Configure sender_access
  copy:
    content: "{{ postfix_sender_access_content }}"
    dest: /etc/postfix/sender_access
  when: postfix_sender_access_content is defined

- name: Configure recipient_access
  copy:
    content: "{{ postfix_recipient_access_content }}"
    dest: /etc/postfix/recipient_access
  when: postfix_recipient_access_content is defined

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: /etc/postfix/sasl_password_map
  when: postfix_sasl_password_map is defined

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemd:
    name: postfix
    state: started
    enabled: true

