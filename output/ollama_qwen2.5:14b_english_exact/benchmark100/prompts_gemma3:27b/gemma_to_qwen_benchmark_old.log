---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: yes
    mode: 0664
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: yes
    mode: 0664
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    path: /etc/default/grub
    regexp: '^\s*GRUB_CMDLINE_LINUX=.*$'
    line: "GRUB_CMDLINE_LINUX={{ item }}"
    create: yes
    mode: 0664
  with_items: "{{ grub_options }}"
  when: grub_options|length > 0
  loop_control:
    loop_var: option
  notify: Update grub

- name: Import password.yml
  import_tasks: password.yml
  when: grub_set_password|default(false)

- name: Flush handlers
  meta: flush_handlers

