---
- import_tasks: assert.yml
  remote_addr: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  when: ansible_facts | lookup('pipe', 'getenforce') | lower == 'enabled'
  block:
    - name: Modify boolean values
      selinux_boolean:
        name: "{{ item.key }}"
        state: "{{ item.value }}"
      loop: "{{ httpd_selinux_booleans | default({}) | dict2items }}"
      when: httpd_selinux_booleans is defined

    - name: Allow connections to specified ports
      selinux_permissive:
        name: "{{ item }}"
      loop: "{{ httpd_selinux_ports | default([]) }}"
      when: httpd_selinux_ports is defined

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
  notify:
    - Test httpd configuration validity
