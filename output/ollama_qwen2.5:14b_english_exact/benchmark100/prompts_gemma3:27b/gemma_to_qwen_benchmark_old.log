    method: GET
    return_content: yes
    status_code: 200
    timeout: 10
    url_password: "{{ GH_TOKEN }}"
    url_username: "{{ GH_USER }}"
    validate_certs: yes
  register: _latest_release
  retries: 5
  delay: 5

