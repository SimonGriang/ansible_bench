---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present
    system: yes
    gid: "{{ dns_group_id | default('') }}"
  when: dns_group is defined

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: yes
    group: "{{ dns_group }}"
    uid: "{{ dns_owner_id | default('') }}"
  when: dns_owner is defined

- name: Generate rndc key
  command: "{{ item }}"
  args:
    creates: "{{ item.split(' ')[-1] }}"
  loop:
    - "rndc-confgen -a -r /dev/urandom -k rndc.key"
  register: rndc_key_output
  changed_when: "'rndc.key' in rndc_key_output.stdout"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    mode: '0640'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hint_url }}"
    dest: "{{ dns_datadir }}/named.root"
    mode: '0644'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns == true
  notify: Rndc reload

- name: Create zone file
  block:
    - name: Render zone file
      template:
        src: zone.j2
        dest: "{{ dns_datadir }}/{{ item.name }}"
        mode: '0644'
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
      notify: Rndc reload
      register: zone_file_result
      failed_when: "'is valid' not in zone_file_result.stdout"
    - name: Validate zone file
      shell: named-checkzone {{ item.name }} {{ dns_datadir }}/{{ item.name }}
      register: zone_validation_result
      failed_when: zone_validation_result.rc != 0
      changed_when: false
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    mode: '0644'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  notify: Restart dns
  register: named_conf_result
  failed_when: "'is valid' not in named_conf_result.stdout"
  changed_when: "'Backup' in named_conf_result.stdout or named_conf_result.changed"

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: "/etc/systemd/system/{{ dns_service }}.d"
        state: directory
        mode: '0755'
        owner: root
        group: root
    - name: Copy systemd override file
      copy:
        src: systemd-override.conf
        dest: "/etc/systemd/system/{{ dns_service }}.d/override.conf"
        mode: '0644'
        owner: root
        group: root
  when: ansible_service_mgr == 'systemd'
  notify: Reload systemd

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    enabled: yes
    state: started

