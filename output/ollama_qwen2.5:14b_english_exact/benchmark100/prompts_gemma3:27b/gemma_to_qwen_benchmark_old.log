---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  ansible.builtin.wait_for_connection:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection is not in ['docker', 'podman']
    - bootstrap_wait_for_host|bool

- name: Prepare system
  block:
    - name: Test connection and sudo
      ansible.builtin.setup:
      failed_when: false
      changed_when: false
  rescue:
    - name: Gather facts in rescue
      ansible.builtin.setup:
    - name: Install bootstrap packages via raw
      ansible.builtin.raw: "{{ item }}"
      loop: "{{ bootstrap_raw_packages }}"
      when: bootstrap_raw_packages|length > 0
    - name: Ensure libdnf5 is present on RedHat-based systems
      ansible.builtin.package:
        name: libdnf5
        state: present
      when: ansible_os_family == 'RedHat'

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ item }}"
    update_cache: yes
    become: "{{ bootstrap_become|bool }}"
  loop: "{{ bootstrap_facts_packages }}"

