    - not enabled_conf_file.exists
  loop: "{{ httpd_vhosts }}"
  vars:
    enabled_conf_file: "{{ lookup('file', '/etc/apache2/sites-enabled/{{ item.name }}.conf') }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

