---
- import_tasks: assert.yml
  remote_src: yes
  run_once: true
  delegate_to: localhost

- block:
  - name: Install repository for RedHat
    get_url:
      url: "{{ hashicorp_repo_url }}"
      dest: /etc/yum.repos.d/hashicorp.repo
      mode: 0640
    when: hashicorp_installation_method == "package" and (ansible_os_family == "RedHat" or ansible_os_family == "Rocky")

  - name: Configure debian
    block:
      - name: Install required package gpg
        apt:
          name: gpg
          state: present
        when: ansible_os_family == "Debian"

      - name: Install apt key for Debian
        apt_key:
          url: "{{ hashicorp_apt_key_url }}"
          validate_certs: no
        when: ansible_os_family == "Debian"

      - name: Install repository for Debian
        apt_repository:
          filename: hashicorp.list
          repo: "deb {{ hashicorp_apt_repo_url }} {{ ansible_distribution_release }} {{ hashicorp_architecture_mapping }}"
          state: present
        when: ansible_os_family == "Debian"
    when: hashicorp_installation_method == "package"

  - name: Install hashicorp product using package
    block:
      - name: Install latest hashicorp product using package
        package:
          name: "{{ item }}"
          state: present
        loop: "{{ hashicorp_products }}"
        when: hashicorp_installation_method == "package" and hashicorp_products is defined
        label: "{{ item }}"
        when: item is version(version_coupler, '<=') | bool

      - name: Install versioned hashicorp product using package
        package:
          name: "{{ item }}{{ version_coupler }}{{ item_version }}"
          state: present
        loop: "{{ hashicorp_products }}"
        when: hashicorp_installation_method == "package" and hashicorp_products is defined and item_version is defined
        label: "{{ item }}-{{ item_version }}"
        when: item is version(version_coupler, '>') | bool
    when: hashicorp_installation_method == "package" and hashicorp_products is defined

  - name: Install hashicorp product manually
    block:
      - name: Install hashicorp product manually
        unarchive:
          src: "{{ hashicorp_src }}"
          dest: "{{ hashicorp_dest }}"
          group: "{{ hashicorp_product_group }}"
          mode: "{{ hashicorp_product_mode }}"
          owner: "{{ hashicorp_product_owner }}"
        loop: "{{ hashicorp_products }}"
        when: hashicorp_installation_method == "manual"
    when: hashicorp_installation_method == "manual"

