content='---\n- name: Download RKE2 kubeconfig to localhost\n  fetch:\n    src: /etc/rancher/rke2/rke2.yaml\n    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    flat: yes\n  delegate_to: localhost\n  when:\n    - rke2_download_kubeconf | bool\n    - inventory_hostname == groups[\'rke2_servers_group_name\'][0]\n\n- name: Replace loopback IP by master server IP\n  replace:\n    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    regexp: \'(127\\.0\\.0\\.1|::1)\'\n    replace: "{{ rke2_api_ip | default(groups[\'rke2_servers_group_name\'][0].ansible_host) }}"\n    delegate_to: localhost\n    become: false\n    check_mode: no\n  when:\n    - rke2_download_kubeconf | bool\n    - inventory_hostname == groups[\'rke2_servers_group_name\'][0]' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-10T22:32:24.924283363Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4098587394, 'load_duration': 123384890, 'prompt_eval_count': 633, 'prompt_eval_duration': 289661562, 'eval_count': 229, 'eval_duration': 3678843061, 'model_name': 'qwen2.5:14b'} id='run--baf43968-99cc-440b-9348-18a342507843-0' usage_metadata={'input_tokens': 633, 'output_tokens': 229, 'total_tokens': 862}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Download RKE2 kubeconfig to localhost
  fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    flat: yes
  delegate_to: localhost
  when:
    - rke2_download_kubeconf | bool
    - inventory_hostname == groups['rke2_servers_group_name'][0]

- name: Replace loopback IP by master server IP
  replace:
    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    regexp: '(127\.0\.0\.1|::1)'
    replace: "{{ rke2_api_ip | default(groups['rke2_servers_group_name'][0].ansible_host) }}"
    delegate_to: localhost
    become: false
    check_mode: no
  when:
    - rke2_download_kubeconf | bool
    - inventory_hostname == groups['rke2_servers_group_name'][0]

