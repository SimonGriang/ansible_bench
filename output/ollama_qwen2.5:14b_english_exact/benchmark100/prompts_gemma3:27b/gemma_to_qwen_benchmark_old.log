lid time\n  ansible.builtin.user:\n    name: "{{ user.name }}"\n    password_days: "{{ user.password_valid_time }}"\n    password_expire: "{{ user.password_valid_time }}"\n  when: user.password_valid_time is defined\n\n- name: Place private key file for user\n  ansible.builtin.copy:\n    content: "{{ user.private_key }}"\n    dest: "{{ user_home_dir }}/.ssh/id_rsa"\n    mode: \'0600\'\n    owner: "{{ user.name }}"\n    group: "{{ user.name }}"\n  when: user.private_keys|default(false) == true\n\n# End of file' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-10T22:14:30.729392481Z', 'done': True, 'done_reason': 'stop', 'total_duration': 21352025324, 'load_duration': 93512562, 'prompt_eval_count': 2247, 'prompt_eval_duration': 689512784, 'eval_count': 1156, 'eval_duration': 20555056804, 'model_name': 'qwen2.5:14b'} id='run--f35288b9-b6e3-413e-95e6-47bd944114bb-0' usage_metadata={'input_tokens': 2247, 'output_tokens': 1156, 'total_tokens': 3403}
