---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  copy:
    src: "{{ rke2_config_template }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: rke2
    group: rke2
    mode: '0640'
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_template }}"
    dest: /etc/systemd/system/kubelet.service.d/10-kubelet.yaml
    owner: root
    group: root
    mode: '0640'
  notify: Config file changed
  when: rke2_kubelet_config|length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_config_template }}"
    dest: /etc/rancher/rke2/95-containerd-registry-config.yaml
    owner: rke2
    group: rke2
    mode: '0640'
  notify: Config file changed
  when: (rke2_custom_registry_mirrors|length > 0) or (rke2_custom_registry_configs|length > 0)

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and rke2_server_service_state == 'absent' }}"
  when: rke2_etcd_snapshot_file is defined

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined }}"
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined

- name: Restore etcd from file
  block:
    - name: Create destination directory
      file:
        path: "{{ etcd_restore_dir }}"
        state: directory
        mode: '0750'
    - name: Copy snapshot
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: "{{ etcd_restore_dir }}"
        remote_src: yes
        mode: '0600'
    - name: Restore etcd
      command: >
        rke2 server --write-kubeconfig-mode=0644 --write-kubeconfig-file=/etc/rancher/rke2/rke2.kubeconfig --server-arg=etcd-snapshot-path={{ etcd_restore_dir }}/{{ rke2_etcd_snapshot_file|basename }} --server-arg=etcd-restore=true
      async: 3600
      poll: 0
      register: etcd_restore_from_file
  when: do_etcd_restore == true

- name: Restore etcd from s3
  command: >
    rke2 server --write-kubeconfig-mode=0644 --write-kubeconfig-file=/etc/rancher/rke2/rke2.kubeconfig --server-arg=etcd-snapshot-s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }} --server-arg=etcd-snapshot-s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }} --server-arg=etcd-snapshot-s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }} --server-arg=etcd-snapshot-s3-key={{ rke2_etcd_snapshot_s3_options.key }} --server-arg=etcd-restore=true
  async: 3600
  poll: 0
  when: do_etcd_restore_from_s3 == true

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    enabled: yes
    state: started
    environment: "RKE2_TOKEN={{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    masked: yes
    enabled: no

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: /v1.20.0/nodes/{{ lookup('ansible_facts', 'ansible_hostname') }}/ready
    url: http://localhost:8080
    sleep: 1
    timeout: 300
  when: rke2_cni_plugin is not defined

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: /v1.20.0/nodes/{{ lookup('ansible_facts', 'ansible_hostname') }}/status
    url: http://localhost:8080
    search_string: '"status": "Ready"'
    sleep: 1
    timeout: 300
  when: rke2_cni_plugin is defined

- name: Restore etcd
  block:
    - name: Get registered nodes
      command: kubectl get nodes -o json | jq -r '.items[].metadata.name'
      register: registered_nodes
    - name: Get node names
      set_fact:
        node_names: "{{ registered_nodes.stdout_lines }}"
    - name: Remove old secrets and nodes
      command: kubectl delete secrets,service,daemonset,poddisruptionbudget --all
      register: remove_old_secrets
  notify: Service (re)started

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ lookup('ansible_facts', 'ansible_hostname') }}"
  delegate_to: "{{ groups[rke2_cluster_group_name] }}"

