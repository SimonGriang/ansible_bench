---
- name: Check if all variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host to be reachable
  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    host: "{{ ansible_ssh_host | default(ansible_host | default(inventory_hostname)) }}"
    timeout: "{{ bootstrap_timeout }}"
  local_action: wait_for
  delegate_to: localhost
  when:
    - ansible_connection is not defined or ansible_connection != 'docker' or ansible_connection != 'container'
    - bootstrap_wait_for_host is defined and bootstrap_wait_for_host == true
  become: "{{ bootstrap_become | default(true) }}"
  become_user: "{{ bootstrap_user | default('root') }}"

- name: Prepare the system
  block:
    - name: Test the connection
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: bootstrap_connect
      failed_when: bootstrap_connect is not defined
      changed_when: bootstrap_connect is not defined
    - name: Debug connection timeout
      debug:
        var: bootstrap_timeout
      when: bootstrap_connect is failed
    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml

- name: Install bootstrap packages
  raw: "{{ bootstrap_install_packages_command }}"
  register: bootstrap_install_packages
  become: "{{ bootstrap_become | default(true) }}"
  become_user: "{{ bootstrap_user | default('root') }}"
  changed_when:
    - bootstrap_os in ['alpine', 'archlinux', 'gentoo']
      and bootstrap_install_packages.stdout | regex_search(bootstrap_install_packages_stdout_re)
    - bootstrap_os not in ['debian', 'redhat', 'rocky', 'suse']
      and not bootstrap_install_packages.stdout | regex_search(bootstrap_install_packages_stdout_re)

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:
    - name: Install packages
      package:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ bootstrap__facts_packages | default([]) }}"

