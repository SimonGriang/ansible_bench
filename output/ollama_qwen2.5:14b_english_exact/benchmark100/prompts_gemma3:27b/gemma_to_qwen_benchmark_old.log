---
- name: Gather service facts
  ansible.builtin.service_facts:

- name: Set the active_server variable
  ansible.builtin.set_fact:
    active_server: "{{ inventory_hostname }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"
  delegate_to: "{{ item }}"
  when: inventory_hostname in groups[rke2_servers_group_name] and (
        ansible_facts.services['rke2-server.service']['state'] == 'running'
      )
  register: _active_server
  changed_when: false


