---
- name: Check OS compatibility
  ansible.builtin.setup:
  register: facts
  changed_when: false

- name: Verify system is Amazon Linux 2 or RedHat-based distribution
  ansible.builtin.meta:
    inject:
      ansible_facts:
        system_compatibility: "{{ 'compatible' if (ansible_facts.distribution|lower in ['amzn', 'redhat'] and ansible_facts.distribution_major_version in ['7', '8', '9']) else 'incompatible' }}"
  when: facts is defined

- name: Install epel gpg key
  ansible.builtin.yum:
    name: "{{ epel_gpg_key }}"
    state: present
  when: ansible_facts.system_compatibility == 'compatible'

- name: Install epel-release package
  ansible.builtin.yum:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache
  when: ansible_facts.system_compatibility == 'compatible'

- name: Install epel-next-release package
  ansible.builtin.yum:
    name: "{{ epel_next_url }}"
    state: present
  notify: Update package cache
  when: ansible_facts.system_compatibility == 'compatible' and epel_next == true

