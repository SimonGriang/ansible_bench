---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0750'
  become: yes

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config_source }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0640'
    owner: root
    group: root
  notify: restart_rke2_service
  become: yes

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_source }}"
    dest: /etc/systemd/system/rke2-server.service.d/kubelet-config.yaml
    mode: '0644'
    owner: root
    group: root
  when: rke2_kubelet_config|length > 0
  notify: restart_rke2_service
  become: yes

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_config_source }}"
    dest: /etc/rancher/rke2/cont-reg.json
    mode: '0644'
    owner: root
    group: root
  when: rke2_custom_registry_mirrors|length > 0 or rke2_custom_registry_configs|length > 
> 0
  notify: restart_rke2_service
  become: yes

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2-server
    enabled: yes
    state: started
    daemon_reload: yes
    masked: false
    environment: RKE2_TOKEN={{ rke2_token }}
  become: yes
  register: rke2_start_result
  notify: restart_rke2_service

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: rke2-{{ rke2_type }}
    enabled: no
    state: masked
  become: yes
  when: rke2_type != 'server'

- name: Wait for remaining nodes to be ready - no CNI
  shell: kubectl get nodes -o json | jq -r '.items[] | select(.status.conditions[].type == "Ready") | .metadata.name'
  register: node_names
  until: node_names.stdout | grep -q 'master'
  retries: 120
  delay: 30
  when: rke2_cni == 'none' and (rke2_active_server or rke2_first_server)

- name: Wait for remaining nodes to be ready - with CNI
  shell: kubectl get nodes -o json | jq -r '.items[] | select(.status.conditions[].type == "Ready") | .metadata.name' | grep -v master | wc -l
  register: ready_nodes_count
  until: ready_nodes_count.stdout | int >= total_nodes - 1
  retries: 120
  delay: 30
  when: rke2_cni != 'none' and (rke2_active_server or rke2_first_server)

