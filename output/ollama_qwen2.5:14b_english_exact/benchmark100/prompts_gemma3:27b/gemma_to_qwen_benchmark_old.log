---
- name: Enable Apache modules
  when: ansible_os_family in ['Debian', 'Suse']
  block:
    - name: Enable 'proxy' module
      apache2ctl:
        module: proxy
        command: enable

    - name: Enable 'proxy_http' module
      apache2ctl:
        module: proxy_http
        command: enable

- name: Configure Apache locations
  template:
    src: location.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item.name }}.conf"
    owner: root
    group: root
    mode: 0644
  with_items: "{{ httpd_locations }}"
  notify: Test httpd configuration validity
  notify: Restart httpd

