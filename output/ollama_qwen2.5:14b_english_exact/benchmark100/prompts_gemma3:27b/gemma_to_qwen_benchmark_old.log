---
- import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - set_root_password
    - systemctl_daemon_reexec

- name: Configure mysql server
  lineinfile:
    path: "{{ mysql_name }}-server.cnf"
    line: "{{ item }}"
    create: yes
  with_items: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  lineinfile:
    path: "{{ mysql_name }}-client.cnf"
    line: "socket={{ mysql_socket }}"
    create: yes

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'ArchLinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    enabled: true
    state: started

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    target: "{{ item }}"
    encoding: utf8
    collation: utf8_general_ci
    login_user: root
    login_host: localhost
    login_port: "{{ mysql_port }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
  with_items: "{{ mysql_databases }}"

- name: List databases
  mysql_info:
    state: list
    login_user: root
    login_host: localhost
    login_port: "{{ mysql_port }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
  register: mysql_databases_info
  debug:
    var: mysql_databases_info

- name: Import database
  mysql_db:
    name: "{{ item }}"
    state: import
    target: "{{ item }}_import.sql"
    login_user: root
    login_host: localhost
    login_port: "{{ mysql_port }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
  when: item in mysql_initial_import_targets and item not in mysql_databases_info.databases
  with_items: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.user }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}{{ item.host }}/*"
    host: "{{ item.host }}"
    login_user: root
    login_host: localhost
    login_port: "{{ mysql_port }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
  with_items: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


