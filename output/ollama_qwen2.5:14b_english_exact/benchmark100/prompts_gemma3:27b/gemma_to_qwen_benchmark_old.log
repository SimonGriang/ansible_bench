content='---\n- import_tasks: assert.yml\n  remote_addr: localhost\n\n- name: Install apache httpd\n  package:\n    name: "{{ httpd_packages }}"\n    state: present\n\n- name: Configure selinux\n  when: ansible_facts | lookup(\'pipe\', \'getenforce\') | lower == \'enabled\'\n  block:\n    - name: Modify boolean values\n      selinux_boolean:\n        name: "{{ item.key }}"\n        state: "{{ item.value }}"\n      loop: "{{ httpd_selinux_booleans | default({}) | dict2items }}"\n      when: httpd_selinux_booleans is defined\n\n    - name: Allow connections to specified ports\n      selinux_permissive:\n        name: "{{ item }}"\n      loop: "{{ httpd_selinux_ports | default([]) }}"\n      when: httpd_selinux_ports is defined\n\n- name: Configure httpd\n  template:\n    src: "{{ httpd_config_src }}"\n    dest: "{{ httpd_config_dest }}"\n  notify:\n    - Test httpd configuration validity\n    - Restart httpd\n\n- name: Activate httpd module | Debian\n  when: ansible_os_family == \'Debian\'\n  shell: a2enmod {{ item }}\n  loop: "{{ httpd_modules_to_activate_with_command | default([]) }}"\n\n- name: Import ssl.yml\n  when: https_ssl_enable is true\n  import_tasks: ssl.yml\n\n- name: Import locations.yml\n  when: httpd_locations is defined\n  import_tasks: locations.yml\n\n- name: Import vhosts.yml\n  when: httpd_vhosts is defined\n  import_tasks: vhosts.yml\n\n- name: Configure ports\n  when: ansible_os_family in [\'Debian\', \'Suse\']\n  template:\n    src: "{{ httpd_ports_conf }}"\n    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"\n  notify:\n    - Test httpd configuration validity\n    - Restart httpd\n\n- name: Import directories.yml\n  when: httpd_directories is defined\n  import_tasks: directories.yml\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Removing default html\n  file:\n    path: "{{ httpd_data_dir }}/index.html"\n    state: absent\n  when: httpd_remove_example is true\n\n- name: Start and enable httpd\n  systemd:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: yes\n\n# Ensuring a newline at the end of the file\n' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-10T22:08:33.331416626Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9231742539, 'load_duration': 96371367, 'prompt_eval_count': 1428, 'prompt_eval_duration': 111415279, 'eval_count': 521, 'eval_duration': 9016315524, 'model_name': 'qwen2.5:14b'} id='run--3651ee6f-018c-4604-87a2-019c9e031e76-0' usage_metadata={'input_tokens': 1428, 'output_tokens': 521, 'total_tokens': 1949}
