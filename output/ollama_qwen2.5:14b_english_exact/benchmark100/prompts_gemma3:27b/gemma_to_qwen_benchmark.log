---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_installer_url }}"
    dest: "/tmp/rke2-install"
  when: not airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_installer_local_path }}"
    dest: "/tmp/rke2-install"
  when: airgap_mode and implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifact_path }}"
    state: directory
    mode: '0755'
  when: airgap_mode and implementation != 'exists'

- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)
  block:
    - name: Download RKE2 artifacts remotely
      get_url:
        url: "{{ rke2_artifact_url }}"
        dest: "{{ rke2_artifact_path }}"
        url_username: "{{ rke2_artifact_username }}"
        url_password: "{{ rke2_artifact_password }}"
        force_basic_auth: yes
      when: airgap_mode and rke2_artifact_url is defined

    - name: Download RKE2 artifacts locally and push to remote
      block:
        - name: Download RKE2 artifacts locally
          get_url:
            url: "{{ rke2_artifact_url }}"
            dest: "/tmp/rke2-artifacts"
            url_username: "{{ rke2_artifact_username }}"
            url_password: "{{ rke2_artifact_password }}"
            force_basic_auth: yes
        - name: Copy RKE2 artifacts to remote host
          copy:
            src: "/tmp/rke2-artifacts"
            dest: "{{ rke2_artifact_path }}"
      when: airgap_mode and rke2_artifact_url is defined and rke2_artifact_url|failed

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifact_local_path }}"
    dest: "{{ rke2_artifact_path }}"
  when: airgap_mode and implementation == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item.src }}"
    dest: "{{ rke2_artifact_path }}"
  loop: "{{ rke2_additional_image_tarballs }}"
  when: airgap_mode and rke2_additional_image_tarballs is defined

- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged
  file:
    path: "{{ item.path }}"
    mode: "{{ item.mode }}"
  loop: "{{ rke2_artifact_paths }}"
  when: airgap_mode and item.path.stat.exists

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local
  register: fs_stats

- name: Check if separate partition
  block:
    - name: Check if /usr/local is on a separate partition
      shell: "stat -f -c %T /usr/local | grep -q /dev"
      register: is_separate_partition
      changed_when: false
      failed_when: false
  when: fs_stats.stat is defined

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ '/usr/local/bin' if is_separate_partition is not defined else '/var/lib/rke2/bin' }}"
  when: fs_stats.stat is defined

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 version"
  changed_when: false
  failed_when: false
  register: rke2_version_output

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version_output.stdout }}"
    rke2_running_version: "{{ rke2_version_output.stdout }}"

- name: Prevent accidental RKE2 downgrade
  fail:
    msg: "RKE2 downgrade is not allowed unless explicitly allowed."
  when: rke2_running_version is defined and rke2_running_version != rke2_version and not allow_downgrade

- name: Run RKE2 install script
