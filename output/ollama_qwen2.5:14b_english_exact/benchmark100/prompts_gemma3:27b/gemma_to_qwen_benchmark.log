---
- import_tasks: assert.yml
  vars:
    ansible_python_interpreter: /usr/bin/python3
  run_once: true
  remote_addr: localhost

- name: Install requirements
  apt:
    name: bash
    state: present
  when: ansible_os_family == 'Debian'

- name: Install openjdk java (package)
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ 'default-jdk' if ansible_os_family == 'Debian' else 'java-openjdk' }}"
  when: java_vendor == "openjdk"
  vars:
    ansible_python_interpreter: /usr/bin/python3
  environment:
    USE: '-Dnatives'

- name: Install RPM
  copy:
    src: "{{ java_path }}"
    dest: /tmp/oracle-java.rpm
    remote_src: yes
  when: java_source == "local" and java_format == "rpm"
  register: java_rpm
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: Install DEB
  copy:
    src: "{{ java_path }}"
    dest: /tmp/oracle-java.deb
    remote_src: yes
  when: java_source == "local" and java_format == "deb"
  register: java_deb
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: Install oracle java (rpm) (repository)
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ ['oracle-java8-installer'] if ansible_os_family == 'Debian' else ['java-oracle'] }}"
  when: java_source == "repository" and java_format == "rpm"
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: Configure oracle targz
  block:
    - name: Ensure installation directory exists
      file:
        path: /opt/java
        state: directory
        mode: '0755'
      vars:
        ansible_python_interpreter: /usr/bin/python3

    - name: Extract archive
      unarchive:
        src: "{{ java_path }}"
        dest: /opt/java
        remote_src: yes
        creates: /opt/java/{{ java_version }}/bin/java
      when: java_format == "targz" and java_vendor == "oracle"
      vars:
        ansible_python_interpreter: /usr/bin/python3

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ jce_path }}"
    dest: /opt/java/{{ java_version }}/jce
    remote_src: yes
    creates: /opt/java/{{ java_version }}/jce/unlimited
  when: java_jce == true and java_version == "8" and java_vendor == "oracle"
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: Set alternative (targz)
  command: "{{ item }}"
  loop:
    - alternatives --install /usr/bin/java java /opt/java/{{ java_version }}/bin/java 20000 --slave /usr/bin/keytool keytool /opt/java/{{ java_version }}/bin/keytool --slave /usr/bin/oracle-java-corba corba /opt/java/{{ java_version }}/jre/lib/corba/ext/corbaloc3.prop --slave /usr/bin/oracle-java-cacerts cacerts /opt/java/{{ java_version }}/jre/lib/security/cacerts
    - alternatives --set java /opt/java/{{ java_version }}/bin/java
  when: java_format == "targz" and java_vendor == "oracle" and ansible_distribution != "Alpine"
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: Find JAVA_HOME
  shell: readlink -f /usr/bin/java | xargs -n 1 dirname
  register: java_home
  changed_when: false
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME="{{ java_home.stdout }}"'
    create: yes
  when: not java_home.stat.exists
  vars:
    ansible_python_interpreter: /usr/bin/python3

