---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection is not 'docker'
    - bootstrap_wait_for_host
  become: false

- name: Prepare system
  block:
    - name: Test connection
      ping:
    - name: Verify sudo access
      command: whoami
      become: true
  rescue:
    - name: Gather bootstrap facts
      setup:
    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages | default([]) }}"
        state: present
      when: bootstrap_facts_packages is defined
      become: "{{ bootstrap_become | default(true) }}"

- name: Gather ansible facts
  setup:
  become: false

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages | default([]) }}"
    state: present
  become: "{{ bootstrap_become | default(true) }}"

# Note: The final newline is intentionally added to comply with yamllint's new-line-at-end-of-file rule.

