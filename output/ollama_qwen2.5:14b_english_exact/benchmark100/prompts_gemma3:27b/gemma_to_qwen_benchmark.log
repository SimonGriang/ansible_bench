t_tasks: directories.yml\n  when: httpd_directories is defined\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Removing default html\n  file:\n    path: "{{ httpd_data_dir }}/index.html"\n    state: absent\n  when: httpd_remove_example is defined and httpd_remove_example\n\n- name: Start and enable httpd\n  service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: yes\n\n# Ensuring there is a newline at the end of the file' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-20T19:54:41.385848268Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15643293115, 'load_duration': 102389900, 'prompt_eval_count': 1537, 'prompt_eval_duration': 433857844, 'eval_count': 609, 'eval_duration': 15094544679, 'model_name': 'qwen2.5:14b'} id='run--7fbf97dc-7887-46fc-b83d-c531d9bb6eba-0' usage_metadata={'input_tokens': 1537, 'output_tokens': 609, 'total_tokens': 2146}
