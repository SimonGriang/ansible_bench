---
- name: Task 1: Check if all variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Task 2: Wait for host to be reachable
  wait_for:
    host: "{{ ansible_ssh_host|default(ansible_host|default(inventory_hostname)) }}"
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection is not defined or ansible_connection != 'docker' and bootstrap_wait_for_host|default(true)
  connection: local
  become: "{{ bootstrap_become|default(false) }}"
  become_user: "{{ bootstrap_user|default('root') }}"

- name: Task 3: Prepare the system
  block:
    - name: Test connection
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: bootstrap_connect
    - name: Debug timeout if connection fails
      debug:
        msg: "Connection failed, please check timeout value: {{ bootstrap_timeout }}"
      when: bootstrap_connect is failed
    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml

- name: Task 4: Install bootstrap packages
  raw: "{{ bootstrap_install_packages }}"
  delegate_to: localhost
  become: "{{ bootstrap_become|default(false) }}"
  become_user: "{{ bootstrap_user|default('root') }}"
  register: bootstrap_install_packages
  changed_when: "'Alpine|Archlinux|Gentoo' in ansible_distribution or 'Debian|RedHat|Rocky|Suse' not in ansible_distribution and bootstrap_install_packages.stdout|search('stdout regex')|bool"

- name: Task 5: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:
    - name: Install packages
      package:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ bootstrap__facts_packages }}"
      become: "{{ bootstrap_become|default(false) }}"
      become_user: "{{ bootstrap_user|default('root') }}"

