  ansible.builtin.meta:  # Corrected the syntax error by moving the 'eval' block inside the meta task
    eval: |
      ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2' or
      (ansible_os_family == 'RedHat' and (ansible_major_version | int >= 7 and ansible_major_version | int <= 10))

- name: Install epel gpg key
  ansible.builtin.yum_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install epel-release package
  ansible.builtin.yum:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Install epel-next-release package
  ansible.builtin.yum:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next | default(false) | bool
  notify: Update package cache


