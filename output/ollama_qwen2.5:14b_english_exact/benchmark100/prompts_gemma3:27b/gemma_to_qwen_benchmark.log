---
- name: Remove old Docker apt key file
  file:
    path: /etc/apt/trusted.gpg.d/docker.asc
    state: absent

- name: Remove old Docker source list file
  file:
    path: /etc/apt/sources.list.d/{{ docker_apt_ansible_distribution }}.list
    state: absent

- name: Remove obsolete Docker packages
  apt:
    name: "{{ item }}"
    state: absent
  loop: "{{ docker_obsolete_packages }}"

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install Docker dependencies
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Manage Docker repository
  deb822_repository:
    filename: /etc/apt/sources.list.d/{{ docker_apt_filename }}
    src: "{{ docker_repo_url }} {{ ansible_facts.distribution }} {{ ansible_facts.distribution_release }} {{ docker_apt_release_channel }}"
    state: "{{ 'present' if docker_add_repo else 'absent' }}"
  notify: apt update

- name: Flush handlers
  meta: flush_handlers


