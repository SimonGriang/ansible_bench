n/named-checkzone "{{ item.name }}" "{{ dns_datadir }}/{{ item.name }}.db"\n      register: zone_validation\n      failed_when: "\'is valid\' not in zone_validation.stdout"\n      when: item.enabled\n      loop: "{{ dns_zones }}"\n      changed_when: "\'is valid\' in zone_validation.stdout"\n\n- name: Add zones to configuration\n  template:\n    src: named.conf.j2\n    dest: /etc/named.conf\n    mode: 0644\n    owner: "{{ dns_owner }}"\n    group: "{{ dns_group }}"\n  notify: Restart dns\n  register: named_conf_updated\n  changed_when: named_conf_updated is changed\n\n- name: Place systemd override\n  block:\n    - name: Create override directory\n      file:\n        path: /etc/systemd/system/{{ dns_service }}.d\n        state: directory\n        mode: 0755\n      when: ansible_distribution == "CentOS" or ansible_os_family == "Debian"\n    - name: Copy override file\n      copy:\n        src: override.conf\n        dest: /etc/systemd/system/{{ dns_service }}.d/override.conf\n        mode: 0644\n      when: ansible_distribution == "CentOS" or ansible_os_family == "Debian"\n    - name: Reload systemd daemon\n      systemd:\n        name: "{{ dns_service }}"\n        daemon_reload: yes\n      when: ansible_distribution == "CentOS" or ansible_os_family == "Debian"\n\n- name: Start and enable dns\n  service:\n    name: "{{ dns_service }}"\n    state: started\n    enabled: yes\n  when: dns_service is defined' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-20T19:13:48.212924938Z', 'done': True, 'done_reason': 'stop', 'total_duration': 20338030816, 'load_duration': 97660959, 'prompt_eval_count': 760, 'prompt_eval_duration': 323603858, 'eval_count': 889, 'eval_duration': 19908422502, 'model_name': 'qwen2.5:14b'} id='run--18e7550e-f1a7-4804-af3f-c6cff174037d-0' usage_metadata={'input_tokens': 760, 'output_tokens': 889, 'total_tokens': 1649}
