---
- name: Create document roots for virtual hosts
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - item.create_docroot
  # This task creates directories for each virtual host's document root

- name: Configure virtual hosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}"
    mode: 0644
  loop: "{{ httpd_vhosts }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  # This task creates virtual host configuration files using a template

- name: Enable virtual hosts
  command: a2ensite "{{ item.name }}"
  when:
    - ansible_os_family == 'Debian'
    - not (httpd_vhosts_directory + '/{{ item.name }}.load' | file)
  loop: "{{ httpd_vhosts }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  # This task enables virtual hosts on Debian-based systems

