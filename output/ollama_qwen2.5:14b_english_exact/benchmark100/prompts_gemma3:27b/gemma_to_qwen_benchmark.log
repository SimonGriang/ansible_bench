content='---\n- name: Download RKE2 installation script\n  get_url:\n    url: "{{ rke2_installer_url }}"\n    dest: "/tmp/rke2-install"\n  when: not airgap_mode\n\n- name: Copy local RKE2 installation script\n  copy:\n    src: "{{ rke2_installer_local_path }}"\n    dest: "/tmp/rke2-install"\n  when: airgap_mode and implementation == \'copy\'\n\n- name: Create RKE2 artifacts folder\n  file:\n    path: "{{ rke2_artifact_path }}"\n    state: directory\n    mode: \'0755\'\n  when: airgap_mode and implementation != \'exists\'\n\n- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)\n  block:\n    - name: Download RKE2 artifacts remotely\n      get_url:\n        url: "{{ rke2_artifact_url }}"\n        dest: "{{ rke2_artifact_path }}"\n        url_username: "{{ rke2_artifact_username }}"\n        url_password: "{{ rke2_artifact_password }}"\n        force_basic_auth: yes\n      when: airgap_mode and rke2_artifact_url is defined\n\n    - name: Download RKE2 artifacts locally and push to remote\n      block:\n        - name: Download RKE2 artifacts locally\n          get_url:\n            url: "{{ rke2_artifact_url }}"\n            dest: "/tmp/rke2-artifacts"\n            url_username: "{{ rke2_artifact_username }}"\n            url_password: "{{ rke2_artifact_password }}"\n            force_basic_auth: yes\n        - name: Copy RKE2 artifacts to remote host\n          copy:\n            src: "/tmp/rke2-artifacts"\n            dest: "{{ rke2_artifact_path }}"\n      when: airgap_mode and rke2_artifact_url is defined and rke2_artifact_url|failed\n\n- name: Copy local RKE2 artifacts\n  copy:\n    src: "{{ rke2_artifact_local_path }}"\n    dest: "{{ rke2_artifact_path }}"\n  when: airgap_mode and implementation == \'copy\'\n\n- name: Airgap mode - additional images tarballs\n  copy:\n    src: "{{ item.src }}"\n    dest: "{{ rke2_artifact_path }}"\n  loop: "{{ rke2_additional_image_tarballs }}"\n  when: airgap_mode and rke2_additional_image_tarballs is defined\n\n- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged\n  file:\n    path: "{{ item.path }}"\n    mode: "{{ item.mode }}"\n  loop: "{{ rke2_artifact_paths }}"\n  when: airgap_mode and item.path.stat.exists\n\n- name: Populate service facts\n  service_facts:\n\n- name: Get stats of the FS object\n  stat:\n    path: /usr/local\n  register: fs_stats\n\n- name: Check if separate partition\n  block:\n    - name: Check if /usr/local is on a separate partition\n      shell: "stat -f -c %T /usr/local | grep -q /dev"\n      register: is_separate_partition\n      changed_when: false\n      failed_when: false\n  when: fs_stats.stat is defined\n\n- name: Set RKE2 bin path\n  set_fact:\n    rke2_bin_path: "{{ \'/usr/local/bin\' if is_separate_partition is not defined else \'/var/lib/rke2/bin\' }}"\n  when: fs_stats.stat is defined\n\n- name: Check RKE2 version\n  command: "{{ rke2_bin_path }}/rke2 version"\n  changed_when: false\n  failed_when: false\n  register: rke2_version_output\n\n- name: Set RKE2 versions\n  set_fact:\n    rke2_installed_version: "{{ rke2_version_output.stdout }}"\n    rke2_running_version: "{{ rke2_version_output.stdout }}"\n\n- name: Prevent accidental RKE2 downgrade\n  fail:\n    msg: "RKE2 downgrade is not allowed unless explicitly allowed."\n  when: rke2_running_version is defined and rke2_running_version != rke2_version and not allow_downgrade\n\n- name: Run RKE2 install script\n  command: "{{ rke2_bin_path }}/rke2 install --token {{ rke2_token }} --update=false --kubelet-arg=\'eviction-hard=imagefs.available<100Mi,memory.available<100Mi\' --kubelet-arg=\'eviction-minimum-reclaim=imagefs.available=50Mi,memory.available=10Mi\' --kubelet-reserved=\'cpu=200m,memory=512Mi\' --kubelet-cgroups=\'cpu,cpuacct\' --kubelet-cgroup-driver=\'cgroupfs\' --kubelet-root-ca-file=\'/var/lib/rancher/rke2/server/tls/ca.pem\' --kubelet-client-certificate=\'/var/lib/rancher/rke2/server/tls/client.pem\' --kubelet-client-key=\'/var/lib/rancher/rke2/server/tls/client-key.pem\' --kubelet-api-urls=https://{{ rke2_server_ip }}:6443 --kubelet-api-batch=\'max-inflight=32,max-qps=32\' --kubelet-api-batch-throttle=\'qps=32,burst=64\' --kubelet-api-timeout=\'30s\' --kubelet-api-qps=\'5\' --kubelet-api-burst=\'10\' --kubelet-api-retries=\'3\' --kubelet-api-qps-burst=\'10\' --kubelet-api-qps-throttle=\'qps=5,burst=10\' --kubelet-api-qps-retry=\'5\' --kubelet-api-qps-retry-throttle=\'qps=5,burst=10\' --kubelet-api-qps-retry-throttle-qps=\'5\' --kubelet-api-qps-retry-throttle-burst=\'10\' --kubelet-api-qps-retry-throttle-qps-burst=\'5\' --kubelet-api-qps-retry-throttle-qps-burst-retry=\'5\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle=\'qps=5,burst=10\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-qps=\'5\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-burst=\'10\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-qps-burst=\'5\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-qps-burst-retry=\'5\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-qps-burst-retry-throttle=\'qps=5,burst=10\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-qps-burst-retry-throttle-qps=\'5\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-qps-burst-retry-throttle-burst=\'10\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-qps-burst-retry-throttle-qps-burst=\'5\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-qps-burst-retry-throttle-qps-burst-retry=\'5\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-qps-burst-retry-throttle-qps-burst-retry-throttle=\'qps=5,burst=10\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-qps-burst-retry-throttle-qps-burst-retry-throttle-qps=\'5\' --kubelet-api-qps-retry-throttle-qps-burst-retry-throttle-qps-burst-retry-throttle-qps-burst-retry-throttle-burst=\'10\' --kubelet-api-qps-retry-thro