---
- name: Create ssh_key_directory for user
  ansible.builtin.file:
    path: "{{ lookup('env','HOME') }}/ssh_keys"
    state: directory
    mode: '0700'
  when: user.manage_ssh_key|default(false)

- name: Manage user account
  ansible.builtin.user:
    name: "{{ user.name }}"
    comment: "{{ user.comment|default('') }}"
    home: "{{ user.home|default('/home/' ~ user.name) }}"
    password: "{{ user.password|default('') }}"
    uid: "{{ user.uid|default('') }}"
    group: "{{ user.group|default('') }}"
    shell: "{{ user.shell|default('/bin/bash') }}"
    expiry: "{{ user.expiry|default('') }}"
    create_home: "{{ user.create_home|default(true) }}"
  register: user_result

- name: Set sudo options for user
  ansible.builtin.template:
    src: "templates/sudoers.j2"
    dest: "/etc/sudoers.d/{{ user.name }}"
    validate: 'visudo -c -s -f %s'
  loop: "{{ lookup('ansible.builtin.dict', user.sudo_options) }}"
  loop_control:
    label: "{{ item.0 }}"

- name: Remove sudo options for user
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudo_options|length == 0
  loop: "{{ lookup('ansible.builtin.dict', user.sudo_options) }}"
  loop_control:
    label: "{{ item.0 }}"

- name: Generate private ssh key for user
  ansible.builtin.command: ssh-keygen -t rsa -f "{{ lookup('env','HOME') }}/ssh_keys/id_rsa" -N ""
  args:
    creates: "{{ lookup('env','HOME') }}/ssh_keys/id_rsa"
  when: user.manage_ssh_key|default(false)

- name: Generate public ssh key for user
  ansible.builtin.command: ssh-keygen -y -f "{{ lookup('env','HOME') }}/ssh_keys/id_rsa" > "{{ lookup('env','HOME') }}/ssh_keys/id_rsa.pub"
  args:
    creates: "{{ lookup('env','HOME') }}/ssh_keys/id_rsa.pub"
  when: user.manage_ssh_key|default(false)

- name: Convert ssh key to ppk for user
  ansible.builtin.command: ssh-keygen -p -f "{{ lookup('env','HOME') }}/ssh_keys/id_rsa" -m pem -N ""
  args:
    creates: "{{ lookup('env','HOME') }}/ssh_keys/id_rsa.ppk"
  when: user.manage_ssh_key|default(false)

- name: Get or set the home directory for user
  block:
    - name: Get the user home directory from passwd
      ansible.builtin.getent:
        database: passwd
        key: "{{ user.name }}"
      register: passwd_entry

    - name: Set fact for the base directory
      ansible.builtin.set_fact:
        user_home: "{{ passwd_entry.results[0].item.split(':')[5] }}"
      when: passwd_entry.results|length > 0

    - name: Set fact to default base directory
      ansible.builtin.set_fact:
        user_home: /home
      when: passwd_entry is failed

- name: Create .ssh directory for user
  ansible.builtin.file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.group|default(user.name) }}"
  when: user.manage_ssh_key|default(false) or private_keys is defined

- name: Deploy authorized keys for user
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ item }}"
  loop: "{{ user.authorized_keys }}"
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for user
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for user
  ansible.builtin.copy:
    src: "{{ lookup('env','HOME') }}/ssh_keys/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group|default(user.name) }}"
  when: user.copy_private_key|default(false)

- name: Check users password valid time
  ansible.builtin.shell: awk -F: '($1 == "{{ user.name }}") {print $3}' /etc/shadow
  register: password_valid_time
  changed_when: false

- name: Set users password valid time
  ansible.builtin.command: chage -M "{{ user.password_max_days }}" "{{ user.name }}"
  when: user.password_max_days is defined

- name: Place private key file for user
  ansible.builtin.copy:
    content: "{{ user.private_keys }}"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group|default(user.name) }}"
  when: user.private_keys is defined

