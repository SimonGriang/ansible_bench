- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when: >
    ansible_facts.os_family not in ['Debian'] or
    ansible_distribution_release not in ['bookworm', 'noble'] or
    ansible_facts.os_family != 'Alpine'

- name: Install requested modules
  pip:
    name: "{{ item }}"
    executable: "{{ python_pip_executable }}"
    state: "{{ item.state }}"
    version: "{{ item.version }}"
  loop: "{{ python_pip_modules }}"
  when: >
    ansible_facts.os_family not in ['Debian'] or
    ansible_distribution_release not in ['bookworm', 'noble'] or
    ansible_facts.os_family != 'Alpine'
  loop_control:
    label: "{{ item.name }}"


