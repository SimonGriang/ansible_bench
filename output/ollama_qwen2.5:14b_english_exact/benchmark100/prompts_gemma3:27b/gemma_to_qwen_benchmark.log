---
- import_tasks: assert.yml
  vars:
    ansible_become: true
  run_once: true
  remote_addr: localhost

- block:
  - name: Install repository for RedHat
    when: ansible_os_family == "RedHat"
    get_url:
      url: "https://pkg.cfssl.org/R1.2/{{ item }}"
      dest: "/etc/yum.repos.d/hashicorp.repo"
      mode: "0640"
    loop:
      - "cfssl-rhel6.repo"
      - "consul-rhel6.repo"
      - "nomad-rhel6.repo"
      - "terraform-rhel6.repo"
      - "vault-rhel6.repo"

  - name: Install required package gpg
    when: ansible_os_family == "Debian"
    apt:
      name: gpg
      state: present

  - name: Install apt key for Debian
    when: ansible_os_family == "Debian"
    apt_key:
      url: "https://apt.releases.hashicorp.com/gpg"
      validate_certs: false
      state: present

  - name: Install repository for Debian
    when: ansible_os_family == "Debian"
    apt_repository:
      repo: "deb [arch={{ hashicorp_architecture_mapping[inventory_hostname] }}] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
      state: present

  - name: Install latest hashicorp product using package
    when: hashicorp_products is defined and hashicorp_installation_method == "package"
    loop: "{{ hashicorp_products }}"
    apt:
      name: "{{ item }}"
      state: latest
      update_cache: yes
    loop_control:
      label: "Install {{ item }}"

  - name: Install versioned hashicorp product using package
    when: hashicorp_products is defined and hashicorp_installation_method == "package"
    loop: "{{ hashicorp_products }}"
    apt:
      name: "{{ item }}{{ version_coupler }}{{ hashicorp_products[item] }}"
      state: present
      update_cache: yes
    loop_control:
      label: "Install {{ item }} {{ hashicorp_products[item] }}"
    when: hashicorp_products[item] is defined

  - name: Install hashicorp product manually
    when: hashicorp_installation_method == "manual"
    unarchive:
      remotesrc: yes
      src: "{{ hashicorp_src[inventory_hostname][item] }}"
      dest: "/opt/hashicorp"
      group: "root"
      mode: "0755"
      owner: "root"
    loop: "{{ hashicorp_products }}"
    loop_control:
      label: "Install {{ item }}"

  - name: Configure debian
    block:
      - name: Install required package gpg
        apt:
          name: gpg
          state: present
    when: ansible_os_family == "Debian"

