---
- name: Prepare summary
  shell: kubectl get nodes --kubeconfig {{ rke2_data_path }}/rke2.yaml -o wide --show-labels | egrep -v '^NAME' | tr '\n' '\r'
  args:
    warn: false
  register: nodes_summary
  when: inventory_hostname == groups[rke2_servers_group_name][0]
  retries: 5
  delay: 5

- name: K8s nodes state
  debug:
    msg: "{{ nodes_summary.stdout_lines | to_nice_yaml }}"


