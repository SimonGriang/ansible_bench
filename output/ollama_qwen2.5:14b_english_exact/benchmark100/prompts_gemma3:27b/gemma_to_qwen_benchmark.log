---
- import_tasks: assert.yml
  remote_addr: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages | default([]) | bool }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  lineinfile:
    dest: "/etc/{{ mysql_name }}-server.cnf"
    regexp: '^(#?{{ item.key }}=)'
    line: "{{ item.key }} = {{ item.value }}"
    create: yes
  with_items: "{{ mysql_configuration_options | default([]) | bool }}"

- name: Configure mysql client
  lineinfile:
    dest: "/etc/{{ mysql_name }}-client.cnf"
    regexp: '^(#?socket=)'
    line: "socket={{ mysql_socket }}"
    create: yes

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine'] or ansible_os_family == 'Archlinux'

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    target: "{{ item }}"
    encoding: utf8mb4
    collation: utf8mb4_unicode_ci
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  with_items: "{{ mysql_databases | default([]) | bool }}"

- name: List databases
  mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  register: mysql_info

- name: Import database
  mysql_db:
    name: "{{ item }}"
    state: import
    target: "{{ item_import_target }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  with_items: "{{ mysql_databases }}"
  when: item_import_target is defined and mysql_info.databases|map('extract', 'name')|list|difference(mysql_databases)|list

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  with_items: "{{ mysql_users | default([]) | bool }}"

- name: Flush handlers again
  meta: flush_handlers


