---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0750'
    owner: root
    group: root

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  copy:
    src: "{{ item }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  with_items:
    - "{{ rke2_config_source }}"
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: "{{ item }}"
    dest: /etc/systemd/system/rke2-kubelet.service.d/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  with_items:
    - "{{ rke2_kubelet_config_source }}"
  notify: Config file changed
  when: rke2_kubelet_config|length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ item }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0644'
  with_items:
    - "{{ rke2_containerd_registry_config_source }}"
  notify: Config file changed
  when: rke2_custom_registry_mirrors|length > 0 or rke2_custom_registry_configs|length > 0

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and rke2_service_state not in ['started', 'enabled']

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined

- name: Restore etcd from file
  block:
    - name: Create destination directory
      file:
        path: /var/lib/rancher/rke2/agent/etcd-snapshots
        state: directory
        mode: '0750'
        owner: root
        group: root
    - name: Copy snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/etcd-snapshots/snapshot.db
        owner: root
        group: root
        mode: '0644'
    - name: Restore etcd
      command: rke2 server --etcd-snapshot=/var/lib/rancher/rke2/agent/etcd-snapshots/snapshot.db
      args:
        warn: no
        creates: /var/lib/rancher/rke2/agent/etcd-snapshots/snapshot.db
      environment:
        RKE2_TOKEN: "{{ rke2_token }}"
  when: do_etcd_restore == true

- name: Restore etcd from s3
  command: rke2 server --etcd-snapshot-s3-access-key="{{ rke2_etcd_snapshot_s3_options.access_key }}" --etcd-snapshot-s3-secret-key="{{ rke2_etcd_snapshot_s3_options.secret_key }}" --etcd-snapshot-s3-bucket="{{ rke2_etcd_snapshot_s3_options.bucket }}" --etcd-snapshot-s3-key="{{ rke2_etcd_snapshot_file }}"
  when: do_etcd_restore_from_s3 == true

- name: Start RKE2 service on the first server
  service:
    name: rke2-server.service
    enabled: true
    state: started
  notify: Service (re)started
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Mask RKE2 agent service on the first server
  block:
    - name: Mask RKE2 agent service
      service:
        name: rke2-agent.service
        state: masked
        enabled: false
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Wait for the first server be ready - no CNI
  shell: kubectl get nodes -o json | jq -r '.items[].status.conditions[] | select(.type=="Ready") | .status' | grep -q "False"
  register: result
  until: result is not defined or result.stdout == "False"
  retries: 60
  delay: 5
  when: inventory_hostname == groups[rke2_cluster_group_name][0] and rke2_cni_plugin is not defined

- name: Wait for the first server be ready - with CNI
  shell: kubectl get nodes -o json | jq -r '.items[].status.conditions[] | select(.type=="Ready") | .status' | grep -q "True"
  register: result
  until: result is not defined or result.stdout == "True"
  retries: 60
  delay: 5
  when: inventory_hostname == groups[rke2_cluster_group_name][0] and rke2_cni_plugin is defined

- name: Restore etcd
  block:
    - name: Get registered nodes
      shell: kubectl get nodes -o json
      register: nodes_output
    - name: Get node names
      shell: echo "{{ nodes_output.stdout | from_json | json_query('[].metadata.name') }}"
      register: node_names
    - name: Remove old secrets and nodes
      shell: for node in {{ node_names.stdout.split() | join(' ') }}; do kubectl delete secret -n kube-system node-lock-$node; kubectl delete node $node; done
  when: do_etcd_restore == true or do_etcd_restore_from_s3 == true

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  delegate_facts: true
  loop: "{{ groups[rke2_cluster_group_name] }}"

