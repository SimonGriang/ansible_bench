ional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-20T20:37:25.886805572Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11446389202, 'load_duration': 78460470, 'prompt_eval_count': 856, 'prompt_eval_duration': 407841190, 'eval_count': 581, 'eval_duration': 10949567230, 'model_name': 'qwen2.5:14b'} id='run--d5cdf2cd-df2f-4bff-aa9e-1a43653f923b-0' usage_metadata={'input_tokens': 856, 'output_tokens': 581, 'total_tokens': 1437}
