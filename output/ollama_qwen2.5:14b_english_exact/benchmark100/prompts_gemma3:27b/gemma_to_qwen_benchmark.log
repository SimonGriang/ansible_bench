---
- include_tasks: keepalived.yml
  when: rke2_ha_mode and rke2_api_ip is defined and inventory_hostname in groups[rke2_servers_group_name]

- include_tasks: rke2.yml
  vars:
    rke2_version: "{{ rke2_version }}"

- include_tasks: cis.yml
  when: rke2_cis_profile | length > 0

- include_tasks: find_active_server.yml

- include_tasks: ip_vs.yml
  when: rke2_kubevip_ipvs_lb_enable and inventory_hostname in groups[rke2_servers_group_name] and rke2_ha_mode and not rke2_use_kubevip

- include_tasks: kubevip.yml
  vars:
    kubevip_use_kubeconf: "{{ rke2_ha_mode and rke2_use_kubevip and not rke2_use_keepalived }}"
  when: rke2_ha_mode and rke2_use_kubevip and not rke2_use_keepalived and inventory_hostname == groups[rke2_servers_group_name][0]

- include_tasks: ingress-nginx.yml
  when: rke2_ingress_nginx_values | length > 0 and inventory_hostname == groups[rke2_servers_group_name][0]

- include_tasks: first_server.yml
  when: inventory_hostname == groups[rke2_servers_group_name][0] and (not rke2_active_server or groups[rke2_cluster_group_name] | length == 1)

- include_tasks: first_server_restore.yml
  when: (rke2_active_server or inventory_hostname == groups[rke2_servers_group_name][0]) and (rke2_do_etcd_restore or rke2_do_etcd_restore_from_s3)

- include_tasks: download_kubeconfig.yaml
  when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]

- include_tasks: remaining_nodes.yml
  when: rke2_active_server and groups[rke2_cluster_group_name] | length >= 2

- block:
    - command: "{{ rke2_bin }}/rke2 install version check"
      register: rke2_installed_version
      when: rke2_installed_version is defined and rke2_installed_version != rke2_version
    - command: "{{ rke2_bin }}/rke2 install version update --force"
      when: rke2_installed_version is defined and rke2_installed_version != rke2_version
  when: inventory_hostname in groups[rke2_servers_group_name]

- block:
    - command: "{{ rke2_bin }}/rke2 install version check"
      register: rke2_installed_version
      when: rke2_installed_version is defined and rke2_installed_version != rke2_version
    - command: "{{ rke2_bin }}/rke2 install version update --force"
      when: rke2_installed_version is defined and rke2_installed_version != rke2_version
  when: not inventory_hostname in groups[rke2_servers_group_name] and inventory_hostname in groups[rke2_agents_group_name]

- meta: flush_handlers

- block:
    - shell: "{{ rke2_bin }}/rke2 install config check"
      register: rke2_config_check
      when: rke2_restart_needed
    - shell: "{{ rke2_bin }}/rke2 install config update --force"
      when: rke2_config_check.changed
  when: rke2_restart_needed

- include_tasks: summary.yml

