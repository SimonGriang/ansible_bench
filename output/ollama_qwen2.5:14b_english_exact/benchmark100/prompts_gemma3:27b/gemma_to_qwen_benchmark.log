---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    system: true

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    createhome: no
    system: true

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Download Vault binary
  get_url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
    dest: "{{ vault_download_path }}/vault.zip"
  register: vault_download_result

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: not vault_check_path.stat.exists and vault_path is defined

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ vault_path }}/{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  shell: >
    cd "{{ vault_data_directory }}/tls/"
    openssl req -x509 -newkey rsa:4096 -keyout tls.key -out tls.crt -days 365 -nodes -subj "/CN=vault"
  args:
    creates: "{{ vault_data_directory }}/tls/tls.key"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ vault_data_directory }}/tls/{{ item.file }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: /usr/bin/vault
    mode: 0755
    owner: root
    group: root
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  file:
    path: /usr/bin/vault
    capabilities: ep

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    mode: 0644
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    attributes: u+nocluster
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Copy Vault service file
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: 0644
    owner: root
    group: root
  notify: Daemon reload
  when: ansible_service_mgr == 'systemd'

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: 0644
    owner: root
    group: root
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


