---
- name: Assert systemd as init system
  ansible.builtin.meta:
    fatal_error: "Systemd is required as init system."
  when: ansible_systemd is not defined

- name: Get latest release
  ansible.builtin.uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
    status_code: 200
    timeout: 5
    method: GET
    headers:
      Authorization: "token {{ GH_TOKEN }}"
    retries: 5
    delay: 5
  register: _latest_release
  environment: "{{ {'GH_USER': GH_USER, 'GH_TOKEN': GH_TOKEN} }}"
  when: GH_USER is defined and GH_TOKEN is defined

- name: Set promtail version to {{ _latest_release.json.tag_name[1:] }}
  ansible.builtin.set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
  when: promtail_version == "latest"

- name: Test if zip local archive exists
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/{{ promtail_version }}-linux-{{ go_arch }}.zip"
  register: promtail_binary_local_archive
  when: promtail_binary_local_dir is defined

- name: Assert local binary exists
  ansible.builtin.meta:
    fatal_error: "Local promtail binary archive not found."
  when: promtail_binary_local_dir is defined and promtail_binary_local_archive.stat is not defined

- name: Get checksum list
  ansible.builtin.uri:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/SHA256SUMS"
    status_code: 200
    method: GET
  register: __promtail_checksums
  when: promtail_binary_local_dir is not defined

- name: Get checksum for {{ go_arch }} architecture
  ansible.builtin.set_fact:
    __promtail_checksum: "{{ item.split()[0] }}"
  loop: "{{ __promtail_checksums.content.splitlines() }}"
  when: promtail_binary_local_dir is not defined
  when: "'linux-' ~ go_arch ~ '.zip' in item"
  register: __promtail_checksum
  until: __promtail_checksum is defined
  retries: 5
  delay: 5

