---
- name: Enable the Backports repository for Debian
  apt:
    repo: "deb http://deb.debian.org/debian {{ ansible_facts.os_release.version|default('jessie', true) }}-backports main"
    filename: "backports.{{ ansible_facts.os_release.version|default('jessie', true) }}.list"
  when: ansible_facts.os_family == "Debian" and ansible_facts.os_release.version_id|version_compare('<9', true)
  notify: update_apt_cache

- name: Set the default_release fact for older Debian versions
  set_fact:
    ansible_default_release: "{{ 'jessie-backports' if ansible_facts.os_release.version|version_compare('<9', true) else 'stable' }}"

- name: Install Ansible
  apt:
    name: ansible
    state: "{{ ansible_package_state }}"
    version: "{{ ansible_default_release }}"
  when: ansible_facts.os_family == "Debian"

- name: Include handlers
  include_tasks: handlers.yml

  handlers:
    - name: update_apt_cache
      apt:
        update_cache: yes

