---
- import_tasks: assert.yml
  delegate_to: localhost
  when: true

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection is not in ['docker', 'lxc', 'lxd', 'podman']
    - bootstrap_wait_for_host | default(false)

- name: Prepare system
  block:
    - name: Test connection
      ping:
    - name: Test sudo access
      command: whoami
      sudo: yes
      changed_when: false
  rescue:
    - name: Gather facts
      setup:
    - name: Install bootstrap packages
      ansible.builtin.raw: "{{ item }}"
      loop: "{{ bootstrap_facts_packages_raw | default([]) }}"
    - name: Ensure libdnf5 is present
      package:
        name: libdnf5
        state: present
      when: ansible_facts['os_family'] == 'RedHat'

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: yes
    become: "{{ bootstrap_become | default('yes') }}"

