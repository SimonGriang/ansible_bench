---
- name: lookup bootstrap facts (raw)
  raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  become: false
  ansible_user: bootstrap_user

- name: set bootstrap facts (I) # noqa jinja
  set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: "{{ item.value.version | regex_replace('^([^.]*)..*', '\\1') }}"
  loop: "{{ bootstrap__os_family_map }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout is search(item.value.match, flags='re') and item.value.match is search('PRETTY_NAME', flags='re')
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map }}"
  when: bootstrap_distribution is containedby(item.value.distributions)
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"
  with_items: "{{ bootstrap__os_family_map.keys() }}"

