ate users\n  mysql_user:\n    name: "{{ item.name }}"\n    password: "{{ item.password }}"\n    priv: "{{ item.privileges }}"\n    host: "{{ item.host }}"\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_unix_socket: "{{ mysql_socket }}"\n  with_items: "{{ mysql_users }}"\n\n- name: Flush handlers again\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-20T19:27:23.286167554Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11570740964, 'load_duration': 103333640, 'prompt_eval_count': 783, 'prompt_eval_duration': 371066255, 'eval_count': 576, 'eval_duration': 11083902190, 'model_name': 'qwen2.5:14b'} id='run--669247e2-7509-4192-9dd1-95a7eb567a0e-0' usage_metadata={'input_tokens': 783, 'output_tokens': 576, 'total_tokens': 1359}
