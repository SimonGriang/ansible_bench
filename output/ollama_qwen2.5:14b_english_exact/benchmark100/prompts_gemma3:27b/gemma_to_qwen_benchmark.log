- name: Install requirements
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ sysctl_requirements }}"

- name: Set sysctl setting
  ansible.posix.sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    sysctl_set: "{{ sysctl_set | default(True) }}"
    sysctl_reload: "{{ sysctl_reload | default(True) }}"
  loop: "{{ sysctl_items }}"
  when:
