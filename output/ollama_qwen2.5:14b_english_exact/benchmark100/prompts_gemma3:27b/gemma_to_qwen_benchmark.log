l': 'qwen2.5:14b', 'created_at': '2025-10-20T19:05:59.623344762Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9635977909, 'load_duration': 86784358, 'prompt_eval_count': 1324, 'prompt_eval_duration': 14839343, 'eval_count': 482, 'eval_duration': 9518568275, 'model_name': 'qwen2.5:14b'} id='run--1a9cefea-363d-4f41-a07f-3b16302ea920-0' usage_metadata={'input_tokens': 1324, 'output_tokens': 482, 'total_tokens': 1806}
