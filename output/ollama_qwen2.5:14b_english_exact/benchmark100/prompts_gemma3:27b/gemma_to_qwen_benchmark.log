    name: "{{ mysql_packages }}"
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/{{ mysql_name }}-server.cnf
    line: "{{ item.key }} = {{ item.value }}"
  with_dict: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/{{ mysql_name }}-client.cnf
    line: "socket = {{ mysql_socket }}"
  notify: Restart mysql server

- name: Initialize mysql
  shell: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    enabled: true
    state: started

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: localhost
    login_port: 3306
    ssl_mode: required
    ssl_ca: /path/to/ca.pem
    ssl_cert: /path/to/client-cert.pem
    ssl_key: /path/to/client-key.pem
  with_items: "{{ mysql_databases }}"
  vars:
    mysql_socket: "{{ mysql_socket }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: localhost
    login_port: 3306
    ssl_mode: required
    ssl_ca: /path/to/ca.pem
    ssl_cert: /path/to/client-cert.pem
    ssl_key: /path/to/client-key.pem
  with_items: "{{ mysql_users }}"
  vars:
    mysql_socket: "{{ mysql_socket }}"

- name: Flush handlers again
  meta: flush_handlers

