---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ item }}"
  loop: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when:
    - ansible_selinux.status is defined
    - ansible_connection is not container
  block:
    - name: Set selinux state
      selinux:
        policy: "{{ selinux_policy }}"
        state: "{{ selinux_state }}"
      notify: Reboot

- name: Manage selinux booleans
  when: selinux_booleans is defined
  block:
    - name: Set selinux boolean state
      seboolean:
        name: "{{ item.key }}"
        state: "{{ item.value | default('yes') }}"
        persistent: yes
      loop: "{{ selinux_booleans | dict2items }}"
      loop_control:
        label: "{{ item.key }}"

