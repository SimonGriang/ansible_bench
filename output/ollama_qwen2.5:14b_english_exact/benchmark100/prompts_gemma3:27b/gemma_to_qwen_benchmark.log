uration': 10253439165, 'model_name': 'qwen2.5:14b'} id='run--6b9c3c0f-8b85-40b9-8eca-7824608c946c-0' usage_metadata={'input_tokens': 785, 'output_tokens': 449, 'total_tokens': 1234}
