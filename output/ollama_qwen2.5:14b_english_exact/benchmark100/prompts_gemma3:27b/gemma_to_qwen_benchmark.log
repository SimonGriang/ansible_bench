content='---\n- import_tasks: assert.yml\n  run_once: true\n  remote_addr: localhost\n\n- name: Install php\n  package:\n    name: "{{ php_packages }}"\n    state: present\n\n- name: Find used php.ini\n  command: "{{ php_ini_command }}"\n  register: php_found_ini_location\n  changed_when: false\n  when: php_ini_location is not defined\n\n- name: Configure php\n  template:\n    src: php.ini.j2\n    dest: >\n      {{ php_ini_location | default(php_found_ini_location.stdout) }}\n    mode: \'0644\'\n  notify: Restart httpd' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-20T20:18:46.445516992Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3069729749, 'load_duration': 105489185, 'prompt_eval_count': 477, 'prompt_eval_duration': 140058703, 'eval_count': 133, 'eval_duration': 2818158112, 'model_name': 'qwen2.5:14b'} id='run--85f9e17c-20e3-4eea-8507-ad45953062ce-0' usage_metadata={'input_tokens': 477, 'output_tokens': 133, 'total_tokens': 610}
