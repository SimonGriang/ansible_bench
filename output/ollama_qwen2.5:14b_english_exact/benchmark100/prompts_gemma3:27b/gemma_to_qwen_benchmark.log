---
- import_tasks: assert.yml
  vars:
    ansible_python_interpreter: /usr/bin/python3
  run_once: true
  remote_addr: localhost

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  copy:
    content: "index-url = {{ python_pip_proxy }}"
    dest: /etc/pip.conf
    owner: root
    group: root
    mode: 0644
  when: python_pip_proxy is defined
  block:
    - lineinfile:
        path: /etc/pip.conf
        line: "[global]"
        insertafter: BOF
        state: present
        create: yes
    - lineinfile:
        path: /etc/pip.conf
        line: "index-url = {{ python_pip_proxy }}"
        insertafter: "[global]"
        state: present

- name: Trust hosts
  copy:
    content: "trusted-host = {{ python_pip_trusted_host }}"
    dest: /etc/pip.conf
    owner: root
    group: root
    mode: 0644
  when: python_pip_trusted_host is defined
  block:
    - lineinfile:
        path: /etc/pip.conf
        line: "[global]"
        insertafter: BOF
        state: present
        create: yes
    - lineinfile:
        path: /etc/pip.conf
        line: "trusted-host = {{ python_pip_trusted_host }}"
        insertafter: "[global]"
        state: present

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when: not (ansible_facts.os_family in ['Debian'] and (ansible_distribution_release == 'bookworm' or ansible_distribution_release == 'noble')) and not (ansible_facts.os_family == 'Alpine')

- name: Install requested modules
  pip:
    name: "{{ item }}"
    executable: "{{ python_pip_executable }}"
    state: "{{ item.state }}"
    version: "{{ item.version }}"
  loop: "{{ python_pip_modules }}"
  when: not (ansible_facts.os_family in ['Debian'] and (ansible_distribution_release == 'bookworm' or ansible_distribution_release == 'noble')) and not (ansible_facts.os_family == 'Alpine')
  loop_control:
    label: "{{ item.name }}"

