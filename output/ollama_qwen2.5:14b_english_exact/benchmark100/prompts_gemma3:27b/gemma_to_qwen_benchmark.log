---
- name: Check if the Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: "{{ helm_bin_path }} version"
  register: helm_existing_version
  failed_when: false
  changed_when: false

- name: Download helm
  unarchive:
    src: "{{ helm_download_url }}{{ helm_repo_path }}-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: /tmp
    remote_src: yes
