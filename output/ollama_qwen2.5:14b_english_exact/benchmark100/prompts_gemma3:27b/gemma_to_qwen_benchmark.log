---
- import_tasks: assert.yml
  name: Import assert.yml
  remote_user: root
  run_once: true
  when: inventory_hostname == 'localhost'

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  when: selinux_status.enabled is defined and selinux_status.enabled
  block:
    - name: Modify selinux booleans
      seboolean:
        name: "{{ item.boolean }}"
        state: "{{ item.state }}"
        persistent: yes
      loop: "{{ selinux_status.booleans }}"
    - name: Allow connections to specified ports
      seport:
        port: "{{ item.port }}"
        proto: "{{ item.protocol }}"
        state: present
      loop: "{{ selinux_status.ports }}"

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    owner: root
    group: root
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Activate httpd module | Debian
  command: "{{ a2enmod }} {{ item }}"
  when: ansible_facts.os_family == 'Debian'
  loop: "{{ httpd_modules_to_activate_with_command }}"
  register: a2enmod_result
  failed_when: "'already enabled' in a2enmod_result.stdout"
  changed_when: "'already enabled' not in a2enmod_result.stdout"

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable is defined and https_ssl_enable

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  when: ansible_facts.os_family in ['Debian', 'Suse']
  template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
    owner: root
    group: root
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example is defined and httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


