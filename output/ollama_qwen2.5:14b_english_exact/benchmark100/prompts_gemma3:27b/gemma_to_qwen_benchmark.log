---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Enable redis module stream (RHEL 8)
  block:
    - dnf:
        name: redis
        state: installed
        enablerepo: "@RedHatEnterpriseLinux8-AppStream"
  when: ansible_distribution_major_version == "8" and ansible_os_family == "RedHat"

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: "redis.conf-{{ ansible_distribution }}.j2"
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true

