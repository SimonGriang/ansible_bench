---
- import_tasks: assert.yml
  run_once: true
  vars:
    ansible_connection: local

- name: Install requirements
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ sysctl_requirements }}"

- name: Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    sysctl_set: "{{ sysctl_set | default(True) }}"
    sysctl_reload: "{{ sysctl_reload | default(True) }}"
  loop: "{{ sysctl_items }}"
  when:
    - sysctl_items is defined
    - item.name is defined
    - item.value is defined
    - not ansible_local.docker.enabled
  register: sysctl_results
  loop_control:
    label: "{{ item.name }}"

