---
- import_tasks: assert.yml
  remote_addr: localhost

- name: Install required software
  ansible.builtin.yum:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  when: users_requirements|length > 0

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item.name }}"
  when: users_groups is defined

- name: Ensure the /etc/sudoers.d directory is included
  ansible.builtin.lineinfile:
    path: /etc/sudoers
    line: "#includedir {{ users_sudo_includedir }}"
    create: no
    regexp: "^#includedir {{ users_sudo_includedir }}"
    validate: '/usr/sbin/visudo -cf %s'
  when: users_sudo_includedir is defined

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  when: users is defined

- name: Manage cron permission
  ansible.builtin.template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow is defined and users_cron_allow

- name: Check existence of /etc/cron.allow
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is defined and not users_cron_allow

