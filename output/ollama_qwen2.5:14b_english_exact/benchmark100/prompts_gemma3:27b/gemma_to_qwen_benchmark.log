---
- name: Migrate from adoptopenjdk to temurin if selected
  ansible.builtin.set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  ansible.builtin.include_vars: "{{ lookup('env', 'ANSIBLE_ROLE_PATH') }}/{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"

- name: Gather architecture specific variables
  ansible.builtin.include_vars:
    file: architecture.yml

- name: Set OS specific variables (I)
  ansible.builtin.set_fact:
    java_open_jdk_version: "{{ java_open_jdk_version | default('11') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-11-jdk') }}"
    java_open_jdk_repo: "{{ java_open_jdk_repo | default('') }}"
    java_open_jdk_repo_key: "{{ java_open_jdk_repo_key | default('') }}"
    java_open_jdk_libs: "{{ java_open_jdk_libs | default('') }}"

- name: Set OS and architecture specific variables (II)
  ansible.builtin.set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/java-11-openjdk') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-11-jdk') }}"

- name: Set specific variables
  ansible.builtin.set_fact:
    java_home: "{{ java_open_jdk_home_dir }}"

- name: Remove deprecated repositories (Debian)
  ansible.builtin.apt:
    name: "{{ java_deprecated_repositories_adoptopenjdk }}"
    state: absent
  when:
    - ansible_os_family == "Debian"
    - java_deprecated_repositories_adoptopenjdk is defined

- name: Install extra apt tools (Debian)
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_apt_extra_packages | default([]) }}"
  when: ansible_os_family == "Debian"

- name: Add required key repositories (Debian)
  ansible.builtin.apt_key:
    url: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
  when: ansible_os_family == "Debian"

- name: Add required repositories (Debian)
  ansible.builtin.apt_repository:
    repo: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ java_required_repositories_openjdk | default([]) }}"
  when: ansible_os_family == "Debian"

- name: Add required key repositories (RedHat)
  ansible.builtin.rpm_key:
    key: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
  when: ansible_os_family == "RedHat"

- name: Add required repositories (RedHat)
  ansible.builtin.yum_repository:
    name: "{{ item.repository }}"
    baseurl: "{{ item.baseurl }}"
    enabled: "{{ item.enabled }}"
    state: present
  loop: "{{ java_required_repositories_openjdk | default([]) }}"
  when: ansible_os_family == "RedHat"

- name: Install required libs
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libs_openjdk | default([]) }}"
  when: ansible_os_family == "Debian"

- name: Install Java (Debian)
  ansible.builtin.apt:
    name: "{{ java_open_jdk_package }}"
    version: "{{ java_open_jdk_version }}"
    state: present
  when: ansible_os_family == "Debian"

- name: Install Java (RedHat)
  ansible.builtin.yum:
    name: "{{ java_open_jdk_package }}-{{ java_open_jdk_version }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Export environment variables
  ansible.builtin.template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0755'

- name: Source environment variables
  ansible.builtin.shell: "source /etc/profile"

- name: Correct java version selected (Debian, Java < 11)
  ansible.builtin.command: update-alternatives --set java "/usr/lib/jvm/java-11-openjdk-amd64/bin/java"
  when:
    - ansible_os_family == "Debian"
    - java_open_jdk_version is version '<', '11'

- name: Correct java version selected (Debian, Java >= 11)
  ansible.builtin.command: update-alternatives --set java "/usr/lib/jvm/java-11-openjdk-amd64/bin/java"
  when:
    - ansible_os_family == "Debian"
    - java_open_jdk_version is version '>=', '11'

