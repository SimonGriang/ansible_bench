me: Set users password valid time\n  ansible.builtin.command: chage -M "{{ user.password_max_days }}" "{{ user.name }}"\n  when: user.password_max_days is defined\n\n- name: Place private key file for user\n  ansible.builtin.copy:\n    content: "{{ user.private_keys }}"\n    dest: "{{ user_home }}/.ssh/id_rsa"\n    mode: \'0600\'\n    owner: "{{ user.name }}"\n    group: "{{ user.group | default(user.name) }}"\n  when: user.private_keys is defined' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-20T20:02:02.288731122Z', 'done': True, 'done_reason': 'stop', 'total_duration': 25021804889, 'load_duration': 104516727, 'prompt_eval_count': 2240, 'prompt_eval_duration': 81750153, 'eval_count': 1121, 'eval_duration': 24824629809, 'model_name': 'qwen2.5:14b'} id='run--2afe1383-14f7-4cc3-85b1-f865ff59a2ce-0' usage_metadata={'input_tokens': 2240, 'output_tokens': 1121, 'total_tokens': 3361}
