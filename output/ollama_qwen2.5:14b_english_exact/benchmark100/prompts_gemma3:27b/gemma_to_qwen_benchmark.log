---
- import_tasks: assert.yml
  remote_addr: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  lineinfile:
    dest: "/etc/{{ mysql_name }}-server.cnf"
    regexp: '^(#?{{ item.key }}=)'
    line: "{{ item.key }} = {{ item.value }}"
    create: yes
  with_items: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  lineinfile:
    dest: "/etc/{{ mysql_name }}-client.cnf"
    regexp: '^(#?socket=)'
    line: "socket={{ mysql_socket }}"
    create: yes

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution == 'Alpine' or ansible_os_family == 'Archlinux'

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    target: "{{ item }}"
    encoding: utf8mb4
