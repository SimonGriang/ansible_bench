---
- name: Create etcd group
  group:
    name: etcd
    system: yes
    state: present

- name: Create etcd user
  user:
    name: etcd
    group: etcd
    shell: /bin/nologin
    comment: 'etcd node health and status'
    system: yes
    state: present

- name: Copy systemctl config file for kernel hardening
  copy:
    src: "{{ 'rke2-cis-sysctl.conf' if partition_result.rc == 0 else '/usr/local/share/rke2/rke2-cis-sysctl.conf' }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: 0600
    remote_src: yes
  notify: Restart systemd-sysctl

- name: Flush handlers
  meta: flush_handlers

