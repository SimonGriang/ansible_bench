---
- name: Check Java Certificate Existence
  stat:
    path: "{{ item }}"
  loop: "{{ java_certs }}"
  register: check_java_certs

- name: Fail if Java Certificate Doesn't Exist
  fail:
    msg: "Java certificate {{ item.item }} does not exist."
  when: not item.stat.exists
  loop: "{{ check_java_certs.results }}"

- name: Set Keystore Directory for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: java_keystore_dir is not defined or java_keystore_dir is None and java_open_jdk_version_major < 11

- name: Set Keystore Directory for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: java_keystore_dir is not defined or java_keystore_dir is None and java_open_jdk_version_major >= 11

- name: Import SSL Certificates into Java Keystore
  java_cert:
    path: "{{ item }}"
    keystore: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/{{ java_cert_keystore_file }}"
    keystore_password: "{{ java_cert_keystore_pass }}"
    alias: "{{ item | basename | regex_replace('\\.crt$', '') }}"
    state: present
  loop: "{{ java_certs }}"
  register: import_cert_results
  until: import_cert_results.results|map(attribute='ansible_facts.java_cert.state')|select('any', 'present')|list|length == ansible_loop_length('java_certs')
  retries: 3
  delay: 10

