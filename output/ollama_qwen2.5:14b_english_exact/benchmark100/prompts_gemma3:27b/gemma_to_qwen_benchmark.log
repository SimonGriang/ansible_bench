---
- name: Task 1 - Disable Unnecessary Services
  service:
    name: "{{ item }}"
    state: stopped
    enabled: false
  loop:
    - bluetooth
    - avahi-daemon
    - rsync

- name: Task 2 - Remove Unnecessary Packages
  apt:
    name: "{{ item }}"
    state: absent
  loop:
    - avahi-utils
    - unattended-upgrades
    - rsync

- name: Task 3 - Hardening SSH Config
  copy:
    src: /etc/ssh/sshd_config
    dest: /etc/ssh/sshd_config.bak
    backup: yes
  notify: Restart SSH Service

- name: Task 4 - Configure SELinux / AppArmor
  block:
    - name: Install SELinux Policy and configure if enabled
      when: vault_hardening_configure_selinux_apparmor | default(false) and ansible_selinux.status == "enabled"
      package:
        name: selinux-policy
        state: present
      seboolean:
        name: "{{ item }}"
        state: on
      loop:
        - selinux Boolean 1
        - selinux Boolean 2
      setsebool:
        name: targeted
        state: enforcing

    - name: Placeholder for AppArmor Configuration
      debug:
        msg: "AppArmor configuration is not implemented in this playbook."
      when: vault_hardening_configure_selinux_apparmor | default(false) and ansible_apparmor.status == "enabled"

  notify: 
    - Restart SELinux Service
    - Restart AppArmor Service

- name: Task 5 - Restrict sudo access
  lineinfile:
    path: /etc/sudoers
    line: "%{{ vault_sudo_group }} ALL=(ALL) NOPASSWD:ALL"
    regexp: "^%{{ vault_sudo_group }}"
    state: present
  become: yes

- name: Task 6 - Remove root login access
  file:
    path: /etc/ssh/sshd_config
    regexp: "^PermitRootLogin"
    line: PermitRootLogin no
    state: present
  notify: Restart SSH Service

- name: Task 7 - Remove .bash_history
  file:
    path: /root/.bash_history
    state: absent
  notify: Restart SSH Service

- name: Task 8 - Disable IPv6
  lineinfile:
    path: /etc/sysctl.conf
    line: "net.ipv6.conf.all.disable_ipv6 = 1"
    state: present
  notify: Apply Sysctl Settings

- name: Task 9 - Ensure permissions and ownership on /etc/ssh/sshd_config
  file:
    path: /etc/ssh/sshd_config
    mode: '0644'
    owner: root
    group: root
  notify: Restart SSH Service

- name: Task 10 - Set ulimit for root
  lineinfile:
    path: /etc/security/limits.conf
    line: "* soft nproc 65535"
    state: present
  notify: Apply PAM Settings

- name: Task 11 - Disable DNS Resolution
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "UseDNS no"
    state: present
  notify: Restart SSH Service

- name: Task 12 - Ensure SSH Protocol is set to 2
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "Protocol 2"
    state: present
  notify: Restart SSH Service

- name: Task 13 - Ensure X11 Forwarding is disabled
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "X11Forwarding no"
    state: present
  notify: Restart SSH Service

- name: Task 14 - Ensure SSH Idle Timeout Interval is configured
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "ClientAliveInterval 300"
    state: present
  notify: Restart SSH Service

- name: Task 15 - Ensure SSH LoginGraceTime is set to maximum
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "LoginGraceTime 120"
    state: present
  notify: Restart SSH Service

- name: Task 16 - Ensure SSH warning banner is configured
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "Banner /etc/issue.net"
    state: present
  notify: Restart SSH Service

- name: Task 17 - Ensure SSH Ciphers are configured
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr"
    state: present
  notify: Restart SSH Service

- name: Task 18 - Ensure SSH MAC Algorithms are configured
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,hmac-sha2-512,hmac-sha2-256"
    state: present
  notify: Restart SSH Service

- name: Task 19 - Ensure SSH Host Key Algorithms are configured
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "HostKeyAlgorithms ssh-ed25519,ssh-rsa,ssh-dss,ecdsa-sha2-nistp256,ecdsa-sha2-nistp384,ecdsa-sha2-nistp521"
    state: present
  notify: Restart SSH Service

- name: Task 20 - Ensure SSH Kex Algorithms are configured
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org,ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group-exchange-sha256"
    state: present
  notify: Restart SSH Service

- name: Task 21 - Ensure SSH Idle Timeout Interval is configured
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "ClientAliveCountMax 3"
    state: present
  notify: Restart SSH Service

- name: Task 22 - Ensure SSH Idle Timeout Interval is configured
  lineinfile:
    path: /etc/ssh/sshd_config
    line: "ClientAliveInterval 300"
    state: present
  notify: Restart SSH Service

handlers:
  - name: Restart SSH Service
    service:
      name: ssh
      state: restarted

  - name: Restart SELinux Service
    service:
      name: selinux
      state: restarted

  - name: Restart AppArmor Service
    service:
      name: apparmor
      state: restarted

  - name: Apply Sysctl Settings
    sysctl:
      name: "{{ item }}"
      value: "1"
      state: present
    loop:
      - net.ipv6.conf.all.disable_ipv6

  - name: Apply PAM Settings
    service:
      name: ssh
      state: restarted

