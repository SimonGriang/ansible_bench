---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  copy:
    src: /usr/local/bin/rke2.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: restart_rke2_service

- name: Copy kubelet config
  copy:
    src: /usr/local/bin/kubelet.yaml.j2
    dest: /etc/rancher/rke2/kubelet.yaml
    owner: root
    group: root
    mode: '0644'
  notify: restart_rke2_service
  when: rke2_kubelet_config|length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: /usr/local/bin/registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0644'
  notify: restart_rke2_service
  when: (rke2_custom_registry_mirrors|length > 0) or (rke2_custom_registry_configs|length > 0)

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    daemon_reload: yes
    masked: no
    environment: "RKE2_TOKEN={{ rke2_token }}"
  register: service_result
  notify: rke2_service_restarted
  retries: 5
  delay: 30
  when: rke2_type == 'server'

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: rke2-agent
    state: masked
    enabled: no
  when: rke2_type == 'server'
  notify: rke2_service_restarted
  retries: 5
  delay: 30

- name: Wait for remaining nodes to be ready - no CNI
  shell: kubectl get nodes -o json | jq -r '.items[] | select(.metadata.labels."node-role.kubernetes.io/control-plane" != "true") | .status.conditions[] | select(.type == "Ready" or .type == "MemoryPressure" or .type == "DiskPressure" or .type == "PIDPressure") | .status' | grep -q 'True'
  retries: 30
  delay: 10
  when: rke2_cni != 'none' and (rke2_active_server or rke2_is_first_server)

- name: Wait for remaining nodes to be ready - with CNI
  shell: kubectl get nodes -o json | jq -r '.items[] | select(.metadata.labels."node-role.kubernetes.io/control-plane" != "true") | .status.conditions[] | select(.type == "Ready") | .status' | grep -v 'True' | wc -l | grep -q '^0$'
  retries: 30
  delay: 10
  when: rke2_cni != 'none' and (rke2_active_server or rke2_is_first_server)

