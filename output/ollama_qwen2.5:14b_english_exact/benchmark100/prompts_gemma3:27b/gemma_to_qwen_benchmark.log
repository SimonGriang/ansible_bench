---
- import_tasks: assert.yml
  run_once: true
  remote_addr: localhost

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: user_check
  failed_when: user_check|failed and lookup('ansible_lookup_plugin_technical_account', 'fail_key') == 'true'

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0644'

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version }}"
    force: "{{ item.force }}"
    update: yes
  register: clone_results
  loop: "{{ git_repositories }}"
  loop_control:
    label: "{{ item.dest }}"
  become: yes
  become_user: "{{ git_username }}


