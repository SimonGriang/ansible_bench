---
- name: Restart the RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready
  shell: "{{ rke2_data_path }}/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes -o json | jq -r '.items[] | select(.metadata.labels."node\\.role\\.kubernetes\\.io/{{ rke2_cluster_group_name }}" != null) | .status.conditions[] | select(.type == "Ready") | .status' | grep True | wc -l"
  register: ready_nodes
  until: ready_nodes.stdout | int == groups['rke2_cluster_group_name'] | length
  retries: 100
  delay: 15
  delegate_to: "{{ groups['rke2_servers_group_name'][0] }}"
  run_once: true

- name: Wait for all pods to be ready
  shell: "{{ rke2_data_path }}/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get pods -A -o json | jq -r '.items[] | select(.status.phase != "Running" and .status.phase != "Succeeded") | .metadata.namespace + \":\" + .metadata.name' | wc -l"
  register: not_ready_pods
  until: not_ready_pods.stdout | int == 0
  retries: 100
  delay: 15
  delegate_to: "{{ groups['rke2_servers_group_name'][0] }}"
  run_once: true
  when: rke2_wait_for_all_pods_to_be_ready | default(false) and not ansible_check_mode

