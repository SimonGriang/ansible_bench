me: Flush handlers\n  meta: flush_handlers\n\n- name: Removing default html\n  file:\n    path: "{{ httpd_data_dir }}/index.html"\n    state: absent\n  when: httpd_remove_example\n\n- name: Start and enable httpd\n  service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: yes' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-20T19:53:31.87299994Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14569124153, 'load_duration': 71823319, 'prompt_eval_count': 816, 'prompt_eval_duration': 418342239, 'eval_count': 575, 'eval_duration': 14070298129, 'model_name': 'qwen2.5:14b'} id='run--77bf896e-9672-42f4-b6a4-dd8410f1aa67-0' usage_metadata={'input_tokens': 816, 'output_tokens': 575, 'total_tokens': 1391}
