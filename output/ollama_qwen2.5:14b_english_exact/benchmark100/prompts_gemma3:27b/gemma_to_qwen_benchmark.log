---
- import_tasks: assert.yml
  when: true
  remote_addr: localhost

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/mailname
    value: "{{ ansible_fqdn }}"
    vtype: string
  when: ansible_os_family == 'Debian'

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'No configuration'
    vtype: select
  when: ansible_os_family == 'Debian'

- name: Install postfix
  apt:
    name: postfix
    state: present
  when: ansible_os_family == 'Debian'

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: (postfix_virtual_mailbox_maps_mysql == True or postfix_virtual_domains_mysql == True)

- name: Configure postfix (transport_maps)
  template:
    src: postfix_transport_maps.j2
    dest: /etc/postfix/transport
  notify: postfix_validate
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: postfix_header_checks.j2
    dest: /etc/postfix/header_checks
  notify: postfix_reload
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_values: "{{ postfix_main_cf_values | default({}) | combine(postfix_main_cf_values_from_vars) }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf_values: "{{ postfix_main_cf_values | combine(postfix_main_cf_values_from_lists) | combine(postfix_main_cf_values_from_strings) | default({}) | combine(postfix_main_cf_values_from_defaults) }}"

- name: Configure postfix (main.cf)
  template:
    src: postfix_main_cf.j2
    dest: /etc/postfix/main.cf
  notify: postfix_validate
  notify: postfix_restart

- name: Configure postfix (master.cf)
  template:
    src: postfix_master_cf.j2
    dest: /etc/postfix/master.cf
  notify: postfix_validate
  notify: postfix_restart

- name: Creates cert/key directory
  file:
    path: "{{ postfix_cert_dir }}"
    state: directory
  when: postfix_cert_dir is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_cert_file }}"
    dest: "{{ postfix_cert_dir }}/{{ postfix_cert_name }}"

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_key_file }}"
    dest: "{{ postfix_cert_dir }}/{{ postfix_key_name }}"

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    content: "{{ postfix_aliases_content | to_json }}"
    dest: /etc/postfix/aliases
  notify: postfix_reload

- name: Configure sender_access
  copy:
    content: "{{ postfix_sender_access | to_json }}"
    dest: /etc/postfix/sender_access

- name: Configure recipient_access
  copy:
    content: "{{ postfix_recipient_access | to_json }}"
    dest: /etc/postfix/recipient_access

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: /etc/postfix/sasl_password_map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    enabled: yes
    state: started

