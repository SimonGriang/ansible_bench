me: Set users password valid time\n  ansible.builtin.command: chage -M "{{ user.password_max_days }}" "{{ user.name }}"\n  when: user.password_max_days is defined\n\n- name: Place private key file for user\n  ansible.builtin.copy:\n    content: "{{ user.private_keys }}"\n    dest: "{{ user_home }}/.ssh/id_rsa"\n    mode: \'0600\'\n    owner: "{{ user.name }}"\n    group: "{{ user.group | default(user.name) }}"\n  when: user.private_keys is defined\n\n# Ensuring there\'s a newline at the end of the file\n# This is implicitly added by the output mechanism' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-20T20:01:36.857427344Z', 'done': True, 'done_reason': 'stop', 'total_duration': 27211857295, 'load_duration': 89110338, 'prompt_eval_count': 2264, 'prompt_eval_duration': 754304525, 'eval_count': 1145, 'eval_duration': 26355008854, 'model_name': 'qwen2.5:14b'} id='run--2b003ebb-439c-4635-8d4b-4fc99e61991f-0' usage_metadata={'input_tokens': 2264, 'output_tokens': 1145, 'total_tokens': 3409}
