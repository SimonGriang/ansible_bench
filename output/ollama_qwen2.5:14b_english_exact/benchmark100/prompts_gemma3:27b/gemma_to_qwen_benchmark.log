content='---\n- name: Get all RKE2 nodes\n  shell: kubectl get nodes -o jsonpath=\'{range .items[*]}{.metadata.name}{"\\n"}{end}\' --kubeconfig=/path/to/kubeconfig\n  register: node_names_output\n- name: Set node_names variable\n  set_fact:\n    node_names: "{{ node_names_output.stdout_lines }}"\n\n- name: Remove old RKE2 nodes\n  shell: kubectl delete node {{ item }} --ignore-not-found=true --now=true --kubeconfig=/path/to/kubeconfig\n  loop: "{{ node_names }}"\n  when: "\'{{ item }}\' not in groups[\'rke2_cluster_group_name\']"' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-20T20:36:08.490761469Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3088182719, 'load_duration': 96013236, 'prompt_eval_count': 386, 'prompt_eval_duration': 104698686, 'eval_count': 147, 'eval_duration': 2882459659, 'model_name': 'qwen2.5:14b'} id='run--5dbf2afc-3982-4e71-bee7-df0c253786f9-0' usage_metadata={'input_tokens': 386, 'output_tokens': 147, 'total_tokens': 533}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Get all RKE2 nodes
  shell: kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' --kubeconfig=/path/to/kubeconfig
  register: node_names_output
- name: Set node_names variable
  set_fact:
    node_names: "{{ node_names_output.stdout_lines }}"

- name: Remove old RKE2 nodes
  shell: kubectl delete node {{ item }} --ignore-not-found=true --now=true --kubeconfig=/path/to/kubeconfig
  loop: "{{ node_names }}"
  when: "'{{ item }}' not in groups['rke2_cluster_group_name']"

