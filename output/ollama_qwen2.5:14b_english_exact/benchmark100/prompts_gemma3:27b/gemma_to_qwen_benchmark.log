---
- import_tasks: assert.yml
  remote_addr: localhost

- name: Configure apk
  when: ansible_pkg_mgr == 'apk'
  become: yes
  block:
    - name: Update apk cache
      shell: apk update
    - name: Upgrade all software
      shell: apk upgrade
      notify: Reboot

- name: Configure apt
  when: ansible_pkg_mgr == 'apt'
  become: yes
  block:
    - name: Pin packages to prevent upgrades
      apt:
        name: "{{ item }}"
        state: "present"
        pin: "origin"
        pin_option: "EQ"
        pin_priority: "1001"
      loop: "{{ update_excluded_packages | default([]) | list }}"
    - name: Update apt cache
      apt:
        update_cache: yes
    - name: Upgrade all software
      apt:
        upgrade: "dist"
        name: "*"
        exclude: "{{ update_excluded_packages | default([]) | list }}"
      notify: Reboot
    - name: Remove unused packages
      apt:
        autoremove: yes
      when: apt_autoremove_enabled | bool

- name: Update all software (dnf)
  when: ansible_pkg_mgr == 'dnf' or ansible_pkg_mgr == 'dnf5'
  become: yes
  block:
    - name: Update all software
      dnf:
        upgrade: "all"
        excludes: "{{ update_excluded_packages | default([]) | list }}"
      notify: Reboot

- name: Update all software (pacman)
  when: ansible_pkg_mgr == 'pacman'
  become: yes
  block:
    - name: Update all software
      pacman:
        sync: "--sysupgrade"
      notify: Reboot

- name: Configure yum
  when: ansible_pkg_mgr == 'yum'
  become: yes
  block:
    - name: Update all software
      yum:
        update_cache: yes
        update_only: yes
        name: "*"
        exclude: "{{ update_excluded_packages | default([]) | list }}"
      when: ansible_pkg_mgr_version | int == 6
    - name: Update all software
      yum:
        update_cache: yes
        update_only: yes
        name: "*"
      when: ansible_pkg_mgr_version | int != 6
      notify: Reboot

- name: Update all software (zypper)
  when: ansible_pkg_mgr == 'zypper'
  become: yes
  block:
    - name: Update all software
      zypper:
        name: "@System"
        update: yes
      notify: Reboot

