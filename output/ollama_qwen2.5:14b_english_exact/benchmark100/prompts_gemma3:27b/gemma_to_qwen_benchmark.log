---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install dns
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ dns_packages }}"

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0750
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present
    system: yes
    gid: "{{ dns_group_id | default('') }}"
  when: dns_group is defined

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: yes
    uid: "{{ dns_owner_id | default('') }}"
    group: "{{ dns_group }}"
  when: dns_owner is defined

- name: Generate rndc key
  command: "/usr/sbin/rndc-confgen -a -c {{ dns_confdir }}/rndc.key"
  args:
    creates: "{{ dns_confdir }}/rndc.key"
  register: rndc_key_created
  changed_when: "'rndc.key' in rndc_key_created.stdout"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    mode: 0600
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_confdir is defined

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/named.root"
    mode: 0644
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns
  register: root_hints_downloaded
  notify: Rndc reload

- name: Create zone file
  block:
    - name: Ensure zone file exists
      template:
        src: "zone.j2"
        dest: "{{ dns_datadir }}/{{ item.name }}.db"
        mode: 0640
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
      notify: Rndc reload
      register: zone_file_created
      vars:
        zone: "{{ item }}"
      when: item.enabled
      loop: "{{ dns_zones }}"
    - name: Validate zone file
      command: /usr/sbin/named-checkzone "{{ item.name }}" "{{ dns_datadir }}/{{ item.name }}.db"
      register: zone_validation
      failed_when: "'is valid' not in zone_validation.stdout"
      when: item.enabled
      loop: "{{ dns_zones }}"
      changed_when: "'is valid' in zone_validation.stdout"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named.conf
    mode: 0644
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  notify: Restart dns
  register: named_conf_updated
  changed_when: named_conf_updated is changed

- name: Place systemd override
  block:
    - name: Create override directory
      file:
        path: /etc/systemd/system/{{ dns_service }}.d
        state: directory
        mode: 0755
      when: ansible_distribution == "CentOS" or ansible_os_family == "Debian"
    - name: Copy override file
      copy:
        src: override.conf
        dest: /etc/systemd/system/{{ dns_service }}.d/override.conf
        mode: 0644
      when: ansible_distribution == "CentOS" or ansible_os_family == "Debian"
    - name: Reload systemd daemon
      systemd:
        name: "{{ dns_service }}"
        daemon_reload: yes
      when: ansible_distribution == "CentOS" or ansible_os_family == "Debian"

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: yes
  when: dns_service is defined

