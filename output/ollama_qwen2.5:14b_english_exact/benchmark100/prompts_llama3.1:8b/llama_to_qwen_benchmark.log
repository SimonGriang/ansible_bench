---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for a specified port to become available
  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when: "'docker' not in ansible_connection and 'container' not in ansible_connection and 'community.docker.docker' not in ansible_connection and bootstrap_wait_for_host is defined"

- name: Prepare the system for further tasks
  block:
    - name: Check if the connection is established
      command: whoami
      register: bootstrap_connect
      failed_when: bootstrap_connect.rc == 1

    - name: Gather bootstrap facts if connection is not established
      ansible_facts:
        bootstrap_facts: "{{ lookup('ansible.builtin.setup') }}"
      when: not bootstrap_connect.changed

    - name: Include gather facts file
      import_tasks: gather_facts.yml
      when: not bootstrap_connect.changed

