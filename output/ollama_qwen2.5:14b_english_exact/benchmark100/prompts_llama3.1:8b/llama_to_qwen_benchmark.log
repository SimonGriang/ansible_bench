---
- name: Create the directories for the cadvisor installation
  file:
    path: /opt/cadvisor
    state: directory
    mode: '0755'

- name: Download the cadvisor binary from the internet
  block:
    - name: Ensure the cadvisor directory is empty
      shell: test -z "$(ls -A /opt/cadvisor)"
      register: dir_empty
      changed_when: false

    - name: Download the cadvisor binary
      get_url:
        url: https://github.com/google/cadvisor/releases/download/v0.38.0/cadvisor
        dest: /opt/cadvisor/cadvisor
        mode: '0755'
        checksum: sha256:4e4f8d6dbb1c48e3f0b40f5c7f9b304d18a3d8b53c75b0ebd79d3d6b96e8a869
      when: dir_empty.stdout == '0'
      register: download_result
      changed_when: download_result.stdout.find('Downloaded') != -1

- name: Copy the locally distributed cadvisor binary
  copy:
    src: /local/path/to/cadvisor
    dest: /opt/cadvisor/cadvisor
    mode: '0755'
  when: dir_empty.stdout != '0'

- name: Create a symlink to the cadvisor binary
  file:
    src: /opt/cadvisor/cadvisor
    dest: /opt/cadvisor/cadvisor_bin
    state: link

- name: Configure the cadvisor systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
  when: dir_empty.stdout != '0'

- name: Test if the cadvisor service is active
  shell: systemctl is-active cadvisor
  register: service_active

- name: Enable the cadvisor systemd service
  systemd:
    name: cadvisor
    enabled: yes

- name: Start the cadvisor systemd service
  systemd:
    name: cadvisor
    state: started
    daemon_reload: yes

