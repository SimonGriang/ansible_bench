---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_src }}"
    dest: /etc/systemd/system/kubelet.service.d/10-kubelet-rke2-config.yaml
    owner: root
    group: root
    mode: '0644'
  when: rke2_kubelet_config|length > 0
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_config_src }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0644'
  when: rke2_custom_registry_mirrors|length > 0 or rke2_custom_registry_configs|length > 0
  notify: Config file changed

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: "{{ rke2_service_name }}"
    enabled: yes
    state: started
    daemon_reload: yes
    retry: 60
    delay: 2
  notify: Service (re)started

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ item }}"
    masked: yes
  with_items: "{{ rke2_services | difference([rke2_type]) }}"

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    host: "{{ item }}"
    port: 6443
    delay: 1
    timeout: 120
    state: started
  with_items: "{{ groups['rke2_nodes'] | difference([inventory_hostname]) }}"

- name: Wait for remaining nodes to be ready - with CNI
  shell: kubectl get nodes --no-headers | awk '$2 == "Ready" {print $1}' | wc -l
  register: ready_nodes_count
  until: ready_nodes_count.stdout|int >= ({{ groups['rke2_nodes'] | length }} - 1)
  retries: 60
  delay: 1
  when: inventory_hostname == groups['rke2_servers'][0] or inventory_hostname == groups['rke2_servers'][1]

