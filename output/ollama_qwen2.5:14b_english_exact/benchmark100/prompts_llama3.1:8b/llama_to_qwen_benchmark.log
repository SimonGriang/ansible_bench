tion': 20474730694, 'model_name': 'qwen2.5:14b'} id='run--7729de45-6f11-4fec-96e5-8664a58bab1b-0' usage_metadata={'input_tokens': 876, 'output_tokens': 953, 'total_tokens': 1829}
