---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: "{{ kubelet_config_src }}"
    dest: /etc/systemd/system/kubelet.service.d/10-kubelet.yaml
    owner: root
    group: root
    mode: '0644'
  when: rke2_kubelet_config|length > 0
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ containerd_registry_config_src }}"
    dest: /etc/containerd/config.toml
    owner: root
    group: root
    mode: '0644'
  when: rke2_custom_registry_mirrors|length > 0 or rke2_custom_registry_configs|length > 0
  notify: Config file changed

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: yes
    daemon_reload: yes
    force: yes
    warn: yes
    timeout: 300
    retries: 3
    delay: 30
  notify: Service (re)started

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ item }}"
    state: masked
  loop: "{{ rke2_other_services }}"
  when: item not in rke2_type

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    path: "{{ item }}"
    state: started
    delay: 15
    timeout: 300
  loop: "{{ rke2_remaining_nodes }}"
  when: rke2_cni is not defined

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    path: "{{ rke2_remaining_nodes }}"
    state: ready
    delay: 15
    timeout: 300
  when: rke2_cni is defined and ('{{ rke2_is_active_server }}' or ('{{ rke2_is_first_server }}' and item is first))

