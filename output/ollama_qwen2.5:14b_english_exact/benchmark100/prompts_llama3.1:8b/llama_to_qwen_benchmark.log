\']\n\n- name: Import directories.yml if the httpd_directories variable is defined\n  import_playbook: directories.yml\n  when: httpd_directories is defined\n\n- name: Remove the default index.html file in the httpd data directory if the httpd_remove_example variable is true\n  file:\n    path: "{{ httpd_data_dir }}/index.html"\n    state: absent\n  when: httpd_remove_example | default(false)\n\n- name: Start and enable the httpd service\n  service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: yes' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-13T06:04:04.292734075Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12376176429, 'load_duration': 83116170, 'prompt_eval_count': 962, 'prompt_eval_duration': 460785250, 'eval_count': 595, 'eval_duration': 11819316042, 'model_name': 'qwen2.5:14b'} id='run--073f4d9c-cd94-4e58-9bdf-37ecf37ff92c-0' usage_metadata={'input_tokens': 962, 'output_tokens': 595, 'total_tokens': 1557}
