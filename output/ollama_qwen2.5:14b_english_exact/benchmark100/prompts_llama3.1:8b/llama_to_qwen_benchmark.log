---
- name: Load OS-specific variables based on the detected operating system
  include_vars:
    file: "{{ lookup('ansible_os_family', default='RedHat') }}.yml"
    name: os_vars

- name: Include setup tasks for RedHat-based systems
  include_tasks: redhat.yml
  when: os_vars.ansible_os_family == "RedHat"

- name: Include setup tasks for Debian-based systems
  include_tasks: debian.yml
  when: os_vars.ansible_os_family == "Debian"

- name: Install Docker packages on systems with Ansible version less than 2.12 or non-RedHat/Debian systems
  apt:
    name: "{{ os_vars.docker_package }}"
    state: present
    update_cache: yes
  when: ansible_distribution in ['Ubuntu', 'Debian'] and ansible_version == "2.11" or ansible_distribution not in ['RedHat', 'Debian']

- name: Install Docker packages (with downgrade option) on systems with Ansible version 2.12 or higher and RedHat/Debian systems
  apt:
    name: "{{ os_vars.docker_package }}"
    state: present
    update_cache: yes
    force_apt_get: yes
    allow_downgrade: true
  when: ansible_version >= "2.12" and ansible_distribution in ['RedHat', 'Debian']

- name: Install the docker-compose plugin on systems where the plugin is enabled and the system meets the criteria for task 4 or 5
  package:
    name: "{{ os_vars.docker_compose_package }}"
    state: present
  when: os_vars.docker_compose_plugin_enabled and (ansible_version == "2.11" or (ansible_version >= "2.12" and ansible_distribution in ['RedHat', 'Debian']))

- name: Install the docker-compose-plugin (with downgrade option) on systems where the plugin is enabled and the system meets the criteria for task 5
  package:
    name: "{{ os_vars.docker_compose_package }}"
    state: present
    force: yes
    allow_downgrade: true
  when: os_vars.docker_compose_plugin_enabled and ansible_version >= "2.12" and ansible_distribution in ['RedHat', 'Debian']

- name: Ensure the /etc/docker/ directory exists and has the correct permissions
  file:
    path: /etc/docker/
    state: directory
    mode: 0750

- name: Configure the Docker daemon options by copying the options to the daemon.json file
  copy:
    content: "{{ os_vars.docker_daemon_options }}"
    dest: /etc/docker/daemon.json
    mode: 0644

- name: Ensure Docker is started and enabled at boot, if configured to do so
  service:
    name: docker
    state: started
    enabled: "{{ os_vars.docker_start_and_enable }}"

- name: Notify handlers to ensure firewall rules are updated
  meta: flush_handlers

- name: Include tasks for managing docker-compose, if enabled
  include_tasks: manage_docker-compose.yml
  when: os_vars.docker_compose_enabled

- name: Get information about the docker group using getent
  command: getent group docker
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  set_fact:
    users_to_add: "{{ users_to_add | default([]) + docker_group_info.stdout_lines }}"
  when: docker_group_info.stdout_lines | length > 0

- name: Include tasks for managing docker users, if necessary
  include_tasks: manage_docker_users.yml
  when: users_to_add | length > 0

