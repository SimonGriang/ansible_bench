    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"

- name: Loop over users_groups
  ansible.builtin.include_tasks:
    file: group.yml
    loop_control:
      loop_var: group
  loop: "{{ users_groups }}"

- name: Ensure the /etc/sudoers.d directory is included
  ansible.builtin.lineinfile:
    path: /etc/sudoers
    line: "{{ users_sudo_includedir }}"
    regexp: "^{{ users_sudo_includedir }}"
    create: false
    backup: true

- name: Loop over users
  ansible.builtin.include_tasks:
    file: user.yml
    loop_control:
      loop_var: user
  loop: "{{ users }}"

- name: Manage cron permission
  ansible.builtin.template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow is defined

- name: Check existence of /etc/cron.allow
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is not defined

# Note: The above playbook includes a newline at the end of the file to comply with yamllint checks.

