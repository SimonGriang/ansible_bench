05765Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8665953081, 'load_duration': 98890145, 'prompt_eval_count': 1354, 'prompt_eval_duration': 305634614, 'eval_count': 475, 'eval_duration': 8247325983, 'model_name': 'qwen2.5:14b'} id='run--55be42cd-ef64-4692-bf00-81670c73fb27-0' usage_metadata={'input_tokens': 1354, 'output_tokens': 475, 'total_tokens': 1829}
