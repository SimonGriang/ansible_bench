---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: enabled
  when: ansible_distribution_major_version == "8" and ansible_os_family == "RedHat"

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  copy:
    src: "{{ item }}"
    dest: "{{ redis_conf_dir }}/{{ item | basename }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  with_items: "{{ redis_conf_files }}"
  notify: Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes

