---
- name: Gather Bootstrap Facts
  ansible.builtin.shell: "cat /etc/os-release"
  register: bootstrap_facts
  become: false

- name: Set Bootstrap Distribution Facts (I)
  ansible.builtin.shell: "grep '^{{ item }}=' /etc/os-release | cut -d '=' -f 2"
  register: bootstrap_distribution
  loop: "{{ bootstrap_os_family_map | flatten }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_search[item] is defined
    - bootstrap_facts.stdout is search(bootstrap_search[item])
  environment:
    PIPESTATUS: 'true'

- name: Set Bootstrap OS Family Facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.value.bootstrap_os_family }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  when: item.value.bootstrap_distribution in bootstrap_distribution.stdout
  become: false

