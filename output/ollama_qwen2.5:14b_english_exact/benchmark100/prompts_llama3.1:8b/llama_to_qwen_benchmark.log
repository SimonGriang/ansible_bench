---
- name: Create local ssh key directory for a user
  file:
    path: "/home/{{ user_name }}/.ssh"
    state: directory
    mode: '0750'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Manage the user account
  user:
    name: "{{ user_name }}"
    comment: "{{ user_comment }}"
    group: "{{ user_group }}"
    create_home: "{{ create_home }}"
    password: "{{ user_password }}"
    password_expiration: "{{ user_password_expiration }}"
    shell: "{{ user_shell }}"
    update_password: "always"
    system: "{{ user_system }}"
    uid: "{{ user_uid }}"
    gid: "{{ user_gid }}"
    state: "present"

- name: Set up the user's sudo options
  template:
    src: "sudoers.j2"
    dest: "/etc/sudoers.d/{{ user_name }}"
    mode: '0440'
  when: user_sudo_options is defined and user_sudo_options != ""
  notify: restart sudo service

- name: Generate the user's private SSH key
  command: ssh-keygen -t rsa -b 4096 -f /home/{{ user_name }}/.ssh/id_rsa -N ""
  args:
    creates: /home/{{ user_name }}/.ssh/id_rsa
  when: user_ssh_key_management is defined and user_ssh_key_management == "true"

- name: Generate the user's public SSH key
  command: ssh-keygen -t rsa -b 4096 -f /home/{{ user_name }}/.ssh/id_rsa -N ""
  args:
    creates: /home/{{ user_name }}/.ssh/id_rsa.pub
  when: user_ssh_key_management is defined and user_ssh_key_management == "true"

- name: Convert the user's SSH key to PPK format
  command: ssh-keygen -p -m PKCS8 -f /home/{{ user_name }}/.ssh/id_rsa
  args:
    creates: /home/{{ user_name }}/.ssh/id_rsa.ppk
  when: user_ssh_key_management is defined and user_ssh_key_management == "true"

- name: Get or set the user's home directory
  shell: "getent passwd {{ user_name }} | cut -d: -f6"
  register: user_home_dir
  changed_when: false
  failed_when: false
  when: user_home_dir is not defined

- name: Create the user's .ssh directory
  file:
    path: "/home/{{ user_name }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Deploy authorized keys for the user
  authorized_key:
    user: "{{ user_name }}"
    key: "{{ item }}"
    state: present
    type: ssh-rsa
  with_items: "{{ user_authorized_keys }}"
  notify: set authorized keys permissions

- name: Remove unauthorized keys for the user
  authorized_key:
    user: "{{ user_name }}"
    key: "{{ item }}"
    state: absent
  with_items: "{{ user_unauthorized_keys }}"
  notify: set authorized keys permissions

- name: Copy the generated private SSH key for the user
  copy:
    src: "/home/{{ user_name }}/.ssh/id_rsa"
    dest: "/home/{{ user_name }}/id_rsa"
    mode: '0400'
  when: user_copy_private_key is defined and user_copy_private_key == "true"

- name: Check the user's password validity
  command: getent shadow {{ user_name }}
  register: users_pw_valid
  changed_when: false
  failed_when: false

- name: Set the user's password validity
  command: chage -M {{ user_password_expiration_days }} {{ user_name }}
  when: users_pw_valid is defined and user_password_expiration_days is defined and users_pw_valid.stdout.find(":") == -1

- name: Place the private key file for the user
  copy:
    src: "/home/{{ user_name }}/.ssh/id_rsa"
    dest: "/home/{{ user_name }}/id_rsa"
    mode: '0400'
  when: user_private_keys is defined and user_private_keys != ""

