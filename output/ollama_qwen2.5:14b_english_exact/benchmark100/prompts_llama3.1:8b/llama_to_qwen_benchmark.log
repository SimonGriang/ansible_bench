---
- name: Check if python is installed
  ansible.builtin.command: which python
  register: python_path
  changed_when: false
  failed_when: false

- name: Check if python3 is installed
  ansible.builtin.command: which python3
  register: python3_path
  changed_when: false
  failed_when: false

- name: Debug Python executable path
  ansible.builtin.debug:
    msg: "Python executable path: {{ python_path.stdout }}"

- name: Debug Python3 executable path
  ansible.builtin.debug:
    msg: "Python3 executable path: {{ python3_path.stdout }}"

- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml
  loop: [{}]
  loop_control:
    loop_var: item
  run_once: true

- name: Install requirements
  ansible.builtin.yum:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_requirements }}"
  loop_control:
    loop_var: item

- name: Ensure packaging is available via dnf
  ansible.builtin.yum:
    name: python3-packaging
    state: present

- name: Install pip packages
  ansible.builtin.pip:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_pip_packages }}"
  loop_control:
    loop_var: item

- name: Create key directory
  ansible.builtin.file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create csr directory
  ansible.builtin.file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create crt directory
  ansible.builtin.file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include create.yml
  ansible.builtin.include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item
  when: inventory_hostname == 'localhost'

