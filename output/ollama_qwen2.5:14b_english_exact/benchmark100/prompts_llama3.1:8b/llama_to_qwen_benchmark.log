---
- import_tasks: assert.yml

- name: Configure package management for apk
  when: ansible_pkg_mgr == 'apk'
  block:
    - name: Update cache and install all available packages
      apk:
        update_cache: yes
        upgrade: true

- name: Configure package management for apt
  when: ansible_pkg_mgr == 'apt'
  block:
    - name: Prevent certain packages from being upgraded
      apt:
        name: "{{ item }}"
        state: present
      loop: ['linux-image-*', 'libc6', 'libstdc++6', 'lsb-release']
    - name: Update all software
      apt:
        update_cache: yes
        upgrade: dist
    - name: Autoremove unnecessary packages
      apt:
        autoremove: yes
        purge: yes

- name: Update all software for dnf
  when: ansible_pkg_mgr == 'dnf'
  block:
    - name: Update all packages to the latest version
      dnf:
        name: '*'
        state: latest
        exclude: ['kernel*']

- name: Update all software for pacman
  when: ansible_pkg_mgr == 'pacman'
  block:
    - name: Update the package cache
      pacman:
        update_cache: yes
    - name: Upgrade all packages
      pacman:
        sync: '@'

- name: Configure package management for yum
  when: ansible_pkg_mgr == 'yum'
  block:
    - name: Use dnf for yum versions > 6
      yum:
        name: yum-utils
        state: present
      when: ansible_yum_version is version('6', '>=')
    - name: Ensure yum-utils is installed for non-6 yum versions
      yum:
        name: yum-utils
        state: present
      when: ansible_yum_version is version('6', '<')

- name: Update all software for zypper
  when: ansible_pkg_mgr == 'zypper'
  block:
    - name: Update all packages to the latest version
      zypper:
        name: '*'
        state: latest

