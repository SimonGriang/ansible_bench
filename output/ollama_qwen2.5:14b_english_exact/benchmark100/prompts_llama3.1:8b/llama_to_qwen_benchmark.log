---
- import_role:
    name: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install git package
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if a user exists
  delegate_to: localhost
  shell: getent passwd {{ git_username }}
  register: user_exists
  changed_when: false
  failed_when: false
  when: git_username is defined

- name: Create a directory for git configuration
  file:
    path: /home/{{ git_username }}
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0755'
  when:
    - git_username is defined
    - user_exists.rc == 0

- name: Configure git
  template:
    src: gitconfig.j2
    dest: /home/{{ git_username }}/.gitconfig
    mode: '0644'
  when:
    - git_username is defined
    - git_user_email is defined
    - git_user_name is defined
    - user_exists.rc == 0

- name: Create the repository destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0755'
  when:
    - git_username is defined
    - user_exists.rc == 0

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version | default('HEAD') }}"
    force: "{{ item.force | default('false') | bool }}"
    clone: yes
    update: yes
    accept_hostkey: yes
  with_items: "{{ git_repositories }}"
  become_user: "{{ git_username }}"
  when:
