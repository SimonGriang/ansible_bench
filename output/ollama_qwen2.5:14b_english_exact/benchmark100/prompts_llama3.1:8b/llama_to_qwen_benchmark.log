---
- name: Lookup bootstrap facts
  raw: cat /etc/os-release
  register: bootstrap_facts

- name: Set bootstrap distribution and major version facts
  set_fact:
    bootstrap_distribution: "{{ item.value.distribution }}"
    bootstrap_major_version: "{{ item.value.major_version }}"
  loop: "{{ bootstrap__os_family_map|dict2items }}"
  when: bootstrap_facts.stdout|b64decode|b64decode|b64decode == item.key

- name: Set bootstrap OS family fact
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  loop: "{{ bootstrap__os_family_map|dict2items }}"
  when: bootstrap_distribution is defined and bootstrap_distribution == item.key

