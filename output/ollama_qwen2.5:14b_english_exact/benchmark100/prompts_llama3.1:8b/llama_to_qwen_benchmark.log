      raw: "{{ item }}"
      loop: "{{ bootstrap_facts_packages }}"
      when: bootstrap_connect | failed

- name: Gather Ansible facts about the system
  setup: {}

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become }}"

