---
- name: Restart RKE2 service on a node
  service:
    name: rke2
    state: restarted
    enabled: true
    daemon_reload: true
  notify: Service (re)started
  when: inventory_hostname == rke2_node_name

- name: Wait for all nodes to be ready again
  shell: kubectl get nodes --no-headers | grep ' Ready' | wc -l
  register: all_ready_nodes
  until: all_ready_nodes.stdout | int == groups['rke2_nodes_group_name'] | length
  delegate_to: "{{ groups['rke2_servers_group_name'][0] if inventory_hostname not in groups['rke2_servers_group_name'] else inventory_hostname }}"
  delay: 15
  retries: 100
  run_once: true
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  shell: kubectl get pods --all-namespaces --field-selector=status.phase!=Running,status.phase!=Succeeded --no-headers | wc -l
  register: all_pods_ready
  until: all_pods_ready.stdout | int == 0
  delegate_to: "{{ groups['rke2_servers_group_name'][0] if inventory_hostname not in groups['rke2_servers_group_name'] else inventory_hostname }}"
  delay: 15
  retries: 100
  run_once: true
  when: not (ansible_check_mode | bool) and (rke2_wait_for_all_pods_to_be_ready | bool)

