---
- name: Install OpenJDK implementation
  yum:
    name: java-1.8.0-openjdk
    state: present
  when: ansible_distribution == 'CentOS' or ansible_os_family == 'RedHat'
  become: yes

- name: Install OpenJDK implementation (Debian variant)
  apt:
    name: default-jdk
    state: present
  when: ansible_os_family == 'Debian'
  become: yes

- name: Import certificates into Java Keystore
  command: >
    keytool -importcert -file /path/to/{{ item }} -alias {{ item|splitext|first }}
    -storepass changeit -keystore /etc/pki/java/cacerts
  loop: "{{ java_certs }}"
  when: java_certs is defined
  become: yes

