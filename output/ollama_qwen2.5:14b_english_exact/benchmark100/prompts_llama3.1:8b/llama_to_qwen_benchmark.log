---
- name: Create local ssh key directory for a user
  file:
    path: "{{ ssh_key_dir }}"
    state: directory
    mode: 0750
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Manage the user account
  user:
    name: "{{ user_name }}"
    comment: "{{ user_comment }}"
    group: "{{ user_group }}"
    create_home: "{{ create_home }}"
    password: "{{ user_password }}"
    password_expires: "{{ password_expiration }}"
    shell: "{{ user_shell }}"
    system: "{{ user_system }}"
    uid: "{{ user_uid }}"
    gid: "{{ user_gid }}"
    state: "{{ user_state }}"

- name: Set up the user's sudo options
  template:
    dest: /etc/sudoers.d/{{ user_name }}_sudo
    mode: 0440
    content: "{{ sudo_template }}"
  when: sudo_options is defined and sudo_options != ""

- name: Generate the user's private SSH key
  command: ssh-keygen -t rsa -f "{{ ssh_key_dir }}/{{ user_name }}_id_rsa" -N ""
  when: generate_ssh_key is defined and generate_ssh_key == "true"
  register: ssh_key_gen_result
  changed_when: "'WARNING: failed to' not in ssh_key_gen_result.stdout"
  notify: Ensure SSH key directory exists

- name: Generate the user's public SSH key
  command: ssh-keygen -y -f "{{ ssh_key_dir }}/{{ user_name }}_id_rsa" > "{{ ssh_key_dir }}/{{ user_name }}_id_rsa.pub"
  when: generate_ssh_key is defined and generate_ssh_key == "true"
  changed_when: "'WARNING: failed to' not in ssh_key_gen_result.stdout"
  notify: Ensure SSH key directory exists

- name: Convert the user's SSH key to PPK format
  command: ssh-keygen -p -f "{{ ssh_key_dir }}/{{ user_name }}_id_rsa" -m pkcs8 -N ""
  when: generate_ssh_key is defined and generate_ssh_key == "true"
  changed_when: "'WARNING: failed to' not in ssh_key_gen_result.stdout"
  notify: Ensure SSH key directory exists

- name: Get or set the user's home directory
  command: getent passwd "{{ user_name }}"
  register: getent_result
  changed_when: "'no user' in getent_result.stdout"
  when: user_home_directory is not defined
  notify: Set base home directory

- name: Create the user's .ssh directory
  file:
    path: "{{ user_home_directory }}/.ssh"
    state: directory
    mode: 0700
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Deploy authorized keys for the user
  authorized_key:
    user: "{{ user_name }}"
    key: "{{ authorized_key }}"
    state: present
  when: authorized_key is defined
  notify: Set authorized keys permissions

- name: Remove unauthorized keys for the user
  authorized_key:
    user: "{{ user_name }}"
    key: "{{ unauthorized_key }}"
    state: absent
  when: unauthorized_key is defined

- name: Copy the generated private SSH key for the user
  copy:
    src: "{{ ssh_key_dir }}/{{ user_name }}_id_rsa"
    dest: "{{ user_home_directory }}/.ssh/id_rsa"
    mode: 0400
  when: copy_private_key is defined and copy_private_key == "true"
  notify: Set private key permissions

- name: Check the user's password validity
  command: chage -l {{ user_name }}
  register: users_pw_valid

- name: Set the user's password validity
  command: chage -m {{ min_days }} -M {{ max_days }} -W {{ warn_days }} {{ user_name }}
  when: users_pw_valid is defined and users_pw_valid.stdout.find("Password must be changed") != -1

- name: Place the private key file for the user
  copy:
    src: "{{ ssh_key_dir }}/{{ user_name }}_id_rsa"
    dest: "{{ user_home_directory }}/.ssh/id_rsa"
    mode: 0400
  when: private_key is defined
  notify: Set private key permissions

