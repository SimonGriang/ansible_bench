---
- import_playbook: assert.yml
- name: Import Java Asserts and Setup Local Task Execution
  local_action: shell echo "Setting up local environment"

- name: Install Bash
  apt:
    name: bash
    state: present
  when: ansible_os_family == "Debian"

- name: Install OpenJDK Java (Package)
  apt:
    name: openjdk-8-jdk
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM (Local Java Source)
  block:
    - name: Copy Oracle Java RPM to /tmp
      copy:
        src: "{{ java_source_path }}"
        dest: /tmp/oracle-java.rpm
    - name: Install Oracle Java RPM
      package:
        name: /tmp/oracle-java.rpm
        state: present
  when: java_source == "local" and java_format == "rpm"

- name: Install DEB (Local Java Source)
  block:
    - name: Copy Oracle Java DEB to /tmp
      copy:
        src: "{{ java_source_path }}"
        dest: /tmp/oracle-java.deb
    - name: Install Oracle Java DEB
      apt:
        deb: /tmp/oracle-java.deb
        state: present
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java (RPM) (Repository)
  yum:
    name: "{{ oracle_java_rpm_repo }}"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Targz
  block:
    - name: Ensure Java Install Directory Exists
      file:
        path: "{{ java_install_directory }}"
        state: directory
        mode: '0755'
    - name: Install Oracle Java Targz Package
      shell: |
        tar -xzf "{{ java_source_path }}" -C "{{ java_install_directory }}"
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java Policy Software (Targz)
  block:
    - name: Ensure Java Install Directory Exists
      file:
        path: "{{ java_install_directory }}"
        state: directory
        mode: '0755'
    - name: Install Oracle Java Policy Software Targz Package
      shell: |
        tar -xzf "{{ java_jce_path }}" -C "{{ java_install_directory }}"
  when: java_jce == true and java_version == 8 and java_vendor == "oracle"

- name: Set Alternative (Targz)
  command: update-alternatives --install /usr/bin/java java "{{ java_install_directory }}/bin/java" 1
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  shell: readlink -f /usr/bin/java
  register: java_home_result
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: 'JAVA_HOME={{ java_home_result.stdout }}'
  when: java_home_result.stdout is defined

