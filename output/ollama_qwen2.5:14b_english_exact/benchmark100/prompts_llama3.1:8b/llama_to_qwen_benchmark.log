---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install fail2ban package
  apt:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Copy fail2ban filters
  copy:
    src: "{{ item }}"
    dest: "/etc/fail2ban/filter.d/{{ item.split('/')[-1] }}"
    owner: root
    group: root
    mode: '0640'
  loop: "{{ fail2ban_filterd_path }}"
  when: fail2ban_filterd_path is defined
  notify: restart_fail2ban

- name: Configure fail2ban.local
  lineinfile:
    path: /etc/fail2ban/fail2ban.local
    line: "{{ item.option }} = {{ item.value }}"
    create: yes
  with_items: "{{ fail2ban_base_configuration + fail2ban_configuration }}"
  owner: root
  mode: '0640'
  notify: restart_fail2ban

- name: Configure jail.local
  lineinfile:
    path: /etc/fail2ban/jail.local
    line: "{{ item.option }} = {{ item.value }}"
    create: yes
  with_items: "{{ fail2ban_base_jail_configuration + fail2ban_jail_configuration }}"
  owner: root
  mode: '0640'
  notify: restart_fail2ban

- name: Check the existence of the auth log file
  stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Create the auth log file if it does not exist
  file:
    path: /var/log/auth.log
    state: touch
    owner: root
    group: root
    mode: '0640'
  when: fail2ban_auth.exists is defined and fail2ban_auth.exists is false

- name: Start and enable the fail2ban service
  systemd:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: yes

