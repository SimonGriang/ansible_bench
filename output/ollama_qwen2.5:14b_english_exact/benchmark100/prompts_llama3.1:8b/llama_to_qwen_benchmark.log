---
- name: Assert that systemd is being used as the init system
  fail:
    msg: "System is not running systemd. This playbook is designed to run only on systems with systemd as the init system."
  when: ansible_systemd is undefined

- name: Get the latest release of the Grafana Loki project from the GitHub API
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
    method: GET
  register: _latest_release
  retries: 5
  timeout: 10
  status_code: 200

- name: Set the promtail version to the latest release tag (excluding the 'v' prefix) if it's set to 'latest'
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
  when: promtail_version == 'latest'

- name: Test if the zip local archive exists in the specified directory
  stat:
    path: "{{ promtail_local_dir }}/{{ promtail_version }}-promtail-linux-{{ promtail_arch }}.zip"
  register: promtail_local_zip

- name: Assert that the local binary exists in the specified directory
  fail:
    msg: >
      The local promtail binary archive does not exist at {{ promtail_local_dir }}/
      {{ promtail_version }}-promtail-linux-{{ promtail_arch }}.zip
  when: not promtail_local_zip.stat.exists

- name: Get the checksum list for the latest release
  uri:
    url: "https://github.com/grafana/loki/releases/download/{{ _latest_release.json.tag_name }}/promtail-linux-{{ promtail_arch }}.zip.sha256"
    return_content: yes
    method: GET
  register: __promtail_checksums
  status_code: 200

- name: Get the checksum for the specified architecture
  set_fact:
    __promtail_checksum: "{{ (__promtail_checksums.content.splitlines()|select('match', 'promtail-linux-' ~ promtail_arch ~ '\\.zip$'))|list|first }}"
  when: promtail_local_zip.stat.isdir == true


