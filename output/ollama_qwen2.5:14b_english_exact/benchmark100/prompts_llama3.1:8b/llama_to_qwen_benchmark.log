---
- name: Import and run assert.yml file on the localhost
  hosts: localhost
  tasks:
    - import_tasks: assert.yml

- name: Install required packages
  hosts: all
  tasks:
    - name: Ensure required packages are installed
      package:
        name: "{{ selinux_requirements }}"
        state: present
      notify: Gather facts

- name: Flush handlers
  hosts: all
  tasks:
    - meta: flush_handlers

- name: Configure selinux
  hosts: all
  tasks:
    - name: Manage selinux
      when: selinux_status is defined and (ansible_connection != 'container' and ansible_connection != 'docker' and ansible_connection != 'community.docker.docker')
      block:
        - name: Manage selinux settings
          selinux:
            policy: "{{ selinux_policy }}"
            state: "{{ selinux_state }}"
          notify: Reboot

        - name: Manage selinux booleans
          when: selinux_booleans is defined
          block:
            - name: Configure selinux booleans
              selboolean:
                name: "{{ item.name }}"
                state: "{{ item.state }}"
                persistent: "{{ item.persistent }}"
              loop: "{{ selinux_booleans }}"

  handlers:
    - name: Gather facts
      ansible.builtin.meta: refresh_connections

    - name: Reboot
      ansible.builtin.reboot:
        reboot_timeout: 300


