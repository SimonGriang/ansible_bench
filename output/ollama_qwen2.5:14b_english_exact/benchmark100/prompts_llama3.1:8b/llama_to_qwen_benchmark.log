---
- name: Enable specific Apache2 modules
  when: ansible_os_family in ['Debian', 'Suse']
  replace:
    path: /etc/apache2/mods-available/{{ item }}
    regexp: '^#\\s*LoadModule'
    replace: 'LoadModule'
    backup: yes
  with_items:
    - proxy.load
    - proxy_http.load

- name: Configure Apache2 locations
  template:
    src: location.conf.j2
    dest: /etc/apache2/sites-available/{{ item }}
    mode: 0644
  with_items: "{{ httpd_locations }}"
  notify: Test httpd configuration validity

- name: Configure Apache2 locations
  file:
    state: link
    src: /etc/apache2/sites-available/{{ item }}
    dest: /etc/apache2/sites-enabled/{{ item }}
  with_items: "{{ httpd_locations }}"
  notify: Restart httpd

