- import_tasks: assert.yml
  remote_src: yes
  when: inventory_hostname == 'localhost'

- name: Install required packages for cron service
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell environment for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    create: yes
    regexp: "^SHELL="
    state: present

