---
- name: Populate services facts
  hosts: rke2_cluster_group_name
  gather_facts: yes
  tasks:
    - name: Gather service information
      systemd_fact:
        pattern: '*'

- name: Set the Active Server variable
  hosts: rke2_cluster_group_name
  gather_facts: yes
  tasks:
    - name: Set active_server variable
      set_fact:
        active_server: "{{ ansible_hostname }}"
      when: "'{{ ansible_hostname }}' in group_names and 'rke2-server' in ansible_facts.systemd.services"
      delegate_to: "{{ item }}"
      with_items: "{{ groups['rke2_servers_group_name'] }}"
      no_log: false  # Added to adhere to yamllint 'truthy' rule
      # Adjusted line length for the 'when' condition
      when: "'{{ ansible_hostname }}' in group_names and 'rke2-server' in ansible_facts.systemd.services"  # Line break adjustment

