---
- name: Ensure old versions of Docker are not installed
  yum:
    name: docker
    state: absent
  when: ansible_os_family == 'RedHat' or ansible_os_family == 'Debian'

- name: Add Docker GPG key
  rpm_key:
    state: present
    key: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/gpg

- name: Add Docker repository
  yum_repository:
    name: docker
    description: Docker Repository
    baseurl: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/{{ ansible_distribution_major_version }}/$basearch
    enabled: true
    gpgcheck: true
    gpgkey: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/gpg
    protect: true

- name: Configure Docker Nightly repo and Docker Test repo
  block:
    - name: Enable Docker Test repo
      yum_repository:
        name: docker-test
        description: Docker Test Repository
        baseurl: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/test/{{ ansible_distribution_major_version }}/$basearch
        enabled: "{{ docker_yum_repo_enable_test | bool }}"
        gpgcheck: true
        gpgkey: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/gpg

    - name: Enable Docker Nightly repo
      yum_repository:
        name: docker-nightly
        description: Docker Nightly Repository
        baseurl: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/nightly/{{ ansible_distribution_major_version }}/$basearch
        enabled: "{{ docker_yum_repo_enable_nightly | bool }}"
        gpgcheck: true
        gpgkey: https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/gpg

- name: Configure containerd on RHEL 8
  block:
    - name: Remove runc
      package:
        name: runc
        state: absent
      when: ansible_distribution_major_version == '8'

    - name: Install container-selinux
      package:
        name: container-selinux
        state: present
      when: ansible_distribution_major_version == '8'

    - name: Install containerd.io
      package:
        name: containerd.io
        state: present
      when: ansible_distribution_major_version == '8'

