---
- import_tasks: assert.yml

- name: Configure package management for package manager apk
  when: ansible_pkg_mgr == 'apk'
  become: true
  block:
    - name: Update cache and upgrade all
      apk:
        update_cache: yes
        upgrade: all

- name: Configure package management for package manager apt
  when: ansible_pkg_mgr == 'apt'
  become: true
  block:
    - name: Prevent certain packages from being upgraded
      apt:
        name: "{{ item }}"
        state: installed
        upgrade: forced
      loop:
        - linux-image-amd64
        - nfs-kernel-server
      when: "'{{ item }}' in apt_preferences"
    - name: Update all software
      apt:
        upgrade: dist
    - name: Autoremove unnecessary packages
      apt:
        autoremove: yes

- name: Update all software for package manager dnf
  when: ansible_pkg_mgr == 'dnf'
  become: true
  block:
    - name: Update all packages to the latest version
      dnf:
        name: "@System"
        state: latest
        exclude: "{{ item }}"
      loop:
        - kernel-devel
        - kernel-headers

- name: Update all software for package manager pacman
  when: ansible_pkg_mgr == 'pacman'
  become: true
  block:
    - name: Update the package cache
      pacman:
        sync: refresh
    - name: Upgrade all packages
      pacman:
        sync: sysupgrade

- name: Configure package management for package manager yum
  when: ansible_pkg_mgr == 'yum'
  become: true
  block:
    - name: Update all software using dnf for specific yum versions
      dnf:
        name: "@System"
        state: latest
      when: ansible_distribution_major_version | int >= 6
    - name: Ensure yum-utils is installed for non-6 yum versions
      yum:
        name: yum-utils
        state: present
      when: ansible_distribution_major_version | int < 6

- name: Update all software for package manager zypper
  when: ansible_pkg_mgr == 'zypper'
  become: true
  block:
    - name: Update all packages to the latest version
      zypper:
        name: "@System"
        state: latest

