---
- import_tasks: assert.yml

- name: Install required packages for cron service
  yum:
    name: "{{ cron_packages }}"
    state: present
  when: cron_packages is defined and cron_packages | length > 0

- name: Configure shell environment for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    create: yes
  when: cron_shell is defined

- name: Configure system path for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    create: yes
  when: cron_path is defined

- name: Configure mailto parameter for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    create: yes
  when: cron_mailto is defined

- name: Start and enable the cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ''

- name: Schedule the requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special: "{{ item.special }}"
    state: "{{ item.state }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined and cron_jobs | length > 0


