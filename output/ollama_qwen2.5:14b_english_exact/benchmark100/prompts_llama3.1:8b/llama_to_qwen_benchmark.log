---
- import_tasks: assert.yml

- name: Install the MySQL package
  package:
    name: "{{ mysql_package }}"
    state: present
  notify:
    - set_mysql_root_password
    - systemctl_daemon_reload

- name: Configure the MySQL server
  ini_file:
    dest: "{{ mysql_config_dest }}/server.cnf"
    section: mysqld
    option: "{{ item.option }}"
    value: "{{ item.value }}"
  loop: "{{ mysql_configuration_options }}"
  notify: restart_mysql_server

- name: Configure the MySQL client
  ini_file:
    dest: "{{ mysql_config_dest }}/client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
  notify: restart_mysql_server

- name: Initialize the MySQL database
  shell: "{{ mysql_initialize_command }}"
  when: mysql_initialize_command is defined

- name: Start and enable the MySQL service
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place the my.cnf file
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: '0600'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"
  no_log: yes

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"
  no_log: yes

- name: Flush handlers again
  meta: flush_handlers

