---
- name: Assert that systemd is being used as the init system
  shell: "systemctl --version &>/dev/null || (echo 'Systemd is not available.' >&2; false)"
  register: systemd_check
  changed_when: False
  failed_when: systemd_check.rc != 0

- name: Get the latest release of the Grafana Loki project from the GitHub API
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    return_content: yes
    status_code: 200
    method: GET
    retries: 5
    timeout: 5
  register: latest_release
  changed_when: False
  failed_when: latest_release.status_code != 200

- name: Set the promtail version to the latest release tag if it's set to 'latest'
  set_fact:
    promtail_version: "{{ latest_release.json.tag_name[1:] }}"
  when: promtail_version == 'latest'

- name: Test if the zip local archive exists in the specified directory
  stat:
    path: "{{ promtail_local_dir }}/{{ promtail_version }}-promtail-linux-{{ promtail_arch }}.zip"
  register: promtail_local_zip
  changed_when: False

- name: Assert that the local binary exists in the specified directory
  assert:
    that:
      - promtail_local_zip.stat.exists == true
  when:
    - promtail_local_dir is not None
    - promtail_local_dir != ''
    - promtail_local_zip.stat.exists == false

- name: Get the checksum list for the latest release
  uri:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail-linux-{{ promtail_arch }}.zip.sha256"
    return_content: yes
    status_code: 200
    method: GET
  register: promtail_checksums
  changed_when: False
  failed_when: promtail_checksums.status_code != 200

- name: Get the checksum for the specified architecture
  set_fact:
    __promtail_checksum: "{{ promtail_checksums.content.splitlines()[0] }}"
  when:
    - promtail_local_dir is None or promtail_local_dir == ''

