---
- import_tasks: assert.yml
  loop_control:
    extended: true
  run_once: true
  local_action: true

- name: Install repository for RedHat task
  ansible.builtin.get_url:
    url: https://rpm.releases.hashicorp.com/{{ ansible_distribution_major_version }}-{{ ansible_os_family | lower }}/hashicorp-archive-keyring.rpm
    dest: /tmp/hashicorp-archive-keyring.rpm
  when: ansible_os_family == 'RedHat'

- name: Configure Debian task
  block:
    - name: Install required package gpg task
      ansible.builtin.package:
        name: gpg
        state: present
      when: ansible_os_family == 'Debian'

    - name: Install apt key for Debian task
      ansible.builtin.get_url:
        url: https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x4A5C084D78B5C03F
        dest: /usr/share/keyrings/hashicorp-archive-keyring.gpg
      when: ansible_os_family == 'Debian'

    - name: Install repository for Debian task
      ansible.builtin.get_url:
        url: https://apt.releases.hashicorp.com/gpg
        dest: /usr/share/keyrings/hashicorp-archive-keyring.gpg
      when: ansible_os_family == 'Debian'

- name: Install hashicorp product using package task
  block:
    - name: Install latest hashicorp product using package task
      ansible.builtin.package:
        name: "{{ hashicorp_product }}"
        state: latest
      when: hashicorp_version == 'latest'

    - name: Install versioned hashicorp product using package task
      ansible.builtin.package:
        name: "{{ hashicorp_product }}={{ hashicorp_version }}"
        state: present
      when: hashicorp_version != 'latest'

- name: Install manually task
  block:
    - name: Download hashicorp product
      ansible.builtin.get_url:
        url: "https://releases.hashicorp.com/{{ hashicorp_product }}/{{ hashicorp_version }}/{{ hashicorp_product }}_{{ hashicorp_version }}_linux_{{ ansible_architecture }}.zip"
        dest: "/tmp/{{ hashicorp_product }}.zip"
        mode: '0755'

    - name: Unpack hashicorp product
      ansible.builtin.unarchive:
        src: "/tmp/{{ hashicorp_product }}.zip"
        dest: "/usr/local/bin/"
        remote_src: yes
        mode: '0755'

