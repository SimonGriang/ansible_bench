': 93990716, 'prompt_eval_count': 704, 'prompt_eval_duration': 317007399, 'eval_count': 443, 'eval_duration': 9698804576, 'model_name': 'qwen2.5:14b'} id='run--673315d6-3b57-4fa6-af67-53b5da65ad68-0' usage_metadata={'input_tokens': 704, 'output_tokens': 443, 'total_tokens': 1147}
