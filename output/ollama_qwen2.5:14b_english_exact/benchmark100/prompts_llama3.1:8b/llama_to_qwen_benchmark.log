---
- name: Ensure /etc/openvpn/easy-rsa exists and set permissions
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Initialize the EasyRSA PKI directory
  command: "{{ easy_rsa_path }}/easyrsa init-pki"
  args:
    creates: /etc/openvpn/easy-rsa/pki

- name: Build the CA certificate using EasyRSA
  command: "{{ easy_rsa_path }}/easyrsa build-ca nopass"
  args:
    creates: /etc/openvpn/easy-rsa/pki/ca.crt

- name: Generate the Diffie-Hellman (DH) parameters using EasyRSA
  command: "{{ easy_rsa_path }}/easyrsa gen-dh"
  args:
    creates: /etc/openvpn/easy-rsa/pki/dh.pem

- name: Build the server certificate using EasyRSA
  command: "{{ easy_rsa_path }}/easyrsa build-server-full server nopass"
  args:
    creates: /etc/openvpn/easy-rsa/pki/issued/server.crt

- name: Build the client certificate using EasyRSA
  command: "{{ easy_rsa_path }}/easyrsa build-client-full client nopass"
  args:
    creates: /etc/openvpn/easy-rsa/pki/issued/client.crt

- name: Generate the Certificate Revocation List (CRL) using EasyRSA
  command: "{{ easy_rsa_path }}/easyrsa gen-crl"
  args:
    creates: /etc/openvpn/easy-rsa/pki/crl.pem

- name: Generate the Diffie-Hellman (DH) key using OpenVPN
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to the /etc/openvpn/server directory
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    owner: root
    group: root
    mode: "{{ item.mode }}"
  loop:
    - { src: "/etc/openvpn/easy-rsa/pki/ca.crt", dest: "/etc/openvpn/server/ca.crt", mode: "0644" }
    - { src: "/etc/openvpn/easy-rsa/pki/dh.pem", dest: "/etc/openvpn/server/dh.pem", mode: "0644" }
    - { src: "/etc/openvpn/easy-rsa/pki/ta.key", dest: "/etc/openvpn/server/ta.key", mode: "0600" }
    - { src: "/etc/openvpn/easy-rsa/pki/issued/server.crt", dest: "/etc/openvpn/server/server.crt", mode: "0644" }
    - { src: "/etc/openvpn/easy-rsa/pki/private/server.key", dest: "/etc/openvpn/server/server.key", mode: "0600" }
    - { src: "/etc/openvpn/easy-rsa/pki/issued/client.crt", dest: "/etc/openvpn/server/client.crt", mode: "0644" }
    - { src: "/etc/openvpn/easy-rsa/pki/private/client.key", dest: "/etc/openvpn/server/client.key", mode: "0600" }

- name: Copy files to the /etc/openvpn directory
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    owner: root
    group: root
    mode: "{{ item.mode }}"
  loop:
    - { src: "/etc/openvpn/easy-rsa/pki/ca.crt", dest: "/etc/openvpn/ca.crt", mode: "0644" }
    - { src: "/etc/openvpn/easy-rsa/pki/ta.key", dest: "/etc/openvpn/ta.key", mode: "0600" }

- name: Place the server.conf file
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    owner: root
    group: root
    mode: '0644'

