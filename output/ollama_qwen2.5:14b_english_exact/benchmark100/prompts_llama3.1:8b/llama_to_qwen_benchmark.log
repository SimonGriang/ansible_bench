---
- name: Create an SSL private key
  openssl_privatekey:
    path: /etc/ssl/private/private.key
    mode: '0600'
    owner: root
    group: root

- name: Create an SSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/private/csr.csr
    privatekey_path: /etc/ssl/private/private.key
    mode: '0600'
    owner: root
    group: root
    common_name: example.com

- name: Create an SSL certificate
  x509_certificate:
    path: /etc/ssl/private/certificate.crt
    privatekey_path: /etc/ssl/private/private.key
    csr_path: /etc/ssl/private/csr.csr
    mode: '0600'
    owner: root
    group: root

- name: Create a PKCS#12 file
  openssl_pkcs12:
    path: /etc/ssl/private/pkcs12.p12
    export: true
    privatekey_path: /etc/ssl/private/private.key
    certificate_path: /etc/ssl/private/certificate.crt
    mode: '0600'
    owner: root
    group: root

- name: Read the private key
  slurp:
    src: /etc/ssl/private/private.key
  register: private_key_content

- name: Read the certificate
  slurp:
    src: /etc/ssl/private/certificate.crt
  register: certificate_content

- name: Create a combined private key and certificate file
  copy:
    content: "{{ private_key_content.content + certificate_content.content | b64decode }}"
    dest: /etc/ssl/private/combined.pem
    mode: '0600'
    owner: root
    group: root

