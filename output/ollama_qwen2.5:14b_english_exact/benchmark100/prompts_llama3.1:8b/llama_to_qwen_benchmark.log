---
- name: Install epel package repositories for compatible operating systems
  when: ansible_os_family == "RedHat" or ansible_os_family == "Amazon"
  ansible.builtin.yum:
    name: "@epel"
    state: present

- name: Install the epel GPG key
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install the epel-release package
  ansible.builtin.yum:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Install the epel-next-release package (conditional)
  when: epel_next
  ansible.builtin.yum:
    name: epel-next-release
    state: present
  notify: Update package cache

