---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "vars/{{ ansible_distribution }}-{{ ansible_distribution_major_version }}-{{ java_jdk_vendor }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: "architecture.yml"

- name: Set OS-specific variables (I)
  set_fact:
    java_version: "{{ java_version | default('8') }}"
    java_major_version: "{{ java_major_version | default(java_version) }}"
    java_bin_dir: "{{ java_bin_dir | default('/usr/lib/jvm/{{ java_open_jdk_home_dir }}') }}"
    java_home: "{{ java_home | default(java_bin_dir) }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-' ~ java_major_version ~ '-jdk') }}"
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('java-' ~ java_major_version ~ '-openjdk') }}"
  when:
    - java_version is not defined
    - java_major_version is not defined
    - java_bin_dir is not defined
    - java_home is not defined
    - java_open_jdk_package is not defined
    - java_open_jdk_home_dir is not defined

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('java-' ~ java_major_version ~ '-openjdk') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-' ~ java_major_version ~ '-jdk') }}"
  when:
    - java_open_jdk_home_dir is not defined
    - java_open_jdk_package is not defined

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home_dir }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      shell: |
        sed -i '/deb http:\/\/deb.debian.org\/debian jessie-backports main/d' /etc/apt/sources.list
        sed -i '/deb http:\/\/deb.debian.org\/debian stretch-backports main/d' /etc/apt/sources.list
      when: ansible_distribution == "Debian"

    - name: Install extra apt tools
      apt:
        name: ['apt-transport-https', 'software-properties-common', 'curl']

    - name: Add required key repositories
      apt_key:
        url: "{{ item }}"
      loop: "{{ debian_java_repositories_keys | default([]) }}"

    - name: Add required repositories
      apt_repository:
        repo: "{{ item }}"
      loop: "{{ debian_java_repositories | default([]) }}"

- name: RedHat pre-requisites
  block:
    - name: Add required key repositories
      rpm_key:
        key: "{{ item }}"
      loop: "{{ redhat_java_repositories_keys | default([]) }}"

    - name: Add required repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        enabled: "{{ item.enabled | bool }}"
        gpgcheck: "{{ item.gpgcheck | bool }}"
        gpgkey: "{{ item.gpgkey }}"
      loop: "{{ redhat_java_repositories | default([]) }}"

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_libs | default([]) }}"

- name: Install Java, Debian
  block:
    - name: Install Java
      apt:
        name: "{{ java_open_jdk_package }}"
        state: present

- name: Install Java, RedHat
  block:
    - name: Install Java
      yum:
        name: "{{ java_open_jdk_package }}"
        state: present

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0755'

- name: Source environment variables
  shell: |
    . /etc/profile

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  file:
    src: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
    dest: /usr/bin/java
    state: link
  when: java_major_version | int < 11

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  file:
    src: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java
    dest: /usr/bin/java
    state: link
  when: java_major_version | int >= 11

