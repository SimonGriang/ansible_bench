---
- name: Import assert.yml file for task execution
  import_tasks: assert.yml
  failed_when: false
  when: ansible_posix.is_installed('assert')
  register: assert_result
  when: assert_result is not defined or not assert_result|failed

- name: Pre-configure Debian systems for postfix installation
  debconf:
    name: postfix
    question: postfix/main/biff
    value: "false"
    vtype: boolean
  when: ansible_os_family == "Debian"

- name: Install postfix package
  package:
    name: postfix
    state: present

- name: Install postfix-mysql package if specific conditions are met
  package:
    name: postfix-mysql
    state: present
  when: "'mysql' in postfix_virtual_mailbox_maps or 'mysql' in postfix_virtual_mailbox_domains or 'mysql' in postfix_virtual_alias_maps"

- name: Configure postfix transport maps
  copy:
    src: transport
    dest: /etc/postfix/transport
    owner: root
    group: root
    mode: 0644
  notify: validate_transport_maps
  notify: rebuild_transport_maps_database

- name: Configure postfix header checks
  copy:
    src: header_checks
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: 0644
  notify: validate_header_checks
  notify: reload_postfix

- name: Set values for the main.cf file
  set_fact:
    postfix_main_cf_values: "{{ postfix_recipient_access is defined and postfix_recipient_access is not none and postfix_recipient_access|list|length > 0 and 'recipient_access' or [] + postfix_sender_access is defined and postfix_sender_access is not none and postfix_sender_access|list|length > 0 and 'sender_access' or [] + postfix_mynetworks|list|length > 0 and 'mynetworks' or [] + postfix_mydestination|list|length > 0 and 'mydestination' or [] + postfix_relay_domains|list|length > 0 and 'relay_domains' or [] + postfix_smtpd_recipient_restrictions|list|length > 0 and 'smtpd_recipient_restrictions' or [] + postfix_smtpd_sender_restrictions|list|length > 0 and 'smtpd_sender_restrictions' or [] + postfix_virtual_mailbox_domains|list|length > 0 and 'virtual_mailbox_domains' or [] + postfix_virtual_alias_domains|list|length > 0 and 'virtual_alias_domains' or [] }}"

- name: Configure postfix main.cf
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    owner: root
    group: root
    mode: 0644
  notify: validate_main_cf
  notify: restart_postfix

- name: Configure postfix master.cf
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: 0644
  notify: validate_master_cf
  notify: restart_postfix

- name: Create directory for TLS certificates and keys
  file:
    path: /etc/postfix/tls
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_server_cert }}"
    dest: /etc/postfix/tls/smtpd.cert
    owner: root
    group: root
    mode: 0644
  notify: reload_postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_server_key }}"
    dest: /etc/postfix/tls/smtpd.key
    owner: root
    group: root
    mode: 0644
  notify: reload_postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    src: "{{ postfix_aliases }}"
    dest: /etc/postfix/aliases
    owner: root
    group: root
    mode: 0644
  notify: build_alias_database
  notify: reload_postfix

- name: Configure sender_access
  copy:
    src: "{{ postfix_sender_access }}"
    dest: /etc/postfix/sender_access
    owner: root
    group: root
    mode: 0644
  notify: build_sender_access_database
  notify: reload_postfix

- name: Configure recipient_access
  copy:
    src: "{{ postfix_recipient_access }}"
    dest: /etc/postfix/recipient_access
    owner: root
    group: root
    mode: 0644
  notify: validate_recipient_access
  notify: build_recipient_access_database
  notify: reload_postfix

- name: Place sasl_password_map
  copy:
    src: "{{ postfix_smtp_sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password_map
    owner: root
    group: root
    mode: 0644
  notify: build_sasl_password_map_database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix service
  service:
    name: postfix
    state: started
    enabled: yes

