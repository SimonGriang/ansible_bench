---
- name: Cordon and Drain the node with the specified RKE2 node name
  shell: "{{ rke2_data_path }}/bin/kubectl cordon {{ rke2_node_name }}"
  register: cordon_result
  retries: 100
  delay: 15
  until: cordon_result.stdout.find("scheduling disabled") != -1

- name: Cordon and Drain the node with the specified RKE2 node name (drain)
  shell: "{{ rke2_data_path }}/bin/kubectl drain {{ rke2_node_name }} {{ rke2_drain_additional_args }}"
  register: drain_result
  retries: 100
  delay: 15
  until: drain_result.stdout.find("success") != -1

- name: Restart the RKE2 service on the specified node
  service:
    name: "{{ rke2_service_name }}"
    state: restarted

- name: Wait for all nodes to be ready again
  shell: "{{ rke2_data_path }}/bin/kubectl get nodes --no-headers -o=jsonpath='{range .items[?(@.status.conditions[?(@.type=="Ready")].status=="True")]}{.metadata.name}{"\n"}{end}' | grep -qxF '{{ rke2_node_name }}'"
  register: node_ready_result
  retries: 100
  delay: 15
  until: node_ready_result.stdout.find("{{ rke2_node_name }}") != -1

- name: Uncordon the specified RKE2 node
  shell: "{{ rke2_data_path }}/bin/kubectl uncordon {{ rke2_node_name }}"

- name: Wait for all pods to be ready again
  shell: "{{ rke2_data_path }}/bin/kubectl get pods --no-headers -o=jsonpath='{range .items[?(@.status.conditions[?(@.type=="Ready")].status=="True")]}{.metadata.name}{"\n"}{end}' | grep -qxF '{{ item }}'"
  loop: "{{ query('ansible_all_hosts', rke2_cluster_group_name) }}"
  register: pod_ready_result
  retries: 100
  delay: 15
  until: pod_ready_result.stdout.find("{{ item }}") != -1

- name: Wait for all pods to pass readiness checks
  shell: "{{ rke2_data_path }}/bin/kubectl wait --for=condition=Ready --timeout=60s pods --all-namespaces {{ rke2_wait_for_all_pods_to_be_healthy_args }}"
  register: pod_health_result
  retries: 100
  delay: 15
  until: pod_health_result.stdout.find("condition met") != -1

