---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0755'
    owner: root
    group: root

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_local_path }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0755'
    owner: root
    group: root
  when: airgap_mode and implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0755'
    owner: root
    group: root
  when: airgap_mode and implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ rke2_artifacts_url }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: '0755'
    owner: root
    group: root
  when: airgap_mode and implementation == 'download'
  register: rke2_artifacts_download
  until: rke2_artifacts_download.changed
  retries: 3
  delay: 10
  rescue:
    - name: Copy RKE2 artifacts from local path
      copy:
        src: "{{ rke2_artifacts_local_path }}"
        dest: "{{ rke2_artifacts_path }}"
        mode: '0755'
        owner: root
        group: root
      when: airgap_mode and implementation == 'download' and rke2_artifacts_download is failed

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_additional_images_path }}"
    mode: '0755'
    owner: root
    group: root
  loop: "{{ rke2_additional_images }}"
  when: airgap_mode and implementation != 'exists' and rke2_additional_images|length > 0

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ item }}"
    state: file
    mode: '0755'
    owner: root
    group: root
  loop: "{{ rke2_artifacts }}"
  when: airgap_mode and implementation == 'exists'

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: "{{ fs_object_path }}"
  register: fs_object_stats

- name: Check if separate partition
  shell: test -z "$(grep -w "{{ partition }}" /etc/fstab)"
  register: partition_is_separate
  changed_when: false
  failed_when: false

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_path if is_partition_separate else '/usr/local/bin' }}"
  when: not is_partition_writable

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 version"
  register: rke2_version_output

- name: Set RKE2 versions
  set_fact:
    rke2_version: "{{ rke2_version_output.stdout_lines[0] }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_version >= desired_version

- name: Run RKE2 install script
  command: "{{ rke2_bin_path }}/rke2 install --channel={{ rke2_channel }} --install-rke2-default-plugins"
  when: desired_version != installed_version

- name: Copy Custom Manifests
  copy:
    src: "{{ custom_manifests_src }}"
    dest: "{{ custom_manifests_dest }}"
    mode: '0755'
    owner: root
    group: root
  when: custom_manifests is defined

- name: Copy Static Pods
  copy:
    src: "{{ static_pods_src }}"
    dest: "{{ static_pods_dest }}"
    mode: '0755'
    owner: root
    group: root
  when: static_pods is defined

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file_src }}"
    dest: "{{ rke2_env_file_dest }}"
    mode: '0755'
    owner: root
    group: root
  when: rke2_env_file is defined


