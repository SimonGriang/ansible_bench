- name: Migrate adoptopenjdk to temurin (if selected)
  ansible.builtin.set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  ansible.builtin.include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"

- name: Gather architecture specific variables
  ansible.builtin.include_vars:
    file: "architecture.yml"

- name: Set OS-specific variables (I)
  ansible.builtin.set_fact:
    java_homebrew_repo: "{{ homebrew_repo | default('homebrew/core') }}"
    java_apt_repo: "{{ apt_repo | default('deb.debian.org/debian') }}"
    java_yum_repo: "{{ yum_repo | default('baseos') }}"
    java_apt_key: "{{ apt_key | default('') }}"
    java_yum_key: "{{ yum_key | default('') }}"
    java_yum_gpgkey: "{{ yum_gpgkey | default('') }}"
    java_apt_key_url: "{{ apt_key_url | default('') }}"
    java_yum_key_url: "{{ yum_key_url | default('') }}"
    java_yum_gpgkey_url: "{{ yum_gpgkey_url | default('') }}"

- name: Set OS and architecture specific variables (II)
  ansible.builtin.set_fact:
    java_open_jdk_home_dir: "{{ open_jdk_home_dir | default('openjdk') }}"
    java_open_jdk_package: "{{ open_jdk_package | default('') }}"

- name: Set specific variables
  ansible.builtin.set_fact:
    java_home: "{{ java_open_jdk_home_dir }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      ansible.builtin.apt:
        state: absent
        purge: yes
        repository: "{{ item }}"
      loop: "{{ deprecated_repositories | default([]) }}"
      when: ansible_facts['os_family'] == 'Debian'

    - name: Install extra apt tools
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
      loop: "{{ apt_extra_tools | default([]) }}"
      when: ansible_facts['os_family'] == 'Debian'

    - name: Add required key repositories
      ansible.builtin.apt_key:
        key: "{{ item.key_url }}"
        state: present
      loop: "{{ apt_key_repositories | default([]) }}"
      when: ansible_facts['os_family'] == 'Debian'

    - name: Add required repositories
      ansible.builtin.apt_repository:
        repo: "{{ item.repo }}"
        state: present
        update_cache: yes
      loop: "{{ apt_repositories | default([]) }}"
      when: ansible_facts['os_family'] == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add required key repositories
      ansible.builtin.rpm_key:
        key: "{{ item.key_url }}"
        state: present
      loop: "{{ yum_key_repositories | default([]) }}"
      when: ansible_facts['os_family'] == 'RedHat'

    - name: Add required repositories
      ansible.builtin.yum_repository:
        name: "{{ item.name }}"
        baseurl: "{{ item.baseurl }}"
        enabled: "{{ item.enabled }}"
        gpgcheck: "{{ item.gpgcheck }}"
        state: present
      loop: "{{ yum_repositories | default([]) }}"
      when: ansible_facts['os_family'] == 'RedHat'

- name: Install required libs
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ libs | default([]) }}"

- name: Install Java, Debian
  ansible.builtin.apt:
    name: "{{ java_open_jdk_package }}"
    state: present
  when: ansible_facts['os_family'] == 'Debian'

- name: Install Java, RedHat
  ansible.builtin.yum:
    name: "{{ java_open_jdk_package }}"
    state: present
  when: ansible_facts['os_family'] == 'RedHat'

- name: Export environment variables
