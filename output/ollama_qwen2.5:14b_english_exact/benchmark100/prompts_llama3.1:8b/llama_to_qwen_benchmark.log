---
- name: Install required SSL packages
  ansible.builtin.package:
    name: "{{ httpd_ssl_packages }}"
    state: present

- name: Place SSL configuration file
  ansible.builtin.copy:
    src: ssl.conf.j2
    dest: "{{ httpd_config_directory }}/ssl.conf"
    owner: root
    group: root
    mode: '0644'
  notify: test apache configuration

- name: Configure HTTP to HTTPS redirect
  ansible.builtin.copy:
    src: default_vhost.conf.j2
    dest: "{{ httpd_config_directory }}/000-default.conf"
    owner: root
    group: root
    mode: '0644'
  notify: test apache configuration

