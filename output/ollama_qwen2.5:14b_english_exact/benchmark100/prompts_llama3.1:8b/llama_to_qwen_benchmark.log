  mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  mysql_user:
    name: "{{ item.username }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  with_items: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  meta: flush_handlers


