---
- import_tasks: assert.yml
  remote_user: localhost

- name: Install the dns packages
  apt:
    name: bind9
    state: present
  become: yes

- name: Create the required directories
  file:
    path: /etc/bind
    state: directory
    mode: '0755'
  become: yes

- name: Create the required group
  group:
    name: bind
    system: yes
  become: yes

- name: Create the required user
  user:
    name: bind
    group: bind
    create_home: no
    system: yes
  become: yes

- name: Generate the rndc key
  command: rndc-confgen -a -r /dev/urandom -k rndc.key -c /etc/bind/rndc.key
  args:
    creates: /etc/bind/rndc.key
  become: yes

- name: Set permissions on the rndc key file
  file:
    path: /etc/bind/rndc.key
    mode: '0640'
    owner: root
    group: bind
  become: yes

- name: Download the named.root file
  get_url:
    url: http://www.internic.net/zones/named.root
    dest: /etc/bind/named.root
    mode: '0644'
  become: yes

- name: Create the zone file
  template:
    src: zone.j2
    dest: /etc/bind/db.local
    mode: '0644'
  become: yes

- name: Add zones to the configuration
  template:
    src: named.conf.j2
    dest: /etc/bind/named.conf.local
    mode: '0644'
  become: yes

- name: Place the systemd override
  copy:
    src: bind9.service
    dest: /etc/systemd/system/bind9.service.d/override.conf
    mode: '0644'
  become: yes
  notify: Reload systemd daemon

- name: Start and enable the DNS service
  service:
    name: bind9
    state: started
    enabled: yes
  become: yes

