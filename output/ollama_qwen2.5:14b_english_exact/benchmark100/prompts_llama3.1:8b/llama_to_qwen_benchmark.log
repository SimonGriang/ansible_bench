---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install required software
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ users_requirements }}"

- name: Loop over users_groups
  include_tasks:
    file: group.yml
    loop_control:
      loop_var: group
  with_items: "{{ users_groups }}"

