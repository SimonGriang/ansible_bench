---
- name: Restart RKE2 service on a node
  service:
    name: rke2
    state: restarted
    enabled: yes
    daemon_reload: yes
  notify: Service (re)started
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  shell: kubectl get nodes -o json | jq '[.items[] | select(.status.conditions[]?.type == "Ready" and .status.conditions[]?.status == "True") | .metadata.name] | length'
  register: all_ready_nodes
  until: all_ready_nodes.stdout|int == (kubectl_get_nodes_ready.stdout|int)
  retries: 100
  delay: 15
  delegate_to: "{{ inventory_hostname if inventory_hostname in groups['rke2_servers_group_name'] else groups['rke2_servers_group_name'][0] }}"
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  shell: kubectl get pods --all-namespaces -o json | jq '[.items[] | select(.status.phase != "Running" and .status.phase != "Succeeded") | .metadata.name] | length'
  register: all_pods_ready
  until: all_pods_ready.stdout|int == 0
  retries: 100
  delay: 15
  delegate_to: "{{ inventory_hostname if inventory_hostname in groups['rke2_servers_group_name'] else groups['rke2_servers_group_name'][0] }}"
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready == True

