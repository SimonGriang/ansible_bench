---
- name: Set the package state based on how Ansible is installed
  ansible.builtin.meta:
    clear_dependencies: true
  when: ansible_facts['distribution'] is not defined

- name: Set up Ansible on RedHat
  block:
    - name: Ensure EPEL is available
      ansible.builtin.yum:
        name: epel-release
        state: present
      when: ansible_facts['distribution']|upper in ['REDHAT', 'CENTOS', 'RHEL']

    - name: Install ansible package
      ansible.builtin.yum:
        name: ansible
        state: latest
      when: ansible_facts['distribution']|upper in ['REDHAT', 'CENTOS', 'RHEL']

- name: Set up Ansible on Fedora
  block:
    - name: Install ansible package
      ansible.builtin.yum:
        name: ansible
        state: latest
      when: ansible_facts['distribution']|upper == 'FEDORA'

- name: Set up Ansible on Ubuntu
  block:
    - name: Add Ansible's PPA
      ansible.builtin.apt_key:
        url: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_facts['osrelease_major'] }}
        state: present
      when: ansible_facts['distribution']|upper == 'UBUNTU'

    - name: Add Ansible's PPA repository
      ansible.builtin.apt_repository:
        repo: 'ppa:ansible/ansible'
        state: present
      when: ansible_facts['distribution']|upper == 'UBUNTU'

    - name: Install ansible package
      ansible.builtin.apt:
        name: ansible
        state: latest
      when: ansible_facts['distribution']|upper == 'UBUNTU'

- name: Set up Ansible on Debian
  block:
    - name: Add Ansible's repository
      ansible.builtin.apt_repository:
        repo: 'deb http://ppa.launchpad.net/ansible/ansible/ubuntu {{ ansible_facts['lsb']['codename'] }} main'
        state: present
      when: ansible_facts['distribution']|upper == 'DEBIAN'

    - name: Install ansible package
      ansible.builtin.apt:
        name: ansible
        state: latest
      when: ansible_facts['distribution']|upper == 'DEBIAN'

- name: Set up Ansible using Pip
  block:
    - name: Ensure pip is installed
      ansible.builtin.pip:
        name: pip
        state: present

    - name: Install ansible package using pip
      ansible.builtin.pip:
        name: ansible
        state: latest

