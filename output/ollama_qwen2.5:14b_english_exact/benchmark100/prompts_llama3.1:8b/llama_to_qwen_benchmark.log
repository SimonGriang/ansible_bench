---
- name: Create the Vault group
  group:
    name: "{{ vault_group }}"
    system: true

- name: Create the Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    createhome: no

- name: Create the Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: 0750
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Download the Vault binary
  unarchive:
    src: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0750
    creates: "{{ vault_binary_path }}"

- name: Check if the vault_path exists
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: 0750
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  check_mode: false

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: 0750
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: vault_path_exists | bool

- name: Create directories in vault_path
  file:
    path: "{{ item }}"
    state: directory
    mode: 0750
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  loop: "{{ vault_directories }}"
  when: item is defined

- name: Create data directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0750
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  loop: "{{ vault_data_directories }}"
  when: item is defined

- name: Generate TLS key and certificate
  openssl_certificate:
    path: "{{ vault_tls_path }}/{{ vault_tls_name }}.pem"
    privatekey_path: "{{ vault_tls_path }}/{{ vault_tls_name }}.key"
    provider: selfsigned
    selfsigned_organizational_unit: "{{ vault_tls_organizational_unit }}"
    selfsigned_country: "{{ vault_tls_country }}"
    selfsigned_locality: "{{ vault_tls_locality }}"
    selfsigned_common_name: "{{ vault_tls_common_name }}"
    selfsigned_state: "{{ vault_tls_state }}"
    selfsigned_email: "{{ vault_tls_email }}"
    selfsigned_validity_years: "{{ vault_tls_validity_years }}"
    mode: 0640
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: restart_vault_service

- name: Set ownership of TLS material
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0640
  loop: "{{ vault_tls_files }}"
  when: item is defined

- name: Copy the Vault binary
  copy:
    src: "{{ vault_binary_path }}"
    dest: "{{ vault_install_path }}"
    mode: 0750
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: restart_vault_service

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  command: setcap cap_ipc_lock=ep /usr/bin/vault
  args:
    creates: /usr/bin/vault

- name: Touch vault.env
  file:
    path: "{{ vault_env_path }}"
    state: touch
    mode: 0640
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Copy the Vault service file
  copy:
    src: "{{ vault_service_src }}"
    dest: /usr/lib/systemd/system/vault.service
    mode: 0644
    owner: root
    group: root

- name: Copy the Vault configuration
  copy:
    src: "{{ vault_config_src }}"
    dest: "{{ vault_config_dest }}"
    mode: 0640
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Flush handlers
  meta: flush_handlers

