---
- name: Check the current version of docker-compose
  command: docker-compose --version
  register: docker_compose_vsn

- name: Extract the version number from the docker-compose output
  set_fact:
    docker_compose_current_version: "{{ docker_compose_vsn.stdout|regex_replace('Docker Compose version ','')|regex_replace('\n','') }}"

- name: Remove the existing docker-compose version if it's different from the required version
  file:
    path: "{{ docker_compose_path }}"
    state: absent
  when: docker_compose_version is defined and docker_compose_version != "{{ docker_compose_current_version }}"

- name: Download and install Docker Compose if it's not already installed or if the current version is outdated
  block:
    - name: Download Docker Compose
      get_url:
        url: "{{ docker_compose_url }}"
        dest: "{{ docker_compose_path }}"
        mode: '0755'
    - name: Ensure Docker Compose is executable
      file:
        path: "{{ docker_compose_path }}"
        mode: '0755'
  when: docker_compose_version is defined and (docker_compose_version != "{{ docker_compose_current_version }}" or docker_compose_current_version is not defined)

