---
- name: Ensure /etc/openvpn/easy-rsa exists and set permissions
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Initialize the EasyRSA PKI directory
  command: "{{ easy_rsa_bin }} init-pki"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build the CA certificate using EasyRSA
  command: "{{ easy_rsa_bin }} build-ca nopass"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate the Diffie-Hellman (DH) parameters using EasyRSA
  command: "{{ easy_rsa_bin }} gen-dh"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build the server certificate using EasyRSA
  command: "{{ easy_rsa_bin }} build-server-full server nopass"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build the client certificate using EasyRSA
  command: "{{ easy_rsa_bin }} build-client-full client nopass"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate the Certificate Revocation List (CRL) using EasyRSA
  command: "{{ easy_rsa_bin }} gen-crl"
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate the Diffie-Hellman (DH) key using OpenVPN
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to the /etc/openvpn/server directory
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item.src }}
    dest: /etc/openvpn/server/{{ item.dest }}
    owner: root
    group: root
    mode: 0644
  with_items:
    - { src: "ca.crt", dest: "ca.crt" }
    - { src: "dh.pem", dest: "dh.pem" }
    - { src: "ta.key", dest: "ta.key" }
    - { src: "issued/server.crt", dest: "server.crt" }
    - { src: "private/server.key", dest: "server.key" }
    - { src: "issued/client.crt", dest: "client.crt" }
    - { src: "private/client.key", dest: "client.key" }

- name: Copy files to the /etc/openvpn directory
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item.src }}
    dest: /etc/openvpn/{{ item.dest }}
    owner: root
    group: root
    mode: 0644
  with_items:
    - { src: "ca.crt", dest: "ca.crt" }
    - { src: "ta.key", dest: "ta.key" }

- name: Place the server.conf file
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    owner: root
    group: root
    mode: 0644

