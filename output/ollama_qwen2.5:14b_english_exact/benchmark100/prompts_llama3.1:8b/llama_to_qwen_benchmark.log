---
- name: Import cron configuration from assert.yml file
  ansible.builtin.import_tasks: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install required packages for cron service
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell environment for cron service
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    create: true
    regexp: "^SHELL="
    state: present
    owner: root
    group: root
    mode: '0644'

- name: Configure system path for cron service
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    create: true
    regexp: "^PATH="
    state: present
    owner: root
    group: root
    mode: '0644'

- name: Configure mailto parameter for cron service
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    create: true
    regexp: "^MAILTO="
    state: present
    owner: root
    group: root
    mode: '0644'

- name: Start and enable the cron service
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ""

- name: Schedule the requested cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special: "{{ item.special }}"
    state: "{{ item.state }}"
  with_items: "{{ cron_jobs }}"
  when: cron_jobs is defined and cron_jobs|length > 0

