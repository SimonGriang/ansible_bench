---
- name: Create the RKE2 manifests directory with specific permissions and ownership
  file:
    path: /etc/rke2/manifests
    state: directory
    mode: '0750'
    owner: root
    group: root

- name: Copy kube-vip YAML files to the RKE2 manifests directory
  copy:
    src: "templates/{{ item.src }}.j2"
    dest: "/etc/rke2/manifests/{{ item.dest }}"
    mode: '0644'
  with_items:
    - { src: "kubevip-ds", dest: "kubevip-ds.yaml" }
    - { src: "kubevip-svc", dest: "kubevip-svc.yaml" }

- name: Copy kube-vip load balancer manifests to the RKE2 manifests directory
  copy:
    src: "templates/{{ item.src }}.j2"
    dest: "/etc/rke2/manifests/{{ item.dest }}"
    mode: '0644'
  with_items:
    - { src: "kubevip-lb", dest: "kubevip-lb.yaml" }
  when: rke2_kubevip_cloud_provider_enable|string() == 'True'

