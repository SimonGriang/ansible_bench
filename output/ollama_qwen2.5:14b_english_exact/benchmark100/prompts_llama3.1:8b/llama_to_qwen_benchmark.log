---
- name: Enable specific Apache2 modules
  hosts: all
  become: yes
  tasks:
    - name: Enable proxy and proxy_http modules on Debian and Suse systems
      community.general.apache2_module:
        name: "{{ item }}"
        state: present
      loop:
        - proxy
        - proxy_http
      when: ansible_facts['os_family'] in ['Debian', 'Suse']

    - name: Configure Apache2 locations
      template:
        src: location.conf.j2
        dest: "{{ item.path }}"
        mode: 0644
      loop: "{{ httpd_locations }}"
      notify: test httpd configuration
      notify: restart httpd

  handlers:
    - name: test httpd configuration
      command: apachectl configtest
      register: result
      failed_when: result.rc != 0

    - name: restart httpd
      service:
        name: httpd
        state: restarted

