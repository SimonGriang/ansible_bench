  vars:
    epel_gpg_key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version[:1] }}
    epel_url: "epel-release-latest-{{ ansible_distribution_major_version[:1] }}.noarch.rpm"
    epel_next_url: "epel-next-release-latest-{{ ansible_distribution_major_version[:1] }}.noarch.rpm"
  tasks:
    - name: Install EPEL GPG key
      ansible.builtin.rpm_key:
        key: "{{ epel_gpg_key }}"
        state: present

    - name: Install the EPEL-release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      notify: Update_package_cache

    - name: Install the EPEL-next-release package (conditional)
      ansible.builtin.package:
        name: "{{ epel_next_url }}"
        state: present
      notify: Update_package_cache
      when: epel_next | default(False) | bool

  handlers:
    - name: Update package cache
      ansible.builtin.meta:
        clear: true

