  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for specified port to become available
  ansible.builtin.wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection != 'container'
    - ansible_connection != 'docker'
    - ansible_connection != 'community.docker.docker'
    - bootstrap_wait_for_host is defined

- name: Prepare the system
  block:
    - name: Check if connection is established and sudo is available
      ansible.builtin.command: whoami
      become: "{{ bootstrap_become }}"
      register: bootstrap_connect
      changed_when: false
    - name: Gather bootstrap facts
      ansible.builtin.setup: {}
      when: bootstrap_connect is not defined
    - name: Include gather facts
      ansible.builtin.include_tasks: gather_facts.yml
      when: bootstrap_connect is not defined
    - name: Install bootstrap packages (raw)
      ansible.builtin.raw: "{{ bootstrap_facts_packages | join(' ') }}"
      when: bootstrap_connect is not defined
      changed_when: true
  # comment not indented like content

- name: Gather Ansible facts about the system
  ansible.builtin.setup: {}

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"
  when: bootstrap_connect is defined

