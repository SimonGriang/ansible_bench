- name: Create specified directories with the correct permissions
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  with_items:
    - /var/www/html/myproject
    - /var/www/html/myproject/static
    - /var/www/html/myproject/media
  become: yes

- name: Configure directory configurations for HTTP server
  template:
    src: directory.conf.j2
    dest: /etc/httpd/conf.d/myproject.conf
    mode: '0644'
  loop:
    - /var/www/html/myproject
    - /var/www/html/myproject/static
    - /var/www/html/myproject/media

