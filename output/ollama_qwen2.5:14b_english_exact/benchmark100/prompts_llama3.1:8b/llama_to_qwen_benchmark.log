---
- name: Ensure old versions of Docker are not installed
  yum:
    name: docker
    state: absent
  when: ansible_os_family == "RedHat"

- name: Add Docker GPG key
  rpm_key:
    state: present
    key: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg

- name: Add Docker repository
  yum_repository:
    name: docker
    description: Docker Repository
    baseurl: https://download.docker.com/linux/{{ ansible_os_family | lower }}/$releasever/{{ ansible_architecture }}/docker-{version}
    enabled: true
    gpgcheck: true
    gpgkey: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg

- name: Configure Docker Nightly repo and Docker Test repo
  block:
    - name: Enable Docker Nightly repository
      yum_repository:
        name: docker-nightly
        description: Docker Nightly Repository
        baseurl: https://download.docker.com/linux/{{ ansible_os_family | lower }}/$releasever/{{ ansible_architecture }}/docker-nightly-{version}
        enabled: "{{ docker_yum_repo_enable_nightly | default('no', true) | bool }}"
        gpgcheck: true
        gpgkey: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg

    - name: Enable Docker Test repository
      yum_repository:
        name: docker-test
        description: Docker Test Repository
        baseurl: https://download.docker.com/linux/{{ ansible_os_family | lower }}/$releasever/{{ ansible_architecture }}/docker-test-{version}
        enabled: "{{ docker_yum_repo_enable_test | default('no', true) | bool }}"
        gpgcheck: true
        gpgkey: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg

- name: Configure containerd on RHEL 8
  block:
    - name: Remove runc
      package:
        name: runc
        state: absent
      when: ansible_distribution_major_version == "8"

    - name: Install container-selinux
      package:
        name: container-selinux
        state: present
      when: ansible_distribution_major_version == "8"

    - name: Install containerd.io
      package:
        name: containerd.io
        state: present
      when: ansible_distribution_major_version == "8"

