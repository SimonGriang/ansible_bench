---
- name: Check existence of Java certificates
  stat:
    path: "{{ item }}"
  loop: "{{ java_certs }}"
  register: check_java_certs

- name: Fail if Java certificates do not exist
  fail:
    msg: "Java certificate {{ item.item }} does not exist at {{ item.stat.path }}"
  when: not item.stat.exists
  loop: "{{ check_java_certs.results }}"

- name: Set Java keystore directory for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: ansible_facts.java.version | int < 11

- name: Set Java keystore directory for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: ansible_facts.java.version | int >= 11

- name: Import SSL certificates into Java keystore
  java_cert:
    path: "{{ item }}"
    keystore: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/{{ java_keystore_name }}"
    keystore_pass: "{{ java_cert_keystore_pass }}"
    alias: "{{ item | basename | regex_replace('(.pem)', '') }}"
    keystore_type: "JKS"
    action: "import"
  loop: "{{ java_certs }}"

