---
- name: Import task list for validation
  import_tasks: assert.yml
  when: ansible_control_machine == True

- name: Install vsftpd package
  package:
    name: vsftpd
    state: present

- name: Configure vsftpd service
  copy:
    content: "anonymous_enable=YES\nlocal_enable=YES\nwrite_enable=YES\n"
    dest: /etc/vsftpd.conf
    mode: '0644'
    owner: root
    group: root
  notify: Restart vsftpd service

- name: Start vsftpd service and enable at boot
  service:
    name: vsftpd
    state: started
    enabled: yes

_handlers:
  - name: Restart vsftpd service
    service:
      name: vsftpd
      state: restarted

