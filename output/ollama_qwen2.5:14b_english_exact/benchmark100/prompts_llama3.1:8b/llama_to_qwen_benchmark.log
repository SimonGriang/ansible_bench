---
- name: Cordon and Drain the node with the specified RKE2 node name
  shell: "{{ rke2_data_path }}/bin/kubectl cordon {{ rke2_node_name }}"
  register: cordon_result
  retries: 100
  delay: 15
  until: cordon_result.rc == 0

- name: Cordon and Drain the node with the specified RKE2 node name
  shell: "{{ rke2_data_path }}/bin/kubectl drain {{ rke2_node_name }} {{ rke2_drain_additional_args | default('') }}"
  register: drain_result
  retries: 100
  delay: 15
  until: drain_result.rc == 0

- name: Restart the RKE2 service on the specified node
  shell: "systemctl restart {{ rke2_service_name }}"
  register: restart_result
  retries: 100
  delay: 15
  until: restart_result.rc == 0

- name: Wait for all nodes to be ready again
  shell: "{{ rke2_data_path }}/bin/kubectl get nodes -l {{ rke2_cluster_group_name }}=true -o json | jq '.items[].status.conditions[] | select(.type == \"Ready\") | select(.status == \"True\")'"
  register: nodes_ready_result
  retries: 100
  delay: 15
  until: nodes_ready_result.stdout | length > 0

- name: Uncordon the specified RKE2 node
  shell: "{{ rke2_data_path }}/bin/kubectl uncordon {{ rke2_node_name }}"
  register: uncordon_result
  retries: 100
  delay: 15
  until: uncordon_result.rc == 0

- name: Wait for all pods to be ready again
  shell: "{{ rke2_data_path }}/bin/kubectl get pods -o json | jq '.items[].status.conditions[] | select(.type == \"Ready\") | select(.status == \"True\")'"
  register: pods_ready_result
  retries: 100
  delay: 15
  until: pods_ready_result.stdout | length > 0

- name: Wait for all pods to pass readiness checks
  shell: "{{ rke2_data_path }}/bin/kubectl wait --for=condition=Ready=true --timeout=30s --all pods {{ rke2_wait_for_all_pods_to_be_healthy_args | default('') }}"
  register: pods_healthy_result
  retries: 100
  delay: 15
  until: pods_healthy_result.rc == 0

