sion changes - agents\n  include_tasks: rolling_restart.yml\n  when: rke2_version is changed and inventory_hostname in groups['rke2_agents_group']\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Rolling restart when config files change\n  include_tasks: change_config.yml\n  when: config_files_changed and inventory_hostname in groups['all']\n\n- name: Final steps\n  include_tasks: summary.yml\n\n#" additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-23T14:10:35.968210454Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12950483764, 'load_duration': 95242824, 'prompt_eval_count': 1755, 'prompt_eval_duration': 116680524, 'eval_count': 577, 'eval_duration': 12731106610, 'model_name': 'qwen2.5:14b'} id='run--5febcd43-e9c0-4f2a-b2cc-c278d6183503-0' usage_metadata={'input_tokens': 1755, 'output_tokens': 577, 'total_tokens': 2332}
