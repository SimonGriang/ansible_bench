---
- import_tasks: assert.yml
- name: Ensure cron package is installed
  package:
    name: "{{ cron_packages }}"
    state: present
- name: Configure shell settings for cron jobs
  lineinfile:
    dest: /etc/cron.d/cron.conf
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    create: yes
- name: Configure the system path for cron jobs
  lineinfile:
    dest: /etc/cron.d/cron.conf
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    create: yes
- name: Configure the mail-to setting for cron jobs
  lineinfile:
    dest: /etc/cron.d/cron.conf
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    create: yes
- name: Start and enable the cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    special_time: "{{ item.special_time }}"
    state: present
  with_items: "{{ cron_jobs }}"
  # Added newline at the end of the file to comply with yamllint


