---
- import_tasks: assert.yml

- name: Install the cron package
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell settings for cron jobs
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "SHELL={{ cron_shell }}"
    create: true

- name: Configure the system path for cron jobs
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "PATH={{ cron_path }}"
    insertafter: "SHELL={{ cron_shell }}"
    create: true

- name: Configure the mail-to setting for cron jobs
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "MAILTO={{ cron_mailto }}"
    insertafter: "PATH={{ cron_path }}"
    create: true

- name: Start and enable the cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    state: present
  with_items: "{{ cron_jobs }}"

