---
- name: Hardening | Disable Swap
  when: vault_hardening_disable_swap | default(false)
  block:
    - name: Check if swap is enabled
      command: swapon --show
      register: swapon_output
      changed_when: false
      failed_when: false

    - name: Disable swap temporarily
      command: swapoff -a
      when: swapon_output.stdout
      changed_when: false

    - name: Update /etc/fstab to disable swap permanently
      lineinfile:
        path: /etc/fstab
        regexp: '^(.+)\s+/dev/.+\s+swap\s+\w+\s+\d+\s+\d+$'
        line: "{{ item }}"
        state: absent
      with_items: "{{ swapon_output.stdout_lines }}"
      when: swapon_output.stdout

- name: Hardening | Disable Core Dumps
  when: vault_hardening_disable_core_dumps | default(false)
  block:
    - name: Set hard limit for core dumps
      community.general.pam_limits:
        limit_type: hard
        option: core
        value: 0
        domain: '*'
      when: vault_hardening_disable_core_dumps | default(false)

    - name: Set soft limit for core dumps
      community.general.pam_limits:
        limit_type: soft
        option: core
        value: 0
        domain: '*'
      when: vault_hardening_disable_core_dumps | default(false)

- name: Hardening | Disable Shell Command History
  when: vault_hardening_disable_shell_command_history | default(false)
  copy:
    dest: /etc/profile.d/vault.sh
    content: |
      export HISTFILE=/dev/null
      export HISTSIZE=0
    mode: '0755

- name: Hardening | Configure SELinux / AppArmor
  when: vault_hardening_configure_selinux_apparmor | default(false)
  block:
    - name: Install selinux-policy package
      apt:
        name: selinux-policy
        state: present
      when: ansible_os_family == "Debian"

    - name: Install selinux-policy package (RedHat)
      yum:
        name: selinux-policy
        state: present
      when: ansible_os_family == "RedHat"

    - name: Enable SELinux if already enabled
      selinux:
        policy: targeted
        state: enforcing

    - name: Enforce AppArmor
      command: aa-enforce
      args:
        chdir: /etc/apparmor.d/

