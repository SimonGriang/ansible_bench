---
- import_tasks: assert.yml

- name: Install logrotate package
  apt:
    name: logrotate
    state: present
  when: ansible_os_family == "Debian"

- name: Install logrotate package
  yum:
    name: logrotate
    state: present
  when: ansible_os_family == "RedHat"

- name: Configure logrotate by rendering a template
  template:
    src: logrotate.conf.j2
    dest: /etc/logrotate.conf
    mode: 0644

- name: Generate logrotate.d files using a template
  template:
    src: entry.j2
    dest: "/etc/logrotate.d/{{ item.name }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ logrotate_entries|default([])|map('dict2items')|map(attribute='value')|list }}"
  when: item.state != 'absent'

- name: Remove logrotate.d files
  file:
    path: "/etc/logrotate.d/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries|default([]) }}"
  when: item.state == 'absent'

- name: Manage logrotate service
  systemd:
    name: "{{ logrotate_service_name|default('logrotate') }}"
    state: "{{ logrotate_service_state|default('started') }}"
    enabled: "{{ logrotate_service_enabled|default('yes')|lower == 'true' }}"
  when: logrotate_service_name is defined and logrotate_service_name|length > 0

