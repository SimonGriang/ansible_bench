---
- name: Import and run assert.yml
  hosts: localhost
  tasks:
    - import_playbook: assert.yml

- name: Install required packages
  hosts: all
  tasks:
    - name: Ensure required packages are installed
      yum:
        name: "{{ item }}"
        state: present
      with_items: "{{ selinux_requirements }}"
      notify: Gather facts

- name: Flush handlers
  hosts: all
  tasks:
    - name: Flush handlers
      meta: flush_handlers

- name: Configure selinux
  hosts: all
  tasks:
    - name: Manage selinux settings
      when: selinux_status is defined and (ansible_connection != 'container' and ansible_connection != 'docker' and ansible_connection != 'community.docker.docker')
      block:
        - name: Ensure selinux is configured
          selinux:
            policy: "{{ selinux_policy }}"
            state: "{{ selinux_state }}"
          notify: Reboot

    - name: Manage selinux booleans
      when: selinux_status is defined and selinux_booleans is defined and (ansible_connection != 'container' and ansible_connection != 'docker' and ansible_connection != 'community.docker.docker')
      block:
        - name: Configure selinux booleans
          seboolean:
            name: "{{ item.name }}"
            state: "{{ item.state }}"
            persistent: "{{ item.pers }}"
          with_items: "{{ selinux_booleans }}"

  handlers:
    - name: Gather facts
      ansible.builtin.meta: flush_handlers

    - name: Reboot
      ansible.builtin.reboot:
        msg: "Rebooting the machine to apply SELinux changes."
        pre_reboot_command: sleep 10

