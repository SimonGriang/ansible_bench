---
- name: Import assert.yml file
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install the nginx package
  package:
    name: nginx
    state: present

- name: Place a customized nginx.conf file in the /etc/nginx directory
  copy:
    dest: /etc/nginx/nginx.conf
    mode: 0644
    content: "{{ lookup('template', 'nginx.conf.j2') }}"
  notify:
    - Validate nginx configuration

- name: Ensure the /etc/nginx/conf.d directory exists and is correctly configured
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: 0755

- name: Place a customized default.conf file in the /etc/nginx/conf.d directory
  copy:
    dest: /etc/nginx/conf.d/default.conf
    mode: 0644
    content: "{{ lookup('template', 'default.conf.j2') }}"
  notify:
    - Restart nginx

- name: Start and enable the nginx service
  service:
    name: nginx
    state: started
    enabled: yes

