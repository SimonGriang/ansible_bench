    section: mysqld
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    save_symlinks: yes
  with_dict: "{{ mysql_configuration_options }}"
  notify:
    - restart_mysql_server

- name: Configure the MySQL client
  ini_file:
    dest: "{{ mysql_configuration_destination }}/client.cnf"
    section: client
    option: socket
    value: "{{ mysql_client_socket }}"
    save_symlinks: yes

- name: Initialize the MySQL database
  shell: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable the MySQL service
  service:
    name: "{{ mysql_service }}"
    enabled: yes
    state: started

- name: Flush handlers
  meta: flush_handlers

- name: Place the my.cnf file
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0600'

