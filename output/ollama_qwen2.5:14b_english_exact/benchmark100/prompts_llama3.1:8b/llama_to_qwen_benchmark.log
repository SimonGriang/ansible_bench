---
- name: Install Keepalived when HA mode is enabled
  include_tasks: keepalived.yml
  when: ha_mode_enabled and inventory_hostname in groups['rke2_servers_group']

- name: Download and install RKE2 {{ rke2_version }}
  include_tasks: rke2.yml

- name: CIS Hardening
  include_tasks: cis.yml
  when: cis_profile is defined

- name: Find Active Server
  include_tasks: find_active_server.yml
  when: ha_mode_enabled

- name: Enable IPVS kernel module
  include_tasks: ipvs.yml
  when: ha_mode_enabled and ipvs_lb_enabled and inventory_hostname in groups['rke2_servers_group']

- name: Copy kube-vip manifests to the masternode
  include_tasks: kubevip.yml
  when: ha_mode_enabled and ipvs_lb_enabled and inventory_hostname == groups['rke2_servers_group'][0]

- name: Copy ingress-nginx manifests to the masternode
  include_tasks: ingress-nginx.yml
  when: ingress_nginx_values is defined and inventory_hostname == groups['rke2_servers_group'][0]

- name: Prepare very first server node in the cluster
  include_tasks: first_server.yml
  when: active_server is not defined or active_server == inventory_hostname and groups['rke2_servers_group']|length == 1

- name: Restore etcd specific tasks
  include_tasks: first_server_restore.yml
  when: active_server is defined and (inventory_hostname == groups['rke2_servers_group'][0] or inventory_hostname == groups['rke2_servers_group']|last) and etcd_restore_required

- name: Download kubeconfig to ansible localhost
  include_tasks: download_kubeconfig.yaml
  when: download_kubeconfig and inventory_hostname == groups['rke2_servers_group'][0]

- name: Prepare and join remaining nodes of the cluster
  include_tasks: remaining_nodes.yml
  when: active_server is defined and groups['rke2_servers_group']|length > 1

- name: Rolling cordon and drain restart when version changes - servers
  include_tasks: rolling_restart.yml
  when: version_changed and inventory_hostname in groups['rke2_servers_group'] and rke2_installed

- name: Rolling cordon and drain restart when version changes - agents
  include_tasks: rolling_restart.yml
  when: version_changed and inventory_hostname in groups['rke2_agents_group'] and rke2_installed

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  include_tasks: change_config.yml
  when: config_files_changed and rke2_installed

- name: Final steps
  include_tasks: summary.yml

