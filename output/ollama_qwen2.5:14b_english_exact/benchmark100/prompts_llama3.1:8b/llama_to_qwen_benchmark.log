---
- import_playbook: assert.yml
  name: Import and run tasks from assert.yml playbook
  run_once: true
  delegate_to: localhost

- name: Install required packages for the service
  package:
    name: "{{ service_required_packages }}"
    state: present

- name: Configure systemd service for each item in the service_list
  when: ansible_systemd is defined
  copy:
    src: systemd.j2
    dest: /etc/systemd/system/{{ item.name }}.service
    mode: 0644
  loop: "{{ service_list }}"
  notify: Systemctl daemon-reload

- name: Configure sysvinit service for each item in the service_list
  when: (ansible_local | default({}))['sysvinit_family']
  copy:
    src: sysvinit.j2
    dest: /etc/init.d/{{ item.name }}
    mode: 0755
  loop: "{{ service_list }}"

- name: Manage each service in the service_list
  service:
    name: "{{ item.name }}"
    enabled: "{{ item.enabled | default('yes') | bool }}"
    state: "{{ item.state | default('started') }}"
  loop: "{{ service_list }}"
  when: item.enabled is defined or item.state is defined

- name: Flush handlers
  meta: flush_handlers

