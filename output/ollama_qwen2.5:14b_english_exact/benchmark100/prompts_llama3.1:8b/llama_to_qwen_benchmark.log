---
- name: Install Apache ssl packages
  yum:
    name: "{{ httpd_ssl_packages }}"
    state: present

- name: Place ssl configuration file
  copy:
    src: templates/ssl.conf.j2
    dest: "{{ httpd_config_directory }}/ssl.conf"
    mode: 0644

- name: Configure default vhost to redirect from http to https
  copy:
    src: templates/default-vhost.conf.j2
    dest: "{{ httpd_config_directory }}/default-vhost.conf"
    mode: 0644
  notify: restart httpd service

- name: Ensure httpd service is restarted when configuration changes
  systemd:
    name: httpd
    state: restarted
  when: ansible_facts.services['httpd'] is defined
  become: yes

_handlers:
  - name: restart httpd service
    systemd:
      name: httpd
      state: restarted

