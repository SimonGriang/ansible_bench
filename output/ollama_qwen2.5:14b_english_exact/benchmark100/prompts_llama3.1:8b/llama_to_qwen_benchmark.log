onse_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-23T13:15:24.262898673Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12907377895, 'load_duration': 93045888, 'prompt_eval_count': 1475, 'prompt_eval_duration': 63038575, 'eval_count': 538, 'eval_duration': 12744816195, 'model_name': 'qwen2.5:14b'} id='run--e32a4598-3bf3-478a-b998-e8edfe71120b-0' usage_metadata={'input_tokens': 1475, 'output_tokens': 538, 'total_tokens': 2013}
