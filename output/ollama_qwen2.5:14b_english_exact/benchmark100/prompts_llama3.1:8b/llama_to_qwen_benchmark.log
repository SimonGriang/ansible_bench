---
- name: Create an SSL private key
  openssl_privatekey:
    path: /etc/ssl/private/myapp.key
    mode: '0600'
    owner: 'root'
    group: 'root'
    provider: 'RSA'
    size: 2048

- name: Create an SSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/csr/myapp.csr
    privatekey_path: /etc/ssl/private/myapp.key
    mode: '0600'
    owner: 'root'
    group: 'root'
    common_name: 'example.com'

- name: Create SSL certificates
  openssl_certificate:
    path: /etc/ssl/certs/myapp.crt
    privatekey_path: /etc/ssl/private/myapp.key
    csr_path: /etc/ssl/csr/myapp.csr
    mode: '0600'
    owner: 'root'
    group: 'root'
    provider: 'selfsigned'

- name: Create a PKCS#12 file
  openssl_pkcs12:
    export: true
    name: 'MyApp Certificate'
    path: /etc/ssl/pkcs12/myapp.p12
    certificate: /etc/ssl/certs/myapp.crt
    privatekey: /etc/ssl/private/myapp.key
    mode: '0600'
    owner: 'root'
    group: 'root'

- name: Read the private key
  slurp:
    src: /etc/ssl/private/myapp.key
  register: private_key

- name: Read the certificate
  slurp:
    src: /etc/ssl/certs/myapp.crt
  register: certificate

- name: Create a combined private key and certificate file
  copy:
    content: "{{ private_key.content + '\n' + certificate.content }}"
    dest: /etc/ssl/combined/myapp.pem
    mode: '0600'
    owner: 'root'
    group: 'root'

