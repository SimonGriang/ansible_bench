  ansible.builtin.import_tasks: assert.yml
- name: Ensure cron package is installed
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present
- name: Configure shell settings for cron jobs
  ansible.builtin.lineinfile:
    dest: /etc/cron.d/cron.conf
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    create: true
    mode: '0644'
- name: Configure the system path for cron jobs
  ansible.builtin.lineinfile:
    dest: /etc/cron.d/cron.conf
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    create: true
    mode: '0644'
- name: Configure the mail-to setting for cron jobs
  ansible.builtin.lineinfile:
    dest: /etc/cron.d/cron.conf
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    create: true
    mode: '0644'
- name: Start and enable the cron service
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    special_time: "{{ item.special_time }}"
    state: present
  with_items: "{{ cron_jobs }}"

