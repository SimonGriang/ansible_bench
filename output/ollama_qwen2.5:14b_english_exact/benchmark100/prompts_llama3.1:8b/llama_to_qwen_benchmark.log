---
- name: Create the /opt/cadvisor directory and set its permissions to 0755
  file:
    path: /opt/cadvisor
    state: directory
    mode: 0755

- name: Download the cadvisor binary from the internet
  block:
    - name: Ensure /opt/cadvisor directory is empty
      shell: test -z "$(ls -A /opt/cadvisor)"
      register: is_empty
      changed_when: false

    - name: Download cadvisor binary from internet
      get_url:
        url: "https://github.com/google/cadvisor/releases/download/v{{ cadvisor_version }}/cadvisor-linux-amd64"
        dest: /opt/cadvisor/cadvisor
        mode: 0755
        sha256sum: "{{ cadvisor_checksum }}"
      when: is_empty.stdout == ""

- name: Copy the locally distributed cadvisor binary
  copy:
    src: "{{ cadvisor_local_source }}"
    dest: /opt/cadvisor/cadvisor
    mode: 0755
  when: "'{{ cadvisor_local_source }}' is defined and is_file(cadvisor_local_source)"

- name: Create a symlink to the cadvisor binary
  file:
    src: /opt/cadvisor/cadvisor
    dest: /opt/cadvisor/cadvisor-bin
    state: link

- name: Configure the cadvisor systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
  when: "'{{ cadvisor_local_source }}' is defined and is_file(cadvisor_local_source)"

- name: Test if the cadvisor service is active
  shell: systemctl is-active cadvisor
  register: service_active
  changed_when: false

- name: Enable the cadvisor systemd service
  systemd:
    name: cadvisor
    enabled: yes

- name: Start the cadvisor systemd service
  systemd:
    name: cadvisor
    state: started
    daemon_reload: yes

