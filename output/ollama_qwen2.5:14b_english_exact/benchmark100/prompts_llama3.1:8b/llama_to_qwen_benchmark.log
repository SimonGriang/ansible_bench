---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    rke2_server_taints: "{{ rke2_server_node_taints }}"
  when: rke2_server_type == 'server'

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: "Config file changed"

- name: Copy kubelet config
  copy:
    src: "templates/kubelet-config.yaml.j2"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: "Config file changed"
  when: rke2_kubelet_config|length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  notify: "Config file changed"
  when: rke2_custom_registry_mirrors|length > 0 or rke2_custom_registry_configs|length > 0

- name: Register etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file|length > 0 and (rke2_server_service not defined or rke2_server_service == "disabled")

- name: Register etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file|length > 0 and rke2_etcd_snapshot_s3_options|length > 0

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/agent/etcd-snapshots
        state: directory
        owner: root
        group: root
        mode: '0755'
    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/etcd-snapshots/etcd-snapshot.db
        owner: root
        group: root
        mode: '0600'
    - name: Restore etcd from snapshot
      command: rke2 server etcd --snapshot=/var/lib/rancher/rke2/agent/etcd-snapshots/etcd-snapshot.db --restore
      when: do_etcd_restore|defined
  when: do_etcd_restore|defined

- name: Restore etcd from s3
  block:
    - name: Restore etcd from s3
      command: rke2 server etcd --snapshot-s3-access-key="{{ rke2_etcd_snapshot_s3_options['access_key'] }}" --snapshot-s3-secret-key="{{ rke2_etcd_snapshot_s3_options['secret_key'] }}" --snapshot-s3-bucket="{{ rke2_etcd_snapshot_s3_options['bucket'] }}" --snapshot-s3-snapshot-name="{{ rke2_etcd_snapshot_s3_options['snapshot_name'] }}" --restore
      when: do_etcd_restore_from_s3|defined
  when: do_etcd_restore_from_s3|defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    enabled: true
    state: started
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: "Service (re)started"

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: masked

- name: Wait for the first server be ready - no CNI
  shell: kubectl get node -o jsonpath='{.items[0].status.conditions[?(@.type=="Ready")].status}'
  register: node_status
  until: node_status.stdout == "True"
  retries: 30
  delay: 10
  when: rke2_cni_plugin is not defined

- name: Wait for the first server be ready - with CNI
  shell: >
    kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}'
  register: node_status_with_cni
  until: node_status_with_cni.stdout|length > 0 and node_status_with_cni.stdout|regex_replace(',', '') == "True"
  retries: 30
  delay: 10
  when: rke2_cni_plugin is defined

- name: Restore etcd
  block:
    - name: Remove old secrets and nodes
      shell: >
        kubectl delete secrets -l rke2.cluster.id={{ inventory_hostname }};
        kubectl delete nodes --all
    - name: Create new nodes
      shell: >
        kubectl create -f /etc/rancher/rke2/config.yaml --kubeconfig /etc/rancher/rke2/kubeconfig
  when: rke2_restore_etcd is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  with_items: "{{ groups[rke2_cluster_group_name] }}"

