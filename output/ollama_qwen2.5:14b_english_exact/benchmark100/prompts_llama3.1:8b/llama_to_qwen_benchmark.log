---
- import_tasks: assert.yml

- name: Run assert.yml on localhost
  include_tasks: assert.yml
  remote_addr: localhost

- name: Install the mysql package
  package:
    name: "{{ mysql_name }}"
    state: present

- name: Configure the mysql server
  template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: "/etc/{{ mysql_name }}/{{ mysql_name }}-server.cnf"
    mode: "0644"
  notify: restart_mysql

- name: Configure the mysql client
  template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: "/etc/{{ mysql_name }}/{{ mysql_name }}-client.cnf"
    mode: "0644"

- name: Initialize the mysql service
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable the mysql service
  systemd:
    name: "{{ mysql_name }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Create a my.cnf file in /root/.my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: "0600"

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: "present"
  loop: "{{ mysql_databases }}"

- name: List databases
  community.mysql.mysql_info:
    login_user: root

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: "import"
    initial_import: "{{ item.initial_import }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host|default('localhost') }}"
    password: "{{ item.password|default('') }}"
    priv: "{{ item.privileges|default('') }}"
    state: "present"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers

