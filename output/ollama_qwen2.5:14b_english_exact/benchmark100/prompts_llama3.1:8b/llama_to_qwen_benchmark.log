---
- name: Import assert.yml file
  import_tasks: assert.yml
  run_once: true
  remote_addr: localhost

- name: Install prerequisites
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ vault_prerequisites }}"

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item.line }}"
    create: yes
  loop: "{{ vault_environment_settings }}"
  notify: restart vault

- name: Include hardening tasks
  import_tasks: hardening.yml

- name: Start and enable vault on OSS
  when: vault_type == "oss"
  block:
    - name: Start vault
      service:
        name: vault
        state: started
    - name: Enable vault
      service:
        name: vault
        enabled: yes

- name: Enable vault (non-OSS)
  when: vault_type != "oss"
  service:
    name: vault
    enabled: yes

