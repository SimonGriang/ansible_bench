---
- name: Hardening | Disable Swap
  when: vault_hardening_disable_swap | default(false)
  block:
    - name: Disable swap temporarily
      command: "swapoff -a"
      when: "'{{ ansible_swaps }}' is defined and ansible_swaps|length > 0"

    - name: Disable swap permanently
      lineinfile:
        path: /etc/fstab
        regexp: '^[^#]'
        line: '#{{ item }}'
        state: present
      when: "'{{ ansible_swaps }}' is defined and ansible_swaps|length > 0"
      loop: "{{ ansible_swaps }}"

- name: Hardening | Disable Core Dumps
  when: vault_hardening_disable_core_dumps | default(false)
  block:
    - name: Set hard limit for core dumps to 0
      community.general.pam_limits:
        limittype: hard
        option: core
        value: 0

    - name: Set soft limit for core dumps to 0
      community.general.pam_limits:
        limittype: soft
        option: core
        value: 0

- name: Hardening | Disable Shell Command History
  when: vault_hardening_disable_shell_command_history | default(false)
  copy:
    dest: /etc/profile.d/vault.sh
    content: |
      export HISTIGNORE="&:ls:ls -l:ls -a:pwd:exit:bg:fg:history"

- name: Hardening | Configure SELinux / AppArmor
  block:
    - name: Install SELinux policy package
      package:
        name: selinux-policy
        state: present

    - name: Set SELinux policy to targeted
      command: "setsebool -P targeted 1"

    - name: Enforce SELinux
      command: "setenforce 1"

    - name: Enforce AppArmor
      command: "aa-enforce /etc/apparmor.d/*"

