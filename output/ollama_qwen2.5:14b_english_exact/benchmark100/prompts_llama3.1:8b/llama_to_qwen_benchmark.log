---
- import_tasks: assert.yml

- name: Install the dns packages
  apt:
    name: bind9
    state: present
  when: ansible_os_family == "Debian"

- name: Install the dns packages
  yum:
    name: bind
    state: present
  when: ansible_os_family == "RedHat"

- name: Create the required directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /etc/named
    - /var/cache/bind
    - /var/cache/bind/pdns

- name: Create the required group
  group:
    name: bind
    state: present

- name: Create the required user
  user:
    name: bind
    group: bind
    uid: 101
    system: yes
    state: present

- name: Generate the rndc key
  command: named-rndc -g
  args:
    creates: /etc/bind/rndc.key

- name: Set permissions on the rndc key file
  file:
    path: /etc/bind/rndc.key
    mode: '0640'
    owner: root
    group: bind

- name: Download the named.root file
  get_url:
    url: http://www.internic.net/zones/named.root
    dest: /etc/bind/named.root
    mode: '0644'

- name: Create the zone file
  template:
    src: zone.j2
    dest: /etc/bind/db.example.com
    mode: '0644'

- name: Add zones to the configuration
  template:
    src: named.conf.j2
    dest: /etc/bind/named.conf.local
    mode: '0644'

- name: Place the systemd override
  copy:
    content: '[Service]\nLimitNOFILE=10000\n'
    dest: /etc/systemd/system/bind9.service.d/override.conf
    mode: '0644'
  notify: reload_systemd_daemon

- name: Start and enable the DNS service
  systemd:
    name: bind9
    state: started
    enabled: yes

