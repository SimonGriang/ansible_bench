  when: git_username is defined and git_user_email is defined and git_user_name is defined and user_exists.rc == 0

- name: Create the repository destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username | default('') }}"
    group: "{{ git_groupname | default('') }}"
    mode: '0755'
  when: git_username is defined and user_exists.rc == 0

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version | default('HEAD') }}"
    force: "{{ item.force | default(false) }}"
    update: true
    clone: true
    accept_hostkey: true
    force_basic_auth: true
  loop: "{{ git_repositories }}"
  when: git_username is defined and git_repository_destination is defined and user_exists.rc == 0
  become_user: "{{ git_username }}"
