---
- import_tasks: assert.yml
  register: assert_result
  changed_when: false
  run_once: true
  local_action: true

- name: Install repository for RedHat task
  when: ansible_os_family == "RedHat"
  become: yes
  ansible.builtin.get_url:
    url: https://releases.hashicorp.com/hashicorp-repo/GPG
    dest: /etc/yum.repos.d/hashicorp.repo

- name: Configure Debian task
  when: ansible_os_family == "Debian"
  become: yes
  block:
    - name: Install required package gpg task
      ansible.builtin.apt:
        name: gpg
        state: present

    - name: Install apt key for Debian task
      ansible.builtin.apt_key:
        url: https://releases.hashicorp.com/hashicorp-GPG-KEY
        state: present

    - name: Install repository for Debian task
      ansible.builtin.apt_repository:
        repo: 'deb https://releases.hashicorp.com {{ ansible_distribution_release }} main'
        state: present

- name: Install hashicorp product using package task
  become: yes
  block:
    - name: Install latest hashicorp product using package task
      ansible.builtin.yum:
        name: "{{ hashicorp_product }}"
        state: latest
      when: ansible_os_family == "RedHat" and hashicorp_version == "latest"

    - name: Install versioned hashicorp product using package task
      ansible.builtin.yum:
        name: "{{ hashicorp_product }}={{ hashicorp_version }}"
        state: present
      when: ansible_os_family == "RedHat" and hashicorp_version != "latest"

    - name: Install latest hashicorp product using package task
      ansible.builtin.apt:
        name: "{{ hashicorp_product }}"
        state: latest
      when: ansible_os_family == "Debian" and hashicorp_version == "latest"

    - name: Install versioned hashicorp product using package task
      ansible.builtin.apt:
        name: "{{ hashicorp_product }}={{ hashicorp_version }}"
        state: present
      when: ansible_os_family == "Debian" and hashicorp_version != "latest"

- name: Install manually task
  block:
    - name: Download hashicorp product
      ansible.builtin.get_url:
        url: https://releases.hashicorp.com/{{ hashicorp_product }}/{{ hashicorp_version }}/{{ hashicorp_product }}_{% raw %}{{{% endraw %} hashicorp_version {% raw %}}}{% endraw %}_linux_%{{ ansible_architecture }}.zip
        dest: /tmp/{{ hashicorp_product }}.zip

    - name: Unpack hashicorp product
      ansible.builtin.unarchive:
        src: /tmp/{{ hashicorp_product }}.zip
        dest: /usr/local/bin
        remote_src: yes
        extra_opts: "-o /usr/local/bin/{{ hashicorp_product }}"
      register: unpack_result
      changed_when: "'WARNING' not in unpack_result.stdout"

