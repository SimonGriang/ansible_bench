---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  when: "'localhost' in inventory_hostname"

- name: Install the required packages for selinux
  ansible.builtin.package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush the handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Configure selinux based on the selinux state and policy
  ansible.posix.selinux:
    policy: "{{ selinux_policy }}"
    state: "{{ selinux_state }}"
  when:
    - selinux_state == "enabled"
    - "'docker' not in ansible_connection"
    - "'container' not in ansible_connection
  notify: Reboot

- name: Manage selinux booleans
  ansible.posix.seboolean:
    name: "{{ item.key }}"
    value: "{{ item.value.value }}"
    persist: "{{ item.value.persist }}"
  when: selinux_booleans is defined
  loop: "{{ selinux_booleans | dict2items }}"

