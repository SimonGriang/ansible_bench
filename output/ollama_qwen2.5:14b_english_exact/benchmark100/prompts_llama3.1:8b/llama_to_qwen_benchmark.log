  when: ansible_os_family == 'RedHat' and ansible_selinux is defined and ansible_selinux
  ansible.builtin.seboolean:
    name: "{{ item }}"
    state: true
    persist: true
  loop: "{{ httpd_sebooleans }}"
  notify: Test httpd configuration validity

- name: Allow connections to custom and SSL ports
  when: ansible_os_family == 'RedHat' and ansible_selinux is defined and ansible_selinux
  ansible.builtin.seboolean:
