- name: Install the MySQL package
  ansible.builtin.package:
    name: mysql
    state: present
  notify:
    - set_mysql_root_password
    - systemctl_daemon_reexec

- name: Configure the MySQL server
  ansible.builtin.ini_file:
    dest: "{{ mysql_configuration_destination }}/server.cnf"
    section: mysqld
    option: "{{ item.key }}"
    value: "{{ item.value }}"
  with_dict: "{{ mysql_configuration_options }}"
  notify: restart_mysql_server

- name: Configure the MySQL client
  ansible.builtin.ini_file:
    dest: "{{ mysql_configuration_destination }}/client.cnf"
