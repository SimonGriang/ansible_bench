---
- name: Remove Docker GPG key from trusted.gpg.d if present
  ansible.builtin.file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Remove old Docker apt source list
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Uninstall old versions of Docker
  ansible.builtin.package:
    name: docker-ce
    state: absent
  when: ansible_os_family == 'Debian'

- name: Remove legacy Docker repository file
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install required dependencies
  ansible.builtin.package:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Add or remove Docker repository
  ansible.builtin.block:
    - name: Ensure Docker GPG key is added
      ansible.builtin.get_url:
        url: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg
        dest: /usr/share/keyrings/docker-archive-keyring.gpg
      when: docker_add_repo | bool

    - name: Ensure Docker repository is added
      ansible.builtin.get_url:
        url: "https://download.docker.com/linux/{{ ansible_os_family | lower }}/apt/dists/{{ ansible_distribution_release }}/stable/binary-amd64/Packages"
        dest: /etc/apt/sources.list.d/docker.list
        mode: '0644'
      when: docker_add_repo | bool

    - name: Remove Docker repository
      ansible.builtin.file:
        path: /etc/apt/sources.list.d/docker.list
        state: absent
      when: not docker_add_repo | bool

- name: Notify apt update handler
  ansible.builtin.meta:
    flush_handlers:

