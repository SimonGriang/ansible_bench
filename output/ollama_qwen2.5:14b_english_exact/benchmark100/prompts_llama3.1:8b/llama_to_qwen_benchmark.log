---
- import_tasks: assert.yml
  remote_user: localhost

- name: Install the mysql package
  package:
    name: "{{ mysql_name }}"
    state: present

- name: Configure the mysql server
  template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: "{{ mysql_conf_dir }}/{{ mysql_name }}-server.cnf"
    mode: '0644'
  notify: restart_mysql

- name: Configure the mysql client
  template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: "{{ mysql_conf_dir }}/{{ mysql_name }}-client.cnf"
    mode: '0644'
  notify: restart_mysql

- name: Initialize the mysql service
  when: ansible_distribution in ['Alpine', 'Arch']
  command: "{{ mysql_initialize_command }}"
  args:
    warn: false

- name: Start and enable the mysql service
  service:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Create a my.cnf file in /root/.my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0600'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: List databases
  community.mysql.mysql_info:
    state: present

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: import
    initial_sql: "{{ item.initial_import }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers
  meta: flush_handlers

