---
- name: Create an SSL private key
  openssl_privatekey:
    path: /etc/ssl/private/myapp.key
    mode: '0600'
    owner: root
    group: root

- name: Create an SSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/private/myapp.csr
    privatekey_path: /etc/ssl/private/myapp.key
    mode: '0600'
    owner: root
    group: root
    country_name: US
    state_or_province_name: California
    locality_name: San Francisco
    organization_name: My Company
    organizational_unit_name: My Department
    common_name: myapp.example.com
    email_address: admin@example.com

- name: Create an SSL certificate
  x509_certificate:
    path: /etc/ssl/certs/myapp.crt
    privatekey_path: /etc/ssl/private/myapp.key
    csr_path: /etc/ssl/private/myapp.csr
    mode: '0644'
    owner: root
    group: root
    issuer: /etc/ssl/certs/myapp.crt
    validity: 365
    subject_alt_name: DNS:myapp.example.com

- name: Create a PKCS#12 file
  openssl_pkcs12:
    export: true
    path: /etc/ssl/private/myapp.p12
    name: myapp
    certificate: /etc/ssl/certs/myapp.crt
    privatekey: /etc/ssl/private/myapp.key
    mode: '0600'
    owner: root
    group: root
    password: mysecurepassword

- name: Read the private key
  slurp:
    src: /etc/ssl/private/myapp.key
  register: private_key_content

- name: Read the certificate
  slurp:
    src: /etc/ssl/certs/myapp.crt
  register: certificate_content

- name: Create a combined private key and certificate file
  copy:
    content: "{{ private_key_content.content | b64decode }}"
    dest: /etc/ssl/private/tmp_private_key
    mode: '0644'
    owner: root
    group: root

- name: Append certificate content to the combined file
  copy:
    content: "{{ certificate_content.content | b64decode }}"
    dest: /etc/ssl/private/tmp_private_key
    mode: '0644'
    owner: root
    group: root
    append: yes

- name: Rename the combined file to the final destination
  command: mv /etc/ssl/private/tmp_private_key /etc/ssl/private/myapp.pem
  args:
    creates: /etc/ssl/private/myapp.pem

