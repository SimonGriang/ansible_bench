---
- name: Install EPEL package repository for Amazon Linux 2 or RedHat-based systems
  hosts: all
  become: yes
  vars:
    epel_url: "{{ 'epel-release.noarch' if ansible_distribution_major_version == '7' or ansible_distribution_major_version == '8' or ansible_distribution_major_version == '9' or ansible_distribution_major_version == '10' else 'epel-release-latest-{{ ansible_distribution_major_version }}-noarch.rpm' }}"
    epel_next_url: "{{ 'epel-next-release.noarch' if ansible_distribution_major_version == '7' or ansible_distribution_major_version == '8' or ansible_distribution_major_version == '9' or ansible_distribution_major_version == '10' else 'epel-next-release-latest-{{ ansible_distribution_major_version }}-noarch.rpm' }}"
    epel_gpg_key: "RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}"
  tasks:
    - name: Install EPEL GPG key
      ansible.builtin.rpm_key:
        key: "{{ epel_gpg_key }}"
        state: present

    - name: Install the EPEL-release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache

    - name: Install the EPEL-next-release package (conditional)
      ansible.builtin.package:
        name: "{{ epel_next_url }}"
        state: present
      when: epel_next | default(false)
      notify: Update package cache

  handlers:
    - name: Update package cache
      ansible.builtin.meta:
        clear_dependencies: yes
      ansible.builtin.shell: yum makecache
      register: update_cache_result
      changed_when: "'Metadata cache' in update_cache_result.stdout`

