---
- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check the current version of Helm
  command: "{{ helm_bin_path }}/helm version --short"
  register: helm_existing_version
  failed_when: false
  changed_when: false
  when: helm_check.stat.exists

- name: Download Helm binary
  get_url:
    url: "{{ helm_repo_path }}/v{{ helm_version }}/linux-{{ helm_arch }}/helm"
    dest: /tmp/helm
    mode: 0755
  when: not helm_check.stat.exists or helm_existing_version.stdout != "{{ helm_version }} "

- name: Copy Helm binary into place
  copy:
    src: /tmp/helm
    dest: "{{ helm_bin_path }}/helm"
    mode: 0755
  become: true
  when: not helm_check.stat.exists or helm_existing_version.stdout != "{{ helm_version }} "
