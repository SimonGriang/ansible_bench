---
- name: Import assert tasks
  ansible.builtin.import_tasks: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install docker-compose package
  ansible.builtin.package:
    name: docker-compose
    state: present
  when: docker_compose_installation_type == "package"

- name: Install docker-compose binary
  block:
    - name: Install required packages for binary installation
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ docker_compose_binary_required_packages }}"

    - name: Download docker-compose binary
      ansible.builtin.get_url:
        url: "{{ docker_compose_url }}"
        dest: /usr/local/bin/docker-compose
      args:
        register: download_result

    - name: Ensure downloaded binary is executable
      ansible.builtin.file:
        path: /usr/local/bin/docker-compose
        mode: 'u+x'
  when: docker_compose_installation_type == "binary"

