---
- import_tasks: assert.yml
  name: Import assert tasks for httpd role
  when: ansible_hostname == 'localhost'
  remote_addr: localhost

- name: Install the Apache HTTP Server
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings for the httpd service
  when: ansible_os_family == 'RedHat' and ansible_selinux | bool
  ansible.builtin.seboolean:
    name: "{{ item }}"
    state: on
    persist: yes
  loop: "{{ httpd_sebooleans }}"
  notify: Test httpd configuration validity

- name: Allow connections to custom and SSL ports
  when: ansible_os_family == 'RedHat' and ansible_selinux | bool
  ansible.builtin.seboolean:
    name: httpd_can_network_connect_port{{ item }}
    state: on
    persist: yes
  loop: "{{ httpd_port }}"
  notify: Test httpd configuration validity
  when: item is defined
  register: custom_ports
  changed_when: custom_ports is changed

- name: Configure Apache HTTP Server
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: /etc/httpd/conf/httpd.conf
    mode: '0644'
    owner: root
    group: root
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Activate specific Apache HTTP Server modules on Debian-based systems
  when: ansible_os_family == 'Debian'
  ansible.builtin.command: a2enmod "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  notify: Test httpd configuration validity

- name: Import tasks related to SSL configuration
  import_tasks: ssl.yml
  when: https_ssl_enable is defined

- name: Import tasks related to locations configuration
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import tasks related to virtual hosts configuration
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure custom ports for Apache HTTP Server
  when: ansible_os_family in ['Debian', 'Suse']
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: /etc/httpd/conf/ports.conf
    mode: '0644'
    owner: root
    group: root
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Import tasks related to directories configuration
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Remove the default index.html file
  when: httpd_remove_example is defined
  ansible.builtin.file:
    path: /var/www/html/index.html
    state: absent

- name: Start and enable the Apache HTTP Server service
  ansible.builtin.service:
    name: httpd
    state: started
    enabled: yes

