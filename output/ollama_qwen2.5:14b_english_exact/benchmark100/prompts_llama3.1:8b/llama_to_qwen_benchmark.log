    state: present
  when: ansible_version|version("2.12") < 0 or ansible_os_family not in ["RedHat", "Debian"]

- name: Install Docker packages (with downgrade option) on systems with Ansible version 2.12 or higher and RedHat/Debian systems
  ansible.builtin.package:
    name: "{{ docker_packages }}"
    state: present
    version: "{{ docker_package_version }}"
  when: ansible_version|version("2.12") >= 0 and ansible_os_family in ["RedHat", "Debian"]

- name: Install the docker-compose plugin on systems where the plugin is enabled and the system meets the criteria for task 4 or 5
  ansible.builtin.package:
    name: "{{ docker_compose_plugin }}"
    state: present
  when: docker_compose_enabled and (ansible_version|version("2.12") < 0 or ansible_os_family not in ["RedHat", "Debian"])

- name: Install the docker-compose-plugin (with downgrade option) on systems where the plugin is enabled and the system meets the criteria for task 5
  ansible.builtin.package:
    name: "{{ docker_compose_plugin }}"
    state: present
    version: "{{ docker_compose_plugin_version }}"
  when: docker_compose_enabled and ansible_version|version("2.12") >= 0 and ansible_os_family in ["RedHat", "Debian"]

- name: Ensure the /etc/docker/ directory exists and has the correct permissions
  ansible.builtin.file:
    path: /etc/docker/
    state: directory
    mode: '0750'
    owner: root
    group: root

- name: Configure the Docker daemon options by copying the options to the daemon.json file
  ansible.builtin.copy:
    content: "{{ docker_daemon_options | to_json }}"
    dest: /etc/docker/daemon.json
    mode: '0644'
    owner: root
    group: root

- name: Ensure Docker is started and enabled at boot, if configured to do so
  ansible.builtin.service:
    name: docker
    enabled: "{{ docker_service_enabled | default('yes') }}"
    state: started
  when: docker_service_enabled | default('yes') == 'yes'

- name: Notify handlers to ensure firewall rules are updated
  ansible.builtin.meta:
    notify: update_firewall_rules

- name: Include tasks for managing docker-compose, if enabled
  include_tasks: manage_docker_compose.yml
  when: docker_compose_enabled

- name: Get information about the docker group using getent
  ansible.builtin.command: getent group docker
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  set_fact:
    users_to_add_to_docker: "{{ docker_group_info.stdout_lines | difference(docker_group_info.stdout_lines.split(':')[-1].split(',')) }}"
  when: docker_group_info.stdout is defined

- name: Include tasks for managing docker users, if necessary
  include_tasks: manage_docker_users.yml
  when: users_to_add_to_docker is defined

