---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install required software
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ users_requirements }}"

- name: Loop over users_groups
  include_tasks:
    file: group.yml
    loop_control:
      loop_var: group
  with_items: "{{ users_groups }}"

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "{{ users_sudo_includedir }}"
    regexp: "^{{ users_sudo_includedir }}"
    create: no
    backup: yes

- name: Loop over users
  include_tasks:
    file: user.yml
    loop_control:
      loop_var: user
  with_items: "{{ users }}"

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0644
  when: users_cron_allow is defined

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is not defined

