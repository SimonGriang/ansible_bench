---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0755'

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_local_install_script }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0755'
  when: airgap_mode and implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0755'
  when: airgap_mode and implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ rke2_artifacts_url }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: '0755'
  when: airgap_mode and implementation == 'download'
  register: remote_download
  failed_when: remote_download|changed
  check_mode: no

- name: Fall back to local download and push
  get_url:
    url: "{{ rke2_artifacts_url }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: '0755'
  when: remote_download|changed
  check_mode: no

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_additional_images_path }}"
    mode: '0755'
  loop: "{{ rke2_additional_images }}"
  when: airgap_mode and implementation != 'exists' and rke2_additional_images|length > 0

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ item }}"
    state: file
    mode: '0755'
  loop: "{{ rke2_artifacts }}"
  when: airgap_mode and implementation == 'exists'

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: "{{ fs_object_path }}"

- name: Check if separate partition
  shell: "grep -q {{ partition }} /proc/partitions"
  register: partition_check
  changed_when: false

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ '/usr/local/bin' if (lookup('pipe', 'test -w /usr/local') == '0') else '/usr/bin' }}"
  when: not partition_check|failed

- name: Check RKE2 version
  shell: "rke2 version"
  register: rke2_version

- name: Set RKE2 versions
  set_fact:
    rke2_versions: "{{ rke2_version.stdout_lines }}"
  when: rke2_version|changed

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_versions[0] >= rke2_desired_version
      - rke2_versions[1] >= rke2_desired_version
  when: rke2_versions is defined

- name: Run RKE2 install script
  shell: "{{ rke2_install_script_dest }} {{ rke2_install_script_vars }}"
  when: rke2_desired_version != rke2_installed_version

- name: Copy Custom Manifests
  copy:
    src: "{{ custom_manifests_path }}"
    dest: "{{ custom_manifests_dest }}"
    mode: '0755'
  when: custom_manifests_path is defined

- name: Copy Static Pods
  copy:
    src: "{{ static_pods_path }}"
    dest: "{{ static_pods_dest }}"
    mode: '0755'
  when: static_pods_path is defined

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file_path }}"
    dest: "{{ rke2_env_file_dest }}"
    mode: '0755'
  when: rke2_env_file_path is defined

