---
- import_tasks: assert.yml

- name: Uninstall the systemd-logger package
  yum:
    name: systemd-logger
    state: absent

- name: Install rsyslog and its required packages
  yum:
    name: "{{ item }}"
  with_items: "{{ rsyslog_packages }}"

- name: Install additional rsyslog features
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features }}"

- name: Configure the default rsyslog configuration if specified
  template:
    src: "rsyslog.conf.j2"
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: 0644
    notify: Restart rsyslog
  when: rsyslog_deploy_default_config

- name: Create the /etc/rsyslog.d/ directory with proper permissions
  file:
    path: /etc/rsyslog.d/
    state: directory
    mode: 0755

- name: Configure a forward rule for rsyslog if the default configuration is not being deployed
  template:
    src: "forward_rule.conf.j2"
    dest: /etc/rsyslog.d/forward_rule.conf
    owner: root
    group: root
    mode: 0644
    notify: Restart rsyslog
  when: not rsyslog_deploy_default_config

- name: Configure additional rsyslog configuration files
  template:
    src: "{{ item.key }}"
    dest: /etc/rsyslog.d/{{ item.value.name }}
    owner: root
    group: root
    mode: 0440
    notify: Restart rsyslog
  with_dict: "{{ rsyslog_rsyslog_d_files }}"

- name: Start and enable the rsyslog service
  systemd:
    name: rsyslog
    state: started
    enabled: yes

