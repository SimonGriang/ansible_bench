---
- name: Create the RKE2 manifests directory with specific permissions and ownership
  file:
    path: /etc/rke2/manifests
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy kube-vip YAML files to the RKE2 manifests directory
  copy:
    src: "templates/{{ item }}.j2"
    dest: "/etc/rke2/manifests/{{ item }}"
    mode: '0644'
  loop: "{{ lookup('ansible.builtin.fileglob', 'templates/kube-vip*.j2') | map('replace', '.j2', '') | list }}"

- name: Copy kube-vip load balancer manifests to the RKE2 manifests directory
  copy:
    src: "templates/{{ item }}.j2"
    dest: "/etc/rke2/manifests/{{ item }}"
    mode: '0644'
  loop: "{{ lookup('ansible.builtin.fileglob', 'templates/kube-vip-load-balancer*.j2') | map('replace', '.j2', '') | list }}"
  when: rke2_kubevip_cloud_provider_enable | bool

