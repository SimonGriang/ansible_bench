---
- import_tasks: assert.yml
  local_action: shell true

- name: Install Bash
  package:
    name: bash
    state: present

- name: Install OpenJDK Java (Package)
  when: java_vendor == "openjdk"
  package:
    name: "{{ java_package }}"
    state: present
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM (Local Java Source)
  when: java_source == "local" and java_format == "rpm"
  copy:
    src: "{{ oracle_java_rpm }}"
    dest: /tmp/oracle-java.rpm
  notify: Install Oracle Java RPM

- name: Install DEB (Local Java Source)
  when: java_source == "local" and java_format == "deb"
  copy:
    src: "{{ oracle_java_deb }}"
    dest: /tmp/oracle-java.deb
  notify: Install Oracle Java DEB

- name: Install Oracle Java (RPM) (Repository)
  when: java_source == "repository" and java_format == "rpm"
  package:
    name: "{{ oracle_java_rpm }}"
    state: present

- name: Configure Oracle Targz
  when: java_format == "targz" and java_vendor == "oracle"
  block:
    - name: Ensure java install directory exists
      file:
        path: "{{ java_install_directory }}"
        state: directory
        owner: root
        group: root
    - name: Install Oracle Java Targz
      unarchive:
        src: "{{ oracle_java_targz }}"
        dest: "{{ java_install_directory }}"
        remote_src: yes

- name: Install Oracle Java Policy Software (Targz)
  when: java_jce == true and java_version == 8 and java_vendor == "oracle"
  unarchive:
    src: "{{ oracle_java_policy_targz }}"
    dest: "{{ java_install_directory }}"
    remote_src: yes

- name: Set Alternative (Targz)
  when: java_format == "targz" and ansible_distribution != "Alpine"
  alternatives:
    name: java
    path: "{{ java_install_directory }}/bin/java"
    link: /usr/bin/java
    priority: 1
    state: present

- name: Find JAVA_HOME
  shell: readlink -f /usr/bin/java
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME="{{ java_home_result.stdout }}"'


