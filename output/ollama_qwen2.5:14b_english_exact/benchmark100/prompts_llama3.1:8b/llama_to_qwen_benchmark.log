- name: Enable specific Apache2 modules
  when: ansible_os_family in ['Debian', 'Suse']
  ansible.builtin.a2ensmod:
    module: proxy
  register: proxy_module_enabled

- name: Enable specific Apache2 modules
  when: ansible_os_family in ['Debian', 'Suse']
  ansible.builtin.a2ensmod:
    module: proxy_http
  register: proxy_http_module_enabled

- name: Configure Apache2 locations
  loop: "{{ httpd_locations }}"
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ item.location }}.conf"
    mode: "0644"
  notify: Test httpd configuration validity

