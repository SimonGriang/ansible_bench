---
- name: Import assert.yml from the current working directory
  ansible.builtin.import_tasks: assert.yml

- name: Install the MySQL package
  ansible.builtin.package:
    name: mysql
    state: present
  notify:
    - set_mysql_root_password
    - systemctl_daemon_reexec

- name: Configure the MySQL server
  ansible.builtin.ini_file:
    dest: "{{ mysql_configuration_destination }}/server.cnf"
    section: mysqld
    option: "{{ item.key }}"
    value: "{{ item.value }}"
  with_dict: "{{ mysql_configuration_options }}"
  notify: restart_mysql_server

- name: Configure the MySQL client
  ansible.builtin.ini_file:
    dest: "{{ mysql_configuration_destination }}/client.cnf"
    section: client
    option: socket
    value: /var/run/mysqld/mysqld.sock

- name: Initialize the MySQL database
  ansible.builtin.shell: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable the MySQL service
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place the my.cnf file
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf

- name: Create databases
  ansible.builtin.mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  ansible.builtin.mysql_user:
    name: "{{ item.username }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
  with_items: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

