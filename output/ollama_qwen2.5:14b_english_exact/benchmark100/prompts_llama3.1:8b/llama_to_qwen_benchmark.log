  changed_when: false

- name: Set node_names variable
  ansible.builtin.set_fact:
    node_names: "{{ node_names_result.stdout_lines }}"

- name: Remove old nodes from the cluster
  kubernetes.core.k8s_command:
    command: delete
    api_version: v1
    kind: node
    name: "{{ item }}"
  loop: "{{ node_names | difference(groups['rke2_cluster_group_name']) }}"
  register: delete_node_result
  ignore_errors: true
  changed_when: false


