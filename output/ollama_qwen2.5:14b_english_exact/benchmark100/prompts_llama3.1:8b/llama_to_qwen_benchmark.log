---
- import_tasks: assert.yml
  when: true

- name: Uninstall systemd-logger package
  yum:
    name: systemd-logger
    state: absent
  when: ansible_os_family == "RedHat"

- name: Install rsyslog and required packages
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_packages }}"
  when: ansible_os_family == "RedHat"

- name: Install additional rsyslog features
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features }}"
  when: ansible_os_family == "RedHat"

- name: Configure default rsyslog configuration
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: '0644'
    backup: yes
  notify: Restart rsyslog
  when: rsyslog_deploy_default_config is defined

- name: Create rsyslog.d directory
  file:
    path: /etc/rsyslog.d/
    state: directory
    mode: '0755'
  when: rsyslog_rsyslog_d_files is defined

- name: Configure forward rule for rsyslog
  template:
    src: forward_rule.conf.j2
    dest: /etc/rsyslog.d/forward.conf
    owner: root
    group: root
    mode: '0644'
    backup: yes
  notify: Restart rsyslog
  when: not rsyslog_deploy_default_config

- name: Configure additional rsyslog configuration files
  template:
    src: "{{ item.key }}.j2"
    dest: "/etc/rsyslog.d/{{ item.key }}"
    owner: root
    group: root
    mode: '0440'
    backup: yes
  loop: "{{ rsyslog_rsyslog_d_files|default({})|dict2items }}"
  notify: Restart rsyslog

- name: Start and enable rsyslog service
  systemd:
    name: rsyslog
    state: started
    enabled: yes


