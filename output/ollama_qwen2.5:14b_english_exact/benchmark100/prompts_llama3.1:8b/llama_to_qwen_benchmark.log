---
- name: Check all variables have been set correctly
  include_tasks: assert.yml
  remote_addr: localhost
  register: var_check_result
  changed_when: var_check_result is defined

- name: Wait for host (when configured)
  ansible.builtin.wait_for:
    port: "{{ ansible_port | default(ansible_ssh_port) }}"
    host: "{{ ansible_ssh_host | default(inventory_hostname) }}"
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare the system
  block:
    - name: Check connection
      ansible.builtin.ping:
      register: connection_result
      changed_when: connection_result is defined
      failed_when: connection_result is defined and connection_result is not success
    - name: Log connection test result
      ansible.builtin.debug:
        msg: "Connection test failed for {{ inventory_hostname }}"
      when: connection_result is defined and connection_result is not success
    - name: Include gather facts
      ansible.builtin.include_tasks: gather_facts.yml
    - name: Include install packages
      ansible.builtin.include_tasks: install_packages.yml
      when: bootstrap__facts_packages is defined and (bootstrap__facts_packages | length) > 0

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      ansible.builtin.setup:
      when: bootstrap_gather_facts | bool
    - name: Install bootstrap packages
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap__facts_packages }}"
      become: "{{ 'bootstrap_become' in ansible_local.bootstrap }}"
      become_user: "{{ bootstrap_become_user | default('root') }}"
      when: bootstrap__facts_packages is defined and (bootstrap__facts_packages | length) > 0


