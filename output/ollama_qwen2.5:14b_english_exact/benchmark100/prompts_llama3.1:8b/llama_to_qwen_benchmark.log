---
- name: Check python3.11 EXTERNALLY-MANAGED file existence
  ansible.builtin.file:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
    state: file
  register: externally_managed_file_py311

- name: Rename python3.11 EXTERNALLY-MANAGED file
  ansible.builtin.command: mv /usr/lib/python3.11/EXTERNALLY-MANAGED /usr/lib/python3.11/EXTERNALLY-MANAGED.old
  when: externally_managed_file_py311.stat.exists

- name: Check python3.12 EXTERNALLY-MANAGED file existence
  ansible.builtin.file:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
    state: file
  register: externally_managed_file_py312

- name: Rename python3.12 EXTERNALLY-MANAGED file
  ansible.builtin.command: mv /usr/lib/python3.12/EXTERNALLY-MANAGED /usr/lib/python3.12/EXTERNALLY-MANAGED.old
  when: externally_managed_file_py312.stat.exists

- name: Import assert.yml
  ansible.builtin.import_playbook: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip
  ansible.builtin.package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "index-url = {{ python_pip_proxy }}"
    create: true
  when: python_pip_proxy is defined

- name: Trust hosts
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    create: true
  when: python_pip_trusted_host is defined

- name: Update pip
  ansible.builtin.package:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_update }}"
  when: >
    ansible_distribution_release not in ['bookworm', 'noble'] and
    ansible_os_family != 'Alpine'

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when: >
    ansible_distribution_release not in ['bookworm', 'noble'] and
    ansible_os_family != 'Alpine'

