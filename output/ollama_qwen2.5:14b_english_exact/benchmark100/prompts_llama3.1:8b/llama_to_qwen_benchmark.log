---
- import_tasks: assert.yml

- name: Install the MySQL package
  package:
    name: "{{ mysql_package_name }}"
    state: present
  notify:
    - set_mysql_root_password
    - systemctl_daemon_reexec

- name: Configure the MySQL server
  ini_file:
    dest: "{{ mysql_configuration_destination }}/server.cnf"
    section: mysqld
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    save_symlinks: yes
  with_dict: "{{ mysql_configuration_options }}"
  notify:
    - restart_mysql_server

- name: Configure the MySQL client
  ini_file:
    dest: "{{ mysql_configuration_destination }}/client.cnf"
    section: client
    option: socket
    value: "{{ mysql_client_socket }}"
    save_symlinks: yes

- name: Initialize the MySQL database
  shell: "{{ mysql_initialize_command }}"
  when: ansible_distribution == 'Alpine' or ansible_distribution == 'Archlinux'

- name: Start and enable the MySQL service
  service:
    name: "{{ mysql_service }}"
    enabled: yes
    state: started

- name: Flush handlers
  meta: flush_handlers

- name: Place the my.cnf file
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0600'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_databases }}"
  no_log: "{{ no_log_setting }}"

- name: Create users
  mysql_user:
    name: "{{ item.username }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  with_items: "{{ mysql_users }}"
  no_log: "{{ no_log_setting }}"

- name: Flush handlers again
  meta: flush_handlers

