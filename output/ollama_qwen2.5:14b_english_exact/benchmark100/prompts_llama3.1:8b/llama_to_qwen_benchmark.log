---
- import_tasks: assert.yml

- name: Install the MySQL package
  package:
    name: "{{ mysql_package_name }}"
    state: present
  notify:
    - set_mysql_root_password
    - systemctl_daemon_reexec

- name: Configure the MySQL server
  ini_file:
    dest: "{{ mysql_configuration_destination }}/server.cnf"
    section: mysqld
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    save_symlinks: yes
  with_dict: "{{ mysql_configuration_options }}"
  notify:
    - restart_mysql_server

- name: Configure the MySQL client
  ini_file:
    dest: "{{ mysql_configuration_destination }}/client.cnf"
    section: client
    option: socket
    value: "{{ mysql_client_socket }}"
    save_symlinks: yes

- name: Initialize the MySQL database
  shell: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

