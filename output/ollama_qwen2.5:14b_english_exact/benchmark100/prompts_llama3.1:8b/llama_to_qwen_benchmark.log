---
- name: Remove Docker GPG key from trusted.gpg.d if present
  ansible.builtin.file:
    path: /etc/apt/trusted.gpg.d/docker.asc
    state: absent

- name: Remove old Docker apt source list
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Uninstall old versions of Docker
  ansible.builtin.package:
    name: docker-ce
    state: absent

- name: Remove legacy Docker repository file
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install required dependencies
  ansible.builtin.apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: yes

- name: Add or remove Docker repository
  ansible.builtin.include_tasks:
    file: "{{ docker_add_repo | bool ? 'docker_repo_add.yml' : 'docker_repo_remove.yml' }}"

- name: Notify apt update handler
  ansible.builtin.meta:
    invoke: handler
