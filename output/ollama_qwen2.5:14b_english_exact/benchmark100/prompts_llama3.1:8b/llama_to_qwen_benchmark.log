---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Set server taints
  set_fact:
    rke2_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_node_type == 'server'

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed
  when: rke2_kubelet_config|length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed
  when: rke2_custom_registry_mirrors|length > 0 or rke2_custom_registry_configs|length > 0

- name: Register etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file|length > 0 and (rke2_server_service is undefined or rke2_server_service.status == 'disabled')

- name: Register etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file|length > 0 and rke2_etcd_snapshot_s3_options is defined

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/agent/etcd-snapshots
        state: directory
        owner: root
        group: root
        mode: 0700
    - name: Copy the etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/etcd-snapshots/etcd-snapshot.db
        owner: root
        group: root
        mode: 0600
    - name: Restore etcd from the snapshot
      command: rke2 server etcd restore /var/lib/rancher/rke2/agent/etcd-snapshots/etcd-snapshot.db
      when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Restore etcd from the s3 snapshot
      command: rke2 server etcd restore s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }}
      when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: masked
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - no CNI
  shell: kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}'
  register: node_status
  until: node_status.stdout == "True"
  retries: 30
  delay: 10
  when: inventory_hostname == groups['rke2_cluster_group_name'][0] and rke2_cni is not defined

- name: Wait for the first server be ready - with CNI
  shell: kubectl get nodes -o jsonpath="{range .items[*]}{.metadata.name}:{.status.conditions[?(@.type=='Ready')].status}{'\n'}{end}"
  register: nodes_status
  until: nodes_status.stdout.find('Ready:True') > -1
  retries: 30
  delay: 10
  when: inventory_hostname == groups['rke2_cluster_group_name'][0] and rke2_cni is defined

- name: Restore etcd
  command: >
    kubectl delete secrets -l app=etcd; kubectl delete nodes --all
  when: rke2_etcd_restore is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  delegate_facts: true
  loop: "{{ groups['rke2_cluster_group_name'] }}"

