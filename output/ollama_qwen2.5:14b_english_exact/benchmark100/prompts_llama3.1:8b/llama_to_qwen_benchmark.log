---
- name: Create the Vault group
  group:
    name: "{{ vault_group }}"
    system: true

- name: Create the Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"

- name: Create the Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0750'

- name: Download the Vault binary
  unarchive:
    src: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: false
    creates: "{{ vault_binary_path }}"
  register: vault_binary_download

- name: Check if the vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_check

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0750'
  when: not vault_path_check.stat.exists

- name: Create directories in vault_path
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0750'
  with_items: "{{ vault_directories }}"

- name: Create data directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0750'
  with_items: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  shell: |
    openssl req -x509 -newkey rsa:4096 -keyout {{ vault_tls_key }} -out {{ vault_tls_cert }} -days 365 -nodes -subj "/CN=vault"
  args:
    creates: "{{ vault_tls_cert }}"

- name: Set ownership of TLS material
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  with_items: "{{ vault_tls_files }}"

- name: Copy the Vault binary
  copy:
    src: "{{ vault_binary_path }}/vault"
    dest: "{{ vault_binary_dest }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0750'

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  sefcontext:
    path: /usr/bin/vault
    capabilites: cap_ipc_lock=ep

- name: Touch vault.env
  file:
    path: "{{ vault_env_path }}"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0640'

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy the Vault service file
  copy:
    src: "{{ vault_service_src }}"
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'

- name: Copy the Vault configuration
  copy:
    src: "{{ vault_config_src }}"
    dest: "{{ vault_config_dest }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0640'

- name: Flush handlers
  meta: flush_handlers

