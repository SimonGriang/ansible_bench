---
- name: Import assert.yml file for task execution and skip the rest of the tasks on the first run
  import_tasks: assert.yml
  failed_when: false
  when: ansible_facts['uuid'] is undefined

- name: Pre-configure Debian systems for postfix installation
  debconf:
    name: postfix
    question: postfix/main/rfc
    value: "No configuration"
    vtype: select

- name: Install postfix package
  package:
    name: postfix
    state: present

- name: Install postfix-mysql package if specific conditions are met
  package:
    name: postfix-mysql
    state: present
  when: "'mysql' in (postfix_virtual_mailbox_maps|default('') or postfix_virtual_mailbox_domains|default('') or postfix_virtual_alias_maps|default(''))"

- name: Configure postfix transport maps
  copy:
    dest: /etc/postfix/transport
    content: "{{ postfix_transport_maps }}"
    mode: '0644'
  notify: validate_transport_maps
  notify: rebuild_transport_maps_db

- name: Configure postfix header checks
  copy:
    dest: /etc/postfix/header_checks
    content: "{{ postfix_header_checks }}"
    mode: '0644'
  notify: validate_header_checks
  notify: reload_postfix

- name: Set values for the main.cf file
  set_fact:
    maincf: "{{ postfix_recipient_access|d([]) + postfix_sender_access|d([]) + postfix_mynetworks|d([]) + postfix_mydestination|d([]) + postfix_relay_domains|d([]) + postfix_smtpd_recipient_restrictions|d([]) + postfix_smtpd_sender_restrictions|d([]) + postfix_virtual_mailbox_domains|d([]) + postfix_virtual_alias_domains|d([]) }}"

- name: Configure postfix main.cf
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify: validate_maincf
  notify: restart_postfix

- name: Configure postfix master.cf
  copy:
    dest: /etc/postfix/master.cf
    content: "{{ postfix_master }}"
    mode: '0644'
  notify: validate_mastercf
  notify: restart_postfix

- name: Create directory for TLS certificates and keys
  file:
    path: /etc/postfix/tls
    state: directory
    mode: '0755'

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_cert }}"
    dest: /etc/postfix/tls/smtpd.cert
    mode: '0644'
  notify: reload_postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key }}"
    dest: /etc/postfix/tls/smtpd.key
    mode: '0600'
  notify: reload_postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    dest: /etc/postfix/aliases
    content: "{{ postfix_aliases }}"
    mode: '0644'
  notify: rebuild_alias_db
  notify: reload_postfix

- name: Configure sender_access
  copy:
    dest: /etc/postfix/sender_access
    content: "{{ postfix_sender_access }}"
    mode: '0644'
  notify: rebuild_sender_access_db
  notify: reload_postfix

- name: Configure recipient_access
  copy:
    dest: /etc/postfix/recipient_access
    content: "{{ postfix_recipient_access }}"
    mode: '0644'
  notify: validate_recipient_access
  notify: rebuild_recipient_access_db
  notify: reload_postfix

- name: Place sasl_password_map
  copy:
    dest: /etc/postfix/sasl_password_map
    content: "{{ postfix_smtp_sasl_password_map_content }}"
    mode: '0644'
  notify: rebuild_sasl_password_map_db

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix service
  service:
    name: postfix
    state: started
    enabled: yes

