content='---\n- name: Import assert.yml file\n  import_tasks: assert.yml\n  when: true\n  run_once: true\n  delegate_to: localhost\n\n- name: Install prerequisites\n  package:\n    name: "{{ vault_prerequisites }}"\n    state: present\n\n- name: Include installation method specific tasks\n  include_tasks: "{{ vault_installation_method }}.yml"\n\n- name: Add Vault environment variables\n  lineinfile:\n    path: /etc/vault.d/vault.env\n    create: yes\n    line: "{{ item }}"\n  loop: "{{ vault_environment_settings }}"\n  notify: restart vault\n\n- name: Include hardening tasks\n  import_tasks: hardening.yml\n\n- name: Start and enable vault on OSS\n  service:\n    name: vault\n    state: started\n    enabled: yes\n  when: vault_type == "oss"\n\n- name: Enable vault (non-OSS)\n  service:\n    name: vault\n    enabled: yes\n  when: vault_type != "oss"' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-13T05:19:00.725592783Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3863653106, 'load_duration': 96500021, 'prompt_eval_count': 504, 'prompt_eval_duration': 122269628, 'eval_count': 213, 'eval_duration': 3635893187, 'model_name': 'qwen2.5:14b'} id='run--a37fdb27-8015-43aa-a402-c50ff9e4361d-0' usage_metadata={'input_tokens': 504, 'output_tokens': 213, 'total_tokens': 717}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Import assert.yml file
  import_tasks: assert.yml
  when: true
  run_once: true
  delegate_to: localhost

- name: Install prerequisites
  package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  lineinfile:
    path: /etc/vault.d/vault.env
    create: yes
    line: "{{ item }}"
  loop: "{{ vault_environment_settings }}"
  notify: restart vault

- name: Include hardening tasks
  import_tasks: hardening.yml

- name: Start and enable vault on OSS
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable vault (non-OSS)
  service:
    name: vault
    enabled: yes
  when: vault_type != "oss"

