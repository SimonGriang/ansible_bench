    state: present
  when: promtail_apt_update_cache | bool

- name: Create promtail system group if necessary
  group:
    name: "{{ promtail_system_group }}"
    system: yes
  when: promtail_system_group != "root" and promtail_system_group is defined

- name: Create the promtail system user
  user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    groups: "{{ promtail_user_additional_groups }}"
    system: yes
  when: promtail_system_user != "root" and promtail_system_user is defined

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Create necessary config directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
  with_items:
    - "{{ promtail_config_dir }}"
    - "{{ promtail_positions_dir }}"

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
  with_items:
    - "{{ promtail_install_dir }}"
    - "{{ promtail_version_dir }}"

- name: Check the existence of the promtail binary
  stat:
    path: "{{ promtail_version_dir }}/promtail"
  register: promtail_binary_exists

- name: Download promtail binaries if necessary
  get_url:
    url: "{{ promtail_binary_url }}"
    dest: /tmp/promtail.zip
    validate_certs: yes
  when: promtail_binary_exists.stat.exists == False or promtail_local_archive_exists

- name: Propagate locally distributed promtail archive if necessary
  copy:
    src: "{{ promtail_local_archive }}"
    dest: /tmp/promtail.zip
  when: promtail_local_archive_exists

- name: Download promtail binaries to controller node if necessary
  get_url:
    url: "{{ promtail_binary_url }}"
    dest: /tmp/promtail.zip
    validate_certs: yes
  when: promtail_binary_propagate | bool

- name: Propagate promtail binaries
  copy:
    src: "{{ promtail_version_dir }}/promtail"
    dest: "{{ promtail_install_dir }}/promtail"
    mode: 0755
  when: promtail_binary_propagate | bool

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail.zip
    dest: "{{ promtail_version_dir }}"
    remote_src: yes
    creates: "{{ promtail_version_dir }}/promtail"

- name: Create a symlink to the latest version
  file:
    src: "{{ promtail_version_dir }}/promtail"
    dest: /usr/local/bin/promtail
    state: link
    force: yes

- name: Write the promtail configuration
  template:
    src: promtail_config.j2
    dest: "{{ promtail_config_dir }}/promtail.yml"
    mode: 0644
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"

- name: Create the systemd service unit
  template:
    src: promtail_service.j2
    dest: /etc/systemd/system/promtail.service
    mode: 0644
    owner: root
    group: root



