---
- name: Create an SSL private key
  openssl_privatekey:
    path: /etc/ssl/private/myapp.key
    mode: '0600'
    owner: ssl-cert
    group: ssl-cert
    provider: RSA
    size: 4096

- name: Create an SSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/private/myapp.csr
    privatekey_path: /etc/ssl/private/myapp.key
    mode: '0600'
    owner: ssl-cert
    group: ssl-cert
    common_name: example.com

- name: Create SSL certificates
  openssl_certificate:
    path: /etc/ssl/private/myapp.crt
    csr_path: /etc/ssl/private/myapp.csr
    provider: selfsigned
    mode: '0600'
    owner: ssl-cert
    group: ssl-cert

- name: Create a PKCS#12 file
  openssl_pkcs12:
    export: true
