---
- name: Import assert tasks
  import_tasks: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install required packages for selinux
  ansible.builtin.package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush the handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Configure selinux
  ansible.posix.selinux:
    state: "{{ 'enforcing' if selinux_state == 'enabled' else 'disabled' }}"
    policy: "{{ selinux_policy }}"
  when:
    - selinux_state == 'enabled'
    - ansible_connection != 'docker'
    - ansible_connection != 'lxc'
  notify: Reboot

- name: Manage selinux booleans
  ansible.posix.seboolean:
    name: "{{ item.key }}"
    value: "{{ item.value.value }}"
    persistent: "{{ item.value.pERSISTENT|bool }}"
