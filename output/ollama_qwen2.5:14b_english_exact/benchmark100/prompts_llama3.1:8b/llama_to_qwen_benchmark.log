---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection not in ["container", "docker", "community.docker.docker"]
    - ansible_connection is not none
    - bootstrap_wait_for_host is true

- name: Prepare system
  become: false
  tasks:
    - name: Test connection
      command: echo test
      register: connection_test
      changed_when: false
    - name: Gather bootstrap facts when connection test fails
      ansible.builtin.setup:
        filter: ansible_all_ipv4_addresses
      when: connection_test is failed
    - name: Test sudo
      command: whoami
      become: true
      register: sudo_test
      changed_when: false
      when: connection_test is succeeded
    - name: Install bootstrap packages (raw) when sudo test fails
      ansible.builtin.shell: yum install -y {{ item }}
      loop: "{{ bootstrap_facts_packages }}"
      become: false
      when:
        - sudo_test is failed
        - ansible_os_family == "RedHat"
    - name: Ensure libdnf5 is present on Fedora/RedHat
      ansible.builtin.yum:
        name: libdnf5
        state: present
      when:
        - sudo_test is failed
        - ansible_os_family == "RedHat"

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become }}"

