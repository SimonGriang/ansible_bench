- name: Start and enable vault on OSS
  when: vault_type == "oss"
  block:
    - name: Start vault
      service:
        name: vault
        state: started
    - name: Enable vault
      service:
        name: vault
        enabled: yes

- name: Enable vault (non-OSS)
  when: vault_type != "oss"
  service:
    name: vault
    enabled: yes


