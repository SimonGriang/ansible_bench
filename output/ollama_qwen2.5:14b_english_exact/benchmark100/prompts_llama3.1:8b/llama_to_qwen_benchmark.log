---
- import_tasks: assert.yml
  when: true

- package:
    name: "{{ httpd_packages }}"
    state: present

- set_fact:
    selinux_enabled: "{{ (ansible_facts.selinux.is_selinux_enabled() == 1) }}"
  when: ansible_facts.selinux is defined

- command: setsebool -P {{ item.key }} {{ item.value }}
  loop: "{{ httpd_sebooleans | default({}) | dict2items }}"
  when: selinux_enabled and item.value is defined

- command: allow_port {{ item }} httpd
  loop: "{{ [httpd_port, httpd_ssl_port] | reject('defined') | list }}"
  when: selinux_enabled

- template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    owner: root
    group: root
    mode: 0644

- command: a2enmod {{ httpd_modules_to_activate_with_command }}
  when: ansible_facts.os_family == "Debian"

- import_tasks: ssl.yml
  when: https_ssl_enable | default(false)

- import_tasks: locations.yml
  when: httpd_locations is defined

- import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- template:
    src: "{{ httpd_ports_conf.j2 }}"
    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
    owner: root
    group: root
    mode: 0644
  when: ansible_facts.os_family in ["Debian", "Suse"]

- import_tasks: directories.yml
  when: httpd_directories is defined

- file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example | default(false)

- service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes

