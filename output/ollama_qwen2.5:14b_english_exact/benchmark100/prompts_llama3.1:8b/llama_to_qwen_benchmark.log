---
- name: Check all variables have been set correctly
  include_tasks: assert.yml
  remote_addr: localhost
  register: variable_check_result
  run_once: true

- name: Wait for host (when configured)
  ansible.builtin.wait_for:
    host: "{{ ansible_ssh_host | default(inventory_hostname) }}"
    port: "{{ ansible_port }}"
    timeout: "{{ bootstrap_timeout | default(60) }}"
  when: ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare the system
  block:
    - name: Check connection
      ansible.builtin.ping:
      register: connection_result
      changed_when: connection_result is defined

    - name: Log debug message if connection check fails
      ansible.builtin.debug:
        msg: "Connection check failed or not supported. This is expected if the connection is not supported."
      when: connection_result is not defined
      changed_when: connection_result is not defined

    - name: Include bootstrap facts
      ansible.builtin.include_tasks: gather_facts.yml

  always:
    - name: Include bootstrap facts
      ansible.builtin.include_tasks: gather_facts.yml

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      ansible.builtin.setup:

    - name: Install bootstrap packages
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap__facts_packages | default([]) }}"
      become: "{{ bootstrap__become }}"
      become_user: "{{ bootstrap__become_user | default('root') }}"

