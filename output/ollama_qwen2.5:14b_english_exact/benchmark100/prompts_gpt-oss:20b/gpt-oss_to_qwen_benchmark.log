---
- import_tasks: assert.yml

- name: Install using package
  yum:
    name: "{{ item }}"
    state: present
  with_items: "{{ hashicorp_products }}"
  when: ansible_os_family in ['RedHat', 'Rocky']
  loop_control:
    loop_var: item
  run_once: true
  delegate_to: localhost

- name: Install repository for RedHat
  copy:
    dest: /etc/yum.repos.d/hashicorp.repo
    content: |
      [hashicorp]
      name=HashiCorp Repository
      baseurl=https://pkg.cfssl.org/RPMS/
      enabled=1
      gpgcheck=0
  when: ansible_os_family in ['RedHat', 'Rocky']

- name: Configure debian
  lineinfile:
    path: /etc/apt/sources.list.d/hashicorp.list
    line: "deb https://pkg.cfssl.org/deb/debian/ /"
  when: ansible_os_family == 'Debian'

- name: Install required package gpg
  apt:
    name: gpg
    state: present
  when: ansible_os_family == 'Debian'

- name: Install apt key for Debian
  apt_key:
    url: https://pkg.cfssl.org/deb/RPM-GPG-KEY-hashicorp
    state: present
    validate_certs: false
  when: ansible_os_family == 'Debian'

- name: Install repository for Debian
  apt_repository:
    repo: "deb [arch={{ debian_architecture_mapping[item] }}] https://pkg.cfssl.org/deb/debian/ {{ ansible_distribution_release }} /"
    state: present
  loop: "{{ hashicorp_products }}"
  loop_control:
    loop_var: item
  when: ansible_os_family == 'Debian'

- name: Install hashicorp product using package
  yum:
    name: "{{ item }}"
    state: present
  with_items: "{{ hashicorp_products }}"
  when: ansible_os_family in ['RedHat', 'Rocky']
  loop_control:
    loop_var: item
  run_once: true
  delegate_to: localhost

- name: Install latest hashicorp product using package
  yum:
    name: "{{ item }}"
    state: latest
  with_items: "{{ hashicorp_products }}"
  when: item.version is not defined and ansible_os_family in ['RedHat', 'Rocky']
  loop_control:
    loop_var: item
  run_once: true
  delegate_to: localhost

- name: Install versioned hashicorp product using package
  yum:
    name: "{{ item }}"
    state: present
    version: "{{ item.version }}"
  with_items: "{{ hashicorp_products }}"
  when: item.version is defined and ansible_os_family in ['RedHat', 'Rocky']
  loop_control:
    loop_var: item
  run_once: true
  delegate_to: localhost

- name: Install manually
  unarchive:
    src: "{{ hashicorp_src }}"
    dest: "{{ hashicorp_destination }}"
    creates: "{{ hashicorp_destination }}"
    owner: "{{ hashicorp_user }}"
    group: "{{ hashicorp_group }}"
    mode: "{{ hashicorp_mode }}"
    remote_src: true
  with_items: "{{ hashicorp_products }}"
  loop_control:
    loop_var: item
  when: ansible_os_family not in ['RedHat', 'Rocky']
  run_once: true
  delegate_to: localhost

- name: Install hashicorp product manually
  unarchive:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    creates: "{{ item.dest }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
    remote_src: true
  with_items: "{{ hashicorp_products }}"
  loop_control:
    loop_var: item
  when: ansible_os_family not in ['RedHat', 'Rocky']
  run_once: true
  delegate_to: localhost

