    src: forward_rule.conf.j2
    dest: /etc/rsyslog.d/{{ rsyslog_forward_rule_name }}.conf
    mode: "0644"
  when: not rsyslog_deploy_default_config
  notify: Restart rsyslog

- name: Configuring additional config files
  ansible.builtin.copy:
    content: "{{ item.value.content | default('') }}"
    dest: /etc/rsyslog.d/{{ item.key }}.conf
    owner: root
    group: root
    mode: "0440"
    validate: "{{ 'rsyslogd -N1 -f %s' if item.value.validate else 'true %s' }}"
    notify: Restart rsyslog
  when: item.value.state == 'present'
  loop: "{{ rsyslog_rsyslog_d_files | dict2items }}"

- name: Start and enable rsyslog
  ansible.builtin.service:
    name: "{{ rsyslog_service }}"
    state: started
    enabled: true

