---
- name: Java | Check if certificates exists
  stat:
    path: "{{ item.java_cert_path }}"
  register: check_java_certs
  with_items: "{{ java_certs }}"

- name: Java | Fail if some cert doesn't exist
  fail:
    msg: "Certificate path does not exist: {{ item.item.java_cert_path }}"
  when: not item.stat.exists
  with_items: "{{ check_java_certs.results }}"

- name: Java | Setting keystore variables in java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir | default(java_keystore_dir_old) }}"
  when: java_open_jdk_version_major < 11

- name: Java | Setting keystore variables in java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir | default(java_keystore_dir_new) }}"
  when: java_open_jdk_version_major >= 11

- name: Java | Import SSL certificates
  java_cert:
    path: "{{ item.java_cert_path }}"
    keystore: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts"
    keystore_password: "{{ java_cert_keystore_pass }}"
    alias: "{{ item.java_cert_alias }}"
    state: present
    keystore_create: true
  with_items: "{{ java_certs }}"

