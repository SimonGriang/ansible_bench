    mode: "0644"
  loop: "{{ mysql_configuration_options }}"
  notify: Restart mysql server
  loop_control:
    label: "{{ item.option }}"

- name: Configure mysql client
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    mode: "0644"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when:
    - mysql_db_exists is not defined
    - ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    enabled: true
    state: started

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: "0640"

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    target: "{{ item.target | default(mysql_db_target) }}"
    encoding: "{{ item.encoding | default(mysql_db_encoding) }}"
    collation: "{{ item.collation | default(mysql_db_collation) }}"
    login_user: root
    login_host: localhost
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
    force: yes
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined
  no_log: true

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    login_user: root
    login_host: localhost
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
    password: "{{ item.password | default('') }}"
    priv: "{{ item.privileges | default('') }}"
    host_all: "{{ item.host_all | default('') }}"
    update_password: "{{ item.update_password | default('always') }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ mysql_users }}"
  when: mysql_users is defined
  no_log: true

- name: Flush handlers again
  meta: flush_handlers


