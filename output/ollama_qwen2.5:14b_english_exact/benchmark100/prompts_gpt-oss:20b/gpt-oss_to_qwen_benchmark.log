---
- name: lookup bootstrap facts (raw)
  ansible.builtin.raw: cat /etc/os-release
  register: bootstrap_facts
  check_mode: false
  become: false
  changed_when: false

- name: set bootstrap facts (I) # noqa jinja
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.stdout.split('=')[1].strip().strip('"') }}"
    bootstrap_distribution_major_version: "{{ item.stdout.split('=')[1].strip().strip('"') | version('major') }}"
  loop: "{{ lookup('ansible.builtin.dict2items', bootstrap__os_family_map) | map(attribute='value') | flatten }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - item.stdout | regex_search('PRETTY_NAME', '\\b' + bootstrap__search[item] + '\\b', 'any') is not none
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ lookup('ansible.builtin.dict2items', bootstrap__os_family_map) | map(attribute='value') | dict2items }}"
  when: item.value | intersect([bootstrap_distribution]) | list
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

