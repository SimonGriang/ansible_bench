  ansible.builtin.shell: "{{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o json | jq -r '.items | map(select(.status.conditions[] | select(.type==\"Ready\" and .status==\"True\"))) | length'"
