': 1607485044, 'eval_count': 965, 'eval_duration': 21595306715, 'model_name': 'qwen2.5:14b'} id='run--799426f4-f0ef-4948-99cb-0b616c3d16d2-0' usage_metadata={'input_tokens': 2360, 'output_tokens': 965, 'total_tokens': 3325}
