- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ dns_packages }}"

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: "{{ dns_datadir }}", mode: "1770", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }
    - { path: "{{ dns_confdir }}", mode: "0755", owner: "root", group: "root" }
  loop_control:
    label: "{{ item.path }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    system: yes
    state: present

- name: Generate rndc key
  command: "rndc-confgen -a -c {{ dns_confdir }}/rndc.key"
  create: yes
  when: not file_exists(dns_confdir + "/rndc.key")

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"

- name: Get the hints/root file
  get_url:
    url: "https://www.internic.net/domain/named.root"
    dest: "{{ dns_datadir }}/named.root"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns
  register: root_hints
  notify: Rndc reload

- name: Create zone file
  template:
    src: "zone.j2"
    dest: "{{ dns_datadir }}/{{ item.name }}.db"
  loop: "{{ dns_zones | selectattr('type', 'not in', ['secondary', 'stub', 'forward']) | list }}"
  loop_control:
    label: "{{ item.name }}"
  register: zone_files
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: "named.conf.j2"
    dest: "{{ dns_confdir }}/named.conf"
    backup: yes
  register: named_conf
  notify: Restart dns

- name: Place systemd override
  block:
    - file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        state: directory
        mode: "0755"
      when: ansible_service_mgr == 'systemd'

    - copy:
        src: "override.conf"
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
        mode: "0644"
        owner: root
        group: root
      when: ansible_service_mgr == 'systemd'

    - systemd:
        daemon_reload: yes
        changed_when: false
      when: ansible_service_mgr == 'systemd'

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    enabled: yes
    state: started

