  when: (rke2_custom_registry_mirrors|length > 0) or (rke2_custom_registry_configs|length > 0)
  notify: "Config file changed"

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: (rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file|length > 0) and
        ((rke2_service_state|rdefault('disabled')|lower == 'disabled') or (rke2_service_state is not defined))

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: (rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file|length > 0) and
        (rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.access_key is defined and
         rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined)

- name: Restore etcd from file
  block:
    - name: Ensure snapshot directory exists
      file:
        path: "{{ rke2_etcd_snapshot_destination_dir }}"
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Copy snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_source_dir }}/{{ rke2_etcd_snapshot_file }}"
        dest: "{{ rke2_etcd_snapshot_destination_dir }}/{{ rke2_etcd_snapshot_file }}"
        owner: root
        group: root
        mode: '0600'

    - name: Perform etcd restore
      command: >
        rke2 server --cluster-reset --cluster-reset-restore-path="{{ rke2_etcd_snapshot_destination_dir }}/{{ rke2_etcd_snapshot_file }}"
        --token="{{ rke2_token }}"
      when: do_etcd_restore is defined

- name: Restore etcd from s3
  command: >
    rke2 server --cluster-reset --etcd-s3
    --etcd-s3-access-key="{{ rke2_etcd_snapshot_s3_options.access_key }}"
    --etcd-s3-secret-key="{{ rke2_etcd_snapshot_s3_options.secret_key }}"
    --etcd-s3-bucket="{{ rke2_etcd_snapshot_s3_options.bucket }}"
    --etcd-s3-skip-ssl-verify="{{ rke2_etcd_snapshot_s3_options.skip_ssl_verify|d(false) }}"
    --etcd-s3-endpoint="{{ rke2_etcd_snapshot_s3_options.endpoint|d('s3.amazonaws.com') }}"
    --etcd-s3-region="{{ rke2_etcd_snapshot_s3_options.region }}"
    --etcd-s3-endpoint-ca="{{ rke2_etcd_snapshot_s3_options.endpoint_ca|d('') }}"
    --etcd-s3-folder="{{ rke2_etcd_snapshot_s3_options.folder|d('etcd-snapshots') }}"
    --token="{{ rke2_token }}"
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    enabled: yes
    state: started
    environment: RKE2_TOKEN={{ rke2_token }}
  notify: "Service (re)started"

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    enabled: no
    masked: yes

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: "kubectl get node '{{ rke2_node_name }}'"
    search_regex: 'Conditions:\s+.*MemoryOK: true.*DiskPressure: false.*PIDPressure: false.*'
    timeout: 1500
    delay: 15
    retries: 100
  when: rke2_cni == 'none' and not ansible_check_mode

- name: Wait for the first server be ready - with CNI
  shell: >
    kubectl get nodes | grep "{{ rke2_node_name }}" | grep -q " Ready "
  register: node_ready
  until: node_ready.stdout_lines|length > 0
  retries: 40
  delay: 15
  when: rke2_cni != 'none' and not ansible_check_mode

- name: Restore etcd
  block:
    - name: Retrieve node names via kubectl
      shell: >
        kubectl get nodes --no-headers
      register: node_names

    - name: Gather all node names from inventory
      set_fact:
        inventory_node_names: "{{ groups['all'] }}"

    - name: Delete old node-password secrets
      shell: >
        kubectl delete secret {{ item }} --namespace=kube-system
      loop: "{{ node_names.stdout_lines }}"
      when: item not in inventory_node_names

    - name: Delete old node objects
      shell: >
        kubectl delete node {{ item }}
      loop: "{{ node_names.stdout_lines }}"
      when: item not in inventory_node_names

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  delegate_facts: true
  loop: "{{ groups[rke2_cluster_group_name] }}"

