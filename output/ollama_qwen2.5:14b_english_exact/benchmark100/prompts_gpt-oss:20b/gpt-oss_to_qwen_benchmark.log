- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  ansible.builtin.shell: "{{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o json | jq -r '.items | map(select(.status.conditions[] | select(.type=="Ready" and .status=="True"))) | length'"
  register: all_ready_nodes
  delay: 15
  retries: 100
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  run_once: true
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  ansible.builtin.shell: "{{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods --all-namespaces -o json | jq -r 'map(select(.status.phase != "Running" and .status.phase != "Succeeded")) | length'"
  register: all_pods_ready
  delay: 15
  retries: 100
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  run_once: true
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready | default(true)

