---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != "docker"
    - bootstrap_wait_for_host | default(false)

- name: Prepare system
  block:
    - name: Test connection and sudo
      ansible.builtin.wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: connection_test
      changed_when: false
      failed_when: false
    - name: Check sudo availability
      ansible.builtin.command: sudo --version
      register: sudo_test
      changed_when: false
      failed_when: false
    - name: Gather facts and install bootstrap packages
      block:
        - include_tasks: gather_facts.yml
        - name: Install bootstrap packages
          ansible.builtin.raw: "{{ bootstrap_install.raw }}"
          register: bootstrap_install_packages
          stdout_regexp: "{{ bootstrap_install.stdout_regex }}"
      when: connection_test is failed or sudo_test is failed

- name: Gather ansible facts
  ansible.builtin.setup:
  become: false

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ bootstrap_facts_packages | split(' ') }}"
  become: "{{ bootstrap_become }}"

