content='---\n- import_tasks: assert.yml\n\n- name: Install python pip\n  ansible.builtin.package:\n    name: "{{ item }}"\n    state: present\n  loop: "{{ python_pip_packages }}"\n\n- name: Configure pip proxy\n  ansible.builtin.lineinfile:\n    path: /etc/pip.conf\n    line: "index-url = {{ python_pip_proxy }}"\n    create: yes\n    mode: 0644\n  when: python_pip_proxy is defined\n\n- name: Trust hosts\n  ansible.builtin.lineinfile:\n    path: /etc/pip.conf\n    line: "trusted-host = {{ python_pip_trusted_host }}"\n    create: yes\n    mode: 0644\n  when: python_pip_trusted_host is defined\n\n- name: Update pip\n  ansible.builtin.pip:\n    name: "{{ python_pip_pip_package }}"\n    state: "{{ python_pip_pip_state | default(\'latest\') }}"\n    executable: "{{ python_pip_executable }}"\n  when: python_pip_update == True and ansible_distribution_release not in [\'bookworm\', \'noble\'] and ansible_os_family != \'Alpine\'\n\n- name: Install requested modules\n  ansible.builtin.pip:\n    name: "{{ item.name }}"\n    state: "{{ item.state | default(\'present\') }}"\n    version: "{{ item.version }}"\n    executable: "{{ python_pip_executable }}"\n  loop: "{{ python_pip_modules }}"\n  when: ansible_distribution_release not in [\'bookworm\', \'noble\'] and ansible_os_family != \'Alpine\'' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-16T15:00:51.702344712Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5302259286, 'load_duration': 95239285, 'prompt_eval_count': 1218, 'prompt_eval_duration': 112872799, 'eval_count': 332, 'eval_duration': 5080244945, 'model_name': 'qwen2.5:14b'} id='run--a4a9dd96-2059-427a-9b30-80ba4a1bd067-0' usage_metadata={'input_tokens': 1218, 'output_tokens': 332, 'total_tokens': 1550}
