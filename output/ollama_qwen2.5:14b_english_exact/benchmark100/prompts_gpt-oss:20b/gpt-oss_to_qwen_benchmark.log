---
- name: Download RKE2 installation script
  ansible.builtin.get_url:
    url: "{{ rke2_install_bash_url }}"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    timeout: "{{ rke2_artifact_fetch_timeout }}"
  when: rke2_airgap_mode|bool == false

- name: Copy local RKE2 installation script
  ansible.builtin.copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    force: true
  when: rke2_airgap_mode|bool and rke2_airgap_implementation == 'copy'

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifact_path }}"
    state: directory
    mode: 0700
  when: rke2_airgap_mode|bool and rke2_airgap_implementation != 'exists'

- name: Download RKE2 checksum and artifacts (try remote first – fallback to local download and push)
  block:
    - name: Download SHA256 checksum file
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
        mode: 0640
        force: true
    - name: Download RKE2 artifacts
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"
        dest: "{{ rke2_artifact_path }}/{{ item }}"
        mode: 0640
        force: true
        sha256sum: "{{ item }}"
        checksum_file: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
      loop: "{{ rke2_artifact|difference(['sha256sum-{{ rke2_architecture }}.txt']) }}"
    - name: Download RKE2 installation script
      ansible.builtin.get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
        force: true
  rescue:
    - name: Pause for 7 seconds to allow cancellation
      ansible.builtin.pause:
        seconds: 7
    - name: Create local directory for artifacts
      ansible.builtin.file:
        path: "{{ rke2_airgap_copy_sourcepath }}"
        state: directory
        mode: 0750
        owner: "{{ ansible_user_id }}"
    - name: Download SHA256 checksum file locally
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_airgap_copy_sourcepath }}/sha256sum-{{ rke2_architecture }}.txt"
        mode: 0640
    - name: Download artifacts locally
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"
        dest: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        mode: 0640
        force: true
        sha256sum: "{{ item }}"
        checksum_file: "{{ rke2_airgap_copy_sourcepath }}/sha256sum-{{ rke2_architecture }}.txt"
      loop: "{{ rke2_artifact|difference(['sha256sum-{{ rke2_architecture }}.txt']) }}"
    - name: Download RKE2 installation script locally
      ansible.builtin.get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
        mode: 0700
        force: true
    - name: Copy local artifacts to remote
      ansible.builtin.copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        dest: "{{ rke2_artifact_path }}/{{ item }}"
        mode: 0640
        force: true
      loop: "{{ rke2_artifact }}"
    - name: Copy local installation script to remote
      ansible.builtin.copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
        force: true
  when: rke2_airgap_mode|bool and rke2_airgap_implementation == 'download'

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item }}"
    mode: 0640
    force: true
  loop: "{{ rke2_artifact }}"
  when: rke2_airgap_mode|bool and rke2_airgap_implementation == 'copy'

- name: Airgap mode – additional images tarballs
  block:
    - name: Create directory for tarballs
      ansible.builtin.file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: 0700
    - name: Copy additional tarballs
      ansible.builtin.copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"
        mode: 0644
        force: true
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"
  when: rke2_airgap_mode|bool and rke2_airgap_implementation != 'exists' and rke2_airgap_copy_additional_tarballs|length > 0

- name: Airgap mode – ensure artifacts exist and have acceptable permissions
  block:
    - name: Stat artifacts
      ansible.builtin.stat:
        path: "{{ rke2_artifact_path }}/{{ item }}"
      register: artifacts
      loop: "{{ rke2_artifact }}"
    - name: Stat installation script
      ansible.builtin.stat:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
      register: install_script
    - name: Set artifacts_writeable fact
      ansible.builtin.set_fact:
        artifacts_writeable: "{{ artifacts.results|json_query('[].stat.mode')|select('contains', 2)|list|length > 0 }}"
    - name: Change mode for writable artifacts
      ansible.builtin.file:
        path: "{{ rke2_artifact_path }}/{{ item.item }}"
        mode: 0640
        state: file
      loop: "{{ artifacts.results }}"
      when: item.stat.mode|binary|int(2) == 2
    - name: Ensure installation script is executable
      ansible.builtin.file:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
        state: file
      when: install_script.stat.mode|binary|int(2) == 2 and not install_script.stat.mode|binary|int(1000) == 1000
    - name: Fail if installation script is not executable
      ansible.builtin.fail:
        msg: "The script at {{ rke2_install_script_dir }}/rke2.sh must be executable."
      when: install_script.stat.mode|binary|int(2) == 2 and not install_script.stat.mode|binary|int(1000) == 1000
  when: rke2_airgap_mode|bool and rke2_airgap_implementation == 'exists'

- name: Populate service facts
  ansible.builtin.service_facts:

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local
    follow: no
  register: usr_local

- name: Check if separate partition
  ansible.builtin.shell: "grep '/usr/local ' /proc/mounts"
  register: partition_result
  changed_when: false
  failed_when: partition_result.rc > 1

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: "{{ '/usr/local/bin/rke2' if not usr_local.stat.writable or partition_result.rc == 1 else '/opt/rke2/bin/rke2' }}"

- name: Check RKE2 version
  ansible.builtin.shell: >
    set -o pipefail
    if [ -f {{ rke2_bin_path }} ]; then
      {{ rke2_bin_path }} --version
    else
      echo "installed_version: 'not installed'"
    fi
    if systemctl is-active --quiet {{ rke2_service_name }}; then
      pids=$(systemctl show -p MainPID {{ rke2_service_name }} | cut -d'=' -f2)
      readlink -f /proc/$pids/exe
    else
      echo 'running_version: ''not running'
    fi
  register: versions_check
  changed_when: false

- name: Set RKE2 versions
  ansible.builtin.set_fact:
    installed_version: "{{ versions_check.stdout_lines[0] | regex_replace('RKE2 version: ', '') }}"
    running_version: "{{ versions_check.stdout_lines[-1] }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - "rke2_version_clean >= running_version_clean or rke2_allow_downgrade == true"
    fail_message: >
      RKE2 downgrade from {{ running_version_clean }} to {{ rke2_version_clean }} is not allowed.
      Use the 'rke2_allow_downgrade' variable to allow this.
    succeed_message: "RKE2 version check passed."
  when: not ansible_check_mode and rke2_version != 'not installed' and rke2_allow_downgrade != true

- name: Run RKE2 install script
  block:
    - name: Run RKE2 installation script in airgap mode
      ansible.builtin.shell: >
        {{ rke2_install_script_dir }}/rke2.sh install --server --channel={{ rke2_channel }} --artifact-path={{ rke2_artifact_path }}
      environment:
        INSTALL_RKE2_ARTIFACT_PATH: "{{ rke2_artifact_path }}"
        INSTALL_RKE2_AGENT_IMAGES_DIR: "{{ rke2_tarball_images_path }}"
        INSTALL_RKE2_METHOD: "airgap"
      when: rke2_airgap_mode|bool
    - name: Run RKE2 installation script
      ansible.builtin.shell: >
        {{ rke2_install_script_dir }}/rke2.sh install --server --channel={{ rke2_channel }} --version={{ rke2_version }} --channel-url={{ rke2_channel_url }}
      environment:
        INSTALL_RKE2_VERSION: "{{ rke2_version }}"
        INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"
        INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"
        INSTALL_RKE2_METHOD: "auto"
      when: not rke2_airgap_mode|bool
  when: not ansible_check_mode and rke2_version != installed_version

- name: Copy Custom Manifests
  ansible.builtin.template:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/{{ item|basename }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests|length > 0

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/{{ item|basename }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods|length > 0

- name: Copy RKE2 environment file
  ansible.builtin.template:
    src: rke2_environment.j2
    dest: /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: 0644
  when: rke2_environment_options|length > 0

