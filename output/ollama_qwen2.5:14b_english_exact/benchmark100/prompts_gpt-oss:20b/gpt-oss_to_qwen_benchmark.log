---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install required software
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements | default([]) }}"
  when: users_requirements | length > 0

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups | default([]) }}"
  loop_control:
    loop_var: group
    label: "{{ group.name }}"
  when: users_groups is defined

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    regexp: '^#?\s*includedir\s+/etc/sudoers.d\s*$'
    line: 'includedir /etc/sudoers.d'
    validate: 'visudo -cf %s'

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users | default([]) }}"
  loop_control:
    loop_var: user
    label: "{{ user.name }}"
  when: users is defined

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow | default(false)

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow | default(false) | not

