---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  ansible.builtin.package:
    name: "{{ item }}"
  with_items: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Manage selinux
  ansible.posix.selinux:
    policy: "{{ selinux_policy }}"
    state: "{{ selinux_state }}"
  when: ansible_selinux.status is defined and not ansible_facts.docker
  notify: Reboot

- name: Manage selinux booleans
  ansible.posix.seboolean:
    name: "{{ item.0 }}"
    state: "{{ item.1.state | default('yes') }}"
    persistent: "{{ item.1.persistent | default(True) }}"
  with_subelements:
    - "{{ selinux_booleans }}"
    - booleans
  when: selinux_booleans is defined


