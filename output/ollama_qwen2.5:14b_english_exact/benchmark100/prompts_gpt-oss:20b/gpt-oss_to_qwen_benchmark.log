---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.raw: cat /etc/os-release
  register: bootstrap_facts
  become: false
  check_mode: false
  changed_when: false

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: "{% if bootstrap_facts.stdout_lines is defined and bootstrap_facts.stdout_lines is not empty %}{% for line in bootstrap_facts.stdout_lines.split('\n') %}{% if line.startswith('VERSION_ID=') %}{% set version_id = line.split('=')[1].strip().split('.')[0] %}{% if version_id.isdigit() %}{{ version_id }}{% else %}NA{% endif %}{% endif %}{% endfor %}{% else %}NA{% endif %}"
  with_flattened:
    - "{{ dict2items(bootstrap_os_family_map | map(attribute='value') | flatten) }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout_lines is search("PRETTY_NAME=" ~ (bootstrap_search[item] | default(item)))

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  with_dict2items:
    bootstrap_os_family_map
  when: bootstrap_distribution in item.value

