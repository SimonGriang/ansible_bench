---
- name: Get python3 version installed on Debian12
  ansible.builtin.command: python3 --version
  register: py3ver
  changed_when: false
  tags:
    - molecule-notest

- name: Remove EXTERNALLY-MANAGED file on Debian12
  ansible.builtin.file:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
    state: absent
  when: py3ver.stdout is defined and py3ver.stdout.find('3.11') != -1
  tags:
    - molecule-notest

