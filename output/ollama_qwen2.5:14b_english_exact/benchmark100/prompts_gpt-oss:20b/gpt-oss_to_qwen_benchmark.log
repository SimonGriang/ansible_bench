---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install mysql
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_packages }}"
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  community.general.ini_file:
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
  loop: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  community.general.ini_file:
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    option: socket
    value: "{{ mysql_socket }}"
    section: client
  notify: Restart mysql server

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/mysql
  when: ansible_facts.distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    enabled: yes
    state: started

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.database }}"
    state: "{{ item.state }}"
    target: "{{ item.target }}"
    encoding: "{{ item.encoding }}"
    collation: "{{ item.collation }}"
    login_user: root
    login_host: localhost
    login_port: "{{ mysql_port }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
    initial_import: "{{ item.initial_import }}"
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined
  when: item.initial_import is not defined
  no_log: true

- name: List databases
  community.mysql.mysql_info:
    filter: databases
    login_user: root
    login_host: localhost
    login_port: "{{ mysql_port }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
  register: mysql_info
  no_log: true

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item.database }}"
    initial_import: "{{ item.initial_import }}"
    state: import
    target: "{{ item.target }}"
    login_user: root
    login_host: localhost
    login_port: "{{ mysql_port }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import is defined and item.database not in mysql_info.databases
  no_log: true

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.username }}"
    password: "{{ item.password }}"
    host: "{{ item.host }}"
    priv: "{{ item.privileges }}"
    login_user: root
    login_host: localhost
    login_port: "{{ mysql_port }}"
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"
  when: mysql_users is defined
  no_log: true

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

