---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install cron
  package:
    name: "{{ item }}"
  loop: "{{ cron_packages }}"
  notify: Restart cron

- name: Configure shell
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    create: yes
    state: present
    mode: 0600
  notify: Restart cron

- name: Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    create: yes
    state: present
    mode: 0600
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    state: present
    mode: 0600
  notify: Restart cron

- name: Start and enable cron
  when: cron_service is defined and cron_service != ""
  service:
    name: "{{ cron_service }}"
    enabled: yes
    state: started

- name: Schedule requested cron jobs
  when: cron_jobs is defined
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default('present') }}"
    user: "{{ item.user | default('root') }}"
  with_items: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"

