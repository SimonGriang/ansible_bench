  register: bootstrap_facts
  check_mode: false
  changed_when: false

- name: Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ bootstrap_os_family_map[item] }}"
    bootstrap_distribution_major_version: "{{ ((bootstrap_facts.stdout_lines | join('\n')) | regex_search('^.*VERSION_ID=\"(\\d{1,2})(\\.\\d{1,4})*?\".*$', '\\1')) | default('NA') }}"
  with_flattened:
    - "{{ bootstrap_os_family_map }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - (bootstrap_facts.stdout_lines | join('\n')).match("PRETTY_NAME=.*{{ bootstrap_search[item] | default(item) }}.*")

- name: Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.0 }}"
  loop: "{{ bootstrap_os_family_map.items() }}"
  when: "{{ bootstrap_distribution }} in item.1 "
  loop_control:
    label: "{{ item.0 }}"

