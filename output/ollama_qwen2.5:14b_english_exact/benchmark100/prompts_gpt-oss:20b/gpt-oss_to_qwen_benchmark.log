rvice_template_file }}"\n    dest: /etc/systemd/system/{{ promtail_systemd_service }}.service\n    mode: 0644\n    notify: Restart promtail' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-16T14:53:24.152586436Z', 'done': True, 'done_reason': 'stop', 'total_duration': 25285038382, 'load_duration': 95822313, 'prompt_eval_count': 2747, 'prompt_eval_duration': 865395998, 'eval_count': 1070, 'eval_duration': 24305503104, 'model_name': 'qwen2.5:14b'} id='run--d9bbbc69-dbd4-4698-bb72-a34617eb039f-0' usage_metadata={'input_tokens': 2747, 'output_tokens': 1070, 'total_tokens': 3817}
