---
- name: Task 1: check if all variables have been set correctly
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Task 2: wait for host (when configured)
  wait_for:
    port: "{{ bootstrap_ssh_port | default(22) }}"
    delay: 5
    timeout: "{{ bootstrap_timeout }}"
    state: started
  when:
    - bootstrap_wait_for_host | default(true)
    - ansible_connection != 'docker'
    - ansible_connection != 'container'

- name: Task 3: prepare system
  block:
    - name: Test the connection to the host
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: connection_test
      changed_when: false
  rescue:
    - name: Connection test failed
      debug:
        msg: "Connection timeout is {{ bootstrap_timeout }}"
      changed_when: true
  always:
    - name: Include gather facts
      include_tasks: gather_facts.yml

    - name: Execute raw command
      shell: "{{ lookup('file', 'bootstrap_install.raw') }}"
      args:
        executable: /bin/sh
      register: raw_command_result
      changed_when: "((raw_command_result.stdout.find('changed') >= 0 if ansible_facts['os_family'] == 'RedHat' else raw_command_result.stdout.find('updated') >= 0 if ansible_facts['os_family'] == 'Debian' else False))"
      become: "{{ bootstrap_become }}"
      become_user: "{{ bootstrap_become_user | default('root') }}"

- name: Task 4: ensure system is prepared by issuing ansible modules.
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user | default('root') }}"
  block:
    - name: Gather ansible facts
      setup:

    - name: Install bootstrap packages
      package:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ bootstrap__facts_packages }}"
      when: bootstrap__facts_packages is defined

