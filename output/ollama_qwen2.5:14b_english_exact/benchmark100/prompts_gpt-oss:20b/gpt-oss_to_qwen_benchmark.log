---
- name: Create local ssh_key_directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ users_ssh_key_directory }}"
    state: directory
    mode: 0750
  delegate_to: localhost
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Manage user {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    comment: "{{ user.comment }}"
    create_home: "{{ user.create_home }}"
    password: "{{ user.password }}"
    uid: "{{ user.uid }}"
    group: "{{ user.group }}"
    groups: "{{ user.groups }}"
    shell: "{{ user.shell }}"
    state: "{{ user.state | default('present') }}"
  register: users_manage_user

- name: Set sudo options for {{ user.name }}
  ansible.builtin.template:
    src: sudo.j2
    dest: /etc/sudoers.d/{{ user.name | replace(".", "dot") }}
    mode: 0640
  when: user.sudo_options is defined

- name: Remove sudo options for {{ user.name }}
  ansible.builtin.file:
    path: /etc/sudoers.d/{{ user.name | replace(".", "dot") }}
    state: absent
  when: user.sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  ansible.builtin.command: "{{ users_ssh_keygen_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}"
  delegate_to: localhost
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Generate public ssh key for {{ user.name }}
  ansible.builtin.command: "{{ users_ssh_keygen_pubkey_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}.pub"
  delegate_to: localhost
  when: user.manage_ssh_key is true

- name: Convert ssh key to ppk for {{ user.name }}
  ansible.builtin.command: ssh-keygen -p -f "{{ users_ssh_key_directory }}/{{ user.name }}" -m PKCS8 -e -P '' -N ''
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}.ppk"
  delegate_to: localhost
  when: user.manage_ssh_key is true

- name: Get or set the home directory for {{ user.name }}
  ansible.builtin.command: getent passwd {{ user.name }} | awk -F: '{print $6}'
  register: home_directory
  changed_when: false
  failed_when: false
  when: users_home_base_dir is not defined

- name: Create .ssh directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ users_home_base_dir }}/{{ user.name }}/.ssh"
    state: directory
    mode: 0700
  when: user.manage_ssh_key or user.private_keys is defined
  become_user: "{{ user.name }}"

- name: Deploy authorized keys for {{ user.name }}
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  with_items: "{{ user.authorized_keys }}"
  when: user.authorized_keys is defined
  args:
    key_options: ['command="echo \'SSH authentication is disabled for this account.\'",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty']

- name: Remove unauthorized keys for {{ user.name }}
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  with_items: "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys is defined
  args:
    key_options: ['command="echo \'SSH authentication is disabled for this account.\'",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty']

- name: Copy generated private ssh key for {{ user.name }}
  ansible.builtin.copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}"
    dest: "{{ users_home_base_dir }}/{{ user.name }}/.ssh/id_rsa"
    mode: 0400
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: users_manage_user is defined and user.copy_private_key is true

- name: Check users password valid time for {{ user.name }}
  ansible.builtin.command: awk -F: '{print $3}' /etc/shadow
  register: users_pw_valid
  changed_when: false
  failed_when: false
  when: users_manage_user is defined and user.state != 'absent'

- name: Set users password valid time for {{ user.name }}
  ansible.builtin.command: chage -M {{ user.password_validity_days }} {{ user.name }}
  when: users_pw_valid is defined and users_pw_valid.stdout is not equal to user.password_validity_days

- name: Place private key file for {{ user.name }}
  ansible.builtin.copy:
    content: "{{ item.content }}"
    dest: "{{ users_home_base_dir }}/{{ user.name }}/.ssh/{{ item.name }}"
    mode: 0400
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  with_items: "{{ user.private_keys }}"
  when: user.private_keys is defined


