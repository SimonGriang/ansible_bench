---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Set SELinux booleans
      ansible.builtin.seboolean:
        name: "{{ item }}"
        value: true
        persistent: true
      when: ansible_facts['os_family'] == 'RedHat' and item is defined
      loop: "{{ httpd_sebooleans }}"
      when: "'{{ item }}' in {{ lookup('ansible.builtin.command', 'getenforce') }}"
      loop_control:
        loop_var: item

    - name: Allow connections to httpd_port
      ansible.builtin.seport:
        port: "{{ httpd_port }}"
        proto: tcp
        setype: httpd_t
        setype: http_port_t
        state: present
      when: "'{{ httpd_port }}' is defined"

    - name: Allow connections to httpd_ssl_port
      ansible.builtin.seport:
        port: "{{ httpd_ssl_port }}"
        proto: tcp
        setype: httpd_t
        setype: https_port_t
        state: present
      when: "'{{ httpd_ssl_port }}' is defined"

- name: Configure httpd
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
    notify: Test httpd configuration validity
  notify: Restart httpd

- name: Activate httpd module | Debian
  ansible.builtin.command: a2enmod "{{ item }}"
  args:
    creates: /etc/apache2/mods-available/{{ item }}.load
  loop: "{{ httpd_modules_to_activate_with_command }}"
  register: module_activation_result
  when: ansible_facts['os_family'] == 'Debian'
  changed_when: "'already enabled' not in module_activation_result.results[0].stderr"
  notify: Test httpd configuration validity

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}.j2"
    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
    mode: '0644'
    notify: Test httpd configuration validity
  notify: Restart httpd
  when: ansible_facts['os_family'] in ['Debian', 'Suse']

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  ansible.builtin.file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes

