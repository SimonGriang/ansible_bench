---
- name: Create docroot
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - create_docroot is not defined or create_docroot|bool
  with_items: "{{ httpd_vhosts }}"

- name: Configure vhosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: 0644
  notify: Test httpd configuration validity
  notify: Restart httpd
  with_items: "{{ httpd_vhosts }}"

