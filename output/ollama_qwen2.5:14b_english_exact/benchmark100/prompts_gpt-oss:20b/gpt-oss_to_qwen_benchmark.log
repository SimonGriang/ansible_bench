    state: present
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM
  when: java_source == "local" and java_format == "rpm"
  block:
    - name: Copy the Java RPM file to /tmp
      copy:
        src: "{{ java_package }}"
        dest: "/tmp/{{ java_package }}"
        mode: "0640"
    - name: Install the copied RPM file
      package:
        name: "/tmp/{{ java_package }}"
        state: present

- name: Install DEB
  when: java_source == "local" and java_format == "deb"
  block:
    - name: Copy the Java DEB file to /tmp
      copy:
        src: "{{ java_package }}"
        dest: "/tmp/{{ java_package }}"
        mode: "0640"
    - name: Install the copied DEB file
      apt:
        deb: "/tmp/{{ java_package }}"
        state: present

- name: Install oracle java (rpm) (repository)
  when: java_source == "repository" and java_format == "rpm"
  package:
    name: "{{ java_oracle_package }}"
    state: present

- name: Configure oracle targz
  when: java_format == "targz" and java_vendor == "oracle"
  block:
    - name: Ensure java_install_directory exists
      file:
        path: "{{ java_install_directory }}"
        state: directory
        mode: "0755"
    - name: Unarchive the Oracle Java package
      unarchive:
        src: "{{ java_oracle_package }}"
        dest: "{{ java_install_directory }}"
        creates: "{{ java_install_directory }}/{{ java_oracle_directory }}"
        mode: "0755"

- name: Install oracle java policy software (targz)
  when: java_jce == true and java_version == 8 and java_vendor == "oracle"
  unarchive:
    src: "{{ jce_policy_dir }}/jce_policy-8.zip"
    dest: "{{ java_install_directory }}"
    mode: "0755"

- name: Set alternative (targz)
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"
  command: ln -sf "{{ java_install_directory }}/{{ java_oracle_directory }}/bin/java" /usr/bin/java
  args:
    creates: /usr/bin/java

- name: Find JAVA_HOME
  command: readlink -f $(which java) | sed 's#/bin/java$##'
  register: java_home
  check_mode: true
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
