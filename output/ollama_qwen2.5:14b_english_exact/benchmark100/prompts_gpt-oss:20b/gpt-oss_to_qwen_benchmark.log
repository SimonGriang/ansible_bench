---
- import_tasks: ansible.builtin.import_tasks
  delegate_to: localhost

- name: Install cron
  ansible.builtin.package:
    name: "{{ item }}"
  loop: "{{ cron_packages }}"
  notify: Restart cron

- name: Configure shell
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    create: true
    state: present
    mode: '0600'
  notify: Restart cron

- name: Configure path
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    create: true
    state: present
    mode: '0600'
  notify: Restart cron

- name: Configure mailto
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    create: true
    state: present
    mode: '0600'
  notify: Restart cron

- name: Start and enable cron
  when: cron_service is defined and cron_service != ""
  ansible.builtin.service:
    name: "{{ cron_service }}"
    enabled: true
    state: started

- name: Schedule requested cron jobs
  when: cron_jobs is defined
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default('present') }}"
    user: "{{ item.user | default('root') }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"


