---
- name: Cordon and Drain the node {{ rke2_node_name }}
  shell: >
    /bin/bash -c "set -o pipefail; {{ rke2_data_path }}/bin/kubectl cordon {{ rke2_node_name }} --kubeconfig /etc/rancher/rke2/rke2.yaml; {{ rke2_data_path }}/bin/kubectl drain {{ rke2_node_name }} --kubeconfig /etc/rancher/rke2/rke2.yaml {{ rke2_drain_additional_args }} --ignore-daemonsets --delete-local-data --force --timeout=5m"
  register: drain
  retries: 100
  delay: 15
  until: "'drained' in drain.stdout"
  run_once: true
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  when: rke2_drain_node_during_upgrade

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: >
    /bin/bash -c "{{ rke2_data_path }}/bin/kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name} {.status.conditions[?(@.type=="Ready")].status}{'\n'}{end}' | grep ' Ready' | wc -l"
  register: all_ready_nodes
  retries: 100
  delay: 15
  until: all_ready_nodes.stdout | int == groups[rke2_cluster_group_name].count
  run_once: true
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

- name: Uncordon the node {{ rke2_node_name }}
  shell: >
    /bin/bash -c "set -o pipefail; {{ rke2_data_path }}/bin/kubectl uncordon {{ rke2_node_name }} --kubeconfig /etc/rancher/rke2/rke2.yaml"
  register: uncordon
  run_once: true
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  shell: >
    /bin/bash -c "{{ rke2_data_path }}/bin/kubectl get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded --ignore-not-found | wc -l"
  register: all_pods_ready
  retries: 100
  delay: 15
  until: all_pods_ready.stdout | int == 0
  run_once: true
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  shell: >
    /bin/bash -c "{{ rke2_data_path }}/bin/kubectl wait --for=condition=ready --timeout=5m {{ rke2_wait_for_all_pods_to_be_healthy_args }}"
  register: all_pods_healthy
  retries: 100
  delay: 15
  until: not all_pods_healthy.changed
  run_once: true
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  when: rke2_wait_for_all_pods_to_be_healthy


