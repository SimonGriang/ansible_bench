---
- ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost
  name: Import assert.yml

- name: Configure apk
  when: ansible_pkg_mgr == "apk"
  block:
    - name: Update apk cache
      community.general.apk:
        update_cache: true
        cacheonly: false
      notify: Reboot
    - name: Upgrade all packages
      community.general.apk:
        upgrade: true
      notify: Reboot

- name: Configure apt
  when: ansible_pkg_mgr == "apt"
  block:
    - name: Hold selected packages
      ansible.builtin.dpkg_selections:
        package: "{{ item }}"
        selection: hold
      loop: "{{ update_excluded_packages }}"
    - name: Update all packages
      ansible.builtin.apt:
        update_cache: true
        upgrade: "{{ update_upgrade_command }}"
        cache_valid_time: "{{ update_cache_valid_time }}"
      environment:
        DEBIAN_FRONTEND: noninteractive
      notify: Reboot
    - name: Autoremove packages
      ansible.builtin.apt:
        autoremove: "{{ update_autoremove }}"
      when: update_autoremove | bool
      notify: Reboot

- name: Update all software (dnf)
  when: ansible_pkg_mgr in ["dnf", "dnf5"]
  ansible.builtin.dnf:
    name: "*"
    state: present
    exclude: "{{ update_excluded_packages }}"
  notify: Reboot

- name: Update all software (pacman)
  when: ansible_pkg_mgr == "pacman"
  community.general.pacman:
    update_cache: true
    upgrade: true
  notify: Reboot

- name: Configure yum
  when: ansible_pkg_mgr == "yum"
  block:
    - name: Upgrade all packages for RHEL/CentOS 6
      when: ansible_distribution_major_version == "6"
      ansible.builtin.dnf:
        name: "*"
        state: present
        exclude: "{{ update_excluded_packages }}"
      notify: Reboot
    - name: Upgrade all packages for other major versions
      ansible.builtin.dnf:
        name: "*"
        state: present
        exclude: "{{ update_excluded_packages }}"
      notify: Reboot
    - name: Install yum-utils package
      ansible.builtin.package:
        name: yum-utils
      when: ansible_distribution_major_version != "6"

- name: Update all software (zypper)
  when: ansible_pkg_mgr == "zypper"
  community.general.zypper:
    name: "*"
    state: present
  notify: Reboot

