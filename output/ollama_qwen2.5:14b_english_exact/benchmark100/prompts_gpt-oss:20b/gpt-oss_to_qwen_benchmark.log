---
- name: Ensure unzip package is available
  package:
    name: unzip
    state: present
    update_cache: "{{ promtail_apt_update_cache | bool }}"

- name: Create promtail group
  group:
    name: "{{ promtail_system_group }}"
    state: present
  when: promtail_system_group != "root"

- name: Create the promtail user
  user:
    name: "{{ promtail_system_user }}"
    uid: "{{ promtail_system_user_uid }}"
    group: "{{ promtail_system_group }}"
    groups: "{{ promtail_user_additional_groups }}"
    system: true
    create_home: no
    shell: /usr/sbin/nologin
    state: present
  when: promtail_system_user != "root"

- name: Ensure /usr/local/bin exists
  file:
    path: /usr/local/bin
    state: directory
    mode: 0755

- name: Create config directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0770
    owner: root
    group: "{{ promtail_system_group }}"
  loop:
    - "{{ promtail_config_dir }}"
    - "{{ promtail_config_file_sd_dir }}"
    - "{{ promtail_positions_directory }}"

- name: Create application dirs
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
  with_items:
    - "{{ promtail_install_dir }}"
    - "{{ promtail_install_dir }}/{{ promtail_version }}"

- name: Check promtail binary
  stat:
    path: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail-linux-{{ go_arch }}"
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_dist_url }}"
    dest: /tmp/promtail-linux-{{ go_arch }}-{{ promtail_version }}.zip
    force_basic_auth: yes
    checksum: "{{ promtail_custom_checksum | default(__promtail_checksum) }}"
  when: not promtail_binary.stat.exists and not promtail_binary_local_dir and not promtail_propagation

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_binary_local_dir }}/promtail-linux-{{ go_arch }}-{{ promtail_version }}.zip"
    dest: /tmp/promtail-linux-{{ go_arch }}-{{ promtail_version }}.zip
    mode: 0755
    owner: root
    group: root
  when: not promtail_binary.stat.exists and promtail_binary_local_dir and not promtail_propagation

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_dist_url }}"
    dest: /tmp/promtail-linux-{{ go_arch }}-{{ promtail_version }}.zip
    force_basic_auth: yes
    checksum: "{{ promtail_custom_checksum | default(__promtail_checksum) }}"
    delegate_to: localhost
    run_once: yes
  when: promtail_propagation

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail-linux-{{ go_arch }}-{{ promtail_version }}.zip
    dest: /tmp/promtail-linux-{{ go_arch }}-{{ promtail_version }}.zip
    mode: 0755
  when: promtail_propagation

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail-linux-{{ go_arch }}-{{ promtail_version }}.zip
    dest: "{{ promtail_install_dir }}/{{ promtail_version }}"
    remote_src: yes
    creates: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail-linux-{{ go_arch }}"
    mode: 0755
    no_errors: yes
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
  when: not promtail_binary.stat.exists

- name: Create symlink to latest version
  file:
    src: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail-linux-{{ go_arch }}"
    dest: /usr/local/bin/promtail
    state: link
    mode: 0755
    notify: Restart promtail
  when: not promtail_binary.stat.exists
  no_errors: yes

- name: Write config
  template:
    src: config.j2
    dest: "{{ promtail_config_file }}"
    owner: root
    group: "{{ promtail_system_group }}"
    mode: 0644
    validate: /usr/local/bin/promtail -config.file %s -check-syntax
    notify: Restart promtail

- name: Create systemd service unit
  template:
    src: "{{ promtail_systemd_service_template_file }}"
    dest: /etc/systemd/system/{{ promtail_systemd_service }}.service
    mode: 0644
    notify: Restart promtail

