---
- name: Assert usage of systemd as an init system
  assert:
    that: ansible_service_mgr == "systemd"
    fail_msg: "This module only works with systemd"

- name: Get latest release
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: true
    status_code: 200
    body_format: json
    validate_certs: false
    headers:
      Authorization: "token {{ GH_TOKEN | default('') }}"
  register: _latest_release
  retries: 5
  delay: 2

- name: Set promtail version to {{ _latest_release.json.tag_name[1:] }}
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
  when: promtail_version == "latest"
  delegate_to: localhost
  run_once: true

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/{{ promtail_version }}_promtail-linux-{{ go_arch }}.zip"
  register: promtail_binary_local_archive
  when: promtail_binary_local_dir is defined and promtail_binary_local_dir != ""
  delegate_to: localhost
  run_once: true

- name: Assert local binary exists
  assert:
    that:
      - promtail_binary_local_archive.stat.exists
    fail_msg: "When using 'promtail_binary_local_dir' please ensure that the binary exists"
  when: promtail_binary_local_dir is defined and promtail_binary_local_dir != ""

- name: Get checksum list
  set_fact:
    __promtail_checksums: "{{ lookup('url', 'https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/SHA256SUMS', wantlist=True) }}"
  when: promtail_binary_local_dir == ""
  delegate_to: localhost
  run_once: true

- name: Get checksum for {{ go_arch }} architecture
  set_fact:
    __promtail_checksum: "{{ item.split(' ')[0] }}"
  with_items: "{{ __promtail_checksums }}"
  when: promtail_binary_local_dir == ""
  when: item | regex_search('promtail-linux-' + go_arch + '.zip')
  delegate_to: localhost
  run_once: true

