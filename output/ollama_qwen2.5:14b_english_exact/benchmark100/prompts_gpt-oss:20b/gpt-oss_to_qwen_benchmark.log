---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  with_items: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Configure selinux
  block:
    - name: Set selinux state and policy
      ansible.posix.selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Manage selinux booleans
      ansible.builtin.set_fact:
        boolean_state: "{{ item.state | default('yes') }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.name }}"
      when: selinux_booleans is defined
      register: boolean_states

    - name: Apply selinux boolean states
      ansible.posix.selinux_boolean:
        name: "{{ item.item.name }}"
        state: "{{ item.boolean_state }}"
        persistent: "{{ item.item.persistent | default(true) }}"
      loop: "{{ boolean_states.results }}"
      when: selinux_booleans is defined
  when: ansible_selinux.status is defined and not (ansible_facts['container'] or ansible_facts['docker'])

