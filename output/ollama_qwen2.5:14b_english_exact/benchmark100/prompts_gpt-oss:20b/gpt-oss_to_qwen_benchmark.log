content='---\n- import_tasks: assert.yml\n  loop_control:\n    extended: true\n  delegate_to: localhost\n  run_once: true\n\n- name: Install prerequisites\n  package:\n    name: "{{ vault_prerequisites }}"\n    state: present\n\n- name: Include installation method specific tasks\n  include_tasks: "{{ vault_installation_method }}.yml"\n\n- name: Add Vault environment variables\n  lineinfile:\n    path: /etc/vault.d/vault.env\n    create: yes\n    line: "{{ item.name }}={{ item.value }}"\n    regexp: "{{ item.name }}="\n    mode: 0644\n  loop: "{{ vault_environment_settings }}"\n  notify: Restart vault\n\n- name: Include hardening tasks\n  include_tasks: hardening.yml\n\n- name: Start and enable vault\n  service:\n    name: vault\n    state: started\n    enabled: yes\n  when: vault_type == "oss"\n\n- name: Enable vault\n  service:\n    name: vault\n    enabled: yes\n  when: vault_type != "oss"' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-16T14:09:42.633499532Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4625056132, 'load_duration': 85986190, 'prompt_eval_count': 576, 'prompt_eval_duration': 344253974, 'eval_count': 225, 'eval_duration': 4184110097, 'model_name': 'qwen2.5:14b'} id='run--cca57f0f-f54b-4044-af05-967b6bb96e9d-0' usage_metadata={'input_tokens': 576, 'output_tokens': 225, 'total_tokens': 801}
