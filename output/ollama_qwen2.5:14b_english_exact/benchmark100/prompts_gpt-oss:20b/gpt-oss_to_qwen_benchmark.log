---
- import_tasks: assert.yml

- name: Install python pip
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_packages }}"

- name: Configure pip proxy
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "index-url = {{ python_pip_proxy }}"
    create: yes
    mode: '0644'
  when: python_pip_proxy is defined

- name: Trust hosts
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    create: yes
    mode: '0644'
  when: python_pip_trusted_host is defined

- name: Update pip
  ansible.builtin.pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state | default('latest') }}"
    executable: "{{ python_pip_executable }}"
  when: python_pip_update == true and ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  when: ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'


