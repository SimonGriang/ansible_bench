---
- import_tasks: assert.yml

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: "No configuration"
    vtype: select
  when: ansible_facts['os_family'] == 'Debian'

- name: Install postfix
  ansible.builtin.apt:
    name: postfix
    state: present
  when: ansible_facts['os_family'] == 'Debian'

- name: Install postfix-mysql
  ansible.builtin.apt:
    name: postfix-mysql
    state: present
  when: "'mysql' in postfix_virtual_mailbox_maps or 'mysql' in postfix_virtual_mailbox_domains or 'mysql' in postix_virtual_alias_maps"

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport
    mode: 0644
  notify: Validate configuration
  notify: Rebuild transport_maps database
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
    mode: 0644
  notify: Validate configuration
  notify: Reload postfix
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf (1/2)
  ansible.builtin.set_fact:
    _postfix_smtpd_recipient_restrictions_check_recipient_access: "{{ 'hash:/etc/postfix/recipient_access' if postfix_recipient_access is defined else 'none' }}"
    _postfix_smtpd_sender_restrictions_check_sender_access: "{{ 'hash:/etc/postfix/sender_access' if postfix_sender_access is defined else 'none' }}"

- name: Setting values for main.cf (2/2)
  ansible.builtin.set_fact:
    _postfix_mynetworks: "{{ postfix_mynetworks | default('127.0.0.1/32, 10.0.0.0/8') }}"
    _postfix_mydestination: "{{ postfix_mydestination | default('localhost') }}"
    _postfix_relay_domains: "{{ postfix_relay_domains | default('') }}"
    _postfix_smtpd_recipient_restrictions: "{{ _postfix_smtpd_recipient_restrictions_check_recipient_access | default('') }}"
    _postfix_smtpd_sender_restrictions: "{{ _postfix_smtpd_sender_restrictions_check_sender_access | default('') }}"
    _postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default('') }}"
    _postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains | default('') }}"

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 0644
  notify: Validate configuration
  notify: Restart postfix

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: 0644
  notify: Validate configuration
  notify: Restart postfix

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ postfix_smtpd_tls_cert_file | dirname }}"
    state: directory
    mode: 0700
  when: postfix_smtpd_tls_cert_file is defined and postfix_smtpd_tls_key_file is defined and postfix_smtpd_tls_cert_file_source is defined and postfix_smtpd_tls_key_file_source is defined

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: 0600
  notify: Reload postfix
  when: postfix_smtpd_tls_cert_file_source is defined

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: 0600
  notify: Reload postfix
  when: postfix_smtpd_tls_key_file_source is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure aliases
  ansible.builtin.lineinfile:
    path: "{{ postfix_alias_path }}"
    line: "{{ item.name }}: {{ item.destination }}"
    create: yes
    mode: 0644
