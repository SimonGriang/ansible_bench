---
- name: Install epel
  yum:
    name: epel-release
    state: present
  when: >
    (ansible_os_family == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9', '10']) or
    (ansible_os_family == 'Amazon' and ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2')

- name: Install epel gpg key
  rpm_key:
    key: "{{ epel_gpg_key }}"

- name: Install epel-release
  yum:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Install epel-next-release
  yum:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next | default(false)
  notify: Update package cache


