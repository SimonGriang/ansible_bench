---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  when: java_vendor == "openjdk"
  package:
    name: "{{ java_openjdk_package }}"
    state: present
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM
  when: java_source == "local" and java_format == "rpm"
  copy:
    src: "{{ java_package }}"
    dest: "/tmp/{{ java_package }}"
    remote_src: yes
  notify: Install RPM

- name: Install DEB
  when: java_source == "local" and java_format == "deb"
  copy:
    src: "{{ java_package }}"
    dest: "/tmp/{{ java_package }}"
    remote_src: yes
  notify: Install DEB

- name: Install oracle java (rpm) (repository)
  when: java_source == "repository" and java_format == "rpm"
  package:
    name: "{{ java_oracle_package }}"
    state: present

- name: Configure oracle targz
  when: java_format == "targz" and java_vendor == "oracle"
  block:
    - name: Ensure java_install_directory exists
      file:
        path: "{{ java_install_directory }}"
        state: directory

    - name: Unarchive java package
      unarchive:
        src: "{{ java_oracle_package }}"
        dest: "{{ java_install_directory }}"
        remote_src: yes

- name: Install oracle java policy software (targz)
  when: java_jce == true and java_version == 8 and java_vendor == "oracle"
  unarchive:
    src: "jce_policy-8.zip"
    dest: "{{ java_install_directory }}"
    remote_src: yes

- name: Set alternative (targz)
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"
  command: "{{ ansible_basedir }}/alternatives --install /usr/bin/java java {{ java_install_directory }}/bin/java 100 --slave /usr/bin/keytool keytool {{ java_install_directory }}/bin/keytool --slave /usr/bin/orbd orbd {{ java_install_directory }}/bin/orbd --slave /usr/bin/policytool policytool {{ java_install_directory }}/bin/policytool --slave /usr/bin/rmic rmic {{ java_install_directory }}/bin/rmic --slave /usr/bin/rmiregistry rmiregistry {{ java_install_directory }}/bin/rmiregistry --slave /usr/bin/servertool servertool {{ java_install_directory }}/bin/servertool --slave /usr/bin/tnameserv tnameserv {{ java_install_directory }}/bin/tnameserv --slave /usr/bin/unix2dll unix2dll {{ java_install_directory }}/bin/unix2dll --slave /usr/bin/wsgen wsgen {{ java_install_directory }}/bin/wsgen --slave /usr/bin/wsimport wsimport {{ java_install_directory }}/bin/wsimport --slave /usr/bin/wsgen wsgen {{ java_install_directory }}/bin/wsgen --slave /usr/bin/xjc xjc {{ java_install_directory }}/bin/xjc

- name: Find JAVA_HOME
  command: readlink -f `which java` | sed 's%/bin/java%%'
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  copy:
    dest: /etc/profile.d/java_home.sh
    content: export JAVA_HOME={{ java_home_result.stdout }}
    mode: '0755'
  when: not ansible_facts.filesystem.files['/etc/profile.d/java_home.sh']

