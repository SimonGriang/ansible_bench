---
- name: lookup bootstrap facts (raw)
  raw: lsb_release -a
  register: bootstrap_facts
  check_mode: false
  become: false

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value }}.{{ bootstrap_facts.stdout_lines[item.key] | regex_replace('([0-9]+\\.[0-9]+).*', '\\1') }}"
  loop: "{{ lookup('dict', {'redhat': 'PRETTY_NAME', 'ubuntu': 'DISTRIB_ID', 'debian': 'PRETTY_NAME'}) }}"
  when:
    - bootstrap_facts is defined
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout_lines[item.key] is defined
    - bootstrap_facts.stdout_lines[item.key] is match('.*redhat.*')"
  become: "{{ 'bootstrap_become' in ansible_facts | dict2items }} and ansible_facts.bootstrap_become | bool "
  become_user: "{{ 'bootstrap_become_user' in ansible_facts | dict2items and ansible_facts.bootstrap_become_user | bool }}"
  loop_control:
    extended: true

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  loop: "{{ lookup('dict', {'rhel': 'redhat', 'centos': 'redhat', 'fedora': 'redhat', 'ubuntu': 'debian', 'debian': 'debian'}) }}"
  when:
    - bootstrap_distribution is defined
    - bootstrap_distribution is match('^redhat.*')"
  become: "{{ 'bootstrap_become' in ansible_facts | dict2items }} and ansible_facts.bootstrap_become | bool "
  become_user: "{{ 'bootstrap_become_user' in ansible_facts | dict2items and ansible_facts.bootstrap_become_user | bool }}"
  loop_control:
    extended: true


