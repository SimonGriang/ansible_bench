---
- name: Load OS-specific vars
  include_vars:
    file: "{{ lookup('env', 'OS_FAMILY') }}-{{ lookup('env', 'OS_ID') }}.yml"

- name: Include OS-specific setup tasks for RedHat
  when: ansible_distribution == 'RedHat'
  include_tasks: setup-RedHat.yml

- name: Include OS-specific setup tasks for Debian
  when: ansible_distribution == 'Debian'
  include_tasks: setup-Debian.yml

- name: Install Docker packages
  when: ansible_version is version('2.12', 'lt') or ansible_distribution not in ['RedHat', 'Debian']
  yum:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    disable_gpg_check: true
  notify: restart docker
  ignore_errors: true
  become: yes

- name: Install Docker packages with downgrade option
  when: ansible_version >= '2.12' and ansible_distribution in ['RedHat', 'Debian']
  yum:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    disable_gpg_check: true
    force: true
  notify: restart docker
  ignore_errors: true
  become: yes

- name: Install docker-compose plugin
  when: docker_install_compose_plugin and (ansible_version is version('2.12', 'lt') or ansible_distribution not in ['RedHat', 'Debian'])
  yum:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    disable_gpg_check: true
  notify: restart docker
  ignore_errors: true
  become: yes

- name: Install docker-compose-plugin with downgrade option
  when: docker_install_compose_plugin and ansible_version >= '2.12' and ansible_distribution in ['RedHat', 'Debian']
  yum:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    disable_gpg_check: true
    force: true
  notify: restart docker
  ignore_errors: true
  become: yes

- name: Ensure /etc/docker/ directory exists
  when: docker_daemon_options is defined and docker_daemon_options|length > 0
  file:
    path: /etc/docker
    state: directory
    mode: 0755
  become: yes

- name: Configure Docker daemon options
  when: docker_daemon_options is defined and docker_daemon_options|length > 0
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_json }}"
    mode: 0644
  notify: restart docker

- name: Ensure Docker is started and enabled at boot
  when: docker_service_manage is defined
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  become: yes

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose tasks
  when: docker_install_compose is defined
  include_tasks: docker-compose.yml

- name: Get docker group info using getent
  when: docker_users is defined and docker_users|length > 0
  shell: getent group docker
  register: docker_group_info
  changed_when: false

- name: Check if there are any users to add to the docker group
  when: docker_users is defined and docker_users|length > 0
  set_fact:
    at_least_one_user_to_modify: "{{ docker_group_info.stdout_lines|reject('search', docker_users)|list|length > 0 }}"

- name: Include docker-users tasks
  when: at_least_one_user_to_modify is defined
  include_tasks: docker-users.yml


