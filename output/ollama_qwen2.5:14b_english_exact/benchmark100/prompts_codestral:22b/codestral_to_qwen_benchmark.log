---
- name: Create document root directories
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "{{ item.documentroot }}"
  when: item.documentroot is defined
  notify: validate-httpd-config

- name: Configure virtual hosts
  template:
    src: "vhosts.d/{{ item.name }}.conf.j2"
    dest: "/etc/httpd/conf/vhosts.d/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "{{ item.name }}"
  notify: validate-httpd-config

- name: Enable virtual hosts on Debian systems
  command: a2ensite {{ item.name }}
    creates: "/etc/apache2/sites-enabled/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "{{ item.name }}"
  when: ansible_os_family == "Debian"
  notify: validate-httpd-config

