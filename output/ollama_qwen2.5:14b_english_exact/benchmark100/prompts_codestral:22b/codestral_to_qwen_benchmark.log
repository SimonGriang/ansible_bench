---
- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_directories }}"
  no_log: false

- name: Configure directories
  template:
    src: directory.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item }}/index.html"
    mode: '0644'
  loop: "{{ httpd_directories }}"
  notify: test_httpd_config

handlers:
  - name: test httpd config
    shell: apachectl configtest
    listen: test_httpd_config

  - name: restart httpd
    service:
      name: httpd
      state: restarted


