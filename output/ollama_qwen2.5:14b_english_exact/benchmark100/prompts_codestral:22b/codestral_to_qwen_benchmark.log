---
- name: Check if Java certificates exist
  stat:
    path: "{{ item.path[:79]|length + (item.path[79:]|length > 0) ? item.path[:79] + '\\n' + (item.path[79:]|d(''))|join('\\n') : item.path }}"
  register: java_cert_stat
  loop: "{{ java_certs }}"
  no_log: true

- name: Fail if Java certificate doesn't exist
  fail:
    msg: >
      Java certificate {{ item.item.name }} at {{ item.item.path[:79]|length +
      (item.item.path[79:]|length > 0) ? item.item.path[:79] + '\\n' +
      (item.item.path[79:]|d(''))|join('\\n') : item.item.path }} does not
      exist.
  when: not item.stat.exists
  loop: "{{ java_cert_stat.results }}"
  no_log: true

- name: Set keystore variables for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old | default('java_keystore_dir_old') }}"
  when: java_major_version < 11

- name: Set keystore variables for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new | default('java_keystore_dir_new') }}"
  when: java_major_version >= 11

- name: Import SSL certificates
  java_cert:
    path: "{{ item.path[:79]|length + (item.path[79:]|length > 0) ? item.path[:79] + '\\n' + (item.path[79:]|d(''))|join('\\n') : item.path }}"
    keystore: "{{ java_keystore_dir }}/{{ java_keystore_file }}"
    alias: "{{ item.alias }}"
    storepass: "{{ java_keystore_pass }}"
    create: yes
  loop: "{{ java_certs }}"
  no_log: true

