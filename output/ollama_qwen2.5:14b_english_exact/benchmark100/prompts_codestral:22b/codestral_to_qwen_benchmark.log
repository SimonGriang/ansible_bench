---
- name: Disable swap
  when: vault_hardening_disable_swap|default(false)
  block:
    - name: Turn off swap
      command: swapoff -a
      when: ansible_swaps|default('') != ''
    - name: Remove swap entry from fstab
      mount:
        name: "{{ item }}"
        state: absent
      loop: "{{ ansible_swaps }}"
      when: vault_hardening_disable_swap|default(false)

- name: Disable core dumps
  when: vault_hardening_disable_core_dumps|default(false)
  block:
    - name: Disable core dumps for specific limits and domains
      pam_limits:
        domain: "{{ item.0 }}"
        limittype: "{{ item.1 }}"
        type: hard
        item: core
        value: "0"
      loop: "{{ vault_hardening_core_dump_limits }}"
      when: vault_hardening_disable_core_dumps|default(false)

- name: Disable Shell Command History
  when: vault_hardening_disable_shell_command_history|default(false)
  block:
    - name: Copy script to disable shell command history
      copy:
        src: disable_shell_history.sh
        dest: /etc/profile.d/disable_shell_history.sh
        mode: '0755'
      when: vault_hardening_disable_shell_command_history|default(false)

- name: Configure SELinux / AppArmor
  when: vault_hardening_configure_selinux_apparmor|default(false)
  block:
    - name: Install and configure SELinux
      when: ansible_os_family == "RedHat"
      block:
        - name: Ensure SELinux is enabled
          command: getenforce
          register: selinux_status
          changed_when: false
          failed_when: false
        - name: Install SELinux policy package
          package:
            name: selinux-policy
            state: present
          when: selinux_status.stdout == "Disabled"
        - name: Set SELinux policy to targeted and enforcing
          command: setenforce 1
          when: selinux_status.stdout == "Permissive"
    - name: Enable AppArmor for Vault
      block:
        - name: Ensure AppArmor is enabled
          command: aa-status
          register: apparmor_status
          changed_when: false
          failed_when: false
        - name: Enable AppArmor profile for Vault
          command: aa-enforce /etc/apparmor.d/usr.sbin.vault
          when: apparmor_status.stdout.find("disabled") == -1
      when: ansible_os_family == "Debian"

