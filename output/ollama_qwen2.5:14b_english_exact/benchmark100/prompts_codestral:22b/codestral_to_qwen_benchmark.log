  block:
    - name: Ensure cadvisor service directory
      file:
        path: /etc/systemd/system
        state: directory
        mode: '0755'

    - name: Create cadvisor systemd service file
      copy:
        src: /path/to/cadvisor.service
        dest: /etc/systemd/system/cadvisor.service
        mode: '0644'

    - name: Restart cadvisor service if service file updated
      systemd:
        name: cadvisor
        state: restarted
      when: "'{{ ansible_remote_tmp }}' is changed"

- name: Check cadvisor service status
  shell: systemctl status cadvisor

- name: Enable cadvisor systemd service
  systemd:
    name: cadvisor
    enabled: yes

- name: Start cadvisor systemd service
  block:
    - name: Start cadvisor service
      systemd:
        name: cadvisor
        state: started

    - name: Reload systemd daemon
      command: systemctl daemon-reload

