---
- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that: "'systemd' in ansible_systemd"
    msg: "This module only works with systemd"

- name: Get the latest release version of Promtail from GitHub
  ansible.builtin.uri:
    url: "https://api.github.com/repos/grafana/promtail/releases/latest"
    method: GET
    return_content: yes
    headers:
      Authorization: "Bearer {{ lookup('env', 'GH_TOKEN') }}"
    validate_certs: yes
  register: promtail_release
  delegate_to: localhost
  run_once: true

- name: Check if the local Promtail binary archive exists
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/{{ promtail_binary_filename }}"
  register: promtail_binary_local
  delegate_to: localhost
  run_once: true
  when: promtail_binary_local_dir is defined
  failed_when: promtail_binary_local.stat.exists == False
  fail_msg: "When using 'promtail_binary_local_dir' please ensure that the binary exists"

- name: Get the checksum for the Promtail binary
  ansible.builtin.uri:
    url: "https://github.com/grafana/promtail/releases/download/{{ promtail_release.json.tag_name }}/checksums.txt"
    method: GET
    return_content: yes
    validate_certs: yes
  register: promtail_checksums
  delegate_to: localhost
  run_once: true
  when: promtail_binary_local_dir is not defined
  register: promtail_checksum
  failed_when: not promtail_checksums.content
  register: promtail_checksum
  failed_when: not promtail_checksums.content
  changed_when: False

