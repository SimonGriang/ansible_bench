---
- name: create | Create ssl key
  openssl_privatekey:
    path: /etc/ssl/private/my_ssl_key.pem
    mode: '0600'
    owner: ssl-user
    group: ssl-group
    provider: rsa
    size: 4096

- name: create | Create ssl csr
  openssl_csr:
    path: /etc/ssl/csr/my_ssl_csr.pem
    privatekey_path: /etc/ssl/private/my_ssl_key.pem
    mode: '0600'
    owner: ssl-user
    group: ssl-group
    common_name: example.com
    organization: Example Inc.
    country: US
    state: NY
    city: New York
    email: admin@example.com
    passphrase: mypassphrase

- name: create | Create ssl certificates
  x509_certificate:
    path: /etc/ssl/certs/my_ssl_cert.pem
    privatekey_path: /etc/ssl/private/my_ssl_key.pem
    csr_path: /etc/ssl/csr/my_ssl_csr.pem
    mode: '0600'
    owner: ssl-user
    group: ssl-group
    provider: selfsigned
    days: 365

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    export: yes
    path: /etc/ssl/pkcs12/my_ssl_pkcs12.p12
    name: my_ssl_cert.pem
    privatekey_path: /etc/ssl/private/my_ssl_key.pem
    certificate_path: /etc/ssl/certs/my_ssl_cert.pem
    mode: '0600'
    owner: ssl-user
    group: ssl-group
    passphrase: mypassphrase

- name: create | Read private key
  slurp:
    src: /etc/ssl/private/my_ssl_key.pem
  register: private_key

- name: create | Read certificate
  slurp:
    src: /etc/ssl/certs/my_ssl_cert.pem
  register: certificate

- name: create | Create combined private_key and certificate file
  copy:
    content: "{{ private_key.content }}\n{{ certificate.content }}"
    dest: /etc/ssl/combined/my_ssl_combined.pem
    mode: '0600'
    owner: ssl-user
    group: ssl-group

