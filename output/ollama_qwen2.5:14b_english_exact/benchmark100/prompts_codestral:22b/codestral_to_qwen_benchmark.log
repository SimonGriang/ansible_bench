  when: rke2_type == 'server'

- name: Copy rke2 config
  copy:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  when: rke2_kubelet_config is not empty
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  when: rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty
  notify: Config file changed

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is not empty and not rke2_server_service_state.running

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file is not empty and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options is not {}

- name: Restore etcd from file
  block:
    - name: Create directory for etcd snapshot
      file:
        path: /var/lib/rancher/rke2/agent/snapshots
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/snapshots/etcd-snapshot

    - name: Restore etcd from snapshot
      shell: rke2 server etcd restore file=/var/lib/rancher/rke2/agent/snapshots/etcd-snapshot
      register: etcd_restore_output
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Restore etcd from s3
      shell: rke2 server etcd restore s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }} s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }} s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }} snapshot-name={{ rke2_etcd_snapshot_s3_options.snapshot_name }}
      register: etcd_s3_restore_output
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
    masked: no
    environment: RKE2_TOKEN={{ rke2_token }}
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    state: masked

- name: Wait for the first server to be ready - no CNI
  shell: kubectl get nodes -o json | jq -c '.items[] | select(.metadata.name == "{{ rke2_cluster_name }}-control-plane") | {status: .status, spec: .spec}'
  register: node_info
  until: node_info is succeeded
  retries: 30
  delay: 10
  when: rke2_cni == 'none'

- name: Wait for the first server to be ready - with CNI
  shell: kubectl get nodes -o json | jq -c '.items[] | select(.metadata.name == "{{ rke2_cluster_name }}-control-plane") | {status: .status, spec: .spec}'
  register: node_info
  until: node_info is succeeded
  retries: 30
  delay: 10
  when: rke2_cni is not 'none'

- name: Restore etcd
  block:
    - name: Get registered nodes
      shell: kubectl get nodes -o json | jq -c '.items[] | {name: .metadata.name, status: .status, spec: .spec}'
      register: registered_nodes

    - name: Remove old node-password secret
      shell: kubectl delete secret {{ item.name }}-node-password --namespace=kube-system
      loop: "{{ registered_nodes.results }}"
      when: item.item.status.conditions[-1].type == 'Ready' and item.item.spec.taints | length > 0

    - name: Remove old node
      shell: kubectl delete node {{ item.name }}
      loop: "{{ registered_nodes.results }}"
      when: item.item.status.conditions[-1].type == 'Ready' and item.item.spec.taints | length > 0

    - name: Set Active Server variable
      set_fact:
        active_server: "{{ item.name }}"
      loop: "{{ registered_nodes.results }}"
      when: item.item.status.conditions[-1].type == 'Ready' and item.item.spec.taints | length == 0
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

