---
- import_tasks: assert.yml

- name: Install using package
  when: hashicorp_installation_method == "package"
  block:
    - name: Setup yum repository for RedHat/Rocky
      when: ansible_os_family == "RedHat"
      yum_repository:
        description: "HashiCorp yum repo"
        baseurl: "https://releases.hashicorp.com/repo/hashicorp/linux/redhat/"
        gpgcheck: no
        enabled: 1

    - name: Setup apt repository for Debian
      when: ansible_os_family == "Debian"
      apt_repository:
        filename: "hashicorp"
        repo: "deb [arch=amd64] https://releases.hashicorp.com/repo/hashicorp/linux/debian/ /"
        state: present

    - name: Install HashiCorp products using package manager
      package:
        name: "{{ item }}"
        state: present
      loop:
        - terraform
        - vault
        - packer
        - nomad
        - consul

- name: Install manually
  when: hashicorp_installation_method == "manual"
  block:
    - name: Extract files from source to destination
      unarchive:
        src: "{{ item.src }}"
        dest: "{{ item.dest }}"
        remote_src: yes
        owner: root
        group: root
        mode: "{{ item.mode }}"
      loop:
        - src: "/src/terraform.tar.gz"
          dest: "/usr/local/bin/"
          mode: "0755"
        - src: "/src/vault.zip"
          dest: "/usr/local/bin/"
          mode: "0755"
        - src: "/src/packer.zip"
          dest: "/usr/local/bin/"
          mode: "0755"
        - src: "/src/nomad.zip"
          dest: "/usr/local/bin/"
          mode: "0755"
        - src: "/src/consul.zip"
          dest: "/usr/local/bin/"
          mode: "0755"


