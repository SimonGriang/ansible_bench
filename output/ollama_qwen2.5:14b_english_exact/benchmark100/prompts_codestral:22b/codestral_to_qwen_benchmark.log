---
- name: Task 1: Import assert.yml
  import_tasks: assert.yml

- name: Task 2: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - set_mysql_root_password
    - systemd_daemon_reload

- name: Task 3: Configure mysql server
  template:
    src: mysql-server.cnf.j2
    dest: /etc/mysql/mysql-server.cnf
  notify: restart_mysql_server

- name: Task 4: Configure mysql client
  template:
    src: mysql-client.cnf.j2
    dest: /etc/mysql/mysql-client.cnf
    owner: root
    group: root
    mode: '0644'
  notify: restart_mysql_client

- name: Task 5: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when:
    - ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"

- name: Task 6: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Task 7: Flush handlers
  meta: flush_handlers

- name: Task 8: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: '0600'

- name: Task 9: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when:
    - item is defined
    - item.initial_import is not defined
    - mysql_databases is defined
  become_user: root
  become: yes
  vars:
    ansible_become_password: "{{ mysql_root_password }}"

- name: Task 10: List databases
  mysql_db:
    name: "*"
    state: list
  register: mysql_info
  become_user: root
  become: yes
  vars:
    ansible_become_password: "{{ mysql_root_password }}"

- name: Task 11: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import.path }}"
  loop: "{{ mysql_databases }}"
  when:
    - item is defined
    - item.initial_import is defined
    - mysql_databases is defined
  become_user: root
  become: yes
  vars:
    ansible_become_password: "{{ mysql_root_password }}"

- name: Task 12: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    state: present
  loop: "{{ mysql_users }}"
  when: mysql_users is defined
  become_user: root
  become: yes
  vars:
    ansible_become_password: "{{ mysql_root_password }}"

- name: Task 13: Flush handlers again
  meta: flush_handlers

