    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready
  ansible.builtin.shell:
    cmd: "{{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes | grep ' Ready' | wc -l"
    executable: /bin/bash
  register: node_status
  until: node_status.stdout | int == groups[rke2_cluster_group_name] | length
  retries: 30
  delay: 10
  when: not ansible_check_mode and (active_server is undefined or active_server == groups[rke2_servers_group_name][0])

- name: Wait for all pods to be ready
  ansible.builtin.shell:
    cmd: "{{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded --ignore-not-found | wc -l"
    executable: /bin/bash
  register: pod_status
  until: pod_status.stdout | int == 0
  retries: 30
  delay: 10
  when: not ansible_check_mode and (active_server is undefined or active_server == groups[rke2_servers_group_name][0]) and rke2_wait_for_all_pods_to_be_ready

- name: Service (re)started
  handler:
    - name: Restart RKE2 service on a specified node
      ansible.builtin.service:
        name: "{{ rke2_service_name }}"
        state: restarted


