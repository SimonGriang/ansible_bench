- name: Initialize easy-rsa
  ansible.builtin.command: "{{ openvpn_easyrsa_path }}/easyrsa init-pki"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not stat(/etc/openvpn/easy-rsa/pki).exists

- name: Build CA
  ansible.builtin.command: "{{ openvpn_easyrsa_path }}/easyrsa build-ca nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  when: not stat(/etc/openvpn/easy-rsa/pki/ca.crt).exists

- name: Generate Diffie-Hellman parameters
  ansible.builtin.command: "{{ openvpn_easyrsa_path }}/easyrsa gen-dh"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not stat(/etc/openvpn/easy-rsa/pki/dh.pem).exists

- name: Build server certificates
  ansible.builtin.command: "{{ openvpn_easyrsa_path }}/easyrsa build-server-full server nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  when: not stat(/etc/openvpn/easy-rsa/pki/issued/server.crt).exists

- name: Build client certificates
  ansible.builtin.command: "{{ openvpn_easyrsa_path }}/easyrsa build-client-full client nopass"
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: "yes"
  when: not stat(/etc/openvpn/easy-rsa/pki/issued/client.crt).exists

- name: Generate Certificate Revocation List
  ansible.builtin.command: "{{ openvpn_easyrsa_path }}/easyrsa gen-crl"
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not stat(/etc/openvpn/easy-rsa/pki/crl.pem).exists

- name: Generate TLS Auth Key
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  when: not stat(/etc/openvpn/easy-rsa/pki/ta.key).exists

- name: Copy files to /etc/openvpn/server
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/{{ item }}
    mode: '0640'
  loop:
    - ca.crt
    - dh.pem
    - ta.key
    - server.crt
    - server.key
    - crl.pem

- name: Copy files to /etc/openvpn
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/{{ item }}
    mode: '0640'
  loop:
