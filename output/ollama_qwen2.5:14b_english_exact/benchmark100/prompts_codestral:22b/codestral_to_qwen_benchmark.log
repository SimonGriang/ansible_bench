---
- name: Create RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  when: rke2_type == 'server'
  lineinfile:
    path: /etc/rancher/rke2/config.yaml
    regexp: '^#?node-taints:'
    line: "node-taints: {{ rke2_server_node_taints }}"
    create: yes
    owner: root
    group: root
    mode: '0644'

- name: Set agent taints
  when: rke2_type == 'agent'
  lineinfile:
    path: /etc/rancher/rke2/config.yaml
    regexp: '^#?node-taints:'
    line: "node-taints: {{ rke2_agent_node_taints }}"
    create: yes
    owner: root
    group: root
    mode: '0644'

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  when: rke2_kubelet_config is not empty
  copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  when: rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: "{{ rke2_service_name }}"
    enabled: yes
    state: started
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ rke2_service_name | regex_replace(r'^rke2-', 'rke2-agent') }}"
    enabled: no
    masked: yes
  when: rke2_type == 'server'
- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: "{{ rke2_service_name | regex_replace(r'^rke2-', 'rke2-server') }}"
    enabled: no
    masked: yes
  when: rke2_type == 'agent'

- name: Wait for remaining nodes to be ready - no CNI
  when: rke2_cni == 'none'
  shell: >
    kubectl get nodes -l "rke2.io/{{ rke2_cluster_group_name }}={{ inventory_hostname }}" -o json |
    jq -r '.items[] | select(.status.conditions[]?.status == "False") | .metadata.name'
  register: node_not_ready
  until: node_not_ready.stdout | length == 0
  retries: 10
  delay: 10

- name: Wait for remaining nodes to be ready - with CNI
  when: rke2_cni is not 'none'
  shell: >
    kubectl get nodes -l "rke2.io/{{ rke2_cluster_group_name }}={{ inventory_hostname }}" -o json |
    jq -r '.items[] | select(.status.conditions[]?.type == "Ready" and .status.conditions[].status == "True") | .metadata.name' | wc -l
  register: node_ready_count
  until: node_ready_count.stdout | int >= rke2_cluster_group_count
  retries: 10
  delay: 10

