---
- name: Create directories
  file:
    path: /opt/cadvisor
    state: directory
    mode: '0755'

- name: Download cadvisor binary
  block:
    - name: Ensure cadvisor binary directory
      file:
        path: /opt/cadvisor/bin
        state: directory
        mode: '0755'

    - name: Download cadvisor binary from URL
      get_url:
        url: http://example.com/cadvisor
        dest: /opt/cadvisor/bin/cadvisor
        sha256sum: abcdef1234567890

    - name: Set executable permission on cadvisor binary
      file:
        path: /opt/cadvisor/bin/cadvisor
        mode: '0755'

- name: Propagate locally distributed cadvisor binary
  block:
    - name: Ensure cadvisor binary directory
      file:
        path: /opt/cadvisor/bin
        state: directory
        mode: '0755'

    - name: Copy cadvisor binary to application directory
      copy:
        src: /local/path/to/cadvisor
        dest: /opt/cadvisor/bin/cadvisor
        mode: '0755'
        owner: root
        group: root

    - name: Restart cadvisor service if binary updated
      systemd:
        name: cadvisor
        state: restarted
      when: ansible_remote_tmp is changed

- name: Create a symlink
  file:
    src: /opt/cadvisor/bin/cadvisor
    dest: /usr/local/bin/cadvisor
    state: link

- name: Configure cadvisor systemd service
  block:
    - name: Ensure cadvisor service directory
      file:
        path: /etc/systemd/system
        state: directory
        mode: '0755'

    - name: Create cadvisor systemd service file
      copy:
        src: /path/to/cadvisor.service
        dest: /etc/systemd/system/cadvisor.service
        mode: '0644'

    - name: Restart cadvisor service if service file updated
      systemd:
        name: cadvisor
        state: restarted
      when: ansible_remote_tmp is changed

- name: Check cadvisor service status
  shell: systemctl status cadvisor

- name: Enable cadvisor systemd service
  systemd:
    name: cadvisor
    enabled: yes

- name: Start cadvisor systemd service
  block:
    - name: Start cadvisor service
      systemd:
        name: cadvisor
        state: started

    - name: Reload systemd daemon
      command: systemctl daemon-reload

