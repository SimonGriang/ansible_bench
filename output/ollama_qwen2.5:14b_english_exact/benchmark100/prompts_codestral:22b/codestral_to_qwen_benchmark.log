---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout | default(300) }}"

- name: Prepare system
  block:
    - name: Test the connection
      ansible.builtin.ping:

    - name: Test if sudo is available
      ansible.builtin.command: sudo whoami
      register: sudo_test
      changed_when: false
      failed_when: sudo_test.rc != 0

    - name: Gather bootstrap facts
      ansible.builtin.setup:
        gather_subset:
          - "!all"
          - "bootstrap"
      when: sudo_test|failed

    - name: Install bootstrap packages
      ansible.builtin.raw: "{{ item }}"
      with_items: "{{ bootstrap_facts_packages }}"
      register: install_output
      changed_when: "'No package' not in install_output.stderr"
      when: sudo_test|failed

    - name: Ensure libdnf5 is present on Fedora/RedHat
      ansible.builtin.package:
        name: libdnf5
        state: present
      when: ansible_os_family == "RedHat"

- name: Gather ansible facts
  ansible.builtin.setup: {}

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become | default(True) }}"

