content='---\n- name: Check if Helm binary exists\n  stat:\n    path: "{{ helm_bin_path }}"\n  register: helm_check\n\n- name: Check Helm version\n  command: "{{ helm_bin_path }}/helm version --client"\n  register: helm_existing_version\n  ignore_errors: yes\n  changed_when: false\n  when: helm_check.stat.exists\n\n- name: Download helm\n  unarchive:\n    url: "{{ helm_repo_path }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"\n    remote_src: yes\n    dest: /tmp\n    creates: "{{ helm_bin_path }}/helm"\n  register: helm_download\n  when: not helm_check.stat.exists or helm_existing_version.stdout.find(helm_version) == -1\n\n- name: Copy helm binary into place\n  copy:\n    src: /tmp/{{ helm_platform }}-{{ helm_arch }}/helm\n    dest: "{{ helm_bin_path }}/helm"\n    mode: \'0755\'\n  when: helm_download.changed' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-15T10:21:42.00013234Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4394658457, 'load_duration': 91016426, 'prompt_eval_count': 561, 'prompt_eval_duration': 312811236, 'eval_count': 216, 'eval_duration': 3984206314, 'model_name': 'qwen2.5:14b'} id='run--a1d37815-4d69-4375-8d7e-7dca4e9866c8-0' usage_metadata={'input_tokens': 561, 'output_tokens': 216, 'total_tokens': 777}
