---
- name: Cordon and Drain the node
  when: rke2_drain_node_during_upgrade
  block:
    - name: Cordon the node
      shell: kubectl --context=k3s-{{ rke2_servers_group_name }}@%HOSTNAME%.local cordon $(hostname)
      when: inventory_hostname == active_server | default(rke2_servers_group_name.split(',')[0])
      delegate_to: "{{ active_server | default(rke2_servers_group_name.split(',')[0]) }}"

    - name: Drain the node
      shell: kubectl --context=k3s-{{ rke2_servers_group_name }}@%HOSTNAME%.local drain $(hostname) --ignore-daemonsets=true --delete-local-data=true --force=true
      when: inventory_hostname == active_server | default(rke2_servers_group_name.split(',')[0])
      delegate_to: "{{ active_server | default(rke2_servers_group_name.split(',')[0]) }}"

- name: Restart RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted

- name: Wait for all nodes to be ready again
  block:
    - name: Wait for all nodes to be ready
      shell: kubectl --context=k3s-{{ rke2_servers_group_name }}@%HOSTNAME%.local get nodes -o json | jq '.items | length'
      register: node_count
      changed_when: false

    - name: Get ready nodes
      shell: kubectl --context=k3s-{{ rke2_servers_group_name }}@%HOSTNAME%.local get nodes -o json | jq '.items | map(select(.status.conditions[] | select(.type=="Ready" and .status=="True"))) | length'
      register: ready_nodes
      changed_when: false

    - name: Check node status
      debug:
        msg: "Nodes are ready"
      when: node_count.stdout | int == ready_nodes.stdout | int
      retries: 30
      delay: 30
      delegate_to: "{{ active_server | default(rke2_servers_group_name.split(',')[0]) }}"

- name: Uncordon the node
  when: rke2_drain_node_during_upgrade
  block:
    - name: Uncordon the node
      shell: kubectl --context=k3s-{{ rke2_servers_group_name }}@%HOSTNAME%.local uncordon $(hostname)
      when: inventory_hostname == active_server | default(rke2_servers_group_name.split(',')[0])
      delegate_to: "{{ active_server | default(rke2_servers_group_name.split(',')[0]) }}"

- name: Wait for all pods to be ready again
  when: rke2_wait_for_all_pods_to_be_ready
  block:
    - name: Wait for all pods to be in running or succeeded state
      shell: >
        kubectl --context=k3s-{{ rke2_servers_group_name }}@%HOSTNAME%.local get pods -o json | jq '.items | map(select(.status.containerStatuses[].ready == true or .status.phase == "Succeeded")) | length'
      register: pod_status
      changed_when: false

    - name: Check pod status
      debug:
        msg: "All pods are ready"
      when: pod_status.stdout | int == (kubectl --context=k3s-{{ rke2_servers_group_name }}@%HOSTNAME%.local get pods -o json | jq '.items | length')
      retries: 30
      delay: 30
      delegate_to: "{{ active_server | default(rke2_servers_group_name.split(',')[0]) }}"

- name: Wait for all pods to pass readiness checks
  when: rke2_wait_for_all_pods_to_be_healthy
  block:
    - name: Wait for all pods to pass readiness checks
      shell: kubectl --context=k3s-{{ rke2_servers_group_name }}@%HOSTNAME%.local wait --for=condition=ready --timeout=120s pod --all
      args: "{{ rke2_wait_for_all_pods_to_be_healthy_args }}"
      when: inventory_hostname == active_server | default(rke2_servers_group_name.split(',')[0])
      delegate_to: "{{ active_server | default(rke2_servers_group_name.split(',')[0]) }}"

