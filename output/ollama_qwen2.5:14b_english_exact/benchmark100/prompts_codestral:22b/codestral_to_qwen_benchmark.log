    path: /etc/python3.11/EXTERNALLY-MANAGED
    state: file
  register: python3_11_exists

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.command: mv /etc/python3.11/EXTERNALLY-MANAGED /etc/python3.11/EXTERNALLY-MANAGED.old
  when: python3_11_exists.success

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  ansible.builtin.file:
    path: /etc/python3.12/EXTERNALLY-MANAGED
    state: file
  register: python3_12_exists

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.command: mv /etc/python3.12/EXTERNALLY-MANAGED /etc/python3.12/EXTERNALLY-MANAGED.old
  when: python3_12_exists.success

- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install python pip
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_packages }}"

- name: Configure pip proxy
  ansible.builtin.shell: pip config set global.index-url "{{ python_pip_proxy }}"
  when: python_pip_proxy is defined

- name: Trust hosts
  ansible.builtin.shell: pip config set global.trusted-host "{{ item }}"
  loop: "{{ python_pip_trusted_host }}"
  when: python_pip_trusted_host|length > 0

- name: Update pip
  ansible.builtin.shell: "{{ python_pip_executable }} -m pip install --upgrade pip"
  when: python_pip_update == True and ansible_distribution != 'bookworm' and ansible_distribution != 'noble' and ansible_os_family != 'Alpine'

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    version: "{{ item.version }}"
    state: "{{ item.state | default('present') }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  when: ansible_distribution != 'bookworm' and ansible_distribution != 'noble' and ansible_os_family != 'Alpine'


