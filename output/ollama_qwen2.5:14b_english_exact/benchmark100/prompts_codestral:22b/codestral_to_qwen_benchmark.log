---
- name: Assert Variables
  import_tasks: assert.yml
  remote_addr: localhost

- name: Wait for Host
  local_action: wait_for host={{ inventory_hostname }} port={{ bootstrap_port|default(22) }} delay=1 timeout={{ bootstrap_timeout }} state=reachable
  when: not (ansible_connection == 'docker' or ansible_connection == 'container') and bootstrap_wait_for_host|default(true)
  become: "{{ bootstrap_become|default(false) }}"
  become_user: "{{ bootstrap_become_user|default('root') }}"

- name: Prepare System
  block:
    - name: Test connection
      ping:
      register: test_connection
      failed_when: false

    - name: Debug test connection failure
      debug:
        msg: "Connection test failed, proceeding anyway."
      when: not test_connection.connected

    - name: Gather bootstrap facts
      setup:

    - name: Install bootstrap packages
      raw: "{{ bootstrap_install_raw_cmd }}"
      register: install_result
      changed_when: install_result.stdout.find('changed=1') >= 0
  become: "{{ bootstrap_become|default(false) }}"
  become_user: "{{ bootstrap_become_user|default('root') }}"

- name: Ensure System Prepared
  block:
    - name: Gather Ansible facts
      setup:

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_packages }}"
        state: present
  become: "{{ bootstrap_become|default(false) }}"
  become_user: "{{ bootstrap_become_user|default('root') }}"

