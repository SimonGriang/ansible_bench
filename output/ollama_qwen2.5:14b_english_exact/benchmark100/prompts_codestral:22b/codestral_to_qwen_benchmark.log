---
- import_tasks: assert.yml
  remote_src: true
 delegate_to: localhost

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    insertafter: EOF
    create: yes
    mode: 0600
    regexp: "^SHELL"
  notify: Restart cron

- name: Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    insertafter: EOF
    create: yes
    mode: 0600
    regexp: "^PATH"
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    insertafter: EOF
    create: yes
    mode: 0600
    regexp: "^MAILTO"
  notify: Restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    enabled: yes
    state: started
  when: cron_service is defined and cron_service|length > 0

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default('present') }}"
    user: "{{ item.user | default('root') }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined

