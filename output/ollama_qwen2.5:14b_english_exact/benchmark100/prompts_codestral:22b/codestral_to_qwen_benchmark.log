---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  when: inventory_hostname == "localhost"

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ansible.builtin.lineinfile:
    path: "{{ mysql_configuration_destination }}/mysql-server.cnf"
    line: "{{ item.key }} = {{ item.value }}"
    create: true
    mode: '0644'
  with_dict: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  ansible.builtin.lineinfile:
    path: "{{ mysql_configuration_destination }}/mysql-client.cnf"
    line: "socket={{ mysql_socket }}"
    create: true
    mode: '0644'

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']
  changed_when: false

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/my.cnf
    mode: '0640'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
    login_host: localhost
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    login_host: localhost
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

