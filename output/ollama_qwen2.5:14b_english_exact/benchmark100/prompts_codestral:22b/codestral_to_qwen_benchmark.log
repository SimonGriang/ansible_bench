\n  copy:\n    src: /etc/openvpn/easy-rsa/pki/{{ item }}\n    dest: /etc/openvpn/{{ item }}\n    mode: \'0640\'\n  loop:\n    - ca.crt\n    - crl.pem\n\n- name: Place server.conf\n  template:\n    src: server.conf.j2\n    dest: "{{ openvpn_configuration_directory }}/server.conf"\n    owner: root\n    group: "{{ openvpn_group }}"\n    mode: \'0640\'\n  notify: Restart openvpn\n\n# (End of file)' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-15T10:25:43.252567488Z', 'done': True, 'done_reason': 'stop', 'total_duration': 18075335834, 'load_duration': 90233759, 'prompt_eval_count': 1828, 'prompt_eval_duration': 900512355, 'eval_count': 719, 'eval_duration': 17077210537, 'model_name': 'qwen2.5:14b'} id='run--11c3dbbd-907d-4409-8d6f-bc0ea9a65747-0' usage_metadata={'input_tokens': 1828, 'output_tokens': 719, 'total_tokens': 2547}
