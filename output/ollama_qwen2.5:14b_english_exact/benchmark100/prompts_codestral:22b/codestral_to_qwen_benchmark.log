     when: rke2_airgap_mode and rke2_airgap_implementation == \'exists\'\n    - name: Make install script executable if necessary\n      ansible.builtin.file:\n        path: "{{ rke2_install_script_path }}"\n        mode: \'0755\'\n      when: artifact_check is success and not artifact_check.stat.is_executable\n    - name: Fail task if install script is not executable and does not exist\n      ansible.builtin.fail:\n        msg: "Install script is not executable and does not exist."\n      when: artifact_check is success and not artifact_check.stat.is_executable and not artifact_check.stat.exists\n\n- name: Set RKE2 bin path\n  block:\n    - name: Populate service facts\n      ansible.builtin.service_facts: {}\n    - name: Get stats of the filesystem object\n      ansible.builtin.stat:\n        path: "{{ rke2_bin_path }}"\n      register: rke2_bin_stat\n    - name: Check if separate partition\n      ansible.builtin.stat:\n        path: "{{ rke2_bin_partition }}"\n      register: rke2_bin_partition_stat\n    - name: Set RKE2 bin path\n      ansible.builtin.set_fact:\n        rke2_bin_path: "{{ rke2_bin_partition_stat.stat.exists | ternary(rke2_bin_partition, rke2_bin_path) }}"\n\n- name: Check RKE2 version\n  block:\n    - name: Check RKE2 version\n      ansible.builtin.command: "{{ rke2_bin_path }}/rke2 --version"\n      register: rke2_version\n      when: rke2_bin_path is defined\n    - name: Set installed version to \'not installed\' if binary does not exist\n      ansible.builtin.set_fact:\n        rke2_installed_version: "not installed"\n      when: rke2_version.rc != 0\n    - name: Set running version if service is active\n      ansible.builtin.service:\n        name: rke2\n        state: started\n      register: rke2_service\n      when: rke2_installed_version is defined\n    - name: Set running version to desired RKE2 version if service binary does not exist\n      ansible.builtin.set_fact:\n        rke2_running_version: "{{ rke2_version.stdout.split(\' \')[2] }}"\n      when: rke2_service is succeeded and rke2_installed_version is defined\n    - name: Set running version to desired RKE2 version\n      ansible.builtin.set_fact:\n        rke2_running_version: "{{ rke2_version.stdout.split(\' \')[2] }}"\n      when: rke2_installed_version is defined and not rke_service is succeeded\n\n- name: Prevent accidental RKE2 downgrade\n  block:\n    - name: Prevent accidental RKE2 downgrade\n      ansible.builtin.fail:\n        msg: "Desired RKE2 version is less than the running version and downgrades are not allowed."\n      when: rke2_running_version is defined and rke2_installed_version != "not installed" and rke2_running_version != rke2_installed_version and rke2_running_version < rke2_installed_version and rke2_allow_downgrade is not defined\n\n- name: Run RKE2 install script\n  block:\n    - name: Run RKE2 install script\n      ansible.builtin.shell: >\n        {{ rke2_bin_path }}/rke2 install {{ rke2_install_script_path }} --airgap --k8s-version={{ rke2_version }} --disable-swap --disable-cloud-provider --kubelet-arg=image-credential-provider-config=/etc/rancher/rke2/credprov.conf --kubelet-arg=image-credential-provider-bin-dir=/var/lib/rke2/agent/provider-bin --kubelet-arg=image-credential-provider-cache-ttl=1h --kubelet-arg=image-credential-provider-cache-sync-interval=30m --kubelet-arg=image-credential-provider-cache-max-size=1000\n      when: rke2_airgap_mode\n    - name: Run RKE2 install script without airgap\n      ansible.builtin.shell: >\n        {{ rke2_bin_path }}/rke2 install --k8s-version={{ rke2_version }} --disable-swap --disable-cloud-provider --kubelet-arg=image-credential-provider-config=/etc/rancher/rke2/credprov.conf --kubelet-arg=image-credential-provider-bin-dir=/var/lib/rke2/agent/provider-bin --kubelet-arg=image-credential-provider-cache-ttl=1h --kubelet-arg=image-credential-provider-cache-sync-interval=30m --kubelet-arg=image-credential-provider-cache-max-size=1000\n      when: not rke2_airgap_mode\n    - name: Run RKE2 install script with custom arguments\n      ansible.builtin.shell: >\n        {{ rke2_bin_path }}/rke2 install {{ rke2_install_script_path }} --k8s-version={{ rke2_version }} --disable-swap --disable-cloud-provider --kubelet-arg=image-credential-provider-config=/etc/rancher/rke2/credprov.conf --kubelet-arg=image-credential-provider-bin-dir=/var/lib/rke2/agent/provider-bin --kubelet-arg=image-credential-provider-cache-ttl=1h --kubelet-arg=image-credential-provider-cache-sync-interval=30m --kubelet-arg=image-credential-provider-cache-max-size=1000\n      when: rke2_airgap_mode and rke2_installed_version != rke2_version\n\n- name: Copy Custom Manifests\n  block:\n    - name: Copy Custom Manifests\n      ansible.builtin.copy:\n        src: "{{ rke2_custom_manifests_source_path }}"\n        dest: "{{ rke2_custom_manifests_dest_path }}"\n      when: rke2_custom_manifests is defined\n\n- name: Copy Static Pods\n  block:\n    - name: Copy Static Pods\n      ansible.builtin.copy:\n        src: "{{ rke2_static_pods_source_path }}"\n        dest: "{{ rke2_static_pods_dest_path }}"\n      when: rke2_static_pods is defined\n\n- name: Copy RKE2 environment file\n  block:\n    - name: Copy RKE2 environment file\n      ansible.builtin.copy:\n        src: "{{ rke2_env_source_path }}"\n        dest: "{{ rke2_env_dest_path }}"\n      when: rke2_env_options is defined' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-15T11:17:59.991736836Z', 'done': True, 'done_reason': 'stop', 'total_duration': 57567766689, 'load_duration': 94986111, 'prompt_eval_count': 3922, 'prompt_eval_duration': 1746899815, 'eval_count': 2351, 'eval_duration': 55708028147, 'model_name': 'qwen2.5:14b'} id='run--b60c7a6e-b432-4ae7-95a7-413a6573bbdd-0' usage_metadata={'input_tokens': 3922, 'output_tokens': 2351, 'total_tokens': 6273}
