content='---\n- import_tasks: assert.yml\n\n- name: Install cron\n  package:\n    name: "{{ cron_packages }}"\n    state: present\n\n- name: Configure shell\n  lineinfile:\n    path: "{{ cron_configuration }}"\n    line: "SHELL={{ cron_shell }}"\n    create: yes\n    mode: \'0600\'\n  notify: Restart cron\n\n- name: Configure path\n  lineinfile:\n    path: "{{ cron_configuration }}"\n    line: "PATH={{ cron_path }}"\n    create: yes\n    mode: \'0600\'\n  notify: Restart cron\n\n- name: Configure mailto\n  lineinfile:\n    path: "{{ cron_configuration }}"\n    line: "MAILTO={{ cron_mailto }}"\n    create: yes\n    mode: \'0600\'\n  notify: Restart cron\n\n- name: Start and enable cron\n  when: cron_service is defined and cron_service != \'\'\n  service:\n    name: "{{ cron_service }}"\n    enabled: yes\n    state: started\n\n- name: Schedule requested cron jobs\n  cron:\n    name: "{{ item.name }}"\n    minute: "{{ item.minute }}"\n    hour: "{{ item.hour }}"\n    day: "{{ item.day }}"\n    month: "{{ item.month }}"\n    weekday: "{{ item.weekday }}"\n    special_time: "{{ item.special_time }}"\n    job: "{{ item.job }}"\n    state: "{{ item.state | default(\'present\') }}"\n    user: "{{ item.user | default(\'current_user\') }}"\n  loop: "{{ cron_jobs }}"\n  when: cron_jobs is defined' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-15T11:53:33.123172734Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6662100830, 'load_duration': 94511283, 'prompt_eval_count': 803, 'prompt_eval_duration': 352169366, 'eval_count': 321, 'eval_duration': 6203041399, 'model_name': 'qwen2.5:14b'} id='run--0efaf3e7-491e-4a74-8fee-b444b3ed4835-0' usage_metadata={'input_tokens': 803, 'output_tokens': 321, 'total_tokens': 1124}
