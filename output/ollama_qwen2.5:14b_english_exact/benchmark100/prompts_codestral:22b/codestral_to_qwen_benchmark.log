        name: "{{ item }}"
        state: present
      loop: "{{ update_prevent_upgrades }}"
      when: update_prevent_upgrades is defined and update_prevent_upgrades|length > 0

    - name: Update cache
      apt:
        update_cache: yes
        cache_valid_time: "{{ update_cache_valid_time }}"
      register: update_result

    - name: Upgrade all software
