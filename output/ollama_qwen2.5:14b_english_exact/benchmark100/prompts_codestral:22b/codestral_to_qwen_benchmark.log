---
- name: Remove externally managed
  include_tasks: "{{ role_path }}/tasks/debian-12-remove.yml "
  when: ansible_distribution == "Debian" and ansible_distribution_major_version == "12"

- name: Ensure Pip is installed
  apt:
    name: "{{ pip_package }}"
    state: present
  vars:
    pip_package: python3-pip

- name: Ensure packaging is available
  apt:
    name: python3-packaging
    state: present

- name: Ensure pip_install_packages are installed
  loop_control:
    loop_var: package
  loop: "{{ pip_install_packages }}"
  block:
    - name: Ensure pip install package
      pip:
        name: "{{ package.name }}"
        version: "{{ package.version }}"
        virtualenv: "{{ package.virtualenv }}"
        state: "{{ package.state }}"
        extra_args: "{{ package.extra_args }}"
        executable: "{{ package.virtualenv is defined and package.virtualenv is not none | bool ? package.virtualenv + '/bin/pip' : pip_executable }}"
      vars:
        pip_executable: /usr/local/bin/pip3

