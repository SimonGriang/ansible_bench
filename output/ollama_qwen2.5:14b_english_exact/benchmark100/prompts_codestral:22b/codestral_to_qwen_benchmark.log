---
- import_tasks: assert.yml

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: enabled
  when: ansible_distribution == 'RedHat' and ansible_distribution_major_version == '8'

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    dest: /etc/redis/{{ redis_configuration_file }}
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes

