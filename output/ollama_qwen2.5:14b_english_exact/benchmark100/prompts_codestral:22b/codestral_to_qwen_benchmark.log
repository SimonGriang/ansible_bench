---
- import_tasks: assert.yml
  remote_addr: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ selinux_requirements }}"
  notify: refresh facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when:
    - selinux is defined
    - connection not in ['container', 'docker', 'community.docker']
  block:
    - name: Set selinux state and policy
      selinux:
        policy: "{{ selinux_policy }}"
        state: "{{ selinux_state }}"
      notify: reboot

- name: Manage selinux booleans
  when: selinux_booleans is defined
  loop: "{{ selinux_booleans }}"
  block:
    - name: Set selinux boolean
      selinux_boolean:
        name: "{{ item.name }}"
        state: "{{ item.state|default('yes') }}"
        persistent: "{{ item.persistent|default('yes') }}"


