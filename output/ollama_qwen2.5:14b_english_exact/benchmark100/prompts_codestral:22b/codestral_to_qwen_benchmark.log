---
- import_tasks: assert.yml
 delegate_to: localhost

- name: Install python pip
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ python_pip_packages }}"

- name: Configure pip proxy
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "index-url = {{ python_pip_proxy }}"
    create: true
    mode: '0644'
  when: python_pip_proxy is defined

- name: Trust hosts
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    create: true
    mode: '0644'
  when: python_pip_trusted_host is defined

- name: Update pip
  ansible.builtin.pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when:
    - python_pip_update == True
    - ansible_distribution != 'Bookworm'
    - ansible_distribution != 'Noble'
    - ansible_os_family != 'Alpine'

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    state: "{{ item.state|default('present') }}"
    version: "{{ item.version|default('') }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  loop_control:
    label: "{{ item.name }}"
  when:
    - ansible_distribution != 'Bookworm'
    - ansible_distribution != 'Noble'
    - ansible_os_family != 'Alpine'

