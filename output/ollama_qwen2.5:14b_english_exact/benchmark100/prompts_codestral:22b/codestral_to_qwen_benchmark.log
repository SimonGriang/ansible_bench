---
- name: password | Get efi path
  ansible.builtin.file:
    path: /boot/efi
    state: null
  register: efi_path

- name: password | Remove unwanted grub.cfg on EFI systems
  ansible.builtin.file:
    path: /boot/efi/EFI/debian/grub.cfg
    state: absent
  when: efi_path.stat.exists

- name: password | Install user template
  ansible.builtin.template:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    owner: root
    group: root
    mode: '0755'

- name: password | EFI | add password
  ansible.builtin.lineinfile:
    path: /etc/grub2-efi.cfg
    regexp: '^set superusers="[^"]*"'
    line: 'set superusers="{{ grub_user }}"'
  when: efi_path.stat.exists

- name: password | EFI | add password
  ansible.builtin.lineinfile:
    path: /etc/grub2-efi.cfg
    regexp: '^password_pbkdf2'
    line: 'password_pbkdf2 {{ grub_user }}{{ grub_password }}'
  when: efi_path.stat.exists

- name: password | MBR | add password
  ansible.builtin.lineinfile:
    path: /etc/grub2.cfg
    regexp: '^set superusers="[^"]*"'
    line: 'set superusers="{{ grub_user }}"'
  when: not efi_path.stat.exists

- name: password | MBR | add password
  ansible.builtin.lineinfile:
    path: /etc/grub2.cfg
    regexp: '^password_pbkdf2'
    line: 'password_pbkdf2 {{ grub_user }}{{ grub_password }}'
  when: not efi_path.stat.exists

- name: password | Add --unrestricted
  ansible.builtin.lineinfile:
    path: "{{ item }}"
    regexp: '^set superusers="[^"]*"'
    line: 'set superusers="{{ grub_user }}", --unrestricted'
  with_items: "{{ grub_password_unrestricted_files }}"
  when: grub_password_unrestricted == True

- name: password | Add --unrestricted
  ansible.builtin.lineinfile:
    path: "{{ item }}"
    regexp: '^password_pbkdf2'
    line: 'password_pbkdf2 {{ grub_user }}{{ grub_password }}, --unrestricted'
  with_items: "{{ grub_password_unrestricted_files }}"
  when: grub_password_unrestricted == True

