  tags:
    - ssl_combined
  register: private_key_part

- name: Append certificate content to combined file
  copy:
    content: "{{ ssl_cert_content.content | b64decode }}"
    dest: "{{ ssl_combined_path }}"
    mode: 600
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    remote_src: yes
    backup: yes
    args:
      mode: 0600
