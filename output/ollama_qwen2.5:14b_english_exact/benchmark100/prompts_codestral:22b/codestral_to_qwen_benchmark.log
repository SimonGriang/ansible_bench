        mode: '0755'

    - name: Download cadvisor binary from URL
      get_url:
        url: http://example.com/cadvisor
        dest: /opt/cadvisor/bin/cadvisor
        sha256sum: abcdef1234567890

    - name: Set executable permission on cadvisor binary
      file:
        path: /opt/cadvisor/bin/cadvisor
        mode: '0755'

- name: Propagate locally distributed cadvisor binary
  block:
    - name: Ensure cadvisor binary directory
      file:
        path: /opt/cadvisor/bin
        state: directory
        mode: '0755'

    - name: Copy cadvisor binary to application directory
      copy:
        src: /local/path/to/cadvisor
        dest: /opt/cadvisor/bin/cadvisor
        mode: '0755'
        owner: root
        group: root

    - name: Restart cadvisor service if binary updated
      systemd:
        name: cadvisor
        state: restarted
