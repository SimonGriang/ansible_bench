---
- name: Import assert.yml
  import_tasks: assert.yml
  remote_src: true
  vars:
    ansible_local: "{{ hostvars[inventory_hostname]['ansible_local'] }}"
  when: inventory_hostname == "localhost"

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  lineinfile:
    path: "{{ mysql_configuration_destination }}/mysql-server.cnf"
    line: "{{ item.key }} = {{ item.value }}"
    create: true
    mode: 0644
  with_dict: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  lineinfile:
    path: "{{ mysql_configuration_destination }}/mysql-client.cnf"
    line: "socket={{ mysql_socket }}"
    create: true
    mode: 0644

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_host: localhost
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    login_host: localhost
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers again
  meta: flush_handlers


