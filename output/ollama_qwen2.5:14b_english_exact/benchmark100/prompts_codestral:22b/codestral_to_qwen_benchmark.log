- name: Create SSL certificates
  openssl_certificate:
    path: "{{ ssl_cert_path }}"
    provider: selfsigned
    privatekey_path: "{{ ssl_key_path }}"
    csr_path: "{{ ssl_csr_path }}"
    mode: 640
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
  tags:
    - ssl_cert

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ ssl_pkcs12_path }}"
    certificate: "{{ ssl_cert_path }}"
    privatekey: "{{ ssl_key_path }}"
    name: "{{ ssl_common_name }}"
    mode: 600
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
  tags:
    - ssl_pkcs12

- name: Read private key
  slurp:
    src: "{{ ssl_key_path }}"
  register: ssl_key_content
  tags:
    - read_ssl_key

- name: Read certificate
  slurp:
    src: "{{ ssl_cert_path }}"
  register: ssl_cert_content
  tags:
    - read_ssl_cert

- name: Create combined private_key and certificate file
  copy:
    content: "{{ ssl_key_content.content | b64decode }}"
    dest: "{{ ssl_combined_path }}.key"
    mode: 600
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
  tags:
    - ssl_combined
  register: private_key_part

- name: Append certificate content to combined file
  copy:
    content: "{{ ssl_cert_content.content | b64decode }}"
    dest: "{{ ssl_combined_path }}"
    mode: 600
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    remote_src: yes
    backup: yes
    args:
      mode: 0600
      content: "{{ private_key_part.result['dest'] + ssl_cert_content.content | b64decode }}"
  tags:
    - ssl_combined

