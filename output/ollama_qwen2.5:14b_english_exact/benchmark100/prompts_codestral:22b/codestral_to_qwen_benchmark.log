---
- name: Assert role variables
  import_tasks: assert.yml

- name: Install git
  yum:
    name: "{{ git_packages }}"
    state: present
  when: ansible_facts.system.os_family == 'RedHat'

- name: Check if user exists
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: user_exists
  changed_when: false

- name: Create user's home directory
  file:
    path: "{{ home_directory }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0750'
  when: user_exists is succeeded

- name: Configure git
  template:
    src: "{{ git_config_file_template }}"
    dest: "{{ home_directory }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0644'
  when:
    - user_exists is succeeded
    - git_email is defined
    - git_name is defined
    - git_config_file_template is defined

- name: Create repository destination
  file:
    path: "{{ git_repo_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0750'
  when:
    - user_exists is succeeded
    - git_repo_destination is defined

- name: Clone repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repo_destination }}"
    version: "{{ item.version }}"
    update: yes
    clone: yes
    ssh_key: "{{ git_ssh_key }}"
    key_file: "{{ git_ssh_key_file }}"
    accept_hostkey: yes
    force_basic_auth: yes
    track_submodules: yes
    module_name: git
    remote_name: origin
    force_update: yes
    username: "{{ git_username }}"
    password: "{{ git_password }}"
    email: "{{ git_email }}"
    name: "{{ git_name }}"
  loop: "{{ git_repositories }}"
  when:
    - user_exists is succeeded
    - git_repo_destination is defined
    - git_repositories is defined


