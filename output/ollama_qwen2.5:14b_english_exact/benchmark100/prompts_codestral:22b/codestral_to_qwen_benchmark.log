---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Wait for port to be available
  wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout | default(300) }}"

- name: Prepare system
  block:
    - name: Test the connection
      ping:
    - name: Test if sudo is available
      command: sudo whoami
      register: sudo_test
      changed_when: false
      failed_when: sudo_test.rc != 0
    - name: Gather bootstrap facts
      setup:
