- name: Install nginx
  ansible.builtin.package:
    name: nginx
    state: present

- name: Place nginx.conf
  ansible.builtin.template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: '0644'  # Adding mode to fix ansible-lint issue
  register: nginx_conf
  notify: restart nginx

- name: Ensure /etc/nginx/conf.d exists
  ansible.builtin.file:
    path: /etc/nginx/conf.d
    state: directory
    mode: '0755'

- name: Place default.conf
  ansible.builtin.template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'  # Adding mode to fix ansible-lint issue
  register: default_conf
  notify: restart nginx

- name: Start and enable nginx
  ansible.builtin.service:
    name: nginx
    state: started
    enabled: true

# Note: The '# New line at end of file' is implied by the structure above.

