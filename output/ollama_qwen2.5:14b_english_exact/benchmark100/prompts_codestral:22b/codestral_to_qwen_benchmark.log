---
- name: Create Vault group
  ansible.builtin.group:
    name: vault_group

- name: Create Vault user
  ansible.builtin.user:
    name: vault_user
    group: vault_group
    createhome: false

- name: Create Vault download directory
  ansible.builtin.file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: '0750'
    owner: vault_user
    group: vault_group

- name: Download Vault binary
  ansible.builtin.unarchive:
    src: "{{ vault_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: true
    atime: false
    ctime: false
  register: vault_download
  changed_when: vault_download is defined and vault_download.changed

- name: Check if vault_path exists
  ansible.builtin.stat:
    path: "{{ vault_path }}"
  register: vault_path_exists

- name: Create vault_path if it does not exist
  ansible.builtin.file:
    path: "{{ vault_path }}"
    state: directory
    mode: '0750'
    owner: vault_user
    group: vault_group
  when: vault_path_exists.stat.exists is not defined and vault_path is defined

- name: Create directories in vault_path
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ vault_directories }}"
  notify: Restart vault

- name: Create data directories
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ vault_data_directories }}"
  notify: Restart vault

- name: Generate TLS key and certificate
  ansible.builtin.command: >
    openssl req -x509 -newkey rsa:4096 -keyout vault_data_directory/tls/vault.key -out vault_data_directory/tls/vault.crt -days 365 -nodes -subj "/CN=vault"
  args:
    creates: vault_data_directory/tls/vault.crt
  register: tls_generation
  notify: Restart vault
  when: tls_generation is defined and tls_generation.changed

- name: Set ownership of tls material
  ansible.builtin.file:
    path: "{{ item.path }}"
    owner: vault_user
    group: vault_group
    mode: '0640'
  with_items: "{{ vault_tls_files }}"
  notify: Restart vault

- name: Copy Vault binary
  ansible.builtin.copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0750'
  register: copy_vault
  notify: Restart vault
  when: copy_vault is defined and copy_vault.changed

- name: Set capabilities on /usr/bin/vault
  community.general.capabilities:
    path: /usr/bin/vault
    capability: cap_ipc_lock=ep

- name: Touch vault.env
  ansible.builtin.file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    mode: '0644'
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  ansible.builtin.file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'

- name: Copy Vault service file
  ansible.builtin.copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: '0644'
  notify: Daemon reload

- name: Copy vault configuration
  ansible.builtin.copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: '0644'
  notify: Restart vault

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers


