---
- name: Install Keepalived
  include_tasks: keepalived.yml
  when: ha_mode|default('disabled') == 'enabled' and inventory_hostname in groups['rke2_servers'] and ha_mode == 'keepalived'

- name: Install RKE2
  block:
    - name: Download and install RKE2
      # Task details for downloading and installing RKE2 would be specified here
      # This is a placeholder for actual task details

- name: Apply CIS Hardening
  include_tasks: cis.yml
  when: cis_profile is defined

- name: Identify Active Server
  include_tasks: find_active_server.yml

- name: Enable IPVS Kernel Module
  include_tasks: enable_ipvs_module.yml
  when: load_balancing_mode == 'ipvs' and inventory_hostname in groups['rke2_servers'] and ha_mode == 'kubevip' and ha_mode != 'keepalived'

- name: Copy Kube-vip Manifests
  include_tasks: copy_kubevip_manifests.yml
  when: inventory_hostname == groups['rke2_servers'][0] and ha_mode == 'kubevip' and ha_mode != 'keepalived'

- name: Copy Ingress-nginx Manifests
  include_tasks: copy_ingress_nginx_manifests.yml
  when: inventory_hostname == groups['rke2_servers'][0] and ingress_nginx_values is defined

- name: Prepare First Server Node
  include_tasks: prepare_first_server_node.yml
  when: inventory_hostname == groups['rke2_servers'][0] and active_server is not defined and groups['rke2_servers']|length == 1

- name: Restore etcd
  include_tasks: first_server_restore.yml
  when: active_server is defined and (inventory_hostname == active_server or inventory_hostname == groups['rke2_servers'][0]) and etcd_restore is needed

- name: Download kubeconfig
  include_tasks: download_kubeconfig.yml
  when: download_kubeconfig is enabled and inventory_hostname == groups['rke2_servers'][0]

- name: Prepare and Join Remaining Nodes
  include_tasks: prepare_and_join_remaining_nodes.yml
  when: active_server is defined and groups['rke2_servers']|length >= 2

- name: Rolling Restart Servers
  include_tasks: rolling_restart.yml
  when: installed_version != running_version and inventory_hostname in groups['rke2_servers']

- name: Rolling Restart Agents
  include_tasks: rolling_restart.yml
  when: installed_version != running_version and inventory_hostname not in groups['rke2_servers']

- name: Flush Handlers
  meta: flush_handlers

- name: Rolling Restart Config Change
  include_tasks: change_config.yml
  when: restart_needed_due_to_config_change

- name: Final Steps
  include_tasks: final_steps.yml

