content='---\n- name: Create document root directories\n  file:\n    path: "{{ item.documentroot }}"\n    state: directory\n    mode: \'0755\'\n  loop: "{{ httpd_vhosts }}"\n  loop_control:\n    label: "{{ item.documentroot }}"\n  when: item.documentroot is defined\n  notify: validate-httpd-config\n\n- name: Configure virtual hosts\n  template:\n    src: "vhosts.d/{{ item.name }}.conf.j2"\n    dest: "/etc/httpd/conf/vhosts.d/{{ item.name }}.conf"\n    mode: \'0644\'\n  loop: "{{ httpd_vhosts }}"\n  loop_control:\n    label: "{{ item.name }}"\n  notify: validate-httpd-config\n\n- name: Enable virtual hosts on Debian systems\n  command: a2ensite {{ item.name }}\n    creates: "/etc/apache2/sites-enabled/{{ item.name }}.conf"\n  loop: "{{ httpd_vhosts }}"\n  loop_control:\n    label: "{{ item.name }}"\n  when: ansible_os_family == "Debian"\n  notify: validate-httpd-config' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-15T10:43:11.63496959Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3957285880, 'load_duration': 87618626, 'prompt_eval_count': 589, 'prompt_eval_duration': 249809376, 'eval_count': 229, 'eval_duration': 3614116357, 'model_name': 'qwen2.5:14b'} id='run--b479d519-a8da-491a-a40b-c9c77a4de120-0' usage_metadata={'input_tokens': 589, 'output_tokens': 229, 'total_tokens': 818}
