---
- name: Update package cache
  block:
    - name: Update apt package cache
      apt:
        update_cache: yes
      when: ansible_os_family == 'Debian'
    - name: Update dnf package cache
      yum:
        update_cache: yes
      when: ansible_os_family == 'RedHat'

- name: Install keepalived package
  package:
    name: keepalived
    state: present

- name: Create keepalived directory
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Create Kubernetes API health check script for Debian OS family
  template:
    src: debian-kubernetes-api-health-check.sh.j2
    dest: /etc/keepalived/kubernetes-api-health-check.sh
    owner: root
    group: root
    mode: '0755'
  notify: restart_keepalived
  when: ansible_os_family == 'Debian'

- name: Create Kubernetes API health check script for RedHat OS family
  template:
    src: redhat-kubernetes-api-health-check.sh.j2
    dest: /usr/libexec/keepalived/kubernetes-api-health-check.sh
    owner: root
    group: root
    mode: '0755'
  notify: restart_keepalived
  when: ansible_os_family == 'RedHat'

- name: Create RKE2 Server health check script for Debian OS family
  template:
    src: debian-rke2-server-health-check.sh.j2
    dest: /etc/keepalived/rke2-server-health-check.sh
    owner: root
    group: root
    mode: '0755'
  notify: restart_keepalived
  when: ansible_os_family == 'Debian'

- name: Create RKE2 Server health check script for RedHat OS family
  template:
    src: redhat-rke2-server-health-check.sh.j2
    dest: /usr/libexec/keepalived/rke2-server-health-check.sh
    owner: root
    group: root
    mode: '0755'
  notify: restart_keepalived
  when: ansible_os_family == 'RedHat'

- name: Create keepalived configuration file
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: '0644'
  notify: restart_keepalived

- name: Enable and unmask keepalived service
  systemd:
    name: keepalived
    enabled: yes
    masked: no
  notify: restart_keepalived

- name: Flush handlers
  meta: flush_handlers

