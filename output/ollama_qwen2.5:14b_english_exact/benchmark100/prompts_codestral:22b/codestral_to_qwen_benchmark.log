- name: Create SSL CSR
  openssl_csr:
    path: "{{ ssl_csr_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    country_name: "{{ ssl_country_name }}"
    state_or_province_name: "{{ ssl_state_or_province_name }}"
    locality_name: "{{ ssl_locality_name }}"
    organization_name: "{{ ssl_organization_name }}"
    common_name: "{{ ssl_common_name }}"
    mode: 640
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
  tags:
    - ssl_csr

- name: Create SSL certificates
  openssl_certificate:
    path: "{{ ssl_cert_path }}"
    provider: selfsigned
    privatekey_path: "{{ ssl_key_path }}"
    csr_path: "{{ ssl_csr_path }}"
    mode: 640
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
  tags:
    - ssl_cert

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ ssl_pkcs12_path }}"
    certificate: "{{ ssl_cert_path }}"
    privatekey: "{{ ssl_key_path }}"
    name: "{{ ssl_common_name }}"
    mode: 600
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
  tags:
    - ssl_pkcs12

- name: Read private key
  slurp:
    src: "{{ ssl_key_path }}"
  register: ssl_key_content
  tags:
    - read_ssl_key

- name: Read certificate
  slurp:
    src: "{{ ssl_cert_path }}"
  register: ssl_cert_content
  tags:
    - read_ssl_cert

- name: Create combined private_key and certificate file
  copy:
    content: "{{ ssl_key_content.content | b64decode }}"
    dest: "{{ ssl_combined_path }}.key"
    mode: 600
    owner: "{{ ssl_owner }}"
