---
- name: Migrate Java JDK vendor from 'adoptopenjdk' to 'temurin' if selected
  ansible.builtin.set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS-specific variables for Java
  ansible.builtin.include_vars:
    file: "{{ java_jdk_vendor }}.yml"

- name: Gather architecture-specific variables for Java
  ansible.builtin.include_vars:
    file: "architecture.yml"

- name: Set OS-specific variables for Java (I)
  ansible.builtin.set_fact:
    java_package_version: "8"
    java_package: "openjdk-8-jdk"
    java_home: "/usr/lib/jvm/java-8-openjdk-amd64"
  when: (java_package_version is not defined) or (java_package is not defined) or (java_home is not defined)

- name: Set OS and architecture-specific variables for Java (II)
  ansible.builtin.set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Handle Debian pre-requisites for Java
  block:
    - name: Remove deprecated repositories
      ansible.builtin.yum:
        name: "{{ item }}"
        state: absent
      loop: "{{ java_deprecated_repositories }}"
      when: ansible_os_family == "RedHat"

    - name: Install extra apt tools
      ansible.builtin.apt:
        name: apt-transport-https
        state: present
      when: ansible_os_family == "Debian"

    - name: Add required key repositories
      ansible.builtin.apt_key:
        url: "{{ item.key_url }}"
      loop: "{{ java_key_repositories }}"
      when: ansible_os_family == "Debian"

    - name: Add required repositories
      ansible.builtin.apt_repository:
        repo: "{{ item.repo_url }}"
        state: present
      loop: "{{ java_repositories }}"
      when: ansible_os_family == "Debian"
  when: ansible_os_family == "Debian"

- name: Handle RedHat pre-requisites for Java
  block:
    - name: Add required key repositories
      ansible.builtin.rpm_key:
        key: "{{ item.key_url }}"
      loop: "{{ java_key_repositories }}"
      when: ansible_os_family == "RedHat"

    - name: Add required repositories
      ansible.builtin.yum_repository:
        name: "{{ item.repo_name }}"
        description: "{{ item.repo_description }}"
        baseurl: "{{ item.repo_url }}"
        enabled: yes
      loop: "{{ java_repositories }}"
      when: ansible_os_family == "RedHat"
  when: ansible_os_family == "RedHat"

- name: Install required libraries for Java
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libraries }}"

- name: Install Java on Debian
  block:
    - name: Update apt cache
      ansible.builtin.apt:
        update_cache: yes

    - name: Install Java package
      ansible.builtin.apt:
        name: "{{ java_package }}"
        state: present
  when: ansible_os_family == "Debian"

- name: Install Java on RedHat
  block:
    - name: Update yum cache
      ansible.builtin.yum:
        name: "@System"
        state: latest

    - name: Install Java package
      ansible.builtin.yum:
        name: "{{ java_package }}"
        state: present
  when: ansible_os_family == "RedHat"

- name: Export environment variables for Java
  ansible.builtin.template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh

- name: Source environment variables for Java
  ansible.builtin.shell: source /etc/profile.d/jdk.sh

- name: Correct Java version selected for Java < 11
  ansible.builtin.alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    link: /usr/bin/java
    priority: 1
  when: java_package_version | int < 11

- name: Correct Java version selected for Java >= 11
  ansible.builtin.alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    link: /usr/bin/java
    priority: 1
  when: java_package_version | int >= 11

