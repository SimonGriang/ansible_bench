---
- name: Ensure apt key is not present
  apt_key:
    keyserver: keyserver.ubuntu.com
    key: 'DOCKER-GPG-KEY'
    state: absent

- name: Ensure old apt source list is not present
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure old versions of Docker are not installed
  package:
    name: docker.io
    state: absent
  when: ansible_os_family == 'Debian'

- name: Ensure legacy repo file is not present
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure dependencies are installed
  package:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Add or remove Docker repository
  block:
    - name: Add Docker repository
      apt_repository:
        filename: /etc/apt/sources.list.d/docker.list
        filename_deb822: yes
        repo: "deb [arch={{ ansible_architecture }}] https://download.docker.com/linux/{{ ansible_distribution|lower }} {{ ansible_distribution_release }} stable"
        state: present
      when: docker_add_repo is defined and docker_add_repo|lower == 'true'

    - name: Remove Docker repository
      apt_repository:
        filename: /etc/apt/sources.list.d/docker.list
        filename_deb822: yes
        state: absent
      when: docker_add_repo is defined and docker_add_repo|lower == 'false'

- name: Ensure handlers are notified immediately to update the apt cache
  meta:
    flush_handlers: true

