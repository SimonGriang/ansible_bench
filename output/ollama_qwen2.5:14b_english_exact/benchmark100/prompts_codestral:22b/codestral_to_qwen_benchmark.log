---
- import_tasks: assert.yml

- name: Install dns
  package:
    name: bind9
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: '/var/cache/bind', mode: '0755', owner: 'root', group: 'bind' }
    - { path: '/etc/bind', mode: '0755', owner: 'root', group: 'bind' }
    - { path: '/var/lib/bind', mode: '0755', owner: 'root', group: 'bind' }

- name: Create group
  group:
    name: bind
    state: present

- name: Create user
  user:
    name: bind
    uid: 105
    system: yes
    state: present

- name: Generate rndc key
  command: rndc-confgen -a -r /dev/urandom -k bind9 -c /etc/bind/rndc.key
  args:
    creates: /etc/bind/rndc.key

- name: Set permissions on rndc key file
  file:
    path: /etc/bind/rndc.key
    mode: '0640'
    owner: root
    group: bind

- name: Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.cache
    dest: /var/cache/bind/db.root
  when: cache_dns_enabled

- name: Create zone file
  template:
    src: zone.j2
    dest: /var/lib/bind/{{ item }}
  loop: "{{ dns_zones_primary }}"
  when: dns_zones_primary|length > 0

- name: Add zones to configuration
  template:
    src: named.conf.options.j2
    dest: /etc/bind/named.conf.options

- name: Place systemd override
  copy:
    src: bind9.service
    dest: /etc/systemd/system/bind9.service.d/override.conf
    mode: '0644'
  when: service_manager == 'systemd'

- name: Start and enable dns
  systemd:
    name: bind9
    enabled: yes
    state: started

