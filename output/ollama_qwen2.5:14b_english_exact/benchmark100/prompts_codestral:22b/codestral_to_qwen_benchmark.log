---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install prerequisites
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ vault_prerequisites }}"

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item.name }}={{ item.value }}"
    create: yes
  loop: "{{ vault_environment_settings }}"
  notify: restart vault

- name: Include hardening tasks
  include_tasks: hardening.yml

- name: Start and enable vault
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable vault
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type != "oss"

- name: Enable vault
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type != "oss"
  changed_when: false  # To avoid duplicate notifications if the state is already as desired

handlers:
  - name: restart vault
    service:
      name: vault
      state: restarted

