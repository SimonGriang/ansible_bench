---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure Debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: "No configuration"
    vtype: select
  when: ansible_os_family == 'Debian'

- name: Install postfix
  apt:
    name: postfix
    state: present
  when: ansible_os_family == 'Debian'

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: postfix_use_mysql|default('false')|bool

- name: Configure postfix (transport_maps)
  template:
    src: postfix_transport_maps.j2
    dest: /etc/postfix/transport
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: postfix_header_checks.j2
    dest: /etc/postfix/header_checks
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf
  set_fact:
    postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions|default(['permit_mynetworks', 'permit_sasl_authenticated', 'reject_unauth_destination']) }}"
    postfix_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions|default(['permit_mynetworks', 'permit_sasl_authenticated']) }}"

- name: Configure postfix (main.cf)
  template:
    src: postfix_main.cf.j2
    dest: /etc/postfix/main.cf
  notify: validate_main_cf

- name: Configure postfix (master.cf)
  template:
    src: postfix_master.cf.j2
    dest: /etc/postfix/master.cf
  notify: validate_master_cf

- name: Create cert/key directory
  file:
    path: "{{ postfix_smtpd_tls_cert_file|dirname }}"
    state: directory
    mode: '0750'
    owner: postfix
    group: postfix
  when: postfix_smtpd_tls_cert_file is defined and postfix_smtpd_tls_cert_file != ''
  notify: update_permissions

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0640'
    owner: postfix
    group: postfix
  when: postfix_smtpd_tls_cert_file_source is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0640'
    owner: postfix
    group: postfix
  when: postfix_smtpd_tls_key_file_source is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: postfix_aliases.j2
    dest: /etc/postfix/aliases
  when: postfix_aliases is defined

- name: Configure sender_access
  template:
    src: postfix_sender_access.j2
    dest: /etc/postfix/sender_access
  when: postfix_sender_access is defined

- name: Configure recipient_access
  template:
    src: postfix_recipient_access.j2
    dest: /etc/postfix/recipient_access
  when: postfix_recipient_access is defined

- name: Place sasl_password_map
  copy:
    src: "{{ postfix_smtp_sasl_password_map }}"
    dest: /etc/postfix/sasl_password
  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map != ''
  notify: update_permissions

- name: Flush handlers (again)
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes

