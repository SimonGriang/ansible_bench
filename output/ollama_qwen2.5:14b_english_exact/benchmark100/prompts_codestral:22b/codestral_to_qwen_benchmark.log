- name: Install epel
  yum:
    name: epel-release
    state: present
  when: ansible_os_family == 'RedHat' and ansible_distribution_major_version is version in ['7', '8', '9', '10'] or ansible_os_family == 'Amazon' and ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2'

