  when: ansible_os_family == 'RedHat' and ansible_package_state == 'present'
  include_tasks: setup-RedHat.yml

- name: Set Up Ansible on Fedora
  when: ansible_os_family == 'RedHat' and ansible_distribution == 'Fedora' and ansible_package_state == 'present'
  include_tasks: setup-Fedora.yml

- name: Set Up Ansible on Ubuntu
  when: ansible_os_family == 'Debian' and ansible_distribution == 'Ubuntu' and ansible_package_state == 'present'
  include_tasks: setup-Ubuntu.yml

- name: Set Up Ansible on Debian
  when: ansible_os_family == 'Debian' and ansible_distribution == 'Debian' and ansible_package_state == 'present'
  include_tasks: setup-Debian.yml

- name: Set Up Ansible using Pip
  when: ansible_package_state == 'absent'
  include_tasks: setup-pip.yml

