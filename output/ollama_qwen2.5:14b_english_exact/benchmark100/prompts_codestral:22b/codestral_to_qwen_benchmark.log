---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  remote_addr: localhost

- name: Configure apk
  when: ansible_pkg_mgr == 'apk'
  package:
    name: "{{ 'apk-tools-upgraded' if ansible_os_family == 'Alpine' else 'all' }}"
    state: latest
  notify: Reboot

- name: Configure apt
  when: ansible_pkg_mgr == 'apt'
  block:
    - name: Prevent upgrade for selected packages
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ update_prevent_upgrades }}"
      when: update_prevent_upgrades is defined and update_prevent_upgrades|length > 0

    - name: Update cache
      apt:
        update_cache: yes
        cache_valid_time: "{{ update_cache_valid_time }}"
      register: update_result

    - name: Upgrade all software
      apt:
        upgrade: yes
        upgrade_until_date: "{{ update_cache_valid_time }}"
      when: update_result.changed

    - name: Autoremove packages
      apt:
        autoremove: yes
      when: update_autoremove|default(false)

  notify: Reboot

- name: Update all software (dnf)
  when: ansible_pkg_mgr in ['dnf', 'dnf5']
  package:
    name: "{{ '-'.join(update_excluded_packages)|d([])|reject('search', '^$') }}"
    state: absent
  loop_control:
    loop_var: excluded_package
  loop: "{{ update_excluded_packages }}"
  when: update_excluded_packages is defined and update_excluded_packages|length > 0
  ignore_errors: yes
  register: excluded_packages

- name: Update all software (dnf)
  when: ansible_pkg_mgr in ['dnf', 'dnf5']
  package:
    name: "{{ 'all' }}"
    state: latest
    exclude: "{{ excluded_packages.results|json_query('[].excluded_package')|join(',') }}"
  notify: Reboot

- name: Update all software (pacman)
  when: ansible_pkg_mgr == 'pacman'
  block:
    - name: Update cache
      pacman:
        update_cache: yes

    - name: Upgrade all software
      pacman:
        upgrade: yes
  notify: Reboot

- name: Configure yum
  when: ansible_pkg_mgr == 'yum'
  block:
    - name: Update all software
      yum:
        name: '*'
        state: latest
        exclude: "{{ update_excluded_packages|join(',') }}"
      notify: Reboot

    - name: Install yum-utils
      yum:
        name: yum-utils
        state: present
      when: ansible_distribution_major_version != '6'

- name: Update all software (zypper)
  when: ansible_pkg_mgr == 'zypper'
  package:
    name: "{{ 'all' }}"
    state: latest
  notify: Reboot

