---
- name: gather_facts | Lookup bootstrap facts
  shell: "grep '^VERSION_ID' /etc/os-release | cut -d'=' -f2"
  register: bootstrap_facts
  when: ansible_check_mode is not defined or not ansible_check_mode

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.1 }}"
    bootstrap_major_version: "{{ item.0.version|default('') }}"
  when:
    - bootstrap_facts.stdout is defined
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
  with_items:
    - [ { "version": "7", "distribution": "CentOS" }, { "version": "18.04", "distribution": "Ubuntu" }, { "version": "20.04", "distribution": "Ubuntu" }]
  when: bootstrap_facts.stdout is search("{{ item.1 }}")
  loop_control:
    extended: true

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  when:
    - bootstrap_distribution is defined
  loop: "{{ {'CentOS': 'RedHat', 'Ubuntu': 'Debian' } | dict2items }}"
  when: bootstrap_distribution == item.key

