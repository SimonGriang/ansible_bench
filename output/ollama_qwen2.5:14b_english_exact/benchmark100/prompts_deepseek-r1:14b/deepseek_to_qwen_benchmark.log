- name: Create git config directory
  ansible.builtin.file:
    path: "{{ user_home }}/.gitconfig"
    state: directory
    mode: '0700'
    owner: "{{ user }}"
    group: "{{ user }}"

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "{{ user_home }}/.gitconfig"
    mode: '0600'
    owner: "{{ user }}"
    group: "{{ user }}"

- name: Create repository destination
  ansible.builtin.file:
    path: "{{ repo_dest }}"
    state: directory
    mode: '0755'
    owner: "{{ user }}"
    group: "{{ user }}"

- name: Clone all repositories
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version }}"
    update: true
    clone: true
    force: true
    accept_hostkey: true
    ssh_key: "{{ ssh_key }}"
    force_basic_auth: true
    user: "{{ user }}"
  with_items: "{{ repos }}"
  become: true
  become_user: "{{ user }}"

