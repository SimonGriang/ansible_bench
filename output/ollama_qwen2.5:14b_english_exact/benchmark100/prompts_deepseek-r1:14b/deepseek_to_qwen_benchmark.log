---
- name: Check if EFI firmware exists on the system
  ansible.builtin.stat:
    path: /sys/firmware/efi/efivars/

- name: Remove GRUB configuration file on EFI systems
  ansible.builtin.file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: ansible_facts['stat']['efivars']['exists']

- name: Install custom user template for GRUB
  ansible.builtin.copy:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    mode: '0755'

- name: Add EFI password protection to GRUB
  ansible.builtin.lineinfile:
    path: /etc/grub2-efi.cfg
    line: 'set superusers="root"; password_pbkdf2 root {{ grub_efi_password }}'
    insertafter: '^\['
    regexp: '^set superusers="root"; password_pbkdf2 root .*$'
  when: ansible_facts['stat']['efivars']['exists']

- name: Add MBR password protection to GRUB
  ansible.builtin.lineinfile:
    path: /etc/grub2.cfg
    line: 'set superusers="root"; password_pbkdf2 root {{ grub_mbr_password }}'
    insertafter: '^\['
    regexp: '^set superusers="root"; password_pbkdf2 root .*$'
  when: not ansible_facts['stat']['efivars']['exists']

- name: Add unrestricted access to GRUB password entries
  ansible.builtin.replace:
    path: /etc/grub2-efi.cfg
    regexp: '^password_pbkdf2 root .*$'
    replace: 'password_pbkdf2 --unrestricted root {{ grub_efi_password }}'
  when: ansible_facts['stat']['efivars']['exists'] and unrestricted

- name: Add unrestricted access to GRUB password entries for MBR
  ansible.builtin.replace:
    path: /etc/grub2.cfg
    regexp: '^password_pbkdf2 root .*$'
    replace: 'password_pbkdf2 --unrestricted root {{ grub_mbr_password }}'
  when: not ansible_facts['stat']['efivars']['exists'] and unrestricted

