---
- name: Include OS-specific variables
  include_vars:
    dir: vars
    name: "{{ ansible_distribution }}-{{ ansible_os_family }}"

- name: Include OS family specific tasks
  include_tasks: "{{ ansible_os_family }}.yml"

- name: Install Docker packages
  ansible.builtin.package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  when:
    - ansible_version is version_compare('<2.12')
    - ansible_distribution not in ['RedHat', 'Debian']

- name: Install Docker packages with downgrade option
  ansible.builtin.package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    force: yes
  notify: restart docker
  when:
    - ansible_version is version_compare('>=2.12')
    - ansible_distribution in ['RedHat', 'Debian']

- name: Install docker-compose plugin
  ansible.builtin.package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  when:
    - docker_install_compose_plugin is defined
    - docker_install_compose_plugin is true
    - ansible_version is version_compare('<2.12')
    - ansible_distribution not in ['RedHat', 'Debian']

- name: Install docker-compose-plugin with downgrade option
  ansible.builtin.package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    force: yes
  notify: restart docker
  when:
    - docker_install_compose_plugin is defined
    - docker_install_compose_plugin is true
    - ansible_version is version_compare('>=2.12')
    - ansible_distribution in ['RedHat', 'Debian']

- name: Ensure /etc/docker directory exists
  ansible.builtin.file:
    path: /etc/docker
    state: directory
    mode: 0755
  when: docker_daemon_options is defined

- name: Configure Docker daemon options
  ansible.builtin.copy:
    content: "{{ docker_daemon_options | to_json }}"
    dest: /etc/docker/daemon.json
    mode: 0644
  notify: restart docker
  when: docker_daemon_options is defined

- name: Ensure Docker service is started and enabled
  ansible.builtin.service:
    name: docker
    state: "{{ 'started' if docker_service_manage else 'stopped' }}"
    enabled: "{{ 'yes' if docker_service_manage else 'no' }}"
  ignore_errors: "{{ ansible_check_mode }}"
  when: docker_service_manage is defined and docker_service_manage

- name: Flush handlers to avoid firewall conflicts
  ansible.builtin.meta:
    flush_handlers: true

- name: Include docker-compose.yml tasks
  ansible.builtin.include_tasks: docker-compose.yml
  when: docker_install_compose is defined and docker_install_compose

- name: Get docker group information
  ansible.builtin.getent:
    database: group
    key: docker
  when: users_to_add is defined

- name: Set fact for user modification
  ansible.builtin.set_fact:
    users_need_modification: true
  when:
    - users_to_add is defined
    - users_to_add | select('not in', docker_group_members) | list | length > 0

- name: Include docker-users.yml tasks
  ansible.builtin.include_tasks: docker-users.yml
  when: users_need_modification is defined and users_need_modification

