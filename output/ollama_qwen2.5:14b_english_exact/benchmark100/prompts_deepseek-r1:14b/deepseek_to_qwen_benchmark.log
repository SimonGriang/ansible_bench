---
- name: Install EPEL GPG key
  yum:
    repoquery: epel
    disable_gpg_check: true
  when: ansible_os_family == "RedHat" and (ansible_distribution_major_version in ["7", "8", "9"] or ansible_distribution == "Amazon")
  register: epel_repo_query
  changed_when: epel_repo_query is not defined
  no_log: false

- name: Add EPEL GPG key to system
  rpm_key:
    key: "{{ epel_gpg_key }}"
  when: ansible_os_family == "RedHat" and (ansible_distribution_major_version in ["7", "8", "9"] or ansible_distribution == "Amazon")

- name: Install EPEL release package
  yum:
    name: "{{ epel_url }}"
    state: installed
  when: ansible_os_family == "RedHat" and (ansible_distribution_major_version in ["7", "8", "9"] or ansible_distribution == "Amazon")

- name: Install EPEL next release package (conditional)
  yum:
    name: "{{ epel_next_url }}"
    state: installed
  when: ansible_os_family == "RedHat" and (ansible_distribution_major_version in ["7", "8", "9"] or ansible_distribution == "Amazon") and epel_next is True

- name: Update package cache
  yum:
    update_cache: yes
  notify: Update package cache
  when: ansible_os_family == "RedHat" and (ansible_distribution_major_version in ["7", "8", "9"] or ansible_distribution == "Amazon")

