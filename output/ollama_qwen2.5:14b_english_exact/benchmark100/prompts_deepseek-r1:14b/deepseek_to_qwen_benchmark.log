---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: inventory_hostname == groups['bootstrap'][0]

- name: Prepare system
  raw: whoami; sudo whoami
  changed_when: false
  delegate_to: localhost
  failed_when: "'root' not in (ansible_facts['whoami'] + ansible_facts['sudo_whoami'])"
  when: not ansible_facts['whoami'] | default([])

- name: Gather ansible facts
  setup:
  become: false

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become }}"
  when: bootstrap_facts_packages is defined and bootstrap_facts_packages | length > 0

