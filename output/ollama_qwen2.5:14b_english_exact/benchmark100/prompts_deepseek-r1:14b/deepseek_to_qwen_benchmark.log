---
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_system == 'systemd'
    fail_msg: "Systemd is not detected as the init system."

- name: Get latest release and set promtail version
  get_url:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: true
  register: latest_release
  delegate_to: localhost
  changed_when: false
  failed_when: false
  tags: promtail

- name: Set promtail_version variable based on the latest release tag
  set_fact:
    promtail_version: "{{ (latest_release.json.tag_name | regex_replace('^v', '') | community.general.truncate(length=8, killwords=True, leeway=0) ) }}"

- name: Test if zip local archive exists and assert local binary exists
  command: test -f /path/to/local/archive.zip
  register: check_zip
  changed_when: false
  failed_when: false
  tags: promtail

- name: Assert presence of local binary archive
  assert:
    that:
      - check_zip.rc == 0
    fail_msg: "Local binary archive does not exist."

- name: Get checksum list and set checksum for target architecture
  get_url:
    url: https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/promtail-{{ promtail_version }}.{{ ansible_architecture }}.sha256sum
    return_content: true
  register: checksum_list
  delegate_to: localhost
  tags: promtail

- name: Set checksum value for target architecture
  set_fact:
    promtail_checksum: "{{ checksum_list.content.splitlines()[0].split()[0] }}"

