---
- name: Import assertion file
  import_tasks: assert.yml
  run_once: true
  remote_addr: localhost

- name: Install system requirements
  package:
    name: bash
    state: present

- name: Install OpenJDK Java
  when: java_vendor == "openjdk"
  package:
    name: "{{ 'openjdk-' ~ ansible_distribution_major_version ~ '-jre' if ansible_os_family == 'RedHat' else 'openjdk-jre' }}"
    state: present

- name: Install Oracle Java RPM from local
  when: java_source == "local" and java_format == "rpm"
  copy:
    src: "{{ java_rpm_path }}"
    dest: "/tmp/{{ java_rpm_filename }}"
  notify: Install Oracle Java RPM from local

- name: Install Oracle Java DEB from local
  when: java_source == "local" and java_format == "deb"
  copy:
    src: "{{ java_deb_path }}"
    dest: "/tmp/{{ java_deb_filename }}"
  notify: Install Oracle Java DEB from local

- name: Install Oracle Java RPM from repository
  when: java_source == "repository" and java_format == "rpm"
  package:
    name: "{{ oracle_java_rpm_package }}"
    state: present

- name: Configure Oracle Java targz installation
  when: java_format == "targz" and java_vendor == "oracle"
  unarchive:
    src: "{{ oracle_java_targz_path }}"
    dest: "/opt/java"
    remote_src: yes
  notify: Set Java alternative

- name: Install Oracle Java JCE policy
  when: java_jce and java_version == 8 and java_vendor == "oracle"
  copy:
    src: "{{ jce_policy_path }}"
    dest: "{{ java_home }}/jre/lib/security"
    owner: root
    group: root
    mode: 0644

- name: Set Java alternative
  when: java_format == "targz" and ansible_distribution != "Alpine"
