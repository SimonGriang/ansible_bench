---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  ansible.builtin.shell: |
    apk update && apk upgrade -a --no-progress
  changed_when: False

- name: Configure apt
  ansible.builtin.apt:
    update_cache: yes
    upgrade: full
    options: '-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold'
    install_recommends: no

- name: Update all software (dnf)
  ansible.builtin.dnf:
    name: '@{dnf}'
    exclude: kernel* kernel-core* kernel-devel* kernel-headers* kernel-rt* kernel-rt-core* kernel-modules* kernel-modules-extra*
    state: latest

- name: Update all software (pacman)
  ansible.builtin.pacman:
    sync: system
    upgrade: full

- name: Configure yum
  ansible.builtin.yum:
    name: '@{dnf}'
    state: latest
  when: ansible_distribution_major_version != "6"
  vars:
    yum_package_manager: yum
  block:
    - name: Ensure yum-utils is installed
      ansible.builtin.yum:
        name: yum-utils
        state: present
    - name: Update all software (dnf)
      ansible.builtin.dnf:
        name: '@{dnf}'
        state: latest
  rescue:
    - name: Use yum for non-CentOS/RHEL 6
      ansible.builtin.yum:
        name: '@{yum}'
        state: latest

- name: Update all software (zypper)
  ansible.builtin.zypper:
    name: '@{zypper}'
    update: yes

