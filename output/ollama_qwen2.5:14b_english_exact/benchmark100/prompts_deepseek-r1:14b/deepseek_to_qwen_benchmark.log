- name: Configure cron shell environment
  lineinfile:
    path: /etc/cron.d/cron
    line: "SHELL=/bin/bash"
    create: true
    regexp: '^SHELL='
    state: present

- name: Configure cron path environment
  lineinfile:
    path: /etc/cron.d/cron
    line: "PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
    create: true
    regexp: '^PATH='
    state: present

