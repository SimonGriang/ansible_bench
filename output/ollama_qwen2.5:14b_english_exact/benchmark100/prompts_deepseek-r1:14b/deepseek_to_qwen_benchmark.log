---
- name: Install unzip package
  apt:
    name: unzip
    state: present

- name: Create system group for promtail
  group:
    name: promtail
    system: yes
    state: present

- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    create_home: no
    shell: /usr/sbin/nologin
    state: present

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: root
    group: root
  with_items:
    - /etc/promtail
    - /etc/promtail/promtail.d

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  with_items:
    - /var/lib/promtail
    - /var/log/promtail

- name: Check promtail binary existence
  stat:
    path: /usr/local/bin/promtail
  register: promtail_binary_check

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_distribution_url }}"
    dest: /tmp/promtail.tar.gz
    sha256sum: "{{ promtail_binary_checksum }}"
  when: promtail_binary_check.stat.exists == False

- name: Propagate local promtail binaries
  copy:
    src: "{{ promtail_binary_local }}"
    dest: /tmp/promtail.tar.gz
  when: promtail_binary_check.stat.exists == False

- name: Download promtail binaries for controller node
  get_url:
    url: "{{ promtail_distribution_url }}"
    dest: /tmp/promtail_controller.tar.gz
    sha256sum: "{{ promtail_binary_checksum }}"
  when: inventory_hostname == "{{ promtail_controller_node }}"
  delegate_to: "{{ promtail_controller_node }}"

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail_controller.tar.gz
    dest: /tmp/promtail.tar.gz
  when: inventory_hostname != "{{ promtail_controller_node }}"
  delegate_to: "{{ promtail_controller_node }}"

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail.tar.gz
    dest: /usr/local/bin/
    remote_src: yes
    creates: /usr/local/bin/promtail

- name: Create symlink to latest promtail version
  file:
    src: /usr/local/bin/promtail
    dest: /usr/local/bin/promtail-latest
    state: link
  notify: restart promtail

- name: Write promtail config file
  template:
    src: promtail-config.j2
    dest: /etc/promtail/promtail.yml
    owner: promtail
    group: promtail
    mode: '0644'

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: restart promtail

