---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install Python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  block:
    - lineinfile:
        dest: /etc/pip.conf
        line: "index-url = {{ python_pip_proxy }}"
        insertafter: EOF
        create: yes
      when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  block:
    - lineinfile:
        dest: /etc/pip.conf
        line: "trusted-host = {{ python_pip_trusted_host }}"
        insertafter: EOF
      when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: latest
  when: ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

- name: Install Python modules
  pip:
    name: "{{ item }}"
    state: present
    version: "{{ python_pip_modules[item] }}"
  loop: "{{ python_pip_modules | dict2items | map(attribute='key') | list }}"
  when: ansible_distribution_release not in ['bookworm', 'noble'] and ansible_os_family != 'Alpine'

