---
- import_tasks: assert.yml

- name: Install logrotate
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  template:
    src: "{{ logrotate_config_file }}.j2"
    dest: "{{ logrotate_config_file }}"
    owner: root
    group: root
    mode: '0644'

- name: Generate logrotate.d files
  template:
    src: "{{ item.src }}.j2"
    dest: "/etc/logrotate.d/{{ item.name }}"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ logrotate_entries | reject('search', 'status', 'absent') | list }}"

- name: Remove logrotate.d files
  file:
    path: "/etc/logrotate.d/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries | select('search', 'status', 'absent') | map(attribute='name') | list }}"

- name: Start logrotate
  service:
    name: "{{ logrotate_service }}"
    state: started
    enabled: yes
  when: logrotate_service is defined

