---
- import_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: "{{ dns_data_dir }}", mode: "0755", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }
    - { path: "{{ dns_conf_dir }}", mode: "0755", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: yes

- name: Generate rndc key
  command: "{{ dns_rndc_keygen }} -a hmac-md5 -b {{ dns_rndc_key_size }} -n {{ dns_rndc_key_name }} -c {{ dns_conf_dir }} -r {{ dns_rndc_random_dev }} -k {{ dns_rndc_key_file }}"
  args:
    creates: "{{ dns_rndc_key_file }}"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_rndc_key_file }}"
    mode: "0440"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_root_hints_file }}"
    mode: "0644"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns

- name: Create zone file
  template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop: "{{ dns_zone_files }}"
  notify: Rndc reload
  register: zone_files
  changed_when: "zone_files.results[0].changed"

- name: Add zones to configuration
  template:
    src: dns.conf.j2
    dest: "/etc/named.conf"
    mode: "0644"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  notify: Restart dns

- name: Place systemd override
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "0644"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop: "{{ dns_systemd_overrides }}"
  when: dns_use_systemd

- name: Start and enable dns
  systemd:
    name: "{{ dns_service_name }}"
    enabled: true
    state: started

