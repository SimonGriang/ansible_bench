---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: 80
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection != 'container'
    - ansible_connection != 'docker'
    - ansible_network_os is not defined

- name: Prepare system
  shell: echo "Preparing system for bootstrap"
  register: prepare_result
  timeout: "{{ bootstrap_timeout }}"
  become: "{{ bootstrap_become }}"
  rescue:
    - name: Gather facts
      setup: {}
    - name: Install bootstrap packages
      yum:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap_facts_packages }}"
      when: bootstrap_facts_packages is defined and bootstrap_facts_packages|length > 0

- name: Gather ansible facts
  setup: {}

- name: Install bootstrap packages (package)
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages }}"
  when: bootstrap_facts_packages is defined and bootstrap_facts_packages|length > 0
  become: "{{ bootstrap_become }}"

