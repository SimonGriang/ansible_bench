---
- import_tasks: assert.yml
  delegate_to: localhost
  when: assert.yml is defined

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: yes
    no_update: no
  check_mode: false

- name: Configure apt
  apt:
    upgrade: dist
    options: ['--no-upgrade={{ packages }}']
    update_cache: yes
    cache_valid_time: 3600

- name: Update all software (dnf)
  dnf:
    update_cache: yes
    upgrade: no
    name: '@system'
    exclude: kernel*

- name: Update all software (pacman)
  pacman:
    sync:
      - '--refresh'
      - '--sysupgrade'
    noconfirm: yes

- name: Configure yum
  block:
    - name: Update all software using dnf
      dnf:
        update_cache: yes
        upgrade: all
        exclude: kernel*
      when: ansible_distribution_major_version == "6"
    - name: Install yum-utils
      yum:
        name: yum-utils
        state: present
      when: ansible_distribution_major_version != "6"
    - name: Update all software using yum
      yum:
        update: yes
        update_cache: yes
        exclude: kernel*
      when: ansible_distribution_major_version != "6"

- name: Update all software (zypper)
  zypper:
    update: yes
    no_gpg_check: yes

