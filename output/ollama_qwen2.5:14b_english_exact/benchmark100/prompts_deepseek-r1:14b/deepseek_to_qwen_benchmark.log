---
- name: Check if Java certificates exist
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: file
  loop: "{{ java_certs }}"
  register: java_certs_status

- name: Fail if Java certificates are missing
  ansible.builtin.fail:
    msg: "Java certificate {{ item.item.path }} does not exist."
  when: not item.stat.exists
  loop: "{{ java_certs_status.results }}"

- name: Set keystore directory for Java versions less than 11
  ansible.builtin.set_fact:
    java_keystore_dir: "/etc/pki/java"
  when: java_version < 11

- name: Set keystore directory for Java versions 11 or newer
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_home }}/lib/security"
  when: java_version >= 11

- name: Import SSL certificates into Java keystore
  ansible.builtin.command: >
    "{{ java_home }}/bin/keytool -import -trustcacerts -alias {{ item.alias }} -file {{ item.path }} -keystore {{ java_keystore_dir }}/cacerts -storepass changeit -noprompt"
  loop: "{{ java_certs }}"
  args:
    creates: "{{ java_keystore_dir }}/cacerts"

