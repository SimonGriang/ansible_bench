- name: Create users
  mysql_user:
    name: "{{ item.user }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
  notify:
    - restart_mysql
  with_items: "{{ users }}"

- name: Flush handlers again
  meta: flush_handlers


