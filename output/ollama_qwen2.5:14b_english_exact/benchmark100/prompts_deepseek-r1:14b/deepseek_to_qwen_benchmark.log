3677, 'load_duration': 73322653, 'prompt_eval_count': 2252, 'prompt_eval_duration': 797558031, 'eval_count': 1090, 'eval_duration': 24687131366, 'model_name': 'qwen2.5:14b'} id='run--6198815f-0206-4fd3-9caf-2e9c23bbc9f1-0' usage_metadata={'input_tokens': 2252, 'output_tokens': 1090, 'total_tokens': 3342}
