---
- ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true
  name: Import assertion tasks

- name: Install system packages
  ansible.builtin.package:
    name: "{{ openssl_requirements }}"
    state: present

- name: Install Python packages
  ansible.builtin.pip:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_pip_packages | default([]) }}"
  when: openssl_pip_packages | length > 0

- name: Create key directory
  ansible.builtin.file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: '0700'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create certificate signing request directory
  ansible.builtin.file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create certificate directory
  ansible.builtin.file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include create tasks
  ansible.builtin.include_tasks: create.yml
  loop: "{{ openssl_items | default([]) }}"
  when: openssl_items | length > 0
  loop_control:
    label: "{{ item.name }}"

