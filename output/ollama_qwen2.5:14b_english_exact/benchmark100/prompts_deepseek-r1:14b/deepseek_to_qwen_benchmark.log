---
- name: locations | Enable modules
  when: ansible_os_family in ['Debian', 'Suse']
  package:
    name:
      - libapache2-mod-proxy-html
      - libapache2-mod-proxy
    state: present
  notify: restart apache

- name: locations | Configure locations
  template:
    src: httpd_locations.conf.j2
    dest: /etc/apache2/sites-available/httpd_locations.conf
  notify: restart apache

- name: locations | Include location configurations
  template:
    src: httpd_locations.conf.j2
    dest: /etc/apache2/sites-available/httpd_locations.conf
  notify: restart apache

  handlers:
    - name: restart apache
      service:
        name: apache2
        state: restarted

