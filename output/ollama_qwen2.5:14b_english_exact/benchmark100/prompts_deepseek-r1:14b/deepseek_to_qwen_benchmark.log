---
- name: Generate an OpenSSL private key
  openssl_privatekey:
    path: /etc/ssl/private/myprivatekey.pem
    mode: '0600'
    owner: 'root'
    group: 'root'
  tags:
    - keygen

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/csr/mycsr.csr
    privatekey_path: /etc/ssl/private/myprivatekey.pem
    country_name: 'US'
    state_or_province_name: 'NY'
    locality_name: 'New York'
    organization_name: 'MyCompany'
    organizational_unit_name: 'IT'
    common_name: 'example.com'
    email_address: 'admin@example.com'
  tags:
    - csr

- name: Generate an OpenSSL X.509 certificate
  openssl_certificate:
    path: /etc/ssl/certs/mycert.crt
    privatekey_path: /etc/ssl/private/myprivatekey.pem
    csr_path: /etc/ssl/csr/mycsr.csr
    provider: selfsigned
    mode: '0644'
    owner: 'root'
    group: 'root'
  tags:
    - cert

- name: Generate a PKCS#12 file
  openssl_pkcs12:
    export: yes
    path: /etc/ssl/private/mypkcs12.p12
    name: 'mycert'
    certificate: /etc/ssl/certs/mycert.crt
    privatekey: /etc/ssl/private/myprivatekey.pem
    friendly_name: 'My Certificate'
    mode: '0600'
    owner: 'root'
    group: 'root'
  tags:
    - pkcs12

- name: Read private key content
  slurp:
    src: /etc/ssl/private/myprivatekey.pem
  register: private_key_content
  tags:
    - keycontent

- name: Read certificate content
  slurp:
    src: /etc/ssl/certs/mycert.crt
  register: cert_content
  tags:
    - certcontent

- name: Create a combined private key and certificate file
  copy:
    content: "{{ private_key_content.content + cert_content.content | b64decode }}"
