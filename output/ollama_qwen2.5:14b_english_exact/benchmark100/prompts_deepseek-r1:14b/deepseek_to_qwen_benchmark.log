2, 'prompt_eval_count': 899, 'prompt_eval_duration': 398715369, 'eval_count': 1068, 'eval_duration': 20485063815, 'model_name': 'qwen2.5:14b'} id='run--442fc842-42c8-4b29-b0f3-706a82f43b87-0' usage_metadata={'input_tokens': 899, 'output_tokens': 1068, 'total_tokens': 1967}
