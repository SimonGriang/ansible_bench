    dest: "/usr/local/bin/rke2-install"
    mode: '0700'
  when: airgap == 'true' and rke2_impl == 'copy'

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifact_path }}"
    mode: '0700'
    state: directory
  when: airgap == 'true' and rke2_impl != 'exists'

- name: Download RKE2 checksum and artifacts
  ansible.builtin.get_url:
    url: "{{ rke2_installer_url }}"
    dest: "{{ rke2_artifact_path }}/rke2.tar.gz"
    mode: '0640'
    checksum: "{{ rke2_checksum }}"
  register: download_result
