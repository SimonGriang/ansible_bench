    name: hashicorp_vault_ca

- name: Install Vault package
  ansible.builtin.package:
    name: vault
    state: present

- name: Configure Vault environment variables
  ansible.builtin.set_fact:
    vault_addr: "https://vault.example.com:8200"
    vault_token: "{{ vault_token_variable }}"

- name: Initialize Vault if not already initialized
  ansible.builtin.command: >
    vault operator init -recovery-shares=1 -recovery-threshold=1 -format=yaml
  register: vault_init_output
  changed_when: vault_init_output.stdout.find('Key') != -1
  when: not vault_initialized

- name: Setup Vault unseal
  ansible.builtin.command: >
    vault operator unseal {{ vault_unseal_key }}
  when: vault_initialized

- name: Setup Vault authentication
  ansible.builtin.command: >
    vault login {{ vault_token }}
  when: vault_initialized

- name: Configure Vault policies and roles
  ansible.builtin.import_role:
    name: hashicorp_vault_policy

- name: Configure Vault secrets engine
  ansible.builtin.import_role:
    name: hashicorp_vault_secrets

- name: Test Vault setup
  ansible.builtin.shell: >
    vault secrets list
  register: vault_test_output
  changed_when: false
  failed_when: vault_test_output.rc != 0

