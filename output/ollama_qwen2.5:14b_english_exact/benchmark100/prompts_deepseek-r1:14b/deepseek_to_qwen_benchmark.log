---
- import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ packages }}"
  notify:
    - set_mysql_root_password
    - systemd-daemon-reexec

- name: Configure mysql server
  lineinfile:
    dest: /etc/mysql/my.cnf
    regexp: '^#?{{ item.regexp }}'
    line: "{{ item.line }}"
  notify:
    - restart_mysql

- name: Configure mysql client
  lineinfile:
    dest: /etc/mysql/conf.d/client.cnf
    regexp: '^#?{{ item.regexp }}'
    line: "{{ item.line }}"
  with_items:
    - { regexp: '^socket.*$', line: 'socket = /var/run/mysqld/mysqld.sock' }

- name: Initialize mysql
  command: "{{ item.command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']
  with_items:
    - { command: 'mysql_install_db' }
    - { command: 'mysql_upgrade -p{{ lookup('env', 'MYSQL_ROOT_PASSWORD') }}' }

- name: Start and enable mysql
  service:
    name: "{{ service_name }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  when: not initial_import
  with_items: "{{ databases }}"

- name: List databases
  command: mysql -Bse 'show databases'
  register: db_list

- name: Import database
  command: mysql -u{{ db_user }} -p{{ db_pass }} {{ item }} < /path/to/{{ item }}.sql
  when: initial_import and db_list.stdout.find(item) == -1
  with_items: "{{ databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.user }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
  notify:
    - restart_mysql
  with_items: "{{ users }}"  

- name: Flush handlers again
  meta: flush_handlers

