---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install fail2ban
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ fail2ban_packages }}"

- name: Copy filters in filter.d
  copy:
    src: "{{ item }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: 0640
  loop: "{{ fail2ban_filters }}"
  when: fail2ban_filterd_path is defined
  notify: Restart fail2ban

- name: Configure fail2ban.local
  template:
    src: fail2ban.local.j2
    dest: /etc/fail2ban/fail2ban.local
    mode: 0640
  notify: Restart fail2ban
  with_dict: "{{ fail2ban_base_configuration | combine(fail2ban_configuration) }}"
  loop_control:
    label: "{{ item.option }}"

- name: Configure jail.local
  template:
    src: jail.local.j2
    dest: /etc/fail2ban/jail.local
    mode: 0640
  notify: Restart fail2ban
  with_dict: "{{ fail2ban_base_jail_configuration | combine(fail2ban_jail_configuration) }}"
  loop_control:
    label: "{{ item.option }}"

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    mode: 0640
  when: not fail2ban_auth.stat.exists

- name: Start and enable fail2ban
  systemd:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: yes

