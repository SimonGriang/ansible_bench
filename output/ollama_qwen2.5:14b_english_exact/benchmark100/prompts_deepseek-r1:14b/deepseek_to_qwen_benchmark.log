---
- name: Restart RKE2 service on {{ rke2_node_name}}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  kubectl:
    command: get
    namespace: kube-system
    resource: nodes
  register: nodes_status
  until: nodes_status.stdout.find('NotReady') == -1
  retries: 100
  delay: 15
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  kubectl:
    command: get
    resource: pods
    include_uninitialized: yes
    include_labels: "status=Ready"
  register: pods_status
  until: pods_status.stdout.find('100%)') == -1
  retries: 100
  delay: 15
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready


