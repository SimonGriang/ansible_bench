em.dest | basename }}"\n    mode: \'0640\'\n  loop: "{{ static_pods }}"\n\n- name: Copy RKE2 environment file\n  ansible.builtin.copy:\n    src: "{{ rke2_environment_file }}"\n    dest: "{{ rke2_bin_path }}/rke2.env"\n    mode: \'0644\'\n    owner: root\n    group: root\n  when: rke2_environment_file is defined' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-19T10:04:15.59873132Z', 'done': True, 'done_reason': 'stop', 'total_duration': 27835327306, 'load_duration': 88848013, 'prompt_eval_count': 2401, 'prompt_eval_duration': 12498937, 'eval_count': 1203, 'eval_duration': 27717262477, 'model_name': 'qwen2.5:14b'} id='run--92bd6eb4-9ea7-4f97-8b7b-e674d2d17daa-0' usage_metadata={'input_tokens': 2401, 'output_tokens': 1203, 'total_tokens': 3604}
