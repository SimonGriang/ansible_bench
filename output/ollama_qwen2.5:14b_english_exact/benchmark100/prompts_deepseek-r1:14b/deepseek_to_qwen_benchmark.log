---
- name: Validate all variables are set correctly
  import_tasks: assert.yml

- name: Wait for host to be available
  wait_for:
    port: "{{ target_port }}"
    timeout: "{{ wait_timeout }}"
    delay: "{{ wait_delay }}"
  register: host_ready
  until: host_ready is success
  retries: "{{ wait_retries }}"
  delay: "{{ wait_retry_delay }}"

- name: Prepare system for bootstrap
  block:
    - name: Test connection
      ping:

    - name: Fail on connection failure
      fail:
        msg: "Failed to connect to the host"
      when: not ansible_facts is defined

    - name: Gather facts
      setup:

    - name: Install raw bootstrap packages
      raw: "{{ bootstrap_command }}"
      register: bootstrap_output
      failed_when: bootstrap_output.rc != 0

- name: Ensure system preparation with Ansible modules
  block:
    - name: Gather facts
      setup:

    - name: Install packages based on OS family
      include_tasks: "{{ ansible_os_family }}.yml"

    - name: Ensure system is fully prepared
      command: "{{ prepare_command }}"
      register: prepare_output
      failed_when: prepare_output.rc != 0

