---
- name: Import assertion tasks
  delegate_to: localhost
  import_tasks: assert.yml

- name: Install Docker Compose package
  when: installation_type == "package"
  package:
    name: docker-compose
    state: present

- name: Install Docker Compose binary
  when: installation_type == "binary"
  block:
    - name: Ensure required packages are installed
      package:
        name:
          - curl
          - unzip
        state: present

    - name: Download and install Docker Compose binary
      get_url:
        url: "{{ docker_compose_binary_url }}"
        dest: /usr/local/bin/docker-compose
        mode: '0755'

    - name: Ensure Docker Compose binary is executable
      file:
        path: /usr/local/bin/docker-compose
        mode: '0755'

