---
- import_tasks: assert.yml
  when: inventory_hostname == 'localhost'
  run_once: true
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
    - name: Manage SELinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Manage SELinux booleans
      when: selinux_booleans is defined
      selboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: yes
      loop: "{{ selinux_booleans }}"
      notify: Reboot
  when:
    - selinux_status is defined
    - connection != 'container'
    - connection != 'docker'
    - connection != 'community.docker.docker'

