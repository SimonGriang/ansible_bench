---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  when: node_type == 'server'
  kubernetes:
    kubeconfig: /etc/rke2/config.yaml
    resource_definition: "{{ lookup('template', 'templates/rke2_taints_server.yaml') | from_json }}"
    state: present
    api_version: scheduling.k8s.io/v1

- name: Set agent taints
  when: node_type == 'agent'
  kubernetes:
    kubeconfig: /etc/rke2/config.yaml
    resource_definition: "{{ lookup('template', 'templates/rke2_taints_agent.yaml') | from_json }}"
    state: present
    api_version: scheduling.k8s.io/v1

- name: Copy RKE2 configuration file
  template:
    src: templates/rke2_config.yaml.j2
    dest: /etc/rke2/config.yaml
    mode: '0640'
  notify: restart_rke2

- name: Copy Kubelet configuration file
  when: kubelet_config is defined
  template:
    src: templates/kubelet_config.yaml.j2
    dest: /etc/rke2/kubelet-config.yaml
    mode: '0640'
  notify: restart_rke2

- name: Copy Containerd Registry Configuration file
  when: containerd_registry_config is defined
  copy:
    src: "{{ containerd_registry_config }}"
    dest: /etc/rke2/registries.yaml
    mode: '0640'
  notify: restart_rke2

- name: Start RKE2 service on other nodes
  when: inventory_hostname != node_name
  systemd:
    name: rke2
    enabled: yes
    state: started
  notify: restart_rke2

- name: Mask other RKE2 services on nodes
  when: node_type == 'server'
  systemd:
    name: rke2-agent
    state: masked

- name: Mask other RKE2 services on nodes
  when: node_type == 'agent'
  systemd:
    name: rke2-server
    state: masked

- name: Wait for remaining nodes to be ready - no CNI
  when: not cni
  wait_for:
    host: "{{ item }}"
    port: 6443
    state: started
    delay: 10
    timeout: 300
  with_items: "{{ groups['nodes'] }}"
  until: "'{{ item }}' in ready_nodes"
  retries: 10
  delay: 10

- name: Wait for remaining nodes to be ready - with CNI
  when: cni
  wait_for:
    host: "{{ item }}"
    port: 6443
    state: started
    delay: 10
    timeout: 300
  with_items: "{{ groups['nodes'] }}"
  until: "'{{ item }}' in ready_nodes"
  retries: 10
  delay: 10

