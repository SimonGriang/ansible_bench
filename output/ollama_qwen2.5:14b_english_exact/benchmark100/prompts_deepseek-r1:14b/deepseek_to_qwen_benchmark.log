---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_distribution }}_{{ ansible_distribution_version | replace('.', '_') }}.yaml"

- name: Gather architecture specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/arch_{{ ansible_architecture }}.yaml"

- name: Set OS specific variables (I)
  set_fact:
    openjdk_version: "{{ openjdk_version | default('8') }}"
    openjdk_repo: "{{ openjdk_repo | default('') }}"
    openjdk_libs: "{{ openjdk_libs | default([]) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    openjdk_install_path: "{{ openjdk_install_path | default('/usr/lib/jvm') }}"
    openjdk_package_name: "{{ openjdk_package_name | default('openjdk-{{ openjdk_version }}-jre') }}"
    java_home: "{{ openjdk_install_path }}/{{ openjdk_package_name }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt:
        state: absent
        purge: true
        name: "{{ item }}"
      loop: "{{ deprecated_repositories | default([]) }}"
      when: ansible_facts['os_family'] == 'Debian'

    - name: Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ extra_apt_tools | default([]) }}"
      when: ansible_facts['os_family'] == 'Debian'

    - name: Add key repositories
      apt_key:
        url: "{{ key_repository | default('') }}"
      when: ansible_facts['os_family'] == 'Debian'

    - name: Add required repositories
      apt_repository:
        repo: "{{ required_repository | default('') }}"
      when: ansible_facts['os_family'] == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: "{{ key_repository | default('') }}"
      when: ansible_facts['os_family'] == 'RedHat'

    - name: Add required repositories
      yum_repository:
        name: "{{ required_repository | default('') }}"
        description: "{{ required_repository_description | default('') }}"
        baseurl: "{{ required_repository_baseurl | default('') }}"
        enabled: "{{ required_repository_enabled | default('1') }}"
      when: ansible_facts['os_family'] == 'RedHat'

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ openjdk_libs | default([]) }}"

- name: Install Java, Debian
  apt:
    name: "{{ openjdk_package_name }}"
    state: present
  when: ansible_facts['os_family'] == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ openjdk_package_name }}"
    state: present
  when: ansible_facts['os_family'] == 'RedHat'

- name: Export environment variables
  template:
    src: java_env.conf.j2
    dest: /etc/profile.d/java_env.sh

- name: Source environment variables
  shell: source /etc/profile.d/java_env.sh

- name: Correct java version selected for Java < 11
  command: alternatives --set java /usr/lib/jvm/{{ java_home }}/jre/bin/java
  when: openjdk_version | int < 11

- name: Correct java version selected for Java >= 11
  command: alternatives --set java /usr/lib/jvm/{{ java_home }}/bin/java
  when: openjdk_version | int >= 11


