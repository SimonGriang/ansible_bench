---
- name: Generate a private SSL key using OpenSSL
  openssl_privatekey:
    path: /etc/ssl/private/mydomain.key
    mode: '0600'
    owner: root
    group: root
  tags:
    - ssl

- name: Generate a Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/csr/mydomain.csr
    privatekey_path: /etc/ssl/private/mydomain.key
    country_name: US
    state_or_province_name: California
    locality_name: San Francisco
    organization_name: My Organization
    organizational_unit_name: My Unit
    common_name: mydomain.com
    email_address: admin@example.com
    mode: '0600'
  tags:
    - ssl

- name: Generate a self-signed SSL certificate
  openssl_certificate:
    path: /etc/ssl/certs/mydomain.crt
    privatekey_path: /etc/ssl/private/mydomain.key
    csr_path: /etc/ssl/csr/mydomain.csr
    provider: selfsigned
    mode: '0600'
  tags:
    - ssl

- name: Create a PKCS#12 file
  openssl_pkcs12:
    export: true
    path: /etc/ssl/pkcs12/mydomain.p12
    name: mydomain.com
    certificate: /etc/ssl/certs/mydomain.crt
    privatekey: /etc/ssl/private/mydomain.key
    mode: '0600'
  tags:
    - ssl

- name: Read the private key content
  slurp:
    src: /etc/ssl/private/mydomain.key
  register: private_key_content
  tags:
    - ssl

- name: Read the certificate content
  slurp:
    src: /etc/ssl/certs/mydomain.crt
  register: certificate_content
  tags:
    - ssl

- name: Combine private key and certificate into a single file
  copy:
    content: "{{ lookup('file', '/etc/ssl/private/mydomain.key') }}{{ lookup('file', '/etc/ssl/certs/mydomain.crt') }}"
    dest: /etc/ssl/mydomain.pem
    mode: '0600'
  tags:
    - ssl

