  become: yes
  block:
    - name: Apply core dump limits
      command: sysctl -w kernel.core_pattern=/dev/null
      become: yes
  when: vault_hardening_disable_core_dumps | bool

- name: Disable swap on reboot
  become: yes
  block:
    - name: Disable swap on reboot
      command: systemctl disable --now swaps.target
      become: yes
  when: vault_hardening_disable_swap | bool

- name: Disable shell command history
  become: yes
  block:
    - name: Notify service restart
      command: systemctl restart sshd
      become: yes
  when: vault_hardening_disable_shell_command_history | bool

- name: Enable SELinux
  become: yes
  block:
    - name: Notify service restart
      command: setenforce 1
      become: yes
  when: vault_hardening_configure_selinux_apparmor | bool

- name: Enforce AppArmor profiles
  become: yes
  block:
    - name: Notify service restart
      command: systemctl restart apparmor
      become: yes
  when: vault_hardening_configure_selinux_apparmor | bool

