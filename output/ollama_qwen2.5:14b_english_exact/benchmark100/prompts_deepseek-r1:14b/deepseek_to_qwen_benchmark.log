---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: inventory_hostname != connection | default('local') | regex_search('^(?:container|docker|community.docker.docker)$')

- name: Prepare system
  shell: echo "Preparing system for bootstrap"
  register: prepare_system
  failed_when: prepare_system.rc != 0
  changed_when: prepare_system.stdout != ''
  timeout: "{{ bootstrap_timeout }}"
  become: "{{ bootstrap_become }}"
  rescue:
    - name: Gather ansible facts
      ansible_facts: ansible_facts
      delegate_to: localhost
    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      become: "{{ bootstrap_become }}"

- name: Gather ansible facts
  ansible_facts: setup
  become: false

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"

