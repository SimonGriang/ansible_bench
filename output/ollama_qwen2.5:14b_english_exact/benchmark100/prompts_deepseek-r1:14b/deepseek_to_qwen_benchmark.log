---
- name: Install EPEL GPG key
  ansible.builtin.get_url:
    url: "{{ epel_gpg_key }}"
    dest: /etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL
  when: >
    ansible_os_family == 'RedHat' and
    (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2' or
     ansible_distribution_version in ['7', '8', '9'])

- name: Install EPEL release package
  ansible.builtin.yum:
    name: "{{ epel_url }}"
    state: present
  when: >
    ansible_os_family == 'RedHat' and
    (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2' or
     ansible_distribution_version in ['7', '8', '9'])
  notify: Update package cache

- name: Install EPEL next release package (conditional)
  ansible.builtin.yum:
    name: "{{ epel_next_url }}"
    state: present
  when: >
    ansible_os_family == 'RedHat' and
    (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2' or
     ansible_distribution_version in ['7', '8', '9']) and
    epel_next == True
  notify: Update package cache

- name: Update package cache
  ansible.builtin.yum:
    update_cache: yes
  become: yes
  listen: Update package cache

