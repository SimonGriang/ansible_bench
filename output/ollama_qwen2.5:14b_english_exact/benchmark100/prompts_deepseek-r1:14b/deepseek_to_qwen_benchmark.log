---
- name: Check current docker-compose version
  command: docker-compose --version
  register: docker_compose_version_output

- name: Set fact for docker-compose current version
  set_fact:
    current_docker_compose_version: "{{ docker_compose_version_output.stdout|regex_replace('Docker Compose version ','')|regex_replace('\n','') }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: current_docker_compose_version is defined and current_docker_compose_version != 'expected_version'

- name: Install Docker Compose (if configured)
  get_url:
    url: https://github.com/docker/compose/releases/download/expected_version/docker-compose-Linux-x86_64
    dest: /usr/local/bin/docker-compose
  notify: Make docker-compose executable
  when: current_docker_compose_version is undefined or current_docker_compose_version != 'expected_version'

- name: Make docker-compose executable
  become: yes
  file:
    path: /usr/local/bin/docker-compose
    mode: 'a+x'

