al_duration': 10119051240, 'model_name': 'qwen2.5:14b'} id='run--72f531a5-1aad-4e29-8491-8be64698057b-0' usage_metadata={'input_tokens': 620, 'output_tokens': 511, 'total_tokens': 1131}
