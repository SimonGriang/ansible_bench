content='---\n- import_tasks: assert.yml\n\n- name: Install logrotate\n  package:\n    name: "{{ logrotate_packages }}"\n    state: present\n\n- name: Configure logrotate\n  template:\n    src: "{{ logrotate_config_file }}.j2"\n    dest: "{{ logrotate_config_dir }}"\n\n- name: Generate logrotate.d files\n  template:\n    src: "{{ item.template }}.j2"\n    dest: "/etc/logrotate.d/{{ item.name }}"\n  loop: "{{ logrotate_entries }}"\n  when: item.absent is not defined or item.absent != True\n\n- name: Remove logrotate.d files\n  file:\n    path: "/etc/logrotate.d/{{ item }}"\n    state: absent\n  loop: "{{ logrotate_entries | selectattr(\'absent\', \'equalto\', True) | map(attribute=\'name\') | list }}"\n\n- name: Start logrotate\n  service:\n    name: "{{ logrotate_service }}"\n    state: "{{ logrotate_service_state }}"\n    enabled: "{{ logrotate_service_enabled }}"\n\n#' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-19T09:24:31.073006664Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4584315886, 'load_duration': 89885417, 'prompt_eval_count': 786, 'prompt_eval_duration': 57266912, 'eval_count': 220, 'eval_duration': 4422929810, 'model_name': 'qwen2.5:14b'} id='run--f3cf2d3b-9320-48ff-8791-dde9530c51b5-0' usage_metadata={'input_tokens': 786, 'output_tokens': 220, 'total_tokens': 1006}
