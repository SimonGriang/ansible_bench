    name: "{{ item }}"
    state: present
  loop: "{{ httpd_packages }}"
  when: ansible_os_family == "Debian"
  notify: test_config

- name: Configure selinux
  selinux:
    policylabel: "{{ item.policylabel }}"
    permissive: "{{ item.permissive }}"
    state: "{{ item.state }}"
  loop: "{{ selinux_booleans }}"
  when: selinux_enabled

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
