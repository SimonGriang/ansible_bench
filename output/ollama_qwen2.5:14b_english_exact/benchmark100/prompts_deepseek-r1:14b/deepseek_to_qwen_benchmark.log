---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ httpd_packages }}"
  when: ansible_os_family == "RedHat"
  register: httpd_installation

- name: Install apache httpd
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ httpd_packages }}"
  when: ansible_os_family == "Debian"
  register: httpd_installation

- name: Configure selinux
  block:
    - name: Ensure SELinux is enabled
      command: getenforce
      register: selinux_status
      changed_when: False
      failed_when: False
      when: ansible_os_family == "RedHat"

    - name: Modify SELinux boolean settings
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
      loop: "{{ httpd_selinux_booleans }}"
      when: ansible_os_family == "RedHat" and selinux_status.stdout == "Enforcing"

    - name: Allow connections to specified ports
      seport:
        port: "{{ item }}"
        protocol: "{{ item.protocol }}"
        state: present
      loop: "{{ httpd_selinux_ports }}"
      when: ansible_os_family == "RedHat" and selinux_status.stdout == "Enforcing"

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify: test httpd configuration
  notify: restart httpd service

- name: Activate httpd module | Debian
  command: a2enmod "{{ item }}"
  args:
    creates: "/etc/apache2/mods-enabled/{{ item }}"
  loop: "{{ httpd_modules }}"
  when: ansible_os_family == "Debian"

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: httpd_ssl_enabled

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_config_src }}"
    dest: "{{ httpd_ports_config_dest }}"
    mode: 0644
  notify: test httpd configuration
  notify: restart httpd service
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ item }}"
    state: absent
  loop: "{{ httpd_remove_example }}"
  when: httpd_remove_example is defined

- name: Start and enable httpd
  systemd:
    name: httpd
    enabled: yes
    state: started

