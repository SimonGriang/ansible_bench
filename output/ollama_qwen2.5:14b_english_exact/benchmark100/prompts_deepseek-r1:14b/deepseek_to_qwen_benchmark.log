- name: lookup bootstrap facts (raw)
  ansible.builtin.raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  ansible_user: "{{ bootstrap_user }}"

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.value.distribution }}"
    bootstrap_distribution_major_version: "{{ item.value.version_regex.match(item.value.version_id).group('version_major') }}"
    bootstrap_os_family: "{{ item.value.os_family }}"
  loop: "{{ bootstrap__os_family_map }}"
  when: "bootstrap_facts.stdout is search(item.value.os_family_regex)"
  become: "{{ item.become | default(False) }}"
  loop_control:
    label: "{{ item.key }}"
  register: _
  changed_when: false

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.value.os_family }}"
  loop: "{{ bootstrap__os_family_map }}"
  when: "bootstrap_distribution is defined and bootstrap_distribution is search(item.value.os_family_regex)"
  become: "{{ item.become | default(False) }}"
  loop_control:
    label: "{{ item.key }}"
  register: _
  changed_when: false

