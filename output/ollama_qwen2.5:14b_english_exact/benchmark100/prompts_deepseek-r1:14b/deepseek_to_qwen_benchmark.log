    country_name: 'US'
    state_or_province_name: 'CA'
    locality_name: 'San Francisco'
    organization_name: 'MyCompany Inc.'
    common_name: 'myapp.example.com'
    mode: '0600'

- name: Generate a self-signed SSL certificate
  openssl_certificate:
    path: /etc/ssl/certs/myapp.crt
    privatekey_path: /etc/ssl/private/myapp.key
    csr_path: /etc/ssl/csr/myapp.csr
    provider: selfsigned
    mode: '0600'

- name: Create a PKCS#12 file
  openssl_pkcs12:
    export: true
    path: /etc/ssl/certs/myapp.p12
    name: "{{ lookup('ansible_certificate', '/etc/ssl/certs/myapp.crt') }}"
    privatekey_path: /etc/ssl/private/myapp.key
    cacerts: "{{ lookup('ansible_certificate', '/etc/ssl/certs/myapp.crt', 'ca') }}"
    mode: '0600'

- name: Read the private key content
  slurp:
    src: /etc/ssl/private/myapp.key
  register: private_key_content

- name: Read the certificate content
  slurp:
    src: /etc/ssl/certs/myapp.crt
  register: certificate_content

- name: Combine private key and certificate into a single file
  copy:
    content: "{{ lookup('file', '/etc/ssl/private/myapp.key') + lookup('file', '/etc/ssl/certs/myapp.crt') }}"
    dest: /etc/ssl/certs/myapp.pem
    mode: '0600'


