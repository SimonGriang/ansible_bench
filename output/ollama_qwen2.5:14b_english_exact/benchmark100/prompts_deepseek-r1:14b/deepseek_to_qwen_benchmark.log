content='---\n- import_tasks: assert.yml\n\n- name: Install mysql\n  package:\n    name: "{{ packages }}"\n  notify:\n    - set_mysql_root_password\n    - systemd-daemon-reexec\n\n- name: Configure mysql server\n  lineinfile:\n    dest: /etc/mysql/my.cnf\n    regexp: \'^#?{{ item.regexp }}\'\n    line: "{{ item.line }}"\n  notify:\n    - restart_mysql\n\n- name: Configure mysql client\n  lineinfile:\n    dest: /etc/mysql/conf.d/client.cnf\n    regexp: \'^#?{{ item.regexp }}\'\n    line: "{{ item.line }}"\n  with_items:\n    - { regexp: \'^socket.*$\', line: \'socket = /var/run/mysqld/mysqld.sock\' }\n\n- name: Initialize mysql\n  command: "{{ item.command }}"\n  when: ansible_distribution in [\'Alpine\', \'Archlinux\']\n  with_items:\n    - { command: \'mysql_install_db\' }\n    - { command: \'mysql_upgrade -p{{ lookup(\'env\', \'MYSQL_ROOT_PASSWORD\') }}\' }\n\n- name: Start and enable mysql\n  service:\n    name: "{{ service_name }}"\n    state: started\n    enabled: yes\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Place my.cnf\n  template:\n    src: my.cnf.j2\n    dest: /etc/mysql/my.cnf\n    mode: 0644\n\n- name: Create databases\n  mysql_db:\n    name: "{{ item }}"\n    state: present\n  when: not initial_import\n  with_items: "{{ databases }}"\n\n- name: List databases\n  command: mysql -Bse \'show databases\'\n  register: db_list\n\n- name: Import database\n  command: mysql -u{{ db_user }} -p{{ db_pass }} {{ item }} < /path/to/{{ item }}.sql\n  when: initial_import and db_list.stdout.find(item) == -1\n  with_items: "{{ databases }}"\n\n- name: Create users\n  mysql_user:\n    name: "{{ item.user }}"\n    host: "{{ item.host }}"\n    password: "{{ item.password }}"\n    priv: "{{ item.priv }}"\n  notify:\n    - restart_mysql\n  with_items: "{{ users }}"  \n\n- name: Flush handlers again\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-09T09:19:00.262485649Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10566742800, 'load_duration': 89156360, 'prompt_eval_count': 630, 'prompt_eval_duration': 373241337, 'eval_count': 492, 'eval_duration': 10091884818, 'model_name': 'qwen2.5:14b'} id='run--d178ca79-865b-404d-a9fa-1b400ff242bd-0' usage_metadata={'input_tokens': 630, 'output_tokens': 492, 'total_tokens': 1122}
