---
- name: Import assertion file
  import_tasks: assert.yml
  remote_src: true
  vars:
    cron_packages: "{{ cron_packages }}"
  delegate_to: localhost

- name: Install cron packages
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ cron_packages }}"
  when: cron_packages is defined and cron_packages|length > 0

- name: Configure cron shell
  lineinfile:
    path: /etc/cron.conf
    regexp: '^SHELL='
    line: "SHELL=/bin/bash"
    create: yes
  notify: restart cron service

- name: Configure cron path
  lineinfile:
    path: /etc/cron.conf
    regexp: '^PATH='
    line: "PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
    create: yes
  notify: restart cron service

- name: Configure cron mailto
  lineinfile:
    path: /etc/cron.conf
    regexp: '^MAILTO='
    line: "MAILTO=root"
    create: yes
  notify: restart cron service

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: true
  when: cron_service is defined and cron_service|length > 0

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined and cron_jobs|length > 0

- name: Ensure cron jobs directory exists
  file:
    path: /etc/cron.d
    state: directory
    mode: '0755'

  handlers:
  - name: restart cron service
    service:
      name: cron
      state: restarted

