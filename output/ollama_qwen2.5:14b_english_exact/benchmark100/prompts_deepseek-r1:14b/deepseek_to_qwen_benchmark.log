---
- name: Create the RKE2 manifests directory
  file:
    path: /opt/rke2/manifests
    state: directory
    mode: '0750'
    owner: root
    group: root

- name: Copy kube-vip files to first server
  copy:
    src: "templates/{{ item }}"
    dest: /opt/rke2/data/{{ item }}
    mode: '0644'
    owner: root
    group: root
  with_items:
    - kube-vip-ds.yaml.j2
    - kube-vip-svc.yaml.j2

- name: Copy kube-vip load balancer manifests to first server
  copy:
    src: "templates/{{ item }}"
    dest: /opt/rke2/manifests/{{ item }}
    mode: '0644'
    owner: root
    group: root
  loop:
    - kube-vip-loadbalancer.yaml.j2
  when: kube_vip_cloud_provider_enabled

