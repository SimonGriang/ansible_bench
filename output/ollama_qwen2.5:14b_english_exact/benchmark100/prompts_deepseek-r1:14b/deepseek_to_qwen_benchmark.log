---
- name: hardening | Disable swap
  when: vault_hardening_disable_swap | default(false)
  block:
    - name: Disable swap immediately
      command: swapoff -a
      when: ansible_swaps|length > 0
    - name: Prevent swap from being enabled on reboot
      lineinfile:
        path: /etc/fstab
        regexp: '^\s*swap\s'
        state: absent
      notify: disable_swap_on_reboot

- name: hardening | Disable core dumps
  when: vault_hardening_disable_core_dumps | default(false)
  block:
    - name: Prevent core dumps by adjusting PAM settings
      lineinfile:
        path: /etc/security/limits.conf
        line: '* hard core 0'
        create: yes
      notify: apply_core_dump_limits
    - name: Set soft core file size limit to 0
      lineinfile:
        path: /etc/security/limits.conf
        line: '* soft core 0'
        create: yes
      notify: apply_core_dump_limits

- name: hardening | Disable Shell Command History
  when: vault_hardening_disable_shell_command_history | default(false)
  block:
    - name: Disable shell command history for Vault-related commands
      copy:
        dest: /etc/profile.d/vault.sh
        content: |
          #!/bin/bash
          export HISTIGNORE="history:export HISTIGNORE:clear"
          export HISTCONTROL="ignorespace"
      mode: '0755'
      notify: disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  when: vault_hardening_configure_selinux_apparmor | default(false)
  block:
    - name: Enable SELinux
      lineinfile:
        path: /etc/selinux/config
        regexp: '^SELINUX='
        line: SELINUX=enforcing
      notify: enable_selinux
    - name: Install SELinux policies
      package:
        name: "{{ item }}"
        state: present
      loop:
        - selinux-policy-targeted
    - name: Enforce AppArmor profiles for Vault
      shell: aa-enforce /etc/apparmor.d/{vault.*}
      args:
        chdir: /etc/apparmor.d
      notify: enforce_apparmor_profiles

- name: Apply core dump limits
  become: yes
  block:
    - name: Apply core dump limits
      command: sysctl -w kernel.core_pattern=/dev/null
      become: yes
  when: vault_hardening_disable_core_dumps | default(false)

- name: Disable swap on reboot
  become: yes
  block:
    - name: Disable swap on reboot
      command: systemctl disable --now swaps.target
      become: yes
  when: vault_hardening_disable_swap | default(false)

- name: Disable shell command history
  become: yes
  block:
    - name: Notify service restart
      command: systemctl restart sshd
      become: yes
  when: vault_hardening_disable_shell_command_history | default(false)

- name: Enable SELinux
  become: yes
  block:
    - name: Notify service restart
      command: setenforce 1
      become: yes
  when: vault_hardening_configure_selinux_apparmor | default(false)

- name: Enforce AppArmor profiles
  become: yes
  block:
    - name: Notify service restart
      command: systemctl restart apparmor
      become: yes
  when: vault_hardening_configure_selinux_apparmor | default(false)

