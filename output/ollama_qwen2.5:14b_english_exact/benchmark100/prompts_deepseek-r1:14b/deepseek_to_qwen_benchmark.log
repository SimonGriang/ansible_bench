---
- name: Create the RKE2 config directory
  file:
    path: /etc/rke2
    state: directory
    mode: 0750

- name: Set server taints
  when: rke2_is_server|bool
  lineinfile:
    path: /etc/rke2/config.yaml
    regexp: '^taints:'
    line: "taints: {{ rke2_server_node_taints|join(', ') }}"
    create: yes
    mode: 0640

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rke2/config.yaml
    owner: root
    group: root
    mode: 0640
  notify: restart_rke2

- name: Copy kubelet configuration file
  when: rke2_kubelet_config is defined
  copy:
    src: "{{ rke2_kubelet_config }}"
    dest: /etc/rke2/kubelet.yaml
    owner: root
    group: root
    mode: 0640
  notify: restart_rke2

- name: Copy Containerd Registry Configuration file
  when: rke2_custom_containerd_registries is defined
  copy:
    src: "{{ rke2_containerd_registry_config }}"
    dest: /etc/rke2/registries.yaml
    owner: root
    group: root
    mode: 0640
  notify: restart_rke2

- name: Register etcd restore from file
  set_fact:
    rke2_etcd_restore_file: "{{ '/var/lib/rke2/etcd/{{ rke2_etcd_restore_file }}' if rke2_etcd_restore_file is defined else None }}"

- name: Register etcd restore from S3
  set_fact:
    rke2_etcd_restore_s3: "{{ rke2_etcd_restore_s3_options if rke2_etcd_restore_s3_options is defined else None }}"

- name: Restore etcd from file
  when: rke2_etcd_restore_file is defined
  block:
    - name: Create etcd restore directory
      file:
        path: "{{ rke2_etcd_restore_file|dirname }}"
        state: directory
        mode: 0750
    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_restore_file }}"
        dest: "{{ rke2_etcd_restore_file }}"
        owner: root
        group: root
        mode: 0640
    - name: Run etcd restore command
      command: rke2 etcd restore file="{{ rke2_etcd_restore_file }}"
      environment:
        RKE2_TOKEN: "{{ rke2_token|default('') }}"

- name: Restore etcd from S3
  when: rke2_etcd_restore_s3 is defined
  block:
    - name: Set S3 options
      set_fact:
        s3_options: "{{ rke2_etcd_restore_s3 }}"
    - name: Run etcd restore command
      command: rke2 etcd restore s3="{{ s3_options }}"
      environment:
        RKE2_TOKEN: "{{ rke2_token|default('') }}"

- name: Start RKE2 service
  systemd:
    name: rke2-server
    enabled: yes
    state: started
  notify: restart_rke2

- name: Mask RKE2 agent service
  systemd:
    name: rke2-agent
    masked: yes

- name: Wait for first server to be ready (no CNI)
  wait_for:
    path: http://localhost:8080
    search_string: 'sufficient resources'

- name: Wait for first server to be ready (with CNI)
  wait_for:
    path: http://localhost:8080
    search_string: 'ready'

- name: Restore etcd
  when: rke2_etcd_restore_file is defined or rke2_etcd_restore_s3 is defined
  block:
    - name: Clean up old nodes and secrets
      shell: >
        rke2 etcd cleanup;
        rke2 k3s secrets clean
    - name: Perform etcd restore
      include_tasks: etcd_restore_tasks.yml

- name: Set Active Server variable
  delegate_to: "{{ groups['rke2_servers'] }}"
  set_fact:
    rke2_active_server: "{{ ansible_hostname }}"

