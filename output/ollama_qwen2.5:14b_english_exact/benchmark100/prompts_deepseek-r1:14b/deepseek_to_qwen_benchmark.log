---
- name: Validate All Variables Are Set Correctly
  ansible.builtin.import_tasks: assert.yml

- name: Wait For Host To Be Available
  ansible.builtin.wait_for:
    port: "{{ port }}"
    timeout: "{{ timeout }}"

- name: Prepare System For Bootstrap
  block:
    - name: Test Connection
      ansible.builtin.ping:

    - name: Handle Connection Failure
      ansible.builtin.fail:
        msg: "Connection failed, aborting bootstrap"
      when: ansible_facts is not defined

    - name: Gather Facts
      ansible.builtin.setup:

    - name: Install Raw Bootstrap Packages
      ansible.builtin.raw: "{{ bootstrap_package_command }}"
      register: bootstrap_result
      changed_when: bootstrap_result.is_changed

- name: Ensure System Preparation With Ansible Modules
  block:
    - name: Gather Facts
      ansible.builtin.setup:

    - name: Install Packages Based On OS Family
      ansible.builtin.package:
        name: "{{ packages[ansible_os_family] }}"
        state: present

    - name: Ensure System Is Fully Prepared
      ansible.builtin.command: "{{ prepare_command }}"
      when: prepare_command is defined
      changed_when: result.is_changed
