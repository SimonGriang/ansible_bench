---
- name: hardening | Disable swap
  when: vault_hardening_disable_swap|default(false)
  block:
    - name: Disable swap immediately
      command: swapoff -a
      changed_when: true
    - name: Prevent swap from being enabled on reboot
      lineinfile:
        path: /etc/fstab
        regexp: '^[^#]*swap'
        line: '#{{ lookup("ansible_facts", "lineinfile_regexp") }}'
        state: present
        create: yes
      register: swap_fstab_mod
      changed_when: "'line modified' in swap_fstab_mod.msg or 'line added' in swap_fstab_mod.msg"

- name: hardening | Disable core dumps
  when: vault_hardening_disable_core_dumps|default(false)
  block:
    - name: Prevent core dumps by adjusting PAM settings
      lineinfile:
        path: /etc/security/limits.conf
        line: '* hard core 0'
        state: present
        create: yes
      register: pam_core_dump_mod
      changed_when: "'line modified' in pam_core_dump_mod.msg or 'line added' in pam_core_dump_mod.msg"
    - name: Ensure core dumps are disabled for all PAM domains
      lineinfile:
        path: /etc/security/limits.d/90-nproc.conf
        line: '* soft core 0'
        state: present
        create: yes
      register: pam_core_dump_mod_soft
      changed_when: "'line modified' in pam_core_dump_mod_soft.msg or 'line added' in pam_core_dump_mod_soft.msg"

- name: hardening | Disable Shell Command History
  when: vault_hardening_disable_shell_command_history|default(false)
  block:
    - name: Disable shell command history for Vault commands
      template:
        src: vault.sh.j2
        dest: /etc/profile.d/vault.sh
      notify: Restart shell services

- name: hardening | Configure SELinux / AppArmor
  when: vault_hardening_configure_selinux_apparmor|default(false)
  block:
    - name: Enable SELinux
      command: setenforce 1
      when: ansible_facts['os_family'] == 'RedHat'
    - name: Install required SELinux policies
      package:
        name: "{{ item }}"
        state: present
      loop:
        - selinux-policy-targeted
        - setools
        - policycoreutils-python
      when: ansible_facts['os_family'] == 'RedHat'
    - name: Enforce AppArmor profiles for Vault
      command: apparmor_parser -r /etc/apparmor.d/*
      when: ansible_facts['os_family'] == 'Debian'

