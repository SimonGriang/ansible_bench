---
- name: Ensure Vault package is installed
  ansible.builtin.package:
    name: vault
    state: present

- name: Configure Vault environment variables
  ansible.builtin.set_fact:
    VAULT_ADDR: "http://127.0.0.1:8200"

- name: Initialize Vault
  community.hashicorp.vault_init:
    path: /etc/vault
    cubbyhole: user
    delete_csr_after_selfhosted: true
    delete_key_after_selfhosted: true
    delete_root_token_after_selfhosted: true
    format: json
    generate_root_token: true
    generate_csr: false
    revoke_selfhosted_csr: true
    revoke_selfhosted_key: true
    revoke_selfhosted_root_token: true
    output_file: /etc/vault/init.json

- name: Unseal Vault
  community.hashicorp.vault_unseal:
    path: /etc/vault
    key: "{{ vault_unseal_key }}"
    cubbyhole: user

- name: Authenticate to Vault using root token
  community.hashicorp.vault_auth_token:
    token: "{{ vault_root_token }}"
    cubbyhole: user

- name: Configure Vault policies
  community.hashicorp.vault_policy:
    policies: |
      path "secret/*" {
        capabilities = ["create", "read", "update", "delete", "list"]
      }
    name: devops
    cubbyhole: user

