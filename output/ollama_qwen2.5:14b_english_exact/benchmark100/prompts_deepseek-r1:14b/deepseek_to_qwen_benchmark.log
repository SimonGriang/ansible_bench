    state: present

- name: Install OpenJDK Java
  when: java_vendor == "openjdk"
  package:
    name: "{{ 'openjdk-' ~ ansible_distribution_major_version ~ '-jre' if ansible_os_family == 'RedHat' else 'openjdk-jre' }}"
    state: present

- name: Install Oracle Java RPM from local
  when: java_source == "local" and java_format == "rpm"
  copy:
    src: "{{ java_rpm_path }}"
    dest: "/tmp/{{ java_rpm_filename }}"
  notify: Install Oracle Java RPM from local

- name: Install Oracle Java DEB from local
  when: java_source == "local" and java_format == "deb"
  copy:
    src: "{{ java_deb_path }}"
    dest: "/tmp/{{ java_deb_filename }}"
  notify: Install Oracle Java DEB from local

- name: Install Oracle Java RPM from repository
  when: java_source == "repository" and java_format == "rpm"
  package:
    name: "{{ oracle_java_rpm_package }}"
    state: present

- name: Configure Oracle Java targz installation
  when: java_format == "targz" and java_vendor == "oracle"
  unarchive:
    src: "{{ oracle_java_targz_path }}"
    dest: "/opt/java"
    remote_src: yes
  notify: Set Java alternative

- name: Install Oracle Java JCE policy
  when: java_jce is true and java_version == 8 and java_vendor == "oracle"
  copy:
    src: "{{ jce_policy_path }}"
    dest: "{{ java_home }}/jre/lib/security"
    owner: root
    group: root
    mode: 0644

- name: Set Java alternative
  when: java_format == "targz" and ansible_distribution != "Alpine"
  command: >
    alternatives --install /usr/bin/java java "{{ java_home }}/bin/java" 20000 --slave /usr/bin/javaws javaws "{{ java_home }}/bin/javaws" --slave /usr/bin/keytool keytool "{{ java_home }}/bin/keytool" --slave /usr/bin/oracle-javaws oracle-javaws "{{ java_home }}/bin/oracle-javaws" --slave /usr/bin/rcontrol rcontrol "{{ java_home }}/bin/rcontrol" --slave /usr/bin/rmid rmid "{{ java_home }}/bin/rmid" --slave /usr/bin/rmiregistry rmiregistry "{{ java_home }}/bin/rmiregistry" --slave /usr/bin/java_policytool java_policytool "{{ java_home }}/bin/policytool" --slave /usr/bin/jarjar jarjar "{{ java_home }}/bin/jarjar" --slave /usr/bin/jjs jjs "{{ java_home }}/bin/jjs" --slave /usr/bin/jrunscript jrunscript "{{ java_home }}/bin/jrunscript" --slave /usr/bin/jvisualvm jvisualvm "{{ java_home }}/bin/jvisualvm" --slave /usr/bin/jdb jdb "{{ java_home }}/bin/jdb" --slave /usr/bin/javac javac "{{ java_home }}/bin/javac" --slave /usr/bin/javah javah "{{ java_home }}/bin/javah" --slave /usr/bin/javap javap "{{ java_home }}/bin/javap" --slave /usr/bin/java_vm java_vm "{{ java_home }}/bin/java_vm" --slave /usr/bin/jconsole jconsole "{{ java_home }}/bin/jconsole" --slave /usr/bin/java_connect_tool java_connect_tool "{{ java_home }}/bin/java_connect_tool" --slave /usr/bin/wsgen wsgen "{{ java_home }}/bin/wsgen" --slave /usr/bin/wsimport wsimport "{{ java_home }}/bin/wsimport" --slave /usr/bin/xjc xjc "{{ java_home }}/bin/xjc"

- name: Find Java home directory
  command: readlink -f /usr/bin/java
  register: java_home_path

- name: Set JAVA_HOME in environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home_path.stdout }}"
    create: yes

