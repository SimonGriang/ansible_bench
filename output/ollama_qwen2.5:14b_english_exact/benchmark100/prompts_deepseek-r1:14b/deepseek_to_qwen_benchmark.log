      notify: disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  when: vault_hardening_configure_selinux_apparmor | bool
  block:
    - name: Enable SELinux
      lineinfile:
        path: /etc/selinux/config
        regexp: '^SELINUX='
        line: SELINUX=enforcing
      notify: enable_selinux
    - name: Install SELinux policies
      package:
        name: "{{ item }}"
        state: present
      loop:
        - selinux-policy-targeted
    - name: Enforce AppArmor profiles for Vault
      shell: aa-enforce /etc/apparmor.d/{vault.*}
      args:
        chdir: /etc/apparmor.d
      notify: enforce_apparmor_profiles

