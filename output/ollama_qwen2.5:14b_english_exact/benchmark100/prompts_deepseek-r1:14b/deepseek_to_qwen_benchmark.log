    state: present

- name: Configure vsftpd
  ansible.builtin.template:
    src: vsftpd.conf.j2
    dest: /etc/vsftpd.conf
    owner: root
    group: root
    mode: '0600'
  notify: restart vsftpd

- name: Start and enable vsftpd
  ansible.builtin.service:
    name: vsftpd
    state: started
    enabled: true


