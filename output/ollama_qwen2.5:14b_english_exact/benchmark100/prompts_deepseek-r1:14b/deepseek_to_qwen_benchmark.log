---
- name: Include OS-specific variables
  include_vars:
    dir: vars
    recursive: true
    file: "{{ ansible_distribution }}-{{ ansible_os_family }}.yml"
    fail_on_missing: false

- name: Include OS family specific tasks
  include_tasks: "{{ ansible_os_family }}-setup.yml"

- name: Install Docker packages
  ansible.builtin.yum:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    disable_gpg_check: true
    downgrades: no
  notify: restart docker
  when:
    - ansible_version|version_compare("2.12", "<") or (ansible_os_family != "RedHat" and ansible_os_family != "Debian")
    - docker_packages is defined
    - docker_packages_state is defined

- name: Install Docker packages with downgrade option
  ansible.builtin.yum:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    disable_gpg_check: true
    downgrades: yes
  notify: restart docker
  when:
    - ansible_version|version_compare("2.12", ">=")
    - ansible_os_family in ["RedHat", "Debian"]
    - docker_packages is defined
    - docker_packages_state is defined

- name: Install docker-compose plugin
  ansible.builtin.yum:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    disable_gpg_check: true
    downgrades: no
  notify: restart docker
  when:
    - docker_install_compose_plugin
    - ansible_version|version_compare("2.12", "<")
    - (ansible_os_family != "RedHat" and ansible_os_family != "Debian")

- name: Install docker-compose-plugin with downgrade option
  ansible.builtin.yum:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    disable_gpg_check: true
    downgrades: yes
  notify: restart docker
  when:
    - docker_install_compose_plugin
    - ansible_version|version_compare("2.12", ">=")
    - ansible_os_family in ["RedHat", "Debian"]

- name: Ensure /etc/docker directory exists
  ansible.builtin.file:
    path: /etc/docker
    state: directory
    mode: 0755
  when: docker_daemon_options is defined and docker_daemon_options|length > 0

- name: Configure Docker daemon options
  ansible.builtin.copy:
    content: "{{ docker_daemon_options | to_json }}"
    dest: /etc/docker/daemon.json
    mode: 0644
  notify: restart docker
  when: docker_daemon_options is defined and docker_daemon_options|length > 0

- name: Ensure Docker service is started and enabled
  ansible.builtin.service:
    name: docker
    state: started
    enabled: "{{ docker_service_enabled }}"
  notify: restart docker
  when: docker_service_manage

- name: Flush handlers to avoid firewall conflicts
  ansible.builtin.meta:
    flush_handlers: true

- name: Include docker-compose.yml tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group information
  ansible.builtin.getent:
    database: group
    key: docker
  when: docker_users is defined and docker_users|length > 0

- name: Set fact for user modification
  ansible.builtin.set_fact:
    docker_users_to_modify: true
  when:
    - docker_users is defined and docker_users|length > 0
    - not (docker_users|map('extract', ['name', 'primary_group'])|select('equalto', 'docker')|list|length == docker_users|length)

- name: Include docker-users.yml tasks
  include_tasks: docker-users.yml
  when: docker_users_to_modify

