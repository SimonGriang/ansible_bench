---
- name: locations | Enable modules
  block:
    - name: Enable proxy module
      ansible.builtin.apache2cmd:
        args: a2enmod
        module: proxy
      when: ansible_facts.os_family in ['Debian', 'Suse']

    - name: Enable proxy_http module
      ansible.builtin.apache2cmd:
        args: a2enmod
        module: proxy_http
      when: ansible_facts.os_family in ['Debian', 'Suse']

- name: locations | Configure locations
  template:
    src: httpd_location.conf.j2
    dest: "{{ item.dest }}"
    owner: root
    group: root
    mode: '0644'
  with_items: "{{ httpd_locations }}"
  notify: httpd config test
  notify: httpd restart

