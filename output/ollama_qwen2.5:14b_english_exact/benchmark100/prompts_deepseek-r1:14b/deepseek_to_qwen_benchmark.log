---
- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_check

- name: Check Helm version
  command: helm version --client
  when: helm_check.stat.exists
  register: helm_existing_version

- name: Download helm
  unarchive:
    src: "https://get.helm.sh/helm-v{{ helm_version }}-linux-amd64.tar.gz"
    remote_src: yes
    dest: /tmp
    creates: /usr/local/bin/helm
  when: not helm_check.stat.exists or helm_existing_version.rc != 0
  register: helm_download

- name: Copy helm binary into place
  copy:
    src: /tmp/linux-amd64/helm
    dest: /usr/local/bin/helm
    mode: '0755'
  when: helm_download.changed
  become: yes

