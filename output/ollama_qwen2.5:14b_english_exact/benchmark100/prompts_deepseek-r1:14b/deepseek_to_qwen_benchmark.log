---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ httpd_packages }}"
  when: ansible_os_family == "RedHat"
  notify: test_config

- name: Install apache httpd
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ httpd_packages }}"
  when: ansible_os_family == "Debian"
  notify: test_config

- name: Configure selinux
  selinux:
    policylabel: "{{ item.policylabel }}"
    permissive: "{{ item.permissive }}"
    state: "{{ item.state }}"
  loop: "{{ selinux_booleans }}"
  when: selinux_enabled

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify: test_config
  notify: restart_httpd

- name: Activate httpd module | Debian
  command: a2enmod "{{ item }}"
  args:
    creates: "{{ item }}"
  loop: "{{ httpd_modules }}"
  when: ansible_os_family == "Debian"

- import_tasks: ssl.yml
  when: httpd_ssl_enabled

- import_tasks: locations.yml
  when: httpd_locations is defined

- import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_config_src }}"
    dest: "{{ httpd_ports_config_dest }}"
    mode: '0644'
  notify: test_config
  when: ansible_os_family in ["Debian", "Suse"]

- import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ item }}"
    state: absent
  loop: "{{ httpd_remove_example }}"
  when: httpd_remove_example | length > 0

- name: Start and enable httpd
  systemd:
    name: "{{ httpd_service }}"
    enabled: yes
    state: started

