---
- name: Restart RKE2 service on {{ rke2_node_name }}
  systemd:
    name: "{{ rke2_service_name }}"
    state: restarted
    enabled: yes
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  kubectl:
    kubeconfig: /etc/rancher/rke2/rke2.config
    command: get
    type: node
    name: "{{ item.metadata.name }}"
    wait: yes
    wait_timeout: 15
  loop: "{{ rke2_nodes | community.general.k8s_info() }}"
  retries: 100
  delay: 15
  delegate_to: "{{ groups['rke2_servers_group_name'][0] }}"
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  kubectl:
    kubeconfig: /etc/rancher/rke2/rke2.config
    command: get
    type: pod
    wait: yes
    wait_timeout: 15
  retries: 100
  delay: 15
  delegate_to: "{{ groups['rke2_servers_group_name'][0] }}"
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready | bool

