ote_user: root\n\n- name: Removing default html\n  file:\n    path: "{{ httpd_data_directory }}/index.html"\n    state: absent\n  when: httpd_remove_example is defined and httpd_remove_example == True\n  remote_user: root\n\n- name: Start and enable httpd\n  systemd:\n    name: httpd\n    state: started\n    enabled: yes\n  remote_user: root' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-09T09:48:04.599802957Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12564472821, 'load_duration': 105630712, 'prompt_eval_count': 1443, 'prompt_eval_duration': 430580975, 'eval_count': 594, 'eval_duration': 12020793252, 'model_name': 'qwen2.5:14b'} id='run--140f9054-68ac-4da6-a1d4-34b0a888fc88-0' usage_metadata={'input_tokens': 1443, 'output_tokens': 594, 'total_tokens': 2037}
