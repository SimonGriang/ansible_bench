---
- name: Check if Python is installed
  command: which python
  register: python_path
  changed_when: false
  failed_when: false

- name: Check if Python3 is installed
  command: which python3
  register: python3_path
  changed_when: false
  failed_when: false

- name: Debug Python executable path
  debug:
    msg: "Python executable path: {{ python_path.stdout }}"

- name: Debug Python3 executable path
  debug:
    msg: "Python3 executable path: {{ python3_path.stdout }}"

- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  vars:
    ansible_host: localhost

- name: Install requirements
  apt:
    pkg: "{{ item }}"
    state: present
  loop: "{{ openssl_requirements }}"
  when: ansible_os_family == 'Debian'

- name: Ensure packaging is available via dnf
  yum:
    name: python3-packaging
    state: present
  when: ansible_os_family == 'RedHat'

- name: Install pip packages
  pip:
    name: "{{ item }}"
    requirements: "{{ lookup('ansible.builtin.file', 'requirements.txt', wantlist=True) | first }}"
    state: present
  loop: "{{ lookup('ansible.builtin.file', 'requirements.txt', wantlist=True) }}"
  when: openssl_items.pip_packages is defined

- name: Create key directory
  file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: "u=rwx,g=rx,o=rx"
    owner: root
    group: root

- name: Create csr directory
  file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: "u=rwx,g=rx,o=rx"
    owner: root
    group: root

- name: Create crt directory
  file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: "u=rwx,g=rx,o=rx"
    owner: root
    group: root

- name: Include create.yml
  include_tasks: create.yml
  loop: "{{ openssl_items }}"
  when: item.create is defined

