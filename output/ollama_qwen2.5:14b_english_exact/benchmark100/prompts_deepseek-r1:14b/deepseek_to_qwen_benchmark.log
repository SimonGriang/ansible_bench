---
- import_tasks: assert.yml
  remote_addr: localhost
  when: True
  run_once: true

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when:
    - selinux_status is defined
    - not (connection == 'container' or connection == 'docker' or connection == 'community.docker.docker')
  block:
    - name: Manage SELinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Manage SELinux booleans
      when: selinux_booleans is defined
      selboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: yes
      loop: "{{ selinux_booleans }}"
      notify: Reboot

