---
- import_tasks: assert.yml
  remote_user: root
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ httpd_packages }}"
  remote_user: root

- name: Configure selinux
  block:
    - name: Ensure selinux booleans are set
      seboolean:
        name: "{{ item.key }}"
        state: "{{ item.value }}"
      loop: "{{ httpd_sebooleans|dict2items }}"
      when: httpd_is_selinux_enabled is defined and httpd_is_selinux_enabled == True
      remote_user: root

    - name: Allow connections on specified ports
      seport:
        port: "{{ item }}"
        proto: tcp
        state: allow
      loop: "{{ httpd_ports }}"
      when: httpd_is_selinux_enabled is defined and httpd_is_selinux_enabled == True
      remote_user: root
  remote_user: root

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify: config_test
  remote_user: root

- name: Activate httpd module | Debian
  shell: a2enmod "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == 'Debian'
  remote_user: root

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable is defined and https_ssl_enable == True
  remote_user: root

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined
  remote_user: root

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined
  remote_user: root

- name: Configure ports
  template:
    src: ports.conf.j2
    dest: "{{ httpd_ports_config_file }}"
  notify: config_test
  when: ansible_os_family in ['Debian', 'Suse']
  remote_user: root

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined
  remote_user: root

- name: Flush handlers
  meta: flush_handlers
  remote_user: root

- name: Removing default html
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example is defined and httpd_remove_example == True
  remote_user: root

- name: Start and enable httpd
  systemd:
    name: httpd
    state: started
    enabled: yes
  remote_user: root

