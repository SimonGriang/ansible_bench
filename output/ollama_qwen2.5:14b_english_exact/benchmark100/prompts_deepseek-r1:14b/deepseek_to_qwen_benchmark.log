---
- name: Task 1: Set the package state based on how Ansible is installed
  ansible.builtin.set_fact:
    ansible_package_state: "{{ 'present' if ansible_facts.packages|search('ansible') else 'absent' }}"

- name: Task 2: Set up Ansible on RedHat
  include_tasks: tasks/setup-RedHat.yml
  when: ansible_facts.os_family == 'RedHat' and ansible_distribution != 'Fedora' and ansible_package_state == 'present'

- name: Task 3: Set up Ansible on Fedora
  include_tasks: tasks/setup-Fedora.yml
  when: ansible_distribution == 'Fedora' and ansible_package_state == 'present'

- name: Task 4: Set up Ansible on Ubuntu
  include_tasks: tasks/setup-Ubuntu.yml
  when: ansible_distribution == 'Ubuntu' and ansible_package_state == 'present'

- name: Task 5: Set up Ansible on Debian
  include_tasks: tasks/setup-Debian.yml
  when: ansible_distribution == 'Debian' and ansible_package_state == 'present'

- name: Task 6: Set up Ansible using Pip
  include_tasks: tasks/setup-pip.yml
  when: ansible_package_state == 'absent'

