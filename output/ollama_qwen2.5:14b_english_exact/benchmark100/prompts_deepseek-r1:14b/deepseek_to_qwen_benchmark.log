---
- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: /etc/rancher/rke2/manifests
    state: directory
    mode: '0750'
    owner: root
    group: root

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/rancher/rke2/manifests/
    mode: '0640'
    owner: root
    group: root
  with_items:
    - templates/kube-vip-ds.yaml.j2
    - templates/kube-vip-services.yaml.j2
  notify: restart rke2-agent

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/rancher/rke2/manifests/
    mode: '0640'
    owner: root
    group: root
  with_items:
    - templates/kube-vip-lb.yaml.j2
  when: kube_vip_cloud_provider_enabled
  notify: restart rke2-agent

