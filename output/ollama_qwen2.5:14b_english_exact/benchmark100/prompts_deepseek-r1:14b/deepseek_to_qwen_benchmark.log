---
- import_tasks: assert.yml

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - connection is 'network'
    - ansible_play_hosts_all|difference(connections|map('extract', ['network', 'hosts'])) == []

- name: Prepare system
  raw: whoami
  register: whoami
  failed_when: false
  changed_when: false
  delegate_to: localhost
  when: whoami is not defined
  run_once: true
  loop_control:
    loop_var: item
  with_items:
    - item: 'whoami'

- name: Ensure sudo access
  raw: whoami
  register: sudo_test
  failed_when: false
  changed_when: false
  delegate_to: localhost
  when: sudo_test is not defined
  run_once: true
  loop_control:
    loop_var: item
  with_items:
    - item: 'sudo_test'

- name: Gather facts
  setup:
  when: sudo_test is not defined
  run_once: true

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  become: "{{ bootstrap_become }}"
  loop: "{{ bootstrap_facts_packages }}"


