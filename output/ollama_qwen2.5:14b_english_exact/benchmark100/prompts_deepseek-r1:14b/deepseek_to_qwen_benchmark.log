---
- import_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: "{{ dns_data_dir }}", mode: "0755", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }
    - { path: "{{ dns_config_dir }}", mode: "0755", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    uid: "{{ dns_user_id }}"
    system: yes
    state: present

- name: Generate rndc key
  copy:
    content: "{{ lookup('pipe', 'dnssec-keygen -r /dev/urandom -a hmac-md5 -b 128 -K {{ dns_config_dir }} -C {{ dns_owner }} -G {{ dns_group }} {{ dns_key_name }}') }}"
    dest: "{{ dns_config_dir }}/rndc.key"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_config_dir }}/rndc.key"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_root_hints_file }}"
    mode: "0644"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns

- name: Create zone file
  block:
    - name: Create DNS zone file
      template:
        src: "{{ item.template }}"
        dest: "{{ item.dest }}"
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
        mode: "0640"
      notify: Rndc reload
    - name: Validate DNS zone file
      command: named-checkzone {{ item.zone }} {{ item.dest }}
      register: validate_result
      failed_when: "'No errors' not in validate_result.stdout"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: "{{ dns_config_file_template }}"
    dest: "{{ dns_config_file }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0644"
  notify: Restart dns

- name: Place systemd override
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    owner: "root"
    group: "root"
    mode: "0644"
    remote_src: yes
  loop: "{{ dns_systemd_overrides }}"
  when: dns_use_systemd

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: yes

