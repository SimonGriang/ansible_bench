---
- import_tasks: assert.yml

- name: Install using package
  when: install_method == "package" and ansible_os_family == "RedHat"
  yum:
    name: "{{ product_name }}"
    state: present
  become: yes

- name: Install using package
  when: install_method == "package" and ansible_os_family == "Debian"
  apt:
    name: "{{ product_name }}"
    state: present
  become: yes

- name: Configure debian
  when: ansible_os_family == "Debian"
  block:
    - name: Add HashiCorp GPG key
      apt_key:
        url: https://apt.releases.hashicorp.com/gpg
        state: present
      become: yes

    - name: Add HashiCorp apt repository
      apt_repository:
        repo: "deb https://apt.releases.hashicorp.com {{ ansible_facts['os_distribution']['codename'] }} {{ product_name }}"
        state: present
      become: yes

- name: Install hashicorp product using package
  when: install_method == "package"
  block:
    - name: Install product
      yum:
        name: "{{ product_name }}"
        state: present
      become: yes
      when: ansible_os_family == "RedHat"

    - name: Install product
      apt:
        name: "{{ product_name }}"
        state: present
      become: yes
      when: ansible_os_family == "Debian"

    - name: Install product with specific version
      yum:
        name: "{{ product_name }}={{ product_version }}"
        state: present
      become: yes
      when: ansible_os_family == "RedHat" and product_version is defined

    - name: Install product with specific version
      apt:
        name: "{{ product_name }}={{ product_version }}"
        state: present
      become: yes
      when: ansible_os_family == "Debian" and product_version is defined

- name: Install manually
  when: install_method == "manual"
  block:
    - name: Download product
      get_url:
        url: "{{ product_url }}"
        dest: "{{ product_dest }}"
        mode: "0755"
        remote_src: yes
      become: yes

    - name: Set permissions
      file:
        path: "{{ product_dest }}"
        mode: "0755"
      become: yes


