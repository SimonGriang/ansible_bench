---
- import_tasks: assert.yml
  remote_addr: localhost

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
    - name: Set SELinux state and policy
      selinux:
        policy: "{{ selinux_policy }}"
        state: "{{ selinux_state }}"
      notify: Reboot

    - name: Manage SELinux booleans
      seboolean:
        name: "{{ item.boolean }}"
        state: "{{ item.state }}"
      loop: "{{ selinux_booleans }}"
      notify: Reboot

