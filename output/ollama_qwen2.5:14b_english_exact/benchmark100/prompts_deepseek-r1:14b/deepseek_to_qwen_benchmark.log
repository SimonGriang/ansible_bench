  openssl_csr:
    path: "/etc/ssl/csr/myapp.csr"
    privatekey_path: "/etc/ssl/private/myapp.key"
    mode: "0640"
    owner: "root"
    group: "root"
    common_name: "myapp.example.com"
  tags:
    - csr

- name: Generate an OpenSSL X.509 certificate
  openssl_certificate:
    path: "/etc/ssl/certs/myapp.crt"
    privatekey_path: "/etc/ssl/private/myapp.key"
    csr_path: "/etc/ssl/csr/myapp.csr"
    mode: "0640"
    owner: "root"
    group: "root"
    provider: "selfsigned"
  tags:
    - cert

- name: Generate a PKCS#12 file
  openssl_pkcs12:
    export: "/etc/ssl/private/myapp.p12"
    name: "myapp"
    key: "/etc/ssl/private/myapp.key"
    chain: "/etc/ssl/certs/myapp.crt"
    friendly_name: "myapp"
    mode: "0640"
    owner: "root"
    group: "root"
  tags:
    - pkcs12

- name: Read private key content
  slurp:
    src: "/etc/ssl/private/myapp.key"
  register: private_key_content
  tags:
    - key_content

- name: Read certificate content
  slurp:
    src: "/etc/ssl/certs/myapp.crt"
  register: cert_content
  tags:
    - cert_content

- name: Create a combined private key and certificate file
  copy:
    content: "{{ private_key_content.content | b64decode }}\n{{ cert_content.content | b64decode }}"
    dest: "/etc/ssl/private/myapp.pem"
    mode: "0640"
    owner: "root"
    group: "root"
  tags:
    - combined_key_cert

