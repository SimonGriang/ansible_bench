      unarchive:
        src: "{{ item }}"
        dest: /usr/local/jdk1.8.0_{{ java_version }}/jre/lib/security
        remote_src: yes
      with_items: "{{ lookup('ansible.builtin.fileglob', 'jce_policy*.tar.gz') }}"
    - name: Set JCE permissions
      file:
        path: /usr/local/jdk1.8.0_{{ java_version }}/jre/lib/security
        mode: '0755'

- name: Set Java alternative
  when: java_format == "targz" and ansible_distribution != 'Alpine'
  command: alternatives --install /usr/bin/java java /usr/local/jdk1.8.0_{{ java_version }}/bin/java 1
  args:
    creates: /usr/bin/java

