---
- name: Restore etcd - get all nodes
  kubectl:
    command: get
    resource: node
    format: json
  register: node_list
  changed_when: False

- name: Extract node names
  set_fact:
    node_names: "{{ node_list.result.items|json_query(\"[].metadata.name\") }}"

- name: Restore etcd - remove old nodes
  block:
    - name: Identify nodes to remove
      set_fact:
        nodes_to_remove: "{{ node_names|difference(groups['rke2_cluster_group_name']) }}"

    - name: Remove nodes from cluster
      kubectl:
        command: delete
        resource: node
        name: "{{ item }}"
      loop: "{{ nodes_to_remove }}"
      when: nodes_to_remove is defined and nodes_to_remove|length > 0

