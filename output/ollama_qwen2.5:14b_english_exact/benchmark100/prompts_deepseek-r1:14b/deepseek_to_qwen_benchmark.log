---
- name: Import assertion file
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  when: inventory_hostname == 'localhost'

- name: Enable Redis module stream for RHEL 8
  ansible.builtin.yum:
    name: redis
    state: installed
  when: ansible_distribution == 'RedHat' and ansible_distribution_major_version == '8'

- name: Install Redis package
  ansible.builtin.package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure Redis settings
  ansible.builtin.template:
    src: redis.conf-{{ ansible_distribution }}.j2
    dest: /etc/redis/{{ ansible_distribution }}.conf
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: restart_redis

- name: Start and enable Redis service
  ansible.builtin.service:
    name: "{{ redis_service }}"
    state: started
    enabled: true

