---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  remote_addr: localhost

- name: Install nginx
  apt:
    name: nginx
    state: present
  become: yes

- name: Place nginx.conf
  template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    owner: root
    group: root
    mode: '0644'
