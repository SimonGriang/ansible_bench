---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  ansible.builtin.package:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  ansible.builtin.package:
    name: "{{ item.package }}"
    state: "{{ item.state }}"
  loop: "{{ rsyslog_packages }}"
  notify: Restart rsyslog

- name: Install additional rsyslog packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features | default([]) | map('extract', ['package']) | list }}"

- name: Configuring default rsyslog
  ansible.builtin.template:
    src: "{{ rsyslog_config_file_format }}"
    dest: "{{ rsyslog_dest_conf_file }}"
    mode: "{{ rsyslog_config_file_format_mode | default('0644') }}"
  notify: Restart rsyslog

- name: Make configuration directory
  ansible.builtin.file:
    path: /etc/rsyslog.d/
    state: directory
    mode: '0755'

- name: Configuring rsyslog forward rule
  ansible.builtin.template:
    src: forward_rule.conf.j2
    dest: /etc/rsyslog.d/{{ rsyslog_forward_rule_name }}.conf
  when: not rsyslog_deploy_default_config | bool
  notify: Restart rsyslog

- name: Configuring additional config files
  ansible.builtin.copy:
    src: "{{ item.key }}"
    dest: /etc/rsyslog.d/{{ item.key | split('/') | last }}
    mode: "{{ item.value.mode | default('0644') }}"
  loop: "{{ rsyslog_rsyslog_d_files | default({}) | dict2items }}"
  when: item.value.state is defined
  notify: Restart rsyslog

- name: Start and enable rsyslog
  ansible.builtin.systemd:
    name: "{{ rsyslog_service }}"
    enabled: true
    state: started

