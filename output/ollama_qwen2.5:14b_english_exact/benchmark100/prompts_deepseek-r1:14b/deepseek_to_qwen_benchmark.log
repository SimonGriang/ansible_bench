---
- import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ packages }}"
  notify:
    - mysql_root_password
    - systemd_daemon_reload

- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/conf.d/mysql.cnf
    line: "{{ item }}"
  with_items: "{{ server_options }}"
  notify:
    - mysql_server_restart

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/conf.d/mysql-client.cnf
    line: "socket={{ mysqlclient_socket }}"
  notify:
    - mysql_server_restart

- name: Initialize mysql
  command: "{{ init_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ service_name }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/conf.d/my.cnf
    mode: 0644
  notify:
    - mysql_server_restart

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ databases }}"
  when: not initial_import

- name: List databases
  command: mysql -Bse 'show databases;'
  register: current_databases
  changed_when: false

- name: Import database
  command: mysql -u{{ mysql_root_user }} -p{{ mysql_root_pass }} {{ item }} < "{{ import_location }}/{{ item }}.sql"
  when: initial_import and item not in current_databases.stdout.splitlines()

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    host: "{{ item.host }}"
  with_items: "{{ users }}"
  notify:
    - mysql_server_restart

- name: Flush handlers again
  meta: flush_handlers

