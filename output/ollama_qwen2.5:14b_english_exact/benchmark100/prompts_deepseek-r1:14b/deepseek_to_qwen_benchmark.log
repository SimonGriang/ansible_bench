---
- name: Create docroot directories for each virtual host
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  when: httpd_vhosts is defined and item.documentroot is defined and create_docroot|default(true) == true

- name: Configure virtual host settings
  template:
    src: vhost_conf_template
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: 0644
  loop: "{{ httpd_vhosts }}"

- name: Enable virtual hosts on Debian systems
  become: yes
  block:
    - name: Enable site with a2ensite
      command: /usr/sbin/a2ensite {{ item.name }}.conf
      creates: /etc/apache2/sites-enabled/{{ item.name }}.conf
      when: ansible_os_family == 'Debian'
      notify: Test httpd configuration validity

    - name: Create symlink for enabled site
      file:
        src: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
        dest: /etc/apache2/sites-enabled/{{ item.name }}.conf
        state: link
        force: yes
      when: ansible_os_family == 'Debian'
