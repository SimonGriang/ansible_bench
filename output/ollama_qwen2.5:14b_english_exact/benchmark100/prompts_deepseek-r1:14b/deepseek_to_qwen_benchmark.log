---
- name: Create /etc/openvpn/easy-rsa directory with correct permissions
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Initialize OpenVPN PKI structure
  command: /usr/share/easy-rsa/easyrsa init-pki

- name: Generate OpenVPN CA certificate
  command: /usr/share/easy-rsa/easyrsa build-ca nopass
  environment:
    EASYRSA_BATCH: "yes"

- name: Generate Diffie-Hellman parameters
  command: /usr/share/easy-rsa/easyrsa gen-dh

- name: Generate server certificate
  command: /usr/share/easy-rsa/easyrsa build-server-full server nopass
  environment:
    EASYRSA_BATCH: "yes"

- name: Generate client certificate
  command: /usr/share/easy-rsa/easyrsa build-client-full client nopass
  environment:
    EASYRSA_BATCH: "yes"

- name: Generate Certificate Revocation List
  command: /usr/share/easy-rsa/easyrsa gen-crl

- name: Generate OpenVPN TA key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy PKI files to /etc/openvpn/server directory
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/{{ item }}
    mode: 0640
  with_items:
    - "ca.crt"
    - "ta.key"
    - "dh.pem"
    - "server.crt"
    - "server.key"
    - "crl.pem"

- name: Copy additional PKI files to /etc/openvpn directory
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/{{ item }}
    mode: 0640
  with_items:
    - "ca.crt"
    - "crl.pem"

- name: Place OpenVPN server configuration file
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: 0640
    owner: root
    group: root
  notify: restart openvpn service

