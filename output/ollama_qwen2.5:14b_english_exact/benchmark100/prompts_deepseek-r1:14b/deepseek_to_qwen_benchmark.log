      command: /usr/local/bin/rke2 install
      args:
        creates: /usr/local/bin/rke2

- name: Perform CIS hardening when a CIS profile is defined
  block:
    - name: Apply CIS hardening
      include_tasks: cis-hardening.yml
      when: cis_profile is defined

- name: Find and identify the active server in the cluster
  block:
    - name: Identify active server
      command: rke2 agent
      register: active_server_result
      changed_when: false
      failed_when: false

- name: Enable IPVS kernel module for load balancing
  block:
    - name: Enable IPVS kernel module
      command: modprobe ip_vs
      when: ha_mode|default('false') == 'true'

- name: Copy kube-vip manifests to the master node
  block:
    - name: Copy kube-vip manifests
      copy:
        src: kube-vip-manifests/
        dest: /etc/rke2/kube-vip/
      when: ha_mode|default('false') == 'true'

- name: Copy ingress-nginx manifests to the master node
  block:
    - name: Copy ingress-nginx manifests
      copy:
        src: ingress-nginx-manifests/
        dest: /etc/rke2/ingress-nginx/
      when: ingress_nginx_values is defined

- name: Prepare the first server node in the cluster
  block:
    - name: Prepare first server node
      include_tasks: first-server-node.yml
      when: is_first_server|default('false') == 'true'

- name: Perform etcd restore tasks when specific conditions are met
  block:
    - name: Restore etcd
      include_tasks: etcd-restore.yml
      when: etcd_restore|default('false') == 'true'

- name: Download kubeconfig file to the Ansible localhost when enabled
  block:
    - name: Download kubeconfig
      command: rke2 kubeconfig
      register: kubeconfig_result
      when: download_kubeconfig|default('false') == 'true'

- name: Prepare and join remaining cluster nodes when the active server is defined
  block:
    - name: Prepare and join remaining nodes
      include_tasks: join-remaining-nodes.yml
      when: active_server is defined

- name: Perform rolling restart of server nodes when version changes
  block:
    - name: Rolling restart of servers
      include_tasks: rolling-restart-servers.yml
      when: rolling_restart_servers|default('false') == 'true'

- name: Perform rolling restart of agent nodes when version changes
  block:
    - name: Rolling restart of agents
      include_tasks: rolling-restart-agents.yml
      when: rolling_restart_agents|default('false') == 'true'

- name: Flush all registered handlers
  meta: flush_handlers

- name: Perform rolling restart when configuration files change
  block:
    - name: Rolling restart on config change
      include_tasks: rolling-restart-config.yml
      when: rolling_restart_config|default('false') == 'true'

- name: Perform final steps including a summary
  block:
    - name: Final steps
      include_tasks: final-steps.yml

