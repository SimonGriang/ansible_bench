---
- name: Create docroot for each vhost
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  when:
    - item.documentroot is defined
    - item.create_docroot is not defined or item.create_docroot is not false
  loop: "{{ httpd_vhosts }}"

- name: Configure vhosts
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  notify: Test httpd configuration validity
  loop: "{{ httpd_vhosts }}"

