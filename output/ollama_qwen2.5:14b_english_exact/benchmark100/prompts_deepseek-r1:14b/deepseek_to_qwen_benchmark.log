---
- name: Create local SSH key directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0750'
    owner: "{{ user_name }}"
    group: "{{ user_name }}"
  become: yes

- name: Manage user account
  user:
    name: "{{ user_name }}"
    uid: "{{ user_uid }}"
    comment: "{{ user_comment }}"
    home: "{{ user_home }}"
    shell: "{{ user_shell }}"
    state: present
  become: yes

- name: Set sudo options for user
  lineinfile:
    path: /etc/sudoers.d/{{ user_name }}_sudo
    line: "{{ user_name }} ALL=(ALL) NOPASSWD:ALL"
    create: yes
    mode: '0440'
    owner: root
    group: root
  become: yes

- name: Generate private SSH key for user
  shell: ssh-keygen -t rsa -b 4096 -f "{{ user_home }}/.ssh/id_rsa" -q -N ""
  args:
    creates: "{{ user_home }}/.ssh/id_rsa"
  register: ssh_keygen_result
  become: yes

- name: Generate public SSH key for user
  shell: ssh-keygen -y -f "{{ user_home }}/.ssh/id_rsa" > "{{ user_home }}/.ssh/id_rsa.pub"
  args:
    creates: "{{ user_home }}/.ssh/id_rsa.pub"
  become: yes

- name: Convert SSH key to ppk format for user
  shell: ssh-keygen -p -m pkcs8 -f "{{ user_home }}/.ssh/id_rsa" -o -P "" -N ""
  become: yes

- name: Get or set the home directory for user
  ansible.builtin.set_fact:
    user_home: /home
  when: user_home == ""
  become: no

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
  become: yes

- name: Deploy authorized keys for user
  copy:
    src: "{{ user_home }}/.ssh/id_rsa.pub"
    dest: "{{ user_home }}/.ssh/authorized_keys"
    mode: '0600'
  become: yes

- name: Remove unauthorized keys for user
  shell: ssh-keygen -R "{{ user_home }}/.ssh/authorized_keys"
  become: yes

- name: Copy generated private SSH key for user
  copy:
    src: "{{ user_home }}/.ssh/id_rsa"
    dest: "{{ user_home }}/{{ user_name }}_rsa"
    mode: '0600'
  become: yes

- name: Check users password valid time for user
  command: chage -l {{ user_name }}
  register: password_validity
  become: yes

- name: Set users password valid time for user
  command: chage -M 90 {{ user_name }}
  become: yes

- name: Place private key file for user
  file:
    path: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
  become: yes

