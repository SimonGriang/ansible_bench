- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that: "'systemd' in lookup('pipe', 'cat /proc/1/comm')"
    msg: "System is not using systemd as the init system"

- name: Get latest release and set promtail version
  ansible.builtin.get_url:
    url: https://github.com/grafana/loki/releases/latest
    dest: /tmp/promtail-latest-release
    force: yes
  register: latest_release_info
  ansible.builtin.set_fact:
    promtail_version: "{{ latest_release_info.content | regex_replace('.*tag/(.+).*', '\\1') }}"

- name: Test if zip local archive exists and assert local binary exists
  ansible.builtin.stat:
    path: "{{ local_zip_archive_path }}"
  register: local_binary_check
  failed_when: local_binary_check.stat.exists == False
  changed_when: local_binary_check.stat.exists == False
  ansible.builtin.assert:
    that: local_binary_check.stat.exists | bool
    msg: "Local binary archive does not exist at {{ local_zip_archive_path }}"

- name: Get checksum list and set checksum for target architecture
  ansible.builtin.get_url:
    url: https://github.com/grafana/loki/releases/download/{{ promtail_version }}/checksums.txt
    dest: /tmp/promtail-checksums.txt
  register: checksum_info
  ansible.builtin.set_fact:
    promtail_checksum: "{{ checksum_info.content.splitlines() | select('search', 'promtail-linux-amd64.zip') | first }}"

