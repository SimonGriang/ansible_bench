content='---\n- name: Task 1: Set the package state based on how Ansible is installed\n  ansible.builtin.set_fact:\n    ansible_package_state: present\n  when: ansible_facts.packages is defined and \'ansible\' in ansible_facts.packages\n  register: ansible_package_state\n  changed_when: False\n\n- name: Task 1: Set the package state based on how Ansible is installed\n  ansible.builtin.set_fact:\n    ansible_package_state: absent\n  when: ansible_facts.packages is not defined or \'ansible\' not in ansible_facts.packages\n  register: ansible_package_state\n  changed_when: False\n\n- name: Task 2: Set up Ansible on RedHat\n  include_tasks: setup-RedHat.yml\n  when: ansible_facts.os_family == "RedHat" and ansible_facts.distribution != "Fedora" and ansible_package_state.ansible_package_state == "present"\n\n- name: Task 3: Set up Ansible on Fedora\n  include_tasks: setup-Fedora.yml\n  when: ansible_facts.distribution == "Fedora" and ansible_package_state.ansible_package_state == "present"\n\n- name: Task 4: Set up Ansible on Ubuntu\n  include_tasks: setup-Ubuntu.yml\n  when: ansible_facts.distribution == "Ubuntu" and ansible_package_state.ansible_package_state == "present"\n\n- name: Task 5: Set up Ansible on Debian\n  include_tasks: setup-Debian.yml\n  when: ansible_facts.distribution == "Debian" and ansible_package_state.ansible_package_state == "present"\n\n- name: Task 6: Set up Ansible using Pip\n  include_tasks: setup-pip.yml\n  when: ansible_package_state.ansible_package_state == "absent"' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-19T10:33:17.350727485Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5902852836, 'load_duration': 107606105, 'prompt_eval_count': 507, 'prompt_eval_duration': 109179343, 'eval_count': 383, 'eval_duration': 5673485610, 'model_name': 'qwen2.5:14b'} id='run--3ac683a8-17e7-4ffd-be8a-b4e78c6b9d36-0' usage_metadata={'input_tokens': 507, 'output_tokens': 383, 'total_tokens': 890}
