---
- name: Create the RKE2 config directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  shell: |
    if [ -n "{{ rke2_server_node_taints }}" ]; then
      kubectl taint nodes {{ inventory_hostname }} {{ rke2_server_node_taints }}
    fi

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rke2/config.yaml
    mode: '0640'
  notify: restart_rke2_server

- name: Copy kubelet configuration file
  copy:
    src: "{{ rke2_kubelet_config_src }}"
    dest: /etc/rke2/kubelet.yaml
    mode: '0640'
  notify: restart_rke2_server
  when: rke2_kubelet_config is defined and rke2_kubelet_config is not ''

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ containerd_registry_config_src }}"
    dest: /etc/rke2/registries.yaml
    mode: '0640'
  notify: restart_rke2_server
  when: containerd_registry_mirror_config is defined or containerd_registry_config is defined

- name: Register etcd restore from file
  set_fact:
    etcd_restore_from_file: "{{ etcd_snapshot_file is defined and etcd_snapshot_file is not none and etcd_snapshot_file | stat.exists and not rke2_service_is_running }}"

- name: Register etcd restore from S3
  set_fact:
    etcd_restore_from_s3: "{{ (etcd_s3_bucket is defined and etcd_s3_bucket is not none) and (etcd_s3_bucket_key is defined and etcd_s3_bucket_key is not none) and (etcd_s3_region is defined and etcd_s3_region is not none) and not rke2_service_is_running }}"

- name: Restore etcd from file
  block:
    - name: Create etcd restore directory
      file:
        path: "{{ etcd_snapshot_dir }}"
        state: directory
        mode: '0750'
    - name: Copy etcd snapshot file
      copy:
        src: "{{ etcd_snapshot_file }}"
        dest: "{{ etcd_snapshot_dir }}/{{ etcd_snapshot_file | basename }}"
        mode: '0640'
    - name: Run etcd restore command
      command: "{{ rke2_binary }} etcd restore --dir={{ etcd_snapshot_dir }} --data-dir=/var/lib/rke2/etcd"
      args:
        creates: /var/lib/rke2/etcd/etcd.db

- name: Restore etcd from S3
  block:
    - name: Run etcd restore command from S3
      command: "{{ rke2_binary }} etcd restore --bucket={{ etcd_s3_bucket }} --key={{ etcd_s3_bucket_key }} --region={{ etcd_s3_region }} --data-dir=/var/lib/rke2/etcd"
      args:
        creates: /var/lib/rke2/etcd/etcd.db

- name: Start RKE2 service
  systemd:
    name: rke2-server
    enabled: yes
    state: started
    daemon_reload: yes
  notify: restart_rke2_server
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"

- name: Mask RKE2 agent service
  systemd:
    state: masked
    name: rke2-agent

- name: Wait for first server to be ready (no CNI)
  wait_for:
    path: /var/lib/rancher/rke2/server/node-registries.json
    search string: '"state":"ready"'
    sleep: 10
  when: rke2_cni is not defined

- name: Wait for first server to be ready (with CNI)
  wait_for:
    path: /var/lib/rancher/rke2/server/node-registries.json
    search string: '"state":"ready"'
    sleep: 10
  when: rke2_cni is defined

- name: Restore etcd
  block:
    - name: Delete old etcd node
      shell: |
        kubectl delete node {{ item }}
      with_items: "{{ rke2_old_nodes | default([]) }}"
    - name: Delete old etcd secrets
      shell: |
        kubectl delete secret {{ item }}
      with_items: "{{ rke2_old_secrets | default([]) }}"
    - name: Perform etcd restoration
      include_tasks: etcd_restore.yml
      when: etcd_restore_from_file or etcd_restore_from_s3

- name: Set Active Server variable
  set_fact:
    rke2_active_server: "{{ rke2_active_server }}"
  delegate_to: all

