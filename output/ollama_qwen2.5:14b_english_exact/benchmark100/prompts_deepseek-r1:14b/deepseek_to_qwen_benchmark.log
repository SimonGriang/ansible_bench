unt': 632, 'prompt_eval_duration': 291362829, 'eval_count': 435, 'eval_duration': 9010878620, 'model_name': 'qwen2.5:14b'} id='run--aeedbc58-b533-4953-8181-1b27dfa9238a-0' usage_metadata={'input_tokens': 632, 'output_tokens': 435, 'total_tokens': 1067}
