---
- name: Import assertion file
  import_tasks: assert.yml
  remote_src: yes
  args:
    file: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install system requirements
  package:
    name: bash
    state: present

- name: Install OpenJDK Java
  when: java_vendor == "openjdk"
  package:
    name: "{{ lookup('ansible_distribution', default='unknown') == 'Alpine' ? 'openjdk8' : 'openjdk-8-jdk' }}"
    state: present

- name: Install Oracle Java RPM from local
  when: java_source == "local" and java_format == "rpm"
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ lookup('ansible.builtin.fileglob', 'java-oracle*.rpm') }}"

- name: Install Oracle Java DEB from local
  when: java_source == "local" and java_format == "deb"
  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ lookup('ansible.builtin.fileglob', 'java-oracle*.deb') }}"

- name: Install Oracle Java RPM from repository
  when: java_source == "repository" and java_format == "rpm"
  package:
    name: "{{ lookup('ansible_distribution', default='unknown') == 'Alpine' ? 'java-runtime' : 'java-1.8-oracle' }}"
    state: present

- name: Configure Oracle Java targz installation
  when: java_format == "targz" and java_vendor == "oracle"
  block:
    - name: Extract Oracle Java tarball
      unarchive:
        src: "{{ item }}"
        dest: /usr/local
        remote_src: yes
      with_items: "{{ lookup('ansible.builtin.fileglob', 'java-oracle*.tar.gz') }}"
    - name: Set Oracle Java environment
      lineinfile:
        path: /etc/profile.d/java_home.sh
        line: "export JAVA_HOME=/usr/local/jdk1.8.0_{{ item.java_version.replace('_', '') }}"
      with_items:
        - "{{ {'java_version': 'item.java_version' | regex_replace('_(\\d+)$', '\\1') | int } }}"
      when: ansible_os_family != 'Alpine'

- name: Install Oracle Java JCE policy
  when: java_jce and java_version == 8 and java_vendor == "oracle"
  block:
    - name: Extract JCE tarball
      unarchive:
        src: "{{ item }}"
        dest: /usr/local/jdk1.8.0_{{ java_version }}/jre/lib/security
        remote_src: yes
      with_items: "{{ lookup('ansible.builtin.fileglob', 'jce_policy*.tar.gz') }}"
    - name: Set JCE permissions
      file:
        path: /usr/local/jdk1.8.0_{{ java_version }}/jre/lib/security
        mode: 0755

- name: Set Java alternative
  when: java_format == "targz" and ansible_distribution != 'Alpine'
  command: alternatives --install /usr/bin/java java /usr/local/jdk1.8.0_{{ java_version }}/bin/java 1
  args:
    creates: /usr/bin/java

- name: Find Java home directory
  command: readlink -f /usr/bin/java
  register: java_home
  changed_when: false

- name: Set JAVA_HOME in environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home.stdout }}"
    create: yes

