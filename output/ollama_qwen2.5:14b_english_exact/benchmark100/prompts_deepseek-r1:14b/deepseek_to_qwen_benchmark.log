---
- name: Create local SSH key directory for user
  file:
    path: "/home/{{ username }}/.ssh"
    state: directory
    owner: "{{ username }}"
    group: "{{ username }}"
    mode: '0750'

- name: Manage user account
  user:
    name: "{{ username }}"
    state: present
    comment: "{{ comment }}"
    home: "{{ home_directory }}"
    shell: "{{ shell }}"
    uid: "{{ uid }}"
    gid: "{{ gid }}"
    groups: "{{ groups }}"
    system: "{{ system }}"
    create_home: "{{ create_home }}"
    remove: "{{ remove }}"

- name: Set sudo options for user
  lineinfile:
    path: "/etc/sudoers.d/{{ username }}"
    line: "{{ username }} ALL=(ALL) NOPASSWD:ALL"
    create: yes
    mode: '0440'
    owner: root
    group: root

- name: Generate private SSH key for user
  command: ssh-keygen -f "/home/{{ username }}/.ssh/id_rsa" -N '' -q
  args:
    creates: "/home/{{ username }}/.ssh/id_rsa"

- name: Generate public SSH key for user
  command: ssh-keygen -y -f "/home/{{ username }}/.ssh/id_rsa" > "/home/{{ username }}/.ssh/id_rsa.pub"
  args:
    creates: "/home/{{ username }}/.ssh/id_rsa.pub"

- name: Convert SSH key to ppk format for user
  command: ssh-keygen -p -f "/home/{{ username }}/.ssh/id_rsa" -m pkcs8 -t rsa -C "{{ email }}"
  args:
    creates: "/home/{{ username }}/.ssh/id_rsa.ppk"

- name: Get or set the home directory for user
  command: getent passwd {{ username }} | cut -d: -f6
  register: home_dir_result
  changed_when: false
  when: home_directory == ''
- name: Set home directory
  set_fact:
    home_directory: "{{ home_dir_result.stdout }}"
  when: home_directory == ''

- name: Create .ssh directory for user
  file:
    path: "{{ home_directory }}/.ssh"
    state: directory
    owner: "{{ username }}"
    group: "{{ username }}"
    mode: '0700'

- name: Deploy authorized keys for user
  copy:
    src: "{{ item }}"
    dest: "{{ home_directory }}/.ssh/authorized_keys"
    owner: "{{ username }}"
    group: "{{ username }}"
    mode: '0600'
  with_items: "{{ authorized_keys }}"
  notify: Restart ssh service

- name: Remove unauthorized keys for user
  file:
    path: "{{ home_directory }}/.ssh/authorized_keys"
    state: touch
  notify: Restart ssh service
  register: remove_unauthorized_keys
  changed_when: remove_unauthorized_keys.changed

- name: Copy generated private SSH key for user
  copy:
    src: "/home/{{ username }}/.ssh/id_rsa"
    dest: "{{ home_directory }}/.ssh/id_rsa"
    owner: "{{ username }}"
    group: "{{ username }}"
    mode: '0600'

- name: Check users password valid time for user
  command: chage -l {{ username }} | grep "Password expires"
  register: password_valid_time_result

- name: Set users password valid time for user
  command: chage -M {{ max_days }} {{ username }}
  when: max_days is defined

- name: Place private key file for user
  file:
    path: "{{ home_directory }}/.ssh/id_rsa"
    state: file
    owner: "{{ username }}"
    group: "{{ username }}"
    mode: '0600'

