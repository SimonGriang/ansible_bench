---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0750'
    owner: root
    group: root

- name: Set server taints
  when: node_type == 'server'
  lineinfile:
    path: /etc/rke2/config.yaml
    regexp: '^#?\\s*taints:\\s*$'
    line: '  taints:\n    - key: node-role.kubernetes.io/control-plane\n      value: "true"\n      effect: NoSchedule'
    insertafter: '^#?\\s*taints:\\s*$'

- name: Set agent taints
  when: node_type == 'agent'
  lineinfile:
    path: /etc/rke2/config.yaml
    regexp: '^#?\\s*taints:\\s*$'
    line: '  taints:\n    - key: node.kubernetes.io/role\n      value: agent\n      effect: PreferNoSchedule'
    insertafter: '^#?\\s*taints:\\s*$'

- name: Copy RKE2 configuration file
  copy:
    src: templates/rke2-config.yaml.j2
    dest: /etc/rke2/config.yaml
    mode: '0640'
    owner: root
    group: root
  notify: restart rke2

- name: Copy Kubelet configuration file
  when: kubelet_config is defined
  copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rke2/kubelet-config.yaml
    mode: '0640'
    owner: root
    group: root
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  when: containerd_registry_config is defined
  copy:
    src: "{{ containerd_registry_config }}"
    dest: /etc/rke2/registries.yaml
    mode: '0640'
    owner: root
    group: root
  notify: restart rke2

- name: Start RKE2 service on other nodes
  service:
    name: rke2
    state: started
    enabled: yes
    daemon_reload: yes
  notify: restart rke2
  when: node_type != 'this-node-type'

- name: Mask other RKE2 services on nodes
  file:
    path: "{{ item.path }}"
    state: linked
    force: yes
  loop:
    - "{{ 'masked' if node_type == 'server' else 'masked-agent' }}"
  notify: restart rke2

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    path: "http://{{ item }}:8080/healthz"
    timeout: 600
    state: started
    delay: 5
    sleep: 5
  loop: "{{ groups['all'] }}"
  when: cni is not defined

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    path: "http://{{ item }}:8080/healthz"
    timeout: 600
    state: started
    delay: 5
    sleep: 5
  loop: "{{ groups['all'] }}"
  when: cni is defined

