---
- import_tasks: assert.yml
  name: Import assertion tasks from assert.yml for validation
  run_once: true
  remote_user: localhost

- name: Install all necessary packages required for Vault installation
  yum:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include tasks from a file named after the installation method specified
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item }}"
    create: yes
  with_items: "{{ vault_environment_settings }}"
  notify: Restart vault

- name: Include security hardening tasks
  import_tasks: hardening.yml

- name: Start and enable vault (for OSS type)
  systemd:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable vault (for non-OSS type)
  systemd:
    name: vault
    enabled: yes
  when: vault_type is not defined or vault_type != "oss"

