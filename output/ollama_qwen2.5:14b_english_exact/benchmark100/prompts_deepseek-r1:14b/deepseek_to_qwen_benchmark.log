---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install php
  package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  shell: php -i | grep 'Configuration File' | awk -F':' '{print $2}' | tr -d ' '
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  copy:
    src: php.ini.j2
    dest: "{{ php_ini_location or php_found_ini_location.stdout }}"
    mode: '0644'
  notify: Restart httpd

