    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  lineinfile:
    path: /etc/pip.conf
    regexp: '^index-url\\s*='
    line: 'index-url = {{ python_pip_proxy|default("false") }}'
    create: yes
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  lineinfile:
    path: /etc/pip.conf
    regexp: '^trusted-host\\s*='
    line: 'trusted-host = {{ python_pip_trusted_host|default("false") }}'
    create: yes
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: latest
  when: ansible_distribution != "bookworm" and ansible_distribution != "noble" and ansible_os_family != "Alpine"

- name: Install Python modules
  pip:
    name: "{{ item }}"
    state: present
    version: "{{ python_pip_modules[item] }}"
  loop: "{{ python_pip_modules.keys()|list }}"
  when: ansible_distribution != "bookworm" and ansible_distribution != "noble" and ansible_os_family != "Alpine"

