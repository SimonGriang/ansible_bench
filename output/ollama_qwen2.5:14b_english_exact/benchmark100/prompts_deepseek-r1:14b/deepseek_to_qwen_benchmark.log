---
- ansible.builtin.import_tasks: assert.yml

- name: Install cron package
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  ansible.builtin.lineinfile:
    path: /etc/cron.d/cron
    line: "SHELL=/bin/bash"
    create: true
    regexp: '^SHELL='
    state: present
    owner: root
    group: root
    mode: '0644'

- name: Configure cron path environment
  ansible.builtin.lineinfile:
    path: /etc/cron.d/cron
    line: "PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
    create: true
    regexp: '^PATH='
    state: present
    owner: root
    group: root
    mode: '0644'

- name: Configure cron mailto settings
  ansible.builtin.lineinfile:
    path: /etc/cron.d/cron
    line: "MAILTO={{ cron_mailto }}"
    create: true
    regexp: '^MAILTO='
    state: present
    owner: root
    group: root
    mode: '0644'

- name: Start and enable cron service
  ansible.builtin.service:
    name: cron
    state: started
    enabled: true
  when: cron_service is defined

- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    special_time: "{{ item.special_time }}"
  with_items: "{{ cron_jobs }}"

