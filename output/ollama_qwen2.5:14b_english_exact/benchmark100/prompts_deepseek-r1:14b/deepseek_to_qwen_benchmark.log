---
- name: Import assertion file
  import_tasks: assert.yml
  remote_addr: localhost

- name: Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "SHELL=/bin/bash"
    create: yes
  notify: restart cron service

- name: Configure cron path
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
    create: yes
  notify: restart cron service

- name: Configure cron mailto
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "MAILTO={{ mailto_address }}"
    create: yes
  notify: restart cron service

- name: Start and enable cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service is not ""

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
  with_items: "{{ cron_jobs }}"

- name: Ensure cron config file exists
  file:
    path: /etc/cron.d/cron_config
    state: touch

  handlers:
  - name: restart cron service
    service:
      name: cron
      state: restarted

