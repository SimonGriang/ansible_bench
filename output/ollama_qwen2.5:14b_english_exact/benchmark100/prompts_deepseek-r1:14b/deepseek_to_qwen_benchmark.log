---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_version }}.yml"
  when: ansible_distribution in ['Debian', 'Ubuntu', 'CentOS', 'Fedora', 'RedHat']

- name: Gather architecture specific variables
  include_vars:
    file: "{{ ansible_architecture }}.yml"

- name: Set OS specific variables (I)
  set_fact:
    java_jdk_version: "{{ java_jdk_version | default('8') }}"
    java_jdk_repo_key: "{{ java_jdk_repo_key | default('') }}"
    java_jdk_repo_url: "{{ java_jdk_repo_url | default('') }}"
    java_jdk_repo_dist: "{{ java_jdk_repo_dist | default('') }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_jdk_install_path: "/usr/lib/jvm/java-{{ java_jdk_version }}-{{ java_jdk_vendor }}"
    java_jdk_package_name: "openjdk-{{ java_jdk_version }}-jdk"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_jdk_install_path }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt:
        state: absent
        purge: yes
        repository: "{{ item }}"
      with_items:
        - deb http://dl.google.com/linux/chrome/deb/ stable main
        - deb http://archive.canonical.com/ubuntu natty partner
    - name: Install extra apt tools
      apt:
        name: apt-transport-https
        state: present
    - name: Add key repositories
      apt_key:
        url: "{{ item.url }}"
        state: present
      with_items:
        - { url: "https://packages.cloud.google.com/apt/doc/apt-key.gpg" }
    - name: Add required repositories
      apt_repository:
        repo: "{{ item.repo }}"
        state: present
        filename: "{{ item.filename | default('') }}"
      with_items:
        - { repo: "deb http://deb.debian.org/debian buster-backports main" }
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: "{{ item.key }}"
        state: present
      with_items:
        - { key: "RPM-GPG-KEY-redhat-release" }
    - name: Add required repositories
      yum_repository:
        name: "{{ item.name }}"
        baseurl: "{{ item.baseurl }}"
        enabled: "{{ item.enabled | default('1') }}"
        gpgcheck: "{{ item.gpgcheck | default('1') }}"
        gpgkey: "{{ item.gpgkey | default('file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release') }}"
