---
- name: gather_facts | Lookup bootstrap facts
  slurp:
    src: /etc/os-release
  register: os_release_file

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    distribution: "{{ lookup('ansible.builtin.guess_collection_layout', os_release_file.content | b64decode | bsd_glob('NAME=*_VERSION=*_ID=*_ID_LIKE=*')) }}"
    major_version: "{{ lookup('ansible.builtin.guess_collection_layout', os_release_file.content | b64decode | bsd_glob('VERSION_ID=*_')) | regex_replace('^[^0-9]*([0-9]+)\\..*$', '\\1') }}"

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    os_family: "{% if distribution == 'CentOS' or distribution == 'RedHat' %}rhel{% elif distribution == 'Debian' or distribution == 'Ubuntu' %}debian{% else %}unknown{% endif %}"

