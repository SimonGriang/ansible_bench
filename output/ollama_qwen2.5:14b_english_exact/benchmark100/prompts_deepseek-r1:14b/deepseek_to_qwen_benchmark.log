---
- import_tasks: assert.yml

- name: Install git
  package:
    name: "{{ item }}"
    state: present
  loop:
    - git

- name: Check if user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ git_user }}"
  register: user_exists
  changed_when: false
  failed_when: false

- name: Create git config directory
  ansible.builtin.file:
    path: "{{ git_config_dir }}"
    state: directory
    mode: '0700'
  when: user_exists is defined

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "{{ git_config_path }}"
    mode: '0600'
  when: user_exists is defined

- name: Create repository destination
  ansible.builtin.file:
    path: "{{ git_repo_path }}"
    state: directory
    mode: '0700'
  when: user_exists is defined

- name: Clone all repositories
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version }}"
    accept_hostkey: yes
    update: yes
    clone_branch: "{{ item.version }}"
    force: yes
    key_file: "/home/{{ git_user }}/.ssh/id_rsa"
    umask: '0077'
  loop:
    - { repo: "https://github.com/user/repo1.git", dest: "/home/{{ git_user }}/repos/repo1", version: "master" }
    - { repo: "https://github.com/user/repo2.git", dest: "/home/{{ git_user }}/repos/repo2", version: "develop" }
  when: user_exists is defined

