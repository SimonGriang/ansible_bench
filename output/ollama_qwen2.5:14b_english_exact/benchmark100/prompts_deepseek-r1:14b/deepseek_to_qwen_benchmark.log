---
- name: Check if EFI firmware exists on the system
  stat:
    path: /sys/firmware/efi/efivars/

- name: Remove GRUB configuration file on EFI systems
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: ansible_facts['os_type'] == 'EFI'

- name: Install custom user template for GRUB
  copy:
    src: templates/01_users.j2
    dest: /etc/grub.d/01_users
    mode: 'a+rx'
    owner: root
    group: root

- name: Add EFI password protection to GRUB
  lineinfile:
    path: /etc/grub2-efi.cfg
    regexp: '^password_pbkdf2'
    line: 'password_pbkdf2 grubuser_pbkdf2 grubhash_pbkdf2'
    state: present
  when: ansible_facts['os_type'] == 'EFI'

- name: Add MBR password protection to GRUB
  lineinfile:
    path: /etc/grub2.cfg
    regexp: '^password_pbkdf2'
    line: 'password_pbkdf2 grubuser_pbkdf2 grubhash_pbkdf2'
    state: present
  when: ansible_facts['os_type'] != 'EFI'

- name: Add unrestricted access to GRUB password entries
  lineinfile:
    path: /etc/grub2-efi.cfg
    regexp: '^password_pbkdf2'
    line: 'password_pbkdf2 --unrestricted grubuser_pbkdf2 grubhash_pbkdf2'
    state: present
  when: ansible_facts['os_type'] == 'EFI' and ansible_facts['grub_unrestricted'] == True

- name: Add unrestricted access to GRUB password entries for MBR
  lineinfile:
    path: /etc/grub2.cfg
    regexp: '^password_pbkdf2'
    line: 'password_pbkdf2 --unrestricted grubuser_pbkdf2 grubhash_pbkdf2'
    state: present
  when: ansible_facts['os_type'] != 'EFI' and ansible_facts['grub_unrestricted'] == True

