  ansible.builtin.shell: php -i | grep 'Configuration\ File' | awk -F':' '{print $2}' | tr -d ' '
  register: php_found_ini_location
  when: php_ini_location is not defined
  args:
    warn: false
  environment:
    PIPESTATUS: "PIPESTATUS"

- name: Configure php
  ansible.builtin.copy:
    src: php.ini.j2
    dest: "{{ php_ini_location or php_found_ini_location.stdout }}"
    mode: 0644
  notify: Restart httpd

