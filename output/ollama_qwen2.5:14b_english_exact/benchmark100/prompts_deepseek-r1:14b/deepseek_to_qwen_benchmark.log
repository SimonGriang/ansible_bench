---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Manage automatic service management for services installed via apt
  block:
    - name: Disable automatic service management if apt_autostart_state is disabled
      copy:
        dest: /usr/sbin/policy-rc.d
        content: "exit 101\n"
        mode: 0755
      when: apt_autostart_state == "disabled"

    - name: Enable automatic service management if apt_autostart_state is enabled
      file:
        path: /usr/sbin/policy-rc.d
        state: absent
      when: apt_autostart_state == "enabled"
  when: ansible_pkg_mgr == 'apt'

