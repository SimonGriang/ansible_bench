---
- name: Create /etc/openvpn/easy-rsa directory with correct permissions
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize OpenVPN PKI structure
  ansible.builtin.command: /usr/share/easy-rsa/easyrsa init-pki
  register: init_pki_result
  changed_when: "'Already an Easy-RSA client setup at' not in init_pki_result.stdout"

- name: Generate OpenVPN CA certificate
  ansible.builtin.command: /usr/share/easy-rsa/easyrsa build-ca nopass
  environment:
    EASYRSA_BATCH: "yes"
  register: build_ca_result
  changed_when: "'CA is OK' not in build_ca_result.stdout"

- name: Generate Diffie-Hellman parameters
  ansible.builtin.command: /usr/share/easy-rsa/easyrsa gen-dh
  register: gen_dh_result
  changed_when: "'Diffie-Hellman' not in gen_dh_result.stdout"

- name: Generate server certificate
  ansible.builtin.command: /usr/share/easy-rsa/easyrsa build-server-full server nopass
  environment:
    EASYRSA_BATCH: "yes"
  register: build_server_full_result
  changed_when: "'server' not in build_server_full_result.stdout"

- name: Generate client certificate
  ansible.builtin.command: /usr/share/easy-rsa/easyrsa build-client-full client nopass
  environment:
    EASYRSA_BATCH: "yes"
  register: build_client_full_result
  changed_when: "'client' not in build_client_full_result.stdout"

- name: Generate Certificate Revocation List
  ansible.builtin.command: /usr/share/easy-rsa/easyrsa gen-crl
  register: gen_crl_result
  changed_when: "'CRL written' not in gen_crl_result.stdout"

- name: Generate OpenVPN TA key
  ansible.builtin.command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  register: gen_ta_result
  changed_when: "os.path.isfile('/etc/openvpn/easy-rsa/pki/ta.key')"

- name: Copy PKI files to /etc/openvpn/server directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/{{ item }}
    mode: '0640'
  with_items:
    - ca.crt
    - ta.key
    - dh.pem
    - server.crt
    - server.key
  notify: restart openvpn

- name: Copy additional PKI files to /etc/openvpn directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/{{ item }}
    mode: '0640'
  with_items:
    - ca.crt
    - dh.pem
  notify: restart openvpn

- name: Place OpenVPN server configuration file
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: '0640'
    owner: root
    group: root
  notify: restart openvpn


