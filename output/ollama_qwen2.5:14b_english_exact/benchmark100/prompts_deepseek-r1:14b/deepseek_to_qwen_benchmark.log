'done': True, 'done_reason': 'stop', 'total_duration': 12596444671, 'load_duration': 77119888, 'prompt_eval_count': 622, 'prompt_eval_duration': 377727132, 'eval_count': 528, 'eval_duration': 12132403453, 'model_name': 'qwen2.5:14b'} id='run--5a5cc48a-22b4-4fb6-bd04-d42b86615d06-0' usage_metadata={'input_tokens': 622, 'output_tokens': 528, 'total_tokens': 1150}
