uration': 53652071, 'eval_count': 492, 'eval_duration': 12017205455, 'model_name': 'qwen2.5:14b'} id='run--8009e4cf-55dc-4655-a33e-bca71f388037-0' usage_metadata={'input_tokens': 1097, 'output_tokens': 492, 'total_tokens': 1589}
