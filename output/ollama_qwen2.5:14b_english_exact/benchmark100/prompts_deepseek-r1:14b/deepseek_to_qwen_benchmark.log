content='---\n- name: gather_facts | Lookup bootstrap facts\n  ansible.builtin.slurp:\n    path: /etc/os-release\n  register: os_release_content\n  become: false\n\n- name: gather_facts | Set bootstrap facts (I)\n  ansible.builtin.set_fact:\n    distro_name: "{{ os_release_content.content | b64decode | regex_search(\'NAME=\\"?(.*?)\\"?\') }}"\n    distro_major_version: "{{ os_release_content.content | b64decode | regex_search(\'VERSION_ID=\\"?(\\\\d+)\\\\..*\\"?\') }}"\n  become: false\n\n- name: gather_facts | Set bootstrap facts (II)\n  ansible.builtin.set_fact:\n    os_family: "{{ lookup(\'ansible.builtin.dict\', distro_name | lower, {\'rhel\': \'RedHat\', \'centos\': \'RedHat\', \'ubuntu\': \'Debian\', \'debian\': \'Debian\'}) }}"\n  become: false' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-19T09:16:54.669456109Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3976272465, 'load_duration': 91691587, 'prompt_eval_count': 371, 'prompt_eval_duration': 103803179, 'eval_count': 200, 'eval_duration': 3771133462, 'model_name': 'qwen2.5:14b'} id='run--9e4adda9-386f-4495-9a04-0a22f29c33c8-0' usage_metadata={'input_tokens': 371, 'output_tokens': 200, 'total_tokens': 571}
