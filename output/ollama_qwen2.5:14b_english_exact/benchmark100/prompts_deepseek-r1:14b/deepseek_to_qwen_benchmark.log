---
- import_tasks: assert.yml

- name: Install using package
  block:
    - name: Install HashiCorp product using package manager
      apt:
        name: "{{ item.package }}"
        state: present
      loop:
        - package: "hashicorp/<product>"
      when: ansible_os_family == "Debian"
      become: true

    - name: Install HashiCorp product using package manager
      yum:
        name: "{{ item.package }}"
        state: present
      loop:
        - package: "hashicorp/<product>"
      when: ansible_os_family == "RedHat"
      become: true
  when: install_method == "package"

- name: Configure debian
  block:
    - name: Add HashiCorp GPG key
      apt_key:
        url: "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x<key-id>"
        state: present
        validate_certs: true

    - name: Add HashiCorp apt repository
      apt_repository:
        repo: "deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_distribution_release }}-<product>-repo"
        state: present
  when: ansible_os_family == "Debian"

- name: Install hashicorp product using package
  block:
    - name: Install latest HashiCorp product
      apt:
        name: "hashicorp/<product>"
        state: latest
      when: ansible_os_family == "Debian"
      become: true

    - name: Install specific version of HashiCorp product
      apt:
        name: "hashicorp/<product>"
        version: "{{ version }}"
        state: present
      when: ansible_os_family == "Debian" and version is defined
      become: true

    - name: Install latest HashiCorp product
      yum:
        name: "hashicorp/<product>"
        state: latest
      when: ansible_os_family == "RedHat"
      become: true

    - name: Install specific version of HashiCorp product
      yum:
        name: "hashicorp/<product>"
        version: "{{ version }}"
        state: present
      when: ansible_os_family == "RedHat" and version is defined
      become: true
  when: install_method == "package" and not manual_install

- name: Install manually
  block:
    - name: Download HashiCorp product
      get_url:
        url: "https://releases.hashicorp.com/<product>/<version>/<product>_<version>_linux_<arch>.zip"
        dest: "/opt/<product>_<version>.zip"

    - name: Unzip HashiCorp product
      unarchive:
        src: "/opt/<product>_<version>.zip"
        dest: "/opt/<product>"
        remote_src: true

    - name: Set permissions on HashiCorp product
      file:
        path: "/opt/<product>/<product>"
        mode: "u+x,g+x,o+x"
        owner: root
        group: root
        state: file
  when: manual_install

