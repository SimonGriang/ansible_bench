---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install git
  ansible.builtin.package:
    name: git
    state: present

- name: Check if user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ user }}"
    fail_on_error: no

- name: Create git config directory
  ansible.builtin.file:
    path: "{{ user_home }}/.gitconfig"
    state: directory
    mode: 0700
    owner: "{{ user }}"
    group: "{{ user }}"

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "{{ user_home }}/.gitconfig"
    mode: 0600
    owner: "{{ user }}"
    group: "{{ user }}"

- name: Create repository destination
  ansible.builtin.file:
    path: "{{ repo_dest }}"
    state: directory
    mode: 0755
    owner: "{{ user }}"
    group: "{{ user }}"

- name: Clone all repositories
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version }}"
    update: yes
    clone: yes
    force: yes
    accept_hostkey: yes
    ssh_key: "{{ ssh_key }}"
    force_basic_auth: yes
    user: "{{ user }}"
  with_items: "{{ repos }}"
  become: yes
  become_user: "{{ user }}"

