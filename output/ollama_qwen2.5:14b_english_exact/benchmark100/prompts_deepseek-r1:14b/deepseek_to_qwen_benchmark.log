---
- import_tasks: assert.yml

- name: Install git
  package:
    name: "{{ packages }}"
    state: present

- name: Check if user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ user_name }}"
  register: user_check
  changed_when: false

- name: Create git config directory
  ansible.builtin.file:
    path: "{{ user_home }}/.gitconfig.d"
    state: directory
    mode: '0700'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"
  when: user_check is defined

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "{{ user_home }}/.gitconfig.d/user"
    mode: '0600'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"
  when: user_check is defined

- name: Create repository destination
  ansible.builtin.file:
    path: "{{ repo_dest }}"
    state: directory
    mode: '0755'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"
  when: user_check is defined

- name: Clone all repositories
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ repo_dest }}/{{ item.name }}"
    version: "{{ item.version }}"
    update: yes
    clone: yes
    accept_hostkey: yes
    update_on_change_only: no
    force_update: yes
    executable: /usr/bin/git
    recursive: yes
    reference: "{{ user_home }}/.gitconfig.d/user"
    track_submodules: yes
    track_submodules_on_push: yes
    ssh_known_hosts: /etc/ssh/ssh_known_hosts
    ssh_user: "{{ user_name }}"
    ssh_pass: "{{ user_password }}"
    key_file: "{{ user_home }}/.ssh/id_rsa"
    umask: '0022'
  loop: "{{ repositories }}"
  when: user_check is defined

