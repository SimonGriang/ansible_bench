---
- name: Check current docker-compose version
  command: docker-compose --version
  register: docker_compose_version_output

- name: Set fact for docker-compose current version
  set_fact:
    current_docker_compose_version: "{{ docker_compose_version_output.stdout | regex_replace('Docker Compose version ', '') | regex_replace('.$', '') }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: current_docker_compose_version is not defined or current_docker_compose_version != "1.29.2"

- name: Install Docker Compose (if configured)
  block:
    - name: Download docker-compose
      get_url:
        url: "https://github.com/docker/compose/releases/download/1.29.2/docker-compose-$(uname -s)-$(uname -m)"
        dest: /usr/local/bin/docker-compose
    - name: Make docker-compose executable
      file:
        path: /usr/local/bin/docker-compose
        mode: 'u+x'
  when: current_docker_compose_version is not defined or current_docker_compose_version != "1.29.2"

