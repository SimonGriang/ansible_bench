---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_installer_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0700'
    remote_src: yes
  when: airgap is not defined or airgap|bool == false

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0700'
  when: airgap|bool and rke2_installer_mode == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifact_path }}"
    state: directory
    mode: '0700'
  when: airgap|bool and rke2_installer_mode != 'exists'

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ rke2_artifact_url }}"
    dest: "{{ rke2_artifact_path }}/{{ rke2_artifact_file }}"
    mode: '0700'
    checksum: "{{ rke2_artifact_checksum }}"
  register: download_artifacts_result
  until: download_artifacts_result is success
  retries: 3
  delay: 5
  when: airgap|bool
  changed_when: false

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifact_local }}"
    dest: "{{ rke2_artifact_path }}/{{ rke2_artifact_file }}"
    mode: '0640'
  when: airgap|bool and rke2_installer_mode == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item | basename }}"
    mode: '0700'
  with_items: "{{ rke2_additional_tarballs }}"
  when: airgap|bool

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke2_artifact_path }}/{{ rke2_artifact_file }}"
    state: file
    mode: '0640'
  when: airgap|bool and rke2_installer_mode == 'exists'

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke2_install_script_path }}"
    state: file
    mode: '0700'
  when: airgap|bool and rke2_installer_mode == 'exists'

- name: Populate service facts
  ansible.builtin.setup:
    filter: services

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local
  register: fs_stats

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ '/usr/local' if fs_stats.stat.is_block_device and fs_stats.stat.permissions|regex_search('w') else '/opt/rke2' }}"
  when: fs_stats.stat.exists

- name: Check RKE2 version
  command: "{{ rke2_install_script_path }} version --format '{{ .Version }}' "
  register: rke2_version_result
  changed_when: false

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "'{{ rke2_version_result.stdout | version }}' >= '{{ rke2_required_version }}'"
      - "'{{ rke2_version_result.stdout | version }}' | version_compare('{{ rke2_required_version }}', 'ge', true) and rke2_allow_downgrade is defined"
    fail_msg: "RKE2 version is {{ rke2_version_result.stdout | version }} but required version is {{ rke2_required_version }} and downgrade is not allowed"
    success_msg: "RKE2 version is {{ rke2_version_result.stdout | version }} and it's equal or higher than the required version {{ rke2_required_version }}"

- name: Run RKE2 install script
  command: "{{ rke2_install_script_path }} install agent --write-kubeconfig-mode=0644 --no-default-cidr --kubelet-arg='streaming-conn-max-retries=5' --kubelet-arg='max-graceful-termination-seconds=0' --kubelet-arg='eviction-hard=memory.available<{{ rke2_eviction_memory_threshold }}' --kubelet-arg='eviction-minimum-reclaim=memory.available={{ rke2_eviction_reclaim }}' --disable-swap --disable-cloud-provider --disable-local-storage --disable-dns-registration --disable-kube-apiserver --disable-kube-scheduler --disable-kube-controller-manager --disable-kube-proxy --disable-apiserver-proxy-client --disable-apiserver-aggregator --disable-apiserver-admission-plugins --disable-apiserver-authentication --disable-apiserver-audit --disable-apiserver-cache-coordination --disable-apiserver-cache-coordination --disable-apiserver-service-account --disable-apiserver-service-account-issuer --disable-apiserver-service-account-signing-key --disable-apiserver-service-account-signing-key-file --disable-apiserver-service-account-token --disable-apiserver-service-account-token-file --disable-apiserver-service-account-token-key --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-apiserver-service-account-token-key-file --disable-a