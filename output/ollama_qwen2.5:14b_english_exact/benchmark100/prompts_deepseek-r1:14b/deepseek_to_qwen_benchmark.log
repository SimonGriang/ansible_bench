        mode: '0640'
      when: airgap == 'true' and rke2_impl == 'exists'

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item | basename }}"
    mode: '0640'
  loop: "{{ rke2_artifacts_local }}"
  when: airgap == 'true' and rke2_impl == 'copy'

- name: Airgap mode - additional images tarballs
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: '0640'
  loop: "{{ rke2_images_tarballs }}"
  when: airgap == 'true' and rke2_images_tarballs | length > 0

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  ansible.builtin.file:
    path: "{{ item.path }}"
    mode: "{{ item.mode }}"
    state: file
  loop:
    - { path: "/usr/local/bin/rke2-install", mode: '0700' }
    - { path: "{{ rke2_artifact_path }}", mode: '0500' }
  when: airgap == 'true' and rke2_impl == 'exists'

- name: Populate service facts
  ansible.builtin.setup:
    filter: "ansible_service_mgr"

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: "/usr/local"

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: "{{ '/usr/local/bin' if (rke2_local_partition is defined and rke2_local_partition is boolean and rke2_local_partition) or (rke2_local_partition is defined and rke2_local_partition is string and rke2_local_partition == 'true') else '/usr/bin' }}"

- name: Check RKE2 version
  ansible.builtin.shell: "{{ rke2_bin_path }}/rke2 version --format json"
  register: rke2_version
  changed_when: false

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - "'{{ rke2_version.stdout|from_json.stdout.server }}' >= '{{ rke2_version.stdout|from_json.stdout.client }}'"
