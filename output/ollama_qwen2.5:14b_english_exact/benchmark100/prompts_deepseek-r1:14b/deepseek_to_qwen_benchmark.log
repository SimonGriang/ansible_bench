---
- import_tasks: assert.yml

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    name: postfix
    question: postfix/main/destinations
    value: "mail.domain.com, localhost.localdomain, localhost"
    vtype: string

- name: Install postfix
  ansible.builtin.apt:
    name: postfix
    state: present
  when: ansible_os_family == "Debian"

- name: Install postfix-mysql
  ansible.builtin.apt:
    name: postfix-mysql
    state: present
  when: postfix_use_mysql is defined and postfix_use_mysql in ["virtual_mailbox_maps", "virtual_domains"]

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: templates/postfix-transport-maps.j2
    dest: /etc/postfix/transport
  notify: validate_transport_maps
  notify: rebuild_transport_maps

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: templates/postfix-header-checks.j2
    dest: /etc/postfix/header_checks
  notify: validate_header_checks
  notify: reload_postfix

- name: Setting values for main.cf (1/2)
  ansible.builtin.set_fact:
    postfix_maincf_restrictions_recipient: "{{ postfix_maincf_restrictions_recipient }}"
    postfix_maincf_restrictions_sender: "{{ postfix_maincf_restrictions_sender }}"

- name: Setting values for main.cf (2/2)
  ansible.builtin.set_fact:
    postfix_maincf_mynetworks: "{{ postfix_maincf_mynetworks }}"
    postfix_maincf_mydestination: "{{ postfix_maincf_mydestination }}"
    postfix_maincf_relay_domains: "{{ postfix_maincf_relay_domains }}"

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: templates/postfix-main.cf.j2
    dest: /etc/postfix/main.cf
  notify: validate_maincf
  notify: restart_postfix

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: templates/postfix-master.cf.j2
    dest: /etc/postfix/master.cf
  notify: validate_mastercf
  notify: restart_postfix

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ postfix_cert_dir }}"
    state: directory
    mode: '0700'
  notify: reload_postfix

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_cert_path }}"
    dest: /etc/postfix/{{ postfix_cert_dest }}"
    mode: '0600'
  notify: reload_postfix

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_key_path }}"
    dest: /etc/postfix/{{ postfix_key_dest }}"
    mode: '0600'
  notify: reload_postfix

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure aliases
  ansible.builtin.lineinfile:
    path: /etc/postfix/aliases
    line: "{{ item }}"
  loop: "{{ postfix_aliases }}"
  notify: rebuild_aliases
  notify: reload_postfix

- name: Configure sender_access
  ansible.builtin.lineinfile:
    path: /etc/postfix/sender_access
    line: "{{ item }}"
  loop: "{{ postfix_sender_restrictions }}"
  notify: rebuild_sender_access
  notify: reload_postfix

- name: Configure recipient_access
  ansible.builtin.lineinfile:
    path: /etc/postfix/recipient_access
    line: "{{ item }}"
  loop: "{{ postfix_recipient_restrictions }}"
  notify: validate_recipient_access
  notify: rebuild_recipient_access
  notify: reload_postfix

- name: Place sasl_password_map
  ansible.builtin.copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: /etc/postfix/sasl_password
  notify: rebuild_sasl_password_map

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Start and enable postfix
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: yes
  # Ensure the file ends with a newline

