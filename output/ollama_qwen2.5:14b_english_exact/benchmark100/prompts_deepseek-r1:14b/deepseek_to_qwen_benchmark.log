---
- name: Download RKE2 installation script
  ansible.builtin.get_url:
    url: "{{ rke2_installer_url }}"
    dest: "/usr/local/bin/rke2-install"
    mode: '0700'
  when: airgap is not defined or airgap == 'false'

- name: Copy local RKE2 installation script
  ansible.builtin.copy:
    src: "{{ rke2_installer_local }}"
    dest: "/usr/local/bin/rke2-install"
    mode: '0700'
  when: airgap == 'true' and rke2_impl == 'copy'

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifact_path }}"
    mode: '0700'
    state: directory
  when: airgap == 'true' and rke2_impl != 'exists'

- name: Download RKE2 checksum and artifacts
  ansible.builtin.get_url:
    url: "{{ rke2_installer_url }}"
    dest: "{{ rke2_artifact_path }}/rke2.tar.gz"
    mode: '0640'
    checksum: "{{ rke2_checksum }}"
  register: download_result
  when: airgap == 'true' and rke2_impl == 'exists'
  until: download_result is not success
  retries: 5
  delay: 5
  rescue:
    - name: Fallback to local download
      ansible.builtin.copy:
        src: "{{ rke2_installer_local }}"
        dest: "{{ rke2_artifact_path }}/rke2.tar.gz"
        mode: '0640'
      when: airgap == 'true' and rke2_impl == 'exists'

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item | basename }}"
    mode: '0640'
  loop: "{{ rke2_artifacts_local }}"
  when: airgap == 'true' and rke2_impl == 'copy'

- name: Airgap mode - additional images tarballs
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: '0640'
  loop: "{{ rke2_images_tarballs }}"
  when: airgap == 'true' and rke2_images_tarballs | length > 0

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  ansible.builtin.file:
    path: "{{ item.path }}"
    mode: "{{ item.mode }}"
    state: file
  loop:
    - { path: "/usr/local/bin/rke2-install", mode: '0700' }
    - { path: "{{ rke2_artifact_path }}", mode: '0500' }
  when: airgap == 'true' and rke2_impl == 'exists'

- name: Populate service facts
  ansible.builtin.setup:
    filter: "ansible_service_mgr"

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: "/usr/local"

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: "{{ '/usr/local/bin' if (rke2_local_partition is defined and rke2_local_partition is boolean and rke2_local_partition) or (rke2_local_partition is defined and rke2_local_partition is string and rke2_local_partition == 'true') else '/usr/bin' }}"

- name: Check RKE2 version
  ansible.builtin.shell: "{{ rke2_bin_path }}/rke2 version --format json"
  register: rke2_version
  changed_when: false

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - "'{{ rke2_version.stdout|from_json.stdout.server }}' >= '{{ rke2_version.stdout|from_json.stdout.client }}'"
      - "'{{ rke2_version.stdout|from_json.stdout.server }}' >= '{{ rke2_version.stdout|from_json.stdout.cluster }}'"
    msg: "Version downgrade is not allowed unless explicitly permitted. Installed version: {{ rke2_version.stdout|from_json.stdout.server }}. Current version: {{ rke2_version.stdout|from_json.stdout.client }}"

- name: Run RKE2 install script
  ansible.builtin.shell: "{{ rke2_bin_path }}/rke2 install --docker --kubernetes-version={{ kubernetes_version }}"
  environment:
    RKE2_URL: "{{ rke2_url }}"
    RKE2_TOKEN: "{{ rke2_token }}"
    RKE2_KUBECONFIG: "{{ rke2_kubeconfig }}"
  args:
    chdir: "/usr/local/bin"
  when: airgap is not defined or airgap == 'false'

- name: Copy Custom Manifests
  ansible.builtin.template:
    src: "{{ item.src }}"
    dest: "{{ rke2_bin_path }}/rke2/manifests/{{ item.dest | basename }}"
  loop: "{{ custom_manifests }}"

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ rke2_bin_path }}/rke2/agent/pod-manifests/{{ item.dest | basename }}"
    mode: '0640'
  loop: "{{ static_pods }}"

- name: Copy RKE2 environment file
  ansible.builtin.copy:
    src: "{{ rke2_environment_file }}"
    dest: "{{ rke2_bin_path }}/rke2.env"
    mode: '0644'
    owner: root
    group: root
  when: rke2_environment_file is defined

