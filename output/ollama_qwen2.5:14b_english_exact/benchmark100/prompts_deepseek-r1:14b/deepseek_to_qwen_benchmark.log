---
- name: Check if Java certificates exist
  ansible.builtin.file:
    path: "{{ item }}"
    state: file
  loop: "{{ java_certs }}"
  register: java_cert_check

- name: Fail if Java certificates are missing
  ansible.builtin.fail:
    msg: "Java certificate {{ item.item }} is missing."
  loop: "{{ java_cert_check.results }}"
  when: not item.stat.exists

- name: Set keystore directory for Java versions less than 11
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_home }}/lib/security"

- name: Set keystore directory for Java versions 11 or newer
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_home }}/conf/security"
  when: ansible_local.java.version|string() >= "11"

- name: Import SSL certificates into Java keystore
  ansible.builtin.command: >
    "{{ java_home }}/bin/keytool -import -alias {{ item.1.alias }} -file {{ item.0 }} -keystore {{ java_keystore_dir }}/cacerts {{ item.1.properties }}"
  loop: "{{ java_certs | map('extract', ansible.vars, 'path') | list | zip(java_certs | map('extract', ansible.vars, 'properties')) | list }}"
  args:
    creates: "{{ java_keystore_dir }}/cacerts"
  register: import_cert_results
  failed_when: "'Certificate was already in keystore' not in import_cert_results.stderr and import_cert_results.rc != 0

