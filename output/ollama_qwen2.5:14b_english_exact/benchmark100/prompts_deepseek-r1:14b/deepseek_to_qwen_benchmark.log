        dest: /usr/local
        remote_src: yes
      with_items: "{{ lookup('ansible.builtin.fileglob', 'java-oracle*.tar.gz') }}"
    - name: Set Oracle Java environment
      lineinfile:
        path: /etc/profile.d/java_home.sh
        line: "export JAVA_HOME=/usr/local/jdk1.8.0_{{ (item.java_version | regex_replace('_(\\d+)$', '\\1')) | int }}"
      with_items:
        - "{{ {'java_version': 'item.java_version' | regex_replace('_(\\d+)$', '\\1') | int } }}"
      when: ansible_os_family != 'Alpine'

- name: Install Oracle Java JCE policy
  when: java_jce | bool and java_version == 8 and java_vendor == "oracle"
  block:
