---
- import_tasks: assert.yml
  remote_addr: localhost

- name: Install required packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ service_required_packages }}"
  notify: Gather facts

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: "/etc/systemd/system/{{ item.name }}.service"
  loop: "{{ service_list }}"

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: "/etc/init.d/{{ item.name }}"
  loop: "{{ service_list }}"

- name: Manage service
  systemd:
    name: "{{ item.name }}"
    enabled: "{{ item.enabled | default('yes') | lower == 'true' }}"
    state: "{{ item.state | default('started') }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers


