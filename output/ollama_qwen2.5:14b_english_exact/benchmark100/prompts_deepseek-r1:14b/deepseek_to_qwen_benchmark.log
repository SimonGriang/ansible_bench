---
- name: Install unzip package
  package:
    name: unzip
    state: present

- name: Create system group for promtail
  group:
    name: promtail
    system: yes

- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    createhome: no
    groups: adm
    shell: /usr/sbin/nologin

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create config directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  loop:
    - /etc/promtail
    - /etc/promtail/client

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  loop:
    - /var/lib/promtail
    - /var/lib/promtail/client

- name: Check promtail binary existence
  stat:
    path: /usr/local/bin/promtail
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_distribution_url }}"
    dest: /tmp/promtail.tar.gz
    sha256sum: "{{ promtail_distribution_sha256 }}"
  when: not promtail_binary.stat.exists

- name: Propagate local promtail binaries
  copy:
    src: "{{ promtail_distribution_local }}"
    dest: /tmp/promtail.tar.gz
  when: promtail_distribution_local is defined

- name: Download promtail binaries for controller node
  get_url:
    url: "{{ promtail_distribution_controller_url }}"
    dest: /tmp/promtail-controller.tar.gz
    sha256sum: "{{ promtail_distribution_controller_sha256 }}"
  when: inventory_hostname == promtail_controller

- name: Propagate promtail binaries
  copy:
    src: "{{ promtail_distribution_local }}"
    dest: /tmp/promtail-controller.tar.gz
  when: inventory_hostname == promtail_controller and promtail_distribution_local is defined

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail.tar.gz
    dest: /tmp
    remote_src: yes
    creates: /tmp/promtail
    owner: promtail
    group: promtail

- name: Create symlink to latest promtail version
  file:
    src: /tmp/promtail/promtail-linux-amd64
    dest: /usr/local/bin/promtail
    state: link
    mode: '0755'
  notify: restart promtail

- name: Write promtail config file
  template:
    src: promtail-config.j2
    dest: /etc/promtail/promtail-config.yml
    mode: '0644'
    owner: promtail
    group: promtail

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
    owner: root
    group: root
  notify: restart promtail

