content='---\n- name: Create docroot directories for each virtual host\n  file:\n    path: "{{ item.documentroot }}"\n    state: directory\n    mode: 0755\n  when:\n    - httpd_vhosts is defined\n    - item.documentroot is defined\n    - create_docroot|default(true)|bool\n  loop: "{{ httpd_vhosts }}"\n\n- name: Configure virtual host settings\n  template:\n    src: vhost_conf_template\n    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"\n    mode: 0644\n  loop: "{{ httpd_vhosts }}"\n\n- name: Enable virtual hosts on Debian systems\n  become: yes\n  command: a2ensite "{{ item.name }}"\n  args:\n    creates: "{{ item.enabled_conf }}"\n  notify: Test httpd configuration validity\n  when: ansible_os_family == "Debian"\n  loop: "{{ httpd_vhosts }}"\n  register: a2ensite_result\n\n- name: Restart httpd\n  systemd:\n    name: httpd\n    state: restarted\n  when: a2ensite_result.changed\n  notify: Test httpd configuration validity' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-09T09:46:17.835120318Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4570489114, 'load_duration': 89139332, 'prompt_eval_count': 483, 'prompt_eval_duration': 124478604, 'eval_count': 249, 'eval_duration': 4343917359, 'model_name': 'qwen2.5:14b'} id='run--f48d2450-21f3-4836-a843-17da6f64295c-0' usage_metadata={'input_tokens': 483, 'output_tokens': 249, 'total_tokens': 732}
