---
- import_tasks: assert.yml

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'Internet Site'
    vtype: select
  when: ansible_os_family == 'Debian'

- name: Install postfix
  apt:
    name: postfix
    state: present
  when: ansible_os_family == 'Debian'

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: postfix_use_mysql is defined and postfix_use_mysql == True

- name: Configure postfix (transport_maps)
  template:
    src: templates/postfix_transport_maps.cf.j2
    dest: /etc/postfix/transport
  notify: postfix_validate_transport_maps

- name: Configure postfix (header_checks)
  template:
    src: templates/postfix_header_checks.cf.j2
    dest: /etc/postfix/header_checks
  notify: postfix_reload

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_maincf_content: "{{ postfix_maincf_content|default({})|combine({'recipient_restrictions': (['reject_unauth_destination'] if postfix_restrict_reject_unauth_destination else ['permit_sasl_authenticated', 'permit_mynetworks', 'reject']), 'sender_restrictions': (['reject_unauth_pipelining', 'reject_non_fqdn_sender'] if postfix_restrict_sender else ['permit'])}) }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_maincf_content: "{{ postfix_maincf_content|default({})|combine({'mynetworks': ('127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128' if postfix_restrict_mynetworks else '127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128, 192.168.0.0/16'), 'mydestination': ('localhost' if postfix_mydestination_localhost else 'localhost, example.com'), 'relay_domains': ('example.com' if postfix_restrict_relay_domains else 'example.com, another.example.com')}) }}"

- name: Configure postfix (main.cf)
  template:
    src: templates/postfix_main.cf.j2
    dest: /etc/postfix/main.cf
  notify: postfix_validate_maincf

- name: Configure postfix (master.cf)
  template:
    src: templates/postfix_master.cf.j2
    dest: /etc/postfix/master.cf
  notify: postfix_validate_mastercf

- name: Creates cert/key directory
  file:
    path: /etc/postfix/ssl
    state: directory
    mode: '0700'

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_server_cert }}"
    dest: /etc/postfix/ssl/server.crt
  notify: postfix_reload

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_server_key }}"
    dest: /etc/postfix/ssl/server.key
  notify: postfix_reload

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/postfix/aliases
    line: "{{ item }}"
  with_items: "{{ postfix_aliases }}"
  notify: postfix_rebuild_aliases

- name: Configure sender_access
  copy:
    content: "{{ postfix_sender_access }}"
    dest: /etc/postfix/sender_access
  notify: postfix_rebuild_sender_access

- name: Configure recipient_access
  copy:
    content: "{{ postfix_recipient_access }}"
    dest: /etc/postfix/recipient_access
  notify: postfix_validate_recipient_access

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: /etc/postfix/sasl_password
  notify: postfix_rebuild_sasl_password_map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemd:
    name: postfix
    state: started
    enabled: yes

