pt_eval_count': 3388, 'prompt_eval_duration': 1902054453, 'eval_count': 489, 'eval_duration': 10088337295, 'model_name': 'qwen2.5:14b'} id='run--b702993a-1b8f-4210-88c3-3825921a8766-0' usage_metadata={'input_tokens': 3388, 'output_tokens': 489, 'total_tokens': 3877}
