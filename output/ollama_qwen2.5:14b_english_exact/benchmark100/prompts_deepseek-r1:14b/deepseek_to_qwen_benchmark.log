---
- name: Create docroot directories for each virtual host
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - create_docroot|default(true)|bool
  loop: "{{ httpd_vhosts }}"

- name: Configure virtual host settings
  template:
    src: vhost_conf_template
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: 0644
  loop: "{{ httpd_vhosts }}"

- name: Enable virtual hosts on Debian systems
  become: yes
  command: a2ensite "{{ item.name }}"
  args:
    creates: "{{ item.enabled_conf }}"
  notify: Test httpd configuration validity
  when: ansible_os_family == "Debian"
  loop: "{{ httpd_vhosts }}"
  register: a2ensite_result

- name: Restart httpd
  systemd:
    name: httpd
    state: restarted
  when: a2ensite_result.changed
  notify: Test httpd configuration validity

