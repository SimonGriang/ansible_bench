- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.slurp:
    path: /etc/os-release
  register: os_release_file

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    os_distribution: "{{ os_release_file.content | b64decode | from_json.ID_LIKE }}"
    os_major_version: "{{ os_release_file.content | b64decode | from_json.VERSION_ID.split('.')[0] }}"

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    os_family: "{{ lookup('ansible.builtin.mapping', 'os_distribution_to_family', default='unknown', hash_type='dict', os_distribution=os_distribution) }}"

