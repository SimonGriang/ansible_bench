    java_jdk_package_name: "openjdk-{{ java_jdk_version }}-jdk"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_jdk_install_path }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt:
        state: absent
        purge: yes
        repository: "{{ item }}"
      with_items:
        - deb http://dl.google.com/linux/chrome/deb/ stable main
        - deb http://archive.canonical.com/ubuntu natty partner
    - name: Install extra apt tools
      apt:
        name: apt-transport-https
        state: present
    - name: Add key repositories
      apt_key:
        url: "{{ item.url }}"
        state: present
      with_items:
        - url: "https://packages.cloud.google.com/apt/doc/apt-key.gpg"
    - name: Add required repositories
      apt_repository:
        repo: "{{ item.repo }}"
        state: present
        filename: "{{ item.filename | default('') }}"
      with_items:
        - repo: "deb http://deb.debian.org/debian buster-backports main"
  when: ansible_os_family == "Debian"

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: "{{ item.key }}"
        state: present
      with_items:
        - key: "RPM-GPG-KEY-redhat-release"
    - name: Add required repositories
      yum_repository:
        name: "{{ item.name }}"
        baseurl: "{{ item.baseurl }}"
        enabled: "{{ item.enabled | default('1') }}"
        gpgcheck: "{{ item.gpgcheck | default('1') }}"
        gpgkey: "{{ item.gpgkey | default('file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release') }}"
      with_items:
        - name: "rhel-server-rpms"
          baseurl: "http://mirror.centos.org/centos/7/os/x86_64/"
  when: ansible_os_family == "RedHat"

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  with_items:
    - ca-certificates
    - libnss3-tools
    - libasound2
    - libXext
    - libXrender
    - libXrandr
    - libXtst
    - libX11
    - libXcursor
    - libXcomposite
    - libXdamage
    - libasound2
    - libxtst

- name: Install Java, Debian
  apt:
    name: "{{ java_jdk_package_name }}"
    state: present
  when: ansible_os_family == "Debian"

- name: Install Java, RedHat
  yum:
    name: "{{ java_jdk_package_name }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Export environment variables
  template:
    src: java_env.conf.j2
    dest: /etc/profile.d/java_env.sh

- name: Source environment variables
  block:
    - name: Append to bashrc
      lineinfile:
        path: /home/{{ ansible_user }}/bashrc
        line: source /etc/profile.d/java_env.sh
        create: yes
    - name: Append to profile
      lineinfile:
        path: /etc/profile
        line: source /etc/profile.d/java_env.sh
        create: yes

- name: Correct java version selected for Java < 11
  command: alternatives --set java /usr/lib/jvm/java-8-openjdk-amd64/jre/bin/java
  when: java_jdk_version|int < 11

- name: Correct java version selected for Java >= 11
  command: alternatives --set java /usr/lib/jvm/java-{{ java_jdk_version }}-openjdk-amd64/bin/java
  when: java_jdk_version|int >= 11


