---
- name: Populate services facts
  ansible.builtin.service_facts:
    gather_subset:
      - enabled
      - running

- name: Set the Active Server variable
  ansible.builtin.set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  delegate_facts: true
  when: "'rke2-server' in ansible_facts.services.services | json_query('[].name')"
  loop: "{{ groups['rke2_cluster'] }}"

