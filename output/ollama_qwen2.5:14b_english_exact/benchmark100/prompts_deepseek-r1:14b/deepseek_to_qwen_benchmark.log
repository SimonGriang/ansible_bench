---
- import_tasks: assert.yml
  apply: {when: '"localhost" in groups.all_hosts'}

- name: Install cron package
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  lineinfile:
    path: /etc/cron.d/cron_config
    line: SHELL=/bin/bash
    create: yes
    regexp: ^SHELL=
    insertafter: EOF

- name: Configure cron path environment
  lineinfile:
    path: /etc/cron.d/cron_config
    line: PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    create: yes
    regexp: ^PATH=
    insertafter: EOF

- name: Configure cron mailto settings
  lineinfile:
    path: /etc/cron.d/cron_config
    line: MAILTO={{ cron_mailto }}
    create: yes
    regexp: ^MAILTO=
    insertafter: EOF

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    state: present
  with_items: "{{ cron_jobs }}"

