    src: /etc/ssl/private/myprivatekey.pem
  register: private_key_content
  tags:
    - keycontent

- name: Read certificate content
  slurp:
    src: /etc/ssl/certs/mycert.crt
  register: cert_content
  tags:
    - certcontent

- name: Create a combined private key and certificate file
  copy:
    content: "{{ private_key_content.content | b64decode + cert_content.content | b64decode }}"
    dest: /etc/ssl/private/mycombined.pem
    mode: '0640'
    owner: 'root'
    group: 'root'
  tags:
    - combinedfile 50%|█████     | 50/100 [51:23<45:08, 54.16s/it]

