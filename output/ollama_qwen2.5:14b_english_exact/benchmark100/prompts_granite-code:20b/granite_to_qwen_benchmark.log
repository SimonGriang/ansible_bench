---
- name: Configure apk
  include_tasks: assert.yml

- name: Configure apk
  ansible.builtin.shell: apk update

- name: Configure apk
  ansible.builtin.shell: apk upgrade --available

- name: Configure apt
  ansible.builtin.apt:
    name: "{{ item }}"
    state: pin
    version: "=={{ version }}"
  loop: "{{ pinned_packages }}"
  vars:
    pinned_packages:
      - package1
      - package2
    version: "1.0.0"

- name: Configure apt
  ansible.builtin.apt:
    update_cache: yes

- name: Configure apt
  ansible.builtin.apt:
    autoremove: yes
    autoclean: yes

- name: Update all software (dnf)
  ansible.builtin.yum:
    name: "*"
    state: latest

- name: Update all software (pacman)
  ansible.builtin.shell: pacman -Syu --noconfirm

- name: Configure yum
  ansible.builtin.yum:
    name: "*"
    state: latest
  when: ansible_distribution_major_version == "6"

- name: Configure yum
  ansible.builtin.yum:
    name: "*"
    state: latest
  when: ansible_distribution_major_version != "6"

- name: Configure yum
  ansible.builtin.yum:
    name: yum-utils
    state: present

- name: Update all software (zypper)
  ansible.builtin.zypper:
    name: "*"
    state: update

