---
- name: Cordon and Drain the node {{ rke2_node_name }}
  k8s:
    kubeconfig: /etc/rancher/rke2/rke2.yaml
    api_version: "coordinate/v1"
    kind: "Node"
    namespace: ""
    name: "{{ rke2_node_name }}"
    state: present
    force: yes
    json: '{"spec": {"unschedulable": true}}'
  when: rke2_drain_node_during_upgrade|default(true)

- name: Restart RKE2 service on {{ rke2_node_name }}
  systemd:
    name: rke2-server
    state: restarted
    enabled: yes

- name: Wait for all nodes to be ready again
  k8s_info:
    kubeconfig: /etc/rancher/rke2/rke2.yaml
    api_version: "coordinate/v1"
    kind: "Node"
  register: nodes_status
  until: nodes_status.is_ready
  retries: 30
  delay: 10

- name: Uncordon the node {{ rke2_node_name }}
  k8s:
    kubeconfig: /etc/rancher/rke2/rke2.yaml
    api_version: "coordinate/v1"
    kind: "Node"
    namespace: ""
    name: "{{ rke2_node_name }}"
    state: present
    force: yes
    json: '{"spec": {"unschedulable": false}}'
  when: rke2_drain_node_during_upgrade|default(true)

- name: Wait for all pods to be ready again
  k8s_info:
    kubeconfig: /etc/rancher/rke2/rke2.yaml
    api_version: "core/v1"
    kind: "Pod"
    label_selectors: "rke2.io/managed=true"
  register: pods_status
  until: pods_status.is_ready
  retries: 60
  delay: 10
  when: rke2_wait_for_all_pods_to_be_ready|default(true)

- name: Wait for all pods to pass readiness checks
  k8s_info:
    kubeconfig: /etc/rancher/rke2/rke2.yaml
    api_version: "core/v1"
    kind: "Pod"
    label_selectors: "rke2.io/managed=true"
  register: pod_readiness
  until: pod_readiness.is_ready
  retries: 120
  delay: 5
  when: rke2_wait_for_all_pods_to_be_healthy|default(true)

