---
- name: Create ssl key
  openssl_privatekey:
    path: /etc/ssl/private/mykey.key
    cipher: AES-256-CBC
    mode: 0600
    force: yes

- name: Create ssl csr
  openssl_csr:
    path: /etc/ssl/csr/mycsr.csr
    privatekey_path: /etc/ssl/private/mykey.key
    country_name: "US"
    state_or_province_name: "California"
    locality_name: "San Francisco"
    organization_name: "My Company"
    common_name: "mydomain.com"
    email_address: "admin@example.com"
    force: yes

- name: Create ssl certificates
  openssl_certificate:
    path: /etc/ssl/certs/mycert.crt
    provider: selfsigned
    privatekey_path: /etc/ssl/private/mykey.key
    csr_path: /etc/ssl/csr/mycsr.csr
    days: 365
    force: yes

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: /etc/ssl/pkcs12/mypkcs12.p12
    export_pass: "MySecretPassword"
    certificate: /etc/ssl/certs/mycert.crt
    privatekey: /etc/ssl/private/mykey.key
    force: yes

- name: Read private key
  openssl_privatekey_info:
    path: /etc/ssl/private/mykey.key

- name: Read certificate
  openssl_certificate_info:
    path: /etc/ssl/certs/mycert.crt

- name: Create combined private_key and certificate file
  copy:
    content: "-----BEGIN PRIVATE KEY-----\n{{ lookup('file', '/etc/ssl/private/mykey.key') }}\n-----END PRIVATE KEY-----\n-----BEGIN CERTIFICATE-----\n{{ lookup('file', '/etc/ssl/certs/mycert.crt') }}\n-----END CERTIFICATE-----\n"
    dest: /etc/ssl/combined/mycombined.pem
    mode: 0600

