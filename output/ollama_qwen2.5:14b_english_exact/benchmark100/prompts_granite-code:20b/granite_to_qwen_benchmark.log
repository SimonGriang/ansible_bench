---
- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ users_ssh_key_directory }}"
    state: directory
    mode: 0750

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    uid: "{{ user.uid }}"
    gid: "{{ user.gid }}"
    groups: "{{ user.groups }}"
    home: "{{ user.home }}"
    shell: "{{ user.shell }}"
    create_home: yes
    system: "{{ user.system | default('no') }}"
    append: no
    password: "{{ user.password | default('!') }}"
    expires: "{{ user.expires | default('') }}"
    state: present

- name: Set sudo options for {{ user.name }}
  template:
    src: sudoers.d.j2
    dest: /etc/sudoers.d/{{ user.name }}
    mode: 0440
  when: sudo_options is defined

- name: Remove sudo options for {{ user.name }}
  file:
    path: /etc/sudoers.d/{{ user.name }}
    state: absent
  when: sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  shell: "{{ ssh_keygen_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}.pem"
  register: ssh_keygen

- name: Generate public ssh key for {{ user.name }}
  shell: "{{ ssh_keygen_pubkey_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}.pub"
  register: ssh_keygen_pubkey

- name: Convert ssh key to ppk for {{ user.name }}
  shell: "{{ ssh_keygen_pubkey_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}.ppk"
  register: ssh_keygen_ppk

- name: Get or set the home directory for {{ user.name }}
  shell: getent passwd {{ user.name }}
  register: getent_result
  changed_when: false
  failed_when: false
  delegate_to: localhost
  changed_when: getent_result.stdout is changed
  failed_when: getent_result.rc != 0

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user.home }}/.ssh"
    state: directory
    mode: 0700

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
  with_items: "{{ authorized_keys }}"
  when: authorized_keys is defined

- name: Remove unauthorized keys for {{ user.name }}
  file:
    path: "{{ user.home }}/.ssh/authorized_keys"
    state: touch
    mode: 0600
  notify: remove_unauthorized_keys

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}.pem"
    dest: "{{ user.home }}/.ssh/id_rsa"
    mode: 0600

- name: Check users password valid time for {{ user.name }}
  shell: chage -l {{ user.name }} | awk '/Password expires/ {print $4}'
  register: chage_output
  changed_when: false
  failed_when: false

- name: Set users password valid time for {{ user.name }}
  shell: chage -M {{ password_valid_days }} {{ user.name }}
  when: password_valid_days is defined

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ private_key_file }}"
    dest: "{{ user.home }}/.ssh/id_rsa"
    mode: 0600

