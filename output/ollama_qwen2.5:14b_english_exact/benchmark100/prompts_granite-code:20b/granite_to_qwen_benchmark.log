- name: Ensure /etc/openvpn/easy-rsa exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory

- name: Easyrsa init-pki
  command: /usr/share/easy-rsa/easyrsa init-pki

- name: Easyrsa build-ca
  command: /usr/share/easy-rsa/easyrsa build-ca

- name: Easyrsa gen-dh
  command: /usr/share/easy-rsa/easyrsa gen-dh

- name: Easyrsa build-server-full server nopass
  command: /usr/share/easy-rsa/easyrsa build-server-full server nopass

- name: Easyrsa build-client-full client nopass
  command: /usr/share/easy-rsa/easyrsa build-client-full client nopass

