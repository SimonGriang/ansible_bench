---
- import_tasks: assert.yml

- name: install logrotate
  package:
    name: logrotate
    state: present

- name: configure logrotate
  template:
    src: logrotate.conf.j2
    dest: /etc/logrotate.conf

- name: generate logrotate.d files
  template:
    src: logrotate.d.j2
    dest: /etc/logrotate.d/{{ item.name }}
  with_items: "{{ logrotate_configs }}"
  notify: start logrotate

- name: remove logrotate.d files
  file:
    path: /etc/logrotate.d/{{ item.name }}
    state: absent
  with_items: "{{ logrotate_configs_to_remove }}"

- name: start logrotate
  service:
    name: logrotate
    state: started
    enabled: yes

