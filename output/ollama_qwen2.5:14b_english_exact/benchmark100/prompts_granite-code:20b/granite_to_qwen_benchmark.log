content="---\n- name: Remove EXTERNALLY-MANAGED file if we're on Debian12\n  file:\n    path: /usr/share/python-hosts/EXTERNALLY-MANAGED\n    state: absent\n  when:\n    - ansible_facts['os_family'] == 'Debian'\n    - ansible_distribution_major_version == '12'\n    - ansible_local.python3.version == '3.11'\n\n- name: debian12 | Get python3 version installed\n  shell: python3 -V\n  register: python_version\n  when: ansible_facts['os_family'] == 'Debian' and ansible_distribution_major_version == '12'\n\n- name: debian12 | Remove EXTERNALLY-MANAGED\n  file:\n    path: /usr/share/python-hosts/EXTERNALLY-MANAGED\n    state: absent\n  when:\n    - ansible_facts['os_family'] == 'Debian'\n    - ansible_distribution_major_version == '12'\n    - python_version.stdout.find('3.11') != -1" additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-22T06:09:27.98959383Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3460792197, 'load_duration': 95641348, 'prompt_eval_count': 438, 'prompt_eval_duration': 99595258, 'eval_count': 221, 'eval_duration': 3255945021, 'model_name': 'qwen2.5:14b'} id='run--e51faf23-2662-4997-9cf3-2b6b0e4013df-0' usage_metadata={'input_tokens': 438, 'output_tokens': 221, 'total_tokens': 659}
