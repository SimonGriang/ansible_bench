---
- name: Install required software
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"

- name: Loop over users_groups
  include_tasks:
    file: group.yml
    apply:
      when: users_groups is defined
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item.name }}"

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "@includedir /etc/sudoers.d"
    regexp: "^(@|#)includedir /etc/sudoers.d"
    validate: 'visudo -cf %s'
    state: present
  when: users_sudo_includedir

- name: Loop over users
  include_tasks:
    file: user.yml
    apply:
      when: users is defined
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: "0644"
  when: users_cron_allow

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow

