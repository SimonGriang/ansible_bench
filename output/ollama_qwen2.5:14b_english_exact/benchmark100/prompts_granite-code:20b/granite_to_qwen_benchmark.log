---
- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}/.gitconfig.d"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0750'

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0644'
  vars:
    user_email: "{{ git_user_email | bool }}"
    user_name: "{{ git_user_name | bool }}"

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0750'

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    version: "{{ item.version }}"
    dest: "{{ git_repository_destination }}"
    update: yes
    clone: yes
    accept_hostkey: yes
  loop: "{{ git_repositories }}"
  become_user: "{{ git_username }}"

