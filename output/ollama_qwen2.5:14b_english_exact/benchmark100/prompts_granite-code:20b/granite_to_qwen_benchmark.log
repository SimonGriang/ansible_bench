---
- name: Create the RKE2 config dir
  file:
    path: /etc/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  when: inventory_hostname in groups['servers']
  k8s:
    api_version: "scheduling.k8s.io/v1"
    kind: "Node"
    namespace: ""
    name: "{{ inventory_hostname }}"
    state: present
    value:
      taints:
        - effect: NoSchedule
          key: node-role.kubernetes.io/control-plane
          value: "true"

- name: Set agent taints
  when: inventory_hostname in groups['agents']
  k8s:
    api_version: "scheduling.k8s.io/v1"
    kind: "Node"
    namespace: ""
    name: "{{ inventory_hostname }}"
    state: present
    value:
      taints:
        - effect: NoSchedule
          key: node-role.kubernetes.io/worker
          value: "true"

- name: Copy RKE2 config
  copy:
    src: "{{ item }}"
    dest: /etc/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  loop: "{{ rke2_config_files }}"

- name: Copy kubelet config
  when: kubelet_config_file is defined
  copy:
    src: "{{ kubelet_config_file }}"
    dest: /etc/systemd/system/kubelet.service.d/10-kubeadm.conf
    owner: root
    group: root
    mode: '0644'

- name: Copy Containerd Registry Configuration file
  when: custom_registry_used
  copy:
    src: "{{ containerd_registry_config_file }}"
    dest: /etc/rke2/registries.yaml
    owner: root
    group: root
    mode: '0644'

- name: Start RKE2 service on the rest of the nodes
  when: inventory_hostname not in groups['control-plane']
  service:
    name: rke2-agent
    state: started
    enabled: yes

- name: Mask other RKE2 service on the rest of the nodes
  when: inventory_hostname not in groups['control-plane']
  systemd:
    name: rke2-server
    state: masked

- name: Wait for remaining nodes to be ready - no CNI
  when: cni_used == false
  wait_for:
    path: /var/lib/rancher/rke2/agent/kubelet-pods.json
    search_string: "Ready=True"
    sleep: 10
    timeout: 300

- name: Wait for remaining nodes to be ready - with CNI
  when: cni_used == true
  wait_for:
    path: /var/lib/rancher/rke2/agent/kubelet-pods.json
    search_string: "Ready=True"
    sleep: 10
    timeout: 300

