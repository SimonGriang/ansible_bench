- name: Enable redis module stream (RHEL 8)
  ansible.builtin.dnf:
    name: redis
    state: installed
    enablerepo: powerlevel-8-appstream
    installrepoquery: true

- name: Install redis
  ansible.builtin.package:
    name: redis
    state: present

- name: Configure redis
  ansible.builtin.template:
    src: redis.conf.j2
    dest: /etc/redis.conf
    mode: '0644'

- name: Start and enable redis
  ansible.builtin.systemd:
    name: redis
    state: started
    enabled: true


