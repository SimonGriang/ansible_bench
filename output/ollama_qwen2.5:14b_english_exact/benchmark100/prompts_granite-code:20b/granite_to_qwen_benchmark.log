    kind: node
    format: "{{ item.metadata.name }}"
  loop: "{{ kubectl('get', 'node', format='json').items }}"
  register: node_names

- name: Restore etcd - remove old nodes
  kubectl:
    command: delete
    api_version: v1
    kind: node
    name: "{{ item }}"
  loop: "{{ node_names.stdout | map('extract', ['metadata', 'name']) | list }}"
  when: "'-' in item and not (item in groups['etcd'])"

