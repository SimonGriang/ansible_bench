---
- import_tasks: assert.yml
  name: Pre-configure debian systems

- name: Install postfix
  apt:
    name: postfix-mysql
    state: present

- name: Configure postfix (transport_maps)
  template:
    src: postfix_transport_maps
    dest: /etc/postfix/transport

- name: Configure postfix (header_checks)
  template:
    src: postfix_header_checks
    dest: /etc/postfix/header_checks

- name: "Setting values for main.cf (1/2)"
  lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^{{ item.regexp }}'
    line: "{{ item.line }}"
  with_items:
    - { regexp: '^relayhost', line: 'relayhost = [your-relay-host]' }
    - { regexp: '^inet_interfaces', line: 'inet_interfaces = all' }

- name: "Setting values for main.cf (2/2)"
  lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^{{ item.regexp }}'
    line: "{{ item.line }}"
  with_items:
    - { regexp: '^myhostname', line: 'myhostname = localhost' }
    - { regexp: '^mydomain', line: 'mydomain = localhost' }

- name: Configure postfix (main.cf)
  template:
    src: postfix_main
    dest: /etc/postfix/main.cf

- name: Configure postfix (master.cf)
  template:
    src: postfix_master
    dest: /etc/postfix/master.cf

- name: Creates cert/key directory
  file:
    path: /etc/postfix/ssl
    state: directory
    mode: '0700'

- name: Deploy Postfix TLS server certificate
  copy:
    src: /path/to/postfix-tls-cert.pem
    dest: /etc/postfix/ssl/postfix-tls-cert.pem
    mode: '0600'

- name: Deploy Postfix TLS server key
  copy:
    src: /path/to/postfix-tls-key.pem
    dest: /etc/postfix/ssl/postfix-tls-key.pem
    mode: '0600'

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    src: /path/to/postfix-aliases
    dest: /etc/postfix/aliases
    mode: '0644'

- name: Configure sender_access
  template:
    src: sender_access
    dest: /etc/postfix/sender_access
    mode: '0644'

- name: Configure recipient_access
  template:
    src: recipient_access
    dest: /etc/postfix/recipient_access
    mode: '0644'

- name: Place sasl_password_map
  template:
    src: sasl_password_map
    dest: /etc/postfix/sasl_password_map
    mode: '0644'

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemd:
    name: postfix
    enabled: yes
    state: started

