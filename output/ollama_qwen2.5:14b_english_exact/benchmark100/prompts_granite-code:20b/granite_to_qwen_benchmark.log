ion': 11020386677, 'load_duration': 85379592, 'prompt_eval_count': 3882, 'prompt_eval_duration': 2404061410, 'eval_count': 437, 'eval_duration': 8520612337, 'model_name': 'qwen2.5:14b'} id='run--155e755e-4c4c-4ed7-9267-40fe69f8981c-0' usage_metadata={'input_tokens': 3882, 'output_tokens': 437, 'total_tokens': 4319}
