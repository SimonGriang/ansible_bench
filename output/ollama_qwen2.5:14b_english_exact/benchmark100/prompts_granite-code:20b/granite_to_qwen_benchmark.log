---
- name: Task 1: Check if certificates exists
  ansible.builtin.stat:
    path: /path/to/certificates

- name: Task 2: Fail if some cert doesn't exist
  ansible.builtin.fail:
    msg: "Certificate does not exist at /path/to/certificates"

- name: Task 3: Setting keystore variables in java < 11
  ansible.builtin.set_fact:
    keystore_variables_java_11:
      java_home: /path/to/java
      keystore_path: /path/to/keystore
      truststore_path: /path/to/truststore

- name: Task 4: Setting keystore variables in java >= 11
  ansible.builtin.set_fact:
    keystore_variables_java_11_or_above:
      java_home: /path/to/java
      keystore_path: /path/to/keystore
      truststore_path: /path/to/truststore
      jvm_option: '-Djavax.net.ssl.trustStore=/path/to/truststore'

- name: Task 5: Import SSL certificates
  ansible.builtin.java_cert:
    path: /path/to/certificates
    keystore: /path/to/keystore
    truststore: /path/to/truststore
    state: present

