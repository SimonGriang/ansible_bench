  when: lookup('vars', 'java_open_jdk_version_major') is defined

- name: Set specific variables - continued
  set_fact:
    java_open_jdk_version_minor: "{{ lookup('vars', 'java_open_jdk_version_minor') }}"
  when: lookup('vars', 'java_open_jdk_version_minor') is defined

- name: Set specific variables - continued
  set_fact:
    java_open_jdk_home_dir: "{{ lookup('vars', 'java_open_jdk_home_dir') }}"
  when: lookup('vars', 'java_open_jdk_home_dir') is defined

- name: Set specific variables - continued
  set_fact:
    java_open_jdk_bin_dir: "{{ lookup('vars', 'java_open_jdk_bin_dir') }}"
