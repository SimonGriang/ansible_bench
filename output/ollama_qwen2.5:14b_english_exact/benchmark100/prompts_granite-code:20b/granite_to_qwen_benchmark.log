---
- name: Install ssl packages
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - python3-certifi
    - python3-urllib3
    - python3-chardet
    - python3-idna
    - openssl

- name: Place configuration
  copy:
    src: ssl-config.conf
    dest: /etc/nginx/conf.d/ssl-config.conf
    mode: '0644'

- name: Configure redirect from http to https
  lineinfile:
    path: /etc/nginx/sites-available/default
    regexp: '^(\s*)server\s\{'
    line: '\1server {'
    insertafter: '^(\s*)server\s\{'
    block: |
      listen 80;
      server_name example.com;
      return 301 https://$host$request_uri;
  notify: Restart nginx

