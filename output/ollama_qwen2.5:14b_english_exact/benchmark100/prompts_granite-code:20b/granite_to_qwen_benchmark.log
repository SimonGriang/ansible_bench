---
- name: Install mysql
  ansible.builtin.yum:
    name: mysql-server
    state: present
    become: true

- name: Configure mysql server
  ansible.builtin.template:
    src: mysql-server.conf.j2
    dest: /etc/my.cnf.d/mysql-server.cnf
    mode: '0644'

- name: Configure mysql client
  ansible.builtin.template:
    src: mysql-client.conf.j2
    dest: /etc/my.cnf.d/mysql-client.cnf
    mode: '0644'

- name: Initialize mysql
  ansible.builtin.command: mysql_install_db
  args:
    creates: /var/lib/mysql/ibdata1

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysqld
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /etc/my.cnf
    mode: '0644'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
  loop:
    - db1
    - db2

- name: List databases
  ansible.builtin.command: mysql -Bse 'show databases;'
  changed_when: false

- name: Import database
  ansible.builtin.command: mysql db1 < /path/to/db1.sql
  changed_when: false

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
  loop:
    - name: user1
      host: localhost
      password: secretpassword
      priv: db1.*:ALL
    - name: user2
      host: 192.168.1.10
      password: anothersecret
      priv: db2.*:SELECT

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: true

