---
- import_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  yum:
    name: systemd-logger
    state: absent
  when: ansible_os_family == 'RedHat'

- name: Install rsyslog
  yum:
    name: rsyslog
    state: present
  when: ansible_os_family == 'RedHat'

- name: Install additional rsyslog packages
  yum:
    name: "{{ item }}"
    state: present
  loop:
    - rsyslog-gnutls
    - rsyslog-relp
    - rsyslog-imfile
  when: ansible_os_family == 'RedHat'

- name: Configuring default rsyslog
  lineinfile:
    path: /etc/rsyslog.conf
    regexp: '^(\$ModLoad imklog|*.imuxsock|*.imjournal)'
    line: '$ModLoad imuxsock $DefaultNetstreamDriverName/linuxsocket'
    state: present

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d
    state: directory
    mode: '0755'

- name: Configuring rsyslog forward rule
  template:
    src: templates/rsyslog-forward.conf.j2
    dest: /etc/rsyslog.d/forward.conf
    mode: '0644'

- name: Configuring additional config files
  copy:
    src: "{{ item }}"
    dest: /etc/rsyslog.d/
    mode: '0644'
  loop:
    - files/acl.conf
    - files/forward-to-remote.conf

- name: Start and enable rsyslog
  systemd:
    name: rsyslog
    state: started
    enabled: yes

