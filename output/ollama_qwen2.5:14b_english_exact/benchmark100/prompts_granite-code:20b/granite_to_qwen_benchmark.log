---
- name: Install cron
  package:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/cron.conf
    regexp: '^SHELL='
    line: 'SHELL=/bin/bash'
    create: yes

- name: Configure path
  lineinfile:
    path: /etc/cron.conf
    regexp: '^PATH='
    line: 'PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin'
    create: yes

- name: Configure mailto
  lineinfile:
    path: /etc/cron.conf
    regexp: '^MAILTO='
    line: 'MAILTO=root'
    create: yes

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: yes

- name: Schedule requested cron jobs
  cron:
    name: "Scheduled task example"
    minute: "*/5"
    hour: "*"
    day: "*"
    month: "*"
    weekday: "*"
    user: root
    job: "/usr/bin/logger -t cronjob 'Task executed successfully'"
    state: present

