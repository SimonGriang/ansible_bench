  ansible.builtin.yum:
    name: epel-release
    state: present
  when:
    - ansible_distribution == "Amazon" and ansible_distribution_major_version == "2"
    - ansible_os_family == "RedHat" and ansible_distribution_major_version in ["7", "8", "9", "10"]

- name: Install epel gpg key
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install epel-release
  ansible.builtin.yum:
    name: "{{ epel_url }}"
    state: present
  notify: update package cache

- name: Install epel-next-release
  ansible.builtin.yum:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next == True
  notify: update package cache


