---
- name: lookup bootstrap facts
  command: cat /etc/os-release
  register: os_release_info

- name: set bootstrap facts (I)
  block:
    - set_fact:
        bootstrap_distribution: "{{ item.value.distribution }}"
      loop:
        - {key: distribution, value: {distribution: "Debian", distribution_major_version: "10"}}
      loop_control:
        loop_var: item
      when: os_release_info.stdout is match("PRETTY_NAME.*Debian.*")

    - set_fact:
        bootstrap_distribution_major_version: "{{ item.value.distribution_major_version }}"
      loop:
        - {key: distribution_major_version, value: {distribution: "Debian", distribution_major_version: "10"}}
      loop_control:
        loop_var: item
      when: os_release_info.stdout is match("PRETTY_NAME.*Debian.*")

    - set_fact:
        bootstrap_distribution: "{{ item.value.distribution }}"
      loop:
        - {key: distribution, value: {distribution: "Ubuntu", distribution_major_version: "20.04"}}
      loop_control:
        loop_var: item
      when: os_release_info.stdout is match("PRETTY_NAME.*Ubuntu.*")

    - set_fact:
        bootstrap_distribution_major_version: "{{ item.value.distribution_major_version }}"
      loop:
        - {key: distribution_major_version, value: {distribution: "Ubuntu", distribution_major_version: "20.04"}}
      loop_control:
        loop_var: item
      when: os_release_info.stdout is match("PRETTY_NAME.*Ubuntu.*")

- name: set bootstrap facts (II)
  block:
    - set_fact:
        bootstrap_os_family: "{{ item.value.os_family }}"
      loop:
        - {key: os_family, value: {os_family: "Debian"}}
      loop_control:
        loop_var: item
      when: os_release_info.stdout is match("PRETTY_NAME.*Debian.*")

    - set_fact:
        bootstrap_os_family: "{{ item.value.os_family }}"
      loop:
        - {key: os_family, value: {os_family: "Ubuntu"}}
      loop_control:
        loop_var: item
      when: os_release_info.stdout is match("PRETTY_NAME.*Ubuntu.*")

