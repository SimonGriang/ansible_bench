      - ca-certificates
      - openssl
      - python3-certifi
    state: present

- name: Place configuration
  copy:
    src: ssl.conf
    dest: /etc/apache2/sites-available/ssl.conf
    mode: '0644'

- name: Configure redirect from http to https
  block:
    - lineinfile:
        path: /etc/apache2/sites-available/000-default.conf
        regexp: '^RewriteEngine'
        line: 'RewriteEngine On\n'
    - lineinfile:
        path: /etc/apache2/sites-available/000-default.conf
        insertbefore: '^RewriteEngine'
        line: 'RewriteCond %{HTTPS} off\n'
    - lineinfile:
        path: /etc/apache2/sites-available/000-default.conf
        insertbefore: '^RewriteEngine'
        line: 'RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [L,R=permanent]'

