---
- import_tasks: assert.yml

- name: Install dns
  package:
    name: bind9
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: "/etc/bind", mode: "0755", owner: "root", group: "root" }
    - { path: "/var/cache/bind", mode: "0755", owner: "bind", group: "bind" }

- name: Create group
  group:
    name: bind
    state: present

- name: Create user
  user:
    name: bind
    group: bind
    uid: 105
    system: yes
    state: present

- name: Generate rndc key
  command: "dnssec-keygen -a HMAC-MD5 -b 128 -n HOST -r /dev/urandom -k /etc/bind/rndc.key"
  args:
    creates: /etc/bind/rndc.key

- name: Set permissions on rndc key file
  file:
    path: /etc/bind/rndc.key
    mode: "0600"
    owner: root
    group: bind

- name: Get the hints/root file
  get_url:
    url: "https://www.internic.net/domain/named.root"
    dest: "/etc/bind/named.root"
    mode: "0644"
    owner: root
    group: bind

- name: Create zone file
  template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "0644"
    owner: root
    group: bind
  loop: "{{ dns_zones }}"
  vars:
    item.src: "{{ item.name }}.j2"
    item.dest: "/etc/bind/zones/{{ item.name }}.zone"

- name: Add zones to configuration
  template:
    src: "named.conf.j2"
    dest: "/etc/bind/named.conf"
    mode: "0644"
    owner: root
    group: bind

- name: Place systemd override
  template:
    src: "override.conf.j2"
    dest: "/etc/systemd/system/bind9.service.d/override.conf"
    mode: "0644"
    owner: root
    group: root

- name: Start and enable dns
  service:
    name: bind9
    state: started
    enabled: yes

