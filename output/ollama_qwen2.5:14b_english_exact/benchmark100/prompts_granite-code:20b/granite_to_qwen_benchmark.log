content='---\n- name: Download RKE2 installation script\n  get_url:\n    url: "{{ rke2_install_bash_url }}"\n    dest: "{{ rke2_install_script_dir }}/rke2.sh"\n    mode: 0700\n    timeout: "{{ rke2_artifact_fetch_timeout }}"\n\n- name: Copy local RKE2 installation script\n  copy:\n    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"\n    dest: "{{ rke2_install_script_dir }}/rke2.sh"\n    mode: 0700\n    force: yes\n\n- name: Create RKE2 artifacts folder\n  file:\n    path: "{{ rke2_artifact_path }}"\n    state: directory\n    mode: 0700\n\n- name: Download RKE2 checksum and artifacts (try to download remotely first - fallback to local download and push)\n  block:\n    - name: Download RKE2 checksum file\n      get_url:\n        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"\n        dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"\n        mode: 0640\n        timeout: "{{ rke2_artifact_fetch_timeout }}"\n    - name: Download RKE2 artifacts\n      get_url:\n        url: "{{ rke2_artifact_url }}/{{ rke2_version }}"\n        dest: "{{ rke2_artifact_path }}"\n        mode: 0640\n        timeout: "{{ rke2_artifact_fetch_timeout }}"\n    - name: Download RKE2 install script\n      get_url:\n        url: "{{ rke2_install_bash_url }}"\n        dest: "{{ rke2_install_script_dir }}/rke2.sh"\n        mode: 0700\n        timeout: "{{ rke2_artifact_fetch_timeout }}"\n\n- name: Copy local RKE2 artifacts\n  when: rke2_airgap_mode and rke2_airgap_implementation == \'copy\'\n  copy:\n    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"\n    dest: "{{ rke2_artifact_path }}/{{ item }}"\n    mode: 0640\n    force: yes\n  with_items:\n    - sha256sum-{{ rke2_architecture }}.txt\n\n- name: Airgap mode - additional images tarballs\n  when: rke2_airgap_mode and rke2_airgap_tarballs|length > 0\n  block:\n    - name: Create additional images tarballs folder\n      file:\n        path: "{{ rke2_tarball_images_path }}"\n        state: directory\n        mode: 0700\n    - name: Copy additional tarball images RKE2 components\n      copy:\n        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"\n        dest: "{{ rke2_tarball_images_path }}/{{ item }}"\n        mode: 0644\n        force: yes\n  with_items: "{{ rke2_airgap_tarballs }}"\n\n- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged\n  when: rke2_airgap_mode and rke2_airgap_implementation == \'exists\'\n  block:\n    - name: Register artifacts\n      file:\n        path: "{{ rke2_artifact_path }}/{{ item }}"\n        state: file\n        mode: "{{ item is file and item.stat().mode & 0o200 != 0o200 | ternary(\'0640\', item.stat().mode | string) }}"\n      with_items:\n        - sha256sum-{{ rke2_architecture }}.txt\n    - name: Make install script executable if needed\n      file:\n        path: "{{ rke2_install_script_dir }}/rke2.sh"\n        mode: "{{ rke2_install_script_dir }}/rke2.sh" is file and not ( stat(path="{{ rke2_install_script_dir }}/rke2.sh").mode & 0o100 ) | ternary(\'0700\', item.stat().mode | string)\n      register: install_script_executable\n      changed_when: install_script_executable.changed\n    - name: Fail if install script is not executable\n      fail:\n        msg: "RKE2 install script is not executable and cannot be made executable."\n      when: not install_script_executable.changed\n\n- name: Populate service facts\n  systemd:\n    name: "{{ item }}"\n    enabled: yes\n    state: started\n  with_items:\n    - rke2-server\n    - rke2-agent\n\n- name: Get stats of the FS object\n  stat:\n    path: /usr/local\n\n- name: Check if separate partition\n  stat:\n    path: /usr/local\n\n- name: Set RKE2 bin path\n  set_fact:\n    rke2_bin_path: "{{ rke2_bin_path }}"\n\n- name: Check RKE2 version\n  command: "{{ rke2_bin_path }}/rke2 version"\n  register: rke2_version_output\n\n- name: Prevent accidental RKE2 downgrade\n  assert:\n    that:\n      - rke2_version_output.stdout.find("{{ rke2_version }}") != -1\n\n- name: Run RKE2 install script\n  command: "{{ rke2_install_script_dir }}/rke2.sh install --url {{ rke2_install_url }} --token {{ rke2_token }} --server https://{{ rke2_cluster_host }} --kubeconfig {{{{ rke2_kubeconfig_path }}}} --data-dir {{{{ rke2_data_path }}}} --token-ttl 24h --no-reload --no-upgrade --no-lb --no-node-taint --no-tls-san --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-san= --no-tls-