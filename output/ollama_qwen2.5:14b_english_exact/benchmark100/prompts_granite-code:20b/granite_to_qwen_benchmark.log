---
- name: check if all variables have been set correctly
  fail:
    msg: "Variable {{ item }} is not set"
  with_items:
    - var1
    - var2
    - var3
  when: item is not defined

- name: wait for host (when configured)
  wait_for:
    host: "{{ ansible_host }}"
    port: 22
    delay: 5
    timeout: 30
  when: ansible_host is defined

- name: prepare system
  block:
    - name: test connection
      command: "true"
      changed_when: false

    - name: install bootstrap packages
      package:
        name: "{{ packages }}"
        state: present
      when: ansible_os_family == "Debian"
      vars:
        packages:
          - python3-pip
          - python3-dev

    - name: install bootstrap packages
      package:
        name: "{{ packages }}"
        state: present
      when: ansible_os_family == "RedHat"
      vars:
        packages:
          - python36
          - python36-devel

