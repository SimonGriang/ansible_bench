  when: ansible_facts['stat']['exists'] == true

- name: Download Helm
  unarchive:
    url: https://get.helm.sh/helm-v3.9.0-linux-amd64.tar.gz
    dest: /tmp
    remote_src: true
    creates: /usr/local/bin/helm
    remote_tmp: /tmp
    extra_opts: ['--tar', '--remote-src']


