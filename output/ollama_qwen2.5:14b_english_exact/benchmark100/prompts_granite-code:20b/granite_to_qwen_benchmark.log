---
- name: Create the RKE2 config dir
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  ansible.builtin.command: systemctl set-property rke2-server.service Environment='NODE_LABELS={{ rke2_server_node_taints }}'
  when: rke2_server_node_taints is defined

- name: Copy rke2 config
  ansible.builtin.copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0600'

- name: Copy kubelet config
  ansible.builtin.copy:
    src: "{{ rke2_kubelet_config_src }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0600'
  when: rke2_kubelet_config is defined

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ rke2_containerd_registry_config_src }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0600'
  when: rke2_custom_registry_mirrors is defined or rke2_custom_registry_configs is defined

- name: Register if we need to do a etcd restore from file
  ansible.builtin.set_fact:
    do_etcd_restore: "{{ (rke2_etcd_snapshot_file is defined) and (rke2_etcd_snapshot_file.stat.exists) }}"

- name: Register if we need to do a etcd restore from s3
  ansible.builtin.set_fact:
    do_etcd_restore_from_s3: "{{ (rke2_etcd_snapshot_s3_options.access_key is defined) and (rke2_etcd_snapshot_s3_options.secret_key is defined) and (rke2_etcd_snapshot_s3_options.bucket is defined) and (rke2_etcd_snapshot_s3_options.snapshot_name is defined) }}"

- name: Restore etcd from file
  block:
    - name: Create the RKE2 etcd snapshot directory
      ansible.builtin.file:
        path: /var/lib/rancher/rke2/agent/snapshots
        state: directory
        mode: '0755'

    - name: Copy the etcd snapshot file
      ansible.builtin.copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/snapshots/etcd-snapshot

    - name: Restore etcd from snapshot
      ansible.builtin.command: rke2 server etcd restore --file /var/lib/rancher/rke2/agent/snapshots/etcd-snapshot
      when: do_etcd_restore is defined

  when: do_etcd_restore is defined

- name: Restore etcd from s3
  ansible.builtin.command: rke2 server etcd restore --s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }} --s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }} --s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }} --s3-snapshot-name={{ rke2_etcd_snapshot_s3_options.snapshot_name }}
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  ansible.builtin.service:
    name: rke2-server
    state: started
    enabled: yes

- name: Mask RKE2 agent service on the first server
  ansible.builtin.systemd:
    name: rke2-agent
    state: masked

- name: Wait for the first server be ready - no CNI
  ansible.builtin.wait_for:
    path: /var/lib/rancher/rke2/data/current-state.json
    search_regex: '"Ready":true'
    delay: 5
    timeout: 300
  when: rke2_cni is not defined

- name: Wait for the first server be ready - with CNI
  ansible.builtin.wait_for:
    path: /var/lib/rancher/rke2/data/current-state.json
    search_regex: '"Ready":true'
    delay: 5
    timeout: 300
  when: rke2_cni is defined

- name: Restore etcd
  block:
    - name: Remove old <node>.node-password.rke2 secrets
      ansible.builtin.file:
        path: /var/lib/rancher/rke2/data/<node>.node-password.rke2
        state: absent
      loop: "{{ groups['rke2_cluster_group_name'] }}"

    - name: Remove old nodes
      ansible.builtin.command: rke2 server node remove --address={{ item }}
      loop: "{{ groups['rke2_cluster_group_name'] }}"
      when: do_etcd_restore|bool or do_etcd_restore_from_s3|bool

  when: do_etcd_restore|bool or do_etcd_restore_from_s3|bool

- name: Set an Active Server variable
  ansible.builtin.set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  delegate_facts: true
  loop: "{{ groups[rke2_cluster_group_name] }}"

