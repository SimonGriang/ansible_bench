---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install required packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  with_items: "{{ required_packages }}"

- name: Configure systemd service
  ansible.builtin.template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "0644"
  when: ansible_service_mgr == "systemd"
  with_items: "{{ systemd_service_files }}"

- name: Configure sysvinit service
  ansible.builtin.template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "0644"
  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]
  with_items: "{{ sysvinit_service_files }}"

- name: Manage service
  ansible.builtin.service:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    enabled: "{{ item.enabled | default(False) }}"
  with_items: "{{ service_list }}"

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

