reated_at': '2025-10-22T05:59:14.703809553Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8821186370, 'load_duration': 91276336, 'prompt_eval_count': 1278, 'prompt_eval_duration': 119955115, 'eval_count': 475, 'eval_duration': 8602174524, 'model_name': 'qwen2.5:14b'} id='run--222fd0cf-752a-4bfe-9033-5d8bfb90c2c3-0' usage_metadata={'input_tokens': 1278, 'output_tokens': 475, 'total_tokens': 1753}
