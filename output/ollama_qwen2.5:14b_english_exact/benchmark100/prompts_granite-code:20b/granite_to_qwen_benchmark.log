---
- name: Create group vault
  group:
    name: vault
    state: present

- name: Create user vault
  user:
    name: vault
    group: vault
    create_home: no
    system: yes
    state: present

- name: Create directory /opt/vault
  file:
    path: /opt/vault
    state: directory
    mode: '0750'
    owner: vault
    group: vault

- name: Download Vault binary
  get_url:
    url: https://releases.hashicorp.com/vault/1.11.2/vault_1.11.2_linux_amd64.zip
    dest: /opt/vault/vault.zip
    mode: '0640'
    owner: vault
    group: vault

- name: Create directory /etc/vault.d
  file:
    path: /etc/vault.d
    state: directory
    mode: '0750'
    owner: vault
    group: vault

- name: Copy Vault binary
  unarchive:
    src: /opt/vault/vault.zip
    dest: /usr/local/bin
    remote_src: yes
    owner: root
    group: root
    mode: '0750'
    creates: /usr/local/bin/vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  sefcontext:
    path: /usr/local/bin/vault
    boolean: cap_ipc_lock
    state: on
    priority: 100

- name: Create file /etc/vault.d/vault.env
  copy:
    dest: /etc/vault.d/vault.env
    mode: '0640'
    owner: vault
    group: vault
    content: |
      VAULT_ADDR=http://127.0.0.1:8200
      VAULT_API_ADDR=http://127.0.0.1:8200
      VAULT_LOG_LEVEL=info
      VAULT_DISABLE_MLOCK=true

- name: Create directory /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy Vault service file
  copy:
    dest: /usr/lib/systemd/system/vault.service
    mode: '0644'
    owner: root
    group: root
    content: |
      [Unit]
      Description=Vault
      Wants=network-online.target
      After=network-online.target

      [Service]
      User=vault
      Group=vault
      ExecStart=/usr/local/bin/vault server -config=/etc/vault.d
      ExecReload=/bin/kill -HUP $MAINPID
      KillSignal=SIGINT
      TimeoutStopSec=30
      LimitNOFILE=65536

      [Install]
      WantedBy=multi-user.target

- name: Copy vault configuration
  copy:
    dest: /etc/vault.d/vault.hcl
    mode: '0640'
    owner: vault
    group: vault
    content: |
      storage "file" {
        path = "/opt/vault/data"
      }

      listener "tcp" {
        address = "127.0.0.1:8200"
        tls_disable = 1
      }

      disable_mlock = true

- name: Flush handlers
  meta: flush_handlers

