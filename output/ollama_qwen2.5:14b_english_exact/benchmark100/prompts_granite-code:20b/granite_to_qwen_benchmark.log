---
- name: Set fact java_jdk_vendor to temurin if java_jdk_vendor equals adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Include OS specific variables based on java_jdk_vendor, ansible_distribution, and ansible_distribution_major_version
  include_vars:
    file: "{{ lookup('template', 'vars/{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.j2') }}"
  when: java_jdk_vendor is defined and ansible_distribution is defined and ansible_distribution_major_version is defined

- name: Include architecture specific variables
  include_vars:
    file: "{{ lookup('template', 'vars/{{ ansible_architecture }}.j2') }}"

- name: Set OS specific variables (I)
  set_fact:
    java_open_jdk_packages: "{{ lookup('vars', 'java_open_jdk_packages') }}"
    java_open_jdk_version_major: "{{ lookup('vars', 'java_open_jdk_version_major') }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_version_major: "{{ lookup('vars', 'java_open_jdk_version_major') }}"
    java_open_jdk_version_minor: "{{ lookup('vars', 'java_open_jdk_version_minor') }}"
    java_open_jdk_home_dir: "{{ lookup('vars', 'java_open_jdk_home_dir') }}"

- name: Set specific variables
  set_fact:
    java_open_jdk_version_major: "{{ lookup('vars', 'java_open_jdk_version_major') }}"
    java_open_jdk_version_minor: "{{ lookup('vars', 'java_open_jdk_version_minor') }}"
    java_open_jdk_home_dir: "{{ lookup('vars', 'java_open_jdk_home_dir') }}"
    java_open_jdk_bin_dir: "{{ lookup('vars', 'java_open_jdk_bin_dir') }}"
    java_open_jdk_conf_dir: "{{ lookup('vars', 'java_open_jdk_conf_dir') }}"
    java_open_jdk_lib_dir: "{{ lookup('vars', 'java_open_jdk_lib_dir') }}"

- name: Add pre-requisites for Debian if ansible_os_family equals Debian
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_packages }}"
  when: ansible_os_family == 'Debian'

- name: Add pre-requisites for RedHat if ansible_os_family equals RedHat
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_packages }}"
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_packages }}"

- name: Install Java, Debian if ansible_os_family equals Debian
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_packages }}"
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat if ansible_os_family equals RedHat
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_packages }}"
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  block:
    - name: Set JAVA_HOME environment variable
      ansible.builtin.lineinfile:
        path: /etc/environment
        line: 'JAVA_HOME="/usr/lib/jvm/{{ java_open_jdk_home_dir }}"'
        create: yes
    - name: Set PATH environment variable
      ansible.builtin.lineinfile:
        path: /etc/environment
        line: 'PATH="/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin:$PATH"'
        create: yes

- name: Source environment variables
  block:
    - name: Source /etc/environment
      ansible.builtin.shell: source /etc/environment

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11 if ansible_os_family equals Debian and java_open_jdk_version_major is less than 11
  block:
    - name: Check if java version is less than 11
      shell: java -version 2>&1 | awk -F '"' '/version/ {print $2}' | awk -F '.' '{print $1}'
      register: java_version_check
    - name: Update java version path if needed
      ansible.builtin.file:
        path: /etc/profile.d/java.sh
        line: 'export JAVA_HOME="/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre"'
        create: yes
      when: java_version_check.stdout | int < 11

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11 if ansible_os_family equals Debian and java_open_jdk_version_major is greater than or equal to 11
  block:
    - name: Check if java version is greater than or equal to 11
      shell: java -version 2>&1 | awk -F '"' '/version/ {print $2}' | awk -F '.' '{print $1}'
      register: java_version_check
    - name: Update java version path if needed
      ansible.builtin.file:
        path: /etc/profile.d/java.sh
        line: 'export JAVA_HOME="/usr/lib/jvm/{{ java_open_jdk_home_dir }}"'
        create: yes
      when: java_version_check.stdout | int >= 11

