---
- import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  template:
    dest: "{{ mysql_configuration_destination }}"
    src: mysql_configuration.j2
    owner: root
    group: root
    mode: '0644'
  vars:
    mysql_name: "{{ mysql_name }}"
    mysql_configuration_options: "{{ mysql_configuration_options }}"
    mysql_socket: "{{ mysql_socket }}"

- name: Configure mysql client
  template:
    dest: "{{ mysql_configuration_destination }}"
    src: mysql_client_configuration.j2
    owner: root
    group: root
    mode: '0644'
  vars:
    mysql_name: "{{ mysql_name }}"
    mysql_socket: "{{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/.mysql_initialization_complete

- name: Start and enable mysql
  service:
    name: "{{ mysql_name }}"
    enabled: yes
    state: started

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers

