---
- name: Install Keepalived when HA mode is enabled
  ansible.builtin.when: ha_mode == 'enabled'
  ansible.builtin.package:
    name: keepalived
    state: present

- name: Download and install RKE2 {{ rke2_version }}
  ansible.builtin.get_url:
    url: "{{ rke2_download_url }}"
    dest: "/tmp/rke2-install"
    sha256sum: "{{ rke2_sha256sum }}"
  register: rke2_installation
  changed_when: "'already installed' not in rke2_installation.stdout"
  notify: restart_rke2_service

- name: Apply CIS Benchmark hardening for RKE2
  ansible.builtin.template:
    src: cis_hardening.yml.j2
    dest: /etc/rancher/rke2/cis-hardening.yaml
  notify: restart_rke2_service

- name: Find the active server in the cluster
  ansible.builtin.shell: kubectl get nodes -o jsonpath="{.items[?(@.metadata.labels.run=kube-vip)].metadata.name}"
  register: active_server
  changed_when: false
  failed_when: false

- name: Enable the IPVS kernel module for kube-vip load balancer
  ansible.builtin.kernel_module:
    name: ip_vs
    state: present
    required: true

- name: Copy kube-vip manifests to the masternode
  ansible.builtin.copy:
    src: kube-vip/kube-vip.yml
    dest: /etc/rancher/rke2/kube-vip.yml

- name: Copy ingress-nginx manifests to the masternode
  ansible.builtin.copy:
    src: ingress-nginx/ingress-nginx.yml
    dest: /etc/rancher/rke2/ingress-nginx.yml

- name: Prepare the very first server node in the cluster
  ansible.builtin.shell: rke2 server --write-kubeconfig-mode=0644 --kubeconfig-mode=0644 --write-kubeconfig-to=/etc/rancher/rke2/kubeconfig

- name: Restore etcd specific tasks based on restore options
  ansible.builtin.include_tasks: etcd_restore.yml
  when: etcd_restore_enabled

- name: Download kubeconfig file to the Ansible localhost
  ansible.builtin.fetch:
    src: /etc/rancher/rke2/kubeconfig
    dest: "{{ playbook_dir }}/kubeconfig"
    flat: yes

- name: Prepare and join remaining nodes in the cluster
  ansible.builtin.shell: rke2 agent --server https://{{ master_ip }}:6443 --write-kubeconfig-mode=0644 --kubeconfig-mode=0644 --write-kubeconfig-to=/etc/rancher/rke2/kubeconfig

- name: Perform rolling restart of servers when the version changes
  ansible.builtin.shell: |
    rke2 config --set server=https://{{ master_ip }}:6443 --set update.image=rancher/rke2:{{ rke2_version }} --set update.channel=latest --write-kubeconfig-mode=0644 --kubeconfig-mode=0644 --write-kubeconfig-to=/etc/rancher/rke2/kubeconfig
  when: version_changed
  notify: restart_rke2_service

- name: Perform rolling restart of agents when the version changes
  ansible.builtin.shell: |
    rke2 config --set server=https://{{ master_ip }}:6443 --set update.image=rancher/rke2:{{ rke2_version }} --set update.channel=latest --write-kubeconfig-mode=0644 --kubeconfig-mode=0644 --write-kubeconfig-to=/etc/rancher/rke2/kubeconfig
  when: version_changed
  notify: restart_rke2_service

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Perform rolling restart of cluster nodes when configuration files change
  ansible.builtin.shell: |
    rke2 config --set server=https://{{ master_ip }}:6443 --write-kubeconfig-mode=0644 --kubeconfig-mode=0644 --write-kubeconfig-to=/etc/rancher/rke2/kubeconfig
  when: config_files_changed
  notify: restart_rke2_service

- name: Perform final steps and summary of the playbook
  ansible.builtin.shell: |
    echo "RKE2 cluster setup completed."
    echo "Kubeconfig file has been downloaded to {{ playbook_dir }}."

