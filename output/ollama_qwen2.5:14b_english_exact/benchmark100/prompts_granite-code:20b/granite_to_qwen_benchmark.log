---
- name: Install nginx
  apt:
    name: nginx
    state: present

- name: Place nginx.conf
  copy:
    src: nginx.conf
    dest: /etc/nginx/nginx.conf
  notify:
    - validate nginx.conf

- name: Ensure /etc/nginx/conf.d exists
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: '0755'

- name: Place default.conf
  copy:
    src: default.conf
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'

- name: Start and enable nginx
  systemd:
    name: nginx
    state: started
    enabled: yes

- name: Validate nginx.conf
  command: nginx -t -c /etc/nginx/nginx.conf
  register: nginx_validate
  changed_when: false
  when: ansible_facts['os_family'] == 'Debian'
  notify:
    - reload nginx

- name: Reload nginx
  systemd:
    name: nginx
    state: reloaded
  listen: nginx_validate.changed

