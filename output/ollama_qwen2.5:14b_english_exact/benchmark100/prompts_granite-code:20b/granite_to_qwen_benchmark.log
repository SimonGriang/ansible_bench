---
- name: Load OS-specific vars
  include_vars: "{{ ansible_os_family }}.yml"

- name: Install Docker packages
  apt:
    name: "{{ docker_packages }}"
    state: present
  when: ansible_os_family == "Debian"
  become: yes

- name: Install Docker packages
  yum:
    name: "{{ docker_packages }}"
    state: present
  when: ansible_os_family == "RedHat"
  become: yes

- name: Install docker-compose plugin
  command: docker plugin install --alias compose docker/compose:latest
  become: yes

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker
    state: directory
    mode: '0755'
    owner: root
    group: root
  become: yes

- name: Configure Docker daemon options
  template:
    src: docker-daemon.conf.j2
    dest: /etc/docker/daemon.json
    mode: '0644'
    owner: root
    group: root
  become: yes

- name: Ensure Docker is started and enabled at boot
  systemd:
    name: docker
    state: started
    enabled: yes
  become: yes

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Ensure docker-compose is installed
  command: which docker-compose
  register: docker_compose_installed
  changed_when: false

- name: Ensure docker-compose is installed
  command: curl -L https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-`uname -m` > /usr/local/bin/docker-compose
  when: docker_compose_installed is defined and docker_compose_installed.rc != 0
  become: yes

- name: Ensure docker-compose is installed
  command: chmod +x /usr/local/bin/docker-compose
  when: docker_compose_installed is defined and docker_compose_installed.rc != 0
  become: yes

- name: Ensure docker group users are in the docker group
  user:
    name: "{{ item }}"
    groups: docker
    append: yes
  loop: "{{ docker_users }}"
  become: yes

