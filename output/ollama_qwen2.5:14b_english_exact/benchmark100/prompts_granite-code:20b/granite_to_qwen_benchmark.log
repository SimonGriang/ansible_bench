---
- name: Ensure unzip package is available
  package:
    name: unzip
    state: present

- name: Create promtail group
  group:
    name: promtail
    state: present

- name: Create the promtail user
  user:
    name: promtail
    group: promtail
    create_home: no
    system: yes
    state: present

- name: Ensure /usr/local/bin exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Create config directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  with_items:
    - /etc/promtail
    - /etc/promtail/config.d
    - /etc/promtail/client.d

- name: Create application dirs
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  with_items:
    - /var/lib/promtail
    - /var/lib/promtail/inputs

- name: Check promtail binary
  stat:
    path: /usr/local/bin/promtail

- name: Download promtail binaries
  get_url:
    url: "https://github.com/grafana/loki/releases/download/v2.4.1/promtail-linux-amd64.zip"
    dest: /tmp/promtail-linux-amd64.zip
    mode: '0644'
    owner: root
    group: root

- name: Propagate locally distributed promtail archive
  copy:
    src: /path/to/local/promtail-linux-amd64.zip
    dest: /tmp/promtail-linux-amd64.zip
    mode: '0644'
    owner: root
    group: root

- name: Download promtail binaries to controller node
  get_url:
    url: "https://github.com/grafana/loki/releases/download/v2.4.1/promtail-linux-amd64.zip"
    dest: /tmp/promtail-linux-amd64.zip
    mode: '0644'
    owner: root
    group: root
    remote_src: yes
    delegate_to: localhost

- name: Propagate promtail binaries
  copy:
    src: /path/to/local/promtail-linux-amd64
    dest: /usr/local/bin/promtail
    mode: '0755'
    owner: promtail
    group: promtail

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail-linux-amd64.zip
    dest: /usr/local/bin
    remote_src: yes
    creates: /usr/local/bin/promtail

- name: Create symlink to latest version
  file:
    src: /usr/local/bin/promtail
    dest: /usr/local/bin/promtail
    state: link

- name: Write config
  template:
    src: promtail-config.j2
    dest: /etc/promtail/promtail-config.yml
    mode: '0644'
    owner: promtail
    group: promtail

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
    owner: root
    group: root

