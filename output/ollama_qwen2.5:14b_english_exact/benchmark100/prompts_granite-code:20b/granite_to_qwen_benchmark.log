---
- name: Install fail2ban
  ansible.builtin.apt:
    name: fail2ban
    state: present

- name: Copy filters in filter.d
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "/etc/fail2ban/filter.d/{{ item | basename }}"
    owner: root
    group: root
    mode: '0640'
  with_items:
    - path/to/source/filters/*

- name: Configure fail2ban.local
  community.general.ini_file:
    dest: /etc/fail2ban/fail2ban.local
    section: fail2ban
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    owner: root
    group: root
    mode: '0640'
  loop:
    - key: "LOGLEVEL"
      value: "3"
    - key: "DEBUG"
      value: "false"

- name: Configure jail.local
  community.general.ini_file:
    dest: /etc/fail2ban/jail.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    owner: root
    group: root
    mode: '0640'
  loop:
    - section: "DEFAULT"
      option: "bantime"
      value: "600"
    - section: "sshd"
      option: "maxretry"
      value: "5"

- name: Stat auth log file
  ansible.builtin.stat:
    path: /var/log/auth.log

- name: Touch auth log file
  ansible.builtin.file:
    path: /var/log/auth.log
    state: touch
    owner: root
    group: adm
    mode: '0640'
  when: not ansible_facts.stat.exists

- name: Start and enable fail2ban
  ansible.builtin.systemd:
    name: fail2ban
    state: started
    enabled: true


