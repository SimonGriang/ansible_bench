---
- import_tasks: assert.yml

- name: Install cron
  package:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/passwd
    regexp: '^{{ ansible_user_id }}:'
    line: "{{ ansible_user_id }}:x:{{ ansible_user_id_uid }}:{{ ansible_user_id_gid }}:{{ ansible_user_id_gecos }}:/home/{{ ansible_user_id }}:/bin/bash"

- name: Configure path
  lineinfile:
    path: /etc/environment
    line: 'PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin"'
    create: yes

- name: Configure mailto
  lineinfile:
    path: /etc/aliases
    line: 'root: {{ ansible_user_id }}'
    create: yes
  notify:
    - rebuild aliases

- name: Start and enable cron
  systemd:
    name: cron
    state: started
    enabled: yes

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    state: present
  with_items: "{{ cron_jobs }}"
  notify:
    - restart cron

- name: Rebuild aliases
  command: newaliases
  when: 'ansible_facts.packages["postfix"] is defined'

