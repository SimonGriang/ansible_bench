---
- name: Ensure old versions of Docker are not installed
  package:
    name: "{{ item }}"
    state: absent
  loop:
    - docker-engine
    - docker.io
    - docker-ce

- name: Add Docker GPG key
  apt_key:
    url: https://download.docker.com/linux/{{ ansible_os_family }}/gpg
    state: present

- name: Add Docker repository
  apt_repository:
    repo: "deb [arch={{ apt_architecture }}] https://download.docker.com/linux/{{ ansible_os_family }} {{ ansible_distribution_release }} stable"
    state: present
  when: ansible_os_family == "Debian"

- name: Add Docker repository
  yum:
    name: "https://download.docker.com/linux/{{ ansible_os_family }}/yum/docker-ce.repo"
    state: present
  when: ansible_os_family == "RedHat"

- name: Configure Docker Nightly repo
  apt_repository:
    repo: "deb [arch={{ apt_architecture }}] https://download.docker.com/linux/{{ ansible_os_family }} {{ ansible_distribution_release }} nightly"
    state: present
  when: docker_nightly

- name: Configure Docker Test repo
  apt_repository:
    repo: "deb [arch={{ apt_architecture }}] https://download.docker.com/linux/{{ ansible_os_family }} {{ ansible_distribution_release }} test"
    state: present
  when: docker_test

- name: Configure containerd on RHEL 8
  yum:
    name: "@container-tooling"
    state: present
  when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"

