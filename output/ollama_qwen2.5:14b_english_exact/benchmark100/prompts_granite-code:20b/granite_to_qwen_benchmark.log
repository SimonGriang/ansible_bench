- name: Install epel-release
  ansible.builtin.yum:
    name: "{{ epel_url }}"
    state: present
  notify: update package cache

- name: Install epel-next-release
  ansible.builtin.yum:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next == True
  notify: update package cache

