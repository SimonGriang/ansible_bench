---
- name: Install requirements
  yum:
    name: bash
    state: present
  when: ansible_os_family == 'RedHat'

- name: Install requirements
  apt:
    name: bash
    state: present
  when: ansible_os_family == 'Debian'

- name: Install openjdk java (package)
  yum:
    name: java-1.8.0-openjdk
    state: present
  when: ansible_os_family == 'RedHat'

- name: Install openjdk java (package)
  apt:
    name: default-jdk
    state: present
  when: ansible_os_family == 'Debian'

- name: Install RPM
  yum:
    name: rpm
    state: present
  when: ansible_os_family == 'RedHat'

- name: Install DEB
  apt:
    name: dpkg
    state: present
  when: ansible_os_family == 'Debian'

- name: Install oracle java (rpm) (repository)
  yum:
    name: oracle-java8-installer
    state: present
  when: ansible_os_family == 'RedHat'

- name: Configure oracle targz
  unarchive:
    src: /path/to/oracle-jdk-8uXXX-linux-x64.tar.gz
    dest: /usr/java
    remote_src: yes

- name: Install oracle java policy software (targz)
  copy:
    src: /path/to/oracle-jdk-8uXXX-linux-x64.tar.gz/jre/lib/security/java.policy
    dest: /usr/java/jdk1.8.0_XXX/jre/lib/security/java.policy
    owner: root
    group: root
    mode: 0644

- name: Set alternative (targz)
  command: alternatives --install /usr/bin/java java /usr/java/jdk1.8.0_XXX/bin/java 20000

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/javac | sed "s:bin/javac::"
  register: java_home_output
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: 'JAVA_HOME={{ java_home_output.stdout }}'

