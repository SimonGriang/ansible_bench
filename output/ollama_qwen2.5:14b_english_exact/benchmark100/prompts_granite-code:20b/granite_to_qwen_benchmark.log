content='---\n- name: Check if python is installed\n  command: which python\n  register: python_executable\n\n- name: Check if python3 is installed\n  command: which python3\n  register: python3_executable\n\n- name: Debug Python executable path\n  debug:\n    msg: "{{ python_executable.stdout }}"\n\n- name: Debug Python3 executable path\n  debug:\n    msg: "{{ python3_executable.stdout }}"\n\n- name: Import assert.yml\n  import_tasks: assert.yml\n\n- name: Install requirements\n  package:\n    name: "{{ item }}"\n    state: present\n  with_items: "{{ openssl_requirements }}"\n\n- name: Ensure packaging is available via dnf\n  package:\n    name: "{{ item }}"\n    state: present\n  with_items:\n    - dnf\n\n- name: Install pip packages\n  pip:\n    name: "{{ item }}"\n    state: present\n  with_items: "{{ openssl_pip_packages }}"\n\n- name: Create key directory\n  file:\n    path: "{{ openssl_key_directory }}"\n    state: directory\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n    mode: \'0755\'\n\n- name: Create csr directory\n  file:\n    path: "{{ openssl_csr_directory }}"\n    state: directory\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n    mode: \'0755\'\n\n- name: Create crt directory\n  file:\n    path: "{{ openssl_crt_directory }}"\n    state: directory\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n    mode: \'0755\'\n\n- name: Include create.yml\n  include_tasks: create.yml\n  loop: "{{ openssl_items }}"\n  loop_control:\n    label: "{{ item.name }}"' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-22T06:27:25.736852695Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7200851840, 'load_duration': 94019290, 'prompt_eval_count': 729, 'prompt_eval_duration': 299448533, 'eval_count': 380, 'eval_duration': 6801067058, 'model_name': 'qwen2.5:14b'} id='run--d2e63fd7-6219-43cf-9122-d356ed1cc4fb-0' usage_metadata={'input_tokens': 729, 'output_tokens': 380, 'total_tokens': 1109}
