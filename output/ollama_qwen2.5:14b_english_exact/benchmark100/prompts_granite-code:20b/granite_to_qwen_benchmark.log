    - { src: "/etc/openvpn/easy-rsa/pki/issued/client.crt", dest: "/etc/openvpn/server/client.crt" }
    - { src: "/etc/openvpn/easy-rsa/pki/issued/server.crt", dest: "/etc/openvpn/server/server.crt" }
    - { src: "/etc/openvpn/easy-rsa/pki/private/ca.key", dest: "/etc/openvpn/server/ca.key" }
    - { src: "/etc/openvpn/easy-rsa/pki/private/client.key", dest: "/etc/openvpn/server/client.key" }
    - { src: "/etc/openvpn/easy-rsa/pki/private/server.key", dest: "/etc/openvpn/server/server.key" }

- name: Copy files to /etc/openvpn
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
  loop:
    - { src: "/etc/openvpn/easy-rsa/pki/ca.crt", dest: "/etc/openvpn/ca.crt" }
