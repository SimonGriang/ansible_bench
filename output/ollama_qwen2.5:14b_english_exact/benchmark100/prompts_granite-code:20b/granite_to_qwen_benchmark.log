---
- name: Disable swap
  command: swapoff -a
  become: yes

- name: Disable core dumps
  lineinfile:
    path: /etc/security/limits.conf
    regexp: '^.* core\..*'
    line: '* hard core 0'
  become: yes

- name: Disable Shell Command History
  block:
    - name: Comment out history in /etc/bash.bashrc
      lineinfile:
        path: /etc/bash.bashrc
        regexp: '^HISTSIZE=.*'
        line: '#HISTSIZE=1000'
        backrefs: yes
      become: yes
    - name: Comment out history in /etc/profile
      lineinfile:
        path: /etc/profile
        regexp: '^HISTSIZE=.*'
        line: '#HISTSIZE=1000'
        backrefs: yes
      become: yes
    - name: Comment out history in /etc/skel/.bashrc
      lineinfile:
        path: /etc/skel/.bashrc
        regexp: '^HISTSIZE=.*'
        line: '#HISTSIZE=1000'
        backrefs: yes
      become: yes

