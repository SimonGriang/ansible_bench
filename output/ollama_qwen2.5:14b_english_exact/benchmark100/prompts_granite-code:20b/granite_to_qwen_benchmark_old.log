rces.list.d/docker-nightly.list\n        force: yes\n      when: ansible_os_family == "Debian"\n\n    - name: Configure Docker nightly repository\n      ansible.builtin.get_url:\n        url: "https://download.docker.com/linux/{{ ansible_os_family | lower }}/docker-ce-nightly.repo"\n        dest: /etc/yum.repos.d/docker-nightly.repo\n        force: yes\n      when: ansible_os_family == "RedHat"\n\n- name: Configure Docker Test repo\n  ansible.builtin.block:\n    - name: Add Docker GPG key for test\n      ansible.builtin.get_url:\n        url: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg\n        dest: /etc/apt/keyrings/docker-test.gpg\n        mode: \'0644\'\n      when: ansible_os_family == "Debian"\n\n    - name: Add Docker GPG key for test\n      ansible.builtin.get_url:\n        url: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg\n        dest: /etc/yum.repos.d/docker-test.gpg\n        mode: \'0644\'\n      when: ansible_os_family == "RedHat"\n\n    - name: Configure Docker test repository\n      ansible.builtin.get_url:\n        url: "https://download.docker.com/linux/{{ ansible_os_family | lower }}/docker-ce-test.repo"\n        dest: /etc/apt/sources.list.d/docker-test.list\n        force: yes\n      when: ansible_os_family == "Debian"\n\n    - name: Configure Docker test repository\n      ansible.builtin.get_url:\n        url: "https://download.docker.com/linux/{{ ansible_os_family | lower }}/docker-ce-test.repo"\n        dest: /etc/yum.repos.d/docker-test.repo\n        force: yes\n      when: ansible_os_family == "RedHat"\n\n- name: Configure containerd on RHEL 8\n  ansible.builtin.block:\n    - name: Install containerd\n      ansible.builtin.package:\n        name: containerd.io\n        state: present\n      when: ansible_distribution_major_version == "8" and ansible_os_family == "RedHat"\n\n    - name: Enable containerd service\n      ansible.builtin.systemd:\n        name: containerd\n        enabled: yes\n