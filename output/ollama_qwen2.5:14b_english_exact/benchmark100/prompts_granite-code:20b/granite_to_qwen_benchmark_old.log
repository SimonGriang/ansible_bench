---
- import_tasks: assert.yml
  name: Pre-configure debian systems

- name: Install postfix
  apt:
    name: postfix-mysql
    state: present

- name: Configure postfix (transport_maps)
  lineinfile:
    path: /etc/postfix/main.cf
    line: 'transport_maps = mysql:/etc/postfix/mysql/transport_maps.cf'

- name: Configure postfix (header_checks)
  lineinfile:
    path: /etc/postfix/main.cf
    line: 'header_checks = pcre:/etc/postfix/header_checks'

- name: "Setting values for main.cf (1/2)"
  lineinfile:
    path: /etc/postfix/main.cf
    line: 'relayhost = [smtp.example.com]:587'

- name: "Setting values for main.cf (2/2)"
  lineinfile:
    path: /etc/postfix/main.cf
    line: 'myhostname = mail.example.com'

- name: Configure postfix (main.cf)
  lineinfile:
    path: /etc/postfix/main.cf
    line: 'inet_interfaces = all'

- name: Configure postfix (master.cf)
  lineinfile:
    path: /etc/postfix/master.cf
    line: 'submission inet n - - - - smtpd'

- name: Creates cert/key directory
  file:
    path: /etc/postfix/ssl/
    state: directory
    mode: '0700'

- name: Deploy Postfix TLS server certificate
  copy:
    src: /path/to/cert.pem
    dest: /etc/postfix/ssl/smtpd.cert
    mode: '0600'

- name: Deploy Postfix TLS server key
  copy:
    src: /path/to/key.pem
    dest: /etc/postfix/ssl/smtpd.key
    mode: '0600'

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/postfix/aliases
    line: 'postmaster: root'

- name: Configure sender_access
  copy:
    src: /path/to/sender_access
    dest: /etc/postfix/sender_access
    mode: '0600'

- name: Configure recipient_access
  copy:
    src: /path/to/recipient_access
    dest: /etc/postfix/recipient_access
    mode: '0600'

- name: Place sasl_password_map
  copy:
    src: /path/to/sasl_password_map
    dest: /etc/postfix/sasl_password_map
    mode: '0600'

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemd:
    name: postfix
    state: started
    enabled: yes

