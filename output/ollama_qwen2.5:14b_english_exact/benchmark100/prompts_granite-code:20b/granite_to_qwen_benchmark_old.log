---
- name: Install apache httpd
  yum:
    name: httpd
    state: present
  when: ansible_os_family == 'RedHat'

- name: Install apache httpd
  apt:
    name: apache2
    state: present
  when: ansible_os_family == 'Debian'

- name: Configure selinux
  when: ansible_selinux | bool
  seboolean:
    httpd_can_network_connect: true
    httpd_can_sendmail: true
    httpd_read_user_content: true
    httpd_unified: true
  notify: test httpd configuration

- name: Configure httpd
  template:
    src: templates/httpd.conf.j2
    dest: /etc/httpd/conf/httpd.conf
  notify: test httpd configuration

- name: Activate httpd module | Debian
  command: a2enmod httpd
  notify: test httpd configuration
  when: ansible_os_family == 'Debian'

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations | defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts | defined

- name: Configure ports
  template:
    src: templates/ports.conf.j2
    dest: /etc/httpd/conf/ports.conf
  notify: test httpd configuration
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories | defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: httpd
    state: started
    enabled: yes

