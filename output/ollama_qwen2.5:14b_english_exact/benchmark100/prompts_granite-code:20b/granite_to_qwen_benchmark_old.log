---
- name: Disable swap
  command: sysctl -w vm.swappiness=10
  args:
    creates: /etc/sysctl.d/99-sysctl.conf
  register: disable_swap_result
  changed_when: disable_swap_result.stdout.find("vm.swappiness") != -1

- name: Create sysctl config to disable swap
  copy:
    content: "vm.swappiness = 10\nvm.vfs_cache_pressure = 100\n"
    dest: /etc/sysctl.d/99-sysctl.conf
  when: disable_swap_result.changed

- name: Apply sysctl config
  command: sysctl -p /etc/sysctl.d/99-sysctl.conf
  when: disable_swap_result.changed

- name: Disable core dumps
  file:
    path: /etc/security/limits.d/20-disable-core.conf
    state: touch
  block:
    - name: Add no core dumps limits
      lineinfile:
        path: /etc/security/limits.d/20-disable-core.conf
        line: "* hard core 0"
        create: yes
    - name: Ensure core pattern is empty
      copy:
        content: "core_pattern=\n"
        dest: /etc/sysctl.d/50-disable-core.conf
      notify: Apply sysctl config

- name: Disable Shell Command History
  block:
    - name: Set history size to zero
      lineinfile:
        path: /etc/bash.bashrc
        regexp: '^HISTSIZE='
        line: 'HISTSIZE=0'
        backup: yes
    - name: Set history file to /dev/null
      lineinfile:
        path: /etc/bash.bashrc
        regexp: '^HISTFILE='
        line: 'HISTFILE=/dev/null'
        backup: yes
    - name: Set history size to zero in .bashrc
      lineinfile:
        path: /etc/bash.bashrc
        regexp: '^HISTSIZE='
        line: 'HISTSIZE=0'
        backup: yes
    - name: Set history file to /dev/null in .bashrc
      lineinfile:
        path: /etc/bash.bashrc
        regexp: '^HISTFILE='
        line: 'HISTFILE=/dev/null'
        backup: yes

