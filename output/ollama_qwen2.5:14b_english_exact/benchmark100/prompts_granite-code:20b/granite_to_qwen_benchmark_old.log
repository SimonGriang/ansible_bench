---
- name: Ensure /etc/openvpn/easy-rsa exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Easyrsa init-pki
  command: /etc/openvpn/easy-rsa/easyrsa init-pki

- name: Easyrsa build-ca
  command: /etc/openvpn/easy-rsa/easyrsa build-ca nopass

- name: Easyrsa gen-dh
  command: /etc/openvpn/easy-rsa/easyrsa gen-dh

- name: Easyrsa build-server-full server nopass
  command: /etc/openvpn/easy-rsa/easyrsa build-server-full server nopass

- name: Easyrsa build-client-full client nopass
  command: /etc/openvpn/easy-rsa/easyrsa build-client-full client nopass

- name: Easyrsa gen-crl
  command: /etc/openvpn/easy-rsa/easyrsa gen-crl

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to /etc/openvpn/server
  copy:
    src: /etc/openvpn/easy-rsa/pki/ca.crt
    dest: /etc/openvpn/server/ca.crt
    mode: '0644'
  args:
    owner: root
    group: root
  register: copy_ca
  when: copy_ca is not defined or copy_ca.changed

  copy:
    src: /etc/openvpn/easy-rsa/pki/dh.pem
    dest: /etc/openvpn/server/dh.pem
    mode: '0644'
  args:
    owner: root
    group: root
  register: copy_dh
  when: copy_dh is not defined or copy_dh.changed

  copy:
    src: /etc/openvpn/easy-rsa/pki/private/ta.key
    dest: /etc/openvpn/server/ta.key
    mode: '0600'
  args:
    owner: root
    group: root
  register: copy_ta
  when: copy_ta is not defined or copy_ta.changed

  copy:
    src: /etc/openvpn/easy-rsa/pki/issued/client.crt
    dest: /etc/openvpn/server/client.crt
    mode: '0644'
  args:
    owner: root
    group: root
  register: copy_client_cert
  when: copy_client_cert is not defined or copy_client_cert.changed

  copy:
    src: /etc/openvpn/easy-rsa/pki/issued/server.crt
    dest: /etc/openvpn/server/server.crt
    mode: '0644'
  args:
    owner: root
    group: root
  register: copy_server_cert
  when: copy_server_cert is not defined or copy_server_cert.changed

  copy:
    src: /etc/openvpn/easy-rsa/pki/private/ca.key
    dest: /etc/openvpn/server/ca.key
    mode: '0600'
  args:
    owner: root
    group: root
  register: copy_ca_key
  when: copy_ca_key is not defined or copy_ca_key.changed

  copy:
    src: /etc/openvpn/easy-rsa/pki/private/client.key
    dest: /etc/openvpn/server/client.key
    mode: '0600'
  args:
    owner: root
    group: root
  register: copy_client_key
  when: copy_client_key is not defined or copy_client_key.changed

  copy:
    src: /etc/openvpn/easy-rsa/pki/private/server.key
    dest: /etc/openvpn/server/server.key
    mode: '0600'
  args:
    owner: root
    group: root
  register: copy_server_key
  when: copy_server_key is not defined or copy_server_key.changed

- name: Copy files to /etc/openvpn
  copy:
    src: /etc/openvpn/easy-rsa/pki/ca.crt
    dest: /etc/openvpn/ca.crt
    mode: '0644'
  args:
    owner: root
