  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: "/etc/bind", mode: "0755", owner: "root", group: "root" }
    - { path: "/var/cache/bind", mode: "0775", owner: "bind", group: "bind" }

- name: Create group
  group:
    name: bind
    system: yes

- name: Create user
  user:
    name: bind
    group: bind
    home: "/nonexistent"
