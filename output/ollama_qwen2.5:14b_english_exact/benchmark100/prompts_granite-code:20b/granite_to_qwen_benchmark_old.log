estart server node\n      command: systemctl restart rke2-server\n      loop: "{{ server_nodes }}"\n    - name: Uncordon server node\n      kubectl:\n        command: uncordon\n        node: "{{ item }}"\n        namespace: "{{ item }}"\n      loop: "{{ server_nodes }}"\n\n- name: Perform rolling restart of agents when the version changes\n  block:\n    - name: Cordon and drain agent node\n      kubectl:\n        command: drain\n        namespace: "{{ item }}"\n        node: "{{ item }}"\n        delete-local-data: yes\n        ignore-daemonsets: yes\n      loop: "{{ agent_nodes }}"\n    - name: Restart agent node\n      command: systemctl restart rke2-agent\n      loop: "{{ agent_nodes }}"\n    - name: Uncordon agent node\n      kubectl:\n        command: uncordon\n        node: "{{ item }}"\n        namespace: "{{ item }}"\n      loop: "{{ agent_nodes }}"\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Perform rolling restart of cluster nodes when configuration files change\n  block:\n    - name: Cordon and drain node\n      kubectl:\n        command: drain\n        namespace: "{{ item }}"\n        node: "{{ item }}"\n        delete-local-data: yes\n        ignore-daemonsets: yes\n      loop: "{{ cluster_nodes }}"\n    - name: Restart node\n      command: systemctl restart rke2-server\n      when: item in server_nodes\n      loop: "{{ cluster_nodes }}"\n    - name: Restart node\n      command: systemctl restart rke2-agent\n      when: item in agent_nodes\n      loop: "{{ cluster_nodes }}"\n    - name: Uncordon node\n      kubectl:\n        command: uncordon\n        node: "{{ item }}"\n        namespace: "{{ item }}"\n      loop: "{{ cluster_nodes }}"\n\n- name: Perform final steps and summary of the playbook\n  command: rke2 status' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-12T07:42:26.980310819Z', 'done': True, 'done_reason': 'stop', 'total_duration': 18712989895, 'load_duration': 91866526, 'prompt_eval_c