---
- name: Install fail2ban
  apt:
    name: fail2ban
    state: present

- name: Copy filters in filter.d
  copy:
    src: "{{ item }}"
    dest: /etc/fail2ban/filter.d/{{ item | basename }}
    owner: root
    group: root
    mode: 0640
  with_items:
    - filters/filter1.conf
    - filters/filter2.conf

- name: Configure fail2ban.local
  ini_file:
    dest: /etc/fail2ban/fail2ban.local
    section: DEFAULT
    option: "{{ item.key }}"
    value: "{{ item.value }}"
    state: present
  with_items:
    - {key: "ignoreip", value: "127.0.0.1/8"}
    - {key: "bantime", value: "600"}

- name: Configure jail.local
  ini_file:
    dest: /etc/fail2ban/jail.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    state: present
  with_items:
    - {section: "sshd", option: "maxretry", value: "3"}
    - {section: "ssh", option: "enabled", value: "true"}

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
    follow: yes

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    owner: root
    group: adm
    mode: 0640
  when: ansible_stat.stat.exists != true

- name: Start and enable fail2ban
  systemd:
    name: fail2ban
    state: started
    enabled: true

