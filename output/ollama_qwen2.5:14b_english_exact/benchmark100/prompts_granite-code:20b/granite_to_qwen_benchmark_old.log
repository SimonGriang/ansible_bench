---
- name: Install nginx
  ansible.builtin.apt:
    name: nginx
    state: present

- name: Place nginx.conf
  ansible.builtin.copy:
    src: nginx.conf
    dest: /etc/nginx/nginx.conf
    mode: '0644'  # Adding mode to fix risky-file-permissions

  notify:
    - Validate nginx configuration

- name: Ensure /etc/nginx/conf.d exists
  ansible.builtin.file:
    path: /etc/nginx/conf.d
    state: directory
    mode: '0755'

- name: Place default.conf
  ansible.builtin.copy:
    src: default.conf
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'

- name: Start and enable nginx
  ansible.builtin.systemd:
    name: nginx
    state: started
    enabled: true

- name: Validate nginx configuration
  ansible.builtin.command: nginx -t -c /etc/nginx/nginx.conf
  register: nginx_validate
  changed_when: false
  failed_when: nginx_validate.rc != 0


