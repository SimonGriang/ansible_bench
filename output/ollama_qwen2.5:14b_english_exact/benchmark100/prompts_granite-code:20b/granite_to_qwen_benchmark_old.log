- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}/.gitconfig.d"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0750'

- name: Place git configuration
  template:
    src: "gitconfig.j2"
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0640'
  vars:
    git_user_email: "{{ git_user_email }}"
    git_user_name: "{{ git_user_name }}"

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0750'

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}"
    version: "{{ item.version }}"
    update: yes
  with_items: "{{ git_repositories }}"
  become_user: "{{ git_username }}"


