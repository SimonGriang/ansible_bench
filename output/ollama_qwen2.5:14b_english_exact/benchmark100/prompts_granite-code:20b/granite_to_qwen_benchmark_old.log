---
- name: Install ssl packages
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - openssl
    - python3-certbot
    - python3-certbot-nginx

- name: Place configuration
  copy:
    src: ssl.conf
    dest: /etc/nginx/sites-available/ssl.conf
    mode: '0644'

- name: Configure redirect from http to https
  lineinfile:
    path: /etc/nginx/sites-available/default
    regexp: '^#*\s+server\s+{'
    line: 'listen 80 default_server;'
    insertafter: 'server {'
  block:
    - lineinfile:
        path: /etc/nginx/sites-available/default
        regexp: '^#*\s+server\s+{'
        line: '    return 301 https://$host$request_uri;'
        insertafter: 'listen 80 default_server;'

