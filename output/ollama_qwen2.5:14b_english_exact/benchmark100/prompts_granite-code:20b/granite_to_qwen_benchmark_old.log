content='---\n- name: Install ssl packages\n  apt:\n    name: "{{ item }}"\n    state: present\n  loop:\n    - openssl\n    - python3-certbot\n    - python3-certbot-nginx\n\n- name: Place configuration\n  copy:\n    src: ssl.conf\n    dest: /etc/nginx/sites-available/ssl.conf\n    mode: \'0644\'\n\n- name: Configure redirect from http to https\n  lineinfile:\n    path: /etc/nginx/sites-available/default\n    regexp: \'^#*\\s+server\\s+{\'\n    line: \'listen 80 default_server;\'\n    insertafter: \'server {\'\n  block:\n    - lineinfile:\n        path: /etc/nginx/sites-available/default\n        regexp: \'^#*\\s+server\\s+{\'\n        line: \'    return 301 https://$host$request_uri;\'\n        insertafter: \'listen 80 default_server;\'' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-12T07:08:29.446621065Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3540228111, 'load_duration': 101527879, 'prompt_eval_count': 343, 'prompt_eval_duration': 81879074, 'eval_count': 198, 'eval_duration': 3345487115, 'model_name': 'qwen2.5:14b'} id='run--f1162569-4cb3-4252-93b2-de58b0ae58d1-0' usage_metadata={'input_tokens': 343, 'output_tokens': 198, 'total_tokens': 541}
