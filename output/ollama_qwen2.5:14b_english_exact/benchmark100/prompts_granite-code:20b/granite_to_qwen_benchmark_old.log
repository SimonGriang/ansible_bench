---
- name: Task 1: Install and configure Promtail
  assert:
    that:
      - "'systemd' in command('ps -p 1/c')"

- name: Display message if not using systemd
  debug:
    msg: "This module only works with systemd"
  when: "'systemd' not in command('ps -p 1/c')"

- name: Task 2: Retrieve the latest release of Promtail
  uri:
    url: https://api.github.com/repos/grafana/promtail/releases/latest
    method: GET
    return_content: yes
    status_code: 200
  register: promtail_release
  when: "'systemd' in command('ps -p 1/c')"

- name: Task 3: Set the Promtail version to the latest release
  set_fact:
    promtail_version: "{{ promtail_release.json.tag_name }}"

