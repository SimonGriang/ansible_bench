---
- name: Install mysql
  package:
    name: mysql-server
    state: present

- name: Configure mysql server
  template:
    src: mysql-server.conf.j2
    dest: /etc/mysql/mysql-server.conf.d/99-configuration.conf

- name: Configure mysql client
  template:
    src: mysql-client.conf.j2
    dest: /etc/mysql/conf.d/99-client.conf

- name: Initialize mysql
  command: mysql_install_db

- name: Start and enable mysql
  systemd:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  copy:
    src: my.cnf
    dest: /etc/mysql/my.cnf

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop:
    - database1
    - database2

- name: List databases
  command: mysql -u root -p{{ mysql_root_password }} -e "SHOW DATABASES;"
  register: list_databases
  failed_when: "'information_schema' not in list_databases.stdout and 'mysql' not in list_databases.stdout"

- name: Import database
  mysql_db:
    name: "{{ item.0 }}"
    state: import
    target: "{{ item.1 }}"
  loop:
    - ['database1', '/path/to/database1.sql']
    - ['database2', '/path/to/database2.sql']

- name: Create users
  mysql_user:
    name: "{{ item.username }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
  loop:
    - { username: 'user1', host: 'localhost', password: 'password1', privileges: 'database1.*:ALL' }
    - { username: 'user2', host: '%', password: 'password2', privileges: 'database2.*:ALL' }

- name: Flush handlers again
  meta: flush_handlers

