    regexp: '^Password'
    line: 'Password --unrestricted {{ password }}'

- name: password | Add --unrestricted
  replace:
    path: /boot/grub/grub.cfg
    regexp: '^(Password --? )'
    replace: '\g<1>--unrestricted '

