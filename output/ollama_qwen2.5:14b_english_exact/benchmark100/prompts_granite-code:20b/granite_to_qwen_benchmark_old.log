---
- import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  template:
    src: mysql-server.conf.j2
    dest: "{{ mysql_configuration_destination }}"
    owner: root
    group: root
    mode: '0644'
  vars:
    mysql_name: "{{ mysql_name }}"
    mysql_configuration_options: "{{ mysql_configuration_options }}"
    mysql_socket: "{{ mysql_socket }}"

- name: Configure mysql client
  template:
    src: mysql-client.conf.j2
    dest: "{{ mysql_configuration_destination }}"
    owner: root
    group: root
    mode: '0644'
  vars:
    mysql_name: "{{ mysql_name }}"
    mysql_socket: "{{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/.done_initializing

- name: Start and enable mysql
  service:
    name: "{{ mysql_name }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: '0600'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers

