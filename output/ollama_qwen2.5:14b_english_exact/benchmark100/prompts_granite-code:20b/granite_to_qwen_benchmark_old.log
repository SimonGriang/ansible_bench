515, 'eval_count': 453, 'eval_duration': 8859383993, 'model_name': 'qwen2.5:14b'} id='run--43a7b34e-ed7e-4e74-9814-a17a5ab3f200-0' usage_metadata={'input_tokens': 1216, 'output_tokens': 453, 'total_tokens': 1669}
