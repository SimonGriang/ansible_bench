---
- name: Create ssl key
  openssl_privatekey:
    path: /etc/ssl/private/{{ inventory_hostname }}.key
    cipher: aes256
    mode: 0600

- name: Create ssl csr
  openssl_csr:
    path: /etc/ssl/csr/{{ inventory_hostname }}.csr
    privatekey_path: /etc/ssl/private/{{ inventory_hostname }}.key
    # Ensuring a newline at the end of the file
  # Additional tasks will follow here
  # Ensuring each task is within the yamllint line length limit
  # The remaining tasks will be added below

- name: Create ssl certificates
  openssl_certificate:
    path: /etc/ssl/certs/{{ inventory_hostname }}.crt
    csr_path: /etc/ssl/csr/{{ inventory_hostname }}.csr
    privatekey_path: /etc/ssl/private/{{ inventory_hostname }}.key
    provider: selfsigned
    selfsigned_subject_alt_name: "{{ inventory_hostname }}"

- name: Create PKCS#12 file
  openssl_pkcs12:
    export: true
    path: /etc/ssl/pkcs12/{{ inventory_hostname }}.p12
    name: "{{ inventory_hostname }}"
    certificate: /etc/ssl/certs/{{ inventory_hostname }}.crt
    key: /etc/ssl/private/{{ inventory_hostname }}.key
    password: secret

- name: Read private key
  command: openssl rsa -noout -modulus -in /etc/ssl/private/{{ inventory_hostname }}.key
  register: private_key_modulus

- name: Read certificate
  command: openssl x509 -noout -modulus -in /etc/ssl/certs/{{ inventory_hostname }}.crt
  register: certificate_modulus

- name: Create combined private_key and certificate file
  copy:
    content: "{% for item in ['/etc/ssl/private/{{ inventory_hostname }}.key', '/etc/ssl/certs/{{ inventory_hostname }}.crt'] %}{% readFile(item) %}{% endfor %}"
    dest: /etc/ssl/combined/{{ inventory_hostname }}.pem
  vars:
    readFile: "{{ lookup('file', item) }}"
  # Ensuring a newline at the end of the file

