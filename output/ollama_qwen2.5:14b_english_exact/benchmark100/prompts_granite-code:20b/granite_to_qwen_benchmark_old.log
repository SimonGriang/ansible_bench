tion': 9983379289, 'load_duration': 92533744, 'prompt_eval_count': 722, 'prompt_eval_duration': 375859408, 'eval_count': 494, 'eval_duration': 9509040335, 'model_name': 'qwen2.5:14b'} id='run--1e5ecd9c-5f7b-4ce8-8a71-36c7d5e6e2a8-0' usage_metadata={'input_tokens': 722, 'output_tokens': 494, 'total_tokens': 1216}
