---
- name: Install requirements
  yum:
    name: bash
    state: present

- name: Install openjdk java (package)
  yum:
    name: java-1.8.0-openjdk
    state: present

- name: Install RPM
  yum:
    name: rpm
    state: present

- name: Install DEB
  apt:
    name: dpkg
    state: present

- name: Install oracle java (rpm) (repository)
  yum:
    name: oracle-java8-runtime
    state: present

- name: Configure oracle targz
  unarchive:
    src: http://example.com/jdk-8u181-linux-x64.tar.gz
    dest: /usr/java
    remote_src: yes

- name: Install oracle java policy software (targz)
  copy:
    src: http://example.com/java.policy
    dest: /usr/java/jdk1.8.0_181-amd64/jre/lib/security/java.policy
    owner: root
    group: root
    mode: '0644'

- name: Set alternative (targz)
  alternatives:
    name: java
    path: /usr/java/jdk1.8.0_181-amd64/bin/java
    link: /usr/bin/java
    priority: 1
    state: link

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java | sed "s:bin/java::"
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    line: JAVA_HOME={{ java_home_result.stdout }}

