---
- name: Configure apk
  import_tasks: assert.yml

- name: Configure apk
  apk:
    update_cache: yes

- name: Configure apk
  apk:
    upgrade: all

- name: Configure apt
  apt:
    name: "{{ item }}"
    state: present
    upgrade: never
  with_items:
    - package1
    - package2

- name: Configure apt
  apt:
    upgrade: dist

- name: Configure apt
  apt:
    autoremove: yes

- name: Update all software (dnf)
  dnf:
    update: yes
    upgrade_type: system

- name: Update all software (pacman)
  pacman:
    sync:
      - --refresh
      - --sysupgrade

- name: Configure yum
  yum:
    name: "@System"
    state: updated

- name: Configure yum
  yum:
    name: "*"
    state: latest
  when: ansible_distribution_major_version != "6"

- name: Configure yum
  yum:
    name: yum-utils
    state: present

- name: Update all software (zypper)
  zypper:
    name: "@System"
    update: yes

