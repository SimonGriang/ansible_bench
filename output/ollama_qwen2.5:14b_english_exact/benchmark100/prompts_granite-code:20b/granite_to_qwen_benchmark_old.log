---
- name: Install cron
  package:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/crontab
    regexp: '^SHELL='
    line: 'SHELL=/bin/bash'
    create: yes

- name: Configure path
  lineinfile:
    path: /etc/crontab
    regexp: '^PATH='
    line: 'PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin'
    create: yes

- name: Configure mailto
  lineinfile:
    path: /etc/crontab
    regexp: '^MAILTO='
    line: 'MAILTO=root'
    create: yes

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: yes

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    state: present
  with_items: "{{ cron_jobs }}"

