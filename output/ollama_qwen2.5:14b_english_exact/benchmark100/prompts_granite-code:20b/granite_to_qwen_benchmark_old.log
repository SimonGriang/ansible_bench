---
- name: Enable redis module stream (RHEL 8)
  ansible.builtin.yum:
    name: "@Development Tools"
    state: present
  become: yes

- name: Enable redis module stream (RHEL 8)
  ansible.builtin.yum:
    name: redis
    state: enabled
    enablerepo: rhel-server-rhscl
    disablerepo: rhel-server-rhscl
  become: yes
  register: yum_output
  until: yum_output|succeeded
  retries: 3
  delay: 10

- name: Install redis
  ansible.builtin.yum:
    name: redis
    state: present
    enablerepo: rhel-server-rhscl
    disablerepo: rhel-server-rhscl
  become: yes
  register: yum_output
  until: yum_output|succeeded
  retries: 3
  delay: 10

- name: Configure redis
  ansible.builtin.template:
    src: redis.conf.j2
    dest: /etc/redis.conf
    mode: '0644'
  become: yes

- name: Start and enable redis
  ansible.builtin.systemd:
    name: redis
    state: started
    enabled: true
  become: yes

