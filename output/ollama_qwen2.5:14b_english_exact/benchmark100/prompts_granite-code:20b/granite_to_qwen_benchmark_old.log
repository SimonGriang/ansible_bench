  block:
    - name: Test Connection
      ansible.builtin.ping:

    - name: Install Bootstrap Packages
      ansible.builtin.apt:
        name: "{{ packages }}"
        state: present
      when: ansible_os_family == "Debian"

    - name: Install Bootstrap Packages
      ansible.builtin.dnf:
        name: "{{ packages }}"
        state: present
      when: ansible_os_family == "RedHat"


