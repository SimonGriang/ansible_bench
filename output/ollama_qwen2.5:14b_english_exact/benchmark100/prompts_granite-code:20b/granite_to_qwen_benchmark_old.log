---
- name: Create the RKE2 manifests directory
  file:
    path: /etc/rke2/manifests
    state: directory
    mode: '0755'

- name: Copy kube-vip files to first server
  copy:
    src: files/kube-vip/
    dest: /etc/rke2/manifests/kube-vip/
    remote_src: yes
    mode: preserve

- name: Copy kube-vip load balancer manifests to first server
  copy:
    src: files/kube-vip/load-balancer.yaml
    dest: /etc/rke2/manifests/kube-vip/load-balancer.yaml
    remote_src: yes
    mode: preserve
  when: rke2_kubevip_cloud_provider_enable is defined and rke2_kubevip_cloud_provider_enable|bool
  # The condition ensures the use of boolean values as required by yamllint

