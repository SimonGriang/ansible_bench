34725Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13104918655, 'load_duration': 93390362, 'prompt_eval_count': 568, 'prompt_eval_duration': 279223953, 'eval_count': 563, 'eval_duration': 12723132922, 'model_name': 'qwen2.5:14b'} id='run--9d4fa690-b649-400d-8760-d9bfa0585708-0' usage_metadata={'input_tokens': 568, 'output_tokens': 563, 'total_tokens': 1131}
