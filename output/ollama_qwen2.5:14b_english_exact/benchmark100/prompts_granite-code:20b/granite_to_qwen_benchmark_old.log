---
- import_tasks: assert.yml

- name: install logrotate
  apt:
    name: logrotate
    state: present
  become: yes

- name: configure logrotate
  template:
    src: logrotate.conf.j2
    dest: /etc/logrotate.conf

- name: generate logrotate.d files
  template:
    src: logrotate.d.j2
    dest: /etc/logrotate.d/{{ item.name }}
  with_items: "{{ logrotate_files }}"
  become: yes

- name: remove logrotate.d files
  file:
    path: /etc/logrotate.d/{{ item.name }}
    state: absent
  with_items: "{{ logrotate_files_to_remove }}"
  become: yes

- name: start logrotate
  service:
    name: logrotate
    state: started
  become: yes

