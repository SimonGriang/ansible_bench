---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install dns
  ansible.builtin.package:
    name: bind9
    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item['path'] }}"
    state: directory
    mode: "{{ item['mode'] | int }}"
    owner: "{{ item['owner'] }}"
    group: "{{ item['group'] }}"
    attributes: '+t'
  loop:
    - {path: "/etc/bind", mode: "0755", owner: "root", group: "root"}
    - {path: "/var/cache/bind", mode: "0775", owner: "bind", group: "bind"}

- name: Create group
  ansible.builtin.group:
    name: bind
    system: true

- name: Create user
  ansible.builtin.user:
    name: bind
    group: bind
    home: "/nonexistent"
    shell: "/usr/sbin/nologin"

- name: Generate rndc key
  ansible.builtin.command: "rndc-confgen -a -c /etc/bind/rndc.key"
  changed_when: output | search('rndc-confgen')

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: /etc/bind/rndc.key
    mode: "0640"
    owner: root
    group: bind

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "http://www.internic.net/domain/named.root"
    dest: /etc/bind/named.root
    mode: "0644"

- name: Create zone file
  ansible.builtin.template:
    src: "{{ item }}.j2"
    dest: "/etc/bind/zones/{{ item }}"
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: /etc/bind/named.conf
    mode: "0644"

- name: Place systemd override
  ansible.builtin.template:
    src: bind9.service.j2
    dest: /lib/systemd/system/bind9.service.d/override.conf
    mode: "0644"

- name: Start and enable dns
  ansible.builtin.systemd:
    name: bind9
    state: started
    enabled: true

