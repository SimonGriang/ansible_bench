    java_open_jdk_download_url: "http://example.com/{{ ansible_distribution }}/{{ java_jdk_vendor }}/{{ java_open_jdk_version }}/{{ java_open_jdk_version }}-{{ ansible_distribution }}.tar.gz"
    java_open_jdk_home_dir: "/usr/lib/jvm/{{ java_open_jdk_version }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_archive_filename: "{{ java_open_jdk_version }}-{{ ansible_distribution }}-{{ ansible_architecture }}.tar.gz"
    java_open_jdk_binary_filename: "{{ java_open_jdk_version }}-{{ ansible_distribution }}-{{ ansible_architecture }}.tar.gz"

- name: Set specific variables
  set_fact:
    java_open_jdk_version_major: "{{ java_open_jdk_version.split('.')[0] }}"
    java_open_jdk_version_minor: "{{ java_open_jdk_version.split('.')[1] }}"

- name: Add pre-requisites for Debian if ansible_os_family equals Debian
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - software-properties-common
    - ca-certificates
  when: ansible_os_family == 'Debian'

- name: Add pre-requisites for RedHat if ansible_os_family equals RedHat
  yum:
    name: "{{ item }}"
    state: present
  loop:
    - wget
    - ca-certificates
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop:
    - libstdc++-devel
    - zlib-devel
    - libgcc

- name: Install Java, Debian if ansible_os_family equals Debian
  apt:
    name: "{{ java_open_jdk_archive_filename }}"
    state: present
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat if ansible_os_family equals RedHat
  yum:
    name: "{{ java_open_jdk_archive_filename }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  lineinfile:
    path: /etc/environment
    line: "JAVA_HOME=/usr/lib/jvm/{{ java_open_jdk_home_dir }}"
    create: yes

- name: Source environment variables
  lineinfile:
    path: /etc/profile.d/javaenv.sh
    line: "source /etc/environment"
    create: yes

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11 if ansible_os_family equals Debian and java_open_jdk_version_major is less than 11
  copy:
    dest: /usr/bin/java
    content: |
      #!/bin/sh
      /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java "$@"
    mode: 0755
  when: ansible_os_family == 'Debian' and java_open_jdk_version_major|int < 11

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11 if ansible_os_family equals Debian and java_open_jdk_version_major is greater than or equal to 11
  copy:
    dest: /usr/bin/java
    content: |
      #!/bin/sh
      /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java "$@"
    mode: 0755
  when: ansible_os_family == 'Debian' and java_open_jdk_version_major|int >= 11

