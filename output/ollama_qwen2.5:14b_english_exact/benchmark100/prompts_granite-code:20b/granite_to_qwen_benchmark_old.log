---
- import_tasks: assert.yml

- name: Install python pip
  package:
    name: python-pip
    state: present

- name: Configure pip proxy
  ini_file:
    dest: /etc/pip.conf
    section: global
    option: proxy
    value: http://proxy.example.com:3128
    create: yes

- name: Trust hosts
  ini_file:
    dest: /etc/pip.conf
    section: global
    option: trusted-host
    value: pypi.example.org
    create: yes

- name: Update pip
  pip:
    name: pip
    state: latest

- name: Install requested modules
  pip:
    name: "{{ item }}"
    state: present
  with_items: "{{ requested_modules }}"


