content='---\n- name: Install epel\n  when: >\n    (ansible_distribution == "Amazon" and ansible_distribution_major_version == "2") or\n    (ansible_os_family == "RedHat" and ansible_distribution_major_version in ["7", "8", "9", "10"])\n  yum:\n    name: "@epel"\n    state: present\n\n- name: Install epel gpg key\n  rpm_key:\n    key: "{{ epel_gpg_key }}"\n    state: present\n\n- name: Install epel-release\n  package:\n    name: "{{ epel_url }}"\n    state: present\n  notify: update package cache\n\n- name: Install epel-next-release\n  package:\n    name: "{{ epel_next_url }}"\n    state: present\n  when: epel_next|default(false)|bool\n  notify: update package cache' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-12T08:05:11.598814717Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4289561565, 'load_duration': 115226029, 'prompt_eval_count': 470, 'prompt_eval_duration': 129723286, 'eval_count': 180, 'eval_duration': 4035889075, 'model_name': 'qwen2.5:14b'} id='run--e10ed573-a196-44e9-bee6-a4c900466f12-0' usage_metadata={'input_tokens': 470, 'output_tokens': 180, 'total_tokens': 650}
