    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when: item.create_docroot is not defined or item.create_docroot == true
  loop_control:
    label: "Creating docroot directory for {{ item.name }}"

- name: Configure virtual host settings
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify: Test httpd configuration validity
  notify: Restart httpd
  loop_control:
    label: "Configuring virtual host settings for {{ item.name }}"

