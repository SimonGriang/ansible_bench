---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_bash_url }}"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    timeout: "{{ rke2_artifact_fetch_timeout }}"

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    force: yes

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifact_path }}"
    state: directory
    mode: 0700

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 sha256 checksum file
      get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
        mode: 0640
        timeout: "{{ rke2_artifact_fetch_timeout }}"
    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}"
        dest: "{{ rke2_artifact_path }}"
        timeout: "{{ rke2_artifact_fetch_timeout }}"
    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
        timeout: "{{ rke2_artifact_fetch_timeout }}"

- name: Copy local RKE2 artifacts
  when: rke2_airgap_mode is defined and rke2_airgap_mode | bool and rke2_airgap_implementation == "copy"
  copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item }}"
    mode: 0640
    force: yes
  loop: "{{ rke2_artifact_files }}"

- name: Airgap mode - additional images tarballs
  when: rke2_airgap_mode is defined and rke2_airgap_mode | bool and rke2_additional_tarball_images | length > 0
  block:
    - name: Create additional images tarballs folder
      file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: 0700
    - name: Copy additional tarball images RKE2 components
      copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"
        mode: 0644
        force: yes
      loop: "{{ rke2_additional_tarball_images }}"

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  when: rke2_airgap_mode is defined and rke2_airgap_mode | bool and rke2_artifact_files | length > 0
  block:
    - name: Register artifacts and check writeable property
      file:
        path: "{{ rke2_artifact_path }}/{{ item }}"
        state: file
        mode: "{{ item.stat.exists and item.stat.is_writeable | bool | ternary('0640', item.stat.mode) }}"
      loop: "{{ rke2_artifact_files }}"
    - name: Make install script executable if needed
      file:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        state: file
        mode: "{{ rke2_install_script_dir }}/rke2.sh.stat.is_writeable | bool and not rke2_install_script_dir }}/rke2.sh.stat.mode | starts_with('07') | ternary('0700', rke2_install_script_dir }}/rke2.sh.stat.mode }}"
    - name: Fail if install script is not executable
      assert:
        that: "'rke2.sh' in rke2_install_script_dir }}/rke2.sh.stat.mode and rke2_install_script_dir }}/rke2.sh.stat.mode | starts_with('07')"
        msg: "Install script is not executable"

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Check if separate partition
  stat:
    path: /usr/local
    follow: no

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_path }}"
  when: rke2_bin_path is defined

- name: Check RKE2 version
  shell: >
    if command -v rke2 >/dev/null 2>&1; then
      rke2 version --to-stdout
    fi

- name: Prevent accidental RKE2 downgrade
  assert:
    that: rke2_version is version(rke2_current_version, '<=')

- name: Run RKE2 install script
  shell: >
    {{ rke2_install_script_dir }}/rke2.sh install --disable-metrics --write-kubeconfig-mode 644 --node-taint rke2.io/oslinux:NoSchedule --disable-swap-auth --no-upgrade
  when: rke2_airgap_mode is defined and rke2_airgap_mode | bool and rke2_airgap_implementation == "download"
  args:
    environment: "{{ rke2_env_vars | to_nice_yaml }}"
  register: rke2_install_result
  failed_when: rke2_install_result.rc != 0

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_custom_manifests }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_static_pods }}"

- name: Copy RKE2 environment file
  template:
    src: rke2_environment.j2
    dest: /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: 0644

