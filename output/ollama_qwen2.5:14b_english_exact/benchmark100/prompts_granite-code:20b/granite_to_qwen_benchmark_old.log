---
- name: Install Keepalived when HA mode is enabled
  when: ha_mode == 'enabled'
  yum:
    name: keepalived
    state: present

- name: Download and install RKE2 {{ rke2_version }}
  get_url:
    url: "https://get.rke2.io/rke2-install-{{ rke2_version }}.tar.gz"
    dest: /opt/rke2.tar.gz
  register: rke2_install

- name: Apply CIS Benchmark hardening for RKE2
  command: /usr/local/bin/rke2-cis-check.sh
  args:
    creates: /etc/rke2/cis-hardening.yaml

- name: Find the active server in the cluster
  shell: kubectl get nodes -o json | jq -r '.items[] | select(.metadata.labels."node-role.kubernetes.io/master" != null) | .metadata.name'
  register: active_server

- name: Enable the IPVS kernel module for kube-vip load balancer
  shell: modprobe ip_vs

- name: Copy kube-vip manifests to the masternode
  copy:
    src: kube-vip.yaml
    dest: /etc/rke2/kube-vip.yaml

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: ingress-nginx.yaml
    dest: /etc/rke2/ingress-nginx.yaml

- name: Prepare the very first server node in the cluster
  command: rke2 server --update

- name: Restore etcd specific tasks
  block:
    - name: Restore etcd data
      command: rke2 etcd restore --data-dir /var/lib/rancher/rke2/agent/tmp/etcd-backup
      when: etcd_restore_option == 'true'

- name: Download kubeconfig to ansible localhost
  get_url:
    url: "http://{{ active_server.stdout }}:8080/kubeconfig"
    dest: /tmp/kubeconfig

- name: Prepare and join remaining nodes of the cluster
  command: rke2 agent --server {{ active_server.stdout }}:8080 --token {{ rke2_token }}

- name: Perform rolling restart of servers when the version changes
  block:
    - name: Cordon and drain server node
      kubectl:
        command: drain
        namespace: "{{ item }}"
        node: "{{ item }}"
        delete-local-data: yes
        ignore-daemonsets: yes
      loop: "{{ server_nodes }}"
    - name: Restart server node
      command: systemctl restart rke2-server
      loop: "{{ server_nodes }}"
    - name: Uncordon server node
      kubectl:
        command: uncordon
        node: "{{ item }}"
        namespace: "{{ item }}"
      loop: "{{ server_nodes }}"

- name: Perform rolling restart of agents when the version changes
  block:
    - name: Cordon and drain agent node
      kubectl:
        command: drain
        namespace: "{{ item }}"
        node: "{{ item }}"
        delete-local-data: yes
        ignore-daemonsets: yes
      loop: "{{ agent_nodes }}"
    - name: Restart agent node
      command: systemctl restart rke2-agent
      loop: "{{ agent_nodes }}"
    - name: Uncordon agent node
      kubectl:
        command: uncordon
        node: "{{ item }}"
        namespace: "{{ item }}"
      loop: "{{ agent_nodes }}"

- name: Flush handlers
  meta: flush_handlers

- name: Perform rolling restart of cluster nodes when configuration files change
  block:
    - name: Cordon and drain node
      kubectl:
        command: drain
        namespace: "{{ item }}"
        node: "{{ item }}"
        delete-local-data: yes
        ignore-daemonsets: yes
      loop: "{{ cluster_nodes }}"
    - name: Restart node
      command: systemctl restart rke2-server
      when: item in server_nodes
      loop: "{{ cluster_nodes }}"
    - name: Restart node
      command: systemctl restart rke2-agent
      when: item in agent_nodes
      loop: "{{ cluster_nodes }}"
    - name: Uncordon node
      kubectl:
        command: uncordon
        node: "{{ item }}"
        namespace: "{{ item }}"
      loop: "{{ cluster_nodes }}"

- name: Perform final steps and summary of the playbook
  command: rke2 status

