---
- name: Load OS-specific vars
  include_vars: "{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yaml"

- name: Install Docker packages
  package:
    name: "{{ item }}"
    state: present
  loop:
    - "{{ docker_packages[:80] }}"  # Truncated for line length
  vars:
    ansible_loop_label: "{{ item[:80] }}"  # Truncated for line length

- name: Install docker-compose plugin
  become: yes
  command: docker plugin install pcelotto/docker-compose:latest --grant-all-permissions

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: '0755'

- name: Configure Docker daemon options
  template:
    src: docker-daemon.json.j2
    dest: /etc/docker/daemon.json

- name: Ensure Docker is started and enabled at boot
  systemd:
    name: docker
    state: started
    enabled: true

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Ensure docker-compose is installed
  become: yes
  command: curl -L https://github.com/docker/compose/releases/download/v2.13.0/docker-compose-$(uname -s)-$(uname -m) -o /usr/local/bin/docker-compose
  args:
    creates: /usr/local/bin/docker-compose

- name: Ensure docker group users are in the docker group
  user:
    name: "{{ item }}"
    groups: docker
    append: true
  loop:
    - "{{ docker_group_users[:80] }}"  # Truncated for line length

