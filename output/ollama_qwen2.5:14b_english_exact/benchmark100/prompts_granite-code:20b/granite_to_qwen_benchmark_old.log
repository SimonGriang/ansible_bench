  file:
    path: /etc/security/limits.d/20-disable-core.conf
    state: touch
  block:
    - name: Add no core dumps limits
      lineinfile:
        path: /etc/security/limits.d/20-disable-core.conf
        line: "* hard core 0"
        create: true
    - name: Ensure core pattern is empty
      copy:
        content: "core_pattern=\n"
        dest: /etc/sysctl.d/50-disable-core.conf
      notify: Apply sysctl config

- name: Disable Shell Command History
  block:
    - name: Set history size to zero
      lineinfile:
        path: /etc/bash.bashrc
        regexp: '^HISTSIZE='
        line: 'HISTSIZE=0'
        backup: true
    - name: Set history file to /dev/null
      lineinfile:
        path: /etc/bash.bashrc
        regexp: '^HISTFILE='
        line: 'HISTFILE=/dev/null'
        backup: true
    - name: Set history size to zero in .bashrc
      lineinfile:
        path: /etc/bash.bashrc
        regexp: '^HISTSIZE='
        line: 'HISTSIZE=0'
        backup: true
    - name: Set history file to /dev/null in .bashrc
      lineinfile:
        path: /etc/bash.bashrc
        regexp: '^HISTFILE='
        line: 'HISTFILE=/dev/null'
        backup: true

