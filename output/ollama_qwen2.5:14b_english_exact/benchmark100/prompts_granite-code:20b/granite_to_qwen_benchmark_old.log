---
- import_tasks: assert.yml

- name: Install cron
  package:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/passwd
    regexp: '^(.*?)::'
    line: '\1:!/usr/bin/false'
    owner: root
    group: root
    mode: '0644'

- name: Configure path
  lineinfile:
    path: /etc/environment
    line: 'PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"'
    create: yes
    owner: root
    group: root
    mode: '0644'

- name: Configure mailto
  lineinfile:
    path: /etc/aliases
    line: 'root:    user@example.com'
    create: yes
    owner: root
    group: root
    mode: '0644'

- name: Start and enable cron
  systemd:
    name: cron
    state: started
    enabled: yes

- name: Schedule requested cron jobs
  cron:
    name: "Scheduled backup"
    minute: "0"
    hour: "3"
    job: "/usr/local/bin/backup.sh"
    state: present

