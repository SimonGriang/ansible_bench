---
- name: Download RKE2 kubeconfig to localhost
  get_url:
    url: "https://{{ groups[rke2_servers_group_name][0] }}:6443/loadbalancer/kubeconfig"
    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    flat: yes
  when: rke2_download_kubeconf == true and inventory_hostname == groups[rke2_servers_group_name][0]

- name: Replace loopback IP by master server IP
  replace:
    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    regexp: '127\\.0\\.0\\.1|\\[::1\\]'
    replace: "{{ rke2_api_ip|default(groups[rke2_servers_group_name][0].ansible_host) }}"
    delegate_to: localhost
    become: false
  when: not ansible_check_mode and rke2_download_kubeconf == true and inventory_hostname == groups[rke2_servers_group_name][0]

