---
- import_tasks: assert.yml

- name: Install the Vault prerequisites
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - systemd
    - unzip

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_tasks }}"

- name: Add Vault environment variables
  lineinfile:
    path: /etc/environment
    line: "{{ item }}"
    create: yes
  loop: "{{ vault_environment_vars }}"

- name: Include hardening tasks
  include_tasks: hardening.yml

- name: Start and enable vault
  systemd:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable vault
  systemd:
    name: vault
    enabled: yes
  when: vault_type != "oss"

