    path: /etc/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  when: inventory_hostname in groups['rke2_servers']
  lineinfile:
    path: /etc/rke2/config.yaml
    regexp: '^#?\\s+taints:'
    line: 'taints: [\'node-role.kubernetes.io/master=:noSchedule\']'

- name: Set agent taints
  when: inventory_hostname in groups['rke2_agents']
  lineinfile:
    path: /etc/rke2/config.yaml
    regexp: '^#?\\s+taints:'
    line: 'taints: [\'node-role.kubernetes.io/worker=:noSchedule\']'

- name: Copy RKE2 config
  copy:
    src: /path/to/source/rke2-config.yaml
    dest: /etc/rke2/config.yaml
    mode: '0644'

- name: Copy kubelet config
  copy:
    src: /path/to/source/kubelet-config.yaml
    dest: /etc/rke2/kubelet.yaml
    mode: '0644'
  when: lookup('file', '/path/to/source/kubelet-config.yaml', errors='quiet') is defined

- name: Copy Containerd Registry Configuration file
  copy:
    src: /path/to/source/containerd-registry-config.toml
    dest: /etc/rke2/containerd/config.toml
    mode: '0644'
  when: lookup('file', '/path/to/source/containerd-registry-config.toml', errors='quiet') is defined

- name: Start RKE2 service on the rest of the nodes
  service:
    name: rke2-server
    state: started
  when: inventory_hostname not in groups['rke2_bootstrap']

- name: Mask other RKE2 service on the rest of the nodes
  service:
    name: rke2-agent
    state: masked
  when: inventory_hostname not in groups['rke2_agents']

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    path: /var/lib/rancher/rke2/agent/kubelet.conf
    state: present
  when: not cni_used

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    path: /var/lib/rancher/rke2/agent/kubelet.conf
    state: present
  when: cni_used


