- name: Install epel gpg key
  rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install epel-release
  package:
    name: "{{ epel_url }}"
    state: present
  notify: update_package_cache

- name: Install epel-next-release
  when: epel_next|default(false)|bool
  package:
    name: "{{ epel_next_url }}"
    state: present
  notify: update_package_cache


