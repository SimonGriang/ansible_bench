---
- import_tasks: assert.yml
- name: Install apache httpd
  yum:
    name: httpd
    state: present
  when: ansible_os_family == "RedHat"
- name: Install apache httpd
  apt:
    name: apache2
    state: present
  when: ansible_os_family == "Debian"
- name: Configure selinux
  selinux:
    policylabel: targeted
    state: enabled
    type: boolean
  when: ansible_os_family == "RedHat"
- name: Configure httpd
  template:
    src: httpd.conf.j2
    dest: /etc/httpd/conf/httpd.conf
  when: ansible_os_family == "RedHat"
- name: Activate httpd module | Debian
  lineinfile:
    path: /etc/apache2/mods-available/mpm_prefork.load
    line: 'LoadModule mpm_prefork_module /usr/lib/apache2/modules/mod_mpm_prefork.so'
    create: yes
  when: ansible_os_family == "Debian"
- import_tasks: ssl.yml
- import_tasks: locations.yml
- import_tasks: vhosts.yml
- name: Configure ports
  firewalld:
    service: http
    permanent: yes
    state: enabled
    zone: public
  when: ansible_os_family == "RedHat"
- import_tasks: directories.yml
- meta: flush_handlers
- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: ansible_os_family == "RedHat"
- name: Start and enable httpd
  service:
    name: httpd
    state: started
    enabled: yes
  when: ansible_os_family == "RedHat"
- name: Start and enable httpd
  service:
    name: apache2
    state: started
    enabled: yes
  when: ansible_os_family == "Debian"

