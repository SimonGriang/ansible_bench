---
- name: Task 1: Check if certificates exists
  stat:
    path: /path/to/certificates
  register: cert_check

- name: Task 2: Fail if some cert doesn't exist
  fail:
    msg: "Certificate does not exist at /path/to/certificates"
  when: not cert_check.stat.exists

- name: Task 3: Setting keystore variables in java < 11
  set_fact:
    keystore_path: "/path/to/java-keystore.jks"
    keystore_pass: "{{ keystore_password }}"
  when: ansible_facts.java.version < "11"

- name: Task 4: Setting keystore variables in java >= 11
  set_fact:
    keystore_path: "/path/to/java-keystore.p12"
    keystore_pass: "{{ keystore_password }}"
  when: ansible_facts.java.version >= "11"

- name: Task 5: Import SSL certificates
  command: /usr/java/default/bin/keytool -importcert -file /path/to/certificates.pem -keystore "{{ keystore_path }}" -storepass "{{ keystore_pass }}"
  args:
    creates: /path/to/certificates.pem.imported
  register: import_cert_result
  when: ansible_facts.java.version is version("11", ">=")

