---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/bin/python3.11-EXTERNALLY-MANAGED
  register: python3_11_managed_file

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  file:
    src: /usr/bin/python3.11-EXTERNALLY-MANAGED
    dest: /usr/bin/python3.11-EXTERNALLY-MANAGED.bak
    state: link
  when: python3_11_managed_file.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/bin/python3.12-EXTERNALLY-MANAGED
  register: python3_12_managed_file

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  file:
    src: /usr/bin/python3.12-EXTERNALLY-MANAGED
    dest: /usr/bin/python3.12-EXTERNALLY-MANAGED.bak
    state: link
  when: python3_12_managed_file.stat.exists

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install python pip
  apt:
    name: python3-pip
    state: present
  when: ansible_facts.packaging.system == 'apt'

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    line: 'trusted-host=HOSTNAME'
    create: yes
  vars:
    hostname: "HOSTNAME"

- name: Trust hosts
  shell: echo -e "[trusted-host]\nHOSTNAME" > /root/.pip/pip.conf
  vars:
    hostname: "HOSTNAME"
  args:
    creates: /root/.pip/pip.conf

- name: Update pip.
  pip:
    name: pip
    state: latest

- name: Install requested modules
  pip:
    requirements: requirements.txt
    state: present

