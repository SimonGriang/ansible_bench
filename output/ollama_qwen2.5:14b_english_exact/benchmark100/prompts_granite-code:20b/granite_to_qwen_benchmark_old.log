---
- name: Create the RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  ansible.builtin.set_fact:
    k8s_server_taints: "{{ rke2_server_node_taints }}"

- name: Copy rke2 config
  ansible.builtin.copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0600'

- name: Copy kubelet config
  ansible.builtin.copy:
    src: "{{ rke2_kubelet_config_src }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0600'
  when: rke2_kubelet_config is not empty

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ rke2_containerd_registry_config_src }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0600'
  when: rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty

- name: Register if we need to do a etcd restore from file
  ansible.builtin.set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file is not none and rke2_etcd_snapshot_file != '' and rke2_etcd_snapshot_file != 'None' and rke2_etcd_snapshot_file != 'none' and (rke2_etcd_snapshot_file.stat.exists or (rke2_etcd_snapshot_file.stat.path.stat.exists if rke2_etcd_snapshot_file.stat.path is defined) or (rke2_etcd_snapshot_file.stat.path.stat.exists if rke2_etcd_snapshot_file.stat.path.stat is defined)) and (rke2_etcd_snapshot_file.stat.path.stat.exists if rke2_etcd_snapshot_file.stat.path is defined) }}"
  when: rke2_etcd_snapshot_file.stat.exists or (rke2_etcd_snapshot_file.stat.path.stat.exists if rke2_etcd_snapshot_file.stat.path is defined)

- name: Register if we need to do a etcd restore from s3
  ansible.builtin.set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined }}"
  when: rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create the RKE2 etcd snapshot directory
      ansible.builtin.file:
        path: /var/lib/rancher/rke2/agent/snapshots
        state: directory
        mode: '0750'
    - name: Copy the etcd snapshot file
      ansible.builtin.copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/snapshots/etcd-snapshot.bin
        mode: '0600'
    - name: Restore etcd from the snapshot
      ansible.builtin.shell: rke2 server etcd snapshot restore /var/lib/rancher/rke2/agent/snapshots/etcd-snapshot.bin
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  ansible.builtin.shell: rke2 server etcd snapshot restore s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }} --access-key {{ rke2_etcd_snapshot_s3_options.access_key }} --secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }}
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  ansible.builtin.service:
    name: rke2-server
    state: started
    enabled: yes

- name: Mask RKE2 agent service on the first server
  ansible.builtin.service:
    name: rke2-agent
    state: masked

- name: Wait for the first server be ready - no CNI
  ansible.builtin.wait_for:
    timeout: 600
    path: /var/lib/rancher/rke2/data/*/ready
    state: true
    sleep: 30
    delay: 10
    module_args:
      - stat.stat.exists
      - stat.stat.size > 0
