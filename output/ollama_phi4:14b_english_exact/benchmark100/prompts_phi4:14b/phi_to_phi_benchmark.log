---
- name: Remove obsolete Docker packages
  package:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Add Docker GPG key
  when: docker_add_repo
  apt_key:
    url: "{{ docker_yum_gpg_key }}"
    state: present

- name: Add Docker repository
  when: docker_add_repo
  yum_repository:
    name: docker-{{ docker_edition }}
    description: Docker Repository
    baseurl: "{{ docker_yum_repo_url }}"
    gpgcheck: yes
    gpgkey: "{{ docker_yum_gpg_key }}"
    enabled: yes
    state: present

- name: Configure Docker Nightly repo
  when: docker_add_repo
  lineinfile:
    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    regexp: '^(\s*)\[(.*)\]\s*'
    line: '\1[{{ docker_edition }}-nightly]\n\1name=Docker {{ docker_edition }} Nightly\n\1baseurl={{ docker_yum_repo_url }}/nightly\n\1gpgcheck=1\n\1gpgkey={{ docker_yum_gpg_key }}\n\1enabled={{ "1" if docker_yum_repo_enable_nightly else "0" }}'
    state: present

- name: Configure Docker Test repo
  when: docker_add_repo
  lineinfile:
    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    regexp: '^(\s*)\[(.*)\]\s*'
    line: '\1[{{ docker_edition }}-test]\n\1name=Docker {{ docker_edition }} Test\n\1baseurl={{ docker_yum_repo_url }}/test\n\1gpgcheck=1\n\1gpgkey={{ docker_yum_gpg_key }}\n\1enabled={{ "1" if docker_yum_repo_enable_test else "0" }}'
    state: present

- name: Configure containerd on RHEL 8
  when: ansible_distribution_major_version == "8"
  block:
    - name: Ensure runc is not installed
      package:
        name: runc
        state: absent

    - name: Ensure container-selinux is installed
      package:
        name: container-selinux
        state: present

    - name: Ensure containerd.io is installed
      package:
        name: containerd.io
        state: present


