---
- name: Import additional tasks from assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Enable Redis module for RHEL 8
  dnf:
    name: "@redis"
    state: present
  when: ansible_facts['os_family'] == "RedHat" and ansible_facts['distribution_major_version'] == "8"

- name: Install Redis packages
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure Redis with a template
  template:
    src: redis.conf.j2
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart Redis

- name: Start and enable Redis service
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true

handlers:
  - name: Restart Redis
    service:
      name: "{{ redis_service }}"
      state: restarted


