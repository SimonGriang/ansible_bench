- name: Collect OS release information from bootstrap server
  ansible.builtin.command:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"
  run_once: true
  delegate_to: "{{ bootstrap_server }}"
  changed_when: false

- name: Set bootstrap facts for distribution and major version
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_search('PRETTY_NAME=\"([^\"]*)', '\\1') | regex_replace('.*?([^-]+).*', '\\1') }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search('PRETTY_NAME=\"([^\"]*)', '\\1') | regex_replace('.*?([^-]+)-([^-]+).*', '\\2') }}"
  when: 
    - bootstrap_facts.rc == 0
    - not bootstrap_distribution
    - bootstrap_facts.stdout is match('PRETTY_NAME="[^"]*"')
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

- name: Set bootstrap facts for the OS family
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.value }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: 
    - bootstrap_distribution is defined
    - bootstrap_distribution in item.key
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"


