---
- name: Execute assert.yml task file
  import_tasks: assert.yml
  hosts: localhost
  gather_facts: no

- name: Install required packages for OpenSSL
  package:
    name: "{{ openssl_requirements }}"
    state: present

- name: Install pip packages if openssl_pip_packages is defined and not empty
  pip:
    name: "{{ openssl_pip_packages }}"
    state: present
  when: openssl_pip_packages is defined and openssl_pip_packages | length > 0

- name: Create directory for OpenSSL keys with specific permissions and ownership
  file:
    path: "{{ openssl_key_dir }}"
    state: directory
    mode: '0700'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create directory for OpenSSL CSRs with specific permissions and ownership
  file:
    path: "{{ openssl_csr_dir }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create directory for OpenSSL certificates with specific permissions and ownership
  file:
    path: "{{ openssl_cert_dir }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include create.yml task file for each item in openssl_items if defined and not empty
  import_tasks: create.yml
  with_items: "{{ openssl_items }}"
  when: openssl_items is defined and openssl_items | length > 0


