- name: Loop through the users variable and include tasks from user.yml for each user
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    loop_var: user_name
    label: "{{ user_name }}"
  tags:
    - user_accounts

- name: Manage cron permissions by creating or updating /etc/cron.allow with a template
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow | bool
  tags:
    - cron_permissions

- name: Remove the /etc/cron.allow file if cron permissions are not required
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow | bool
  tags:
    - cron_no_permissions


