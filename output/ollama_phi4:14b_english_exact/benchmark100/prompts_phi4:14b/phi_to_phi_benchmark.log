  register: helm_check

- name: Retrieve the current Helm version installed on the system
  command: "{{ helm_bin_path }} version --short"
  register: helm_existing_version
  failed_when: false
  changed_when: false

- name: Download the specified version of Helm if it does not exist or if the version is outdated
  unarchive:
    src: "{{ helm_repo_path }}"
    dest: /usr/local/bin
    remote_src: yes
  register: helm_download
  when: not helm_check.stat.exists or helm_existing_version.stdout != "version.BuildVersion {{ helm_version }}"

- name: Install the downloaded Helm binary in the appropriate location
  copy:
    src: "/usr/local/bin/helm"
    dest: "{{ helm_bin_path }}"
    mode: '0755'
  become: true
  when: helm_download is changed


