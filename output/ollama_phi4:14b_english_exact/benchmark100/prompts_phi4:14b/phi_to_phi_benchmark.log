---
- name: Check if Python is installed on the system
  ansible.builtin.command: which python
  register: python_path
  ignore_errors: true
  changed_when: false

- name: Check if Python3 is installed on the system
  ansible.builtin.command: which python3
  register: python3_path
  ignore_errors: true
  changed_when: false

- name: Debug the Python executable path
  ansible.builtin.debug:
    msg: "Python path: {{ python_path.stdout }}"
  when: python_path.stdout != ""

- name: Debug the Python3 executable path
  ansible.builtin.debug:
    msg: "Python3 path: {{ python3_path.stdout }}"
  when: python3_path.stdout != ""

- name: Import additional assertions
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install OpenSSL requirements
  ansible.builtin.package:
    name: "{{ openssl_requirements }}"
    state: present

- name: Ensure Python3 packaging is available via dnf
  ansible.builtin.package:
    name: python3-packaging
    state: present

- name: Install pip packages for OpenSSL
  ansible.builtin.pip:
    name: "{{ openssl_pip_packages }}"
    state: present

- name: Create a directory for OpenSSL keys
  ansible.builtin.file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: '0750'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create a directory for OpenSSL CSR files
  ansible.builtin.file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create a directory for OpenSSL certificate files
  ansible.builtin.file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: '0755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include tasks to create OpenSSL items
  ansible.builtin.include_tasks: create.yml
  when: openssl_items is defined and openssl_items | length > 0
  loop: "{{ openssl_items }}"
  loop_control:
    label: "{{ item }}"


