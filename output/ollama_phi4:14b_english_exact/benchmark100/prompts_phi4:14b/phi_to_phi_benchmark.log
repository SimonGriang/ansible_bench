---
- name: Restart the RKE2 service
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  ansible.builtin.shell: >
    kubectl get nodes --no-headers | grep ' Ready ' | wc -l
  register: ready_nodes_count
  until: ready_nodes_count.stdout | int == groups[rke2_cluster_group_name] | length
  retries: 100
  delay: 15
  delegate_to: "{{ groups['rke2_cluster_group_name'][0] }}"
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  ansible.builtin.shell: >
    kubectl get pods --all-namespaces --field-selector=status.phase!=Pending -o jsonpath='{.items[*].status.phase}' | grep -e 'Running' -e 'Succeeded' | wc -l
  register: ready_pods_count
  until: ready_pods_count.stdout | int == (lookup('ansible.builtin.shell', 'kubectl get pods --all-namespaces --no-headers | wc -l') | int)
  retries: 100
  delay: 15
  delegate_to: "{{ groups['rke2_cluster_group_name'][0] }}"
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready is defined


