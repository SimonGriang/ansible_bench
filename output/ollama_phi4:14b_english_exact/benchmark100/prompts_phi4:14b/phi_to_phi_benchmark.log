---
- name: Determine if the system is EFI
  stat:
    path: /sys/firmware/efi
  register: efi_check

- name: Remove unwanted grub.cfg for EFI systems
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_check.stat.exists

- name: Install a user template for Grub
  template:
    src: user_template.j2
    dest: /etc/grub.d/40_custom
    owner: root
    group: root
    mode: '0644'
  notify: update grub

- name: Add a password to the EFI Grub configuration
  lineinfile:
    path: /etc/grub2-efi.cfg
    line: "set superusers=\"user\""
    create: yes
  when: efi_check.stat.exists
  notify: update grub

- name: Add a password to the MBR Grub configuration
  lineinfile:
    path: /etc/grub2.cfg
    line: "set superusers=\"user\""
    create: yes
  when: efi_check.stat.exists
  notify: update grub

- name: Modify files to add --unrestricted class
  lineinfile:
    path: "{{ item }}"
    regexp: '^CLASS=\"(.*)\"'
    line: 'CLASS="\1 --unrestricted"'
    backrefs: yes
  loop:
    - /path/to/file1
    - /path/to/file2
  notify: update grub

- name: Update grub
  command: grub2-mkconfig -o /boot/grub2/grub.cfg
  when: efi_check.stat.exists or item.changed
  loop: "{{ ansible_play_hosts }}"
  loop_control:
    label: "{{ item }}"


