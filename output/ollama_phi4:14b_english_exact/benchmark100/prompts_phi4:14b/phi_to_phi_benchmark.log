erride.conf\n        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"\n\n    - name: Reload systemd\n      systemd:\n        daemon_reload: yes\n  when: service_manager == \'systemd\'\n\n- name: Start and enable the DNS service\n  service:\n    name: "{{ dns_service }}"\n    state: started\n    enabled: yes\n```\n\nThis Ansible Playbook is structured to be included in an Ansible Role, specifically within the `tasks/` directory. It adheres to the instructions provided and uses the specified task names and module calls.' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-14T21:56:37.090932459Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10156778785, 'load_duration': 61017138, 'prompt_eval_count': 750, 'prompt_eval_duration': 247316238, 'eval_count': 621, 'eval_duration': 9847559787, 'model_name': 'phi4:14b'} id='run--1ab33ecb-c346-47f3-a0b1-2268a96db0b1-0' usage_metadata={'input_tokens': 750, 'output_tokens': 621, 'total_tokens': 1371}
