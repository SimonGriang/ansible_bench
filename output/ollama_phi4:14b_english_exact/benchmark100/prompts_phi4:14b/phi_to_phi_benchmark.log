---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    dest: /etc/crontab
    regexp: '^SHELL=.*'
    line: "SHELL={{ cron_shell }}"
    state: present
  notify: restart cron

- name: Configure path
  lineinfile:
    dest: /etc/crontab
    regexp: '^PATH=.*'
    line: "PATH={{ cron_path }}"
    state: present
  notify: restart cron

- name: Configure mailto
  lineinfile:
    dest: /etc/crontab
    regexp: '^MAILTO=.*'
    line: "MAILTO={{ cron_mailto }}"
    state: present
  notify: restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service | length > 0

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    user: "{{ item.user | default(omit) }}"
    special_time: "{{ item.special_time | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    minute: "{{ item.minute | default(omit) }}"
    state: present
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined


