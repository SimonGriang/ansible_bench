- name: Ensure necessary directories for the HTTP server are created
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_directories }}"

- name: Configure HTTP server directories
  ansible.builtin.template:
    src: directory.conf.j2
