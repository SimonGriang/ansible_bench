---
- name: Check if all necessary variables have been set correctly
  import_tasks: assert_variables.yml
  delegate_to: localhost

- name: Wait for the host to become available if specified in the configuration
  wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ wait_port | default(22) }}"
  when: 
    - ansible_connection != 'container'
    - wait_for_host | default(false)
  connection: local
  become: "{{ use_become | default(false) }}"

- name: Prepare the system by ensuring connectivity and installing necessary packages
  block:
    - name: Test the connection to the host
      setup:
      register: connection_result

    - name: Provide a debug message if connection fails
      debug:
        msg: "Connection to the host timed out after {{ ansible_timeout }} seconds."
      when: connection_result is failed

    - name: Gather facts about the host
      setup:

    - name: Install necessary packages using raw commands or Ansible's package module
      package:
        name: "{{ package_list }}"
        state: latest
      when: ansible_os_family == 'RedHat'
    - name: Install necessary packages using apt for Debian-based systems
      apt:
        name: "{{ package_list }}"
        state: latest
      when: ansible_os_family == 'Debian'
  become: "{{ use_become | default(false) }}"

- name: Ensure the system is fully prepared by executing necessary Ansible modules
  block:
    - name: Gather Ansible facts
      setup:

    - name: Ensure required packages are updated and present on the system
      package:
        name: "{{ package_list }}"
        state: latest


