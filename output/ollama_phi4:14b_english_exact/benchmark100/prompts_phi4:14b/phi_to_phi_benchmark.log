---
- name: Ensure document root directories for HTTP virtual hosts are created
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: "{{ item.documentroot_mode | default('0755') }}"
  loop: "{{ httpd_vhosts }}"
  when: 
    - httpd_vhosts is defined
    - item.documentroot is defined
    - item.create_docroot | default(true)

- name: Configure virtual host configuration files using templates
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.servername }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify:
    - test httpd configuration
    - restart httpd

- name: Enable virtual hosts on Debian-based systems
  ansible.builtin.command:
    argv:
      - a2ensite
      - "{{ item.servername }}.conf"
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian'
  notify:
    - test httpd configuration
    - restart httpd

handlers:
  - name: test httpd configuration
    ansible.builtin.command:
      argv: ['apachectl', 'configtest']

  - name: restart httpd
    ansible.builtin.service:
      name: httpd
      state: restarted


