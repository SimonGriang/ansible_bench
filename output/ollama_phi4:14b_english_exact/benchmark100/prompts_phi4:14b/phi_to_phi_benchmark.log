- name: Handle additional tarballs in airgap mode if not using 'exists' implementation
  block:
    - name: Create directory for additional images tarballs
      file:
        path: /path/to/rke2/additional
        state: directory
        mode: '0755'
      when: rke2_airgap_mode and rke2_airgap_implementation != 'exists' and rke2_airgap_copy_additional_tarballs | length > 0

    - name: Copy additional images tarballs
      copy:
        src: /path/to/local/{{ item }}
        dest: /path/to/rke2/additional/{{ item }}
        mode: '0644'
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"
      when: rke2_airgap_mode and rke2_airgap_implementation != 'exists'

- name: Ensure artifacts exist and have acceptable permissions in airgap mode with 'exists' implementation
  block:
    - name: Check and set permissions for RKE2 artifacts
      file:
        path: /path/to/rke2/{{ item }}
        mode: '0644'
      loop:
        - artifact.tar.gz
        - checksum.txt

    - name: Ensure the installation script is executable
      file:
        path: /usr/local/bin/install-rke2.sh
        mode: '0755'

  when: rke2_airgap_mode and rke2_airgap_implementation == 'exists'

- name: Populate service facts to gather information about system services
  service_facts:

- name: Get filesystem statistics for the /usr/local directory
  stat:
    path: /usr/local
  register: local_fs_stats

- name: Check if /usr/local is on a separate partition
  shell: grep -q '/usr/local /usr/local' /proc/mounts
  register: local_separate_partition
  changed_when: false

- name: Determine the RKE2 binary path based on filesystem checks
  set_fact:
    rke2_binary_path: >-
      {{ '/usr/local/bin' if local_fs_stats.stat.pw_name == 'root' and
      local_separate_partition.rc == 0 else '/var/lib/rancher' }}

- name: Check the installed and running RKE2 versions
  block:
    - name: Get installed RKE2 version
      shell: /usr/local/bin/rke2-server --version
      register: installed_version

    - name: Get running RKE2 version
      shell: systemctl show -p ActiveState=rke2-server
      register: running_version

    - name: Output versions in JSON format
      json_output:
        installed_version: "{{ installed_version.stdout }}"
        running_version: "{{ running_version.stdout }}"

- name: Set RKE2 version facts based on the version check results
  set_fact:
    rke2_installed_version: "{{ installed_version.stdout }}"
    rke2_running_version: "{{ running_version.stdout }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade unless explicitly allowed
  assert:
    that:
      - rke2_desired_version <= rke2_running_version or rke2_allow_downgrade | default(false)
    fail_msg: "Downgrade of RKE2 is not allowed unless explicitly permitted."

- name: Run RKE2 install script if the version needs to be updated
  block:
    - name: Set environment variables for installation
      set_fact:
        env_vars: >-
          {{ {'RANCHER_URL': 'https://rancher.example.com'} | combine(
          {'RKE2_URL': 'https://github.com/rancher/rke2'}) }}

    - name: Run installation script for non-airgap
      shell: /usr/local/bin/install-rke2.sh
      environment: "{{ env_vars }}"
      when: not rke2_airgap_mode

    - name: Run installation script for airgap
      shell: /usr/local/bin/install-rke2.sh --airgap-mode
      environment: "{{ env_vars }}"
      when: rke2_airgap_mode

  when: rke2_installed_version != rke2_desired_version

- name: Copy custom manifests if they are defined
  copy:
    src: /path/to/local/custom_manifests/{{ item }}
    dest: /etc/rancher/rke2/manifests/{{ item }}
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy static pods if they are defined
  copy:
    src: /path/to/local/static_pods/{{ item }}
    dest: /var/lib/rancher/rke2/server/manifests/{{ item }}
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file if environment options are defined
  copy:
    src: /path/to/local/rke2_env_file.env
    dest: /etc/rancher/rke2/config.yaml
  when: rke2_environment_options | length > 0


