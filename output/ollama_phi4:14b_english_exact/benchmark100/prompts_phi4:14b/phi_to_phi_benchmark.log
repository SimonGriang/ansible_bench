---
- name: Create SSL key for each item
  community.crypto.openssl_privatekey:
    path: "{{ item.ssl_key_path }}"
    type: rsa
    size: 2048
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ ssl_items }}"

- name: Create SSL CSR for each item
  community.crypto.openssl_csr:
    path: "{{ item.ssl_csr_path }}"
    privatekey_path: "{{ item.ssl_key_path }}"
    common_name: "{{ item.common_name }}"
    organization: "{{ item.organization }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ ssl_items }}"

- name: Create SSL certificates for each item
  community.crypto.x509_certificate:
    path: "{{ item.ssl_cert_path }}"
    csr_path: "{{ item.ssl_csr_path }}"
    provider:
      own_key: "{{ item.ssl_key_path }}"
    common_name: "{{ item.common_name }}"
    organization: "{{ item.organization }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ ssl_items }}"

- name: Create PKCS#12 file for each item
  community.crypto.openssl_pkcs12:
    path: "{{ item.pkcs12_path }}"
    privatekey_path: "{{ item.ssl_key_path }}"
    certificate_path: "{{ item.ssl_cert_path }}"
    password: "{{ item.password }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ ssl_items }}"

- name: Read private key for each item
  ansible.builtin.slurp:
    src: "{{ item.ssl_key_path }}"
  register: key_content
  loop: "{{ ssl_items }}"
  loop_control:
    loop_var: item

- name: Read certificate for each item
  ansible.builtin.slurp:
    src: "{{ item.ssl_cert_path }}"
  register: cert_content
  loop: "{{ ssl_items }}"
  loop_control:
    loop_var: item

- name: Create a combined private key and certificate file for each item
  ansible.builtin.copy:
    content: >-
      {{ (lookup('vars', key_content.results[item.index].src) | b64decode) }}
      {{ (lookup('vars', cert_content.results[item.index].src) | b64decode) }}
    dest: "{{ item.combined_path }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ ssl_items }}"
  loop_control:
    loop_var: item


