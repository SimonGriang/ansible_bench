---
- name: Import assert.yml from a specified file
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install MySQL packages
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Restart MySQL

- name: Configure the MySQL server configuration file
  template:
    src: my.cnf.j2
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'
  notify:
    - Restart MySQL

- name: Configure the MySQL client configuration file
  lineinfile:
    path: /etc/my.cnf.d/client.cnf
    line: "socket={{ mysql_socket }}"
    create: yes
  notify:
    - Restart MySQL

- name: Initialize the MySQL database if on Alpine or Archlinux
  command: mysql_install_db --user=mysql --datadir=/var/lib/mysql
  when: ansible_facts['distribution'] in ['Alpine', 'Archlinux']
  changed_when: false
  notify:
    - Restart MySQL

- name: Start and enable the MySQL service
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers to apply previous changes
  meta: flush_handlers

- name: Place the my.cnf configuration file
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: '0600'

- name: Create MySQL databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  no_log: true
  loop: "{{ mysql_databases }}"
  when: item.initial_dump is not defined

- name: List current MySQL databases
  mysql_db:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
    state: list
  register: current_databases
  no_log: true

- name: Import databases if initial import is defined and not already present
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_dump }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_dump is defined and item.name not in current_databases.db

- name: Create MySQL users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('*.*:ALL') }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  no_log: true
  loop: "{{ mysql_users }}"

- name: Flush handlers again to apply user creation changes
  meta: flush_handlers


