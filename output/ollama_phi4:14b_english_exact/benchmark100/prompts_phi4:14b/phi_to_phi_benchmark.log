    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    mode: '0600'
  when: rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Deploy the Containerd registry configuration file
  ansible.builtin.template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    mode: '0600'
  when:
    - rke2_custom_registry_mirrors | length > 0
    - rke2_custom_registry_config | length > 0
  notify: Config file changed

- name: Start the RKE2 service on all nodes
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: true
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  retries: 10
  delay: 3
  until: rke2_service_started is succeeded
  notify: Service (re)started

- name: Mask other RKE2 services on non-applicable nodes
  ansible.builtin.service:
    name: "{{ item }}"
    state: masked
    enabled: false
  loop: "{{ rke2_applicable_services }}"
  when: rke2_node_type != item.rke2_type

- name: Verify node readiness without CNI
  ansible.builtin.shell: |
    kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}'
  register: node_ready_without_cni
  retries: 100
  delay: 15
  until: node_ready_without_cni.stdout == "True"
  when:
    - inventory_hostname == groups['rke2_server'][0]
    - (groups['rke2_server'] | length > 1 and inventory_hostname == groups['rke2_server'][1])
  ignore_errors: yes

- name: Verify node readiness with CNI
  ansible.builtin.shell: |
    kubectl get nodes --no-headers | grep -c "Ready"
  register: node_ready_with_cni
  retries: 100
  delay: 15
  until: node_ready_with_cni.stdout | int == groups['all'] | length
  when:
    - inventory_hostname == groups['rke2_server'][0]
    - (groups['rke2_server'] | length > 1 and inventory_hostname == groups['rke2_server'][1])
    - not ansible_check_mode
  ignore_errors: yes


