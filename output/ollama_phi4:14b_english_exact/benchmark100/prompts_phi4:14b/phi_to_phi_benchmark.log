---
- name: Import assert task file
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Pre-configure Debian systems for Postfix
  block:
    - name: Ensure Postfix is configured for Debian systems
      debconf:
        name: postfix
        question: 'postfix/main_mailer_type'
        value: 'No configuration'
        vtype: 'select'
  when: ansible_os_family == 'Debian'

- name: Install Postfix
  package:
    name: postfix
    state: present

- name: Conditionally install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: 
    - postfix_virtual_mailbox_maps is defined and 'mysql' in postfix_virtual_mailbox_maps
    - postfix_virtual_mailbox_domains is defined and 'mysql' in postfix_virtual_mailbox_domains
    - postfix_virtual_alias_maps is defined and 'mysql' in postfix_virtual_alias_maps

- name: Configure Postfix transport maps
  template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport
  notify: 
    - Validate Postfix configuration
    - Rebuild Postfix transport maps database
  when: postfix_transport_maps_template is defined

- name: Configure Postfix header checks
  template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
  notify: 
    - Validate Postfix configuration
    - Reload Postfix
  when: postfix_header_checks_template is defined

- name: Set values for Postfix main.cf (part 1)
  set_fact:
    postfix_recipient_access: "{{ lookup('file', postfix_recipient_access) if postfix_recipient_access is defined else '' }}"
    postfix_sender_access: "{{ lookup('file', postfix_sender_access) if postfix_sender_access is defined else '' }}"

- name: Set values for Postfix main.cf (part 2)
  set_fact:
    mynetworks: "{{ mynetworks | default(omit) }}"
    mydestination: "{{ mydestination | default(omit) }}"
    relay_domains: "{{ relay_domains | default(omit) }}"
    smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions | default(omit) }}"
    smtpd_sender_restrictions: "{{ smtpd_sender_restrictions | default(omit) }}"
    virtual_mailbox_domains: "{{ virtual_mailbox_domains | default(omit) }}"
    virtual_alias_domains: "{{ virtual_alias_domains | default(omit) }}"

- name: Configure Postfix main.cf
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify: 
    - Validate Postfix configuration
    - Restart Postfix

- name: Configure Postfix master.cf
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify: 
    - Validate Postfix configuration
    - Restart Postfix

- name: Create directories for TLS certificates and keys
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode | default('0755') }}"
  loop:
    - { path: '/etc/postfix/tls_certs' }
    - { path: '/etc/postfix/tls_keys' }
  when: 
    - item.path in [postfix_tls_cert_dir, postfix_tls_key_dir]
    - item.path is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_cert_src }}"
    dest: /etc/postfix/tls_certs/cert.pem
  notify: Reload Postfix
  when: postfix_tls_cert_src is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_src }}"
    dest: /etc/postfix/tls_keys/key.pem
  notify: Reload Postfix
  when: postfix_tls_key_src is defined

- name: Flush Postfix handlers
  meta: flush_handlers

- name: Configure Postfix aliases
  lineinfile:
    path: /etc/aliases
    line: "{{ item.line }}"
    create: yes
  with_items: "{{ postfix_aliases }}"
  notify:
    - Rebuild Postfix alias database
    - Reload Postfix
  when: postfix_aliases is defined

- name: Configure Postfix sender access
  lineinfile:
    path: /etc/postfix/sender_access
    line: "{{ item.line }}"
    create: yes
  with_items: "{{ postfix_sender_access }}"
  notify:
    - Rebuild Postfix sender access database
    - Reload Postfix
  when: postfix_sender_access is defined

- name: Configure Postfix recipient access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: "{{ item.line }}"
    create: yes
  with_items: "{{ postfix_recipient_access }}"
  notify:
    - Validate Postfix configuration
    - Rebuild Postfix recipient access database
    - Reload Postfix
  when: postfix_recipient_access is defined

- name: Place SASL password map
  copy:
    content: "{{ postfix_smtp_sasl_password_map }}"
    dest: /etc/postfix/sasl_password
  notify: Rebuild Postfix sasl_password_map database
  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map != ''

- name: Flush Postfix handlers again
  meta: flush_handlers

- name: Start and enable Postfix service
  service:
    name: postfix
    state: started
    enabled: yes


