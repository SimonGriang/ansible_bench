---
- name: Import additional tasks from assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for a specific port to become available
  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when: 
    - bootstrap_wait_for_host
    - ansible_connection != 'local'
    - ansible_connection != 'docker'
    - ansible_connection != 'podman'

- name: Prepare the system
  block:
    - name: Test connection and check for sudo availability
      become: true
      command: echo "Checking sudo availability"
      register: sudo_check
      ignore_errors: true

    - name: Gather bootstrap facts
      setup:
        filter: ansible_facts

    - name: Install necessary bootstrap packages
      raw: "{{ item }}"
      loop:
        - 'dnf -y install libdnf5'
        - 'yum install -y libdnf5'
      when: ansible_facts['os_family'] == "RedHat"

  rescue:
    - name: Gather bootstrap facts
      setup:

    - name: Install necessary bootstrap packages
      raw: "{{ item }}"
      loop:
        - 'dnf install -y {{ bootstrap_facts_packages | join(' ') }}'
        - 'yum install -y {{ bootstrap_facts_packages | join(' ') }}'
      when: ansible_facts['os_family'] == "RedHat"

- name: Gather Ansible facts without privilege escalation
  setup:
    filter: ansible_facts

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
  become: "{{ bootstrap_become }}"


