---
- name: Install EPEL repository package on supported systems
  ansible.builtin.package:
    name: "{{ epel_url }}"
    state: present
  when: 
    - ansible_facts['os_family'] == "RedHat"
    - ansible_facts['distribution_major_version'] | default(ansible_facts['distribution_version'].split('.')[0], true) in ['7', '8', '9', '10']
    - ansible_facts['distribution'] == "Amazon" or ansible_facts['distribution'] == "RedHat"
  notify: Update package cache

- name: Install the GPG key for the EPEL repository
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install the EPEL-release package and notify the handler to update the package cache
  ansible.builtin.package:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Optionally install the EPEL-next-release package if the epel_next variable is set
  ansible.builtin.package:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next | default(false)
  notify: Update package cache

handlers:
  - name: Update package cache
    ansible.builtin.package:
      update_cache: yes


