---
- name: Import the assert.yml tasks file to verify prerequisites
  ansible.builtin.include_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install the required SELinux packages
  ansible.builtin.package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush the handlers to ensure all notifications are processed
  ansible.builtin.meta:
    flush_handlers: yes

- name: Configure SELinux settings
  ansible.posix.selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when: ansible_selinux.status is defined and not ansible_connection | lower in ['docker', 'container']
  notify: Reboot

- name: Manage SELinux booleans
  ansible.posix.seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    persistent: "{{ item.persistent | default(omit) }}"
  loop: "{{ selinux_booleans }}"
  when: selinux_booleans is defined
  loop_control:
    label: "{{ item.name }}"


