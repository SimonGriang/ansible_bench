---
- name: Ensure a local directory exists for storing SSH keys of users who have SSH key management enabled
  file:
    path: /path/to/ssh_keys_directory
    state: directory
  when: user_management_enabled

- name: Create or update user accounts with specific attributes
  user:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    comment: "{{ item.comment | default('') }}"
    home: "{{ item.home | default(omit) }}"
    shell: "{{ item.shell | default('/bin/bash') }}"
    groups: "{{ item.groups | default([]) }}"
  register: user_result

- name: Configure sudo privileges for users
  template:
    src: sudoers.j2
    dest: "/etc/sudoers.d/{{ item.name }}"
    mode: '0440'
  when: item.sudo_options is defined
  with_items: "{{ users }}"

- name: Delete the sudoers file for users
  file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: absent
  when: item.sudo_options is not defined
  with_items: "{{ users }}"

- name: Create a private SSH key for users with SSH key management enabled
  openssh_keypair:
    path: "/path/to/ssh_keys_directory/{{ item.name }}_id_rsa"
    type: rsa
    size: 2048
  when:
    - item.ssh_key_management_enabled
    - not lookup('file', "/path/to/ssh_keys_directory/{{ item.name }}_id_rsa", default=False)
  with_items: "{{ users }}"

- name: Create a public SSH key for users with SSH key management enabled
  openssh_keypair:
    path: "/path/to/ssh_keys_directory/{{ item.name }}_id_rsa.pub"
    type: rsa
    size: 2048
  when:
    - item.ssh_key_management_enabled
    - not lookup('file', "/path/to/ssh_keys_directory/{{ item.name }}_id_rsa.pub", default=False)
  with_items: "{{ users }}"

- name: Convert the SSH key to PPK format for users with SSH key management enabled
  shell: |
    puttygen /path/to/ssh_keys_directory/{{ item.name }}_id_rsa
    -o /path/to/ssh_keys_directory/{{ item.name }}_id_rsa.ppk -O private
  when:
    - item.ssh_key_management_enabled
    - not lookup('file', "/path/to/ssh_keys_directory/{{ item.name }}_id_rsa.ppk", default=False)
  with_items: "{{ users }}"

- name: Retrieve or set the base home directory for users
  shell: getent passwd {{ item.name }} | cut -d: -f6
  register: user_home_dir
  ignore_errors: true
  with_items: "{{ users }}"
  changed_when: false

- name: Set home directory to /home if user is not found
  set_fact:
    user_home: "/home/{{ item.name }}"
  when: user_home_dir.results | map(attribute='failed') | select('true') | list
  with_items: "{{ users }}"

- name: Ensure the .ssh directory exists in the user's home directory
  file:
    path: "{{ item.home | default('/home/' ~ item.name) }}/.ssh"
    state: directory
    owner: "{{ item.name }}"
    mode: '0700'
  when:
    - item.ssh_key_management_enabled
    - item.private_key
  with_items: "{{ users }}"

- name: Add specified authorized SSH keys to the user's authorized_keys file
  authorized_key:
    user: "{{ item.name }}"
    state: present
    key: "{{ item.authorized_keys }}"
  when: item.authorized_keys is defined
  with_items: "{{ users }}"

- name: Remove specified unauthorized SSH keys from the user's authorized_keys file
  authorized_key:
    user: "{{ item.name }}"
    state: absent
    key: "{{ item.unauthorized_keys }}"
  when: item.unauthorized_keys is defined
  with_items: "{{ users }}"

- name: Transfer the generated private key to the user's .ssh directory
  copy:
    src: "/path/to/ssh_keys_directory/{{ item.name }}_id_rsa"
    dest: "{{ item.home | default('/home/' ~ item.name) }}/.ssh/id_rsa"
    owner: "{{ item.name }}"
    mode: '0600'
  when:
    - item.private_key
    - item.ssh_key_management_enabled
  with_items: "{{ users }}"

- name: Retrieve the current password validity period for users
  shell: pwck -r /etc/shadow | awk -v user="{{ item.name }}" '$1==user{print $5}'
  register: password_validity
  with_items: "{{ users }}"

- name: Update the password validity period for users
  shell: chage -M {{ item.validity_days }} {{ item.name }}
  when:
    - item.validity_days is defined
    - password_validity.results | map(attribute='stdout') | map('regex_replace', '^\s*\d+\s*$', '\1') | select('ne', item.validity_days) | list
  with_items: "{{ users }}"

- name: Copy additional specified private key files to the user's .ssh directory
  copy:
    src: "{{ item.additional_private_key }}"
    dest: "{{ item.home | default('/home/' ~ item.name) }}/.ssh/"
    owner: "{{ item.name }}"
    mode: '0600'
  when: item.additional_private_key is defined
  with_items: "{{ users }}"
