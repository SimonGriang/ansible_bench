---
- name: Cordon and Drain the node during RKE2 upgrade
  kubectl:
    command: "cordon {{ rke2_node_name }}"
  when: rke2_drain_node_during_upgrade | default(false)
  delegate_to: "{{ groups['active_server'] | first }}"
  run_once: true

- name: Drain the node during RKE2 upgrade
  kubectl:
    command: "drain {{ rke2_node_name }} --ignore-daemonsets --delete-local-data"
  register: drain
  until: drain.stdout == "Node {{ rke2_node_name }} was successfully drained"
  retries: 100
  delay: 15
  when: rke2_drain_node_during_upgrade | default(false)
  delegate_to: "{{ groups['active_server'] | first }}"
  run_once: true

- name: Restart the RKE2 service on the node
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  kubectl:
    command: "get nodes --field-selector=status.phase==Ready"
  register: nodes_ready
  until: nodes_ready.stdout | length == groups['rke2_cluster_group_name'] | length
  retries: 100
  delay: 15
  delegate_to: "{{ groups['active_server'] | first }}"
  run_once: true

- name: Uncordon the node after the upgrade
  kubectl:
    command: "uncordon {{ rke2_node_name }}"
  when: rke2_drain_node_during_upgrade | default(false)
  delegate_to: "{{ groups['active_server'] | first }}"
  run_once: true

- name: Wait for all pods to be ready again
  kubectl:
    command: "get pods --field-selector=status.phase!=Running,status.phase!=Succeeded"
  register: pods_ready
  until: pods_ready.stdout | length == 0
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready | default(false)
  delegate_to: "{{ groups['active_server'] | first }}"
  run_once: true

- name: Wait for all pods to pass readiness checks
  kubectl:
    wait: true
    args: "{{ rke2_wait_for_all_pods_to_be_healthy_args }}"
  register: pods_healthy
  until: pods_healthy.rc == 0
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy | default(false)
  delegate_to: "{{ groups['active_server'] | first }}"
  run_once: true


