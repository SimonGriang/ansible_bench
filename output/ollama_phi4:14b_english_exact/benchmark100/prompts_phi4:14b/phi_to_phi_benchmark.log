---
- name: Ensure the unzip package is installed
  ansible.builtin.package:
    name: unzip
    state: present
  when: promtail_apt_update_cache | default(false)

- name: Create a group for Promtail
  ansible.builtin.group:
    name: "{{ promtail_system_group }}"
    state: present
  when: promtail_system_group != "root"

- name: Create a user for Promtail
  ansible.builtin.user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    groups: "{{ promtail_user_additional_groups | join(',') }}"
    shell: /usr/sbin/nologin
    create_home: "{{ promtail_system_user == 'root' }}"
  when: promtail_system_user is defined

- name: Ensure the /usr/local/bin directory exists
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create necessary configuration directories for Promtail
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: "{{ promtail_system_group }}"
    mode: '0770'
  loop:
    - /etc/promtail
    - /etc/promtail/file_sd
    - /var/lib/promtail/positions

- name: Create application directories for Promtail
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0755'
  loop:
    - /usr/local/bin/promtail
    - /usr/local/lib/promtail

- name: Check if the Promtail binary exists
  ansible.builtin.stat:
    path: "/usr/local/bin/promtail-{{ promtail_version }}"
  register: promtail_binary

- name: Download Promtail binaries if not present locally
  ansible.builtin.get_url:
    url: "{{ promtail_dist_url }}"
    dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
    checksum: "{{ promtail_custom_checksum | default('sha256:placeholder') }}"
  when: not promtail_binary.stat.exists

- name: Propagate a locally distributed Promtail archive
  ansible.builtin.copy:
    src: "{{ promtail_local_archive }}"
    dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
  when: not promtail_binary.stat.exists and promtail_local_archive is defined

- name: Download Promtail binaries to the controller node
  ansible.builtin.get_url:
    url: "{{ promtail_dist_url }}"
    dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
    checksum: "{{ promtail_custom_checksum | default('sha256:placeholder') }}"
  when: promtail_binary_propagate | default(false)

- name: Propagate Promtail binaries across nodes
  ansible.builtin.copy:
    src: "/tmp/promtail-{{ promtail_version }}.tar.gz"
    dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
  when: promtail_binary_propagate | default(false)

- name: Unpack the Promtail binaries
  ansible.builtin.unarchive:
    src: "/tmp/promtail-{{ promtail_version }}.tar.gz"
    dest: "/usr/local/lib/promtail"
    remote_src: yes
  when: not promtail_binary.stat.exists

- name: Create a symlink to the latest version of Promtail
  ansible.builtin.file:
    src: "/usr/local/lib/promtail/promtail-{{ promtail_version }}"
    dest: "/usr/local/bin/promtail"
    state: link
  notify: restart promtail

- name: Write the Promtail configuration file
  ansible.builtin.template:
    src: promtail.yml.j2
    dest: /etc/promtail/promtail.yml
  notify: restart promtail

- name: Validate the Promtail configuration file
  ansible.builtin.shell: "/usr/local/bin/promtail -config.file=/etc/promtail/promtail.yml -validate"
  register: promtail_config_validation
  changed_when: false

- name: Create a systemd service unit for Promtail
  ansible.builtin.template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: restart promtail

handlers:
  - name: restart promtail
    ansible.builtin.service:
      name: promtail
      state: restarted


