---
- name: Migrate the Java JDK vendor from adoptopenjdk to temurin if selected
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS-specific variables for the Java JDK
  include_vars:
    file: "{{ item }}"
    name: java
  with_first_found:
    - files:
        - "{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_distribution_version }}.yml"
        - "{{ java_jdk_vendor }}_{{ ansible_distribution }}.yml"
        - "{{ java_jdk_vendor }}_default.yml"
      skip: true

- name: Gather architecture-specific variables for the Java JDK
  include_vars:
    file: "{{ item }}"
    name: java
  with_first_found:
    - files:
        - "{{ java_jdk_vendor }}_{{ ansible_architecture }}.yml"
        - "{{ java_jdk_vendor }}_default.yml"
      skip: true

- name: Set OS-specific Java variables
  set_fact:
    java_package_name: "{{ java_package_name | default('') }}"
    java_package_version: "{{ java_package_version | default('') }}"

- name: Set OS and architecture-specific Java variables
  set_fact:
    java_arch_specific_var: "{{ java_arch_specific_var | default('') }}"

- name: Set specific Java variables
  set_fact:
    java_home: "/usr/lib/jvm/java-{{ java_version }}-openjdk-amd64"

- name: Handle Debian pre-requisites for Java installation
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "deb http://archive.ubuntu.com/ubuntu {{ ansible_distribution_release }} main universe"
        state: absent
    - name: Install extra packages
      apt:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ extra_packages }}"
    - name: Add key repositories
      apt_key:
        url: "{{ item }}"
        state: present
      loop: "{{ key_repositories }}"
    - name: Add required repositories
      apt_repository:
        repo: "{{ item }}"
        state: present
      loop: "{{ required_repositories }}"
  when: ansible_os_family == "Debian"

- name: Handle RedHat pre-requisites for Java installation
  block:
    - name: Add key repositories
      yum_key:
        key: "{{ item }}"
        state: present
      loop: "{{ key_repositories }}"
    - name: Add required repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        enabled: yes
        gpgcheck: yes
        gpgkey: "{{ item.gpgkey }}"
      loop: "{{ required_repositories }}"
  when: ansible_os_family == "RedHat"

- name: Install required libraries for Java
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ required_libraries }}"

- name: Install Java on Debian systems
  apt:
    name: "{{ java_package_name }}={{ java_package_version }}"
    state: present
    update_cache: yes

- name: Install Java on RedHat systems
  yum:
    name: "{{ java_package_name }}-{{ java_version }}"
    state: present
    update_cache: yes

- name: Export Java environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0644'

- name: Source Java environment variables
  shell: source /etc/profile.d/jdk.sh

- name: Correct Java version selection for versions less than 11 on Debian systems
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
  when: ansible_os_family == "Debian" and java_version is version('<', 11)

- name: Correct Java version selection for versions 11 or greater on Debian systems
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
  when: ansible_os_family == "Debian" and java_version is version('>=', 11)


