---
- name: Import assert.yml and ensure it runs only once
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install necessary cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure the shell environment for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    mode: '0600'
  notify:
    - Restart cron service

- name: Configure the PATH environment variable for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    mode: '0600'
  notify:
    - Restart cron service

- name: Configure the MAILTO environment variable for cron
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    mode: '0600'
  notify:
    - Restart cron service

- name: Ensure the cron service is started and enabled
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service | length > 0

- name: Schedule specified cron jobs
  cron:
    name: "{{ item.name }}"
    user: "{{ item.user | default(omit) }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs | default([]) }}"
  when: cron_jobs is defined


