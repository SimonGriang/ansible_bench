---
- name: Check the current version of Docker Compose installed on the system
  command: docker-compose --version
  register: docker_compose_version_check
  changed_when: false

- name: Set a fact for the current Docker Compose version if it is defined and the output is not empty
  set_fact:
    current_docker_compose_version: "{{ docker_compose_version_check.stdout | regex_search('docker-compose\\s*(\\S+)', '\\1') | first }}"
  when: docker_compose_version_check.stdout != ""

- name: Delete the existing Docker Compose binary if the installed version does not match the desired version
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: current_docker_compose_version is defined and current_docker_compose_version != desired_version | string

- name: Download and install the specified version of Docker Compose if it is not already installed or if the installed version is older
  get_url:
    url: "https://github.com/docker/compose/releases/download/{{ desired_version }}/docker-compose-{{ ansible_system | lower }}-{{ ansible_machine }}"
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when: current_docker_compose_version is not defined or current_docker_compose_version == '' or current_docker_compose_version < desired_version


