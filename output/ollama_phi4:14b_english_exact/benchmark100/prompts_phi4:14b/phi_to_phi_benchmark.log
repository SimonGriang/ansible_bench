- name: Install required software packages based on the users_requirements variable
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  when: users_requirements | default([]) | length > 0
  tags:
    - install_packages

- name: Loop through the users_groups variable and include tasks from group.yml for each group
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
