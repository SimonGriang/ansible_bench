---
- name: Ensure systemd is the init system
  assert:
    that:
      - ansible_service_mgr == 'systemd'
    msg: "This playbook only works with systemd as the init system."

- name: Retrieve the latest release information for Grafana Loki from GitHub
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    method: GET
    headers:
      Authorization: "Bearer {{ lookup('env', 'GITHUB_TOKEN') }}"
    validate_certs: yes
    retries: 5
  register: loki_release
  when: promtail_version == "latest"
  set_fact:
    promtail_version: "{{ loki_release.json.tag_name }}"
  when: promtail_version == "latest"

- name: Verify the existence of a local promtail binary archive
  stat:
    path: "{{ promtail_binary_local_dir }}/{{ promtail_binary_filename }}"
  register: promtail_binary
  when: promtail_binary_local_dir is defined

- name: Assert existence of local promtail binary archive
  assert:
    that:
      - promtail_binary.stat.exists
    msg: "Local promtail binary archive does not exist in the specified directory."
  when: promtail_binary_local_dir is defined

- name: Download and verify checksum for the promtail binary
  vars:
    release_page: "https://github.com/grafana/loki/releases/tag/{{ promtail_version }}"
    checksum_url: "{{ lookup('url', release_page + '/assets/promtail_checksums.txt', wantlist=True) | select('match', '^\\s*SHA256\\s+{{ promtail_architecture }}\\s+') | first }}"
  block:
    - name: Fetch checksum list from GitHub release page
      uri:
        url: "{{ release_page }}/assets/promtail_checksums.txt"
        method: GET
        return_content: yes
      register: checksum_response

    - name: Extract checksum for the specified architecture
      set_fact:
        promtail_checksum: "{{ checksum_response.content | regex_search('^\\s*SHA256\\s+{{ promtail_architecture }}\\s+([a-f0-9]+)') | first }}"


