---
- name: Install EPEL repository on supported Red Hat-based systems
  hosts: all
  gather_facts: yes
  vars:
    epel_url: "https://dl.fedoraproject.org/pub/epel/epel-release-latest-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.noarch.rpm"
    epel_next_url: "https://dl.fedoraproject.org/pub/epel/epel-next-release-latest-{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.noarch.rpm"
    epel_next: false
  tasks:
    - name: Check if EPEL repository installation is required
      ansible.builtin.set_fact:
        install_epel: "{{ ansible_distribution in ['Amazon', 'RedHat'] and ansible_distribution_major_version in ['7', '8', '9', '2'] }}"

    - name: Add the EPEL GPG key
      ansible.builtin.rpm_key:
        state: present
        key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}
      when: install_epel

    - name: Install the EPEL release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      when: install_epel
      notify: Update package cache

    - name: Optionally install the EPEL next-release package
      ansible.builtin.package:
        name: "{{ epel_next_url }}"
        state: present
      when: install_epel and epel_next
      notify: Update package cache

  handlers:
    - name: Update package cache
      ansible.builtin.package:
        update_cache: yes


