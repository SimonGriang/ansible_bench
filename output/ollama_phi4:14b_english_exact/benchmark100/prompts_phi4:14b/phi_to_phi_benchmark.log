14T22:04:23.77777113Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9996566713, 'load_duration': 61241313, 'prompt_eval_count': 600, 'prompt_eval_duration': 293469055, 'eval_count': 536, 'eval_duration': 9640803910, 'model_name': 'phi4:14b'} id='run--6f9db0cb-5c0b-4c8d-b230-7f0e80bcccee-0' usage_metadata={'input_tokens': 600, 'output_tokens': 536, 'total_tokens': 1136}
