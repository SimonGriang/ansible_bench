---
- name: Import external tasks from assert.yml to be executed once on localhost
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install DNS-related packages
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create necessary directories for DNS configuration and data
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0755'
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create a group for DNS service
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create a user for the DNS service
  user:
    name: "{{ dns_owner }}"
    system: true
    state: present
    create_home: no

- name: Generate the rndc key for DNS configuration
  command: rndc-confgen -a
  args:
    creates: /etc/rndc.key

- name: Set file permissions for the rndc key
  file:
    path: /etc/rndc.key
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0640'

- name: Download the root hints file if DNS caching is enabled
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ dns_datadir }}/root.hints"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
  notify: Rndc reload

- name: Create primary zone files from templates
  template:
    src: "zone_{{ item }}.j2"
    dest: "{{ dns_datadir }}/{{ item }}.zone"
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add DNS zones to the main configuration file
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
  notify: Restart DNS service

- name: Create systemd service override if using systemd
  block:
    - name: Ensure systemd service override directory exists
      file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        state: directory

    - name: Copy override configuration file
      copy:
        src: override.conf
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"

    - name: Reload systemd
      systemd:
        daemon_reload: true
  when: service_manager | lower == 'systemd'

- name: Start and enable the DNS service
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true


