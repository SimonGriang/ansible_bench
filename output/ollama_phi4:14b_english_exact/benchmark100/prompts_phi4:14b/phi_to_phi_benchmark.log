---
- name: Import the assert.yml tasks file
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required GRUB packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set the GRUB_TIMEOUT value
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_TIMEOUT='
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: yes
    mode: '0664'
  notify: Update GRUB

- name: Set the GRUB_RECORDFAIL_TIMEOUT value
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_RECORDFAIL_TIMEOUT='
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: yes
    mode: '0664'
  notify: Update GRUB

- name: Add options to GRUB_CMDLINE_LINUX
  when: grub_options is defined and grub_options | length > 0
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX=".*{{ item }}.*"$'
    line: "GRUB_CMDLINE_LINUX=\"\g<0>{{ item }}\""
    backrefs: yes
    create: yes
    mode: '0664'
  loop: "{{ grub_options }}"
  validate: /bin/sh -n %s
  notify: Update GRUB

- name: Import the password.yml tasks file if password setting is required
  import_tasks: password.yml
  when: grub_set_password

- name: Flush any pending handlers
  meta: flush_handlers


