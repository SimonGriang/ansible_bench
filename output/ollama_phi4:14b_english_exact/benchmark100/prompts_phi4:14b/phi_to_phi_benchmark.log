---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost

- name: Install MySQL
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set MySQL root password
    - Restart systemd

- name: Configure MySQL server
  template:
    src: my.cnf.j2
    dest: "{{ mysql_configuration_destination }}"
  vars:
    mysql_configuration_options: "{{ mysql_configuration_options }}"
  notify:
    - Reload MySQL

- name: Configure MySQL client
  lineinfile:
    path: "{{ mysql_configuration_destination }}"
    line: "socket = {{ mysql_socket }}"
    section: client
  notify:
    - Reload MySQL

- name: Initialize MySQL
  command: "{{ mysql_initialize_command }}"
  when:
    - ansible_facts['distribution'] == 'Alpine'
    - ansible_facts['distribution_version'] is version('3.4', '<')
  or:
    - ansible_facts['distribution'] == 'Archlinux'
  notify:
    - Restart MySQL

- name: Start and enable MySQL
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  no_log: true
  vars:
    login_user: root
    login_password: "{{ mysql_root_password }}"
  notify:
    - Reload MySQL

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('') }}"
    state: present
  loop: "{{ mysql_users }}"
  no_log: true
  vars:
    login_user: root
    login_password: "{{ mysql_root_password }}"
  notify:
    - Reload MySQL

- name: Flush handlers again
  meta: flush_handlers

handlers:
  - name: Set MySQL root password
    mysql_user:
      name: root
      host: localhost
      password: "{{ mysql_root_password }}"
      state: present
      login_user: root
      login_password: "{{ mysql_root_password }}"
    no_log: true

  - name: Restart systemd
    service:
      name: systemd
      state: restarted

  - name: Reload MySQL
    service:
      name: "{{ mysql_service }}"
      state: reloaded

  - name: Restart MySQL
    service:
      name: "{{ mysql_service }}"
      state: restarted


