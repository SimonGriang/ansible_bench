---
- name: Import assert.yml and ensure it is run only once on the localhost
  include_tasks: assert.yml
  tags:
    - assert

- name: Install required software packages based on the users_requirements variable
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  when: users_requirements | default([]) | length > 0
  tags:
    - install_packages

- name: Loop through the users_groups variable and include tasks from group.yml for each group
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    loop_var: group_name
    label: "{{ group_name }}"
  tags:
    - user_groups

- name: Ensure the /etc/sudoers file includes the /etc/sudoers.d directory
  lineinfile:
    path: /etc/sudoers
    line: 'includedir /etc/sudoers.d'
    regexp: '^includedir\s*/etc/sudoers.d'
    validate: 'visudo -cf %s'
    state: present
  tags:
    - sudoers_include

- name: Loop through the users variable and include tasks from user.yml for each user
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    loop_var: user_name
    label: "{{ user_name }}"
  tags:
    - user_accounts

- name: Manage cron permissions by creating or updating /etc/cron.allow with a template
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow | bool
  tags:
    - cron_permissions

- name: Remove the /etc/cron.allow file if cron permissions are not required
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow | bool
  tags:
    - cron_no_permissions


