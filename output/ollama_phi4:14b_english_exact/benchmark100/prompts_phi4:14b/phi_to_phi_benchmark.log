---
- name: Obtain the installed version of Python 3 on Debian 12
  ansible.builtin.command: python3 --version
  register: python_version_output
  changed_when: false
  tags: 
    - skip_ansible_lint
    - molecule-idempotence-notest
  when: ansible_facts['os_family'] == 'Debian' and ansible_facts['distribution_major_version'] == '12'

- name: Remove the EXTERNALLY-MANAGED file for Python 3.11 installations on Debian 12
  ansible.builtin.file:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
    state: absent
  when: "'Python 3.11' in python_version_output.stdout"
  tags: 
    - skip_ansible_lint
    - molecule-idempotence-notest


