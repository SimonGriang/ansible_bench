---
- name: Load OS-specific variables
  include_vars: "{{ item }}"
  with_first_found:
    - files:
        - "{{ ansible_distribution }}.yml"
        - "{{ ansible_os_family }}.yml"
      paths: vars

- name: Include RedHat-specific setup tasks
  include_tasks: setup-RedHat.yml
  when: ansible_os_family == 'RedHat'

- name: Include Debian-specific setup tasks
  include_tasks: setup-Debian.yml
  when: ansible_os_family == 'Debian'

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: yes
  when: ansible_version.full is version('2.12', '<') or ansible_os_family not in ['RedHat', 'Debian']

- name: Install Docker packages with allow_downgrade
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: true
  notify: restart docker
  ignore_errors: yes
  when: ansible_version.full is version('2.12', '>=') and ansible_os_family in ['RedHat', 'Debian']

- name: Install Docker Compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: yes
  when: (ansible_version.full is version('2.12', '<') or ansible_os_family not in ['RedHat', 'Debian']) and docker_install_compose_plugin | default(false)

- name: Install Docker Compose plugin with allow_downgrade
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: true
  notify: restart docker
  ignore_errors: yes
  when: ansible_version.full is version('2.12', '>=') and ansible_os_family in ['RedHat', 'Debian'] and docker_install_compose_plugin | default(false)

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    state: directory
    mode: '0755'
  when: docker_daemon_options is defined and docker_daemon_options | length > 0

- name: Configure Docker daemon options
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_nice_json }}"
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options is defined and docker_daemon_options | length > 0

- name: Ensure Docker service is started and enabled
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: yes
  when: docker_service_manage | default(false)

- name: Notify handlers
  meta: flush_handlers

- name: Include Docker Compose setup tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose | default(false)

- name: Retrieve Docker group information
  getent:
    database: group
    key: docker
    split: ':'
  register: docker_group_info
  when: docker_users is defined and docker_users | length > 0

- name: Determine if any users need to be added to the Docker group
  set_fact:
    at_least_one_user_to_modify: "{{ docker_users | difference(docker_group_info.contents.split(':')[3].split(',')) | length > 0 }}"
  when: docker_users is defined and docker_users | length > 0

- name: Include tasks to modify user group memberships
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify


