---
- name: Assert task import
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install bash package
  package:
    name: bash
    state: present

- name: Install OpenJDK package
  package:
    name: "{{ java_openjdk_package }}"
    state: present
  when: java_vendor == "openjdk"
  environment:
    # Specify any required environment variables here

- name: Install Oracle Java RPM package if local
  package:
    name: "/tmp/{{ java_oracle_package }}"
    state: present
  when: java_source == "local" and java_format == "rpm"
  copy:
    src: "{{ java_oracle_package }}"
    dest: "/tmp/{{ java_oracle_package }}"
    remote_src: yes

- name: Install Oracle Java DEB package if local
  package:
    name: "/tmp/{{ java_oracle_package }}"
    state: present
  when: java_source == "local" and java_format == "deb"
  copy:
    src: "{{ java_oracle_package }}"
    dest: "/tmp/{{ java_oracle_package }}"
    remote_src: yes
  apt:
    name: "/tmp/{{ java_oracle_package }}"
    state: present

- name: Install Oracle Java RPM package from repository
  package:
    name: "{{ java_oracle_package }}"
    state: present
  when: java_source == "repo" and java_format == "rpm"

- name: Ensure installation directory exists for Oracle Java targz
  file:
    path: "{{ java_install_dir }}"
    state: directory
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java tarball
  unarchive:
    src: "{{ java_oracle_package }}"
    dest: "{{ java_install_dir }}"
    remote_src: yes
  when: java_format == "targz" and java_vendor == "oracle"

- name: Set permissions for Oracle Java installation directory
  file:
    path: "{{ java_install_dir }}"
    state: directory
    mode: '0755'
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java JCE policy software
  unarchive:
    src: "{{ java_oracle_jce_package }}"
    dest: "/usr/local"
    remote_src: yes
  when: java_version == "8" and java_jce_enabled and java_vendor == "oracle"

- name: Set Oracle Java as default alternative
  alternatives:
    name: java
    path: "{{ java_install_dir }}/bin/java"
    link: /usr/bin/java
  when: java_format == "targz" and java_vendor == "oracle" and ansible_facts['os_family'] != "Alpine"

- name: Determine JAVA_HOME directory
  command: readlink -f "$(which java)"
  register: java_home
  changed_when: false

- name: Set JAVA_HOME environment variable
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME={{ java_home.stdout }}'
    create: yes


