---
- name: Enable Apache2 modules on Debian and Suse systems
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
  loop:
    - apache2
    - libapache2-mod-proxy
    - libapache2-mod-proxy-http
  when: ansible_os_family == "Debian"

- name: Enable Apache2 modules on Suse systems
  ansible.builtin.zypper:
    name: "{{ item }}"
    state: present
  loop:
    - apache2
    - apache2-mod_proxy
    - apache2-mod_proxy_http
  when: ansible_os_family == "Suse"

- name: Ensure 'proxy' and 'proxy_http' Apache2 modules are present
  ansible.builtin.shell:
    cmd: "a2enmod {{ item }}"
    creates: "/etc/apache2/mods-enabled/{{ item }}.load"
  loop:
    - proxy
    - proxy_http
  when: ansible_os_family == "Debian"

- name: Configure Apache2 locations
  ansible.builtin.template:
    src: location.conf.j2
    dest: "/etc/apache2/conf-available/{{ item.key }}.conf"
    mode: '0644'
  loop: "{{ httpd_locations | dict2items }}"
  notify:
    - Validate HTTPD configuration
    - Restart HTTPD

handlers:
  - name: Validate HTTPD configuration
    ansible.builtin.command:
      cmd: "apachectl configtest"
    changed_when: false

  - name: Restart HTTPD
    ansible.builtin.service:
      name: apache2
      state: restarted


