---
- name: Check if Java certificates exist on the system
  stat:
    path: "{{ item }}"
  register: java_certificates_status
  with_items: "{{ java_certificates }}"

- name: Fail the playbook if any Java certificate is missing
  fail:
    msg: "The certificate {{ item.path }} is missing."
  when: item.stat.exists == false
  loop: "{{ java_certificates_status.results }}"

- name: Set keystore directory variables for Java versions less than 11
  set_fact:
    java_keystore_dir: "/path/to/java8/keystore"
  when: java_version is version('11.0.0', '<')

- name: Set keystore directory variables for Java versions 11 and above
  set_fact:
    java_keystore_dir: "/path/to/java11/keystore"
  when: java_version is version('11.0.0', '>=')

- name: Import SSL certificates into the Java keystore
  java_cert:
    certificate: "{{ item }}"
    keystore: "{{ java_keystore_dir }}"
    keystore_pass: "{{ keystore_password }}"
    store_type: "{{ keystore_type }}"
    state: present
  with_items: "{{ java_certificates }}"


