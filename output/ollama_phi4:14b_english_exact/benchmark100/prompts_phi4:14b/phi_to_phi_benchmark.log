---
- name: Import assert.yml tasks
  import_tasks: assert.yml

- name: Install the git package
  package:
    name: "{{ git_packages }}"
    state: present

- name: Check if the specified git user exists in the system
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: user_check
  ignore_errors: yes

- name: Create a directory for the git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'
  when: user_check.exists

- name: Place the git configuration file
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0644'
  when: 
    - git_username is defined
    - user_check.exists

- name: Create the repository destination directory
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'
  when: 
    - git_repository_destination is defined
    - git_username is defined
    - user_check.exists

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    accept_hostkey: yes
    version: "{{ item.version | default(omit) }}"
    force: "{{ item.force | default(true) }}"
    recursive: yes
  loop: "{{ git_repositories }}"
  when: 
    - git_repositories is defined
    - git_repository_destination is defined
    - git_username is defined
    - user_check.exists
  become_user: "{{ git_username }}"


