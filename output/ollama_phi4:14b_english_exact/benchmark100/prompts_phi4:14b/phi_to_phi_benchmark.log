  ansible.builtin.get_url:
    url: "{{ promtail_dist_url }}"
    dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
    checksum: "{{ promtail_custom_checksum | default('sha256:placeholder') }}"
  when: promtail_binary_propagate | bool

- name: Propagate Promtail binaries across nodes
  ansible.builtin.copy:
    src: "/tmp/promtail-{{ promtail_version }}.tar.gz"
    dest: "/tmp/promtail-{{ promtail_version }}.tar.gz"
  when: promtail_binary_propagate | bool

- name: Unpack the Promtail binaries
  ansible.builtin.unarchive:
    src: "/tmp/promtail-{{ promtail_version }}.tar.gz"
    dest: "/usr/local/lib/promtail"
    remote_src: yes
  when: not promtail_binary.stat.exists

- name: Create a symlink to the latest version of Promtail
  ansible.builtin.file:
    src: "/usr/local/lib/promtail/promtail-{{ promtail_version }}"
    dest: "/usr/local/bin/promtail"
    state: link
  notify: restart promtail

- name: Write the Promtail configuration file
  ansible.builtin.template:
    src: promtail.yml.j2
    dest: /etc/promtail/promtail.yml
  notify: restart promtail

- name: Validate the Promtail configuration file
  ansible.builtin.shell: "/usr/local/bin/promtail -config.file=/etc/promtail/promtail.yml -validate"
  register: promtail_config_validation
  changed_when: false

- name: Create a systemd service unit for Promtail
  ansible.builtin.template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: restart promtail

handlers:
  - name: restart promtail
    ansible.builtin.service:
      name: promtail
      state: restarted
