---
- name: Generate SSL private key files
  community.crypto.openssl_privatekey:
    path: "{{ item.key_path }}"
    privatekey_format: PEM
    type: RSA
    size: 2048
    mode: 0600
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"

- name: Generate SSL CSR files
  community.crypto.openssl_csr:
    path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    common_name: "{{ item.common_name }}"
    country_name: "{{ item.country_name | default(omit) }}"
    state_or_province_name: "{{ item.state_or_province_name | default(omit) }}"
    locality_name: "{{ item.locality_name | default(omit) }}"
    organization_name: "{{ item.organization_name | default(omit) }}"
    organizational_unit_name: "{{ item.organizational_unit_name | default(omit) }}"
    email_address: "{{ item.email_address | default(omit) }}"
    mode: 0600
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"

- name: Generate SSL certificates
  community.crypto.x509_certificate:
    path: "{{ item.cert_path }}"
    privatekey_path: "{{ item.key_path }}"
    csr_path: "{{ item.csr_path }}"
    provider: selfsigned
    extension: subjectAltName
    subject_alt_name: "DNS:{{ item.common_name }}"
    valid_days: 365
    mode: 0640
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"

- name: Create PKCS#12 files
  community.crypto.openssl_pkcs12:
    dest: "{{ item.p12_path }}"
    privatekey_path: "{{ item.key_path }}"
    certificate_path: "{{ item.cert_path }}"
    password: "{{ item.p12_password }}"
    name: "{{ item.p12_name }}"
    mode: 0600
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"

- name: Read and register the content of the private key files
  ansible.builtin.slurp:
    path: "{{ item.key_path }}"
  register: "{{ item.key_content }}"

- name: Read and register the content of the certificate files
  ansible.builtin.slurp:
    path: "{{ item.cert_path }}"
  register: "{{ item.cert_content }}"

- name: Combine the registered private key and certificate content into a single file
  ansible.builtin.copy:
    dest: "{{ item.combined_path }}"
    content: |
      {{ item.key_content['content'] | b64decode }}
      {{ item.cert_content['content'] | b64decode }}
    mode: 0600
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"


