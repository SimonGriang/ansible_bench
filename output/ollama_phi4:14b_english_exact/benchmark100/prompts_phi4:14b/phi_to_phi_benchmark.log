212888, 'prompt_eval_count': 1053, 'prompt_eval_duration': 492055819, 'eval_count': 922, 'eval_duration': 15638165119, 'model_name': 'phi4:14b'} id='run--41853cd6-c89b-49b4-be97-b5e402f3aa9a-0' usage_metadata={'input_tokens': 1053, 'output_tokens': 922, 'total_tokens': 1975}
