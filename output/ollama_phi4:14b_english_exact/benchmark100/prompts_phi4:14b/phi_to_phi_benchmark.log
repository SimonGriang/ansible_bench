    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Uninstall obsolete Docker packages.
  ansible.builtin.apt:
    name: 
      - docker-engine
      - docker-ce
      - docker-ce-cli
      - containerd.io
      - docker-compose-plugin
      - docker-buildx-plugin
    state: absent

- name: Remove the legacy Docker repository file.
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/legacy-docker.list
    state: absent

- name: Install necessary dependencies for Docker.
  ansible.builtin.apt:
    name: 
      - apt-transport-https
      - ca-certificates
      - curl
      - software-properties-common
    state: present
    update_cache: yes

- name: Add or remove the Docker repository based on a condition.
  ansible.builtin.block:
    - name: Add Docker repository
      ansible.builtin.apt_repository:
        repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_distribution_release }} stable
        state: present
      when: add_docker_repo | default(false) is defined and add_docker_repo | bool

    - name: Remove Docker repository
      ansible.builtin.apt_repository:
        repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_distribution_release }} stable
        state: absent
      when: add_docker_repo | default(false) is defined and not add_docker_repo | bool

- name: Flush handlers to update the apt cache immediately.
  ansible.builtin.meta:
    flush_handlers: yes


