---
- name: Create a system group for Vault
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create a system user for Vault
  user:
    name: "{{ vault_user }}"
    group: "{{ vault_group }}"
    shell: "{{ vault_user_shell }}"
    create_home: no

- name: Create a download directory for Vault
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0750'

- name: Download the Vault binary
  get_url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_amd64.zip"
    dest: "{{ vault_download_path }}/vault.zip"

- name: Unarchive the Vault binary
  unarchive:
    src: "{{ vault_download_path }}/vault.zip"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    creates: "{{ vault_download_path }}/vault"
  notify: restart vault

- name: Check if the main Vault directory exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create the main Vault directory if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0750'
  when: not vault_check_path.stat.exists

- name: Create additional directories in the main Vault directory
  file:
    path: "{{ vault_path }}/{{ item.name }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_directories }}"

- name: Create data directories for Vault
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ vault_data_directories }}"

- name: Generate a TLS key and certificate for Vault
  block:
    - openssl_privatekey:
        path: "{{ vault_data_directory }}/tls/vault.key"
    - openssl_certificate:
        path: "{{ vault_data_directory }}/tls/vault.crt"
        privatekey_path: "{{ vault_data_directory }}/tls/vault.key"
  notify: restart vault

- name: Set ownership of TLS files
  file:
    path: "{{ vault_tls_files }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0640'

- name: Copy the Vault binary to the appropriate location
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    owner: root
    group: root
    mode: '0755'
  notify: restart vault

- name: Set specific capabilities on the Vault binary
  ansible.builtin.file:
    path: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
  command: "setcap cap_ipc_lock=ep {{ vault_path }}/usr/bin/vault"

- name: Create a vault environment file
