---
- name: Determine the package state based on the installation method
  set_fact:
    ansible_package_state: >-
      {{ 'present' if ansible_facts.packages[ansible_package_name] is defined
      else 'absent' }}

- name: Setup Ansible on RedHat systems, excluding Fedora, using the package manager
  include_tasks: redhat.yml
  when: >
    ansible_os_family == 'RedHat'
    and ansible_distribution != 'Fedora'
    and ansible_package_state == 'present'

- name: Setup Ansible on Fedora using the package manager
  include_tasks: fedora.yml
  when: >
    ansible_os_family == 'RedHat'
    and ansible_distribution == 'Fedora'
    and ansible_package_state == 'present'

- name: Setup Ansible on Ubuntu using the package manager
  include_tasks: ubuntu.yml
  when: >
    ansible_os_family == 'Debian'
    and ansible_distribution == 'Ubuntu'
    and ansible_package_state == 'present'

- name: Setup Ansible on Debian using the package manager
  include_tasks: debian.yml
  when: >
    ansible_os_family == 'Debian'
    and ansible_distribution != 'Ubuntu'
    and ansible_package_state == 'present'

- name: Setup Ansible using Pip
  include_tasks: pip.yml
  when: ansible_package_state == 'absent'


