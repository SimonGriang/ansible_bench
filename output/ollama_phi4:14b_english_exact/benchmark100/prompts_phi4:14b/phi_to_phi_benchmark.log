---
- name: Import assertion task file
  ansible.builtin.import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Uninstall systemd-logger package
  ansible.builtin.package:
    name: systemd-logger
    state: absent

- name: Install rsyslog package
  ansible.builtin.package:
    name: "{{ rsyslog_packages }}"
    state: "{{ rsyslog_package_state }}"

- name: Install additional rsyslog packages based on features
  ansible.builtin.package:
    name: "{{ item }}"
    state: "{{ rsyslog_package_state }}"
  loop: "{{ rsyslog_features }}"

- name: Configure the default rsyslog settings
  ansible.builtin.template:
    src: "{{ rsyslog_config_file_format }}"
    dest: "{{ rsyslog_dest_conf_file }}"
    mode: '0644'
  when: rsyslog_deploy_default_config
  notify: restart rsyslog

- name: Ensure existence of rsyslog configuration directory
  ansible.builtin.file:
    path: /etc/rsyslog.d/
    state: directory
    mode: '0755'

- name: Configure rsyslog to forward logs
  ansible.builtin.template:
    src: forward_rule.conf.j2
    dest: "/etc/rsyslog.d/{{ rsyslog_forward_rule_name }}"
    mode: '0644'
  when: not rsyslog_deploy_default_config
  notify: restart rsyslog

- name: Configure additional rsyslog configuration files
  ansible.builtin.template:
    src: "{{ item.value.src }}"
    dest: "/etc/rsyslog.d/{{ item.key }}"
    mode: "{{ item.value.mode | default('0644') }}"
    validate: "{{ item.value.validate | default(omit) }}"
  loop: "{{ rsyslog_rsyslog_d_files | dict2items }}"
  notify: restart rsyslog
  when: item.value.state == 'present'

- name: Start and enable the rsyslog service
  ansible.builtin.service:
    name: "{{ rsyslog_service }}"
    state: started
    enabled: true


