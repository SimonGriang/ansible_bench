---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    mode: '0755'

- name: Set server-specific node taints
  lineinfile:
    path: /etc/rancher/rke2/config.yaml
    line: 'node-taints: {{ rke2_server_node_taints | join(",") }}'
    create: yes
  when: rke2_type == 'server'

- name: Template the RKE2 configuration file
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    mode: '0600'
  notify: Config file changed

- name: Template the kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    mode: '0600'
  when: rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Configure Containerd registry settings
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    mode: '0600'
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
  notify: Config file changed

- name: Determine if an etcd restore from a file is necessary
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file and not (ansible_service_mgr == 'systemd' and ansible_facts.services['rke2-server.service'] is defined and ansible_facts.services['rke2-server.service'].state == 'running') }}"

- name: Determine if an etcd restore from S3 is necessary
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file and rke2_s3_credentials and rke2_s3_bucket }}"

- name: Restore etcd from a snapshot file
  block:
    - name: Create the snapshot directory
      file:
        path: /var/lib/rancher/rke2/server/etcd-snapshots
        state: directory
        owner: root
        mode: '0700'

    - name: Copy the snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/etcd-snapshots/snapshot.db
        owner: root
        mode: '0600'

    - name: Execute the rke2 server command to restore etcd
      command: rke2 server --restore-etcd-snapshot /var/lib/rancher/rke2/server/etcd-snapshots/snapshot.db
      register: restore_etcd_output
      changed_when: restore_etcd_output.rc != 0
  when: do_etcd_restore is defined and do_etcd_restore

- name: Restore etcd from an S3 snapshot
  block:
    - name: Execute the rke2 server command with S3 options to restore etcd
      command: >
        rke2 server --restore-etcd-from-s3
                  --s3-access-key-id={{ rke2_s3_credentials.access_key_id }}
                  --s3-secret-access-key={{ rke2_s3_credentials.secret_access_key }}
                  --s3-bucket={{ rke2_s3_bucket }}
                  --s3-endpoint={{ rke2_s3_endpoint }}
      register: restore_etcd_s3_output
      changed_when: restore_etcd_s3_output.rc != 0
  when: do_etcd_restore_from_s3 is defined and do_etcd_restore_from_s3

- name: Start the RKE2 server service
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
    env:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask the RKE2 agent service
  systemd:
    name: rke2-agent.service
    enabled: no
    masked: yes

- name: Wait for the first server to be ready without CNI
  kubectl:
    command: get nodes
    register: kubectl_output
  until: kubectl_output.stdout_lines | map('regex_search', '(?P<name>\\S+)\\s+\\w+\\s+NotReady') | select('search', 'Ready') | list | length > 0
  retries: 100
  delay: 15
  when: rke2_cni == 'none'

- name: Wait for the first server to be ready with CNI
  kubectl:
    command: get nodes
    register: kubectl_output
  until: kubectl_output.stdout_lines | map('regex_search', '(?P<name>\\S+)\\s+\\w+\\s+Ready') | select('search', 'Ready') | list | length > 0
  retries: 40
  delay: 15
  when: rke2_cni != 'none'

- name: Clean up old nodes and secrets if restoring etcd
  block:
    - name: Retrieve registered node names
      command: kubectl get nodes -o=jsonpath='{.items[*].metadata.name}'
      register: registered_nodes

    - name: Identify nodes no longer present
      set_fact:
        old_nodes: "{{ registered_nodes.stdout_lines | difference(known_node_names) }}"

    - name: Delete associated secrets and nodes
      kubectl:
        command: delete
        resource_name: "{{ item }}"
      loop: "{{ old_nodes }}"
  when: do_etcd_restore is defined and do_etcd_restore or do_etcd_restore_from_s3 is defined and do_etcd_restore_from_s3

- name: Set the active server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  with_inventory_hostnames: "{{ rke2_cluster_group_name }}"


