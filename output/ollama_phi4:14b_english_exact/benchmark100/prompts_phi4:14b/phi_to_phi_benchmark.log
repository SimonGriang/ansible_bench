    dest: /etc/rancher/rke2/config/manifests/{{ item | basename | regex_replace('\\.j2$', '') }}
    mode: '0664'
  loop:
    - /path/to/kube-vip-cloud-provider-template.j2
  when: cloud_provider_enabled


