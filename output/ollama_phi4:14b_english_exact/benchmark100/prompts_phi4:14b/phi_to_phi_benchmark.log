        env_vars: "{{ {'RANCHER_URL': 'https://rancher.example.com'} | combine({'RKE2_URL': 'https://github.com/rancher/rke2'}) }}"

    - name: Run installation script for non-airgap
      shell: /usr/local/bin/install-rke2.sh
      environment: "{{ env_vars }}"
      when: not rke2_airgap_mode

    - name: Run installation script for airgap
      shell: /usr/local/bin/install-rke2.sh --airgap-mode
      environment: "{{ env_vars }}"
      when: rke2_airgap_mode

  when: rke2_installed_version != rke2_desired_version

- name: Copy custom manifests if they are defined
  copy:
    src: /path/to/local/custom_manifests/{{ item }}
    dest: /etc/rancher/rke2/manifests/{{ item }}
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy static pods if they are defined
  copy:
    src: /path/to/local/static_pods/{{ item }}
    dest: /var/lib/rancher/rke2/server/manifests/{{ item }}
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file if environment options are defined
  copy:
    src: /path/to/local/rke2_env_file.env
    dest: /etc/rancher/rke2/config.yaml
  when: rke2_environment_options | length > 0


