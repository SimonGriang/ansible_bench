---
- name: Install Keepalived when HA mode is enabled
  block:
    - name: Install Keepalived on RKE2 servers with defined API IP
      package:
        name: keepalived
        state: present
      when: 
        - rke2_ha_mode | bool
        - rke2_ha_keepalived | bool
        - "'rke2_servers' in group_names"
        - "'api_ip' in inventory_hostname"

- name: Download and install RKE2 version
  block:
    - name: Download specified RKE2 version
      get_url:
        url: "{{ rke2_download_url }}"
        dest: "/tmp/rke2-server-{{ rke2_version }}.{{ ansible_architecture }}"
        mode: '0755'

    - name: Install RKE2 version
      command: "/tmp/rke2-server-{{ rke2_version }}.{{ ansible_architecture }} install"

- name: Apply CIS Hardening
  block:
    - name: Apply CIS hardening profiles
      include_tasks: cis_hardening.yml
      when: cis_profile is defined

- name: Find Active Server
  block:
    - name: Identify active server within RKE2 cluster
      include_tasks: find_active_server.yml

- name: Enable IPVS kernel module
  block:
    - name: Enable IPVS kernel module
      modprobe:
        name: ip_vs
        state: present
      when: 
        - rke2_ha_mode | bool
        - kube_vip_load_balancing | bool
        - "'rke2_servers' in group_names"
        - not rke2_ha_keepalived

- name: Copy kube-vip manifests to the masternode
  block:
    - name: Copy kube-vip manifests to master node
      copy:
        src: kube-vip/{{ item }}
        dest: "/etc/kubernetes/manifests/{{ item }}"
      loop:
        - kube-vip.yml
      when: 
        - rke2_ha_mode | bool
        - kube_vip_load_balancing | bool
        - not rke2_ha_keepalived

- name: Copy ingress-nginx manifests to the masternode
  block:
    - name: Copy ingress-nginx manifests to master node
      copy:
        src: ingress-nginx/{{ item }}
        dest: "/etc/kubernetes/manifests/{{ item }}"
      loop: "{{ ingress_nginx_values | default([]) }}"
      when: ingress_nginx_values | length > 0

- name: Prepare very first server node in the cluster
  block:
    - name: Prepare first server node
      include_tasks: prepare_first_server.yml
      when: 
        - "'rke2_servers' in group_names"
        - "'rke2_first_server' in group_names"

- name: Restore etcd specific tasks
  block:
    - name: Restore etcd
      include_tasks: restore_etcd.yml
      when: 
        - active_server is defined
        - inventory_hostname == active_server or "'rke2_first_server' in group_names"
        - etcd_restore is defined

- name: Download kubeconfig to ansible localhost
  block:
    - name: Download kubeconfig to Ansible localhost
      fetch:
        src: /etc/rancher/rke2/rke2.yaml
        dest: "{{ ansible_user_dir }}/rke2-kubeconfig.yaml"
      when: 
        - download_kubeconfig | bool
        - "'rke2_first_server' in group_names"

- name: Prepare and join remaining nodes of the cluster
  block:
    - name: Join remaining nodes to cluster
      include_tasks: join_cluster.yml
      when: 
        - active_server is defined
        - "'rke2_servers' in group_names"
        - groups['rke2_servers'] | length > 1

- name: Rolling cordon and drain restart when version changes - servers
  block:
    - name: Rolling cordon and drain restart on server nodes
      include_tasks: rolling_cordon_drain_servers.yml
      when: rke2_version_changed | bool

- name: Rolling cordon and drain restart when version changes - agents
  block:
    - name: Rolling cordon and drain restart on agent nodes
      include_tasks: rolling_cordon_drain_agents.yml
      when: rke2_version_changed | bool

- name: Flush handlers
  block:
    - name: Execute all triggered handlers
      meta: flush_handlers

- name: Rolling restart when config files change
  block:
    - name: Rolling restart on all cluster nodes
      include_tasks: rolling_restart.yml
      when: config_files_changed | bool

- name: Final steps
  block:
    - name: Finalize setup or configuration process
      include_tasks: final_steps.yml
