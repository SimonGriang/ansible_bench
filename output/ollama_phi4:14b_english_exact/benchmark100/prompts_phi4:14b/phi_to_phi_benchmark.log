content='```yaml\n---\n- name: Download the RKE2 kubeconfig file\n  ansible.builtin.fetch:\n    src: /etc/rancher/rke2/rke2.yaml\n    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    flat: yes\n  when:\n    - rke2_download_kubeconf | default(false)\n    - inventory_hostname == groups[rke2_servers_group_name][0]\n\n- name: Replace loopback IP addresses in kubeconfig file\n  ansible.builtin.replace:\n    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    regexp: \'(127\\.0\\.0\\.1|\\\\[::1\\\\])\'\n    replace: "{{ rke2_api_ip | default(inventory_hostname) }}"\n    backup: yes\n  register: replaced\n  changed_when: replaced.replacements > 0\n  become: yes\n  mode: \'0600\'\n  when:\n    - rke2_download_kubeconf | default(false)\n    - inventory_hostname == groups[rke2_servers_group_name][0]\n  delegate_to: localhost\n  run_once: yes\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-14T22:55:26.535668909Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3521123964, 'load_duration': 63541355, 'prompt_eval_count': 558, 'prompt_eval_duration': 227791990, 'eval_count': 254, 'eval_duration': 3228626031, 'model_name': 'phi4:14b'} id='run--a4a00500-c855-4fb7-b1ee-5db60242c1c2-0' usage_metadata={'input_tokens': 558, 'output_tokens': 254, 'total_tokens': 812}
