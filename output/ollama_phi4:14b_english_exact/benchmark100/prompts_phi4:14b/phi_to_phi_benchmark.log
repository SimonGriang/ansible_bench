---
- name: Disable swap if enabled and vault_hardening_disable_swap is set
  block:
    - name: Check if swap is enabled
      command: swapon --summary
      register: swap_summary
      changed_when: false

    - name: Disable swap if it's enabled
      command: swapoff -a
      when: "'active' in swap_summary.stdout"

    - name: Comment out swap entries in /etc/fstab
      lineinfile:
        path: /etc/fstab
        regexp: '^/dev/mapper/.* swap'
        state: absent
        backup: yes

- name: Disable core dumps if vault_hardening_disable_core_dumps is set
  pam_limits:
    domain: '*'
    limit_type: 'hard'
    limit_item: 'core'
    value: '0'
  pam_limits:
    domain: '*'
    limit_type: 'soft'
    limit_item: 'core'
    value: '0'

- name: Disable shell command history for vault commands if vault_hardening_disable_shell_command_history is set
  block:
    - name: Create or modify script to ignore history for vault commands
      copy:
        dest: /etc/profile.d/vault_no_history.sh
        content: |
          if [[ "$PROMPT_COMMAND" != *"history -a"* ]]; then
            PROMPT_COMMAND="history -a; history -c; history -r; $PROMPT_COMMAND"
            export PROMPT_COMMAND
          fi
          export HISTIGNORE='*vault*:exit:logout:clear'
        mode: '0755'

- name: Configure SELinux and/or AppArmor if vault_hardening_configure_selinux_apparmor is set
  block:
    - name: Ensure selinux-policy is installed
      package:
        name: selinux-policy
        state: present
      when: ansible_selinux.status == "enabled"

    - name: Set SELinux policy to enforcing
      selinux:
        policy: targeted
        state: enforcing
      when: ansible_selinux.status == "enabled"

    - name: Ensure AppArmor profile for vault is enforced
      command: aa-enforce /etc/apparmor.d/usr.local.vault
      when: ansible_apparmor.state == "enabled"


