    dest: "/etc/sudoers.d/{{ group_name | regex_replace('.', 'dot') }}"
    mode: '0640'
  when: group.sudo_options is defined
  loop: "{{ groups }}"
  loop_control:
    loop_var: group
  notify: validate sudoers file

- name: Validate sudoers file syntax
  ansible.builtin.command:
    cmd: visudo -cf /etc/sudoers.d/{{ group_name | regex_replace('.', 'dot') }}
  when: group.sudo_options is defined
  loop: "{{ groups }}"
  loop_control:
    loop_var: group

handlers:
  - name: validate sudoers file
    ansible.builtin.command:
      cmd: visudo -cf /etc/sudoers.d/{{ group_name | regex_replace('.', 'dot') }}


