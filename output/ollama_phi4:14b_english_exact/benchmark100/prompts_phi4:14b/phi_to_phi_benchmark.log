content='```yaml\n---\n- name: Gather bootstrap facts\n  ansible.builtin.command:\n    cmd: cat /etc/os-release\n  register: bootstrap_facts\n  changed_when: false\n  become: false\n\n- name: Set bootstrap distribution and major version facts\n  ansible.builtin.set_fact:\n    bootstrap_distribution: "{{ item.value.distribution | lower }}"\n    bootstrap_distribution_major_version: "{{ item.value.major_version }}"\n  vars:\n    bootstrap_search: "{{ bootstrap_facts.stdout | regex_search(\'PRETTY_NAME=\\"(\\\\w+) \\\\((\\\\d+)\\\\)\', \'\\\\1\', \'\\\\2\') }}"\n  when:\n    - bootstrap_facts.rc == 0\n    - not bootstrap_distribution\n    - bootstrap_search is match(\'^(\\\\w+) \\\\((\\\\d+)\\\\)$\')\n  with_dict: "{{ bootstrap_os_family_map }}"\n  loop_control:\n    label: "Processing {{ item.key }}"\n  become: false\n\n- name: Determine and set bootstrap OS family\n  ansible.builtin.set_fact:\n    bootstrap_os_family: "{{ item.value.family }}"\n  when: bootstrap_distribution is defined and bootstrap_os_family is not defined and bootstrap_distribution in item.value.distribution\n  with_dict: "{{ bootstrap_os_family_map }}"\n  loop_control:\n    label: "Checking OS family for {{ item.key }}"\n  become: false\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-14T22:15:06.288431823Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4657032367, 'load_duration': 53199595, 'prompt_eval_count': 542, 'prompt_eval_duration': 286344734, 'eval_count': 272, 'eval_duration': 4316338788, 'model_name': 'phi4:14b'} id='run--e268d398-d90a-4b09-9acb-b4bbb6417904-0' usage_metadata={'input_tokens': 542, 'output_tokens': 272, 'total_tokens': 814}
