---
- name: Import assert.yml as a standalone task
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  ansible.builtin.yum:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: yes

- name: Configure SELinux
  when: ansible_selinux.status is defined and
        ansible_connection not in ['container', 'docker', 'community.docker.docker']
  block:
    - name: Manage SELinux
      ansible.builtin.selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Manage SELinux booleans
      when: selinux_booleans is defined
      ansible.builtin.selinux:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.name }}"


