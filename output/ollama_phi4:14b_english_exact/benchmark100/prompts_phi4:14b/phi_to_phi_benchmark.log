', 'total_duration': 9059441345, 'load_duration': 58815143, 'prompt_eval_count': 831, 'prompt_eval_duration': 308962109, 'eval_count': 518, 'eval_duration': 8690978116, 'model_name': 'phi4:14b'} id='run--a4d48aea-7f20-4c7e-8654-e7c02f7e3025-0' usage_metadata={'input_tokens': 831, 'output_tokens': 518, 'total_tokens': 1349}
