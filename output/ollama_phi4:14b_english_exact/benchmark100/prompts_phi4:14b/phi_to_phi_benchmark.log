---
- name: Import assert.yml task file
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Apache HTTP server
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux if enabled
  block:
    - name: Enable SELinux booleans
      ansible.builtin.command:
        cmd: "setsebool {{ item }} on"
      loop: "{{ httpd_sebooleans }}"
      when: selinux.status == "enabled"

    - name: Allow custom ports in SELinux
      ansible.builtin.command:
        cmd: "semanage port -a -t http_port_t -p tcp {{ item }}"
      loop:
        - "{{ httpd_port }}"
        - "{{ httpd_ssl_port | default(omit) }}"
      when: selinux.status == "enabled"

- name: Configure main Apache HTTP server configuration file
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
    notify:
      - Test Apache configuration
      - Restart Apache

- name: Activate specified Apache HTTP server modules on Debian systems
  ansible.builtin.command:
    cmd: "a2enmod {{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == "Debian"

- name: Import SSL configuration tasks if HTTPS is enabled
  import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import location configuration tasks if locations are defined
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual host configuration tasks if virtual hosts are defined
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports for Debian and SUSE systems
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "/etc/apache2/ports.conf"
    mode: '0644'
    notify:
      - Test Apache configuration
      - Restart Apache
  when: ansible_os_family in ["Debian", "SUSE"]

- name: Import directory configuration tasks if directories are defined
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush all pending handlers
  ansible.builtin.meta: flush_handlers

- name: Remove default HTML index file if specified
  ansible.builtin.file:
    path: "/var/www/html/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable the Apache HTTP server service
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


