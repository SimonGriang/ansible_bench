---
- name: Create local SSH key directory for a user
  file:
    path: "/home/{{ user_name }}/.ssh"
    state: directory
    mode: '0750'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Manage the user account
  user:
    name: "{{ user_name }}"
    comment: "{{ user_comment }}"
    group: "{{ user_group }}"
    create_home: "{{ create_home }}"
    password: "{{ user_password | password_hash('sha512') }}"
    expires: "{{ user_password_expire }}"
    shell: "{{ user_shell }}"

- name: Set up the user's sudo options
  template:
    src: "sudoers.j2"
    dest: "/etc/sudoers.d/{{ user_name }}"
    mode: '0440'
  when: user_sudo_options is defined

- name: Remove sudo config
  file:
    path: "/etc/sudoers.d/{{ user_name }}"
    state: absent
  when: user_sudo_options is not defined

- name: Generate the user's private SSH key
  command: ssh-keygen -t rsa -b 2048 -f "/home/{{ user_name }}/.ssh/id_rsa" -N ""
  when: manage_ssh_keys | default(false)
  args:
    creates: "/home/{{ user_name }}/.ssh/id_rsa"

- name: Generate the user's public SSH key
  command: ssh-keygen -y -f "/home/{{ user_name }}/.ssh/id_rsa" > "/home/{{ user_name }}/.ssh/id_rsa.pub"
  when: manage_ssh_keys | default(false)

- name: Convert the user's SSH key to PPK format
  command: ssh-keygen -e -f "/home/{{ user_name }}/.ssh/id_rsa" > "/home/{{ user_name }}/.ssh/id_rsa.ppk"
  when: manage_ssh_keys | default(false)

- name: Get or set the user's home directory
  set_fact:
    home_dir: "{{ lookup('password', '/dev/null length=1') | regex_replace('\\.', '/') }}"
  when: user_name not in ansible_facts.users

- name: Set the user's base home directory
  set_fact:
    home_dir: "/home/{{ user_name }}"
  when: user_name in ansible_facts.users

- name: Create the user's .ssh directory
  file:
    path: "{{ home_dir }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Deploy authorized keys for the user
  authorized_key:
    user: "{{ user_name }}"
    state: present
    key: "{{ item }}"
    filename: "{{ home_dir }}/.ssh/authorized_keys"
    mode: '0600'
  loop: "{{ user_authorized_keys }}"
  when: user_authorized_keys is defined

- name: Remove unauthorized keys for the user
  authorized_key:
    user: "{{ user_name }}"
    state: absent
    key: "{{ item }}"
    filename: "{{ home_dir }}/.ssh/authorized_keys"
  loop: "{{ user_unauthorized_keys }}"
  when: user_unauthorized_keys is defined

- name: Copy the generated private SSH key for the user
  copy:
    src: "/home/{{ user_name }}/.ssh/id_rsa"
    dest: "{{ home_dir }}/.ssh/id_rsa"
    mode: '0400'
  when: copy_private_key | default(false)

- name: Check the user's password validity
  shell: |
    awk -F: '($2 != "!" && $2 != "*" && $2 != "x") {print $1}' /etc/shadow | grep "^{{ user_name }}$" > /dev/null && echo "valid" || echo "invalid"
  register: users_pw_valid

- name: Set the user's password validity
  shell: chage -m {{ user_min_days }} -M {{ user_max_days }} -W {{ user_warn_days }} {{ user_name }}
  when: user_password_validity is defined and users_pw_valid.stdout == "invalid"

- name: Place the private key file for the user
  copy:
    src: "/home/{{ user_name }}/.ssh/id_rsa"
    dest: "{{ home_dir }}/.ssh/id_rsa"
    mode: '0400'
  when: user_private_keys is defined


