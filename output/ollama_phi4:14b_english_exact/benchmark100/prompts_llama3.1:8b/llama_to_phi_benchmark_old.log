content='```yaml\n---\n- name: Ensure old versions of Docker are not installed\n  yum:\n    name: \'*docker*\'\n    state: absent\n\n- name: Add Docker GPG key\n  ansible.builtin.get_url:\n    url: https://download.docker.com/linux/centos/gpg\n    dest: /etc/pki/rpm-gpg/RPM-GPG-KEY-Docker\n    mode: \'0644\'\n  ansible.builtin.command:\n    cmd: rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-Docker\n\n- name: Add Docker repository\n  ansible.builtin.get_url:\n    url: https://download.docker.com/linux/centos/docker-ce.repo\n    dest: /etc/yum.repos.d/docker-ce.repo\n    mode: \'0644\'\n\n- name: Configure Docker Nightly repo and Docker Test repo\n  ansible.builtin.lineinfile:\n    path: /etc/yum.repos.d/docker-ce.repo\n    regexp: \'^(\\s*)\\(.*\\)\\s*(enabled=)(.*)$\'\n    line: \'\\1\\2{{ "1" if docker_yum_repo_enable_nightly == "yes" and ".*nightly.*" in line else "0" if docker_yum_repo_enable_nightly == "no" and ".*nightly.*" in line else "1" }}\'\n  ansible.builtin.lineinfile:\n    path: /etc/yum.repos.d/docker-ce.repo\n    regexp: \'^(\\s*)\\(.*\\)\\s*(enabled=)(.*)$\'\n    line: \'\\1\\2{{ "1" if docker_yum_repo_enable_test == "yes" and ".*test.*" in line else "0" if docker_yum_repo_enable_test == "no" and ".*test.*" in line else "1" }}\'\n\n- name: Configure containerd on RHEL 8\n  block:\n    - name: Remove runc\n      yum:\n        name: runc\n        state: absent\n\n    - name: Install container-selinux\n      yum:\n        name: container-selinux\n        state: present\n\n    - name: Install containerd.io\n      yum:\n        name: containerd.io\n        state: present\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-13T21:14:06.193721196Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8771737507, 'load_duration': 55720119, 'prompt_eval_count': 439, 'prompt_eval_duration': 48989161, 'eval_count': 473, 'eval_duration': 8665867266, 'model_name': 'phi4:14b'} id='run--d8961f40-d24e-49b7-86e6-8b34a3b4ebdf-0' usa