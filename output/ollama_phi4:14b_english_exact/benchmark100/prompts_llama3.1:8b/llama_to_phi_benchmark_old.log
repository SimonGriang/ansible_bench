---
- name: Install unzip package and update cache if necessary
  apt:
    name: unzip
    state: present
    update_cache: "{{ promtail_apt_update_cache | bool }}"
    cache_valid_time: 3600

- name: Create promtail system group if necessary
  group:
    name: "{{ promtail_system_group }}"
    state: present
    system: yes
  when: promtail_system_group != "root"

- name: Create the promtail system user
  user:
    name: "{{ promtail_system_user }}"
    state: present
    system: yes
    group: "{{ promtail_system_group }}"
    groups: "{{ promtail_user_additional_groups | default([]) }}"
  when: promtail_system_user != "root"

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create necessary config directories
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: "{{ item.mode }}"
  loop:
    - { path: /etc/promtail, mode: '0750' }
    - { path: /var/lib/promtail, mode: '0750' }

- name: Create application directories
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: "{{ item.mode }}"
  loop:
    - { path: /opt/promtail, mode: '0750' }
    - { path: /opt/promtail/{{ promtail_version }}, mode: '0750' }

- name: Check the existence of the promtail binary
  stat:
    path: "/opt/promtail/{{ promtail_version }}/promtail"
  register: promtail_binary_stat

- name: Download promtail binaries if necessary
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "/tmp/promtail.zip"
  when: not promtail_binary_stat.stat.exists or promtail_binary_propagate

- name: Propagate locally distributed promtail archive if necessary
  copy:
    src: "{{ promtail_local_archive }}"
    dest: "/tmp/promtail.zip"
  when: promtail_local_archive is defined and promtail_binary_propagate

- name: Download promtail binaries to controller node if necessary
  get_url:
    url: "{{ promtail_download_url }}"
    dest: "/tmp/promtail.zip"
  when: promtail_binary_propagate

- name: Propagate promtail binaries
  copy:
    src: "/tmp/promtail.zip"
    dest: "/opt/promtail/{{ promtail_version }}/promtail.zip"
  when: promtail_binary_propagate

- name: Unpack promtail binaries
  unarchive:
    src: "/opt/promtail/{{ promtail_version }}/promtail.zip"
    dest: "/opt/promtail/{{ promtail_version }}"
    creates: "/opt/promtail/{{ promtail_version }}/promtail"

- name: Create a symlink to the latest version
  file:
    src: "/opt/promtail/{{ promtail_version }}/promtail"
    dest: "/usr/local/bin/promtail"
    state: link

- name: Write the promtail configuration
  template:
    src: promtail.yml.j2
    dest: /etc/promtail/config.yml
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0640'

- name: Create the systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'


