---
- name: Configure HTTP server directories
  hosts: all
  become: true
  vars:
    config_directory: /etc/httpd/conf.d
    directories:
      - path: /var/www/html
      - path: /var/www/secure
      - path: /var/www/media
    directory_mode: '0755'
    conf_mode: '0644'

  tasks:
    - name: Create required system directories for the HTTP server
      file:
        path: "{{ item.path }}"
        state: directory
        mode: "{{ directory_mode }}"
      loop: "{{ directories }}"

    - name: Generate directory configurations for the HTTP server
      template:
        src: directory.conf.j2
        dest: "{{ config_directory }}/{{ item.path.split('/')[-1] }}.conf"
        mode: "{{ conf_mode }}"
      loop: "{{ directories }}"


