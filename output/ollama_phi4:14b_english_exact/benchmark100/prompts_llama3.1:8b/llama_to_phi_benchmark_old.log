---
- name: Import assert.yml from the current working directory
  ansible.builtin.include_tasks: assert.yml

- name: Install the MySQL package
  ansible.builtin.package:
    name: mysql
    state: present
  notify:
    - Set MySQL root password
    - Execute systemctl daemon-reexec

- name: Configure the MySQL server
  community.general.ini_file:
    path: "{{ configuration_destination }}/server.cnf"
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
  loop: "{{ mysql_configuration_options }}"
  notify:
    - Restart MySQL server

- name: Configure the MySQL client
  community.general.ini_file:
    path: "{{ configuration_destination }}/client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"

- name: Initialize the MySQL database
  ansible.builtin.shell: "{{ mysql_initialize_command }}"
  when: ansible_os_family in ['Alpine', 'Archlinux']

- name: Start and enable the MySQL service
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place the my.cnf file
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf

