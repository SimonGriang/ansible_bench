---
- name: Create the RKE2 config directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  ansible.builtin.copy:
    src: "{{ rke2_config_source }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  ansible.builtin.template:
    src: kubelet-config.j2
    dest: /var/lib/rancher/rke2/server/manifests/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  when: rke2_kubelet_config is defined and 
        rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/containerd/registry.conf
    owner: root
    group: root
    mode: '0644'
  when: (rke2_custom_registry_mirrors is defined and 
         rke2_custom_registry_mirrors | length > 0) or 
        (rke2_custom_registry_configs is defined and 
         rke2_custom_registry_configs | length > 0)
  loop:
    - "{{ rke2_custom_registry_mirrors }}"
    - "{{ rke2_custom_registry_configs }}"
  notify: Config file changed

- name: Start RKE2 service on the rest of the nodes
  ansible.builtin.service:
    name: rke2
    state: started
    enabled: true
  retries: 3
  delay: 10
  notify: Service (re)started

- name: Mask other RKE2 services on the rest of the nodes
  ansible.builtin.systemd:
    name: "{{ item }}"
    enabled: no
    masked: true
  loop: "{{ rke2_services | 
          rejectattr('type', 'equalto', rke2_type) | 
          list }}"

- name: Wait for remaining nodes to be ready - no CNI
  ansible.builtin.wait_for:
    timeout: 600
  retries: 10
  delay: 30
  loop: "{{ groups['all'] }}"
  when: rke2_use_cni is not defined or 
        rke2_use_cni | bool is not true

- name: Wait for remaining nodes to be ready - with CNI
  ansible.builtin.wait_for:
    timeout: 600
  retries: 10
  delay: 30
  when: rke2_use_cni | bool and 
        (inventory_hostname == rke2_active_server or 
         rke2_active_server == groups['rke2_servers'][0])


