---
- name: Configure etcd system group and user, and kernel hardening
  hosts: all
  become: true

  tasks:
    - name: Create a system group named etcd
      group:
        name: etcd
        state: present

    - name: Create a system user named etcd
      user:
        name: etcd
        group: etcd
        shell: /bin/nologin
        create_home: no

    - name: Copy the systemctl config file for kernel hardening
      copy:
        src: "{{ '/usr/local/share/etcd-sysctl.conf' if '/usr/local/share' is dir and '/usr/local/share/etcd-sysctl.conf' is file else 'etcd-sysctl.conf' }}"
        dest: /etc/sysctl.d/etcd-sysctl.conf
        owner: root
        group: root
        mode: '0644'
      notify: Restart systemd-sysctl

    - name: Flush the handlers to run pending tasks
      meta: flush_handlers


