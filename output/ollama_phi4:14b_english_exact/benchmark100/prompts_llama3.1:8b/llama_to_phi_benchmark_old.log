---
- name: Import cron configuration from assert.yml file
  import_tasks: assert.yml

- name: Install required packages for cron service
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell environment for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    create: yes

- name: Configure system path for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    create: yes

- name: Configure mailto parameter for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    create: yes

- name: Start and enable the cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ''

- name: Schedule the requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    special_time: "{{ item.special_time | default(omit) }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default('present') }}"
  with_items: "{{ cron_jobs }}"


