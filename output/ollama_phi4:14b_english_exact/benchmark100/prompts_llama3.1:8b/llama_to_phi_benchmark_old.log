---
- name: Enable specific Apache2 modules
  apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop:
    - apache2
    - apache2-mod-proxy
    - apache2-mod-proxy-http
  when: ansible_os_family == "Debian"

- name: Enable specific Apache2 modules
  zypper:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop:
    - apache2
    - apache2-mod_proxy
    - apache2-mod_proxy_http
  when: ansible_os_family == "Suse"

- name: Enable Apache2 modules
  command: a2enmod "{{ item }}"
  loop:
    - proxy
    - proxy_http

- name: Configure Apache2 locations
  template:
    src: location.conf.j2
    dest: "/etc/apache2/sites-available/{{ item.location_name }}.conf"
    mode: '0644'
  loop: "{{ httpd_locations }}"
  notify:
    - Test httpd configuration validity
