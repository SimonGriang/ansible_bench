- name: Remove externally managed configuration from Debian 12 systems
  hosts: all
  tasks:
    - name: Import playbook for Debian 12 systems
      include_tasks: debian-12-remove-externally-managed.yml
      when: >
        ansible_facts['os_family'] == "Debian"
        and ansible_facts['distribution_major_version'] | int >= 12

- name: Install the Pip package on the system
  hosts: all
  tasks:
    - name: Ensure Pip package is installed
      package:
        name: "{{ pip_package }}"
        state: present

- name: Install the `python3-packaging` package via DNF
  hosts: all
  tasks:
    - name: Ensure `python3-packaging` package is installed
      package:
        name: python3-packaging
        state: present
