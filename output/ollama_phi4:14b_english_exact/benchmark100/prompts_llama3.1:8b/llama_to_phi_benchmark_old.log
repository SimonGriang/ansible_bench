---
- name: Assert that systemd is being used as the init system
  assert:
    that:
      - ansible_facts.init_system == "systemd"
    fail_msg: "This playbook only runs on systems using systemd."
    success_msg: "Systemd is the init system."

- name: Get the latest release of the Grafana Loki project from the GitHub API
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    method: GET
    return_content: yes
    status_code: 200
  register: _latest_release
  until: _latest_release is success
  retries: 5
  delay: 2

- name: Set the promtail version to the latest release tag
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name | regex_replace('^v', '') }}"
  when: promtail_version == 'latest'

- name: Test if the zip local archive exists in the specified directory
  stat:
    path: "{{ promtail_local_dir }}/{{ promtail_zip_name }}"
  register: promtail_zip_stat
  when: promtail_local_dir is defined

- name: Assert that the local binary exists in the specified directory
  assert:
    that:
      - promtail_zip_stat.stat.exists
    fail_msg: "The promtail binary archive does not exist in the specified directory."
    success_msg: "The promtail binary archive exists in the specified directory."
  when:
    - promtail_local_dir is defined
    - promtail_zip_stat.stat.exists

- name: Get the checksum list for the latest release
  uri:
    url: >-
      {{ (_latest_release.json.assets
          | selectattr('name', 'match', 'sha256sums')
          | map(attribute='browser_download_url')
          | list
          | first) }}
    method: GET
    return_content: yes
    status_code: 200
  register: __promtail_checksums

- name: Get the checksum for the specified architecture
  set_fact:
    __promtail_checksum: >-
      {{ __promtail_checksums.content.splitlines()
          | select('match', 'sha256sums.*promtail-linux-' ~ ansible_architecture ~ '.zip')
          | first }}
  when:
    - promtail_local_dir is defined
    - not promtail_local_dir | length


