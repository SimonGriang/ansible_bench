---
- name: Redis Configuration Playbook
  hosts: localhost
  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml
      delegate_to: localhost
      run_once: true

    - name: Enable redis module stream (RHEL 8)
      ansible.builtin.dnf:
        name: redis
        state: present
      when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"

    - name: Install redis
      ansible.builtin.package:
        name: "{{ redis_packages }}"
        state: present

    - name: Configure redis
      ansible.builtin.template:
        src: redis.conf.j2
