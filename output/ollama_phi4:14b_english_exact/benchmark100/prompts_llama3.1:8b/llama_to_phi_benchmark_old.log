content='```yaml\n---\n- name: Gather system facts\n  ansible.builtin.raw:\n    cmd: cat /etc/os-release\n  register: bootstrap_facts\n  become: false\n\n- name: Extract distribution name and major version\n  ansible.builtin.set_fact:\n    bootstrap_distribution: "{{ item.split(\'=\')[1].strip().replace(\'\\"\', \'\') }}"\n    bootstrap_distribution_major_version: "{{ item.split(\'=\')[2].strip().replace(\'\\"\', \'\') }}"\n  vars:\n    os_release_lines: "{{ bootstrap_facts.stdout_lines }}"\n  with_items: "{{ os_release_lines }}"\n  when: item.split(\'=\')[0] in [\'NAME\', \'VERSION_ID\']\n  loop_control:\n    extended: true\n\n- name: Identify operating system family\n  ansible.builtin.set_fact:\n    bootstrap_os_family: "{{ item.key }}"\n  vars:\n    os_family_map: |\n      Ubuntu: Debian\n      Debian: Debian\n      CentOS: RedHat\n      RedHat: RedHat\n      Fedora: RedHat\n      OracleLinux: RedHat\n      Amazon: RedHat\n      SUSE: Suse\n      openSUSE: Suse\n      Rocky: RedHat\n      AlmaLinux: RedHat\n  with_dict: "{{ os_family_map }}"\n  when: bootstrap_distribution is defined and item.value in bootstrap_distribution\n  loop_control:\n    label: "{{ item.key }}"\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-13T21:23:32.919580647Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5152287579, 'load_duration': 57831113, 'prompt_eval_count': 938, 'prompt_eval_duration': 57236250, 'eval_count': 284, 'eval_duration': 5035560536, 'model_name': 'phi4:14b'} id='run--4c27e1d0-115b-4b69-b970-118d7c0738bd-0' usage_metadata={'input_tokens': 938, 'output_tokens': 284, 'total_tokens': 1222}
