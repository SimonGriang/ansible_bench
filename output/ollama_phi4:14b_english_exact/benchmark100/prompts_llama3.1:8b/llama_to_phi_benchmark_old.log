---
- name: Manage Helm installation
  hosts: all
  vars:
    helm_bin_path: "/usr/local/bin/helm"
    helm_repo_path: "https://get.helm.sh"
    helm_version: "v3.5.4"
    helm_platform: "linux"
    helm_arch: "amd64"
  tasks:
    - name: Check if the Helm binary exists at the specified path
      stat:
        path: "{{ helm_bin_path }}"
      register: helm_check

    - name: Check the current version of Helm installed on the system
      command: "{{ helm_bin_path }} version --short"
      register: helm_existing_version
      changed_when: false
      failed_when: false

    - name: Download the Helm binary from the specified repository
      get_url:
        url: "{{ helm_repo_path }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
        dest: "/tmp/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
      when: 
        - not helm_check.stat.exists
        - helm_existing_version.stdout != "version.BuildInfo{Version:\"{{ helm_version }}\"}"

    - name: Extract the Helm binary
      unarchive:
        src: "/tmp/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
        dest: "/tmp"
        remote_src: yes
      when: 
        - not helm_check.stat.exists
        - helm_existing_version.stdout != "version.BuildInfo{Version:\"{{ helm_version }}\"}"

    - name: Copy the downloaded Helm binary into place at the specified path
      copy:
        src: "/tmp/{{ helm_bin_path }}"
        dest: "{{ helm_bin_path }}"
        mode: '0755'
      become: true
      when: 
        - not helm_check.stat.exists
        - helm_existing_version.stdout != "version.BuildInfo{Version:\"{{ helm_version }}\"}"


