---
- name: Import tasks and manage vsftpd
  hosts: all
  tasks:
    - name: Import task list from assert.yml
      include_tasks: assert.yml
      run_once: true

    - name: Install vsftpd package
      package:
        name: vsftpd
        state: present

    - name: Configure vsftpd service
      copy:
        dest: /etc/vsftpd/vsftpd.conf
        content: |
          listen=NO
          anonymous_enable=NO
          local_enable=YES
          write_enable=YES
          chroot_local_user=YES
        mode: '0644'
        owner: root
        group: root
      notify:
        - Restart vsftpd service

    - name: Start and enable vsftpd service
      service:
        name: vsftpd
        state: started
        enabled: yes

  handlers:
    - name: Restart vsftpd service
      service:
        name: vsftpd
        state: restarted


