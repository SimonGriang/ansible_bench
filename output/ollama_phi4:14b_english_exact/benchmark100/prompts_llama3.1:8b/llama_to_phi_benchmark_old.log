ty.mysql.mysql_user:\n    name: "{{ item.name }}"\n    password: "{{ item.password }}"\n    priv: "{{ item.privileges }}"\n    state: present\n  loop: "{{ mysql_users }}"\n  become: true\n\n- name: Flush handlers again\n  meta: flush_handlers\n```\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-13T21:16:48.761481965Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9565617892, 'load_duration': 51008813, 'prompt_eval_count': 1432, 'prompt_eval_duration': 7412215, 'eval_count': 565, 'eval_duration': 9505124602, 'model_name': 'phi4:14b'} id='run--9886a9ab-176a-40d7-85f3-6b2674fc5727-0' usage_metadata={'input_tokens': 1432, 'output_tokens': 565, 'total_tokens': 1997}
