---
- name: Load OS-specific variables
  include_vars: "{{ ansible_os_family }}.yml"

- name: Include setup tasks for RedHat-based systems
  include_tasks: redhat.yml
  when: ansible_os_family == 'RedHat'

- name: Include setup tasks for Debian-based systems
  include_tasks: debian.yml
  when: ansible_os_family == 'Debian'

- name: Install Docker packages on systems with Ansible version less than 2.12
  # or non-RedHat/Debian systems
  package:
    name: "{{ docker_packages }}"
    state: present
  when:
    - ansible_version.full is version('2.12', '<')
    - ansible_os_family not in ['RedHat', 'Debian']

- name: Install Docker packages (with downgrade option) on systems with Ansible
  # version 2.12 or higher and RedHat/Debian systems
  package:
    name: "{{ docker_packages }}"
    state: present
    downgrade: yes
  when:
    - ansible_version.full is version('2.12', '>=') 
    - ansible_os_family in ['RedHat', 'Debian']

- name: Install the docker-compose plugin on systems where the plugin is
  # enabled and the system meets the criteria for task 4 or 5
  package:
    name: docker-compose
    state: present
  when:
    - docker_compose_enabled
    - (
        ansible_version.full is version('2.12', '<') or
        ansible_os_family not in ['RedHat', 'Debian'] or
        (ansible_version.full is version('2.12', '>=') and
         ansible_os_family in ['RedHat', 'Debian'])
      )

- name: Install the docker-compose-plugin (with downgrade option) on
  # systems where the plugin is enabled and the system meets the criteria
  # for task 5
  package:
    name: docker-compose
    state: present
    downgrade: yes
  when:
    - docker_compose_enabled
    - ansible_version.full is version('2.12', '>=') 
    - ansible_os_family in ['RedHat', 'Debian']

- name: Ensure the /etc/docker/ directory exists and has the correct
  # permissions
  file:
    path: /etc/docker/
    state: directory
    mode: '0755'

- name: Configure the Docker daemon options by copying the options to the
  # daemon.json file
  copy:
    src: daemon.json
    dest: /etc/docker/daemon.json
    owner: root
    group: root
    mode: '0644'

- name: Ensure Docker is started and enabled at boot, if configured to do so
  service:
    name: docker
    state: started
    enabled: yes

- name: Notify handlers to ensure firewall rules are updated
  notify: Update firewall rules

- name: Include tasks for managing docker-compose, if enabled
  include_tasks: manage_compose.yml
  when: docker_compose_enabled

- name: Get information about the docker group using getent
  command: getent group docker
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  set_fact:
    docker_users_to_add: "{{ docker_users | difference(docker_group_info.stdout_lines |
      map('regex_search', '(\\w+):docker') | map('regex_replace', '(\\w+):docker',
      '\\1') | list) }}"

- name: Include tasks for managing docker users, if necessary
  include_tasks: manage_users.yml
  when: docker_users_to_add | length > 0


