n- name: Reload systemd\n  ansible.builtin.systemd:\n    daemon_reload: yes\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-13T21:04:52.505285248Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9001386456, 'load_duration': 55002820, 'prompt_eval_count': 626, 'prompt_eval_duration': 250278939, 'eval_count': 520, 'eval_duration': 8695672946, 'model_name': 'phi4:14b'} id='run--6b7a48f0-b9f1-4e79-a39f-976b23192704-0' usage_metadata={'input_tokens': 626, 'output_tokens': 520, 'total_tokens': 1146}
