---
- name: Hardening | Disable Swap
  block:
    - name: Disable swap temporarily
      command: swapoff -a
      when: vault_hardening_disable_swap | bool

    - name: Permanently disable swap
      lineinfile:
        path: /etc/fstab
        regexp: '^(.+)\s+swap\s+'
        state: absent
      when: vault_hardening_disable_swap | bool

- name: Hardening | Disable Core Dumps
  block:
    - name: Disable core dumps for both hard and soft limits
      community.general.pam_limits:
        domain: '{{ item.domain }}'
        limit_type: '{{ item.limit_type }}'
        value: '0'
      loop:
        - { domain: '*', limit_type: 'hard', limit_item: 'core' }
        - { domain: '*', limit_type: 'soft', limit_item: 'core' }
      when: vault_hardening_disable_core_dumps | bool

- name: Hardening | Disable Shell Command History
  block:
    - name: Copy vault.sh to /etc/profile.d/
      copy:
        src: vault.sh
        dest: /etc/profile.d/vault.sh
        mode: '0755'
      when: vault_hardening_disable_shell_command_history | bool

- name: Hardening | Configure SELinux / AppArmor
  block:
    - name: Install selinux-policy package
      package:
        name: selinux-policy
        state: present

    - name: Enable and configure SELinux
      selinux:
        policy: targeted
        state: enforcing
      when: ansible_selinux.status == "enabled"

    - name: Enforce AppArmor
      command: aa-enforce
      when: vault_app_armor | bool


