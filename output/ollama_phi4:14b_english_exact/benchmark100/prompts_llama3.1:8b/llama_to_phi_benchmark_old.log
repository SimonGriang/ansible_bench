---
- name: Manage RKE2 manifests and copy ingress-nginx files
  hosts: all
  become: yes
  tasks:
    - name: Create the RKE2 manifests directory
      file:
        path: /etc/rancher/rke2/config/manifests
        state: directory
        owner: root
        group: root
        mode: '0755'

