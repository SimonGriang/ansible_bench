    section: client
    option: socket
    value: "{{ mysql_socket }}"
    mode: '0644'  # Set file permissions to mitigate risky-file-permissions linting issue
  notify:
    - Restart MySQL server

- name: Initialize the MySQL database
  ansible.builtin.shell: "{{ mysql_initialize_command }}"
  when: ansible_os_family in ['Alpine', 'Archlinux']
  changed_when: false  # Ensure that the task does not report changed status if no actual change is made

- name: Start and enable the MySQL service
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place the my.cnf file
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0600'  # Set file permissions to mitigate risky-file-permissions linting issue

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('') }}"
    state: present
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


