    - rke2_implementation == 'copy'

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: "{{ rke2_artifacts_dir_mode }}"
  when:
    - airgap_mode | bool
    - rke2_implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  ansible.builtin.get_url:
    url: "{{ rke2_checksum_and_artifacts_url }}"
    dest: "{{ rke2_artifacts_dir }}"
    mode: "{{ rke2_artifacts_dir_mode }}"
  when:
    - airgap_mode | bool
    - rke2_implementation == 'download'
  register: download_result
  failed_when: download_result is failed and not (rke2_fallback_local_download | bool)

- name: Airgap mode - additional images tarballs
  ansible.builtin.copy:
    src: "{{ rke2_components_source }}"
    dest: "{{ rke2_additional_images_tarballs_dir }}"
    mode: "{{ rke2_additional_images_tarballs_mode }}"
  when:
    - airgap_mode | bool
    - rke2_implementation != 'exists'
    - additional_tarballs_to_copy | bool

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  ansible.builtin.file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: "{{ rke2_artifacts_dir_mode }}"
  when:
    - airgap_mode | bool
    - rke2_implementation == 'exists'

- name: Populate service facts
  ansible.builtin.service_facts:

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: "{{ fs_object_path }}"

- name: Check if separate partition
  ansible.builtin.command:
    cmd: "grep -q {{ partition_to_check }} {{ partition_check_path }}"
  register: partition_check_result

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: >-
      {% if fs_object_stats.isblk and partition_check_result.rc == 0 %}
        /var/lib/rancher/rke2/bin
      {% elif fs_object_stats.isblk %}
        /usr/local/bin
      {% else %}
        /usr/local/bin
      {% endif %}

- name: Check RKE2 version
  ansible.builtin.shell: |
    {{ rke2_bin_path }}/rke2 version
  register: rke2_version_output

- name: Set RKE2 versions
  ansible.builtin.set_fact:
    rke2_installed_version: "{{ rke2_version_output.stdout.split()[2] }}"
    rke2_desired_version: "{{ desired_rke2_version }}"

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that: 
      - rke2_installed_version is version(rke2_desired_version, '>=') 
    msg: "Downgrade detected: {{ rke2_installed_version }} < {{ rke2_desired_version }}"

- name: Run RKE2 install script
  ansible.builtin.command: "{{ rke2_install_script_dest }} {{ rke2_install_script_options }}"
  when:
    - rke2_installed_version != rke2_desired_version

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: "{{ custom_manifests_source }}"
    dest: "{{ custom_manifests_dest }}"
    mode: "{{ custom_manifests_mode }}"
  when:
    - custom_manifests_provided | bool

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ static_pods_source }}"
    dest: "{{ static_pods_dest }}"
    mode: "{{ static_pods_mode }}"
  when:
    - static_pods_provided | bool

- name: Copy RKE2 environment file
  ansible.builtin.copy:
    src: "{{ rke2_env_file_source }}"
    dest: "{{ rke2_env_file_dest }}"
    mode: "{{ rke2_env_file_mode }}"
  when:
    - environment_options_provided | bool


