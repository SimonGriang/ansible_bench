    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: \'0755\'\n\n- name: Set cap_ipc_lock=ep on /usr/local/bin/vault\n  command: setcap cap_ipc_lock=ep /usr/local/bin/vault\n\n- name: Touch vault.env\n  file:\n    path: "{{ vault_env_path }}"\n    state: touch\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: \'0644\'\n\n- name: Create /usr/lib/systemd/system\n  file:\n    path: "/usr/lib/systemd/system"\n    state: directory\n    owner: "root"\n    group: "root"\n    mode: \'0755\'\n\n- name: Copy the Vault service file\n  copy:\n    src: "vault.service"\n    dest: "/usr/lib/systemd/system/vault.service"\n    owner: "root"\n    group: "root"\n    mode: \'0644\'\n\n- name: Copy the Vault configuration\n  copy:\n    src: "vault.hcl"\n    dest: "{{ vault_config_path }}"\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: \'0644\'\n\n- name: Flush handlers\n  meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-13T21:02:03.421152468Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12727214885, 'load_duration': 45987830, 'prompt_eval_count': 841, 'prompt_eval_duration': 311113264, 'eval_count': 743, 'eval_duration': 12369375551, 'model_name': 'phi4:14b'} id='run--3fdf9257-c1ac-4f55-9a19-a0969bca920c-0' usage_metadata={'input_tokens': 841, 'output_tokens': 743, 'total_tokens': 1584}
