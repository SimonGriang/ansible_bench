- name: Create the RKE2 manifests directory with specific permissions and ownership
  ansible.builtin.file:
    path: /etc/rancher/rke2/server/manifests
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy kube-vip YAML files to the RKE2 manifests directory
  ansible.builtin.copy:
    src: templates/{{ item }}
    dest: /etc/rancher/rke2/server/manifests/{{ item | regex_replace('\.j2$', '') }}
    mode: '0644'
  loop:
    - kube-vip-config.j2
    - kube-vip-service.j2

- name: Copy kube-vip load balancer manifests to the RKE2 manifests directory
  ansible.builtin.copy:
    src: templates/{{ item }}
    dest: /etc/rancher/rke2/server/manifests/{{ item | regex_replace('\.j2$', '') }}
    mode: '0644'
  loop:
    - kube-vip-cloud-provider-config.j2
    - kube-vip-cloud-provider-service.j2
  when: rke2_kubevip_cloud_provider_enable | default(false) | bool


