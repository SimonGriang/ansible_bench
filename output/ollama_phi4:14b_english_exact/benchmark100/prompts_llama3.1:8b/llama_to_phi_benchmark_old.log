    state: present

- name: Place customized nginx.conf file
  ansible.builtin.template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: '0644'
  notify: Restart nginx
  register: nginx_conf
  until: nginx_conf is succeeded
  retries: 3
  delay: 5
