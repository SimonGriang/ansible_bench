---
- name: Manage etcd nodes in the cluster
  hosts: localhost
  gather_facts: no
  vars:
    rke2_cluster_group_name: "rke2_cluster"

  tasks:
    - name: Run a Kubernetes command to get the names of all nodes in the cluster
      command: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
      register: node_output
      changed_when: false

    - name: Store node names in node_names variable
      set_fact:
        node_names: "{{ node_output.stdout_lines }}"

    - name: Remove old nodes from the cluster
      command: kubectl delete node "{{ item }}"
      loop: "{{ node_names | difference(groups[rke2_cluster_group_name]) }}"
      ignore_errors: yes


