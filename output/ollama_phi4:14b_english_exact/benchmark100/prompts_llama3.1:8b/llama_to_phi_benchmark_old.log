---
- name: Ensure tasks in the playbook are properly executed and skip the rest on first run
  import_tasks: assert.yml
  when: not assert_run
  tags: 
    - assert

- name: Pre-configure Debian systems for postfix installation
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'No configuration'
    vtype: string
  when: ansible_os_family == 'Debian'

- name: Install postfix package
  package:
    name: postfix
    state: present

- name: Install postfix-mysql package if conditions are met
  package:
    name: postfix-mysql
    state: present
  when: 
    - "'mysql' in postfix_virtual_mailbox_maps"
    - "'mysql' in postfix_virtual_mailbox_domains"
    - "'mysql' in postfix_virtual_alias_maps"

- name: Configure postfix transport maps
  template:
    src: transport.j2
    dest: /etc/postfix/transport
  notify: 
    - Validate postfix configuration
    - Rebuild postfix transport maps database

- name: Configure postfix header checks
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify: 
    - Validate postfix configuration
    - Reload postfix

- name: Set values for the main.cf file
  set_fact:
    postfix_main_cf_values: >-
      {{ postfix_recipient_access|default([]) | map('regex_replace', '^(.*)$', 'recipient_access = hash:/etc/postfix/recipient_access') | list }}
      {{ postfix_sender_access|default([]) | map('regex_replace', '^(.*)$', 'sender_access = hash:/etc/postfix/sender_access') }}
      {{ postfix_mynetworks|default('') }}
      {{ postfix_mydestination|default('') }}
      {{ postfix_relay_domains|default('') }}
      {{ postfix_smtpd_recipient_restrictions|default([]) | join(', ') }}
      {{ postfix_smtpd_sender_restrictions|default([]) | join(', ') }}
      {{ postfix_virtual_mailbox_domains|default([]) | join(', ') }}
      {{ postfix_virtual_alias_domains|default([]) | join(', ') }}

- name: Configure postfix main.cf
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify: 
    - Validate postfix configuration
    - Restart postfix

- name: Configure postfix master.cf
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify: 
    - Validate postfix configuration
    - Restart postfix

- name: Create a directory for TLS certificates and keys
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /etc/ssl/certs
    - /etc/ssl/private

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_certificate_src }}"
    dest: /etc/ssl/certs/postfix.crt
    mode: '0644'
  notify: 
    - Reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_src }}"
    dest: /etc/ssl/private/postfix.key
    mode: '0600'
  notify: 
    - Reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    content: "{{ postfix_aliases }}"
    dest: /etc/postfix/aliases
  notify: 
    - Rebuild postfix alias database
    - Reload postfix

- name: Configure sender_access
  copy:
    content: "{{ postfix_sender_access }}"
    dest: /etc/postfix/sender_access
  notify: 
    - Rebuild postfix sender_access database
    - Reload postfix

- name: Configure recipient_access
  copy:
    content: "{{ postfix_recipient_access }}"
    dest: /etc/postfix/recipient_access
  notify: 
    - Validate postfix configuration
    - Rebuild postfix recipient_access database
    - Reload postfix

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_smtp_sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password
  notify: 
    - Rebuild postfix sasl_password_map database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix service
  service:
    name: postfix
    state: started
    enabled: true


