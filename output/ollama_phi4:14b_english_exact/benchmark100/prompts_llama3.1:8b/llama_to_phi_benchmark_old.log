---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "vars/{{ ansible_distribution }}-{{ ansible_distribution_major_version }}-{{ java_jdk_vendor }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: "vars/architecture.yml"

- name: Set OS-specific variables (I)
  set_fact:
    java_some_os_variable: "{{ lookup('vars', 'java_some_os_variable') | default(omit) }}"
    java_another_os_variable: "{{ lookup('vars', 'java_another_os_variable') | default(omit) }}"
  when:
    - lookup('vars', 'java_some_os_variable') is defined
    - lookup('vars', 'java_another_os_variable') is defined

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ lookup('vars', 'java_open_jdk_home_dir') | default(omit) }}"
    java_open_jdk_package: "{{ lookup('vars', 'java_open_jdk_package') | default(omit) }}"
  when:
    - lookup('vars', 'java_open_jdk_home_dir') is defined
    - lookup('vars', 'java_open_jdk_package') is defined

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "deb [arch=amd64] {{ repo_url }} {{ distro }} main"
        state: absent

    - name: Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
        update_cache: true

    - name: Add required key repositories
      apt_key:
        url: "{{ key_url }}"
        state: present

    - name: Add required repositories
      apt_repository:
        repo: "deb [arch=amd64] {{ repo_url }} {{ distro }} main"
        state: present

- name: RedHat pre-requisites
  block:
    - name: Add required key repositories
      rpm_key:
        state: present
        key: "{{ key_url }}"

    - name: Add required repositories
      yum_repository:
        name: "myrepo"
        description: "My Repo"
        baseurl: "{{ repo_url }}"
        gpgcheck: true
        gpgkey: "{{ key_url }}"
        enabled: true

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop:
    - libx11-dev
    - libxext-dev
    - libxrender-dev

- name: Install Java, Debian
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present

- name: Install Java, RedHat
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0755'

- name: Source environment variables
  shell: source /etc/profile
  args:
    executable: /bin/bash

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  shell: "update-alternatives --install /usr/bin/java java /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java 100"
  when: ansible_distribution_version is version('11', '<')

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  shell: "update-alternatives --install /usr/bin/java java /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java 100"
  when: ansible_distribution_version is version('11', '>=')


