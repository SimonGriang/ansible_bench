---
- name: Configure cAdvisor Installation
  hosts: all
  tasks:
    - name: Create the directories for the cAdvisor installation
      block:
        - file:
            path: /opt/cadvisor
            state: directory
            mode: '0755'

    - name: Download the cAdvisor binary from the internet
      get_url:
        url: "{{ cAdvisor_binary_url }}"
        dest: /opt/cadvisor/cadvisor
        mode: '0755'
        checksum: "{{ cAdvisor_checksum }}"
      when: not cAdvisor_local_binary_path.stat.exists

    - name: Copy the locally distributed cAdvisor binary
      copy:
        src: "{{ cAdvisor_local_binary_path }}"
        dest: /opt/cadvisor/cadvisor
        mode: '0755'
      when: cAdvisor_local_binary_path.stat.exists

    - name: Create a symlink to the cAdvisor binary
      file:
        src: /opt/cadvisor/cadvisor
        dest: /usr/local/bin/cadvisor
        state: link

    - name: Configure the cAdvisor systemd service
      template:
        src: cadvisor.service.j2
        dest: /etc/systemd/system/cadvisor.service
      when: cAdvisor_local_binary_path.stat.exists

    - name: Test if the cAdvisor service is active
      command: systemctl is-active cadvisor
      register: service_active
      failed_when: service_active.stdout != "active"
      changed_when: false

    - name: Enable the cAdvisor systemd service
      systemd:
        name: cadvisor
        enabled: true

    - name: Start the cAdvisor systemd service
      systemd:
        name: cadvisor
        state: started
        daemon_reload: true


