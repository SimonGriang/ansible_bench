---
- name: Import assert.yml file
  ansible.builtin.include_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install prerequisites
  ansible.builtin.package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  ansible.builtin.include_tasks:
    file: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  ansible.builtin.lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item.key }}={{ item.value }}"
    create: yes
  loop: "{{ vault_environment_settings | dict2items }}"
  notify: restart vault

- name: Include hardening tasks
  ansible.builtin.include_tasks:
    file: hardening.yml

- name: Start and enable vault on OSS
  ansible.builtin.service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"

- name: Enable vault (non-OSS)
  ansible.builtin.service:
    name: vault
    enabled: true
  when: vault_type != "oss"

handlers:
  - name: restart vault
    ansible.builtin.service:
      name: vault
      state: restarted


