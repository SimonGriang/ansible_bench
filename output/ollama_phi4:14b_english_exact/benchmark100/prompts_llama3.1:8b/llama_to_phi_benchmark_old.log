---
- name: Create the Vault group
  group:
    name: "{{ vault_group }}"
    system: true

- name: Create the Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"

- name: Create the Vault download directory
  file:
    path: "{{ vault_download_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory

- name: Download the Vault binary
  unarchive:
    src: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Check if the vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_stat

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  when: not vault_path_stat.stat.exists

- name: Create directories in vault_path
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  loop: "{{ vault_directories }}"

- name: Create data directories
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  openssl_certificate:
    path: "{{ item.path }}"
    privatekey_path: "{{ item.key }}"
    provider: selfsigned
  loop:
    - { path: "{{ vault_tls_cert_path }}", key: "{{ vault_tls_key_path }}" }

- name: Set ownership of TLS material
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  loop: "{{ vault_tls_files }}"

- name: Copy the Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "/usr/local/bin/vault"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Set cap_ipc_lock=ep on /usr/local/bin/vault
  command: setcap cap_ipc_lock=ep /usr/local/bin/vault

- name: Touch vault.env
  file:
    path: "{{ vault_env_path }}"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'

- name: Create /usr/lib/systemd/system
  file:
    path: "/usr/lib/systemd/system"
    state: directory
    owner: "root"
    group: "root"
    mode: '0755'

- name: Copy the Vault service file
  copy:
    src: "vault.service"
    dest: "/usr/lib/systemd/system/vault.service"
    owner: "root"
    group: "root"
    mode: '0644'

- name: Copy the Vault configuration
  copy:
    src: "vault.hcl"
    dest: "{{ vault_config_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'

- name: Flush handlers
  meta: flush_handlers


