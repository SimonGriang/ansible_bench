---
- name: Create the RKE2 config directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: server_type == 'server'

- name: Copy RKE2 config
  ansible.builtin.copy:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed

- name: Copy kubelet config
  ansible.builtin.copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed
  when: (rke2_custom_registry_mirrors | length > 0) or 
        (rke2_custom_registry_configs | length > 0)

- name: Register etcd restore from file
  ansible.builtin.set_fact:
    do_etcd_restore: true
  when:
    - rke2_etcd_snapshot_file | length > 0
    - (rke2_server_service is not defined or 
       rke2_server_service.status == 'disabled')

- name: Register etcd restore from s3
  ansible.builtin.set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file | length > 0
    - rke2_etcd_snapshot_s3_options is defined
    - rke2_etcd_snapshot_s3_options.access_key is defined
    - rke2_etcd_snapshot_s3_options.secret_key is defined
    - rke2_etcd_snapshot_s3_options.bucket is defined
    - rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      ansible.builtin.file:
        path: /var/lib/rancher/rke2/etcd-snapshots
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Copy etcd snapshot file
      ansible.builtin.copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/etcd-snapshots/snapshot.db
        owner: root
        group: root
        mode: '0600'

    - name: Restore etcd from snapshot using rke2 server command
      ansible.builtin.command:
        cmd: rke2 server --restore-etcd-snapshot /var/lib/rancher/rke2/etcd-snapshots/snapshot.db
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Restore etcd from s3 snapshot using rke2 server command
      ansible.builtin.command:
        cmd: rke2 server --restore-etcd-snapshot-s3 "{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  ansible.builtin.service:
    name: rke2-server
    state: started
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Mask RKE2 agent service on the first server
  ansible.builtin.systemd:
    name: rke2-agent
    masked: yes
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - no CNI
  ansible.builtin.command:
    cmd: kubectl get node --no-headers
  register: node_status
  until: "'Ready' in node_status.stdout and 'CNI' not in node_status.stdout"
  retries: 30
  delay: 10
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - with CNI
  ansible.builtin.command:
    cmd: kubectl get nodes --no-headers
  register: node_status
  until: "'Ready' in node_status.stdout"
  retries: 30
  delay: 10
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Restore etcd
  block:
    - name: Remove old secrets
      ansible.builtin.command:
        cmd: kubectl delete secrets --all

    - name: Remove old nodes
      ansible.builtin.command:
        cmd: kubectl delete nodes --all

    - name: Create new nodes
      ansible.builtin.command:
        cmd: kubectl apply -f <node-spec-file>
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Set an Active Server variable
  ansible.builtin.set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  with_items: "{{ groups['rke2_cluster_group_name'] }}"
