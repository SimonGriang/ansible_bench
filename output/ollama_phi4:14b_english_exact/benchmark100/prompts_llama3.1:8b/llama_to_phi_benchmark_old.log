---
- name: Create an SSL private key
  openssl_privatekey:
    path: /path/to/private_key.pem
    size: 2048
    state: present
    owner: root
    group: root
    mode: '0600'

- name: Create an SSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /path/to/csr.pem
    privatekey_path: /path/to/private_key.pem
    common_name: example.com
    country_name: US
    state_or_province_name: California
    locality_name: San Francisco
    organization_name: Example Corp
    organizational_unit_name: IT
    state: present
    owner: root
    group: root
    mode: '0600'

- name: Create an SSL certificate
  x509_certificate:
    path: /path/to/certificate.pem
    privatekey_path: /path/to/private_key.pem
    csr_path: /path/to/csr.pem
    provider: selfsigned
    not_valid_before: "{{ ansible_date_time.iso8601 }}"
    not_valid_after: "+1y"
    state: present
    owner: root
    group: root
    mode: '0644'

- name: Create a PKCS#12 file
  openssl_pkcs12:
    dest: /path/to/certificate.p12
    privatekey_path: /path/to/private_key.pem
    certificate_path: /path/to/certificate.pem
    password: 'strongpassword'
    state: present
    owner: root
    group: root
    mode: '0600'

- name: Read the private key
  slurp:
    src: /path/to/private_key.pem
  register: private_key

- name: Read the certificate
  slurp:
    src: /path/to/certificate.pem
  register: certificate

- name: Create a combined private key and certificate file
  copy:
    dest: /path/to/combined_key_cert.pem
    content: |
      {{ private_key.content | b64decode }}
      {{ certificate.content | b64decode }}
    owner: root
    group: root
    mode: '0644'


