n\n- name: Place the server.conf file\n  template:\n    src: server.conf.j2\n    dest: /etc/openvpn/server.conf\n    owner: root\n    group: root\n    mode: '0644'\n```" additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-13T21:25:06.052606021Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11353936211, 'load_duration': 71143003, 'prompt_eval_count': 1683, 'prompt_eval_duration': 16008859, 'eval_count': 653, 'eval_duration': 11264958954, 'model_name': 'phi4:14b'} id='run--6884f641-78c6-42d5-9960-68f22ff5d797-0' usage_metadata={'input_tokens': 1683, 'output_tokens': 653, 'total_tokens': 2336}
