---
- name: Import Java Asserts and Setup Local Task Execution
  import_tasks: assert.yml
  tags: setup

- name: Install Bash
  package:
    name: bash
    state: present

- name: Install OpenJDK Java (Package)
  package:
    name: openjdk-{{ java_version }}
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM (Local Java Source)
  block:
    - name: Copy Oracle Java RPM package to /tmp
      copy:
        src: "{{ oracle_java_rpm }}"
        dest: /tmp/oracle-java.rpm

    - name: Install Oracle Java RPM package
      package:
        name: /tmp/oracle-java.rpm
        state: present
  when: java_source == "local" and java_format == "rpm"

- name: Install DEB (Local Java Source)
  block:
    - name: Copy Oracle Java DEB package to /tmp
      copy:
        src: "{{ oracle_java_deb }}"
        dest: /tmp/oracle-java.deb

    - name: Install Oracle Java DEB package
      apt:
        deb: /tmp/oracle-java.deb
        state: present
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java (RPM) (Repository)
  package:
    name: oracle-java-{{ java_version }}-rpm
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Targz
  block:
    - name: Ensure Java Install Directory Exists
      file:
        path: "{{ java_install_directory }}"
        state: directory

    - name: Install Oracle Java Targz Package
      unarchive:
        src: "{{ oracle_java_targz }}"
        dest: "{{ java_install_directory }}"
        remote_src: yes
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java Policy Software (Targz)
  unarchive:
    src: "{{ oracle_java_policy_targz }}"
    dest: "{{ java_install_directory }}"
    remote_src: yes
  when: java_jce | bool and java_version == "8" and java_vendor == "oracle"

- name: Set Alternative (Targz)
  alternatives:
    name: java
    path: "{{ java_install_directory }}/bin/java"
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  shell: readlink -f /usr/bin/java | sed "s:bin/java::"
  register: java_home

- name: Set JAVA_HOME in /etc/profile.d/java_home.sh
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME={{ java_home.stdout }}'
    create: yes


