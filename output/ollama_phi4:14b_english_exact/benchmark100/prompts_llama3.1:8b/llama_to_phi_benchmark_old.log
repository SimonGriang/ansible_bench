---
- name: Import assert.yml and run it once on the localhost
  import_tasks: assert.yml

- name: Install apache httpd package
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux if enabled
  when: selinux.enabled
  block:
    - name: Set SELinux booleans
      selinux:
        policy: targeted
        state: enforcing
        boolean: "{{ item }}"
        value: 'on'
      loop: "{{ httpd_sebooleans }}"

    - name: Allow connections to custom ports
      seport:
        ports: "{{ item }}"
        proto: tcp
        setype: http_port_t
        state: present
      loop:
        - "{{ httpd_port }}"
        - "{{ httpd_ssl_port }}"

- name: Configure httpd service
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'

- name: Activate httpd module on Debian systems
  when: ansible_os_family == "Debian"
  command: a2enmod {{ item }}
  loop: "{{ httpd_modules_to_activate_with_command }}"

- name: Import ssl.yml if https_ssl_enable is true
  when: https_ssl_enable is true
  import_tasks: ssl.yml

- name: Import locations.yml if httpd_locations is defined
  when: httpd_locations is defined
  import_tasks: locations.yml

- name: Import vhosts.yml if httpd_vhosts is defined
  when: httpd_vhosts is defined
  import_tasks: vhosts.yml

- name: Configure ports for Debian and Suse systems
  when: ansible_os_family in ["Debian", "Suse"]
  template:
    src: "{{ httpd_ports_conf.j2 }}"
    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
    mode: '0644'

- name: Import directories.yml if httpd_directories is defined
  when: httpd_directories is defined
  import_tasks: directories.yml

- name: Remove default index.html if httpd_remove_example is true
  when: httpd_remove_example is true
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent

- name: Start and enable httpd service
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


