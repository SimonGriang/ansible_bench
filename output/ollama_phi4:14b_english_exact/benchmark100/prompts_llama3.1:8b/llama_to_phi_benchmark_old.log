    state: present

- name: Copy fail2ban filters
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: '0640'
  loop: "{{ fail2ban_filterd_path }}"
  when: fail2ban_filterd_path is defined
  notify: restart fail2ban

- name: Configure fail2ban.local
  ansible.builtin.template:
    src: fail2ban.local.j2
    dest: /etc/fail2ban/fail2ban.local
    owner: root
    mode: '0640'
  vars:
    fail2ban_options: "{{ fail2ban_base_configuration | combine(fail2ban_configuration) }}"
  notify: restart fail2ban

- name: Configure jail.local
  ansible.builtin.template:
    src: jail.local.j2
    dest: /etc/fail2ban/jail.local
    owner: root
    mode: '0640'
  vars:
    jail_options: "{{ fail2ban_base_jail_configuration | combine(fail2ban_jail_configuration) }}"
  notify: restart fail2ban

- name: Check the existence of the auth log file
  ansible.builtin.stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Create the auth log file if it does not exist
  ansible.builtin.file:
    path: /var/log/auth.log
    state: touch
    mode: '0640'
  when: fail2ban_auth is defined and not fail2ban_auth.stat.exists

- name: Start and enable the fail2ban service
  ansible.builtin.service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: true

handlers:
  - name: restart fail2ban
    ansible.builtin.service:
      name: "{{ fail2ban_service }}"
      state: restarted


