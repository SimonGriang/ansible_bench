---
- name: Create an SSL private key
  ansible.builtin.openssl_privatekey:
    path: "{{ ssl_private_key_path }}"
    size: 2048
    mode: "{{ ssl_private_key_mode }}"
    owner: "{{ ssl_private_key_owner }}"
    group: "{{ ssl_private_key_group }}"
  register: ssl_private_key

- name: Create an SSL Certificate Signing Request (CSR)
  ansible.builtin.openssl_csr:
    path: "{{ ssl_csr_path }}"
    privatekey_path: "{{ ssl_private_key_path }}"
    common_name: "{{ ssl_common_name }}"
    country_name: "{{ ssl_country_name | default(omit) }}"
    state_or_province_name: "{{ ssl_state_or_province_name | default(omit) }}"
    locality_name: "{{ ssl_locality_name | default(omit) }}"
    organization_name: "{{ ssl_organization_name | default(omit) }}"
    organizational_unit_name: "{{ ssl_organizational_unit_name | default(omit) }}"
    email_address: "{{ ssl_email_address | default(omit) }}"
    mode: "{{ ssl_csr_mode }}"
    owner: "{{ ssl_csr_owner }}"
    group: "{{ ssl_csr_group }}"
  register: ssl_csr

- name: Create SSL certificates
  ansible.builtin.openssl_certificate:
    path: "{{ ssl_certificate_path }}"
    privatekey_path: "{{ ssl_private_key_path }}"
    csr_path: "{{ ssl_csr_path }}"
    provider:
      name: selfsigned
      subject: |
        /C={{ ssl_country_name }}
        /ST={{ ssl_state_or_province_name }}
        /L={{ ssl_locality_name }}
        /O={{ ssl_organization_name }}
        /OU={{ ssl_organizational_unit_name }}
        /CN={{ ssl_common_name }}
    mode: "{{ ssl_certificate_mode }}"
    owner: "{{ ssl_certificate_owner }}"
    group: "{{ ssl_certificate_group }}"
  register: ssl_certificate

- name: Create a PKCS#12 file
  ansible.builtin.openssl_pkcs12:
    dest: "{{ ssl_pkcs12_path }}"
    privatekey_path: "{{ ssl_private_key_path }}"
    cert_path: "{{ ssl_certificate_path }}"
    friendly_name: "{{ ssl_friendly_name }}"
    passphrase: "{{ ssl_passphrase }}"
    mode: "{{ ssl_pkcs12_mode }}"
    owner: "{{ ssl_pkcs12_owner }}"
    group: "{{ ssl_pkcs12_group }}"
  register: ssl_pkcs12

- name: Read the private key
  ansible.builtin.slurp:
    path: "{{ ssl_private_key_path }}"
  register: ssl_private_key_content

- name: Read the certificate
  ansible.builtin.slurp:
    path: "{{ ssl_certificate_path }}"
  register: ssl_certificate_content

- name: Create a combined private key and certificate file
  ansible.builtin.copy:
    dest: "{{ ssl_combined_path }}"
    content: |
      {{ ssl_private_key_content.content | b64decode }}
      {{ ssl_certificate_content.content | b64decode }}
    mode: "{{ ssl_combined_mode }}"
    owner: "{{ ssl_combined_owner }}"
    group: "{{ ssl_combined_group }}"


