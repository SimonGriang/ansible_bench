---
- name: Cordon and Drain the specified RKE2 node
  command: >
    "{{ rke2_data_path }}/bin/kubectl cordon {{ rke2_node_name }} &&
    {{ rke2_data_path }}/bin/kubectl drain {{ rke2_node_name }} --ignore-daemonsets 
    --delete-local-data --force --timeout 0 {{ rke2_drain_additional_args | join(' ') }}"
  register: cordon_drain_result
  until: cordon_drain_result.rc == 0
  retries: 100
  delay: 15

- name: Restart the RKE2 service on the specified node
  service:
    name: "{{ rke2_service_name }}"
    state: restarted

- name: Wait for all nodes to be ready again
  command: >
    "{{ rke2_data_path }}/bin/kubectl get nodes --field-selector=status.phase=Running 
    -l node-group={{ rke2_cluster_group_name }}"
  register: nodes_ready_result
  until: nodes_ready_result.stdout | length > 0
  retries: 100
  delay: 15

- name: Uncordon the specified RKE2 node
  command: "{{ rke2_data_path }}/bin/kubectl uncordon {{ rke2_node_name }}"

- name: Wait for all pods to be ready again
  command: >
    "{{ rke2_data_path }}/bin/kubectl get pods --all-namespaces 
    --field-selector=status.phase=Running"
  register: pods_ready_result
  until: pods_ready_result.stdout | length > 0
  retries: 100
  delay: 15

- name: Wait for all pods to pass readiness checks
  command: >
    "{{ rke2_data_path }}/bin/kubectl get pods --all-namespaces 
    --field-selector=status.conditions[?(@.type=='Ready')].status=='True' 
    {{ rke2_wait_for_all_pods_to_be_healthy_args | join(' ') }}"
  register: pods_health_check_result
  until: pods_health_check_result.stdout | length > 0
  retries: 100
  delay: 15


