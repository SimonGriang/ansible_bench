  tasks:
    - name: Create the document root for each vhost
      file:
        path: "{{ item.docroot }}"
        state: directory
        mode: '0755'
      loop: "{{ httpd_vhosts }}"
      when: item.docroot is defined and (item.create_docroot is not defined or item.create_docroot)

    - name: Configure the vhosts
      template:
        src: "{{ item.vhost_conf_template }}"
        dest: "/etc/httpd/conf.d/{{ item.name }}.conf"
        mode: '0644'
      loop: "{{ httpd_vhosts }}"
      notify:
        - Test httpd configuration validity
        - Restart httpd

  handlers:
    - name: Test httpd configuration validity
      command: httpd -t

    - name: Restart httpd
      service:
        name: httpd
        state: restarted


