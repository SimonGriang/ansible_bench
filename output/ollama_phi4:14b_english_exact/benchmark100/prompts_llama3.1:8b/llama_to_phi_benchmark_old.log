---
- name: Import custom assertions
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost

- name: Install nginx package
  ansible.builtin.package:
    name: nginx
    state: present

- name: Place customized nginx.conf file
  ansible.builtin.template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: '0644'
  notify: Restart nginx
  register: nginx_conf
  until: nginx_conf is succeeded
  retries: 3
  delay: 5
  vars:
    config_test: "nginx -t -c {{ ansible_facts['ansible_env']['PWD'] }}/etc/nginx/nginx.conf"

- name: Ensure /etc/nginx/conf.d directory exists
  ansible.builtin.file:
    path: /etc/nginx/conf.d
    state: directory
    mode: '0755'

- name: Place customized default.conf file
  ansible.builtin.template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'
  notify: Restart nginx

- name: Start and enable nginx service
  ansible.builtin.service:
    name: nginx
    state: started
    enabled: yes

handlers:
  - name: Restart nginx
    ansible.builtin.service:
      name: nginx
      state: restarted


