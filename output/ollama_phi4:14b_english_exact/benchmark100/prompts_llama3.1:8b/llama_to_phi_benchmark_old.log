---
- name: SELinux Configuration Playbook
  hosts: localhost
  gather_facts: yes
  tasks:
    - name: Import assert.yml
      ansible.builtin.import_tasks:
        file: assert.yml
      when: ansible_hostname == 'localhost'
      tags:
        - import_assert

    - name: Install required packages for SELinux
      ansible.builtin.package:
        name: "{{ selinux_requirements }}"
        state: present
      notify: Gather facts
      tags:
        - install_packages

    - name: Flush handlers
      ansible.builtin.meta: flush_handlers

    - name: Configure SELinux
      ansible.posix.selinux:
        policy: "{{ selinux_policy }}"
        state: "{{ selinux_state }}"
      when: 
        - selinux_state == "enforcing"
        - ansible_connection != "docker"
        - ansible_connection != "container"
      notify:
        - Reboot
      tags:
        - configure_selinux

    - name: Manage SELinux booleans
      ansible.posix.seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      when: selinux_booleans is defined
      tags:
        - manage_booleans

  handlers:
    - name: Gather facts
      ansible.builtin.setup:

    - name: Reboot
      ansible.builtin.reboot:


