_duration': 268453682, 'eval_count': 459, 'eval_duration': 6842564302, 'model_name': 'phi4:14b'} id='run--734ded37-f43f-4e1f-91eb-bec562add8b0-0' usage_metadata={'input_tokens': 546, 'output_tokens': 459, 'total_tokens': 1005}
