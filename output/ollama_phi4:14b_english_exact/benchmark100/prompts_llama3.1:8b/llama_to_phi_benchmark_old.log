---
- name: Manage bootstrap facts
  hosts: all
  gather_facts: no
  vars:
    bootstrap_os_family_map:
      - { key: 'Debian', value: ['Debian', 'Ubuntu'] }
      - { key: 'RedHat', value: ['RedHat', 'CentOS', 'Fedora'] }
    bootstrap_search:
      'Debian': '^ID="debian"'
      'RedHat': '^ID="rhel"'

  tasks:
    - name: Gather Bootstrap Facts
      shell: cat /etc/os-release
      register: bootstrap_facts
      become: false

    - name: Set Bootstrap Distribution Facts (I)
      vars:
        flattened_os_family_map: "{{ bootstrap_os_family_map | map(attribute='value') | list | flatten }}"
