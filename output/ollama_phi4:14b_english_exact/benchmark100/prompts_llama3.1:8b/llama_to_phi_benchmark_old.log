  hosts: all
  vars:
    core_dependencies_conflicting_packages: []
    core_dependencies_packages: []

  tasks:
    - name: Remove packages that conflict with core dependencies
      package:
        name: "{{ core_dependencies_conflicting_packages }}"
        state: absent

    - name: Install core dependencies
      package:
        name: "{{ core_dependencies_packages }}"
        state: present
      notify: Update Package Cache
      tags: core_dependencies

  handlers:
    - name: Update Package Cache
      package:
        update_cache: true

    - name: Flush handler notifications
      meta: flush_handlers


