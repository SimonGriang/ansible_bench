    state: directory
    mode: '0755'

- name: Place customized default.conf file
  ansible.builtin.template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'
  notify: Restart nginx

- name: Start and enable nginx service
  ansible.builtin.service:
    name: nginx
    state: started
    enabled: yes

handlers:
  - name: Restart nginx
