    - name: Copy Oracle Java DEB package to /tmp
      copy:
        src: "{{ oracle_java_deb }}"
        dest: /tmp/oracle-java.deb

    - name: Install Oracle Java DEB package
      apt:
        deb: /tmp/oracle-java.deb
        state: present
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java (RPM) (Repository)
  package:
    name: oracle-java-{{ java_version }}-rpm
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Targz
  block:
    - name: Ensure Java Install Directory Exists
      file:
        path: "{{ java_install_directory }}"
        state: directory

    - name: Install Oracle Java Targz Package
      unarchive:
        src: "{{ oracle_java_targz }}"
        dest: "{{ java_install_directory }}"
        remote_src: yes
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java Policy Software (Targz)
  unarchive:
    src: "{{ oracle_java_policy_targz }}"
    dest: "{{ java_install_directory }}"
    remote_src: yes
  when: 
