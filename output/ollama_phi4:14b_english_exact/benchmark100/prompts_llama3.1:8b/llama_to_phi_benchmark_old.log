---
- name: Set the package state based on how Ansible is installed
  hosts: all
  tasks:
    - name: Determine the package state for Ansible based on the installation method
      set_fact:
        ansible_package_state: >-
          {{ 'present' if ansible_install_method == 'package' else 'latest' }}

- name: Set up Ansible on RedHat
  hosts: RedHat
  tasks:
    - name: Configure Ansible for RedHat-based systems
      block:
        - name: Install EPEL repository
          yum:
            name: epel-release
            state: present

        - name: Install Ansible dependencies
          yum:
            name: "{{ item }}"
            state: present
          loop:
            - python3
            - python3-pip
            - python3-virtualenv

        - name: Install Ansible
          yum:
            name: ansible
            state: "{{ ansible_package_state }}"

- name: Set up Ansible on Fedora
  hosts: Fedora
  tasks:
    - name: Configure Ansible for Fedora systems
      block:
        - name: Install Ansible dependencies
          dnf:
            name: "{{ item }}"
            state: present
          loop:
            - python3
            - python3-pip
            - python3-virtualenv

        - name: Install Ansible
          dnf:
            name: ansible
            state: "{{ ansible_package_state }}"

- name: Set up Ansible on Ubuntu
  hosts: Ubuntu
  tasks:
    - name: Configure Ansible for Ubuntu systems
      block:
        - name: Install Ansible dependencies
          apt:
            name: "{{ item }}"
            state: present
          loop:
            - software-properties-common
            - python3
            - python3-pip
            - python3-virtualenv

        - name: Add Ansible PPA
          apt_repository:
            repo: ppa:ansible/ansible
            state: present

        - name: Install Ansible
          apt:
            name: ansible
            state: "{{ ansible_package_state }}"

- name: Set up Ansible on Debian
  hosts: Debian
  tasks:
    - name: Configure Ansible for Debian systems
      block:
        - name: Install Ansible dependencies
          apt:
            name: "{{ item }}"
            state: present
          loop:
            - python3
            - python3-pip
            - python3-virtualenv

        - name: Add Ansible repository
          apt_repository:
            repo: deb http://ppa.launchpad.net/ansible/ansible/ubuntu xenial main
            state: present
            filename: ansible

        - name: Install Ansible
          apt:
            name: ansible
            state: "{{ ansible_package_state }}"

- name: Set up Ansible using Pip
  hosts: all
  tasks:
    - name: Configure Ansible for installation using Pip
      block:
        - name: Install Ansible using Pip
          pip:
            name: ansible
            state: "{{ ansible_package_state }}"


