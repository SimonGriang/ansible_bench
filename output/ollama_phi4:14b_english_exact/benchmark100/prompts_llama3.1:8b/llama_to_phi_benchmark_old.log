---
- name: Configure SSL and HTTP to HTTPS redirect for Apache
  hosts: all
  become: yes

  tasks:
    - name: Install required SSL packages
      package:
        name: "{{ httpd_ssl_packages }}"
        state: present

    - name: Place SSL configuration file
      template:
        src: ssl.conf.j2
        dest: "{{ httpd_config_directory }}/ssl.conf"
        mode: '0644'
      notify: 
        - Test Apache configuration
        - Restart Apache service

    - name: Configure HTTP to HTTPS redirect
      template:
        src: default_vhost_conf.j2
        dest: "{{ httpd_config_directory }}/{{ default_vhost_conf_filename }}"
        mode: '0644'
      notify: 
        - Test Apache configuration
        - Restart Apache service

  handlers:
    - name: Test Apache configuration
      command: httpd -t

    - name: Restart Apache service
      service:
        name: httpd
        state: restarted


