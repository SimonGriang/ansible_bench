---
- name: Remove Docker GPG key from trusted.gpg.d if present
  ansible.builtin.file:
    path: /etc/apt/trusted.gpg.d/docker-archive-keyring.gpg
    state: absent

- name: Remove old Docker apt source list
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Uninstall old versions of Docker
  ansible.builtin.package:
    name:
      - docker
      - docker-engine
      - docker.io
      - containerd
      - runc
    state: absent

- name: Remove legacy Docker repository file
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install required dependencies
  ansible.builtin.apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: yes

- name: Add or remove Docker repository
  ansible.builtin.apt_repository:
    repo: "deb [arch={{ ansible_architecture }}] https://download.docker.com/linux/{{ ansible_distribution | lower }} {{ ansible_distribution_release }} stable"
    state: "{{ 'present' if docker_add_repo else 'absent' }}"
  notify: update apt cache

- name: Notify apt update handler
  ansible.builtin.meta:  
    flush_handlers: yes


