---
- name: Restart RKE2 service on a node
  ansible.builtin.service:
    name: rke2-server
    state: restarted
  vars:
    rke2_node_name: "{{ rke2_node_name }}"
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  ansible.builtin.shell: >
    rke2 node list --ready-only | grep "Ready" | wc -l
  register: all_ready_nodes
  until: all_ready_nodes.stdout == "{{ groups[rke2_servers_group_name] | length }}"
  retries: 100
  delay: 15
  delegate_to: >
    {{ groups[rke2_servers_group_name][0] if not hostvars[inventory_hostname]['rke2_active_server']
    else hostvars[inventory_hostname]['rke2_active_server'] }}
  run_once: true
  when: ansible_check_mode == false

- name: Wait for all pods to be ready again
  ansible.builtin.shell: >
    kubectl get pods --all-namespaces
    --field-selector=status.phase!=Running,status.phase!=Succeeded | wc -l
  register: all_pods_ready
  until: all_pods_ready.stdout == "0"
  retries: 100
  delay: 15
  delegate_to: >
    {{ groups[rke2_servers_group_name][0] if not hostvars[inventory_hostname]['rke2_active_server']
    else hostvars[inventory_hostname]['rke2_active_server'] }}
  run_once: true
  when: ansible_check_mode == false and rke2_wait_for_all_pods_to_be_ready | default(false)


