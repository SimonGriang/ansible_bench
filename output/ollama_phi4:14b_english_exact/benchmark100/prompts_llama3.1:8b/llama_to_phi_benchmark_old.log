---
- name: Import assert.yml file
  import_tasks: assert.yml
  delegate_to: localhost

- name: Uninstall the systemd-logger package
  package:
    name: systemd-logger
    state: absent

- name: Install rsyslog and its required packages
  package:
    name: "{{ rsyslog_packages + ['rsyslog'] }}"
    state: present

- name: Install additional rsyslog features or packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features }}"

- name: Configure the default rsyslog configuration
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    mode: '0644'
  notify: Restart rsyslog
  when: rsyslog_deploy_default_config

- name: Create the /etc/rsyslog.d/ directory with proper permissions
  file:
    path: /etc/rsyslog.d/
    state: directory
    mode: '0755'

- name: Configure a forward rule for rsyslog
  template:
    src: forward_rule.conf.j2
    dest: /etc/rsyslog.d/forward_rule.conf
    mode: '0644'
  notify: Restart rsyslog
  when: not rsyslog_deploy_default_config

- name: Configure additional rsyslog configuration files
  template:
    src: "{{ item.value.src }}"
    dest: "{{ item.value.dest }}"
    mode: '0440'
    owner: root
    group: root
  notify: Restart rsyslog
  loop: "{{ rsyslog_rsyslog_d_files | dict2items }}"

- name: Start and enable the rsyslog service
  service:
    name: rsyslog
    state: started
    enabled: yes


