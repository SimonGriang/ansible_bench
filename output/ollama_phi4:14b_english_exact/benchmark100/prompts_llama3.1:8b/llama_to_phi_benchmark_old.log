---
- name: Install Keepalived when HA mode is enabled
  include: keepalived.yml
  when:
    - ha_mode_enabled
    - "'rke2_servers_group' in group_names"

- name: Download and install RKE2 {{ rke2_version }}
  include: rke2.yml

- name: CIS Hardening
  include: cis.yml
  when: cis_profile is defined

- name: Find Active Server
  include: find_active_server.yml

- name: Enable IPVS kernel module
  include: enable_ipvs.yml
  when:
    - ha_mode_enabled
    - "'rke2_servers_group' in group_names"
    - ipvs_lb_enabled

- name: Copy kube-vip manifests to the masternode
  include: kubevip.yml
  when:
    - ha_mode_enabled
    - "'rke2_servers_group' in group_names"
    - ipvs_lb_enabled
    - inventory_hostname == groups['rke2_servers_group'][0]

- name: Copy ingress-nginx manifests to the masternode
  include: ingress-nginx.yml
  when:
    - "'rke2_servers_group' in group_names"
    - ingress_nginx_values is defined
    - inventory_hostname == groups['rke2_servers_group'][0]

- name: Prepare very first server node in the cluster
  include: first_server.yml
  when:
    - "'rke2_servers_group' in group_names"
    - (active_server is not defined or hostvars[groups['rke2_servers_group'][0]].count == 1)

- name: Restore etcd specific tasks
  include: first_server_restore.yml
  when:
    - active_server is defined
    - (inventory_hostname == groups['rke2_servers_group'][0] or inventory_hostname == groups['rke2_servers_group'][-1])
    - etcd_restore_required

- name: Download kubeconfig to ansible localhost
  include: download_kubeconfig.yaml
  when:
    - "'rke2_servers_group' in group_names"
    - inventory_hostname == groups['rke2_servers_group'][0]
    - kubeconfig_download_required

- name: Prepare and join remaining nodes of the cluster
  include: remaining_nodes.yml
  when:
    - active_server is defined
    - groups['rke2_servers_group'].count > 1

- name: Rolling cordon and drain restart when version changes - servers
  include: rolling_restart.yml
  loop: "{{ groups['rke2_servers_group'] }}"
  when:
    - version_changed
    - rke2_installed

- name: Rolling cordon and drain restart when version changes - agents
  include: rolling_restart.yml
  loop: "{{ groups['rke2_agents_group'] }}"
  when:
    - version_changed
    - rke2_installed

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  include: change_config.yml
  loop: "{{ groups['rke2_servers_group'] + groups['rke2_agents_group'] }}"
  when:
    - config_files_changed
    - rke2_restart_required

- name: Final steps
  include: summary.yml


