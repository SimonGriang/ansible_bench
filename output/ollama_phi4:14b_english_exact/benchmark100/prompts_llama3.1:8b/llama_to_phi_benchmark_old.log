---
- name: Import assert.yml and run it once on localhost
  include_tasks: assert.yml

- name: Install the mysql package
  package:
    name: mysql
    state: present

- name: Configure the mysql server
  template:
    src: mysql-server.cnf.j2
    dest: "{{ destination_directory }}/{{ mysql_name }}-server.cnf"
  vars:
    mysql_configuration_options:
      - option1: value1
      - option2: value2
  loop: "{{ mysql_configuration_options }}"
  loop_control:
    loop_var: option
  become: true

- name: Configure the mysql client
  template:
    src: mysql-client.cnf.j2
    dest: "{{ destination_directory }}/{{ mysql_name }}-client.cnf"
  vars:
    socket_option: socket
    socket_value: /var/run/mysqld/mysqld.sock
  loop:
    - { option: socket, value: /var/run/mysqld/mysqld.sock }
  loop_control:
    loop_var: option
  become: true

- name: Initialize the mysql service
  command: "{{ mysql_initialize_command }}"
  when: ansible_os_family in ['Alpine', 'Archlinux']
  become: true

- name: Start and enable the mysql service
  service:
    name: mysql
    state: started
    enabled: true
  become: true

- name: Flush handlers
  meta: flush_handlers

- name: Create a my.cnf file in the /root/.my.cnf directory
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
  become: true

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  become: true

- name: List databases
  community.mysql.mysql_info:
    db: "information_schema"
    login_user: "root"
    login_password: "{{ mysql_root_password }}"

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
  loop: "{{ mysql_databases }}"
  loop_control:
    loop_var: item
  when: item.initial_import is defined
  become: true

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"
  become: true

- name: Flush handlers again
  meta: flush_handlers


