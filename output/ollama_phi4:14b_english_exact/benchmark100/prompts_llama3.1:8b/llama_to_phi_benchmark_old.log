- name: Import and Install docker-compose
  hosts: localhost
  gather_facts: no
  tasks:
    - name: Import assert.yml tasks
      ansible.builtin.import_tasks: assert.yml
      delegate_to: localhost
      run_once: true

    - name: Install docker-compose package
      ansible.builtin.package:
        name: docker-compose
      when: docker_compose_installation_type == "package"

    - name: Install required packages for docker-compose binary
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ docker_compose_binary_required_packages }}"
      when: docker_compose_installation_type == "binary"

    - name: Install docker-compose as a binary
      ansible.builtin.get_url:
        url: "{{ docker_compose_url }}"
        dest: /usr/local/bin/docker-compose
        mode: '0755'
      when: docker_compose_installation_type == "binary"


