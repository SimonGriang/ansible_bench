---
- name: Import assert.yml for package manager identification
  include_tasks: assert.yml

- name: Configure package management for apk
  block:
    - name: Update cache for apk
      ansible.builtin.package:
        name: '*'
        state: latest
        update_cache: true
  when: ansible_pkg_mgr == 'apk'

- name: Configure package management for apt
  block:
    - name: Prevent certain packages from being upgraded
      ansible.builtin.apt:
        name: '{{ packages_to_pin }}'
        state: present
        allow_downgrade: true
        pin: 'priority=1001'
    - name: Update all software
      ansible.builtin.apt:
        upgrade: dist
    - name: Autoremove unnecessary packages
      ansible.builtin.apt:
        autoremove: true
  when: ansible_pkg_mgr == 'apt'

- name: Update all software for dnf
  block:
    - name: Exclude certain packages and update all
      ansible.builtin.dnf:
        name: '*'
        state: latest
        exclude: '{{ exclude_packages }}'
  when: ansible_pkg_mgr == 'dnf'

- name: Update all software for pacman
  block:
    - name: Update package cache
      ansible.builtin.pacman:
        update_cache: true
    - name: Upgrade all packages
      ansible.builtin.pacman:
        name: '*'
        state: latest
  when: ansible_pkg_mgr == 'pacman'

- name: Configure package management for yum
  block:
    - name: Use dnf for specific yum versions and ensure yum-utils is installed
      block:
        - name: Update all software using dnf
          ansible.builtin.dnf:
            name: '*'
            state: latest
        - name: Install yum-utils
          ansible.builtin.package:
            name: yum-utils
            state: present
  when: ansible_pkg_mgr == 'yum' and 
        ansible_distribution_version | version_compare('6', '<')

- name: Update all software for zypper
  block:
    - name: Update all packages to the latest version
      ansible.builtin.zypper:
        name: '*'
        state: latest
  when: ansible_pkg_mgr == 'zypper'
