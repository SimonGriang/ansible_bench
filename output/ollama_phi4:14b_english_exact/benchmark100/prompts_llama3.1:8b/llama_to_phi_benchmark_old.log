---
- name: Install epel repositories and packages
  hosts: all
  become: yes
  vars:
    epel_gpg_key: "https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-7"
    epel_url: "https://dl.fedoraproject.org/pub/epel/epel-release-latest-7.noarch.rpm"
    epel_next: false  # Set to true to install epel-next-release

  tasks:
    - name: Install epel package repositories for compatible operating systems
      yum_repository:
        name: epel
        description: EPEL YUM repository
        baseurl: "https://dl.fedoraproject.org/pub/epel/$releasever/$basearch/"
        gpgcheck: yes
        enabled: yes
        gpgkey: "{{ epel_gpg_key }}"
      when: ansible_os_family == "RedHat" and (ansible_distribution == "RedHat" or ansible_distribution == "Amazon")

    - name: Install the epel GPG key
      rpm_key:
        state: present
        key: "{{ epel_gpg_key }}"

    - name: Install the epel-release package
      yum:
        name: "{{ epel_url }}"
        state: present
      notify:
        - Update package cache

    - name: Install the epel-next-release package (conditional)
      yum:
        name: "https://dl.fedoraproject.org/pub/epel/epel-next-release-latest-7.noarch.rpm"
        state: present
      when: epel_next | bool
      notify:
        - Update package cache

  handlers:
    - name: Update package cache
      yum:
        update_cache: yes


