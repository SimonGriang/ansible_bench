ks.' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-13T20:59:57.545133632Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7758528002, 'load_duration': 69829889, 'prompt_eval_count': 1828, 'prompt_eval_duration': 768749041, 'eval_count': 446, 'eval_duration': 6919069707, 'model_name': 'phi4:14b'} id='run--dbc3386b-3b8a-44e9-815e-88383fffc637-0' usage_metadata={'input_tokens': 1828, 'output_tokens': 446, 'total_tokens': 2274}
