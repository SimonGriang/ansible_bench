---
- name: Configure HTTP server directories and configurations
  hosts: all
  become: yes
  vars:
    httpd_directories:
      - /var/www/html
      - /var/www/docs
    httpd_config_directory: /etc/httpd/conf.d

  tasks:
    - name: Create necessary directories for HTTP server
      file:
        path: "{{ item }}"
        state: directory
        mode: '0755'
        setype: httpd_sys_content_t
      loop: "{{ httpd_directories }}"
      loop_control:
        label: "{{ item }}"

    - name: Configure directory configurations for HTTP server
      template:
        src: directory.conf.j2
        dest: "{{ httpd_config_directory }}/{{ item }}.conf"
      loop: "{{ httpd_directories }}"
      notify:
        - Test httpd configuration validity
        - Restart httpd

  handlers:
    - name: Test httpd configuration validity
      command: httpd -t

    - name: Restart httpd
      service:
        name: httpd
        state: restarted


