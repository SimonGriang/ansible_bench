---
- name: Install EPEL repository
  hosts: all
  become: true
  vars:
    epel_gpg_key: "https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}"
    epel_url: "epel-release-{{ ansible_distribution_major_version }}.{{ ansible_distribution }}"
    epel_next_url: "epel-next-release-{{ ansible_distribution_major_version }}.{{ ansible_distribution }}"
    epel_next: false

  tasks:
    - name: Check if the system is Amazon Linux 2 or RedHat-based
      ansible.builtin.set_fact:
        is_el_based: "{{ (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2') or (ansible_distribution == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9', '10']) }}"

    - name: Install EPEL package repository for Amazon Linux 2 or RedHat-based systems
      when: is_el_based
      block:
        - name: Install the EPEL GPG key
          ansible.builtin.rpm_key:
            key: "{{ epel_gpg_key }}"
            state: present

        - name: Install the EPEL-release package
          ansible.builtin.package:
            name: "{{ epel_url }}"
            state: present
          notify: Update package cache

        - name: Install the EPEL-next-release package (conditional)
          when: epel_next
          ansible.builtin.package:
            name: "{{ epel_next_url }}"
            state: present
          notify: Update package cache

  handlers:
    - name: Update package cache
      ansible.builtin.yum:
        update_cache: yes


