---
- name: Import assert.yml file
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ item }}"
    timeout: "{{ bootstrap_timeout }}"
  when: 
    - ansible_connection is defined
    - ansible_connection not in ["container", "docker", "community.docker.docker"]
    - ansible_connection is not none
    - bootstrap_wait_for_host | bool

- name: Prepare system
  block:
    - name: Connection test
      setup:
        gather_subset: '!all'
      register: connection_test_result
      failed_when: connection_test_result is failed

    - name: Sudo test
      command: whoami
      register: sudo_test_result
      become: yes
      become_user: root
      failed_when: sudo_test_result.rc != 0

    - name: Gather bootstrap facts
      setup:
        gather_subset: '!all'
      when: connection_test_result is failed

    - name: Install bootstrap packages (raw)
      raw: yum install -y {{ item }}
      loop: "{{ bootstrap_facts_packages }}"
      when: sudo_test_result.rc != 0

    - name: Ensure libdnf5 is present on Fedora/RedHat
      package:
        name: libdnf5
        state: present
      when: 
        - ansible_os_family == "RedHat"
        - sudo_test_result.rc != 0

  become: yes

- name: Gather ansible facts
  setup:
    gather_subset: '!all'

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become }}"


