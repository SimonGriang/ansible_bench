---
- name: Manage system packages and services
  hosts: all
  become: yes
  vars:
    vault_package: "{{ vault_package | default('package_name') }}"
  tasks:
    - name: Install package with name stored in the 'vault_package' variable
      package:
        name: "{{ vault_package }}"
        state: present

  handlers:
    - name: Reload daemon on changes
      systemd:
        daemon_reload: yes
      listen: "reload_daemon"

    - name: Restart vault service
      service:
        name: vault
        state: restarted
      listen: "restart_vault"

  tasks:
    - name: Trigger reload daemon
      meta: flush_handlers
      notify:
        - reload_daemon

    - name: Trigger restart vault service
      meta: flush_handlers
      notify:
        - restart_vault


