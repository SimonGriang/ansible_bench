---
- name: Import necessary tasks from assert.yml for the httpd role
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install the Apache HTTP Server on the target machine
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings for the httpd service if SELinux is enabled
  ansible.builtin.command:
    cmd: "setsebool -P {{ item }}=1"
  loop: "{{ httpd_sebooleans }}"
  when: ansible_selinux.status == "enabled"

- name: Allow connections to custom ports for httpd service if SELinux is enabled
  ansible.builtin.command:
    cmd: "semanage port -a -t http_port_t -p tcp {{ item }}"
  loop: "{{ httpd_port }}"
  when: ansible_selinux.status == "enabled"

- name: Allow connections to SSL port for httpd service if SELinux is enabled
  ansible.builtin.command:
    cmd: "semanage port -a -t https_port_t -p tcp {{ https_ssl_port }}"
  when:
    - ansible_selinux.status == "enabled"
    - https_ssl_port is defined

- name: Configure the Apache HTTP Server on the target machine
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: /etc/httpd/conf/httpd.conf
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Activate specific Apache HTTP Server modules on Debian-based systems
  ansible.builtin.command:
    cmd: "a2enmod {{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == "Debian"
  notify:
    - Test httpd configuration validity

- name: Import tasks related to SSL configuration if https_ssl_enable is defined
  import_tasks: ssl.yml
  when: https_ssl_enable is defined

- name: Import tasks related to locations configuration if httpd_locations is defined
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import tasks related to virtual hosts configuration if httpd_vhosts is defined
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure custom ports for the Apache HTTP Server on Debian-based and Suse-based systems
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: /etc/httpd/conf.d/ports.conf
    mode: '0644'
  when:
    - ansible_os_family in ["Debian", "Suse"]
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Import tasks related to directories configuration if httpd_directories is defined
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers to ensure that any pending handlers are executed
  ansible.builtin.meta:
    flush_handlers: true

- name: Remove the default index.html file from the Apache HTTP Server's data directory
  ansible.builtin.file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example is defined

- name: Start and enable the Apache HTTP Server service
  ansible.builtin.service:
    name: httpd
    state: started
    enabled: true


