content='```yaml\n---\n- name: Configure Apache SSL\n  hosts: all\n  become: yes\n  vars:\n    httpd_ssl_packages: []\n    httpd_config_directory: "/etc/httpd/conf.d"\n\n  tasks:\n    - name: Install Apache ssl packages\n      package:\n        name: "{{ httpd_ssl_packages }}"\n        state: present\n\n    - name: Place ssl configuration file\n      copy:\n        src: ssl_config_template.conf.j2\n        dest: "{{ httpd_config_directory }}/ssl_config.conf"\n        mode: \'0644\'\n\n    - name: Configure default vhost to redirect from http to https\n      copy:\n        src: default_vhost_template.conf.j2\n        dest: "{{ httpd_config_directory }}/default_vhost.conf"\n        mode: \'0644\'\n      notify:\n        - restart httpd\n\n  handlers:\n    - name: restart httpd\n      service:\n        name: httpd\n        state: restarted\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-24T04:12:58.008348194Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3214836832, 'load_duration': 57539891, 'prompt_eval_count': 344, 'prompt_eval_duration': 35134346, 'eval_count': 201, 'eval_duration': 3121206032, 'model_name': 'phi4:14b'} id='run--a133c09e-dc6d-4745-9952-d6afc32884ad-0' usage_metadata={'input_tokens': 344, 'output_tokens': 201, 'total_tokens': 545}
