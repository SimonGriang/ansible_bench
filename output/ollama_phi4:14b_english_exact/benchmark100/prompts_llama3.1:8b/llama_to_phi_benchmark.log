    path: /path/to/csr.pem
    privatekey_path: /path/to/private_key.pem
    common_name: example.com
    state: present
  become: true
  mode: '0600'
  owner: root
  group: root

- name: Create an SSL certificate
  x509_certificate:
    path: /path/to/certificate.pem
    privatekey_path: /path/to/private_key.pem
    csr_path: /path/to/csr.pem
    provider: selfsigned
    not_after: +1y
    subject_alt_names:
      - "DNS:example.com"
      - "DNS:www.example.com"
    state: present
  become: true
  mode: '0644'
  owner: root
  group: root

- name: Create a PKCS#12 file
  openssl_pkcs12:
    dest: /path/to/keystore.p12
    privatekey_path: /path/to/private_key.pem
    certificate_path: /path/to/certificate.pem
    password: 'your_password'
    state: present
  become: true
  mode: '0600'
  owner: root
  group: root

- name: Read the private key
  slurp:
    src: /path/to/private_key.pem
  register: private_key_content

- name: Read the certificate
  slurp:
    src: /path/to/certificate.pem
  register: certificate_content

- name: Create a combined private key and certificate file
  copy:
    dest: /path/to/combined.pem
    content: |
      {{ private_key_content.content | b64decode }}
      {{ certificate_content.content | b64decode }}
  become: true
  mode: '0644'
  owner: root
  group: root


