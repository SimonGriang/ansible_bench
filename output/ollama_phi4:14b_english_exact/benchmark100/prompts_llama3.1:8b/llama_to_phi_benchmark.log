---
- name: Import and execute tasks from assert.yml playbook fragment
  ansible.builtin.import_playbook:
    name: assert.yml
  delegate_to: localhost

- name: Install logrotate package
  ansible.builtin.package:
    name: logrotate
    state: present

- name: Configure logrotate by rendering a template
  ansible.builtin.template:
    src: logrotate config.j2
    dest: /etc/logrotate.conf
    mode: '0644'

- name: Generate logrotate.d files using a template
  ansible.builtin.template:
    src: entry.j2
    dest: "/etc/logrotate.d/{{ item.name }}"
    mode: '0644'
  loop: "{{ logrotate_entries }}"
  when: item.absent is not defined or not item.absent
  loop_control:
    label: "{{ item.name }}"

- name: Remove logrotate.d files
  ansible.builtin.file:
    path: "/etc/logrotate.d/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  when: item.absent
  loop_control:
    label: "{{ item.name }}"

- name: Manage logrotate service
  ansible.builtin.service:
    name: "{{ logrotate_service_name | default(omit) }}"
    state: "{{ logrotate_service_state | default('started') }}"
    enabled: "{{ logrotate_service_enabled | default(true) }}"
  when: logrotate_service_name | length > 0


