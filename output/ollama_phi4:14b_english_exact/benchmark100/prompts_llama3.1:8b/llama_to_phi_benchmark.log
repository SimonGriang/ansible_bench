---
- name: Create local ssh key directory for a user
  file:
    path: "/home/{{ user_name }}/.ssh"
    state: directory
    mode: '0750'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Manage the user account
  user:
    name: "{{ user_name }}"
    comment: "{{ user_comment }}"
    group: "{{ user_group }}"
    create_home: "{{ create_home | default(false) }}"
    password: "{{ user_password | default(omit) }}"
    expires: "{{ user_password_expire | default(omit) }}"
    shell: "{{ user_shell | default('/bin/bash') }}"

- name: Set up the user's sudo options
  template:
    src: sudoers.d_user.j2
    dest: "/etc/sudoers.d/{{ user_name }}"
    mode: '0440'
    owner: root
    group: root
  when: user_sudo_options is defined and user_sudo_options | length > 0
  notify: remove sudoers.d if not defined
  delegate_to: localhost
  run_once: true

- name: Remove sudo configuration file if user has no sudo options
  file:
    path: "/etc/sudoers.d/{{ user_name }}"
    state: absent
  when: user_sudo_options is not defined or user_sudo_options | length == 0

- name: Generate the user's private SSH key
  shell: ssh-keygen -t rsa -b 2048 -f "/home/{{ user_name }}/.ssh/id_rsa" -N ""
  args:
    creates: "/home/{{ user_name }}/.ssh/id_rsa"
  when: manage_ssh_keys | default(false)

- name: Generate the user's public SSH key
  shell: ssh-keygen -y -f "/home/{{ user_name }}/.ssh/id_rsa" > "/home/{{ user_name }}/.ssh/id_rsa.pub"
  args:
    creates: "/home/{{ user_name }}/.ssh/id_rsa.pub"
  when: manage_ssh_keys | default(false)

- name: Convert the user's SSH key to PPK format
  shell: ssh-keygen -e -f "/home/{{ user_name }}/.ssh/id_rsa" > "/home/{{ user_name }}/.ssh/id_rsa.ppk"
  args:
    creates: "/home/{{ user_name }}/.ssh/id_rsa.ppk"
  when: manage_ssh_keys | default(false)

- name: Get or set the user's home directory
  shell: getent passwd "{{ user_name }}" | cut -d: -f6
  register: user_home_dir
  changed_when: false

- name: Set the base home directory for the user
  set_fact:
    user_home: "{{ user_home_dir.stdout | default('/home/' ~ user_name) }}"

- name: Create the user's .ssh directory
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Deploy authorized keys for the user
  authorized_key:
    user: "{{ user_name }}"
    state: present
    key: "{{ item }}"
    exclusive: yes
  loop: "{{ user_authorized_keys | default([]) }}"
  when: user_authorized_keys is defined and user_authorized_keys | length > 0

- name: Remove unauthorized keys for the user
  authorized_key:
    user: "{{ user_name }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ user_unauthorized_keys | default([]) }}"
  when: user_unauthorized_keys is defined and user_unauthorized_keys | length > 0

- name: Copy the generated private SSH key for the user
  copy:
    src: "/home/{{ user_name }}/.ssh/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0400'
  when: copy_private_key | default(false)

- name: Check the user's password validity
  shell: chage -l "{{ user_name }}" | grep 'Password expires' | cut -d: -f2
  register: users_pw_valid

- name: Set the user's password validity
  shell: chage -E "{{ user_password_expire }}" "{{ user_name }}"
  when: user_password_expire is defined and users_pw_valid.stdout | length == 0

- name: Place the private key file for the user
  copy:
    src: "/home/{{ user_name }}/.ssh/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0400'
  when: user_private_keys is defined and user_private_keys | length > 0


