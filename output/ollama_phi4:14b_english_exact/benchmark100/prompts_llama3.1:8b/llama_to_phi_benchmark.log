---
- name: Import assert.yml and run it once on localhost
  import_tasks: assert.yml

- name: Install the mysql package
  package:
    name: mysql
    state: present

- name: Configure the mysql server
  template:
    src: mysql-server.cnf.j2
    dest: "{{ mysql_configuration_destination_directory }}/{{ mysql_name }}-server.cnf"
  vars:
    mysql_configuration_options: "{{ mysql_configuration_options }}"

- name: Configure the mysql client
  template:
    src: mysql-client.cnf.j2
    dest: "{{ mysql_configuration_destination_directory }}/{{ mysql_name }}-client.cnf"
  vars:
    socket_option: "{{ socket_option }}"
    socket_value: "{{ socket_value }}"

- name: Initialize the mysql service
  command: "{{ mysql_initialize_command }}"
  when: ansible_os_family in ['Alpine', 'Archlinux']

- name: Start and enable the mysql service
  service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Create a my.cnf file in the /root/.my.cnf directory
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: List databases on the target machine
  community.mysql.mysql_info:
    get_server_version: true

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    login_user: root
  loop: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


