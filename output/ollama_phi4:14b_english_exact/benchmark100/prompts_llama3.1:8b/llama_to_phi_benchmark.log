---
- name: Run assert.yml on localhost
  hosts: localhost
  gather_facts: no
  tasks:
    - name: Import and run assert.yml
      import_playbook: assert.yml
      when: ansible_playbook_name == 'my_playbook.yml'

- name: Install required packages
  hosts: all
  tasks:
    - name: Install required packages
      package:
        name: "{{ selinux_requirements }}"
        state: present
      notify: Gather facts

  handlers:
    - name: Gather facts
      setup:

- name: Flush handlers
  hosts: all
  tasks:
    - name: Flush handlers
      meta: flush_handlers

- name: Configure SELinux
  hosts: all
  tasks:
    - name: Configure SELinux
      block:
        - name: Manage SELinux
          selinux:
            policy: "{{ selinux_policy }}"
            state: "{{ selinux_state }}"
          notify: Reboot

        - name: Manage SELinux booleans
          selinux:
            policy: "{{ selinux_policy }}"
            state: "{{ selinux_state }}"
          when: selinux_booleans is defined
          loop: "{{ selinux_booleans }}"
          loop_control:
            loop_var: selinux_boolean
          block:
            - name: Set SELinux boolean
              selinux:
                name: "{{ selinux_boolean.name }}"
                state: "{{ selinux_boolean.state }}"
                persistent: "{{ selinux_boolean.persistent }}"
      when:
        - ansible_selinux.status is defined
        - ansible_connection not in ['container', 'docker', 'community.docker.docker']

  handlers:
    - name: Reboot
      reboot:
        msg: "Reboot initiated by Ansible for SELinux configuration changes"
        connect_timeout: 5
        reboot_timeout: 300


