:\n        - software-properties-common\n        - python3-pip\n\n    - name: Add Ansible PPA on Debian\n      apt_repository:\n        repo: ppa:ansible/ansible\n        state: present\n\n    - name: Install Ansible on Debian\n      apt:\n        name: ansible\n        state: "{{ ansible_package_state }}"\n        update_cache: true\n\n- name: Set up Ansible using Pip\n  hosts: all\n  tasks:\n    - name: Install pip dependencies for Ansible\n      pip:\n        name: "{{ item }}"\n        state: present\n      loop:\n        - ansible\n\n    - name: Install Ansible using pip\n      pip:\n        name: ansible\n        state: "{{ ansible_package_state }}"\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-24T04:50:35.985832877Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11261554125, 'load_duration': 55884041, 'prompt_eval_count': 1163, 'prompt_eval_duration': 318269837, 'eval_count': 627, 'eval_duration': 10885984218, 'model_name': 'phi4:14b'} id='run--78c75fce-3b7e-4ebd-b754-641a43aa4dea-0' usage_metadata={'input_tokens': 1163, 'output_tokens': 627, 'total_tokens': 1790}
