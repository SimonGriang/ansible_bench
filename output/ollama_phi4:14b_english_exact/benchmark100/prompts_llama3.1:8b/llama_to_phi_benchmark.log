---
- name: Restart RKE2 service on a node
  ansible.builtin.service:
    name: rke2-server
    state: restarted
  vars:
    rke2_node_name: "{{ rke2_node_name }}"
  notify: Service (re)started
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  ansible.builtin.shell: kubectl get nodes --no-headers | grep 'Ready\|NotReady' | grep -c 'Ready'
  register: all_ready_nodes
  until: all_ready_nodes.stdout | int == groups['rke2_servers_group_name'] | length
  retries: 100
  delay: 15
  delegate_to: "{{ groups['rke2_servers_group_name'][0] }}"
  when: not ansible_check_mode
  run_once: true

- name: Wait for all pods to be ready again
  ansible.builtin.shell: kubectl get pods --all-namespaces --field-selector=status.phase!=Running,status.phase!=Succeeded --no-headers | wc -l
  register: all_pods_ready
  until: all_pods_ready.stdout | int == 0
  retries: 100
  delay: 15
  delegate_to: "{{ groups['rke2_servers_group_name'][0] }}"
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready | default(false) | bool
  run_once: true


