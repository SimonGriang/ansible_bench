content='```yaml\n---\n- name: Setup SSL and redirect configuration for Apache\n  hosts: all\n  become: yes\n  vars:\n    httpd_ssl_packages: []\n    httpd_config_directory: "/etc/httpd/conf.d"\n    default_vhost_conf: "default_vhost_template.conf"\n  tasks:\n    - name: Install required SSL packages\n      package:\n        name: "{{ httpd_ssl_packages }}"\n        state: present\n\n    - name: Place SSL configuration file\n      copy:\n        src: "ssl.conf.j2"\n        dest: "{{ httpd_config_directory }}/ssl.conf"\n        mode: \'0644\'\n      notify:\n        - Test Apache configuration\n        - Restart Apache service\n\n    - name: Configure HTTP to HTTPS redirect\n      copy:\n        src: "{{ default_vhost_conf }}"\n        dest: "{{ httpd_config_directory }}/{{ default_vhost_conf | regex_replace(\'template$\', \'\') }}"\n        mode: \'0644\'\n      notify:\n        - Test Apache configuration\n        - Restart Apache service\n\n  handlers:\n    - name: Test Apache configuration\n      command: apachectl configtest\n\n    - name: Restart Apache service\n      service:\n        name: httpd\n        state: restarted\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-24T04:02:00.453046547Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4101556646, 'load_duration': 53387971, 'prompt_eval_count': 401, 'prompt_eval_duration': 51298071, 'eval_count': 255, 'eval_duration': 3995479775, 'model_name': 'phi4:14b'} id='run--847fa835-4a09-4b08-a09d-5d3d7468310d-0' usage_metadata={'input_tokens': 401, 'output_tokens': 255, 'total_tokens': 656}
