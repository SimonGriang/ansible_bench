---
- name: Ensure the unzip package is available on the system, and update the package cache if it is necessary to do so.
  ansible.builtin.apt:
    name: unzip
    state: present
    update_cache: "{{ promtail_apt_update_cache }}"
  when: ansible_pkg_mgr == "apt"

- name: Create a group named as the promtail_system_group variable, and set its ownership to the system group.
  ansible.builtin.group:
    name: "{{ promtail_system_group }}"
    state: present
  when: promtail_system_group != "root"

- name: Create a user named as the promtail_system_user variable, and set its ownership and groups based on the promtail_system_group and promtail_user_additional_groups variables.
  ansible.builtin.user:
    name: "{{ promtail_system_user }}"
    system: yes
    groups: "{{ promtail_system_group }}"
    append: yes
  when: promtail_system_user != "root"

- name: Create the /usr/local/bin directory with the correct permissions (0755).
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create directories for promtail configuration and positions files with the correct ownership and permissions.
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: "{{ item.mode }}"
  loop:
    - { path: /etc/promtail, mode: '0755' }
    - { path: /var/lib/promtail/positions, mode: '0755' }

- name: Create directories for the promtail installation and its version-specific files with the correct ownership and permissions.
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: "{{ item.mode }}"
  loop:
    - { path: /opt/promtail, mode: '0755' }
    - { path: /opt/promtail/{{ promtail_version_specific_path }}, mode: '0755' }

- name: Check if the promtail binary exists in the installation directory.
  ansible.builtin.stat:
    path: /opt/promtail/{{ promtail_version_specific_path }}/promtail
  register: promtail_binary_stat

- name: Download the promtail binary from the specified URL if it does not exist in the installation directory, or if the locally distributed archive needs to be propagated.
  ansible.builtin.get_url:
    url: "{{ promtail_binary_url }}"
    dest: /tmp/promtail.zip
  when: not promtail_binary_stat.stat.exists or promtail_binary_propagate

- name: Copy the locally distributed promtail archive to the temp directory if it exists and needs to be propagated.
  ansible.builtin.copy:
    src: "{{ promtail_local_archive_src }}"
    dest: /tmp/promtail.zip
  when: promtail_local_archive_exists and promtail_binary_propagate

- name: Download the promtail binary to the controller node if the promtail_binary_propagate variable is true.
  ansible.builtin.copy:
    src: /tmp/promtail.zip
    dest: /opt/promtail/{{ promtail_version_specific_path }}/promtail.zip
  when: promtail_binary_propagate

- name: Copy the promtail binary to the installation directory if the promtail_binary_propagate variable is true.
  ansible.builtin.copy:
    src: /tmp/promtail.zip
    dest: /opt/promtail/{{ promtail_version_specific_path }}/promtail.zip
  when: promtail_binary_propagate

- name: Unpack the promtail binary from the zip archive.
  ansible.builtin.unarchive:
    src: /opt/promtail/{{ promtail_version_specific_path }}/promtail.zip
    dest: /opt/promtail/{{ promtail_version_specific_path }}
    remote_src: yes

- name: Create a symlink to the latest promtail binary in the /usr/local/bin directory.
  ansible.builtin.file:
    src: /opt/promtail/{{ promtail_version_specific_path }}/promtail
    dest: /usr/local/bin/promtail
    state: link

- name: Write the promtail configuration file with the correct ownership and permissions.
  ansible.builtin.template:
    src: promtail.yaml.j2
    dest: /etc/promtail/config.yaml
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: '0644'

- name: Create the systemd service unit for promtail with the correct ownership and permissions.
  ansible.builtin.template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'


