---
- name: PHP Configuration Playbook
  hosts: localhost
  vars:
    php_packages: []  # Define the PHP packages you need to install
    php_ini_command: "php --ini"  # Define the command to find the php.ini location

  tasks:
    - name: Import the assert.yml file
      include_tasks: assert.yml
      run_once: true
      delegate_to: localhost

    - name: Install the PHP packages
      ansible.builtin.package:
        name: "{{ php_packages }}"
        state: present

    - name: Find the location of the used php.ini file
      ansible.builtin.shell: |
        set -o pipefail
        {{ php_ini_command }}
      register: php_found_ini_location
      changed_when: false

    - name: Configure the PHP settings
      ansible.builtin.template:
        src: php.ini.j2
        dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
        mode: 0644
      notify:
        - restart httpd

  handlers:
    - name: restart httpd
      ansible.builtin.service:
        name: httpd
        state: restarted


