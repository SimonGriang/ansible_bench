---
- name: Gather basic system facts
  ansible.builtin.command:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  become: false

- name: Extract distribution name and major version
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.split('=')[1] | strip('\"') }}"
    bootstrap_distribution_major_version: "{{ item.split('=')[1].split('.')[0] | strip('\"') }}"
  vars:
    os_release_lines: "{{ bootstrap_facts.stdout_lines }}"
  when: item | regex_search('^NAME=')
  loop: "{{ os_release_lines }}"
  loop_control:
    loop_var: item

- name: Identify and set the operating system family
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.value }}"
  vars:
    bootstrap_os_family_map:
      Ubuntu: Debian
      Debian: Debian
      RedHat: RedHat
      CentOS: RedHat
      Fedora: RedHat
      openSUSE: Suse
      SUSE: Suse
  when: bootstrap_distribution | regex_search(item.key)
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"


