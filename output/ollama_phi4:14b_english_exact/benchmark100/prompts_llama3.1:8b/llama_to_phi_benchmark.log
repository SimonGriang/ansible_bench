    line: "GRUB_CMDLINE_LINUX=\"cryptdevice=UUID={{ root_uuid }}:cryptroot root=/dev/mapper/cryptroot rd.luks.uuid={{ root_uuid }} rd.md.uuid={{ swap_uuid }} quiet\""
