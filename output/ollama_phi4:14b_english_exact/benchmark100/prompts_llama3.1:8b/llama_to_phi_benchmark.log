---
- name: Import assert.yml file for task execution and skip the rest of the tasks on the first run
  include_tasks: assert.yml
  tags: assert
  when: assert is not defined

- name: Pre-configure Debian systems for postfix installation
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'No configuration'
    vtype: select
  when: ansible_os_family == 'Debian'

- name: Install postfix package
  package:
    name: postfix
    state: present

- name: Install postfix-mysql package if specific conditions are met
  package:
    name: postfix-mysql
    state: present
  when: 
    - "'mysql' in postfix_virtual_mailbox_maps"
    - "'mysql' in postfix_virtual_mailbox_domains"
    - "'mysql' in postfix_virtual_alias_maps"

- name: Configure postfix transport maps
  template:
    src: transport.j2
    dest: /etc/postfix/transport
  notify:
    - Validate postfix configuration
    - Rebuild postfix transport maps database

- name: Configure postfix header checks
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - Validate postfix configuration
    - Reload postfix

- name: Set values for the main.cf file
  set_fact:
    recipient_access_rules: "{{ postfix_recipient_access | default([]) }}"
    sender_access_rules: "{{ postfix_sender_access | default([]) }}"
    mynetworks: "{{ postfix_mynetworks | default([]) }}"
    mydestination: "{{ postfix_mydestination | default([]) }}"
    relay_domains: "{{ postfix_relay_domains | default([]) }}"
    smtpd_recipient_restrictions: "{{ 
      postfix_smtpd_recipient_restrictions | default([]) }}"
    smtpd_sender_restrictions: "{{ 
      postfix_smtpd_sender_restrictions | default([]) }}"
    virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | 
      default([]) }}"
    virtual_alias_domains: "{{ postfix_virtual_alias_domains | 
      default([]) }}"

- name: Configure postfix main.cf
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - Validate postfix configuration
    - Restart postfix

- name: Configure postfix master.cf
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - Validate postfix configuration
    - Restart postfix

- name: Create a directory for TLS certificates and keys
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /etc/ssl/certs/postfix
    - /etc/ssl/private/postfix

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_server_cert }}"
    dest: /etc/ssl/certs/postfix/server.crt
    mode: '0644'
  notify:
    - Reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_server_key }}"
    dest: /etc/ssl/private/postfix/server.key
    mode: '0600'
  notify:
    - Reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    content: "{{ postfix_aliases | to_nice_yaml }}"
    dest: /etc/aliases
  notify:
    - Rebuild postfix alias database
    - Reload postfix

- name: Configure sender_access
  copy:
    content: "{{ postfix_sender_access | to_nice_yaml }}"
    dest: /etc/postfix/sender_access
  notify:
    - Rebuild postfix sender_access database
    - Reload postfix

- name: Configure recipient_access
  copy:
    content: "{{ postfix_recipient_access | to_nice_yaml }}"
    dest: /etc/postfix/recipient_access
  notify:
    - Validate postfix configuration
    - Rebuild postfix recipient_access database
    - Reload postfix

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_smtp_sasl_password_map_content | to_nice_yaml }}"
    dest: /etc/postfix/sasl_password_map
  notify:
    - Rebuild postfix sasl_password_map database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix service
  service:
    name: postfix
    state: started
    enabled: true


