---
- name: Create the Vault group
  ansible.builtin.group:
    name: "{{ vault_group }}"
    system: true

- name: Create the Vault user
  ansible.builtin.user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"

- name: Create the Vault download directory
  ansible.builtin.file:
    path: "{{ vault_download_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory

- name: Download the Vault binary
  ansible.builtin.unarchive:
    src: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: true
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Check if the vault_path exists
  ansible.builtin.stat:
    path: "{{ vault_path }}"
  register: vault_path_stat

- name: Create vault_path if it does not exist
  ansible.builtin.file:
    path: "{{ vault_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  when: not vault_path_stat.stat.exists

- name: Create directories in vault_path
  ansible.builtin.file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  loop: "{{ vault_directories }}"

- name: Create data directories
  ansible.builtin.file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
    state: directory
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  community.crypto.x509_certificate:
    path: "{{ vault_tls_files.cert }}"
    privatekey_path: "{{ vault_tls_files.key }}"
    provider: selfsigned

- name: Set ownership of TLS material
  ansible.builtin.file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    state: file
  loop: "{{ vault_tls_files }}"

- name: Copy the Vault binary
  ansible.builtin.copy:
    src: "{{ vault_download_path }}/vault"
    dest: "/usr/local/bin/vault"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Set cap_ipc_lock=ep on /usr/local/bin/vault
  ansible.builtin.command:
    cmd: setcap cap_ipc_lock=ep /usr/local/bin/vault
  changed_when: false

- name: Touch vault.env
  ansible.builtin.file:
    path: "/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'

- name: Create /usr/lib/systemd/system
  ansible.builtin.file:
    path: "/usr/lib/systemd/system"
    owner: "root"
    group: "root"
    mode: '0755'
    state: directory

- name: Copy the Vault service file
  ansible.builtin.copy:
    src: "vault.service"
    dest: "/usr/lib/systemd/system/vault.service"
    owner: "root"
    group: "root"
    mode: '0644'

- name: Copy the Vault configuration
  ansible.builtin.copy:
    src: "vault.hcl"
    dest: "/etc/vault.d/vault.hcl"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true


