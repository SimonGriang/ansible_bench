---
- name: Manage Helm installation
  hosts: all
  vars:
    helm_bin_path: "/usr/local/bin/helm"
    helm_repo_path: "https://get.helm.sh/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    helm_version: "3.5.4"
    helm_platform: "linux"
    helm_arch: "amd64"
  tasks:
    - name: Check if the Helm binary exists at the specified path
      stat:
        path: "{{ helm_bin_path }}"
      register: helm_check

    - name: Check the current version of Helm installed on the system
      command: "{{ helm_bin_path }} version --short"
      register: helm_existing_version
      changed_when: false
      failed_when: false

    - name: Download the Helm binary from the specified repository
      get_url:
        url: "{{ helm_repo_path }}"
        dest: "/tmp/helm.tar.gz"
      when: not helm_check.stat.exists or helm_existing_version.stdout != "v{{ helm_version }}"

    - name: Copy the downloaded Helm binary into place at the specified path
      copy:
        src: "/tmp/helm.tar.gz"
        dest: "{{ helm_bin_path }}"
        remote_src: yes
        mode: '0755'
      become: true
      when: helm_check.stat.exists is not defined or helm_check.stat.exists is not true


