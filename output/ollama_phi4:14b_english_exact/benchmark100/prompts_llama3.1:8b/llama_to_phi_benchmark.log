nsure compliance with the given requirements.' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-24T04:53:25.293458754Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9470532865, 'load_duration': 70487748, 'prompt_eval_count': 794, 'prompt_eval_duration': 311838891, 'eval_count': 526, 'eval_duration': 9087197325, 'model_name': 'phi4:14b'} id='run--a902a9e7-8f08-4314-b989-8ebabe6ae372-0' usage_metadata={'input_tokens': 794, 'output_tokens': 526, 'total_tokens': 1320}
