---
- name: Import assert.yml file
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ item }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection not in ["container", "docker", "community.docker.docker"]
    - ansible_connection != "none"
    - bootstrap_wait_for_host | bool

- name: Prepare system
  become: yes
  block:
    - name: Connection test
      ping:
      register: connection_test_result
      ignore_errors: yes

    - name: Gather bootstrap facts if connection test fails
      setup:
      when: connection_test_result is failed

    - name: Sudo test
      command: echo "sudo test"
      become: yes
      register: sudo_test_result
      ignore_errors: yes

    - name: Install bootstrap packages (raw) if sudo test fails
      raw: echo "Installing bootstrap packages"
      when: sudo_test_result is failed

    - name: Ensure libdnf5 is present on Fedora/RedHat
      package:
        name: libdnf5
        state: present
      when:
        - ansible_facts['os_family'] == 'RedHat'
        - sudo_test_result is failed

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages }}"
  become: "{{ bootstrap_become }}"


