---
- name: Set the package state based on how Ansible is installed
  hosts: all
  tasks:
    - name: Determine the package state for Ansible based on the installation method
      set_fact:
        ansible_package_state: >-
          "{{ 'present' if ansible_pkg_mgr in ['yum', 'dnf'] else 'latest' }}"

- name: Set up Ansible on RedHat
  hosts: redhat
  tasks:
    - name: Ensure EPEL repository is present
      yum:
        name: epel-release
        state: present
      when: ansible_distribution == 'RedHat'

    - name: Install Ansible package dependencies on RedHat
      yum:
        name: "{{ item }}"
        state: present
      loop:
        - python3
        - python3-pip

    - name: Install Ansible on RedHat
      yum:
        name: ansible
        state: "{{ ansible_package_state }}"

- name: Set up Ansible on Fedora
  hosts: fedora
  tasks:
    - name: Install Ansible package dependencies on Fedora
      dnf:
        name: "{{ item }}"
        state: present
      loop:
        - python3
        - python3-pip

    - name: Install Ansible on Fedora
      dnf:
        name: ansible
        state: "{{ ansible_package_state }}"

- name: Set up Ansible on Ubuntu
  hosts: ubuntu
  tasks:
    - name: Install Ansible package dependencies on Ubuntu
      apt:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop:
        - software-properties-common
        - python3-pip

    - name: Add Ansible PPA on Ubuntu
      apt_repository:
        repo: ppa:ansible/ansible
        state: present

    - name: Install Ansible on Ubuntu
      apt:
        name: ansible
        state: "{{ ansible_package_state }}"
        update_cache: yes

- name: Set up Ansible on Debian
  hosts: debian
  tasks:
    - name: Install Ansible package dependencies on Debian
      apt:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop:
        - software-properties-common
        - python3-pip

    - name: Add Ansible PPA on Debian
      apt_repository:
        repo: ppa:ansible/ansible
        state: present

    - name: Install Ansible on Debian
      apt:
        name: ansible
        state: "{{ ansible_package_state }}"
        update_cache: yes

- name: Set up Ansible using Pip
  hosts: all
  tasks:
    - name: Install pip dependencies for Ansible
      pip:
        name: "{{ item }}"
        state: present
      loop:
        - ansible

    - name: Install Ansible using pip
      pip:
        name: ansible
        state: "{{ ansible_package_state }}"


