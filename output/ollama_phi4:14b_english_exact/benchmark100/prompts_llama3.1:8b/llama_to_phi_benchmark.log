ad_duration': 68363360, 'prompt_eval_count': 793, 'prompt_eval_duration': 311525594, 'eval_count': 489, 'eval_duration': 8254766968, 'model_name': 'phi4:14b'} id='run--4dd57e74-fc28-4fd2-82af-69e48f05f552-0' usage_metadata={'input_tokens': 793, 'output_tokens': 489, 'total_tokens': 1282}
