---
- name: Import assert.yml and run it once on the localhost
  import_tasks: assert.yml

- name: Install the apache httpd package using the httpd_packages variable
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings if enabled
  block:
    - name: Modify SELinux settings
      selinux:
        policy: targeted
        state: enforcing
        config_file: /etc/selinux/config
      when: ansible_selinux.status == "enabled"

    - name: Allow connections to custom ports
      seport:
        ports: >-
          {{ httpd_port }},{% raw %}{{ httpd_ssl_port }}{% endraw %}
        protocol: tcp
        state: present
  when: ansible_selinux.status == "enabled"

- name: Configure the httpd service by creating a configuration file using a template
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    owner: root
    group: root
    mode: '0644'

- name: Activate the httpd module on Debian systems using the a2enmod command
  command: a2enmod "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == "Debian"

- name: Import ssl.yml if the https_ssl_enable variable is true
  import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import locations.yml if the httpd_locations variable is defined
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml if the httpd_vhosts variable is defined
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports by creating a configuration file using a template on Debian and Suse systems
  template:
    src: "{{ httpd_ports_conf.j2 }}"
    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
    owner: root
    group: root
    mode: '0644'
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directories.yml if the httpd_directories variable is defined
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Remove the default index.html file in the httpd data directory if the httpd_remove_example variable is true
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable the httpd service
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


