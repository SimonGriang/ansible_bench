- name: Lookup bootstrap facts by running the `cat /etc/os-release` command
  ansible.builtin.shell: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: Set bootstrap distribution and major version facts
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_major_version: >-
      {{ bootstrap_facts.stdout
      | regex_findall('VERSION_ID="([0-9]+)"', '\\1')
