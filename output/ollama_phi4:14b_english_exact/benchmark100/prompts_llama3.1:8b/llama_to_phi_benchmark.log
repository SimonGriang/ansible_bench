---
- name: Import assert.yml file into the playbook
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for a specified port to become available
  wait_for:
    host: "{{ ansible_default_ipv4.address }}"
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - bootstrap_wait_for_host is defined
    - connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare the system for further tasks
  block:
    - name: Check if connection is established and sudo is available
      setup:
      register: bootstrap_connect

    - name: Gather bootstrap facts and include gather_facts.yml
      include_tasks: gather_facts.yml
      when: bootstrap_connect is not defined or bootstrap_connect is failed

    - name: Install bootstrap packages if sudo is not available
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
        update_cache: yes
      become: "{{ bootstrap_become }}"
      when: bootstrap_connect is not defined or bootstrap_connect is failed

- name: Gather Ansible facts about the system
  setup:
  register: system_facts

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
  become: "{{ bootstrap_become }}"


