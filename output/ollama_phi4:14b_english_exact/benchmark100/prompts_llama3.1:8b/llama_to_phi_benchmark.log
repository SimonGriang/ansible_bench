---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install the MySQL package
  ansible.builtin.package:
    name: mysql
    state: present
  notify:
    - Set root password
    - Daemon-reexec

- name: Configure the MySQL server
  community.general.ini_file:
    dest: "{{ configuration_destination }}/server.cnf"
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
  with_items: "{{ mysql_configuration_options }}"
  notify:
    - Restart MySQL server

- name: Configure the MySQL client
  community.general.ini_file:
    dest: "{{ configuration_destination }}/client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"

- name: Initialize the MySQL database
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"

- name: Start and enable the MySQL service
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place the my.cnf file
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('') }}"
    state: present
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


