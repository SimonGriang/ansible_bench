---
- name: Assert that systemd is being used as the init system
  assert:
    that:
      - ansible_facts.init_system == "systemd"
    fail_msg: "This playbook requires systemd as the init system."
    success_msg: "Using systemd as the init system."

- name: Get the latest release of the Grafana Loki project from the GitHub API
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    method: GET
    return_content: yes
    status_code: 200
  register: _latest_release
  until: _latest_release is success
  retries: 5
  delay: 3

- name: Set the promtail version to the latest release tag (excluding the 'v' prefix) if it's set to 'latest'
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name | regex_replace('^v', '') }}"
  when: promtail_version == 'latest'

- name: Test if the zip local archive exists in the specified directory
  stat:
    path: "{{ local_directory }}/promtail_{{ promtail_version }}_linux_{{ ansible_architecture }}.zip"
  register: _local_zip_stat

- name: Assert that the local binary exists in the specified directory
  assert:
    that:
      - _local_zip_stat.stat.exists
    fail_msg: "The promtail binary archive does not exist in the specified directory."
    success_msg: "Promtail binary archive found in the specified directory."
  when: _local_zip_stat.stat.isdir is not defined or _local_zip_stat.stat.isdir is not true

- name: Get the checksum list for the latest release
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest/assets"
    method: GET
    return_content: yes
    status_code: 200
  register: __promtail_checksums
  when: _local_zip_stat.stat.isdir or _local_zip_stat.stat.size == 0

- name: Get the checksum for the specified architecture
  set_fact:
    __promtail_checksum: "{{ item.sha256 }}"
  with_items: "{{ __promtail_checksums.json }}"
  when: item.name == "promtail-linux-{{ ansible_architecture }}.zip"
  register: _promtail_checksum
  when: _local_zip_stat.stat.isdir or _local_zip_stat.stat.size == 0


