---
- name: Import assert.yml and run it once on localhost
  import_tasks: assert.yml
  hosts: localhost

- name: Install the DNS packages
  ansible.builtin.package:
    name: "{{ dns_packages }}"
    state: present

- name: Create the required directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop: "{{ dns_directories }}"

- name: Create the required group
  ansible.builtin.group:
    name: "{{ dns_group }}"
    state: present

- name: Create the required user
  ansible.builtin.user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    system: yes
    create_home: no

- name: Generate the rndc key
  ansible.builtin.command: rndc-confgen -a -r /dev/urandom -k /etc/bind/rndc.key

- name: Set permissions on the rndc key file
  ansible.builtin.file:
    path: /etc/bind/rndc.key
    mode: '0400'
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"

- name: Download the named.root file
  ansible.builtin.get_url:
    url: "{{ named_root_url }}"
    dest: /etc/bind/named.root
    mode: '0644'

- name: Create the zone file
  ansible.builtin.template:
    src: zone.j2
    dest: /etc/bind/{{ item }}
    mode: '0644'
  loop: "{{ dns_zone_files }}"

- name: Add zones to the configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: /etc/bind/named.conf
    mode: '0644'

- name: Place the systemd override
  ansible.builtin.template:
    src: named.service.j2
    dest: /etc/systemd/system/bind9.service.d/override.conf
  notify: Reload systemd

- name: Start and enable the DNS service
  ansible.builtin.service:
    name: bind9
    state: started
    enabled: yes


