---
- name: Execute OpenSSL related tasks
  hosts: localhost
  tasks:
    - name: Import the assert.yml file
      include_tasks: assert.yml
      delegate_to: localhost
      run_once: true

    - name: Install required packages
      package:
        name: "{{ openssl_requirements }}"
        state: present

    - name: Install pip packages
      pip:
        name: "{{ openssl_pip_packages }}"
        state: present
      when: openssl_pip_packages | length > 0

    - name: Create the key directory
      file:
        path: "{{ openssl_key_directory }}"
        state: directory
        mode: "{{ openssl_file_mode }}"
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"

    - name: Create the csr directory
      file:
        path: "{{ openssl_csr_directory }}"
        state: directory
        mode: "{{ openssl_file_mode }}"
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"

    - name: Create the crt directory
      file:
        path: "{{ openssl_crt_directory }}"
        state: directory
        mode: "{{ openssl_file_mode }}"
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"

    - name: Include the create.yml tasks
      include_tasks: create.yml
      loop: "{{ openssl_items }}"
      loop_control:
        label: "{{ item.name }}"
      when: openssl_items is defined and openssl_items | length > 0


