---
- name: Download RKE2 installation script
  ansible.builtin.get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0755'

- name: Copy local RKE2 installation script
  ansible.builtin.copy:
    src: "{{ local_rke2_install_script_src }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0755'
  when: airgap_mode and implementation == 'copy'

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: '0755'
  when: airgap_mode and implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Attempt remote download of RKE2 checksum and artifacts
      ansible.builtin.get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_dest }}"
        mode: '0755'

    - name: Attempt remote download of RKE2 artifacts
      ansible.builtin.get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_dest }}"
        mode: '0755'
  when: airgap_mode and implementation == 'download'

- name: Airgap mode - additional images tarballs
  ansible.builtin.copy:
    src: "{{ rke2_components_src }}"
    dest: "{{ rke2_additional_images_dest }}"
    mode: '0755'
  when: airgap_mode and implementation != 'exists' and additional_tarballs_to_copy

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  ansible.builtin.file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: '0755'
  when: airgap_mode and implementation == 'exists'

- name: Populate service facts
  ansible.builtin.service_facts:

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: "{{ fs_object_path }}"

- name: Check if separate partition
  ansible.builtin.command:
    cmd: grep -q "{{ partition }}" {{ partition_file }}
  register: is_separate_partition

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: >-
      {% if is_separate_partition.rc == 0 and
            '/usr/local' in ansible_facts['ansible_mounts'] %}
        /usr/local/bin
      {% else %}
        /usr/bin
      {% endif %}

- name: Check RKE2 version
  ansible.builtin.command:
    cmd: "{{ rke2_bin_path }}/rke2 version"
  register: rke2_version_check

- name: Set RKE2 versions
  set_fact:
    running_version: "{{ rke2_version_check.stdout.split()[2] }}"
    desired_version: "{{ rke2_desired_version }}"

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - running_version >= desired_version
    fail_msg: "Running RKE2 version is less than the desired version."

- name: Run RKE2 install script
  ansible.builtin.shell:
    cmd: "{{ rke2_install_script_dest }}"
  vars:
    rke2_version: "{{ desired_version }}"
  when: running_version != desired_version

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: "{{ custom_manifests_src }}"
    dest: "{{ custom_manifests_dest }}"
    mode: '0644'
  when: custom_manifests

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ static_pods_src }}"
    dest: "{{ static_pods_dest }}"
    mode: '0644'
  when: static_pods

- name: Copy RKE2 environment file
  ansible.builtin.copy:
    src: "{{ rke2_env_file_src }}"
    dest: "{{ rke2_env_file_dest }}"
    mode: '0644'
  when: env_options


