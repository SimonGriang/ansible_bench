---
- name: Setup SSL and redirect configuration for Apache
  hosts: all
  become: yes
  vars:
    httpd_ssl_packages: []
    httpd_config_directory: "/etc/httpd/conf.d"
    default_vhost_conf: "default_vhost_template.conf"
  tasks:
    - name: Install required SSL packages
      package:
        name: "{{ httpd_ssl_packages }}"
        state: present

    - name: Place SSL configuration file
      copy:
        src: "ssl.conf.j2"
        dest: "{{ httpd_config_directory }}/ssl.conf"
        mode: '0644'
      notify:
        - Test Apache configuration
        - Restart Apache service

    - name: Configure HTTP to HTTPS redirect
      copy:
        src: "{{ default_vhost_conf }}"
        dest: "{{ httpd_config_directory }}/{{ default_vhost_conf | regex_replace('template$', '') }}"
        mode: '0644'
      notify:
        - Test Apache configuration
        - Restart Apache service

  handlers:
    - name: Test Apache configuration
      command: apachectl configtest

    - name: Restart Apache service
      service:
        name: httpd
        state: restarted


