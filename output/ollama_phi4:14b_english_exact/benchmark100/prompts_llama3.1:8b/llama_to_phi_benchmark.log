- name: Install DEB (Local Java Source)
  block:
    - name: Copy Oracle Java DEB Package to /tmp
      copy:
        src: "{{ oracle_java_deb }}"
        dest: /tmp
    - name: Install Oracle Java DEB Package
      apt:
        deb: /tmp/{{ oracle_java_deb }}
        state: present
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java (RPM) (Repository)
  package:
    name: "{{ oracle_java_rpm_package }}"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Targz
  block:
    - name: Ensure Java Install Directory Exists
      file:
        path: "{{ java_install_directory }}"
        state: directory
    - name: Install Oracle Java Targz Package
      unarchive:
        src: "{{ oracle_java_targz }}"
        dest: "{{ java_install_directory }}"
        remote_src: yes
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java Policy Software (Targz)
  unarchive:
    src: "{{ oracle_java_policy_targz }}"
    dest: "{{ java_install_directory }}"
    remote_src: yes
  when: java_jce is defined and java_jce | bool and java_version == 8 and java_vendor == "oracle"

- name: Set Alternative (Targz)
  alternatives:
    name: java
    path: "{{ java_install_directory }}/bin/java"
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java
  register: java_home_cmd

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME="{{ java_home_cmd.stdout }}"'


