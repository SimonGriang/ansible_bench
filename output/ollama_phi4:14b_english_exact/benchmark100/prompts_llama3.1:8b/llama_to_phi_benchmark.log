---
- name: Import assert.yml file into the playbook
  import_tasks: assert.yml

- name: Install python pip packages
  pip:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  block:
    - name: Ensure pip configuration directory exists
      file:
        path: /etc/pip.conf.d
        state: directory

    - name: Configure pip proxy settings in pip.conf
      ini_file:
        path: /etc/pip.conf
        section: global
        option: proxy
        value: "{{ python_pip_proxy }}"
  when: python_pip_proxy is defined

- name: Configure pip trusted host settings
  block:
    - name: Ensure pip configuration directory exists
      file:
        path: /etc/pip.conf.d
        state: directory

    - name: Configure pip trusted host settings in pip.conf
      ini_file:
        path: /etc/pip.conf
        section: global
        option: trusted-host
        value: "{{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined

- name: Update pip to the specified version
  pip:
    name: "pip=={{ python_pip_pip_package }}"
    state: present
  when:
    - python_pip_update is defined
    - ansible_distribution_release not in ["bookworm", "noble"]
    - ansible_os_family != "Alpine"

- name: Install requested Python modules
  pip:
    name: "{{ python_pip_modules }}"
    state: present
  when:
    - ansible_distribution_release not in ["bookworm", "noble"]
    - ansible_os_family != "Alpine"


