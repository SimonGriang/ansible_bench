---
- hosts: localhost
  gather_facts: no
  tasks:
    - name: Import assert.yml
      ansible.builtin.import_tasks: assert.yml
      delegate_to: localhost

    - name: Install docker-compose package
      ansible.builtin.package:
        name: docker-compose
        state: present
      when:
        - docker_compose_installation_type is defined
        - docker_compose_installation_type | bool == "package"

    - name: Install required packages for docker-compose binary
      ansible.builtin.package:
        name: "{{ docker_compose_binary_required_packages }}"
        state: present
      when:
        - docker_compose_installation_type is defined
        - docker_compose_installation_type | bool == "binary"

    - name: Install docker-compose as a binary
      ansible.builtin.get_url:
        url: "{{ docker_compose_url }}"
        dest: /usr/local/bin/docker-compose
        mode: '0755'
      when:
        - docker_compose_installation_type is defined
        - docker_compose_installation_type | bool == "binary"


