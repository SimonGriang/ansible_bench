---
- name: Enable specific Apache2 modules
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop:
    - apache2
    - apache2-mod-proxy
    - apache2-mod-proxy-http
  when: ansible_os_family in ['Debian', 'Suse']

- name: Enable apache2 modules
  ansible.builtin.command: a2enmod "{{ item }}"
  args:
    creates: "/etc/apache2/mods-enabled/{{ item }}.load"
  loop:
    - proxy
    - proxy_http
  when: ansible_os_family in ['Debian', 'Suse']

- name: Configure Apache2 locations
  ansible.builtin.template:
    src: location.conf.j2
    dest: "/etc/httpd/conf.d/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_locations }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd


