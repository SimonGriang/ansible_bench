      get_url:
        url: "{{ helm_repo_path }}"
        dest: "/tmp/helm.tar.gz"
      when: not helm_check.stat.exists or 
            helm_existing_version.stdout is not search("v{{ helm_version }}")

    - name: Copy the downloaded Helm binary into place at the specified path
      copy:
        src: "/tmp/helm.tar.gz"
        dest: "{{ helm_bin_path }}"
        remote_src: yes
        mode: '0755'
      become: true
      when: helm_check.stat.exists is not defined or not helm_check.stat.exists


