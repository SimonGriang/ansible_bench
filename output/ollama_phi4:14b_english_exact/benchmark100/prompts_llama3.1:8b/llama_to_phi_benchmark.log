      name: "example_group"
      gid: "1001"
      system: "no"
      sudo_options: "ALL=(ALL) NOPASSWD:ALL"

  tasks:
    - name: Manage group with specified name and state
      group:
        name: "{{ group.name }}"
        gid: "{{ group.gid | default(omit) }}"
        system: "{{ group.system | default(omit) }}"
        state: "present"

    - name: Configure sudo options for a group
      template:
        src: "sudo_group.j2"
        dest: "/etc/sudoers.d/{{ group.name }}"
        mode: '0640'
      validate: 'visudo -cf %s'
      when: group.sudo_options is defined


