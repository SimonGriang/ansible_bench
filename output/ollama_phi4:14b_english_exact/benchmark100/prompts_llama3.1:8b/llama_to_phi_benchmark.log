---
- name: Enable Backports repository for Debian versions older than 9
  apt_repository:
    repo: "deb http://deb.debian.org/debian {{ ansible_distribution_release }}-backports main"
    state: present
  when: ansible_distribution == "Debian" and ansible_distribution_major_version | int < 9

- name: Set default_release option for older Debian versions
  copy:
    dest: "/etc/apt/apt.conf.d/99backports"
    content: |
      APT::Default-Release "{{ ansible_distribution_release }}-backports";
  when: ansible_distribution == "Debian" and ansible_distribution_major_version | int < 9

- name: Install Ansible package with default release
  apt:
    name: ansible
    state: present
    default_release: "{{ ansible_distribution_release }}-backports"
  when: ansible_distribution == "Debian" and ansible_distribution_major_version | int < 9


