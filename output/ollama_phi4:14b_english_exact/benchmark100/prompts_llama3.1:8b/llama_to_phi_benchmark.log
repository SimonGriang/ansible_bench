---
- name: Install and configure EPEL repository
  hosts: all
  become: yes
  vars:
    epel_gpg_key: "https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}"
    epel_url: "https://dl.fedoraproject.org/pub/epel/epel-release-latest-{{ ansible_distribution_major_version }}.noarch.rpm"
    epel_next_url: "https://dl.fedoraproject.org/pub/epel/epel-next-release-latest-{{ ansible_distribution_major_version }}.noarch.rpm"

  tasks:
    - name: Check if the system is Amazon Linux 2 or RedHat-based with version 7, 8, 9, or 10
      ansible.builtin.set_fact:
        is_el_system: "{{ ansible_distribution == 'RedHat' or 
                          ansible_distribution == 'CentOS' or 
                          ansible_distribution == 'OracleLinux' or 
                          (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2') }}"
        is_supported_version: "{{ ansible_distribution_major_version in ['7', '8', '9', '10'] }}"
      when: ansible_os_family == 'RedHat' or 
            (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2')

    - name: Install EPEL package repository if conditions are met
      ansible.builtin.package:
        name: epel-release
        state: present
      when: is_el_system and is_supported_version

    - name: Install the EPEL GPG key
      ansible.builtin.rpm_key:
        key: "{{ epel_gpg_key }}"
        state: present

    - name: Install the EPEL-release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache

    - name: Install the EPEL-next-release package (conditional)
      ansible.builtin.package:
        name: "{{ epel_next_url }}"
        state: present
      when: epel_next is defined and epel_next | bool
      notify: Update package cache

  handlers:
    - name: Update package cache
      ansible.builtin.package:
        update_cache: yes


