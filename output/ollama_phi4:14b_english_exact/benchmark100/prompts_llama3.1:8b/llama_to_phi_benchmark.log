---
- name: Disable Swap
  when: vault_hardening_disable_swap | bool
  block:
    - name: Disable swap temporarily
      ansible.builtin.command:
        cmd: swapoff -a
      register: swapoff_output
      when: ansible_facts['ansible_swaptotal_mb'] > 0

    - name: Comment swap entries in fstab
      ansible.builtin.lineinfile:
        path: /etc/fstab
        regexp: '^(.+?\s+)?swap\s+'
        state: absent
      when: ansible_facts['ansible_swaptotal_mb'] > 0 and swapoff_output.changed

- name: Disable Core Dumps
  when: vault_hardening_disable_core_dumps | bool
  block:
    - name: Set core dump limits to 0
      community.general.pam_limits:
        domain: '*'
        limit_type: "{{ item }}"
        limit_item: core
        value: 0
      loop:
        - hard
        - soft

- name: Disable Shell Command History
  when: vault_hardening_disable_shell_command_history | bool
  block:
    - name: Copy vault.sh to /etc/profile.d/
      ansible.builtin.copy:
        src: vault.sh
        dest: /etc/profile.d/vault.sh
        mode: '0755'

- name: Configure SELinux / AppArmor
  block:
    - name: Install selinux-policy package
      ansible.builtin.package:
        name: selinux-policy
        state: present

    - name: Set SELinux policy to targeted
      ansible.posix.selinux:
        policy: targeted
      when: ansible_facts['selinux']['status'] == 'enabled'

    - name: Set SELinux state to enforcing
      ansible.posix.selinux:
        state: enforcing
      when: ansible_facts['selinux']['status'] == 'enabled'

    - name: Enforce AppArmor
      ansible.builtin.command:
        cmd: aa-enforce /etc/apparmor.d/*
      when: ansible_facts['os_family'] in ['Debian', 'RedHat'] and 
            ansible_facts['apparmor']['status'] != 'enforcing'


