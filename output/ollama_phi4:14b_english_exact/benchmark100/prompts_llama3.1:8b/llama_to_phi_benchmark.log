    size: 2048
  file:
    path: "{{ private_key_path }}"
    mode: "{{ private_key_mode }}"
    owner: "{{ private_key_owner }}"
    group: "{{ private_key_group }}"

- name: Create an SSL Certificate Signing Request (CSR)
  ansible.builtin.openssl_csr:
    path: "{{ csr_path }}"
    privatekey_path: "{{ private_key_path }}"
    common_name: "{{ csr_common_name }}"
  file:
    path: "{{ csr_path }}"
    mode: "{{ csr_mode }}"
    owner: "{{ csr_owner }}"
    group: "{{ csr_group }}"

- name: Create SSL certificates
  ansible.builtin.openssl_certificate:
    path: "{{ certificate_path }}"
    privatekey_path: "{{ private_key_path }}"
    provider:
      name: selfsigned
      country_name: "{{ certificate_country }}"
      state_or_province_name: "{{ certificate_state }}"
      locality_name: "{{ certificate_locality }}"
      organization_name: "{{ certificate_organization }}"
      organizational_unit_name: "{{ certificate_organizational_unit }}"
      common_name: "{{ certificate_common_name }}"
  file:
    path: "{{ certificate_path }}"
    mode: "{{ certificate_mode }}"
    owner: "{{ certificate_owner }}"
    group: "{{ certificate_group }}"

- name: Create a PKCS#12 file
  ansible.builtin.openssl_pkcs12:
    path: "{{ pkcs12_path }}"
    privatekey_path: "{{ private_key_path }}"
    certificate_path: "{{ certificate_path }}"
    name: "{{ pkcs12_name }}"
  file:
    path: "{{ pkcs12_path }}"
    mode: "{{ pkcs12_mode }}"
    owner: "{{ pkcs12_owner }}"
    group: "{{ pkcs12_group }}"

- name: Read the private key
  ansible.builtin.slurp:
    path: "{{ private_key_path }}"
  register: private_key_content

- name: Read the certificate
  ansible.builtin.slurp:
    path: "{{ certificate_path }}"
  register: certificate_content

- name: Create a combined private key and certificate file
  ansible.builtin.copy:
    content: |
      {{ private_key_content['content'] | b64decode }}
      {{ certificate_content['content'] | b64decode }}
    dest: "{{ combined_path }}"
  file:
    path: "{{ combined_path }}"
    mode: "{{ combined_mode }}"
    owner: "{{ combined_owner }}"
    group: "{{ combined_group }}"


