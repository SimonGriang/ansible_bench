---
- name: Remove Docker GPG key from trusted.gpg.d if present
  ansible.builtin.file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Remove old Docker apt source list
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Uninstall old versions of Docker
  ansible.builtin.package:
    name:
      - docker
      - docker-engine
      - docker.io
      - containerd
      - runc
    state: absent

- name: Remove legacy Docker repository file
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install required dependencies
  ansible.builtin.apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: true

- name: Add or remove Docker repository
  ansible.builtin.block:
    - name: Add Docker repository
      ansible.builtin.apt_repository:
        repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu \
              {{ ansible_distribution_release }} stable
        state: present
      when: docker_add_repo | bool

    - name: Remove Docker repository
      ansible.builtin.apt_repository:
        repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu \
              {{ ansible_distribution_release }} stable
        state: absent
      when: not (docker_add_repo | bool)

- name: Notify apt update handler
  ansible.builtin.meta:
    flush_handlers: true


