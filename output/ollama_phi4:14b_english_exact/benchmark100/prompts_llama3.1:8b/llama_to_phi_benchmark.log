---
- name: Include the tasks from assert.yml playbook
  ansible.builtin.include_tasks: assert.yml

- name: Install required software
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  loop_control:
    label: "{{ item }}"
  become: true

- name: Loop over users_groups
  ansible.builtin.include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item }}"
  become: true

- name: Ensure the /etc/sudoers.d directory is included
  ansible.builtin.lineinfile:
    path: /etc/sudoers
    line: "{{ users_sudo_includedir }}"
    state: present
    validate: visudo -cf %s
  become: true

- name: Loop over users
  ansible.builtin.include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item }}"
  become: true

- name: Manage cron permission
  ansible.builtin.template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow is defined
  become: true

- name: Check existence of /etc/cron.allow
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is not defined
  become: true


