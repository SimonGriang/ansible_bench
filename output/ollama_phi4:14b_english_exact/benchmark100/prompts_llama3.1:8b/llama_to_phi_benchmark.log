content='```yaml\n---\n- name: Configure Apache2 on Debian and Suse systems\n  hosts: all\n  tasks:\n    - name: Enable proxy and proxy_http modules in Apache2\n      community.general.apache2_module:\n        name: "{{ item }}"\n        state: present\n      loop:\n        - proxy\n        - proxy_http\n      when: ansible_os_family in [\'Debian\', \'Suse\']\n\n    - name: Configure Apache2 locations\n      template:\n        src: location.conf.j2\n        dest: "/etc/httpd/conf.d/{{ item.name }}.conf"\n        mode: \'0644\'\n      loop: "{{ httpd_locations }}"\n      notify:\n        - Test httpd configuration\n        - Restart httpd\n\n  handlers:\n    - name: Test httpd configuration\n      command: httpd -t\n      notify: Restart httpd\n\n    - name: Restart httpd\n      service:\n        name: httpd\n        state: restarted\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-24T03:58:45.877333049Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3190880680, 'load_duration': 63297862, 'prompt_eval_count': 322, 'prompt_eval_duration': 35663084, 'eval_count': 202, 'eval_duration': 3090122853, 'model_name': 'phi4:14b'} id='run--54b12b9a-a536-4930-bb01-97f9dc23d6f0-0' usage_metadata={'input_tokens': 322, 'output_tokens': 202, 'total_tokens': 524}
