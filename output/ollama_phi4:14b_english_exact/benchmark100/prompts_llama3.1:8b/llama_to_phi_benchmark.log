---
- name: RKE2 manifests setup
  hosts: all
  tasks:
    - name: Create the RKE2 manifests directory
      file:
        path: /etc/rancher/rke2/manifests
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Copy ingress-nginx files to first server
      copy:
        src: templates/ingress-nginx.yaml
        dest: /etc/rancher/rke2/manifests/ingress-nginx.yaml
        owner: root
        group: root
        mode: '0644'


