---
- name: Import external tasks for assertion handling
  ansible.builtin.import_tasks: assert.yml

- name: Install the cron package
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell settings for cron jobs
  ansible.builtin.lineinfile:
    path: /etc/crontab
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    state: present

- name: Configure the system path for cron jobs
  ansible.builtin.lineinfile:
    path: /etc/crontab
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    state: present

- name: Configure the mail-to setting for cron jobs
  ansible.builtin.lineinfile:
    path: /etc/crontab
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    state: present

- name: Start and enable the cron service
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: true

- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"


