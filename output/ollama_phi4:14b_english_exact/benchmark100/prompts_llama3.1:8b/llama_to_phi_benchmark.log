---
- name: Download RKE2 kubeconfig from master server
  fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: /path/to/local/kubeconfig.yaml
    flat: yes

- name: Replace loopback IP with master server IP in kubeconfig file
  replace:
    path: /path/to/local/kubeconfig.yaml
    regexp: '(^|\\s)server:\\s*([\\d.:]+)'
    replace: "\\1server: https://{{ master_server_ip }}:6443"
    mode: '0600'
  delegate_to: localhost
  become: false


