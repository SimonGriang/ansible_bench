icate file\n  ansible.builtin.copy:\n    content: "{{ private_key_content[\'content\'] | b64decode }}\\n{{ certificate_content[\'content\'] | b64decode }}"\n    dest: "{{ combined_path }}"\n  file:\n    path: "{{ combined_path }}"\n    mode: "{{ combined_mode }}"\n    owner: "{{ combined_owner }}"\n    group: "{{ combined_group }}"\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-24T04:03:04.291103097Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8936119072, 'load_duration': 56946023, 'prompt_eval_count': 512, 'prompt_eval_duration': 58358124, 'eval_count': 523, 'eval_duration': 8819175286, 'model_name': 'phi4:14b'} id='run--3a484928-cacd-4094-8398-1cac1aa13ee4-0' usage_metadata={'input_tokens': 512, 'output_tokens': 523, 'total_tokens': 1035}
