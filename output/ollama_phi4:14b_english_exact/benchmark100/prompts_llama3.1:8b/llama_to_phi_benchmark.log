---
- name: Create the RKE2 config directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  ansible.builtin.copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed handler

- name: Copy kubelet config
  ansible.builtin.template:
    src: "{{ rke2_kubelet_config_src }}"
    dest: /etc/rancher/rke2/manifests/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  when: rke2_kubelet_config != ''
  notify: Config file changed handler

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ rke2_containerd_config_src }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0644'
  when: rke2_custom_registry_mirrors != '' or rke2_custom_registry_configs != ''
  notify: Config file changed handler

- name: Start RKE2 service on the rest of the nodes
  ansible.builtin.service:
    name: rke2-server
    state: started
    enabled: true
  retries: 5
  delay: 10
  notify: Service (re)started handler

- name: Mask other RKE2 service on the rest of the nodes
  ansible.builtin.service:
    name: "{{ item }}"
    enabled: false
    masked: true
  loop: "{{ rke2_services | reject('equalto', rke2_type) | list }}"

- name: Wait for remaining nodes to be ready - no CNI
  ansible.builtin.wait_for:
    timeout: 600
  retries: 5
  delay: 10
  loop: "{{ groups['nodes'] }}"
  loop_control:
    loop_var: node

- name: Wait for remaining nodes to be ready - with CNI
  ansible.builtin.wait_for:
    timeout: 600
  retries: 5
  delay: 10
  when: ansible_hostname == groups['servers'][0] or (groups['servers'] | length > 1 and ansible_hostname == groups['servers'][1])


