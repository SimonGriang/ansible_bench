---
- name: Configure Apache HTTPD Vhosts
  hosts: all
  vars:
    httpd_vhosts: "{{ httpd_vhosts }}"
  tasks:
    - name: Create the document root for each vhost
      file:
        path: "{{ item.docroot }}"
        state: directory
        mode: '0755'
      when: item.docroot is defined and (item.create_docroot is undefined or item.create_docroot | bool)
      with_items: "{{ httpd_vhosts }}"

    - name: Configure the vhosts
      template:
        src: vhost_conf_template.j2
        dest: "/etc/httpd/conf.d/{{ item.name }}.conf"
        mode: '0644'
      notify:
        - Test httpd configuration validity
        - Restart httpd
      with_items: "{{ httpd_vhosts }}"

  handlers:
    - name: Test httpd configuration validity
      command: httpd -t

    - name: Restart httpd
      service:
        name: httpd
        state: restarted


