        - python3-pip

    - name: Install Ansible on RedHat
      yum:
        name: ansible
        state: "{{ ansible_package_state }}"

- name: Set up Ansible on Fedora
  hosts: fedora
  tasks:
    - name: Install Ansible package dependencies on Fedora
      dnf:
        name: "{{ item }}"
        state: present
      loop:
