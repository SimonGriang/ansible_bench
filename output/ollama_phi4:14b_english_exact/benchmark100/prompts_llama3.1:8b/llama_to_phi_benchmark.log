- name: Configure Apache2 on Debian and Suse systems
  hosts: all
  tasks:
    - name: Enable proxy and proxy_http modules in Apache2
      community.general.apache2_module:
        name: "{{ item }}"
        state: present
      loop:
        - proxy
        - proxy_http
      when: ansible_os_family in ['Debian', 'Suse']

    - name: Configure Apache2 locations
      template:
        src: location.conf.j2
        dest: "/etc/httpd/conf.d/{{ item.name }}.conf"
        mode: '0644'
      loop: "{{ httpd_locations }}"
      notify:
        - Test httpd configuration
        - Restart httpd

  handlers:
    - name: Test httpd configuration
      command: httpd -t

    - name: Restart httpd
      service:
        name: httpd
        state: restarted


