ries is defined\n\n- name: Remove the default index.html file in the httpd data directory if the httpd_remove_example variable is true\n  file:\n    path: "{{ httpd_data_directory }}/index.html"\n    state: absent\n  when: httpd_remove_example\n\n- name: Start and enable the httpd service\n  service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: yes\n```\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-24T04:11:35.572095334Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7744844785, 'load_duration': 70503875, 'prompt_eval_count': 937, 'prompt_eval_duration': 263753640, 'eval_count': 569, 'eval_duration': 7409382543, 'model_name': 'phi4:14b'} id='run--c17ca561-7703-4306-9207-07b69dfcb119-0' usage_metadata={'input_tokens': 937, 'output_tokens': 569, 'total_tokens': 1506}
