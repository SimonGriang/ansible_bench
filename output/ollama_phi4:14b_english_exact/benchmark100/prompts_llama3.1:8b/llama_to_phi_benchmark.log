    --no-headers | wc -l
  register: all_pods_ready
  until: all_pods_ready.stdout | int == 0
  retries: 100
  delay: 15
  delegate_to: "{{ groups['rke2_servers_group_name'][0] }}"
  when: not ansible_check_mode and 
        rke2_wait_for_all_pods_to_be_ready | default(false) | bool
  run_once: true


