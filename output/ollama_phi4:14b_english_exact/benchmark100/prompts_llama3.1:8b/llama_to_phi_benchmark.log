---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: "architecture.yml"

- name: Set OS-specific variables (I)
  set_fact:
    os_specific_var: "{{ role_var | default(os_specific_var) }}"
  when: os_specific_var is defined and os_specific_var is not none

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ role_var_home_dir | default(java_open_jdk_home_dir) }}"
    java_open_jdk_package: "{{ role_var_package | default(java_open_jdk_package) }}"
  when: 
    - java_open_jdk_home_dir is defined and java_open_jdk_home_dir is not none
    - java_open_jdk_package is defined and java_open_jdk_package is not none

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "deb http://archive.ubuntu.com/ubuntu {{ ansible_distribution_release }} main restricted"
        state: absent

    - name: Install extra apt tools
      apt:
        name: apt-transport-https
        state: present

    - name: Add required key repositories
      apt_key:
        url: "https://adoptium.jfrog.io/adoptium/api/gpg/key/public"
        state: present

    - name: Add required repositories
      apt_repository:
        repo: "deb https://adoptium.jfrog.io/adoptium/deb stable main"
        state: present

- name: RedHat pre-requisites
  block:
    - name: Add required key repositories
      rpm_key:
        key: "https://adoptium.jfrog.io/adoptium/api/gpg/key/public"
        state: present

    - name: Add required repositories
      yum_repository:
        name: adoptium
        description: Adoptium repo
        baseurl: "https://adoptium.jfrog.io/adoptium/rpm/{{ ansible_distribution_major_version }}/$basearch/"
        gpgcheck: yes
        gpgkey: "https://adoptium.jfrog.io/adoptium/api/gpg/key/public"

- name: Install required libs
  package:
    name: "{{ java_required_libs }}"
    state: present

- name: Install Java, Debian
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present

- name: Install Java, RedHat
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0755'

- name: Source environment variables
  shell: source /etc/profile

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  lineinfile:
    path: /etc/profile.d/jdk.sh
    regexp: '^JAVA_HOME=/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java$'
    line: 'JAVA_HOME=/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java'
  when: java_version is version('11.0', '<')

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  lineinfile:
    path: /etc/profile.d/jdk.sh
    regexp: '^JAVA_HOME=/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java$'
    line: 'JAVA_HOME=/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java'
  when: java_version is version('11.0', '>=')


