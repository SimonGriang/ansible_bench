---
- name: Install and configure cadvisor
  hosts: all
  become: yes
  vars:
    cadvisor_url: "https://github.com/google/cadvisor/releases/download/v0.44.1/cadvisor"
    cadvisor_checksum: "sha256:abc123"
    cadvisor_dir: "/opt/cadvisor"
    cadvisor_binary: "cadvisor"
    cadvisor_service_file: "/etc/systemd/system/cadvisor.service"
    cadvisor_template: "cadvisor.service.j2"

  tasks:
    - name: Create the directories for the cadvisor installation
      file:
        path: "{{ cadvisor_dir }}"
        state: directory
        mode: '0755'

    - name: Download the cadvisor binary from the internet
      get_url:
        url: "{{ cadvisor_url }}"
        dest: "{{ cadvisor_dir }}/{{ cadvisor_binary }}"
        checksum: "{{ cadvisor_checksum }}"
      when: ansible_facts['dir_size'] | default(0) == 0

    - name: Copy the locally distributed cadvisor binary
      copy:
        src: "/path/to/local/cadvisor"
        dest: "{{ cadvisor_dir }}/{{ cadvisor_binary }}"
      when: ansible_facts['dir_size'] | default(0) != 0

    - name: Create a symlink to the cadvisor binary
      file:
        src: "{{ cadvisor_dir }}/{{ cadvisor_binary }}"
        dest: "{{ cadvisor_dir }}/cadvisor"
        state: link

    - name: Configure the cadvisor systemd service
      template:
        src: "{{ cadvisor_template }}"
        dest: "{{ cadvisor_service_file }}"
      when: ansible_facts['dir_size'] | default(0) != 0

    - name: Test if the cadvisor service is active
      systemd:
        name: cadvisor
        state: started
      register: service_active

    - name: Enable the cadvisor systemd service
      systemd:
        name: cadvisor
        enabled: true

    - name: Start the cadvisor systemd service
      systemd:
        name: cadvisor
        state: started
        daemon_reload: true


