- name: Create the RKE2 manifests directory with specific permissions and ownership
  file:
    path: /etc/rancher/rke2/server/manifests
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Copy kube-vip YAML files to the RKE2 manifests directory
  copy:
    src: "{{ item.src }}"
    dest: /etc/rancher/rke2/server/manifests/{{ item.dest }}"
    remote_src: yes
  with_items:
    - { src: 'templates/kube-vip-config.yaml.j2', dest: 'kube-vip-config.yaml' }
    - { src: 'templates/kube-vip-service.yaml.j2', dest: 'kube-vip-service.yaml' }

- name: Copy kube-vip load balancer manifests to the RKE2 manifests directory
  copy:
    src: "{{ item.src }}"
    dest: /etc/rancher/rke2/server/manifests/{{ item.dest }}
    remote_src: yes
  with_items:
    - { src: 'templates/kube-vip-lb-config.yaml.j2', dest: 'kube-vip-lb-config.yaml' }
    - { src: 'templates/kube-vip-lb-service.yaml.j2', dest: 'kube-vip-lb-service.yaml' }
  when: rke2_kubevip_cloud_provider_enable | default(false)


