content='```yaml\n---\n- name: Load OS-specific variables\n  include_vars: "{{ ansible_os_family }}.yml"\n\n- name: Include setup tasks for RedHat-based systems\n  include_tasks: redhat.yml\n  when: ansible_os_family == \'RedHat\'\n\n- name: Include setup tasks for Debian-based systems\n  include_tasks: debian.yml\n  when: ansible_os_family == \'Debian\'\n\n- name: Install Docker packages on systems with Ansible version < 2.12 or non-RedHat/Debian systems\n  package:\n    name: "{{ docker_packages }}"\n    state: present\n  when: ansible_version.full is version(\'2.12\', \'<\') or ansible_os_family not in [\'RedHat\', \'Debian\']\n\n- name: Install Docker packages (with downgrade option) on systems with Ansible version >= 2.12 and RedHat/Debian systems\n  package:\n    name: "{{ docker_packages }}"\n    state: present\n    allow_downgrade: yes\n  when: ansible_version.full is version(\'2.12\', \'>=\') and ansible_os_family in [\'RedHat\', \'Debian\']\n\n- name: Install the docker-compose plugin on systems where the plugin is enabled and the system meets the criteria for task 4 or 5\n  package:\n    name: docker-compose\n    state: present\n  when: docker_compose_enabled and (ansible_version.full is version(\'2.12\', \'<\') or ansible_os_family not in [\'RedHat\', \'Debian\'] or (ansible_version.full is version(\'2.12\', \'>=\') and ansible_os_family in [\'RedHat\', \'Debian\']))\n\n- name: Install the docker-compose-plugin (with downgrade option) on systems where the plugin is enabled and the system meets the criteria for task 5\n  package:\n    name: docker-compose\n    state: present\n    allow_downgrade: yes\n  when: docker_compose_enabled and ansible_version.full is version(\'2.12\', \'>=\') and ansible_os_family in [\'RedHat\', \'Debian\']\n\n- name: Ensure the /etc/docker/ directory exists and has the correct permissions\n  file:\n    path: /etc/docker\n    state: directory\n    mode: \'0755\'\n\n- name: Configure the Docker daemon options by copying the options to the daemon.json file\n  copy:\n    src: daemon.json\n    dest: /etc/docker/daemon.json\n    owner: root\n    group: root\n    mode: \'0644\'\n\n- name: Ensure Docker is started and enabled at boot, if configured to do so\n  service:\n    name: docker\n    state: started\n    enabled: yes\n\n- name: Notify handlers to ensure firewall rules are updated\n  meta: flush_handlers\n\n- name: Include tasks for managing docker-compose, if enabled\n  include_tasks: docker-compose.yml\n  when: docker_compose_enabled\n\n- name: Get information about the docker group using getent\n  command: getent group docker\n  register: docker_group_info\n  ignore_errors: true\n\n- name: Check if there are any users to add to the docker group\n  set_fact:\n    users_to_add: "{{ docker_users | default([]) }}"\n  when: docker_group_info.stdout | length > 0\n\n- name: Include tasks for managing docker users, if necessary\n  include_tasks: docker-users.yml\n  when: users_to_add | length > 0\n```\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-24T03:36:48.427457347Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13671164453, 'load_duration': 64191917, 'prompt_eval_count': 921, 'prompt_eval_duration': 341366172, 'eval_count': 721, 'eval_duration': 13264425788, 'model_name': 'phi4:14b'} id='run--a740fbce-5cbb-45c1-8f52-9bf9227a001a-0' usage_metadata={'input_tokens': 921, 'output_tokens': 721, 'total_tokens': 1642}
