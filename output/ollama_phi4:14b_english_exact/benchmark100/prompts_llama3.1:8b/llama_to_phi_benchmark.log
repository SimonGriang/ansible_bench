---
- name: Remove any old Docker packages from the system to prevent conflicts with the new installation
  ansible.builtin.package:
    name:
      - docker
      - docker-engine
      - docker.io
      - containerd
      - runc
    state: absent

- name: Import the Docker GPG key to enable the installation of the Docker package from the official repository
  ansible.builtin.apt_key:
    url: https://download.docker.com/linux/ubuntu/gpg
    state: present

- name: Download and install the Docker repository configuration file from the official Docker repository
  ansible.builtin.apt_repository:
    repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} stable
    state: present
    filename: 'docker'

- name: Enable or disable the Docker Nightly and Docker Test repositories
  ansible.builtin.template:
    src: docker-repo.j2
    dest: /etc/yum.repos.d/docker.repo
  vars:
    docker_yum_repo_enable_nightly: true
    docker_yum_repo_enable_test: false

- name: Configure containerd on RHEL 8
  block:
    - name: Remove runc
      ansible.builtin.package:
        name: runc
        state: absent

    - name: Install container-selinux
      ansible.builtin.package:
        name: container-selinux
        state: present

    - name: Install containerd.io
      ansible.builtin.package:
        name: containerd.io
        state: present
  when: ansible_distribution_major_version == '8'


