content='```yaml\n---\n- name: Gather basic system facts\n  ansible.builtin.command:\n    cmd: cat /etc/os-release\n  register: bootstrap_facts\n  become: false\n\n- name: Extract distribution name and major version\n  ansible.builtin.set_fact:\n    bootstrap_distribution: "{{ item.split(\'=\')[1]|strip(\'"\') }}"\n    bootstrap_distribution_major_version: "{{ item.split(\'=\')[1].split(\'.\')[0]|strip(\'"\') }}"\n  vars:\n    os_release_lines: "{{ bootstrap_facts.stdout_lines }}"\n  when: item | regex_search(\'^NAME=\')\n  loop: "{{ os_release_lines }}"\n  loop_control:\n    loop_var: item\n  set_fact:\n    bootstrap_distribution: "{{ bootstrap_distribution }}"\n    bootstrap_distribution_major_version: "{{ bootstrap_distribution_major_version }}"\n\n- name: Identify and set the operating system family\n  ansible.builtin.set_fact:\n    bootstrap_os_family: "{{ item.value }}"\n  vars:\n    bootstrap_os_family_map:\n      Ubuntu: Debian\n      Debian: Debian\n      RedHat: RedHat\n      CentOS: RedHat\n      Fedora: RedHat\n      openSUSE: Suse\n      SUSE: Suse\n  when: bootstrap_distribution | regex_search(item.key)\n  loop: "{{ bootstrap_os_family_map | dict2items }}"\n  loop_control:\n    label: "{{ item.key }}"\n```\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-24T03:48:30.544458257Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4704910337, 'load_duration': 58599437, 'prompt_eval_count': 544, 'prompt_eval_duration': 271680436, 'eval_count': 279, 'eval_duration': 4373659283, 'model_name': 'phi4:14b'} id='run--b45a8f4b-db34-452b-8b8d-2d3c3e64afde-0' usage_metadata={'input_tokens': 544, 'output_tokens': 279, 'total_tokens': 823}
