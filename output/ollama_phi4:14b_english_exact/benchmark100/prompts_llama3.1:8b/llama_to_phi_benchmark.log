---
- name: Manage etcd nodes in the cluster
  hosts: localhost
  gather_facts: no
  vars:
    rke2_cluster_group_name: "rke2_cluster"

  tasks:
    - name: Get the names of all nodes in the cluster
      k8s_info:
        api_version: v1
        kind: Node
      register: node_info

    - name: Extract node names from cluster
      set_fact:
        node_names: "{{ node_info.resources | map(attribute='metadata.name') | list }}"

    - name: Remove old nodes from the cluster
      k8s:
        api_version: v1
        kind: Node
        name: "{{ item }}"
        state: absent
      loop: "{{ node_names | difference(groups[rke2_cluster_group_name]) }}"
      ignore_errors: yes


