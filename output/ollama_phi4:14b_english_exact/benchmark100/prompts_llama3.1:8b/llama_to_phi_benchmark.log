        state: present
      when: is_el_system and is_supported_version

    - name: Install the EPEL GPG key
      ansible.builtin.rpm_key:
        key: "{{ epel_gpg_key }}"
        state: present

    - name: Install the EPEL-release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache

    - name: Install the EPEL-next-release package (conditional)
      ansible.builtin.package:
        name: "{{ epel_next_url }}"
        state: present
      when: epel_next is defined and epel_next | bool
      notify: Update package cache

  handlers:
    - name: Update package cache
      ansible.builtin.package:
        update_cache: true


