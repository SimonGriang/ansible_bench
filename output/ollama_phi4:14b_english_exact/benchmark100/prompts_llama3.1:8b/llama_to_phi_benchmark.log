---
- name: Validate playbook variables and configure GRUB
  hosts: all
  tasks:
    - name: Import assert file to validate playbook variables
      include_tasks: assert.yml

    - name: Install packages required by GRUB
      package:
        name: "{{ grub_packages }}"
        state: present

    - name: Configure the GRUB_TIMEOUT value in /etc/default/grub
      lineinfile:
        path: /etc/default/grub
        line: "GRUB_TIMEOUT={{ grub_timeout }}"
        create: true
        mode: '0664'
      notify: Update grub

    - name: Configure the GRUB_RECORDFAIL_TIMEOUT value in /etc/default/grub
      lineinfile:
        path: /etc/default/grub
        line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
        create: true
        mode: '0664'
      notify: Update grub

    - name: Add options to GRUB_CMDLINE_LINUX in /etc/default/grub
      replace:
        path: /etc/default/grub
        regexp: '^GRUB_CMDLINE_LINUX="(.*)"$'
        replace: 'GRUB_CMDLINE_LINUX="\1 {{ item }}"'
      loop: "{{ grub_options }}"
      when: grub_options is defined and grub_options | length > 0
      notify: Update grub

    - name: Import password file to set GRUB password
      include_tasks: password.yml
      when: grub_set_password | default(false)

  handlers:
    - name: Update grub
      command: update-grub
      become: true

- name: Flush handlers
  hosts: all
  tasks:
    - name: Flush handlers to ensure that all notified handlers are executed
      meta: flush_handlers


