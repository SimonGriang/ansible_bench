---
- name: Configure Apache HTTPD Vhosts
  hosts: all
  vars:
    httpd_vhosts: "{{ httpd_vhosts }}"
  tasks:
    - name: Create the document root for each vhost
      file:
        path: "{{ item.docroot }}"
        state: directory
        mode: '0755'
      when: item.docroot is defined and 
