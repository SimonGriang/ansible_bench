---
- name: Create the document root directory for each vhost
  ansible.builtin.file:
    path: "{{ item.document_root }}"
    state: directory
    mode: "{{ item.document_root_mode | string }}"
  loop: "{{ httpd_vhosts }}"

- name: Configure the Apache vhost configuration files
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "/etc/apache2/sites-available/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"

- name: Enable Apache vhosts on Debian systems
  ansible.builtin.command: a2ensite {{ item.name }}
  args:
    creates: "/etc/apache2/sites-enabled/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"
  when: ansible_facts['os_family'] == "Debian"


