---
- name: Lookup bootstrap facts
  command: cat /etc/os-release
  register: bootstrap_facts_output
  changed_when: false

- name: Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ bootstrap_os_family_map[bootstrap_facts_output.stdout_lines[0].split('=')[1].strip()] }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts_output.stdout_lines[1].split('=')[1].strip() }}"
  when: bootstrap_facts_output.stdout_lines is defined

- name: Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ bootstrap_os_family_map[bootstrap_distribution] }}"
  when: bootstrap_distribution is defined


