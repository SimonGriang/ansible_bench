---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Conditionally configure SELinux
  when: selinux_status and ansible_connection == 'ssh'
  block:
    - name: Manage selinux
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Manage selinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.name }}"


