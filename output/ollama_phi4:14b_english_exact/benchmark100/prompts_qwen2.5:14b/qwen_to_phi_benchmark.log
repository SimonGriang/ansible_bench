---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install HashiCorp products using the package manager
  package:
    name: "{{ hashicorp_product }}"
    state: present

- name: Configure the HashiCorp repository for RedHat-based systems
  yum_repository:
    name: hashicorp
    baseurl: "https://apt.releases.hashicorp.com/RHEL$releasever/$basearch"
    gpgkey: "https://apt.releases.hashicorp.com/gpg"
    gpgcheck: true
    enabled: true

- name: Set up the HashiCorp repository for Debian-based systems
  apt_repository:
    repo: deb [arch=amd64] https://apt.releases.hashicorp.com/{{ ansible_distribution_version }} main
    filename: hashicorp
    state: present

- name: Install the GPG package on Debian-based systems
  package:
    name: gpg
    state: present

- name: Add the HashiCorp GPG key to the system for Debian-based distributions
  apt_key:
    url: "https://apt.releases.hashicorp.com/gpg"
    state: present

- name: Add the HashiCorp repository to the sources list for Debian-based distributions
  apt_repository:
    repo: deb [arch=amd64] https://apt.releases.hashicorp.com/{{ ansible_distribution_version }} main
    filename: hashicorp
    state: present

- name: Install HashiCorp products using the package manager when a specific version is not provided
  package:
    name: "{{ hashicorp_product }}"
    state: present

- name: Install HashiCorp products using the package manager with a specific version when provided
  package:
    name: "{{ hashicorp_product }}={{ hashicorp_version }}"
    state: present

- name: Install HashiCorp products manually by unarchiving them to a specified destination
  unarchive:
    src: "{{ hashicorp_source_url }}"
    dest: "{{ hashicorp_install_dir }}"
    remote_src: true

- name: Unarchive the HashiCorp product source files to the designated installation directory with specific permissions and ownership settings
  unarchive:
    src: "{{ hashicorp_source_url }}"
    dest: "{{ hashicorp_install_dir }}"
    owner: "{{ hashicorp_owner }}"
    group: "{{ hashicorp_group }}"
    mode: "{{ hashicorp_mode }}"
    remote_src: true


