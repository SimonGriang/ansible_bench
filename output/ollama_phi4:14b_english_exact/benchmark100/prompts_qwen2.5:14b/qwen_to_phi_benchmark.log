---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: server_type == 'server'

- name: Copy RKE2 configuration file
  template:
    src: rke2-config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
  notify: Config file changed

- name: Copy kubelet configuration file
  template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
  notify: Config file changed
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

- name: Register if we need to do an etcd restore from file
  set_fact:
    do_etcd_restore: true
  when:
    - rke2_etcd_snapshot_file | length > 0
    - (rke2_server_service_state is undefined or rke2_server_service_state == 'disabled')

- name: Register if we need to do an etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file | length > 0
    - rke2_etcd_snapshot_s3_options is defined
    - rke2_etcd_snapshot_s3_options.access_key is defined
    - rke2_etcd_snapshot_s3_options.secret_key is defined
    - rke2_etcd_snapshot_s3_options.bucket is defined
    - rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /etc/rancher/rke2/etcd-snapshot
        state: directory

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /etc/rancher/rke2/etcd-snapshot/snapshot.db

    - name: Restore etcd from snapshot file
      command: rke2 etcd snapshot restore /etc/rancher/rke2/etcd-snapshot/snapshot.db
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Restore etcd from S3 snapshot
      command: >
        rke2 etcd snapshot restore
        --s3-access-key "{{ rke2_etcd_snapshot_s3_options.access_key }}"
        --s3-secret-key "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
        --s3-bucket "{{ rke2_etcd_snapshot_s3_options.bucket }}"
        --s3-snapshot-name "{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: true
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    enabled: false
    state: stopped
  when: inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Wait for the first server to be ready - no CNI
  wait_for:
    timeout: 600
    msg: Waiting for the first server to be ready without CNI
  when: inventory_hostname == groups[rke2_cluster_group_name][0] and not use_cni

- name: Wait for the first server to be ready - with CNI
  wait_for:
    timeout: 600
    msg: Waiting for the first server to be ready with CNI
  when: inventory_hostname == groups[rke2_cluster_group_name][0] and use_cni

- name: Restore etcd
  block:
    - name: Get registered nodes
      command: rke2-ctl get nodes
      register: registered_nodes

    - name: Remove old node secrets
      command: rke2-ctl remove node {{ item }}
      loop: "{{ registered_nodes.stdout_lines }}"

    - name: Remove old nodes
      command: rke2-ctl remove node {{ item }}
      loop: "{{ registered_nodes.stdout_lines }}"
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: inventory_hostname in groups[rke2_cluster_group_name]


