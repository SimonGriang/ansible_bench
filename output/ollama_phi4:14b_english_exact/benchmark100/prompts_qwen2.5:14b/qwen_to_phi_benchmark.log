---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize PKI in /etc/openvpn/easy-rsa directory if it doesn't already exist
  command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts['files'] | selectattr('path', 'equalto', 
    '/etc/openvpn/easy-rsa/pki/index.txt') | list | length

- name: Build the Certificate Authority (CA) without interactive prompts if the CA certificate does not already exist
  command: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts['files'] | selectattr('path', 'equalto', 
    '/etc/openvpn/easy-rsa/pki/ca.crt') | list | length

- name: Generate Diffie-Hellman parameters if they do not already exist
  command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts['files'] | selectattr('path', 'equalto', 
    '/etc/openvpn/easy-rsa/pki/dh.pem') | list | length

- name: Build a server certificate and key without interactive prompts if the server certificate does not already exist
  command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts['files'] | selectattr('path', 'equalto', 
    '/etc/openvpn/easy-rsa/pki/issued/server.crt') | list | length

- name: Build a client certificate and key without interactive prompts if the client certificate does not already exist
  command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts['files'] | selectattr('path', 'equalto', 
    '/etc/openvpn/easy-rsa/pki/issued/client.crt') | list | length

- name: Generate a Certificate Revocation List (CRL) if it does not already exist
  command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts['files'] | selectattr('path', 'equalto', 
    '/etc/openvpn/easy-rsa/pki/crl.pem') | list | length

- name: Generate a static key for the OpenVPN tunnel if the static key does not already exist
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  when: not ansible_facts['files'] | selectattr('path', 'equalto', 
    '/etc/openvpn/easy-rsa/pki/ta.key') | list | length

- name: Copy necessary files from /etc/openvpn/easy-rsa/pki to /etc/openvpn/server directory with appropriate permissions
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    owner: root
    group: root
    mode: "{{ item.mode }}"
  with_items:
    - { src: '/etc/openvpn/easy-rsa/pki/ca.crt', dest: '/etc/openvpn/server/ca.crt', 
        mode: '0644' }
    - { src: '/etc/openvpn/easy-rsa/pki/issued/server.crt', dest: '/etc/openvpn/server/server.crt', 
        mode: '0644' }
    - { src: '/etc/openvpn/easy-rsa/pki/private/server.key', dest: '/etc/openvpn/server/server.key', 
        mode: '0600' }
    - { src: '/etc/openvpn/easy-rsa/pki/dh.pem', dest: '/etc/openvpn/server/dh.pem', 
        mode: '0644' }
    - { src: '/etc/openvpn/easy-rsa/pki/ta.key', dest: '/etc/openvpn/server/ta.key', 
        mode: '0600' }
    - { src: '/etc/openvpn/easy-rsa/pki/crl.pem', dest: '/etc/openvpn/server/crl.pem', 
        mode: '0644' }

- name: Copy necessary files from /etc/openvpn/easy-rsa/pki to /etc/openvpn directory with appropriate permissions
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    owner: root
    group: root
    mode: "{{ item.mode }}"
  with_items:
    - { src: '/etc/openvpn/easy-rsa/pki/ca.crt', dest: '/etc/openvpn/ca.crt', 
        mode: '0644' }
    - { src: '/etc/openvpn/easy-rsa/pki/issued/server.crt', dest: '/etc/openvpn/server.crt', 
        mode: '0644' }
    - { src: '/etc/openvpn/easy-rsa/pki/private/server.key', dest: '/etc/openvpn/server.key', 
        mode: '0600' }
    - { src: '/etc/openvpn/easy-rsa/pki/dh.pem', dest: '/etc/openvpn/dh.pem', 
        mode: '0644' }
    - { src: '/etc/openvpn/easy-rsa/pki/ta.key', dest: '/etc/openvpn/ta.key', 
        mode: '0600' }
    - { src: '/etc/openvpn/easy-rsa/pki/crl.pem', dest: '/etc/openvpn/crl.pem', 
        mode: '0644' }

- name: Place the server configuration file using a template and notify the handler to restart openvpn service after the file is placed
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
  notify:
    - restart openvpn


