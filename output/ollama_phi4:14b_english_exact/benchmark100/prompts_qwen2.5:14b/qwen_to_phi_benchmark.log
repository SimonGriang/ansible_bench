---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.ping:

    - name: Test sudo availability
      ansible.builtin.command: echo "Check sudo"
      register: result
      changed_when: false

    - name: Gather bootstrap facts if needed
      ansible.builtin.setup:
        gather_subset:
          - '!all'
        gather_network_info: false
        gather_facts: false
      register: bootstrap_facts
      when: "'sudo' not in result.stdout"

    - name: Install necessary packages
      ansible.builtin.raw: apt-get update && apt-get install -y python3 sudo
      register: install_result
      changed_when: false
      when: "'sudo' not in result.stdout"

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  notify:
    - update_cache


