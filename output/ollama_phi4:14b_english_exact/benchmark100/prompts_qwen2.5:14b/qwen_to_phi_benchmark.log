          https://github.com/rancher/rke2/releases/download/{{ rke2_version }}
          /rke2-server-{{ ansible_distribution }}-{{ ansible_distribution_version
          }}-{{ ansible_architecture }}
        dest: "/tmp/rke2-server"
        mode: '0755'
    - name: Install RKE2
      command: "/tmp/rke2-server install"
      args:
        creates: "/usr/local/bin/rke2-server"

- name: CIS Hardening
  block:
    - name: Perform CIS Hardening
      include_role:
        name: cis_hardening
      when: cis_profile is defined

- name: Find Active Server
  block:
    - name: Identify active server
      set_fact:
        active_server: "{{ groups['rke2_server'][0] }}"

- name: Enable IPVS kernel module
  block:
    - name: Load IPVS module
      modprobe:
        name: ip_vs
        state: present
      when:
        - rke2_ha_enabled | bool
        - rke2_use_kube_vip | bool

- name: Copy kube-vip manifests to the masternode
  block:
    - name: Copy kube-vip manifests
      copy:
        src: "files/kube-vip-manifest.yaml"
        dest: "/etc/rancher/rke2/server/manifests/kube-vip.yaml"
      when: not rke2_use_keepalived | bool

- name: Copy ingress-nginx manifests to the masternode
  block:
    - name: Copy ingress-nginx manifests
      copy:
        src: "files/ingress-nginx-manifest.yaml"
        dest: "/etc/rancher/rke2/server/manifests/ingress-nginx.yaml"
      when: ingress_nginx_config is defined

- name: Prepare very first server node in the cluster
  block:
    - name: Initialize the first server node
      command: >
        /usr/local/bin/rke2 server --node-ip
        {{ hostvars[inventory_hostname]['ansible_all_ipv4_addresses'][0] }}

- name: Restore etcd specific tasks
  block:
    - name: Restore etcd
      include_role:
        name: restore_etcd
      when: restore_etcd_required | bool

- name: Download kubeconfig to ansible localhost
  block:
    - name: Download kubeconfig
      fetch:
        src: "/etc/rancher/rke2/rke2.yaml"
        dest: "~/rke2-kubeconfig.yaml"
        flat: yes
      when: download_kubeconfig | bool

- name: Prepare and join remaining nodes of the cluster
  block:
    - name: Prepare and join nodes
      command: "/usr/local/bin/rke2 agent --server {{ active_server }}"
      when: active_server is defined

- name: Rolling cordon and drain restart when version changes - servers
  block:
    - name: Perform rolling restart for servers
      command: "/usr/local/bin/rke2 server --force-restart"
      when: rke2_version_changed | bool

- name: Rolling cordon and drain restart when version changes - agents
  block:
    - name: Perform rolling restart for agents
      command: "/usr/local/bin/rke2 agent --force-restart"
      when: rke2_version_changed | bool

- name: Flush handlers
  block:
    - name: Flush handlers
      meta: flush_handlers

- name: Rolling restart when config files change
  block:
    - name: Perform rolling restart for config changes
      command: "/usr/local/bin/rke2 server --force-restart"
      when: rke2_config_changed | bool

- name: Final steps
  block:
    - name: Final steps
      debug:
        msg: "Ansible playbook execution completed."


