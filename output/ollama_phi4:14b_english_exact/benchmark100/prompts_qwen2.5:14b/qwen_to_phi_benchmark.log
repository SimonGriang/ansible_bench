---
- name: Set a fact for ansible_package_state
  set_fact:
    ansible_package_state: "{{ ansible_facts['os_family'] == 'RedHat' and ansible_facts['distribution'] == 'Fedora' | ternary('latest', 'present') }}"
  when: ansible_facts['ansible_pkg_mgr'] == 'yum' or ansible_facts['ansible_pkg_mgr'] == 'dnf'

- name: Set up Ansible on RedHat
  include_tasks: setup-RedHat.yml
  when: ansible_facts['os_family'] == 'RedHat' and ansible_facts['distribution'] != 'Fedora' and ansible_facts['ansible_pkg_mgr'] in ['yum', 'dnf']

- name: Set up Ansible on Fedora
  include_tasks: setup-Fedora.yml
  when: ansible_facts['os_family'] == 'RedHat' and ansible_facts['distribution'] == 'Fedora' and ansible_facts['ansible_pkg_mgr'] in ['yum', 'dnf']

- name: Set up Ansible on Ubuntu
  include_tasks: setup-Ubuntu.yml
  when: ansible_facts['os_family'] == 'Debian' and ansible_facts['distribution'] == 'Ubuntu' and ansible_facts['ansible_pkg_mgr'] == 'apt'

- name: Set up Ansible on Debian
  include_tasks: setup-Debian.yml
  when: ansible_facts['os_family'] == 'Debian' and ansible_facts['distribution'] != 'Ubuntu' and ansible_facts['ansible_pkg_mgr'] == 'apt'

- name: Set up Ansible using Pip
  include_tasks: setup-pip.yml
  when: ansible_facts['ansible_python_interpreter'] == '/usr/bin/python3' and ansible_facts['ansible_pkg_mgr'] == 'pip'


