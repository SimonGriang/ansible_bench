- name: Import assert.yml
  import_tasks: assert.yml
  when: inventory_hostname == 'control_machine'  # Assuming 'control_machine' is your control machine identifier

- name: Install fail2ban
  package:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Copy filters in filter.d
