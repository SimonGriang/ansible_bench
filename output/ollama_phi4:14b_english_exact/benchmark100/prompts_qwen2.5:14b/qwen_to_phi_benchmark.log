---
- name: create | Create ssl key
  openssl_privatekey:
    path: "{{ ssl_dir }}/{{ inventory_hostname }}.key"
    size: 2048
    owner: root
    group: root
    mode: '0600'

- name: create | Create ssl csr
  openssl_csr:
    path: "{{ ssl_dir }}/{{ inventory_hostname }}.csr"
    privatekey_path: "{{ ssl_dir }}/{{ inventory_hostname }}.key"
    common_name: "{{ inventory_hostname }}"
    owner: root
    group: root
    mode: '0600'

- name: create | Create ssl certificates
  openssl_certificate:
    path: "{{ ssl_dir }}/{{ inventory_hostname }}.crt"
    privatekey_path: "{{ ssl_dir }}/{{ inventory_hostname }}.key"
    csr_path: "{{ ssl_dir }}/{{ inventory_hostname }}.csr"
    provider: selfsigned
    owner: root
    group: root
    mode: '0644'

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ ssl_dir }}/{{ inventory_hostname }}.p12"
    privatekey_path: "{{ ssl_dir }}/{{ inventory_hostname }}.key"
    certificate_path: "{{ ssl_dir }}/{{ inventory_hostname }}.crt"
    passphrase: "{{ p12_passphrase }}"
    export_chain: yes
    owner: root
    group: root
    mode: '0600'

- name: create | Read private key
  slurp:
    src: "{{ ssl_dir }}/{{ inventory_hostname }}.key"
  register: private_key_contents

- name: create | Read certificate
  slurp:
    src: "{{ ssl_dir }}/{{ inventory_hostname }}.crt"
  register: certificate_contents

- name: create | Create combined private_key and certificate file
  copy:
    dest: "{{ ssl_dir }}/{{ inventory_hostname }}.combined"
    content: |
      {{ private_key_contents.content | b64decode }}
      {{ certificate_contents.content | b64decode }}
    owner: root
    group: root
    mode: '0644'


