---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Pre-configure Debian systems
  vars:
    debconf_selections:
      - { package: 'postfix', question: 'postfix/main_mailer_type', vtype: 'select', vvalue: 'No configuration' }
  debconf:
    name: "{{ item.package }}"
    question: "{{ item.question }}"
    vtype: "{{ item.vtype }}"
    vvalue: "{{ item.vvalue }}"
    state: present
  loop: "{{ debconf_selections }}"
  when: ansible_os_family == 'Debian'

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: 
    - postfix_virtual_mailbox_maps is defined and 'mysql' in postfix_virtual_mailbox_maps
    - postfix_virtual_mailbox_domains is defined and 'mysql' in postfix_virtual_mailbox_domains
    - postfix_virtual_alias_maps is defined and 'mysql' in postfix_virtual_alias_maps

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
  notify: 
    - Validate postfix configuration
    - Rebuild transport_maps database

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify: 
    - Validate postfix configuration
    - Reload postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_smtpd_restriction: "{{ item }}"
  with_items:
    - { var: 'smtpd_recipient_restrictions', value: 'reject_unauth_destination' }
    - { var: 'smtpd_sender_restrictions', value: 'reject_non_fqdn_sender' }
  when: 
    - item.var is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf_values: "{{ postfix_main_cf_values | default({}) | combine({ item.var: item.value }) }}"
  with_items:
    - { var: 'mynetworks', value: '127.0.0.0/8 [::1]/128' }
    - { var: 'mydestination', value: 'localhost.localdomain, localhost' }
    - { var: 'relay_domains', value: 'example.com' }
    - { var: 'smtpd_recipient_restrictions', value: 'permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination' }
    - { var: 'smtpd_sender_restrictions', value: 'permit_sasl_authenticated, reject_non_fqdn_sender' }
    - { var: 'virtual_mailbox_domains', value: 'example.com' }
    - { var: 'virtual_alias_domains', value: 'example.com' }
  when:
    - item.var is defined

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify: 
    - Validate postfix configuration
    - Restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify: 
    - Validate postfix configuration
    - Restart postfix

- name: Creates cert/key directory
  file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
  loop:
    - { path: "{{ postfix_smtpd_tls_cert_file | dirname }}" }
    - { path: "{{ postfix_smtpd_tls_key_file | dirname }}" }

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_certificate_src }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
  notify: 
    - Reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_src }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
  notify: 
    - Reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  block:
    - lineinfile:
        path: /etc/aliases
        line: "{{ item.line }}"
      loop: "{{ aliases }}"
    - command: newaliases
  notify: 
    - Rebuild alias database
    - Reload postfix

- name: Configure sender_access
  block:
    - lineinfile:
        path: /etc/postfix/sender_access
        line: "{{ item.line }}"
      loop: "{{ sender_access }}"
    - command: postmap /etc/postfix/sender_access
  notify: 
    - Rebuild sender_access database
    - Reload postfix

- name: Configure recipient_access
  block:
    - lineinfile:
        path: /etc/postfix/recipient_access
        line: "{{ item.line }}"
      loop: "{{ recipient_access }}"
    - command: postmap /etc/postfix/recipient_access
  notify: 
    - Validate postfix configuration
    - Rebuild recipient_access database
    - Reload postfix

- name: Place sasl_password_map
  template:
    src: sasl_password_map.j2
    dest: /etc/postfix/sasl_password
  notify: 
    - Rebuild sasl_password_map database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true


