---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  k8s:
    state: present
    definition:
      apiVersion: v1
      kind: Node
      metadata:
        name: "{{ inventory_hostname }}"
      spec:
        taints:
        - key: node-role.kubernetes.io/control-plane
          effect: NoSchedule
          value: ""

- name: Set agent taints
  k8s:
    state: present
    definition:
      apiVersion: v1
      kind: Node
      metadata:
        name: "{{ inventory_hostname }}"
      spec:
        taints:
        - key: node-role.kubernetes.io/agent
          effect: NoSchedule
          value: ""

- name: Copy RKE2 config file
  copy:
    src: rke2-config.yaml
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify:
    - restart rke2

- name: Copy kubelet config file
  copy:
    src: kubelet-config.yaml
    dest: /etc/kubernetes/kubelet.config.yaml
    owner: root
    group: root
    mode: '0644'
  when: kubelet_config_content is defined and kubelet_config_content | length > 0
  notify:
    - restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: containerd-registry-config.yaml
    dest: /etc/containerd/registry.conf
    owner: root
    group: root
    mode: '0644'
  when: containerd_registry_config is defined and containerd_registry_config | length > 0
  notify:
    - restart rke2

- name: Start RKE2 service
  service:
    name: rke2-server
    state: started
    enabled: yes
  until: rke2_is_running is defined and rke2_is_running | bool
  retries: 5
  delay: 10
  notify:
    - restart rke2

- name: Mask other RKE2 services
  command: systemctl mask rke2-{{ item }}
  loop:
    - agent
    - node
  when: rke2_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  command: kubectl get nodes --field-selector=status.phase!=Running
  register: nodes
  until: nodes.stdout | length == 0
  retries: 10
  delay: 30

- name: Wait for remaining nodes to be ready - with CNI
  command: kubectl get nodes
  register: nodes
  until: "'Ready'" in nodes.stdout
  retries: 10
  delay: 30

handlers:
  - name: restart rke2
    service:
      name: rke2
      state: restarted


