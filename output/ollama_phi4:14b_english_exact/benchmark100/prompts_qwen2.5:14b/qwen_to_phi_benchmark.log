---
- name: Import assert.yml
  include: assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Conditionally configure SELinux
  when: ansible_selinux.status == 'enabled' and ansible_connection == 'ssh'
  block:
    - name: Manage SELinux
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot system

    - name: Manage SELinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.name }}"


