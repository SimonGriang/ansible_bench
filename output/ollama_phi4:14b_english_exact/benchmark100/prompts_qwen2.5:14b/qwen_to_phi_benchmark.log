---
- name: Download RKE2 installation script
  ansible.builtin.get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: "{{ rke2_install_script_mode }}"
    timeout: "{{ rke2_install_script_timeout }}"

- name: Copy local RKE2 installation script
  ansible.builtin.copy:
    src: "{{ rke2_local_install_script }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: 0700
    force: yes
  when: 
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifacts_folder }}"
    state: directory
    mode: 0700
  when: 
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode != "exists"

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum file
      ansible.builtin.get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_dest }}"
        mode: 0644

    - name: Download RKE2 artifacts
      ansible.builtin.get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_dest }}"
        mode: 0644

    - name: Download RKE2 install script
      ansible.builtin.get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_dest }}"
        mode: "{{ rke2_install_script_mode }}"
        timeout: "{{ rke2_install_script_timeout }}"
  when: 
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode == "download"

- name: Rescue for failed download
  block:
    - name: Create directory for local RKE2 artifacts
      ansible.builtin.file:
        path: "{{ local_rke2_artifacts_dir }}"
        state: directory

    - name: Download RKE2 artifacts locally
      ansible.builtin.get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ local_rke2_artifacts_dir }}"

    - name: Download RKE2 install script locally
      ansible.builtin.get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ local_rke2_install_script }}"
        mode: "{{ rke2_install_script_mode }}"
        timeout: "{{ rke2_install_script_timeout }}"

    - name: Copy local RKE2 artifacts to remote
      ansible.builtin.copy:
        src: "{{ local_rke2_artifacts_dir }}/"
        dest: "{{ rke2_artifacts_dest }}"
        mode: 0644
        force: yes
  when: download_failed | default(false)

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "{{ local_rke2_artifacts_dir }}/"
    dest: "{{ rke2_artifact_path }}"
    mode: 0640
    force: yes
  when: 
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create folder for additional images tarballs
      ansible.builtin.file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: 0755

    - name: Copy additional images tarballs
      ansible.builtin.copy:
        src: "{{ item }}"
        dest: "{{ rke2_tarball_images_path }}"
        mode: 0644
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"
  when: 
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode == "copy"
    - rke2_airgap_copy_additional_tarballs | length > 0
    - rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure artifacts exist
      ansible.builtin.file:
        path: "{{ item }}"
        state: file
      loop:
        - "{{ rke2_artifacts_dest }}"
        - "{{ rke2_install_script_dest }}"

    - name: Ensure acceptable permissions
      ansible.builtin.file:
        path: "{{ item }}"
        mode: "{{ item | regex_replace('(?<=r)(r|w|x)+', '') }}"
      loop:
        - "{{ rke2_artifacts_dest }}"
        - "{{ rke2_install_script_dest }}"
  when: 
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode == "exists"

- name: Populate service facts
  ansible.builtin.service_facts:

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: "/usr/local"
  register: fs_stats

- name: Check if separate partition
  ansible.builtin.command: grep '/usr/local' /proc/mounts
  register: separate_partition_check

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: "/usr/local/bin/rke2" # Adjust based on previous tasks

- name: Check RKE2 version
  ansible.builtin.command: rke2 version
  register: rke2_version_check

- name: Set RKE2 versions
  ansible.builtin.set_fact:
    rke2_installed_version: "{{ rke2_version_check.stdout_lines[0] }}"
    rke2_running_version: "{{ rke2_version_check.stdout_lines[1] }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.fail:
    msg: "RKE2 downgrade detected and not allowed"
  when: 
    - rke2_installed_version is defined
    - rke2_running_version is defined
    - rke2_installed_version > rke2_running_version
    - not rke2_allow_downgrade

- name: Run RKE2 install script
  ansible.builtin.command: "{{ rke2_install_script_dest }}"
  when: 
    - rke2_installed_version is defined
    - rke2_installed_version != rke2_running_version
    - not ansible_check_mode
  vars:
    ansible_become: yes
    ansible_become_method: sudo

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ rke2_data_path }}/{{ item.dest }}"
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ rke2_agent_pod_manifests_path }}/{{ item.dest }}"
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  ansible.builtin.copy:
    src: "{{ rke2_environment_file }}"
    dest: "/etc/rancher/rke2/config.yaml"
  when: 
    - rke2_environment_options is defined
    - rke2_environment_options | length > 0


