---
- name: Ensure apt key is not present in trusted.gpg.d
  ansible.builtin.file:
    path: /usr/share/keyrings/docker-archive-keyring.gpg
    state: absent

- name: Ensure old apt source list is not present in /etc/apt/sources.list.d
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure old versions of Docker are not installed
  ansible.builtin.package:
    name: "{{ item }}"
    state: absent
  loop:
    - docker
    - docker-engine
    - docker.io
    - containerd
    - runc

- name: Ensure legacy repo file is not present
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure dependencies are installed
  ansible.builtin.package:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Add or remove Docker repository
  ansible.builtin.template:
    src: docker.list.j2
    dest: /etc/apt/sources.list.d/docker.list
    mode: '0644'
  when: docker_add_repo | bool
  notify: Update apt cache

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: yes

handlers:
  - name: Update apt cache
    ansible.builtin.apt:
      update_cache: yes


