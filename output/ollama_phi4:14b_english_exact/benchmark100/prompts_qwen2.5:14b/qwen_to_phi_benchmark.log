---
- name: Check if all variables have been set correctly
  ansible.builtin.assert:
    that:
      - var1 is defined
      - var2 is defined
      - var3 is defined
    fail_msg: "One or more required variables are not set correctly."
    success_msg: "All required variables are set correctly."

- name: Wait for host (when configured)
  ansible.builtin.wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ bootstrap_port }}"
    state: started
    timeout: 300
    delay: 10
  when: bootstrap_wait_for_host | default(false)

- name: Prepare system
  block:
    - name: Establish connection and gather facts
      ansible.builtin.setup:
        gather_subset: '!all'
      register: setup_result
      ignore_errors: true
      failed_when: >
        setup_result is failed and
        "'Timeout' not in setup_result.msg"

    - name: Display debug message if connection fails
      ansible.builtin.debug:
        msg: "Failed to establish connection or gather facts."
      when: setup_result is failed

    - name: Include tasks to gather bootstrap facts (raw)
      ansible.builtin.include_tasks: gather_bootstrap_facts.yml

    - name: Install bootstrap packages (raw)
      ansible.builtin.raw: "{{ bootstrap_install.raw }}"
      when: ansible_os_family == 'RedHat' and bootstrap_install.raw is defined
      changed_when: false

    - name: Ensure system is prepared by issuing ansible modules
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap_packages }}"
      when: bootstrap_packages is defined
      changed_when: false


