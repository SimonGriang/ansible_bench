---
- name: Create ssl key
  ansible.builtin.file:
    path: "{{ item.key_path }}"
    state: touch
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"

- name: Create ssl csr
  community.crypto.openssl_csr:
    path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    common_name: "{{ item.common_name }}"
    state: present
  loop: "{{ ssl_items }}"

- name: Create ssl certificates
  community.crypto.x509_certificate:
    path: "{{ item.cert_path }}"
    privatekey_path: "{{ item.key_path }}"
    csr_path: "{{ item.csr_path }}"
    provider:
      country_name: "{{ item.country_name }}"
      state_or_province_name: "{{ item.state_name }}"
      locality_name: "{{ item.locality }}"
      organization_name: "{{ item.org_name }}"
      organizational_unit_name: "{{ item.org_unit }}"
      common_name: "{{ item.common_name }}"
  loop: "{{ ssl_items }}"

- name: Create PKCS#12 file
  ansible.builtin.command:
    cmd: "openssl pkcs12 -export -in {{ item.cert_path }} -inkey {{ item.key_path }} -out {{ item.p12_path }} -name {{ item.friendly_name }}"
  loop: "{{ ssl_items }}"

- name: Set PKCS#12 file permissions
  ansible.builtin.file:
    path: "{{ item.p12_path }}"
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"

- name: Read private key
  ansible.builtin.slurp:
    path: "{{ item.key_path }}"
  register: private_key_content
  loop: "{{ ssl_items }}"

- name: Read certificate
  ansible.builtin.slurp:
    path: "{{ item.cert_path }}"
  register: certificate_content
  loop: "{{ ssl_items }}"

- name: Create combined private_key and certificate file
  ansible.builtin.copy:
    content: "{{ private_key_content.results[item.index].content | b64decode }}\n{{ certificate_content.results[item.index].content | b64decode }}"
    dest: "{{ item.combined_path }}"
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ ssl_items }}"
  loop_control:
    index_var: index


