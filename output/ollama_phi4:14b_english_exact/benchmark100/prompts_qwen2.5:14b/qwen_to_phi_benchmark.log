ers | grep -q "{{ inventory_hostname }}\\s*Ready"\n  register: node_ready\n  until: node_ready.rc == 0\n  retries: 30\n  delay: 10\n```\n\nThis playbook strictly adheres to the task descriptions and follows the structure required for inclusion in an Ansible Role under the `tasks/` directory. It omits hosts, vars, and playbook-level headers as specified.' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-08T18:30:52.033865935Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11268743506, 'load_duration': 2485050167, 'prompt_eval_count': 604, 'prompt_eval_duration': 392844788, 'eval_count': 677, 'eval_duration': 8390145735, 'model_name': 'phi4:14b'} id='run--a0040ad5-d256-41bb-8efe-6724aef54a53-0' usage_metadata={'input_tokens': 604, 'output_tokens': 677, 'total_tokens': 1281}
