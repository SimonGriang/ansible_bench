---
- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  ansible.builtin.set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Include OS-specific variables based on distribution
  ansible.builtin.include_vars:
    file: "vars/{{ ansible_os_family }}.yml"
  when: ansible_os_family is defined

- name: Include architecture-specific variables
  ansible.builtin.include_vars:
    file: "vars/architecture_{{ ansible_architecture }}.yml"

- name: Set OS-specific variables (part I)
  ansible.builtin.set_fact:
    os_specific_var: "{{ os_specific_var | default('default_value') }}"
  when: os_specific_var is not none

- name: Set OS and architecture-specific variables (part II)
  ansible.builtin.set_fact:
    os_arch_specific_var: "{{ os_arch_specific_var | default('default_value') }}"
  when: os_arch_specific_var is not none

- name: Set specific variables
  ansible.builtin.set_fact:
    java_home: "/usr/lib/jvm/java-{{ java_version }}-openjdk"

- block:
    - name: Debian pre-requisites
      ansible.builtin.apt_repository:
        repo: "deb http://deb.debian.org/debian {{ ansible_lsb.codename }} main"
        state: present

    - name: Debian pre-requisites
      ansible.builtin.apt:
        name: "apt-transport-https"
        state: present

    - name: Debian pre-requisites
      ansible.builtin.apt_key:
        url: "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x<KEY>"
        state: present

  when: ansible_os_family == "Debian"

- block:
    - name: RedHat pre-requisites
      ansible.builtin.yum_repository:
        name: "remi"
        description: "Remi's RPM repository for Enterprise Linux 7 - $basearch"
        baseurl: "https://rpms.remirepo.net/enterprise/7/remi/$basearch/"
        gpgcheck: 1
        enabled: 1

    - name: RedHat pre-requisites
      ansible.builtin.yum_key:
        key: https://rpms.remirepo.net/RPM-GPG-KEY-remi
        state: present

  when: ansible_os_family == "RedHat"

- name: Install required libraries
  ansible.builtin.package:
    name: "{{ java_required_libraries }}"
    state: present

- block:
    - name: Install Java, Debian
      ansible.builtin.apt:
        name: "openjdk-{{ java_version }}-jdk"
        state: present
        update_cache: yes

    - name: Verify Java package installation, Debian
      ansible.builtin.apt_facts:
      register: apt_facts
    - ansible.builtin.assert:
        that:
          - "'openjdk-{{ java_version }}-jdk' in apt_facts.packages"

  when: ansible_os_family == "Debian"

- block:
    - name: Install Java, RedHat
      ansible.builtin.yum:
        name: "java-{{ java_version }}-openjdk"
        state: present
        update_cache: yes

    - name: Verify Java package installation, RedHat
      ansible.builtin.yum_facts:
      register: yum_facts
    - ansible.builtin.assert:
        that:
          - "'java-{{ java_version }}-openjdk' in yum_facts.packages"

  when: ansible_os_family == "RedHat"

- name: Export environment variables
  ansible.builtin.template:
    src: "templates/java_env.j2"
    dest: "/etc/profile.d/java_env.sh"
    mode: "0644"

- name: Source environment variables
  ansible.builtin.shell: ". /etc/profile.d/java_env.sh"

- block:
    - name: Correct java version selected for Java versions less than 11
      ansible.builtin.alternatives:
        name: "java"
        path: "/usr/lib/jvm/java-{{ java_version }}-openjdk/bin/java"
      when: java_version is version('11', '<')

  when: ansible_os_family == "Debian"

- block:
    - name: Correct java version selected for Java versions greater than or equal to 11
      ansible.builtin.alternatives:
        name: "java"
        path: "/usr/lib/jvm/java-{{ java_version }}-openjdk/bin/java"
      when: java_version is version('11', '>=')

  when: ansible_os_family == "Debian"


