---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/my.cnf
    regexp: '^{{ item.key }}'
    line: '{{ item.key }} = {{ item.value }}'
  loop: "{{ mysql_configuration_options | dict2items }}"

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/conf.d/client.cnf
    line: 'socket = /var/run/mysqld/mysqld.sock'
    create: yes

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: mysql
    group: mysql
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: item.initial_import is not defined

- name: List databases
  shell: mysql -e 'SHOW DATABASES;'
  register: mysql_databases_list

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.source }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers
  meta: flush_handlers

- name: Flush handlers again
  meta: flush_handlers


