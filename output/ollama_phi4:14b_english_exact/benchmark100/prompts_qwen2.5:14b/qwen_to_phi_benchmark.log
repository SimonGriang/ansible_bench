content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  hosts: localhost\n  gather_facts: no\n\n- name: Install requirements\n  package:\n    name: "{{ openssl_requirements }}"\n    state: present\n\n- name: Install pip packages\n  pip:\n    name: "{{ openssl_pip_packages }}"\n    state: present\n  when: openssl_pip_packages is defined and openssl_pip_packages | length > 0\n\n- name: Create key directory\n  file:\n    path: "{{ openssl_key_directory }}"\n    state: directory\n    mode: \'0700\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create csr directory\n  file:\n    path: "{{ openssl_csr_directory }}"\n    state: directory\n    mode: \'0755\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create crt directory\n  file:\n    path: "{{ openssl_crt_directory }}"\n    state: directory\n    mode: \'0755\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Include create.yml\n  include_tasks: create.yml\n  loop: "{{ openssl_items }}"\n  when: openssl_items is defined and openssl_items | length > 0\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-08T17:43:02.321888694Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4580984695, 'load_duration': 72231731, 'prompt_eval_count': 551, 'prompt_eval_duration': 262541334, 'eval_count': 277, 'eval_duration': 4245051279, 'model_name': 'phi4:14b'} id='run--1288dec3-5775-404b-b392-3c6437eaef6d-0' usage_metadata={'input_tokens': 551, 'output_tokens': 277, 'total_tokens': 828}
