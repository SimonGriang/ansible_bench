---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_server == 'server'

- name: Copy RKE2 configuration file
  template:
    src: config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
  notify: Config file changed

- name: Copy kubelet configuration file
  template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
  when: rke2_kubelet_config != ""
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  template:
    src: registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
  when: rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != ""
  notify: Config file changed

- name: Register if we need to do an etcd restore from file
  set_fact:
    do_etcd_restore: true
  when:
    - rke2_etcd_snapshot_file != ""
    - (rke2_server_service is not defined or rke2_server_service.state != "started")

- name: Register if we need to do an etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file != ""
    - rke2_etcd_snapshot_s3_options is defined
    - rke2_etcd_snapshot_s3_options.access_key is defined
    - rke2_etcd_snapshot_s3_options.secret_key is defined
    - rke2_etcd_snapshot_s3_options.bucket is defined
    - rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create the RKE2 etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/etcd-snapshots
        state: directory
        mode: '0755'

    - name: Copy the etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/etcd-snapshots/snapshot.db
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Download etcd snapshot from S3
      aws_s3:
        bucket: "{{ rke2_etcd_snapshot_s3_options.bucket }}"
        object: "{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
        dest: /var/lib/rancher/rke2/etcd-snapshots/snapshot.db
        aws_access_key: "{{ rke2_etcd_snapshot_s3_options.access_key }}"
        aws_secret_key: "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: true
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: stopped
    enabled: false
    masked: true

- name: Wait for the first server be ready - no CNI
  wait_for:
    timeout: 300
    condition: >-
      "'ready' in (shell('kubectl get node {{ ansible_hostname }} -o
      jsonpath=\"{.status.conditions[?(@.type==\\'Ready\\')].status}\"')) and
      'CNI' not in (shell('kubectl get node {{ ansible_hostname }} -o
      jsonpath=\"{.status.conditions[?(@.type==\\'NetworkUnavailable\\')].status}\"'))"

- name: Wait for the first server be ready - with CNI
  wait_for:
    timeout: 300
    condition: >-
      "'ready' in (shell('kubectl get node {{ ansible_hostname }} -o
      jsonpath=\"{.status.conditions[?(@.type==\\'Ready\\')].status}\"')) and
      'NetworkUnavailable' not in (shell('kubectl get node {{ ansible_hostname }} -o
      jsonpath=\"{.status.conditions[?(@.type==\\'NetworkUnavailable\\')].status}\"'))"

- name: Restore etcd
  block:
    - name: Get registered nodes
      shell: kubectl get nodes -o=jsonpath='{.items[*].metadata.name}'
      register: nodes

    - name: Remove old node secrets
      shell: kubectl delete secret "{{ item }}"
      loop: "{{ nodes.stdout_lines }}"
      when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

    - name: Remove old nodes
      shell: kubectl delete node "{{ item }}"
      loop: "{{ nodes.stdout_lines }}"
      when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"
  when: rke2_server == 'server'

handlers:
  - name: Config file changed
    service:
      name: rke2-server
      state: restarted


