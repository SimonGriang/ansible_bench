content='```yaml\n---\n- name: Download RKE2 kubeconfig to localhost\n  ansible.builtin.fetch:\n    src: "/etc/rancher/rke2/rke2.yaml"\n    dest: "{{ rke2_download_kubeconf_path }}"\n    flat: yes\n    remote_src: yes\n    fail_on_missing: yes\n  when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]\n\n- name: Replace loopback IP by master server IP\n  ansible.builtin.replace:\n    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    regexp: \'(127\\.0\\.0\\.1|::1)\'\n    replace: "{{ rke2_api_ip | default(groups[rke2_servers_group_name][0] | ansible.builtin.default(\'\')) }}"\n  when:\n    - not ansible_check_mode\n    - rke2_download_kubeconf\n    - inventory_hostname == groups[rke2_servers_group_name][0]\n  delegate_to: localhost\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-18T21:44:44.938557091Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3956812412, 'load_duration': 65016256, 'prompt_eval_count': 536, 'prompt_eval_duration': 279816235, 'eval_count': 222, 'eval_duration': 3610188891, 'model_name': 'phi4:14b'} id='run--5e428714-1a6b-449b-80a9-271c2e9c7261-0' usage_metadata={'input_tokens': 536, 'output_tokens': 222, 'total_tokens': 758}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Download RKE2 kubeconfig to localhost
  ansible.builtin.fetch:
    src: "/etc/rancher/rke2/rke2.yaml"
    dest: "{{ rke2_download_kubeconf_path }}"
    flat: yes
    remote_src: yes
    fail_on_missing: yes
  when: rke2_download_kubeconf and inventory_hostname == groups[rke2_servers_group_name][0]

- name: Replace loopback IP by master server IP
  ansible.builtin.replace:
    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    regexp: '(127\.0\.0\.1|::1)'
    replace: "{{ rke2_api_ip | default(groups[rke2_servers_group_name][0] | ansible.builtin.default('')) }}"
  when:
    - not ansible_check_mode
    - rke2_download_kubeconf
    - inventory_hostname == groups[rke2_servers_group_name][0]
  delegate_to: localhost


