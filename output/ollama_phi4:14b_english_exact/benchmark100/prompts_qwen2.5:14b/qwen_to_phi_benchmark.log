content='```yaml\n---\n- name: Import assert.yml\n  include_tasks: assert.yml\n\n- name: Install cron\n  package:\n    name: "{{ cron_packages }}"\n    state: present\n\n- name: Configure shell\n  lineinfile:\n    path: /etc/cron.d/cron.conf\n    regexp: \'^SHELL=.*\'\n    line: \'SHELL={{ cron_shell_path }}\'\n    create: yes\n    mode: \'0644\'\n  notify: restart cron\n\n- name: Configure path\n  lineinfile:\n    path: /etc/cron.d/cron.conf\n    regexp: \'^PATH=.*\'\n    line: \'PATH={{ cron_path }}\'\n    create: yes\n    mode: \'0644\'\n  notify: restart cron\n\n- name: Configure mailto\n  lineinfile:\n    path: /etc/cron.d/cron.conf\n    regexp: \'^MAILTO=.*\'\n    line: \'MAILTO={{ cron_mailto }}\'\n    create: yes\n    mode: \'0644\'\n  notify: restart cron\n\n- name: Start and enable cron\n  service:\n    name: "{{ cron_service }}"\n    state: started\n    enabled: yes\n  when: cron_service is defined and cron_service | length > 0\n\n- name: Schedule requested cron jobs\n  cron:\n    name: "{{ item.name }}"\n    minute: "{{ item.minute | default(omit) }}"\n    hour: "{{ item.hour | default(omit) }}"\n    day: "{{ item.day | default(omit) }}"\n    month: "{{ item.month | default(omit) }}"\n    weekday: "{{ item.weekday | default(omit) }}"\n    user: "{{ item.user | default(omit) }}"\n    job: "{{ item.job }}"\n    state: "{{ item.state | default(\'present\') }}"\n  loop: "{{ cron_jobs }}"\n\nhandlers:\n  - name: restart cron\n    service:\n      name: cron\n      state: restarted\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-18T22:39:44.516534588Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7109850386, 'load_duration': 70114834, 'prompt_eval_count': 1056, 'prompt_eval_duration': 10368230, 'eval_count': 406, 'eval_duration': 7028032512, 'model_name': 'phi4:14b'} id='run--314704a3-66fa-4c0e-a8b9-33a87c11fcb4-0' usage_metadata={'input_tokens': 1056, 'output_tokens': 406, 'total_tokens': 1462}
