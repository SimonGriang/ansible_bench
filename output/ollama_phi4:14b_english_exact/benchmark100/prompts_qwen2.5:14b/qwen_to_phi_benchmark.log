  command: docker-compose --version
  register: docker_compose_version_output

- name: Set fact for current Docker Compose version
  set_fact:
    current_docker_compose_version: "{{ docker_compose_version_output.stdout | regex_search('docker-compose version ([\\d\\.]+)', '\\1') }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: "/usr/local/bin/docker-compose"
    state: absent
  when: 
    current_docker_compose_version is defined and 
    current_docker_compose_version != desired_docker_compose_version

- name: Install Docker Compose (if configured)
  get_url:
    url: >-
      https://github.com/docker/compose/releases/download/{{ desired_docker_compose_version }}/docker-compose-{{ ansible_system }}-{{ ansible_machine }}
    dest: "/usr/local/bin/docker-compose"
    mode: '0755'
  when: 
    current_docker_compose_version is undefined or 
    current_docker_compose_version != desired_docker_compose_version


