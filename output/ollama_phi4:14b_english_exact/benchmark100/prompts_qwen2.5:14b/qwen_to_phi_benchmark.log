content='```yaml\n---\n- name: Check if the system is EFI\n  stat:\n    path: /sys/firmware/efi/efivars\n  register: efi_status\n\n- name: Remove the grub.cfg file if the system is EFI\n  file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: efi_status.stat.exists\n\n- name: Install a user template for GRUB\n  template:\n    src: 01_users.j2\n    dest: /etc/grub.d/01_users\n    owner: root\n    group: root\n    mode: \'0700\'\n  notify: update-grub\n\n- name: Add a password to the EFI GRUB configuration\n  lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: \'set superusers="admin"\'\n    insertafter: EOF\n  notify: update-grub\n\n- name: Add a password to the MBR GRUB configuration\n  lineinfile:\n    path: /etc/grub2.cfg\n    line: \'set superusers="admin"\'\n    insertafter: EOF\n  notify: update-grub\n\n- name: Add --unrestricted option to specified files\n  lineinfile:\n    path: "{{ item }}"\n    regexp: \'CLASS="([^"]+)"\'\n    line: \'CLASS="\\1 --unrestricted"\'\n  loop: "{{ grub_password_unrestricted_files }}"\n  when: grub_password_unrestricted is defined and grub_password_unrestricted | bool\n  notify: update-grub\n\nhandlers:\n  - name: update-grub\n    command: grub2-mkconfig -o /boot/grub2/grub.cfg\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-18T20:47:51.885552801Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5852334171, 'load_duration': 57486995, 'prompt_eval_count': 1018, 'prompt_eval_duration': 31192632, 'eval_count': 354, 'eval_duration': 5762489503, 'model_name': 'phi4:14b'} id='run--fbb6f347-84cb-45e7-8960-85f5bf9c1716-0' usage_metadata={'input_tokens': 1018, 'output_tokens': 354, 'total_tokens': 1372}
