---
- name: Enable proxy and proxy_http modules on Debian and Suse systems
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - libapache2-mod-proxy-html
    - libapache2-mod-proxy
    - libapache2-mod-proxy-ajp
    - libapache2-mod-proxy-wstunnel
  when: ansible_os_family in ['Debian']

- name: Enable proxy and proxy_http modules on Suse systems
  zypper:
    name: "{{ item }}"
    state: present
  loop:
    - apache2-mod_proxy_html
    - apache2-mod_proxy
    - apache2-mod_proxy_ajp
    - apache2-mod_proxy_wstunnel
  when: ansible_os_family == 'Suse'

- name: Configure locations using a template
  template:
    src: location.conf.j2
    dest: /etc/apache2/conf-available/locations.conf
  notify:
    - Test Apache configuration
    - Restart Apache

handlers:
  - name: Test Apache configuration
    command: apache2ctl configtest

  - name: Restart Apache
    service:
      name: apache2
      state: restarted


