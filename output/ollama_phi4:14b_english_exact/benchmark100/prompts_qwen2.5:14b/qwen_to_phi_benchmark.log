---
- name: Create local ssh_key_directory for {{ user.name }}
  ansible.builtin.file:
    path: "/home/{{ user.name }}/.ssh"
    state: directory
    mode: '0750'
  when: user.manage_ssh_key | bool
  delegate_to: localhost
  become: false

- name: Manage user {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    password: "{{ user.password | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    append: "{{ user.append | default(True) }}"
    create_home: "{{ user.create_home | default(True) }}"

- name: Set sudo options for {{ user.name }}
  ansible.builtin.lineinfile:
    path: "/etc/sudoers.d/{{ user.name }}"
    line: "{{ user.sudo_options }}"
    create: true
    mode: '0640'
  when: user.sudo_options is defined
  validate: '/usr/sbin/visudo --check %s'

- name: Remove sudo options for {{ user.name }}
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  ansible.builtin.openssh_keypair:
    path: "/home/{{ user.name }}/.ssh/id_rsa"
    type: rsa
    size: 2048
  when: user.manage_ssh_key | bool
  delegate_to: localhost
  become: false

- name: Generate public ssh key for {{ user.name }}
  ansible.builtin.openssh_keypair:
    path: "/home/{{ user.name }}/.ssh/id_rsa.pub"
    type: rsa
    size: 2048
  when: user.manage_ssh_key | bool
  delegate_to: localhost
  become: false

- name: Convert ssh key to ppk for {{ user.name }}
  ansible.builtin.command:
    cmd: ssh-keygen -p -f /home/{{ user.name }}/.ssh/id_rsa -m PKCS8 -P '' -N ''
  when: user.manage_ssh_key | bool
  delegate_to: localhost
  become: false

- name: Get or set the home directory for {{ user.name }}
  ansible.builtin.set_fact:
    user_home: "{{ ansible_env.HOME | default('/home/' ~ user.name) }}"
  when: user.state != 'absent'

- name: Create .ssh directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
  when: user.manage_ssh_key | bool or user.private_keys is defined
  become: true

- name: Deploy authorized keys for {{ user.name }}
  ansible.builtin.copy:
    dest: "{{ user_home }}/.ssh/authorized_keys"
    content: "{{ user.authorized_keys | join('\n') }}"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
    mode: '0644'
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for {{ user.name }}
  ansible.builtin.lineinfile:
    path: "{{ user_home }}/.ssh/authorized_keys"
    line: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for {{ user.name }}
  ansible.builtin.copy:
    src: "/home/{{ user.name }}/.ssh/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
    mode: '0600'
  when: user.copy_private_key | bool

- name: Check users password valid time for {{ user.name }}
  ansible.builtin.shell: chage -l {{ user.name }}
  register: password_validity

- name: Set users password valid time for {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    password_expire_min: "{{ user.password_validity_days * 24 * 60 }}"
  when: user.password_validity_days is defined and
        (password_validity.stdout is not defined or
         (password_validity.stdout | regex_search('Password expires.*([0-9]+) days?'))[1] | int != user.password_validity_days)

- name: Place private key file for {{ user.name }}
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ user_home }}/.ssh/{{ item.dest }}"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
    mode: "{{ item.mode }}"
  loop: "{{ user.private_keys }}"
  when: user.private_keys is defined


