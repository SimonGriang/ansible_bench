    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ dns_directories }}"

- name: Create system group for DNS service
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create system user for DNS service
  user:
    name: "{{ dns_user }}"
    system: yes
    group: "{{ dns_group }}"

- name: Generate rndc key for DNS server
  command: rndc-confgen -a -c /etc/rndc.key
  args:
    creates: /etc/rndc.key

- name: Set permissions on rndc key file
  file:
    path: /etc/rndc.key
    owner: root
    group: "{{ dns_group }}"
    mode: '0400'

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_data_dir }}/root.hints"

- name: Create zone file for DNS zones
  template:
    src: zone.j2
    dest: "{{ dns_data_dir }}/{{ item.name }}.zone"
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named.conf
  notify: restart dns

- name: Place systemd override
  block:
    - name: Ensure systemd override directory exists
      file:
        path: /etc/systemd/system/named.service.d
        state: directory

    - name: Place override configuration file
      copy:
        src: named.service.d/override.conf
        dest: /etc/systemd/system/named.service.d/override.conf

- name: Start and enable DNS service
  service:
    name: named
    state: started
    enabled: true


