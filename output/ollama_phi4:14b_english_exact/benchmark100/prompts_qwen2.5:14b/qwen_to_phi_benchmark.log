---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell in cron configuration
  lineinfile:
    path: /etc/crontab
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Configure path in cron configuration
  lineinfile:
    path: /etc/crontab
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Configure mailto in cron configuration
  lineinfile:
    path: /etc/crontab
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    mode: '0600'
  notify: Restart cron

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined and cron_service | length > 0

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    special_time: "{{ item.special_time | default(omit) }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    job: "{{ item.command }}"
  loop: "{{ cron_jobs }}"


