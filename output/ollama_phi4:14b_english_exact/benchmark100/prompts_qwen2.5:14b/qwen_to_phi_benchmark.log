- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: "/usr/local/lib/python3.11/site-packages/EXTERNALLY-MANAGED"
  register: python311_managed_file

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  command: mv /usr/local/lib/python3.11/site-packages/EXTERNALLY-MANAGED /usr/local/lib/python3.11/site-packages/EXTERNALLY-MANAGED.old
  when: python311_managed_file.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: "/usr/local/lib/python3.12/site-packages/EXTERNALLY-MANAGED"
  register: python312_managed_file

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  command: mv /usr/local/lib/python3.12/site-packages/EXTERNALLY-MANAGED /usr/local/lib/python3.12/site-packages/EXTERNALLY-MANAGED.old
  when: python312_managed_file.stat.exists

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install python pip
  pip:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    line: "proxy = {{ python_pip_proxy }}"
    create: yes
  when: python_pip_proxy is defined

