---
- name: Ensure the summary block runs only on the first RKE2 server
  block:
    - name: Prepare summary of Kubernetes nodes
      shell: kubectl get nodes --show-labels -o wide
      register: nodes_summary
      when: inventory_hostname == groups['rke2_servers'][0]

    - name: Display the stdout_lines of the nodes summary
      debug:
        var: nodes_summary.stdout_lines
      when: inventory_hostname == groups['rke2_servers'][0]


