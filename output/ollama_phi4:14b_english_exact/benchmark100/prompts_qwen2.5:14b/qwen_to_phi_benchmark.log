- Last generated (faulty) playbook: 
---
- name: Update java_jdk_vendor if it is adoptopenjdk
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Include OS-specific variables based on distribution
  include_vars: "{{ ansible_distribution }}_vars.yml"

- name: Include architecture-specific variables
  include_vars: "{{ ansible_architecture }}_vars.yml"

- name: Set OS-specific variables (part I)
  set_fact:
    os_specific_var1: "{{ os_specific_var1 | default('value1') }}"
    os_specific_var2: "{{ os_specific_var2 | default('value2') }}"
  when: 
    - os_specific_var1 is not defined
    - os_specific_var1 is none
    - os_specific_var2 is not defined
    - os_specific_var2 is none

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    os_arch_specific_var1: "{{ os_arch_specific_var1 | default('value1') }}"
    os_arch_specific_var2: "{{ os_arch_specific_var2 | default('value2') }}"
  when: 
    - os_arch_specific_var1 is not defined
    - os_arch_specific_var1 is none
    - os_arch_specific_var2 is not defined
    - os_arch_specific_var2 is none

- name: Set specific variables
  set_fact:
    java_home: "/usr/lib/jvm/java-{{ java_version }}-openjdk"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "deb http://archive.ubuntu.com/ubuntu {{ ansible_distribution_release }} main restricted"
        state: absent
    - name: Install extra apt tools
      apt:
        name: dirmngr
        state: present
    - name: Add key repositories
      apt_key:
        url: https://adoptopenjdk.jfrog.io/adoptopenjdk/api/gpg/key/public
        state: present
    - name: Add repositories
      apt_repository:
        repo: "deb https://adoptopenjdk.jfrog.io/adoptopenjdk/deb/ temurin-{{ java_version }} main"
        state: present
  when: ansible_os_family == "Debian"

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        state: present
        key: https://adoptopenjdk.jfrog.io/adoptopenjdk/api/gpg/key/public
    - name: Add repositories
      yum_repository:
        name: temurin
        baseurl: https://adoptopenjdk.jfrog.io/adoptopenjdk/rpm/{{ ansible_architecture }}/
        description: AdoptOpenJDK
        enabled: yes
  when: ansible_os_family == "RedHat"

- name: Install required libraries
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ required_libraries }}"

- name: Install Java, Debian
  apt:
    name: "openjdk-{{ java_version }}-jdk"
    state: present
    update_cache: yes
  register: java_install_debian
  when: ansible_os_family == "Debian"

- name: Install Java, RedHat
  yum:
    name: "java-{{ java_version }}-openjdk"
    state: present
    update_cache: yes
  register: java_install_redhat
  when: ansible_os_family == "RedHat"

- name: Export environment variables
  template:
    src: java_env.j2
    dest: /etc/profile.d/java.sh
  notify: source_env

- name: Source environment variables
  shell: "source /etc/profile.d/java.sh"

- name: Correct java version selected for Java versions less than 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
  when: ansible_os_family == "Debian" and java_version | int < 11

- name: Correct java version selected for Java versions greater than or equal to 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
  when: ansible_os_family == "Debian" and java_version | int >= 11


