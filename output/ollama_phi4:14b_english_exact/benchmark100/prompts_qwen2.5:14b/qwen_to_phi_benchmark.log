---
- name: Import assert.yml
  include_tasks: assert.yml
  hosts: localhost
  gather_facts: no

- name: Configure apk
  block:
    - name: Update apk cache
      apk:
        update_cache: yes
    - name: Upgrade all software using apk
      apk:
        upgrade: yes
  notify: reboot_handler
  when: ansible_pkg_mgr == "apk"

- name: Configure apt
  block:
    - name: Prevent upgrade for selected packages
      apt:
        name: "{{ package_name }}"
        state: present
        upgrade: false
    - name: Update all software using apt
      apt:
        upgrade: dist
    - name: Autoremove unused packages
      apt:
        autoremove: yes
  notify: reboot_handler
  when: ansible_pkg_mgr == "apt"

- name: Update all software (dnf)
  block:
    - name: Exclude certain packages from dnf update
      dnf:
        name: "*"
        state: latest
        exclude: "{{ exclude_packages }}"
  notify: reboot_handler
  when: ansible_pkg_mgr == "dnf"

- name: Update all software (pacman)
  block:
    - name: Update all software using pacman
      pacman:
        update_cache: yes
        upgrade: yes
  notify: reboot_handler
  when: ansible_pkg_mgr == "pacman"

- name: Configure yum
  block:
    - name: Install yum-utils if not present
      yum:
        name: yum-utils
        state: present
    - name: Update all software using yum
      yum:
        name: "*"
        state: latest
  notify: reboot_handler
  when: ansible_pkg_mgr == "yum"

- name: Update all software (zypper)
  block:
    - name: Update all software using zypper
      zypper:
        name: "*"
        state: latest
  notify: reboot_handler
  when: ansible_pkg_mgr == "zypper"


