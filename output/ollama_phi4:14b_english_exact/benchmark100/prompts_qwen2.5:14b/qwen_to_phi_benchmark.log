---
- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  ansible.builtin.command:
    cmd: kubectl get nodes --no-headers | grep -q 'Ready'
  register: nodes_ready
  until: nodes_ready.rc == 0
  retries: 100
  delay: 15
  delegate_to: >-
    {{ active_server | default(
      ansible_play_hosts
      | selectattr('group_names', 'intersect', [rke2_servers_group_name])
      | map(attribute='name')
      | list
      | first
    ) }}
  check_mode: no
  run_once: true

- name: Wait for all pods to be ready again
  ansible.builtin.command:
    cmd: >
      kubectl get pods --all-namespaces
      --field-selector=status.phase!=Failed
      --no-headers | grep -qE '(Running|Succeeded)'
  register: pods_ready
  until: pods_ready.rc == 0
  retries: 100
  delay: 15
  delegate_to: >-
    {{ active_server | default(
      ansible_play_hosts
      | selectattr('group_names', 'intersect', [rke2_servers_group_name])
      | map(attribute='name')
      | list
      | first
    ) }}
  when: rke2_wait_for_all_pods_to_be_ready is defined
  check_mode: no
  run_once: true


