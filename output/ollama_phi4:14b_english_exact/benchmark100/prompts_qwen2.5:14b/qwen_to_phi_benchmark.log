---
- name: Cordon and Drain the node {{ rke2_node_name }}
  command: >
    kubectl cordon {{ rke2_node_name }} &&
    kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-local-data --force --grace-period=30 --timeout=-1 {{ rke2_drain_additional_args }}
  args:
    chdir: "{{ rke2_data_path }}"
  register: drain_result
  until: drain_result.rc == 0
  retries: 100
  delay: 15

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2-server
    state: restarted
  delegate_to: "{{ rke2_node_name }}"
  notify: 
    - Service (re)started

- name: Wait for all nodes to be ready again
  command: kubectl get nodes --no-headers --field-selector=status.phase!=Ready
  register: nodes_not_ready
  until: nodes_not_ready.rc != 0
  retries: 100
  delay: 15

- name: Uncordon the node {{ rke2_node_name }}
  command: kubectl uncordon {{ rke2_node_name }}
  args:
    chdir: "{{ rke2_data_path }}"
  when: rke2_drain_node_during_upgrade | bool

- name: Wait for all pods to be ready again
  command: kubectl wait --for=condition=Ready pod --all --timeout=-1s
  register: pods_ready
  until: pods_ready.rc == 0
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready | bool

- name: Wait for all pods to pass readiness checks
  command: kubectl wait --for=condition=Ready pod --all --timeout=-1s
  register: pods_healthy
  until: pods_healthy.rc == 0
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy | bool

handlers:
  - name: Service (re)started
    service:
      name: rke2-server
      state: restarted


