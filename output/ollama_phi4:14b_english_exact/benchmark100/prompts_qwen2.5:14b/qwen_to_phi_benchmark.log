---
- name: Import assert.yml
  include_tasks: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  selinux:
    policy: targeted
    state: enforcing
    config: "{{ selinux_config }}"
  when: ansible_selinux.status == "enabled"

- name: Configure httpd
  template:
    src: "{{ httpd_main_config_template }}"
    dest: "{{ httpd_main_config_path }}"
  notify: 
    - Test httpd configuration
    - Restart httpd

- name: Activate httpd module | Debian
  command: a2enmod {{ item }}
  with_items: "{{ httpd_modules }}"
  notify: 
    - Test httpd configuration
    - Restart httpd
  when: ansible_os_family == "Debian"

- name: Import ssl.yml
  include_tasks: ssl.yml
  when: https_ssl_enabled == true

- name: Import locations.yml
  include_tasks: locations.yml
  when: httpd_locations is defined and httpd_locations | length > 0

- name: Import vhosts.yml
  include_tasks: vhosts.yml
  when: httpd_vhosts is defined and httpd_vhosts | length > 0

- name: Configure ports
  template:
    src: "{{ httpd_ports_config_template }}"
    dest: "{{ httpd_ports_config_path }}"
  notify: 
    - Test httpd configuration
    - Restart httpd
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  include_tasks: directories.yml
  when: httpd_directories is defined and httpd_directories | length > 0

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_default_site_path }}"
    state: absent
  when: httpd_remove_example == true

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


