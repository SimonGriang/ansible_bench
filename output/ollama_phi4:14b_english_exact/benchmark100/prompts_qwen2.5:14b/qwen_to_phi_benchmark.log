content='```yaml\n---\n- name: Install epel\n  yum_repository:\n    name: epel\n    description: EPEL YUM repo\n    baseurl: https://dl.fedoraproject.org/pub/epel/$releasever/$basearch/\n    gpgcheck: yes\n    enabled: yes\n  when: ansible_os_family == "RedHat"\n  tags: epel\n\n- name: Install epel gpg key\n  rpm_key:\n    state: present\n    key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-7\n  when: ansible_os_family == "RedHat"\n  tags: epel_key\n\n- name: Install epel-release\n  package:\n    name: epel-release\n    state: present\n  when: ansible_os_family == "RedHat"\n  tags: epel_release\n\n- name: Install epel-next-release\n  package:\n    name: epel-next-release\n    state: present\n  when: ansible_os_family == "RedHat" and epel_next | default(false) | bool\n  notify: Update package cache\n  tags: epel_next_release\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-18T22:42:55.570548344Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3446075473, 'load_duration': 72224677, 'prompt_eval_count': 384, 'prompt_eval_duration': 37935800, 'eval_count': 252, 'eval_duration': 3334867925, 'model_name': 'phi4:14b'} id='run--770896aa-b59a-451d-9548-49b037c44588-0' usage_metadata={'input_tokens': 384, 'output_tokens': 252, 'total_tokens': 636}
