---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install required software
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements | default([]) }}"
  when: users_requirements is defined and users_requirements | length > 0

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups | default([]) }}"
  when: users_groups is defined

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: 'includedir /etc/sudoers.d'
    state: present
    validate: 'visudo -cf %s'
  when: users_sudo_includedir is defined and users_sudo_includedir

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users | default([]) }}"
  when: users is defined

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow is defined and users_cron_allow

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is defined and not users_cron_allow


