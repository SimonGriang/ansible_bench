---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ user_name }}"
  register: user_exists

- name: Create directory for git configuration
  ansible.builtin.file:
    path: "{{ git_config_dir }}"
    state: directory
    owner: "{{ user_name }}"
    group: "{{ user_name }}"
    mode: '0755'
  when: user_exists | success and git_config_dir is defined

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "{{ git_config_dir }}/gitconfig"
    owner: "{{ user_name }}"
    group: "{{ user_name }}"
    mode: '0644'
  when: user_exists | success and git_config_dir is defined and gitconfig is defined

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ user_name }}"
    group: "{{ user_name }}"
    mode: '0755'
  when: user_exists | success and repository_destination is defined

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}/{{ item.name }}"
    version: "{{ item.version | default('master') }}"
    update: yes
    force: yes
  loop: "{{ git_repositories }}"
  become: yes
  become_user: "{{ git_user | default(user_name) }}"
  when: user_exists | success and git_repositories is defined


