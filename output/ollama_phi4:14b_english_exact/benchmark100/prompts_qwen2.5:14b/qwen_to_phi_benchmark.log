---
- name: Create ssl key
  openssl_privatekey:
    path: "{{ ssl_dir }}/{{ inventory_hostname }}.key"
    size: 2048
    mode: '0600'
    owner: root
    group: root
  delegate_to: localhost

- name: Create ssl csr
  openssl_csr:
    path: "{{ ssl_dir }}/{{ inventory_hostname }}.csr"
    privatekey_path: "{{ ssl_dir }}/{{ inventory_hostname }}.key"
    common_name: "{{ inventory_hostname }}"
    country_name: US
    state_or_province_name: California
    locality_name: San Francisco
    organizational_unit_name: DevOps
    organization_name: Company
    mode: '0600'
    owner: root
    group: root
  delegate_to: localhost

- name: Create ssl certificates
  openssl_certificate:
    path: "{{ ssl_dir }}/{{ inventory_hostname }}.crt"
    privatekey_path: "{{ ssl_dir }}/{{ inventory_hostname }}.key"
    csr_path: "{{ ssl_dir }}/{{ inventory_hostname }}.csr"
    provider: selfsigned
    subject_alt_name: "DNS:{{ inventory_hostname }}"
    mode: '0644'
    owner: root
    group: root
  delegate_to: localhost

- name: Create PKCS#12 file
  openssl_pkcs12:
    dest: "{{ ssl_dir }}/{{ inventory_hostname }}.p12"
    privatekey_path: "{{ ssl_dir }}/{{ inventory_hostname }}.key"
    certificate_path: "{{ ssl_dir }}/{{ inventory_hostname }}.crt"
    passphrase: "{{ pkcs12_passphrase }}"
    export_certs: true
    mode: '0600'
    owner: root
    group: root
  delegate_to: localhost

- name: Read private key
  slurp:
    path: "{{ ssl_dir }}/{{ inventory_hostname }}.key"
  register: private_key_slurp
  delegate_to: localhost

- name: Register private key content
  set_fact:
    private_key_content: "{{ private_key_slurp['content'] | b64decode }}"
  delegate_to: localhost

- name: Read certificate
  slurp:
    path: "{{ ssl_dir }}/{{ inventory_hostname }}.crt"
  register: certificate_slurp
  delegate_to: localhost

- name: Register certificate content
  set_fact:
    certificate_content: "{{ certificate_slurp['content'] | b64decode }}"
  delegate_to: localhost

- name: Create combined private_key and certificate file
  copy:
    content: |
      {{ private_key_content | b64encode }}
      {{ certificate_content | b64encode }}
    dest: "{{ ssl_dir }}/{{ inventory_hostname }}.combined"
    mode: '0644'
    owner: root
    group: root
  delegate_to: localhost


