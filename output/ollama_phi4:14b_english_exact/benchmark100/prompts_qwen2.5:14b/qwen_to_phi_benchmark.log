---
- name: hardening | Disable swap now
  command: swapoff -a
  when: ansible_swaptotal_mb > 0

- name: hardening | Disable swap permanently
  mount:
    name: "{{ item }}"
    fstype: swap
    state: unmounted
  with_items: "{{ ansible_mounts | selectattr('fstype', 'equalto', 'swap') | map(attribute='mount') | list }}"
  when: vault_hardening_disable_swap is defined and
        vault_hardening_disable_swap | bool

- name: hardening | Disable core dumps
  sysctl:
    name: fs.suid_dumpable
    value: '0'
    state: present
    reload: yes
  when: vault_hardening_disable_core_dumps is defined and
        vault_hardening_disable_core_dumps | bool

- name: hardening | Disable Shell Command History
  copy:
    dest: /etc/profile.d/disable_shell_history.sh
    content: |
      unset HISTFILE
      export HISTSIZE=0
      export HISTFILESIZE=0
    mode: '0644'
  when: vault_hardening_disable_shell_command_history is defined and
        vault_hardening_disable_shell_command_history | bool

- name: hardening | Enable SELinux
  selinux:
    policy: targeted
    state: enforcing
    config_file: /etc/selinux/config
  when: ansible_selinux.status == "enabled" and
        vault_hardening_configure_selinux_apparmor is defined and
        vault_hardening_configure_selinux_apparmor | bool

- name: hardening | Install selinux-policy
  package:
    name: selinux-policy
    state: present
  when: vault_hardening_configure_selinux_apparmor is defined and
        vault_hardening_configure_selinux_apparmor | bool

- name: hardening | Set SELinux policy
  selinux:
    policy: targeted
    state: enforcing
  when: vault_hardening_configure_selinux_apparmor is defined and
        vault_hardening_configure_selinux_apparmor | bool

- name: hardening | Enable AppArmor (enforcing)
  lineinfile:
    path: /etc/apparmor.d/usr.bin.vault
    line: 'profile flags=(attach_disconnected,mediate_deleted) enforce'
    create: yes
  when: vault_hardening_configure_selinux_apparmor is defined and
        vault_hardening_configure_selinux_apparmor | bool


