---
- name: check if all variables have been set correctly
  assert:
    that:
      - "required_variable_1 is defined"
      - "required_variable_2 is defined"
    fail_msg: "Required variables are not set correctly."

- name: wait for host (when configured)
  wait_for:
    host: "{{ bootstrap_host }}"
    port: "{{ bootstrap_port }}"
    state: started
    timeout: 300
  when: bootstrap_wait_for_host | default(false)

- name: prepare system
  block:
    - name: establish connection and gather facts
      setup:
      register: setup_result
      ignore_errors: yes

    - name: display debug message if connection failed
      debug:
        msg: "Connection to host could not be established."
      when: setup_result is failed

    - name: include tasks to gather bootstrap facts (raw)
      include_tasks: gather_bootstrap_facts_raw.yml

- name: Install bootstrap packages (raw).
  raw: "{{ bootstrap_install.raw }}"
  when: ansible_os_family == 'Debian' and bootstrap_install.raw is defined

- name: ensure system is prepared by issuing ansible modules
  block:
    - name: gather ansible facts
      setup:

    - name: install bootstrap packages using ansible package module
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ bootstrap_packages }}"


