---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  k8s_taint:
    node: "{{ inventory_hostname }}"
    key: "{{ rke2_type }}.server"
    value: "true"
    effect: NoSchedule
  when: rke2_type == 'server'

- name: Set agent taints
  k8s_taint:
    node: "{{ inventory_hostname }}"
    key: "{{ rke2_type }}.agent"
    value: "true"
    effect: NoSchedule
  when: rke2_type == 'agent'

- name: Copy RKE2 config file
  copy:
    src: rke2/config.yaml
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify:
    - Restart rke2

- name: Copy kubelet config file
  copy:
    src: kubelet/config.yaml
    dest: /etc/rancher/rke2/kubelet/config.yaml
    owner: root
    group: root
    mode: '0644'
  when: kubelet_config is defined and kubelet_config != ''
  notify:
    - Restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: containerd/registries.yaml
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0644'
  when: containerd_registries is defined and containerd_registries != ''
  notify:
    - Restart rke2

- name: Start RKE2 service
  service:
    name: rke2-server
    state: started
    enabled: true
  retries: 5
  delay: 10
  until: result is success
  notify:
    - Restart rke2

- name: Mask other RKE2 services
  systemd:
    name: "{{ item }}"
    enabled: no
    masked: yes
  loop:
    - rke2-agent
  when: rke2_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  shell: kubectl get nodes --no-headers | grep -q "{{ inventory_hostname }}"
  register: node_ready
  until: node_ready.rc == 0
  retries: 30
  delay: 10

- name: Wait for remaining nodes to be ready - with CNI
  shell: kubectl get nodes --no-headers | grep -q "{{ inventory_hostname }}\s*Ready"
  register: node_ready
  until: node_ready.rc == 0
  retries: 30
  delay: 10


