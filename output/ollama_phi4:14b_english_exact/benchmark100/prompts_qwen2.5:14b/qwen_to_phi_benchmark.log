---
- name: Import assert.yml
  import_tasks: assert.yml
  when: inventory_hostname == 'localhost'
  run_once: true

- name: Install logrotate
  package:
    name: "{{ logrotate_packages }}"

- name: Configure logrotate
  template:
    src: "{{ logrotate_config_file }}"
    dest: "{{ logrotate_config_directory }}"

- name: Generate logrotate.d files
  template:
    src: logrotate.conf.j2
    dest: "{{ item.path }}"
  loop: "{{ logrotate_entries | selectattr('state', 'undefined') | selectattr('state', '!=', 'absent') }}"
  loop_control:
    label: "{{ item.name }}"

- name: Remove logrotate.d files
  file:
    path: "{{ item.path }}"
    state: absent
  loop: "{{ logrotate_entries | selectattr('state', 'equalto', 'absent') }}"
  loop_control:
    label: "{{ item.name }}"

- name: Start logrotate
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service is defined


