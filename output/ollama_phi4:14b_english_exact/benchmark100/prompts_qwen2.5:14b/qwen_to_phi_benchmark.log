---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  template:
    src: my.cnf.j2
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'
  vars:
    mysql_configuration_options: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  template:
    src: client.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: '0644'
  vars:
    mysql_socket: "{{ mysql_socket }}"

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    src: my.cnf
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: not item.initial_import

- name: List databases
  shell: mysql -e "SHOW DATABASES;"
  register: list_databases
  changed_when: false

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.file }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('') }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers
  meta: flush_handlers

- name: Flush handlers again
  meta: flush_handlers


