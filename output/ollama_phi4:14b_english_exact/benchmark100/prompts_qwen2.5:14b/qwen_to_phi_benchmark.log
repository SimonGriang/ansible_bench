    gid: "{{ promtail_group_gid | default(omit) }}"

- name: Create the promtail user
  user:
    name: promtail
    system: true
    group: promtail
    shell: /sbin/nologin
    create_home: no
    state: present

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  file:
    path: "{{ item }}"
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'
  loop:
    - /etc/promtail
    - /etc/promtail/conf.d

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'
  loop:
    - /var/log/promtail
    - /opt/promtail

- name: Check if the promtail binary exists
  stat:
    path: /opt/promtail/promtail
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_download_url }}"
    dest: /tmp/promtail.tar.gz
    mode: '0644'
  when: not promtail_binary.stat.exists and promtail_distribute_method | lower == 'remote'

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_local_archive }}"
    dest: /tmp/promtail.tar.gz
  when: not promtail_binary.stat.exists and promtail_distribute_method | lower == 'local'

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_download_url }}"
    dest: /tmp/promtail.tar.gz
    mode: '0644'
  when: not promtail_binary.stat.exists 
        and promtail_distribute_method | lower == 'remote' 
        and inventory_hostname == controller_node

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail.tar.gz
    dest: /tmp/promtail.tar.gz
  when: not promtail_binary.stat.exists 
        and promtail_distribute_method | lower == 'remote' 
        and inventory_hostname != controller_node

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail.tar.gz
    dest: /opt/promtail
    remote_src: true
    mode: '0755'
  when: not promtail_binary.stat.exists
  ignore_errors: true

- name: Create symlink to latest version
  file:
    src: /opt/promtail/promtail
    dest: /usr/local/bin/promtail
    state: link
  notify: restart promtail

- name: Write configuration
  template:
    src: promtail.yaml.j2
    dest: /etc/promtail/promtail.yaml
    owner: promtail
    group: promtail
    mode: '0644'
  notify: restart promtail

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: restart promtail


