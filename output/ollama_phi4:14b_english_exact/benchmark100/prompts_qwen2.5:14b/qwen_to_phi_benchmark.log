---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk
    state: present
  when: java_vendor == "true"

- name: Install RPM
  package:
    name: "{{ oracle_java_rpm_file }}"
    state: present
    src: "{{ oracle_java_rpm_file }}"

- name: Install DEB
  package:
    name: "{{ oracle_java_deb_file }}"
    state: present
    src: "{{ oracle_java_deb_file }}"

- name: Install oracle java (rpm) (repository)
  package:
    name: oracle-java-{{ java_version }}-rpm
    state: present

- name: Configure oracle targz
  block:
    - file:
        path: "{{ oracle_java_install_dir }}"
        state: directory

    - get_url:
        url: "{{ oracle_java_targz_url }}"
        dest: "/tmp/{{ oracle_java_targz_file }}"

    - unarchive:
        src: "/tmp/{{ oracle_java_targz_file }}"
        dest: "{{ oracle_java_install_dir }}"
        remote_src: yes

- name: Install oracle java policy software (targz)
  block:
    - get_url:
        url: "{{ oracle_java_policy_url }}"
        dest: "/tmp/{{ oracle_java_policy_file }}"

    - unarchive:
        src: "/tmp/{{ oracle_java_policy_file }}"
        dest: "/usr/local/java/jre/lib/security"

- name: Set alternative (targz)
  alternatives:
    name: java
    path: "{{ oracle_java_install_dir }}/bin/java"
  when: ansible_os_family != "Alpine"

- name: Find JAVA_HOME
  command: readlink -f "$(which java)" | sed "s:/bin/java::"
  register: java_home

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    line: "JAVA_HOME={{ java_home.stdout }}"
    create: yes


