---
- name: Update apt cache
  ansible.builtin.apt:
    update_cache: true
  when: ansible_facts['os_family'] == "Debian"

- name: Update dnf cache
  ansible.builtin.dnf:
    update_cache: true
  when: ansible_facts['os_family'] == "RedHat"

- name: Install packages
  ansible.builtin.package:
    name: keepalived
    state: present

- name: Create directory for keepalived
  ansible.builtin.file:
    path: /etc/keepalived
    state: directory
    mode: '0755'

- name: Create Kubernetes API health check script for Debian OS family
  ansible.builtin.template:
    src: k8s_api_health_check_debian.sh.j2
    dest: /usr/local/bin/k8s_api_health_check.sh
    mode: '0755'
  notify: restart keepalived
  when: ansible_facts['os_family'] == "Debian"

- name: Create Kubernetes API health check script for RedHat OS family
  ansible.builtin.template:
    src: k8s_api_health_check_redhat.sh.j2
    dest: /usr/local/bin/k8s_api_health_check.sh
    mode: '0755'
  notify: restart keepalived
  when: ansible_facts['os_family'] == "RedHat"

- name: Create RKE2 Server health check script for Debian OS family
  ansible.builtin.template:
    src: rke2_server_health_check_debian.sh.j2
    dest: /usr/local/bin/rke2_server_health_check.sh
    mode: '0755'
  notify: restart keepalived
  when: ansible_facts['os_family'] == "Debian"

- name: Create RKE2 Server health check script for RedHat OS family
  ansible.builtin.template:
    src: rke2_server_health_check_redhat.sh.j2
    dest: /usr/local/bin/rke2_server_health_check.sh
    mode: '0755'
  notify: restart keepalived
  when: ansible_facts['os_family'] == "RedHat"

- name: Create keepalived config file
  ansible.builtin.template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
  notify: restart keepalived

- name: Enable keepalived and make sure it is not masked
  ansible.builtin.service:
    name: keepalived
    enabled: true
    masked: false
  notify: restart keepalived

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true


