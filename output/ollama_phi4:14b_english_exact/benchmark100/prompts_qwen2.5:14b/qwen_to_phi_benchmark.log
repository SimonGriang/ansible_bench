---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  ansible.builtin.package:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  ansible.builtin.package:
    name: rsyslog
    state: present

- name: Install additional rsyslog packages
  ansible.builtin.package:
    name: "{{ rsyslog_features }}"
    state: present

- name: Configuring default rsyslog
  ansible.builtin.template:
    src: default_rsyslog.conf.j2
    dest: /etc/rsyslog.conf
  when: rsyslog_deploy_default_config
  notify:
    - restart rsyslog

- name: Make configuration directory
  ansible.builtin.file:
    path: /etc/rsyslog.d/
    state: directory
    mode: '0755'

- name: Configuring rsyslog forward rule
  ansible.builtin.template:
    src: forward_rule.conf.j2
    dest: /etc/rsyslog.d/forward_rule.conf
  when: not rsyslog_deploy_default_config
  notify:
    - restart rsyslog

- name: Configuring additional config files
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: /etc/rsyslog.d/{{ item.dest }}
    mode: "{{ item.mode | default('0644') }}"
    owner: "{{ item.owner | default('root') }}"
    group: "{{ item.group | default('root') }}"
  loop: "{{ rsyslog_additional_configs }}"

- name: Start and enable rsyslog
  ansible.builtin.service:
    name: rsyslog
    state: started
    enabled: true


