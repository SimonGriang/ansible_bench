content='```yaml\n---\n- name: Ensure old versions of Docker are not installed\n  package:\n    name: "{{ item }}"\n    state: absent\n  loop:\n    - docker\n    - docker-engine\n    - docker.io\n    - containerd\n    - runc\n\n- name: Add Docker GPG key\n  ansible.builtin.apt_key:\n    url: https://download.docker.com/linux/ubuntu/gpg\n    state: present\n\n- name: Add Docker repository\n  ansible.builtin.apt_repository:\n    repo: "deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} stable"\n    state: present\n    filename: docker\n\n- name: Configure Docker Nightly repo\n  ansible.builtin.apt_repository:\n    repo: "deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} nightly"\n    state: present\n    filename: docker-nightly\n  when: docker_nightly_repo_enabled | default(false)\n\n- name: Configure Docker Test repo\n  ansible.builtin.apt_repository:\n    repo: "deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} test"\n    state: present\n    filename: docker-test\n  when: docker_test_repo_enabled | default(false)\n\n- name: Configure containerd on RHEL 8\n  block:\n    - name: Ensure runc is not installed\n      package:\n        name: runc\n        state: absent\n\n    - name: Install container-selinux and containerd.io\n      package:\n        name: "{{ item }}"\n        state: present\n      loop:\n        - container-selinux\n        - containerd.io\n  when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-08T17:27:13.041870656Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6146426959, 'load_duration': 56228174, 'prompt_eval_count': 442, 'prompt_eval_duration': 45806232, 'eval_count': 382, 'eval_duration': 6043646021, 'model_name': 'phi4:14b'} id='run--95dd5963-0376-4e7e-aec4-3c34d0f97c3a-0' usage_metadata={'input_tokens': 442, 'output_tokens': 382, 'total_tokens': 824}
