_count': 441, 'eval_duration': 6591926720, 'model_name': 'phi4:14b'} id='run--37cc54ce-3864-492d-9459-5163411cb79e-0' usage_metadata={'input_tokens': 687, 'output_tokens': 441, 'total_tokens': 1128}
