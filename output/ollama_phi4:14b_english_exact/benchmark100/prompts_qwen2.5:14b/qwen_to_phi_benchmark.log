---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: mysql-server.cnf.j2
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    mode: '0644'
  vars:
    mysql_options: "{{ mysql_configuration_options }}"
  notify:
    - Restart mysql server

- name: Configure mysql client
  template:
    src: mysql-client.cnf.j2
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    mode: '0644'
  vars:
    mysql_socket: "{{ mysql_configuration_options['socket'] }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/mysql
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0600'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges | default(omit) }}"
    state: present
    login_user: root
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


