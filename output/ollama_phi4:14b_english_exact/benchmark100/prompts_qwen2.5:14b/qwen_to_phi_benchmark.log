---
- name: cadvisor | create directories
  file:
    path: /opt/cadvisor
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: cadvisor | download
  get_url:
    url: "https://github.com/google/cadvisor/releases/download/{{ cadvisor_version }}/cadvisor"
    dest: "/opt/cadvisor/cadvisor"
    sha256sum: "{{ cadvisor_checksum }}"
  when: local_cadvisor_dir is not defined

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: "{{ local_cadvisor_dir }}/cadvisor"
    dest: "/opt/cadvisor/cadvisor"
    remote_src: true
  notify:
    - restart cadvisor
  when: local_cadvisor_dir is defined

- name: cadvisor | symlink
  file:
    src: "/opt/cadvisor/cadvisor"
    dest: "/usr/local/bin/cadvisor"
    state: link

- name: cadvisor | server systemd service
  template:
    src: "cadvisor.service.j2"
    dest: "/etc/systemd/system/cadvisor.service"

- name: test_task
  command: systemctl is-active cadvisor
  register: service_active_check
  changed_when: false

- name: debug: var=service_active
  debug:
    var: service_active_check.stdout

- name: cadvisor | enable server systemd
  systemd:
    name: cadvisor
    enabled: true

- name: cadvisor | start server systemd
  systemd:
    name: cadvisor
    state: started


