        force: yes

    - name: Copy local RKE2 install script to remote
      copy:
        src: "/tmp/rke2_artifacts/install_script"
        dest: "{{ rke2_install_script_dest }}"
        mode: '0700'
        force: yes
  when: rke2_airgap_mode == "failed" and rke2_airgap_implementation == "copy"

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local_path }}"
    dest: "{{ rke2_artifacts_dest }}"
    mode: '0640'
    force: yes
  when: rke2_airgap_mode == "copy" and rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create folder for additional images tarballs
      file:
        path: "{{ rke2_additional_images_dir }}"
        state: directory

    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_tarball_images_path }}"
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"
  when: 
    - rke2_airgap_mode is defined 
    - len(rke2_airgap_copy_additional_tarballs) > 0 
    - rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure RKE2 artifacts exist
      file:
        path: "{{ rke2_artifacts_dest }}"
        state: directory

    - name: Ensure RKE2 install script exists
      file:
        path: "{{ rke2_install_script_dest }}"
        state: file

    - name: Set correct permissions for artifacts
      file:
        path: "{{ rke2_artifacts_dest }}"
        mode: '0700'

    - name: Set correct permissions for install script
      file:
        path: "{{ rke2_install_script_dest }}"
        mode: '0700'
  when: rke2_airgap_mode == "exists" and rke2_airgap_implementation == "exists"

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Check if separate partition
  command: grep '/usr/local' /proc/mounts
  register: separate_partition
  changed_when: false

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: >-
      {{ '/usr/local/bin' if separate_partition.stdout else '/usr/local/bin/rke2' }}

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 version"
  register: rke2_version_output

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: >-
      {{ rke2_version_output.stdout.split('\n')[0].split()[-1] }}
    rke2_running_version: >-
      {{ rke2_version_output.stdout.split('\n')[1].split()[-1] }}
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_installed_version == rke2_running_version or
        rke2_allow_downgrade | default(false) | bool
    fail_msg: "Downgrade of RKE2 is not allowed unless explicitly permitted."

- name: Run RKE2 install script
  command: >-
    {{ rke2_install_script_dest }} --airgap-url={{ rke2_airgap_url }}
  when: >-
    rke2_version_output.stdout.split('\n')[0].split()[-1] !=
    rke2_installed_version and not ansible_check_mode

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}"
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests is defined and rke2_custom_manifests | length > 0

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}"
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods is defined and rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_environment_file_path }}"
    dest: "/etc/rancher/rke2/config/environment"
  when: rke2_environment_options is defined and rke2_environment_options | length > 0
