---
- name: Create ssl key
  ansible.builtin.file:
    path: "{{ item.key_path }}"
    state: touch
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"

- name: create ssl key
  ansible.builtin.openssl_privatekey:
    path: "{{ item.key_path }}"
    size: 2048
    type: rsa

- name: Create ssl csr
  ansible.builtin.file:
    path: "{{ item.csr_path }}"
    state: touch
    mode: '0644'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"

- name: create ssl csr
  ansible.builtin.openssl_csr:
    path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    common_name: "{{ item.common_name }}"

- name: Create ssl certificates
  ansible.builtin.file:
    path: "{{ item.cert_path }}"
    state: touch
    mode: '0644'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"

- name: create ssl certificates
  ansible.builtin.openssl_certificate:
    path: "{{ item.cert_path }}"
    privatekey_path: "{{ item.key_path }}"
    csr_path: "{{ item.csr_path }}"
    provider:
      type: selfsigned

- name: Create PKCS#12 file
  ansible.builtin.file:
    path: "{{ item.p12_path }}"
    state: touch
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"

- name: create PKCS#12 file
  ansible.builtin.openssl_pkcs12:
    path: "{{ item.p12_path }}"
    privatekey_path: "{{ item.key_path }}"
    certificate_path: "{{ item.cert_path }}"
    friendly_name: "{{ item.friendly_name }}"

- name: Read private key
  ansible.builtin.slurp:
    src: "{{ item.key_path }}"
  register: private_key_content

- name: Read certificate
  ansible.builtin.slurp:
    src: "{{ item.cert_path }}"
  register: certificate_content

- name: Create combined private_key and certificate file
  ansible.builtin.copy:
    dest: "{{ item.combined_path }}"
    content: |
      {{ private_key_content['content'] | b64decode }}
      {{ certificate_content['content'] | b64decode }}
    mode: '0640'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"


