---
- name: Enable proxy modules in Apache
  block:
    - name: Enable proxy modules for Debian
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
      loop:
        - apache2
        - libapache2-mod-proxy-html
      when: ansible_os_family == 'Debian'
      notify:
        - Test Apache configuration
        - Restart Apache

    - name: Enable proxy modules for SUSE
      ansible.builtin.zypper:
        name: "{{ item }}"
        state: present
      loop:
        - apache2
        - apache2-mod_proxy_html
      when: ansible_os_family == 'Suse'
      notify:
        - Test Apache configuration
        - Restart Apache

- name: Configure Apache locations using a template
  block:
    - name: Deploy Apache configuration template
      ansible.builtin.template:
        src: apache_locations.conf.j2
        dest: /etc/apache2/sites-available/000-default.conf
        owner: root
        group: root
        mode: '0644'
      notify:
        - Test Apache configuration
        - Restart Apache
  handlers:
    - name: Test Apache configuration
      ansible.builtin.command:
        cmd: apache2ctl configtest
      register: configtest_result
      failed_when: configtest_result.rc != 0
      changed_when: false

    - name: Restart Apache
      ansible.builtin.service:
        name: apache2
        state: restarted


