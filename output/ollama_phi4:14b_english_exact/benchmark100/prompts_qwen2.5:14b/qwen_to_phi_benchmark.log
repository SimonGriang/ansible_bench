---
- name: Check if the system is EFI
  stat:
    path: /sys/firmware/efi/efivars
  register: efi_status

- name: Remove the grub.cfg file if the system is EFI
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_status.stat.exists

- name: Install a user template for GRUB
  template:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    owner: root
    group: root
    mode: '0700'
  notify: update-grub

- name: Add a password to the EFI GRUB configuration
  lineinfile:
    path: /etc/grub2-efi.cfg
    line: 'set superusers="admin"'
    insertafter: EOF
  notify: update-grub

- name: Add a password to the MBR GRUB configuration
  lineinfile:
    path: /etc/grub2.cfg
    line: 'set superusers="admin"'
    insertafter: EOF
  notify: update-grub

- name: Add --unrestricted option to specified files
  lineinfile:
    path: "{{ item }}"
    regexp: 'CLASS="([^"]+)"'
    line: 'CLASS="\1 --unrestricted"'
  loop: "{{ grub_password_unrestricted_files }}"
  when: grub_password_unrestricted is defined and grub_password_unrestricted | bool
  notify: update-grub

handlers:
  - name: update-grub
    command: grub2-mkconfig -o /boot/grub2/grub.cfg


