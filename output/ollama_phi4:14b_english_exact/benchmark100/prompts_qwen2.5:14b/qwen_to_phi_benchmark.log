---
- name: Verify if Python is installed on the system.
  stat:
    path: /usr/bin/python
  register: python_installed

- name: Verify if Python 3 is installed on the system.
  stat:
    path: /usr/bin/python3
  register: python3_installed

- name: Display the path of the Python executable if found.
  debug:
    msg: "Python executable path: {{ python_installed.stat.path }}"
  when: python_installed.stat.exists

- name: Display the path of the Python 3 executable if found.
  debug:
    msg: "Python 3 executable path: {{ python3_installed.stat.path }}"
  when: python3_installed.stat.exists

- name: Import the assert.yml file to run assertions.
  include_tasks: assert.yml

- name: Install the required packages defined in the openssl_requirements variable.
  package:
    name: "{{ openssl_requirements }}"
    state: present

- name: Install the python3-packaging package via dnf to ensure packaging tools are available.
  package:
    name: python3-packaging
    state: present
    use_dnf: yes

- name: Install Python packages listed in the openssl_pip_packages variable using pip.
  pip:
    name: "{{ openssl_pip_packages }}"
    state: present

- name: Create the directory for storing keys with the specified permissions and ownership.
  file:
    path: /path/to/keys
    state: directory
    mode: '0755'
    owner: user
    group: group

- name: Create the directory for storing certificate signing requests with the specified permissions and ownership.
  file:
    path: /path/to/csr
    state: directory
    mode: '0755'
    owner: user
    group: group

- name: Create the directory for storing certificates with the specified permissions and ownership.
  file:
    path: /path/to/crt
    state: directory
    mode: '0755'
    owner: user
    group: group

- name: Include the create.yml file to perform additional tasks, iterating over items defined in openssl_items.
  include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: openssl_item


