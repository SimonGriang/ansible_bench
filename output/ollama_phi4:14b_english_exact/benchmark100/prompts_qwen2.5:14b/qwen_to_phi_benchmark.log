---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: yes

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    connect_timeout: 10

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.ping:

    - name: Test sudo
      ansible.builtin.command:
        cmd: whoami
        become: yes
        become_user: root
      register: sudo_test
      failed_when: sudo_test.rc != 0

  run_once: yes
  become: yes
  become_user: root
  ignore_errors: yes

- name: Gather bootstrap facts
  block:
    - name: Gather additional bootstrap facts
      setup:

  when: prepare_system_failed | default(false)

- name: Install bootstrap packages (raw)
  block:
    - name: Install packages (Debian)
      ansible.builtin.raw:
        cmd: apt-get update && apt-get install -y "{{ bootstrap_packages }}"
      when: ansible_os_family == "Debian"

    - name: Install packages (RedHat)
      ansible.builtin.raw:
        cmd: yum install -y "{{ bootstrap_packages }}"
      when: ansible_os_family == "RedHat"

- name: Ensure libdnf5 is present on Fedora/RedHat
  package:
    name: libdnf5
    state: present
  when: ansible_distribution in ["Fedora", "RedHat"]

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_packages }}"
    state: present
    update_cache: yes


