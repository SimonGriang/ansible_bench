---
- name: Check if python is installed
  command: python --version
  register: python_installed
  ignore_errors: yes

- name: Check if python3 is installed
  command: python3 --version
  register: python3_installed
  ignore_errors: yes

- name: Debug Python executable path
  debug:
    msg: "Python executable path: {{ python_installed.rc_failed | ternary('Not found', python_installed.stdout_lines[0].split()[1]) }}"
  when: python_installed.rc == 0

- name: Debug Python3 executable path
  debug:
    msg: "Python3 executable path: {{ python3_installed.rc_failed | ternary('Not found', python3_installed.stdout_lines[0].split()[1]) }}"
  when: python3_installed.rc == 0

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install requirements
  ansible.builtin.package:
    name: "{{ openssl_requirements }}"
    state: present

- name: Ensure packaging is available via dnf
  ansible.builtin.dnf:
    name: python3-packaging
    state: present

- name: Install pip packages
  ansible.builtin.pip:
    name: "{{ openssl_pip_packages }}"
    state: present

- name: Create key directory
  ansible.builtin.file:
    path: "{{ key_directory }}"
    state: directory
    mode: "{{ key_directory_mode }}"
    owner: "{{ key_directory_owner }}"
    group: "{{ key_directory_group }}"

- name: Create csr directory
  ansible.builtin.file:
    path: "{{ csr_directory }}"
    state: directory
    mode: "{{ csr_directory_mode }}"
    owner: "{{ csr_directory_owner }}"
    group: "{{ csr_directory_group }}"

- name: Create crt directory
  ansible.builtin.file:
    path: "{{ crt_directory }}"
    state: directory
    mode: "{{ crt_directory_mode }}"
    owner: "{{ crt_directory_owner }}"
    group: "{{ crt_directory_group }}"

- name: Include create.yml
  include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item


