---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    groups: "{{ vault_group }}"
    home: "/nonexistent"
    system: yes

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Download Vault binary
  get_url:
    url: "{{ vault_download_url }}"
    dest: "{{ vault_download_path }}/vault.zip"
    mode: '0644'
  become: yes
  register: download_result

- name: Unarchive Vault binary
  unarchive:
    src: "{{ vault_download_path }}/vault.zip"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    owner: root
    group: root

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_stat

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: not vault_path_stat.stat.exists

- name: Create directory in vault_path
  file:
    path: "{{ vault_path }}/{{ item }}"
    state: directory
    mode: '0755'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ vault_path }}/{{ item }}"
    state: directory
    mode: '0755'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  openssl_privatekey:
    path: "{{ vault_data_directory }}/tls/key.pem"
  openssl_csr:
    path: "{{ vault_data_directory }}/tls/csr.pem"
    privatekey_path: "{{ vault_data_directory }}/tls/key.pem"
  openssl_certificate:
    path: "{{ vault_data_directory }}/tls/cert.pem"
    privatekey_path: "{{ vault_data_directory }}/tls/key.pem"
    csr_path: "{{ vault_data_directory }}/tls/csr.pem"
    provider: selfsigned
    valid_days: 1095
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ vault_data_directory }}/tls/{{ item }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  capabilities:
    path: "{{ vault_path }}/usr/bin/vault"
    capability: cap_ipc_lock=ep
    state: present
    permissive: no
  changed_when: false

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    mode: '0644'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'

- name: Copy Vault service file
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: '0644'
  notify: Daemon reload
  when: ansible_service_mgr == 'systemd'

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: '0644'
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


