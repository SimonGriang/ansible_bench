mand: postmap /etc/postfix/header_checks\n\n  - name: Reload postfix\n    service:\n      name: postfix\n      state: reloaded\n\n  - name: Validate main.cf\n    command: postfix check\n\n  - name: Restart postfix\n    service:\n      name: postfix\n      state: restarted\n\n  - name: Validate master.cf\n    command: postfix check\n\n  - name: Rebuild alias database\n    command: newaliases\n\n  - name: Rebuild sender_access database\n    command: postmap /etc/postfix/sender_access\n\n  - name: Validate recipient_access\n    command: postmap /etc/postfix/recipient_access\n\n  - name: Rebuild recipient_access database\n    command: postmap /etc/postfix/recipient_access\n\n  - name: Rebuild sasl_password_map database\n    command: postmap /etc/postfix/sasl_password\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-08T18:15:04.152431376Z', 'done': True, 'done_reason': 'stop', 'total_duration': 23333088793, 'load_duration': 52173099, 'prompt_eval_count': 2223, 'prompt_eval_duration': 508050248, 'eval_count': 1152, 'eval_duration': 22772198623, 'model_name': 'phi4:14b'} id='run--b08b23d1-1cb0-4abf-8c35-ce674aed8b9f-0' usage_metadata={'input_tokens': 2223, 'output_tokens': 1152, 'total_tokens': 3375}
