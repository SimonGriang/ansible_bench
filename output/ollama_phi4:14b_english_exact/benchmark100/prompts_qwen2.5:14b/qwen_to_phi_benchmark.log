---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/cron-env
    regexp: '^SHELL='
    line: 'SHELL={{ cron_shell_path }}'
    create: yes
    mode: '0644'
  notify: restart cron

- name: Configure path
  lineinfile:
    path: /etc/cron.d/cron-env
    regexp: '^PATH='
    line: 'PATH={{ cron_path }}'
    create: yes
    mode: '0644'
  notify: restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/cron-env
    regexp: '^MAILTO='
    line: 'MAILTO={{ cron_mailto }}'
    create: yes
    mode: '0644'
  notify: restart cron

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ''

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    user: "{{ item.user | default(omit) }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs }}"

handlers:
  - name: restart cron
    service:
      name: cron
      state: restarted


