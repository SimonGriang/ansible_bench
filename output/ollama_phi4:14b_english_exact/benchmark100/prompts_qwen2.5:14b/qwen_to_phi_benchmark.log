---
- import_playbook: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  hosts: all
  tasks:
    - name: Test connection and sudo availability
      command: echo "Testing connection"
      ignore_errors: yes

