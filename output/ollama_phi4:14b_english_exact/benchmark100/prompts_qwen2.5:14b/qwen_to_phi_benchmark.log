---
- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  ansible.builtin.command:
    cmd: kubectl get nodes --no-headers | grep -q 'Ready\s'
  register: node_ready
  until: node_ready.rc == 0
  retries: 100
  delay: 15
  delegate_to: "{{ active_server | default(inventory_hostname | group_names | first) }}"
  run_once: true
  check_mode: yes

- name: Wait for all pods to be ready again
  ansible.builtin.command:
    cmd: kubectl get pods --all-namespaces --field-selector=status.phase!=Running,status.phase!=Succeeded --no-headers | grep -q .
  register: pods_ready
  until: pods_ready.rc != 0
  retries: 100
  delay: 15
  delegate_to: "{{ active_server | default(inventory_hostname | group_names | first) }}"
  run_once: true
  when: rke2_wait_for_all_pods_to_be_ready is defined
  check_mode: "{{ rke2_wait_for_all_pods_to_be_ready | default(false) }}"


