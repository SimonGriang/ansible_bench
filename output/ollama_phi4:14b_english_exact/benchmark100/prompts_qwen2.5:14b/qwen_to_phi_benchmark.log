---
- name: Check if certificates exist
  ansible.builtin.stat:
    path: "{{ item }}"
  loop: "{{ java_certs }}"
  register: certificate_check

- name: Fail if some certificate doesn't exist
  ansible.builtin.fail:
    msg: "Certificate {{ item.item }} does not exist."
  when: not item.stat.exists
  loop: "{{ certificate_check.results }}"
  loop_control:
    label: "{{ item.item }}"

- name: Setting keystore variables in java < 11
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: java_open_jdk_version_major < 11

- name: Setting keystore variables in java >= 11
  ansible.builtin.set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: java_open_jdk_version_major >= 11

- name: Import SSL certificates
  community.general.java_cert:
    action: import
    path: "{{ item }}"
    keystore: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts"
    keystore_pass: "{{ lookup('env', 'JAVA_HOME') }}/lib/security/cacerts"
  loop: "{{ java_certs }}"


