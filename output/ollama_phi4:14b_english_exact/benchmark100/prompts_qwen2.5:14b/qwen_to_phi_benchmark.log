content="```yaml\n---\n- name: Import assert.yml to perform validation checks\n  import_tasks: assert.yml\n  when: inventory_hostname == 'localhost'\n\n- name: Install vsftpd package\n  package:\n    name: vsftpd\n    state: present\n\n- name: Configure vsftpd\n  template:\n    src: vsftpd.conf.j2\n    dest: /etc/vsftpd/vsftpd.conf\n    owner: root\n    group: root\n    mode: '0644'\n  notify:\n    - Restart vsftpd\n\n- name: Start and enable vsftpd service\n  service:\n    name: vsftpd\n    state: started\n    enabled: yes\n\nhandlers:\n  - name: Restart vsftpd\n    service:\n      name: vsftpd\n      state: restarted\n```\n\n" additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-08T17:15:47.172945963Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2931928632, 'load_duration': 54315706, 'prompt_eval_count': 390, 'prompt_eval_duration': 36883081, 'eval_count': 178, 'eval_duration': 2839707120, 'model_name': 'phi4:14b'} id='run--508b0f96-5533-474b-8ca5-cd776281b9ca-0' usage_metadata={'input_tokens': 390, 'output_tokens': 178, 'total_tokens': 568}
