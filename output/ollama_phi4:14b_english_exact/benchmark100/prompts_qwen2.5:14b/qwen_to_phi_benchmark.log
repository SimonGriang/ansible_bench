---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize PKI in /etc/openvpn/easy-rsa directory if it doesn't already exist
  command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts['directory_exists'] or not ansible_test_easypass('ca.crt')

- name: Build the Certificate Authority (CA) without interactive prompts if the CA certificate does not already exist
  command: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate Diffie-Hellman parameters if they do not already exist
  command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build a server certificate and key without interactive prompts if the server certificate does not already exist
  command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build a client certificate and key without interactive prompts if the client certificate does not already exist
  command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate a Certificate Revocation List (CRL) if it does not already exist
  command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate a static key for the OpenVPN tunnel if the static key does not already exist
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  when: not ansible_test_file('/etc/openvpn/easy-rsa/pki/ta.key')

- name: Copy necessary files from /etc/openvpn/easy-rsa/pki to /etc/openvpn/server directory with appropriate permissions
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/{{ item }}
    mode: '0644'
  loop:
    - 'ca.crt'
    - 'server.crt'
    - 'server.key'
    - 'dh.pem'
    - 'ta.key'
    - 'crl.pem'

- name: Copy necessary files from /etc/openvpn/easy-rsa/pki to /etc/openvpn directory with appropriate permissions
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/{{ item }}
    mode: '0644'
  loop:
    - 'ca.crt'
    - 'client.crt'
    - 'client.key'
    - 'ta.key'

- name: Place the server configuration file using a template and notify the handler to restart openvpn service after the file is placed
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server/server.conf
  notify: Restart openvpn service


