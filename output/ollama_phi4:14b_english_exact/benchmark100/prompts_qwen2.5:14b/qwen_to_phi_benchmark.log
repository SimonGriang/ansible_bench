---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  block:
    - name: Test connection
      ping:

    - name: Test sudo availability
      command: echo "Check sudo"
      register: result
      failed_when: "'sudo' not in result.stdout"

    - name: Gather bootstrap facts if needed
      setup:
        gather_subset:
          - '!all'
        gather_network_info: false
        gather_facts: false
      register: bootstrap_facts
      when: result is failed

    - name: Install necessary packages
      raw: apt-get update && apt-get install -y python3 sudo
      register: install_result
      when: result is failed

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  notify:
    - update_cache


