---
- name: Import assert.yml
  import_tasks: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install PHP
  package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  shell: "php --ini | grep -A 1 'Loaded Configuration File' | tail -n 1 | awk '{print $4}'"
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure PHP
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
  notify: restart httpd


