---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  ansible.builtin.block:
    - ansible.builtin.setup:
        gather_subset: "!all"
    - ansible.builtin.command:
        cmd: "echo 'Testing Connection'"
      register: test_connection
    - ansible.builtin.command:
        cmd: "echo 'Testing Sudo'"
      register: test_sudo
  become: true
  become_user: root
  ansible.builtin.set_fact:
    can_switch_user: false

- name: Gather bootstrap facts
  ansible.builtin.debug:
    msg: "Preparing system failed, gathering additional facts"
  when: test_connection is failed or test_sudo is failed

- name: Install bootstrap packages (raw)
  ansible.builtin.raw:
    cmd: >
      {{ 'yum install -y ' + ' '.join(bootstrap_packages) if
      ansible_facts['os_family'] == 'RedHat' else 'apt-get install -y ' +
      ' '.join(bootstrap_packages) }}

- name: Ensure libdnf5 is present on Fedora/RedHat
  ansible.builtin.package:
    name: libdnf5
    state: present
  when: ansible_facts['os_family'] == 'RedHat' and
        ansible_facts['distribution_version'] | version_compare('22', '>=')

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_packages }}"
    state: present
    update_cache: yes


