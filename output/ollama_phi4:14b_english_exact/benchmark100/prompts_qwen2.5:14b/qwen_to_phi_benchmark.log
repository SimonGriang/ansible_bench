  command: kubectl get nodes -o custom-columns=NAME:.metadata.name --no-headers
  register: all_nodes

- name: Restore etcd - remove old nodes
  command: kubectl delete node {{ item }}
  loop: "{{ all_nodes.stdout_lines | difference(current_rke2_cluster_group) }}"


