---
- name: Import assert.yml
  import_playbook: assert.yml
  hosts: localhost
  gather_facts: no
  tasks: []

- name: Install prerequisites
  yum:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}_tasks.yml"

- name: Add Vault environment variables
  lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item }}"
    create: yes
  loop: "{{ vault_environment_settings }}"
  notify: Restart vault

- name: Include hardening tasks
  include_tasks: hardening.yml

- name: Start and enable vault
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable vault
  service:
    name: vault
    enabled: yes
  when: vault_type != "oss"


