      ansible.builtin.apt_repository:
        repo: "deb [arch=amd64] https://download.docker.com/linux/{{ ansible_distribution | lower }}/{{ ansible_distribution_release }} stable"
        state: present
      when: docker_add_repo | default(false)

    - name: Remove Docker repository
      ansible.builtin.apt_repository:
        repo: "deb [arch=amd64] https://download.docker.com/linux/{{ ansible_distribution | lower }}/{{ ansible_distribution_release }} stable"
        state: absent
      when: not docker_add_repo | default(false)
  notify:
    - Update apt cache

- name: Flush handlers to ensure the apt cache is updated immediately
  meta: flush_handlers
