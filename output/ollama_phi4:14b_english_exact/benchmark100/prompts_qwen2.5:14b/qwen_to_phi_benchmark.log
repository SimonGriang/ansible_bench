content='```yaml\n---\n- name: Restore etcd - get all nodes\n  hosts: localhost\n  gather_facts: no\n  tasks:\n    - name: Fetch the names of all nodes in the Kubernetes cluster\n      command: >\n        kubectl get nodes -o custom-columns=NAME:.metadata.name --no-headers\n      register: all_nodes_output\n\n- name: Restore etcd - remove old nodes\n  hosts: localhost\n  gather_facts: no\n  tasks:\n    - name: Retrieve the current RKE2 cluster group names\n      shell: "echo \'{{ rke2_cluster_group_names }}\'"\n      register: current_group_names\n      vars:\n        rke2_cluster_group_names: "{{ lookup(\'env\', \'RKE2_CLUSTER_GROUP_NAMES\').split(\',\') }}"\n\n    - name: Remove nodes not part of the current RKE2 cluster group\n      command: "kubectl delete node {{ item }}"\n      loop: "{{ all_nodes_output.stdout_lines | select(\'notin\', current_group_names.stdout_lines) | list }}"\n```\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-08T18:34:22.616590655Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4097354866, 'load_duration': 66223427, 'prompt_eval_count': 370, 'prompt_eval_duration': 41211833, 'eval_count': 217, 'eval_duration': 3988474121, 'model_name': 'phi4:14b'} id='run--dc475be4-9e8c-43db-bcf8-6c5063b7b173-0' usage_metadata={'input_tokens': 370, 'output_tokens': 217, 'total_tokens': 587}
