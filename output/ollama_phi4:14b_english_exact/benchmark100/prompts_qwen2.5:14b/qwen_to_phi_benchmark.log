---
- name: Load OS-specific vars
  include_vars:
    file: "{{ ansible_distribution }}.yml"
  when: ansible_os_family in ['RedHat', 'Debian']

- name: Include RedHat-specific setup tasks
  include_tasks: setup-RedHat.yml
  when: ansible_os_family == 'RedHat'

- name: Include Debian-specific setup tasks
  include_tasks: setup-Debian.yml
  when: ansible_os_family == 'Debian'

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  when: >
    ansible_version.full is version('2.12', '<') or
    ansible_os_family not in ['RedHat', 'Debian']
  ignore_errors: true

- name: Install Docker packages (with downgrade option)
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: true
  when: >
    ansible_version.full is version('2.12', '>=') and
    ansible_os_family in ['RedHat', 'Debian']

- name: Install docker-compose plugin
  package:
    name: docker-compose
    state: present
  when: >
    docker_install_compose_plugin and
    (ansible_version.full is version('2.12', '<') or
    ansible_os_family not in ['RedHat', 'Debian'])
  ignore_errors: true

- name: Install docker-compose-plugin (with downgrade option)
  package:
    name: docker-compose
    state: present
    allow_downgrade: true
  when: >
    docker_install_compose_plugin and
    ansible_version.full is version('2.12', '>=') and
    ansible_os_family in ['RedHat', 'Debian']

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: '0755'
  when: docker_daemon_options is defined

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options | to_nice_yaml }}"
    dest: /etc/docker/daemon.json
    owner: root
    group: root
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options is defined

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  when: not ansible_check_mode
  ignore_errors: true

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose.yml tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group info using getent
  getent:
    database: group
    key: docker
  register: docker_group

- name: Check if there are any users to add to the docker group
  set_fact:
    users_to_add: "{{ docker_users | default([]) }}"
  when: docker_group is defined and docker_group.getent is defined

- name: Include docker-users.yml tasks
  include_tasks: docker-users.yml
  when: users_to_add | length > 0


