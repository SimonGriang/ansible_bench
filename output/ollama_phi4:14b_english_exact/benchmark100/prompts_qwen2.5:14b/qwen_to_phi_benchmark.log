---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Enable redis module stream (RHEL 8)
  package:
    name: "@module-repo:redis"
    state: present
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: "redis.conf.j2"
    dest: "/etc/{{ 'redis/redis.conf' if ansible_facts['os_family'] == 'RedHat' else 'redis.conf' }}"
    owner: "redis"
    group: "redis"
    mode: "0644"
  notify:
    - Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
