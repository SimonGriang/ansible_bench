---
- name: Cordon and Drain the node {{ rke2_node_name }}
  ansible.builtin.command: >
    kubectl cordon {{ rke2_node_name }} && 
    kubectl drain {{ rke2_node_name }}
    --ignore-daemonsets {{ rke2_drain_additional_args | default('') }}
    --delete-local-data --force --grace-period=-1
  args:
    chdir: "{{ rke2_data_path }}"
  register: drain_output
  until: drain_output.rc == 0
  retries: 100
  delay: 15

- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.systemd:
    name: rke2-server
    state: restarted
  delegate_to: "{{ rke2_node_name }}"
  notify:
    - Service (re)started

- name: Wait for all nodes to be ready again
  ansible.builtin.command: kubectl get nodes
  register: nodes_status
  until: "'Ready' in nodes_status.stdout_lines"
  retries: 100
  delay: 15

- name: Uncordon the node {{ rke2_node_name }}
  ansible.builtin.command: kubectl uncordon {{ rke2_node_name }}
  when: rke2_drain_node_during_upgrade
  args:
    chdir: "{{ rke2_data_path }}"

- name: Wait for all pods to be ready again
  ansible.builtin.command: kubectl get pods --all-namespaces
  register: pods_status
  until: "'Running' in pods_status.stdout_lines or 'Succeeded' in pods_status.stdout_lines"
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  ansible.builtin.command: kubectl wait --for=condition=Ready pods --all
  register: readiness_checks
  until: readiness_checks.rc == 0
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy


