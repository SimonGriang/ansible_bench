\'s standard modules and practices.' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-18T20:44:55.511421041Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7752528559, 'load_duration': 62219506, 'prompt_eval_count': 596, 'prompt_eval_duration': 269854905, 'eval_count': 504, 'eval_duration': 7419364341, 'model_name': 'phi4:14b'} id='run--0a2b825b-1556-44d2-bbcb-25524f8d15ac-0' usage_metadata={'input_tokens': 596, 'output_tokens': 504, 'total_tokens': 1100}
