---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    create: yes
    owner: root
    group: root
    mode: '0600'
  notify: Restart cron handler

- name: Configure path
  lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    create: yes
    owner: root
    group: root
    mode: '0600'
  notify: Restart cron handler

- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    owner: root
    group: root
    mode: '0600'
  notify: Restart cron handler

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ''

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    user: "{{ item.user | default(omit) }}"
    minute: "{{ item.minute | default('*') }}"
    hour: "{{ item.hour | default('*') }}"
    day: "{{ item.day | default('*') }}"
    month: "{{ item.month | default('*') }}"
    weekday: "{{ item.weekday | default('*') }}"
    job: "{{ item.command }}"
  loop: "{{ cron_jobs }}"


