---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_user }}"
  register: git_user_exists

- name: Create directory for git configuration
  file:
    path: "{{ git_config_dir }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
    mode: '0755'
  when: git_user_exists.exists and git_config_dir is defined

- name: Place git configuration
  copy:
    dest: "{{ git_config_dir }}/.gitconfig"
    content: |
      [user]
        name = {{ git_user_name }}
        email = {{ git_user_email }}
  when: git_user_exists.exists and git_user_name is defined and git_user_email is defined

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
    mode: '0755'
  when: git_user_exists.exists and repository_destination is defined

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}/{{ item.name }}"
    version: "{{ item.branch | default('master') }}"
    become: yes
    become_user: "{{ git_user }}"
  loop: "{{ git_repositories }}"
  when: git_user_exists.exists


