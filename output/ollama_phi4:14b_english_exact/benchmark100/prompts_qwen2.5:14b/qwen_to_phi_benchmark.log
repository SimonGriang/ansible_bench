---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ dns_directories }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_user }}"
    system: yes
    group: "{{ dns_group }}"
    create_home: no

- name: Generate rndc key
  command: rndc-confgen -a -r /dev/urandom
  args:
    creates: "{{ rndc_key_path }}"

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_path }}"
    mode: "0600"

- name: Get the hints/root file
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ root_hints_dest }}"
    mode: "0644"

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ item.path }}"
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ named_conf_path }}"
    mode: "0644"

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: /etc/systemd/system/named.service.d
        state: directory
        mode: "0755"

    - name: Place override configuration file for the DNS service
      copy:
        src: named.service.conf
        dest: /etc/systemd/system/named.service.d/override.conf

- name: Start and enable dns
  systemd:
    name: named
    state: started
    enabled: yes


