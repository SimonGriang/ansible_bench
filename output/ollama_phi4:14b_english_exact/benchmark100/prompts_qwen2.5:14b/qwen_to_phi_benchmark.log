- name: Install Keepalived when HA mode is enabled
  package:
    name: keepalived
    state: present
  when: 
    - high_availability_enabled
    - "'server' in group_names"

- name: Download and install RKE2
  block:
    - name: Download RKE2
      get_url:
        url: "{{ rke2_download_url }}"
        dest: "/tmp/rke2-{{ rke2_version }}.{{ ansible_system }}-{{ ansible_architecture }}"
    - name: Install RKE2
      command: "/tmp/rke2-{{ rke2_version }}.{{ ansible_system }}-{{ ansible_architecture }} install"
  vars:
    rke2_download_url: "https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/rke2-server"
    rke2_version: "{{ rke2_version | default('v1.21.4') }}"

- name: CIS Hardening
  include_tasks: cis_hardening.yml
  when: cis_profile is defined

- name: Find Active Server
  include_tasks: find_active_server.yml

- name: Enable IPVS kernel module
  modprobe:
    name: ip_vs
    state: present
  when: 
    - use_kube_vip
    - high_availability_enabled

- name: Copy kube-vip manifests to the masternode
  copy:
    src: kube-vip/
    dest: /etc/kubernetes/manifests/
    mode: '0755'
  when: not use_keepalived

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: ingress-nginx/
    dest: /etc/kubernetes/manifests/
    mode: '0755'
  when: ingress_nginx_configured

- name: Prepare very first server node in the cluster
  include_tasks: prepare_first_server.yml
  when: first_server_node

- name: Restore etcd specific tasks
  include_tasks: restore_etcd.yml
  when: etcd_restore_required

- name: Download kubeconfig to ansible localhost
  fetch:
    src: "/etc/rancher/rke2/rke2.yaml"
    dest: "{{ playbook_dir }}/rke2_kubeconfig.yaml"
    flat: yes
  when: download_kubeconfig_enabled

- name: Prepare and join remaining nodes of the cluster
  include_tasks: join_nodes.yml
  when: active_server is defined

- name: Rolling cordon and drain restart when version changes - servers
  include_tasks: rolling_restart_servers.yml
  when: rke2_version_changed

- name: Rolling cordon and drain restart when version changes - agents
  include_tasks: rolling_restart_agents.yml
  when: rke2_version_changed

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  include_tasks: rolling_restart_config.yml
  when: config_files_changed

- name: Final steps
  include_tasks: final_steps.yml


