---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  tasks:
    - name: Set main_mailer_type to "No configuration"
      debconf:
        name: postfix
        question: postfix/main_mailer_type
        value: "No configuration"
        vtype: select

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: "'mysql' in postfix_virtual_mailbox_maps or 'mysql' in postfix_virtual_mailbox_domains or 'mysql' in postfix_virtual_alias_maps"

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
  notify:
    - Validate transport_maps
    - Rebuild transport_maps database

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - Validate header_checks
    - Reload postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    main_cf_smtpd_restrictions:
      - smtpd_recipient_restrictions
      - smtpd_sender_restrictions
  when: smtpd_recipient_restrictions is defined and smtpd_sender_restrictions is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    main_cf_configurations:
      - mynetworks
      - mydestination
      - relay_domains
      - virtual_mailbox_domains
      - virtual_alias_domains
  when: mynetworks is defined and mydestination is defined and relay_domains is defined and virtual_mailbox_domains is defined and virtual_alias_domains is defined

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - Validate main.cf
    - Restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - Validate master.cf
    - Restart postfix

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  with_items:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_cert_src }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0644'
  notify: Reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_src }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0600'
  notify: Reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: "{{ item.key }}: {{ item.value }}"
  with_dict: "{{ postfix_aliases }}"
  notify:
    - Rebuild alias database
    - Reload postfix

- name: Configure sender_access
  lineinfile:
    path: /etc/postfix/sender_access
    line: "{{ item.key }} {{ item.value }}"
  with_dict: "{{ postfix_sender_access }}"
  notify:
    - Rebuild sender_access database
    - Reload postfix

- name: Configure recipient_access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: "{{ item.key }} {{ item.value }}"
  with_dict: "{{ postfix_recipient_access }}"
  notify:
    - Validate recipient_access
    - Rebuild recipient_access database
    - Reload postfix

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map_content }}"
    dest: /etc/postfix/sasl_password
    mode: '0600'
  notify: Rebuild sasl_password_map database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes

handlers:
  - name: Validate transport_maps
    command: postmap /etc/postfix/transport

  - name: Rebuild transport_maps database
    command: postmap /etc/postfix/transport

  - name: Validate header_checks
    command: postmap /etc/postfix/header_checks

  - name: Reload postfix
    service:
      name: postfix
      state: reloaded

  - name: Validate main.cf
    command: postfix check

  - name: Restart postfix
    service:
      name: postfix
      state: restarted

  - name: Validate master.cf
    command: postfix check

  - name: Rebuild alias database
    command: newaliases

  - name: Rebuild sender_access database
    command: postmap /etc/postfix/sender_access

  - name: Validate recipient_access
    command: postmap /etc/postfix/recipient_access

  - name: Rebuild recipient_access database
    command: postmap /etc/postfix/recipient_access

  - name: Rebuild sasl_password_map database
    command: postmap /etc/postfix/sasl_password


