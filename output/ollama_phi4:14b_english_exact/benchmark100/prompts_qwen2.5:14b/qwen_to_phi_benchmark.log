---
- name: Import assert.yml
  import_playbook: assert.yml
  hosts: localhost
  tasks: []

- name: Install prerequisites
  ansible.builtin.package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  ansible.builtin.include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  ansible.builtin.lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item }}"
    create: yes
  loop: "{{ vault_environment_settings }}"
  notify: Restart vault

- name: Include hardening tasks
  ansible.builtin.include_tasks: hardening.yml

- name: Start and enable vault
  ansible.builtin.service:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable vault
  ansible.builtin.service:
    name: vault
    enabled: yes
  when: vault_type != "oss"

handlers:
  - name: Restart vault
    ansible.builtin.service:
      name: vault
      state: restarted


