---
- name: Assert usage of systemd as an init system
  assert:
    that: ansible_service_mgr == "systemd"

- name: Get latest release of promtail
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
  register: promtail_release
  vars:
    promtail_version: "{{ promtail_release.json.tag_name }}"

- name: Test if zip local archive exists
  stat:
    path: "/path/to/local/archive/{{ promtail_version }}_{{ go_arch }}.zip"
  register: promtail_archive

- name: Assert local binary exists
  assert:
    that:
      - promtail_binary_local_dir is defined
      - promtail_binary_local_dir != ""
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/tags/{{ promtail_version }}/assets
    return_content: yes
  register: checksum_list

- name: Get checksum for specific architecture
  set_fact:
    promtail_checksum: "{{ item.sha256 }}"
  loop: "{{ checksum_list.json }}"
  when: item.name.endswith(f'-{{ go_arch }}.zip')


