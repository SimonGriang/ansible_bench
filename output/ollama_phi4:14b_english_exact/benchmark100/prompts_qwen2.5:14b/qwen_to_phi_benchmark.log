---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install using package
  ansible.builtin.package:
    name: "{{ hashicorp_package }}"
    state: present

- name: Install repository for RedHat
  ansible.builtin.yum_repository:
    name: hashicorp
    description: HashiCorp Repository
    baseurl: https://apt.releases.hashicorp.com/{{ ansible_facts['os']['release']['id'] }}-{{ ansible_facts['os']['release']['major'] }}/{{ ansible_facts['ansible_architecture'] }}
    gpgkey: https://apt.releases.hashicorp.com/gpg
    gpgcheck: yes
  when: ansible_facts['os_family'] == "RedHat"

- name: Configure debian
  block:
    - name: Install required package gpg
      ansible.builtin.apt:
        name: gnupg
        state: present

    - name: Install apt key for Debian
      ansible.builtin.apt_key:
        url: https://apt.releases.hashicorp.com/gpg
        state: present

    - name: Install repository for Debian
      ansible.builtin.apt_repository:
        repo: >
          deb [arch=amd64]
          https://apt.releases.hashicorp.com
          {{ ansible_facts['distribution_release'] }}
          main
        state: present
  when: ansible_facts['os_family'] == "Debian"

- name: Install hashicorp product using package
  ansible.builtin.package:
    name: "{{ hashicorp_package }}"
    state: present
  when: hashicorp_version is not defined

- name: Install versioned hashicorp product using package
  ansible.builtin.package:
    name: "{{ hashicorp_package }}={{ hashicorp_version }}"
    state: present
  when: hashicorp_version is defined

- name: Install manually
  ansible.builtin.unarchive:
    src: "{{ hashicorp_package_url }}"
    dest: "{{ hashicorp_install_path }}"
    remote_src: yes

- name: Install hashicorp product manually
  ansible.builtin.file:
    src: "{{ hashicorp_package_url }}"
    dest: "{{ hashicorp_install_path }}/{{ hashicorp_product_name }}"
    owner: root
    group: root
    mode: '0755'


