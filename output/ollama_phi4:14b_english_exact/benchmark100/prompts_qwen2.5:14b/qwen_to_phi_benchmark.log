---
- name: hardening | Disable swap now
  command: swapoff -a
  when: swap_status is defined and swap_status.enabled

- name: hardening | Disable swap permanently
  mount:
    name: "{{ item }}"
    fstype: swap
    state: absent
  loop: "{{ swap_partitions }}"
  when: vault_hardening_disable_swap | bool

- name: hardening | Disable core dumps
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    reload: yes
  loop:
    - { name: 'fs.suid_dumpable', value: '0' }
    - { name: 'kernel.core_pattern', value: '/dev/null' }
  when: vault_hardening_disable_core_dumps | bool

- name: hardening | Disable Shell Command History
  copy:
    dest: /etc/profile.d/no_history.sh
    content: |
      export HISTSIZE=0
      export HISTFILESIZE=0
      export HISTCONTROL=ignorespace:erasedups
      export HISTIGNORE='&:[bf]g:exit'
    mode: '0644'
  when: vault_hardening_disable_shell_command_history | bool

- name: hardening | Configure SELinux / AppArmor
  block:
    - name: hardening | Enable SELinux
      selinux:
        policy: targeted
        state: enforcing
      when: vault_hardening_configure_selinux_apparmor | bool

    - name: hardening | Install selinux-policy
      package:
        name: selinux-policy
        state: present

    - name: hardening | Set SELinux policy
      selinux:
        policy: targeted
        state: enforcing

    - name: hardening | Enable AppArmor (enforcing)
      command: aa-enforce /etc/apparmor.d/usr.bin.vault
  when: vault_hardening_configure_selinux_apparmor | bool


