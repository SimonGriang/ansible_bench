---
- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "/home/{{ user.name }}/.ssh"
    state: directory
    mode: '0750'
  when: user.manage_ssh_key | default(false)
  delegate_to: localhost

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    password: "{{ user.password | default(omit) }}"
    shell: "{{ user.shell | default('/bin/bash') }}"
    groups: "{{ user.groups | default([]) }}"
    append: "{{ user.append | default(false) }}"
    create_home: "{{ user.create_home | default(true) }}"
    system: "{{ user.system | default(false) }}"
    uid: "{{ user.uid | default(omit) }}"
    generate_ssh_key: "{{ user.generate_ssh_key | default(false) }}"

- name: Set sudo options for {{ user.name }}
  copy:
    content: "{{ user.sudo_options | default('') }}"
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: '0640'
    validate: '/usr/sbin/visudo --check %s'
  when: user.sudo_options is defined and user.sudo_options != ''

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudo_options is not defined or user.sudo_options == ''

- name: Generate private ssh key for {{ user.name }}
  openssh_keypair:
    path: "/home/{{ user.name }}/.ssh/id_rsa"
    type: rsa
    size: 2048
  when: user.manage_ssh_key | default(false)
  delegate_to: localhost

- name: Generate public ssh key for {{ user.name }}
  openssh_keypair:
    path: "/home/{{ user.name }}/.ssh/id_rsa.pub"
    type: rsa
    size: 2048
  when: user.manage_ssh_key | default(false)
  delegate_to: localhost

- name: Convert ssh key to ppk for {{ user.name }}
  shell: "puttygen /home/{{ user.name }}/.ssh/id_rsa -o /home/{{ user.name }}/.ssh/id_rsa.ppk"
  when: user.manage_ssh_key | default(false)
  delegate_to: localhost

- name: Get or set the home directory for {{ user.name }}
  set_fact:
    user_home: "{{ lookup('ansible.builtin.getent', 'passwd ' + user.name).split(':')[5] | default('/home/' + user.name, true) }}"

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
  when: user.manage_ssh_key | default(false) or user.private_keys is defined
  become: true

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
  with_items: "{{ user.authorized_keys | default([]) }}"
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item }}"
  with_items: "{{ user.unauthorized_keys | default([]) }}"
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "/home/{{ user.name }}/.ssh/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.copy_private_key | default(false)
  become: true

- name: Check users password valid time for {{ user.name }}
  command: chage -l {{ user.name }}
  register: password_valid_time
  changed_when: false

- name: Set users password valid time for {{ user.name }}
  user:
    name: "{{ user.name }}"
    password_expire_min: "{{ user.password_validity_days | default(0) * 86400 }}"
  when: user.password_validity_days is defined and password_valid_time.stdout.find('Password expires') == -1

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ item }}"
    dest: "{{ user_home }}/.ssh/{{ item | basename }}"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  with_items: "{{ user.private_keys | default([]) }}"
  become: true


