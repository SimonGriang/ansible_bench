content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  delegate_to: localhost\n  run_once: true\n\n- name: Install python pip\n  package:\n    name: "{{ name }}"\n    state: present\n\n- name: Configure pip proxy\n  lineinfile:\n    path: /etc/pip.conf\n    line: "proxy = {{ python_pip_proxy }}"\n    create: yes\n  when: python_pip_proxy is defined\n\n- name: Trust hosts\n  lineinfile:\n    path: /etc/pip.conf\n    line: "trusted-host = {{ python_pip_trusted_host }}"\n    create: yes\n  when: python_pip_trusted_host is defined\n\n- name: Update pip\n  pip:\n    name: pip\n    state: latest\n  when:\n    - python_pip_update | default(false)\n    - ansible_distribution_release not in [\'bookworm\', \'noble\']\n    - ansible_os_family != \'Alpine\'\n\n- name: Install requested modules\n  pip:\n    name: "{{ item.name }}"\n    state: "{{ item.state | default(\'present\') }}"\n    version: "{{ item.version | default(omit) }}"\n  loop: "{{ python_pip_modules }}"\n  when:\n    - ansible_distribution_release not in [\'bookworm\', \'noble\']\n    - ansible_os_family != \'Alpine\'\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-18T21:19:10.435717457Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3779579658, 'load_duration': 66764651, 'prompt_eval_count': 519, 'prompt_eval_duration': 54317553, 'eval_count': 286, 'eval_duration': 3657309154, 'model_name': 'phi4:14b'} id='run--cd5f5003-52f0-44de-a6f2-c770072a8ce4-0' usage_metadata={'input_tokens': 519, 'output_tokens': 286, 'total_tokens': 805}
