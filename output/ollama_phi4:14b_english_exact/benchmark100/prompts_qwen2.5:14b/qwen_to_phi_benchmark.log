---
- name: Create directories specified in the httpd_directories variable
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_directories }}"

- name: Configure directories by applying the directory configuration template
  template:
    src: directory.conf.j2
    dest: "/etc/httpd/conf.d/{{ item }}.conf"
  loop: "{{ httpd_directories }}"

- name: Test the httpd configuration
  command: httpd -t
  register: httpd_test
  changed_when: false

- name: Restart the httpd service if configuration is valid
  service:
    name: httpd
    state: restarted
  when: httpd_test.rc == 0


