---
- name: lookup bootstrap facts (raw)
  ansible.builtin.setup:
    gather_subset: "!"
    filter: ansible_facts
  register: raw_facts
  delegate_to: localhost

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ raw_facts.ansible_facts['distribution'] }}"
    bootstrap_distribution_version: "{{ raw_facts.ansible_facts['distribution_version'] | regex_replace('^\\d+\\.?\\d*') }}"
  delegate_to: localhost

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: >-
      {{ bootstrap__os_family_map[bootstrap_distribution] | 
         default(bootstrap_distribution) }}
  delegate_to: localhost


