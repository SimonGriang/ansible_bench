---
- name: Enable proxy and proxy_http modules on Debian and Suse systems
  apache2_module:
    name: "{{ item }}"
    state: present
  loop:
    - proxy
    - proxy_http
  when: ansible_os_family in ['Debian', 'Suse']

- name: Configure locations using a template
  template:
    src: location.conf.j2
    dest: /etc/apache2/conf-available/location.conf
  notify:
    - Test Apache configuration
    - Restart Apache
  vars:
    httpd_locations: "{{ httpd_locations | default([]) }}"


