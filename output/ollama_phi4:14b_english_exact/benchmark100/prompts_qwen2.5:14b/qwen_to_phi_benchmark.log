         nightly
    state: present
  when: docker_nightly_enabled | default(false) | bool

- name: Configure Docker Test repo
  ansible.builtin.apt_repository:
    repo: deb [arch=amd64] 
         https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} 
         test
    state: present
  when: docker_test_enabled | default(false) | bool

- name: Configure containerd on RHEL 8
  block:
    - name: Ensure runc is not installed
      ansible.builtin.package:
        name: runc
        state: absent

    - name: Ensure container-selinux and containerd.io are installed
