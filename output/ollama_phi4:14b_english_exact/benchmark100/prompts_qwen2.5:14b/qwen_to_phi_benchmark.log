---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.include_vars:
    file: /etc/os-release
    name: os_release_facts

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    distribution: "{{ os_release_facts['NAME'] | lower }}"
    major_version: "{{ os_release_facts['VERSION_ID'] | regex_search('^(\\d+)') | first }}"
  loop: "{{ bootstrap_os_family_map }}"
  loop_control:
    loop_var: _os_family

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    os_family: "{{ _os_family.value if distribution in _os_family.key.split(',') else 'unknown' }}"
  loop: "{{ bootstrap_os_family_map }}"
  loop_control:
    loop_var: _os_family


