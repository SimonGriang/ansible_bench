---
- name: Enable Backports repository for Debian distributions older than version 9
  apt_repository:
    repo: "deb http://deb.debian.org/debian {{ ansible_distribution_release }}-backports main"
    state: present
    filename: "deb-backports-{{ ansible_distribution_release }}"
  when: ansible_distribution == "Debian" and ansible_distribution_release is version('9', '<')
  register: apt_update

- name: Update package cache
  apt:
    update_cache: yes
  when: apt_update.changed

- name: Set default_release for older Debian versions
  set_fact:
    ansible_default_release: "{{ ansible_distribution_release }}-backports"
  when: ansible_distribution == "Debian" and ansible_distribution_release is version('9', '<')

- name: Install Ansible using the default_release set for older Debian versions
  apt:
    name: ansible
    state: "{{ ansible_package_state }}"
    default_release: "{{ ansible_default_release }}"
  when: ansible_distribution == "Debian" and ansible_default_release is defined


