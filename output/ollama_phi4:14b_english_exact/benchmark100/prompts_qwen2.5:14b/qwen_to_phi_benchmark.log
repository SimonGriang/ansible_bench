---
- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_directories }}"
  loop_control:
    loop_var: item

- name: Configure directories
  template:
    src: directory.conf.j2
    dest: "/etc/httpd/conf.d/{{ item }}.conf"
  loop: "{{ httpd_directories }}"
  loop_control:
    loop_var: item

- name: Test httpd configuration
  command: apachectl configtest
  register: configtest
  changed_when: false

- name: Restart httpd service
  service:
    name: httpd
    state: restarted
  when: configtest.rc == 0


