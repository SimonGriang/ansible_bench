n  copy:\n    src: /etc/openvpn/easy-rsa/pki/{{ item }}\n    dest: /etc/openvpn/server/{{ item }}\n    mode: '0644'\n  loop:\n    - ca.crt\n    - server.crt\n    - server.key\n    - dh.pem\n    - ta.key\n    - crl.pem\n\n- name: Copy necessary files from /etc/openvpn/easy-rsa/pki to /etc/openvpn\n    directory with appropriate permissions\n  copy:\n    src: /etc/openvpn/easy-rsa/pki/{{ item }}\n    dest: /etc/openvpn/{{ item }}\n    mode: '0644'\n  loop:\n    - ca.crt\n    - client.crt\n    - client.key\n    - ta.key\n\n- name: Place the server configuration file using a template and notify the\n    handler to restart openvpn service after the file is placed\n  template:\n    src: server.conf.j2\n    dest: /etc/openvpn/server/server.conf\n  notify: Restart openvpn service\n```" additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-08T17:40:13.395020066Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13891166800, 'load_duration': 69339221, 'prompt_eval_count': 1612, 'prompt_eval_duration': 358763166, 'eval_count': 755, 'eval_duration': 13461551466, 'model_name': 'phi4:14b'} id='run--fa34c0f0-0315-44ff-b962-a1f604f6d36a-0' usage_metadata={'input_tokens': 1612, 'output_tokens': 755, 'total_tokens': 2367}
