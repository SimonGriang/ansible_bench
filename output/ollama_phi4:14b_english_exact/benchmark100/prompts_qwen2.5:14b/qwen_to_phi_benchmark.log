- name: Configure oracle targz
  block:
    - file:
        path: "{{ oracle_java_install_dir }}"
        state: directory
    - get_url:
        url: "{{ oracle_java_targz_url }}"
        dest: "/tmp/{{ oracle_java_targz_file }}"
    - unarchive:
        src: "/tmp/{{ oracle_java_targz_file }}"
        dest: "{{ oracle_java_install_dir }}"
        remote_src: yes

- name: Install oracle java policy software (targz)
  copy:
    src: "{{ oracle_java_jce_policy_files_source }}"
    dest: "{{ oracle_java_install_dir }}/jre/lib/security"
    remote_src: yes

- name: Set alternative (targz)
  alternatives:
    name: java
    path: "{{ oracle_java_install_dir }}/bin/java"
    link: /usr/bin/java
  when: ansible_os_family != "Alpine"

- name: Find JAVA_HOME
  command: readlink -f "$(which java)" | sed "s:bin/java::"
  register: java_home

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME={{ java_home.stdout }}"


