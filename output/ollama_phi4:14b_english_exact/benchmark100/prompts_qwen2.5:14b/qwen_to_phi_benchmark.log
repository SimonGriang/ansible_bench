rivate_keys is defined\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-08T18:01:05.141893291Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16506708171, 'load_duration': 53482794, 'prompt_eval_count': 2066, 'prompt_eval_duration': 39713802, 'eval_count': 1018, 'eval_duration': 16412572113, 'model_name': 'phi4:14b'} id='run--9b4d4683-fdc4-4414-95cf-1d9a76efe9cb-0' usage_metadata={'input_tokens': 2066, 'output_tokens': 1018, 'total_tokens': 3084}
