---
- name: Import assert.yml
  import_tasks: assert.yml
  when: inventory_hostname == 'localhost'

- name: Configure apk
  block:
    - name: Update apk cache
      apk:
        update_cache: yes

    - name: Upgrade all apk packages
      apk:
        upgrade: yes

  handlers:
    - name: Reboot the system
      reboot:
      listen: "Notify reboot handler"

- name: Configure apt
  block:
    - name: Prevent upgrade for selected apt packages
      apt:
        name: "{{ item }}"
        state: present
        install_recommends: no
        allow_downgrades: yes
      loop: "{{ apt_packages_to_prevent_upgrade }}"

    - name: Update all apt packages
      apt:
        upgrade: dist

    - name: Autoremove unused apt packages
      apt:
        autoremove: yes

  handlers:
    - name: Reboot the system
      reboot:
      listen: "Notify reboot handler"

- name: Update all software (dnf)
  block:
    - name: Exclude certain packages during dnf update
      dnf:
        name: "*"
        state: latest
        exclude: "{{ dnf_excluded_packages }}"

  handlers:
    - name: Reboot the system
      reboot:
      listen: "Notify reboot handler"

- name: Update all software (pacman)
  block:
    - name: Update all pacman packages
      pacman:
        update_cache: yes
        upgrade: yes

  handlers:
    - name: Reboot the system
      reboot:
      listen: "Notify reboot handler"

- name: Configure yum
  block:
    - name: Check if yum-utils is installed
      yum:
        list: yum-utils
      register: yum_utils_installed

    - name: Install yum-utils if needed
      yum:
        name: yum-utils
      when: not yum_utils_installed.results | json_query('results[].yumname[?contains(name, "yum-utils")]') | length

    - name: Update all yum packages
      yum:
        name: "*"
        state: latest

  handlers:
    - name: Reboot the system
      reboot:
      listen: "Notify reboot handler"

- name: Update all software (zypper)
  block:
    - name: Update all zypper packages
      zypper:
        name: "*"
        state: latest

  handlers:
    - name: Reboot the system
      reboot:
      listen: "Notify reboot handler"


