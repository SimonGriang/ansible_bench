---
- name: Import assert.yml for validation purposes, only run once on localhost
  import_tasks: assert.yml
  when: inventory_hostname == "localhost"

- name: Install the Apache HTTPD server
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings
  selinux:
    policy: "{{ item.policy }}"
    state: "{{ item.state }}"
    persist: "{{ item.persist | default(omit) }}"
  loop: "{{ selinux_booleans }}"
  when: ansible_selinux.status == "enabled"

- name: Template the main httpd configuration file
  template:
    src: "{{ httpd_main_config_src }}"
    dest: "{{ httpd_main_config_dest }}"
  notify:
    - Test httpd configuration
    - Restart httpd service

- name: Activate Apache modules using a2enmod on Debian-based systems
  command: a2enmod "{{ item }}"
  args:
    creates: "/etc/apache2/mods-enabled/{{ item }}.load"
  loop: "{{ apache_modules }}"
  when: ansible_os_family == "Debian"
  notify:
    - Test httpd configuration
    - Restart httpd service

- name: Import SSL configuration tasks
  import_tasks: ssl.yml
  when: https_ssl_enabled

- name: Import locations configuration tasks
  import_tasks: locations.yml
  when: apache_locations is defined

- name: Import virtual hosts configuration tasks
  import_tasks: vhosts.yml
  when: apache_vhosts is defined

- name: Template the ports configuration file
  template:
    src: "{{ httpd_ports_config_src }}"
    dest: "{{ httpd_ports_config_dest }}"
  notify:
    - Test httpd configuration
    - Restart httpd service
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directories configuration tasks
  import_tasks: directories.yml
  when: apache_directories is defined

- name: Flush all handlers
  meta: flush_handlers

- name: Remove the default index.html file
  file:
    path: "/var/www/html/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable the Apache service
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


