content='```yaml\n---\n- name: gather_facts | Lookup bootstrap facts\n  ansible.builtin.include_vars:\n    file: /etc/os-release\n    name: os_release_facts\n\n- name: gather_facts | Set bootstrap facts (I)\n  set_fact:\n    distribution: "{{ os_release_facts[\'NAME\'] | lower }}"\n    major_version: "{{ os_release_facts[\'VERSION_ID\'] | regex_search(\'^(\\\\d+)\') | first }}"\n  loop: "{{ bootstrap_os_family_map }}"\n  loop_control:\n    loop_var: _os_family\n\n- name: gather_facts | Set bootstrap facts (II)\n  set_fact:\n    os_family: "{{ _os_family.value if distribution in _os_family.key.split(\',\') else \'unknown\' }}"\n  loop: "{{ bootstrap_os_family_map }}"\n  loop_control:\n    loop_var: _os_family\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-18T21:03:26.307268052Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2515182777, 'load_duration': 66099132, 'prompt_eval_count': 369, 'prompt_eval_duration': 44527377, 'eval_count': 178, 'eval_duration': 2402671480, 'model_name': 'phi4:14b'} id='run--bb5a6cb5-b16d-4f39-8885-f7a8b2d73e30-0' usage_metadata={'input_tokens': 369, 'output_tokens': 178, 'total_tokens': 547}
