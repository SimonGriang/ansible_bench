---
- name: Ensure the unzip package is available on the target system
  apt:
    name: unzip
    state: present
    update_cache: "{{ update_cache | default(false) }}"
  when: ansible_os_family == "Debian"
  tags:
    - install_unzip

- name: Ensure the unzip package is available on the target system
  yum:
    name: unzip
    state: present
    update_cache: "{{ update_cache | default(false) }}"
  when: ansible_os_family == "RedHat"
  tags:
    - install_unzip

- name: Create a system group for promtail
  group:
    name: promtail
    system: true
    state: present
    gid: "{{ promtail_group_id }}"
  tags:
    - create_promtail_group

- name: Create the promtail user
  user:
    name: promtail
    system: true
    group: promtail
    uid: "{{ promtail_user_id }}"
    createhome: false
    shell: /sbin/nologin
  tags:
    - create_promtail_user

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
  tags:
    - ensure_usr_local_bin

- name: Create config directories
  file:
    path: "{{ item }}"
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'
  loop:
    - /etc/promtail
    - /var/log/promtail
  tags:
    - create_config_dirs

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'
  loop:
    - /opt/promtail
  tags:
    - create_app_dirs

- name: Check if the promtail binary exists
  stat:
    path: /opt/promtail/bin/promtail
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_url }}"
    dest: /opt/promtail/bin/promtail
    mode: '0755'
  when: not promtail_binary.stat.exists and not promtail_local and not promtail_propagate
  tags:
    - download_promtail_binaries

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_archive }}"
    dest: /opt/promtail/promtail.tar.gz
    mode: '0755'
  when: not promtail_binary.stat.exists and promtail_local
  tags:
    - propagate_local_promtail_archive

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_url }}"
    dest: /opt/controller_node/promtail
    mode: '0755'
  when: not promtail_binary.stat.exists and promtail_propagate
  tags:
    - download_promtail_to_controller

- name: Propagate promtail binaries
  copy:
    src: /opt/controller_node/promtail
    dest: /opt/promtail/bin/promtail
    mode: '0755'
  when: not promtail_binary.stat.exists and promtail_propagate
  tags:
    - propagate_promtail_binaries

- name: Unpack promtail binaries
  unarchive:
    src: /opt/promtail/promtail.tar.gz
    dest: /opt/promtail
    remote_src: true
    mode: '0755'
    ignore_errors: yes
  when: not promtail_binary.stat.exists
  tags:
    - unpack_promtail_binaries

- name: Create symlink to latest version
  file:
    src: /opt/promtail/bin/promtail
    dest: /usr/local/bin/promtail
    state: link
    force: yes
  notify: restart promtail
  tags:
    - create_symlink

- name: Write configuration
  template:
    src: promtail.yml.j2
    dest: /etc/promtail/promtail.yml
    owner: promtail
    group: promtail
    mode: '0644'
  notify: restart promtail
  tags:
    - write_configuration

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: restart promtail
  tags:
    - create_systemd_service


