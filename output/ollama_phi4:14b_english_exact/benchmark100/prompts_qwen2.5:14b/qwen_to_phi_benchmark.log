- name: Remove externally managed from Debian 12
  ansible.builtin.shell: |
    dpkg-query -Wf '${Status}\n' | 
    grep -E '^install ok installed$' | 
    awk '{print $2}' | 
    while read pkg; do 
      if dpkg-query -W -f='${Conffiles}\n' "$pkg" | 
      grep -q '^/etc/'; then 
        dpkg-query -L "$pkg" | 
        grep -q '^/etc/'; then 
          dpkg-divert --rename --add /etc/"$pkg"/; 
      fi; 
    done
  when: 
    ansible_facts['os_family'] == "Debian" and 
    ansible_facts['distribution_major_version'] == "12"

- name: Ensure Pip is installed
  ansible.builtin.package:
    name: python3-pip
    state: present

- name: Ensure packaging is available via dnf
  ansible.builtin.dnf:
    name: python3-packaging
    state: present

