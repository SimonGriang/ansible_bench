ne_reason': 'stop', 'total_duration': 8210021284, 'load_duration': 55908044, 'prompt_eval_count': 635, 'prompt_eval_duration': 287395519, 'eval_count': 497, 'eval_duration': 7865275871, 'model_name': 'phi4:14b'} id='run--fc9f4bd7-793f-4356-81f1-d25e6670efe2-0' usage_metadata={'input_tokens': 635, 'output_tokens': 497, 'total_tokens': 1132}
