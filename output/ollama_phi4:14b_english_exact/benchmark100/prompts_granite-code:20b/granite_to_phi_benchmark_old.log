---
- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.service:
    name: rke2-server
    state: restarted
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  ansible.builtin.command:
    cmd: kubectl get nodes --no-headers | awk '/^{{ item }} / {print $2}' | grep -q "Ready$"
  loop: "{{ groups['all'] }}"
  register: node_ready
  until: >
    node_ready.results
    | map(attribute='rc')
    | select('equalto', 0)
    | list
    | length
    == groups['all'] | length
  retries: 10
  delay: 30

- name: Wait for all pods to be ready again
  ansible.builtin.command:
    cmd: >
      kubectl get pods --all-namespaces
      --field-selector=status.phase!=Running,status.phase!=Succeeded
      -o jsonpath='{.items[*].metadata.name}'
  register: pending_pods
  until: pending_pods.stdout == ""
  retries: 15
  delay: 20


