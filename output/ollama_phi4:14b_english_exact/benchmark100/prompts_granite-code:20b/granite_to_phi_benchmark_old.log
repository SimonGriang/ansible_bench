---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install python pip
  package:
    name: python-pip
    state: present

- name: Configure pip proxy
  ini_file:
    dest: /etc/pip.conf
    section: global
    option: proxy
    value: "{{ pip_proxy }}"

- name: Trust hosts
  ini_file:
    dest: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ pip_trusted_host }}"

- name: Update pip
  pip:
    name: pip
    state: latest

- name: Install requested modules
  pip:
    requirements: "{{ requirements_file }}"


