content='```yaml\n---\n- name: Ensure apt key is not present in trusted.gpg.d\n  apt_key:\n    keyserver: keyserver.ubuntu.com\n    id: YOUR_APT_KEY_ID\n    state: absent\n\n- name: Ensure old apt source list is not present in /etc/apt/sources.list.d\n  file:\n    path: /etc/apt/sources.list.d/old-apt-source-list\n    state: absent\n\n- name: Ensure old versions of Docker are not installed.\n  package:\n    name: "{{ item }}"\n    state: absent\n  loop:\n    - docker-ce\n    - docker-ce-cli\n    - containerd.io\n  when: ansible_os_family == \'Debian\'\n\n- name: Ensure legacy repo file is not present.\n  file:\n    path: /etc/apt/sources.list.d/legacy-repo.list\n    state: absent\n\n- name: Ensure dependencies are installed.\n  package:\n    name: "{{ item }}"\n    state: present\n  loop:\n    - apt-transport-https\n    - ca-certificates\n    - curl\n    - software-properties-common\n\n- name: Add or remove Docker repository.\n  apt_repository:\n    repo: \'deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} stable\'\n    state: "{{ docker_repo_state }}"\n    filename: docker-ce\n\n- name: Ensure handlers are notified immediately to update the apt cache.\n  meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-12T20:08:00.784676942Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4967397607, 'load_duration': 59260797, 'prompt_eval_count': 446, 'prompt_eval_duration': 46465473, 'eval_count': 306, 'eval_duration': 4860520060, 'model_name': 'phi4:14b'} id='run--ef4ef2e7-8877-43ed-b1f3-1a6e0b8f08cb-0' usage_metadata={'input_tokens': 446, 'output_tokens': 306, 'total_tokens': 752}
