---
- name: Ensure apt key is not present in trusted.gpg.d
  ansible.builtin.apt_key:
    keyserver: keyserver.ubuntu.com
    id: YOUR_APT_KEY_ID
    state: absent

- name: Ensure old apt source list is not present in /etc/apt/sources.list.d
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/old-apt-source-list
    state: absent

- name: Ensure old versions of Docker are not installed.
  ansible.builtin.package:
    name: "{{ item }}"
    state: absent
  loop:
    - docker-ce
    - docker-ce-cli
    - containerd.io
  when: ansible_os_family == 'Debian'

- name: Ensure legacy repo file is not present.
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/legacy-repo.list
    state: absent

- name: Ensure dependencies are installed.
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop:
    - apt-transport-https
    - ca-certificates
    - curl
    - software-properties-common

- name: Add or remove Docker repository.
  ansible.builtin.apt_repository:
    repo: >-
      deb [arch=amd64]
      https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }}
      stable
    state: "{{ docker_repo_state | lower }}"
    filename: docker-ce

- name: Ensure handlers are notified immediately to update the apt cache.
  ansible.builtin.meta:
    flush_handlers: yes


