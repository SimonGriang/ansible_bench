---
- name: Ensure unzip package is available
  ansible.builtin.package:
    name: unzip
    state: present

- name: Create promtail group
  ansible.builtin.group:
    name: promtail
    state: present

- name: Create the promtail user
  ansible.builtin.user:
    name: promtail
    group: promtail
    system: yes
    create_home: no

- name: Ensure /usr/local/bin exists
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /etc/promtail
    - /var/log/promtail

- name: Create application dirs
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /opt/promtail
    - /var/lib/promtail

- name: Check promtail binary
  ansible.builtin.stat:
    path: /usr/local/bin/promtail

- name: Download promtail binaries
  ansible.builtin.get_url:
    url: https://github.com/grafana/promtail/releases/download/v2.7.4/promtail-linux-amd64.zip
    dest: /tmp/promtail.zip
    mode: '0644'

- name: Propagate locally distributed promtail archive
  ansible.builtin.copy:
    src: /tmp/promtail.zip
    dest: /opt/promtail/promtail.zip
    mode: '0644'

- name: Download promtail binaries to controller node
  ansible.builtin.get_url:
    url: https://github.com/grafana/promtail/releases/download/v2.7.4/promtail-linux-amd64.zip
    dest: /tmp/promtail.zip
    mode: '0644'

- name: Propagate promtail binaries
  ansible.builtin.copy:
    src: /tmp/promtail.zip
    dest: /opt/promtail/promtail.zip
    mode: '0644'

- name: Unpack promtail binaries
  ansible.builtin.unarchive:
    src: /opt/promtail/promtail.zip
    dest: /opt/promtail
    remote_src: yes
    creates: /opt/promtail/promtail-linux-amd64

- name: Create symlink to latest version
  ansible.builtin.file:
    src: /opt/promtail/promtail-linux-amd64
    dest: /usr/local/bin/promtail
    state: link

- name: Write config
  ansible.builtin.template:
    src: promtail-config.yaml.j2
    dest: /etc/promtail/config.yaml
    mode: '0644'

- name: Create systemd service unit
  ansible.builtin.template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'


