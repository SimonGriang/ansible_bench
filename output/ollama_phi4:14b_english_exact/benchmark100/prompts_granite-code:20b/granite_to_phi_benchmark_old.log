---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Ensure that logrotate is installed
  ansible.builtin.package:
    name: logrotate
    state: present

- name: Template /etc/logrotate.conf using the template
  ansible.builtin.template:
    src: logrotate.conf.j2
    dest: /etc/logrotate.conf
    owner: root
    group: root
    mode: '0644'

- name: Template /etc/logrotate.d/{{ item.name }} using the template
  ansible.builtin.template:
    src: logrotate.d.j2
    dest: "/etc/logrotate.d/{{ item.name }}"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ logrotate_configs }}"

- name: Remove /etc/logrotate.d/{{ item.name }}
  ansible.builtin.file:
    path: "/etc/logrotate.d/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_configs }}"

- name: Start the logrotate service
  ansible.builtin.service:
    name: logrotate
    state: started
    enabled: yes


