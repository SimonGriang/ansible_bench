    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'

- name: Start and enable nginx
  ansible.builtin.service:
    name: nginx
    state: started
    enabled: yes

handlers:
  - name: validate nginx configuration
    ansible.builtin.command:
      argv:
        - nginx
        - -t
        - -c
        - /etc/nginx/nginx.conf
    register: result
    failed_when: result.rc != 0
    changed_when: false


