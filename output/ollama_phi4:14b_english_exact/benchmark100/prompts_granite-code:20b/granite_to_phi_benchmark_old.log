    create_home: no

- name: Create directory /opt/vault
  file:
    path: /opt/vault
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Download Vault binary
  get_url:
    url: https://releases.hashicorp.com/vault/<version>/vault_<version>_linux_amd64.zip
    dest: /opt/vault/vault.zip
  register: download

- name: Extract Vault binary
  unarchive:
    src: /opt/vault/vault.zip
    dest: /opt/vault
    remote_src: true
    creates: /opt/vault/vault
  when: download is changed

- name: Create directory /etc/vault.d
  file:
    path: /etc/vault.d
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy Vault binary
  copy:
    src: /opt/vault/vault
    dest: /usr/local/bin/vault
    owner: root
    group: root
    mode: '0755'

- name: Set cap_ipc_lock=ep on /usr/local/bin/vault
  capability:
    path: /usr/local/bin/vault
    capabilities: cap_ipc_lock=ep

- name: Create file /etc/vault.d/vault.env
  copy:
