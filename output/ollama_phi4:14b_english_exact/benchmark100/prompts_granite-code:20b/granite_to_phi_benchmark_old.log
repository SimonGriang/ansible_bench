---
- name: Create the RKE2 config directory /etc/rancher/rke2
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  ansible.builtin.k8s:
    definition:
      apiVersion: v1
      kind: Node
      metadata:
        name: "{{ inventory_hostname }}"
        annotations:
          node-taints: "{{ rke2_server_node_taints | join(',') }}"
  when: rke2_server_node_taints is defined

- name: Copy rke2 config
  ansible.builtin.copy:
    src: "{{ rke2_config_source }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'

- name: Copy kubelet config
  ansible.builtin.copy:
    src: "{{ rke2_kubelet_config_source }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  when: rke2_kubelet_config is defined and rke2_kubelet_config != ""

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ rke2_containerd_registries_source }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  when: (rke2_custom_registry_mirrors is defined and rke2_custom_registry_mirrors != "") or 
        (rke2_custom_registry_configs is defined and rke2_custom_registry_configs != "")

- name: Register if we need to do an etcd restore from file
  ansible.builtin.set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and 
                        ansible_service_mgr == 'systemd' and 
                        not ansible_facts.services['rke2-server.service'].state == 'running' }}"

- name: Register if we need to do an etcd restore from s3
  ansible.builtin.set_fact:
    do_etcd_restore_from_s3: >-
      {{ rke2_etcd_snapshot_s3_options.access_key is defined and 
         rke2_etcd_snapshot_s3_options.secret_key is defined and 
         rke2_etcd_snapshot_s3_options.bucket is defined and 
         rke2_etcd_snapshot_s3_options.snapshot_name is defined }}

- name: Restore etcd from file
  block:
    - ansible.builtin.file:
        path: /var/lib/rancher/rke2/etcd-snapshots
        state: directory
        mode: '0700'

    - ansible.builtin.copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/etcd-snapshots/snapshot.db
        owner: root
        group: root
        mode: '0600'

    - ansible.builtin.command:
        cmd: "rke2 server --snapshot-restore /var/lib/rancher/rke2/etcd-snapshots/snapshot.db"
  when: do_etcd_restore

- name: Restore etcd from s3
  ansible.builtin.command:
    cmd: >
      rke2 server --snapshot-restore-s3 
      {{ rke2_etcd_snapshot_s3_options.access_key }} 
      {{ rke2_etcd_snapshot_s3_options.secret_key }} 
      {{ rke2_etcd_snapshot_s3_options.bucket }} 
      {{ rke2_etcd_snapshot_s3_options.snapshot_name }}
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  ansible.builtin.service:
    name: rke2-server
    state: started
    enabled: true

- name: Mask RKE2 agent service on the first server
  ansible.builtin.systemd:
    name: rke2-agent
    masked: true

- name: Wait for the first server to be ready - no CNI
  ansible.builtin.wait_for:
    timeout: 300
    sleep: 10
    state: started
    args:
      - "free -m | awk '/Mem:/ {exit ($2 < 2048)}'"
      - "df --output=avail / | awk '{exit ($1 < 5000000)}'"
      - "ps -o rss= | awk '{exit ($1 > 1000)}'"
  when: rke2_disable_cni

- name: Wait for the first server to be ready - with CNI
  ansible.builtin.wait_for:
    timeout: 300
    sleep: 10
    state: started
    args:
      - "kubectl get nodes {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type==\"Ready\")].status}' | grep -q 'True'"
  when: not rke2_disable_cni

- name: Restore etcd
  block:
    - ansible.builtin.command:
        cmd: "rke2 server --remove-node --node-id {{ inventory_hostname }}"
    - ansible.builtin.command:
        cmd: "rke2 server --remove-secrets --node-id {{ inventory_hostname }}"
  when: do_etcd_restore or do_etcd_restore_from_s3

- name: Set an Active Server variable
  ansible.builtin.set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ groups[rke2_cluster_group_name] | first }}"
  delegate_facts: true


