---
- name: Create the RKE2 config dir for server or agent nodes
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints if the node is a server
  command: >
    rke2 server
  when: node_role == 'server'

- name: Set agent taints if the node is an agent
  command: >
    rke2 agent
  when: node_role == 'agent'

- name: Copy the RKE2 config file
  copy:
    src: /path/to/source/rke2/config.yaml
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'

- name: Copy the kubelet config file if it is present
  copy:
    src: /path/to/source/kubelet/config.yaml
    dest: /var/lib/kubelet/config.yaml
    owner: root
    group: root
    mode: '0644'
  when: kubelet_config_present

- name: Copy the Containerd Registry Configuration file if the custom registry is used
  copy:
    src: /path/to/source/registries.yaml
    dest: /etc/containerd/registries.yaml
    owner: root
    group: root
    mode: '0644'
  when: custom_registry_used

- name: Start the RKE2 service on the remaining nodes
  service:
    name: rke2
    state: started

- name: Mask other RKE2 services on the remaining nodes
  service:
    name: rke2-*
    enabled: false

- name: Wait for the remaining nodes to be ready if no CNI is used
  command: >
    rke2 status --no-cni
  when: not cni_used

- name: Wait for the remaining nodes to be ready if CNI is used
  command: >
    rke2 status
  when: cni_used


