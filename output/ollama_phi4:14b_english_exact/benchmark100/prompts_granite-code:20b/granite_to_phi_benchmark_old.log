---
- name: Install fail2ban
  ansible.builtin.package:
    name: fail2ban
    state: present

- name: Copy filters in filter.d
  ansible.builtin.copy:
    src: "{{ src_path }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: '0640'

- name: Configure fail2ban.local
  community.general.ini_file:
    path: /etc/fail2ban/fail2ban.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
  loop: "{{ fail2ban_local_config }}"
  notify: Restart fail2ban

- name: Configure jail.local
  community.general.ini_file:
    path: /etc/fail2ban/jail.local
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
  loop: "{{ jail_local_config }}"
  notify: Restart fail2ban

- name: Stat auth log file
  ansible.builtin.stat:
    path: "{{ auth_log_file }}"
  register: auth_log_stat

- name: Touch auth log file
  ansible.builtin.file:
    path: "{{ auth_log_file }}"
    state: touch
    owner: "{{ auth_log_owner }}"
    group: "{{ auth_log_group }}"
    mode: '0640'
  when: not auth_log_stat.stat.exists

- name: Start and enable fail2ban
  ansible.builtin.service:
    name: fail2ban
    state: started
    enabled: true

handlers:
  - name: Restart fail2ban
    ansible.builtin.service:
      name: fail2ban
      state: restarted


