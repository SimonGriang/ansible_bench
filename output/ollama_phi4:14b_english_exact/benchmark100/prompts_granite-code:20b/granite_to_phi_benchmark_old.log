---
- name: Disable swap
  ansible.builtin.command: swapoff -a
  when: ansible_facts.swapspace_info is defined and ansible_facts.swapspace_info.total_mb > 0

- name: Permanently disable swap
  ansible.builtin.lineinfile:
    path: /etc/fstab
    regexp: '^/dev/mapper/.+ swap'
    line: '#{{ item }}'
    state: absent
  loop: "{{ ansible_facts.files_lines['/etc/fstab'] }}"
  when: "'swap' in item"

- name: Disable core dumps
  ansible.builtin.copy:
    dest: /etc/sysctl.d/10-disable-core-dumps.conf
    content: |
      fs.suid_dumpable = 0
      kern.core_pattern = /dev/null
    mode: '0644'
  notify: reload sysctl

- name: Reload sysctl
  ansible.builtin.command: sysctl --system
  when: 
    - fstab_changes is defined and fstab_changes.changed
    - ansible_facts.sysctl | selectattr('filename', 'equalto', '/etc/sysctl.d/10-disable-core-dumps.conf') | list | count > 0

- name: Disable Shell Command History
  ansible.builtin.lineinfile:
    path: /etc/profile
    line: 'unset HISTFILE'
    state: present


