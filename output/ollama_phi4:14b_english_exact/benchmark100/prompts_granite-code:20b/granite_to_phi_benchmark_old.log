---
- name: Check if certificates exist
  stat:
    path: "{{ item }}"
  loop: "{{ certificates }}"
  register: cert_stat

- name: Fail if some cert doesn't exist
  fail:
    msg: "Certificate '{{ item.path }}' does not exist."
  loop: "{{ cert_stat.results }}"
  when: not item.stat.exists

- name: Setting keystore variables in java < 11
  set_fact:
    keytool_command: "keytool -importcert -alias {{ item.alias }} -file {{ item.file }} -keystore {{ keystore_path }}"
  when: java_version is version('11', '<')

- name: Setting keystore variables in java >= 11
  set_fact:
    keytool_command: "keytool --import-cert --alias {{ item.alias }} --file {{ item.file }} --keystore {{ keystore_path }}"
  when: java_version is version('11', '>=')

- name: Import SSL certificates
  java_cert:
    keystore: "{{ keystore_path }}"
    alias: "{{ item.alias }}"
    cert: "{{ item.file }}"
  loop: "{{ certificates }}"


