---
- name: lookup bootstrap facts
  ansible.builtin.command:
    cmd: cat /etc/os-release
  register: os_release_output

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    "{{ item.key }}": "{{ item.value }}"
  loop: "{{ os_release_output.stdout | from_json | dict2items }}"
  vars:
    os_info:
      ID: bootstrap_distribution
      VERSION_ID: bootstrap_distribution_major_version

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ os_family }}"
  vars:
    os_family_map:
      Ubuntu: Debian
      Debian: Debian
      RedHat: RedHat
      CentOS: RedHat
      Fedora: RedHat
      Amazon: RedHat
  loop: "{{ os_release_output.stdout | from_json | dict2items }}"
  loop_control:
    loop_var: os_item
  when: os_item.key == 'ID'


