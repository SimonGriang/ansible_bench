---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install cron
  package:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/csh.cshrc
    line: 'setenv EDITOR vi'

- name: Configure path
  lineinfile:
    path: /etc/csh.cshrc
    line: 'set path = ( "/usr/local/bin" "/usr/bin" "/bin" )'

- name: Configure mailto
  lineinfile:
    path: /etc/crontab
    line: 'MAILTO=root'

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: yes

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    user: "{{ item.user }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"


