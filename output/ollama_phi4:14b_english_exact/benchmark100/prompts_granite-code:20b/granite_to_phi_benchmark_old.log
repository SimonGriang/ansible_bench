content='```yaml\n---\n- name: lookup bootstrap facts (raw)\n  command: >-\n    # Command to gather bootstrap facts would be here.\n    echo "dummy_command_output"  # Replace with actual command to gather facts\n  register: bootstrap_facts\n  ignore_errors: true\n\n- name: set bootstrap facts (I) # noqa jinja\n  set_fact:\n    bootstrap_distribution: "{{ item.value.distribution }}"\n    bootstrap_distribution_major_version: "{{ item.value.distribution_major_version }}"\n  loop: "{{ bootstrap__os_family_map | dict2items }}"\n  loop_control:\n    label: "{{ item.key }}"\n  when:\n    - bootstrap_facts.stdout | search(item.key) is defined\n    - bootstrap_facts.stdout | search(item.key) is not none\n\n- name: set bootstrap facts (II)\n  set_fact:\n    bootstrap_os_family: "{{ item.key }}"\n  loop: "{{ bootstrap__os_family_map | dict2items }}"\n  loop_control:\n    label: "{{ item.key }}"\n  when:\n    - bootstrap_facts.stdout | search(item.key) is defined\n    - bootstrap_facts.stdout | search(item.key) is not none\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-12T20:15:50.576657535Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3319179968, 'load_duration': 68555260, 'prompt_eval_count': 739, 'prompt_eval_duration': 6560061, 'eval_count': 239, 'eval_duration': 3242774006, 'model_name': 'phi4:14b'} id='run--fa3739cd-199e-4070-8da4-704e3f381469-0' usage_metadata={'input_tokens': 739, 'output_tokens': 239, 'total_tokens': 978}
