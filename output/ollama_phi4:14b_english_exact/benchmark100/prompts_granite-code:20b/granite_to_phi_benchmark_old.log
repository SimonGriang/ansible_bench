---
- name: Install mysql
  ansible.builtin.package:
    name: mysql-server
    state: present

- name: Configure mysql server
  ansible.builtin.template:
    src: server.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: '0644'

- name: Configure mysql client
  ansible.builtin.template:
    src: client.cnf.j2
    dest: /etc/mysql/client.cnf
    owner: root
    group: root
    mode: '0644'

- name: Initialize mysql
  ansible.builtin.command:
    cmd: mysql_install_db --user=mysql --basedir=/usr --datadir=/var/lib/mysql

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.copy:
    src: my.cnf
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: '0644'

- name: Create databases
  ansible.builtin.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop:
    - { name: db1 }
    - { name: db2 }

- name: List databases
  ansible.builtin.shell: mysql -e "SHOW DATABASES;"
  register: databases_output

- name: Import database
  ansible.builtin.mysql_db:
    name: my_database
    state: import
    target: /path/to/sqlfile.sql

- name: Create users
  ansible.builtin.mysql_user:
    name: my_user
    password: my_password
    priv: 'my_database.*:ALL,GRANT'
    state: present

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


