    group: root
    mode: '0644'
    vars:
      configuration_name: "{{ mysql_name }}"
      configuration_options: "{{ mysql_configuration_options }}"
      socket: "{{ mysql_socket }}"
  notify: restart mysql

- name: Configure mysql client
  ansible.builtin.template:
    src: "mysql_client.j2"
    dest: "{{ mysql_configuration_destination }}"
    owner: root
    group: root
    mode: '0644'
    vars:
      configuration_name: "{{ mysql_name }}"
      socket: "{{ mysql_socket }}"
  notify: restart mysql

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/.mysql_initialized

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: yes

- name: Place my.cnf
  ansible.builtin.template:
    src: "my.cnf.j2"
    dest: "/root/.my.cnf"
    owner: root
    group: root
    mode: '0600'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('') }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: yes


