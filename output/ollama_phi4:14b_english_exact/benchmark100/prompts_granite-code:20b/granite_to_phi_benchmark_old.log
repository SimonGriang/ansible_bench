---
- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ users_ssh_key_directory }}"
    state: directory
    mode: '0750'

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    # Add additional attributes as required

- name: Set sudo options for {{ user.name }}
  template:
    src: "sudoers.d.j2"
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: '0440'
  when: sudo_options is defined

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  command: "{{ ssh_keygen_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}_id_rsa"
    chdir: "{{ users_ssh_key_directory }}"

- name: Generate public ssh key for {{ user.name }}
  command: "{{ ssh_keygen_pubkey_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}_id_rsa.pub"
    chdir: "{{ users_ssh_key_directory }}"

- name: Convert ssh key to ppk for {{ user.name }}
  command: "{{ ssh_keygen_pubkey_command }} -o -t dsa -f {{ users_ssh_key_directory }}/{{ user.name }}_id_rsa -P '' -m conv -o {{ users_ssh_key_directory }}/{{ user.name }}_id_rsa.ppk"

- name: Get or set the home directory for {{ user.name }}
  command: getent passwd {{ user.name }}
  register: user_info
  changed_when: false
  check_mode: false

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user.home if user_info.stdout is defined else '/home/' + user.name }}/.ssh"
    state: directory
    mode: '0700'
  when: user_info.stdout is defined

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ item }}"
  with_items: "{{ authorized_keys }}"

- name: Remove unauthorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item }}"
  with_items: "{{ unauthorized_keys }}"

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}_id_rsa"
    dest: "{{ private_key_destination }}"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
    mode: '0600'

- name: Check users password valid time for {{ user.name }}
  command: chage -l {{ user.name }}
  register: password_info
  changed_when: false

- name: Set users password valid time for {{ user.name }}
  command: chage -m {{ min_days }} -M {{ max_days }} -W {{ warn_days }} {{ user.name }}

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ private_key_file }}"
    dest: "{{ user.home }}/.ssh/id_rsa"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
    mode: '0600'


