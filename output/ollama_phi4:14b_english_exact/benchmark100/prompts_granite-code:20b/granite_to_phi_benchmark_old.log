- name: Cordon and Drain the node
  command: >
    kubectl cordon {{ rke2_node_name }} &&
    kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-local-data
  when: rke2_drain_node_during_upgrade | default(true) | bool
  ignore_errors: true

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2-server
    state: restarted

- name: Wait for all nodes to be ready again
  shell: >
    kubectl get nodes --output=jsonpath='{.items[?(@.status.conditions[?(@.type=="Ready")].status=="True")].metadata.name}' |
    grep -q {{ rke2_node_name }}
  register: node_ready
  until: node_ready.rc == 0
  retries: 30
  delay: 10

- name: Uncordon the node
  command: kubectl uncordon {{ rke2_node_name }}
  when: rke2_drain_node_during_upgrade | default(true) | bool
  ignore_errors: true

- name: Wait for all pods to be ready again
  shell: kubectl get pods --all-namespaces --field-selector=status.phase!=Running --output=name | wc -l
  register: pending_pods
  until: pending_pods.stdout == "0"
  retries: 30
  delay: 10
  when: rke2_wait_for_all_pods_to_be_ready | default(true) | bool

- name: Wait for all pods to pass readiness checks
  shell: kubectl get pods --all-namespaces --field-selector=status.conditions[?(@.type=="Ready")].status!=True --output=name | wc -l
  register: unhealthy_pods
  until: unhealthy_pods.stdout == "0"
  retries: 30
  delay: 10
  when: rke2_wait_for_all_pods_to_be_healthy | default(true) | bool


