---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  template:
    src: "mysql_server.j2"
    dest: "{{ mysql_configuration_destination }}"
    owner: root
    group: root
    mode: '0644'
  notify: restart mysql
  vars:
    name: "{{ mysql_name }}"
    options: "{{ mysql_configuration_options }}"
    socket: "{{ mysql_socket }}"

- name: Configure mysql client
  template:
    src: "mysql_client.j2"
    dest: "{{ mysql_configuration_destination }}"
    owner: root
    group: root
    mode: '0644'
  notify: restart mysql
  vars:
    name: "{{ mysql_name }}"
    socket: "{{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: /var/lib/mysql/.mysql_initialized

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: "my.cnf.j2"
    dest: "/root/.my.cnf"
    owner: root
    group: root
    mode: '0600'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('') }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


