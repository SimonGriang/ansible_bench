  loop: "{{ rke2_artifacts }}"
  when: 
    - airgap_mode_enabled | bool
    - airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images tarballs folder
      ansible.builtin.file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: '0700'
      when: 
        - airgap_mode_enabled | bool
        - additional_tarball_images | length > 0

    - name: Copy additional tarball images RKE2 components
      ansible.builtin.copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"
        mode: '0644'
        force: yes
      loop: "{{ additional_tarball_images }}"
      when: 
        - airgap_mode_enabled | bool
        - additional_tarball_images | length > 0

- name: Airgap mode - ensure artifacts exist and have acceptable permissions # only modifies permissions if they are overprivileged
  block:
    - name: Register artifacts
      ansible.builtin.stat:
        path: "{{ rke2_artifact_path }}/{{ item }}"
      loop: "{{ rke2_artifacts }}"
      register: artifact_files
      when: 
        - airgap_mode_enabled | bool
        - airgap_implementation == "exists"

    - name: Make artifacts read-only if writeable
      ansible.builtin.file:
        path: "{{ rke2_artifact_path }}/{{ item.item }}"
        mode: '0640'
      loop: "{{ artifact_files.results }}"
      when: 
        - item.stat.isreg
        - item.stat.writable
        - airgap_mode_enabled | bool
        - airgap_implementation == "exists"

    - name: Make install script executable if writeable and not executable
      ansible.builtin.file:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: '0700'
      when: 
        - (artifact_files.results | selectattr('path', 'equalto', "{{ rke2_install_script_dir }}/rke2.sh") | map(attribute='stat') | selectattr('writable', 'equalto', True) | selectattr('mode', 'match', '^0*?.*?w.*') | list | length > 0)
        - (artifact_files.results | selectattr('path', 'equalto', "{{ rke2_install_script_dir }}/rke2.sh") | map(attribute='stat') | selectattr('mode', 'match', '^0*?x.*') | list | length == 0)
        - airgap_mode_enabled | bool
        - airgap_implementation == "exists"

    - name: Fail if install script is not executable
      ansible.builtin.fail:
        msg: "Install script is not executable"
      when: 
        - (artifact_files.results | selectattr('path', 'equalto', "{{ rke2_install_script_dir }}/rke2.sh") | map(attribute='stat') | selectattr('mode', 'match', '^0*?x.*') | list | length == 0)
        - airgap_mode_enabled | bool
        - airgap_implementation == "exists"

- name: Populate service facts
  ansible.builtin.command: systemctl list-unit-files --type=service --state=enabled
  register: service_facts
  changed_when: false

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local
  register: fs_stats

- name: Check if separate partition
  ansible.builtin.debug:
    msg: "The partition is separate."
  when: fs_stats.stat.pw_name != fs_stats.stat.bdev

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: "/usr/local/bin"
  when: fs_stats.stat.pw_name == fs_stats.stat.bdev

- name: Check RKE2 version
  ansible.builtin.command: rke2 version
  register: rke2_version_output
  changed_when: false

- name: Check installed and running versions
  ansible.builtin.command: rke2 status --short
  register: rke2_status_output
  changed_when: false

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - rke2_version_output.stdout is version(rke2_version, operator='ge')

- name: Run RKE2 install script
  ansible.builtin.shell: |
    bash {{ rke2_install_script_dir }}/rke2.sh
    {% if airgap_mode_enabled %}
      --airgap --airgap-images {{ rke2_tarball_images_path }} --airgap-curl-command curl --airgap-curl-options "{{ airgap_curl_options }}"
    {% endif %}
  args:
    executable: /bin/bash

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ custom_manifests }}"

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/"
    owner: root
    group: root
    mode: '0644'
  loop: "{{ static_pods }}"

- name: Copy RKE2 environment file
  ansible.builtin.template:
    src: rke2_environment.j2
    dest: /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: '0644'


