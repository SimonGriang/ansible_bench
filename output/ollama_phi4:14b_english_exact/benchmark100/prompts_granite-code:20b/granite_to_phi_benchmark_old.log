---
- name: Install ssl packages
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - openssl
    - ssl-cert
  become: yes

- name: Place configuration
  copy:
    src: ssl.conf
    dest: /etc/nginx/conf.d/ssl.conf
    owner: root
    group: root
    mode: '0644'
  become: yes

- name: Configure redirect from http to https
  lineinfile:
    path: /etc/nginx/sites-available/default
    regexp: '^    listen 80'
    line: '    listen 80;\n    return 301 https://$host$request_uri;'
    insertafter: '^    server_name'
  become: yes


