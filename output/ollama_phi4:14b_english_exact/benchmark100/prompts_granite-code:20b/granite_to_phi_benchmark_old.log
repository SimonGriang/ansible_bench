content='```yaml\n---\n- name: Check if certificates exist\n  stat:\n    path: "{{ item }}"\n  loop: "{{ certificates }}"\n  register: cert_stat\n\n- name: Fail if some cert doesn\'t exist\n  fail:\n    msg: "Certificate \'{{ item.path }}\' does not exist."\n  loop: "{{ cert_stat.results }}"\n  when: not item.stat.exists\n\n- name: Setting keystore variables in java < 11\n  set_fact:\n    keytool_command: "keytool -importcert -alias {{ item.alias }} -file {{ item.file }} -keystore {{ keystore_path }}"\n  when: java_version is version(\'11\', \'<\')\n\n- name: Setting keystore variables in java >= 11\n  set_fact:\n    keytool_command: "keytool --import-cert --alias {{ item.alias }} --file {{ item.file }} --keystore {{ keystore_path }}"\n  when: java_version is version(\'11\', \'>=\')\n\n- name: Import SSL certificates\n  java_cert:\n    keystore: "{{ keystore_path }}"\n    alias: "{{ item.alias }}"\n    cert: "{{ item.file }}"\n  loop: "{{ certificates }}"\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-12T20:50:37.766445486Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4137253700, 'load_duration': 53349955, 'prompt_eval_count': 344, 'prompt_eval_duration': 40235377, 'eval_count': 240, 'eval_duration': 4042005308, 'model_name': 'phi4:14b'} id='run--c033ec73-2952-4218-9ef7-49bf6823e6c6-0' usage_metadata={'input_tokens': 344, 'output_tokens': 240, 'total_tokens': 584}
