---
- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: /etc/rancher/rke2/manifests
    state: directory
    mode: '0755'  # Set appropriate permissions

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    src: kube-vip/
    dest: /etc/rancher/rke2/
    mode: '0644'  # Set appropriate permissions

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    src: kube-vip-load-balancer/
    dest: /etc/rancher/rke2/
    mode: '0644'  # Set appropriate permissions
  when: rke2_kubevip_cloud_provider_enable | default(false)


