---
- name: Install Keepalived when HA mode is enabled
  apt:
    name: keepalived
    state: present
  when: ha_mode_enabled | bool

- name: Download and install RKE2 {{ rke2_version }}
  block:
    - name: Download RKE2
      get_url:
        url: "https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2-server-{{ rke2_version }}.linux-amd64.tar.gz"
        dest: "/tmp/rke2-server-{{ rke2_version }}.linux-amd64.tar.gz"

    - name: Install RKE2
      unarchive:
        src: "/tmp/rke2-server-{{ rke2_version }}.linux-amd64.tar.gz"
        dest: "/usr/local/bin"
        remote_src: yes
        creates: "/usr/local/bin/rke2-server"

- name: CIS Hardening
  include_role:
    name: cis_hardening

- name: Find Active Server
  shell: >
    rke2 server --node-name {{ inventory_hostname }} --write-kubeconfig-mode 644
    --kubeconfig /etc/rancher/rke2/rke2.yaml
  register: active_server
  changed_when: false

- name: Enable IPVS kernel module
  modprobe:
    name: ip_vs
    state: present

- name: Copy kube-vip manifests to the masternode
  copy:
    src: kube-vip-manifest.yml
    dest: "/etc/kubernetes/manifests/kube-vip-manifest.yml"

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: ingress-nginx-manifest.yml
    dest: "/etc/kubernetes/manifests/ingress-nginx-manifest.yml"

- name: Prepare very first server node in the cluster
  include_tasks: prepare_first_server_node.yml

- name: Restore etcd specific tasks
  include_tasks: restore_etcd.yml
  when: restore_options is defined

- name: Download kubeconfig to ansible localhost
  fetch:
    src: "/etc/rancher/rke2/rke2.yaml"
    dest: "./rke2-{{ inventory_hostname }}.yaml"

- name: Prepare and join remaining nodes of the cluster
  include_tasks: prepare_join_remaining_nodes.yml
  when: inventory_hostname != groups['cluster_first'][0]

- name: Rolling cordon and drain restart when version changes - servers
  include_tasks: rolling_restart_servers.yml
  when: version_changed | bool

- name: Rolling cordon and drain restart when version changes - agents
  include_tasks: rolling_restart_agents.yml
  when: version_changed | bool

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  include_tasks: rolling_restart_config_change.yml
  when: config_files_changed | bool

- name: Final steps
  include_tasks: final_steps.yml


