content='```yaml\n---\n- name: Import assert.yml\n  include_tasks: assert.yml\n\n- name: Install required packages\n  package:\n    name: "{{ item }}"\n    state: present\n  loop: "{{ required_packages }}"\n\n- name: Set GRUB_TIMEOUT\n  lineinfile:\n    path: /etc/default/grub\n    regexp: \'^GRUB_TIMEOUT=\'\n    line: \'GRUB_TIMEOUT={{ grub_timeout }}\'\n    state: present\n\n- name: Set GRUB_RECORDFAIL_TIMEOUT\n  lineinfile:\n    path: /etc/default/grub\n    regexp: \'^GRUB_RECORDFAIL_TIMEOUT=\'\n    line: \'GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}\'\n    state: present\n\n- name: Add options to GRUB_CMDLINE_LINUX\n  replace:\n    path: /etc/default/grub\n    regexp: \'^GRUB_CMDLINE_LINUX="(.*)"$\'\n    replace: \'GRUB_CMDLINE_LINUX="\\1 {{ grub_cmdline_linux_options }}"\'\n    backup: yes\n\n- name: Import password.yml\n  include_tasks: password.yml\n  when: grub_set_password | bool is defined and grub_set_password\n\n- name: Flush handlers\n  meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-12T20:05:33.077597636Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4183971770, 'load_duration': 55133709, 'prompt_eval_count': 751, 'prompt_eval_duration': 20395651, 'eval_count': 254, 'eval_duration': 4107561612, 'model_name': 'phi4:14b'} id='run--ad42c346-5219-4973-a598-e0c37829de6a-0' usage_metadata={'input_tokens': 751, 'output_tokens': 254, 'total_tokens': 1005}
