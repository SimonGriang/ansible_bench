  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize PKI of easyrsa
  shell: easyrsa init-pki

- name: Build CA for easyrsa
  shell: easyrsa build-ca

- name: Generate DH parameters
  shell: easyrsa gen-dh

- name: Build server key and certificate
  shell: easyrsa build-server-full server nopass

- name: Build client key and certificate
  shell: easyrsa build-client-full client nopass

- name: Generate certificate revocation list
  shell: easyrsa gen-crl

- name: Generate openvpn key
  shell: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to /etc/openvpn/server
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
  loop:
    - { src: '/etc/openvpn/easy-rsa/pki/ca.crt', dest: '/etc/openvpn/server/ca.crt', mode: '0644' }
    - { src: '/etc/openvpn/easy-rsa/pki/dh.pem', dest: '/etc/openvpn/server/dh.pem', mode: '0644' }
    - { src: '/etc/openvpn/easy-rsa/pki/ta.key', dest: '/etc/openvpn/server/ta.key', mode: '0600' }
    - { src: '/etc/openvpn/easy-rsa/pki/issued/client.crt', dest: '/etc/openvpn/server/issued/client.crt', mode: '0644' }
    - { src: '/etc/openvpn/easy-rsa/pki/issued/server.crt', dest: '/etc/openvpn/server/issued/server.crt', mode: '0644' }
    - { src: '/etc/openvpn/easy-rsa/pki/private/ca.key', dest: '/etc/openvpn/server/private/ca.key', mode: '0600' }
    - { src: '/etc/openvpn/easy-rsa/pki/private/client.key', dest: '/etc/openvpn/server/private/client.key', mode: '0600' }
    - { src: '/etc/openvpn/easy-rsa/pki/private/server.key', dest: '/etc/openvpn/server/private/server.key', mode: '0600' }

- name: Copy files to /etc/openvpn
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "{{ item.mode }}"
  loop:
    - { src: '/etc/openvpn/easy-rsa/pki/ca.crt', dest: '/etc/openvpn/ca.crt', mode: '0644' }
    - { src: '/etc/openvpn/easy-rsa/pki/ta.key', dest: '/etc/openvpn/ta.key', mode: '0600' }

- name: Place server.conf from server.conf.j2 to /etc/openvpn/server.conf
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: '0644'


