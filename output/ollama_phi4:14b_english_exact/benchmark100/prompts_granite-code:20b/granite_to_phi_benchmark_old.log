---
- name: Install epel
  package:
    name: epel-release
    state: present
  when: 
    - ansible_distribution == "Amazon" and ansible_distribution_major_version == "2"
    - (ansible_os_family == "RedHat" and ansible_distribution_major_version in ["7", "8", "9"])

- name: Install epel gpg key
  rpm_key:
    key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-8
    state: present

- name: Install epel-release
  package:
    name: epel-release
    state: present

- name: Install epel-next-release
  package:
    name: epel-next-release
    state: present
  when: epel_next | default(false)


