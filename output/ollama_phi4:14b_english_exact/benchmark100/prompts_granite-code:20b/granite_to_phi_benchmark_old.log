---
- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk
    state: present

- name: Install RPM
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ rpm_packages }}"

- name: Install DEB
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ deb_packages }}"

- name: Install oracle java (rpm) (repository)
  yum_repository:
    name: oracle-java
    description: Oracle Java
    baseurl: "http://yum.oracle.com/repo/{{ oracle_java_rpm_version }}/x86_64/"
    gpgkey: "http://yum.oracle.com/RPM-GPG-KEY-oracle"
    gpgcheck: true

- name: Configure oracle targz
  include_tasks: configure_oracle_java.yml

- name: Install oracle java policy software (targz)
  include_tasks: install_oracle_java_policy.yml

- name: Set alternative (targz)
  alternatives:
    name: java
    path: "{{ oracle_java_alternative_path }}"
    link: /etc/alternatives/java
    priority: 2000

- name: Find JAVA_HOME
  command: update-alternatives --query java | grep 'Value: ' | cut -d ' ' -f 2
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    line: 'JAVA_HOME={{ java_home_result.stdout }}'
    state: present
    create: yes


