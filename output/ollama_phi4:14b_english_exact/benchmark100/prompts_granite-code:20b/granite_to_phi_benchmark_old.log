---
- name: Install epel
  when: 
    - ansible_distribution == "Amazon" and ansible_distribution_major_version == "2"
    - or
    - ansible_os_family == "RedHat" and ansible_distribution_major_version in ["7", "8", "9", "10"]
  package:
    name: epel-release
    state: present

- name: Install epel gpg key
  rpm_key:
    state: present
    key: "{{ epel_gpg_key }}"

- name: Install epel-release
  package:
    name: "{{ epel_url }}"
    state: present
  notify:
    - Update package cache

- name: Install epel-next-release
  when: epel_next is defined and epel_next
  package:
    name: "{{ epel_next_url }}"
    state: present
  notify:
    - Update package cache


