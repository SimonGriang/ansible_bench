---
- name: Install required software
  package:
    name: "{{ item }}"
  loop: "{{ users_requirements }}"
  loop_control:
    label: "{{ item }}"

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item.name }}"

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    regexp: "^(#|@)includedir"
    line: "{{ 'includedir /etc/sudoers.d' if users_sudo_includedir else '#' + 'includedir /etc/sudoers.d' }}"
    validate: visudo -cf %s
  when: users_sudo_includedir is defined and users_sudo_includedir

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


