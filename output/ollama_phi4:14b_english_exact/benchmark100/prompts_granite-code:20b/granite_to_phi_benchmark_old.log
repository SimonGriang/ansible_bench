---
- name: Create ssl key
  openssl_privatekey:
    path: /etc/ssl/private/mykey.key
    size: 2048

- name: Create ssl csr
  openssl_csr:
    path: /etc/ssl/certs/mycsr.csr
    privatekey_path: /etc/ssl/private/mykey.key
    common_name: example.com

- name: Create ssl certificates
  openssl_certificate:
    path: /etc/ssl/certs/mycert.crt
    privatekey_path: /etc/ssl/private/mykey.key
    csr_path: /etc/ssl/certs/mycsr.csr
    provider: selfsigned

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: /etc/ssl/certs/mycert.p12
    privatekey_path: /etc/ssl/private/mykey.key
    cert_path: /etc/ssl/certs/mycert.crt

- name: Read private key
  slurp:
    path: /etc/ssl/private/mykey.key
  register: private_key

- name: Read certificate
  slurp:
    path: /etc/ssl/certs/mycert.crt
  register: certificate

- name: Create combined private_key and certificate file
  copy:
    dest: /etc/ssl/certs/mykey_and_cert.pem
    content: |
      {{ private_key.content | b64decode }}
      {{ certificate.content | b64decode }}


