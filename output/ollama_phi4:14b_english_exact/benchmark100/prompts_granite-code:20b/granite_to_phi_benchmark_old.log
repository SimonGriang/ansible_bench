---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /path/to/python3.11.EXTERNALLY-MANAGED
  register: python311_managed_file

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  command: mv /path/to/python3.11.EXTERNALLY-MANAGED /path/to/python3.11.EXTERNALLY-MANAGED.bak
  when: python311_managed_file.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /path/to/python3.12.EXTERNALLY-MANAGED
  register: python312_managed_file

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  command: mv /path/to/python3.12.EXTERNALLY-MANAGED /path/to/python3.12.EXTERNALLY-MANAGED.bak
  when: python312_managed_file.stat.exists

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install python pip
  package:
    name: python3-pip
    state: present

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    line: >
      proxy = http://proxy.example.com:8080
    create: true

- name: Trust hosts
  lineinfile:
    path: /etc/hosts
    line: '127.0.0.1    localhost'

- name: Update pip
  pip:
    name: pip
    state: latest

- name: Install requested modules
  pip:
    requirements: /path/to/requirements.txt


