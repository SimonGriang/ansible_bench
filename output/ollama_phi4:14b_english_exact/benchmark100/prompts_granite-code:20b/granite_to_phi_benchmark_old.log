---
- name: lookup bootstrap facts (raw)
  command: >
    # Command to gather bootstrap facts would be here.
    echo "dummy_command_output"  # Replace with actual command to gather facts
  register: bootstrap_facts
  ignore_errors: true

- name: set bootstrap facts (I) # noqa jinja
  set_fact:
    bootstrap_distribution: "{{ item.value.distribution }}"
    bootstrap_distribution_major_version: "{{ item.value.distribution_major_version }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  loop_control:
