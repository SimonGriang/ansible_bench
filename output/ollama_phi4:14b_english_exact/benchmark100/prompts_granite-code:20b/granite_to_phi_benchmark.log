---
- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: user_exists
  ignore_errors: yes

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}/.gitconfig"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0755'

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
  vars:
    git_user_email: "{{ git_user_email }}"
    git_user_name: "{{ git_user_name }}"
    git_username: "{{ git_username }}"

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: '0755'

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    version: "{{ item.version | default('main') }}"
    accept_hostkey: yes
    update: yes
  loop: "{{ git_repositories }}"
  become: yes
  become_user: "{{ git_username }}"


