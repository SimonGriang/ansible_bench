---
- name: Check current docker-compose version
  command: docker-compose --version
  register: docker_compose_current_version
  changed_when: false

- name: Parse current docker-compose version
  set_fact:
    docker_compose_current_version_parsed: "{{ docker_compose_current_version.stdout.split()[-1] }}"
  when: docker_compose_current_version is defined

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: 
    - docker_compose_current_version is defined
    - docker_compose_current_version_parsed != desired_docker_compose_version

- name: Install Docker Compose (if configured)
  block:
    - name: Download Docker Compose
      get_url:
        url: "https://github.com/docker/compose/releases/download/{{ desired_docker_compose_version }}/docker-compose-$(uname -s)-$(uname -m)"
        dest: /usr/local/bin/docker-compose
        mode: u+x,g+x

    - name: Verify installed Docker Compose version
      command: docker-compose --version
      register: docker_compose_installed_version
      changed_when: false

    - name: Set installed version fact
      set_fact:
        docker_compose_installed_version_parsed: "{{ docker_compose_installed_version.stdout.split()[-1] }}"
  when:
    - desired_docker_compose_version is defined
    - (docker_compose_current_version is undefined or 
       docker_compose_current_version_parsed != desired_docker_compose_version)


