---
- name: create | Create ssl key
  openssl_privatekey:
    path: /path/to/private_key.pem
    type: RSA
    size: 2048

- name: create | Create ssl csr
  openssl_csr:
    path: /path/to/csr.pem
    privatekey_path: /path/to/private_key.pem
    common_name: mydomain.com

- name: create | Create ssl certificates
  openssl_certificate:
    path: /path/to/certificate.pem
    privatekey_path: /path/to/private_key.pem
    csr_path: /path/to/csr.pem
    provider: selfsigned

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    path: /path/to/cert.p12
    privatekey_path: /path/to/private_key.pem
    certificate_path: /path/to/certificate.pem
    passphrase: mysecret
    export_certs: yes

- name: create | Read private key
  slurp:
    path: /path/to/private_key.pem
  register: private_key_content

- name: create | Read certificate
  slurp:
    path: /path/to/certificate.pem
  register: certificate_content

- name: create | Create combined private_key and certificate file
  copy:
    dest: /path/to/private_key_and_cert.pem
    content: |
      {{ private_key_content['content'] | b64decode }}
      {{ certificate_content['content'] | b64decode }}


