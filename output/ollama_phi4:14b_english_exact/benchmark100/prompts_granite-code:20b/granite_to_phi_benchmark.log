- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    comment: "{{ user.comment | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    append: "{{ user.append | default(true) }}"
    shell: "{{ user.shell | default(omit) }}"
    create_home: "{{ user.create_home | default(true) }}"
    system: "{{ user.system | default(omit) }}"

- name: Set sudo options for {{ user.name }}
  template:
    src: "sudoers.d/{{ user.name }}.j2"
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: '0440'
    validate: 'visudo -cf %s'

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: not user.sudo_options

- name: Generate private ssh key for {{ user.name }}
  command: "{{ ssh_keygen_command }}"
  args:
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}_id_rsa"

- name: Generate public ssh key for {{ user.name }}
  command: "{{ ssh_keygen_pubkey_command }}"

- name: Convert ssh key to ppk for {{ user.name }}
  command: "{{ ssh_keygen_pubkey_command }} -o -t pkcs8 -m conv"

- name: Get or set the home directory for {{ user.name }}
  command: getent passwd "{{ user.name }}"
  register: getent_user
  changed_when: false

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ getent_user.stdout.split(':')[5] }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ item.key }}"
  with_items: "{{ user.authorized_keys }}"

- name: Remove unauthorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item.key }}"
  with_items: "{{ user.unauthorized_keys }}"

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}_id_rsa"
    dest: "{{ user.private_key_destination }}"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"

- name: Check users password valid time for {{ user.name }}
  command: chage -l "{{ user.name }}"
  register: chage_output
  changed_when: false

- name: Set users password valid time for {{ user.name }}
  command: chage -m "{{ user.password_min_days }}" -M "{{ user.password_max_days }}" -W "{{ user.password_warn_days }}" "{{ user.name }}"

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ user.private_key_src }}"
    dest: "{{ getent_user.stdout.split(':')[5] }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"


