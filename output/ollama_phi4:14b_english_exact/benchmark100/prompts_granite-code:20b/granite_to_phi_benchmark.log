---
- name: Install mysql
  apt:
    name: mysql-server
    state: present

- name: Configure mysql server
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf

- name: Configure mysql client
  template:
    src: my.client.cnf.j2
    dest: /etc/mysql/my.cnf

- name: Initialize mysql
  command: mysql_install_db --user=mysql

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  copy:
    src: my.cnf
    dest: /etc/mysql/conf.d/my.cnf

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_databases }}"

- name: List databases
  command: mysql -e "SHOW DATABASES;"

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.path }}"
  with_items: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('') }}"
    state: present
  with_items: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


