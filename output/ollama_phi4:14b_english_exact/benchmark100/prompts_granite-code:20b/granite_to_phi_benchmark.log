---
- name: debian12 | Get python3 version installed
  ansible.builtin.command:
    cmd: python3 --version
  register: python_version_output
  changed_when: false
  when: ansible_facts['os_family'] == "Debian" and ansible_facts['distribution_major_version'] == "12"

- name: debian12 | Parse python3 version
  ansible.builtin.set_fact:
    python3_version: "{{ python_version_output.stdout | regex_search('Python 3\\.([0-9]+)') | first | regex_replace('^Python 3\\.', '') }}"
  when: python_version_output is defined

- name: debian12 | Remove EXTERNALLY-MANAGED file if we're on Debian12
  ansible.builtin.file:
    path: "/path/to/EXTERNALLY-MANAGED"  # Replace with actual path
    state: absent
  when: ansible_facts['os_family'] == "Debian" and ansible_facts['distribution_major_version'] == "12" and python3_version == "11"


