---
- name: Check if certificates exist
  stat:
    path: "{{ item }}"
  loop: "{{ certificates }}"
  register: cert_stat

- name: Fail if some cert doesn't exist
  fail:
    msg: "Certificate {{ item.item }} does not exist."
  when: not item.stat.exists
  loop: "{{ cert_stat.results }}"

- name: Setting keystore variables in java < 11
  set_fact:
    keystore_type: "JKS"
    store_password: "{{ keystore_password }}"
    key_password: "{{ key_password }}"
  when: ansible_facts['java_version'] is version('11', '<')

- name: Setting keystore variables in java >= 11
  set_fact:
    keystore_type: "PKCS12"
    store_password: "{{ keystore_password }}"
    key_password: "{{ key_password }}"
  when: ansible_facts['java_version'] is version('11', '>=')

- name: Import SSL certificates
  java_cert:
    cert: "{{ item }}"
    keystore: "{{ keystore_path }}"
    keystore_type: "{{ keystore_type }}"
    storepass: "{{ store_password }}"
    keypass: "{{ key_password }}"
  loop: "{{ certificates }}"


