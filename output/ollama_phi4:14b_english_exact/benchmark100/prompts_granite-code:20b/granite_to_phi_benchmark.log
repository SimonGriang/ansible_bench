---
- name: Import assert.yml
  ansible.builtin.import_playbook: assert.yml

- name: Install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: '0644'
  notify: restart postfix

- name: "Setting values for main.cf (1/2)"
  ansible.builtin.lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^{{ item.key }}$'
    line: '{{ item.key }} = {{ item.value }}'
    create: yes
  loop: "{{ main_cf_values_part1 }}"
  notify: restart postfix

- name: "Setting values for main.cf (2/2)"
  ansible.builtin.lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^{{ item.key }}$'
    line: '{{ item.key }} = {{ item.value }}'
    create: yes
  loop: "{{ main_cf_values_part2 }}"
  notify: restart postfix

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: '0644'
  notify: restart postfix

- name: Creates cert/key directory
  ansible.builtin.file:
    path: /etc/ssl/private
    state: directory
    owner: root
    group: root
    mode: '0700'

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: tls_certificate.crt
    dest: /etc/ssl/certs/postfix.crt
    owner: root
    group: root
    mode: '0644'
  notify: restart postfix

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure sender_access
  ansible.builtin.template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    owner: root
    group: root
    mode: '0644'
  notify: restart postfix

- name: Configure recipient_access
  ansible.builtin.template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    owner: root
    group: root
    mode: '0644'
  notify: restart postfix

- name: Place sasl_password_map
  ansible.builtin.template:
    src: sasl_password_map.j2
    dest: /etc/postfix/sasl_password_map
    owner: root
    group: root
    mode: '0600'
  notify: restart postfix

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Start and enable postfix
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: yes


