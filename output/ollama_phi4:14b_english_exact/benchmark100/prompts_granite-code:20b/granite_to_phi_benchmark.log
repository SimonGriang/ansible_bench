---
- name: Ensure /etc/openvpn/easy-rsa exists
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Easyrsa init-pki
  ansible.builtin.command:
    cmd: easyrsa init-pki
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/index.txt

- name: Easyrsa build-ca
  ansible.builtin.command:
    cmd: easyrsa build-ca nopass
    chdir: /etc/openvpn/easy-rsa

- name: Easyrsa gen-dh
  ansible.builtin.command:
    cmd: easyrsa gen-dh
    chdir: /etc/openvpn/easy-rsa

- name: Easyrsa build-server-full server nopass
  ansible.builtin.command:
    cmd: easyrsa build-server-full server nopass
    chdir: /etc/openvpn/easy-rsa

- name: Easyrsa build-client-full client nopass
  ansible.builtin.command:
    cmd: easyrsa build-client-full client nopass
    chdir: /etc/openvpn/easy-rsa

- name: Easyrsa gen-crl
  ansible.builtin.command:
    cmd: easyrsa gen-crl
    chdir: /etc/openvpn/easy-rsa

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  ansible.builtin.command:
    cmd: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to /etc/openvpn/server
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    owner: root
    group: root
    mode: '0644'
  loop:
    - { src: '/etc/openvpn/easy-rsa/pki/ca.crt', dest: '/etc/openvpn/server/ca.crt' }
    - { src: '/etc/openvpn/easy-rsa/pki/dh.pem', dest: '/etc/openvpn/server/dh.pem' }
    - { src: '/etc/openvpn/easy-rsa/pki/ta.key', dest: '/etc/openvpn/server/ta.key' }
    - { src: '/etc/openvpn/easy-rsa/pki/issued/client.crt', dest: '/etc/openvpn/server/issued/client.crt' }
    - { src: '/etc/openvpn/easy-rsa/pki/issued/server.crt', dest: '/etc/openvpn/server/issued/server.crt' }
    - { src: '/etc/openvpn/easy-rsa/pki/private/ca.key', dest: '/etc/openvpn/server/private/ca.key' }
    - { src: '/etc/openvpn/easy-rsa/pki/private/client.key', dest: '/etc/openvpn/server/private/client.key' }
    - { src: '/etc/openvpn/easy-rsa/pki/private/server.key', dest: '/etc/openvpn/server/private/server.key' }

- name: Copy files to /etc/openvpn
  ansible.builtin.copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    owner: root
    group: root
    mode: '0644'
  loop:
    - { src: '/etc/openvpn/easy-rsa/pki/ca.crt', dest: '/etc/openvpn/ca.crt' }
    - { src: '/etc/openvpn/easy-rsa/pki/ta.key', dest: '/etc/openvpn/ta.key' }

