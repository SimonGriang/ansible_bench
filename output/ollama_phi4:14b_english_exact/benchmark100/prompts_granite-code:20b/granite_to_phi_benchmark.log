---
- name: password | Get efi path
  stat:
    path: /path/to/efi
  register: efi_path

- name: password | Remove unwanted grub.cfg on EFI systems
  file:
    path: "{{ efi_path.path }}/EFI/BOOT/grub.cfg"
    state: absent
  when: efi_path.stat.exists

- name: password | Install user template
  template:
    src: user_template.j2
    dest: /etc/some_directory/user_config.conf

- name: password | EFI | add password
  lineinfile:
    path: /path/to/efi/password_file
    line: "password=your_password"
    create: yes

- name: password | MBR | add password
  lineinfile:
    path: /path/to/mbr/password_file
    line: "password=your_password"
    create: yes

- name: password | Add --unrestricted
  replace:
    path: "{{ item }}"
    regexp: '(pattern_to_replace)'
    replace: '--unrestricted'
  loop:
    - /path/to/file1
    - /path/to/file2


