---
- name: Check if Helm binary exists
  stat:
    path: "/usr/local/bin/helm"
  register: helm_binary_check

- name: Check Helm version
  command: helm version --short
  register: helm_version_output
  when: helm_binary_check.stat.exists

- name: Download Helm
