---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install prerequisites
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ vault_prerequisites }}"

- name: Include installation method specific tasks
  ansible.builtin.include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  ansible.builtin.lineinfile:
    path: /etc/environment
    line: "{{ item.key }}={{ item.value }}"
  loop: "{{ vault_env_vars | dict2items }}"

- name: Include hardening tasks
  ansible.builtin.include_tasks: hardening.yml

- name: Start and enable vault
  ansible.builtin.service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"

- name: Initialize and enable vault
  ansible.builtin.command: vault operator init
  when: vault_type != "oss" and vault_is_initialized is not defined
  register: vault_initialization
  changed_when: vault_initialization.stdout is search('Initialization complete')


