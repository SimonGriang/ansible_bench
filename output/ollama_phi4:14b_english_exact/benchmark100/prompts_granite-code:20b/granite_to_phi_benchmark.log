---
- name: Install ssl packages
  ansible.builtin.package:
    name: "{{ ssl_packages }}"
    state: present

- name: Place configuration
  ansible.builtin.template:
    src: "{{ ssl_config_template }}"
    dest: "{{ ssl_config_path }}"
    owner: "{{ ssl_config_owner }}"
    group: "{{ ssl_config_group }}"
    mode: "{{ ssl_config_mode }}"

- name: Configure redirect from http to https
  ansible.builtin.lineinfile:
    path: "{{ http_vhost_config_path }}"
    regexp: '^\\s*#?\\s*Redirect permanent / https://'
    line: 'Redirect permanent "/" "https://{{ server_name }}/"'
    state: present


