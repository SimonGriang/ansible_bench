  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and rke2_server_service_status != 'active' }}"

- name: Task 7 - Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: >-
      {{
        rke2_etcd_snapshot_s3_options.access_key is defined and
        rke2_etcd_snapshot_s3_options.secret_key is defined and
        rke2_etcd_snapshot_s3_options.bucket is defined and
        rke2_etcd_snapshot_s3_options.snapshot_name is defined
      }}

- name: Task 8 - Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/etcd-snapshots
        state: directory
        mode: '0755'

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/etcd-snapshots/etcd-snapshot.db

    - name: Restore etcd from snapshot
      command: rke2 server --restore-snapshot /var/lib/rancher/rke2/etcd-snapshots/etcd-snapshot.db
  when: do_etcd_restore is defined and do_etcd_restore

- name: Task 9 - Restore etcd from s3
  command: rke2 server --restore-s3-config "{{ rke2_etcd_snapshot_s3_options }}"
  when: do_etcd_restore_from_s3 is defined and do_etcd_restore_from_s3

- name: Task 10 - Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: true

- name: Task 11 - Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    enabled: false
    masked: true

- name: Task 12 - Wait for the first server be ready - no CNI
  wait_for:
    timeout: 600
    condition: >-
      {{ ansible_memory_mb.total > 2048 and
         ansible_devices.sda.avail > 10240 and
         ansible_processor_vcpus > 2 }}

- name: Task 13 - Wait for the first server be ready - with CNI
  wait_for:
    timeout: 600
    condition: >-
      {{ ansible_facts['default_interface'] is defined and
         'Ready' in hostvars[inventory_hostname]['rke2_node_status'] }}

- name: Task 14 - Restore etcd
  block:
    - name: Remove old <node>.node-password.rke2 secrets
      command: rke2-ctl remove-secret <node>.node-password.rke2

    - name: Remove old nodes
      command: rke2-ctl remove-node <node>

    - name: Execute rke2 server command to remove old nodes and secrets
      command: rke2 server --reset-kubelet
  when: (do_etcd_restore is defined and do_etcd_restore) or (do_etcd_restore_from_s3 is defined and do_etcd_restore_from_s3)

- name: Task 15 - Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ groups[rke2_cluster_group_name][0] }}"
  delegate_facts: true
  when: inventory_hostname == groups[rke2_cluster_group_name][0]
