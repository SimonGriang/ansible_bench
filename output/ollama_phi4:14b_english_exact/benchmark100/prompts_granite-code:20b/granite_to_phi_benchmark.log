---
- name: Download RKE2 installation script
  ansible.builtin.get_url:
    url: "{{ rke2_install_bash_url }}"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: '0700'
    timeout: "{{ rke2_artifact_fetch_timeout }}"

- name: Copy local RKE2 installation script
  ansible.builtin.copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: '0700'
    force: yes

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifact_path }}"
    state: directory
    mode: '0700'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum file
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
        mode: '0640'
        timeout: "{{ rke2_artifact_fetch_timeout }}"
      when:
        - airgap_mode_enabled
        - airgap_implementation == 'download'

    - name: Download RKE2 artifacts and compare with checksums
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/"
        dest: "{{ rke2_artifact_path }}"
        timeout: "{{ rke2_artifact_fetch_timeout }}"
      when:
        - airgap_mode_enabled
        - airgap_implementation == 'download'

    - name: Download RKE2 install script
      ansible.builtin.get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: '0700'
        timeout: "{{ rke2_artifact_fetch_timeout }}"
      when:
        - airgap_mode_enabled
        - airgap_implementation == 'download'

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item }}"
    mode: '0640'
    force: yes
  loop: "{{ rke2_artifacts }}"
  when:
    - airgap_mode_enabled
    - airgap_implementation == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images tarballs folder
      ansible.builtin.file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: '0700'

    - name: Copy additional tarball images RKE2 components
      ansible.builtin.copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"
        mode: '0644'
        force: yes
  loop: "{{ rke2_additional_tarballs }}"
  when:
    - airgap_mode_enabled
    - rke2_additional_tarballs is defined and rke2_additional_tarballs | length > 0

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Check artifact permissions
      ansible.builtin.stat:
        path: "{{ rke2_artifact_path }}/{{ item }}"
      register: artifact
      loop: "{{ rke2_artifacts }}"

    - name: Make artifacts read-only if writeable
      ansible.builtin.file:
        path: "{{ rke2_artifact_path }}/{{ item.item }}"
        mode: '0640'
      when: item.stat.isreg and item.stat.mode & 0022
      loop: "{{ artifact.results }}"

    - name: Make install script executable if writeable and not executable
      ansible.builtin.file:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: '0700'
      when: artifact.results | selectattr('item', 'equalto', 'rke2.sh') | map(attribute='stat') | map('isreg') | map('and', True, 'mode & 0100') | any

    - name: Check if install script is executable
      ansible.builtin.assert:
        that:
          - artifact.results | selectattr('item', 'equalto', 'rke2.sh') | map(attribute='stat') | map('mode') | map('and', 0100) | any
        fail_msg: "RKE2 install script is not executable."
  when:
    - airgap_mode_enabled
    - airgap_implementation == 'exists'

- name: Populate service facts
  ansible.builtin.service_facts:

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: "/usr/local"

- name: Check if separate partition
  ansible.builtin.assert:
    that:
      - fs_stats.stat.pw_name != '/'
    fail_msg: "/usr/local is not a separate partition."

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: "/usr/local/bin"
  when: fs_stats.stat.pw_name == '/usr/local'

- name: Check RKE2 version
  ansible.builtin.command: rke2 --version
  register: rke2_version_output

- name: Check installed and running RKE2 versions
  ansible.builtin.command: systemctl status rke2-{{ rke2_type }}
  register: rke2_service_status

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - rke2_version_output.stdout | regex_search(r'{{ rke2_version }}') is not none
    fail_msg: "RKE2 version mismatch, potential downgrade detected."

- name: Run RKE2 install script
  ansible.builtin.command: "{{ rke2_install_script_dir }}/rke2.sh {{ rke2_install_args }}"
  environment:
    RKE2_ARTIFACT_PATH: "{{ rke2_artifact_path }}"
  when:
    - not airgap_mode_enabled

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    owner: root
    group: root
    mode: '0644'

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/"
    owner: root
    group: root
    mode: '0644'

- name: Copy RKE2 environment file
  ansible.builtin.template:
    src: rke2_environment.j2
    dest: "/etc/default/rke2-{{ rke2_type }}"
    owner: root
    group: root
    mode: '0644'


