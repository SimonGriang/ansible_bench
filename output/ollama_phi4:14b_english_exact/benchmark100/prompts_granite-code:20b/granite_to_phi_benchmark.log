---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  template:
    src: mysql-server.conf.j2
    dest: "{{ mysql_configuration_destination }}"
    owner: "{{ mysql_name }}"
    group: "{{ mysql_name }}"
    mode: '0644'
    variables:
      configuration_options: "{{ mysql_configuration_options }}"
      mysql_socket: "{{ mysql_socket }}"

- name: Configure mysql client
  template:
    src: mysql-client.conf.j2
    dest: "{{ mysql_configuration_destination }}"
    owner: "{{ mysql_name }}"
    group: "{{ mysql_name }}"
    mode: '0644'
    variables:
      mysql_socket: "{{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: '0600'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('ALL PRIVILEGES') }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


