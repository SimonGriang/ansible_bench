---
- name: Restore etcd - get all nodes
  command: kubectl get nodes --no-headers -o custom-columns=NAME:.metadata.name
  register: all_nodes_output

- name: Restore etcd - remove old nodes
  command: kubectl delete node "{{ item }}"
  loop: "{{ old_nodes | difference(all_nodes_output.stdout_lines) }}"


