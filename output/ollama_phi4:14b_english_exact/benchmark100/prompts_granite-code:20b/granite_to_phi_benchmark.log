- name: Create group
  ansible.builtin.group:
    name: "{{ group_name }}"
    state: present

- name: Create user
  ansible.builtin.user:
    name: "{{ user_name }}"
    group: "{{ group_name }}"
    state: present

- name: Generate rndc key
  ansible.builtin.command:
    cmd: rndc-confgen -a -c /etc/bind/rndc.key
    creates: /etc/bind/rndc.key

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: /etc/bind/rndc.key
    mode: '0400'
    owner: bind
    group: bind

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "{{ hints_url }}"
    dest: "/var/named/named.root"
    mode: '0644'

- name: Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: "/var/named/{{ item.name }}.zone"
    mode: '0644'
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: /etc/bind/named.conf.local
    mode: '0644'

- name: Place systemd override
  ansible.builtin.template:
    src: named.service.j2
    dest: /etc/systemd/system/named.service.d/override.conf
    mode: '0644'

- name: Start and enable dns
  ansible.builtin.service:
    name: named
    state: started
    enabled: true


