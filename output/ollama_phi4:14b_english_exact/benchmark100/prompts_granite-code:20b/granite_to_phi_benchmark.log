---
- name: Cordon and Drain the node {{ rke2_node_name }}
  k8s:
    state: present
    definition:
      apiVersion: v1
      kind: Node
      metadata:
        name: "{{ rke2_node_name }}"
        annotations:
          node.kubernetes.io/unreachable: "true"
          node.kubernetes.io/unschedulable: "true"
  when: rke2_drain_node_during_upgrade | default(true) | bool
  delegate_to: localhost

- name: Drain the node {{ rke2_node_name }}
  shell: |
    kubectl drain "{{ rke2_node_name }}" --ignore-daemonsets --delete-local-data --force --grace-period=30
  when: rke2_drain_node_during_upgrade | default(true) | bool
  delegate_to: localhost

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2-server
    state: restarted
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  k8s_info:
    api_version: v1
    kind: Node
  register: nodes
  until: nodes.resources | map(attribute='status.conditions') | flatten | selectattr('type', 'equalto', 'Ready') | selectattr('status', 'equalto', 'True') | list | count == groups['all_nodes'] | length
  retries: 30
  delay: 10
  delegate_to: localhost

- name: Uncordon the node {{ rke2_node_name }}
  k8s:
    state: present
    definition:
      apiVersion: v1
      kind: Node
      metadata:
        name: "{{ rke2_node_name }}"
        annotations:
          node.kubernetes.io/unreachable: ""
          node.kubernetes.io/unschedulable: ""
  when: rke2_drain_node_during_upgrade | default(true) | bool
  delegate_to: localhost

- name: Wait for all pods to be ready again
  k8s_info:
    api_version: v1
    kind: Pod
  register: pods
  until: pods.resources | map(attribute='status.phase') | list | count('Running') == pods.resources | length
  retries: 30
  delay: 10
  delegate_to: localhost
  when: rke2_wait_for_all_pods_to_be_ready | default(true) | bool

- name: Wait for all pods to pass readiness checks
  k8s_info:
    api_version: v1
    kind: Pod
  register: pods
  until: pods.resources | selectattr('status.conditions', 'defined') | selectattr('status.conditions', 'sequence', 'match', '^[^Ready]') | selectattr('status.conditions', 'key', 'equalto', 'Ready') | selectattr('status.conditions', 'status', 'equalto', 'True') | list | count == pods.resources | length
  retries: 30
  delay: 10
  delegate_to: localhost
  when: rke2_wait_for_all_pods_to_be_healthy | default(true) | bool


