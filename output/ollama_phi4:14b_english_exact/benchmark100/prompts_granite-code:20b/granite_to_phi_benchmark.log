---
- name: Ensure the docroot directories are in place
  ansible.builtin.file:
    path: "{{ docroot_path }}"
    state: directory
    owner: "{{ web_user }}"
    group: "{{ web_group }}"
    mode: '0755'

- name: Configure virtual host configuration files
  ansible.builtin.template:
    src: "vhost.conf.j2"
    dest: "{{ vhost_conf_path }}"
    owner: "{{ web_user }}"
    group: "{{ web_group }}"
    mode: '0644'

- name: Enable virtual hosts
  ansible.builtin.command:
    cmd: "a2ensite {{ item }}"
  with_items: "{{ vhosts }}"
  notify: restart apache
  changed_when: false


