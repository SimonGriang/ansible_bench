    src: /path/to/kubelet/config.yaml
    dest: /var/lib/rancher/rke2/server/agent/etc/kubernetes/kubelet/config.yaml
    mode: '0644'
  when: kubelet_config is defined

- name: Copy the Containerd Registry Configuration file if the custom registry is used
  copy:
    src: /path/to/registries.yaml
    dest: /etc/containerd/registries.yaml
    mode: '0644'
  when: custom_registry is defined

- name: Start the RKE2 service on the remaining nodes
  service:
    name: rke2
    state: started
    enabled: yes

- name: Mask other RKE2 services on the remaining nodes
  service:
    name: rke2-*
    state: masked

- name: Wait for the remaining nodes to be ready if no CNI is used
  command: /usr/local/bin/rke2 status
  register: rke2_status
  until: "'node ready' in rke2_status.stdout"
  retries: 30
  delay: 10
  when: cni is not defined

- name: Wait for the remaining nodes to be ready if CNI is used
  command: /usr/local/bin/rke2 status
  register: rke2_status
  until: "'node ready' in rke2_status.stdout and 'plugin ready' in rke2_status.stdout"
  retries: 30
  delay: 10
  when: cni is defined


