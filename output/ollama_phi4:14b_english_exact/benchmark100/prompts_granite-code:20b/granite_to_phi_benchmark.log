---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install dns
  apt:
    name: dns
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ directories }}"

- name: Create group
  group:
    name: "{{ group_name }}"
    state: present

- name: Create user
  user:
    name: "{{ user_name }}"
    group: "{{ group_name }}"
    state: present

- name: Generate rndc key
  shell: rndc-confgen -a -c /etc/bind/rndc.key
  args:
    creates: /etc/bind/rndc.key

- name: Set permissions on rndc key file
  file:
    path: /etc/bind/rndc.key
    mode: '0400'
    owner: bind
    group: bind

- name: Get the hints/root file
  get_url:
    url: "{{ hints_url }}"
    dest: "/var/named/named.root"

- name: Create zone file
  template:
    src: zone.j2
    dest: "/var/named/{{ item.name }}.zone"
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/bind/named.conf.local

- name: Place systemd override
  template:
    src: named.service.j2
    dest: /etc/systemd/system/named.service.d/override.conf

- name: Start and enable dns
  service:
    name: named
    state: started
    enabled: yes


