---
- name: Ensure old versions of Docker are not installed
  ansible.builtin.yum:
    name: "{{ item }}"
    state: absent
  loop:
    - docker
    - docker-client
    - docker-client-latest
    - docker-common
    - docker-latest
    - docker-latest-logrotate
    - docker-logrotate
    - docker-engine
  when: ansible_os_family == 'RedHat'

- name: Add Docker GPG key
  ansible.builtin.apt_key:
    url: https://download.docker.com/linux/ubuntu/gpg
    state: present

- name: Add Docker repository
  ansible.builtin.apt_repository:
    repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu
    state: present
    codename: "{{ ansible_lsb.codename }}"

- name: Configure Docker Nightly repo
  ansible.builtin.apt_repository:
    repo: deb [arch=amd64] https://nightly.docker.com
    state: present
    codename: "{{ ansible_lsb.codename }}"

- name: Configure Docker Test repo
  ansible.builtin.apt_repository:
    repo: deb [arch=amd64] https://test.docker.com
    state: present
    codename: "{{ ansible_lsb.codename }}"

- name: Configure containerd on RHEL 8
  ansible.builtin.yum_repository:
    name: containerd
    description: Containerd Repository
    baseurl: https://download.docker.com/linux/centos/8/x86_64/stable/
    gpgkey: https://download.docker.com/linux/centos/gpg
    gpgcheck: true
  when: ansible_distribution_major_version == '8'


