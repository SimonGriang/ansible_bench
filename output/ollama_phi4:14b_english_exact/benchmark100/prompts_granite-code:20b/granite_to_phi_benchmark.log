---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  ansible.builtin.template:
    src: mysql-server.conf.j2
    dest: "{{ mysql_configuration_destination }}"
    owner: "{{ mysql_name }}"
    group: "{{ mysql_name }}"
    mode: '0644'
    variables:
      configuration_options: "{{ mysql_configuration_options }}"
      mysql_socket: "{{ mysql_socket }}"

- name: Configure mysql client
  ansible.builtin.template:
    src: mysql-client.conf.j2
    dest: "{{ mysql_configuration_destination }}"
    owner: "{{ mysql_name }}"
    group: "{{ mysql_name }}"
    mode: '0644'
    variables:
      mysql_socket: "{{ mysql_socket }}"

- name: Initialize mysql
  ansible.builtin.command:
    argv:
      - "{{ mysql_initialize_command }}"
    creates: /path/to/mysql_initialized_marker

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: '0600'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('ALL PRIVILEGES') }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: true


