---
- name: Disable swap
  ansible.builtin.command:
    cmd: |
      swapoff -a
      sed -i '/ swap / s/^/#/' /etc/fstab
  when: ansible_facts['swapiness'] != 0

- name: Disable core dumps
  ansible.builtin.copy:
    dest: /etc/security/limits.d/disable-core-dumps.conf
    content: |
      * soft core 0
      * hard core 0
    owner: root
    group: root
    mode: '0644'
  when: ansible_os_family == "RedHat" or ansible_os_family == "Debian"

- name: Disable Shell Command History
  ansible.builtin.template:
    src: no_shell_history.j2
    dest: /etc/profile.d/no_shell_history.sh
    owner: root
    group: root
    mode: '0644'


