- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.service:
    name: rke2-server
    state: restarted
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready again
  ansible.builtin.command:
    cmd: kubectl get nodes --no-headers | grep -q '^.*\s+Ready\s*$'
  register: nodes_ready
  until: nodes_ready.rc == 0
  retries: 30
  delay: 10
  changed_when: false

- name: Wait for all pods to be ready again
  ansible.builtin.command:
    cmd: kubectl get pods --all-namespaces --field-selector=status.phase!=Succeeded,status.phase!=Failed --no-headers | grep -q 'NotReady'
  register: pods_ready
  until: pods_ready.rc != 0
  retries: 30
  delay: 10
  changed_when: false


