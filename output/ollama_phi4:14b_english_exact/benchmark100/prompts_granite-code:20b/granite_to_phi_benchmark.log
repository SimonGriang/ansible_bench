    src: "vhost.conf.j2"
    dest: "{{ vhost_conf_path }}"
    owner: "{{ web_user }}"
    group: "{{ web_group }}"
    mode: '0644'

- name: Enable virtual hosts
  command: "a2ensite {{ item }}"
  with_items: "{{ vhosts }}"
  notify: restart apache


