---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Update cache (apk)
  community.general.apk:
    update_cache: true

- name: Update all software (apk)
  community.general.apk:
    upgrade: full

- name: Prevent upgrade for selected packages
  ansible.builtin.apt:
    name: "{{ item }}"
    state: hold
  loop: "{{ packages_to_hold }}"

- name: Update all software (apt)
  ansible.builtin.apt:
    upgrade: dist

- name: Apt autoremove (apt)
  ansible.builtin.apt:
    autoremove: true

- name: Update all software (dnf)
  ansible.builtin.dnf:
    name: "*"
    state: latest

- name: Update all software (pacman)
  community.general.pacman:
    name: "*"
    state: latest

- name: Update all software (yum/6)
  ansible.builtin.yum:
    name: "*"
    state: latest
    exclude: "{{ yum_exclude_list_6 }}"

- name: Update yum non-6
  ansible.builtin.yum:
    name: "*"
    state: latest
    exclude: "{{ yum_exclude_list_non_6 }}"

- name: Install yum-utils
  ansible.builtin.yum:
    name: yum-utils
    state: present

- name: Update all software (zypper)
  community.general.zypper:
    name: "*"
    state: latest


