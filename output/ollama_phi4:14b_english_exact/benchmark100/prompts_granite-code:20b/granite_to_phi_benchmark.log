---
- name: Ensure the required SSL packages are installed
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - openssl
    - libssl-dev
  become: true

- name: Place the SSL configuration file in the appropriate directory
  copy:
    src: ssl.conf.j2
    dest: /etc/nginx/ssl.conf
    owner: root
    group: root
    mode: '0644'
  become: true

- name: Configure the default virtual host to redirect HTTP requests to HTTPS
  blockinfile:
    path: /etc/nginx/sites-available/default
    block: |
      server {
        listen 80;
        server_name {{ server_name }};
        return 301 https://$host$request_uri;
      }
  become: true


