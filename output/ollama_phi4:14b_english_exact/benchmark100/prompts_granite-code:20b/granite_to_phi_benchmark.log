---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  package:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  package:
    name: rsyslog
    state: present

- name: Install additional rsyslog packages
  package:
    name: "{{ item }}"
    state: present
  loop:
    - rsyslog-gnutls
    - rsyslog-relp

- name: Configuring default rsyslog
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    mode: '0644'

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d
    state: directory
    mode: '0755'

- name: Configuring rsyslog forward rule
  template:
    src: 50-default.conf.j2
    dest: /etc/rsyslog.d/50-default.conf
    mode: '0644'

- name: Configuring additional config files
  template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: '0644'
  loop:
    - { src: 'additional.conf.j2', dest: '/etc/rsyslog.d/additional.conf' }

- name: Start and enable rsyslog
  service:
    name: rsyslog
    state: started
    enabled: true


