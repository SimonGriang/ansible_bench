---
- name: Install cron
  package:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/crontab
    line: 'SHELL=/bin/bash'
    create: yes
    state: present

- name: Configure path
  lineinfile:
    path: /etc/crontab
    line: 'PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin'
    create: yes
    state: present

- name: Configure mailto
  lineinfile:
    path: /etc/crontab
    line: 'MAILTO=root'
    create: yes
    state: present

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: yes

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    user: "{{ item.user | default(omit) }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs }}"


