---
- name: Create group vault
  group:
    name: vault
    state: present

- name: Create user vault
  user:
    name: vault
    system: yes
    group: vault
    create_home: no
    shell: /sbin/nologin

- name: Create directory /opt/vault
  file:
    path: /opt/vault
    state: directory
    owner: vault
    group: vault
    mode: '0755'

- name: Download Vault binary
  get_url:
    url: https://releases.hashicorp.com/vault/1.8.0/vault_1.8.0_linux_amd64.zip
    dest: /opt/vault/vault.zip
  register: download

- name: Extract Vault binary
  unarchive:
    src: /opt/vault/vault.zip
    dest: /opt/vault
    remote_src: yes
    creates: /opt/vault/vault

- name: Create directory /etc/vault.d
  file:
    path: /etc/vault.d
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy Vault binary
  copy:
    src: /opt/vault/vault
    dest: /usr/local/bin/vault
    owner: root
    group: root
    mode: '0755'

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  command: setcap cap_ipc_lock=ep /usr/local/bin/vault

- name: Create file /etc/vault.d/vault.env
  file:
    path: /etc/vault.d/vault.env
    state: touch
    owner: root
    group: root
    mode: '0644'

- name: Create directory /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy Vault service file
  copy:
    src: vault.service
    dest: /usr/lib/systemd/system/vault.service
    owner: root
    group: root
    mode: '0644'

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: /etc/vault.d/vault.hcl
    owner: root
    group: root
    mode: '0644'

- name: Flush handlers
  meta: flush_handlers


