---
- name: Install bash package
  package:
    name: bash
    state: present

- name: Install openjdk java package
  package:
    name: openjdk
    state: present

- name: Install RPM package
  package:
    name: "{{ rpm_package_name }}"
    state: present

- name: Install DEB package
  package:
    name: "{{ deb_package_name }}"
    state: present

- name: Install oracle java (rpm) package from the repository
  package:
    name: oracle-java
    state: present

- name: Configure oracle java (targz)
  command: /path/to/oracle/java/configuration

- name: Install oracle java policy software (targz)
  command: /path/to/oracle/java/policy/software/installation

- name: Set alternative for java
  alternatives:
    name: java
    path: /path/to/java

- name: Find the JAVA_HOME directory
  shell: |
    update-alternatives --query java | grep 'Value: ' | sed 's/Value: \(.*\)\/bin\/java/\1/'
  register: java_home_output
  changed_when: false

- name: Set the JAVA_HOME environment variable
  lineinfile:
    path: /etc/environment
    line: "JAVA_HOME={{ java_home_output.stdout }}"
    create: yes


