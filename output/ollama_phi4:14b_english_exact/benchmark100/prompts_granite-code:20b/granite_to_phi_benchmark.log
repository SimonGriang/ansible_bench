- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install php
  ansible.builtin.package:
    name: "{{ php_packages }}"

- name: Find used php.ini
  ansible.builtin.shell: "{{ php_ini_command }}"
