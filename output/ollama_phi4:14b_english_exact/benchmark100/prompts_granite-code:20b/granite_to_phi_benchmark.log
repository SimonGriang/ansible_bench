---
- name: Create docroot directory for each virtual host
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Create docroot for {{ item.name }}"
  when: item.create_docroot is not defined or item.create_docroot | bool

- name: Configure virtual host settings
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Configure virtual host for {{ item.name }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd


