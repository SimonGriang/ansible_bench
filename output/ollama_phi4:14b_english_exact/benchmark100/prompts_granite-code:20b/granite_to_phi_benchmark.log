---
- name: lookup bootstrap facts (raw)
  command: some_command_to_get_bootstrap_facts
  register: bootstrap_facts_output

- name: set bootstrap facts (I) # noqa jinja
  set_fact:
    bootstrap_distribution: "{{ item.value.distribution }}"
    bootstrap_distribution_major_version: "{{ item.value.distribution_major_version }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: item.value.os_family == bootstrap_facts_output.stdout

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.value.os_family }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: item.value.distribution == bootstrap_distribution


