---
- name: Check if Java certificates exist
  stat:
    path: "{{ item }}"
  loop: "{{ java_certs }}"
  register: cert_checks

- name: Fail if Java certificate doesn't exist
  fail:
    msg: "Certificate {{ item.item }} does not exist at {{ item.item }}"
  when: item.stat.exists == false
  loop: "{{ cert_checks.results }}"
  loop_control:
    label: "{{ item.item }}"

- name: Set keystore variables for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir | default('java_keystore_dir_old') }}"
  when: java_version is defined and java_version | int < 11

- name: Set keystore variables for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir | default('java_keystore_dir_new') }}"
  when: java_version is defined and java_version | int >= 11

- name: Import SSL certificates
  java_cert:
    cert_path: "{{ item }}"
    alias: "{{ item | basename }}"
    keystore_path: "{{ java_keystore_dir }}"
    keystore_pass: "{{ keystore_password }}"
    state: present
  loop: "{{ java_certs }}"
  when: cert_checks.results | selectattr('stat.exists', 'equalto', true) | list


