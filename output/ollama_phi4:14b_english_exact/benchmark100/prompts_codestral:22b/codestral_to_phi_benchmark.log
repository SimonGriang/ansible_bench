---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required software
  package:
    name: "{{ users_requirements }}"
    state: present
  when: users_requirements | default([]) | length > 0

- name: Loop over users_groups
  include_tasks: group.yml
  when: users_groups is defined
  loop: "{{ users_groups }}"
  loop_control:
    loop_var: group

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    regexp: '^(#|@)includedir'
    line: "{{ users_sudo_includedir }}"
    validate: visudo -cf %s
    state: present

- name: Loop over users
  include_tasks: user.yml
  when: users is defined
  loop: "{{ users }}"
  loop_control:
    loop_var: user

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow | default(false)

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow | default(false)


