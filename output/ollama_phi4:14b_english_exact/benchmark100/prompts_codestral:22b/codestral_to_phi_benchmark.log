---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install nginx
  package:
    name: nginx
    state: present

- name: Place nginx.conf
  template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
  notify: restart nginx
  register: nginx_conf_result
  failed_when: nginx_conf_result.rc != 0 and 'test is successful' not in nginx_conf_result.stdout

- name: Validate nginx configuration
  command: nginx -t -c /etc/nginx/nginx.conf
  register: nginx_test_result
  changed_when: false
  failed_when: nginx_test_result.rc != 0 and 'test is successful' not in nginx_test_result.stdout

- name: Ensure /etc/nginx/conf.d exists
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: '0755'

- name: Place default.conf
  template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
  notify: restart nginx
  register: default_conf_result
  failed_when: default_conf_result.rc != 0 and 'test is successful' not in default_conf_result.stdout

- name: Start and enable nginx
  service:
    name: nginx
    state: started
    enabled: true

handlers:
  - name: restart nginx
    service:
      name: nginx
      state: restarted


