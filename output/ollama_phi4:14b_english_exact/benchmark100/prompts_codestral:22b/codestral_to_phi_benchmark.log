\n      ansible.builtin.file:\n        path: "{{ vault_path }}/etc/vault.d/vault.env"\n        state: touch\n        mode: \'0644\'\n      notify: Restart vault\n\n    - name: Create /usr/lib/systemd/system\n      ansible.builtin.file:\n        path: /usr/lib/systemd/system\n        state: directory\n        mode: \'0755\'\n\n    - name: Copy Vault service file\n      ansible.builtin.template:\n        src: vault.service.j2\n        dest: /usr/lib/systemd/system/vault.service\n        mode: \'0644\'\n      notify: Daemon reload\n\n    - name: Copy vault configuration\n      ansible.builtin.copy:\n        src: vault.hcl\n        dest: "{{ vault_path }}/etc/vault.d/vault.hcl"\n        mode: \'0644\'\n      notify: Restart vault\n\n  handlers:\n    - name: Restart vault\n      ansible.builtin.service:\n        name: vault\n        state: restarted\n\n    - name: Daemon reload\n      ansible.builtin.systemd:\n        daemon_reload: yes\n```\n\n### Explanation of Fixes:\n- Changed all instances of `true` and `false` to lowercase `true` and `false` for `when` conditions to adhere to YAML boolean standards.\n- Broke long lines in the `when` conditions and other parts of the tasks to ensure line lengths do not exceed 80 characters.' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-16T03:56:28.668256822Z', 'done': True, 'done_reason': 'stop', 'total_duration': 20939808398, 'load_duration': 67678717, 'prompt_eval_count': 2252, 'prompt_eval_duration': 15152393, 'eval_count': 1217, 'eval_duration': 20854977934, 'model_name': 'phi4:14b'} id='run--006ee275-1c4f-43a2-901d-f0a6870605f1-0' usage_metadata={'input_tokens': 2252, 'output_tokens': 1217, 'total_tokens': 3469}
