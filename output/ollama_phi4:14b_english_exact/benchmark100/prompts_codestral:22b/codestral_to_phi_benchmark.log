---
- name: Enable proxy and proxy_http modules in Apache
  ansible.builtin.shell: |
    a2enmod proxy
    a2enmod proxy_http
  when: ansible_os_family in ['Debian', 'Suse']

- name: Configure locations in Apache
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item.name }}.conf"
  loop: "{{ httpd_locations }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

handlers:
  - name: Test httpd configuration validity
    ansible.builtin.shell: apachectl configtest

  - name: Restart httpd
    ansible.builtin.service:
      name: apache2
      state: restarted


