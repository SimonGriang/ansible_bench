        src: "{{ src }}"
        dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
        owner: "{{ redis_owner }}"
        group: "{{ redis_group }}"
        mode: "{{ redis_mode }}"
      notify: Restart redis

- name: Start and enable redis
  hosts: all
  tasks:
    - name: Start and enable redis
      service:
        name: "{{ redis_service }}"
        state: started
        enabled: yes


