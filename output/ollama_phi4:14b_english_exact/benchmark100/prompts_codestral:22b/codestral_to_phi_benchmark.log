  command: "readlink -f $(which java)"
  register: java_home_link
  changed_when: false
- set_fact:
    java_home: "{{ java_home_link.stdout | regex_replace('/bin/java$', '') }}"

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home }}"
    create: yes


