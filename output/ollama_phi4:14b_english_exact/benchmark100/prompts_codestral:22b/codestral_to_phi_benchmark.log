---
- name: Execute a raw command to retrieve the OS release information
  raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  failed_when: false

- name: Use the 'set_fact' module to parse the OS distribution and its major version
  set_fact:
    bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_search('NAME=\"([^\"]+)\"') | first }}"
    bootstrap_version: "{{ bootstrap_facts.stdout | regex_search('VERSION_ID=\"([^\"]+)\"') | first }}"
  when:
    - bootstrap_facts is defined
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout | regex_search('NAME=\"([^\"]+)\"', '\\1') is match('Ubuntu|Debian|RedHat|CentOS')
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"

- name: Determine the OS family based on the bootstrap_distribution
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  loop:
    - { key: 'Ubuntu', value: 'Debian' }
    - { key: 'Debian', value: 'Debian' }
    - { key: 'RedHat', value: 'RedHat' }
    - { key: 'CentOS', value: 'RedHat' }
  when:
    - bootstrap_distribution is defined
    - bootstrap_distribution in item.key
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"


