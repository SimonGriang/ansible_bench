        - server.crt
        - server.key
        - dh.pem
        - ta.key
        - crl.pem

    - name: Copy files to /etc/openvpn
      copy:
        src: /etc/openvpn/easy-rsa/pki/{{ item }}
        dest: /etc/openvpn/
        mode: '0640'
        owner: root
        group: root
      loop:
        - ca.crt
        - ta.key
        - dh.pem
        - crl.pem

    - name: Place server.conf
      template:
        src: server.conf.j2
        dest: "{{ openvpn_configuration_directory }}/server.conf"
        mode: '0640'
        owner: root
        group: "{{ openvpn_group }}"
      notify: Restart openvpn

  handlers:
