---
- name: Execute Bootstrap Playbook
  hosts: all
  tasks:
    - name: Import assert.yml
      include_tasks: assert.yml

    - name: Wait for port to be available
      wait_for:
        port: 22
        timeout: "{{ bootstrap_timeout }}"

    - name: Prepare system
      block:
        - name: Test connection
          ansible.builtin.ping:

        - name: Check if sudo is available
          command: which sudo
          register: sudo_check
          failed_when: sudo_check.rc != 0

        - name: Gather bootstrap facts and install necessary packages if checks fail
          block:
            - name: Gather bootstrap facts
              ansible.builtin.setup:

            - name: Ensure libdnf5 is present on Fedora/RedHat systems
              ansible.builtin.yum:
                name: libdnf5
                state: present
              when: ansible_facts['os_family'] == "RedHat" and ansible_facts['distribution_major_version'] | int >= 22

            - name: Install necessary bootstrap packages using raw module
              ansible.builtin.raw: yum install -y {{ item }}
              loop: "{{ bootstrap_facts_packages }}"
              when: ansible_facts['os_family'] == "RedHat"

          when: sudo_check.rc != 0 or ansible_check_mode

    - name: Gather ansible facts
      ansible.builtin.setup:

    - name: Install bootstrap packages (package)
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ bootstrap_facts_packages }}"
      become: "{{ bootstrap_become }}"


