---
- name: Assert Variables
  hosts: localhost
  tasks:
    - name: Assert variables
      include_tasks: assert.yml

- name: Wait for Host
  hosts: localhost
  tasks:
    - name: Wait for host
      wait_for:
        port: "{{ bootstrap_port | default(22) }}"
        host: "{{ ansible_host }}"
        timeout: "{{ bootstrap_timeout }}"
      when: 
        - ansible_connection != 'container'
        - ansible_connection != 'docker'
        - bootstrap_wait_for_host | default(false)

- name: Prepare System
  hosts: localhost
  tasks:
    - name: Prepare System Block
      block:
        - name: Test connection
          ansible.builtin.ping:
          register: connection_result
          ignore_errors: true

        - name: Debug connection failure
          ansible.builtin.debug:
            msg: "Connection test failed."
          when: connection_result is failed

        - name: Gather bootstrap facts
          ansible.builtin.setup:

        - name: Install bootstrap packages
          ansible.builtin.shell: "{{ bootstrap_install_command }}"
          register: bootstrap_install_result
          changed_when: bootstrap_install_result.stdout != ''
      become: "{{ bootstrap_become | default(false) }}"
      become_user: "{{ bootstrap_become_user | default(omit) }}"

- name: Ensure System Prepared
  hosts: localhost
  tasks:
    - name: Ensure System Prepared Block
      block:
        - name: Gather Ansible facts
          ansible.builtin.setup:

        - name: Install bootstrap packages
          ansible.builtin.package:
            name: "{{ bootstrap_packages }}"
            state: present
      become: "{{ bootstrap_become | default(false) }}"
      become_user: "{{ bootstrap_become_user | default(omit) }}"


