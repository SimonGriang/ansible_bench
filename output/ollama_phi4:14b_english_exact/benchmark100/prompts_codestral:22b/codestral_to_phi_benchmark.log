content='```yaml\n---\n- name: Import assert.yml\n  ansible.builtin.import_tasks:\n    file: assert.yml\n  delegate_to: localhost\n\n- name: Install prerequisites\n  ansible.builtin.package:\n    name: "{{ vault_prerequisites }}"\n    state: present\n\n- name: Include installation method specific tasks\n  ansible.builtin.include_tasks: "{{ vault_installation_method }}.yml"\n\n- name: Add Vault environment variables\n  ansible.builtin.lineinfile:\n    path: /etc/vault.d/vault.env\n    line: "{{ item }}"\n    create: yes\n  loop: "{{ vault_environment_settings }}"\n  notify: Restart Vault\n\n- name: Include hardening tasks\n  ansible.builtin.import_tasks: hardening.yml\n\n- name: Start and enable vault\n  ansible.builtin.service:\n    name: vault\n    enabled: yes\n    state: started\n  when: vault_type == "oss"\n\n- name: Enable vault\n  ansible.builtin.service:\n    name: vault\n    enabled: yes\n  when: vault_type != "oss"\n\nhandlers:\n  - name: Restart Vault\n    ansible.builtin.service:\n      name: vault\n      state: restarted\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-16T03:58:26.637352591Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4483100511, 'load_duration': 55315825, 'prompt_eval_count': 552, 'prompt_eval_duration': 286761442, 'eval_count': 248, 'eval_duration': 4139798646, 'model_name': 'phi4:14b'} id='run--3b72f2b3-5217-4aed-945c-765394859187-0' usage_metadata={'input_tokens': 552, 'output_tokens': 248, 'total_tokens': 800}
