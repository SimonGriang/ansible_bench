---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.shell: lsb_release -a
  register: bootstrap_facts
  when: not ansible_check_mode

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item[0] }}"
    bootstrap_major_version: "{{ item[1] }}"
  loop: >-
    {{ bootstrap_facts.stdout_lines
    | map('regex_replace', '^(\\w+):\\s+(\\d+.*)$', '\\1,\\2')
    | select('match', '^(Ubuntu|Debian|CentOS|Red Hat Enterprise Linux):')
    | map('split', ',') }}
  when:
    - bootstrap_facts is succeeded
    - bootstrap_distribution is not defined

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ os_family_dict[item] }}"
  loop: "{{ [bootstrap_distribution] }}"
  when:
    - bootstrap_distribution is defined
    - bootstrap_distribution in os_family_dict
  vars:
    os_family_dict:
      Ubuntu: Debian
      Debian: Debian
      CentOS: RedHat
      "Red Hat Enterprise Linux": RedHat


