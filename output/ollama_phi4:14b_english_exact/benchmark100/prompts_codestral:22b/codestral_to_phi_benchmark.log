---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
  delegate_to: localhost

- name: Install prerequisites
  ansible.builtin.package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  ansible.builtin.include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  ansible.builtin.lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item }}"
    create: true
  loop: "{{ vault_environment_settings }}"
  notify: Restart Vault

- name: Include hardening tasks
  ansible.builtin.import_tasks: hardening.yml

- name: Start and enable vault
  ansible.builtin.service:
    name: vault
    enabled: true
    state: started
  when: vault_type == "oss"

- name: Enable vault
  ansible.builtin.service:
    name: vault
    enabled: true
  when: vault_type != "oss"

handlers:
  - name: Restart Vault
    ansible.builtin.service:
      name: vault
      state: restarted


