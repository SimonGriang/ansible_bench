---
- name: Manage RKE2 Configuration
  hosts: all
  vars:
    rke2_type: "{{ rke2_type | default('server') }}"
    rke2_server_node_taints: "{{ rke2_server_node_taints | default('') }}"
    rke2_agent_node_taints: "{{ rke2_agent_node_taints | default('') }}"
    rke2_config: "{{ rke2_config | default('/path/to/config') }}"
    rke2_kubelet_config: "{{ rke2_kubelet_config | default('') }}"
    rke2_custom_registry_mirrors: "{{ rke2_custom_registry_mirrors | default('') }}"
    rke2_custom_registry_configs: "{{ rke2_custom_registry_configs | default('') }}"
    rke2_custom_registry_path: "{{ rke2_custom_registry_path | default('/path/to/registry.yaml') }}"
    rke2_service_name: "{{ rke2_service_name | default('rke2-server') }}"
    rke2_token: "{{ rke2_token | default('') }}"
    rke2_cni: "{{ rke2_cni | default('cni') }}"
    rke2_cluster_group_name: "{{ rke2_cluster_group_name | default('rke2_cluster') }}"
  tasks:
    - name: Create the RKE2 config directory
      file:
        path: /etc/rancher/rke2
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Set server taints
      when: rke2_type == 'server'
      command: "kubectl taint nodes --all node-role.kubernetes.io/master-"
      args:
        creates: "{{ lookup('file', '/etc/rancher/rke2/server_taints_done') }}"
      notify: Set server taints

    - name: Set agent taints
      when: rke2_type == 'agent'
      command: "kubectl taint nodes --all node-role.kubernetes.io/agent-"
      args:
        creates: "{{ lookup('file', '/etc/rancher/rke2/agent_taints_done') }}"
      notify: Set agent taints

    - name: Copy RKE2 config
      copy:
        src: "{{ rke2_config }}"
        dest: /etc/rancher/rke2/config.yaml
        owner: root
        group: root
        mode: '0644'
      notify: Config file changed

    - name: Copy kubelet config
      when: rke2_kubelet_config != ''
      copy:
        src: templates/kubelet-config.yaml.j2
        dest: /etc/rancher/rke2/kubelet-config.yaml
        owner: root
        group: root
        mode: '0644'
      notify: Config file changed

    - name: Copy Containerd Registry Configuration file
      when: rke2_custom_registry_mirrors != '' or rke2_custom_registry_configs != ''
      copy:
        src: "{{ rke2_custom_registry_path }}"
        dest: /etc/rancher/rke2/registries.yaml
        owner: root
        group: root
        mode: '0644'
      notify: Config file changed

    - name: Start RKE2 service on the rest of the nodes
      systemd:
        name: "{{ rke2_service_name }}"
        enabled: true
        state: started
        env:
          RKE2_TOKEN: "{{ rke2_token }}"
      notify: Service (re)started

    - name: Mask other RKE2 service on the rest of the nodes
      systemd:
        name: "{{ 'rke2-agent' if rke2_type == 'server' else 'rke2-server' }}"
        enabled: false
        masked: true

    - name: Wait for remaining nodes to be ready - no CNI
      when: rke2_cni == 'none'
      command: >
        kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' |
        grep -q 'True'
      args:
        chdir: /tmp
        executable: /bin/bash
      register: result
      until: result.rc == 0
      retries: 30
      delay: 10

    - name: Wait for remaining nodes to be ready - with CNI
      when: rke2_cni != 'none'
      command: >
        kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}' |
        grep -c 'True'
      args:
        chdir: /tmp
        executable: /bin/bash
      register: result
      until: result.stdout | int == groups[rke2_cluster_group_name] | length
      retries: 30
      delay: 10

  handlers:
    - name: Set server taints
      command: "kubectl taint nodes --all node-role.kubernetes.io/master-"

    - name: Set agent taints
      command: "kubectl taint nodes --all node-role.kubernetes.io/agent-"

    - name: Config file changed
      debug:
        msg: "Config file changed"

    - name: Service (re)started
      debug:
        msg: "Service (re)started"


