---
- name: Import assert.yml
  import_playbook: assert.yml

- name: Install using package
  block:
    - name: Set up repository for RedHat/Rocky
      ansible.builtin.yum_repository:
        name: hashicorp
        description: HashiCorp repository
        baseurl: "https://apt.releases.hashicorp.com/$(rpm -E %{rhel})/x86_64"
        gpgcheck: yes
        gpgkey: https://apt.releases.hashicorp.com/gpg
      when: ansible_facts['os_family'] == "RedHat" and (ansible_facts['distribution'] == "RedHat" or ansible_facts['distribution'] == "Rocky")
      vars:
        hashicorp_installation_method: package

    - name: Set up repository for Debian
      ansible.builtin.apt_repository:
        repo: "deb [arch=amd64] https://apt.releases.hashicorp.com $(lsb_release -cs) main"
        state: present
        filename: hashicorp
        update_cache: yes
      when: ansible_facts['os_family'] == "Debian"
      vars:
        hashicorp_installation_method: package

    - name: Install required packages
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ required_packages }}"
      vars:
        hashicorp_installation_method: package

    - name: Install HashiCorp products using package manager
      ansible.builtin.package:
        name: "{{ hashicorp_products }}"
        state: present
      vars:
        hashicorp_installation_method: package

- name: Install manually
  block:
    - name: Unarchive HashiCorp products
      ansible.builtin.unarchive:
        src: "{{ hashicorp_source_location }}"
        dest: "{{ hashicorp_destination_location }}"
        remote_src: yes
        owner: "{{ hashicorp_owner }}"
        group: "{{ hashicorp_group }}"
        mode: "{{ hashicorp_mode }}"
      when: hashicorp_installation_method == "manual"


