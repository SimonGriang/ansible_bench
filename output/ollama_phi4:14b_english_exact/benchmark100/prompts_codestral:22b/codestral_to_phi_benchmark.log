---
- name: Generate SSL certificates
  hosts: localhost
  vars:
    ssl_dir: /etc/ssl/myapp
    ssl_key_name: myapp.key
    ssl_csr_name: myapp.csr
    ssl_cert_name: myapp.crt
    ssl_pkcs12_name: myapp.p12
    ssl_combined_name: myapp_combined.key
    ssl_common_name: My Application
    ssl_owner: root
    ssl_group: root
  tasks:
    - name: Create SSL key
      openssl_privatekey:
        path: "{{ ssl_dir }}/{{ ssl_key_name }}"
        size: 2048
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: '0600'

    - name: Create SSL CSR
      openssl_csr:
        path: "{{ ssl_dir }}/{{ ssl_csr_name }}"
        privatekey_path: "{{ ssl_dir }}/{{ ssl_key_name }}"
        common_name: "{{ ssl_common_name }}"
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: '0640'

    - name: Create SSL certificates
      openssl_certificate:
        path: "{{ ssl_dir }}/{{ ssl_cert_name }}"
        privatekey_path: "{{ ssl_dir }}/{{ ssl_key_name }}"
        csr_path: "{{ ssl_dir }}/{{ ssl_csr_name }}"
        provider: selfsigned
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: '0640'

    - name: Create PKCS#12 file
      openssl_pkcs12:
        path: "{{ ssl_dir }}/{{ ssl_pkcs12_name }}"
        privatekey_path: "{{ ssl_dir }}/{{ ssl_key_name }}"
        certificate_path: "{{ ssl_dir }}/{{ ssl_cert_name }}"
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: '0600'

    - name: Read private key
      slurp:
        path: "{{ ssl_dir }}/{{ ssl_key_name }}"
      register: private_key

    - name: Read certificate
      slurp:
        path: "{{ ssl_dir }}/{{ ssl_cert_name }}"
      register: certificate

    - name: Create combined private_key and certificate file
      copy:
        content: |
          {{ private_key.content | b64decode }}
          {{ certificate.content | b64decode }}
        dest: "{{ ssl_dir }}/{{ ssl_combined_name }}"
        owner: "{{ ssl_owner }}"
        group: "{{ ssl_group }}"
        mode: '0600'


