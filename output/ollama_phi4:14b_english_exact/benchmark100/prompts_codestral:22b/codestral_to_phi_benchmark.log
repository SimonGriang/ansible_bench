---
- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: "{{ helm_bin_path }} version --short"
  ignore_errors: yes
  changed_when: no
  register: helm_existing_version

- name: Download helm
  unarchive:
    src: "{{ helm_repo_path }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: "/tmp"
    remote_src: yes
    creates: "/tmp/{{ helm_platform }}-{{ helm_arch }}/helm"
  register: helm_download
  when: not helm_check.stat.exists or (helm_existing_version.stdout != "v{{ helm_version }}" and helm_existing_version.rc == 0)

- name: Copy helm binary into place
  copy:
    src: "/tmp/{{ helm_platform }}-{{ helm_arch }}/helm"
    dest: "{{ helm_bin_path }}"
    mode: '0755'
  when: helm_download is changed


