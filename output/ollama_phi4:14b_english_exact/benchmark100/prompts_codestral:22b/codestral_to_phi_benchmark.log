---
- name: Configure HTTPD directories
  hosts: all
  become: yes
  vars:
    httpd_directories: []
    httpd_config_directory: "/etc/httpd/conf.d"
  tasks:
    - name: Create directories
      file:
        path: "{{ item }}"
        state: directory
        mode: '0755'
      loop: "{{ httpd_directories }}"

    - name: Configure directories
      template:
        src: directory.conf.j2
        dest: "{{ httpd_config_directory }}/{{ item }}.conf"
        mode: '0644'
      loop: "{{ httpd_directories }}"

    - name: Test httpd configuration validity
      command: httpd -t
      register: httpd_config_test
      changed_when: false

    - name: Restart httpd service
      service:
        name: httpd
        state: restarted
      when: httpd_config_test.rc == 0


