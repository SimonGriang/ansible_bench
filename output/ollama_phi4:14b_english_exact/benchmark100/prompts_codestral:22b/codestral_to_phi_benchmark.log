---
- name: create | Create ssl key
  openssl_privatekey:
    path: "/path/to/ssl_key.pem"
    size: 2048
    state: present
    mode: '0600'
    owner: 'ssluser'
    group: 'sslgroup'

- name: create | Create ssl csr
  openssl_csr:
    path: "/path/to/ssl_csr.csr"
    privatekey_path: "/path/to/ssl_key.pem"
    common_name: "example.com"
    country_name: "US"
    state_or_province_name: "California"
    locality_name: "San Francisco"
    organization_name: "Example Corp"
    organizational_unit_name: "IT"
    email_address: "admin@example.com"
    state: present
    mode: '0600'
    owner: 'ssluser'
    group: 'sslgroup'

- name: create | Create ssl certificates
  x509_certificate:
    path: "/path/to/ssl_cert.pem"
    privatekey_path: "/path/to/ssl_key.pem"
    csr_path: "/path/to/ssl_csr.csr"
    provider: selfsigned
    state: present
    mode: '0600'
    owner: 'ssluser'
    group: 'sslgroup'

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    dest: "/path/to/ssl_p12.p12"
    privatekey_path: "/path/to/ssl_key.pem"
    certificate_path: "/path/to/ssl_cert.pem"
    password: "your_password"
    state: present
    mode: '0600'
    owner: 'ssluser'
    group: 'sslgroup'

- name: create | Read private key
  slurp:
    path: "/path/to/ssl_key.pem"
  register: ssl_private_key

- name: create | Read certificate
  slurp:
    path: "/path/to/ssl_cert.pem"
  register: ssl_certificate

- name: create | Create combined private_key and certificate file
  copy:
    dest: "/path/to/combined_key_cert.pem"
    content: "{{ ssl_private_key.content | b64decode }}\n{{ ssl_certificate.content | b64decode }}"
    mode: '0600'
    owner: 'ssluser'
    group: 'sslgroup'


