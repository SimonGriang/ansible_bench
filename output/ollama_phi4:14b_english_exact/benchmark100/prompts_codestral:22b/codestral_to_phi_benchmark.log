---
- name: Cordon and Drain the node
  when: rke2_drain_node_during_upgrade | default(false)
  block:
    - name: Execute kubectl command to cordon the node
      command: kubectl cordon {{ inventory_hostname }}
      delegate_to: "{{ active_server | default(lookup('first', groups[rke2_servers_group_name])) }}"
    - name: Execute kubectl command to drain the node
      command: kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data
      delegate_to: "{{ active_server | default(lookup('first', groups[rke2_servers_group_name])) }}"

- name: Restart RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted

- name: Wait for all nodes to be ready again
  command: >
    kubectl get nodes --no-headers -o custom-columns=":metadata.name,Ready:.status.conditions[?(@.type=='Ready')].status" |
    grep -c "True"
  register: ready_nodes_count
  until: ready_nodes_count.stdout | int == (groups['all'] | length)
  retries: 30
  delay: 10
  delegate_to: "{{ active_server | default(lookup('first', groups[rke2_servers_group_name])) }}"

- name: Uncordon the node
  when: rke2_drain_node_during_upgrade | default(false)
  command: kubectl uncordon {{ inventory_hostname }}
  delegate_to: "{{ active_server | default(lookup('first', groups[rke2_servers_group_name])) }}"

- name: Wait for all pods to be ready again
  when: rke2_wait_for_all_pods_to_be_ready | default(false)
  command: >
    kubectl get pods --all-namespaces --field-selector=status.phase!=Running,status.phase!=Succeeded --no-headers -o name |
    wc -l
  register: not_ready_pods_count
  until: not_ready_pods_count.stdout | int == 0
  retries: 30
  delay: 10
  delegate_to: "{{ active_server | default(lookup('first', groups[rke2_servers_group_name])) }}"

- name: Wait for all pods to pass readiness checks
  when: rke2_wait_for_all_pods_to_be_healthy | default(false)
  command: >
    kubectl wait --for=condition=ready pod --all --timeout={{ rke2_wait_for_all_pods_to_be_healthy_args }}
  delegate_to: "{{ active_server | default(lookup('first', groups[rke2_servers_group_name])) }}"


