---
- name: Setup OpenVPN Easy-RSA environment
  hosts: all
  vars:
    openvpn_easyrsa_path: "/usr/local/bin/easyrsa"
    openvpn_configuration_directory: "/etc/openvpn"
    openvpn_group: "nogroup"
  tasks:
    - name: Ensure /etc/openvpn/easy-rsa directory exists
      file:
        path: /etc/openvpn/easy-rsa
        state: directory
        mode: '0755'
        owner: root
        group: root

    - name: Initialize easy-rsa
      command: "{{ openvpn_easyrsa_path }} init-pki"
      args:
        chdir: /etc/openvpn/easy-rsa
      when: not ansible_facts.stat.pki is defined or not ansible_facts.stat.pki.stat.exists

    - name: Build CA
      command: "{{ openvpn_easyrsa_path }} build-ca nopass"
      args:
        chdir: /etc/openvpn/easy-rsa
        environment:
          EASYRSA_BATCH: "yes"
      when: not ansible_facts.stat.ca_crt is defined or not ansible_facts.stat.ca_crt.stat.exists

    - name: Generate Diffie-Hellman parameters
      command: "{{ openvpn_easyrsa_path }} gen-dh"
      args:
        chdir: /etc/openvpn/easy-rsa
      when: not ansible_facts.stat.dh_pem is defined or not ansible_facts.stat.dh_pem.stat.exists

    - name: Build server certificates
      command: "{{ openvpn_easyrsa_path }} build-server-full server nopass"
      args:
        chdir: /etc/openvpn/easy-rsa
        environment:
          EASYRSA_BATCH: "yes"
      when: not ansible_facts.stat.server_crt is defined or not ansible_facts.stat.server_crt.stat.exists

    - name: Build client certificates
      command: "{{ openvpn_easyrsa_path }} build-client-full client nopass"
      args:
        chdir: /etc/openvpn/easy-rsa
        environment:
          EASYRSA_BATCH: "yes"
      when: not ansible_facts.stat.client_crt is defined or not ansible_facts.stat.client_crt.stat.exists

    - name: Generate Certificate Revocation List
      command: "{{ openvpn_easyrsa_path }} gen-crl"
      args:
        chdir: /etc/openvpn/easy-rsa
      when: not ansible_facts.stat.crl_pem is defined or not ansible_facts.stat.crl_pem.stat.exists

    - name: Generate TLS Auth Key
      command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
      when: not ansible_facts.stat.ta_key is defined or not ansible_facts.stat.ta_key.stat.exists

    - name: Copy files to /etc/openvpn/server
      copy:
        src: /etc/openvpn/easy-rsa/pki/{{ item }}
        dest: /etc/openvpn/server/
        mode: '0640'
        owner: root
        group: root
      loop:
        - ca.crt
        - server.crt
        - server.key
        - dh.pem
        - ta.key
        - crl.pem

    - name: Copy files to /etc/openvpn
      copy:
        src: /etc/openvpn/easy-rsa/pki/{{ item }}
        dest: /etc/openvpn/
        mode: '0640'
        owner: root
        group: root
      loop:
        - ca.crt
        - ta.key
        - dh.pem
        - crl.pem

    - name: Place server.conf
      template:
        src: server.conf.j2
        dest: "{{ openvpn_configuration_directory }}/server.conf"
        mode: '0640'
        owner: root
        group: "{{ openvpn_group }}"
      notify: Restart openvpn

  handlers:
    - name: Restart openvpn
      service:
        name: openvpn
        state: restarted


