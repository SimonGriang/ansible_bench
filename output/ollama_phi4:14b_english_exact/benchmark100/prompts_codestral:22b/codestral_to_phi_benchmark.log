7417424, 'load_duration': 76260816, 'prompt_eval_count': 948, 'prompt_eval_duration': 328723580, 'eval_count': 463, 'eval_duration': 8031279444, 'model_name': 'phi4:14b'} id='run--a16f996d-7bf8-46a7-b29d-5b5aaddb7666-0' usage_metadata={'input_tokens': 948, 'output_tokens': 463, 'total_tokens': 1411}
