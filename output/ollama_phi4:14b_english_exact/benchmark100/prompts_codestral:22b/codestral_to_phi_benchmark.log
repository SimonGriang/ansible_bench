---
- name: Configure Vault installation
  hosts: all
  become: yes
  vars:
    vault_group: vault_group
    vault_user: vault_user
    vault_download_path: /opt/vault
    vault_path: /usr/local/bin
    vault_directories:
      - name: dir1
        owner: vault_user
        group: vault_group
        mode: '0755'
    vault_data_directories:
      - name: data_dir1
        owner: vault_user
        group: vault_group
        mode: '0755'
    vault_tls_files:
      - path: /path/to/tls/file1
        owner: vault_user
        group: vault_group
        mode: '0644'

  tasks:
    - name: Create Vault group
      ansible.builtin.group:
        name: "{{ vault_group }}"
        state: present

    - name: Create Vault user
      ansible.builtin.user:
        name: "{{ vault_user }}"
        group: "{{ vault_group }}"
        system: true
        create_home: no

    - name: Create Vault download directory
      ansible.builtin.file:
        path: "{{ vault_download_path }}"
        state: directory
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: '0755'

    - name: Download Vault binary
      ansible.builtin.get_url:
        url: https://releases.hashicorp.com/vault/1.8.4/vault_1.8.4_linux_amd64.zip
        dest: "{{ vault_download_path }}/vault.zip"
        validate_certs: no
      register: download_result

    - name: Unarchive Vault binary
      ansible.builtin.unarchive:
        src: "{{ vault_download_path }}/vault.zip"
        dest: "{{ vault_download_path }}"
        remote_src: true
        creates: "{{ vault_download_path }}/vault"
      notify: Restart vault
      when: download_result is changed

    - name: Set ownership of Vault binary
      ansible.builtin.file:
        path: "{{ vault_download_path }}/vault"
        owner: root
        group: root
        mode: '0755'
      notify: Restart vault

    - name: Check if vault_path exists
      ansible.builtin.stat:
        path: "{{ vault_path }}"
      register: vault_path_stat

    - name: Create vault_path if it does not exist
      ansible.builtin.file:
        path: "{{ vault_path }}"
        state: directory
        owner: "{{ vault_user }}"
        group: "{{ vault_group }}"
        mode: '0755'
      when: not vault_path_stat.stat.exists and len(vault_path) > 0

    - name: Create directories in vault_path
      ansible.builtin.file:
        path: "{{ vault_path }}/{{ item.name }}"
        state: directory
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_directories }}"

    - name: Create data directories
      ansible.builtin.file:
        path: "{{ vault_path }}/data/{{ item.name }}"
        state: directory
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_data_directories }}"

    - name: Generate TLS key and certificate
      ansible.builtin.command:
        cmd: openssl req -new -newkey rsa:4096 -days 365 -nodes -x509 -subj "/CN=vault" -keyout tls.key -out tls.crt
        chdir: "{{ vault_path }}/data/tls"
      notify: Restart vault
      when: vault_path_stat.stat.exists

    - name: Set ownership of tls material
      ansible.builtin.file:
        path: "{{ vault_path }}/data/tls/{{ item.path }}"
        owner: "{{ item.owner }}"
        group: "{{ item.group }}"
        mode: "{{ item.mode }}"
      loop: "{{ vault_tls_files }}"

    - name: Copy Vault binary
      ansible.builtin.copy:
        src: "{{ vault_download_path }}/vault"
        dest: "{{ vault_path }}/usr/bin/vault"
        mode: '0755'
      notify: Restart vault

    - name: Set capabilities on /usr/bin/vault
      community.general.capabilities:
        path: "{{ vault_path }}/usr/bin/vault"
        capability: cap_ipc_lock=ep

    - name: Touch vault.env
      ansible.builtin.file:
        path: "{{ vault_path }}/etc/vault.d/vault.env"
        state: touch
        mode: '0644'
      notify: Restart vault

    - name: Create /usr/lib/systemd/system
      ansible.builtin.file:
        path: /usr/lib/systemd/system
        state: directory
        mode: '0755'

    - name: Copy Vault service file
      ansible.builtin.template:
        src: vault.service.j2
        dest: /usr/lib/systemd/system/vault.service
        mode: '0644'
      notify: Daemon reload

    - name: Copy vault configuration
      ansible.builtin.copy:
        src: vault.hcl
        dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
        mode: '0644'
      notify: Restart vault

  handlers:
    - name: Restart vault
      ansible.builtin.service:
        name: vault
        state: restarted

    - name: Daemon reload
      ansible.builtin.systemd:
        daemon_reload: true
