---
- name: Check if python is installed
  command: which python
  register: python_executable
  ignore_errors: true

- name: Check if python3 is installed
  command: which python3
  register: python3_executable
  ignore_errors: true

- name: Debug Python executable path
  debug:
    msg: "Python executable path: {{ python_executable.stdout }}"

- name: Debug Python3 executable path
  debug:
    msg: "Python3 executable path: {{ python3_executable.stdout }}"

- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install requirements
  package:
    name: "{{ openssl_requirements }}"
  when: openssl_requirements is defined

- name: Ensure packaging is available via dnf
  package:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    name: "{{ openssl_pip_packages }}"
  when: openssl_pip_packages is defined

- name: Create key directory
  file:
    path: "{{ openssl_key_directory }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
    mode: '0750'
    state: directory

- name: Create csr directory
  file:
    path: "{{ openssl_csr_directory }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
    mode: '0755'
    state: directory

- name: Create crt directory
  file:
    path: "{{ openssl_crt_directory }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
    mode: '0755'
    state: directory

- name: Include create.yml
  include_tasks: create.yml
  when: openssl_items is defined and openssl_items|length > 0
  loop: "{{ openssl_items }}"
  loop_control:
    label: "{{ item.name }}"


