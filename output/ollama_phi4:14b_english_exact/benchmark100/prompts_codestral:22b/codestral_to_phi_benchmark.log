---
- name: Disable swap
  become: true
  block:
    - name: Turn off swap
      command: swapoff -a
      when: vault_hardening_disable_swap | bool

    - name: Remove swap entry from fstab
      mount:
        name: "{{ item.device }}"
        fstype: swap
        state: absent
      with_items: "{{ ansible_mounts }}"
      when: vault_hardening_disable_swap | bool and ansible_mounts is defined

- name: Disable core dumps
  become: true
  block:
    - name: Set limits to prevent core dumps
      pam_limits:
        domain: "{{ item.domain }}"
        limit_type: "{{ item.limit_type }}"
        limit_item: "{{ item.limit_item }}"
        value: "{{ item.value }}"
      loop:
        - { domain: "*", limit_type: "hard", limit_item: "core", value: 0 }
        - { domain: "*", limit_type: "soft", limit_item: "core", value: 0 }
      when: vault_hardening_disable_core_dumps | bool

- name: Disable Shell Command History
  become: true
  block:
    - name: Copy script to disable command history
      copy:
        dest: /etc/profile.d/disable_vault_history.sh
        content: |
          export HISTIGNORE='*vault*:exit:logout:clear'
        mode: 0755
      when: vault_hardening_disable_shell_command_history | bool

- name: Configure SELinux / AppArmor
  become: true
  block:
    - name: Install SELinux policy package
      package:
        name: selinux-policy
        state: present
      when: vault_hardening_configure_selinux_apparmor | bool and
            ansible_selinux.status == "enabled"

    - name: Set SELinux policy to targeted and enforcing
      selinux:
        policy: targeted
        state: enforcing
      when: vault_hardening_configure_selinux_apparmor | bool and
            ansible_selinux.status == "enabled"

    - name: Enable AppArmor profile for vault
      command: aa-enforce /etc/apparmor.d/usr.bin.vault
      when: vault_hardening_configure_selinux_apparmor | bool and
            ansible_apparmor.status == "enabled"


