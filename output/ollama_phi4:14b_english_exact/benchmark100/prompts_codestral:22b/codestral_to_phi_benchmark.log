---
- name: Import assert.yml
  import_tasks: assert.yml
  tags: always

- name: Configure apk
  block:
    - name: Update apk cache
      apk:
        update_cache: yes
      notify: Reboot

    - name: Upgrade all software with apk
      apk:
        upgrade: yes
      notify: Reboot
  when: package_manager == 'apk'

- name: Configure apt
  block:
    - name: Prevent specific package upgrades
      apt:
        name: "{{ selected_packages }}"
        state: latest
        allow_downgrades: true
      when: prevent_upgrade | default(false)

    - name: Update apt cache
      apt:
        update_cache: yes
      notify: Reboot

    - name: Upgrade all software with apt
      apt:
        upgrade: "{{ update_upgrade_command }}"
        update_cache: yes
        cache_valid_time: "{{ update_cache_valid_time }}"
      notify: Reboot

    - name: Autoremove unused packages with apt
      apt:
        autoremove: true
      when: update_autoremove | default(false)
      notify: Reboot
  when: package_manager == 'apt'

- name: Update all software (dnf)
  block:
    - name: Upgrade all software with dnf
      dnf:
        name: "*"
        state: latest
        exclude: "{{ update_excluded_packages | default([]) }}"
      notify: Reboot
  when: package_manager in ['dnf', 'dnf5']

- name: Update all software (pacman)
  block:
    - name: Update pacman cache
      pacman:
        update_cache: yes

    - name: Upgrade all software with pacman
      pacman:
        upgrade: yes
      notify: Reboot
  when: package_manager == 'pacman'

- name: Configure yum
  block:
    - name: Install yum-utils if not on CentOS 6
      yum:
        name: yum-utils
        state: present
      when: distribution_major_version != '6'

    - name: Upgrade all software with yum
      yum:
        name: "*"
        state: latest
        exclude: "{{ update_excluded_packages | default([]) }}"
      notify: Reboot
  when: package_manager == 'yum'

- name: Update all software (zypper)
  block:
    - name: Upgrade all software with zypper
      zypper:
        name: "*"
        state: latest
      notify: Reboot
  when: package_manager == 'zypper'

handlers:
  - name: Reboot
    reboot:


