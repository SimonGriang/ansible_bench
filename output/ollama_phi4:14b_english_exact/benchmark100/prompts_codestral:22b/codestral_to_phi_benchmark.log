---
- name: Install Keepalived
  ansible.builtin.include_tasks: keepalived.yml
  when:
    - ha_mode == 'Keepalived'
    - "'RKE2_servers' in group_names"

- name: Install RKE2
  ansible.builtin.include_tasks: install_rke2.yml
  vars:
    rke2_version: "1.21.5"
  when: true

- name: Apply CIS Hardening
  ansible.builtin.include_tasks: cis.yml
  when:
    - cis_profile is defined

- name: Identify Active Server
  ansible.builtin.include_tasks: find_active_server.yml
  when: true

- name: Enable IPVS Kernel Module
  ansible.builtin.include_tasks: enable_ipvs.yml
  when:
    - ipvs_load_balancing is defined
    - ipvs_load_balancing
    - "'RKE2_servers' in group_names"
    - ha_mode == 'Kubevip'
    - ha_mode != 'Keepalived'

- name: Copy Kube-vip Manifests
  ansible.builtin.include_tasks: copy_kube_vip_manifests.yml
  when:
    - "'RKE2_servers' in group_names"
    - ha_mode == 'Kubevip'
    - ha_mode != 'Keepalived'
    - inventory_hostname == groups['RKE2_servers'][0]

- name: Copy Ingress-nginx Manifests
  ansible.builtin.include_tasks: copy_ingress_nginx_manifests.yml
  when:
    - "'RKE2_servers' in group_names"
    - ingress_nginx_values is defined
    - inventory_hostname == groups['RKE2_servers'][0]

- name: Prepare First Server Node
  ansible.builtin.include_tasks: prepare_first_server.yml
  when:
    - "'RKE2_servers' in group_names"
    - (active_server is undefined or inventory_hostname == active_server)
    - groups['RKE2_servers'] | length == 1

- name: Restore etcd
  ansible.builtin.include_tasks: first_server_restore.yml
  when:
    - active_server is defined
    - (inventory_hostname == active_server or inventory_hostname ==
        groups['RKE2_servers'][0])
    - etcd_restore_needed

- name: Download kubeconfig
  ansible.builtin.include_tasks: download_kubeconfig.yml
  when:
    - kubeconfig_download is defined
    - kubeconfig_download
    - inventory_hostname == groups['RKE2_servers'][0]

- name: Prepare and Join Remaining Nodes
  ansible.builtin.include_tasks: prepare_and_join_nodes.yml
  when:
    - active_server is defined
    - groups['RKE2_servers'] | length >= 2

- name: Rolling Restart Servers
  ansible.builtin.include_tasks: rolling_restart.yml
  when:
    - installed_version != running_version_servers

- name: Rolling Restart Agents
  ansible.builtin.include_tasks: rolling_restart.yml
  when:
    - installed_version != running_version_agents
    - "'RKE2_servers' not in group_names"

- name: Flush Handlers
  ansible.builtin.meta: flush_handlers

- name: Rolling Restart Config Change
  ansible.builtin.include_tasks: change_config.yml
  when:
    - restart_due_to_config_change

- name: Final Steps
  ansible.builtin.include_tasks: final_steps.yml
  when: true


