---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install DNS
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ dns_packages }}"

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ dns_directories }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_user }}"
    system: yes
    group: "{{ dns_group }}"
    create_home: no
    shell: "/sbin/nologin"

- name: Generate rndc key
  command: rndc-confgen -a -r /dev/urandom -k {{ dns_rndc_key_path }}
  args:
    creates: "{{ dns_rndc_key_path }}"
  notify: restart dns

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_rndc_key_path }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0400'

- name: Get the hints/root file
  get_url:
    url: "{{ dns_hints_url }}"
    dest: "{{ dns_data_directory }}/hints.root"
  when: dns_cache_enabled

- name: Create zone file
  template:
    src: "{{ item.template }}"
    dest: "{{ dns_data_directory }}/{{ item.zone }}"
  loop: "{{ primary_zones }}"
  when: item.primary | default(false)

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_config_directory }}/named.conf"
  notify: restart dns

- name: Place systemd override
  copy:
    content: |
      [Service]
      ProtectHome=true
    dest: "/etc/systemd/system/dnsmasq.service.d/override.conf"
  when: ansible_service_mgr == 'systemd'
  notify: reload systemd

- name: Start and enable DNS
  service:
    name: "{{ dns_service_name }}"
    state: started
    enabled: yes



