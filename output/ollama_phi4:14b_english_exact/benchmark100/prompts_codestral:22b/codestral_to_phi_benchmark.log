        mode: '0755'
        owner: root
        group: root

    - name: Initialize easy-rsa
      command: "{{ openvpn_easyrsa_path }} init-pki"
      args:
        chdir: /etc/openvpn/easy-rsa
      when: not ansible_facts.stat['/etc/openvpn/easy-rsa/pki'].exists

    - name: Build CA
