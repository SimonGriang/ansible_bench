\n      ansible.builtin.file:\n        path: "{{ vault_path }}/etc/vault.d/vault.env"\n        state: touch\n        mode: \'0644\'\n      notify: Restart vault\n\n    - name: Create /usr/lib/systemd/system\n      ansible.builtin.file:\n        path: /usr/lib/systemd/system\n        state: directory\n        mode: \'0755\'\n\n    - name: Copy Vault service file\n      ansible.builtin.template:\n        src: vault.service.j2\n        dest: /usr/lib/systemd/system/vault.service\n        mode: \'0644\'\n      notify: Daemon reload\n\n    - name: Copy vault configuration\n      ansible.builtin.copy:\n        src: vault.hcl\n        dest: "{{ vault_path }}/etc/vault.d/vault.hcl"\n        mode: \'0644\'\n      notify: Restart vault\n\n  handlers:\n    - name: Restart vault\n      ansible.builtin.service:\n        name: vault\n        state: restarted\n\n    - name: Daemon reload\n      ansible.builtin.systemd:\n        daemon_reload: yes\n```\n\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-16T03:56:50.189792262Z', 'done': True, 'done_reason': 'stop', 'total_duration': 21303774754, 'load_duration': 63301322, 'prompt_eval_count': 2252, 'prompt_eval_duration': 8856909, 'eval_count': 1151, 'eval_duration': 21230204494, 'model_name': 'phi4:14b'} id='run--4c2fbc8e-98d6-4554-bed4-e1e69eeee9ab-0' usage_metadata={'input_tokens': 2252, 'output_tokens': 1151, 'total_tokens': 3403}
