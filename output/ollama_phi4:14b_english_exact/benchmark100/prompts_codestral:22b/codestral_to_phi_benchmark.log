- name: MySQL Setup and Configuration
  hosts: localhost
  vars:
    mysql_packages: []
    mysql_configuration_destination: {}
    mysql_configuration_options: {}
    mysql_initialize_command: ""
    mysql_service: ""
    mysql_databases: []
    mysql_users: []
    mysql_socket: ""
    mysql_root_password: ""
  tasks:

    - name: Import assert.yml
      import_tasks: assert.yml

    - name: Install mysql
      package:
        name: "{{ mysql_packages }}"
        state: present
      notify:
        - Set root password
        - Systemctl daemon-reexec

    - name: Configure mysql server
      lineinfile:
        path: "{{ mysql_configuration_destination['mysql-server.cnf'] }}"
        regexp: "^{{ item.key }} =.*"
        line: "{{ item.key }} = {{ item.value }}"
      with_dict: "{{ mysql_configuration_options }}"
      notify:
        - Restart mysql server

    - name: Configure mysql client
      lineinfile:
        path: "{{ mysql_configuration_destination['mysql-client.cnf'] }}"
        regexp: "^socket =.*"
        line: "socket = {{ mysql_socket }}"
        
    - name: Initialize mysql
      command: "{{ mysql_initialize_command }}"
      when: ansible_distribution in ['Alpine', 'Archlinux']

    - name: Start and enable mysql
      service:
        name: "{{ mysql_service }}"
        enabled: yes
        state: started

    - name: Flush handlers
      meta: flush_handlers

    - name: Place my.cnf
      template:
        src: my.cnf.j2
        dest: /root/my.cnf
        mode: '0640'

    - name: Create databases
      mysql_db:
        name: "{{ item.name }}"
        state: present
      loop: "{{ mysql_databases }}"
      when: mysql_databases is defined
      notify: Restart mysql server
      vars:
        login_unix_socket: "{{ mysql_socket }}"
        login_password: "{{ mysql_root_password }}"

    - name: Create users
      mysql_user:
        name: "{{ item.name }}"
        host: "{{ item.host | default('localhost') }}"
        password: "{{ item.password }}"
        priv: "{{ item.priv | default('*.*:ALL,GRANT') }}"
        state: present
      loop: "{{ mysql_users }}"
      when: mysql_users is defined
      notify: Restart mysql server
      vars:
        login_unix_socket: "{{ mysql_socket }}"
        login_password: "{{ mysql_root_password }}"

    - name: Flush handlers again
      meta: flush_handlers

  handlers:
    - name: Set root password
      # Handler logic to set root password

    - name: Systemctl daemon-reexec
      command: systemctl daemon-reexec

    - name: Restart mysql server
      service:
        name: "{{ mysql_service }}"
        state: restarted


