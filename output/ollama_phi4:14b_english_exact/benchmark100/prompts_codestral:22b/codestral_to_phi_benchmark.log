---
- name: Configure Keepalived
  hosts: all
  gather_facts: true
  tasks:
    - name: Update package cache for apt
      apt:
        update_cache: true
      when: ansible_pkg_mgr == 'apt'

    - name: Update package cache for dnf
      dnf:
        update_cache: true
      when: ansible_pkg_mgr == 'dnf'

    - name: Install keepalived package
      package:
        name: keepalived
        state: present

    - name: Create keepalived directory
      file:
        path: /etc/keepalived
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Create Kubernetes API health check script for Debian OS family
      template:
        src: kubernetes_api_health_check_debian.j2
        dest: /etc/keepalived/kubernetes_api_health_check
        owner: root
        group: root
        mode: '0755'
      when: ansible_os_family == 'Debian'
      notify:
        - Restart keepalived

    - name: Create Kubernetes API health check script for RedHat OS family
      template:
        src: kubernetes_api_health_check_redhat.j2
        dest: /usr/libexec/keepalived/kubernetes_api_health_check
        owner: root
        group: root
        mode: '0755'
      when: ansible_os_family == 'RedHat'
      notify:
        - Restart keepalived

    - name: Create RKE2 Server health check script for Debian OS family
      template:
        src: rke2_server_health_check_debian.j2
        dest: /etc/keepalived/rke2_server_health_check
        owner: root
        group: root
        mode: '0755'
      when: ansible_os_family == 'Debian'
      notify:
        - Restart keepalived

    - name: Create RKE2 Server health check script for RedHat OS family
      template:
        src: rke2_server_health_check_redhat.j2
        dest: /usr/libexec/keepalived/rke2_server_health_check
        owner: root
        group: root
        mode: '0755'
      when: ansible_os_family == 'RedHat'
      notify:
        - Restart keepalived

    - name: Create keepalived configuration file
      template:
        src: keepalived.conf.j2
        dest: /etc/keepalived/keepalived.conf
        owner: root
        group: root
        mode: '0644'
      notify:
        - Restart keepalived

    - name: Enable and unmask keepalived service
      systemd:
        name: keepalived
        enabled: true
        masked: false
      notify:
        - Restart keepalived

  handlers:
    - name: Restart keepalived
      service:
        name: keepalived
        state: restarted

- name: Flush handlers
  meta: flush_handlers


