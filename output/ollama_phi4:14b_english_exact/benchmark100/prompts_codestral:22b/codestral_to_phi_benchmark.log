---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip packages
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    line: "index-url = {{ python_pip_proxy }}"
    state: present
    create: yes
    mode: '0644'
  when: python_pip_proxy is defined

- name: Trust pip hosts
  lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    state: present
    create: yes
    mode: '0644'
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable | default(omit) }}"
  when:
    - python_pip_update | bool
    - ansible_distribution not in ['Bookworm', 'Noble']
    - ansible_os_family != 'Alpine'

- name: Install requested python pip modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(omit) }}"
    executable: "{{ python_pip_executable | default(omit) }}"
  loop: "{{ python_pip_modules }}"
  when:
    - ansible_distribution not in ['Bookworm', 'Noble']
    - ansible_os_family != 'Alpine'
  loop_control:
    label: "{{ item.name }}"


