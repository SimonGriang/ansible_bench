    key: "{{ item.key }}"
  loop: "{{ unauthorized_keys | default([]) }}"

- name: Copy private key to .ssh directory
  ansible.builtin.copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}/id_rsa"
    dest: "{{ user_info.getent_passwd[1] | default('/home') }}/.ssh/id_rsa"
    owner: "{{ user.name }}"
    mode: '0400'
  when: copy_private_key | default(false) | bool
  become: true
  become_user: "{{ user.name }}"

- name: Check password valid time for user
  ansible.builtin.command:
    cmd: "awk 'BEGIN { FS = \":\" } $1 == \"{{ user.name }}\" { print $5 }' /etc/shadow"
  register: password_valid_time

- name: Set password valid time for user
  ansible.builtin.command:
    cmd: "chage -M \"{{ user.password_validity_days }}\" \"{{ user.name }}\""
  when: 
    - password_validity_days is defined
    - password_valid_time.stdout != user.password_validity_days

- name: Place private key file in .ssh directory
  ansible.builtin.copy:
    content: "{{ item.content }}"
    dest: "{{ user_info.getent_passwd[1] | default('/home') }}/.ssh/{{ item.filename }}"
    owner: "{{ user.name }}"
    mode: '0400'
  loop: "{{ private_keys | default([]) }}"
  when: private_keys is defined
  become: true
  become_user: "{{ user.name }}"


