---
- name: Enable modules
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
  loop:
    - apache2
    - libapache2-mod-proxy-html
  when: ansible_os_family == "Debian"

- name: Enable modules
  community.general.zypper:
    name: "{{ item }}"
    state: present
  loop:
    - apache2
    - apache2-mod_proxy_html
  when: ansible_os_family == "Suse"

- name: Configure locations
  ansible.builtin.template:
    src: locations.conf.j2
    dest: "{{ httpd_config_directory }}/locations.conf"
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd


