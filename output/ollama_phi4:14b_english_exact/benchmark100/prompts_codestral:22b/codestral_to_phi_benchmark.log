content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n\n- name: Install required packages\n  package:\n    name: "{{ selinux_requirements }}"\n    state: present\n  notify: Gather facts\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Configure selinux\n  block:\n    - name: Manage SELinux state and policy\n      selinux:\n        policy: "{{ selinux_policy }}"\n        state: "{{ selinux_state }}"\n      notify: Reboot\n\n    - name: Manage SELinux booleans\n      selinux:\n        name: "{{ item.name }}"\n        state: "{{ item.state | default(\'present\') }}"\n        persistent: "{{ item.persistent | default(false) }}"\n      loop: "{{ selinux_booleans | default([]) }}"\n  when: selinux_status is defined and ansible_connection not in [\'container\', \'docker\', \'community.docker.docker\']\n```\n\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-16T04:07:14.065328371Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3040451159, 'load_duration': 49627800, 'prompt_eval_count': 483, 'prompt_eval_duration': 48496145, 'eval_count': 190, 'eval_duration': 2941037431, 'model_name': 'phi4:14b'} id='run--9e946caa-f25d-4506-aa86-536c0ff29f83-0' usage_metadata={'input_tokens': 483, 'output_tokens': 190, 'total_tokens': 673}
