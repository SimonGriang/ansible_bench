---
- name: Configure Git with Ansible Role
  hosts: all
  become: true
  tasks:

    - name: Assert role variables
      include_tasks: assert.yml

    - name: Install git
      package:
        name: "{{ git_packages }}"
        state: present

    - name: Check if user exists
      user_info:
        name: "{{ git_username }}"
      register: user_info

    - name: Create user's home directory
      file:
        path: "{{ user_info.home }}"
        state: directory
        owner: "{{ git_username }}"
        group: "{{ git_username }}"
        mode: '0755'
      when: user_info.user is defined

    - name: Configure git
      template:
        src: git_config.j2
        dest: "{{ user_info.home }}/.gitconfig"
      when:
        - user_info.user is defined
        - git_user_email is defined
        - git_user_name is defined
        - lookup('file', 'git_config.j2', errors='ignore') is defined

    - name: Create repository destination
      file:
        path: "{{ git_repo_destination }}"
        state: directory
        owner: "{{ git_username }}"
        group: "{{ git_username }}"
        mode: '0755'
      when:
        - user_info.user is defined
        - git_repo_destination is defined

    - name: Clone repositories
      git:
        repo: "{{ item.repo }}"
        dest: "{{ git_repo_destination }}"
        version: "{{ item.branch | default('master') }}"
        depth: 1
        force: yes
      with_items: "{{ git_repositories }}"
      become_user: "{{ git_username }}"
      when:
        - user_info.user is defined
        - git_repo_destination is defined
        - git_repositories is defined


