- name: Import assert.yml
  import_playbook: assert.yml
  hosts: localhost

- name: Enable redis module stream (RHEL 8)
  hosts: rhel8
  tasks:
    - name: Enable redis module stream
      dnf:
        name: redis
        state: enabled

- name: Install redis
  hosts: all
  tasks:
    - name: Install redis
      package:
        name: "{{ redis_packages }}"
        state: present

