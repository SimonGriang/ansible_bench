---
- name: Ensure apt key is not present
  ansible.builtin.apt_key:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent
  tags:
    - docker_cleanup

- name: Ensure old apt source list is not present
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent
  tags:
    - docker_cleanup

- name: Ensure old versions of Docker are not installed
  ansible.builtin.package:
    name: "{{ item }}"
    state: absent
  loop:
    - docker
    - docker-engine
    - docker.io
    - containerd
    - runc
  tags:
    - docker_cleanup

- name: Ensure legacy repo file is not present
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent
  tags:
    - docker_cleanup

- name: Ensure dependencies are installed
  ansible.builtin.apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
  tags:
    - docker_install

- name: Add or remove Docker repository
  ansible.builtin.block:
    - name: Add Docker repository
      ansible.builtin.apt_repository:
        repo: deb [arch={{ ansible_architecture }} signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/{{ ansible_distribution | lower }} {{ ansible_distribution_release }} stable
        state: present
      when: docker_add_repo | default(false)
      notify: Update apt cache
    - name: Remove Docker repository
      ansible.builtin.file:
        path: /etc/apt/sources.list.d/docker.list
        state: absent
      when: not docker_add_repo | default(false)
  tags:
    - docker_repo

- name: Ensure handlers are notified immediately to update the apt cache
  ansible.builtin.meta: flush_handlers
  tags:
    - docker_install

handlers:
  - name: Update apt cache
    ansible.builtin.apt:
      update_cache: yes


