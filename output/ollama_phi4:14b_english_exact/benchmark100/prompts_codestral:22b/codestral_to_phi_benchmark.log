---
- name: Create directories
  file:
    path: /opt/cadvisor
    state: directory
    mode: '0755'
    owner: cadvisor
    group: cadvisor

- name: Download cadvisor binary
  get_url:
    url: https://example.com/cadvisor-binary
    dest: /opt/cadvisor/cadvisor
    checksum: sha256:1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
    mode: '0755'

- name: Propagate locally distributed cadvisor binary
  copy:
    src: /local/path/to/cadvisor
    dest: /opt/cadvisor/cadvisor
    mode: '0755'
    owner: cadvisor
    group: cadvisor
  notify:
    - Restart cadvisor service

- name: Create a symlink
  file:
    src: /opt/cadvisor/cadvisor
    dest: /usr/local/bin/cadvisor
    state: link

- name: Configure cadvisor systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
  notify:
    - Restart cadvisor service

- name: Check cadvisor service status
  command: >
    systemctl status cadvisor

- name: Enable cadvisor systemd service
  systemd:
    name: cadvisor
    enabled: true

- name: Start cadvisor systemd service
  systemd:
    name: cadvisor
    state: started
    daemon_reload: true

handlers:
  - name: Restart cadvisor service
    systemd:
      name: cadvisor
      state: restarted


