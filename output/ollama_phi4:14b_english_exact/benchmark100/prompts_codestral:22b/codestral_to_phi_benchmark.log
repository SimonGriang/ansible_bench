---
- name: Manage EFI and GRUB configurations
  hosts: all
  become: true
  vars:
    grub_user: "{{ lookup('env', 'GRUB_USER') }}"
    grub_password: "{{ lookup('env', 'GRUB_PASSWORD') }}"
    grub_password_unrestricted: "{{ lookup('env', 'GRUB_PASSWORD_UNRESTRICTED') }}"
    grub_password_unrestricted_files:
      - /etc/grub2.cfg
      - /etc/grub2-efi.cfg

  tasks:
    - name: password | Get efi path
      stat:
        path: /boot/efi
      register: efi_exists

    - name: password | Remove unwanted grub.cfg on EFI systems
      file:
        path: /boot/efi/EFI/GRUB/grub.cfg
        state: absent
      when: efi_exists.stat.exists

    - name: password | Install user template
      template:
        src: 01_users.j2
        dest: /etc/grub.d/01_users
        mode: '0644'

    - name: password | EFI | add password
      lineinfile:
        path: /etc/grub2-efi.cfg
        line: "set superusers={{ grub_user }}\npassword_pbkdf2 {{ grub_user }} {{ grub_password }}"
      when: efi_exists.stat.exists

    - name: password | MBR | add password
      lineinfile:
        path: /etc/grub2.cfg
        line: "set superusers={{ grub_user }}\npassword_pbkdf2 {{ grub_user }} {{ grub_password }}"
      when: efi_exists.stat.exists

    - name: password | Add --unrestricted
      lineinfile:
        path: "{{ item }}"
        line: "set menu_option_ignore=\"--unrestricted\""
        insertafter: "set superusers"
      loop: "{{ grub_password_unrestricted_files }}"
      when: grub_password_unrestricted | bool and efi_exists.stat.exists


