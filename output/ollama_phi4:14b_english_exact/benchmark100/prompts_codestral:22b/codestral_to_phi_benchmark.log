content='```yaml\n---\n- name: Prepare summary\n  hosts: "{{ rke2_servers_group_name }}"\n  tasks:\n    - name: Retrieve Kubernetes nodes summary\n      shell: rke2 rke2-kubectl get nodes --output=wide --show-labels\n      register: nodes_summary\n      until: nodes_summary is succeeded\n      retries: 5\n      delay: 5\n      delegate_to: "{{ groups[\'rke2_servers_group_name\'][0] }}"\n\n- name: K8s nodes state\n  hosts: localhost\n  tasks:\n    - name: Display Kubernetes nodes state\n      debug:\n        var: nodes_summary.stdout\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-16T05:13:54.72777194Z', 'done': True, 'done_reason': 'stop', 'total_duration': 1979636807, 'load_duration': 52729544, 'prompt_eval_count': 375, 'prompt_eval_duration': 36046144, 'eval_count': 137, 'eval_duration': 1890025858, 'model_name': 'phi4:14b'} id='run--dba8769d-00f7-46f5-9dfb-8ed02a350650-0' usage_metadata={'input_tokens': 375, 'output_tokens': 137, 'total_tokens': 512}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Prepare summary
  hosts: "{{ rke2_servers_group_name }}"
  tasks:
    - name: Retrieve Kubernetes nodes summary
      shell: rke2 rke2-kubectl get nodes --output=wide --show-labels
      register: nodes_summary
      until: nodes_summary is succeeded
      retries: 5
      delay: 5
      delegate_to: "{{ groups['rke2_servers_group_name'][0] }}"

- name: K8s nodes state
  hosts: localhost
  tasks:
    - name: Display Kubernetes nodes state
      debug:
        var: nodes_summary.stdout


