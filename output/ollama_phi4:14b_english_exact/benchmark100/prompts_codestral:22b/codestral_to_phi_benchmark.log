          get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded
          --ignore-not-found | wc -l
      register: result
      until: result.stdout == "0"
      retries: 30
      delay: 10
      run_once: true
      check_mode: false
      when: rke2_wait_for_all_pods_to_be_ready


