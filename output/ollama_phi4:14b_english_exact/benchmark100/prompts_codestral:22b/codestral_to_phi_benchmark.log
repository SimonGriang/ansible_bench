---
- name: Install epel
  ansible.builtin.package:
    name: epel-release
    state: present
  when: ansible_distribution == "Amazon" and ansible_distribution_major_version == "2" or 
        (ansible_distribution in ["RedHat", "CentOS"] and ansible_distribution_major_version in ["7", "8", "9", "10"])
  tags: epel

- name: Install epel gpg key
  ansible.builtin.apt_key:
    url: "{{ epel_gpg_key }}"
    state: present
  when: ansible_os_family == "RedHat"
  tags: epel_gpg_key

- name: Install epel-release
  ansible.builtin.yum_repository:
    name: epel
    description: Extra Packages for Enterprise Linux
    baseurl: "{{ epel_url }}"
    gpgcheck: yes
    gpgkey: file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version|int }}
    state: present
  when: ansible_distribution in ["RedHat", "CentOS"]
  notify: Update package cache
  tags: epel_release

- name: Install epel-next-release
  ansible.builtin.yum_repository:
    name: epel-next
    description: Extra Packages for Enterprise Linux - next release
    baseurl: "{{ epel_next_url }}"
    gpgcheck: yes
    gpgkey: file:///etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version|int }}
    state: present
  when: epel_next | bool and ansible_distribution in ["RedHat", "CentOS"]
  notify: Update package cache
  tags: epel_next_release


