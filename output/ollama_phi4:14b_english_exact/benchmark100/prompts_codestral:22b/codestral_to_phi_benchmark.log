content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  hosts: localhost\n\n- name: Install cron\n  package:\n    name: "{{ cron_packages }}"\n    state: present\n\n- name: Configure shell\n  lineinfile:\n    path: "{{ cron_configuration }}"\n    line: "SHELL={{ cron_shell }}"\n    create: yes\n    mode: \'0600\'\n  notify: Restart cron\n\n- name: Configure path\n  lineinfile:\n    path: "{{ cron_configuration }}"\n    line: "PATH={{ cron_path }}"\n    create: yes\n    mode: \'0600\'\n  notify: Restart cron\n\n- name: Configure mailto\n  lineinfile:\n    path: "{{ cron_configuration }}"\n    line: "MAILTO={{ cron_mailto }}"\n    create: yes\n    mode: \'0600\'\n  notify: Restart cron\n\n- name: Start and enable cron\n  service:\n    name: "{{ cron_service }}"\n    state: started\n    enabled: yes\n  when: cron_service is defined and cron_service != \'\'\n\n- name: Schedule requested cron jobs\n  cron:\n    name: "{{ item.name }}"\n    job: "{{ item.job }}"\n    minute: "{{ item.minute | default(omit) }}"\n    hour: "{{ item.hour | default(omit) }}"\n    day: "{{ item.day | default(omit) }}"\n    month: "{{ item.month | default(omit) }}"\n    weekday: "{{ item.weekday | default(omit) }}"\n    special_time: "{{ item.special_time | default(omit) }}"\n    state: "{{ item.state | default(\'present\') }}"\n    user: "{{ item.user | default(ansible_user_id) }}"\n  loop: "{{ cron_jobs }}"\n  when: cron_jobs is defined\n```\n\nThis playbook is structured to be included in an Ansible Role under `tasks/main.yml`. Each task corresponds to the provided descriptions and adheres to the specified requirements, using the exact task names and module calls as described.' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-16T05:32:39.916782419Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6334332337, 'load_duration': 63597965, 'prompt_eval_count': 778, 'prompt_eval_duration': 266355544, 'eval_count': 408, 'eval_duration': 6003275532, 'model_name': 'phi4:14b'} id='run--108f610f-3873-48de-a8b8-8161c88fbf7a-0' usage_metadata={'input_tokens': 778, 'output_tokens': 408, 'total_tokens': 1186}
