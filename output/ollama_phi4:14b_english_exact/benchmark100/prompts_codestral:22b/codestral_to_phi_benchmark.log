---
- name: Import assert.yml
  include_tasks: assert.yml
  when: inventory_hostname == "localhost"

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
    config_load: yes
    config_enforced: yes
    config_policy: "{{ selinux_policy }}"
  when: selinux is defined and ansible_connection not in ['container', 'docker', 'community.docker']
  notify: Reboot

- name: Manage selinux booleans
  selinux:
    name: "{{ item.name }}"
    state: "{{ item.state | default('yes') }}"
    persistent: "{{ item.persistent | default(omit) }}"
  loop: "{{ selinux_booleans }}"
  when: selinux_booleans is defined

handlers:
  - name: Gather facts
    setup:

  - name: Reboot
    reboot:


