---
- name: Load OS-specific vars
  include_vars: "{{ ansible_distribution }}-{{ ansible_os_family }}.yml"

- name: Include OS-specific setup tasks for RedHat
  include_tasks: setup-RedHat.yml
  when: ansible_os_family == "RedHat"

- name: Include OS-specific setup tasks for Debian
  include_tasks: setup-Debian.yml
  when: ansible_os_family == "Debian"

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  when: ansible_version.full is version('<2.12') or ansible_os_family not in ['RedHat', 'Debian']
  ignore_errors: yes

- name: Install Docker packages with downgrade option
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: true
  notify: restart docker
  when: ansible_version.full is version('>=2.12') and ansible_os_family in ['RedHat', 'Debian']
  ignore_errors: yes

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  when:
    - docker_install_compose_plugin | bool
    - ansible_version.full is version('<2.12') or ansible_os_family not in ['RedHat', 'Debian']
  ignore_errors: yes

- name: Install docker-compose-plugin with downgrade option
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: true
  notify: restart docker
  when:
    - docker_install_compose_plugin | bool
    - ansible_version.full is version('>=2.12') and ansible_os_family in ['RedHat', 'Debian']
  ignore_errors: yes

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker
    state: directory
    mode: '0755'
  when: docker_daemon_options is defined and docker_daemon_options.keys() | length > 0

- name: Configure Docker daemon options
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_nice_json }}"
    owner: root
    group: root
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options is defined and docker_daemon_options.keys() | length > 0

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  when: docker_service_manage | bool
  ignore_errors: yes

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose | bool

- name: Get docker group info using getent
  command: getent group docker
  register: docker_group_info
  when: docker_users is defined and docker_users | length > 0

- name: Check if there are any users to add to the docker group
  set_fact:
    at_least_one_user_to_modify: true
  when:
    - docker_users is defined and docker_users | length > 0
    - docker_group_info.stdout is search('^(?:.*:)?{{ docker_users | join(")(?:.*:)?|") }}:')

- name: Include docker-users tasks
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify is defined


