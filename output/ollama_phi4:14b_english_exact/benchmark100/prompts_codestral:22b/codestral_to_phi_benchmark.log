---
- name: Manage Docker Compose installation
  hosts: all
  vars:
    docker_compose_version: "1.29.2"  # Example desired version
    docker_compose_url: "https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-{{ ansible_system }}-{{ ansible_architecture }}"
    docker_compose_path: "/usr/local/bin/docker-compose"

  tasks:
    - name: Check current docker-compose version
      command: docker-compose --version
      register: docker_compose_vsn
      ignore_errors: yes

    - name: Set fact for current docker-compose version
      set_fact:
        docker_compose_current_version: "{{ docker_compose_vsn.stdout.split()[-1] }}"
      when: docker_compose_vsn is defined and docker_compose_vsn.stdout is not empty

    - name: Remove existing docker-compose version if it's different
      file:
        path: "{{ docker_compose_path }}"
        state: absent
      when: docker_compose_current_version is defined and docker_compose_current_version != docker_compose_version

    - name: Install Docker Compose (if configured)
      block:
        - name: Download Docker Compose binary
          get_url:
            url: "{{ docker_compose_url }}"
            dest: "{{ docker_compose_path }}"
            mode: '0755'
          when: docker_compose_current_version is not defined or docker_compose_current_version == "" or docker_compose_current_version < docker_compose_version


