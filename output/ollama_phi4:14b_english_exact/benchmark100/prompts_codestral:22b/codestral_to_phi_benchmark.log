---
- name: Create local SSH key directory
  ansible.builtin.file:
    path: "{{ users_ssh_key_directory }}/{{ user.name }}"
    state: directory
    mode: '0750'
  when: manage_ssh_key | default(false) | bool

- name: Manage user account
  ansible.builtin.user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment | default(omit) }}"
    create_home: "{{ user.create_home | default(true) }}"
    password: "{{ user.password | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    home: "{{ user.home | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    update_password: "{{ user.update_password | default('always') }}"
    expires: "{{ user.expires | default(omit) }}"
    system: "{{ user.system | default(false) | bool }}"

- name: Set sudo options for user
  ansible.builtin.template:
    src: sudo.j2
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: '0640'
    validate: '/usr/sbin/visudo --check --file %s'
  when: sudo_options is defined

- name: Remove sudo options for user
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: sudo_options is not defined

- name: Generate private SSH key for user
  ansible.builtin.command:
    cmd: "{{ users_ssh_keygen_command }}"
    chdir: "{{ users_ssh_key_directory }}/{{ user.name }}"
  when: manage_ssh_key | default(false) | bool
  delegate_to: localhost

- name: Generate public SSH key for user
  ansible.builtin.shell:
    cmd: "{{ users_ssh_keygen_pubkey_command }}"
    chdir: "{{ users_ssh_key_directory }}/{{ user.name }}"
  when: manage_ssh_key | default(false) | bool
  delegate_to: localhost

- name: Convert private SSH key to ppk format
  ansible.builtin.shell:
    cmd: |
      ssh-keygen -e -f "{{ users_ssh_key_directory }}/{{ user.name }}/id_rsa"
      -C "Generated by Ansible role robertdebock.users"
    chdir: "{{ users_ssh_key_directory }}/{{ user.name }}"
  when: manage_ssh_key | default(false) | bool
  delegate_to: localhost

- name: Get or set home directory for user
  ansible.builtin.getent:
    database: passwd
    key: "{{ user.name }}"
  register: user_info
  failed_when: user_info.failed
  changed_when: user_info.changed

- name: Create .ssh directory for user
  ansible.builtin.file:
    path: "{{ user_info.getent_passwd[1] | default('/home') }}/.ssh"
    state: directory
    mode: '0700'
  when: manage_ssh_key | default(false) | bool or private_keys is defined
  become: true
  become_user: "{{ user.name }}"

- name: Deploy authorized keys for user
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    state: "{{ item.state | default('present') }}"
    key: "{{ item.key }}"
  loop: "{{ authorized_keys | default([]) }}"

- name: Remove unauthorized keys for user
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item.key }}"
  loop: "{{ unauthorized_keys | default([]) }}"

- name: Copy private key to .ssh directory
  ansible.builtin.copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}/id_rsa"
    dest: "{{ user_info.getent_passwd[1] | default('/home') }}/.ssh/id_rsa"
    owner: "{{ user.name }}"
    mode: '0400'
  when: copy_private_key | default(false) | bool
  become: true
  become_user: "{{ user.name }}"

- name: Check password valid time for user
  ansible.builtin.command:
    cmd: "awk 'BEGIN { FS = \":\" } $1 == \"{{ user.name }}\" { print $5 }' /etc/shadow"
  register: password_valid_time

- name: Set password valid time for user
  ansible.builtin.command:
    cmd: "chage -M \"{{ user.password_validity_days }}\" \"{{ user.name }}\""
  when: 
    - password_validity_days is defined
    - password_valid_time.stdout != user.password_validity_days

- name: Place private key file in .ssh directory
  ansible.builtin.copy:
    content: "{{ item.content }}"
    dest: "{{ user_info.getent_passwd[1] | default('/home') }}/.ssh/{{ item.filename }}"
    owner: "{{ user.name }}"
    mode: '0400'
  loop: "{{ private_keys | default([]) }}"
  when: private_keys is defined
  become: true
  become_user: "{{ user.name }}"
