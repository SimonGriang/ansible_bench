---
- name: Manage MySQL installation and configuration
  hosts: localhost
  become: yes
  vars:
    mysql_packages: []
    mysql_configuration_options: []
    mysql_socket: ""
    mysql_initialize_command: ""
    mysql_databases: []
    mysql_root_password: ""
    mysql_users: []

  tasks:
    - name: Import assert.yml
      include_vars:
        file: assert.yml
        name: assert

    - name: Install mysql
      package:
        name: "{{ mysql_packages }}"
        state: present
      notify: 
        - Set root password
        - Reexecute systemd daemon

    - name: Configure mysql server
      blockinfile:
        path: /etc/mysql/mysql.conf.d/mysqld.cnf
        block: |
          {% for conf in mysql_configuration_options %}
          [{{ conf.section }}]
          {{ conf.option }} = {{ conf.value }}
          {% endfor %}
      notify: Restart MySQL server

    - name: Configure mysql client
      blockinfile:
        path: /etc/mysql/my.cnf
        block: |
          [client]
          socket={{ mysql_socket }}
        create: yes

    - name: Initialize mysql
      shell: "{{ mysql_initialize_command }}"
      when: ansible_os_family in ['Alpine', 'Archlinux']

    - name: Start and enable mysql
      service:
        name: mysql
        state: started
        enabled: yes

    - name: Flush handlers
      meta: flush_handlers

    - name: Place my.cnf
      template:
        src: my.cnf.j2
        dest: /root/.my.cnf

    - name: Create databases
      mysql_db:
        name: "{{ item.name }}"
        state: present
      with_items: "{{ mysql_databases }}"
      when: mysql_databases is defined and item.initial_import is not defined
      vars:
        login_user: root
        login_password: "{{ mysql_root_password }}"

    - name: List databases
      mysql_query:
        query: "SHOW DATABASES"
      register: mysql_info
      vars:
        login_user: root
        login_password: "{{ mysql_root_password }}"

    - name: Import database
      mysql_db:
        name: "{{ item.name }}"
        state: import
        target: "{{ item.path }}"
      with_items: "{{ mysql_databases }}"
      when: item.initial_import is defined and item.initial_import is not skipped
      vars:
        login_user: root
        login_password: "{{ mysql_root_password }}"

    - name: Create users
      mysql_user:
        name: "{{ item.name }}"
        host: "{{ item.host | default('localhost') }}"
        password: "{{ item.password }}"
        priv: "{{ item.priv | default('') }}"
        state: present
      with_items: "{{ mysql_users }}"
      when: mysql_users is defined
      vars:
        login_user: root
        login_password: "{{ mysql_root_password }}"

    - name: Flush handlers again
      meta: flush_handlers

  handlers:
    - name: Set root password
      mysql_user:
        name: root
        host_all: yes
        password: "{{ mysql_root_password }}"
        state: present

    - name: Reexecute systemd daemon
      command: systemctl daemon-reload

    - name: Restart MySQL server
      service:
        name: mysql
        state: restarted


