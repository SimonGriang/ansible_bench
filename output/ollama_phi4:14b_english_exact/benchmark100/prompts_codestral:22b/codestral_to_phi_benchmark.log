  when: true

- name: Enable IPVS Kernel Module
  include_tasks: enable_ipvs.yml
  when: 
    - ipvs_load_balancing is defined and ipvs_load_balancing
    - "'RKE2_servers' in group_names"
    - ha_mode == 'Kubevip'
    - ha_mode != 'Keepalived'

- name: Copy Kube-vip Manifests
  include_tasks: copy_kube_vip_manifests.yml
  when: 
    - "'RKE2_servers' in group_names"
    - ha_mode == 'Kubevip'
    - ha_mode != 'Keepalived'
    - inventory_hostname == groups['RKE2_servers'][0]

- name: Copy Ingress-nginx Manifests
  include_tasks: copy_ingress_nginx_manifests.yml
  when: 
    - "'RKE2_servers' in group_names"
    - ingress_nginx_values is defined
    - inventory_hostname == groups['RKE2_servers'][0]

- name: Prepare First Server Node
  include_tasks: prepare_first_server.yml
  when: 
    - "'RKE2_servers' in group_names"
    - (active_server is undefined or inventory_hostname == active_server)
    - groups['RKE2_servers'] | length == 1

- name: Restore etcd
  include_tasks: first_server_restore.yml
  when: 
    - active_server is defined
    - (inventory_hostname == active_server or inventory_hostname == groups['RKE2_servers'][0])
    - etcd_restore_needed

- name: Download kubeconfig
  include_tasks: download_kubeconfig.yml
  when: 
    - kubeconfig_download is defined and kubeconfig_download
    - inventory_hostname == groups['RKE2_servers'][0]

- name: Prepare and Join Remaining Nodes
  include_tasks: prepare_and_join_nodes.yml
  when: 
    - active_server is defined
    - groups['RKE2_servers'] | length >= 2

- name: Rolling Restart Servers
  include_tasks: rolling_restart.yml
  when: 
    - installed_version != running_version_servers

- name: Rolling Restart Agents
  include_tasks: rolling_restart.yml
  when: 
