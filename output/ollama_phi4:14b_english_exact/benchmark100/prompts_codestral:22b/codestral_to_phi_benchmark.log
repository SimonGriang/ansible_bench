content='```yaml\n---\n- name: Create the RKE2 manifests directory\n  ansible.builtin.file:\n    path: "{{ rke2_data_path }}/server/manifests"\n    state: directory\n    owner: root\n    mode: \'0700\'\n\n- name: Copy kube-vip files to first server\n  ansible.builtin.copy:\n    src: "templates/kube-vip/{{ item }}"\n    dest: "{{ rke2_data_path }}/server/manifests/{{ item | regex_replace(\'\\\\.j2$\', \'\') }}"\n    owner: root\n    mode: \'0664\'\n  loop:\n    - kube-vip.yml.j2\n    - kube-vip-rbac.yml.j2\n\n- name: Copy kube-vip load balancer manifests to first server\n  ansible.builtin.copy:\n    src: "templates/kube-vip/kube-vip-cloud-{{ item }}.j2"\n    dest: "{{ rke2_data_path }}/server/manifests/kube-vip-cloud-{{ item }}"\n    owner: root\n    mode: \'0664\'\n  loop: "{{ kube_vip_cloud_files }}"\n  when: rke2_kubevip_cloud_provider_enable\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-16T05:14:20.887514081Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3404928000, 'load_duration': 71699077, 'prompt_eval_count': 584, 'prompt_eval_duration': 225446719, 'eval_count': 247, 'eval_duration': 3107261266, 'model_name': 'phi4:14b'} id='run--f9a216c8-2891-4434-b9d6-8e6629ff0edc-0' usage_metadata={'input_tokens': 584, 'output_tokens': 247, 'total_tokens': 831}
