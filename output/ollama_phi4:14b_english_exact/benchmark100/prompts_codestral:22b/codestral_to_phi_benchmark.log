    - name: Build CA
      command: "{{ openvpn_easyrsa_path }} build-ca nopass"
      args:
        chdir: /etc/openvpn/easy-rsa
        environment:
          EASYRSA_BATCH: "yes"
      when: 
        not ansible_facts.stat.ca_crt is defined or 
        not ansible_facts.stat.ca_crt.stat.exists

    - name: Generate Diffie-Hellman parameters
      command: "{{ openvpn_easyrsa_path }} gen-dh"
      args:
        chdir: /etc/openvpn/easy-rsa
      when: 
        not ansible_facts.stat.dh_pem is defined or 
        not ansible_facts.stat.dh_pem.stat.exists

    - name: Build server certificates
      command: "{{ openvpn_easyrsa_path }} build-server-full server nopass"
      args:
        chdir: /etc/openvpn/easy-rsa
        environment:
          EASYRSA_BATCH: "yes"
      when: 
        not ansible_facts.stat.server_crt is defined or 
        not ansible_facts.stat.server_crt.stat.exists

    - name: Build client certificates
      command: "{{ openvpn_easyrsa_path }} build-client-full client nopass"
      args:
        chdir: /etc/openvpn/easy-rsa
        environment:
          EASYRSA_BATCH: "yes"
      when: 
        not ansible_facts.stat.client_crt is defined or 
        not ansible_facts.stat.client_crt.stat.exists

    - name: Generate Certificate Revocation List
      command: "{{ openvpn_easyrsa_path }} gen-crl"
      args:
        chdir: /etc/openvpn/easy-rsa
      when: 
        not ansible_facts.stat.crl_pem is defined or 
        not ansible_facts.stat.crl_pem.stat.exists

    - name: Generate TLS Auth Key
      command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
      when: 
        not ansible_facts.stat.ta_key is defined or 
        not ansible_facts.stat.ta_key.stat.exists

    - name: Copy files to /etc/openvpn/server
      copy:
        src: /etc/openvpn/easy-rsa/pki/{{ item }}
        dest: /etc/openvpn/server/
        mode: '0640'
        owner: root
        group: root
      loop:
