---
- name: Import assertions
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Modify selinux settings
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: yes
      loop: "{{ httpd_sebooleans }}"
      when: ansible_selinux.status == "enabled"

    - name: Allow connections to custom port
      seport:
        ports: "{{ httpd_port }}"
        proto: tcp
        setype: http_port_t
        state: present
      when: ansible_selinux.status == "enabled" and httpd_port is defined

    - name: Allow connections to custom SSL port
      seport:
        ports: "{{ httpd_ssl_port }}"
        proto: tcp
        setype: https_port_t
        state: present
      when: ansible_selinux.status == "enabled" and httpd_ssl_port is defined

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
  notify:
    - Test httpd configuration
    - Restart httpd

- name: Activate httpd module | Debian
  command: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == "Debian"
  notify:
    - Test httpd configuration

- name: Import ssl configuration
  import_tasks: ssl.yml
  when: httpd_ssl_enabled | bool

- name: Import locations
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual hosts
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_server_root }}"
  when: ansible_os_family in ["Debian", "Suse"]
  notify:
    - Test httpd configuration
    - Restart httpd

- name: Import directories
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Remove default HTML
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


