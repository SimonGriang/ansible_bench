---
- name: Configure RKE2
  hosts: all
  become: true
  vars:
    rke2_server_node_taints: ""
    rke2_type: ""
    rke2_config: ""
    rke2_kubelet_config: ""
    rke2_custom_registry_path: ""
    rke2_custom_registry_mirrors: ""
    rke2_custom_registry_configs: ""
    rke2_etcd_snapshot_file: ""
    rke2_etcd_snapshot_s3_options: {}
    rke2_token: ""
    rke2_cni: ""
  tasks:

    - name: Create the RKE2 config directory
      file:
        path: /etc/rancher/rke2
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Set server taints
      set_fact:
        combined_node_taints: "{{ rke2_server_node_taints }}"
      when: rke2_type == 'server'

    - name: Copy rke2 config
      copy:
        src: "{{ rke2_config }}"
        dest: /etc/rancher/rke2/config.yaml
        owner: root
        group: root
        mode: '0600'
      notify: Config file changed

    - name: Copy kubelet config
      copy:
        src: templates/kubelet-config.yaml.j2
        dest: /etc/rancher/rke2/kubelet-config.yaml
        owner: root
        group: root
        mode: '0600'
      when: rke2_kubelet_config != ""
      notify: Config file changed

    - name: Copy Containerd Registry Configuration file
      copy:
        src: "{{ rke2_custom_registry_path }}"
        dest: /etc/rancher/rke2/registries.yaml
        owner: root
        group: root
        mode: '0600'
      when: rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != ""
      notify: Config file changed

    - name: Register if we need to do a etcd restore from file
      set_fact:
        do_etcd_restore: true
      when: rke2_etcd_snapshot_file != "" and (rke2_server_service_status is not defined or rke2_server_service_status != "running")

    - name: Register if we need to do a etcd restore from s3
      set_fact:
        do_etcd_restore_from_s3: true
      when: rke2_etcd_snapshot_file != "" and 
            rke2_etcd_snapshot_s3_options is defined and 
            rke2_etcd_snapshot_s3_options.get('access_key') and 
            rke2_etcd_snapshot_s3_options.get('secret_key') and 
            rke2_etcd_snapshot_s3_options.get('bucket') and 
            rke2_etcd_snapshot_s3_options.get('snapshot_name')

    - name: Restore etcd from file
      block:
        - name: Create directory for etcd snapshot
          file:
            path: /var/lib/rancher/rke2/etcd-snapshots
            state: directory
            owner: root
            group: root
            mode: '0755'

        - name: Copy etcd snapshot file
          copy:
            src: "{{ rke2_etcd_snapshot_file }}"
            dest: /var/lib/rancher/rke2/etcd-snapshots/snapshot.db

        - name: Restore etcd from snapshot
          command: rke2 server --restore-etcd-snapshot /var/lib/rancher/rke2/etcd-snapshots/snapshot.db
          register: etcd_restore_result
      when: do_etcd_restore is defined

    - name: Restore etcd from s3
      block:
        - name: Restore etcd from S3 snapshot
          command: >
            rke2 server --restore-etcd-snapshot-s3
            --etcd-s3-bucket "{{ rke2_etcd_snapshot_s3_options['bucket'] }}"
            --etcd-s3-access-key "{{ rke2_etcd_snapshot_s3_options['access_key'] }}"
            --etcd-s3-secret-key "{{ rke2_etcd_snapshot_s3_options['secret_key'] }}"
            --etcd-s3-snapshot-name "{{ rke2_etcd_snapshot_s3_options['snapshot_name'] }}"
          register: etcd_s3_restore_result
      when: do_etcd_restore_from_s3 is defined

    - name: Start RKE2 service on the first server
      systemd:
        name: rke2-server.service
        state: started
        enabled: yes
      environment:
        RKE2_TOKEN: "{{ rke2_token }}"
      notify: Service (re)started

    - name: Mask RKE2 agent service on the first server
      systemd:
        name: rke2-agent.service
        masked: yes
        enabled: no

    - name: Wait for the first server to be ready - no CNI
      command: kubectl get nodes --no-headers
      register: kubectl_nodes
      until: "'Ready' in kubectl_nodes.stdout"
      retries: 30
      delay: 10
      when: rke2_cni == 'none'

    - name: Wait for the first server to be ready - with CNI
      command: kubectl get nodes --no-headers
      register: kubectl_nodes
      until: "'Ready' in kubectl_nodes.stdout"
      retries: 30
      delay: 10
      when: rke2_cni != 'none'

    - name: Restore etcd
      block:
        - name: Get registered nodes
          command: kubectl get nodes --no-headers -o custom-columns=NAME:.metadata.name
          register: registered_nodes

        - name: Remove old node-password secrets
          command: kubectl delete secret --ignore-not-found -l node={{ item }}
          loop: "{{ registered_nodes.stdout_lines }}"
          when: "'node' in item"

        - name: Remove old nodes
          command: kubectl delete node --ignore-not-found {{ item }}
          loop: "{{ registered_nodes.stdout_lines }}"

        - name: Set Active Server variable
          set_fact:
            active_server: "{{ registered_nodes.stdout_lines[0] }}"
      when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

  handlers:
    - name: Config file changed
      debug:
        msg: "Configuration file has changed."

    - name: Service (re)started
      debug:
        msg: "RKE2 service has been started."


