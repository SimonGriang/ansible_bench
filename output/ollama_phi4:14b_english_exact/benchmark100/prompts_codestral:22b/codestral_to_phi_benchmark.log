---
- name: Migrate Java JDK vendor from 'adoptopenjdk' to 'temurin' if selected
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS-specific variables for Java
  include_vars: "{{ java_jdk_vendor }}_{{ ansible_os_family }}.yml"

- name: Gather architecture-specific variables for Java
  include_vars: "architecture.yml"

- name: Set OS-specific variables for Java (I)
  set_fact:
    java_os_specific_var: "{{ java_os_specific_var | default('default_value') }}"

- name: Set OS and architecture-specific variables for Java (II)
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Handle Debian pre-requisites for Java
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "ppa:old/ppa"
        state: absent
    - name: Install extra apt tools
      package:
        name: apt-transport-https
        state: present
    - name: Add required key repositories
      apt_key:
        url: https://example.com/repo.key
        state: present
    - name: Add required repositories
      apt_repository:
        repo: "deb https://example.com/repo stable main"
  when: ansible_os_family == "Debian"

- name: Handle RedHat pre-requisites for Java
  block:
    - name: Add required key repositories
      rpm_key:
        key: https://example.com/repo.key
        state: present
    - name: Add required repositories
      yum_repository:
        name: example
        description: "Example Repository"
        baseurl: "https://example.com/repo"
        gpgcheck: yes
  when: ansible_os_family == "RedHat"

- name: Install required libraries for Java
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libraries }}"

- name: Install Java on Debian
  apt:
    name: "{{ java_package_name }}"
    state: present
    update_cache: yes
  when: ansible_os_family == "Debian"

- name: Install Java on RedHat
  yum:
    name: "{{ java_package_name }}"
    state: present
    update_cache: yes
  when: ansible_os_family == "RedHat"

- name: Export environment variables for Java
  template:
    src: "jdk.sh.j2"
    dest: "/etc/profile.d/jdk.sh"
    mode: '0755'

- name: Source environment variables for Java
  shell: source /etc/profile.d/jdk.sh
  args:
    executable: /bin/bash

- name: Correct Java version selected for Java < 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
  when: java_version < 11

- name: Correct Java version selected for Java >= 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
  when: java_version >= 11


