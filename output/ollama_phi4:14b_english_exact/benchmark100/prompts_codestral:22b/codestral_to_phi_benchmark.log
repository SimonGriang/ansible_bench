  when:
    - rke2_download_kubeconf is defined and rke2_download_kubeconf | bool
    - inventory_hostname == groups['rke2_servers_group_name'][0]
  notify:
    - Set kubeconfig file permissions

- name: Set kubeconfig file permissions
  ansible.builtin.file:
    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    mode: '0600'
  when:
    - rke2_download_kubeconf is defined and rke2_download_kubeconf | bool
    - inventory_hostname == groups['rke2_servers_group_name'][0]


