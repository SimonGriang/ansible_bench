---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
  when: not rke2_airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_local_install_script_src }}"
    dest: "{{ rke2_install_script_dest }}"
  when:
    - rke2_airgap_mode
    - rke2_airgap_impl == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: "{{ rke2_artifacts_permissions }}"
  when:
    - rke2_airgap_mode
    - rke2_airgap_impl != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download checksum and artifacts
      get_url:
        url: "{{ item.url }}"
        dest: "{{ item.dest }}"
      with_items:
        - url: "{{ rke2_checksum_url }}"
          dest: "{{ rke2_checksum_dest }}"
        - url: "{{ rke2_artifacts_url }}"
          dest: "{{ rke2_artifacts_dest }}"
    - name: Verify checksum
      shell: sha256sum -c "{{ rke2_checksum_dest }}"
      register: checksum_verification
      failed_when: checksum_verification.rc != 0
      changed_when: false
    - name: Download RKE2 install script if checksum fails
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_dest }}"
      when: checksum_verification.failed
  when:
    - rke2_airgap_mode
    - rke2_airgap_impl == 'download'

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifacts_src }}"
    dest: "{{ rke2_artifacts_dest }}"
  when:
    - rke2_airgap_mode
    - rke2_airgap_impl == 'copy'

- name: Copy additional images tarballs
  block:
    - name: Create directory for tarballs
      file:
        path: "{{ rke2_tarballs_path }}"
        state: directory
        mode: "{{ rke2_tarballs_permissions }}"
    - name: Copy tarball images
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_tarballs_path }}"
      with_fileglob:
        - "{{ rke2_local_tarballs_src }}/*"
  when:
    - rke2_airgap_mode
    - rke2_additional_tarballs | length > 0
    - rke2_airgap_impl != 'exists'

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Check artifacts existence and permissions
      stat:
        path: "{{ rke2_artifacts_dest }}"
      register: artifacts_stat
    - name: Change permissions if writable
      file:
        path: "{{ rke2_artifacts_dest }}"
        mode: '0444'
      when: artifacts_stat.stat.isreg and (artifacts_stat.stat.mode & 0o022)
    - name: Ensure install script is executable
      file:
        path: "{{ rke2_install_script_dest }}"
        mode: '0755'
      when: not (artifacts_stat.stat.isreg and 
                (artifacts_stat.stat.mode & 0o111))
    - name: Fail if install script is not executable and does not exist
      fail:
        msg: "Install script is not executable and does not exist."
      when: not artifacts_stat.stat.exists and not artifacts_stat.stat.isreg
  when:
    - rke2_airgap_mode
    - rke2_airgap_impl == 'exists'

- name: Set RKE2 bin path
  block:
    - name: Populate service facts
      service_facts:
    - name: Get filesystem object stats
      stat:
        path: "{{ rke2_bin_path }}"
      register: bin_path_stat
    - name: Check if separate partition
      set_fact:
        separate_partition: "{{ bin_path_stat.stat.pw_name != 'root' }}"
    - name: Set RKE2 bin path
      set_fact:
        rke2_bin_path: "{{ rke2_bin_path if separate_partition else '/usr/local/bin' }}"
  when: true

- name: Check RKE2 version
  block:
    - name: Check installed version
      shell: "{{ rke2_bin_path }}/rke2 version"
      register: installed_version
      failed_when: installed_version.rc != 0
      changed_when: false
    - name: Set installed version
      set_fact:
        installed_rke2_version: >-
          {{ installed_version.stdout.split()[2] if 
          installed_version.rc == 0 else 'not installed' }}
    - name: Check running version if service is active
      shell: |
        systemctl show --value rke2-server | grep ExecMainStatus=0 &&
        {{ rke2_bin_path }}/rke2 version
      register: running_version
      failed_when: running_version.rc != 0
      changed_when: false
    - name: Set running version
      set_fact:
        running_rke2_version: >-
          {{ running_version.stdout.split()[2] if 
          running_version.rc == 0 else desired_rke2_version }}
  when: true

- name: Prevent accidental RKE2 downgrade
  fail:
    msg: "Downgrade from version {{ running_rke2_version }} to {{ desired_rke2_version }} is not allowed."
  when:
    - desired_rke2_version is version(running_rke2_version, '<')
    - not allow_downgrade

- name: Run RKE2 install script
  block:
    - name: Run install script with airgap variables
      shell: "{{ rke2_install_script_dest }} --airgap-url {{ rke2_airgap_url }} 
              --airgap-path {{ rke2_airgap_path }}"
      when: rke2_airgap_mode
    - name: Run install script without airgap variables
      shell: "{{ rke2_install_script_dest }}"
      when: not rke2_airgap_mode
  when:
    - installed_rke2_version == 'not installed' or installed_rke2_version != 
      desired_rke2_version

- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_custom_manifests_src }}"
    dest: "{{ rke2_custom_manifests_dest }}"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_src }}"
    dest: "{{ rke2_static_pods_dest }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file_src }}"
    dest: "{{ rke2_env_file_dest }}"
  when: rke2_env_options | length > 0


