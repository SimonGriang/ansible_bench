---
- name: Prepare summary
  hosts: "{{ rke2_servers_group_name }}"
  tasks:
    - name: Retrieve Kubernetes nodes summary
      shell: rke2 rke2-kubectl get nodes --output=wide --show-labels
      register: nodes_summary
      until: nodes_summary is succeeded
      retries: 5
      delay: 5
      delegate_to: "{{ groups[rke2_servers_group_name][0] }}"

- name: K8s nodes state
  tasks:
    - name: Display Kubernetes nodes state
      debug:
        var: nodes_summary.stdout


