---
- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: "{{ rke2_data_path }}/server/manifests"
    state: directory
    owner: root
    mode: '0700'

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    src: "templates/kube-vip/{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/{{ item | regex_replace('\\.j2$', '') }}"
    owner: root
    mode: '0664'
  loop:
    - kube-vip.yml.j2
    - kube-vip-rbac.yml.j2

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    src: "templates/kube-vip/kube-vip-cloud-{{ item }}.j2"
    dest: "{{ rke2_data_path }}/server/manifests/kube-vip-cloud-{{ item }}"
    owner: root
    mode: '0664'
  loop: "{{ kube_vip_cloud_files }}"
  when: rke2_kubevip_cloud_provider_enable


