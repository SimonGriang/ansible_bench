e': True, 'done_reason': 'stop', 'total_duration': 8239876662, 'load_duration': 75727082, 'prompt_eval_count': 418, 'prompt_eval_duration': 55801999, 'eval_count': 451, 'eval_duration': 8106579377, 'model_name': 'phi4:14b'} id='run--9f0c02b9-197b-43a1-82be-6dbb69448d84-0' usage_metadata={'input_tokens': 418, 'output_tokens': 451, 'total_tokens': 869}
