---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Pre-configure Debian systems
  command: debconf-set-selections <<< "postfix postfix/main_mailer_type select No configuration"
  when: ansible_os_family == "Debian"

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: "'mysql' in lookup('vars', 'postfix_additional_packages', default=[])"

- name: Configure postfix (transport_maps)
  template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf
  set_fact:
    postfix_smtpd_recipient_restrictions: "{{ lookup('vars', 'postfix_smtpd_recipient_restrictions', default='permit_mynetworks, reject_unauth_destination') }}"
    postfix_smtpd_sender_restrictions: "{{ lookup('vars', 'postfix_smtpd_sender_restrictions', default='permit_sasl_authenticated, permit_mynetworks, reject_unauth_destination') }}"

- name: Configure postfix (main.cf)
  template:
    src: "{{ postfix_main_cf_template }}"
    dest: /etc/postfix/main.cf
  notify: validate_postfix_config
  when: postfix_main_cf_template is defined

- name: Configure postfix (master.cf)
  template:
    src: "{{ postfix_master_cf_template }}"
    dest: /etc/postfix/master.cf
  notify: validate_postfix_config
  when: postfix_master_cf_template is defined

- name: Create cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - /etc/postfix/certs
    - /etc/postfix/private
  when: "'cert_directory' in lookup('vars', 'postfix_tls_directories', default=[])"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: /etc/postfix/certs/server.crt
    mode: '0644'
  when: postfix_smtpd_tls_cert_file_source is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: /etc/postfix/private/server.key
    mode: '0600'
  when: postfix_smtpd_tls_key_file_source is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
  notify: run-newaliases
  when: postfix_aliases is defined

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
  notify: reload_postfix
  when: postfix_sender_access is defined

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
  notify: reload_postfix
  when: postfix_recipient_access is defined

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_smtp_sasl_password_map }}"
    dest: /etc/postfix/sasl_password
    mode: '0600'
  when: postfix_smtp_sasl_password_map is defined and postfix_smtp_sasl_password_map != ""

- name: Flush handlers (again)
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes


