content='```yaml\n---\n- name: Create document roots for virtual hosts\n  file:\n    path: "{{ item.documentroot }}"\n    state: directory\n    mode: \'0755\'\n  loop: "{{ httpd_vhosts }}"\n  when: httpd_vhosts is defined and item.documentroot is defined and item.create_docroot\n\n- name: Configure virtual hosts\n  template:\n    src: "{{ vhost_conf_template }}"\n    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"\n    mode: \'0644\'\n  loop: "{{ httpd_vhosts }}"\n  notify:\n    - Test httpd configuration validity\n    - Restart httpd\n\n- name: Enable virtual hosts on Debian-based systems\n  command: a2ensite "{{ item.name }}"\n  args:\n    creates: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"\n  loop: "{{ httpd_vhosts }}"\n  when: ansible_os_family == \'Debian\'\n  notify:\n    - Test httpd configuration validity\n    - Restart httpd\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-21T17:21:36.483377807Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5027104227, 'load_duration': 59759964, 'prompt_eval_count': 531, 'prompt_eval_duration': 356009721, 'eval_count': 217, 'eval_duration': 4609835434, 'model_name': 'phi4:14b'} id='run--d26d05f7-ac82-4253-a7fa-fdd6f64d4719-0' usage_metadata={'input_tokens': 531, 'output_tokens': 217, 'total_tokens': 748}
