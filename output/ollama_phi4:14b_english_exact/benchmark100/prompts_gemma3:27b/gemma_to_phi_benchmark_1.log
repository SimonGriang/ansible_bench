content='```yaml\n---\n- name: create directories\n  file:\n    path: /opt/cadvisor\n    state: directory\n    mode: \'0755\'\n\n- name: download cadvisor\n  get_url:\n    url: "{{ cadvisor_download }}"\n    dest: /opt/cadvisor/cadvisor-{{ cadvisor_version }}\n    sha256sum: "{{ cadvisor_checksum }}"\n    mode: \'0755\'\n  when: cadvisor_binary_local_dir | length == 0\n\n- name: propagate locally distributed cadvisor binary\n  copy:\n    src: "{{ cadvisor_binary_local_dir }}/cadvisor-{{ cadvisor_version }}"\n    dest: /opt/cadvisor/cadvisor-{{ cadvisor_version }}\n    mode: \'0755\'\n    owner: root\n    group: root\n  notify: restart cadvisor\n  when: cadvisor_binary_local_dir | length > 0\n\n- name: symlink cadvisor\n  file:\n    src: /opt/cadvisor/cadvisor-{{ cadvisor_version }}\n    dest: /opt/cadvisor/cadvisor\n    state: link\n    force: yes\n\n- name: server systemd service\n  template:\n    src: systemd-system-cadvisor-service.j2\n    dest: /etc/systemd/system/cadvisor.service\n    mode: \'0644\'\n  notify: restart cadvisor\n\n- name: test_task\n  command: systemctl is-active cadvisor.service\n  register: service_active\n  failed_when: false\n  changed_when: false\n\n- name: debug\n  debug:\n    var: service_active\n\n- name: cadvisor | enable server systemd\n  systemd:\n    name: cadvisor.service\n    enabled: true\n\n- name: cadvisor | start server systemd\n  systemd:\n    name: cadvisor.service\n    state: started\n    daemon_reload: true\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-21T16:37:33.564608365Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9554882507, 'load_duration': 64643758, 'prompt_eval_count': 1195, 'prompt_eval_duration': 45821681, 'eval_count': 380, 'eval_duration': 9443222163, 'model_name': 'phi4:14b'} id='run--c84f0b3e-b916-4803-95d4-0e8ee41269ab-0' usage_metadata={'input_tokens': 1195, 'output_tokens': 380, 'total_tokens': 1575}  2%|▏         | 2/100 [02:01<1:39:45, 61.08s/it]
