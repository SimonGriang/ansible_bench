---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'docker'
    - ansible_connection != 'podman'
    - bootstrap_wait_for_host | bool
  become: false

- name: Prepare system
  become: false
  block:
    - name: Test connection
      ansible.builtin.ping:

    - name: Verify sudo access
      ansible.builtin.command:
        cmd: "sudo -n true"
      register: sudo_check
      failed_when: sudo_check.rc != 0
  rescue:
    - name: Gather bootstrap facts
      ansible.builtin.setup:

    - name: Install bootstrap packages
      ansible.builtin.package:
        name: "{{ bootstrap_facts_packages | list }}"
        state: present
      become: "{{ bootstrap_become }}"

- name: Gather ansible facts
  ansible.builtin.setup:
  become: false

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages | list }}"
    state: present
  become: "{{ bootstrap_become }}"


