---
- name: Import assert.yml
  include_tasks: assert.yml
  when: inventory_hostname == "localhost"

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  block:
    - name: Set index-url in pip.conf
      lineinfile:
        path: /etc/pip.conf
        line: "index-url = {{ python_pip_proxy }}"
        section: global
        create: yes
        mode: '0644'
  when: python_pip_proxy is defined

- name: Trust hosts
  block:
    - name: Set trusted-host in pip.conf
      lineinfile:
        path: /etc/pip.conf
        line: "trusted-host = {{ python_pip_trusted_host }}"
        section: global
        create: yes
        mode: '0644'
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when: (ansible_os_family != 'Debian' or ansible_distribution_version not in ['bookworm', 'noble']) and ansible_os_family != 'Alpine'

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('latest') }}"
    version: "{{ item.version | default(omit) }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  loop_control:
    label: "{{ item.name }}"
  when: (ansible_os_family != 'Debian' or ansible_distribution_version not in ['bookworm', 'noble']) and ansible_os_family != 'Alpine'


