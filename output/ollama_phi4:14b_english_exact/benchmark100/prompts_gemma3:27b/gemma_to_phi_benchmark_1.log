---
- name: Gather bootstrap facts using raw command
  ansible.builtin.command:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  become: false
  gather_facts: false

- name: Set bootstrap facts (I) based on OS release information
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: >-
      {{ bootstrap_facts.stdout_lines
         | select('search', item.value)
         | map('regex_search', '^(.+?)[.]([0-9]+)', '\\2')
         | first }}
  when: bootstrap_facts.rc == 0 and
        bootstrap_distribution is not defined and
        bootstrap_facts.stdout is search(item.value)
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"

- name: Set bootstrap facts (II) based on OS family
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  when: bootstrap_distribution is defined and
        bootstrap_distribution in item.value
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"


