    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when: >
    httpd_vhosts is defined and 
    item.documentroot is defined and 
    item.create_docroot

- name: Configure virtual hosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Enable virtual hosts on Debian-based systems
  command: a2ensite "{{ item.name }}"
  args:
    creates: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian'
  notify:
    - Test httpd configuration validity
    - Restart httpd


