---
- name: lookup bootstrap facts (raw)
  ansible.builtin.command:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  vars:
    ansible_user: "{{ bootstrap_user }}"
  changed_when: false

- name: set bootstrap facts (I) # noqa jinja
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: "{{ (ansible_facts['ansible_distribution_version'] | regex_search('(\\d+)')).0 }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout is search(item.value)
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"
  vars:
    ansible_become: "{{ bootstrap_become }}"
    ansible_become_user: "{{ bootstrap_become_user }}"

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  when:
    - bootstrap_distribution in item.value
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"
  vars:
    ansible_become: "{{ bootstrap_become }}"
    ansible_become_user: "{{ bootstrap_become_user }}"


