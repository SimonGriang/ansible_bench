---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_directory_mode }}"
  with_items:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    system: yes
    create_home: no

- name: Generate rndc key
  command: rndc-confgen -a -c /etc/rndc.key
  args:
    creates: /etc/rndc.key
  notify: Rndc reload

- name: Set permissions on rndc key file
  file:
    path: /etc/rndc.key
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0640

- name: Get the hints/root file
  get_url:
    url: "{{ dns_hints_url }}"
    dest: "{{ dns_datadir }}/root.hints"
    mode: 0644
  when: dns_caching_dns | bool
  notify: Rndc reload

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.zone }}.zone"
  with_items: "{{ dns_zones }}"
  notify: Rndc reload
  register: zone_files

- name: Validate zone files
  command: named-checkzone {{ item.item.zone }} {{ dns_datadir }}/{{ item.item.zone }}.zone
  with_items: "{{ zone_files.results }}"
  when: item.changed

- name: Set permissions on zone files
  file:
    path: "{{ dns_datadir }}/{{ item.zone }}.zone"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0640
  with_items: "{{ dns_zones }}"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named.conf
  notify: Restart dns
  register: named_conf_update

- name: Validate named configuration
  command: named-checkconf
  when: named_conf_update.changed

- name: Create backup of named configuration
  copy:
    src: /etc/named.conf
    dest: /etc/named.conf.bak
    remote_src: yes
  when: named_conf_update.changed

- name: Place systemd override
  block:
    - name: Create systemd directory
      file:
        path: /etc/systemd/system/dns.service.d
        state: directory
        mode: 0755

    - name: Copy systemd override
      copy:
        src: dns.service.j2
        dest: /etc/systemd/system/dns.service.d/override.conf
      notify: Reload systemd

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: yes


