n  set_fact:\n    __promtail_checksum: "{{ item.split()[0] }}"\n  loop: "{{ __promtail_checksums }}"\n  when:\n    - promtail_binary_local_dir is not defined\n    - item.endswith(f"{{ promtail_version }}-{{ go_arch }}.zip")\n  loop_control:\n    label: "{{ item }}"\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-21T17:18:39.644636871Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14486316263, 'load_duration': 54086437, 'prompt_eval_count': 1492, 'prompt_eval_duration': 13863558, 'eval_count': 582, 'eval_duration': 14417020274, 'model_name': 'phi4:14b'} id='run--68a367fd-1350-4d17-8662-ed3c7a845349-0' usage_metadata={'input_tokens': 1492, 'output_tokens': 582, 'total_tokens': 2074}
