---
- name: Import assert.yml
  include_tasks: assert.yml
  when: inventory_hostname == 'localhost'

- name: Configure apk
  block:
    - name: Update apk cache
      apk:
        update_cache: yes

    - name: Upgrade all software using apk
      apk:
        upgrade: yes
      notify: Reboot
  when: ansible_pkg_mgr == 'apk'

- name: Configure apt
  block:
    - name: Prevent upgrades for specific packages
      apt:
        name: "{{ update_excluded_packages }}"
        state: latest
        allow_downgrade: yes
        default_release: "{{ ansible_distribution_release }}"

    - name: Update apt cache
      apt:
        update_cache: yes

    - name: Upgrade all software using apt
      apt:
        upgrade: dist
      notify: Reboot

    - name: Run apt autoremove
      apt:
        autoremove: yes
      when: apt_autoremove | default(false)

  when: ansible_pkg_mgr == 'apt'

- name: Update all software (dnf)
  block:
    - name: Exclude packages from update
      dnf:
        autorefresh: yes
        update_cache: yes
        exclude: "{{ update_excluded_packages | join(',') }}"

    - name: Upgrade all software using dnf
      dnf:
        upgrade: yes
      notify: Reboot
  when: ansible_pkg_mgr in ['dnf', 'dnf5']

- name: Update all software (pacman)
  block:
    - name: Sync all packages with pacman
      pacman:
        update_cache: yes

    - name: Upgrade all software using pacman
      pacman:
        upgrade: all
      notify: Reboot
  when: ansible_pkg_mgr == 'pacman'

- name: Configure yum
  block:
    - name: Update all software using yum
      yum:
        name: '*'
        exclude: "{{ update_excluded_packages | join(',') }}"
        state: latest
      notify: Reboot

    - name: Update all software using yum on systems prior to version 7
      yum:
        name: '*'
        exclude: "{{ update_excluded_packages | join(',') }}"
        state: latest
      when: ansible_pkg_mgr == 'yum' and ansible_distribution_major_version | int < 7
      notify: Reboot
  when: ansible_pkg_mgr == 'yum'

- name: Update all software (zypper)
  block:
    - name: Refresh all repositories using zypper
      zypper:
        refresh: yes

    - name: Upgrade all software using zypper
      zypper:
        name: '*'
        state: latest
      notify: Reboot
  when: ansible_pkg_mgr == 'zypper'

handlers:
  - name: Reboot
    reboot:


