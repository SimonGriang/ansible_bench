---
- name: create ssl key
  community.crypto.openssl_privatekey:
    path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    size: 2048
    type: RSA
  delegate_to: localhost
  register: openssl_key_result
  become: yes
  become_user: root
  file:
    path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  become: yes

- name: create ssl csr
  community.crypto.openssl_csr:
    path: "{{ openssl_csr_directory }}/{{ item.common_name }}.csr"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    common_name: "{{ item.common_name }}"
  delegate_to: localhost
  become: yes
  become_user: root
  file:
    path: "{{ openssl_csr_directory }}/{{ item.common_name }}.csr"
    mode: '0644'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  become: yes

- name: create ssl certificates
  community.crypto.x509_certificate:
    path: "{{ openssl_crt_directory }}/{{ item.common_name }}.crt"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    csr_path: "{{ openssl_csr_directory }}/{{ item.common_name }}.csr"
    provider:
      type: selfsigned
  delegate_to: localhost
  become: yes
  become_user: root
  file:
    path: "{{ openssl_crt_directory }}/{{ item.common_name }}.crt"
    mode: '0644'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  become: yes

- name: create PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: "{{ openssl_key_directory }}/{{ item.name }}.p12"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    cert_path: "{{ openssl_crt_directory }}/{{ item.common_name }}.crt"
    friendly_name: "{{ item.name }}"
  delegate_to: localhost
  become: yes
  become_user: root
  file:
    path: "{{ openssl_key_directory }}/{{ item.name }}.p12"
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  become: yes

- name: read private key
  ansible.builtin.slurp:
    src: "{{ openssl_key_directory }}/{{ item.name }}.key"
  delegate_to: localhost
  register: openssl_private_key
  become: yes
  become_user: root

- name: read certificate
  ansible.builtin.slurp:
    src: "{{ openssl_crt_directory }}/{{ item.common_name }}.crt"
  delegate_to: localhost
  register: openssl_certificate
  become: yes
  become_user: root

- name: create combined private_key and certificate file
  ansible.builtin.copy:
    dest: "{{ openssl_key_directory }}/{{ item.name }}.keycrt"
    content: |
      {{ openssl_private_key.content | b64decode | trim }}
      {{ openssl_certificate.content | b64decode | trim }}
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  become: yes


