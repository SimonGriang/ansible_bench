- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install required packages
  ansible.builtin.package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: yes

- name: Configure selinux
  ansible.builtin.selinux:
    policy: "{{ selinux_policy }}"
    state: "{{ selinux_state }}"
  when: ansible_selinux.status is defined and ansible_connection != 'container'
  notify: Reboot

- name: Manage selinux booleans
  ansible.builtin.selinux:
    policy: "{{ item.key }}"
    state: "{{ item.value | default('yes') }}"
    persistent: yes
  loop: "{{ selinux_booleans | dict2items }}"
  when: selinux_booleans is defined
  loop_control:
    label: "{{ item.key }}"


