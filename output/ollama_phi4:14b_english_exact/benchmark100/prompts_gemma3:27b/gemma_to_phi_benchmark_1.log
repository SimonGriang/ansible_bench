---
- name: Import the 'assert.yml' task file to verify variable configurations
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for a specific port on the target host to become available
  wait_for:
    port: "{{ ansible_ssh_host | default(ansible_host | default(inventory_hostname)) | default(inventory_hostname) }}:22"
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection != 'container' and ansible_connection != 'docker' and bootstrap_wait_for_host | default(false)
  delegate_to: localhost
  become: "{{ ansible_become | default(false) }}"
  become_user: "{{ ansible_become_user | default(omit) }}"
  become_method: "{{ ansible_become_method | default(omit) }}"

- name: Prepare the system
  block:
    - name: Test the connection using 'wait_for_connection'
      wait_for_connection:
      register: bootstrap_connect

    - name: Debug 'bootstrap_timeout' if connection fails
      debug:
        var: bootstrap_timeout
      when: bootstrap_connect is failed

    - name: Always gather bootstrap facts
      import_tasks: gather_facts.yml

- name: Install bootstrap packages
  raw: |
    your_command_here
  register: bootstrap_install_packages
  changed_when: >
    (ansible_facts['os_family'] == 'Alpine' or ansible_facts['os_family'] == 'Archlinux' or ansible_facts['os_family'] == 'Gentoo') and
    bootstrap_install_packages.stdout is search('expected_stdout_regex') or
    (ansible_facts['os_family'] == 'Debian' or ansible_facts['os_family'] == 'RedHat' or ansible_facts['os_family'] == 'Rocky' or ansible_facts['os_family'] == 'Suse') and
    not bootstrap_install_packages.stdout is search('expected_stdout_regex')
  become: "{{ ansible_become | default(false) }}"
  become_user: "{{ bootstrap_user | default(omit) }}"
  become_method: "{{ ansible_become_method | default(omit) }}"
  delegate_to: localhost

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:

    - name: Install packages listed in 'bootstrap__facts_packages'
      package:
        name: "{{ bootstrap__facts_packages }}"
        state: present
      notify:
        - update_cache
  become: "{{ ansible_become | default(false) }}"
  become_user: "{{ bootstrap_user | default(omit) }}"
  become_method: "{{ ansible_become_method | default(omit) }}"

handlers:
  - name: update_cache
    package:
      update_cache: yes


