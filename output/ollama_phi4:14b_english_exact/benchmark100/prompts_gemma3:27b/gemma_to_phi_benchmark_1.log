content='```yaml\n---\n- name: Check current docker-compose version\n  command: docker-compose version\n  register: docker_compose_vsn\n  check_mode: false\n  changed_when: false\n  failed_when: false\n\n- name: Set docker-compose current version fact\n  set_fact:\n    docker_compose_current_version: "{{ docker_compose_vsn.stdout | regex_search(\'Version:\\\\s+(\\\\S+)\', \'\\\\1\') }}"\n  when: docker_compose_vsn.stdout is defined and docker_compose_vsn.stdout | length > 0\n\n- name: Delete existing docker-compose version if it\'s different\n  file:\n    path: "{{ docker_compose_path }}"\n    state: absent\n  when: docker_compose_current_version is defined and docker_compose_current_version | length > 0 and (docker_compose_current_version | regex_replace(\'^v\', \'\') != docker_compose_version | regex_replace(\'^v\', \'\'))\n\n- name: Install Docker Compose (if configured)\n  get_url:\n    url: "{{ docker_compose_url }}"\n    dest: "{{ docker_compose_path }}"\n    mode: \'0755\'\n  when: \n    - (docker_compose_current_version is undefined or docker_compose_current_version | length == 0) or\n      (docker_compose_current_version | regex_replace(\'^v\', \'\') | version_compare(docker_compose_version | regex_replace(\'^v\', \'\'), \'<\'))\n```\n\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-21T16:52:38.6337996Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5866118460, 'load_duration': 55556707, 'prompt_eval_count': 537, 'prompt_eval_duration': 314132697, 'eval_count': 295, 'eval_duration': 5495320902, 'model_name': 'phi4:14b'} id='run--59a45b5d-1799-40ba-ba3a-387f4c7b01c9-0' usage_metadata={'input_tokens': 537, 'output_tokens': 295, 'total_tokens': 832}
