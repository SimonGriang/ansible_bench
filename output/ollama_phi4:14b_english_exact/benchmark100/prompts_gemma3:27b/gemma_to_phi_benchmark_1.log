---
- name: Assert systemd as init system
  assert:
    that: ansible_service_mgr == "systemd"
    fail_msg: "The target system is not using systemd as its init system."
    quiet: yes

- name: Get latest release
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    method: GET
    headers:
      Accept: "application/vnd.github.v3+json"
    return_content: yes
    status_code: 200
    follow_redirects: all
    retries: 5
    delay: 2
    force_basic_auth: yes
    url_username: "{{ lookup('env', 'GH_USER') }}"
    url_password: "{{ lookup('env', 'GH_TOKEN') }}"
  register: _latest_release
  when: lookup('env', 'GH_USER') is defined and lookup('env', 'GH_TOKEN') is defined
  ignore_errors: yes

- name: Set promtail version to {{ _latest_release.json.tag_name[1:] }}
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
  when: promtail_version == "latest"

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/{{ promtail_version }}-{{ go_arch }}.zip"
  register: promtail_binary_local_archive

- name: Assert local binary exists
  assert:
    that:
      - promtail_binary_local_dir is defined
      - promtail_binary_local_archive.stat.exists
    fail_msg: "The local promtail binary archive does not exist in {{ promtail_binary_local_dir }}."
    quiet: yes
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  uri:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/SHA256SUMS"
    method: GET
    return_content: yes
    status_code: 200
    follow_redirects: all
  register: promtail_checksum_list
  until: promtail_checksum_list is succeeded
  retries: 5
  delay: 2
  set_fact:
    __promtail_checksums: "{{ promtail_checksum_list.content.splitlines() | list }}"

- name: Get checksum for {{ go_arch }} architecture
  set_fact:
    __promtail_checksum: "{{ item.split()[0] }}"
  loop: "{{ __promtail_checksums }}"
  when:
    - promtail_binary_local_dir is not defined
    - item.endswith(f"{{ promtail_version }}-{{ go_arch }}.zip")
  loop_control:
    label: "{{ item }}"


