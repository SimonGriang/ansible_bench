---
- name: Harden the system
  hosts: all
  become: yes
  vars:
    vault_hardening_configure_selinux_apparmor: true

  tasks:
    - name: Set file permissions and ownership
      file:
        path: /path/to/vault/file
        owner: root
        group: root
        mode: '0644'

    - name: Configure SELinux
      when: vault_hardening_configure_selinux_apparmor is defined and vault_hardening_configure_selinux_apparmor and ansible_selinux.status == "enabled"
      block:
        - name: Install SELinux policy package
          package:
            name: selinux-policy
            state: present

        - name: Set SELinux policy to targeted
          selinux:
            policy: targeted
            state: enforcing

    - name: Configure AppArmor
      when: vault_hardening_configure_selinux_apparmor is defined and vault_hardening_configure_selinux_apparmor and ansible_apparmor.status == "enabled"
      block:
        - name: Ensure AppArmor is enabled
          command: systemctl enable apparmor
          when: ansible_apparmor.status == "disabled"


