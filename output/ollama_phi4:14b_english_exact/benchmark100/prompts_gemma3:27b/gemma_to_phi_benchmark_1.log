---
- name: Check OS compatibility
  assert:
    that:
      - ansible_distribution == "Amazon"
        and ansible_distribution_version == "2"
      - ansible_os_family == "RedHat"
        and ansible_distribution_major_version in ['7', '8', '9']
  when: ansible_distribution in ['Amazon', 'RedHat']

- name: Install epel gpg key
  rpm_key:
    state: present
    key: "{{ epel_gpg_key }}"

- name: Install epel-release package
  yum:
    name: "{{ epel_url }}"
    state: present
  notify:
    - Update package cache

- name: Install epel-next-release package
  yum:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next | bool
  notify:
    - Update package cache


