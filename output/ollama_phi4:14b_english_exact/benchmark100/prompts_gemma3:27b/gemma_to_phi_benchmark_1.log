---
- name: Manage Prometheus Promtail user and group
  hosts: all
  become: true
  vars:
    promtail_system_user: "promtail"
    promtail_system_group: "promtail"
    promtail_user_additional_groups: []

  tasks:
    - name: Create promtail group
      group:
        name: "{{ promtail_system_group }}"
        state: present

    - name: Create promtail user
      user:
        name: "{{ promtail_system_user }}"
        group: "{{ promtail_system_group }}"
        groups: "{{ promtail_user_additional_groups | join(',') }}"
        shell: "/usr/sbin/nologin"
        system: true
        create_home: false
      when: promtail_system_user != "root"
