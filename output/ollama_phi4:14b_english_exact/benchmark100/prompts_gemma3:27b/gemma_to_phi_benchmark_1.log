---
- name: Manage services
  hosts: all
  vars:
    service_list:
      - name: example_service1
      - name: example_service2
  tasks:
    - name: Configure systemd service
      when: ansible_service_mgr == "systemd"
      systemd:
        name: "{{ item.name }}"
        enabled: yes
        state: started
      with_items: "{{ service_list }}"

    - name: Configure sysvinit service
      when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]
      template:
        src: sysvinit.j2
        dest: "/etc/init.d/{{ item.name }}"
        mode: '0755'
      with_items: "{{ service_list }}"


