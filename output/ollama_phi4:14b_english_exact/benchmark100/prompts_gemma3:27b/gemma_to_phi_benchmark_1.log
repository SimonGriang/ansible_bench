---
- name: Manage Prometheus Promtail user and group
  hosts: all
  become: true
  vars:
    promtail_system_user: "promtail"
    promtail_system_group: "promtail"
    promtail_user_additional_groups: []

  tasks:
    - name: Create promtail group
      group:
        name: "{{ promtail_system_group }}"
        state: present

