content='```yaml\n---\n- name: Gather bootstrap facts using raw command\n  ansible.builtin.raw:\n    cmd: cat /etc/os-release\n  register: bootstrap_facts\n  become: false\n  gather_facts: false\n\n- name: Set bootstrap facts (I) based on OS release information\n  ansible.builtin.set_fact:\n    bootstrap_distribution: "{{ item.key }}"\n    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout_lines | select(\'search\', item.value) | map(\'regex_search\', \'^(.+?)[.]([0-9]+)\', \'\\\\2\') | first }}"\n  when: bootstrap_facts.rc == 0\n    and bootstrap_distribution is not defined\n    and bootstrap_facts.stdout is search(item.value)\n  loop: "{{ bootstrap_os_family_map | dict2items }}"\n  loop_control:\n    label: "{{ item.key }}"\n\n- name: Set bootstrap facts (II) based on OS family\n  ansible.builtin.set_fact:\n    bootstrap_os_family: "{{ item.key }}"\n  when: bootstrap_distribution is defined\n    and bootstrap_distribution in item.value\n  loop: "{{ bootstrap_os_family_map | dict2items }}"\n  loop_control:\n    label: "{{ item.key }}"\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-21T16:48:11.769167175Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5403486829, 'load_duration': 57671990, 'prompt_eval_count': 549, 'prompt_eval_duration': 340239658, 'eval_count': 249, 'eval_duration': 5004182096, 'model_name': 'phi4:14b'} id='run--b8e52f81-3575-4acb-9304-c0674e1d3818-0' usage_metadata={'input_tokens': 549, 'output_tokens': 249, 'total_tokens': 798}
