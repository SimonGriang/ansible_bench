- name: Conditionally include Debian 12 tasks
  ansible.builtin.include_tasks: debian12.yml
  when: ansible_facts['os_family'] == "Debian" and ansible_facts['distribution_major_version'] | int >= 12

- name: Install Pip
  ansible.builtin.package:
    name: "{{ pip_package }}"
    state: present

- name: Install python3-packaging
  ansible.builtin.package:
    name: python3-packaging
    state: present

- name: Install pip packages
  ansible.builtin.pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default(omit) }}"
    virtualenv: "{{ item.virtualenv | default(omit) }}"
    state: "{{ item.state | default('present') }}"
    executable: "{{ pip_executable }}"
    extra_args: "{{ item.extra_args | default(omit) }}"
  loop: "{{ pip_install_packages }}"


