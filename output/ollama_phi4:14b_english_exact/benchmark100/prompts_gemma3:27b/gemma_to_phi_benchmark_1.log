---
- name: Enable Apache modules
  hosts: all
  tasks:
    - name: Enable 'proxy' and 'proxy_http' Apache modules
      ansible.builtin.apache2_module:
        name: "{{ item }}"
        state: present
      loop:
        - proxy
        - proxy_http
      when: ansible_facts['os_family'] in ['Debian', 'Suse']

- name: Configure Apache locations
  hosts: all
  tasks:
    - name: Create Apache location configuration files
      ansible.builtin.template:
        src: location.conf.j2
        dest: "{{ httpd_config_directory }}/{{ item.name }}.conf"
        mode: '0644'
      loop: "{{ httpd_locations }}"
      notify:
        - Test httpd configuration validity
        - Restart httpd


