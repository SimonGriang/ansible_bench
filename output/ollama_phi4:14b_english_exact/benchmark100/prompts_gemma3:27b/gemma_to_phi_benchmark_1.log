---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  lineinfile:
    path: "{{ mysql_name }}-server.cnf"
    line: "{{ item.option }} = {{ item.value }}"
  loop: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  lineinfile:
    path: "{{ mysql_name }}-client.cnf"
    line: "socket = {{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution == "Alpine" or ansible_distribution == "Archlinux"

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    target: "{{ item.target }}"
    encoding: "{{ item.encoding }}"
    collation: "{{ item.collation }}"
  loop: "{{ mysql_databases }}"
  vars:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"

- name: List databases
  mysql_info:
    filters:
      - name
  register: db_list
  vars:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  debug:
    var: db_list

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.target }}"
  loop: "{{ mysql_databases }}"
  when: item.import_target is defined and item.name not in db_list.db
  vars:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
  loop: "{{ mysql_users }}"
  vars:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"

- name: Flush handlers again
  meta: flush_handlers


