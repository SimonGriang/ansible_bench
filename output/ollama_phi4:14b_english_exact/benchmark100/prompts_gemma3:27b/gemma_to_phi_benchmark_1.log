---
- name: Ensure the easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize the easy-rsa PKI
  command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not stat_result.stat.exists
  register: stat_result
  stat:
    path: /etc/openvpn/easy-rsa/pki

- name: Build the Certificate Authority (CA)
  command: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/ca.crt
  environment:
    EASYRSA_BATCH: 'yes'

- name: Generate Diffie-Hellman parameters
  command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/dh.pem
  environment:
    EASYRSA_BATCH: 'yes'

- name: Build the server certificate
  command: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/issued/server.crt
  environment:
    EASYRSA_BATCH: 'yes'

- name: Build the client certificate
  command: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/issued/client.crt
  environment:
    EASYRSA_BATCH: 'yes'

- name: Generate the Certificate Revocation List (CRL)
  command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
    creates: /etc/openvpn/easy-rsa/pki/crl.pem
  environment:
    EASYRSA_BATCH: 'yes'

- name: Generate TLS authentication key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy PKI files to the server configuration directory
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/{{ item }}
    mode: '0640'
  loop:
    - ca.crt
    - dh.pem
    - ta.key
    - client.crt
    - server.crt
    - ca.key
    - client.key
    - server.key

- name: Copy ca.crt and ta.key to /etc/openvpn
  copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/{{ item }}
    mode: '0640'
  loop:
    - ca.crt
    - ta.key

- name: Place the server configuration file
  template:
    src: server.conf.j2
    dest: "{{ openvpn_configuration_directory }}/server.conf"
    owner: root
    group: root
    mode: '0640'
  notify: Restart openvpn


