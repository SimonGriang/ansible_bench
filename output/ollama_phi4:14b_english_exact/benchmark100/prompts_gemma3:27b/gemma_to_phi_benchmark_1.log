content='```yaml\n---\n- name: Import assert.yml\n  include_tasks: assert.yml\n  delegate_to: localhost\n  run_once: true\n\n- name: Enable redis module stream (RHEL 8)\n  dnf:\n    module_name: redis\n    state: present\n    enablerepo: \'epel\'\n  when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"\n\n- name: Install redis\n  package:\n    name: "{{ redis_packages }}"\n    state: present\n\n- name: Configure redis\n  template:\n    src: "redis.conf-{{ ansible_distribution }}.j2"\n    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"\n    owner: "{{ redis_owner }}"\n    group: "{{ redis_group }}"\n    mode: "{{ redis_mode }}"\n  notify:\n    - Restart redis\n\n- name: Start and enable redis\n  service:\n    name: "{{ redis_service }}"\n    state: started\n    enabled: yes\n```\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-21T17:24:32.559355185Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3224116031, 'load_duration': 70410693, 'prompt_eval_count': 490, 'prompt_eval_duration': 46907836, 'eval_count': 206, 'eval_duration': 3105955825, 'model_name': 'phi4:14b'} id='run--12a234b5-07a3-4a67-8f08-29e63e8c93c8-0' usage_metadata={'input_tokens': 490, 'output_tokens': 206, 'total_tokens': 696}
