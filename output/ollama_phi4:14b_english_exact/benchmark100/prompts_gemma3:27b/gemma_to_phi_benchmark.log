---
- name: Create etcd group
  ansible.builtin.group:
    name: etcd
    state: present

- name: Create etcd user
  ansible.builtin.user:
    name: etcd
    group: etcd
    shell: /bin/nologin
    comment: "Etcd service user"
    state: present

- name: Copy systemctl config file for kernel hardening
  ansible.builtin.copy:
    src: "{{ '/usr/local/share/rke2/' if (ansible_filesystem_writeable is defined and ansible_filesystem_writeable) and (partition_result.rc == 0) else '/usr/local/bin/rke2-cis-sysctl.conf' }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: '0600'
    remote_src: yes
  notify: Restart systemd-sysctl

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: yes


