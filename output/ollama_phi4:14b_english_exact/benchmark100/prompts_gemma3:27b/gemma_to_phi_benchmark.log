---
- name: Load OS-specific variables
  vars:
    os_variables:
      - "{{ ansible_facts['distribution'] | lower }}-{{ ansible_facts['distribution_version'] | replace('.', '') }}.yml"
      - "{{ ansible_facts['distribution'] | lower }}.yml"
      - "{{ ansible_facts['os_family'] | lower }}.yml"
      - "main.yml"
  include_vars:
    file: "{{ item }}"
  loop: "{{ os_variables }}"
  loop_control:
    label: "{{ item }}"
  when: lookup('first_found', files=os_variables)

- name: Include RedHat setup tasks
  include_tasks: redhat.yml
  when: ansible_facts.os_family == 'RedHat'

- name: Include Debian setup tasks
  include_tasks: debian.yml
  when: ansible_facts.os_family == 'Debian'

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: true
  when: 
    - ansible_version.full is version('2.12', '<')
    - ansible_facts.os_family not in ['RedHat', 'Debian']

- name: Install Docker packages (with downgrade option)
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    downlevel: true
  notify: restart docker
  ignore_errors: true
  when: 
    - ansible_version.full is version('2.12', '>=')
    - ansible_facts.os_family in ['RedHat', 'Debian']

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: true
  when: 
    - docker_install_compose_plugin | bool
    - ansible_version.full is version('2.12', '<')
    - ansible_facts.os_family not in ['RedHat', 'Debian']

- name: Install docker-compose-plugin (with downgrade option)
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    downlevel: true
  notify: restart docker
  ignore_errors: true
  when: 
    - docker_install_compose_plugin | bool
    - ansible_version.full is version('2.12', '>=')
    - ansible_facts.os_family in ['RedHat', 'Debian']

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker/
    state: directory
    mode: '0755'
  when: 
    - docker_daemon_options is defined
    - docker_daemon_options | length > 0

- name: Configure Docker daemon options
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_nice_yaml }}"
    mode: '0644'
  notify: restart docker
  when: 
    - docker_daemon_options is defined
    - docker_daemon_options | length > 0

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: true

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose | bool

- name: Get docker group info using getent
  getent:
    database: group
    key: docker
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  set_fact:
    at_least_one_user_to_modify: "{{ docker_users | difference(docker_group_info.getent['group']['docker', 'docker_users']) | length > 0 }}"

- name: Include docker-users tasks
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify | default(false)


