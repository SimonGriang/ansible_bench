---
- name: Prepare summary
  hosts: "{{ rke2_servers_group_name | default('rke2_servers_group_name') }}"
  tasks:
    - name: Execute shell command to retrieve Kubernetes node information
      shell: "kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes --output=wide --show-labels"
      args:
        chdir: "{{ rke2_data_path }}"
      register: nodes_summary
      retries: 5
      delay: 5
      until: nodes_summary is success
      run_once: true
      delegate_to: "{{ groups[rke2_servers_group_name][0] }}"

- name: K8s nodes state
  hosts: localhost
  tasks:
    - name: Display standard output of the nodes_summary variable
      debug:
        msg: "{{ nodes_summary.stdout_lines }}"


