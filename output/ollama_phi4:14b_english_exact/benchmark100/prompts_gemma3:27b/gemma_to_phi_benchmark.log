---
- name: Import assert.yml
  import_playbook: assert.yml
  hosts: localhost
  tasks: []

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: "mysql_name-server.cnf.j2"
    dest: "/etc/mysql/mysql_name-server.cnf"
    mode: 0644
  notify:
    - Restart mysql server

- name: Configure mysql client
  template:
    src: "mysql_name-client.cnf.j2"
    dest: "/etc/mysql/mysql_name-client.cnf"
    mode: 0644

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: "my.cnf.j2"
    dest: "/root/.my.cnf"
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('*.*:ALL') }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


