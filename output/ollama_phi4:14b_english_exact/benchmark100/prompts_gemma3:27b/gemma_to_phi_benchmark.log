content='```yaml\n---\n- name: Restart the RKE2 service\n  service:\n    name: "{{ rke2_service_name }}"\n    state: restarted\n  notify: Service (re)started\n\n- name: Wait for all nodes to be ready\n  shell: >\n    {{ rke2_data_path }}/kubectl get nodes --kubeconfig /etc/rancher/rke2/rke2.yaml -o jsonpath=\'{.items[?(@.status.conditions[?(@.type=="Ready")].status=="True")].metadata.name}\'\n  register: ready_nodes\n  until: (ready_nodes.stdout | length) == groups[rke2_cluster_group_name] | length\n  retries: 100\n  delay: 15\n  delegate_to: "{{ groups[rke2_servers_group_name][0] if \'active_server\' not in hostvars else hostvars[\'active_server\'] }}"\n  run_once: true\n\n- name: Wait for all pods to be ready\n  shell: >\n    {{ rke2_data_path }}/kubectl get pods --all-namespaces --kubeconfig /etc/rancher/rke2/rke2.yaml -o jsonpath=\'{.items[?(@.status.phase!="Running" and @.status.phase!="Succeeded")].metadata.name}\'\n  register: pending_pods\n  until: pending_pods.stdout | length == 0\n  retries: 100\n  delay: 15\n  delegate_to: "{{ groups[rke2_servers_group_name][0] if \'active_server\' not in hostvars else hostvars[\'active_server\'] }}"\n  run_once: true\n  when: rke2_wait_for_all_pods_to_be_ready | bool and not ansible_check_mode\n```\n\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-11T19:33:38.369846921Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7422586998, 'load_duration': 2588562246, 'prompt_eval_count': 674, 'prompt_eval_duration': 438551022, 'eval_count': 359, 'eval_duration': 4393562493, 'model_name': 'phi4:14b'} id='run--77560476-ee40-4139-8262-e4f739e4cfb0-0' usage_metadata={'input_tokens': 674, 'output_tokens': 359, 'total_tokens': 1033}
