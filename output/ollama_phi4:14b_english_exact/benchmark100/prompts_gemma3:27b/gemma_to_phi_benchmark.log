content='```yaml\n---\n- name: Check if the Helm binary exists\n  stat:\n    path: "{{ helm_bin_path }}"\n  register: helm_check\n\n- name: Check Helm version\n  command: helm version\n  register: helm_existing_version\n  failed_when: false\n  changed_when: false\n\n- name: Download helm\n  unarchive:\n    src: "{{ helm_repo_path }}/helm-{{ helm_version }}-linux-{{ helm_platform }}-{{ helm_arch }}.tar.gz"\n    dest: /tmp\n    remote_src: true\n  register: helm_download\n  when: not helm_check.stat.exists or (helm_existing_version.stdout.find(helm_version) == -1)\n\n- name: Copy helm binary into place\n  copy:\n    src: "/tmp/helm-{{ helm_version }}-linux-{{ helm_platform }}-{{ helm_arch }}/bin/helm"\n    dest: "{{ helm_bin_path }}"\n    mode: \'0755\'\n    remote_src: true\n  become: true\n  when: helm_download.changed\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-11T18:08:59.473556577Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3081602110, 'load_duration': 77502367, 'prompt_eval_count': 599, 'prompt_eval_duration': 229371332, 'eval_count': 219, 'eval_duration': 2773480369, 'model_name': 'phi4:14b'} id='run--dc8c7601-943b-421d-9c1b-a8c07498933d-0' usage_metadata={'input_tokens': 599, 'output_tokens': 219, 'total_tokens': 818}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- name: Check if the Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: helm version
  register: helm_existing_version
  failed_when: false
  changed_when: false

- name: Download helm
  unarchive:
    src: "{{ helm_repo_path }}/helm-{{ helm_version }}-linux-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: /tmp
    remote_src: true
  register: helm_download
  when: not helm_check.stat.exists or (helm_existing_version.stdout.find(helm_version) == -1)

- name: Copy helm binary into place
  copy:
    src: "/tmp/helm-{{ helm_version }}-linux-{{ helm_platform }}-{{ helm_arch }}/bin/helm"
    dest: "{{ helm_bin_path }}"
    mode: '0755'
    remote_src: true
  become: true
  when: helm_download.changed


