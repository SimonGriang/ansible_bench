---
- name: Create ssh_key_directory for user
  tasks:
    - name: Create a local directory to store SSH keys for a given user, set the appropriate permissions
      ansible.builtin.file:
        path: /home/{{ user.name }}/.ssh
        state: directory
        mode: '0700'
      when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Manage user account
  tasks:
    - name: Manage a user account with the `user` module
      ansible.builtin.user:
        name: "{{ user.name }}"
        comment: "{{ user.comment | default(omit) }}"
        home: "{{ user.home | default(omit) }}"
        create_home: "{{ user.create_home | default(omit) }}"
        password: "{{ user.password | default(omit) }}"
        uid: "{{ user.uid | default(omit) }}"
        group: "{{ user.group | default(omit) }}"
        shell: "{{ user.shell | default(omit) }}"
        expires: "{{ user.expires | default(omit) }}"
      register: user_result

- name: Set sudo options for user
  tasks:
    - name: Create a sudoers file for the user using a Jinja2 template
      ansible.builtin.template:
        src: sudoers.j2
        dest: "/etc/sudoers.d/{{ item.name }}"
        validate: 'visudo -cf %s'
      loop: "{{ users }}"
      loop_control:
        label: "{{ item.name }}"

- name: Remove sudo options for user
  tasks:
    - name: Remove the sudoers file for a user if sudo options are not defined
      ansible.builtin.file:
        path: "/etc/sudoers.d/{{ item.name }}"
        state: absent
      loop: "{{ users }}"
      loop_control:
        label: "{{ item.name }}"
      when: not item.sudo_options

- name: Generate private ssh key for user
  tasks:
    - name: Generate a private SSH key for the user
      ansible.builtin.command: >
        ssh-keygen -t rsa -b 2048 -f /home/{{ user.name }}/.ssh/id_rsa -N ""
      when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Generate public ssh key for user
  tasks:
    - name: Generate a public SSH key from the private key and save it to the specified directory
      ansible.builtin.command: >
        ssh-keygen -y -f /home/{{ user.name }}/.ssh/id_rsa > /home/{{ user.name }}/.ssh/id_rsa.pub
      when: user.manage_ssh_key

- name: Convert ssh key to ppk for user
  tasks:
    - name: Convert the SSH private key to PPK format
      ansible.builtin.command: >
        ssh-keygen -P '' -f /home/{{ user.name }}/.ssh/id_rsa -e > /home/{{ user.name }}/.ssh/id_rsa.ppk
      when: user.manage_ssh_key

- name: Get or set the home directory for user
  tasks:
    - name: Determine the user's home directory
      ansible.builtin.command: getent passwd {{ user.name }} | cut -d: -f6
      register: home_dir
      failed_when: home_dir.stdout == ''
      changed_when: false

    - name: Set fact for the base directory
      ansible.builtin.set_fact:
        home_directory: "{{ home_dir.stdout | default('/home') }}"

- name: Create .ssh directory for user
  tasks:
    - name: Create the .ssh directory within the user's home directory
      ansible.builtin.file:
        path: "{{ home_directory }}/.ssh"
        state: directory
        mode: '0700'
      become: true
      become_user: "{{ user.name }}"
      when: user.manage_ssh_key or user.private_keys

- name: Deploy authorized keys for user
  tasks:
    - name: Deploy authorized SSH keys for the user
      ansible.builtin.authorized_key:
        user: "{{ user.name }}"
        state: present
        key: "{{ item.key }}"
      loop: "{{ user.authorized_keys }}"

- name: Remove unauthorized keys for user
  tasks:
    - name: Remove unauthorized SSH keys from the user's authorized_keys file
      ansible.builtin.authorized_key:
        user: "{{ user.name }}"
        state: absent
        key: "{{ item.key }}"
      loop: "{{ user.unauthorized_keys }}"

- name: Copy generated private ssh key for user
  tasks:
    - name: Copy the generated private SSH key to the user's .ssh directory
      ansible.builtin.copy:
        src: /home/{{ user.name }}/.ssh/id_rsa
        dest: "{{ home_directory }}/.ssh/id_rsa"
        mode: '0600'
        owner: "{{ user.name }}"
        group: "{{ user.group | default('users') }}"
      when: user.copy_private_key

- name: Check users password valid time
  tasks:
    - name: Get the password valid time for the user by parsing /etc/shadow
      ansible.builtin.command: >
        awk -F: -v user="{{ user.name }}" '($1==user){print $5}' /etc/shadow
      register: valid_time
      changed_when: false

- name: Set users password valid time
  tasks:
    - name: Set the password valid time for the user
      ansible.builtin.user:
        name: "{{ user.name }}"
        password_expire_min: "{{ user.password_expire_min }}"
        password_expire_max: "{{ user.password_expire_max }}"

- name: Place private key file for user
  tasks:
    - name: Copy a private key file to the user's .ssh directory
      ansible.builtin.copy:
        content: "{{ item.content }}"
        dest: "{{ home_directory }}/.ssh/{{ item.name }}"
        mode: '0600'
        owner: "{{ user.name }}"
        group: "{{ user.group | default('users') }}"
      loop: "{{ user.private_keys }}"
      when: user.private_keys is defined


