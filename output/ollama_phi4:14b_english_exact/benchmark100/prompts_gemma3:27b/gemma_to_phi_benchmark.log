---
- name: Import assert.yml
  include_tasks: assert.yml
  hosts: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  lineinfile:
    path: "{{ mysql_name }}-server.cnf"
    line: "{{ item.key }} = {{ item.value }}"
    state: present
  loop: "{{ mysql_configuration_options }}"
  notify:
    - Reload mysql

- name: Configure mysql client
  lineinfile:
    path: "{{ mysql_name }}-client.cnf"
    line: "socket={{ mysql_socket }}"
    state: present
  notify:
    - Reload mysql

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    target: "{{ item.target }}"
    encoding: "{{ item.encoding }}"
    collation: "{{ item.collation }}"
  loop: "{{ mysql_databases }}"
  vars:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ ansible_default_ipv4.address }}"

- name: List databases
  mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ ansible_default_ipv4.address }}"
  register: db_list
  changed_when: false
  notify:
    - Log database list

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.target }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ ansible_default_ipv4.address }}"
  loop: "{{ mysql_databases }}"
  when: item.initial_import_target is defined and not db_list.db[item.name] | default(false)

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
  loop: "{{ mysql_users }}"
  vars:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ ansible_default_ipv4.address }}"

- name: Flush handlers again
  meta: flush_handlers


