50, 'load_duration': 56660574, 'prompt_eval_count': 655, 'prompt_eval_duration': 247773302, 'eval_count': 466, 'eval_duration': 6388138265, 'model_name': 'phi4:14b'} id='run--348a0b63-6f38-4e6e-a214-3351367727a8-0' usage_metadata={'input_tokens': 655, 'output_tokens': 466, 'total_tokens': 1121}
