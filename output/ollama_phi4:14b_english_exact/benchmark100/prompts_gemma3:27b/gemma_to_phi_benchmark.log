---
- name: Create the RKE2 config directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  ansible.builtin.template:
    src: rke2-config.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify: Restart RKE2

- name: Copy kubelet config
  ansible.builtin.template:
    src: kubelet-config.j2
    dest: /var/lib/rancher/rke2/data/kubelet/config.yaml
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: Restart RKE2

- name: Copy Containerd Registry Configuration file
  ansible.builtin.template:
    src: containerd-registry-config.j2
    dest: /etc/containerd/config.toml.d/10-custom-registry-mirrors-and-configs.toml
    mode: '0644'
  when: 
    - rke2_custom_registry_mirrors | length > 0
    - rke2_custom_registry_configs | length > 0
  notify: Restart RKE2

- name: Start RKE2 service on the rest of the nodes
  ansible.builtin.systemd:
    name: rke2
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  retries: 5
  delay: 10
  register: rke2_service_result
  notify: Restart RKE2

- name: Mask other RKE2 service on the rest of the nodes
  ansible.builtin.systemd:
    name: rke2-{{ item }}
    masked: true
    enabled: false
  loop: "{{ ['agent', 'server'] | difference([rke2_type]) }}"
  when: rke2_type in ['agent', 'server']

- name: Wait for remaining nodes to be ready - no CNI
  ansible.builtin.shell: kubectl wait --for condition=memory.available<100Mi --for condition=disk.available<10Mi --for condition=pid.available<1000 --for condition=condition=Ready kubelet --all-namespaces
  register: no_cni_ready
  until: no_cni_ready.rc == 0
  retries: 30
  delay: 10
  when:
    - rke2_cni == 'none'
    - rke2_type in ['server', 'first_server']

- name: Wait for remaining nodes to be ready - with CNI
  ansible.builtin.shell: kubectl get nodes --no-headers | grep -E 'Ready\s+true' | wc -l
  register: with_cni_ready
  until: with_cni_ready.stdout | int == ansible_play_batch | length
  retries: 30
  delay: 10
  when:
    - rke2_cni != 'none'
    - rke2_type in ['server', 'first_server']

handlers:
  - name: Restart RKE2
    ansible.builtin.systemd:
      name: rke2
      state: restarted


