---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  hosts: all
  tasks:
    - name: Update apk cache
      apk:
        update_cache: yes
      when: ansible_pkg_mgr == 'apk'

    - name: Upgrade all software
      apk:
        upgrade: yes
      when: ansible_pkg_mgr == 'apk'
      notify: Reboot

- name: Configure apt
  hosts: all
  tasks:
    - name: Prevent upgrades for specific packages
      apt:
        name: "{{ update_excluded_packages }}"
        state: hold
      when: ansible_pkg_mgr == 'apt'

    - name: Update apt cache
      apt:
        update_cache: yes
      when: ansible_pkg_mgr == 'apt'

    - name: Upgrade all software
      apt:
        upgrade: dist
      when: ansible_pkg_mgr == 'apt'
      notify: Reboot

    - name: Apt autoremove
      apt:
        autoremove: yes
      when: ansible_pkg_mgr == 'apt' and apt_autoremove_enabled | default(false) == true

- name: Update all software (dnf)
  hosts: all
  tasks:
    - name: Upgrade all software
      dnf:
        update_only: yes
        exclude: "{{ update_excluded_packages | join(',') }}"
      when: ansible_pkg_mgr in ['dnf', 'dnf5']
      notify: Reboot

- name: Update all software (pacman)
  hosts: all
  tasks:
    - name: Upgrade all software
      pacman:
        update_cache: yes
        upgrade: yes
      when: ansible_pkg_mgr == 'pacman'
      notify: Reboot

- name: Configure yum
  hosts: all
  tasks:
    - name: Update all software (yum 6)
      yum:
        update_only: yes
        exclude: "{{ update_excluded_packages | join(',') }}"
      when: ansible_pkg_mgr == 'yum' and ansible_distribution_major_version == '6'
      notify: Reboot

    - name: Update all software (yum 7+)
      yum:
        update_cache: yes
        upgrade: yes
        exclude: "{{ update_excluded_packages | join(',') }}"
      when: ansible_pkg_mgr == 'yum' and ansible_distribution_major_version != '6'
      notify: Reboot

- name: Update all software (zypper)
  hosts: all
  tasks:
    - name: Upgrade all software
      zypper:
        update: yes
      when: ansible_pkg_mgr == 'zypper'
      notify: Reboot


