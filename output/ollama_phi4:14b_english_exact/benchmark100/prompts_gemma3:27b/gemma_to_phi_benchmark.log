---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: "openjdk-{{ java_version }}-jdk"
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "--without-debug --without-manpages"

- name: Install RPM
  package:
    name: /tmp/{{ java_package_name }}
    state: present
  when: java_source == "local" and java_format == "rpm"
  pre_tasks:
    - name: Copy RPM to /tmp/
      copy:
        src: "{{ java_package_path }}"
        dest: /tmp/{{ java_package_name }}

- name: Install DEB
  package:
    name: /tmp/{{ java_package_name }}
    state: present
  when: java_source == "local" and java_format == "deb"
  pre_tasks:
    - name: Copy DEB to /tmp/
      copy:
        src: "{{ java_package_path }}"
        dest: /tmp/{{ java_package_name }}

- name: Install oracle java (rpm) (repository)
  package:
    name: "oracle-java{{ java_version }}-jdk"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  block:
    - name: Ensure installation directory exists
      file:
        path: "{{ java_installation_dir }}"
        state: directory

    - name: Extract Oracle Java targz
      unarchive:
        src: "{{ java_package_path }}"
        dest: "{{ java_installation_dir }}"
        remote_src: true
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_jce_package_path }}"
    dest: "/usr/local"
    remote_src: true
  when: java_jce == true and java_version == "8" and java_vendor == "oracle"

- name: Set alternative (targz)
  alternatives:
    name: java
    path: "{{ java_installation_dir }}/bin/java"
    link: /usr/bin/java
    priority: 2000
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java
  register: java_path
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_path.stdout | dirname | dirname }}"
    create: yes


