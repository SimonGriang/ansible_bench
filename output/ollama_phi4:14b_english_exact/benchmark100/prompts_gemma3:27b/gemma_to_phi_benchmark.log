\n  meta: flush_handlers\n```" additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-11T19:26:29.237594318Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10581863129, 'load_duration': 58988821, 'prompt_eval_count': 821, 'prompt_eval_duration': 321715677, 'eval_count': 578, 'eval_duration': 10200023121, 'model_name': 'phi4:14b'} id='run--4eff5628-9b2b-4adf-95d6-3ed1a49a2bcc-0' usage_metadata={'input_tokens': 821, 'output_tokens': 578, 'total_tokens': 1399}
