---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_TIMEOUT='
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: yes
    mode: '0664'
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_RECORDFAIL_TIMEOUT='
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: yes
    mode: '0664'
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  block:
    - name: "{{ option }}"
      lineinfile:
        path: /etc/default/grub
        regexp: '^GRUB_CMDLINE_LINUX=\".*{{ option }}.*\"$'
        line: 'GRUB_CMDLINE_LINUX="{{ grub_cmdline_linux | default("") }} {{ option }}"'
        insertafter: '^GRUB_CMDLINE_LINUX='
        create: yes
        mode: '0664'
      loop: "{{ grub_options }}"
      loop_control:
        label: "{{ item }}"
      when: grub_options is defined and grub_options | length > 0
  notify: Update grub
  vars:
    grub_cmdline_linux: "{{ lookup('file', '/etc/default/grub') | regex_replace('^GRUB_CMDLINE_LINUX=(.*)$', '\\1') | default('') }}"

- name: Import password.yml
  include_tasks: password.yml
  when: grub_set_password | bool

- name: Flush handlers
  meta: flush_handlers


