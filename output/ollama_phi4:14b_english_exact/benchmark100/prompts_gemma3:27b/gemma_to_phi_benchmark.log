  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: "my.cnf.j2"
    dest: "/root/.my.cnf"
    mode: '0640'

