---
- name: Gather service facts
  ansible.builtin.setup:
    gather_subset: '!all,!any,!min'

- name: Set the active_server variable
  ansible.builtin.set_fact:
    active_server: "{{ inventory_hostname }}"
  when:
    - "'rke2_servers_group_name' in group_names"
    - "'rke2-server.service' in services_facts.services"
    - services_facts.services['rke2-server.service'].state == 'running'
  delegate_to: "{{ item }}"
  loop: "{{ groups['rke2_cluster_group_name'] }}"


