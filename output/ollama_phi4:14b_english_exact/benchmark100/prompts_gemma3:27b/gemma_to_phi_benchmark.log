- name: Prepare system
  block:
    - name: Test connection
      ping:

    - name: Test sudo access
      command: /bin/true
      become: true

  rescue:
    - name: Gather facts
      setup:

    - name: Install bootstrap packages via raw
      raw: yum install -y bootstrap-package

    - name: Ensure libdnf5 is present on RedHat-based systems
      package:
        name: libdnf5
        state: present
      when: ansible_os_family == "RedHat"

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: yes
    state: present
  become: "{{ bootstrap_become }}"


