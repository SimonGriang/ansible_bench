- name: Start and enable promtail service
  become: true
  tags:
    - promtail_run
    - promtail
  block:
    - name: Reload systemd daemon
      ansible.builtin.systemd:
        daemon_reload: true

    - name: Ensure promtail service is started and enabled
      ansible.builtin.service:
        name: "{{ promtail_systemd_service }}"
        state: started
        enabled: true


