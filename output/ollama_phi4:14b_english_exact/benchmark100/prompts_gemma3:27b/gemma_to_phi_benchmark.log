    state: present

- name: Configure selinux
  block:
    - name: Configure SELinux booleans
      seboolean:
        name: "{{ item.key }}"
        state: "{{ item.value }}"
        persistent: yes
      loop: "{{ httpd_sebooleans | dict2items }}"
    - name: Allow connections to custom ports
      seport:
        ports: "{{ item }}"
        proto: tcp
        setype: http_port_t
        state: present
      loop:
        - "{{ httpd_port }}"
        - "{{ httpd_ssl_port }}"
  when: ansible_selinux.status == "enabled"

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify:
    - Test httpd configuration
    - Restart httpd

- name: Activate httpd module | Debian
  command: a2enmod "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == "Debian"

- name: Import ssl.yml
  include_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml
  include_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  include_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf_j2 }}"
    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
    mode: '0644'
  notify:
    - Test httpd configuration
    - Restart httpd
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directories.yml
  include_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes

handlers:
  - name: Test httpd configuration
    command: httpd -t

  - name: Restart httpd
    service:
      name: "{{ httpd_service }}"
      state: restarted


