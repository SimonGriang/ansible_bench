---
- name: Secure Vault Configuration
  hosts: all
  become: yes
  tasks:
    - name: Remove 'ansible-vault' from shell history
      shell: history -c && history -w

    - name: Set file permissions to 0644, owner to root, and group to root
      file:
        path: /path/to/your/file
        mode: '0644'
        owner: root
        group: root

    - name: Configure SELinux/AppArmor
      block:
        - name: Install selinux-policy if SELinux is enabled
          package:
            name: selinux-policy
            state: present
          when:
            - vault_hardening_configure_selinux_apparmor
            - ansible_selinux.status == "enabled"

        - name: Set SELinux policy to targeted and state to enforcing
          selinux:
            policy: targeted
            state: enforcing
          when:
            - vault_hardening_configure_selinux_apparmor
            - ansible_selinux.status == "enabled"

        - name: Check if AppArmor is enabled
          debug:
            msg: "AppArmor is enabled"
          when: ansible_apparmor.status == "enabled"

    - name: Ensure AppArmor is not enabled
      lineinfile:
        path: /etc/apparmor.d/disable
        line: "your_apparmor_profile"
      when: ansible_apparmor.status == "enabled"


