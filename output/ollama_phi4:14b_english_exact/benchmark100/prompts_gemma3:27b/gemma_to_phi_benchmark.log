---
- name: Enable the Backports repository for Debian
  ansible.builtin.apt_repository:
    repo: >
      deb http://deb.debian.org/debian {{ ansible_lsb.codename }}-backports main
    filename: "{{ ansible_lsb.codename }}-backports"
    state: present
  when: ansible_facts['distribution_version'] is version('9', '<')

- name: Update apt cache after adding the repository
  ansible.builtin.apt:
    update_cache: true
  when: ansible_facts['distribution_version'] is version('9', '<')

- name: Set the default_release fact for older Debian versions
  ansible.builtin.set_fact:
    ansible_default_release: "{{ ansible_lsb.codename }}-backports"
  when: ansible_facts['distribution_version'] is version('9', '<')

- name: Install Ansible
  ansible.builtin.apt:
    name: ansible
    state: "{{ ansible_package_state }}"
    default_release: >
      {{ ansible_default_release | default(ansible_lsb.codename) }}


