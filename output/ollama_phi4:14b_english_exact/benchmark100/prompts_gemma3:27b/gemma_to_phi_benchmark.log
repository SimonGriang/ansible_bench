---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install DNS packages
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_datadir | default('0755') if item == dns_datadir else dns_confdir | default('0755') if item == dns_confdir else '0755' }}"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create DNS group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create DNS user
  user:
    name: "{{ dns_owner }}"
    system: yes
    state: present

- name: Generate rndc key
  command: rndc-confgen -a -r /dev/urandom
  args:
    chdir: "{{ dns_confdir }}"
    creates: "{{ dns_confdir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0400'

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/root.hints"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0644'
    force: no
  when: dns_caching_dns == true
  notify: Rndc reload

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.zone }}.db"
  loop: "{{ dns_zones }}"
  notify: Rndc reload
  changed_when: false
  post_tasks:
    - name: Validate zone file
      command: named-checkzone "{{ item.zone }}" "{{ dns_datadir }}/{{ item.zone }}.db"
      loop: "{{ dns_zones }}"
      changed_when: false

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
  notify: Restart dns
  changed_when: false
  post_tasks:
    - name: Validate configuration
      command: named-checkconf
      changed_when: false
    - name: Backup configuration file
      copy:
        src: "{{ dns_confdir }}/named.conf"
        dest: "{{ dns_confdir }}/named.conf.bak"
      changed_when: false

- name: Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        state: directory
    - name: Copy systemd override file
      copy:
        src: override.conf
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
  when: ansible_service_mgr == "systemd"
  notify: Reload systemd

- name: Start and enable DNS
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: yes


