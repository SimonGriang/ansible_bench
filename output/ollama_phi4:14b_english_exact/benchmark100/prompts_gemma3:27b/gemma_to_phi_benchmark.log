    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - Validate postfix configuration
    - Restart postfix
  when: master_cf_template is defined

- name: Creates cert/key directory
  file:
    path: "{{ postfix_tls_cert_key_dir }}"
    state: directory
    mode: '0755'
  when: postfix_tls_cert_key_dir is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_server_cert_src }}"
    dest: "{{ postfix_tls_cert_key_dir }}/server-cert.pem"
    mode: '0644'
  when: postfix_tls_server_cert_src is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_server_key_src }}"
    dest: "{{ postfix_tls_cert_key_dir }}/server-key.pem"
    mode: '0600'
  when: postfix_tls_server_key_src is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
    mode: '0644'
  notify:
    - Newaliases
  when: postfix_aliases is defined

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: '0644'
  notify:
    - Reload postfix
  when: postfix_sender_access is defined

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: '0644'
  notify:
    - Reload postfix
  when: postfix_recipient_access is defined

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: /etc/postfix/sasl/sasl_password_map
    mode: '0600'
  when: postfix_sasl_password_map is defined

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true


