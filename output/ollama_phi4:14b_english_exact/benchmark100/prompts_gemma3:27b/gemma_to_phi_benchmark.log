le_pkg_mgr == \'yum\' and ansible_distribution_major_version != \'6\'\n      notify: Reboot\n\n- name: Update all software (zypper)\n  hosts: all\n  tasks:\n    - name: Upgrade all software\n      zypper:\n        update: yes\n      when: ansible_pkg_mgr == \'zypper\'\n      notify: Reboot\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-11T18:04:55.414910577Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9592392593, 'load_duration': 84976681, 'prompt_eval_count': 604, 'prompt_eval_duration': 286045253, 'eval_count': 564, 'eval_duration': 9220467030, 'model_name': 'phi4:14b'} id='run--ff91b34c-6bb7-4df3-b424-f66613983aa8-0' usage_metadata={'input_tokens': 604, 'output_tokens': 564, 'total_tokens': 1168}
