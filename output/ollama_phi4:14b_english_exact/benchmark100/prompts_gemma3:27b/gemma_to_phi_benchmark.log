---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  gather_facts: no

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  when: python_pip_proxy is defined
  block:
    - name: Ensure pip.conf exists
      file:
        path: /etc/pip.conf
        state: touch
        mode: '0644'

    - name: Set pip proxy settings
      ini_file:
        path: /etc/pip.conf
        section: global
        option: index-url
        value: "{{ python_pip_proxy }}"
        mode: '0644'

- name: Trust hosts
  when: python_pip_trusted_host is defined
  block:
    - name: Ensure pip.conf exists
      file:
        path: /etc/pip.conf
        state: touch
        mode: '0644'

    - name: Set trusted hosts for pip
      ini_file:
        path: /etc/pip.conf
        section: global
        option: trusted-host
        value: "{{ python_pip_trusted_host }}"
        mode: '0644'

- name: Update pip
  when: ansible_facts['os_family'] != 'Debian' or
        ansible_facts['distribution_version'] not in ['bookworm', 'noble']
  and: ansible_facts['os_family'] != 'Alpine'
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"

- name: Install requested modules
  when: ansible_facts['os_family'] != 'Debian' or
        ansible_facts['distribution_version'] not in ['bookworm', 'noble']
  and: ansible_facts['os_family'] != 'Alpine'
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(omit) }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  loop_control:
    label: "{{ item.name }}"


