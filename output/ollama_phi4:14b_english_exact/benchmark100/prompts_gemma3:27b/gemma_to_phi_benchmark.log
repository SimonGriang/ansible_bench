---
- name: Check current docker-compose version
  ansible.builtin.command:
    cmd: docker-compose version --short
  register: docker_compose_vsn
  check_mode: false
  changed_when: false
  failed_when: false

- name: Set docker-compose current version fact
  ansible.builtin.set_fact:
    docker_compose_current_version: "{{ docker_compose_vsn.stdout | regex_search('^(\\d+\\.\\d+\\.\\d+)', '\\1') }}"
  when: docker_compose_vsn.stdout is defined and docker_compose_vsn.stdout != ""

- name: Delete existing docker-compose version if it's different
  ansible.builtin.file:
    path: "{{ docker_compose_path }}"
    state: absent
  when: docker_compose_current_version is defined and docker_compose_current_version | length > 0 and 
        (docker_compose_current_version | replace('v', '') != docker_compose_version | replace('v', ''))

- name: Install Docker Compose (if configured)
  ansible.builtin.get_url:
    url: "{{ docker_compose_url }}"
    dest: "{{ docker_compose_path }}"
    mode: '0755'
  when: (docker_compose_current_version is not defined or docker_compose_current_version | length == 0 or
         (docker_compose_current_version | replace('v', '') < docker_compose_version | replace('v', '')))


