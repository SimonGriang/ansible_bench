---
- name: Configure services
  hosts: all
  vars:
    ansible_service_mgr: "{{ ansible_service_mgr | default('systemd') }}"
    service_list:
      - name: example_service_1
      - name: example_service_2

  tasks:
    - name: Configure systemd service
      template:
        src: systemd.j2
        dest: "/etc/systemd/system/{{ item.name }}.service"
      when: ansible_service_mgr == "systemd"
      loop: "{{ service_list }}"

    - name: Configure upstart service
      template:
        src: upstart.j2
        dest: "/etc/init/{{ item.name }}.conf"
      when: ansible_service_mgr == "upstart"
      loop: "{{ service_list }}"

    - name: Configure openrc service
      template:
        src: openrc.j2
        dest: "/etc/init.d/{{ item.name }}"
      when: ansible_service_mgr == "openrc"
      loop: "{{ service_list }}"

    - name: Configure sysvinit service
      template:
        src: sysvinit.j2
        dest: "/etc/init.d/{{ item.name }}"
        mode: '0755'
      when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]
      loop: "{{ service_list }}"


