content='```yaml\n---\n- name: Prepare summary\n  hosts: "{{ rke2_servers_group_name | default(\'rke2_servers_group_name\') }}"\n  tasks:\n    - name: Execute shell command to retrieve Kubernetes node information\n      shell: "kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes --output=wide --show-labels"\n      args:\n        chdir: "{{ rke2_data_path }}"\n      register: nodes_summary\n      retries: 5\n      delay: 5\n      until: nodes_summary is success\n      run_once: true\n      delegate_to: "{{ groups[rke2_servers_group_name][0] }}"\n\n- name: K8s nodes state\n  hosts: localhost\n  tasks:\n    - name: Display standard output of the nodes_summary variable\n      debug:\n        msg: "{{ nodes_summary.stdout_lines }}"\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-11T19:25:29.476458917Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3665445464, 'load_duration': 71867717, 'prompt_eval_count': 403, 'prompt_eval_duration': 44204845, 'eval_count': 185, 'eval_duration': 3548498307, 'model_name': 'phi4:14b'} id='run--6eb619a5-212c-42d6-a3b0-109e72b64ab9-0' usage_metadata={'input_tokens': 403, 'output_tokens': 185, 'total_tokens': 588}
