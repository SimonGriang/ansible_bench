content='```yaml\n---\n- name: Create etcd group\n  ansible.builtin.group:\n    name: etcd\n    state: present\n\n- name: Create etcd user\n  ansible.builtin.user:\n    name: etcd\n    group: etcd\n    shell: /bin/nologin\n    comment: "Etcd service user"\n    state: present\n\n- name: Copy systemctl config file for kernel hardening\n  ansible.builtin.copy:\n    src: >-\n      {{\n        \'/usr/local/share/rke2/\'\n        if (ansible_filesystem_writeable is defined and ansible_filesystem_writeable)\n        and (partition_result.rc == 0)\n        else\n        \'/usr/local/bin/rke2-cis-sysctl.conf\'\n      }}\n    dest: /etc/sysctl.d/60-rke2-cis.conf\n    mode: \'0600\'\n    remote_src: true\n  notify: Restart systemd-sysctl\n\n- name: Flush handlers\n  ansible.builtin.meta:\n    flush_handlers: true\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-11T19:24:57.136354219Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3388037718, 'load_duration': 50086099, 'prompt_eval_count': 827, 'prompt_eval_duration': 12697657, 'eval_count': 218, 'eval_duration': 3323711738, 'model_name': 'phi4:14b'} id='run--ec6ec83d-699f-4dfc-af6f-ac9e09308a35-0' usage_metadata={'input_tokens': 827, 'output_tokens': 218, 'total_tokens': 1045}
