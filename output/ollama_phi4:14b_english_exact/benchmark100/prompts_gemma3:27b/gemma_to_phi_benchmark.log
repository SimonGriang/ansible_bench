- name: Conditionally include Debian 12 tasks
  include_tasks: debian12.yml
  when: ansible_facts['os_family'] == "Debian" and ansible_facts['distribution_major_version'] == "12"

- name: Install Pip
  package:
    name: "{{ pip_package }}"
    state: present

- name: Install python3-packaging
  package:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default(omit) }}"
    virtualenv: "{{ item.virtualenv | default(omit) }}"
    state: "{{ item.state | default('present') }}"
    extra_args: "{{ item.extra_args | default(omit) }}"
  loop: "{{ pip_install_packages }}"
  vars:
    ansible_python_interpreter: "{{ pip_executable }}"


