---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'docker'
    - ansible_connection != 'podman'
    - bootstrap_wait_for_host | default(false)
  become: false

- name: Prepare system
  block:
    - name: Test connection and verify sudo access
      command: echo "Connection and sudo access verified"
      register: prep_result
      changed_when: false
      failed_when: false
      become: false
  rescue:
    - name: Gather bootstrap facts
      setup:
        gather_subset: "!all"
    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages | default([]) }}"
        state: present
      become: "{{ bootstrap_become | default(false) }}"

- name: Gather ansible facts
  setup:
    gather_subset: '!all'
  become: false

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages | default([]) }}"
    state: present
  become: "{{ bootstrap_become | default(false) }}"


