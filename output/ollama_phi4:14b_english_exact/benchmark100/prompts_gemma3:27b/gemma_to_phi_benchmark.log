            - ansible_apparmor.status == "enabled"

    - name: Ensure AppArmor is not enabled
      lineinfile:
        path: /etc/apparmor.d/disable
        line: "your_apparmor_profile"
      when:
        - ansible_apparmor.status == "enabled"


