---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  ansible.builtin.package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: yes

- name: Configure selinux
  ansible.posix.selinux:
    policy: "{{ selinux_policy }}"
    state: "{{ selinux_state }}"
  when: ansible_selinux.status is defined and ansible_connection != 'container'
  notify: Reboot

- name: Manage selinux booleans
  community.general.selinux_booleans:
    name: "{{ item.name }}"
    state: "{{ item.state | default('yes') }}"
    persistent: "{{ item.persistent | default(omit) }}"
  loop: "{{ selinux_booleans }}"
  when: selinux_booleans is defined
  loop_control:
    label: "{{ item.name }}"


