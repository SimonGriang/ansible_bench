        dest: "/tmp/{{ item.filename }}"
      loop: "{{ rke2_checksum_and_artifacts }}"
      when: airgap_mode

    - name: Copy local RKE2 artifacts to remote hosts
      copy:
        src: "/tmp/{{ item.filename }}"
        dest: "{{ rke2_artifacts_path }}/{{ item.filename }}"
      loop: "{{ rke2_checksum_and_artifacts }}"
      when: airgap_mode
  when: airgap_mode

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ local_rke2_artifacts_path }}/{{ item }}"
    dest: "{{ rke2_artifacts_path }}/{{ item }}"
  loop: "{{ rke2_artifacts_files }}"
  when: airgap_mode and rke2_artifacts_impl == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ local_rke2_images_path }}/{{ item }}"
    dest: "{{ rke2_images_path }}/{{ item }}"
  loop: "{{ rke2_additional_images_tarballs }}"
  when: airgap_mode

