---
- name: Restart the RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready
  shell: >
    {{ rke2_data_path }}/kubectl get nodes
    --kubeconfig /etc/rancher/rke2/rke2.yaml
    -o jsonpath='{.items[?(@.status.conditions[?(@.type=="Ready")].status=="True")].metadata.name}'
  register: ready_nodes
  until: 
    (ready_nodes.stdout | length) == 
    groups[rke2_cluster_group_name] | length
  retries: 100
  delay: 15
  delegate_to: >-
    {{ 'active_server' in hostvars and hostvars['active_server'] or groups[rke2_servers_group_name][0] }}
  run_once: true

- name: Wait for all pods to be ready
  shell: >
    {{ rke2_data_path }}/kubectl get pods --all-namespaces
    --kubeconfig /etc/rancher/rke2/rke2.yaml
    -o jsonpath='{.items[?(@.status.phase!="Running" and @.status.phase!="Succeeded")].metadata.name}'
  register: pending_pods
  until: pending_pods.stdout | length == 0
  retries: 100
  delay: 15
  delegate_to: >-
    {{ 'active_server' in hostvars and hostvars['active_server'] or groups[rke2_servers_group_name][0] }}
  run_once: true
  when: 
    rke2_wait_for_all_pods_to_be_ready | bool and 
    not ansible_check_mode


