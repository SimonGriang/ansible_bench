      when: airgap_mode
  when: airgap_mode

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ local_rke2_artifacts_path }}/{{ item }}"
    dest: "{{ rke2_artifacts_path }}/{{ item }}"
  loop: "{{ rke2_artifacts_files }}"
  when: airgap_mode and rke2_artifacts_impl == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ local_rke2_images_path }}/{{ item }}"
    dest: "{{ rke2_images_path }}/{{ item }}"
  loop: "{{ rke2_additional_images_tarballs }}"
  when: airgap_mode

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke2_artifacts_path }}/{{ item }}"
    state: file
    mode: '0644'
  loop: "{{ rke2_artifacts_files }}"
  when: 
    - airgap_mode
    - (ansible_fileglob.stat[0].mode | int(4) > 6 or 
       ansible_fileglob.stat[0].mode | int(6) > 4)

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  command: df -P /usr/local
  register: fs_stats

- name: Check if separate partition
  set_fact:
    separate_partition: "{{ fs_stats.stdout_lines[1].split()[1] != '/' }}"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin"
  when: separate_partition
  set_fact:
    rke2_bin_path: "/var/lib/rancher/rke2/bin"
  when: not separate_partition

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }}/rke2 version"
  register: rke2_version_output

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version_output.stdout_lines[0].split(' ')[2] }}"
    rke2_running_version: "{{ rke2_version_output.stdout_lines[1].split(' ')[2] }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_installed_version == rke2_running_version
    fail_msg: "Downgrade is not allowed unless explicitly permitted."

- name: Run RKE2 install script
  shell: |
    /tmp/rke2-install.sh --set-node-ip {{ ansible_default_ipv4.address }} {{ rke2_install_options }}
  environment:
    RKE2_DATA_DIR: "{{ rke2_data_dir }}"
    RKE2_ARTIFACT_PATH: "{{ rke2_artifacts_path }}"

- name: Copy Custom Manifests
  copy:
    src: "{{ custom_manifests_path }}/{{ item }}"
    dest: "{{ rke2_data_dir }}/manifests/{{ item }}"
  loop: "{{ custom_manifests_files }}"

- name: Copy Static Pods
  copy:
    src: "{{ static_pod_manifests_path }}/{{ item }}"
    dest: "{{ rke2_agent_dir }}/manifests/{{ item }}"
  loop: "{{ static_pod_manifests_files }}"

- name: Copy RKE2 environment file
  template:
    src: "{{ rke2_env_template_path }}"
    dest: "{{ rke2_data_dir }}/env.yaml"


