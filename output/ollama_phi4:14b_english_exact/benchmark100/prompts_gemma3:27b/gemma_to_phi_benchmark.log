---
- name: Gather bootstrap facts
  block:
    - name: Lookup bootstrap facts
      ansible.builtin.command: cat /etc/os-release
      register: bootstrap_facts
      changed_when: false
      ignore_errors: true

    - name: Set bootstrap facts (I)
      ansible.builtin.set_fact:
        bootstrap_distribution: "{{ item.value }}"
        bootstrap_distribution_major_version: >-
          {{ bootstrap_facts.stdout |
             regex_search(item.value ~ ' (\\d+)\\..*', '\\1') }}
      loop: "{{ bootstrap_os_family_map | dict2items }}"
      loop_control:
        label: "{{ item.key }}"
      when:
        - bootstrap_facts.rc == 0
        - bootstrap_facts.stdout is search(item.value)
        - not bootstrap_distribution is defined

    - name: Set bootstrap facts (II)
      ansible.builtin.set_fact:
        bootstrap_os_family: "{{ item.key }}"
      loop: "{{ bootstrap_os_family_map | dict2items }}"
      loop_control:
        label: "{{ item.key }}"
      when: bootstrap_distribution in item.value


