---
- name: Remove old Docker apt key file
  ansible.builtin.file:
    path: /etc/apt/trusted.gpg.d/docker.asc
    state: absent

- name: Remove old Docker source list file
  ansible.builtin.file:
    path: "/etc/apt/sources.list.d/{{ docker_apt_ansible_distribution }}.list"
    state: absent

- name: Remove obsolete Docker packages
  ansible.builtin.package:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Remove legacy Docker repository file
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install Docker dependencies
  ansible.builtin.apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: yes

- name: Manage Docker repository
  ansible.builtin.deb822_repository:
    filename: "{{ docker_apt_filename }}"
    repo: "{{ docker_repo_url }}"
    distribution: "{{ ansible_facts.distribution }}"
    distribution_release: "{{ ansible_facts.distribution_release }}"
    components:
      - "{{ docker_apt_release_channel }}"
    key: "{{ docker_apt_gpg_key }}"
    state: "{{ 'present' if docker_add_repo else 'absent' }}"
  notify: 
    - apt update

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: yes

handlers:
  - name: apt update
    ansible.builtin.apt:
      update_cache: yes


