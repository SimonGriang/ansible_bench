---
- name: Set the ansible_package_state fact
  ansible.builtin.set_fact:
    ansible_package_state: >-
      {{ 'present' if ansible_install_method == 'package'
      else 'absent' }}

- name: Include setup-RedHat.yml tasks file
  ansible.builtin.include_tasks: setup-RedHat.yml
  when: >
    ansible_os_family == 'RedHat'
    and ansible_distribution != 'Fedora'
    and ansible_install_method == 'package'

- name: Include setup-Fedora.yml tasks file
  ansible.builtin.include_tasks: setup-Fedora.yml
  when: >
    ansible_distribution == 'Fedora'
    and ansible_install_method == 'package'

- name: Include setup-Ubuntu.yml tasks file
  ansible.builtin.include_tasks: setup-Ubuntu.yml
  when: >
    ansible_distribution == 'Ubuntu'
    and ansible_install_method == 'package'

- name: Include setup-Debian.yml tasks file
  ansible.builtin.include_tasks: setup-Debian.yml
  when: >
    ansible_distribution == 'Debian'
    and ansible_install_method == 'package'

- name: Include setup-pip.yml tasks file
  ansible.builtin.include_tasks: setup-pip.yml
  when: ansible_install_method == 'pip'


