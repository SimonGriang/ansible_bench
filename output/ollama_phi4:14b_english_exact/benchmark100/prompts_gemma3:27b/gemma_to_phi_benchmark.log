---
- name: Create document roots for virtual hosts
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - item.create_docroot | default(false)

- name: Configure virtual hosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Enable virtual hosts on Debian-based systems
  command: a2ensite {{ item.name }}
  args:
    creates: "{{ httpd_vhosts_directory }}/sites-enabled/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian'
  notify:
    - Test httpd configuration validity
    - Restart httpd


