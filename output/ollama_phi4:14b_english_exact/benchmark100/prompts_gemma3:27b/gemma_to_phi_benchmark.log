---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'container'
    - bootstrap_wait_for_host | bool

- name: Prepare system
  block:
    - name: Test connection
      ping:

    - name: Test sudo access
      command: /bin/true
      become: yes

  rescue:
    - name: Gather facts
      setup:

    - name: Install bootstrap packages via raw
      raw: yum install -y bootstrap-package

    - name: Ensure libdnf5 is present on RedHat-based systems
      package:
        name: libdnf5
        state: present
      when: ansible_os_family == "RedHat"

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: yes
    state: present
  become: "{{ bootstrap_become }}"


