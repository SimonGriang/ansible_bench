  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example == true

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


