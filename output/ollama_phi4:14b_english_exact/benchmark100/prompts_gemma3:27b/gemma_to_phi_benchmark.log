- name: Get all RKE2 nodes
  command: kubectl get nodes -o=name --kubeconfig={{ kubeconfig_file }}
  register: all_nodes
  changed_when: false

- name: Set fact for node names
  set_fact:
    node_names: "{{ all_nodes.stdout_lines | map('regex_replace', '^.*/(.+)$', '\\1') | list }}"

