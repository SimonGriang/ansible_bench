ted private ssh key for user\n  tasks:\n    - name: Copy the generated private SSH key to the user\'s .ssh directory\n      ansible.builtin.copy:\n        src: /home/{{ user.name }}/.ssh/id_rsa\n        dest: "{{ home_directory }}/.ssh/id_rsa"\n        mode: \'0600\'\n        owner: "{{ user.name }}"\n        group: "{{ user.group | default(\'users\') }}"\n      when: user.copy_private_key\n\n- name: Check users password valid time\n  tasks:\n    - name: Get the password valid time for the user by parsing /etc/shadow\n      ansible.builtin.command: >\n        awk -F: -v user="{{ user.name }}" \'($1==user){print $5}\' /etc/shadow\n      register: valid_time\n      changed_when: false\n\n- name: Set users password valid time\n  tasks:\n    - name: Set the password valid time for the user\n      ansible.builtin.user:\n        name: "{{ user.name }}"\n        password_expire_min: "{{ user.password_expire_min }}"\n        password_expire_max: "{{ user.password_expire_max }}"\n\n- name: Place private key file for user\n  tasks:\n    - name: Copy a private key file to the user\'s .ssh directory\n      ansible.builtin.copy:\n        content: "{{ item.content }}"\n        dest: "{{ home_directory }}/.ssh/{{ item.name }}"\n        mode: \'0600\'\n        owner: "{{ user.name }}"\n        group: "{{ user.group | default(\'users\') }}"\n      loop: "{{ user.private_keys }}"\n      when: user.private_keys is defined\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-11T18:27:40.653873482Z', 'done': True, 'done_reason': 'stop', 'total_duration': 23361370364, 'load_duration': 68855899, 'prompt_eval_count': 2336, 'prompt_eval_duration': 651523357, 'eval_count': 1283, 'eval_duration': 22639798576, 'model_name': 'phi4:14b'} id='run--21c0551a-0047-47aa-bc65-2a5377701474-0' usage_metadata={'input_tokens': 2336, 'output_tokens': 1283, 'total_tokens': 3619}
