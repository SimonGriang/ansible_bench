- name: Gather bootstrap facts
  block:
    - name: Lookup bootstrap facts
      command: cat /etc/os-release
      register: bootstrap_facts
      changed_when: false
      ignore_errors: true

    - name: Set bootstrap facts (I)
      set_fact:
        bootstrap_distribution: "{{ item.value }}"
        bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search(item.value ~ ' (\\d+)\\..*', '\\1') }}"
      loop: "{{ bootstrap_os_family_map | dict2items }}"
      loop_control:
        label: "{{ item.key }}"
      when:
