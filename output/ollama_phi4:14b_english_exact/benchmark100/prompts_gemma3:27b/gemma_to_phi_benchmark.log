---
- name: Create the RKE2 config directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  ansible.builtin.template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  ansible.builtin.template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  ansible.builtin.template:
    src: containerd-config.toml.j2
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

- name: Register if we need to do an etcd restore from file
  ansible.builtin.set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and (rke2_server_service is not defined or rke2_server_service | default('') | length == 0)

- name: Register if we need to do an etcd restore from s3
  ansible.builtin.set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined

- name: Restore etcd from file
  block:
    - name: Create destination directory for etcd snapshot
      ansible.builtin.file:
        path: /var/lib/rancher/rke2/etcd
        state: directory
        mode: '0755'

    - name: Copy etcd snapshot file
      ansible.builtin.copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/etcd/snapshot.db
        owner: root
        group: root
        mode: '0644'

    - name: Run rke2 server with snapshot file
      ansible.builtin.command: >
        rke2 server
        --node-ip "{{ ansible_host }}"
        --server
        --etcd-snapshot-s3-access-key "{{ rke2_etcd_snapshot_s3_options.access_key }}"
        --etcd-snapshot-s3-secret-key "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
        --etcd-snapshot-s3-bucket "{{ rke2_etcd_snapshot_s3_options.bucket }}"
        --etcd-snapshot-file /var/lib/rancher/rke2/etcd/snapshot.db
      when: do_etcd_restore | default(false)

- name: Restore etcd from s3
  ansible.builtin.command: >
    rke2 server
    --node-ip "{{ ansible_host }}"
    --server
    --etcd-snapshot-s3-access-key "{{ rke2_etcd_snapshot_s3_options.access_key }}"
    --etcd-snapshot-s3-secret-key "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
    --etcd-snapshot-s3-bucket "{{ rke2_etcd_snapshot_s3_options.bucket }}"
  when: do_etcd_restore_from_s3 | default(false)

- name: Start RKE2 service on the first server
  ansible.builtin.service:
    name: rke2-server.service
    state: started
    enabled: true
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  ansible.builtin.systemd:
    name: rke2-agent.service
    enabled: no
    masked: yes

- name: Wait for the first server to be ready - no CNI
  ansible.builtin.command: kubectl get nodes
  register: kubectl_output
  until: "'NotReady' not in kubectl_output.stdout"
  retries: 30
  delay: 10
  when: not rke2_cni_enabled

- name: Wait for the first server to be ready - with CNI
  ansible.builtin.command: kubectl get nodes
  register: kubectl_output
  until: "'Ready' in kubectl_output.stdout"
  retries: 30
  delay: 10
  when: rke2_cni_enabled

- name: Restore etcd
  block:
    - name: Get registered nodes
      ansible.builtin.command: >
        kubectl get nodes -o=jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'
      register: registered_nodes

    - name: Get node names
      ansible.builtin.command: >
        kubectl get nodes -o=jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'
      register: node_names

    - name: Remove old secrets
      ansible.builtin.command: kubectl delete secret --ignore-not-found
      args:
        stdin: "{{ registered_nodes.stdout_lines | join('\n') }}"

    - name: Remove old nodes
      ansible.builtin.command: kubectl delete node --ignore-not-found
      args:
        stdin: "{{ node_names.stdout_lines | join('\n') }}"

- name: Set an Active Server variable
  ansible.builtin.set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ groups[rke2_cluster_group_name] | first }}"


