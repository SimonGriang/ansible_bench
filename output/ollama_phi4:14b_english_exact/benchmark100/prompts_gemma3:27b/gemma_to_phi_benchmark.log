---
- name: Check if all variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for host to be reachable
  wait_for:
    port: 22
    host: "{{ ansible_ssh_host | default(ansible_host | default(inventory_hostname)) }}"
    timeout: "{{ bootstrap_timeout }}"
  when: 
    - ansible_connection != 'container' 
    - ansible_connection != 'docker' 
    - bootstrap_wait_for_host
  delegate_to: localhost
  become: "{{ ansible_become }}"

- name: Prepare the system
  block:
    - name: Test connection
      wait_for_connection:
      register: bootstrap_connect

    - name: Debug bootstrap timeout
      debug:
        var: bootstrap_timeout
      when: bootstrap_connect is failed

    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml

- name: Install bootstrap packages
  raw: |
    # Command to install packages
  register: bootstrap_install_packages
  changed_when: 
    - "'expected_stdout_regex' in ansible_facts['distribution'] and 'Alpine' in ansible_facts['distribution'] or 'Archlinux' in ansible_facts['distribution'] or 'Gentoo' in ansible_facts['distribution']"
    - "'expected_stdout_regex' not in ansible_facts['distribution'] and 'Debian' in ansible_facts['distribution'] or 'RedHat' in ansible_facts['distribution'] or 'Rocky' in ansible_facts['distribution'] or 'Suse' in ansible_facts['distribution']"
  become: "{{ ansible_become }}"
  become_user: "{{ bootstrap_user }}"
  delegate_to: localhost

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap__facts_packages }}"
        state: present
      update_cache: yes


