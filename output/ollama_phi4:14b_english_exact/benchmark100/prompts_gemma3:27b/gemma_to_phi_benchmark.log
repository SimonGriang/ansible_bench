---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/mailname
    value: 'No configuration'
    vtype: string
  when: ansible_os_family == 'Debian'

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps_use_mysql | bool or
        postfix_virtual_alias_maps_use_mysql | bool

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
    mode: '0644'
  notify:
    - Validate postfix configuration
    - Rebuild postfix transport database
  when: transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
    - Validate postfix configuration
    - Reload postfix
  when: header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_values: "{{ postfix_main_cf_values | default({}) | combine(item) }}"
  loop: "{{ postfix_main_cf_facts | default([]) }}"
  when: postfix_main_cf_facts is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf_values: "{{ postfix_main_cf_values | combine(item) }}"
  loop: "{{ postfix_main_cf_values_facts | default([]) }}"
  when: postfix_main_cf_values_facts is defined

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - Validate postfix configuration
    - Restart postfix
  when: main_cf_template is defined

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - Validate postfix configuration
    - Restart postfix
  when: master_cf_template is defined

- name: Creates cert/key directory
  file:
    path: "{{ postfix_tls_cert_key_dir }}"
    state: directory
    mode: '0755'
  when: postfix_tls_cert_key_dir is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_server_cert_src }}"
    dest: "{{ postfix_tls_cert_key_dir }}/server-cert.pem"
    mode: '0644'
  when: postfix_tls_server_cert_src is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_server_key_src }}"
    dest: "{{ postfix_tls_cert_key_dir }}/server-key.pem"
    mode: '0600'
  when: postfix_tls_server_key_src is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
    mode: '0644'
  notify:
    - Newaliases
  when: postfix_aliases is defined

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: '0644'
  notify:
    - Reload postfix
  when: postfix_sender_access is defined

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: '0644'
  notify:
    - Reload postfix
  when: postfix_recipient_access is defined

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: /etc/postfix/sasl/sasl_password_map
    mode: '0600'
  when: postfix_sasl_password_map is defined

