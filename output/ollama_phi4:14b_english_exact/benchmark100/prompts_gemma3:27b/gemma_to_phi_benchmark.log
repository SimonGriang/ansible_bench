---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/mailname
    value: 'No configuration'
    vtype: string
  when: ansible_os_family == 'Debian'

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps_use_mysql | bool or postfix_virtual_alias_maps_use_mysql | bool

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
    mode: '0644'
  notify:
    - Validate postfix configuration
    - Rebuild postfix transport database
  when: transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
