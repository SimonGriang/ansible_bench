    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/default/home/dir') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('default_package') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Remove deprecated repositories (Debian)
  apt_repository:
    repo: "{{ item }}"
    state: absent
  loop: "{{ java_deprecated_repositories_adoptopenjdk }}"
  when: ansible_os_family == "Debian"

- name: Install extra apt tools (Debian)
  apt:
    name: "{{ java_open_jdk_apt_extra_packages }}"
    state: present
  when: ansible_os_family == "Debian"

- name: Add required key repositories (Debian)
  apt_key:
    url: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk }}"
  when: ansible_os_family == "Debian"

- name: Add required repositories (Debian)
  apt_repository:
    repo: "{{ item }}"
    state: present
  loop: "{{ java_required_repositories_openjdk }}"
  when: ansible_os_family == "Debian"

- name: Add required key repositories (RedHat)
  rpm_key:
    key: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk }}"
  when: ansible_os_family == "RedHat"

- name: Add required repositories (RedHat)
  yum_repository:
    name: "{{ item.name }}"
    description: "{{ item.description }}"
    baseurl: "{{ item.baseurl }}"
    gpgcheck: "{{ item.gpgcheck }}"
    state: present
  loop: "{{ java_required_repositories_openjdk }}"
  when: ansible_os_family == "RedHat"

- name: Install required libs
  package:
    name: "{{ java_required_libs_openjdk }}"
    state: present

- name: Install Java (Debian)
  apt:
    name: "{{ java_open_jdk_package }}={{ java_open_jdk_version }}"
    state: present
  when: ansible_os_family == "Debian"

- name: Install Java (RedHat)
  yum:
    name: "{{ java_open_jdk_package }}-{{ java_open_jdk_version }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0644'

- name: Source environment variables
  shell: source /etc/profile

- name: Correct java version selected (Debian, Java < 11)
  alternatives:
    name: java
    path: "{{ java_open_jdk_home }}/bin/java"
    priority: 1000
  when: ansible_os_family == "Debian" and java_open_jdk_version is version('11', '<')

- name: Correct java version selected (Debian, Java >= 11)
  alternatives:
    name: java
    path: "{{ java_open_jdk_home }}/bin/java"
    priority: 1100
  when: ansible_os_family == "Debian" and java_open_jdk_version is version('11', '>=')


