    _postfix_mynetworks: "{{ '127.0.0.0/8 [::1]/128' if postfix_mynetworks is not defined else (postfix_mynetworks if isinstance(postfix_mynetworks, str) else ','.join(postfix_mynetworks)) }}"
    _postfix_mydestination: "{{ 'localhost' if postfix_mydestination is not defined else (postfix_mydestination if isinstance(postfix_mydestination, str) else ','.join(postfix_mydestination)) }}"
    _postfix_relay_domains: "{{ 'none' if postfix_relay_domains is not defined else (postfix_relay_domains if isinstance(postfix_relay_domains, str) else ','.join(postfix_relay_domains)) }}"
    _postfix_smtpd_recipient_restrictions: "{{ 'permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination' if postfix_smtpd_recipient_restrictions is not defined else (postfix_smtpd_recipient_restrictions if isinstance(postfix_smtpd_recipient_restrictions, str) else ','.join(postfix_smtpd_recipient_restrictions)) }}"
    _postfix_smtpd_sender_restrictions: "{{ 'permit_sasl_authenticated, permit_mynetworks, reject_unauth_destination' if postfix_smtpd_sender_restrictions is not defined else (postfix_smtpd_sender_restrictions if isinstance(postfix_smtpd_sender_restrictions, str) else ','.join(postfix_smtpd_sender_restrictions)) }}"
    _postfix_virtual_mailbox_domains: "{{ 'none' if postfix_virtual_mailbox_domains is not defined else (postfix_virtual_mailbox_domains if isinstance(postfix_virtual_mailbox_domains, str) else ','.join(postfix_virtual_mailbox_domains)) }}"
    _postfix_virtual_alias_domains: "{{ 'none' if postfix_virtual_alias_domains is not defined else (postfix_virtual_alias_domains if isinstance(postfix_virtual_alias_domains, str) else ','.join(postfix_virtual_alias_domains)) }}"

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - Validate configuration
    - Restart postfix
  validate: postconf -d -c %s

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: '0644'
  notify:
    - Validate configuration
    - Restart postfix
  validate: postconf -d -c %s

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0700'
  with_items:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"
  when: 
    - postfix_smtpd_tls_cert_file is defined
    - postfix_smtpd_tls_cert_file_source is defined
    - postfix_smtpd_tls_key_file is defined
    - postfix_smtpd_tls_key_file_source is defined

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0600'
  notify: 
    - Reload postfix
  when: postfix_smtpd_tls_cert_file_source is defined

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0600'
  notify: 
    - Reload postfix
  when: postfix_smtpd_tls_key_file_source is defined

- name: Flush handlers
  ansible.builtin.meta: 
    flush_handlers: 

- name: Configure aliases
  ansible.builtin.lineinfile:
    path: "{{ postfix_alias_path }}"
    line: "{{ item.name }}: {{ item.destination }}"
    create: yes
    mode: '0644'
  with_items: "{{ postfix_aliases }}"
  notify:
    - Rebuild alias database
    - Reload postfix

- name: Configure sender_access
  ansible.builtin.lineinfile:
    path: "{{ postfix_sender_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    create: yes
    mode: '0644'
  with_items: "{{ postfix_sender_access }}"
  notify:
    - Rebuild sender_access database
    - Reload postfix

- name: Configure recipient_access
  ansible.builtin.lineinfile:
    path: "{{ postfix_recipient_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    create: yes
    mode: '0644'
  with_items: "{{ postfix_recipient_access }}"
  notify:
    - Validate configuration
    - Rebuild recipient_access database
