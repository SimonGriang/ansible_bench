---
- name: check if all variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: wait for host (when configured)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  become: "{{ bootstrap_become | default(false) }}"
  when: not (bootstrap_container | default(false) or bootstrap_docker | default(false)) and bootstrap_wait_for_host | default(false)

- name: prepare system
  block:
    - name: test connection to host
      wait_for_connection:
        timeout: "{{ bootstrap_connection_timeout }}"
      register: connection_test_result
      changed_when: false
  rescue:
    - name: debug connection failure
      debug:
        msg: "Connection test failed with timeout: {{ bootstrap_connection_timeout }}"
      changed_when: true
  always:
    - name: gather raw bootstrap facts
      include_tasks: gather_facts.yml

    - name: execute raw shell commands
      shell: "{{ item }}"
      args:
        executable: /bin/sh
      register: raw_command_output
      changed_when: >-
        (raw_command_output.stdout is regex_search('pattern') and ansible_os_family == 'RedHat') or
        (raw_command_output.stdout is regex_search('pattern') and ansible_os_family == 'Debian')
      with_items: "{{ bootstrap_install.raw }}"
      become: "{{ bootstrap_become | default(false) }}"
      become_user: "{{ bootstrap_user | default(omit) }}"

- name: ensure system is prepared by issuing ansible modules
  become: "{{ bootstrap_become | default(false) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"
  block:
    - name: gather ansible facts
      setup:

    - name: install bootstrap packages
      package:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ bootstrap_facts_packages }}"


