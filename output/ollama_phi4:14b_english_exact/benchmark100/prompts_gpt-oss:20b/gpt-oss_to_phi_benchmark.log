---
- name: Lookup bootstrap facts
  ansible.builtin.raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  check_mode: false

- name: Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: >
      {{ (bootstrap_facts.stdout | join('\n') | regex_search('^.*VERSION_ID=\"(\\d{1,2})(\\.\\d{1,4})*?\".*$', '\\1') or 'NA') }}
  loop: "{{ bootstrap_os_family_map.values() | flatten }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout | regex_search('PRETTY_NAME=.*') is search(var | default(item))
  no_log: true

- name: Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  when: bootstrap_distribution in item.value
  no_log: true
  loop_label: "{{ item.key }}"


