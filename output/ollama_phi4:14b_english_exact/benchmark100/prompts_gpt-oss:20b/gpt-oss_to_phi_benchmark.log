---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure Debian systems
  ansible.builtin.debconf:
    name: postfix
    question: 'postfix/main_mailer_type'
    vtype: string
    value: 'No configuration'
  when: ansible_os_family == 'Debian'

- name: Install postfix
  ansible.builtin.package:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present
  when: 
    - 'postfix_virtual_mailbox_maps is defined and "mysql" in postfix_virtual_mailbox_maps'
    - 'postfix_virtual_mailbox_domains is defined and "mysql" in postfix_virtual_mailbox_domains'
    - 'postfix_virtual_alias_maps is defined and "mysql" in postfix_virtual_alias_maps'

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport
    mode: '0644'
  notify:
    - Validate configuration
    - Rebuild transport_maps database
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
    mode: '0644'
  notify:
    - Validate configuration
    - Reload postfix
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    _postfix_smtpd_recipient_restrictions_check_recipient_access: "{{ 'check_recipient_access' if postfix_recipient_access is defined else omit }}"
    _postfix_smtpd_sender_restrictions_check_sender_access: "{{ 'check_sender_access' if postfix_sender_access is defined else omit }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    _postfix_mynetworks: "{{ '127.0.0.0/8 [::1]/128' if postfix_mynetworks is not defined else (postfix_mynetworks if isinstance(postfix_mynetworks, string) else ','.join(postfix_mynetworks)) }}"
    _postfix_mydestination: "{{ 'localhost' if postfix_mydestination is not defined else (postfix_mydestination if isinstance(postfix_mydestination, string) else ','.join(postfix_mydestination)) }}"
    _postfix_relay_domains: "{{ 'none' if postfix_relay_domains is not defined else (postfix_relay_domains if isinstance(postfix_relay_domains, string) else ','.join(postfix_relay_domains)) }}"
    _postfix_smtpd_recipient_restrictions: "{{ 'permit_mynetworks, permit_sasl_authenticated, reject_unauth_destination' if postfix_smtpd_recipient_restrictions is not defined else (postfix_smtpd_recipient_restrictions if isinstance(postfix_smtpd_recipient_restrictions, string) else ','.join(postfix_smtpd_recipient_restrictions)) }}"
    _postfix_smtpd_sender_restrictions: "{{ 'permit_sasl_authenticated, permit_mynetworks, reject_unauth_destination' if postfix_smtpd_sender_restrictions is not defined else (postfix_smtpd_sender_restrictions if isinstance(postfix_smtpd_sender_restrictions, string) else ','.join(postfix_smtpd_sender_restrictions)) }}"
    _postfix_virtual_mailbox_domains: "{{ 'none' if postfix_virtual_mailbox_domains is not defined else (postfix_virtual_mailbox_domains if isinstance(postfix_virtual_mailbox_domains, string) else ','.join(postfix_virtual_mailbox_domains)) }}"
    _postfix_virtual_alias_domains: "{{ 'none' if postfix_virtual_alias_domains is not defined else (postfix_virtual_alias_domains if isinstance(postfix_virtual_alias_domains, string) else ','.join(postfix_virtual_alias_domains)) }}"

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: '0644'
  notify:
    - Validate configuration
    - Restart postfix
  validate: postconf -d -c %s

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
