---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: enabled
  when: ansible_facts['os_family'] == "RedHat" and ansible_facts['distribution_major_version'] | int == 8

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: redis.conf-{{ ansible_distribution }}.j2
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes


