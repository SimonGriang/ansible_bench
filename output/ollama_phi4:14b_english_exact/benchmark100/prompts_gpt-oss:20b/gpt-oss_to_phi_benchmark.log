---
- name: Create the RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  copy:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0600'
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0600'
  when: rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0600'
  when: (rke2_custom_registry_mirrors | length > 0 or
         rke2_custom_registry_configs | length > 0)
  notify: Config file changed

- name: Register if we need to do an etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: (
         rke2_etcd_snapshot_file | length > 0 and
         (not rke2_server_service or rke2_server_service.state == 'disabled')
       )

- name: Register if we need to do an etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: 
    - rke2_etcd_snapshot_file | length > 0
    - rke2_etcd_snapshot_s3_options is defined
    - rke2_etcd_snapshot_s3_options.keys() == ['access_key', 'secret_key', 'bucket', 'snapshot_name']

- name: Restore etcd from file
  block:
    - name: Create the snapshot directory
      file:
        path: "{{ rke2_etcd_snapshot_destination_dir }}"
        state: directory

    - name: Copy the snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_source_dir }}"
        dest: "{{ rke2_etcd_snapshot_destination_dir }}"

    - name: Run rke2 server with cluster reset
      command: >
        rke2 server --cluster-reset
        --cluster-reset-restore-path={{ rke2_etcd_snapshot_destination_dir }}
        --token={{ rke2_token }}
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  command: >
    rke2 server --cluster-reset --etcd-s3
    --s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }}
    --s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }}
    --s3-bucket={{ rke2_etcd_snapshot_s3_options.bucket }}
    --s3-snapshot-name={{ rke2_etcd_snapshot_s3_options.snapshot_name }}
    --token={{ rke2_token }}
    {{ '--s3-endpoint=' + rke2_etcd_snapshot_s3_options.endpoint
      if rke2_etcd_snapshot_s3_options.endpoint is defined else '' }}
    {{ '--s3-region=' + rke2_etcd_snapshot_s3_options.region
      if rke2_etcd_snapshot_s3_options.region is defined else '' }}
    {{ '--s3-endpoint-ca=' + rke2_etcd_snapshot_s3_options.endpoint_ca
      if rke2_etcd_snapshot_s3_options.endpoint_ca is defined else '' }}
    {{ '--s3-folder=' + rke2_etcd_snapshot_s3_options.folder
      if rke2_etcd_snapshot_s3_options.folder is defined else '' }}
    {{ '--s3-skip-ssl-verify'
      if rke2_etcd_snapshot_s3_options.skip_ssl_verify is defined
      and rke2_etcd_snapshot_s3_options.skip_ssl_verify else '' }}
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    enabled: yes
    state: started
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    enabled: no
    masked: yes

- name: Wait for the first server be ready - no CNI
  command: kubectl get node "{{ rke2_node_name }}"
  register: k8s_node_status
  until: k8s_node_status.stdout is search(
           "MemoryPressure:No|DiskPressure:No|PIDPressure:No|(Conditions:.*Status:.*NotReady|pluginName: cni\\.|pluginStatus:.*ready)"
         )
  retries: 100
  delay: 15
  when: not ansible_check_mode and rke2_cni == 'none'

- name: Wait for the first server be ready - with CNI
  command: kubectl get nodes | grep "{{ rke2_node_name }}"
  register: k8s_node_status
  until: k8s_node_status.stdout is search(" Ready ")
  retries: 40
  delay: 15
  when: not ansible_check_mode and rke2_cni != 'none'

- name: Restore etcd
  block:
    - name: Retrieve the names of registered nodes
      command: kubectl get nodes --no-headers
      register: registered_nodes

    - name: Gather all node names from the inventory
      set_fact:
        inventory_node_names: "{{ hostvars.keys() | list }}"

    - name: Delete old node-password secrets for nodes that are no longer present
      command: kubectl delete secret node-password-{{ item }}
      loop: "{{ (inventory_node_names | difference(registered_nodes.stdout_lines)) | list }}"
