      ansible.builtin.file:
        path: >-
          {{ rke2_install_script_dir }}/rke2.sh
        mode: '0700'
      when: install_script.stat is defined and install_script.stat.mode | regex_search('u+w') and not install_script.stat.mode | regex_search('x')

