- name: Install epel
  block:
    - name: Install epel gpg key
      ansible.builtin.rpm_key:
        key: "{{ epel_gpg_key }}"
        state: present

    - name: Install epel-release
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      notify: Update package cache

