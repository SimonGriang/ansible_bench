- name: Setup openvpn server or client
  ansible.builtin.include_tasks: "{{ openvpn_role }}.yml"

- name: Start and enable openvpn
  ansible.builtin.service:
    name: "{{ openvpn_service }}"
    state: started
    enabled: true


