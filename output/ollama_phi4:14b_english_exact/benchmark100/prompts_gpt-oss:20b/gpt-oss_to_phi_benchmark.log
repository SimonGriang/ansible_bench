---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install logrotate
  ansible.builtin.package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  ansible.builtin.template:
    src: "{{ logrotate_config_file }}.j2"
    dest: "{{ logrotate_config_directory }}/{{ logrotate_config_file }}"
    mode: '0644'

- name: Generate logrotate.d files
  ansible.builtin.template:
    src: entry.j2
    dest: "{{ logrotate_confd_directory }}/{{ item.name }}"
    mode: '0644'
  loop: "{{ logrotate_entries | selectattr('name', 'defined') | selectattr('state', 'undefined') | selectattr('state', 'ne', 'absent') }}"
  loop_control:
    label: "{{ item.name }}"

- name: Remove logrotate.d files
  ansible.builtin.file:
    path: "{{ logrotate_confd_directory }}/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries | selectattr('name', 'defined') | selectattr('state', 'defined') | selectattr('state', 'eq', 'absent') }}"
  loop_control:
    label: "{{ item.name }}"

- name: Start logrotate
  ansible.builtin.service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service | length > 0


