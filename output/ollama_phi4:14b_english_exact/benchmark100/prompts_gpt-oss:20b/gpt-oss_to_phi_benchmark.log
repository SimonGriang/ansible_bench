- name: Create SSL CSR
  community.crypto.openssl_csr:
    path: "{{ openssl_csr_directory }}/{{ item.name }}.csr"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    common_name: "{{ item.common_name }}"
    mode: '0644'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ ssl_items }}"

- name: Create SSL Certificates
  community.crypto.x509_certificate:
    path: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    csr_path: "{{ openssl_csr_directory }}/{{ item.name }}.csr"
    provider:
      name: selfsigned
    mode: '0644'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ ssl_items }}"

- name: Create PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: "{{ openssl_key_directory }}/{{ item.name }}.p12"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    certificate_path: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    friendly_name: "{{ item.name }}"
    state: present
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ ssl_items }}"

- name: Read Private Key
  ansible.builtin.slurp:
    src: "{{ openssl_key_directory }}/{{ item.name }}.key"
  register: openssl_private_key
  loop: "{{ ssl_items }}"

- name: Read Certificate
  ansible.builtin.slurp:
    src: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
  register: openssl_certificate
  loop: "{{ ssl_items }}"

- name: Create Combined Private Key and Certificate File
  ansible.builtin.copy:
    dest: "{{ openssl_key_directory }}/{{ item.item.name }}.keycrt"
    content: "{{ (openssl_private_key.results[item.index].content | b64decode).strip() }}\n{{ (openssl_certificate.results[item.index].content | b64decode).strip() }}"
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ ssl_items | subelements('name') }}"


