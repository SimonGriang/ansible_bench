---
- name: Check current docker-compose version
  command: "{{ docker_compose_path }} --version"
  register: docker_compose_version_output
  changed_when: false
  failed_when: false
  ignore_errors: true
  no_log: true

- name: Store the docker-compose version in variable
  set_fact:
    docker_compose_vsn: "{{ docker_compose_version_output.stdout.split()[2] }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: "{{ docker_compose_path }}"
    state: absent
  when: 
    - docker_compose_version_output.stdout and
      docker_compose_vsn | replace('v', '') != docker_compose_version | replace('v', '')

- name: Install Docker Compose (if configured)
  get_url:
    url: "{{ docker_compose_url }}"
    dest: "{{ docker_compose_path }}"
    mode: '0755'
  when:
    - not docker_compose_version_output.stdout or 
      not docker_compose_vsn or 
      (docker_compose_vsn | replace('v', '') < docker_compose_version | replace('v', ''))


