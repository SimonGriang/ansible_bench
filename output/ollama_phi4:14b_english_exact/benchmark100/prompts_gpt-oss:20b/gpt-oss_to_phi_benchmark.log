---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'docker'
    - bootstrap_wait_for_host | bool

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
    - name: Check sudo availability
      ansible.builtin.command:
        cmd: sudo --version
  rescue:
    - name: Gather bootstrap facts
      include_tasks: gather_facts.yml
    - name: Install bootstrap packages
      ansible.builtin.raw:
        cmd: "{{ bootstrap_install.raw }}"
        executable: /bin/sh
      register: bootstrap_install_output
    - name: Ensure bootstrap installation success
      assert:
        that:
          - >
            ansible_facts['os_family'] in ['Alpine', 'Archlinux', 'Gentoo']
            and bootstrap_install_output.stdout is search(bootstrap_install.stdout_regex)
          - >
            ansible_facts['os_family'] not in ['Alpine', 'Archlinux', 'Gentoo']
            and not bootstrap_install_output.stdout is search(bootstrap_install.stdout_regex)
      vars:
        bootstrap_install_packages: "{{ bootstrap_install_output.stdout }}"

- name: Gather ansible facts
  ansible.builtin.setup:
    become: false

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages.split() }}"
    update_cache: yes
    state: present
  become: "{{ bootstrap_become }}"


