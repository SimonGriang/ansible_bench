        deb: "/tmp/{{ java_package }}"
      when: java_source == "local" and java_format == "deb"

- name: Install oracle java (rpm) (repository)
  package:
    name: "{{ java_oracle_package }}"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  block:
    - name: Ensure Java install directory exists
      file:
        path: "{{ java_install_directory }}"
        state: directory
        mode: '0755'
      when: java_format == "targz" and java_vendor == "oracle"

    - name: Unarchive Oracle Java tar.gz package
      unarchive:
        src: "{{ java_oracle_package }}"
        dest: "{{ java_install_directory }}"
        remote_src: yes
        mode: '0755'
      when: java_format == "targz" and java_vendor == "oracle"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "jce_policy-8.zip"
    dest: "{{ java_install_directory }}"
    remote_src: yes
    mode: '0755'
  when: java_jce and java_version == 8 and java_vendor == "oracle"

- name: Set alternative (targz)
  alternatives:
    name: java
    path: "{{ java_install_directory }}/{{ java_oracle_directory }}/bin/java"
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java | sed 's:/bin/java::'
  register: java_home
  changed_when: false
  check_mode: yes

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home.stdout }}"
    create: yes
    mode: '0644'


