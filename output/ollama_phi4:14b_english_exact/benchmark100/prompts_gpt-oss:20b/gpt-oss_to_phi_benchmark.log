        loop_var: item
      when: item not in ['sha256sum-{{ rke2_architecture }}.txt']

    - name: Download RKE2 installation script
      ansible.builtin.get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: '0700'
  rescue:
    - name: Pause for 7 seconds
      ansible.builtin.pause:
        seconds: 7

    - name: Create local directory for artifacts
      ansible.builtin.file:
        path: "{{ rke2_airgap_copy_sourcepath }}"
