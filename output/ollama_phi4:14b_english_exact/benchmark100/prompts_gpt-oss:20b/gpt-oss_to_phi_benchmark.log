    - name: Copy additional tarball images
      ansible.builtin.copy:
        src: >-
          {{ rke2_airgap_copy_sourcepath }}/{{ item }}
        dest: >-
          {{ rke2_tarball_images_path }}/{{ item }}
        mode: '0644'
        force: true
  when: >-
    rke2_airgap_mode and rke2_airgap_implementation != 'exists'
