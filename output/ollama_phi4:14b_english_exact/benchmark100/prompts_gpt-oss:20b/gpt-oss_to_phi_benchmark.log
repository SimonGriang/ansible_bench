---
- name: Java | Check if certificates exist
  ansible.builtin.stat:
    path: "{{ item.java_cert_path }}"
  with_items: "{{ java_certs }}"
  register: check_java_certs

- name: Java | Fail if some cert doesn't exist
  ansible.builtin.fail:
    msg: "Certificate path does not exist: {{ item.item.java_cert_path }}"
  when: not item.stat.exists
  with_items: "{{ check_java_certs.results }}"

- name: Java | Setting keystore variables in java < 11
  ansible.builtin.set_fact:
    java_keystore_dir: >-
      {{ java_keystore_dir
      if java_keystore_dir is defined and java_keystore_dir is not none
      else java_keystore_dir_old }}
  when: java_open_jdk_version_major < 11

- name: Java | Setting keystore variables in java >= 11
  ansible.builtin.set_fact:
    java_keystore_dir: >-
      {{ java_keystore_dir
      if java_keystore_dir is defined and java_keystore_dir is not none
      else java_keystore_dir_new }}
  when: java_open_jdk_version_major >= 11

- name: Java | Import SSL certificates
  community.general.java_cert:
    path: "{{ item.java_cert_path }}"
    keystore_path: >-
      {{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts
    password: "{{ java_cert_keystore_pass }}"
    state: present
    alias: "{{ item.java_cert_alias }}"
    keystore_create: true
  with_items: "{{ java_certs }}"


