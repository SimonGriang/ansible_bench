---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: '0644'
  loop: "{{ mysql_configuration_options }}"
  loop_control:
    label: "{{ item.option }}"
  notify:
    - Restart mysql server

- name: Configure mysql client
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    mode: '0644'

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: not ansible_distribution in ['Alpine', 'Archlinux'] and not ansible_facts['files'] | map('basename') | select('match', '^/var/lib/mysql/mysql$') | list
  when: ansible_facts['distribution'] in ['Alpine', 'Archlinux'] and not ansible_facts['files'] | map('basename') | select('match', '^/var/lib/mysql/mysql$') | list

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: '0640'

- name: Create databases
  community.mysql.mysql_db:
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    target: "{{ item.target }}"
    encoding: "{{ item.encoding }}"
    collation: "{{ item.collation }}"
  loop: "{{ mysql_databases }}"
  no_log: true
  when: mysql_databases is defined

- name: Create users
  community.mysql.mysql_user:
    login_unix_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
    name: "{{ item.name }}"
    state: present
    password: "{{ item.password | default(omit) }}"
    priv: "{{ item.privileges | default(omit) }}"
    host: "{{ item.host | default(omit) }}"
    host_all: "{{ item.host_all | default(omit) }}"
    update_password: "{{ item.update_password | default('on_create') }}"
  loop: "{{ mysql_users }}"
  no_log: true
  when: mysql_users is defined

- name: Flush handlers again
  meta: flush_handlers


