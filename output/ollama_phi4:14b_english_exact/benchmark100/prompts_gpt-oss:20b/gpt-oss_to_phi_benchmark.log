---
- name: Import assert.yml
  include_tasks: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install using package
  package:
    name: "{{ hashicorp_products[item] | default('hashicorp-product') }}"
    state: present
  with_items: "{{ hashicorp_products | dict2items }}"

- name: Install repository for RedHat
  block:
    - name: Download HashiCorp repository file
      get_url:
        url: "https://apt.releases.hashicorp.com/gpg"
        dest: "/etc/pki/rpm-gpg/RPM-GPG-KEY-hashicorp"
      when: ansible_os_family in ['RedHat', 'Rocky']

    - name: Install repository file
      copy:
        src: hashicorp.repo
        dest: "/etc/yum.repos.d/hashicorp.repo"
      when: ansible_os_family in ['RedHat', 'Rocky']

- name: Configure debian
  block:
    - name: Configure APT repository
      apt_repository:
        repo: >
          deb [arch={{ ansible_architecture }}]
          https://apt.releases.hashicorp.com
          {{ ansible_distribution_release }} main
        filename: hashicorp
        update_cache: yes
      when: ansible_os_family == 'Debian'

- name: Install required package gpg
  package:
    name: gpg
    state: present
  when: ansible_os_family == 'Debian'

- name: Install apt key for Debian
  apt_key:
    url: "https://apt.releases.hashicorp.com/gpg"
    state: present
    validate_certs: false
  when: ansible_os_family == 'Debian'

- name: Install repository for Debian
  apt_repository:
    repo: >
      deb [arch={{ ansible_architecture }}]
      https://apt.releases.hashicorp.com
      {{ ansible_distribution_release }} main
    state: present
  when: ansible_os_family == 'Debian'

- name: Install hashicorp product using package
  package:
    name: "{{ hashicorp_products[item.key] }}"
    state: present
    version: "{{ item.value | default('latest') }}"
  with_dict: "{{ hashicorp_products }}"

- name: Install latest hashicorp product using package
  package:
    name: "{{ item }}"
    state: latest
  with_items: "{{ hashicorp_products.keys() }}"

- name: Install versioned hashicorp product using package
  package:
    name: "{{ hashicorp_products[item.key] }}"
    state: present
    version: "{{ item.value }}"
  with_dict: "{{ hashicorp_products }}"
  when: "'version' in item"

- name: Install manually
  unarchive:
    src: "{{ hashicorp_src }}/{{ item }}"
    dest: "{{ hashicorp_destination }}"
    remote_src: true
    owner: root
    group: root
    mode: '0755'
  with_items: "{{ hashicorp_products.keys() }}"

- name: Install hashicorp product manually
  unarchive:
    src: "{{ hashicorp_src }}/{{ item.key }}"
    dest: "{{ hashicorp_destination }}"
    remote_src: true
    owner: root
    group: root
    mode: '0755'
  with_dict: "{{ hashicorp_products }}"


