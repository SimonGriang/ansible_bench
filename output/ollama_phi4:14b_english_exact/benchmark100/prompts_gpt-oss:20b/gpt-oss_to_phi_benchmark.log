---
- name: Prepare summary
  block:
    - name: Execute kubectl command to get nodes
      shell: kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes --output=wide --show-labels
      args:
        chdir: "{{ rke2_data_path }}"
      register: nodes_summary
      retries: 5
      delay: 2
      until: nodes_summary.rc == 0
      changed_when: false
      environment:
        PATH: "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games"
      executable: /bin/bash

    - name: Output nodes summary
      debug:
        var: nodes_summary.stdout_lines
  when: inventory_hostname == groups['rke2_servers_group_name'][0]


