---
- name: Ensure old versions of Docker are not installed
  package:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Add Docker GPG key
  when: docker_add_repo | bool
  rpm_key:
    key: "{{ docker_yum_gpg_key }}"
    state: present

- name: Add Docker repository
  when: docker_add_repo | bool
  get_url:
    url: "{{ docker_yum_repo_url }}"
    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    owner: root
    group: root
    mode: '0644'

- name: Configure Docker Nightly repo
  when: docker_add_repo | bool
  lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^(\s*)?#?(\s*)?(\[docker-{{ docker_edition }}-nightly\])'
    line: '\1\2[\3]\n\1\2enabled={{ docker_yum_repo_enable_nightly }}'
    backrefs: yes
    create: yes
    state: present

- name: Configure Docker Test repo
  when: docker_add_repo | bool
  lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^(\s*)?#?(\s*)?(\[docker-{{ docker_edition }}-test\])'
    line: '\1\2[\3]\n\1\2enabled={{ docker_yum_repo_enable_test }}'
    backrefs: yes
    create: yes
    state: present

- name: Configure containerd on RHEL 8
  when: ansible_facts.distribution_major_version | int == 8
  block:
    - name: Remove the runc package
      package:
        name: runc
        state: absent

    - name: Install the container-selinux package
      package:
        name: container-selinux
        state: present

    - name: Install the containerd.io package
      package:
        name: containerd.io
        state: present


