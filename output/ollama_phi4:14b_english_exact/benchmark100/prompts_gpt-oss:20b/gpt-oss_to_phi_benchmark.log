---
- name: Import assertion tasks
  import_tasks: assert.yml
  run_once: true

- name: Install Python pip packages
  ansible.builtin.package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "index-url = {{ python_pip_proxy }}"
    insertafter: "^\\[global\\]$"
    create: yes
    mode: '0644'
  when: python_pip_proxy is defined

- name: Trust pip hosts
  ansible.builtin.lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    insertafter: "^\\[global\\]$"
    create: yes
    mode: '0644'
  when: python_pip_trusted_host is defined

- name: Update pip package
  ansible.builtin.pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable | default(omit) }}"
  when: 
    - python_pip_update
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'

- name: Install requested Python modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(omit) }}"
    executable: "{{ python_pip_executable | default(omit) }}"
  loop: "{{ python_pip_modules }}"
  when: 
    - ansible_distribution_release not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'


