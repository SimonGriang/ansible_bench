---
- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ users_ssh_key_directory }}"
    mode: '0750'
    state: directory
  delegate_to: localhost
  when: user.manage_ssh_key | default(false)

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment | default(omit) }}"
    home: "{{ user.home | default(omit) }}"
    password: "{{ user.password | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    system: "{{ user.system | default(omit) }}"
    append: "{{ user.append | default(omit) }}"
  register: users_manage_user

- name: Set sudo options for {{ user.name }}
  template:
    src: sudo.j2
    dest: "/etc/sudoers.d/{{ user.name | replace('.', 'dot') }}"
    mode: '0640'
  validate: '/usr/sbin/visudo --check --file %s'
  when: user.sudo_options is defined

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name | replace('.', 'dot') }}"
    state: absent
  when: user.sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  command: "{{ users_ssh_keygen_command }}"
  args:
    chdir: "{{ users_ssh_key_directory }}"
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}"
  delegate_to: localhost
  when: user.manage_ssh_key | default(false)

- name: Generate public ssh key for {{ user.name }}
  command: "{{ users_ssh_keygen_pubkey_command }}"
  args:
    chdir: "{{ users_ssh_key_directory }}"
    creates: "{{ users_ssh_key_directory }}/{{ user.name }}.pub"
  delegate_to: localhost
  when: user.manage_ssh_key | default(false)

- name: Convert ssh key to ppk for {{ user.name }}
  command: >
    ssh-keygen -e -f "{{ users_ssh_key_directory }}/{{ user.name }}" -m PKCS8
    > "{{ users_ssh_key_directory }}/{{ user.name }}.ppk"
  delegate_to: localhost
  when: user.manage_ssh_key | default(false)

- name: Get or set the home directory for {{ user.name }}
  command: getent passwd {{ user.name }}
  register: users_home_result
  ignore_errors: true
  changed_when: false
  failed_when: users_home_result.rc > 1

- name: Set users home directory
  set_fact:
    users_home_directory: "{{ users_home_result.stdout.split(':')[5] | default('/home') }}"

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ users_home_base_dir }}/{{ user.name }}/.ssh"
    state: directory
    mode: '0700'
  become_user: "{{ user.name }}"
  when: user.manage_ssh_key | default(false) or user.private_keys is defined

- name: Deploy authorized keys for {{ user.name }}
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ item }}"
  loop: "{{ user.authorized_keys }}"
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for {{ user.name }}
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}"
    dest: "{{ users_home_base_dir }}/{{ user.name }}/.ssh/id_rsa"
    mode: '0400'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: users_manage_user is defined and user.copy_private_key | default(false)

- name: Check users password valid time for {{ user.name }}
  command: awk -F: -v user="{{ user.name }}" '$1==user {print $5}' /etc/shadow
  register: users_pw_valid
  failed_when: users_pw_valid.rc > 1
  changed_when: false
  when: users_manage_user is defined and users_manage_user.changed

- name: Set users password valid time for {{ user.name }}
  command: chage -M {{ user.password_validity_days }} {{ user.name }}
  when: users_pw_valid.stdout | int != user.password_validity_days

- name: Place private key file for {{ user.name }}
  copy:
    content: "{{ item.value }}"
    dest: "{{ users_home_base_dir }}/{{ user.name }}/.ssh/{{ item.key }}"
    mode: '0400'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  loop: "{{ user.private_keys | dict2items }}"
  when: user.private_keys is defined


