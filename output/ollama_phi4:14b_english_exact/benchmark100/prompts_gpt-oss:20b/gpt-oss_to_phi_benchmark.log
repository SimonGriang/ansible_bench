---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install nginx
  ansible.builtin.package:
    name: nginx
    state: present

- name: Place nginx.conf
  ansible.builtin.template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: '0644'
  notify: Restart nginx
  register: nginx_conf_result
  failed_when: nginx_conf_result is failed or ansible_failed_conditions is defined or '"fail" in nginx -t -c /etc/nginx/nginx.conf'

