      loop: "{{ (inventory_node_names | difference(registered_nodes.stdout_lines)) | list }}"
      when: item not in registered_nodes.stdout_lines
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
