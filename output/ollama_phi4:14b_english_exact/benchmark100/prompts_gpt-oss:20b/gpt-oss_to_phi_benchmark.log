---
- name: Cordon and Drain the node {{ rke2_node_name }}
  shell: |
    set -o pipefail
    {{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml \
    cordon {{ rke2_node_name }} && \
    {{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml \
    drain {{ rke2_node_name }} {{ rke2_drain_additional_args }}
  args:
    executable: /bin/bash
  register: drain
  retries: 100
  delay: 15
  until: drain.stdout.find("drained") != -1
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  when: rke2_drain_node_during_upgrade

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: "Service (re)started"

- name: Wait for all nodes to be ready again
  shell: |
    {{ rke2_data_path }}/bin/kubectl get nodes --no-headers |
    grep " Ready" | wc -l
  args:
    executable: /bin/bash
  register: all_ready_nodes
  retries: 100
  delay: 15
  until: all_ready_nodes.stdout == "{{ groups[rke2_cluster_group_name] | length }}"
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"

- name: Uncordon the node {{ rke2_node_name }}
  shell: |
    set -o pipefail
    {{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml \
    uncordon {{ rke2_node_name }}
  args:
    executable: /bin/bash
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  shell: |
    {{ rke2_data_path }}/bin/kubectl get pods -A \
    --field-selector=status.phase!=Running,status.phase!=Succeeded \
    --ignore-not-found | wc -l
  args:
    executable: /bin/bash
  register: all_pods_ready
  retries: 100
  delay: 15
  until: all_pods_ready.stdout == "0"
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  shell: |
    {{ rke2_data_path }}/bin/kubectl wait --all --timeout=-1 {{ rke2_wait_for_all_pods_to_be_healthy_args }}
  args:
    executable: /bin/bash
  retries: 100
  delay: 15
  until: result is success
  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"
  when: rke2_wait_for_all_pods_to_be_healthy


