---
- name: Disable swap
  block:
    - name: Disable swap immediately
      ansible.builtin.command: swapoff -a
      when: ansible_swaptotal_mb > 0 and vault_hardening_disable_swap

    - name: Permanently remove swap entry
      ansible.posix.mount:
        name: swap
        state: absent
      when: ansible_swaptotal_mb > 0 and vault_hardening_disable_swap

- name: Disable core dumps
  block:
    - name: Set core dump limits to 0
      community.general.pam_limits:
        domain: '*'
        limit_type: "{{ item.limit_type }}"
        limit_item: core
        value: 0
      loop:
        - { limit_type: 'hard' }
        - { limit_type: 'soft' }
      loop_control:
        label: "{{ item.limit_type }}"
      when: vault_hardening_disable_core_dumps

- name: Disable Shell Command History
  ansible.builtin.copy:
    dest: /etc/profile.d/vault.sh
    content: export HISTIGNORE="&:vault*"
    mode: '0644'
    owner: root
    group: root
  when: vault_hardening_disable_shell_command_history

- name: Configure SELinux / AppArmor
  block:
    - name: Install selinux-policy package
      ansible.builtin.package:
        name: selinux-policy
        state: present
      when: vault_hardening_configure_selinux_apparmor and ansible_selinux.status == "enabled"

    - name: Set SELinux policy to targeted and enforcing
      ansible.posix.selinux:
        policy: targeted
        state: enforcing
      when: vault_hardening_configure_selinux_apparmor and ansible_selinux.status == "enabled"

  tasks:
    - name: Enforce AppArmor profile for vault
      ansible.builtin.command: aa-enforce /etc/apparmor.d/usr.bin.vault
      when: ansible_apparmor.status == "enabled"


