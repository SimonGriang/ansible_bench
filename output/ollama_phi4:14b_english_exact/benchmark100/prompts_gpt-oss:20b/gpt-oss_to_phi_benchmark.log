    path: /etc/nginx/conf.d
    state: directory
    mode: '0755'

- name: Place default.conf
  ansible.builtin.template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'
  notify: Restart nginx

- name: Start and enable nginx
  ansible.builtin.service:
    name: nginx
    state: started
    enabled: true

handlers:
  - name: Restart nginx
    ansible.builtin.service:
      name: nginx
      state: restarted


