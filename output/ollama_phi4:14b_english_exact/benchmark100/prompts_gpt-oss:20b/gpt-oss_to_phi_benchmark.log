on': 1049724549, 'eval_count': 942, 'eval_duration': 16294108259, 'model_name': 'phi4:14b'} id='run--9b736d0a-73b4-4fc8-9780-532a2c3662e7-0' usage_metadata={'input_tokens': 2431, 'output_tokens': 942, 'total_tokens': 3373}
