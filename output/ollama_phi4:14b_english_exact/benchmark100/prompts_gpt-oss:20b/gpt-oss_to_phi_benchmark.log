  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
    version: "{{ java_open_jdk_version }}"
    update_cache: yes
    cache_valid_time: 3600
  register: java_package_installed
  until: java_package_installed is succeeded
  retries: 5
  when: ansible_os_family == 'Debian'

