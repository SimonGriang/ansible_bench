      ansible.builtin.fail:
        msg: "The installation script at {{ rke2_install_script_dir }}/rke2.sh must be executable."
      when: install_script.stat is defined and not install_script.stat.mode | regex_search('x')
  when: rke2_airgap_mode and rke2_airgap_implementation == 'exists'

