content='```yaml\n---\n- name: Restart RKE2 service\n  ansible.builtin.service:\n    name: "{{ rke2_service_name }}"\n    state: restarted\n  notify: Service (re)started\n\n- name: Wait for all nodes to be ready again\n  ansible.builtin.shell: >\n    {{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes --no-headers | grep " Ready" | wc -l\n  register: all_ready_nodes\n  until: all_ready_nodes.stdout|int == groups[rke2_cluster_group_name]|length\n  retries: 100\n  delay: 15\n  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"\n  run_once: true\n  when: not ansible_check_mode\n\n- name: Wait for all pods to be ready again\n  ansible.builtin.shell: >\n    {{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods --all-namespaces --field-selector=status.phase!=Running,status.phase!=Succeeded -o jsonpath=\'{.items[?(@.status.phase!="Running" || @.status.phase!="Succeeded")].metadata.name}\' | wc -l\n  register: all_pods_ready\n  until: all_pods_ready.stdout == "0"\n  retries: 100\n  delay: 15\n  delegate_to: "{{ active_server | default(groups[rke2_servers_group_name][0]) }}"\n  run_once: true\n  when:\n    - not ansible_check_mode\n    - rke2_wait_for_all_pods_to_be_ready\n```\n\nThis playbook adheres to the specified requirements, ensuring the tasks are executed in the correct order with the specified module calls and conditions. It is structured to be included in an Ansible Role under the `tasks/` directory.' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-17T07:38:51.660961879Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7828832535, 'load_duration': 2440551608, 'prompt_eval_count': 632, 'prompt_eval_duration': 409748508, 'eval_count': 403, 'eval_duration': 4977030139, 'model_name': 'phi4:14b'} id='run--5fd78efa-9480-41f1-b889-5041486f7293-0' usage_metadata={'input_tokens': 632, 'output_tokens': 403, 'total_tokens': 1035}
