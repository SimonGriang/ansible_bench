  loop: "{{ rke2_airgap_copy_additional_tarballs }}"

- name: Airgap mode – ensure artifacts exist and have acceptable permissions
  block:
    - name: Stat each artifact
      ansible.builtin.stat:
        path: >-
          {{ rke2_artifact_path }}/{{ item }}
      loop: "{{ rke2_artifact }}"
      register: artifacts

    - name: Stat the installation script
      ansible.builtin.stat:
        path: >-
          {{ rke2_install_script_dir }}/rke2.sh
      register: install_script

    - name: Set fact artifacts_writeable
      ansible.builtin.set_fact:
        artifacts_writeable: >-
          {{ artifacts.results | selectattr('stat', 'defined')
          | selectattr('stat.mode', 'match', 'u+w') | list | length > 0 }}

    - name: Change artifact mode if writable
      ansible.builtin.file:
        path: >-
          {{ rke2_artifact_path }}/{{ item.item }}
        mode: '0640'
      loop: "{{ artifacts.results }}"
      when: item.stat is defined and item.stat.mode | regex_search('u+w')

    - name: Ensure installation script is executable
      ansible.builtin.file:
        path: >-
          {{ rke2_install_script_dir }}/rke2.sh
        mode: '0700'
      when: install_script.stat is defined and install_script.stat.mode | regex_search('u+w') and not install_script.stat.mode | regex_search('x')

    - name: Fail if installation script is not executable
      ansible.builtin.fail:
        msg: >-
          The installation script at {{ rke2_install_script_dir }}/rke2.sh
          must be executable.
      when: install_script.stat is defined and not install_script.stat.mode | regex_search('x')
  when: rke2_airgap_mode and rke2_airgap_implementation == 'exists'

- name: Populate service facts
  ansible.builtin.setup:
    filter: ansible_facts.services

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local
  register: usr_local

- name: Check if separate partition
  ansible.builtin.shell: grep '/usr/local ' /proc/mounts
  changed_when: false
  register: partition_result
  failed_when: partition_result.rc >= 2

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: >-
      {% if usr_local.stat.isdir and not usr_local.stat.pw_name == 'root' %}
        /usr/local/bin/rke2
      {% elif partition_result.stdout | length == 1 %}
        /usr/local/bin/rke2
      {% else %}
        /opt/rke2/bin/rke2
      {% endif %}

- name: Check RKE2 version
  ansible.builtin.shell: |
    if [ -f {{ rke2_bin_path }} ]; then
      installed_version=$({{ rke2_bin_path }} version --short)
    else
      installed_version="not installed"
    fi
    if systemctl is-active --quiet {{ rke2_service_name }}; then
      pid=$(systemctl show -p MainPID {{ rke2_service_name }})
      running_binary_path=$(readlink -f /proc/$pid/exe)
      if [ -f "$running_binary_path" ]; then
        running_version=$(echo "$running_binary_path" | rev | cut -d'/' -f1 | rev | sed -E 's/rke2-([0-9\.]+)\.([0-9]+)-.*/\1/')
      else
        running_version="not installed"
      fi
    else
      running_version="not installed"
    fi
    echo "{\"installed_version\": \"$installed_version\", \"running_version\": \"$running_version\"}"
  register: versions_check

- name: Set RKE2 versions
  ansible.builtin.set_fact:
    installed_version: >-
      {{ versions_check.stdout | from_json['installed_version'] }}
    running_version: >-
      {{ versions_check.stdout | from_json['running_version'] }}
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - rke2_version_clean >= running_version_clean or rke2_allow_downgrade
    success_msg: >-
      RKE2 version check passed. Desired version {{ rke2_version_clean }} is greater than or equal to running version {{ running_version_clean }}.
    fail_msg: >-
      RKE2 version downgrade is not allowed. Current running version: {{ running_version_clean }}, Desired version: {{ rke2_version_clean }}.

- name: Run RKE2 install script
  block:
    - name: Run RKE2 installation script in airgap mode
      ansible.builtin.shell: >-
        INSTALL_RKE2_ARTIFACT_PATH={{ rke2_artifact_path }}
        INSTALL_RKE2_AGENT_IMAGES_DIR={{ rke2_tarball_images_path }}
        INSTALL_RKE2_METHOD=airgap
        /usr/local/bin/rke2-{{ rke2_type }} install
      when: rke2_airgap_mode

    - name: Run RKE2 installation script in online mode
      ansible.builtin.shell: >-
        INSTALL_RKE2_VERSION={{ rke2_version }}
        INSTALL_RKE2_CHANNEL_URL={{ rke2_channel_url }}
        INSTALL_RKE2_CHANNEL={{ rke2_channel }}
        INSTALL_RKE2_METHOD=online
        /usr/local/bin/rke2-{{ rke2_type }} install
      when: not rke2_airgap_mode
  when: not ansible_check_mode and rke2_version != installed_version

- name: Copy Custom Manifests
  ansible.builtin.template:
    src: "{{ item }}"
    dest: >-
      {{ rke2_data_path }}/server/manifests/
    owner: root
    group: root
    mode: '0644'
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: >-
      {{ rke2_data_path }}/agent/pod-manifests/
    owner: root
    group: root
    mode: '0644'
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods is defined and rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  ansible.builtin.template:
    src: rke2_environment.j2
    dest: >-
      /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: '0644'
  when: rke2_environment_options is defined and rke2_environment_options | length > 0


