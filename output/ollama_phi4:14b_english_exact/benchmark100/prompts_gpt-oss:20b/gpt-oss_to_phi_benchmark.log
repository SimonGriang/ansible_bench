---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Manage selinux
  ansible.posix.selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when: ansible_selinux.status is defined and not ansible_container
  notify: Reboot

- name: Manage selinux booleans
  ansible.posix.seboolean:
    name: "{{ item.name }}"
    state: "{{ item.state | default('yes') }}"
    persistent: "{{ item.persistent | default(true) }}"
  loop: "{{ selinux_booleans }}"
  loop_control:
    label: "{{ item.name }}"
  when: selinux_booleans is defined


