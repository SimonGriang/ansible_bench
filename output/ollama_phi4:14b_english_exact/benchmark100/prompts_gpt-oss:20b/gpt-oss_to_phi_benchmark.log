- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml

- name: Wait for SSH port to become available
  ansible.builtin.wait_for:
    port: 22
    state: started
  when:
    - ansible_connection is defined
    - not ansible_container
    - bootstrap_wait_for_host | bool
  vars:
    bootstrap_timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"
      register: bootstrap_connect
      changed_when: false

    - name: Test sudo
      ansible.builtin.command:
        cmd: sudo --version
      changed_when: false

  rescue:
    - name: Gather bootstrap facts
      ansible.builtin.include_tasks:
        file: gather_facts.yml

    - name: Install bootstrap packages (raw)
      ansible.builtin.raw:
        cmd: "{{ bootstrap_install.raw }}"
        executable: /bin/sh
      register: bootstrap_install_packages
      changed_when: >
        (ansible_facts['os_family'] == 'RedHat' and
          'is in' in bootstrap_install_packages.stdout) or
        (ansible_facts['os_family'] == 'Debian' and
          'is already installed' not in bootstrap_install_packages.stdout)

    - name: Ensure libdnf5 is present on Fedora/RedHat
      ansible.builtin.raw:
        cmd: dnf install -y python3-libdnf5
        executable: /bin/sh
      when: ansible_facts['os_family'] == 'RedHat'

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: all
    become: false

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages.split() }}"
    state: present
    update_cache: true
  become: "{{ bootstrap_become }}"
```

