---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_TIMEOUT='
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: yes
    mode: '0664'
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_RECORDFAIL_TIMEOUT='
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: yes
    mode: '0664'
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX="([^"]+)"$'
    line: >-
      GRUB_CMDLINE_LINUX="{{ grub_cmdline_linux | regex_replace('(?<!' + option + '={{ value }})' + option + '={{ value }}', option + '={{ value }}', 'eg') }}"
    backrefs: yes
    validate: '/bin/sh -n %s'
    mode: '0664'
  notify: Update grub
  when: grub_options is defined and grub_options | length > 0
  loop: "{{ grub_options }}"
  loop_control:
    loop_var: option_value
  vars:
    option: "{{ option_value.split('=')[0] }}"
    value: "{{ option_value.split('=')[1] }}"
    grub_cmdline_linux: "{{ grub_cmdline_linux | default('') }}"

- name: Import password.yml
  include_tasks: password.yml
  when: grub_set_password | bool

- name: Flush handlers
  meta: flush_handlers


