---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/mailname
    value: "No configuration"
    vtype: string
  when: ansible_os_family == "Debian"

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps_mysql or postfix_virtual_alias_maps_mysql

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
  notify:
    - Validate postfix configuration
    - Rebuild postfix databases
  when: transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - Validate postfix configuration
    - Reload postfix
  when: header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_facts: "{{ lookup('vars', postfix_main_cf_facts | default([])) }}"
  when: postfix_main_cf_facts is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf_facts: >-
      {{ postfix_main_cf_facts
      | combine({'key': value})
      if value is defined else postfix_main_cf_facts }}
  loop: "{{ postfix_main_cf_additional_facts | default([]) }}"
  loop_control:
    loop_var: key_value
  when: postfix_main_cf_additional_facts is defined

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - Validate postfix configuration
    - Restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - Validate postfix configuration
    - Restart postfix

- name: Creates cert/key directory
  file:
    path: "{{ postfix_tls_cert_key_dir }}"
    state: directory
  when: postfix_tls_cert_key_dir is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_cert_src }}"
    dest: "{{ postfix_tls_cert_dest }}"
  when: postfix_tls_cert_src is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_src }}"
    dest: "{{ postfix_tls_key_dest }}"
  when: postfix_tls_key_src is defined

- name: Flush handlers
  meta:
    flush_handlers: true

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
  notify:
    - Newaliases
  when: postfix_aliases is defined

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
  notify:
    - Postfix reload
  when: postfix_sender_access is defined

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
  notify:
    - Postfix reload
  when: postfix_recipient_access is defined

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: /etc/postfix/sasl_password
  when: postfix_sasl_password_map is defined

- name: Flush handlers again
  meta:
    flush_handlers: true

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true


