---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install using package
  block:
    - name: Install Hashicorp products using package manager
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ hashicorp_products | default([]) }}"
      when: hashicorp_installation_method == "package"

- name: Install repository for RedHat
  block:
    - name: Download Hashicorp repository file for RedHat-based systems
      get_url:
        url: https://apt.releases.hashicorp.com/gpg
        dest: /etc/yum.repos.d/hashicorp.repo
        mode: '0640'
      when: ansible_os_family == "RedHat" or ansible_os_family == "Rocky"

- name: Configure debian
  block:
    - name: Install required package gpg
      package:
        name: gpg
        state: present
      when: ansible_os_family == "Debian"

    - name: Install apt key for Debian
      apt_key:
        url: https://apt.releases.hashicorp.com/gpg
        state: present
        validate_certs: no
      when: ansible_os_family == "Debian"

    - name: Install repository for Debian
      apt_repository:
        repo: "deb [arch={{ hashicorp_architecture_mapping[ansible_architecture] }}] https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
        state: present
      when: ansible_os_family == "Debian"

- name: Install hashicorp product using package
  block:
    - name: Install latest hashicorp product using package
      package:
        name: "{{ item }}"
        state: latest
      loop: "{{ hashicorp_products | default([]) }}"
      when: hashicorp_products is defined

    - name: Install versioned hashicorp product using package
      package:
        name: "{{ item.product }}{{ item.version | default('') | replace('', version_coupler) }}"
        state: present
      loop: "{{ hashicorp_products | default([]) }}"
      when: hashicorp_products is defined and item.version is defined

- name: Install manually
  block:
    - name: Install hashicorp product manually
      unarchive:
        src: "{{ hashicorp_src }}/{{ item }}.{{ hashicorp_architecture_mapping[ansible_architecture] }}"
        dest: "{{ hashicorp_destination }}"
        remote_src: yes
        group: "{{ hashicorp_group }}"
        mode: "{{ hashicorp_mode }}"
        owner: "{{ hashicorp_owner }}"
      loop: "{{ hashicorp_products | default([]) }}"
      when: hashicorp_installation_method == "manual"


