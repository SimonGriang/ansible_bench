name: java\n    path: "{{ java_open_jdk_home_dir }}/java-{{ java_open_jdk_version }}-bin"\n    link: /usr/bin/java\n    priority: 1000\n  when: ansible_os_family == "Debian" and java_open_jdk_version is version(\'11\', \'<\')\n\n- name: Set the \'java\' alternative to the correct path for Java versions 11 and greater on Debian systems\n  alternatives:\n    name: java\n    path: "{{ java_open_jdk_home_dir }}/jdk-{{ java_open_jdk_version }}-bin"\n    link: /usr/bin/java\n    priority: 1100\n  when: ansible_os_family == "Debian" and java_open_jdk_version is version(\'11\', \'>=\')\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-21T20:47:07.509152527Z', 'done': True, 'done_reason': 'stop', 'total_duration': 28070113528, 'load_duration': 62096631, 'prompt_eval_count': 2426, 'prompt_eval_duration': 769771805, 'eval_count': 1135, 'eval_duration': 27237201405, 'model_name': 'phi4:14b'} id='run--e14b65dc-e925-402b-8263-7c6a6025b7c1-0' usage_metadata={'input_tokens': 2426, 'output_tokens': 1135, 'total_tokens': 3561}
