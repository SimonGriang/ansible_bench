---
- name: Gather service facts
  ansible.builtin.setup:
    gather_subset: '!all,!min,!network,!packages'

- name: Set the active_server variable
  ansible.builtin.set_fact:
    active_server: "{{ inventory_hostname }}"
  when:
    - "'rke2_servers_group_name' in group_names"
    - "'rke2-server.service' in ansible_facts.services.keys()"
    - ansible_facts.services['rke2-server.service'].state == 'started'
  delegate_to: "{{ item }}"
  loop: "{{ groups['rke2_cluster_group_name'] }}"


