---
- name: Create ssh_key_directory for user
  file:
    path: "/home/{{ user.name }}/.ssh"
    state: directory
    mode: '0700'
  become: yes
  when: user.manage_ssh_key | default(false) | bool

- name: Manage user account
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment | default(omit) }}"
    create_home: "{{ user.create_home | default(true) }}"
    password: "{{ user.password | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    expires: "{{ user.expires | default(omit) }}"
  register: user_result

- name: Set sudo options for user
  template:
    src: "sudoers.d/{{ item.name }}.j2"
    dest: "/etc/sudoers.d/{{ item.name }}"
    validate: 'visudo -cf %s'
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.sudo_options is defined

- name: Remove sudo options for user
  file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: absent
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.sudo_options is not defined

- name: Generate private ssh key for user
  command: ssh-keygen -t rsa -b 2048 -f /home/{{ user.name }}/.ssh/id_rsa -N ''
  args:
    creates: "/home/{{ user.name }}/.ssh/id_rsa"
  become: yes
  become_user: "{{ user.name }}"
  when: user.manage_ssh_key | default(false) | bool

- name: Generate public ssh key for user
  command: ssh-keygen -y -f /home/{{ user.name }}/.ssh/id_rsa > /home/{{ user.name }}/.ssh/id_rsa.pub
  args:
    creates: "/home/{{ user.name }}/.ssh/id_rsa.pub"
  become: yes
  become_user: "{{ user.name }}"
  when: user.manage_ssh_key | default(false) | bool

- name: Convert ssh key to ppk for user
  command: ssh-keygen -P '' -f /home/{{ user.name }}/.ssh/id_rsa -e -m PKCS8 > /home/{{ user.name }}/.ssh/id_rsa.ppk
  args:
    creates: "/home/{{ user.name }}/.ssh/id_rsa.ppk"
  become: yes
  become_user: "{{ user.name }}"
  when: user.manage_ssh_key | default(false) | bool

- name: Get or set the home directory for user
  command: getent passwd {{ user.name }}
  register: passwd_entry
  failed_when: passwd_entry.rc > 1
  changed_when: false

- name: Set user home directory fact
  set_fact:
    user_home: "{{ (passwd_entry.stdout | default('/home')).split(':') | first }}"
  when: passwd_entry.stdout is defined

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'
  become: yes
  become_user: "{{ user.name }}"
  when: user.manage_ssh_key | default(false) | bool or user.private_keys | default([]) | length > 0

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ item }}"
  loop: "{{ user.authorized_keys | default([]) }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ user.unauthorized_keys | default([]) }}"

- name: Copy generated private ssh key for user
  copy:
    src: "/home/{{ user.name }}/.ssh/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
    mode: '0600'
  become: yes
  when: user.copy_private_key | default(false) | bool

- name: Check users password valid time
  shell: chage -l {{ user.name }} | grep 'Password expires' | awk '{print $4}'
  register: password_valid_time
  changed_when: false

- name: Set users password valid time
  user:
    name: "{{ user.name }}"
    password_expire_min: "{{ user.password_expire_min | default(30) }}"
    password_expire_max: "{{ user.password_expire_max | default(365) }}"
  when: user.password_expire_min is defined or user.password_expire_max is defined

- name: Place private key file for user
  copy:
    content: "{{ item.content }}"
    dest: "{{ user_home }}/.ssh/{{ item.filename }}"
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
    mode: '0600'
  loop: "{{ user.private_keys | default([]) }}"
  when: user.private_keys is defined


