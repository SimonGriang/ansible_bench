---
- name: Create the RKE2 config directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  ansible.builtin.template:
    src: rke2-config.yml.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify: restart rke2

- name: Copy kubelet config
  ansible.builtin.template:
    src: kubelet-config.yml.j2
    dest: /etc/rancher/rke2/config/kubelet.yaml
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  ansible.builtin.template:
    src: containerd-registry-config.yml.j2
    dest: /etc/rancher/rke2/config/registries.yaml
    mode: '0644'
  when: (rke2_custom_registry_mirrors | length > 0) or 
        (rke2_custom_registry_configs | length > 0)
  notify: restart rke2

- name: Start RKE2 service on the rest of the nodes
  ansible.builtin.systemd:
    name: rke2
    state: started
    enabled: true
  register: rke2_service_result
  retries: 5
  delay: 10
  until: rke2_service_result is succeeded
  notify: restart rke2

- name: Mask other RKE2 service on the rest of the nodes
  ansible.builtin.systemd:
    name: "{{ item }}"
    masked: true
    enabled: false
  loop:
    - rke2-agent
    - rke2-server
  when: rke2_type == 'agent' or rke2_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  ansible.builtin.command:
    cmd: kubectl wait --for=condition=Ready --timeout=300s node --all
  register: wait_no_cni_result
  retries: 30
  delay: 10
  until: wait_no_cni_result.rc == 0
  when: cni == 'none' and (inventory_hostname == groups['servers'][0] or rke2_active_server)

- name: Wait for remaining nodes to be ready - with CNI
  ansible.builtin.shell: |
    set -o pipefail
    kubectl get nodes --no-headers | grep 'Ready' | wc -l
  register: wait_with_cni_result
  retries: 30
  delay: 10
  until: wait_with_cni_result.stdout | int == groups['nodes'] | length
  when: cni != 'none' and (inventory_hostname == groups['servers'][0] or rke2_active_server)


