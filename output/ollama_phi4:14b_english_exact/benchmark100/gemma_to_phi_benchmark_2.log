---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  when:
    - inventory_hostname == 'localhost'

- name: Install required software
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  when:
    - users_requirements is defined
    - users_requirements | length > 0

- name: Loop over users_groups
  ansible.builtin.include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item }}"
  when:
    - users_groups is defined

- name: Ensure the /etc/sudoers.d directory is included
  ansible.builtin.lineinfile:
    path: /etc/sudoers
    line: "Include {{ users_sudo_includedir }}"
    validate: visudo -cf %s
  when:
    - users_sudo_includedir is defined

- name: Loop over users
  ansible.builtin.include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item }}"
  when:
    - users is defined

- name: Manage cron permission
  ansible.builtin.template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when:
    - users_cron_allow | bool

- name: Check existence of /etc/cron.allow
  ansible.builtin.file:
    path: /etc/cron.allow
    state: absent
  when:
    - not users_cron_allow | bool


