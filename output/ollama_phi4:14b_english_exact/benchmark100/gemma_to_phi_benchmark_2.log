son': 'stop', 'total_duration': 6572466989, 'load_duration': 54914002, 'prompt_eval_count': 783, 'prompt_eval_duration': 243069653, 'eval_count': 488, 'eval_duration': 6272063097, 'model_name': 'phi4:14b'} id='run--fc4c6192-7c72-4cf1-adca-c77604d05f22-0' usage_metadata={'input_tokens': 783, 'output_tokens': 488, 'total_tokens': 1271}
