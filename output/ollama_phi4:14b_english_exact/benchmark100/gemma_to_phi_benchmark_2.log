- name: See if the specified user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ git_username }}"
  register: user_exists
  failed_when: user_exists.failed and not fail_key | bool

- name: Create directory for git configuration
  ansible.builtin.file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0644'

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    version: "{{ item.version | default('main') }}"
    force: "{{ item.force | default(false) }}"
  loop: "{{ git_repositories }}"
  loop_control:
    label: "{{ git_repository_destination }}/{{ item.name }}"
  become: true
  become_user: "{{ git_username }}"


