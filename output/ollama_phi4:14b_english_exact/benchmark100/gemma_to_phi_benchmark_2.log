---
- name: Create SSL key, CSR, and certificate
  gather_facts: no
  vars:
    openssl_key_directory: "/path/to/openssl_key_directory"
    openssl_csr_directory: "/path/to/openssl_csr_directory"
    openssl_crt_directory: "/path/to/openssl_crt_directory"
    openssl_file_owner: "owner"
    openssl_file_group: "group"

  tasks:
    - name: create ssl key
      community.crypto.openssl_privatekey:
        path: "{{ openssl_key_directory }}/{{ item.common_name }}.key"
        type: RSA
        size: 2048
      become: true
      become_user: root
      mode: '0640'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"

    - name: create ssl csr
      community.crypto.openssl_csr:
        path: "{{ openssl_csr_directory }}/{{ item.common_name }}.csr"
        privatekey_path: "{{ openssl_key_directory }}/{{ item.common_name }}.key"
        common_name: "{{ item.common_name }}"
      become: true
      become_user: root
      mode: '0644'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"

    - name: create ssl certificates
      community.crypto.x509_certificate:
        path: "{{ openssl_crt_directory }}/{{ item.common_name }}.crt"
        privatekey_path: "{{ openssl_key_directory }}/{{ item.common_name }}.key"
        csr_path: "{{ openssl_csr_directory }}/{{ item.common_name }}.csr"
        provider: selfsigned
      become: true
      become_user: root
      mode: '0644'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"

    - name: create PKCS#12 file
      community.crypto.openssl_pkcs12:
        path: "{{ openssl_key_directory }}/{{ item.name }}.p12"
        privatekey_path: "{{ openssl_key_directory }}/{{ item.common_name }}.key"
        certificate_path: "{{ openssl_crt_directory }}/{{ item.common_name }}.crt"
        friendly_name: "{{ item.name }}"
      become: true
      become_user: root
      mode: '0640'
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"

    - name: read private key
      ansible.builtin.slurp:
        path: "{{ openssl_key_directory }}/{{ item.common_name }}.key"
      register: openssl_private_key

    - name: read certificate
      ansible.builtin.slurp:
        path: "{{ openssl_crt_directory }}/{{ item.common_name }}.crt"
      register: openssl_certifcate

    - name: create combined private_key and certificate file
      ansible.builtin.copy:
        dest: "{{ openssl_key_directory }}/{{ item.common_name }}.keycrt"
        content: |
          {{ openssl_private_key.content | b64decode | trim }}
          {{ openssl_certifcate.content | b64decode | trim }}
        mode: '0640'
        owner: "{{ openssl_file_owner }}"
        group: "{{ openssl_file_group }}"


