---
- name: Restart the RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
    daemon_reload: yes
  notify: Service (re)started

- name: Wait for all nodes to be ready
  shell: |
    {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes --no-headers | grep Ready | wc -l
  register: ready_nodes_count
  until: ready_nodes_count.stdout | int == groups['{{ rke2_cluster_group_name }}'] | length
  retries: 100
  delay: 15
  delegate_to: "{{ groups['{{ rke2_servers_group_name }}'] | first if groups['{{ rke2_servers_group_name }}'] | length > 0 else 'active_server' }}"
  run_once: yes

- name: Wait for all pods to be ready
  shell: |
    {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods --all-namespaces --field-selector=status.phase!=Running,status.phase!=Succeeded -o jsonpath='{.items[*].metadata.name}' | wc -l
  register: pending_pods_count
  until: pending_pods_count.stdout | int == 0
  retries: 100
  delay: 15
  delegate_to: "{{ groups['{{ rke2_servers_group_name }}'] | first if groups['{{ rke2_servers_group_name }}'] | length > 0 else 'active_server' }}"
  run_once: yes
  when: rke2_wait_for_all_pods_to_be_ready | bool and ansible_check_mode == false


