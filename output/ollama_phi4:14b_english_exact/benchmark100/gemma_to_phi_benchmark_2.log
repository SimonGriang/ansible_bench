    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0644'

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    version: "{{ item.version | default('main') }}"
    force: "{{ item.force | default(false) }}"
  loop: "{{ git_repositories }}"
  loop_control:
    label: "{{ git_repository_destination }}/{{ item.name }}"
  become: yes
  become_user: "{{ git_username }}"


