  register: pending_pods_count
  until: pending_pods_count.stdout | int == 0
  retries: 100
  delay: 15
  delegate_to: >-
    {{ groups['{{ rke2_servers_group_name }}'] | first if groups['{{ rke2_servers_group_name }}'] | length > 0 else 'active_server' }}
  run_once: yes
  when: rke2_wait_for_all_pods_to_be_ready | bool and not ansible_check_mode


