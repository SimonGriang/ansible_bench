---
- name: Set the `java_jdk_vendor` fact to "temurin" if it's currently set to "adoptopenjdk"
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Include variables based on the `java_jdk_vendor`, `ansible_distribution`, and `ansible_distribution_major_version`
  include_vars:
    file: "{{ item }}"
  with_first_found:
    - files:
        - "{{ java_jdk_vendor }}_{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.yml"
        - "{{ java_jdk_vendor }}_{{ ansible_distribution }}.yml"
        - "{{ java_jdk_vendor }}.yml"
      skip: true

- name: Include architecture-specific variables from a file named 'architecture.yml'
  include_vars:
    file: architecture.yml

- name: Set several facts related to the OpenJDK version, repositories, and libraries
  set_fact:
    java_open_jdk_version: "{{ java_open_jdk_version | default('default_version') }}"
    java_open_jdk_repository: "{{ java_open_jdk_repository | default('default_repository') }}"
    java_open_jdk_libs: "{{ java_open_jdk_libs | default('default_libs') }}"

- name: Set facts for `java_open_jdk_home_dir` and `java_open_jdk_package`
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-package') }}"

- name: Set the `java_home` fact to the value of `java_open_jdk_home`
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Remove deprecated AdoptOpenJDK repositories on Debian-based systems
  apt_repository:
    repo: "{{ item }}"
    state: absent
  loop: "{{ java_deprecated_repositories_adoptopenjdk }}"
  when: ansible_os_family == "Debian"

- name: Install extra apt tools on Debian systems
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_apt_extra_packages }}"
  when: ansible_os_family == "Debian"

- name: Add required apt key repositories on Debian systems
  apt_key:
    url: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk }}"
  when: ansible_os_family == "Debian"

- name: Add required apt repositories on Debian systems
  apt_repository:
    repo: "{{ item }}"
    state: present
  loop: "{{ java_required_repositories_openjdk }}"
  when: ansible_os_family == "Debian"

- name: Add required RPM key repositories on RedHat-based systems
  rpm_key:
    key: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk }}"
  when: ansible_os_family == "RedHat"

- name: Add required YUM repositories on RedHat-based systems
  yum_repository:
    name: "{{ item.name }}"
    description: "{{ item.description }}"
    baseurl: "{{ item.baseurl }}"
    gpgcheck: "{{ item.gpgcheck }}"
    enabled: "{{ item.enabled }}"
  loop: "{{ java_required_repositories_openjdk }}"
  when: ansible_os_family == "RedHat"

- name: Install required libraries using the package manager
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libs_openjdk }}"

- name: Install Java on Debian-based systems using the apt module
  apt:
    name: "{{ java_open_jdk_package }}={{ java_open_jdk_version }}"
    state: present
  when: ansible_os_family == "Debian"

- name: Install Java on RedHat-based systems using the yum module
  yum:
    name: "{{ java_open_jdk_package }}-{{ java_open_jdk_version }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Create a template file `/etc/profile.d/jdk.sh` to set Java environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: '0644'

- name: Source the `/etc/profile` file to apply the Java environment variables
  shell: source /etc/profile
  args:
    executable: /bin/bash

- name: Set the 'java' alternative to the correct path for Java versions less than 11 on Debian systems
  alternatives:
    name: java
    path: "{{ java_open_jdk_home_dir }}/java-{{ java_open_jdk_version }}-bin"
    link: /usr/bin/java
    priority: 1000
  when: ansible_os_family == "Debian" and java_open_jdk_version is version('11', '<')

- name: Set the 'java' alternative to the correct path for Java versions 11 and greater on Debian systems
  alternatives:
    name: java
    path: "{{ java_open_jdk_home_dir }}/jdk-{{ java_open_jdk_version }}-bin"
    link: /usr/bin/java
    priority: 1100
  when: ansible_os_family == "Debian" and java_open_jdk_version is version('11', '>=')


