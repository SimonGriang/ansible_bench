- name: Place default.conf
  template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'
  notify: Restart nginx

- name: Start and enable nginx
  service:
    name: nginx
    state: started
    enabled: true

handlers:
  - name: Restart nginx
    service:
      name: nginx
      state: restarted


