    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
  loop: "{{ rke2_additional_images_tarballs }}"
  when: airgap_mode

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  ansible.builtin.file:
    path: "{{ item }}"
    state: file
    owner: root
    group: root
    mode: "{{ item_mode if item_mode < 0777 else '0777' }}"
  loop: "{{ rke2_artifacts_list }}"

- name: Populate service facts

- name: Get stats of the FS object
  ansible.builtin.setup:
    filter: ansible_mounts
  register: mount_stats

- name: Check if separate partition
  ansible.builtin.set_fact:
    rke2_separate_partition: "{{ 'usr/local' in mount_stats.ansible_facts.ansible_mounts | map(attribute='mount') | list }}"

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: >-
      {{ '/usr/local/bin' if rke2_separate_partition else '/usr/bin' }}

- name: Check RKE2 version
  ansible.builtin.command:
    cmd: "{{ rke2_bin_path }}/rke2 version"
  register: rke2_version_output

- name: Set RKE2 versions
  ansible.builtin.set_fact:
    rke2_installed_version: "{{ rke2_version_output.stdout_lines[0].split()[2] }}"
    rke2_running_version: "{{ rke2_version_output.stdout_lines[1].split()[2] }}"

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.fail:
    msg: "Downgrading RKE2 is not allowed unless explicitly configured."
  when: rke2_installed_version > rke2_target_version and not allow_downgrade

- name: Run RKE2 install script
  ansible.builtin.shell:
    cmd: "/usr/local/bin/install-rke2.sh {{ rke2_install_options }}"
  environment:
    PATH: "{{ rke2_bin_path }}"

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: "{{ custom_manifests_src }}"
    dest: "{{ rke2_data_directory }}/manifests"
    mode: '0644'

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ static_pods_src }}"
    dest: "{{ rke2_agent_dir }}/manifests"
    mode: '0644'

- name: Copy RKE2 environment file
  ansible.builtin.copy:
    src: "{{ rke2_env_file_src }}"
    dest: "{{ rke2_env_file_dest }}"
    mode: '0644'


