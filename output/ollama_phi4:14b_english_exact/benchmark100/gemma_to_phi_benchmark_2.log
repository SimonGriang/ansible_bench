---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  gather_facts: no

- name: Install required software
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  when: users_requirements is defined and users_requirements | length > 0

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item }}"
  when: users_groups is defined

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "Include {{ users_sudo_includedir }}"
    validate: visudo -cf %s
  when: users_sudo_includedir is defined

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item }}"
  when: users is defined

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow | default(false) | bool

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow | default(true) | bool


