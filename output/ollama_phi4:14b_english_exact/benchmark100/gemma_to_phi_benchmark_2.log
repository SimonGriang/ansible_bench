---
- name: Create the RKE2 config directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  ansible.builtin.copy:
    src: "{{ rke2_config_template }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  ansible.builtin.copy:
    src: "{{ rke2_kubelet_config_template }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ rke2_containerd_registry_config_template }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0644'
  when: (rke2_custom_registry_mirrors | length > 0) or 
        (rke2_custom_registry_configs | length > 0)
  notify: Config file changed

- name: Register if we need to do an etcd restore from file
  ansible.builtin.set_fact:
    do_etcd_restore: true
  when:
    - rke2_etcd_snapshot_file is defined
    - not (ansible_facts.services['rke2-server.service'] is defined and 
        ansible_facts.services['rke2-server.service'].state == 'running')

- name: Register if we need to do an etcd restore from s3
  ansible.builtin.set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file is defined
    - rke2_etcd_snapshot_s3_options is defined
    - rke2_etcd_snapshot_s3_options.access_key is defined
    - rke2_etcd_snapshot_s3_options.secret_key is defined
    - rke2_etcd_snapshot_s3_options.bucket is defined

- name: Restore etcd from file
  ansible.builtin.block:
    - name: Create destination directory
      ansible.builtin.file:
        path: /var/lib/rancher/rke2/etcd-snapshots
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Copy snapshot file
      ansible.builtin.copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/etcd-snapshots/snapshot.db
        owner: root
        group: root
        mode: '0644'

    - name: Restore etcd
      ansible.builtin.command:
        cmd: rke2 server --etcd-snapshot-file /var/lib/rancher/rke2/etcd-snapshots/snapshot.db
        creates: /var/lib/rancher/rke2/server/node-token
  when: do_etcd_restore | default(false)

- name: Restore etcd from s3
  ansible.builtin.command:
    cmd: |
      rke2 server
      --etcd-snapshot-s3-restore
      --etcd-snapshot-s3-endpoint {{ rke2_etcd_snapshot_s3_options.endpoint }}
      --etcd-snapshot-s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }}
      --etcd-snapshot-s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }}
      --etcd-snapshot-s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }}
  when: do_etcd_restore_from_s3 | default(false)

- name: Start RKE2 service on the first server
  ansible.builtin.systemd:
    name: rke2-server.service
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  ansible.builtin.systemd:
    name: rke2-agent.service
    enabled: false
    masked: true

- name: Wait for the first server be ready - no CNI
  ansible.builtin.wait_for:
    cmd: kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="NetworkUnavailable")].status}'
    msg: Waiting for the first server to be ready without CNI
    timeout: 300
    interval: 10
    search_regex: 'False'

- name: Wait for the first server be ready - with CNI
  ansible.builtin.wait_for:
    cmd: kubectl get nodes --output=jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}'
    msg: Waiting for the first server to be ready with CNI
    timeout: 300
    interval: 10
    search_regex: 'True'

- name: Restore etcd
  ansible.builtin.block:
    - name: Get registered nodes
      ansible.builtin.command:
        cmd: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
      register: registered_nodes

    - name: Get node names
      ansible.builtin.command:
        cmd: hostname
      register: node_names

    - name: Remove old secrets and nodes
      ansible.builtin.command:
        cmd: kubectl delete secrets nodes
      when: registered_nodes.stdout | length > 0

- name: Set an Active Server variable
  ansible.builtin.set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ groups['rke2_cluster_group_name'] | first }}"
