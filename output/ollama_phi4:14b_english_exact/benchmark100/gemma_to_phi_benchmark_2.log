        dest: "/tmp/{{ java_package_name }}"
      when: java_source == "local" and java_format == "deb"

- name: Install oracle java (rpm) (repository)
  package:
    name: "oracle-java{{ java_version }}-linux-x64.rpm"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  block:
    - name: Ensure installation directory exists
      file:
        path: "/usr/lib/jvm/{{ java_package_name }}"
        state: directory

    - name: Extract Oracle Java archive
      unarchive:
        src: "{{ java_archive_path }}"
        dest: "/usr/lib/jvm/"
        remote_src: true
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_jce_zip_path }}"
    dest: "/usr/lib/jvm/{{ java_package_name }}/jre/lib/security"
    remote_src: true
  when: java_jce and java_version == "8" and java_vendor == "oracle"

- name: Set alternative (targz)
  alternatives:
    name: java
    path: "/usr/lib/jvm/{{ java_package_name }}/bin/java"
    link: /usr/bin/java
    priority: 2000
  when: 
    - java_format == "targz"
    - ansible_distribution != "Alpine"
    - java_vendor == "oracle"

- name: Find JAVA_HOME
  shell: readlink -f /usr/bin/java | xargs dirname | xargs dirname
  register: java_home

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home.stdout }}"
    create: true


