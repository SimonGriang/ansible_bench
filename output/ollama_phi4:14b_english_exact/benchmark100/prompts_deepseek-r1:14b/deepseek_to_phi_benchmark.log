e: Copy generated private SSH key for user\n  copy:\n    src: "/home/{{ user_name }}/.ssh/id_rsa"\n    dest: "{{ home_dir }}/.ssh/id_rsa"\n    owner: "{{ user_name }}"\n    mode: \'0600\'\n\n- name: Check users password valid time for user\n  shell: "chage -l {{ user_name }}"\n  register: password_validity\n  changed_when: false\n\n- name: Set users password valid time for user\n  user:\n    name: "{{ user_name }}"\n    password_expire_min: "{{ password_min_days | default(7) }}"\n    password_expire_max: "{{ password_max_days | default(90) }}"\n\n- name: Place private key file for user\n  copy:\n    src: "/home/{{ user_name }}/.ssh/id_rsa"\n    dest: "{{ home_dir }}/.ssh/id_rsa"\n    owner: "{{ user_name }}"\n    mode: \'0600\'\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-20T07:26:54.33852903Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9643318204, 'load_duration': 62570110, 'prompt_eval_count': 724, 'prompt_eval_duration': 236958418, 'eval_count': 732, 'eval_duration': 9343253059, 'model_name': 'phi4:14b'} id='run--94986027-bc5e-4eef-8cd7-df7f6a2d5b4d-0' usage_metadata={'input_tokens': 724, 'output_tokens': 732, 'total_tokens': 1456}
