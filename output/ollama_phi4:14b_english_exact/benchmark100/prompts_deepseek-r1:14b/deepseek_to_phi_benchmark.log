content='```yaml\n---\n- name: locations | Enable modules\n  apt:\n    name: "{{ item }}"\n    state: present\n  loop:\n    - libapache2-mod-proxy-html\n    - libapache2-mod-proxy\n  when: ansible_os_family == \'Debian\'\n  tags: enable_modules\n\n- name: locations | Enable modules\n  zypper:\n    name: "{{ item }}"\n    state: present\n  loop:\n    - apache2-mod_proxy_html\n    - apache2-mod_proxy\n  when: ansible_os_family == \'Suse\'\n  tags: enable_modules\n\n- name: locations | Configure locations\n  template:\n    src: location.conf.j2\n    dest: "/etc/apache2/mods-available/{{ item.name }}.conf"\n  loop: "{{ httpd_locations }}"\n  notify: restart apache\n  tags: configure_locations\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-20T07:15:31.294505893Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3144394950, 'load_duration': 52805541, 'prompt_eval_count': 318, 'prompt_eval_duration': 33741358, 'eval_count': 180, 'eval_duration': 3057302928, 'model_name': 'phi4:14b'} id='run--60a111c5-fa5b-45e4-856e-8ce3fa8976a6-0' usage_metadata={'input_tokens': 318, 'output_tokens': 180, 'total_tokens': 498}
