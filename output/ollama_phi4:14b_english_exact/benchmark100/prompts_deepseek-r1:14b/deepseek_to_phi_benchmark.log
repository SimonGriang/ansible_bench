---
- name: Import assertion file
  import_playbook: assert.yml

- name: Install system requirements
  package:
    name: bash
    state: present

- name: Install OpenJDK Java
  package:
    name: >-
      {{ 'openjdk-' ~ java_version if java_vendor == 'openjdk' else omit }}
    state: present
  when: java_vendor == "openjdk"

- name: Install Oracle Java RPM from local
  copy:
    src: "{{ oracle_java_rpm_path }}"
    dest: /tmp/oracle-java-{{ java_version }}-rpm.rpm
  command: >
    rpm -ivh /tmp/oracle-java-{{ java_version }}-rpm.rpm
  when: java_source == "local" and java_format == "rpm"

- name: Install Oracle Java DEB from local
  copy:
    src: "{{ oracle_java_deb_path }}"
    dest: /tmp/oracle-java-{{ java_version }}-deb.deb
  command: >
    dpkg -i /tmp/oracle-java-{{ java_version }}-deb.deb
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java RPM from repository
  package:
    name: "oracle-java-{{ java_version }}-rpm"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Java targz installation
  unarchive:
    src: "{{ oracle_java_targz_path }}"
    dest: /usr/lib/jvm
    remote_src: yes
  command: >
    alternatives --install /usr/bin/java java
    /usr/lib/jvm/oracle-java-{{ java_version }}/bin/java 2
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java JCE policy
  copy:
    src: "{{ oracle_java_jce_policy_path }}"
    dest: /usr/lib/jvm/oracle-java-{{ java_version }}/jre/lib/security
  command: >
    chmod 644
    /usr/lib/jvm/oracle-java-{{ java_version }}/jre/lib/security/US_export_policy.jar
  when: java_jce | bool and java_version == "8" and java_vendor == "oracle"

- name: Set Java alternative
  alternatives:
    name: java
    path: /usr/lib/jvm/oracle-java-{{ java_version }}/bin/java
    link: /usr/bin/java
    priority: 2
  when: java_format == "targz" and ansible_facts['os_family'] != "Alpine"

- name: Find Java home directory
  find:
    paths: /usr/bin
    patterns: java
  register: java_binary
  changed_when: false
  check_mode: no

- name: Set JAVA_HOME in environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME=$(dirname $(dirname $(readlink -f $(find /usr/bin -name java)) ))'
    create: yes


