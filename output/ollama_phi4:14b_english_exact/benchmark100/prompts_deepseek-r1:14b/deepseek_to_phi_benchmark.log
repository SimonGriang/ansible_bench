---
- name: Check current docker-compose version
  command: docker-compose --version
  register: docker_compose_version_output

- name: Set fact for docker-compose current version
  set_fact:
    docker_compose_current_version: "{{ docker_compose_version_output.stdout | regex_search('docker-compose[\\s]+version[\\s]+([\\d\\.]+)') | first }}"

- name: Delete existing docker-compose version if it's different
  command: rm /usr/local/bin/docker-compose
  when: docker_compose_current_version is defined and docker_compose_current_version != expected_docker_compose_version

- name: Install Docker Compose (if configured)
  get_url:
    url: "https://github.com/docker/compose/releases/download/{{ expected_docker_compose_version }}/docker-compose-{{ ansible_system }}-{{ ansible_architecture }}"
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when: docker_compose_current_version is not defined or docker_compose_current_version != expected_docker_compose_version


