---
- name: Ensure the proxy and proxy_http modules are enabled in Apache for Debian and Suse-based systems
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop:
    - libapache2-mod-proxy-html
    - libapache2-mod-proxy
  when: ansible_os_family == 'Debian'

- name: Ensure the proxy and proxy_http modules are enabled in Apache for Suse-based systems
  ansible.builtin.yum:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop:
    - mod_proxy_html
    - mod_proxy
  when: ansible_os_family == 'Suse'

- name: Configure Apache location settings using a template file for each location
  ansible.builtin.template:
    src: apache_location.j2
    dest: "/etc/apache2/sites-available/{{ item.name }}.conf"
  loop: "{{ httpd_locations }}"
  notify: 
    - Test Apache configuration
    - Restart Apache

- name: Enable the Apache site configuration
  ansible.builtin.command: a2ensite "{{ item.name }}"
  args:
    creates: "/etc/apache2/sites-enabled/{{ item.name }}.conf"
  loop: "{{ httpd_locations }}"

handlers:
  - name: Test Apache configuration
    ansible.builtin.command: apache2ctl configtest

  - name: Restart Apache
    ansible.builtin.service:
      name: apache2
      state: restarted


