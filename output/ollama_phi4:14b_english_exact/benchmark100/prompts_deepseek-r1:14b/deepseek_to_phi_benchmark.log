content='```yaml\n---\n- name: Remove old Docker versions\n  yum:\n    name: "{{ docker_obsolete_packages }}"\n    state: absent\n\n- name: Add Docker GPG key\n  command: rpm --import "{{ docker_yum_gpg_key }}"\n  when: docker_add_repo | bool\n\n- name: Add Docker repository\n  get_url:\n    url: "{{ docker_yum_repo_url }}"\n    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    owner: root\n    group: root\n    mode: \'0644\'\n  when: docker_add_repo | bool\n\n- name: Configure Docker Nightly repo\n  lineinfile:\n    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    regexp: \'^#?enablerepo=nightly$\'\n    line: \'enablerepo=nightly\'\n    state: "{{ \'present\' if docker_yum_repo_enable_nightly | bool else \'absent\' }}"\n  when: docker_add_repo | bool\n\n- name: Configure Docker Test repo\n  lineinfile:\n    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    regexp: \'^#?enablerepo=test$\'\n    line: \'enablerepo=test\'\n    state: "{{ \'present\' if docker_yum_repo_enable_test | bool else \'absent\' }}"\n  when: docker_add_repo | bool\n\n- name: Configure containerd on RHEL 8\n  block:\n    - name: Remove runc package\n      yum:\n        name: runc\n        state: absent\n\n    - name: Ensure container-selinux is installed\n      yum:\n        name: container-selinux\n        state: present\n\n    - name: Ensure containerd.io is installed\n      yum:\n        name: containerd.io\n        state: present\n  when: ansible_facts.distribution_major_version == \'8\'\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-20T06:54:57.802278617Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6866693497, 'load_duration': 55031568, 'prompt_eval_count': 547, 'prompt_eval_duration': 269837161, 'eval_count': 412, 'eval_duration': 6541044993, 'model_name': 'phi4:14b'} id='run--a7b9c03a-ba2d-4fbd-b4fb-51d8f4478b28-0' usage_metadata={'input_tokens': 547, 'output_tokens': 412, 'total_tokens': 959}
