---
- name: Import assertion tasks
  import_tasks: assert.yml
  when: inventory_hostname == "localhost"

- name: Install Apache HTTPD
  yum:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings
  selinux:
    policy: targeted
    state: enforcing
    seboolean: "{{ item.key }}"
    value: "{{ item.value }}"
  loop: "{{ httpd_sebooleans | dict2items }}"
  when: ansible_selinux.status == "enabled"

- name: Allow connections on specified ports
  seport:
    ports: "{{ item }}"
    proto: tcp
    setype: http_port_t
    state: present
  loop:
    - "{{ httpd_port }}"
    - "{{ httpd_ssl_port }}"
  when: ansible_selinux.status == "enabled"

- name: Configure Apache HTTPD
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify:
    - Test HTTPD configuration
    - Restart HTTPD service

- name: Activate Apache HTTPD modules | Debian
  command: "a2enmod {{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == "Debian"

- name: Import SSL configuration tasks
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations configuration tasks
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual hosts configuration tasks
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure Apache HTTPD ports
  template:
    src: ports.conf.j2
    dest: /etc/apache2/ports.conf
  notify:
    - Test HTTPD configuration
    - Restart HTTPD service
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directories configuration tasks
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush all registered handlers
  meta: flush_handlers

- name: Removing default HTML
  file:
    path: "{{ httpd_data_directory }}/welcome.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable Apache HTTPD
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


