---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection != 'local'

- name: Prepare system
  block:
    - name: Test connection and sudo access
      ansible.builtin.ping:
      become: true

    - name: Gather facts
      ansible.builtin.setup:

    - name: Install necessary packages
      ansible.builtin.apt:
        name: 
          - package1
          - package2
        state: present
      when: ansible_os_family == 'Debian'

    - name: Install libdnf5 for RedHat systems
      ansible.builtin.package:
        name: libdnf5
        state: present
      when: ansible_os_family == 'RedHat'
  rescue:
    - name: Gather facts after failure
      ansible.builtin.setup:

    - name: Install necessary packages with raw commands
      ansible.builtin.yum:
        name: 
          - package1
          - package2
        state: present
      when: ansible_os_family == 'RedHat'

- name: Gather ansible facts
  ansible.builtin.setup:
  become: false

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become | default(false) }}"


