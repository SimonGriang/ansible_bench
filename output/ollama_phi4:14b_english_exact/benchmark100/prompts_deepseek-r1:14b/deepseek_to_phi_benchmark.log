---
- name: Configure Vault
  hosts: all
  vars:
    vault_root_token: "{{ vault_root_token }}"
    vault_url: "{{ vault_url }}"
    vault_cert: "{{ vault_cert }}"
    vault_ca_cert: "{{ vault_ca_cert }}"

  tasks:
    - name: Install HashiCorp Vault
      apt:
        name: vault
        state: present
        update_cache: yes

    - name: Start and enable Vault service
      systemd:
        name: vault
        enabled: yes
        state: started

    - name: Initialize Vault
      command: vault operator init
      register: vault_init_output

    - name: Unseal Vault
      command: vault operator unseal {{ item.unseal_key }}
      loop: "{{ vault_init_output.stdout_lines | json_query('unseal_keys_b64[]') }}"
      loop_control:
        loop_var: item

    - name: Set Vault root token
      command: vault login {{ vault_root_token }}

    - name: Enable AppRole auth method
      command: vault auth enable approle

    - name: Create Vault policy
      command: vault policy write my_policy - <<EOF
        path "secret/data/*" {
          capabilities = [ "create", "read", "update", "delete", "list" ]
        }
      EOF

    - name: Create AppRole
      command: vault write auth/approle/role/my_role token_policies="my_policy" token_ttl=1h token_max_ttl=4h

    - name: Set Vault address
      lineinfile:
        path: /etc/vault.d/vault.hcl
        regexp: '^address ='
        line: 'address = "{{ vault_url }}"'

    - name: Set Vault cert
      lineinfile:
        path: /etc/vault.d/vault.hcl
        regexp: '^tls_cert_file ='
        line: 'tls_cert_file = "{{ vault_cert }}"'

    - name: Set Vault CA cert
      lineinfile:
        path: /etc/vault.d/vault.hcl
        regexp: '^tls_ca_file ='
        line: 'tls_ca_file = "{{ vault_ca_cert }}"'

    - name: Restart Vault service
      systemd:
        name: vault
        state: restarted


