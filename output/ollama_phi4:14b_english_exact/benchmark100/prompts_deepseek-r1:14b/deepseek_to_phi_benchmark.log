---
- name: Include tasks for installing Keepalived when HA mode is enabled
  ansible.builtin.include_tasks: install_keepalived.yml
  when: high_availability_enabled and additional_conditions

- name: Download and install RKE2
  ansible.builtin.include_tasks: download_install_rke2.yml

- name: Include tasks for CIS hardening
  ansible.builtin.include_tasks: cis_hardening.yml
  when: cis_profile is defined

- name: Include tasks to find active server
  ansible.builtin.include_tasks: find_active_server.yml

- name: Enable IPVS kernel module
  ansible.builtin.include_tasks: enable_ipvs_module.yml
  when: high_availability_enabled and ipvs_conditions

- name: Include tasks to copy kube-vip manifests
  ansible.builtin.include_tasks: copy_kube_vip_manifests.yml
  when: high_availability_enabled and kube_vip_conditions

- name: Include tasks to copy ingress-nginx manifests
  ansible.builtin.include_tasks: copy_ingress_nginx_manifests.yml
  when: ingress_nginx_values is defined

- name: Include tasks to prepare the first server node
  ansible.builtin.include_tasks: prepare_first_server_node.yml
  when: first_server_conditions

- name: Include tasks for etcd restore
  ansible.builtin.include_tasks: etcd_restore.yml
  when: etcd_restore_conditions

- name: Include tasks to download kubeconfig
  ansible.builtin.include_tasks: download_kubeconfig.yml
  when: download_kubeconfig_enabled

- name: Include tasks to join remaining nodes
  ansible.builtin.include_tasks: join_remaining_nodes.yml
  when: active_server is defined

- name: Include tasks for rolling restart of servers
  ansible.builtin.include_tasks: rolling_restart_servers.yml
  when: version_changes

- name: Include tasks for rolling restart of agents
  ansible.builtin.include_tasks: rolling_restart_agents.yml
  when: version_changes

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Include tasks for rolling restart when config changes
  ansible.builtin.include_tasks: rolling_restart_on_config_change.yml
  when: config_changes

- name: Include tasks for final steps
  ansible.builtin.include_tasks: final_steps.yml


