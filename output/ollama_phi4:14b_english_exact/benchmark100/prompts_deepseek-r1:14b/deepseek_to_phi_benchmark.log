---
- name: Import assertion tasks
  import_tasks: assert.yml
  hosts: localhost

- name: Install required software packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements }}"
  when: users_requirements | length > 0

- name: Manage user groups
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    loop_var: group

- name: Configure sudoers directory inclusion
  block:
    - name: Ensure /etc/sudoers.d directory is included in /etc/sudoers
      lineinfile:
        path: /etc/sudoers
        line: '#includedir /etc/sudoers.d'
        state: present
        validate: 'visudo -cf %s'
    - name: Validate /etc/sudoers file
      command: visudo -c -f /etc/sudoers

- name: Manage user configurations
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    loop_var: user

- name: Configure cron allow permissions
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow

- name: Remove cron allow file if not needed
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


