---
- name: Import assertion file
  include_tasks: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install cron package
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^SHELL='
    line: 'SHELL=/bin/bash'
    state: present

- name: Configure cron path environment
  lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^PATH='
    line: 'PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin'
    state: present

- name: Configure cron mailto settings
  lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^MAILTO='
    line: 'MAILTO=root'
    state: present

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    special_time: "{{ item.special_time | default(omit) }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    user: "{{ item.user | default(omit) }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"


