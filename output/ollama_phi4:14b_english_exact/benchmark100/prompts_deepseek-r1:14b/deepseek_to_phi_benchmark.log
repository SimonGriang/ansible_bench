- name: Set the package state based on how Ansible is installed
  set_fact:
    ansible_package_state: "{{ 'present' if ansible_facts.packages['ansible'] is defined else 'absent' }}"

- name: Set up Ansible on RedHat
  include_tasks: setup-RedHat.yml
  when: ansible_facts.os_family == 'RedHat' and ansible_facts.distribution != 'Fedora' and ansible_package_state == 'present'

- name: Set up Ansible on Fedora
  include_tasks: setup-Fedora.yml
  when: ansible_facts.distribution == 'Fedora' and ansible_package_state == 'present'

- name: Set up Ansible on Ubuntu
  include_tasks: setup-Ubuntu.yml
  when: ansible_facts.distribution == 'Ubuntu' and ansible_package_state == 'present'

- name: Set up Ansible on Debian
  include_tasks: setup-Debian.yml
  when: ansible_facts.distribution == 'Debian' and ansible_package_state == 'present'

- name: Set up Ansible using Pip
  include_tasks: setup-pip.yml
  when: ansible_package_state == 'absent'


