content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  tags: assert\n\n- name: Install DNS packages\n  package:\n    name: "{{ dns_packages }}"\n    state: present\n\n- name: Create directories for DNS data and configuration\n  file:\n    path: "{{ item.path }}"\n    state: directory\n    mode: "{{ item.mode }}"\n    owner: "{{ item.owner }}"\n    group: "{{ item.group }}"\n  with_items:\n    - { path: "{{ dns_data_dir }}", mode: "{{ dns_data_dir_mode }}", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }\n    - { path: "{{ dns_config_dir }}", mode: "{{ dns_config_dir_mode }}", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }\n\n- name: Create DNS group\n  group:\n    name: "{{ dns_group }}"\n    state: present\n\n- name: Create DNS user\n  user:\n    name: "{{ dns_owner }}"\n    system: yes\n    state: present\n\n- name: Generate rndc key file\n  dnskey:\n    name: "{{ dns_rndc_key_name }}"\n    key: rndc\n    algorithm: hmac-md5\n    keyfile: "{{ dns_config_dir }}/rndc.key"\n    state: present\n\n- name: Set permissions on rndc key file\n  file:\n    path: "{{ dns_config_dir }}/rndc.key"\n    owner: "{{ dns_owner }}"\n    group: "{{ dns_group }}"\n    mode: \'0640\'\n\n- name: Get the hints/root file\n  get_url:\n    url: "{{ root_hints_url }}"\n    dest: "{{ dns_data_dir }}/root.hints"\n    mode: \'0644\'\n  when: dns_caching_dns\n\n- name: Create DNS zone files from templates\n  template:\n    src: "{{ item.src }}"\n    dest: "{{ dns_data_dir }}/{{ item.dest }}"\n    mode: \'0644\'\n  notify: Rndc reload\n  with_items: "{{ dns_zones }}"\n  validate: "{{ dns_validator_cmd }} {{ dns_data_dir }}/{{ item.dest }}"\n\n- name: Add zones to DNS configuration\n  template:\n    src: named.conf.j2\n    dest: "{{ dns_config_dir }}/named.conf"\n  notify: Restart dns\n\n- name: Place systemd override configuration files\n  copy:\n    content: |\n      [Service]\n      {{ item.content }}\n    dest: "/etc/systemd/system/{{ dns_service_name }}.service.d/override.conf"\n  notify: Reload systemd\n  when: use_systemd\n  with_items:\n    - { content: "ExecStartPre=-/bin/rm -f {{ dns_data_dir }}/{{ item_name }}.old" }\n\n- name: Start and enable DNS service\n  service:\n    name: "{{ dns_service_name }}"\n    state: started\n    enabled: yes\n```\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-20T06:45:27.438593767Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9084929042, 'load_duration': 50873589, 'prompt_eval_count': 582, 'prompt_eval_duration': 261392014, 'eval_count': 598, 'eval_duration': 8770979997, 'model_name': 'phi4:14b'} id='run--fb82fbf6-78a6-4cb7-a30c-efdf35051b6e-0' usage_metadata={'input_tokens': 582, 'output_tokens': 598, 'total_tokens': 1180}
