---
- name: Populate services facts
  ansible.builtin.setup:
    gather_subset: '!all,!network'
  tags:
    - services_facts

- name: Set the Active Server variable
  ansible.builtin.set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  when: "'rke2-server' in ansible_facts.services and ansible_facts.services['rke2-server'].state == 'running'"
  with_items: "{{ groups['rke2_cluster'] }}"
  tags:
    - set_active_server


