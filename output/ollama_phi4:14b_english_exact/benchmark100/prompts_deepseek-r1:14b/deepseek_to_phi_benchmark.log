---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  block:
    - name: Update cache
      apk:
        update_cache: yes
        state: present
        update_cache_retries: 5
        update_cache_timeout: 10
      changed_when: false

    - name: Update all software
      apk:
        upgrade: yes
        state: present
      changed_when: false

- name: Configure apt
  block:
    - name: Hold selected packages
      apt:
        name: "{{ item }}"
        state: hold
      loop: "{{ hold_packages }}"

    - name: Update all software
      apt:
        upgrade: dist
        update_cache: yes
        cache_valid_time: 3600
      environment:
        DEBIAN_FRONTEND: noninteractive

- name: Update all software (dnf)
  block:
    - name: Exclude specific packages
      dnf:
        name: "*"
        exclude: "{{ exclude_packages }}"
        state: latest

- name: Update all software (pacman)
  block:
    - name: Update cache
      pacman:
        update_cache: yes

    - name: Update all software
      pacman:
        upgrade: yes

- name: Configure yum
  block:
    - name: Check if CentOS/RHEL 6
      set_fact:
        is_centos_rhel_6: "{{ ansible_distribution_major_version == '6' }}"

    - name: Update all software using dnf
      when: is_centos_rhel_6
      dnf:
        name: "*"
        state: latest

    - name: Update all software using yum
      when: not is_centos_rhel_6
      yum:
        name: "*"
        state: latest

    - name: Install yum-utils
      when: not is_centos_rhel_6
      yum:
        name: yum-utils
        state: present

- name: Update all software (zypper)
  block:
    - name: Update all software
      zypper:
        update: yes
        refresh: yes


