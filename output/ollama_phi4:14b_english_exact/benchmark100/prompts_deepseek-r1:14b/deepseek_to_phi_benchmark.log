    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items:
    - { path: "{{ dns_data_dir }}", mode: "{{ dns_data_dir_mode }}", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }
    - { path: "{{ dns_config_dir }}", mode: "{{ dns_config_dir_mode }}", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }

- name: Create DNS group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create DNS user
  user:
    name: "{{ dns_owner }}"
    system: true
    state: present

- name: Generate rndc key file
  dnskey:
    name: "{{ dns_rndc_key_name }}"
    key: rndc
    algorithm: hmac-md5
    keyfile: "{{ dns_config_dir }}/rndc.key"
    state: present

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_config_dir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0640'

- name: Get the hints/root file
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ dns_data_dir }}/root.hints"
    mode: '0644'
  when: dns_caching_dns

- name: Create DNS zone files from templates
  template:
    src: "{{ item.src }}"
    dest: "{{ dns_data_dir }}/{{ item.dest }}"
    mode: '0644'
  notify: Rndc reload
  with_items: "{{ dns_zones }}"
  validate: "{{ dns_validator_cmd }} {{ dns_data_dir }}/{{ item.dest }}"

- name: Add zones to DNS configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_config_dir }}/named.conf"
  notify: Restart dns

- name: Place systemd override configuration files
  copy:
    content: |
      [Service]
      {{ item.content }}
    dest: "/etc/systemd/system/{{ dns_service_name }}.service.d/override.conf"
  notify: Reload systemd
  when: use_systemd
  with_items:
    - { content: "ExecStartPre=-/bin/rm -f {{ dns_data_dir }}/{{ item_name }}.old" }

- name: Start and enable DNS service
  service:
    name: "{{ dns_service_name }}"
    state: started
    enabled: yes


