---
- name: Ensure /etc/openvpn/easy-rsa directory exists with mode 0755
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize OpenVPN PKI structure
  ansible.builtin.command:
    cmd: easyrsa init-pki
    creates: /etc/openvpn/easy-rsa/pki/index.txt
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate OpenVPN CA certificate
  ansible.builtin.command:
    cmd: easyrsa build-ca nopass
    creates: /etc/openvpn/easy-rsa/pki/ca.crt
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'

- name: Generate Diffie-Hellman parameters
  ansible.builtin.command:
    cmd: easyrsa gen-dh
    creates: /etc/openvpn/easy-rsa/pki/dh.pem
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate server certificate
  ansible.builtin.command:
    cmd: easyrsa build-server-full server nopass
    creates: /etc/openvpn/easy-rsa/pki/issued/server.crt
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'

- name: Generate client certificate
  ansible.builtin.command:
    cmd: easyrsa build-client-full client nopass
    creates: /etc/openvpn/easy-rsa/pki/issued/client.crt
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'

- name: Generate Certificate Revocation List
  ansible.builtin.command:
    cmd: easyrsa gen-crl
    creates: /etc/openvpn/easy-rsa/pki/crl.pem
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate OpenVPN TA key
  ansible.builtin.command:
    cmd: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
    creates: /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy PKI files to /etc/openvpn/server directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/{{ item }}
    mode: '0640'
  loop:
    - ca.crt
    - dh.pem
    - ta.key
    - index.txt
    - cert.crt
    - key.pem
    - crl.pem

- name: Copy additional PKI files to /etc/openvpn directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/{{ item }}
    mode: '0640'
  loop:
    - ca.crt
    - dh.pem
    - ta.key

- name: Place OpenVPN server configuration file
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    owner: root
    group: root
    mode: '0644'
  notify: restart openvpn


