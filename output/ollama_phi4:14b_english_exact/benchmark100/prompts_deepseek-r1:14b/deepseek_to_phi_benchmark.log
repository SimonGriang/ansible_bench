---
- name: Import assertion file
  import_playbook: assert.yml
  hosts: localhost
  gather_facts: no

- name: Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell
  lineinfile:
    path: /etc/crontab
    regexp: '^SHELL='
    line: 'SHELL={{ cron_shell }}'
  notify: restart cron

- name: Configure cron path
  lineinfile:
    path: /etc/crontab
    regexp: '^PATH='
    line: 'PATH={{ cron_path }}'
  notify: restart cron

- name: Configure cron mailto
  lineinfile:
    path: /etc/crontab
    regexp: '^MAILTO='
    line: 'MAILTO={{ cron_mailto }}'
  notify: restart cron

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ""

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"

handlers:
  - name: restart cron
    service:
      name: cron
      state: restarted


