---
- name: Install unzip package
  ansible.builtin.package:
    name: unzip
    state: present

- name: Create system group for promtail
  ansible.builtin.group:
    name: promtail
    system: yes
    state: present

- name: Create system user for promtail
  ansible.builtin.user:
    name: promtail
    group: promtail
    groups: adm, log, logrotate
    system: yes
    create_home: no
    shell: /sbin/nologin

- name: Ensure /usr/local/bin directory exists
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  ansible.builtin.file:
    path: /etc/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'

- name: Create application directories
  ansible.builtin.file:
    path: /opt/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'

- name: Check promtail binary existence
  ansible.builtin.stat:
    path: /usr/local/bin/promtail
  register: promtail_binary

- name: Download promtail binaries
  ansible.builtin.get_url:
    url: "{{ promtail_distribution_url }}"
    dest: /tmp/promtail.zip
    checksum: "{{ promtail_checksum }}"
  when: not promtail_binary.stat.exists

- name: Propagate local promtail binaries
  ansible.builtin.copy:
    src: /usr/local/promtail/bin/promtail
    dest: /tmp/promtail/bin/promtail
    mode: '0755'
  when: inventory_hostname == 'localhost'

- name: Download promtail binaries for controller node
  ansible.builtin.get_url:
    url: "{{ promtail_distribution_url }}"
    dest: /tmp/promtail.zip
    checksum: "{{ promtail_checksum }}"
  when: inventory_hostname == 'controller'

- name: Propagate promtail binaries
  ansible.builtin.copy:
    src: /tmp/promtail/bin/promtail
    dest: /opt/promtail/bin/promtail
    mode: '0755'
  when: inventory_hostname == 'controller'

- name: Unpack promtail binaries
  ansible.builtin.unarchive:
    src: /tmp/promtail.zip
    dest: /tmp/promtail
    creates: /tmp/promtail/bin/promtail
    remote_src: yes

- name: Create symlink to latest promtail version
  ansible.builtin.file:
    src: /tmp/promtail/bin/promtail
    dest: /usr/local/bin/promtail
    state: link
  notify:
    - Restart promtail

- name: Write promtail config file
  ansible.builtin.template:
    src: promtail.j2
    dest: /etc/promtail/config.yml
    owner: promtail
    group: promtail
    mode: '0644'

- name: Create systemd service unit
  ansible.builtin.template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify:
    - Restart promtail


