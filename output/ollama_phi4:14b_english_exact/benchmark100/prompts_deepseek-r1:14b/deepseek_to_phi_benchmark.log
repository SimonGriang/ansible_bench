content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  run_once: true\n  delegate_to: localhost\n\n- name: Manage automatic service management\n  block:\n    - name: Disable automatic service start for apt\n      copy:\n        dest: /usr/sbin/policy-rc.d\n        content: "exit 101"\n        mode: \'0755\'\n      when: ansible_pkg_mgr == \'apt\' and apt_autostart_state == \'disabled\'\n\n    - name: Enable automatic service start for apt\n      file:\n        path: /usr/sbin/policy-rc.d\n        state: absent\n      when: ansible_pkg_mgr == \'apt\' and apt_autostart_state == \'enabled\'\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-20T07:36:58.466925965Z', 'done': True, 'done_reason': 'stop', 'total_duration': 2236088438, 'load_duration': 74846755, 'prompt_eval_count': 383, 'prompt_eval_duration': 37461851, 'eval_count': 155, 'eval_duration': 2123030502, 'model_name': 'phi4:14b'} id='run--d99261fb-1c89-44e2-b13a-afb92901e7a5-0' usage_metadata={'input_tokens': 383, 'output_tokens': 155, 'total_tokens': 538}
