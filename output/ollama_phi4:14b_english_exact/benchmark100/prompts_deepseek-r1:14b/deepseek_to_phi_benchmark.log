---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    server_taints: "dedicated=server:NoSchedule"
  when: node_type == 'server'

- name: Set agent taints
  set_fact:
    agent_taints: "dedicated=agent:NoSchedule"
  when: node_type == 'agent'

- name: Copy RKE2 configuration file
  template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Restart rke2

- name: Copy Kubelet configuration file
  template:
    src: kubelet-config.yaml.j2
    dest: /var/lib/rancher/k3s/data/kubelet/config.yaml
    owner: root
    group: root
    mode: '0644'
  when: kubelet_config is defined
  notify: Restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ containerd_registry_config_path }}"
    dest: /etc/containerd/registries.conf
    owner: root
    group: root
    mode: '0644'
  when: containerd_registry_config_path is defined
  notify: Restart rke2

- name: Start RKE2 service on other nodes
  service:
    name: rke2
    state: started
    enabled: yes
  when: inventory_hostname != ansible_host
  notify: Restart rke2

- name: Mask other RKE2 services on nodes
  service:
    name: "{{ item }}"
    enabled: no
    masked: yes
  loop:
    - rke2-server
    - rke2-agent
  when: >
    (node_type == 'server' and item != 'rke2-server') or
    (node_type == 'agent' and item != 'rke2-agent')

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    timeout: 300
    search_regex: 'All systems are healthy'
  when: cni_configured | default(false) == false
  retries: 30
  delay: 10

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    timeout: 300
    search_regex: 'All systems are healthy'
  when: cni_configured | default(false) == true
  retries: 30
  delay: 10


