  when: ansible_facts['distribution'] in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges | join(',') }}"
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers again
  meta: flush_handlers


