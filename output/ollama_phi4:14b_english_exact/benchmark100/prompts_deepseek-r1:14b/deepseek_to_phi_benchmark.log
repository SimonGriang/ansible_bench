---
- name: Generate an OpenSSL private key
  community.crypto.openssl_privatekey:
    path: "{{ key_directory }}/{{ private_key_name }}"
    type: RSA
    size: 2048
  delegate_to: localhost
  run_once: true
  register: private_key_output

- name: Set permissions and ownership for private key
  ansible.builtin.file:
    path: "{{ key_directory }}/{{ private_key_name }}"
    owner: "{{ file_owner }}"
    group: "{{ file_group }}"
    mode: "{{ file_mode }}"
  delegate_to: localhost
  run_once: true

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  community.crypto.openssl_csr:
    path: "{{ csr_directory }}/{{ csr_name }}"
    privatekey_path: "{{ key_directory }}/{{ private_key_name }}"
    common_name: "{{ common_name }}"
  delegate_to: localhost
  run_once: true
  register: csr_output

- name: Set permissions and ownership for CSR
  ansible.builtin.file:
    path: "{{ csr_directory }}/{{ csr_name }}"
    owner: "{{ file_owner }}"
    group: "{{ file_group }}"
    mode: "{{ file_mode }}"
  delegate_to: localhost
  run_once: true

- name: Generate an OpenSSL X.509 certificate
  community.crypto.x509_certificate:
    path: "{{ certificate_directory }}/{{ certificate_name }}"
    privatekey_path: "{{ key_directory }}/{{ private_key_name }}"
    csr_path: "{{ csr_directory }}/{{ csr_name }}"
    provider: selfsigned
  delegate_to: localhost
  run_once: true
  register: certificate_output

- name: Set permissions and ownership for certificate
  ansible.builtin.file:
    path: "{{ certificate_directory }}/{{ certificate_name }}"
    owner: "{{ file_owner }}"
    group: "{{ file_group }}"
    mode: "{{ file_mode }}"
  delegate_to: localhost
  run_once: true

- name: Generate a PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: "{{ key_directory }}/{{ p12_name }}"
    privatekey_path: "{{ key_directory }}/{{ private_key_name }}"
    certificate_path: "{{ certificate_directory }}/{{ certificate_name }}"
    friendly_name: "{{ friendly_name }}"
    passphrase: "{{ p12_passphrase }}"
  delegate_to: localhost
  run_once: true
  register: p12_output

- name: Set permissions and ownership for PKCS#12 file
  ansible.builtin.file:
    path: "{{ key_directory }}/{{ p12_name }}"
    owner: "{{ file_owner }}"
    group: "{{ file_group }}"
    mode: "{{ file_mode }}"
  delegate_to: localhost
  run_once: true

- name: Read private key content
  ansible.builtin.slurp:
    path: "{{ key_directory }}/{{ private_key_name }}"
  delegate_to: localhost
  run_once: true
  register: private_key_content

- name: Read certificate content
  ansible.builtin.slurp:
    path: "{{ certificate_directory }}/{{ certificate_name }}"
  delegate_to: localhost
  run_once: true
  register: certificate_content

- name: Create a combined private key and certificate file
  ansible.builtin.copy:
    dest: "{{ key_directory }}/{{ combined_name }}"
    content: |
      {{ private_key_content['content'] | b64decode }}
      {{ certificate_content['content'] | b64decode }}
  delegate_to: localhost
  run_once: true

- name: Set permissions and ownership for combined key and certificate file
  ansible.builtin.file:
    path: "{{ key_directory }}/{{ combined_name }}"
    owner: "{{ file_owner }}"
    group: "{{ file_group }}"
    mode: "{{ file_mode }}"
  delegate_to: localhost
  run_once: true


