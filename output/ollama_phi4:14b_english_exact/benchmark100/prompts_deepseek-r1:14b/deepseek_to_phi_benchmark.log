---
- name: Task 1 - Generate a private SSL key using OpenSSL
  openssl_privatekey:
    path: "{{ ssl_key_dir }}/{{ ssl_key_file }}"
    size: 2048
    owner: "{{ ssl_key_owner }}"
    group: "{{ ssl_key_group }}"
    mode: "{{ ssl_key_mode }}"
  register: ssl_key

- name: Task 2 - Generate a Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ ssl_csr_dir }}/{{ ssl_csr_file }}"
    privatekey_path: "{{ ssl_key_dir }}/{{ ssl_key_file }}"
    common_name: "{{ ssl_common_name }}"
    owner: "{{ ssl_csr_owner }}"
    group: "{{ ssl_csr_group }}"
    mode: "{{ ssl_csr_mode }}"
  register: ssl_csr

- name: Task 3 - Generate a self-signed SSL certificate
  openssl_certificate:
    path: "{{ ssl_cert_dir }}/{{ ssl_cert_file }}"
    privatekey_path: "{{ ssl_key_dir }}/{{ ssl_key_file }}"
    csr_path: "{{ ssl_csr_dir }}/{{ ssl_csr_file }}"
    provider: selfsigned
    owner: "{{ ssl_cert_owner }}"
    group: "{{ ssl_cert_group }}"
    mode: "{{ ssl_cert_mode }}"
  register: ssl_cert

- name: Task 4 - Create a PKCS#12 file
  openssl_pkcs12:
    path: "{{ ssl_p12_dir }}/{{ ssl_p12_file }}"
    privatekey_path: "{{ ssl_key_dir }}/{{ ssl_key_file }}"
    certificate_path: "{{ ssl_cert_dir }}/{{ ssl_cert_file }}"
    export_privatekey: yes
    owner: "{{ ssl_p12_owner }}"
    group: "{{ ssl_p12_group }}"
    mode: "{{ ssl_p12_mode }}"

- name: Task 5 - Read the private key content
  slurp:
    src: "{{ ssl_key_dir }}/{{ ssl_key_file }}"
  register: ssl_key_content

- name: Task 6 - Read the certificate content
  slurp:
    src: "{{ ssl_cert_dir }}/{{ ssl_cert_file }}"
  register: ssl_cert_content

- name: Task 7 - Combine private key and certificate into a single file
  copy:
    dest: "{{ ssl_combined_dir }}/{{ ssl_combined_file }}"
    content: |
      {{ ssl_key_content.content | b64decode }}
      {{ ssl_cert_content.content | b64decode }}
    owner: "{{ ssl_combined_owner }}"
    group: "{{ ssl_combined_group }}"
    mode: "{{ ssl_combined_mode }}"


