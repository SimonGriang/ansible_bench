---
- name: Install EPEL on compatible systems
  hosts: all
  become: true
  tasks:
    - name: Install EPEL GPG key
      ansible.builtin.rpm_key:
        key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-7
        state: present

    - name: Install EPEL-release package
