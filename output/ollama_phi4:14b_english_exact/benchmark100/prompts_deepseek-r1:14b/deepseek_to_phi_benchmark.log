---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  block:
    - name: Update cache
      community.general.apk:
        update_cache: true
        state: present
      changed_when: false

    - name: Update all software
      community.general.apk:
        upgrade: true
        state: present
      changed_when: false

- name: Configure apt
  block:
    - name: Hold selected packages
      ansible.builtin.apt:
        name: "{{ item }}"
        state: held
      loop: "{{ hold_packages }}"

    - name: Update all software
      ansible.builtin.apt:
        upgrade: dist
        update_cache: true
        cache_valid_time: 3600
      environment:
        DEBIAN_FRONTEND: noninteractive

- name: Update all software (dnf)
  block:
    - name: Exclude specific packages
      ansible.builtin.dnf:
        name: "*"
        exclude: "{{ exclude_packages }}"
        state: latest
      when: ansible_pkg_mgr == 'dnf'

    - name: Exclude specific packages
      ansible.builtin.yum:
        name: "*"
        exclude: "{{ exclude_packages }}"
        state: latest
      when: ansible_pkg_mgr == 'yum'

- name: Update all software (pacman)
  block:
    - name: Update cache
      community.general.pacman:
        update_cache: true

    - name: Update all software
      community.general.pacman:
        upgrade: true

- name: Configure yum
  block:
    - name: Check if CentOS/RHEL 6
      ansible.builtin.set_fact:
        is_centos_rhel_6: "{{ ansible_distribution_major_version == '6' }}"

    - name: Update all software using dnf
      ansible.builtin.dnf:
        name: "*"
        state: latest
      when: is_centos_rhel_6

    - name: Update all software using yum
      ansible.builtin.yum:
        name: "*"
        state: latest
      when: not is_centos_rhel_6

    - name: Install yum-utils
      ansible.builtin.yum:
        name: yum-utils
        state: present
      when: not is_centos_rhel_6

- name: Update all software (zypper)
  block:
    - name: Update all software
      community.general.zypper:
        update: true
        refresh: true


