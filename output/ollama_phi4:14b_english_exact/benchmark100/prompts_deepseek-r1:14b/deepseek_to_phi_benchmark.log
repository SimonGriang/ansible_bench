---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  block:
    - name: Configure debconf settings for postfix
      debconf:
        name: postfix
        question: '{{ item.question }}'
        value: '{{ item.value }}'
        vtype: '{{ item.type }}'
      loop:
        - { question: 'postfix/mailname', value: '{{ postfix_mailname }}', type: 'string' }
        - { question: 'postfix/main_mailer_type', value: 'Internet Site', type: 'select' }

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps or postfix_virtual_alias_maps or postfix_virtual_alias_domains

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
  notify:
    - Validate and rebuild transport maps
    - Restart postfix

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - Validate and reload postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_part1:
      recipient_delimiter: '+'
      smtpd_recipient_restrictions:
        - reject_unauth_destination
      smtpd_sender_restrictions:
        - reject_unknown_sender_domain
        - reject_unauth_pipelining

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf_part2:
      mynetworks: '127.0.0.0/8 [::1]/128'
      mydestination: '$myhostname, localhost.$mydomain, $mydomain'
      relay_domains: ''
      unknown_local_recipient_reject_code: '550'

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - Validate and restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - Validate and restart postfix

- name: Creates cert/key directory
  file:
    path: /etc/ssl/private
    state: directory
    owner: postfix
    group: postfix
    mode: '0750'

- name: Deploy Postfix TLS server certificate
  copy:
    src: 'files/{{ postfix_tls_cert_file }}'
    dest: /etc/ssl/certs/{{ postfix_tls_cert_file }}
    owner: root
    group: root
    mode: '0644'
  notify:
    - Reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: 'files/{{ postfix_tls_key_file }}'
    dest: /etc/ssl/private/{{ postfix_tls_key_file }}
    owner: root
    group: root
    mode: '0640'
  notify:
    - Reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: '{{ item.line }}'
    state: present
  loop: '{{ postfix_aliases }}'
  notify:
    - Rebuild and reload postfix

- name: Configure sender_access
  lineinfile:
    path: /etc/postfix/sender_access
    line: '{{ item.line }}'
    state: present
  loop: '{{ postfix_sender_access }}'
  notify:
    - Rebuild and reload postfix

- name: Configure recipient_access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: '{{ item.line }}'
    state: present
  loop: '{{ postfix_recipient_access }}'
  notify:
    - Validate, rebuild, and reload postfix

- name: Place sasl_password_map
  copy:
    content: '{{ postfix_sasl_password_map_content }}'
    dest: /etc/postfix/sasl/sasl_password
    owner: postfix
    group: postfix
    mode: '0600'
  notify:
    - Rebuild sasl password map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true


