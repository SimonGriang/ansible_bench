---
- name: Import assert.yml
  import_tasks: assert.yml
  tags:
    - import_assert

- name: Install using package
  package:
    name: "{{ hashicorp_product }}"
    state: present
  when: ansible_os_family == 'RedHat'
  tags:
    - install_package_redhat

- name: Install using package
  package:
    name: "{{ hashicorp_product }}"
    state: present
  when: ansible_os_family == 'Debian'
  tags:
    - install_package_debian

- name: Configure debian
  block:
    - name: Add GPG key
      ansible.builtin.apt_key:
        url: https://apt.releases.hashicorp.com/gpg
        state: present

    - name: Add apt repository
      ansible.builtin.apt_repository:
        repo: deb [arch=amd64] https://apt.releases.hashicorp.com \
              {{ ansible_distribution_release }} main
        state: present
  when: ansible_os_family == 'Debian'
  tags:
    - configure_debian

- name: Install hashicorp product using package
  block:
    - name: Install latest version
      package:
        name: "{{ hashicorp_product }}"
        state: present
      when: hashicorp_product_version is not defined

    - name: Install specific version
      package:
        name: "{{ hashicorp_product }}={{ hashicorp_product_version }}"
        state: present
      when: hashicorp_product_version is defined
  tags:
    - install_hashicorp_package

- name: Install manually
  block:
    - name: Download and extract HashiCorp product
      unarchive:
        src: "{{ hashicorp_product_download_url }}"
        dest: "{{ hashicorp_product_dest }}"
        remote_src: true
        creates: "{{ hashicorp_product_dest }}/bin/{{ hashicorp_product_binary }}"
        mode: '0755'
  tags:
    - install_manually


