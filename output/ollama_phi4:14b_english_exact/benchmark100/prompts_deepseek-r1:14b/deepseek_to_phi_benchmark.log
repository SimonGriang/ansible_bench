---
- name: Create local SSH key directory for user
  file:
    path: "/home/{{ user_name }}/.ssh"
    state: directory
    owner: "{{ user_name }}"
    mode: '0750'

- name: Manage user account
  user:
    name: "{{ user_name }}"
    comment: "{{ user_comment | default(omit) }}"
    home: "{{ user_home | default(omit) }}"
    shell: "{{ user_shell | default(omit) }}"
    state: "{{ user_state | default('present') }}"
    create_home: "{{ user_create_home | default(true) }}"

- name: Set sudo options for user
  copy:
    content: "{{ sudo_options }}"
    dest: "/etc/sudoers.d/{{ user_name }}"
    mode: '0440'
    owner: root
    group: root
    validate: 'visudo -cf %s'

- name: Generate private SSH key for user
  shell: "ssh-keygen -t rsa -b 2048 -f /home/{{ user_name }}/.ssh/id_rsa -N ''"
  args:
    creates: "/home/{{ user_name }}/.ssh/id_rsa"

- name: Generate public SSH key for user
  shell: "ssh-keygen -y -f /home/{{ user_name }}/.ssh/id_rsa > /home/{{ user_name }}/.ssh/id_rsa.pub"
  args:
    creates: "/home/{{ user_name }}/.ssh/id_rsa.pub"

- name: Convert SSH key to ppk format for user
  shell: "puttygen /home/{{ user_name }}/.ssh/id_rsa -o /home/{{ user_name }}/.ssh/id_rsa.ppk"
  args:
    creates: "/home/{{ user_name }}/.ssh/id_rsa.ppk"

- name: Get or set the home directory for user
  set_fact:
    home_dir: "{{ user_home | default('/home/' ~ user_name) }}"

- name: Create .ssh directory for user
  file:
    path: "{{ home_dir }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user_name }}"

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user_name }}"
    state: present
    key: "{{ item }}"
  with_file:
    - "{{ authorized_keys_file }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user_name }}"
    state: absent
    key: "{{ item }}"
  with_file:
    - "{{ unauthorized_keys_file }}"

- name: Copy generated private SSH key for user
  copy:
    src: "/home/{{ user_name }}/.ssh/id_rsa"
    dest: "{{ home_dir }}/.ssh/id_rsa"
    owner: "{{ user_name }}"
    mode: '0600'

- name: Check users password valid time for user
  shell: "chage -l {{ user_name }}"
  register: password_validity
  changed_when: false

- name: Set users password valid time for user
  user:
    name: "{{ user_name }}"
    password_expire_min: "{{ password_min_days | default(7) }}"
    password_expire_max: "{{ password_max_days | default(90) }}"

- name: Place private key file for user
  copy:
    src: "/home/{{ user_name }}/.ssh/id_rsa"
    dest: "{{ home_dir }}/.ssh/id_rsa"
    owner: "{{ user_name }}"
    mode: '0600'


