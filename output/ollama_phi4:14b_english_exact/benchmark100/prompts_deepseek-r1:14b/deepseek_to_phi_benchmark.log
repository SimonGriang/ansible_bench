---
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_facts.init_system == "systemd"
    fail_msg: "The system does not use systemd as the init system."
    success_msg: "Systemd is used as the init system."

- name: Get latest release and set promtail version
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
    status_code: 200
  register: latest_release

- name: Set promtail_version variable
  set_fact:
    promtail_version: "{{ latest_release.json.tag_name }}"

- name: Test if zip local archive exists and assert local binary exists
  stat:
    path: "{{ local_directory }}/promtail.zip"
  register: promtail_zip

- name: Assert local binary exists
  assert:
    that:
      - promtail_zip.stat.exists
    fail_msg: "The local binary archive does not exist."
    success_msg: "The local binary archive exists."

- name: Get checksum list and set checksum for target architecture
  uri:
    url: https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail_{{ promtail_version }}_checksums.txt
    return_content: yes
    status_code: 200
  register: checksum_list

- name: Set checksum for target architecture
  set_fact:
    checksum: "{{ checksum_list.content.split('\n') | select('match', 'promtail_.*_linux_{{ target_architecture }}.zip') | first | regex_replace('^[^ ]+ +', '') }}"


