- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_version }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: "{{ ansible_architecture }}.yml"

- name: Set OS specific variables (I)
  set_fact:
    java_openjdk_version: "{{ java_openjdk_version | default('default_version') }}"
    java_openjdk_repositories: "{{ java_openjdk_repositories | default([]) }}"
    java_openjdk_libs: "{{ java_openjdk_libs | default([]) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_openjdk_install_path: "{{ java_openjdk_install_path | default('/default/path') }}"
    java_openjdk_package_name: "{{ java_openjdk_package_name | default('default_package') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_openjdk_install_path }}/jdk"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "ppa:deb.debian.org/debian {{ ansible_distribution_release }} main"
        state: absent

    - name: Install extra apt tools
      apt:
        name: apt-transport-https
        state: present
        update_cache: yes

    - name: Add key repositories
      apt_key:
        url: "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x{{ item }}"
      loop:
        - "{{ java_openjdk_repo_key }}"

    - name: Add required repositories
      apt_repository:
        repo: "deb https://{{ java_openjdk_repo_url }}/{{ ansible_distribution_release }} main"

  when: ansible_distribution in ['Debian', 'Ubuntu']

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: "https://{{ java_openjdk_repo_key_url }}"

    - name: Add required repositories
      yum_repository:
        name: java_openjdk
        baseurl: "https://{{ java_openjdk_repo_url }}"
        gpgcheck: yes

  when: ansible_distribution in ['RedHat', 'CentOS', 'Fedora']

- name: Install required libs
  package:
    name: "{{ java_openjdk_libs }}"
    state: present

- name: Install Java, Debian
  apt:
    name: "{{ java_openjdk_package_name }}"
    state: present
    update_cache: yes
  when: ansible_distribution in ['Debian', 'Ubuntu']

- name: Install Java, RedHat
  yum:
    name: "{{ java_openjdk_package_name }}"
    state: present
    update_cache: yes
  when: ansible_distribution in ['RedHat', 'CentOS', 'Fedora']

- name: Export environment variables
  lineinfile:
    path: /etc/profile.d/java.sh
    line: "export JAVA_HOME={{ java_home }}"
    create: yes

- name: Source environment variables
  command: source /etc/profile.d/java.sh

- name: Correct java version selected for Java < 11
  alternatives:
    name: java
    path: "{{ java_home }}/jre/bin/java"
  when: java_openjdk_version is version('11', '<')

- name: Correct java version selected for Java >= 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
  when: java_openjdk_version is version('11', '>=')


