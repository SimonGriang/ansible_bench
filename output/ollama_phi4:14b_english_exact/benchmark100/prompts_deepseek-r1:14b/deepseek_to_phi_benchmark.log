---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_script_path }}"
    mode: '0700'
  when: not airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local_path }}"
    dest: "{{ rke2_script_path }}"
    mode: '0700'
  when: airgap_mode and implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0700'
  when: airgap_mode and implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ rke2_checksum_url }}"
    dest: "{{ rke2_checksum_path }}"
    mode: '0644'
  register: checksum_download
  until: checksum_download is succeeded
  retries: 3
  delay: 5
  when: not airgap_mode or (airgap_mode and implementation == 'remote')

- name: Fallback to local checksum download
  copy:
    src: "{{ rke2_checksum_local_path }}"
    dest: "{{ rke2_checksum_path }}"
    mode: '0644'
  when: checksum_download is failed and airgap_mode and implementation == 'copy'

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local_path }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: '0640'
  when: airgap_mode and implementation == 'copy'

- name: Create directory for additional images tarballs
  file:
    path: "{{ rke2_images_tarballs_path }}"
    state: directory
    mode: '0700'
  when: airgap_mode and additional_tarballs is defined

- name: Copy additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_images_tarballs_path }}"
    mode: '0640'
  with_fileglob: "{{ additional_tarballs }}"
  when: airgap_mode and additional_tarballs is defined

- name: Ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ item.path }}"
    state: file
    mode: "{{ item.mode }}"
  with_items:
    - { path: "{{ rke2_artifacts_path }}", mode: '0440' }
    - { path: "{{ rke2_script_path }}", mode: '0700' }
  when: airgap_mode and implementation == 'exists'

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  command: df -P /usr/local
  register: fs_stats

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: /usr/local/bin
  when: fs_stats.stdout_lines[0].split()[1] == '/usr/local'

- name: Check RKE2 version
  command: rke2 --version
  register: rke2_version_output

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "'{{ rke2_version_output.stdout.split()[1] }}' | regex_search('^[0-9]+\.[0-9]+\.[0-9]+$') is not version('<', '{{ rke2_version }}')"
  when: not allow_downgrade

- name: Run RKE2 install script
  command: "{{ rke2_script_path }} --airgap-mode={{ airgap_mode }}"
  environment:
    AIRGAP_MODE: "{{ airgap_mode }}"
  when: airgap_mode

- name: Copy Custom Manifests
  template:
    src: custom_manifests.j2
    dest: "{{ rke2_manifests_path }}/custom.yml"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}/"
  with_fileglob: "{{ rke2_static_pods_path }}/*.yml"

- name: Copy RKE2 environment file
  template:
    src: rke2_env.j2
    dest: "{{ rke2_environment_path }}/rke2.env"
    mode: '0640'
  when: rke2_environment_options is defined


