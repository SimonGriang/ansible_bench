---
- name: Import assertion tasks
  include_tasks: assert.yml

- name: Install MySQL server packages
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Re-execute systemctl daemon

- name: Configure MySQL server settings
  ansible.builtin.template:
    src: server.cnf.j2
    dest: /etc/mysql/my.cnf
  notify:
    - Restart MySQL server

- name: Configure MySQL client settings
  ansible.builtin.lineinfile:
    path: /etc/mysql/client.cnf
    line: 'socket = /var/run/mysqld/mysqld.sock'
    create: yes

- name: Initialize MySQL database on Alpine or Archlinux
  ansible.builtin.command:
    cmd: mysql_install_db --user=mysql --datadir=/var/lib/mysql
  when: ansible_os_family in ['Alpine', 'Archlinux']

- name: Start and enable MySQL service
  ansible.builtin.service:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: yes

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: '0644'

- name: Create databases
  ansible.builtin.mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: mysql_initial_import is not defined

- name: List databases
  ansible.builtin.shell: mysql -e "SHOW DATABASES;"
  register: databases

- name: Import database
  ansible.builtin.import_db:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
  loop: "{{ mysql_initial_import }}"
  when: item.dest not in databases.stdout_lines

- name: Create users
  ansible.builtin.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"
  notify:
    - Restart MySQL server

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


