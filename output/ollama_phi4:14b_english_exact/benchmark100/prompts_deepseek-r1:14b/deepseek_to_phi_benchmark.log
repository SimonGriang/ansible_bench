---
- name: locations | Enable modules
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - libapache2-mod-proxy-html
    - libapache2-mod-proxy
  when: ansible_os_family == 'Debian'
  tags: enable_modules

- name: locations | Enable modules
  zypper:
    name: "{{ item }}"
    state: present
  loop:
    - apache2-mod_proxy_html
    - apache2-mod_proxy
  when: ansible_os_family == 'Suse'
  tags: enable_modules

- name: locations | Configure locations
  template:
    src: location.conf.j2
    dest: "/etc/apache2/mods-available/{{ item.name }}.conf"
  loop: "{{ httpd_locations }}"
  notify: restart apache
  tags: configure_locations


