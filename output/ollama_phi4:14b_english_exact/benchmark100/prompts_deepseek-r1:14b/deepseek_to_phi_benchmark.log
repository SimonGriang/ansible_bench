---
- name: Validate all variables are set correctly
  hosts: localhost
  gather_facts: no
  tasks:
    - name: Check if all variables are correctly configured
      include_tasks: assert.yml

- name: Wait for host to be available
  hosts: all
  gather_facts: no
  tasks:
    - name: Ensure the target host is reachable
      wait_for:
        port: "{{ target_port }}"
        timeout: "{{ port_timeout }}"

- name: Prepare system for bootstrap
  hosts: all
  gather_facts: no
  tasks:
    - name: Test connection to the host
      ansible.builtin.ping:
    - name: Handle connection failures
      fail:
        msg: "The host is not reachable"
      when: ansible_facts is not defined or ansible_facts is failed
    - name: Gather facts about the system
      setup:
    - name: Install raw bootstrap packages
      package:
        name: "{{ bootstrap_packages }}"
        state: present

- name: Ensure system preparation with Ansible modules
  hosts: all
  gather_facts: yes
  tasks:
    - name: Gather system facts
      ansible.builtin.setup:
    - name: Install packages based on OS family
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
      loop: "{{ packages_based_on_os_family }}"
      loop_control:
        loop_var: item


