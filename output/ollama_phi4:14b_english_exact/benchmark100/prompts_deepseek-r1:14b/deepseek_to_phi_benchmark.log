---
- name: lookup bootstrap facts (raw)
  ansible.builtin.command:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  vars:
    ansible_user: "{{ bootstrap_user }}"

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.value.name }}"
    bootstrap_distribution_major_version: "{{ item.value.major_version | default(omit) }}"
  vars:
    bootstrap__os_family_map: "{{ lookup('vars', 'bootstrap__os_family_map', fail=False) }}"
  when:
    - item.value.family in bootstrap_facts.stdout
    - (
        item.value.regex | regex_findall('(?<=VERSION_ID=)\\d+')
      ) | length > 0
  with_dict: "{{ bootstrap__os_family_map }}"
  become: "{{ lookup('vars', 'bootstrap_become', default=false) }}"

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.value.family }}"
  vars:
    bootstrap__os_family_map: "{{ lookup('vars', 'bootstrap__os_family_map', fail=False) }}"
  when:
    - bootstrap_distribution is defined
    - bootstrap_distribution in item.value.names
  with_dict: "{{ bootstrap__os_family_map }}"
  become: "{{ lookup('vars', 'bootstrap_become', default=false) }}"


