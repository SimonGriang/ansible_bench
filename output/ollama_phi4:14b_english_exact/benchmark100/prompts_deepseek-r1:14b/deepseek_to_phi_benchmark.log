---
- name: Create the directory for RKE2 configuration files with proper permissions
  ansible.builtin.file:
    path: /etc/rancher/rke2/
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set node taints for RKE2 server nodes
  community.kubernetes.k8s:
    api_version: k8s.cni.cncf.io/v1
    kind: Node
    name: "{{ inventory_hostname }}"
    namespace: default
    state: present
    definitions:
      metadata:
        labels:
          node-role.kubernetes.io/server: ""
      spec:
        taints:
          - key: node-role.kubernetes.io/server
            value: "true"
            effect: NoSchedule
  when: "'server' in group_names"

- name: Copy the RKE2 configuration file
  ansible.builtin.copy:
    src: "{{ rke2_config_source }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
    owner: root
    group: root
  notify: Restart RKE2

- name: Copy kubelet configuration file
  ansible.builtin.copy:
    src: "{{ kubelet_config_source }}"
    dest: /var/lib/rancher/rke2/data/kubelet/config.yaml
    mode: '0644'
    owner: root
    group: root
  when: rke2_kubelet_config | length > 0
  notify: Restart RKE2

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ containerd_registry_source }}"
    dest: /etc/containerd/registry.conf
    mode: '0644'
    owner: root
    group: root
  when: 
    - custom_registry_mirrors | length > 0
    - custom_registry_config | length > 0
  notify: Restart RKE2

- name: Register etcd restore from file
  ansible.builtin.set_fact:
    etcd_restore_from_file: "{{ lookup('file', etcd_snapshot_file) | length > 0 
                              and not rke2_service_running }}"

- name: Register etcd restore from S3
  ansible.builtin.set_fact:
    etcd_restore_from_s3: "{{ s3_options | length > 0 
                             and s3_bucket | length > 0 
                             and s3_object | length > 0 
                             and not rke2_service_running }}"

- name: Perform an etcd restore from a local file if needed
  block:
    - ansible.builtin.file:
        path: /var/lib/rancher/rke2/server/db/restore
        state: directory
        mode: '0755'
    - ansible.builtin.copy:
        src: "{{ etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/restore/snapshot.db
        mode: '0644'
    - ansible.builtin.command:
        cmd: rke2-restore etcd /var/lib/rancher/rke2/server/db/restore/snapshot.db
  when: etcd_restore_from_file

- name: Perform an etcd restore from an S3 bucket if needed
  block:
    - ansible.builtin.command:
        cmd: >
            rke2-restore etcd s3://{{ s3_bucket }}/{{ s3_object }}
        environment:
          AWS_ACCESS_KEY_ID: "{{ aws_access_key_id }}"
          AWS_SECRET_ACCESS_KEY: "{{ aws_secret_access_key }}"
  when: etcd_restore_from_s3

- name: Start the RKE2 server service and enable it on boot
  ansible.builtin.service:
    name: rke2-server
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Restart RKE2

- name: Disable and mask the RKE2 agent service
  ansible.builtin.systemd:
    name: rke2-agent
    enabled: false
    masked: true

- name: Wait until the first server node reports sufficient resources and readiness when no CNI is configured
  ansible.builtin.wait_for:
    timeout: 600
  when: not cni_configured

- name: Wait until the first server node reports as ready when CNI is configured
  ansible.builtin.wait_for:
    timeout: 600
  when: cni_configured

- name: Perform etcd restoration processes
  block:
    - ansible.builtin.command:
        cmd: rke2-restore etcd cleanup
  when: etcd_restore_from_file or etcd_restore_from_s3

- name: Set a fact to identify the active server node in the cluster
  ansible.builtin.set_fact:
    active_server: "{{ groups['rke2_servers'][0] }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups['rke2_servers'] }}"
  run_once: true


