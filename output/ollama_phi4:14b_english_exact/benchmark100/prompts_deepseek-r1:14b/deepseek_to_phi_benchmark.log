---
- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: /etc/rancher/rke2/manifests
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    src: templates/kube-vip.conf
    dest: /etc/rancher/rke2/config/kube-vip.conf
    owner: root
    group: root
    mode: '0644'

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    src: templates/kube-vip-loadbalancer.yaml
    dest: /etc/rancher/rke2/manifests/kube-vip-loadbalancer.yaml
    owner: root
    group: root
    mode: '0644'
  when: kube_vip.cloud_provider_enabled | default(false)


