---
- name: Check if Java certificates exist
  stat:
    path: "{{ item }}"
  loop: "{{ java_certs }}"
  register: java_cert_status

- name: Fail if Java certificates are missing
  fail:
    msg: "Java certificate missing at path: {{ item.item }}"
  loop: "{{ java_cert_status.results }}"
  when: not item.stat.exists

- name: Set keystore directory for Java versions less than 11
  set_fact:
    java_keystore_dir: "/etc/ssl/java/legacy"
  when: java_version is version('11', '<')

- name: Set keystore directory for Java versions 11 or newer
  set_fact:
    java_keystore_dir: "/etc/ssl/java"
  when: java_version is version('11', '>=')

- name: Import SSL certificates into Java keystore
  shell: |
    keytool -importcert -alias {{ item.alias }} -file {{ item.path }} -keystore {{ java_keystore_dir }}/cacerts -storepass changeit -noprompt
  loop: "{{ ssl_certificates }}"
  args:
    creates: "{{ java_keystore_dir }}/cacerts"


