---
- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.service:
    name: rke2-server
    state: restarted
    force: yes
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  ansible.builtin.command:
    cmd: kubectl get nodes --field-selector=status.phase!=Running
  register: check_nodes
  until: check_nodes.stdout == ""
  retries: 100
  delay: 15
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  run_once: yes
  when: ansible_check_mode == false

- name: Wait for all pods to be ready again
  ansible.builtin.command:
    cmd: kubectl get pods --all-namespaces --field-selector=status.phase!=Running
  register: check_pods
  until: check_pods.stdout == ""
  retries: 100
  delay: 15
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  run_once: yes
  when: ansible_check_mode == false and rke2_wait_for_all_pods_to_be_ready


