      mydestination: '$myhostname, localhost.$mydomain, $mydomain'
      relay_domains: ''
      unknown_local_recipient_reject_code: '550'

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - Validate and restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - Validate and restart postfix

- name: Creates cert/key directory
  file:
    path: /etc/ssl/private
    state: directory
    owner: postfix
    group: postfix
    mode: '0750'

- name: Deploy Postfix TLS server certificate
  copy:
    src: 'files/{{ postfix_tls_cert_file }}'
    dest: /etc/ssl/certs/{{ postfix_tls_cert_file }}
    owner: root
    group: root
    mode: '0644'
  notify:
    - Reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: 'files/{{ postfix_tls_key_file }}'
    dest: /etc/ssl/private/{{ postfix_tls_key_file }}
    owner: root
    group: root
    mode: '0640'
  notify:
    - Reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: '{{ item.line }}'
    state: present
  loop: '{{ postfix_aliases }}'
  notify:
    - Rebuild and reload postfix

- name: Configure sender_access
  lineinfile:
    path: /etc/postfix/sender_access
    line: '{{ item.line }}'
    state: present
  loop: '{{ postfix_sender_access }}'
  notify:
    - Rebuild and reload postfix

- name: Configure recipient_access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: '{{ item.line }}'
    state: present
  loop: '{{ postfix_recipient_access }}'
  notify:
    - Validate, rebuild, and reload postfix

- name: Place sasl_password_map
  copy:
    content: '{{ postfix_sasl_password_map_content }}'
    dest: /etc/postfix/sasl/sasl_password
    owner: postfix
    group: postfix
    mode: '0600'
  notify:
    - Rebuild sasl password map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true


