---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  gather_facts: no

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts handler

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
    - name: Set SELinux state
