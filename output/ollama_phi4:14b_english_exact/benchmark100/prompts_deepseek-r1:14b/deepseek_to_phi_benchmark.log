- name: Generate an OpenSSL private key
  openssl_privatekey:
    path: "{{ key_directory }}/{{ private_key_name }}"
    type: rsa
    size: 2048
  file:
    path: "{{ key_directory }}/{{ private_key_name }}"
    owner: "{{ file_owner }}"
    group: "{{ file_group }}"
    mode: "{{ file_mode }}"

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ csr_directory }}/{{ csr_name }}"
    privatekey_path: "{{ key_directory }}/{{ private_key_name }}"
    common_name: "{{ common_name }}"
  file:
    path: "{{ csr_directory }}/{{ csr_name }}"
    owner: "{{ file_owner }}"
    group: "{{ file_group }}"
    mode: "{{ file_mode }}"

- name: Generate an OpenSSL X.509 certificate
  openssl_certificate:
    path: "{{ certificate_directory }}/{{ certificate_name }}"
    privatekey_path: "{{ key_directory }}/{{ private_key_name }}"
    csr_path: "{{ csr_directory }}/{{ csr_name }}"
  file:
    path: "{{ certificate_directory }}/{{ certificate_name }}"
    owner: "{{ file_owner }}"
    group: "{{ file_group }}"
    mode: "{{ file_mode }}"

- name: Generate a PKCS#12 file
  openssl_pkcs12:
    path: "{{ key_directory }}/{{ p12_name }}"
    privatekey_path: "{{ key_directory }}/{{ private_key_name }}"
    certificate_path: "{{ certificate_directory }}/{{ certificate_name }}"
    friendly_name: "{{ friendly_name }}"
    passphrase: "{{ p12_passphrase }}"
  file:
    path: "{{ key_directory }}/{{ p12_name }}"
    owner: "{{ file_owner }}"
    group: "{{ file_group }}"
    mode: "{{ file_mode }}"

- name: Read private key content
  slurp:
    path: "{{ key_directory }}/{{ private_key_name }}"
  register: private_key_content

- name: Read certificate content
  slurp:
    path: "{{ certificate_directory }}/{{ certificate_name }}"
  register: certificate_content

- name: Create a combined private key and certificate file
  copy:
    dest: "{{ key_directory }}/{{ combined_name }}"
    content: "{{ private_key_content['content'] | b64decode }}\n{{ certificate_content['content'] | b64decode }}"
  file:
    path: "{{ key_directory }}/{{ combined_name }}"
    owner: "{{ file_owner }}"
    group: "{{ file_group }}"
    mode: "{{ file_mode }}"


