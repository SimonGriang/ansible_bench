content='```yaml\n---\n- name: Import assertion file\n  include_tasks: assert.yml\n  when: inventory_hostname == \'localhost\'\n\n- name: Install cron package\n  package:\n    name: "{{ cron_packages }}"\n    state: present\n\n- name: Configure cron shell environment\n  lineinfile:\n    path: /etc/cron.d/crontab\n    regexp: \'^SHELL=\'\n    line: \'SHELL=/bin/bash\'\n    state: present\n\n- name: Configure cron path environment\n  lineinfile:\n    path: /etc/cron.d/crontab\n    regexp: \'^PATH=\'\n    line: \'PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin\'\n    state: present\n\n- name: Configure cron mailto settings\n  lineinfile:\n    path: /etc/cron.d/crontab\n    regexp: \'^MAILTO=\'\n    line: \'MAILTO=root\'\n    state: present\n\n- name: Start and enable cron service\n  service:\n    name: cron\n    state: started\n    enabled: yes\n  when: cron_service is defined\n\n- name: Schedule cron jobs\n  cron:\n    name: "{{ item.name }}"\n    special_time: "{{ item.special_time | default(omit) }}"\n    minute: "{{ item.minute | default(omit) }}"\n    hour: "{{ item.hour | default(omit) }}"\n    day: "{{ item.day | default(omit) }}"\n    month: "{{ item.month | default(omit) }}"\n    weekday: "{{ item.weekday | default(omit) }}"\n    user: "{{ item.user | default(omit) }}"\n    job: "{{ item.job }}"\n  loop: "{{ cron_jobs }}"\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-20T08:25:11.726452671Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5353014027, 'load_duration': 57700652, 'prompt_eval_count': 907, 'prompt_eval_duration': 13781304, 'eval_count': 357, 'eval_duration': 5280018254, 'model_name': 'phi4:14b'} id='run--c0e71804-5b18-4320-ae40-b2688359154e-0' usage_metadata={'input_tokens': 907, 'output_tokens': 357, 'total_tokens': 1264}
