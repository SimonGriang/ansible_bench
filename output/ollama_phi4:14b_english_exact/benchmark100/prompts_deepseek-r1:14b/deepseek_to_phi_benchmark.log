---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: >
    "'connection: container' not in 
    ansible_hostvars[ansible_play_batch[0]]['ansible_connection'] and 
    'docker' not in 
    ansible_hostvars[ansible_play_batch[0]]['ansible_connection'] and 
    'community.docker.docker' not in 
    ansible_hostvars[ansible_play_batch[0]]['ansible_connection']"

- name: Prepare system for bootstrap
  block:
    - name: Test connection
      wait_for_connection:
        timeout: "{{ bootstrap_timeout }}"

    - name: Test sudo version
      command: sudo --version
  rescue:
    - name: Gather facts
      setup:

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_packages }}"
        state: present

- name: Gather ansible facts
  setup:
    delegate_to: localhost

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"


