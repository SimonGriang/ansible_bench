content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  when: inventory_hostname == \'localhost\'\n\n- name: Install required packages\n  package:\n    name: "{{ selinux_requirements }}"\n    state: present\n  notify: Gather facts\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Configure selinux\n  block:\n    - name: Manage SELinux settings\n      selinux:\n        state: "{{ selinux_state }}"\n        policy: "{{ selinux_policy }}"\n      notify: Reboot\n\n    - name: Manage SELinux booleans\n      selinux:\n        policy: "{{ selinux_policy }}"\n        state: "{{ item.state }}"\n        persistent: "{{ item.persistent }}"\n        selinux_boolean: "{{ item.name }}"\n      loop: "{{ selinux_booleans }}"\n      when: selinux_booleans is defined\n  when:\n    - selinux_status is defined\n    - ansible_connection not in [\'container\', \'docker\', \'community.docker.docker\']\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-20T06:56:57.91982781Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3912969706, 'load_duration': 60535429, 'prompt_eval_count': 467, 'prompt_eval_duration': 57506492, 'eval_count': 207, 'eval_duration': 3793640505, 'model_name': 'phi4:14b'} id='run--3ef2e406-0574-4bf2-b136-210c47d7d0e7-0' usage_metadata={'input_tokens': 467, 'output_tokens': 207, 'total_tokens': 674}
