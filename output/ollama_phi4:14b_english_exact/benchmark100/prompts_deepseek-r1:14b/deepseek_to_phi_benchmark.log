---
- name: hardening | Disable swap
  become: true
  block:
    - name: Disable swap immediately
      command: swapoff -a
      when: vault_hardening_disable_swap | bool

    - name: Comment out all swap entries in /etc/fstab
      lineinfile:
        path: /etc/fstab
        regexp: '^\s*([^#].*\s+swap\s+).*$'
        line: '#\1'
        backrefs: yes
      when: vault_hardening_disable_swap | bool

- name: hardening | Disable core dumps
  become: true
  block:
    - name: Set core file limit to 0 in PAM
      pam_limits:
        domain: "{{ item.domain }}"
        limit_type: hard
        item: core
        value: 0
      loop:
        - { domain: '*' }
        - { domain: '@session' }
        - { domain: '@user' }
      when: vault_hardening_disable_core_dumps | bool

    - name: Set soft core file limit to 0 in PAM
      pam_limits:
        domain: "{{ item.domain }}"
        limit_type: soft
        item: core
        value: 0
      loop:
        - { domain: '*' }
        - { domain: '@session' }
        - { domain: '@user' }
      when: vault_hardening_disable_core_dumps | bool

- name: hardening | Disable Shell Command History
  become: true
  block:
    - name: Create /etc/profile.d/vault.sh if it does not exist
      copy:
        dest: /etc/profile.d/vault.sh
        content: |
          export HISTIGNORE="vault*:"

    - name: Disable shell command history for Vault-related commands
      lineinfile:
        path: /etc/profile.d/vault.sh
        line: 'export HISTIGNORE="vault*: vault*:vault*:$HISTIGNORE"'
      when: vault_hardening_disable_shell_command_history | bool

- name: hardening | Configure SELinux / AppArmor
  become: true
  block:
    - name: Ensure SELinux is enabled and in enforcing mode
      selinux:
        policy: targeted
        state: enforcing
      when: vault_hardening_configure_selinux_apparmor | bool

    - name: Install SELinux policies for Vault
      package:
        name: policycoreutils
        state: present
      when: vault_hardening_configure_selinux_apparmor | bool

    - name: Ensure AppArmor is enabled
      service:
        name: apparmor
        state: started
        enabled: true
      when: vault_hardening_configure_selinux_apparmor | bool

    - name: Enforce AppArmor profile for Vault
      copy:
        dest: /etc/apparmor.d/usr.lib.vault
        content: |
          # AppArmor profile for Vault
          /usr/lib/vault {
            # Profile content here
          }
      when: vault_hardening_configure_selinux_apparmor | bool


