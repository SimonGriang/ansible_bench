---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install git
  ansible.builtin.package:
    name: "{{ packages }}"
    state: "{{ state }}"
  vars:
    packages: git
    state: present

- name: Check if user exists
  ansible.builtin.stat:
    path: "/home/{{ user }}"
  register: user_status
  ignore_errors: yes

- name: Create git config directory
  ansible.builtin.file:
    path: "/home/{{ user }}/.gitconfig.d"
    state: directory
    mode: "{{ directory_mode }}"
    owner: "{{ user }}"
    group: "{{ user_group }}"
  vars:
    directory_mode: '0755'
    user_group: "{{ user }}"

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "/home/{{ user }}/.gitconfig"
    mode: "{{ config_mode }}"
    owner: "{{ user }}"
    group: "{{ user_group }}"
  vars:
    config_mode: '0644'

- name: Create repository destination
  ansible.builtin.file:
    path: "{{ repo_destination }}"
    state: directory
    mode: "{{ repo_mode }}"
    owner: "{{ user }}"
    group: "{{ user_group }}"

- name: Clone all repositories
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ repo_destination }}/{{ item.name }}"
    version: "{{ item.version }}"
    accept_hostkey: yes
  loop: "{{ repositories }}"
  vars:
    repositories:
      - name: repo1
        repo: https://github.com/example/repo1.git
        version: main
      - name: repo2
        repo: https://github.com/example/repo2.git
        version: develop
  vars:
    repo_destination: /opt/git_repos
    repo_mode: '0755'


