---
- name: Import assertion tasks from assert.yml and set run_once to true
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install PHP packages specified by the php_packages variable
  package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  shell: php --ini | grep "Loaded Configuration File" | sed 's|Loaded Configuration File: ||'
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  template:
    src: php.ini.j2
    dest: >-
      {{ php_ini_location | default(php_found_ini_location.stdout) }}
    mode: '0644'
  notify: Restart httpd


