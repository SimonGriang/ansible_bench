content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n\n- name: Wait for port to be available\n  wait_for:\n    port: "{{ port }}"\n    timeout: "{{ bootstrap_timeout }}"\n  when: ansible_connection == \'network_cli\' or ansible_connection == \'docker\'\n\n- name: Prepare system\n  block:\n    - name: Test connection\n      ansible.builtin.ping:\n\n    - name: Test sudo access\n      ansible.builtin.command: whoami\n      become: true\n      register: sudo_test\n      failed_when: sudo_test.rc != 0\n\n    - name: Gather facts\n      ansible.builtin.setup:\n\n    - name: Install necessary packages\n      ansible.builtin.raw: "{{ ansible_facts[\'distribution\'] }}-specific-command"\n      when: ansible_facts[\'distribution\'] == \'RedHat\' or ansible_facts[\'distribution\'] == \'CentOS\'\n\n    - name: Install libdnf5 for RedHat systems\n      ansible.builtin.package:\n        name: libdnf5\n        state: present\n      when: ansible_facts[\'distribution\'] == \'RedHat\'\n\n- name: Gather ansible facts\n  ansible.builtin.setup:\n\n- name: Install bootstrap packages\n  ansible.builtin.package:\n    name: "{{ bootstrap_facts_packages }}"\n    state: present\n  become: "{{ bootstrap_become }}"\n```\n\nThis playbook is structured to be included directly within an Ansible Role under the `tasks/` directory, adhering to the task descriptions provided.' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-10T13:44:59.839851474Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5050300603, 'load_duration': 56137266, 'prompt_eval_count': 448, 'prompt_eval_duration': 46636481, 'eval_count': 315, 'eval_duration': 4946309325, 'model_name': 'phi4:14b'} id='run--16b78362-8995-4a54-aa2a-8fcd4aa76013-0' usage_metadata={'input_tokens': 448, 'output_tokens': 315, 'total_tokens': 763}
