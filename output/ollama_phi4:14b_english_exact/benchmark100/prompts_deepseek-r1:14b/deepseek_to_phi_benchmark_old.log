---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "{{ item }}"
  with_nested:
    - "{{ java_jdk_vendor }}"
    - "{{ ansible_distribution }}"
    - "{{ ansible_distribution_version }}"

- name: Gather architecture specific variables
  include_vars:
    file: "architecture_{{ ansible_architecture }}.yml"

- name: Set OS specific variables (I)
  set_fact:
    java_version: "{{ java_version | default('8') }}"
    java_repository: "{{ java_repository | default('default_repo') }}"
    java_libs: "{{ java_libs | default('default_libs') }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_install_path: "{{ java_install_path | default('/usr/lib/jvm') }}"
    java_package_name: "{{ java_package_name | default('default_package') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_install_path }}/java-{{ java_version }}-openjdk-{{ ansible_architecture }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "deprecated_repo"
        state: absent
    - name: Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
      loop:
        - "apt-transport-https"
        - "ca-certificates"
        - "software-properties-common"
    - name: Add key repositories
      apt_key:
        url: "{{ item.url }}"
        state: present
      loop: "{{ java_keys }}"
    - name: Add required repositories
      apt_repository:
        repo: "{{ item }}"
        state: present
      loop: "{{ java_repos }}"
  when: ansible_os_family == "Debian"

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        state: present
        key: "{{ item }}"
      loop: "{{ java_keys }}"
    - name: Add required repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        gpgcheck: "{{ item.gpgcheck | default('1') }}"
      loop: "{{ java_repos }}"
  when: ansible_os_family == "RedHat"

- name: Install required libs
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ java_libs }}"

- name: Install Java, Debian
  apt:
    name: "{{ java_package_name }}"
    state: present
  when: ansible_os_family == "Debian"

- name: Install Java, RedHat
  yum:
    name: "{{ java_package_name }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Export environment variables
  copy:
    dest: "/etc/profile.d/java_env.sh"
    content: |
      export JAVA_HOME={{ java_home }}
      export PATH=$JAVA_HOME/bin:$PATH
    mode: '0644'

- name: Source environment variables
  command: source /etc/profile.d/java_env.sh

- name: Correct java version selected for Java < 11
  alternatives:
    name: java
    path: "{{ java_home }}/jre/bin/java"
  when: java_version|int < 11

- name: Correct java version selected for Java >= 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
  when: java_version|int >= 11


