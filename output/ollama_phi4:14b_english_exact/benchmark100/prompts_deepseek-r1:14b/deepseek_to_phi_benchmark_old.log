---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.command:
    cmd: cat /etc/os-release
  register: os_release_output
  changed_when: false

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    distro_name: >-
      {{ os_release_output.stdout_lines
      | select('match', '^PRETTY_NAME=.*')
      | map('split', '=')
      | map('last')
      | map('trim')
      | list
      | first }}
    distro_major_version: >-
      {{ os_release_output.stdout_lines
      | select('match', '^VERSION_ID=.*')
      | map('split', '=')
      | map('last')
      | map('trim')
      | list
      | first
      | regex_replace('^([0-9]+).*$', '\\1') }}

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    os_family: >-
      {% if distro_name is search('Ubuntu') or
          distro_name is search('Debian') %}
        Debian
      {% elif distro_name is search('Red Hat') or
            distro_name is search('CentOS') or
            distro_name is search('Fedora') %}
        RedHat
      {% elif distro_name is search('SUSE') or
            distro_name is search('openSUSE') %}
        SUSE
      {% elif distro_name is search('Amazon') %}
        Amazon
      {% elif distro_name is search('Oracle') %}
        OracleLinux
      {% else %}
        Other
      {% endif %}


