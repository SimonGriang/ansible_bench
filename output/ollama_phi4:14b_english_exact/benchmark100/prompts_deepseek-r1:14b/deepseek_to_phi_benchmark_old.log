---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Manage automatic service management
  block:
    - name: Disable automatic start of services
      copy:
        dest: /usr/sbin/policy-rc.d
        content: |
          exit 101
        mode: '0755'
      when: package_manager == 'apt' and apt_autostart_state == 'disabled'

    - name: Enable automatic start of services
      file:
        path: /usr/sbin/policy-rc.d
        state: absent
      when: package_manager == 'apt' and apt_autostart_state == 'enabled'


