---
- name: Restart RKE2 service
  ansible.builtin.service:
    name: "{{ rke2_node_name }}"
    state: restarted
    enabled: yes
  notify: "Service (re)started"

- name: Wait for all nodes to be ready again
  ansible.builtin.command:
    cmd: kubectl get nodes --no-headers | awk '$2 == "Ready" { ready+1 } END { exit (NR != ready) }'
  register: nodes_ready
  until: nodes_ready.rc == 0
  retries: 100
  delay: 15
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  when: not ansible_check_mode
  run_once: true

- name: Wait for all pods to be ready again
  ansible.builtin.command:
    cmd: kubectl get pods --all-namespaces --field-selector=status.phase!=Running --no-headers | awk '$2 == "1/1" && $3 == "Running" { not_ready+1 } END { exit (not_ready > 0) }'
  register: pods_ready
  until: pods_ready.rc == 0
  retries: 100
  delay: 15
  delegate_to: "{{ groups[rke2_servers_group_name][0] }}"
  when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready
  run_once: true


