    dest: /etc/kubernetes/kubelet.config.yaml
    owner: root
    group: root
    mode: '0644'
    notify: restart rke2
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: "{{ containerd_registry_config_source }}"
    dest: /etc/containerd/registry.conf
    owner: root
    group: root
    mode: '0644'
    notify: restart rke2
  when: custom_registry_mirrors | length > 0 or custom_registry_configs | length > 0

- name: Register etcd restore from file
  ansible.builtin.set_fact:
    rke2_etcd_restore_from_file: "{{ rke2_etcd_snapshot_file | default(false) and not rke2_service_status.0.status | default('unknown') == 'running' }}"
  when: rke2_etcd_snapshot_file is defined

- name: Register etcd restore from S3
  ansible.builtin.set_fact:
    rke2_etcd_restore_from_s3: "{{ rke2_s3_bucket | default(false) and rke2_s3_access_key | default(false) and rke2_s3_secret_key | default(false) }}"
  when: rke2_s3_bucket is defined and rke2_s3_access_key is defined and rke2_s3_secret_key is defined

- name: Restore etcd from file
  block:
    - name: Ensure etcd snapshot directory exists
      ansible.builtin.file:
        path: /var/lib/rancher/rke2/server/db/snapshots
        state: directory
        mode: '0755'
        owner: root
        group: root

    - name: Copy etcd snapshot file
      ansible.builtin.copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/server/db/snapshots/snapshot.db
        owner: root
        group: root
        mode: '0644'

    - name: Restore etcd from snapshot
      ansible.builtin.command:
        cmd: rke2 server etcd-snapshot-restore /var/lib/rancher/rke2/server/db/snapshots/snapshot.db
  when: rke2_etcd_restore_from_file

- name: Restore etcd from S3
  block:
    - name: Restore etcd from S3 snapshot
      ansible.builtin.command:
        cmd: rke2 server etcd-snapshot-restore https://{{ rke2_s3_bucket }}.s3.amazonaws.com/snapshot.db
  when: rke2_etcd_restore_from_s3

- name: Start RKE2 service
  ansible.builtin.service:
    name: rke2-server
    state: started
    enabled: true
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  notify: restart rke2

- name: Mask RKE2 agent service
  ansible.builtin.systemd:
    name: rke2-agent
    enabled: false
    masked: true

- name: Wait for first server to be ready (no CNI)
  ansible.builtin.wait_for:
    timeout: 600
  when: not rke2_cni_enabled

- name: Wait for first server to be ready (with CNI)
  ansible.builtin.wait_for:
    timeout: 600
  when: rke2_cni_enabled

- name: Restore etcd
  block:
    - name: Cleanup old nodes and secrets
      ansible.builtin.command:
        cmd: rke2 etcd-cleanup

    - name: Restart rke2 service
      ansible.builtin.service:
        name: rke2-server
        state: restarted
  when: rke2_etcd_restore_from_file or rke2_etcd_restore_from_s3

- name: Set Active Server variable
  ansible.builtin.set_fact:
    rke2_active_server: "{{ groups['cluster_servers'] | first }}"
  delegate_to: "{{ groups['cluster_servers'] | first }}"


