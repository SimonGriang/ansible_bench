---
- name: Generate a private SSL key using OpenSSL
  openssl_privatekey:
    path: "{{ ssl_dir }}/private.key"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_key_mode }}"
    size: 2048
  register: private_key

- name: Generate a Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ ssl_dir }}/private.csr"
    privatekey_path: "{{ ssl_dir }}/private.key"
    common_name: "{{ ssl_common_name }}"
    organization: "{{ ssl_organization }}"
    country_name: "{{ ssl_country }}"
    state_or_province_name: "{{ ssl_state }}"
    locality_name: "{{ ssl_locality }}"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_csr_mode }}"
  register: csr

- name: Generate a self-signed SSL certificate
  openssl_certificate:
    path: "{{ ssl_dir }}/selfsigned.crt"
    privatekey_path: "{{ ssl_dir }}/private.key"
    csr_path: "{{ ssl_dir }}/private.csr"
    provider: selfsigned
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_cert_mode }}"
  register: cert

- name: Create a PKCS#12 file
  openssl_pkcs12:
    dest: "{{ ssl_dir }}/cert.pfx"
    privatekey_path: "{{ ssl_dir }}/private.key"
    certificate_path: "{{ ssl_dir }}/selfsigned.crt"
    password: "{{ ssl_pfx_password }}"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_pfx_mode }}"

- name: Read the private key content
  slurp:
    path: "{{ ssl_dir }}/private.key"
  register: private_key_content

- name: Read the certificate content
  slurp:
    path: "{{ ssl_dir }}/selfsigned.crt"
  register: cert_content

- name: Combine private key and certificate into a single file
  copy:
    content: "{{ private_key_content.content | b64decode }}\n{{ cert_content.content | b64decode }}"
    dest: "{{ ssl_dir }}/combined.pem"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_combined_mode }}"


