    mode: '0640'
  loop: "{{ fail2ban_filter_files }}"
  when: fail2ban_filterd_path is defined
  notify: Restart fail2ban handler

- name: Configure fail2ban.local
  lineinfile:
    path: /etc/fail2ban/fail2ban.local
    regexp: '^{{ item.key }}\\s*=\\s*$'
    line: "{{ item.key }} = {{ item.value }}"
    create: yes
  loop: "{{ fail2ban_configuration | combine(fail2ban_base_configuration) | dict2items }}"
  notify: Restart fail2ban handler
  mode: '0640'

- name: Configure jail.local
  lineinfile:
    path: /etc/fail2ban/jail.local
    regexp: '^{{ item.key }}\\s*=\\s*$'
    line: "{{ item.key }} = {{ item.value }}"
    create: yes
  loop: "{{ fail2ban_jail_configuration | combine(fail2ban_base_jail_configuration) | dict2items }}"
