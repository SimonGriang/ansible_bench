---
- name: Import assert.yml
  ansible.builtin.import_playbook: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  ansible.builtin.selinux:
    policy: targeted
    state: enforcing
    boolean:
      - httpd_can_network_connect_port_t
    ports:
      - 80:tcp
      - 443:tcp
    persistent: true
  when: ansible_selinux.status == "enabled"

- name: Configure httpd
  ansible.builtin.template:
    src: httpd.conf.j2
    dest: /etc/httpd/conf/httpd.conf
    mode: '0644'
  notify: 
    - test httpd configuration
    - restart httpd

- name: Activate httpd module | Debian
  ansible.builtin.command:
    cmd: a2enmod {{ item }}
  loop: "{{ httpd_modules }}"
  when: ansible_os_family == "Debian"

- name: Import ssl.yml
  ansible.builtin.import_playbook: ssl.yml
  when: httpd_ssl_enabled == true

- name: Import locations.yml
  ansible.builtin.import_playbook: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  ansible.builtin.import_playbook: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  ansible.builtin.template:
    src: ports.conf.j2
    dest: /etc/apache2/ports.conf
    mode: '0644'
  notify:
    - test httpd configuration
    - restart httpd
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directories.yml
  ansible.builtin.import_playbook: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Removing default html
  ansible.builtin.file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example == true

- name: Start and enable httpd
  ansible.builtin.service:
    name: httpd
    state: started
    enabled: yes


