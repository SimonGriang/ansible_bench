---
- name: Enable Backports repository
  apt_repository:
    repo: 'deb http://deb.debian.org/debian {{ ansible_distribution_release }}-backports main'
    state: present
    filename: 'deb_backports'

- name: Set the default_release option for older Debian versions
  set_fact:
    ansible_distribution_release: "{{ ansible_distribution_release }}-backports"
  when: ansible_distribution_release == 'stretch' or ansible_distribution_release == 'buster'

- name: Install Ansible
  apt:
    name: ansible
    state: present
    default_release: "{{ ansible_distribution_release }}"
    update_cache: yes


