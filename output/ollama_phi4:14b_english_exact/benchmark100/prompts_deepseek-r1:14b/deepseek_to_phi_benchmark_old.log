---
- name: Import assertion tasks
  ansible.builtin.include_tasks: assert.yml

- name: Install MySQL server packages
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Reload systemctl daemon

- name: Configure MySQL server settings
  ansible.builtin.lineinfile:
    path: /etc/mysql/my.cnf
    line: "{{ item.line }}"
    insertafter: "{{ item.insertafter }}"
  with_items: "{{ mysql_server_options }}"
  notify:
    - Restart MySQL server

- name: Configure MySQL client settings
  ansible.builtin.lineinfile:
    path: /etc/mysql/conf.d/client.cnf
    line: "{{ mysql_client_socket_option }}"

- name: Initialize MySQL database
  ansible.builtin.command: mysql_install_db --user=mysql --ldata=/var/lib/mysql
  when: ansible_os_family == "Alpine" or ansible_os_family == "Archlinux"

- name: Start and enable MySQL service
  ansible.builtin.service:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place MySQL configuration file
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: "{{ mysql_config_mode }}"

- name: Create MySQL databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_databases }}"
  when: mysql_initial_import is not defined

- name: List MySQL databases
  ansible.builtin.shell: mysql -u root -p{{ mysql_root_password }} -e "SHOW DATABASES;"
  register: db_list
  changed_when: false

- name: Import MySQL databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: import
    target: "{{ mysql_initial_import }}/{{ item }}.sql"
  when: mysql_initial_import is defined and item not in db_list.stdout_lines
  with_items: "{{ mysql_databases }}"

- name: Create MySQL users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items: "{{ mysql_users }}"
  notify:
    - Restart MySQL server

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


