---
- name: Import assertion tasks from assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install system utilities or packages
  ansible.builtin.package:
    name: "{{ sysctl_requirements }}"
    state: present

- name: Configure sysctl kernel parameters
  ansible.posix.sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    reload: "{{ item.reload | default(false) }}"
  loop: "{{ sysctl_items }}"
  when:
    - sysctl_items is defined
    - not ansible_container


