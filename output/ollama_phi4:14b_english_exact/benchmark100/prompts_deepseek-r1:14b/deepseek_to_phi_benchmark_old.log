---
- name: Import assertion tasks
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install using package
  block:
    - name: Install HashiCorp product on Debian
      ansible.builtin.apt:
        name: hashicorp_product
        state: present

    - name: Install HashiCorp product on RedHat
      ansible.builtin.yum:
        name: hashicorp_product
        state: present

- name: Configure debian
  when: ansible_facts['os_family'] == "Debian"
  block:
    - name: Add HashiCorp GPG key
      ansible.builtin.apt_key:
        url: "https://apt.releases.hashicorp.com/gpg"
        state: present

    - name: Add HashiCorp apt repository
      ansible.builtin.apt_repository:
        repo: "deb https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
        state: present

- name: Install hashicorp product using package
  block:
    - name: Install latest version of HashiCorp product
      ansible.builtin.package:
        name: hashicorp_product
        state: latest

    - name: Install specific version of HashiCorp product
      ansible.builtin.package:
        name: "hashicorp_product-{{ hashicorp_version }}"
        state: present

- name: Install manually
  block:
    - name: Download HashiCorp product archive
      ansible.builtin.get_url:
        url: "https://releases.hashicorp.com/hashicorp_product/{{ hashicorp_version }}/hashicorp_product_{{ hashicorp_version }}_linux_amd64.zip"
        dest: "/tmp/hashicorp_product.zip"

    - name: Extract HashiCorp product archive
      ansible.builtin.unarchive:
        src: "/tmp/hashicorp_product.zip"
        dest: "/opt/hashicorp"
        remote_src: true

    - name: Set permissions for HashiCorp product
      ansible.builtin.file:
        path: "/opt/hashicorp/hashicorp_product"
        mode: '0755'


