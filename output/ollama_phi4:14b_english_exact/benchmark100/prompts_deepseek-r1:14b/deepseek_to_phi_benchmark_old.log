---
- name: Import assertion file
  include_tasks: assert.yml
  tags: always
  hosts: localhost
  gather_facts: no

- name: Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell
  lineinfile:
    path: /etc/crontab
    regexp: '^SHELL='
    line: 'SHELL=/bin/bash'
    state: present
  notify:
    - restart cron

- name: Configure cron path
  lineinfile:
    path: /etc/crontab
    regexp: '^PATH='
    line: 'PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin'
    state: present
  notify:
    - restart cron

- name: Configure cron mailto
  lineinfile:
    path: /etc/crontab
    regexp: '^MAILTO='
    line: 'MAILTO=root'
    state: present
  notify:
    - restart cron

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ''

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    user: "{{ item.user | default(omit) }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"

handlers:
  - name: restart cron
    service:
      name: cron
      state: restarted


