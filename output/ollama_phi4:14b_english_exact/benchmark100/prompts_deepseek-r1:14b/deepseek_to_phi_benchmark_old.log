---
- name: Enable proxy and proxy_http modules in Apache
  become: yes
  block:
    - name: Enable proxy module
      apache2_module:
        name: proxy
        state: present
      when: ansible_os_family in ['Debian', 'Suse']

    - name: Enable proxy_http module
      apache2_module:
        name: proxy_http
        state: present
      when: ansible_os_family in ['Debian', 'Suse']

- name: Configure Apache location settings
  become: yes
  template:
    src: location_template.j2
    dest: "/etc/apache2/sites-available/{{ item.name }}.conf"
  loop: "{{ httpd_locations }}"
  notify:
    - test httpd configuration
    - restart httpd

handlers:
  - name: test httpd configuration
    command: apache2ctl configtest
    notify:
      - restart httpd

  - name: restart httpd
    service:
      name: apache2
      state: restarted


