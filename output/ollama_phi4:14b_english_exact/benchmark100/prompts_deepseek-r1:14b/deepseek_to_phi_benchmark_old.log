---
- name: Restore etcd - get all nodes
  kubernetes.core.k8s_info:
    api_version: v1
    kind: Node
  register: all_nodes

- name: Set fact for node_names
  ansible.builtin.set_fact:
    node_names: >-
      {{ all_nodes.resources | map(attribute='metadata.name') | list }}

- name: Restore etcd - remove old nodes
  kubernetes.core.k8s:
    api_version: v1
    kind: Node
    name: "{{ item }}"
    state: absent
  loop: "{{ node_names | difference(groups[rke2_cluster_group_name]) }}"


