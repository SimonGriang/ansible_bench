content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  tags: \n    - assert\n\n- name: Install DNS packages\n  package:\n    name: "{{ dns_packages }}"\n    state: present\n  tags:\n    - install\n\n- name: Create directories for DNS data and configuration\n  file:\n    path: "{{ item.path }}"\n    state: directory\n    mode: "{{ item.mode }}"\n    owner: "{{ item.owner }}"\n    group: "{{ item.group }}"\n  loop: "{{ directories }}"\n  tags:\n    - directories\n\n- name: Create DNS group\n  group:\n    name: "{{ dns_group }}"\n    state: present\n  tags:\n    - group\n\n- name: Create DNS user\n  user:\n    name: "{{ dns_owner }}"\n    system: yes\n    state: present\n  tags:\n    - user\n\n- name: Generate rndc key\n  command: rndc-confgen -a -r /dev/urandom > /etc/bind/rndc.key\n  args:\n    creates: /etc/bind/rndc.key\n  tags:\n    - rndc_key\n\n- name: Set permissions on rndc key file\n  file:\n    path: /etc/bind/rndc.key\n    owner: bind\n    group: bind\n    mode: \'0600\'\n  tags:\n    - rndc_key_permissions\n\n- name: Get the hints/root file\n  get_url:\n    url: "{{ hints_url }}"\n    dest: /etc/bind/db.root\n    mode: \'0644\'\n  when: dns_caching_dns\n  tags:\n    - hints_file\n\n- name: Create zone files from templates\n  template:\n    src: "{{ item.src }}"\n    dest: "{{ item.dest }}"\n    mode: \'0644\'\n  loop: "{{ zones }}"\n  notify: Rndc reload\n  tags:\n    - zone_files\n\n- name: Add zones to configuration\n  template:\n    src: named.conf.j2\n    dest: /etc/bind/named.conf\n  notify: Restart dns handler\n  tags:\n    - dns_configuration\n\n- name: Place systemd override\n  template:\n    src: systemd-overrides.j2\n    dest: "/etc/systemd/system/bind9.service.d/override.conf"\n  notify: Reload systemd\n  when: using_systemd\n  tags:\n    - systemd_override\n\n- name: Start and enable DNS\n  service:\n    name: bind9\n    state: started\n    enabled: yes\n  tags:\n    - service\n```\n\nThis playbook is designed to be included directly in an Ansible Role under the `tasks/main.yml` directory. It follows the instructions provided, ensuring compliance with Ansible and YAML standards. Each task is tagged appropriately to allow selective execution.' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-10T13:41:40.54317327Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12938673659, 'load_duration': 62061049, 'prompt_eval_count': 582, 'prompt_eval_duration': 388960483, 'eval_count': 577, 'eval_duration': 12486933915, 'model_name': 'phi4:14b'} id='run--a0a555a2-8633-4e77-8121-30926fd4b660-0' usage_metadata={'input_tokens': 582, 'output_tokens': 577, 'total_tokens': 1159}
