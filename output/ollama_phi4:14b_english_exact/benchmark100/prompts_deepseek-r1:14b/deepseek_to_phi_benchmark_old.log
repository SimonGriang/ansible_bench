---
- name: Create local SSH key directory for user
  ansible.builtin.file:
    path: "/home/{{ user }}/.ssh"
    state: directory
    mode: '0750'
    owner: "{{ user }}"
    group: "{{ user }}"
    recurse: yes

- name: Manage user account
  ansible.builtin.user:
    name: "{{ user }}"
    comment: "User account"
    home: "{{ user_home }}"
    shell: "/bin/bash"
    state: present

- name: Set sudo options for user
  ansible.builtin.copy:
    dest: "/etc/sudoers.d/{{ user }}"
    content: "{{ user }} ALL=(ALL) NOPASSWD:ALL"
    mode: '0440'

- name: Generate private SSH key for user
  ansible.builtin.command:
    cmd: "ssh-keygen -t rsa -N '' -f /home/{{ user }}/.ssh/id_rsa"
    creates: "/home/{{ user }}/.ssh/id_rsa"

- name: Generate public SSH key for user
  ansible.builtin.command:
    cmd: "ssh-keygen -y -f /home/{{ user }}/.ssh/id_rsa > /home/{{ user }}/.ssh/id_rsa.pub"
    creates: "/home/{{ user }}/.ssh/id_rsa.pub"

- name: Convert SSH key to ppk format for user
  ansible.builtin.command:
    cmd: "puttygen /home/{{ user }}/.ssh/id_rsa -o /home/{{ user }}/.ssh/id_rsa.ppk -O private"
    creates: "/home/{{ user }}/.ssh/id_rsa.ppk"

- name: Get or set the home directory for user
  ansible.builtin.set_fact:
    user_home: "{{ lookup('vars', 'ansible_user_dir') | default('/home/' + user, true) }}"

- name: Create .ssh directory for user
  ansible.builtin.file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'

- name: Deploy authorized keys for user
  ansible.builtin.copy:
    src: "authorized_keys"
    dest: "{{ user_home }}/.ssh/authorized_keys"
    mode: '0644'

- name: Remove unauthorized keys for user
  ansible.builtin.lineinfile:
    path: "{{ user_home }}/.ssh/authorized_keys"
    state: absent
    regexp: "{{ item }}"
  with_items: "{{ unauthorized_keys }}"

- name: Copy generated private SSH key for user
  ansible.builtin.copy:
    src: "/home/{{ user }}/.ssh/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'

- name: Check users password valid time for user
  ansible.builtin.command:
    cmd: "chage -l {{ user }}"
  register: password_validity

- name: Set users password valid time for user
  ansible.builtin.command:
    cmd: "chage -m 7 -M 90 -W 7 {{ user }}"

- name: Place private key file for user
  ansible.builtin.copy:
    src: "/home/{{ user }}/.ssh/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: '0600'


