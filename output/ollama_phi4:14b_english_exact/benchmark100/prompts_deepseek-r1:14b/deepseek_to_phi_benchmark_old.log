    line: |
      \g<1>[\n      docker-nightly]\n      enabled = {{ "1" if docker_yum_repo_enable_nightly else "0" }}
    backrefs: true

- name: Configure Docker Test repo
  when: docker_add_repo
  lineinfile:
    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
