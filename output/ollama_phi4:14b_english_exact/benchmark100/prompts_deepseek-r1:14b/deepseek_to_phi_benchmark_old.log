---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ansible.builtin.lineinfile:
    path: /etc/mysql/my.cnf
    line: "{{ item.key }} = {{ item.value }}"
  loop: "{{ mysql_configuration_options | dict2items }}"
  notify:
    - Restart mysql server

- name: Configure mysql client
  ansible.builtin.lineinfile:
    path: /etc/mysql/client.cnf
    line: "socket={{ mysql_socket }}"

- name: Initialize mysql
  ansible.builtin.command: mysql_install_db
  when: ansible_distribution in ['Alpine', 'Archlinux']
  changed_when: false

- name: Start and enable mysql
  ansible.builtin.systemd:
    name: mysql
    state: started
    enabled: true

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: '0644'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


