---
- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml
  delegate_to: localhost
  tags:
    - always

- name: Configure apk
  block:
    - name: Update apk cache
      community.general.apk:
        update_cache: true
      changed_when: false

    - name: Upgrade all packages with apk
      community.general.apk:
        upgrade: true
      changed_when: false

- name: Configure apt
  block:
    - name: Hold selected packages
      ansible.builtin.apt:
        name: "{{ item }}"
        state: hold
      loop: "{{ packages_to_hold }}"
      loop_control:
        label: "{{ item }}"

    - name: Upgrade all packages with apt
      ansible.builtin.apt:
        upgrade: dist
        update_cache: true
        cache_valid_time: 3600
      environment:
        DEBIAN_FRONTEND: noninteractive

- name: Update all software (dnf)
  block:
    - name: Exclude specific packages from dnf update
      ansible.builtin.dnf:
        update_cache: true
        upgrade: true
        exclude: "{{ exclude_packages }}"
      become: true

- name: Update all software (pacman)
  block:
    - name: Update pacman cache
      community.general.pacman:
        update_cache: true

    - name: Upgrade all packages with pacman
      community.general.pacman:
        upgrade: true
      become: true

- name: Configure yum
  block:
    - name: Check if OS is CentOS/RHEL 6
      ansible.builtin.setup:
      register: ansible_facts

    - name: Update all software with dnf on CentOS/RHEL 6
      ansible.builtin.dnf:
        update_cache: true
        upgrade: true
      when: ansible_facts['distribution_major_version'] == '6'
      become: true

    - name: Install yum-utils if not CentOS/RHEL 6
      ansible.builtin.yum:
        name: yum-utils
        state: present
      when: ansible_facts['distribution_major_version'] != '6'
      become: true

    - name: Upgrade all packages with yum if not CentOS/RHEL 6
      ansible.builtin.yum:
        update_cache: true
        upgrade: true
      when: ansible_facts['distribution_major_version'] != '6'
      become: true

- name: Update all software (zypper)
  block:
    - name: Upgrade all packages with zypper
      community.general.zypper:
        refresh: true
        update: true
      become: true


