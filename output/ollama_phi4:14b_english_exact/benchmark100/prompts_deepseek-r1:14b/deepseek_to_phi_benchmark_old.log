- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.stat:
    path: /etc/os-release
  register: os_release_stat

- name: gather_facts | Read OS release information
  ansible.builtin.shell: cat /etc/os-release
  register: os_release_info
  when: os_release_stat.stat.exists
  changed_when: false

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    distribution: >-
      {{ os_release_info.stdout | regex_search(
        '^(NAME\\s*=\\s*\"?)(.*?)(\"?)$', '\\2'
      ) }}
    version_id: >-
      {{ os_release_info.stdout | regex_search(
        '^(VERSION_ID\\s*=\\s*\"?)([0-9]+)(\"?)$', '\\2'
      ) }}
  when: os_release_info is defined

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    os_family: >-
      {{ 'Debian' if distribution in ['Debian', 'Ubuntu'] else
         'RedHat' if distribution in ['RedHat', 'CentOS', 'Fedora'] else
         'Suse' if distribution in ['openSUSE', 'SLES'] else 'Other' }}


