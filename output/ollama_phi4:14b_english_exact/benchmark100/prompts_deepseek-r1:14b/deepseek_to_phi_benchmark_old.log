    name: "{{ username }}"
  register: user_info
  vars:
    username: "{{ user_name }}"

- name: Create git config directory
  ansible.builtin.file:
    path: "{{ user_home }}/.gitconfig.d"
    state: directory
    mode: '0755'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"
  vars:
    user_home: "/home/{{ user_name }}"
    user_group: "{{ user_group }}"

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "{{ user_home }}/.gitconfig"
    mode: '0644'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Create repository destination
  ansible.builtin.file:
    path: "{{ repo_base_path }}"
    state: directory
    mode: '0755'
    owner: "{{ user_name }}"
    group: "{{ user_group }}"

- name: Clone all repositories
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ repo_base_path }}/{{ item.name }}"
    version: "{{ item.version }}"
    update: yes
  loop: "{{ repositories }}"
  vars:
    repo_base_path: "/home/{{ user_name }}/repos"


