content='```yaml\n---\n- name: Check if Java certificates exist\n  stat:\n    path: "{{ item }}"\n  register: java_certificates\n  with_items: "{{ java_certs }}"\n\n- name: Fail if Java certificates are missing\n  fail:\n    msg: "Java certificate missing at path: {{ item.path }}"\n  when: item.stat.exists == false\n  with_items: "{{ java_certificates.results }}"\n\n- name: Set keystore directory for Java versions less than 11\n  set_fact:\n    java_keystore_dir: "/usr/lib/jvm/java-legacy/jre/lib/security"\n  when: java_version is version(\'11\', \'<\')\n\n- name: Set keystore directory for Java versions 11 or newer\n  set_fact:\n    java_keystore_dir: "/usr/lib/jvm/java-11-or-newer/jre/lib/security"\n  when: java_version is version(\'11\', \'>=\')\n\n- name: Import SSL certificates into Java keystore\n  shell: |\n    keytool -importcert -file {{ item.file }} -alias {{ item.alias }} -keystore {{ java_keystore_dir }}/cacerts -storepass changeit\n  args:\n    creates: "{{ java_keystore_dir }}/cacerts"\n  with_items: "{{ ssl_certificates }}"\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-10T14:35:50.69820614Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3635200275, 'load_duration': 65914770, 'prompt_eval_count': 463, 'prompt_eval_duration': 51227653, 'eval_count': 266, 'eval_duration': 3517015479, 'model_name': 'phi4:14b'} id='run--ad29c283-30b4-435b-b623-0bc78d7e4016-0' usage_metadata={'input_tokens': 463, 'output_tokens': 266, 'total_tokens': 729}
