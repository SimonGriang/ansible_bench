---
- name: Generate an OpenSSL private key
  openssl_privatekey:
    path: "{{ key_directory }}/{{ private_key_file }}"
    size: 2048
    state: present
  file:
    path: "{{ key_directory }}/{{ private_key_file }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"
    mode: "{{ key_mode }}"
    state: file

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ csr_directory }}/{{ csr_file }}"
    privatekey_path: "{{ key_directory }}/{{ private_key_file }}"
    common_name: "{{ common_name }}"
    country_name: "{{ country_name }}"
    state_or_province_name: "{{ state_or_province_name }}"
    locality_name: "{{ locality_name }}"
    organization_name: "{{ organization_name }}"
    organizational_unit_name: "{{ organizational_unit_name }}"
    email_address: "{{ email_address }}"
    subject_alt_name: "{{ subject_alt_name }}"
    passphrase: "{{ passphrase }}"
  file:
    path: "{{ csr_directory }}/{{ csr_file }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"
    mode: "{{ key_mode }}"
    state: file

- name: Generate an OpenSSL X.509 certificate
  openssl_certificate:
    path: "{{ cert_directory }}/{{ certificate_file }}"
    privatekey_path: "{{ key_directory }}/{{ private_key_file }}"
    csr_path: "{{ csr_directory }}/{{ csr_file }}"
    provider: selfsigned
  file:
    path: "{{ cert_directory }}/{{ certificate_file }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"
    mode: "{{ key_mode }}"
    state: file

- name: Generate a PKCS#12 file
  openssl_pkcs12:
    path: "{{ key_directory }}/{{ pkcs12_file }}"
    privatekey_path: "{{ key_directory }}/{{ private_key_file }}"
    certificate_path: "{{ cert_directory }}/{{ certificate_file }}"
    friendly_name: "{{ friendly_name }}"
    passphrase: "{{ passphrase }}"
  file:
    path: "{{ key_directory }}/{{ pkcs12_file }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"
    mode: "{{ key_mode }}"
    state: file

- name: Read private key content
  slurp:
    path: "{{ key_directory }}/{{ private_key_file }}"
  register: private_key_content

- name: Read certificate content
  slurp:
    path: "{{ cert_directory }}/{{ certificate_file }}"
  register: certificate_content

- name: Create a combined private key and certificate file
  copy:
    content: >-
      {{ private_key_content['content'] | b64decode | string }}
      {{ certificate_content['content'] | b64decode | string }}
    dest: "{{ key_directory }}/{{ combined_key_cert_file }}"
  file:
    path: "{{ key_directory }}/{{ combined_key_cert_file }}"
    owner: "{{ key_owner }}"
    group: "{{ key_group }}"
    mode: "{{ key_mode }}"
    state: file


