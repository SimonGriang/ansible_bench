---
- name: Import assertion file
  import_tasks: assert.yml
  when: ansible_play_hosts_all | map('extract', hostvars) | list | length == 1
  tags: assertion

- name: Install system requirements
  package:
    name: bash
    state: present

- name: Install OpenJDK Java
  package:
    name: "java-{{ java_vendor }}"
    state: present
  when: java_vendor == "openjdk"

- name: Install Oracle Java RPM from local
  package:
    name: /path/to/oracle-java-{{ java_version }}-rpm
    state: present
  when: java_source == "local" and java_format == "rpm"
  copy:
    src: /local/path/to/oracle-java-{{ java_version }}-rpm
    dest: /tmp/oracle-java-{{ java_version }}-rpm
    mode: '0644'

- name: Install Oracle Java DEB from local
  package:
    name: /path/to/oracle-java-{{ java_version }}-deb
    state: present
  when: java_source == "local" and java_format == "deb"
  copy:
    src: /local/path/to/oracle-java-{{ java_version }}-deb
    dest: /tmp/oracle-java-{{ java_version }}-deb
    mode: '0644'

- name: Install Oracle Java RPM from repository
  package:
    name: "oracle-java-{{ java_version }}-rpm"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Java targz installation
  unarchive:
    src: /path/to/oracle-java-{{ java_version }}-targz.tar.gz
    dest: /usr/lib/jvm
    remote_src: yes
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java JCE policy
  package:
    name: "java-{{ java_version }}-oracle-jce"
    state: present
  when: java_jce | default(false) and java_version == "8" and java_vendor == "oracle"

- name: Set Java alternative
  alternatives:
    name: java
    path: /usr/lib/jvm/oracle-java-{{ java_version }}/bin/java
    link: /usr/bin/java
    state: present
  when: java_format == "targz" and ansible_facts['os_family'] != "Alpine"

- name: Find Java home directory
  command: readlink -f /usr/bin/java
  register: java_home_path
  changed_when: false

- name: Set JAVA_HOME in environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME={{ java_home_path.stdout }}'
    create: yes


