_group }}"\n    mode: "{{ key_mode }}"\n    state: file\n\n- name: Read private key content\n  slurp:\n    path: "{{ key_directory }}/{{ private_key_file }}"\n  register: private_key_content\n\n- name: Read certificate content\n  slurp:\n    path: "{{ cert_directory }}/{{ certificate_file }}"\n  register: certificate_content\n\n- name: Create a combined private key and certificate file\n  copy:\n    content: "{{ private_key_content[\'content\'] | b64decode }}\\n{{ certificate_content[\'content\'] | b64decode }}"\n    dest: "{{ key_directory }}/{{ combined_key_cert_file }}"\n  file:\n    path: "{{ key_directory }}/{{ combined_key_cert_file }}"\n    owner: "{{ key_owner }}"\n    group: "{{ key_group }}"\n    mode: "{{ key_mode }}"\n    state: file\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-10T14:19:00.561089296Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15257060141, 'load_duration': 67397430, 'prompt_eval_count': 597, 'prompt_eval_duration': 367644033, 'eval_count': 612, 'eval_duration': 14821319795, 'model_name': 'phi4:14b'} id='run--7c2516c5-9529-4cff-b0a3-364c63a95051-0' usage_metadata={'input_tokens': 597, 'output_tokens': 612, 'total_tokens': 1209}
