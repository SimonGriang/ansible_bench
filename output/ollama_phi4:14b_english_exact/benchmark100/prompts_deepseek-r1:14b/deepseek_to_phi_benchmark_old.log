---
- name: Enable required Apache modules (proxy and proxy_http) for Debian and Suse-based systems
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - libapache2-mod-proxy-html
    - libapache2-mod-proxy
    - libapache2-mod-proxy-http
  when: ansible_os_family == 'Debian'

- name: Enable required Apache modules (proxy and proxy_http) for Debian and Suse-based systems
  zypper:
    name: "{{ item }}"
    state: present
  loop:
    - apache2-mod_proxy
    - apache2-mod_proxy_http
  when: ansible_os_family == 'Suse'

- name: Configure Apache location configurations using a template file
  template:
    src: location.conf.j2
    dest: /etc/apache2/sites-available/{{ item.location_name }}.conf
  loop: "{{ httpd_locations }}"
  notify: Restart Apache

- name: Ensure Apache is enabled and running
  service:
    name: apache2
    enabled: yes
    state: started


