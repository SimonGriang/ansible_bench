---
- name: Install unzip package
  ansible.builtin.package:
    name: unzip
    state: present

- name: Create system group for promtail
  ansible.builtin.group:
    name: promtail
    state: present
    system: true
    gid: 999

- name: Create system user for promtail
  ansible.builtin.user:
    name: promtail
    group: promtail
    groups: adm
    shell: /sbin/nologin
    create_home: false
    system: true
    uid: 999

- name: Ensure /usr/local/bin directory exists
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    mode: '0755'

- name: Create config directories
  ansible.builtin.file:
    path: /etc/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: '0750'

- name: Create application directories
  ansible.builtin.file:
    path: /var/log/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: '0750'

- name: Check promtail binary existence
  ansible.builtin.stat:
    path: /usr/local/bin/promtail
  register: promtail_binary_check

- name: Download promtail binaries
  ansible.builtin.get_url:
    url: "https://github.com/grafana/promtail/releases/download/v{{ promtail_version }}/promtail-linux-amd64.zip"
    dest: /tmp/promtail.zip
    checksum: "sha256:{{ promtail_checksum }}"

- name: Propagate local promtail binaries
  ansible.builtin.copy:
    src: /path/to/local/promtail
    dest: /tmp/promtail
    mode: '0755'

- name: Download promtail binaries for controller node
  ansible.builtin.get_url:
    url: "https://github.com/grafana/promtail/releases/download/v{{ promtail_version }}/promtail-linux-amd64.zip"
    dest: /tmp/promtail.zip
    checksum: "sha256:{{ promtail_checksum }}"
  when: inventory_hostname == groups['controller'][0]

- name: Propagate promtail binaries
  ansible.builtin.copy:
    src: /tmp/promtail
    dest: /usr/local/bin/
    mode: '0755'
  when: inventory_hostname != groups['controller'][0]

- name: Unpack promtail binaries
  ansible.builtin.unarchive:
    src: /tmp/promtail.zip
    dest: /tmp
    remote_src: yes

- name: Create symlink to latest promtail version
  ansible.builtin.file:
    src: /tmp/promtail-linux-amd64
    dest: /usr/local/bin/promtail
    state: link
  notify: Restart promtail

- name: Write promtail config file
  ansible.builtin.template:
    src: promtail.conf.j2
    dest: /etc/promtail/promtail.conf
    owner: promtail
    group: promtail
    mode: '0640'

- name: Create systemd service unit
  ansible.builtin.template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: Restart promtail



