---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Pre-configure debian systems
  block:
    - name: Configure debconf settings for postfix
      debconf:
        name: postfix
        question: "{{ item.question }}"
        value: "{{ item.value }}"
        vtype: "{{ item.vtype }}"
      loop:
        - { question: 'postfix/compatibility_level', value: '2', vtype: 'select' }
        - { question: 'postfix/main_mailer_type', value: 'Internet Site', vtype: 'select' }
      when: ansible_os_family == 'Debian'

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps == 'mysql:/etc/postfix/mysql-virtual-mailbox-maps.cf' or postfix_virtual_alias_maps == 'mysql:/etc/postfix/mysql-virtual-alias-maps.cf'

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
  notify:
    - Validate and rebuild transport database
    - Reload postfix

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - Validate and reload postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    main_cf_recipient_access: |
      smtpd_recipient_restrictions =
        permit_mynetworks,
        permit_sasl_authenticated,
        reject_unauth_destination
    main_cf_sender_access: |
      smtpd_sender_restrictions =
        permit_mynetworks,
        permit_sasl_authenticated,
        reject_non_fqdn_sender,
        reject_unknown_sender_domain

- name: Setting values for main.cf (2/2)
  set_fact:
    main_cf_mynetworks: '127.0.0.0/8 [::1]/128'
    main_cf_mydestination: 'localhost.$mydomain, $myhostname'
    main_cf_relay_domains: 'hash:/etc/postfix/relay-domains'

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - Validate and restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - Validate and restart postfix

- name: Creates cert/key directory
  file:
    path: /etc/postfix/tls
    state: directory
    mode: '0700'

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_cert_src }}"
    dest: /etc/postfix/tls/server.crt
  notify:
    - Reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_key_src }}"
    dest: /etc/postfix/tls/server.key
  notify:
    - Reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: "{{ item }}"
  loop: "{{ postfix_aliases }}"
  notify:
    - Rebuild and reload postfix

- name: Configure sender_access
  lineinfile:
    path: /etc/postfix/sender_access
    line: "{{ item }}"
  loop: "{{ postfix_sender_access }}"
  notify:
    - Rebuild and reload postfix

- name: Configure recipient_access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: "{{ item }}"
  loop: "{{ postfix_recipient_access }}"
  notify:
    - Validate, rebuild, and reload postfix

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map_content }}"
    dest: /etc/postfix/sasl_passwd
  notify:
    - Rebuild sasl password map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes


