content='```yaml\n---\n- name: Check if EFI firmware exists on the system\n  stat:\n    path: /sys/firmware/efi/efivars/\n  register: efi_exists\n\n- name: Remove GRUB configuration file on EFI systems\n  file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: efi_exists.stat.exists\n\n- name: Install custom user template for GRUB\n  copy:\n    src: 01_users.j2\n    dest: /etc/grub.d/01_users\n    mode: \'0644\'\n\n- name: Add EFI password protection to GRUB\n  lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: "set superusers=\\"admin\\"\\npassword_pbkdf2 admin {{ grub2_efi_password | password_hash(\'sha512\', 4096) }}"\n    insertafter: EOF\n  when: efi_exists.stat.exists\n\n- name: Add MBR password protection to GRUB\n  lineinfile:\n    path: /etc/grub2.cfg\n    line: "set superusers=\\"admin\\"\\npassword_pbkdf2 admin {{ grub2_mbr_password | password_hash(\'sha512\', 4096) }}"\n    insertafter: EOF\n  when: not efi_exists.stat.exists\n\n- name: Add unrestricted access to GRUB password entries\n  lineinfile:\n    path: "{{ item }}"\n    line: "set superusers=\\"admin\\"\\npassword_pbkdf2 admin {{ grub_password | password_hash(\'sha512\', 4096) }} --unrestricted"\n    insertafter: EOF\n  with_items:\n    - /etc/grub2-efi.cfg\n    - /etc/grub2.cfg\n  when: grub_unrestricted_enabled | bool\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-10T13:43:29.5457325Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8247593207, 'load_duration': 52972969, 'prompt_eval_count': 473, 'prompt_eval_duration': 65165865, 'eval_count': 380, 'eval_duration': 8128253499, 'model_name': 'phi4:14b'} id='run--2c53bc64-d3b4-4294-9389-6fdf282300a4-0' usage_metadata={'input_tokens': 473, 'output_tokens': 380, 'total_tokens': 853}
