---
- name: Download RKE2 installation script
  ansible.builtin.get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0700'
  when: not airgap_mode

- name: Copy local RKE2 installation script
  ansible.builtin.copy:
    src: "{{ local_rke2_install_script }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0700'
  when: airgap_mode and implementation == 'copy'

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
    mode: '0700'
  when: airgap_mode and implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download from remote URL
      ansible.builtin.get_url:
        url: "{{ item.url }}"
        dest: "{{ item.dest }}"
        checksum: "{{ item.checksum }}"
      loop: "{{ rke2_checksums_and_artifacts }}"
      register: remote_download
      until: remote_download is succeeded
      retries: 3
      delay: 10

    - name: Fallback to local download
      ansible.builtin.get_url:
        url: "{{ local_rke2_urls[item.dest] }}"
        dest: "{{ item.dest }}"
      loop: "{{ rke2_checksums_and_artifacts }}"
      when: remote_download is failed

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "{{ local_rke2_artifact_source }}"
    dest: "{{ rke2_artifact_dest }}"
    mode: '0640'
  when: airgap_mode and implementation == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Create directory for additional images tarballs
      ansible.builtin.file:
        path: "{{ rke2_additional_images_dir }}"
        state: directory
        mode: '0700'

    - name: Copy additional images tarballs
      ansible.builtin.copy:
        src: "{{ additional_images_tarball }}"
        dest: "{{ rke2_additional_images_dir }}/"
      when: additional_images_tarball is defined
  when: airgap_mode

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure RKE2 artifacts exist and are read-only
      ansible.builtin.file:
        path: "{{ rke2_artifacts_dir }}/"
        state: directory
        mode: '0440'

    - name: Ensure RKE2 install script is executable
      ansible.builtin.file:
        path: "{{ rke2_install_script_dest }}"
        mode: '0750'
  when: airgap_mode and implementation == 'exists'

- name: Populate service facts
  ansible.builtin.setup:

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local
  register: usrlocal_stats

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ '/usr/local/bin' if usrlocal_stats.stat.isdir is defined and usrlocal_stats.stat.isdir and usrlocal_stats.stat.pw_uid == 0 else '/usr/bin' }}"

- name: Check RKE2 version
  command: rke2 --version
  register: rke2_version_output

- name: Parse RKE2 version
  set_fact:
    installed_version: "{{ rke2_version_output.stdout_lines[0].split(' ')[2] }}"
    running_version: "{{ rke2_running_version.stdout_lines[0].split(' ')[2] }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - installed_version is version(running_version, '>=') or allow_downgrade | default(false)
    fail_msg: "Downgrade of RKE2 from {{ installed_version }} to {{ running_version }} is not allowed."

- name: Run RKE2 install script
  ansible.builtin.command: "./{{ rke2_install_script_dest }}"
  environment:
    AIRGAP_MODE: "{{ '1' if airgap_mode else '0' }}"
  when: ansible_os_family == 'RedHat'

- name: Copy Custom Manifests
  ansible.builtin.template:
    src: "{{ custom_manifests_src }}"
    dest: "{{ rke2_manifests_dir }}/"
    mode: '0644'

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ static_pods_src }}"
    dest: "{{ rke2_agent_pod_manifests_dir }}/"
    mode: '0644'

- name: Copy RKE2 environment file
  ansible.builtin.template:
    src: "{{ rke2_env_file_src }}"
    dest: "{{ rke2_env_file_dest }}.tmp"
    mode: '0644'
  when: rke2_env_options is defined
  notify:
    - Rename RKE2 environment file


