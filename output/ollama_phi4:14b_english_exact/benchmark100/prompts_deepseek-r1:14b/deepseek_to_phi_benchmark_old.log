---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: not ansible_connection in ['container', 'docker', 'community.docker.docker']

- name: Prepare system for bootstrap
  block:
    - name: Test connection
      ansible.builtin.ping:
        timeout: "{{ bootstrap_timeout }}"

    - name: Test sudo version
      ansible.builtin.command:
        cmd: sudo --version
  rescue:
    - name: Gather facts
      ansible.builtin.setup:

    - name: Install bootstrap packages
      ansible.builtin.package:
        name: "{{ bootstrap_packages }}"
        state: present
      become: "{{ bootstrap_become }}"

- name: Gather ansible facts
  setup:
    gather_subset: '!all,!any,!min'
    delegate_to: localhost

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"


