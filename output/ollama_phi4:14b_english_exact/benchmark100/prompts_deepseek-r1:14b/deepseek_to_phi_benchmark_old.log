---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install fail2ban
  package:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Copy filters in filter.d
  copy:
    src: "{{ item }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: '0640'
  loop: "{{ fail2ban_filter_files }}"
  when: fail2ban_filterd_path is defined
  notify: Restart fail2ban handler

- name: Configure fail2ban.local
  lineinfile:
    path: /etc/fail2ban/fail2ban.local
    regexp: '^{{ item.key }}\s*='
    line: "{{ item.key }} = {{ item.value }}"
    create: yes
  loop: "{{ fail2ban_configuration | combine(fail2ban_base_configuration) | dict2items }}"
  notify: Restart fail2ban handler
  mode: '0640'

- name: Configure jail.local
  lineinfile:
    path: /etc/fail2ban/jail.local
    regexp: '^{{ item.key }}\s*='
    line: "{{ item.key }} = {{ item.value }}"
    create: yes
  loop: "{{ fail2ban_jail_configuration | combine(fail2ban_base_jail_configuration) | dict2items }}"
  notify: Restart fail2ban handler
  mode: '0640'

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    mode: '0640'
  when: not fail2ban_auth.stat.exists

- name: Start and enable fail2ban
  service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: yes


