---
- name: Import assertion tasks from assert.yml to validate logrotate setup
  include_tasks: assert.yml

- name: Install logrotate package
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  template:
    src: logrotate_config_file.j2
    dest: "{{ logrotate_config_directory }}"

- name: Generate logrotate.d files
  template:
    src: "{{ item.template }}"
    dest: "{{ logrotate_config_directory }}/{{ item.name }}"
  loop: "{{ logrotate_entries }}"
  when: not item.absent

- name: Remove logrotate.d files
  file:
    path: "{{ logrotate_config_directory }}/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  when: item.absent

- name: Start and enable the logrotate service
  systemd:
    name: "{{ logrotate_service }}"
    state: "{{ service_state }}"
    enabled: "{{ service_enabled }}"
  when: logrotate_service is defined


