  gather_facts: false
  tasks:
    - name: Ensure The Target Host Is Reachable
      wait_for:
        host: "{{ target_host }}"
        port: "{{ target_port }}"
        timeout: "{{ wait_timeout | default(5) }}"

- name: Prepare System For Bootstrap
  gather_facts: false
  tasks:
    - name: Test Connection To The Host
      ping:

    - name: Handle Connection Failure
      fail:
        msg: "Failed to connect to the host"

    - name: Gather Facts About The Host
      setup:

    - name: Install Raw Bootstrap Packages
      raw: "apt-get install -y {{ bootstrap_packages | default('') }}"

