---
- name: Validate all variables are set correctly
  hosts: localhost
  gather_facts: no
  tasks:
    - name: Import assert.yml file
      include_tasks: assert.yml

- name: Wait for host to be available
  hosts: all
  gather_facts: no
  tasks:
    - name: Ensure the target host is reachable
      wait_for:
        host: "{{ target_host }}"
        port: "{{ target_port }}"
        timeout: "{{ wait_timeout }}"

- name: Prepare system for bootstrap
  hosts: all
  gather_facts: no
  tasks:
    - name: Test connection to the host
      ping:

    - name: Handle connection failure
      fail:
        msg: "Failed to connect to the host"

    - name: Gather facts about the host
      setup:

    - name: Install raw bootstrap packages
      raw: "apt-get install -y {{ bootstrap_packages }}"

- name: Ensure system preparation with Ansible modules
  hosts: all
  gather_facts: no
  tasks:
    - name: Gather facts using Ansible modules
      setup:

    - name: Install packages based on detected OS family
      package:
        name: "{{ package_list }}"
        state: present
      when: ansible_os_family == "Debian"

    - name: Ensure system is fully prepared
      block:
        - name: Check OS family
          debug:
            msg: "OS family is {{ ansible_os_family }}"
      always:
        - name: Final preparation step
          debug:
            msg: "System preparation complete"


