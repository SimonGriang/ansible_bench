---
- name: Disable swap
  ansible.builtin.command: swapoff -a
  when: vault_hardening_disable_swap
  notify: update-fstab
  tags:
    - hardening
    - swap

- name: Comment out swap in /etc/fstab
  ansible.builtin.lineinfile:
    path: /etc/fstab
    regexp: '^.*swap.*$'
    line: '#\0'
    backup: yes
  when: vault_hardening_disable_swap
  tags:
    - hardening
    - swap

- name: Prevent core dumps
  ansible.builtin.pam_limits:
    domain: '*'
    limit_type: 'hard'
    item: 'core'
    value: '0'
  when: vault_hardening_disable_core_dumps
  tags:
    - hardening
    - core_dumps

- name: Prevent core dumps (soft limit)
  ansible.builtin.pam_limits:
    domain: '*'
    limit_type: 'soft'
    item: 'core'
    value: '0'
  when: vault_hardening_disable_core_dumps
  tags:
    - hardening
    - core_dumps

- name: Disable shell command history for Vault
  ansible.builtin.lineinfile:
    path: /etc/profile.d/vault.sh
    line: 'export HISTIGNORE="vault:*"'
    create: yes
  when: vault_hardening_disable_shell_command_history
  tags:
    - hardening
    - shell_command_history

- name: Configure SELinux and AppArmor
  block:
    - name: Enable SELinux
      ansible.builtin.command: setenforce 1
      when: vault_hardening_configure_selinux_apparmor

    - name: Install SELinux policy packages
      ansible.builtin.yum:
        name: policycoreutils-python-utils
        state: present
      when: vault_hardening_configure_selinux_apparmor

    - name: Enforce AppArmor profile for Vault
      ansible.builtin.command: aa-enforce /etc/apparmor.d/usr.lib.vault.vault
      when: vault_hardening_configure_selinux_apparmor
  tags:
    - hardening
    - selinux_apparmor

handlers:
  - name: update-fstab
    ansible.builtin.command: sed -i '/swap/d' /etc/fstab


