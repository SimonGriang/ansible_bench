---
- name: Import assertion file
  import_tasks: assert.yml
  when: ansible_hostname == "localhost"

- name: Install cron package
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  lineinfile:
    path: /etc/crontab
    regexp: '^SHELL='
    line: 'SHELL=/bin/bash'
    create: yes

- name: Configure cron path environment
  lineinfile:
    path: /etc/crontab
    regexp: '^PATH='
    line: 'PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin'
    create: yes

- name: Configure cron mailto settings
  lineinfile:
    path: /etc/crontab
    regexp: '^MAILTO='
    line: 'MAILTO=root'
    create: yes

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"


