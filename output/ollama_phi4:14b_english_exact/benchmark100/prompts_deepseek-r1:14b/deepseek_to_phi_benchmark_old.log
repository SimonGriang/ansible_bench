---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
  register: externally_managed_file_py311

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  command: mv /usr/lib/python3.11/EXTERNALLY-MANAGED /usr/lib/python3.11/EXTERNALLY-MANAGED.old
  when: externally_managed_file_py311.stat.exists
  creates: /usr/lib/python3.11/EXTERNALLY-MANAGED.old

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
  register: externally_managed_file_py312

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  command: mv /usr/lib/python3.12/EXTERNALLY-MANAGED /usr/lib/python3.12/EXTERNALLY-MANAGED.old
  when: externally_managed_file_py312.stat.exists
  creates: /usr/lib/python3.12/EXTERNALLY-MANAGED.old

- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"

- name: Configure pip proxy
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: index-url
    value: "{{ python_pip_proxy }}"
  when: python_pip_proxy is defined

- name: Trust hosts
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
  when:
    - python_pip_update is defined and python_pip_update
    - ansible_distribution not in ['Bookworm', 'Noble']
    - ansible_facts['os_family'] != 'Alpine'

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when:
    - ansible_distribution not in ['Bookworm', 'Noble']
    - ansible_facts['os_family'] != 'Alpine'


