---
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_facts.init_system == 'systemd'
    fail_msg: "The init system is not systemd. Please ensure systemd is being used."
    success_msg: "Systemd is the init system."

- name: Get latest release and set promtail version
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    headers:
      Accept: application/vnd.github.v3+json
    return_content: yes
  register: latest_release

- name: Set promtail_version variable
  set_fact:
    promtail_version: "{{ latest_release.json.tag_name }}"

- name: Test if zip local archive exists and assert local binary exists
  stat:
    path: "{{ local_directory }}/promtail.zip"
  register: zip_check

- name: Assert local binary exists
  assert:
    that:
      - zip_check.stat.exists
    fail_msg: "Local binary archive does not exist at {{ local_directory }}/promtail.zip"
    success_msg: "Local binary archive exists."

- name: Get checksum list and set checksum for target architecture
  uri:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail_{{ promtail_version }}_linux_{{ target_architecture }}.zip.sha256"
    method: GET
    return_content: yes
  register: checksum_info

- name: Set checksum for target architecture
  set_fact:
    checksum: "{{ checksum_info.content | trim }}"


