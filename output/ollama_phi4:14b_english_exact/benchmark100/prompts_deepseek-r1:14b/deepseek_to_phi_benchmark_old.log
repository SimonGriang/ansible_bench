---
- name: Include OS-specific variables
  include_vars:
    file: "{{ ansible_distribution }}.yml"
  when: ansible_os_family is defined

- name: Include OS-specific variables
  include_vars:
    file: "{{ ansible_os_family }}.yml"
  when: ansible_os_family is defined

- name: Include OS family specific tasks
  include_tasks: "{{ ansible_os_family }}.yml"
  when: ansible_os_family in ['RedHat', 'Debian']

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: true
  when: ansible_version.full | version_compare('2.12', '<')
    and ansible_os_family not in ['RedHat', 'Debian']
  check_mode: no

- name: Install Docker packages with downgrade option
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    downgrade: yes
  notify: restart docker
  ignore_errors: true
  when: ansible_version.full | version_compare('2.12', '>=')
    and ansible_os_family in ['RedHat', 'Debian']
  check_mode: no

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: true
  when: docker_install_compose_plugin
    and ansible_version.full | version_compare('2.12', '<')
    and ansible_os_family not in ['RedHat', 'Debian']
  check_mode: no

- name: Install docker-compose-plugin with downgrade option
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    downgrade: yes
  notify: restart docker
  ignore_errors: true
  when: docker_install_compose_plugin
    and ansible_version.full | version_compare('2.12', '>=')
    and ansible_os_family in ['RedHat', 'Debian']
  check_mode: no

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    state: directory
    mode: '0755'
  when: docker_daemon_options is defined and docker_daemon_options | length > 0

- name: Configure Docker daemon options
  template:
    src: daemon.json.j2
    dest: /etc/docker/daemon.json
    mode: '0644'
  notify: restart docker
  when: docker_daemon_options is defined and docker_daemon_options | length > 0

- name: Ensure Docker service is started and enabled
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: true
  when: docker_service_manage

- name: Flush handlers to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose.yml tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group information
  getent:
    database: group
    key: docker
  register: docker_group_info
  when: docker_users is defined and docker_users | length > 0

- name: Set fact for user modification
  set_fact:
    user_modification_needed: true
  when: docker_users is defined and docker_users | length > 0
    and docker_group_info is defined
    and not docker_users | map('in', docker_group_info.gids) | select('equalto', true) | list

- name: Include docker-users.yml tasks
  include_tasks: docker-users.yml
  when: user_modification_needed is defined and user_modification_needed


