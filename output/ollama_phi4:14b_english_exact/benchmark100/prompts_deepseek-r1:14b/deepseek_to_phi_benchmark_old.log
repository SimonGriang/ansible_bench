---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  lineinfile:
    path: /etc/rancher/rke2/config.yaml
    line: "node-taints: server-node-taint-value"
    create: yes
  when: node_type == 'server'

- name: Set agent taints
  lineinfile:
    path: /etc/rancher/rke2/config.yaml
    line: "node-taints: agent-node-taint-value"
    create: yes
  when: node_type == 'agent'

- name: Copy RKE2 configuration file
  template:
    src: rke2-config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: restart rke2

- name: Copy Kubelet configuration file
  template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/agent-config/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  when: kubelet_config is defined
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ custom_registry_config_path }}"
    dest: /etc/rancher/rke2/agent-config/registries.yaml
    owner: root
    group: root
    mode: '0644'
  when: custom_registry_config is defined
  notify: restart rke2

- name: Start RKE2 service on other nodes
  service:
    name: rke2
    state: started
    enabled: yes
  when: inventory_hostname != current_node
  notify: restart rke2

- name: Mask other RKE2 services on nodes
  systemd:
    name: "{{ item }}"
    masked: yes
  loop:
    - rke2-server
    - rke2-agent
  when: node_type == 'server' and item == 'rke2-agent'
  when: node_type == 'agent' and item == 'rke2-server'

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    timeout: 600
  when: not cni_configured
  until: all_nodes_ready

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    timeout: 600
  when: cni_configured
  until: all_nodes_ready


