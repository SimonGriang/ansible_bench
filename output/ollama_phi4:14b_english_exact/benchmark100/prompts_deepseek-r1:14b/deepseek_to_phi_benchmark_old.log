---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
    - name: Set SELinux state
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Manage SELinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent | default(true) }}"
      loop: "{{ selinux_booleans }}"
  when: selinux_booleans is defined

handlers:
  - name: Gather facts
    meta: refresh_inventory

  - name: Reboot
    reboot: {}


