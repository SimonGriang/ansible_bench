---
- name: Create docroot for each vhost
  file:
    path: "{{ item.value.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts | dict2items }}"
  when: item.value.documentroot is defined and item.value.create_docroot is not defined or item.value.create_docroot | default(true) | bool
  loop_control:
    label: "{{ item.key }}"

- name: Configure vhosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.value.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts | dict2items }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd


