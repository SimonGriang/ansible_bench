  register: csr

- name: Generate a self-signed SSL certificate
  openssl_certificate:
    path: "{{ ssl_dir }}/selfsigned.crt"
    privatekey_path: "{{ ssl_dir }}/private.key"
    csr_path: "{{ ssl_dir }}/private.csr"
    provider: selfsigned
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_cert_mode }}"
  register: cert

- name: Create a PKCS#12 file
  openssl_pkcs12:
    dest: "{{ ssl_dir }}/cert.pfx"
    privatekey_path: "{{ ssl_dir }}/private.key"
    certificate_path: "{{ ssl_dir }}/selfsigned.crt"
    password: "{{ ssl_pfx_password }}"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_pfx_mode }}"

- name: Read the private key content
  slurp:
    path: "{{ ssl_dir }}/private.key"
  register: private_key_content

- name: Read the certificate content
  slurp:
    path: "{{ ssl_dir }}/selfsigned.crt"
  register: cert_content

- name: Combine private key and certificate into a single file
  copy:
    content: "{{ private_key_content.content | b64decode }}\n{{ cert_content.content | b64decode }}"
    dest: "{{ ssl_dir }}/combined.pem"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: "{{ ssl_combined_mode }}"


