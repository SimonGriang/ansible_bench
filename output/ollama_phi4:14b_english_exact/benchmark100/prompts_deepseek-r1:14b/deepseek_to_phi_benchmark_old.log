---
- name: Import assertion tasks from assert.yml for validation and run them once on localhost
  include_tasks: assert.yml

- name: Install all necessary packages required for Vault installation
  package:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables to configuration
  lineinfile:
    path: /etc/vault.d/vault.env
    line: "{{ item }}"
    create: yes
  with_items: "{{ vault_environment_settings }}"
  notify:
    - Restart vault

- name: Include security hardening tasks
  include_tasks: hardening.yml

- name: Start and enable the Vault service for OSS type
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable the Vault service for non-OSS type
  service:
    name: vault
    enabled: yes
  when: vault_type != "oss"

handlers:
  - name: Restart vault
    service:
      name: vault
      state: restarted


