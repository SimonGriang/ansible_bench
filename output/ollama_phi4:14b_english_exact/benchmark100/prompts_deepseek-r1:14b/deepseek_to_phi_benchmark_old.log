---
- name: Import assertion tasks
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install php
  ansible.builtin.package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  ansible.builtin.shell: |
    set -o pipefail
    php --ini | grep 'Loaded Configuration File' | awk -F' => ' '{print $2}'
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  ansible.builtin.template:
    src: php.ini.j2
    dest: /etc/php.ini
    mode: '0644'
  notify: Restart httpd


