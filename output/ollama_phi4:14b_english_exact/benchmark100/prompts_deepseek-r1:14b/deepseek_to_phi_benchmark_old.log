---
- name: Import assert.yml
  import_tasks: assert.yml
  tags: 
    - assert

- name: Install DNS packages
  package:
    name: "{{ dns_packages }}"
    state: present
  tags:
    - install

- name: Create directories for DNS data and configuration
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ directories }}"
  tags:
    - directories

- name: Create DNS group
  group:
    name: "{{ dns_group }}"
    state: present
  tags:
    - group

- name: Create DNS user
  user:
    name: "{{ dns_owner }}"
    system: yes
    state: present
  tags:
    - user

- name: Generate rndc key
  command: rndc-confgen -a -r /dev/urandom > /etc/bind/rndc.key
  args:
    creates: /etc/bind/rndc.key
  tags:
    - rndc_key

- name: Set permissions on rndc key file
  file:
    path: /etc/bind/rndc.key
    owner: bind
    group: bind
    mode: '0600'
  tags:
    - rndc_key_permissions

- name: Get the hints/root file
  get_url:
    url: "{{ hints_url }}"
    dest: /etc/bind/db.root
    mode: '0644'
  when: dns_caching_dns
  tags:
    - hints_file

- name: Create zone files from templates
  template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: '0644'
  loop: "{{ zones }}"
  notify: Rndc reload
  tags:
    - zone_files

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/bind/named.conf
  notify: Restart dns handler
  tags:
    - dns_configuration

- name: Place systemd override
  template:
    src: systemd-overrides.j2
    dest: "/etc/systemd/system/bind9.service.d/override.conf"
  notify: Reload systemd
  when: using_systemd
  tags:
    - systemd_override

- name: Start and enable DNS
  service:
    name: bind9
    state: started
    enabled: yes
  tags:
    - service


