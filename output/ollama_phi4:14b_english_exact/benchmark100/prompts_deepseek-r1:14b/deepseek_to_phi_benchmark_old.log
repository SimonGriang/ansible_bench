---
- name: Ensure the OpenVPN client configuration directory exists
  ansible.builtin.file:
    path: /etc/openvpn/client
    state: directory
    owner: root
    group: openvpn_group
    mode: '0750'

- name: Generate and place the OpenVPN client configuration file
  ansible.builtin.template:
    src: client.conf.j2
    dest: /etc/openvpn/client.conf
    owner: root
    group: openvpn_group
    mode: '0640'
  notify:
    - Restart openvpn


