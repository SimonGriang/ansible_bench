---
- name: Create /etc/openvpn/easy-rsa directory with correct permissions
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Initialize OpenVPN PKI structure
  ansible.builtin.command:
    cmd: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Generate OpenVPN CA certificate
  ansible.builtin.command:
    cmd: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'
  changed_when: false

- name: Generate Diffie-Hellman parameters
  ansible.builtin.command:
    cmd: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Generate server certificate
  ansible.builtin.command:
    cmd: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'
  changed_when: false

- name: Generate client certificate
  ansible.builtin.command:
    cmd: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: 'yes'
  changed_when: false

- name: Generate Certificate Revocation List
  ansible.builtin.command:
    cmd: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Generate OpenVPN TA key
  ansible.builtin.command:
    cmd: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false

- name: Copy PKI files to /etc/openvpn/server directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/
    mode: '0640'
  loop:
    - ca.crt
    - dh.pem
    - server.crt
    - server.key
    - ta.key
    - crl.pem

- name: Copy additional PKI files to /etc/openvpn directory
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/
    mode: '0640'
  loop:
    - ca.crt
    - dh.pem
    - ta.key
    - crl.pem

- name: Place OpenVPN server configuration file
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    owner: root
    group: root
    mode: '0644'
  notify: restart openvpn


