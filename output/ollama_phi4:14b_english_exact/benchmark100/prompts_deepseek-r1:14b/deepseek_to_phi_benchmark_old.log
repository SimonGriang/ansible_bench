---
- name: lookup bootstrap facts (raw)
  ansible.builtin.command:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  vars:
    ansible_user: "{{ bootstrap_user }}"

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.value.name }}"
    bootstrap_distribution_major_version: "{{ item.value.version | regex_search('(?<=^).*(?=\.)') }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: item.value.name is search(bootstrap_facts.stdout | regex_search('PRETTY_NAME="(.+?) \(.*?\)"))
  vars:
    ansible_user: "{{ bootstrap_user }}"
  become: "{{ bootstrap__become | default(false) }}"

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: bootstrap_distribution == item.value.name
  vars:
