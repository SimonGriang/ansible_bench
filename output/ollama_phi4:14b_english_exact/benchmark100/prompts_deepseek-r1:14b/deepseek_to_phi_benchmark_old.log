---
- name: Update apt cache
  ansible.builtin.apt:
    update_cache: true
  when: ansible_os_family == "Debian"
  tags: [update_cache]

- name: Update dnf cache
  ansible.builtin.dnf:
    update_cache: true
  when: ansible_os_family == "RedHat"
  tags: [update_cache]

- name: Install packages
  ansible.builtin.package:
    name: keepalived
    state: present
  tags: [install_packages]

- name: Create directory for keepalived
  ansible.builtin.file:
    path: /etc/keepalived
    state: directory
    mode: '0755'
  tags: [create_directory]

- name: Create Kubernetes API health check script for Debian OS family
  ansible.builtin.copy:
    dest: /usr/local/bin/k8s_apiserver_health_check.sh
    content: |
      #!/bin/bash
      # Custom logic to check Kubernetes API health
      if ! curl -s https://kubernetes.api.server/healthz > /dev/null; then
        systemctl restart keepalived
      fi
    mode: '0755'
  when: ansible_os_family == "Debian"
  tags: [create_health_check_debian]

- name: Create Kubernetes API health check script for RedHat OS family
  ansible.builtin.copy:
    dest: /usr/local/bin/k8s_apiserver_health_check.sh
    content: |
      #!/bin/bash
      # Custom logic to check Kubernetes API health
      if ! curl -s https://kubernetes.api.server/healthz > /dev/null; then
        systemctl restart keepalived
      fi
    mode: '0755'
  when: ansible_os_family == "RedHat"
  tags: [create_health_check_redhat]

- name: Create RKE2 Server health check script for Debian OS family
  ansible.builtin.copy:
    dest: /usr/local/bin/rke2_server_health_check.sh
    content: |
      #!/bin/bash
      # Custom logic to check RKE2 server health
      if ! curl -s https://rke2.server/healthz > /dev/null; then
        systemctl restart keepalived
      fi
    mode: '0755'
  when: ansible_os_family == "Debian"
  tags: [create_health_check_rke2_debian]

- name: Create RKE2 Server health check script for RedHat OS family
  ansible.builtin.copy:
    dest: /usr/local/bin/rke2_server_health_check.sh
    content: |
      #!/bin/bash
      # Custom logic to check RKE2 server health
      if ! curl -s https://rke2.server/healthz > /dev/null; then
        systemctl restart keepalived
      fi
    mode: '0755'
  when: ansible_os_family == "RedHat"
  tags: [create_health_check_rke2_redhat]

- name: Create keepalived config file
  ansible.builtin.template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
  notify: restart keepalived
  tags: [create_keepalived_config]

- name: Enable keepalived and make sure it is not masked
  ansible.builtin.systemd:
    name: keepalived
    enabled: true
    masked: false
  notify: restart keepalived
  tags: [enable_keepalived]

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true
  tags: [flush_handlers]


