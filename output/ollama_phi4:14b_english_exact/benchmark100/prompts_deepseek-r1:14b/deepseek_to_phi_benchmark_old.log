content='```yaml\n---\n- name: Install Keepalived service when High Availability (HA) mode is enabled and \n        specific conditions are met\n  include_tasks: install_keepalived.yml\n  when: \n    - ha_mode_enabled\n    - specific_conditions_met\n\n- name: Download and install RKE2 with the specified version\n  include_tasks: download_install_rke2.yml\n  vars:\n    rke2_version: "{{ rke2_version }}"\n\n- name: Perform CIS hardening when a CIS profile is defined\n  include_tasks: cis_hardening.yml\n  when: cis_profile is defined\n\n- name: Find and identify the active server in the cluster\n  include_tasks: find_active_server.yml\n\n- name: Enable the IPVS kernel module for load balancing when specific HA mode \n        conditions are met\n  include_tasks: enable_ipvs_module.yml\n  when: \n    - ha_mode_enabled\n    - specific_ha_conditions_met\n\n- name: Copy kube-vip manifests to the master node when specific HA mode conditions \n        are met\n  include_tasks: copy_kube_vip_manifests.yml\n  when: \n    - ha_mode_enabled\n    - specific_ha_conditions_met\n\n- name: Copy ingress-nginx manifests to the master node when ingress-nginx values \n        are defined\n  include_tasks: copy_ingress_nginx_manifests.yml\n  when: ingress_nginx_values is defined\n\n- name: Prepare the first server node in the cluster under specific conditions\n  include_tasks: prepare_first_server_node.yml\n  when: specific_conditions_met\n\n- name: Perform etcd restore tasks when specific conditions are met\n  include_tasks: etcd_restore.yml\n  when: etcd_restore_conditions_met\n\n- name: Download the kubeconfig file to the Ansible localhost when enabled\n  include_tasks: download_kubeconfig.yml\n  when: kubeconfig_download_enabled\n\n- name: Prepare and join remaining cluster nodes when the active server is defined\n  include_tasks: join_remaining_nodes.yml\n  when: active_server is defined\n\n- name: Perform rolling restart of server nodes when version changes\n  include_tasks: rolling_restart_servers.yml\n  when: version_changed\n\n- name: Perform rolling restart of agent nodes when version changes\n  include_tasks: rolling_restart_agents.yml\n  when: version_changed\n\n- name: Flush all registered handlers\n  meta: flush_handlers\n\n- name: Perform rolling restart when configuration files change\n  include_tasks: rolling_restart_config_change.yml\n  when: config_files_changed\n\n- name: Perform final steps including a summary\n  include_tasks: final_steps.yml\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-10T14:49:36.113033104Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14191728516, 'load_duration': 70490734, 'prompt_eval_count': 1440, 'prompt_eval_duration': 386823008, 'eval_count': 546, 'eval_duration': 13733098447, 'model_name': 'phi4:14b'} id='run--213ee326-7ae1-42c4-8ab4-5a26e0a313c8-0' usage_metadata={'input_tokens': 1440, 'output_tokens': 546, 'total_tokens': 1986}
