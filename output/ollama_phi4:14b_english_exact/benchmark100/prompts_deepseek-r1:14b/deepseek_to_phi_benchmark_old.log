---
- name: Remove Docker GPG key from trusted.gpg.d directory
  ansible.builtin.file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Remove old Docker source list from sources.list.d directory
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Remove obsolete Docker packages
  ansible.builtin.apt:
    name: "{{ item }}"
    state: absent
  loop:
    - docker
    - docker-engine
    - docker.io
    - containerd
    - runc

- name: Remove legacy Docker repository file
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker-legacy.list
    state: absent

- name: Install required dependencies
  ansible.builtin.apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Manage Docker repository
  ansible.builtin.deb822_repository:
    filename: /etc/apt/sources.list.d/docker.list
    repo: >
      deb [arch=amd64]
      https://download.docker.com/linux/ubuntu
      {{ ansible_distribution_release }}
      stable
    state: "{{ 'present' if docker_add_repo | default(false) else 'absent' }}"

- name: Flush handlers to update apt cache
  ansible.builtin.meta: flush_handlers


