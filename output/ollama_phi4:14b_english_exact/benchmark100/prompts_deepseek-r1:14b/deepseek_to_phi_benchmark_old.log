---
- name: Install required SSL packages
  package:
    name: "{{ httpd_ssl_packages }}"
    state: present

- name: Create and place the SSL configuration file
  template:
    src: ssl.conf.j2
    dest: "{{ httpd_config_directory }}/ssl.conf"
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Create and place the default virtual host configuration file
  template:
    src: default_vhost.conf.j2
    dest: "{{ httpd_config_directory }}/{{ default_vhost_conf }}"
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd


