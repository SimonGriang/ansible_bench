k\n\n- name: cadvisor | server systemd service\n  template:\n    src: cadvisor.service.j2\n    dest: /etc/systemd/system/cadvisor.service\n    mode: 0644\n\n- name: test_task\n  shell: systemctl status cadvisor | grep -q 'active'\n  register: service_active\n\n- name: debug: var=service_active\n  debug:\n    var: service_active\n\n- name: cadvisor | enable server systemd\n  service:\n    name: cadvisor\n    state: enabled\n\n- name: cadvisor | start server systemd\n  service:\n    name: cadvisor\n    state: started\n```" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T10:50:14.476350618Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12312182378, 'load_duration': 88390827, 'prompt_eval_count': 494, 'prompt_eval_duration': 148604336, 'eval_count': 609, 'eval_duration': 12073571132, 'model_name': 'deepseek-r1:14b'} id='run--b45a746d-7e9b-498d-bebe-f12fc7151848-0' usage_metadata={'input_tokens': 494, 'output_tokens': 609, 'total_tokens': 1103}
