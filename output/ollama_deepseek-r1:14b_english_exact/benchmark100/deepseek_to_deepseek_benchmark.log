- name: Import assertion tasks
  import_tasks: assert.yml
  when: false
  delegate_to: localhost
  run_once: true

- name: Install Docker Compose package
  package:
    name: docker-compose
    state: present
  when: installation_type == "package"

- name: Install Docker Compose binary
  apt:
    name: curl
    state: present
  apt:
    name: python3
    state: present
  file:
    path: /usr/local/bin/docker-compose
    state: file
    content: "{{ lookup('url', 'https://github.com/docker/compose/releases/download/v2.20.0/docker-compose-{{ ansible_system }}') | checksum('sha256') }}"
    mode: '0755'
    owner: root
    group: root
  when: installation_type == "binary"


