---
- name: cadvisor | create directories
  file:
    path: /var/lib/cadvisor
    state: directory
    owner: root
    group: root

- name: cadvisor | download
  get_url:
    url: https://example.com/cadvisor-amd64
    dest: /usr/local/bin/cadvisor-amd64
    checksum: sha256:abc123

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: /usr/local/bin/cadvisor-amd64
    dest: /var/lib/cadvisor/
    remote_src: yes
  notify: restart_cadvisor

- name: cadvisor | symlink
  ln:
    src: /var/lib/cadvisor/cadvisor-amd64
    dest: /usr/bin/cadvisor
    state: symlink

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: 0644

- name: test_task
  shell: systemctl status cadvisor | grep -q 'active'
  register: service_active

- name: debug: var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  service:
    name: cadvisor
    state: enabled

- name: cadvisor | start server systemd
  service:
    name: cadvisor
    state: started


