    dest: /usr/local/bin
    remote_src: true
  ignore_errors: true

- name: Ensure Vault service is enabled
  systemd:
    name: vault
    enabled: true
    state: started

- name: Ensure Vault is running
  service:
    name: vault
    state: started
    enabled: true


