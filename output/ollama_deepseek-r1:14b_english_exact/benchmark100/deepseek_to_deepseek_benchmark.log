---
- name: Install EPEL GPG key
  rpm:
    name: /usr/share/trusted.gpg.d/epel.gpg
    state: present
    content: "{{ epel_gpg_key | regex_replace('\n', '\\n') }}"
  notify: Update package cache

- name: Install EPEL repository on compatible systems
  dnf:
    name:
      - epel-release
      - "{{ epel_next_release | default('epel-next-release') }}"
    state: present
    when: ansible_os_family in ['RedHat', 'Amazon']
    vars:
      ansible_python_interpreter: /usr/bin/python3
  notify: Update package cache

- name: Install EPEL release package
  rpm:
    name: "{{ epel_url | regex_replace('^https?://', '') }}"
    state: present
  notify: Update package cache

- name: Install EPEL next release package (conditional)
  rpm:
    name: "{{ epel_next_url | regex_replace('^https?://', '') }}"
    state: present
    when: epel_next | default(false)
  notify: Update package cache

handlers:
  - name: Update package cache
    dnf:
      state: update_cache


