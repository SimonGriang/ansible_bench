---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install required software
  apt:
    name: "{{ users_requirements }}"
    state: present

- name: Loop over users_groups
  loop: "{{ users_groups }}"
  include_tasks: group.yml

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "{{ users_sudo_includedir }}"
    state: present

- name: Loop over users
  loop: "{{ users }}"
  include_tasks: user.yml

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0644
  when: users_cron_allow is defined

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is not defined


