---
- name: Check existence of Java certificates
  action:
    module: stat
    path="{{ item.cert_path }}"
  loop:
    - "{{ java_certs }}"
  register: check_java_certs
  vars:
    cert_path: "{{ item.cert_path }}"

- name: Fail if Java certificates do not exist
  action:
    module: fail
    msg: "Java certificate {{ item.cert_path }} does not exist."
  loop:
    - "{{ check_java_certs.results }}"
  when: item.stat.changed == false

- name: Set Java keystore directory for Java < 11
  action:
    module: set_fact
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: ansible.java_version < 11

- name: Set Java keystore directory for Java >= 11
  action:
    module: set_fact
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: ansible.java_version >= 11

- name: Import SSL certificates into Java keystore
  action:
    module: java_cert
    keystore: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts"
    keystore_password: "{{ java_cert_keystore_pass }}"
    alias: "{{ item.cert_alias }}"
    certificate: "{{ item.cert_path }}"
    state: present
  loop:
    - "{{ java_certs }}"


