---
- name: Task 1: Import assert.yml task
  import_tasks: assert.yml

- name: Task 2: Install using package task
  block:
    - name: Task 2.1: Install repository for RedHat task
      become: true
      gather_facts: true
      hosts: all
      yum:
        name: hashicorp-repo
        state: present

    - name: Task 2.2: Configure Debian task
      block:
        - name: Task 2.2.1: Install required package gpg task
          become: true
          gather_facts: true
          hosts: debian
          apt:
            name: gpg
            state: present

        - name: Task 2.2.2: Install apt key for Debian task
          become: true
          gather_facts: true
          hosts: debian
          apt_key:
            key: "{{ hashicorp_apt_key }}"
            state: present

        - name: Task 2.2.3: Install repository for Debian task
          become: true
          gather_facts: true
          hosts: debian
          apt_repository:
            repo: "deb [arch=amd64] https://apt.releases.hashicorp.com/{{ ansible_distribution|lower }} {{ ansible_distribution_version|lower }}"
            state: present

    - name: Task 2.3: Install hashicorp product using package task
      block:
        - name: Task 2.3.1: Install latest hashicorp product using package task
          become: true
          gather_facts: true
          hosts: all
          apt:
            name: "{{ hashicorp_package_name }}"
            state: present

        - name: Task 2.3.2: Install versioned hashicorp product using package task
          become: true
          gather_facts: true
          hosts: all
          apt:
            name: "{{ hashicorp_package_name }}={{ hashicorp_version }}"
            state: present
          when: hashicorp_version is defined

- name: Task 3: Install manually task
  block:
    - name: Download and unpack Hashicorp product
      become: true
      gather_facts: true
      hosts: all
      get_url:
        url: "{{ hashicorp_manual_url }}"
        dest: /tmp/hashicorp.tgz
        validate_certs: no

    - name: Unpack Hashicorp product
      become: true
      gather_facts: true
      hosts: all
      file:
        path: /tmp/hashicorp.tgz
        state: directory
        mode: 0755

    - name: Move Hashicorp binary to bin directory
      become: true
      gather_facts: true
      hosts: all
      file:
        src: /tmp/hashicorp/*
        dest: /usr/local/bin/
        state: link
        force: yes


