---
- name: Import assert.yml task
  ansible.builtin.import_tasks:
    file: assert.yml
    cache: true

- name: Install using package task
  become: true
  vars:
    hashicorp_product: packer
  tasks:
    - name: Install repository for RedHat task
      ansible.builtin.yum:
        name: "{{ hashicorp_product }}-repo"
        state: present

    - name: Configure Debian task
      become: true
      tasks:
        - name: Install required package gpg task
          ansible.builtin.apt:
            name: gpg
            state: present

        - name: Install apt key for Debian task
          ansible.builtin.apt_key:
            keyserver: keyserver.ubuntu.com
            key: 05261F26258F3450B935417707EEF02C2C8FF758
            state: present

        - name: Install repository for Debian task
          ansible.builtin.apt_repository:
            repo: |
              deb [arch=$(dpkg --print-architecture)] https://apt.releases.hashicorp.com/{{ hashicorp_product }}
              $(lsb_release -cs)
            state: present

    - name: Install hashicorp product using package task
      become: true
      tasks:
        - name: Install latest hashicorp product using package task
          ansible.builtin.apt:
            name: "{{ hashicorp_product }}"
            state: present

        - name: Install versioned hashicorp product using package task
          ansible.builtin.apt:
            name: "{{ hashicorp_product }}={{ version }}"
            state: present

- name: Install manually task
  become: true
  vars:
    hashicorp_product: packer
    hashicorp_version: latest
  tasks:
    - name: Download and install Hashicorp product
      ansible.builtin.get_url:
        url: |
          https://releases.hashicorp.com/{{ hashicorp_product }}/
          {{ hashicorp_version }}/
          {{ hashicorp_product }}_{{ hashicorp_version }}_{{ ansible_system }}.tar.gz
        dest: /usr/local/bin/
        mode: '0755'

    - name: Unpack Hashicorp product
      ansible.builtin.unarchive:
        src: /usr/local/bin/{{ hashicorp_product }}_{{ hashicorp_version }}_{{ ansible_system }}.tar.gz
        dest: /usr/local/bin/
        remote_src: true
        changed_when: false

