      gather_facts: true
      hosts: all
      get_url:
        url: "{{ hashicorp_manual_url }}"
        dest: /tmp/hashicorp.tgz
        validate_certs: no

    - name: Unpack Hashicorp product
      become: true
      gather_facts: true
      hosts: all
      file:
        path: /tmp/hashicorp.tgz
        state: directory
        mode: 0755

    - name: Move Hashicorp binary to bin directory
      become: true
      gather_facts: true
      hosts: all
      file:
        src: /tmp/hashicorp/*
        dest: /usr/local/bin/
