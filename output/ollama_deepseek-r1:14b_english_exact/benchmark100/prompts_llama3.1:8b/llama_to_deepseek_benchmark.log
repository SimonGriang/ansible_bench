---
- name: Import and run tasks from assert.yml playbook
  ansible.builtin.include_tasks:
    file: assert.yml
  delegate_to: localhost
  changed_when: false

- name: Install required packages for the service
  ansible.builtin.apt:
    name: "{{ service_required_packages }}"
    state: present

- name: Configure systemd service for each item in the service_list
  loop: "{{ service_list }}"
  when: ansible_system in ['RedHat', 'Fedora', 'Debian', 'Ubuntu']
  ansible.builtin.copy:
    remote_src: true
    content: "{{ lookup('template', 'systemd.j2') }}"
    dest: "/etc/systemd/system/{{ item.name }}.service"
    mode: "0644"
  notify: Systemctl daemon-reload

- name: Configure sysvinit service for each item in the service_list
  loop: "{{ service_list }}"
  when: ansible_system not in ['RedHat', 'Fedora', 'Debian', 'Ubuntu']
  ansible.builtin.copy:
    remote_src: true
    content: "{{ lookup('template', 'sysvinit.j2') }}"
    dest: "/etc/init.d/{{ item.name }}"
    mode: "0755"
  notify: Sysvinit service configured

- name: Manage each service in the service_list
  loop: "{{ service_list }}"
  ansible/systemd.py:
    name: "{{ item.name }}"
    state: "{{ item.state | default('running') }}"
    enabled: "{{ item.enabled | default('yes') }}"

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

