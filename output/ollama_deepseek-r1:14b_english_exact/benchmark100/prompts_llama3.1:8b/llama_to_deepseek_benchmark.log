---
- name: Import assert.yml and run it once on localhost
  import_tasks: assert.yml

- name: Install the mysql package
  apt:
    name: mysql
    state: present

- name: Configure the mysql server
  template:
    dest: /etc/mysql/{{ mysql_name }}-server.cnf
    mode: 0644
    content: |
      {{ mysql_name }}_server_config {{ mysql_configuration_options }}

- name: Configure the mysql client
  template:
    dest: /etc/mysql/{{ mysql_name }}-client.cnf
    mode: 0644
    content: |
      {{ mysql_name }}_client_config {{ mysql_socket_option }}

- name: Initialize the mysql service
  command: "{{ mysql_initialize_command }}"
  shell: /bin/sh

- name: Start and enable the mysql service
  systemctl:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Create a my.cnf file in /root/.my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0600

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ db_name }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: List databases
  community.mysql.mysql_info:
    state: present

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ db_name }}"
    state: import
    initial_db: "{{ initial_import }}"
  when: initial_import is defined
  loop: "{{ mysql_databases }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ user_name }}"
    priv: all
    host: "{{ host }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers

