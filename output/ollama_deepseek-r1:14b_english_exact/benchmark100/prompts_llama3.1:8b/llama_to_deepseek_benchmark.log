---
- name: Cordon and Drain the node with the specified RKE2 node name
  command:
    cmd:
      - "{{ rke2_data_path }}/bin/kubectl drain"
      - "--ignore-daemonsets"
      - "{{ rke2_node_name }}"
      - "{{ rke2_drain_additional_args }}"
    chdir: "{{ rke2_data_path }}"
  register: drain_node_result
  until: drain_node_result.results[0].ansible_command.rc
  retries: 100
  delay: 15
  ignore_errors: yes

- name: Restart the RKE2 service on the specified node
  command:
    cmd: "systemctl restart {{ rke2_service_name }}"
  register: restart_rke2_result

- name: Wait for all nodes to be ready again
  kubernetes.core.wait_for_nodes:
    path: "{{ rke2_data_path }}/bin/kubectl"
    group_name: "{{ rke2_cluster_group_name }}"
  register: wait_nodes_ready_result
  until: wait_nodes_ready_result.ansible_kubernetes_result.ready
  retries: 100
  delay: 15
  ignore_errors: yes

- name: Uncordon the specified RKE2 node
  command:
    cmd:
      - "{{ rke2_data_path }}/bin/kubectl"
      - "uncordon"
      - "{{ rke2_node_name }}"
    chdir: "{{ rke2_data_path }}"
  register: uncordon_node_result

- name: Wait for all pods to be ready again
  kubernetes.core.wait_for_pods:
    path: "{{ rke2_data_path }}/bin/kubectl"
  register: wait_pods_ready_result
  until: wait_pods_ready_result.ansible_kubernetes_result.ready
  retries: 100
  delay: 15
  ignore_errors: yes

- name: Wait for all pods to pass readiness checks
  kubernetes.core.wait_for_pods_health:
    path: "{{ rke2_data_path }}/bin/kubectl"
    args: "{{ rke2_wait_for_all_pods_to_be_healthy_args }}"
  register: wait_pods_health_result
  until: wait_pods_health_result.ansible_kubernetes_result.healthy
  retries: 100
  delay: 15
  ignore_errors: yes


