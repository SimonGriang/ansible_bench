---
- name: Install EPEL package repository for Amazon Linux 2 or RedHat-based systems
  apt:
    name: epel-release
    state: present
  become: true
  when:
    - ansible_os_family == "RedHat" and ansible_distribution_version in ["7", "8", "9", "10"]
    - ansible_distribution == "Amazon" and ansible_distribution_version == "2"

- name: Install the EPEL GPG key
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"

- name: Install the EPEL-release package
  ansible.builtin.package:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Install the EPEL-next-release package (conditional)
  ansible.builtin.package:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next
  notify: Update package cache

handlers:
  Update package cache:
    ansible.builtin.pip_cache:
      state: present


