- name: Set the package state based on how Ansible is installed
  ansible.builtin.shell: |
    if dpkg -l | grep ansible | grep -q installed; then
        echo "ansible installed via package"
    elif pip freeze | grep -q ansible; then
        echo "ansible installed via pip"
    fi

- name: Set up Ansible on RedHat
  ansible.builtin.shell: dnf install -y ansible

- name: Set up Ansible on Fedora
  ansible.builtin.shell: dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest.noarch.rpm && dnf install -y ansible

- name: Set up Ansible on Ubuntu
  ansible.builtin.shell: apt-get update && apt-get install -y ansible

- name: Set up Ansible on Debian
  ansible.builtin.shell: apt-get update && apt-get install -y -t buster-backports ansible

- name: Set up Ansible using Pip
  ansible.builtin.shell: pip install ansible


