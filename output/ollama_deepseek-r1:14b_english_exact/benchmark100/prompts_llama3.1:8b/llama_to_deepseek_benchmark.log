---
- name: Import assert.yml role
  include_role:
    name: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install git package
  apt:
    name: "{{ git_packages }}"
    state: present
  become: yes
  when: "{{ git_username | bool }}"

- name: Check if a user exists
  users:
    name: "{{ git_username }}"
    state: present
  register: user_exists
  when: "{{ git_username | bool }}"

- name: Create a directory for git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
  when:
    - "{{ git_username | bool }}"
    - user_exists.success

- name: Configure git
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    mode: 0644
  when:
    - "{{ git_user_email | bool }}"
    - "{{ git_user_name | bool }}"
    - "{{ git_username | bool }}"
    - user_exists.success

- name: Create the repository destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
  when:
    - "{{ git_username | bool }}"
    - user_exists.success

- name: Clone all specified repositories
  git:
    repo: "{{ repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version | default('HEAD') }}"
    force: "{{ item.force | default(false) | bool }}"
    become_user: "{{ git_username }}"
  with_items: "{{ git_repositories }}"
  when:
    - "{{ git_repositories | bool }}"
    - "{{ git_repository_destination | bool }}"
    - user_exists.success


