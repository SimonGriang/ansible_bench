---
- name: Import Java Asserts and Setup Local Task Execution
  import_tasks: assert.yml
  run_once: true

- name: Install Bash
  apt:
    name: bash
    state: present

- name: Install OpenJDK Java (Package)
  apt:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM (Local Java Source)
  apt:
    name: "{{ java_package_rpm }}"
    state: present
    become: true
  when: java_source == "local" and java_format == "rpm"

- name: Install DEB (Local Java Source)
  apt:
    name: "{{ java_package_deb }}"
    state: present
    become: true
  when: java_source == "local" and java_format == "deb"
  vars:
    java_package_deb: oracle-java-{{ java_version }}-{{ ansible_distribution }}.deb

- name: Install Oracle Java (RPM) (Repository)
  apt:
    name: oracle-java{{ java_version }}
    state: present
    become: true
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Targz
  apt:
    name: oracle-java{{ java_version }}
    state: present
    become: true
  when: java_format == "targz" and java_vendor == "oracle"
  vars:
    java_install_directory: /usr/local/java

- name: Install Oracle Java Policy Software (Targz)
  apt:
    name: oracle-jce{{ java_version }}
    state: present
    become: true
  when:
    - java_jce == true
    - java_version == 8
    - java_vendor == "oracle"

- name: Set Alternative (Targz)
  alternatives:
    name: java
    path: "{{ java_install_directory }}/bin/java"
    state: present
    priority: 1
  when:
    - java_format == "targz"
    - ansible_distribution != "Alpine"
    - java_vendor == "oracle"

- name: Find JAVA_HOME
  shell: readlink -f /usr/bin/java
  register: java_home
  when: java_format == "targz" and java_vendor == "oracle"

- name: Set JAVA_HOME in /etc/environment
  shell: echo "export JAVA_HOME={{ java_home.stdout }}" > /etc/profile.d/java_home.sh
  become: true
  mode: 0755


