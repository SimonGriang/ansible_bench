---
- name: Remove Docker GPG key from trusted.gpg.d if present
  file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Remove old Docker apt source list
  file:
    path: /etc/apt/sources.list.d/docker*.list
    state: absent

- name: Uninstall old versions of Docker
  apt:
    name: "{{ item }}"
    state: absent
    purge: yes
    become: yes
  loop:
    - docker
    - docker-engine
    - docker.io
    - containerd
    - runc

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install required dependencies
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    become: yes

- name: Add or remove Docker repository
  block:
    - name: Add Docker GPG key
      apt_key:
        url: https://download.docker.com/linux/ubuntu/gpg
        state: present
        validate_certs: no
      when: docker_add_repo

    - name: Add Docker repository
      apt_repository:
        repo: "deb [arch=$(dpkg --print-architecture) 2> /dev/null] https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} stable"
        state: present
        filename: docker.list
      when: docker_add_repo

    - name: Remove Docker repository
      apt_repository:
        repo: "deb [arch=$(dpkg --print-architecture) 2> /dev/null] https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} stable"
        state: absent
        filename: docker.list
      when: not docker_add_repo

- name: Notify apt update handler
  meta:
    notify: apt_update_handler
  when: true


