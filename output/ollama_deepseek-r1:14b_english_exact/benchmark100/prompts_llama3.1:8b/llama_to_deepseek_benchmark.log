---
- name: Install unzip package and update cache if necessary
  apt:
    name:
      - unzip
    state: present
    update_cache: yes
    cache_valid_time: 0
  when: promtail_apt_update_cache

- name: Create promtail system group if necessary
  group:
    name: "{{ promtail_system_group }}"
    state: present
    system: yes
  when: (promtail_system_group != "root")

- name: Create the promtail system user
  user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    additional_groups: "{{ promtail_user_additional_groups }}"
    state: present
    system: yes
  when: (promtail_system_user != "root")

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: 0755

- name: Create necessary config directories
  file:
    path: /etc/promtail
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0755

- name: Create application directories
  file:
    path: /usr/local/share/promtail
    state: directory
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0755

- name: Check the existence of the promtail binary
  command: test -f /usr/local/share/promtail/bin/{{ promtail_binary_name }}
  register: promtail_binary_exists

- name: Download promtail binaries if necessary
  get_url:
    url: "{{ promtail_binary_url }}"
    dest: /usr/local/share/promtail/bin/{{ promtail_binary_name }}
    mode: 0755
  when: not promtail_binary_exists.stdout

- name: Propagate locally distributed promtail archive if necessary
  copy:
    src: "{{ promtail_binary_local | default('')}}"
    dest: /tmp/promtail_binary.zip
    remote_src: yes
    mode: 0644
  when: promtail_binary_local is not null

- name: Download promtail binaries to controller node if necessary
  get_url:
    url: "{{ promtail_binary_url }}"
    dest: /usr/local/share/promtail/bin/{{ promtail_binary_name }}
    mode: 0755
  when: promtail_binary_propagate | bool

- name: Propagate promtail binaries
  copy:
    src: /usr/local/share/promtail/bin/{{ promtail_binary_name }}
    dest: /usr/local/share/promtail/bin/{{ promtail_binary_name }}
    remote_src: yes
    mode: 0755
  when: promtail_binary_propagate | bool

- name: Unpack promtail binaries
  unarchive:
    src: /usr/local/share/promtail/bin/{{ promtail_binary_name }}
    dest: /usr/local/share/promtail/bin
    remote_src: yes

- name: Create a symlink to the latest version
  file:
    path: /usr/local/bin/promtail
    state: link
    src: /usr/local/share/promtail/bin/{{ promtail_binary_name }}

- name: Write the promtail configuration
  template:
    src: promtail-config.yml.j2
    dest: /etc/promtail/promtail.yml
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0644
  when: promtail_binary_exists.stdout | bool

- name: Create the systemd service unit
  copy:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0644
  when: promtail_binary_exists.stdout | bool
