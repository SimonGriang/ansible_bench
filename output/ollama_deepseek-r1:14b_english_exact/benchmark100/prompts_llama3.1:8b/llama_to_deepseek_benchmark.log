---
- name: Import and run the assert.yml file on the localhost
  hosts: localhost
  tasks:
    - name: Run assert.yml
      import_tasks: assert.yml
      loop: "{{ [1] }}"
      when: loop_count == 1
      run_once: true

- name: Install the required packages with the specified package names and state
  hosts: all
  tasks:
    - name: Install packages
      package:
        name: "{{ selinux_requirements }}"
        state: present
      notify: Gather facts

- name: Flush the handlers to ensure any pending tasks are executed
  hosts: all
  tasks:
    - name: Flush handlers
      meta: flush_handlers

- name: Configure selinux based on the conditions and variables provided
  hosts: all
  tasks:
    - name: Configure selinux
      block:
        - name: Manage selinux settings
          ansible.builtin.selinux:
            state: "{{ selinux_state }}"
            policy: "{{ selinux_policy }}"
            notify: Reboot
          register: selinux_settings

        - name: Manage selinux booleans
          ansible.builtin.selinux_boolean:
            name: "{{ item.name }}"
            state: "{{ item.state }}"
            persistent: "{{ item.persistence }}"
          loop: "{{ selinux_booleans }}"
          register: selinux_booleans_status
      when: ansible_connection not in ['container', 'docker', 'community.docker.docker']
      changed_when: selinux_configured | default(false)

- name: Manage selinux settings
  hosts: all
  tasks:
    - name: Manage selinux settings
      ansible.builtin.selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
        notify: Reboot

- name: Manage selinux booleans
  hosts: all
  tasks:
    - name: Manage selinux booleans
      ansible.builtin.selinux_boolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistence }}"
      loop: "{{ selinux_booleans }}"
---


