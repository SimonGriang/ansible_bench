---
- name: Install Keepalived when HA mode is enabled
  include: keepalived.yml
  tags: [ha, keepalived]
  when:
    ha_mode: true
    group: rke2_servers_group

- name: Download and install RKE2 {{ rke2_version }}
  include: rke2.yml
  tags: [rke2, install]
  when:
    rke2_version: "{{ rke2_version }}"

- name: CIS Hardening
  include: cis.yml
  tags: [cis, security]
  when:
    cis_profile: true

- name: Find Active Server
  include: find_active_server.yml
  tags: [ha, active_server]
  when:
    ha_mode: true

- name: Enable IPVS kernel module
  include: ipvs.yml
  tags: [ipvs, kernel]
  when:
    ha_mode: true
    ipvs_enabled: true
    group: rke2_servers_group

- name: Copy kube-vip manifests to the masternode
  include: kubevip.yml
  tags: [kube-vip, ha]
  when:
    ha_mode: true
    ipvs_enabled: true
  hosts: "{{ groups.rke2_servers_group[0] }}"

- name: Copy ingress-nginx manifests to the masternode
  include: ingress-nginx.yml
  tags: [ingress-nginx, ha]
  when:
    ingress_nginx_values: "{{ ingress_nginx_values }}"
  hosts: "{{ groups.rke2_servers_group[0] }}"

- name: Prepare very first server node in the cluster
  include: first_server.yml
  tags: [rke2, first_server]
  when:
    active_server: null or length(groups.rke2_servers_group) == 1
  hosts: "{{ groups.rke2_servers_group[0] }}"

- name: Restore etcd specific tasks
  include: first_server_restore.yml
  tags: [rke2, etcd_restore]
  when:
    active_server: defined
    (ansible_hostname == groups.rke2_servers_group[0] or ansible_hostname == groups.rke2_servers_group[-1])
    etcd_restore: true

- name: Download kubeconfig to ansible localhost
  include: download_kubeconfig.yaml
  tags: [kubeconfig, ha]
  when:
    download_kubeconfig: true
  hosts: "{{ groups.rke2_servers_group[0] }}"

- name: Prepare and join remaining nodes of the cluster
  include: remaining_nodes.yml
  tags: [rke2, remaining_nodes]
  when:
    active_server: defined
    groups.rke2_servers_group | length > 1

- name: Rolling cordon and drain restart when version changes - servers
  include: rolling_restart.yml
  tags: [rke2, rolling_restart, servers]
  when:
    version_changed: true
  with_items: "{{ groups.rke2_servers_group }}"

- name: Rolling cordon and drain restart when version changes - agents
  include: rolling_restart.yml
  tags: [rke2, rolling_restart, agents]
  when:
    version_changed: true
  with_items: "{{ groups.rke2_agents_group }}"

- name: Flush handlers
  include: flush_handlers.yml

- name: Rolling restart when config files change
  include: change_config.yml
  tags: [rke2, config_change]
  when:
    config_files_changed: true
  with_items: "{{ groups.rke2_all_nodes }}"

- name: Final steps
  include: summary.yml
  tags: [rke2, final]


