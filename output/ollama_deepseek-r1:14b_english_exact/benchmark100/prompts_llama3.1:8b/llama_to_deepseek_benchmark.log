---
- name: Import assert.yml file
  include_tasks:
    file: assert.yml
    changed_when: false
  run_once: true
  delegate_to: localhost

- name: Install prerequisites
  apt:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  include_tasks: "{{ item }}"
  with_items: "{{ vault_installation_method }}"

- name: Add Vault environment variables
  template:
    src: vault.env.j2
    dest: /etc/vault.d/vault.env
    owner: vault
    group: vault
    mode: 0644
  vars:
    vault_env_settings: "{{ vault_environment_settings }}"
  notify: Restart Vault service

- name: Include hardening tasks
  import_tasks: hardening.yml

- name: Start and enable vault on OSS
  systemd:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable vault (non-OSS)
  systemd:
    name: vault
    state: started
    enabled: yes
  when: vault_type != "oss"


