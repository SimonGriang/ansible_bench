---
tasks:
  - name: Task 1: Import assert.yml file for task execution and skip the rest of the tasks on the first run.
    import_tasks: assert.yml
    run_once: true

  - name: Task 2: Pre-configure Debian systems for postfix installation.
    debconf:
      name: postfix
      question: postfix/main_mailer_type
      value: 'n'
      state: present

  - name: Task 3: Install postfix package.
    apt:
      name: postfix
      state: present

  - name: Task 4: Install postfix-mysql package if specific conditions are met.
    apt:
      name: postfix-mysql
      state: present
    when:
      - postfix_virtual_mailbox_maps is string
      - postfix_virtual_mailbox_domains is string
      - postfix_virtual_alias_maps is string

  - name: Task 5: Configure postfix transport maps.
    copy:
      src: postfix_transport
      dest: /etc/postfix/transport
      owner: postfix
      group: postfix
      mode: '0644'
    notify: postfix_transport_map_handler

  - name: Task 6: Configure postfix header checks.
    copy:
      src: postfix_header_checks
      dest: /etc/postfix/header_checks
      owner: postfix
      group: postfix
      mode: '0644'
    notify: postfix_header_checks_handler

  - name: Task 7: Set values for the main.cf file.
    copy:
      src: postfix_main
      dest: /etc/postfix/main.cf
      owner: postfix
      group: postfix
      mode: '0644'
    notify: postfix_main_handler

  - name: Task 8: Configure postfix master.cf.
    copy:
      src: postfix_master
      dest: /etc/postfix/master.cf
      owner: postfix
      group: postfix
      mode: '0644'
    notify: postfix_master_handler

  - name: Task 9: Create a directory for TLS certificates and keys.
    file:
      path: /etc/postfix/tls
      state: directory
      mode: '0755'

  - name: Task 10: Deploy Postfix TLS server certificate.
    copy:
      src: postfix_server.crt
      dest: /etc/postfix/tls/smtpd.crt
      owner: postfix
      group: postfix
      mode: '0644'
    notify: postfix_tls_handler

  - name: Task 11: Deploy Postfix TLS server key.
    copy:
      src: postfix_server.key
      dest: /etc/postfix/tls/smtpd.key
      owner: postfix
      group: postfix
      mode: '0644'
    notify: postfix_tls_handler

  - name: Task 12: Flush handlers.
    flush_handlers:

  - name: Task 13: Configure aliases.
    copy:
      src: postfix_aliases
      dest: /etc/aliases
      owner: root
      group: root
      mode: '0644'
    notify: postfix_aliases_handler

  - name: Task 14: Configure sender_access.
    copy:
      src: postfix_sender_access
      dest: /etc/postfix/sender_access
      owner: postfix
      group: postfix
      mode: '0644'
    notify: postfix_sender_access_handler

  - name: Task 15: Configure recipient_access.
    copy:
      src: postfix_recipient_access
      dest: /etc/postfix/recipient_access
      owner: postfix
      group: postfix
      mode: '0644'
    notify: postfix_recipient_access_handler

  - name: Task 16: Place sasl_password_map.
    copy:
      src: postfix_smtp_sasl_password_map
      dest: /etc/postfix/smtp_sasl_password_map
      owner: postfix
      group: postfix
      mode: '0644'
    notify: postfix_sasl_password_map_handler

  - name: Task 17: Flush handlers again.
    flush_handlers:

  - name: Task 18: Start and enable postfix service.
    service:
      name: postfix
      state: started
      enabled: yes

