---
- name: Restart RKE2 service on a node
  systemd:
    name: rke2
    state: restarted
    node_name: "{{ rke2_node_name }}"
  notify: service_restarted

- name: Wait for all nodes to be ready again
  shell: kubectl get nodes -o json | jq -r '.items[].status.conditions[] | select(.type=="Ready") | select(.status=="True") | .node
    | /(.*)/ | .[]' | wc -l
  register: all_ready_nodes
  delegate_to: "{{ (ansible.vars['ansible_active_server'] | default('none')) | ternary(hostvars[groups['rke2_servers_group_name'][0]].ansible_hostname, groups['rke2_servers_group_name'][0]) }}"
  run_once: yes
  retries: 100
  delay: 15
  until: all_ready_nodes.stdout == group_vars['rke2_cluster'].nodes.ready_count
  when: ansible_check_mode is false

- name: Wait for all pods to be ready again
  shell: kubectl get pods -o json | jq -r '[.items[] | select({status: {phase: (["Running", "Succeeded"] | contains(.status.phase)) | not}})] | length'
  register: all_pods_ready
  delegate_to: "{{ (ansible.vars['ansible_active_server'] | default('none')) | ternary(hostvars[groups['rke2_servers_group_name'][0]].ansible_hostname, groups['rke2_servers_group_name'][0]) }}"
  run_once: yes
  retries: 100
  delay: 15
  until: all_pods_ready.stdout == "0"
  when: rke2_wait_for_all_pods_to_be_ready and ansible_check_mode is false

handlers:
  service_restarted:
    - name: Restart RKE2 service on a node
      systemd:
        name: rke2
        state: restarted
        node_name: "{{ rke2_node_name }}"


