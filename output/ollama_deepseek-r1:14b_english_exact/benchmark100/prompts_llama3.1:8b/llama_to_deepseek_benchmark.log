---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0755'
  tags: ['rke2']

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_local_script_src }}"
    dest: "{{ rke2_local_script_dest }}"
    mode: '0755'
  when:
    - airgap
    - implementation == 'copy'
  tags: ['rke2']

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0755'
  when:
    - airgap
    - implementation != 'exists'
  tags: ['rke2']

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ rke2_checksum_url }}"
    dest: "{{ rke2_checksum_dest }}"
    mode: '0755'
  when:
    - airgap
    - implementation == 'download'
  tags: ['rke2']

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ rke2_additional_tarballs_src }}"
    dest: "{{ rke2_additional_tarballs_dest }}"
    mode: '0755'
  when:
    - airgap
    - implementation != 'exists'
    - additional_tarballs
  tags: ['rke2']

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0755'
  when:
    - airgap
    - implementation == 'exists'
  tags: ['rke2']

- name: Populate service facts
  service_facts:
  tags: ['rke2']

- name: Get stats of the FS object
  stat:
    path: "{{ rke2_fs_path }}"
  tags: ['rke2']

- name: Check if separate partition
  shell: "grep -q '^ /' /proc/mounts"
  register: partition_check
  changed_when: false
  tags: ['rke2']

- name: Set RKE2 bin path
  shell: "export PATH={{ rke2_bin_path }}:$PATH"
  when: "{{ rke2_bin_path }} is defined and ({{ partition_check.rc == 0 }})"
  tags: ['rke2']

- name: Check RKE2 version
  shell: "{{ rke2_bin }}/rke2-node version | grep -q '^v{{ desired_version }}'"
  register: version_check
  changed_when: false
  tags: ['rke2']

- name: Set RKE2 versions
  set_fact:
    current_version: "{{ version_check.rc }}"
  tags: ['rke2']

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - current_version >= desired_version
  tags: ['rke2']

- name: Run RKE2 install script
  shell: "{{ rke2_bin }}/rke2-node install --token {{ rke2_token }} --vip {{ rke2_vip }} --etcd {{ rke2_etcd }} --flannel {{ rke2_flannel }}"
  when: "{{ desired_version }} != {{ installed_version }}"
  tags: ['rke2']

- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_custom_manifests_src }}"
    dest: "{{ rke2_custom_manifests_dest }}"
    mode: '0755'
  when: custom_manifests
  tags: ['rke2']

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_src }}"
    dest: "{{ rke2_static_pods_dest }}"
    mode: '0755'
  when: static_pods
  tags: ['rke2']

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file_src }}"
    dest: "{{ rke2_env_file_dest }}"
    mode: '0755'
  when: environment_options
  tags: ['rke2']


