---
- name: Create the directories for the cadvisor installation
  file:
    path: /opt/cadvisor
    state: directory
    mode: 0755

- name: Check if directory is empty
  stat:
    path: /opt/cadvisor
  register: dir_empty
  changed_when: false

- name: Download the cadvisor binary from the internet
  when: dir_empty.empty
  get_url:
    url: http://example.com/cAdvisor-linux-amd64
    dest: /opt/cadvisor/cAdvisor-linux-amd64
    checksum: 1234567890abcdef

- name: Copy the locally distributed cadvisor binary
  when: not dir_empty.empty
  copy:
    src: /local/path/cAdvisor-linux-amd64
    dest: /opt/cadvisor/cAdvisor-linux-amd64
    remote_src: yes

- name: Create a symlink to the cadvisor binary
  file:
    path: /opt/cadvisor/cAdvisor-linux-amd64
    state: link
    target: /usr/local/bin/cadvisor

- name: Configure the cadvisor systemd service
  when: not dir_empty.empty
  template:
    src: cAdvisorService.j2
    dest: /etc/systemd/system/cadvisor.service
    vars:
      binary_path: /opt/cadvisor/cAdvisor-linux-amd64

- name: Test if the cadvisor service is active
  when: not dir_empty.empty
  shell: systemctl status cadvisor
  register: service_active
  changed_when: false

- name: Enable the cadvisor systemd service
  when: not dir_empty.empty
  shell: systemctl enable cadvisor

- name: Start the cadvisor systemd service
  when: not dir_empty.empty
  shell: systemctl start cadvisor
  notify: ['reload systemd']



