bel. I think that\'s all. Now, I\'ll format the YAML accordingly, making sure the syntax is correct to pass yamllint and ansible-lint.\n</think>\n\n```yaml\n---\n- name: Gather basic system facts\n  action: raw command=cat /etc/os-release\n  register: bootstrap_facts\n  become: false\n\n- name: Extract distribution name and major version\n  set_fact:\n    bootstrap_distribution: "{{ item.value }}"\n    bootstrap_distribution_major_version: "{{ item.major_version }}"\n  vars:\n    item_list:\n      - key: PRETTY_NAME\n        value: "{{ (bootstrap_facts.stdout_lines | select(\'startswith\', \'PRETTY_NAME=\') | first | regex_replace(\'PRETTY_NAME=.*?\\"(.*?)"\', \'\\1\') ) }}"\n      - key: VERSION_ID\n        value: "{{ (bootstrap_facts.stdout_lines | select(\'startswith\', \'VERSION_ID=\') | first | regex_replace(\'VERSION_ID=.*?\\"(.*?)"\', \'\\1\') ) }}"\n  loop: "{{ item_list }}"\n\n- name: Identify operating system family\n  set_fact:\n    bootstrap_os_family: "{{ family }}"\n  vars:\n    bootstrap_os_family_map:\n      Debian: debian\n      Ubuntu: debian\n      RHEL: redhat\n      CentOS: redhat\n      Fedora: fedora\n      Amazon: amazon\n  loop: "{{ bootstrap_os_family_map }}"\n  loop_control:\n    label: "{{ family }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-23T15:54:28.644585314Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14471998950, 'load_duration': 85428813, 'prompt_eval_count': 537, 'prompt_eval_duration': 275082406, 'eval_count': 736, 'eval_duration': 14110332064, 'model_name': 'deepseek-r1:14b'} id='run--c0eb71d1-9653-464e-bc25-b50295695750-0' usage_metadata={'input_tokens': 537, 'output_tokens': 736, 'total_tokens': 1273}
