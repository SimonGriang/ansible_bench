  ansible.builtin.package:
    name: ansible
    state: present
  when: true
  condition: ansible_python_version | version >= 3

- name: Set up Ansible for RedHat-based systems
  ansible.builtin.package:
    name: ansible
    state: present
  become: yes
  when: true
  condition: ansible_distribution in ['RedHat', 'CentOS']

- name: Set up Ansible for Fedora systems
  ansible.builtin.package:
    name: ansible
    state: present
  become: yes
  when: true
  condition: ansible_distribution == "Fedora"

- name: Set up Ansible for Ubuntu systems
  ansible.builtin.package:
    name: ansible
    state: present
  become: yes
  when: true
  condition: ansible_distribution == "Ubuntu"

- name: Set up Ansible for Debian systems
  ansible.builtin.package:
    name: ansible
    state: present
  become: yes
  when: true
  condition: ansible_distribution == "Debian"

- name: Set up Ansible using Pip
  ansible.builtin.pip:
