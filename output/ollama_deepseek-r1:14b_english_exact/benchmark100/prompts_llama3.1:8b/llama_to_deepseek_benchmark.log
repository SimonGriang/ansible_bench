---
- name: Create local ssh key directory for a user
  file:
    path: /home/user/.ssh
    state: directory
    mode: 0750
    owner: user
    group: users

- name: Manage the user account
  user:
    name: user
    comment: "User Account"
    group: users
    create_home: yes
    shell: /bin/bash
    password: "{{ user_password }}"
    password_expires: "{{ user_password_expires }}"

- name: Set up the user's sudo options
  template:
    src: "{{ template_path }}/sudoers.d/user"
    dest: /etc/sudoers.d/user
    mode: 0o644
    group: root
    state: present
  when: user_sudo_options is defined

- name: Generate the user's private SSH key
  command: ssh-keygen -q -t rsa -f /home/user/.ssh/id_rsa -N ""
  when: generate_ssh_key is true

- name: Generate the user's public SSH key
  command: ssh-keygen -q -t rsa -f /home/user/.ssh/id_rsa -N "" -y
  when: generate_ssh_key is true

- name: Convert the user's SSH key to PPK format
  command: ssh-keygen -q -t rsa -f /home/user/.ssh/id_rsa -o -O encrypted -N ""
  when: generate_ssh_key is true

- name: Get or set the user's home directory
  command: getent passwd | grep -w user | awk '{print $6}'
  register: user_home_dir
  changed_when: false

- name: Create the user's .ssh directory
  file:
    path: /home/user/.ssh
    state: directory
    mode: 0700
    owner: user
    group: users

- name: Deploy authorized keys for the user
  authorized_key:
    user: user
    key: "{{ item }}"
    state: present
  with_items: "{{ authorized_keys }}"
  when: authorized_keys is defined

- name: Remove unauthorized keys for the user
  authorized_key:
    user: user
    key: "{{ item }}"
    state: absent
  with_items: "{{ unauthorized_keys }}"
  when: unauthorized_keys is defined

- name: Copy the generated private SSH key for the user
  copy:
    src: /home/user/.ssh/id_rsa
    dest: /home/user/
    remote_src: yes
    mode: 0600
  when: copy_private_key is true

- name: Check the user's password validity
  command: awk -F: '{print $2}' /etc/shadow | grep -q '^\$6\$'
  register: users_pw_valid
  changed_when: false

- name: Set the user's password validity
  command: chage -M {{ password_max_days }} -m {{ password_min_days }} -d {{ password_default_days }} user
  when: users_pw_valid is false

- name: Place the private key file for the user
  copy:
    src: /home/user/.ssh/id_rsa
    dest: /home/user/
    remote_src: yes
    mode: 0600
  when: private_keys is defined


