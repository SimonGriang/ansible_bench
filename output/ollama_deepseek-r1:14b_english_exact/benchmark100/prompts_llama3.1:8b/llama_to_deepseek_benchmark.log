---
- name: Assert that systemd is being used as the init system
  ansible.builtin.systemd:
    state: started
    name: systemd
  register: systemd_check
  ignore_errors: yes
  changed_when: false
  failed_when: "{{ansible_check|default('')}} != 'systemd'"

- name: Get the latest release of the Grafana Loki project from the GitHub API
  ansible.builtin.uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    method: GET
    status_code: 200
    retries: 5
    retry_delay: 5
  register: _latest_release

- name: Set the promtail version to the latest release tag (excluding the 'v' prefix) if it's set to 'latest'
  ansible.builtin.set_fact:
    promtail_version: "{{ _latest_release.tag_name | regex_replace('v', '') }}"

- name: Test if the zip local archive exists in the specified directory
  ansible.builtin.stat:
    path: /usr/local/share/promtail/{{ promtail_version }}.zip
  register: local_archive_exists

- name: Assert that the local binary exists in the specified directory
  ansible.builtin.assert:
    that:
      - promtail_version is defined
      - promtail_version != 'latest'
      - local_archive_exists.stat is not null

- name: Get the checksum list for the latest release
  ansible.builtin.uri:
    url: https://github.com/grafana/loki/releases/download/{{ _latest_release.tag_name }}/checksums.txt
    method: GET
    status_code: 200
  register: __promtail_checksums

- name: Get the checksum for the specified architecture
  ansible.builtin.set_fact:
    __promtail_checksum: "{{ __promtail_checksums.content | regex_search('promtail-linux-' + arch + '.zip') | first }}"
  when: promtail_version == 'latest'


