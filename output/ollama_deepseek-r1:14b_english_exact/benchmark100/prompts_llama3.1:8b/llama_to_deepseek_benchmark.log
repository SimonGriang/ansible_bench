---
- name: Create the document root directory for each vhost
  ansible.builtin.file:
    path: /var/www/vhosts/{{ item }}/html
    state: directory
    mode: '0755'
  loop: httpd_vhosts

- name: Configure the Apache vhost configuration files
  ansible.builtin.template:
    src: vhost_conf_template
    dest: /etc/apache2/sites-available/{{ item }}.conf
    mode: '0644'
  loop: httpd_vhosts

- name: Enable Apache vhosts on Debian systems
  ansible.builtin.command:
    cmd: a2ensite {{ item }}
    chdir: /etc/apache2/sites-enabled
  loop: httpd_vhosts
  changed_when: false


