---
- name: Task 1: Update the package cache on systems that use apt
  apt:
    update_cache: yes

- name: Task 2: Update the package cache on systems that use dnf
  dnf:
    name:
      - "*"
    state: updates

- name: Task 3: Install the keepalived package
  package:
    name: keepalived
    state: present

- name: Task 4: Create the /etc/keepalived directory with the correct permissions
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Task 5: Create the Kubernetes API health check script for Debian-based systems
  template:
    src: check_apiserver.sh.j2
    dest: /etc/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: 0754

- name: Task 6: Create the Kubernetes API health check script for RHEL-based systems
  template:
    src: check_apiserver.sh.j2
    dest: /usr/libexec/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: 0754

- name: Task 7: Create the RKE2 Server health check script for Debian-based systems
  template:
    src: check_rke2server.sh.j2
    dest: /etc/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: 0754

- name: Task 8: Create the RKE2 Server health check script for RHEL-based systems
  template:
    src: check_rke2server.sh.j2
    dest: /usr/libexec/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: 0754

- name: Task 9: Create the keepalived configuration file
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: 0754

- name: Task 10: Enable the keepalived service and ensure it is not masked
  service:
    name: keepalived
    enabled: yes
    masked: no

- name: Task 11: Flush the handlers to execute any pending tasks
  meta:
    flush_handlers: yes


