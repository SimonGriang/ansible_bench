    promtail_version: "{{ _latest_release.releaseTagName | replace('v', '') }}"

- name: Test if the zip local archive exists in the specified directory
  stat:
    path: "{{ promtail_local_directory }}/{{ promtail_version }}.zip"
  register: promtail_zip_exists
  ignore_errors: true

- name: Assert that the local binary exists in the specified directory
  stat:
    path: "{{ promtail_local_directory }}/{{ promtail_binary }}"
  register: promtail_binary_exists
  ignore_errors: true

- name: Get the checksum list for the latest release
  uri:
    url: https://github.com/grafana/loki/releases/download/{{ _latest_release.releaseTagName }}/checksum.txt
    headers:
      Accept: text/plain
    method: GET
    status_code: 200
  register: __promtail_checksums
  ignore_errors: true

- name: Get the checksum for the specified architecture
  set_fact:
    __promtail_checksum: "{{ __promtail_checksums.content | regex_search(promtail_architecture + '\\.zip') }}"
  when: promtail_local_directory == ''


