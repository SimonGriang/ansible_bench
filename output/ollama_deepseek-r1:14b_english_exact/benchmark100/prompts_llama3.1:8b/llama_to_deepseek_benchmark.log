---
- name: Task 1: Import Java Asserts and Setup Local Task Execution
  import_tasks: assert.yml
  host: ansible://localhost
  become: false
  tags: []

- name: Task 2: Install Bash
  become: true
  apt:
    name: bash
    state: present
  tags: []

- name: Task 3: Install OpenJDK Java (Package)
  become: true
  apt:
    name: openjdk
    state: present
  environment:
    USE: "X -cups -alsa -fontconfig"
  when:
    - java_vendor == "openjdk"
  tags: []

- name: Task 4: Install RPM (Local Java Source)
  become: true
  copy:
    src: java.rpm
    dest: /tmp
  become: false
  shell: rpm -ivh /tmp/java.rpm
  when:
    - java_source == "local"
    - java_format == "rpm"
  tags: []

- name: Task 5: Install DEB (Local Java Source)
  become: true
  copy:
    src: java.deb
    dest: /tmp
  become: false
  apt:
    name: /tmp/java.deb
    state: present
  when:
    - java_source == "local"
    - java_format == "deb"
  tags: []

- name: Task 6: Install Oracle Java (RPM) (Repository)
  become: true
  apt:
    name: oracle-java
    state: present
  when:
    - java_source == "repository"
    - java_format == "rpm"
  tags: []

- name: Task 7: Configure Oracle Targz
  become: true
  shell: mkdir -p /usr/java
  when:
    - java_format == "targz"
    - java_vendor == "oracle"
  tags: []

- name: Task 8: Install Oracle Java Policy Software (Targz)
  become: true
  copy:
    src: jce.tar.gz
    dest: /tmp
  become: false
  shell: tar -xzvf /tmp/jce.tar.gz -C /usr/java
  when:
    - java_jce
    - java_version == 8
    - java_vendor == "oracle"
  tags: []

- name: Task 9: Set Alternative (Targz)
  become: true
  alternatives:
    name: java
    path: /usr/java/jdk1.8.0/bin/java
    state: present
    priority: 1000
  when:
    - java_format == "targz"
    - ansible_distribution != "Alpine"
    - java_vendor == "oracle"
  tags: []

- name: Task 10: Find JAVA_HOME
  become: false
  shell: readlink /usr/bin/java
  register: java_home
  when: ansible_distribution != "Alpine"
  tags: []

- name: Task 11: Set JAVA_HOME in /etc/environment
  become: true
  template:
    src: java_home.sh.j2
    dest: /etc/profile.d/java_home.sh
    mode: 0755
  when: ansible_distribution != "Alpine"
  tags: []


