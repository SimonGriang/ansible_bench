---
- name: Import necessary tasks from assert.yml for the httpd role
  import_tasks: assert.yml
  run_once: true
  host: localhost

- name: Install the Apache HTTP Server on the target machine
  ansible.builtin.package:
    name: httpd
    state: present
  vars:
    httpd_packages: "{{ httpd_packages | default('httpd') }}"

- name: Configure SELinux settings for the httpd service if SELinux is enabled
  ansible.builtin.selinux:
    state: enabled
    booleans:
      httpd_setsebools: "{{ httpd_sebooleans | default('httpd_setsebools') }}"
    ports:
      custom_ports: "{{ httpd_port | default('80') }}"
      ssl_port: "{{ https_ssl_port | default('443') if https_ssl_enable | bool }}"

- name: Configure the Apache HTTP Server on the target machine
  ansible.builtin.template:
    src: "{{ httpd_config_src | default('templates/httpd.conf.j2') }}"
    dest: "{{ httpd_config_dest | default('/etc/httpd/conf/httpd.conf') }}"
    group: "{{ httpd_config_group | default('root') }}"
    mode: "{{ httpd_config_mode | default('0644') }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Activate specific Apache HTTP Server modules on Debian-based systems using the a2enmod command
  ansible.builtin.command:
    cmd: >
      /usr/sbin/a2enmod "{{ item }}"
  with_items: "{{ httpd_modules_to_activate_with_command | default('') }}"
  when: ansible_os_family == 'Debian'
  notify:
    - Test httpd configuration validity

- name: Import tasks related to SSL configuration
  import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import tasks related to locations configuration
  import_tasks: locations.yml
  when: httpd_locations | bool

- name: Import tasks related to virtual hosts configuration
  import_tasks: vhosts.yml
  when: httpd_vhosts | bool

- name: Configure custom ports for the Apache HTTP Server
  ansible.builtin.template:
    src: "{{ httpd_ports_conf | default('templates/ports.conf.j2') }}"
    dest: "{{ httpd_ports_dest | default('/etc/httpd/ports.conf') }}"
    group: "{{ httpd_ports_group | default('root') }}"
    mode: "{{ httpd_ports_mode | default('0644') }}"
  when: (ansible_os_family in ['Debian', 'Suse'])
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Import tasks related to directories configuration
  import_tasks: directories.yml
  when: httpd_directories | bool

- name: Flush handlers
  ansible.builtin.meta:
    command: flush_handlers

- name: Remove the default index.html file from the Apache HTTP Server's data directory
  ansible.builtin.file:
    state: absent
    path: "{{ httpd_data_dir | default('/var/www/html/') }}/index.html"
  when: httpd_remove_example | bool

- name: Start and enable the Apache HTTP Server service
  ansible.builtin.service:
    name: httpd
    state: started
    enabled: yes


