---
- name: Hardening | Disable Swap
  swap:
    state: disabled
  when: vault_hardening_disable_swap

- name: Hardening | Disable Core Dumps
  community.general.pam_limits:
    name:
      - core
      - coredump
    state: hard
    value: 0
  loop:
    - name: core
      value: 0
    - name: coredump
      value: 0
  when: vault_hardening_disable_core_dumps

- name: Hardening | Disable Shell Command History
  copy:
    src: vault.sh
    dest: /etc/profile.d/vault.sh
    mode: 0755
  when: vault_hardening_disable_shell_command_history

- name: Hardening | Configure SELinux / AppArmor
  block:
    - name: Ensure SELinux is enabled
      selinux:
        state: enforcing
        mode: targeted
      when: ansible_os_family == "RedHat"

    - name: Install SELinux policy package
      apt:
        name: selinux-policy
        state: present
      when: ansible_os_family == "Debian"

    - name: Enforce AppArmor policies
      shell: aa-enforce /etc/apparmor.d/*
      changed_when: false


