---
- name: Import assert.yml role
  include_role:
    name: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install git package
  apt:
    name: "{{ git_packages }}"
    state: present

- name: Check if a user exists
  user:
    name: "{{ git_username }}"
    state: present
  when: git_username is defined

- name: Create a directory for git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
  when: git_username is defined and git_groupname is defined

- name: Configure git
  template:
    src: "gitconfig.j2"
    dest: "/home/{{ git_username }}/.gitconfig"
    mode: "0644"
  when: git_user_email is defined and git_user_name is defined and git_username is defined

- name: Create the repository destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
  when: git_username is defined and git_repository_destination is defined

- name: Clone all specified repositories
  git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version | default('HEAD') }}"
    force: "{{ item.force | default(false) }}"
    become_user: "{{ git_username }}"
  with_items: "{{ git_repositories }}"
  when: git_username is defined and git_repositories is defined and git_repository_destination is defined


