en:\n    - file.stat(path=/opt/cadvisor/cadvisor).exists is true\n\n- name: Enable the cadvisor systemd service\n  systemd:\n    name: cadvisor\n    state: enabled\n  when:\n    - file.stat(path=/opt/cadvisor/cadvisor).exists is true\n\n- name: Start the cadvisor systemd service\n  systemd:\n    name: cadvisor\n    state: started\n    daemon_reload: yes\n  when:\n    - file.stat(path=/opt/cadvisor/cadvisor).exists is true" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-13T08:22:06.49200738Z', 'done': True, 'done_reason': 'stop', 'total_duration': 44194208276, 'load_duration': 93150584, 'prompt_eval_count': 1024, 'prompt_eval_duration': 142974222, 'eval_count': 2082, 'eval_duration': 43956486866, 'model_name': 'deepseek-r1:14b'} id='run--fc4a293e-69c5-441e-ad3f-8838017f6ea5-0' usage_metadata={'input_tokens': 1024, 'output_tokens': 2082, 'total_tokens': 3106}  2%|▏         | 2/100 [03:16<2:48:57, 103.44s/it]
