---
- name: Create local ssh key directory for a user
  file:
    path: "{{ ssh_key_dir }}"
    state: directory
    mode: '0750'

- name: Manage the user account
  user:
    name: "{{ user_name }}"
    comment: "{{ user_comment }}"
    group: "{{ user_group }}"
    create_home: "{{ create_home }}"
    password: "{{ user_password }}"
    password_expires: "{{ user_password_expires }}"
    home: "{{ home_dir }}"
    shell: "{{ user_shell }}"

- name: Set up the user's sudo options
  template:
    dest: "/etc/sudoers.d/{{ user_name }}"
    mode: '644'
  when: sudo_options is defined
  register: sudo_config

- name: Remove sudo configuration if not needed
  file:
    path: "/etc/sudoers.d/{{ user_name }}"
    state: absent
  when: sudo_options is not defined

- name: Generate the user's private SSH key
  command: ssh-keygen -q -f "{{ ssh_key_path }}/id_rsa" -N ""
  when: generate_ssh_key
  changed_when: false

- name: Generate the user's public SSH key
  command: ssh-keygen -y -f "{{ ssh_key_path }}/id_rsa" -N "" > "{{ ssh_key_path }}/id_rsa.pub"
  when: generate_ssh_key
  changed_when: false

- name: Convert the user's SSH key to PPK format
  command: ssh-keygen -i -f "{{ ssh_key_path }}/id_rsa" -o > "{{ ssh_key_path }}/id_rsa.ppk"
  when: generate_ssh_key
  changed_when: false

- name: Get or set the user's home directory
  stat:
    path: "{{ home_dir }}"
  changed_when: false
  register: home_stat

- name: Create the user's .ssh directory
  file:
    path: "{{ home_dir }}/.ssh"
    state: directory
    mode: '750'

- name: Deploy authorized keys for the user
  authorized_key:
    user: "{{ user_name }}"
    key: "{{ item }}"
    state: present
  with_items: "{{ authorized_keys }}"
  vars:
    file_mode: '600'

- name: Remove unauthorized keys for the user
  authorized_key:
    user: "{{ user_name }}"
    key: "{{ item }}"
    state: absent
  with_items: "{{ unauthorized_keys }}"

- name: Copy the generated private SSH key for the user
  copy:
    src: "{{ ssh_key_dir }}/id_rsa"
    dest: "{{ home_dir }}/.ssh/id_rsa"
    remote_src: yes
  when: copy_private_key
  vars:
    file_mode: '400'

- name: Check the user's password validity
  command: chage -l "{{ user_name }}"
  changed_when: false
  register: users_pw_valid

- name: Set the user's password validity
  command: chage -M {{ password_max_days }} "{{ user_name }}"
  when: users_pw_valid.stdout_lines[0].days_invalidated | int > 0 and password_max_days is defined

- name: Place the private key file for the user
  copy:
    src: "{{ ssh_key_dir }}/id_rsa"
    dest: "{{ home_dir }}/.ssh/id_rsa"
    remote_src: yes
  when: private_keys is defined
  vars:
    file_mode: '400'


