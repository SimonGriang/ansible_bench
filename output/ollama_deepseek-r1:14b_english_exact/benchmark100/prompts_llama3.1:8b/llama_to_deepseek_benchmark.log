---
- name: Import cron configuration from assert.yml file
  import_tasks: assert.yml
  remote_host: localhost

- name: Install required packages for cron service
  apt:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell environment for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL=/{{ cron_shell }}"
    create: true

- name: Configure system path for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH=/{{ cron_path }}"
    create: true

- name: Configure mailto parameter for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto | default('') }}"
    create: true

- name: Start and enable the cron service
  systemd:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service | bool

- name: Schedule the requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default('*/5') }}"
    hour: "{{ item.hour | default('*') }}"
    day: "{{ item.day | default('*') }}"
    month: "{{ item.month | default('*') }}"
    weekday: "{{ item.weekday | default('*') }}"
    special_time: "{{ item.special_time | default('') }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs | bool

