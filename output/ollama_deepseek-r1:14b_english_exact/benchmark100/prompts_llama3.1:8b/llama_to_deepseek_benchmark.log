- name: Remove any packages that conflict with the core dependencies
  ansible.builtin.apt:
    name: "{{ conflicting_packages }}"
    state: absent
  become: true

- name: Install all the core dependencies
  ansible.builtin.apt:
    name: "{{ core_dependencies_packages }}"
    state: present
    update_cache: true
  become: true

- name: Trigger a handlers run
  ansible.builtin.meta:
