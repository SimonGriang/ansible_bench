---
- name: Load OS-specific variables based on the detected operating system
  include_vars:
    dir: "{{ansible_dir}}/vars/{{ansible_os_family}}"

- name: Include setup tasks for RedHat-based systems
  import_tasks: redhat.yml
  when: ansible_os_family == "RedHat"

- name: Include setup tasks for Debian-based systems
  import_tasks: debian.yml
  when: ansible_os_family == "Debian"

- name: Install Docker packages
  become: yes
  package:
    name: "{{docker_packages}}"
    state: present
  when: ansible_version < '2.12' or ansible_os_family not in ['RedHat', 'Debian']

- name: Install Docker packages (with downgrade option)
  become: yes
  package:
    name: "{{docker_packages}}"
    state: present
    version: "{{docker_package_version}}"
  when: ansible_version >= '2.12' and ansible_os_family in ['RedHat', 'Debian']

- name: Install the docker-compose plugin
  become: yes
  package:
    name: docker-compose-plugin
    state: present
  when: docker_compose_plugin_enabled and (ansible_version < '2.12' or ansible_os_family not in ['RedHat', 'Debian'])

- name: Install the docker-compose-plugin (with downgrade option)
  become: yes
  package:
    name: docker-compose-plugin
    state: present
    version: "{{docker_compose_plugin_version}}"
  when: docker_compose_plugin_enabled and ansible_version >= '2.12' and ansible_os_family in ['RedHat', 'Debian']

- name: Ensure the /etc/docker/ directory exists and has the correct permissions
  become: yes
  file:
    path: /etc/docker
    state: directory
    mode: "0755"

- name: Configure the Docker daemon options
  become: yes
  copy:
    content: "{{docker_daemon_options | to_yaml}}"
    dest: /etc/docker/daemon.json
    mode: "0644"

- name: Ensure Docker is started and enabled at boot, if configured to do so
  become: yes
  service:
    name: docker
    state: started
    enabled: yes
  when: docker_service_enabled

- name: Notify handlers to ensure firewall rules are updated
  notify: update_firewall_rules

- name: Include tasks for managing docker-compose, if enabled
  import_tasks: docker-compose.yml
  when: docker_compose_enabled

- name: Get information about the docker group using getent
  command: getent group docker
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  command: cut -d: -f1 /etc/passwd | sort
  register: user_list

- name: Include tasks for managing docker users, if necessary
  import_tasks: docker-users.yml
  when: docker_users_to_add | length > 0


