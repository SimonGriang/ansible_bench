---
- import_tasks: assert.yml
  hosts: localhost
  run_once: true

- name: Install the required packages for selinux
  ansible.builtin.package:
    name: "{{ selinux_requirements | default([]) | list }}"
    state: present
  notify: Gather facts

- name: Flush the handlers
  ansible.builtin.meta:
    flush_handlers: yes

- name: Configure selinux based on the selinux state and policy
  ansible.posix.selinux:
    enabled: "{{ selinux_state | default('disabled') }}"
    policy: "{{ selinux_policy | default('') }}"
    state: present
  when:
    - ansible_system == 'Linux'
    - ansible_connection != 'docker'
    - selinux_state | default('disabled') == 'enabled'
  notify: Reboot

- name: Manage selinux booleans
  ansible.posix.seboolean:
    name: "{{ item.key }}"
    value: "{{ item.value.value | default('undefined') }}"
    state: "{{ item.value.state | default('present') }}"
    persistent: yes
  when:
    - (selinux_booleans | default({}) | dict.items() | list) | bool
    - ansible_system == 'Linux'
    - ansible_connection != 'docker'
    - selinux_state | default('disabled') == 'enabled'
  loop: "{{ selinux_booleans | default({}) | dict.items() }}"

handlers:
    - name: Gather facts
      ansible.builtin.fact_path:
        path: /usr/bin/facter

    - name: Reboot
      ansible.builtin.reboot:
        reboot_timeout: 60s


