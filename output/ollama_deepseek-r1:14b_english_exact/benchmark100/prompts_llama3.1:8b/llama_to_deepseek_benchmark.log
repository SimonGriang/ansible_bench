---
- name: Ensure old versions of Docker are not installed
  yum:
    name:
      - docker
      - docker-engine
      - docker-engine-selinux
      - docker-selinux
    state: absent

- name: Add Docker GPG key
  rpm_key:
    key: (https://download.docker.com/linux/centos/7/x86_64/stable/Packages/
          docker-ce-selinux-1.3.0-1.el7.centos.x86_64.rpm)
    state: present

- name: Add Docker repository
  yum:
    name: https://download.docker.com/linux/centos/7/x86_64/stable/Packages/
          docker-ce.repo
    state: downloaded
    mode: 644

- name: Configure Docker Nightly repo and Docker Test repo
  file:
    path: /etc/yum.repos.d/docker.repo
    content: |
      [docker-nightly]
      name=Docker Nightly
      mirrorlist=https://download.docker.com/linux/centos/7/x86_64/nightly/mirror.list
      enabled={{ docker_yum_repo_enable_nightly }}
      gpgcheck=1
      gpgkey=https://download.docker.com/linux/centos/7/x86_64/stable/Packages/
             docker-ce-selinux-1.3.0-1.el7.centos.x86_64.rpm

      [docker-test]
      name=Docker Test
      mirrorlist=https://download.docker.com/linux/centos/7/x86_64/test/mirror.list
      enabled={{ docker_yum_repo_enable_test }}
      gpgcheck=1
      gpgkey=https://download.docker.com/linux/centos/7/x86_64/stable/Packages/
             docker-ce-selinux-1.3.0-1.el7.centos.x86_64.rpm

- name: Configure containerd on RHEL 8
  yum:
    name:
      - container-selinux
      - containerd.io
    state: present
  become: yes
  shell: |
    dnf remove -y runc
    systemctl daemon-reload
    systemctl enable containerd
    systemctl start containerd


