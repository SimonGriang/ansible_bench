---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: rancher
    group: rancher
    mode: 0755

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config_source }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: rancher
    group: rancher
    mode: 0644
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_source }}"
    dest: /etc/rancher/rke2/kubelet.yaml
    owner: rancher
    group: rancher
    mode: 0644
  when: rke2_kubelet_config is not empty
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_config_source }}"
    dest: /etc/rancher/rke2/registry.config.yml
    owner: rancher
    group: rancher
    mode: 0644
  when: rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty
  notify: Config file changed

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: rke2-{{ rke2_type }}
    state: started
    enabled: yes
    force: yes
    retry_on_failure: yes
    delay: 10s
  notify: Service (re)started

- name: Mask other RKE2 service on the rest of the nodes
  systemd:
    name: rke2-{{ item }}
    state: masked
  loop: "{{ rke2_services | reject_if('eq', rke2_type) | list }}"

- name: Wait for remaining nodes to be ready - no CNI
  wait_for_task:
    path: "{{ rke2_node_status_url }}"
    status: ready
    ignore_error: yes
    retries: 120
    delay: 30s
  loop: "{{ rke2_nodes | list }}"

- name: Wait for remaining nodes to be ready - with CNI
  wait_for_task:
    path: "{{ rke2_node_status_url }}"
    status: ready
    ignore_error: yes
    retries: 120
    delay: 30s
    until: (ansible_hostname == rke2_active_server or
             ansible_hostname == (rke2_servers | first | ansible_hostname)) and
           (rke2_nodes | count == rke2_nodes | ready | count)
  when: rke2_cni_enabled


