---
- name: Manage group with specified name and state
  ansible.builtin.group:
    name: "{{ group.name }}"
    state: present
    gid: "{{ group.gid | default('') }}"
    system: "{{ group.system | default('no') }}"

- name: Configure sudo options for a group
  community.general.sudoers:
    name: "{{ group.name }}"
    template: sudo_group.j2
    mode: "0640"
    validate_on_save: /usr/bin/visudo
    state: present
  when: group.sudo_options is defined
  become: true


