---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Set server taints
  set_fact:
    rke2_node_taints: "{{ rke2_server_node_taints | default('') | join(',') }}"
  when: rke2_server_type == 'server'

- name: Copy RKE2 config
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed
  when: rke2_kubelet_config|length > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed
  when: (rke2_custom_registry_mirrors|length > 0) or (rke2_custom_registry_configs|length > 0)

- name: Register etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: (rke2_etcd_snapshot_file|length > 0) and 
        (rke2_server_service_path is not defined or 
         (rke2_server_service_path.statements is defined and 
          rke2_server_service_path.statements.status == 'disabled'))

- name: Register etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file|length > 0 and 
        rke2_etcd_snapshot_s3_options is defined and 
        rke2_etcd_snapshot_s3_options.access_key is defined and 
        rke2_etcd_snapshot_s3_options.secret_key is defined and 
        rke2_etcd_snapshot_s3_options.bucket is defined and 
        rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  shell: |
    mkdir -p /var/lib/rke2/etcd/snapshot
    cp {{ rke2_etcd_snapshot_file }} /var/lib/rke2/etcd/snapshot/etcd-snapshot
    rke2 server --config=/etc/rancher/rke2/config.yaml etcd restore-snapshot --name etcd-snapshot
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  shell: |
    mkdir -p /var/lib/rke2/etcd/snapshot
    rke2 server --config=/etc/rancher/rke2/config.yaml etcd restore-snapshot --name 
    {{ rke2_etcd_snapshot_s3_options.snapshot_name }} --bucket {{ rke2_etcd_snapshot_s3_options.bucket }} 
    --access-key {{ rke2_etcd_snapshot_s3_options.access_key }} --secret-key 
    {{ rke2_etcd_snapshot_s3_options.secret_key }}
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
    environment: "RKE2_TOKEN={{ rke2_token }}"
  when: ansible_hostname == rke2_cluster_group_list[0]

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    state: masked

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: /bin/kubectl
    state: started
  until: (kubectl get nodes | grep -v 'No resources' | grep 'Not ready' | wc -l) | eq 0
  retries: 30
  delay: 30
  when: rke2_cni is absent

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: /bin/kubectl
    state: started
  until: (kubectl get nodes | grep -v 'No resources' | grep 'Ready' | wc -l) | eq 1
  retries: 30
  delay: 30
  when: rke2_cni is present

- name: Restore etcd
  block:
    - name: Remove old etcd secrets
      shell: |
        rm -rf /etc/kubernetes/ssl
    - name: Remove old etcd nodes
      shell: kubectl delete nodes --all
    - name: Create new etcd nodes
      shell: kubectl create -f /etc/rancher/rke2/etcd.yaml

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ rke2_cluster_group_name.split()[0] }}"


