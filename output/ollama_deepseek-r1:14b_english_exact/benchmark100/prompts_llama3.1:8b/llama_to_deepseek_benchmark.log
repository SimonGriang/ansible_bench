    subject: CN=example.com, C=US, ST=California, L=San Francisco, O=Example Inc., OU=IT
    mode: 0640
    owner: nginx
    group: nginx

- name: Create SSL certificates
  openssl_certificate:
    path: /etc/ssl/certs/nginx.pem
    provider: selfsigned
    csr_path: /etc/ssl/certs/nginx
    csr.pem: true
    validity: 365
    mode: 0640
