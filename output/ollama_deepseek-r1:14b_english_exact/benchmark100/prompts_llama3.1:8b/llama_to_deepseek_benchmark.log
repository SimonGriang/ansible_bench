---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: "temurin"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "vars/os_{{ java_jdk_vendor | lower }}.yml"
  when: java_jdk_vendor | ansible.utilsTruthy

- name: Gather architecture specific variables
  include_vars:
    file: architecture.yml

- name: Set OS-specific variables (I)
  set_fact:
    java_open_jdk_version: "{{ java_open_jdk_version | default('8') }}"
    java_open_jdk_type: "{{ java_open_jdk_type | default('jdk') }}"
    java_open_jdk_distribution: "{{ java_open_jdk_distribution | default('latest') }}"
  when: java_open_jdk_version | ansible.utilsTruthy

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/{{ java_open_jdk_vendor }}') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('{{ java_open_jdk_vendor }}{{ java_open_jdk_version }}{{ java_open_jdk_distribution }}') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt:
        name: "{{ item }}"
        state: absent
        update_cache: yes
      with_items: "{{ java_deprecated_repos }}"

    - name: Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
        update_cache: yes
      with_items: "{{ java_extra_apt_tools }}"

    - name: Add required key repositories
      apt_key:
        keyserver: "{{ item.keyserver }}"
        key: "{{ item.key }}"
        state: present
      with_items: "{{ java_apt_keys }}"

    - name: Add required repositories
      apt_repository:
        repo: "{{ item.url }}"
        state: present
        update_cache: yes
      with_items: "{{ java_apt_repos }}"
  when: ansible_os_family == "Debian"

- name: RedHat pre-requisites
  block:
    - name: Add required key repositories
      rpm_key:
        key: "{{ item.key }}"
        state: present
        url: "{{ item.url }}"
      with_items: "{{ java_rpm_keys }}"

    - name: Add required repositories
      yum:
        name: "{{ item.url }}"
        state: present
      with_items: "{{ java_yum_repos }}"
  when: ansible_os_family == "RedHat"

- name: Install required libs
  apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ java_required_libs | default([]) }}"

- name: Install Java, Debian
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
    update_cache: yes
  when: ansible_os_family == "Debian"

- name: Install Java, RedHat
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: 0755

- name: Source environment variables
  shell: source /etc/profile

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  file:
    path: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java"
    state: link
    target: "{{ java_open_jdk_home_dir }}/bin/java"
  when: java_version < 11

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  file:
    path: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java"
    state: link
    target: "{{ java_open_jdk_home_dir }}/bin/java"
  when: java_version >= 11

