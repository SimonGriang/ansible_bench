orized_keys }}"\n\n- name: Copy the generated private SSH key for the user\n  copy:\n    src: "{{ ssh_key_dir }}/id_rsa"\n    dest: "{{ home_dir }}/.ssh/id_rsa"\n    remote_src: yes\n  when: copy_private_key\n  vars:\n    file_mode: \'400\'\n\n- name: Check the user\'s password validity\n  command: chage -l "{{ user_name }}"\n  changed_when: false\n  register: users_pw_valid\n\n- name: Set the user\'s password validity\n  command: chage -M {{ password_max_days }} "{{ user_name }}"\n  when: users_pw_valid.stdout_lines[0].days_invalidated | int > 0 and password_max_days is defined\n\n- name: Place the private key file for the user\n  copy:\n    src: "{{ ssh_key_dir }}/id_rsa"\n    dest: "{{ home_dir }}/.ssh/id_rsa"\n    remote_src: yes\n  when: private_keys is defined\n  vars:\n    file_mode: \'400\'\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-13T10:16:41.621587633Z', 'done': True, 'done_reason': 'stop', 'total_duration': 30368391766, 'load_duration': 105755639, 'prompt_eval_count': 1132, 'prompt_eval_duration': 506322591, 'eval_count': 1570, 'eval_duration': 29754394292, 'model_name': 'deepseek-r1:14b'} id='run--9fad1089-6d12-4de0-820a-5c7c26847abd-0' usage_metadata={'input_tokens': 1132, 'output_tokens': 1570, 'total_tokens': 2702}
