---
- hosts: all
  tasks:
    - name: Import assert.yml
      import_tasks:
        file: assert.yml
        delegate_to: localhost
        run_once: yes
      become: yes

    - name: Enable redis module stream (RHEL 8)
      dnf:
        name: redis
        state: installed
        repo: redhat_eulerc8

    - name: Install redis
      package:
        name: "{{ redis_packages }}"
        state: present

    - name: Configure redis
      copy:
        remote_src: yes
        remote_path: /etc/redis.conf
        owner: "{{ redis_owner }}"
        group: "{{ redis_group }}"
        mode: "{{ redis_mode }}"
        notify: Restart redis

    - name: Start and enable redis
      service:
        name: "{{ redis_service }}"
        state: started
        enabled: yes


