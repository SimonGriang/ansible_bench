---
- name: Task 1: Import assert.yml file
  include_tasks:
    file: /path/to/assert.yml
    host: localhost
  args:
    changed_when: false

- name: Task 2: Install prerequisites
  apt:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Task 3: Include installation method specific tasks
  include_tasks: files/installation_methods/{{ vault_installation_method }}.yml

- name: Task 4: Add Vault environment variables
  template:
    dest: /etc/vault.d/vault.env
    content: "{{ vault_environment_settings }}"
  notify: restart vault service

- name: Task 5: Include hardening tasks
  include_tasks: hardening.yml

- name: Task 6: Start and enable vault on OSS
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Task 7: Enable vault (non-OSS)
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type != "oss"


