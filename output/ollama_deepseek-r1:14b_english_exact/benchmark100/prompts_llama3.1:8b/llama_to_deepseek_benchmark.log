---
- name: Import assert.yml file for task execution and skip the rest of the tasks on the first run
  include_tasks: assert.yml
  condition: false

- name: Pre-configure Debian systems for postfix installation
  debconf:
    name: postfix/main_mailer_type
    value: "No configuration"

- name: Install postfix package
  package:
    name: postfix
    state: present

- name: Install postfix-mysql package if specific conditions are met
  package:
    name: postfix-mysql
    state: present
  when: "'mysql' in postfix_virtual_mailbox_maps or 'mysql' in postfix_virtual_mailbox_domains or 'mysql' in postfix_virtual_alias_maps"

- name: Configure postfix transport maps
  copy:
    src: postfix_transport
    dest: /etc/postfix/transport
    owner: postfix
    group: postfix
    mode: 0644
  notify: 
    - validate_postfix_transport_maps
    - postfix_rebuild_maps

- name: Configure postfix header checks
  copy:
    src: postfix_header_checks
    dest: /etc/postfix/header_checks
    owner: postfix
    group: postfix
    mode: 0644
  notify: 
    - validate_postfix_header_checks
    - postfix_reload

- name: Set values for the main.cf file
  set_fact:
    postfix_main_cf: "{{{
        recipient_access = {{postfix_recipient_access}}
        sender_access = {{postfix_sender_access}}
        mynetworks = {{postfix_mynetworks}}
        mydestination = {{postfix_mydestination}}
        relay_domains = {{postfix_relay_domains}}
        smtpd_recipient_restr = {{postfix_smtpd_recipient_restrictions}}
        smtpd_sender_restr = {{postfix_smtpd_sender_restrictions}}
        virtual_mailbox_domains = {{postfix_virtual_mailbox_domains}}
        virtual_alias_domains = {{postfix_virtual_alias_domains}}
    }}"

- name: Configure postfix main.cf
  copy:
    src: postfix_main
    dest: /etc/postfix/main.cf
    owner: postfix
    group: postfix
    mode: 0644
  notify: 
    - validate_postfix_main
    - postfix_reload

- name: Configure postfix master.cf
  copy:
    src: postfix_master
    dest: /etc/postfix/master.cf
    owner: postfix
    group: postfix
    mode: 0644
  notify: 
    - validate_postfix_master
    - postfix_reload

- name: Create a directory for TLS certificates and keys
  file:
    path: /etc/postfix/tls
    state: directory
    mode: 0755

- name: Deploy Postfix TLS server certificate
  copy:
    src: postfix_server_cert
    dest: /etc/postfix/tls/smtpd.cert
    owner: postfix
    group: postfix
    mode: 0644
  notify: postfix_reload

- name: Deploy Postfix TLS server key
  copy:
    src: postfix_server_key
    dest: /etc/postfix/tls/smtpd.key
    owner: postfix
    group: postfix
    mode: 0644
  notify: postfix_reload

- name: Flush handlers
  flush_handlers:

- name: Configure aliases
  copy:
    src: "{{postfix_aliases}}"
    dest: /etc/postfix/aliases
    owner: postfix
    group: postfix
    mode: 0644
  notify: 
    - postfix_rebuild_aliases
    - postfix_reload

- name: Configure sender_access
  copy:
    content: "{{postfix_sender_access}}"
    dest: /etc/postfix/sender_access
    owner: postfix
    group: postfix
    mode: 0644
  notify: 
    - postfix_rebuild_sender_access
    - postfix_reload

- name: Configure recipient_access
  copy:
    content: "{{postfix_recipient_access}}"
    dest: /etc/postfix/recipient_access
    owner: postfix
    group: postfix
    mode: 0644
  notify: 
    - postfix_rebuild_recipient_access
    - postfix_reload

- name: Place sasl_password_map
  copy:
    content: "{{postfix_smtp_sasl_password_map_content}}"
    dest: /etc/postfix/smtp_sasl_password_map
    owner: postfix
    group: postfix
    mode: 0644
  notify: postfix_rebuild_sasl_password_map

- name: Flush handlers again
  flush_handlers:

- name: Start and enable postfix service
  service:
    name: postfix
    state: started
    enabled: true


