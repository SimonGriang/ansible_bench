---
- name: Import the assert.yml file to include additional tasks
  import_tasks: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install the required packages for selinux
  ansible.builtin.package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush the handlers to ensure all pending tasks are executed
  ansible.builtin.meta:
    command: flush_handlers

- name: Configure selinux based on the selinux state and policy
  ansible.posix.selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
   MLS:
      enabled: yes
    when: ansible_system in ['Linux'] and notdocker
  notify: Reboot

- name: Manage selinux booleans
  ansible.posix.seboolean:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    persistent: "{{ item.persistent }}"
    state: "{{ item.state }}"
  loop: "{{ selinux_booleans | default([]) }}"
  when: selinux_booleans | default([]) | length > 0


