---
- name: Import external tasks for assertion handling
  import_tasks: assert.yml
  vars:
    assert_tasks: "{{ assert_tasks | default([]) | list }}"

- name: Install the cron package
  ansible.builtin.package:
    name: "{{ cron_packages | default('cron') }}"
    state: present

- name: Configure shell settings for cron jobs
  ansible.builtin.lineinfile:
    path: /etc/crontab
    line: "SHELL={{ cron_shell | default('/bin/sh') }}"
    insertafter: 'CRONJOBS'

- name: Configure the system path for cron jobs
  ansible.builtin.lineinfile:
    path: /etc/crontab
    line: "PATH={{ cron_path | default('/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin') }}"
    insertafter: 'SHELL'

- name: Configure the mail-to setting for cron jobs
  ansible.builtin.lineinfile:
    path: /etc/crontab
    line: "MAILTO={{ cron_mailto | default('root') }}"
    insertafter: 'PATH'

- name: Start and enable the cron service
  ansible.builtin.service:
    name: "{{ cron_service | default('cron') }}"
    state: started
    enabled: true

- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    cron_schedule: "{{ item.schedule }}"
    command: "{{ item.job }}"
  loop: "{{ cron_jobs | default([]) | list }}"


