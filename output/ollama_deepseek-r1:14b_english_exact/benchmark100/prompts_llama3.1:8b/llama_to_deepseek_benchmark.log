---
- name: Gather basic system facts
  raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  become: false

- name: Extract distribution name and major version
  set_fact:
    bootstrap_distribution: "{{ item.value | regex_replace('\''|\\'|, '') }}"
    bootstrap_distribution_major_version: "{{ item.value | regex_replace('\''|\\'|, '') }}"
  with_items:
    - "{{ bootstrap_facts.stdout_lines | selectattr('contains', '/NAME=') | list }}"
    - "{{ bootstrap_facts.stdout_lines | selectattr('contains', '/VERSION_ID=') | list }}"
  loop_control:
    label: "{{ item.key }}"

- name: Identify operating system family
  set_fact:
    bootstrap_os_family: "{{ item.value if item.key == bootstrap_distribution else skipped }}"
  with_dict: "{{ bootstrap_os_family_map }}"
  loop_control:
    default: 'Other'


