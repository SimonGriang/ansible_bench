---
- name: Import assert.yml
  include: assert.yml

- name: Install the MySQL package
  apt:
    name: mysql-server
    state: present
  notify: 
    - set_mysql_root_password
    - systemctl_daemon_reexec

- name: Configure the MySQL server
  ini_file:
   dest: /etc/mysql/server.cnf
    sections:
      mysqld:
        {{ mysql_configuration_options }}
  notify: 
    - restart_mysql

- name: Configure the MySQL client
  ini_file:
    dest: /etc/mysql/client.cnf
    sections:
      mysql:
        socket: "{{ mysql_socket }}"

- name: Initialize the MySQL database
  shell: "{{ mysql_initialize_command }}"
  ignore_errors: yes

- name: Start and enable the MySQL service
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta:
    flush_handlers: yes

- name: Place the my.cnf file
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0600

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"
  no_log: true

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges | join(',') }}"
  loop: "{{ mysql_users }}"
  no_log: true

- name: Flush handlers again
  meta:
    flush_handlers: yes


