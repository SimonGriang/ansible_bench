---
- name: Create the directory for RKE2 manifests
  file:
    path: /etc/rke2/manifests
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Copy kube-vip YAML files to the RKE2 manifests directory
  copy:
    remote_src: yes
    src: "{{ item }}"
    dest: /etc/rke2/manifests/
    mode: 0644
    owner: root
    group: root
  loop: "{{ lookup('fileglob', 'templates/kube-vip*.yaml.j2') | list }}"
  register: copied_files
  changed_when: false
  ignore_errors: yes
  vars:
    remote_src: "{{ item | regex_replace('.j2', '') }}"

- name: Copy kube-vip load balancer manifests to the RKE2 manifests directory
  copy:
    remote_src: yes
    src: "{{ item }}"
    dest: /etc/rke2/manifests/
    mode: 0644
    owner: root
    group: root
  loop: "{{ lookup('fileglob', 'templates/kube-vip-lb*.yaml.j2') | list }}"
  when: rke2_kubevip_cloud_provider_enable
  register: copied_lb_files
  changed_when: false
  ignore_errors: yes
  vars:
    remote_src: "{{ item | regex_replace('.j2', '') }}"


