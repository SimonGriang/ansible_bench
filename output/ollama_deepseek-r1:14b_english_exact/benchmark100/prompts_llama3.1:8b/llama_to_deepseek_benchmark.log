  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: 0755

- name: Copy local RKE2 installation script
  copy:
    src: "{{ local_install_script_path }}"
    dest: "{{ rke2_install_script_path }}"
    mode: 0755
  when:
    - airgap_mode
    - implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0755
  when:
    - airgap_mode
    - implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ rke2_checksum_url }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0755
  when:
    - airgap_mode
    - implementation == 'download'
  register: download_result
  ignore_errors: yes

- name: Fall back to local download and push
  get_url:
    url: "{{ local_rke2_checksum_url }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0755
  when:
    - airgap_mode
    - implementation == 'download'
    - download_result|failed
  ignore_errors: yes

- name: Create directory for additional images tarballs
  file:
    path: "{{ additional_images_path }}"
    state: directory
    mode: 0755
  when:
    - airgap_mode
    - implementation != 'exists'
    - additional_tarballs | length > 0

- name: Copy RKE2 components to additional images directory
  copy:
    src: "{{ rke2_components_path }}"
    dest: "{{ additional_images_path }}"
    mode: 0755
  when:
    - airgap_mode
    - implementation != 'exists'
    - additional_tarballs | length > 0

- name: Ensure RKE2 artifacts exist and have correct permissions
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0755
  when:
    - airgap_mode
    - implementation == 'exists'

- name: Populate service facts
  ansible.builtin.service_facts:
    gather_subset: services

- name: Get stats of the FS object
  stat:
    path: "{{ rke2_bin_path }}"

- name: Check if separate partition
  shell: "grep -q '^/dev/[^/].*$' /proc/mounts"
  register: partition_check

- name: Set RKE2 bin path
  shell: "if [ -w /usr/local ] && [[ $(grep -q '^/dev/[^/].*$' /proc/mounts) ]]; then echo '/usr/local/bin'; else echo '{{ rke2_bin_path }}'; fi"
  register: rke2_bin_path_result

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }}/rke2-node version && systemctl status rke2-node | grep Version"
  register: rke2_version_check

- name: Set RKE2 versions
  set_fact:
    current_version: "{{ rke2_version_check.stdout }}"
    desired_version: "{{ rke2_version }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - current_version >= desired_version
  when:
    - current_version is defined
    - desired_version is defined

- name: Run RKE2 install script
  shell: "{{ rke2_bin_path }}/rke2-node install --token '{{ rke2_token }}' --ignore-version {{ rke2_install_vars }}"
  when:
    - rke2_version is defined
    - current_version != desired_version

- name: Copy Custom Manifests
  copy:
    src: "{{ custom_manifests_path }}"
    dest: "{{ rke2_manifests_path }}"
    mode: 0755
  when:
    - custom_manifests_path is defined

- name: Copy Static Pods
  copy:
    src: "{{ static_pods_path }}"
    dest: "{{ rke2_static_pods_path }}"
    mode: 0755
  when:
    - static_pods_path is defined

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file_path }}"
    dest: "{{ rke2_env_file_dest }}"
    mode: 0755
  when:
    - rke2_env_file_path is defined


