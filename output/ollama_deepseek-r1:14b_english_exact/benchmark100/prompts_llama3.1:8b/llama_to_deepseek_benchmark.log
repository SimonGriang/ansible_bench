---
- name: Import and execute tasks from assert.yml playbook fragment
  import_tasks:
    file: assert.yml
  loop: once
  when: ansible_hostname == 'localhost'

- name: Install logrotate package
  apt:
    name: logrotate
    state: present

- name: Configure logrotate by rendering a template
  template:
    src: logrotate.conf.j2
    dest: /etc/logrotate.conf
    mode: 0644

- name: Generate logrotate.d files using a template
  template:
    src: entry.j2
    dest: /etc/logrotate.conf.d/{{ item.name }}
    mode: 0644
  with_items:
    "{{ logrotate_entries | default([]) | rejectattr('absent', 'bool') | list }}"
  loop_control:
    label: "{{ item.name }}"

- name: Remove logrotate.d files
  file:
    path: /etc/logrotate.conf.d/{{ item.name }}
    state: absent
  with_items:
    "{{ logrotate_entries | default([]) | selectattr('absent') | list }}"
  loop_control:
    label: "{{ item.name }}"

- name: Manage logrotate service
  systemctl:
    name: "{{ logrotate_service_name | default('logrotate') }}"
    state: "{{ logrotate_service_state | default('running') }}"
    enabled: "{{ logrotate_service_enabled | default('yes') }}"
  when: logrotate_service_name is not empty

