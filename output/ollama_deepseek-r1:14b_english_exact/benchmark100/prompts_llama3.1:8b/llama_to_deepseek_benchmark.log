---
- name: Ensure old versions of Docker are not installed on Ubuntu
  apt:
    name:
      - docker-engine
      - docker-engine-selinux
    state: absent
  tags: [docker, cleanup]

- name: Ensure old versions of Docker are not installed on CentOS
  dnf:
    name:
      - docker
      - docker-selinux
    state: absent
  tags: [docker, cleanup]

- name: Add Docker GPG key on Ubuntu
  apt_key:
    keyserver: hkp://keyserver.ubuntu.com:80
    key: 9FD3B82470BC22BD5355832081BDC5065F0682C4
    state: present
  tags: [docker, key]

- name: Add Docker GPG key on CentOS
  yum:
    key: https://download.docker.com/linux/centos/gpg
    state: present
  tags: [docker, key]

- name: Add Docker repository on Ubuntu
  apt:
    repo: "deb [arch=$(dpkg --print-architecture) 201604.0] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable"
    state: present
  tags: [docker, repo]

- name: Add Docker repository on CentOS
  yum:
    name: docker-ce-yum
    state: present
  tags: [docker, repo]

- name: Configure Docker Nightly repo on Ubuntu
  apt:
    repo: "deb [arch=$(dpkg --print-architecture) 201604.0] https://download.docker.com/linux/ubuntu experimental $(lsb_release -cs)"
    state: present
  tags: [docker, repo, nightly]
  when: docker_yum_repo_enable_nightly

- name: Enable Docker Test repository on CentOS
  yum:
    name: docker-ce-test
    state: present
  tags: [docker, repo, test]
  when: docker_yum_repo_enable_test

- name: Remove runc on RHEL 8
  dnf:
    name: runc
    state: absent
  tags: [containerd, cleanup]

- name: Install containerd packages on RHEL 8
  dnf:
    name:
      - container-selinux
      - containerd.io
    state: present
  tags: [containerd, install]


