---
- name: Enable Apache2 proxy and proxy_http modules
  become: true
  community.general.apache2_module:
    module_name: proxy
    state: enabled
  when: ansible_os_family in ["Debian", "Suse"]

- name: Enable Apache2 proxy_http module
  become: true
  community.general.apache2_module:
    module_name: proxy_http
    state: enabled
  when: ansible_os_family in ["Debian", "Suse"]

- name: Configure Apache2 locations
  template:
    src: location.conf.j2
    dest: /etc/httpd/conf.d/location.conf
    mode: 0644
    loop: "{{ httpd_locations }}"
    variables:
      label: "{{ item.label }}"
  notify: httpd_test_and_restart


