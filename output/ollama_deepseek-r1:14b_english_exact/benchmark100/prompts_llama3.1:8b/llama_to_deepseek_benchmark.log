---
- name: Import assert.yml tasks for httpd role
  import_tasks: assert.yml
  remote_host: localhost
  run_once: true

- name: Install Apache HTTP Server
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure SELinux settings for httpd service
  ansible.builtin.seboolean:
    name: "{{ item }}"
    state: enabled
    persistent: yes
  when: ansible.selinux.is_configured
  with_items: "{{ httpd_sebooleans }}"

- name: Allow connections to custom ports
  ansible.builtin.seboolean:
    name: httpd_port_t
    state: permit
    persistent: yes
  when: ansible.selinux.is_configured and httpd_port is defined

- name: Allow SSL port if defined
  ansible.builtin.seboolean:
    name: httpd_port_t
    state: permit
    persistent: yes
  when: ansible.selinux.is_configured and https_ssl_enable is defined

- name: Configure Apache HTTP Server
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "{{ httpd_config_mode }}"
  notify: [Test httpd configuration validity, Restart httpd]

- name: Activate Apache modules on Debian
  ansible.builtin.command:
    cmd: a2enmod "{{ item }}"
  when: ansible.system.is_debian
  with_items: "{{ httpd_modules_to_activate_with_command }}"

- name: Import SSL configuration tasks
  import_tasks: ssl.yml
  when: https_ssl_enable is defined

- name: Import locations configuration tasks
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual hosts configuration tasks
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure custom ports on Debian and Suse
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_ports_dest }}"
  notify: [Test httpd configuration validity, Restart httpd]
  when: ansible.system.is_debian or ansible.system.is_suse

- name: Import directories configuration tasks
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.meta:
    command: flush_handlers

- name: Remove default index.html
  ansible.builtin.file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example is defined

- name: Start and enable Apache HTTP Server
  ansible.builtin.service:
    name: "{{ httpd_service_name }}"
    state: started
    enabled: yes

