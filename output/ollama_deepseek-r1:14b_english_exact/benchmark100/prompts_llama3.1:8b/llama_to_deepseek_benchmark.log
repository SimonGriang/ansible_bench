- name: Remove externally managed configuration from Debian 12 systems
  include_tasks: debian-12-external-config.yml
  when: 
    ansible_distribution: Debian
    ansible_distribution_major_version: 12

- name: Install the Pip package on the system
  apt:
    name: python3-pip
    state: present

- name: Install the python3-packaging package via DNF
  yum:
    name: python3-packaging
    state: present

- name: Install pip packages specified in the pip_install_packages list
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default('') }}"
    virtualenv: "{{ item.virtualenv | default('') }}"
    state: "{{ item.state | default('present') }}"
    extra_args: "{{ item.extra_args | default('') }}"
    executable: "{{ item.executable | default('pip3') }}"
  loop: "{{ pip_install_packages | default([]) }}"


