---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  tags: always

- name: Wait for a specified port to become available
  wait_for_port:
    state: present
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
    community.docker.docker: false
    delegate_to: localhost
    skip_on_failure: true
  when: bootstrap_wait_for_host is defined and not (ansible_python_version == 'docker' or ansible_container_type in ['docker', 'containerd', 'podman'])

- name: Prepare the system for further tasks
  command: whoami
  register: bootstrap_connect
  changed_when: false
  tags: always
  when: not ansible_python_version == 'docker'
  ignore_errors: yes
  vars:
    ansible_sudo_enable: yes
  register: bootstrap_connect

- name: Gather Ansible facts about the system
  setup:
    gather_subset: all
  tags: always

- name: Install bootstrap packages (package)
  apt:
    name: "{{ bootstrap_facts_packages | default([]) | list }}"
    state: present
    update_cache: yes
  when: bootstrap_become
  tags: always


