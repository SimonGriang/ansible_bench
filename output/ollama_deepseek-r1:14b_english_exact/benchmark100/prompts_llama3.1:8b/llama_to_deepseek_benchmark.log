---
- name: Create etcd group
  group:
    name: etcd
    state: present

- name: Create etcd user and assign to etcd group
  user:
    name: etcd
    group: etcd
    shell: /bin/nologin
    state: present

- name: Check if /usr/local/share is writable
  shell: test -w /usr/local/share
  register: is_writable

- name: Copy sysctl config for kernel hardening
  copy:
    remote_src: yes
    dest: /etc/sysctl.d/99-etcd.conf
    src: |
      {{ 
        'files/etcd-sysctl-hardening-nosuidmai.txt' 
        if is_writable.stdout == '0' 
        else 'files/etcd-sysctl-hardening.txt' 
      }}
  notify: Restart systemd-sysctl

- name: Flush handlers
  meta: flush_handlers

