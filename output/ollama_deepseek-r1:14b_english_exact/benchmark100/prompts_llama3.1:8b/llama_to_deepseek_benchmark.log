y.\n</think>\n\n```yaml\n---\n- name: Populate services facts\n  ansible.builtin.systemd:\n    list: yes\n  register: services_facts\n\n- name: Set the Active Server variable\n  ansible.builtin.set_fact:\n    active_server: "{{ ansible_hostname }}"\n  when:\n    - ansible_hostname in group_vars[\'rke2_servers_group_name\']\n    - "\'rke2-server\' in services_facts.services.keys()"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-23T17:53:03.983534659Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9880042848, 'load_duration': 2499337745, 'prompt_eval_count': 282, 'prompt_eval_duration': 246971734, 'eval_count': 517, 'eval_duration': 7132374865, 'model_name': 'deepseek-r1:14b'} id='run--c1f7ab44-8bc3-4941-94ed-f35f9ab371dd-0' usage_metadata={'input_tokens': 282, 'output_tokens': 517, 'total_tokens': 799}
