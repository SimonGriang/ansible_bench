---
- name: Import task list from assert.yml for validation and execution
  include_tasks:
    file: assert.yml
    remote_host: localhost
    run_once: true

- name: Install the vsftpd package
  apt:
    name: vsftpd
    state: present

- name: Configure vsftpd service by creating configuration file
  template:
    src: vsftpd.conf.j2
    dest: /etc/vsftpd.conf
    mode: 644
    owner: root
    group: root
  notify: vsftpd_restart

- name: Start vsftpd service and enable it at boot
  service:
    name: vsftpd
    state: started
    enabled: true


