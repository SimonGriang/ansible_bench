---
- name: Import assert.yml and run it once on localhost
  include_tasks: assert.yml
  host: localhost

- name: Install the dns packages
  apt:
    name: "{{ packages }}"
    state: present
  vars:
    packages: ['bind9', 'bind9-utils']

- name: Create the required directories
  file:
    path: "{{ item }}"
    state: directory
  loop: ['/var/cache/bind', '/var/named', '/etc/bind.keys']

- name: Create the required group
  group:
    name: named
    state: present

- name: Create the required user
  user:
    name: named
    group: named
    home: /var/named
    shell: /sbin/nologin
    state: present

- name: Generate the rndc key
  command:
    - dnssec-keygen
    - -a
    - RSASHA256
    - -b
    - 2048
    - -s
    - 256
    - -n
    - sec
    - -r
    - /dev/urandom
    - Krndc

- name: Set permissions on the rndc key file
  file:
    path: /etc/bind.keys/Krndc*
    mode: '0640'
    owner: root
    group: named

- name: Download the named.root file
  get_url:
    url: https://www.iana.org/dns/dnservers/root.keys
    dest: /etc/bind/named.root

- name: Create the zone file
  template:
    src: zone.j2
    dest: /etc/bind/zones/db.{{ zone }}
  vars:
    zone: example.com

- name: Add zones to the configuration
  template:
    src: named.conf.local.j2
    dest: /etc/bind/named.conf.local
  vars:
    zones: ['127.0.0.1']

- name: Place the systemd override
  copy:
    src: bind9.service
    dest: /etc/systemd/system/bind9.service
    mode: '0644'
    group: root
    owner: root
  notify: Reload systemd daemon

- name: Start and enable the DNS service
  service:
    name: bind9
    state: started
    enabled: true

