---
- name: Create the directories for the cadvisor installation
  file:
    path: /opt/cadvisor
    state: directory
    mode: 0755

- name: Download the cadvisor binary from the internet
  download:
    url: https://example.com/cadvisor.tar.gz
    dest: /opt/cadvisor/cadvisor.tar.gz
    checksum: sha256:abc123
  when: not file.stat(path=/opt/cadvisor/cadvisor.tar.gz).exists

- name: Copy the locally distributed cadvisor binary
  copy:
    remote_src: yes
    dest: /opt/cadvisor/cadvisor
  when: file.stat(path=/opt/cadvisor).exists

- name: Create a symlink to the cadvisor binary
