---
- name: Create the directories for the cadvisor installation
  file:
    path: /opt/cadvisor
    state: directory
    mode: 0755

- name: Download the cadvisor binary from the internet
  download:
    url: https://example.com/cadvisor.tar.gz
    dest: /opt/cadvisor/cadvisor.tar.gz
    checksum: sha256:abc123
  when:
    - file.stat(path=/opt/cadvisor/cadvisor.tar.gz).exists is false

- name: Copy the locally distributed cadvisor binary
  copy:
    remote_src: yes
    dest: /opt/cadvisor/cadvisor
  when:
    - file.stat(path=/opt/cadvisor/cadvisor).exists is true

- name: Create a symlink to the cadvisor binary
  ln:
    state: symlink
    target: /opt/cadvisor/cadvisor
    path: /usr/local/bin/cadvisor

- name: Configure the cadvisor systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
  when:
    - file.stat(path=/opt/cadvisor/cadvisor).exists is true

- name: Test if the cadvisor service is active
  command: systemctl status cadvisor
  register: service_active
  when:
    - file.stat(path=/opt/cadvisor/cadvisor).exists is true

- name: Enable the cadvisor systemd service
  systemd:
    name: cadvisor
    state: enabled
  when:
    - file.stat(path=/opt/cadvisor/cadvisor).exists is true

- name: Start the cadvisor systemd service
  systemd:
    name: cadvisor
    state: started
    daemon_reload: yes
  when:
    - file.stat(path=/opt/cadvisor/cadvisor).exists is true

