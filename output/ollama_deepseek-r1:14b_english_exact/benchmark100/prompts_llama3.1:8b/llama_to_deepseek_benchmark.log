---
- name: Restore etcd node names
  kubernetes.core.fact.kubernetes_facts:
    api_version: v1
    kind: Node
  register: k8s_facts

- name: Set node_names variable
  set_fact:
    node_names: "{{ k8s_facts.ansible_facts.kubernetes.nodes
      | json_query('*.metadata.name') }}"

- name: Remove old nodes from the cluster
  kubernetes.core.k8s:
    action: delete
    kind: Node
    name: "{{ item }}"
    api_version: v1
  loop: "{{ node_names | difference(groups['rke2_cluster_group_name'] | default([])) }}"
  ignore_errors: yes


