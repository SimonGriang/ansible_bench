 as specified. I'll double-check that each module and parameter matches exactly what's described, without any additions or omissions.\n\nI think that's all. Now, I'll write out the playbook accordingly.\n</think>\n\n```yaml\n---\n- name: Import task list from assert.yml for validation and execution\n  include_tasks:\n    file: assert.yml\n    remote_host: localhost\n    run_once: true\n\n- name: Install the vsftpd package\n  apt:\n    name: vsftpd\n    state: present\n\n- name: Configure vsftpd service by creating configuration file\n  template:\n    src: vsftpd.conf.j2\n    dest: /etc/vsftpd.conf\n    mode: 644\n    owner: root\n    group: root\n  notify: vsftpd_restart\n\n- name: Start vsftpd service and enable it at boot\n  service:\n    name: vsftpd\n    state: started\n    enabled: true\n```" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-23T14:39:21.868425441Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13816381663, 'load_duration': 90984293, 'prompt_eval_count': 406, 'prompt_eval_duration': 132825048, 'eval_count': 657, 'eval_duration': 13591059927, 'model_name': 'deepseek-r1:14b'} id='run--6eca95f8-f9c0-4a38-af9f-40ee4174d034-0' usage_metadata={'input_tokens': 406, 'output_tokens': 657, 'total_tokens': 1063}
