---

- name: Import assertion tasks
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  ansible.builtin.apt:
    name: "{{ openssl_requirements }}"
    state: present

- name: Install Python packages
  ansible.builtin.pip:
    name: "{{ item }}"
    state: present
  when:
    - openssl_pip_packages is defined
    - (openssl_pip_packages | list | length) > 0
  with_items: "{{ openssl_pip_packages }}"

- name: Create the key directory
  ansible.builtin.file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: "{{ openssl_key_mode | default('0755') }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create the csr directory
  ansible.builtin.file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: "{{ openssl_csr_mode | default('0755') }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create the certificate directory
  ansible.builtin.file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: "{{ openssl_crt_mode | default('0755') }}"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include the create.yml tasks
  ansible.builtin.import_tasks: create.yml
  when:
    - openssl_items is defined
    - (openssl_items | list | length) > 0
  with_items: "{{ openssl_items }}"
  loop_control:
    loop_var: item_name

