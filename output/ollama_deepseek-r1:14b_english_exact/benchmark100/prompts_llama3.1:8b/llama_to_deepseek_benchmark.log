---
- name: Check existence of Java certificates
  stat:
    path: "{{ item.path }}"
    mode: true
    owner: true
  with_items: "{{ java_certs }}"
  register: check_java_certs

- name: Fail if Java certificates do not exist
  fail:
    msg: "Java certificate {{ item.path }} does not exist"
  with_items: "{{ check_java_certs.results }}"
  when: item.stat.exists is false

- name: Set Java keystore directory for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  condition: java_version | int < 11

- name: Set Java keystore directory for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  condition: java_version | int >= 11

- name: Import SSL certificates into Java keystore
  java_cert:
    path: "{{ java_open_jdk_home }}"
    keystore_path: "{{ java_keystore_dir }}/{{ java_cert_keystore_name }}"
    keystore_pass: "{{ java_cert_keystore_pass }}"
    alias: "{{ item.alias }}"
    certificate: "{{ item.certificate }}"
    key_algorithm: "{{ item.key_algorithm | default('RSA') }}"
    store_algorithm: "{{ item.store_algorithm | default('PKCS12') }}"
  with_items: "{{ java_certs }}"


