---
- name: Task 1: Import assert.yml and run it once on localhost
  shell: ansible-playbook /path/to/assert.yml --tags assert --limit localhost

- name: Task 2: Install the dns packages
  apt:
    name:
      - bind9
      - bind9-utils
      - dnsutils
    state: present
  become: true

- name: Task 3: Create the required directories
  file:
    path: /etc/bind/
    state: directory
    mode: 0755

- name: Task 4: Create the required group
  group:
    name: bind
    state: present

- name: Task 5: Create the required user
  user:
    name: bind
    group: bind
    state: present

- name: Task 6: Generate the rndc key
  shell: rndc-keygen -a sha256 -s 2048 -n bind -k /etc/bind/rndc.key
  become: true

- name: Task 7: Set permissions on the rndc key file
  file:
    path: /etc/bind/rndc.key
    mode: 0600
    owner: bind
    group: bind
    state: file

- name: Task 8: Download the named.root file
  get_url:
    url: https://www.niclabs.org.br/files/named.root
    dest: /etc/bind/named.root
    mode: 0644

- name: Task 9: Create the zone file
  template:
    src: named.conf.local.j2
    dest: /etc/bind/named.conf.local
    mode: 0644
    owner: bind
    group: bind

- name: Task 10: Add zones to the configuration
  template:
    src: named.conf.options.j2
    dest: /etc/bind/named.conf.options
    mode: 0644
    owner: bind
    group: bind

- name: Task 11: Place the systemd override
  copy:
    src: named.service.j2
    dest: /etc/systemd/system/bind9.service
    mode: 0644
  systemd:
    name: bind9
    state: reloaded

- name: Task 12: Start and enable the DNS service
  shell: systemctl start bind9 && systemctl enable bind9
  become: true


