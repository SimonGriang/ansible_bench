---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: "temurin"
  when: (java_jdk_vendor == "adoptopenjdk")

- name: Gather OS specific variables
  include_vars: "{{ java_jdk_vendor }}/os.yml"

- name: Gather architecture specific variables
  include_vars: architecture.yml

- name: Set OS-specific variables (I)
  set_fact:
    java_open_jdk_{{ item | lower }}: "{{ item_value }}"
  loop:
    - java_major_version
    - java_update_version
    - java_distribution
  when: (item_value is defined and item_value is not null)

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir }}"
    java_open_jdk_package: "{{ java_open_jdk_package }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Debian pre-requisites
  when: ansible_distribution_family == 'debian'
  block:
    - name: Remove deprecated repositories
      apt:
        name: "{{ item }}"
        state: absent
        update_cache: yes
      loop: "{{ java_debian_repositories_deprecated }}"

    - name: Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ java_debian_apt_tools }}"

    - name: Add required key repositories
      apt:
        name: "{{ item.apt_key }}"
        state: present
        key: "{{ item.key }}"
        key_source: "{{ item.key_source }}"
      loop: "{{ java_debian_keys }}"

    - name: Add required repositories
      apt:
        name: "{{ item.repository }}"
        state: present
        update_cache: yes
      loop: "{{ java_debian_repositories }}"

- name: RedHat pre-requisites
  when: ansible_distribution_family == 'redhat'
  block:
    - name: Add required key repositories
      yum:
        name: "{{ item.yum_key }}"
        state: present
        key: "{{ item.key }}"
      loop: "{{ java_redhat_keys }}"

    - name: Add required repositories
      yum:
        name: "{{ item.repository }}"
        state: present
      loop: "{{ java_redhat_repositories }}"

- name: Install required libs
  when: ansible_distribution_family == 'debian'
  block:
    - apt:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ java_required_libs }}"

  when: ansible_distribution_family == 'redhat'
  block:
    - yum:
        name: "{{ item }}"
        state: present
      loop: "{{ java_required_libs }}"

- name: Install Java, Debian
  when: ansible_distribution_family == 'debian'
  apt:
    name: "{{ java_open_jdk_package }}"
    state: present
    update_cache: yes

- name: Install Java, RedHat
  when: ansible_distribution_family == 'redhat'
  yum:
    name: "{{ java_open_jdk_package }}"
    state: present

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh

- name: Source environment variables
  shell: source /etc/profile

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  file:
    path: /usr/bin/java
    state: symlink
    target: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
  when: java_version < 11

- name: Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  file:
    path: /usr/bin/java
    state: symlink
    target: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java
  when: java_version >= 11


