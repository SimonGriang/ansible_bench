---
- name: Download RKE2 kubeconfig from master server to localhost
  ansible.builtin.fetch:
    src: /etc/rke2/kubeconfig
    dest: "{{ kubeconfig_local_path }}"
    flat: true

- name: Replace loopback IP with master server IP in kubeconfig file
  ansible.builtin.replace:
    path: "{{ kubeconfig_local_path }}"
    regexp: '(127\.0\.0\.1|::1)'
    replace: '{{ master_server_ip }}'
    mode: "600"
  delegate_to: localhost
  become: false


