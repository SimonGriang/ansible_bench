---
- name: Update the package cache on systems that use apt
  apt:
    update_cache: yes
  become: yes

- name: Update the package cache on systems that use dnf
  dnf:
    state: update
  become: yes

- name: Install the keepalived package
  apt:
    name: keepalived
    state: present
  become: yes

- name: Create the /etc/keepalived directory with the correct permissions
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Create the Kubernetes API health check script for Debian-based systems
  template:
    src: check_apiserver.sh.j2
    dest: /etc/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: 0755

- name: Create the Kubernetes API health check script for RHEL-based systems
  template:
    src: check_apiserver.sh.j2
    dest: /usr/libexec/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: 0755

- name: Create the RKE2 Server health check script for Debian-based systems
  template:
    src: check_rke2server.sh.j2
    dest: /etc/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: 0755

- name: Create the RKE2 Server health check script for RHEL-based systems
  template:
    src: check_rke2server.sh.j2
    dest: /usr/libexec/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: 0755

- name: Create the keepalived configuration file
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: 0644

- name: Enable the keepalived service and ensure it is not masked
  service:
    name: keepalived
    enabled: yes
    masked: no

- name: Flush the handlers to execute any pending tasks
  meta:
    flush_handlers: true


