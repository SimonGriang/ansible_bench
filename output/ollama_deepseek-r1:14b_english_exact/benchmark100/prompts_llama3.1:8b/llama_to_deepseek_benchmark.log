---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: rancher
    group: rancher
    mode: 0755

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config_source }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: rancher
    group: rancher
    mode: 0644
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_source }}"
    dest: /etc/rancher/rke2/kubelet.yaml
    owner: rancher
    group: rancher
    mode: 0644
  when:
    - rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_config_source }}"
    dest: /etc/containerd/config.json
    owner: rancher
    group: rancher
    mode: 0644
  when:
    - rke2_custom_registry_mirrors | length > 0
      or rke2_custom_registry_configs | length > 0
  notify: Config file changed

- name: Start RKE2 service on the rest of the nodes
  service:
    name: rke2-{{ rke2_type }}
    state: started
    enabled: yes
    restarted: true
    delay: 5s
    retries: 5
  notify: Service (re)started

- name: Mask other RKE2 service on the rest of the nodes
  service:
    name: rke2-{{ item.type }}
    state: stopped
    enabled: no
  loop: "{{ rke2_other_services }}"

- name: Wait for remaining nodes to be ready - no CNI
  wait_for_task:
    task: >
      set_fact:
        node_ready: true
      when: >
        ({{ node.status == 'Ready' }}
          and ({{ node.roleName == 'server' }}
            or ({{ node.roleName == 'agent' }}
              and {{ node.ready }}
              and {{ node.network_ready }})
          )
    retries: 30
    delay: 10
    until: node_ready is true
  loop: "{{ groups['rke2_nodes'] }}"

- name: Wait for remaining nodes to be ready - with CNI
  wait_for_task:
    task: >
      set_fact:
        nodes_ready: true
      when: >
        ({{ ansible_hostname == server_hostname }}
          or ({{ ansible_hostname == groups['rke2_nodes'][0] }}
            and {{ groups['rke2_nodes'] | length > 1 }})
          or ({{ groups['rke2_nodes'] | length == 1 }))
        )
        and ({{ total_ready_nodes >= total_nodes - 1 }})
    retries: 30
