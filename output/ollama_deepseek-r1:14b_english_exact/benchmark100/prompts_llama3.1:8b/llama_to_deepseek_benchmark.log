---
- name: Cordon and Drain the node with the specified RKE2 node name
  kubectl:
    path: "{{ rke2_data_path }}/bin/kubectl"
    command: drain
    args:
      - "{{ rke2_node_name }}"
      - --ignore-daemonsets
      - "{{ rke2_drain_additional_args | default('') }}"
    register: drain_node
  retries: 100
  delay: 15

- name: Restart the RKE2 service on the specified node
  shell: systemctl restart "{{ rke2_service_name }}"
  become: true
  name: "{{ rke2_service_name }}"
  state: restarted

- name: Wait for all nodes to be ready again
  wait_for:
    path: "{{ rke2_data_path }}/bin/kubectl"
    command: get nodes --no-headers
    state: present
    until: "{{ rke2_cluster_group_name }} nodes are all ready"
    retries: 100
    delay: 15

- name: Uncordon the specified RKE2 node
  kubectl:
    path: "{{ rke2_data_path }}/bin/kubectl"
    command: uncordon
    args:
      - "{{ rke2_node_name }}"
  become: true

- name: Wait for all pods to be ready again
  wait_for:
    path: "{{ rke2_data_path }}/bin/kubectl"
    command: get pods --all-namespaces --no-headers
    state: present
    until: "all pods are ready"
    retries: 100
    delay: 15

- name: Wait for all pods to pass readiness checks
  wait_for:
    path: "{{ rke2_data_path }}/bin/kubectl"
    command: "{{ rke2_wait_for_all_pods_to_be_healthy_args }}"
    state: present
    until: "all pods are healthy"
    retries: 100
    delay: 15


