---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install the MySQL package
  apt:
    name: mysql-server
    state: present
  notify:
    - set_mysql_root_password
    - systemctl_daemon_reexec

- name: Configure the MySQL server
  ini_file:
    file: "{{ mysql_config_destination }}/server.cnf"
    sections:
      mysqld:
        {% for key, value in mysql_configuration_options.items() %}
        {{ key }}: {{ value }}
        {% endfor %}

- name: Configure the MySQL client
  ini_file:
    file: "{{ mysql_config_destination }}/client.cnf"
    sections:
      client:
        socket: "{{ mysql_client_socket }}"

- name: Initialize the MySQL database
  shell: "{{ mysql_initialize_command }}"
  changed_when: false
  ignore_errors: yes

- name: Start and enable the MySQL service
  service:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place the my.cnf file
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: 0600

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  with_items: "{{ mysql_databases }}"
  no_log: yes

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: '{{ item.privileges }}'
  with_items: "{{ mysql_users }}"
  no_log: yes

- name: Flush handlers again
  meta: flush_handlers

