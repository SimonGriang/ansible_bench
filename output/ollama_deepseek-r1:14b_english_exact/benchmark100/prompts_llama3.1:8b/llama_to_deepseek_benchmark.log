ssert.yml\n  host: localhost\n\n- name: Install the dns packages\n  apt:\n    name: "{{ packages }}"\n    state: present\n  vars:\n    packages: [\'bind9\', \'bind9-utils\']\n\n- name: Create the required directories\n  file:\n    path: "{{ item }}"\n    state: directory\n  loop: [\'/var/cache/bind\', \'/var/named\', \'/etc/bind.keys\']\n\n- name: Create the required group\n  group:\n    name: named\n    state: present\n\n- name: Create the required user\n  user:\n    name: named\n    group: named\n    home: /var/named\n    shell: /sbin/nologin\n    state: present\n\n- name: Generate the rndc key\n  command: dnssec-keygen -a RSASHA256 -b 2048 -s 256 -n sec -r /dev/urandom Krndc\n  args:\n    chdir: /etc/bind.keys\n\n- name: Set permissions on the rndc key file\n  file:\n    path: /etc/bind.keys/Krndc*\n    mode: \'0640\'\n    owner: root\n    group: named\n\n- name: Download the named.root file\n  get_url:\n    url: https://www.iana.org/dns/dnservers/root.keys\n    dest: /etc/bind/named.root\n\n- name: Create the zone file\n  template:\n    src: zone.j2\n    dest: /etc/bind/zones/db.{{ zone }}\n  vars:\n    zone: example.com\n\n- name: Add zones to the configuration\n  template:\n    src: named.conf.local.j2\n    dest: /etc/bind/named.conf.local\n  vars:\n    zones: [\'127.0.0.1\']\n\n- name: Place the systemd override\n  copy:\n    src: bind9.service\n    dest: /etc/systemd/system/bind9.service\n    mode: \'0644\'\n    group: root\n    owner: root\n  notify: Reload systemd daemon\n\n- name: Start and enable the DNS service\n  service:\n    name: bind9\n    state: started\n    enabled: yes\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-23T14:58:23.532336828Z', 'done': True, 'done_reason': 'stop', 'total_duration': 20664832872, 'load_duration': 89272192, 'prompt_eval_count': 625, 'prompt_eval_duration': 420031919, 'eval_count': 916, 'eval_duration': 20154088318, 'model_name': 'deepseek-r1:14b'} id='run--39da5077-bef0-