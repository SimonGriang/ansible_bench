---
- name: Import external tasks for assertion handling
  ansible.builtin.import_tasks:
    file: assert.yml

- name: Install the cron package
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell settings for cron jobs
  ansible.builtin.cron:
    name: "{{ cron_shell }}"
    cron_file: /etc/cron.d/cron_shell
    schedule: "* * * * *"
    command: "{{ cron_shell }}"

- name: Configure the system path for cron jobs
  ansible.builtin.cron:
    name: "{{ cron_path }}"
    cron_file: /etc/cron.d/cron_path
    schedule: "* * * * *"
    command: "export PATH={{ cron_path }}"

- name: Configure the mail-to setting for cron jobs
  ansible.builtin.cron:
    name: "{{ cron_mailto }}"
    cron_file: /etc/cron.d/cron_mailto
    schedule: "* * * * *"
    command: "mailto={{ cron_mailto }}"

- name: Start and enable the cron service
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: true

- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    cron_file: "{{ item.cron_file }}"
    schedule: "{{ item.schedule }}"
    command: "{{ item.command }}"
  loop:
    - "{{ cron_jobs }}"
  loop_var: item


