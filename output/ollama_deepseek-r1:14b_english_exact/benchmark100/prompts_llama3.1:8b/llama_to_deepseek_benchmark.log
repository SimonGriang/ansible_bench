---
- import_tasks: assert.yml
  delegate_to: localhost

- wait_for_port:
    port: 22
    timeout: "{{ bootstrap_timeout | default('600') }}"
  when:
    - ansible_connection is defined
    - ansible_connection not in ['container', 'docker', 'community.docker.docker']
    - ansible_connection is not None
    - bootstrap_wait_for_host | default(true) | bool

- include_tasks: prepare.yml
  vars:
    task1_result: "{{ task1_result | default('')}}
  when: true

- setup:
    gather_subset: all
    become: false

- include_tasks: bootstrap_packages.yml
  when: true
  vars:
    packages: "{{ bootstrap_facts_packages | default([]) | list }}"
  loop: "{{ bootstrap_facts_packages | default([]) | list }}"


