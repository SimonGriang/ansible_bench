  template:
    dest: /etc/mysql/{{ mysql_name }}-client.cnf
    mode: 0644
    content: |
      {{ mysql_name }}_client_config {{ mysql_socket_option }}

- name: Initialize the mysql service
  command: "{{ mysql_initialize_command }}"
  shell: /bin/sh

- name: Start and enable the mysql service
  systemctl:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Create a my.cnf file in /root/.my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0600

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ db_name }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: List databases
  community.mysql.mysql_info:
    state: present

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ db_name }}"
