me: "{{ httpd_ssl_packages | default([]) | list }}"\n    state: present\n\n- name: Place SSL configuration file\n  template:\n    src: httpd_ssl.conf.j2\n    dest: "{{ httpd_config_directory }}/ssl.conf"\n    mode: 0644\n  notify: apache_config_test\n\n- name: Configure HTTP to HTTPS redirect\n  template:\n    src: default_vhost_conf.j2\n    dest: "{{ httpd_config_directory }}/default_vhost.conf"\n    mode: 0644\n  notify: apache_config_test\n\nhandlers:\n  apache_config_test:\n    include_tasks: apache_config_test.yml\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-23T16:33:07.938356645Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9235848931, 'load_duration': 96983694, 'prompt_eval_count': 398, 'prompt_eval_duration': 102934542, 'eval_count': 536, 'eval_duration': 9034051491, 'model_name': 'deepseek-r1:14b'} id='run--fd58858f-1600-4e4b-9597-0f75ac6bb09f-0' usage_metadata={'input_tokens': 398, 'output_tokens': 536, 'total_tokens': 934}
