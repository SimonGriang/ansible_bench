---
- name: Check all variables have been set correctly
  include_tasks:
    file: assert.yml
  vars:
    remote_host: localhost
  changed_when: false

- name: Wait for host (when configured)
  wait_for:
    port: "{{ ansible_port }}"
    host: "{{ ansible_ssh_host | default(inventory_hostname) | default('localhost') }}"
    timeout: "{{ bootstrap_timeout }}"
    state: present
  when: ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare the system
  block:
    - name: Check connection
      command: sh -c 'echo > /dev/null'
      ignore_errors: yes
      register: connection_test_result
      changed_when: false

    - name: Log connection test result
      debug:
        msg: "Connection test result: {{ connection_test_result | json_summary }}"
      when: connection_test_result is not skipped

    - name: Include gather facts
      include_tasks: gather_facts.yml

    - name: Include install packages
      package:
        name: "{{ item }}"
        state: present
        become: "{{ bootstrap_become | default('yes') | bool }}"
        become_user: "{{ bootstrap_become_user | default('root') }}"
      with_items: "{{ bootstrap__facts_packages | default([]) }}"

  changed_when: true

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      ansible_facts:
        gather_subset: all

    - name: Install required packages
      package:
        name: "{{ item }}"
        state: present
        become: "{{ bootstrap_become | default('yes') | bool }}"
        become_user: "{{ bootstrap_become_user | default('root') }}"
      with_items: "{{ bootstrap__facts_packages | default([]) }}"

  changed_when: true


