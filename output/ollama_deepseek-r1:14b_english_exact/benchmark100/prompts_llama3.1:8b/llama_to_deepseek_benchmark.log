---
- name: Import assert.yml and run it once on localhost
  import_tasks: assert.yml
  host: localhost

- name: Install the mysql package
  shell: apt-get update && apt-get install -y mysql-server
  become: true

- name: Configure the mysql server
  file:
    path: /etc/mysql/{{ mysql_name }}-server.cnf
    content: "{{ mysql_server_options | join('\n') }}"
    mode: 0644

- name: Configure the mysql client
  file:
    path: /etc/mysql/{{ mysql_name }}-client.cnf
    content: "socket={{ mysql_socket }}"
    mode: 0644

- name: Initialize the mysql service
  shell: mysql_initialize_command
  when: ansible_os_family in ['Alpine', 'Archlinux']

- name: Start and enable the mysql service
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  flush_handlers:

- name: Create a my.cnf file in the /root/.my.cnf directory
  file:
    path: /root/.my.cnf
    content: "{{ lookup('template', 'my.cnf.j2') }}"
    mode: 0600

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ db_name }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: List databases on the target machine
  community.mysql.mysql_info:
    state: present

- name: Import databases
  community.mysql.mysql_db:
    name: "{{ db_name }}"
    state: import
    initial_import: "{{ db_initial_import | bool }}"
  loop: "{{ mysql_databases | selectattr('initial_import') | list }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ user }}"
    password: "{{ password }}"
    priv: "{{ privileges }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  flush_handlers:



