---
- name: Import assert.yml
  import_tasks: ./assert.yml

- name: Uninstall systemd-logger
  apt:
    name: systemd-logger
    state: absent

- name: Install rsyslog and its required packages
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_packages | default([]) + ['rsyslog'] }}"

- name: Install additional rsyslog features
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features | default([]) }}"

- name: Configure default rsyslog configuration
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    mode: 0644
  notify: Restart rsyslog
  when: rsyslog_deploy_default_config | default(false) | ansible_boolean

- name: Create /etc/rsyslog.d/ directory
  file:
    path: /etc/rsyslog.d/
    state: directory
    mode: 0755
    owner: root

- name: Configure forward rule for rsyslog
  template:
    src: forward_rule.conf.j2
    dest: /etc/rsyslog.d/forward.conf
    mode: 0644
  notify: Restart rsyslog
  when: not (rsyslog_deploy_default_config | default(false)) | ansibleBOOLEAn

- name: Configure additional rsyslog configuration files
  template:
    src: "{{ item.key }}.j2"
    dest: "/etc/rsyslog.d/{{ item.key }}"
    owner: root
    group: root
    mode: 0440
  loop: "{{ rsyslog_rsyslog_d_files | default({}) | dict.items() }}"
  notify: Restart rsyslog

- name: Start and enable rsyslog service
  service:
    name: rsyslog
    state: started
    enabled: yes

