---
- name: Enable specific Apache2 modules
  apache2_module:
    name:
      - proxy
      - proxy_http
    state: enabled
  when:
    - ansible_distribution in ['debian', 'suse']

- name: Configure Apache2 locations
  template:
    src: location.conf.j2
    dest: /etc/apache2/sites-available/{{ location_name }}
    mode: 0644
    variables:
      locations: "{{ httpd_locations }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd


