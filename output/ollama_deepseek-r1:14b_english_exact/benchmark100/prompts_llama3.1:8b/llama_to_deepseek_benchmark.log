---
- name: Import tasks from assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  local_vars: true

- name: Install the requirements for sysctl
  apt:
    name: "{{ sysctl_requirements }}"
    state: present

- name: Set the sysctl settings
  sysctl:
    params: "{{ item.value }}"
    name: "{{ item.key }}"
    state: present
  loop: "{{ sysctl_items | dict2list | default([]) }}"
  when:
    - sysctl_items is defined
    - item.key is defined
    - item.value is defined
    - ansible_connection not in ['container', 'docker', 'community.docker.docker']
  notify: sysctl reloaded
  loop_control:
    label: "{{ item.key }}"


