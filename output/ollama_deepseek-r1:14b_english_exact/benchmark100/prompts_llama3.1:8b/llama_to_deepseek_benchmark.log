---
- name: Get the path to the efi variables directory
  ansible.builtin.stat:
    path: /sys/firmware/efi/efivars/
  register: grub_efi

- name: Remove the grub.cfg file on EFI systems
  ansible.builtin.file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: grub_efi.stat.exists

- name: Install a user template for grub
  ansible.builtin.template:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    mode: 0644
    owner: root
  notify: Update grub

- name: Add password to the grub configuration on EFI systems
  ansible.builtin.lineinfile:
    path: /etc/grub2-efi.cfg
    line: |
      set superusers = '{{ grub_password_user }}'
      password_pbkdf2 {{ grub_password_hash }} grub_password_user 8 100000 32
    insertafter: EOF
    create: yes
  when: grub_efi.stat.exists
  notify: Update grub

- name: Add password to the grub configuration on MBR systems
  ansible.builtin.lineinfile:
    path: /etc/grub2.cfg
    line: |
      set superusers = '{{ grub_password_user }}'
      password_pbkdf2 {{ grub_password_hash }} grub_password_user 8 100000 32
    insertafter: EOF
    create: yes
  when: grub_efi.stat.exists
  notify: Update grub

- name: Modify the grub configuration to allow unrestricted access
  ansible.builtin.replace:
    path: "{{ item }}"
    regexp: '^\s*#\\s*DO\\s*NOT\\s*EDIT\\s*THIS\\s*FILE!$'
    replace: |
      set superusers = '{{ grub_password_user }}'
      password_pbkdf2 {{ grub_password_hash }} grub_password_user 8 100000 32
    with_verbosity: 2
  loop: "{{ grub_password_unrestricted | default(false) ? grub_password_unrestricted_files : [] }}"
  when: grub_password_unrestricted | default(false)
  notify: Update grub


