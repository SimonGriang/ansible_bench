---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install the requirements for sysctl
  apt:
    name: "{{ sysctl_requirements }}"
    state: present

- name: Set the sysctl settings
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    reload: "{{ sysctl_reload | default('yes') | lower }}"
  loop: "{{ sysctl_items | default([]) if sysctl_items is defined else [] }}"
  when:
    - sysctl_items is defined
    - item.name is defined
    - item.value is defined
    - connection is not in ['container', 'docker', 'community.docker.docker']
  loop_control:
    label: "{{ item.name }}"


