---
- name: Import a task list from another file to the Ansible control machine for validation
  import_tasks:
    file: assert.yml
  loop_control:
    loop_once: 1

- name: Install the vsftpd package on the target machine
  apt:
    name: vsftpd
    state: present

- name: Configure the vsftpd service by creating a configuration file
  file:
    path: /etc/vsftpd/vsftpd.conf
    content: |
      # Configurations for vsftpd
      anonymous_enable=NO
      local_enable=YES
      write_enable=YES
      chroot_local_user=YES
      dir_message_enable=YES
      xfer_log_enable=YES
      xfer_log_file=/var/log/vsftpd.log
      log_ftp_login=YES
    mode: 0o644
    owner: root
    group: root
  notify: restart vsftpd

- name: Start the vsftpd service and enable it to start at boot time
  systemd:
    name: vsftpd
    state: started
    enabled: yes


