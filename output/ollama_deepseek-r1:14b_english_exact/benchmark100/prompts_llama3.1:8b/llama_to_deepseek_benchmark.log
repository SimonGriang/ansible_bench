---
- name: Install required SSL packages
  apt:
    name: "{{ httpd_ssl_packages }}"
    state: present

- name: Place SSL configuration file
  copy:
    remote_src: true
    dest: "{{ httpd_config_directory }}/ssl.conf"
    mode: 0644
  notify: apache_config_test

- name: Configure HTTP to HTTPS redirect
  copy:
    remote_src: true
    dest: "{{ httpd_config_directory }}/default_vhost.conf"
    mode: 0644
  notify: apache_config_test

handlers:
  - name: apache_config_test
    metadata:
      gather_facts: no
    ansible.builtin.shell: apache2ctl configtest
    changed_when: false
    ignore_errors: yes
    register: apache_config_test_result

  - name: restart apache if configtest fails
    ansible.builtin.service:
      name: apache2
      state: restarted
    when: apache_config_test_result.rc != 0


