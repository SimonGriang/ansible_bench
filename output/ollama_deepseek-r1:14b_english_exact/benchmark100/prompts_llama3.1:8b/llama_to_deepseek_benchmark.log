---
- name: Create the Vault group
  group:
    name: "{{ vault_group }}"
    state: present
    system: yes

- name: Create the Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    state: present

- name: Create the Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Download the Vault binary
  get_url:
    url: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}/vault"
    validate_certs: no

- name: Extract Vault binary
  file:
    path: "{{ vault_download_path }}/vault"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Check if vault_path exists
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  ignore_errors: yes

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  when: not vault_path_exists

- name: Create directories in vault_path
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  loop: "{{ vault_directories }}"

- name: Create data directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command: |
    openssl req -x509 -newkey rsa:2048 -keyout "{{ vault_tls_path }}/vault.key" -out "{{ vault_tls_path }}/vault.crt" -days 365 -nodes -subj "/C=US/ST=Vault/L=Vault/O=Vault/CN=vault"
  args:
    creates: "{{ vault_tls_path }}/vault.crt"

- name: Set ownership of TLS material
  file:
    path: "{{ vault_tls_path }}/*"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0644
    state: file
  with_items: "{{ vault_tls_files }}"

- name: Copy the Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_binary_location }}"
    remote_src: yes
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setcap:
    path: "{{ vault_binary_location }}"
    cap: cap_ipc_lock=ep
    state: present

- name: Touch vault.env
  file:
    path: "{{ vault_env_file }}"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0644

- name: Create /usr/lib/systemd/system
  file:
    path: "/usr/lib/systemd/system"
    state: directory
    owner: "root"
    group: "root"
    mode: 0755

- name: Copy the Vault service file
  copy:
    src: "{{ vault_service_file }}"
    dest: "/usr/lib/systemd/system/vault.service"
    owner: "root"
    group: "root"
    mode: 0644

- name: Copy the Vault configuration
  copy:
    src: "{{ vault_config_file }}"
    dest: "{{ vault_path }}/vault/config"
    remote_src: yes
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0644

- name: Flush handlers
  meta: flush_handlers


