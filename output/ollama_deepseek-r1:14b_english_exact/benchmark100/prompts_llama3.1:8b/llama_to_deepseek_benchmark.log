---
- name: Ensure /etc/openvpn/easy-rsa exists and set permissions
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Initialize the EasyRSA PKI directory
  command: easyrsa init-pki

- name: Build the CA certificate using EasyRSA
  command: easyrsa build-ca -- nopass

- name: Generate the Diffie-Hellman (DH) parameters using EasyRSA
  command: easyrsa gen-dh

- name: Build the server certificate using EasyRSA
  command: easyrsa build-server-full -- nopass

- name: Build the client certificate using EasyRSA
  command: easyrsa build-client-full -- nopass

- name: Generate the Certificate Revocation List (CRL) using EasyRSA
  command: easyrsa gen-crl

- name: Generate the Diffie-Hellman (DH) key using OpenVPN
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy files to the /etc/openvpn/server directory
  copy:
    src: /etc/openvpn/easy-rsa/pki/ta.key
    dest: /etc/openvpn/server
    remote_src: yes
  copy:
    src: /etc/openvpn/easy-rsa/pki/ca.crt
    dest: /etc/openvpn/server
    remote_src: yes
  copy:
    src: /etc/openvpn/easy-rsa/pki/dh.pem
    dest: /etc/openvpn/server
    remote_src: yes
  copy:
    src: /etc/openvpn/easy-rsa/pki/issued/server.crt
    dest: /etc/openvpn/server
    remote_src: yes
  copy:
    src: /etc/openvpn/easy-rsa/pki/issued/client.crt
    dest: /etc/openvpn/server
    remote_src: yes
  copy:
    src: /etc/openvpn/easy-rsa/pki/private/ca.key
    dest: /etc/openvpn/server
    remote_src: yes
  copy:
    src: /etc/openvpn/easy-rsa/pki/private/server.key
    dest: /etc/openvpn/server
    remote_src: yes
  copy:
    src: /etc/openvpn/easy-rsa/pki/private/client.key
    dest: /etc/openvpn/server
    remote_src: yes

- name: Copy files to the /etc/openvpn directory
  copy:
    src: /etc/openvpn/easy-rsa/pki/ca.crt
    dest: /etc/openvpn
    remote_src: yes
  copy:
    src: /etc/openvpn/easy-rsa/pki/ta.key
    dest: /etc/openvpn
    remote_src: yes

- name: Place the server.conf file
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    owner: root
    group: root
    mode: 0644


