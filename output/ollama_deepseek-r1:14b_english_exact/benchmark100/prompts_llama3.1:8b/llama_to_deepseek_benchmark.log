---
- name: Create the Vault group
  group:
    name: "{{ vault_group }}"
    state: present
    system: true

- name: Create the Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    state: present
    system: true

- name: Create the Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Download the Vault binary
  get_url:
    url: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}/vault"
    validate_certs: false

- name: Set ownership of downloaded Vault binary
  file:
    path: "{{ vault_download_path }}/vault"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Check if the vault_path exists
  stat:
    path: "{{ vault_path }}"

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  when: not (vault_path_exists | bool)

- name: Create directories in vault_path
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  with_items: "{{ vault_directories }}"

- name: Create data directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  with_items: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  openssl:
    genkey: true
    cert: true
    key_file: "{{ vault_tls_path }}/{{ vault_tls_key }}"
    cert_file: "{{ vault_tls_path }}/{{ vault_tls_cert }}"
    csr_file: /dev/null
    privatekey_type: RSA
    privatekey_bits: 2048
    subject:
      CN: "{{ vault_tls_subject }}"
    days: 365
    nocert: yes
    noemail: yes

- name: Set ownership of TLS material
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  with_items: "{{ vault_tls_files }}"

- name: Copy the Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_binary_path }}"
    remote_src: true

- name: Set ownership of Vault binary
  file:
    path: "{{ vault_binary_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  set_cap:
    path: /usr/bin/vault
    cap: ipc_lock=ep

- name: Touch vault.env
  file:
    path: "{{ vault_env_path }}"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Copy the Vault service file
  copy:
    src: "{{ vault_service_src }}"
    dest: "{{ vault_service_dest }}"

- name: Set ownership of Vault service file
  file:
    path: "{{ vault_service_dest }}"
    owner: root
    group: root
    mode: 0755

- name: Copy the Vault configuration
  copy:
    src: "{{ vault_config_src }}"
    dest: "{{ vault_config_dest }}"

- name: Set ownership of Vault configuration
  file:
    path: "{{ vault_config_dest }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Flush handlers
  meta: flush_handlers


