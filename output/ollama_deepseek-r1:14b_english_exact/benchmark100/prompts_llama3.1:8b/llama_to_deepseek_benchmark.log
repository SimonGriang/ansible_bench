---
- name: Install OpenJDK implementation
  apt:
    name: openjdk
    state: present
    update_cache: yes

- name: Import certificates into Java Keystore
  when: java_certs | default([]) | length > 0
  block:
    - name: Ensure Java Keystore exists
      shell: |
        java -keytool -list -v -keystore {{ java_keystore_path }} 2>/dev/null | grep -q '^Certificate' || \
        /usr/lib/jvm/java-11-openjdk-amd64/bin/keytool -genkey -keyalg RSA -keysize 2048 -validity 365 -keystore {{ java_keystore_path }} -storepass {{ java_keystore_password }} -keypass {{ java_keystore_password }}
      changed_when: false

    - name: Import certificates into keystore
      shell: |
        /usr/lib/jvm/java-11-openjdk-amd64/bin/keytool -importcert -file "{{ item }}" -keystore {{ java_keystore_path }} -storepass {{ java_keystore_password }} -keypass {{ java_keystore_password }}
      loop: "{{ java_certs | default([]) | list }}"
      changed_when: false


