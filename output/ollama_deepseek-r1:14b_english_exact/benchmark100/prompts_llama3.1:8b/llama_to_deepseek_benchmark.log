---
- name: Task 1: Disable Swap
  command: swapoff -a
  when: swap_enabled and vault_hardening_disable_swap

- name: Task 1: Disable Swap (Permanent)
  command: |
    for swap in $(swapon -s | awk '{print $1}' | grep -v ^none$ | tr '\n' ' '); do swapoff "$swap"; done
  when: swap_enabled and vault_hardening_disable_swap

- name: Task 1: Edit /etc/fstab to disable swap
  command: |
    for swap_line in $(swapon -s | awk '{print $1}' | grep -v ^none$ | cut -d' ' -f1); do
      sed -i "/$swap_line/d" /etc/fstab
    done
  when: swap_enabled and vault_hardening_disable_swap

- name: Task 2: Disable Core Dumps
  community.general.pam_limits:
    limit_type: soft
    limit_name: core
    limit_value: 0
    state: present
  when: vault_hardening_disable_core_dumps

- name: Task 2: Disable Core Dumps
  community.general.pam_limits:
    limit_type: hard
    limit_name: core
    limit_value: 0
    state: present
  when: vault_hardening_disable_core_dumps

- name: Task 3: Disable Shell Command History
  copy:
    src: vault.sh
    dest: /etc/profile.d/vault.sh
    mode: 755
  when: vault_hardening_disable_shell_command_history

- name: Task 4: Configure SELinux
  command: setenforce 1
  when: selinux_enabled

- name: Task 4: Install SELinux Policy
  apt:
    name: selinux-policy
    state: present
  when: selinux_enabled

- name: Task 4: Enforce AppArmor
  shell: aa-enforce /etc/apparmor.d/*


