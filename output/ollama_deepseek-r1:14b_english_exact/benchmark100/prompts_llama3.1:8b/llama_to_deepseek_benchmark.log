---
- name: Create an SSL private key
  openssl_privatekey:
    path: /etc/ssl/private/mykey.pem
    provider: rsa
    public_key_path: /etc/ssl/private/mykey.pub
    modulus: 4096
    passphrase: ansible_secure_password
    force: true
    mode: '0640'
    owner: root
    group: root

- name: Create an SSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/csr/mycert.csr
    privatekey_path: /etc/ssl/private/mykey.pem
    subject:
      cn: example.com
      l: City
      s: State
      o: Organization
      ou: IT
      c: US
    mode: '0640'
    owner: root
    group: root

- name: Create an SSL certificate
  x509_certificate:
    path: /etc/ssl/certs/mycert.crt
    csr_path: /etc/ssl/csr/mycert.csr
    validity: 365
    mode: '0640'
    owner: root
    group: root

- name: Create a PKCS#12 file
  openssl_pkcs12:
    path: /etc/ssl/pkcs12/mycert.p12
    privatekey_path: /etc/ssl/private/mykey.pem
    certificate_path: /etc/ssl/certs/mycert.crt
    mode: '0640'
    owner: root
    group: root

- name: Read the private key
  slurp:
    remote_path: /etc/ssl/private/mykey.pem
    register: private_key_content

- name: Read the certificate
  slurp:
    remote_path: /etc/ssl/certs/mycert.crt
    register: certificate_content

- name: Create a combined private key and certificate file
  copy:
    remote_src: false
    content: "{{ private_key_content|string }}"
              + "\n"
              + "{{ certificate_content|string }}"
    remote_path: /etc/ssl/certs/combined.pem
    mode: '0640'
    owner: root
    group: root

