---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Set server taints
  set_fact:
    server_taints: "{{ rke2_server_node_taints | default('') | join(',') if rke2_server_type == 'server' else '' }}"

- name: Copy RKE2 config
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

- name: Register etcd restore from file
  set_fact:
    do_etcd_restore: "{{ (rke2_etcd_snapshot_file | length > 0) and (rke2_server_service_file | default('') | grep -q 'WantedBy=network.target') | bool }}"

- name: Register etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ (rke2_etcd_snapshot_file | length > 0) and (rke2_etcd_snapshot_s3_options | length > 0) | bool }}"

- name: Restore etcd from file
  shell: |
    mkdir -p /var/lib/rke2/etcd/snapshots
    cp "{{ rke2_etcd_snapshot_file }}" /var/lib/rke2/etcd/snapshots/etcd-snapshot
    rke2-server.etcd restore from-snapshot --config=/etc/rancher/rke2/config.yaml
  when: do_etcd_restore | default(False)

- name: Restore etcd from s3
  shell: |
    mkdir -p /var/lib/rke2/etcd/snapshots
    rke2-server.etcd restore from-s3 --config=/etc/rancher/rke2/config.yaml --options "{{ rke2_etcd_snapshot_s3_options }}"
  when: do_etcd_restore_from_s3 | default(False)

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started
  when: ansible_hostname == (rke2_cluster_group_name | groupvar('ansible_hostname') | first)

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: masked
  when: ansible_hostname == (rke2_cluster_group_name | groupvar('ansible_hostname') | first)

- name: Wait for the first server be ready - no CNI
  wait_for_task:
    command: kubectl get node -o jsonpath='{.items[0].status.conditions[?(@.type=="Ready)].status}'
    delay: 10
    retries: 60
  when: not rke2_cni_enabled | default(False)
  delegate_to: "{{ rke2_cluster_group_name | groupvar('ansible_hostname') | first }}"

- name: Wait for the first server be ready - with CNI
  wait_for_task:
    command: kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready)].status}'
    delay: 10
    retries: 60
  when: rke2_cni_enabled | default(False)
  delegate_to: "{{ rke2_cluster_group_name | groupvar('ansible_hostname') | first }}"

- name: Restore etcd
  shell: |
    rke2-server.etcd remove-node --config=/etc/rancher/rke2/config.yaml
    rke2-server.etcd create-node --config=/etc/rancher/rke2/config.yaml
  when: do_etcd_restore | default(False) or do_etcd_restore_from_s3 | default(False)

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ rke2_cluster_group_name | groupvar('ansible_hostname') | first }}"


