dules and parameters.\n</think>\n\n```yaml\n---\n- block:\n    - import_playbook: assert.yml\n      hosts: localhost\n      become: false\n      tasks_from: tasks/assert.yml\n      once: true\n\n  name: Import and execute tasks from assert.yml\n  hosts: all\n  become: false\n  tasks_from: tasks/assert.yml\n  once: true\n\n- name: Install logrotate package\n  apt:\n    name: logrotate\n    state: present\n\n- name: Configure logrotate using template\n  template:\n    src: logrotate/templates/logrotate.conf.j2\n    dest: /etc/logrotate.conf\n    mode: 0o644\n\n- name: Generate logrotate.d files\n  template:\n    src: logrotate/templates/entry.j2\n    dest: /etc/logrotate.d/{{ item.name }}\n    mode: 0o644\n    notify: logrotate entry changes\n  with_items: "{{ logrotate.entries | selectattr(\'present\') | list }}"\n\n- name: Remove logrotate.d files marked as absent\n  file:\n    path: /etc/logrotate.d/{{ item.name }}\n    state: absent\n  with_items: "{{ logrotate.entries | selectattr(\'absent\') | list }}"\n\n- name: Manage logrotate service\n  service:\n    name: "{{ logrotate.service_name }}"\n    state: "{{ logrotate.service_state }}"\n    enabled: "{{ logrotate.service_enabled }}"\n  when: logrotate.service_name is not empty\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-13T09:47:08.98904626Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17547889588, 'load_duration': 90949463, 'prompt_eval_count': 2134, 'prompt_eval_duration': 1411071596, 'eval_count': 778, 'eval_duration': 16043922274, 'model_name': 'deepseek-r1:14b'} id='run--5f73d0a4-7d8f-48d0-b9f0-bd73fcd2fc93-0' usage_metadata={'input_tokens': 2134, 'output_tokens': 778, 'total_tokens': 2912}
