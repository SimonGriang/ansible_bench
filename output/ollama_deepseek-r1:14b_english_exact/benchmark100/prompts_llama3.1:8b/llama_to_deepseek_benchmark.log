---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost
  ignore_errors: true

- name: Wait for port to become available
  wait_for_port:
    port: "{{ bootstrap_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection not in ['container', 'docker', 'community.docker.docker']
    - bootstrap_wait_for_host is defined
  register: port_wait_result

- name: Prepare system
  setup:
    gather_subset: minimal
  register: connection_result
  when:
    - not ansible_connection in ['container', 'docker', 'community.docker.docker']

- name: Gather facts if connection failed
  setup:
    gather_subset: minimal
  when: connection_result.ansible_failed

- name: Include gather_facts
  include_tasks: gather_facts.yml
  when: connection_result.ansible_failed

- name: Install bootstrap packages (raw)
  raw: apt-get update -qq && apt-get install -qqy {{ bootstrap_facts_packages | join(' ') }}
  when: bootstrap_become
  become: yes
  become_flags: sudo -H -S -p "sudo: %s"
  register: package_install_result

- name: Gather Ansible facts
  setup:
    gather_subset: minimal
  register: system_facts

- name: Install bootstrap packages
  apt:
    name: "{{ bootstrap_facts_packages | join(' ') }}"
    state: present
    update_cache: yes
  become: "{{ bootstrap_become | default(true) }}"


