- name: Ensure /etc/openvpn/client directory exists with correct permissions
  file:
    path: /etc/openvpn/client
    state: directory
    owner: openvpn
    group: openvpn
    mode: 755

- name: Place client configuration file in the specified directory
  template:
    src: client.conf.j2
    dest: /etc/openvpn/client/client.conf
    owner: openvpn
    group: openvpn
    mode: 644
  notify: openvpn_restart

- name: restart openvpn service
  service:
    name: openvpn
    state: restarted
  listen: openvpn_restart


