---
- name: Import assert.yml file from the current directory
  import_tasks: assert.yml
  delegate_to: localhost
  no_log: yes

- name: Install the nginx package
  apt:
    name: nginx
    state: present

- name: Place a customized nginx.conf file in the /etc/nginx directory
  template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: 0644
    validate_mode: nginx -t -c %s

- name: Ensure the /etc/nginx/conf.d directory exists
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: 0755

- name: Place a customized default.conf file in the /etc/nginx/conf.d directory
  template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: 0644
  notify: Restart nginx

- name: Start and enable the nginx service
  service:
    name: nginx
    state: started
    enabled: yes


