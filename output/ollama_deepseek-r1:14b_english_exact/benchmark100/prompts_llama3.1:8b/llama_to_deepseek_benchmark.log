---
- name: Create an SSL private key
  community.crypto.openssl_privatekey:
    path: /etc/ssl/private/private.key
    size: 2048
    state: present
    mode: '0640'
    owner: root
    group: root

- name: Create an SSL Certificate Signing Request (CSR)
  community.crypto.openssl_csr:
    path: /etc/ssl/csr/csr.pem
    privatekey_path: /etc/ssl/private/private.key
    subject:
      CN: example.com
      C: US
      ST: California
      L: San Francisco
      O: Example Co
      OU: IT Department
    mode: '0640'
    owner: root
    group: root

- name: Create an SSL certificate
  community.crypto.openssl_x509_certificate:
    path: /etc/ssl/certs/certificate.crt
    privatekey_path: /etc/ssl/private/private.key
    csr_path: /etc/ssl/csr/csr.pem
    validity: 365
    mode: '0640'
    owner: root
    group: root

- name: Create a PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: /etc/ssl/pkcs12/certificates.p12
    privatekey_path: /etc/ssl/private/private.key
    certificate_path: /etc/ssl/certs/certificate.crt
    password: my_secure_password
    mode: '0640'
    owner: root
    group: root

- name: Read the private key
  ansible.builtin.slurp:
    src: /etc/ssl/private/private.key
    atomic: true
  register: privatekey_content

- name: Read the certificate
  ansible.builtin.slurp:
    src: /etc/ssl/certs/certificate.crt
    atomic: true
  register: certificate_content

- name: Create a combined private key and certificate file
  ansible.builtin.copy:
    content: |
      {{ privatekey_content.content | b64decode() }}
      {{ certificate_content.content | b64decode() }}
    dest: /etc/ssl/certs/combined.pem
    atomic: true
