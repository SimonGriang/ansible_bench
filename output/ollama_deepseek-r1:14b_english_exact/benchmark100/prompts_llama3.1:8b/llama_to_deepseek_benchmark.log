---
- name: Task 1: Install Keepalived when HA mode is enabled
  include_tasks: keepalived.yml
  when:
    - ha_mode
    - group == 'rke2_servers_group'

- name: Task 2: Download and install RKE2 {{ rke2_version }}
  include_tasks: rke2.yml

- name: Task 3: CIS Hardening
  include_tasks: cis.yml
  when:
    - cis_profile is defined

- name: Task 4: Find Active Server
  include_tasks: find_active_server.yml

- name: Task 5: Enable IPVS kernel module
  include_tasks: ipvs.yml
  when:
    - ha_mode
    - group == 'rke2_servers_group'
    - ipvs_lb

- name: Task 6: Copy kube-vip manifests to the masternode
  include_tasks: kubevip.yml
  when:
    - ha_mode
    - ipvs_lb
    - group == 'rke2_servers_group'
    - inventory_hostname == groups['rke2_servers_group'][0]

- name: Task 7: Copy ingress-nginx manifests to the masternode
  include_tasks: ingress-nginx.yml
  when:
    - ingress nginx values are defined

- name: Task 8: Prepare very first server node in the cluster
  include_tasks: first_server.yml
  when:
    - ha_mode
    - group == 'rke2_servers_group'
    - active_server is not defined or cluster_size == 1

- name: Task 9: Restore etcd specific tasks
  include_tasks: first_server_restore.yml
  when:
    - ha_mode
    - group == 'rke2_servers_group'
    - active_server is defined
    - (inventory_hostname == groups['rke2_servers_group'][0] or inventory_hostname == groups['rke2_servers_group'][-1])
    - etcd_restore

- name: Task 10: Download kubeconfig to ansible localhost
  include_tasks: download_kubeconfig.yaml
  when:
    - ha_mode
    - group == 'rke2_servers_group'
    - inventory_hostname == groups['rke2_servers_group'][0]

- name: Task 11: Prepare and join remaining nodes of the cluster
  include_tasks: remaining_nodes.yml
  when:
    - ha_mode
    - group == 'rke2_servers_group'
    - active_server is defined
    - cluster_size > 1

- name: Task 12: Rolling cordon and drain restart when version changes - servers
  include_tasks: rolling_restart.yml
  when:
    - ha_mode
    - group == 'rke2_servers_group'
    - rke2_version has changed
    - rke2_installed

- name: Task 13: Rolling cordon and drain restart when version changes - agents
  include_tasks: rolling_restart.yml
  when:
    - ha_mode
    - group == 'rke2_agents_group'
    - rke2_version has changed
    - rke2_installed

- name: Task 14: Flush handlers
  include_tasks: flush_handlers.yml

- name: Task 15: Rolling restart when config files change
  include_tasks: change_config.yml
  when:
    - ha_mode
    - group == 'rke2_servers_group'
    - or group == 'rke2_agents_group'
    - config_files have changed
    - rke2_installed

- name: Task 16: Final steps
  include_tasks: summary.yml


