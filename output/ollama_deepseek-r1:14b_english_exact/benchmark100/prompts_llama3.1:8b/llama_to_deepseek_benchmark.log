---
- name: Load OS-specific variables based on the detected operating system
  include_vars:
    file: "{{ item }}"
    ignore_errors: yes
  loop:
    - RedHat.yml
    - Debian.yml

- name: Include setup tasks for RedHat-based systems
  import_tasks: redhat_setup.yml
  when: ansible_distribution == 'RedHat'

- name: Include setup tasks for Debian-based systems
  import_tasks: debian_setup.yml
  when: ansible_distribution == 'Debian'

- name: Install Docker packages on systems with Ansible version less than 2.12 or non-RedHat/Debian systems
  become: yes
  become_method: sudo
  become_flags: '-H'
  when: (ansible_version < '2.12' or (ansible_os_family not in ['RedHat', 'Debian']))
  action:
    module: apt
    name: docker.io
    state: present
  or:
    - name: docker
      state: present
      module: yum

- name: Install Docker packages (with downgrade option) on systems with Ansible version 2.12 or higher and RedHat/Debian systems
  become: yes
  become_method: sudo
  become_flags: '-H'
  when: (ansible_version >= '2.12' and (ansible_os_family in ['RedHat', 'Debian']))
  action:
    module: apt
    name: docker.io
    state: present
    version: '>=5:24.0.5-1~'
  or:
    - name: docker
      state: present
      module: yum
      version_ceil: '2.12'

- name: Install the docker-compose plugin on systems where the plugin is enabled and the system meets the criteria for task 4 or 5
  become: yes
  become_method: sudo
  become_flags: '-H'
  when: (ansible_distribution in ['RedHat', 'Debian'] or ansible_version < '2.12')
  action:
    module: apt
    name: docker-compose-plugin
    state: present
  or:
    - name: docker-compose-plugin
      state: present
      module: yum

- name: Install the docker-compose-plugin (with downgrade option) on systems where the plugin is enabled and the system meets the criteria for task 5
  become: yes
  become_method: sudo
  become_flags: '-H'
  when: (ansible_version >= '2.12' and ansible_os_family in ['RedHat', 'Debian'])
  action:
    module: apt
    name: docker-compose-plugin
    state: present
    version: '>=5:24.0.5-1~'
  or:
    - name: docker-compose-plugin
      state: present
      module: yum
      version_ceil: '2.12'

- name: Ensure the /etc/docker/ directory exists and has the correct permissions
  become: yes
  file:
    path: /etc/docker/
    state: directory
    mode: '0755'

- name: Configure the Docker daemon options by copying the options to the daemon.json file
  become: yes
  copy:
    src: daemon.json
    dest: /etc/docker/daemon.json
    mode: '0644'

- name: Ensure Docker is started and enabled at boot, if configured to do so
  become: yes
  service:
    name: docker
    state: started
    enabled: yes

- name: Notify handlers to ensure firewall rules are updated
  notify: update_firewall_rules

- name: Include tasks for managing docker-compose, if enabled
  import_tasks: docker-compose.yml
  when: docker_compose_enabled

- name: Get information about the docker group using getent
  shell: getent group docker
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  shell: getent group docker | cut -d: -f3 | grep -q . || echo "docker group is empty"
  register: has_users_to_add
  ignore_errors: yes

- name: Include tasks for managing docker users, if necessary
  import_tasks: docker_users.yml
  when: has_users_to_add.stdout == "docker group is empty"


