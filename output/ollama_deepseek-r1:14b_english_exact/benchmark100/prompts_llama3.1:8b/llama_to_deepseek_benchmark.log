---
- name: Check if the Helm binary exists at the specified path
  shell: 'ls {{helm_bin_path}}'
  changed_when: false
  failed_when: false
  register: helm_check

- name: Check the current version of Helm installed on the system
  shell: '{{helm_bin_path}}/version --client --short'
  changed_when: false
  failed_when: false
  register: helm_existing_version

- name: Download the Helm binary from the specified repository
  get_url:
    url: "{{helm_repo_path}}/{{helm_version}}/helm-{{helm_version}}-{{helm_platform}}-{{helm_arch}}"
    dest: /tmp/helm-{{helm_version}}-{{helm_platform}}-{{helm_arch}}
    mode: 0755
    register: helm_downloaded
    checksum: "{{helm_checksum}}"
  only_if: |
    "{{ helm_check.rc != 0 or (helm_existing_version.stdout != helm_version) }}"

- name: Copy the downloaded Helm binary into place at the specified path
  copy:
    src: /tmp/helm-{{helm_version}}-{{helm_platform}}-{{helm_arch}}
    dest: {{helm_bin_path}}
    remote_src: yes
  become: true
  when: |
    "{{ helm_downloaded.checksum != helm_checksum }}"


