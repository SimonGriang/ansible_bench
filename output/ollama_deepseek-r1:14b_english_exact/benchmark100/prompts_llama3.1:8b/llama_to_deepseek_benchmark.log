---
- name: Import cron configuration from assert.yml file
  import_tasks: assert.yml
  local: true

- name: Install required packages for cron service
  apt:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell environment for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    state: present

- name: Configure system path for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    state: present

- name: Configure mailto parameter for cron service
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    state: present

- name: Start and enable the cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: "{{ cron_service | ansible.utils.conditionals.defined }}" and "{{ cron_service | ansible.utils.conditionals.string | ansible.utils.conditionals.length(0) }}"

- name: Schedule the requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    state: "{{ item.state }}"
  with_items: "{{ cron_jobs }}"

