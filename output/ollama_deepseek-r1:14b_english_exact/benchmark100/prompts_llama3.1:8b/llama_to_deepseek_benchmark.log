---
- name: Create an SSL private key
  openssl_privatekey:
    path: /etc/ssl/private/nginx privateKey
    algorithm: rsa
    size: 4096
    mode: 0640
    owner: www-data
    group: www-data

- name: Create an SSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/certs/nginx csr
    privatekey_path: /etc/ssl/private/nginx privateKey
    common_name: example.com
    mode: 0640
    owner: www-data
    group: www-data

- name: Create SSL certificates
  openssl_certificate:
    path: /etc/ssl/certs/nginx certificate
    provider: self-signed
    csr_path: /etc/ssl/certs/nginx csr
    mode: 0640
    owner: www-data
    group: www-data

- name: Create a PKCS#12 file
  openssl_pkcs12:
    name: Nginx Server Cert
    key_path: /etc/ssl/private/nginx privateKey
    cert_path: /etc/ssl/certs/nginx certificate
    out_path: /etc/ssl/nginx.pfx
    mode: 0640
    owner: www-data
    group: www-data

- name: Read the private key
  slurp:
    src: /etc/ssl/private/nginx privateKey
    remote_src: no
  register: private_key

- name: Read the certificate
  slurp:
    src: /etc/ssl/certs/nginx certificate
    remote_src: no
  register: certificate

- name: Create a combined private key and certificate file
  copy:
    remote_src: no
    content: |
      {{ (private_key.content).decode('utf-8') }}
      {{ (certificate.content).decode('utf-8') }}
    dest: /etc/ssl/nginx.keyandcert
    mode: 0640
    owner: www-data
    group: www-data


