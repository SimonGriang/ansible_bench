---
- name: Lookup bootstrap facts by running the cat /etc/os-release command
  raw: cat /etc/os-release
  register: bootstrap_facts

- name: Set bootstrap distribution and major version facts
  set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: "{{ item.value.version }}"
  with_dict: bootstrap__os_family_map
  when: "{{ bootstrap_facts.stdout }}" is contained in "item.value.distro"

- name: Set bootstrap OS family fact
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
