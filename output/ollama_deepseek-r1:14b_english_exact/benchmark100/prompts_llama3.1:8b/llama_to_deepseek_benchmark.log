---
- name: Gather Bootstrap Facts
  shell: cat /etc/os-release
  register: bootstrap_facts
  become: false

- name: Set Bootstrap Distribution Facts (I)
  loop: "{{ bootstrap_os_family_map | flatten }}"
  vars:
    bootstrap_search: "{{ item }}"
  when:
    - previous_task_result.rc == 0
    - not bootstrap_distribution
    - "{{ bootstrap_facts.stdout }} | match(bootstrap_search)"
  shell: echo "{{ bootstrap_facts.stdout | regex_replace('/etc/os-release', '') | split('\n') | map('split', ':') | selectattr(1, 'match', '^\"?([^\"]+)') | map(attribute=1) | list | first }}"
  register: dist_var
  become: false
  vars:
    bootstrap_distribution: "{{ dist_var.stdout | first | replace('"', '') }}"
    bootstrap_distribution_major_version: "{{ dist_var.stdout | last | replace('"', '') }}"

- name: Set Bootstrap OS Family Facts (II)
  loop: "{{ bootstrap_os_family_map | dict }}"
  vars:
    family_search: "{{ item.value.distribution }}"
  when: bootstrap_distribution is in (item.value.distribution)
  shell: echo "{{ item.key }}"
  register: family_var
  become: false
  vars:
    bootstrap_os_family: "{{ family_var.stdout }}"


