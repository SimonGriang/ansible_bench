---
- name: Check all variables have been set correctly
  include_tasks: assert.yml
  args:
    host: localhost
    ansible_host: 127.0.0.1

- name: Wait for host (when configured)
  wait_for:
    host: "{{ ansible_ssh_host | default(ansible_port | default('localhost')) }}"
    port: "{{ ansible_port | default(5358)}}"
    state: started
    timeout: "{{ bootstrap_timeout | default(300) }}"
  when: ansible_connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare the system
  block:
    - name: Check connection
      command: whoami
      register: connection_result
      ignore_errors: yes

    - name: Log connection status
      debug:
        msg: "Connection test result: {{ connection_result | json }}"

    - name: Mark task as changed
      set_fact:
        system_prepared: true
      changed_when: connection_result.rc != 0

    - name: Include gather facts
      include_tasks: gather_facts.yml

    - name: Include install packages
      include_tasks: install_packages.yml
  become: "{{ bootstrap_become | default('yes') }}"
  become_user: "{{ bootstrap_become_user | default('root') }}"

- name: Ensure system is prepared by issuing ansible modules
  include_tasks: prepare.yml
  vars:
    packages_to_install: "{{ bootstrap__facts_packages | default([]) }}"
  loop: "{{ packages_to_install | default([]) }}"
  become: "{{ bootstrap_become | default('yes') }}"
  become_user: "{{ bootstrap_become_user | default('root') }}"


