---
- name: Populate services facts
  systemd:
    list: true
    service: true
    command: list-unit-files
    type: service
  register: services_facts

- name: Set the Active Server variable
  set_fact:
    active_server: "{{ ansible_hostname }}"
  when:
    - ansible_hostname in group_vars['rke2_servers_group_name']
    - (ansible_service_mgr is not None and
       (ansible_service_mgr.status['rke2-server'] is not None and
       ansible_service_mgr.status['rke2-server'] == 'running'))
  delegate_to: all
  run_once: yes
  vars:
    cluster_group: rke2_cluster_group_name


