---
- name: Assert that systemd is being used as the init system
  command: systemd --version 2>/dev/null
  register: systemd_check
  changed_when: false
  ignore_errors: yes

  name: Check if systemd is available
  assert:
    that:
      - systemd_check.rc == 0
  fail_json:
    msg: "Systemd is not being used as the init system"

- name: Get the latest release of the Grafana Loki project from the GitHub API
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    headers:
      Accept: application/json
    method: GET
    status_code: 200
    retries: 5
    delay: 5
  register: _latest_release
  ignore_errors: yes

- name: Set the promtail version to the latest release tag if it's set to 'latest'
  set_fact:
    promtail_version: "{{ _latest_release.releaseTagName | replace('v', '') }}"

- name: Test if the zip local archive exists in the specified directory
  stat:
    path: "{{ promtail_local_directory }}/{{ promtail_version }}.zip"
  register: promtail_zip_exists
  ignore_errors: yes

- name: Assert that the local binary exists in the specified directory
  stat:
    path: "{{ promtail_local_directory }}/{{ promtail_binary }}"
  register: promtail_binary_exists
  ignore_errors: yes

- name: Get the checksum list for the latest release
  uri:
    url: "https://github.com/grafana/loki/releases/download/{{ _latest_release.releaseTagName }}/checksum.txt"
    headers:
      Accept: text/plain
    method: GET
    status_code: 200
  register: __promtail_checksums
  ignore_errors: yes

- name: Get the checksum for the specified architecture
  set_fact:
    __promtail_checksum: "{{ __promtail_checksums.content | regex_search(promtail_architecture + '\\.zip') }}"
  when: promtail_local_directory == ''


