---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Enable redis package using DNF
  dnf:
    name: redis
    state: enabled

- name: Install redis package
  package:
    name: "{{ redis_packages }}"

- name: Configure redis
  copy:
    dest: /etc/redis.conf
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart redis

- name: Start and enable redis service
  service:
    name: "{{ redis_service }}"
    state: running
    enabled: true


