        policy: targeted
      when: ansible_os_family == "RedHat"

    - name: Install SELinux policy package
      ansible.builtin.apt:
        name: selinux-policy
        state: present
      when: ansible_os_family == "Debian"

    - name: Enforce AppArmor policies
      ansible.builtin.apparmor_status:
