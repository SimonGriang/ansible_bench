---
- name: Import assert.yml task file
  ansible.builtin.import_tasks:
    file: assert.yml
  run_once: true
  host: localhost

- name: Install docker-compose package
  ansible.builtin.package:
    name: "{{ docker_compose_package_name | default('docker-compose') }}"
    state: present
  when: docker_compose_installation_type == "package"

- name: Install docker-compose as binary
  block:
    - name: Install required packages for binary installation
      ansible.builtin.package:
        name: "{{ docker_compose_binary_required_packages | default([]) }}"
        state: present

    - name: Download and install docker-compose binary
      ansible.builtin.get_url:
        url: "{{ docker_compose_url }}"
        dest: /usr/local/bin/docker-compose
        mode: '0755'
  when: docker_compose_installation_type == "binary"


