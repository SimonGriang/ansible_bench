---
- name: Check if Helm binary exists at specified path
  file:
    path: "{{ helm_bin_path }}"
    state: file
    check_mode: yes
  register: helm_check

- name: Check current version of Helm installed
  command:
    cmd: "{{ helm_bin_path }}/version"
    changed_when: false
    failed_when: false
  register: helm_existing_version

- name: Download Helm binary from specified repository
  get_url:
    url: "{{ helm_repo_path }}/v{{ helm_version }}/{{ helm_platform }}/{{ helm_arch }}/helm-{{ helm_version }}.{{ helm_platform }}-{{ helm_arch }}"
    dest: /tmp/helm-{{ helm_version }}.{{ helm_platform }}-{{ helm_arch }}
    force: yes
  when:
    - not helm_check.stat.exists
    - "{{ helm_existing_version.stdout.version }}" != "{{ helm_version }}"

- name: Copy downloaded Helm binary into place
  copy:
    src: /tmp/helm-{{ helm_version }}.{{ helm_platform }}-{{ helm_arch }}
    dest: "{{ helm_bin_path }}"
    remote_src: yes
    become: true
  when:
    - changed_in_previous_task


