- name: Manage group with specified name and state
  group:
    name: "{{ group.name }}"
    state: present
    gid: "{{ group.gid | default('omit') }}"
    system: "{{ group.system | default(false) }}"

- name: Configure sudo options for a group
  template:
    src: sudo_group.j2
    dest: /etc/sudoers.d/{{ group.name }}
    mode: '0640'
  when: group.sudo_options is defined


