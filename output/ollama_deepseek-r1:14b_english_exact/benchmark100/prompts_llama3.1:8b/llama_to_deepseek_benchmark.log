---
- name: Lookup bootstrap facts by running the cat /etc/os-release command
  raw: cat /etc/os-release
  register: bootstrap_facts

- name: Set bootstrap distribution and major version facts
  set_fact:
    bootstrap_distribution: "{{ item.value.distribution }}"
    bootstrap_major_version: "{{ item.value.major_version }}"
  loop: "{{ bootstrap__os_family_map.items() | dict2list }}"

- name: Set bootstrap OS family fact
  set_fact:
    bootstrap_os_family: "{{ item.value.os_family }}"
  loop: "{{ bootstrap__os_family_map.items() | dict2list }}"



