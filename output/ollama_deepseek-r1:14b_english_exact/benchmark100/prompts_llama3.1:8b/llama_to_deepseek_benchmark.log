---
- name: Import and run tasks from assert.yml playbook
  include_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true
  changed_when: false

- name: Install required packages for the service
  apt:
    name: "{{ service_required_packages }}"
    state: present

- name: Configure systemd service for each service
  loop: "{{ service_list }}"
  tasks:
    - name: Copy systemd service file
      template:
        src: systemd.j2
        dest: /etc/systemd/system/{{ item.name }}.service
        mode: 0644
      when: ansible_distribution in [
          'centos',
          'fedora',
          'rhel',
          'ol',
          'debian',
          'ubuntu'
      ]
      notify: Systemctl daemon-reload

    - name: Check if systemd is available
      command: systemctl --version
      ignore_errors: yes

- name: Configure sysvinit service for each service
  loop: "{{ service_list }}"
  tasks:
    - name: Copy sysvinit service file
      template:
        src: sysvinit.j2
        dest: /etc/init.d/{{ item.name }}
        mode: 0755
      when: ansible_os_family in ['RedHat', 'Debian']
      notify: Sysvinit service configured

- name: Manage each service
  loop: "{{ service_list }}"
  tasks:
    - name: Enable or start service
      service:
        name: "{{ item.name }}"
        state: "{{ item.state | default('started') }}"
        enabled: "{{ item.enabled | default('true') }}"

- name: Flush handlers
  meta: flush_handlers


