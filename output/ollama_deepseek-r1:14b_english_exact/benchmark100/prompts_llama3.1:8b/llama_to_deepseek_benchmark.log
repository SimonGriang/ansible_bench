---
- name: Install unzip package and update cache if necessary
  apt:
    name: unzip
    state: present
    update_cache: "{{ promtail_apt_update_cache | default('yes') }}"

- name: Create promtail system group if necessary
  group:
    name: "{{ promtail_system_group }}"
    state: present
    group_by_name: yes
    system: yes
  when: promtail_system_group != 'root'

- name: Create the promtail system user
  user:
    name: "{{ promtail_system_user }}"
    state: present
    home: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    groups: "{{ promtail_user_additional_groups | default([]) }}"
    system: yes
    shell: /sbin/nologin
  when: promtail_system_user != 'root'

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: 0755

- name: Create necessary config directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
  loop:
    - /etc/promtail
    - /var/lib/promtail/positions

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
  loop:
    - /usr/local/promtail
    - /usr/local/promtail/bin

- name: Check the existence of the promtail binary
  stat:
    path: /usr/local/promtail/bin/promtail

- name: Download promtail binaries if necessary
  url:
    url: "{{ promtail_binary_url }}"
    dest: /tmp/promtail.zip
    force: yes
  when: promtail_binary_url is defined

- name: Propagate locally distributed promtail archive if necessary
  copy:
    src: "{{ promtail_local_archive | default('/') }}"
    dest: /tmp/promtail.zip
    remote_src: yes
  when: promtail_local_archive is defined

- name: Download promtail binaries to controller node if necessary
  url:
    url: "{{ promtail_binary_url }}"
    dest: /usr/local/promtail/bin/promtail
    force: yes
  when: promtail_binary_propagate is true

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail
    dest: /usr/local/promtail/bin
    remote_src: yes
  when: promtail_binary_propagate is true

- name: Unpack promtail binaries
  unzip:
    dest: /usr/local/promtail/bin
    file: /tmp/promtail.zip

- name: Create a symlink to the latest version
  ln:
    state: symlink
    src: /usr/local/promtail/bin/promtail
    dest: /usr/local/bin/promtail

- name: Write the promtail configuration
  template:
    src: "{{ promtail_config_src | default('promtail-config.yml') }}"
    dest: /etc/promtail/promtail.yml
    mode: 0644
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"

- name: Create the systemd service unit
  template:
    src: "{{ promtail_systemd_src | default('promtail.service') }}"
    dest: /etc/systemd/system/promtail.service
    mode: 0644
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"


