---
- name: Gather basic system facts
  action: raw command=cat /etc/os-release
  register: bootstrap_facts
  become: false

- name: Extract distribution name and major version
  set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_distribution_major_version: "{{ item.major_version }}"
  vars:
    item_list:
      - key: PRETTY_NAME
        value: |
          {{ (
            bootstrap_facts.stdout_lines
            | select('startswith', 'PRETTY_NAME=')
            | first
            | regex_replace('PRETTY_NAME=.*?\"(.*?)"', '\1')
          ) }}
      - key: VERSION_ID
        value: |
          {{ (
            bootstrap_facts.stdout_lines
            | select('startswith', 'VERSION_ID=')
            | first
            | regex_replace('VERSION_ID=.*?\"(.*?)"', '\1')
          ) }}
  loop: "{{ item_list }}"

- name: Identify operating system family
  set_fact:
    bootstrap_os_family: "{{ family }}"
  vars:
    bootstrap_os_family_map:
      Debian: debian
      Ubuntu: debian
      RHEL: redhat
      CentOS: redhat
      Fedora: fedora
      Amazon: amazon
  loop: "{{ bootstrap_os_family_map }}"
  loop_control:
    label: "{{ family }}"



