---
- name: Task 1: Import assert.yml and run once on localhost
  import_tasks: assert.yml
  delegate_to: localhost
  no_log: true

- name: Task 2: Install Apache HTTP server
  ansible.builtin.package:
    name: "{{ httpd_packages }}"
    state: present

- name: Task 3: Configure SELinux if enabled
  ansible.builtin.selinux:
    state: "{{ 'enabled' if selinux_enabled else 'disabled' }}"
    booleans: "{{ httpd_sebooleans }}"
    ports: "{{ httpd_port | default('80') }}:http,{{ httpd_ssl_port | default('443') | default('') }}:https"

- name: Task 4: Configure Apache main config file
  ansible.builtin.template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "0644"
  notify: 
    - httpd_config_test
    - httpd_restart

- name: Task 5: Activate Apache modules on Debian
  ansible.builtin.command:
    cmd: a2enmod "{{ item }}"
    when: ansible_os_family == "Debian"
    with_items: "{{ httpd_modules_to_activate_with_command }}"

- name: Task 6: Import SSL config if HTTPS is enabled
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Task 7: Import locations config if defined
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Task 8: Import virtual host config if defined
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Task 9: Configure Apache ports on Debian and SUSE
  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ '/etc/apache2/ports.conf' if ansible_os_family == 'Debian' else '/etc/apache/ports.conf' }}"
    mode: "0644"
  notify:
    - httpd_config_test
    - httpd_restart
  when: ansible_os_family in ['Debian', 'SUSE']

- name: Task 10: Import directory config if defined
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Task 11: Flush pending handlers
  ansible.builtin.meta: 
    flush_handlers: yes

- name: Task 12: Remove default index.html if specified
  ansible.builtin.file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Task 13: Start and enable Apache service
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


