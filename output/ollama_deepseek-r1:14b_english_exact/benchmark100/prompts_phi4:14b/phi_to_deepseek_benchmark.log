- name: Import assert.yml and run once on localhost
  import_tasks: assert.yml
  loop: false
  hosts: localhost

- name: Install required packages
  ansible.builtin.package:
    name: "{{ sysctl_requirements }}"
    state: present

- name: Configure sysctl settings
  ansible.posix.sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    sysctl_set: "{{ sysctl_set | default('true') }}"
    sysctl_reload: "{{ sysctl_reload | default('true') }}"
  loop: "{{ sysctl_items if sysctl_items is defined else [] }}"
  when:
    - sysctl_set | default('true') | bool
    - not (ansible_containerized | default('false'))
  vars:
    item: "{{ loop_var }}"


