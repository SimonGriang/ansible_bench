---
- name: Import an additional task file to assert conditions
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Pre-configure Debian systems for Postfix
  debconf:
    name: postfix/main_mailer_type
    value: "No configuration"
    state: present

- name: Install Postfix
  apt-get:
    name: postfix
    state: present

- name: Conditionally install postfix-mysql
  apt-get:
    name: postfix-mysql
    state: present
  when:
    - postfix_virtual_mailbox_maps is defined
    - postfix_virtual_mailbox_domains is defined
    - postfix_virtual_alias_maps is defined

- name: Configure Postfix transport maps
  template:
    src: "{{ postfix_transport_maps_template }}"
    dest: /etc/postfix/transport
    mode: 0644
  notify: validate_postfix_transport

- name: Configure Postfix header checks
  template:
    src: "{{ postfix_header_checks_template }}"
    dest: /etc/postfix/header_checks
    mode: 0644
  notify: reload_postfix

- name: Set values for Postfix main.cf (part 1)
  set_fact:
    postfix_recipient_restriction: "{% if postfix_recipient_access is defined and (stat(postfix_recipient_access).exists|bool) %}{{ lookup('file', postfix_recipient_access) }}{% endif %}"

- name: Set values for Postfix main.cf (part 2)
  set_fact:
    postfix_sender_restriction: "{% if postfix_sender_access is defined and (stat(postfix_sender_access).exists|bool) %}{{ lookup('file', postfix_sender_access) }}{% endif %}"

- name: Configure Postfix main.cf
  template:
    src: "{{ postfix_main_cf_template }}"
    dest: /etc/postfix/main.cf
    mode: 0644
  notify: validate_postfix_main

- name: Configure Postfix master.cf
  template:
    src: "{{ postfix_master_cf_template }}"
    dest: /etc/postfix/master.cf
    mode: 0644
  notify: validate_postfix_master

- name: Create directories for TLS certificates and keys
  file:
    path: "{{ postfix_tls_dir }}"
    state: directory
    mode: 0755

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_tls_certificate }}"
    dest: "{{ postfix_tls_dir }}/postfix.crt"
    mode: 0644
  when: postfix_tls_certificate is defined
  notify: reload_postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_tls_private_key }}"
    dest: "{{ postfix_tls_dir }}/postfix.key"
    mode: 0644
  when: postfix_tls_private_key is defined
  notify: reload_postfix

- name: Flush Postfix handlers
  meta:
    flush_handlers: yes

- name: Configure Postfix aliases
  lineinfile:
    path: "{{ postfix_aliases_file }}"
    line: "{{ item }}"
    state: present
    validate: false
  with_items: "{{ postfix_aliases | default([]) | list }}"
  when:
    - postfix_aliases is defined
    - (postfix_aliases | length) > 0
  notify: rebuild_aliases

- name: Configure Postfix sender access
  lineinfile:
    path: "{{ postfix_sender_access_file }}"
    line: "{{ item }}"
    state: present
    validate: false
  with_items: "{{ postfix_sender_access | default([]) | list }}"
  when:
    - postfix_sender_access is defined
    - (postfix_sender_access | length) > 0
  notify: rebuild_sender_access

- name: Configure Postfix recipient access
  lineinfile:
    path: "{{ postfix_recipient_access_file }}"
    line: "{{ item }}"
    state: present
    validate: false
  with_items: "{{ postfix_recipient_access | default([]) | list }}"
  when:
    - postfix_recipient_access is defined
    - (postfix_recipient_access | length) > 0
  notify: rebuild_recipient_access

- name: Place SASL password map
  copy:
    src: "{{ postfix_smtp_sasl_password_map }}"
    dest: /etc/postfix/sasl_password_map
    mode: 0644
  when:
    - postfix_smtp_sasl_password_map is defined
    - (postfix_smtp_sasl_password_map | length) > 0
  notify: rebuild_sasl_map

- name: Flush Postfix handlers again
  meta:
    flush_handlers: yes

- name: Start and enable Postfix service
  systemctl:
    name: postfix
    state: started
    enabled: yes


