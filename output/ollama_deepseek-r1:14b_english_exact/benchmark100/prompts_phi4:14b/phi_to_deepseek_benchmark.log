---

- import_tasks: assert.yml
  delegate_to: localhost
  tags:
    - always
  run_once: true

- name: Wait for port to be available
  ansible.builtin.wait_for_port:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when:
    - bootstrap_wait_for_host
  no_log: false

- block:
    - name: Test connection and check sudo availability
      shell: |
        ping -c 1 localhost && echo "Connection OK" || echo "Connection Failed"
        exit $? || true
      changed_when: false
      ignore_errors: yes

    - name: Gather bootstrap facts and install packages
      raw: |
        if command -v sudo; then echo "Sudo is available"; fi
        exit 0
      changed_when: false
      ignore_errors: yes
      when: "{{ ansible_distribution_id }} != 'centos'"

    - name: Install libdnf5 on RedHat-based systems
      yum:
        name: libdnf5
        state: present
      when: "{{ ansible_distribution_id == 'centos' }}"

  ignore_errors: yes

- name: Gather Ansible facts
  ansible.builtin.setup:
    gather_subset: all
  become: false

- name: Install bootstrap packages
  apt:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
  when: "{{ ansible_os_family == 'Debian' }}"
  become: "{{ bootstrap_become }}"

- name: Install packages on RedHat
  yum:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
  when: "{{ ansible_os_family == 'RedHat' }}"
  become: "{{ bootstrap_become }}"

