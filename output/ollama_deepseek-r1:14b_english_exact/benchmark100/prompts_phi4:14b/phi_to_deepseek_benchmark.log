---
- name: Install EPEL repository on supported systems
  become: true
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present
  register: epel_key_result
  notify: Update package cache

- name: Install EPEL GPG key
  become: true
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install EPEL-release package
  become: true
  ansible.builtin.package:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Install EPEL-next-release if enabled
  become: true
  ansible.builtin.package:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next
  notify: Update package cache

- name: Update package cache
  become: true
  ansible.builtin.shell:
    cmd: yum clean all && yum makecache
  trigger: false


