  set_fact:
    java_version: "{{ java_version | default('latest') }}"
    java_distribution: "{{ java_distribution | default('eclipse') }}"
  when: java_version is not defined or java_version == None

- name: Set OS and architecture-specific Java variables
  set_fact:
    java_full_version: "{{ java_full_version | default('latest') }}"
