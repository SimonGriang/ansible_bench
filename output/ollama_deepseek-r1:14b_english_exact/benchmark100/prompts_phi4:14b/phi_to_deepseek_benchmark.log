---
- name: Task 1: Import the assert.yml file to be executed once on the localhost
  import_tasks: assert.yml
  delegate_to: localhost
  changed_when: false

- name: Task 2: Configure apk package manager
  apt:
    state: update
    no_install_recommends: yes
  changed_when: false
  when: ansible_pkg_mgr == 'apk'

- name: Task 3: Configure apt package manager
  apt:
    state: update
    hold_selected: yes
    environment: { DEBIAN_FRONTEND: noninteractive }
    autoremove: yes
  notify: Reboot the system
  when: ansible_pkg_mgr == 'apt'

- name: Task 4: Update all software using dnf package manager
  dnf:
    state: latest
    exclude: '{{ exclude_packages | default([]) }}'
  notify: Reboot the system
  when: ansible_pkg_mgr in ['dnf', 'dnf5']

- name: Task 5: Update all software using pacman package manager
  pacman:
    state: update
  notify: Reboot the system
  when: ansible_pkg_mgr == 'pacman'

- name: Task 6: Configure yum package manager
  yum:
    state: latest
  notify: Reboot the system
  when: ansible_pkg_mgr == 'yum'
  vars:
    ansible_yum_version: 6
  when: ansible_distribution_version|int == 6
  register: yum_result
  changed_when: false
  async: 0
  ignore_errors: yes

- name: Task 6: Install yum-utils for older versions
  yum:
    name: yum-utils
    state: present
  when: ansible_pkg_mgr == 'yum' and ansible_distribution_version|int != 6
  changed_when: false
  async: 0
  ignore_errors: yes

- name: Task 7: Update all software using zypper package manager
  zypper:
    state: update
  notify: Reboot the system
  when: ansible_pkg_mgr == 'zypper'


