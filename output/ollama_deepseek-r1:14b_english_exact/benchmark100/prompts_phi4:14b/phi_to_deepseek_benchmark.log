---
- name: Import additional tasks from assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install the bash package
  apt:
    name: bash
    state: present

- name: Install OpenJDK if the vendor is openjdk
  apt:
    name: "{{ java_openjdk_package }}"
    state: present
    environment:
      JAVA_HOME: /usr/lib/jvm/java-{{ java_openjdk_version }}
  when: java_vendor == "openjdk"

- name: Copy Oracle Java RPM package to /tmp and install
  copy:
    src: "{{ java_oracle_rpm_path }}"
    dest: /tmp/
    remote_src: yes
  when: 
    - java_source == "local"
    - java_format == "rpm"

- name: Install Oracle Java RPM package
  yum:
    name: "{{ java_oracle_package }}"
    state: present
  when: 
    - java_source == "repository"
    - java_format == "rpm"

- name: Copy Oracle Java DEB package to /tmp and install
  copy:
    src: "{{ java_oracle_deb_path }}"
    dest: /tmp/
    remote_src: yes
  when: 
    - java_source == "local"
    - java_format == "deb"

- name: Install Oracle Java DEB package
  apt:
    name: "{{ java_oracle_package }}"
    state: present
  when: 
    - java_source == "local"
    - java_format == "deb"

- name: Install Oracle Java targz package
  unarchive:
    src: "{{ java_oracle_targz_path }}"
    dest: "{{ java_install_dir }}"
    remote_src: yes
    executable: /bin/bash
  when: 
    - java_vendor == "oracle"
    - java_format == "targz"
    - ansible_distribution != "alpine"

- name: Install Oracle JCE policy software
  unarchive:
    src: "{{ jce_policy_zip }}"
    dest: /usr/lib/jvm/{{ java_home }}/jce
    remote_src: yes
    executable: /bin/bash
  when: 
    - java_version == "8"
    - jce_enabled
    - java_vendor == "oracle"

- name: Set Java as default alternative
  command: update-alternatives --install /usr/bin/java {{ java_alternative_name }}
  when: 
    - java_vendor == "oracle"
    - java_format == "targz"
    - ansible_distribution != "alpine"

- name: Determine JAVA_HOME
  shell: readlink -e /usr/bin/java | dirname
  register: java_home

- name: Set JAVA_HOME in /etc/profile.d/java_home.sh
  template:
    src: java_home.sh.j2
    dest: /etc/profile.d/java_home.sh
    mode: 0755
  when: 
    - java_vendor == "oracle"
    - java_format == "targz"
    - ansible_distribution != "alpine"


