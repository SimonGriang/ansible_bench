---
- name: Gather bootstrap facts by reading the /etc/os-release file
  raw: cat /etc/os-release
  changed_when: false
  register: bootstrap_facts

- name: Set bootstrap distribution facts based on the gathered information
  set_fact:
    bootstrap_distribution: "{{ lookup('ansible.utils.together', ['os_release']) | json_query('PRETTY_NAME') }}"
    bootstrap_distribution_major_version: "{{ (bootstrap_facts | json_query('VERSION_ID')) | regex_replace('.*?([0-9]+).*', '\\1') | int }}"
  when:
    - "bootstrap_facts is not None"
    - "bootstrap_distribution is not defined"
    - "lookup('ansible.utils.together', ['os_release']) | json_query('PRETTY_NAME') is not None"

- name: Set bootstrap operating system family based on the distribution
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  when:
    - "bootstrap_distribution is not None"
    - "{{ lookup('ansible.utils.together', ['os_release']) | json_query('PRETTY_NAME') }} is not None"
    - "{{ item.key }}" in bootstrap_distribution
  loop: "{{ bootstrap_os_family_map | dict2list }}"


