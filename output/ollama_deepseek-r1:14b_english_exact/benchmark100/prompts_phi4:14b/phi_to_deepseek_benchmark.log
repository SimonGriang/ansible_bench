---

- name: Import external tasks from assert.yml to be executed once on localhost
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install DNS-related packages
  become: true
  become_user: root
  apt:
    name: "{{ dns_packages }}"
    state: present

- name: Create necessary directories for DNS configuration and data
  become: true
  become_user: root
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0755
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create a group for DNS service
  become: true
  become_user: root
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create a user for the DNS service
  become: true
  become_user: root
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true
    group: "{{ dns_group }}"

- name: Generate the rndc key for DNS configuration
  become: true
  become_user: root
  command: dnssec-keygen -a RSASHA256 -b 2048 -r /dev/urandom Krndc{{ '0' if ansible_hostname == 'localhost' else '' }}
  args:
    creates: /etc/bind/rndc.key

- name: Set file permissions for the rndc key
  become: true
  become_user: root
  file:
    path: /etc/bind/rndc.key
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0640

- name: Download the root hints file if DNS caching is enabled
  become: true
  become_user: root
  get_url:
    url: https://www.root-nix.cz/root/db.root
    dest: /etc/bind/db.root
    mode: 0644
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  notify: Rndc reload

- name: Create primary zone files from templates
  become: true
  become_user: root
  template:
    src: "{{ itemTpl | default('dns/zone.j2') }}"
    dest: "{{ item.path }}"
    mode: 0644
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - { 
        itemTpl: "{{ dns_zones | default([]) if 'dns_zones' in groups else [] }}" 
      }
  notify: Rndc reload
  register: zone_files

- name: Add DNS zones to the main configuration file
  become: true
  become_user: root
  template:
    src: "{{ itemTpl | default('dns/named.conf.j2') }}"
    dest: /etc/bind/named.conf
    mode: 0644
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  notify: DNS service restart

- name: Create systemd service override if using systemd
  become: true
  become_user: root
  block:
    - name: Check if systemd is used
      ansible.builtin.fact_path:
        path: /usr/lib/systemd/system
      register: is_systemd

    - name: Create systemd service override
      file:
        path: /etc/systemd/system/{{ dns_service }}.d/override.conf
        state: touch
        mode: 0644
        owner: "{{ dns_owner }}"
        group: "{{ dns_group }}"
      when: is_systemd.stat.exists

    - name: Reload systemd
      command: systemctl daemon-reload
      when: is_systemd.stat.exists

- name: Start and enable the DNS service
  become: true
  become_user: root
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true

