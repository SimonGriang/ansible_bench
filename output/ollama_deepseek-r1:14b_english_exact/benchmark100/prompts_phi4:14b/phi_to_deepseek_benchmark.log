---
- name: Migrate the Java JDK vendor from adoptopenjdk to temurin if selected
  set_fact:
    java_jdk_vendor: "temurin"
  when: ansible_os_family == "Debian" and java_jdk_vendor == "adoptopenjdk"

- name: Gather OS-specific variables for the Java JDK
  include_vars:
    file: vars/{{ ansible_os_family }}.yml
  with_first_found: true

- name: Gather architecture-specific variables for the Java JDK
  include_vars:
    file: vars/architecture.yml
  with_first_found: true

- name: Set OS-specific Java variables
  set_fact:
    java_version: "{{ java_version | default('latest') }}"
    java_distribution: "{{ java_distribution | default('eclipse') }}"
  when: java_version is not defined or java_version == None

- name: Set OS and architecture-specific Java variables
  set_fact:
    java_full_version: "{{ java_full_version | default('latest') }}"
    java_maintainer: "{{ java_maintainer | default('Adoptium') }}"
  when: java_full_version is not defined or java_full_version == None

- name: Set specific Java variables
  set_fact:
    java_home: "/usr/lib/jvm/{{ java_jdk_vendor }}-jdk{{ java_version }}"

- name: Handle Debian pre-requisites for Java installation
  block:
    - name: Remove deprecated Java repository
      apt:
        name: "{{ item }}"
        state: absent
      loop: "{{ java_deprecated_repositories }}"

    - name: Install extra packages
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ java_extra_packages }}"

    - name: Add Java key repository
      apt_key:
        keyserver: keyserver.ubuntu.com
        key: "{{ java_repository_key }}"

    - name: Add Java repository
      apt_repository:
        repo: "deb {{ java_repository_url }} {{ ansible_lsb.codename }} main"
  when:
    - ansible_os_family == "Debian"

- name: Handle RedHat pre-requisites for Java installation
  block:
    - name: Add Java key repository
      yum:
        name: "{{ item }}"
        state: present
      loop: "{{ java_repository_key }}"

    - name: Add Java repository
      yum:
        name: "{{ item }}"
        state: present
      loop: "{{ java_repository_url }}"
  when:
    - ansible_os_family == "RedHat"

- name: Install required libraries for Java
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_packages }}"

- name: Install Java on Debian systems
  apt:
    name: "{{ java_jdk_package_name }}"
    state: present
  when: ansible_os_family == "Debian"

- name: Install Java on RedHat systems
  yum:
    name: "{{ java_jdk_package_name }}"
    state: present
  when: ansible_os_family == "RedHat"

- name: Export Java environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh

- name: Source Java environment variables
  shell: source /etc/profile.d/jdk.sh

- name: Correct Java version selection for versions less than 11 on Debian systems
  alternatives:
    name: java
    state: present
    priority: 10
  when:
    - ansible_os_family == "Debian"
    - java_version|int < 11

- name: Correct Java version selection for versions 11 or greater on Debian systems
  alternatives:
    name: java
    state: present
    priority: 1
  when:
    - ansible_os_family == "Debian"
    - java_version|int >= 11

