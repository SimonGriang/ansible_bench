t the formatting to pass yamllint.\n\nOnce I\'ve made these changes, I\'ll review the playbook to ensure all lines are within the 80 character limit and that the structure is valid YAML. This should resolve the yamllint errors without altering the tasks\' functionality.\n</think>\n\n---\n- name: Gather bootstrap facts\n  raw:\n    cmd: cat /etc/os-release\n  register: bootstrap_facts\n  changed_when: false\n\n- name: Set bootstrap distribution and major version facts\n  set_fact:\n    bootstrap_distribution: "{{ lookup(\'dict\', bootstrap_os_family_map.value, key=bootstrap_distribution) | default(\'unknown_distribution\') }}"\n    bootstrap_distribution_major_version: "{{ lookup(\'dict\', bootstrap_distribution_major_version_map.value, key=bootstrap_distribution) | default(\'unknown_major_version\') }}"\n  when:\n    - bootstrap_facts.rc == 0\n    - notansible_facts.get(\'bootstrap_distribution\', False)\n    - ansible.utils.display.pretty_name_facts(\n        pretty_name=bootstrap_facts.stdout|ansible.utils.display.parse_os_release|dict2list|selectattr(\'PRETTY_NAME\')|first,\n        search=bootstrap_search\n      )\n\n- name: Determine and set bootstrap OS family\n  set_fact:\n    bootstrap_os_family: "{{ item.key }}"\n  with_items: "{{ bootstrap_os_family_map.items() }}"\n  loop_control:\n    label: "{{ item.key }}"\n  when: "{{ item.value.distribution == bootstrap_distribution }}"' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-14T10:16:17.371801851Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14772278071, 'load_duration': 90253753, 'prompt_eval_count': 878, 'prompt_eval_duration': 435546556, 'eval_count': 705, 'eval_duration': 14245514381, 'model_name': 'deepseek-r1:14b'} id='run--230c7ac8-e5aa-44b5-bc93-6eb18938d3e5-0' usage_metadata={'input_tokens': 878, 'output_tokens': 705, 'total_tokens': 1583}
