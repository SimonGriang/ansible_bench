---
- name: Import assert.yml tasks
  ansible.builtin.import_tasks:
    file: assert.yml
    register: imported_tasks
  delegate_to: localhost
  changed_when: false

- name: Install HashiCorp products using package installation method
  when: installation_method == "package"
  block:
    - name: Ensure HashiCorp repository configuration for RedHat/Rocky
      ansible.builtin.get_url:
        url: https://download.hashicorp.com/hashicorp.repo
        dest: /etc/yum.repos.d/hashicorp.repo
        mode: '0644'
      when: ansible_os_family in ["RedHat", "Rocky"]

    - name: Ensure HashiCorp GPG key for Debian
      ansible.builtin.apt_key:
        url: https://apt.releases.hashicorp.com/gpg
        state: present
      when: ansible_os_family == "Debian"

    - name: Configure HashiCorp repository for Debian
      ansible.builtin.debconf:
        name: https://apt.releases.hashicorp.com
        question: "debconf Reelease"
        value: "{{ ansible_distribution_release }}"
      when: ansible_os_family == "Debian"

    - name: Install HashiCorp products using package manager
      ansible.builtin.yum:
        name: "{{ item.name }}"
        state: present
        version: "{{ item.version | default('latest') }}"
      loop: "{{ hashicorp_products }}"
      when: ansible_os_family in ["RedHat", "Rocky"]

    - name: Install HashiCorp products using package manager
      ansible.builtin.apt:
        name: "{{ item.name }}"
        state: present
        version: "{{ item.version | default('latest') }}"
      loop: "{{ hashicorp_products }}"
      when: ansible_os_family == "Debian"

- name: Install HashiCorp products manually
  when: installation_method == "manual"
  ansible.builtin.unarchive:
    src: "{{ hashicorp_product_source }}"
    dest: "{{ hashicorp_product_dest }}"
    remote_src: yes
    owner: "{{ hashicorp_product_owner | default('root') }}"
    group: "{{ hashicorp_product_group | default('root') }}"
    mode: "{{ hashicorp_product_mode | default('0755') }}"


