---
- name: Check for the existence of the EXTERNALLY-MANAGED file for Python 3.11
  ansible.builtin.file:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
    state: file
    register: python311_managed

- name: Rename the EXTERNALLY-MANAGED file for Python 3.11 if it exists
  ansible.builtin.file:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
    state: file
    dest: /usr/lib/python3.11/EXTERNALLY-MANAGED.old
    mode: 0o644
  when: python311_managed.stat.exists

- name: Check for the existence of the EXTERNALLY-MANAGED file for Python 3.12
  ansible.builtin.file:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
    state: file
    register: python312_managed

- name: Rename the EXTERNALLY-MANAGED file for Python 3.12 if it exists
  ansible.builtin.file:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
    state: file
    dest: /usr/lib/python3.12/EXTERNALLY-MANAGED.old
    mode: 0o644
  when: python312_managed.stat.exists

- name: Import tasks from assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: ansible localhost
  run_once: true

- name: Install Python pip
  ansible.builtin.apt:
    name: python3-pip
    state: present

- name: Configure pip proxy settings
  ansible.builtin.template:
    src: /etc/pip.conf.j2
    dest: /etc/pip.conf
    mode: 0o644
  when: python_pip_proxy is defined

- name: Configure trusted hosts for pip
  ansible.builtin.template:
    src: /etc/pip.conf.j2
    dest: /etc/pip.conf
    mode: 0o644
  when: python_pip_trusted_host is defined

- name: Update pip to the latest version
  ansible.builtin.pip:
    name: pip
    version: latest
    executable: "{{ python_pip_executable | default('pip3') }}"
    state: latest
  when:
    - python_pip_update is true
    - (ansible_distribution_release not in ["bookworm", "noble"])
    - ansible_os_family not in ["Alpine"]

- name: Install requested Python modules
  ansible.builtin.pip:
    requirements: "{{ item }}"
    executable: "{{ python_pip_executable | default('pip3') }}"
    state: present
    version: "{{ item_version | default('latest') }}"
  loop: "{{ python_pip_modules | default([]) | dict_contents() }}"
  when:
    - (ansible_distribution_release not in ["bookworm", "noble"])
    - ansible_os_family not in ["Alpine"]


