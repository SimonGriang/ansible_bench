---
- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Retrieve current Helm version
  command:
    cmd: "{{ helm_bin_path }}/helm version"
    failed_when: false
    changed_when: false
  register: helm_existing_version

- name: Download specified version of Helm if needed
  unarchive:
    src: "{{ helm_repo_path }}/Chart.yaml"
    dest: "{{ helm_bin_path }}"
    remote_src: yes
  condition: "{{ not helm_check.stat.exists or (helm_existing_version.stdout.version != helm_version | bool) }}"

- name: Install Helm binary
  copy:
    src: "{{ helm_bin_path }}/helm"
    dest: "{{ helm_bin_path }}/helm"
    mode: 0755
    become: true
  condition: "{{ helm_download is changed }}"

