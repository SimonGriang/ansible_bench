---
- name: Create document root directories for HTTP virtual hosts
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: "{{ item.documentroot_mode | default('0755') }}"
  loop: "{{ httpd_vhosts | default([]) if httpd_vhosts is defined else [] }}"
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - item.create_docroot is not false
  register: doc_root_creation

- name: Configure virtual host configuration files using templates
  ansible.builtin.template:
    src: "{{ vhost_conf_template | default('vhost.conf.j2') }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}"
    mode: "0644"
  loop: "{{ httpd_vhosts | default([]) if httpd_vhosts is defined else [] }}"
  notify:
    - Test HTTPD configuration
    - Restart HTTPD

- name: Enable virtual hosts on Debian-based systems
  block:
    - name: Check if site is already enabled
      ansible.builtin.file:
        path: "{{ httpd_enabled_sites_dir }}/{{ item.name }}"
        state: file
        mode: "0644"
        ignore_errors: yes
      register: site_enabled

    - name: Enable site using a2ensite
      ansible.builtin.command:
        cmd: a2ensite "{{ item.name }}"
      when: site_enabled | failed
      notify:
        - Test HTTPD configuration
        - Restart HTTPD
  loop: "{{ httpd_vhosts | default([]) if httpd_vhosts is defined else [] }}"
  when: ansible_os_family == 'Debian'


