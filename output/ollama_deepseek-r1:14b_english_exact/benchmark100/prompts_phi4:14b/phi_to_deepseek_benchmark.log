---
- name: Create the RKE2 manifests directory
  file:
    path: /etc/rke2/manifests
    state: directory
    owner: root
    group: root
    mode: 0700

- name: Copy kube-vip files to the first server
  template:
    src: "{{ item }}"
    dest: /etc/rke2/manifests/
    mode: 0664
  with_items:
    - kube-vip.yaml.j2
    - kube-scheduler.yaml.j2
  register: copied_files

- name: Copy kube-vip load balancer manifests to the first server
  template:
    src: "{{ item }}"
    dest: /etc/rke2/manifests/
    mode: 0664
  with_items:
    - load-balancer-aws-elb.yaml.j2
    - load-balancer-azure-nginx-ingress.yaml.j2
    - load-balancer-gcp-lb.yaml.j2
  when: cloud_provider_feature_enabled


