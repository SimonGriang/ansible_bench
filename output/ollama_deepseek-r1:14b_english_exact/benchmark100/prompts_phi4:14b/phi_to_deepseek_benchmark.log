- name: Import additional tasks from a file
  include_tasks: assert.yml
  delegate_to: localhost
  run_once: true
  loop: ['dummy']
  loop_control:
    ignore_errors: true

- name: Enable the Redis module for RHEL 8
  dnf:
    name: redis
    state: enabled
  when:
