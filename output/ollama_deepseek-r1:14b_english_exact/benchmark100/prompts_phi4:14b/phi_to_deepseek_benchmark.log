---
- name: Import assert.yml
  import_tasks: assert.yml
  host: localhost

- name: Install the git package
  become: yes
  apt:
    state: present
    name: "{{ git_packages }}"

- name: Check if the specified git user exists in the system
  getent:
    db: passwd
    key: "{{ git_username }}"

- name: Create a directory for the git configuration
  become: yes
  file:
    state: directory
    path: /home/{{ git_username }}
    owner: "{{ git_username }}"
    group: "{{ git_user_group }}"
    mode: 0755
  condition: git_username in ansible_user_ids

- name: Place the git configuration file
  become: yes
  template:
    src: gitconfig.j2
    dest: /home/{{ git_username }}/.gitconfig
    owner: "{{ git_username }}"
    group: "{{ git_user_group }}"
    mode: 0644
  condition: git_username in ansible_user_ids

- name: Create the repository destination directory
  become: yes
  file:
    state: directory
    path: "{{ git_repository_destination }}"
    owner: "{{ git_repository_owner }}"
    group: "{{ git_repository_group }}"
    mode: 0755
  when:
    - git_repository_destination is defined
    - git_username in ansible_user_ids

- name: Clone all specified repositories
  become: yes
  git:
    repo: "{{ item.repository }}"
    dest: "{{ git_repository_destination }}"
    branch: "{{ item.branch | default('main') }}"
    update: yes
    force_checkout: yes
    become_user: "{{ git_username }}"
    become_group: "{{ git_user_group }}"
    accept_hostkey: yes
  loop: "{{ git_repositories }}"
  when:
    - git_repositories is defined
    - git_repository_destination is defined
    - git_username in ansible_user_ids


