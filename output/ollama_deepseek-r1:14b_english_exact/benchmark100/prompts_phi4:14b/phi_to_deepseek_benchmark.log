---
- name: Create SSL key for each item
  community.crypto.openssl_privatekey:
    path: "{{ item.key_path }}"
    state: present
    passphrase: "{{ item.key_passphrase }}"
    mode: "{{ item.key_mode }}"
    owner: "{{ item.key_owner }}"
    group: "{{ item.key_group }}"
  loop: "{{ ssl_certs }}"

- name: Create SSL CSR for each item
  community.crypto.openssl_csr:
    path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    subject:
      common_name: "{{ item.csr_common_name }}"
      organization_unit: "{{ item.csr_organization_unit }}"
      organization: "{{ item.csr_organization }}"
      locality: "{{ item.csr_locality }}"
      state: "{{ item.csr_state }}"
      country: "{{ item.csr_country }}"
    mode: "{{ item.csr_mode }}"
    owner: "{{ item.csr_owner }}"
    group: "{{ item.csr_group }}"
  loop: "{{ ssl_certs }}"

- name: Create SSL certificates for each item
  community.crypto.x509_certificate:
    path: "{{ item.cert_path }}"
    privatekey_path: "{{ item.key_path }}"
    csr_path: "{{ item.csr_path }}"
    validity_days: 365
    mode: "{{ item.cert_mode }}"
    owner: "{{ item.cert_owner }}"
    group: "{{ item.cert_group }}"
  loop: "{{ ssl_certs }}"

- name: Create PKCS#12 file for each item
  community.crypto.openssl_pkcs12:
    path: "{{ item.pkcs12_path }}"
    privatekey_path: "{{ item.key_path }}"
    certfile: "{{ item.cert_path }}"
    passphrase: "{{ item.pkcs12_passphrase }}"
    mode: "{{ item.pkcs12_mode }}"
    owner: "{{ item.pkcs12_owner }}"
    group: "{{ item.pkcs12_group }}"
  loop: "{{ ssl_certs }}"

- name: Read private key for each item
  ansible.builtin.slurp:
    src: "{{ item.key_path }}"
  register: item.private_key
  loop: "{{ ssl_certs }}"

- name: Read certificate for each item
  ansible.builtin.slurp:
    src: "{{ item.cert_path }}"
  register: item.cert_content
  loop: "{{ ssl_certs }}"

- name: Create a combined private key and certificate file for each item
  ansible.builtin.copy:
    content: "{{ item.private_key.content | b64decode }}\n{{ item.cert_content.content | b64decode }}"
    dest: "{{ item.combined_path }}"
    mode: "{{ item.combined_mode }}"
    owner: "{{ item.combined_owner }}"
    group: "{{ item.combined_group }}"
  loop: "{{ ssl_certs }}"


