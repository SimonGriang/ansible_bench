---
- name: Disable swap if vault_hardening_disable_swap is set and swap is currently enabled.
  shell: swapoff -a
  args:
    cmd: swapoff -a
  when: vault_hardening_disable_swap and (swap_output.stdout is defined)
  register: swap_output
  ignore_errors: yes

- name: Remove swap entry from /etc/fstab
  file:
    path: /etc/fstab
    state: absent
    line: "^/dev/.* swap .*"
  when: vault_hardening_disable_swap

- name: Set PAM limits to prevent core dumps
  pam_limits:
    limits:
      core:
        soft: -1
        hard: -1
        domain: all
  when: vault_hardening_disable_core_dumps

- name: Create or modify script to disable history for vault commands
  template:
    src: vault_shell_history.sh.j2
    dest: /etc/profile.d/vault_shell_history.sh
    mode: '755'
  when: vault_hardening_disable_shell_command_history

- name: SetSELinux to enforcing if enabled
  shell: setenforce 1
  when: vault_hardening_configure_selinux_apparmor and ansible_selinux.enabled
  ignore_errors: yes

- name: Check SELinux status
  shell: sestatus
  when: vault_hardening_configure_selinux_apparmor
  changed_when: false
  ignore_errors: yes

- name: Enforce AppArmor profile for Vault
  shell: apparmorctl enforce /etc/apparmor.d/active.d/vault
  when: vault_hardening_configure_selinux_apparmor and ansible_apparmor.active
  ignore_errors: yes


