---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install nginx
  become: yes
  become_user: root
  apt:
    name: nginx
    state: present

- name: Place nginx.conf
  become: yes
  become_user: root
  template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: '0644'
    validate: yes
  notify: nginx_handler

- name: Ensure /etc/nginx/conf.d exists
  become: yes
  become_user: root
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: '0755'

- name: Place default.conf
  become: yes
  become_user: root
  template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: '0644'
  notify: nginx_handler

- name: Start and enable nginx
  become: yes
  become_user: root
  service:
    name: nginx
    state: started
    enabled: true


