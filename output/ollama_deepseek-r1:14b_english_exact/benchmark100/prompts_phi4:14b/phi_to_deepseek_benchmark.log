---
- name: Import assert.yml
  include_tasks:
    file: assert.yml
  delegate_to: localhost

- name: Install MySQL packages
  apt:
    name: "{{ mysql_packages }}"
    state: present
  notify: set_mysql_root_password

- name: Configure MySQL server configuration file
  template:
    src: mysql_server_config.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: 0644
  notify: restart_mysql_service

- name: Configure MySQL client configuration file
  template:
    src: mysql_client_config.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: 0644

- name: Initialize MySQL database if on Alpine or Archlinux
  command: mysql_install_db
  when: ansible_distribution in ["Alpine", "Archlinux"]
  notify: restart_mysql_service

- name: Start and enable MySQL service
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place the my.cnf configuration file
  template:
    src: my.cnf.j2
    dest: /root/my.cnf
    owner: root
    group: root
    mode: 0644

- name: Create MySQL databases
  mysql_db:
    name: "{{ db.name }}"
    state: present
    initial_root_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"
  when: not db.initial_import

- name: List current MySQL databases
  mysql_db:
    name: "*"
    state: list
    initial_root_password: "{{ mysql_root_password }}"
    ignore_errors: yes

- name: Import databases if initial import is defined and not already present
  mysql_db:
    name: "{{ db.name }}"
    state: import
    initial_root_password: "{{ mysql_root_password }}"
    target: "{{ db.initial_import }}"
  loop: "{{ mysql_databases }}"
  when: 
    - db.initial_import is defined
    - db.name not in existing_databases

- name: Create MySQL users
  mysql_user:
    name: "{{ user.name }}"
    password: "{{ user.password }}"
    priv: "{{ user.privileges }}"
    state: present
    initial_root_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


