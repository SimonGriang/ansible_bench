  when: sudo_options | default(false)

- name: Remove sudo privileges for users if not specified in their configuration
  file:
    path: /etc/sudoers.d/ssh-user
    state: absent
  when: not sudo_options | default(false)

- name: Generate a private SSH key for users who require SSH key management
  keypair:
    name: "{{ user_name }}"
    state: present
    generate_if_not_exist: yes
  changed_when: false

- name: Generate a public SSH key for users who require SSH key management
  keypair:
    name: "{{ user_name }}"
    state: present
    public_key: "{{ public_key }}"
    generate_if_not_exist: yes
  changed_when: false

- name: Convert the SSH key to a PPK format for users who require SSH key management
  ppk_openbsd:
    src: "/var/lib/ssh-keys/{{ user_name }}_key.pub"
    dest: "/var/lib/ssh-keys/{{ user_name }}_key.ppk"
    format: ppk
  changed_when: false

- name: Determine the home directory for users, defaulting to /home if the user is not found
  getent:
    db: users
    key: "{{ user_name }}"
  register: home_dir
  changed_when: false

- name: Create an .ssh directory in the user's home directory if SSH key management is enabled or private keys need to be set
  file:
    path: "{{ home_dir.item.home | default('/home') }}/.ssh"
    state: directory
    changed_when: false

- name: Deploy authorized SSH keys for users if specified
  authorized_key:
    user: "{{ user_name }}"
    state: present
    key: "{{ item }}"
