- name: Import assertion tasks
  ansible.builtin.include_tasks:
    file: assert.yml
  delegate_to: localhost

- name: Install PHP
  ansible.builtin.package:
    name: "{{ php_packages }}"
    state: present

- name: Find the used php.ini file
  ansible.builtin.shell: "{{ php_ini_command }}"
  register: php_found_ini_location
  changed_when: false
  when: php_ini_location is not defined

- name: Configure PHP
  ansible.builtin.template:
    src: php.ini.j2
    dest: "{{ php_found_ini_location.path }}"
    mode: 644
  notify: restart_httpd
  when: php_ini_location is not defined


