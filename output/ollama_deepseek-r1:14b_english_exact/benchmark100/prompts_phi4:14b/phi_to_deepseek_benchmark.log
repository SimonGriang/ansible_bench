---
- name: Collect the OS release information from the bootstrap server without making changes
  shell: cat /etc/os-release
  register: bootstrap_facts
  user: "{{ bootstrap_user }}"
  changed_when: false

- name: Set bootstrap facts for distribution and major version
  set_fact:
    bootstrap_distribution: "{{ (bootstrap_facts.stdout | regex_replace('^PRETTY_NAME=".*\\s(.*)$', '\\1') | regex_replace(' [()[].*$', '')).split()[0] | lower | replace(' ', '-') }}"
    bootstrap_distribution_major_version: "{{ (bootstrap_facts.stdout | regex_replace('^VERSION_ID="(.*)"', '\\1') | split('.')[0] }}"
  when:
    - bootstrap_facts.rc == 0
    - not ansible_facts | contains('bootstrap_distribution')
    - bootstrap_facts.stdout | match('PRETTY_NAME.*')
  become: yes
  become_user: "{{ bootstrap_become_user }}"

- name: Set bootstrap facts for the OS family
  set_fact:
    bootstrap_os_family: "{{ lookup('dict', bootstrap_distribution, default='unknown', key_from=bootstrap_distribution, value_from=bootstrap__os_family_map) }}"
  when: ansible_facts.bootstrap_distribution is defined
  become: yes
  become_user: "{{ bootstrap_become_user }}"


