---
- name: Determine package state
  ansible.builtin.command:
    cmd: dpkg -l | grep ansible
  register: ansible_installed
  changed_when: false
  ignore_errors: true

- name: Set package_state to present
  ansible.builtin.set_fact:
    package_state: "present"
  when: ansible_installed.rc == 0

- name: Set package_state to absent
  ansible.builtin.set_fact:
    package_state: "absent"
  when: ansible_installed.rc != 0

- name: Setup Ansible on RedHat (excluding Fedora)
  when:
    - ansible_distribution == "RedHat"
    - ansible_distribution != "Fedora"
    - package_state == "present"
  ansible.builtin.yum:
    name: ansible
    state: present

- name: Setup Ansible on Fedora
  when:
    - ansible_distribution == "Fedora"
    - package_state == "present"
  ansible.builtin.dnf:
    name: ansible
    state: present

- name: Setup Ansible on Ubuntu
  when:
    - ansible_distribution == "Ubuntu"
    - package_state == "present"
  ansible.builtin.apt:
    name: ansible
    state: present

- name: Setup Ansible on Debian
  when:
    - ansible_distribution == "Debian"
    - package_state == "present"
  ansible.builtin.apt:
    name: ansible
    state: present

- name: Setup Ansible using Pip
  when: package_state == "absent"
  ansible.builtin.pip:
    name: ansible
    state: present


