---
- name: Create necessary directories for cadvisor
  ansible.builtin.file:
    path: /var/lib/cadvisor
    state: directory
    mode: "755"
    become_user: root

- name: Download the cadvisor binary from a specified URL
  ansible.builtin.get_url:
    url: https://example.com/cadvisor
    dest: /usr/local/cadvisor/cadvisor
    checksum: sha256:abc123
    mode: "755"
    become_user: root
  when: not cadvisor_binary_local_dir

- name: Copy a locally distributed cadvisor binary if available
  ansible.builtin.copy:
    src: "{{ cadvisor_binary_local_dir }}/cadvisor"
    dest: /usr/local/cadvisor/
    mode: "755"
    remote_src: true
    notify: restart_cadvisor
  when: cadvisor_binary_local_dir
  become_user: root

- name: Create a symbolic link to the cadvisor binary
  ansible.builtin.file:
    path: /usr/local/bin/cadvisor
    src: /usr/local/cadvisor/cadvisor
    state: link
    become_user: root

- name: Deploy the systemd service file for the cadvisor server
  ansible.builtin.template:
    src: templates/cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    mode: "644"
    become_user: root

- name: Test if the cadvisor service is active
  ansible.builtin.shell:
    cmd: systemctl status cadvisor --no-pager 2>/dev/null
    register: cadvisor_status
    ignore_errors: true

- name: Debug the output of the service activity check
  ansible.builtin.debug:
    msg: "Cadvisor service status: {{ cadvisor_status.stdout }}"

- name: Enable the cadvisor systemd service to start on boot
  ansible.builtin.systemd:
    name: cadvisor
    state: enabled
    daemon_reload: yes

- name: Start the cadvisor systemd service immediately
  ansible.builtin.systemd:
    name: cadvisor
    state: started
    daemon_reload: yes


