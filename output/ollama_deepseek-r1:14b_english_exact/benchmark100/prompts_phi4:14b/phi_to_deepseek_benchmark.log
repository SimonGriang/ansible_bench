:\n    - "bootstrap_facts is not None"\n    - "bootstrap_distribution is not defined"\n    - "lookup(\'ansible.utils.together\', [\'os_release\']) | json_query(\'PRETTY_NAME\') is not None"\n\n- name: Set bootstrap operating system family based on the distribution\n  set_fact:\n    bootstrap_os_family: "{{ item.value }}"\n  when:\n    - "bootstrap_distribution is not None"\n    - "{{ lookup(\'ansible.utils.together\', [\'os_release\']) | json_query(\'PRETTY_NAME\') }} is not None"\n    - "{{ item.key }}" in bootstrap_distribution\n  loop: "{{ bootstrap_os_family_map | dict2list }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-14T09:29:47.438295274Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11758707381, 'load_duration': 85441576, 'prompt_eval_count': 501, 'prompt_eval_duration': 152502177, 'eval_count': 561, 'eval_duration': 11519372838, 'model_name': 'deepseek-r1:14b'} id='run--0d60412f-b148-443a-a452-f06d689ae2d2-0' usage_metadata={'input_tokens': 501, 'output_tokens': 561, 'total_tokens': 1062}
