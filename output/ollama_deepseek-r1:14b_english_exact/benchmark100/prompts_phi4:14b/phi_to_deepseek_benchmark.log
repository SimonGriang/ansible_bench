---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    mode: 0755

- name: Set server-specific node taints
  set_fact:
    server_node_taints: "{{ rke2_server_node_taints | default('') }}"
  when: rke2_type == 'server'

- name: Template the RKE2 configuration file
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    mode: 0600
  notify: Config file changed

- name: Template the kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    mode: 0600
  when: rke2_kubelet_config is not empty
  notify: Config file changed

- name: Configure Containerd registry settings
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    mode: 0600
  when:
    - rke2_custom_registry_mirrors is not empty
    - rke2_custom_registry_configs is not empty
  notify: Config file changed

- name: Determine if an etcd restore from a file is necessary
  set_fact:
    do_etcd_restore: "{{ (rke2_etcd_snapshot_file is not empty) and (not rke2_server_service_running or rke2_server_service_disabled) }}"

- name: Determine if an etcd restore from S3 is necessary
  set_fact:
    do_etcd_restore_from_s3: "{{ (rke2_etcd_snapshot_file is not empty) and (rke2_s3_creds is not empty) and (rke2_s3_bucket is not empty) }}"

- name: Restore etcd from a snapshot file
  shell: >
    mkdir -p /var/lib/rke2/etcd/snapshots && 
    cp "{{ rke2_etcd_snapshot_file }}" /var/lib/rke2/etcd/snapshots/ && 
    rke2 server --config /etc/rancher/rke2/config.yaml --etcd-restore=true --etcd-restore-file=/var/lib/rke2/etcd/snapshots/$(basename "{{ rke2_etcd_snapshot_file }}")
  when: do_etcd_restore | bool
  register: etcd_restore_result
  changed_when: etcd_restore_result.rc != 0

- name: Restore etcd from an S3 snapshot
  shell: >
    rke2 server --config /etc/rancher/rke2/config.yaml --etcd-restore=true --etcd-restore-s3-bucket="{{ rke2_s3_bucket }}" --etcd-restore-s3-prefix="{{ rke2_etcd_snapshot_path | default('') }}" --etcd-restore-s3-creds="{{ rke2_s3_creds | default('') }}"
  when: do_etcd_restore_from_s3 | bool
  register: etcd_s3_restore_result
  changed_when: etcd_s3_restore_result.rc != 0

- name: Start the RKE2 server service
  service:
    name: rke2-server
    state: started
    enabled: yes
    environment:
      - name: RKE2_TOKEN
        value: "{{ rke2_token | default('') }}"
  notify: Service (re)started

- name: Mask the RKE2 agent service
  service:
    name: rke2-agent
    state: stopped
    enabled: no
    mask: yes

- name: Wait for the first server to be ready without CNI
  wait_for_task:
    task_id: kubectl_get_nodes_jsonpath
    retries: 100
    delay: 15
    until: >
      "{{ hostvars[groups['rke2_cluster_group_name'][0]].ansible_facts.ansible_kubectl.status[0].conditions | json_query('contains(.[].status, "Ready")') | not }}"

  when: rke2_cni == 'none'

- name: Wait for the first server to be ready with CNI
  wait_for_task:
    task_id: kubectl_get_nodes_jsonpath
    retries: 40
    delay: 15
    until: >
      "{{ hostvars[groups['rke2_cluster_group_name'][0]].ansible_facts.ansible_kubectl.status[0].conditions | json_query('contains(.[].status, "Ready")') | not }}"

  when: rke2_cni is not 'none'

- name: Clean up old nodes and secrets if restoring etcd
  shell: >
    kubectl get nodes -o json | jq -r '.items[].metadata.name' | tr '\n' ' ' | xargs -I {} kubectl delete node {} --now &&
    kubectl get secrets | grep -E '^etcd-[a-z0-9]+-' | tr '\n' ' ' | xargs -I {} kubectl delete secret {}
  when: do_etcd_restore or do_etcd_restore_from_s3

- name: Set the active server variable
  set_fact:
    active_server: "{{ ansible_hostname }}"
  delegate_to: "{{ groups['rke2_cluster_group_name'] | list }}"
  run_once: yes


