    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method tasks
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Add Vault environment variables
  lineinfile:
    path: /etc/vault.d/vault.env
    mode: 0644
    content: "{{ item.key }}={{ item.value }}"
    create: true
  with_items: "{{ vault_environment_vars }}"
  notify: restart_vault_service

- import_tasks: hardening.yml

- name: Start and enable Vault service (OSS)
  service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"

- name: Enable Vault service (non-OSS)
  service:
    name: vault
    enabled: true
  when: vault_type != "oss"

