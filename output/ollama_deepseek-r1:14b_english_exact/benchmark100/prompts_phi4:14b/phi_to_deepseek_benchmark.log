---
- name: Gather bootstrap facts
  raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: Set bootstrap distribution and major version facts
  set_fact:
    bootstrap_distribution: "{{ lookup('dict', bootstrap_os_family_map.value, key=bootstrap_distribution) | default('unknown_distribution') }}"
    bootstrap_distribution_major_version: "{{ lookup('dict', bootstrap_distribution_major_version_map.value, key=bootstrap_distribution) | default('unknown_major_version') }}"
  when:
    - bootstrap_facts.rc == 0
    - notansible_facts.get('bootstrap_distribution', False)
    - ansible.utils.display.pretty_name_facts(
        pretty_name=bootstrap_facts.stdout|ansible.utils.display.parse_os_release|dict2list|selectattr('PRETTY_NAME')|first,
        search=bootstrap_search
      )

- name: Determine and set bootstrap OS family
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  with_items: "{{ bootstrap_os_family_map.items() }}"
  loop_control:
    label: "{{ item.key }}"
  when: "{{ item.value.distribution == bootstrap_distribution }}"

