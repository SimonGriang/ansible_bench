---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install vsftpd package
  package:
    name: vsftpd
    state: present

- name: Configure vsftpd using template
  template:
    src: vsftpd.conf.j2
    dest: "{{ vsftpd_configuration_file }}"
    owner: root
    group: root
  notify: Restart vsftpd

- name: Set permissions on vsftpd configuration file
  file:
    path: "{{ vsftpd_configuration_file }}"
    owner: root
    group: root
    mode: "{{ vsftpd_configuration_file_mode }}"

- name: Ensure vsftpd service is started and enabled
  service:
    name: vsftpd
    state: started
    enabled: true

