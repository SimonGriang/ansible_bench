ver.sh\n    owner: root\n    group: root\n    mode: 755\n  when: ansible_os_family == "Debian"\n  notify: restart_keepalived\n\n- name: Create RKE2 Server health check script for RedHat systems\n  become: yes\n  template:\n    src: check_rke2server.sh.j2\n    dest: /usr/libexec/keepalived/check_rke2server.sh\n    owner: root\n    group: root\n    mode: 755\n  when: ansible_os_family == "RedHat"\n  notify: restart_keepalived\n\n- name: Create the keepalived configuration file\n  become: yes\n  template:\n    src: keepalived.conf.j2\n    dest: /etc/keepalived/keepalived.conf\n    owner: root\n    group: root\n    mode: 644\n  notify: restart_keepalived\n\n- name: Enable keepalived service and ensure it is not masked\n  become: yes\n  service:\n    name: keepalived\n    state: started\n    enabled: yes\n    mask: no\n  notify: restart_keepalived\n\n- name: Flush handlers to apply changes\n  meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-14T12:23:01.484293335Z', 'done': True, 'done_reason': 'stop', 'total_duration': 20079571842, 'load_duration': 2249658646, 'prompt_eval_count': 809, 'prompt_eval_duration': 490388312, 'eval_count': 1227, 'eval_duration': 17338906338, 'model_name': 'deepseek-r1:14b'} id='run--8c9a13aa-f97e-457a-bc9c-dfe0cad9fc9f-0' usage_metadata={'input_tokens': 809, 'output_tokens': 1227, 'total_tokens': 2036}
