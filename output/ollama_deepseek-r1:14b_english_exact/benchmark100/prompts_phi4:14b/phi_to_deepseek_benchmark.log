---
- name: Ensure the directory /etc/openvpn/easy-rsa exists with appropriate permissions
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Initialize the PKI directory using EasyRSA
  command: /etc/openvpn/easy-rsa/init-pki
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build a CA certificate using EasyRSA without a passphrase
  command: /etc/openvpn/easy-rsa/build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  register: ca_certificate

- name: Generate a Diffie-Hellman parameters file using EasyRSA
  command: /etc/openvpn/easy-rsa/gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  register: dh_parameters

- name: Build a server certificate using EasyRSA without a passphrase
  command: /etc/openvpn/easy-rsa/build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  register: server_certificate

- name: Build a client certificate using EasyRSA without a passphrase
  command: /etc/openvpn/easy-rsa/build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  register: client_certificate

- name: Generate a Certificate Revocation List using EasyRSA
  command: /etc/openvpn/easy-rsa/gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  register: crl_file

- name: Generate a TLS auth key using OpenVPN
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Copy necessary EasyRSA files to /etc/openvpn/server
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn/server
    remote_src: yes
    owner: root
    group: root
    mode: 0644
  with_items:
    - ca_certificate.files
    - dh_parameters.files
    - crl_file.files
    - server_certificate.files

- name: Copy necessary EasyRSA files to /etc/openvpn
  copy:
    src: "{{ item }}"
    dest: /etc/openvpn
    remote_src: yes
    owner: root
    group: root
    mode: 0644
  with_items:
    - ca_certificate.files
    - dh_parameters.files
    - crl_file.files

- name: Deploy the OpenVPN server configuration file
  template:
    src: openvpn_server.conf.j2
    dest: /etc/openvpn/server/openvpn_server.conf
    owner: root
    group: root
    mode: 0644
  notify: restart_openvpn


