---
- name: Create a system group for Vault
  group:
    name: "{{ vault_group }}"
    state: present
    system: true

- name: Create a system user for Vault
  user:
    name: "{{ vault_user }}"
    group: "{{ vault_group }}"
    shell: "{{ vault_user_shell }}"
    state: true

- name: Create a download directory for Vault
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Download the Vault binary
  get_url:
    url: "{{ hashicorp_vault_downloader_url }}"
    dest: "{{ vault_download_path }}/vault_{{ vault_version }}.tar.gz"
    mode: 0644
    owner: root
    group: root

- name: Unarchive Vault binary
  unarchive:
    src: "{{ vault_download_path }}/vault_{{ vault_version }}.tar.gz"
    dest: "{{ vault_path }}/usr/bin"
    remote_src: true
    owner: root
    group: root
    mode: 0755

- name: Check if the main Vault directory exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create the main Vault directory if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Create additional directories in the main Vault directory
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_directories }}"

- name: Create data directories for Vault
  file:
    path: "{{ vault_path }}/data/{{ item }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_data_directories }}"

- name: Generate a TLS key and certificate for Vault
  openssl_cert:
    commonname: "{{ vault_host }}"
    privatekey_bits: 2048
    privatekey_type: RSA
    passphrase: "{{ vault_tls_passphrase }}"
    generate_csr: true
    csr_subject:
      country_name: US
      state_or_province_name: "New York"
      locality_name: "New York City"
      organization_name: "HashiCorp"
      organizational_unit_name: "Vault"
      common_name: "{{ vault_host }}"
      email_address: "{{ vault_tls_email }}"
    cert_validity: 365
    dest_cert: "{{ vault_data_directory }}/tls/vault.pem"
    dest_key: "{{ vault_data_directory }}/tls/vault.key"
    dest_csr: "{{ vault_data_directory }}/tls/vault.csr"
  notify: restart_vault

- name: Set ownership of TLS files
  file:
    path: "{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0640
  loop: "{{ vault_tls_files }}"

- name: Copy the Vault binary to the appropriate location
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    remote_src: true
    mode: 0755
    owner: root
    group: root
  notify: restart_vault

- name: Set specific capabilities on the Vault binary
  setcap:
    path: "{{ vault_path }}/usr/bin/vault"
    cap: "cap_ipc_lock=ep"
    mode: "eip"
    state: present

- name: Create a vault environment file
  copy:
    src: "files/vault.env"
    dest: "{{ vault_path }}/etc/vault.d/vault.env"
    mode: 0640
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    preserve_mode: true
    preserve_times: true
  notify: restart_vault

- name: Ensure the systemd system directory exists
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Copy the Vault service file for systemd
  copy:
    src: "templates/vault.service.j2"
    dest: /usr/lib/systemd/system/vault.service
    mode: 0644
    owner: root
    group: root
  notify: reload_systemd

- name: Copy the Vault configuration file
  copy:
    src: "templates/vault.hcl.j2"
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: 0640
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: restart_vault

- name: Flush handlers to apply changes
  meta:
    flush_handlers: true

