>\n\n```yaml\n---\n- name: Import additional tasks from assert.yml\n  import_tasks: assert.yml\n  delegate_to: localhost\n  run_once: true\n\n- name: Wait for specified port to be available\n  wait_for:\n    port: "{{ bootstrap_port | default(22) }}"\n    state: started\n    timeout: "{{ bootstrap_timeout }}"\n  when:\n    - not containerized\n    - bootstrap_wait_for_host\n\n- name: Prepare system by testing connection and verifying sudo access\n  block:\n    - name: Test connection\n      wait_for_connection:\n        state: started\n        timeout: 30\n    - name: Verify sudo access\n      command: whoami\n      args:\n        warn: false\n  rescue:\n    - name: Gather bootstrap facts\n      setup:\n        gather_subset: all\n    - name: Install bootstrap packages\n      raw: apt-get update && apt-get install -y {{ bootstrap_facts_packages | join(\' \') }}\n      when: bootstrap_facts_packages | length > 0\n\n- name: Gather Ansible facts about the system\n  setup:\n    gather_subset: all\n  become: false\n\n- name: Install necessary packages based on gathered facts\n  package:\n    name: "{{ bootstrap_facts_packages }}"\n    state: present\n    update_cache: yes\n  become: "{{ bootstrap_become }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-14T10:13:38.102258633Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14328938693, 'load_duration': 92625015, 'prompt_eval_count': 565, 'prompt_eval_duration': 322385414, 'eval_count': 705, 'eval_duration': 13912787750, 'model_name': 'deepseek-r1:14b'} id='run--30f78b79-838e-40da-8807-42feeeff7e64-0' usage_metadata={'input_tokens': 565, 'output_tokens': 705, 'total_tokens': 1270}
