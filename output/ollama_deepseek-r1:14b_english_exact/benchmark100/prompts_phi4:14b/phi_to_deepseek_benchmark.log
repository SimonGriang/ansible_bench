---
- name: Import assertion task file
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Uninstall systemd-logger
  apt:
    name: systemd-logger
    state: absent

- name: Install rsyslog package
  apt:
    name: "{{ item }}"
    state: "{{ rsyslog_package_state }}"
  loop: "{{ rsyslog_packages }}"

- name: Install additional rsyslog features
  apt:
    name: "{{ item }}"
    state: "{{ rsyslog_package_state }}"
  loop: "{{ rsyslog_features }}"

- name: Configure default rsyslog settings
  template:
    src: "{{ rsyslog_config_file_format }}.j2"
    dest: "{{ rsyslog_dest_conf_file }}"
  when: rsyslog_deploy_default_config
  notify: rsyslog_restart

- name: Ensure rsyslog configuration directory exists
  file:
    path: /etc/rsyslog.d/
    state: directory
    mode: 0755

- name: Configure rsyslog to forward logs
  template:
    src: forward_rule.conf.j2
    dest: /etc/rsyslog.d/"{{ rsyslog_forward_rule_name }}"
  when: not rsyslog_deploy_default_config
  notify: rsyslog_restart

- name: Configure additional rsyslog configuration files
  template:
    src: "{{ item.src }}.j2"
    dest: /etc/rsyslog.d/"{{ item.dest }}"
    mode: 0644
  loop: "{{ rsyslog_rsyslog_d_files }}"
  when: item.state
  notify: rsyslog_restart

- name: Start and enable rsyslog service
  service:
    name: "{{ rsyslog_service }}"
    state: started
    enabled: yes


