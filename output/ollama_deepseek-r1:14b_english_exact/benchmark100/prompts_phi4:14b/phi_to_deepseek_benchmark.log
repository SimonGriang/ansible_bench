---
- name: Import assert.yml only once and delegate to localhost
  import_tasks: assert.yml
  delegate_to: localhost
  changed_together: true

- name: Install Python pip using the specified package name
  apt:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings if the proxy is defined
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    owner: root
    group: root
    mode: 0644
  when:
    - ansible_var_exists('python_pip_proxy')

- name: Set trusted hosts for pip if specified
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    owner: root
    group: root
    mode: 0644
  when:
    - ansible_var_exists('python_pip_trusted_host')

- name: Update pip to the latest version under specific conditions
  pip:
    name: "{{ python_pip_pip_package | default('pip') }}"
    state: latest
  when:
    - python_pip_update
    - ansible_distribution_release not in ["bookworm", "noble"]
    - ansible_os_family != "Alpine"

- name: Install requested Python pip modules based on conditions
  pip:
    requirements: "{{ item }}"
    state: present
  with_items: "{{ python_pip_modules }}"
  when:
    - ansible_distribution_release not in ["bookworm", "noble"]
    - ansible_os_family != "Alpine"



