---
- name: Import assertions for playbook validation
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  register: assertions
  run_once: true

- name: Install logrotate package
  ansible.builtin.apt:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate with template
  ansible.builtin.template:
    src: "{{ logrotate_config_file }}"
    dest: "{{ logrotate_config_directory }}/logrotate.conf"
    mode: "{{ logrotate_config_mode }}"

- name: Generate logrotate.d configuration files
  loop: "{{ logrotate_entries }}"
  ansible.builtin.template:
    src: "entry.j2"
    dest: "{{ logrotate_confd_directory }}/{{ item.name }}"
    mode: "{{ logrotate_confd_mode }}"
  when: item.state != 'absent'

- name: Remove logrotate.d configuration files for absent entries
  loop: "{{ logrotate_entries }}"
  ansible.builtin.file:
    path: "{{ logrotate_confd_directory }}/{{ item.name }}"
    state: absent
  when: item.state == 'absent'

- name: Start and enable logrotate service
  ansible.builtin.service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service is defined


