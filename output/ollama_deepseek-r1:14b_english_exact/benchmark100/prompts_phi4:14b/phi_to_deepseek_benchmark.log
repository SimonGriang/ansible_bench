  ansible.builtin.template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ '/etc/apache2/ports.conf' if ansible_os_family == 'Debian' else '/etc/apache/ports.conf' }}"
    mode: "0644"
  notify:
    - httpd_config_test
