---
- name: Task 1: Import the assert.yml task file to be executed once on localhost
  include_tasks: assert.yml
  run_once: true
  changed_when: false

- name: Task 2: Install required packages for OpenSSL
  apt:
    name: "{{ openssl_requirements }}"
    state: present
    update_cache: yes

- name: Task 3: Install pip packages if the list is not empty
  pip:
    name: "{{ item }}"
    state: present
  when: "openssl_pip_packages is defined and (openssl_pip_packages | length) > 0"
  loop: "{{ openssl_pip_packages }}"

- name: Task 4: Create directory for OpenSSL keys
  file:
    path: "{{ openssl_keys_dir }}"
    state: directory
    mode: 700
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Task 5: Create directory for OpenSSL CSRs
  file:
    path: "{{ openssl_csr_dir }}"
    state: directory
    mode: 755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Task 6: Create directory for OpenSSL certificates
  file:
    path: "{{ openssl_certs_dir }}"
    state: directory
    mode: 755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Task 7: Include the create.yml task file for each item in openssl_items
  include_tasks: create.yml
  when: "openssl_items is defined and (openssl_items | length) > 0"
  loop: "{{ openssl_items }}"
  changed_when: false



