---
- name: Remove obsolete Docker packages
  apt:
    name:
      - "{{ item }}"
    state: absent
  with_items: "{{ docker_obsolete_packages }}"

- name: Add Docker GPG key
  apt_key:
    key: "{{ docker_yum_gpg_key }}"
    state: present
  when: docker_add_repo

- name: Add Docker repository
  apt_repository:
    repo: "deb {{ docker_yum_repo_url }}/docker-{{ docker_edition }}.deb stable"
    filename: /etc/apt/sources.list.d/docker-{{ docker_edition }}.list
    state: present
  when: docker_add_repo

- name: Configure Docker Nightly repo
  lineinfile:
    path: /etc/apt/sources.list.d/docker-{{ docker_edition }}.list
    line: "deb {{ docker_yum_repo_url }}/docker-{{ docker_edition }}.deb nightly"
    state: present
  when:
    - docker_add_repo
    - docker_yum_repo_enable_nightly

- name: Configure Docker Test repo
  lineinfile:
    path: /etc/apt/sources.list.d/docker-{{ docker_edition }}.list
    line: "deb {{ docker_yum_repo_url }}/docker-{{ docker_edition }}.deb test"
    state: present
  when:
    - docker_add_repo
    - docker_yum_repo_enable_test

- name: Configure containerd on RHEL 8
  yum:
    name:
      - runc
      - container-selinux
      - containerd.io
    state:
      runc: absent
      container-selinux: present
      containerd.io: present
  become: yes
  when: docker_add_repo | bool


