---
- name: Cordon and Drain the node during RKE2 upgrade
  ansible.builtin.shell:
    cmd: kubectl cordon --node-name="{{ rke2_node_name }}"
    chdir: /home
    register: drain
    until: drain.results | json_query('results[].stderr') | join | contains 'node cordoned'
    retries: 100
    delay: 15
    delegate_to: "{{ inventory_hostname }}"

- name: Restart the RKE2 service on the node
  ansible.builtin.service:
    name: "{{ rke2_service_name }}"
    state: restarted
    become: true
    register: service_restart
    notify: Service (restarted)

- name: Wait for all nodes to be ready again
  ansible.builtin.shell:
    cmd: kubectl get nodes -l rke.cattle.io/cluster-group={{ rke2_cluster_group_name }} -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}'
    chdir: /home
    until: "{{ansible_check_output.stdout | json_query('results[].stdout') | join | contains 'Ready' | count}}" == "{{ rke2_cluster_group_size }}"
    retries: 100
    delay: 15
    delegate_to: "{{ inventory_hostname }}"

- name: Uncordon the node after the upgrade
  ansible.builtin.shell:
    cmd: kubectl uncordon --node-name="{{ rke2_node_name }}"
    chdir: /home
    until: kubectl get nodes "{{ rke2_node_name }}" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' | contains 'Ready'
    retries: 100
    delay: 15
    delegate_to: "{{ inventory_hostname }}"
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  ansible.builtin.shell:
    cmd: kubectl get pods -n all -o jsonpath='{.items[*].status.phase}' | grep -c 'Running|Succeeded'
    chdir: /home
    until: ansible_check_output.stdout | int | equalto 0
    retries: 100
    delay: 15
    delegate_to: "{{ inventory_hostname }}"
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  ansible.builtin.shell:
    cmd: kubectl wait pods --all-namespaces --all-pods --for=condition=Ready --timeout=60s
    chdir: /home
    args: "{{ rke2_wait_for_all_pods_to_be_healthy_args | join(' ')}"
    until: kubectl get pods --all-namespaces -o json | jq -r '.items[].status.conditions[] | select(.type == "Ready") | .status' | tr -d '"' | sort | uniq | wc -l | xargs
    retries: 100
    delay: 15
    delegate_to: "{{ inventory_hostname }}"
  when: rke2_wait_for_all_pods_to_be_healthy


