ted_at': '2025-10-14T10:20:53.114805418Z', 'done': True, 'done_reason': 'stop', 'total_duration': 20106325178, 'load_duration': 103236152, 'prompt_eval_count': 1547, 'prompt_eval_duration': 21094628, 'eval_count': 997, 'eval_duration': 19979735543, 'model_name': 'deepseek-r1:14b'} id='run--3addb827-2f93-456e-9c8e-98c9956ab433-0' usage_metadata={'input_tokens': 1547, 'output_tokens': 997, 'total_tokens': 2544} 34%|███▍      | 34/100 [1:31:26<2:12:35, 120.53s/it]
