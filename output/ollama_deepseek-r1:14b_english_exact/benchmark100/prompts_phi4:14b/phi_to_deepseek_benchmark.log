---
- name: Ensure the system is using systemd as the init system
  ansible.builtin.assert:
    that:
      ansible_service_mgr == 'systemd'
    msg: "This playbook only works with systemd as the init system."

- name: Retrieve the latest release information for Grafana Loki
  ansible.builtin.uri:
    url: https://api.github.com/repos/grafana/loki/releases
    method: GET
    headers:
      Accept: application/vnd.github.v3+json
    retries: 5
    delay: 1
    until: 20
    validate_certs: yes
    status_code: 200
    force_html: false
    register: latest_release
  changed_when: false

- name: Verify the existence of a local promtail binary archive
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/loki-promtail-{{ promtail_version }}.tar.gz"
    register: local_binary_exists
  when: promtail_binary_local_dir
  changed_when: false

- name: Download and verify the checksum for the promtail binary
  ansible.builtin.url:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/checksums.txt"
    force: true
    register: checksum_file
    remote_src: true
    validate_certs: yes
  when: not promtail_binary_local_dir


