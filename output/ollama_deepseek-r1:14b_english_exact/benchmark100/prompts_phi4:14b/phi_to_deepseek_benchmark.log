---
- name: Ensure the unzip package is installed
  apt:
    name: unzip
    state: present
    update_cache: "{{ promtail_apt_update_cache | default('yes') }}"

- name: Create a group for Promtail
  group:
    name: "{{ promtail_system_group | default('promtail') }}"
    state: present
  when: promtail_system_group != "root"

- name: Create a user for Promtail
  user:
    name: "{{ promtail_system_user | default('promtail') }}"
    group: "{{ promtail_system_group | default('promtail') }}"
    additional_groups: "{{ promtail_user_additional_groups | default([]) }}"
    shell: /usr/sbin/nologin
    create_home: "{{ promtail_system_user == 'root' | default('yes') }}"
    state: present

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: 0755

- name: Create necessary configuration directories for Promtail
  file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: "{{ promtail_system_group | default('promtail') }}"
    mode: 0770
  with_items:
    - /etc/promtail
    - /etc/promtail/file_sd
    - /etc/promtail/positions

- name: Create application directories for Promtail
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ promtail_system_user | default('promtail') }}"
    group: "{{ promtail_system_group | default('promtail') }}"
    mode: 0755
  with_items:
    - /var/lib/promtail
    - /var/log/promtail

- name: Check if the Promtail binary exists
  stat:
    path: "/usr/local/bin/{{ promtail_binary_name | default('promtail') }}"
    register: promtail_binary

- name: Download Promtail binaries if not present locally
  get_url:
    url: https://github.com/prometheus/promtail/releases/download/v1.0.0/promtail-linux-amd64
    dest: /tmp/promtail-{{ ansible_date_time | date('epoch') }}
    checksum:
      sha256: "{{ promtail_custom_checksum | default('d4d3776611a7467f89d35890d8f30d0810c3e0d8f3d0c0d0e0f0e0d0c0') }}"

- name: Propagate a locally distributed Promtail archive
  copy:
    src: "{{ promtail_local_archive | default('') }}"
    dest: /tmp/promtail-{{ ansible_date_time | date('epoch') }}
  when: promtail_local_archive is not empty

- name: Download Promtail binaries to the controller node
  get_url:
    url: https://github.com/prometheus/promtail/releases/download/v1.0.0/promtail-linux-amd64
    dest: /tmp/promtail-{{ ansible_date_time | date('epoch') }}
    checksum:
      sha256: "{{ promtail_custom_checksum | default('d4d3776611a7467f89d35890d8f30d0810c3e0d8f3d0c0d0e0f0e0d0c0') }}"
  when: ansible_hostname == "{{ promtail_controller_node }}"

- name: Propagate Promtail binaries across nodes
  copy:
    src: /tmp/promtail-{{ ansible_date_time | date('epoch') }}
    dest: /tmp/promtail-{{ ansible_date_time | date('epoch') }}
  when: promtail_binary_propagate == true

- name: Unpack the Promtail binaries
  unzip:
    remote_src: yes
    dest: /usr/local/bin/
    file: /tmp/promtail-{{ ansible_date_time | date('epoch') }}.zip

- name: Create a symlink to the latest version of Promtail
  file:
    path: /usr/local/bin/promtail
    state: symlink
    target: /usr/local/bin/{{ promtail_binary_name | default('promtail') }}

- name: Write the Promtail configuration file
  template:
    src: promtail-config.yml.j2
    dest: /etc/promtail/promtail.yml
    owner: root
    group: "{{ promtail_system_group | default('promtail') }}"
    mode: 0640
  notify: restart_promtail

- name: Create a systemd service unit for Promtail
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: 0644
  notify: restart_promtail


