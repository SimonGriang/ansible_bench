---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  become: false
  tags:
    - assertion

- name: Install docker-compose package
  apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
  with_items: "{{ docker_compose_required_packages }}"
  when: docker_compose_installation_type == "package"
  register: docker_compose_package
  tags:
    - docker_compose

- name: Install docker-compose as a binary
  apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
  with_items: "{{ docker_compose_binary_required_packages }}"
  when: docker_compose_installation_type == "binary"
  register: docker_compose_binary_packages
  tags:
    - docker_compose

- name: Download and install docker-compose binary
  shell: |
    curl -L "{{ docker_compose_url }}" -o /usr/local/bin/docker-compose
    && chmod +x /usr/local/bin/docker-compose
  when: docker_compose_installation_type == "binary"
  register: docker_compose_binary
  tags:
    - docker_compose

- name: Report installation status
  callback.molecule.v2.stat:
    name: "{{ item }}"
    data: "{{ item_result }}"
  with_items: "{{ groups }}"
  when: docker_compose_installation_type == "package"
  tags:
    - docker_compose

