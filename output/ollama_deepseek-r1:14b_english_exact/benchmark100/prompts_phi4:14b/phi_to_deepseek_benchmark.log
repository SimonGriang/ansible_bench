- import_tasks: assert.yml
  loop: once
  hosts: localhost

- name: Install cron
  become: yes
  apt:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  become: yes
  cron:
    name: SHELL
    value: "{{ cron_shell }}"
  notify: restart_cron

- name: Configure path
  become: yes
  cron:
    name: PATH
    value: "{{ cron_path }}"
  notify: restart_cron

- name: Configure mailto
  become: yes
  cron:
    name: MAILTO
    value: "{{ cron_mailto }}"
  notify: restart_cron

- name: Start and enable cron
  become: yes
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ""

- name: Schedule requested cron jobs
  become: yes
  cron:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
  loop: "{{ cron_jobs if cron_jobs is defined else [] }}"
  when: cron_jobs is defined


