tory_group }}"\n    mode: 0755\n  when:\n    - git_repository_destination is defined\n    - git_username in ansible_user_ids\n\n- name: Clone all specified repositories\n  become: yes\n  git:\n    repo: "{{ item.repository }}"\n    dest: "{{ git_repository_destination }}"\n    branch: "{{ item.branch | default(\'main\') }}"\n    update: yes\n    force_checkout: yes\n    become_user: "{{ git_username }}"\n    become_group: "{{ git_user_group }}"\n    accept_hostkey: yes\n  loop: "{{ git_repositories }}"\n  when:\n    - git_repositories is defined\n    - git_repository_destination is defined\n    - git_username in ansible_user_ids\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-14T11:35:34.791627335Z', 'done': True, 'done_reason': 'stop', 'total_duration': 24355973059, 'load_duration': 98597140, 'prompt_eval_count': 1295, 'prompt_eval_duration': 569966526, 'eval_count': 1071, 'eval_duration': 23685900904, 'model_name': 'deepseek-r1:14b'} id='run--1742fbc5-240b-49bf-a8b7-97f03a17866c-0' usage_metadata={'input_tokens': 1295, 'output_tokens': 1071, 'total_tokens': 2366}
