---
- name: Create the RKE2 configuration directory with appropriate permissions
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Set server node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_node_type == 'server'

- name: Set agent node taints for RKE2 configuration
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_node_type == 'agent'

- name: Deploy the RKE2 configuration file
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed

- name: Deploy the kubelet configuration file
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed
  when: rke2_kubelet_config is not empty

- name: Deploy the Containerd registry configuration file
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed
  when:
    - rke2_custom_registry_mirrors is not empty
    - rke2_custom_registry_config is not empty

- name: Start the RKE2 service on all nodes
  service:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: yes
    try_count: 10
    try_interval: 3
  notify: Service (re)started

- name: Mask other RKE2 services on non-applicable nodes
  shell: |
    systemctl mask --permanent {{ item }}
    systemctl disable {{ item }}
  loop:
    - rke2-agent.service
    - rke2-server.service
  when: rke2_node_type not in ['agent', 'server']

- name: Verify node readiness without CNI
  shell: |
    kubectl get nodes --no-headers | grep -E 'Ready|NotReady' | awk '{print $2}' | xargs -I {} sh -c '
      node="{}", status=$(kubectl get node/"{node}" 2>/dev/null | grep -Eo 'Ready|NotReady' || echo NotReady);
      echo -n $status;
      echo -n "|";
      echo -n $node;
      echo -n "|";
      free -m | grep Mem | awk '{print $2}' | xargs -I mem sh -c '
        echo -n mem: ';
      df -h | grep /dev/nvme* | awk '{print $2}' | xargs -I disk sh -c '
        echo -n disk: ';
      echo -n PID;
      echo -n "|";
      ps -ef | grep -c 'containerd.*start' | xargs -I cnt echo -n $cnt | grep -q 'containerd.*network';
      echo'
  args:
    chdir: /etc/rancher/rke2
  register: node_check_without_cni
  until: node_check_without_cni.stdout_lines | listresults | json_query '[].status' | count("Ready") > 0
  retries: 100
  delay: 15
  when:
    - rke2_node_type == 'server'
    - rke2_role == 'server' and rke2_nodes | length == 1

- name: Verify node readiness with CNI
  shell: |
    kubectl get nodes --no-headers | grep -E 'Ready|NotReady' | awk '{print $2}' | xargs -I {} sh -c '
      node="{}", status=$(kubectl get node/"{node}" 2>/dev/null | grep -Eo 'Ready|NotReady' || echo NotReady);
      echo -n $status;
      echo -n "|";
      echo -n $node;
      echo -n "|";
      free -m | grep Mem | awk '{print $2}' | xargs -I mem sh -c '
        echo -n mem: ';
      df -h | grep /dev/nvme* | awk '{print $2}' | xargs -I disk sh -c '
        echo -n disk: ';
      echo -n PID;
      echo -n "|";
      ps -ef | grep -c 'containerd.*start' | xargs -I cnt echo -n $cnt | grep -q 'containerd.*network';
      echo'
  args:
    chdir: /etc/rancher/rke2
  register: node_check_with_cni
  until: node_check_with_cni.stdout_lines | listresults | json_query '[].status' | count == expected_nodes
  retries: 100
  delay: 15
  when:
    - rke2_node_type == 'server'
    - rke2_role == 'server' and rke2_nodes | length == 1
  no_log_sensitive: true
