---
- name: Download RKE2 installation script if not in airgap mode
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0755'
    timeout: 30
    remote_src: no
  when: not rke2_airgap_mode
  register: rke2_install_script_download

- name: Copy local RKE2 installation script if in airgap mode using the 'copy' method
  copy:
    src: "{{ rke2_install_script_path }}"
    dest: "{{ rke2_install_script_path }}"
    force: yes
    mode: '0755'
  when: rke2_airgap_mode and
        rke2_airgap_implementation == 'copy'

- name: Create RKE2 artifacts folder if in airgap mode and implementation is not 'exists'
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0755'
  when: rke2_airgap_mode and
        rke2_airgap_implementation != 'exists'

- name: Download RKE2 checksum and artifacts with fallback mechanism for airgap mode using the 'download' method
  block:
    - name: Try to download RKE2 checksum and artifacts
      get_url:
        url: "{{ item.url }}"
        dest: "{{ item.dest }}"
        mode: '0755'
        timeout: 30
        remote_src: no
      with_items: "{{ rke2_artifacts_to_download }}"
      register: rke2_artifacts_download
      ignore_errors: yes

    - name: Download and copy artifacts locally if remote download fails
      file:
        src: "{{ item.src }}"
        dest: "{{ item.dest }}"
        force: yes
        mode: '0755'
      with_items: "{{ rke2_artifacts_to_download }}"
      when: rke2_artifacts_download|failed
  when: rke2_airgap_mode and
        rke2_airgap_implementation == 'download'

- name: Copy local RKE2 artifacts if in airgap mode using the 'copy' method
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    force: yes
    mode: '0755'
  with_items: "{{ rke2_artifacts_to_copy }}"
  when: rke2_airgap_mode and
        rke2_airgap_implementation == 'copy'

- name: Handle additional tarballs in airgap mode if not using 'exists' implementation
  block:
    - name: Create directory for additional tarballs
      file:
        path: "{{ rke2_additional_tarballs_path }}"
        state: directory
        mode: '0755'
      when: rke2_airgap_copy_additional_tarballs is not empty and
            rke2_airgap_implementation != 'exists'

    - name: Copy additional tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_additional_tarballs_path }}"
        force: yes
        mode: '0755'
      with_items: "{{ rke2_additional_tarballs_list }}"
      when: rke2_airgap_copy_additional_tarballs is not empty and
            rke2_airgap_implementation != 'exists'
  when: rke2_airgap_mode

- name: Ensure artifacts exist and have acceptable permissions in airgap mode with 'exists' implementation
  block:
    - name: Ensure artifact directory permissions
      file:
        path: "{{ rke2_artifacts_path }}"
        state: directory
        mode: '0755'
      when: rke2_airgap_implementation == 'exists'

    - name: Ensure installation script is executable
      file:
        path: "{{ rke2_install_script_path }}"
        state: file
        mode: '0755'
      when: rke2_airgap_implementation == 'exists'
  when: rke2_airgap_mode and
        rke2_airgap_implementation == 'exists'

- name: Populate service facts
  shell: systemctl list-unit-files | grep -E '^(run|socket|service)'
  register: rke2_service_facts
  changed_when: false
  ignore_errors: yes

- name: Get filesystem statistics for /usr/local
  shell: df -h /usr/local
  register: rke2_filesystem_stats
  changed_when: false

- name: Check if /usr/local is on a separate partition
  shell: grep /usr/local /proc/mounts
  register: rke2_local_mount
  changed_when: false

- name: Determine RKE2 binary path
  set_fact:
    rke2_binary_path: "{{ rke2_binary_path }}/rke2"
  when: rke2_local_mount is not found or
        rke2_filesystem_stats.stdout is not empty

- name: Check installed and running RKE2 versions
  shell: |
    if [ -x "{{ rke2_binary_path }}" ]; then
      {{ rke2_binary_path }} version
    else
      echo "command not found"
    fi
  register: rke2_version_check
  changed_when: false

- name: Set RKE2 version facts
  set_fact:
    rke2InstalledVersion: "{{ rke2_version_check.stdout | regex_replace('.*v=([0-9.]+).*','\\1') }}"
    rke2RunningVersion: "{{ rke2_version_check.stdout | regex_replace('.*v=([0-9.]+).*','\\1') }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "'{{ rke2DesiredVersion }}' == '{{ rke2InstalledVersion }}' or '{{ rke2DesiredVersion }}' <= '{{ rke2InstalledVersion }}'"
    fail_on_any: true
    success_ok: true
  when: not ansible_check_mode

- name: Run RKE2 install script if version needs to be updated
  block:
    - name: Prepare environment variables
      set_fact:
        RKE2_VERSION: "{{ rke2DesiredVersion }}"
        RKE2_BINARY: "{{ rke2_binary_path }}"

    - name: Run RKE2 install script
      shell: "{{ rke2_binary_path }} install --version={{ rke2DesiredVersion }} {{ rke2_install_options }}"
      when: rke2InstalledVersion is not defined or
            rke2InstalledVersion != rke2DesiredVersion
  when: not ansible_check_mode

- name: Copy custom manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_manifests_path }}"
    force: yes
    mode: '0755'
  with_items: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests is not empty

- name: Copy static pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_static_pods_path }}"
    force: yes
    mode: '0755'
  with_items: "{{ rke2_static_pods }}"
  when: rke2_static_pods is not empty

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: "{{ rke2_env_file }}"
    force: yes
    mode: '0755'
  when: rke2_env_file is not empty


