---
- name: Check the current version of Docker Compose installed on the system
  command: docker compose version
  register: docker_compose_version
  ignore_errors: yes

- name: Set a fact for the current Docker Compose version if it is defined and the output is not empty
  set_fact:
    current_docker_compose_version: "{{ docker_compose_version.stdout | regex_replace('v', '') | default('') }}"
  when: ansible.utils.is_set(docker_compose_version.stdout)

- name: Delete the existing Docker Compose binary if the installed version does not match the desired version
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: (ansible.utils.is_set(current_docker_compose_version)
         and (current_docker_compose_version | version_compare('!=', desired_version) | bool))

- name: Download and install the specified version of Docker Compose if it is not already installed or if the installed version is older
  get_url:
    url: https://github.com/docker/compose/releases/download/v{{ desired_docker_compose_version }}/docker-compose-{{ ansible_system }}-amd64
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when: (ansible.utils.is_set(current_docker_compose_version) | bool
         and (current_docker_compose_version | version_compare('!=', desired_version) | bool))
  register: docker_compose_download
  changed_when: checksum is not same

- name: Set executable permissions for Docker Compose
  file:
    path: /usr/local/bin/docker-compose
    mode: '0755'
  when: (ansible.utils.is_set(current_docker_compose_version) | bool
         and (current_docker_compose_version | version_compare('!=', desired_version) | bool))



