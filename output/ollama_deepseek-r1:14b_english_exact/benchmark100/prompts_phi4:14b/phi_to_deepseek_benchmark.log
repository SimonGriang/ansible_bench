---
- name: Import additional tasks from assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for specified port to be available
  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    state: started
    timeout: "{{ bootstrap_timeout }}"
  when:
    - not containerized
    - bootstrap_wait_for_host

- name: Prepare system by testing connection and verifying sudo access
  block:
    - name: Test connection
      wait_for_connection:
        state: started
        timeout: 30
    - name: Verify sudo access
      command: whoami
      args:
        warn: false
  rescue:
    - name: Gather bootstrap facts
      setup:
        gather_subset: all
    - name: Install bootstrap packages
      raw: apt-get update && apt-get install -y "{{ bootstrap_facts_packages | join(' ') }}"
      when: bootstrap_facts_packages | length > 0

- name: Gather Ansible facts about the system
  setup:
    gather_subset: all
  become: false

- name: Install necessary packages based on gathered facts
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
  become: "{{ bootstrap_become }}"



