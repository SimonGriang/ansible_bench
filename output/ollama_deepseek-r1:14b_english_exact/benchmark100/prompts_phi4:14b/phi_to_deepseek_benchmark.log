---
- name: Generate SSL private key files for each item
  community.crypto.openssl_privatekey:
    path: "{{ private_key_path }}"
    mode: '0600'
    owner: "{{ owner }}"
    group: "{{ group }}"
  loop: "{{ items }}"

- name: Generate SSL CSR (Certificate Signing Request) files for each item
  community.crypto.openssl_csr:
    path: "{{ csr_path }}"
    privatekey_path: "{{ private_key_path }}"
    mode: '0600'
    owner: "{{ owner }}"
    group: "{{ group }}"
    common_name: "{{ common_name }}"
  loop: "{{ items }}"

- name: Generate SSL certificates for each item
  community.crypto.x509_certificate:
    path: "{{ certificate_path }}"
    csr_path: "{{ csr_path }}"
    privatekey_path: "{{ private_key_path }}"
    mode: '0600'
    owner: "{{ owner }}"
    group: "{{ group }}"
    valid_days: 365
  loop: "{{ items }}"

- name: Create PKCS#12 files for each item
  community.crypto.openssl_pkcs12:
    path: "{{ pkcs12_path }}"
    privatekey_path: "{{ private_key_path }}"
    certificate_path: "{{ certificate_path }}"
    mode: '0600'
    owner: "{{ owner }}"
    group: "{{ group }}"
    friendly_name: "SSL Certificates"
  loop: "{{ items }}"

- name: Read and register the content of the private key files for each item
  ansible.builtin.slurp:
    src: "{{ private_key_path }}"
    dest: "{{ item.private_key_content | default('') }}"
  register: private_key_contents
  loop: "{{ items }}"

- name: Read and register the content of the certificate files for each item
  ansible.builtin.slurp:
    src: "{{ certificate_path }}"
    dest: "{{ item.certificate_content | default('') }}"
  register: certificate_contents
  loop: "{{ items }}"

- name: Combine the registered private key and certificate content into a single file for each item
  ansible.builtin.copy:
    content: "{{ item.private_key_content.base64decoding | default('') }}{{ item.certificate_content.base64decoding | default('') }}"
    dest: "{{ combined_certificate_path }}"
    mode: '0600'
    owner: "{{ owner }}"
    group: "{{ group }}"
  loop: "{{ items }}"


