- name: Install the vault package on the target system
  ansible.builtin.apt:
    name: "{{ vault_package }}"
    state: present
  notify:
    - Reload the system daemon
    - Restart the vault service

- name: Reload the system daemon
  ansible.builtin.systemd:
    name: systemd
    state: restarted
    daemon_reload: true

- name: Restart the vault service
  ansible.builtin.systemd:
    name: vault
    state: restarted


