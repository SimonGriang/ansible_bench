---
- name: Import additional tasks from assert.yml
  import_tasks: assert.yml
  remote_src: true
  run_once: true

- name: Install the necessary cron packages
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure the shell environment for cron
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    mode: "0600"
  notify: restart_cron

- name: Configure the PATH environment variable for cron
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    mode: "0600"
  notify: restart_cron

- name: Configure the MAILTO environment variable for cron
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    mode: "0600"
  notify: restart_cron

- name: Ensure the cron service is started and enabled
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ""

- name: Schedule the specified cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    cron_file: "{{ cron_configuration }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    chdir: "{{ item.chdir | default('') }}"
    shell: "{{ item.shell | default('/bin/bash') }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined


