- name: Install Docker Compose plugin (pre 2.12 or non RHEL/Debian)
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: yes
  when:
    - ansible_version < '2.12'
    - ansible_os_family not in ['RedHat', 'Debian']
    - docker_install_compose_plugin | bool

- name: Install Docker Compose plugin (post 2.12 and RHEL/Debian)
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: yes
  notify: restart docker
  ignore_errors: yes
  when:
    - ansible_version >= '2.12'
    - ansible_os_family in ['RedHat', 'Debian']
    - docker_install_compose_plugin | bool

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    state: directory
    mode: 0755
  when: docker_daemon_options | any

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options | json_dumps }}"
    dest: /etc/docker/daemon.json
    mode: 0644
  notify: restart docker
  when: docker_daemon_options | any

- name: Manage Docker service
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled | bool }}"
  when: docker_service_manage | bool

- name: Flush handlers
  meta: flush_handlers

- name: Include Docker Compose setup
  include_tasks: docker-compose.yml
  when: docker_install_compose | bool

- name: Get Docker group info
  getent:
    db: group
    key: docker
  when: docker_users | any

- name: Determine if users need to be added to Docker group
  set_fact:
    at_least_one_user_to_modify: "{{ (docker_users | default([]) | difference(docker_group_members | default([]))) | any }}"
  when: docker_users | any

- name: Modify user group memberships
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify | bool


