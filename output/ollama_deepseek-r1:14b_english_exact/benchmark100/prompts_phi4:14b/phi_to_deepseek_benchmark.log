---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  host: localhost

- name: Install mysql
  apt:
    name: "{{ mysql_packages }}"
    state: present
  notify: set_mysql_root_password

- name: Configure mysql server
  template:
    src: "{{ mysql_configuration_destination }}"
    dest: /etc/mysql/my.cnf
    owner: "{{ mysql_name }}"
    group: "{{ mysql_name }}"
    mode: 0644
  notify: reconfigure_mysql

- name: Configure mysql client
  template:
    src: "{{ mysql_configuration_destination }}"
    dest: /etc/mysql/my.cnf
    owner: "{{ mysql_name }}"
    group: "{{ mysql_name }}"
    mode: 0644
  notify: reconfigure_mysql

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when:
    - ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
