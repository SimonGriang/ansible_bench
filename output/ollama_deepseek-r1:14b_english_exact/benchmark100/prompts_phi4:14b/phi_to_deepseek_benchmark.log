---
- name: Update the package manager cache
  become: yes
  block:
    - name: Update APT cache
      apt:
        update_cache: yes
      when: ansible_os_family == "Debian"
    
    - name: Update DNF cache
      dnf:
        update_cache: yes
      when: ansible_os_family == "RedHat"

- name: Install the keepalived package
  become: yes
  block:
    - name: Install keepalived on Debian systems
      apt:
        name: keepalived
        state: present
      when: ansible_os_family == "Debian"
    
    - name: Install keepalived on RedHat systems
      dnf:
        name: keepalived
        state: present
      when: ansible_os_family == "RedHat"

- name: Create keepalived configuration directory
  become: yes
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: 755

- name: Create Kubernetes API health check script for Debian systems
  become: yes
  template:
    src: check_apiserver.sh.j2
    dest: /etc/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: 755
  when: ansible_os_family == "Debian"
  notify: restart_keepalived

- name: Create Kubernetes API health check script for RedHat systems
  become: yes
  template:
    src: check_apiserver.sh.j2
    dest: /usr/libexec/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: 755
  when: ansible_os_family == "RedHat"
  notify: restart_keepalived

- name: Create RKE2 Server health check script for Debian systems
  become: yes
  template:
    src: check_rke2server.sh.j2
    dest: /etc/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: 755
  when: ansible_os_family == "Debian"
  notify: restart_keepalived

- name: Create RKE2 Server health check script for RedHat systems
  become: yes
  template:
    src: check_rke2server.sh.j2
    dest: /usr/libexec/keepalived/check_rke2server.sh
    owner: root
    group: root
    mode: 755
  when: ansible_os_family == "RedHat"
  notify: restart_keepalived

- name: Create the keepalived configuration file
  become: yes
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: 644
  notify: restart_keepalived

- name: Enable keepalived service and ensure it is not masked
  become: yes
  service:
    name: keepalived
    state: started
    enabled: yes
    mask: no
  notify: restart_keepalived

- name: Flush handlers to apply changes
  meta: flush_handlers


