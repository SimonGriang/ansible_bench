- name: Remove unwanted grub.cfg for EFI systems
  ansible.builtin.file:
    path: /boot/grub2/grub.cfg
    state: absent
  become: true
  when: efi_system.stat.exists

- name: Install a user template for Grub
  ansible.builtin.copy:
    src: grub.cfg.j2
    dest: /boot/grub2/
    mode: "0644"
  notify: update_grub

- name: Add a password to the EFI Grub configuration
  ansible.builtin.lineinfile:
    path: /etc/grub2-efi.cfg
    line: "set superusers='root'"
    insertafter: "^.*"
    state: present
  become: true
  when: efi_system.stat.exists
  notify: update_grub

- name: Add a password to the MBR Grub configuration
  ansible.builtin.lineinfile:
    path: /etc/grub2.cfg
    line: "set superusers='root'"
    insertafter: "^.*"
    state: present
  become: true
  when: efi_system.stat.exists
  notify: update_grub

- name: Modify files to add --unrestricted class
  loop: "{{ lookup('ansible.builtin.file', 'files_to_modify') | list }}"
  ansible.builtin.lineinfile:
    path: "{{ item }}"
