odules and variables. Also, I should ensure that the YAML is valid, using proper indentation and syntax. I\'ll avoid any comments or explanations, just the tasks as specified.\n</think>\n\n```yaml\n---\n- name: Import assert.yml only once and delegate to localhost\n  include_tasks: assert.yml\n  changed_when: false\n  delegate_to: localhost\n\n- name: Install Python pip using the specified package name\n  apt:\n    name: "{{ python_pip_packages }}"\n    state: present\n\n- name: Configure pip proxy settings if the proxy is defined\n  template:\n    src: pip_proxy.j2\n    dest: /etc/pip.conf\n    owner: root\n    group: root\n    mode: 0644\n  when: python_pip_proxy is defined\n\n- name: Set trusted hosts for pip if specified\n  template:\n    src: pip_trusted_host.j2\n    dest: /etc/pip.conf\n    owner: root\n    group: root\n    mode: 0644\n  when: python_pip_trusted_host is defined\n\n- name: Update pip to the latest version under specific conditions\n  pip:\n    name: "{{ python_pip_pip_package }}"\n    state: latest\n  when:\n    - python_pip_update\n    -ansible_distribution_release not in ["bookworm", "noble"]\n    -ansible_os_family != "Alpine"\n\n- name: Install requested Python pip modules based on conditions\n  pip:\n    requirements:\n      - name: "{{ item }}"\n        state: "{{ state }}"\n  loop: "{{ python_pip_modules }}"\n  when:\n    -ansible_distribution_release not in ["bookworm", "noble"]\n    -ansible_os_family != "Alpine"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-14T10:38:07.963969065Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16628146306, 'load_duration': 96465602, 'prompt_eval_count': 584, 'prompt_eval_duration': 358732673, 'eval_count': 808, 'eval_duration': 16171425855, 'model_name': 'deepseek-r1:14b'} id='run--9766a49a-234f-44ad-a547-bd15468dc4f3-0' usage_metadata={'input_tokens': 584, 'output_tokens': 808, 'total_tokens': 1392}
