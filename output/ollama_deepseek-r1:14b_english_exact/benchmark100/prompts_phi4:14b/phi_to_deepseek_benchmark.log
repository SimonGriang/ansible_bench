ed\n  template:\n    src: pip.conf.j2\n    dest: /etc/pip.conf\n    owner: root\n    group: root\n    mode: 0644\n  when:\n    - ansible_var_exists(\'python_pip_proxy\')\n\n- name: Set trusted hosts for pip if specified\n  template:\n    src: pip.conf.j2\n    dest: /etc/pip.conf\n    owner: root\n    group: root\n    mode: 0644\n  when:\n    - ansible_var_exists(\'python_pip_trusted_host\')\n\n- name: Update pip to the latest version under specific conditions\n  pip:\n    name: "{{ python_pip_pip_package | default(\'pip\') }}"\n    state: latest\n  when:\n    - python_pip_update\n    - ansible_distribution_release not in ["bookworm", "noble"]\n    - ansible_os_family != "Alpine"\n\n- name: Install requested Python pip modules based on conditions\n  pip:\n    requirements: "{{ item }}"\n    state: present\n  with_items: "{{ python_pip_modules }}"\n  when:\n    - ansible_distribution_release not in ["bookworm", "noble"]\n    - ansible_os_family != "Alpine"\n\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-14T10:46:50.268477569Z', 'done': True, 'done_reason': 'stop', 'total_duration': 26560977291, 'load_duration': 89925722, 'prompt_eval_count': 1018, 'prompt_eval_duration': 158246885, 'eval_count': 1236, 'eval_duration': 26312278530, 'model_name': 'deepseek-r1:14b'} id='run--fdaad02e-5ebd-4298-a01c-0e4a30a34d75-0' usage_metadata={'input_tokens': 1018, 'output_tokens': 1236, 'total_tokens': 2254}
