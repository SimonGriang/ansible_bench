---
- name: Determine if the system is EFI
  file:
    path: /boot/efi
    state: exists
  register: efi_system

- name: Remove unwanted grub.cfg for EFI systems
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  become: yes
  when: efi_system.stat.exists

- name: Install a user template for Grub
  copy:
    src: grub.cfg.j2
    dest: /boot/grub2/
    mode: 0644
  notify: update_grub

- name: Add a password to the EFI Grub configuration
  lineinfile:
    path: /etc/grub2-efi.cfg
    line: "set superusers='root'"
    insertafter: "^.*"
    state: present
  become: yes
  when: efi_system.stat.exists
  notify: update_grub

- name: Add a password to the MBR Grub configuration
  lineinfile:
    path: /etc/grub2.cfg
    line: "set superusers='root'"
    insertafter: "^.*"
    state: present
  become: yes
  when: efi_system.stat.exists
  notify: update_grub

- name: Modify files to add --unrestricted class
  loop: "{{ lookup('file', 'files_to_modify') | list }}"
  file:
    path: "{{ item }}"
    state: present
  become: yes
  loop_control:
    loop_var: item_path
  lineinfile:
    path: "{{ item_path }}"
    line: "CLASS= --unrestricted"
    insertafter: "^.*"
    state: present
  notify: update_grub


