---  
- name: Import common assertions for the httpd role  
  import_tasks: assert.yml  
  delegate_to: localhost  
  run_once: true  

- name: Install the apache httpd package  
  package:  
    name: "{{ httpd_packages }}"  
    state: present  

- name: Configure SELinux settings for httpd if SELinux is enabled  
  when: httpd_selinux_enabled | ansible_bool  
  block:  
    - name: Modify SELinux boolean settings  
      seboolean:  
        name: "{{ item }}"  
        state: "{{ httpd_sebooleans_value|default('on') }}"  
        persist: yes  
      loop: "{{ httpd_sebooleans|default([]) }}"  

    - name: Allow connections to custom ports  
      seport:  
        port: "{{ item }}"  
        proto: tcp  
        state: present  
      loop: "{{ httpd_ports|default([]) }}"  

- name: Configure the httpd main configuration file using a template  
  template:  
    src: "{{ httpd_config_src }}"  
    dest: "{{ httpd_config_dest }}"  
    owner: root  
    group: root  
    mode: 0644  
  notify: httpd_config_test  

- name: Activate httpd modules using a command on Debian systems  
  when: ansible_distribution in ['debian', 'ubuntu']  
  command: a2enmod {{ item }}  
  loop: "{{ httpd_modules_to_activate_with_command|default([]) }}"  
  notify: httpd_config_test  

- name: Import SSL configuration tasks if HTTPS is enabled  
  when: https_ssl_enable | ansible_bool  
  import_tasks: ssl.yml  

- name: Import location configuration tasks if locations are defined  
  when: httpd_locations | bool  
  import_tasks: locations.yml  

- name: Import virtual host configuration tasks if virtual hosts are defined  
  when: httpd_vhosts | bool  
  import_tasks: vhosts.yml  

- name: Configure ports using a template on Debian and Suse systems  
  when: ansible_distribution in ['debian', 'ubuntu', 'suse']  
  template:  
    src: "{{ httpd_ports_conf }}"  
    dest: "{{ httpd_ports_dest }}"  
    owner: root  
    group: root  
