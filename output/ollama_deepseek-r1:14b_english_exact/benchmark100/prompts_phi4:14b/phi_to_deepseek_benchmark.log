---
- name: Gather facts about all services
  ansible.builtin.command:
    command: systemctl list-unit-files --type=service
    register: services
  ansible.builtin.set_fact:
    services_list: "{{ services.stdout_lines }}"

- name: Determine the active RKE2 server
  ansible.builtin.set_fact:
    active_server: "{{ ansible_hostname }}"
  delegate_to: "{{ item }}"
  with_items: "{{ group_rke2_servers }}"
  when:
    - "'rke2-server.service' in services_list"
    - "{{ ansible_hostname }} in group_rke2_servers | selectattr('group_rke2_servers') | list"

