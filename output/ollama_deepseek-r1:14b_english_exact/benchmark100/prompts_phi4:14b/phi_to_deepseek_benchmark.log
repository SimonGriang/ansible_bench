---
- name: Update the package manager cache
  become: yes
  block:
    - name: Update APT cache
      apt:
        update_cache: yes
      when: ansible_os_family == "Debian"
    
    - name: Update DNF cache
      dnf:
        update_cache: yes
      when: ansible_os_family == "RedHat"

- name: Install the keepalived package
  become: yes
  block:
    - name: Install keepalived on Debian systems
      apt:
        name: keepalived
        state: present
      when: ansible_os_family == "Debian"
    
    - name: Install keepalived on RedHat systems
      dnf:
        name: keepalived
        state: present
      when: ansible_os_family == "RedHat"

- name: Create keepalived configuration directory
  become: yes
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: 755

- name: Create Kubernetes API health check script for Debian systems
  become: yes
  template:
    src: check_apiserver.sh.j2
    dest: /etc/keepalived/check_apiserver.sh
    owner: root
    group: root
    mode: 755
  when: ansible_os_family == "Debian"
  notify: restart_keepalived

- name: Create Kubernetes API health check script for RedHat systems
