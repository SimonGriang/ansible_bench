---
- name: Install Keepalived
  ansible.builtin.yum:
    name: keepalived
    state: present
  when:
    - kubernetes_ha_mode is true
    - keepalived_enabled is true
    - group == 'rke2_servers'
    - api_ip is defined

- name: Download and install RKE2 version
  ansible.builtin.get_url:
    url: "https://github.com/rke2-io/rke2/releases/download/v{{ rke2_version }}\
/rke2-{{ rke2_arch }}"
    dest: /usr/bin/rke2
    mode: '0755'
  register: rke2_download
  when:
    - rke2_version is defined

- name: Apply CIS Hardening
  ansible.builtin.include_tasks:
    file: cis-hardening.yml
  when:
    - cis_profile is defined
    - cis_profile != ''

- name: Find Active Server
  ansible.builtin.command:
    cmd: kubectl get nodes -o jsonpath='{.items[0].status.conditions nodeName}'
  register: active_server
  when:
    - kubernetes_ha_mode is true

- name: Enable IPVS kernel module
  ansible.posix.sysctl:
    name: net.ipv4.ipvs.enabled
    value: 1
    permanent: true
  when:
    - kubevip_ipvs is true
    - group == 'rke2_servers'
    - kubernetes_ha_mode is true
    - keepalived_enabled is false

- name: Copy kube-vip manifests to masternode
  ansible.builtin.copy:
    remote_src: true
    src: /path/to/kube-vip-manifests
    dest: /path/to/master/manifests
  when:
    - kubernetes_ha_mode is true
    - kubevip_enabled is true
    - keepalived_enabled is false

- name: Copy ingress-nginx manifests to masternode
  ansible.builtin.copy:
    remote_src: true
    src: /path/to/ingress-nginx-manifests
    dest: /path/to/master/manifests
  when:
    - ingress_nginx_values is defined
    - ingress_nginx_values != ''

- name: Prepare very first server node in the cluster
  ansible.builtin.command:
    cmd: rke2-up --config /path/to/config.yaml
  when:
    - (rke2_node_count == 1 or active_server is not defined)

- name: Restore etcd specific tasks
  ansible.builtin.include_tasks:
    file: etcd-restore.yml
  when:
    - active_server is defined
    - (group == 'rke2_servers' or group == 'rke2_first_server')

- name: Download kubeconfig to ansible localhost
  ansible.builtin.fetch:
    src: /path/to/kubeconfig
    dest: /path/to/local/kubeconfig
  when:
    - download_kubeconfig is true
    - group == 'rke2_first_server'

- name: Prepare and join remaining nodes of the cluster
  ansible.builtin.include_tasks:
    file: cluster-join.yml
  when:
    - active_server is defined
    - rke2_node_count > 1

- name: Rolling cordon and drain restart when version changes - servers
  ansible.builtin.include_tasks:
    file: rolling-cordon.yml
  when:
    - rke2_version is changed
    - group == 'rke2_servers'

- name: Rolling cordon and drain restart when version changes - agents
  ansible.builtin.include_tasks:
    file: rolling-cordon.yml
  when:
    - rke2_version is changed
    - group == 'rke2_agents'

- name: Flush handlers
  ansible.ansible.flush_handlers:
    name: all

- name: Rolling restart when config files change
  ansible.builtin.include_tasks:
    file: rolling-restart.yml
  when:
    - config_files_changed is true

- name: Final steps
  ansible.builtin.command:
    cmd: /path/to/finalize.sh


