- name: Enable the Backports repository for Debian systems with a version less than 9
  apt_repository:
    repo: 'http://deb.debian.org/debian-backports/ {{ ansible_facts['os']['version'] }} main'
    state: present
  when: ansible_distribution_version < '9'

- name: Set the default release to Backports for Debian systems with a version less than 9
  set_fact:
    ansible_default_release: backports
  when: ansible_distribution_version < '9'

- name: Install the Ansible package, using the Backports release if applicable
  apt:
    name: ansible
    state: '{{ ansible_package_state }}'
    default_release: "{{ ansible_default_release | default('') }}"
  when: ansible_default_release is defined


