---
- name: Create a directory for SSH keys if user management is enabled
  file:
    path: /var/lib/ssh-keys
    state: directory
    changed_when: false

- name: Manage user accounts, ensuring they are created or updated with specified parameters
  user:
    name: "{{ user_name }}"
    comment: "{{ user_comment }}"
    home: "{{ user_home }}"
    shell: "{{ user_shell }}"
    groups: "{{ user_groups | default('') }}"
    state: present
    changed_when: false
  register: result_user

- name: Set sudo privileges for users if specified in their configuration
  template:
    dest: /etc/sudoers.d/ssh-user
    mode: '0440'
    content: "{{ lookup('template', 'sudoers.j2') | default('') }}"
  when: sudo_options | default(false)

- name: Remove sudo privileges for users if not specified in their configuration
  file:
    path: /etc/sudoers.d/ssh-user
    state: absent
  when: not sudo_options

- name: Generate a private SSH key for users who require SSH key management
  keypair:
    name: "{{ user_name }}"
    state: present
    generate_if_not_exist: yes
  changed_when: false

- name: Generate a public SSH key for users who require SSH key management
  keypair:
    name: "{{ user_name }}"
    state: present
    public_key: "{{ public_key }}"
    generate_if_not_exist: yes
  changed_when: false

- name: Convert the SSH key to a PPK format for users who require SSH key management
  ppk_openbsd:
    src: "/var/lib/ssh-keys/{{ user_name }}_key.pub"
    dest: "/var/lib/ssh-keys/{{ user_name }}_key.ppk"
    format: ppk
  changed_when: false

- name: Determine the home directory for users, defaulting to /home if the user is not found
  getent:
    db: users
    key: "{{ user_name }}"
  register: home_dir
  changed_when: false

- name: Create an .ssh directory in the user's home directory if SSH key management is enabled or private keys need to be set
  file:
    path: "{{ home_dir.item.home | default('/home') }}/.ssh"
    state: directory
    changed_when: false

- name: Deploy authorized SSH keys for users if specified
  authorized_key:
    user: "{{ user_name }}"
    state: present
    key: "{{ item }}"
  loop: "{{ authorized_keys | default([]) }}"

- name: Remove unauthorized SSH keys from users if specified
  authorized_key:
    user: "{{ user_name }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ lookup('file', '/home/{{ user_name }}/.ssh/authorized_keys') | split('\n') | list | difference( (authorized_keys | default([])) + [''] ) }}"

- name: Copy generated private SSH keys to the user's .ssh directory if specified
  copy:
    src: "/var/lib/ssh-keys/{{ user_name }}_key"
    dest: "{{ home_dir.item.home | default('/home') }}/.ssh/"
  when: copy_private_key

- name: Check the password validity period for users
  get_file:
    path: /etc/shadow
    remote_src: true
    dest: /tmp/shadow
  changed_when: false

- name: Set the password validity period for users if a specific duration is defined
  passwd:
    name: "{{ user_name }}"
    days: "{{ password_days | default('') }}"
    state: present
  when: password_days is not empty

- name: Place additional private key files in the user's .ssh directory if specified
  copy:
    src: "{{ item }}"
    dest: "{{ home_dir.item.home | default('/home') }}/.ssh/"
  loop: "{{ additional_private_keys | default([]) }}"


