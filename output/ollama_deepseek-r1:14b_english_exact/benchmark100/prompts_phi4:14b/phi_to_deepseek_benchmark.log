- name: Install the EPEL repository package when the target system is Amazon Linux 2 or Red Hat-based systems with major versions 7, 8, 9, or 10
  become: true
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present
  register: epel_key_result
  notify: Update package cache

- name: Install the GPG key for the EPEL repository to ensure package authenticity
  become: true
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install the EPEL-release package and notify the handler to update the package cache
  become: true
  ansible.builtin.package:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Optionally install the EPEL-next-release package if the epel_next variable is set, and notify the handler to update the package cache
  become: true
  ansible.builtin.package:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next
  notify: Update package cache

- name: Update package cache
  become: true
  ansible.builtin.shell:
    cmd: yum clean all && yum makecache
  handler: true


