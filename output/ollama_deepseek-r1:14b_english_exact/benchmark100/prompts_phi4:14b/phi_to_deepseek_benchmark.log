---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  args:
    host: localhost

- name: Install fail2ban
  ansible.builtin.apt:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Copy filters in filter.d
  ansible.builtin.copy:
    remote_src: true
    src: "{{ fail2ban_filterd_path }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    mode: '0640'

- name: Configure fail2ban.local
  community.general.ini_file:
    path: /etc/fail2ban/failban.local
    sections:
      "{{ item.key }}": "{{ item.value }}"
    for_each: "{{ fail2ban_base_configuration + fail2ban_configuration }}"
    state: present
    mode: '0640'
    section: "{{ item.key }}"

- name: Configure jail.local
  community.general.ini_file:
    path: /etc/fail2ban/jail.local
    sections:
      "{{ item.key }}": "{{ item.value }}"
    for_each: |
      "{{ fail2ban_base_jail_configuration
        + fail2ban_jail_configuration }}"
    state: present
    mode: '0640'
    section: "{{ item.key }}"

- name: Stat auth log file
  ansible.builtin.stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Touch auth log file
  ansible.builtin.file:
    path: /var/log/auth.log
    state: touch
    mode: '0640'

- name: Start and enable fail2ban
  ansible.builtin.service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: true


