 structure the YAML playbook with each task, ensuring proper indentation and module usage.\n</think>\n\n```yaml\n---\n- name: Task 1: Import the assert.yml task file to be executed once on localhost\n  include_tasks:\n    file: assert.yml\n  run_once: true\n  changed_when: false\n\n- name: Task 2: Install required packages for OpenSSL\n  apt:\n    name: "{{ openssl_requirements }}"\n    state: present\n    update_cache: yes\n\n- name: Task 3: Install pip packages if the list is not empty\n  pip:\n    name: "{{ item }}"\n    state: present\n  when: "\'{{ openssl_pip_packages }}\' is defined and openssl_pip_packages | length > 0"\n  with_items: "{{ openssl_pip_packages }}"\n\n- name: Task 4: Create directory for OpenSSL keys\n  file:\n    path: "{{ openssl_keys_dir }}"\n    state: directory\n    mode: 700\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Task 5: Create directory for OpenSSL CSRs\n  file:\n    path: "{{ openssl_csr_dir }}"\n    state: directory\n    mode: 755\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Task 6: Create directory for OpenSSL certificates\n  file:\n    path: "{{ openssl_certs_dir }}"\n    state: directory\n    mode: 755\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Task 7: Include the create.yml task file for each item in openssl_items\n  include_tasks:\n    file: create.yml\n  when: "\'{{ openssl_items }}\' is defined and openssl_items | length > 0"\n  with_items: "{{ openssl_items }}"\n  changed_when: false\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-14T10:26:21.648715749Z', 'done': True, 'done_reason': 'stop', 'total_duration': 19073547080, 'load_duration': 95501632, 'prompt_eval_count': 639, 'prompt_eval_duration': 314955980, 'eval_count': 825, 'eval_duration': 18662527783, 'model_name': 'deepseek-r1:14b'} id='run--55605eec-87ac-4a2a-b6a5-189a374112b3-0' usag