s correctly placed in the sequence.\n</think>\n\n```yaml\n---\n- import_tasks: assert.yml\n  delegate_to: localhost\n  tags:\n    - always\n  run_once: true\n\n- name: Wait for port to be available\n  ansible.builtin.wait_for_port:\n    port: 22\n    timeout: "{{ bootstrap_timeout }}"\n  when:\n    - bootstrap_wait_for_host\n  no_log: false\n\n- block:\n    - name: Test connection and check sudo availability\n      shell: |\n        ping -c 1 localhost && echo "Connection OK" || echo "Connection Failed"\n        exit $? || true\n      changed_when: false\n      ignore_errors: yes\n\n    - name: Gather bootstrap facts and install packages\n      raw: |\n        if command -v sudo; then echo "Sudo is available"; fi\n        exit 0\n      changed_when: false\n      ignore_errors: yes\n      when: "{{ ansible_distribution_id }}" != "centos"\n\n    - name: Install libdnf5 on RedHat-based systems\n      yum:\n        name: libdnf5\n        state: present\n      when: "{{ ansible_distribution_id }}" == "centos"\n\n  ignore_errors: yes\n\n- name: Gather Ansible facts\n  ansible.builtin.setup:\n    gather_subset: all\n  become: false\n\n- name: Install bootstrap packages\n  apt:\n    name: "{{ bootstrap_facts_packages }}"\n    state: present\n    update_cache: yes\n  when: ansible_os_family == "Debian"\n  become: "{{ bootstrap_become }}"\n\n  - name: Install packages on RedHat\n    yum:\n      name: "{{ bootstrap_facts_packages }}"\n      state: present\n      update_cache: yes\n    when: ansible_os_family == "RedHat"\n    become: "{{ bootstrap_become }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-14T09:25:57.676965581Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16239650899, 'load_duration': 91620598, 'prompt_eval_count': 629, 'prompt_eval_duration': 377862835, 'eval_count': 810, 'eval_duration': 15769177470, 'model_name': 'deepseek-r1:14b'} id='run--efef3f78-6330-4a61-b86b-aa4b4a8df533-0' usage_metadata={'i