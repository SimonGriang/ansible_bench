ariables are correctly referenced and that the conditions in the `when` statements are accurately reflecting the task descriptions.\n\nFinally, I\'ll ensure that the entire playbook is a single YAML file starting with \'---\' and that it only contains the tasks as specified without any additional comments or explanations.\n</think>\n\n```yaml\n---\n- name: Create document root directories for Apache virtual hosts\n  file:\n    path: "{{ item.documentroot }}"\n    state: directory\n  loop: "{{ httpd_vhosts | default([]) }}"\n  when:\n    - item.documentroot is defined\n    - (item.create_docroot is not defined or item.create_docroot == true)\n\n- name: Configure Apache virtual hosts\n  template:\n    src: "{{ vhost_conf_template }}"\n    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}"\n    mode: 0644\n  loop: "{{ httpd_vhosts | default([]) }}"\n  notify:\n    - Test httpd configuration validity\n    - Restart httpd\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-14T11:16:27.927942584Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11931578743, 'load_duration': 96208592, 'prompt_eval_count': 440, 'prompt_eval_duration': 127909918, 'eval_count': 652, 'eval_duration': 11706145676, 'model_name': 'deepseek-r1:14b'} id='run--668bf03d-2813-4db2-b22e-dc524b9c6360-0' usage_metadata={'input_tokens': 440, 'output_tokens': 652, 'total_tokens': 1092}
