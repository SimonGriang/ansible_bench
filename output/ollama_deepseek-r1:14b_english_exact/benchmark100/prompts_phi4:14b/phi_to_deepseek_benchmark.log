---
- name: Import assert.yml and ensure it is run only once on the localhost
  import_tasks: assert.yml
  hosts: localhost

- name: Install required software packages based on the users_requirements variable
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ users_requirements | default([]) }}"
  when: users_requirements is defined and users_requirements | length > 0

- name: Iterate over each group in the users_groups variable and include group.yml
  include_tasks: group.yml
  loop: "{{ users_groups | default([]) }}"
  loop_control:
    label: "{{ item.name }}"

- name: Ensure /etc/sudoers includes /etc/sudoers.d directory
  lineinfile:
    path: /etc/sudoers
    line: '## Allow cron jobs to run as user without password'
    regexp: '^## Allow cron jobs to run as user without password'
    validate: visudo

- name: Iterate over each user in the users variable and include user.yml
  include_tasks: user.yml
  loop: "{{ users | default([]) }}"
  loop_control:
    label: "{{ item.name }}"

- name: Manage cron permissions by creating or updating /etc/cron.allow
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0644
  when: users_cron_allow is true

- name: Remove /etc/cron.allow if cron permissions are not required
  file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is false


