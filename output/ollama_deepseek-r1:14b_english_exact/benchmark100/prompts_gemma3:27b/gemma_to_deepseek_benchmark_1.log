---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  changed_when: false

- name: Install git
  ansible.builtin.become: true
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  ansible.builtin.getent:
    user: "{{ git_username }}"
  register: user_exists
  failed_when: 
    yes: "{{ user_exists.rc != 0 | bool if not (fail_key | bool) else false }}"
    no: "{{ user_exists.rc == 0 | bool if not (fail_key | bool) else true }}"

- name: Create directory for git configuration
  ansible.builtin.become: true
  ansible.builtin.file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0755"

- name: Place git configuration
  ansible.builtin.become: true
  ansible.builtin.template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0644"

- name: Create repository_destination
  ansible.builtin.become: true
  ansible.builtin.file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0755"

- name: Clone all roles
  ansible.builtin.become: true
  ansible.builtin.git:
    repo: "{{ repo.url }}"
    dest: "{{ repo.destination }}"
    version: "{{ repo.version }}"
    force: "{{ repo.force | default('yes') | lower | bool }}"
    remote: "{{ repo.remote | default('origin') }}"
    branch: "{{ repo.branch | default('master') }}"
    user: "{{ git_username }}"
    key_file: "{{ git_ssh_key | default('') }}"
    become_user: "{{ git_username }}"
  loop: "{{ git_repositories }}"
  loop_control:
    label: "{{ item.destination }}"

