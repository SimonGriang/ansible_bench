- name: Create DNS directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0755
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create DNS group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create DNS user
  user:
    name: "{{ dns_owner }}"
    system: yes
    state: present

- name: Generate rndc key
  command: rndc-confgen -a -d -c /etc/dns/rndc.conf
  args:
    chdir: /etc/dns
    creates: /etc/dns/rndc.key
  register: rndc_key_result

- name: Set permissions on rndc key file
  file:
    path: /etc/dns/rndc.key
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0600

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/named.root"
    mode: 0644
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.zone_name }}.zone"
    mode: 0644
  loop: "{{ dns_zones }}"
  notify: Rndc reload
  register: zone_file_result

- name: Set permissions on zone file
  file:
    path: "{{ item.path }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0644
  loop: "{{ zone_file_result.results }}"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/dns/named.conf
    mode: 0644

- name: Set permissions on configuration file
  file:
    path: /etc/dns/named.conf
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0644
  notify: Restart dns

- name: Place systemd override
  file:
    path: /etc/systemd/system/{{ dns_service }}/override.conf
    state: touch
    mode: 0644
  when: ansible_system == 'SystemD'

- name: Reload systemd daemon
  systemd:
    name: "{{ dns_service }}"
    state: reloaded
    force: yes

- name: Start and enable dns
  systemd:
    name: "{{ dns_service }}"
    state: started
    enabled: yes
  when: ansible_system == 'SystemD'


