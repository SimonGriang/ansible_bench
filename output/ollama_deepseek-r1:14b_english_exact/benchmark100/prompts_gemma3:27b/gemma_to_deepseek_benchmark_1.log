---
hosts: all
tasks:
  - name: Check if SELinux is enabled and configure it
    ansible.builtin.yum:
      name: selinux-policy
      state: present
    when:
      - vault_hardening_configure_selinux_apparmor
      - ansible_selinux.status == "enabled"
    notify:
      - Set SELinux to enforcing

  - name: Set SELinux to enforcing
    ansible.builtin.command:
      cmd: setenforce enforcing
    when:
      - vault_hardening_configure_selinux_apparmor
      - ansible_selinux.status == "enabled"
    notify: []

  - name: Check if AppArmor is enabled and configure it
    ansible.builtin.apt:
      name: apparmor
      state: present
    when:
      - vault_hardening_configure_selinux_apparmor
      - ansible_apparmor.status == "enabled"
    notify:
      - Reload AppArmor

  - name: Reload AppArmor
    ansible.builtin.command:
      cmd: systemctl reload apparmor
    when:
      - vault_hardening_configure_selinux_apparmor
      - ansible_apparmor.status == "enabled"
    notify: []


