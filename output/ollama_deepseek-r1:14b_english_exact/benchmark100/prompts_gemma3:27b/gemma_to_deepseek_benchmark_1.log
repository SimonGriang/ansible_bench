- name: Remove old Docker packages
  ansible.builtin.dnf:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Add Docker GPG key
  ansible.legacy.rpm_key:
    key_content: "{{ docker_yum_gpg_key }}"
    state: present
  when: docker_add_repo

- name: Add Docker repository
  ansible.builtin.copy:
    remote_src: true
    content: "{{ (ansible.builtin.uri(url=docker_yum_repo_url).content | ansible.builtin.json).text }}"
    dest: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    owner: root
    group: wheel
    mode: 644
  when: docker_add_repo

- name: Configure Docker Nightly repo
  ansible.builtin.ini_file:
    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    section: docker-{{ docker_edition }}-nightly
    key: enabled
    value: "{{ docker_yum_repo_enable_nightly }}"
  when: docker_add_repo

- name: Configure Docker Test repo
  ansible.builtin.ini_file:
    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    section: docker-{{ docker_edition }}-test
    key: enabled
    value: "{{ docker_yum_repo_enable_test }}"
  when: docker_add_repo

