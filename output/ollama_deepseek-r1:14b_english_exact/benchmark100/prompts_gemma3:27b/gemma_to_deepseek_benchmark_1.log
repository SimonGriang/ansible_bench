---
- name: Check OS compatibility
  ansible:
    gather_facts: true
  when:
    - ansible_distribution in ['amzn', 'redhat', 'centos', 'ol', 'SLC']
    - ansible_distribution_major_version in ['7', '8', '9']

- name: Install epel gpg key
  yum:
    name: epel-gpg-key
