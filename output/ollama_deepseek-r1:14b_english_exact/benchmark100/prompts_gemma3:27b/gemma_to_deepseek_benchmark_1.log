---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_installer_url }}"
    dest: /tmp/rke2-install.sh
    force: yes

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_local_installer }}"
    dest: /tmp/rke2-install.sh
  when: airgap | bool and implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
  when: airgap | bool and implementation != 'exists'

- name: Download RKE2 checksum and artifacts (try remote first)
  get_url:
    url: "{{ rke2_checksum_url }}"
    dest: "{{ rke2_artifacts_path }}/"
    force: yes
  until:
    - file exists="{{ rke2_artifacts_path }}/rke2.tgz"
    - file exists="{{ rke2_artifacts_path }}/rke2-checksum.txt"
  retries: 3
  delay: 10
  when: airgap | bool

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifacts }}"
    dest: "{{ rke2_artifacts_path }}"
  when: airgap | bool and implementation == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_artifacts_path }}/images/"
  loop: "{{ rke2_additional_images }}"

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  set_file_mode:
    path: "{{ rke2_artifacts_path }}/**"
    state: minimum

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Check if separate partition
  set_fact:
    rke2_separate_partition: "{{ansible_facts.filesystem.Mounted | selectattr('mountpoint', 'contains', '/usr/local') | list | length > 0 }}"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin: "{{ 'docker' if rke2_separate_partition else 'dockerd' }}"

- name: Check RKE2 version
  apt:
    name: docker
    state: present

- name: Set RKE2 versions
  set_fact:
    rke2_version_installed: "installed"
    rke2_version_running: "running"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "semver(rke2_version_running) >= semver(rke2_version_installed)"
    fail_on_any_failure: yes

- name: Run RKE2 install script
  shell:
    cmd: /tmp/rke2-install.sh install
    chdir: /tmp
    creates: /etc/rke2
  when: not rke2_downgrade

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_dir }}/manifests/"
  loop: "{{ rke2_custom_manifests }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_dir }}/staticPods/"
  loop: "{{ rke2_static_pods }}"

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: /etc/default/rke2


