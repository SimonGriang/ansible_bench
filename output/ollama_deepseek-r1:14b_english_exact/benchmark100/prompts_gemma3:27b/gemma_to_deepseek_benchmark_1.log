---
- name: lookup bootstrap facts (raw)
  raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_distribution_major_version: >
      {{ lookup('ansible.utils.regex',
                ansible_facts.processsed_raw.stdout,
                pattern='^VERSION_ID="?([^"]+)"?',
                capture=1)
           .split('.')[0]
           | int }}
  loop: "{{ bootstrap__os_family_map | dict2list }}"
  when:
    - bootstrap_facts.rc == 0
    - not bootstrap_distribution
    - "{{ansible_facts.processsed_raw.stdout | regex_search(item.value)}}"
  become: "{{bootstrap_become}}"
  become_user: "{{bootstrap_become_user}}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map | dict2list }}"
  when: "{{bootstrap_distribution in item.value}}"
  become: "{{bootstrap_become}}"
  become_user: "{{bootstrap_become_user}}"


