- name: Conditionally include Debian 12 tasks
  include_tasks: debian12.yml
  when:
    - ansible_distribution == "Debian"
    - ansible_distribution_version >= "12.00"

- name: Install Pip
  package:
    name: pip
    state: present

- name: Install python3-packaging
  package:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    packages: "{{ pip_install_packages | default([]) | dict"}}
    pip_executable: "{{ pip_executable | default('pip') }}"
    virtualenv: "{{ item.ansible_python_virtualenv_dir if item | default('') }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default('') }}"
    extra_args: "{{ item.extra_args | default('') }}"
  loop: "{{ pip_install_packages | default([]) | dict }}"


