---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  apt:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  template:
    src: grub_timeout.j2
    dest: /etc/default/grub
    mode: 0o664
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  template:
    src: grub_recordfail_timeout.j2
    dest: /etc/default/grub
    mode: 0o664
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  loop: "{{ grub_options }}"
  become: true
  template:
    src: grub_options.j2
    dest: /etc/default/grub
    mode: 0o664
    validate_mode: true
  notify: Update grub
  when: grub_options | length > 0

- name: Import password.yml
  import_tasks: password.yml
  when: grub_set_password

- name: Flush handlers
  meta: flush_handlers


