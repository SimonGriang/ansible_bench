---
- name: Check Java Certificate Existence
  stat:
    path: "{{ item }}"
    register: check_java_certs
  loop: "{{ java_certs }}"

- name: Fail if Java Certificate Doesn't Exist
  fail:
    msg: "Java certificate {{ item.path }} does not exist"
  when: item.exists is false
  loop: "{{ check_java_certs.results }}"

- name: Set Keystore Directory for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: java_open_jdk_version_major is defined and java_open_jdk_version_major < 11

- name: Set Keystore Directory for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: java_open_jdk_version_major is defined and java_open_jdk_version_major >= 11

- name: Import SSL Certificates into Java Keystore
  java_cert:
    path: "{{ item.path }}"
    keystore: "{{ java_open_jdk_home }}/jre/lib/security/{{ java_keystore_dir }}"
    key_store_password: "{{ java_cert_keystore_pass }}"
    alias: "{{ item.alias }}"
    state: present
  loop: "{{ java_certs }}"
  vars:
    java_cert_path: "{{ item.path }}"


