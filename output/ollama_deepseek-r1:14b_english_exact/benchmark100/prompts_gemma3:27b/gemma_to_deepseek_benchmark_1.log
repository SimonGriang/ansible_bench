---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: yes

- name: Wait for port to be available
  wait_for_port:
    state: started
    port: "{{ ansible_port | default(22) | int }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection != 'container'
    - bootstrap_wait_for_host

- name: Prepare system
  action: setup
  no_log: true
  rescue:
    - name: Gather bootstrap facts
      setup:
        gather_subset: bootstrap_facts_packages
    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages.split(',') | list }}"
        state: present
        become: "{{ bootstrap_become }}"

- name: Gather ansible facts
  action: setup

- name: Install bootstrap packages (package)
  action: package
  args:
    name: "{{ bootstrap_facts_packages.split(',') | list }}"
    state: present
    become: "{{ bootstrap_become }}"

