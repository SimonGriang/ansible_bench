---

- import_tasks: assert.yml
  delegate_to: localhost
  register: task1_result
  notify: Gather facts

- name: Install required packages
  become: yes
  become_flags: sudo
  apt:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  shell: selinuxenabled && echo "SELinux is enabled"
  changed_when: false
  register: selinux_enabled
  when: ansible_selinux.status is not undefined and not ansible_connection.container
  notify: Reboot

- name: Set selinux state and policy
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when: ansible_selinux.status is not undefined and not ansible_connection.container
  notify: Reboot

- name: Manage selinux booleans
  setsebool:
    name: "{{ item.name }}"
    state: "{{ item.state | default('yes') | lower()}}"
    persistent: yes
  loop: "{{ selinux_booleans | default([]) }}"
  when: selinux_booleans is defined
  label: "{{ item.name }}"

handlers:

  - name: Gather facts
    setup:
      gather_subset: all

  - name: Reboot
    reboot:
      reboot_timeout: 60s

