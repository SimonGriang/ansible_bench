---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  run_once: true
  changed_when: false

- name: Install git
  become: yes
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    user: "{{ git_username }}"
  register: user_exists
  failed_when: "{{ fail_key }} | bool ? false : (user_exists.rc != 0)"

- name: Create directory for git configuration
  become: yes
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: 0755

- name: Place git configuration
  become: yes
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: 0644

- name: Create repository_destination
  become: yes
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: 0755

- name: Clone all roles
  become: yes
  git:
    repo: "{{ repo.url }}"
    dest: "{{ repo.destination }}"
    version: "{{ repo.version }}"
    force: "{{ repo.force | default('yes') | lower | bool }}"
    remote: "{{ repo.remote | default('origin') }}"
    branch: "{{ repo.branch | default('master') }}"
    user: "{{ git_username }}"
    key_file: "{{ git_ssh_key | default('') }}"
    become_user: "{{ git_username }}"
  with_items: "{{ git_repositories }}"
  loop_control:
    label: "{{ item.destination }}"


