---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: present
  when:
    - ansible_distribution in ['RedHat', 'Fedora', 'CentOS']
    - ansible_major_version == '8'

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present
  become: true

- name: Configure redis
  template:
    src: redis.conf-{{ ansible_distribution }}.j2
    dest: "{{ redis_configuration_directory }}/{{ redis_configuration_file }}"
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes
  notify: Restart redis

