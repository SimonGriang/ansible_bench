---
- name: Create ssh_key_directory for user
  file:
    path: "{{ user_ssh_key_dir }}/{{ user_name }}"
    state: directory
    mode: 0700
  become: false
  run_once: true
  when: user_manage_ssh_key

- name: Manage user account
  user:
    name: "{{ user_name }}"
    state: "{{ user_state | default('present') }}"
    comment: "{{ user_comment | default('') }}"
    home: "{{ user_home | default('/home/' + user_name) }}"
    password: "{{ user_password }}"
    uid: "{{ user_uid | default('') }}"
    group: "{{ user_group | default('users') }}"
    shell: "{{ user_shell | default('/bin/bash') }}"
    expires: "{{ user_expires | default('') }}"
  register: user_result

- name: Set sudo options for user
  template:
    src: "{{ user_sudoers_template | default('sudoers.j2') }}"
    dest: "/etc/sudoers.d/{{ user_name }}"
    validate_on_file_write: yes
    group: root
    mode: 0644
  loop: "{{ user_sudo_users | default([]) }}"
  loop_var: user_loop_var

- name: Remove sudo options for user
  file:
    path: "/etc/sudoers.d/{{ user_name }}"
    state: absent
  when: not user_sudoers
  loop: "{{ user_sudo_users | default([]) }}"
  loop_var: user_loop_var

- name: Generate private ssh key for user
  command: ssh-keygen -t rsa -f "{{ user_ssh_key_dir }}/{{ user_name }}/{{ user_name }}_sshPrivateKey.pem" -N ""
  args:
    chdir: "{{ user_ssh_key_dir }}"
  register: user_private_key
  become: false
  run_once: true
  when: user_manage_ssh_key

- name: Generate public ssh key for user
  shell: cat "{{ user_ssh_key_dir }}/{{ user_name }}/{{ user_name }}_sshPrivateKey.pem.pub"
  register: user_public_key
  become: false
  run_once: true
  when: user_manage_ssh_key

- name: Convert ssh key to ppk for user
  command: ssh-keygen -o -f "{{ user_ssh_key_dir }}/{{ user_name }}/{{ user_name }}_sshPrivateKey.pem" -t rsa -p
  args:
    chdir: "{{ user_ssh_key_dir }}"
  register: user_ppk_key
  become: false
  run_once: true
  when: user_manage_ssh_key

- name: Get or set the home directory for user
  shell: getent passwd "{{ user_name }}" | cut -d: -f6
  register: user_home_dir
  when: not user_home_dir
  changed_when: false
  register: user_home_dir_fact
  vars:
    user_home_base: "{{ user_home_dir.stdout | default('/home') }}"

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: 0700
    owner: "{{ user_name }}"
    group: "{{ user_group | default('users') }}"
  when: user_manage_ssh_key or user_private_keys

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user_name }}"
    state: present
    key: "{{ item }}"
  loop: "{{ user_authorized_keys | default([]) }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user_name }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ user_unauthorized_keys | default([]) }}"

- name: Copy generated private ssh key for user
  copy:
    src: "{{ user_ssh_key_dir }}/{{ user_name }}/{{ user_name }}_sshPrivateKey.pem"
    dest: "{{ user_home }}/.ssh/"
    remote_src: yes
  when: user_copy_private_key

- name: Check users password valid time
  shell: awk -F: '{print $7}' /etc/shadow | cut -d ')' -f1
  register: user_password_time
  when: user_password_time

- name: Set users password valid time
  user:
    name: "{{ user_name }}"
    password: "{{ user_password | password_hash('sha512') }}"
  when: user_password_time

- name: Place private key file for user
  copy:
    src: "{{ user_private_key_file | default('') }}"
    dest: "{{ user_ssh_key_dir }}/{{ user_name }}/"
    remote_src: yes
  when: user_private_keys


