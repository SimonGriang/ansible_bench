---
- name: Migrate from adoptopenjdk to temurin if selected
  set_fact:
    java_jdk_vendor: "temurin"
  when:
    - ansible_facts.java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_distribution }}/{{ ansible_distribution_major_version }}.yml"

- name: Gather architecture specific variables
  include_vars:
    file: architecture.yml

- name: Set OS specific variables (I)
  set_fact:
    java_open_jdk_version: "{{ java_open_jdk_version | default('8') }}"
    java_open_jdk_repository: "{{ java_open_jdk_repository | default('') }}"
    java_open_jdk_repositories: "{{ java_open_jdk_repositories | default([]) }}"
    java_open_jdk_gpgkey: "{{ java_open_jdk_gpgkey | default('') }}"
    java_required_libs: "{{ java_required_libs | default([]) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/java-{{ java_open_jdk_version }}-openjdk') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-{{ java_open_jdk_version }}-jdk') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home_dir }}"

- name: Remove deprecated repositories (Debian)
  apt_repository:
    state: absent
    repo: "deb https://adoptopenjdk.java.net/{{ java_jdk_vendor }}/jdk{{ java_open_jdk_version }}/debian/"
  when:
    - ansible_distribution in ["debian", "ubuntu"]

- name: Install extra apt tools (Debian)
  apt:
    name: "{{ java_open_jdk_apt_extra_packages | default([]) }}"
    state: present
  when:
    - ansible_distribution in ["debian", "ubuntu"]

- name: Add required key repositories (Debian)
  apt_key:
    keyserver: keyserver.ubuntu.com
    key: "{{ item }}"
  loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
  when:
    - ansible_distribution in ["debian", "ubuntu"]

- name: Add required repositories (Debian)
  apt_repository:
    repo: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ java_required_repositories_openjdk | default([]) }}"
  when:
    - ansible_distribution in ["debian", "ubuntu"]

- name: Add required key repositories (RedHat)
  rpm_key:
    keyserver: keyserver.ubuntu.com
    key: "{{ item }}"
  loop: "{{ java_required_key_repositories_openjdk | default([]) }}"
  when:
    - ansible_distribution in ["centos", "ol"]

- name: Add required repositories (RedHat)
  yum_repository:
    name: "{{ item }}"
    description: "OpenJDK {{ item }} repository"
    baseurl: "{{ item }}"
    state: present
  loop: "{{ java_required_repositories_openjdk | default([]) }}"
  when:
    - ansible_distribution in ["centos", "ol"]

- name: Install required libs
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_libs | default([]) }}"
  when:
    - ansible_distribution in ["debian", "ubuntu"]
  ignore_errors: yes

- name: Install Java (Debian)
  apt:
    name: "{{ java_open_jdk_package }}={{ java_open_jdk_version }}"
    state: present
  when:
    - ansible_distribution in ["debian", "ubuntu"]

- name: Install Java (RedHat)
  yum:
    name: "{{ java_open_jdk_package }}-{{ java_open_jdk_version }}"
    state: present
  when:
    - ansible_distribution in ["centos", "ol"]

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh

- name: Source environment variables
  shell: source /etc/profile

- name: Correct java version selected (Debian, Java < 11)
  command: /usr/sbin/alternatives --install
  args:
    - --install
    - /usr/bin/java
    - java
    - "{{ java_open_jdk_home_dir }}/bin/java"
    - 1000
  when:
    - ansible_distribution in ["debian", "ubuntu"]
    - java_open_jdk_version|int < 11

- name: Correct java version selected (Debian, Java >= 11)
  command: /usr/sbin/alternatives --install
  args:
    - --install
    - /usr/bin/java
    - java
    - "{{ java_open_jdk_home_dir }}/bin/java"
    - 1000
  when:
    - ansible_distribution in ["debian", "ubuntu"]
    - java_open_jdk_version|int >= 11 62%|██████▏   | 62/100 [2:18:56<1:09:58, 110.49s/it]

