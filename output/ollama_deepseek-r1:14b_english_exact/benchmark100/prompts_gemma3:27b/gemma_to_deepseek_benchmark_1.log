ord }}\\\\s*$\'\n    insertafter: EOF\n  when: "{{ grub_efi.stat.exists | bool }}"\n  notify: Update grub\n\n- name: Add --unrestricted flag to grub configuration\n  replace:\n    path: "{{ item }}"\n    regex: \'(^{{ grub_user }}\\s+ CLASS=)\'\n    replacement: \'\\1--unrestricted\'\n    flags: \'m\'\n  loop: "{{ grub_password_unrestricted_files }}"\n  when: "{{ grub_password_unrestricted | bool }}"\n  notify: Update grub' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-20T21:21:01.616385283Z', 'done': True, 'done_reason': 'stop', 'total_duration': 142549698554, 'load_duration': 90049039, 'prompt_eval_count': 1292, 'prompt_eval_duration': 52594253, 'eval_count': 7322, 'eval_duration': 142405830101, 'model_name': 'deepseek-r1:14b'} id='run--9fe4fdc6-0da2-49ef-b796-8b6f8b95b80f-0' usage_metadata={'input_tokens': 1292, 'output_tokens': 7322, 'total_tokens': 8614} 11%|█         | 11/100 [28:07<4:21:42, 176.43s/it]
