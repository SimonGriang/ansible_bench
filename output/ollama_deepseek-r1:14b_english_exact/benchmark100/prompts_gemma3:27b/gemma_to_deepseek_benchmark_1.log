---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_distribution_major_version: "{{ ansible_os_family_version }}"
  when:
    - bootstrap_facts.rc == 0
    - not ansible_facts.bootstrap_distribution
    - ansible_os_family_version is defined
  loop: "{{ bootstrap_os_family_map }}"
  vars:
    ansible_os_family_version: "{{ lookup('ansible_community.general.apt_version', '/etc/os-release') }}"
  condition: "bootstrap_facts.rc == 0 and not ansible_facts.bootstrap_distribution and bootstrap_search in item.value"

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map.items() }}"
  when:
    - ansible_facts.bootstrap_distribution is defined
    - ansible_facts.bootstrap_distribution in item.value
  loop_control:
    label: "{{ item.key }}"


