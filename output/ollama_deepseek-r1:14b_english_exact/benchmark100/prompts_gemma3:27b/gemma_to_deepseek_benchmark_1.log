- name: Check for python3.11 EXTERNALLY-MANAGED file existence
  stat:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
  register: externally_managed_file_py311

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  command: mv
          /usr/lib/python3.11/EXTERNALLY-MANAGED
          /usr/lib/python3.11/EXTERNALLY-MANAGED.old
  args:
    creates: /usr/lib/python3.11/EXTERNALLY-MANAGED.old
  when: |
    externally_managed_file_py311.stat.exists

- name: Check for python3.12 EXTERNALLY-MANAGED file existence
  stat:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
  register: externally_managed_file_py312

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  command: mv
          /usr/lib/python3.12/EXTERNALLY-MANAGED
          /usr/lib/python3.12/EXTERNALLY-MANAGED.old
  args:
    creates: /usr/lib/python3.12/EXTERNALLY-MANAGED.old
  when: |
    externally_managed_file_py312.stat.exists

- name: Import assert tasks
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install python pip
  pip:
    packages: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  ini_file:
    path: /etc/pip.conf
    section: global
    key: index-url
    value: "{{ python_pip_proxy }}"
  when: |
    python_pip_proxy is defined

- name: Configure trusted hosts
  ini_file:
    path: /etc/pip.conf
    section: global
    key: trusted-host
    value: "{{ python_pip_trusted_host }}"
  when: |
    python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    version: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
  when: |
    ansible_distribution not in ['bookworm', 'noble']
    and ansible_distribution_family != 'alpine'

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default('latest') }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ python_pip_modules }}"
  when: |
    ansible_distribution not in ['bookworm', 'noble']
    and ansible_distribution_family != 'alpine'
  label: "Installing pip module {{ item.name }}"



