- name: Create directories
  loop: httpd_directories
  loop_var: directory
  file:
    path: "{{ directory }}"
    state: directory
    mode: '0755'

- name: Configure directories
  loop: httpd_directories
  loop_var: directory_name
  template:
    src: directory.conf.j2
    dest: "{{ httpd_config_directory }}/{{ directory_name | basename }}.conf"
    mode: '0644'
  notify:
    - Test httpd configuration validity
    - Restart httpd
