if we need to do a etcd restore from s3\n  set_fact:\n    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file is defined and\n      rke2_etcd_snapshot_s3_options is defined }}"\n  when: rke2_etcd_snapshot_file is defined and\n        rke2_etcd_snapshot_s3_options is defined\n\n- name: Restore etcd from file\n  shell: >\n    mkdir -p /var/lib/rke2/etcd &&\n    cp /etc/rancher/rke2/{{ rke2_etcd_snapshot_file }} /var/lib/rke2/etcd/etcd-snapshot &&\n    rke2 server --config=/etc/rancher/rke2/config.yaml --snapshot=/var/lib/rke2/etcd/etcd-snapshot\n  when: rke2_etcd_snapshot_file is defined\n\n- name: Restore etcd from s3\n  shell: >\n    rke2 server --config=/etc/rancher/rke2/config.yaml --snapshot-s3-bucket="{{ rke2_etcd_snapshot_s3_bucket }}"\n      --snapshot-s3-prefix="{{ rke2_etcd_snapshot_s3_prefix }}" --snapshot-s3-aws-region="{{ rke2_etcd_snapshot_s3_aws_region }}"\n      --snapshot-s3-access-key="{{ rke2_etcd_snapshot_s3_access_key }}" --snapshot-s3-secret-key="{{ rke2_etcd_snapshot_s3_secret_key }}"\n  when: rke2_etcd_snapshot_s3_options is defined\n\n- name: Start RKE2 service on the first server\n  service:\n    name: rke2-server.service\n    state: started\n    enabled: true\n  environment:\n    RKE2_TOKEN: "{{ rke2_token }}"\n  notify: Service (re)started\n\n- name: Mask RKE2 agent service on the first server\n  service:\n    name: rke2-agent.service\n    mask: true\n    enabled: false\n\n- name: Wait for the first server be ready - no CNI\n  wait_for_command:\n    command: kubectl get pods -n kube-system\n    timeout: 600\n    state: started\n  when: not rke2_cni_plugin\n\n- name: Wait for the first server be ready - with CNI\n  wait_for_command:\n    command: kubectl get nodes --output=jsonpath=\'{range .items[*]}{.status.conditions[-1].type}{", "}{.status.conditions[-1].status}{", "}{.metadata.name}{", "}\\n\'\n    search_string: "Ready, True, "\n    timeout: 600\n    state: started\n  when: rke2_cni_plugin\n\n- name: Restore etcd\n  shell: |\n    kubectl get nodes -n cattle-system -o json | jq -r \'.items[].status.addresses[] | select(.type == "ExternalIP") | .address\' | tr \'\\n\' \' \' &&\n    kubectl get nodes -n cattle-system -o json | jq -r \'.items[].metadata.name\' | tr \'\\n\' \' \' &&\n    kubectl delete secret -n cattle-system --all || true &&\n    kubectl delete node --all || true\n  when: do_etcd_restore\n\n- name: Set an Active Server variable\n  set_fact:\n    active_server: "{{ ansible_hostname }}"\n  delegate_to: all\n  when: rke2_cluster_group_name is defined\n  run_once: true\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-20T23:30:14.028914253Z', 'done': True, 'done_reason': 'stop', 'total_duration': 32849846349, 'load_duration': 94972801, 'prompt_eval_count': 2472, 'prompt_eval_duration': 356709009, 'eval_count': 1721, 'eval_duration': 32396441591, 'model_name': 'deepseek-r1:14b'} id='run--b03d3959-496f-488f-a15f-52ab15e7acb4-0' usage_metadata={'input_tokens': 2472, 'output_tokens': 1721, 'total_tokens': 4193}
