---
- name: Ensure the easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Initialize the easy-rsa PKI
  command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: false
  changed_when: false
  register: init_pki
  until: init_pki is not None
  retries: 3

- name: Build the Certificate Authority (CA)
  command: easyrsa build-ca nopass
  environment:
    EASYRSA_BATCH: yes
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: false
  changed_when: false
  register: build_ca
  until: build_ca is not None
  retries: 3

- name: Generate Diffie-Hellman parameters
  command: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: false
  changed_when: false
  register: gen_dh
  until: gen_dh is not None
  retries: 3

- name: Build the server certificate
  command: easyrsa build-server-full server nopass
  environment:
    EASYRSA_BATCH: yes
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: false
  changed_when: false
  register: build_server
  until: build_server is not None
  retries: 3

- name: Build the client certificate
  command: easyrsa build-client-full client nopass
  environment:
    EASYRSA_BATCH: yes
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: false
  changed_when: false
  register: build_client
  until: build_client is not None
  retries: 3

- name: Generate the Certificate Revocation List (CRL)
  command: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  ignore_errors: false
  changed_when: false
  register: gen_crl
  until: gen_crl is not None
  retries: 3

- name: Generate TLS authentication key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  ignore_errors: false
  changed_when: false
  register: gen_ta
  until: gen_ta is not None
  retries: 3

- name: Copy PKI files to the server configuration directory
  copy:
    remote_src: false
    src: /etc/openvpn/easy-rsa/pki/{ca.crt,dh.pem,ta.key,client.crt,server.crt,ca.key,client.key,server.key}
    dest: /etc/openvpn/server
    mode: 0640

- name: Copy ca.crt and ta.key to /etc/openvpn
  copy:
    remote_src: false
    src: /etc/openvpn/easy-rsa/pki/{ca.crt,ta.key}
    dest: /etc/openvpn
    mode: 0640

- name: Place the server configuration file
  template:
    src: server.conf.j2
    dest: "{{ openvpn_configuration_directory }}/server.conf"
    mode: 0640
    owner: root
    group: openvpn
  notify: Restart openvpn


