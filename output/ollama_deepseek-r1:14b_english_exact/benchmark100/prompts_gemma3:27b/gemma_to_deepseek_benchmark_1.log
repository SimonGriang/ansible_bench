---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  args:
    host: localhost

- name: Configure apk
  apk:
    update_cache: true
    upgrade: true
  notify: Reboot
  when: ansible_pkg_mgr == 'apk'

- name: Configure apt
  apt:
    cache_valid_time: 3600
    update_cache: true
    upgrade: true
    exclude_packages: "{{ update_excluded_packages | default([]) | list }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'apt'

- name: Update all software (dnf)
  dnf:
    update: true
    exclude: "{{ update_excluded_packages | default([]) | list }}"
  notify: Reboot
  when: ansible_pkg_mgr in ['dnf', 'dnf5']

- name: Update all software (pacman)
  pacman:
    sync: true
  notify: Reboot
  when: ansible_pkg_mgr == 'pacman'

- name: Configure yum
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ update_excluded_packages | default([]) | list }}"
  notify: Reboot
  when: ansible_pkg_mgr == 'yum' and ansible_yum_version != '6'

- name: Update all software (zypper)
  zypper:
    update: true
  notify: Reboot
  when: ansible_pkg_mgr == 'zypper'

