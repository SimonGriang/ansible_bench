---
- name: Assert systemd as init system
  ansible.builtin.systemd:
    state: started
  register: is_systemd
  failed_when: "{{ is_systemd }}" != "ok"
  msg: "Systemd is not the init system. Playbook execution halted."
  ignore_errors: yes

- name: Get latest release
  ansible.builtin.uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    method: GET
    headers:
      Authorization: "Bearer {{ GH_TOKEN | default('') }}" 
      if: "GH_USER" is defined
    retries: 5
    until: "status == 200"
    register: _latest_release

- name: Set promtail version to {{ _latest_release.json.tag_name[1:] }}
  ansible.builtin.set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] | default('latest_version_error') }}"
  when: promtail_version == "latest"

- name: Test if zip local archive exists
  ansible.builtin.file:
    path: "{{ promtail_binary_local_dir }}"
    state: directory
    get_checksum: no
  register: promtail_binary_local_archive

- name: Assert local binary exists
  ansible.builtin.assert:
    that: promtail_binary_local_archive.stat.exists == True
  when: promtail_binary_local_dir is defined
  msg: "Local promtail binary archive does not exist. Playbook execution halted."
  ignore_errors: yes

- name: Get checksum list
  ansible.builtin.uri:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/SHA256SUMS"
    method: GET
    register: __promtail_checksums

- name: Get checksum for {{ go_arch }} architecture
  ansible.builtin.shell:
    cmd: "grep '{{ go_arch }}' {{ __promtail_checksums.content | regex_replace('\n', ' ') | regex_replace('  ', ' ') | regex_replace('  ', ' ') }}"
    register: checksum_result
    when: promtail_binary_local_dir is not defined
  ansible.builtin.set_fact:
    __promtail_checksum: "{{ checksum_result.stdout.split()[0] | default('checksum_error') }}"


