- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user_name }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ user_unauthorized_keys | default([]) }}"

- name: Copy generated private ssh key for user
  copy:
    src: "{{ user_ssh_key_dir }}/{{ user_name }}/{{ user_name }}_sshPrivateKey.pem"
