---
- name: Check if the Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command:
    cmd: helm version
    changed_when: false
    failed_when: false
  register: helm_existing_version

- name: Download helm
  unarchive:
    remote_src: true
    url: "{{ helm_download_url }}"
    dest: /tmp
    filename: "{{ helm_repo_path }}-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}"
  when:
    - not helm_check.stat.exists
    - helm_existing_version.stdout.version != helm_version
  register: helm_download

- name: Copy helm binary into place
  copy:
    remote_src: true
    src: /tmp/
      "{{ helm_repo_path }}-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}"
    dest: "{{ helm_bin_path }}"
    mode: 0755
  when: helm_download.changed

