---
- name: Import assert.yml
  include_tasks: assert.yml
  vars:
    ansible_host: localhost

- name: Install mysql
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_packages | list }}"

- name: Configure mysql server
  template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: 0640
  loop: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: 0640
  loop: "{{ mysql_configuration_options }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: (ansible_distribution in ['Alpine', 'Archlinux'])

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    target: "{{ item.target }}"
    encoding: "{{ item.encoding }}"
    collation: "{{ item.collation }}"
    login_host: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"

- name: List databases
  mysql_info:
    query: "SHOW DATABASES;"
  register: db_list
  ignore_errors: yes
  become: yes
  become_user: root

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ import_target }}"
    login_host: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases | selectattr('import_target') | list }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    login_host: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users | list }}"

- name: Flush handlers again
  meta: flush_handlers


