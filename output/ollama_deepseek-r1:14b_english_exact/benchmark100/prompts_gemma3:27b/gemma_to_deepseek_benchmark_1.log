---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  when: run_once

- name: Install required software
  apt:
    name: "{{ users_requirements }}"
    state: present
    update_cache: yes
  when: users_requirements is defined

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups | default([]) }}"
  loop_control:
    loop_var: group
    label: "{{ group.name }}"
  when: users_groups is defined

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "Defaults    env_keep += /etc/sudoers.d"
    state: present
    validate_mode: yes
  when: users_sudo_includedir is defined

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users | default([]) }}"
  loop_control:
    loop_var: user
    label: "{{ user.name }}"
  when: users is defined

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: '0644'
  when: users_cron_allow

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


