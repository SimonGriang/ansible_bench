---
- name: Load OS-specific variables
  include_vars:
    dir: "{{ lookup('first_found', ['vars/os/{{ansible_distribution}}.yml',
      'vars/os/{{ansible_os_family}}.yml', 'vars/os/main.yml']) }}"

- name: Include RedHat setup tasks
  include_tasks: redhat.yml
  when:
    ansible_facts:
      os_family: RedHat

- name: Include Debian setup tasks
  include_tasks: debian.yml
  when:
    ansible_facts:
      os_family: Debian

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state | default('present') }}"
  notify: restart docker
  ignore_errors: true
  when:
    (ansible_version < "2.12") or
    (ansible_facts.os_family in ['RedHat', 'Debian'])

- name: Install Docker packages (with downgrade option)
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state | default('present') }}"
    version: "{{ docker_packages_version | default('') }}"
  notify: restart docker
  ignore_errors: true
  when:
    (ansible_version >= "2.12") and
    (ansible_facts.os_family in ['RedHat', 'Debian'])

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state | default('present') }}"
  notify: restart docker
  ignore_errors: true
  when:
    docker_install_compose_plugin and
    (ansible_version < "2.12" or ansible_facts.os_family not in ['RedHat', 'Debian'])

- name: Install docker-compose-plugin (with downgrade option)
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state | default('present') }}"
    version: "{{ docker_compose_package_version | default('') }}"
  notify: restart docker
  ignore_errors: true
  when:
    docker_install_compose_plugin and
    (ansible_version >= "2.12") and
    (ansible_facts.os_family in ['RedHat', 'Debian'])

- name: Ensure /etc/docker/ directory exists
  file:
    path: /etc/docker
    state: directory
    mode: 0755
  when: (docker_daemon_options | default({}) | length) > 0

- name: Configure Docker daemon options
  copy:
    remote_src: true
    src: "{{ lookup('template', 'config/daemon.json.j2') }}"
    dest: /etc/docker/daemon.json
    mode: 0644
  notify: restart docker
  when: (docker_daemon_options | default({}) | length) > 0

- name: Ensure Docker is started and enabled at boot
  service:
    name: docker
    state: "{{ docker_service_state | default('started') }}"
    enabled: "{{ docker_service_enabled | default('yes') }}"
  ignore_errors: true

- name: Flush handlers to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group info using getent
  getent:
    group: docker
  register: docker_group_info

- name: Check if there are any users to add to the docker group
  set_fact:
    at_least_one_user_to_modify: "{{ (docker_users | default([]) | difference(docker_group_info.members)) | list | length > 0 }}"

- name: Include docker-users tasks
  include_tasks: docker-users.yml
  when: at_least_one_user_to_modify
