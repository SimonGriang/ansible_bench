---
- name: Check for EFI directory
  stat:
    path: /sys/firmware/efi/efivars/
  register: grub_efi

- name: Remove existing grub.cfg on EFI systems
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: grub_efi.stat.exists

- name: Install user template for grub
  template:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    owner: root
    group: root
    mode: 0700
  notify: Update grub

- name: Add password to grub configuration on EFI systems
  lineinfile:
    path: /etc/grub2-efi.cfg
    line: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"
    state: present
    create: yes
    regexp: '^\\s*password_pbkdf2\\s{{ grub_user }}\\s{{ grub_password }}\\s*$'
    insertafter: EOF
  when: grub_efi.stat.exists
  notify: Update grub

- name: Add password to grub configuration on MBR systems
  lineinfile:
    path: /etc/grub2.cfg
    line: "password_pbkdf2 {{ grub_user }} {{ grub_password }}"
    state: present
    create: yes
    regexp: '^\\s*password_pbkdf2\\s{{ grub_user }}\\s{{ grub_password }}\\s*$'
    insertafter: EOF
  when: grub_efi.stat.exists
  notify: Update grub

- name: Add --unrestricted flag to grub configuration
  replace:
    path: "{{ item }}"
    regex: '(^{{ grub_user }}\s+ CLASS=)'
    replacement: '\1--unrestricted'
    flags: 'm'
  loop: "{{ grub_password_unrestricted_files }}"
  when: grub_password_unrestricted
  notify: Update grub


