uration': 109246050993, 'model_name': 'deepseek-r1:14b'} id='run--fe3f0c99-010d-443f-a80f-963d8506cfcf-0' usage_metadata={'input_tokens': 1531, 'output_tokens': 5538, 'total_tokens': 7069}
