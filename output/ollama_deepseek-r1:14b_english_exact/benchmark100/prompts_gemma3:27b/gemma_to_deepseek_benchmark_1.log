e.builtin.ini_file:\n    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo\n    section: docker-{{ docker_edition }}-test\n    key: enabled\n    value: "{{ docker_yum_repo_enable_test }}"\n  when: docker_add_repo\n\n- name: Configure containerd on RHEL 8\n  when: ansible_facts.distribution_major_version == 8\n  block:\n    - name: Ensure runc is uninstalled\n      ansible.builtin.dnf:\n        name: runc\n        state: absent\n\n    - name: Ensure container-selinux is installed\n      ansible.builtin.dnf:\n        name: container-selinux\n        state: present\n\n    - name: Ensure containerd.io is installed\n      ansible.builtin.dnf:\n        name: containerd.io\n        state: present\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-20T21:34:58.865107884Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12167809418, 'load_duration': 101373090, 'prompt_eval_count': 1171, 'prompt_eval_duration': 560192935, 'eval_count': 654, 'eval_duration': 11505325877, 'model_name': 'deepseek-r1:14b'} id='run--07148f6c-93ac-400e-a40e-6eb3a830af17-0' usage_metadata={'input_tokens': 1171, 'output_tokens': 654, 'total_tokens': 1825}
