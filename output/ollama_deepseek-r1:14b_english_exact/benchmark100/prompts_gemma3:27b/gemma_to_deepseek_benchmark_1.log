---
- import_tasks: assert.yml
  hosts: localhost

- name: Install apache httpd
  apt:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  when: ansible_selinux.selinux_enabled
  become: yes
  become_user: root
  shell: "{{ item.value | join(' ') }}"
  with_items:
    - httpd_sebooleans
  register: selinux_result

  when: ansible_selinux.selinux_enabled
  become: yes
  become_user: root
  shell: semanage port -a -t httpd_port_t {{ httpd_port }}
  register: selinux_port_result

  when: ansible_selinux.selinux_enabled
  become: yes
  become_user: root
  shell: semanage port -a -t httpd_port_t {{ httpd_ssl_port }}
  register: selinux_ssl_port_result

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify: test_httpd_config

- name: Activate httpd modules
  when:ansible_osfamily == 'Debian'
  a2enmod:
    name: "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command }}"

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  when:ansible_osfamily in ['Debian','Suse']
  copy:
    src: httpd_ports_conf.j2
    dest: "{{ httpd_server_root }}/httpd_ports_conf"
    mode: 0644
  notify: test_httpd_config

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  systemctl:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


