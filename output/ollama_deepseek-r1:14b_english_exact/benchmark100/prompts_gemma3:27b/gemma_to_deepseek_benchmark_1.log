---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  copy:
    remote_src: true
    src: /path/to/template
    dest: /etc/rancher/rke2/config.yaml
    owner: rancher
    group: rancher
  notify: Config file changed

- name: Copy kubelet config
  copy:
    remote_src: true
    src: /path/to/template
    dest: /etc/rancher/rke2/kubelet.yaml
    owner: rancher
    group: rancher
  notify: Config file changed
  when: rke2_kubelet_config|length > 0

- name: Copy Containerd Registry Configuration file
  copy:
    remote_src: true
    src: /path/to/template
    dest: /etc/rancher/rke2/registries.yaml
    owner: rancher
    group: rancher
  notify: Config file changed
  when: rke2_custom_registry_mirrors|length > 0 or
        rke2_custom_registry_configs|length > 0

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and
      (rke2_server.service not defined or rke2_server.service.enabled == false) }}"
  when: rke2_etcd_snapshot_file is defined

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file is defined and
      rke2_etcd_snapshot_s3_options is defined }}"
  when: rke2_etcd_snapshot_file is defined and
        rke2_etcd_snapshot_s3_options is defined

- name: Restore etcd from file
  shell: >
    mkdir -p /var/lib/rke2/etcd && cp /etc/rancher/rke2/{{ rke2_etcd_snapshot_file }} /var/lib/rke2/etcd/etcd-snapshot && rke2 server --config=/etc/rancher/rke2/config.yaml --snapshot=/var/lib/rke2/etcd/etcd-snapshot
  when: rke2_etcd_snapshot_file is defined

- name: Restore etcd from s3
  shell: >
    rke2 server --config=/etc/rancher/rke2/config.yaml --snapshot-s3-bucket="{{ rke2_etcd_snapshot_s3_bucket }}" --snapshot-s3-prefix="{{ rke2_etcd_snapshot_s3_prefix }}" --snapshot-s3-aws-region="{{ rke2_etcd_snapshot_s3_aws_region }}" --snapshot-s3-access-key="{{ rke2_etcd_snapshot_s3_access_key }}" --snapshot-s3-secret-key="{{ rke2_etcd_snapshot_s3_secret_key }}"
  when: rke2_etcd_snapshot_s3_options is defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server.service
    state: started
    enabled: true
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent.service
    mask: true
    enabled: false

- name: Wait for the first server be ready - no CNI
  wait_for_command:
    command: kubectl get pods -n kube-system
    timeout: 600
    state: started
  when: not rke2_cni_plugin

- name: Wait for the first server be ready - with CNI
  wait_for_command:
    command: kubectl get nodes --output=jsonpath='{range .items[*]}{.status.conditions[-1].type}{", "}{.status.conditions[-1].status}{", "}{.metadata.name}{", "}\n'
    search_string: "Ready, True, "
    timeout: 600
    state: started
  when: rke2_cni_plugin

- name: Restore etcd
  shell: >
    kubectl get nodes -n cattle-system -o json | jq -r '.items[].status.addresses[] | select(.type == "ExternalIP") | .address' | tr '\n' ' ' && kubectl get nodes -n cattle-system -o json | jq -r '.items[].metadata.name' | tr '\n' ' ' && kubectl delete secret -n cattle-system --all || true && kubectl delete node --all || true
  when: do_etcd_restore

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ ansible_hostname }}"
  delegate_to: all
  when: rke2_cluster_group_name is defined
  run_once: true


