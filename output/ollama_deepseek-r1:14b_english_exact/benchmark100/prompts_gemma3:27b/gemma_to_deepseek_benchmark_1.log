---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for_port:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'docker'
    - bootstrap_wait_for_host

- name: Prepare system
  raw: |
    echo "test sudo access" | sudo tee /dev/null
  become: true
  ignore_errors: true

- name: Rescue - Gather facts
  gather_facts: true
  become: false
  when:
    - "{{ ansible_failed | default(0) | int }}" > 0

- name: Rescue - Install bootstrap packages via raw
  raw: |
    dnf install -y --alloweraspects=downloadonly
  become: false
  when:
    - "{{ ansible_failed | default(0) | int }}" > 0

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
  when:
    - "{{ bootstrap_facts_packages | length }}" > 0
  become: "{{ bootstrap_become }}"


