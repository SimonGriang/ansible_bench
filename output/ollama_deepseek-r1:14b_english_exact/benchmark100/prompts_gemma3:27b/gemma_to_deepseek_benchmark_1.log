ks use the exact names and modules specified, without adding or omitting any. Variables like cadvisor_version and others should be correctly templated.\n\nFinally, I\'ll structure the playbook in YAML, ensuring proper indentation and syntax. Each task is placed under the tasks list, and the entire playbook starts with \'---\' as required.\n</think>\n\n```yaml\n---\n- name: create directories\n  file:\n    path: /opt/cadvisor\n    state: directory\n    mode: 0755\n\n- name: download cadvisor\n  get_url:\n    url: "{{ cadvisor_download }}"\n    dest: /opt/cadvisor/cadvisor-{{ cadvisor_version }}\n    mode: 0755\n    sha256: "{{ cadvisor_checksum }}"\n  when: cadvisor_binary_local_dir == ""\n\n- name: propagate locally distributed cadvisor binary\n  copy:\n    src: "{{ cadvisor_binary_local_dir }}/cadvisor-{{ cadvisor_version }}"\n    dest: /opt/cadvisor/cadvisor-{{ cadvisor_version }}\n    mode: 0755\n    owner: root\n    group: root\n  notify: restart cadvisor\n  when: cadvisor_binary_local_dir != ""\n\n- name: symlink cadvisor\n  ln:\n    src: /opt/cadvisor/cadvisor-{{ cadvisor_version }}\n    dest: /opt/cadvisor/cadvisor\n    state: symlink\n    force: yes\n\n- name: server systemd service\n  template:\n    src: systemd-system-cadvisor-service.j2\n    dest: /etc/systemd/system/cadvisor.service\n    mode: 0644\n  notify: restart cadvisor\n\n- name: test_task\n  shell: systemctl status cadvisor | grep -q \'active\'\n    register: service_active\n    changed_when: false\n    ignore_errors: yes\n\n- name: debug\n  debug:\n    var: service_active\n\n- name: cadvisor | enable server systemd\n  systemd:\n    name: cadvisor.service\n    state: enabled\n\n- name: cadvisor | start server systemd\n  systemd:\n    name: cadvisor.service\n    state: started\n    enabled: yes\n    daemon_reload: yes\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-20T20:57:09.123624737Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15800