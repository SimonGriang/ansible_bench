---
- name: Check OS compatibility
  ansible.builtin.gather_facts:
    gather_subset: all
  when:
    - ansible_distribution is not None
    - ansible_distribution in ['amzn', 'redhat', 'centos', 'ol', 'SLC']
    - ansible_distribution_major_version in ['7', '8', '9']

- name: Install epel gpg key
  ansible.builtin.dnf:
    name: epel-gpg-key
    state: present
    repo: epel_gpg_key

- name: Install epel-release package
  ansible.builtin.dnf:
    name: epel-release
    state: present
    repo: epel_url
  notify: Update package cache

- name: Install epel-next-release package
  ansible.builtin.dnf:
    name: epel-next-release
    state: present
    repo: epel_next_url
  when: epel_next
  notify: Update package cache


