---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  host: localhost

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/mailname
    value: 'No configuration'

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
    notify: postfix_config_validation
  when: transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    notify: postfix_config_validation
  when: header_checks_template is defined

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_maincf_values: "{{ postfix_maincf_values | default({}) | combine({{ item.key: item.value }}) }}"
  loop: "{{ postfix_maincf_vars | default([]) }}"

- name: Setting values for maincf (2/2)
  set_fact:
    postfix_maincf_values: "{{ postfix_maincf_values | default({}) | combine({{ item.key: item.value }}) }}"
  loop: "{{ postfix_maincf_vars | default([]) }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    notify: postfix_config_validation
  when: main_cf_template is defined

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    notify: postfix_config_validation
  when: master_cf_template is defined

- name: Creates cert/key directory
  file:
    path: /etc/postfix/tls
    state: directory
    create: true
  when: postfix_use_tls

- name: Deploy Postfix TLS server certificate
  copy:
    src: postfix.crt
    dest: /etc/postfix/tls/postfix.crt

- name: Deploy Postfix TLS server key
  copy:
    src: postfix.key
    dest: /etc/postfix/tls/postfix.key

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  shell: echo "{{ postfix_aliases }}" >> /etc/postfix/aliases
  when: postfix_aliases is defined

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
  when: sender_access_entries is defined

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
  when: recipient_access_entries is defined

- name: Place sasl_password_map
  template:
    src: sasl_password_map.j2
    dest: /etc/postfix/sasl_password_map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemctl:
    name: postfix
    state: started
    enabled: true

