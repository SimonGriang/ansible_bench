---
- name: Import assert.yml
  include_tasks: assert.yml
  remote_host: localhost
  remote_user: root

- name: Install apache httpd
  apt:
    name: "{{ httpd_packages }}"
    state: present
  become: yes

- name: Configure selinux
  selinux:
    state: "{{ selinux_enabled | default('permissive') }}"
    booleans:
      httpd_setenvif_on: True
      httpd_tftp_inetd: False
    ports:
      80: http
      443: https

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
  notify: 
    - Test httpd configuration validity
    - Restart httpd

- name: Activate httpd module | Debian
  shell: "{{ httpd_modules_to_activate_with_command }}"
  become: yes
  when: httpd_modules_to_activate_with_command is defined

- name: Import ssl.yml
  include_tasks: ssl.yml
  when: https_ssl_enable | default(false) | bool

- name: Import locations.yml
  include_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  include_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_server_root }}/ports.conf"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  when: ansible_distribution in ['debian', 'suse']

- name: Import directories.yml
  include_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  ansible.builtin.flush_handlers:

- name: Removing default html
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example | default(false) | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes
  become: yes


