---
- name: Check if all variables have been set correctly
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host to be reachable
  wait_for:
    host: "{{ ansible_ssh_host | default('ansible_host') | default('inventory_hostname') }}"
    port: 22
    state: started
    timeout: "{{ bootstrap_timeout | default('300') }}"
  become: true
  become_user: "{{ bootstrap_user | default('ansible_user') }}"
  when:
    - ansible_connection not in ["container", "docker"]
    - bootstrap_wait_for_host | default(true) | bool

- name: Prepare the system
  block:
    - name: Test connection
      wait_for_connection:
        host: "{{ ansible_ssh_host | default('ansible_host') | default('inventory_hostname') }}"
        port: 22
        timeout: "{{ bootstrap_timeout | default('300') }}"
        register: bootstrap_connect
        until: "'ansible connect success' in bootstrap_connect.msg"
        retries: 3
        delay: 10

    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml

- name: Install bootstrap packages
  raw:
    cmd: "{{ bootstrap_packages_cmd }}"
  register: bootstrap_install_packages
  user: "{{ bootstrap_user | default('ansible_user') }}"
  become: true
  become_user: "{{ bootstrap_user | default('ansible_user') }}"

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:
        gather_subset: '!passwords'

    - name: Install packages listed in bootstrap__facts_packages
      package:
        name: "{{ bootstrap__facts_packages | default([]) | list }}"
        state: present


