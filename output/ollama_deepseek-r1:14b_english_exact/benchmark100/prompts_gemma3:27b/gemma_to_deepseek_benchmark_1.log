---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  ansible.builtin.apt:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  ansible.builtin.template:
    src: grub_timeout.j2
    dest: /etc/default/grub
    mode: 420
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  ansible.builtin.template:
    src: grub_recordfail_timeout.j2
    dest: /etc/default/grub
    mode: 420
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  loop: "{{ grub_options }}"
  ansible.builtin.template:
    src: grub_options.j2
    dest: /etc/default/grub
    mode: 420
    validate_mode: true
  notify: Update grub
  when: grub_options | length > 0

- name: Import password.yml
  ansible.builtin.import_tasks: password.yml
  when: grub_set_password

- name: Flush handlers
  ansible.builtin.meta: flush_handlers


