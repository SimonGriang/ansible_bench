---
- name: Import assert.yml
  include_tasks:
    file: assert.yml
  vars:
    loop: false

- name: Install python pip
  ansible.builtin.package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  blockinfile:
    path: /etc/pip.conf
    mode: 0644
    block: |-
      [global]
      index-url = {{ python_pip_proxy }}
  when: python_pip_proxy is defined

- name: Trust hosts
  blockinfile:
    path: /etc/pip.conf
    mode: 0644
    block: |-
      [global]
      trusted-host = {{ python_pip_trusted_host }}
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    executable: "{{ python_pip_executable }}"
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
  when: ansible_system not in ['Debian Bookworm', 'Debian Noble', 'Alpine']

- name: Install requested modules
  pip:
    executable: "{{ python_pip_executable }}"
    name: "{{ item.name }}"
    version: "{{ item.version | default('latest') }}"
  loop: "{{ python_pip_modules }}"
  when: ansible_system not in ['Debian Bookworm', 'Debian Noble', 'Alpine']
  label: "{{ item.name }}"


