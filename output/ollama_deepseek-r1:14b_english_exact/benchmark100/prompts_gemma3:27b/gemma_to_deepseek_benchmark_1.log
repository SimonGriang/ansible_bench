---
- name: Gather bootstrap facts using raw command
  raw: cat /etc/os-release
  register: bootstrap_facts
  become: false
  gather_facts: false

- name: Set bootstrap facts (I) based on OS release information
  set_fact:
    bootstrap_distribution: "{{ item.value.os_name }}"
    bootstrap_distribution_major_version: "{{ lookup('ansible.utils.regex', 'match={{ansible_os-release.version|default(".*")}} pattern=(\d+)(?![\d.])', quiet=True) }}"
  loop: "{{ bootstrap_os_family_map | dict2list }}"
  when:
    - bootstrap_facts.rc == 0
    - not bootstrap_distribution
    - "{{ bootstrap_facts.stdout | regex_search(item.value.bootstrap_search) | bool }}"

- name: Set bootstrap facts (II) based on OS family
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2list }}"
  when: bootstrap_distribution in item.value.distributions
  loop_control:
    label: "{{ item.key }}"


