    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Download Vault binary
  get_url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"
    dest: "{{ vault_download_path }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"
  become: yes
  register: vault_download
  ignore_errors: yes

- name: Extract Vault binary
  become: yes
  archived_file:
    path: "{{ vault_download_path }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"
    dest: "{{ vault_download_path }}"

- name: Stat the vault_path
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exists
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  when:
    - ansible.builtin.bool(not vault_check_path.stat.exists)
    - ansible.builtin.bool("{{ vault_path }}" != "")

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.permission }}"
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.permission }}"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command: openssl req -x509 -newkey rsa:2048 -keyout tls.key -out tls.crt -days 365 -nodes -subj "/C=US/ST=Oregon/L=Portland/O=HashiCorp/OU=Vault/CN=localhost"
  chdir: "{{ vault_data_directory }}/tls/"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.permission }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: /usr/bin/vault
    remote_src: yes
  become: yes
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setcap:
    path: /usr/bin/vault
    cap: "ep ipc_lock"
    state: present

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0644
    preserve: yes
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Copy Vault service file
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    remote_src: yes
  become: yes
  notify: Daemon reload
  when: ansible_service_manager == 'systemd'

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    remote_src: yes
  become: yes
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


