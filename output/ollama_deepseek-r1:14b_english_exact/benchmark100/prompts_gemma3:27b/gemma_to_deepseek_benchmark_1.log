  ansible.builtin.template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "010160"
  loop: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  ansible.builtin.template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: "010160"
  loop: "{{ mysql_configuration_options }}"

- name: Initialize mysql
  ansible.builtin.command: "{{ mysql_initialize_command }}"
  when: (ansible_distribution in ['Alpine', 'Archlinux'])

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: "010160"

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    target: "{{ item.target }}"
    encoding: "{{ item.encoding }}"
    collation: "{{ item.collation }}"
    login_host: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"

- name: List databases
  community.mysql.mysql_info:
    query: "SHOW DATABASES;"
  register: db_list
  become: true
  become_user: root

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ import_target }}"
    login_host: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases | selectattr('import_target') | list }}"
  ignore_errors: true

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    login_host: "{{ mysql_socket }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users | list }}"
  become: true
  become_user: root

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


