---
- name: Create document root directories for virtual hosts
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  with_items: httpd_vhosts
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - item.create_docroot | default(true) | bool
  ignore_errors: yes

- name: Configure virtual hosts
  template:
    src: vhost_conf_template
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: 0644
  with_items: httpd_vhosts
  notify:
    - Test httpd configuration validity
    - Restart httpd


