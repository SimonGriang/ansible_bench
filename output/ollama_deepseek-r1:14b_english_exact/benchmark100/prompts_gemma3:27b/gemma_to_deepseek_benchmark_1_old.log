---
- name: gather bootstrap facts using raw command
  raw: python3 -c 'import platform; print(platform.system())'
  register: bootstrap_facts
  gather_facts: false
  become: false

- name: set bootstrap facts (I) based on OS release information
  set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: "{{ major_version }}"
  loop: "{{ bootstrap_os_family_map.keys() | list }}"
  when:
    - bootstrap_facts.rc == 0
    - not bootstrap_distribution
    - "{{ item }}" in bootstrap_facts.stdout_lines | regex_search(bootstrap_search)
  vars:
    major_version: "{{ bootstrap_facts.stdout_lines | regex_search('[0-9]+') }}"

- name: set bootstrap facts (II) based on OS family
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map.items() }}"
  when: "{{ item.value }}" contains bootstrap_distribution
  loop_control:
    label: "{{ item.key }}"


