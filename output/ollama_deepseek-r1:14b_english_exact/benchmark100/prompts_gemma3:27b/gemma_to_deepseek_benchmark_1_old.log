 the second error is clear about the missing newline, I'll focus on adding that.\n\nSo, to summarize, I'll:\n\n1. Ensure each task ends with a newline.\n2. Add an empty line at the end of the playbook after the last task.\n3. Verify that all 'when' conditions are correctly formatted.\n\nNow, I'll reconstruct the playbook with these fixes.\n</think>\n\n```yaml\n---\n\n- name: Update apt cache\n  ansible.builtin.apt:\n    update_cache: yes\n  when: ansible_pkg_mgr == 'apt'\n\n- name: Update dnf cache\n  ansible.builtin.dnf:\n    state: latest\n  when: ansible_pkg_mgr == 'dnf'\n\n- name: Install packages\n  ansible.builtin.apt:\n    name: keepalived\n    state: present\n  when: ansible_pkg_mgr == 'apt'\n  register: keepalived_installation\n\n- name: Install packages\n  ansible.builtin.dnf:\n    name: keepalived\n    state: present\n  when: ansible_pkg_mgr == 'dnf'\n  register: keepalived_installation\n\n- name: Create directory for keepalived\n  ansible.builtin.file:\n    path: /etc/keepalived\n    state: directory\n    owner: root\n    group: root\n    mode: 0o755\n\n- name: Create Kubernetes API health check script for Debian OS family\n  ansible.builtin.template:\n    src: check_apiserver.sh.j2\n    dest: /etc/keepalived/check_apiserver.sh\n    owner: root\n    group: root\n    mode: 0o755\n  notify: Restart keepalived\n  when: ansible_os_family == 'Debian'\n\n- name: Create Kubernetes API health check script for RedHat OS family\n  ansible.builtin.template:\n    src: check_apiserver.sh.j2\n    dest: /usr/libexec/keepalived/check_apiserver.sh\n    owner: root\n    group: root\n    mode: 0o755\n  notify: Restart keepalived\n  when: ansible_os_family == 'RedHat'\n\n- name: Create RKE2 Server health check script for Debian OS family\n  ansible.builtin.template:\n    src: check_rke2server.sh.j2\n    dest: /etc/keepalived/check_rke2server.sh\n    owner: root\n    group: root\n    mode: 0o755\n  notify: Restart keepalived\n  when: ansible_os_family == 'Debian'\n\n- name: Create RKE2 Server health check script for RedHat OS family\n  ansible.builtin.template:\n    src: check_rke2server.sh.j2\n    dest: /usr/libexec/keepalived/check_rke2server.sh\n    owner: root\n    group: root\n    mode: 0o755\n  notify: Restart keepalived\n  when: ansible_os_family == 'RedHat'\n\n- name: Create keepalived config file\n  ansible.builtin.template:\n    src: keepalived.conf.j2\n    dest: /etc/keepalived/keepalived.conf\n    owner: root\n    group: root\n    mode: 0o644\n  notify: Restart keepalived\n\n- name: Enable keepalived and make sure it is not masked\n  ansible.builtin.systemd:\n    name: keepalived\n    enabled: true\n    masked: false\n  notify: Restart keepalived\n\n- name: Flush handlers\n  ansible.builtin.meta:\n    flush_handlers: true\n\n```" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-11T02:40:11.374162987Z', 'done': True, 'done_reason': 'stop', 'total_duration': 31308199355, 'load_duration': 84543155, 'prompt_eval_count': 1623, 'prompt_eval_duration': 394516607, 'eval_count': 1740, 'eval_duration': 30827423066, 'model_name': 'deepseek-r1:14b'} id='run--32ffd440-98d2-4428-b3da-7244153f4aaa-0' usage_metadata={'input_tokens': 1623, 'output_tokens': 1740, 'total_tokens': 3363}
