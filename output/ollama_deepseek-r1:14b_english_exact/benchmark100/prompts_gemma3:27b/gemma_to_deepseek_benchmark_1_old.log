---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  yum:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when: ansible_selinux.status is defined and not containerized
  notify: Reboot

- name: Manage selinux booleans
  loop: "{{ selinux_booleans | default({}) | dict2list }}"
  selinux_bool:
    name: "{{ item.key }}"
    value: "{{ item.value | default('yes') }}"
    persistent: yes
  when: selinux_booleans | bool

