---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install system packages
  apt:
    name: "{{ openssl_requirements }}"
    state: present
    update_cache: yes
  become: yes

- name: Install Python packages
  pip:
    requirements: "{{ item }}"
    state: present
  become: yes
  when: openssl_pip_packages | length > 0
  loop: "{{ openssl_pip_packages }}"

- name: Create key directory
  file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: 700
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create csr directory
  file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: 755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create crt directory
  file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: 755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include create.yml
  import_tasks: create.yml
  when: openssl_items is defined and openssl_items | length > 0
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item
  with_name: name


