- include_tasks: tasks/keepalived.yml
  when:
    - rke2_ha_mode_enabled
    - ansible_hostname in rke2_servers_group_name
    - rke2_api_ip is defined

- include_tasks: tasks/rke2.yml

- include_tasks: tasks/cis.yml
  when:
    - rke2_cis_profile is defined
    - rke2_cis_profile | length > 0

- include_tasks: tasks/find_active_server.yml

- include_tasks: tasks/enable_ipvs.yml
  when:
    - rke2_kubevip_ipvs_lb_enable
    - ansible_hostname in rke2_servers_group_name
    - rke2_ha_mode_enabled
    - not rke2_keepalived_used

- include_tasks: tasks/kubevip.yml
  when:
    - rke2_ha_mode_enabled
    - rke2_kubevip_enable
    - not rke2_keepalived_used

- include_tasks: tasks/ingress-nginx.yml
  when:
    - rke2_ingress_nginx_values is defined
    - rke2_ingress_nginx_values | length > 0

- include_tasks: tasks/first_server.yml
  when:
    - ansible_hostname in rke2_servers_group_name
    - (rke2_active_server is not defined or rke2_active_server | length == 0)
    - (rke2_cluster_group_name | length == 1)

- include_tasks: tasks/first_server_restore.yml
  when:
    - rke2_active_server is defined
    - (ansible_hostname == rke2_active_server or ansible_hostname in rke2_servers_group_name | first)
    - (rke2_do_etcd_restore is defined or rke2_do_etcd_restore_from_s3 is defined)

- include_tasks: tasks/download_kubeconfig.yaml
  when:
    - rke2_download_kubeconf
    - ansible_hostname in rke2_servers_group_name
    - (rke2_cluster_group_name | length == 1)

- include_tasks: tasks/remaining_nodes.yml
  when:
    - rke2_active_server is defined
    - rke2_cluster_group_name | length > 1

- include_tasks: tasks/rolling_cordon_drain_restart_servers.yml
  when:
    - rke2_installed_version is defined
    - rke2_installed_version != rke2_version

- include_tasks: tasks/rolling_cordon_drain_restart_agents.yml
  when:
    - rke2_installed_version is defined
    - rke2_installed_version != rke2_version
    - ansible_hostname not in rke2_servers_group_name

- include_tasks: tasks/flush_handlers.yml

- include_tasks: tasks/rolling_restart.yml
  when:
    - rke2_restart_needed

- include_tasks: tasks/summary.yml

