---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_installer_url }}"
    dest: "{{ rke2_installer_path }}"
    mode: 0755
  when: not in_airgap | default

- name: Copy local RKE2 installation script
  copy:
    src: "{{ local_rke2_installer_path }}"
    dest: "{{ rke2_installer_path }}"
    mode: 0755
  when: in_airgap and implementation == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0755
  when: in_airgap and implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  tryckett:
    metadata: true
    tasks:
      - name: Try remote download
        get_url:
          url: "{{ rke2_artifacts_url }}"
          dest: "{{ rke2_artifacts_path }}/"
          mode: 0755
        register: remote_download_result
        ignore_errors: yes
      - name: Try local download and push
        copy:
          src: "{{ local_rke2_artifacts_path }}/"
          dest: "{{ rke2_artifacts_path }}/"
          mode: 0755
        when: remote_download_result|failed
  when: in_airgap

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ local_rke2_artifacts_path }}/"
    dest: "{{ rke2_artifacts_path }}/"
    mode: 0755
  when: in_airgap and implementation == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_artifacts_path }}/"
    mode: 0755
  loop: "{{ additional_rke2_images | default([]) }}"

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ item }}"
    state: file
    mode: "{{ item_permissions | default('0755') }}"
  loop: "{{ rke2_artifacts_files | default([]) }}"

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Check if separate partition
  shell: df /usr/local | grep '/usr/local' | awk '{print $6}' | grep -q '^/dev/'
  register: is_separate_partition
  changed_when: false

- name: Set RKE2 bin path
  shell: | 
    echo 'export PATH={{ rke2_bin_path }}:$PATH' >> /etc/profile

- name: Check RKE2 version
  shell: "{{ rke2_installer_path }}/rke2 --version"
  register: rke2_version

- name: Set RKE2 versions
  set_fact:
    rke2_version_installed: "{{ rke2_version.stdout | version }}"
    rke2_version_running: "{{ rke2_version.stdout | version }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "rke2_version_installed | float <= rke2_version_installed | float"
    fail_on_assert: yes

- name: Run RKE2 install script
  shell: "{{ rke2_installer_path }}/rke2 install --token {{ rke2_token }} {{ rke2_install_args }}"
  environment: "{{ rke2_env_vars }}"
  executable: /usr/bin/bash

- name: Copy Custom Manifests
  copy:
    src: "{{ custom_manifests_src }}"
    dest: "{{ rke2_data_dir }}/cluster/"
    mode: 0755

- name: Copy Static Pods
  copy:
    src: "{{ static_pods_src }}"
    dest: "{{ rke2_agent_dir }}/static-pods/"
    mode: 0755

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: "{{ rke2_env_dest }}"
    mode: 0755

