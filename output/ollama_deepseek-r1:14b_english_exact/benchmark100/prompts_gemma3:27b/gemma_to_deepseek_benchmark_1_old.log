---
- name: Check current docker-compose version
  command: docker-compose version
  register: docker_compose_vsn
  check_mode: false
  changed_when: false
  failed_when: false

- name: Set docker-compose current version fact
  set_fact:
    docker_compose_current_version: "{{ docker_compose_vsn.stdout | regex_replace('.*version.*v?([^ ]+).*', '\\1') | default('') }}"
  when: docker_compose_vsn.stdout is defined and docker_compose_vsn.stdout is not empty

- name: Delete existing docker-compose version if it's different
  file:
    path: "{{ docker_compose_path }}"
    state: absent
  when: docker_compose_current_version is not defined or docker_compose_current_version != "{{ docker_compose_version | regex_replace('^v', '') }}"

- name: Install Docker Compose (if configured)
  become: yes
  become_user: root
  block:
    - name: Download Docker Compose
      get_url:
        url: "{{ docker_compose_url }}"
        dest: "{{ docker_compose_path }}"
        mode: 0755
      when: docker_compose_current_version is not defined or docker_compose_current_version | version_compare_with {{ docker_compose_version | regex_replace('^v', '') }} == 'older'

    - name: Set executable permissions
      file:
        path: "{{ docker_compose_path }}"
        mode: 0755
        state: file


