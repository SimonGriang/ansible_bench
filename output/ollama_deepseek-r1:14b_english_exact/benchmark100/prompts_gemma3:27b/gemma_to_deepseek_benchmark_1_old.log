---
- name: Create ssl key
  ansible:
    module: community.crypto.openssl_privatekey
    path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    state: present
    mode: "0600"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ items }}"

- name: Create ssl csr
  ansible:
    module: community.crypto.openssl_csr
    path: "{{ openssl_csr_directory }}/{{ item.name }}.csr"
    key_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    common_name: "{{ item.common_name }}"
    state: present
    mode: "0640"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ items }}"

- name: Create ssl certificates
  ansible:
    module: community.crypto.x509_certificate
    path: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    csr_path: "{{ openssl_csr_directory }}/{{ item.name }}.csr"
    state: present
    mode: "0640"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ items }}"

- name: Create PKCS#12 file
  ansible:
    module: community.crypto.openssl_pkcs12
    path: "{{ openssl_key_directory }}/{{ item.name }}.p12"
    friendly_name: "{{ item.name }}"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    cert: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    state: present
    mode: "0600"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ items }}"

- name: Read private key
  ansible:
    module: ansible.builtin.slurp
    src: "{{ openssl_key_directory }}/{{ item.name }}.key"
  register: openssl_private_key
  loop: "{{ items }}"

- name: Read certificate
  ansible:
    module: ansible.builtin.slurp
    src: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
  register: openssl_certificate
  loop: "{{ items }}"

- name: Create combined private_key and certificate file
  ansible:
    module: ansible.builtin.copy
    content: |
      {{ (openssl_private_key.content | b64decode) }}
      {{ '\n' }}
      {{ (openssl_certificate.content | b64decode) }}
    dest: "{{ openssl_key_directory }}/{{ item.name }}.keycrt"
    mode: "0600"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ items }}"


