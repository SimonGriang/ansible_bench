- name: Gather service facts
  service_facts:

- name: Set the active_server variable
  loop: "{{ rke2_cluster_group_name }}"
  delegate_to: "{{ item }}"
  block:
    - name: Check if current host is a server and service is running
      set_fact:
        active_server: "{{ inventory_hostname }}" 
      when:
        - "{{ inventory_hostname }}" in "{{ rke2_servers_group_name }}"
        - service('rke2-server.service').state == 'running'


