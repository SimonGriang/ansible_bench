  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and (not rke2_server.service.enabled or rke2_server.service.enabled == 'no') }}"

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.has_key('access_key') and rke2_etcd_snapshot_s3_options.has_key('secret_access_key') and rke2_etcd_snapshot_s3_options.has_key('bucket') }}"

