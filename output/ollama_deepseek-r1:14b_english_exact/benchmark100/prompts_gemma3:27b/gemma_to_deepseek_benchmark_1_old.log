  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  template:
    src: "{{ rke2_config_template | default('templates/rke2-config.yaml')}}"
    dest: /etc/rancher/rke2/config.yaml
    owner: rancher
    group: rancher
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: "{{ rke2_kubelet_config_template | default('templates/kubelet-config.yaml')}}"
    dest: /etc/rancher/rke2/kubelet.yaml
    owner: rancher
    group: rancher
  notify: Config file changed
  when: rke2_kubelet_config | count > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: "{{ rke2_containerd_registry_config_template | default('templates/containerd-registry-config.json')}}"
    dest: /etc/rancher/rke2/registry.json
    owner: rancher
    group: rancher
  notify: Config file changed
  when: (rke2_custom_registry_mirrors | count > 0) or (rke2_custom_registry_configs | count > 0)

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and (not (rke2_server.service.enabled | ansible.utilsTruthy)) }}"

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined and (rke2_etcd_snapshot_s3_options | ansible.builtin.keys | list) |ansible.utils.contains('access_key') and (rke2_etcd_snapshot_s3_options | ansible.builtin.keys | list) |ansible.utils.contains('secret_access_key') and (rke2_etcd_snapshot_s3_options | ansible.builtin.keys | list) |ansible.utils.contains('bucket') }}"

