login_password: "{{ mysql_root_password }}"\n    login_host: "{{ mysql_socket }}"\n  loop: "{{ mysql_databases }}"\n\n- name: List databases\n  mysql_info:\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_host: "{{ mysql_socket }}"\n  register: db_list\n  changed_when: false\n\n- name: Import database\n  mysql_db:\n    name: "{{ item }}"\n    state: import\n    target: "{{ item }}"\n    sql_file: "{{ initial_import_target }}"\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_host: "{{ mysql_socket }}"\n  loop: |\n    {{ mysql_databases | difference(db_list.databases) if db_list else mysql_databases }}\n  when:\n    - initial_import_target is defined\n    - initial_import_target != ""\n    - (ansible_dict_count(db_list) == 0\n      or item not in db_list.databases)\n\n- name: Create users\n  mysql_user:\n    name: "{{ item.user }}"\n    host: "{{ item.host }}"\n    password: "{{ item.password }}"\n    priv: "{{ item.privileges }}%"\n    login_user: root\n    login_password: "{{ mysql_root_password }}"\n    login_host: "{{ mysql_socket }}"\n  loop: "{{ mysql_users }}"\n\n- name: Flush handlers again\n  meta:\n    flush_handlers: true\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-11T00:14:34.918785355Z', 'done': True, 'done_reason': 'stop', 'total_duration': 57254885696, 'load_duration': 90800147, 'prompt_eval_count': 1472, 'prompt_eval_duration': 20503799, 'eval_count': 3013, 'eval_duration': 57142457621, 'model_name': 'deepseek-r1:14b'} id='run--4f97ad15-ec80-48a2-b967-1a628335c4ba-0' usage_metadata={'input_tokens': 1472, 'output_tokens': 3013, 'total_tokens': 4485}
