---
- name: Create etcd group
  group:
    name: etcd
    state: present

- name: Create etcd user
  user:
    name: etcd
    group: etcd
    shell: /bin/nologin
    comment: 'Etcd system user'
    state: present

- name: Copy systemctl config file for kernel hardening
  copy:
    remote_src: yes
    src: /usr/local/share/rke2/rke2-cis-sysctl.conf
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: 0600
  notify: Restart systemd-sysctl

- name: Flush handlers
  meta:
    flush_handlers: true


