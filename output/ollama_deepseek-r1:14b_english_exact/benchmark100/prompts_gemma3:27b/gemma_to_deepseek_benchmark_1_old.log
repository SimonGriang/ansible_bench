---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: rancher
    group: rancher

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  template:
    src: "{{ rke2_config_template | default('templates/rke2-config.yaml')}}"
    dest: /etc/rancher/rke2/config.yaml
    owner: rancher
    group: rancher
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: "{{ rke2_kubelet_config_template | default('templates/kubelet-config.yaml')}}"
    dest: /etc/rancher/rke2/kubelet.yaml
    owner: rancher
    group: rancher
  notify: Config file changed
  when: (rke2_kubelet_config | count) > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: "{{ rke2_containerd_registry_config_template | default('templates/containerd-registry-config.json')}}"
    dest: /etc/rancher/rke2/registry.json
    owner: rancher
    group: rancher
  notify: Config file changed
  when: (rke2_custom_registry_mirrors | count) > 0 or (rke2_custom_registry_configs | count) > 0

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and not (rke2_server.service.enabled | ansible.builtin.truthy) }}"

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined and
      (rke2_etcd_snapshot_s3_options | ansible.builtin.keys | list) | ansible.utils.contains('access_key') and
      (rke2_etcd_snapshot_s3_options | ansible.builtin.keys | list) | ansible.utils.contains('secret_access_key') and
      (rke2_etcd_snapshot_s3_options | ansible.builtin.keys | list) | ansible.utils.contains('bucket') }}"

- name: Restore etcd from file
  shell: |
    mkdir -p /var/lib/rancher/etcd
    cp {{ rke2_etcd_snapshot_file }} /var/lib/rancher/etcd/
    rke2 server --config=/etc/rancher/rke2/config.yaml --snapshot-restore-file=/var/lib/rancher/etcd/$(basename {{ rke2_etcd_snapshot_file }})
  when: do_etcd_restore

- name: Restore etcd from s3
  shell: |
    mkdir -p /var/lib/rancher/etcd
    rke2 server --config=/etc/rancher/rke2/config.yaml --snapshot-restore-s3-path="{{ rke2_etcd_snapshot_s3_path }}" --snapshot-restore-s3-bucket="{{ rke2_etcd_snapshot_s3_bucket }}" --snapshot-restore-s3-access-key="{{ rke2_etcd_snapshot_s3_options.access_key }}" --snapshot-restore-s3-secret-access-key="{{ rke2_etcd_snapshot_s3_options.secret_access_key }}"
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
    environment: "RKE2_TOKEN={{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    state: masked
    disabled: yes

- name: Wait for the first server be ready - no CNI
  wait_for_task:
    command: kubectl get pods -n kube-system
    interval: 10
    until: "kubectl get pods -n kube-system | grep -E 'coredns|kube-proxy|kube-scheduler|kube-controller-manager|etcd' | grep -E 'Running|Ready'"
    ignore_errors: yes

- name: Wait for the first server be ready - with CNI
  wait_for_task:
    command: kubectl get pods -n kube-system
    interval: 10
    until: "kubectl get pods -n kube-system | grep -E 'coredns|kube-proxy|kube-scheduler|kube-controller-manager|etcd' | grep -E 'Running|Ready'"
    ignore_errors: yes

- name: Restore etcd
  shell: |
    kubectl get nodes -o json --kubeconfig /etc/rancher/rke2/config.yaml > /tmp/etcd-nodes.json
    kubectl get nodes -o json --kubeconfig /etc/rancher/rke2/config.yaml | jq -r '.items[].metadata.name' | tr '\n' ' ' > /tmp/etcd-nodes.txt
    kubectl delete secrets etcd-backup-encryption-key --namespace kube-system --kubeconfig /etc/rancher/rke2/config.yaml || true
