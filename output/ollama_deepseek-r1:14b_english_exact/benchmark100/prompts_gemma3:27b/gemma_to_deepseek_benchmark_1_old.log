        name: containerd.io
        state: present
      become: true
      when: docker.PackageManager == 'apt'

    - name: Ensure containerd.io is installed
      yum:
        name: containerd.io
        state: present
      become: true
      when: docker.PackageManager == 'yum'
  when: ansible_facts.distribution_major_version == 8


