---
- name: Create document roots for virtual hosts
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  loop: "{{ httpd_vhosts | default([]) | list }}"
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - item.create_docroot
  vars:
    ansible_posix.dir_mode: '0755'

- name: Configure virtual hosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: 0644
  loop: "{{ httpd_vhosts | default([]) | list }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

- name: Enable virtual hosts
  become: yes
  command: a2ensite "{{ item.name }}"
  loop: "{{ httpd_vhosts | default([]) | list }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  when:
    - ansible_os_family == "Debian"
  vars:
    ansible_python.sdk.a2ensite: true
  register: enable_vhost
  changed_when: enable_vhost.rc != 0


