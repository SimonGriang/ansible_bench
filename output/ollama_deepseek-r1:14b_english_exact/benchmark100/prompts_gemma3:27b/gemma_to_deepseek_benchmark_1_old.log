---
- name: Secure Vault configuration file permissions
  file:
    path: /etc/vault.d/vault.json
    owner: root
    group: root
    mode: 0644
    state: touch
  register: vault_config_secure
  ignore_errors: yes

  ansible.builtin.file:
    path: /etc/vault.d
    state: directory
    mode: 0755
  ignore_errors: yes

- name: Configure SELinux / AppArmor
  ansible.builtin.set_fact:
    configure_selinux: "{{ vault_hardening_configure_selinux_apparmor | default('yes') | ansible.builtin.yes_no }}"

  when: ansible.builtin.yes_no("{{ ansible_selinux.status }}") == "enabled"
  block:
    - name: Install SELinux policy package
      ansible.builtin.package:
        name: selinux-policy
        state: present

    - name: Set SELinux policy to enforcing and targeted
      ansible.builtin.selinux:
        policy: targeted
        state: enforcing


