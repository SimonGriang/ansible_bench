---
- name: Migrate from adoptopenjdk to temurin if selected
  set_fact:
    java_jdk_vendor: "temurin"
  when: ansible_distribution == "Debian" and java_jdk_vendor == "adoptopenjdk"

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_distribution }}/{{ ansible_distribution_major_version }}"

- name: Gather architecture specific variables
  include_vars:
    file: architecture.yml

- name: Set OS specific variables (I)
  set_fact:
    java_open_jdk_version: "{{ java_open_jdk_version | default('8') }}"
    java_open_jdk_repository: "{{ java_open_jdk_repository | default('') }}"
    java_open_jdk_key_repository: "{{ java_open_jdk_key_repository | default('') }}"
    java_open_jdk_apt_extra_packages: "{{ java_open_jdk_apt_extra_packages | default([]) }}"
    java_deprecated_repositories_adoptopenjdk: "{{ java_deprecated_repositories_adoptopenjdk | default([]) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ java_open_jdk_home_dir | default('/usr/lib/jvm/java-{{ java_open_jdk_version }}/') }}"
    java_open_jdk_package: "{{ java_open_jdk_package | default('openjdk-{{ java_open_jdk_version }}-jdk') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home_dir }}"

- name: Remove deprecated repositories (Debian)
  apt:
    name: "{{ item }}"
    state: absent
  loop: "{{ java_deprecated_repositories_adoptopenjdk }}"

- name: Install extra apt tools (Debian)
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_apt_extra_packages }}"

- name: Add required key repositories (Debian)
  apt_key:
    key: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk }}"

- name: Add required repositories (Debian)
  apt_repository:
    repo: "{{ item }}"
    state: present
  loop: "{{ java_required_repositories_openjdk }}"

- name: Add required key repositories (RedHat)
  rpm_key:
    key: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk }}"

- name: Add required repositories (RedHat)
  yum:
    name: "{{ item }}"
    state: present
  loop: "{{ java_required_repositories_openjdk }}"

- name: Install required libs
  apt:
    name: "{{ item }}"
    state: present
  when: ansible_distribution == "Debian"
  loop: "{{ java_required_libs_openjdk }}"
  ignore_errors: yes

  yum:
    name: "{{ item }}"
    state: present
  when: ansible_distribution == "RedHat"
  loop: "{{ java_required_libs_openjdk }}"
  ignore_errors: yes

- name: Install Java (Debian)
  apt:
    name: "{{ java_open_jdk_package }}"
    version: "{{ java_open_jdk_version }}"
    state: present

- name: Install Java (RedHat)
  yum:
    name: "{{ java_open_jdk_package }}"
    version: "{{ java_open_jdk_version }}"
    state: present

- name: Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh

- name: Source environment variables
  shell: source /etc/profile

- name: Correct java version selected (Debian, Java < 11)
  alternatives:
    name: java
    path: "{{ java_open_jdk_home_dir }}/bin/java"
    priority: 1
    state: set
  when: java_open_jdk_version is version < '11' and ansible_distribution == "Debian"

- name: Correct java version selected (Debian, Java >= 11)
  alternatives:
    name: java
    path: "{{ java_open_jdk_home_dir }}/bin/java"
    priority: 1
    state: set
  when: java_open_jdk_version is version >= '11' and ansible_distribution == "Debian"


