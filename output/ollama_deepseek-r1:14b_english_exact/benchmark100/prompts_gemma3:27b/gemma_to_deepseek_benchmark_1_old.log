djust each file\'s state to present with specified owner and mode.\n\nTask 11 copies the Vault binary to `/usr/bin/vault`, ensuring correct ownership and permissions, and notifying the handler.\n\nTask 12 sets a capability on the binary. The cap module is used with `cap_ipc_lock=ep`, ensuring it\'s idempotent.\n\nTask 13 touches `vault.env`, sets ownership, permissions, and notifies the handler.\n\nTask 14 creates the systemd directory if it doesn\'t exist, using file module.\n\nTask 15 copies the service file, checks if the system uses systemd, and notifies the daemon reload handler.\n\nTask 16 copies the configuration file, setting ownership and permissions, and notifies the restart handler.\n\nFinally, Task 17 flushes all handlers to ensure they run after all tasks.\n\nI need to make sure each task is ordered correctly and uses the right modules and variables. Also, I\'ll ensure that the playbook starts with \'---\' and adheres to YAML syntax without any comments or explanations outside the tasks.\n</think>\n\n```yaml\n---\n- name: Create Vault group\n  group:\n    name: "{{ vault_group }}"\n\n- name: Create Vault user\n  user:\n    name: "{{ vault_user }}"\n    shell: "{{ vault_user_shell }}"\n    group: "{{ vault_group }}"\n    create_home: no\n\n- name: Create Vault download directory\n  file:\n    path: "{{ vault_download_path }}"\n    state: directory\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: 0755\n\n- name: Download Vault binary\n  url:\n    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"\n    dest: "{{ vault_download_path }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"\n    validate_certs: no\n  register: vault_download_result\n\n- name: Extract Vault binary\n  archive:\n    path: "{{ vault_download_path }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"\n    dest: "{{ vault_download_path }}"\n\n- name: Check if vault_path exists\n  stat:\n    path: "{{ vault_path }}"\n  register: vault_check_path\n\n- name: Create vault_path if it does not exist\n  file:\n    path: "{{ vault_path }}"\n    state: directory\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: 0755\n  when:\n    - not vault_check_path.stat.exists\n    - "{{ vault_path }}" != ""\n\n- name: Create directory in vault_path\n  file:\n    path: "{{ item.path }}"\n    state: directory\n    mode: "{{ item.mode | default(\'0755\') }}"\n  with_items: "{{ vault_directories }}"\n\n- name: Create data directory\n  file:\n    path: "{{ item.path }}"\n    state: directory\n    mode: "{{ item.mode | default(\'0755\') }}"\n  with_items: "{{ vault_data_directories }}"\n\n- name: Generate TLS key and certificate\n  command: openssl req -x509 -newkey rsa:2048 -keyout tls.key -out tls.crt -days 365 -sha256 -nodes -subj "/C=US/ST=State/L=City/O=Vault/OU=Vault/CN=Vault"\n  args:\n    chdir: "{{ vault_data_directory }}/tls/"\n  notify: Restart vault\n\n- name: Set ownership of tls material\n  file:\n    path: "{{ item.path }}"\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: "{{ item.mode | default(\'0644\') }}"\n  with_items: "{{ vault_tls_files }}"\n\n- name: Copy Vault binary\n  copy:\n    src: "{{ vault_download_path }}/vault"\n    dest: /usr/bin/vault\n    mode: 0755\n    owner: root\n    group: root\n  notify: Restart vault\n\n- name: Set cap_ipc_lock=ep on /usr/bin/vault\n  cap:\n    path: /usr/bin/vault\n    capabilities: cap_ipc_lock=ep\n    state: present\n    mode: set\n  become: yes\n\n- name: Touch vault.env\n  file:\n    path: "{{ vault_path }}/etc/vault.d/vault.env"\n    state: touch\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: 0644\n    preserve: yes\n  notify: Restart vault\n\n- name: Create /usr/lib/systemd/system\n  file:\n    path: /usr/lib/systemd/system\n    state: directory\n    owner: root\n    group: root\n    mode: 0755\n\n- name: Copy Vault service file\n  copy:\n    src: vault.service.j2\n    dest: /usr/lib/systemd/system/vault.service\n    mode: 0644\n    owner: root\n    group: root\n  notify: Daemon reload\n  when: ansible_system == "Linux" andansible_service_manager == "systemd"\n\n- name: Copy vault configuration\n  copy:\n    src: vault.hcl\n    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"\n    mode: 0644\n    owner: root\n    group: root\n  notify: Restart vault\n\n- name: Flush handlers\n  meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-10T23:24:30.877547344Z', 'done': True, 'done_reason': 'stop', 'total_duration': 28404416212, 'load_duration': 81957782, 'prompt_eval_count': 1115, 'prompt_eval_duration': 600341214, 'eval_count': 1593, 'eval_duration': 27720209195, 'model_name': 'deepseek-r1:14b'} id='run--4827b077-85c7-43fa-a365-ab513fb75cd3-0' usage_metadata={'input_tokens': 1115, 'output_tokens': 1593, 'total_tokens': 2708}
