    - rke2_cluster_group_name | length > 1

- include_tasks: tasks/rolling_cordon_drain_restart_servers.yml
  when:
    - rke2_installed_version is defined
    - rke2_installed_version != rke2_version

- include_tasks: tasks/rolling_cordon_drain_restart_agents.yml
  when:
    - rke2_installed_version is defined
    - rke2_installed_version != rke2_version
    - ansible_hostname not in rke2_servers_group_name

- include_tasks: tasks/flush_handlers.yml

- include_tasks: tasks/rolling_restart.yml
  when:
    - rke2_restart_needed

- include_tasks: tasks/summary.yml


