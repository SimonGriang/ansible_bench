    command: kubectl get pods -n kube-system
    interval: 10
    until: "kubectl get pods -n kube-system | grep -E 'coredns|kube-proxy|kube-scheduler|kube-controller-manager|etcd' | grep -E 'Running|Ready'"
    ignore_errors: yes

- name: Wait for the first server be ready - with CNI
  wait_for_task:
    command: kubectl get pods -n kube-system
    interval: 10
    until: "kubectl get pods -n kube-system | grep -E 'coredns|kube-proxy|kube-scheduler|kube-controller-manager|etcd' | grep -E 'Running|Ready'"
    ignore_errors: yes

- name: Restore etcd
  shell: |
    kubectl get nodes -o json --kubeconfig /etc/rancher/rke2/config.yaml > /tmp/etcd-nodes.json
    kubectl get nodes -o json --kubeconfig /etc/rancher/rke2/config.yaml | jq -r '.items[].metadata.name' | tr '\n' ' ' > /tmp/etcd-nodes.txt
    kubectl delete secrets etcd-backup-encryption-key --namespace kube-system --kubeconfig /etc/rancher/rke2/config.yaml || true
    kubectl delete nodes --kubeconfig /etc/rancher/rke2/config.yaml $(cat /tmp/etcd-nodes.txt)
    kubectl delete pods --namespace kube-system --kubeconfig /etc/rancher/rke2/config.yaml --all
    kubectl delete pods --kubeconfig /etc/rancher/rke2/config.yaml --all
    kubectl delete csrs -A --kubeconfig /etc/rancher/rke2/config.yaml -o json | jq '.items[].metadata.name' | xargs -n 1 kubectl delete csr --kubeconfig /etc/rancher/rke2/config.yaml
    kubectl delete nodes --kubeconfig /etc/rancher/rke2/config.yaml $(cat /tmp/etcd-nodes.txt)

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ ansible_hostname }}"
  delegate_to: all
  when: inventory_hostname in group_byvars[rke2_cluster_group_name]['members']


