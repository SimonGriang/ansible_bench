  when:
    - ansible_connection | bool
    - ansible_connection != 'container'
    - bootstrap_wait_for_host | bool

- name: Prepare system
  command: whoami
  become: true
  become_flags: -H
  ignore_errors: yes
  rescue:
    - name: Gather facts on prepare system failure
      setup:
        gather_subset: all

    - name: Install bootstrap packages via raw
      raw: |
        if ! [ -x /usr/bin/apt-get ]; then
            rpm --import https://apt.Bootstrap.fact.io/gpg.key && yum install -y libdnf5;
        else
            apt-get update && apt-get install -y --no-install-recommends curl;
        fi
      become: true
      when: ansible_distribution in ['RedHat', 'Fedora', 'CentOS']

- name: Gather ansible facts
  setup:
    gather_subset: all

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
  become: "{{ bootstrap_become | ansible_boolean }}"



