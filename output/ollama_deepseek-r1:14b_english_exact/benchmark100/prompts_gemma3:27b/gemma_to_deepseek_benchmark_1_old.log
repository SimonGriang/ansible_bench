---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    create_home: false

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755

- name: Download Vault binary
  url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"
    dest: "{{ vault_download_path }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"
    validate_certs: no
  register: vault_download_result

- name: Extract Vault binary
  archive:
    path: "{{ vault_download_path }}/vault_{{ vault_version }}_{{ vault_architecture }}.tar.gz"
    dest: "{{ vault_download_path }}"

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
  when:
    - not vault_check_path.stat.exists
    - ansible.utils.conditionals.ifbool("{{ vault_path | bool }}")

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode | default('0755') }}"
  with_items: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode | default('0755') }}"
  with_items: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command: |
    openssl req -x509 -newkey rsa:2048 -keyout tls.key -out tls.crt
    -days 365 -sha256 -nodes -subj "/C=US/ST=State/L=City/O=Vault/OU=Vault/CN=Vault"
  args:
    chdir: "{{ vault_data_directory }}/tls/"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item.path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: "{{ item.mode | default('0644') }}"
  with_items: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: /usr/bin/vault
    mode: 0755
    owner: root
    group: root
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  cap:
    path: /usr/bin/vault
    capabilities: cap_ipc_lock=ep
    state: present
    mode: set
  become: yes

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0644
    preserve: yes
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Copy Vault service file
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: 0644
    owner: root
    group: root
  notify: Daemon reload
  when:
    - ansible_system == "Linux"
    - ansible_service_manager == "systemd"

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: 0644
    owner: root
    group: root
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


