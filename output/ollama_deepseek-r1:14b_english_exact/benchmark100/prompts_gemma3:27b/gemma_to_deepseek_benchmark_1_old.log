e correctly referenced. This should result in a valid Ansible Playbook that meets all the specified requirements.\n</think>\n\n```yaml\n---\n- name: Check if the Helm binary exists\n  stat:\n    path: "{{ helm_bin_path }}"\n  register: helm_check\n  ignore_errors: true\n\n- name: Check Helm version\n  command: helm version\n  register: helm_existing_version\n  changed_when: false\n  failed_when: false\n\n- name: Download helm\n  unarchive:\n    remote_src: true\n    url: "{{ helm_repo_url }}/charts/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"\n    dest: /tmp\n    remote_src: true\n  register: helm_download\n  when:\n    - not helm_check.stat.exists\n    - helm_existing_version.stdout_lines[0] != "v{{ helm_version }}"\n\n- name: Copy helm binary into place\n  copy:\n    src: "/tmp/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}/helm"\n    dest: "{{ helm_bin_path }}"\n    mode: 0755\n    remote_src: true\n  become: true\n  when: helm_download.changed\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-11T00:28:51.149011426Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13242829409, 'load_duration': 95226109, 'prompt_eval_count': 594, 'prompt_eval_duration': 322326510, 'eval_count': 708, 'eval_duration': 12823887376, 'model_name': 'deepseek-r1:14b'} id='run--86f8809f-c97d-4575-b088-9bcbac5b0827-0' usage_metadata={'input_tokens': 594, 'output_tokens': 708, 'total_tokens': 1302}
