---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install apache httpd
  apt:
    name: "{{ httpd_packages }}"
    state: present
  become: yes
  when: ansible_distribution == 'debian' or ansible_distribution == 'ubuntu'

  register: httpd_package_install
  changed_when: httpd_package_install.results | any | bool

- name: Install apache httpd
  yum:
    name: "{{ httpd_packages }}"
    state: present
  become: yes
  when: ansible_distribution in ['redhat', 'centos', 'suse']

  register: httpd_package_install
  changed_when: httpd_package_install.results | any | bool

- name: Configure selinux
  setsebool:
    name: "{{ item }}"
    value: on
    persist: yes
  become: yes
  when: ansible_selinux_enabled | bool
  with_items: "{{ httpd_selinux_settings }}"

- name: Allow connections to specified ports
  semanage:
    port: "{{ item }}"
    protocol: tcp
    state: allow
  become: yes
  with_items: "{{ httpd_allowed_ports }}"

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    owner: root
    group: root
    mode: 0644
  notify: ['Test httpd configuration validity', 'Restart httpd']

- name: Activate httpd modules
  command: a2enmod "{{ item }}"
  become: yes
  with_items: "{{ httpd_modules_to_activate_with_command | bool }}"

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations | bool

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts | bool

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf }}"
    dest: "{{ httpd_server_root }}/ports.conf"
    owner: root
    group: root
    mode: 0644
  notify: ['Test httpd configuration validity', 'Restart httpd']
  when: ansible_distribution in ['debian', 'ubuntu', 'suse']

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories | bool

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_dir }}/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes
  become: yes


