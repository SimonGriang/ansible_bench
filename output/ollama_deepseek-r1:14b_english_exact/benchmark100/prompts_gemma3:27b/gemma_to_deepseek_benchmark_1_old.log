---
- name: Import assert.yml
  import_tasks:
    path: assert.yml
  become: false
  host: localhost
  no_vars_prompt: false

- name: Configure apk
  become: true
  apt:
    name: "*"
    state: latest
  become_user: root
  when: ansible PackageManager == 'apk'

- name: Configure apt
  become: true
  apt:
    upgrade: yes
    exclude: "{{ update_excluded_packages }}"
  become_user: root
  when: ansible PackageManager == 'apt'

- name: Update all software (dnf)
  dnf:
    name: "*"
    state: latest
    exclude: "{{ update_excluded_packages }}"
    update_cache: yes
  when: ansible PackageManager in ['dnf', 'dnf5']

- name: Update all software (pacman)
  pacman:
    state: latest
  when: ansible PackageManager == 'pacman'

- name: Configure yum
  become: true
  yum:
    name: "*"
    state: latest
    exclude: "{{ update_excluded_packages }}"
  become_user: root
  when: ansible PackageManager == 'yum'

- name: Update all software (zypper)
  zypper:
    name: "*"
    state: latest
  when: ansible PackageManager == 'zypper'

