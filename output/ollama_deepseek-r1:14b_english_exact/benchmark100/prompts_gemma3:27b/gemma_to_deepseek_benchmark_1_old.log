---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: files/assert.yml
  delegate_to: localhost
  register: assertions_result

- name: Disable automatic service management
  ansible.builtin.file:
    path: /usr/sbin/policy-rc.d
    state: file
    content: exit 101
    mode: '755'
  when: apt_autostart_state == 'disabled'

- name: Enable automatic service management
  ansible.builtin.file:
    path: /usr/sbin/policy-rc.d
    state: absent
  when: apt_autostart_state == 'enabled'


