- name: Configure sysctl settings
  community.sysctl.sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    sysctl_set: "{{ sysctl_set | default('yes') }}"
    sysctl_reload: "{{ sysctl_reload | default('yes') }}"
  loop: "{{ sysctl_items | default([]) }}"
  when: item.name is defined and item.value is defined
  no_log: "{{ containerized | bool }}"
  register: sysctl_result
  label: sysctl-settings



