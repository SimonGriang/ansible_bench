---
- name: Import assert.yml
  block:
    - import_tasks: assert.yml
  run_once: true

- name: Install required software
  apt:
    name: "{{ users_requirements }}"
    state: present
  when: users_requirements is not empty

- name: Loop over users_groups
  loop: "{{ users_groups }}"
  include_tasks: group.yml
  loop_control:
    loop_var: group_name
  when: users_groups is defined

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "#includedir {{ users_sudo_includedir }}"
    validate: sudo -V
  when: users_sudo_includedir is defined

- name: Loop over users
  loop: "{{ users }}"
  include_tasks: user.yml
  loop_control:
    loop_var: user_name
  when: users is defined

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0o644
  when: users_cron_allow is true

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is false


