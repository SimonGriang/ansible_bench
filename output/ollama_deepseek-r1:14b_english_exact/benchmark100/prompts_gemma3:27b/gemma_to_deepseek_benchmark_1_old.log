---
- name: Check if all variables have been set correctly
  include_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for host to be reachable
  include_tasks:
    file: wait_for.yml
  delegate_to: localhost
  run_once: true
  when: ansible_connection not in ['container', 'docker'] and bootstrap_wait_for_host

- block: | 
    - name: Test connection
      wait_for_connection:
        timeout: "{{ bootstrap_timeout | default('60') }}"
      register: bootstrap_connect

    - name: Gather bootstrap facts
      include_tasks:
        file: gather_facts.yml
  name: Prepare the system

- name: Install bootstrap packages
  raw: 
    cmd: "{{ bootstrap_packages_command }}"
  register: bootstrap_install_packages
  changed_when: 
    - (ansible_distribution in ['alpine', 'arch', 'gentoo'] and 
       '"{{ bootstrap_packages_command.stdout | regex('.installed.*') }}"' is matched)
    - (ansible_distribution in ['debian', 'ubuntu', 'redhat', 'rocky', 'suse'] and 
       '"{{ bootstrap_packages_command.stdout | regex('.not installed.*') }}"' is not matched)
  become: yes
  user: "{{ bootstrap_user }}"
  delegate_to: "{{ansible_ssh_host | default(ansible_host | default(inventory_hostname))}}"

- block: | 
    - name: Gather ansible facts
      setup:

    - name: Install packages from facts
      package:
        name: "{{ bootstrap__facts_packages }}"
        state: present
        cache_valid_time: 0
  name: Ensure system is prepared by issuing ansible modules


