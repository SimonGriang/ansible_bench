---
- name: Import assert.yml
  include_tasks:
    file: assert.yml
  hosts: localhost
  loop:
    - 1
  loop_control:
    loop_var: __assert
  vars:
    sysctl_assertions: "{{ sysctl_assertions | default([]) }}"

- name: Install requirements
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ sysctl_requirements | default([]) }}"

- name: Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    sysctl_set: "{{ sysctl_set | default('yes') }}"
    sysctl_reload: "{{ sysctl_reload | default('yes') }}"
  loop: "{{ sysctl_items | default([]) }}"
  when: item.name is defined and item.value is defined
  no_log: containerized | default(false)
  register: sysctl_result
  label: "{{ item.name }}"


