- name: Ensure the easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Initialize the easy-rsa PKI
  shell: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false
  ignore_errors: true
  register: init_pki_result
  until: init_pki_result.rc == 0
  retries: 3

- name: Build the Certificate Authority (CA)
  shell: easyrsa build-ca nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: yes
  changed_when: false
  ignore_errors: true
  register: ca_build_result
  until: ca_build_result.rc == 0
  retries: 3

- name: Generate Diffie-Hellman parameters
  shell: easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false
  ignore_errors: true
  register: dh_gen_result
  until: dh_gen_result.rc == 0
  retries: 3

- name: Build the server certificate
  shell: easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: yes
  changed_when: false
  ignore_errors: true
  register: server_cert_result
  until: server_cert_result.rc == 0
  retries: 3

- name: Build the client certificate
  shell: easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  environment:
    EASYRSA_BATCH: yes
  changed_when: false
  ignore_errors: true
  register: client_cert_result
  until: client_cert_result.rc == 0
  retries: 3

- name: Generate the Certificate Revocation List (CRL)
  shell: easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  changed_when: false
  ignore_errors: true
  register: crl_gen_result
  until: crl_gen_result.rc == 0
  retries: 3

- name: Generate TLS authentication key
  shell: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  changed_when: false
  ignore_errors: true
  register: ta_key_result
  until: ta_key_result.rc == 0
  retries: 3

- name: Copy PKI files to the server configuration directory
  copy:
    remote_src: true
    src: /etc/openvpn/easy-rsa/pki/
    dest: /etc/openvpn/server/
    files:
      - ca.crt
      - dh.pem
      - ta.key
      - client.crt
      - server.crt
      - ca.key
      - client.key
      - server.key
  file_mode: 0640

- name: Copy ca.crt and ta.key to /etc/openvpn
  copy:
    remote_src: true
    src: /etc/openvpn/easy-rsa/pki/
    dest: /etc/openvpn/
    files:
      - ca.crt
      - ta.key
  file_mode: 0640

- name: Place the server configuration file
  template:
    src: server.conf.j2
    dest: "{{ openvpn_configuration_directory }}/server.conf"
    mode: 0640
    owner: openvpn
    group: openvpn
  notify: Restart openvpn


