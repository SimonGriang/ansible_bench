s }}"\n    state: present\n  notify: Gather facts\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Configure selinux\n  selinux:\n    state: "{{ selinux_state }}"\n    policy: "{{ selinux_policy }}"\n  when: ansible_selinux.status is defined and not containerized\n  notify: Reboot\n\n- name: Manage selinux booleans\n  loop: "{{ selinux_booleans | default({}) | dict2list }}"\n  selinux_bool:\n    name: "{{ item.key }}"\n    value: "{{ item.value | default(\'yes\') }}"\n    persistent: yes\n  when: selinux_booleans is defined\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-11T00:09:36.653484292Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9483751532, 'load_duration': 94364914, 'prompt_eval_count': 491, 'prompt_eval_duration': 122680474, 'eval_count': 553, 'eval_duration': 9265422523, 'model_name': 'deepseek-r1:14b'} id='run--79c2e95e-90cf-4f55-87a3-8ddb05e7e9ed-0' usage_metadata={'input_tokens': 491, 'output_tokens': 553, 'total_tokens': 1044}
