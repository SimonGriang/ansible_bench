  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  template:
    src: "{{ rke2_config_template | default('templates/rke2-config.yaml')}}"
    dest: /etc/rancher/rke2/config.yaml
    owner: rancher
    group: rancher
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: "{{ rke2_kubelet_config_template | default('templates/kubelet-config.yaml')}}"
    dest: /etc/rancher/rke2/kubelet.yaml
    owner: rancher
    group: rancher
  notify: Config file changed
  when: 
    (rke2_kubelet_config | count) > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: "{{ rke2_containerd_registry_config_template | default('templates/containerd-registry-config.json')}}"
    dest: /etc/rancher/rke2/registry.json
    owner: rancher
    group: rancher
  notify: Config file changed
  when: 
    (rke2_custom_registry_mirrors | count) > 0 or 
    (rke2_custom_registry_configs | count) > 0

