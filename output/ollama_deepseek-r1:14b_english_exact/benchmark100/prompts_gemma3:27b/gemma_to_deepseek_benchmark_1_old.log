meters split into multiple lines where lines exceed 80 characters, and the \'when\' conditions will be properly formatted to avoid truthy value issues by ensuring they evaluate to booleans.\n</think>\n\n```yaml\n---\n- name: Create the RKE2 config directory\n  file:\n    path: /etc/rancher/rke2\n    state: directory\n    owner: root\n    group: rancher\n    mode: 0755\n\n- name: Set server taints\n  set_fact:\n    combined_node_taints: "{{ rke2_server_node_taints }}"\n  when: rke2_type == \'server\'\n\n- name: Set agent taints\n  set_fact:\n    combined_node_taints: "{{ rke2_agent_node_taints }}"\n  when: rke2_type == \'agent\'\n\n- name: Copy RKE2 config\n  copy:\n    src: "{{ rke2_config_src }}"\n    dest: /etc/rancher/rke2/config.yml\n    owner: rancher\n    group: rancher\n    mode: 0644\n  notify: rke2_config_handler\n\n- name: Copy kubelet config\n  copy:\n    src: "{{ rke2_kubelet_config_src }}"\n    dest: /etc/systemd/system/kubelet.service.d/10-rke2.conf\n    owner: rancher\n    group: rancher\n    mode: 0644\n  when: rke2_kubelet_config | length > 0\n  notify: rke2_kubelet_handler\n\n- name: Copy Containerd Registry Configuration file\n  copy:\n    src: "{{ rke2_containerd_registry_config_src }}"\n    dest: /etc/containerd/config.json\n    owner: rancher\n    group: rancher\n    mode: 0644\n  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0\n  notify: rke2_containerd_handler\n\n- name: Start RKE2 service on the rest of the nodes\n  service:\n    name: rke2\n    state: started\n    enabled: yes\n    display_name: rke2\n    environment:\n      RKE2_TOKEN: "{{ rke2_token }}"\n  become: true\n  register: rke2_service_result\n  notify: rke2_service_handler\n\n- name: Mask other RKE2 service on the rest of the nodes\n  service:\n    name: "{{ item }}"\n    state: masked\n    enabled: no\n  loop: [rke2-agent, rke2-server]\n  when: rke2_type in [\'server\', \'agent\']\n\n- name: Wait for remaining nodes to be ready - no CNI\n  wait_for_nodes:\n    binary_path: /usr/bin/kubectl\n    ready_timeout: 300\n    condition_timeout: 60\n    check_kubelet: no\n    check_cni: no\n    check_node_info: yes\n    check_memory: yes\n    check_disk: yes\n    check_pids: yes\n  when: rke2_cni == \'none\' and (ansible_hostname == rke2_active_server or ansible_hostname == rke2_first_server)\n  tags: [rke2_nodes_ready]\n\n- name: Wait for remaining nodes to be ready - with CNI\n  wait_for_nodes:\n    binary_path: /usr/bin/kubectl\n    ready_timeout: 300\n    condition_timeout: 60\n    check_cni: yes\n    check_node_info: yes\n    check_memory: yes\n    check_disk: yes\n    check_pids: yes\n  when: rke2_cni != \'none\' and (ansible_hostname == rke2_active_server or ansible_hostname == rke2_first_server)\n  tags: [rke2_nodes_ready]\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-11T02:15:57.407678405Z', 'done': True, 'done_reason': 'stop', 'total_duration': 33321828756, 'load_duration': 90554336, 'prompt_eval_count': 1996, 'prompt_eval_duration': 1015207839, 'eval_count': 1760, 'eval_duration': 32215341882, 'model_name': 'deepseek-r1:14b'} id='run--15274fea-b62c-4bc3-b2db-43a1992b795e-0' usage_metadata={'input_tokens': 1996, 'output_tokens': 1760, 'total_tokens': 3756}
