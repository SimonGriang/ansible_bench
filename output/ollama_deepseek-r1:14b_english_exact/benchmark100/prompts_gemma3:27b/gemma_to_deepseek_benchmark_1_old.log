- name: Remove old Docker packages
  apt:
    name: "{{ docker_obsolete_packages }}"
    state: absent
  become: true
  when: docker PackageManager == 'apt'

- name: Remove old Docker packages
  yum:
    name: "{{ docker_obsolete_packages }}"
    state: absent
  become: true
  when: docker PackageManager == 'yum'

- name: Add Docker GPG key
  rpm:
    key: "{{ docker_yum_gpg_key }}"
    state: present
  become: true
