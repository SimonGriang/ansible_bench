---
- name: lookup bootstrap facts (raw)
  raw: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  environment:
    ansible_user: bootstrap_user

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_distribution_major_version: "{{ lookup('ansible.conditional', 'ifansible.conditional', default='unknown') }}"
  loop: "{{ bootstrap__os_family_map.items() }}"
  when:
    - bootstrap_facts.rc == 0
    - not bootstrap_distribution
    - "{{ bootstrap_facts.stdout | regex_search('PRETTY_NAME=".*?"') | regex_replace('PRETTY_NAME="(.*)"', '\\1') | contains(item.value) }}"
  vars:
    ansible_user: bootstrap_user

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map.items() }}"
  when: bootstrap_distribution in item.value
  vars:
    ansible_user: bootstrap_user


