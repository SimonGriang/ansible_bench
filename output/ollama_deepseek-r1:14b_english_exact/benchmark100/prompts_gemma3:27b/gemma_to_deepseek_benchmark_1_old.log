---
tasks:
  - name: Task 1: Import assert.yml
    import_tasks: assert.yml
    run_once: true
    host: localhost

  - name: Task 2: Pre-configure debian systems
    debconf2:
      name: postfix
      question: postfix/mailer_type
      value: 'No configuration'

  - name: Task 3: Install postfix
    apt:
      name: postfix
      state: present

  - name: Task 4: Install postfix-mysql
    apt:
      name: postfix-mysql
      state: present

  - name: Task 5: Configure postfix (transport_maps)
    template:
      src: transport_maps.j2
      dest: /etc/postfix/transport_maps
    notify:
      - postfix_db_rebuild

  - name: Task 6: Configure postfix (header_checks)
    template:
      src: header_checks.j2
      dest: /etc/postfix/header_checks
    notify:
      - postfix_reload

  - name: Task 7: Setting values for main.cf (1/2)
    set_fact:
      postfix_maincf_settings: "{{ main_configurations }}"

  - name: Task 8: Setting values for main.cf (2/2)
    set_fact:
      postfix_maincf_lists: "{{ lists }}"

  - name: Task 9: Configure postfix (main.cf)
    template:
      src: main.cf.j2
      dest: /etc/postfix/main.cf
    notify:
      - postfix_validate
      - postfix_restart

  - name: Task 10: Configure postfix (master.cf)
    template:
      src: master.cf.j2
      dest: /etc/postfix/master.cf
    notify:
      - postfix_validate
      - postfix_restart

  - name: Task 11: Creates cert/key directory
    file:
      path: /etc/postfix/tls
      state: directory

  - name: Task 12: Deploy Postfix TLS server certificate
    copy:
      src: postfix.crt
      dest: /etc/postfix/tls/postfix.crt
      owner: postfix
      group: postfix
      mode: 0644

  - name: Task 13: Deploy Postfix TLS server key
    copy:
      src: postfix.key
      dest: /etc/postfix/tls/postfix.key
      owner: postfix
      group: postfix
      mode: 0600

  - name: Task 14: Flush handlers
    meta:
      flush_handlers: yes

  - name: Task 15: Configure aliases
    template:
      src: postfix_aliases
      dest: /etc/postfix/aliases
    notify:
      - postfix_reload

  - name: Task 16: Configure sender_access
    template:
      src: sender_access.j2
      dest: /etc/postfix/sender_access
    notify:
      - postfix_reload

  - name: Task 17: Configure recipient_access
    template:
      src: recipient_access.j2
      dest: /etc/postfix/recipient_access
    notify:
      - postfix_reload

  - name: Task 18: Place sasl_password_map
    template:
      src: sasl_password_map.j2
      dest: /etc/postfix/sasl_password_map
    notify:
      - postfix_reload

  - name: Task 19: Flush handlers again
    meta:
      flush_handlers: yes

  - name: Task 20: Start and enable postfix
    service:
      name: postfix
      state: started
      enabled: yes

