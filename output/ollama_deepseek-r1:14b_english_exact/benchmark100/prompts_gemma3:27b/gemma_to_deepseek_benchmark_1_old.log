    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined and not rke2_server.service.enabled }}"

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_s3_options is defined and
      (rke2_etcd_snapshot_s3_options | keys | list) | contains('access_key') and
      (rke2_etcd_snapshot_s3_options | keys | list) | contains('secret_access_key') and
      (rke2_etcd_snapshot_s3_options | keys | list) | contains('bucket') }}"

- name: Restore etcd from file
  shell: |
    mkdir -p /var/lib/rancher/etcd
    cp {{ rke2_etcd_snapshot_file }} /var/lib/rancher/etcd/
    rke2 server --config=/etc/rancher/rke2/config.yaml --snapshot-restore-file=/var/lib/rancher/etcd/$(basename {{ rke2_etcd_snapshot_file }})
  when: do_etcd_restore

- name: Restore etcd from s3
  shell: |
