- name: Configure apt
  become: true
  apt:
    upgrade: yes
    exclude: "{{ update_excluded_packages }}"
  become_user: root
  when: ansible PackageManager == "apt"

- name: Update all software (dnf)
  dnf:
    name: "*"
    state: latest
    exclude: "{{ update_excluded_packages }}"
