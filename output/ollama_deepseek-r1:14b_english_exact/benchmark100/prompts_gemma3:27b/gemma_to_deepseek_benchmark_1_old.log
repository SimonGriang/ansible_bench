y comments or explanations, as per the user\'s instructions.\n\nFinally, I\'ll compile the tasks in the specified order, ensuring the playbook is valid and meets all the user\'s requirements.\n</think>\n\n```yaml\n---\n- name: Check Java Certificate Existence\n  stat:\n    path: "{{ item }}"\n    check_mode: no\n  with_items: "{{ java_certs }}"\n  register: check_java_certs\n\n- name: Fail if Java Certificate Doesn\'t Exist\n  fail:\n    msg: "Java certificate {{ item.path }} does not exist"\n  with_items: "{{ check_java_certs.results }}"\n  when: item.stat.exists is false\n\n- name: Set Keystore Directory for Java < 11\n  set_fact:\n    java_keystore_dir: "{{ java_keystore_dir_old }}"\n  when: java_keystore_dir is not defined or java_keystore_dir is None and java_open_jdk_version_major < 11\n\n- name: Set Keystore Directory for Java >= 11\n  set_fact:\n    java_keystore_dir: "{{ java_keystore_dir_new }}"\n  when: java_keystore_dir is not defined or java_keystore_dir is None and java_open_jdk_version_major >= 11\n\n- name: Import SSL Certificates into Java Keystore\n  java_cert:\n    path: "{{ item.path }}"\n    keystore_path: "{{ java_open_jdk_home }}/jre/lib/security/{{ java_keystore_dir }}"\n    keystore_pass: "{{ java_cert_keystore_pass }}"\n    alias: "{{ item.cert_alias }}"\n    state: present\n  with_items: "{{ java_certs }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-11T01:44:51.433762087Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11185106681, 'load_duration': 93037492, 'prompt_eval_count': 633, 'prompt_eval_duration': 257430276, 'eval_count': 776, 'eval_duration': 10833475508, 'model_name': 'deepseek-r1:14b'} id='run--b26b89cd-0c7d-4368-9a5c-264e6cd28942-0' usage_metadata={'input_tokens': 633, 'output_tokens': 776, 'total_tokens': 1409}
