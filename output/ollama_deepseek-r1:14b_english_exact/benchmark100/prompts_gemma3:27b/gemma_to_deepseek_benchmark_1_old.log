    rke2 server --config=/etc/rancher/rke2/config.yaml --snapshot-restore-s3-path="{{ rke2_etcd_snapshot_s3_path }}" --snapshot-restore-s3-bucket="{{ rke2_etcd_snapshot_s3_bucket }}" --snapshot-restore-s3-access-key="{{ rke2_etcd_snapshot_s3_options.access_key }}" --snapshot-restore-s3-secret-access-key="{{ rke2_etcd_snapshot_s3_options.secret_access_key }}"
  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
