e: Create vault_path if it does not exist\n  file:\n    path: "{{ vault_path }}"\n    state: directory\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: 0755\n  when:\n    - not vault_check_path.stat.exists\n    - ansible.utils.conditionals.ifbool("{{ vault_path | bool }}")\n\n- name: Create directory in vault_path\n  file:\n    path: "{{ item.path }}"\n    state: directory\n    mode: "{{ item.mode | default(\'0755\') }}"\n  with_items: "{{ vault_directories }}"\n\n- name: Create data directory\n  file:\n    path: "{{ item.path }}"\n    state: directory\n    mode: "{{ item.mode | default(\'0755\') }}"\n  with_items: "{{ vault_data_directories }}"\n\n- name: Generate TLS key and certificate\n  command: |\n    openssl req -x509 -newkey rsa:2048 -keyout tls.key -out tls.crt\n    -days 365 -sha256 -nodes -subj "/C=US/ST=State/L=City/O=Vault/OU=Vault/CN=Vault"\n  args:\n    chdir: "{{ vault_data_directory }}/tls/"\n  notify: Restart vault\n\n- name: Set ownership of tls material\n  file:\n    path: "{{ item.path }}"\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: "{{ item.mode | default(\'0644\') }}"\n  with_items: "{{ vault_tls_files }}"\n\n- name: Copy Vault binary\n  copy:\n    src: "{{ vault_download_path }}/vault"\n    dest: /usr/bin/vault\n    mode: 0755\n    owner: root\n    group: root\n  notify: Restart vault\n\n- name: Set cap_ipc_lock=ep on /usr/bin/vault\n  cap:\n    path: /usr/bin/vault\n    capabilities: cap_ipc_lock=ep\n    state: present\n    mode: set\n  become: yes\n\n- name: Touch vault.env\n  file:\n    path: "{{ vault_path }}/etc/vault.d/vault.env"\n    state: touch\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: 0644\n    preserve: yes\n  notify: Restart vault\n\n- name: Create /usr/lib/systemd/system\n  file:\n    path: /usr/lib/systemd/system\n    state: directory\n    owner: root\n    group: root\n    mode: 0755\n\n- name: Copy Vault service file\n  copy:\n    src: vault.service.j2\n    dest: /usr/lib/systemd/system/vault.service\n    mode: 0644\n    owner: root\n    group: root\n  notify: Daemon reload\n  when:\n    - ansible_system == "Linux"\n    - ansible_service_manager == "systemd"\n\n- name: Copy vault configuration\n  copy:\n    src: vault.hcl\n    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"\n    mode: 0644\n    owner: root\n    group: root\n  notify: Restart vault\n\n- name: Flush handlers\n  meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-10T23:27:19.722190123Z', 'done': True, 'done_reason': 'stop', 'total_duration': 29613795262, 'load_duration': 85967687, 'prompt_eval_count': 2276, 'prompt_eval_duration': 120249371, 'eval_count': 1597, 'eval_duration': 29406278578, 'model_name': 'deepseek-r1:14b'} id='run--2f4b978e-96d2-4df6-8426-69013462ac4a-0' usage_metadata={'input_tokens': 2276, 'output_tokens': 1597, 'total_tokens': 3873}
