---
- name: Import assert.yml
  include_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  apt:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_dir_mode }}"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true
    shell: /sbin/nologin
    group: "{{ dns_group }}"

- name: Generate rndc key
  command: rndc-confgen -a -f {{ dns_confdir }}/rndc.key
  args:
    chdir: "{{ dns_confdir }}"
  when: not file.exists({{ dns_confdir }}/rndc.key)

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_key_mode }}"

- name: Get the hints/root file
  get_url:
    url: "{{ dns_root_hints_url }}"
    dest: "{{ dns_datadir }}/named.root"
    mode: 0644
    remote_src: no
  when: dns_caching_dns | bool
  notify: Rndc reload

- name: Create zone file
  template:
    src: "{{ item.template }}"
    dest: "{{ item.path }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ item.mode }}"
  loop: "{{ dns_zones }}"
  notify: Rndc reload
  register: zone_files

- name: Validate zone file
  command: named-checkzone "{{ item.name }}" "{{ item.path }}"
  when: item.validation is defined and item.validation is true
  loop: "{{ zone_files.results }}"

- name: Add zones to configuration
  template:
    src: "templates/named.conf.j2"
    dest: "{{ dns_confdir }}/named.conf"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0644
    force: yes
  notify:
    - Rndc reload
    - Restart dns

- name: Place systemd override
  file:
    path: /etc/systemd/system/override.conf
    state: touch
    mode: 0644
  when: ansible_distribution in ["Debian", "Ubuntu"]
  notify: Systemd daemon reload

- name: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: yes


