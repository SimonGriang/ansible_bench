---
- name: Remove old Docker packages
  apt:
    name: "{{ docker_obsolete_packages }}"
    state: absent
  become: true
  when: docker.PackageManager == 'apt'

- name: Remove old Docker packages
  yum:
    name: "{{ docker_obsolete_packages }}"
    state: absent
  become: true
  when: docker.PackageManager == 'yum'

- name: Add Docker GPG key
  rpm:
    key: "{{ docker_yum_gpg_key }}"
    state: present
  become: true
  when: docker_add_repo

- name: Add Docker repository
  template:
    src: docker.repo.j2
    dest: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    owner: root
    group: root
    mode: 0644
  become: true
  when: docker_add_repo

- name: Configure Docker Nightly repo
  lineinfile:
    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    line: "enable_{docker_edition}_nightly={{ docker_yum_repo_enable_nightly }}"
    create: yes
  become: true
  when: docker_add_repo

- name: Configure Docker Test repo
  lineinfile:
    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo
    line: "enable_{docker_edition}_test={{ docker_yum_repo_enable_test }}"
    create: yes
  become: true
  when: docker_add_repo

- name: Configure containerd on RHEL 8
  block:
    - name: Ensure runc is uninstalled
      apt:
        name: runc
        state: absent
      become: true
      when: docker.PackageManager == 'apt'

    - name: Ensure runc is uninstalled
      yum:
        name: runc
        state: absent
      become: true
      when: docker.PackageManager == 'yum'

    - name: Ensure container-selinux is installed
      apt:
        name: container-selinux
        state: present
      become: true
      when: docker.PackageManager == 'apt'

    - name: Ensure container-selinux is installed
      yum:
        name: container-selinux
        state: present
      become: true
      when: docker.PackageManager == 'yum'

    - name: Ensure containerd.io is installed
      apt:
        name: containerd.io
        state: present
      become: true
      when: docker.PackageManager == 'apt'

    - name: Ensure containerd.io is installed
      yum:
        name: containerd.io
        state: present
      become: true
      when: docker.PackageManager == 'yum'
  when: ansible_facts.distribution_major_version == 8


