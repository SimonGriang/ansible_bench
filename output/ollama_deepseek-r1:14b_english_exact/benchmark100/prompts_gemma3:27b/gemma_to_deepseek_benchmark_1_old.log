---
- name: Check if the Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check
  ignore_errors: true

- name: Check Helm version
  command: helm version
  register: helm_existing_version
  changed_when: false
  failed_when: false

- name: Download helm
  unarchive:
    remote_src: true
    url: "{{ helm_repo_url }}/charts/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: /tmp
    remote_src: true
  register: helm_download
  when:
    - not helm_check.stat.exists
    - helm_existing_version.stdout_lines[0] != "v{{ helm_version }}"

- name: Copy helm binary into place
  copy:
    src: "/tmp/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}/helm"
    dest: "{{ helm_bin_path }}"
    mode: 0755
    remote_src: true
  become: true
  when: helm_download.changed


