---
- import_tasks: assert.yml
  run_once: true
  host: localhost

- name: Install apache httpd
  apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
  with_items: "{{ httpd_packages }}"
  when: ansible_os_family == 'Debian'
  become: yes

- name: Install apache httpd
  yum:
    name: "{{ item }}"
    state: present
  with_items: "{{ httpd_packages }}"
  when: ansible_os_family in ['RedHat', 'Suse']
  become: yes

- name: Configure selinux
  become: yes
  when: selinux_enabled | bool
  seboolean:
    name: "{{ item }}"
    state: yes
  with_items: "{{ httpd_sebooleans }}"

- name: Allow connections to custom ports
  become: yes
  seport:
    port: "{{ item }}"
    proto: tcp
    state: present
  with_items: "{{ httpd_port + httpd_ssl_port }}"

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify: httpd_config_test

- name: Activate httpd modules
  become: yes
  shell: "{{ item.cmd }} {{ item.module }}"
  with_items: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == 'Debian'

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: httpd_ports_conf.j2
    dest: "{{ httpd_server_root }}/httpd_ports.conf"
    mode: 0644
  notify: httpd_config_test
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_directory }}/example.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


