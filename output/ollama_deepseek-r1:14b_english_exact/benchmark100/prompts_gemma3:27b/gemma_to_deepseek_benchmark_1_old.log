tasks:
  - name: Task 1: create ssl key
    community.crypto.openssl_privatekey:
      dest: "{{ openssl_key_directory }}/{{ item.name }}.key"
      mode: "640"
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
    loop: "{{ items }}"

  - name: Task 2: create ssl csr
    community.crypto.openssl_csr:
      dest: "{{ openssl_csr_directory }}/{{ item.common_name }}.csr"
      mode: "644"
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
      privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
      common_name: "{{ item.common_name }}"
    loop: "{{ items }}"

  - name: Task 3: create ssl certificates
    community.crypto.x509_certificate:
      dest: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
      mode: "644"
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
      privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
      csr_path: "{{ openssl_csr_directory }}/{{ item.common_name }}.csr"
    loop: "{{ items }}"

  - name: Task 4: create PKCS#12 file
    community.crypto.openssl_pkcs12:
      dest: "{{ openssl_key_directory }}/{{ item.name }}.p12"
      mode: "640"
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
      friendly_name: "{{ item.name }}"
      privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
      certificate_path: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    loop: "{{ items }}"

  - name: Task 5: read private key
    ansible.builtin.slurp:
      src: "{{ openssl_key_directory }}/{{ item.name }}.key"
      dest: "{{ ansible_tmp_path }}/ssl_private_key.pem"
    register: openssl_private_key
    loop: "{{ items }}"

  - name: Task 6: read certificate
    ansible.builtin.slurp:
      src: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
      dest: "{{ ansible_tmp_path }}/ssl_certificate.pem"
    register: openssl_certificate
    loop: "{{ items }}"

  - name: Task 7: create combined private_key and certificate file
    ansible.builtin.copy:
      content: "{{ openssl_private_key.content | b64decode | trim() }}{{ '\n' }}{{ openssl_certificate.content | b64decode | trim() }}"
      dest: "{{ openssl_key_directory }}/{{ item.name }}.keycrt"
      mode: "640"
      owner: "{{ openssl_file_owner }}"
      group: "{{ openssl_file_group }}"
    loop: "{{ items }}"

