---
- name: Run assert tasks
  include_tasks:
    file: assert.yml
  run_once: true

- name: Install vsftpd package
  apt:
    name: vsftpd
    state: present

- name: Configure vsftpd using template
  template:
    src: vsftpd.conf.j2
    dest: "{{ vsftpd_configuration_file }}"
    owner: root
    group: root
    mode: "{{ vsftpd_configuration_file_mode }}"
  notify: "Restart vsftpd"

- name: Start and enable vsftpd service
  service:
    name: vsftpd
    state: started
    enabled: true


