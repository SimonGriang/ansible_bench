  become: false
  run_once: true
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Convert ssh key to ppk for user
  command: 
    - ssh-keygen 
    - o 
    - f "{{ user_ssh_key_file }}" 
    - t ppk 
    - out "{{ user_ssh_key_ppk_file }}"
  args:
    chdir: "{{ user_ssh_key_dir }}"
  become: false
  run_once: true
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Get or set the home directory for user
  command: getent passwd "{{ user.name }}" | cut -d: -f6
  register: user_home_dir
  become: true
  when: user.home is not defined

- name: Create .ssh directory for user
  file:
    path: "{{ user_home_dir.stdout }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  become: true
  when: user.manage_ssh_key is defined or user.private_keys is defined

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item.key }}"
    state: present
  loop: "{{ user.authorized_keys }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item.key }}"
    state: absent
  loop: "{{ user.unauthorized_keys }}"

- name: Copy generated private ssh key for user
  copy:
    src: "{{ user_ssh_key_file }}"
    dest: "{{ user_home_dir.stdout }}/.ssh/"
    remote_src: false
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.copy_private_key is defined

- name: Check users password valid time
  command: 
    - awk -F: '{print $7}' /etc/shadow 
    | cut -d= -f2
  register: user_password_expire
  become: true

- name: Set users password valid time
  user:
    name: "{{ user.name }}"
    password_validity_days: "{{ user.password_validity_days }}"
  when: user.password_validity_days is defined

- name: Place private key file for user
  copy:
    src: "{{ user.private_key_content }}"
    dest: "{{ user_ssh_key_dir }}"
    remote_src: false
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.group }}"
  when: user.private_keys is defined
