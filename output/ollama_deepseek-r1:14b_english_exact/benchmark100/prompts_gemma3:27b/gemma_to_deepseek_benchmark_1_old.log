---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  run_once: yes

- name: Install git
  apt:
    name: "{{ git_packages }}"
    state: present
  become: yes

- name: See if the specified user exists
  getent:
    user: "{{ git_username }}"
    fail_on_missing: "{{ fail_key | default('yes') }}"

- name: Create directory for git configuration
  file:
    path: /home/{{ git_username }}
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    setgid: yes
    setuid: yes

- name: Place git configuration
  copy:
    src: gitconfig.j2
    dest: /home/{{ git_username }}/.gitconfig
    remote_src: yes
    mode: 0o644

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    setgid: yes
    setuid: yes

- name: Clone all roles
  git:
    repo: "{{ repo_url }}"
    dest: "{{ dest_path }}"
    branch: "{{ branch_name }}"
    force: "{{ force_clone }}"
    remote: yes
    chdir: "{{ git_repository_destination }}"
  loop: "{{ git_repositories }}"
  become: yes
  run_as: "{{ git_username }}"
  loop_control:
    label: "{{ dest_path }}"


