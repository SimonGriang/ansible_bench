ta_directory }}/tls/"\n  notify: Restart vault\n\n- name: Set ownership of tls material\n  file:\n    path: "{{ item.path }}"\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: "{{ item.mode | default(\'0644\') }}"\n  with_items: "{{ vault_tls_files }}"\n\n- name: Copy Vault binary\n  copy:\n    src: "{{ vault_download_path }}/vault"\n    dest: /usr/bin/vault\n    mode: 0755\n    owner: root\n    group: root\n  notify: Restart vault\n\n- name: Set cap_ipc_lock=ep on /usr/bin/vault\n  cap:\n    path: /usr/bin/vault\n    capabilities: cap_ipc_lock=ep\n    state: present\n    mode: set\n  become: yes\n\n- name: Touch vault.env\n  file:\n    path: "{{ vault_path }}/etc/vault.d/vault.env"\n    state: touch\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: 0644\n    preserve: yes\n  notify: Restart vault\n\n- name: Create /usr/lib/systemd/system\n  file:\n    path: /usr/lib/systemd/system\n    state: directory\n    owner: root\n    group: root\n    mode: 0755\n\n- name: Copy Vault service file\n  copy:\n    src: vault.service.j2\n    dest: /usr/lib/systemd/system/vault.service\n    mode: 0644\n    owner: root\n    group: root\n  notify: Daemon reload\n  when:\n    - ansible_system == "Linux"\n    - ansible_service_manager == "systemd"\n\n- name: Copy vault configuration\n  copy:\n    src: vault.hcl\n    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"\n    mode: 0644\n    owner: root\n    group: root\n  notify: Restart vault\n\n- name: Flush handlers\n  meta: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-10T23:27:46.880913651Z', 'done': True, 'done_reason': 'stop', 'total_duration': 26645821893, 'load_duration': 99761296, 'prompt_eval_count': 2283, 'prompt_eval_duration': 447183705, 'eval_count': 1400, 'eval_duration': 26097450320, 'model_name': 'deepseek-r1:14b'} id='run--978ff3f6-169e-484c-80d0-e71895e6f0f4-0' usage_metadata={'input_tokens': 2283, 'output_token