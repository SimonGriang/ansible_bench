---
- name: Conditionally include Debian 12 tasks
  ansible.builtin.include_tasks:
    file: debian12.yml
    when: ansible_distribution == "Debian" and ansible_distribution_version >= "12"

- name: Install Pip
  apt:
    name: "{{ pip_package }}"
    state: present

- name: Install python3-packaging
  apt:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    executable: "{{ pip_executable }}"
    virtualenv: "{{ pip_virtualenv | default('') }}"
    name: "{{ item.name }}"
    version: "{{ item.version | default('') }}"
    state: "{{ item.state | default('present') }}"
    extra_args: "{{ item.extra_args | default('') }}"
  with_items: "{{ pip_install_packages | default([]) }}"



