---
- name: Load OS-specific variables
  vars_files:
    - "{{ ansible_distribution|lower|regex_replace('^(?P<dist>.+?)', '\\g<1>') }}.yml"
    - "vars/{{ ansible_facts.os_family|lower }}.yml"
    - vars/main.yml

- name: Include RedHat setup tasks
  include_tasks: tasks/redhat.yml
  when: ansible_facts.os_family == "RedHat"

- name: Include Debian setup tasks
  include_tasks: tasks/debian.yml
  when: ansible_facts.os_family == "Debian"

- name: Install Docker packages
  become: yes
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state | default('present') }}"
  notify: restart docker
  ignore_errors: yes
  when: ansible_version < "2.12" and ansible_facts.os_family in ['RedHat', 'Debian']

- name: Install Docker packages (with downgrade option)
  become: yes
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state | default('present') }}"
    version: "{{ docker_packages_version | default('') }}"
  notify: restart docker
  ignore_errors: yes
  when: ansible_version >= "2.12" and ansible_facts.os_family in ['RedHat', 'Debian']

- name: Install docker-compose plugin
  become: yes
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state | default('present') }}"
  notify: restart docker
  ignore_errors: yes
  when: docker_install_compose_plugin and ansible_version < "2.12" and ansible_facts.os_family in ['RedHat', 'Debian']

- name: Install docker-compose-plugin (with downgrade option)
  become: yes
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state | default('present') }}"
    version: "{{ docker_compose_package_version | default('') }}"
  notify: restart docker
  ignore_errors: yes
  when: docker_install_compose_plugin and ansible_version >= "2.12" and ansible_facts.os_family in ['RedHat', 'Debian']

- name: Ensure /etc/docker/ directory exists
  become: yes
  file:
    path: /etc/docker
    state: directory
    mode: "0755"
  when: docker_daemon_options is not empty

- name: Configure Docker daemon options
  become: yes
  copy:
    content: "{{ docker_daemon_options | to_json }}"
    dest: /etc/docker/daemon.json
    mode: "0644"
  when: docker_daemon_options is not empty
  notify: restart docker

- name: Ensure Docker is started and enabled at boot
  become: yes
  systemd:
    name: docker
    state: started
    enabled: "{{ docker_service_enabled | default('yes') }}"
  ignore_errors: yes

- name: Ensure handlers are notified now to avoid firewall conflicts
  flush_handlers: yes

- name: Include docker-compose tasks
  include_tasks: tasks/docker-compose.yml
  when:
    docker_install_compose

- name: Get docker group info using getent
  getent:
    group: docker

- name: Check if there are any users to add to the docker group
  set_fact:
    at_least_one_user_to_modify: "{{ (docker_users | default([]) | difference(ansible_groups.docker | default([])) | list) | not_empty }}"

- name: Include docker-users tasks
  include_tasks: tasks/docker-users.yml
  when: ansible_facts.at_least_one_user_to_modify is defined


