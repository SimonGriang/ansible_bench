rors: yes\n\n- name: Install python pip\n  pip:\n    name: "{{ item }}"\n    state: present\n  loop: "{{ python_pip_packages | default([]) }}"\n\n- name: Configure pip proxy\n  lineinfile:\n    path: /etc/pip.conf\n    line: index-url={{ python_pip_proxy }}\n    insertafter: "^HTTP_PROXY"\n    regextype: sh\n    regex: ^index-url=.*\n  when: python_pip_proxy is defined\n\n- name: Trust hosts\n  lineinfile:\n    path: /etc/pip.conf\n    line: trusted-host={{ item }}\n    insertafter: "^index-url"\n    regextype: sh\n    regex: ^trusted-host=.*\n  loop: "{{ python_pip_trusted_host | default([]) }}"\n\n- name: Update pip\n  pip:\n    name: pip\n    version: "{{ python_pip_pip_version | default(\'latest\') }}"\n    state: "{{ python_pip_pip_state | default(\'latest\') }}"\n  when: ansible_distribution not in [\'Debian\', \'Alpine\']\n\n- name: Install requested modules\n  pip:\n    name: "{{ item.name }}"\n    version: "{{ item.version | default(\'latest\') }}"\n    state: "{{ item.state | default(\'present\') }}"\n  loop: "{{ python_pip_modules | default([]) }}"\n  label: "Installing {{ item.name }}"\n  when: ansible_distribution not in [\'Debian\', \'Alpine\']\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-11T00:22:03.637833628Z', 'done': True, 'done_reason': 'stop', 'total_duration': 24442897152, 'load_duration': 102252701, 'prompt_eval_count': 965, 'prompt_eval_duration': 407381719, 'eval_count': 1360, 'eval_duration': 23931813180, 'model_name': 'deepseek-r1:14b'} id='run--21f9cb30-9f95-413f-aa04-b880a5edec30-0' usage_metadata={'input_tokens': 965, 'output_tokens': 1360, 'total_tokens': 2325}
