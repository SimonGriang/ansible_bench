ub_efi\n\n- name: Remove existing grub.cfg on EFI systems\n  ansible.builtin.file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: grub_efi.stat.exists\n\n- name: Install user template for grub\n  ansible.builtin.template:\n    src: 01_users.j2\n    dest: /etc/grub.d/01_users\n    owner: root\n    group: root\n    mode: 0o700\n  notify: Update grub\n\n- name: Add password to grub configuration on EFI systems\n  ansible.builtin.lineinfile:\n    path: /etc/grub2-efi.cfg\n    line: password_pbkdf2 {{ grub_user }} {{ grub_password }}\n    regexp: \'^password_pbkdf2 {{ grub_user }} {{ grub_password }}$\'\n    insertafter: EOF\n  when: grub_efi.stat.exists\n  notify: Update grub\n\n- name: Add password to grub configuration on MBR systems\n  ansible.builtin.lineinfile:\n    path: /etc/grub2.cfg\n    line: password_pbkdf2 {{ grub_user }} {{ grub_password }}\n    regexp: \'^password_pbkdf2 {{ grub_user }} {{ grub_password }}$\'\n    insertafter: EOF\n  when: grub_efi.stat.exists\n  notify: Update grub\n\n- name: Add --unrestricted flag to grub configuration\n  ansible.builtin.replace:\n    path: "{{ item }}"\n    regexp: \'CLASS=([^"]+)\'\n    replacement: \'CLASS="{{ CLASS }}" --unrestricted\'\n  with_items: "{{ grub_password_unrestricted_files }}"\n  when: grub_password_unrestricted\n  notify: Update grub\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-10T23:45:33.014201368Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17609550848, 'load_duration': 98055533, 'prompt_eval_count': 3185, 'prompt_eval_duration': 1907733199, 'eval_count': 838, 'eval_duration': 15602057833, 'model_name': 'deepseek-r1:14b'} id='run--7d0878c6-1f38-4ded-9dae-b0f24a3a5969-0' usage_metadata={'input_tokens': 3185, 'output_tokens': 838, 'total_tokens': 4023}
