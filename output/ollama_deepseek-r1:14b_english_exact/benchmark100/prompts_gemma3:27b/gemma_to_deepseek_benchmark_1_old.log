pt_eval_duration': 459597641, 'eval_count': 3716, 'eval_duration': 71101385694, 'model_name': 'deepseek-r1:14b'} id='run--d5ca5d84-c1ba-45c7-822b-6e33670e76b9-0' usage_metadata={'input_tokens': 1953, 'output_tokens': 3716, 'total_tokens': 5669} 75%|███████▌  | 75/100 [3:00:19<1:10:12, 168.48s/it]
