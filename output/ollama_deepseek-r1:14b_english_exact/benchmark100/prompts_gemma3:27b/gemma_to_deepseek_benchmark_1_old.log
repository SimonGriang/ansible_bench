---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  ignore_errors: yes

- name: Wait for port to be available
  community.general.wait_for_port:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is not null
    - not ansible_connection.startswith('docker')
    - bootstrap_wait_for_host | default(true) | bool

- name: Prepare system
  command: whoami
  become: false
  rescue:
    - name: Gather bootstrap facts
      setup:
        gather_subset: minimal
      become: false
    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages.split(',') | list }}"
        state: present
      become: "{{ bootstrap_become | bool }}"

- name: Gather ansible facts
  setup:
    gather_subset: minimal
  become: false

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages.split(',') | list }}"
    state: present
  become: "{{ bootstrap_become | bool }}"

