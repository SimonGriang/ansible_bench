g these changes, the playbook should pass ansible-lint. Let me structure the corrected YAML accordingly.\n</think>\n\n```yaml\n---\n- name: Create etcd group\n  ansible.builtin.group:\n    name: etcd\n    state: present\n\n- name: Create etcd user\n  ansible.builtin.user:\n    name: etcd\n    group: etcd\n    shell: /bin/nologin\n    comment: \'Etcd system user\'\n    state: present\n\n- name: Copy systemctl config file for kernel hardening\n  ansible.builtin.copy:\n    remote_src: true\n    src: /usr/local/share/rke2/rke2-cis-sysctl.conf\n    dest: /etc/sysctl.d/60-rke2-cis.conf\n    mode: 384\n  notify: Restart systemd-sysctl\n\n- name: Flush handlers\n  ansible.builtin.meta:\n    flush_handlers: true\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-11T02:22:47.863797846Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14060924861, 'load_duration': 91222171, 'prompt_eval_count': 1935, 'prompt_eval_duration': 1033084191, 'eval_count': 687, 'eval_duration': 12935604517, 'model_name': 'deepseek-r1:14b'} id='run--d86dea26-d821-4e32-85b4-d1155334d5d3-0' usage_metadata={'input_tokens': 1935, 'output_tokens': 687, 'total_tokens': 2622}
