---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost

- name: Install mysql
  apt:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: "{{ mysql_name }}-server.cnf
    dest: /etc/mysql/{{ mysql_name }}-server.cnf
    owner: root
    group: root
    mode: 0644
  notify: Systemctl daemon-reexec

- name: Configure mysql client
  template:
    src: "{{ mysql_name }}-client.cnf
    dest: /etc/mysql/{{ mysql_name }}-client.cnf
    owner: root
    group: root
    mode: 0644

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when:
    - ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta:
    flush_handlers: true

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    target: "{{ item }}"
    encoding: utf8
    collation: utf8_unicode_ci
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: List databases
  mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
  register: db_list
  changed_when: false

- name: Import database
  mysql_db:
    name: "{{ item }}"
    state: import
    target: "{{ item }}"
    sql_file: "{{ initial_import_target }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
  loop: "{{ mysql_databases | difference(db_list.databases)}}"
  when:
    - initial_import_target is defined
    - initial_import_target != ""
    - db_list is not defined or item not in db_list.databases

- name: Create users
  mysql_user:
    name: "{{ item.user }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}%"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta:
    flush_handlers: true


