t\n  loop: "{{ java_required_repositories_openjdk }}"\n\n- name: Install required libs (Debian)\n  apt:\n    name: "{{ item }}"\n    state: present\n  when: ansible_distribution == "Debian"\n  loop: "{{ java_required_libs_openjdk }}"\n  ignore_errors: yes\n\n- name: Install required libs (RedHat)\n  yum:\n    name: "{{ item }}"\n    state: present\n  when: ansible_distribution == "RedHat"\n  loop: "{{ java_required_libs_openjdk }}"\n  ignore_errors: yes\n\n- name: Install Java (Debian)\n  apt:\n    name: "{{ java_open_jdk_package }}"\n    version: "{{ java_open_jdk_version }}"\n    state: present\n\n- name: Install Java (RedHat)\n  yum:\n    name: "{{ java_open_jdk_package }}"\n    version: "{{ java_open_jdk_version }}"\n    state: present\n\n- name: Export environment variables\n  template:\n    src: jdk.sh.j2\n    dest: /etc/profile.d/jdk.sh\n\n- name: Source environment variables\n  shell: source /etc/profile\n\n- name: Correct java version selected (Debian, Java < 11)\n  alternatives:\n    name: java\n    path: "{{ java_open_jdk_home_dir }}/bin/java"\n    priority: 1\n    state: set\n  when: java_open_jdk_version | version < \'11\' and ansible_distribution == "Debian"\n\n- name: Correct java version selected (Debian, Java >= 11)\n  alternatives:\n    name: java\n    path: "{{ java_open_jdk_home_dir }}/bin/java"\n    priority: 1\n    state: set\n  when: java_open_jdk_version | version >= \'11\' and ansible_distribution == "Debian"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-11T01:38:02.044449808Z', 'done': True, 'done_reason': 'stop', 'total_duration': 24384167537, 'load_duration': 114365643, 'prompt_eval_count': 2252, 'prompt_eval_duration': 1187916681, 'eval_count': 1314, 'eval_duration': 23080299052, 'model_name': 'deepseek-r1:14b'} id='run--01f065fe-e181-4fc6-8180-52e90b07f9e5-0' usage_metadata={'input_tokens': 2252, 'output_tokens': 1314, 'total_tokens': 3566}
