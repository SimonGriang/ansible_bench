---
- name: Task 1: Import the assert.yml tasks file to perform initial checks and validations
  include_tasks: assert.yml

- name: Task 2: Install the python pip package using the package manager
  apt:
    name: "{{ python_pip_packages }}"
    state: present
  become: yes
  when: ansible_os_family == 'Debian'

- name: Task 2: Install the python pip package using the package manager
  yum:
    name: "{{ python_pip_packages }}"
    state: present
  become: yes
  when: ansible_os_family not in ['Debian']

- name: Task 3: Configure pip proxy settings in /etc/pip.conf
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    owner: root
    group: root
    mode: 0644
  when: python_pip_proxy is defined
  notify: Reload pip configuration

- name: Task 4: Configure trusted hosts for pip in /etc/pip.conf
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    owner: root
    group: root
    mode: 0644
  when: python_pip_trusted_host is defined
  notify: Reload pip configuration

- name: Task 5: Update the pip package itself
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when: |
    ansible_distribution not in ['bookworm', 'noble'] and
    ansible_distribution_family != 'alpine'

- name: Task 6: Install a list of python modules using the pip module
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default('latest') }}"
    executable: "{{ python_pip_executable }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ python_pip_modules }}"
  when: |
    ansible_distribution not in ['bookworm', 'noble'] and
    ansible_distribution_family != 'alpine'
  register: pip_result
  name: "Installing {{ item.name }} {{ item.version | default('latest') }}"


