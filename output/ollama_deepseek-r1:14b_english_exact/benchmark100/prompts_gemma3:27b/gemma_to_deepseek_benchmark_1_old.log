---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: rancher
    mode: 0755

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rancher/rke2/config.yml
    owner: rancher
    group: rancher
    mode: 0644
  notify: rke2_config_handler

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config_src }}"
    dest: /etc/systemd/system/kubelet.service.d/10-rke2.conf
    owner: rancher
    group: rancher
    mode: 0644
  when: rke2_kubelet_config
  notify: rke2_kubelet_handler

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_config_src }}"
    dest: /etc/containerd/config.json
    owner: rancher
    group: rancher
    mode: 0644
  when: rke2_custom_registry_mirrors or rke2_custom_registry_configs
  notify: rke2_containerd_handler

- name: Start RKE2 service on the rest of the nodes
  service:
    name: rke2
    state: started
    enabled: yes
    display_name: rke2
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  become: true
  register: rke2_service_result
  notify: rke2_service_handler

- name: Mask other RKE2 service on the rest of the nodes
  service:
    name: "{{ item }}"
    state: masked
    enabled: no
  loop: [rke2-agent, rke2-server]
  when: rke2_type in ['server', 'agent']

- name: Wait for remaining nodes to be ready - no CNI
  wait_for_nodes:
    binary_path: /usr/bin/kubectl
    ready_timeout: 300
    condition_timeout: 60
    check_kubelet: no
    check_cni: no
    check_node_info: yes
    check_memory: yes
    check_disk: yes
    check_pids: yes
  when: rke2_cni == 'none' and (ansible_hostname in (rke2_active_server, rke2_first_server))
  tags: [rke2_nodes_ready]

- name: Wait for remaining nodes to be ready - with CNI
  wait_for_nodes:
    binary_path: /usr/bin/kubectl
    ready_timeout: 300
    condition_timeout: 60
    check_cni: yes
    check_node_info: yes
    check_memory: yes
    check_disk: yes
    check_pids: yes
  when: rke2_cni != 'none' and (ansible_hostname in (rke2_active_server, rke2_first_server))
  tags: [rke2_nodes_ready]


