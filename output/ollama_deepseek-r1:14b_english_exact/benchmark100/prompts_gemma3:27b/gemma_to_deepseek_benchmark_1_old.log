he variables like \'bootstrap_os_family_map\' and \'bootstrap_search\' are used correctly.\n\nFinally, the playbook should be ready to be included in an Ansible Role\'s tasks/main.yml file.\n</think>\n\n```yaml\n---\n- name: gather bootstrap facts using raw command\n  raw: python3 -c \'import platform; print(platform.system())\'\n  register: bootstrap_facts\n  gather_facts: false\n  become: false\n\n- name: set bootstrap facts (I) based on OS release information\n  set_fact:\n    bootstrap_distribution: "{{ item }}"\n    bootstrap_distribution_major_version: "{{ major_version }}"\n  loop: "{{ bootstrap_os_family_map.keys() | list }}"\n  when:\n    - bootstrap_facts.rc == 0\n    - not bootstrap_distribution\n    - "{{ item }}" in bootstrap_facts.stdout_lines | regex_search(bootstrap_search)\n  vars:\n    major_version: "{{ bootstrap_facts.stdout_lines | regex_search(\'[0-9]+\') }}"\n\n- name: set bootstrap facts (II) based on OS family\n  set_fact:\n    bootstrap_os_family: "{{ item.key }}"\n  loop: "{{ bootstrap_os_family_map.items() }}"\n  when: "{{ item.value }}" contains bootstrap_distribution\n  loop_control:\n    label: "{{ item.key }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-10T23:51:00.596657212Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12278279230, 'load_duration': 95418145, 'prompt_eval_count': 542, 'prompt_eval_duration': 278722326, 'eval_count': 697, 'eval_duration': 11903055728, 'model_name': 'deepseek-r1:14b'} id='run--a591047f-733f-4fb6-9d57-0c03679fa9b6-0' usage_metadata={'input_tokens': 542, 'output_tokens': 697, 'total_tokens': 1239}
