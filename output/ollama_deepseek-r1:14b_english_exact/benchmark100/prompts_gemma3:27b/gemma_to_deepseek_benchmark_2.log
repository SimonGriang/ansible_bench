    name: "{{ rke2_service_name }}"
    state: restarted
    node_name: "{{ rke2_node_name }}"
  notify: Service (re)started

- name: Wait for all nodes to be ready
  shell: >
    "{{ rke2_data_path }}/bin/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes -o json | jq -r '.items[].status.conditions[] | select(.type == "Ready") | select(.status == "True") | .message' | wc -l"
  register: ready_node_count
  until: ready_node_count.stdout == "{{ rke2_cluster_group_name|length }}"
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_active_server | default(rke2_servers_group_name[0]) }}"
  run_once: true

- name: Wait for all pods to be ready
  shell: >
    "{{ rke2_data_path }}/bin/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get pods --all-namespaces -o json | jq -r '[.items[] | select(.status.phase != "Running" and .status.phase != "Succeeded") | .metadata.name] | length'
  register: pending_pods_count
  until: pending_pods_count.stdout == "0"
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_active_server | default(rke2_servers_group_name[0]) }}"
  run_once: true
  when: rke2_wait_for_all_pods_to_be_ready and not ansible_check_mode


