    kubectl get nodes -o=jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")]}{.status.conditions[?(@.type=="MemoryPressure")]}{.status.conditions[?(@.type=="DiskPressure")]}{.status.conditions[?(@.type=="PIDPressure")]}{.status.conditions[?(@.type=="NetworkUnavailable")]}{.status.conditions[?(@.type=="CNIInitialization")]} {end}' |
    grep -q 'Ready' && exit 0
  ignore_errors: true
  retries: 5
  delay: 30
  when: rke2_cni == 'none' and (ansible_hostname == '{{ rke2_active_server }}' or ansible_hostname == '{{ rke2_first_server }}')

- name: Wait for remaining nodes to be ready - with CNI
  shell: |
    kubectl get nodes -o=jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")]}{.status.conditions[?(@.type=="MemoryPressure")]}{.status.conditions[?(@.type=="DiskPressure")]}{.status.conditions[?(@.type=="PIDPressure")]}{.status.conditions[?(@.type=="NetworkUnavailable")]}{.status.conditions[?(@.type=="CNIInitialization")]} {end}' |
    grep -q 'Ready' && exit 0
  ignore_errors: true
  retries: 5
  delay: 30
  when: rke2_cni != 'none' and (ansible_hostname == '{{ rke2_active_server }}' or ansible_hostname == '{{ rke2_first_server }}')


