---
- name: Enable the Backports repository for Debian
  apt:
    repo: "deb http://deb.debian.org/debian-backports/ {{ ansible_distribution_version }}-backports main"
    state: present
  when: ansible_distribution_version | float < 9.0
  register: backports_repo

- name: Set the default_release fact for older Debian versions
  set_fact:
    ansible_default_release: backports
  when: ansible_distribution_version | float < 9.0

- name: Install Ansible
  apt:
    name: ansible
    state: "{{ ansible_package_state | default('present') }}"
    release: "{{ ansible_default_release }}"


