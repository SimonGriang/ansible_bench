---
- name: Import assert.yml
  import_tasks: assert.yml
  become: false
  tags: always
  changed_when: false
  register: assert_result
  hosts: localhost
  ignore_errors: yes

- name: Install requirements
  apt:
    name: bash
    state: present
  become: yes

- name: Install openjdk java (package)
  apt:
    name: "{{ 'java-' + ansible_distribution|lower|replace('ubuntu','oracle')|replace('debian','oracle')|replace('centos','oracle')|replace('rhel','oracle')|replace('ol','oracle') }}-openjdk"
    state: present
  become: yes
  environment: USE="{{ 'LD_LIBRARY_PATH=/usr/lib/jvm/java-{{ java_version }}/dist/' if java_version else '' }}"

- name: Install RPM
  copy:
    remote_src: yes
    src: "{{ java_rpm }}"
    dest: /tmp/
    group: root
    mode: 0o755
  become: yes
  when: java_source == "local" and java_format == "rpm"
  register: java_rpm_install
  ignore_errors: yes
  changed_when: java_rpm_install is not skipped

- name: Install DEB
  copy:
    remote_src: yes
    src: "{{ java_deb }}"
    dest: /tmp/
    group: root
    mode: 0o755
  become: yes
  when: java_source == "local" and java_format == "deb"
  register: java_deb_install
  ignore_errors: yes
  changed_when: java_deb_install is not skipped

- name: Install oracle java (rpm) (repository)
  yum:
    name: "{{ oracle_java_rpm_name }}"
    state: present
  become: yes
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  become: yes
  when: java_format == "targz" and java_vendor == "oracle"
  block:
    - name: Ensure installation directory exists
      file:
        path: "{{ java_install_dir }}"
        state: directory
        mode: 0o755
    - name: Extract targz file
      shell: tar -xzf /tmp/{{ java_targz }} -C "{{ java_install_dir }}"
      changed_when: false

- name: Install oracle java policy software (targz)
  become: yes
  when: java_jce and java_version == 8 and java_vendor == "oracle"
  block:
    - name: Extract JCE zip
      shell: unzip /tmp/{{ java_jce_zip }} -d "{{ java_install_dir }}"
      changed_when: false
    - name: Set permissions
      file:
        path: "{{ java_install_dir }}/jce_policy-{{ java_jce_version }}/lib"
        state: directory
        mode: 0o755
    - name: Copy JCE files
      copy:
        remote_src: yes
        src: "{{ java_jce_zip }}"
        dest: "{{ java_install_dir }}/jce_policy-{{ java_jce_version }}/lib/"
        group: root
        mode: 0o644

- name: Set alternative (targz)
  become: yes
  when: java_format == "targz" and ansible_distribution != "alpine" and java_vendor == "oracle"
  command: alternatives --install /usr/bin/java {{ java_name }} /usr/bin/java

- name: Find JAVA_HOME
  become: yes
  shell: readlink -f /usr/bin/java
  changed_when: false
  register: java_home_result

- name: Set JAVA_HOME in /etc/environment
  become: yes
  shell: echo "export JAVA_HOME={{ java_home_result.stdout }}" >> /etc/profile.d/java_home.sh
  changed_when: false


