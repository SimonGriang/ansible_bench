        mode: "{{ hashicorp_mode }}"
        owner: "{{ hashicorp_owner }}"
      loop: "{{ hashicorp_products | selectattr('version') | list }}"
      when: hashicorp_installation_method == "manual"
      label: "manual_install_{{ item.name }}"
  when: hashicorp_installation_method == "manual"


