---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: 0755
    owner: rancher
    group: rancher

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints | default('') }}"
  when: bool(rke2_type == 'server')

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints | default('') }}"
  when: bool(rke2_type == 'agent')

- name: Copy RKE2 config
  copy:
    remote_src: yes
    src: "{{ rke2_config_src }}"
    dest: "{{ rke2_config_dest }}"
    mode: 0644
    owner: rancher
    group: rancher
  notify: rke2_config_handler

- name: Copy kubelet config
  copy:
    remote_src: yes
    src: "{{ rke2_kubelet_config_src }}"
    dest: "{{ rke2_kubelet_config_dest }}"
    mode: 0644
    owner: rancher
    group: rancher
  when: bool(rke2_kubelet_config | length > 0)
  notify: rke2_config_handler

- name: Copy Containerd Registry Configuration file
  copy:
    remote_src: yes
    src: "{{ rke2_containerd_registry_config_src }}"
    dest: "{{ rke2_containerd_registry_config_dest }}"
    mode: 0644
    owner: rancher
    group: rancher
  when: bool(rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0)
  notify: rke2_config_handler

- name: Start RKE2 service on the rest of the nodes
  service:
    name: rke2
    state: started
    enabled: yes
    restart: 5s
    timeout: 30s
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  notify: rke2_service_handler

- name: Mask other RKE2 service on the rest of the nodes
  service:
    name: rke2-{{ item }}
    state: masked
  loop: ['server', 'agent']
  when: bool(item != rke2_type)

- name: Wait for remaining nodes to be ready - no CNI
  shell: >
    kubectl get nodes -o=jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")]}{.status.conditions[?(@.type=="MemoryPressure")]}{.status.conditions[?(@.type=="DiskPressure")]}{.status.conditions[?(@.type=="PIDPressure")]}{.status.conditions[?(@.type=="NetworkUnavailable")]}{.status.conditions[?(@.type=="CNIInitialization")} {end}' | grep -q 'Ready' && exit 0
  ignore_errors: yes
  retries: 5
  delay: 30
  when: rke2_cni == 'none' and (ansible_hostname == '{{ rke2_active_server }}' or ansible_hostname == '{{ rke2_first_server }}')

- name: Wait for remaining nodes to be ready - with CNI
  shell: >
    kubectl get nodes -o=jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")]}{.status.conditions[?(@.type=="MemoryPressure")]}{.status.conditions[?(@.type=="DiskPressure")]}{.status.conditions[?(@.type=="PIDPressure")]}{.status.conditions[?(@.type=="NetworkUnavailable")]}{.status.conditions[?(@.type=="CNIInitialization")} {end}' | grep -q 'Ready' && exit 0
  ignore_errors: yes
  retries: 5
  delay: 30
  when: rke2_cni != 'none' and (ansible_hostname == '{{ rke2_active_server }}' or ansible_hostname == '{{ rke2_first_server }}')


