---
- import_tasks: assert.yml

- block:
    - name: Install repository for RedHat
      file:
        path: /etc/yum.repos.d/hashicorp.repo
        content: "{{ hashicorp_repo_rhel_content }}"
        owner: root
        group: root
        mode: 0640
      when: ansible_os_family in ['RedHat', 'Rocky']

    - name: Install required package gpg
      apt:
        name: gpg
        state: present
      when: ansible_os_family == 'Debian'

    - name: Install apt key for Debian
      apt_key:
        key: "{{ hashicorp_gpg_key }}"
        state: present
        validate_certs: no
      when: ansible_os_family == 'Debian'

    - name: Install repository for Debian
      apt_repository:
        repo: "deb {{ hashicorp_debian_url }} {{ ansible_distribution_release }} main"
        state: present
        filename: hashicorp.list
        arch: "{{ hashicorp_architecture_mapping }}"
      when: ansible_os_family == 'Debian'

  name: Install using package
  when: hashicorp_installation_method == "package"

- block:
    - name: Install latest hashicorp product using package
      apt:
        name: "{{ item.product_name }}"
        state: latest
        become: yes
      loop: "{{ hashicorp_products }}"
      label: "Install latest {{ item.product_name }}"

    - name: Install versioned hashicorp product using package
      apt:
        name: "{{ item.product_name }}{{ version_coupler }}{{ item.version }}"
        version: "{{ item.version }}"
        state: present
        become: yes
      loop: "{{ hashicorp_products | selectattr('version') | list }}"
      label: "Install {{ item.product_name }} version {{ item.version }}"

  name: Install hashicorp product using package
  when: hashicorp_products is defined

- block:
    - name: Install hashicorp product manually
      unarchive:
        remote_src: yes
        src: "{{ hashicorp_src }}/{{ item.product_name }}/{{ hashicorp_archive }}"
        dest: "{{ hashicorp_destination }}"
        group: "{{ hashicorp_group }}"
        mode: "{{ hashicorp_mode }}"
        owner: "{{ hashicorp_owner }}"
        remote_tmp: /tmp
      loop: "{{ hashicorp_products }}"
      label: "Install {{ item.product_name }} manually"

  name: Install manually
  when: hashicorp_installation_method == "manual"


