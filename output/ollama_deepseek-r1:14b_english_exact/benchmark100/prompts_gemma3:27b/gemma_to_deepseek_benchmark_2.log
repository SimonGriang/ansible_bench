---
tasks:
  - name: Task 1: Import assert.yml
    import_tasks: assert.yml

  - name: Task 2: Install mysql
    apt:
      name: "{{ mysql_packages }}"
      state: present
    notify:
      - Set root password
      - Systemctl daemon-reexec

  - name: Task 3: Configure mysql server
    vars:
      configuration_options: "{{ mysql_configuration_options }}"
    template:
      src: "{{ mysql_name }}-server.cnf.j2"
      dest: "{{ mysql_name }}-server.cnf"
      mode: 0640
    notify:
      - Restart mysql server

  - name: Task 4: Configure mysql client
    template:
      src: "{{ mysql_name }}-client.cnf.j2"
      dest: "{{ mysql_name }}-client.cnf"
      mode: 0640

  - name: Task 5: Initialize mysql
    shell: "{{ mysql_initialize_command }}"
    when: ansible_distribution in ['Alpine', 'Archlinux']

  - name: Task 6: Start and enable mysql
    systemd:
      name: "{{ mysql_service }}"
      state: started
      enabled: yes

  - name: Task 7: Flush handlers
    meta: flush_handlers

  - name: Task 8: Place my.cnf
    copy:
      src: my.cnf.j2
      dest: /root/.my.cnf
      mode: 0640

  - name: Task 9: Create databases
    mysql_db:
      name: "{{ item.name }}"
      state: present
      login_user: root
      login_password: "{{ mysql_root_password }}"
      login_socket: "{{ mysql_socket }}"
    loop: "{{ mysql_databases }}"

  - name: Task 10: Create users
    mysql_user:
      name: "{{ item.name }}"
      password: "{{ item.password }}"
      priv: "{{ item.privileges }}"
      state: present
      login_user: root
      login_password: "{{ mysql_root_password }}"
      login_socket: "{{ mysql_socket }}"
    loop: "{{ mysql_users }}"

  - name: Task 11: Flush handlers again
    meta: flush_handlers

