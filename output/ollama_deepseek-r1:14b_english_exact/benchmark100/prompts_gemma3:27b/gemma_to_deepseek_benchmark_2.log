---
- name: Import assert.yml
  import_tasks: assert.yml
  become: false
  delegate_to: localhost
  run_once: true

- name: Install fail2ban
  apt:
    name: '{{ fail2ban_packages }}'
    state: present

- name: Copy filters in filter.d
  copy:
    src: '{{ fail2ban_filterd_path }}'
    dest: /etc/fail2ban/filter.d/
    remote_src: yes
    owner: root
    group: root
    mode: 0640
  notify: Restart fail2ban
  when: fail2ban_filterd_path | bool

- name: Configure fail2ban.local
  ini_file:
    path: /etc/fail2ban/fail2ban.local
    sections:
      '{{ item.section }}':
        '{{ item.option }}': '{{ item.value }}'
    mode: 0640
  with_items:
    - "{{ fail2ban_base_configuration | default([]) }}"
    - "{{ fail2ban_configuration | default([]) }}"
  notify: Restart fail2ban

- name: Configure jail.local
  ini_file:
    path: /etc/fail2ban/jail.local
    sections:
      '{{ item.section }}':
        '{{ item.option }}': '{{ item.value }}'
    mode: 0640
  with_items:
    - "{{ fail2ban_base_jail_configuration | default([]) }}"
    - "{{ fail2ban_jail_configuration | default([]) }}"
  notify: Restart fail2ban

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    mode: 0640
  when: not fail2ban_auth.stat.exists

- name: Start and enable fail2ban
  service:
    name: '{{ fail2ban_service }}'
    state: started
    enabled: yes


