---
- name: Gather service facts
  systemd:
    gather_facts: yes
  register: service_facts

- name: Set the active_server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when:
    - "'rke2-server.service' in ansible_facts.services"
    - ansible_hostname in groups['rke2_servers_group_name']
  delegate_to: "{{ item }}"
  with_items: "{{ groups[rke2_cluster_group_name] | default([]) }}"
  loop_control:
    label: "Checking {{ item }}"


