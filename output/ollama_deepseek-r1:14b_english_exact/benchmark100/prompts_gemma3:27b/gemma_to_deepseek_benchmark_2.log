---
- import_tasks: assert.yml
  host: localhost
  only_once: true

- name: Install mysql
  apt:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ini_file:
    path: "{{ mysql_name }}-server.cnf"
    sections:
      "{{ item.key }}":
        "{{ item.value }}"
    loop: "{{ mysql_configuration_options.items() }}"

- name: Configure mysql client
  ini_file:
    path: "{{ mysql_name }}-client.cnf"
    sections:
      mysql:
        socket: "{{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Arch']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
