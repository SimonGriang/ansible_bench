---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  silent: yes

- name: Install required packages
  apt:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta:
    flush_handlers: yes

- name: Configure selinux
  shell: setsebool -P -s {{ selinux_state }} -p {{ selinux_policy }}
  when:
    - ansible_selinux.status | default('not set') != 'disabled'
    - not containerized
  notify: Reboot

- name: Manage selinux booleans
  shell: setsebool -P {{ item.name }} {{ item.value }}
  loop: "{{ selinux_booleans | default([]) }}"
  when: selinux_booleans is defined
  vars:
    item_name: "{{ item.name }}"
    item_value: "{{ item.value | default('yes') }}"
  notify: Reboot


