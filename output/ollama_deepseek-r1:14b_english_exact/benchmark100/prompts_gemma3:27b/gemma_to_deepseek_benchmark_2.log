---
- name: Enable the Backports repository for Debian
  apt_repository:
    repo: "deb http://deb.debian.org/debian-backports/ {{ ansible_distribution_version }}-backports main"
    state: present
    filename: "backports-{{ ansible_distribution_version }}"
  when:
    - ansible_distribution_version is defined
    - ansible_distribution_version|float < 9

- name: Set the default_release fact for older Debian versions
  set_fact:
    ansible_default_release: "{{ 'unstable-backports' if ansible_distribution_version|float < 7 else 'stretch-backports' }}"
  when:
    - ansible_distribution_version is defined
    - ansible_distribution_version|float < 9

- name: Install Ansible
  apt_package:
    name: ansible
    state: "{{ ansible_package_state }}"
