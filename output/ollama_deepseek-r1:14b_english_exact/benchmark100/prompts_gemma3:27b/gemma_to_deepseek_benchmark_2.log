  when:
    - ansible_distribution_version is defined
    - ansible_distribution_version|float < 9

- name: Install Ansible
  apt_package:
    name: ansible
    state: "{{ ansible_package_state }}"
    release: "{{ ansible_default_release }}"
  when: ansible_default_release is defined

