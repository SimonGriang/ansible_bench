    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ db }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
    loop: "{{ mysql_databases }}"

