---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  args:
    host: localhost
    changed_when: false
    tags: []
    run_once: true

- name: Install requirements
  apt:
    name: bash
    state: present

- name: Install openjdk java (package)
  apt:
    name: openjdk
    state: present
  environment:
    USE: "java.awt.headless=true"

- name: Install RPM
  become: yes
  become_user: root
  copy:
    src: "{{ java_rpm }}"
    dest: /tmp/
    remote_src: yes
  apt:
    name: "{{ rpm_package_name }}"
    state: present
  when:
    - (java_source | default('local') | eq('local'))
    - (java_format | default('rpm') | eq('rpm'))

- name: Install DEB
  become: yes
  become_user: root
  copy:
    src: "{{ java_deb }}"
    dest: /tmp/
    remote_src: yes
  apt:
    name: "{{ deb_package_name }}"
    state: present
  when:
    - (java_source | default('local') | eq('local'))
    - (java_format | default('deb') | eq('deb'))

- name: Install oracle java (rpm) (repository)
  apt:
    name: "{{ oracle_rpm_package }}"
    state: present
  when:
    - (java_source | default('repository') | eq('repository'))
    - (java_format | default('rpm') | eq('rpm'))

- name: Configure oracle targz
  become: yes
  become_user: root
  file:
    path: /usr/lib/jvm/java-{{ java_version }}-oracle
    state: directory
  unarchive:
    src: "{{ targz_archive }}"
    dest: /usr/lib/jvm/java-{{ java_version }}-oracle
    remote_src: yes
  when:
    - (java_format | default('targz') | eq('targz'))
    - (java_vendor | default('oracle') | eq('oracle'))

- name: Install oracle java policy software (targz)
  become: yes
  become_user: root
  copy:
    src: "{{ jce_zip }}"
    dest: /usr/lib/jvm/java-{{ java_version }}-oracle
    remote_src: yes
  unarchive:
    src: "{{ jce_zip }}"
    dest: /usr/lib/jvm/java-{{ java_version }}-oracle
    remote_src: yes
  when:
    - java_jce
    - (java_version | default('8') | eq('8'))
    - (java_vendor | default('oracle') | eq('oracle'))

- name: Set alternative (targz)
  become: yes
  command: alternatives --install /usr/bin/java java {{ java_bin }} 1
  when:
    - (java_format | default('targz') | eq('targz'))
    - (ansible_distribution | default('Alpine') | ne('Alpine'))
    - (java_vendor | default('oracle') | eq('oracle'))

- name: Find JAVA_HOME
  command: sh -c "ls -l /usr/bin/java | awk '{print $6}'"
  register: java_home_path
  when:
    - (java_vendor | default('oracle') | eq('oracle'))
    - (java_format | default('targz') | eq('targz'))

- name: Set JAVA_HOME in /etc/environment
  become: yes
  template:
    src: java_home.sh.j2
    dest: /etc/profile.d/java_home.sh
  when:
    - (java_vendor | default('oracle') | eq('oracle'))
    - (java_format | default('targz') | eq('targz'))


