---
- name: "Import assert"
  import_tasks: assert.yml
  delegate_to: localhost

- name: "Install cron"
  package:
    name: "{{ cron_packages }}"
    state: present

- name: "Configure shell"
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    regex: '^SHELL='
    state: present
    mode: 0600

- name: "Configure path"
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    regex: '^PATH='
    state: present
    mode: 0600

- name: "Configure mailto"
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    regex: '^MAILTO='
    state: present
    mode: 0600

- name: "Start and enable cron"
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service

- name: "Schedule requested cron jobs"
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
    state: present
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined

