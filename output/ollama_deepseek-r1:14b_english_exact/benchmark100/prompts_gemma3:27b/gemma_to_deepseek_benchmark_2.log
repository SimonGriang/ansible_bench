---
- name: Task 1: Import assert.yml
  block:
    - import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2: Install cron
  apt:
    name: "{{ cron_packages }}"
    state: present

- name: Task 3: Configure shell
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    state: present
    create: yes
    regex: '^SHELL=.*'
    notify: Restart cron
    mode: 0600

- name: Task 4: Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    state: present
    create: yes
    regex: '^PATH=.*'
    notify: Restart cron
    mode: 0600

- name: Task 5: Configure mailto
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    state: present
    create: yes
    regex: '^MAILTO=.*'
    notify: Restart cron
    mode: 0600

- name: Task 6: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service | length > 0

- name: Task 7: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
    state: "{{ item.state }}"
  loop: "{{ cron_jobs }}"
  when: cron_jobs is defined


