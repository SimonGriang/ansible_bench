---
- name: Check OS compatibility
  shell: curl -s https://raw.githubusercontent.com/ansible/ansible/devel/examples/commands/os_version.sh
  register: os_check

- name: Install epel gpg key
  yum:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install epel-release package
  yum_repository:
    name: epel
    description: EPEL
    baseurl: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Install epel-next-release package
  yum_repository:
    name: epel-next
    description: EPEL Next
    baseurl: "{{ epel_next_url }}"
    state: present
  when: epel_next
  notify: Update package cache



