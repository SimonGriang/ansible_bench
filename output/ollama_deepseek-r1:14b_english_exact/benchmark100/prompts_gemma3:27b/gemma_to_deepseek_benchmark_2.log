---
- name: Install Keepalived when HA mode is enabled
  ansible.builtin.include_tasks: keepalived.yml
  when:
    - rke2_ha_mode_enabled
    - groupvar.rke2_servers_group_name | default is in groups
    - rke2_api_ip is defined

- name: Download and install RKE2
  ansible.builtin.include_tasks: rke2.yml

- name: CIS Hardening
  ansible.builtin.include_tasks: cis.yml
  when:
    - rke2_cis_profile | length > 0

- name: Find Active Server
  ansible.builtin.include_tasks: find_active_server.yml

- name: Enable IPVS kernel module
  ansible.builtin.include_tasks: ip_vs.yml
  when:
    - rke2_kubevip_ipvs_lb_enable
    - groupvar.rke2_servers_group_name | default is in groups
    - rke2_ha_mode_enabled
    - not rke2_keepalived_used

- name: Copy kube-vip manifests to the masternode
  ansible.builtin.include_tasks: kubevip.yml
  when:
    - rke2_ha_mode_enabled
    - rke2_kubevip_enable
    - not rke2_keepalived_used

- name: Copy ingress-nginx manifests to the masternode
  ansible.builtin.include_tasks: ingress-nginx.yml
  when:
    - rke2_ingress_nginx_values | length > 0

- name: Prepare very first server node in the cluster
  ansible.builtin.include_tasks: first_server.yml
  when:
    - groupvar.rke2_servers_group_name | default is in groups
    - (rke2_active_server | length == 0 or not rke2_active_server)
    - (groupvar.rke2_cluster_group_name | default is in groups | length == 1)

- name: Restore etcd specific tasks
  ansible.builtin.include_tasks: first_server_restore.yml
  when:
    - rke2_active_server | length > 0
    - (groupvar.rke2_servers_group_name | default is in groups == rke2_active_server or groupvar.rke2_servers_group_name | default is in groups | index 0 == rke2_active_server)
    - (rke2_do_etcd_restore or rke2_do_etcd_restore_from_s3)

- name: Download kubeconfig to ansible localhost
  ansible.builtin.include_tasks: download_kubeconfig.yaml
  when:
    - rke2_download_kubeconf
    - groupvar.rke2_servers_group_name | default is in groups | index 0 == inventory_hostname

- name: Prepare and join remaining nodes of the cluster
  ansible.builtin.include_tasks: remaining_nodes.yml
  when:
    - rke2_active_server | length > 0
    - (groupvar.rke2_cluster_group_name | default is in groups | length > 1)

- name: Rolling cordon and drain restart when version changes - servers
  ansible.builtin.include_tasks: rolling_restart.yml
  when:
    - rke2_installed_version | defined
    - rke2_installed_version != rke2_version

- name: Rolling cordon and drain restart when version changes - agents
  ansible.builtin.include_tasks: rolling_restart_agents.yml
  when:
    - rke2_installed_version | defined
    - rke2_installed_version != rke2_version
    - not groupvar.rke2_servers_group_name | default is in groups

- name: Flush handlers
  ansible.builtin.handler: meta=flush_handlers

- name: Rolling restart when config files change
  ansible.builtin.include_tasks: rolling_restart.yml
  when:
    - rke2_restart_needed

- name: Final steps
  ansible.builtin.include_tasks: summary.yml


