---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  become: false

- name: Install using package
  block:
    - name: Install repository for RedHat
      get_url:
        url: https://releases.hashicorp.com/repos/hashicorp/yum.repo
        dest: /etc/yum.repos.d/hashicorp.repo
        mode: 0640
      vars:
        ansible_python_interpreter: /usr/bin/python3
      when: ansible_os_family == "RedHat"

    - name: Configure debian
      block:
        - name: Install required package gpg
          apt:
            name: gpg
            state: present
          become: true

        - name: Install apt key for Debian
          apt_key:
            key: https://apt.releases.hashicorp.com/gpg.key
            state: present
            validate_certs: no

        - name: Install repository for Debian
          apt_repository:
            repo: |
              deb [arch={{ hashicorp_architecture_mapping }}
                   ] https://apt.releases.hashicorp.com {{ ansible_distribution_version }}
            state: present
          become: true
      when: ansible_os_family == "Debian"

    - name: Install hashicorp product using package
      block:
        - name: Install latest hashicorp product using package
          apt:
            name: "{{ item.name }}"
            state: latest
          loop: "{{ hashicorp_products }}"
          when: hashicorp_products is defined
          become: true
          label: "install_{{ item.name }}"

        - name: Install versioned hashicorp product using package
          apt:
            name: "{{ item.name }}{{ version_coupler }}{{ item.version }}"
            version: "{{ item.version }}"
            state: present
          loop: "{{ hashicorp_products | selectattr('version') | list }}"
          when: hashicorp_products is defined
          become: true
          label: "install_versioned_{{ item.name }}"

      when: hashicorp_products is defined

  when: hashicorp_installation_method == "package"

- name: Install manually
  block:
    - name: Install hashicorp product manually
      unarchive:
        remote_src: true
        src: "{{ hashicorp_src }}/{{ item.name }}/{{ item.version }}.tar.gz"
        dest: "{{ hashicorp_dest_dir }}"
        group: "{{ hashicorp_group }}"
        mode: "{{ hashicorp_mode }}"
        owner: "{{ hashicorp_owner }}"
      loop: "{{ hashicorp_products | selectattr('version') | list }}"
      when: hashicorp_installation_method == "manual"
      label: "manual_install_{{ item.name }}"
  when: hashicorp_installation_method == "manual"


