---
- name: Check OS compatibility
  ansible.builtin.meta:
    clear_facts: false
  when:
    - ansible_os_family == "RedHat" and
      (ansible_distribution == "Amazon" or
       (ansible_distribution == "RedHat" and
        (ansible_redhat_version | int >= 7 and
         ansible_redhat_version | int <= 10)))
  run_once: true

- name: Install epel gpg key
  ansible.legacy.yum:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install epel-release package
  ansible.legacy.yum:
    name: "{{ epel_url }}"
    state: present
  notify: Update package cache

- name: Install epel-next-release package
  ansible.legacy.yum:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next
  notify: Update package cache


