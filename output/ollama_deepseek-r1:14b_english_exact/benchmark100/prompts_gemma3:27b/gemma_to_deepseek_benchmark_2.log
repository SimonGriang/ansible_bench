---
- import_tasks: assert.yml
  host: localhost
  only_once: true

- name: Install mysql
  apt:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ini_file:
    path: "{{ mysql_name }}-server.cnf"
    sections:
      "{{ item.key }}":
        "{{ item.value }}"
    loop: "{{ mysql_configuration_options.items() }}"

- name: Configure mysql client
  ini_file:
    path: "{{ mysql_name }}-client.cnf"
    sections:
      mysql:
        socket: "{{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['Alpine', 'Arch']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  mysql_db:
    name: "{{ db }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
    loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ user }}"
    password: "{{ password }}"
    priv: all privileges
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    socket: "{{ mysql_socket }}"
    loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers



