---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  apt:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  flush_handlers:
    delegate_to: localhost
    run_once: true

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  notify: Reboot

- name: Manage selinux booleans
  loop: "{{ selinux_booleans }}"
  with_name: boolean_name
  selinux_boolean:
    name: "{{ boolean_name }}"
    value: "{{ boolean_value | default('yes') }}"
    persist: "{{ boolean_persist | default('yes') }}"
  when: selinux_booleans is defined


