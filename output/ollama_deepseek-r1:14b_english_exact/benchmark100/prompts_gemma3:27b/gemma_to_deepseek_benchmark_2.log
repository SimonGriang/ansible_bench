---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install nginx
  apt:
    name: nginx
    state: present

- name: Place nginx.conf
  template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: 0644
  notify: Restart nginx
  args:
    cmd: nginx -t -c /etc/nginx/nginx.conf

- name: Ensure /etc/nginx/conf.d exists
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: 0755

- name: Place default.conf
  template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: 0644
  notify: Restart nginx

- name: Start and enable nginx
  service:
    name: nginx
    state: started
    enabled: true


