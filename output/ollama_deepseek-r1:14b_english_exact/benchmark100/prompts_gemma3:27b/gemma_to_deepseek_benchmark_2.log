  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service | length > 0 | bool

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
