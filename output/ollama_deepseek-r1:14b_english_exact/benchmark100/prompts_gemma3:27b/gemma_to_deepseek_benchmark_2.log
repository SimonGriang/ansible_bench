---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  args:
    host: localhost
    changed_when: false
    tags: []
    run_once: true

- name: Install requirements
  apt:
    name: bash
    state: present

- name: Install openjdk java (package)
  apt:
    name: openjdk
    state: present
  environment:
    USE: "java.awt.headless=true"

- name: Install RPM
  become: yes
  become_user: root
  copy:
    src: "{{ java_rpm }}"
    dest: /tmp/
    remote_src: yes
  apt:
    name: "{{ rpm_package_name }}"
    state: present
  when:
    - ansible.builtin.bool(java_source | default("local") | eq("local"))
    - ansible.builtin.bool(java_format | default("rpm") | eq("rpm"))

- name: Install DEB
  become: yes
  become_user: root
  copy:
    src: "{{ java_deb }}"
    dest: /tmp/
    remote_src: yes
  apt:
    name: "{{ deb_package_name }}"
    state: present
  when:
    - ansible.builtin.bool(java_source | default("local") | eq("local"))
    - ansible.builtin.bool(java_format | default("deb") | eq("deb"))

- name: Install oracle java (rpm) (repository)
  apt:
    name: "{{ oracle_rpm_package }}"
    state: present
  when:
    - ansible.builtin.bool(java_source | default("repository") | eq("repository"))
    - ansible.builtin.bool(java_format | default("rpm") | eq("rpm"))

- name: Configure oracle targz
  become: yes
  become_user: root
  file:
    path: /usr/lib/jvm/java-{{ java_version }}-oracle
    state: directory
  unarchive:
    src: "{{ targz_archive }}"
    dest: /usr/lib/jvm/java-{{ java_version }}-oracle
    remote_src: yes
  when:
    - ansible.builtin.bool(java_format | default("targz") | eq("targz"))
    - ansible.builtin.bool(java_vendor | default("oracle") | eq("oracle"))

- name: Install oracle java policy software (targz)
  become: yes
  become_user: root
  copy:
    src: "{{ jce_zip }}"
    dest: /usr/lib/jvm/java-{{ java_version }}-oracle
    remote_src: yes
  unarchive:
    src: "{{ jce_zip }}"
    dest: /usr/lib/jvm/java-{{ java_version }}-oracle
    remote_src: yes
  when:
    - java_jce
    - ansible.builtin.bool(java_version | default("8") | eq("8"))
    - ansible.builtin.bool(java_vendor | default("oracle") | eq("oracle"))

- name: Set alternative (targz)
  become: yes
  command: alternatives --install /usr/bin/java java {{ java_bin }} 1
  when:
    - ansible.builtin.bool(java_format | default("targz") | eq("targz"))
    - ansible.builtin.bool(ansible_distribution | default("Alpine") | ne("Alpine"))
    - ansible.builtin.bool(java_vendor | default("oracle") | eq("oracle"))

- name: Find JAVA_HOME
  command: sh -c "ls -l /usr/bin/java | awk '{print $6}'"
  register: java_home_path
  when:
    - ansible.builtin.bool(java_vendor | default("oracle") | eq("oracle"))
    - ansible.builtin.bool(java_format | default("targz") | eq("targz"))

- name: Set JAVA_HOME in /etc/environment
  become: yes
  template:
    src: java_home.sh.j2
    dest: /etc/profile.d/java_home.sh
  when:
    - ansible.builtin.bool(java_vendor | default("oracle") | eq("oracle"))
    - ansible.builtin.bool(java_format | default("targz") | eq("targz"))


