---
- name: Update package cache
  apt:
    state: update

- name: Install Docker
  apt:
    name: "{{ item }}"
    state: present
  with_items:
    - docker.io
    - docker-engine

- name: Start Docker service
  service:
    name: docker
    state: started

- name: Download and Install RKE2
  apt:
    repo: "deb [arch=$(dpkg --print-architecture) 2>/dev/null] https://rke2-release.s3.amazonaws.com/v1.4.x/ stable"
    state: present
  command:
    cmd: curl -sfL https://get.rke2.io | bash -

- name: Service (re)started
  handler:
    name: restart_docker
    command: systemctl restart docker

- name: Wait for all nodes to be ready
  community.rke2.wait_for_nodes_in_cluster:
    state: present


