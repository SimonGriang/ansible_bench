---
- name: Restart the RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready
  shell: "{{ rke2_data_path }}/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get nodes -o json | jq -r '.items[].status.conditions[] | select(.type=="Ready") | select(.status=="True") | .nodeId' | wc -l"
  register: ready_nodes_count
  until: ready_nodes_count.stdout == "{{ rke2_cluster_group_name | length }}"
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_servers_group_name | first() }}"
  run_once: yes

- name: Wait for all pods to be ready
  shell: "{{ rke2_data_path }}/kubectl --kubeconfig=/etc/rancher/rke2/rke2.yaml get pods --all-namespaces -o json | jq -r '.items[] | select(.status.phase != "Running" and .status.phase != "Succeeded") | .metadata.namespace + "/" + .metadata.name' | wc -l"
  register: unready_pods_count
  until: unready_pods_count.stdout == "0"
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_servers_group_name | first() }}"
  run_once: yes
  when: rke2_wait_for_all_pods_to_be_ready and not check_mode


