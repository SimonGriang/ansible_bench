- name: group | Set sudo options for group {{ group.name }}
  ansible.builtin.template:
    src: sudo_group.j2
    dest: /etc/sudoers.d/{{ group.name | replace(".", "dot") }}
    mode: '0640'
    validate_with: /usr/sbin/visudo -cf %s
  when: group.sudo_options is defined
  loop: "{{ group.members | default([]) }}"
  loop_control:
    label: "{{ group.name }}"


