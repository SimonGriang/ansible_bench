---
- name: Create directories for HTTPD
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_directories }}"
  loop_control:
    label: "{{ item.path }}"

- name: Configure directories for HTTPD
  ansible.builtin.template:
    src: directory.conf.j2
    dest: httpd_config_directory/{{ item.name }}.conf
    mode: '0644'
  loop: "{{ httpd_directories }}"
  loop_control:
    label: "{{ item.name }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd


