---
- name: Check current docker-compose version
  command:
    executable: "{{ docker_compose_path }}"
    args: --version
  register: docker_compose_vsn
  changed_when: false
  failed_when: false

- name: Delete existing docker-compose version if it's different
  file:
    path: "{{ docker_compose_path }}"
    state: absent
  when:
    - docker_compose_vsn is not skipped
    - (docker_compose_vsn | default("")).lstrip("v") != "{{ docker_compose_version }}"

- name: Install Docker Compose (if configured)
  get_url:
    url: "{{ docker_compose_url }}"
    dest: "{{ docker_compose_path }}"
    mode: 0755
    remote_src: yes
  when:
    - (docker_compose_version is not defined or docker_compose_version == "")
    - (docker_compose_vsn | default("")).lstrip("v") | version_compare | default(0) < "{{ docker_compose_version | version_compare | default(0)}}"


