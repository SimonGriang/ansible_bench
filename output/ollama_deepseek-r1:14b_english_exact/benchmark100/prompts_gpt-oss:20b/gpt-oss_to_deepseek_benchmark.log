---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install DNS packages
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode | default('0755') }}"
    owner: "{{ item.owner | default('root') }}"
    group: "{{ item.group | default('root') }}"
  loop:
    - { path: "{{ dns_datadir }}", mode: "1770", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }
    - { path: "{{ dns_confdir }}", mode: "0755", owner: "root", group: "root" }
  loop_control:
    label: "{{ item.path }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true

- name: Generate rndc key
  command: rndc-confgen -a -c /dev/null -s 127.0.0.1 -p 9001 | grep key.*HMAC-SHA256 | awk '{print $2}' > "{{ dns_confdir }}/rndc.key"
  creates: "{{ dns_confdir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0640"

- name: Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.root
    dest: "{{ dns_datadir }}/named.root"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns
  notify: Rndc reload

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.db"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop: "{{ dns_zones | selectattr('type') | rejectattr('type', 'defined') | union(dns_zones | selectattr('type', '==', 'primary')) | list }}"
  loop_control:
    label: "{{ item.name }}"
  notify: Rndc reload
  register: zone_file

- name: Validate zone file
  command: named-checkzone "{{ item.name }}" "{{ dns_datadir }}/{{ item.name }}.db"
  args:
    chdir: "{{ dns_datadir }}"
  when: zone_file is changed

- name: Render DNS configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    mode: "0640"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    backup: yes
  notify: Restart dns
  register: named_conf

- name: Validate configuration
  command: named-checkconf -zj "{{ dns_confdir }}/named.conf"
  when: named_conf is changed

- name: Place systemd override
  block:
    - file:
        path: "/etc/systemd/system/{{ dns_service }}.service.d"
        state: directory
        mode: "0755"
      when: ansible_service_mgr == "systemd"

    - copy:
        src: override.conf
        dest: "/etc/systemd/system/{{ dns_service }}.service.d/override.conf"
        owner: root
        group: root
        mode: "0644"
      when: ansible_service_mgr == "systemd"

    - command: systemctl daemon-reload
      when: ansible_service_mgr == "systemd"
      changed_when: no

- name: Start and enable DNS
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: yes
