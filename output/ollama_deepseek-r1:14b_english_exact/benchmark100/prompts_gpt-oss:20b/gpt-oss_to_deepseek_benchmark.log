nce it\'s part of an Ansible Role, I won\'t include hosts or vars sections, just the tasks.\n\nI\'ll make sure each task is in the correct order and that variables are correctly referenced. I\'ll also ensure that conditions are properly applied where necessary, like in Tasks 3 and 7.\n\nFinally, I\'ll review the entire playbook to ensure it meets all the requirements and adheres to YAML and Ansible standards. That should cover all tasks as specified.\n</think>\n\n```\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  delegate_to: localhost\n  no_log: true\n\n- name: Install requirements\n  package:\n    name: "{{ item }}"\n    state: present\n  loop: "{{ openssl_requirements }}"\n\n- name: Install pip packages\n  pip:\n    packages: "{{ openssl_pip_packages }}"\n  when: "{{ openssl_pip_packages | list }} | length > 0"\n\n- name: Create key directory\n  file:\n    path: "{{ openssl_key_directory }}"\n    state: directory\n    mode: \'700\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create csr directory\n  file:\n    path: "{{ openssl_csr_directory }}"\n    state: directory\n    mode: \'755\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create crt directory\n  file:\n    path: "{{ openssl_crt_directory }}"\n    state: directory\n    mode: \'755\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Include create.yml\n  import_tasks: create.yml\n  loop: "{{ openssl_items }}"\n  loop_var: item_name\n  with_items: "{{ openssl_items }}"\n  when: "{{ openssl_items | list }} | length > 0"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-16T17:46:31.674231523Z', 'done': True, 'done_reason': 'stop', 'total_duration': 18099509693, 'load_duration': 93590722, 'prompt_eval_count': 608, 'prompt_eval_duration': 362623514, 'eval_count': 815, 'eval_duration': 17642070891, 'model_name': 'deepseek-r1:1