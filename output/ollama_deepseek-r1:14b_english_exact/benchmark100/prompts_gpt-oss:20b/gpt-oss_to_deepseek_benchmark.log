---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  apt:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts
  when: ansible.builtin.bool(selinux_requirements)

- name: Flush handlers
  meta:
    flush_handlers: yes

- name: Manage selinux
  ansible.posix.selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when:
    - ansible_selinux.status is defined
    - containerized is not defined
  notify: Reboot

- name: Manage selinux booleans
  ansible.posix.seboolean:
    name: "{{ item }}"
    state: yes
    persistent: true
  when: ansible.builtin.bool(selinux_booleans)
  loop: "{{ selinux_booleans }}"
  loop_control:
    label: "{{ item }}"


