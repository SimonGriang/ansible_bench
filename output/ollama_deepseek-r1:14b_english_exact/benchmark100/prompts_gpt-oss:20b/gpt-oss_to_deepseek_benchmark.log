---

- name: Disable swap
  ansible.builtin.command:
    cmd: swapoff -a
  when: ansible_swaptotal_mb > 0
  block:
    - name: Remove swap entry
      ansible.posix.mount:
        name: swap
        state: absent

- name: Disable core dumps
  community.general.pam_limits:
    domain: '*'
    limit_item: core
    value: 0
    limit_type: "{{ item }}"
  loop:
    - soft
    - hard
  loop_control:
    label: "{{ item }}"

- name: Disable Shell Command History
  ansible.builtin.copy:
    content: "export HISTIGNORE=\"&:vault*\""
    dest: /etc/profile.d/vault.sh
    mode: 0644
    owner: root
    group: root
  when: vault_hardening_disable_shell_command_history

- name: Configure SELinux
  ansible.builtin.package:
    name: selinux-policy
    state: present
  when: vault_hardening_configure_selinux_apparmor
        and ansible_selinux.status == "enabled"

- name: Set SELinux enforcing mode
  ansible.posix.selinux:
    policy: targeted
    state: enforcing
  when: vault_hardening_configure_selinux_apparmor
        and ansible_selinux.status == "enabled"

- name: Enable AppArmor
  ansible.builtin.command:
    cmd: aa-enforce /etc/apparmor.d/usr.bin.vault
  when: ansible_apparmor.status == "enabled"

