---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install logrotate
  ansible.builtin.package:
    name: "{{ logrotate_packages | default('logrotate') }}"
    state: present

- name: Configure logrotate
  ansible.builtin.template:
    src: "{{ logrotate_config_file }}.j2"
    dest: "{{ logrotate_config_directory }}/{{ logrotate_config_file }}"
    mode: "0644"

- name: Generate logrotate.d files
  ansible.builtin.template:
    src: entry.j2
    dest: "{{ logrotate_confd_directory }}/{{ item.name }}"
    mode: "0644"
  loop: |
    {% for item in logrotate_entries | default([]) %}
      {% if item.name is defined %}
        {% if item.state is undefined or item.state != 'absent' %}
          {{ item }}
        {% endif %}
      {% endif %}
    {% endfor %}
  loop_control:
    label: "{{ item.name }}"

- name: Remove logrotate.d files
  ansible.builtin.file:
    path: "{{ logrotate_confd_directory }}/{{ item.name }}"
    state: absent
  loop: |
    {% for item in logrotate_entries | default([]) %}
      {% if item.name is defined %}
        {% if item.state == 'absent' %}
          {{ item }}
        {% endif %}
      {% endif %}
    {% endfor %}
  loop_control:
    label: "{{ item.name }}"

- name: Start logrotate
  ansible.builtin.service:
    name: "{{ logrotate_service | default('logrotate') }}"
    state: "{{ logrotate_service_state | default('started') }}"
    enabled: "{{ logrotate_service_enabled | default('yes') | bool }}"
  when: logrotate_service is not empty


