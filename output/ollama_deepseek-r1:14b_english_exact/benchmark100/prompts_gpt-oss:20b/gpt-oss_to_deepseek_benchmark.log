  community.crypto.openssl_privatekey:
    path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    state: present
    mode: '0600'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ items }}"

- name: create | Create a certificate signing request (CSR) for each SSL certificate item
  community.crypto.openssl_csr:
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    common_name: "{{ item.common_name }}"
    path: "{{ openssl_csr_directory }}/{{ item.name }}.csr"
    state: present
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ items }}"

- name: create | Generate a self‑signed X.509 certificate for each item
  community.crypto.x509_certificate:
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    csr_path: "{{ openssl_csr_directory }}/{{ item.name }}.csr"
    path: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    provider: selfsigned
    state: present
    mode: '0640'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ items }}"

- name: create | Export a PKCS#12 bundle for each certificate item
  community.crypto.openssl_pkcs12:
    name: "{{ item.name }}.p12"
    path: "{{ openssl_key_directory }}/{{ item.name }}.p12"
    privatekey_path: "{{ openssl_key_directory }}/{{ item.name }}.key"
    certfile_path: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    friendly_name: "{{ item.name }}"
    state: present
    mode: '0600'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ items }}"

- name: create | Read the private key file for each item
  ansible.builtin.slurp:
    src: "{{ openssl_key_directory }}/{{ item.name }}.key"
    register: openssl_private_key
  loop: "{{ items }}"

- name: create | Read the certificate file for each item
  ansible.builtin.slurp:
    src: "{{ openssl_crt_directory }}/{{ item.name }}.crt"
    register: openssl_certifcate
  loop: "{{ items }}"

- name: create | Create a combined private_key and certificate file
  ansible.builtin.copy:
    content: |
      {{ (openssl_private_key.content | b64decode) }}
      {{ (openssl_certifcate.content | b64decode) }}
    dest: "{{ openssl_key_directory }}/{{ item.name }}.keycrt"
    mode: '0600'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"
  loop: "{{ items }}"

