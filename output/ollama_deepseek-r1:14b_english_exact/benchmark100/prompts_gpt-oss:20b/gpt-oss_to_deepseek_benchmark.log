---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell in cron config
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL=/{{ cron_shell }}"
    create: yes
    mode: 0600
    notify: Restart cron

- name: Configure path in cron config
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    create: yes
    mode: 0600
    notify: Restart cron

- name: Configure mailto in cron config
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    mode: 0600
    notify: Restart cron

- name: Start and enable cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ""

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default('*/5') }}"
    hour: "{{ item.hour | default('*') }}"
    day: "{{ item.day | default('*') }}"
    month: "{{ item.month | default('*') }}"
    weekday: "{{ item.weekday | default('*') }}"
    special_time: "{{ item.special_time | default('') }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default('present') }}"
    user: "{{ item.user | default('root') }}"
  with_items: "{{ cron_jobs }}"
  when: cron_jobs is defined and cron_jobs != ""


