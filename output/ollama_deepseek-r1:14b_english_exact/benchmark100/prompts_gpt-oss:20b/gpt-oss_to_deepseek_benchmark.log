---
- name: Create local ssh_key_directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ users_ssh_key_directory }}"
    state: directory
    mode: '0750'
  delegate_to: localhost
  when: user.manage_ssh_key is defined and user.manage_ssh_key

- name: Manage user {{ user.name }}
  ansible.posix.user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment }}"
    home: "{{ user.home }}"
    password: "{{ user.password }}"
    uid: "{{ user.uid }}"
    group: "{{ user.group }}"
    groups: "{{ user.groups }}"
    shell: "{{ user.shell }}"
  register: users_manage_user

- name: Set sudo options for {{ user.name }}
  ansible.builtin.template:
    src: sudo.j2
    dest: /etc/sudoers.d/{{ user.name | replace('.', 'dot') }}
    mode: '0640'
  when: user.sudo_options is defined
  notify: Validate sudoers file

- name: Remove sudo options for {{ user.name }}
  ansible.builtin.file:
    path: /etc/sudoers.d/{{ user.name | replace('.', 'dot') }}
    state: absent
  when: not user.sudo_options

- name: Generate private ssh key for {{ user.name }}
  ansible.builtin.command:
    cmd: "{{ users_ssh_keygen_command }}"
    delegate_to: localhost
    when: user.manage_ssh_key is defined and user.manage_ssh_key
    register: users_ssh_keygen_result
    pipefail: true

- name: Generate public ssh key for {{ user.name }}
  ansible.builtin.command:
    cmd: "{{ users_ssh_keygen_pubkey_command }}"
    delegate_to: localhost
    when: user.manage_ssh_key is defined and user.manage_ssh_key
    register: users_ssh_keygen_pubkey_result
    pipefail: true

- name: Convert ssh key to ppk for {{ user.name }}
  ansible.builtin.command:
    cmd:
      - ssh-keygen
      - -e
      - -f
      - "{{ users_ssh_key_directory }}/{{ user.name }}"
      - |-
        tee "{{ users_ssh_key_directory }}/{{ user.name }}.ppk"
    delegate_to: localhost
    when: user.manage_ssh_key is defined and user.manage_ssh_key
    register: users_ssh_key_ppk_result
    pipefail: true

- name: Get or set the home directory for {{ user.name }}
  ansible.builtin.shell:
    cmd: |
      home_dir=$(getent passwd "{{ user.name }}" | awk -F: '{print $6}')
      if [ "$home_dir" = "" ]; then home_dir="/home"; fi
      echo $home_dir
    register: users_home_dir
    when: user.state == 'present'
    pipefail: true

- name: Create .ssh directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ users_home_dir.stdout }}/.ssh"
    state: directory
    mode: '0700'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.manage_ssh_key is defined or user.private_keys is defined
  become_user: "{{ user.name }}"
  become: true

- name: Deploy authorized keys for {{ user.name }}
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item.key }}"
    state: present
  with_items: "{{ user.authorized_keys | default([]) }}"

- name: Remove unauthorized keys for {{ user.name }}
  ansible.posix.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item.key }}"
    state: absent
  with_items: "{{ user.unauthorized_keys | default([]) }}"

- name: Copy generated private ssh key for {{ user.name }}
  ansible.builtin.copy:
    src: "{{ users_ssh_key_directory }}/{{ user.name }}"
    dest: "{{ users_home_dir.stdout }}/.ssh/id_rsa"
    mode: '400'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: users_manage_user is defined and user.copy_private_key

- name: Check users password valid time for {{ user.name }}
  ansible.builtin.command:
    cmd: awk -F: '{print $10}' /etc/shadow | awk '{print $1}'
    register: users_pw_valid
    when: user.state == 'present'
    pipefail: true

- name: Set users password valid time for {{ user.name }}
  ansible.builtin.command:
    cmd: chage -M "{{ user.password_validity_days }}" "{{ user.name }}"
    when:
      - user.password_validity_days is defined
      - user.state == 'present'
      - users_pw_valid.stdout != "{{ user.password_validity_days }}"
    pipefail: true

- name: Place private key file for {{ user.name }}
  ansible.builtin.copy:
    content: "{{ item.key }}"
    dest: "{{ users_home_dir.stdout }}/.ssh/{{ item.key_name | default('id_rsa') }}"
    mode: '400'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  with_items: "{{ user.private_keys | default([]) }}"
  when: user.private_keys is defined


