---
- name: Java | Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: "temurin"
  when: ansible_distribution == "adoptopenjdk"

- name: Java | Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_distribution }}-{{ ansible_distribution_major_version }}.yml"
  with_first_found: true

- name: Java | Gather architecture specific variables
  include_vars:
    file: "architecture.yml"
  with_first_found: true

- name: Java | Setting OS specific variables (I)
  set_fact:
    java_open_jdk_version_major: "{{ item.value | default('__') }}"
    java_required_repositories_openjdk: "{{ item.value | default('__') }}"
    java_required_key_repositories_openjdk: "{{ item.value | default('__') }}"
    java_required_libs_openjdk: "{{ item.value | default('__') }}"
    java_deprecated_repositories_adoptopenjdk: "{{ item.value | default('__') }}"
  loop:
    - name: java_open_jdk_version_major
    - name: java_required_repositories_openjdk
    - name: java_required_key_repositories_openjdk
    - name: java_required_libs_openjdk
    - name: java_deprecated_repositories_adoptopenjdk

- name: Java | Setting OS and architecture specific variables (II)
  set_fact:
    java_open_jdk_home_dir: "{{ item.value | default('__') }}"
    java_open_jdk_package: "{{ item.value | default('__') }}"
  loop:
    - name: java_open_jdk_home_dir
    - name: java_open_jdk_package

- name: Java | Setting specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Java | Debian pre-requisites
  block:
    - name: Java | Remove deprecated repositories
      apt_repository:
        repo: "{{ item }}"
        state: absent
      with_items: "{{ java_deprecated_repositories_adoptopenjdk | default([]) }}"

    - name: Java | Install extra apt tools
      apt:
        name: "{{ java_open_jdk_apt_extra_packages }}"
        state: present
      register: apt_tools_installed
      until: apt_tools_installed|success
      retries: 3
      delay: 10
      when: java_open_jdk_apt_extra_packages | default([]) | length > 0

    - name: Java | add required key repositories, Debian
      apt_key:
        keyfile: "{{ item }}"
        state: present
      with_items: "{{ java_required_key_repositories_openjdk }}"

    - name: Java | Add required repositories, Debian
      apt_repository:
        repo: "{{ item }}"
        state: present
        update_cache: yes
        valid_until: "3600"
      with_items: "{{ java_required_repositories_openjdk }}"

  when: ansible_os_family == "Debian"

- name: Java | RedHat pre-requisites
  block:
    - name: Java | Add required key repositories, RedHat
      rpm_key:
        key: "{{ item }}"
        state: present
      with_items: "{{ java_required_key_repositories_openjdk }}"

    - name: Java | Add required repositories, RedHat
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        file: "{{ item.file }}"
        baseurl: "{{ item.baseurl }}"
        gpgcheck: "{{ item.gpgcheck | default('1') }}"
      with_items: "{{ java_required_repositories_openjdk }}"

  when: ansible_os_family == "RedHat"

- name: Java | Install required libs
  apt:
    name: "{{ item }}"
    state: present
  with_items: "{{ java_required_libs_openjdk }}"
  register: java_required_libs_installed
  until: java_required_libs_installed|success
  retries: 3
  delay: 10

- name: Java | Install Java, Debian
  apt:
    name: "{{ java_open_jdk_package }}"
    version: "{{ java_open_jdk_version | default('') }}"
    state: present
    update_cache: yes
    cache_validity: 3600
  register: java_package_installed
  until: java_package_installed|success
  retries: 3
  delay: 10
  when: ansible_os_family == "Debian"

- name: Java | Install Java, RedHat
  yum:
    name: "{{ java_open_jdk_package }}"
    version: "{{ java_open_jdk_version | default('') }}"
    state: present
    update_cache: yes
  register: java_package_installed
  until: java_package_installed|success
  retries: 3
  delay: 10
  when: ansible_os_family == "RedHat"

- name: Java | Export environment variables
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh
    mode: 0755
    owner: root

- name: Java | Source environment variables
  shell: source /etc/profile
  args:
    cmd: /etc/profile
  skip_ansible_lint: true

- name: Java | Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java in java < 11
  alternatives:
    name: java
    path: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java
    state: present
  when: ansible_os_family == "Debian" and java_open_jdk_version_major | int < 11

- name: Java | Correct java version selected /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java in java >= 11
  alternatives:
    name: java
    path: /usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java
    state: present
  when: ansible_os_family == "Debian" and java_open_jdk_version_major | int >= 11


