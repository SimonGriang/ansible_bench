---
- name: Download RKE2 installation script
  ansible.builtin.get_url:
    url: "{{ rke2_install_bash_url }}"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    timeout: "{{ rke2_artifact_fetch_timeout }}"
  when: rke2_airgap_mode: false

- name: Copy local RKE2 installation script
  ansible.builtin.copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    force: yes
  when: rke2_airgap_mode: true and rke2_airgap_implementation: 'copy'

- name: Create RKE2 artifacts folder
  ansible.builtin.file:
    path: "{{ rke2_artifact_path }}"
    state: directory
    mode: 0700
  when: rke2_airgap_mode: true and rke2_airgap_implementation is not 'exists'

- name: Download RKE2 checksum and artifacts (try remote first - fallback to local download and push)
  block:
    - name: Download SHA256 checksum
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
        mode: 0640
        force: yes
      when: rke2_airgap_mode: true and rke2_airgap_implementation: 'download'

    - name: Download RKE2 artifacts
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"
        dest: "{{ rke2_artifact_path }}/{{ item }}"
        mode: 0640
        force: yes
        checksum: sha256sum-{{ rke2_architecture }}.txt
      loop: "{{ rke2_artifact | exclude(['sha256sum']) }}"
      when: rke2_airgap_mode: true and rke2_airgap_implementation: 'download'

    - name: Download RKE2 install script
      ansible.builtin.get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
      when: rke2_airgap_mode: true and rke2_airgap_implementation: 'download'
  rescue:
    - name: Pause for 7 seconds
      ansible.builtin.pause:
        seconds: 7

    - name: Create local artifacts directory
      ansible.builtin.file:
        path: "{{ rke2_airgap_copy_sourcepath }}"
        state: directory
        mode: 0750
        owner: "{{ ansible_user_id }}"
        group: "{{ ansible_user_id }}"

    - name: Download checksum file
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_airgap_copy_sourcepath }}/sha256sum-{{ rke2_architecture }}.txt"
        mode: 0640
        force: yes

    - name: Download all artifacts locally
      ansible.builtin.get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/{{ item }}"
        dest: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        mode: 0640
        force: yes
        checksum: sha256sum-{{ rke2_architecture }}.txt
      loop: "{{ rke2_artifact | exclude(['sha256sum']) }}"

    - name: Download install script locally
      ansible.builtin.get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
        mode: 0700

    - name: Copy local artifacts to remote
      ansible.builtin.copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/"
        dest: "{{ rke2_artifact_path }}"
        remote_src: yes
        force: yes
        mode: 0640

    - name: Copy install script to remote
      ansible.builtin.copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
  when: rke2_airgap_mode: true and rke2_airgap_implementation: 'download'

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item }}"
    mode: 0640
    force: yes
    remote_src: yes
  loop: "{{ rke2_artifact }}"
  when: rke2_airgap_mode: true and rke2_airgap_implementation: 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Create directory for additional tarballs
      ansible.builtin.file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: 0700

    - name: Copy additional tarballs
      ansible.builtin.copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"
        mode: 0644
        force: yes
        remote_src: yes
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"
  when: rke2_airgap_mode: true and rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation is not 'exists'

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Stat artifacts
      ansible.builtin.stat:
        path: "{{ rke2_artifact_path }}/{{ item }}"
        register: artifacts
      loop: "{{ rke2_artifact | exclude(['sha256sum']) }}"

    - name: Stat install script
      ansible.builtin.stat:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        register: install_script

    - name: Set fact for artifacts writeable
      set_fact:
        artifacts_writeable: "{{ artifacts | selectattr('stat.permission|0o{{ item.permission }}' == 0o640) | list | count > 0 }}"
      loop: "{{ [artifacts] }}"

    - name: Make artifact files unwritable
      ansible.builtin.file:
        path: "{{ rke2_artifact_path }}/{{ item }}"
        mode: 0640
        state: file
      when: artifacts_writeable | bool
      loop: "{{ rke2_artifact | exclude(['sha256sum']) }}"

    - name: Ensure install script is executable
      ansible.builtin.file:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
        state: file

    - name: Fail if install script not executable
      ansible.builtin.fail:
        msg: "Install script at {{ rke2_install_script_dir }}/rke2.sh must be executable"
      when: install_script.stat.permission != 0o700
  when: rke2_airgap_mode: true and rke2_airgap_implementation: 'exists'

- name: Populate service facts
  ansible.builtin.service_facts:

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local
    register: usr_local

- name: Check if separate partition
  ansible.builtin.command:
    cmd: "grep '/usr/local ' /proc/mounts"
    changed_when: false
    register: partition_result
  when: rke2_airgap_mode: true

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin/rke2"
  when: usr_local.stat | is_writable != true or partition_result.rc == 1

- name: Set RKE2 bin path to /opt/rke2/bin/rke2
  set_fact:
    rke2_bin_path: "/opt/rke2/bin/rke2"
  when: usr_local.stat | is_writable == true and partition_result.rc == 0

- name: Check RKE2 version
  ansible.builtin.shell:
    cmd: "echo \"{{ (rke2_bin_path | exists()) | ternary('Installing RKE2 to {{ rke2_bin_path }}', 'RKE2 binary not found at {{ rke2_bin_path }}') }}\""
  register: versions_check

- name: Set RKE2 versions
  set_fact:
    installed_version: "{{ versions_check.stdout | json_query('installed_version') }}"
    running_version: "{{ versions_check.stdout | json_query('running_version') }}"
  when: not check_mode and rke2_version != 'not installed'

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - "'{{ running_version_clean }}' <= '{{ rke2_version_clean }}'" | bool
    fail_msg: "RKE2 downgrade detected. Current running version: {{ running_version_clean }}. Desired version: {{ rke2_version_clean }}. Downgrades are not allowed unless explicitly permitted."
    success_msg: "RKE2 downgrade check passed. Current running version: {{ running_version_clean }}. Desired version: {{ rke2_version_clean }}"
  when: not check_mode and rke2_version != 'not installed' and rke2_allow_downgrade: false

- name: Run RKE2 install script
  block:
    - name: Run RKE2 install script with airgap
      ansible.builtin.shell:
        cmd: "{{ rke2_install_script_dir }}/rke2.sh {{ install_RKE2_ARTIFACT_PATH }} {{ install_RKE2_AGENT_IMAGES_DIR }} {{ install_RKE2_METHOD }}"
        environment:
          INSTALL_RKE2_ARTIFACT_PATH: "{{ rke2_artifact_path }}"
          INSTALL_RKE2_AGENT_IMAGES_DIR: "{{ rke2_tarball_images_path }}"
          INSTALL_RKE2_METHOD: "copy"
      when: rke2_airgap_mode: true

    - name: Run RKE2 install script
      ansible.builtin.shell:
        cmd: "{{ rke2_install_script_dir }}/rke2.sh {{ install_RKE2_VERSION }} {{ install_RKE2_CHANNEL_URL }} {{ install_RKE2_CHANNEL }} {{ install_RKE2_METHOD }}"
        environment:
          INSTALL_RKE2_VERSION: "{{ rke2_version }}"
          INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"
          INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"
          INSTALL_RKE2_METHOD: "download"
      when: rke2_airgap_mode: false
  when: not check_mode and rke2_version != 'not installed' and (installed_version != rke2_version or running_version != rke2_version)

- name: Copy Custom Manifests
  ansible.builtin.template:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/{{ item | basename }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/{{ item | basename }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  ansible.builtin.template:
    src: rke2_environment.j2
    dest: /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: 0644
  when: rke2_environment_options | length > 0


