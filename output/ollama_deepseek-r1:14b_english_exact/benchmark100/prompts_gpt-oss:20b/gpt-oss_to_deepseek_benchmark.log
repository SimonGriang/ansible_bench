- name: Remove externally managed from Debian 12
  import_tasks: debian12.yml
  when: ansible_distribution == 'Debian' and ansible_distribution_major_version | int >= 12

- name: Ensure Pip is installed
  apt:
    name: '{{ pip_package }}'
    state: present

- name: Ensure packaging is available via dnf
  dnf:
    name: python3-packaging
    state: present

- name: Ensure pip_install_packages are installed
  pip:
    name: '{{ item.name }}'
    version: '{{ item.version }}'
    virtualenv: '{{ item.virtualenv }}'
    state: '{{ item.state }}'
    extra_args: '{{ item.extra_args }}'
    executable: '{{ pip_executable if not item.virtualenv else virtualenv.stdout }}/pip3'
  loop: '{{ pip_install_packages }}'


