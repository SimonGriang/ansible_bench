---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
    run_once: true
    delegate_to: localhost

- name: Install mysql
  apt:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    sections:
      "{{ item.section }}"
      option: "{{ item.option }}"
      value: "{{ item.value }}"
    loop: "{{ mysql_configuration_options }}"
  notify:
    - Restart mysql server

- name: Configure mysql client
  community.general.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    option: socket
    value: "{{ mysql_socket }}"

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: (ansible_distribution in ['Alpine', 'Arch'])
  args:
    creates: /var/lib/mysql/mysql

- name: Start and enable mysql
  ansible.builtin.service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: yes

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    target: "{{ item.target | default('') }}"
    encoding: "{{ item.encoding | default('utf8mb4') }}"
    collation: "{{ item.collation | default('utf8mb4_unicode_ci') }}"
    login_user: root
    login_host: localhost
    login_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
    initial_import: "{{ item.initial_import | default('') }}"
    skip: "{{ item.initial_import is defined }}"
  loop: "{{ mysql_databases | default([]) }}"

- name: List databases
  community.mysql.mysql_info:
    query: databases
  register: mysql_info
  no_log: true

- name: Import database
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.initial_import }}"
    login_user: root
    login_host: localhost
    login_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases | default([]) | selectattr('initial_import') | list }}"
  when: item.name not in mysql_info.databases

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges | default('') }}"
    host: "{{ item.host | default('localhost') }}"
    host_all: "{{ item.host_all | default('') }}"
    update_password: "{{ item.update_password | default('always') }}"
    login_user: root
    login_host: localhost
    login_socket: "{{ mysql_socket }}"
    login_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_users | default([]) }}"

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: yes


