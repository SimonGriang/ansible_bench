y changes.\n</think>\n\n```yaml\n---\n- name: Import assert.yml\n  ansible.builtin.import_tasks: assert.yml\n  delegate_to: localhost\n  no_log: true\n\n- name: Install requirements\n  ansible.builtin.package:\n    name: "{{ item }}"\n    state: present\n  loop: "{{ openssl_requirements }}"\n\n- name: Install pip packages\n  ansible.builtin.pip:\n    packages: "{{ openssl_pip_packages }}"\n  when: "{{ ansible.utils.conditional(ansible.utils.list.length(ansible.utils.list.get(openssl_pip_packages, [])) > 0) }}"\n\n- name: Create key directory\n  ansible.builtin.file:\n    path: "{{ openssl_key_directory }}"\n    state: directory\n    mode: \'700\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create csr directory\n  ansible.builtin.file:\n    path: "{{ openssl_csr_directory }}"\n    state: directory\n    mode: \'755\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create crt directory\n  ansible.builtin.file:\n    path: "{{ openssl_crt_directory }}"\n    state: directory\n    mode: \'755\'\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Include create.yml\n  ansible.builtin.import_tasks: create.yml\n  loop: "{{ openssl_items }}"\n  when: "{{ ansible.utils.conditional(ansible.utils.list.length(ansible.utils.list.get(openssl_items, [])) > 0) }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-16T17:47:28.597521467Z', 'done': True, 'done_reason': 'stop', 'total_duration': 18461671371, 'load_duration': 90246833, 'prompt_eval_count': 3095, 'prompt_eval_duration': 2145002621, 'eval_count': 787, 'eval_duration': 16224797826, 'model_name': 'deepseek-r1:14b'} id='run--50d7940b-b17d-419f-ab0c-4f5387955a00-0' usage_metadata={'input_tokens': 3095, 'output_tokens': 787, 'total_tokens': 3882}
