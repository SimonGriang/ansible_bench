  when: rke2_airgap_mode: true and rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation is not 'exists'

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Stat artifacts
      ansible.builtin.stat:
        path: "{{ rke2_artifact_path }}/{{ item }}"
        register: artifacts
      loop: "{{ rke2_artifact | exclude(['sha256sum']) }}"

    - name: Stat install script
      ansible.builtin.stat:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        register: install_script

    - name: Set fact for artifacts writeable
      set_fact:
        artifacts_writeable: "{{ artifacts | selectattr('stat.permission|0o{{ item.permission }}' == 0o640) | list | count > 0 }}"
      loop: "{{ [artifacts] }}"

    - name: Make artifact files unwritable
      ansible.builtin.file:
        path: "{{ rke2_artifact_path }}/{{ item }}"
        mode: 0640
