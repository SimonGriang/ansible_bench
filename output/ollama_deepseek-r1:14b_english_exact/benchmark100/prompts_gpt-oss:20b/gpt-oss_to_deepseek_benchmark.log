---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  apt:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta:
    flush_handlers: yes

- name: Manage selinux
  ansible.posix.selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when:
    - ansible_selinux.status is defined
    - not containerized
  notify: Reboot

- name: Manage selinux booleans
  ansible.posix.seboolean:
    name: "{{ item }}"
    state: yes
    persistent: true
  when: selinux_booleans is defined
  loop: "{{ selinux_booleans }}"
  loop_control:
    label: "{{ item }}"


