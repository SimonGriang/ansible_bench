---
- import_tasks: assert.yml
  delegate_to: localhost

- name: Install mysql
  apt:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  loop: "{{ mysql_configuration_options }}"
  with_items: "{{ item }}"
  ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    section: "{{ item.section }}"
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: 0644
    label: "{{ item.option }}"
  notify: Restart mysql server

- name: Configure mysql client
  ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    section: client
    option: socket
    value: "{{ mysql_socket }}"
    mode: 0644

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: not file('/var/lib/mysql/mysql') and ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Create databases
  loop: "{{ mysql_databases }}"
  with_items: "{{ item }}"
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    host: "{{ mysql_socket }}"
    encoding: "{{ item.encoding | default('utf8mb4') }}"
    collation: "{{ item.collation | default('utf8mb4_unicode_ci') }}"
    no_log: true
  when: mysql_databases is defined

- name: Create users
  loop: "{{ mysql_users }}"
  with_items: "{{ item }}"
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    host: "{{ item.host | default('localhost') }}"
    priv: "{{ item.privileges | default('ALL') }}"
    update_password: "{{ item.update_password | default('always') }}"
    no_log: true
  when: mysql_users is defined

- name: Flush handlers again
  meta: flush_handlers


