tart RKE2 service on {{ rke2_node_name }}\n  ansible.builtin.service:\n    name: "{{ rke2_service_name }}"\n    state: restarted\n    notify: Service (re)started\n\n- name: Wait for all nodes to be ready again\n  ansible.builtin.shell:\n    cmd: "{{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get nodes -o jsonpath=\'{range .items[*]}{if contains .status.conditions[*].type "Ready"}{.metadata.name} {end}\' | tr \' \' \'\\n\' | wc -l"\n    delegate_to: "{{ active_server if active_server else (groups[rke2_servers_group_name][0] if groups[rke2_servers_group_name] | list)}}"\n    register: all_ready_nodes\n    until: "\'{{ all_ready_nodes.stdout }}\' == \'{{ groups[rke2_cluster_group_name]|length }}"\'\n    retries: 100\n    delay: 15\n    changed_when: false\n    run_once: yes\n    when: not ansible_check_mode\n\n- name: Wait for all pods to be ready again\n  ansible.builtin.shell:\n    cmd: "{{ rke2_data_path }}/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml get pods --all-namespaces -o jsonpath=\'{range .items[*]}{if not (contains .status.phase "Running" or contains .status.phase "Succeeded")}{.metadata.name} {end}\' | tr \' \' \'\\n\' | wc -l"\n    delegate_to: "{{ active_server if active_server else (groups[rke2_servers_group_name][0] if groups[rke2_servers_group_name] | list)}}"\n    register: all_pods_ready\n    until: "\'{{ all_pods_ready.stdout }}\' == \'0\'"\n    retries: 100\n    delay: 15\n    changed_when: false\n    run_once: yes\n    when: not ansible_check_mode and rke2_wait_for_all_pods_to_be_ready\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-16T19:56:07.889252278Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14932382754, 'load_duration': 2475362250, 'prompt_eval_count': 631, 'prompt_eval_duration': 398524308, 'eval_count': 871, 'eval_duration': 12057288699, 'model_name': 'deepseek-r1:14b'} id='run--7fe3ee6f-1daa-4220-b19a-fb4e121a1a5d-0' usage_metadata={'inpu