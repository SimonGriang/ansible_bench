iltin.template:\n    src: server.conf.j2\n    dest: \'{{ openvpn_configuration_directory }}/server.conf\'\n    owner: root\n    group: \'{{ openvpn_group }}\'\n    mode: "0640"\n  notify: Restart openvpn\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-16T17:42:02.978027648Z', 'done': True, 'done_reason': 'stop', 'total_duration': 25706879010, 'load_duration': 89396532, 'prompt_eval_count': 2677, 'prompt_eval_duration': 860373099, 'eval_count': 1088, 'eval_duration': 24755763272, 'model_name': 'deepseek-r1:14b'} id='run--318f6007-5563-4cd3-bfea-ac559a037e94-0' usage_metadata={'input_tokens': 2677, 'output_tokens': 1088, 'total_tokens': 3765}
