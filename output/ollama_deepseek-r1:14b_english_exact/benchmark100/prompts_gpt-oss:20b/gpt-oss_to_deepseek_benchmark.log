---
- name: Import assert.yml
  shell: ansible-task import tasks/assert.yml

- name: Pre-configure debian systems
  ansible.builtin.debconf:
    name: postfix/main_mailer_type
    value: "No configuration"
    priority: low
  when: ansible_os_family == 'Debian'

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when:
    - postfix_virtual_mailbox_maps is defined
    - or postfix_virtual_mailbox_domains is defined
    - or postix_virtual_alias_maps is defined

- name: Configure postfix (transport_maps)
  template:
    src: postfix_transport_maps.j2
    dest: /etc/postfix/transport
    mode: 0644
    notify: [Validate configuration, Rebuild transport_maps database]
  changed_when: "{{ postfix_transport_maps_template is defined }}"

- name: Configure postfix (header_checks)
  template:
    src: postfix_header_checks.j2
    dest: /etc/postfix/header_checks
    mode: 0644
    notify: [Validate configuration, Reload postfix]
  changed_when: "{{ postfix_header_checks_template is defined }}"

- name: Setting values for main.cf (1/2)
  set_fact:
    _postfix_smtpd_recipient_restrictions_check_recipient_access: "{{ postfix_recipient_access is defined | bool }}"
    _postfix_smtpd_sender_restrictions_check_sender_access: "{{ postfix_sender_access is defined | bool }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    _postfix_mynetworks: "{{ postfix_mynetworks | default('127.0.0.0/8 [::1]/128') | join(',') }}"
    _postfix_mydestination: "{{ postfix_mydestination | default('localhost') | join(',') }}"
    _postfix_relay_domains: "{{ postfix_relay_domains | default([]) | join(',') }}"
    _postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default('permit_mynetworks, reject_non_fqdn, reject_unlisted_recipient') }}"
    _postfix_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default('permit_mynetworks, reject_non_fqdn, reject_unlisted_sender') }}"
    _postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default([]) | join(',') }}"
    _postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains | default([]) | join(',') }}"

- name: Configure postfix (main.cf)
  template:
    src: postfix_main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 0644
    notify: [Validate configuration, Restart postfix]
  changed_when: "{{ postfix_main_cf_template is defined }}"

- name: Configure postfix (master.cf)
  template:
    src: postfix_master.cf.j2
    dest: /etc/postfix/master.cf
    mode: 0644
    notify: [Validate configuration, Restart postfix]
  changed_when: "{{ postfix_master_cf_template is defined }}"

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: 0700
  loop:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"
  when:
    - postfix_smtpd_tls_cert_file is defined
    - postfix_smtpd_tls_key_file is defined
    - postfix_smtpd_tls_cert_file_source is defined
    - postfix_smtpd_tls_key_file_source is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: 0600
  notify: Reload postfix
  when: postfix_smtpd_tls_cert_file_source is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: 0600
  notify: Reload postfix
  when: postfix_smtpd_tls_key_file_source is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: "{{ postfix_alias_path }}"
    line: "{{ item.name }}: {{ item.destination }}"
    create: yes
    mode: 0644
  loop: "{{ postfix_aliases | default([]) | list }}"
  notify: [Rebuild alias database, Reload postfix]

- name: Configure sender_access
  lineinfile:
    path: "{{ postfix_sender_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    create: yes
    mode: 0644
  loop: "{{ postfix_sender_access | default([]) | list }}"
  notify: [Rebuild sender_access database, Reload postfix]

- name: Configure recipient_access
  lineinfile:
    path: "{{ postfix_recipient_access_path }}"
    line: "{{ item.domain }} {{ item.action }}"
    create: yes
    mode: 0644
  loop: "{{ postfix_recipient_access | default([]) | list }}"
  notify: [Validate configuration, Rebuild recipient_access database, Reload postfix]

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_smtp_sasl_password_map_content | default('') }}"
    dest: "{{ postfix_smtp_sasl_password_map }}"
    mode: 0600
  when:
    - postfix_smtp_sasl_password_map is defined
    - postfix_smtp_sasl_password_map is not empty
  notify: Rebuild sasl_password_map database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: "{{ postfix_service | default('postfix') }}"
    state: started
    enabled: yes


