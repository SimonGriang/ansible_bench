---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  ansible.builtin.getent:
    db: passwd
    key: git_username
    fail_key: false
  when: git_username is defined

- name: Create directory for git configuration
  file:
    path: /home/{{ git_username }}
    state: directory
    mode: 0755
    owner: git_username
    group: "{{ git_groupname | default('') }}"
  when: git_username is defined and getent_passwd is defined and getent_passwd[git_username] != none

- name: Place git configuration
  ansible.builtin.template:
    src: gitconfig.j2
    dest: /home/{{ git_username }}/.gitconfig
    mode: 0644
  when: git_user_email is defined and git_user_name is defined and git_username is defined and getent_passwd[git_username] != none

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    mode: 0750
    owner: git_username
    group: "{{ git_groupname | default('') }}"
  when: git_repository_destination is defined and git_username is defined and getent_passwd[git_username] != none

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ item.repository }}"
    dest: "{{ git_repository_destination }}/{{ item.dest }}"
    accept_hostkey: true
    version: "{{ item.version | default('HEAD') }}"
    force: "{{ item.force | default(git_force | default(false)) }}"
    become: true
    become_user: git_username
  loop: "{{ git_repositories | default([]) }}"
  loop_control:
    label: "{{ item.dest }}"
  when: git_repositories is defined and git_repository_destination is defined and git_username is defined and getent_passwd[git_username] != none


