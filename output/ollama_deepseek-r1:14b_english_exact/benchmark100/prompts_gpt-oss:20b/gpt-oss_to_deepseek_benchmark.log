---
- name: Create docroot
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 493  # 0755 in decimal
  loop: "{{ httpd_vhosts | default([]) | list }}"
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - (item.create_docroot is not defined or item.create_docroot)
  tags:
    - vhost

- name: Configure vhosts
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: 420  # 0644 in decimal
  loop: "{{ httpd_vhosts | default([]) | list }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd
  tags:
    - vhost

- name: Enable vhosts
  ansible.builtin.command:
    cmd: a2ensite {{ item.name }}
  loop: "{{ httpd_vhosts | default([]) | list }}"
  when:
    - ansible_os_family == 'Debian'
  notify:
    - Test httpd configuration validity
    - Restart httpd
  tags:
    - vhost
  changed_when: false  # Command shouldn't change state if already enabled


