---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
    delegate_to: localhost
    run_once: true

- name: Wait for port to be available
  ansible.builtin.wait_for:
    host: "{{ ansible_hostname }}"
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection != 'local'
    - not ansible_in_container
    - not ansible_is_chroot
    - bootstrap_wait_for_host | default(true)

- name: Test connection and check sudo
  block:
    - name: Test connection
      ansible.builtin.wait_for:
        host: "{{ ansible_hostname }}"
        port: "{{ ansible_port | default(22) }}"
        timeout: "{{ bootstrap_timeout }}"
        state: started

    - name: Check sudo availability
      ansible.builtin.command:
        cmd: sudo --version
        changed_when: false
  rescue:
    - name: Gather facts and install packages
      include_tasks: gather_facts.yml
      vars:
        bootstrap_facts_packages: "{{ bootstrap_facts_packages }}"

    - name: Install bootstrap packages (raw)
      ansible.builtin.raw:
        cmd: "{{ bootstrap_install.raw }}"
        changed_when: false
      register: bootstrap_install_packages
      ignore_errors: yes
  changed_when: false

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: all
    become: false

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
    update_cache: yes
    become: "{{ bootstrap_become }}"
  loop: "{{ bootstrap_facts_packages.split() | list }}"


