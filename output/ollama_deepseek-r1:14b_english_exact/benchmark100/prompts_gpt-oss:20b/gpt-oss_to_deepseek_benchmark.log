---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  no_log: true

- name: Install requirements
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_requirements }}"

- name: Install pip packages
  ansible.builtin.pip:
    packages: "{{ openssl_pip_packages }}"
  when: "{{ ansible.utils.conditional(ansible.utils.list.length(ansible.utils.list.get(openssl_pip_packages, [])) > 0) }}"

- name: Create key directory
  ansible.builtin.file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: '700'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create csr directory
  ansible.builtin.file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: '755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create crt directory
  ansible.builtin.file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: '755'
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include create.yml
  ansible.builtin.import_tasks: create.yml
  loop: "{{ openssl_items }}"
  when: "{{ ansible.utils.conditional(ansible.utils.list.length(ansible.utils.list.get(openssl_items, [])) > 0) }}"


