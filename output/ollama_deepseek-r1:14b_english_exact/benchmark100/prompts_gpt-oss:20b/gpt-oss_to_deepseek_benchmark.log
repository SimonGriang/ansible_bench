---
- name: Import assertions
  ansible.builtin.import_tasks: assert.yml
  when: import_assert

- name: Install python pip packages
  ansible.builtin.package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  ansible.builtin.template:
    dest: /etc/pip.conf
    mode: "0644"
    content: |
      [global]
      index-url = {{ python_pip_proxy }}
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  ansible.builtin.template:
    dest: /etc/pip.conf
    mode: "0644"
    content: |
      [global]
      trusted-host = {{ python_pip_trusted_host }}
  when: python_pip_trusted_host is defined

- name: Update pip
  ansible.builtin.pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable | default('pip') }}"
  when:
    - python_pip_update
    - distribution_release not in ['bookworm', 'noble']
    - ansible_os_family not in ['Alpine']

- name: Install requested Python modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default('latest') }}"
    executable: "{{ python_pip_executable | default('pip') }}"
  loop: "{{ python_pip_modules }}"
  when:
    - distribution_release not in ['bookworm', 'noble']
    - ansible_os_family not in ['Alpine']


