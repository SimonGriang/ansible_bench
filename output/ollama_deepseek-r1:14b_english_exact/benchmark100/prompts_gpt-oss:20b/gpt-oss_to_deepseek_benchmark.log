---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  register: assert_result

- name: Install required software
  become: yes
  package:
    name: "{{ users_requirements }}"
    state: present
  when: users_requirements | length > 0

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    loop_var: group
    label: "{{ group }}"
  when: users_groups is defined

- name: Ensure /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "#include {{ item }}"
    regexp: '^#?include /etc/sudoers.d/.*$'
    state: present
  when: users_sudoers_d
  notify: visudo

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    loop_var: user
    label: "{{ user }}"
  when: users is defined

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0644
  when: users_cron_allow

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is false


