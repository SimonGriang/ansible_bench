---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
    host: localhost
  ignore_errors: true

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
    state: started
    check_interval: 1
  when:
    - ansible_connection is defined
    - not ansible_connection == 'container'
    - bootstrap_wait_for_host | default(true)

- name: Test connection
  ansible.builtin.wait_for_connection:
    timeout: "{{ bootstrap_timeout }}"
    register: bootstrap_connect
    changed_when: false

- name: Test sudo
  ansible.builtin.command:
    cmd: sudo --version
    changed_when: false

- name: Gather bootstrap facts
  ansible.builtin.include_tasks:
    file: gather_facts.yml
  rescue:
    ignore_errors: true

- name: Install bootstrap packages (raw)
  ansible.builtin.raw:
    cmd: "{{ bootstrap_install_command }}"
    executable: /bin/sh
    changed_when: "{{ (ansible_os_family == 'RedHat') or (ansible_os_family == 'Debian') }}"
    ignore_errors: true
  register: bootstrap_install_packages

- name: Ensure libdnf5 is present on Fedora/RedHat
  ansible.builtin.raw:
    cmd: dnf install -y python3-libdnf5
    executable: /bin/sh
  when: ansible_os_family == 'RedHat'

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: all
    no_become: true

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages.split() }}"
    state: present
    update_cache: yes
    become: "{{ bootstrap_become | default('yes') | lower() }}"



