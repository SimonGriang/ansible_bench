---
- name: Lookup bootstrap facts
  ansible.builtin.raw:
    cmd: cat /etc/os-release
    become: false
  register: bootstrap_facts
  check_mode: false

- name: Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: "{{ (bootstrap_facts.stdout_lines | join('\n') | regex_search('^.*VERSION_ID=\"(\d{1,2})(\.\d{1,4})*?\".*$', 1) | default('NA')) }}"
  loop: "{{ bootstrap_os_family_map | flatten() }}"
  when:
    - bootstrap_facts.rc == 0
    - not bootstrap_distribution
    - bootstrap_facts.stdout | regex_match("PRETTY_NAME=.*")
  noBecome: true

- name: Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map.items() }}"
  when: "{{ item.value | list | select('ansible_distribution', item.value) | list | bool }}"
  label: "{{ item.key }}"
  noBecome: true


