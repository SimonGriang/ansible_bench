---
- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command:
    cmd: "{{ helm_bin_path }} version"
    failed_when: false
    changed_when: false
  register: helm_existing_version

- name: Download helm
  unarchive:
    remote_src: true
    src: "{{ helm_repo_path }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: /tmp
    mode: 0755
  register: helm_download
  when: not helm_check.stat.exists or ("{{ helm_version }}" not in helm_existing_version.stdout)

- name: Copy helm binary into place
  copy:
    src: "/tmp/{{ helm_platform }}-{{ helm_arch }}/helm"
    dest: "{{ helm_bin_path }}"
    remote_src: true
    mode: 0755
  become: true
  when: helm_download is changed


