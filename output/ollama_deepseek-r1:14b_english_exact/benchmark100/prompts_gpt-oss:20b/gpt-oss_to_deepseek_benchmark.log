- name: Restore etcd
  block:
    - name: Get registered nodes
      shell: kubectl get nodes --no-headers | awk '{print $1}' | tr '\n' ' '
      register: registered_nodes
      changed_when: false

    - name: Gather all node names from inventory
      set_fact:
        all_node_names: "{{ hostvars | selectattr('ansible_hostname') | map('ansible_hostname') | list }}"

    - name: Delete old node-password secrets
      shell: kubectl delete secret node-password-{{ item }} --ignore-not-found
      loop: "{{ (registered_nodes.stdout.split() - all_node_names).split() }}"

    - name: Delete old node objects
      shell: kubectl delete node {{ item }} --ignore-not-found
      loop: "{{ (registered_nodes.stdout.split() - all_node_names).split() }}"

  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ groups[rke2_cluster_group_name] | first }}"
  delegate_facts: true


