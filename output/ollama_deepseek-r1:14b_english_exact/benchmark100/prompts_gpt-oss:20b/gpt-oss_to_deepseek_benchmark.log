---
- name: check if all variables have been set correctly
  import_tasks:
    - assert.yml
  delegate_to: localhost
  run_once: true

- name: wait for host (when configured)
  action: wait_for
  args:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
    state: started
  become: "{{ bootstrap_become | default('yes') | bool }}"
  become_user: "{{ bootstrap_become_user | default('root') }}"
  remote_user: "{{ bootstrap_user }}"
  when: not containerized and not docker and bootstrap_wait_for_host | default('yes') | bool

- name: prepare system
  block:
    - name: Test connection to host
      wait_for_connection:
        timeout: "{{ bootstrap_connection_timeout }}"
      register: connection_result
      changed_when: false
  rescue:
    - name: Connection test failed
      debug:
        msg: "Connection to host failed after timeout of {{ bootstrap_connection_timeout }}"
      changed: true
  always:
    - import_tasks: gather_facts.yml
    - name: Execute raw bootstrap commands
      raw:
        cmd: "{{ lookup('file', 'bootstrap_install.raw') | replace('\n', ' ') }}"
      args:
        executable: /bin/sh
      register: raw_command_result
      changed: "{{ raw_command_result.stdout | regex_search('changed', ignore_errors=True) if ansible_os_family != 'RedHat' else ansible_os_family == 'RedHat' }}"

- name: ensure system is prepared by issuing ansible modules
  become: "{{ bootstrap_become | default('yes') | bool }}"
  become_user: "{{ bootstrap_become_user | default('root') }}"
  remote_user: "{{ bootstrap_user }}"
  block:
    - name: Gather Ansible facts
      setup:
        gather_subset: all
      changed_when: false

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap__facts_packages | default([]) | list }}"
        state: present
        update_cache: yes
  when: bootstrap__facts_packages | default([]) | list | length > 0


