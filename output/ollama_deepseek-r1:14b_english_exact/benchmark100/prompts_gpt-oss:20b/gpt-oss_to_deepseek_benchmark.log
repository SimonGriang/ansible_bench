---
- name: Create the RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

- name: Start RKE2 service on the rest of the nodes
  service:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: true
    retries: 3
    delay: 10s
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask other RKE2 service on the rest of the nodes
  service:
    name: "{{ item }}.service"
    state: masked
    enabled: false
  with_items: ["agent", "server"]
  when: item != rke2_type
  loop_control:
    loop: ["agent", "server"]
    filter: reject('match', rke2_type)

- name: Wait for remaining nodes to be ready - no CNI
  shell: kubectl get nodes -o=jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{",}{.metadata.nodeName}{",}{end}' | tr -s ',' | tr -d '"' | tr -d ' ' | tr ',' '\n' | grep -c '^False'
  register: node_not_ready
  until: node_not_ready.stdout == 0
  retries: 30
  delay: 60
  when: rke2_cni == 'none' and (ansible_hostname == active_server or (groups[rke2_servers_group_name] | first == ansible_hostname))

- name: Wait for remaining nodes to be ready - with CNI
  shell: kubectl get nodes | grep " Ready" | wc -l
  register: ready_nodes_count
  until: ready_nodes_count.stdout | int == groups[rke2_cluster_group_name] | length
  retries: 30
  delay: 60
  when: not check_mode and rke2_cni != 'none' and (ansible_hostname == active_server or (groups[rke2_servers_group_name] | first == ansible_hostname))

