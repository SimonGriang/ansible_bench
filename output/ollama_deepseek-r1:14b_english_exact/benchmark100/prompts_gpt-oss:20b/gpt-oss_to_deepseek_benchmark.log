---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install php
  package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  shell: "{{ php_ini_command }}"
  changed_when: false
  when: php_ini_location is not defined
  register: php_found_ini_location

- name: Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location) }}"
    mode: 644
  notify: Restart httpd

