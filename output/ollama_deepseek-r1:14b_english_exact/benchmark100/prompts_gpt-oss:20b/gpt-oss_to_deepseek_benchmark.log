---
- name: lookup bootstrap facts (raw)
  ansible.builtin.raw:
    cmd: cat /etc/os-release
    changed_when: false
  register: bootstrap_facts

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.value }}"
    bootstrap_distribution_major_version: "{{ item.value.split()[1] }}"
  loop: "{{ bootstrap__os_family_map | dict2items | map(attribute='value') | flatten }}"
  when:
    - bootstrap_facts.rc == 0
    - not (bootstrap_distribution is defined)
    - ansible.utils.rematch.match(
        data=bootstrap_facts.stdout,
        pattern=ansible.utils.rematch.BootstrapSearch(
          search=bootstrap__search[item],
          item=item
        )
      )
  become: yes
  become_user: "{{ bootstrap_become_user }}"

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when:
    - "'{{ item.value }}' contains bootstrap_distribution"
  become: yes
  become_user: "{{ bootstrap_become_user }}"


