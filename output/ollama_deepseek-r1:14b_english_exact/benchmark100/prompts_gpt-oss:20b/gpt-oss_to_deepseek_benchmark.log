---
- name: Create the RKE2 manifests directory
  file:
    path: "{{ rke2_data_path }}/server/manifests"
    state: directory
    owner: root
    group: root
    mode: 0700

- name: Copy kube-vip files to first server
  template:
    src:
      - templates/kube-vip/kube-vip.yml.j2
      - templates/kube-vip/kube-vip-rbac.yml.j2
    dest:
      - "{{ rke2_data_path }}/server/manifests/kube-vip.yml"
      - "{{ rke2_data_path }}/server/manifests/kube-vip-rbac.yml"
    owner: root
    group: root
    mode: 0664

- name: Copy kube-vip load balancer manifests to first server
  when: "{{ rke2_kubevip_cloud_provider_enable | bool }}"
  template:
    src: templates/kube-vip/kube-vip-cloud-{{ item }}.j2
    dest: "{{ rke2_data_path }}/server/manifests/kube-vip-cloud-{{ item }}.yml"
    owner: root
    group: root
    mode: 0664
  with_items:
    - loadbalancer
    - service
    - sync


