\nLet me structure each task with their respective modules and variables, ensuring that each has the correct parameters and that conditions are applied where necessary. I\'ll also verify that the file paths and variables are properly templated with `{{ }}` where needed.\n\nFinally, I\'ll compile all these tasks into a single YAML playbook, starting with \'---\' and listing each task in the specified order, making sure it\'s valid for inclusion in an Ansible Role under tasks/main.yml.\n</think>\n\n```yaml\n---\n- name: Ensure old versions of Docker are not installed\n  yum:\n    name: "{{ docker_obsolete_packages }}"\n    state: absent\n\n- name: Add Docker GPG key\n  rpm_key:\n    key: "{{ docker_yum_gpg_key }}"\n    state: present\n  when: docker_add_repo\n\n- name: Add Docker repository\n  get_url:\n    url: "{{ docker_yum_repo_url }}"\n    dest: /etc/yum.repos.d/docker-{{ docker_edition }}.repo\n    mode: 0644\n    owner: root\n  when: docker_add_repo\n\n- name: Configure Docker Nightly repo\n  lineinfile:\n    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo\n    line: "enabled={{ docker_yum_repo_enable_nightly }}"\n    state: present\n    with_verbosity: 0\n  when: docker_add_repo\n\n- name: Configure Docker Test repo\n  lineinfile:\n    path: /etc/yum.repos.d/docker-{{ docker_edition }}.repo\n    line: "enabled={{ docker_yum_repo_enable_test }}"\n    state: present\n    with_verbosity: 0\n  when: docker_add_repo\n\n- name: Configure containerd on RHEL 8\n  yum:\n    name: "{{ item }}"\n    state: present\n  with_items:\n    - runc\n    - container-selinux\n    - containerd.io\n  when: ansible_facts.distribution_major_version | int == 8\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-16T17:03:28.842800308Z', 'done': True, 'done_reason': 'stop', 'total_duration': 19117200254, 'load_duration': 93064407, 'prompt_eval_count': 651, 'prompt_eval_duration': 406789534, 'eval_count': 881, 'eval_duration': 18615999373, 'model_name': 'deepseek-r1:14b'} id='run--54428fba-b3cc-47e0-acda-0f4906853c12-0' usage_metadata={'input_tokens': 651, 'output_tokens': 881, 'total_tokens': 1532}
