---
- name: Import assert.yml
  ansible.builtin.import_tasks: 
    file: assert.yml
    run_once: true
    delegate_to: localhost

- name: Install cron
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "SHELL={{ cron_shell }}"
    create: yes
    mode: 0600
    notify: Restart cron

- name: Configure path
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    create: yes
    mode: 0600
    notify: Restart cron

- name: Configure mailto
  ansible.builtin.lineinfile:
    path: "{{ cron_configuration }}"
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    mode: 0600
    notify: Restart cron

- name: Start and enable cron
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ""

- name: Schedule requested cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    command: "{{ item.command }}"
    state: "{{ item.state | default('present') }}"
    user: "{{ item.user | default('root') }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined


