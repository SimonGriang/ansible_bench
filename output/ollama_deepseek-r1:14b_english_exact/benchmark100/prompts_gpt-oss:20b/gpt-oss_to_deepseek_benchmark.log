---
- name: Create the RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints | default([]) }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  template:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: 0600
  notify: Config file changed

- name: Copy kubelet config
  template:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: 0600
  condition: "!ansible_missing(rke2_kubelet_config)"
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  template:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: 0600
  condition: "{{ rke2_custom_registry_mirrors | default([]) | length > 0 or rke2_custom_registry_configs | default([]) | length > 0 }}"
  notify: Config file changed

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when:
    - rke2_etcd_snapshot_file is not empty
    - ansible_systemctl.show_state('rke2-server.service') == 'inactive'

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when:
    - rke2_etcd_snapshot_file is not empty
    - rke2_etcd_snapshot_s3_options is defined
    - ansible_dict_count(rke2_etcd_snapshot_s3_options) | int >= 4

- name: Restore etcd from file
  command: rke2 server --cluster-reset --cluster-reset-restore-path={{ rke2_etcd_snapshot_file }} --token {{ rke2_token }}
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  command: rke2 server --cluster-reset --etcd-s3 --s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }} --s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }} --s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }} --s3-endpoint {{ rke2_etcd_snapshot_s3_options.endpoint | default('')}} --s3-region {{ rke2_etcd_snapshot_s3_options.region | default('')}} --s3-endpoint-ca {{ rke2_etcd_snapshot_s3_options.endpoint_ca | default('')}} --s3-skip-ssl-verify {{ rke2_etcd_snapshot_s3_options.skip_ssl_verify | default('false')}}
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
    environment: "RKE2_TOKEN={{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  systemd:
    name: rke2-agent.service
    state: masked

- name: Wait for the first server be ready - no CNI
  shell: kubectl get node "{{ rke2_node_name }}"
  ignore_errors: yes
  when: rke2_cni == 'none' and not ansible_check_mode

- name: Wait for the first server be ready - with CNI
  shell: kubectl get nodes | grep "{{ rke2_node_name }}"
  ignore_errors: yes
  when: rke2_cni != 'none' and not ansible_check_mode

- name: Restore etcd
  block:
    - name: Get registered nodes
      shell: kubectl get nodes --no-headers | awk '{print $1}' | tr '\n' ' '
      register: registered_nodes
      changed_when: false

    - name: Gather all node names from inventory
      set_fact:
        all_node_names: "{{ hostvars | selectattr('ansible_hostname') | map('ansible_hostname') | list }}"

    - name: Delete old node-password secrets
      shell: kubectl delete secret node-password-{{ item }} --ignore-not-found
      loop: "{{ (registered_nodes.stdout.split() - all_node_names).split() }}"

    - name: Delete old node objects
      shell: kubectl delete node {{ item }} --ignore-not-found
      loop: "{{ (registered_nodes.stdout.split() - all_node_names).split() }}"

  when: do_etcd_restore or do_etcd_restore_from_s3

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ groups[rke2_cluster_group_name] | first }}"
  delegate_facts: true


