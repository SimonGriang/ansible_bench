---
- name: Cordon and Drain the node {{ rke2_node_name }}
  shell: >
    set -o pipefail && exec "{{ rke2_data_path }}/bin/kubectl"
    --kubeconfig=/etc/rancher/rke2/rke2.yaml
    drain "{{ rke2_node_name }}"
    {{ rke2_drain_additional_args | join(' ') }}
  register: drain
  until: "'drained' in drain.stdout"
  retries: 100
  delay: 15
  when: rke2_drain_node_during_upgrade | default('false') == 'true'
  delegate_to: "{{ active_server or groups[rke2_servers_group_name].hosts[0] }}"

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: |
    kubectl get nodes --output=jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{", "}{.metadata.name}{", "}{}{end}'
    | grep -c "Ready"
  changed_when: false
  register: all_ready_nodes
  until: "all_ready_nodes.stdout|int == groups[rke2_cluster_group_name].size"
  retries: 100
  delay: 15
  delegate_to: "{{ active_server or groups[rke2_servers_group_name].hosts[0] }}"

- name: Uncordon the node {{ rke2_node_name }}
  shell: kubectl uncordon "{{ rke2_node_name }}"
  changed_when: false
  delegate_to: "{{ active_server or groups[rke2_servers_group_name].hosts[0] }}"
  when: rke2_drain_node_during_upgrade | default('false') == 'true'

- name: Wait for all pods to be ready again
  shell: kubectl get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded --ignore-not-found | wc -l
  changed_when: false
  register: all_pods_ready
  until: "all_pods_ready.stdout|int == 0"
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready | default('false') == 'true'
  delegate_to: "{{ active_server or groups[rke2_servers_group_name].hosts[0] }}"

- name: Wait for all pods to pass readiness checks
  shell: kubectl wait {{ rke2_wait_for_all_pods_to_be_healthy_args | join(' ') }}
  changed_when: false
  until: "'completed' in the output"
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy | default('false') == 'true'
  delegate_to: "{{ active_server or groups[rke2_servers_group_name].hosts[0] }}"


