---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.raw:
    cmd: cat /etc/os-release
  no_log: true
  register: bootstrap_facts
  changed_when: false
  become: false
  check_mode: no

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item }}"
    bootstrap_distribution_major_version: "{{ lookup('ansible.utils.regex', value=bootstrap_facts.stdout_lines, regex=r'VERSION_ID="?([^"]+)"?', default='NA') }}"
  loop: "{{ (bootstrap_os_family_map | dict2items | flatten).value }}"
  loop_control:
    loop_var: item
  when:
    - bootstrap_facts.rc == 0
    - not bootstrap_distribution | defined
    - (bootstrap_search[item] | default(item)) in bootstrap_facts.stdout_lines | join(' ')

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    loop_var: item
  when: bootstrap_distribution is defined and item.value contains bootstrap_distribution


