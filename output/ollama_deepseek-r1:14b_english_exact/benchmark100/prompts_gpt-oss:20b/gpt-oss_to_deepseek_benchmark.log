---

- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Configure apk
  when: ansible_pkg_mgr == 'apk'
  become: true
  tasks:
    - name: Update apk cache
      community.general.apk:
        update_cache: true
        state: present
      changed_when: false

    - name: Upgrade all packages
      community.general.apk:
        upgrade: true
        state: present
      notify: Reboot

- name: Configure apt
  when: ansible_pkg_mgr == 'apt'
  become: true
  tasks:
    - name: Hold selected packages
      ansible.builtin.dpkg_selections:
        package: "{{ item }}"
        state: hold
      loop: "{{ update_excluded_packages }}"

    - name: Update all packages
      ansible.builtin.apt:
        update_cache: true
        upgrade: "{{ update_upgrade_command | bool }}"
        cache_valid_time: "{{ update_cache_valid_time }}"
        debconf:
          DEBIAN_FRONTEND: nointeractive
      notify: Reboot

    - name: Autoremove packages
      ansible.builtin.apt:
        autoremove: "{{ update_autoremove | bool }}"
      when: update_autoremove | bool

- name: Update all software (dnf)
  when: ansible_pkg_mgr in ['dnf', 'dnf5']
  become: true
  ansible.builtin.dnf:
    name: "*"
    state: latest
    exclude: "{{ update_excluded_packages | join(',') }}"
  notify: Reboot

- name: Update all software (pacman)
  when: ansible_pkg_mgr == 'pacman'
  become: true
  community.general.pacman:
    update_cache: true
    upgrade: true
  notify: Reboot

- name: Configure yum
  when: ansible_pkg_mgr == 'yum'
  become: true
  block:
    - name: RHEL/CentOS 6
      when: ansible_distribution_major_version == "6"
      block:
        - name: Upgrade all packages
          ansible.builtin.dnf:
            name: "*"
            state: latest
            exclude: "{{ update_excluded_packages | join(',') }}"
          notify: Reboot

    - name: Other versions
      when: ansible_distribution_major_version != "6"
      block:
        - name: Upgrade all packages
          ansible.builtin.dnf:
            name: "*"
            state: latest
            exclude: "{{ update_excluded_packages | join(',') }}"
          notify: Reboot

        - name: Install yum-utils
          ansible.builtin.package:
            name: yum-utils
            state: present

- name: Update all software (zypper)
  when: ansible_pkg_mgr == 'zypper'
  become: true
  community.general.zypper:
    name: "*"
    state: latest
  notify: Reboot

