---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  become: false
  host: localhost

- name: Install requirements
  become: true
  package:
    name: bash
    state: present

- name: Install openjdk java
  become: true
  package:
    name: "{{ java_openjdk_package | default('') }}"
    state: present
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM
  become: true
  when: java_source == "local" and java_format == "rpm"
  block:
    - name: Copy Oracle Java RPM
      become: true
      copy:
        src: "{{ java_package }}"
        dest: /tmp/{{ java_package }}
        remote_src: true
        mode: 0640

    - name: Install Oracle Java RPM
      become: true
      package:
        name: "{{ java_package | basename() }}"
        state: present

- name: Install DEB
  become: true
  when: java_source == "local" and java_format == "deb"
  block:
    - name: Copy Oracle Java DEB
      become: true
      copy:
        src: "{{ java_package }}"
        dest: /tmp/{{ java_package }}
        remote_src: true
        mode: 0640

    - name: Install Oracle Java DEB
      become: true
      apt:
        name: "{{ java_package | basename() }}"
        state: present
        mode: deb

- name: Install oracle java (rpm) (repository)
  become: true
  when: java_source == "repository" and java_format == "rpm"
  package:
    name: "{{ java_oracle_package }}"
    state: present

- name: Configure oracle targz
  become: true
  when: java_format == "targz" and java_vendor == "oracle"
  block:
    - name: Ensure install directory exists
      become: true
      file:
        path: "{{ java_install_directory }}"
        state: directory
        mode: 0755

    - name: Unarchive Oracle Java
      become: true
      unarchive:
        src: "{{ java_oracle_package }}"
        dest: "{{ java_install_directory }}"
        remote_src: true
        mode: 0755

- name: Install oracle java policy software (targz)
  become: true
  when: java_jce and java_version == 8 and java_vendor == "oracle"
  block:
    - name: Unarchive JCE Policy
      become: true
      unarchive:
        src: "jce_policy-8.zip"
        dest: "{{ java_install_directory }}"
        remote_src: true
        mode: 0755

- name: Set alternative (targz)
  become: true
  when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"
  file:
    path: /usr/bin/java
    state: link
    target: "{{ java_install_directory }}/{{ java_oracle_directory }}/bin/java"

- name: Find JAVA_HOME
  become: true
  shell: readlink -f /usr/bin/java | sed 's#/bin/java$##'
  register: java_home
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  become: true
  file:
    path: /etc/profile.d/java_home.sh
    content: export JAVA_HOME="{{ java_home.stdout }}"
    mode: 0644
    state: present


