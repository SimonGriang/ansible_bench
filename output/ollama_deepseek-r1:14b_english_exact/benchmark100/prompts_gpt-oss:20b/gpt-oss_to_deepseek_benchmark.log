  ansible.builtin.command:
    cmd: "grep '/usr/local ' /proc/mounts"
    changed_when: false
    register: partition_result
  when: rke2_airgap_mode: true

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin/rke2"
  when: usr_local.stat | is_writable != true or partition_result.rc == 1

- name: Set RKE2 bin path to /opt/rke2/bin/rke2
  set_fact:
    rke2_bin_path: "/opt/rke2/bin/rke2"
  when: usr_local.stat | is_writable == true and partition_result.rc == 0

- name: Check RKE2 version
  ansible.builtin.shell:
    cmd: "echo \"{{ (rke2_bin_path | exists()) | ternary('Installing RKE2 to {{ rke2_bin_path }}', 'RKE2 binary not found at {{ rke2_bin_path }}') }}\""
  register: versions_check

- name: Set RKE2 versions
  set_fact:
    installed_version: "{{ versions_check.stdout | json_query('installed_version') }}"
    running_version: "{{ versions_check.stdout | json_query('running_version') }}"
  when: not check_mode and rke2_version != 'not installed'

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.assert:
    that:
      - "'{{ running_version_clean }}' <= '{{ rke2_version_clean }}'" | bool
    fail_msg: "RKE2 downgrade detected. Current running version: {{ running_version_clean }}. Desired version: {{ rke2_version_clean }}. Downgrades are not allowed unless explicitly permitted."
    success_msg: "RKE2 downgrade check passed. Current running version: {{ running_version_clean }}. Desired version: {{ rke2_version_clean }}"
  when: not check_mode and rke2_version != 'not installed' and rke2_allow_downgrade: false

- name: Run RKE2 install script
  block:
    - name: Run RKE2 install script with airgap
      ansible.builtin.shell:
        cmd: "{{ rke2_install_script_dir }}/rke2.sh {{ install_RKE2_ARTIFACT_PATH }} {{ install_RKE2_AGENT_IMAGES_DIR }} {{ install_RKE2_METHOD }}"
        environment:
          INSTALL_RKE2_ARTIFACT_PATH: "{{ rke2_artifact_path }}"
          INSTALL_RKE2_AGENT_IMAGES_DIR: "{{ rke2_tarball_images_path }}"
          INSTALL_RKE2_METHOD: "copy"
      when: rke2_airgap_mode: true

    - name: Run RKE2 install script
      ansible.builtin.shell:
        cmd: "{{ rke2_install_script_dir }}/rke2.sh {{ install_RKE2_VERSION }} {{ install_RKE2_CHANNEL_URL }} {{ install_RKE2_CHANNEL }} {{ install_RKE2_METHOD }}"
        environment:
          INSTALL_RKE2_VERSION: "{{ rke2_version }}"
          INSTALL_RKE2_CHANNEL_URL: "{{ rke2_channel_url }}"
          INSTALL_RKE2_CHANNEL: "{{ rke2_channel }}"
          INSTALL_RKE2_METHOD: "download"
      when: rke2_airgap_mode: false
  when: not check_mode and rke2_version != 'not installed' and (installed_version != rke2_version or running_version != rke2_version)

- name: Copy Custom Manifests
  ansible.builtin.template:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/{{ item | basename }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/{{ item | basename }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_static_pods }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  ansible.builtin.template:
    src: rke2_environment.j2
    dest: /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: 0644
  when: rke2_environment_options | length > 0


