t\n    mode: 0755\n  notify: Restart vault\n\n- name: Set cap_ipc_lock=ep on /usr/bin/vault\n  community.general.capabilities:\n    path: "{{ vault_path }}/usr/bin/vault"\n    capabilities:\n      cap_ipc_lock: +ep\n  changed_when: false\n\n- name: Touch vault.env\n  ansible.builtin.file:\n    path: "{{ vault_path }}/etc/vault.d/vault.env"\n    state: touch\n    owner: "{{ vault_user }}"\n    group: "{{ vault_group }}"\n    mode: 0644\n    preserve: true\n  notify: Restart vault\n\n- name: Create /usr/lib/systemd/system\n  ansible.builtin.file:\n    path: /usr/lib/systemd/system\n    state: directory\n    owner: root\n    group: root\n    mode: 0755\n\n- name: Copy Vault service file\n  ansible.builtin.template:\n    src: vault.service.j2\n    dest: /usr/lib/systemd/system/vault.service\n    owner: root\n    group: root\n    mode: 0644\n  when: ansible_service_mgr == \'systemd\'\n  notify: Daemon reload\n\n- name: Copy vault configuration\n  ansible.builtin.copy:\n    src: vault.hcl\n    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"\n    owner: root\n    group: root\n    mode: 0644\n    force: false\n  notify: Restart vault\n\n- name: Flush handlers\n  ansible.builtin.meta:\n    command: flush_handlers\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-16T16:36:28.962920496Z', 'done': True, 'done_reason': 'stop', 'total_duration': 30026320742, 'load_duration': 100052756, 'prompt_eval_count': 2305, 'prompt_eval_duration': 63976982, 'eval_count': 1320, 'eval_duration': 29860255115, 'model_name': 'deepseek-r1:14b'} id='run--3c585e5e-87e3-4c3c-8b99-a0731d59526c-0' usage_metadata={'input_tokens': 2305, 'output_tokens': 1320, 'total_tokens': 3625}
