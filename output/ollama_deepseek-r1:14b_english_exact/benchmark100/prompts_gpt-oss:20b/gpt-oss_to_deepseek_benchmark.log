n  ansible.builtin.pip:\n    name: "{{ item.name }}"\n    version: "{{ item.version | default(\'\') }}"\n    executable: "{{ python_pip_executable | default(\'pip\') }}"\n    state: present\n  loop:\n    - { name: requests }\n    - { name: setuptools }\n  when:\n    - ansible_distribution_release not in ["bookworm", "noble"]\n    - ansible_os_family not in ["Alpine"]\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-16T17:25:58.108143796Z', 'done': True, 'done_reason': 'stop', 'total_duration': 23801629573, 'load_duration': 90435979, 'prompt_eval_count': 1808, 'prompt_eval_duration': 13565185, 'eval_count': 1089, 'eval_duration': 23695958163, 'model_name': 'deepseek-r1:14b'} id='run--83f13956-d212-47a2-b015-94673e959ef9-0' usage_metadata={'input_tokens': 1808, 'output_tokens': 1089, 'total_tokens': 2897}
