---
- name: Ensure unzip package is available
  package:
    name: unzip
    state: present
    update_cache: "{{ promtail_apt_update_cache }}"

- name: Create promtail group
  group:
    name: "{{ promtail_system_group }}"
    state: present
  when: promtail_system_group != "root"

- name: Create the promtail user
  user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    additional_groups: "{{ promtail_user_additional_groups }}"
    home: ""
    shell: /nologin
    state: present
  when: promtail_system_user != "root"

- name: Ensure /usr/local/bin exists
  file:
    path: /usr/local/bin
    state: directory
    mode: 0755

- name: Create config directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0770
    owner: root
    group: "{{ promtail_system_group }}"
  with_items:
    - "{{ promtail_config_dir }}"
    - "{{ promtail_config_file_sd_dir }}"
    - "{{ promtail_positions_directory }}"

- name: Create application dirs
  file:
    path: "{{ item.path }}"
    state: directory
    mode: 0755
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
  with_items:
    - { path: "{{ promtail_install_dir }}" }
    - { path: "{{ promtail_install_dir }}/{{ promtail_version }}" }

- name: Check promtail binary
  stat:
    path: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail-linux-{{ go_arch }}"
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_dist_url }}"
    dest: "{{ ansible_tmpdir }}/promtail-{{ promtail_version }}.zip"
    force: yes
    checksum: "{{ promtail_custom_checksum if promtail_custom_checksum else __promtail_checksum }}"
  when:
    - not promtail_binary.stat.exists
    - promtail_binary_local_dir == ""
    - not promtail_propagate

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.zip"
    dest: "{{ ansible_tmpdir }}/promtail-{{ promtail_version }}.zip"
    mode: 0755
    owner: root
    group: root
  when:
    - not promtail_binary.stat.exists
    - promtail_binary_local_dir != ""
    - not promtail_propagate

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_dist_url }}"
    dest: "{{ ansible_tmpdir }}/promtail-{{ promtail_version }}.zip"
    force: yes
    checksum: "{{ promtail_custom_checksum if promtail_custom_checksum else __promtail_checksum }}"
    delegate_to: localhost
    run_once: yes
  when: promtail_propagate

- name: Propagate promtail binaries
  copy:
    src: "{{ ansible_tmpdir }}/promtail-{{ promtail_version }}.zip"
    dest: "{{ ansible_tmpdir }}/promtail-{{ promtail_version }}.zip"
    mode: 0755
  when: promtail_propagate

- name: Unpack promtail binaries
  unarchive:
    src: "{{ ansible_tmpdir }}/promtail-{{ promtail_version }}.zip"
    dest: "{{ promtail_install_dir }}/{{ promtail_version }}"
    remote_src: yes
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    mode: 0755
    create_dirs: yes
    ignore_errors: yes

- name: Create symlink to latest version
  file:
    path: /usr/local/bin/promtail
    state: link
    mode: 0755
    target: "{{ promtail_install_dir }}/{{ promtail_version }}/promtail-linux-{{ go_arch }}"
    notify: Restart promtail
  ignore_errors: yes

- name: Write config
  template:
    src: config.j2
    dest: "{{ promtail_config_file }}"
    owner: root
    group: "{{ promtail_system_group }}"
    mode: 0644
    validate_on_diff: yes
    validate_with: /usr/local/bin/promtail -config.file %s -check-syntax
    notify: Restart promtail

- name: Create systemd service unit
  template:
    src: "{{ promtail_systemd_service_template_file }}"
    dest: /etc/systemd/system/{{ promtail_systemd_service }}.service
    mode: 0644
    notify: Restart promtail
