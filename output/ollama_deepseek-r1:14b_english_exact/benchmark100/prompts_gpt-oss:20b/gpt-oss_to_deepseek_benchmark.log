---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  localhost: true

- name: Install using package
  block:
    - name: Install repository for RedHat
      template:
        src: hashicorp.repo.j2
        dest: /etc/yum.repos.d/hashicorp.repo
        remote_src: true
      when: ansible_os_family in ['RedHat', 'Rocky']

    - name: Configure debian
      apt:
        state: present
        config: |
          deb https://apt.releases.hashicorp.com {{ ansible_distribution_version }}
          deb-src https://apt.releases.hashicorp.com {{ ansible_distribution_version }}
      when: ansible_os_family == 'Debian'

    - name: Install required package gpg
      apt:
        name: gpg
        state: present
      when: ansible_os_family == 'Debian'

    - name: Install apt key for Debian
      apt_key:
        key: "{{ hashicorp_gpg_key }}"
        state: present
        validate_certs: no
      when: ansible_os_family == 'Debian'

    - name: Install repository for Debian
      apt_repository:
        repo: "deb https://apt.releases.hashicorp.com {{ ansible_distribution_version }}"
        state: present
        update_cache: yes
      when: ansible_os_family == 'Debian'

    - name: Install hashicorp product using package
      apt:
        name: "{{ item.name }}"
        state: present
        version: "{{ item.version | default('latest') }}"
      when: ansible_os_family == 'Debian'
      with_items: "{{ hashicorp_products }}"
      loop_control:
        loop: "{{ hashicorp_products }}"

    - name: Install latest hashicorp product using package
      apt:
        name: "{{ item }}"
        state: present
        version: 'latest'
      when: ansible_os_family == 'Debian'
      with_items: "{{ hashicorp_products | selectattr('version', 'missing') }}"

    - name: Install versioned hashicorp product using package
      apt:
        name: "{{ item }}"
        state: present
        version: "{{ item.version }}"
      when: ansible_os_family == 'Debian'
      with_items: "{{ hashicorp_products | selectattr('version', 'present') }}"

  when: hashicorp_install_method == 'package'

- name: Install manually
  block:
    - name: Install hashicorp product manually
      unarchive:
        src: "{{ hashicorp_src }}"
        dest: "{{ hashicorp_destination }}"
        remote_src: true
        group: "{{ hashicorp_group | default('nogroup') }}"
        mode: "{{ hashicorp_mode | default('0755') }}"
        owner: "{{ hashicorp_owner | default('nobody') }}"
      with_items: "{{ hashicorp_products }}"

  when: hashicorp_install_method == 'manual'


