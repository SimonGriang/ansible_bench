---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
    delegate_to: localhost
    run_once: true

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  selinux:
    state: "{{ selinux_state | default('disabled') }}"
    boolean: "{{ item.key }}={{ item.value }}"
    persist: true
  with_items: "{{ httpd_sebooleans | default({}) | dict_iteritems() }}"
  when: ansible_os_family == 'RedHat'

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify: 
    - Test httpd configuration validity
    - Restart httpd

- name: Activate httpd module | Debian
  command: a2enmod "{{ item }}"
    chdir: /etc/apache2
  with_items: "{{ httpd_modules_to_activate_with_command | default([]) }}"
  changed_when: False
  notify: Test httpd configuration validity
  when: ansible_os_family == 'Debian'

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable | default(false)

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations | default(false) | bool

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts | default(false) | bool

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf }}.j2"
    dest: "{{ httpd_server_root }}/{{ httpd_ports_conf }}"
    mode: 0644
  notify: 
    - Test httpd configuration validity
    - Restart httpd
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories | default(false) | bool

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example | default(false)

- name: Start and enable httpd
  service:
    name: "{{ httpd_service | default('httpd') }}"
    state: started
    enabled: true


