---
- name: Import assert.yml
  import_tasks: assert.yml
  loop: false
  host: localhost

- name: Install vsftpd
  apt:
    name: vsftpd
    state: present

- name: Configure vsftpd
  template:
    src: vsftpd.conf.j2
    dest: "{{ vsftpd_configuration_file }}"
    owner: root
    group: root
    mode: "{{ vsftpd_configuration_file_mode | default('0644') }}"
  notify: Restart vsftpd

- name: Start and enable vsftpd
  service:
    name: vsftpd
    state: started
    enabled: true


