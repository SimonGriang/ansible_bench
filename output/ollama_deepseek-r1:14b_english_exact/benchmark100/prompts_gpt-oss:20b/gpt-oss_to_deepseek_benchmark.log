e vhosts\n  ansible.builtin.template:\n    src: "{{ vhost_conf_template }}"\n    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"\n    mode: 420  # 0644 in decimal\n  loop: "{{ httpd_vhosts | default([]) | list }}"\n  notify:\n    - Test httpd configuration validity\n    - Restart httpd\n  tags:\n    - vhost\n\n- name: Enable vhosts\n  ansible.builtin.command:\n    cmd: a2ensite {{ item.name }}\n  loop: "{{ httpd_vhosts | default([]) | list }}"\n  when:\n    - ansible_os_family == \'Debian\'\n  notify:\n    - Test httpd configuration validity\n    - Restart httpd\n  tags:\n    - vhost\n  changed_when: false  # Command shouldn\'t change state if already enabled\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-16T18:02:07.957460191Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14389617133, 'load_duration': 90312047, 'prompt_eval_count': 1766, 'prompt_eval_duration': 944040989, 'eval_count': 698, 'eval_duration': 13354325649, 'model_name': 'deepseek-r1:14b'} id='run--86df7618-db7b-4594-ad11-192ad5055fcb-0' usage_metadata={'input_tokens': 1766, 'output_tokens': 698, 'total_tokens': 2464}
