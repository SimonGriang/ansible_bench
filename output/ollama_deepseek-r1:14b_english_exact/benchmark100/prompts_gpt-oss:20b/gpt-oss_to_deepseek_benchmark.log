---
- name: Load OS-specific vars  
  include_vars:  
    dir: vars/  
    files:  
      - "{{ ansible_distribution }}.yml"  
      - "{{ ansible_os_family }}.yml"  
      - main.yml  

- name: include_tasks: setup-RedHat.yml  
  include_tasks: setup-RedHat.yml  
  when: ansible_facts.os_family == 'RedHat'  

- name: include_tasks: setup-Debian.yml  
  include_tasks: setup-Debian.yml  
  when: ansible_facts.os_family == 'Debian'  

- name: Install Docker packages  
  become: yes  
  package:  
    name: "{{ docker_packages }}"  
    state: "{{ docker_packages_state }}"  
  notify: restart docker  
  ignore_errors: check_mode  
  when:  
    - ansible_version < "2.12"  
    - ansible_facts.os_family not in ['RedHat', 'Debian']  

- name: Install Docker packages (with downgrade option)  
  become: yes  
  package:  
    name: "{{ docker_packages }}"  
    state: "{{ docker_packages_state }}"  
    allow_downgrade: yes  
  notify: restart docker  
  ignore_errors: check_mode  
  when:  
    - ansible_version >= "2.12"  
    - ansible_facts.os_family in ['RedHat', 'Debian']  

- name: Install docker-compose plugin  
  become: yes  
  package:  
    name: "{{ docker_compose_package }}"  
    state: "{{ docker_compose_package_state }}"  
  notify: restart docker  
  ignore_errors: check_mode  
  when:  
    - docker_install_compose_plugin  
    - (ansible_version < "2.12" or ansible_facts.os_family not in ['RedHat', 'Debian'])  

- name: Install docker-compose-plugin (with downgrade option)  
  become: yes  
  package:  
    name: "{{ docker_compose_package }}"  
    state: "{{ docker_compose_package_state }}"  
    allow_downgrade: yes  
  notify: restart docker  
  ignore_errors: check_mode  
  when:  
    - docker_install_compose_plugin  
    - ansible_version >= "2.12"  
    - ansible_facts.os_family in ['RedHat', 'Debian']  

- name: Ensure /etc/docker/ directory exists  
  file:  
    path: /etc/docker  
    state: directory  
    mode: 0755  
  when:  
    - "{{ docker_daemon_options | dict_keys | list | count }}" > 0  

- name: Configure Docker daemon options  
  copy:  
    content: "{{ docker_daemon_options | to_json }}"  
    dest: /etc/docker/daemon.json  
    mode: 0644  
  when:  
    - "{{ docker_daemon_options | dict_keys | list | count }}" > 0  
  notify: restart docker  

- name: Ensure Docker is started and enabled at boot  
  service:  
    name: docker  
    state: "{{ docker_service_state }}"  
    enabled: "{{ docker_service_enabled }}"  
  ignore_errors: check_mode  
  when: docker_service_manage  

- name: Ensure handlers are notified now to avoid firewall conflicts  
  meta: flush_handlers  

- name: include_tasks: docker-compose.yml  
  include_tasks: docker-compose.yml  
  when: docker_install_compose  

- name: Get docker group info using getent  
  shell: getent group docker  
  register: docker_group_info  
  when:  
    - "{{ docker_users | list | count }}" > 0  

- name: Check if there are any users to add to the docker group  
  set_fact:  
    at_least_one_user_to_modify: yes  
  when:  
    - "{{ docker_users | list | count }}" > 0  
  with_items: "{{ docker_users }}"  

- name: include_tasks: docker-users.yml  
  include_tasks: docker-users.yml  
  when: at_least_one_user_to_modify


