  when: not item.stat.exists

- name: Java | Setting keystore variables in java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir | default(java_keystore_dir_old) | default('')}}"
  when: java_open_jdk_version_major < 11

- name: Java | Setting keystore variables in java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir | default(java_keystore_dir_new) | default('')}}"
  when: java_open_jdk_version_major >= 11

- name: Java | Import SSL certificates
  java_cert:
    path: "{{ item.java_cert_path }}"
    dest: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts"
    alias: "{{ item.java_cert_alias }}"
    password: "{{ java_cert_keystore_pass }}"
    state: present
    keystore_create: true
  with_items: java_certs

