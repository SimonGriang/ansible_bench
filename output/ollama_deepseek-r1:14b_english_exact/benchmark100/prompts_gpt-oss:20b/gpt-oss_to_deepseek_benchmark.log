- name: client | Ensure /etc/openvpn/client exists
  file:
    path: /etc/openvpn/client
    state: directory
    owner: root
    group: "{{ openvpn_group }}"
    mode: 0750

- name: client | Place client.conf
  template:
    src: client.conf.j2
    dest: "{{ openvpn_configuration_directory }}/client.conf"
    owner: root
    group: "{{ openvpn_group }}"
    mode: 0640
  notify: Restart openvpn


