lue=bootstrap_facts.stdout_lines, regex=r\'VERSION_ID="?([^"]+)"?\', default=\'NA\') }}"\n  loop: "{{ (bootstrap_os_family_map | dict2items | flatten).value }}"\n  loop_control:\n    loop_var: item\n  when:\n    - bootstrap_facts.rc == 0\n    - not bootstrap_distribution | defined\n    - (bootstrap_search[item] | default(item)) in bootstrap_facts.stdout_lines | join(\' \')\n\n- name: gather_facts | Set bootstrap facts (II)\n  ansible.builtin.set_fact:\n    bootstrap_os_family: "{{ item.key }}"\n  loop: "{{ bootstrap_os_family_map | dict2items }}"\n  loop_control:\n    loop_var: item\n  when: bootstrap_distribution is defined and item.value contains bootstrap_distribution\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-16T17:37:49.204229098Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13527082301, 'load_duration': 97859234, 'prompt_eval_count': 560, 'prompt_eval_duration': 364320021, 'eval_count': 600, 'eval_duration': 13064105067, 'model_name': 'deepseek-r1:14b'} id='run--572db41e-9692-4448-a6e5-ad7147ef846b-0' usage_metadata={'input_tokens': 560, 'output_tokens': 600, 'total_tokens': 1160}
