---
- name: Remove Docker GPG key
  file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Remove old Docker apt source list
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Remove old Docker versions
  apt:
    name: "^docker$"
    state: absent
    purge: yes
    update_cache: no

- name: Remove legacy Docker repository files
  file:
    path: /etc/apt/sources.list.d/docker.list.*
    state: absent

- name: Install necessary dependencies
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Add or remove Docker repository
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: "{{ docker_add_repo | default('present') | ternary('present', 'absent') }}"
    content: |+
      deb [{{ ' '.join(['signed-by=/usr/share/keyrings/docker-archive-keyring.gpg'] if docker_add_repo else []) }}]
      https://download.docker.com/linux/ubuntu
      "{{ ansible_lsb.codename }}"
      stable
    when: docker_add_repo | default(false)
  when: docker_add_repo | default(false)

- name: Notify handlers to update apt cache
