- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: "{{ helm_bin_path }} --version"
  ignore_errors: yes
  register: helm_existing_version
  when:
    - helm_existing_version.rc is not defined

- name: Download helm
  unarchive:
    url: "{{ helm_repo_path }}/v{{ helm_version }}/helm-{{ helm_version }}-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: /tmp
    remote_src: yes
    mode: 0755
  when:
    - not helm_check.stat.exists
    - helm_existing_version.rc is not defined
    - helm_existing_version.stdout is not equal to "v{{ helm_version }}"
  register: helm_download

- name: Copy helm binary into place
  copy:
    src: /tmp/{{ helm_platform }}-{{ helm_arch }}/helm
    dest: "{{ helm_bin_path }}"
    mode: 0755
  when: helm_download is not skipped
