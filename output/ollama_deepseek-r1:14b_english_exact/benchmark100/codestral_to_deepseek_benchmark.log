---
- name: Task 1: Import assert.yml
  import_tasks:
    file: "{{ playbook_dir }}/files/assert.yml"

- name: Task 2: Install requirements
  apt:
    name: "{{ openssl_requirements }}"
    state: present

- name: Task 3: Install pip packages
  pip:
    packages: "{{ openssl_pip_packages }}"
    state: present

- name: Task 4: Create key directory
  file:
    path: "{{ key_path }}"
    state: directory
    mode: 700
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Task 5: Create csr directory
  file:
    path: "{{ csr_path }}"
    state: directory
    mode: 755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Task 6: Create crt directory
  file:
    path: "{{ crt_path }}"
    state: directory
    mode: 755
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Task 7: Include create.yml
  import_tasks: "{{ playbook_dir }}/files/create.yml"
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item_name
  vars:
    name: "{{ item_name.name }}"

