---
- name: Remove old Docker versions
  ansible.builtin.package:
    name: "{{ item }}"
    state: absent
  with_items: "{{ docker_obsolete_packages }}"

- name: Add Docker GPG key
  ansible.builtin.apt_key:
    key: "{{ docker_yum_gpg_key }}"
    state: present
  when: docker_add_repo

- name: Add Docker repository
  ansible.builtin.apt_repository:
    repo: "{{ docker_yum_repo_url }}"
    state: present
  when: docker_add_repo

- name: Configure Docker Nightly repo
  community.general.ini_file:
    path: /etc/yum.repos.d/docker.repo
    section: docker-nightly
    key: enabled
    value: "{{ docker_yum_repo_enable_nightly }}"
  when: docker_add_repo

- name: Configure Docker Test repo
  community.general.ini_file:
    path: /etc/yum.repos.d/docker.repo
    section: docker-test
    key: enabled
    value: "{{ docker_yum_repo_enable_test }}"
  when: docker_add_repo

- name: Configure containerd on RHEL 8
  ansible.builtin.dnf:
    name: runc
    state: absent
  when: ansible_distribution == "RedHat" and ansible_major_version == "8"

- name: Install containerd packages
  ansible.builtin.dnf:
    name: "{{ item }}"
    state: present
  with_items:
    - container-selinux
    - containerd.io
  when: ansible_distribution == "RedHat" and ansible_major_version == "8"


