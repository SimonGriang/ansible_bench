---
- name: Create document root directories
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
    owner: www-data
    group: www-data
  loop: "{{ httpd_vhosts }}"
  loop_control:
    loop_var: item
  when: item.documentroot is not empty
  notify: httpd_config_test

- name: Configure virtual hosts
  template:
    src: "vhosts/{{ item.name }}.conf.j2"
    dest: "/etc/httpd/conf.d/{{ item.name }}.conf"
    mode: 0644
  loop: "{{ httpd_vhosts }}"
  loop_control:
    loop_var: item
  notify: httpd_config_test

- name: Enable virtual hosts on Debian systems
  apt:
    name: "{{ item.name }}"
    state: present
    enabled: yes
  loop: "{{ httpd_vhosts }}"
  loop_control:
    loop_var: item
  when: ansible_distribution == "Debian"
  notify: httpd_config_test


