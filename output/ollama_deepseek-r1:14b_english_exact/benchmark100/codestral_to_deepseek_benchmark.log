---
- name: Create SSL key
  ansible.builtin.openssl_privatekey:
    path: "{{ ssl_key_path }}"
    passphrase: "{{ ssl_key_passphrase | default('') | quote }}"
    provider: openssl
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: 600

- name: Create SSL CSR
  ansible.builtin.openssl_csr:
    path: "{{ ssl_csr_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    common_name: "{{ common_name }}"
    subject_alt_names: "{{ subject_alt_names }}"
    ca_subject: no
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: 640

- name: Create SSL certificates
  ansible.builtin.openssl_certificate:
    path: "{{ ssl_cert_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    csr_path: "{{ ssl_csr_path }}"
    validity: "{{ certificate_validity_days }}"
    provider: openssl
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: 640

- name: Create PKCS#12 file
  ansible.builtin.openssl_pkcs12:
    path: "{{ pkcs12_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    certificate_path: "{{ ssl_cert_path }}"
    passphrase: "{{ pkcs12_passphrase | default('') | quote }}"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: 600

- name: Read private key
  ansible.builtin.file:
    path: "{{ ssl_key_path }}"
    state: content
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: 600
  register: ssl_private_key_content

- name: Read certificate
  ansible.builtin.file:
    path: "{{ ssl_cert_path }}"
    state: content
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: 600
  register: ssl_certificate_content

- name: Create combined private_key and certificate file
  ansible.builtin.copy:
    content: |
      {{ ssl_private_key_content.content }}\n
      {{ ssl_certificate_content.content }}
    dest: "{{ combined_ssl_path }}"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: 600



