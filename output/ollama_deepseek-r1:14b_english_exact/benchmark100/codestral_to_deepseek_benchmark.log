---
- name: Import assert.yml
  import_tasks: tasks/assert.yml

- name: Install logrotate
  apt:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  template:
    src: logrotate_config_file.j2
    dest: "{{ logrotate_config_directory }}/logrotate_config_file"
    mode: 0644

- name: Generate logrotate.d files
  when: logrotate_entries is defined and (entry.state is not defined or entry.state != 'absent')
  loop: "{{ logrotate_entries | default([]) }}"
  template:
    src: entry.j2
    dest: "{{ logrotate_confd_directory }}/{{ entry.name }}"
    mode: 0644

- name: Remove logrotate.d files
  when: logrotate_entries is defined and entry.state == 'absent'
  loop: "{{ logrotate_entries | default([]) }}"
  file:
    path: "{{ logrotate_confd_directory }}/{{ entry.name }}"
    state: absent

- name: Start logrotate
  when: logrotate_service is not empty string
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"

