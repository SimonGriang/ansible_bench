---

- name: Ensure /etc/openvpn/easy-rsa directory exists
  file:
    path: "{{ openvpn_configuration_directory }}/easy-rsa"
    state: directory
    mode: 0755

- name: Initialize easy-rsa
  shell: "{{ openvpn_easyrsa_path }}/easyrsa init-pki"
  args:
    chdir: "{{ openvpn_configuration_directory }}/easy-rsa"
  creates: "{{ openvpn_configuration_directory }}/easy-rsa/pki"

- name: Build CA
  shell: "{{ openvpn_easyrsa_path }}/easyrsa build-ca nopass"
  args:
    chdir: "{{ openvpn_configuration_directory }}/easy-rsa"
    env:
      EASYRSA_BATCH: true
  creates: "{{ openvpn_configuration_directory }}/easy-rsa/pki/ca.crt"

- name: Generate Diffie-Hellman parameters
  shell: "{{ openvpn_easyrsa_path }}/easyrsa gen-dh"
  args:
    chdir: "{{ openvpn_configuration_directory }}/easy-rsa"
  creates: "{{ openvpn_configuration_directory }}/easy-rsa/pki/dh.pem"

- name: Build server certificates
  shell: "{{ openvpn_easyrsa_path }}/easyrsa build-server-full server nopass"
  args:
    chdir: "{{ openvpn_configuration_directory }}/easy-rsa"
    env:
      EASYRSA_BATCH: true
  creates: "{{ openvpn_configuration_directory }}/easy-rsa/pki/issued/
           server.crt"

- name: Build client certificates
  shell: "{{ openvpn_easyrsa_path }}/easyrsa build-client-full client nopass"
  args:
    chdir: "{{ openvpn_configuration_directory }}/easy-rsa"
    env:
      EASYRSA_BATCH: true
  creates: "{{ openvpn_configuration_directory }}/easy-rsa/pki/issued/
           client.crt"

- name: Generate Certificate Revocation List
  shell: "{{ openvpn_easyrsa_path }}/easyrsa gen-crl"
  args:
    chdir: "{{ openvpn_configuration_directory }}/easy-rsa"
  creates: "{{ openvpn_configuration_directory }}/easy-rsa/pki/crl.pem"

- name: Generate TLS Auth Key
  shell: openvpn --genkey --secret "{{ openvpn_configuration_directory }}/easy-rsa/pki/ta.key"
  creates: "{{ openvpn_configuration_directory }}/easy-rsa/pki/ta.key"

- name: Copy files to /etc/openvpn/server
  copy:
    remote_src: true
    src: "{{ openvpn_configuration_directory }}/easy-rsa/pki/{{ item }}"
    dest: /etc/openvpn/server
    mode: 0644
  loop:
    - ca.crt
    - ca.key
    - dh.pem
    - server.crt
    - server.key
    - ta.key
    - crl.pem

- name: Copy files to /etc/openvpn
  copy:
    remote_src: true
    src: "{{ openvpn_configuration_directory }}/easy-rsa/pki/{{ item }}"
    dest: /etc/openvpn
    mode: 0644
  loop:
    - crl.pem

- name: Place server.conf
  template:
    src: server.conf.j2
    dest: "{{ openvpn_configuration_directory }}/server.conf"
    mode: 0640
  notify: Restart openvpn
  owner: root
  group: "{{ openvpn_group }}"

