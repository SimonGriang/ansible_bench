---
- name: Import assert.yml
  import_tasks: assert.yml
  remote_addr: localhost

- name: Configure apk
  apt:
    state: update
  apt:
    state: upgrade
  notify: Reboot

- name: Configure apt
  apt:
    name: "{{ update_excluded_packages }}"
    state: present
    upgrade: no
  apt:
    state: update
    cache_valid_time: "{{ update_cache_valid_time }}"
    upgrade_command: "{{ update_upgrade_command }}"
  apt:
    state: upgrade
    autoremove: "{{ update_autoremove | default('yes') | lower == 'yes' }} "
  notify: Reboot

- name: Update all software (dnf)
  dnf:
    name: "*"
    state: present
    exclude: "{{ update_excluded_packages }}"
  notify: Reboot

- name: Update all software (pacman)
  pacman:
    state: update
    update_cache: yes
  pacman:
    state: upgrade
  notify: Reboot

- name: Configure yum
  yum:
    name: "*"
    state: present
    exclude: "{{ update_excluded_packages }}"
  notify: Reboot
  when: ansible_distribution_major_version != 6
  yum:
    name: yum-utils
    state: present

- name: Update all software (zypper)
  zypper:
    name: "*"
    state: update
  notify: Reboot


