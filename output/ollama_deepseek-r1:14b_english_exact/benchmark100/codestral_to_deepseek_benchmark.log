    ignore_errors: yes
  meta:
    skip_if_check_mode: yes

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ distribution.stdout | regex_search(pattern) | first }}"
    bootstrap_major_version: "{{ distribution.stdout | regex_search(pattern) | first | regex_replace('.*?([0-9]+).*', '\\1') }}"
  with_items:
    - {distribution: 'Ubuntu', pattern: 'Ubuntu ([0-9.]+)'}
    - {distribution: 'Debian', pattern: 'Debian ([0-9.]+)'}
    - {distribution: 'CentOS', pattern: 'CentOS ([0-9.]+)'}
    - {distribution: 'Fedora', pattern: 'Fedora ([0-9.]+)'}
