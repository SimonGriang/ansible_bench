---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install required packages
  apt:
    name: "{{ service_required_packages }}"
    state: present

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: /etc/systemd/system/myservice.service
  when: ansible_system == 'ansible_systemd'

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: /etc/init.d/myservice
  when: ansible_system != 'ansible_systemd'

- name: Manage service
  service:
    name: "{{ item }}"
    state: "{{ state }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  meta:
    flush_handlers: true


