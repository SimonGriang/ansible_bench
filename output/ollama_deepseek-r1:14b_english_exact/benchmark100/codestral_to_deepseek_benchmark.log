---
- name: Ensure unzip package is installed
  apt:
    name: unzip
    state: present
    update_cache: "{{ promtail_apt_update_cache }}"

- name: Create promtail group
  group:
    name: "{{ promtail_system_group }}"
    state: present
    system: true
  when: promtail_system_group is not "root"

- name: Create promtail user
  user:
    name: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
    additional_groups: "{{ promtail_user_additional_groups | default([]) | list }}"
    shell: /usr/sbin/nologin
    create_home: no
    system: true
  when: promtail_system_user is not "root"

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: 0755

- name: Create configuration directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0770
    owner: root
    group: "{{ promtail_system_group }}"
  loop:
    - "{{ promtail_config_dir }}"
    - "{{ promtail_config_file_sd_dir }}"
    - "{{ promtail_positions_directory }}"

- name: Create application directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: 0755
    owner: "{{ promtail_system_user }}"
    group: "{{ promtail_system_group }}"
  loop:
    - { path: "{{ promtail_install_dir }}" }
    - { path: "{{ promtail_install_dir }}/promtail_version" }

- name: Check promtail binary
  stat:
    path: "{{ promtail_install_dir }}/promtail_version/promtail-linux-{{ go_arch }}"
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_dist_url }}"
    dest: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"
    checksum: "{{ (promtail_custom_checksum is defined) | ternary(promtail_custom_checksum, __promtail_checksum) }}"
  when:
    - promtail_binary.stat.exists is false
    - promtail_binary_local_dir is empty
    - promtail_binary_propagate is false

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_binary_local_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"
    dest: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"
  when:
    - promtail_binary.stat.exists is false
    - promtail_binary_local_dir is not empty
    - promtail_binary_propagate is false

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_dist_url }}"
    dest: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"
    checksum: "{{ (promtail_custom_checksum is defined) | ternary(promtail_custom_checksum, __promtail_checksum) }}"
  when:
    - promtail_binary_propagate is true

- name: Propagate promtail binaries
  copy:
    src: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"
    dest: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"
  when:
    - promtail_binary_propagate is true

- name: Unpack promtail binaries
  unzip:
    src: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"
    dest: "{{ promtail_install_dir }}/promtail_version"
    mode: 0755
    creates: "{{ promtail_install_dir }}/promtail_version/promtail-linux-{{ go_arch }}"
    remote_src: yes

- name: Create symlink to latest version
  file:
    src: "{{ promtail_install_dir }}/promtail_version/promtail-linux-{{ go_arch }}"
    dest: /usr/local/bin/promtail
    state: link
    mode: 0755
  notify: Restart promtail

- name: Write config
  template:
    src: config.j2
    dest: "{{ promtail_config_file }}"
    owner: root
    group: "{{ promtail_system_group }}"
    mode: 0644
  register: promtail_config
  notify: Restart promtail

- name: Create systemd service unit
  template:
    src: "{{ promtail_systemd_service_template_file }}"
    dest: /etc/systemd/system/promtail_systemd_service.service
    mode: 0644
  notify: Restart promtail


