  group:
    name: bind
    state: present

- name: Create user
  user:
    name: bind
    group: bind
    system: yes
    home: /var/named

- name: Generate rndc key
  command: rndc-confgen -a
  args:
    chdir: /etc/named
  register: rndc_key
  changed_when: false

- name: Set permissions on rndc key file
  file:
    path: /etc/named/rndc.key
    owner: root
    group: bind
    mode: 0644

- name: Get the hints/root file
  get_url:
    url: ftp://ftp.ubuntu.com/ubuntu/pool/main/n/bind9/Ubuntu/named.ca
    dest: /var/named/named.ca
    mode: 0644
  when: "{{ caching_enabled | bool }}"

- name: Create zone file
  template:
    src: "{{ item.template }}"
    dest: /var/named/{{ item.zone }}.db
    mode: 0644
    owner: root
    group: bind
  loop: "{{ zones }}"
  when: "{{ primary_zone | bool }}"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named/named.conf
    mode: 0644
    owner: root
    group: bind

- name: Place systemd override
  template:
    src: named.service.j2
    dest: /etc/systemd/system/named.service.d/override.conf
    mode: 0644
    owner: root
    group: root
  when: "{{ service_manager == 'systemd' | bool }}"

- name: Start and enable dns
  service:
    name: named
    state: started
    enabled: yes

