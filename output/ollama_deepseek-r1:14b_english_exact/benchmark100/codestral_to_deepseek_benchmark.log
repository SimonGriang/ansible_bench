  file:
    path: /etc/docker
    state: directory
    mode: 0755
  when:docker_daemon_options is defined and docker_daemon_options.keys()|list|length > 0

- name: Configure Docker daemon options
  template:
    src: daemon.json.j2
    dest: /etc/docker/daemon.json
    mode: 0644
