tasks:
  - name: Task 1: Disable swap
    shell: swapoff -a
    when: vault_hardening_disable_swap

  - name: Remove swap entry from fstab
    mount:
      path: /dev/sda2
      state: absent
    when: vault_hardening_disable_swap

  - name: Task 2: Disable core dumps
    pam_limits:
      limits: "{{ item.limit }}"
      domain: "{{ item.domain }}"
      mode: soft
    loop: "{{ vault_hardening_core_dumps_vars | default([]) }}"

  - name: Task 3: Disable Shell Command History
    copy:
      content: |
        export HISTIGNORE="&: vault:*"
      dest: /etc/profile.d/disable_vault_history.sh
      mode: 0755
      owner: root
      group: root
    when: vault_hardening_disable_shell_command_history

  - name: Task 4: Configure SELinux / AppArmor
    block:
      - name: Check if SELinux is enabled
        command: selinux enabled
        when: vault_hardening_configure_selinux_apparmor
        register: selinux_enabled

      - name: Install SELinux policy
        dnf:
          name: selinux-policy
          state: present
        when: selinux_enabled.stdout | bool

      - name: Set SELinux to enforcing
        command: setenforce 1
        when: selinux_enabled.stdout | bool

      - name: Check if AppArmor is enabled
        command: aa-enabled
        when: vault_hardening_configure_selinux_apparmor
        register: apparmor_enabled

      - name: Enable AppArmor profile for Vault
        command: aa-enabled
        when: apparmor_enabled.stdout | bool
    when: vault_hardening_configure_selinux_apparmor

