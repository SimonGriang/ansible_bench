---
- name: Import assert.yml
  ansible.builtin.include_tasks:
    file: assert.yml

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout | default(3600) }}"

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.raw: whoami
      changed_when: false

    - name: Check sudo availability
      ansible.builtin.raw: sudo --version
      ignore_errors: yes

    - name: Gather bootstrap facts
      ansible.builtin.setup:
        gather_subset: minimal
      changed_when: false
      ignore_errors: yes

    - name: Install libdnf5 on Fedora/RedHat
      ansible.builtin.yum:
        name: "{{ ['dnf5'] if ansible_distribution in ['Fedora', 'RedHat'] else [] }}"
        state: present
      when: ansible_distribution in ['Fedora', 'RedHat']

    - name: Install bootstrap packages
      ansible.builtin.raw: |
        dnf install -y --setopt=install_weak_deps=False --exclude='*debug*' "{{ item }}"
      loop: "{{ bootstrap_facts_packages | default([]) }}"
      when: ansible_distribution in ['Fedora', 'RedHat']

    - name: Install bootstrap packages
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
        update_cache: yes
      loop: "{{ bootstrap_facts_packages | default([]) }}"
      when: ansible_distribution == 'Debian'

  become: "{{ bootstrap_become | default(true) }}"

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: all

- name: Install bootstrap packages (package)
  ansible.builtin.yum:
    name: "{{ item }}"
    state: present
  loop: "{{ bootstrap_facts_packages | default([]) }}"

  - name: Install bootstrap packages (apt)
    ansible.builtin.apt:
      name: "{{ item }}"
      state: present
      update_cache: yes
    loop: "{{ bootstrap_facts_packages | default([]) }}"


