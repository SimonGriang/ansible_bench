---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: files/assert.yml
  tags: []

- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
  notify: 
    - set_mysql_root_password
    - reload_systemd
  tags: []

- name: Configure mysql server
  ansible.builtin.template:
    path: "{{ mysql_server_config_file }}"
    dest: "/etc/mysql/mysql-server.cnf"
    owner: root
    group: root
    mode: 0644
  notify: 
    - restart_mysql_server
  tags: []

- name: Configure mysql client
  ansible.builtin.template:
    path: "{{ mysql_client_config_file }}"
    dest: "/etc/mysql/mysql-client.cnf"
    owner: root
    group: root
    mode: 0644
  tags: []

- name: Initialize mysql
  ansible.builtin.command:
    cmd: "{{ mysql_initialize_command }}"
  when: ansible_distribution in ['alpine', 'arch']
  tags: []

- name: Start and enable mysql
  ansible.builtin.systemd:
    name: mysql
    state: started
    enabled: yes
  tags: []

- name: Flush handlers
  ansible.builtin.metadata:
    cmd: runHandlers
  tags: []

- name: Place my.cnf
  ansible.builtin.template:
    path: "{{ my_cnf_template }}"
    dest: /root/.my.cnf
    mode: 0600
  tags: []

- name: Create databases
  ansible.builtin.mysql_db:
    name: "{{ db.name }}"
    state: present
    skip_if_exists: yes
  loop: "{{ mysql_databases | default([]) }}"
  when: mysql_databases | default([]) | length > 0 and db.initial_import | default(false) == false
  tags: []

- name: List databases
  ansible.builtin.mysql_info:
    query: "SHOW DATABASES;"
  register: mysql_info
  tags: []

- name: Import database
  ansible.builtin.mysql_db:
    name: "{{ db.name }}"
    state: import
    backup_file: "{{ db.initial_import }}"
  loop: "{{ mysql_databases | default([]) }}"
  when: db.initial_import is defined and db.initial_import is not null
  tags: []

- name: Create users
  ansible.builtin.mysql_user:
    name: "{{ user.name }}"
    password: "{{ user.password }}"
    priv: "{{ user.privileges | join(',') }}"
    state: present
  loop: "{{ mysql_users | default([]) }}"
  when: mysql_users | default([]) | length > 0
  tags: []

- name: Flush handlers again
  ansible.builtin.metadata:
    cmd: runHandlers
  tags: []


