---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install requirements
  apt:
    name: "{{ sysctl_requirements }}"
    state: present
    update_cache: yes

- name: Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    sysctl_set: "{{ sysctl_set }}"
    sysctl_reload: "{{ sysctl_reload | default('yes') | lower }}"
  loop: "{{ sysctl_items }}"
  when: not (ansible_connection in ['container', 'docker', 'community.docker.docker'])
  notify: reload_sysctl

- name: Flush handlers
  meta: flush_handlers

handlers:
  - name: reload_sysctl
    service:
      name: sysctl
      state: reload


