---
- name: Import assert.yml
  import_tasks: assert.yml
  remote_addr: localhost

- name: Configure apk
  apk:
    state: update
  notify: Reboot
  register: apk_update

- name: Configure apt
  apt:
    name: "{{ update_excluded_packages }}"
    state: present
    upgrade: no
    cache_valid_time: "{{ update_cache_valid_time }}"
    upgrade_command: "{{ update_upgrade_command }}"
    autoremove: "{{ update_autoremove | default('yes') | boolean }}"
  notify: Reboot

- name: Update all software (dnf)
  dnf:
    name: "*"
    state: present
    exclude: "{{ update_excluded_packages | default([]) }}"
  notify: Reboot

- name: Update all software (pacman)
  pacman:
    state: upgrade
    update_cache: yes
  notify: Reboot

- name: Configure yum
  yum:
    name: ["*", "yum-utils"]
    state: present
    exclude: "{{ update_excluded_packages }}"
  notify: Reboot
  when: ansible_distribution_major_version != 6

- name: Update all software (zypper)
  zypper:
    name: "*"
    state: update
  notify: Reboot


