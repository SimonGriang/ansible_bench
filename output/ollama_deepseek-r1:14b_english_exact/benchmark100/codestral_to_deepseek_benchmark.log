---
- name: gather_facts | Lookup bootstrap facts
  raw:
    cmd: cat /etc/os-release
  register: bootstrap_facts
  become: false
  check_mode: false
  changed_when: false

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
    bootstrap_distribution: "{{ item.value }}"
  loop: "{{ bootstrap_os_family_map | dict2list }}"
  when:
    - task_1_gather_facts_result is succeeded
    - bootstrap_distribution is not defined
    - bootstrap_facts.stdout | regex_search('^(NAME="|ID="|VERSION_ID=")')

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  loop: "{{ bootstrap_os_family_map | dict2list }}"
  when:
    - bootstrap_distribution is defined
    - "'{{ item.value }}'" in "{{ bootstrap_os_family_map.values() | join(',') }}"


