---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.command:
    cmd: lsb_release -d
    capture_output: yes
    register: bootstrap_facts
    changed_when: false
    ignore_errors: yes
  meta:
    skip_if_check_mode: yes

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ distribution.stdout | regex_search(pattern) | first }}"
    bootstrap_major_version: "{{ distribution.stdout | regex_search(pattern) | first | regex_replace('.*?([0-9]+).*', '\1') }}"
  with_items:
    - { distribution: 'Ubuntu', pattern: 'Ubuntu ([0-9.]+)' }
    - { distribution: 'Debian', pattern: 'Debian ([0-9.]+)' }
    - { distribution: 'CentOS', pattern: 'CentOS ([0-9.]+)' }
    - { distribution: 'Fedora', pattern: 'Fedora ([0-9.]+)' }
    - { distribution: 'Arch', pattern: 'Arch ([0-9.]+)' }
  when:
    - bootstrap_facts is defined
    - not ansible_check_mode
    - 'bootstrap_distribution' not in ansible_facts
  meta:
    changed_when: false
    ignore_errors: yes
    failed_when: false

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  with_dict:
    - { key: 'RedHat', value: ['CentOS', 'Fedora'] }
    - { key: 'Debian', value: ['Debian', 'Ubuntu'] }
    - { key: 'Arch', value: ['Arch'] }
  when:
    - 'bootstrap_distribution' in ansible_facts
    - ansible_facts.bootstrap_distribution in item.value
  meta:
    changed_when: false
    ignore_errors: yes


