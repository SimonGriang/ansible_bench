---
- name: Check current docker-compose version
  ansible.builtin.docker:
    command: compose version
    state: present
  register: docker_compose_vsn

- name: Set fact for current docker-compose version
  ansible.builtin.set_fact:
    docker_compose_current_version: "{{ docker_compose_vsn.stdout | regex_replace('.*version (\\d+\\.\\d+\\.\\d+).*', '\\1') }}"

- name: Remove existing docker-compose version if it's different
  ansible.builtin.file:
    path: "{{ docker_compose_path }}"
    state: absent
  when:
    - docker_compose_current_version is defined
    - docker_compose_current_version != "{{ docker_compose_version }}"

- name: Install Docker Compose (if configured)
  ansible.builtin.url:
    url: "{{ docker_compose_url }}"
    dest: "{{ docker_compose_path }}"
    mode: 0755
  when:
    - docker_compose_current_version is not defined
