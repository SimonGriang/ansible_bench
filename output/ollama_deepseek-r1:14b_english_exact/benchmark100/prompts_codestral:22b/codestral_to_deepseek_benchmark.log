---
- name: Enable Backports repository
  apt:
    name: "deb http://backports.debian.org/debian-backports stretch-backports main"
    state: present
  when: ansible_distribution_version is version and ansible_distribution_version < "9"

- name: Set the default_release option
  file:
    path: /etc/apt/apt.conf.d/50_debian_backports
    content: "APT::Default-Release \"stretch-backports\";"
    state: present
  when: ansible_distribution_version is version and ansible_distribution_version < "9"

- name: Install Ansible
  apt:
    name: ansible
    state: "{{ ansible_package_state | default('present') }}"
  when: ansible_distribution_version is version and ansible_distribution_version < "9"


