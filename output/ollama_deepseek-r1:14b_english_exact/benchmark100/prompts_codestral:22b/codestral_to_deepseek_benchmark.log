    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
    state: rename
    new_path: /usr/lib/python3.12/EXTERNALLY-MANAGED.old
  when: check_python3.12_file_exists is not None

- name: import_assert_yml
  include_tasks: assert.yml
  tags: ['assert']

- name: install_python_pip
  apt:
    name: python3-pip
    state: present

- name: configure_pip_proxy
  pip_config:
    proxy_url: "{{ python_pip_proxy }}"
  when: python_pip_proxy is defined

- name: set_pip_trusted_host
  pip_config:
    trusted_host: "{{ item }}"
  with_items: "{{ python_pip_trusted_host.split(',') | list }}"
  when: python_pip_trusted_host is defined

- name: update_pip
  pip:
    executable: "{{ python_pip_executable }}"
    command: upgrade
    use_sudo: yes
  when:
    - python_pip_update
    - ansible_distribution not in ['bookworm', 'noble']
    - ansible_alpine is false

- name: install_python_pip_modules
  pip:
    executable: "{{ python_pip_executable }}"
    name: "{{ item.name }}"
    version: "{{ item.version | default('') }}"
    state: "{{ item.state | default('present') }}"
  with_items: "{{ python_pip_modules }}"
  when:
    - ansible_distribution not in ['bookworm', 'noble']
    - ansible_alpine is false


