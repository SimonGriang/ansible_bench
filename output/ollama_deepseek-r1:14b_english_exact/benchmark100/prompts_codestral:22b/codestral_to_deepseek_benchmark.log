---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: /path/to/assert.yml
    host: localhost
    loop: no

- name: Install using package
  when:
    - hashicorp_installation_method | eq("package")
  become: true
  block:
    - name: Set up HashiCorp repository for RedHat/Rocky
      ansible.posix.yum_repository:
        name: hashicorp
        description: HashiCorp Repository
        baseurl: https://download.hashicorp.com/repos/hashicorp-el/8/x86_64/
        gpgcheck: yes
        state: present

    - name: Set up HashiCorp repository for Debian
      ansible.posix.apt_repository:
        repo: |
          deb [arch=$(dpkg --print-architecture)] https://download.hashicorp.com/repos/hashicorp-stable/debian bullseye main
        state: present

    - name: Install required packages
      ansible.builtin.package:
        name: "{{ packages | default([]) | list }}"
        state: present

    - name: Install HashiCorp products
      ansible.builtin.package:
        name: "{{ hashicorp_products | default([]) | list }}"
        state: present

- name: Install manually
  when:
    - hashicorp_installation_method | eq("manual")
  become: true
  ansible.system.unarchive:
    src: "{{ hashicorp_manual_install_source }}"
    dest: "{{ hashicorp_manual_install_destination }}"
    remote_src: true
    owner: "{{ hashicorp_manual_install_owner | default('root') }}"
    group: "{{ hashicorp_manual_install_group | default('root') }}"
    mode: "{{ hashicorp_manual_install_mode | default('0755') }}"


