---
- name: Import assert.yml
  include_tasks: assert.yml
  local: true

- name: Install php
  package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  shell: "{{ php_ini_command | default('php --ini 2>/dev/null') }}"
  register: php_found_ini_location
  changed_when: false
  when: php_ini_location is not defined

- name: Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
    mode: 0644
  notify: Restart httpd
  when: php_ini_location is defined or php_found_ini_location is defined


