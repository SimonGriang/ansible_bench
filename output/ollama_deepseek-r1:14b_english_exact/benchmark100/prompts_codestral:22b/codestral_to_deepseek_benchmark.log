---
- name: Create the RKE2 manifests directory
  file:
    path: "{{ rke2_data_path }}/server/manifests"
    state: directory
    owner: root
    group: root
    mode: 0700

- name: Copy kube-vip files to first server
  copy:
    src: "templates/kube-vip/{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    remote_src: yes
    owner: root
    group: root
    mode: 0664
  loop:
    - kube-vip.yml.j2
    - kube-vip-rbac.yml.j2
  when: (ansible_hostname == "first-server")

- name: Copy kube-vip load balancer manifests to first server
  copy:
    src: "templates/kube-vip/kube-vip-cloud-{{ item }}.yml.j2"
    dest: "{{ rke2_data_path }}/server/manifests/"
    remote_src: yes
    owner: root
    group: root
    mode: 0664
  loop:
    - loadbalancer
    - service
  when: (ansible_hostname == "first-server" and rke2_kubevip_cloud_provider_enable)


