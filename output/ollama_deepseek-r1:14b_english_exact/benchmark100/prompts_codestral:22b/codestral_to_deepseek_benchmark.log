      when: nodes_output.stdout is not empty

    - name: Remove old nodes
      shell: kubectl delete nodes --ignore-not-found {{ items }}
      when: nodes_output.stdout is not empty
      with_items: "{{ nodes_output.stdout.split() }}"

    - name: Set an Active Server
      shell: kubectl taint nodes --all node-role.kubernetes.io/master=role:ActiveServer:NoExecute
      when: rke2_etcd_restore_from is not defined


