- name: Prepare summary
  ansible.builtin.command:
    cmd: /usr/local/bin/kubectl get nodes -owide
  changed_when: false
  register: nodes_summary
  retries: 5
  delay: 0
  when: host == rke2_servers_group_name | first

- name: K8s nodes state
  ansible.builtin.debug:
    msg: "{{ nodes_summary.stdout }}"


