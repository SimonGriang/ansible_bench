---
- name: Cordon and Drain the node
  ansible.posix.shell:
    cmd: kubectl drain --ignore-daemonsets --dry-run=none {{ node_name }}
  when: rke2_drain_node_during_upgrade
  changed_when: false
  register: cordon_result
  ignore_errors: yes

- name: Cordon and Drain the node
  ansible.posix.shell:
    cmd: kubectl drain --ignore-daemonsets --dry-run=none {{ node_name }}
  when: rke2_drain_node_during_upgrade
  changed_when: false
  register: cordon_result
  ignore_errors: yes

- name: Restart RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted

- name: Wait for all nodes to be ready again
  ansible.posix.shell:
    cmd: kubectl get nodes -o=jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status} {end}' | tr -s ' ' | grep -c 'True'
  when: rke2_drain_node_during_upgrade
  register: ready_nodes
  until: ready_nodes.stdout|int == total_nodes
  retries: 60
  delay: 10
  changed_when: false

- name: Uncordon the node
  ansible.posix.shell:
    cmd: kubectl uncordon {{ node_name }}
  when: rke2_drain_node_during_upgrade
  changed_when: false

- name: Wait for all pods to be ready again
  ansible.posix.shell:
    cmd: kubectl get pods -o=jsonpath='{range .items[*]}{.status.phase} {end}' | tr -s ' ' | grep -c -v 'Running|Succeeded'
  when: rke2_wait_for_all_pods_to_be_ready
  register: pods_not_ready
  until: pods_not_ready.stdout|int == 0
  retries: 60
  delay: 10
  changed_when: false

- name: Wait for all pods to pass readiness checks
  kubectl:
    command: wait
    args: "{{ rke2_wait_for_all_pods_to_be_healthy_args | join(' ')" }}
  when: rke2_wait_for_all_pods_to_be_healthy


