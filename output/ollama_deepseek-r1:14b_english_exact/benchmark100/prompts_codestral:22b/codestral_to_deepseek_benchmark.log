---
- name: MySQL Installation and Configuration
  hosts: all
  tasks:
    - name: Task 1: Import assert.yml
      import_tasks: assert.yml
      remote_src: true
      no_cache: yes

    - name: Task 2: Install mysql
      apt:
        name: "{{ mysql_packages }}"
        state: present
      notify:
        - Set root password
        - Systemctl daemon-reexec

    - name: Task 3: Configure mysql server
      template:
        src: mysql-server.cnf.j2
        dest: "{{ mysql_configuration_destination }}/mysql-server.cnf"
      notify: Restart mysql server

    - name: Task 4: Configure mysql client
      template:
        src: mysql-client.cnf.j2
        dest: "{{ mysql_configuration_destination }}/mysql-client.cnf"
      vars:
        socket: "{{ mysql_socket }}"

    - name: Task 5: Initialize mysql
      shell: "{{ mysql_initialize_command }}"
      become: yes
      become_user: root
      when: ansible_distribution in ['Alpine', 'Archlinux']

    - name: Task 6: Start and enable mysql
      systemctl:
        name: "{{ mysql_service }}"
        state: started
        enabled: yes

    - name: Task 7: Flush handlers
      meta: flush_handlers

    - name: Task 8: Place my.cnf
      template:
        src: my.cnf.j2
        dest: /etc/my.cnf
        mode: 0640

    - name: Task 9: Create databases
      mysql_db:
        name: "{{ item.name }}"
        state: present
        login_user: root
        login_password: "{{ mysql_root_password }}"
        login_socket: "{{ mysql_socket }}"
      with_items: "{{ mysql_databases }}"
      when: mysql_databases is defined

    - name: Task 10: Create users
      mysql_user:
        name: "{{ item.name }}"
        password: "{{ item.password }}"
        priv: "{{ item.privileges }}"
        login_user: root
        login_password: "{{ mysql_root_password }}"
        login_socket: "{{ mysql_socket }}"
      with_items: "{{ mysql_users }}"
      when: mysql_users is defined

    - name: Task 11: Flush handlers again
      meta: flush_handlers

