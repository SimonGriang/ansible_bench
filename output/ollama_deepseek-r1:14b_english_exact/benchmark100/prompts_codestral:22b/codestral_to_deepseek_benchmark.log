---
- name: Enable modules
  block:
    - name: Enable proxy module
      apt:
        name: proxy
        state: present
        enable: true
      when: ansible_distribution in ['debian', 'ubuntu']
    - name: Enable proxy_http module
      apt:
        name: proxy_http
        state: present
        enable: true
      when: ansible_distribution in ['debian', 'ubuntu']
    - name: Enable proxy module on Suse
      shell: a2mavctl --enable proxy
      when: ansible_distribution == 'suse'
    - name: Enable proxy_http module on Suse
      shell: a2mavctl --enable proxy_http
      when: ansible_distribution == 'suse'
  notify: Reload Apache

- name: Configure locations
  template:
    src: httpd_locations.conf.j2
    dest: "{{ httpd_config_directory }}/httpd_locations.conf"
    owner: www-data
    group: www-data
    mode: 0644
  notify: 
    - Test httpd configuration validity
    - Restart httpd


