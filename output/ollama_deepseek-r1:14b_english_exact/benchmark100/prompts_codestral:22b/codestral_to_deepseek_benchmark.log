---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints | default('') }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  copy:
    remote_src: yes
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    mode: 0600
  notify: Config file changed

- name: Copy kubelet config
  copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    mode: 0600
  when: rke2_kubelet_config is not empty
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  copy:
    remote_src: yes
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    mode: 0600
  when: rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty
  notify: Config file changed

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is not empty and (rke2_service not in ('running', 'enabled')) }}"

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file is not empty and rke2_etcd_snapshot_s3_options is defined and ('access_key' in rke2_etcd_snapshot_s3_options or 'access_key_id' in rke2_etcd_snapshot_s3_options) and ('secret_key' in rke2_etcd_snapshot_s3_options or 'secret_access_key' in rke2_etcd_snapshot_s3_options) and 'bucket' in rke2_etcd_snapshot_s3_options and 'snapshot_name' in rke2_etcd_snapshot_s3_options }}"

- name: Restore etcd from file
  block:
    - name: Create etcd snapshot directory
      file:
        path: /var/lib/rke2/etcd/snapshot
        state: directory
        owner: root

    - name: Copy etcd snapshot file
      copy:
        remote_src: yes
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rke2/etcd/snapshot/etcd-snapshot

    - name: Restore etcd from file
      shell: rke2 server --config /etc/rancher/rke2/config.yaml ---etcd-restore=true --etcd-restore-file=/var/lib/rke2/etcd/snapshot/etcd-snapshot
      register: etcd_restore_output
      changed_when: "{{ etcd_restore_output.stdout is not empty }}"

  when: do_etcd_restore

- name: Restore etcd from s3
  block:
    - name: Restore etcd from s3
      shell: rke2 server --config /etc/rancher/rke2/config.yaml --etcd-restore=true --etcd-restore-s3-bucket="{{ rke2_etcd_snapshot_s3_options.bucket }}" --etcd-restore-s3-access-key="{{ rke2_etcd_snapshot_s3_options.access_key|default(rke2_etcd_snapshot_s3_options.access_key_id)|default('') }}" --etcd-restore-s3-secret-key="{{ rke2_etcd_snapshot_s3_options.secret_key|default(rke2_etcd_snapshot_s3_options.secret_access_key)|default('') }}" --etcd-restore-s3-prefix="{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
      register: etcd_restore_s3_output
      changed_when: "{{ etcd_restore_s3_output.stdout is not empty }}"

  when: do_etcd_restore_from_s3

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: yes
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: masked

- name: Wait for the first server to be ready - no CNI
  wait_for_task:
    task: kubectl get nodes -o jsonpath='{range .items[0]}{.status.conditions[?(@.type=="Ready")].status}'
    state: True
    until: 60
    delay: 5
  when: rke2_cni == 'none'

- name: Wait for the first server to be ready - with CNI
  wait_for_task:
    task: kubectl get nodes -o jsonpath='{range .items[0]}{.status.conditions[?(@.type=="Ready")].status}'
    state: True
    until: 60
    delay: 5
  when: rke2_cni is not 'none'

- name: Restore etcd
  block:
    - name: Get the registered nodes
      shell: kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name} {end}'
      register: nodes_output
      changed_when: false

    - name: Remove old node-password secrets
      shell: kubectl delete secret -n kube-system node-password --ignore-not-found
      when: nodes_output.stdout is not empty

    - name: Remove old nodes
      shell: kubectl delete nodes --ignore-not-found {{ items }}
      when: nodes_output.stdout is not empty
      with_items: "{{ nodes_output.stdout.split() }}"

    - name: Set an Active Server
      shell: kubectl taint nodes --all node-role.kubernetes.io/master=role:ActiveServer:NoExecute
      when: rke2_etcd_restore_from is not defined


