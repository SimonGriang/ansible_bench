---
- name: Create a directory for each virtual host document root
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - (create_docroot is not defined or create_docroot | bool)
  loop: "{{ httpd_vhosts | list if httpd_vhosts is defined else [] }}"
  register: created_directories

- name: Configure vhosts
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ item.conf_name | default('httpd_vhosts_directory') }}/{{ item.name }}.conf"
    mode: 0644
  when:
    - httpd_vhosts is defined
    - item.name is defined
  loop: "{{ httpd_vhosts | list if httpd_vhosts is defined else [] }}"
  notify: 
    - test_httpd_config
    - restart_httpd


