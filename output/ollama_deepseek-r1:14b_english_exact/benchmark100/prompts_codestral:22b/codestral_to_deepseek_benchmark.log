---
- name: Check if Java certificates exist
  stat:
    path: "{{ java_certs | map('regex', '^(/.*)') | join(',') }}"
    check_all: yes
  register: java_certs_stat
  changed_when: false

- name: Fail if Java certificate doesn't exist
  fail:
    msg: "Java certificate {{ item.key }} does not exist at {{ item.value.path }}"
  with_items: "{{ java_certs_stat.results | dict_result }} | rejectattr('stat结果', '不存在') | map('key') | list }}"
  changed_when: false

- name: Set keystore variables for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir | default('java_keystore_dir_old') }}"
  when: ansible.java_version is version < 11

- name: Set keystore variables for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir | default('java_keystore_dir_new') }}"
  when: ansible.java_version is version >= 11

- name: Import SSL certificates
  java_cert:
    path: "{{ item.path }}"
    alias: "{{ item.alias }}"
    keystore_path: "{{ java_keystore_dir }}"
    keystore_password: "{{ java_keystore_password }}"
    state: present
  loop: "{{ java_certs | map('dict', {'path': value, 'alias': key}) | list }}"
  create_keystore: yes


