---
- name: Task 1: Import assert.yml
  include_tasks: assert.yml
  remote_host: localhost

- name: Task 2: Install vsftpd
  apt:
    name: vsftpd
    state: installed

- name: Task 3: Configure vsftpd
  template:
    src: vsftpd.conf.j2
    dest: /etc/vsftpd.conf
    owner: root
    group: root
    mode: "{{ vsftpd_configuration_file_mode }}"
  notify: "Restart vsftpd"

- name: Task 4: Start and enable vsftpd
  service:
    name: vsftpd
    state: started
    enabled: yes


