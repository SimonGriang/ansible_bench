---
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_system == "systemd"
    msg: "This module only works with systemd"

- name: Get the latest release version of Promtail from GitHub
  delegate_to: localhost
  github_release_info:
    user: "{{ GH_USER }}"
    token: "{{ GH_TOKEN }}"
    repo: "promtail"
    version: "latest"
  run_once: true

- name: Check if the local Promtail binary archive exists
  delegate_to: localhost
  file:
    path: "{{ promtail_binary_local_dir }}/promtail-linux-{{ go_arch }}"
    state: file
  register: binary_exists
  ignore_errors: yes

- name: Get the checksum for the Promtail binary
  delegate_to: localhost
  uri:
    url: "https://api.github.com/repos/promtail/releases"
    method: GET
  register: checksum_info
  run_once: true


