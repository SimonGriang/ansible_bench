---
- name: Create ssl key
  openssl_privatekey:
    path: /etc/ssl/private/key.pem
    mode: '0640'
    user: 'ssluser'
    group: 'sslgroup'
    algorithm: 'rsa'
    key_size: 4096

- name: Create ssl csr
  openssl_csr:
    path: /etc/ssl/csr/csr.pem
    mode: '0640'
    user: 'ssluser'
    group: 'sslgroup'
    privatekey_path: /etc/ssl/private/key.pem
    subject:
      commonName: "localhost"
      organization: "My Organization"
      organizational_unit: "IT"
      city: "City"
      state: "State"
      country: "US"

- name: Create ssl certificates
  x509_certificate:
    path: /etc/ssl/certs/cert.pem
    mode: '0640'
    user: 'ssluser'
    group: 'sslgroup'
    privatekey_path: /etc/ssl/private/key.pem
    csr_path: /etc/ssl/csr/csr.pem
    validity: 365
    self_signed: yes

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: /etc/ssl/pkcs12/cert.p12
    mode: '0640'
    user: 'ssluser'
    group: 'sslgroup'
    privatekey_path: /etc/ssl/private/key.pem
    certificate_path: /etc/ssl/certs/cert.pem
    password: 'changeit'

- name: Read private key
  slurp:
    src: /etc/ssl/private/key.pem
    register: private_key_content

- name: Read certificate
  slurp:
    src: /etc/ssl/certs/cert.pem
    register: certificate_content

- name: Create combined private_key and certificate file
  template:
    src: combined.pem.j2
    dest: /etc/ssl/combined/combined.pem
    mode: '0640'
    user: 'ssluser'
    group: 'sslgroup'
  vars:
    private_key_content: "{{ private_key_content }}"
    certificate_content: "{{ certificate_content }}"


