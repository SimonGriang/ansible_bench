---
- name: Create directories
  file:
    path: /var/lib/cadvisor
    state: directory
    owner: cAdvisor
    group: cAdvisor
    mode: 755

- name: Download cadvisor binary
  get_url:
    url: https://github.com/google/cadvisor/releases/download/v1.0.0/cadvisor-v1.0.0-linux-amd64.tar.gz
    dest: /var/lib/cadvisor/cadvisor
    checksum: sha256:abc123
  file:
    path: /var/lib/cadvisor/cadvisor
    owner: root
    group: root
    mode: 755

- name: Propagate locally distributed cadvisor binary
  copy:
    src: /usr/local/bin/cadvisor
    dest: /var/lib/cadvisor/cadvisor
    remote_src: yes
  file:
    path: /var/lib/cadvisor/cadvisor
    owner: root
    group: root
    mode: 755
  systemd:
    name: cadvisor
    state: restarted

- name: Create a symlink
  ln:
    src: /var/lib/cadvisor/cadvisor
    dest: /usr/local/bin/cadvisor
    state: symlink

- name: Configure cadvisor systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    owner: root
    group: root
    mode: 644
  systemd:
    name: cadvisor
    state: reloaded

- name: Check cadvisor service status
  shell: systemctl status cadvisor

- name: Enable cadvisor systemd service
  systemd:
    name: cadvisor
    state: enabled

- name: Start cadvisor systemd service
  systemd:
    name: cadvisor
    state: started
    reload: yes


