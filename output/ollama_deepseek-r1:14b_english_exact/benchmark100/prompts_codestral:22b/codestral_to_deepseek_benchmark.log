---
- name: Import assert.yml
  import_tasks: assert.yml
  host_pattern: localhost
  when:
    - users_requirements_defined

- name: Install required software
  apt:
    name: "{{ users_requirements | default([]) | list }}"
    state: present
  when:
    - users_requirements_defined

- name: Loop over users_groups
  loop: "{{ users_groups | default([]) | list }}"
  include_tasks: group.yml
  when:
    - users_groups_defined

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "@includedir {{ users_sudo_includedir | default('') | regex_replace('.*/','') }}"
    regex: '^#[ ]*@includedir[ ]'
    validate: visudo
  when:
    - users_sudo_includedir_defined

- name: Loop over users
  loop: "{{ users | default([]) | list }}"
  include_tasks: user.yml
  when:
    - users_defined

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0644
  when:
    - users_cron_allow_defined

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when:
    - not users_cron_allow_defined

users_requirements_defined: "{{ ansible.utils.conditional | isDEFINED('users_requirements') }}"
users_groups_defined: "{{ ansible.utils.conditional | isDEFINED('users_groups') }}"
users_sudo_includedir_defined: "{{ ansible.utils.conditional | isDEFINED('users_sudo_includedir') }}"
users_defined: "{{ ansible.utils.conditional | isDEFINED('users') }}"
users_cron_allow_defined: "{{ ansible.utils.conditional | isDEFINED('users_cron_allow') }}"

