---
- name: Install Keepalived
  include_tasks: keepalived.yml
  when:
    - ha_mode_enabled
    - host_in_rke2_servers_group
    - ha_mode == 'keepalived'

- name: Install RKE2
  include_tasks: rke2-install.yml
  vars:
    rke2_version: "{{ rke2_version }}"

- name: Apply CIS Hardening
  include_tasks: cis.yml
  when:
    - cis_profile_defined

- name: Identify Active Server
  include_tasks: find_active_server.yml

- name: Enable IPVS Kernel Module
  include_tasks: ipvs-enable.yml
  when:
    - ipvs_load_balancing_enabled
    - host_in_rke2_servers_group
    - ha_mode == 'kubevip'
    - ha_mode != 'keepalived'

- name: Copy Kube-vip Manifests
  include_tasks: kubevip.yml
  when:
    - host_is_first_server
    - ha_mode == 'kubevip'
    - ha_mode != 'keepalived'

- name: Copy Ingress-nginx Manifests
  include_tasks: ingress-nginx.yml
  when:
    - host_is_first_server
    - ingress_nginx_values_defined

- name: Prepare First Server Node
  include_tasks: first_server_prepare.yml
  when:
    - host_is_first_server
    - (active_server_not_defined or active_server_count == 1)

- name: Restore etcd
  include_tasks: etcd-restore.yml
  when:
    - active_server_defined
    - (host_is_active_server or host_is_first_server)
    - etcd_restore_needed

- name: Download kubeconfig
  include_tasks: download-kubeconfig.yml
  when:
    - kubeconfig_download_enabled
    - host_is_first_server

- name: Prepare and Join Remaining Nodes
  include_tasks: join-nodes.yml
  when:
    - active_server_defined
    - cluster_server_count >= 2

- name: Rolling Restart Servers
  include_tasks: rolling_restart.yml
  when:
    - rke2_server_version_update_needed

- name: Rolling Restart Agents
  include_tasks: rolling_restart.yml
  when:
    - rke2_agent_version_update_needed
    - not host_in_rke2_servers_group

- name: Flush Handlers
  shell: /usr/bin/flush_handlers

- name: Rolling Restart Config Change
  include_tasks: change-config.yml
  when:
    - config_change_restart_needed

- name: Final Steps
  include_tasks: final_steps.yml


