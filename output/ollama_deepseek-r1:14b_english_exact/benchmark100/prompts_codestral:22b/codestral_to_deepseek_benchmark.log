---
- name: Migrate Java JDK vendor from 'adoptopenjdk' to 'temurin' if selected
  set_fact:
    java_jdk_vendor: temurin
  when: ansible_distribution in ['Debian', 'Ubuntu']

- name: Gather OS-specific variables for Java
  include_vars:
    file: "{{ java_distribution }}.yml"

- name: Gather architecture-specific variables for Java
  include_vars:
    file: architecture.yml

- name: Set OS-specific variables for Java (I)
  set_fact:
    java_version: "{{ java_version }}"
    java_major_version: "{{ java_major_version }}"
    java_update_version: "{{ java_update_version }}"

- name: Set OS and architecture-specific variables for Java (II)
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

- name: Handle Debian pre-requisites for Java
  block:
    - name: Remove deprecated Java repositories
      apt_key:
        name: "{{ item }}"
        state: absent
      with_items: "{{ java_deprecated_repos }}"
    - name: Install extra apt tools
      apt:
        name: "{{ java_extra_tools }}"
        state: present
        update_cache: yes
    - name: Add required key repositories
      apt_key:
        keyserver: keyserver.ubuntu.com
        key: "{{ item }}"
        state: present
      with_items: "{{ java_key_repos }}"
    - name: Add required repositories
      apt_repository:
        repo: "{{ item }}"
        state: present
        update_cache: yes
      with_items: "{{ java_repos }}"

- name: Handle RedHat pre-requisites for Java
  block:
    - name: Add required key repositories
      rpm_key:
        key: "{{ item }}"
        state: present
      with_items: "{{ java_key_repos }}"
    - name: Add required repositories
      yum_repository:
        name: "{{ item }}"
        state: present
      with_items: "{{ java_repos }}"

- name: Install required libraries for Java
  apt:
    name: "{{ item }}"
    state: present
  with_items: "{{ java_required_libs }}"

- name: Install Java on Debian
  apt:
    name: "{{ java_open_jdk }}"
    state: present
    version: "{{ java_version }}"
    update_cache: yes
  when: ansible_distribution == 'Debian' or ansible_distribution == 'Ubuntu'

- name: Install Java on RedHat
  yum:
    name: "{{ java_open_jdk }}"
    state: present
    version: "{{ java_version }}"
  when: ansible_distribution in ['CentOS', 'RedHat']

- name: Export environment variables for Java
  template:
    src: jdk.sh.j2
    dest: /etc/profile.d/jdk.sh

- name: Source environment variables for Java
  shell: source /etc/profile.d/jdk.sh

- name: Correct Java version selected for Java < 11
  alternatives:
    name: java
    state: present
    path: "/usr/lib/jvm/{{ java_jdk }}/bin/java"
    priority: 1
  when: java_major_version < 11

- name: Correct Java version selected for Java >= 11
  alternatives:
    name: java
    state: present
    path: "/usr/lib/jvm/{{ java_jdk }}/bin/java"
    priority: 1
  when: java_major_version >= 11


