---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
  when: airgap_mode | bool | not

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local_src }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: 0755
  when:
    - airgap_mode | bool
    - airgap_implementation == "copy"

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0755
  when:
    - airgap_mode | bool
    - airgap_implementation != "exists"

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download checksum and artifacts
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_artifacts_dest }}/checksum.txt"
        mode: 0644
      ignore_errors: yes
      register: checksum_download

    - name: Download install script
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_dest }}"
        mode: 0755
      when: checksum_download | is_hash("failed")

    - name: Compare checksums
      shell: |
        echo "$(cat {{ rke2_artifacts_dest }}/checksum.txt)" |
        awk '{print $1}' | cmp -l {{ rke2_artifacts_dest }}/*.{tgz,bz2}
      when: checksum_download | is_hash("success")
  when:
    - airgap_mode | bool
    - airgap_implementation == "download"

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local_src }}/*"
    dest: "{{ rke2_artifacts_dest }}"
    mode: 0644
  when:
    - airgap_mode | bool
    - airgap_implementation == "copy"

- name: Copy additional images tarballs
  block:
    - name: Create directory for additional images
      file:
        path: "{{ additional_images_dest }}"
        state: directory
        mode: 0755
      when: additional_images_src is directory

    - name: Copy additional images
      copy:
        src: "{{ additional_images_src }}"
        dest: "{{ additional_images_dest }}"
        mode: 0644
      when:
        - additional_images_src is directory
        - airgap_implementation != "exists"
  when:
    - airgap_mode | bool
    - additional_images_src is directory
    - airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure artifacts directory exists
      file:
        path: "{{ rke2_artifacts_dest }}"
        state: directory
        mode: 0755

    - name: Set artifacts permissions
      file:
        path: "{{ rke2_artifacts_dest }}/*"
        state: file
        mode: 0644

    - name: Check install script permissions
      stat:
        path: "{{ rke2_install_script_dest }}"
      register: install_script_stat

    - name: Make install script executable
      file:
        path: "{{ rke2_install_script_dest }}"
        state: file
        mode: 0755
      when: (install_script_stat.stat.mode|int) % 1000 != 001

    - name: Fail if install script does not exist or not executable
      fail:
        msg: "RKE2 install script does not exist or is not executable"
      when: not install_script_stat or (install_script_stat.stat.mode|int % 1000 != 001)
  when:
    - airgap_mode | bool
    - airgap_implementation == "exists"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_path }}"

- name: Check RKE2 version
  block:
    - name: Get RKE2 version
      command: "{{ rke2_bin_path }} --version"
      when: rke2_bin_path is defined and exists
      register: rke2_version_cmd
      ignore_errors: yes

    - name: Set installed version fact
      set_fact:
        rke2_installed_version: "{{ rke2_version_cmd.stdout | regex_replace('.*v?([^ ]+).*', '\\1') | default('not installed') }}"

    - name: Get running version from service
      command: systemctl show -p MainPID {{ rke2_service_name }}
      when: rke2_service_name is defined
      ignore_errors: yes
      register: rke2_service_status

    - name: Set running version fact
      set_fact:
        rke2_running_version: "{{ rke2_version_cmd.stdout | regex_replace('.*v?([^ ]+).*', '\\1') | default('not installed') }}"
      when: rke2_service_status.rc == 0
  when: airgap_mode | bool

- name: Prevent accidental RKE2 downgrade
  fail:
    msg: "RKE2 downgrade detected: desired version {{ rke2_version }} is less than running version {{ rke2_running_version }} and downgrades are not allowed"
  when:
    - rke2_version is defined
    - rke2_running_version is defined
    - rke2_version < rke2_running_version
    - not rke2_downgrades_allowed

- name: Run RKE2 install script
  command: "{{ rke2_install_script_dest }} {{ rke2_install_args }}"
  when:
    - (rke2_installed_version == 'not installed' or rke2_installed_version != rke2_version)
    - not airgap_mode | bool
    - (airgap_mode | bool and airgap_implementation in ["download", "copy"])

- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_manifests_src }}/"
    dest: "{{ rke2_manifests_dest }}/"
    mode: 0644
    remote_src: yes
  when: rke2_manifests_src is directory

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_src }}/"
    dest: "{{ rke2_static_pods_dest }}/"
    mode: 0644
    remote_src: yes
  when: rke2_static_pods_src is directory

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file_src }}"
    dest: "{{ rke2_env_file_dest }}"
    mode: 0644
  when: rke2_env_file_src is file


