               --etcd-restore-s3-access-key="{{ rke2_etcd_snapshot_s3_options.access_key|default(rke2_etcd_snapshot_s3_options.access_key_id)|default('') }}"
               --etcd-restore-s3-secret-key="{{ rke2_etcd_snapshot_s3_options.secret_key|default(rke2_etcd_snapshot_s3_options.secret_access_key)|default('') }}"
