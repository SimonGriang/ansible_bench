---
- name: Import assert.yml
  import_tasks: assert.yml
  host_pattern: localhost

- name: Install required software
  apt:
    name: "{{ users_requirements | default([]) | list }}"
    state: present
  when: ansible.utils.conditional | isDEFINED('users_requirements')

- name: Loop over users_groups
  loop: "{{ users_groups | default([]) | list }}"
  include_tasks: group.yml
  when: ansible.utils.conditional | isDEFINED('users_groups')

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "@includedir {{ users_sudo_includedir | default('') | regex_replace('.*/','') }}"
    regex: '^#[ ]*@includedir[ ]'
    validate: visudo
  when: ansible.utils.conditional | isDEFINED('users_sudo_includedir')

- name: Loop over users
  loop: "{{ users | default([]) | list }}"
  include_tasks: user.yml
  when: ansible.utils.conditional | isDEFINED('users')

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0644
  when: users_cron_allow | default(False)

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow | default(False)


