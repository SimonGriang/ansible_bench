---
- name: Assert Variables
  include_tasks: assert.yml
  register: assert_result
  remote_host: localhost

- name: Wait for Host
  wait_for_host:
    state: started
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  when:
    - not (ansible_connection == 'docker' or ansible_connection == 'container')
    - bootstrap_wait_for_host

- name: Prepare System
  block:
    - name: Test connection
      ping:
        remote_host: "{{ inventory_hostname }}"
      ignore_errors: yes
      register: connection_test

    - name: Debug connection failure
      debug:
        msg: "Could not connect to host"
      when: connection_test.failed

    - name: Gather bootstrap facts
      gather_facts:
        facts_file: "bootstrap_facts.json"

    - name: Install bootstrap packages
      raw: "{{ bootstrap_package_install_cmd }}"
      register: bootstrap_packages_installed
      changed_when: bootstrap_packages_installed.stdout != ''
  delegate_to: localhost
  become: "{{ bootstrap_become }}"
  become_user: "{{ bootstrap_become_user }}"

- name: Ensure System Prepared
  block:
    - name: Gather Ansible facts
      gather_facts:

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_packages }}"
        state: present
      register: package_install_result
