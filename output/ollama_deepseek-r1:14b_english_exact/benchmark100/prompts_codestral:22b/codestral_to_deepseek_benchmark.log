---
- name: Import tasks from another file
  import_tasks: another_file.yml
  remote_host: localhost
  ignore_errors: yes

- name: Ensure system is up to date
  become: yes
  apt:
    update_cache: yes

- name: Install necessary packages
  become: yes
  apt:
    name: "{{ packages }}"
    state: present

- name: Create configuration directory
  file:
    path: /etc/myapp
    state: directory
    mode: 755

- name: Configure application settings
  template:
    src: myapp.conf.j2
    dest: /etc/myapp/myapp.conf
    mode: 644

- name: Start application service
  service:
    name: myapp
    state: started
    enabled: yes


