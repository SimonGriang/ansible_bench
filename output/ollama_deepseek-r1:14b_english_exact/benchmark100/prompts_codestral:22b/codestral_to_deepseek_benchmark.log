---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install requirements
  apt:
    name: bash
    state: present

- name: Install openjdk java
  apt:
    name: "{{ java_openjdk_package }}"
    state: present
  environment:
    USE: "X -cups -alsa -fontconfig"

- name: Install RPM
  when: java_source == "local" and java_format == "rpm"
  become: true
  become_flags: gpasswd
  copy:
    remote_src: true
    src: "{{ java_rpm }}"
    dest: /tmp/
  rpm:
    name: "/tmp/{{ java_rpm | basename }}"
    state: installed

- name: Install DEB
  when: java_source == "local" and java_format == "deb"
  become: true
  become_flags: gpasswd
  copy:
    remote_src: true
    src: "{{ java_deb }}"
    dest: /tmp/
  apt:
    name: "/tmp/{{ java_deb | basename }}"
    state: present

- name: Install oracle java (rpm)
  when: java_source == "repository" and java_format == "rpm"
  apt:
    name: "{{ java_oracle_package }}"
    state: present

- name: Configure oracle targz
  when: java_format == "targz"
  file:
    path: "{{ java_install_directory }}"
    state: directory
    mode: 0755
  unarchive:
    src: "{{ java_oracle_package }}"
    dest: "{{ java_install_directory }}"
    remote_src: true

- name: Install oracle java policy software (targz)
  when: java_jce and java_version == 8 and java_vendor == "oracle"
  copy:
    remote_src: true
    src: "{{ jce_policy }}"
    dest: "{{ java_install_directory }}"
  shell: "unzip jce_policy-8.zip"
  args:
    chdir: "{{ java_install_directory }}"

- name: Set alternative (targz)
  when: java_format == "targz" and not is_alpine and java_vendor == "oracle"
  alternatives:
    name: java
    path: "{{ java_install_directory }}/bin/java"
    state: present
    icon_file: "{{ java_install_directory }}/bin/java"
  shell: "update-alternatives --install {{ java_install_directory }}/bin/java java {{ java_install_directory }}/bin/java"

- name: Find JAVA_HOME
  shell: "readlink -f /usr/bin/java | sed 's#/bin/java$##'"
  register: java_home
  changed_when: false

- name: Set JAVA_HOME in /etc/environment
  when: not java_version == 8
  file:
    path: /etc/profile.d/java_home.sh
    state: touch
    content: |
      export JAVA_HOME={{ java_home.stdout }}



