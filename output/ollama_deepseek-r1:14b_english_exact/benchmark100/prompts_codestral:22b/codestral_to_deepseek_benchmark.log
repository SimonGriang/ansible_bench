---
- import_tasks: assert.yml

- name: Install git
  ansible.builtinapt:
    name: "{{ git_packages }}"
    state: present

- name: Check if user exists
  ansible.builtinuser:
    name: "{{ git_username }}"
    state: info
  register: user_exists

- name: Create user's home directory
  ansible.builtinfile:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_user_group }}"
    mode: 0755
  when: user_exists.changed

- name: Configure git
  ansible.builtintemplate:
    src: "{{ git_config_template }}"
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_user_group }}"
    mode: 0644
  when: 
    - git_username is defined
    - git_user_email is defined
    - git_user_name is defined
    - git_config_template is defined
    - user_exists.changed

- name: Create repository destination
  ansible.builtinfile:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_user_group }}"
    mode: 0755
  when: 
    - git_username is defined
    - git_repository_destination is defined
    - user_exists.changed

- name: Clone repositories
  ansible.builtingit:
    repo: "{{ item.repository }}"
    dest: "{{ git_repository_destination }}"
    clone: yes
    update: yes
    remote: origin
    branch: "{{ item.branch | default('main') }}"
    user: "{{ git_username }}"
    group: "{{ git_user_group }}"
    mode: 0755
  loop: "{{ git_repositories }}"
  when: 
    - git_username is defined
    - git_repository_destination is defined
    - user_exists.changed


