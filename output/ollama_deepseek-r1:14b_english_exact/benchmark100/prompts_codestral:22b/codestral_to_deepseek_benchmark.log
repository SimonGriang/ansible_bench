---
- name: Create etcd group
  group:
    name: etcd
    state: present
    system: true

- name: Create etcd user
  user:
    name: etcd
    shell: /bin/nologin
    group: etcd
    comment: etcd user
    state: present

- name: Check if /usr/local/share/rke2/rke2-cis-sysctl.conf is present and writable
  file:
    path: /usr/local/share/rke2/rke2-cis-sysctl.conf
    state: file
    mode: 0644
  register: file_info

- name: Copy the correct sysctl configuration file
  copy:
    remote_src: yes
    src: "{{ 'rke2-cis-sysctl.conf' if (file_info.stat.exists and file_info.stat.perm_mode == '0644') else '/usr/local/share/rke2/rke2-cis-sysctl.conf' }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: 0600
  notify: Restart systemd-sysctl

- name: Flush handlers
  meta: flush_handlers


