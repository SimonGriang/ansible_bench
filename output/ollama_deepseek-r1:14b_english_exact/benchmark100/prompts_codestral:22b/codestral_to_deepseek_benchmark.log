---
- import_tasks: assert.yml

- name: Install git
  ansible.builtin.apt:
    name: "{{ git_packages }}"
    state: present

- name: Check if user exists
  ansible.builtin.user:
    name: "{{ git_username }}"
    state: info
  register: user_exists

- name: Create user's home directory
  ansible.builtin.file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_user_group }}"
    mode: 0755
  when: user_exists.changed

- name: Configure git
  ansible.builtin.template:
    src: "{{ git_config_template }}"
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_user_group }}"
    mode: 0644
  when:
    - ansible.utils.is_defined(git_username)
    - ansible.utils.is_defined(git_user_email)
    - ansible.utils.is_defined(git_user_name)
    - ansible.utils.is_defined(git_config_template)
    - user_exists.changed

- name: Create repository destination
  ansible.builtin.file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_user_group }}"
    mode: 0755
  when:
    - ansible.utils.is_defined(git_username)
    - ansible.utils.is_defined(git_repository_destination)
    - user_exists.changed

- name: Clone repositories
  ansible.builtin.git:
    repo: "{{ item.repository }}"
    dest: "{{ git_repository_destination }}"
    clone: yes
    update: yes
    remote: origin
    branch: "{{ item.branch | default('main') }}"
    user: "{{ git_username }}"
    group: "{{ git_user_group }}"
    mode: 0755
  loop: "{{ git_repositories }}"
  when:
    - git_username is defined
    - git_repository_destination is defined
    - user_exists.changed

