---
- name: Import assert.yml
  import_tasks: ../../assert.yml
  vars:
    ansible_run_once: true

- name: Install nginx
  apt:
    name: nginx
    state: present

- name: Place nginx.conf
  template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
  notify: restart_nginx
  register: nginx_conf_result
  changed_when: false

- name: Ensure /etc/nginx/conf.d exists
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: 0755

- name: Place default.conf
  template:
    src: default.conf.j2
    dest: /etc/nginx/sites-available/default.conf
  notify: restart_nginx
  register: default_conf_result
  changed_when: false

- name: Start and enable nginx
  service:
    name: nginx
    state: started
    enabled: yes


