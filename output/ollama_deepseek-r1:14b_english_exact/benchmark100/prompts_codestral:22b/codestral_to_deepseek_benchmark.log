iltin.debug:\n    msg: "Python3 executable path: {{ python3_executable.stdout }}"\n\n- name: Import assert.yml\n  ansible.builtin.import_tasks: assert.yml\n  run_once: true\n  delegate_to: localhost\n\n- name: Install requirements\n  ansible.builtin.package:\n    name: "{{ openssl_requirements }}"\n    state: present\n\n- name: Ensure packaging is available via dnf\n  ansible.builtin.package:\n    name: python3-packaging\n    state: present\n\n- name: Install pip packages\n  ansible.builtin.pip:\n    name: "{{ item }}"\n    state: present\n    virtualenv: "{{ openssl_virtualenv | default(\'\') }}"\n  loop: "{{ openssl_pip_packages }}"\n\n- name: Create key directory\n  ansible.builtin.file:\n    path: "{{ openssl_key_directory }}"\n    state: directory\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n    mode: \'750\'\n\n- name: Create csr directory\n  ansible.builtin.file:\n    path: "{{ openssl_csr_directory }}"\n    state: directory\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n    mode: \'755\'\n\n- name: Create crt directory\n  ansible.builtin.file:\n    path: "{{ openssl_crt_directory }}"\n    state: directory\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n    mode: \'755\'\n\n- name: Include create.yml\n  ansible.builtin.include_tasks:\n    file: create.yml\n  loop: "{{ openssl_items }}"\n  when: openssl_items is defined and openssl_items | length > 0\n  loop_control:\n    loop_var: openssl_item\n    preserve_labels: true\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-15T14:07:18.73913412Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16622005551, 'load_duration': 82427484, 'prompt_eval_count': 2130, 'prompt_eval_duration': 796617029, 'eval_count': 784, 'eval_duration': 15741286171, 'model_name': 'deepseek-r1:14b'} id='run--e05f6e2b-e6ed-4277-b037-713b733bbd4d-0' usage_metadata={'input_tokens': 2130, 'outp