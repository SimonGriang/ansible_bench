---
- name: password | Get efi path
  command: ls /boot/efi
  changed_when: false
  register: efi_dir
  ignore_errors: yes

- name: password | Remove unwanted grub.cfg on EFI systems
  file:
    path: /boot/efi/EFI/BOOT/grub.cfg
    state: absent
  when: efi_dir.exists

- name: password | Install user template
  template:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    owner: root
    group: root
    mode: 0600

- name: password | EFI | add password
  grub2_password:
    user: "{{ grub_user }}"
    password: "{{ grub_password }}"
    timeout: "{{ grub_timeout | default('') }}"
    grub_config: /etc/grub2-efi.cfg
  when: efi_dir.exists

- name: password | MBR | add password
  grub2_password:
    user: "{{ grub_user }}"
    password: "{{ grub_password }}"
    timeout: "{{ grub_timeout | default('') }}"
    grub_config: /etc/grub2.cfg
  when: efi_dir.exists

- name: password | Add --unrestricted
  lineinfile:
    path: "{{ item }}"
    line: "  set superuser={{ grub_user }}
  password={{ grub_password }}
  {{ 'unrestricted' if grub_password_unrestricted | bool else '' }}"
    insertafter: "^set superuser.*"
    state: present
  loop: "{{ grub_password_unrestricted_files | default([]) }}"
  when: "{{ grub_password_unrestricted | bool }}"



