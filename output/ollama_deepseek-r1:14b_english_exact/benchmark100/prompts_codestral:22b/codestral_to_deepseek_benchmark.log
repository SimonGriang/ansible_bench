---
- name: Import assert.yml
  import_tasks: assert.yml
  host: localhost

- name: Install required packages
  yum:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta:
    flush_handlers: true
  changed_when: false

- name: Configure selinux
  sestatus:
    state: "{{ selinux_state | default('enforcing') }}"
    persistent: yes
    reboot: no
  when: selinux is defined and not (ansible_connection in ['container', 'docker', 'community.docker'])
  notify: Reboot system

- name: Manage selinux booleans
  setsebool:
    name: "{{ item.name }}"
    state: "{{ item.state | default('yes') }}"
    persistent: "{{ item.persistent | default('yes') }}"
  with_items: "{{ selinux_booleans }}"
  when: selinux_booleans is defined


