---
- name: Import assert.yml
  shell: ansible-playbook --tags=assert assert.yml --limit localhost
  delegate_to: localhost
  changed_when: false

- name: Uninstall conflicting systemd-logger
  apt:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  apt:
    name: "{{ rsyslog_packages | default('rsyslog') }}"
    state: "{{ rsyslog_package_state | default('present') }}"

- name: Install additional rsyslog packages
  apt:
    name: "{{ item }}"
    state: "{{ rsyslog_package_state | default('present') }}"
  loop: "{{ rsyslog_features | default([]) }}"

- name: Configuring default rsyslog
  template:
    src: "{{ rsyslog_config_file_format | default('config/rsyslog.conf.j2') }}"
    dest: "{{ rsyslog_dest_conf_file | default('/etc/rsyslog.conf') }}"
    group: root
    mode: 0644
    owner: root
  when: rsyslog_deploy_default_config | default(true)
  notify: restart_rsyslog

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d/
    state: directory
    mode: 0755

- name: Configuring rsyslog forward rule
  template:
    src: "{{ rsyslog_forward_rule_template | default('config/forward-rule.j2') }}"
    dest: /etc/rsyslog.d/{{ rsyslog_forward_rule_name }}.conf
    group: root
    mode: 0644
    owner: root
  when: rsyslog_deploy_default_config | default(true) == false
  notify: restart_rsyslog

- name: Configuring additional config files
  copy:
    content: "{{ item.value | default('') }}"
    dest: /etc/rsyslog.d/{{ item.key }}
    group: root
    mode: 0644
    owner: root
  loop: "{{ rsyslog_rsyslog_d_files | default([]) }}"

- name: Start and enable rsyslog
  service:
    name: "{{ rsyslog_service | default('rsyslog') }}"
    state: started
    enabled: true


