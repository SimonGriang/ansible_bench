---
- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: present
  when:
    - ansible_distribution in ['redhat', 'fedora', 'debian', 'ubuntu']
    - (ansible_python_interpreter | default).startswith('/usr/bin/python')

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when:
    - ansible_distribution in ['redhat', 'fedora', 'debian', 'ubuntu']
    - not (ansible_python_interpreter | default).startswith('/usr/bin/python')

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['centos']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['ol']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['amzn']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['macos']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['windows']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['freebsd']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['netbsd']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['openbsd']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['solaris']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['alpine']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['gentoo']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['slackware']

- name: Set Package State
  ansible.builtin.set_fact:
    ansible_package_state: absent
  when: ansible_distribution in ['arch']

- name: Set Up Ansible on RedHat
  ansible.builtin.include_tasks:
    file: setup-RedHat.yml
  when:
    - ansible_distribution == 'redhat'
    - ansible_package_state == 'present'

- name: Set Up Ansible on Fedora
  ansible.builtin.include_tasks:
    file: setup-Fedora.yml
  when:
    - ansible_distribution == 'fedora'
    - ansible_package_state == 'present'

- name: Set Up Ansible on Ubuntu
  ansible.builtin.include_tasks:
    file: setup-Ubuntu.yml
  when:
    - ansible_distribution == 'ubuntu'
    - ansible_package_state == 'present'

- name: Set Up Ansible on Debian
  ansible.builtin.include_tasks:
    file: setup-Debian.yml
  when:
    - ansible_distribution == 'debian'
    - ansible_package_state == 'present'

- name: Set Up Ansible using Pip
  ansible.builtin.include_tasks:
    file: setup-pip.yml
  when: ansible_package_state == 'absent'


