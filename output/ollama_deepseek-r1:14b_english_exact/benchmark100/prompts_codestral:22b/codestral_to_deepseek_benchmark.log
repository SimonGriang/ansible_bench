ions_directory }}"\n\n- name: Create application directories\n  file:\n    path: "{{ item.path }}"\n    state: directory\n    mode: 0755\n    owner: "{{ promtail_system_user }}"\n    group: "{{ promtail_system_group }}"\n  loop:\n    - { path: "{{ promtail_install_dir }}" }\n    - { path: "{{ promtail_install_dir }}/promtail_version" }\n\n- name: Check promtail binary\n  stat:\n    path: "{{ promtail_install_dir }}/promtail_version/promtail-linux-{{ go_arch }}"\n  register: promtail_binary\n\n- name: Download promtail binaries\n  get_url:\n    url: "{{ promtail_dist_url }}"\n    dest: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"\n    checksum: "{{ (promtail_custom_checksum is defined) | ternary(promtail_custom_checksum, __promtail_checksum) }}"\n  when:\n    - promtail_binary.stat.exists is false\n    - promtail_binary_local_dir is empty\n    - promtail_binary_propagate is false\n\n- name: Propagate locally distributed promtail archive\n  copy:\n    src: "{{ promtail_binary_local_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"\n    dest: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"\n  when:\n    - promtail_binary.stat.exists is false\n    - promtail_binary_local_dir is not empty\n    - promtail_binary_propagate is false\n\n- name: Download promtail binaries to controller node\n  get_url:\n    url: "{{ promtail_dist_url }}"\n    dest: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"\n    checksum: "{{ (promtail_custom_checksum is defined) | ternary(promtail_custom_checksum, __promtail_checksum) }}"\n  when:\n    - promtail_binary_propagate is true\n\n- name: Propagate promtail binaries\n  copy:\n    src: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"\n    dest: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"\n  when:\n    - promtail_binary_propagate is true\n\n- name: Unpack promtail binaries\n  unzip:\n    src: "{{ promtail_tmp_dir }}/promtail_version_promtail-linux-{{ go_arch }}.zip"\n    dest: "{{ promtail_install_dir }}/promtail_version"\n    mode: 0755\n    creates: "{{ promtail_install_dir }}/promtail_version/promtail-linux-{{ go_arch }}"\n    remote_src: yes\n\n- name: Create symlink to latest version\n  file:\n    src: "{{ promtail_install_dir }}/promtail_version/promtail-linux-{{ go_arch }}"\n    dest: /usr/local/bin/promtail\n    state: link\n    mode: 0755\n  notify: Restart promtail\n\n- name: Write config\n  template:\n    src: config.j2\n    dest: "{{ promtail_config_file }}"\n    owner: root\n    group: "{{ promtail_system_group }}"\n    mode: 0644\n  register: promtail_config\n  notify: Restart promtail\n\n- name: Create systemd service unit\n  template:\n    src: "{{ promtail_systemd_service_template_file }}"\n    dest: /etc/systemd/system/promtail_systemd_service.service\n    mode: 0644\n  notify: Restart promtail\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-15T13:40:53.924936744Z', 'done': True, 'done_reason': 'stop', 'total_duration': 40555031032, 'load_duration': 106389562, 'prompt_eval_count': 2901, 'prompt_eval_duration': 1871886622, 'eval_count': 1662, 'eval_duration': 38575239433, 'model_name': 'deepseek-r1:14b'} id='run--3f8a9cae-d04e-413f-abf8-59521a2f45a1-0' usage_metadata={'input_tokens': 2901, 'output_tokens': 1662, 'total_tokens': 4563}
