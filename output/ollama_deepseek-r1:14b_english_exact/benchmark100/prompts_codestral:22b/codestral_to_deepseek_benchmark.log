---
- name: Import assert.yml
  shell: ansible-playbook assert.yml

- name: Install required packages
  apt:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    regex: '^GRUB_TIMEOUT'
    backslashed: yes
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    regex: '^GRUB_RECORDFAIL_TIMEOUT'
    backslashed: yes
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_CMDLINE_LINUX={{ item }}"
    regex: '^GRUB_CMDLINE_LINUX'
    insertafter: '^GRUB_CMDLINE_LINUX='
    backslashed: yes
  with_items: "{{ grub_options | default([]) }}"
  when: grub_options
  notify: Update grub

- name: Import password.yml
  shell: ansible-playbook password.yml
  when: grub_set_password

- name: Flush handlers
  meta:
    flush_handlers: true


