r if manage_ssh_key is defined and set to true\n  when: manage_ssh_key and manage_ssh_key|bool\n  action: ansible.builtin.shell\n  args:\n    cmd: "{{ users_ssh_keygen_pubkey_command }}"\n    remote: false\n\n- name: Convert the private SSH key to a ppk format for a specific user if manage_ssh_key is defined and set to true\n  when: manage_ssh_key and manage_ssh_key|bool\n  action: ansible.builtin.shell\n  args:\n    cmd: ssh-keygen -e -f "{{ users_ssh_key_directory }}/{{ user.name }}" -C "Generated by Ansible role robertdebock.users"\n    remote: false\n\n- name: Get or set the home directory for a specific user\n  action: ansible.builtin.getent\n  args:\n    db:passwd\n    key: "{{ user.name }}"\n  register: user_info\n\n- name: Create a .ssh directory for a specific user if manage_ssh_key is defined and set to true or if private_keys are defined\n  when: manage_ssh_key and manage_ssh_key|bool or private_keys is defined\n  action: ansible.builtin.file\n  args:\n    path: "{{ user_info ansible_sshホームディレクトリ }}/.ssh"\n    state: directory\n    mode: 0700\n    owner: "{{ user.name }}"\n\n- name: Deploy authorized keys for a specific user if authorized_keys are defined\n  when: authorized_keys is defined\n  action: ansible.posix.authorized_key\n  args:\n    user: "{{ user.name }}"\n    key: "{{ item.key }}"\n    state: present\n  loop: "{{ authorized_keys }}"\n\n- name: Remove unauthorized keys for a specific user if unauthorized_keys are defined\n  when: unauthorized_keys is defined\n  action: ansible.posix.authorized_key\n  args:\n    user: "{{ user.name }}"\n    key: "{{ item }}"\n    state: absent\n  loop: "{{ unauthorized_keys }}"\n\n- name: Copy a generated private SSH key for a specific user to their .ssh directory if copy_private_key is defined and set to true\n  when: copy_private_key is defined and copy_private_key|bool\n  action: ansible.builtin.copy\n  args:\n    src: "{{ users_ssh_key_directory }}/{{ user.name }}"\n    dest: "{{ user_info ansible_sshホームディレ