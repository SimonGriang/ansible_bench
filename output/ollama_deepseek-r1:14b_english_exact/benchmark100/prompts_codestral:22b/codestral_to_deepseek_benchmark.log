---
- name: Download RKE2 kubeconfig
  get_url:
    url: http://{{ rke2_api_ip }}/v1.26.5/kubeconfig
    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
  when:
    - rke2_download_kubeconf
    - ansible_hostname == (group[0].ansible_hostname | default(ansible_host))

- name: Read the downloaded kubeconfig
  slurp:
    file: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
  register: kubeconfig_content
  when:
    - rke2_download_kubeconf
    - ansible_hostname == (group[0].ansible_hostname | default(ansible_host))

- name: Replace loopback IP with master server IP
  set_fact:
    modified_kubeconfig: "{{kubeconfig_content.slurped | replace('127.0.0.1', rke2_api_ip) | replace('::1', rke2_api_ip)}}"
  when:
    - rke2_download_kubeconf
    - ansible_hostname == (group[0].ansible_hostname | default(ansible_host))

- name: Save the modified kubeconfig
  file:
    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    content: "{{ modified_kubeconfig }}"
    mode: 0600
  when:
    - rke2_download_kubeconf
    - ansible_hostname == (group[0].ansible_hostname | default(ansible_host))


