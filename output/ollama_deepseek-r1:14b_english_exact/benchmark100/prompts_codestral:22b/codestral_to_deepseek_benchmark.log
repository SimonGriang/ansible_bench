---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip
  pip:
    name: "{{ python_pip_packages | default([]) | list | split_lines }}"
    state: present

- name: Configure pip proxy
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: 0644
  when: python_pip_proxy is defined

- name: Trust hosts
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: 0644
  when: python_pip_trusted_host is defined
  loop: "{{ python_pip_trusted_host | default([]) | list }}"

- name: Update pip
  pip:
    executable: "{{ python_pip_executable | default('pip') }}"
    name: "{{ python_pip_pip_package | default('pip') }}"
    state: "{{ python_pip_pip_state | default('present') }}"
  when:
    - python_pip_update
    - not (ansible_distribution == 'Bookworm'
           or ansible_distribution == 'Noble'
           or ansible_os_family == 'Alpine')

- name: Install requested modules
  pip:
    executable: "{{ python_pip_executable | default('pip') }}"
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default('') }}"
  loop: "{{ python_pip_modules | default([]) | list }}"
  when:
    - not (ansible_distribution == 'Bookworm'
           or ansible_distribution == 'Noble'
           or ansible_os_family == 'Alpine')
  loop_control:
    label: "{{ item.name }}"


