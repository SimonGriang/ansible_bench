---
- name: lookup bootstrap facts (raw)
  ansible.builtin.raw:
    cmd: cat /etc/os-release
  register: ansible_facts
  changed_when: false
  ignore_errors: true
  remote_user: false
  become: false

- name: set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ ansible_facts.results[0].stdout_lines | json_query("
                              'ansible_facts.ID'
                             ) }}"
    bootstrap_version: "{{ ansible_facts.results[0].stdout_lines | json_query("
                         'ansible_facts.VERSION_ID'
                        ) }}"
  when:
    - ansible_facts is defined
    - 'bootstrap_distribution' not defined
    - ansible_facts.results[0].stdout_lines is match
  remote_user: false
  become: "{{ bootstrap_become | default('no') }}"
  become_user: "{{ bootstrap_become_user | default('root') }}"

- name: set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop:
    - centos: redhat
    - rhel: redhat
    - fedora: redhat
    - ubuntu: debian
    - debian: debian
    - almalinux: redhat
    - rocky: redhat
  when: ansible_facts[0].stdout is match(item.value)
  remote_user: false
  become: "{{ bootstrap_become | default('no') }}"
  become_user: "{{ bootstrap_become_user | default('root') }}"


