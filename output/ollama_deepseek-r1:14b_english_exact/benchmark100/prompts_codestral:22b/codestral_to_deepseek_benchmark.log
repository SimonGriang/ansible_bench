---
- name: Import assert.yml
  ansible.builtin.import_yaml:
    file: assert.yml
    register: assertions

- name: Pre-configure Debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'n'
    priority: low

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.pip:
    name: postfix-mysql
    state: present
    when: "'mysql' in (postfix_myrrix | default(''))"

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    owner: postfix
    group: postfix
    mode: 0644
  when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: postfix
    group: postfix
    mode: 0644
  when: postfix_header_checks_template is defined

- name: Setting values for main.cf
  set_fact:
    postfix_smtpd_recipient_restrictions: |
      smtpd_client_restrictions = {{ postfix_smtpd_client_restrictions }}
      smtpd_helo_restrictions = {{ postfix_smtpd_helo_restrictions }}
      smtpd_sender_restrictions = {{ postfix_smtpd_sender_restrictions }}
      smtpd_recipient_restrictions = {{ postfix_smtpd_recipient_restrictions }}
    postfix_smtpd_sender_restrictions: |
      smtpd_sender_restrictions = {{ postfix_smtpd_sender_restrictions }}

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    owner: postfix
    group: postfix
    mode: 0644
  register: postfix_maincf
  notify: reload postfix

- name: Configure postfix (master.cf)
  template:
    src: master(cf.j2
    dest: /etc/postfix/master.cf
    owner: postfix
    group: postfix
    mode: 0644
  register: postfix_mastercf
  notify: reload postfix

- name: Create cert/key directory
  file:
    path: "{{ postfix_smtpd_tls_cert_dir }}"
    state: directory
    mode: 0755
  when: postfix_smtpd_tlsCertFile or postfix_smtpd_tls_key_file_source
  vars:
    postfix_smtpd_tls_cert_dir: "{{ postfix_smtpd_tls_cert_dir | default('/etc/postfix/tls') }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file_source }}"
    dest: "{{ postfix_smtpd_tls_cert_file | default('/etc/postfix/smtpd.cert') }}"
    owner: postfix
    group: postfix
    mode: 0644
  when: postfix_smtpd_tls_cert_file_source is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file_source }}"
    dest: "{{ postfix_smtpd_tls_key_file | default('/etc/postfix/smtpd.key') }}"
    owner: postfix
    group: postfix
    mode: 0600
  when: postfix_smtpd_tls_key_file_source is defined

- name: Flush handlers
  ansible.legacy.flush:

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/postfix/aliases
    owner: root
    group: root
    mode: 0644
  when: postfix_aliases is defined

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    owner: postfix
    group: postfix
    mode: 0644
  when: postfix_sender_access is defined

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    owner: postfix
    group: postfix
    mode: 0644
  when: postfix_recipient_access is defined

- name: Place sasl_password_map
  copy:
    src: "{{ postfix_smtp_sasl_password_map | default('') }}"
    dest: /etc/postfix/sasl_password_map
    owner: postfix
    group: postfix
    mode: 0644
  when: postfix_smtp_sasl_password_map is defined and (postfix_smtp_sasl_password_map | default('') | length) > 0

- name: Flush handlers (again)
  ansible.legacy.flush:

- name: Start and enable postfix
  systemd:
    name: postfix
    state: started
    enabled: yes
