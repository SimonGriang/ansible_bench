orrect sequence, making sure to include all necessary modules, variables, and handlers. I\'ll avoid adding any comments or explanations, just the YAML code as required.\n\nI think that\'s all. Let me structure the playbook step by step, ensuring each task is correctly implemented and adheres to the given instructions.\n</think>\n\n```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  ignore_errors: yes\n\n- name: Install required packages\n  apt:\n    name: "{{ selinux_requirements }}"\n    state: present\n  notify: Gather facts\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Configure selinux\n  block:\n    - name: Manage SELinux state and policy\n      selinux:\n        state: "{{ selinux_state }}"\n        policy: "{{ selinux_policy }}"\n        reboot: yes\n      notify: Reboot system\n      become: yes\n\n    - name: Manage SELinux booleans\n      loop: "{{ selinux_booleans }}"\n      selinux_boolean:\n        name: "{{ item.name }}"\n        state: "{{ item.state | default(\'enabled\') }}"\n        persistent: "{{ item.persistent | default(\'yes\') }}"\n      become: yes\n  when:\n    - selinux_status is defined\n    - ansible_connection not in [\'container\', \'docker\', \'community.docker.docker\']\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-15T12:50:35.552346705Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10219261591, 'load_duration': 92062447, 'prompt_eval_count': 476, 'prompt_eval_duration': 81774532, 'eval_count': 701, 'eval_duration': 10043990576, 'model_name': 'deepseek-r1:14b'} id='run--5f4f1786-a9a4-492f-977b-e9c6f61aee00-0' usage_metadata={'input_tokens': 476, 'output_tokens': 701, 'total_tokens': 1177}
