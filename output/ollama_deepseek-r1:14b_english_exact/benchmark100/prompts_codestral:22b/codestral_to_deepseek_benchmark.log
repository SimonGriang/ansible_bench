---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: 0755
    owner: rancher
    group: rancher

- name: Set server taints
  when: rke2_type == "server"
  kubernetes_node_taint:
    taints: "{{ rke2_server_node_taints }}"

- name: Set agent taints
  when: rke2_type == "agent"
  kubernetes_node_taint:
    taints: "{{ rke2_agent_node_taints }}"

- name: Copy RKE2 config
  copy:
    src: "{{ rke2_config }}"
    dest: /etc/rancher/rke2/config.yaml
    remote_src: yes
    mode: 0644
    owner: rancher
    group: rancher
  notify: Config file changed

- name: Copy kubelet config
  when: rke2_kubelet_config is not empty
  copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: 0644
    owner: rancher
    group: rancher
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  when:
    - rke2_custom_registry_mirrors is not empty
    - rke2_custom_registry_configs is not empty
  copy:
    src: "{{ rke2_custom_registry_path }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: 0644
    owner: rancher
    group: rancher
  notify: Config file changed

- name: Start RKE2 service on the rest of the nodes
  systemd:
    name: "{{ rke2_service_name }}"
    state: started
    enabled: yes
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"

- name: Mask other RKE2 service on the rest of the nodes
  when: rke2_type == "server"
  systemd:
    name: "{{ rke2_agent_service_name }}"
    state: masked

- name: Mask other RKE2 service on the rest of the nodes
  when: rke2_type == "agent"
  systemd:
    name: "{{ rke2_server_service_name }}"
    state: masked

- name: Wait for remaining nodes to be ready - no CNI
  when: rke2_cni == "none"
  shell: |
    until kubectl get nodes -n cattle-system --kubeconfig=/etc/rancher/rke2/config.yaml | grep -c 'Ready' | egrep -q "^{{ total_nodes }}$"; do sleep 1; done
  retries: 60
  delay: 10
  changed_when: false

- name: Wait for remaining nodes to be ready - with CNI
  when: rke2_cni is not "none"
  shell: |
    until kubectl get nodes -n cattle-system --kubeconfig=/etc/rancher/rke2/config.yaml | grep -v 'Not Ready' | wc -l | egrep -q "^{{ total_nodes }}$"; do sleep 1; done
  retries: 60
  delay: 10
  changed_when: false

handlers:
  - name: Config file changed
    shell: systemctl restart "{{ rke2_service_name }}"


