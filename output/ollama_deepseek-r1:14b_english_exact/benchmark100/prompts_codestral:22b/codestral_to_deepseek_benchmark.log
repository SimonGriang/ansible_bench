---
- name: Update package cache
  shell: |
    if [[ $(lsb_release -i 2>/dev/null) == *"Ubuntu"* ]]; then
      apt-get update -yqq
    else
      dnf clean all && dnf makecache -y
    fi

- name: Install keepalived package
  shell: |
    if [[ $(lsb_release -i 2>/dev/null) == *"Ubuntu"* ]]; then
      apt-get install -yqq keepalived
    else
      dnf install -y keepalived
    fi
  become: true

- name: Create keepalived directory
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Create Kubernetes API health check script for Debian OS family
  template:
    src: k8s_api_health.sh.j2
    dest: /etc/keepalived/k8s_api_health.sh
    owner: root
    group: root
    mode: 0755
  notify: restart_keepalived

- name: Create Kubernetes API health check script for RedHat OS family
  template:
    src: k8s_api_health.sh.j2
    dest: /usr/libexec/keepalived/k8s_api_health.sh
    owner: root
    group: root
    mode: 0755
  notify: restart_keepalived

- name: Create RKE2 Server health check script for Debian OS family
  template:
    src: rke2_server_health.sh.j2
    dest: /etc/keepalived/rke2_server_health.sh
    owner: root
    group: root
    mode: 0755
  notify: restart_keepalived

- name: Create RKE2 Server health check script for RedHat OS family
  template:
    src: rke2_server_health.sh.j2
    dest: /usr/libexec/keepalived/rke2_server_health.sh
    owner: root
    group: root
    mode: 0755
  notify: restart_keepalived

- name: Create keepalived configuration file
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: 0644
  notify: restart_keepalived

- name: Enable and unmask keepalived service
  shell: systemctl enable keepalived && systemctl unmask keepalived
  become: true
  notify: restart_keepalived

- name: Flush handlers
  meta: flush_handlers


