on.\n\nPutting it all together, the playbook should look clean and adhere strictly to the user\'s instructions without any additional comments or formatting.\n</think>\n\n```yaml\n---\n- name: Populate services facts\n  ansible.builtin.service_facts:\n    state: present\n\n- name: Set the Active Server variable\n  ansible.builtin.set_fact:\n    active_server: "{{ ansible_hostname }}"\n  when:\n    - ansible_group == "rke2_servers_group_name"\n    - ansible_service_dict["rke2-server.service"]["state"] == "running"\n  delegate_to: "{{ rke2_cluster_group_name }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-15T15:07:59.738539361Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11011359193, 'load_duration': 83634346, 'prompt_eval_count': 372, 'prompt_eval_duration': 105873985, 'eval_count': 533, 'eval_duration': 10820671940, 'model_name': 'deepseek-r1:14b'} id='run--4d9d73a4-fbae-4201-805c-6b771a8df3fc-0' usage_metadata={'input_tokens': 372, 'output_tokens': 533, 'total_tokens': 905}
