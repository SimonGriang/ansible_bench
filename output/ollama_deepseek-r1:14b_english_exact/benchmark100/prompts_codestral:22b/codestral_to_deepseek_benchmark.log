 | default([]) | list }}"\n  include_tasks: user.yml\n  when:\n    - users_defined\n\n- name: Manage cron permission\n  template:\n    src: cron.allow.j2\n    dest: /etc/cron.allow\n    mode: 0644\n  when:\n    - users_cron_allow_defined\n\n- name: Check existence of /etc/cron.allow\n  file:\n    path: /etc/cron.allow\n    state: absent\n  when:\n    - not users_cron_allow_defined\n\nusers_requirements_defined: "{{ ansible.utils.conditional | isDEFINED(\'users_requirements\') }}"\nusers_groups_defined: "{{ ansible.utils.conditional | isDEFINED(\'users_groups\') }}"\nusers_sudo_includedir_defined: "{{ ansible.utils.conditional | isDEFINED(\'users_sudo_includedir\') }}"\nusers_defined: "{{ ansible.utils.conditional | isDEFINED(\'users\') }}"\nusers_cron_allow_defined: "{{ ansible.utils.conditional | isDEFINED(\'users_cron_allow\') }}"' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-15T14:10:05.054380488Z', 'done': True, 'done_reason': 'stop', 'total_duration': 25530403042, 'load_duration': 87633372, 'prompt_eval_count': 989, 'prompt_eval_duration': 46392242, 'eval_count': 1160, 'eval_duration': 25395217402, 'model_name': 'deepseek-r1:14b'} id='run--4b92ff66-2e80-4cee-b308-43ea7e0166d5-0' usage_metadata={'input_tokens': 989, 'output_tokens': 1160, 'total_tokens': 2149} 52%|█████▏    | 52/100 [2:09:16<1:53:32, 141.92s/it]
