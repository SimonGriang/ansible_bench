---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Wait for port to be available
  wait_for_port:
    port: 22
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  block:
    - name: Test connection
      connection:
        state: test
    - name: Check if sudo is installed
      command: which sudo
      changed_when: false
      failed_when: false
  rescue:
    - name: Gather facts
      setup:
        gather_subset: all
    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages }}"
        state: present
        update_cache: true
        become: "{{ bootstrap_become }}"

- name: Gather ansible facts
  setup:
    gather_subset: all

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: true
    become: "{{ bootstrap_become }}"


