---
- name: Remove externally managed
  import_tasks: tasks/remove-externally-managed.yml
  when:
    ansible_os_family: Debian
    ansible_distribution_version: '12'

- name: Ensure Pip is installed
  apt:
    name: "{{ pip_package | default('python3-pip') }}"
    state: present

- name: Ensure packaging is available
  apt:
    name: python3-packaging
    state: present

- name: Ensure pip_install_packages are installed
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default('latest') }}"
    state: "{{ item.state | default('present') }}"
    virtualenv: "{{ item.virtualenv }}"
    extra_args: "{{ item.extra_args | default('') }}"
    executable: "{{ item.virtualenv | default('{{ pip_executable | default('pip3') }}') }}"
  loop: "{{ pip_install_packages | default([]) }}"


