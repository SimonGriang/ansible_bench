---
- name: Cordon and Drain the node {{ rke2_node_name }}
  shell: kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-emptydir-volumes=true --force {{ rke2_drain_additional_args }}
  args:
    chdir: "{{ rke2_data_path }}"
  register: drain_result
  until: drain_result.results | map(attribute='stderr') | join | contains("node {{ rke2_node_name }} is being drained")
  retries: 100
  delay: 15
  when: rke2_drain_node_during_upgrade

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2
    state: restarted
    display_name: rke2
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  wait_for:
    path: https://localhost:443
    state: ready
    match: "Ready"
    delay: 15
    retries: 100

- name: Uncordon the node {{ rke2_node_name }}
  shell: kubectl uncordon {{ rke2_node_name }}
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  wait_for:
    path: https://localhost:443
    state: ready
    match: "Running|Succeeded"
    delay: 15
    retries: 100
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  shell: kubectl wait --for=condition=Ready pod --all
  args:
    chdir: "{{ rke2_data_path }}"
  delay: 15
  retries: 100
  when: rke2_wait_for_all_pods_to_be_healthy


