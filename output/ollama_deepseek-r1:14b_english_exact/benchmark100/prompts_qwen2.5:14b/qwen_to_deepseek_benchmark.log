---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install requirements
  ansible.builtin.apt:
    name: bash
    state: present

- name: Install openjdk java (package)
  ansible.builtin.apt:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"

- name: Install RPM
  ansible.builtin.rpm:
    file: /path/to/oracle-jdk.rpm
    state: present

- name: Install DEB
  ansible.builtin.apt:
    deb: /path/to/oracle-jdk.deb
    state: present

- name: Install oracle java (rpm) (repository)
  ansible.builtin.apt:
    name: oracle-java
    state: present

- name: Configure oracle targz (unzip)
  community.general.unzip:
    file: /path/to/oracle-jdk.tgz
    dest: /usr/local/java

- name: Ensure java directory exists
  ansible.builtin.file:
    path: /usr/local/java
    state: directory
    mode: 0755

- name: Install oracle java policy software (targz)
  ansible.builtin.apt:
    name: oracle-java-jce
    state: present

- name: Set alternative (targz)
  ansible.legacy.alternative:
    name: java
    path: /usr/local/java/bin/java
    state: present
  when: ansible_distribution != "Alpine"

- name: Find JAVA_HOME
  ansible.builtin.command:
    cmd: readlink -f /usr/bin/java
    register: java_home
    changed_when: false

- name: Set JAVA_HOME in /etc/environment
  ansible.builtin.lineinfile:
    path: /etc/environment
    line: JAVA_HOME="{{ java_home.stdout }}"
    state: present


