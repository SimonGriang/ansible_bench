e: present\n\n- name: Java | Import certificates into Java Keystore\n  community.general.java_cert:\n    path: /etc/pki/java/certs.js安全\n    alias: java_certs\n    source: files/java_cert.cer\n    no_backup: true\n    keystore_pass: "{{ java_keystore_password }}"\n    key_password: "{{ java_key_password }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T07:22:45.154569131Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11615913644, 'load_duration': 95874184, 'prompt_eval_count': 1269, 'prompt_eval_duration': 754584659, 'eval_count': 529, 'eval_duration': 10764431556, 'model_name': 'deepseek-r1:14b'} id='run--892cc4ef-9140-49aa-91e8-cfc76e051886-0' usage_metadata={'input_tokens': 1269, 'output_tokens': 529, 'total_tokens': 1798}
