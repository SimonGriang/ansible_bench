    line: "GRUB_CMDLINE_LINUX={{ item }}"
    with_items: "{{ grub_options }}"
    notify: Update grub
  when: grub_options | list | length > 0

- name: Import password.yml
  import_tasks:
    file: files/password.yml
  when: grub_set_password

- name: Flush handlers
  meta:
    flush_handlers: true


