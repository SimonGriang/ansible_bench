---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install required packages
  apt:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  block:
    - name: Determine if SELinux is enabled
      set_fact:
        selinux_enabled: "'{{ ansible_selinux_status }}' == 'enabled'"

    - name: Determine connection type
      set_fact:
        connection_type: "'{{ ansible_connection }}' == 'local'"

    - name: Manage selinux
      selinux:
        state: "{{ 'enabled' if selinux_enabled else 'disabled' }}"
        policy: "{{ 'targeted' if selinux_enabled else 'disabled' }}"
      notify: Reboot system

    - name: Manage selinux booleans
      loop: "{{ selinux_booleans }}"
