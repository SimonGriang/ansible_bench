---
- name: Create document root directories for each virtual host
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  loop: "{{ httpd_vhosts | default([]) }}"
  when: item.create_docroot | default(true)
  register: docroot_created

- name: Configure virtual hosts using a template
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    group: "www-data"
    mode: "0644"
  loop: "{{ httpd_vhosts | default([]) }}"

- name: Test httpd configuration and restart service
  command:
    cmd: apache2configtest
    chdir: "/etc/apache2"
  register: httpd_test
  ignore_errors: yes

- name: Restart httpd service
  service:
    name: httpd
    state: restarted
  when: httpd_test | succeeded



