---
- name: Update apt cache
  apt:
    state: update

- name: Update dnf cache
  dnf:
    state: update

- name: Install packages
  apt:
    name: keepalived
    state: present
  become: yes

- name: Create directory for keepalived
  file:
    path: /etc/keepalived
    state: directory
    setgid: yes
    setuid: yes

- name: Create Kubernetes API health check script for Debian OS family
  template:
    src: k8s-api-debian.sh.j2
    dest: /etc/keepalived/k8s-api-debian.sh
    mode: 755
    notify: restart_keepalived
  when: ansible_os_family == 'Debian'

- name: Create Kubernetes API health check script for RedHat OS family
  template:
    src: k8s-api-redhat.sh.j2
    dest: /etc/keepalived/k8s-api-redhat.sh
    mode: 755
    notify: restart_keepalived
  when: ansible_os_family == 'RedHat'

- name: Create RKE2 Server health check script for Debian OS family
  template:
    src: rke2-server-debian.sh.j2
    dest: /etc/keepalived/rke2-server-debian.sh
    mode: 755
    notify: restart_keepalived
  when: ansible_os_family == 'Debian'

- name: Create RKE2 Server health check script for RedHat OS family
  template:
    src: rke2-server-redhat.sh.j2
    dest: /etc/keepalived/rke2-server-redhat.sh
    mode: 755
    notify: restart_keepalived
  when: ansible_os_family == 'RedHat'

- name: Create keepalived config file
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    mode: 644
    notify: restart_keepalived

- name: Enable keepalived and make sure it is not masked
  systemctl:
    name: keepalived
    state: started
    enabled: yes
    masked: no
    notify: restart_keepalived

- name: Flush handlers
  meta: flush_handlers


