---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: 0700
    timeout: 30

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local }}"
    dest: "{{ rke2_install_script_path }}"
    mode: 0700
    remote_src: no
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0700
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation != "exists"

- name: Download RKE2 checksum and artifacts
  get_url:
    url: "{{ rke2_checksum_url }}"
    dest: "{{ rke2_checksum_path }}"
    mode: 0644
    timeout: 30
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == "download"

- name: Download RKE2 artifacts
  get_url:
    url: "{{ rke2_artifacts_url }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0644
    timeout: 30
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == "download"

- name: Download RKE2 install script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: 0700
    timeout: 30
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == "download"

- name: Rescue for failed download
  block:
    - name: Create directory for failed download
      file:
        path: "{{ rke2_artifacts_path }}"
        state: directory
        mode: 0700
    - name: Download RKE2 artifacts locally
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}"
        mode: 0644
        timeout: 30
    - name: Download RKE2 install script locally
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_path }}"
        mode: 0700
        timeout: 30
  rescue: true

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0640
    remote_src: no
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create directory for additional images
      file:
        path: "{{ rke2_additional_images_path }}"
        state: directory
        mode: 0700
    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_additional_images_path }}"
        mode: 0640
        remote_src: no
        force: yes
      with_items: "{{ rke2_airgap_copy_additional_tarballs }}"
  when:
    - rke2_airgap_mode
    - rke2_airgap_copy_additional_tarballs | length > 0
    - rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0700
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == "exists"

- name: Get service facts
  command: systemctl list-unit-files --type service
  register: service_facts

- name: Get stats of the FS object
  command: stat -f /usr/local
  register: fs_stats

- name: Check if separate partition
  command: grep /usr/local /proc/mounts
  register: separate_partition
  changed_when: false
  ignore_errors: yes

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_dir }}/{{ rke2_install_script_name }}"

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}" version
  register: rke2_version
  changed_when: false
  ignore_errors: yes

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version.stdout | default('0.0.0') }}"
    rke2_running_version: "{{ rke2_version.stdout | default('0.0.0') }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  fail:
    msg: "RKE2 version {{ rke2_version.stdout }} is less than installed version {{ rke2_versionInstalled }}"
  when:
    - not ansible_check_mode
    - rke2_version.stdout | version_compare(">", rke2_versionInstalled) is not defined
    - rke2_versionInstalled != "0.0.0"

- name: Run RKE2 install script
  command: "{{ rke2_bin_path }}" install
  when:
    - rke2_version.stdout != rke2_versionInstalled
    - not ansible_check_mode
  when: rke2_airgap_mode and rke2_airgap_implementation

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/manifests/custom/"
    mode: 0640
    remote_src: no
    force: yes
  with_items: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}"
    mode: 0640
    remote_src: no
    force: yes
  with_items: "{{ rke2_static_pods }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: "{{ rke2_env_dir }}/rke2.env"
    mode: 0640
    remote_src: no
    force: yes
  when: rke2_env_file is defined and rke2_env_file != ""


