---
- name: Create the RKE2 manifests directory
  file:
    path: /etc/rke2/manifests
    state: directory
    mode: 755

- name: Copy kube-vip files to first server
  template:
    src: "{{ item }}"
    dest: /etc/rke2/manifests/
    mode: 755
  with_items: "{{ lookup('file', 'files/kube-vip/*.yaml.j2') | list }}"
  register: kubevip_files

- name: Copy kube-vip load balancer manifests to first server
  when: cloud_provider is enabled
  template:
    src: "{{ item }}"
    dest: /etc/rke2/manifests/
    mode: 755
  with_items: "{{ lookup('file', 'files/kube-vip/loadbalancer-*.yaml.j2') | list }}"
  register: kubevip_loadbalancer


