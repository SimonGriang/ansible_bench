er and that only the necessary fixes are applied without altering the original instructions or functionality.\n</think>\n\n```yaml\n---\n- name: cadvisor | create directories\n  file:\n    path: /var/lib/cadvisor\n    state: directory\n    owner: root\n    group: root\n\n- name: cadvisor | download\n  get_url:\n    url: "https://github.com/google/cadvisor/releases/download/v{{ cadvisor_version }}/cadvisor-linux-amd64"\n    dest: "/var/lib/cadvisor/cadvisor"\n    checksum: "{{ cadvisor_checksum }}"\n  when: local_binary_dir is not defined\n\n- name: cadvisor | propagate locally distributed cadvisor binary\n  copy:\n    src: "{{ local_binary_dir }}/cadvisor"\n    dest: /var/lib/cadvisor/cadvisor\n  when: local_binary_dir is defined\n  notify: cadvisor restart\n\n- name: cadvisor | symlink\n  ln:\n    path: /usr/local/bin/cadvisor\n    state: symlink\n    target: /var/lib/cadvisor/cadvisor\n\n- name: cadvisor | server systemd service\n  template:\n    src: cadvisor.service.j2\n    dest: /etc/systemd/system/cadvisor.service\n\n- name: test_task\n  shell: systemctl status cadvisor\n  register: service_active\n\n- name: debug: var=service_active\n  debug:\n    var: service_active\n\n- name: cadvisor | enable server systemd\n  systemd:\n    name: cadvisor\n    state: enabled\n\n- name: cadvisor | start server systemd\n  systemd:\n    name: cadvisor\n    state: started\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T04:59:53.068149404Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16089671941, 'load_duration': 104330918, 'prompt_eval_count': 928, 'prompt_eval_duration': 69066182, 'eval_count': 782, 'eval_duration': 15915318251, 'model_name': 'deepseek-r1:14b'} id='run--fb1a1f51-7015-4d43-b33c-e093545cea5c-0' usage_metadata={'input_tokens': 928, 'output_tokens': 782, 'total_tokens': 1710}  2%|▏         | 2/100 [04:03<3:36:27, 132.53s/it]
