king these changes, I\'ll test the playbook with ansible-lint to ensure no more errors pop up. This should fix all the reported issues without changing the original task functionality.\n</think>\n\n```yaml\n---\n- name: Restart RKE2 service on {{ rke2_node_name }}\n  ansible.builtin.systemd:\n    name: "{{ rke2_service_name }}"\n    state: restarted\n  become: true\n\n- name: Wait for all nodes to be ready again\n  ansible.builtin.wait_for:\n    command: /bin/kubectl get nodes --output=json\n    delay: 15\n    retries: 100\n    state: started\n  delegate_to: "{{ active_server | default(first_server_in_group) }}"\n\n- name: Wait for all pods to be ready again\n  ansible.builtin.wait_for:\n    command: /bin/kubectl get pods --all-namespaces --output=json\n    delay: 15\n    retries: 100\n    state: started\n  delegate_to: "{{ active_server | default(first_server_in_group) }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-18T11:29:50.489506322Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15822587874, 'load_duration': 100759879, 'prompt_eval_count': 2243, 'prompt_eval_duration': 1185004304, 'eval_count': 689, 'eval_duration': 14535991915, 'model_name': 'deepseek-r1:14b'} id='run--f461a6a8-5119-4eb8-9523-62b1af904e8c-0' usage_metadata={'input_tokens': 2243, 'output_tokens': 689, 'total_tokens': 2932}
