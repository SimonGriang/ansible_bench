---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Configure apk
  apk:
    update_cache: true
    upgrade: true
  notify: reboot

- name: Configure apt
  apt:
    upgrade: full
    exclude_packages: "{{ exclude_packages | default([]) }}"
    autoclean: true
    autoremoving: true
  notify: reboot

- name: Update all software (dnf)
  dnf:
    update: true
    exclude: "{{ exclude_packages | default([]) }}"
  notify: reboot

- name: Update all software (pacman)
  pacman:
    state: present
  notify: reboot

- name: Configure yum
  yum:
    name: "{{ item }}"
    state: present
  with_items: "{{ yum_packages | default([]) }}"
  notify: reboot

- name: Update all software (zypper)
  zypper:
    update: yes
  notify: reboot

handlers:
  - name: reboot
    systemd:
      name: reboot
      state: started


