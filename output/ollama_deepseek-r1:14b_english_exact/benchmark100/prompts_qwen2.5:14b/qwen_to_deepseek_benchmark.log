  copy:
    src: "{{ rke2_artifacts_local_path }}/"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0640
    force: yes
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images directory
      file:
        path: "{{ rke2_additional_images_path }}"
        state: directory
        mode: 0700
      when: "{{ rke2_airgap_copy_additional_tarballs | length }} > 0"

