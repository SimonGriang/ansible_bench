---
- name: Import assert.yml
  import_tasks:
    file: files/assert.yml
    remote_host: localhost

- name: Install required packages
  apt:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_CMDLINE_LINUX={{ item }}"
    with_items: "{{ grub_options }}"
    notify: Update grub
  when: grub_options | list | length > 0

- name: Import password.yml
  import_tasks:
    file: files/password.yml
  when: grub_set_password

- name: Flush handlers
