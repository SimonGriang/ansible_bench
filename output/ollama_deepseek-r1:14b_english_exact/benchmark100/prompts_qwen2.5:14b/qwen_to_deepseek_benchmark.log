ginx\']\n  notify: reboot\n\n- name: Update all software (dnf)\n  become: true\n  dnf:\n    state: update\n    exclude: [\'dnf\', \'python3\']\n  notify: reboot\n\n- name: Update all software (pacman)\n  become: true\n  pacman:\n    state: update\n  notify: reboot\n\n- name: Configure yum\n  become: true\n  yum:\n    name: "yum-utils"\n    state: present\n    upgrade: true\n  ignore_errors: true\n  notify: reboot\n\n- name: Update all software (zypper)\n  become: true\n  zypper:\n    state: update\n  notify: reboot\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-18T09:10:15.320405445Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15107557801, 'load_duration': 96633710, 'prompt_eval_count': 1373, 'prompt_eval_duration': 572682463, 'eval_count': 610, 'eval_duration': 14436861133, 'model_name': 'deepseek-r1:14b'} id='run--19bec0f3-dfc2-49b7-8fe5-1a3771f428e2-0' usage_metadata={'input_tokens': 1373, 'output_tokens': 610, 'total_tokens': 1983}
