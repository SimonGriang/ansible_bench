---
- name: Download RKE2 kubeconfig to localhost
  become: true
  command: cp /etc/rancher/rke2/rke2.yaml "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
  when:
    - rke2_download_kubeconf | default(false)
    - inventory_hostname == groups[rke2_servers_group_name][0]

- name: Replace loopback IP by master server IP
  become: true
  command: sed -i "s/127.0.0.1/{{ rke2_api_ip | default(rke2_api_fallback_ip)}}/g" "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
  when:
    - not ansible_check_mode
    - rke2_download_kubeconf | default(false)
    - inventory_hostname == groups[rke2_servers_group_name][0]


