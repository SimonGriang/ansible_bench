e: Trust hosts\n  ansible.builtin.template:\n    src: pip.conf.j2\n    dest: /etc/pip.conf\n    mode: 0o0644\n  when: python_pip_trusted_host is defined\n\n- name: Update pip\n  ansible.builtin.pip:\n    name: pip\n    state: present\n    extra_args: --upgrade\n  when:\n    - python_pip_update\n    - distribution_release is not in [\'bookworm\', \'noble\']\n    - ansible_os_family != \'Alpine\'\n\n- name: Install requested modules\n  ansible.builtin.pip:\n    name: "{{ item.name }}"\n    version: "{{ item.version | default(\'latest\') }}"\n    state: "{{ item.state | default(\'present\') }}"\n  loop: "{{ python_pip_modules | default([]) | list }}"\n  when:\n    - python_pip_modules is defined\n    - distribution_release is not in [\'bookworm\', \'noble\']\n    - ansible_os_family != \'Alpine\'\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T06:32:52.253829102Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17490224267, 'load_duration': 94943633, 'prompt_eval_count': 2605, 'prompt_eval_duration': 1880005922, 'eval_count': 697, 'eval_duration': 15514273735, 'model_name': 'deepseek-r1:14b'} id='run--dbff3ee8-00af-4781-9052-77edf212fa4a-0' usage_metadata={'input_tokens': 2605, 'output_tokens': 697, 'total_tokens': 3302}
