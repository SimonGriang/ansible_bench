---
- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ user.ssh_key_directory }}"
    state: directory
    mode: 0750
  run_once: true
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key

- name: Manage user {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    state: "{{ user.state }}"
    password: "{{ user.password | default('') | ansible_become_password }}"
    ssh_key.pub: "{{ user.ssh_key.pub | default('') }}"
    sudoable: "{{ user.sudoable | default('yes') }}"

- name: Set sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    content: "{{ user.sudo_options | default('') }}"
    mode: 0640
    state: present
  when: user.sudo_options is defined and user.sudo_options != ''
  register: sudo_options_result
  ignore_errors: yes

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudo_options is not defined or user.sudo_options == ''
  ignore_errors: yes

- name: Generate private ssh key for {{ user.name }}
  ansible.posix.ssh_keygen:
    path: "{{ user.ssh_private_key_path }}"
    generate_private_key: true
    create_parent_dirs: true
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Generate public ssh key for {{ user.name }}
  ansible.posix.ssh_keygen:
    path: "{{ user.ssh_public_key_path }}"
    generate_public_key: true
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Convert ssh key to ppk for {{ user.name }}
  ansible.posix.ssh_keygen:
    path: "{{ user.ssh_private_key_path }}"
    convert_to_ssh: true
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Get or set the home directory for {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    home: "{{ user.home_directory | default('/home/{{ user.name }}') }}"
    state: "{{ user.state }}"

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user.home_directory }}/.ssh"
    state: directory
    mode: 0750
  when: user.manage_ssh_key or user.private_keys is defined

- name: Deploy authorized keys for {{ user.name }}
  ansible.builtin.ssh_authorized_key:
