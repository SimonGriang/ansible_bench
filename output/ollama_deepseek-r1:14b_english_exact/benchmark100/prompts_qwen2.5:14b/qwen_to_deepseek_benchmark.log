  yum:
    name: selinux-policy
    state: present

- name: hardening | Set SELinux policy
  setsebool:
    name: targeted
    value: yes
    persist: true

- name: hardening | Enable AppArmor (enforcing)
  apparmor:
    name: /usr/bin/vault
    state: present
    enforce: yes


