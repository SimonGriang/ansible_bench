es to be ready again\n  wait_for:\n    path: /bin/kubectl get nodes --output=json\n    state: ready\n    retries: 100\n    delay: 15\n  delegate_to: "{{ active_server | default(first_server_in_group)}}"\n  become: yes\n\n- name: Wait for all pods to be ready again\n  wait_for:\n    path: /bin/kubectl get pods --all-namespaces --output=json\n    state: running,succeeded\n    retries: 100\n    delay: 15\n  delegate_to: "{{ active_server | default(first_server_in_group)}}"\n  become: yes\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-18T11:29:05.822360384Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11941165856, 'load_duration': 80239743, 'prompt_eval_count': 504, 'prompt_eval_duration': 145467687, 'eval_count': 578, 'eval_duration': 11714299607, 'model_name': 'deepseek-r1:14b'} id='run--bff9e9cb-e890-4e96-ad58-60c45ad91e60-0' usage_metadata={'input_tokens': 504, 'output_tokens': 578, 'total_tokens': 1082}
