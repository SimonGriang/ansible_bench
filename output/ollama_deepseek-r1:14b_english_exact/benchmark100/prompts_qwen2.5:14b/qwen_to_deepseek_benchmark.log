---
- name: Check if Python is installed
  ansible.builtin.command:
    cmd: which python
    args:
      warn: false
    register: python_check
    changed_when: false

- name: Check if Python3 is installed
  ansible.builtin.command:
    cmd: which python3
    args:
      warn: false
    register: python3_check
    changed_when: false

- name: Check if pip is installed
  ansible.builtin.command:
    cmd: which pip
    args:
      warn: false
    register: pip_check
    changed_when: false

- name: Check if pip3 is installed
  ansible.builtin.command:
    cmd: which pip3
    args:
      warn: false
    register: pip3_check
    changed_when: false

- name: Ensure Python3 and pip3 are installed
  ansible.builtin.pip:
    requirements: "{{ openssl_requirements }}"
    state: present
    executable: /usr/bin/python3

- name: Create directories with correct permissions
  ansible.builtin.file:
    path: "{{ key_path }}"
    state: directory
    mode: "{{ key_dir_perms }}"
    owner: "{{ key_dir_owner }}"
    group: "{{ key_dir_group }}"

- name: Create directories with correct permissions
  ansible.builtin.file:
    path: "{{ csr_path }}"
    state: directory
    mode: "{{ csr_dir_perms }}"
    owner: "{{ csr_dir_owner }}"
    group: "{{ csr_dir_group }}"

- name: Create directories with correct permissions
  ansible.builtin.file:
    path: "{{ crt_path }}"
    state: directory
    mode: "{{ crt_dir_perms }}"
    owner: "{{ crt_dir_owner }}"
    group: "{{ crt_dir_group }}"

- name: Include tasks for additional steps
  ansible.builtin.include_tasks:
    file: "{{ openssl_items }}"


