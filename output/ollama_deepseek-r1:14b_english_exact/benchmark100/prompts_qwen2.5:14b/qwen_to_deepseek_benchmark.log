  notify: postfix_reload

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/postfix/aliases
  notify: alias_database

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
  notify: sender_access_database

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
  notify: recipient_access_database

- name: Place sasl_password_map
  template:
    src: sasl_password_map.j2
    dest: /etc/postfix/sasl_password_map
  notify: sasl_password_map_rebuild

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemctl:
    name: postfix
    state: started
    enabled: yes


