:\n    name: "{{ item }}"\n    state: present\n  loop: "{{ rsyslog_features }}"\n\n- name: Configuring default rsyslog\n  ansible.builtin.template:\n    src: default_config.j2\n    dest: /etc/rsyslog.conf\n    owner: root\n    group: root\n    mode: "0644"\n  when: (rsyslog_deploy_default_config | default(true)) | bool\n  notify: restart rsyslog\n\n- name: Make configuration directory\n  ansible.builtin.file:\n    path: /etc/rsyslog.d/\n    state: directory\n    mode: "0755"\n\n- name: Configuring rsyslog forward rule\n  ansible.builtin.template:\n    src: forward_rule.j2\n    dest: /etc/rsyslog.d/forward.conf\n    owner: root\n    group: root\n    mode: "0644"\n  when: (not (rsyslog_deploy_default_config | default(true))) | bool\n  notify: restart rsyslog\n\n- name: Configuring additional config files\n  ansible.builtin.copy:\n    src: "{{ item }}"\n    dest: /etc/rsyslog.d/\n    owner: root\n    group: root\n    mode: "0644"\n  loop: "{{ additional_config_files }}"\n\n- name: Start and enable rsyslog\n  ansible.builtin.service:\n    name: rsyslog\n    state: started\n    enabled: true\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-18T11:49:04.927377535Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17858001460, 'load_duration': 88832658, 'prompt_eval_count': 2131, 'prompt_eval_duration': 1122394279, 'eval_count': 807, 'eval_duration': 16644912621, 'model_name': 'deepseek-r1:14b'} id='run--f3aea31b-6d46-4d74-b977-9f0beb29d302-0' usage_metadata={'input_tokens': 2131, 'output_tokens': 807, 'total_tokens': 2938}
