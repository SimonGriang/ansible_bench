---
- name: Import assert.yml
  import_file:
    file: ./assert.yml
    state: present

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: enabled
    list: module

- name: Install redis
  package:
    name: '{{ redis_packages }}'
    state: present

- name: Configure redis
  template:
    src: redis.conf.j2
    dest: /etc/redis.conf
    mode: 0644
    owner: redis
    group: redis
  notify: restart redis service

- name: Start and enable redis
  service:
    name: '{{ redis_service }}'
    state: started
    enabled: true

