---
- name: Create the RKE2 manifests directory
  file:
    path: /etc/rke2/manifests
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Copy kube-vip files to first server
  copy:
    remote_src: yes
    src: "{{ item }}"
    dest: /etc/rke2/manifests/
    owner: root
    group: root
    mode: 0644
  with_items:
    - "{{ kube_vip_files }}"
  when: kube_vip_files is defined

- name: Copy kube-vip load balancer manifests to first server
  when: cloud_provider.enabled
  block:
    - name: Copy load balancer manifest
      copy:
        remote_src: yes
        src: "{{ load_balancer_files }}"
        dest: /etc/rke2/manifests/
        owner: root
        group: root
        mode: 0644


