---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install dns
  apt:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: "{{ item_perms | default('0755') }}"
    owner: "{{ item_owner | default('root') }}"
    group: "{{ item_group | default('root') }}"
  loop: "{{ dns_directories }}"

- name: Create group
  group:
    name: "{{ dns_group_name }}"
    state: present
    gid: "{{ dns_group_id | default('1000') }}"

- name: Create user
  user:
    name: "{{ dns_user_name }}"
    state: present
    uid: "{{ dns_user_id | default('1000') }}"
    group: "{{ dns_group_name }}"
    shell: /sbin/nologin
    system: yes

- name: Generate rndc key
  rndc_keygen:
    key_name: "{{ rndc_key_name }}"
    directory: "{{ rndc_key_dir }}"

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_dir }}/{{ rndc_key_name }}"
    state: file
    mode: 0640
    owner: "{{ rndc_key_owner | default('root') }}"
    group: "{{ rndc_key_group | default('root') }}"

- name: Get the hints/root file
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ dns_data_dir }}/named.root"
    mode: 0644
    owner: root
    group: root

- name: Create zone file
  template:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: 0644
    owner: root
    group: root
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  template:
    src: "templates/named.conf.j2"
    dest: "/etc/bind/named.conf"
    mode: 0644
    owner: root
    group: root

- name: Place systemd override
  copy:
    src: "{{ item.src }}"
    dest: "/etc/systemd/system/{{ item.dest }}"
    mode: 0644
    owner: root
    group: root
  loop: "{{ systemd_overrides }}"

- name: Start and enable dns
  systemd:
    name: bind9
    state: started
    enabled: yes

