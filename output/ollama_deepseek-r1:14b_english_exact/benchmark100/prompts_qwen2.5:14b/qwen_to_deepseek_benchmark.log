---
- name: Ensure the unzip package is available on the target system
  apt:
    name: unzip
    state: present
  or
  yum:
    name: unzip
    state: present

- name: Create a system group for promtail
  group:
    name: promtail
    state: present
    gid_min: 1

- name: Create the promtail user
  user:
    name: promtail
    group: promtail
    shell: /sbin/nologin
    state: present

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: 0755

- name: Create application directories
  file:
    path: /usr/local/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: 0755

- name: Check if the promtail binary exists
  stat:
    path: /usr/local/bin/promtail

- name: Download promtail binaries
  command: wget {{ promtail_url }}
  when: promtail_url is defined

- name: Propagate locally distributed promtail archive
  command: cp {{ promtail_local_path }} /usr/local/bin/
  when: promtail_local_path is defined

- name: Download promtail binaries to controller node
  command: wget {{ controller_promtail_url }}
  when: controller_promtail_url is defined

- name: Propagate promtail binaries
  command: scp {{ promtail_remote_path }} /usr/local/bin/
  when: promtail_remote_path is defined

- name: Unpack promtail binaries
  unzip:
    file: /usr/local/bin/promtail.zip
    dest: /usr/local/promtail/
    remote_src: yes
    ignore_errors: yes

- name: Create symlink to latest version
  file:
    path: /usr/local/bin/promtail
    state: link
    target: /usr/local/promtail/latest/promtail

- name: Write configuration
  copy:
    remote_src: yes
    src: templates/promtail-config.yml.j2
    dest: /etc/promtail/promtail.yml
    owner: promtail
    group: promtail
    mode: 0644

- name: Create systemd service unit
  copy:
    remote_src: yes
    src: templates/promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: 0644


