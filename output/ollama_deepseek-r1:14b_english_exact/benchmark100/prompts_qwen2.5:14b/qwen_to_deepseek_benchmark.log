---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  ansible.builtin.apt:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  ansible.builtin.apt:
    name: rsyslog
    state: present

- name: Install additional rsyslog packages
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features }}"

- name: Configuring default rsyslog
  ansible.builtin.template:
    src: default_config.j2
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: 644
  when: (rsyslog_deploy_default_config | default(true)) | bool
  notify: restart rsyslog

- name: Make configuration directory
  ansible.builtin.file:
    path: /etc/rsyslog.d/
    state: directory
    mode: 755

- name: Configuring rsyslog forward rule
  ansible.builtin.template:
    src: forward_rule.j2
    dest: /etc/rsyslog.d/forward.conf
    owner: root
    group: root
    mode: 644
  when: (not (rsyslog_deploy_default_config | default(true))) | bool
  notify: restart rsyslog

- name: Configuring additional config files
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/rsyslog.d/
    owner: root
    group: root
    mode: 644
  loop: "{{ additional_config_files }}"

- name: Start and enable rsyslog
  ansible.builtin.service:
    name: rsyslog
    state: started
    enabled: true


