---
- name: Install Keepalived when HA mode is enabled
  apt:
    name: keepalived
    state: present
    update_cache: yes

- name: Download and install RKE2
  block:
    - name: Download RKE2
      get_url:
        url: "https://github.com/rke2-io/rke2/releases/download/v{{ rke2_version }}/rke2-linux-amd64"
        dest: /usr/local/bin/rke2
        mode: '0755'
    - name: Install RKE2
      docker_container:
        name: rke2-installer
        image: docker.io/library/busybox:latest
        command: /usr/local/bin/rke2 install
        state: started
        changed_when: false
        remove_on_absent: yes
  ignore_errors: yes

- name: CIS Hardening
  shell: /path/to/cis Harden script.sh
  when: cis_profile

- name: Find Active Server
  shell: kubectl get nodes -o json | jq -r '.items[].status nodeName'
  register: active_server

- name: Enable IPVS kernel module
  block:
    - name: Add IPVS module
      copy:
        content: "ip_vs\nip_vs_sh"
        dest: /etc/modules.load.d/ipvs.conf
    - name: Load IPVS module
      shell: modprobe ip_vs

- name: Copy kube-vip manifests to the masternode
  copy:
    remote_src: yes
    src: /path/to/kube-vip/manifests/
    dest: /etc/kubernetes/manifests/
    when: not keepalived_enabled

- name: Copy ingress-nginx manifests to the masternode
  copy:
    remote_src: yes
    src: /path/to/ingress-nginx/manifests/
    dest: /etc/kubernetes/manifests/
    when: ingress_config is defined

- name: Prepare and join remaining nodes of the cluster
  docker_container:
    name: rke2-join
    image: docker.io/library/busybox:latest
    command: /usr/local/bin/rke2 join --node-name {{ item }} --kube-token {{ kube_token }} --kube-endpoint {{ active_server }}
    state: started
    changed_when: false
    remove_on_absent: yes
  with_items: "{{ cluster_nodes | default([]) | list }}"

- name: Rolling cordon and drain restart when version changes - servers
  block:
    - name: Cordon node
      shell: kubectl cordon {{ inventory_hostname }}
    - name: Drain node
      shell: kubectl drain {{ inventory_hostname }} --ignore-errors --dry-run=none
    - name: Restart RKE2
      shell: systemctl restart rke2
  when: rke2_version_changed

- name: Rolling cordon and drain restart when version changes - agents
  block:
    - name: Cordon node
      shell: kubectl cordon {{ inventory_hostname }}
    - name: Drain node
      shell: kubectl drain {{ inventory_hostname }} --ignore-errors --dry-run=none
    - name: Restart RKE2
      shell: systemctl restart rke2
  when: rke2_version_changed

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  block:
    - name: Cordon node
      shell: kubectl cordon {{ inventory_hostname }}
    - name: Drain node
      shell: kubectl drain {{ inventory_hostname }} --ignore-errors --dry-run=none
    - name: Restart RKE2
      shell: systemctl restart rke2

- name: Final steps
  command: echo "All tasks completed"


