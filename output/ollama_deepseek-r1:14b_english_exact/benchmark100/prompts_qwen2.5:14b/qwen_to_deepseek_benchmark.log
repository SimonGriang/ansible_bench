  hashicorp.packer.installer:
    repo_type: redhat

- name: Configure debian
  hashicorp.packer.installer:
    repo_type: debian

- name: Install required package gpg
  apt:
    name: gpg
    state: present

- name: Install apt key for Debian
  apt_key:
    keyserver: keyserver.ubuntu.com
    key: 4DE85C5C5B0ACF06
    state: present

