---
- name: Import assert.yml
  shell: ansible_tasks import_tasks assert.yml

- name: Install required packages
  apt:
    name: "{{ service_required_packages }}"
    state: present
  notify: Gather facts

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: /etc/systemd/system/{{ item.name }}.service
    mode: 0755
    loop: "{{ service_list }}"
  notify: Systemctl daemon-reload
  when: ansible_service_manager == 'systemd'

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: /etc/init.d/{{ item.name }}
    mode: 0755
    loop: "{{ service_list }}"
  notify: Systemctl daemon-reload
  when: ansible_service_manager in ['sysvinit', 'upstart', 'openrc']

- name: Manage service
  service:
    name: "{{ item.name }}"
    state: "{{ item.state | default('started') }}"
    enabled: "{{ item.enabled | default('yes') }}"
    loop: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers


