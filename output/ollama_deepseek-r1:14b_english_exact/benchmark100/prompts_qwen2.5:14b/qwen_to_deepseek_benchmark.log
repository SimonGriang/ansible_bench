    - rke2_airgap_copy_additional_tarballs | length > 0
    - rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0700
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == "exists"

