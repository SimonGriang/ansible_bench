---
- name: Ensure /etc/openvpn/easy-rsa directory exists
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Easyrsa init-pki
  command: /etc/openvpn/easy-rsa/easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Build the Certificate Authority (CA)
  command: /etc/openvpn/easy-rsa/easyrsa build-ca
  args:
    chdir: /etc/openvpn/easy-rsa
    ca_common_name: "OpenVPN_CA"
    caOrg: "OpenVPN"
    caLocality: "New York"
    caProvince: "New York"
    caCountry: "US"
  when: "not file('/etc/openvpn/easy-rsa/pki/ca.crt').exists"

- name: Generate Diffie-Hellman parameters
  command: /etc/openvpn/easy-rsa/easyrsa gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  when: "not file('/etc/openvpn/easy-rsa/pki/dh2048.pem').exists"

- name: Build a server certificate and key
  command: /etc/openvpn/easy-rsa/easyrsa build-server-full server nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  when: "not file('/etc/openvpn/easy-rsa/pki/issued/server.crt').exists"

- name: Build a client certificate and key
  command: /etc/openvpn/easy-rsa/easyrsa build-client-full client nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  when: "not file('/etc/openvpn/easy-rsa/pki/issued/client.crt').exists"

- name: Generate a Certificate Revocation List (CRL)
  command: /etc/openvpn/easy-rsa/easyrsa gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  when: "not file('/etc/openvpn/easy-rsa/pki/crl.pem').exists"

- name: Generate a static key for the OpenVPN tunnel
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  when: "not file('/etc/openvpn/easy-rsa/pki/ta.key').exists"

- name: Copy necessary files to /etc/openvpn/server
  copy:
    remote_src: yes
    src: /etc/openvpn/easy-rsa/pki/
    dest: /etc/openvpn/server/
    files:
      - ca.crt
      - crl.pem
      - dh2048.pem
      - server.crt
      - server.key
      - ta.key
      - client.crt
      - client.key
  notify: restart_openvpn

- name: Copy necessary files to /etc/openvpn
  copy:
    remote_src: yes
    src: /etc/openvpn/easy-rsa/pki/
    dest: /etc/openvpn/
    files:
      - ca.crt
      - crl.pem
      - dh2048.pem
      - server.crt
      - server.key
      - ta.key
      - client.crt
      - client.key
  notify: restart_openvpn

- name: Place the server.conf
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
  notify: restart_openvpn


