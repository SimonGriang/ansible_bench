---
- name: Check if Helm binary exists
  shell: which helm
  register: helm_exists
  changed_when: false
  ignore_errors: yes

- name: Check Helm version
  shell: helm version --short
  when: helm_exists.rc == 0
  register: helm_version
  changed_when: false
  ignore_errors: yes

- name: Download helm
  shell: curl -fsSL -o /tmp/helm.tar.gz https://get.helm.sh/helm-{{ helm_version.stdout }}-linux-amd64.tar.gz
  when: (helm_exists.rc != 0) or (helm_version.rc != 0)
  register: helm_download
  changed_when: false
  ignore_errors: yes

- name: Copy helm binary into place
  file:
    path: /usr/local/bin/helm
    state: touch
    owner: root
    group: root
    mode: '0755'
  when: (helm_exists.rc != 0) or (helm_version.rc != 0)

- name: Ensure helm is executable
  shell: chmod +x /usr/local/bin/helm
  when: (helm_exists.rc != 0) or (helm_version.rc != 0)


