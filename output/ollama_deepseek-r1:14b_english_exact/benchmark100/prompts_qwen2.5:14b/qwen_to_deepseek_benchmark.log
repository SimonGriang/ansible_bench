---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
    host: localhost
    run_once: true

- name: Install php
  apt:
    name: "{{ php_packages }}"

- name: Find used php.ini
  shell: php --ini
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location) }}"
  notify: restart httpd


