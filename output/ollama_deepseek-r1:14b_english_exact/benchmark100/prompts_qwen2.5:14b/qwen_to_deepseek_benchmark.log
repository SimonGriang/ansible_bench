---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: tasks/assert.yml

- name: Install mysql
  apt:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  template:
    src: mysql_server.cnj.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: 0644
  vars:
    mysql_server_options: "{{ mysql_server_options }}"

- name: Configure mysql client
  template:
    src: mysql_client.cnj.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: 0644
  vars:
    mysql_client_options: "{{ mysql_client_options }}"

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_distribution | lower in ['alpine', 'archlinux']

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    src: my.cnf
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: 0644

- name: Create databases
  mysql_db:
    name: "{{ db }}"
    state: present
    initial: false
  loop: "{{ mysql_databases }}"

- name: List databases
  mysql_db:
    name: "*"
    state: list

- name: Import database
  mysql_db:
    name: "{{ db }}"
    state: import
    initial: true
    sql_file: "{{ item }}"
  loop: "{{ import_databases }}"

- name: Create users
  mysql_user:
    name: "{{ user.name }}"
    password: "{{ user.password }}"
    priv: "{{ user.privileges }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers
  ansible.builtin.flush_handlers:

- name: Flush handlers again
  ansible.builtin.flush_handlers:

