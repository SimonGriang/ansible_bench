---
- import_tasks: assert.yml

- name: Install mysql
  apt:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  template:
    src: mysql_server.conf.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: 0644
  notify: reload mysql service

- name: Configure mysql client
  template:
    src: mysql_client.conf.j2
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: 0644

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_distribution in ['alpine', 'arch']

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    content: "{{ custom_my_cnf_content }}"
    dest: /etc/mysql/custom_my.cnf
    mode: 0644

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    encoding: utf8
  loop: "{{ mysql_databases | default([]) }}"

- name: List databases
  command: mysql -e "SHOW DATABASES;"
  register: listed_databases

- name: Import database
  command: mysql {{ item.database_name }} < {{ item.sql_file }}
  when: item.import_required | default(false)
  loop: "{{ mysql_databases | default([]) }}"

- name: Create users
  mysql_user:
    name: "{{ item.username }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users | default([]) }}"

- name: Flush handlers
  meta:
    flush_handlers: true

- name: Flush handlers again
  meta:
    flush_handlers: true


