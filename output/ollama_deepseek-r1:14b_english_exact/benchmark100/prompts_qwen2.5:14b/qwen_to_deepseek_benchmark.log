---
- name: Ensure document root directories are created for each virtual host
  file:
    path: "{{ item.document_root }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts | default([]) | list }}"
  when: (item.create_docroot is not defined or item.create_docroot is true) and item.document_root is not none
  ignore_errors: yes

- name: Create virtual host configuration files
  template:
    src: vhost_conf_template
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts | default([]) | list }}"
  notify: 
    - test_apache_configuration
    - restart_apache

- name: Enable virtual hosts on Debian-based systems
  command: a2ensite "{{ item.name }}"
  when: ansible_os_family == 'Debian'
  args:
    creates: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts | default([]) | list }}"
  notify: 
    - test_apache_configuration
    - restart_apache


