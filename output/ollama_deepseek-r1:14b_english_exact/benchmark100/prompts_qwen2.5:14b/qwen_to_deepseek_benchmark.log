---
- name: Import assert.yml
  import_tasks: assert.yml
  when: ansible_hostname == "localhost"

- name: Install apache httpd
  apt:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  become: yes
  block:
    - name: Check if selinux is enabled
      ansible.builtin.shell:
        cmd: /usr/sbin/selinuxenabled
        changed_when: false
      register: selinux_enabled
      ansible_facts:
        selinux_enabled: "{{ansible.builtin.shell.rc == 0}}"

    - name: Set selinux boolean if enabled
      seboolean:
        name: "{{ item }}"
        state: yes
        persist: yes
      with_items:
        - httpd_port_t
        - httpd_anon_write
        - httpd_builtin_scripting
      when: ansible_facts.selinux_enabled

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    owner: root
    group: root
    mode: 0644
  notify: test_config

- name: Activate httpd module | Debian
  shell: a2enmod "{{ item }}"
  with_items: "{{ httpd_modules }}"
  notify: test_config

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ ports_config_src }}"
    dest: "{{ ports_config_dest }}"
    owner: root
    group: root
    mode: 0644
  notify: test_config
  when: ansible_distribution in ['debian', 'suse'] | bool

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_dir }}/example.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: apache2
    state: started
    enabled: yes

