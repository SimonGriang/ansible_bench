  file:
    path: /etc/profile.d/disable_history.sh
    content: |
      export HISTFILE=/dev/null
    mode: 0755
  when: vault_hardening_disable_shell_command_history

- name: hardening | Configure SELinux / AppArmor
  meta: skip
  when: ansible.builtin.no(vault_hardening_configure_selinux_apparmor)

- name: hardening | Enable SELinux
