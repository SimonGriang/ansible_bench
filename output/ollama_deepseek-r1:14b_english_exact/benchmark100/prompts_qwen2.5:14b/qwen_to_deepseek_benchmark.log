---
- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Include OS-specific variables based on distribution
  include_vars:
    file: vars/OS_{{ ansible_distribution | lower }}.yml

- name: Include architecture-specific variables
  include_vars:
    file: vars/architecture.yml

- name: Set OS-specific variables (part I)
  set_fact:
    java_version: "{{ java_version | default('8') }}"
    java_type: "{{ java_type | default('openjdk') }}"

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    java_dist_name: "{{ java_dist_name | default('') }}"
    java_pkg_name: "{{ java_pkg_name | default('') }}"

- name: Set specific variables
  set_fact:
    java_home: "/usr/lib/jvm/java-{{ java_version }}-openjdk11"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: 'http://example.com/debian/repo'
        state: absent
      when: ansible_distribution == "debian"

    - name: Install extra apt tools
      apt:
        name: ['apt-transport-https', 'software-properties-common']
        state: present

    - name: Add key repositories
      apt_key:
        keyserver: keyserver.ubuntu.com
        key: "0000000000000000"

    - name: Add repositories
      apt_repository:
        repo: "deb http://example.com/debian/buster {{ ansible_distribution_release }}"
        state: present
  when: ansible_distribution == "debian"

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      yum:
        name: "https://example.com/rhel/.repo"
        state: present

    - name: Add repositories
      yum:
        name: "https://example.com/rhel/8.repo"
        state: present
  when: ansible_distribution == "redhat"

- name: Install required libraries
  block:
    - name: Include library variables
      include_vars:
        file: vars/libraries.yml

    - name: Install libraries
      apt:
        name: "{{ java_libraries }}"
        state: present
        when: ansible_distribution == "debian"

      yum:
        name: "{{ java_libraries }}"
        state: present
        when: ansible_distribution == "redhat"

- name: Install Java, Debian
  block:
    - name: Update apt cache
      apt:
        cache_valid_time: 3600
        state: present

    - name: Install Java
      apt:
        name: "{{ java_pkg_name }}"
        state: present
        until: "{{ java_pkg_name | version }} >= 11"
        retries: 3
  when: ansible_distribution == "debian"

- name: Install Java, RedHat
  block:
    - name: Update yum cache
      yum:
        cache_valid_time: 3600
        state: present

    - name: Install Java
      yum:
        name: "{{ java_pkg_name }}"
        state: present
        until: "{{ java_pkg_name | version }} >= 11"
        retries: 3
  when: ansible_distribution == "redhat"

- name: Export environment variables
  template:
    src: templates/java_env.sh.j2
    dest: /etc/profile.d/java.sh

- name: Source environment variables
  shell: source /etc/profile.d/java.sh

- name: Correct java version selected for Java versions less than 11
