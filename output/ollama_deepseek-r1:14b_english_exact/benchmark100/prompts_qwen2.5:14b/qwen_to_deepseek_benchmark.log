---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  run_once: true

- name: Install required packages
  apt:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regex: '^GRUB_TIMEOUT=.*$'
    line: 'GRUB_TIMEOUT="{{ grub_timeout }}"'
    validate: true
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regex: '^GRUB_RECORDFAIL_TIMEOUT=.*$'
    line: 'GRUB_RECORDFAIL_TIMEOUT="{{ grub_recordfail_timeout }}"'
    validate: true
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  when: grub_options is defined and grub_options | list
  set_fact:
    grub_cmdline_options: "{{ grub_options | join(',') }}"
  lineinfile:
    path: /etc/default/grub
    regex: '(GRUB_CMDLINE_LINUX=")(.*)("$)'
    line: '\1\2 {{ grub_cmdline_options }}
'
    validate: true
  notify: Update grub

- name: Import password.yml
  import_tasks: password.yml
  when: grub_set_password | default('false') | bool

- name: Flush handlers
  meta: flush_handlers


