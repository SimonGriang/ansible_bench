---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install dns
  ansible.builtin.apt:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: 493  # 0755 in decimal
    owner: "dns"
    group: "dns"
  with_items:
    - /var/named
    - /var/named/run
    - /var/named/etc

- name: Create group
  ansible.builtin.group:
    name: "dns"
    state: present

- name: Create user
  ansible.builtin.user:
    name: "dns"
    state: present
    group: "dns"
    home: "/var/named"
    shell: "/sbin/nologin"

- name: Generate rndc key
  ansible.builtin.command: rndc-confgen -a -f /etc/rndc.key
  changed_when: false

- name: Set permissions on rndc key file
  ansible.builtin.file:
    path: /etc/rndc.key
    owner: "dns"
    group: "dns"
    mode: "640"

- name: Get the hints/root file
  ansible.builtin.get_url:
    url: "https://www.root-nix.org/db.root"
    dest: /var/named/run/db.root
    remote_src: true

- name: Create zone file
  ansible.builtin.template:
    src: zone.j2
    dest: /var/named/run/{{ zone_name }}.zone
    backup: true

- name: Add zones to configuration
  ansible.builtin.template:
    src: named.conf.j2
    dest: /etc/named.conf
    backup: true

- name: Place systemd override
  ansible.builtin.copy:
    src: "{{ playbook_dir }}/files/named.service"
    dest: /etc/systemd/system/named.service
    remote_src: true
    backup: true

- name: Start and enable dns
  ansible.builtin.systemd:
    name: named
    state: started
    enabled: true


