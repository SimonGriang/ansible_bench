uration': 88551777, 'prompt_eval_count': 2116, 'prompt_eval_duration': 13799865, 'eval_count': 1508, 'eval_duration': 34148353898, 'model_name': 'deepseek-r1:14b'} id='run--7be5d88d-fd56-4776-baac-04ca2d88c6b6-0' usage_metadata={'input_tokens': 2116, 'output_tokens': 1508, 'total_tokens': 3624}
