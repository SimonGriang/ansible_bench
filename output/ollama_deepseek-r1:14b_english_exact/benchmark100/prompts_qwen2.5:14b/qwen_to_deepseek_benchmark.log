    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  cron_config:
    name: SHELL
    value: /bin/bash
    mode: '0002'
    notify: restart_cron

- name: Configure path
  cron_config:
    name: PATH
    value: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    mode: '0002'
    notify: restart_cron

