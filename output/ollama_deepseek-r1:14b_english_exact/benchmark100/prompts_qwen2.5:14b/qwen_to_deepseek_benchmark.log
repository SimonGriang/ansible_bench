    template:
      src: "{{ httpd_CONFIG_SRC }}"
      dest: "{{ httpd_CONFIG_DEST }}"
      group: "{{ httpd_CONFIG_GROUP }}"
      mode: "{{ httpd_CONFIG_MODE }}"
    notify: test_and_reload_httpd

  - name: Task 5: Activate httpd module | Debian
