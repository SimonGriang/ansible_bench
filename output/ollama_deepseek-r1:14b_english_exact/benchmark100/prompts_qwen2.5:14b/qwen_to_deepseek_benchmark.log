---
- name: Import assert.yml
  import_tasks: assert.yml
  remote_host: localhost

- name: Install mysql
  apt:
    name: "{{ item }}"
    state: installed
  with_items: "{{ mysql_packages }}"
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    owner: root
    group: root
    mode: 0644
  notify:
    - Restart mysql server

- name: Configure mysql client
  template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    owner: root
    group: root
    mode: 0644

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: mysql_initialize_command is defined

- name: Start and enable mysql
  service:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: 0600

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  with_items: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ user }}"
    db_name: "{{ db_name }}"
    priv: "{{ priv }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
  with_items: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers


