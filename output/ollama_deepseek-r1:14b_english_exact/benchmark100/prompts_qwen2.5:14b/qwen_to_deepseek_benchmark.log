---
- name: Enable proxy modules in Apache
  block:
    - name: Enable proxy module
      ansible.apache.apache_module:
        name: proxy
        state: present
        module: proxy
        os_family: "{{ansible_os_family}}"

    - name: Enable proxy_http module
      ansible.apache.apache_module:
        name: proxy_http
        state: present
        module: proxy_http
        os_family: "{{ansible_os_family}}"

- name: Configure Apache locations using a template
  block:
    - name: Copy Apache configuration template
      template:
        src: "templates/apache_proxy.conf.j2"
        dest: "/etc/apache2/sites-available/apache_proxy.conf"
        mode: 0o644
        os_family: "{{ansible_os_family}}"

    - name: Notify apache_config handler
      ansible.builtin.handler:
        name: apache_config
        path: "/etc/apache2/sites-available/apache_proxy.conf"

    - name: Notify apache_restart handler
      ansible.builtin.handler:
        name: apache_restart


