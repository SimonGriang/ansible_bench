    src: "{{ item }}"
    dest: /etc/rke2/manifests/
    mode: 0o755
  with_items:
    "{{ lookup('ansible.builtin.file', 'files/kube-vip/loadbalancer-*.yaml.j2') | list }}"
  register: kubevip_loadbalancer


