erver\n    shell: kubectl get nodes -owide\n    register: nodes_summary\n    run_once: true\n    when: hostvars[groups['rke2_servers'][0]].ansible_hostname == ansible_hostname\n\n  - name: Display the stdout_lines of the nodes summary\n    debug:\n      var: nodes_summary.stdout_lines\n```" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T08:05:55.157398365Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10977453734, 'load_duration': 101936749, 'prompt_eval_count': 1256, 'prompt_eval_duration': 714015296, 'eval_count': 510, 'eval_duration': 10160260552, 'model_name': 'deepseek-r1:14b'} id='run--d2765d45-24c1-4104-af5c-b60c399fa57d-0' usage_metadata={'input_tokens': 1256, 'output_tokens': 510, 'total_tokens': 1766}
