.yml\n\n- name: Install requirements\n  ansible.builtin.apt:\n    name: bash\n    state: present\n\n- name: Install openjdk java (package)\n  ansible.builtin.apt:\n    name: openjdk\n    state: present\n  when: java_vendor == "openjdk"\n\n- name: Install RPM\n  ansible.legacy.rpm:\n    file: oracle_jdk.rpm\n    state: installed\n  when: ansible_os_family == \'RedHat\'\n\n- name: Install DEB\n  ansible.legacy.dpkg:\n    file: oracle_jdk.deb\n    state: installed\n  when: ansible_os_family == \'Debian\'\n\n- name: Install oracle java (rpm) (repository)\n  ansible.builtin.dnf:\n    name: oracle-java\n    state: present\n  when: ansible_os_family == \'RedHat\'\n\n- name: Configure oracle targz\n  ansible.builtin.file:\n    path: /opt/java\n    state: directory\n\n- name: Install oracle java policy software (targz)\n  ansible.builtin.unarchive:\n    src: oracle_jce_policies.zip\n    dest: /opt/java\n    remote_src: no\n\n- name: Set alternative (targz)\n  community.general.alternatives:\n    name: /opt/java/bin/java\n    path: /usr/bin/java\n    state: present\n  when: ansible_distribution != "Alpine"\n\n- name: Find JAVA_HOME\n  ansible.builtin.command:\n    cmd: readlink -f /usr/bin/java\n    changed_when: false\n  register: java_home\n\n- name: Set JAVA_HOME in /etc/environment\n  ansible.builtin.lineinfile:\n    path: /etc/environment\n    line: JAVA_HOME="{{ java_home.stdout }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T08:56:00.726776234Z', 'done': True, 'done_reason': 'stop', 'total_duration': 20237980276, 'load_duration': 85217000, 'prompt_eval_count': 4317, 'prompt_eval_duration': 3098694458, 'eval_count': 791, 'eval_duration': 17052838779, 'model_name': 'deepseek-r1:14b'} id='run--51a49885-b2e7-4f09-80a6-016f334fb7ac-0' usage_metadata={'input_tokens': 4317, 'output_tokens': 791, 'total_tokens': 5108}
