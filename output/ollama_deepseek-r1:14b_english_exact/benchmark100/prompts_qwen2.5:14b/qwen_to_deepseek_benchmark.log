---
- name: Create ssl key
  community.crypto.openssl_privatekey:
    path: /etc/ssl/private/{{ item }}.key
    type: rsa
    mode: "0640"
    owner: root
    group: root
  loop: "{{ ssl_certs | default([]) }}"

- name: Create ssl csr
  community.crypto.openssl_csr:
    path: /etc/ssl/certs/{{ item }}.csr
    privatekey_path: /etc/ssl/private/{{ item }}.key
    mode: "0644"
    common_name: "{{ item }}"
    owner: root
    group: root
  loop: "{{ ssl_certs | default([]) }}"

- name: Create ssl certificates
  community.crypto.x509_certificate:
    path: /etc/ssl/certs/{{ item }}.crt
    csr_path: /etc/ssl/certs/{{ item }}.csr
    mode: "0644"
    owner: root
    group: root
  loop: "{{ ssl_certs | default([]) }}"

- name: Create PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: /etc/ssl/certs/{{ item }}.p12
    privatekey_path: /etc/ssl/private/{{ item }}.key
    certificate_path: /etc/ssl/certs/{{ item }}.crt
    mode: "0640"
    owner: root
    group: root
    friendly_name: "{{ item }}"
  loop: "{{ ssl_certs | default([]) }}"

- name: Read private key
  community.crypto.openssl_privatekey:
    path: /etc/ssl/private/{{ item }}.key
    content: true
    state: present
  register: private_key
  loop: "{{ ssl_certs | default([]) }}"

- name: Read certificate
  community.crypto.x509_certificate:
    path: /etc/ssl/certs/{{ item }}.crt
    content: true
    state: present
  register: certificate
  loop: "{{ ssl_certs | default([]) }}"

- name: Create combined private_key and certificate file
  ansible.builtin.file:
    path: /etc/ssl/certs/{{ item }}.pem
    mode: "0640"
    owner: root
    group: root
    content: "{{ lookup('file', '/etc/ssl/private/' + item + '.key') | ansible.builtin.trimmed }}{{ '\n' }}{{ lookup('file', '/etc/ssl/certs/' + item + '.crt') | ansible.builtin.trimmed }}"
  loop: "{{ ssl_certs | default([]) }}"


