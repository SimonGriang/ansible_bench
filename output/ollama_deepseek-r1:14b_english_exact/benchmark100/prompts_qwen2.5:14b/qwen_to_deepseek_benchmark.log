---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Configure apk
  become: yes
  apk:
    state: update
    command: upgrade
  notify: reboot

- name: Configure apt
  become: yes
  apt:
    upgrade: yes
    autoremove: yes
    state: present
    exclude_packages: ['nginx']
  notify: reboot

- name: Update all software (dnf)
  become: yes
  dnf:
    state: update
    exclude: ['dnf', 'python3']
  notify: reboot

- name: Update all software (pacman)
  become: yes
  pacman:
    state: update
  notify: reboot

- name: Configure yum
  become: yes
  yum:
    name: "*"
    state: present
    upgrade: yes
  become: yes
  shell: yum install yum-utils
  ignore_errors: yes
  notify: reboot

- name: Update all software (zypper)
  become: yes
  zypper:
    state: update
  notify: reboot


