---
- name: Check current docker-compose version
  command:
    cmd: docker-compose --version
    shell: yes
  register: docker_compose_version

- name: Set fact for current Docker Compose version
  set_fact:
    current_docker_compose_version: "{{ docker_compose_version.stdout }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when:
    - ansible.utils.pyyaml.safe_load("{{ current_docker_compose_version }}") is not defined
    or ansible.utils.pyyaml.safe_load("{{ current_docker_compose_version.stdout }}") != "{{ version }}"

- name: Install Docker Compose (if configured)
  when:
    - ansible_distribution == 'Ubuntu' and (
        ansible_distribution_major_version == '16' or
        ansible_distribution_major_version == '18' or
        ansible_distribution_major_version == '20' or
        ansible_distribution_major_version == '22' or
        ansible_distribution_major_version == '23'
      )
    - ansible_distribution == 'CentOS' and (
        ansible_distribution_major_version == '7' or
        ansible_distribution_major_version == '8'
      )
    - ansible_distribution == 'Fedora' and (
        ansible_distribution_major_version == '27' or
        ansible_distribution_major_version == '28' or
        ansible_distribution_major_version == '29' or
        ansible_distribution_major_version == '30' or
        ansible_distribution_major_version == '31' or
        ansible_distribution_major_version == '32' or
        ansible_distribution_major_version == '33' or
        ansible_distribution_major_version == '34' or
        ansible_distribution_major_version == '35' or
        ansible_distribution_major_version == '36'
      )
  get_url:
    url: https://github.com/docker/compose/releases/download/{{ version }}/docker-compose-{{ ansible_architecture }}
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  notify: install docker compose

- name: Ensure docker-compose is executable
  file:
    path: /usr/local/bin/docker-compose
    mode: '0755'
    state: file
  notify: install docker compose

- name: Install docker compose
  command:
    cmd: /usr/local/bin/docker-compose --version
    shell: yes
  when:
    - ansible_distribution == 'Ubuntu' and (
        ansible_distribution_major_version == '16' or
        ansible_distribution_major_version == '18' or
        ansible_distribution_major_version == '20' or
        ansible_distribution_major_version == '22' or
        ansible_distribution_major_version == '23'
      )
    - ansible_distribution == 'CentOS' and (
        ansible_distribution_major_version == '7' or
        ansible_distribution_major_version == '8'
      )
    - ansible_distribution == 'Fedora' and (
        ansible_distribution_major_version == '27' or
        ansible_distribution_major_version == '28' or
