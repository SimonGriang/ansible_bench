- name: check if all variables have been set correctly
  ansible.builtin.assert:
    msg: "All required variables are set"
    changed_when: false
    failed_when: "{{ansible_inventory_all}} is not defined or empty"

- name: wait for host (when configured)
  ansible.netcommon.wait_for:
    host: "{{ansible_hostname}}"
    port: 22
    state: started
  when: ansible.utils.default("bootstrap_wait_for_host", false)
  ignore_errors: yes

- name: prepare system
  ansible.builtin.shell:
    cmd: "echo preparing system"

- name: include tasks to gather bootstrap facts (raw)
  ansible.builtin.include_tasks:
    file: "{{ bootstrap_facts_raw_tasks }}"

- name: Install bootstrap packages (raw)
  ansible.builtin.raw:
    cmd: "{{ bootstrap_install_raw }}"

- name: ensure system is prepared by issuing ansible modules
  ansible.builtin.include_tasks:
    file: "{{ bootstrap_prepare_system_tasks }}"


