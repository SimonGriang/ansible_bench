vice:\n    name: vsftpd\n    state: started\n    enabled: true" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T05:01:19.055934673Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10480209163, 'load_duration': 95334974, 'prompt_eval_count': 1638, 'prompt_eval_duration': 852353983, 'eval_count': 502, 'eval_duration': 9531519962, 'model_name': 'deepseek-r1:14b'} id='run--d2189479-6f85-48b2-bc52-b8a1410f3485-0' usage_metadata={'input_tokens': 1638, 'output_tokens': 502, 'total_tokens': 2140}
