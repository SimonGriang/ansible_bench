---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install dns
  apt:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "dns"
    group: "dns"
  with_items:
    - /var/named
    - /var/named/run
    - /var/named/etc

- name: Create group
  group:
    name: "dns"
    state: present

- name: Create user
  user:
    name: "dns"
    state: present
    group: "dns"
    home: "/var/named"
    shell: "/sbin/nologin"

- name: Generate rndc key
  command: rndc-confgen -a -f /etc/rndc.key

- name: Set permissions on rndc key file
  file:
    path: /etc/rndc.key
    owner: "dns"
    group: "dns"
    mode: 0640

- name: Get the hints/root file
  get_url:
    url: "https://www.root-nix.org/db.root"
    dest: /var/named/run/db.root

- name: Create zone file
  template:
    src: zone.j2
    dest: /var/named/run/{{ zone_name }}.zone

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named.conf

- name: Place systemd override
  copy:
    src: "{{ playbook_dir }}/files/named.service"
    dest: /etc/systemd/system/named.service

- name: Start and enable dns
  systemd:
    name: named
    state: started
    enabled: yes


