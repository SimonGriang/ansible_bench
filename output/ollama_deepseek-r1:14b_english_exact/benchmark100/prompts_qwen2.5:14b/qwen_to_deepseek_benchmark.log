---

- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ user.ssh_key_directory }}"
    state: directory
    mode: 0750
  run_once: true
  delegate_to: localhost
  become: false
  when: user.manage_ssh_key

- name: Manage user {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    state: "{{ user.state }}"
    password: "{{ user.password | default('') | ansible_ssh_become }}"
    ssh_key.pub: "{{ user.ssh_key.pub | default('') }}"
    sudoable: "{{ user.sudoable | default('true') | bool }}"

- name: Set sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    content: "{{ user.sudo_options | default('') }}"
    mode: 0640
    state: present
  when: (user.sudo_options | default('')) | bool
  register: sudo_options_result
  ignore_errors: yes

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: not (user.sudo_options | default('')) | bool
  ignore_errors: yes

- name: Generate private ssh key for {{ user.name }}
  ansible.posix.ssh_keygen:
    path: "{{ user.ssh_private_key_path }}"
    generate_private_key: true
    create_parent_dirs: true
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Generate public ssh key for {{ user.name }}
  ansible.posix.ssh_keygen:
    path: "{{ user.ssh_public_key_path }}"
    generate_public_key: true
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Convert ssh key to ppk for {{ user.name }}
  ansible.posix.ssh_keygen:
    path: "{{ user.ssh_private_key_path }}"
    convert_to_ssh: true
  when: user.manage_ssh_key
  delegate_to: localhost
  become: false

- name: Get or set the home directory for {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    home: "{{ user.home_directory | default('/home/{{ user.name }}') }}"
    state: "{{ user.state }}"

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user.home_directory }}/.ssh"
    state: directory
    mode: 0750
  when: user.manage_ssh_key or user.private_keys is defined

- name: Deploy authorized keys for {{ user.name }}
  ansible.builtin.ssh_authorized_key:
    name: "{{ user.name }}"
    key: "{{ item.key }}"
    state: present
  loop: "{{ user.authorized_keys | default([]) }}"

- name: Remove unauthorized keys for {{ user.name }}
  ansible.builtin.ssh_authorized_key:
    name: "{{ user.name }}"
    key: "{{ item.key }}"
    state: absent
  loop: "{{ user.unauthorized_keys | default([]) }}"

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    remote_src: true
    src: "{{ user.ssh_private_key_path }}"
    dest: "{{ user.home_directory }}/.ssh/"
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.group | default('users') }}"
  when: user.copy_private_key

- name: Check users password valid time for {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    query_password_policy: true
  register: password_policy_result

- name: Set users password valid time for {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    password_validity_days: "{{ user.password_validity_days | default('365') }}"
  when: user.password_validity_days is defined

- name: Place private key file for {{ user.name }}
  file:
    path: "{{ user.home_directory }}/.ssh/{{ user.ssh_private_key_name }}"
    state: present
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.group | default('users') }}"
  when: user.private_keys is defined

