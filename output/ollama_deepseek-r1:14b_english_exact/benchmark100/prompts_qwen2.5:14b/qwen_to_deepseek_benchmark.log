---
- name: Remove the Docker apt key from the trusted.gpg.d directory
  apt_key:
    key_id: F7627B7B
    state: absent

- name: Remove the old Docker source list file from the sources.list.d directory
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Uninstall any old versions of Docker that may be installed on the system
  apt:
    name: "{{ item }}"
    state: purge
  loop:
    - docker-engine
    - docker.io

- name: Remove the legacy Docker repository file if it exists
  file:
    path: /etc/apt/sources.list.d/docker-legacy.list
    state: absent

- name: Install necessary dependencies for Docker
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Add or remove the Docker repository based on the value of the variable docker_add_repo
  apt_repository:
    repo: "deb [arch=$(dpkg --print-architecture) 2> /dev/null] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable"
    state: "{{ 'present' if docker_add_repo else 'absent' }}"
  notify: apt update cache

- name: Flush handlers to ensure the apt cache is updated immediately
  meta:
    flush_handlers: yes


