---
- name: Populate services facts
  ansible.builtin.systemd_facts:
    state: reloaded

- name: Set the Active Server variable
  ansible.set_fact:
    active_server: "{{ item }}"
  loop: "{{ rke2_cluster_group_name }}"
  when:
