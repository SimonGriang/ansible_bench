---
- name: Import assert.yml
  block:
    - import_tasks: assert.yml

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    state: started
    timeout: "{{ bootstrap_timeout }}"

- name: Prepare system
  block:
    - raw: |- 
        echo 'Checking sudo availability' && sudo whoami || echo 'Sudo not available'
      changed_when: false
    - setup:
        gather_subset: all
      register: bootstrap_facts
    - name: Install necessary packages
      raw: |- 
        echo 'Installing necessary packages'
        yum install -y sudo python3
      when: ansible_python_version
      changed_when: false

- name: Gather ansible facts
  setup:
    gather_subset: all

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes


