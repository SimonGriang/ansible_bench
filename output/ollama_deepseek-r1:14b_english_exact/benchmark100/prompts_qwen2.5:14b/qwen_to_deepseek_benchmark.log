---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  ansible.builtin.file:
    path: /path/to/python3.11/EXTERNALLY-MANAGED
    state: file

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.rename:
    path: /path/to/python3.11/EXTERNALLY-MANAGED
    new_path: /path/to/python3.11/EXTERNALLY-MANAGED.old
    owner: root
    group: root

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  ansible.builtin.file:
    path: /path/to/python3.12/EXTERNALLY-MANAGED
    state: file

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.rename:
    path: /path/to/python3.12/EXTERNALLY-MANAGED
    new_path: /path/to/python3.12/EXTERNALLY-MANAGED.old
    owner: root
    group: root

- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
  args:
    host: localhost

- name: Install python pip
  ansible.builtin.apt:
    name: python3-pip
    state: present

- name: Configure pip proxy
  ansible.builtin.template:
    dest: /etc/pip.conf
    mode: '0644'
    content: |
      proxy = {{ python_pip_proxy }}
    owner: root
    group: root

- name: Trust hosts
  ansible.builtin.template:
    dest: /etc/pip.conf
    mode: '0644'
    content: |
      trusted-host = {{ python_pip_trusted_host }}
    owner: root
    group: root

- name: Update pip
  ansible.builtin.pip:
    name: pip
    state: present
    when:
      - python_pip_update
      - ansible_os_family not in ['Debian', 'Alpine']

- name: Install requested modules
  ansible.builtin.pip:
    requirements: "{{ python_pip_modules }}"
    state: present
    when:
      - ansible_os_family not in ['Debian', 'Alpine']


