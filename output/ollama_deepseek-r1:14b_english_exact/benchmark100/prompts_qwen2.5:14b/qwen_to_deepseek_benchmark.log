- name: Create the RKE2 config directory
  file:
    path: /etc/rke2
    state: directory

- name: Set server taints
  shell: kubectl taint nodes --selector rke2_type=server node-role.kubernetes.io/worker=:NoSchedule
  when: rke2_type == 'server'

- name: Set agent taints
  shell: kubectl taint nodes --selector rke2_type=agent node-role.kubernetes.io/worker=:NoSchedule
  when: rke2_type == 'agent'

- name: Copy RKE2 config file
  copy:
    remote_src: yes
    src: rke2-config.yml
    dest: /etc/rke2/rke2-config.yml
  notify: rke2_config_updated

- name: Copy kubelet config file
  copy:
    remote_src: yes
    src: kubelet-config.yml
    dest: /etc/rke2/kubelet-config.yml
  when: ansible.utilsovich(kubelet_config)
  notify: kubelet_config_updated

- name: Copy Containerd Registry Configuration file
  copy:
    remote_src: yes
    src: containerd-registry.yml
    dest: /etc/rke2/registry.yml
  when: ansible.utilsovich(containerd_registry_config)
  notify: containerd_registry_config_updated

- name: Start RKE2 service
  service:
    name: rke2
    state: started
    restarted: yes
  retries: 5
  delay: 30
  notify: rke2_service_started

- name: Mask other RKE2 services
  service:
    name: "{{ item }}"
    state: stopped
  loop: ['rke2-server', 'rke2-agent']
  when: rke2_type == 'agent' or rke2_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    path: /etc/rke2/no-cni
    state: present
    retries: 10
    delay: 15
  when: not cni_provided

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    path: /etc/rke2/cni-ready
    state: present
    retries: 10
    delay: 15
  when: cni_provided


