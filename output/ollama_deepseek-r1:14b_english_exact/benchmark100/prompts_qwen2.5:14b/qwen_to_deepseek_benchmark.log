  - dh2048.pem\n      - server.crt\n      - server.key\n      - ta.key\n      - client.crt\n      - client.key\n  notify: restart_openvpn\n\n- name: Copy necessary files to /etc/openvpn\n  copy:\n    remote_src: yes\n    src: /etc/openvpn/easy-rsa/pki/\n    dest: /etc/openvpn/\n    files:\n      - ca.crt\n      - crl.pem\n      - dh2048.pem\n      - server.crt\n      - server.key\n      - ta.key\n      - client.crt\n      - client.key\n  notify: restart_openvpn\n\n- name: Place the server.conf\n  template:\n    src: server.conf.j2\n    dest: /etc/openvpn/server.conf\n  notify: restart_openvpn' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-18T09:23:33.176003724Z', 'done': True, 'done_reason': 'stop', 'total_duration': 27870706345, 'load_duration': 99204640, 'prompt_eval_count': 1494, 'prompt_eval_duration': 827367717, 'eval_count': 1211, 'eval_duration': 26942601151, 'model_name': 'deepseek-r1:14b'} id='run--aaf9c95a-674e-4ccd-b0c9-94d3f8dfdd20-0' usage_metadata={'input_tokens': 1494, 'output_tokens': 1211, 'total_tokens': 2705}
