---
- name: Import assert.yml
  import_tasks: files/assert.yml

- name: Install cron
  apt:
    state: installed
    name: "{{ cron_packages }}"

- name: Configure shell
  cron:
    name: shell
    value: "{{ shell_env }}"
    shell: /bin/bash
    file: /etc/crontab
    mode: 0644
    state: present
    notify: restart_cron

- name: Configure path
  cron:
    name: path
    value: "{{ path_env }}"
    shell: /bin/bash
    file: /etc/crontab
    mode: 0644
    state: present
    notify: restart_cron

- name: Configure mailto
  cron:
    name: mailto
    value: "{{ mailto_env }}"
    shell: /bin/bash
    file: /etc/crontab
    mode: 0644
    state: present
    notify: restart_cron

- name: Start and enable cron
  systemd:
    name: cron
    state: started
    enabled: yes
  when:
    cron_service: "{{ cron_service | default(false) }}"

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    schedule: "{{ item.schedule }}"
    state: "{{ item.state }}"
  loop: "{{ cron_jobs }}"



