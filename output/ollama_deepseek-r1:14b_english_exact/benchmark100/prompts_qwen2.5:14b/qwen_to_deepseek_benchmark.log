  apt:
    name: "{{ cron_packages }}"
    state: present

- name: Configure SHELL in cron
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "SHELL={{ cron_shell }}"
    state: present
    mode: 0600
  notify: Restart cron

- name: Configure PATH in cron
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "PATH={{ cron_path }}"
    state: present
    mode: 0600
  notify: Restart cron

- name: Configure MAILTO in cron
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "MAILTO={{ cron_mailto }}"
    state: present
    mode: 0600
  notify: Restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    enabled: yes
    state: started
  when: cron_service is defined and cron_service != ""

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    schedule: "{{ item.schedule }}"
    command: "{{ item.command }}"
    state: present
  loop: "{{ cron_jobs }}"
