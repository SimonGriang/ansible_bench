k with \'---\' followed by the tasks.\n\nI think that\'s all. Now, I\'ll format it correctly, ensuring proper indentation and YAML syntax.\n</think>\n\n```yaml\n---\n- name: Restart RKE2 service on {{ rke2_node_name }}\n  ansible.builtin.systemd:\n    name: "{{ rke2_service_name }}"\n    state: restarted\n    dequeued_by: "{{ rke2_node_name }}"\n\n- name: Wait for all nodes to be ready again\n  ansible.kubernetes.core.kubernetes:\n    command: get nodes --output json\n    until: "{{ item.status.phase == \'Ready\' | json_query }}"\n    retries: 100\n    delay: 15\n    delegate_to: "{{ active_server if active_server is defined else (groups[rke2_servers_group_name][0] if rke2_servers_group_name in groups else \'localhost\') }}"\n    run_once: yes\n    check_mode: yes\n\n- name: Wait for all pods to be ready again\n  ansible.kubernetes.core.kubernetes:\n    command: get pods --output json\n    until: "{{ item.status.phase in [\'Running\', \'Succeeded\'] | json_query }}"\n    retries: 100\n    delay: 15\n    delegate_to: "{{ active_server if active_server is defined else (groups[rke2_servers_group_name][0] if rke2_servers_group_name in groups else \'localhost\') }}"\n    run_once: yes\n    check_mode: yes\n    when: rke2_wait_for_all_pods_to_be_ready\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T08:18:34.783358056Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13780103847, 'load_duration': 2581596443, 'prompt_eval_count': 502, 'prompt_eval_duration': 329515729, 'eval_count': 784, 'eval_duration': 10868270175, 'model_name': 'deepseek-r1:14b'} id='run--e5c419a1-f4a4-4494-90b1-cb8a970d3f34-0' usage_metadata={'input_tokens': 502, 'output_tokens': 784, 'total_tokens': 1286}
