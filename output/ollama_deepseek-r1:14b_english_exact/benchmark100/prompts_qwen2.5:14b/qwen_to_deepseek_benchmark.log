---
- name: Check if python is installed
  command: which python
  args:
    warn: false
  failed_when: "{{ansible_facts.command.python|failed|bool}}"

- name: Check if python3 is installed
  command: which python3
  args:
    warn: false
  failed_when: "{{ansible_facts.command.python3|failed|bool}}"

- name: Debug Python executable path
  command: which python
  args:
    warn: false
  register: python_executable

- name: Debug Python3 executable path
  command: which python3
  args:
    warn: false
  register: python3_executable

- name: Import assert.yml
  include_tasks: assert.yml

- name: Install requirements
  pip:
    requirements: "{{openssl_requirements}}"

- name: Ensure packaging is available via dnf
  dnf:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    packages: "{{openssl_pip_packages}}"

- name: Create key directory
  file:
    path: "{{key_path}}"
    state: directory
    mode: "{{key_dir_perms}}"
    owner: "{{key_dir_owner}}"

- name: Create csr directory
  file:
    path: "{{csr_path}}"
    state: directory
    mode: "{{csr_dir_perms}}"
    owner: "{{csr_dir_owner}}"

- name: Create crt directory
  file:
    path: "{{crt_path}}"
    state: directory
    mode: "{{crt_dir_perms}}"
    owner: "{{crt_dir_owner}}"

- name: Include create.yml
  include_tasks: create.yml
  vars:
    items: "{{openssl_items}}"


