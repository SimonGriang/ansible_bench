---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints | default('') }}"
  when: server_type == 'server'

- name: Copy RKE2 configuration file
  template:
    src: config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
  notify: Config file changed

- name: Copy kubelet configuration file
  template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
  notify: Config file changed
  when: rke2_kubelet_config is not empty

- name: Copy Containerd Registry Configuration file
  template:
    src: registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
  notify: Config file changed
  when: rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is not empty and (rke2_server.service_state | default('')) == 'disabled' or (rke2_server.service_name | default('')) == 'undefined' }}"

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file is not empty and (rke2_etcd_snapshot_s3_options | default({}).get('access_key') is not none and rke2_etcd_snapshot_s3_options | default({}).get('secret_key') is not none and rke2_etcd_snapshot_s3_options | default({}).get('bucket') is not none and rke2_etcd_snapshot_s3_options | default({}).get('snapshot_name') is not none) }}"

- name: Restore etcd from file
  when: do_etcd_restore | default(False)
  become: true
  shell: |
    mkdir -p /var/lib/rancher/etcd/snapshots
    cp /etc/rancher/rke2/etcd_snapshot /var/lib/rancher/etcd/snapshots/
    /usr/bin/etcdctl --endpoints=http://localhost:2379 --cert=/etc/rancher/rke2/etcd/healthcheck-client.crt --key=/etc/rancher/rke2/etcd/healthcheck-client.key --ca=/etc/rancher/rke2/etcd/etcd-ca.crt snapshot restore /var/lib/rancher/etcd/snapshots/etcd_snapshot

- name: Restore etcd from s3
  when: do_etcd_restore_from_s3 | default(False)
  become: true
  shell: |
    mkdir -p /var/lib/rancher/etcd/snapshots
    s3cmd --access_key="{{ rke2_etcd_snapshot_s3_options.access_key }}" --secret_key="{{ rke2_etcd_snapshot_s3_options.secret_key }}" --bucket="{{ rke2_etcd_snapshot_s3_options.bucket }}" get "{{ rke2_etcd_snapshot_s3_options.snapshot_name }}" /var/lib/rancher/etcd/snapshots/
    /usr/bin/etcdctl --endpoints=http://localhost:2379 --cert=/etc/rancher/rke2/etcd/healthcheck-client.crt --key=/etc/rancher/rke2/etcd/healthcheck-client.key --ca=/etc/rancher/rke2/etcd/etcd-ca.crt snapshot restore /var/lib/rancher/etcd/snapshots/$(basename {{ rke2_etcd_snapshot_s3_options.snapshot_name }})

- name: Start RKE2 service on the first server
  become: true
  shell: systemctl start rke2-server && systemctl enable rke2-server
  when: inventory_hostname == groups.rke2_cluster_group_name[0]

- name: Mask RKE2 agent service on the first server
  become: true
  shell: systemctl disable rke2-agent && systemctl mask rke2-agent
  when: inventory_hostname == groups.rke2_cluster_group_name[0]

- name: Wait for the first server be ready - no CNI
  become: true
  shell: /usr/bin/kubectl wait --namespace=kube-system --timeout=300s --for=condition=Ready pods -l k8s-app=containerd --all
  when: not rke2_cni_provider

- name: Wait for the first server be ready - with CNI
  become: true
  shell: /usr/bin/kubectl wait --namespace=kube-system --timeout=300s --for=condition=Ready pods -l k8s-app=containerd --all
  when: rke2_cni_provider

- name: Restore etcd
  become: true
  shell: /usr/bin/kubectl get nodes -o json | jq -r '.items[].metadata.name' | xargs /usr/bin/kubectl delete node --ignore-not-found && /usr/bin/kubectl delete secret -n kube-system bootstrap-token* --all
  when: do_etcd_restore or do_etcd_restore_from_s3

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"


