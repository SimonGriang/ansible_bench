---
- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == "adoptopenjdk"

- name: Include OS-specific variables based on distribution
  include_vars:
    file: "vars/{{ ansible_distribution|lower() }}.yml"

- name: Include architecture-specific variables
  set_fact:
    java_architecture: "{{ ansible_architecture | default('x86_64') }}"

- name: Set OS-specific variables (part I)
  set_fact:
    java_os_distribution: "{{ ansible_distribution | default('unknown') }}"
  when: ansible_distribution is defined

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    java_distribution_architecture: "{{ java_os_distribution }}-{{ java_architecture }}"
  when: java_os_distribution is defined and java_architecture is defined

- name: Set specific variables
  set_fact:
    java_home: "/usr/lib/jvm/{{ java_jdk_vendor }}-jdk-{{ java_version }}-{{ java_distribution_architecture }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt:
        name: "{{ item }}"
        state: absent
      with_items: "{{ java_distribution_repositories | default([]) }}"

    - name: Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
      with_items: "{{ java_distribution_apt_tools | default([]) }}"

    - name: Add key repositories
      apt_key:
        keyserver: "{{ item.keyserver }}"
        key: "{{ item.key }}"
        state: present
      with_items: "{{ java_distribution_keys | default([]) }}"

    - name: Add repositories
      apt_repository:
        repo: "{{ item.repo }}"
        state: present
      with_items: "{{ java_distribution_repositories | default([]) }}"

  when: ansible_distribution == "Debian"

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      yum:
        name: "{{ item.repo }}"
        state: present
      with_items: "{{ java_distribution_keys_rh | default([]) }}"

    - name: Add repositories
      yum:
        name: "{{ item.repo }}"
        state: present
      with_items: "{{ java_distribution_repositories_rh | default([]) }}"

  when: ansible_distribution == "RedHat"

- name: Install required libraries
  block:
    - name: Update package cache
      apt:
        cache_valid_time: 3600
        state: present
      when: ansible_distribution == "Debian"

    - name: Install required packages
      apt:
        name: "{{ item }}"
        state: present
      with_items: "{{ java_distribution_packages | default([]) }}"

    - name: Update package cache
      yum:
        cache_valid_time: 3600
        state: present
      when: ansible_distribution == "RedHat"

    - name: Install required packages
      yum:
        name: "{{ item }}"
        state: present
      with_items: "{{ java_distribution_packages_rh | default([]) }}"

- name: Install Java, Debian
  block:
    - name: Update package cache
      apt:
        cache_valid_time: 3600
        state: present

    - name: Install Java package
      apt:
        name: "{{ java_jdk_package }}"
        state: present
        update_cache: yes

    - name: Check package installation status
      apt:
        name: "{{ java_jdk_package }}"
        state: present
        update_cache: yes
  when: ansible_distribution == "Debian"

- name: Install Java, RedHat
  block:
    - name: Update package cache
      yum:
        cache_valid_time: 3600
        state: present

    - name: Install Java package
      yum:
        name: "{{ java_jdk_package_rh }}"
        state: present

    - name: Check package installation status
      yum:
        name: "{{ java_jdk_package_rh }}"
        state: present
  when: ansible_distribution == "RedHat"

- name: Export environment variables
  template:
    dest: /etc/profile.d/java.sh
    mode: 0755
    template: "{{ lookup('template', 'templates/java.sh.j2') }}"

- name: Source environment variables
  shell: source /etc/profile.d/java.sh

- name: Correct java version selected for Java versions less than 11
  command: update-alternatives --config java
  when: (java_version|int < 11) and (ansible_distribution == "Debian")

- name: Correct java version selected for Java versions greater than or equal to 11
  command: update-alternatives --config java
  when: (java_version|int >= 11) and (ansible_distribution == "Debian")


