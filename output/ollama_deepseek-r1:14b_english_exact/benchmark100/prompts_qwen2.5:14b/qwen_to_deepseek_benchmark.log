- name: Ensure old versions of Docker are not installed
  apt:
    name: "{{ item }}"
    state: absent
    purge: old
  loop:
    - docker-engine
    - docker-ce
    - docker.io

- name: Add Docker GPG key
  apt_key:
    keyserver: apt.keys.openstack.org
    key: 9FD3B16DB430E921
    state: present

- name: Add Docker repository
  file:
    path: /etc/apt/sources.list.d/docker.list
    content: "deb [arch=$(dpkg --print-architecture) 2>/dev/null] https://download.docker.com/linux/ubuntu focal stable\n"
    state: present

- name: Configure Docker Nightly repo
  apt_repository:
    repo: "deb [arch=$(dpkg --print-architecture) 2>/dev/null] https://download.docker.com/linux/ubuntu focal nightly"
    state: present

- name: Configure Docker Test repo
  apt_repository:
    repo: "deb [arch=$(dpkg --print-architecture) 2>/dev/null] https://download.docker.com/linux/ubuntu focal test"
    state: present

- name: Configure containerd on RHEL 8
  package:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
  loop:
    - { name: runc, state: absent }
    - { name: container-selinux, state: present }
    - { name: containerd.io, state: present }


