---
- name: Create directories for HTTPD
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: "0755"
  loop: "{{ httpd_directories }}"

- name: Configure HTTPD directories
  ansible.builtin.template:
    src: directory.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item }}/directory.conf"
    mode: "0644"
  loop: "{{ httpd_directories }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd


