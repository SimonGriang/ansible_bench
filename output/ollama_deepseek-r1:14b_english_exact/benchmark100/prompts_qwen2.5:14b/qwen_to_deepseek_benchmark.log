  shell: "{{ rke2_install_script_path }}/rke2-install {{ rke2_install_flags }}"
  when:
    - rke2_installed_version is not defined or rke2_installed_version != rke2_running_version
    - not ansible_check_mode

- name: Copy Custom Manifests
  copy:
    src: "{{ rke2_custom_manifests_path }}/"
    dest: "{{ rke2_manifests_path }}"
    when: rke2_custom_manifests_path is defined and rke2_custom_manifests_path != ""

- name: Copy Static Pods
  copy:
    src: "{{ rke2_static_pods_path }}/"
    dest: "{{ rke2_static_pods_path_remote }}"
    when: rke2_static_pods_path is defined and rke2_static_pods_path != ""

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file_path }}"
    dest: "/etc/rke2.env"
    when: rke2_env_file_path is defined and rke2_env_file_path != ""


