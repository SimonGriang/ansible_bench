---
- name: Create ssl key
  openssl_privatekey:
    path: "{{ ssl_key_path }}/{{ item.key }}"
    provider: rsa
    size: 2048
  register: ssl_key_result
  when: item.key is defined
  loop:
    - { key: 'server1' }
    - { key: 'server2' }

- name: Set permissions for private key
  file:
    path: "{{ ssl_key_path }}/{{ item.key }}"
    mode: 0604
    owner: root
    group: root
  when: item.key is defined
  loop:
    - { key: 'server1' }
    - { key: 'server2' }

- name: Create ssl csr
  openssl_csr:
    path: "{{ ssl_csr_path }}/{{ item.key }}.csr"
    privatekey_path: "{{ ssl_key_path }}/{{ item.key }}"
    common_name: "{{ item.cn }}"
    subject_alt_names: ['DNS:{{ item.key }}']
  register: ssl_csr_result
  when: item.key is defined
  loop:
    - { key: 'server1', cn: 'Server1' }
    - { key: 'server2', cn: 'Server2' }

- name: Set permissions for csr
  file:
    path: "{{ ssl_csr_path }}/{{ item.key }}.csr"
    mode: 0604
    owner: root
    group: root
  when: item.key is defined
  loop:
    - { key: 'server1' }
    - { key: 'server2' }

- name: Create ssl certificates
  openssl_certificate:
    path: "{{ ssl_cert_path }}/{{ item.key }}.crt"
    csr_path: "{{ ssl_csr_path }}/{{ item.key }}.csr"
    privatekey_path: "{{ ssl_key_path }}/{{ item.key }}"
    signing.cert: /path/to/ca/cert.pem
    signing.key: /path/to/ca/key.pem
    signing.algorithm: sha256
  register: ssl_cert_result
  when: item.key is defined
  loop:
    - { key: 'server1' }
    - { key: 'server2' }

- name: Set permissions for certificate
  file:
    path: "{{ ssl_cert_path }}/{{ item.key }}.crt"
    mode: 0604
    owner: root
    group: root
  when: item.key is defined
  loop:
    - { key: 'server1' }
    - { key: 'server2' }

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ pkcs12_path }}/{{ item.key }}.p12"
    privatekey_path: "{{ ssl_key_path }}/{{ item.key }}"
    cert: "{{ ssl_cert_path }}/{{ item.key }}.crt"
    passphrase: "ChangeMe"
  register: pkcs12_result
  when: item.key is defined
  loop:
    - { key: 'server1' }
    - { key: 'server2' }

- name: Set permissions for pkcs12 file
  file:
    path: "{{ pkcs12_path }}/{{ item.key }}.p12"
    mode: 0700
    owner: root
    group: root
  when: item.key is defined
  loop:
    - { key: 'server1' }
    - { key: 'server2' }

- name: Read private key
  slurm:
    path: "{{ ssl_key_path }}/{{ item.key }}"
    read: yes
  register: private_key_content
  when: item.key is defined
  loop:
    - { key: 'server1' }
    - { key: 'server2' }

- name: Read certificate
  slurm:
    path: "{{ ssl_cert_path }}/{{ item.key }}.crt"
    read: yes
  register: certificate_content
  when: item.key is defined
  loop:
    - { key: 'server1' }
    - { key: 'server2' }

- name: Create combined private_key and certificate file
  file:
    path: "{{ combined_path }}/{{ item.key }}.pem"
    content: "{{ item.private_key_content }}\n{{ item.certificate_content }}"
    mode: 0604
    owner: root
    group: root
  when: item.key is defined
  loop:
    - { key: 'server1', private_key_content: "{{ private_key_content['server1'] | base64_encode }}", certificate_content: "{{ certificate_content['server1'] | base64_encode }}" }
    - { key: 'server2', private_key_content: "{{ private_key_content['server2'] | base64_encode }}", certificate_content: "{{ certificate_content['server2'] | base64_encode }}" }


