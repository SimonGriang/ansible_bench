---
- name: Import assert.yml
  import_tasks: assert.yml
  host: localhost

- name: Install logrotate
  apt:
    name: "{{ logrotate_packages }}"
    state: present
  hosts: all

- name: Configure logrotate
  template:
    src: "{{ logrotate_config_file.j2 }}"
    dest: "{{ logrotate_config_directory }}"
  hosts: all

- name: Generate logrotate.d files
  file:
    path: "{{ item.path }}"
    state: present
    content: "{{ logrotate_config_content | default('') }}"
  loop: "{{ logrotate_entries | default([]) if (item.state is not defined or item.state != 'absent') | list }}"
  hosts: all

- name: Remove logrotate.d files
  file:
    path: "{{ item.path }}"
    state: absent
  loop: "{{ logrotate_entries | default([]) if (item.state is defined and item.state == 'absent') | list }}"
  hosts: all

