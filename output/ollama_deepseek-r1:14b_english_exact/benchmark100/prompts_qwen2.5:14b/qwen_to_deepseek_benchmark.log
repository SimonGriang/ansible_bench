---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install openvpn packages
  apt:
    name: "{{ openvpn_packages }}"
    state: present

- name: Setup openvpn server or client
  block:
    - name: Configure openvpn server
      include_tasks: server.yml
      when: openvpn_role == 'server'
    - name: Configure openvpn client
      include_tasks: client.yml
      when: openvpn_role == 'client'
    - name: Error if invalid role
      fail:
        msg: "Invalid openvpn_role value '{{ openvpn_role }}'." 
             "Must be 'server' or 'client'"
        when: openvpn_role not in ['server', 'client']

- name: Start and enable openvpn
  service:
    name: openvpn
    state: started
    enabled: "{{ openvpn_service }}"


