    - name: Manage selinux booleans
      loop: "{{ selinux_booleans }}"
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: yes
        value: "{{ item.value }}"
      when: selinux_enabled

