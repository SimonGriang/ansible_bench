s. Each task should be correctly indented and follow YAML syntax.\n\nLet me proceed to write each task as per the above reasoning.\n</think>\n\n```yaml\n---\n- import_tasks: assert.yml\n\n- name: Install requirements\n  apt:\n    name: bash\n    state: present\n\n- name: Install openjdk java (package)\n  apt:\n    name: openjdk\n    state: present\n  when: java_vendor == "openjdk"\n\n- name: Install RPM\n  rpm:\n    file: oracle_jdk.rpm\n    state: installed\n  when: ansible_os_family == \'RedHat\'\n\n- name: Install DEB\n  dpkg:\n    file: oracle_jdk.deb\n    state: installed\n  when: ansible_os_family == \'Debian\'\n\n- name: Install oracle java (rpm) (repository)\n  yum:\n    name: oracle-java\n    state: present\n  when: ansible_os_family == \'RedHat\'\n\n- name: Configure oracle targz\n  file:\n    path: /opt/java\n    state: directory\n    create: yes\n\n- name: Install oracle java policy software (targz)\n  command: unzip oracle_jce_policies.zip -d /opt/java\n  when: java_version == "8"\n\n- name: Set alternative (targz)\n  alternatives:\n    name: /opt/java/bin/java\n    path: /usr/bin/java\n    state: present\n  when: ansible_distribution != \'Alpine\'\n\n- name: Find JAVA_HOME\n  command: readlink -f /usr/bin/java\n  register: java_home\n  changed_when: false\n\n- name: Set JAVA_HOME in /etc/environment\n  lineinfile:\n    path: /etc/environment\n    line: JAVA_HOME="{{ java_home.stdout }}"\n    state: present\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T08:52:51.614371512Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14421925967, 'load_duration': 89541753, 'prompt_eval_count': 536, 'prompt_eval_duration': 253274514, 'eval_count': 818, 'eval_duration': 14077610023, 'model_name': 'deepseek-r1:14b'} id='run--cbdf87f5-47d4-445d-b1b0-7b64459ef92a-0' usage_metadata={'input_tokens': 536, 'output_tokens': 818, 'total_tokens': 1354}
