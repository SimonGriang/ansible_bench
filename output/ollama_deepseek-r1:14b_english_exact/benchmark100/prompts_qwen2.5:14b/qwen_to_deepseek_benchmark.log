---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints | default([]) + (rke2_node_taints | default([])) | unique | join(',') }}"
  when:
    server_type == 'server'

- name: Copy RKE2 configuration file
  template:
    src: config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
  notify: Config file changed

- name: Copy kubelet configuration file
  template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
  when:
    rke2_kubelet_config is not empty
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  template:
    src: registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
  when:
    rke2_custom_registry_mirrors is not empty or rke2_custom_registry_configs is not empty
  notify: Config file changed

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is not empty and (rke2_server.service_state | default('stopped') == 'disabled' or rke2_server.service_state is undefined) }}"
  when:
    rke2_etcd_snapshot_file is not empty

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ rke2_etcd_snapshot_file is not empty and (rke2_etcd_snapshot_s3_options | keys) | list | all() }}"

- name: Restore etcd from file
  when: do_etcd_restore | default(false)
  become: true
  shell: |
    mkdir -p /var/lib/rke2/etcd/snapshots
    cp /etc/rancher/rke2/etcd/{{ rke2_etcd_snapshot_file }} /var/lib/rke2/etcd/snapshots/
    rke2 CLI etcd restore /var/lib/rke2/etcd/snapshots/{{ rke2_etcd_snapshot_file }}

- name: Restore etcd from s3
  when: do_etcd_restore_from_s3 | default(false)
  become: true
  shell: |
    s3cmd --access_key="{{ rke2_etcd_snapshot_s3_options.access_key }}"
          --secret_key="{{ rke2_etcd_snapshot_s3_options.secret_key }}"
          --bucket="{{ rke2_etcd_snapshot_s3_options.bucket }}"
          download "{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
    mv /tmp/{{ rke2_etcd_snapshot_s3_options.snapshot_name }}
          /var/lib/rke2/etcd/snapshots/
    rke2 CLI etcd restore /var/lib/rke2/etcd/snapshots/{{ rke2_etcd_snapshot_s3_options.snapshot_name }}

- name: Start RKE2 service on the first server
  become: true
  service:
    name: rke2-server.service
    state: started
    enabled: yes
  environment:
    RKE2_TOKEN: "{{ rke2_token | default('') }}"

- name: Mask RKE2 agent service on the first server
  become: true
  shell: systemctl disable --mask rke2-agent.service

- name: Wait for the first server be ready - no CNI
  wait_for_node:
    host: "{{ rke2_server_nodes[0] | default('') }}"
    status: ready
    cni: false

- name: Wait for the first server be ready - with CNI
  wait_for_node:
    host: "{{ rke2_server_nodes[0] | default('') }}"
    status: ready
    cni: true

- name: Restore etcd
  become: true
  shell: |
    rke2 CLI cluster get-nodes
    rke2 CLI cluster remove-node --name="{{ item }}" --force
  with_items: "{{ rke2_etcd_nodes | default([]) }}"
  when: (do_etcd_restore or do_etcd_restore_from_s3) | default(false)

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: server_type == 'server'

