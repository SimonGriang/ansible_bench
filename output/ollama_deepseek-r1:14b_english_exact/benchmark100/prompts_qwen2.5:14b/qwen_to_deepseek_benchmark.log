    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf "
    group: "www-data"
    mode: "0644"
  loop: "{{ httpd_vhosts | default([]) }}"

- name: Test httpd configuration and restart service
  command: apache2configtest
    chdir: "/etc/apache2"
  register: httpd_test
  ignore_errors: yes

- name: Restart httpd service
  service:
    name: httpd
    state: restarted
  when: httpd_test | succeeded


