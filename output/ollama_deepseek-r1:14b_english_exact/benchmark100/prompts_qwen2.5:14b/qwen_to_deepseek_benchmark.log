---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  changed_when: false
  static: true

- name: Install python pip
  apt:
    name: "{{ name }}"
    state: present

- name: Configure pip proxy
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
  when: python_pip_proxy is defined

- name: Trust hosts
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
  when: python_pip_trusted_host is defined

- name: Update pip
  apt:
    update_cache: yes
  when:
    - python_pip_update | bool
    - distribution_release != "bookworm"
    - distribution_release != "noble"
    - ansible_os_family != "Alpine"

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default('latest') }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ python_pip_modules | default([]) }}"
  when:
    - python_pip_update | bool
    - distribution_release != "bookworm"
    - distribution_release != "noble"
    - ansible_os_family != "Alpine"

