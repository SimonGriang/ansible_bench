---
- name: Restore etcd - get all nodes
  shell: kubectl get nodes -o custom-columns=NAME:.metadata.name --no-headers
  register: etcd_nodes
  changed_when: false

- name: Restore etcd - remove old nodes
  shell: kubectl delete node {{ item }} --ignore-not-found --grace-period=0 --now
  loop: "{{ etcd_nodes.stdout_lines }}"
  when: item not in group_names
  changed_when: false


