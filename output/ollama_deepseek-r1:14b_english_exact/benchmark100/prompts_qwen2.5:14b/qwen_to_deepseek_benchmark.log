all requirements\n  ansible.builtin.apt:\n    name: bash\n    state: present\n\n- name: Install openjdk java (package)\n  ansible.builtin.apt:\n    name: openjdk\n    state: present\n  when: java_vendor == "openjdk"\n\n- name: Install RPM\n  ansible.builtin.rpm:\n    file: /path/to/oracle-jdk.rpm\n    state: present\n\n- name: Install DEB\n  ansible.builtin.apt:\n    deb: /path/to/oracle-jdk.deb\n    state: present\n\n- name: Install oracle java (rpm) (repository)\n  ansible.builtin.apt:\n    name: oracle-java\n    state: present\n\n- name: Configure oracle targz (unzip)\n  community.general.unzip:\n    file: /path/to/oracle-jdk.tgz\n    dest: /usr/local/java\n\n- name: Ensure java directory exists\n  ansible.builtin.file:\n    path: /usr/local/java\n    state: directory\n    mode: 0755\n\n- name: Install oracle java policy software (targz)\n  ansible.builtin.apt:\n    name: oracle-java-jce\n    state: present\n\n- name: Set alternative (targz)\n  ansible.legacy.alternative:\n    name: java\n    path: /usr/local/java/bin/java\n    state: present\n  when: ansible_distribution != "Alpine"\n\n- name: Find JAVA_HOME\n  ansible.builtin.command:\n    cmd: readlink -f /usr/bin/java\n    register: java_home\n    changed_when: false\n\n- name: Set JAVA_HOME in /etc/environment\n  ansible.builtin.lineinfile:\n    path: /etc/environment\n    line: JAVA_HOME="{{ java_home.stdout }}"\n    state: present\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-18T12:02:00.158514476Z', 'done': True, 'done_reason': 'stop', 'total_duration': 19910721033, 'load_duration': 88604100, 'prompt_eval_count': 3300, 'prompt_eval_duration': 2089039712, 'eval_count': 812, 'eval_duration': 17731722183, 'model_name': 'deepseek-r1:14b'} id='run--a8b1796a-fc5e-4f72-bc5b-fa6342ac1036-0' usage_metadata={'input_tokens': 3300, 'output_tokens': 812, 'total_tokens': 4112}
