- name: Create directories
  block:
    - name: Create directory
      file:
        path: "{{ item }}"
        state: directory
        mode: '0755'
      loop: "{{ httpd_directories }}"

- name: Configure directories
  block:
    - name: Configure directory
      template:
        src: directory.conf.j2
        dest: "{{ item }}"
        mode: '0644'
      loop: "{{ httpd_directories }}"
    - name: Test httpd configuration
      command: apache2ctl configtest
      changed_when: false
    - name: Restart httpd service
      service:
        name: httpd
        state: restarted
        enable: yes
        display_name: Apache Web Server
      register: httpd_status
    - name: Ensure httpd status is green
      assert:
        that:
          - httpd_status.status == 0


