    mode: "{{ csr_dir_perms }}"
    owner: "{{ csr_dir_owner }}"
    group: "{{ csr_dir_group }}"

- name: Create directories with correct permissions
  ansible.builtin.file:
    path: "{{ crt_path }}"
    state: directory
    mode: "{{ crt_dir_perms }}"
    owner: "{{ crt_dir_owner }}"
    group: "{{ crt_dir_group }}"

- name: Include tasks for additional steps
  ansible.builtin.include_tasks:
    file: "{{ openssl_items }}"


