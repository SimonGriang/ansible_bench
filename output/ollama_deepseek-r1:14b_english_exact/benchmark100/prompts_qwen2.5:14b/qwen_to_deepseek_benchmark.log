---
- name: lookup bootstrap facts (raw)
  ansible.builtin.ini_file:
    path: /etc/os-release
    state: file
    register: os_release_raw

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ (os_release_raw.raw | regex_replace('^PRETTY_NAME=".*?\\s\\((.*?)\\)"', '\\1')).split('(')[0].strip() }}"
    bootstrap_version: "{{ (os_release_raw.raw | regex_replace('^VERSION_ID="?([^"]*)[.]?(.*)?"', '\\1').split('.')[0] | default('0') }}"
  ansible.builtin.debug:
    msg: "Bootstrap distribution: {{ bootstrap_distribution }}, version: {{ bootstrap_version }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ lookup('ansible.utils.map', ['bootstrap__os_family_map', bootstrap_distribution]) | default('unknown') }}"
  ansible.builtin.debug:
    msg: "Bootstrap OS family: {{ bootstrap_os_family }}"


