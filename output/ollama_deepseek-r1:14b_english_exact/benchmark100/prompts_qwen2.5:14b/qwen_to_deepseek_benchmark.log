---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for_port:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    connect_timeout: 5

- name: Prepare system
  raw:
    cmd: whoami
  become: true

- name: Gather bootstrap facts on error
  setup:
    gather_subset: minimal
  rescue: true

- name: Install bootstrap packages (raw)
  raw:
    cmd: "{{ bootstrap_raw_command }}"
  chdir: /root

- name: Ensure libdnf5 is present on Fedora/RedHat
  dnf:
