---
- name: Check if Helm binary exists
  shell: which helm
  args:
    chdir: /usr/local/bin
  register: helm_exists
  changed_when: false

- name: Check Helm version
  shell: helm version --short
  args:
    chdir: /usr/local/bin
  register: helm_version
  when: helm_exists.rc == 0
  changed_when: false

- name: Download helm
  get_url:
    url: https://get.helm.sh/helm-{{ helm_version.stdout }}-linux-amd64.tar.gz
    dest: /tmp/helm.tar.gz
    mode: 0755
  when: helm_exists.rc != 0 or helm_version.rc != 0

- name: Copy helm binary into place
  shell: mv /tmp/linux-amd64/helm /usr/local/bin/helm && chmod 755 /usr/local/bin/helm
  args:
    chdir: /tmp
  when: helm_exists.rc != 0 or helm_version.rc != 0
  changed_when: false


