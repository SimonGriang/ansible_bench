---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.read_file:
    path: /etc/os-release
  register: bootstrap_os_release

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ distribution }}"
    bootstrap_major_version: "{{ major_version }}"
  loop: "{{ bootstrap_os_family_map | default({}) | dictiter() | list }}"
  when: >
    - ("{{ item.key }}" in
       {{ bootstrap_os_release | regex_replace('/\\n/', '') | regex_search('.*NAME=".*?"') | regex_replace('"', '') | lower() }}
      )
  vars:
    distribution: "{{ item.key }}"
    major_version: "{{ item.value.version_regex | regex_search('.*VERSION_ID=".*?"') | regex_replace('"', '') | regex_replace('.*VERSION_ID=', '') | regex_replace('/', '') }}"
  loop_control:
    label: "Setting distribution {{ item.key }} and version {{ item.value.version_regex }}"

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ family }}"
  loop: "{{ bootstrap_os_family_map | default({}) | dictiter() | list }}"
  when:
    - ("{{ distribution | default('') }}" == item.key)
  vars:
    family: "{{ item.value.family }}"
  loop_control:
    label: "Determining OS family for {{ item.key }}"


