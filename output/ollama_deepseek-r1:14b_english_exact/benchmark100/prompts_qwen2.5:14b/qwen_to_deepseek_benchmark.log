        dest: "{{ rke2_local_download_path }}/{{ item | basename }}"
        mode: 0640
      loop: "{{ rke2_artifacts_urls }}"

    - name: Download install script locally
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_local_download_path }}/rke2-install"
        mode: 0700

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local_path }}/"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0640
    force: true
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images directory
      file:
        path: "{{ rke2_additional_images_path }}"
        state: directory
        mode: 0700
      when: "{{ rke2_airgap_copy_additional_tarballs | length }} > 0"

    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_additional_images_path }}"
        mode: 0640
        force: true
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure artifacts directory exists
      file:
        path: "{{ rke2_artifacts_path }}"
        state: directory
        mode: 0700
      when: rke2_airgap_implementation == "exists"

    - name: Ensure permissions are acceptable
      set_fact:
        rke2_artifacts_perms:
          "{{ rke2_artifacts_path }}": 0700
          "{{ rke2_install_script_path }}": 0700
      when: rke2_artifacts_perms | is_mapping

- name: Populate service facts
  ansible.builtin.fact_path:
    path: /usr/bin

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Check if separate partition
  shell: grep "{{ ansible_hostname }}" /proc/mounts | grep /usr/local
  register: is_separate_partition

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_install_script_path }}"

- name: Check RKE2 version
  shell: "{{ rke2_install_script_path }}/rke2-install --version"
  register: rke2_version

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version.stdout | regex_replace('v', '') }}"
    rke2_running_version: "{{ rke2_version.stdout | regex_replace('v', '') }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  block:
    - name: Compare versions
      fail:
