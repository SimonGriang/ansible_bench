---
- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that: ansible_system == 'systemd'

- name: Get latest release of promtail
  ansible.builtin.github:
    repo: Grafana/loki
    type: release
    list_releases: yes
  register: promtail_releases

- name: Test if zip local archive exists
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}-{{ go_arch }}.zip"
  register: promtail_archive_exists

- name: Assert local binary exists
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/promtail"
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  ansible.builtin.shell:
    cmd: curl -s https://github.com/Grafana/loki/releases/download/v{{ promtail_version }}/checksums.txt
  register: checksums_content
  changed_when: false

- name: Get checksum for specific architecture
  ansible.builtin.set_fact:
    promtail_checksum: "{{ checksums_content.stdout_lines | selectattr('startswith', arguments=['{{ go_arch }} ']) | first }}"


