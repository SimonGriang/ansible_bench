---
- name: Ensure old versions of Docker are not installed
  yum:
    name: "{{ item }}"
    state: absent
  loop:
    - docker
    - docker-engine
    - docker-engine-selinux
    - docker-selinux

- name: Add Docker GPG key
  apt_key:
    key: "{{ lookup('file', 'https://download.docker.com/linux/ubuntu/gpg') | ansible.builtin.slurp | ansible.builtin.from_yaml }}"

- name: Add Docker repository
  file:
    path: /etc/apt/sources.list.d/docker.list
    content: |
      deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg]
          https://download.docker.com/linux/ubuntu jammy stable

- name: Configure Docker Nightly repo
  apt_repository:
    repo: |
      deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg]
          https://download.docker.com/linux/ubuntu jammy nightly
    state: present

- name: Configure Docker Test repo
  apt_repository:
    repo: |
      deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg]
          https://download.docker.com/linux/ubuntu jammy test
    state: present

- name: Configure containerd on RHEL 8
  package:
    name: "{{ item }}"
    state: present
    become: yes
    become_user: root
  loop:
    - container-selinux
    - containerd.io
  when: "ansible_distribution == 'RedHat' and ansible_distribution_version == '8'"

- name: Remove runc package on RHEL 8
  package:
    name: runc
    state: absent
    become: yes
    become_user: root
  when: "ansible_distribution == 'RedHat' and ansible_distribution_version == '8'"


