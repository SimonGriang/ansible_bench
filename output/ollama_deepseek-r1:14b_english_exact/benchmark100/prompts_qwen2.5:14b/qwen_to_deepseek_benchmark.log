---
- import_tasks: ansible.builtin.import_tasks assert.yml

- name: Install requirements
  ansible.builtin.apt:
    name: bash
    state: present

- name: Install openjdk java (package)
  ansible.builtin.apt:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"

- name: Install RPM
  ansible.legacy.rpm:
    file: oracle_jdk.rpm
    state: installed
  when: ansible_os_family == 'RedHat'

- name: Install DEB
  ansible.legacy.dpkg:
    file: oracle_jdk.deb
    state: installed
  when: ansible_os_family == 'Debian'

- name: Install oracle java (rpm) (repository)
  ansible.builtin.dnf:
    name: oracle-java
    state: present
  when: ansible_os_family == 'RedHat'

- name: Configure oracle targz
  ansible.builtin.file:
    path: /opt/java
    state: directory

- name: Install oracle java policy software (targz)
  ansible.builtin.unarchive:
    src: oracle_jce_policies.zip
    dest: /opt/java
    remote_src: no

- name: Set alternative (targz)
  community.general.alternatives:
    name: /opt/java/bin/java
    path: /usr/bin/java
    state: true
  when:
    - ansible_distribution != "Alpine"

- name: Find JAVA_HOME
  ansible.builtin.command:
    cmd: readlink -f /usr/bin/java
    changed_when: false
  register: java_home

- name: Set JAVA_HOME in /etc/environment
  ansible.builtin.lineinfile:
    path: /etc/environment
    line: JAVA_HOME="{{ java_home.stdout }}"

