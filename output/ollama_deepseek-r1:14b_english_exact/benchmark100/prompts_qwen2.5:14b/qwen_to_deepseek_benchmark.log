---
- name: Import assert.yml
  ansible.builtin.import_playbook:
    dir: assert.yml
    remote_host: localhost
    state: present

- name: Install mysql
  ansible.builtin.apt:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ansible.builtin.template:
    src: "{{ mysql_configuration_template }}"
    dest: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    owner: root
    group: root
    mode: 0o644
  notify:
    - Restart mysql server

- name: Configure mysql client
  ansible.builtin.ini_file:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    sections:
      mysql:
        socket: "{{ mysql_socket }}"
    owner: root
    group: root
    mode: 0o644

- name: Initialize mysql
  ansible.builtin.command:
    cmd: "{{ mysql_initialize_command }}"
    when: ansible_distribution in ['alpine', 'archlinux']
  register: mysql_initialized
  changed_when: mysql_initialized.stdout is not empty

- name: Start and enable mysql
  ansible.builtin.systemctl:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.flush_handlers:

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: 0o600

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
    db_user: root
    db_password: "{{ mysql_root_password }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
  loop: "{{ mysql_users }}"
  notify:
    - Restart mysql server

- name: Flush handlers again
  ansible.builtin.flush_handlers:


