    dest: "~{{ git_user }}/.gitconfig"
    mode: 0644
  when:
    - git_user is defined
    - git_user_exists
    - git_config is defined

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
  when:
    - git_user is defined
    - git_user_exists
    - repository_destination is defined

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}"
    branch: "{{ item.branch | default('main') }}"
    force: true
    become: yes
    become_user: "{{ git_user }}"
  loop: "{{ git_repositories }}"
