---
- name: Install Keepalived when HA mode is enabled
  apt:
    name: keepalived
    state: present
  when: ha_mode_enabled

- name: Download and install RKE2
  get_url:
    url: "https://github.com/rke2-io/rke2/releases/download/v{{ rke2_version }}/rke2-{{ rke2_arch }}"
    dest: /usr/local/bin/rke2
    mode: '0755'
  shell: chmod +x /usr/local/bin/rke2
  when:
    - rke2_version

- name: Perform CIS Hardening
  apt:
    name: cis
    state: present
    level: "{{ cis_level }}"
  when: cis_profile

- name: Identify the active server in the RKE2 cluster
  shell: rke2-get-active-node
  register: active_server

- name: Enable IPVS kernel module
  kernel_module:
    name: ipvs
    state: present
  when: kube_vip_enabled and ha_mode_enabled

- name: Copy kube-vip manifests to the masternode
  copy:
    src: /path/to/kube-vip/manifests/
    dest: /etc/rke2/manifests/
  when: not keepalived_enabled

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: /path/to/ingress-nginx/manifests/
    dest: /etc/rke2/manifests/
  when: ingress_nginx_config

- name: Prepare very first server node in the cluster
  shell: rke2-prep-node --init
  when: first_node

- name: Restore etcd specific tasks
  shell: etcd-restore
  when: etcd_restore | bool

- name: Download kubeconfig to ansible localhost
  fetch:
    src: /etc/rke2/kubeconfig
    dest: /path/to/local/kubeconfig
    flat: yes
  when: download_kubeconfig

- name: Prepare and join remaining nodes of the cluster
  shell: rke2-prep-node && rke2-join --token {{ cluster_token }}
  when: active_server

- name: Rolling cordon and drain restart when version changes - servers
  shell: rke2-rolling-restart --role server
  when: rke2_version_changed | bool

- name: Rolling cordon and drain restart when version changes - agents
  shell: rke2-rolling-restart --role agent
  when: rke2_version_changed | bool

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  shell: rke2-config-restart
  when: config_files_changed

- name: Final steps
  shell: rke2-finalize


