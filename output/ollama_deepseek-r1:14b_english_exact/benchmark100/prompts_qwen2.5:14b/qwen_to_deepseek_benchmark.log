---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for_port:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    connect_timeout: 5

- name: Prepare system
  block:
    - name: Test connection and sudo
      connection:
        user: root
        become: no
  rescue:
    - name: Gather bootstrap facts on error
      setup:
        gather_subset: minimal

- name: Install bootstrap packages (raw)
  raw:
    cmd: "{{ bootstrap_raw_command }}"
  chdir: /root

- name: Ensure libdnf5 is present on Fedora/RedHat
  dnf:
    name: "{{ libdnf5_package_name }}"
    state: present
  when: ansible_os_family in ['Fedora', 'RedHat']

- name: Gather ansible facts
  setup:
    gather_subset: all

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_packages }}"
    state: present
    update_cache: yes


