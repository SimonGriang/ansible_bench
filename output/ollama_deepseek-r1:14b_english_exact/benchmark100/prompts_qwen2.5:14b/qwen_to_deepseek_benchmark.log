te out the playbook with these tasks in order, making sure each one is correctly formatted and uses the right modules.\n</think>\n\n```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n\n- name: Install dns\n  apt:\n    name: "{{ dns_packages }}"\n    state: present\n\n- name: Create directories\n  file:\n    path: "{{ item }}"\n    state: directory\n    mode: 0755\n    owner: "dns"\n    group: "dns"\n  with_items:\n    - /var/named\n    - /var/named/run\n    - /var/named/etc\n\n- name: Create group\n  group:\n    name: "dns"\n    state: present\n\n- name: Create user\n  user:\n    name: "dns"\n    state: present\n    group: "dns"\n    home: "/var/named"\n    shell: "/sbin/nologin"\n\n- name: Generate rndc key\n  command: rndc-confgen -a -f /etc/rndc.key\n\n- name: Set permissions on rndc key file\n  file:\n    path: /etc/rndc.key\n    owner: "dns"\n    group: "dns"\n    mode: 0640\n\n- name: Get the hints/root file\n  get_url:\n    url: "https://www.root-nix.org/db.root"\n    dest: /var/named/run/db.root\n\n- name: Create zone file\n  template:\n    src: zone.j2\n    dest: /var/named/run/{{ zone_name }}.zone\n\n- name: Add zones to configuration\n  template:\n    src: named.conf.j2\n    dest: /etc/named.conf\n\n- name: Place systemd override\n  copy:\n    src: "{{ playbook_dir }}/files/named.service"\n    dest: /etc/systemd/system/named.service\n\n- name: Start and enable dns\n  systemd:\n    name: named\n    state: started\n    enabled: yes\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-18T08:30:29.793902337Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14995880743, 'load_duration': 93868848, 'prompt_eval_count': 595, 'prompt_eval_duration': 264602262, 'eval_count': 851, 'eval_duration': 14635871143, 'model_name': 'deepseek-r1:14b'} id='run--01859cc4-0d62-40ca-ae56-8c0953bc7052-0' usage_metadata={'input_tokens': 595, 'output_tokens': 851, 'total_tokens': 1446}
