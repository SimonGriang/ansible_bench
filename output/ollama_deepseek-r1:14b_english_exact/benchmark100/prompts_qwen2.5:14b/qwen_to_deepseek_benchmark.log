---
- name: Update apt cache
  ansible.builtin.apt:
    update_cache: true
  when: ansible_os_family == "Debian"

- name: Update dnf cache
  ansible.builtin.dnf:
    state: update
  when: ansible_os_family == "RedHat"

- name: Install packages
  ansible.builtin.apt:
    name: keepalived
    state: present
  when: ansible_os_family == "Debian"

- name: Install packages
  ansible.builtin.yum:
    name: keepalived
    state: present
  when: ansible_os_family == "RedHat"

- name: Create directory for keepalived
  ansible.builtin.file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: "01363"

- name: Create Kubernetes API health check script for Debian OS family
  ansible.builtin.template:
    src: k8s_api_health.sh.j2
    dest: /etc/keepalived/k8s_api_health.sh
    mode: "0755"
  when: ansible_os_family == "Debian"
  notify: restart_keepalived

- name: Create Kubernetes API health check script for RedHat OS family
  ansible.builtin.template:
    src: k8s_api_health.sh.j2
    dest: /etc/keepalived/k8s_api_health.sh
    mode: "0755"
  when: ansible_os_family == "RedHat"
  notify: restart_keepalived

- name: Create RKE2 Server health check script for Debian OS family
  ansible.builtin.template:
    src: rke2_server_health.sh.j2
    dest: /etc/keepalived/rke2_server_health.sh
    mode: "0755"
  when: ansible_os_family == "Debian"
  notify: restart_keepalived

- name: Create RKE2 Server health check script for RedHat OS family
  ansible.builtin.template:
    src: rke2_server_health.sh.j2
    dest: /etc/keepalived/rke2_server_health.sh
    mode: "0755"
  when: ansible_os_family == "RedHat"
  notify: restart_keepalived

- name: Create keepalived config file
  ansible.builtin.template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: "01204"
  notify: restart_keepalived

- name: Enable keepalived and make sure it is not masked
  ansible.builtin.service:
    name: keepalived
    state: started
    enabled: true
  notify: restart_keepalived

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true


