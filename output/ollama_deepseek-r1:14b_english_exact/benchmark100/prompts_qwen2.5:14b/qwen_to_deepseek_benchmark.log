---
- name: Cordon and Drain the node {{ rke2_node_name }}
  shell: kubectl drain {{ rke2_node_name }} --ignore-daemonsets --drain {{ rke2_data_path }} --delete-emptydirs --timeout 30m {{ rke2_drain_additional_args }}
  args:
    chdir: "{{ rke2_kubectl_path }}"
  register: drain_result
  until: drain_result.rc == 0
  retries: 100
  delay: 15
  changed_when: false

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2
    state: restarted
    display_name: rke2
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  shell: ./scripts/wait_for_nodes_to_be_ready.sh
  args:
    chdir: "{{ rke2_kubectl_path }}"
    creates: "{{ rke2_kubectl_path }}/scripts/.nodes_ready"
  register: nodes_ready
  until: nodes_ready.rc == 0
  retries: 100
  delay: 15
  changed_when: false

- name: Uncordon the node {{ rke2_node_name }}
  shell: kubectl uncordon {{ rke2_node_name }}
  args:
    chdir: "{{ rke2_kubectl_path }}"
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  shell: ./scripts/wait_for_pods_to_be_ready.sh
  args:
    chdir: "{{ rke2_kubectl_path }}"
    creates: "{{ rke2_kubectl_path }}/scripts/._Pods_ready"
  register: pods_ready
  until: pods_ready.rc == 0
  retries: 100
  delay: 15
  changed_when: false
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  shell: ./scripts/wait_for_pods_to_be_healthy.sh
  args:
    chdir: "{{ rke2_kubectl_path }}"
    creates: "{{ rke2_kubectl_path }}/scripts/._Pods_healthy"
  register: pods_healthy
  until: pods_healthy.rc == 0
  retries: 100
  delay: 15
  changed_when: false
  when: rke2_wait_for_all_pods_to_be_healthy


