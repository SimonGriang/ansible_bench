---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true

- name: Install php
  ansible.builtin.apt:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  ansible.builtin.command:
    cmd: php --ini
    register: php_found_ini_location
    when: php_ini_location is not defined

- name: Configure php
  ansible.builtin.template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
    notify: httpd_restart
  changed_when: false
  ignore_errors: true
  register: php_configured

- name: Set php.ini permissions
  file:
    path: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"
    state: file
    mode: '0o644'

