ke sure I\'m using the exact variable names and modules specified. Also, ensuring that the playbook is valid for inclusion in an Ansible Role under the tasks/ directory, so no playbook-level headers like hosts or vars are included.\n\nI think that covers all the tasks. Now, I\'ll write out the playbook accordingly.\n</think>\n\n```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  run_once: true\n  host: localhost\n\n- name: Install requirements\n  apt:\n    name: "{{ openssl_requirements }}"\n    state: present\n  become: yes\n\n- name: Install pip packages\n  pip:\n    name: "{{ openssl_pip_packages }}"\n    state: present\n  when: openssl_pip_packages is defined and openssl_pip_packages != ""\n\n- name: Create key directory\n  file:\n    path: "{{ openssl_key_directory }}"\n    state: directory\n    mode: 700\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create csr directory\n  file:\n    path: "{{ openssl_csr_directory }}"\n    state: directory\n    mode: 755\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create crt directory\n  file:\n    path: "{{ openssl_crt_directory }}"\n    state: directory\n    mode: 755\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Include create.yml\n  import_tasks: create.yml\n  loop: "{{ openssl_items | default([]) }}"\n  when: openssl_items is defined and openssl_items != ""\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-18T09:31:44.392804141Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15901034240, 'load_duration': 92062652, 'prompt_eval_count': 552, 'prompt_eval_duration': 355841867, 'eval_count': 772, 'eval_duration': 15451931003, 'model_name': 'deepseek-r1:14b'} id='run--0a55918a-b736-44f8-815c-386fc5fab25a-0' usage_metadata={'input_tokens': 552, 'output_tokens': 772, 'total_tokens': 1324}
