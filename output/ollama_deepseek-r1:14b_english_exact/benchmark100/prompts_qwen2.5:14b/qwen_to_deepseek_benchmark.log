---
- name: create | Create ssl key
  command: openssl genrsa -out /etc/ssl/private/{{ item }}.key 2048
  args:
    chown: 'root:root'
    mode: '0640'
  loop: '{{ ssl_certs_list }}'

- name: create | Create ssl csr
  command: openssl req -new -key /etc/ssl/private/{{ item }}.key -out /etc/ssl/certs/{{ item }}.csr -subj "/C=US/ST=State/L=City/O=Organization/OU=IT/CN={{ item }}"
  args:
    chown: 'root:root'
    mode: '0644'
  loop: '{{ ssl_certs_list }}'

- name: create | Create ssl certificates
  command: openssl x509 -req -days 365 -in /etc/ssl/certs/{{ item }}.csr -signkey /etc/ssl/private/{{ item }}.key -out /etc/ssl/certs/{{ item }}.crt -set_serial 1000
  args:
    chown: 'root:root'
    mode: '0644'
  loop: '{{ ssl_certs_list }}'

- name: create | Create PKCS#12 file
  pkcs12:
    dest: /etc/ssl/pkcs12/{{ item }}.p12
    privatekey: /etc/ssl/private/{{ item }}.key
    certificate: /etc/ssl/certs/{{ item }}.crt
    friendly_name: "{{ item }}"
    mode: '0640'
    owner: root
    group: root
  loop: '{{ ssl_certs_list }}'

- name: create | Read private key
  command: cat /etc/ssl/private/{{ item }}.key
  register: private_key_content
  loop: '{{ ssl_certs_list }}'

- name: create | Read certificate
  command: cat /etc/ssl/certs/{{ item }}.crt
  register: certificate_content
  loop: '{{ ssl_certs_list }}'

- name: create | Create combined private_key and certificate file
  command: cat /etc/ssl/private/{{ item }}.key /etc/ssl/certs/{{ item }}.crt > /etc/ssl/combined/{{ item }}.pem
  args:
    chown: 'root:root'
    mode: '0640'
  loop: '{{ ssl_certs_list }}'


