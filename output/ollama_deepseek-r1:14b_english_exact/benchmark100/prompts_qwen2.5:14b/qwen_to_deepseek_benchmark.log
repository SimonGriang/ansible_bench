- name: Import assert.yml
  import_playbook:
    file: files/assert.yml

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: present
    module: enable

- name: Install redis
  dnf:
    name: "{{ redis_packages }}"
    state: present

