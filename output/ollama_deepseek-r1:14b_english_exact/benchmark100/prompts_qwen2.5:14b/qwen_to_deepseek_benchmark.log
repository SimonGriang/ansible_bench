r indentation and correct module usage. I\'ll double-check that all variables are correctly templated and that conditionals properly include only the relevant tasks based on the Java version.\n\nFinally, I\'ll review the entire playbook to ensure it meets all the user\'s requirements, adheres to Ansible\'s standards, and is ready to be included in an Ansible Role without any issues.\n</think>\n\n```yaml\n---\n- name: Check if certificates exist\n  command: ls {{ java_certs }}\n  args:\n    echo: yes\n  register: cert_check\n  changed_when: false\n\n- name: Fail if some certificate doesn\'t exist\n  fail:\n    msg: "Missing certificate(s): {{ item | join(\', \') }}"\n  with_items: "{{ java_certs | difference(cert_check.stdout_lines) }}"\n\n- name: Setting keystore variables in java < 11\n  ansible.builtin.meta:\n    condition: "{{ java_open_jdk_version_major < 11 }}"\n    include: tasks/keystore_vars_old.yml\n\n- name: Setting keystore variables in java >= 11\n  ansible.builtin.meta:\n    condition: "{{ java_open_jdk_version_major >= 11 }}"\n    include: tasks/keystore_vars_new.yml\n\n- name: Import SSL certificates\n  java_cert:\n    path: "{{ java_certs }}"\n    key_store: "{{ java_open_jdk_home }}/{{ java_keystore_dir }}/cacerts"\n    keystore_password: changeit\n    store_type: JKS\n    state: present\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T07:23:47.429217209Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12297201356, 'load_duration': 95774316, 'prompt_eval_count': 499, 'prompt_eval_duration': 110470965, 'eval_count': 749, 'eval_duration': 12089636125, 'model_name': 'deepseek-r1:14b'} id='run--ecc7d206-59ed-4be1-8c7b-ec787c0641c8-0' usage_metadata={'input_tokens': 499, 'output_tokens': 749, 'total_tokens': 1248}
