        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}"
        mode: 0644
        timeout: 30
    - name: Download RKE2 install script locally
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_path }}"
        mode: 0700
        timeout: 30
  rescue: true

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_artifacts_local }}"
    dest: "{{ rke2_artifacts_path }}"
    mode: 0640
    remote_src: no
  when:
    - rke2_airgap_mode | bool
    - rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create directory for additional images
      file:
        path: "{{ rke2_additional_images_path }}"
        state: directory
        mode: 0700
    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_additional_images_path }}"
        mode: 0640
        remote_src: no
        force: yes
      with_items: "{{ rke2_airgap_copy_additional_tarballs }}"
  when:
    - rke2_airgap_mode | bool
    - rke2_airgap_copy_additional_tarballs | length > 0
    - rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0700
  when:
    - rke2_airgap_mode | bool
    - rke2_airgap_implementation == "exists"

- name: Get service facts
  command: systemctl list-unit-files --type service
  register: service_facts

- name: Get stats of the FS object
  command: stat -f /usr/local
  register: fs_stats

- name: Check if separate partition
  command: grep /usr/local /proc/mounts
  register: separate_partition
  changed_when: false
  ignore_errors: yes

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_dir }}/{{ rke2_install_script_name }}"

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}" version
  register: rke2_version
  changed_when: false
  ignore_errors: yes

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version.stdout | default('0.0.0') }}"
    rke2_running_version: "{{ rke2_version.stdout | default('0.0.0') }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  fail:
    msg: "RKE2 version {{ rke2_version.stdout }} is less than installed version {{ rke2_versionInstalled }}"
  when:
