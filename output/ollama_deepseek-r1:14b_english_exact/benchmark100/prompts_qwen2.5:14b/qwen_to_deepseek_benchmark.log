er_restriction if postfix_smtpd_sender_restriction is defined else \'reject_sender_login_mismatch\' }}"\n\n- name: Setting values for main.cf (2/2)\n  set_fact:\n    postfix_main_destinations: "{{ postfix_mydestination if postfix_mydestination is defined else \'localhost\' }}"\n    postfix_main_relay_domains: "{{ postfix_relay_domains if postfix_relay_domains is defined else [] }}"\n    postfix_main_virtual_domains: "{{ postfix_virtual_mailbox_domains if postfix_virtual_mailbox_domains is defined else [] }}"\n    postfix_main_virtual_aliases: "{{ postfix_virtual_alias_domains if postfix_virtual_alias_domains is defined else [] }}"\n\n- name: Configure postfix (main.cf)\n  template:\n    src: main.cf.j2\n    dest: /etc/postfix/main.cf\n  notify: postfix_validate_main_handler\n\n- name: Configure postfix (master.cf)\n  template:\n    src: master.cf.j2\n    dest: /etc/postfix/master.cf\n  notify: postfix_validate_master_handler\n\n- name: Creates cert/key directory\n  file:\n    path: "{{ postfix_smtpd_tls_cert_file | dirname }}"\n    state: directory\n    path: "{{ postfix_smtpd_tls_key_file | dirname }}"\n    state: directory\n\n- name: Deploy Postfix TLS server certificate\n  copy:\n    src: "{{ postfix_smtpd_tls_cert_file }}"\n    dest: "{{ postfix_smtpd_tls_cert_file }}"\n    remote_src: yes\n  notify: postfix_reload_handler\n\n- name: Deploy Postfix TLS server key\n  copy:\n    src: "{{ postfix_smtpd_tls_key_file }}"\n    dest: "{{ postfix_smtpd_tls_key_file }}"\n    remote_src: yes\n  notify: postfix_reload_handler\n\n- name: Flush handlers\n  meta:\n    flush_handlers: yes\n\n- name: Configure aliases\n  template:\n    src: aliases.j2\n    dest: /etc/postfix/aliases\n  notify: postfix_rebuild_aliases_handler\n\n- name: Configure sender_access\n  template:\n    src: sender_access.j2\n    dest: /etc/postfix/sender_access\n  notify: postfix_rebuild_sender_access_handler\n\n- name: Configure recipient_access\n  template:\n    src: recipient_access.j2\n    dest: /etc/postfix/recipient_access\n  notify: postfix_rebuild_recipient_access_handler\n\n- name: Place sasl_password_map\n  copy:\n    src: sasl_password_map\n    dest: /etc/postfix/sasl_password_map\n  notify: postfix_rebuild_sasl_password_map_handler\n\n- name: Flush handlers again\n  meta:\n    flush_handlers: yes\n\n- name: Start and enable postfix\n  systemctl:\n    name: postfix\n    state: started\n    enabled: yes\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T07:30:04.159809038Z', 'done': True, 'done_reason': 'stop', 'total_duration': 31829523790, 'load_duration': 87763773, 'prompt_eval_count': 2127, 'prompt_eval_duration': 1362233521, 'eval_count': 1452, 'eval_duration': 30378505301, 'model_name': 'deepseek-r1:14b'} id='run--7bdddea5-6ed8-4437-8c4f-9a526a2de651-0' usage_metadata={'input_tokens': 2127, 'output_tokens': 1452, 'total_tokens': 3579}
