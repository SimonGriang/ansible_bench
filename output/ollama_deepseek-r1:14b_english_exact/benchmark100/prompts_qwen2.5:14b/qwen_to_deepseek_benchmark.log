    - rke2_versionInstalled != "0.0.0"

- name: Run RKE2 install script
  command: "{{ rke2_bin_path }}" install
  when:
    - rke2_version.stdout != rke2_versionInstalled
    - not ansible_check_mode
  when: rke2_airgap_mode and rke2_airgap_implementation

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/manifests/custom/"
    mode: 0640
    remote_src: no
    force: yes
  with_items: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests | length > 0

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}"
    mode: 0640
    remote_src: no
    force: yes
  with_items: "{{ rke2_static_pods }}"
  when: rke2_static_pods | length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: "{{ rke2_env_dir }}/rke2.env"
    mode: 0640
    remote_src: no
    force: yes
  when: rke2_env_file is defined and rke2_env_file != ""


