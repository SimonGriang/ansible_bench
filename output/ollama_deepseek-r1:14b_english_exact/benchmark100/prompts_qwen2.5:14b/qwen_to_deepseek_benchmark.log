---
- name: Remove externally managed
  ansible.builtin.file:
    path: "{{ item }}"
    state: absent
  loop:
    - "/etc/apt/trusted.gpg.d/external-sources.gpg"
    - "/etc/apt/sources.list.d/external.list"

- name: Ensure Pip is installed
  ansible.builtin.apt:
    name: pip
    state: present

- name: Ensure packaging is available via dnf
  community.general.dnf:
    name: python3-packaging
    state: present

- name: Ensure pip_install_packages are installed
  ansible.builtin.pip:
    requirements: "{{ item }}"
    state: installed
  loop:
    - "setuptools>=57.0.0"
    - "wheel>=0.37.1"
    - "pip>=21.0"
    - "python-dotenv>=0.19.0"


