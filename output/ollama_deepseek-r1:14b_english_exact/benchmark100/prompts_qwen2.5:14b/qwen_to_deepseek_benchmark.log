---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  apt:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  apt:
    name: rsyslog
    state: present

- name: Install additional rsyslog packages
  apt:
    name: "{{ rsyslog_features }}"
    state: present

- name: Configuring default rsyslog
  template:
    src: default-config.j2
    dest: /etc/rsyslog.conf
    condition: ansible_dict_result | bool

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d/
    state: directory
    mode: 0755

- name: Configuring rsyslog forward rule
  template:
    src: forward-rule.j2
    dest: /etc/rsyslog.d/forward.conf
    condition: ansible_dict_result | bool

- name: Configuring additional config files
  copy:
    remote_src: true
    files:
      - src: "{{ item.src }}"
        dest: "/etc/rsyslog.d/{{ item.dest }}"
        mode: "{{ item.mode }}"
        owner: "{{ item.owner }}"
    with_items: "{{ rsyslog_additional_configs }}"

- name: Start and enable rsyslog
  systemctl:
    name: rsyslog
    state: started
    enabled: yes


