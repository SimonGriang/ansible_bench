---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost

- name: Install docker-compose package
  apt:
    name: docker-compose
    state: present
  when: docker_install_type == "package"

- name: Install docker-compose as a binary
  block:
    - name: Install required packages
      apt:
        name: curl
        state: present

    - name: Download and install docker-compose binary
      get_url:
        url: "https://github.com/docker/compose/releases/download/v2.20.0/docker-compose-{{ ansible_system }}.sha"
        dest: /usr/local/bin/docker-compose
        mode: '0755'
      register: docker_binary_download

    - name: Set permissions for docker-compose
      file:
        path: /usr/local/bin/docker-compose
        owner: root
        group: root
        mode: '0755'
  when: docker_install_type == "binary"


