---
- name: Import assert.yml
  include_tasks: assert.yml
  when: ansible_hostname == "localhost"

- name: Install vsftpd
  apt:
    name: vsftpd
    state: present

- name: Configure vsftpd
  template:
    src: vsftpd.conf.j2
    dest: /etc/vsftpd.conf
    owner: root
    group: root
    mode: 0644
  notify: restart_vsftpd

- name: Start and enable vsftpd
  systemd:
    name: vsftpd
    state: started
    enabled: true


