---
- name: Enable proxy and proxy_http modules on Debian and Suse systems
  ansible.debian.a2enmod:
    module: "{{ item }}"
    state: enabled
  loop:
    - proxy
    - proxy_http
  become: true
  notify:
    - httpd-restart

- name: Configure locations using a template
  ansible.builtin.template:
    src: location.conf.j2
    dest: /etc/apache2/sites-available/location.conf
    mode: 644
  vars:
    httpd_locations: "{{ httpd_locations }}"
  notify:
    - httpd-configtest
    - httpd-restart


