---
tasks:
  - name: Task 1: Import assert.yml
    import_tasks: assert.yml
    hosts: localhost
    run_once: true

  - name: Task 2: Install apache httpd
    apt:
      name: "{{ httpd_packages }}"
      state: present

  - name: Task 3: Configure selinux
    selinux:
      booleans: "{{ selinuxBOOLEANS }}"
      ports: "{{ custom_PORTS }}"

  - name: Task 4: Configure httpd
    template:
      src: "{{ httpd_CONFIG_SRC }}"
      dest: "{{ httpd_CONFIG_DEST }}"
      group: "{{ httpd_CONFIG_GROUP }}"
      mode: "{{ httpd_CONFIG_MODE }}"
    notify: test_and_reload_httpd

  - name: Task 5: Activate httpd module | Debian
    command: a2enmod "{{ item }}"
    with_items: "{{ httpd_MODULES }}"
    notify: test_and_reload_httpd
    when: debian_system

  - name: Task 6: Import ssl.yml
    import_tasks: ssl.yml
    when: https_ENABLED

  - name: Task 7: Import locations.yml
    import_tasks: locations.yml
    when: locations_DEFINED

  - name: Task 8: Import vhosts.yml
    import_tasks: vhosts.yml
    when: vhosts_DEFINED

  - name: Task 9: Configure ports
    template:
      src: "{{ ports_CONFIG_SRC }}"
      dest: "{{ ports_CONFIG_DEST }}"
      group: "{{ ports_CONFIG_GROUP }}"
      mode: "{{ ports_CONFIG_MODE }}"
    notify: test_and_reload_httpd
    when: (ansible_distribution == "Debian" or ansible_distribution == "Suse")

  - name: Task 10: Import directories.yml
    import_tasks: directories.yml
    when: directories_DEFINED

  - name: Task 11: Flush handlers
    meta: flush_handlers

  - name: Task 12: Removing default html
    file:
      path: "{{ httpd_DEFAULT_INDEX }}"
      state: absent
    when: httpd_remove_example

  - name: Task 13: Start and enable httpd
    service:
      name: "{{ httpd_SERVICE }}"
      state: started
      enabled: yes

