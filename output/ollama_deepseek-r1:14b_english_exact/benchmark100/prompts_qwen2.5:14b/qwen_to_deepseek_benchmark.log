---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  run_once: yes
  host: localhost

- name: Install apache httpd
  apt:
    name: "{{ httpd_packages }}"
    state: present
    update_cache: yes

- name: Configure selinux
  selinux:
    state: "{{ selinux_enabled | default(false) | bool }}"
    booleans:
      httpd_builtin_scripting: on
      httpd_exec_script: on
      httpd_modsecurity: on
      httpd_read_open_files: on
      httpd_tty_comm: on
      httpd_unified: on
    ports:
      custom_ports: "{{ custom_ports | default('') }}"

- name: Configure httpd
  template:
    src: httpd.conf.j2
    dest: /etc/apache2/httpd.conf
    owner: root
    group: root
    mode: 0644
  notify: httpd_test_and_restart

- name: Activate httpd module | Debian
  command: a2enmod "{{ item }}"
  loop: "{{ httpd_modules | default([]) }}"
  notify: httpd_test_and_restart
  when: ansible_os_family == 'Debian'

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_enabled | default(false)

- name: Import locations.yml
  import_tasks: locations.yml
  when: locations | default(false)

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: virtual_hosts | default(false)

- name: Configure ports
  template:
    src: ports.conf.j2
    dest: /etc/apache2/ports.conf
    owner: root
    group: root
    mode: 0644
  notify: httpd_test_and_restart
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml
  import_tasks: directories.yml
  when: directories | default(false)

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example | default(false)

- name: Start and enable httpd
  service:
    name: "{{ httpd_service | default('apache2') }}"
    state: started
    enabled: yes


