- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when:
    - postfix_virtual_mailbox_maps | contains('mysql')
    - postfix_virtual_mailbox_domains | contains('mysql')
    - postfix_virtual_alias_maps | contains('mysql')

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
  notify: postfix_validate_transport_maps_handler

