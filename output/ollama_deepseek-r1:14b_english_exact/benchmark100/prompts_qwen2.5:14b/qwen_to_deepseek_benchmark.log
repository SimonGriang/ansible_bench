ecified. After that, run the command to test the config, and then restart the service.\n\nI think that\'s all. Now, I\'ll structure the YAML accordingly, making sure it\'s valid and only includes the necessary tasks without any extra comments or sections.\n</think>\n\n```yaml\n---\n- name: Create document root directories for each virtual host\n  action: file\n    path: "{{ item.documentroot }}"\n    state: directory\n    create_mode: 0755\n  loop: "{{ httpd_vhosts | default([]) }}"\n  when: item.create_docroot | default(true)\n  register: docroot Created\n\n- name: Configure virtual hosts using a template\n  template:\n    src: "{{ vhost_conf_template }}"\n    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf "\n    group: "www-data"\n    mode: "0644"\n  loop: "{{ httpd_vhosts | default([]) }}"\n\n- name: Test httpd configuration and restart service\n  command: apache2configtest\n    chdir: "/etc/apache2"\n  register: httpd_test\n  ignore_errors: yes\n\n- name: Restart httpd service\n  service:\n    name: httpd\n    state: restarted\n  when: httpd_test | succeeded\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T07:06:20.397357639Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12793776922, 'load_duration': 89716630, 'prompt_eval_count': 404, 'prompt_eval_duration': 121899781, 'eval_count': 730, 'eval_duration': 12580607408, 'model_name': 'deepseek-r1:14b'} id='run--e9e865e0-4a95-48c1-acce-4de846eb1224-0' usage_metadata={'input_tokens': 404, 'output_tokens': 730, 'total_tokens': 1134}
