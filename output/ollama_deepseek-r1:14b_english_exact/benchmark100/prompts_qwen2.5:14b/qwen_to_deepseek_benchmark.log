---
- name: check if all variables have been set correctly
  assert:
    that:
      - "{{ bootstrap_vars | dictintersect | list }}" == []
      - bootstrap_wait_for_host is defined
      - ansible_os_family is defined
    msg: "Missing required variables or incorrect configuration."

- name: wait for host
  when: bootstrap_wait_for_host
  ansible.builtin.wait_for_host:
    port: "{{ bootstrap_port }}"
    host: "{{ bootstrap_host }}"

- name: prepare system
  ansible.builtin.shell:
    cmd: "ansible --version"
    chdir: /tmp
  ignore_errors: yes
  register: system_prep
  changed_when: false

- name: include tasks to gather bootstrap facts (raw)
  ansible.builtin.import_tasks:
    file: tasks/gather_bootstrap_facts.yml

- name: Install bootstrap packages (raw)
  when: ansible_os_family == "RedHat" or ansible_os_family == "Debian"
  ansible.builtin.raw:
    cmd: "{{ bootstrap_install_raw | default('yum install -y epel-release && dnf clean all && dnf makecache && dnf install -y') if ansible_os_family == 'RedHat' else 'apt-get update && apt-get install -y --no-install-recommends'}}"
    remote_chdir: /tmp

- name: ensure system is prepared by issuing ansible modules
  ansible.builtin.ansible:
    inventory: "{{ ansible.inventory_manager.inventory_dir }}"
    playbook: gather_bootstrap_facts.yml
    extra_vars: "{{ ansible.vars }}"
  changed_when: false
  register: bootstrap_facts

- name: install packages based on bootstrap facts
  when: ansible_os_family == "RedHat" or ansible_os_family == "Debian"
  ansible.builtin.package:
    name: "{{ bootstrap_packages }}"
    state: present
    module_path: "{{ '/usr/lib/python3.8/site-packages/' if ansible_distribution == 'Fedora' else '/usr/lib/python3.7/site-packages/' }}"


