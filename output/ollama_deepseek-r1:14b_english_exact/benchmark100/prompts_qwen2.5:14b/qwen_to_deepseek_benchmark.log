---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: 0700
    timeout: "{{ rke2_download_timeout }}"

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local_path }}"
    dest: "{{ rke2_install_script_path }}"
    mode: 0700
    force: yes
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation

- name: Create RKE2 artifacts folder
  file:
    state: directory
    path: "{{ rke2_artifacts_path }}"
    mode: 0700
  when:
    - rke2_airgap_mode
    - rke2_airgap_implementation != "exists"

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download checksum
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_artifacts_path }}/checksum.txt"
        mode: 0640
      when: rke2_airgap_implementation == "download"

    - name: Download artifacts
      get_url:
        url: "{{ item }}"
        dest: "{{ rke2_artifacts_path }}/{{ item | basename }}"
        mode: 0640
      loop: "{{ rke2_artifacts_urls }}"

