urrent_version\n\n- name: Set fact for current Docker Compose version\n  set_fact:\n    current_docker_compose_version: "{{ current_version.stdout.split(\' \')[2] }}"\n\n- name: Delete existing docker-compose version if it\'s different\n  file:\n    path: /usr/local/bin/docker-compose\n    state: absent\n  when: current_docker_compose_version is not equal to desired_version\n  changed_when: false\n\n- name: Install Docker Compose (if configured)\n  docker_compose_v2:\n    state: present\n    version: "{{ desired_version }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-18T08:53:03.935054951Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12977249587, 'load_duration': 89467843, 'prompt_eval_count': 1887, 'prompt_eval_duration': 1205696250, 'eval_count': 545, 'eval_duration': 11680598411, 'model_name': 'deepseek-r1:14b'} id='run--65ebb2f0-cbb2-40c2-9b8e-75cf8ac85d52-0' usage_metadata={'input_tokens': 1887, 'output_tokens': 545, 'total_tokens': 2432}
