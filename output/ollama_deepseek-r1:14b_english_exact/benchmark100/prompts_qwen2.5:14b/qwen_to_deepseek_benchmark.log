---
- name: Ensure the unzip package is available on the target system
  apt:
    name: unzip
    state: present
    update_cache: true
  become: true
  changed_when: false
  run_once: true
  vars:
    ansible_pkg_mgr: apt
  when: ansible_distribution in ['debian', 'ubuntu']

- name: Ensure the unzip package is available on the target system
  yum:
    name: unzip
    state: present
    update_cache: true
  become: true
  changed_when: false
  run_once: true
  vars:
    ansible_pkg_mgr: yum
  when: ansible_distribution in ['centos', 'rhel', 'ol']

- name: Create a system group for promtail
  group:
    name: promtail
    state: present
    system: yes
    gid: null
  become: true

- name: Create the promtail user
  user:
    name: promtail
    state: present
    system: yes
    group: promtail
    shell: /sbin/nologin
    home: /nonexistent
    create_home: false
  become: true

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
  become: true

- name: Create config directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  become: true
  loop:
    - /etc/promtail
    - /var/lib/promtail

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
    owner: promtail
    group: promtail
  become: true
  loop:
    - /opt/promtail

- name: Check if the promtail binary exists
  stat:
    path: /usr/local/bin/promtail
  register: promtail_binary_exists

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_url }}"
    dest: /usr/local/bin/promtail.tgz
    mode: '0755'
  become: true
  when: not promtail_binary_exists.stat.exists and promtail_dist == 'remote'

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_local_archive }}"
    dest: /usr/local/bin/promtail.tgz
    mode: '0755'
  become: true
  when: not promtail_binary_exists.stat.exists and promtail_dist == 'local'

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_controller_url }}"
    dest: /usr/local/bin/promtail.tgz
    mode: '0755'
  become: true
  when: not promtail_binary_exists.stat.exists and promtail_dist == 'remote' and controller_node

- name: Propagate promtail binaries
  copy:
    src: /usr/local/bin/promtail.tgz
    dest: "{{ promtail_binary_dir }}/promtail.tgz"
    remote_src: yes
    mode: '0755'
  become: true
  when: promtail_dist == 'remote'

- name: Unpack promtail binaries
  unarchive:
    src: /usr/local/bin/promtail.tgz
    dest: /opt/promtail
    remote_src: yes
    owner: promtail
    group: promtail
    mode: '0755'
    nofail: true
  become: true

- name: Create symlink to latest version
  file:
    path: /usr/local/bin/promtail
    state: link
    src: /opt/promtail/./bin/promtail
  become: true

- name: Write configuration
  template:
    src: promtail-config.j2
    dest: /etc/promtail/promtail.yml
    owner: promtail
    group: promtail
    mode: '0644'
  become: true

- name: Create systemd service unit
  template:
    src: promtail-service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  become: true

- name: Start and enable promtail service
  systemd:
    name: promtail
    state: started
    enabled: yes
  become: true


