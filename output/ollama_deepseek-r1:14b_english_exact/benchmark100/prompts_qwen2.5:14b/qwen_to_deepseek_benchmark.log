---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install git
  apt:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  community.general.getent:
    user: "{{ git_user }}"
    state: present
  changed_when: false

- name: Create directory for git configuration
  file:
    path: "~{{ git_user }}/.gitconfig.d"
    state: directory
  when:
    - git_user is defined
    - git_user_exists
    - git_config is defined

- name: Place git configuration
  template:
