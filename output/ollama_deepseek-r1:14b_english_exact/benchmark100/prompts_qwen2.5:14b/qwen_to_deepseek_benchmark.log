odules and arguments, ensuring YAML syntax and proper indentation.\n</think>\n\n```yaml\n---\n- name: Create ssl key\n  openssl_privatekey:\n    path: /etc/ssl/private/{{ item }}.key\n    type: rsa\n    mode: 640\n    owner: root\n    group: root\n  loop: "{{ ssl_certs | default([]) }}"\n\n- name: Create ssl csr\n  openssl_csr:\n    path: /etc/ssl/certs/{{ item }}.csr\n    privatekey_path: /etc/ssl/private/{{ item }}.key\n    mode: 644\n    common_name: "{{ item }}"\n    owner: root\n    group: root\n  loop: "{{ ssl_certs | default([]) }}"\n\n- name: Create ssl certificates\n  openssl_certificate:\n    path: /etc/ssl/certs/{{ item }}.crt\n    csr_path: /etc/ssl/certs/{{ item }}.csr\n    mode: 644\n    owner: root\n    group: root\n  loop: "{{ ssl_certs | default([]) }}"\n\n- name: Create PKCS#12 file\n  openssl_pkcs12:\n    path: /etc/ssl/certs/{{ item }}.p12\n    privatekey_path: /etc/ssl/private/{{ item }}.key\n    certificate_path: /etc/ssl/certs/{{ item }}.crt\n    mode: 640\n    owner: root\n    group: root\n    friendly_name: "{{ item }}"\n  loop: "{{ ssl_certs | default([]) }}"\n\n- name: Read private key\n  openssl_privatekey:\n    path: /etc/ssl/private/{{ item }}.key\n    content: yes\n    state: present\n  register: private_key\n  loop: "{{ ssl_certs | default([]) }}"\n\n- name: Read certificate\n  openssl_certificate:\n    path: /etc/ssl/certs/{{ item }}.crt\n    content: yes\n    state: present\n  register: certificate\n  loop: "{{ ssl_certs | default([]) }}"\n\n- name: Create combined private_key and certificate file\n  file:\n    path: /etc/ssl/certs/{{ item }}.pem\n    mode: 640\n    owner: root\n    group: root\n    content: "{{ lookup(\'file\', \'/etc/ssl/private/{{ item }}.key\') }}\\n{{ lookup(\'file\', \'/etc/ssl/certs/{{ item }}.crt\') }}"\n  loop: "{{ ssl_certs | default([]) }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T06:48:54.642804975Z', 'done': True, 'done_reason': 'stop', 'total_d