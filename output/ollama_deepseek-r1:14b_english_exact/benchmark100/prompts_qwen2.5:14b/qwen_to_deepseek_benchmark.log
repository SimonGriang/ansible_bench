---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  apt:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  cron_config:
    name: SHELL
    value: /bin/bash
    mode: '0002'
    notify: restart_cron

- name: Configure path
  cron_config:
    name: PATH
    value: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    mode: '0002'
    notify: restart_cron

- name: Configure mailto
  cron_config:
    name: MAILTO
    value: "{{ cron_mailto }}"
    mode: '0002'
    notify: restart_cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service | bool

- name: Schedule requested cron jobs
  cron_job:
    name: "{{ item.name }}"
    cron_file: /etc/crontab
    cron_line: "{{ item.schedule }} {{ item.job }}"
    state: "{{ item.state }}"
  loop: "{{ cron_jobs }}"

