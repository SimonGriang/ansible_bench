s:\n    chown: \'root:root\'\n    mode: \'0644\'\n  loop: \'{{ ssl_certs_list }}\'\n\n- name: create | Create ssl certificates\n  command: |\n    openssl x509 -req -days 365 -in /etc/ssl/certs/{{ item }}.csr\n    -signkey /etc/ssl/private/{{ item }}.key -out /etc/ssl/certs/{{ item }}.crt\n    -set_serial 1000\n  args:\n    chown: \'root:root\'\n    mode: \'0644\'\n  loop: \'{{ ssl_certs_list }}\'\n\n- name: create | Create PKCS#12 file\n  pkcs12:\n    dest: /etc/ssl/pkcs12/{{ item }}.p12\n    privatekey: /etc/ssl/private/{{ item }}.key\n    certificate: /etc/ssl/certs/{{ item }}.crt\n    friendly_name: "{{ item }}"\n    mode: \'0640\'\n    owner: root\n    group: root\n  loop: \'{{ ssl_certs_list }}\'\n\n- name: create | Read private key\n  command: cat /etc/ssl/private/{{ item }}.key\n  register: private_key_content\n  loop: \'{{ ssl_certs_list }}\'\n\n- name: create | Read certificate\n  command: cat /etc/ssl/certs/{{ item }}.crt\n  register: certificate_content\n  loop: \'{{ ssl_certs_list }}\'\n\n- name: create | Create combined private_key and certificate file\n  command: |\n    cat /etc/ssl/private/{{ item }}.key /etc/ssl/certs/{{ item }}.crt > /etc/ssl/combined/{{ item }}.pem\n  args:\n    chown: \'root:root\'\n    mode: \'0640\'\n  loop: \'{{ ssl_certs_list }}\'' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-18T09:59:12.976288709Z', 'done': True, 'done_reason': 'stop', 'total_duration': 18710326449, 'load_duration': 80111032, 'prompt_eval_count': 1255, 'prompt_eval_duration': 410017124, 'eval_count': 897, 'eval_duration': 18218275265, 'model_name': 'deepseek-r1:14b'} id='run--24df054b-b9f1-4305-b7c8-8c2b375df8e8-0' usage_metadata={'input_tokens': 1255, 'output_tokens': 897, 'total_tokens': 2152} 50%|█████     | 50/100 [1:51:54<1:37:32, 117.06s/it]
