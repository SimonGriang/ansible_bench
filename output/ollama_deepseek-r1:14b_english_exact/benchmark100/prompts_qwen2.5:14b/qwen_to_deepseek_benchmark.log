---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/main_mailer_type
    value: 'n'

- name: Install postfix
  apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when:
    - postfix_virtual_mailbox_maps | bool
    - postfix_virtual_mailbox_domains | bool
    - postix_virtual_alias_maps | bool

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
  notify: postfix_transport_map

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify: postfix_header_checks

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_smtpd_recipient_restriction: "{{ postfix_smtpd_recipient_restriction | default('rejectUnauthorized') }}"
    postfix_smtpd_sender_restriction: "{{ postfix_smtpd_sender_restriction | default('reject_sender_notification_of_reject') }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_mynetworks: "{{ postfix_mynetworks | default('127.0.0.0/8 [::1]/128') }}"
    postfix_mydestination: "{{ postfix_mydestination | default('localhost') }}"
    postfix_relay_domains: "{{ postfix_relay_domains | default('') }}"
    postfix_smtpd_recipient_restrictions: "{{ postfix_smtpd_recipient_restrictions | default('reject_unknown_client, reject_unknown_recipient, reject_unauthored_sender, reject_non_fqdn_sender, reject_non_fqdn_recipient, reject_invalid_hostname, reject_rfc1918_domain_recipient') }}"
    postfix_smtpd_sender_restrictions: "{{ postfix_smtpd_sender_restrictions | default('reject_unknown_client, reject_unknown_sender, reject_unauthored_recipient, reject_non_fqdn_sender, reject_non_fqdn_recipient, reject_invalid_hostname') }}"
    postfix_virtual_mailbox_domains: "{{ postfix_virtual_mailbox_domains | default('') }}"
    postfix_virtual_alias_domains: "{{ postfix_virtual_alias_domains | default('') }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify: postfix_check

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify: postfix_check

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: '0700'
  loop:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    remote_src: yes
  notify: postfix_reload

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    remote_src: yes
  notify: postfix_reload

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/postfix/aliases
  notify: alias_database

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
  notify: sender_access_database

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
  notify: recipient_access_database

- name: Place sasl_password_map
  template:
    src: sasl_password_map.j2
    dest: /etc/postfix/sasl_password_map
  notify: sasl_password_map_rebuild

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemctl:
    name: postfix
    state: started
    enabled: yes


