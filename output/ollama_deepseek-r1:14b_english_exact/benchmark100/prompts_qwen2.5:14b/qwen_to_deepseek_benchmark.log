---
- name: Check if the system is EFI
  command: ls /sys/firmware/efi/efivars
  register: efi_system
  changed_when: false
  ignore_errors: yes

- name: Remove the grub.cfg file if the system is EFI
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_system|changed

- name: Install a user template for GRUB
  template:
    src: grub_user_template.sh.j2
    dest: /etc/grub.d/01_users
    owner: root
    group: root
    mode: 0700
  notify: grub-update

- name: Add a password to the EFI GRUB configuration
  lineinfile:
    path: /etc/grub2-efi.cfg
    line: "set superusers='root'; password_pbdkdf2 root {{ grub_password }}"
    state: present
  notify: grub-update

- name: Add a password to the MBR GRUB configuration
  lineinfile:
    path: /etc/grub2.cfg
    line: "set superusers='root'; password_pbdkdf2 root {{ grub_password }}"
    state: present
  notify: grub-update

- name: Add --unrestricted option to specified files
  replace:
    path: "{{ item.path }}"
    regex: 'CLASS="([^"]+)"'
    replacement: 'CLASS="{{ match[1] }} --unrestricted"'
    state: present
  when: grub_password_unrestricted
  with_items: "{{ grub_password_unrestricted_files | default([]) }}"
  notify: grub-update

