---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install git
  apt:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  community.general.getent:
    user: "{{ git_user }}"
    state: present
  changed_when: false

- name: Create directory for git configuration
  file:
    path: "~{{ git_user }}/.gitconfig.d"
    state: directory
  when:
    - git_user is defined
    - git_user_exists
    - git_config is defined

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "~{{ git_user }}/.gitconfig"
    mode: 0644
  when:
    - git_user is defined
    - git_user_exists
    - git_config is defined

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
  when:
    - git_user is defined
    - git_user_exists
    - repository_destination is defined

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}"
    branch: "{{ item.branch | default('main') }}"
    force: true
    become: yes
    become_user: "{{ git_user }}"
  loop: "{{ git_repositories }}"
  when: git_user is defined and git_user_exists and repository_destination is defined


