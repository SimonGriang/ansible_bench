- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: /etc/rke2/manifests
    state: directory
    mode: 0o755

- name: Copy kube-vip files to first server
  ansible.builtin.template:
    src: "{{ item }}"
    dest: /etc/rke2/manifests/
    mode: 0o755
  with_items:
    "{{ lookup('ansible.builtin.file', 'files/kube-vip/*.yaml.j2') | list }}"
  register: kubevip_files

