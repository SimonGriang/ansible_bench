- name: Install epel
  ansible.builtin.yum_repository:
    name: epel
    state: present
    description: Extra Packages for Enterprise Linux
    baseurl: https://repo.epel.org/epel/
    gpgcheck: 1
    gpgkey: https://repo.epel.org/epel/RPM-GPG-KEY-EPEL-2

- name: Install epel gpg key
  ansible.builtin.yum:
    name: epel.gpgkey
    state: present
    key: https://repo.epel.org/epel/RPM-GPG-KEY-EPEL-2

- name: Install epel-release
  ansible.builtin.yum:
    name: epel-release
    state: present

- name: Install epel-next-release
  ansible.builtin.yum:
    name: epel-next-release
    state: present
  when: epel_next
  notify: update_package_cache


