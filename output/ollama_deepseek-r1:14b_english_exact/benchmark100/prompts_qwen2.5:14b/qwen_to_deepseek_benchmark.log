---
- name: Assert usage of systemd as an init system
  ansible.builtin.systemd:
    name: systemd
    state: started
    enabled: yes

- name: Get latest release of promtail
  ansible.modules.github:
    repo: grafana/promtail
    path: releases
    version: latest
    tag_name: promtail_version

- name: Test if zip local archive exists
  ansible.builtin.stat:
    path: "{{ promtail_version }}/promtail-{{ go_arch }}.zip"
    state: file

- name: Assert local binary exists
  ansible.builtin.path:
    path: "{{ promtail_binary_local_dir }}/promtail"
    state: file
  when: promtail_binary_local_dir is not empty

- name: Get checksum list
  ansible.builtin.uri:
    url: https://api.github.com/repos/grafana/promtail/releases/latest
    method: GET
    headers:
      Accept: application/vnd.github.v3+json
    register: checksum_list
  vars:
    promtail_checksum: "{{ checksum_list.json.assets | select(attribute='name', value='promtail-{{ go_arch }}.zip') | map(attribute='sha256') | list[0] }}"

- name: Get checksum for specific architecture
  ansible.builtin.set_fact:
    promtail_checksum: "{{ promtail_checksum }}"


