---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip
  ansible.builtin.apt:
    name: python-pip
    state: present

- name: Configure pip proxy
  ansible.builtin.template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: 0o0644
  when: python_pip_proxy is defined

- name: Trust hosts
  ansible.builtin.template:
    src: pip.conf.j2
    dest: /etc/pip.conf
    mode: 0o0644
  when: python_pip_trusted_host is defined

- name: Update pip
  ansible.builtin.pip:
    name: pip
    state: present
    extra_args: --upgrade
  when:
    - python_pip_update
    - distribution_release is not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default('latest') }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ python_pip_modules | default([]) | list }}"
  when:
    - python_pip_modules is defined
    - distribution_release is not in ['bookworm', 'noble']
    - ansible_os_family != 'Alpine'


