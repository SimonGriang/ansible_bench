    file: setup-Debian.yml
  when: ansible_distribution == "Debian" and ansible_package_state == "package"

- name: Set up Ansible using Pip
  ansible.builtin.include_tasks:
    file: setup-pip.yml
  when: ansible_package_state == "other"


