- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_restriction_recipient: "{{ postfix_smtpd_recipient_restriction | default('rejectUnauthorized') }}"
    postfix_main_restriction_sender: "{{ postfix_smtpd_sender_restriction | default('reject_sender_login_mismatch') }}"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_destinations: "{{ postfix_mydestination | default('localhost') }}"
    postfix_main_relay_domains: "{{ postfix_relay_domains | default([]) }}"
    postfix_main_virtual_domains: "{{ postfix_virtual_mailbox_domains | default([]) }}"
    postfix_main_virtual_aliases: "{{ postfix_virtual_alias_domains | default([]) }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify: postfix_validate_main_handler

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify: postfix_validate_master_handler

- name: Creates cert/key directory
