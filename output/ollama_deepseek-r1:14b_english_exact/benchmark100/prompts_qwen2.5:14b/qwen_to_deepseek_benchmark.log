---
- import_tasks: assert.yml
  become: true
  become_flags:
    remote_user: 'root'

- name: Install cron
  become: true
  package:
    name: '{{ cron_packages }}'
    state: present
  when: cron_packages|bool

- name: Configure shell
  become: true
  lineinfile:
    path: /etc/cron.conf
    line: SHELL={{ cron_shell }}
    state: present
    create_parent: yes
  file:
    path: /etc/cron.conf
    mode: '0600'
  notify: Restart cron
  when: cron_shell|bool

- name: Configure path
  become: true
  lineinfile:
    path: /etc/cron.conf
    line: PATH={{ cron_path }}
    state: present
    create_parent: yes
  file:
    path: /etc/cron.conf
    mode: '0600'
  notify: Restart cron
  when: cron_path|bool

- name: Configure mailto
  become: true
  lineinfile:
    path: /etc/cron.conf
    line: MAILTO={{ cron_mailto }}
    state: present
    create_parent: yes
  file:
    path: /etc/cron.conf
    mode: '0600'
  notify: Restart cron
  when: cron_mailto|bool

- name: Start and enable cron
  become: true
  systemd:
    name: '{{ cron_service }}'
    state: running
    enabled: yes
  when: cron_service|bool

- name: Schedule requested cron jobs
  become: true
  cron:
    name: "{{ item.name }}"
    schedule: "{{ item.schedule }}"
    command: "{{ item.command }}"
    notify: Restart cron
    state: present
  loop: "{{ cron_jobs }}"
  when: cron_jobs|bool

