---
- name: Import assert.yml
  include_tasks:
    path: files/assert.yml
  ignore_errors: true

- name: Install git
  apt-get:
    name: "{{ git_packages | default('git') }}"
    state: present
  when: git_packages | ansible.builtin.defined

- name: See if the specified user exists
  getent:
    user: "{{ git_user | default('git') }}"
    state: present
  when: git_user | ansible.builtin.defined

- name: Create directory for git configuration
  file:
    path: "{{ git_config_dir | default('/etc/git') }}"
    state: directory
    mode: 0755
  when: (git_user | ansible.builtin.defined) 
        and (git_config_dir | ansible.builtin.defined)

- name: Place git configuration
  template:
    src: "{{ git_config_src | default('git_config') }}"
    dest: "{{ git_config_dir | default('/etc/git') }}/.gitconfig"
    mode: 0644
  when: (git_user | ansible.builtin.defined) 
        and (git_config_dir | ansible.builtin.defined) 
        and (git_config | ansible.builtin.defined)

- name: Create repository_destination
  file:
    path: "{{ git_repos_dir | default('/home/git/repos') }}"
    state: directory
    mode: 0755
  when: (git_repositories | ansible.builtin.defined) 
        and (git_user | ansible.builtin.defined)

- name: Clone all roles
  git:
    repo: "{{ repo.ansible_url }}"
    dest: "{{ git_repos_dir | default('/home/git/repos') }}/{{ repo.name }}"
    clone: yes
    become_user: "{{ git_user | default('git') }}"
  loop: "{{ git_repositories | default([]) as repo }}"
  when: (git_repositories | ansible.builtin.defined) 
        and (git_user | ansible.builtin.defined)


