---
- name: Import assert.yml
  import_file:
    file: files/assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: 'Gather facts after package installation'

- name: Flush handlers
  meta:
    flush_handlers: yes

- name: Configure selinux
  block:
    - name: Manage selinux
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: 'Reboot system after selinux changes'

    - name: Manage selinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: yes
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.name }}"
  when:
    - selinux_enabled
    - connection == 'ssh'


