.builtin.command:\n    cmd: which python\n    register: python_check\n    warn: false\n\n- name: Check if Python3 is installed\n  ansible.builtin.command:\n    cmd: which python3\n    register: python3_check\n    warn: false\n\n- name: Check if pip is installed\n  ansible.builtin.command:\n    cmd: which pip\n    register: pip_check\n    warn: false\n\n- name: Check if pip3 is installed\n  ansible.builtin.command:\n    cmd: which pip3\n    register: pip3_check\n    warn: false\n\n- name: Ensure Python3 and pip3 are installed\n  ansible.builtin.pip:\n    requirements: "{{ openssl_requirements }}"\n    state: present\n    executable: /usr/bin/python3\n\n- name: Create directories with correct permissions\n  ansible.builtin.file:\n    path: "{{ key_path }}"\n    state: directory\n    mode: "{{ key_dir_perms }}"\n    owner: "{{ key_dir_owner }}"\n    group: "{{ key_dir_group }}"\n\n- name: Create directories with correct permissions\n  ansible.builtin.file:\n    path: "{{ csr_path }}"\n    state: directory\n    mode: "{{ csr_dir_perms }}"\n    owner: "{{ csr_dir_owner }}"\n    group: "{{ csr_dir_group }}"\n\n- name: Create directories with correct permissions\n  ansible.builtin.file:\n    path: "{{ crt_path }}"\n    state: directory\n    mode: "{{ crt_dir_perms }}"\n    owner: "{{ crt_dir_owner }}"\n    group: "{{ crt_dir_group }}"\n\n- name: Include tasks for additional steps\n  ansible.builtin.include_tasks:\n    file: "{{ openssl_items }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-08T06:54:14.745043031Z', 'done': True, 'done_reason': 'stop', 'total_duration': 17632510758, 'load_duration': 87561970, 'prompt_eval_count': 2708, 'prompt_eval_duration': 2006925692, 'eval_count': 745, 'eval_duration': 15536503664, 'model_name': 'deepseek-r1:14b'} id='run--2c25bae7-5cb4-4e6d-b8c7-0fe08611c703-0' usage_metadata={'input_tokens': 2708, 'output_tokens': 745, 'total_tokens': 3453}
