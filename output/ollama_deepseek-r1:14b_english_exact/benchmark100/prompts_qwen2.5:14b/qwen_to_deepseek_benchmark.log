exists\n    - repository_destination is defined\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-18T10:30:03.780868181Z', 'done': True, 'done_reason': 'stop', 'total_duration': 20561310283, 'load_duration': 88016037, 'prompt_eval_count': 863, 'prompt_eval_duration': 111638344, 'eval_count': 926, 'eval_duration': 20360616743, 'model_name': 'deepseek-r1:14b'} id='run--6bcd39c0-f053-4d1e-bfe7-b2d04a229d2b-0' usage_metadata={'input_tokens': 863, 'output_tokens': 926, 'total_tokens': 1789} 67%|██████▋   | 67/100 [2:22:45<1:18:17, 142.34s/it]
