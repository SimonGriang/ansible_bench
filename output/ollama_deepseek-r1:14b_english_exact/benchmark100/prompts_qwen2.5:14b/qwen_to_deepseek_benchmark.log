---
- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: /home/{{ user.name }}/.ssh
    state: directory
    mode: 0750
  when: user.manage_ssh_key
  run_once: yes
  become: false
  remote_user: "{{ user.name }}"
  delegate_to: localhost

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    state: "{{ user.state }}"
    password: "{{ user.password | default('') }}"
    groups: "{{ user.groups | default('') }}"
    shell: "{{ user.shell | default('/bin/bash') }}"
    create_home: "{{ user.create_home | default('true') | lower }}"
    system: "{{ user.system | default('false') | lower }}"
    append_groups: "{{ user.append_groups | default('true') | lower }}"
    sudoer:
      enabled: "{{ user.sudo.ENABLED | default('true') | bool }}"
      path_info: "{{ user.sudo.PATH_INFO | default('') }}"
      requiretty: "{{ user.sudo.REQUIRETTY | default('true') | bool }}"
      runas_user: "{{ user.sudo.RUNAS_USER | default('') }}"

- name: Set sudo options for {{ user.name }}
  file:
    path: /etc/sudoers.d/{{ user.name }}
    content: "{{ user.sudo.SUDOERS_CONTENT }}"
    mode: 0640
    state: present
  when: user.sudo.SUDOERS_CONTENT is defined

- name: Remove sudo options for {{ user.name }}
  file:
    path: /etc/sudoers.d/{{ user.name }}
    state: absent
  when: user.sudo.SUDOERS_CONTENT is not defined

- name: Generate private ssh key for {{ user.name }}
  shell: ssh-keygen -t rsa -f /home/{{ user.name }}/.ssh/id_rsa -N ''
  when: user.manage_ssh_key
  run_once: yes
  become: false
  remote_user: "{{ user.name }}"
  delegate_to: localhost

- name: Generate public ssh key for {{ user.name }}
  shell: ssh-keygen -f /home/{{ user.name }}/.ssh/id_rsa -e -o > /home/{{ user.name }}/.ssh/id_rsa.pub
  when: user.manage_ssh_key
  run_once: yes
  become: false
  remote_user: "{{ user.name }}"
  delegate_to: localhost

- name: Convert ssh key to ppk for {{ user.name }}
  shell: ssh-keygen -p -f /home/{{ user.name }}/.ssh/id_rsa -o -P ""
  when: user.manage_ssh_key
  run_once: yes
  become: false
  remote_user: "{{ user.name }}"
  delegate_to: localhost

- name: Get or set the home directory for {{ user.name }}
  file:
    path: "{{ user.home_directory | default('/home/{{ user.name }}') }}"
    state: directory
    mode: 0750

- name: Create .ssh directory for {{ user.name }}
  file:
    path: /home/{{ user.name }}/.ssh
    state: directory
    mode: 0750
  when: user.manage_ssh_key or user.private_keys

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys | default([]) }}"

- name: Remove unauthorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys | default([]) }}"

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: /home/{{ user.name }}/.ssh/id_rsa
    dest: /home/{{ user.name }}/.ssh/
    remote_src: yes
  when: user.copy_private_key
  run_once: yes

- name: Check users password valid time for {{ user.name }}
  passwd:
    user: "{{ user.name }}"
    query: age
    register: password_age

- name: Set users password valid time for {{ user.name }}
  passwd:
    user: "{{ user.name }}"
    expiry_days: "{{ user.password_validity_days | default('') }}"
    state: "{{ password_age.status | default('ok') }}"

- name: Place private key file for {{ user.name }}
  file:
    path: /home/{{ user.name }}/.ssh/id_rsa
    state: touch
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.private_keys


