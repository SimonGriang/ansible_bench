---
- name: Install epel
  ansible.legacy.epel:
    state: present

- name: Install epel gpg key
  ansible.builtin.rpm_key:
    key: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-2
    state: present

- name: Install epel-release
  ansible.builtin.dnf:
    name: epel-release
    state: present

- name: Install epel-next-release
  ansible.builtin.dnf:
    name: epel-next-release
    state: present
    when: epel_next | default('false') == 'true'
  notify: update_package_cache


