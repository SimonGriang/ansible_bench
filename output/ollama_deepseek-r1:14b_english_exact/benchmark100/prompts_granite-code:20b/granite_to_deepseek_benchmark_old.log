---
- name: Install nginx
  apt:
    name: nginx
    state: present
    become: yes

- name: Place nginx.conf
  copy:
    remote_src: yes
    content: "{{ nginx_conf_content }}"
    dest: /etc/nginx/nginx.conf
    mode: 0o0644
    become: yes
  notify: reload nginx

- name: Ensure /etc/nginx/conf.d exists
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: 0o0755
    become: yes

- name: Place default.conf
  copy:
    remote_src: yes
    content: "{{ default_conf_content }}"
    dest: /etc/nginx/conf.d/default.conf
    mode: 0o0644
    become: yes
  notify: reload nginx

- name: Start and enable nginx
  systemd:
    name: nginx
    state: started
    enabled: yes
    become: yes


