---
- name: Install Keepalived when HA mode is enabled
  apt:
    name: keepalived
    state: present

- name: Download and install RKE2 {{ rke2_version }}
  shell: curl -o /usr/local/bin/rke2 {{ rke2_url }} && chmod +x /usr/local/bin/rke2

- name: Apply CIS Benchmark hardening for RKE2
  apt:
    name: cis-benchmarks
    state: present
  shell: bash /usr/share/cis-benchmarks/ansible/ansible-playbook.sh -i /usr/share/cis-benchmarks/ansible/inventory/cluster.yml

- name: Find the active server in the cluster
  shell: kubectl get nodes -o json | jq -r '.items[] | select(.status.conditions[].type == "Ready") | .metadata.name'

- name: Enable IPVS kernel module
  sysctl:
    name: net.ipv4.vs衙寺
    value: 1
  sysctl_persistent:
    name: net.ipv4.vs衙寺
    value: 1

- name: Copy kube-vip manifests to the masternode
  copy:
    remote_src: true
    src: manifests/kube-vip/
    dest: /etc/kubernetes/kube-vip/

- name: Copy ingress-nginx manifests to the masternode
  copy:
    remote_src: true
    src: manifests/ingress-nginx/
    dest: /etc/kubernetes/ingress-nginx/

- name: Prepare the very first server node in the cluster
  shell: kubectl apply -f manifests/first-node.yaml

- name: Restore etcd specific tasks
  shell: kubectl apply -f restore-manifest.yaml

- name: Download kubeconfig to ansible localhost
  fetch:
    src: /etc/kubernetes/kubeconfig
    dest: /tmp/kubeconfig
    flat: yes

- name: Prepare and join remaining nodes of the cluster
  shell: kubectl apply -f manifests/join.yaml

- name: Rolling cordon and drain restart when version changes - servers
  shell: kubectl drain --ignore-daemonsets --dry-run $(kubectl get nodes -o name | grep -v 'master' | xargs)

- name: Rolling cordon and drain restart when version changes - agents
  shell: kubectl drain --ignore-daemonsets --dry-run $(kubectl get nodes -o name | grep agent | xargs)

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  shell: kubectl apply -f updated-configmap.yaml

- name: Final steps
  shell: echo "Playbook completed successfully"


