      become_user: root
      become_method: sudo
      vars:
        bootstrap_packages: "{% if ansible_distribution == 'Ubuntu' %}ansible{% else %}ansible{% endif %}"
      ansible.builtin.apt:
        name:
          - "{{ bootstrap_packages }}"
        state: present


