- name: Install nginx
  apt:
    name: nginx
    state: present
    become: true

- name: Place nginx.conf
  copy:
    remote_src: yes
    content: "{{ nginx_conf_content }}"
    dest: /etc/nginx/nginx.conf
    mode: 0o0644
    become: true
  notify: reload nginx

- name: Ensure /etc/nginx/conf.d exists
  file:
