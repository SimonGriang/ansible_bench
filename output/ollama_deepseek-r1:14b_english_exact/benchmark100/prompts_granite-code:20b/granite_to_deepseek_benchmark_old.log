\n  ansible.builtin.k8s:\n    api_endpoint: https://{{ rke2_cluster_api_url }}\n    resource: nodes\n    verb: get\n    register: rke2_nodes_status\n  until: "{{ rke2_nodes_status.items | json_query(\'*.status.conditions[] | select(contains(.type, \\"Ready\\") | .status == \\"True\\")\') | list | length == rke2_nodes_status.items | json_query(\'*.metadata.name\') | list | length }}"\n  retries: 60\n  delay: 60\n\n- name: Wait for all pods to be ready again\n  ansible.builtin.k8s:\n    api_endpoint: https://{{ rke2_cluster_api_url }}\n    resource: pods\n    namespace: all\n    verb: get\n    register: rke2_pods_status\n  until: "{{ rke2_pods_status.items | json_query(\'*.status.phase\') | list | all( in ( [\'Running\', \'Succeeded\'] )) }}"\n  retries: 60\n  delay: 60\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-12T11:29:26.868369977Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10971931045, 'load_duration': 86028920, 'prompt_eval_count': 1611, 'prompt_eval_duration': 714690472, 'eval_count': 699, 'eval_duration': 10169797064, 'model_name': 'deepseek-r1:14b'} id='run--fe8a688d-9a8b-46c1-89fa-927678fa42b0-0' usage_metadata={'input_tokens': 1611, 'output_tokens': 699, 'total_tokens': 2310}
