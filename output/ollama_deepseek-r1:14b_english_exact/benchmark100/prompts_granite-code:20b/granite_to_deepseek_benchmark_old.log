---
- name: check if all variables have been set correctly
  set_fact:
    ansible_check_variables: true
    ansible_check_variables_msg: "All variables have been set correctly"

- name: wait for host (when configured)
  community.general.wait_for_host:
    state: "{{ ansible_host_state | default('started') }}"
    delay: 5
    timeout: 30

- name: prepare system
  block:
    - name: test connection
      ping:
        count: 1
      register: connection_test
      ignore_errors: true
      changed_when: false

    - name: install bootstrap packages for RedHat
      when: ansible_os_family == 'RedHat'
      become: true
      become_user: root
      become_method: sudo
      vars:
        bootstrap_packages: |
          "{{ ansible_distribution == 'CentOS'
             ? 'yum-utils'
             : 'ansible' }}"
      ansible.builtin.yum:
        name:
          - "{{ bootstrap_packages }}"
        state: present

    - name: install bootstrap packages for Debian
      when: ansible_os_family == 'Debian'
      become: true
      become_user: root
      become_method: sudo
      vars:
        bootstrap_packages: |
          "{{ ansible_distribution == 'Ubuntu'
             ? 'ansible'
             : 'ansible' }}"
      ansible.builtin.apt:
        name:
          - "{{ bootstrap_packages }}"
        state: present

