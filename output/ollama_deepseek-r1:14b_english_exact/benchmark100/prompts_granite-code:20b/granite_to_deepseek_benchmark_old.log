---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install dns
  apt:
    name: bind9
    state: present

- name: Create directories
  file:
    path: "{{ named_config_dir }}"
    state: directory
    owner: "{{ named_user }}"
    group: "{{ named_group }}"
    mode: 0755

- name: Create group
  group:
    name: dns
    state: present

- name: Create user
  user:
    name: dns
    group: dns
    home: /var/run/named
    shell: /sbin/nologin
    state: present

- name: Generate rndc key
  rndc_keygen:
    key_file: "{{ rndc_key_file }}"
    state: present

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_file }}"
    owner: root
    group: root
    mode: 0600

- name: Get the hints/root file
  fetch_url:
    url: http://{{ named_root_url }}
    dest: "{{ named_root_dir }}/named.root"
    validate_certs: no

- name: Create zone file
  template:
    src: "{{ item.template }}"
    dest: "{{ named_config_dir }}/{{ item.zone }}.db"
    owner: "{{ named_user }}"
    group: "{{ named_group }}"
    mode: 0644
  loop: "{{ dns_zones }}"

- name: Add zones to configuration
  template:
    src: "contrib/named.conf.j2"
    dest: /etc/bind/named.conf
    owner: root
    group: root
    mode: 0644

- name: Place systemd override
  template:
    src: contrib/override.j2
    dest: /etc/systemd/system/bind9.service.d/override.conf
    owner: root
    group: root
    mode: 0644

- name: Start and enable dns
  service:
    name: bind9
    state: started
    enabled: yes


