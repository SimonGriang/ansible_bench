---
- name: Install cron
  apt:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/crontab
    line: SHELL=/bin/bash
    insertafter: CRON_USER

- name: Configure path
  lineinfile:
    path: /etc/crontab
    line: PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/bin:/usr/games:/sbin
    insertafter: SHELL

- name: Configure mailto
  lineinfile:
    path: /etc/crontab
    line: MAILTO=root
    insertafter: PATH

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: true

- name: Schedule requested cron jobs
  cron:
    name: test_cron
    job_name: test_cron
    path: /home/vagrant/cronjob.sh
    cron_schedule: "* * * * *"
    state: present
    enabled: true

- name: Create cron job script
  file:
    path: /home/vagrant/cronjob.sh
    content: |
      #!/bin/bash
      echo "Cron job is running at $(date)"
      echo "This is a test cron job."
    mode: 755


