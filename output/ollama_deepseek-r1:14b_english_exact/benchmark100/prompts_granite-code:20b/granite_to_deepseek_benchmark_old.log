---
- name: Create docroot directory for each virtual host
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Create docroot {{ item.servername }}"
  when: create_docroot | default(true)

- name: Configure virtual host settings
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.servername }}.conf"
    mode: 0644
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Configure virtual host {{ item.servername }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd


