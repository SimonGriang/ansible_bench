---
- name: Task 1: Ensure apt key is not present in trusted.gpg.d
  ansible.builtin.file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Task 2: Ensure old apt source list is not present in /etc/apt/sources.list.d
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Task 3: Ensure old versions of Docker are not installed.
  ansible.builtin.apt:
    name: "*docker*"
    state: absent
    purge: yes
    autoremove: yes

- name: Task 4: Ensure legacy repo file is not present.
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Task 5: Ensure dependencies are installed.
  ansible.builtin.apt:
    name: curl wget gnupg
    state: present
    update_cache: yes

- name: Task 6: Add or remove Docker repository
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: "{{ 'present' if '/etc/apt/sources.list.d/docker.list' in file_list else 'absent' }}"
    content: "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu {{ ansible_distribution_version }} stable\n"
    owner: root
    group: root
    mode: '0644'

- name: Task 7: Ensure handlers are notified immediately to update the apt cache.
  ansible.builtin.apt:
    state: present


