---
- name: Install Ansible
  apt:
    name: ansible
    state: "{{ ansible_package_state | default('installed') }}"
    default_release: "{{ ansible_default_release | default('') }}"

- name: Enable Backports repository
  apt_repository:
    repo: "http://http.debian.net/debian/backports/{{ ansible_distribution_release }}/main"
    state: present
    filename: "{{ ansible_distribution_release }}_backports"
    update_cache: true

- name: Set the default_release option for older Debian versions
  set_fact:
    ansible_default_release: "{{ ansible_distribution_release }}-backports"


