    state: present

- name: Install epel-release
  apt:
    name: "{{ epel_url }}"
    state: present
  notify: update_package_cache

- name: Install epel-next-release
  apt:
    name: "{{ epel_next_url }}"
    state: present
  when: epel_next
  notify: update_package_cache


