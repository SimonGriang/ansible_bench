---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install mysql
  apt:
    state: present
    name: "{{ mysql_packages }}"

- name: Configure mysql server
  template:
    dest: "{{ mysql_configuration_destination }}"
    name: "{{ mysql_name }}"
    options: "{{ mysql_configuration_options }}"
    socket: "{{ mysql_socket }}"

- name: Configure mysql client
  template:
    dest: "{{ mysql_configuration_destination }}"
    name: "{{ mysql_name }}"
    template: mysql/client.cnf.j2

- name: Initialize mysql
  mysql_systemd_service:
    name: mysql
    state: started
    command: "{{ mysql_initialize_command }}"

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  meta:
    flush_handlers: true

- name: Place my.cnf
  copy:
    dest: /root/.my.cnf
    remote_src: true
    template: my.cnf.j2

- name: Create databases
  mysql_db:
    state: present
    name: "{{ item }}"
    ssl_cert: false
    ssl_key: false
    ssl_ca: false
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    ssl_cert: false
    ssl_key: false
    ssl_ca: false
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta:
    flush_handlers: true



