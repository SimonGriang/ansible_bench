---
- name: Task 1: Check if systemd is used as init system
  assert:
    that:
      - command("command -v systemctl") | ansible.utils.system.is_systemd() | bool
    msg: "System must use systemd as init system for this module to work."

- name: Task 2: Retrieve the latest release of Promtail
  uri:
    url: "https://api.github.com/repos/prometheus/promtail/releases"
    status_code: 200
    register: latest_promtail
  changed_when: false

- name: Task 3: Set the Promtail version to the latest release
  set_fact:
    promtail_version: "{{ latest_promtail.json[0].tag_name }}"


