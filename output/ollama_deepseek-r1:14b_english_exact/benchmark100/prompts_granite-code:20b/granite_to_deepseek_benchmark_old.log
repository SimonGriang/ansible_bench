    name: "{{ packages }}"
    state: present

- name: Configure systemd service
  ansible.builtin.template:
    src: systemd.j2
    dest: /etc/systemd/system/myservice.service
    owner: root
    group: root
  when: ansible_service_mgr == "systemd"

- name: Configure sysvinit service
  ansible.builtin.template:
    src: sysvinit.j2
    dest: /etc/init.d/myservice
    owner: root
    group: root
  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]

- name: Manage service
  ansible.builtin.service:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    enabled: "{{ ansible.utils.convert_bool(item.enabled) }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: yes


