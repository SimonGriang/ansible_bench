  ansible.builtin.import_tasks: assert.yml

- name: Install apache httpd
  ansible.builtin.apt:
    name: apache_httpd
    state: present

- name: Configure selinux
  ansible.builtin.setsebool:
    name: httpd_can_network_reach
    state: enabled

- name: Configure httpd
  ansible.builtin.template:
    src: httpd.conf.j2
    dest: /etc/httpd/conf/httpd.conf
    mode: 0o0644

- name: Activate httpd module | Debian
  ansible.builtin.command:
    cmd: /usr/sbin/a2enmod httpd
    changed_when: "ansible_facts.a2enmod_output is not None"

- name: Import ssl.yml
  ansible.builtin.import_tasks: ssl.yml

- name: Import locations.yml
  ansible.builtin.import_tasks: locations.yml

- name: Import vhosts.yml
  ansible.builtin.import_tasks: vhosts.yml

- name: Configure ports
  ansible.builtin.firewall:
    name: http
    state: present
    proto: tcp
    port: 80

- name: Import directories.yml
  ansible.builtin.import_tasks: directories.yml

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Removing default html
  ansible.builtin.file:
    path: /var/www/html/index.html
    state: absent

- name: Start and enable httpd
  ansible.builtin.systemd:
    name: apache2
    state: started
    enabled: true


