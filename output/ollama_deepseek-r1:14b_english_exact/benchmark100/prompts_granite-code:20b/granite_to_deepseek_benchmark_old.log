tasks:
  - name: Task 1: Import assert.yml
    import_tasks: assert.yml

  - name: Task 2: Check if the ansible_pkg_mgr is set to apt and then manage automatic service
           management based on the apt_autostart_state variable
    apt:
      name: "{{ package_name }}"
      state: "{{ apt_autostart_state }}"
      autostart: yes

  - name: Task 3: Use the copy module to create the policy-rc.d file with the content "exit 101"
           and mode "755" if the apt_autostart_state is set to disabled
    copy:
      content: "exit 101"
      dest: /etc/init.d/policy-rc.d
      mode: 755
    when: apt_autostart_state == 'disabled'

  - name: Task 4: Use the file module to remove the policy-rc.d file if the apt_autostart_state
           is set to enabled
    file:
      path: /etc/init.d/policy-rc.d
      state: absent
    when: apt_autostart_state == 'enabled'


