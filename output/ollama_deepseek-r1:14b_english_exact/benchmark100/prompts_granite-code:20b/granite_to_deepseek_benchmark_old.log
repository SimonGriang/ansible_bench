ionary into multiple lines using a folded string. Each key-value pair will be on its own line, properly indented.\n\nI\'ll also check that the quotes and commas are correctly placed after splitting the lines to avoid syntax errors.\n\nAfter making these changes, I\'ll ensure that the playbook still adheres to the original task descriptions and that no functional changes are introduced. Only the formatting is adjusted to meet the yamllint line length requirement.\n\nFinally, I\'ll reconstruct the playbook with the corrected lines, making sure each task is properly formatted and that the YAML structure remains valid.\n</think>\n\n---\n- name: lookup bootstrap facts\n  command: cat /etc/os-release\n  register: os_release_info\n\n- name: set bootstrap facts (I)\n  set_fact:\n    bootstrap_distribution: "{{ os_release_info.stdout | ansible.utils.convert_to_dict | dict2item | first.value.ID }}"\n    bootstrap_distribution_major_version: "{{ os_release_info.stdout | ansible.utils.convert_to_dict | dict2item | first.value.VERSION_ID | split(\'.\')[0] }}"\n\n- name: set bootstrap facts (II)\n  set_fact:\n    bootstrap_os_family: "{{ lookup(\'ansible.utils.mapping\', {\n        \'Ubuntu\': \'Debian\',\n        \'Debian\': \'Debian\',\n        \'Fedora\': \'RedHat\',\n        \'CentOS\': \'RedHat\',\n        \'RHEL\': \'RedHat\'\n    }, key=bootstrap_distribution) }}"' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-12T08:37:15.159580142Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14743882066, 'load_duration': 102169283, 'prompt_eval_count': 662, 'prompt_eval_duration': 84376228, 'eval_count': 694, 'eval_duration': 14556387404, 'model_name': 'deepseek-r1:14b'} id='run--d20443e9-3926-4ff1-8902-48f4ccaad55b-0' usage_metadata={'input_tokens': 662, 'output_tokens': 694, 'total_tokens': 1356}
