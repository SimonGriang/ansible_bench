  command: lsblk /usr/local | grep -qs '^/dev'
  ignore_errors: yes
  changed_when: false

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_path }}"

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 version"
  changed_when: false

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_version is version
    fail: yes
    msg: "RKE2 version is downgraded"

- name: Run RKE2 install script
  shell: "{{ rke2_bin_path }}/rke2 install {{ install_flags }}"
  changed_when: false

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    owner: root
    group: root
    mode: 0644
  with_items: "{{ custom_manifests }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/"
    owner: root
    group: root
    mode: 0644
  with_items: "{{ static_pods }}"

- name: Copy RKE2 environment file
  template:
    src: rke2_environment.j2
    dest: /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: 0644


