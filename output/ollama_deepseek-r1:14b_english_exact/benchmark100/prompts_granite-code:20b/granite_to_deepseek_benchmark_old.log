t checks. No extra comments or explanations are needed since the output must be just the playbook YAML.\n</think>\n\n```yaml\n---\n- name: Check if python is installed\n  command: which python\n  register: python_executable\n\n- name: Check if python3 is installed\n  command: which python3\n  register: python3_executable\n\n- name: Debug Python executable path\n  debug:\n    msg: "{{ python_executable.stdout }}"\n\n- name: Debug Python3 executable path\n  debug:\n    msg: "{{ python3_executable.stdout }}"\n\n- name: Import assert.yml\n  import_tasks: assert.yml\n\n- name: Install requirements\n  package:\n    name: "{{ openssl_requirements }}"\n    state: present\n\n- name: Ensure packaging is available via dnf\n  package:\n    name: dnf\n    state: present\n\n- name: Install pip packages\n  pip:\n    packages: "{{ openssl_pip_packages }}"\n\n- name: Create key directory\n  file:\n    path: "{{ openssl_key_directory }}"\n    state: directory\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create csr directory\n  file:\n    path: "{{ openssl_csr_directory }}"\n    state: directory\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Create crt directory\n  file:\n    path: "{{ openssl_crt_directory }}"\n    state: directory\n    owner: "{{ openssl_file_owner }}"\n    group: "{{ openssl_file_group }}"\n\n- name: Include create.yml\n  include_tasks: create.yml\n  loop: "{{ openssl_items }}"\n  loop_control:\n    loop_var: item\n  vars:\n    label: "{{ item.name }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-12T09:51:07.055450376Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14153600182, 'load_duration': 102000529, 'prompt_eval_count': 703, 'prompt_eval_duration': 315999305, 'eval_count': 798, 'eval_duration': 13734096864, 'model_name': 'deepseek-r1:14b'} id='run--ce96263a-82e4-40b3-bbbc-eeb25be5a4a2-0' usage_metadata={'input_tok