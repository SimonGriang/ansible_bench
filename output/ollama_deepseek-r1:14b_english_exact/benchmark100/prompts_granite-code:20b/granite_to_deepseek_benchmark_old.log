---
- name: password | Get efi path
  ansible.builtin.set_fact:
    efi_path: "{{ansible.builtin.stat(path=/boot/efi).stat}}"

- name: password | Remove unwanted grub.cfg on EFI systems
  ansible.builtin.file:
    path: /boot/efi/EFI/BOOT/grub.cfg
    state: absent
    mode: '0644'

- name: password | Install user template
  ansible.builtin.template:
    src: /path/to/template
    dest: /boot/efi/EFI/BOOT/grub.cfg
    mode: '0644'

- name: password | EFI | add password
  ansible.builtin.lineinfile:
    path: /boot/efi/EFI/BOOT/grub.cfg
    line: "set superusers='root'"
    insertafter: "^GRUB_TIMEOUT=5"

- name: password | MBR | add password
  ansible.builtin.lineinfile:
    path: /boot/grub/grub.cfg
    line: "set superusers='root'"
    insertafter: "^GRUB_TIMEOUT=5"

- name: password | Add --unrestricted
  ansible.builtin.replace:
    path: /boot/efi/EFI/BOOT/grub.cfg
    regexp: '(set superusers.*=)'
    replace: '\1 --unrestricted'
    backup: true

- name: password | Add --unrestricted
  ansible.builtin.replace:
    path: /boot/grub/grub.cfg
    regexp: '(set superusers.*=)'
    replace: '\1 --unrestricted'
    backup: true


