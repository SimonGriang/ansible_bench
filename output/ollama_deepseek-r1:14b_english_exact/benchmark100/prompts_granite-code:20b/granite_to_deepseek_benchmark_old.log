---
- name: Install mysql
  ansible.builtin.apt:
    name: mysql-server
    state: present

- name: Configure mysql server
  community.mysql.mysql_config:
    option: mysql.server
    value: enabled

- name: Configure mysql client
  community.mysql.mysql_config:
    option: mysql.client
    value: enabled

- name: Initialize mysql
  community.mysql.mysql_db:
    name: mysql
    state: present

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Place my.cnf
  ansible.builtin.copy:
    remote_src: false
    content: |
      [mysqld]
      bind-address = 127.0.0.1
      default-storage-engine = InnoDB
      innodb_flush_log_at_trx_commit = 1
    dest: /etc/mysql/my.cnf
    owner: mysql
    group: mysql
    mode: '0644'

- name: Create databases
  community.mysql.mysql_db:
    name: testdb
    state: present

- name: List databases
  community.mysql.mysql_query:
    query: SHOW DATABASES
    register: databases

- name: Import database
  community.mysql.mysql_db:
    name: testdb
    state: import
    backup: /path/to/dump.sql

- name: Create users
  community.mysql.mysql_user:
    name: dbuser
    password: dbpass
    priv: testdb.*:ALL

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: true


