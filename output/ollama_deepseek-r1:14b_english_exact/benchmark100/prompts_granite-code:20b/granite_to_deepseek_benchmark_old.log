---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present

- name: Configure postfix (transport_maps and header_checks)
  template:
    src: "{{ lookup('files', 'files/postfix.transport_maps') }}"
    dest: /etc/postfix/transport_maps
    mode: 0644
    notify: postfix reload
  template:
    src: "{{ lookup('files', 'files/postfix.header_checks') }}"
    dest: /etc/postfix/header_checks
    mode: 0644
    notify: postfix reload

- name: Setting values for main.cf (1/2)
  lineinfile:
    path: /etc/postfix/main.cf
    line: "inet_interfaces = all"
    insertafter: "^[# ]*inet_interfaces"
    state: present

- name: Setting values for main.cf (2/2)
  lineinfile:
    path: /etc/postfix/main.cf
    line: "myhostname = {{ ansible_hostname }}"
    insertafter: "^[# ]*myhostname"
    state: present

- name: Configure postfix (master.cf)
  template:
    src: "{{ lookup('files', 'files/postfix.master.cf') }}"
    dest: /etc/postfix/master.cf
    mode: 0644
    notify: postfix reload

- name: Creates cert/key directory
  file:
    path: /etc/postfix/certs
    state: directory
    mode: 0755

- name: Deploy Postfix TLS server certificate
  copy:
    remote_src: yes
    src: "{{ lookup('files', 'files/postfix.cert.pem') }}"
    dest: /etc/postfix/certs/postfix.cert.pem
    mode: 0644

- name: Deploy Postfix TLS server key
  copy:
    remote_src: yes
    src: "{{ lookup('files', 'files/postfix.key.pem') }}"
    dest: /etc/postfix/certs/postfix.key.pem
    mode: 0644

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: "{{ lookup('files', 'files/postfix.aliases') }}"
    dest: /etc/postfix/aliases
    mode: 0644
    notify: postfix reload

- name: Configure sender_access
  template:
    src: "{{ lookup('files', 'files/postfix.sender_access') }}"
    dest: /etc/postfix/sender_access
    mode: 0644
    notify: postfix reload

- name: Configure recipient_access
  template:
    src: "{{ lookup('files', 'files/postfix.recipient_access') }}"
    dest: /etc/postfix/recipient_access
    mode: 0644
    notify: postfix reload

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  command: systemctl start postfix
  notify: postfix reload
  changed_when: false

- name: Enable postfix service
  command: systemctl enable postfix
  notify: postfix reload
  changed_when: false


