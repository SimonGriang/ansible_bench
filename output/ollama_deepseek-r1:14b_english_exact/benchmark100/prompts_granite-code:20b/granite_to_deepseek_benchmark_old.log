---
- name: Import assert.yml
  include_tasks: files/assert.yml

- name: Install required packages
  package:
    name: "{{ packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: GRUB_TIMEOUT="{{ grub_timeout }}"
    create: yes

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: GRUB_RECORDFAIL_TIMEOUT="{{ grub_recordfail_timeout }}"
    create: yes

- name: Add options to GRUB_CMDLINE_LINUX
  replace:
    path: /etc/default/grub
    replace: 'GRUB_CMDLINE_LINUX="[^"]*"'
    with: 'GRUB_CMDLINE_LINUX="console={{ console_output }} console=ttyS0{{ console_speed }}"'
    regex: true

- name: Import password.yml
  include_tasks: files/password.yml
  when: grub_set_password

- name: Flush handlers
  meta:
    flush_handlers: true


