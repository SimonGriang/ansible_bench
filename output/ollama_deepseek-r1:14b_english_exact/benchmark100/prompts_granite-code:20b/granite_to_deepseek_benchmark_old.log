e_python_version == "3.11"\n\n- name: debian12 | Get python3 version installed\n  ansible.builtin.shell:\n    cmd: python3 --version\n    changed_when: false\n  when: ansible.os_family == "Debian"\n  register: python_version\n\n- name: debian12 | Remove EXTERNALLY-MANAGED\n  ansible.builtin.file:\n    path: /usr/lib/python3.11/site-packagesEXTERNALLY-MANAGED\n    state: absent\n  when:\n    - ansible.os_family == "Debian"\n    - ansible_python_version == "3.11"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-12T09:08:34.877274817Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11194375123, 'load_duration': 88013144, 'prompt_eval_count': 1275, 'prompt_eval_duration': 640634675, 'eval_count': 577, 'eval_duration': 10464450070, 'model_name': 'deepseek-r1:14b'} id='run--77991e78-19be-43fe-bc73-e3c6720af3ec-0' usage_metadata={'input_tokens': 1275, 'output_tokens': 577, 'total_tokens': 1852}
