---
- name: lookup bootstrap facts
  command: cat /etc/os-release
  register: os_release_info

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ os_release_info.stdout|ansible.utils.convert_to_dict|dict2item|first.value.ID }}"
    bootstrap_distribution_major_version: "{{ os_release_info.stdout|ansible.utils.convert_to_dict|dict2item|first.value.VERSION_ID|split('.')[0] }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ lookup('ansible.utils.mapping', {
        'Ubuntu': 'Debian',
        'Debian': 'Debian',
        'Fedora': 'RedHat',
        'CentOS': 'RedHat',
        'RHEL': 'RedHat'
    }, key=bootstrap_distribution) }}"


