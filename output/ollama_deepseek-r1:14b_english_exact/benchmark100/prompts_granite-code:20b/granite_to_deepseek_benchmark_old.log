- name: Install vault
  apt:
    name: vault
    state: present
  become: true
  gather_subset: minimal

- name: Set daemon_reload and restart in handlers
  meta:
    clear_facts: false
  ignore_errors: true

- name: Print install result
  debug:
    msg: "Install result: {{ install_result | to_dict }}"


