    group: vault

- name: Create directory /opt/vault
  file:
    path: /opt/vault
    state: directory

- name: Download Vault binary
  get_url:
    url: "https://example.com/vault-binary"
    dest: /opt/vault/vault
    mode: 0755

- name: Create directory /etc/vault.d
  file:
    path: /etc/vault.d
    state: directory

- name: Copy Vault binary
  copy:
    remote_src: /opt/vault/vault
    dest: /usr/bin/vault
    mode: 0755

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setcap:
    path: /usr/bin/vault
    cap: ipc_lock=ep

- name: Create file /etc/vault.d/vault.env
  file:
    path: /etc/vault.d/vault.env
    state: touch
    mode: 0644

- name: Create directory /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory

- name: Copy Vault service file
  copy:
    remote_src: /path/to/vault.service
    dest: /usr/lib/systemd/system/vault.service
    mode: 0644

- name: Copy vault configuration
  copy:
    remote_src: /path/to/vault.hcl
    dest: /etc/vault.d/vault.hcl
    mode: 0644

- name: Flush handlers
  ansible.builtin.flush_handlers:


