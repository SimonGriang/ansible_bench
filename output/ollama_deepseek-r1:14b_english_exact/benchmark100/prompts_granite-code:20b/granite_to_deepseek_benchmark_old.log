---
- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.systemd:
    name: rke2
    state: restarted
    daemon_reload: yes
    reboot: no

- name: Wait for all nodes to be ready again
  ansible.builtin.k8s:
    api_endpoint: https://{{ rke2_cluster_api_url }}
    resource: nodes
    verb: get
    register: rke2_nodes_status
  until: (rke2_nodes_status.items
          | json_query('*.status.conditions[]')
          | selectattr('type', 'contains', 'Ready')
          | selectattr('status', 'eq', true)
          | list
          | length == (rke2_nodes_status.items
                       | json_query('*.metadata.name')
                       | list
                       | length))
  retries: 60
  delay: 60

- name: Wait for all pods to be ready again
  ansible.builtin.k8s:
    api_endpoint: https://{{ rke2_cluster_api_url }}
    resource: pods
    namespace: all
    verb: get
    register: rke2_pods_status
  until: (rke2_pods_status.items
          | json_query('*.status.phase')
          | list
          | all(contains(['running', 'succeeded'])))
  retries: 60
  delay: 60


