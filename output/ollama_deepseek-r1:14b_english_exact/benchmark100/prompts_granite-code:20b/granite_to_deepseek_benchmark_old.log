---
- name: Install apache httpd
  apt:
    name: apache2
    state: present
  become: true

- name: Configure selinux
  selinux:
    boolean: httpd_setsebool
    value: true
    persist: true
  become: true

- name: Configure httpd
  template:
    src: httpd.conf.j2
    dest: /etc/httpd/conf/httpd.conf
    owner: root
    group: root
    mode: 0o0644
  notify: test_httpd_config

- name: Activate httpd module | Debian
  command: a2enmod httpd
  when: ansible_os_family == "Debian"
  notify: test_httpd_config

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations.yml
  import_tasks: locations.yml
  when: httpd_locations

- name: Import vhosts.yml
  import_tasks: vhosts.yml
  when: httpd_vhosts

- name: Configure ports
  template:
    src: ports.conf.j2
    dest: /etc/apache2/ports.conf
    owner: root
    group: root
    mode: 0o0644
  when: ansible_os_family in ['Debian', 'Suse']
  notify: test_httpd_config

- name: Import directories.yml
  import_tasks: directories.yml
  when: httpd_directories

- name: Flush handlers
  flush_handlers: yes

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: apache2
    state: started
    enabled: true
  become: true


