---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Ensure that logrotate is installed.
  apt:
    name: logrotate
    state: present

- name: Template /etc/logrotate.conf using the template.
  template:
    src: logrotate.conf.j2
    dest: /etc/logrotate.conf
  vars:
    logrotate_log_size: "{{ logrotate_log_size }}"
    logrotate_rotate: "{{ logrotate_rotate }}"

- name: Template /etc/logrotate.d/{{ item.name }} using the template.
  include_tasks: create_logrotate_d.yml
  loop: "{{ logrotate_services }}"

- name: Remove /etc/logrotate.d/{{ item.name }}.
  include_tasks: remove_logrotate_d.yml
  loop: "{{ logrotate_services }}"

- name: Start the logrotate service.
  service:
    name: logrotate
    state: started
    enabled: yes


