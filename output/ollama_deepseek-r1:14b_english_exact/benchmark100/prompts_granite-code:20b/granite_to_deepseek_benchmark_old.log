---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  file:
    path: /usr/lib/python3.11EXTERNALLY-MANAGED
    state: absent
  ignore_errors: yes

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  rename:
    src: /usr/lib/python3.11EXTERNALLY-MANAGED
    dest: /usr/lib/python3.11EXTERNALLY-MANAGED.renamed
  ignore_errors: yes

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  file:
    path: /usr/lib/python3.12EXTERNALLY-MANAGED
    state: absent
  ignore_errors: yes

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  rename:
    src: /usr/lib/python3.12EXTERNALLY-MANAGED
    dest: /usr/lib/python3.12EXTERNALLY-MANAGED.renamed
  ignore_errors: yes

- name: Import assert.yml
  import_tasks: assert.yml
  ignore_errors: yes

- name: Install python pip
  apt:
    name: pip
    state: installed
    update_cache: yes
  ignore_errors: yes

- name: Configure pip proxy
  template:
    dest: ~/.config/pip/pip.conf
    mode: 0o644
  ignore_errors: yes

- name: Trust hosts
  apt:
    name: openssh-server
    state: present
  ignore_errors: yes

- name: Update pip.
  command: pip install --upgrade pip
  chdir: ~/
  becomes: yes
  ignore_errors: yes

- name: Install requested modules
  pip:
    name: "{{ modules }}"
