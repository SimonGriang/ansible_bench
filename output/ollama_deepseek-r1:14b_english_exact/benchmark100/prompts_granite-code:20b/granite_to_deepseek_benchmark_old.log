n.\n\nFinally, I\'ll make sure the YAML is correctly formatted, with each task under the \'tasks\' key, and no extra comments or explanations—just the necessary playbook content.\n</think>\n\n```yaml\n---\n- name: Install git\n  apt:\n    name: "{{ git_packages }}"\n    state: present\n\n- name: See if the specified user exists\n  getent:\n    db: passwd\n    user: "{{ git_username }}"\n  register: check_user\n\n- name: Create directory for git configuration\n  file:\n    path: "{{ git_config_dir }}"\n    state: directory\n    owner: "{{ git_username }}"\n    group: "{{ git_groupname }}"\n    mode: \'0755\'\n\n- name: Place git configuration\n  template:\n    src: git_config.j2\n    dest: "{{ git_home_dir }}/.gitconfig"\n    owner: "{{ git_username }}"\n    group: "{{ git_groupname }}"\n    mode: \'0644\'\n    variables:\n      git_user_email: "{{ git_user_email }}"\n      git_user_name: "{{ git_user_name }}"\n      git_username: "{{ git_username }}"\n\n- name: Create repository_destination\n  file:\n    path: "{{ git_repository_destination }}"\n    state: directory\n    owner: "{{ git_username }}"\n    group: "{{ git_groupname }}"\n    mode: \'0755\'\n\n- name: Clone all roles\n  git:\n    repo: "{{ item.repository }}"\n    dest: "{{ git_repository_destination }}"\n    state: cloned\n    version: "{{ item.version }}"\n  loop: "{{ git_repositories }}"\n  become_user: "{{ git_username }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-12T10:18:21.171608514Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14760637370, 'load_duration': 90457915, 'prompt_eval_count': 541, 'prompt_eval_duration': 341366429, 'eval_count': 736, 'eval_duration': 14328014361, 'model_name': 'deepseek-r1:14b'} id='run--58a839d4-95b3-4e9d-8797-bd9bca13d256-0' usage_metadata={'input_tokens': 541, 'output_tokens': 736, 'total_tokens': 1277}
