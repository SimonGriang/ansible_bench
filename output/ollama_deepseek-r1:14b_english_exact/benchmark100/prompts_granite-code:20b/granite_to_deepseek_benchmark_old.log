---
- name: Install mysql
  apt-get:
    name: mysql-server
    state: present

- name: Configure mysql server
  mysql_config:
    option: mysql.server
    value: enabled

- name: Configure mysql client
  mysql_config:
    option: mysql.client
    value: enabled

- name: Initialize mysql
  mysql_db:
    name: mysql
    state: present

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  meta:
    flush_handlers: true

- name: Place my.cnf
  file:
    path: /etc/mysql/my.cnf
    content: |
      [mysqld]
      bind-address = 127.0.0.1
      default-storage-engine = InnoDB
      innodb_flush_log_at_trx_commit = 1
    owner: mysql
    group: mysql
    mode: 0644

- name: Create databases
  mysql_db:
    name: testdb
    state: present

- name: List databases
  mysql_query:
    query: SHOW DATABASES
    register: databases

- name: Import database
  mysql_db:
    name: testdb
    state: import
    backup: /path/to/dump.sql

- name: Create users
  mysql_user:
    name: dbuser
    password: dbpass
    priv: testdb.*:ALL

- name: Flush handlers again
  meta:
    flush_handlers: true


