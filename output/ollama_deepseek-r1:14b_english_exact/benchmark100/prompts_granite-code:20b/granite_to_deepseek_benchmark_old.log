---
- name: Disable swap
  systemd:
    service: swap
    state: disabled

- name: Disable core dumps
  sysctl:
    name: fs.suid_dumpable
    value: 0
    persist: yes

- name: Disable Shell Command History
  file:
    path: /etc/profile
    content: |
      HISTSIZE=0
      HISTFILE=/dev/null
