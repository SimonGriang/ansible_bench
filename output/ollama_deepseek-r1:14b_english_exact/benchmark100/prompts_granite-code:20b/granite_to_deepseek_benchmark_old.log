- name: Check current docker-compose version
  command: docker-compose --version
  register: docker_compose_version
  changed_when: false
  ignore_errors: yes

- name: Set fact for docker compose current version
  set_fact:
    docker_compose_current_version: "{{ docker_compose_version.stdout.split(' ')[1] }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: "{{ docker_compose_current_version }}" != "{{ docker_compose_version.stdout.split(' ')[1] }}"

- name: Install Docker Compose
  command: curl -L "https://github.com/docker/compose/releases/download/{{ docker_compose_version.stdout.split(' ')[1] }}/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
  when: "{{ docker_compose_current_version }}" is not defined or "{{ docker_compose_current_version }}" != "{{ docker_compose_version.stdout.split(' ')[1] }}"

- name: Make docker-compose executable
  command: chmod +x /usr/local/bin/docker-compose
  when: "{{ docker_compose_current_version }}" is not defined or "{{ docker_compose_current_version }}" != "{{ docker_compose_version.stdout.split(' ')[1] }}"


