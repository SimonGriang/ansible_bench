---
- name: Ensure old versions of Docker are not installed
  ansible.builtin.dnf:
    name: docker*
    state: absent
  become: true

- name: Add Docker GPG key
  ansible.builtin.apt_key:
    url: https://download.docker.com/linux/centos/gpg
    state: present
  become: true

- name: Add Docker repository
  ansible.builtin.dnf:
    name: docker-ce
    state: present
  become: true

- name: Configure Docker Nightly repo
  ansible.builtin.template:
    src: containerd.repo
    dest: /etc/yum.repos.d/nightly.repo
    owner: root
    group: root
    mode: '0o644'
  become: true

- name: Configure Docker Test repo
  ansible.builtin.template:
    src: containerd.repo
    dest: /etc/yum.repos.d/test.repo
    owner: root
    group: root
    mode: '0o644'
  become: true

- name: Configure containerd on RHEL 8
  ansible.builtin.service:
    name: containerd
    state: running
    enabled: true
  become: true


