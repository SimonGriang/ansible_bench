---
- name: create | Create ssl key
  community.crypto.openssl_privatekey:
    path: /etc/ssl/private/ssl.key
    state: present
    mode: 384
  become: true

- name: create | Create ssl csr
  community.crypto.openssl_csr:
    privatekey_path: /etc/ssl/private/ssl.key
    path: /etc/ssl/csr/ssl.csr
    common_name: example.com
    org_name: Example Inc.
    country_name: US
    state: California
    city: San Francisco
    dest: /etc/ssl/csr
    mode: 384
    state: present
  become: true

- name: create | Create ssl certificates
  community.crypto.x509_certificate:
    path: /etc/ssl/certs/ssl.crt
    csr_path: /etc/ssl/csr/ssl.csr
    validity: 365
    dest: /etc/ssl/certs
    mode: 384
    provider: legacy
  become: true

- name: create | Create PKCS#12 file
  community.crypto.openssl_pkcs12:
    name: /etc/ssl/pkcs12/ssl.pfx
    privatekey_path: /etc/ssl/private/ssl.key
    certificate_path: /etc/ssl/certs/ssl.crt
    format: pkcs12
    dest: /etc/ssl/pkcs12
    mode: 384
  become: true

- name: create | Read private key
  ansible.builtin.slurp:
    path: /etc/ssl/private/ssl.key
  register: private_key_content

- name: create | Read certificate
  ansible.builtin.slurp:
    path: /etc/ssl/certs/ssl.crt
  register: certificate_content

- name: create | Create combined private_key and certificate file
  ansible.builtin.file:
    path: /etc/ssl/combined/ssl.pem
    state: present
    content: "{{ private_key_content.string + certificate_content.string }}"
    mode: 384
  become: true


