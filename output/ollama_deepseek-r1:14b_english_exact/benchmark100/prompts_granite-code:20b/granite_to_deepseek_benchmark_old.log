---
- name: Install required software
  apt:
    name: "{{ users_requirements }}"
    state: present

- name: Loop over users_groups
  include_tasks:
    file: group.yml
    loop: "{{ users_groups }}"
    loop_var: group
  vars:
    group_name: "{{ group.name }}"

- name: Ensure the /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "^(@|#)includedir /etc/sudoers.d"
    state: present
    regex: "^(@|#)includedir"
    validate: visudo

- name: Loop over users
  include_tasks:
    file: user.yml
    loop: "{{ users }}"
    loop_var: user
  vars:
    user_name: "{{ user.name }}"

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: "0644"
  when: users_cron_allow

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow


