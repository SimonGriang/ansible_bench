 set.\n\nI'll make sure that all module names are correctly prefixed with their FQCN and that the file permissions are set to prevent any security issues.\n\nAfter making these changes, I'll test the playbook again to ensure it passes ansible-lint without any errors.\n</think>\n\n```yaml\n---\n- name: Ensure /etc/openvpn/easy-rsa exists\n  ansible.builtin.file:\n    path: /etc/openvpn/easy-rsa\n    state: directory\n\n- name: Easyrsa init-pki\n  ansible.builtin.command:\n    cmd: easyrsa init-pki\n    become: true\n  changed_when: false\n\n- name: Build CA for easyrsa\n  ansible.builtin.command:\n    cmd: easyrsa build-ca\n    become: true\n  changed_when: false\n\n- name: Generate DH parameters\n  ansible.builtin.command:\n    cmd: easyrsa gen-dh\n    become: true\n  changed_when: false\n\n- name: Build server key and certificate\n  ansible.builtin.command:\n    cmd: easyrsa build-server-full server nopass\n    become: true\n  changed_when: false\n\n- name: Build client key and certificate\n  ansible.builtin.command:\n    cmd: easyrsa build-client-full client nopass\n    become: true\n  changed_when: false\n\n- name: Generate certificate revocation list\n  ansible.builtin.command:\n    cmd: easyrsa gen-crl\n    become: true\n  changed_when: false\n\n- name: Generate openvpn key\n  ansible.builtin.command:\n    cmd: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key\n    become: true\n  changed_when: false\n\n- name: Copy ca.crt to /etc/openvpn/server\n  ansible.builtin.copy:\n    src: /etc/openvpn/easy-rsa/pki/ca.crt\n    dest: /etc/openvpn/server/ca.crt\n    remote_src: false\n    mode: 644\n\n- name: Copy dh.pem to /etc/openvpn/server\n  ansible.builtin.copy:\n    src: /etc/openvpn/easy-rsa/pki/dh.pem\n    dest: /etc/openvpn/server/dh.pem\n    remote_src: false\n    mode: 644\n\n- name: Copy ta.key to /etc/openvpn/server\n  ansible.builtin.copy:\n    src: /etc/openvpn/easy-rsa/pki/ta.key\n    dest: /etc/openvpn/server/ta.key\n    remote_src: false\n    mode: 644\n\n- name: Copy client.crt to /etc/openvpn/server\n  ansible.builtin.copy:\n    src: /etc/openvpn/easy-rsa/pki/issued/client.crt\n    dest: /etc/openvpn/server/issued/client.crt\n    remote_src: false\n    mode: 644\n\n- name: Copy server.crt to /etc/openvpn/server\n  ansible.builtin.copy:\n    src: /etc/openvpn/easy-rsa/pki/issued/server.crt\n    dest: /etc/openvpn/server/issued/server.crt\n    remote_src: false\n    mode: 644\n\n- name: Copy ca.key to /etc/openvpn/server\n  ansible.builtin.copy:\n    src: /etc/openvpn/easy-rsa/pki/private/ca.key\n    dest: /etc/openvpn/server/private/ca.key\n    remote_src: false\n    mode: 600\n\n- name: Copy client.key to /etc/openvpn/server\n  ansible.builtin.copy:\n    src: /etc/openvpn/easy-rsa/pki/private/client.key\n    dest: /etc/openvpn/server/private/client.key\n    remote_src: false\n    mode: 600\n\n- name: Copy server.key to /etc/openvpn/server\n  ansible.builtin.copy:\n    src: /etc/openvpn/easy-rsa/pki/private/server.key\n    dest: /etc/openvpn/server/private/server.key\n    remote_src: false\n    mode: 600\n\n- name: Copy ca.crt to /etc/openvpn\n  ansible.builtin.copy:\n    src: /etc/openvpn/easy-rsa/pki/ca.crt\n    dest: /etc/openvpn/ca.crt\n    remote_src: false\n    mode: 644\n\n- name: Copy ta.key to /etc/openvpn\n  ansible.builtin.copy:\n    src: /etc/openvpn/easy-rsa/pki/ta.key\n    dest: /etc/openvpn/ta.key\n    remote_src: false\n    mode: 644\n\n- name: Place server.conf\n  ansible.builtin.template:\n    src: server.conf.j2\n    dest: /etc/openvpn/server.conf\n```" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-12T09:18:53.33385754Z', 'done': True, 'done_reason': 'stop', 'total_duration': 44160153885, 'load_duration': 81550239, 'prompt_eval_count': 7730, 'prompt_eval_duration': 5592063438, 'eval_count': 1469, 'eval_duration': 38484155865, 'model_name': 'deepseek-r1:14b'} id='run--886bf6ee-7bff-4802-acec-725af440db79-0' usage_metadata={'input_tokens': 7730