---
- name: Import assert.yml
  import_playbook:
    file: assert.yml

- name: Install required packages
  package:
    name: "{{ packages }}"
    state: present

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: /etc/systemd/system/myservice.service
  when: ansible_service_mgr == "systemd"

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: /etc/init.d/myservice
  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]

- name: Manage service
  service:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    enabled: "{{ item.enabled }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers


