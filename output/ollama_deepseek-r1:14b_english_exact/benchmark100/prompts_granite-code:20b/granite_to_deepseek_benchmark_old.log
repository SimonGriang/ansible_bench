- name: Create docroot
  ansible.builtin.file:
    path: /var/www/html
    state: directory
    mode: '755'

- name: Configure vhosts
  ansible.builtin.template:
    src: vhosts.apache.j2
    dest: /etc/apache2/sites-available/000-default.conf
    owner: www-data
    mode: '644'

- name: Enable vhosts
  ansible.builtin.apache2:
    name: 000-default
    state: present
    enable: true


