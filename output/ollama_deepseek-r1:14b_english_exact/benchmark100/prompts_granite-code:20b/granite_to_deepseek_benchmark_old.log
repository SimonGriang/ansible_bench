- name: lookup bootstrap facts (raw)
  command:
    cmd: curl -sS https://bootstrap-fact.f ile
  register: bootstrap_facts

- name: set bootstrap facts (I) # noqa jinja
  set_fact:
    bootstrap_distribution: "{{ item.value.0 if item.value.0 else '' }}"
    bootstrap_distribution_major_version: "{{ item.value.1 if item.value.1 else '' }}"
  loop: "{{ bootstrap__os_family_map | dict2list }}"
  when: "'{{ item.key }}' in {{ bootstrap_facts.stdout }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.value.2 if item.value.2 else '' }}"
  loop: "{{ bootstrap__os_family_map | dict2list }}"
  when: "'{{ item.key }}' in {{ bootstrap_facts.stdout }}"


