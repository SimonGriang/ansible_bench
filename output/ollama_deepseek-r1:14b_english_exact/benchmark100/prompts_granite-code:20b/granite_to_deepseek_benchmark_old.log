 ensure that each task uses the correct conditionals where necessary, like when the file exists for tasks 5 and 6.\n\nLet me structure each task step by step, making sure the YAML syntax is correct and that each task is properly indented and formatted.\n</think>\n\n```yaml\n---\n- name: Create the RKE2 config dir\n  file:\n    path: /etc/rke2/config\n    state: directory\n\n- name: Set server taints\n  kubernetes.py:\n    action: set_taints\n    node_selector: kubernetes.io/role == \'node\' && node-role.kubernetes.io/master == \'true\'\n    taints: "{{ server_taints }}"\n\n- name: Set agent taints\n  kubernetes.py:\n    action: set_taints\n    node_selector: kubernetes.io/role == \'node\' && node-role.kubernetes.io/worker == \'true\'\n    taints: "{{ agent_taints }}"\n\n- name: Copy RKE2 config\n  copy:\n    remote_src: yes\n    src: /etc/rke2/rke2.yaml\n    dest: /etc/rke2/config/rke2.yaml\n    owner: root\n    group: root\n\n- name: Copy kubelet config\n  copy:\n    remote_src: yes\n    src: /etc/kubernetes/kubelet.yaml\n    dest: /etc/rke2/config/kubelet.yaml\n    owner: root\n    group: root\n  when: kubelet_config exists\n\n- name: Copy Containerd Registry Configuration file\n  copy:\n    remote_src: yes\n    src: /etc/containerd/registry.json\n    dest: /etc/rke2/config/registry.json\n    owner: root\n    group: root\n  when: containerd_registry_config exists\n\n- name: Start RKE2 service\n  service:\n    name: rke2\n    state: started\n    enabled: yes\n\n- name: Mask other RKE2 service\n  service:\n    name: rke2@*\n    state: stopped\n    enabled: no\n\n- name: Wait for remaining nodes to be ready - no CNI\n  wait_for:\n    path: http://localhost:6443/healthz\n    state: started\n    timeout: 600\n  when: cni_used == false\n\n- name: Wait for remaining nodes to be ready - with CNI\n  wait_for:\n    path: http://localhost:6443/healthz\n    state: started\n    timeout: 600\n  when: cni_used == true\n```' additional_kwargs={} response_metadata={'model': 'deeps