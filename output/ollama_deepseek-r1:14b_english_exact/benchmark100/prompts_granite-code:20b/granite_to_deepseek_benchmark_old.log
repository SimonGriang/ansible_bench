---
- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  ansible.builtin.file:
    path: /usr/lib/python3.11EXTERNALLY-MANAGED
    state: absent
  register: check_python3_11
  changed_when: false
  failed_when: "{{ check_python3_11.rc }} != 0"

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.rename:
    src: /usr/lib/python3.11EXTERNALLY-MANAGED
    dest: /usr/lib/python3.11EXTERNALLY-MANAGED.renamed
  ignore_errors: true

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  ansible.builtin.file:
    path: /usr/lib/python3.12EXTERNALLY-MANAGED
    state: absent
  register: check_python3_12
  changed_when: false
  failed_when: "{{ check_python3_12.rc }} != 0"

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.rename:
    src: /usr/lib/python3.12EXTERNALLY-MANAGED
    dest: /usr/lib/python3.12EXTERNALLY-MANAGED.renamed
  ignore_errors: true

- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  ignore_errors: true

- name: Install python pip
  ansible.builtin.apt:
    name: pip
    state: present
    update_cache: true
  ignore_errors: true

- name: Configure pip proxy
  ansible.builtin.template:
    dest: ~/.config/pip/pip.conf
    mode: "0644"
  ignore_errors: true

- name: Trust hosts
  ansible.builtin.apt:
    name: openssh-server
    state: present
  ignore_errors: true

- name: Update pip.
  ansible.builtin.command:
    cmd: pip install --upgrade pip
  ignore_errors: true

- name: Install requested modules
  ansible.builtin.pip:
    name: "{{ modules }}"
    state: present
  ignore_errors: true


