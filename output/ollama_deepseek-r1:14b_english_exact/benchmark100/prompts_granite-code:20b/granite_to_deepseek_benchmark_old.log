---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install cron
  apt:
    name: cron
    state: installed
    restart: yes
    updated_cache: yes

- name: Configure shell
  file:
    path: /bin/sh
    content: '#!/bin/bash\n'
    owner: root
    group: root
    mode: 0755
    backup: yes

- name: Configure path
  file:
    path: /etc/path
    content: 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    owner: root
    group: root
    mode: 0644
    backup: yes

- name: Configure mailto
  file:
    path: /etc/mailto
    content: 'root'
    owner: root
    group: root
    mode: 0644
    backup: yes

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: yes

- name: Schedule requested cron jobs
  cron:
    name: scheduled_cron_job
    minute: */5
    command: /usr/bin/crontab -l
    user: root
    state: present


