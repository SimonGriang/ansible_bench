- name: Set server taints
  kubernetes.core.k8s_set_taints:
    name: "{{ inventory_hostname }}"
    taints: "{{ rke2_server_node_taints | default([]) | list }}"
    namespace: default
  when: rke2_server_node_taints is defined

- name: Copy rke2 config
  copy:
    src: "{{ rke2_config_source }}"
    dest: /etc/rancher/rke2/config.yaml
    mode: 0600

- name: Copy kubelet config
  copy:
    src: "{{ rke2_kubelet_config | default('') }}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: 0600
  when: rke2_kubelet_config is defined

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_custom_registry_configs | default('') }}"
    dest: /etc/rancher/rke2/registries.yaml
    mode: 0600
  when: (rke2_custom_registry_mirrors is defined or
         rke2_custom_registry_configs is defined)

- name: Register if we need to do etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined }}"

- name: Register if we need to do etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ (
      rke2_etcd_snapshot_s3_options.access_key is defined and
      rke2_etcd_snapshot_s3_options.secret_key is defined and
      rke2_etcd_snapshot_s3_options.bucket is defined and
      rke2_etcd_snapshot_s3_options.snapshot_name is defined
    ) | bool }}"

- name: Restore etcd from file
  when: do_etcd_restore | default(false) | bool
  become: true
  shell: |
    mkdir -p /var/lib/rke2/etcd-snapshot
    cp {{ rke2_etcd_snapshot_file }} /var/lib/rke2/etcd-snapshot/etcd-snapshot
    systemctl restart rke2-server

- name: Restore etcd from s3
  when: do_etcd_restore_from_s3 | default(false) | bool
  become: true
  shell: |
    rke2 server --s3-endpoint="{{ rke2_etcd_snapshot_s3_options.endpoint | default('') }}"
      --s3-bucket="{{ rke2_etcd_snapshot_s3_options.bucket }}"
      --s3-access-key="{{ rke2_etcd_snapshot_s3_options.access_key }}"
      --s3-secret-key="{{ rke2_etcd_snapshot_s3_options.secret_key }}"
      --s3-object-prefix="{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: yes

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: masked

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: /bin/sh
    delay: 5
    timeout: 600
    state: started
  when: rke2_no_cni is true

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: /bin/sh
    delay: 5
    timeout: 600
    state: started

- name: Restore etcd
  when: (do_etcd_restore or do_etcd_restore_from_s3) | bool
  become: true
  shell: |
    rm -f /etc/rancher/rke2/ssl/known_nodes/Node-{{ inventory_hostname }}.node-password.rke2
    rke2 server --remove-old-nodes

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ rke2_cluster_group_name | default('all') }}"
  delegate_facts: true
