---
- name: Import assert.yml
  import_tasks: files/assert.yml

- name: Uninstall conflicting systemd-logger
  apt:
    name: systemd-logger
    state: purged

- name: Install rsyslog
  apt:
    name: rsyslog
    state: present

- name: Install additional rsyslog packages
  apt:
    name: rsyslog-mysql
    state: present

- name: Configuring default rsyslog
  command: rsyslog-configure

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d
    state: directory

- name: Configuring rsyslog forward rule
  lineinfile:
    path: /etc/rsyslog.conf
    line: '*.*;authpriv.none;authpriv.* action.SyslogAction("remote_host", facility=none)'
    insertafter: '$template RSGeneric, "%syslogtag% %msg%\n"

- name: Configuring additional config files
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.d/99-logging.conf

- name: Start and enable rsyslog
  service:
    name: rsyslog
    state: started
    enabled: yes


