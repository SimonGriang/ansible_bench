---
- name: Install mysql
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
  loop:
    - mysql-server
    - mysql-client

- name: Configure mysql server
  ansible.builtin.template:
    src: mysql.server.cnf.j2
    dest: /etc/mysql/mysql.conf.d/mysqldump.cnf
    owner: mysql
    group: mysql
    mode: '0644'

- name: Configure mysql client
  ansible.builtin.template:
    src: mysql.client.cnf.j2
    dest: /etc/mysql/mysql.conf.d/mysql.cnf
    owner: mysql
    group: mysql
    mode: '0644'

- name: Initialize mysql
  mysql_systemd_init:
    state: started

- name: Start and enable mysql
  ansible.builtin.systemctl:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.flush:

- name: Place my.cnf
  ansible.builtin.template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: mysql
    group: mysql
    mode: '0644'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
  loop:
    - "{{ db_name }}"

- name: List databases
  mysql_command:
    command: "SHOW DATABASES;"
    state: present

- name: Import database
  mysql:
    db: "{{ db_name }}"
    sql_file: /path/to/database.sql
    state: present

- name: Create users
  community.mysql.mysql_user:
    name: "{{ db_user }}"
    db: "{{ db_name }}"
    priv: "ALL PRIVILEGES"
    state: present

- name: Flush handlers again
  ansible.builtin.flush:


