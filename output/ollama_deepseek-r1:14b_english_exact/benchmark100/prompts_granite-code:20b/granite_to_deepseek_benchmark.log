---
- name: Install ssl packages
  apt-get:
    name: "{{ item }}"
    state: present
  loop:
    - ssl-cert
    - ssl privateKey
    - ssl Certificate
    - ssl lib_SSL
    - ssl utils

- name: Place configuration
  copy:
    remote_src: true
    src: https://example.com/ssl.conf
    dest: /etc/nginx/ssl.conf
    owner: root
    group: root
    mode: 0644

- name: Configure redirect from http to https
  template:
    src: nginx.conf.j2
    dest: /etc/nginx/sites-available/nginx.conf
    owner: root
    group: root
    mode: 0644
  notify: reload_nginx

- name: reload nginx
  service:
    name: nginx
    state: reloaded


