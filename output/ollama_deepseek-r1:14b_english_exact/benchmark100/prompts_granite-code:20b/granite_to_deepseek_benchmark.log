---
- name: Import assert.yml
  import_tasks: assert.yml

- name: Install prerequisites
  apt:
    name: "vault"
    state: present

- name: Include installation method specific tasks
  include_tasks: installation_method.yml

- name: Add Vault environment variables
  file:
    path: ~/.bashrc
    content: |
      VAULT_ADDR=http://127.0.0.1:8200
      VAULT_CACERT=/etc/vault/certs/ca.pem
      VAULT_CLIENT_CERT=/etc/vault/certs/client.pem
      VAULT_CLIENT_KEY=/etc/vault/certs/client-key.pem
    append: yes

- name: Include hardening tasks
  include_tasks: hardening.yml

- name: Start and enable vault
  when: vault_type == "oss"
  ansible.builtin.command:
    cmd: systemctl start vault
  ansible.builtin.systemd:
    name: vault
    state: started

- name: Enable vault
  when: vault_type != "oss"
  ansible.builtin.systemd:
    name: vault
    state: started


