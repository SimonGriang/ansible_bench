    dest: /etc/init.d/myservice
    mode: '755'
  when: ansible_service_mgr in ["sysvinit", "upstart", "openrc"]

- name: Manage service
  ansible.builtin.service:
    name: myservice
    state: "{{ item.state }}"
    enabled: "{{ item.enabled }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true


