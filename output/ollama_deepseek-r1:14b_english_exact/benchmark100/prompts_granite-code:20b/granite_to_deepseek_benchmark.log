---
- name: Cordon and Drain the node {{ rke2_node_name }}
  ansible.builtin.command:
    cmd: >
      kubectl drain {{ rke2_node_name }} --ignore-daemonsets --ignore-drain-not-ready --ignore-pods-without-binding --force
  vars:
    ansible_skip: "{{ 'rke2_drain_node_during_upgrade' | default('true') | bool }}"

- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible systemd:
    name: rke2
    state: restarted

- name: Wait for all nodes to be ready again
  kubernetes.core.wait_for_nodes:
    state: present
    ready: true

- name: Uncordon the node {{ rke2_node_name }}
  ansible.builtin.command:
    cmd: >
      kubectl uncordon {{ rke2_node_name }}
  vars:
    ansible_skip: "{{ 'rke2_drain_node_during_upgrade' | default('true') | bool }}"

- name: Wait for all pods to be ready again
  kubernetes.core.wait_for_pods:
    state: ready
    pod_status: running
  vars:
    ansible_skip: "{{ 'rke2_wait_for_all_pods_to_be_ready' | default('true') | bool }}"

- name: Wait for all pods to pass readiness checks
  kubernetes.core.wait_for_pods:
    state: present
    pod_health: healthy
  vars:
    ansible_skip: "{{ 'rke2_wait_for_all_pods_to_be_healthy' | default('true') | bool }}"


