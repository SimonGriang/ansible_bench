---
- name: Create docroot directory for each virtual host
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  loop:
    - "{{ httpd_vhosts }}"
  when: create_docroot | default(true)
  loop_control:
    label: "Creating docroot directory for {{ item.name }}"

- name: Configure virtual host settings
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: 0644
  loop:
    - "{{ httpd_vhosts }}"
  loop_control:
    label: "Configuring virtual host {{ item.name }}"
  notify: 
    - Test httpd configuration validity
    - Restart httpd


