---
- name: Install mysql
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - mysql-server
    - mysql-client

- name: Configure mysql server
  template:
    src: mysql.server.cnf.j2
    dest: /etc/mysql/mysql.conf.d/mysqldump.cnf
    owner: mysql
    group: mysql
    mode: 0644

- name: Configure mysql client
  template:
    src: mysql.client.cnf.j2
    dest: /etc/mysql/mysql.conf.d/mysql.cnf
    owner: mysql
    group: mysql
    mode: 0644

- name: Initialize mysql
  mysql_systemd_init:
    state: started

- name: Start and enable mysql
  systemctl:
    name: mysql
    state: started
    enabled: yes

- name: Flush handlers
  ansible.builtin.flush:

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    owner: mysql
    group: mysql
    mode: 0644

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop:
    - "{{ db_name }}"

- name: List databases
  mysql_command:
    command: "SHOW DATABASES;"
    state: present

- name: Import database
  mysql:
    db: "{{ db_name }}"
    sql_file: /path/to/database.sql
    state: present

- name: Create users
  mysql_user:
    name: "{{ db_user }}"
    db_name: "{{ db_name }}"
    priv: "ALL PRIVILEGES"
    state: present

- name: Flush handlers again
  ansible.builtin.flush:


