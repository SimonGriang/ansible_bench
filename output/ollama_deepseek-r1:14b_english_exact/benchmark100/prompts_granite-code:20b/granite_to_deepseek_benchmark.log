---
- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: /opt/rke2/manifests
    state: directory
    group: root
    mode: 493

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    remote_src: true
    src: files/kube-vip/
    dest: /opt/rke2/manifests/
    group: root
    mode: 493

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    remote_src: true
    src: files/kube-vip/loadbalancer/
    dest: /opt/rke2/manifests/
    group: root
    mode: 493
  when: rke2_kubevip_cloud_provider_enable | default(false)


