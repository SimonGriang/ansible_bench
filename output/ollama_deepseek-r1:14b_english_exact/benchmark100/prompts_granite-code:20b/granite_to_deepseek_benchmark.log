---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install mysql
  ansible.builtin.apt:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  ansible.builtin.template:
    src: "{{ mysql_configuration_destination }}"
    dest: /etc/mysql/my.cnf
    vars:
      mysql_name: "{{ mysql_name }}"
      mysql_configuration_options: "{{ mysql_configuration_options }}"
      mysql_socket: "{{ mysql_socket }}"
    mode: '0644'

- name: Configure mysql client
  ansible.builtin.template:
    src: "{{ mysql_configuration_destination }}"
    dest: /etc/mysql/my.cnf.client
    vars:
      mysql_name: "{{ mysql_name }}"
      mysql_socket: "{{ mysql_socket }}"
    mode: '0644'

- name: Initialize mysql
  ansible.builtin.shell:
    cmd: "{{ mysql_initialize_command }}"
    changed_when: false

- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.shell:
    cmd: ansible-playbook --flush-handlers
    changed_when: false

- name: Place my.cnf
  ansible.builtin.copy:
    remote_src: "{{ my.cnf.j2 }}"
    remote_path: /root/.my.cnf
    mode: '0600'

- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"

- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  ansible.builtin.shell:
    cmd: ansible-playbook --flush-handlers
    changed_when: false


