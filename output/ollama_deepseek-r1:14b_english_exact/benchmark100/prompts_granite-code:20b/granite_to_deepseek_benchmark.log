---
- name: Import assert.yml
  ansible.builtin.import_tasks: ../assert.yml

- name: Pre-configure debian systems
  ansible.builtin.apt:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.apt:
    name: postfix-mysql
    state: present

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: transport_maps.cf.j2
    dest: /etc/postfix/transport_maps.cf
    mode: 420

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: header_checks(cf.j2)
    dest: /etc/postfix/header_checks.cf
    mode: 420

- name: Setting values for main.cf (1/2)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 420

- name: Setting values for main.cf (2/2)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 420

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 420

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master(cf.j2)
    dest: /etc/postfix/master.cf
    mode: 420

- name: Creates cert/key directory
  ansible.builtin.file:
    path: /etc/postfix/tls
    state: directory
    owner: postfix
    mode: 755

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: /path/to/certificate.pem
    dest: /etc/postfix/tls/certificate.pem
    owner: postfix
    mode: 600

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: /path/to/key.pem
    dest: /etc/postfix/tls/key.pem
    owner: postfix
    mode: 600

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Configure aliases
  ansible.builtin.template:
    src: aliases
    dest: /etc/aliases
    mode: 420

- name: Configure sender_access
  ansible.builtin.template:
    src: sender_access
    dest: /etc/postfix/sender_access
    mode: 420

- name: Configure recipient_access
  ansible.builtin.template:
    src: recipient_access
    dest: /etc/postfix/recipient_access
    mode: 420

- name: Place sasl_password_map
  ansible.builtin.template:
    src: sasl_password_map
    dest: /etc/postfix/sasl_password_map
    mode: 420

- name: Flush handlers again
  ansible.builtin.meta:
    flush_handlers: true

- name: Start and enable postfix
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: true


