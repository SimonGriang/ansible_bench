 facts (I)\n  set_fact:\n    bootstrap_distribution: "{{ distribution }}"\n    bootstrap_distribution_major_version: "{{ version }}"\n  loop:\n    - { distribution: "Ubuntu", version: "22.04" }\n    - { distribution: "CentOS", version: "8" }\n    - { distribution: "Fedora", version: "38" }\n\n- name: set bootstrap facts (II)\n  set_fact:\n    bootstrap_os_family: "{{ item.value }}"\n  loop:\n    - { key: "Ubuntu", value: "Debian" }\n    - { key: "CentOS", value: "RedHat" }\n    - { key: "Fedora", value: "RedHat" }\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-22T07:48:52.591006365Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9846048582, 'load_duration': 91580381, 'prompt_eval_count': 386, 'prompt_eval_duration': 102292712, 'eval_count': 559, 'eval_duration': 9651487232, 'model_name': 'deepseek-r1:14b'} id='run--443b06a6-033b-4680-bd8a-e39c790c2d16-0' usage_metadata={'input_tokens': 386, 'output_tokens': 559, 'total_tokens': 945}
