together, the playbook should have four tasks, each handling a specific part of the EPEL installation process with the right conditions and notifications.\n</think>\n\n```yaml\n---\n- name: Install epel\n  apt:\n    name: "{{ epel_url | default(\'epel-release\')}}"\n    state: present\n  when: ansible_distribution == "Amazon" and ansible_distribution_major_version == "2" or ansible_os_family == "RedHat" and ansible_distribution_major_version in [\'7\', \'8\', \'9\', \'10\']\n\n- name: Install epel gpg key\n  rpm_key:\n    key: "{{ epel_gpg_key }}"\n    state: present\n\n- name: Install epel-release\n  apt:\n    name: "{{ epel_url | default(\'epel-release\')}}"\n    state: present\n  notify: Update package cache\n\n- name: Install epel-next-release\n  apt:\n    name: "{{ epel_next_url | default(\'epel-next-release\')}}"\n    state: present\n  when: epel_next | default(false)\n  notify: Update package cache\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-22T11:30:04.623581538Z', 'done': True, 'done_reason': 'stop', 'total_duration': 15357304195, 'load_duration': 80510106, 'prompt_eval_count': 444, 'prompt_eval_duration': 139015897, 'eval_count': 669, 'eval_duration': 15136982751, 'model_name': 'deepseek-r1:14b'} id='run--3dd5c18b-6fde-4565-8642-6b51ea53ea96-0' usage_metadata={'input_tokens': 444, 'output_tokens': 669, 'total_tokens': 1113}
