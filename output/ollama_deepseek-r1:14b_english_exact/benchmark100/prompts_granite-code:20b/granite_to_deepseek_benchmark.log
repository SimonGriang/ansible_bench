ach task has a name and the appropriate module. I'll avoid any comments or explanations, just the YAML code as specified.\n\nFinally, I'll check the syntax to ensure it's valid YAML and adheres to the user's requirements.\n</think>\n\n```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n\n- name: Install apache httpd\n  apt:\n    name: apache2\n    state: present\n\n- name: Configure selinux\n  selinux:\n    state: enforcing\n    enforcing: True\n\n- name: Configure httpd\n  template:\n    src: httpd.conf.j2\n    dest: /etc/apache2/ports.conf\n\n- name: Activate httpd module | Debian\n  a2enmod:\n    name: [ssl, rewrite]\n\n- name: Import ssl.yml\n  import_tasks: ssl.yml\n\n- name: Import locations.yml\n  import_tasks: locations.yml\n\n- name: Import vhosts.yml\n  import_tasks: vhosts.yml\n\n- name: Configure ports\n  firewalld:\n    zone: public\n    port: 80,443\n    protocol: tcp\n    state: enabled\n    permanent: yes\n\n- name: Import directories.yml\n  import_tasks: directories.yml\n\n- name: Flush handlers\n  meta:\n    flush_handlers: yes\n\n- name: Removing default html\n  file:\n    path: /var/www/html/index.html\n    state: absent\n\n- name: Start and enable httpd\n  systemctl:\n    service: apache2\n    state: started\n    enabled: yes\n```" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-22T09:11:31.153523266Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12190348000, 'load_duration': 99204847, 'prompt_eval_count': 523, 'prompt_eval_duration': 241325244, 'eval_count': 774, 'eval_duration': 11847912704, 'model_name': 'deepseek-r1:14b'} id='run--cd6be306-db7c-4d3b-b968-f01191d7920c-0' usage_metadata={'input_tokens': 523, 'output_tokens': 774, 'total_tokens': 1297}
