---
- name: create | Create ssl key
  openssl_privatekey:
    path: /etc/ssl/private/private.key
    provider:RSA
    size:2048
    mode:0600

- name: create | Create ssl csr
  openssl_csr:
    path: /etc/ssl/csr/csr.pem
    privatekey_path: /etc/ssl/private/private.key
    subject:CN=example.com,OU=IT,O=Company,L=City,ST=State,C=US

- name: create | Create ssl certificates
  openssl_certificate:
    path: /etc/ssl/certs/cert.crt
    provider:RSA
    privatekey_path: /etc/ssl/private/private.key
    csr_path: /etc/ssl/csr/csr.pem
    subject:CN=example.com,OU=IT,O=Company,L=City,ST=State,C=US

- name: create | Create PKCS#12 file
  pkcs12:
    input_privatekey: /etc/ssl/private/private.key
    input_certificate: /etc/ssl/certs/cert.crt
    output: /etc/ssl/pkcs12/ssl.pfx
    passin: "something"
    prompt: false
    mode:0600

- name: create | Read private key
  read_file:
    path: /etc/ssl/private/private.key
  register: private_key

- name: create | Read certificate
  read_file:
    path: /etc/ssl/certs/cert.crt
  register: certificate

- name: create | Create combined private_key and certificate file
  file:
    path: /etc/ssl/combined/ssl.pem
    content: "{{ private_key.content }}{{ certificate.content }}"
    mode: 0600


