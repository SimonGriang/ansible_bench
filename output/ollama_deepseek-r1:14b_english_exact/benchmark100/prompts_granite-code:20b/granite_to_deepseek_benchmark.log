---
- name: lookup bootstrap facts
  shell: cat /etc/os-release
  register: os_release_info

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ distribution }}"
    bootstrap_distribution_major_version: "{{ version }}"
  loop:
    - { distribution: "Ubuntu", version: "22.04" }
    - { distribution: "CentOS", version: "8" }
    - { distribution: "Fedora", version: "38" }

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.value }}"
  loop:
    - { key: "Ubuntu", value: "Debian" }
    - { key: "CentOS", value: "RedHat" }
    - { key: "Fedora", value: "RedHat" }


