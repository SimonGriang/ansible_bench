---
- name: Task 1: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Task 2: Check if the ansible_pkg_mgr is set to apt and then manage automatic service management based on the apt_autostart_state variable
  block:
    - name: Check ansible_pkg_mgr and manage services
      ansible.builtin.command: systemctl enable --now {{ item }}
      when: ansible_pkg_mgr == 'apt'
      with_items: 
        - "{{ apt_autostart_state }}"
  vars:
    ansible_python_interpreter: /usr/bin/python3

- name: Task 3: Use the copy module to create the policy-rc.d file with the content "exit 101" and mode "755" if the apt_autostart_state is set to disabled
  ansible.builtin.copy:
    content: "exit 101"
    dest: /usr/libexec/policy-rc.d
    mode: '755'
  when: apt_autostart_state == 'disabled'

- name: Task 4: Use the file module to remove the policy-rc.d file if the apt_autostart_state is set to enabled
  ansible.builtin.file:
    state: absent
  when: apt_autostart_state == 'enabled'


