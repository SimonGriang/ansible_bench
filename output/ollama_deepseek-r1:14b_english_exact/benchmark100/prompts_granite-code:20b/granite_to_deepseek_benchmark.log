---
- name: Restart RKE2 service on {{ rke2_node_name }}
  shell: systemctl restart rke2.service
  args:
    chdir: /etc/rke2
  node_name: "{{ rke2_node_name }}"
  state: restarted

- name: Wait for all nodes to be ready again
  k8s_wait_for_nodes:
    state: present
    labels: kubernetes.io/role=node
    status: Ready
  register: nodes_ready

- name: Wait for all pods to be ready again
  k8s_wait_for_pods:
    namespace: all
    pods: all
    state: present
    statuses:
      - Running
      - Succeeded
  register: pods_ready


