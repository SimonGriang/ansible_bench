---
- name: Create the RKE2 config dir
  file:
    path: /etc/rke2
    state: directory

- name: Set server taints
  kubectl:
    cmd: taint
    args: 
      - node
      - node-role.kubernetes.io/master=:NoSchedule
    when: node_type == 'server'

- name: Set agent taints
  kubectl:
    cmd: taint
    args: 
      - node
      - node-role.kubernetes.io/worker=:NoSchedule
    when: node_type == 'agent'

- name: Copy RKE2 config
  copy:
    remote_src: true
    src: /path/to/rke2-config.yml
    dest: /etc/rke2/config.yml

- name: Copy kubelet config
  copy:
    remote_src: true
    src: /path/to/kubelet-config.yml
    dest: /etc/kubelet/config.yml
    when: kubelet_config_exists

- name: Copy Containerd Registry Configuration file
  copy:
    remote_src: true
    src: /path/to/registry-config.yml
    dest: /etc/containers/registries.d/registry-config.yml
    when: custom_registry_used

- name: Start RKE2 service
  systemd:
    name: rke2
    state: started

- name: Mask other RKE2 service
  systemd:
    name: other-rke2-service
    state: masked

- name: Wait for remaining nodes to be ready - no CNI
  wait:
    until: node_ready
    delay: 60
    retries: 60
    when: not cni_plugin_found

- name: Wait for remaining nodes to be ready - with CNI
  wait:
    until: node_ready
    delay: 60
    retries: 60
    when: cni_plugin_found


