er\n  ansible.builtin.template:\n    src: "{{ mysql_configuration_destination }}"\n    dest: /etc/mysql/my.cnf\n    vars:\n      mysql_name: "{{ mysql_name }}"\n      mysql_configuration_options: "{{ mysql_configuration_options }}"\n      mysql_socket: "{{ mysql_socket }}"\n    mode: \'0644\'\n\n- name: Configure mysql client\n  ansible.builtin.template:\n    src: "{{ mysql_configuration_destination }}"\n    dest: /etc/mysql/my.cnf.client\n    vars:\n      mysql_name: "{{ mysql_name }}"\n      mysql_socket: "{{ mysql_socket }}"\n    mode: \'0644\'\n\n- name: Initialize mysql\n  ansible.builtin.shell:\n    cmd: "{{ mysql_initialize_command }}"\n    changed_when: false\n\n- name: Start and enable mysql\n  ansible.builtin.service:\n    name: mysql\n    state: started\n    enabled: true\n\n- name: Flush handlers\n  ansible.builtin.shell:\n    cmd: ansible-playbook --flush-handlers\n    changed_when: false\n\n- name: Place my.cnf\n  ansible.builtin.copy:\n    remote_src: "{{ my.cnf.j2 }}"\n    remote_path: /root/.my.cnf\n    mode: \'0600\'\n\n- name: Create databases\n  community.mysql.mysql_db:\n    name: "{{ item }}"\n    state: present\n  loop: "{{ mysql_databases }}"\n\n- name: Create users\n  community.mysql.mysql_user:\n    name: "{{ item.name }}"\n    password: "{{ item.password }}"\n    priv: "{{ item.privileges }}"\n  loop: "{{ mysql_users }}"\n\n- name: Flush handlers again\n  ansible.builtin.shell:\n    cmd: ansible-playbook --flush-handlers\n    changed_when: false\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-22T10:50:31.552365345Z', 'done': True, 'done_reason': 'stop', 'total_duration': 18422130335, 'load_duration': 86847140, 'prompt_eval_count': 2283, 'prompt_eval_duration': 1196725773, 'eval_count': 818, 'eval_duration': 17136620042, 'model_name': 'deepseek-r1:14b'} id='run--59e22ebf-e5bb-48e8-b843-f17968f88224-0' usage_metadata={'input_tokens': 2283, 'output_tokens': 818, 'total_tokens': 3101}
