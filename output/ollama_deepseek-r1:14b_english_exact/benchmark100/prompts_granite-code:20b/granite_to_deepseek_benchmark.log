---
- name: Create etcd group
  group:
    name: etcd

- name: Create etcd user
  user:
    name: etcd
    shell: /bin/nologin
    groups: etcd
    state: present

- name: Copy systemctl config file for kernel hardening
  file:
    path: /etc/sysctl.d/60-rke2-cis.conf
    content: |
      net.ipv4.ip_forward=1
      net.ipv4.tcp_syncookies=1
      net.ipv4.tcp_SYNACK_reordering=2
      net.ipv4.tcp_rfc1337=1
      net.ipv4.tcp_ecn=1
      net.ipv4.tcp_reordering=5
      net.ipv4.tcp_fin_timeout=30
      net.ipv4.tcp_keepalive_time=600
      net.ipv4.tcp_keepalive_probes=3
      net.ipv4.tcp_keepalive_intvl=30
      net.ipv4.tcp_max_orphans=32768
      net.ipv4.tcp_max_SYN_retrans=2
      net.ipv4.tcp_rexmit_reohrottle=0
      net.ipv4.tcp_rto_max=300
      net.ipv4.tcp_rto_min=100
      net.ipv4.tcp_dsack=1
      net.ipv4.tcp_sack=1
      net.ipv4.tcp_fack=1
      net.ipv4.tcp_no_metrics_save=1
      net.ipv4.tcp_mtu Discovery=1
      net.ipv4.tcp_mtu Discovery=1
      net.ipv4.tcp_mtu Discovery=1
    mode: 0600
  notify: restart_systemd_sysctl

- name: Flush handlers
  meta:
    flush_handlers: true


