---
- name: Install requirements
  apt:
    name: bash
    state: present

- name: Install openjdk java (package)
  apt:
    name: openjdk
    state: present

- name: Install RPM
  dnf:
    name: rpm
    state: present

- name: Install DEB
  apt:
    name: deb
    state: present

- name: Install oracle java (rpm) (repository)
  dnf:
    name: oracle-java
    state: present

- name: Configure oracle targz
  file:
    path: /etc/oracle/config
    content: 'JAVA_HOME=/usr/lib/jvm/java-8-oracle'
    state: present

- name: Install oracle java policy software (targz)
  file:
    path: /etc/oracle/policy
    content: 'ORACLE_JAVA_POLICY=/usr/lib/jvm/java-8-oracle/j.policy'
    state: present

- name: Set alternative (targz)
  alternatives:
    name: java
    path: /usr/lib/jvm/java-8-oracle/bin/java
    state: present
    priority: 1

- name: Find JAVA_HOME
  shell: |
    JAVA_HOME=$(find /usr/lib/jvm/ -name java | cut -d '/' -f 1-4)
  register: java_home

- name: Set JAVA_HOME in /etc/environment
  file:
    path: /etc/environment
    content: "JAVA_HOME={{ java_home.stdout }}"
    state: present


