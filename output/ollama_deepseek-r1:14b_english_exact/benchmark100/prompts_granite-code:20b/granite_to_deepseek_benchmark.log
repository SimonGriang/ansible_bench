---
- name: Create the RKE2 config dir
  file:
    path: /etc/rancher/rke2
    state: directory

- name: Set server taints
  rancher_node:
    state: present
    role: server
    node_labels: "{{ rke2_server_node_labels | default({})}}"
    node_taints: "{{ rke2_server_node_taints | default({})}}"

- name: Copy rke2 config
  copy:
    remote_src: true
    src: "{{ rke2_config_source | default('config.yaml')}}"
    dest: /etc/rancher/rke2/config.yaml
  file:
    path: /etc/rancher/rke2/config.yaml
    mode: 0600

- name: Copy kubelet config
  copy:
    remote_src: true
    src: "{{ rke2_kubelet_config | default('kubelet-config.yaml')}}"
    dest: /etc/rancher/rke2/kubelet-config.yaml
  file:
    path: /etc/rancher/rke2/kubelet-config.yaml
    mode: 0600
  when: rke2_kubelet_config is defined

- name: Copy Containerd Registry Configuration file
  copy:
    remote_src: true
    src: "{{ rke2_custom_registry_mirrors | default('registries.yaml')}}"
    dest: /etc/rancher/rke2/registries.yaml
  file:
    path: /etc/rancher/rke2/registries.yaml
    mode: 0600
  when: rke2_custom_registry_mirrors is defined or rke2_custom_registry_configs is defined

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: "{{ rke2_etcd_snapshot_file is defined }}"

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: "{{ (rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined) }}"

- name: Restore etcd from file
  when: do_etcd_restore | default(false)
  block:
    - name: Ensure RKE2 etcd snapshot directory exists
      file:
        path: /var/lib/rancher/rke2/snapshots
        state: directory
    - name: Copy etcd snapshot file
      copy:
        remote_src: true
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/snapshots/
    - name: Restore etcd from snapshot
      command: rke2 server --config=/etc/rancher/rke2/config.yaml --SnapshotRestore=/var/lib/rancher/rke2/snapshots/{{ rke2_etcd_snapshot_file | basename }}

- name: Restore etcd from s3
  when: do_etcd_restore_from_s3 | default(false)
  block:
    - name: Restore etcd from s3
      command: rke2 server --config=/etc/rancher/rke2/config.yaml --SnapshotRestoreS3="{{ rke2_etcd_snapshot_s3_options.access_key }}:{{ rke2_etcd_snapshot_s3_options.secret_key }}@{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"

- name: Start RKE2 service on the first server
  when: inventory_hostname == rke2_first_server | default(inventory_hostname)
  service:
    name: rke2-server
    state: started
    enabled: yes
  command: systemctl start rke2-server

- name: Mask RKE2 agent service on the first server
  when: inventory_hostname == rke2_first_server | default(inventory_hostname)
  service:
    name: rke2-agent
    masked: true

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: /bin/sh -c 'echo test > /dev/null'
    delay: 10
    timeout: 300
    state: started
  when: rke2_cni_plugin is not defined

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: /bin/sh -c 'echo test > /dev/null'
    delay: 10
    timeout: 300
    state: started
  when: rke2_cni_plugin is defined

- name: Restore etcd
  meta:
    skip_on_fail: true
  when: do_etcd_restore | default(false) or do_etcd_restore_from_s3 | default(false)
  block:
    - name: Remove old <node>.node-password.rke2 secrets
      file:
        path: /etc/rancher/rke2/ssl/<node>.node-password.rke2
        state: absent
    - name: Remove old nodes
      command: rke2 server --config=/etc/rancher/rke2/config.yaml --remove-stored-nodes

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ rke2_cluster_group_name | default('rke2_cluster') | hostvars | dict_keys | join(',') }}"
  delegate_facts: yes


