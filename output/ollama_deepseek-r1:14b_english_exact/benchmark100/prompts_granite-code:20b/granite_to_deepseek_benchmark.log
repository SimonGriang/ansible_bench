tin.import_playbook:\n    playbook: assert.yml\n\n- name: Wait for port to be available\n  ansible.builtin.wait_for:\n    port: 80\n    state: started\n\n- name: Prepare system\n  ansible.builtin.apt:\n    state: latest\n    upgrade: yes\n```" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-22T07:48:02.285103046Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8768982173, 'load_duration': 93238671, 'prompt_eval_count': 1243, 'prompt_eval_duration': 535412984, 'eval_count': 498, 'eval_duration': 8139132183, 'model_name': 'deepseek-r1:14b'} id='run--b2b69f9f-5908-406a-bc78-7c8486c44b4b-0' usage_metadata={'input_tokens': 1243, 'output_tokens': 498, 'total_tokens': 1741}
