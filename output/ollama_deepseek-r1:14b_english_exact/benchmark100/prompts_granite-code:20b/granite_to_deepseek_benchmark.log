: Import assert.yml\n  include_tasks: assert.yml\n\n- name: Install php\n  apt:\n    name: "{{ php_packages }}"\n    state: present\n    update_cache: yes\n\n- name: Find used php.ini\n  shell: "{{ php_ini_command }}"\n  register: php_found_ini_location\n\n- name: Configure php\n  template:\n    src: php.ini.j2\n    dest: "{{ php_ini_location | default(php_found_ini_location.stdout) }}"\n    mode: 0644\n  notify: Restart httpd\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-22T09:37:44.779972966Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11307642008, 'load_duration': 105278271, 'prompt_eval_count': 408, 'prompt_eval_duration': 126695707, 'eval_count': 542, 'eval_duration': 11074163745, 'model_name': 'deepseek-r1:14b'} id='run--7ddc3919-d47f-44e6-b5cc-84284533d13a-0' usage_metadata={'input_tokens': 408, 'output_tokens': 542, 'total_tokens': 950}
