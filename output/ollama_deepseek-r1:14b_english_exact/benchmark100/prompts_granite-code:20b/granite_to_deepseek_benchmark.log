st: /etc/mysql/my.cnf\n    owner: mysql\n    group: mysql\n    mode: \'0644\'\n\n- name: Create databases\n  community.mysql.mysql_db:\n    name: "{{ item }}"\n    state: present\n  loop:\n    - "{{ db_name }}"\n\n- name: List databases\n  mysql_command:\n    command: "SHOW DATABASES;"\n    state: present\n\n- name: Import database\n  mysql:\n    db: "{{ db_name }}"\n    sql_file: /path/to/database.sql\n    state: present\n\n- name: Create users\n  community.mysql.mysql_user:\n    name: "{{ db_user }}"\n    db: "{{ db_name }}"\n    priv: "ALL PRIVILEGES"\n    state: present\n\n- name: Flush handlers again\n  ansible.builtin.flush:\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-22T08:01:58.53522879Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13768740407, 'load_duration': 96500584, 'prompt_eval_count': 2821, 'prompt_eval_duration': 1229314360, 'eval_count': 679, 'eval_duration': 12441274664, 'model_name': 'deepseek-r1:14b'} id='run--53de1c01-b167-4bc5-9edc-353a59d1884f-0' usage_metadata={'input_tokens': 2821, 'output_tokens': 679, 'total_tokens': 3500}
