---
- name: Install git
  apt:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    db: passwd
    user: "{{ git_username }}"
    state: present

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}/.gitconfig.d"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: 0755

- name: Place git configuration
  template:
    src: "git_config.j2"
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: 0644
    variables:
      git_user_email: "{{ git_user_email }}"
      git_user_name: "{{ git_user_name }}"
      git_username: "{{ git_username }}"

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: 0755

- name: Clone all roles
  git:
    repo: "{{ item.repository }}"
    dest: "{{ git_repository_destination }}"
    branch: "{{ item.branch | default('main') }}"
    update: yes
    chdir: "/home/{{ git_username }}"
    remote: origin
    username: "{{ git_username }}"
    key_path: "/home/{{ git_username }}/.ssh/id_rsa"
  loop: "{{ git_repositories }}"


