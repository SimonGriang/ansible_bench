 vhosts\n  ansible.builtin.template:\n    src: vhosts.conf.j2\n    dest: /etc/apache2/sites-available/vhosts.conf\n    owner: root\n    group: root\n    mode: 644\n\n- name: Enable vhosts\n  ansible.apt.apache2ensite:\n    name: vhosts.conf\n    state: present\n\n- name: Enable vhosts\n  ansible.builtin.systemd:\n    name: apache2\n    state: restarted\n    owner: root\n    group: root\n```" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-22T08:47:44.582602771Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11557501956, 'load_duration': 84740964, 'prompt_eval_count': 2161, 'prompt_eval_duration': 1136808924, 'eval_count': 573, 'eval_duration': 10335189878, 'model_name': 'deepseek-r1:14b'} id='run--d6649102-d550-4436-9413-1e772783ba8d-0' usage_metadata={'input_tokens': 2161, 'output_tokens': 573, 'total_tokens': 2734}
