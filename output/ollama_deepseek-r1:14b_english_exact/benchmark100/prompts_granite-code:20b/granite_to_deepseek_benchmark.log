---

- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_bash_url }}"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    timeout: "{{ rke2_artifact_fetch_timeout }}"

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/rke2.sh"
    dest: "{{ rke2_install_script_dir }}/rke2.sh"
    mode: 0700
    force: yes

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifact_path }}"
    state: directory
    mode: 0700

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download sha256 checksum
      get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/sha256sum-{{ rke2_architecture }}.txt"
        dest: "{{ rke2_artifact_path }}/sha256sum-{{ rke2_architecture }}.txt"
        mode: 0640
        timeout: "{{ rke2_artifact_fetch_timeout }}"

    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifact_url }}/{{ rke2_version }}/"
        dest: "{{ rke2_artifact_path }}"
        recursive: yes
        mode: 0640
        timeout: "{{ rke2_artifact_fetch_timeout }}"

    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_bash_url }}"
        dest: "{{ rke2_install_script_dir }}/rke2.sh"
        mode: 0700
        timeout: "{{ rke2_artifact_fetch_timeout }}"
  when:
    - rke2_airgap_mode == 'enabled'
    - rke2_airgap_IMPLEMENTATION == 'download'

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
    dest: "{{ rke2_artifact_path }}/{{ item }}"
    mode: 0640
    force: yes
  loop: "{{ rke2_artifact_files }}"
  when:
    - rke2_airgap_mode == 'enabled'
    - rke2_airgap_IMPLEMENTATION == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Create additional images tarballs folder
      file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory
        mode: 0700

    - name: Copy additional tarball images
      copy:
        src: "{{ rke2_airgap_copy_sourcepath }}/{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"
        mode: 0644
        force: yes
  loop: "{{ rke2_additional_images_tarballs }}"
  when:
    - rke2_airgap_mode == 'enabled'
    | rke2_additional_images_tarballs | length > 0

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Set artifacts permissions
      file:
        path: "{{ rke2_artifact_path }}/{{ item }}"
        state: file
        mode: 0640
        force: yes
      register: artifact_perms_result
      changed_when: item.state != "file" or item.mode != "0640"

    - name: Make install script executable
      file:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
        state: file
        mode: 0700
        force: yes
      register: install_script_perms_result
      changed_when: item.state != "file" or item.mode != "0700"

    - name: Check install script executable
      stat:
        path: "{{ rke2_install_script_dir }}/rke2.sh"
      register: install_script_executable
      failed_when: "{{ install_script_executable.statexecutable | default('false') | bool }}"
  when:
    - rke2_airgap_mode == 'enabled'
    - rke2_airgap_IMPLEMENTATION == 'exists'

- name: Populate service facts
  setup:

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Check if separate partition
  command: df --noheaders /usr/local | awk '{print $6}'
  changed_when: false
  register: separate_partition

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_path }}"

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 version"
  changed_when: false
  register: rke2_version_check

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_version_check.stdout is not None
      - rke2_version_check.stdout >= "{{ rke2_version }}"
    fail_msg: "RKE2 version {{ rke2_version_check.stdout }} is less than required version {{ rke2_version }}"

- name: Run RKE2 install script
  command: "{{ rke2_bin_path }}/rke2 install"
  changed_when: false
  args:
    register: rke2_install_output
    strip_empty_ends: true

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/server/manifests/"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_custom_manifests }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/agent/pod-manifests/"
    owner: root
    group: root
    mode: 0644
  loop: "{{ rke2_static_pods }}"

- name: Copy RKE2 environment file
  template:
    src: rke2_environment.j2
    dest: /etc/default/rke2-{{ rke2_type }}
    owner: root
    group: root
    mode: 0644

