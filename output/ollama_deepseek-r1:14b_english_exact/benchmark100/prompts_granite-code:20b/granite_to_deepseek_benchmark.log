- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  ansible.builtin.file:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
    state: file

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.file:
    path: /usr/lib/python3.11/EXTERNALLY-MANAGED
    state: new
    dest: /usr/lib/python3.11_managed
    mode: "644"

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  ansible.builtin.file:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
    state: file

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  ansible.builtin.file:
    path: /usr/lib/python3.12/EXTERNALLY-MANAGED
    state: new
    dest: /usr/lib/python3.12_managed
    mode: "644"

- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install python pip
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
    update_cache: true
  loop:
    - python3
    - python3-pip

- name: Configure pip proxy
  ansible.builtin.pip:
    cmd: install pip==21.3.1

- name: Trust hosts
  ansible.builtin.ssh_key_fingerprints:
    name: "{{ inventory_hostname }}"
    key_type: rsa
    state: present

- name: Update pip
  ansible.builtin.pip:
    pip_version: latest
    state: present

- name: Install requested modules
  ansible.builtin.pip:
    packages: "{{ requested_python_modules }}"
    state: present


