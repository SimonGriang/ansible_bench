---
- name: Install cron
  apt:
    name: cron
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/crontab
    line: SHELL=/bin/bash
    state: present

- name: Configure path
  lineinfile:
    path: /etc/crontab
    line: PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    state: present

- name: Configure mailto
  lineinfile:
    path: /etc/crontab
    line: MAILTO=root
    state: present

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: yes

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    schedule: "{{ item.schedule }}"
    job: "{{ item.job }}"
  with_items: "{{ cron_jobs }}"


