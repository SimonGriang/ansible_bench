---
- name: Import assert.yml
  ansible.builtin.include_tasks:
    file: assert.yml

- name: Install python pip
  ansible.builtin.package:
    name: python-pip
    state: present

- name: Configure pip proxy
  community.general.ini_file:
    path: ~/.config/pip/pip.conf
    section: global
    option: proxy
    value: http://proxy.example.com:8080
    create: true
    owner: "{{ ansible_user_id }}"
    group: "{{ ansible_group_id }}"
    mode: 420

- name: Trust hosts
  community.general.ini_file:
    path: ~/.config/pip/pip.conf
    section: global
    option: verify
    value: false
    create: true
    owner: "{{ ansible_user_id }}"
    group: "{{ ansible_group_id }}"
    mode: 420

- name: Update pip
  ansible.builtin.pip:
    name: pip
    state: present

- name: Install requested modules
  ansible.builtin.pip:
    requirements: "{{ packages }}"
    chdir: /tmp


