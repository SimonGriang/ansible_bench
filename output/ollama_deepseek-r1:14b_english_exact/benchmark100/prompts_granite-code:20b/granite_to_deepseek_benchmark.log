---
- name: lookup bootstrap facts (raw)
  command:
    cmd: /usr/bin/bootstrap-fact --raw
  register: bootstrap_facts

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value.distribution | default('unknown') }}"
    bootstrap_distribution_major_version: "{{ item.value.distribution_major_version | default('unknown') }}"
  loop: "{{ bootstrap_facts.stdout | from_json | dict2list }}"
  when:
    - item.key == bootstrap_distribution的事实

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.value | default('other') }}"
  loop: "{{ bootstrap_facts.stdout | from_json | dict2list }}"
  when:
    - item.key == bootstrap_distribution的事实

