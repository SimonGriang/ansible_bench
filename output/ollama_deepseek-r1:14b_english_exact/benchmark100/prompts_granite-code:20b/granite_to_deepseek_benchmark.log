---
- name: Task 1: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ users_ssh_key_directory }}"
    state: directory
    mode: 0750

- name: Task 2: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    comment: "{{ user.comment }}"
    shell: "{{ user.shell }}"
    home: "{{ user.home }}"
    state: present

- name: Task 3: Set sudo options for {{ user.name }}
  template:
    src: "{{ sudoers_template }}"
    dest: "/etc/sudoers.d/{{ user.name }}"
    mode: 0o644

- name: Task 4: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: sudo_options is not defined

- name: Task 5: Generate private ssh key for {{ user.name }}
  shell: "{{ ssh_keygen_command }}"
  register: keygen_private
  changed_when: false

- name: Task 6: Generate public ssh key for {{ user.name }}
  shell: "{{ ssh_keygen_pubkey_command }}"
  register: keygen_public
  changed_when: false

- name: Task 7: Convert ssh key to ppk for {{ user.name }}
  shell: "{{ ssh_keygen_ppk_command }}"
  register: ppk_conversion
  changed_when: false

- name: Task 8: Get or set the home directory for {{ user.name }}
  shell: "getent passwd {{ user.name }} | awk -F: '{print $6}'"
  register: user_home
  changed_when: false
  when: user.home is not defined

- name: Task 9: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user_home.stdout }}/.ssh"
    state: directory
    mode: 0700

- name: Task 10: Deploy authorized keys for {{ user.name }}
  ssh_authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
  with_items: "{{ authorized_keys }}"

- name: Task 11: Remove unauthorized keys for {{ user.name }}
  ssh_authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  with_items: "{{ unauthorized_keys }}"

- name: Task 12: Copy generated private ssh key for {{ user.name }}
  copy:
    content: "{{ keygen_private.stdout }}"
    dest: "{{ user_home.stdout }}/.ssh/id_rsa"
    mode: 0600

- name: Task 13: Check users password valid time for {{ user.name }}
  shell: "chage -l {{ user.name }} | awk '/^Password expiration date/ {print $4}'"
  register: password_expiration
  changed_when: false

- name: Task 14: Set users password valid time for {{ user.name }}
  chage:
    name: "{{ user.name }}"
    max_days: "{{ password_validity }}"

- name: Task 15: Place private key file for {{ user.name }}
  copy:
    src: "{{ user_home.stdout }}/.ssh/id_rsa"
    dest: "{{ user_home.stdout }}/.ssh/id_rsa"
    mode: 0600


