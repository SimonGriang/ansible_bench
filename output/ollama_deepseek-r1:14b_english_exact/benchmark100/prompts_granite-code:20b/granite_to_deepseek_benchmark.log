  ansible.builtin.file:
    path: /usr/local/bin
    state: directory

- name: Create config directories
  ansible.builtin.file:
    path: /etc/promtail
    state: directory

- name: Create application dirs
  ansible.builtin.file:
    path: /var/lib/promtail
    state: directory

- name: Check promtail binary
  ansible.builtin.stat:
    path: /usr/local/bin/promtail

- name: Download promtail binaries
  ansible.builtin.get_url:
    url: http://example.com/promtail/linux-amd64.zip
    dest: /usr/local/bin/promtail.zip
    mode: 0o755

- name: Propagate locally distributed promtail archive
  ansible.builtin.copy:
    src: /usr/local/bin/promtail.zip
    dest: /usr/local/bin/

- name: Download promtail binaries to controller node
  ansible.builtin.get_url:
    url: http://example.com/promtail/linux-amd64.zip
