---
- import_tasks: assert.yml

- name: Install dns
  apt:
    name: bind9
    state: present

- name: Create directories
  file:
    path: /etc/named
    state: directory
    mode: 755
    owner: root

- name: Create group
  group:
    name: bind
    state: present

- name: Create user
  user:
    name: bind
    state: present
    group: bind

- name: Generate rndc key
  command: rndc-keygen
  register: named.key

- name: Set permissions on rndc key file
  file:
    path: "{{ named.key.keyfile }}"
    state: file
    mode: 600
    owner: bind

- name: Get the hints/root file
  get_url:
    url: http://example.com/named.root
    dest: /etc/named/named.root

- name: Create zone file
  template:
    src: "{{ item.zone }}.j2"
    dest: /etc/named "{{ item.zone }}.zone"
    when: item.enabled | default(false)
  loop: "{{ dns_zones | default([]) }}"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named/named.conf
    force: yes

- name: Place systemd override
  template:
    src: "{{ item }}.j2"
    dest: /etc/systemd/system/bind9.{{ item }}.override
    loop: "{{ lookup('fileglob', 'templates/*.override.j2') }}"

- name: Start and enable dns
  service:
    name: bind9
    state: started
    enabled: yes


