---
- name: Install epel
  apt:
    name: "{{ epel_url | default('epel-release')}}"
    state: present
  when: ansible_distribution == "Amazon" and ansible_distribution_major_version == "2" or ansible_os_family == "RedHat" and ansible_distribution_major_version in ['7', '8', '9', '10']

- name: Install epel gpg key
  rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install epel-release
  apt:
    name: "{{ epel_url | default('epel-release')}}"
    state: present
  notify: Update package cache

- name: Install epel-next-release
  apt:
    name: "{{ epel_next_url | default('epel-next-release')}}"
    state: present
  when: epel_next | default(false)
  notify: Update package cache


