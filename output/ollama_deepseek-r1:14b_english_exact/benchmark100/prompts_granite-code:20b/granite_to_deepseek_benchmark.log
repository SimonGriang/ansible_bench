---
- name: Create group vault
  ansible.builtin.group:
    name: vault
    state: present

- name: Create user vault
  ansible.builtin.user:
    name: vault
    group: vault
    shell: /sbin/nologin
    state: present

- name: Create directory /opt/vault
  ansible.builtin.file:
    path: /opt/vault
    state: directory
    mode: '01363'

- name: Download Vault binary
  ansible.builtin.get_url:
    url: |
      https://releases.hashicorp.com/vault/1.12.0/vault_1.12.0_linux_amd64.zip
    dest: /opt/vault/vault.zip
    mode: '01204'

- name: Create directory /etc/vault.d
  ansible.builtin.file:
    path: /etc/vault.d
    state: directory
    mode: '01363'

- name: Copy Vault binary
  ansible.builtin.copy:
    remote_src: true
    src: /opt/vault/vault.zip
    dest: /usr/bin/vault.zip
    mode: '01363'

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  setcap:
    path: /usr/bin/vault
    cap: cap_ipc_lock=ep
    mode: '01363'

- name: Create file /etc/vault.d/vault.env
  ansible.builtin.template:
    src: vault.env.j2
    dest: /etc/vault.d/vault.env
    mode: '01204'

- name: Create directory /usr/lib/systemd/system
  ansible.builtin.file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '01363'

- name: Copy Vault service file
  ansible.builtin.copy:
    remote_src: true
    src: vault.service
    dest: /usr/lib/systemd/system/vault.service
    mode: '01204'

- name: Copy vault configuration
  ansible.builtin.template:
    src: vault.hcl.j2
    dest: /etc/vault.d/vault.hcl
    mode: '01204'

- name: Flush handlers
  ansible.builtin.flush_handlers:


