  template:
    src: kubernetes_api_health.sh.j2
    dest: /usr/local/bin/kubernetes_api_health.sh
    mode: 755

- name: Create Kubernetes API health check script for RedHat OS family
  template:
    src: kubernetes_api_health_redhat.sh.j2
    dest: /usr/local/bin/kubernetes_api_health_redhat.sh
    mode: 755

- name: Create RKE2 Server health check script for Debian OS family
  template:
    src: rke2_server_health.sh.j2
    dest: /usr/local/bin/rke2_server_health.sh
    mode: 755

