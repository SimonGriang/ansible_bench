---
- name: Check if certificates exists
  stat:
    path: /etc/ssl/certs/certificate.pem
  register: cert_info

- name: Fail if some cert doesn't exist
  fail:
    msg: "Certificate not found"
  when: cert_info.stat.exists is false

- name: Setting keystore variables in java < 11
  set_fact:
    java_keystore_path: "{{ java_home }}/jre/lib/security/cacerts"
    java_nestorepass: "changeit"
  when: java_version < "11"

- name: Setting keystore variables in java >= 11
  set_fact:
    java_keystore_path: "{{ java_home }}/lib/security/cacerts"
    java_nestorepass: "changeit"
  when: java_version >= "11"

- name: Import SSL certificates
  java_cert:
    key_store_path: "{{ java_keystore_path }}"
    key_store_type: PKCS12
    key_store: "{{ java_keystore_path }}"
    key_store_password: "{{ java_nestorepass }}"


