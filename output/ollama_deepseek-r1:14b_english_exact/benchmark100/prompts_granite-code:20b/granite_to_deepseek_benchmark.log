---
- name: Task 1: Install fail2ban
  apt:
    name: fail2ban
    state: present

- name: Task 2: Copy filters in filter.d
  copy:
    remote_src: yes
    src: "{{ filter_file }}"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: 0640
  loop:
    - filter1.conf
    - filter2.conf

- name: Task 3: Configure fail2ban.local
  ini_file:
    path: /etc/fail2ban/fail2ban.local
    options:
      {{ item.key }}
    values:
      {{ item.value }}
    allow_no_key: yes
  loop:
    - { key: 'log_level', value: 'WARNING' }
    - { key: 'log_target', value: '/var/log/fail2ban.log' }

- name: Task 4: Configure jail.local
  ini_file:
    path: /etc/fail2ban/jail.local
    options:
      {{ item.key }}
    values:
      {{ item.value }}
    allow_no_key: yes
  loop:
    - { key: 'ignoreincoming', value: 'false' }
    - { key: 'bantime', value: '600' }

- name: Task 5: Stat auth log file
  stat:
    path: /var/log/auth.log
  register: auth_log_stat

- name: Task 6: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    owner: root
    group: root
    mode: 0640
  when: not auth_log_stat.stat.exists

- name: Task 7: Start and enable fail2ban
  service:
    name: fail2ban
    state: started
    enabled: yes


