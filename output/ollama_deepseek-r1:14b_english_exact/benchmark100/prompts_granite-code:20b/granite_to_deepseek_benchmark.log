    - ansible.legacy.python_version.major == 3
    - ansible.legacy.python_version.minor == 11

- name: debian12 | Get python3 version installed
  ansible.legacy.python_version:
    major: true
    minor: true
    patch: true
  when:
    - ansible_os_family == 'debian'
    - ansible_distribution_major_version == '12'

- name: debian12 | Remove EXTERNALLY-MANAGED
  ansible.builtin.file:
    path: /etc/pip.conf
    state: absent
  when:
    - ansible_os_family == ' debian'
    - ansible_distribution_major_version == '12'
    - ansible.legacy.python_version.major == 3
    - ansible.legacy.python_version.minor == 11


