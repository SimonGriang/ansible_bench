- Last generated (faulty) playbook:
---
- name: import assert.yml
  import_playbook:
    dir: tasks/assert.yml

- name: install logrotate
  apt:
    name: logrotate
    state: present
    update_cache: true

- name: add logrotate GPG key
  apt_key:
    keyserver: keyserver.ubuntu.com
    keyid: 7FD5C471
    state: present
    validate_certs: false

- name: configure logrotate
  template:
    src: logrotate.conf.j2
    dest: /etc/logrotate.conf
    owner: root
    group: root
    mode: 644

- name: generate logrotate.d files
  template:
    src: logrotate.d.j2
    dest: /etc/logrotate.d/{{ item.name }}
    owner: root
    group: root
    mode: 644
  with_items: "{{ logrotate_services }}"

- name: remove logrotate.d files
  file:
    path: /etc/logrotate.d/{{ item.name }}
    state: absent
  with_items: "{{ logrotate_services }}"

- name: start logrotate
  systemctl:
    name: logrotate
    state: started
    enabled: true


