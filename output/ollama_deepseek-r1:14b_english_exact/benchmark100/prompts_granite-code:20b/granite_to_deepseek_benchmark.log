ault\n  group:\n    name: vault\n    state: present\n\n- name: Create user vault\n  user:\n    name: vault\n    group: vault\n    shell: /sbin/nologin\n    state: present\n\n- name: Create directory /opt/vault\n  file:\n    path: /opt/vault\n    state: directory\n    mode: 755\n\n- name: Download Vault binary\n  get_url:\n    url: https://releases.hashicorp.com/vault/1.12.0/vault_1.12.0_linux_amd64.zip\n    dest: /opt/vault/vault.zip\n    mode: 0644\n\n- name: Create directory /etc/vault.d\n  file:\n    path: /etc/vault.d\n    state: directory\n    mode: 755\n\n- name: Copy Vault binary\n  copy:\n    remote_src: true\n    src: /opt/vault/vault.zip\n    dest: /usr/bin/vault.zip\n    mode: 0755\n\n- name: Set cap_ipc_lock=ep on /usr/bin/vault\n  setcap:\n    path: /usr/bin/vault\n    cap: cap_ipc_lock=ep\n    mode: 755\n\n- name: Create file /etc/vault.d/vault.env\n  template:\n    src: vault.env.j2\n    dest: /etc/vault.d/vault.env\n    mode: 644\n\n- name: Create directory /usr/lib/systemd/system\n  file:\n    path: /usr/lib/systemd/system\n    state: directory\n    mode: 755\n\n- name: Copy Vault service file\n  copy:\n    remote_src: true\n    src: vault.service\n    dest: /usr/lib/systemd/system/vault.service\n    mode: 644\n\n- name: Copy vault configuration\n  template:\n    src: vault.hcl.j2\n    dest: /etc/vault.d/vault.hcl\n    mode: 644\n\n- name: Flush handlers\n  flush_handlers: \n```" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-22T07:33:26.437531894Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16316134331, 'load_duration': 102106317, 'prompt_eval_count': 544, 'prompt_eval_duration': 304253009, 'eval_count': 887, 'eval_duration': 15908310923, 'model_name': 'deepseek-r1:14b'} id='run--56147f0f-4bc8-4d98-95f6-f22798e9e51e-0' usage_metadata={'input_tokens': 544, 'output_tokens': 887, 'total_tokens': 1431}
