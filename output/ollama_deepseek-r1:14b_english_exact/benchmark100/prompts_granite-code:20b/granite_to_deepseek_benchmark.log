---
- name: Ensure apt key is not present in trusted.gpg.d
  apt_key:
    key: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Ensure old apt source list is not present in /etc/apt/sources.list.d
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent
  become: yes

- name: Ensure old versions of Docker are not installed.
  apt:
    name: docker-engine
    state: absent
    purge: yes
    autoremove: yes

- name: Ensure legacy repo file is not present.
  file:
    path: /etc/yum.repos.d/docker.repo
    state: absent

- name: Ensure dependencies are installed.
  apt:
    name: [apt-transport-https, ca-certificates]
    state: present
  become: yes

- name: Add or remove Docker repository
  apt_repository:
    repo: "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu jammy stable"
    state: present
  become: yes

- name: Ensure handlers are notified immediately to update the apt cache
  apt:
    state: present
    update_cache: yes
  become: yes


