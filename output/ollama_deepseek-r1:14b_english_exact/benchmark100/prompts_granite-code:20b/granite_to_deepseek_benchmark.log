---
- name: Update apt cache
  apt:
    name: 'update'
    state: present

- name: Update dnf cache
  dnf:
    name: 'update'
    state: present

- name: Install packages
  apt:
    name: ['keepalived']
    state: present

- name: Create directory for keepalived
  file:
    state: directory
    path: /etc/keepalived

- name: Create Kubernetes API health check script for Debian OS family
  template:
    src: kubernetes_api_health.sh.j2
    dest: /usr/local/bin/kubernetes_api_health.sh
    mode: 755

- name: Create Kubernetes API health check script for RedHat OS family
  template:
    src: kubernetes_api_health_redhat.sh.j2
    dest: /usr/local/bin/kubernetes_api_health_redhat.sh
    mode: 755

- name: Create RKE2 Server health check script for Debian OS family
  template:
    src: rke2_server_health.sh.j2
    dest: /usr/local/bin/rke2_server_health.sh
    mode: 755

- name: Create RKE2 Server health check script for RedHat OS family
  template:
    src: rke2_server_health_redhat.sh.j2
    dest: /usr/local/bin/rke2_server_health_redhat.sh
    mode: 755

- name: Create keepalived config file
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
    mode: 644

- name: Enable keepalived
  service:
    name: keepalived
    state: started
    enabled: yes

- name: Ensure keepalived is not masked
  command:
    cmd: echo "[Unit]\nMask=false\n" > /etc/systemd/masked_services/keepalived.service

- name: Flush handlers
  meta:
    flush_handlers: yes


