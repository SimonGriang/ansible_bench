    owner: postfix
    mode: 384  # Changed from 0600 to decimal 384

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true

- name: Configure aliases
  ansible.builtin.template:
    src: aliases.j2
    dest: /etc/aliases
    mode: 420

- name: Configure sender_access
  ansible.builtin.template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: 420

- name: Configure recipient_access
