able names. Also, make sure that conditions and arguments are correctly formatted in YAML.\n\nFinally, I\'ll review the entire playbook to ensure it\'s valid and meets all the user\'s requirements before finalizing the response.\n</think>\n\n```yaml\n---\n- name: Check current docker-compose version\n  shell: docker-compose --version 2>/dev/null | grep -oP \'\\d+\\.\\d+\\.\\d+\'\n  register: docker_compose_current_version\n  changed_when: false\n  ignore_errors: yes\n\n- name: Delete existing docker-compose version if it\'s different\n  file:\n    path: /usr/local/bin/docker-compose\n    state: absent\n  when: docker_compose_current_version.stdout is not None and docker_compose_current_version.stdout != "{{ docker_compose_version }}"\n\n- name: Install Docker Compose\n  shell: curl -L "https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose && chmod +x /usr/local/bin/docker-compose\n  when: ansible_distribution in [\'centos\', \'redhat\', \'fedora\'] or ansible_os_family == \'RedHat\'\n  changed_when: false\n\n- name: Install Docker Compose (macOS)\n  shell: curl -L "https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose && chmod +x /usr/local/bin/docker-compose\n  when: ansible_os_family == \'Darwin\'\n  changed_when: false\n\n- name: Install Docker Compose (Debian/Ubuntu based)\n  shell: curl -L "https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose && chmod +x /usr/local/bin/docker-compose\n  when: ansible_os_family == \'Debian\'\n  changed_when: false\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-22T07:53:02.436687041Z', 'done': True, 'done_reason': 'stop', 'total_duration': 12783928384, 'load_duration': 83831510, 'promp