---
- name: Install epel
  apt:
    name: epel
    state: present
  become: true
  become_method: sudo
  when:
    - (ansible_distribution == 'Amazon' and ansible_distribution_major == '2')
    or (ansible_os_family == 'RedHat' and (ansible_distribution_major == '7' or ansible_distribution_major == '8' or ansible_distribution_major == '9'))

- name: Install epel gpg key
  rpm_key:
    key: "{{ lookup('file', 'https://dl.fedoraproject.org/pub/epel/REPOS-FEDORAPROJECT-GPG-KEY') }}"
    state: present
  become: true
  become_method: sudo

- name: Install epel-release
  package:
    name: epel-release
    state: present
  become: true
  become_method: sudo

- name: Install epel-next-release
  package:
    name: epel-next-release
    state: present
  become: true
  become_method: sudo
  when: epel_next | default('false') == 'true'


