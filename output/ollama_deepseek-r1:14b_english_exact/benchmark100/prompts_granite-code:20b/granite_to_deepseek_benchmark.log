---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install required packages
  apt:
    name:
      - grub-common
      - grub-efi
      - grub-efi-amd64
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: GRUB_TIMEOUT="5"
    state: present

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: GRUB_RECORDFAIL_TIMEOUT="10"
    state: present

- name: Add options to GRUB_CMDLINE_LINUX
  replace:
    path: /etc/default/grub
    regex: GRUB_CMDLINE_LINUX=".*"
    replace: GRUB_CMDLINE_LINUX="quiet splash audit=1"
    state: present

- name: Import password.yml
  include_tasks: password.yml
  when: grub_set_password

- name: Flush handlers
  meta: flush_handlers


