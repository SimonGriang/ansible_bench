  include_tasks: assert.yml

- name: Install python pip
  apt:
    name: "{{ item }}"
    state: present
    update_cache: true
  loop:
    - python3
    - python3-pip

- name: Configure pip proxy
  pip_config:
    state: present
    proxy: http://proxy.example.com:8080
    no_proxy: localhost,127.0.0.1

- name: Trust hosts
  ssh_host_key_trusted:
    name: "{{ inventory_hostname }}"
    key_type: rsa
    state: present

- name: Update pip
  pip:
    cmd: upgrade
    editable: true

- name: Install requested modules
  pip:
    packages: "{{ requested_python_modules }}"
    state: present


