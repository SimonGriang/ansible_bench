 each is correctly formatted and adheres to the given conditions.\n</think>\n\n```yaml\n---\n- name: Download RKE2 kubeconfig to localhost\n  command: curl -o "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}" "{{ rke2_download_kubeconfig_url }}"\n  when:\n    - rke2_download_kubeconf | default(\'false\') == \'true\'\n    - ansible_hostname == (groups[rke2_servers_group_name].hosts | first | attr(\'ansible_hostname\'))\n  vars:\n    rke2_download_kubeconfig_url: "http://{{ rke2_api_ip }}/v1.27.3/kubeconfig"\n\n- name: Replace loopback IP by master server IP\n  replace:\n    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"\n    regex: \'(?<=server: ).*?(127\\.0\\.0\\.1|::1)\'\n    replace: "{{ rke2_api_ip | default(groups[rke2_servers_group_name].hosts | first | attr(\'ansible_host\')) }}"\n    backslashed: yes\n  delegate_to: localhost\n  become: false\n  when:\n    - not ansible_check_mode\n    - rke2_download_kubeconf | default(\'false\') == \'true\'\n    - ansible_hostname == (groups[rke2_servers_group_name].hosts | first | attr(\'ansible_hostname\'))\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-22T09:39:49.427893905Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16685475940, 'load_duration': 111308884, 'prompt_eval_count': 645, 'prompt_eval_duration': 317907351, 'eval_count': 749, 'eval_duration': 16254963196, 'model_name': 'deepseek-r1:14b'} id='run--6b18379c-0ac1-4725-a5bd-6206578070b1-0' usage_metadata={'input_tokens': 645, 'output_tokens': 749, 'total_tokens': 1394}
