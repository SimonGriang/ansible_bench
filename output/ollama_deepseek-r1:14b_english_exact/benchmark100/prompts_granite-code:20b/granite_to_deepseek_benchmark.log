---
- name: Install git
  ansible.builtin.apt:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  ansible.builtin.getent:
    db: passwd
    user: "{{ git_username }}"
    state: present

- name: Create directory for git configuration
  ansible.builtin.file:
    path: "/home/{{ git_username }}/.gitconfig.d"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: 755

- name: Place git configuration
  ansible.builtin.template:
    src: "git_config.j2"
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: 644
    variables:
      git_user_email: "{{ git_user_email }}"
      git_user_name: "{{ git_user_name }}"
      git_username: "{{ git_username }}"

- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_groupname }}"
    mode: 755

- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ item.repository }}"
    dest: "{{ git_repository_destination }}"
    update: true
  loop: "{{ git_repositories }}"


