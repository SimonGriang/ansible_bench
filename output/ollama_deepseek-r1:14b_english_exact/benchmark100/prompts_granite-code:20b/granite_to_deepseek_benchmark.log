---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install cron
  crontab:
    name: cron

- name: Configure shell
  shell: shell -s /bin/bash

- name: Configure path
  shell: |
    export PATH=/usr/local/sbin
    export PATH=/usr/local/bin
    export PATH=/usr/sbin
    export PATH=/usr/bin
    export PATH=/sbin
    export PATH=/bin

- name: Configure mailto
  shell: |
    crontab -e && echo "MAILTO=root" >> /tmp/crontab.$$ \
    && crontab /tmp/crontab.$$

- name: Start and enable cron
  systemd:
    name: cron
    state: started
    enabled: true

- name: Schedule requested cron jobs
  crontab:
    name: hourly-backup
    hourly: true
    command: /usr/local/bin/backup.sh


