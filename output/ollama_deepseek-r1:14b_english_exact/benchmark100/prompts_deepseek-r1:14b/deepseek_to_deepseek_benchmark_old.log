    name: "{{ python_pip_pip_package | default(\'pip\') }}"\n    state: "{{ python_pip_pip_state | default(\'latest\') }}"\n  when:\n    - python_pip_update\n    - not (ansible_distribution in [\'bookworm\', \'noble\'] or\n           ansible_distribution == \'Alpine\')\n\n- name: Install requested modules\n  pip:\n    name: "{{ item.name }}"\n    version: "{{ item.version | default(\'latest\') }}"\n  loop: "{{ python_pip_modules | default([]) }}"\n  when:\n    - not (ansible_distribution in [\'bookworm\', \'noble\'] or\n           ansible_distribution == \'Alpine\')' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T18:51:36.03610529Z', 'done': True, 'done_reason': 'stop', 'total_duration': 22264195671, 'load_duration': 77681288, 'prompt_eval_count': 2075, 'prompt_eval_duration': 1222900911, 'eval_count': 1150, 'eval_duration': 20962641073, 'model_name': 'deepseek-r1:14b'} id='run--a24aa56e-2274-4b06-ab3e-56b39cd6e436-0' usage_metadata={'input_tokens': 2075, 'output_tokens': 1150, 'total_tokens': 3225}
