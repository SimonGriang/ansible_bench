---

- name: locations | Enable modules
  loop:
    - proxy
    - proxy_http
  become: true
  vars:
    module_name: "{{ item }}"
  apache_module:
    name: "{{ item }}"
    state: enabled

- name: locations | Configure locations
  ansible.builtin.template:
    dest: /etc/apache2/sites-available/locations.conf
    src: locations.conf.j2
    mode: 0o0644
  become: true
  vars:
    httpd_locations: "{{ httpd_locations | default([]) }}"
  notify:
    - httpd_config_test
    - httpd_restart

