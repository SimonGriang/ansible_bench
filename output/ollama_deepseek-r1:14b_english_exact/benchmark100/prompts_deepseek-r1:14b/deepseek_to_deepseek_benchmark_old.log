---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.read_file:
    path: /etc/os-release
    register: os_release

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    distribution_name: "{{ (os_release.stdout | regex_replace('^.*ID_LIKE=') | regex_replace('"','') | split(' ')[0]) | default('unknown') }}"
    major_version: "{{ (os_release.stdout | regex_replace('^.*VERSION_ID=') | regex_replace('"','') | split('.')[0]) | default('unknown') }}"

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    os_family: 
      - name: "{{ distribution_name }}"
        family: "{{ 
          (distribution_name in ['centos', 'rhel'] | ternary('RedHat', 
          (distribution_name == 'debian' | ternary('Debian', 'unknown'))) 
        }} "


