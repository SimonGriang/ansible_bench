bs\n  apt:\n    name: "{{ item }}"\n    state: present\n    update_cache: yes\n  loop: "{{ required_libs }}"\n  when: ansible_distribution == \'Debian\' or ansible_distribution == \'Ubuntu\'\n\n- name: Install Java, Debian\n  apt:\n    name: "{{ java_package_name }}"\n    version: "{{ java_version }}"\n    state: present\n  when: ansible_distribution == \'Debian\' or ansible_distribution == \'Ubuntu\'\n\n- name: Install Java, RedHat\n  yum:\n    name: "{{ java_package_name }}"\n    version: "{{ java_version }}"\n    state: present\n  when: ansible_distribution == \'RedHat\' or ansible_distribution == \'Fedora\'\n\n- name: Export environment variables\n  template:\n    src: java_env.conf.j2\n    dest: /etc/profile.d/java_env.sh\n    mode: 0755\n\n- name: Source environment variables\n  shell: source /etc/profile.d/java_env.sh\n\n- name: Correct java version selected for Java < 11\n  command: alternatives --install /usr/bin/java {{ java_version }}\n  when: java_version < \'11\'\n\n- name: Correct java version selected for Java >= 11\n  command: alternatives --install /usr/bin/java {{ java_version }}\n  when: java_version >= \'11\'\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T20:05:30.78543747Z', 'done': True, 'done_reason': 'stop', 'total_duration': 18628337752, 'load_duration': 96510336, 'prompt_eval_count': 726, 'prompt_eval_duration': 281935772, 'eval_count': 1160, 'eval_duration': 18248186958, 'model_name': 'deepseek-r1:14b'} id='run--3b909f19-9c83-41c0-93c8-3df9a913ef17-0' usage_metadata={'input_tokens': 726, 'output_tokens': 1160, 'total_tokens': 1886}
