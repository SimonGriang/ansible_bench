ere are no syntax errors and that it meets all the user\'s requirements, including the starting \'---\' and proper structure for inclusion in an Ansible Role.\n</think>\n\n```yaml\n---\n- name: Restart RKE2 service on {{ rke2_node_name }}\n  service:\n    name: rke2\n    state: restarted\n  notify: Service (re)started\n\n- name: Wait for all nodes to be ready again\n  delegate_to: "{{ rke2_servers_group_name | first }}"\n  kubectl:\n    command: get\n    args: nodes --all-namespaces -o=jsonpath=\'{range .items[*]}{.status.conditions[*].type}{":"}{.status.conditions[*].status}, {end}\'\n    ignore_errors: yes\n    retries: 100\n    delay: 15\n\n- name: Wait for all pods to be ready again\n  when: rke2_wait_for_all_pods_to_be_ready\n  delegate_to: "{{ rke2_servers_group_name | first }}"\n  kubectl:\n    command: get\n    args: pods --all-namespaces -o=jsonpath=\'{range .items[*]}{.status.conditions[*].type}{":"}{.status.conditions[*].status}, {end}\'\n    ignore_errors: yes\n    retries: 100\n    delay: 15\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T21:03:01.483787316Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13306693860, 'load_duration': 2521692633, 'prompt_eval_count': 489, 'prompt_eval_duration': 351087551, 'eval_count': 760, 'eval_duration': 10432292183, 'model_name': 'deepseek-r1:14b'} id='run--e9256b07-f78c-4824-aef8-828f901a72b1-0' usage_metadata={'input_tokens': 489, 'output_tokens': 760, 'total_tokens': 1249}
