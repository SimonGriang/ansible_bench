---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  run_once: true

- name: Install dns
  apt:
    name: "{{ dns_packages }}"
    state: present

- name: Configure DNS
  template:
    src: "{{ template_name }}"
    dest: "{{ file_path }}"

- name: Restart DNS Service
  service:
    name: "{{ service_name }}"
    state: restarted

- name: Get the hints/root file
  get_url:
    url: "http://{{ root_hints_url }}"
    dest: "{{ dns_config_dir }}/root.hints"
    mode: '0644'
  when: dns_caching_enable | bool

- name: Update DNS Configuration
  copy:
    src: "{{ config_template }}"
    dest: "{{ dns_config_dir }}/dns.conf"
  when: "{{ enable_dns_config | bool }}"

- name: Enable DNS Service on boot
  sysctl:
    name: "{{ sysctl_param }}"
    value: "{{ sysctl_value }}"
    state: present
  when: "{{ apply_sysctl_settings | bool }}"

- name: Apply Firewall Rules
  firewalld:
    service: "{{ firewall_service }}"
    state: "{{ firewall_state }}"
    permanent: yes
    immediate: yes
  when: enable_firewall | bool

- name: Reload Firewall Configuration
  command: systemctl reload firewalld
  when: enable_firewall | bool


