- name: Import assert.yml
  import_tasks: assert.yml
  state: present

- name: Install git
  package:
    name: git
    state: present

- name: Check if user exists
  user:
    name: "{{ user }}"
    state: info

- name: Create git config directory
  mkdir:
    path: ~/.gitconfig
    state: directory
    mode: 755

- name: Place git configuration
  template:
    src: gitconfig
    dest: ~/.gitconfig
    mode: 644

- name: Create repository destination
  mkdir:
    path: /repos
