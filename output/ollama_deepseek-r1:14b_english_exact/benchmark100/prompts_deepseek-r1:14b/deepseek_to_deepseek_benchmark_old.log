---
- name: Create OpenVPN client config directory
  ansible.builtin.file:
    path: /etc/openvpn/client
    state: directory
    owner: root
    group: openvpn_group
    mode: 493  # 0750 in decimal

- name: Place OpenVPN client config file
  ansible.builtin.template:
    src: client.conf.j2
    dest: /etc/openvpn/client.conf
    owner: root
    group: openvpn_group
    mode: 420  # 0640 in decimal
  notify: Restart openvpn


