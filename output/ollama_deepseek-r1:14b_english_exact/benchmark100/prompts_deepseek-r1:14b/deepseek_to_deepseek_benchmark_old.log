    group: promtail
    state: present
    groups: []
    create_home: yes

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: 0755

- name: Create configuration directories
  file:
    path: /etc/promtail.d
    state: directory
    owner: promtail
    group: promtail
    mode: 0755

- name: Create application directories
  file:
    path: /var/lib/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: 0755

- name: Create application directories
  file:
    path: /var/lib/promtail/bin
    state: directory
    owner: promtail
    group: promtail
    mode: 0755

- name: Check promtail binary existence
  file:
    path: /usr/local/bin/promtail
    state: file

- name: Download promtail binaries
