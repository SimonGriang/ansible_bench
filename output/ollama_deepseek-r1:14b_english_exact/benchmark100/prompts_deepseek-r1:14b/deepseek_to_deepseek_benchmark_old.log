---
- name: Import assert.yml
  import_file:
    state: present
    file: assert.yml
  delegate_to: localhost
  only_once: true

- name: Install required packages
  yum:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta:
    flush_handlers: yes

- name: Configure selinux
  block:
    - name: Manage SELinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Manage SELinux booleans
      loop: "{{ selinux_booleans | default([]) }}"
      selinux_bool:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: yes
        label: "{{ item.label }}"
  when:
    - selinux_status is defined
    - connection is not in [ 'container', 'docker', 'community.docker.docker' ]


