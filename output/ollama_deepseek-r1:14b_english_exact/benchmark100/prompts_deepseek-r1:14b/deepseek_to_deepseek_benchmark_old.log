---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  args:
    force: yes
  hosts: localhost

- name: Install prerequisites
  apt:
    name: "{{ vault_prerequisites }}"
    state: present

- name: Include installation method specific tasks
  import_tasks:
    file: method_{item}.yml
  loop: "{{ vault_installation_method }}"
  when: vault_installation_method is defined

- name: Add Vault environment variables
  template:
    src: vault_env.j2
    dest: /etc/vault.d/vault.env
    notify: Restart vault

- name: Include hardening tasks
  import_tasks:
    file: hardening.yml

- name: Start and enable vault (for OSS type)
  service:
    name: vault
    state: started
    enabled: yes
  when: vault_type == "oss"

- name: Enable vault (for non-OSS type)
  service:
    name: vault
    enabled: yes
  when: vault_type != "oss"


