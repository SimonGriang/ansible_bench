---
vars:
  cron_packages: ['cron', 'cron-daemon']
  cron_shell: /bin/bash
  cron_path: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  cron_mailto: root

tasks:
  - name: Import assertion file
    ansible.builtin.include_vars:
      file: assert.yml
      host: localhost

  - name: Install cron package
    apt-get:
      name: "{{ item }}"
      state: present
      update_cache: yes
    loop: "{{ cron_packages }}"

  - name: Configure cron shell environment
    ansible.builtin.replace:
      path: /etc/crontab
      before: "#.*#"
      line: SHELL="{{ cron_shell }}"

  - name: Configure cron path environment
    ansible.builtin.replace:
      path: /etc/crontab
      before: ".*PATH=.*"
      line: PATH="{{ cron_path }}"

  - name: Configure cron mailto settings
    ansible.builtin.replace:
      path: /etc/crontab
      before: ".*MAILTO=.*"
      line: MAILTO="{{ cron_mailto }}"

  - name: Start and enable cron service
    systemd:
      name: cron
      state: started
      enabled: yes
    when: cron_service is defined

  - name: Schedule cron jobs
    cron:
      name: "{{ item.name }}"
      cron_name: "{{ item.cron_name }}"
      schedule: "{{ item.schedule }}"
      command: "{{ item.command }}"
      state: present
    loop: "{{ cron_jobs }}"


