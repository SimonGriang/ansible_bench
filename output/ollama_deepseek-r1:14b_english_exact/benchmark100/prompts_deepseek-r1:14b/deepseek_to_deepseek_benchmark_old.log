- name: Create /etc/openvpn/easy-rsa directory with correct permissions
  file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: 0755

- name: Initialize OpenVPN PKI structure
  command: easyrsa init-pki
  args:
    chdir: /etc/openvpn/easy-rsa

- name: Generate OpenVPN CA certificate
  command: easyrsa build-ca --nopass
  environment:
    EASYRSA_BATCH: "yes"

- name: Generate Diffie-Hellman parameters
  command: easyrsa gen-dh

- name: Generate server certificate
  command: easyrsa build-server-full --nopass
  environment:
    EASYRSA_BATCH: "yes"

- name: Generate client certificate
  command: easyrsa build-client-full --nopass
  environment:
    EASYRSA_BATCH: "yes"

- name: Generate Certificate Revocation List
  command: easyrsa gen-crl

- name: Generate OpenVPN TA key
  command: openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key

- name: Copy PKI files to /etc/openvpn/server directory
  copy:
    remote_src: no
    src: /etc/openvpn/easy-rsa/pki/{ca.crt,certs/dh2048.pem,keys/ta.key,crl.pem}
    dest: /etc/openvpn/server
    mode: 0640

- name: Copy additional PKI files to /etc/openvpn directory
  copy:
    remote_src: no
    src: /etc/openvpn/easy-rsa/pki/{ca.crt,certs/dh2048.pem}
    dest: /etc/openvpn
    mode: 0640

- name: Place OpenVPN server configuration file
  template:
    src: server.conf.j2
    dest: /etc/openvpn/server.conf
    mode: 0640
    owner: openvpn
    group: openvpn
  notify: restart_openvpn


