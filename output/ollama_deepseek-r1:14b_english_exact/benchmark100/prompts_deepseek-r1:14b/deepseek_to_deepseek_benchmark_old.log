- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install fail2ban
  apt:
    name: "{{ fail2ban_packages }}"
    state: present

- name: Copy filters in filter.d
  copy:
    src: "{{ fail2ban_filterd_path }}/"
    dest: /etc/fail2ban/filter.d/
    owner: root
    group: root
    mode: 0640
  notify: Restart fail2ban
  when: fail2ban_filterd_path is defined

- name: Configure fail2ban.local
  lineinfile:
    path: /etc/fail2ban/failban.local
    line: "{{ item.value }}"
    insertafter: "{{ item.section }}"
    before: "{{ item.section }}_end"
    mode: 0640
  loop: |
    {% set combined = fail2ban_base_configuration | union(fail2ban_configuration) %}
    {% for item in combined %}
    - item
    {% endfor %}
  notify: Restart fail2ban

- name: Configure jail.local
  lineinfile:
    path: /etc/fail2ban/jail.local
    line: "{{ item.value }}"
    insertafter: "{{ item.section }}"
    before: "{{ item.section }}_end"
    mode: 0640
  loop: |
    {% set combined = fail2ban_base_jail_configuration | union(fail2ban_jail_configuration) %}
    {% for item in combined %}
    - item
    {% endfor %}
  notify: Restart fail2ban

- name: Stat auth log file
  stat:
    path: /var/log/auth.log
  register: fail2ban_auth

- name: Touch auth log file
  file:
    path: /var/log/auth.log
    state: touch
    mode: 0640
  when: fail2ban_auth.stat.exists is not defined

- name: Start and enable fail2ban
  service:
    name: "{{ fail2ban_service }}"
    state: started
    enabled: true



