's instructions without any deviations.\n</think>\n\n```yaml\n---\n- name: Import assertion tasks\n  import_tasks: assert.yml\n  delegate_to: localhost\n  run_once: true\n\n- name: Install Docker Compose package\n  become: yes\n  package:\n    name: "{{ docker_compose_package_name | default(\'docker-compose\') }}"\n    state: present\n  when: installation_type == "package"\n\n- name: Install Docker Compose binary\n  become: yes\n  apt:\n    name: "{{ item }}"\n    state: present\n  with_items:\n    - docker.io\n    - python3\n    - python3-pip\n  when: installation_type == "binary"\n\n- name: Download and install Docker Compose binary\n  become: yes\n  file:\n    path: "{{ docker_compose_binary_path }}"\n    url: "{{ docker_compose_binary_url }}"\n    mode: 0755\n  when: installation_type == "binary"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T17:59:20.743936221Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10404444471, 'load_duration': 91332764, 'prompt_eval_count': 382, 'prompt_eval_duration': 87467439, 'eval_count': 626, 'eval_duration': 10224172696, 'model_name': 'deepseek-r1:14b'} id='run--9aa03222-44a8-4f46-bb4d-9a0dfd9790ff-0' usage_metadata={'input_tokens': 382, 'output_tokens': 626, 'total_tokens': 1008}
