---
- name: Create docroot for each vhost
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
    create: no
    when:
      - item.create_docroot | default('yes') | lower == 'yes'
      - item.documentroot is defined
  loop: "{{ httpd_vhosts }}"

- name: Configure vhosts
  template:
