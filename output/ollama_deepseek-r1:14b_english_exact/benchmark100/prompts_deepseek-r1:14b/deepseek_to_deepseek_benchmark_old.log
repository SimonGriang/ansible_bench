tainerd_registry_configs is defined)\n  notify: containerd_registry_config_changed\n\n- name: Register etcd restore from file\n  set_fact:\n    etcd_restore_from_file: "{{ etcd_snapshot_file is defined\n                               and rke2_service is \'running\' | boolean | yes }}"\n\n- name: Register etcd restore from S3\n  set_fact:\n    etcd_restore_from_s3: "{% if rke2_etcd_s3_bucket is defined\n                            and rke2_etcd_s3_prefix is defined %}\n                            {% if rke2_etcd_s3_access_key is defined\n                            or rke2_etcd_s3_secret_key is defined %}\n                            true{% else %}false{% endif %}\n                          {% else %}false{% endif | boolean | yes }}"\n\n- name: Restore etcd from file\n  shell: |\n    mkdir -p /var/lib/rke2/etcd/\n    cp "{{ etcd_snapshot_file }}" /var/lib/rke2/etcd/etcd-snapshot.db\n    chown -R rke2:rke2 /var/lib/rke2/etcd/\n    rke2 etcd restore --config /etc/rke2/config/rke2.yaml\n  when: etcd_restore_from_file is true\n\n- name: Restore etcd from S3\n  shell: |\n    mkdir -p /mnt/s3-restore/\n    mount -t s3fs "{{ rke2_etcd_s3_bucket }}":{{ (rke2_etcd_s3_access_key if rke2_etcd_s3_access_key is defined else \'\') }}:{{ (rke2_etcd_s3_secret_key if rke2_etcd_s3_secret_key is defined else \'\') }}\n    /mnt/s3-restore\n    cp /mnt/s3-restore/{{ rke2_etcd_s3_prefix }}/etcd-snapshot.db\n    /var/lib/rke2/etcd/\n    umount /mnt/s3-restore\n    rke2 etcd restore --config /etc/rke2/config/rke2.yaml\n  when: etcd_restore_from_s3 is true\n\n- name: Start RKE2 service\n  service:\n    name: rke2\n    state: started\n    enabled: yes\n    environment:\n      RKE2_TOKEN: "{{ rke2_token }}"\n\n- name: Mask RKE2 agent service\n  service:\n    name: rke2-agent\n    state: stopped\n    enabled: no\n\n- name: Wait for first server to be ready (no CNI)\n  wait_for_task:\n    path: /bin/sh -c \'kubectl get nodes | grep -E "^{{ rke2_server_node_names.0 }} " | grep -q "Ready"\'\n\n- name: Wait for first server to be ready (with CNI)\n  shell: kubectl get nodes | grep -E "^{{ rke2_server_node_names.0 }} " | grep -q "Ready"\n\n- name: Restore etcd\n  shell: |\n    rke2 etcd cleanup --config /etc/rke2/config/rke2.yaml\n    rke2 etcd restore --config /etc/rke2/config/rke2.yaml\n  when: etcd_restore_from_file is true or etcd_restore_from_s3 is true\n\n- name: Set Active Server variable\n  set_fact:\n    active_server: "{{ rke2_server_node_names.0 }}"\n  delegate_to: "{{ rke2_server_node_names.0 }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T20:32:27.827592797Z', 'done': True, 'done_reason': 'stop', 'total_duration': 32452665654, 'load_duration': 87461277, 'prompt_eval_count': 2236, 'prompt_eval_duration': 666177160, 'eval_count': 1728, 'eval_duration': 31698041977, 'model_name': 'deepseek-r1:14b'} id='run--984b8aca-0912-4190-b64f-7eddc30b0a44-0' usage_metadata={'input_tokens': 2236, 'output_tokens': 1728, 'total_tokens': 3964}
