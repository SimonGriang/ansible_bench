    - name: Fallback to local download
      copy:
        src: "{{ local_artifacts_path }}/"
        dest: "{{ rke2_artifacts_path }}"
        remote_src: yes
        mode: 0640
      when: airgap_mode | bool

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ local_artifacts_path }}/"
    dest: "{{ rke2_artifacts_path }}"
    remote_src: yes
    mode: 0640
  when:
    - airgap_mode | bool
    - use_exists | bool

- name: Airgap mode - additional images tarballs
  block:
    - name: Create directory for additional images
      file:
        path: "{{ additional_images_path }}"
        state: directory
        mode: 0700

    - name: Copy additional images tarballs
      copy:
        src: "{{ additional_images_src }}/"
        dest: "{{ additional_images_path }}"
        remote_src: yes
        mode: 0640
        with_items: "{{ additional_images }}"

  when:
    - additional_images | bool
    - additional_images_src | bool

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Set artifacts directory permissions
      file:
        path: "{{ rke2_artifacts_path }}"
        state: directory
        mode: 0700

    - name: Set install script permissions
      stat:
        path: "/etc/rke2/install.sh"
        check_mode: yes
      register: install_script_stat
      when: airgap_mode | bool

  when: airgap_mode | bool

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_path }}"

