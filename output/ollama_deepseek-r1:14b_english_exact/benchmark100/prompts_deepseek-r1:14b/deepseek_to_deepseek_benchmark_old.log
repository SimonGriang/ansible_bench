        mode: 0640
        dest_mode: 0640

    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}/rke2.tgz"
        force: yes
        mode: 0640
        dest_mode: 0640

