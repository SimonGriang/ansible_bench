---
- name: Import assertion tasks
  include_tasks:
    file: assert.yml
  delegate_to: localhost
  changed_when: false

- name: Install Python pip
  become: yes
  become_user: root
  apt:
    name: "{{ python_pip_packages }}"
    state: present
  when: true

- name: Configure pip proxy settings
  become: yes
  become_user: root
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
  when: true

- name: Configure pip trusted hosts
  become: yes
  become_user: root
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
  when: true

- name: Update pip
  become: yes
  become_user: root
  pip:
    command: upgrade
    version: latest
  when: ansible_distribution in ['bookworm', 'noble'] and ansible_os_family == 'Alpine'
  skip_on_failure: true

- name: Install Python modules
  become: yes
  become_user: root
  pip:
    name: "{{ item }}"
    state: present
    version: "{{ item_version | default('latest') }}"
  loop: "{{ python_pip_modules | default([]) | list }}"
  when: ansible_distribution in ['bookworm', 'noble'] and ansible_os_family == 'Alpine'
  skip_on_failure: true

