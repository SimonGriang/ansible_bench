---
- name: Create local SSH key directory for user
  file:
    path: "{{ key_dir }}"
    state: directory
    owner: "{{ user }}"
    mode: 0750

- name: Manage user account
  user:
    name: "{{ user }}"
    state: present
    comment: "{{ user_comment }}"
    home: "{{ user_home }}"
    shell: "{{ user_shell }}"

- name: Set sudo options for user
  lineinfile:
    path: /etc/sudoers.d/{{ user }}
    line: "{{ user }}    ALL=(ALL) NOPASSWD:ALL"
    state: present

- name: Generate private SSH key for user
  command: ssh-keygen -q -t rsa -f "{{ key_dir }}/{{ user }}_ssh_key" -N ""
  register: private_key_result

- name: Generate public SSH key for user
  command: ssh-keygen -y -f "{{ key_dir }}/{{ user }}_ssh_key" | tee "{{ key_dir }}/{{ user }}_ssh_key.pub"
  register: public_key_result

- name: Convert SSH key to ppk format for user
  shell: ssh-keygen -p -t dsa -f "{{ key_dir }}/{{ user }}_ssh_key" -N "" -o -O "import-file-format ssh-dss"
  changed_when: false

- name: Get or set the home directory for user
  user:
    name: "{{ user }}"
    home: "{{ user_home }}"

- name: Create .ssh directory for user
  file:
    path: "{{ user_home }}/.ssh"
    state: directory
    owner: "{{ user }}"
    mode: 0700

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user }}"
    key: "{{ item }}"
    state: present
  with_items: "{{ authorized_keys }}"

- name: Remove unauthorized keys for user
  file:
    path: "{{ user_home }}/.ssh/authorized_keys"
    state: absent
    line: "{{ item }}"
    regex: "^{{ item }}$"
  with_items: "{{ unauthorized_keys }}"

- name: Copy generated private SSH key for user
  copy:
    src: "{{ key_dir }}/{{ user }}_ssh_key"
    dest: "{{ user_home }}/{{ user }}_ssh_key"
    mode: 0600

- name: Check users password valid time for user
  password_policy:
    user: "{{ user }}"
    check: yes

- name: Set users password valid time for user
  password_policy:
    user: "{{ user }}"
    max_days: 90
    min_days: 7

- name: Place private key file for user
  copy:
    src: "{{ key_dir }}/{{ user }}_ssh_key"
    dest: "{{ user_home }}/.ssh/id_rsa"
    mode: 0600


