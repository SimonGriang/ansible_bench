---
- name: Restore etcd - get all nodes
  kubectl:
    command: get
    resource: nodes
    output_format: name
  register: node_names

- name: Restore etcd - remove old nodes
  shell: 
    - kubectl delete node
    - "{{ item }}"
  loop: "{{ node_names.items | map(attribute='name') | list }}"
  when: 
    - item not in (groups['rke2_cluster_group_name'] | map(attribute='hosts') | join(','))
  ignore_errors: yes

