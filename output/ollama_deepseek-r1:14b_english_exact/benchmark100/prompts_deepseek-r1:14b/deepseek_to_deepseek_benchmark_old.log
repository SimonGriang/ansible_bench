ion_family == "RedHat"\n    - ansible_distribution != "Fedora"\n    - ansible_package_state == "present"\n\n- name: Set up Ansible on Fedora\n  include_tasks: setup-Fedora.yml\n  when:\n    - ansible_distribution == "Fedora"\n    - ansible_package_state == "present"\n\n- name: Set up Ansible on Ubuntu\n  include_tasks: setup-Ubuntu.yml\n  when:\n    - ansible_distribution == "Ubuntu"\n    - ansible_package_state == "present"\n\n- name: Set up Ansible on Debian\n  include_tasks: setup-Debian.yml\n  when:\n    - ansible_distribution == "Debian"\n    - ansible_package_state == "present"\n\n- name: Set up Ansible using Pip\n  include_tasks: setup-pip.yml\n  when: ansible_package_state == "absent"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T21:17:23.402771874Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8865572337, 'load_duration': 92498755, 'prompt_eval_count': 479, 'prompt_eval_duration': 104653782, 'eval_count': 610, 'eval_duration': 8667645805, 'model_name': 'deepseek-r1:14b'} id='run--27a7b212-c3ee-4fa2-9102-86d899b0c60c-0' usage_metadata={'input_tokens': 479, 'output_tokens': 610, 'total_tokens': 1089}
