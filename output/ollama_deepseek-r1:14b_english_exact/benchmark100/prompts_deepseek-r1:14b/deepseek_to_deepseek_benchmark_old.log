---
- name: Import assertion file
  include_tasks:
    file: assert.yml
  args:
    host: localhost

- name: Install system requirements
  apt:
    name: bash
    state: latest

- name: Install OpenJDK Java
  apt:
    name: openjdk-8
    state: present
  when: java_vendor == "openjdk"

- name: Install Oracle Java RPM from local
  become: yes
  become_user: root
  copy:
    src: oracle-jdk-*.rpm
    dest: /tmp/
  yum:
    name: "{{ rpm_package_name }}"
    state: present
  when: java_source == "local" and java_format == "rpm"

- name: Install Oracle Java DEB from local
  become: yes
  become_user: root
  copy:
    src: oracle-jdk-*.deb
    dest: /tmp/
  dpkg:
    name: "{{ deb_package_name }}"
    state: present
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java RPM from repository
  become: yes
  become_user: root
  apt:
    name: "{{ repo_rpm_package }}"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Java targz installation
  unzip:
    remote_src: yes
    dest: /tmp/oracle-jdk
  shell: /tmp/oracle-jdk/jdk-*.bin -s silent -jreMode none
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java JCE policy
  become: yes
  become_user: root
  copy:
    src: jce-*.tar.gz
    dest: /tmp/
  shell: |
    tar -xzf jce-*.tar.gz
    chmod 755 /tmp/jce
    cp -rf /tmp/jce/* /usr/lib/jvm/java-8-oracle/jre/lib/security
  when: java_jce and java_version == 8 and java_vendor == "oracle"

- name: Set Java alternative
  shell: alternatives --install /usr/bin/java java /usr/lib/jvm/java-8-oracle/bin/java 0
  when: java_format == "targz" and ansible_distribution != "Alpine"

- name: Find Java home directory
  shell: readlink -e /usr/bin/java
  register: java_home

- name: Set JAVA_HOME in environment
  template:
    src: java_home.sh.j2
    dest: /etc/profile.d/java_home.sh
    mode: 0755
  vars:
    java_home_path: "{{ java_home.stdout }}"


