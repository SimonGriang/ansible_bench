---
- name: Import assertion file
  import_tasks: assert.yml
  remote_host: localhost

- name: Install cron packages
  apt:
    state: present
    name: "{{ cron_packages }}"

- name: Configure cron shell
  cron:
    name: "SHELL"
    value: "/bin/bash"
  notify: start_and_enable_cron_service

- name: Configure cron path
  cron:
    name: "PATH"
    value: "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  notify: start_and_enable_cron_service

- name: Configure cron mailto
  cron:
    name: "MAILTO"
    value: "root"
  notify: start_and_enable_cron_service

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: yes
  become: yes
  become_flags: --yes
  register: cron_service_status
  changed_when: false
  contacted: true
  handler: start_and_enable_cron_service

- name: Schedule cron jobs
  cron:
    jobs: "{{ cron_jobs }}"
  notify: start_and_enable_cron_service


