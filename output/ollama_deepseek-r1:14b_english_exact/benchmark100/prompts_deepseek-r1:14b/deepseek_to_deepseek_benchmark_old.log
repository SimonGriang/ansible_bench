---
- name: Import assertion tasks
  ansible.builtin.import_tasks:
    path: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install system packages
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_requirements }}"

- name: Install Python packages
  ansible.builtin.pip:
    requirements: "{{ item }}"
    state: present
  loop: "{{ openssl_pip_packages }}"
  when: ansible.builtin.length(openssl_pip_packages) > 0

- name: Create key directory
  ansible.builtin.file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: "0700"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create certificate signing request directory
  ansible.builtin.file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: "0755"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Create certificate directory
  ansible.builtin.file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: "0755"
    owner: "{{ openssl_file_owner }}"
    group: "{{ openssl_file_group }}"

- name: Include create tasks
  ansible.builtin.import_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item
    label: "{{ item.name }}"
  when: ansible.builtin.length(openssl_items) > 0


