---
- name: Create docroot directories for each virtual host
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: 0755
  loop: "{{ httpd_vhosts if httpd_vhosts | default | list }} }}"
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - create_docroot | default(true) | bool
  loop_control:
    loop_var: item

- name: Configure virtual host settings
  template:
    src: vhost_conf_template
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: 0644
  loop: "{{ httpd_vhosts if httpd_vhosts | default | list }} }}"
  when: httpd_vhosts is defined
  loop_control:
    loop_var: item

- name: Enable virtual hosts on Debian systems
  apt:
    name: "{{ item.name }}.conf"
    state: present
    enable: true
    mode: 0644
    creates: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
  when: ansible_os_family == "Debian"
  notify: 
    - Test httpd configuration validity
    - Restart httpd
  loop: "{{ httpd_vhosts if httpd_vhosts | default | list }} }}"
  loop_control:
    loop_var: item


