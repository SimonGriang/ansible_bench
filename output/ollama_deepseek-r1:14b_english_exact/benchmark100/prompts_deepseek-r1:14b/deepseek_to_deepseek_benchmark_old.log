    mode: 0640
    template: yes
  when: custom_manifests_src | bool

- name: Copy Static Pods
  copy:
    src: "{{ static_pods_src }}"
    dest: "{{ rke2_agent_manifests_path }}"
    remote_src: yes
    mode: 0640
  when: static_pods_src | bool

