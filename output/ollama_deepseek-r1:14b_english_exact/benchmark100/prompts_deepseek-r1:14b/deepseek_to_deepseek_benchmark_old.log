---
- name: Install Vault dependencies
  apt:
    name:
      - unzip
      - curl
    state: present

- name: Download and install Vault
  file:
    path: /usr/local/bin/vault
    src: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_amd64.zip"
    state: present
    mode: '0755'

- name: Create Vault configuration directory
  file:
    path: /etc/vault.d
    state: directory

- name: Generate Vault hash ring
  hashring:
    name: my_hash_ring
    nodes:
      - name: node1
        weight: 1
      - name: node2
        weight: 2
      - name: node3
        weight: 3
    state: present

- name: Create Vault policy
  vault_policy:
    name: my_policy
    rules:
      path:
        "secret/*": 
          capabilities: [ "read", "write", "delete" ]
        "secret/team": 
          capabilities: [ "read" ]
          explicit_deny: true
      secret:
        enabled: true

- name: Start Vault service
  service:
    name: vault
    state: started
    enabled: true


