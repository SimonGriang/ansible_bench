---
- name: Import assertion tasks
  import_tasks:
    file: assert.yml
    remote_host: localhost
    state: present

- name: Install required software packages
  apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ users_requirements | default([]) }}"
  when: users_requirements is not empty

- name: Manage user groups
  include_tasks:
    file: group.yml
  loop: "{{ users_groups | default([]) }}"

- name: Configure sudoers directory inclusion
  visudo:
    name: /etc/sudoers.d
    state: present

- name: Manage user configurations
  include_tasks:
    file: user.yml
  loop: "{{ users | default([]) }}"

- name: Configure cron allow permissions
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0644
  when: users_cron_allow

- name: Remove cron allow file if not needed
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow

