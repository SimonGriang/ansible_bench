---
- name: Import assertion file
  import_tasks:
    file: assert.yml
  run_once: true
  host: localhost

- name: Enable Redis module stream for RHEL 8
  dnf:
    name: redis
    state: enabled
  become: true

- name: Install Redis package
  package:
    name: "{{ redis_packages }}"
    state: present
  become: true

- name: Configure Redis settings
  template:
    src: redis.conf-{{ ansible_distribution }}.j2
    dest: /etc/redis/redis.conf
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: restart_redis

- name: Start and enable Redis service
  systemd:
    name: "{{ redis_service }}"
    state: started
    enabled: true
  become: true


