---
- name: Validate all variables are set correctly
  block:
    - name: Test if 'bootstrap_user' is set correctly
      ansible.builtin.include_tasks: assert.yml
      vars:
        host: localhost

    - name: Test if 'bootstrap_wait_for_host' is set correctly
      ansible.builtin.include_tasks: assert.yml
      vars:
        host: localhost

    - name: Test if 'bootstrap_timeout' is set correctly
      ansible.builtin.include_tasks: assert.yml
      vars:
        host: localhost

- name: Wait for host to be available
  ansible.builtin.wait_for:
    state: started
    port: 22
    timeout: 30

- name: Prepare system for bootstrap - test connection
  ansible.builtin.raw: whoami
  register: connection_test
  ignore_errors: true
  changed_when: false

- name: Prepare system for bootstrap - gather facts
  ansible.builtin.setup:
    gather_subset: minimal

- name: Prepare system for bootstrap - install packages
  ansible.builtin.apt:
    name: "{{ packages }}"
    state: present
    update_cache: true

- name: Ensure system preparation with Ansible modules - gather facts
  ansible.builtin.setup:
    gather_subset: minimal

- name: Ensure system preparation with Ansible modules - install packages
  ansible.builtin.apt:
    name: "{{ packages }}"
    state: present
    update_cache: true


