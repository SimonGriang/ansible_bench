---
- import_tasks: assert.yml
  vars:
    ansible_host: localhost
    ansible_user: ansible

- name: Install vsftpd
  package:
    name: vsftpd
    state: present

- name: Configure vsftpd
  template:
    src: vsftpd.conf.j2
    dest: /etc/vsftpd.conf
    owner: root
    group: root
    mode: 0644
  notify: restart vsftpd

- name: Start and enable vsftpd
  service:
    name: vsftpd
    state: started
    enabled: true
  notify: restart vsftpd


