---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: 22
    timeout: "{{ bootstrap_timeout }}"
    state: started
  when: connection not in ['container', 'docker', 'community.docker.docker']

- name: Prepare system
  become: true
  become_user: root
  rescue:
    name: Gather facts and install bootstrap packages
    setup:
      gather_subset: all
    apt:
      name: "{{ bootstrap_facts_packages }}"
      state: present
      become: "{{ bootstrap_become | bool }}"

- name: Gather ansible facts
  setup:
    gather_subset: all
  become: no

- name: Install bootstrap packages
  apt:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    become: "{{ bootstrap_become | bool }}"


