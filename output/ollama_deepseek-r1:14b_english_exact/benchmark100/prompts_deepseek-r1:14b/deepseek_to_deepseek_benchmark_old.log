---
- name: Install unzip package
  apt:
    name: unzip
    state: present

- name: Create system group for promtail
  group:
    name: promtail
    state: present
    no_root_group: yes

- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    state: present
    groups: []
    create_home: yes

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    owner: root
    group: root
    mode: 0755

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: 0755

- name: Create configuration directories
  file:
    path: /etc/promtail.d
    state: directory
    owner: promtail
    group: promtail
    mode: 0755

- name: Create application directories
  file:
    path: /var/lib/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: 0755

- name: Create application directories
  file:
    path: /var/lib/promtail/bin
    state: directory
    owner: promtail
    group: promtail
    mode: 0755

- name: Check promtail binary existence
  file:
    path: /usr/local/bin/promtail
    state: file

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_distribution_url }}"
    dest: "/tmp/promtail.zip"
    checksum: "{{ promtail_binary_checksum }}"

- name: Propagate local promtail binaries
  copy:
    src: "{{ promtail_binary_local_path }}"
    dest: /tmp/

- name: Download promtail binaries for controller node
  get_url:
    url: "{{ promtail_controller_url }}"
    dest: "/tmp/promtail_controller.zip"
    checksum: "{{ promtail_controller_checksum }}"

- name: Propagate promtail binaries
  copy:
    src: "{{ promtail_binary_local_path }}"
    dest: /tmp/

- name: Unpack promtail binaries
  unzip:
    file: "/tmp/promtail.zip"
    dest: /usr/local/bin/
    remote_src: yes

- name: Create symlink to latest promtail version
  ln:
    state: symlink
    src: "/usr/local/bin/promtail"
    dest: "/usr/local/bin/promtail-latest"
    notify: restart promtail

- name: Write promtail config file
  template:
    src: promtail_config.j2
    dest: /etc/promtail/promtail.yml
    owner: promtail
    group: promtail
    mode: 0644

- name: Create systemd service unit
  template:
    src: promtail_service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: 0644
  notify: restart promtail


