---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  run_once: true

- name: Install dns
  apt:
    name: "{{ dns_packages }}"
    state: present
    update_cache: true

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - path: "{{ dns_data_dir }}"
      mode: '0755'
      owner: '{{ dns_owner }}'
      group: '{{ dns_group }}'
    - path: "{{ dns_config_dir }}"
      mode: '0755'
      owner: '{{ dns_owner }}'
      group: '{{ dns_group }}'

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    system: true
    home: "/var/lib/{{ dns_owner }}"
    shell: "/usr/sbin/nologin"

- name: Generate rndc key
  rndc_keygen:
    keyfile: "{{ dns_config_dir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_config_dir }}/rndc.key"
    owner: "{{ dns_owner }}"
