---
- name: Import assertion tasks
  import_tasks: assert.yml
  host: localhost

- name: Install using package
  become: yes
  become_flags: sudo
  become_user: root
  vars:
    hashicorp_pkg_name: "{{ hashicorp_pkg_name | default('packer') }}"
  when: ansible_os_family == 'Debian' or ansible_distribution in ['Ubuntu', 'Debian']
  apt:
    name: "{{ hashicorp_pkg_name }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'RedHat' or ansible_distribution in ['CentOS', 'Fedora', 'RHEL']
  yum:
    name: "{{ hashicorp_pkg_name }}"
    state: present

- name: Configure debian
  become: yes
  become_flags: sudo
  become_user: root
  apt_key:
    keyserver: 'hkp://keyserver.ubuntu.com:80'
    key: 'C3DE9B02F80E0EC8CB56BEF76787D3677C7FF7D8'
  apt_repository:
    repo: 'deb [arch=amd64] https://releases.hashicorp.com/debian stretch main'
    state: present

- name: Install hashicorp product using package
  become: yes
  become_flags: sudo
  become_user: root
  vars:
    hashicorp_pkg_name: "{{ hashicorp_pkg_name | default('packer') }}"
    hashicorp_version: "{{ hashicorp_version | default('latest') }}"
  when: ansible_os_family == 'Debian' or ansible_distribution in ['Ubuntu', 'Debian']
  apt:
    name: "{{ hashicorp_pkg_name }}={{ hashicorp_version }}"
    state: present
    update_cache: yes
  when: ansible_os_family == 'RedHat' or ansible_distribution in ['CentOS', 'Fedora', 'RHEL']
  yum:
    name: "{{ hashicorp_pkg_name }}={{ hashicorp_version }}"
    state: present

- name: Install manually
  become: yes
  become_flags: sudo
  become_user: root
  vars:
    hashicorp_download_url: "https://releases.hashicorp.com/{{ hashicorp_pkg_name }}/{{ hashicorp_version }}/{{ hashicorp_pkg_name }}_{{ hashicorp_version }}_linux_amd64.zip"
    hashicorp_install_dir: "{{ hashicorp_install_dir | default('/usr/local/bin') }}"
  fetch:
    url: "{{ hashicorp_download_url }}"
    dest: "{{ hashicorp_download_url | basename() }}"
    validate_certs: yes
  unarchive:
    src: "{{ hashicorp_download_url | basename() }}"
    dest: "{{ hashicorp_install_dir }}"
    remote_src: yes
    mode: '0755'
    owner: root
    group: root


