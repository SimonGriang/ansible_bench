- name: Remove externally managed from Debian 12
  apt:
    name: "{{ external_managed_packages | default([]) | join(',') }}"
    state: absent

- name: Ensure Pip is installed
  apt:
    name: python3-pip
    state: present
    update_cache: yes

- name: Ensure packaging is available via dnf
  dnf:
    name: python3-packaging
    state: present
    repo: powertools

- name: Ensure pip_install_packages are installed
  pip:
    name: "{{ pip_install_packages | default([]) | map(attribute='name') | join(',') }}"
    version: "{{ item.version | default('latest') }}"
    venv: "{{ item.venv | default('') }}"
    extra_args: "{{ item.extra_args | default('') }}"
    state: present
  loop: "{{ pip_install_packages | default([]) }}"


