on3-pip\n    state: present\n    update_cache: yes\n\n- name: Ensure packaging is available via dnf\n  dnf:\n    name: python3-packaging\n    state: present\n    repo: powertools\n\n- name: Ensure pip_install_packages are installed\n  pip:\n    name: "{{ pip_install_packages | default([]) | map(attribute=\'name\') | join(\',\') }}"\n    version: "{{ item.version | default(\'latest\') }}"\n    venv: "{{ item.venv | default(\'\') }}"\n    extra_args: "{{ item.extra_args | default(\'\') }}"\n    state: present\n  loop: "{{ pip_install_packages | default([]) }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T18:54:19.339580041Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8195419263, 'load_duration': 82108800, 'prompt_eval_count': 399, 'prompt_eval_duration': 95203590, 'eval_count': 565, 'eval_duration': 8017023839, 'model_name': 'deepseek-r1:14b'} id='run--6b2acfb0-82d3-4168-bd86-9915dce6b3e2-0' usage_metadata={'input_tokens': 399, 'output_tokens': 565, 'total_tokens': 964}
