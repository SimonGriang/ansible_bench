---
- name: Import assertion tasks
  include_tasks:
    file: assert.yml
  delegate_to: localhost
  changed_when: false

- name: Install Python pip
  become: yes
  become_user: root
  apt:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  become: yes
  become_user: root
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  become: yes
  become_user: root
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
  when: python_pip_trusted_host is defined

- name: Update pip
  become: yes
  become_user: root
  pip:
    command: upgrade
    version: latest
  when: ansible_distribution in ['bookworm', 'noble'] or ansible_os_family == 'Alpine'
  skip_on_failure: yes

- name: Install Python modules
  become: yes
  become_user: root
  pip:
    name: "{{ item }}"
    state: present
    version: "{{ item_version | default('latest') }}"
  loop: "{{ python_pip_modules | default([]) | list }}"
  when: ansible_distribution in ['bookworm', 'noble'] or ansible_os_family == 'Alpine'
  skip_on_failure: yes


