---
- name: lookup bootstrap facts (raw)
  shell: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  vars:
    ansible_user: "{{ bootstrap_user }}"

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ bootstrap_facts.stdout | regex_search('VERSION_ID="?([^"]+)"') | last | regex_replace('"','') }}"
    bootstrap_distribution_major_version: "{{ bootstrap_facts.stdout | regex_search('VERSION_ID="?([^"]+)"') | last | regex_replace('"','') | regex_replace('\\.','') }}"
  vars:
    ansible_user: "{{ bootstrap_user }}"
    ansible_become: "{{ ansible_become }}"

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map | dict2list }}"
  vars:
    ansible_become: "{{ ansible_become }}"

