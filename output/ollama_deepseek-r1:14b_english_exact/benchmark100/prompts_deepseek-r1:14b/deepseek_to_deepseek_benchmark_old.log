---
- name: Create the RKE2 config directory
  file:
    path: /etc/rke2/config
    state: directory
    mode: '0755'

- name: Set server taints
  kubernetes.core.k8s_set_node_taints:
    node: "{{ item }}"
    taints: "{{ rke2_server_node_taints }}"
    register: taint_result
  with_items: "{{ rke2_server_node_names }}"
  when: rke2_server_node_taints is defined

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rke2/config
    remote_src: yes
    mode: '0644'
    group: 'root'
  notify: rke2_config_changed

- name: Copy kubelet configuration file
  copy:
    src: "{{ rke2_kubelet_config_src }}"
    dest: /etc/rke2/config
    remote_src: yes
    mode: '0644'
    group: 'root'
  when: rke2_kubelet_config is defined
  notify: rke2_kubelet_config_changed

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ containerd_registry_config_src }}"
    dest: /etc/rke2/config
    remote_src: yes
    mode: '0644'
    group: 'root'
  when: (containerd_registry_mirrors is defined or containerd_registry_configs is defined)
  notify: containerd_registry_config_changed

- name: Register etcd restore from file
  set_fact:
    etcd_restore_from_file: "{{ etcd_snapshot_file is defined and rke2_service is 'running' }}"

- name: Register etcd restore from S3
  set_fact:
    etcd_restore_from_s3: "{{ (rke2_etcd_s3_bucket is defined and rke2_etcd_s3_prefix is defined) and (rke2_etcd_s3_access_key is defined or rke2_etcd_s3_secret_key is defined) }}"

- name: Restore etcd from file
  shell: |
    mkdir -p /var/lib/rke2/etcd/
    cp "{{ etcd_snapshot_file }}" /var/lib/rke2/etcd/etcd-snapshot.db
    chown -R rke2:rke2 /var/lib/rke2/etcd/
    rke2 etcd restore --config /etc/rke2/config/rke2.yaml
  when: etcd_restore_from_file is true

- name: Restore etcd from S3
  shell: |
    mkdir -p /mnt/s3-restore/
    mount -t s3fs "{{ rke2_etcd_s3_bucket }}":{{ (rke2_etcd_s3_access_key if rke2_etcd_s3_access_key is defined else '') }}:{{ (rke2_etcd_s3_secret_key if rke2_etcd_s3_secret_key is defined else '') }} /mnt/s3-restore
    cp /mnt/s3-restore/{{ rke2_etcd_s3_prefix }}/etcd-snapshot.db /var/lib/rke2/etcd/
    umount /mnt/s3-restore
    rke2 etcd restore --config /etc/rke2/config/rke2.yaml
  when: etcd_restore_from_s3 is true

- name: Start RKE2 service
  service:
    name: rke2
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"

- name: Mask RKE2 agent service
  service:
    name: rke2-agent
    state: stopped
    enabled: no

- name: Wait for first server to be ready (no CNI)
  wait_for_task:
    path: /bin/sh -c 'kubectl get nodes | grep -E "^{{ rke2_server_node_names.0 }} " | grep -q "Ready"'
    timeout: 600

- name: Wait for first server to be ready (with CNI)
  shell: kubectl get nodes | grep -E "^{{ rke2_server_node_names.0 }} " | grep -q "Ready"

- name: Restore etcd
  shell: |
    rke2 etcd cleanup --config /etc/rke2/config/rke2.yaml
    rke2 etcd restore --config /etc/rke2/config/rke2.yaml
  when: etcd_restore_from_file is true or etcd_restore_from_s3 is true

- name: Set Active Server variable
  set_fact:
    active_server: "{{ rke2_server_node_names.0 }}"
  delegate_to: "{{ rke2_server_node_names.0 }}"


