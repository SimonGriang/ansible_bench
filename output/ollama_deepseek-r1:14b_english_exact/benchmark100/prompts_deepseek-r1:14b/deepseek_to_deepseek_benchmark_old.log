---
- name: cadvisor | create directories
  file:
    path: /opt/cadvisor
    state: directory
    owner: root
    group: root

- name: cadvisor | download
  get_url:
    url: https://github.com/google/cadvisor/releases/download/v2.7.0/cAdvisor-linux-amd64.tar.gz
    dest: /opt/cadvisor/cadvisor.tar.gz
    checksum: sha256:abcdef1234567890abcdef1234567890abcdef

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: /opt/cadvisor/cadvisor.tar.gz
    dest: /opt/cadvisor/
    remote_src: yes
  notify: restart_cadvisor

- name: cadvisor | symlink
  ln:
    src: /opt/cadvisor/cadvisor
    dest: /usr/local/bin/cadvisor
    state: symlink

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service

- name: test_task
  shell: systemctl status cadvisor | grep 'active'
  register: service_active

- name: debug: var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemctl:
    name: cadvisor
    state: enabled

- name: cadvisor | start server systemd
  systemctl:
    name: cadvisor
    state: started
    enabled: true


