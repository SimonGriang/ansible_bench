\'ll structure each task under the tasks section, ensuring no extra headers or comments are added. \n\nI think that\'s all. Let\'s put it all together in YAML.\n</think>\n\n```yaml\n---\n- name: Generate a private SSL key using OpenSSL\n  openssl_privatekey:\n    path: /etc/ssl/private/nginx-selfsigned.key\n    cipher: \'RSA 2048\'\n    dest: /etc/ssl/private/nginx-selfsigned.key\n    user: root\n    group: root\n    mode: \'0600\'\n\n- name: Generate a Certificate Signing Request (CSR)\n  openssl_csr:\n    privatekey_path: /etc/ssl/private/nginx-selfsigned.key\n    common_name: localhost\n    dest: /etc/ssl/certs/nginx-selfsigned.csr\n    mode: \'0600\'\n\n- name: Generate a self-signed SSL certificate\n  openssl_certificate:\n    path: /etc/ssl/certs/nginx-selfsigned.crt\n    privatekey_path: /etc/ssl/private/nginx-selfsigned.key\n    csr_path: /etc/ssl/certs/nginx-selfsigned.csr\n    validity: 365\n    dest: /etc/ssl/certs/nginx-selfsigned.crt\n    mode: \'0600\'\n\n- name: Create a PKCS#12 file\n  openssl_pkcs12:\n    privatekey_path: /etc/ssl/private/nginx-selfsigned.key\n    certificate_path: /etc/ssl/certs/nginx-selfsigned.crt\n    dest: /etc/ssl/nginx-selfsigned.pfx\n    password: changeit\n    salt_length: 256\n\n- name: Read the private key content\n  file:\n    path: /etc/ssl/private/nginx-selfsigned.key\n    mode: \'0600\'\n    register: private_key_content\n\n- name: Read the certificate content\n  file:\n    path: /etc/ssl/certs/nginx-selfsigned.crt\n    mode: \'0600\'\n    register: certificate_content\n\n- name: Combine private key and certificate into a single file\n  copy:\n    content: "{{ private_key_content | ansible.builtin.slack }}\\n{{ certificate_content | ansible.builtin.slack }}"\n    dest: /etc/ssl/nginx-selfsigned.pem\n    mode: \'0600\'\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T19:08:01.082142428Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13897500166, 'load_duratio