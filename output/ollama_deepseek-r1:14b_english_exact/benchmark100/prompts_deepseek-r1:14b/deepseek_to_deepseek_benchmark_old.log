---
- name: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install mysql
  ansible.builtin.apt:
    name: "{{ mysql_packages }}"
    state: latest
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ansible.builtin.ini_config:
    file: /etc/mysql/my.cnf
    section: mysqld
    key: "{{ item.key }}"
    value: "{{ item.value }}"
    mode: 0o644
  loop: "{{ mysql_configuration_options }}"
  notify:
    - Restart mysql server

- name: Configure mysql client
  ansible.builtin.ini_config:
    file: /etc/mysql/my.cnf
    section: mysql
    key: socket
    value: /var/run/mysqld/mysqld.sock
    mode: 0o644

- name: Initialize mysql
  command: "{{ mysql_init_script }} initdb"
  args:
    chdir: "{{ mysql_init_dir }}"
  changed_when: false
  when: ansible_distribution in [alpine, arch]

- name: Start and enable mysql
  ansible.builtin.systemd:
    name: mysql.service
    state: started
    enabled: yes
  notify:
    - Systemctl daemon-reexec

- name: Place my.cnf
  ansible.builtin.template:
    src: templates/my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0o644

- name: Create databases
  ansible.builtin.mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Create users
  ansible.builtin.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers again
  ansible.builtin.flush_handlers:


