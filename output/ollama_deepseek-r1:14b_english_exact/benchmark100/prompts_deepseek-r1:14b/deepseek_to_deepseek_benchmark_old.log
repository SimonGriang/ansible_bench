---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  state: started

- name: Install required packages
  apt:
    name: "{{ grub_packages }}"
    state: present
    update_cache: yes

- name: Set GRUB_TIMEOUT
  ini_file:
    file: /etc/default/grub
    section: GRUB
    option: TIMEOUT
    value: "{{ grub_timeout }}"

- name: Set GRUB_RECORDFAIL_TIMEOUT
  ini_file:
    file: /etc/default/grub
    section: GRUB
    option: RECORDFAIL_TIMEOUT
    value: "{{ grub_recordfail_timeout }}"

- name: Add options to GRUB_CMDLINE_LINUX
  ini_file:
    file: /etc/default/grub
    section: GRUB
    option: CMDLINE_LINUX
    value: "{{ grub_options }}"
    append: yes

- name: Import password.yml
  import_tasks:
    file: password.yml
  when: grub_set_password

- name: Flush handlers
  meta:
    flush_handlers: yes


