- name: Generate a Certificate Signing Request (CSR)
  community.crypto.openssl_csr:
    privatekey_path: /etc/ssl/private/nginx-selfsigned.key
    common_name: localhost
    dest: /etc/ssl/certs/nginx-selfsigned.csr
    mode: '0600'

- name: Generate a self-signed SSL certificate
  community.crypto.x509_certificate:
    path: /etc/ssl/certs/nginx-selfsigned.crt
    privatekey_path: /etc/ssl/private/nginx-selfsigned.key
    csr_path: /etc/ssl/certs/nginx-selfsigned.csr
    validity: 365
    dest: /etc/ssl/certs/nginx-selfsigned.crt
    mode: '0600'

- name: Create a PKCS#12 file
  community.crypto.openssl_pkcs12:
    privatekey_path: /etc/ssl/private/nginx-selfsigned.key
    certificate: /etc/ssl/certs/nginx-selfsigned.crt
    dest: /etc/ssl/nginx-selfsigned.pfx
    password: changeit
    salt_length: 256

- name: Read the private key content
  ansible.builtin.file:
    path: /etc/ssl/private/nginx-selfsigned.key
    mode: '0600'
    register: private_key_content

- name: Read the certificate content
  ansible.builtin.file:
    path: /etc/ssl/certs/nginx-selfsigned.crt
    mode: '0600'
    register: certificate_content

- name: Combine private key and certificate into a single file
  ansible.builtin.copy:
    content: |
      {{ private_key_content | ansible.builtin.slack() }}
      {{ certificate_content | ansible.builtin.slack() }}
    dest: /etc/ssl/nginx-selfsigned.pem
    mode: '0600'


