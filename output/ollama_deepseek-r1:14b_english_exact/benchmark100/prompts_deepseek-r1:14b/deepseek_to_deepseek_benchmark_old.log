- name: Install unzip package
  ansible.builtin.apt:
    name: unzip
    state: present

- name: Create system group for promtail
  ansible.builtin.group:
    name: promtail
    state: present

- name: Create system user for promtail
  ansible.builtin.user:
    name: promtail
    group: promtail
    state: present
    create_home: true

- name: Ensure /usr/local/bin directory exists
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    owner: root
    group: root
    mode: 0o755

- name: Create config directories
  ansible.builtin.file:
    path: /etc/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: 0o755

- name: Create configuration directories
  ansible.builtin.file:
    path: /etc/promtail.d
    state: directory
    owner: promtail
    group: promtail
    mode: 0o755

- name: Create application directories
  ansible.builtin.file:
    path: /var/lib/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: 0o755

- name: Create application directories
  ansible.builtin.file:
    path: /var/lib/promtail/bin
    state: directory
    owner: promtail
    group: promtail
    mode: 0o755

- name: Check promtail binary existence
  ansible.builtin.file:
    path: /usr/local/bin/promtail
    state: file

- name: Download promtail binaries
  ansible.builtin.get_url:
    url: "{{ promtail_distribution_url }}"
    dest: "/tmp/promtail.zip"
    checksum: "{{ promtail_distribution_checksum }}"

- name: Propagate local promtail binaries
  ansible.builtin.copy:
    src: "{{ promtail_local_path }}"
    dest: "/tmp/promtail"

- name: Download promtail binaries for controller node
  ansible.builtin.get_url:
    url: "{{ promtail_controller_url }}"
    dest: "/tmp/controller-promtail.zip"
    checksum: "{{ promtail_controller_checksum }}"

- name: Propagate promtail binaries
  ansible.builtin.copy:
    src: "{{ promtail_local_path_controller }}"
    dest: "/tmp/controller-promtail"

- name: Extract promtail binaries
  ansible.builtin.unzip:
    src: "/tmp/promtail.zip"
    dest: /usr/local/bin
    remote_src: yes

- name: Link promtail binaries
  ansible.builtin.ln:
    src: /usr/local/bin/

