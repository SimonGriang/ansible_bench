---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rke2
    state: directory
    owner: root

- name: Set server taints
  kube_taint:
    node_type: server
    taints:
      - key: "node-role.kubernetes.io/master"
        value: "true"
        effect: "NO_SCHEDULE"
    when: node_type == 'server'

- name: Set agent taints
  kube_taint:
    node_type: agent
    taints:
      - key: "node-role.kubernetes.io/worker"
        value: "true"
        effect: "NO_SCHEDULE"
    when: node_type == 'agent'

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_template }}"
    dest: /etc/rke2/config.yaml
    owner: root
    notify: rke2_configured
  when: rke2_config_template is defined

- name: Copy Kubelet configuration file
  copy:
    src: "{{ kubelet_config }}"
    dest: /etc/kubernetes/kubelet.yaml
    owner: root
    notify: kubelet_configured
  when: kubelet_config is defined

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ containerd_registry_config }}"
    dest: /etc/containerd/registry.yaml
    owner: root
    notify: containerd_configured
  when: containerd_registry_config is defined

- name: Start RKE2 service on other nodes
  service:
    name: rke2
    state: started
    enabled: yes
    daemon_reload: yes
    notify: rke2_service_started
  when: 
    - node_name not in "{{ rke2_nodes }}"

- name: Mask other RKE2 services on nodes
  kube_taint:
    node_type: "{{ node_type }}"
    taints:
      - key: "node-role.kubernetes.io/{{ other_type }}"
        value: "true"
        effect: "NO_SCHEDULE"
  when: 
    - node_type == 'server' and other_type == 'agent'
    - node_type == 'agent' and other_type == 'server'

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    host: "{{ item.address }}"
    port: 6443
    state: started
    interval: 10
    until: "{{ item.ready }}"
  loop: "{{ rke2_nodes | difference([ansible_hostname]) }}"

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    host: "{{ item.address }}"
    port: 10250
    state: started
    interval: 10
    until: "{{ item.ready }}"
  when: cni_configured
  loop: "{{ rke2_nodes | difference([ansible_hostname]) }}"

