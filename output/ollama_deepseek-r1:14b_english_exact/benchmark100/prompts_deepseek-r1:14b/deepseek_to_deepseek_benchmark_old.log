  become_user: root
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
  when: true

- name: Configure pip trusted hosts
  become: yes
  become_user: root
  template:
    src: pip.conf.j2
    dest: /etc/pip.conf
  when: true

- name: Update pip
  become: yes
  become_user: root
  pip:
    command: upgrade
    version: latest
  when: ansible_distribution in ['bookworm', 'noble'] or ansible_os_family == 'Alpine'
  skip_on_failure: yes

