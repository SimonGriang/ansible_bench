---
- name: Task 1: Import assert.yml
  ansible.builtin.import_tasks:
    file: assert.yml

- name: Task 2: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/mailname
    value: "{{ ansible_hostname }}"
    priority: low

- name: Task 3: Install postfix
  apt:
    name: postfix
    state: present

- name: Task 4: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present

- name: Task 5: Configure postfix (transport_maps)
  template:
    src: transport_maps.cf.j2
    dest: /etc/postfix/transport_maps
    notify: rebuild_transport_map

- name: Task 6: Configure postfix (header_checks)
  template:
    src: header_checks.cf.j2
    dest: /etc/postfix/header_checks
    notify: reload_postfix

- name: Task 7: Setting values for main.cf (1/2)
  set_fact:
    postfixrecipient_access: "{{ lookup('file', 'postfix/recipient_access') }}"

- name: Task 8: Setting values for main.cf (2/2)
  set_fact:
    postfixmynetworks: "{{ lookup('file', 'postfix/mynetworks') }}"

- name: Task 9: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    notify: restart_postfix

- name: Task 10: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    notify: restart_postfix

- name: Task 11: Creates cert/key directory
  file:
    path: /etc/postfix/tls
    state: directory

- name: Task 12: Deploy Postfix TLS server certificate
  copy:
    src: postfix/certificate.pem
    dest: /etc/postfix/tls/certificate.pem
    mode: 644
  notify: reload_postfix

- name: Task 13: Deploy Postfix TLS server key
  copy:
    src: postfix/key.pem
    dest: /etc/postfix/tls/key.pem
    mode: 644
  notify: reload_postfix

- name: Task 14: Flush handlers
  ansible.builtin.flush_handlers:

- name: Task 15: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: "{{ item }}"
    insertafter: "^# PostfixAliases"
    with_items: "{{ lookup('file', 'postfix/aliases') }}"

- name: Task 16: Configure sender_access
  file:
    path: /etc/postfix/sender_access
    state: file
    content: "{{ lookup('file', 'postfix/sender_access') }}"
  notify: rebuild_sender_access

- name: Task 17: Configure recipient_access
  file:
    path: /etc/postfix/recipient_access
    state: file
    content: "{{ lookup('file', 'postfix/recipient_access') }}"
  notify: rebuild_recipient_access

- name: Task 18: Place sasl_password_map
  copy:
    src: postfix/sasl_password_map
    dest: /etc/postfix/sasl_password_map
    mode: 600
  notify: rebuild_sasl_map

- name: Task 19: Flush handlers again
  ansible.builtin.flush_handlers:

- name: Task 20: Start and enable postfix
  systemd:
    name: postfix
    state: started
    enabled: yes


