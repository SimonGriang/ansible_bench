---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
  run_once: true
  host: localhost
  remote_user: root

- name: Install nginx
  apt:
    name: nginx
    state: present

- name: Place nginx.conf
  template:
    src: files/nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: 0644
  validate_mode: true

- name: Ensure /etc/nginx/conf.d exists
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: 0755

