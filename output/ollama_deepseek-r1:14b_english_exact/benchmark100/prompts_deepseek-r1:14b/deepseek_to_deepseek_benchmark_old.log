---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  block:
    - name: assert.yml imported
      assert:
        that: "'test' in 'test'"
        success_msg: "Imported assert.yml successfully"

- name: Configure apk
  apk:
    update_cache: yes
    upgrade: all
    state: present
  changed_when: false

- name: Configure apt
  apt:
    state: present
    upgrade: yes
    name:
      - package1
      - package2
    noninteractive: yes
  changed_when: false

- name: Update all software (dnf)
  dnf:
    name: "*"
    state: latest
    exclude:
      - packageA
      - packageB
  changed_when: false

- name: Update all software (pacman)
  pacman:
    state: latest
    upgrade: all
  changed_when: false

- name: Configure yum
  yum:
    name: yum-utils
    state: present
  when:ansible_distribution in ['CentOS', 'RedHat'] and ansible_distribution_major_version == '6'

- name: Update all software (zypper)
  zypper:
    name: "*"
    state: latest
  changed_when: false


