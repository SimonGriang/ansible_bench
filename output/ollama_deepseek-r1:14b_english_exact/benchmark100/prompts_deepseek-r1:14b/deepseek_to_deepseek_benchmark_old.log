ly written using the \'when\' clause in Ansible.\n</think>\n\n```yaml\n---\n- name: Check Python3 version on Debian12\n  command: python3 --version\n  register: py3ver\n  changed_when: false\n  tags:\n    - molecule-notest\n\n- name: Remove EXTERNALLY-MANAGED file on Debian12\n  file:\n    path: /usr/lib/python3.11/EXTERNALLY-MANAGED\n    state: absent\n  when:\n    - py3ver is defined\n    - py3ver.stdout.find("3.11") != -1\n  tags:\n    - molecule-notest\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T18:55:15.494162272Z', 'done': True, 'done_reason': 'stop', 'total_duration': 9973074709, 'load_duration': 85928078, 'prompt_eval_count': 385, 'prompt_eval_duration': 91866860, 'eval_count': 576, 'eval_duration': 9793997662, 'model_name': 'deepseek-r1:14b'} id='run--7e570d95-aae9-4636-bea1-453ab47e6f16-0' usage_metadata={'input_tokens': 385, 'output_tokens': 576, 'total_tokens': 961}
