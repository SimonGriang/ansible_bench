- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install apache httpd
  become: true
  apt:
    name: "{{ httpd_packages }}"
    state: present
  become_flags: sudo
  when: ansible_os_family == 'Debian'

- name: Configure selinux
  become: true
  selinux:
    boolean: httpd_selinux_booleans
    state: "{{ selinux_enabled | default('disabled') }}"
  when: ansible_selinux_enabled

- name: Configure httpd
  template:
    src: httpd.j2
    dest: "{{ httpd_config_file }}"
    mode: 0644
  notify:
    - httpd_config_test
    - httpd_restart

- name: Activate httpd module | Debian
  become: true
  apt:
    name: "{{ item }}"
    state: present
  with_items: "{{ httpd_modules }}"
  when: ansible_os_family == 'Debian'

- name: Import ssl.yml
  import_tasks: ssl.yml

- name: Import locations.yml
  import_tasks: locations.yml

- name: Import vhosts.yml
  import_tasks: vhosts.yml

- name: Configure ports
  become: true
  apt:
    name: "{{ httpd_ports }}"
    state: present
  when: ansible_os_family in ['Debian', 'Suse']
  notify:
    - httpd_config_test
    - httpd_restart

- name: Import directories.yml
  import_tasks: directories.yml

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ apache_default_html }}"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  become: true
  service:
    name: apache2
    state: started
    enabled: yes
  become_flags: sudo


