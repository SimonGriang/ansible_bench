---
- name: Import assertion tasks
  import_tasks:
    file: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Install php
  apt:
    state: present
    packages: "{{ php_packages }}"

- name: Find used php.ini
  shell: php --ini
  register: php_found_ini_location
  when:
    - ansible.vars.php_ini_location is undefined

- name: Configure php
  template:
    src: php.ini.j2
    dest: /etc/php/7.4/apache2/php.ini
    mode: 0644
    vars:
      php_config: "{{ php_config }}"
  notify: Restart httpd


