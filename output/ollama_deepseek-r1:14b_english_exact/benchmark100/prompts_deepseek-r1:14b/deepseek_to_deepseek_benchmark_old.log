---
- name: Check if Java certificates exist
  stat:
    path: "{{ item }}"
    check_mode: false
  loop: "{{ java_certs }}"
  register: java_certs_status
  changed_when: false

- name: Fail if Java certificates are missing
  fail:
    msg: "Java certificate {{ item.path }} is missing."
  when: item.stat.status == 'missing'
  loop: "{{ java_certs_status.results }}"
  changed_when: false

- name: Set keystore directory for Java versions less than 11
  set_fact:
    java_keystore_dir: "{{ java_home }}/jre/lib/security/certs"
  when: ansible.java.version|float < 11.0

- name: Set keystore directory for Java versions 11 or newer
  set_fact:
    java_keystore_dir: "{{ java_home }}/lib/security"
  when: ansible.java.version|float >= 11.0

- name: Import SSL certificates into Java keystore
  command: "{{ item.alias }}:importcert -file {{ item.path }} -alias {{ item.alias }} -keystore {{ java_keystore_dir }}/{{ java_keystore_name }} {{ keystore_password }}"
  args:
    chdir: "{{ java_home }}/bin"
  loop: "{{ java_certs }}"
  ignore_errors: yes
  changed_when: false

