  git:
    repo: "{{ repo.url }}"
    dest: "{{ repo.destination }}"
    branch: "{{ repo.branch }}"
    version: "{{ repo.version }}"
    update: yes
    chdir: /repos
  with_items: "{{ repositories }}"
  become: yes
  become_user: "{{ user }}"


