---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: temurin
  when: ansible_distribution == 'Debian' or ansible_distribution == 'Ubuntu'

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/{{ ansible_distribution }}.yml"
    ignore_errors: yes

- name: Gather architecture specific variables
  include_vars:
    file: "{{ ansible_architecture }}.yml"
    ignore_errors: yes

- name: Set OS specific variables (I)
  include_vars:
    file: "{{ ansible_distribution }}.yml"
    ignore_errors: yes

- name: Set OS and architecture specific variables (II)
  include_vars:
    file: "{{ ansible_distribution }}/{{ ansible_architecture }}.yml"
    ignore_errors: yes

- name: Set specific variables
  set_fact:
    java_home: "/usr/lib/jvm/{{ java_version }}"

- name: Debian pre-requisites
  apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ java_debian_prerequisites }}"
  when: ansible_distribution == 'Debian' or ansible_distribution == 'Ubuntu'

- name: RedHat pre-requisites
  yum:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ java_redhat_prerequisites }}"
  when: ansible_distribution == 'RedHat' or ansible_distribution == 'Fedora'

- name: Install required libs
  apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
  loop: "{{ required_libs }}"
  when: ansible_distribution == 'Debian' or ansible_distribution == 'Ubuntu'

- name: Install Java, Debian
  apt:
    name: "{{ java_package_name }}"
    version: "{{ java_version }}"
    state: present
  when: ansible_distribution == 'Debian' or ansible_distribution == 'Ubuntu'

- name: Install Java, RedHat
  yum:
    name: "{{ java_package_name }}"
    version: "{{ java_version }}"
    state: present
  when: ansible_distribution == 'RedHat' or ansible_distribution == 'Fedora'

- name: Export environment variables
  template:
    src: java_env.conf.j2
    dest: /etc/profile.d/java_env.sh
    mode: 0755

- name: Source environment variables
  shell: source /etc/profile.d/java_env.sh

- name: Correct java version selected for Java < 11
  command: alternatives --install /usr/bin/java {{ java_version }}
  when: java_version < '11'

- name: Correct java version selected for Java >= 11
  command: alternatives --install /usr/bin/java {{ java_version }}
  when: java_version >= '11'


