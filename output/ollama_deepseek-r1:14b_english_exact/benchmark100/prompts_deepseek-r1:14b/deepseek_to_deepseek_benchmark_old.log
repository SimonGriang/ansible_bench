---
- name: Check if Python is installed
  command: which python
  changed_when: false

- name: Check if Python3 is installed
  command: which python3
  changed_when: false

- name: Debug Python executable path
  debug:
    msg: "Python executable path: {{ 
          (python_command.stdout | 
           default('/usr/bin/python')) 
          }}"

- name: Debug Python3 executable path
  debug:
    msg: "Python3 executable path: {{ 
          (python3_command.stdout | 
           default('/usr/bin/python3')) 
          }}"

- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true

- name: Install requirements
  apt:
    name: "{{ item }}"
    state: installed
  with_items: "{{ openssl_requirements }}"

- name: Ensure packaging is available via dnf
  dnf:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    requirements: "{{ item }}"
    state: present
  with_items:
    - "{{ openssl_pip_packages }}"

- name: Create key directory
  file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: "{{ openssl_key_dir_mode }}"
    owner: "{{ openssl_key_dir_owner }}"

- name: Create csr directory
  file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: "{{ openssl_csr_dir_mode }}"
    owner: "{{ openssl_csr_dir_owner }}"

- name: Create crt directory
  file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: "{{ openssl_crt_dir_mode }}"
    owner: "{{ openssl_crt_dir_owner }}"

- name: Include create.yml
  include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item


