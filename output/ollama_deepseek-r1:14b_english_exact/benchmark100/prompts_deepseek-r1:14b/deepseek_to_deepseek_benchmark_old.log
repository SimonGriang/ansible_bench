e: Debug Python executable path\n  debug:\n    msg: "Python executable path: {{ (python_command.stdout | default(\'/usr/bin/python\')) }}"\n\n- name: Debug Python3 executable path\n  debug:\n    msg: "Python3 executable path: {{ (python3_command.stdout | default(\'/usr/bin/python3\')) }}"\n\n- name: Import assert.yml\n  import_tasks: assert.yml\n  run_once: true\n  host: localhost\n\n- name: Install requirements\n  apt:\n    name: "{{ item }}"\n    state: installed\n  with_items: "{{ openssl_requirements }}"\n\n- name: Ensure packaging is available via dnf\n  dnf:\n    name: python3-packaging\n    state: present\n\n- name: Install pip packages\n  pip:\n    requirements: "{{ item }}"\n    state: present\n  with_items: "{{ openssl_pip_packages }}"\n\n- name: Create key directory\n  file:\n    path: "{{ openssl_key_directory }}"\n    state: directory\n    mode: "{{ openssl_key_dir_mode }}"\n    owner: "{{ openssl_key_dir_owner }}"\n\n- name: Create csr directory\n  file:\n    path: "{{ openssl_csr_directory }}"\n    state: directory\n    mode: "{{ openssl_csr_dir_mode }}"\n    owner: "{{ openssl_csr_dir_owner }}"\n\n- name: Create crt directory\n  file:\n    path: "{{ openssl_crt_directory }}"\n    state: directory\n    mode: "{{ openssl_crt_dir_mode }}"\n    owner: "{{ openssl_crt_dir_owner }}"\n\n- name: Include create.yml\n  include_tasks: create.yml\n  loop: "{{ openssl_items }}"\n  loop_control:\n    loop_var: item\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T19:44:20.812194756Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14318039283, 'load_duration': 83688025, 'prompt_eval_count': 568, 'prompt_eval_duration': 314275339, 'eval_count': 786, 'eval_duration': 13918902485, 'model_name': 'deepseek-r1:14b'} id='run--43121c81-8e9a-41d3-949c-495cdc96a197-0' usage_metadata={'input_tokens': 568, 'output_tokens': 786, 'total_tokens': 1354}
