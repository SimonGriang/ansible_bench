    state: directory

- name: Task 12: Deploy Postfix TLS server certificate
  copy:
    src: postfix/certificate.pem
    dest: /etc/postfix/tls/certificate.pem
    mode: 644
  notify: reload_postfix

- name: Task 13: Deploy Postfix TLS server key
  copy:
    src: postfix/key.pem
    dest: /etc/postfix/tls/key.pem
    mode: 644
  notify: reload_postfix

- name: Task 14: Flush handlers
  ansible.builtin.flush_handlers:

- name: Task 15: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: "{{ item }}"
    insertafter: "^# PostfixAliases"
  with_items: "{{ lookup('file', 'postfix/aliases') }}"

- name: Task 16: Configure sender_access
  file:
    path: /etc/postfix/sender_access
    state: file
    content: "{{ lookup('file', 'postfix/sender_access') }}"
  notify: rebuild_sender_access

- name: Task 17: Configure recipient_access
  file:
    path: /etc/postfix/recipient_access
    state: file
    content: "{{ lookup('file', 'postfix/recipient_access') }}"
  notify: rebuild_recipient_access

- name: Task 18: Place sasl_password_map
  copy:
    src: postfix/sasl_password_map
    dest: /etc/postfix/sasl_password_map
    mode: 600
  notify: rebuild_sasl_map

- name: Task 19: Flush handlers again
  ansible.builtin.flush_handlers:

- name: Task 20: Start and enable postfix
  systemd:
    name: postfix
    state: started
    enabled: yes


