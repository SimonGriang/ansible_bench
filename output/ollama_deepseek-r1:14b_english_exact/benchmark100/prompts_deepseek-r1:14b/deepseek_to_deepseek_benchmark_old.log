---
- name: Check current docker-compose version
  shell: docker-compose --version
  register: docker_compose_version

- name: Set fact for docker-compose current version
  set_fact:
    docker_compose_version_number: "{{ docker_compose_version.stdout | regex_replace('^[^v]*v', '') | regex_replace(' .*', '') }}"
  when:
    - docker_compose_version is not skipped

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when:
    - docker_compose_version_number is not defined
    - docker_compose_version_number != "{{ docker_compose_version }}"

- name: Install Docker Compose (if configured)
  get_url:
    url: "https://github.com/docker/compose/releases/download/v{{ docker_compose_version }}/docker-compose-{{ ansible_system }}-amd64"
    dest: /usr/local/bin/docker-compose
    mode: 0755
  when:
    - docker_compose_version_number is not defined
    - docker_compose_version_number != "{{ docker_compose_version }}"
