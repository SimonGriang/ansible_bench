- name: Validate all variables are set correctly
  include_tasks: assert.yml
  vars:
    host: localhost

- name: Wait for host to be available
  wait_for:
    state: started
    port: 22
    timeout: 30

- name: Prepare system for bootstrap
  raw: whoami
  register: connection_test
  ignore_errors: yes

  setup:
    gather_subset: minimal

  apt:
    name: "{{ packages }}"
    state: present
    update_cache: yes

- name: Ensure system preparation with Ansible modules
  setup:
    gather_subset: minimal

  apt:
    name: "{{ packages }}"
    state: present
    update_cache: yes


