---
- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_check

- name: Check Helm version
  command: helm version
  register: helm_existing_version

- name: Download helm
  unarchive:
    remote_src: yes
    url: https://get.helm.sh/helm-{{ helm_version }}-linux-amd64.tar.gz
    dest: /tmp
  register: helm_download
  when:
    - helm_check.stat is not defined or
    - helm_existing_version.stdout is not defined or
    - helm_existing_version.stdout | version_compare('version') != 0

- name: Copy helm binary into place
  copy:
    remote_src: yes
    src: "{{ helm_download.src }}/linux-amd64/helm"
    dest: /usr/local/bin/helm
    mode: 0755
  become: yes
  when: helm_download is not skipped


