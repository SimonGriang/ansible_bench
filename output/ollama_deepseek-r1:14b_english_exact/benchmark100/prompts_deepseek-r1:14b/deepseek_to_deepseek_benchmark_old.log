    mode: 0640
  when: airgap_mode is defined and airgap_mode == true and use_exists is defined and use_exists == false

- name: Airgap mode - additional images tarballs
  block:
    - name: Create directory for additional images
      file:
        path: "{{ additional_images_path }}"
        state: directory
        mode: 0700

