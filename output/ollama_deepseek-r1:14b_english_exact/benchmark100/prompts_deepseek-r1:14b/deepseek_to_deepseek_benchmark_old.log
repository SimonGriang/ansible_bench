---
- name: Install Keepalived service when HA mode is enabled
  apt:
    name: keepalived
    state: present
  when: ha_mode is true

- name: Download and install RKE2 with specified version
  apt:
    name: rke2
    version: '{{ rke2_version }}'
    state: present

- name: Perform CIS hardening when CIS profile is defined
  include_tasks: cis-hardening.yml
  when: cis_profile is defined

- name: Find and identify the active server in the cluster
  shell: |
    for node in {{ groups['all'] }};
    do
      ssh $node 'sudo ping -c 1 8.8.8.8' && echo $node && break;
    done
  when: active_server is defined

- name: Enable IPVS kernel module for load balancing
  module_name: ipvsadm
  args:
    state: present
  register: ipvs_result
  when: ha_mode is true

- name: Copy kube-vip manifests to master node
  copy:
    remote_src: true
    src: /path/to/kubevip-manifests
    dest: /etc/kube-vip/
  when: ha_mode is true and kubevip_manifest is defined

- name: Copy ingress-nginx manifests to master node
  copy:
    remote_src: true
    src: /path/to/ingress-nginx-manifests
    dest: /etc/ingress-nginx/
  when: ingress_nginx_values is defined

- name: Prepare the first server node in the cluster
  shell: "ansible-playbook prepare-first-server.yml --extra-vars '{{ first_server_vars }}'"
  when: first_server_condition is met

- name: Perform etcd restore tasks when conditions are met
  include_tasks: etcd-restore.yml
  when: etcd_restore | bool

- name: Download the kubeconfig file to Ansible localhost
  fetch:
    src: /path/to/kubeconfig
    dest: /tmp/
    flat: yes
  when: download_kubeconfig is true

- name: Prepare and join remaining cluster nodes
  shell: |
    ansible-playbook join-cluster.yml
      --extra-vars '{{ remaining_nodes_vars }}'
  when: active_server is defined

- name: Perform rolling restart of server nodes
  shell: |
    sleep {{ item }} && systemctl restart rke2-server
  with_items: "{{ range(0, 5) | list }}"
  when: server_version_changed

- name: Perform rolling restart of agent nodes
  shell: |
    sleep {{ item }} && systemctl restart rke2-agent
  with_items: "{{ range(0, 5) | list }}"
  when: agent_version_changed

- name: Flush handlers
  meta: flush_handlers

- name: Perform rolling restart when configuration files change
  shell: |
    ansible-playbook rolling-restart.yml
      --extra-vars '{{ config_change_vars }}'
  when: config_files_changed | bool

- name: Perform final steps including a summary
  shell: |
    ansible-playbook final-steps.yml
      --extra-vars '{{ final_steps_vars }}'

