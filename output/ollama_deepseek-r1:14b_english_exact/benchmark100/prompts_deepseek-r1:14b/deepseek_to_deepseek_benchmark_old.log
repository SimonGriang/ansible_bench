---
- name: Import assert.yml
  import_tasks: assert.yml
  remote_host: localhost
  state: present

- name: Install apache httpd
  apt:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  selinux:
    state: enabled
  vars:
    sebooleans:
      "{{ item.key }}": "{{ item.value }}"
    ports:
      httpd_port: allow
      httpd_ssl_port: allow
  loop: "{{ httpd_sebooleans | dictresult }}"

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify: 
    - httpd_config_test
    - httpd_restart

- name: Activate Apache HTTPD modules
  command: a2enmod
  args:
    argv: "{{ item }}"
  loop: "{{ httpd_modules_to_activate_with_command | dictresult }}"
  state: present

- name: Import SSL configuration
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Import locations configuration
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import virtual hosts configuration
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure Apache HTTPD ports
  template:
    src: "{{ httpd_ports_config_src }}"
    dest: "{{ httpd_ports_config_dest }}"
  notify:
    - httpd_config_test
    - httpd_restart
  when: (ansible_distribution == "Debian" or ansible_distribution == "Suse")

- name: Import directories configuration
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Remove default HTML
  file:
    path: "{{ httpd_data_directory }}/example.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable Apache HTTPD
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes

