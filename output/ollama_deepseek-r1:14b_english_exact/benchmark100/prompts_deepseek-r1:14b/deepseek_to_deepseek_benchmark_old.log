---
- name: Install EPEL GPG key
  shell: echo -e "{{ epel_gpg_key }}" | sudo tee /etc/yum.repos.d/epel.gpg.key
  vars:
    become: yes

- name: Install EPEL release package
  yum:
    name: "{{ epel_url | basename }}"
    state: present
  vars:
    become: yes
  notify: update_package_cache

- name: Install EPEL next release package (conditional)
  yum:
    name: "{{ epel_next_url | basename }}"
    state: present
  vars:
    become: yes
  when: epel_next
  notify: update_package_cache

handlers:
  - name: update_package_cache
    yum: name=* state=latest
    vars:
      become: yes


