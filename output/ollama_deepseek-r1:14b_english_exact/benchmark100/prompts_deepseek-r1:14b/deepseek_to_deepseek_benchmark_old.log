---
- name: Generate an OpenSSL private key
  openssl_privatekey:
    path: /etc/ssl/private/server.key
    cipher: 'aes256'
    mode: 0600
    user: root
    group: root

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  openssl_csr:
    path: /etc/ssl/csr/server.csr
    privatekey_path: /etc/ssl/private/server.key
    common_name: example.com
    subject:
      CN: example.com
      OU: IT
      O: Example Inc.
      L: City
      ST: State
      C: US
    mode: 0600
    user: root
    group: root

- name: Generate an OpenSSL X.509 certificate
  openssl_certificate:
    path: /etc/ssl/certs/server.crt
    privatekey_path: /etc/ssl/private/server.key
    csr_path: /etc/ssl/csr/server.csr
    serial: 1000
    validity: 365
    mode: 0600
    user: root
    group: root
    self_signed: yes

- name: Generate a PKCS#12 file
  openssl_pkcs12:
    path: /etc/ssl/private/server.p12
    privatekey_path: /etc/ssl/private/server.key
    certificate_path: /etc/ssl/certs/server.crt
    passphrase: ChangeMe123!
    encryption_algorithm: aes256
    friendly_name: "Server Certificate"
    mode: 0600
    user: root
    group: root

- name: Read private key content
  file:
    path: /etc/ssl/private/server.key
    state: file
    read_lines: true
  register: var_key

- name: Read certificate content
  file:
    path: /etc/ssl/certs/server.crt
    state: file
    read_lines: true
  register: var_cert

- name: Create a combined private key and certificate file
  template:
    src: combined.key.crt.j2
    dest: /etc/ssl/certs/combined.key.crt
    mode: 0600
    user: root
    group: root
  vars:
    key_content: "{{ var_key.content | join('\n') }}"
    cert_content: "{{ var_cert.content | join('\n') }}"


