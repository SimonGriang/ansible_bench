---
- name: Import assert.yml
  import_tasks:
    file: files/assert.yml
  host: localhost
  connection: local

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta:
    flush_handlers: yes

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
    options: "{{ selinux_options | default('')}}">
  notify: Reboot
  when: selinux_requirements is defined

- name: Configure selinux booleans
  seboolean:
    name: "{{ item }}"
    value: "{{ selinux_booleans[item]}}"
    state: "{{ selinux_booleans_state | default('permanent')}}"
    persistent: yes
  loop: "{{ selinux_booleans.keys() | list if selinux_booleans is defined }}"
  when: selinux_booleans is defined


