---
- name: Import assertion tasks
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Docker Compose package
  become: yes
  package:
    name: "{{ docker_compose_package_name | default('docker-compose') }}"
    state: present
  when: installation_type == "package"

- name: Install Docker Compose binary
  become: yes
  apt:
    name: "{{ item }}"
    state: present
  with_items:
    - docker.io
    - python3
    - python3-pip
  when: installation_type == "binary"

- name: Download and install Docker Compose binary
  become: yes
  file:
    path: "{{ docker_compose_binary_path }}"
    url: "{{ docker_compose_binary_url }}"
    mode: 0755
  when: installation_type == "binary"


