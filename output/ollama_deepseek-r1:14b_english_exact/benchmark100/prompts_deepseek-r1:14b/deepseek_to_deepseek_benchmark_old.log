package_name }}"\n    state: present\n  when:\n    - java_source == "local"\n    - java_format == "rpm"\n\n- name: Install Oracle Java DEB from local\n  become: yes\n  become_user: root\n  copy:\n    src: oracle-jdk-*.deb\n    dest: /tmp/\n  dpkg:\n    name: "{{ deb_package_name }}"\n    state: present\n  when:\n    - java_source == "local"\n    - java_format == "deb"\n\n- name: Install Oracle Java RPM from repository\n  become: yes\n  become_user: root\n  apt:\n    name: "{{ repo_rpm_package }}"\n    state: present\n  when:\n    - java_source == "repository"\n    - java_format == "rpm"\n\n- name: Configure Oracle Java targz installation\n  unzip:\n    remote_src: yes\n    dest: /tmp/oracle-jdk\n  shell: /tmp/oracle-jdk/jdk-*.bin -s silent -jreMode none\n  when:\n    - java_format == "targz"\n    - java_vendor == "oracle"\n\n- name: Install Oracle Java JCE policy\n  become: yes\n  become_user: root\n  copy:\n    src: jce-*.tar.gz\n    dest: /tmp/\n  shell: |\n    tar -xzf jce-*.tar.gz\n    chmod 755 /tmp/jce\n    cp -rf /tmp/jce/* /usr/lib/jvm/java-8-oracle/jre/lib/security\n  when:\n    - java_jce\n    - java_version == 8\n    - java_vendor == "oracle"\n\n- name: Set Java alternative\n  shell: alternatives --install /usr/bin/java java /usr/lib/jvm/java-8-oracle/bin/java 0\n  when:\n    - java_format == "targz"\n    - ansible_distribution != "Alpine"\n\n- name: Find Java home directory\n  shell: readlink -e /usr/bin/java\n  register: java_home\n\n- name: Set JAVA_HOME in environment\n  template:\n    src: java_home.sh.j2\n    dest: /etc/profile.d/java_home.sh\n    mode: 0755\n  vars:\n    java_home_path: "{{ java_home.stdout }}"\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-09T21:40:01.198769864Z', 'done': True, 'done_reason': 'stop', 'total_duration': 27294084117, 'load_duration': 95709134, 'prompt_eval_count': 1387, 'prompt_eval_duration': 11316745, 'eval_count': 1482, 'eval_duration': 27185490661, 'model_name': '