---
- import_tasks: assert.yml

- name: Install mysql
  apt:
    name: "{{ packages }}"
    state: present
    update_cache: yes
  or
  name: Install mysql
  yum:
    name: "{{ packages }}"
    state: present
  notify: 
    - Set mysql root password
    - Restart systemctl daemon

- name: Configure mysql server
  template:
    src: server.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644
  notify: 
    - Restart mysql server

- name: Configure mysql client
  template:
    src: client.cnf.j2
    dest: /etc/mysql/client.cnf
    mode: 0644

- name: Initialize mysql
  command: mysqldump --no-password --initialize
  becomes: yes
  when: 
    - ansible_distribution in ['alpine', 'archlinux']

- name: Start and enable mysql
  service:
    name: "{{ service_name }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ databases }}"
  when: 
    - initial_import is not defined

- name: List databases
  command: mysql -u root -p -e "SHOW DATABASES;"
  register: existing_databases
  ignore_errors: yes

- name: Import database
  mysql_db:
    name: "{{ item }}"
    state: present
    sql: "{{ lookup('file', 'initial_import/{{ item }}.sql') | join('\n') }}"
  loop: "{{ databases }}"
  when: 
    - initial_import is defined
    - item not in existing_databases.databases

- name: Create users
  mysql_user:
    name: "{{ user }}"
    password: "{{ password }}"
    priv: "{{ priv }}"
    state: present
  loop: "{{ users }}"
  notify: 
    - Restart mysql server

- name: Flush handlers again
  meta: flush_handlers


