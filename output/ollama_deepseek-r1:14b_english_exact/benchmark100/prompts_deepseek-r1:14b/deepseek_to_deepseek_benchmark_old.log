---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "/etc/rke2/install.sh"
    force: yes
    mode: 0700
    dest_mode: 0700
  when: not airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ local_install_script }}"
    dest: "/etc/rke2/install.sh"
    remote_src: yes
    mode: 0700
  when: airgap_mode

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: 0700
  when:
    - airgap_mode
    - use_exists

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_artifacts_path }}/checksum.txt"
        force: yes
        mode: 0640
        dest_mode: 0640

    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}/rke2.tgz"
        force: yes
        mode: 0640
        dest_mode: 0640

  rescue:
    - name: Fallback to local download
      copy:
        src: "{{ local_artifacts_path }}/"
        dest: "{{ rke2_artifacts_path }}"
        remote_src: yes
        mode: 0640
      when: airgap_mode

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ local_artifacts_path }}/"
    dest: "{{ rke2_artifacts_path }}"
    remote_src: yes
    mode: 0640
  when:
    - airgap_mode
    - use_exists

- name: Airgap mode - additional images tarballs
  block:
    - name: Create directory for additional images
      file:
        path: "{{ additional_images_path }}"
        state: directory
        mode: 0700

    - name: Copy additional images tarballs
      copy:
        src: "{{ additional_images_src }}/"
        dest: "{{ additional_images_path }}"
        remote_src: yes
        mode: 0640
        with_items: "{{ additional_images }}"

  when:
    - additional_images
    - additional_images_src

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Set artifacts directory permissions
      file:
        path: "{{ rke2_artifacts_path }}"
        state: directory
        mode: 0700

    - name: Set install script permissions
      stat:
        path: "/etc/rke2/install.sh"
        check_mode: yes
      register: install_script_stat
      when: airgap_mode

  when: airgap_mode

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ rke2_bin_path }}"

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }}/rke2 version | grep -oP '(?<=v).+'"
  register: current_version
  when: rke2_bin_path

- name: Prevent accidental RKE2 downgrade
  shell: "echo '{{ install_version | regex_replace('^v','') }}' | sort -V | uniq -c | wc -l"
  register: version_count
  when: install_version

- name: Run RKE2 install script
  shell: "{{ rke2_bin_path }}/rke2 install --name '{{ cluster_name }}' --external-dns-name '{{ external_dns_name }}' --cloud-provider '{{ cloud_provider }}' --kube-version '{{ kube_version }}' --flannel-type '{{ flannel_type }}' --network-plugin '{{ network_plugin }}' --apiserver-external-ip '{{ apiserver_external_ip }}' --apiserver-ports '{{ apiserver_ports }}' --control-plane-endpoint '{{ control_plane_endpoint }}' --ssh-user '{{ ssh_user }}' --ssh-key-file '{{ ssh_key_file }}'{{ ' --token-file ' + token_file if token_file else '' }}"
  when: rke2_bin_path

- name: Copy Custom Manifests
  copy:
    src: "{{ custom_manifests_src }}"
    dest: "{{ rke2_manifests_path }}"
    remote_src: yes
    mode: 0640
    template: yes
  when: custom_manifests_src

- name: Copy Static Pods
  copy:
    src: "{{ static_pods_src }}"
    dest: "{{ rke2_agent_manifests_path }}"
    remote_src: yes
    mode: 0640
  when: static_pods_src

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_src }}"
    dest: "{{ rke2_env_dest }}"
    remote_src: yes
    mode: "{{ rke2_env_mode }}"
    rename: "{{ rke2_env_name }}"
  when: rke2_env_src


