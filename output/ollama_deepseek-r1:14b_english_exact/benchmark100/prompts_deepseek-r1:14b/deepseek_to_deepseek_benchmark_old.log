---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  run_once: true

- name: Install dns
  apt:
    name: "{{ dns_packages }}"
    state: present
    update_cache: yes

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: "{{ dns_data_dir }}", mode: '0755', owner: '{{ dns_owner }}', group: '{{ dns_group }}' }
    - { path: "{{ dns_config_dir }}", mode: '0755', owner: '{{ dns_owner }}', group: '{{ dns_group }}' }

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    system: true
    home: "/var/lib/{{ dns_owner }}"
    shell: "/usr/sbin/nologin"

- name: Generate rndc key
  rndc_keygen:
    keyfile: "{{ dns_config_dir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_config_dir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0640'

- name: Get the hints/root file
  get_url:
    url: "http://{{ root_hints_url }}"
    dest: "{{ dns_config_dir }}/root.hints"
    mode: '0644'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns

- name: Create zone file
  template:
    src: "{{ item.template }}"
    dest: "{{ item.dest }}"
    mode: '0640'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    validate_on_create: yes
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  template:
    src: "{{ dns_config_template }}"
    dest: "{{ dns_config_dir }}/named.conf"
    mode: '0640'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  notify: Restart dns

- name: Place systemd override
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    mode: '0644'
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop: "{{ systemd_overrides }}"
  when: "{{ systemd_overrides.when }}"

- name: Start and enable dns
  service:
    name: "{{ dns_service_name }}"
    state: started
    enabled: yes
  notify: Restart dns


