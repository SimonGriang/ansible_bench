---
- name: Create the RKE2 configuration directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  set_fact:
    server_taints: "{{ lookup('env', 'NODE_TYPE') | default('server') == 'server' | ternary({'key/value pairs': 'value'}, []) }}"
  when: "{{ lookup('env', 'NODE_TYPE') | default('server') == 'server' | bool }}"

- name: Set agent taints
  set_fact:
    agent_taints: "{{ lookup('env', 'NODE_TYPE') | default('server') == 'agent' | ternary({'key/value pairs': 'value'}, []) }}"
  when: "{{ lookup('env', 'NODE_TYPE') | default('server') == 'agent' | bool }}"

- name: Copy RKE2 configuration file
  copy:
    src: /path/to/template
    dest: /etc/rke2/config.yaml
    mode: '0644'
  notify: rke2_config_handler

- name: Copy Kubelet configuration file
  copy:
    src: /path/to/kubelet_template
    dest: /etc/kubelet/config.yaml
    mode: '0644'
  when: "{{ kubelet_config | default('') != '' | bool }}"
  notify: kubelet_config_handler

- name: Copy Containerd Registry Configuration file
  copy:
    src: /path/to/containerd_registry_template
    dest: /etc/containerd/registry.json
    mode: '0644'
  when: "{{ containerd_registry_config | default('') != '' | bool }}"
  notify: containerd_registry_handler

- name: Start RKE2 service on other nodes
  service:
    name: rke2
    state: started
    enabled: yes
    restart: yes
  when: "{{ lookup('env', 'NODE_TYPE') | default('server') != 'current_node' | bool }}"
  notify: rke2_service_handler

- name: Mask other RKE2 services on nodes
  service:
    name: rke2
    mask: yes
  when: true
  notify: rke2_mask_handler

- name: Wait for remaining nodes to be ready - no CNI
  wait_for_task:
    host: "{{ item }}"
    path: /healthz
    state: present
    until: 600s
    delay: 30s
    until_all: yes
  loop: "{{ groups['nodes'] | list }}"

- name: Wait for remaining nodes to be ready - with CNI
  wait_for_task:
    host: "{{ item }}"
    path: /healthz
    state: present
    until: 600s
    delay: 30s
    until_all: yes
  loop: "{{ groups['nodes'] | list }}"
  when: "{{ cni_config | default('') != '' | bool }}"


