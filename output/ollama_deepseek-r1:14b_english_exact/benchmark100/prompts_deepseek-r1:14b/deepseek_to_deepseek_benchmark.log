---
- name: Restart RKE2 service on {{ rke2_node_name }}
  command: systemctl restart rke2
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  kubectl:
    command: get nodes
    args:
      - --field-selector
      - status.nodeInfo.status!=Ready
      - -o
      - jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}'
    state: present
    kubeconfig_path: "{{ rke2_kubeconfig_path }}"
  delegate_to: "{{ rke2_servers_group_name | default('all') | first }}"
  when: ansible_check_mode is false
  register: nodes_ready
  until: nodes_ready.results | map(attribute='stdout') | all
  retries: 100
  delay: 15
  name: wait_for_nodes_to_be_ready

- name: Wait for all pods to be ready again
  kubectl:
    command: get pods
    args:
      - --all-namespaces
      - --field-selector
      - status.podInfo.status!=Running
      - -o
      - jsonpath='{.items[*].status.phase}'
    state: present
    kubeconfig_path: "{{ rke2_kubeconfig_path }}"
  delegate_to: "{{ rke2_servers_group_name | default('all') | first }}"
  when: ansible_check_mode is false and rke2_wait_for_all_pods_to_be_ready
  register: pods_ready
  until: pods_ready.results | map(attribute='stdout') | all
  retries: 100
  delay: 15


