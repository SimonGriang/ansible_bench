  import_tasks:
    file: assert.yml
  run_once: true

- name: Enable Redis module stream for RHEL 8
  dnf:
    name: "{{ item }}"
    state: enabled
  with_items: ['redis']

- name: Install Redis package
  yum:
    name: "{{ redis_packages }}"
    state: present

- name: Configure Redis settings
  template:
    src: redis.conf-{{ ansible_distribution }}.j2
    dest: /etc/redis.conf
    owner: "{{ redis_owner }}"
    group: "{{ redis_group }}"
    mode: "{{ redis_mode }}"
  notify: restart_redis

- name: Start and enable Redis service
  systemctl:
    name: "{{ redis_service }}"
    state: started
    enabled: true

