.j2\n    dest: /etc/systemd/system/{{ item.name }}.service\n  with_items: service_list\n  notify: systemctl\n\n- name: Configure sysvinit service\n  template:\n    src: sysvinit.j2\n    dest: /etc/init.d/{{ item.name }}\n  with_items: service_list\n  notify: sysvinit\n\n- name: Manage service\n  service:\n    name: "{{ item.name }}"\n    state: "{{ item.state }}"\n    enabled: "{{ item.enabled }}"\n    restarted: yes\n  with_items: service_list\n  notify: systemctl\n\n- name: Flush handlers\n  meta:\n    flush_handlers: true\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-19T15:48:37.132230079Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13998900915, 'load_duration': 86852157, 'prompt_eval_count': 413, 'prompt_eval_duration': 111348780, 'eval_count': 568, 'eval_duration': 13799104302, 'model_name': 'deepseek-r1:14b'} id='run--84185228-f6ce-43a7-8e9e-e8f4d374edef-0' usage_metadata={'input_tokens': 413, 'output_tokens': 568, 'total_tokens': 981}
