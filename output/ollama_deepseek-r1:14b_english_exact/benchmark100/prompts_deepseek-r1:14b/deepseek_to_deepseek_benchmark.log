---
- name: Remove externally managed from Debian 12
  apt_key:
    key: "{{ item }}"
    state: absent
  loop: "{{ externally_managed_keys | default([]) }}"

- name: Remove third-party repositories
  file:
    path: "{{ item }}"
    state: absent
  loop: "{{ lookup('fileglob', '/etc/apt/sources.list.d/*.list') }}"

- name: Clean apt cache
  shell: apt-get clean

- name: Ensure Pip is installed
  apt:
    name: "{{ pip_package }}"
    state: present
    update_cache: yes

- name: Ensure packaging is available via dnf
  apt:
    name: python3-packaging
    state: present
    update_cache: yes

- name: Ensure pip_install_packages are installed
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version | default('latest') }}"
    virtualenv: "{{ item.virtualenv | default(None) }}"
    state: "{{ item.state | default('present') }}"
    extra_args: "{{ item.extra_args | default('') }}"
  loop: "{{ pip_install_packages | default([]) }}"


