---
- name: gather_facts | Lookup bootstrap facts
  slurp:
    path: /etc/os-release
  register: os_release

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    distribution_name: "{{ os_release.content | json_query('NAME') }}"
    major_version: "{{ os_release.content | json_query('VERSION_ID') | default('unknown') }}"

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    os_family: "{{ {
      'RedHat': 'RedHat',
      'CentOS': 'RedHat',
      'Fedora': 'Fedora',
      'Ubuntu': 'Debian',
      'Debian': 'Debian',
      'Arch': 'Arch',
      'Gentoo': 'Gentoo'
    }.get(distribution_name, 'unknown') }}"


