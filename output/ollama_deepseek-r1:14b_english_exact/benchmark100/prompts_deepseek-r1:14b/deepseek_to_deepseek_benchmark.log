---
- name: Task 1: Import assert.yml
  include_tasks:
    file: assert.yml
  loop: never

- name: Task 2: Install dns
  apt:
    name: "{{ dns_packages }}"
    state: present

- name: Task 3: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: "{{ item_mode | default('0755') }}"
    owner: "{{ item_owner | default('root') }}"
    group: "{{ item_group | default('root') }}"
  with_items: "{{ dns_directories }}"

- name: Task 4: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Task 5: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true

- name: Task 6: Generate rndc key
  command: "{{ dns_BINDrndcpath }}{{ item.key }}.conf"
  creates: "{{ rndc_key_file }}"
  with_items: "{{ rndc_keys }}"

- name: Task 7: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_file }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "0640"

- name: Task 8: Get the hints/root file
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ root_hints_file }}"
    mode: "0644"
  when: dns_caching_dns

- name: Task 9: Create zone file
  include_tasks: assert.yml

- name: Task 10: Add zones to configuration
  template:
    src: "{{ item.template }}"
    dest: "{{ item.path }}"
    mode: "0644"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  with_items: "{{ dns_zones }}"
  notify: Restart dns

- name: Task 11: Place systemd override
  copy:
    src: "{{ systemd_override_src }}"
    dest: "{{ systemd_override_dest }}"
    mode: "0644"
  when: "ansible_distribution == 'Ubuntu'"
  notify: systemd-reload

- name: Task 12: Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: yes


