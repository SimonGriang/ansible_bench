---
- name: Task 1: Import assertion tasks from assert.yml file for validation checks. Run once on localhost.
  import_tasks: assert.yml
  tags:
    - always

- name: Task 2: Install Apache HTTPD packages specified in httpd_packages variable.
  apt_repository:
    repo: "deb http://example.com {{ ansible_distribution_version }}"
    state: present
  yum:
    name: "{{ httpd_packages }}"
    state: present
  tags:
    - httpd

- name: Task 3: Configure SELinux settings if it is enabled. Modify SELinux boolean settings in httpd_sebooleans and allow connections on specified ports (httpd_port and httpd_ssl_port).
  selinux_info:
    check: true
  when: ansible_selinux_enabled == "yes"
  selinux_boolean:
    name: "{{ item }}"
    state: true
  with_items: "{{ httpd_sebooleans }}"
  semanage:
    port:
      newport: "{{ item }}"
      protocol: tcp
      state: allow
  with_items: "{{ httpd_ports }}"

- name: Task 4: Configure Apache HTTPD by templating configuration file from httpd_config_src to httpd_config_dest with mode 0644. Notify handlers for configuration test and service restart.
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify:
    - httpd_config_test
    - httpd_service_restart

- name: Task 5: Activate Apache HTTPD modules using a2enmod command for Debian-based systems. Loop through httpd_modules_to_activate_with_command.
  a2enmod:
    modules: "{{ item }}"
  with_items: "{{ httpd_modules_to_activate_with_command }}"

- name: Task 6: Import SSL configuration tasks from ssl.yml when https_ssl_enable is true.
  import_tasks: ssl.yml
  when: https_ssl_enable

- name: Task 7: Import locations configuration tasks from locations.yml when httpd_locations is defined.
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Task 8: Import virtual hosts configuration tasks from vhosts.yml when httpd_vhosts is defined.
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Task 9: Configure Apache HTTPD ports by templating ports configuration file. Notify handlers for configuration test and service restart. Only for Debian and Suse systems.
  template:
    src: "{{ httpd_ports_config_src }}"
    dest: "{{ httpd_ports_config_dest }}"
    mode: 0644
  notify:
    - httpd_config_test
    - httpd_service_restart
  when:
    - ansible_distribution in ['Debian', 'Suse']

- name: Task 10: Import directories configuration tasks from directories.yml when httpd_directories is defined.
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Task 11: Flush all registered handlers to execute them immediately.
  shell: |
    /usr/bin/ansible-playbook
    --flush-handlers
  tags:
    - always

- name: Task 12: Remove default HTML file from httpd_data_directory if httpd_remove_example is true.
  file:
    path: "{{ httpd_data_directory }}/example.html"
    state: absent
  when: httpd_remove_example

- name: Task 13: Start and enable Apache HTTPD service named httpd_service.
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true


