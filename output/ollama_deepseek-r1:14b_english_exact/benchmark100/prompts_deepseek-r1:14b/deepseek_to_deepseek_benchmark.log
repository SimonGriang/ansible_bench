---
- name: cadvisor | create directories
  file:
    path: /var/lib/cadvisor
    state: directory
    owner: root
    group: root
    mode: 0755

- name: cadvisor | download
  uri:
    url: https://example.com/cadvisor-amd64
    dest: /usr/local/cadvisor/cadvisor-amd64
    remote_src: true
    checksum: sha256:1234567890abcdef1234567890abcdef1234567890

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: /usr/local/cadvisor/cadvisor-amd64
    dest: /usr/local/bin/cadvisor
    remote_src: true
    notify: restart_cadvisor

- name: cadvisor | symlink
  ln:
    src: /usr/local/bin/cadvisor
    dest: /usr/bin/cadvisor
    state: symlink

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    owner: root
    group: root
    mode: 0644

- name: test_task
  command: systemctl status cadvisor
  register: service_active

- name: debug: var=service_active
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemctl:
    name: cadvisor
    state: enabled

- name: cadvisor | start server systemd
  systemctl:
    name: cadvisor
    state: started
    daemon_reload: yes  2%|▏         | 2/100 [03:38<3:14:04, 118.82s/it]

