tion': 98439303, 'prompt_eval_count': 1289, 'prompt_eval_duration': 168606922, 'eval_count': 925, 'eval_duration': 18826839086, 'model_name': 'deepseek-r1:14b'} id='run--09aed0b7-beba-4fcd-9261-034363658443-0' usage_metadata={'input_tokens': 1289, 'output_tokens': 925, 'total_tokens': 2214} 58%|█████▊    | 58/100 [2:11:07<1:21:33, 116.50s/it]
