---
- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_check

- name: Check Helm version
  shell: helm version
  register: helm_existing_version
  ignore_errors: yes

- name: Download helm
  unarchive:
    remote_src: yes
    url: https://get.helm.sh/helm-{{ helm_version }}-linux-amd64.tar.gz
    dest: /usr/local/bin/
    remote_src: yes
  register: helm_download
  when: helm_check.stat不存在 or helm_existing_version.stdout_lines[0].split()[1] != "v3.12.0"

- name: Copy helm binary into place
  copy:
    remote_src: yes
    src: /usr/local/bin/helm
    dest: /usr/local/bin/helm
    mode: 0755
    owner: root
    group: root
  when: helm_download is successful


