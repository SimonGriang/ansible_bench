ne_reason': 'stop', 'total_duration': 28828663450, 'load_duration': 105334379, 'prompt_eval_count': 677, 'prompt_eval_duration': 362552771, 'eval_count': 1345, 'eval_duration': 28359783583, 'model_name': 'deepseek-r1:14b'} id='run--9f9bd2c9-b17a-4d8f-82e6-25ef18759abb-0' usage_metadata={'input_tokens': 677, 'output_tokens': 1345, 'total_tokens': 2022}
