---
- name: Install unzip package
  apt:
    name: unzip
    state: present

- name: Create system group for promtail
  group:
    name: promtail
    state: present

- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    state: present
    create_home: yes
    shell: /bin/false

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    owner: root
    group: root
    mode: 755

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: 755

- name: Create application directories
  file:
    path: /var/lib/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: 755

- name: Check promtail binary existence
  stat:
    path: /usr/local/bin/promtail
    register: promtail_binary_exists

- name: Download promtail binaries
  get_url:
    url: https://distribution.url/promtail-linux-amd64.zip
    dest: /tmp/promtail-linux-amd64.zip
    checksum: 'md5:abcdef1234567890'

- name: Propagate local promtail binaries
  copy:
    src: /path/to/local/binary
    dest: /tmp/
    remote_src: no

- name: Download promtail binaries for controller node
  get_url:
    url: https://distribution.url/promtail-controller-linux-amd64.zip
    dest: /tmp/promtail-controller-linux-amd64.zip
    checksum: 'md5:0123456789abcdef'

- name: Propagate promtail binaries
  copy:
    src: /path/to/controller/binary
    dest: /tmp/
    remote_src: no

- name: Unpack promtail binaries
  unzip:
    name: /tmp/promtail-linux-amd64.zip
    dest: /usr/local/bin/

- name: Create symlink to latest promtail version
  file:
    path: /usr/local/bin/promtail
    state: lnk_file
    src: /usr/local/bin/promtail-latest

- name: Write promtail config file
  template:
    src: promtail-config.j2
    dest: /etc/promtail/config.yml
    owner: promtail
    group: promtail
    mode: 644

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: 644


