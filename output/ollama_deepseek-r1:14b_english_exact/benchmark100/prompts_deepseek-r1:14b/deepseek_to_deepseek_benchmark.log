---
- name: Populate services facts
  ansible.builtin.gathering_facts:
    gather_subset: services

- name: Set the Active Server variable
  ansible.builtin.set_fact:
    active_server: "{{ ansible_hostname }}"
  delegate_to: "{{ item }}"
  with_items: "{{ rke2_cluster }}"
  when: ansible_service.rke2_server.status == 'running'
  register: active_server_result
  changed_when: false


