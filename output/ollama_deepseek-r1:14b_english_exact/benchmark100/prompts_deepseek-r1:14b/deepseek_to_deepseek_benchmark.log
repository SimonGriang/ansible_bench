---
- import_tasks: assert.yml
  run_once: true
  host: localhost

- name: Install required packages
  apt:
    name: "{{ selinux_requirements }}"
    state: present
  register: install_result
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when:
    - selinux_status is defined
    - ansible_connection not in ['container', 'docker', 'community.docker.docker']
  block:
    - name: Manage SELinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Manage SELinux booleans
      selinux_boolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: yes
        label: "{{ item.name }}"
      loop: "{{ selinux_booleans | default([]) }}"
      when: selinux_booleans is defined


