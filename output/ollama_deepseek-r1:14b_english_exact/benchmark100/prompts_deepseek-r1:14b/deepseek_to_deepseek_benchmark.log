---
- name: Import assert.yml
  include_tasks:
    file: assert.yml
  delegate_to: localhost

- name: Install required packages
  apt:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_TIMEOUT=\\d+'
    line: 'GRUB_TIMEOUT="{{ grub_timeout }}"'
    backslashed_s: true

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_RECORDFAIL_TIMEOUT=\\d+'
    line: 'GRUB_RECORDFAIL_TIMEOUT="{{ grub_recordfail_timeout }}"'
    backslashed_s: true

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_CMDLINE_LINUX="(.*)"$'
    line: 'GRUB_CMDLINE_LINUX="\1 {{ grub_options }}"' 
    backslashed_s: true
  when: grub_options is defined

- name: Import password.yml
  include_tasks:
    file: password.yml
  when: grub_set_password

- name: Flush handlers
  meta:
    flush_handlers: yes


