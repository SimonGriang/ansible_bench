---
- name: Import assertion file
  include_tasks: assert.yml
  run_once: true

- name: Install cron package
  apt:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  lineinfile:
    path: /etc/cron.conf
    line: SHELL=/bin/bash
    state: present

- name: Configure cron path environment
  lineinfile:
    path: /etc/cron.conf
    line: PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    state: present

- name: Configure cron mailto settings
  lineinfile:
    path: /etc/cron.conf
    line: "MAILTO={{ cron_mailto }}"
    state: present

- name: Start and enable cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined

- name: Schedule cron jobs
  cronicle:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    cron: "{{ item.cron }}"
    state: present
    replace: yes
  with_items: "{{ cron_jobs }}"
  when: cron_jobs is defined


