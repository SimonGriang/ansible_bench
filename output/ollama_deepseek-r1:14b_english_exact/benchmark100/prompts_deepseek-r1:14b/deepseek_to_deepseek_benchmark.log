---
- name: Import assert.yml
  ansible.builtin.include_tasks:
    file: files/assert.yml

- name: Wait for port to be available
  ansible.builtin.wait_for_port:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  no_log: true

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.become:
        become: true
        become_user: root
        executable: /bin/sh
        command: echo "test"

    - name: Test sudo access
      ansible.builtin.command:
        cmd: whoami
        changed_when: false
        failed_when: false

  rescue:
    - name: Gather facts on failure
      ansible.builtin.setup:
        gather_subset: all

    - name: Install basic packages with raw
      ansible.builtin.raw:
        cmd: "{{ bootstrap_raw_packages | join(' ') }}"
        changed_when: false
        no_log: true

    - name: Install libdnf5 on RedHat systems
      when: ansible_distribution == "RedHat"
      ansible.builtin.raw:
        cmd: "{{ libdnf5_install_cmd }}"
        changed_when: false
        no_log: true

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: all
  no_log: true

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"


