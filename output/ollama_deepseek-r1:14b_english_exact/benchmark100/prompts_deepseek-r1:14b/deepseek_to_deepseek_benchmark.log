---
- name: Import assert.yml
  import_tasks: assert.yml
  host: localhost

- name: Install nginx
  apt:
    name: nginx
    state: present

- name: Place nginx.conf
  template:
    src: nginx.conf.j2
    dest: /etc/nginx/nginx.conf
    mode: 0o0644

- name: Ensure /etc/nginx/conf.d exists
  file:
    path: /etc/nginx/conf.d
    state: directory
    owner: www-data
    group: www-data
    mode: 0o0755

- name: Place default.conf
  template:
    src: default.conf.j2
    dest: /etc/nginx/conf.d/default.conf
    mode: 0o0644

- name: Start and enable nginx
  service:
    name: nginx
    state: started
    enabled: true


