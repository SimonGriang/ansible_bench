---
- name: Restore etcd - get all nodes
  kubectl:
    command: get
    args:
      - nodes
      - --o
      - custom-columns=NAME:metadata.name
      - --no-headers
    register: node_names

- name: Prepare node names list
  vars:
    node_names_list: "{{ node_names.stdout_lines | default([]) | list }}"

- name: Restore etcd - remove old nodes
  ansible.builtin.uri:
    method: DELETE
    url: https://localhost/api/v1/nodes/{{ item }}
    status_code: 200
    headers:
      Authorization: "Bearer {{ k8s_auth_token }}"
  loop: "{{ node_names_list }}"
  when: "!groups.rke2_cluster_group_name contains item"

