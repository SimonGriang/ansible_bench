---
- name: Import assert.yml
  import_file:
    file: assert.yml
  register: assert_result
  changed_when: false
  ignore_errors: true

- name: Execute imported assert.yml
  shell: /bin/true
  changed_when: false
  ignore_errors: true

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta:
    flush_handlers: yes

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  notify: Reboot

- name: Manage SELinux booleans
  seboolean:
    name: "{{ item.name }}"
    value: "{{ item.value | default('True') }}"
    persistent: yes
  loop: "{{ selinux_booleans | default([]) | list }}"
  notify: Reboot


