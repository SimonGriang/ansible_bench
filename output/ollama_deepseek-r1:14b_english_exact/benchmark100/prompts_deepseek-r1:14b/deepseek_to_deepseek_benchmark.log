---
- name: Import assert.yml
  ansible.builtin.include_tasks:
    file: assert.yml

- name: Install mysql
  apt:
    name: "{{ packages }}"
    state: present
  notify:
    - mysql_root_password
    - daemon_reload

- name: Configure mysql server
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0o0644
    validate_mode: strict
  notify: mysql_server_restart

- name: Configure mysql client
  ansible.builtin.lineinfile:
    path: /etc/mysql/my.cnf
    line: "{{ client_socket }}"
    create: no

- name: Initialize mysql
  command: /usr/bin/mysql_install_db
  args:
    chdir: /var/lib/mysql
  executable: yes
  vars:
    become_user: mysql

- name: Start and enable mysql
  ansible.builtin.systemd:
    name: "{{ mysql_service_name }}"
    state: started
    enabled: true

- name: Flush handlers
  ansible.builtin.flush_handlers:
    name: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0o0644
    validate_mode: strict
  notify: mysql_server_restart

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
    priv: all:all
    flush_privileges: yes
  loop: "{{ mysql_databases }}"

- name: List databases
  mysql_db:
    name: "*"
    state: list

- name: Import database
  mysql_db:
    name: "{{ item }}"
    state: import
    initial_import: "{{ initial_import_location }}"
  loop: "{{ mysql_databases }}"
  when: initial_import_location is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"
  notify: mysql_server_restart

- name: Flush handlers again
  ansible.builtin.flush_handlers:
    name: flush_handlers


