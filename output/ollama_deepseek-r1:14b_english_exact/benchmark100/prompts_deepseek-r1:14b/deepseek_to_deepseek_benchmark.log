---
- name: Generate an OpenSSL private key
  community.crypto.openssl_privatekey:
    path: /etc/ssl/private/nginx.key
    cipher: aes256
    mode: '0640'
    owner: root
    group: nginx

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  community.crypto.openssl_csr_info:
    path: /etc/ssl/csr/nginx.csr
    mode: '0640'
    subject:
      common_name: example.com

- name: Generate an OpenSSL X.509 certificate
  community.crypto.x509_certificate:
    path: /etc/ssl/certs/nginx.crt
    mode: '0640'
    provider: selfsigned
    privatekey_path: /etc/ssl/private/nginx.key

- name: Generate a PKCS#12 file
  community.crypto.openssl_pkcs12:
    path: /etc/ssl/nginx.p12
    mode: '0640'
    certificate: /etc/ssl/certs/nginx.crt
    privatekey: /etc/ssl/private/nginx.key
    passphrase: my_passphrase
    friendly_name: nginx_key_and_cert

- name: Read private key content
  read_file:
    path: /etc/ssl/private/nginx.key
    register: private_key_content

- name: Read certificate content
  read_file:
    path: /etc/ssl/certs/nginx.crt
    register: cert_content

- name: Create a combined private key and certificate file
  ansible.builtin.copy:
    content: "{{ private_key_content.content }}{{ cert_content.content }}"
    dest: /etc/ssl/nginx.key.crt
    mode: '0640'


