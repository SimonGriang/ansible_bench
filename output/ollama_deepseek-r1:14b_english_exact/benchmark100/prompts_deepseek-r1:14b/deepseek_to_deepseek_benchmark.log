in/helm\n  register: helm_check\n\n- name: Check Helm version\n  shell: helm version\n  register: helm_existing_version\n  ignore_errors: true\n\n- name: Download helm\n  unarchive:\n    remote_src: yes\n    url: https://get.helm.sh/helm-{{ helm_version }}-linux-amd64.tar.gz\n    dest: /usr/local/bin/\n  register: helm_download\n  when: not helm_check.stat.exists or (helm_existing_version.stdout_lines[0].split()[1] != 'v3.12.0')\n\n- name: Copy helm binary into place\n  copy:\n    remote_src: yes\n    src: /usr/local/bin/helm\n    dest: /usr/local/bin/helm\n    mode: 0755\n    owner: root\n    group: root\n  when: helm_download\n\n- name: Ensure helm is properly installed\n  set_fact:\n    helm Installed: true\n  when: helm_download\n\n- name: Run helm completion to verify installation\n  shell: helm completion bash | tee /etc/bash_completion.d/helm\n  when: helm_download" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-19T16:38:19.158936742Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13666804913, 'load_duration': 86038988, 'prompt_eval_count': 805, 'prompt_eval_duration': 103231211, 'eval_count': 678, 'eval_duration': 13475860147, 'model_name': 'deepseek-r1:14b'} id='run--04017bc8-f620-421b-aef0-e6d7b5a961e0-0' usage_metadata={'input_tokens': 805, 'output_tokens': 678, 'total_tokens': 1483}
