---
- name: lookup bootstrap facts (raw)
  shell: cat /etc/os-release
  register: bootstrap_facts
  changed_when: false
  set_fact:
    ansible_user: "{{ bootstrap_user }}"

- name: set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value.name }}"
    bootstrap_distribution_major_version: "{{ item.value.version | regex_replace('^(.*?)([0-9]+).*$', '\\2') }}"
  loop: "{{ bootstrap__os_family_map.items() }}"
  when: "{{ ansible_facts.facter.pretty_name | regex_replace('PRETTY_NAME=\".*?(.*).*', '\\1') }}" == "{{ item.value.regex | regex_replace('^.*?([a-zA-Z]+).*$', '\\1') }}"
  become: yes

- name: set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map.items() }}"
  when: "{{ bootstrap_distribution }}" == "{{ item.value.name }}"
  become: yes


