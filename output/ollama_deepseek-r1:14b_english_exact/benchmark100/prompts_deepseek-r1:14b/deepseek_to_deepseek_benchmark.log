---
- name: Import assertion tasks
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Python pip
  apt:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  lineinfile:
    path: /etc/pip.conf
    line: index-url = {{ python_pip_proxy }}
    state: present
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  lineinfile:
    path: /etc/pip.conf
    line: trusted-host = {{ item }}
    state: present
  with_items: "{{ python_pip_trusted_host | default('') | split(',') | list }}"
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    command: upgrade
    state: present
  when: ansible_distribution not in ['bookworm', 'noble'] and ansible_os_family not in ['Alpine']

- name: Install Python modules
  pip:
    name: "{{ item }}"
    version: "{{ python_pip_modules_version | default('') }}"
    state: present
  with_items: "{{ python_pip_modules | default('') | split(',') | list }}"
  when: ansible_distribution not in ['bookworm', 'noble'] and ansible_os_family not in ['Alpine']

