---
- name: Validate all variables are set correctly
  include_tasks: assert.yml

- name: Wait for host to be available
  wait_for:
    port: 22
    state: started
    timeout: 30

- name: Prepare system for bootstrap
  block:
    - name: Test connection
      ping:
        count: 1
      rescue:
        - name: Connection failed
          fail:
            msg: "Could not connect to host"
  vars:
    packages: ['ansible', 'python3']

- name: Ensure system preparation with Ansible modules
  block:
    - name: Test connection
      ping:
        count: 1
      rescue:
        - name: Connection failed
          fail:
            msg: "Could not connect to host"
    - name: Gather facts
      setup:
        gather_subset: all
    - name: Update package lists
      apt_update: {}
    - name: Install packages
      apt:
        name: "{{ packages }}"
        state: present
    - name: Verify packages
      assert:
        that: "'ansible' in ansible.installed_packages()"
        msg: "ansible is not installed"


