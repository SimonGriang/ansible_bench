---
- name: Import assert.yml
  import_tasks: files/assert.yml
  delegate_to: localhost
  run_once: true

- name: Install mysql
  apt-get:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  ini_file:
    path: /etc/mysql/my.cnf
    section: mysqld
    key: "{{ item.key }}"
    value: "{{ item.value }}"
    mode: 0644
  with_dict: "{{ mysql_configuration_options }}"
  notify:
    - Restart mysql server

- name: Configure mysql client
  ini_file:
    path: /etc/mysql/my.cnf
    section: mysql
    key: socket
    value: "{{ mysql_client_socket }}"
    mode: 0644

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  systemctl:
    name: mysql
    state: started
    enabled: yes
  notify:
    - Systemctl daemon-reexec

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644

- name: Create databases
  mysql_db:
    name: "{{ db }}"
    state: present
  with_items: "{{ mysql_databases | default([]) }}"
  when: mysql_databases | defined

- name: Create users
  mysql_user:
    name: "{{ user }}"
    host: "{{ host }}"
    password: "{{ password }}"
    priv: "{{ privileges }}"
    state: present
  with_items: "{{ mysql_users | default([]) }}"
  when: mysql_users | defined

- name: Flush handlers again
