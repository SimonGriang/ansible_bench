---
- name: Restore etcd - get all nodes
  ansible.builtin.command:
    cmd: kubectl get nodes --o custom-columns=NAME:metadata.name --no-headers
    register: node_names

- name: Prepare node names list
  ansible.builtin.set_fact:
    node_names_list: "{{ node_names.stdout_lines | default([]) | list }}"

- name: Restore etcd - remove old nodes
  ansible.builtin.shell:
    cmd: kubectl delete nodes "{{ item }}"
    args:
      - name: "{{ item }}"
    when: "{{ item }} not in groups.rke2_cluster_group_name"
  loop: "{{ node_names_list }}"


