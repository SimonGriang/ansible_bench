ition }}-nightly\n  when:\n    - docker_add_repo\n    - docker_yum_repo_enable_nightly\n\n- name: Configure Docker Test repo\n  yum:\n    repo: /etc/yum.repos.d/docker-{{ docker_edition }}.repo\n    state: enabled\n    enablerepo: docker-{{ docker_edition }}-test\n  when:\n    - docker_add_repo\n    - docker_yum_repo_enable_test\n\n- name: Configure containerd on RHEL 8\n  block:\n    - name: Remove runc package\n      apt:\n        name: runc\n        state: absent\n        purge: yes\n        force: yes\n\n    - name: Ensure container-selinux is installed\n      yum:\n        name: container-selinux\n        state: present\n\n    - name: Ensure containerd.io is installed\n      yum:\n        name: containerd.io\n        state: present\n  when: ansible_facts.distribution_major_version | int == 8' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-19T16:08:47.88688667Z', 'done': True, 'done_reason': 'stop', 'total_duration': 46184431018, 'load_duration': 111066766, 'prompt_eval_count': 1032, 'prompt_eval_duration': 66687823, 'eval_count': 2073, 'eval_duration': 46004839177, 'model_name': 'deepseek-r1:14b'} id='run--9ba48b73-0b6f-4ddd-9f22-14b3fd9e57f5-0' usage_metadata={'input_tokens': 1032, 'output_tokens': 2073, 'total_tokens': 3105} 18%|█▊        | 18/100 [42:48<3:48:09, 166.95s/it]
