---
- name: Enable Backports repository
  apt:
    state: source
    source: "deb http://deb.debian.org/debian/ {{ ansible_distribution_version|default('jessie') }}-backports main"

- name: Set the default_release option for older Debian versions
  set_fact:
    ansible.deprecated.default_release: backports

- name: Install Ansible
  apt:
    name: ansible
    state: present
    repo: "deb http://deb.debian.org/debian/ {{ ansible_distribution_version|default('jessie') }}-backports main"


