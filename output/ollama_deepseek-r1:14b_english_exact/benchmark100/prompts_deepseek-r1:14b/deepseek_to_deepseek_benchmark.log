---
- name: Check current docker-compose version
  shell:
    cmd: docker-compose --version
    changed_when: false
  register: docker-compose_version

- name: Set fact for docker-compose current version
  set_fact:
    current_docker_compose_version: "{{ docker-compose_version.stdout | regex_replace('docker-compose version ', '') | regex_replace('v', '') }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: current_docker_compose_version is undefined or current_docker_compose_version != "docker-compose-expected-version"

- name: Install Docker Compose (if configured)
  become: yes
  become_user: root
  sequence:
    - name: Download docker-compose
      get_url:
        url: https://github.com/docker/compose/releases/download/
          docker-compose-expected-version/docker-compose-{{ ansible_distribution | lower }}-{{ ansible_python_version }}
        dest: /usr/local/bin/docker-compose
        mode: 0755

    - name: Make docker-compose executable
      file:
        path: /usr/local/bin/docker-compose
        mode: 0755
        state: file

    - name: Move docker-compose to correct location
      shell: mv /usr/local/bin/docker-compose /usr/local/bin/docker-compose


