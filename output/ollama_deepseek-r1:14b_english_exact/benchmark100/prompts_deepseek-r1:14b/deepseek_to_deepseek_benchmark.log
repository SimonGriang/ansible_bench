---
- name: Import assertion tasks
  import_tasks: assert.yml
  become: false
  delegate_to: localhost

- name: Install requirements
  apt:
    name: "{{ sysctl_requirements }}"
    state: present

- name: Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    reload: "{{ item.reload | default('yes') | lower()}}"
    sysctl_binary: /usr/sbin/sysctl
