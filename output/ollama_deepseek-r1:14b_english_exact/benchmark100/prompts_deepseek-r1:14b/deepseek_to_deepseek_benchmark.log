---
- name: Import assertion tasks
  ansible.builtin.import_tasks:
    file: assert.yml
  args:
    run_once: true
  delegate_to: localhost

- name: Install php
  ansible.builtin.apt:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  ansible.builtin.command:
    cmd: php --ini
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  ansible.builtin.template:
    src: php.ini.j2
    dest: "{{ php_found_ini_location.path }}"
    mode: 420
  notify: Restart httpd
  when: php_found_ini_location is defined

