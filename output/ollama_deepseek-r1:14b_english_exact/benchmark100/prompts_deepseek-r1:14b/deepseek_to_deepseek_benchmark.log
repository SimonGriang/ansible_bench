---
- name: Download RKE2 installation script
  get_url:
    url: "https://example.com/rke2-install.sh"
    dest: "/usr/local/bin/rke2-install.sh"
    mode: 0700
  when: not airgap

- name: Copy local RKE2 installation script
  copy:
    src: "files/rke2-install.sh"
    dest: "/usr/local/bin/rke2-install.sh"
    mode: 0700
  when: airgap
  remote_src: yes

- name: Create RKE2 artifacts folder
  file:
    path: "/var/lib/rke2-artifacts"
    state: directory
    mode: 0700
  when: airgap and not exists

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download checksum
      get_url:
        url: "https://example.com/rke2-checksum.txt"
        dest: "/var/lib/rke2-artifacts/rke2-checksum.txt"
        mode: 0640
      when: not airgap

    - name: Download artifacts
      get_url:
        url: "https://example.com/rke2-artifacts.tar.gz"
        dest: "/var/lib/rke2-artifacts/rke2-artifacts.tar.gz"
        mode: 0640
      when: not airgap

    - name: Fallback to local artifacts
      copy:
        src: "files/rke2-artifacts.tar.gz"
        dest: "/var/lib/rke2-artifacts/rke2-artifacts.tar.gz"
        mode: 0640
        remote_src: yes
      when: airgap
  when: not exists

- name: Copy local RKE2 artifacts
  copy:
    src: "files/rke2-artifacts.tar.gz"
    dest: "/var/lib/rke2-artifacts/rke2-artifacts.tar.gz"
    mode: 0640
    remote_src: yes
  when: airgap and copy

- name: Airgap mode - additional images tarballs
  block:
    - name: Create directory for additional images
      file:
        path: "/var/lib/rke2-artifacts/images"
        state: directory
        mode: 0700
      when: additional_images

    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: "/var/lib/rke2-artifacts/images/"
        mode: 0640
        remote_src: yes
        with_items: "{{ additional_images_tarballs }}"
  when: airgap and additional_images

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Set artifacts directory permissions
      file:
        path: "/var/lib/rke2-artifacts"
        mode: 0700
      when: airgap and exists

    - name: Set install script permissions
      file:
        path: "/usr/local/bin/rke2-install.sh"
        mode: 0700
      when: airgap and exists
  when: airgap and exists

- name: Populate service facts
  ansible.builtin.service_facts:
    []

- name: Get stats of the FS object
  stat:
    path: /usr/local
    check_setuid_file: no
  register: fs_stats

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin"
  when: (ansible_facts.filesystem /usr/local == 'yes') or (not fs_stats | is_setuid)
  else:
    rke2_bin_path: "{{ lookup('env', 'RKE2_BINARY_PATH') | default('/usr/bin') }}"

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 -version"
  register: rke2_version
  ignore_errors: yes

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "'{{ rke2_version.stdout | regex_replace('.*', '.*\\d') }}' >= '{{ rke2_version.stdout | regex_replace('.*', '.*\\d') }}'"
    fail_on_error: yes
    success_ok: yes
  when: downgrade_not_allowed

- name: Run RKE2 install script
  command: "{{ rke2_bin_path }}/rke2 install --token {{ rke2_token }}"
  when: not airgap

- name: Copy Custom Manifests
  copy:
    src: "files/manifests/{{ item }}"
    dest: "/etc/rke2/manifests/"
    mode: 0640
    remote_src: yes
    with_items: "{{ custom_manifests }}"

- name: Copy Static Pods
  template:
    src: "files/static_pods/{{ item }}"
    dest: "/etc/rke2/agent/pod-manifests/"
    mode: 0640
    remote_src: yes
    with_items: "{{ static_pods }}"

- name: Copy RKE2 environment file
  copy:
    src: "files/rke2_env"
    dest: "/etc/rke2/rke2.env"
    mode: 0640
    remote_src: yes
  when: environment_options | default | length > 0


