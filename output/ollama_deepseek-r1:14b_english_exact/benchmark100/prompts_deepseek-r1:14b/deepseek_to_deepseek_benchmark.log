---
- name: Create the RKE2 config directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set node taints for RKE2 server nodes
  k8s_node_taints:
    taints: "{{ rke2_server_node_taints | default([]) }}"
  when: rke2_server_node_taints is defined

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rke2/config.yml
    mode: '0644'
    owner: root
    group: root
  notify: rke2_config_updated

- name: Copy kubelet configuration file
  copy:
    src: "{{ rke2_kubelet_config_src }}"
    dest: /etc/rke2/kubelet.yml
    mode: '0644'
    owner: root
    group: root
  when: rke2_kubelet_config is not empty
  notify: rke2_kubelet_config_updated

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registry_config_src }}"
    dest: /etc/rke2/registry.json
    mode: '0644'
    owner: root
    group: root
  when: rke2_containerd_registry_config is not empty
  notify: rke2_containerd_registry_config_updated

- name: Register etcd restore from file
  set_fact:
    rke2_etcd_restore_from_file: yes
  when: rke2_etcd_snapshot_path is defined and stat(rke2_etcd_snapshot_path).exists == true and service('rke2').state == 'stopped'

- name: Register etcd restore from S3
  set_fact:
    rke2_etcd_restore_from_s3: yes
  when: rke2_etcd_s3_bucket is defined and rke2_etcd_s3_prefix is defined and rke2_etcd_s3_access_key is defined and rke2_etcd_s3_secret_key is defined

- name: Restore etcd from file
  block:
    - name: Create etcd data directory
      file:
        path: /var/lib/rke2/etcd
        state: directory
        mode: '0755'
        owner: rke2
        group: rke2

    - name: Copy etcd snapshot
      copy:
        src: "{{ rke2_etcd_snapshot_path }}"
        dest: /var/lib/rke2/etcd/
        remote_src: yes
        mode: '0644'
        owner: rke2
        group: rke2

    - name: Run etcd restore command
      shell: /usr/bin/etcd_restore --config /etc/rke2/config.yml
      changed_when: false
  when: rke2_etcd_restore_from_file == 'yes'

- name: Restore etcd from S3
  block:
    - name: Create etcd data directory
      file:
        path: /var/lib/rke2/etcd
        state: directory
        mode: '0755'
        owner: rke2
        group: rke2

    - name: Download etcd snapshot from S3
      shell: s3cmd sync s3://{{ rke2_etcd_s3_bucket }}/{{ rke2_etcd_s3_prefix }} /var/lib/rke2/etcd/
            args:
              executable: /usr/bin/s3cmd
              chdir: /var/lib/rke2/etcd

    - name: Run etcd restore command
      shell: /usr/bin/etcd_restore --config /etc/rke2/config.yml
      changed_when: false
  when: rke2_etcd_restore_from_s3 == 'yes'

- name: Start RKE2 service
  shell: systemctl start rke2 && systemctl enable rke2
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"

- name: Mask RKE2 agent service
  service:
    name: rke2-agent
    state: masked

- name: Wait for first server to be ready (no CNI)
  wait_for_task:
    path: /var/lib/rke2/pki/serving-certs/manifest.json
    state: absent
  until: 300
  delay: 30
  changed_when: false

- name: Wait for first server to be ready (with CNI)
  wait_for_task:
    path: /var/lib/rke2/pki/serving-certs/manifest.json
    state: present
  until: 300
  delay: 30
  changed_when: false

- name: Restore etcd
  block:
    - name: Remove old etcd data
      file:
        path: /var/lib/rke2/etcd
        state: absent
        force: yes

    - name: Remove old etcd certs
      file:
        path: /etc/ssl/etcd
        state: absent
        force: yes

    - name: Remove old kubeconfig
      file:
        path: /var/lib/rke2/kubeconfig
        state: absent
        force: yes
  when: rke2_etcd_restore_from_file == 'yes' or rke2_etcd_restore_from_s3 == 'yes'

- name: Set Active Server variable
  set_fact:
    rke2_active_server: "{{ hostvars[groups['rke2_nodes'][0]]['ansible_hostname'] }}"


