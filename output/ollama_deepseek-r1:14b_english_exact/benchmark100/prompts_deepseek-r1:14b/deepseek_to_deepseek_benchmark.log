pn/easy-rsa/pki\n  register: ta_key\n  changed_when: false\n\n- name: Copy PKI files to /etc/openvpn/server directory\n  copy:\n    src: /etc/openvpn/easy-rsa/pki/.*\n    dest: /etc/openvpn/server/\n    remote_src: true\n    mode: 0640\n\n- name: Copy additional PKI files to /etc/openvpn directory\n  copy:\n    src: /etc/openvpn/easy-rsa/keys/.*\n    dest: /etc/openvpn/\n    remote_src: true\n    mode: 0640\n\n- name: Place OpenVPN server configuration file\n  template:\n    src: server.conf.j2\n    dest: /etc/openvpn/server.conf\n    owner: openvpn\n    group: openvpn\n    mode: 0640\n  notify: restart openvpn\n```" additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-19T16:47:07.638391581Z', 'done': True, 'done_reason': 'stop', 'total_duration': 29323916280, 'load_duration': 92939126, 'prompt_eval_count': 1332, 'prompt_eval_duration': 20259918, 'eval_count': 1288, 'eval_duration': 29209118191, 'model_name': 'deepseek-r1:14b'} id='run--f4d5fd4c-3284-4318-b530-cde3c97f2374-0' usage_metadata={'input_tokens': 1332, 'output_tokens': 1288, 'total_tokens': 2620} 34%|███▍      | 34/100 [1:21:08<2:27:30, 134.09s/it]
