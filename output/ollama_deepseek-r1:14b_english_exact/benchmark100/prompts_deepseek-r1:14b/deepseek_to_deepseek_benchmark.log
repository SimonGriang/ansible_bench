---
- name: Import assert.yml
  shell: 
    cmd: ansible-playbook
    args:
      - --tags=assert
      - .

- name: Pre-configure debian systems
  debconf-set-selections:
    name: postfix
    selections:
      postfix/mailname: "{{ ansible_hostname }}"
      postfix/destinations: "localhost.localdomain, localhost"
      postfix/virtual_domain_maps: "hash:/etc/postfix/virtual-domains"
      postfix/virtual_mailbox_maps: "hash:/etc/postfix/virtual-mailbox"

- name: Install postfix
  apt-get:
    name: postfix
    state: present

- name: Install postfix-mysql
  apt-get:
    name: postfix-mysql
    state: present

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps
    dest: /etc/postfix/transport_maps
    mode: 0644
  notify: rebuild_transport_maps

- name: Configure postfix (header_checks)
  template:
    src: header_checks
    dest: /etc/postfix/header_checks
    mode: 0644
  notify: reload_postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_config_recipient_restrictions: "reject_non_fqdn_sender, reject_non_fqdn_recipient, reject_unknown_sender_domain, reject_unknown_recipient_domain"

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_config_mynetworks: "127.0.0.0/8 [::1]/128"
    postfix_config_mydestination: "{{ ansible_hostname }}, localhost.localdomain, localhost"
    postfix_config_relay_domains: |
      "{{ postfix_relay_domains if postfix_relay_domains is defined else 'null' }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 0644
  notify: restart_postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: 0644
  notify: restart_postfix

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: 0700
  loop:
    - /etc/pki/tls/private
    - /etc/pki/tls/certs

- name: Deploy Postfix TLS server certificate
  copy:
    src: postfix-server.crt
    dest: /etc/pki/tls/certs/postfix-server.crt
    mode: 0644
  notify: reload_postfix

- name: Deploy Postfix TLS server key
  copy:
    src: postfix-server.key
    dest: /etc/pki/tls/private/postfix-server.key
    mode: 0640
  notify: reload_postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: "{{ item }}"
  loop: "{{ postfix_aliases | default([]) }}"

- name: Configure sender_access
  template:
    src: sender_access
    dest: /etc/postfix/sender_access
    mode: 0644
  notify: reload_postfix

- name: Configure recipient_access
  template:
    src: recipient_access
    dest: /etc/postfix/recipient_access
    mode: 0644
  notify: reload_postfix

- name: Place sasl_password_map
  copy:
    src: sasl_password_map
    dest: /etc/postfix/sasl_password_map
    mode: 0644
  notify: rebuild_sasl_map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemd:
    name: postfix
    state: started
    enabled: true


