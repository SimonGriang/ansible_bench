---
- name: Create the RKE2 manifests directory
  file:
    path: /var/lib/rke2/manifests
    state: directory
    mode: 0755
    owner: rancher
    group: rancher

- name: Copy kube-vip files to first server
  copy:
    src: "{{ lookup('fileglob', 'templates/kube-vip-*') | selectattr('exists', 'bool') }}"
    dest: /var/lib/rke2/data/
    remote_src: no
    mode: 0644
    owner: rancher
    group: rancher

- name: Copy kube-vip load balancer manifests to first server
  condition: "{{ kube_vip_cloud_provider_enabled | default('no') == 'yes' }}"
  copy:
    src: "{{ lookup('fileglob', 'templates/kube-vip-lb-*') | selectattr('exists', 'bool') }}"
    dest: /var/lib/rke2/data/
    remote_src: no
    mode: 0644
    owner: rancher
    group: rancher


