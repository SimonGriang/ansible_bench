- name: Task 1: Import the assert.yml file and run it once on localhost
  import_tasks: assert.yml
  loop: null
  changed_when: false

- name: Task 2: Install the git package using the specified packages and state
  become: true
  package:
    name: git
    state: present

- name: Task 3: Verify if the specified user exists without failing if the user is not found
  become: true
  user:
    name: "{{ remote_user }}"
    state: present
    shell: /bin/bash
    groups: "{{ groups }}"
    home: "{{ homedir }}"
    create_home: yes

- name: Task 4: Create a directory for git configuration in the user's home directory with specific permissions
  become: true
  file:
    path: "~/.git/config.d/"
    state: directory
    owner: "{{ remote_user }}"
    group: "{{ group_name }}"
    mode: '0755'

- name: Task 5: Template the git configuration file in the user's home directory with specified permissions
  become: true
  template:
    src: templates/gitconfig
    dest: ~/.git/config
    owner: "{{ remote_user }}"
    group: "{{ group_name }}"
    mode: '0644'

- name: Task 6: Create the destination directory for git repositories with specific permissions
  become: true
  file:
    path: "/home/{{ remote_user }}/repos/"
    state: directory
    owner: "{{ remote_user }}"
    group: "{{ group_name }}"
    mode: '0755'

- name: Task 7: Clone multiple git repositories from a list with specified destinations, versions, and user permissions
  become: true
  git:
    repo: "{{ item.url }}"
    dest: "{{ item.destination }}"
    branch: "{{ item.branch }}"
    version: "{{ item.version }}"
    with_keys: "{{ item.keyfile }}"
    remote: origin
    update: yes
    clone: yes
  with_items: "{{ repositories }}"


