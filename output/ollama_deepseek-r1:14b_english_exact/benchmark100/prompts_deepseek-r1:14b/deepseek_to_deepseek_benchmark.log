---
- import_tasks: assert.yml
  loop: ['localhost']

- name: Install required packages
  apt:
    name: "{{ item }}"
    state: present
  with_items: service_required_packages
  notify: Gather facts

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: /etc/systemd/system/{{ item.name }}.service
  with_items: service_list
  notify: systemctl

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: /etc/init.d/{{ item.name }}
  with_items: service_list
  notify: sysvinit

- name: Manage service
  service:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    enabled: "{{ item.enabled }}"
    restarted: yes
  with_items: service_list
  notify: systemctl

- name: Flush handlers
  meta:
    flush_handlers: true


