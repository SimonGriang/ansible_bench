tasks:
  - name: Task 1: Import assertion tasks (localhost)
    ansible.builtin.import_tasks:
      file: assert.yml
      host: localhost

  - name: Task 2: Install OpenVPN packages
    ansible.builtin.package:
      name: "{{ openvpn_packages }}"

  - name: Task 3: Setup OpenVPN server
    ansible.builtin.import_tasks:
      file: openvpn-server.yml
    when: openvpn_role == "server"
    become: yes

  - name: Task 4: Setup OpenVPN client
    ansible.builtin.import_tasks:
      file: openvpn-client.yml
    when: openvpn_role == "client"
    become: yes

  - name: Task 4: Start and enable OpenVPN service
    ansible.builtin.service:
      name: "{{ openvpn_service }}"
      state: started
      enabled: yes

