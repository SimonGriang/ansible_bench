---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  when: false

- name: Configure apk
  apk:
    cmd: upgrade
    cache: true
    state: present
  changed_when: false

- name: Configure apt
  apt:
    upgrade: none
    state: present
    force_apt_get: yes
  changed_when: false

- name: Update all software (dnf)
  dnf:
    name: '*'
    state: latest
    exclude: ["chrony", "ntp"]
    update_cache: true

- name: Update all software (pacman)
  pacman:
    sync: all
    latest: yes
    update_cache: yes

- name: Configure yum (for versions <6)
  apt:
    name: yum
    state: present
  when: ansible_distribution_version | version | int < 6

- name: Install yum-utils (for versions <6)
  yum:
    name: yum-utils
    state: present
  when: ansible_distribution_version | version | int < 6

- name: Update all software (dnf, for versions >=6)
  dnf:
    name: '*'
    state: latest
  when: ansible_distribution_version | version | int >= 6

- name: Update all software (zypper)
  zypper:
    name: '*'
    state: latest
    update_cache: yes


