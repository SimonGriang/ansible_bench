---
- name: Download RKE2 kubeconfig to localhost
  fetch:
    src: /etc/rke2/config.yaml
    dest: /tmp/kubeconfig
    state: present
    flat: true

- name: Replace loopback IP by master server IP
  replace:
    path: /tmp/kubeconfig
    regex: 127\.0\.0\.1
    replacement: "{{ master_ip }}"
    backslashed: true


