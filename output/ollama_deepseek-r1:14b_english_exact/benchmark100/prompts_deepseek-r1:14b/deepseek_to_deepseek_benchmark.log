d_data_directory if httpd_remove_example is true.\n  file:\n    path: "{{ httpd_data_directory }}/example.html"\n    state: absent\n  when: httpd_remove_example\n\n- name: Task 13: Start and enable Apache HTTPD service named httpd_service.\n  service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: true\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-19T17:15:09.257557439Z', 'done': True, 'done_reason': 'stop', 'total_duration': 32467138623, 'load_duration': 88548377, 'prompt_eval_count': 1751, 'prompt_eval_duration': 15196929, 'eval_count': 1451, 'eval_duration': 32362536016, 'model_name': 'deepseek-r1:14b'} id='run--79770fb7-9b28-47ad-9a40-99120782b884-0' usage_metadata={'input_tokens': 1751, 'output_tokens': 1451, 'total_tokens': 3202}
