---
- name: Import assert.yml
  import_tasks:
    file: assert.yml
    remote_host: localhost
    state: present

- name: Install using package
  shell: 
    cmd: "if ! dpkg -l | grep -qw {{ hashicorp_product }}; then apt-get install -y {{ hashicorp_product }}; fi"
    chdir: /tmp
  changed_when: false
  remote_user: root

- name: Configure debian
  apt_key:
    keyserver: keyserver.ubuntu.com
    key: 15DE44D02BB1F7F8
    state: present
  apt_repository:
    repo: "deb https://apt.releases.hashicorp.com/{{ ansible_facts['distribution'] }}/"
    state: present
  apt:
    update_cache: true
  remote_user: root

- name: Install hashicorp product using package
  apt:
    name: "{{ hashicorp_product }}"
    state: present
    version: "{{ hashicorp_version | default('latest') }}"
  remote_user: root

- name: Install manually
  file:
    path: "{{ hashicorp_install_path }}"
    state: directory
    mode: 0755
  command:
    cmd: "{{ hashicorp_download_url }}/latest/{{ hashicorp_product }}_{{ hashicorp_version }}_{{ ansible_architecture }}.tar.gz"
    creates: "{{ hashicorp_install_path }}/{{ hashicorp_product }}.tar.gz"
  remote_user: root


