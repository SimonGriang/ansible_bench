e-check that all registered variables are correctly named and that the modules used are appropriate for each task.\n\nLet me put it all together step by step, making sure each task is correctly implemented and adheres to the instructions.\n</think>\n\n```yaml\n---\n- name: Check if Helm binary exists\n  stat:\n    path: /usr/local/bin/helm\n  register: helm_check\n\n- name: Check Helm version\n  shell: helm version\n  register: helm_existing_version\n  ignore_errors: yes\n\n- name: Download helm\n  unarchive:\n    remote_src: yes\n    url: https://get.helm.sh/helm-{{ helm_version }}-linux-amd64.tar.gz\n    dest: /usr/local/bin/\n    remote_src: yes\n  register: helm_download\n  when: helm_check.stat不存在 or helm_existing_version.stdout_lines[0].split()[1] != "v3.12.0"\n\n- name: Copy helm binary into place\n  copy:\n    remote_src: yes\n    src: /usr/local/bin/helm\n    dest: /usr/local/bin/helm\n    mode: 0755\n    owner: root\n    group: root\n  when: helm_download is successful\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-19T16:36:41.462639279Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13944891577, 'load_duration': 80683378, 'prompt_eval_count': 411, 'prompt_eval_duration': 124815351, 'eval_count': 688, 'eval_duration': 13738178749, 'model_name': 'deepseek-r1:14b'} id='run--c7b7d375-4d3a-473f-93be-91e82e77c297-0' usage_metadata={'input_tokens': 411, 'output_tokens': 688, 'total_tokens': 1099}
