---
- name: Generate a private SSL key using OpenSSL
  shell: openssl genrsa -out /etc/nginx/ssl/nginx.key 2048
  args:
    chdir: /etc/nginx/ssl
  vars:
    group: nginx
    mode: 0600

- name: Generate a Certificate Signing Request (CSR)
  shell: openssl req -new -key /etc/nginx/ssl/nginx.key -out /etc/nginx/ssl/nginx.csr -subj "/C=US/ST=SomeState/L=SomeCity/O=SomeOrganization/CN=example.com"
  args:
    chdir: /etc/nginx/ssl
  vars:
    mode: 0604

- name: Generate a self-signed SSL certificate
  shell: openssl x509 -req -days 365 -in /etc/nginx/ssl/nginx.csr -signkey /etc/nginx/ssl/nginx.key -out /etc/nginx/ssl/nginx.crt
  args:
    chdir: /etc/nginx/ssl
  vars:
    mode: 0604

- name: Create a PKCS#12 file
  shell: openssl pkcs12 -export -out /etc/nginx/ssl/nginx.p12 -inkey /etc/nginx/ssl/nginx.key -cert /etc/nginx/ssl/nginx.crt
  args:
    chdir: /etc/nginx/ssl
  vars:
    mode: 0604
  become: yes

- name: Read the private key content
  slurp:
    remote_src: yes
    src: /etc/nginx/ssl/nginx.key
  register: private_key_content
  become: yes

- name: Read the certificate content
  slurp:
    remote_src: yes
    src: /etc/nginx/ssl/nginx.crt
  register: certificate_content
  become: yes

- name: Combine private key and certificate into a single file
  copy:
    content: "{{ private_key_content | b64decode() }}\n{{ certificate_content | b64decode() }}"
    dest: /etc/nginx/ssl/nginx.pem
    mode: 0604
    remote_src: no


