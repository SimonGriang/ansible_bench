---
- name: Import assert.yml
  include_tasks:
    file: files/assert.yml

- name: Wait for port to be available
  ansible.ports.wait_for_port:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  no_log: yes

- name: Prepare system
  block:
    - name: Test connection
      connection:
        state: present

    - name: Test sudo access
      command: whoami
      args:
        executable: sudo
      changed_when: false
      failed_when: false

  rescue:
    - name: Gather facts on failure
      setup:
        gather_subset: all

    - name: Install basic packages with raw
      raw: "{{ bootstrap_raw_packages | join(' ') }}"
      changed_when: false
      no_log: yes

    - name: Install libdnf5 on RedHat systems
      when: ansible_distribution == "RedHat"
      raw: "{{ libdnf5_install_cmd }}"
      changed_when: false
      no_log: yes

- name: Gather ansible facts
  ansible.localhost.setup:
    gather_subset: all
  no_log: yes

- name: Install bootstrap packages
  ansible.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"


