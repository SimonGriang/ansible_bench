---
- name: hardening | Disable swap
  ansible.builtin.swap:
    state: disabled
    persistent: true
  vars:
    vault_hardening_disable_swap: true

- name: hardening | Disable core dumps
  ansible.builtin.sysctl:
    name: fs.suid_dumpable
    value: 0
    state: present
    reboot: no
  vars:
    vault_hardening_disable_core_dumps: true

- name: hardening | Disable Shell Command History
  ansible.builtin.file:
    path: /etc/profile.d/vault.sh
    content: |
      export HISTIGNORE=" vault*"
    state: present
    mode: 0755
  vars:
    vault_hardening_disable_shell_command_history: true

- name: hardening | Configure SELinux / AppArmor
  block:
    - name: Enable and configure SELinux
      ansible.builtin.setsebool:
        name: sysctl_suidsafe
        value: on
        persistent: true

    - name: Install and enable AppArmor profiles
      ansible.builtin.apt:
        name: apparmor-profiles
        state: present
        update_cache: yes

    - name: Enforce AppArmor profiles
      ansible.builtin.file:
        path: /etc/apparmor.d/ Vault
        state: present
        content: |
          /usr/bin/vault CACC,  /etc/apparmor.d/ Vault
        mode: 0755
  vars:
    vault_hardening_configure_selinux_apparmor: true

