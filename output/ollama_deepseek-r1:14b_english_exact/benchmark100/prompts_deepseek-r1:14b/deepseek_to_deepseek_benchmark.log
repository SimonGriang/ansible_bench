---
- name: Check if Java certificates exist
  file:
    path: "{{ item.path }}"
    state: absent
  loop: "{{ java_certs }}"
  register: certificates
  changed_when: false
  failed_when: false

- name: Fail if Java certificates are missing
  fail:
    msg: "Missing Java certificate at {{ item.path }}"
  loop: "{{ java_certs }}"
  when: item.state == 'absent'

- name: Set keystore directory for Java versions less than 11
  set_fact:
    java_keystore_dir: "{{ java_legacy_keystore_dir }}"
  when: ansible.java_version < "11"

- name: Set keystore directory for Java versions 11 or newer
  set_fact:
    java_keystore_dir: "{{ java_new_keystore_dir }}"
  when: ansible.java_version >= "11"

- name: Import SSL certificates into Java keystore
  command: "{{ JAVA_HOME }}/bin/keytool -importcert -file {{ item.path }} -alias {{ item.alias }} -keystore {{ java_keystore_dir }}/{{ item.keystore_name }} -storepass {{ item.store_password }} -keypass {{ item.key_password }}"
  args:
    chdir: "{{ JAVA_HOME }}"
  loop: "{{ java_certs }}"
  create_remote_tmp: yes


