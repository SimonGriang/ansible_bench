---
- name: Import assertion file
  import_tasks: assert.yml
  host: localhost
  become: yes

- name: Install cron packages
  apt:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell
  cron:
    name: SHELL
    value: /bin/bash
  notify: restart cron service

- name: Configure cron path
  cron:
    name: PATH
    value: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  notify: restart cron service

- name: Configure cron mailto
  cron:
    name: MAILTO
    value: "{{ cron_mailto }}"
  notify: restart cron service

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ""

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    cron_file: cron_jobs
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
  loop: "{{ cron_jobs }}"


