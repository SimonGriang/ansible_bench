---
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: temurin
  when: ansible_facts.packages.adoptopenjdk is defined

- name: Gather OS specific variables
  include_vars:
    file: "{{ java_jdk_vendor }}/os/{{ ansible_distribution|lower() }}/{{ ansible_distribution_version|lower() }}.yaml"
  when: java_jdk_vendor is defined

- name: Gather architecture specific variables
  include_vars:
    file: "{{ ansible_architecture }}.yaml"

- name: Set OS specific variables (I)
  set_fact:
    java_openjdk_version: "{{ openjdk_version }}"
    java_openjdk_repo: "{{ openjdk_repository }}"
    java_openjdk_libs: "{{ openjdk_libs }}"
  vars:
    openjdk_version: "17"
    openjdk_repository: "https://example.com/repo"
    openjdk_libs: "libc6,libc++6"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_openjdk_install_path: "/usr/lib/jvm/{{ java_openjdk_version }}"
    java_openjdk_package: "openjdk-{{ java_openjdk_version }}-jdk"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_openjdk_install_path }}"

- name: Debian pre-requisites
  when: ansible_os_family == "Debian"
  apt:
    name:
      state: present
      include:
        - apt-transport-https
        - ca-certificates
    update_cache: yes

- name: RedHat pre-requisites
  when: ansible_os_family == "RedHat"
  yum:
    name:
      state: present
      include:
        - https://example.com/rhel.repo
    update_cache: yes

- name: Install required libs
  when: ansible_os_family in ["Debian", "RedHat"]
  apt:
    name:
      state: present
      include:
        - libgcc1
        - libstdc++6
  yum:
    name:
      state: present
      include:
        - libgcc
        - libstdc++11

- name: Install Java, Debian
  when: ansible_os_family == "Debian"
  apt:
    name: "{{ java_openjdk_package }}"
    state: present

- name: Install Java, RedHat
  when: ansible_os_family == "RedHat"
  yum:
    name: "{{ java_openjdk_package }}"
    state: present

- name: Export environment variables
  file:
    path: /etc/profile.d/java.sh
    content: |
      export JAVA_HOME="{{ java_home }}"
      export PATH="$JAVA_HOME/bin:$PATH"

- name: Source environment variables
  shell: source /etc/profile.d/java.sh

- name: Correct java version selected for Java < 11
  command: alternatives --install /usr/bin/java "{{ java_openjdk_version }}-jre" "/usr/lib/jvm/{{ java_openjdk_version }}/jre/bin/java" 100
  when: (java_openjdk_version|int) < 11

- name: Correct java version selected for Java >= 11
  command: alternatives --install /usr/bin/java "{{ java_openjdk_version }}" "/usr/lib/jvm/{{ java_openjdk_version }}/bin/java" 200
  when: (java_openjdk_version|int) >= 11

