de_tasks or import_tasks if needed, but since this is a main.yml, it should be directly included. I\'ll make sure each task has a name and uses the correct modules with their parameters.\n\nFinally, I\'ll ensure all tasks are in the right order and that the conditions are applied where necessary. I\'ll double-check the YAML syntax to make sure there are no errors and that it adheres to the specified standards.\n</think>\n\n```yaml\n---\n- name: Remove old Docker versions\n  yum:\n    name: "{{ docker_obsolete_packages }}"\n    state: absent\n\n- name: Add Docker GPG key\n  rpm:\n    key: "{{ docker_yum_gpg_key }}"\n    state: present\n  when: docker_add_repo\n\n- name: Add Docker repository\n  get_url:\n    url: "{{ docker_yum_repo_url }}"\n    dest: /etc/yum.repos.d/docker-{{ docker_edition }}.repo\n    mode: 0644\n    owner: root\n    group: root\n  when: docker_add_repo\n\n- name: Configure Docker Nightly repo\n  yum:\n    repo: /etc/yum.repos.d/docker-{{ docker_edition }}.repo\n    state: enabled\n    enablerepo: docker-{{ docker_edition }}-nightly\n  when: docker_yum_repo_enable_nightly and docker_add_repo\n\n- name: Configure Docker Test repo\n  yum:\n    repo: /etc/yum.repos.d/docker-{{ docker_edition }}.repo\n    state: enabled\n    enablerepo: docker-{{ docker_edition }}-test\n  when: docker_yum_repo_enable_test and docker_add_repo\n\n- name: Configure containerd on RHEL 8\n  block:\n    - name: Remove runc package\n      apt:\n        name: runc\n        state: absent\n        purge: yes\n        force: yes\n\n    - name: Ensure container-selinux is installed\n      yum:\n        name: container-selinux\n        state: present\n\n    - name: Ensure containerd.io is installed\n      yum:\n        name: containerd.io\n        state: present\n  when: ansible_facts.distribution_major_version == 8\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-19T16:05:50.374886773Z', 'done': True, 'done_reason': 'stop', 'total_