---

- name: Import assert.yml
  import_tasks: assert.yml
  args:
    delegate_to: localhost

- name: Install apache httpd
  apt:
    name: "{{ item }}"
    state: present
    update_cache: yes
  with_items: "{{ httpd_packages }}"
  become: yes
  when: ansible_distribution in ['Ubuntu', 'Debian']

- name: Configure selinux
  selinux:
    state: "{{ selinux_enabled | default('disabled') }}"
    boolean: "{{ item }}"
  with_items: "{{ selinuxBOOLEANS | default([]) }}"
  when: selinux_enabled | default('disabled') == 'enabled'

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: "0644"
  notify: httpd_config_test
  notify: httpd_restart

- name: Activate httpd module | Debian
  command: a2enmod "{{ item }}"
  with_items: "{{ httpd_modules | default([]) }}"
  when: ansible_distribution in ['Ubuntu', 'Debian']
  args:
    state: present

- name: Import ssl.yml
  import_tasks: ssl.yml

- name: Import locations.yml
  import_tasks: locations.yml

- name: Import vhosts.yml
  import_tasks: vhosts.yml

- name: Configure ports
  template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
    mode: "0644"
  notify: httpd_config_test
  notify: httpd_restart
  when: ansible_distribution in ['Ubuntu', 'Debian', 'SLES', 'openSUSE']

- name: Import directories.yml
  import_tasks: directories.yml

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ apache_default_html }}"
    state: absent
  when: httpd_remove_example | default('no') == 'yes'

- name: Start and enable httpd
  service:
    name: "{{ httpd_service_name }}"
    state: started
    enabled: yes
  become: yes


