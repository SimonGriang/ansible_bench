---
- name: Import assertion file
  import_tasks:
    file: assert.yml
    host: localhost

- name: Install system requirements
  apt:
    name: bash
    state: present

- name: Install OpenJDK Java
  apt:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"

- name: Install Oracle Java RPM from local
  apt:
    name: "{{ java_package_rpm }}"
    state: present
  when: java_source == "local" and java_format == "rpm"

- name: Install Oracle Java DEB from local
  apt:
    name: "{{ java_package_deb }}"
    state: present
  when: java_source == "local" and java_format == "deb"

- name: Install Oracle Java RPM from repository
  apt:
    name: "{{ java_package_rpm_repository }}"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Java targz installation
  become: yes
  become_flags: u=root
  become_method: sudo
  block:
    - name: Extract and install Oracle Java targz package
      archive:
        path: "{{ java_package_targz_path }}"
        dest: /usr/local
        extrabuffer: "tar xf"
      register: java_installation
    - name: Install Java package
      shell: "{{ java_installation.path }}/install.sh"
    when: java_format == "targz" and java_vendor == "oracle"

- name: Install Oracle Java JCE policy
  become: yes
  become_flags: u=root
  become_method: sudo
  block:
    - name: Extract JCE files
      unzip:
        remote_src: no
        file: "{{ java_jce_policy_path }}"
        dest: "{{ java_home }}/jre/lib/security"
  when: java_jce and java_version == 8 and java_vendor == "oracle"

- name: Set Java alternative
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    state: present
  when: java_format == "targz" and distribution != "Alpine"

- name: Find Java home directory
  shell: which -a java | awk '{print $1}' | xargs readlink -f
  register: java_home
  when: java_format == "targz"

- name: Set JAVA_HOME in environment
  file:
    path: /etc/profile.d/java_home.sh
    content: export JAVA_HOME="{{ java_home.stdout }}"
    mode: 0755
    state: present


