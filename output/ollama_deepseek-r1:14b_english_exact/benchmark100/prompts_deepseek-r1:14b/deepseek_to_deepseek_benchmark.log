---
- name: Install EPEL on compatible systems
  ansible.builtin.yum:
    name: "{{ epel_url }}"
    state: present
  become: true
  when: ansible_os_family in ['RedHat', 'Amazon']

- name: Install EPEL GPG key
  ansible.module.utils.rpm_key:
    key_content: "{{ epepgpgkey | default('https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-2') }}"
    state: present
    user: root

- name: Install EPEL-release package
  ansible.builtin.yum:
    name: "{{ epel_url }}"
    state: present
  become: true

- name: Install EPEL-next-release package
  ansible.builtin.yum:
    name: "{{ epel_next_url }}"
    state: present
  become: true
  when: epel_next | default(false)

- name: Update package cache
  ansible.builtin.apt:
    update_cache: yes
  become: true


