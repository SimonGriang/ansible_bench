---
- name: Remove Docker GPG key from trusted.gpg.d directory
  file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Remove old Docker source list from sources.list.d directory
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Remove obsolete Docker packages
  apt:
    name: "{{ ['docker-engine', 'docker.io', 'docker'] }}"
    state: absent
    purge: yes
    remove: yes

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install required dependencies
  apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: installed

- name: Manage Docker repository
  deb822_repository:
    filename: "{{ item.repository_file | default('/etc/apt/sources.list.d/docker.list') }}"
    state: "{{ item.state | default('absent') }}"
    file_mode: "{{ item.file_mode | default('644') }}"
    content: |
      deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] \
        https://download.docker.com/linux/ubuntu jammy stable
  vars:
    repositories:
      - repo: "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu jammy stable"
        repo_file: "docker.list"
        repo_state: present
        file_mode: 644
        key_file: "docker-archive-keyring.gpg"
        key_source: "https://download.docker.com/linux/ubuntu/gpg"
  when: docker_add_repo | bool

- name: Flush handlers to update apt cache
  apt:
    update_cache: yes


