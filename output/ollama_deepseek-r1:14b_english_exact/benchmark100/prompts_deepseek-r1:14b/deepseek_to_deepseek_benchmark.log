---
- name: Check if Python is installed
  action: shell which python
  ignore_errors: true

- name: Check if Python3 is installed
  action: shell which python3
  ignore_errors: true

- name: Debug Python executable path
  debug:
    msg: "Python executable path: {{ (ansible_python.path|default('not found')) }}"
  register: python_path
  changed_when: false
  failed_when: false

- name: Debug Python3 executable path
  debug:
    msg: "Python3 executable path: {{ (ansible_python3.path|default('not found')) }}"
  register: python3_path
  changed_when: false
  failed_when: false

- name: Import assert.yml
  include_tasks: assert.yml
  loop: "{{ openssl_items | default([]) }}"
  loop_control:
    loop_var: item

- name: Install requirements
  apt:
    name: "{{ item }}"
    state: installed
  loop: "{{ openssl_requirements | default([]) }}"
  loop_control:
    loop_var: item

- name: Ensure packaging is available via dnf
  apt:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    requirements:
      - "{{ item }}"
  loop: "{{ openssl_pip_packages | default([]) }}"
  loop_control:
    loop_var: item

- name: Create key directory
  file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: "{{ openssl_key_permissions | default('0755') }}"
    owner: "{{ openssl_key_owner | default('root') }}"

- name: Create csr directory
  file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: "{{ openssl_csr_permissions | default('0755') }}"
    owner: "{{ openssl_csr_owner | default('root') }}"

- name: Create crt directory
  file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: "{{ openssl_crt_permissions | default('0755') }}"
    owner: "{{ openssl_crt_owner | default('root') }}"

- name: Include create.yml
  include_tasks: create.yml
  loop: "{{ openssl_items | default([]) }}"
  loop_control:
    loop_var: item


