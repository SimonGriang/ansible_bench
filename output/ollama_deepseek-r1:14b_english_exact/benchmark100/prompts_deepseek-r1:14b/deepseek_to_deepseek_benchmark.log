---
- name: Add Docker users to the docker group
  user:
    name: "{{ item }}"
    groups: docker
    state: present
  with_items: "{{ docker_users }}"

- name: Reset SSH connection after user changes
  command: echo -e "Connection: close\r\n\r\n" | telnet localhost 22
  register: ssh_reset
  ignore_errors: yes

- name: Ensure SSH service is restarted
  service:
    name: sshd
    state: restarted

