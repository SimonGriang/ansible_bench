th the right permissions.\n\nI need to ensure all modules are used correctly, owners are set to the user, and permissions are as specified. Also, each task should be in the exact order provided. I\'ll structure each task with a name, module, and arguments, making sure the YAML is valid.\n</think>\n\n```yaml\n---\n- name: Create local SSH key directory for user\n  file:\n    path: /home/user/.ssh\n    state: directory\n    owner: user\n    mode: 0750\n\n- name: Manage user account\n  user:\n    name: user\n    state: present\n    comment: "User Account"\n    home: /home/user\n    shell: /bin/bash\n\n- name: Set sudo options for user\n  lineinfile:\n    path: /etc/sudoers.d/user\n    line: user ALL=(ALL) NOPASSWD:ALL\n    state: present\n    mode: \'0o440\'\n\n- name: Generate private SSH key for user\n  command: ssh-keygen -q -t rsa -f /home/user/.ssh/id_rsa -N ""\n  changed_when: false\n  ignore_errors: yes\n\n- name: Generate public SSH key for user\n  command: ssh-keygen -q -t rsa -f /home/user/.ssh/id_rsa -N "" -y -f /home/user/.ssh/id_rsa.pub\n  changed_when: false\n  ignore_errors: yes\n\n- name: Convert SSH key to ppk format for user\n  shell: ssh-keygen -i -f /home/user/.ssh/id_rsa.pub -o /home/user/.ssh/id_rsa.ppk\n  changed_when: false\n  ignore_errors: yes\n\n- name: Get or set the home directory for user\n  shell: echo "home directory: $(stat -c %d /home/user)"\n  changed_when: false\n  ignore_errors: yes\n\n- name: Create .ssh directory for user\n  file:\n    path: /home/user/.ssh\n    state: directory\n    owner: user\n    mode: 0700\n\n- name: Deploy authorized keys for user\n  authorized_key:\n    user: user\n    key: "{{ lookup(\'file\', \'/home/user/.ssh/id_rsa.pub\') }}"\n\n- name: Remove unauthorized keys for user\n  file:\n    path: /home/user/.ssh/authorized_keys\n    state: touch\n    owner: user\n    mode: 0600\n\n- name: Copy generated private SSH key for user\n  copy:\n    remote_src: true\n    src: /home/user/.ssh/id_rsa\n    dest: /home/user/.ssh/id_rsa\n    owner: user\n    mode: 0600\n\n- name: Check users password valid time for user\n  shell: chage -l user | grep "Password expires"\n  changed_when: false\n  ignore_errors: yes\n\n- name: Set users password valid time for user\n  user:\n    name: user\n    password_valid_time: 90\n\n- name: Place private key file for user\n  copy:\n    remote_src: true\n    src: /home/user/.ssh/id_rsa\n    dest: /home/user/.ssh/id_rsa\n    owner: user\n    mode: 0600\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-19T17:26:06.122997785Z', 'done': True, 'done_reason': 'stop', 'total_duration': 25477298710, 'load_duration': 87193130, 'prompt_eval_count': 731, 'prompt_eval_duration': 380649472, 'eval_count': 1152, 'eval_duration': 25008495603, 'model_name': 'deepseek-r1:14b'} id='run--21558b19-f65f-4033-9d81-7bb3da4dfa16-0' usage_metadata={'input_tokens': 731, 'output_tokens': 1152, 'total_tokens': 1883}
