---
- name: Task 1: Install EPEL repository
  loop:
    - "{{ epel_url }}"
  when:
    - ansible_distribution in ['RedHat', 'CentOS'] and ansible_distribution_version in ['7', '8', '9']
    - ansible_distribution == 'Amazon' and ansible_distribution_version == '2'
  dnf:
    name: "{{ item }}"
    state: present
    repo: epel
    update_cache: yes
  notify: Update package cache

- name: Task 2: Install EPEL GPG key
  shell: echo "{{ epel_gpg_key }}" > /etc/pki/rpm-gpg/epel.gpg && chmod 644 /etc/pki/rpm-gpg/epel.gpg
  notify: Update package cache

- name: Task 3: Install EPEL release package
  dnf:
    name: "{{ epel_url }}"
    state: present
    update_cache: yes
  notify: Update package cache

- name: Task 4: Install EPEL next release package (conditional)
  dnf:
    name: "{{ epel_next_url }}"
    state: present
    update_cache: yes
  when: epel_next | bool
  notify: Update package cache

