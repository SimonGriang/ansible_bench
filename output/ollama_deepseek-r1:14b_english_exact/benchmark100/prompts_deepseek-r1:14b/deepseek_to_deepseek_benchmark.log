---
- name: Include OS-specific variables
  include_vars:
    file: "{{ item }}"
    with_items: >
      {{ lookup('fileglob', 'vars/*_{{ ansible_distribution|lower() }}.yml', wantlist=True)
            + lookup('fileglob', 'vars/*_{{ ansible_os_family|lower() }}.yml', wantlist=True) }}

- name: Include OS family specific tasks
  block:
    - name: Include RedHat-based tasks
      include_tasks: tasks/redhat/main.yml
      when: ansible_os_family == "RedHat"

    - name: Include Debian-based tasks
      include_tasks: tasks/debian/main.yml
      when: ansible_os_family == "Debian"

- name: Install Docker packages
  block:
    - name: Install Docker packages
      apt:
        name: "{{ docker_packages }}"
        state: "{{ docker_packages_state }}"
      when: ansible_version < "2.12" or (ansible_os_family not in ["RedHat", "Debian"])
      become: true
      notify: restart docker
      ignore_errors: true
      changed_when: false

    - name: Install Docker packages
      yum:
        name: "{{ docker_packages }}"
        state: "{{ docker_packages_state }}"
      when: ansible_version < "2.12" and ansible_os_family in ["RedHat", "Debian"]
      become: true
      notify: restart docker
      ignore_errors: true
      changed_when: false

- name: Install Docker packages with downgrade option
  block:
    - name: Install Docker packages with downgrade
      apt:
        name: "{{ docker_packages }}"
        state: "{{ docker_packages_state }}"
        version: "{{ docker_packages_downgrade_version }}"
      when: ansible_version >= "2.12" and ansible_os_family in ["RedHat", "Debian"]
      become: true
      notify: restart docker
      ignore_errors: true
      changed_when: false

    - name: Install Docker packages with downgrade
      yum:
        name: "{{ docker_packages }}"
        state: "{{ docker_packages_state }}"
        version: "{{ docker_packages_downgrade_version }}"
      when: ansible_version >= "2.12" and ansible_os_family in ["RedHat", "Debian"]
      become: true
      notify: restart docker
      ignore_errors: true
      changed_when: false

- name: Install docker-compose plugin
  block:
    - name: Install docker-compose plugin
      apt:
        name: "{{ docker_compose_package }}"
        state: "{{ docker_compose_package_state }}"
      when: docker_install_compose_plugin and ansible_version < "2.12" and (ansible_os_family not in ["RedHat", "Debian"])
      become: true
      notify: restart docker
      ignore_errors: true
      changed_when: false

    - name: Install docker-compose plugin
      yum:
        name: "{{ docker_compose_package }}"
        state: "{{ docker_compose_package_state }}"
      when: docker_install_compose_plugin and ansible_version < "2.12" and ansible_os_family in ["RedHat", "Debian"]
      become: true
      notify: restart docker
      ignore_errors: true
      changed_when: false

- name: Install docker-compose-plugin with downgrade option
  block:
    - name: Install docker-compose-plugin with downgrade
      apt:
        name: "{{ docker_compose_package }}"
        state: "{{ docker_compose_package_state }}"
        version: "{{ docker_compose_package_downgrade_version }}"
      when: docker_install_compose_plugin and ansible_version >= "2.12" and ansible_os_family in ["RedHat", "Debian"]
      become: true
      notify: restart docker
      ignore_errors: true
      changed_when: false

    - name: Install docker-compose-plugin with downgrade
      yum:
        name: "{{ docker_compose_package }}"
        state: "{{ docker_compose_package_state }}"
        version: "{{ docker_compose_package_downgrade_version }}"
      when: docker_install_compose_plugin and ansible_version >= "2.12" and ansible_os_family in ["RedHat", "Debian"]
      become: true
      notify: restart docker
      ignore_errors: true
      changed_when: false

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    state: directory
    mode: 0755
  when: docker_daemon_options is not none

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options | to_json }}"
    dest: /etc/docker/daemon.json
    mode: 0644
  when: docker_daemon_options is not none
  notify: restart docker

- name: Ensure Docker service is started and enabled
  service:
    name: "{{ docker_service_name }}"
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  when: docker_service_manage
  ignore_errors: true
  become: true

- name: Flush handlers to avoid firewall conflicts
  shell: ansible-playbook --flush-handlers
  args: "--flush-handlers"

- name: Include docker-compose.yml tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group information
  shell: getent group docker
  register: docker_group_info
  when: docker_users is not empty

- name: Set fact for user modification
  set_fact:
    users_need_modification: >
      {{ (docker_group_info|is_empty or (docker_users|map('join', [docker_group_info.gid])|difference(docker_group_info.mem))|list|length > 0 }}

- name: Include docker-users.yml tasks
  include_tasks: docker-users.yml
  when: users_need_modification


