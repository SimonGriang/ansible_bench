dest: "{{ item.path }}"\n    mode: "0644"\n    owner: "{{ dns_owner }}"\n    group: "{{ dns_group }}"\n  with_items: "{{ dns_zones }}"\n  notify: Restart dns\n\n- name: Task 11: Place systemd override\n  copy:\n    src: "{{ systemd_override_src }}"\n    dest: "{{ systemd_override_dest }}"\n    mode: "0644"\n  when: ansible_distribution == \'Ubuntu\'\n  notify: systemd-reload\n\n- name: Task 12: Start and enable dns\n  service:\n    name: "{{ dns_service }}"\n    state: started\n    enabled: yes' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-19T15:45:29.513487878Z', 'done': True, 'done_reason': 'stop', 'total_duration': 24039613409, 'load_duration': 84344511, 'prompt_eval_count': 1158, 'prompt_eval_duration': 61642781, 'eval_count': 1049, 'eval_duration': 23892321177, 'model_name': 'deepseek-r1:14b'} id='run--c7d56fb9-62ab-4cd3-af32-b363143fee6c-0' usage_metadata={'input_tokens': 1158, 'output_tokens': 1049, 'total_tokens': 2207}  9%|▉         | 9/100 [19:29<3:45:21, 148.59s/it]
