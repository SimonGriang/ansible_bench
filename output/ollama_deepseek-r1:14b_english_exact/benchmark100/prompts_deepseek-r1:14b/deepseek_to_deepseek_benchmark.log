---
- name: Import assertion tasks
  import_tasks:
    file: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install Docker Compose package
  package:
    name: docker-compose
    state: present
  when: installation_type == "package"

- name: Install Docker Compose binary
  apt:
    name: "{{ item }}"
    state: present
  with_items:
    - python3
    - curl
  when: installation_type == "binary"

- name: Download Docker Compose binary
  get_url:
    url: https://github.com/docker/compose/releases/download/v2.20.0/
    dest: /usr/local/bin/docker-compose
    mode: '0755'
  when: installation_type == "binary"

- name: Make Docker Compose binary executable
  file:
    path: /usr/local/bin/docker-compose
    mode: 0755
    state: file
  when: installation_type == "binary"

