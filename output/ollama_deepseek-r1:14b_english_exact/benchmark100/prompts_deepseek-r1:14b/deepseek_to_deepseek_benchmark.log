---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
    state: started
  skip_if: "{{ 'docker' in ansible_connection or 'container' in ansible_connection }}"

- name: Prepare system
  shell: whoami && sudo --version
  become: "{{ bootstrap_become }}"
  register: sudo_test
  ignore_errors: yes
  changed_when: false
  rescue:
    - name: Gather facts after failure
      setup:
        gather_subset: minimal
      become: false
    - name: Install bootstrap packages
      apt:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      when: ansible_distribution == "Ubuntu"
      vars:
        ansible_python_interpreter: /usr/bin/python3
      become: "{{ bootstrap_become }}"
      ignore_errors: yes
    - name: Install bootstrap packages
      yum:
        name: "{{ bootstrap_facts_packages }}"
        state: present
      when: ansible_distribution in ["CentOS", "RedHat"]
      become: "{{ bootstrap_become }}"
      ignore_errors: yes

- name: Gather ansible facts
  setup:
    gather_subset: minimal
  become: false

- name: Install bootstrap packages (package)
  shell: "{{ package_manager }} install -y {{ bootstrap_facts_packages | join(' ') }}"
  become: "{{ bootstrap_become }}"


