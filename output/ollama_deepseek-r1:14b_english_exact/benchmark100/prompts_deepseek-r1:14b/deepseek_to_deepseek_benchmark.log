ep by step, ensuring variables are correctly referenced and conditions are applied where needed. I\'ll avoid adding any extra comments or explanations, just the YAML tasks as specified.\n</think>\n\n```yaml\n---\n- name: Import assertion tasks\n  import_tasks:\n    file: assert.yml\n  delegate_to: localhost\n  run_once: true\n\n- name: Install Python pip\n  apt:\n    name: "{{ python_pip_packages }}"\n    state: present\n\n- name: Configure pip proxy settings\n  lineinfile:\n    path: /etc/pip.conf\n    line: index-url = {{ python_pip_proxy }}\n    state: present\n  when: python_pip_proxy is defined\n\n- name: Configure pip trusted hosts\n  lineinfile:\n    path: /etc/pip.conf\n    line: trusted-host = {{ item }}\n    state: present\n  with_items: "{{ python_pip_trusted_host | default(\'\') | split(\',\') | list }}"\n  when: python_pip_trusted_host is defined\n\n- name: Update pip\n  pip:\n    command: upgrade\n    state: present\n  when: ansible_distribution not in [\'bookworm\', \'noble\'] and ansible_os_family not in [\'Alpine\']\n\n- name: Install Python modules\n  pip:\n    name: "{{ item }}"\n    version: "{{ python_pip_modules_version | default(\'\') }}"\n    state: present\n  with_items: "{{ python_pip_modules | default(\'\') | split(\',\') | list }}"\n  when: ansible_distribution not in [\'bookworm\', \'noble\'] and ansible_os_family not in [\'Alpine\']\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-19T17:03:50.926590333Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14911233083, 'load_duration': 87947340, 'prompt_eval_count': 512, 'prompt_eval_duration': 141200486, 'eval_count': 763, 'eval_duration': 14680767244, 'model_name': 'deepseek-r1:14b'} id='run--56f617b5-7f8f-44ca-8b5c-2725521fec77-0' usage_metadata={'input_tokens': 512, 'output_tokens': 763, 'total_tokens': 1275}
