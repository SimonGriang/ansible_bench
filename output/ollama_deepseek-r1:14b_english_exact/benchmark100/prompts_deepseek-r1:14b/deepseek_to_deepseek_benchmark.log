---
- name: gather_facts | Lookup bootstrap facts
  shell: cat /etc/os-release
  register: os_release

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    distribution_name: "{{ lookup('regex', os_release.stdout, 
      pattern='^NAME=\"(.*)\"$', 
      ignore_case=True) }}"
    major_version: "{{ lookup('regex', os_release.stdout, 
      pattern='^VERSION_ID=\"(\d+)\"$', 
      ignore_case=True) }}"

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    os_family: "{{ lookup('list', [
      ('centos', 'redhat'),
      ('redhat', 'redhat'),
      ('ubuntu', 'debian'),
      ('debian', 'debian'),
      ('fedora', 'redhat'),
      ('ol', 'redhat'),
      ('amzn', 'amazon'),
      ('almalinux', 'redhat'),
      ('rocky', 'redhat'),
    ]).value if distribution_name == item.key else '' | 
      regex_replace('^(.*)([0-9]+)$', '\1') }} }}"


