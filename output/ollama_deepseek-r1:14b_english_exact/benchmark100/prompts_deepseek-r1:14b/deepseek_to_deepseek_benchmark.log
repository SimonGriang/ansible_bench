---
- name: Create local SSH key directory for user
  file:
    path: /home/user/.ssh
    state: directory
    owner: user
    mode: 0750

- name: Manage user account
  user:
    name: user
    state: present
    comment: "User Account"
    home: /home/user
    shell: /bin/bash

- name: Set sudo options for user
  lineinfile:
    path: /etc/sudoers.d/user
    line: user ALL=(ALL) NOPASSWD:ALL
    state: present
    mode: '0o440'

- name: Generate private SSH key for user
  command: ssh-keygen -q -t rsa -f /home/user/.ssh/id_rsa -N ""
  changed_when: false
  ignore_errors: true

- name: Generate public SSH key for user
  command: ssh-keygen -q -t rsa -f /home/user/.ssh/id_rsa -N "" -y -f /home/user/.ssh/id_rsa.pub
  changed_when: false
  ignore_errors: true

- name: Convert SSH key to ppk format for user
  shell: ssh-keygen -i -f /home/user/.ssh/id_rsa.pub -o /home/user/.ssh/id_rsa.ppk
  changed_when: false
  ignore_errors: true

- name: Get or set the home directory for user
  shell: echo "home directory: $(stat -c %d /home/user)"
  changed_when: false
  ignore_errors: true

- name: Create .ssh directory for user
  file:
    path: /home/user/.ssh
    state: directory
    owner: user
    mode: 0700

- name: Deploy authorized keys for user
  authorized_key:
    user: user
    key: "{{ lookup('file', '/home/user/.ssh/id_rsa.pub') }}"

- name: Remove unauthorized keys for user
  file:
    path: /home/user/.ssh/authorized_keys
    state: touch
    owner: user
    mode: 0600

- name: Copy generated private SSH key for user
  copy:
    remote_src: true
    src: /home/user/.ssh/id_rsa
    dest: /home/user/.ssh/id_rsa
    owner: user
    mode: 0600

- name: Check users password valid time for user
  shell: chage -l user | grep "Password expires"
  changed_when: false
  ignore_errors: true

- name: Set users password valid time for user
  user:
    name: user
    password_valid_time: 90

- name: Place private key file for user
  copy:
    remote_src: true
    src: /home/user/.ssh/id_rsa
    dest: /home/user/.ssh/id_rsa
    owner: user
    mode: 0600


