 exactly as provided and that the playbook started with \'---\' followed by the tasks. I adhered to YAML formatting standards, ensuring that each task was structured correctly without any additional comments or explanations.\n\nBy following each task\'s instructions meticulously and structuring the playbook to fit within an Ansible Role, I created a valid and compliant Ansible Playbook that meets all the specified requirements.\n</think>\n\n```yaml\n---\n- name: Install EPEL on compatible systems\n  ansible.builtin.yum:\n    name: "{{ epel_url }}"\n    state: present\n  become: true\n  when: ansible_os_family in [\'RedHat\', \'Amazon\']\n\n- name: Install EPEL GPG key\n  ansible.module.utils.rpm_key:\n    key_content: "{{ epepgpgkey | default(\'https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-2\') }}"\n    state: present\n    user: root\n\n- name: Install EPEL-release package\n  ansible.builtin.yum:\n    name: "{{ epel_url }}"\n    state: present\n  become: true\n\n- name: Install EPEL-next-release package\n  ansible.builtin.yum:\n    name: "{{ epel_next_url }}"\n    state: present\n  become: true\n  when: epel_next | default(false)\n\n- name: Update package cache\n  ansible.builtin.apt:\n    update_cache: yes\n  become: true\n```' additional_kwargs={} response_metadata={'model': 'deepseek-r1:14b', 'created_at': '2025-10-19T19:32:41.056595674Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16471441591, 'load_duration': 88825796, 'prompt_eval_count': 506, 'prompt_eval_duration': 153931694, 'eval_count': 719, 'eval_duration': 16227293102, 'model_name': 'deepseek-r1:14b'} id='run--4cacc521-6998-45ed-ac6c-9211ade75500-0' usage_metadata={'input_tokens': 506, 'output_tokens': 719, 'total_tokens': 1225}
