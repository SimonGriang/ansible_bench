---
- name: Assert usage of systemd as an init system
  ansible.builtin.systemctl:
    name: systemd
    state: started
    enabled: yes
  register: systemd_status
  changed_when: false
  ignore_errors: true
  assert:
    that: "'systemd' is in {{ ansible_os_family }}"
    msg: "System must use systemd as the init system"

- name: Get latest release and set promtail version
  github:
    repo: "Grafana/loki"
    path: "releases"
    version: latest
  register: loki_release
  changed_when: false
  set_fact:
    promtail_version: "{{ loki_release.releases[0].tag_name }}"

- name: Test if zip local archive exists and assert local binary exists
  ansible.builtin.path:
    path: "/usr/local/bin/promtail"
    state: absent
  ignore_errors: true
  assert:
    that: "'/usr/local/bin/promtail' exists"
    msg: "Promtail binary must be present in /usr/local/bin"

- name: Get checksum list and set checksum for target architecture
  ansible.builtin.uri:
    url: "https://github.com/Grafana/loki/releases/download/v{{ promtail_version }}/promtail-{{ ansible_architecture }}.checksum.txt"
    method: GET
    status_code: 200
    changed_when: false
  register: promtail_checksum
  ignore_errors: true

