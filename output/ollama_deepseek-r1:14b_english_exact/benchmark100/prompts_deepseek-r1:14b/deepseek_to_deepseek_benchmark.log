---
- name: Include tasks for installing Keepalived when HA mode is enabled
  apt:
    name: keepalived
    state: present
  when: ha_mode

- name: Download and install RKE2
  apt:
    name: rke2
    version: "{{ rke2_version }}"
    state: present
  when: rke2_version is defined

- name: Include tasks for CIS hardening
  include_tasks: cis-hardening.yml
  when: cis_profile is defined

- name: Include tasks to find active server
  shell: kubectl get nodes -o json | jq -r '.items[] | select(.metadata.labels."node-role.kubernetes.io/master" != null) | .status.addresses[] | select(.type == "InternalIP").address'
  register: active_server
  when: ha_mode

- name: Enable IPVS kernel module
  module_name: shell
  args: 
    cmd: modprobe ip_vs
  when: ha_mode

- name: Include tasks to copy kube-vip manifests
  include_tasks: kube-vip.yml
  when: ha_mode

- name: Include tasks to copy ingress-nginx manifests
  include_tasks: ingress-nginx.yml
  when: ingress_nginx_values is defined

- name: Include tasks to prepare the first server node
  shell: ./prepare-first-server.sh
  when: first_server_prepare

- name: Include tasks for etcd restore
  include_tasks: etcd-restore.yml
  when: etcd_restore

- name: Include tasks to download kubeconfig
  fetch:
    src: /etc/kubernetes/admin.conf
    dest: "{{ kubeconfig_dest }}"
    flat: yes
  when: download_kubeconfig

- name: Include tasks to join remaining nodes
  include_tasks: join-nodes.yml
  when: active_server is defined

- name: Include tasks for rolling restart of servers
  include_tasks: rolling-restart.yml
  when: server_nodes_version is changed

- name: Include tasks for rolling restart of agents
  include_tasks: rolling-restart.yml
  when: agent_nodes_version is changed

- name: Flush handlers
  meta: flush_handlers

- name: Include tasks for rolling restart when config changes
  include_tasks: rolling-restart.yml
  when: config_version is changed

- name: Include tasks for final steps
  include_tasks: final-steps.yml


