---
- name: Disable swap now
  command: swapoff -a
  when: ansible_swaptotal_mb > 0

- name: Disable swap permanently
  mount:
    name: "{{ item }}"
    fstype: swap
    opts: noauto
    state: unmounted
  loop: "{{ ansible_mounts | selectattr('fstype', 'equalto', 'swap') | map(attribute='mount') | list }}"
  when: vault_hardening_disable_swap | bool

- name: Set the core dump limits to 0 for all domains
  lineinfile:
    path: /etc/security/limits.d/90-vault.conf
    line: "* soft core 0"
    create: yes
  when: vault_hardening_disable_core_dumps | bool

- name: Disable shell command history
  copy:
    dest: /etc/profile.d/vault_disable_history.sh
    content: |
      export HISTSIZE=0
      export HISTFILESIZE=0
    mode: '0644'
  when: vault_hardening_disable_shell_command_history | bool

- name: Enable and configure SELinux and AppArmor
  block:
    - name: Enable SELinux
      selinux:
        policy: targeted
        state: enforced
      when: ansible_selinux.status == "enabled" and vault_hardening_configure_selinux_apparmor | bool

    - name: Install selinux-policy
      package:
        name: selinux-policy
        state: present

    - name: Set SELinux policy
      selinux:
        policy: targeted
        state: enforced

    - name: Enable AppArmor enforcement for the vault binary
      shell: aa-enforce /etc/apparmor.d/usr.lib.vault.vault
      when: vault_hardening_configure_selinux_apparmor | bool
  when: vault_hardening_configure_selinux_apparmor | bool


