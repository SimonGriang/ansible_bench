        gpgcheck: true
        enabled: true

- name: Configure debian
  block:
    - name: Install required package gpg
      apt:
        name: apt-transport-https
        state: present

    - name: Install apt key for Debian
      apt_key:
        url: "https://apt.releases.hashicorp.com/gpg"
        state: present

    - name: Install repository for Debian
      apt_repository:
        repo: "deb [arch=amd64] https://apt.releases.hashicorp.com {{ ansible_facts['distribution'] | lower }} main"
        state: present

- name: Install hashicorp product using package
  package:
    name: "{{ hashicorp_product }}"
    state: present
  when: version is not defined

- name: Install versioned hashicorp product using package
  package:
    name: "{{ hashicorp_product }}={{ version }}"
    state: present
  when: version is defined

- name: Install manually
  block:
    - name: Install hashicorp product manually
      unarchive:
        src: "{{ hashicorp_product_url }}"
        dest: "{{ install_dir }}"
        remote_src: yes
        owner: root
        group: root
        mode: '0755'
```

