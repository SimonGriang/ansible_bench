---
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_facts.init_system == 'systemd'
    msg: "The system does not use systemd as the init system."

- name: Get latest release of promtail
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    method: GET
    return_content: yes
  register: promtail_latest_release

- name: Set promtail_version variable
  set_fact:
    promtail_version: "{{ promtail_latest_release.json.tag_name }}"

- name: Test if zip local archive exists
  stat:
    path: "/path/to/local/archive/{{ promtail_version }}-{{ go_arch }}.zip"
  register: archive_stat

- name: Assert local binary exists
  assert:
    that:
      - promtail_binary_local_dir is defined
      - archive_stat.stat.exists
    msg: "The local binary archive does not exist."

- name: Get checksum list
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/tags/{{ promtail_version }}/assets"
    method: GET
    return_content: yes
  register: checksum_list

- name: Get checksum for specific architecture
  set_fact:
    promtail_checksum: "{{ item | json_query(checksum_query) }}"
  vars:
    checksum_query: "[?name==`promtail-{{ promtail_version }}-{{ go_arch }}.zip.sha256`].browser_download_url"
  with_items: "{{ checksum_list.json }}"
  when: item | json_query(checksum_query) is not none


