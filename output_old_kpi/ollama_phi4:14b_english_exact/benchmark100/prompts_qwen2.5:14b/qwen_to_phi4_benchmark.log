    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop: "{{ directories }}"

- name: Create system group for DNS
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create system user for DNS
  user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    system: yes
    createhome: no

- name: Generate rndc key
  command: rndc-confgen -a -r /dev/urandom
  args:
    creates: "{{ rndc_key_file }}"

- name: Set permissions on rndc key file
  file:
    path: "{{ rndc_key_file }}"
    mode: '0400'
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"

- name: Get the hints/root file
  get_url:
    url: "{{ root_hints_url }}"
    dest: "{{ root_hints_dest }}"
    mode: '0644'

- name: Create zone file
  template:
    src: zone.j2
    dest: "{{ zone_file_dest }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0644'

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ named_conf_dest }}"
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: '0644'

- name: Place systemd override
  copy:
    src: dns.service.d/override.conf
    dest: "/etc/systemd/system/dns.service.d/override.conf"
    owner: root
    group: root
    mode: '0644'
  notify:
    - Reload systemd
    - Restart DNS

- name: Start and enable DNS
  service:
    name: dns
    state: started
    enabled: yes

handlers:
  - name: Reload systemd
    systemd:
      daemon_reload: true

  - name: Restart DNS
    service:
      name: dns
      state: restarted
```

