```yaml
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ user }}"
  register: user_exists

- name: Create directory for git configuration
  file:
    path: "{{ git_config_dir }}"
    state: directory
    owner: "{{ user }}"
    group: "{{ user_group }}"
  when: 
    - user_exists is defined
    - git_config_dir is defined
    - user_exists.stdout != ''

- name: Place git configuration
  copy:
    src: gitconfig
    dest: "/home/{{ user }}/.gitconfig"
    owner: "{{ user }}"
    group: "{{ user_group }}"
    mode: '0644'
  when: 
    - user_exists is defined
    - gitconfig_src is defined
    - user_exists.stdout != ''

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ user }}"
    group: "{{ user_group }}"
  when: 
    - user_exists is defined
    - repository_destination is defined
    - user_exists.stdout != ''

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}/{{ item.name }}"
    version: "{{ item.branch | default('main') }}"
    clone: true
    update: true
  become_user: "{{ git_user }}"
  with_items: "{{ git_repositories }}"
  when: 
