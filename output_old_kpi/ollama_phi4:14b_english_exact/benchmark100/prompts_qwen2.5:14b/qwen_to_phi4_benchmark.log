---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  lineinfile:
    path: /etc/my.cnf
    regexp: "^{{ item.key }}"
    line: "{{ item.value }}"
  loop: "{{ mysql_configuration_options | dict2items }}"

- name: Configure mysql client
  lineinfile:
    path: /etc/my.cnf
    regexp: "^socket\\s*=.*"
    line: "socket = {{ mysql_client_socket }}"

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    src: my.cnf
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: "'initial_import' not in item"

- name: List databases
  mysql_query:
    query: "SHOW DATABASES;"

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.path }}"
  loop: "{{ mysql_databases }}"
  when: "'initial_import' in item"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers
  meta: flush_handlers

- name: Flush handlers again
  meta: flush_handlers


