```yaml
- name: Create necessary directories for cadvisor to be installed
  ansible.builtin.file:
    path: "{{ cadvisor_install_dir }}"
    state: directory
    mode: '0755'

- name: Download cadvisor binary based on version and checksum provided
  ansible.builtin.get_url:
    url: "{{ cadvisor_download_url }}"
    dest: "{{ cadvisor_binary_dest }}"
    checksum: "{{ cadvisor_checksum }}"
  when: cadvisor_local_dir is not defined

- name: Copy the pre-downloaded cadvisor binary to the installation directory
  ansible.builtin.copy:
    src: "{{ cadvisor_local_dir }}/cadvisor"
    dest: "{{ cadvisor_binary_dest }}"
    mode: '0755'
  notify: Restart cadvisor service
  when: cadvisor_local_dir is defined

- name: Create a symbolic link to the cadvisor binary for easy execution
  ansible.builtin.file:
    src: "{{ cadvisor_binary_dest }}"
    dest: "/usr/local/bin/cadvisor"
    state: link

- name: Create a systemd service file for cadvisor using a template
  ansible.builtin.template:
    src: "cadvisor.service.j2"
    dest: "/etc/systemd/system/cadvisor.service"
    mode: '0644'

- name: Check if the cadvisor service is active and register the result
  ansible.builtin.service_facts:

- name: Debug the status of the cadvisor service
  ansible.builtin.debug:
    var: service_facts.services['cadvisor.service'].state

- name: Enable the cadvisor systemd service for automatic startup
  ansible.builtin.systemd:
    name: cadvisor
    enabled: true

- name: Start the cadvisor systemd service and ensure it's running
  ansible.builtin.systemd:
    name: cadvisor
    state: started
    enabled: true
``` 

