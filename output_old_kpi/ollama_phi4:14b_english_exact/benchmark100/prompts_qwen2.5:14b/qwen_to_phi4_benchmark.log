```yaml
- name: Import assert.yml
  import_playbook: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Allow custom HTTP port
      selinux_permissive_ports:
        ports: "custom_http_port"
        proto: tcp
        state: present
    - name: Allow custom HTTPS port
      selinux_permissive_ports:
        ports: "custom_https_port"
        proto: tcp
        state: present
  when: ansible_selinux.status == "enabled"

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
  notify:
    - test httpd configuration
    - restart httpd

- name: Activate httpd module | Debian
  command: a2enmod {{ item }}
  loop: "{{ httpd_modules }}"
  notify:
    - test httpd configuration
  when: ansible_os_family == "Debian"

- name: Import ssl.yml
  include_tasks: ssl.yml
  when: https_ssl_enable | bool

- name: Import locations.yml
  include_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml
  include_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  block:
    - name: Template ports configuration
      template:
        src: ports.conf.j2
        dest: /etc/apache2/ports.conf
      notify:
        - test httpd configuration
        - restart httpd
  when: ansible_os_family in ["Debian", "Suse"]

- name: Import directories.yml
  include_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "/var/www/html/index.html"
    state: absent
  when: httpd_remove_example | bool

- name: Start and enable httpd
  service:
    name: httpd
    state: started
    enabled: yes
```

