---
- name: Create etcd group
  group:
    name: etcd
    state: present

- name: Create etcd user
  user:
    name: etcd
    comment: 'etcd user'
    group: etcd
    shell: /bin/nologin
    createhome: no

- name: Determine source for sysctl config
  set_fact:
    sysctl_source: >-
      {{ '/usr/local/share/rke2/rke2-cis-sysctl.conf'
      if (ansible_mounts | selectattr('mount', 'match', '^/usr/local$')
      | selectattr('opts', 'match', 'rw')) | list | length > 0
      else '/opt/rke2/share/rke2/rke2-cis-sysctl.conf' }}

- name: Copy systemctl config file for kernel hardening
  copy:
    src: "{{ sysctl_source }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: '0600'
  notify: Restart systemd-sysctl

- name: Flush handlers
  meta: flush_handlers


