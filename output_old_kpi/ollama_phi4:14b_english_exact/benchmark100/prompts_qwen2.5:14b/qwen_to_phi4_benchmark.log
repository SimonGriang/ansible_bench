---
- name: Import assert.yml
  import_tasks: assert.yml
  when: ansible_play_hosts_all == ['localhost']

- name: Install vsftpd
  package:
    name: vsftpd
    state: present

- name: Configure vsftpd
  template:
    src: vsftpd.conf.j2
    dest: /etc/vsftpd/vsftpd.conf
    owner: root
    group: root
    mode: '0644'
  notify:
    - Restart vsftpd

- name: Start and enable vsftpd
  service:
    name: vsftpd
    state: started
    enabled: yes

handlers:
  - name: Restart vsftpd
    service:
      name: vsftpd
      state: restarted


