```yaml
- name: Ensure /etc/openvpn/easy-rsa directory exists
  ansible.builtin.file:
    path: /etc/openvpn/easy-rsa
    state: directory
    mode: '0755'

- name: Easyrsa init-pki
  ansible.builtins.command:
    argv:
      - ./easyrsa
      - init-pki
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts.stat.exists | 
        json_query('[].path[?(@ == "/etc/openvpn/easy-rsa/pki")]') | 
        select('defined') | list | length == 0

- name: Easyrsa build-ca
  ansible.builtins.command:
    argv:
      - ./easyrsa
      - build-ca
      - nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts.stat.exists | 
        json_query('[].path[?(@ == "/etc/openvpn/easy-rsa/pki/ca.crt")]') | 
        select('defined') | list | length == 0

- name: Easyrsa gen-dh
  ansible.builtins.command:
    argv:
      - ./easyrsa
      - gen-dh
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts.stat.exists | 
        json_query('[].path[?(@ == "/etc/openvpn/easy-rsa/pki/dh.pem")]') | 
        select('defined') | list | length == 0

- name: Easyrsa build-server-full server nopass
  ansible.builtins.command:
    argv:
      - ./easyrsa
      - build-server-full
      - server
      - nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts.stat.exists | 
        json_query('[].path[?(@ == "/etc/openvpn/easy-rsa/pki/issued/server.crt")]') | 
        select('defined') | list | length == 0

- name: Easyrsa build-client-full client nopass
  ansible.builtins.command:
    argv:
      - ./easyrsa
      - build-client-full
      - client
      - nopass
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts.stat.exists | 
        json_query('[].path[?(@ == "/etc/openvpn/easy-rsa/pki/issued/client.crt")]') | 
        select('defined') | list | length == 0

- name: Easyrsa gen-crl
  ansible.builtins.command:
    argv:
      - ./easyrsa
      - gen-crl
  args:
    chdir: /etc/openvpn/easy-rsa
  when: not ansible_facts.stat.exists | 
        json_query('[].path[?(@ == "/etc/openvpn/easy-rsa/pki/crl.pem")]') | 
        select('defined') | list | length == 0

- name: Openvpn --genkey --secret /etc/openvpn/easy-rsa/pki/ta.key
  ansible.builtins.command:
    argv:
      - openvpn
      - --genkey
      - --secret
      - /etc/openvpn/easy-rsa/pki/ta.key
  when: not ansible_facts.stat.exists | 
        json_query('[].path[?(@ == "/etc/openvpn/easy-rsa/pki/ta.key")]') | 
        select('defined') | list | length == 0

- name: Copy files to /etc/openvpn/server
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/server/
    mode: '0644'
  loop:
    - ca.crt
    - server.crt
    - server.key
    - dh.pem
    - ta.key
    - crl.pem

- name: Copy files to /etc/openvpn
  ansible.builtin.copy:
    src: /etc/openvpn/easy-rsa/pki/{{ item }}
    dest: /etc/openvpn/
    mode: '0644'
  loop:
    - ca.crt
    - ta.key

- name: Place server.conf
  ansible.builtin.template:
    src: server.conf.j2
    dest: /etc/openvpn/server/server.conf
  notify: restart openvpn
