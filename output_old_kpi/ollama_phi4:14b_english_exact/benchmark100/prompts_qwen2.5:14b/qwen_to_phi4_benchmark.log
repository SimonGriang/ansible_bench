---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: openjdk
    state: present
  when: java_vendor == "openjdk"

- name: Install RPM
  package:
    name: oracle-java-package.rpm
    state: present
    src: /path/to/local/oracle-java-package.rpm

- name: Install DEB
  package:
    name: oracle-java-package.deb
    state: present
    src: /path/to/local/oracle-java-package.deb

- name: Install oracle java (rpm) (repository)
  package:
    name: oracle-java-repository-package
    state: present

- name: Configure oracle targz
  block:
    - name: Ensure installation directory exists
      file:
        path: /usr/local/java
        state: directory

    - name: Install Oracle Java TARGZ package
      get_url:
        url: http://example.com/oracle-java-package.tar.gz
        dest: /tmp/oracle-java-package.tar.gz
      unarchive:
        src: /tmp/oracle-java-package.tar.gz
        dest: /usr/local/java
        remote_src: yes

- name: Install oracle java policy software (targz)
  copy:
    src: /path/to/jce_policy-8.zip
    dest: /usr/local/java/jce_policy-8.zip
  command:
    cmd: unzip -o /usr/local/java/jce_policy-8.zip -d /usr/local/java

- name: Set alternative (targz)
  alternatives:
    name: java
    path: /usr/local/java/jre/bin/java
  when: ansible_os_family != "Alpine"

- name: Find JAVA_HOME
  command: readlink -f /path/to/java/bin/java | sed "s:/bin/java::"
  register: java_home

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME={{ java_home.stdout }}"
    state: present


