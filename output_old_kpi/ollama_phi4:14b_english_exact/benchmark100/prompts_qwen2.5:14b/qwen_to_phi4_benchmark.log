---
- name: Ensure old versions of Docker are not installed
  package:
    name: '{{ item }}'
    state: absent
  loop:
    - docker
    - docker-engine
    - docker.io
    - containerd
    - runc
  when: ansible_facts['distribution'] != 'RedHat' or ansible_facts['distribution_major_version'] != '8'

- name: Add Docker GPG key
  ansible.builtin.apt_key:
    url: https://download.docker.com/linux/ubuntu/gpg
    state: present
  when: ansible_facts['os_family'] == 'Debian'

- name: Add Docker repository
  ansible.builtin.apt_repository:
    repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} stable
    state: present
  when: ansible_facts['os_family'] == 'Debian'

- name: Configure Docker Nightly repo
  block:
    - name: Add Docker nightly repository
      ansible.builtin.apt_repository:
        repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} nightly
        state: present
      when: ansible_facts['os_family'] == 'Debian'

- name: Configure Docker Test repo
  block:
    - name: Add Docker test repository
      ansible.builtin.apt_repository:
        repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} test
        state: present
      when: ansible_facts['os_family'] == 'Debian'

- name: Configure containerd on RHEL 8
  block:
    - name: Ensure runc is not installed
      package:
        name: runc
        state: absent
      when: ansible_facts['distribution'] == 'RedHat' and ansible_facts['distribution_major_version'] == '8'

    - name: Install container-selinux and containerd.io
      package:
        name: '{{ item }}'
        state: present
      loop:
        - container-selinux
        - containerd.io
      when: ansible_facts['distribution'] == 'RedHat' and ansible_facts['distribution_major_version'] == '8'


