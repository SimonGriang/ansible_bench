```yaml
- name: Create SSL key
  ansible.builtin.file:
    path: "/etc/ssl/private/{{ item.key_name }}.key"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0640'
    state: touch

- name: Create SSL CSR
  community.crypto.openssl_csr:
    path: "/etc/ssl/certs/{{ item.csr_name }}.csr"
    privatekey_path: "/etc/ssl/private/{{ item.key_name }}.key"
    common_name: "{{ item.common_name }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0644'

- name: Create SSL certificates
  community.crypto.x509_certificate:
    path: "/etc/ssl/certs/{{ item.cert_name }}.crt"
    privatekey_path: "/etc/ssl/private/{{ item.key_name }}.key"
    csr_path: "/etc/ssl/certs/{{ item.csr_name }}.csr"
    provider: selfsigned
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0644'

- name: Create PKCS#12 file
  community.crypto.openssl_pkcs12:
    dest: "/etc/ssl/certs/{{ item.p12_name }}.p12"
    privatekey_path: "/etc/ssl/private/{{ item.key_name }}.key"
    certificate_path: "/etc/ssl/certs/{{ item.cert_name }}.crt"
    friendly_name: "{{ item.friendly_name }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0640'

- name: Read private key
  ansible.builtin.slurp:
    src: "/etc/ssl/private/{{ item.key_name }}.key"
  register: private_key_content

- name: Read certificate
  ansible.builtin.slurp:
    src: "/etc/ssl/certs/{{ item.cert_name }}.crt"
  register: certificate_content

- name: Create combined private_key and certificate file
  ansible.builtin.copy:
    dest: "/etc/ssl/certs/{{ item.combined_name }}"
    content: >-
      {{ private_key_content['content'] | b64decode }}
      {{ certificate_content['content'] | b64decode }}
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: '0640'
```

This playbook addresses the linting issues by using the canonical module names as per the `ansible-lint` suggestions. The `ansible.builtin` prefix has been replaced with `community.crypto` for the relevant modules. The functional integrity and structure of the original tasks have been maintained.


