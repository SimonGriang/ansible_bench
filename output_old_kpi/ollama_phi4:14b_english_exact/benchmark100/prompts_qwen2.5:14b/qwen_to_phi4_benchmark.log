```yaml
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: "{{ rke2_install_script_mode }}"
    timeout: "{{ rke2_install_script_timeout }}"

- name: Copy local RKE2 installation script
  copy:
    src: "{{ local_rke2_install_script }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: '0700'
    force: true
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    state: directory
    mode: '0700'
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_implementation != "exists"

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum file
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_dest }}"

    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_dest }}"

    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_dest }}"
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_implementation == "download"

- name: Rescue for failed download
  block:
    - name: Create directory for failed download rescue
      file:
        path: "{{ rke2_rescue_path }}"
        state: directory

    - name: Download RKE2 artifacts locally
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_rescue_path }}/{{ item }}"
      loop:
        - "{{ rke2_local_artifact_name }}"
        - "{{ rke2_local_checksum_name }}"

    - name: Download RKE2 install script locally
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_rescue_path }}/{{ rke2_local_script_name }}"

    - name: Copy local RKE2 artifacts to remote host
      copy:
        src: "{{ rke2_rescue_path }}/{{ item }}"
        dest: "{{ rke2_artifacts_path }}/{{ item }}"
        mode: '0640'
        force: true
      loop:
        - "{{ rke2_local_artifact_name }}"
        - "{{ rke2_local_checksum_name }}"
        - "{{ rke2_local_script_name }}"
  when: download_failed

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifacts_path }}/{{ item }}"
    dest: "{{ rke2_artifacts_path }}/{{ item }}"
    mode: '0640'
    force: true
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_implementation == "copy"
  loop:
    - "{{ rke2_local_artifact_name }}"
    - "{{ rke2_local_checksum_name }}"
    - "{{ rke2_local_script_name }}"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create folder for additional images tarballs
      file:
        path: "{{ rke2_tarball_images_path }}"
        state: directory

    - name: Copy additional images tarballs
      copy:
        src: "{{ rke2_additional_tarball_path }}/{{ item }}"
        dest: "{{ rke2_tarball_images_path }}/{{ item }}"
      loop: "{{ rke2_airgap_copy_additional_tarballs }}"
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_mode != "exists"
    - rke2_airgap_copy_additional_tarballs | length > 0

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure RKE2 install script exists
      file:
        path: "{{ rke2_install_script_dest }}"
        state: file
        mode: '0700'

    - name: Ensure artifacts directory exists
      file:
        path: "{{ rke2_artifacts_path }}"
        state: directory
        mode: '0755'

    - name: Fix permissions if too permissive
      file:
        path: "{{ item }}"
        mode: '0755'
      loop:
        - "{{ rke2_install_script_dest }}"
        - "{{ rke2_artifacts_path }}"
  when:
    - rke2_airgap_mode is defined
    - rke2_airgap_implementation is defined
    - rke2_airgap_implementation == "exists"

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  stat:
    path: /usr/local

- name: Check if separate partition
  command: grep -q '^/dev/' /proc/mounts
  register: separate_partition_check
  changed_when: false

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "{{ '/usr/local/bin' if separate_partition_check.rc == 0 else '/opt/rke2/bin' }}"

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 version"
  register: rke2_version_output

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version_output.stdout_lines[0] }}"
    rke2_running_version: "{{ rke2_version_output.stdout_lines[1] }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_installed_version | version_compare(rke2_running_version, '>=') or
        rke2_allow_downgrade is defined and rke2_allow_downgrade
    fail_msg: "RKE2 downgrade detected. Use rke2_allow_downgrade to bypass this check."

- name: Run RKE2 install script
  command: "{{ rke2_install_script_dest }} {{ rke2_airgap_variables if rke2_airgap_mode else '' }}"
  when:
    - rke2_installed_version != rke2_running_version
    - not ansible_check_mode

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/{{ item }}"
  when: custom_manifests | length > 0
  loop: "{{ custom_manifests }}"

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}/{{ item }}"
  when: static_pods | length > 0
  loop: "{{ static_pods }}"

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_environment_file }}"
    dest: "/etc/rancher/rke2/environment"
  when: rke2_environment_options is defined and rke2_environment_options | length > 0
```


