---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ user }}"
  register: user_exists

- name: Create directory for git configuration
  file:
    path: "{{ git_config_dir }}"
    state: directory
    owner: "{{ user }}"
    group: "{{ user_group }}"
  when: user_exists.stdout is defined and git_config_dir is defined and user_exists.stdout != ''

- name: Place git configuration
  copy:
    src: gitconfig
    dest: "/home/{{ user }}/.gitconfig"
    owner: "{{ user }}"
    group: "{{ user_group }}"
    mode: '0644'
  when: user_exists.stdout is defined and gitconfig_src is defined and user_exists.stdout != ''

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ user }}"
    group: "{{ user_group }}"
  when: user_exists.stdout is defined and repository_destination is defined and user_exists.stdout != ''

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}/{{ item.name }}"
    version: "{{ item.branch | default('main') }}"
    clone: yes
    update: yes
  become_user: "{{ git_user }}"
  with_items: "{{ git_repositories }}"
  when: user_exists.stdout is defined and git_repositories is defined and user_exists.stdout != ''


