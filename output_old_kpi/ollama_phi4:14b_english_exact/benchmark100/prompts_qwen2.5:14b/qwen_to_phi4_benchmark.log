---
- name: Cordon and Drain the node {{ rke2_node_name }}
  ansible.builtin.shell: |
    kubectl drain {{ rke2_node_name }} --ignore-daemonsets --delete-local-data \
    {{ rke2_drain_additional_args | default('') }} --force --grace-period=-1
  args:
    chdir: "{{ rke2_data_path }}"
  register: drain_result
  until: drain_result.rc == 0
  retries: 100
  delay: 15

- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.service:
    name: rke2-server
    state: restarted
  notify: 
    - "Service (re)started"

- name: Wait for all nodes to be ready again
  ansible.builtin.command: kubectl get nodes
  register: nodes_status
  until: "'Ready' in nodes_status.stdout"
  retries: 100
  delay: 15

- name: Uncordon the node {{ rke2_node_name }}
  ansible.builtin.shell: kubectl uncordon {{ rke2_node_name }}
  args:
    chdir: "{{ rke2_data_path }}"
  when: rke2_drain_node_during_upgrade | default(false)

- name: Wait for all pods to be ready again
  ansible.builtin.command: kubectl get pods --all-namespaces
  register: pods_status
  until: "'Running' in pods_status.stdout or 'Succeeded' in pods_status.stdout"
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready | default(false)

- name: Wait for all pods to pass readiness checks
  ansible.builtin.command: kubectl wait --for=condition=Ready --all pods --timeout=-1s
  register: pods_readiness_status
  until: pods_readiness_status.rc == 0
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy | default(false)

handlers:
  - name: Service (re)started
    ansible.builtin.service:
      name: rke2-server
      state: restarted


