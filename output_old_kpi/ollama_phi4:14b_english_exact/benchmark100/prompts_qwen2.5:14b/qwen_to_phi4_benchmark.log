---
- name: Import assert.yml
  import_tasks: assert.yml
  when: inventory_hostname == "localhost"

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Set SELinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: yes
      loop: "{{ selinux_booleans }}"
      when: ansible_selinux.status == "enabled"

    - name: Allow connections to custom ports
      seport:
        ports: "{{ item }}"
        proto: tcp
        secontext: http_port_t
        setype: http_port_t
      loop: "{{ selinux_ports }}"
      when: ansible_selinux.status == "enabled"

- name: Configure httpd
  template:
    src: "{{ httpd_main_conf_src }}"
    dest: "{{ httpd_main_conf_dest }}"
  notify: 
    - test httpd configuration
    - restart httpd

- name: Activate httpd module | Debian
  command: a2enmod {{ item }}
  notify: 
    - test httpd configuration
    - restart httpd
  when: ansible_os_family == "Debian"
  loop: "{{ apache_modules }}"

- name: Import ssl.yml
  import_tasks: ssl.yml
  when: https_ssl_enabled

- name: Import locations.yml
