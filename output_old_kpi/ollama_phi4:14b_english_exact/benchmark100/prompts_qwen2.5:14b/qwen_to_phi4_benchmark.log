---
- name: Import assert.yml
  import_playbook: assert.yml
  hosts: localhost
  tasks:
    - name: Ensure preconditions are met
      include_tasks: assert.yml

- name: Install mysql
  hosts: all
  tasks:
    - name: Install mysql server package
      package:
        name: "{{ mysql_packages }}"
        state: present
      notify:
        - Set root password
        - Systemctl daemon-reexec

- name: Configure mysql server
  hosts: all
  tasks:
    - name: Configure MySQL server settings
      lineinfile:
        path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
        line: "{{ item.key }} = {{ item.value }}"
      loop: "{{ mysql_configuration_options | dict2items }}"
      notify:
        - Restart mysql server

- name: Configure mysql client
  hosts: all
  tasks:
    - name: Configure MySQL client settings
      lineinfile:
        path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
        line: "socket = /var/run/mysqld/mysqld.sock"

- name: Initialize mysql
  hosts: all
  tasks:
    - name: Initialize MySQL database
      command: "{{ mysql_initialize_command }}"
      when: ansible_os_family in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  hosts: all
  tasks:
    - name: Ensure MySQL service is started and enabled
      systemd:
        name: mysql
        state: started
        enabled: yes

- name: Flush handlers
  hosts: all
  tasks:
    - name: Flush handlers
      meta: flush_handlers

- name: Place my.cnf
  hosts: all
  tasks:
    - name: Create custom MySQL configuration file
      template:
        src: my.cnf.j2
        dest: /root/.my.cnf

- name: Create databases
  hosts: all
  tasks:
    - name: Create MySQL databases
      mysql_db:
        name: "{{ item.name }}"
        state: present
        login_user: root
      loop: "{{ mysql_databases }}"

- name: Create users
  hosts: all
  tasks:
    - name: Create MySQL users and grant privileges
      mysql_user:
        name: "{{ item.name }}"
        host: "{{ item.host | default('localhost') }}"
        password: "{{ item.password }}"
        priv: "{{ item.priv }}"
        state: present
        login_user: root
      loop: "{{ mysql_users }}"

- name: Flush handlers again
  hosts: all
  tasks:
    - name: Flush handlers again
      meta: flush_handlers


