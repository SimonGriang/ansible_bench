content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  when: inventory_hostname == \'localhost\'\n\n- name: Install prerequisites\n  package:\n    name: "{{ item }}"\n    state: present\n  loop: "{{ vault_prerequisites }}"\n  become: true\n\n- name: Include installation method specific tasks\n  include_tasks: "{{ vault_installation_method }}.yml"\n\n- name: Add Vault environment variables\n  lineinfile:\n    path: /etc/vault.d/vault.env\n    line: "{{ item.key }}={{ item.value }}"\n    create: yes\n  loop: "{{ vault_environment_settings | dict2items }}"\n  notify: Restart vault\n\n- name: Include hardening tasks\n  include_tasks: hardening.yml\n\n- name: Start and enable vault\n  service:\n    name: vault\n    state: started\n    enabled: true\n  when: vault_type == "oss"\n\n- name: Enable vault\n  service:\n    name: vault\n    enabled: true\n  when: vault_type != "oss"\n\nhandlers:\n  - name: Restart vault\n    service:\n      name: vault\n      state: restarted\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-03T07:00:02.227092671Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3657942014, 'load_duration': 70306870, 'prompt_eval_count': 458, 'prompt_eval_duration': 45560242, 'eval_count': 244, 'eval_duration': 3539873925, 'model_name': 'phi4:14b'} id='run--55749650-8831-4a92-bae5-12ca945d49fe-0' usage_metadata={'input_tokens': 458, 'output_tokens': 244, 'total_tokens': 702}
