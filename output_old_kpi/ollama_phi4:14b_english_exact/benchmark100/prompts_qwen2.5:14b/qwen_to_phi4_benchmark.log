---
- name: Import assert.yml
  import_playbook: assert.yml
  hosts: localhost
  gather_facts: no

- name: Configure apk
  block:
    - name: Update apk cache
      ansible.builtin.package:
        name: "*"
        state: latest
        update_cache: yes
        manager: apk

    - name: Upgrade all software with apk
      ansible.builtin.package:
        name: "*"
        state: latest
        manager: apk
  notify: reboot

- name: Configure apt
  block:
    - name: Prevent upgrade for selected packages
      ansible.builtin.package:
        name: "{{ item }}"
        state: present
        prevent_upgrade: yes
      loop: "{{ packages_to_prevent_upgrade }}"

    - name: Update all software with apt
      ansible.builtin.package:
        name: "*"
        state: latest
        manager: apt

    - name: Autoremove unused packages with apt
      ansible.builtin.package:
        name: "*"
        autoremove: yes
        manager: apt
  notify: reboot

- name: Update all software (dnf)
  block:
    - name: Exclude certain packages during dnf update
      ansible.builtin.package:
        name: "*"
        state: latest
        exclude: "{{ dnf_exclude_packages }}"
        manager: dnf
  notify: reboot

- name: Update all software (pacman)
  block:
    - name: Update all software with pacman
      ansible.builtin.package:
        name: "*"
        state: latest
        manager: pacman
  notify: reboot

- name: Configure yum
  block:
    - name: Update all software with yum
      ansible.builtin.package:
        name: "*"
        state: latest
        manager: yum

    - name: Install yum-utils if needed
      ansible.builtin.package:
        name: yum-utils
        state: present
        manager: yum
  notify: reboot

- name: Update all software (zypper)
  block:
    - name: Update all software with zypper
      ansible.builtin.package:
        name: "*"
        state: latest
        manager: zypper
  notify: reboot

handlers:
  - name: reboot
    ansible.builtin.reboot:


