```yaml
- name: Check if python is installed
  ansible.builtin.stat:
    path: /usr/bin/python
  register: python_installed

- name: Check if python3 is installed
  ansible.builtin.stat:
    path: /usr/bin/python3
  register: python3_installed

- name: Debug Python executable path
  ansible.builtin.debug:
    msg: "Python executable path: {{ python_installed.stat.path }}"
  when: python_installed.stat.exists

- name: Debug Python3 executable path
  ansible.builtin.debug:
    msg: "Python3 executable path: {{ python3_installed.stat.path }}"
  when: python3_installed.stat.exists

- name: Import assert.yml
  ansible.builtin.include_tasks: assert.yml

- name: Install requirements
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_requirements }}"

- name: Ensure packaging is available via dnf
  ansible.builtin.package:
    name: python3-packaging
    state: present
    manager: dnf

- name: Install pip packages
  ansible.builtin.pip:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_pip_packages }}"

- name: Create key directory
  ansible.builtin.file:
    path: "{{ key_directory }}"
    state: directory
    mode: "{{ key_directory_mode }}"
    owner: "{{ key_directory_owner }}"
    group: "{{ key_directory_group }}"

- name: Create csr directory
  ansible.builtin.file:
    path: "{{ csr_directory }}"
    state: directory
    mode: "{{ csr_directory_mode }}"
    owner: "{{ csr_directory_owner }}"
    group: "{{ csr_directory_group }}"

- name: Create crt directory
  ansible.builtin.file:
    path: "{{ crt_directory }}"
    state: directory
    mode: "{{ crt_directory_mode }}"
    owner: "{{ crt_directory_owner }}"
    group: "{{ crt_directory_group }}"

- name: Include create.yml
  ansible.builtin.include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item
```

