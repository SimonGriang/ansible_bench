---
- name: Remove the Docker apt key from the trusted.gpg.d directory
  ansible.builtin.file:
    path: /etc/apt/trusted.gpg.d/docker.gpg
    state: absent

- name: Remove the old Docker source list file from the sources.list.d directory
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Uninstall any old versions of Docker that may be installed on the system
  ansible.builtin.apt:
    name: "{{ item }}"
    state: absent
  loop:
    - docker
    - docker-engine
    - docker.io
    - containerd
    - runc

- name: Remove the legacy Docker repository file if it exists
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker-ce.list
    state: absent

- name: Install necessary dependencies for Docker
  ansible.builtin.apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: true

- name: Add or remove the Docker repository based on the value of the variable docker_add_repo
  ansible.builtin.apt_repository:
    repo: "deb [arch=amd64] https://download.docker.com/linux/ubuntu {{ ansible_lsb.codename }} stable"
    state: "{{ 'present' if docker_add_repo else 'absent' }}"
  notify:
    - Update apt cache

- name: Flush handlers to ensure the apt cache is updated immediately after making changes to the Docker repository
  ansible.builtin.meta:
    flush_handlers: true


