```yaml
- name: Remove externally managed configuration files in Debian 12 systems
  become: true
  shell: |
    dpkg-query -W -f='${Status}\n' |
    grep -E '^install ok installed$' |
    awk '{print $3}' |
    grep -E '^debconf(.*)\.conf$' |
    xargs -r dpkg-divert --rename --add --rename-from=/etc/debconf.conf \
    --package=debconf --divert=/etc/debconf.conf.disabled
  when: ansible_distribution == "Debian" and ansible_distribution_major_version == "12"

- name: Install the Python package 'pip' if it is not already present
  become: true
  package:
    name: python3-pip
    state: present

- name: Install the python3-packaging package via dnf, ensuring the availability of packaging utilities
  become: true
  dnf:
    name: python3-packaging
    state: present

- name: Install specified Python packages using pip, with optional parameters like version, virtual environment, and extra arguments
  become: true
  pip:
    name: "{{ pip_install_packages }}"
    state: present
    executable: "{{ pip_executable | default(omit) }}"
    virtualenv: "{{ pip_virtualenv | default(omit) }}"
    virtualenv_site_packages: "{{ pip_virtualenv_site_packages | default(omit) }}"
    extra_args: "{{ pip_extra_args | default(omit) }}"
```

