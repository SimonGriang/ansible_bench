---
- name: Ensure /etc/openvpn/client exists
  ansible.builtin.file:
    path: /etc/openvpn/client
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Place client.conf
  ansible.builtin.template:
    src: client.conf.j2
    dest: /etc/openvpn/client/client.conf
    owner: root
    group: root
    mode: '0644'
  notify:
    - restart openvpn


