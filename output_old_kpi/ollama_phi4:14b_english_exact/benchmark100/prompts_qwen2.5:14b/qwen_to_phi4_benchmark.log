    path: "{{ ssl_directory }}/{{ inventory_hostname }}.key"
    size: 2048
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: '0600'

- name: create | Create ssl csr
  ansible.builtin.openssl_csr:
    path: "{{ ssl_directory }}/{{ inventory_hostname }}.csr"
    privatekey_path: "{{ ssl_directory }}/{{ inventory_hostname }}.key"
    common_name: "{{ inventory_hostname }}"
    state: present
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: '0600'

- name: create | Create ssl certificates
  ansible.builtin.openssl_certificate:
    path: "{{ ssl_directory }}/{{ inventory_hostname }}.crt"
    privatekey_path: "{{ ssl_directory }}/{{ inventory_hostname }}.key"
    csr_path: "{{ ssl_directory }}/{{ inventory_hostname }}.csr"
    provider:
      country_name: US
      state_or_province_name: California
      locality_name: San Francisco
      organization_name: MyCompany
      organizational_unit_name: IT
      common_name: "{{ inventory_hostname }}"
      email_address: admin@mycompany.com
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: '0644'

- name: create | Create PKCS#12 file
  ansible.builtin.openssl_pkcs12:
    src_privatekey: "{{ ssl_directory }}/{{ inventory_hostname }}.key"
    src_cert: "{{ ssl_directory }}/{{ inventory_hostname }}.crt"
    dest: "{{ ssl_directory }}/{{ inventory_hostname }}.p12"
    password: "{{ p12_password }}"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: '0600'

- name: create | Read private key
  ansible.builtin.slurp:
    path: "{{ ssl_directory }}/{{ inventory_hostname }}.key"
  register: private_key

- name: create | Read certificate
  ansible.builtin.slurp:
    path: "{{ ssl_directory }}/{{ inventory_hostname }}.crt"
  register: certificate

- name: create | Create combined private_key and certificate file
  ansible.builtin.copy:
    content: |
      {{ private_key.content | b64decode }}
      {{ certificate.content | b64decode }}
    dest: "{{ ssl_directory }}/{{ inventory_hostname }}.pem"
    owner: "{{ ssl_owner }}"
    group: "{{ ssl_group }}"
    mode: '0644'
```

