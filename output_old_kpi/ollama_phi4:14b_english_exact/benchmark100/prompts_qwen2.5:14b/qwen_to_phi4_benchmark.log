    - name: Ensure permissions are set correctly
      ansible.builtin.file:
        path: "{{ rke2_artifacts_dest }}"
        mode: "{{ rke2_artifacts_perm }}"
      when: (ansible_facts.permissions | get_item(rke2_artifacts_dest) | default('')) != rke2_artifacts_perm
  when: rke2_airgap_mode == "exists" and rke2_airgap_implementation == "exists"

- name: Populate service facts
  ansible.builtin.setup:
    filter: service

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local
  register: fs_stats

- name: Check if separate partition
  ansible.builtin.command:
    cmd: grep -q '/usr/local' /proc/mounts
  register: separate_partition_check

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: >-
      {{ (fs_stats.stat.pw_name == ansible_facts.users[0].name) | ternary('/usr/local/bin', '/usr/local/bin') }}

- name: Check RKE2 version
  ansible.builtin.command:
    cmd: rke2 version
  register: rke2_version_output

- name: Set RKE2 versions
  ansible.builtin.set_fact:
    rke2_installed_version: "{{ rke2_version_output.stdout_lines[0].split()[1] }}"
    rke2_running_version: "{{ rke2_version_output.stdout_lines[1].split()[1] }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  ansible.builtin.fail:
    msg: "Downgrade of RKE2 is not allowed. Installed version: {{ rke2_installed_version }}, Running version: {{ rke2_running_version }}"
  when: (rke2_installed_version and rke2_running_version and rke2_running_version < rke2_installed_version) and not rke2_allow_downgrade

- name: Run RKE2 install script
  ansible.builtin.shell: |
    {{ rke2_install_script_dest }} --airgap-url={{ rke2_airgap_url }} --airgap-certs={{ rke2_airgap_certs }}
  args:
    executable: /bin/bash
  when: not ansible_check_mode and rke2_installed_version != rke2_running_version and rke2_airgap_mode != "none"

- name: Copy Custom Manifests
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/manifests/"
  with_items: "{{ custom_manifests }}"
  when: custom_manifests | length > 0

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}/"
  with_items: "{{ static_pods }}"
  when: static_pods | length > 0

- name: Copy RKE2 environment file
  ansible.builtin.copy:
    src: "{{ rke2_environment_file_src }}"
    dest: "{{ rke2_environment_file_dest }}"
  when: rke2_environment_options | length > 0
```


