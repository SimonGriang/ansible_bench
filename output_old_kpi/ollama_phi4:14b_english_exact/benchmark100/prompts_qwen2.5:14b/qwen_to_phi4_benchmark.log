_count': 2027, 'prompt_eval_duration': 19866727, 'eval_count': 1046, 'eval_duration': 23578536743, 'model_name': 'phi4:14b'} id='run--d806f837-3c0b-4ea0-8a43-1527d4307da8-0' usage_metadata={'input_tokens': 2027, 'output_tokens': 1046, 'total_tokens': 3073}
