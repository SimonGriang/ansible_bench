---
- name: Restore etcd - get all nodes
  ansible.builtin.command:
    cmd: kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
  register: all_nodes
  changed_when: false

- name: Restore etcd - remove old nodes
  ansible.builtin.command:
    cmd: kubectl delete node "{{ item }}"
  loop: "{{ all_nodes.stdout_lines }}"
  when: item not in current_cluster_group
  changed_when: false


