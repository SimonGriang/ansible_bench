---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Install python pip
  apt:
    name: "{{ name }}"
    state: present

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    line: "proxy = {{ python_pip_proxy }}"
    create: yes
    state: present
  when: python_pip_proxy is defined

- name: Trust hosts
  lineinfile:
    path: /etc/pip.conf
    line: "trusted-host = {{ python_pip_trusted_host }}"
    create: yes
    state: present
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: latest
  when:
    - python_pip_update | bool
    - ansible_facts.distribution_release not in ['bookworm', 'noble']
    - ansible_facts.os_family != 'Alpine'

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    version: "{{ item.version }}"
  loop: "{{ python_pip_modules }}"
  when:
    - ansible_facts.distribution_release not in ['bookworm', 'noble']
    - ansible_facts.os_family != 'Alpine'


