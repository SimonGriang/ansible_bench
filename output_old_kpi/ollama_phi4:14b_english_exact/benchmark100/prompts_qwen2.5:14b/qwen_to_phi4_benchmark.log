---
- name: Enable proxy modules in Apache
  block:
    - name: Enable proxy and proxy_http modules in Apache for Debian
      apache2_module:
        name: "{{ item }}"
        state: present
      loop:
        - proxy
        - proxy_http
      when: ansible_os_family == 'Debian'

    - name: Enable proxy and proxy_http modules in Apache for Suse
      apache2_module:
        name: "{{ item }}"
        state: present
      loop:
        - proxy
        - proxy_http
      when: ansible_os_family == 'Suse'

- name: Configure Apache locations using a template
  block:
    - name: Configure Apache with a Jinja2 template
      template:
        src: apache_locations.conf.j2
        dest: /etc/apache2/sites-available/000-default.conf
        mode: '0644'
      notify:
        - test apache configuration
        - restart apache

  handlers:
    - name: test apache configuration
      command: apache2ctl configtest

    - name: restart apache
      service:
        name: apache2
        state: restarted


