```yaml
- name: Import assert.yml
  ansible.builtin.include_tasks:
    file: assert.yml

- name: Pre-configure Debian systems
  ansible.builtin.set_fact:
    debconf: "main_mailer_type: No configuration"
  when: ansible_os_family == "Debian"

- name: Install postfix
  ansible.builtin.package:
    name: postfix
    state: present

- name: Install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present
  when: 
    - postfix_virtual_mailbox_maps is defined and "mysql" in postfix_virtual_mailbox_maps
    - postfix_virtual_mailbox_domains is defined and "mysql" in postfix_virtual_mailbox_domains
    - postfix_virtual_alias_maps is defined and "mysql" in postfix_virtual_alias_maps

- name: Configure postfix (transport_maps)
  ansible.builtin.template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
  notify:
    - Validate postfix configuration
    - Rebuild postfix transport_maps database

- name: Configure postfix (header_checks)
  ansible.builtin.template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - Validate postfix configuration
    - Reload postfix

- name: Setting values for main.cf (1/2)
  ansible.builtin.set_fact:
    postfix_main_cf_restrictions: 
      - smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions | default([]) }}"
      - smtpd_sender_restrictions: "{{ smtpd_sender_restrictions | default([]) }}"
  when: 
    - smtpd_recipient_restrictions is defined
    - smtpd_sender_restrictions is defined

- name: Setting values for main.cf (2/2)
  ansible.builtin.set_fact:
    postfix_main_cf_parameters: 
      - mynetworks: "{{ mynetworks | default('') }}"
      - mydestination: "{{ mydestination | default([]) }}"
      - relay_domains: "{{ relay_domains | default([]) }}"
      - virtual_mailbox_domains: "{{ virtual_mailbox_domains | default([]) }}"
      - virtual_alias_domains: "{{ virtual_alias_domains | default([]) }}"
  when:
    - mynetworks is defined
    - mydestination is defined
    - relay_domains is defined
    - virtual_mailbox_domains is defined
    - virtual_alias_domains is defined

- name: Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - Validate postfix configuration
    - Restart postfix

- name: Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - Validate postfix configuration
    - Restart postfix

- name: Creates cert/key directory
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"

- name: Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_tls_cert_file }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
  notify:
    - Reload postfix

- name: Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_tls_key_file }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
  notify:
    - Reload postfix

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure aliases
  ansible.builtin.postmap:
    dest: /etc/postfix/aliases
  notify:
    - Rebuild postfix alias database
    - Reload postfix

- name: Configure sender_access
  ansible.builtin.postmap:
    dest: /etc/postfix/sender_access
  notify:
    - Rebuild postfix sender_access database
    - Reload postfix

- name: Configure recipient_access
  ansible.builtin.postmap:
    dest: /etc/postfix/recipient_access
  notify:
    - Validate postfix configuration
    - Rebuild postfix recipient_access database
    - Reload postfix

- name: Place sasl_password_map
  ansible.builtin.copy:
    content: "{{ sasl_password_map_content }}"
    dest: /etc/postfix/sasl_passwd
  notify:
    - Rebuild postfix sasl_password_map database

- name: Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Start and enable postfix
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: true
```

