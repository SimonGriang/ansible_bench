```yaml
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/crontab
    regexp: '^SHELL='
    line: "SHELL={{ cron_shell }}"
    create: yes
    state: present
    mode: 0600
  notify:
    - Restart cron

- name: Configure path
  lineinfile:
    path: /etc/crontab
    regexp: '^PATH='
    line: "PATH={{ cron_path }}"
    create: yes
    state: present
    mode: 0600
  notify:
    - Restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/crontab
    regexp: '^MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    state: present
    mode: 0600
  notify:
    - Restart cron

- name: Start and enable cron
  service:
    name: cron
    state: started
    enabled: true
  when: cron_service is defined and cron_service != ''

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    user: "{{ item.user | default('root') }}"
    minute: "{{ item.minute | default('*') }}"
    hour: "{{ item.hour | default('*') }}"
    day: "{{ item.day | default('*') }}"
    month: "{{ item.month | default('*') }}"
    weekday: "{{ item.weekday | default('*') }}"
    job: "{{ item.command }}"
  loop: "{{ cron_jobs }}"
```


