rompt_eval_count': 633, 'prompt_eval_duration': 297043022, 'eval_count': 483, 'eval_duration': 9248095707, 'model_name': 'phi4:14b'} id='run--693486a6-128f-425f-8a78-130d5fb5451e-0' usage_metadata={'input_tokens': 633, 'output_tokens': 483, 'total_tokens': 1116}
