---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  lineinfile:
    path: /etc/my.cnf
    regexp: "^{{ item.key }}"
    line: "{{ item.value }}"
  with_dict: "{{ mysql_configuration_options }}"

- name: Configure mysql client
  lineinfile:
    path: /etc/my.cnf
    regexp: "^socket\s*=.*"
    line: "socket = {{ mysql_client_socket }}"

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_distribution == "Alpine" or ansible_distribution == "Archlinux"

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    src: my.cnf
    dest: /etc/my.cnf
    owner: root
    group: root
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  with_items: "{{ mysql_databases }}"
  when: item.initial_import is not defined

- name: List databases
  mysql_query:
    query: "SHOW DATABASES;"

- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.path }}"
  with_items: "{{ mysql_databases }}"
  when: item.initial_import is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
  with_items: "{{ mysql_users }}"

- name: Flush handlers
  meta: flush_handlers

- name: Flush handlers again
  meta: flush_handlers


