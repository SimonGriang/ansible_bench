---
- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_binary

- name: Check Helm version
  command: helm version --short
  register: helm_version
  when: helm_binary.stat.exists

- name: Download helm
  get_url:
    url: https://get.helm.sh/helm-v3.10.3-linux-amd64.tar.gz
    dest: /tmp/helm-v3.10.3-linux-amd64.tar.gz
  when: not helm_binary.stat.exists or helm_version.stdout is version('3.10.3', '<')

- name: Extract helm binary
  unarchive:
    src: /tmp/helm-v3.10.3-linux-amd64.tar.gz
    dest: /tmp
    remote_src: yes
  when: not helm_binary.stat.exists or helm_version.stdout is version('3.10.3', '<')

- name: Copy helm binary into place
  copy:
    src: /tmp/helm-v3.10.3-linux-amd64/helm
    dest: /usr/local/bin/helm
    mode: '0755'
  when: not helm_binary.stat.exists or helm_version.stdout is version('3.10.3', '<')


