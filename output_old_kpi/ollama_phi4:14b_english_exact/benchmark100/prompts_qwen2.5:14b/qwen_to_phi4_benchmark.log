---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  community.general.k8s:
    kubeconfig: "{{ kubeconfig_path }}"
    state: present
    resource_definition:
      apiVersion: v1
      kind: Node
      metadata:
        name: "{{ ansible_hostname }}"
      spec:
        taints:
        - key: "node-role.kubernetes.io/server"
          value: "true"
          effect: "NoSchedule"

- name: Set agent taints
  community.general.k8s:
    kubeconfig: "{{ kubeconfig_path }}"
    state: present
    resource_definition:
      apiVersion: v1
      kind: Node
      metadata:
        name: "{{ ansible_hostname }}"
      spec:
        taints:
        - key: "node-role.kubernetes.io/agent"
          value: "{{ rke2_type }}"
          effect: "NoSchedule"

- name: Copy RKE2 config file
  template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
  notify:
    - restart rke2

- name: Copy kubelet config file
  copy:
    src: kubelet.config
    dest: /etc/kubernetes/kubelet.config
  when: kubelet_config is defined
  notify:
    - restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: containerd-registry-config.toml
    dest: /etc/containerd/registry-config.toml
  when: containerd_registry_config is defined
  notify:
    - restart rke2

- name: Start RKE2 service
  service:
    name: rke2-server
    state: started
    enabled: yes
  register: rke2_service
  until: rke2_service is succeeded
  retries: 5
  delay: 10
  notify:
    - restart rke2

- name: Mask other RKE2 services
  command: systemctl mask "{{ item }}"
  loop:
    - rke2-agent
    - rke2-server
  when: ansible_facts['os_family'] == "RedHat" and rke2_type == "server"

- name: Wait for remaining nodes to be ready - no CNI
  command: kubectl get nodes --no-headers -o custom-columns=":metadata.name,:status.conditions[?(@.type=='Ready')].status"
  register: node_status
  until: "'True' in node_status.stdout"
  retries: 30
  delay: 10

- name: Wait for remaining nodes to be ready - with CNI
  command: kubectl get nodes --no-headers -o custom-columns=":metadata.name,:status.conditions[?(@.type=='Ready')].status,:status.conditions[?(@.type=='NetworkUnavailable')].status"
  register: node_cni_status
  until: "'True' in node_cni_status.stdout and 'False' in node_cni_status.stdout"
  retries: 30
  delay: 10

handlers:
  - name: restart rke2
    service:
      name: rke2-server
      state: restarted


