```yaml
- name: Check if the system is using EFI firmware
  stat:
    path: /sys/firmware/efi/efivars
  register: efi_check

- name: Remove grub.cfg if EFI
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_check.stat.exists

- name: Install user-defined template for GRUB
  template:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    owner: root
    mode: '0700'
  notify: update grub

- name: Add password to EFI GRUB configuration
  lineinfile:
    path: /etc/grub2-efi.cfg
    line: 'set superusers="root"'
    insertafter: EOF
  notify: update grub

- name: Add password to MBR GRUB configuration
  lineinfile:
    path: /etc/grub2.cfg
    line: 'set superusers="root"'
    insertafter: EOF
  notify: update grub

- name: Add --unrestricted option to specified files
  lineinfile:
    path: "{{ item }}"
    regexp: 'CLASS="([^"]+)"'
    line: 'CLASS="\1 --unrestricted"'
  loop: "{{ grub_password_unrestricted_files }}"
  when: grub_password_unrestricted is defined and
        grub_password_unrestricted | bool
  notify: update grub

handlers:
  - name: update grub
    command: grub2-mkconfig -o /boot/grub2/grub.cfg
```

### Key Corrections:
- The `when` condition in Task 6 was updated to include `is defined` to handle the case when `grub_password_unrestricted` is not defined.
- The overly long lines in the `when` condition of Task 6 were split for better readability and to adhere to the line length limit.


