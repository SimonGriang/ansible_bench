---
- name: Import assert.yml
  include: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: connection == 'network_cli'

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.ping:
      when: ansible_user != 'root'

    - name: Test sudo
      ansible.builtin.command: /bin/true
      become: yes
      become_user: root
      when: ansible_user != 'root'

- name: Gather bootstrap facts
  block:
    - name: Gather facts if preparation fails
      setup:
      when: preparation_failed | default(false)
  rescue:
    - name: Set preparation_failed fact
      set_fact:
        preparation_failed: true

- name: Install bootstrap packages (raw)
  block:
    - name: Install packages on Debian/Ubuntu
      raw: apt-get update && apt-get install -y {{ packages }}
      when: ansible_facts['os_family'] == 'Debian'

    - name: Install packages on RedHat/Fedora
      raw: yum install -y {{ packages }}
      when: ansible_facts['os_family'] == 'RedHat'

- name: Ensure libdnf5 is present on Fedora/RedHat
  package:
    name: libdnf5
    state: present
  when: ansible_facts['os_family'] == 'RedHat' and ansible_facts['distribution'] in ['Fedora', 'RedHat']

- name: Gather ansible facts
  setup:

- name: Install bootstrap packages (package)
  package:
    name: "{{ packages }}"
    state: present
    update_cache: yes


