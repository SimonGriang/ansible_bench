content='```yaml\n---\n- name: Import assert.yml\n  import_tasks: assert.yml\n  when: inventory_hostname == "localhost"\n\n- name: Install apache httpd\n  package:\n    name: "{{ httpd_packages }}"\n    state: present\n\n- name: Configure selinux\n  block:\n    - name: Set SELinux booleans\n      seboolean:\n        name: "{{ item.name }}"\n        state: "{{ item.state }}"\n        persistent: yes\n      loop: "{{ selinux_booleans }}"\n      when: ansible_selinux.status == "enabled"\n\n    - name: Allow connections to custom ports\n      seport:\n        ports: "{{ item }}"\n        proto: tcp\n        secontext: http_port_t\n        setype: http_port_t\n      loop: "{{ selinux_ports }}"\n      when: ansible_selinux.status == "enabled"\n\n- name: Configure httpd\n  template:\n    src: "{{ httpd_main_conf_src }}"\n    dest: "{{ httpd_main_conf_dest }}"\n  notify: \n    - test httpd configuration\n    - restart httpd\n\n- name: Activate httpd module | Debian\n  command: a2enmod {{ item }}\n  notify: \n    - test httpd configuration\n    - restart httpd\n  when: ansible_os_family == "Debian"\n  loop: "{{ apache_modules }}"\n\n- name: Import ssl.yml\n  import_tasks: ssl.yml\n  when: https_ssl_enabled\n\n- name: Import locations.yml\n  import_tasks: locations.yml\n  when: httpd_locations is defined\n\n- name: Import vhosts.yml\n  import_tasks: vhosts.yml\n  when: httpd_vhosts is defined\n\n- name: Configure ports\n  template:\n    src: "{{ ports_conf_src }}"\n    dest: "{{ ports_conf_dest }}"\n  notify: \n    - test httpd configuration\n    - restart httpd\n  when: ansible_os_family in ["Debian", "Suse"]\n\n- name: Import directories.yml\n  import_tasks: directories.yml\n  when: httpd_directories is defined\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Removing default html\n  file:\n    path: "{{ httpd_default_index }}"\n    state: absent\n  when: httpd_remove_example\n\n- name: Start and enable httpd\n  service:\n    name: "{{ httpd_service }}"\n    state: started\n    enabled: yes\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-03T07:42:01.237033957Z', 'done': True, 'done_reason': 'stop', 'total_duration': 11783483656, 'load_duration': 56661063, 'prompt_eval_count': 652, 'prompt_eval_duration': 357953239, 'eval_count': 504, 'eval_duration': 11368170525, 'model_name': 'phi4:14b'} id='run--61171c63-723c-46fc-b690-43026f8ed269-0' usage_metadata={'input_tokens': 652, 'output_tokens': 504, 'total_tokens': 1156}
