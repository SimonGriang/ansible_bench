        url: "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xABCDEF1234567890"
        state: present

    - name: Add repositories
      apt_repository:
        repo: "deb https://repo.url/debian {{ ansible_distribution_release }} main"
        state: present
  when: ansible_os_family == 'Debian'

- block:
    - name: Add key repositories
      yum_key:
        key: "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xABCDEF1234567890"
        state: present

    - name: Add repositories
      yum_repository:
        name: java_repo
        description: Java Repository
        baseurl: "https://repo.url/redhat/$releasever/$basearch/"
        gpgcheck: yes
  when: ansible_os_family == 'RedHat'

- name: Install required libraries
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ required_libraries }}"

- block:
    - name: Install Java, Debian
      apt:
        name: "openjdk-{{ java_version }}-jdk"
        state: present
        update_cache: yes
      register: java_install

    - name: Check Java installation status
      debug:
        msg: "Java installation status: {{ java_install }}"
  when: ansible_os_family == 'Debian'

- block:
    - name: Install Java, RedHat
      yum:
        name: "java-{{ java_version }}-openjdk"
        state: present
        update_cache: yes
      register: java_install

    - name: Check Java installation status
      debug:
        msg: "Java installation status: {{ java_install }}"
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  template:
    src: java_env.j2
    dest: /etc/profile.d/java_env.sh

- name: Source environment variables
  shell: "source /etc/profile.d/java_env.sh"

- block:
    - name: Correct java version selected for Java versions less than 11
      alternatives:
        name: java
        path: "/usr/lib/jvm/java-{{ java_version }}-openjdk-{{ ansible_architecture }}/bin/java"
      when: java_version | int < 11
  when: ansible_os_family == 'Debian'

- block:
    - name: Correct java version selected for Java versions greater than or equal to 11
      alternatives:
        name: java
        path: "/usr/lib/jvm/java-{{ java_version }}-openjdk-{{ ansible_architecture }}/bin/java"
      when: java_version | int >= 11
  when: ansible_os_family == 'Debian'


