---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Enable redis module stream (RHEL 8)
  package:
    name: "redis-{{ item }}"
    state: latest
  loop:
    - "redis-{{ 'stream' if ansible_distribution_version | is_version('8') else 'default' }}"
  when: ansible_os_family == 'RedHat' and ansible_distribution_version | is_version('8')

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: redis.conf.j2
    dest: "/etc/{{ item.directory }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  loop:
    - { directory: 'redis/redis.conf', owner: 'redis', group: 'redis', mode: '0644' }
  notify: Restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes


