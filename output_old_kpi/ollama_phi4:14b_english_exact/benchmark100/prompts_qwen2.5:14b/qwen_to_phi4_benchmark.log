  template:
    src: sysvinit.j2
    dest: "/etc/init.d/{{ item.name }}"
  loop: "{{ service_list }}"
  when: service_manager in ['sysvinit', 'upstart', 'openrc']

- name: Manage service
  service:
    name: "{{ item.name }}"
    state: "{{ item.state | default(omit) }}"
    enabled: "{{ item.enabled | default(omit) }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers


