```yaml
- name: Ensure the unzip package is available on the target system
  package:
    name: unzip
    state: present
  when: ansible_pkg_mgr in ['apt', 'yum']
  become: true

- name: Update package cache if specified
  package:
    update_cache: true
  when: ansible_pkg_mgr == 'apt' and update_cache is defined and update_cache
  become: true

- name: Create a system group for promtail
  group:
    name: promtail
    system: true
    state: present
  become: true

- name: Create the promtail user
  user:
    name: promtail
    group: promtail
    system: true
    create_home: no
    state: present
  become: true

- name: Ensure the /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
  become: true

- name: Create config directories
  file:
    path: /etc/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'
  become: true

- name: Create application directories
  file:
    path: /usr/local/promtail
    state: directory
    owner: promtail
    group: promtail
    mode: '0755'
  become: true

- name: Check if the promtail binary exists
  stat:
    path: /usr/local/bin/promtail
  register: promtail_binary

- name: Download promtail binaries
  get_url:
    url: "{{ promtail_download_url }}"
    dest: /usr/local/promtail/promtail.tar.gz
  when:
    - not promtail_binary.stat.exists
    - not promtail_distributed_locally
    - promtail_propagated
  become: true

- name: Propagate locally distributed promtail archive
  copy:
    src: "{{ promtail_local_archive }}"
    dest: /usr/local/promtail/promtail.tar.gz
  when:
    - not promtail_binary.stat.exists
    - promtail_distributed_locally
  become: true

- name: Download promtail binaries to controller node
  get_url:
    url: "{{ promtail_download_url }}"
    dest: /usr/local/promtail/promtail.tar.gz
  when:
    - not promtail_binary.stat.exists
    - not promtail_distributed_locally
    - promtail_propagated
  become: true

- name: Propagate promtail binaries
  copy:
    src: /usr/local/promtail/promtail
    dest: /usr/local/promtail/promtail
  when: promtail_propagated
  become: true

- name: Unpack promtail binaries
  unarchive:
    src: /usr/local/promtail/promtail.tar.gz
    dest: /usr/local/promtail
    remote_src: true
    creates: /usr/local/promtail/promtail
    mode: '0755'
  ignore_errors: true
  become: true

- name: Create symlink to latest version
  file:
    src: /usr/local/promtail/promtail
    dest: /usr/local/bin/promtail
    state: link
  notify: Restart promtail
  become: true

- name: Write configuration
  template:
    src: promtail.yaml.j2
    dest: /etc/promtail/promtail.yaml
    owner: promtail
    group: promtail
    mode: '0644'
  notify: Restart promtail
  become: true

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    owner: root
    group: root
    mode: '0644'
  notify: Restart promtail
  become: true

handlers:
  - name: Restart promtail
    service:
      name: promtail
      state: restarted
    become: true
```


