- name: Check if all variables are set correctly
  assert:
    that:
      - required_variable_1 is defined
      - required_variable_2 is defined
      - required_variable_3 is defined
    fail_msg: "Required variables are not set correctly."
    quiet: no

- name: Wait for host (when configured)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: "{{ bootstrap_wait_for_host_port }}"
    state: started
    timeout: 300
  when: bootstrap_wait_for_host | bool

- name: Prepare system
  block:
    - name: Establish connection and gather facts
      setup:
      register: gathered_facts
      ignore_errors: yes

    - name: Display debug message if connection failed
      debug:
        msg: "Connection to the host could not be established."
      when: gathered_facts is failed

    - name: Include tasks to gather bootstrap facts (raw)
      include_tasks: gather_bootstrap_facts_raw.yml

- name: Install bootstrap packages (raw)
  raw: "{{ bootstrap_install_raw_command }}"
  when:
    - ansible_os_family == 'RedHat' or ansible_os_family == 'Debian'
    - bootstrap_install_raw | bool

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_packages }}"
        state: present


