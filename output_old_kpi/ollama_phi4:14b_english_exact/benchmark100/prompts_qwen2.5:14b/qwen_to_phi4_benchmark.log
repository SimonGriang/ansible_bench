---
- name: Install Keepalived when HA mode is enabled
  apt:
    name: keepalived
    state: present
  when: 
    - ha_mode_enabled
    - "'rke2_server' in group_names"

- name: Download and install RKE2
  get_url:
    url: "https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2_{{ ansible_system }}_{{ ansible_architecture }}"
    dest: /usr/local/bin/rke2
    mode: '0755'

- name: Perform CIS Hardening
  include_role:
    name: cis_hardening
  when: cis_profile is defined

- name: Identify the active server in the RKE2 cluster
  shell: rke2 server list
  register: active_server
  changed_when: false

- name: Enable IPVS kernel module
  modprobe:
    name: ip_vs
    state: present
  when: 
    - use_kube_vip
    - ha_mode_enabled

- name: Copy kube-vip manifests to the masternode
  copy:
    src: kube-vip.yml
    dest: /etc/rancher/rke2/server/manifests/kube-vip.yml
  when: not use_keepalived

- name: Copy ingress-nginx manifests to the masternode
  copy:
    src: ingress-nginx.yml
    dest: /etc/rancher/rke2/server/manifests/ingress-nginx.yml
  when: ingress_nginx_config is defined

- name: Prepare the very first server node in the cluster
  block:
    - name: Initialize the first node
      shell: rke2 server start
      args:
        creates: /var/lib/rancher/rke2/server/db/agent-reg.sock

- name: Restore etcd specific tasks
  include_tasks: restore_etcd.yml
  when: restore_etcd is defined

- name: Download kubeconfig to ansible localhost
  fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: /tmp/rke2.yaml
  when: download_kubeconfig

- name: Prepare and join remaining nodes of the cluster
  block:
    - name: Setup join command
      shell: rke2 agent token create --server {{ active_server.stdout }}
      register: join_command
      changed_when: false
    - name: Join node to cluster
      shell: "{{ join_command.stdout }}"
  when: active_server.stdout is defined

- name: Perform rolling restart for servers when the RKE2 version changes
  block:
    - name: Cordon server nodes
      shell: kubectl cordon {{ item }}
      with_items: "{{ groups['rke2_servers'] }}"
    - name: Drain server nodes
      shell: kubectl drain {{ item }} --ignore-daemonsets --delete-local-data
      with_items: "{{ groups['rke2_servers'] }}"
    - name: Restart rke2 server
      shell: systemctl restart rke2-server
  when: rke2_version_changed

- name: Perform rolling restart for agents when the RKE2 version changes
  block:
    - name: Cordon agent nodes
      shell: kubectl cordon {{ item }}
      with_items: "{{ groups['rke2_agents'] }}"
    - name: Drain agent nodes
      shell: kubectl drain {{ item }} --ignore-daemonsets --delete-local-data
      with_items: "{{ groups['rke2_agents'] }}"
    - name: Restart rke2 agent
      shell: systemctl restart rke2-agent
  when: rke2_version_changed

- name: Flush all handlers at this point
  meta: flush_handlers

- name: Perform rolling restart when configuration files change
  block:
    - name: Cordon nodes
      shell: kubectl cordon {{ item }}
      with_items: "{{ groups['rke2_all'] }}"
    - name: Drain nodes
      shell: kubectl drain {{ item }} --ignore-daemonsets --delete-local-data
      with_items: "{{ groups['rke2_all'] }}"
    - name: Restart rke2 components
      shell: systemctl restart rke2-server rke2-agent
  when: config_files_changed

- name: Final steps to complete the playbook execution
  debug:
    msg: "Playbook execution completed."


