---
- name: Import assert.yml
  import_tasks: assert.yml
  when: ansible_play_hosts_all == ['localhost']

- name: Install logrotate
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  template:
    src: "{{ logrotate_config_file.j2 }}"
    dest: "{{ logrotate_config_directory }}/logrotate.conf"

- name: Generate logrotate.d files
  template:
    src: "logrotate_entry.j2"
    dest: "{{ logrotate_config_directory }}/logrotate.d/{{ item.filename }}"
  loop: "{{ logrotate_entries | selectattr('state', 'undefined') | selectattr('state', '!=', 'absent') | list }}"
  when: logrotate_entries is defined

- name: Remove logrotate.d files
  file:
    path: "{{ logrotate_config_directory }}/logrotate.d/{{ item.filename }}"
    state: absent
  loop: "{{ logrotate_entries | selectattr('state', 'equalto', 'absent') | list }}"
  when: logrotate_entries is defined

- name: Start logrotate
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service is defined


