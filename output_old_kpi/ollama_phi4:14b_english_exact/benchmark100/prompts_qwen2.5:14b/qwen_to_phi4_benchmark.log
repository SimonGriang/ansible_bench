---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    home: ""
    system: yes

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Download Vault binary
  unarchive:
    src: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    owner: root

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_stat

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: not vault_path_stat.stat.exists

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command: >
    openssl req -new -newkey rsa:4096 -days 1095 -nodes -x509
    -keyout {{ vault_data_directory }}/tls/key.pem
    -out {{ vault_data_directory }}/tls/cert.pem
    -subj "/CN={{ vault_domain_name }}"
  args:
    creates: "{{ vault_data_directory }}/tls/cert.pem"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  command: >
    capsh --cap=cap_ipc_lock=ep --addamb=cap_sys_admin --dropamb all -- -- exec /usr/bin/vault
  changed_when: false

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    mode: '0644'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'

- name: Copy Vault service file
  copy:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: '0644'
  notify: Daemon reload
  when: ansible_service_mgr == 'systemd'

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: '0644'
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


