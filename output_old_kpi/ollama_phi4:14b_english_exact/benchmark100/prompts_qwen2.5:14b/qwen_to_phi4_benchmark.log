---
- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.stat:
    path: /etc/os-release
  register: os_release_file

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ ansible_facts.os_family | lower }}"
    bootstrap_major_version: "{{ os_release_file.stat.content | regex_search('([0-9]+)\\..*$', 1) }}"
  loop: "{{ bootstrap_os_family_map }}"
  loop_control:
    loop_var: os_info

- name: gather_facts | Set bootstrap facts (II)
  set_fact:
    bootstrap_os_family: "{{ bootstrap_os_family_map[ansible_facts.distribution] | default(omit) }}"


