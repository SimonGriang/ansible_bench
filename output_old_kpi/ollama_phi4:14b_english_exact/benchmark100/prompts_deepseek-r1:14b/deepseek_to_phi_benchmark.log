- name: Create the RKE2 configuration directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server taints
  ansible.builtin.lineinfile:
    path: /etc/rancher/rke2/config.yaml
    line: "node-taint: {{ node_taint }}"
    state: present
  when: node_type == 'server'

- name: Set agent taints
  ansible.builtin.lineinfile:
    path: /etc/rancher/rke2/config.yaml
    line: "node-taint: {{ node_taint }}"
    state: present
  when: node_type == 'agent'

- name: Copy RKE2 configuration file
  ansible.builtin.copy:
    src: rke2-config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
    owner: root
    group: root
  notify: restart rke2

- name: Copy Kubelet configuration file
  ansible.builtin.copy:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0644'
    owner: root
    group: root
  when: kubelet_config is defined
  notify: restart rke2

- name: Copy Containerd Registry Configuration file
  ansible.builtin.copy:
    src: containerd-registry.conf
    dest: /etc/containerd/config.toml.d/10-registries.conf
    mode: '0644'
    owner: root
    group: root
  when: custom_registry_config is defined
  notify: restart rke2

- name: Start RKE2 service on other nodes
  ansible.builtin.service:
    name: rke2
    state: started
    enabled: true
  delegate_to: "{{ item }}"
  loop: "{{ groups['nodes'] }}"
  when: inventory_hostname != item
  notify: restart rke2

- name: Mask other RKE2 services on nodes
  ansible.builtin.service:
    name: rke2-{{ 'agent' if node_type == 'server' else 'server' }}
    enabled: false
  when: node_type == 'server' or node_type == 'agent'

- name: Wait for remaining nodes to be ready - no CNI
  ansible.builtin.wait_for:
    host: "{{ item }}"
    port: 6443
    state: started
    timeout: 300
  loop: "{{ groups['nodes'] }}"
  when: not cni_configured

- name: Wait for remaining nodes to be ready - with CNI
  ansible.builtin.wait_for:
    host: "{{ item }}"
    port: 10250
    state: started
    timeout: 300
  loop: "{{ groups['nodes'] }}"
  when: cni_configured
```

