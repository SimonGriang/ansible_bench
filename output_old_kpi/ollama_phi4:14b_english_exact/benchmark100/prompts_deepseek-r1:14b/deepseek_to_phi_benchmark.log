---
- name: Restart RKE2 service on {{ rke2_node_name }}
  ansible.builtin.service:
    name: rke2
    state: restarted
    enabled: yes
    daemon_reload: yes
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  ansible.builtin.command:
    cmd: kubectl get nodes --no-headers | awk '{ print $2 }' | grep -q 'Ready'
  register: rke2_nodes_ready
  until: rke2_nodes_ready.rc == 0
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_servers_group_name[0] }}"
  when: not ansible_check_mode

- name: Wait for all pods to be ready again
  ansible.builtin.command:
    cmd: kubectl get pods --all-namespaces --field-selector=status.phase!=Running --no-headers | awk '{ print $3 }' | grep -q '0/1'
  register: rke2_pods_ready
  until: rke2_pods_ready.rc == 0
  retries: 100
  delay: 15
  delegate_to: "{{ rke2_servers_group_name[0] }}"
  when:
    - not ansible_check_mode
    - rke2_wait_for_all_pods_to_be_ready

handlers:
  - name: Service (re)started
    ansible.builtin.service:
      name: rke2
      state: restarted


