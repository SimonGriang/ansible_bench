- name: Enable required Apache modules
  block:
    - name: Enable proxy module
      ansible.builtin.apt:
        name: libapache2-mod-proxy
        state: present
      when: ansible_facts['os_family'] == 'Debian'

    - name: Enable proxy_http module
      ansible.builtin.apt:
        name: libapache2-mod-proxy-http
        state: present
      when: ansible_facts['os_family'] == 'Debian'

    - name: Enable proxy module
      community.general.zypper:
        name: apache2-mod_proxy
        state: present
      when: ansible_facts['os_family'] == 'Suse'

    - name: Enable proxy_http module
      community.general.zypper:
        name: apache2-mod_proxy_http
        state: present
      when: ansible_facts['os_family'] == 'Suse'

- name: Configure Apache location configurations
  block:
    - name: Configure Apache locations
      ansible.builtin.template:
        src: location.conf.j2
        dest: "/etc/apache2/conf-available/{{ item.name }}.conf"
        mode: '0644'
      loop: "{{ httpd_locations }}"
      notify: Restart Apache

  handlers:
    - name: Restart Apache
      ansible.builtin.service:
        name: apache2
        state: restarted
```

