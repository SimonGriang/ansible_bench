---
- name: Import assertion file
  import_playbook: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install system requirements
  package:
    name: bash
    state: present

- name: Install OpenJDK Java
  package:
    name: "openjdk-{{ java_version }}-jdk"
    state: present
  when: java_vendor == "openjdk"

- name: Install Oracle Java RPM from local
  copy:
    src: "{{ oracle_java_rpm_path }}"
    dest: /tmp/oracle-java.rpm
  when: java_source == "local" and java_format == "rpm"
  notify: Install Oracle Java RPM

- name: Install Oracle Java DEB from local
  copy:
    src: "{{ oracle_java_deb_path }}"
    dest: /tmp/oracle-java.deb
  when: java_source == "local" and java_format == "deb"
  notify: Install Oracle Java DEB

- name: Install Oracle Java RPM from repository
  package:
    name: "oracle-java-{{ java_version }}-rpm"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure Oracle Java targz installation
  unarchive:
    src: "{{ oracle_java_targz_path }}"
    dest: /usr/local/
    remote_src: yes
  when: java_format == "targz" and java_vendor == "oracle"
  notify: Configure Oracle Java targz

- name: Install Oracle Java JCE policy
  copy:
    src: "{{ oracle_java_jce_policy_path }}"
    dest: "{{ oracle_java_install_dir }}/lib/security/"
  when: java_jce | bool and java_version == 8 and java_vendor == "oracle"
  notify: Install Oracle Java JCE policy

- name: Set Java alternative
  alternatives:
    name: java
    path: "{{ oracle_java_install_dir }}/bin/java"
  when: java_format == "targz" and ansible_distribution != "Alpine"

- name: Find Java home directory
  command: "readlink -f /usr/bin/java"
  register: java_home_path

- name: Set JAVA_HOME in environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home_path.stdout }}"
    create: yes


