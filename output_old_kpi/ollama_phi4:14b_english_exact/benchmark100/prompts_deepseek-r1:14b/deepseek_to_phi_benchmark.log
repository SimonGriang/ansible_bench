```yaml
- name: Create local SSH key directory for user
  ansible.builtin.file:
    path: "/home/{{ user_name }}/.ssh"
    state: directory
    owner: "{{ user_name }}"
    mode: '0750'

- name: Manage user account
  ansible.builtin.user:
    name: "{{ user_name }}"
    comment: "{{ user_comment }}"
    home: "{{ user_home }}"
    shell: "{{ user_shell }}"
    state: "{{ user_state }}"

- name: Set sudo options for user
  ansible.builtin.lineinfile:
    path: "/etc/sudoers.d/{{ user_name }}"
    line: "{{ user_name }} ALL=(ALL) NOPASSWD:ALL"
    create: true
    state: present
  when: user_sudo_access | default(false)

- name: Generate private SSH key for user
  ansible.builtin.command:
    cmd: "ssh-keygen -t rsa -b 2048 -f /home/{{ user_name }}/.ssh/id_rsa -N ''"
    creates: "/home/{{ user_name }}/.ssh/id_rsa"

- name: Generate public SSH key for user
  ansible.builtin.command:
    cmd: "ssh-keygen -y -f /home/{{ user_name }}/.ssh/id_rsa > /home/{{ user_name }}/.ssh/id_rsa.pub"
    creates: "/home/{{ user_name }}/.ssh/id_rsa.pub"

- name: Convert SSH key to ppk format for user
  ansible.builtin.command:
    cmd: "puttygen /home/{{ user_name }}/.ssh/id_rsa -o /home/{{ user_name }}/.ssh/id_rsa.ppk -O private"
    creates: "/home/{{ user_name }}/.ssh/id_rsa.ppk"

- name: Get or set the home directory for user
  set_fact:
    user_home: "{{ user_home | default('/home/' ~ user_name) }}"

- name: Create .ssh directory for user
  ansible.builtin.file:
    path: "{{ user_home }}/.ssh"
    state: directory
    mode: '0700'

- name: Deploy authorized keys for user
  ansible.builtin.copy:
    src: "{{ authorized_keys_path }}"
    dest: "{{ user_home }}/.ssh/authorized_keys"
    owner: "{{ user_name }}"
    mode: '0600'

- name: Remove unauthorized keys for user
  ansible.builtin.lineinfile:
    path: "{{ user_home }}/.ssh/authorized_keys"
    state: absent
    regexp: "{{ item }}"
  with_items: "{{ unauthorized_keys }}"

- name: Copy generated private SSH key for user
  ansible.builtin.copy:
    src: "/home/{{ user_name }}/.ssh/id_rsa"
    dest: "{{ user_home }}/.ssh/id_rsa"
    owner: "{{ user_name }}"
    mode: '0600'

- name: Check users password valid time for user
  ansible.builtin.command:
    cmd: "chage -l {{ user_name }}"
    register: chage_output

- name: Set users password valid time for user
  ansible.builtin.command:
    cmd: "chage -E {{ expiry_date }} {{ user_name }}"
