---
- name: Update apt cache
  apt:
    update_cache: yes
  when: ansible_os_family == "Debian"

- name: Update dnf cache
  dnf:
    update_cache: yes
  when: ansible_os_family == "RedHat"

- name: Install keepalived package
  package:
    name: keepalived
    state: present

- name: Create keepalived configuration directory
  file:
    path: /etc/keepalived
    state: directory
    mode: '0755'

- name: Create Kubernetes API health check script for Debian OS family
  copy:
    dest: /usr/local/bin/check_k8s_api.sh
    content: |
      #!/bin/bash
      # Script to check Kubernetes API server health
      curl -sf http://localhost:6443/healthz || exit 1
    mode: '0755'
  when: ansible_os_family == "Debian"
  notify:
    - restart keepalived

- name: Create Kubernetes API health check script for RedHat OS family
  copy:
    dest: /usr/local/bin/check_k8s_api.sh
    content: |
      #!/bin/bash
      # Script to check Kubernetes API server health
      curl -sf http://localhost:6443/healthz || exit 1
    mode: '0755'
  when: ansible_os_family == "RedHat"
  notify:
    - restart keepalived

- name: Create RKE2 Server health check script for Debian OS family
  copy:
    dest: /usr/local/bin/check_rke2_server.sh
    content: |
      #!/bin/bash
      # Script to check RKE2 server health
      curl -sf http://localhost:9345/v1/ping || exit 1
    mode: '0755'
  when: ansible_os_family == "Debian"
  notify:
    - restart keepalived

- name: Create RKE2 Server health check script for RedHat OS family
  copy:
    dest: /usr/local/bin/check_rke2_server.sh
    content: |
      #!/bin/bash
      # Script to check RKE2 server health
      curl -sf http://localhost:9345/v1/ping || exit 1
    mode: '0755'
  when: ansible_os_family == "RedHat"
  notify:
    - restart keepalived

- name: Create keepalived config file
  template:
    src: keepalived.conf.j2
    dest: /etc/keepalived/keepalived.conf
  notify:
    - restart keepalived

- name: Enable keepalived and make sure it is not masked
  systemd:
    name: keepalived
    enabled: yes
    masked: no
  notify:
    - restart keepalived

- name: Flush handlers
  meta: flush_handlers


