---
- name: Import assertion tasks
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install PHP packages
  package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  shell: "php -i | grep 'Loaded Configuration File' | awk -F' => ' '{print $2}'"
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  template:
    src: php.ini.j2
    dest: /etc/php.ini
    mode: '0644'
  notify: Restart httpd


