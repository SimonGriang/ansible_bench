---
- name: Generate a private SSL key using OpenSSL
  openssl_privatekey:
    path: "{{ ssl_key_path }}"
    size: 2048
    owner: "{{ ssl_key_owner }}"
    group: "{{ ssl_key_group }}"
    mode: '0600'

- name: Generate a Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ csr_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    common_name: "{{ common_name }}"
    owner: "{{ csr_owner }}"
    group: "{{ csr_group }}"
    mode: '0600'

- name: Generate a self-signed SSL certificate
  openssl_certificate:
    path: "{{ cert_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    csr_path: "{{ csr_path }}"
    provider: selfsigned
    owner: "{{ cert_owner }}"
    group: "{{ cert_group }}"
    mode: '0644'

- name: Create a PKCS#12 file
  openssl_pkcs12:
    dest: "{{ p12_path }}"
    privatekey_path: "{{ ssl_key_path }}"
    certificate_path: "{{ cert_path }}"
    export_password: "{{ p12_password }}"
    owner: "{{ p12_owner }}"
    group: "{{ p12_group }}"
    mode: '0600'

- name: Read the private key content
  slurp:
    path: "{{ ssl_key_path }}"
  register: ssl_key_content

- name: Read the certificate content
  slurp:
    path: "{{ cert_path }}"
  register: cert_content

- name: Combine private key and certificate into a single file
  copy:
    content: "{{ ssl_key_content.content | b64decode }}\n{{ cert_content.content | b64decode }}"
    dest: "{{ combined_path }}"
    owner: "{{ combined_owner }}"
    group: "{{ combined_group }}"
    mode: '0644'


