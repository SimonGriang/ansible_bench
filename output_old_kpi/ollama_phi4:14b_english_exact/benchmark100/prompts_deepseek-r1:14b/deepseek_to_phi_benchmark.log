- name: gather_facts | Lookup bootstrap facts
  ansible.builtin.command:
    cmd: cat /etc/os-release
  register: os_release_output

- name: gather_facts | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    distro_name: "{{ os_release_output.stdout_lines | selectattr('name', 'match', '^ID=') | map(attribute='split('=')[1]') | list | first }}"
    major_version: "{{ os_release_output.stdout_lines | selectattr('name', 'match', '^VERSION_ID=') | map(attribute='split('=')[1]') | list | first | regex_replace('^\\d+\\.\\d+', '\\1') }}"

- name: gather_facts | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    os_family: >-
      {% set distro_map = {
        'ubuntu': 'Debian',
        'debian': 'Debian',
        'centos': 'RedHat',
        'rhel': 'RedHat',
        'fedora': 'RedHat',
        'amazon': 'RedHat',
        'oracle': 'RedHat',
        'suse': 'Suse',
        'opensuse': 'Suse',
        'arch': 'Archlinux',
        'gentoo': 'Gentoo',
        'linuxmint': 'Debian'
      } %}
      {% if distro_name is defined %}
        {{ distro_map[distro_name] | default('Other') }}
      {% else %}
        'Other'
      {% endif %}


