    dest: /usr/local/bin/check_rke2_server.sh
    content: |
      #!/bin/bash
      # Script to check RKE2 server health
      curl -sf http://localhost:9345/v1/ping || exit 1
    mode: '0755'
  when: ansible_os_family == "Debian"
  notify:
    - restart keepalived

