```yaml
# install_openjdk.yml

- name: Set OpenJDK version
  ansible.builtin.set_fact:
    java_open_jdk_version: "11"
  when: ansible_facts['os_family'] == "RedHat"

- name: Include variables for OpenJDK installation
  ansible.builtin.include_vars:
    file: "openjdk_vars.yml"
    name: "openjdk_vars"

- name: Set OpenJDK home directory
  ansible.builtin.set_fact:
    java_open_jdk_home_dir: "{{ openjdk_vars['java_open_jdk_home_dir'] }}"

- name: Check if OpenJDK is installed
  ansible.builtin.stat:
    path: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}"
  register: java_installed

- block:
    - name: Install OpenJDK on Debian-based systems
      ansible.builtin.apt_repository:
        repo: "ppa:openjdk-r/ppa"
        state: present
      when: ansible_facts['os_family'] == "Debian"

    - name: Install OpenJDK package on Debian-based systems
      ansible.builtin.package:
        name: "openjdk-{{ java_open_jdk_version }}"
        state: present
      when: ansible_facts['os_family'] == "Debian"

    - name: Import OpenJDK GPG key on RedHat-based systems
      ansible.builtin.apt_key:
        url: "https://adoptopenjdk.jfrog.io/adoptopenjdk/api/gpg/key/public"
        state: present
      when: ansible_facts['os_family'] == "RedHat"

    - name: Add OpenJDK repository on RedHat-based systems
      ansible.builtin.yum_repository:
        name: "AdoptOpenJDK"
        description: "AdoptOpenJDK YUM repo"
        baseurl: "https://adoptopenjdk.jfrog.io/adoptopenjdk/deb/openjdk8"
        gpgcheck: yes
        gpgkey: "https://adoptopenjdk.jfrog.io/adoptopenjdk/api/gpg/key/public"
      when: ansible_facts['os_family'] == "RedHat"

    - name: Install OpenJDK package on RedHat-based systems
      ansible.builtin.package:
        name: "adoptopenjdk-8-hotspot"
        state: present
      when: ansible_facts['os_family'] == "RedHat"

  when: not java_installed.stat.exists

- name: Create OpenJDK config file
  ansible.builtin.template:
    src: "openjdk_config.j2"
    dest: "/etc/profile.d/openjdk.sh"
    mode: '0755'
```

```yaml
# import_certs.yml

- name: Set Java certificate directory
  ansible.builtin.set_fact:
    java_cert_dir: "/usr/local/share/ca-certificates/java"

- name: Ensure Java certificate directory exists
  ansible.builtin.file:
    path: "{{ java_cert_dir }}"
    state: directory

- name: Import Java certificates
  ansible.builtin.set_fact:
    java_certs_imported: false

- name: Import each certificate
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "{{ java_cert_dir }}/{{ item | basename }}"
    mode: '0644'
  loop: "{{ java_certs }}"
  notify: update-ca-certificates

- name: Update CA certificates
  ansible.builtin.command: update-ca-certificates
  when: java_certs_imported == false
  notify:
    - set_fact java_certs_imported true

- name: Check Java version
  ansible.builtin.set_fact:
    java_version: "{{ lookup('pipe', 'java -version 2>&1 | head -n 1 | cut -d\"\" -f2') }}"

- name: Configure alternatives for Java < 11
  ansible.builtin.alternatives:
    name: java
    path: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/jre/bin/java"
  when: java_version is version('11', '<')

- name: Configure alternatives for Java >= 11
  ansible.builtin.alternatives:
    name: java
    path: "/usr/lib/jvm/{{ java_open_jdk_home_dir }}/bin/java"
  when: java_version is version('11', '>=')
```


