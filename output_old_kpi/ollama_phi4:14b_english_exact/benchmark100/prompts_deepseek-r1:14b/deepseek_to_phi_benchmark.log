on': 11379435217, 'load_duration': 51354278, 'prompt_eval_count': 639, 'prompt_eval_duration': 356969936, 'eval_count': 540, 'eval_duration': 10969980121, 'model_name': 'phi4:14b'} id='run--f0499a9e-a975-4e41-92b8-7292190c0ace-0' usage_metadata={'input_tokens': 639, 'output_tokens': 540, 'total_tokens': 1179}
