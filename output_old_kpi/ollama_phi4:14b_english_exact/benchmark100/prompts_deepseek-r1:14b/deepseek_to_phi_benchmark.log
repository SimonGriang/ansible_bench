---
- name: Import additional tasks
  import_tasks: assert.yml

- name: Install DNS packages
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories for DNS data and configuration
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - { path: "{{ dns_data_dir }}", mode: "{{ dns_data_dir_mode }}", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }
    - { path: "{{ dns_config_dir }}", mode: "{{ dns_config_dir_mode }}", owner: "{{ dns_owner }}", group: "{{ dns_group }}" }

- name: Create DNS group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create DNS user
  user:
    name: "{{ dns_owner }}"
    system: true
    state: present

- name: Generate rndc key file
  shell: rndc-confgen -a -c "{{ dns_config_dir }}/rndc.key" -r /dev/urandom
  args:
    creates: "{{ dns_config_dir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_config_dir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: '0400'

- name: Get the hints/root file
  get_url:
    url: "https://www.internic.net/domain/named.root"
    dest: "{{ dns_data_dir }}/root.hints"
    mode: '0644'
  when: dns_caching_dns | bool

- name: Create zone files from templates
  template:
    src: "{{ item.template }}"
    dest: "{{ dns_data_dir }}/{{ item.zone_file }}"
  loop: "{{ dns_zones }}"
  notify: reload rndc

- name: Generate main DNS configuration file
  template:
    src: named.conf.j2
    dest: "{{ dns_config_dir }}/named.conf"
  notify: restart dns

- name: Create systemd override configuration files
  template:
    src: systemd-overrides.j2
    dest: "/etc/systemd/system/dns.service.d/override.conf"
  notify: reload systemd
  when: use_systemd | bool

- name: Start and enable DNS service
  service:
    name: dns
    state: started
    enabled: true


