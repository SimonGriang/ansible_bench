          state: present
        when: (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2'
               or ansible_distribution == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9', '10'])
             and epel_next | default(false)

    notify:
      - Update package cache


