---
- name: Import assert.yml
  include_tasks: assert.yml

- name: Pre-configure debian systems
  block:
    - name: Set debconf selections for postfix
      debconf:
        name: postfix
        question: '{{ item.question }}'
        value: '{{ item.value }}'
        vtype: '{{ item.vtype }}'
      loop: '{{ debconf_settings }}'

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: postfix_mysql_installed

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport
  notify:
    - rebuild postfix transport maps
    - validate postfix configuration

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
  notify:
    - reload postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    main_cf_facts_part1:
      recipient_restrictions: '{{ recipient_restrictions }}'
      sender_restrictions: '{{ sender_restrictions }}'

- name: Setting values for main.cf (2/2)
  set_fact:
    main_cf_facts_part2:
      mynetworks: '{{ mynetworks }}'
      mydestination: '{{ mydestination }}'
      relay_domains: '{{ relay_domains }}'
      other_settings: '{{ other_settings }}'

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - validate postfix configuration
    - restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - validate postfix configuration
    - restart postfix

- name: Creates cert/key directory
  file:
    path: '{{ item }}'
    state: directory
    owner: postfix
    group: postfix
    mode: '0700'
  loop:
    - /etc/postfix/tls/certs
    - /etc/postfix/tls/private

- name: Deploy Postfix TLS server certificate
  copy:
    src: '{{ tls_cert_source }}'
    dest: /etc/postfix/tls/certs/server.crt
  notify:
    - reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: '{{ tls_key_source }}'
    dest: /etc/postfix/tls/private/server.key
  notify:
    - reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: '{{ item.line }}'
    state: present
  loop: '{{ aliases }}'
  notify:
    - rebuild postfix aliases
    - reload postfix

- name: Configure sender_access
  lineinfile:
    path: /etc/postfix/sender_access
    line: '{{ item.line }}'
    state: present
  loop: '{{ sender_access }}'
  notify:
    - rebuild postfix sender_access
    - reload postfix

- name: Configure recipient_access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: '{{ item.line }}'
    state: present
  loop: '{{ recipient_access }}'
  notify:
    - validate postfix configuration
    - rebuild postfix recipient_access
    - reload postfix

- name: Place sasl_password_map
  copy:
    content: '{{ sasl_password_map_content }}'
    dest: /etc/postfix/sasl_password
  notify:
    - rebuild postfix sasl password map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes


