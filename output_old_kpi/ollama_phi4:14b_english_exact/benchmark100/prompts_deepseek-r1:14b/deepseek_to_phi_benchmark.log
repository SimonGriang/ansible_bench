```yaml
- name: Create docroot for each vhost
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when: item.documentroot is defined and (item.create_docroot is not defined or item.create_docroot | default(true) | bool)
  loop_control:
    loop_var: item

- name: Configure vhosts
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: '0644'
  loop: "{{ httpd_vhosts }}"
  notify: 
    - Test httpd configuration validity
    - Restart httpd

handlers:
  - name: Test httpd configuration validity
    ansible.builtin.command:
      cmd: httpd -t

  - name: Restart httpd
    ansible.builtin.service:
      name: httpd
      state: restarted
```
