```yaml
- name: Check if Python is installed
  ansible.builtin.stat:
    path: /usr/bin/python
  register: python_path

- name: Check if Python3 is installed
  ansible.builtin.stat:
    path: /usr/bin/python3
  register: python3_path

- name: Debug Python executable path
  ansible.builtin.debug:
    msg: "Python executable path: {{ python_path.stat.path }}"
  when: python_path.stat.exists

- name: Debug Python3 executable path
  ansible.builtin.debug:
    msg: "Python3 executable path: {{ python3_path.stat.path }}"
  when: python3_path.stat.exists

- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install requirements
  ansible.builtin.package:
    name: "{{ openssl_requirements }}"
    state: present

- name: Ensure packaging is available via dnf
  ansible.builtin.package:
    name: python3-packaging
    state: present

- name: Install pip packages
  ansible.builtin.pip:
    name: "{{ openssl_pip_packages }}"
    state: present

- name: Create key directory
  ansible.builtin.file:
    path: "{{ openssl_key_directory }}"
    state: directory
    mode: "{{ openssl_key_directory_mode }}"
    owner: "{{ openssl_key_directory_owner }}"
    group: "{{ openssl_key_directory_group }}"

- name: Create csr directory
  ansible.builtin.file:
    path: "{{ openssl_csr_directory }}"
    state: directory
    mode: "{{ openssl_csr_directory_mode }}"
    owner: "{{ openssl_csr_directory_owner }}"
    group: "{{ openssl_csr_directory_group }}"

- name: Create crt directory
  ansible.builtin.file:
    path: "{{ openssl_crt_directory }}"
    state: directory
    mode: "{{ openssl_crt_directory_mode }}"
    owner: "{{ openssl_crt_directory_owner }}"
    group: "{{ openssl_crt_directory_group }}"

- name: Include create.yml
  ansible.builtin.include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: item
  when: item.condition
```

