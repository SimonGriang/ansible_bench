```yaml
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_facts['init_package'] == 'systemd'
    fail_msg: "The system does not use systemd as the init system."
    success_msg: "Systemd is being used as the init system."

- name: Get latest release and set promtail version
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
    force_basic_auth: no
  register: promtail_latest_release
  changed_when: false

- name: Set promtail_version variable based on latest release tag
  set_fact:
    promtail_version: "{{ promtail_latest_release.json.tag_name }}"

- name: Test if zip local archive exists and assert local binary exists
  assert:
    that:
      - promtail_local_archive is defined
      - promtail_local_archive.stat.exists
    fail_msg: "The specified local binary archive does not exist."
    success_msg: "Local binary archive is present."

- name: Get checksum list and set checksum for target architecture
  uri:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/promtail_{{ promtail_version }}_checksums.txt"
    return_content: yes
    force_basic_auth: no
  register: checksums_content
  changed_when: false

- name: Set checksum for target architecture
  set_fact:
    checksum: >-
      {{ checksums_content.content.splitlines()[architecture_index] }}
  vars:
    architecture_index: >-
      {{
        'amd64' in ansible_architecture and 0 or
        'arm64' in ansible_architecture and 1 or 0
      }}
```


