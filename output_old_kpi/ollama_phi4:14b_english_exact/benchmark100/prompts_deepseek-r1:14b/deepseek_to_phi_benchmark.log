```yaml
- name: Install EPEL GPG key
  ansible.builtin.package:
    name: gpg-utils
    state: present

- name: Add EPEL GPG key
  ansible.builtin.rpm_key:
    key: "{{ epel_gpg_key }}"
    state: present

- name: Install EPEL release package
  ansible.builtin.package:
    name: epel-release
    state: present
  when: >
    (ansible_facts['distribution'] == "Amazon" and
     ansible_facts['distribution_major_version'] == "2") or
    (ansible_facts['distribution'] == "RedHat" and
     ansible_facts['distribution_major_version'] in ["7", "8", "9"])
  notify: Update package cache

- name: Install EPEL next release package
  ansible.builtin.package:
    name: epel-next-release
    state: present
    src: "{{ epel_next_url }}"
  when: >
    epel_next is defined and
    epel_next | bool and
    ((ansible_facts['distribution'] == "Amazon" and
      ansible_facts['distribution_major_version'] == "2") or
     (ansible_facts['distribution'] == "RedHat" and
      ansible_facts['distribution_major_version'] in ["7", "8", "9"]))
  notify: Update package cache

handlers:
  - name: Update package cache
    ansible.builtin.package:
      update_cache: yes
```


