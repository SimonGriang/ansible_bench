ation': 57023419, 'prompt_eval_count': 569, 'prompt_eval_duration': 270402064, 'eval_count': 421, 'eval_duration': 8407017618, 'model_name': 'phi4:14b'} id='run--6b133dd2-d95b-463b-98ec-c63bd20b80c1-0' usage_metadata={'input_tokens': 569, 'output_tokens': 421, 'total_tokens': 990}
