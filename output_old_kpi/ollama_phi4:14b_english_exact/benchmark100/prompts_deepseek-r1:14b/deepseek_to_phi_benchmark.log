content='```yaml\n- name: Restart RKE2 service on {{ rke2_node_name }}\n  ansible.builtin.service:\n    name: rke2\n    state: restarted\n    enabled: yes\n    daemon_reload: yes\n  notify: Service (re)started\n\n- name: Wait for all nodes to be ready again\n  ansible.builtin.command:\n    cmd: kubectl get nodes --no-headers | awk \'{ print $2 }\' | grep -q \'Ready\'\n  register: rke2_nodes_ready\n  until: rke2_nodes_ready.rc == 0\n  retries: 100\n  delay: 15\n  delegate_to: "{{ rke2_servers_group_name[0] }}"\n  when: ansible_check_mode is not defined or ansible_check_mode | bool == false\n\n- name: Wait for all pods to be ready again\n  ansible.builtin.command:\n    cmd: kubectl get pods --all-namespaces --field-selector=status.phase!=Running --no-headers | awk \'{ print $3 }\' | grep -q \'0/1\'\n  register: rke2_pods_ready\n  until: rke2_pods_ready.rc == 0\n  retries: 100\n  delay: 15\n  delegate_to: "{{ rke2_servers_group_name[0] }}"\n  when:\n    - ansible_check_mode is not defined or ansible_check_mode | bool == false\n    - rke2_wait_for_all_pods_to_be_ready | bool\n\nhandlers:\n  - name: Service (re)started\n    ansible.builtin.service:\n      name: rke2\n      state: restarted\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-05T12:33:32.810614818Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6631504265, 'load_duration': 50368354, 'prompt_eval_count': 930, 'prompt_eval_duration': 36153450, 'eval_count': 344, 'eval_duration': 6544016035, 'model_name': 'phi4:14b'} id='run--f299ef13-1503-4866-89c8-7068eed18c3c-0' usage_metadata={'input_tokens': 930, 'output_tokens': 344, 'total_tokens': 1274} 82%|████████▏ | 82/100 [1:12:53<19:01, 63.44s/it]
