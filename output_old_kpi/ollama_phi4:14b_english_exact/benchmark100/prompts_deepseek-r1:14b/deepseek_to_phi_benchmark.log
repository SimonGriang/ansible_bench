---
- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_check

- name: Check Helm version
  command: helm version --short
  register: helm_existing_version
  when: helm_check.stat.exists

- name: Set desired Helm version fact
  set_fact:
    desired_helm_version: "v3.10.0"  # Example version, adjust as needed

- name: Determine if Helm needs to be downloaded
  set_fact:
    helm_needs_download: "{{ not helm_check.stat.exists or helm_existing_version.stdout != desired_helm_version }}"

- name: Download helm
  unarchive:
    src: https://get.helm.sh/helm-{{ desired_helm_version }}-linux-amd64.tar.gz
    dest: /tmp
    remote_src: yes
    creates: "/tmp/helm-{{ desired_helm_version }}-linux-amd64/helm"
  register: helm_download
  when: helm_needs_download

- name: Copy helm binary into place
  copy:
    src: "/tmp/helm-{{ desired_helm_version }}-linux-amd64/helm"
    dest: /usr/local/bin/helm
    mode: '0755'
  become: yes
  when: helm_download is changed


