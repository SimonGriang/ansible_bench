        url: "http://example.com/rke2-artifacts.tar.gz"
        dest: "/var/lib/rancher/rke2/rke2-artifacts.tar.gz"
      register: download_result
      until: download_result is succeeded
      retries: 3
      delay: 5

    - name: Download RKE2 checksum and artifacts (local fallback)
      ansible.builtin.fetch:
        src: "files/rke2-artifacts.tar.gz"
        dest: "/var/lib/rancher/rke2/rke2-artifacts.tar.gz"
      when: download_result is failed
  when: not airgap_mode

- name: Copy local RKE2 artifacts
  ansible.builtin.copy:
    src: "files/rke2-artifacts.tar.gz"
    dest: "/var/lib/rancher/rke2/rke2-artifacts.tar.gz"
    mode: '0640'
  when: airgap_mode and implementation == 'copy'

- name: Airgap mode - additional images tarballs
  block:
    - name: Create directory for additional images tarballs
      ansible.builtin.file:
        path: "/var/lib/rancher/rke2-images"
        state: directory
        mode: '0755'

    - name: Copy additional images tarballs
      ansible.builtin.copy:
        src: "files/{{ item }}"
        dest: "/var/lib/rancher/rke2-images/{{ item }}"
      loop: "{{ additional_tarballs }}"
  when: airgap_mode and additional_tarballs is defined

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure RKE2 artifacts exist
      ansible.builtin.file:
        path: "/var/lib/rancher/rke2"
        state: directory
        mode: '0755'

    - name: Ensure RKE2 install script is executable
      ansible.builtin.file:
        path: "/usr/local/bin/rke2-install.sh"
        mode: '0755'

    - name: Set artifacts to read-only
      ansible.builtin.file:
        path: "/var/lib/rancher/rke2"
        mode: '0555'
  when: airgap_mode and implementation == 'exists'

- name: Populate service facts
  ansible.builtin.setup:
    filter: ansible_service_mgr

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: "/usr/local"
  register: local_fs_stats

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin"
  when: local_fs_stats.stat.pw_name == "root" and local_fs_stats.stat.pw_dir == "/usr"

- name: Check RKE2 version
  shell: |
    rke2 version
  register: rke2_version_output
  changed_when: false

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - "'rke2 v{{ (rke2_version_output.stdout | regex_replace(\".*rke2 version v(.*) \\(\", \"\\\\1\")) }}' != 'rke2 v{{ desired_version }}'"
    fail_msg: "Downgrade not allowed unless explicitly permitted."
    quiet: yes
  when: not allow_downgrade

- name: Run RKE2 install script
  ansible.builtin.command: "/usr/local/bin/rke2-install.sh"
  environment:
    RKE2_URL: "{{ rke2_url }}"
  when: airgap_mode

- name: Copy Custom Manifests
  ansible.builtin.template:
    src: "templates/{{ item.src }}"
    dest: "/etc/rancher/rke2/manifests/{{ item.dest }}"
  loop: "{{ custom_manifests }}"

- name: Copy Static Pods
  ansible.builtin.copy:
    src: "{{ static_pod_path }}"
    dest: "/etc/rancher/rke2/agent/pod-manifests/"
    mode: '0644'

- name: Copy RKE2 environment file
  ansible.builtin.template:
    src: "templates/rke2-env.j2"
    dest: "/etc/rancher/rke2/rke2-env"
    mode: '0644'
  when: environment_options is defined
