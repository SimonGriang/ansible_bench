        name: AdoptOpenJDK
        description: AdoptOpenJDK YUM repo
        baseurl: https://adoptopenjdk.jfrog.io/adoptopenjdk/deb/openjdk8
        gpgcheck: yes
        gpgkey: https://adoptopenjdk.jfrog.io/adoptopenjdk/api/gpg/key/public
      when: ansible_facts['os_family'] == "RedHat"

    - name: Install OpenJDK package on RedHat-based systems
      ansible.builtin.package:
