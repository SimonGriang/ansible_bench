---
- name: Import assert.yml
  include_tasks: assert.yml
  delegate_to: localhost

- name: Configure apk
  block:
    - name: Update apk cache
      apk:
        update_cache: yes
        state: present
      changed_when: false

    - name: Upgrade all packages with apk
      apk:
        state: latest
      changed_when: false

- name: Configure apt
  block:
    - name: Prevent upgrade for selected packages
      apt:
        name: "{{ item }}"
        state: hold
      loop:
        - package1
        - package2
      when: ansible_pkg_mgr == 'apt'

    - name: Update all software using apt
      apt:
        update_cache: yes
        upgrade: dist
        force_apt_get: yes
        cache_valid_time: 3600
      environment:
        DEBIAN_FRONTEND: noninteractive

- name: Update all software (dnf)
  block:
    - name: Exclude specific packages and update all software using dnf
      dnf:
        name: "*"
        state: latest
        exclude: "{{ exclude_packages }}"
      when: ansible_pkg_mgr == 'dnf'

- name: Update all software (pacman)
  block:
    - name: Update pacman cache
      pacman:
        update_cache: yes

    - name: Update all software using pacman
      pacman:
        upgrade: yes

- name: Configure yum
  block:
    - name: Update all software using dnf for CentOS/RHEL 6
      dnf:
        name: "*"
        state: latest
      when: 
        - ansible_distribution == 'CentOS'
        - ansible_distribution_major_version == '6'

    - name: Use yum and install yum-utils for non-CentOS/RHEL 6
      yum:
        name:
          - "*"
          - yum-utils
        state: latest
      when: 
        - ansible_distribution == 'CentOS'
        - ansible_distribution_major_version != '6'

- name: Update all software (zypper)
  block:
    - name: Update all software to latest version using zypper
      zypper:
        name: "*"
        state: latest
        update_cache: yes


