---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Set server taints
  command: >
    rke2 server node-taint add {{ item }}
  loop: "{{ rke2_server_node_taints }}"
  when: rke2_is_server

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_file_src }}"
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Restart RKE2

- name: Copy kubelet configuration file
  copy:
    src: "{{ rke2_kubelet_config_src }}"
    dest: /var/lib/rancher/rke2/data/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  when: rke2_kubelet_config is defined and rke2_kubelet_config | length > 0
  notify: Restart RKE2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_containerd_registries_src }}"
    dest: /etc/rancher/rke2/registries.yaml
    owner: root
    group: root
    mode: '0644'
  when: custom_registry_mirrors is defined or custom_containerd_config is defined
  notify: Restart RKE2

- name: Register etcd restore from file
  set_fact:
    etcd_restore_needed: true
  when: 
    - rke2_etcd_snapshot_file is defined
    - rke2_service_state == "stopped"

- name: Register etcd restore from S3
  set_fact:
    etcd_restore_needed: true
  when: 
    - rke2_etcd_s3_bucket is defined
    - rke2_etcd_s3_access_key is defined
    - rke2_etcd_s3_secret_key is defined
    - rke2_etcd_s3_endpoint is defined

- name: Restore etcd from file
  block:
    - name: Create restore directory
      file:
        path: /var/lib/rancher/rke2/etcd-snapshots
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/etcd-snapshots/snapshot.db
        owner: root
        group: root
        mode: '0644'

    - name: Run etcd restore command
      command: >
        rke2 etcd snapshot restore /var/lib/rancher/rke2/etcd-snapshots/snapshot.db
      environment:
        RKE2_TOKEN: "{{ rke2_token }}"
  when: etcd_restore_needed and rke2_etcd_snapshot_file is defined

- name: Restore etcd from S3
  block:
    - name: Run etcd restore command from S3
      command: >
        rke2 etcd snapshot restore {{ rke2_etcd_s3_bucket }}
        --access-key={{ rke2_etcd_s3_access_key }}
        --secret-key={{ rke2_etcd_s3_secret_key }}
        --endpoint={{ rke2_etcd_s3_endpoint }}
      environment:
        RKE2_TOKEN: "{{ rke2_token }}"
  when: etcd_restore_needed and rke2_etcd_s3_bucket is defined

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Restart RKE2

- name: Mask RKE2 agent service
  systemd:
    name: rke2-agent
    enabled: no
    masked: yes

- name: Wait for first server to be ready (no CNI)
  wait_for:
    timeout: 300
    msg: "Waiting for the first server to report sufficient resources and readiness"
  when: not rke2_cni_enabled

- name: Wait for first server to be ready (with CNI)
  wait_for:
    timeout: 600
    msg: "Waiting for the first server to report readiness with CNI"
  when: rke2_cni_enabled

- name: Restore etcd
  block:
    - name: Cleanup old nodes and secrets
      command: rke2 etcd snapshot cleanup
  when: etcd_restore_needed

- name: Set Active Server variable
  set_fact:
    active_server: "{{ groups['rke2_servers'][0] }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups['rke2_servers'] }}"


