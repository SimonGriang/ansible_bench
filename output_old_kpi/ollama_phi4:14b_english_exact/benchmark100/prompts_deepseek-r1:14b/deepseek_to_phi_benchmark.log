```yaml
- name: Migrate adoptopenjdk to temurin (if selected)
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Gather OS specific variables
  include_vars: "{{ item }}"
  with_items:
    - "{{ java_jdk_vendor }}/{{ ansible_distribution }}_{{ ansible_distribution_version }}.yml"

- name: Gather architecture specific variables
  include_vars: "{{ item }}"
  with_items:
    - "{{ ansible_architecture }}.yml"

- name: Set OS specific variables (I)
  set_fact:
    openjdk_version: "{{ openjdk_version | default('default_version') }}"
    java_repo: "{{ java_repo | default('default_repo') }}"
    java_libs: "{{ java_libs | default(['default_lib']) }}"

- name: Set OS and architecture specific variables (II)
  set_fact:
    java_install_path: "{{ java_install_path | default('/default/install/path') }}"
    java_package_name: "{{ java_package_name | default('default_package') }}"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_install_path }}/jdk"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_repository:
        repo: "{{ deprecated_repo }}"
        state: absent
    - name: Install extra apt tools
      apt:
        name: "{{ apt_tools }}"
        state: present
    - name: Add key repositories
      apt_key:
        url: "{{ key_repo_url }}"
        state: present
    - name: Add required repositories
      apt_repository:
        repo: "{{ required_repo }}"
        state: present
  when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      yum_key:
        key: "{{ key_repo }}"
        state: present
    - name: Add required repositories
      yum_repository:
        name: "{{ required_repo }}"
        description: "{{ repo_description }}"
        baseurl: "{{ repo_baseurl }}"
        gpgcheck: yes
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  package:
    name: "{{ java_libs }}"
    state: present

- name: Install Java, Debian
  apt:
    name: "{{ java_package_name }}"
    state: present
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ java_package_name }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  lineinfile:
    path: /etc/profile.d/java.sh
    line: 'export JAVA_HOME="{{ java_home }}"'
    create: yes

- name: Source environment variables
  shell: source /etc/profile.d/java.sh

- name: Correct java version selected for Java < 11
  alternatives:
    name: java
    path: "{{ java_home }}/jre/bin/java"
    link: /usr/bin/java
  when: ansible_distribution_version is version('< 11', '>=')

- name: Correct java version selected for Java >= 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    link: /usr/bin/java
  when: ansible_distribution_version is version('>= 11', '==')
```


