```yaml
- name: Install EPEL on compatible systems
  block:
    - name: Install EPEL GPG key
      ansible.builtin.rpm_key:
        key: "https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}"
        state: present
      when: (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2') or (ansible_distribution == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9', '10'])

    - name: Install EPEL-release package
      ansible.builtin.package:
        name: "{{ epel_url }}"
        state: present
      when: (ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2') or (ansible_distribution == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9', '10'])

    - name: Install EPEL-next-release package
      ansible.builtin.package:
        name: "{{ epel_next_url }}"
        state: present
      when: ((ansible_distribution == 'Amazon' and ansible_distribution_major_version == '2') or (ansible_distribution == 'RedHat' and ansible_distribution_major_version in ['7', '8', '9', '10'])) and (epel_next | default(false) | bool)

  notify:
    - Update package cache

handlers:
  - name: Update package cache
    ansible.builtin.package:
      update_cache: yes
