---
- name: Check if EFI firmware exists on the system
  stat:
    path: /sys/firmware/efi/efivars/
  register: efi_stat

- name: Remove GRUB configuration file on EFI systems
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_stat.stat.exists

- name: Install custom user template for GRUB
  template:
    src: 01_users.j2
    dest: /etc/grub.d/01_users
    mode: '0644'

- name: Add EFI password protection to GRUB
  lineinfile:
    path: /etc/grub2-efi.cfg
    line: 'set superusers="admin" password_pbkdf2=admin{{ " " + grub_password_hash }}'
    insertbefore: '^set timeout='
  when: efi_stat.stat.exists

- name: Add MBR password protection to GRUB
  lineinfile:
    path: /etc/grub2.cfg
    line: 'set superusers="admin" password_pbkdf2=admin{{ " " + grub_password_hash }}'
    insertbefore: '^set timeout='
  when: not efi_stat.stat.exists

- name: Add unrestricted access to GRUB password entries
  lineinfile:
    path: "{{ item }}"
    line: 'set superusers="admin" password_pbkdf2=admin{{ " " + grub_password_hash }} --unrestricted'
    insertbefore: '^set timeout='
  loop:
    - /etc/grub2-efi.cfg
    - /etc/grub2.cfg
  when: unrestricted_access | default(false)


