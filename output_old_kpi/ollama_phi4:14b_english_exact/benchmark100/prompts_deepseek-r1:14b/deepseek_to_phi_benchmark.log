---
- name: Validate all variables are set correctly
  hosts: localhost
  tasks:
    - name: Import and run assert.yml
      include_tasks: assert.yml

- name: Wait for host to be available
  hosts: all
  tasks:
    - name: Ensure the target host is reachable
      wait_for:
        port: "{{ target_port }}"
        timeout: "{{ timeout }}"

- name: Prepare system for bootstrap
  hosts: all
  tasks:
    - name: Test connection
      ping:

    - name: Handle connection failures
      fail:
        msg: "Connection to the host failed."
      when: ansible_failed is defined and ansible_failed

    - name: Gather facts
      setup:

    - name: Install raw bootstrap packages
      raw: "apt-get install -y {{ bootstrap_packages }}"

- name: Ensure system preparation with Ansible modules
  hosts: all
  tasks:
    - name: Gather facts
      setup:

    - name: Install packages based on OS family
      package:
        name: "{{ packages }}"
        state: present
      when: ansible_os_family == "{{ os_family }}"

    - name: Ensure system is fully prepared
      assert:
        that:
          - ansible_facts['distribution'] is defined
        msg: "System is not fully prepared."


