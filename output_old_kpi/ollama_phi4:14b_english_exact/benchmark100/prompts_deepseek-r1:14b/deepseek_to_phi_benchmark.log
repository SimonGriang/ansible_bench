---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  delegate_to: localhost

- name: Install git
  ansible.builtin.package:
    name: "{{ packages }}"
    state: "{{ state }}"

- name: Check if user exists
  ansible.builtin.user:
    name: "{{ user }}"
    state: "{{ user_state | default('present') }}"
  register: user_check
  failed_when: false
  changed_when: false

- name: Create git config directory
  ansible.builtin.file:
    path: "{{ git_config_dir }}"
    state: directory
    owner: "{{ user }}"
    group: "{{ user }}"
    mode: "{{ git_config_dir_mode }}"

- name: Place git configuration
  ansible.builtin.template:
    src: "{{ git_config_src }}"
    dest: "{{ git_config_dest }}"
    owner: "{{ user }}"
    group: "{{ user }}"
    mode: "{{ git_config_mode }}"

- name: Create repository destination
  ansible.builtin.file:
    path: "{{ repo_dest }}"
    state: directory
    owner: "{{ user }}"
    group: "{{ user }}"
    mode: "{{ repo_dest_mode }}"

- name: Clone all repositories
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ item.dest }}"
    version: "{{ item.version | default('main') }}"
  loop: "{{ repositories }}"
  become: true
  become_user: "{{ user }}"


