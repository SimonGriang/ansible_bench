```yaml
- name: Import assertion tasks
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install Python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy settings
  block:
    - name: Set pip index-url
      ini_file:
        path: /etc/pip.conf
        section: global
        option: index-url
        value: "{{ python_pip_proxy }}"
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  block:
    - name: Set pip trusted-host
      ini_file:
        path: /etc/pip.conf
        section: global
        option: trusted-host
        value: "{{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: latest
  when: not (ansible_distribution in ['Bookworm', 'Noble'] or
            ansible_os_family == 'Alpine')

- name: Install Python modules
  pip:
    name: >-
      {{ item if python_pip_modules[item].version is undefined
        else python_pip_modules[item].version }}
  loop: "{{ python_pip_modules.keys() }}"
  when: not (ansible_distribution in ['Bookworm', 'Noble'] or
            ansible_os_family == 'Alpine')
```
