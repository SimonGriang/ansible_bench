nt': 2086, 'prompt_eval_duration': 1383105615, 'eval_count': 1071, 'eval_duration': 22748877762, 'model_name': 'phi4:14b'} id='run--b69d4217-3d5c-4419-bac8-9f0f13d3e64f-0' usage_metadata={'input_tokens': 2086, 'output_tokens': 1071, 'total_tokens': 3157}
