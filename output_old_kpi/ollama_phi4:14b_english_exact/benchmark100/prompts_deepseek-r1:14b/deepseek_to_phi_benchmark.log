    - reload postfix

- name: Configure recipient_access
  lineinfile:
    path: /etc/postfix/recipient_access
    line: '{{ item.line }}'
    state: present
  loop: '{{ recipient_access }}'
  notify:
    - validate postfix configuration
    - rebuild postfix recipient_access
    - reload postfix

- name: Place sasl_password_map
  copy:
    content: '{{ sasl_password_map_content }}'
    dest: /etc/postfix/sasl_password
  notify:
    - rebuild postfix sasl password map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes
