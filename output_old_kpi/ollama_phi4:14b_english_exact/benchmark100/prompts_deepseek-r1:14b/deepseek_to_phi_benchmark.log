---
- name: Remove Docker GPG key from trusted.gpg.d directory
  ansible.builtin.file:
    path: /etc/apt/keyrings/docker.gpg
    state: absent

- name: Remove old Docker source list from sources.list.d directory
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Remove obsolete Docker packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: absent
  loop:
    - docker
    - docker-engine
    - docker.io
    - containerd
    - runc

- name: Remove legacy Docker repository file
  ansible.builtin.file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Install required dependencies
  ansible.builtin.apt:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present
    update_cache: yes

- name: Manage Docker repository
  ansible.builtin.deb822_repository:
    path: /etc/apt/sources.list.d/docker.list
    repo: |
      [docker]
      ArchiveURL={{ docker_archive_url }}
      Suite={{ docker_suite }}
      Components={{ docker_components }}
    state: "{{ 'present' if docker_add_repo else 'absent' }}"

- name: Flush handlers to update apt cache
  ansible.builtin.meta:
    flush_handlers: yes


