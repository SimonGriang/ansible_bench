---
- name: Include OS-specific variables
  include_vars:
    file: "{{ item }}"
  with_first_found:
    - files:
      - "{{ ansible_distribution }}_{{ ansible_distribution_major_version }}.yml"
      - "{{ ansible_os_family }}.yml"
      paths:
      - vars/

- name: Include OS family specific tasks
  include_tasks: "{{ item }}.yml"
  with_items:
    - "{{ ansible_os_family | lower }}"

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: ansible_version.full is version('2.12', '<') or not ansible_os_family in ['RedHat', 'Debian']

- name: Install Docker packages with downgrade option
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: yes
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: ansible_version.full is version('2.12', '>=')
         and ansible_os_family in ['RedHat', 'Debian']

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: docker_install_compose_plugin and
        (ansible_version.full is version('2.12', '<') or
         not ansible_os_family in ['RedHat', 'Debian'])

- name: Install docker-compose-plugin with downgrade option
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: yes
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: docker_install_compose_plugin and
        ansible_version.full is version('2.12', '>=')
        and ansible_os_family in ['RedHat', 'Debian']

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    state: directory
    mode: '0755'
  when: docker_daemon_options | length > 0

- name: Configure Docker daemon options
  copy:
    content: "{{ docker_daemon_options | to_nice_json }}"
    dest: /etc/docker/daemon.json
  notify: restart docker
  when: docker_daemon_options | length > 0

- name: Ensure Docker service is started and enabled
  service:
    name: docker
    state: "{{ service_state | default('started') }}"
    enabled: "{{ enabled | default('yes') }}"
  ignore_errors: "{{ ansible_check_mode }}"
  when: docker_service_manage

- name: Flush handlers to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose.yml tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group information
  command: getent group docker
  register: docker_group_info
  changed_when: false
  when: docker_users | length > 0

- name: Set fact for user modification
  set_fact:
    modify_user_group: true
  when: docker_users | length > 0 and
        (docker_group_info.stdout is not defined or not ansible_user_id in docker_group_info.stdout)

- name: Include docker-users.yml tasks
  include_tasks: docker-users.yml
  when: modify_user_group


