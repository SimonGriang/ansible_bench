  when: externally_managed_file_py312.stat.exists
  args:
    creates: /usr/lib/python3.12/EXTERNALLY-MANAGED.old

- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"

- name: Configure pip proxy
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: index-url
    value: "{{ python_pip_proxy }}"
  when: python_pip_proxy is defined

- name: Trust hosts
  community.general.ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ python_pip_trusted_host }}"
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
  when: python_pip_update and 
        ansible_distribution not in ['bookworm', 'noble'] and 
        ansible_os_family != 'Alpine'

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: present
  loop: "{{ python_pip_modules }}"
  when: ansible_distribution not in ['bookworm', 'noble'] and 
        ansible_os_family != 'Alpine'
```

### Key Corrections:
- **Line Length**: Split long conditional statements into multiple lines for better readability and to adhere to the line length limit.
- **Indentation and Formatting**: Ensured consistent indentation and formatting to meet YAML standards and lint requirements.


