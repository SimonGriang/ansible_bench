---
- name: HashiCorp Vault setup
  hosts: all
  become: yes
  tasks:
    - name: Install necessary packages
      package:
        name:
          - jq
          - curl
        state: present

    - name: Download Vault
      get_url:
        url: "https://releases.hashicorp.com/vault/1.8.4/vault_1.8.4_linux_amd64.zip"
        dest: "/tmp/vault.zip"

    - name: Unzip Vault
      unarchive:
        src: "/tmp/vault.zip"
        dest: "/usr/local/bin"
        remote_src: yes
        creates: "/usr/local/bin/vault"

    - name: Set Vault permissions
      file:
        path: "/usr/local/bin/vault"
        mode: '0755'

    - name: Create Vault directory
      file:
        path: "/etc/vault.d"
        state: directory
        owner: root
        group: root
        mode: '0755'

    - name: Create Vault configuration file
      template:
        src: vault.hcl.j2
        dest: "/etc/vault.d/vault.hcl"
        owner: root
        group: root
        mode: '0644'

    - name: Create systemd service file for Vault
      template:
        src: vault.service.j2
        dest: "/etc/systemd/system/vault.service"
        owner: root
        group: root
        mode: '0644'

    - name: Start and enable Vault service
      systemd:
        name: vault
        state: started
        enabled: yes


