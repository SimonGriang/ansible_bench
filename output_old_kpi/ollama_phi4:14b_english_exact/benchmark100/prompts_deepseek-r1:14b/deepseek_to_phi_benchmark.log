    bootstrap_distribution_major_version: "{{ item.value[1] | regex_search('^[0-9]+') }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: bootstrap_facts.stdout is search(item.value[2])
  become: "{{ become | default(false) }}"

- name: Map the OS family based on the determined distribution
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when: bootstrap_distribution == item.value[0]
  become: "{{ become | default(false) }}"


