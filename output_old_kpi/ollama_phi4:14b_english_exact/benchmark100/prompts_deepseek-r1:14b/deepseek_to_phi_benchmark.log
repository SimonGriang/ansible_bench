---
- name: Disable swap
  become: yes
  when: vault_hardening_disable_swap | bool
  block:
    - name: Disable swap immediately
      systemd:
        name: swap
        enabled: no
        state: stopped
    - name: Comment out swap entries in /etc/fstab
      lineinfile:
        path: /etc/fstab
        regexp: '^/dev/mapper/.*swap'
        line: '#{{ line }}'
      when: line is match('^(?!#)(.*swap.*)')
      with_lines: 'grep -v ^# /etc/fstab'
    - name: Comment out swap entries in /etc/crypttab
      lineinfile:
        path: /etc/crypttab
        regexp: '^.*swap'
        line: '#{{ line }}'
      when: line is match('^(?!#)(.*swap.*)')
      with_lines: 'grep -v ^# /etc/crypttab'

- name: Disable core dumps
  become: yes
  when: vault_hardening_disable_core_dumps | bool
  block:
    - name: Set core dump limits to 0 in pam.d files
      lineinfile:
        path: /etc/security/limits.d/90-vault-{{ item }}.conf
        create: yes
        line: "{{ item }} soft core 0\n{{ item }} hard core 0"
      loop:
        - '*'
        - '@vault'
        - 'vault'

- name: Disable Shell Command History
  become: yes
  when: vault_hardening_disable_shell_command_history | bool
  block:
    - name: Add exclusion rule to /etc/profile.d/vault.sh
      lineinfile:
        path: /etc/profile.d/vault.sh
        line: 'HISTIGNORE="$HISTIGNORE: vault*:"'
        create: yes

- name: Configure SELinux / AppArmor
  become: yes
  when: vault_hardening_configure_selinux_apparmor | bool
  block:
    - name: Ensure SELinux is enabled
      selinux:
        state: enforcing
    - name: Install SELinux policy packages
      package:
        name: policycoreutils-python-utils
        state: present
    - name: Install and enforce AppArmor profiles for Vault
      block:
        - name: Install AppArmor
          package:
            name: apparmor
            state: present
        - name: Enable AppArmor service
          systemd:
            name: apparmor
            enabled: yes
            state: started
        - name: Enforce AppArmor profile for Vault
          copy:
            src: vault
            dest: /etc/apparmor.d/usr.lib.vault
            owner: root
            group: root
            mode: '0644'
          notify: reload apparmor
  handlers:
    - name: reload apparmor
      service:
        name: apparmor
        state: reloaded


