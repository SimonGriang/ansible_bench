  import_playbook: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure SELinux
  block:
    - name: Manage SELinux settings
      selinux:
        state: "{{ selinux_state }}"
        policy: "{{ selinux_policy }}"
      notify: Reboot

    - name: Manage SELinux booleans
      selinux:
        name: "{{ item.key }}"
        state: "{{ item.value.state }}"
        persistent: "{{ item.value.persistent }}"
        label: "{{ item.key }}"
      loop: "{{ selinux_booleans | dict2items }}"
      when: selinux_booleans is defined
  when:
    - selinux_status is defined
    - ansible_connection not in ['container', 'docker', 'community.docker.docker']


