ost: "{{ item }}"\n    port: 10250\n    state: started\n    timeout: 300\n  loop: "{{ groups[\'nodes\'] }}"\n  when: cni_configured\n```\n\nThis playbook is designed to be included in an Ansible Role under the `tasks/` directory, specifically `tasks/main.yml`. It follows the given instructions and adheres to YAML and Ansible linting standards.' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-05T12:25:29.212980962Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13731507919, 'load_duration': 60506772, 'prompt_eval_count': 629, 'prompt_eval_duration': 356873144, 'eval_count': 661, 'eval_duration': 13312998809, 'model_name': 'phi4:14b'} id='run--626c17d2-1b1a-47df-8b12-36c4c157bfad-0' usage_metadata={'input_tokens': 629, 'output_tokens': 661, 'total_tokens': 1290}
