---
- name: Import assertion file
  ansible.builtin.include_role:
    name: assert.yml
  when: inventory_hostname == 'localhost'
  tags: assert

- name: Install cron package
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  ansible.builtin.lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^SHELL='
    line: 'SHELL=/bin/bash'
    state: present

- name: Configure cron path environment
  ansible.builtin.lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^PATH='
    line: 'PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    state: present

- name: Configure cron mailto settings
  ansible.builtin.lineinfile:
    path: /etc/cron.d/crontab
    regexp: '^MAILTO='
    line: 'MAILTO=root'
    state: present

- name: Start and enable cron service
  ansible.builtin.service:
    name: cron
    state: started
    enabled: yes
  when: cron_service is defined

- name: Schedule cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    user: "{{ item.user | default('root') }}"
    job: "{{ item.job }}"
  loop: "{{ cron_jobs }}"


