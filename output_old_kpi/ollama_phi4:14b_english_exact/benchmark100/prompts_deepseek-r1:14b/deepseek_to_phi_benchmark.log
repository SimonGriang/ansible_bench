    port: "{{ port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection == 'ssh' or ansible_connection == 'local'
  become: false

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.raw: echo "Testing connection"
      changed_when: false

    - name: Test sudo access
      ansible.builtin.raw: sudo -n true
      ignore_errors: true
      failed_when: false

    - name: Gather facts and install necessary packages
      ansible.builtin.raw: "{{ item }}"
      loop:
        - "sudo apt-get update"
        - "sudo apt-get install -y {{ required_packages }}"
      when: ansible_connection == 'ssh' or ansible_connection == 'local'
      become: true

    - name: Ensure libdnf5 is installed for RedHat systems
      ansible.builtin.package:
        name: libdnf5
        state: present
      when: ansible_os_family == "RedHat"
      become: true

- name: Gather ansible facts
  ansible.builtin.setup:
    become: false

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"
```

