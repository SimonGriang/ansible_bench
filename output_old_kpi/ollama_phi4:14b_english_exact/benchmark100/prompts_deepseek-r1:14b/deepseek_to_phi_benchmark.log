      with_lines: grep -v ^# /etc/crypttab

- name: Disable core dumps
  become: yes
  when: vault_hardening_disable_core_dumps | bool
  block:
    - name: Set core dump limits to 0 in pam.d files
      lineinfile:
        path: /etc/security/limits.d/90-vault-{{ item }}.conf
