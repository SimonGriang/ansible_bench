        RKE2_TOKEN: "{{ rke2_token }}"
  when: etcd_restore_needed and rke2_etcd_snapshot_file is defined

- name: Restore etcd from S3
  block:
    - name: Run etcd restore command from S3
      command: >
        rke2 etcd snapshot restore {{ rke2_etcd_s3_bucket }}
        --access-key={{ rke2_etcd_s3_access_key }}
        --secret-key={{ rke2_etcd_s3_secret_key }}
        --endpoint={{ rke2_etcd_s3_endpoint }}
      environment:
        RKE2_TOKEN: "{{ rke2_token }}"
  when: etcd_restore_needed and rke2_etcd_s3_bucket is defined

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Restart RKE2

- name: Mask RKE2 agent service
  systemd:
    name: rke2-agent
    enabled: false
    masked: true

- name: Wait for first server to be ready (no CNI)
  wait_for:
    timeout: 300
    msg: Waiting for the first server to report sufficient resources and readiness
  when: not rke2_cni_enabled

- name: Wait for first server to be ready (with CNI)
  wait_for:
    timeout: 600
    msg: Waiting for the first server to report readiness with CNI
  when: rke2_cni_enabled

- name: Restore etcd
  block:
    - name: Cleanup old nodes and secrets
      command: rke2 etcd snapshot cleanup
  when: etcd_restore_needed

- name: Set Active Server variable
  set_fact:
    active_server: "{{ groups['rke2_servers'][0] }}"
  delegate_to: "{{ item }}"
  loop: "{{ groups['rke2_servers'] }}"
```


