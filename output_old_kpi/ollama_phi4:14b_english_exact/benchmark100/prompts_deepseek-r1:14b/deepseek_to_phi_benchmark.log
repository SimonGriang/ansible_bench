- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      yum_key:
        key: "{{ key_repo }}"
        state: present

    - name: Add required repositories
      yum_repository:
        name: "{{ required_repo }}"
        description: "{{ repo_description }}"
        baseurl: "{{ repo_baseurl }}"
        gpgcheck: yes
  when: ansible_os_family == 'RedHat'

- name: Install required libs
  package:
    name: "{{ java_libs }}"
    state: present

- name: Install Java, Debian
  apt:
    name: "{{ java_package_name }}"
    state: present
  when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  yum:
    name: "{{ java_package_name }}"
    state: present
  when: ansible_os_family == 'RedHat'

- name: Export environment variables
  lineinfile:
    path: /etc/profile.d/java.sh
    line: 'export JAVA_HOME="{{ java_home }}"'
    create: yes

- name: Source environment variables
  shell: "source /etc/profile.d/java.sh"

- name: Correct java version selected for Java < 11
  alternatives:
    name: java
    path: "{{ java_home }}/jre/bin/java"
    link: /usr/bin/java
  when: ansible_distribution_version is version('< 11', '>=')

- name: Correct java version selected for Java >= 11
  alternatives:
    name: java
    path: "{{ java_home }}/bin/java"
    link: /usr/bin/java
  when: ansible_distribution_version is version('>= 11', '==')
```

**Changes Made:**
1. Fixed the syntax error by ensuring the shell command in Task 13 uses proper YAML syntax.
2. Shortened the line in Task 7 to adhere to the line-length limit.


