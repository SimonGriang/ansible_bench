---
- name: Generate an OpenSSL private key
  openssl_privatekey:
    path: "{{ key_directory }}/private_key.pem"
    size: 2048
    owner: "root"
    group: "root"
    mode: '0600'

- name: Generate an OpenSSL Certificate Signing Request (CSR)
  openssl_csr:
    path: "{{ csr_directory }}/csr.pem"
    privatekey_path: "{{ key_directory }}/private_key.pem"
    common_name: "{{ common_name }}"
    owner: "root"
    group: "root"
    mode: '0600'

- name: Generate an OpenSSL X.509 certificate
  openssl_certificate:
    path: "{{ cert_directory }}/certificate.pem"
    privatekey_path: "{{ key_directory }}/private_key.pem"
    csr_path: "{{ csr_directory }}/csr.pem"
    provider: selfsigned
    owner: "root"
    group: "root"
    mode: '0644'

- name: Generate a PKCS#12 file
  openssl_pkcs12:
    path: "{{ key_directory }}/keystore.p12"
    privatekey_path: "{{ key_directory }}/private_key.pem"
    certificate_path: "{{ cert_directory }}/certificate.pem"
    name: "{{ friendly_name }}"
    owner: "root"
    group: "root"
    mode: '0600'

- name: Read private key content
  slurp:
    src: "{{ key_directory }}/private_key.pem"
  register: private_key_content

- name: Read certificate content
  slurp:
    src: "{{ cert_directory }}/certificate.pem"
  register: certificate_content

- name: Create a combined private key and certificate file
  copy:
    dest: "{{ key_directory }}/combined_key_cert.pem"
    content: "{{ private_key_content['content'] | b64decode }}\n{{ certificate_content['content'] | b64decode }}"
    owner: "root"
    group: "root"
    mode: '0644'


