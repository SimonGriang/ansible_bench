    src: mysql_server.cnf.j2
    dest: /etc/mysql/my.cnf
  loop: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  template:
    src: mysql_client.cnf.j2
    dest: /etc/mysql/conf.d/client.cnf

- name: Initialize mysql
  include_tasks: initialize_mysql.yml
  when: ansible_distribution in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/my.cnf
    mode: '0644'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default('') }}"
    state: present
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers
  meta: flush_handlers


