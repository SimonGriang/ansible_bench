      sender_restrictions: '{{ sender_restrictions }}'

- name: Setting values for main.cf (2/2)
  set_fact:
    main_cf_facts_part2:
      mynetworks: '{{ mynetworks }}'
      mydestination: '{{ mydestination }}'
      relay_domains: '{{ relay_domains }}'
      other_settings: '{{ other_settings }}'

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
  notify:
    - validate postfix configuration
    - restart postfix

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
  notify:
    - validate postfix configuration
    - restart postfix

- name: Creates cert/key directory
  file:
    path: '{{ item }}'
    state: directory
    owner: postfix
    group: postfix
    mode: '0700'
  loop:
    - /etc/postfix/tls/certs
    - /etc/postfix/tls/private

- name: Deploy Postfix TLS server certificate
  copy:
    src: '{{ tls_cert_source }}'
    dest: /etc/postfix/tls/certs/server.crt
  notify:
    - reload postfix

- name: Deploy Postfix TLS server key
  copy:
    src: '{{ tls_key_source }}'
    dest: /etc/postfix/tls/private/server.key
  notify:
    - reload postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  lineinfile:
    path: /etc/aliases
    line: '{{ item.line }}'
    state: present
  loop: '{{ aliases }}'
  notify:
    - rebuild postfix aliases
    - reload postfix

- name: Configure sender_access
  lineinfile:
    path: /etc/postfix/sender_access
    line: '{{ item.line }}'
    state: present
  loop: '{{ sender_access }}'
  notify:
    - rebuild postfix sender_access
    - reload postfix

