---
- name: Import assertion tasks
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install Docker Compose package
  package:
    name: docker-compose
    state: present
  when: installation_type == "package"

- name: Install required packages for Docker Compose binary
  package:
    name: "{{ required_packages }}"
    state: present

- name: Download Docker Compose binary
  get_url:
    url: "{{ docker_compose_url }}"
    dest: /usr/local/bin/docker-compose
    mode: '0755'

- name: Make Docker Compose binary executable
  file:
    path: /usr/local/bin/docker-compose
    mode: '0755'
  when: installation_type == "binary"


