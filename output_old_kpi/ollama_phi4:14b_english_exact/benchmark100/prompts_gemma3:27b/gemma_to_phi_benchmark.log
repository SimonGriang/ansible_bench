    - rke2_active_server is defined
    - (inventory_hostname == rke2_active_server or inventory_hostname == groups['rke2_servers_group_name'][0])
    - (do_etcd_restore is defined or do_etcd_restore_from_s3 is defined)

- name: Download kubeconfig to ansible localhost
  include_tasks: download_kubeconfig.yaml
  when:
    - rke2_download_kubeconf | default(false)
    - inventory_hostname == groups['rke2_servers_group_name'][0]

- name: Prepare and join remaining nodes of the cluster
  include_tasks: remaining_nodes.yml
  when:
    - rke2_active_server is defined
    - groups['rke2_cluster_group_name'] | length >= 2

- name: Rolling cordon and drain restart when version changes - servers
  include_tasks: rolling_cordon_drain_servers.yml
  when:
    - rke2_installed_version is defined
    - rke2_installed_version != rke2_version
  loop:
    - "{{ groups['rke2_servers_group_name'] }}"
  loop_control:
    loop_var: server

- name: Rolling cordon and drain restart when version changes - agents
  include_tasks: rolling_cordon_drain_agents.yml
  when:
    - rke2_installed_version is defined
    - rke2_installed_version != rke2_version
    - "'rke2_servers_group_name' not in group_names"
  loop:
    - "{{ groups['rke2_agents_group_name'] }}"
  loop_control:
    loop_var: agent

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  include_tasks: rolling_restart.yml
  when: rke2_restart_needed | default(false)
  loop:
    - "{{ groups['rke2_cluster_group_name'] }}"
  loop_control:
    loop_var: node

- name: Final steps
  include_tasks: summary.yml
```

