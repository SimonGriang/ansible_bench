- name: Create directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_directories }}"
  loop_control:
    label: "{{ item }}"

- name: Configure directories
  ansible.builtin.template:
    src: directory.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item }}.conf"
    mode: '0644'
  loop: "{{ httpd_directories.split(',') | map('basename') | list }}"
  loop_control:
    label: "{{ item }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd


