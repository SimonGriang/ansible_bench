- name: Check OS compatibility
  gather_facts: yes
  tasks:
    - name: Check for Amazon Linux 2 or RedHat-based systems
      ansible.builtin.setup:
      when: >
        ((ansible_os_family == 'RedHat' and
          (ansible_distribution in ['RedHat', 'CentOS', 'Amazon']) and
          ansible_distribution_major_version in ['7', '8', '9', '10'])) or
        (ansible_distribution == 'Amazon' and ansible_distribution_version == '2')

- name: Install EPEL GPG key and packages
  gather_facts: yes
  tasks:
    - name: Install epel gpg key
      ansible.builtin.rpm_key:
        state: present
        key: "{{ epel_gpg_key }}"
      when: >
        ((ansible_os_family == 'RedHat' and
          (ansible_distribution in ['RedHat', 'CentOS', 'Amazon']) and
          ansible_distribution_major_version in ['7', '8', '9', '10'])) or
        (ansible_distribution == 'Amazon' and ansible_distribution_version == '2')

    - name: Install epel-release package
      ansible.builtin.package:
        name: epel-release
        state: present
        src: "{{ epel_url }}"
      notify: Update package cache
      when: >
        ((ansible_os_family == 'RedHat' and
          (ansible_distribution in ['RedHat', 'CentOS', 'Amazon']) and
          ansible_distribution_major_version in ['7', '8', '9', '10'])) or
        (ansible_distribution == 'Amazon' and ansible_distribution_version == '2')

    - name: Install epel-next-release package
      ansible.builtin.package:
        name: epel-next-release
        state: present
        src: "{{ epel_next_url }}"
      notify: Update package cache
      when: >
        epel_next and
        ((ansible_os_family == 'RedHat' and
          (ansible_distribution in ['RedHat', 'CentOS', 'Amazon']) and
          ansible_distribution_major_version in ['7', '8', '9', '10'])) or
        (ansible_distribution == 'Amazon' and ansible_distribution_version == '2')

  handlers:
    - name: Update package cache
      ansible.builtin.yum:
        update_cache: yes
```

