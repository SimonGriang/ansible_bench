---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  gather_facts: no

- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"
  register: user_check
  failed_when: user_check.failed and not fail_key

- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0644'

- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: '0755'

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}/{{ item.dest }}"
    version: "{{ item.version | default('main') }}"
    force: "{{ item.force | default(false) }}"
  loop: "{{ git_repositories }}"
  loop_control:
    label: "Cloning {{ item.dest }}"
  become: true
  become_user: "{{ git_username }}"


