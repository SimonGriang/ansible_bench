---
- name: Get all RKE2 nodes
  k8s_info:
    api_version: v1
    kind: Node
    kubeconfig: "{{ kubeconfig_file }}"
  register: all_nodes

- name: Set node names variable
  set_fact:
    node_names: "{{ all_nodes.resources | map(attribute='metadata.name') | list }}"

- name: Remove old RKE2 nodes
  k8s:
    kubeconfig: "{{ kubeconfig_file }}"
    state: absent
    definition:
      apiVersion: v1
      kind: Node
      metadata:
        name: "{{ item }}"
  with_items: "{{ node_names }}"
  when: item not in groups['rke2_cluster_group_name']
  ignore_errors: yes


