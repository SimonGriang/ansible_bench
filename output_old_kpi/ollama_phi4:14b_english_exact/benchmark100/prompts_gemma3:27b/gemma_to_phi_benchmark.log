on': 62375244, 'prompt_eval_count': 2097, 'prompt_eval_duration': 291689368, 'eval_count': 984, 'eval_duration': 22812468431, 'model_name': 'phi4:14b'} id='run--331c5470-d841-4131-9675-4a008cd93e9b-0' usage_metadata={'input_tokens': 2097, 'output_tokens': 984, 'total_tokens': 3081}
