```yaml
- name: Create the RKE2 config directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0755'
    owner: root
    group: root

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Copy rke2 config
  ansible.builtin.template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed

- name: Copy kubelet config
  ansible.builtin.template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  ansible.builtin.template:
    src: containerd-config.yaml.j2
    dest: /etc/rancher/rke2/registry.yaml
    owner: root
    group: root
    mode: '0644'
  notify: Config file changed
  when: >
        (rke2_custom_registry_mirrors | length > 0) or
        (rke2_custom_registry_configs | length > 0)

- name: Register if we need to do an etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: >
        rke2_etcd_snapshot_file is defined and
        (ansible_facts.services['rke2-server.service'] is not defined or
         ansible_facts.services['rke2-server.service']['state'] != 'running')

- name: Register if we need to do an etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: >
        rke2_etcd_snapshot_file is defined and
        rke2_etcd_snapshot_s3_options is defined and
        rke2_etcd_snapshot_s3_options.get('access_key') and
        rke2_etcd_snapshot_s3_options.get('secret_key') and
        rke2_etcd_snapshot_s3_options.get('bucket')

- name: Restore etcd from file
  block:
    - name: Create destination directory
      ansible.builtin.file:
        path: /var/lib/rancher/rke2/etcd-snapshots
        state: directory
        mode: '0755'
        owner: root
        group: root

    - name: Copy snapshot file
      ansible.builtin.copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/etcd-snapshots/snapshot.db
        owner: root
        group: root
        mode: '0644'

    - name: Run rke2 server with snapshot
      ansible.builtin.command:
        cmd: >
          rke2 server
          --server
          --data-dir /var/lib/rancher/rke2/server
          --snapshot-dir /var/lib/rancher/rke2/etcd-snapshots
  when: do_etcd_restore | default(false)

- name: Restore etcd from s3
  ansible.builtin.command:
    cmd: >
      rke2 server
      --server
      --data-dir /var/lib/rancher/rke2/server
      --snapshot-dir /var/lib/rancher/rke2/etcd-snapshots
      --snapshot-s3-access-key "{{ rke2_etcd_snapshot_s3_options.access_key }}"
      --snapshot-s3-secret-key "{{ rke2_etcd_snapshot_s3_options.secret_key }}"
      --snapshot-s3-bucket "{{ rke2_etcd_snapshot_s3_options.bucket }}"
      --snapshot-s3-endpoint "{{ rke2_etcd_snapshot_s3_options.endpoint | default(omit) }}"
  when: do_etcd_restore_from_s3 | default(false)

- name: Start RKE2 service on the first server
  ansible.builtin.service:
    name: rke2-server.service
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify: Service (re)started

- name: Mask RKE2 agent service on the first server
  ansible.builtin.systemd:
    name: rke2-agent.service
    enabled: false
    masked: true

- name: Wait for the first server to be ready - no CNI
  ansible.builtin.command: >
    kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}'
  register: kubectl_nodes_ready
  until: "'True' in kubectl_nodes_ready.stdout"
  retries: 30
  delay: 10
  when: not rke2_cni_plugin

- name: Wait for the first server to be ready - with CNI
  ansible.builtin.command: kubectl get nodes
  register: kubectl_nodes
  until: "'Ready' in kubectl_nodes.stdout"
  retries: 30
  delay: 10
  when: rke2_cni_plugin

- name: Restore etcd
  block:
    - name: Get registered nodes
      ansible.builtin.command: >
        kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
      register: registered_nodes

    - name: Get node names
      ansible.builtin.command: >
        kubectl get nodes -o jsonpath='{.items[*].metadata.name}'
      register: node_names

    - name: Remove old secrets and nodes
      ansible.builtin.command: >
        kubectl delete secrets --all && kubectl delete nodes --all
  when: do_etcd_restore | default(false)

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ ansible_hostname }}"
  delegate_to: "{{ groups[rke2_cluster_group_name] | first }}"
```
