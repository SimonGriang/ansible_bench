---
- name: Import assert.yml task file
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for host to be reachable
  wait_for:
    host: "{{ ansible_ssh_host | default(ansible_host | default(inventory_hostname)) }}"
    port: 22
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  become: "{{ ansible_become }}"
  when: ansible_connection != 'container' and ansible_connection != 'docker' and bootstrap_wait_for_host

- name: Prepare the system
  block:
    - name: Test connection
      wait_for_connection:
      register: bootstrap_connect

    - name: Debug if connection fails
      debug:
        var: bootstrap_timeout
      when: bootstrap_connect is failed

    - name: Gather bootstrap facts
      import_tasks: gather_facts.yml

- name: Install bootstrap packages
  raw: "{{ bootstrap_install_command }}"
  register: bootstrap_install_packages
  become: "{{ ansible_become }}"
  vars:
    ansible_user: "{{ bootstrap_user }}"
  changed_when: >
    (ansible_distribution in ['Alpine', 'Archlinux', 'Gentoo'] and 'expected_stdout_regex' in bootstrap_install_packages.stdout)
    or (ansible_distribution not in ['Debian', 'RedHat', 'Rocky', 'Suse'] and 'expected_stdout_regex' not in bootstrap_install_packages.stdout)

- name: Ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap__facts_packages }}"
        state: present
      notify: update cache


