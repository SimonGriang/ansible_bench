```yaml
- name: Create the RKE2 config directory
  ansible.builtin.file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == 'server'

- name: Set agent taints
  ansible.builtin.set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == 'agent'

- name: Copy RKE2 config
  ansible.builtin.template:
    src: rke2-config.yml.j2
    dest: /etc/rancher/rke2/config.yaml
    mode: '0644'
  notify: Restart RKE2 service

- name: Copy kubelet config
  ansible.builtin.template:
    src: kubelet-config.yml.j2
    dest: /etc/rancher/rke2/kubelet-config.yml
    mode: '0644'
  when: rke2_kubelet_config | length > 0
  notify: Restart RKE2 service

- name: Copy Containerd Registry Configuration file
  ansible.builtin.template:
    src: containerd-registry-config.yml.j2
    dest: /etc/rancher/rke2/registry.yml
    mode: '0644'
  when: >
    rke2_custom_registry_mirrors | length > 0 or
    rke2_custom_registry_configs | length > 0
  notify: Restart RKE2 service

- name: Start RKE2 service on the rest of the nodes
  ansible.builtin.systemd:
    name: rke2
    state: started
    enabled: true
    environment:
      RKE2_TOKEN: "{{ rke2_token }}"
  retries: 5
  delay: 10
  register: rke2_service_result
  notify: Restart RKE2 service

- name: Mask other RKE2 service on the rest of the nodes
  ansible.builtin.systemd:
    name: rke2-{{ item }}
    enabled: false
    masked: true
  loop:
    - server
    - agent
  when: rke2_type != item

- name: Wait for remaining nodes to be ready - no CNI
  ansible.builtin.shell: |
    kubectl get nodes -o json | jq -r '.items[] | select(.status.conditions[]?.type == "Ready" and .status.conditions[]?.status == "True") | .metadata.name'
  register: ready_nodes
  retries: 30
  delay: 10
  until: ready_nodes.stdout | length >= 1
  when: cni == 'none' and (inventory_hostname == rke2_active_server or inventory_hostname == rke2_first_server)

- name: Wait for remaining nodes to be ready - with CNI
  ansible.builtin.shell: |
    kubectl get nodes | grep -c ' Ready '
  register: ready_nodes_count
  retries: 30
  delay: 10
  until: ready_nodes_count.stdout | int >= groups['all'] | length
  when: cni != 'none' and (inventory_hostname == rke2_active_server or inventory_hostname == rke2_first_server)

handlers:
  - name: Restart RKE2 service
    ansible.builtin.systemd:
      name: rke2
      state: restarted
``` 

