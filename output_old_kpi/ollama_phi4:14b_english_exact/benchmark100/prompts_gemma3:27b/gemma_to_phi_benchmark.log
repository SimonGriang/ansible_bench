      register: sudo_check
      changed_when: false
  rescue:
    - name: Gather bootstrap facts
      setup:

    - name: Install bootstrap packages
      package:
        name: "{{ bootstrap_facts_packages | split(',') }}"
      when: bootstrap_facts_packages is defined
  become: false

- name: Gather ansible facts
  setup:
  become: false

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_facts_packages | split(',') }}"
  become: "{{ bootstrap_become }}"


