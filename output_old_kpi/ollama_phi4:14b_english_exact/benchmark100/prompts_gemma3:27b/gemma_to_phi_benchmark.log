```yaml
- name: Create ssh_key_directory for user
  file:
    path: "/home/{{ user_name }}/ssh_keys"
    state: directory
    mode: '0700'
  when: user.manage_ssh_key is defined and user.manage_ssh_key | bool
  delegate_to: localhost

- name: Manage user account
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default('present') }}"
    comment: "{{ user.comment | default(omit) }}"
    home: "{{ user.home | default(omit) }}"
    create_home: "{{ user.create_home | default('yes') }}"
    password: "{{ user.password | default(omit) }}"
    uid: "{{ user.uid | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    shell: "{{ user.shell | default(omit) }}"
    expires: "{{ user.expires | default(omit) }}"
  register: user_account

- name: Set sudo options for user
  template:
    src: sudoers.j2
    dest: "/etc/sudoers.d/{{ item.name }}"
    validate: /usr/sbin/visudo -cf %s
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.sudo_options is defined

- name: Remove sudo options for user
  file:
    path: "/etc/sudoers.d/{{ item.name }}"
    state: absent
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.sudo_options is not defined

- name: Generate private ssh key for user
  command: ssh-keygen -t rsa -N "" -f "/home/{{ user_name }}/ssh_keys/id_rsa"
  when: user.manage_ssh_key is defined and user.manage_ssh_key | bool
  delegate_to: localhost

- name: Generate public ssh key for user
  command: ssh-keygen -y -f "/home/{{ user_name }}/ssh_keys/id_rsa" > "/home/{{ user_name }}/ssh_keys/id_rsa.pub"
  when: user.manage_ssh_key is defined and user.manage_ssh_key | bool
  delegate_to: localhost

- name: Convert ssh key to ppk for user
  command: |
    ssh-keygen -P '' -f '/home/{{ user_name }}/ssh_keys/id_rsa' -e -m PKCS8
    > '/home/{{ user_name }}/ssh_keys/id_rsa.ppk'
  when: user.manage_ssh_key is defined and user.manage_ssh_key | bool
  delegate_to: localhost

- name: Get or set the home directory for user
  shell: getent passwd {{ user_name }} | cut -d: -f6
  register: user_home
  failed_when: user_home.stdout == ""
  changed_when: false

- name: Set base directory fact
  set_fact:
    base_dir: "{{ user_home.stdout | default('/home') }}"

- name: Create .ssh directory for user
  file:
    path: "{{ base_dir }}/{{ user_name }}/.ssh"
    state: directory
    mode: '0700'
  when: user.manage_ssh_key is defined or user.private_keys is defined
  become: yes
  become_user: "{{ user_name }}"

- name: Deploy authorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    state: present
    key: "{{ item }}"
  loop: "{{ user.authorized_keys }}"

- name: Remove unauthorized keys for user
  authorized_key:
    user: "{{ user.name }}"
    state: absent
    key: "{{ item }}"
  loop: "{{ user.unauthorized_keys }}"

- name: Copy generated private ssh key for user
  copy:
    src: "/home/{{ user_name }}/ssh_keys/id_rsa"
    dest: "{{ base_dir }}/{{ user_name }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user_name }}"
    group: "{{ user_name }}"
  when: user.copy_private_key is defined

- name: Check users password valid time
  shell: chage -l {{ user.name }} | grep 'Password expires' | cut -d: -f2
  register: password_valid_time
  changed_when: false

- name: Set users password valid time
  shell: chage -M {{ user.password_max_days }} {{ user.name }}

- name: Place private key file for user
  copy:
    content: "{{ user.private_keys.content }}"
    dest: "{{ base_dir }}/{{ user_name }}/.ssh/id_custom"
    mode: '0600'
    owner: "{{ user_name }}"
    group: "{{ user_name }}"
  when: user.private_keys is defined
```


