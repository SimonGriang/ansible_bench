ion': 333686999, 'eval_count': 377, 'eval_duration': 7291303002, 'model_name': 'phi4:14b'} id='run--7510820c-1cb2-42a5-bd76-787f48da9814-0' usage_metadata={'input_tokens': 611, 'output_tokens': 377, 'total_tokens': 988}
