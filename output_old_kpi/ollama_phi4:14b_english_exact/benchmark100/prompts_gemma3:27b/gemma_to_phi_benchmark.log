```yaml
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    system: yes
    create_home: no

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'

- name: Download Vault binary
  get_url:
    url: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_{{ vault_architecture }}.zip"
    dest: "{{ vault_download_path }}/vault.zip"

- name: Extract Vault binary
  unarchive:
    src: "{{ vault_download_path }}/vault.zip"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    creates: "{{ vault_download_path }}/vault"

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_check_path

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0755'
  when: not vault_check_path.stat.exists and vault_path is defined

- name: Create directory in vault_path
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner | default('vault_user') }}"
    group: "{{ item.group | default('vault_group') }}"
    mode: "{{ item.mode | default('0755') }}"
  loop: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item.path }}"
    state: directory
    owner: "{{ item.owner | default('vault_user') }}"
    group: "{{ item.group | default('vault_group') }}"
    mode: "{{ item.mode | default('0755') }}"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command: openssl req -new -newkey rsa:4096 -days 365 -nodes -x509 -subj "/CN=vault" -keyout tls.key -out tls.crt
  args:
    chdir: "{{ vault_data_directory }}/tls/"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item.path }}"
    state: file
    owner: "{{ item.owner | default('vault_user') }}"
    group: "{{ item.group | default('vault_group') }}"
    mode: "{{ item.mode | default('0600') }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "/usr/bin/vault"
    owner: root
    group: root
    mode: '0755'
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  capabilities:
    path: "/usr/bin/vault"
    capability: cap_ipc_lock=ep

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: '0644'
    mtime: "{{ ansible_date_time.epoch }}"
    atime: "{{ ansible_date_time.epoch }}"
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: "/usr/lib/systemd/system"
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Copy Vault service file
  copy:
    src: "vault.service.j2"
    dest: "/usr/lib/systemd/system/vault.service"
    owner: root
    group: root
    mode: '0644'
  notify: Daemon reload
  when: ansible_service_mgr == 'systemd'

- name: Copy vault configuration
  copy:
    src: "vault.hcl"
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: root
    group: root
    mode: '0644'
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers
``` 

