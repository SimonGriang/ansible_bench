---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_TIMEOUT='
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: yes
    mode: '0664'
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    regexp: '^GRUB_RECORDFAIL_TIMEOUT='
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: yes
    mode: '0664'
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    path: /etc/default/grub
    regexp: "^GRUB_CMDLINE_LINUX="
    line: "GRUB_CMDLINE_LINUX=\"{{ grub_cmdline_linux | default('') }} {{ item }}\""
    create: yes
    mode: '0664'
    validate: /usr/sbin/grub-mkconfig --dry-run
  loop: "{{ grub_options }}"
  loop_control:
    label: "{{ item }}"
  when: grub_options is defined and grub_options | length > 0
  notify: Update grub

- name: Import password.yml
  import_tasks: password.yml
  when: grub_set_password

- name: Flush handlers
  meta: flush_handlers


