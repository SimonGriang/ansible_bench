fined\n  with_items: "{{ promtail_checksum_list.content.splitlines() }}"\n  when: item == promtail_arch_entry\n```\n\n' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-07T09:30:44.005296394Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10545324770, 'load_duration': 62787820, 'prompt_eval_count': 653, 'prompt_eval_duration': 332655489, 'eval_count': 536, 'eval_duration': 10148243760, 'model_name': 'phi4:14b'} id='run--60b37e72-5818-4ec1-93d9-761740b05160-0' usage_metadata={'input_tokens': 653, 'output_tokens': 536, 'total_tokens': 1189}
