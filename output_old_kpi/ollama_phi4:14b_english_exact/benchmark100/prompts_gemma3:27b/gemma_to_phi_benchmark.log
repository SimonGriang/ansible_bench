```yaml
- name: Import tasks from assert.yml, running only once on localhost
  import_tasks: assert.yml

- name: Install using package
  block:
    - name: Install Hashicorp products using package manager
      package:
        name: "{{ item }}"
        state: present
      loop: "{{ hashicorp_products }}"
      when: hashicorp_installation_method == "package"

- name: Install repository for RedHat
  block:
    - name: Download Hashicorp repository file for RedHat-based systems
      get_url:
        url: "https://apt.releases.hashicorp.com/gpg"
        dest: "/etc/yum.repos.d/hashicorp.repo"
        mode: '0640'
      when: ansible_os_family in ['RedHat', 'Rocky']

- name: Configure Debian
  block:
    - name: Install required package gpg
      package:
        name: gpg
        state: present
      when: ansible_os_family == "Debian"

    - name: Install apt key for Debian
      apt_key:
        url: "https://apt.releases.hashicorp.com/gpg"
        state: present
        validate_certs: no
      when: ansible_os_family == "Debian"

    - name: Install repository for Debian
      apt_repository:
        repo: "deb https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
        filename: "hashicorp"
        state: present
        architectures: "{{ hashicorp_architecture_mapping[ansible_architecture] }}"
      when: ansible_os_family == "Debian"

- name: Install hashicorp product using package
  block:
    - name: Install latest hashicorp product using package
      package:
        name: "{{ item }}"
        state: latest
      loop: "{{ hashicorp_products }}"
      when: hashicorp_products is defined

    - name: Install versioned hashicorp product using package
      package:
        name: "{{ item.name }}{{ version_coupler }}{{ item.version | default('') }}"
        state: present
      loop: "{{ hashicorp_products }}"
      when: hashicorp_products is defined and item.version is defined

- name: Install manually
  block:
    - name: Install hashicorp product manually
      unarchive:
        src: "{{ hashicorp_src }}/{{ item }}"
        dest: "/usr/local/bin"
        remote_src: yes
        group: "{{ item.group | default(omit) }}"
        mode: "{{ item.mode | default(omit) }}"
        owner: "{{ item.owner | default(omit) }}"
      loop: "{{ hashicorp_products }}"
      when: hashicorp_installation_method == "manual"
```

