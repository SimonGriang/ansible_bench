---
- name: Assert systemd as init system
  assert:
    that:
      - ansible_facts.init_system == "systemd"
    fail_msg: "The target system is not using systemd as its init system."
    success_msg: "Systemd is confirmed as the init system."

- name: Get latest release
  uri:
    url: "https://api.github.com/repos/grafana/loki/releases/latest"
    method: GET
    headers:
      Authorization: "Bearer {{ lookup('env', 'GH_TOKEN') }}"
    body_format: json
    status_code: 200
    timeout: 10
    register: _latest_release
    until: _latest_release is success
    retries: 5
    delay: 5
  environment:
    GH_USER: "{{ lookup('env', 'GH_USER') }}"
    GH_TOKEN: "{{ lookup('env', 'GH_TOKEN') }}"

- name: Set promtail version to {{ _latest_release.json.tag_name[1:] }}
  set_fact:
    promtail_version: "{{ _latest_release.json.tag_name[1:] }}"
  when: promtail_version == "latest"

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/{{ promtail_version }}.zip"
  register: promtail_binary_local_archive

- name: Assert local binary exists
  assert:
    that:
      - promtail_binary_local_archive.stat.exists
    fail_msg: "The local promtail binary archive does not exist."
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  uri:
    url: "https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/SHA256SUMS"
    method: GET
    headers:
      Accept: "application/octet-stream"
    body_format: json
    status_code: 200
  register: promtail_checksum_list

- name: Get checksum for {{ go_arch }} architecture
  set_fact:
    __promtail_checksum: "{{ item.split(' ')[0] }}"
  vars:
    promtail_arch_entry: "{{ promtail_checksum_list.content.splitlines() | select('match', '^\\w+ [a-zA-Z0-9_-]+\\.(zip|tar.gz)$') | select('match', '^.*{{ go_arch }}.*$') | first }}"
  when: promtail_binary_local_dir is not defined
  with_items: "{{ promtail_checksum_list.content.splitlines() }}"
  when: item == promtail_arch_entry


