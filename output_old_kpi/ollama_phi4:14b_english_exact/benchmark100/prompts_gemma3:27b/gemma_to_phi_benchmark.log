        upgrade: yes
      notify:
        - Reboot
      when: ansible_pkg_mgr == 'pacman'

- name: Configure yum
  hosts: all
  tasks:
    - name: Handle yum version differences
      command: yum --version
      register: yum_version
      changed_when: false

