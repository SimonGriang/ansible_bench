': 'stop', 'total_duration': 11724881375, 'load_duration': 70531777, 'prompt_eval_count': 1316, 'prompt_eval_duration': 29260121, 'eval_count': 483, 'eval_duration': 11623851471, 'model_name': 'phi4:14b'} id='run--beea8c31-7912-401a-83d1-363b5ceddeea-0' usage_metadata={'input_tokens': 1316, 'output_tokens': 483, 'total_tokens': 1799}
