---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: /tmp/install-rke2.sh
    mode: '0755'
  when: not airgap_mode

- name: Copy local RKE2 installation script
  copy:
    src: "{{ local_rke2_install_script_path }}"
    dest: /tmp/install-rke2.sh
    mode: '0755'
  when: airgap_mode and rke2_installation_method == 'copy'

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_dir }}"
    state: directory
  when: airgap_mode and rke2_installation_method != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Attempt to download RKE2 artifacts and checksums remotely
      get_url:
        url: "{{ item.url }}"
        dest: "{{ item.dest }}"
      with_items:
        - url: "{{ rke2_artifact_url }}"
          dest: "{{ rke2_artifacts_dir }}/rke2-server.tar.gz"
        - url: "{{ rke2_checksum_url }}"
          dest: "{{ rke2_artifacts_dir }}/rke2-server.tar.gz.sha512"
  rescue:
    - name: Download locally and copy to remote hosts
      fetch:
        src: "{{ item.src }}"
        dest: "{{ item.dest }}"
        flat: yes
      with_items:
        - src: "{{ local_rke2_artifact_path }}"
          dest: "{{ rke2_artifacts_dir }}/rke2-server.tar.gz"
        - src: "{{ local_rke2_checksum_path }}"
          dest: "{{ rke2_artifacts_dir }}/rke2-server.tar.gz.sha512"
  when: airgap_mode

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
  with_items:
    - src: "{{ local_rke2_artifact_path }}"
      dest: "{{ rke2_artifacts_dir }}/rke2-server.tar.gz"
  when: airgap_mode and rke2_installation_method == 'copy'

- name: Airgap mode - additional images tarballs
  copy:
    src: "{{ additional_image_tarball_path }}"
    dest: "{{ rke2_artifacts_dir }}"
  when: airgap_mode and additional_image_tarballs is defined

- name: Airgap mode - ensure artifacts exist and have acceptable permissions
  file:
    path: "{{ rke2_artifacts_dir }}/{{ item }}"
    owner: root
    group: root
    mode: '0755'
  with_items:
    - rke2-server.tar.gz
    - rke2-server.tar.gz.sha512
  when: airgap_mode

- name: Populate service facts
  service_facts:

- name: Get stats of the FS object
  command: stat --format="%a %U %G" /usr/local
  register: fs_stats
  changed_when: false

- name: Check if separate partition
  set_fact:
    separate_partition: "{{ fs_stats.stdout.split()[1] == 'root' and fs_stats.stdout.split()[2] == 'root' }}"

- name: Set RKE2 bin path
  set_fact:
    rke2_bin_path: "/usr/local/bin"
  when: not separate_partition
  set_fact:
    rke2_bin_path: "/opt/rke2/bin"
  when: separate_partition

- name: Check RKE2 version
  command: "{{ rke2_bin_path }}/rke2 version"
  register: rke2_version_output
  changed_when: false

- name: Set RKE2 versions
  set_fact:
    rke2_installed_version: "{{ rke2_version_output.stdout_lines[0].split('Server Version: ')[1] }}"
    rke2_running_version: "{{ rke2_version_output.stdout_lines[1].split('Node Version: ')[1] }}"

- name: Prevent accidental RKE2 downgrade
  assert:
    that:
      - rke2_desired_version is version(rke2_installed_version, '>=')
    fail_msg: "Downgrade attempt detected. Ensure rke2_desired_version is not lower than the installed version."
    quiet: yes
  when: not allow_downgrade

- name: Run RKE2 install script
  shell: |
    export INSTALL_K3S_MIRROR="true"
    export INSTALL_K3S_SKIP_DOWNLOAD=true
    /tmp/install-rke2.sh
  args:
    executable: /bin/bash

- name: Copy Custom Manifests
  copy:
    src: "{{ item.src }}"
    dest: "{{ rke2_data_dir }}/{{ item.dest }}"
  with_items:
    - src: "{{ custom_manifest_path }}"
      dest: "manifests/99-custom.yaml"
  when: custom_manifests is defined

- name: Copy Static Pods
  copy:
    src: "{{ item.src }}"
    dest: "{{ rke2_agent_dir }}/{{ item.dest }}"
  with_items:
    - src: "{{ static_pod_manifest_path }}"
      dest: "10-server.yaml"
  when: static_pod_manifests is defined

- name: Copy RKE2 environment file
  template:
    src: "{{ rke2_env_file_template }}"
    dest: "{{ rke2_agent_dir }}/environment"
  vars:
    rke2_env_options: "{{ rke2_env_options }}"


