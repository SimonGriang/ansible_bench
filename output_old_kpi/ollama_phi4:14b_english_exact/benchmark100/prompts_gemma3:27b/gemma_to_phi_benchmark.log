- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  gather_facts: no

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  package:
    name: "openjdk-{{ java_version }}-java"
    state: present
  when: java_vendor == "openjdk"
  environment:
    USE: "java_vendor=openjdk"

- name: Install RPM
  copy:
    src: "{{ local_java_rpm_path }}"
    dest: /tmp/java_package.rpm
  package:
    name: /tmp/java_package.rpm
    state: present
  when: java_source == "local" and java_format == "rpm"

- name: Install DEB
  copy:
    src: "{{ local_java_deb_path }}"
    dest: /tmp/java_package.deb
  package:
    name: /tmp/java_package.deb
    state: present
  when: java_source == "local" and java_format == "deb"

- name: Install oracle java (rpm) (repository)
  package:
    name: "oracle-java{{ java_version }}-jdk"
    state: present
  when: java_source == "repository" and java_format == "rpm"

- name: Configure oracle targz
  block:
    - file:
        path: "{{ java_install_dir }}"
        state: directory
    - unarchive:
        src: "{{ java_targz_path }}"
        dest: "{{ java_install_dir }}"
        remote_src: yes
  when: java_format == "targz" and java_vendor == "oracle"

- name: Install oracle java policy software (targz)
  unarchive:
    src: "{{ java_jce_zip_path }}"
    dest: /usr/local/
    remote_src: yes
  when: java_jce and java_version == 8 and java_vendor == "oracle"

- name: Set alternative (targz)
  alternatives:
    name: java
    path: "{{ java_install_dir }}/bin/java"
  when: java_format == "targz" and ansible_os_family != "Alpine" and java_vendor == "oracle"

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java
  register: java_link
  changed_when: false
  check_mode: no

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: 'export JAVA_HOME="{{ java_link.stdout | dirname | dirname }}"'
    create: yes


