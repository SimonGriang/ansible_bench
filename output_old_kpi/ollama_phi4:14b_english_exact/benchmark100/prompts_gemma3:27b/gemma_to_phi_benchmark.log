---
- name: Include assert.yml
  include_tasks: assert.yml
  when: inventory_hostname == 'localhost'

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  block:
    - name: Set SELinux booleans for httpd
      selinux:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
      loop: "{{ httpd_sebooleans }}"
      when: ansible_selinux.status == "enabled"

    - name: Allow httpd to use custom ports
      selinux:
        policy: targeted
        state: present
        setsebool: "{{ item }}"
        value: true
      loop:
        - "httpd_can_network_connect_port_{{ httpd_port }}"
        - "httpd_can_network_connect_port_{{ httpd_ssl_port }}"
      when: ansible_selinux.status == "enabled"

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: '0644'
  notify:
    - Test httpd configuration
    - Restart httpd

- name: Activate httpd module | Debian
  command: a2enmod {{ item }}
  loop: "{{ httpd_modules_to_activate_with_command }}"
  when: ansible_os_family == "Debian"

- name: Include ssl.yml
  include_tasks: ssl.yml
  when: https_ssl_enable == true

- name: Include locations.yml
  include_tasks: locations.yml
  when: httpd_locations is defined

- name: Include vhosts.yml
  include_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: "{{ httpd_ports_conf.j2 }}"
    dest: "{{ httpd_server_root }}/ports.conf"
    mode: '0644'
  notify:
    - Test httpd configuration
    - Restart httpd
  when: ansible_os_family in ["Debian", "Suse"]

- name: Include directories.yml
  include_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  when: httpd_remove_example == true

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


