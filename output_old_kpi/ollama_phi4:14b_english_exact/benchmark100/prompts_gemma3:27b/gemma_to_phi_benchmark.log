```yaml
- name: Remove old Docker packages
  ansible.builtin.yum:
    name: "{{ docker_obsolete_packages }}"
    state: absent

- name: Add Docker GPG key
  ansible.builtin.rpm_key:
    key: "{{ docker_yum_gpg_key }}"
    state: present
  when: docker_add_repo | bool

- name: Add Docker repository
  ansible.builtin.get_url:
    url: "{{ docker_yum_repo_url }}"
    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    owner: root
    group: root
    mode: '0644'
  when: docker_add_repo | bool

- name: Configure Docker Nightly repo
  ansible.builtin.lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^enable_docker_nightly='
    line: "enable_docker_nightly={{ docker_yum_repo_enable_nightly }}"

- name: Configure Docker Test repo
  ansible.builtin.lineinfile:
    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"
    regexp: '^enable_docker_test='
    line: "enable_docker_test={{ docker_yum_repo_enable_test }}"

- name: Configure containerd on RHEL 8
  block:
    - name: Ensure runc is uninstalled
      ansible.builtin.yum:
        name: runc
        state: absent

    - name: Ensure container-selinux is installed
      ansible.builtin.yum:
        name: container-selinux
        state: present

    - name: Ensure containerd.io is installed
      ansible.builtin.yum:
        name: containerd.io
        state: present
  when: ansible_facts.distribution_major_version == 8
```

Explanation:
- The error message indicated a syntax issue, likely due to the use of a single quote for a number in the conditional expression (`'8'`). This was corrected by changing it to a numeric value (`8`).


