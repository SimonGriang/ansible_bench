---
- name: Import assert.yml
  include_tasks: assert.yml
  when: inventory_hostname == "localhost"

- name: Configure apk
  hosts: all
  tasks:
    - name: Update apk cache
      apk:
        update_cache: yes

    - name: Upgrade all software using apk
      apk:
        upgrade: yes
      notify:
        - Reboot

- name: Configure apt
  hosts: all
  tasks:
    - name: Prevent apt package upgrades
      copy:
        content: |
          {{ update_excluded_packages | join('\n') }}
        dest: /etc/apt/preferences.d/exclude-upgrade
        mode: '0644'
      when: update_excluded_packages is defined

    - name: Update apt cache
      apt:
        update_cache: yes

    - name: Upgrade all software using apt
      apt:
        upgrade: dist
      notify:
        - Reboot

    - name: Autoremove unused packages using apt
      apt:
        autoremove: yes
      when: apt_autoremove | default(true)

- name: Update all software (dnf)
  hosts: all
  tasks:
    - name: Update all software using dnf
      dnf:
        update_cache: yes
        upgrade: yes
        exclude: "{{ update_excluded_packages | join(' ') }}"
      notify:
        - Reboot
      when: ansible_pkg_mgr in ['dnf', 'dnf5']

- name: Update all software (pacman)
  hosts: all
  tasks:
    - name: Update all software using pacman
      pacman:
        update_cache: yes
        upgrade: yes
      notify:
        - Reboot
      when: ansible_pkg_mgr == 'pacman'

- name: Configure yum
  hosts: all
  tasks:
    - name: Handle yum version differences
      command: yum --version
      register: yum_version
      changed_when: false

    - name: Update all software using yum (version 6)
      yum:
        update_cache: yes
        upgrade: yes
        exclude: "{{ update_excluded_packages | join(' ') }}"
      notify:
        - Reboot
      when: yum_version.stdout is search('release 6')

    - name: Update all software using yum (other versions)
      yum:
        update_cache: yes
        upgrade: yes
        exclude: "{{ update_excluded_packages | join(' ') }}"
      notify:
        - Reboot
      when: ansible_pkg_mgr == 'yum' and not yum_version.stdout is search('release 6')

- name: Update all software (zypper)
  hosts: all
  tasks:
    - name: Update all software using zypper
      zypper:
        refresh: yes
        update: yes
      notify:
        - Reboot
      when: ansible_pkg_mgr == 'zypper'


