---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost

- name: Pre-configure debian systems
  hosts: Debian
  tasks:
    - name: Pre-configure postfix on Debian systems
      debconf:
        name: postfix
        question: postfix/mailname
        value: "{{ postfix_mailname }}"
        vtype: string
      when: ansible_os_family == 'Debian'

    - name: Set mailer type to "No configuration"
      debconf:
        name: postfix
        question: postfix/main_mailer_type
        value: "No configuration"
        vtype: select
      when: ansible_os_family == 'Debian'

- name: Install postfix
  hosts: all
  tasks:
    - name: Install postfix package
      package:
        name: postfix
        state: present

- name: Install postfix-mysql
  hosts: all
  tasks:
    - name: Install postfix-mysql package
      package:
        name: postfix-mysql
        state: present
      when: postfix_virtual_mailbox_maps or postfix_virtual_alias_maps or postfix_virtual_mailbox_domains use mysql

- name: Configure postfix (transport_maps)
  hosts: all
  tasks:
    - name: Configure transport_maps file
      template:
        src: "{{ postfix_transport_maps_template }}"
        dest: /etc/postfix/transport
      notify:
        - validate postfix configuration
        - rebuild transport db
      when: postfix_transport_maps_template is defined

- name: Configure postfix (header_checks)
  hosts: all
  tasks:
    - name: Configure header_checks file
      template:
        src: "{{ postfix_header_checks_template }}"
        dest: /etc/postfix/header_checks
      notify:
        - validate postfix configuration
        - reload postfix
      when: postfix_header_checks_template is defined

- name: Setting values for main.cf (1/2)
  hosts: all
  tasks:
    - name: Set facts for main.cf template
      set_fact:
        main_cf_facts: "{{ main_cf_facts | default({}) | combine({ item.key: item.value }) }}"
      with_dict: "{{ postfix_main_cf }}"
      when: item.value is defined

- name: Setting values for main.cf (2/2)
  hosts: all
  tasks:
    - name: Set more facts for main.cf template
      set_fact:
        main_cf_facts: "{{ main_cf_facts | combine({ item.key: item.value | default('') }) }}"
      with_dict: "{{ postfix_main_cf_extra }}"
      when: item.value is defined

- name: Configure postfix (main.cf)
  hosts: all
  tasks:
    - name: Configure main.cf file
      template:
        src: "{{ postfix_main_cf_template }}"
        dest: /etc/postfix/main.cf
      notify:
        - validate postfix configuration
        - restart postfix

- name: Configure postfix (master.cf)
  hosts: all
  tasks:
    - name: Configure master.cf file
      template:
        src: "{{ postfix_master_cf_template }}"
        dest: /etc/postfix/master.cf
      notify:
        - validate postfix configuration
        - restart postfix

- name: Creates cert/key directory
  hosts: all
  tasks:
    - name: Create directory for TLS certificate and key
      file:
        path: "{{ postfix_tls_cert_key_dir }}"
        state: directory
        mode: '0755'
      when: postfix_tls_cert_key_dir is defined

- name: Deploy Postfix TLS server certificate
  hosts: all
  tasks:
    - name: Deploy TLS server certificate
      copy:
        src: "{{ postfix_tls_server_cert }}"
        dest: /etc/ssl/certs/ssl-cert-snakeoil.pem
      when: postfix_tls_server_cert is defined

- name: Deploy Postfix TLS server key
  hosts: all
  tasks:
    - name: Deploy TLS server key
      copy:
        src: "{{ postfix_tls_server_key }}"
        dest: /etc/ssl/private/ssl-cert-snakeoil.key
      when: postfix_tls_server_key is defined

- name: Flush handlers
  hosts: all
  tasks:
    - name: Flush all registered handlers
      meta: flush_handlers

- name: Configure aliases
  hosts: all
  tasks:
    - name: Configure postfix aliases
      template:
        src: "{{ postfix_aliases_template }}"
        dest: /etc/postfix/aliases
      notify:
        - reload postfix aliases
      when: postfix_aliases is defined

- name: Configure sender_access
  hosts: all
  tasks:
    - name: Configure sender_access file
      template:
        src: "{{ postfix_sender_access_template }}"
        dest: /etc/postfix/sender_access
      notify:
        - reload postfix
      when: postfix_sender_access is defined

- name: Configure recipient_access
  hosts: all
  tasks:
    - name: Configure recipient_access file
      template:
        src: "{{ postfix_recipient_access_template }}"
        dest: /etc/postfix/recipient_access
      notify:
        - reload postfix
      when: postfix_recipient_access is defined

- name: Place sasl_password_map
  hosts: all
  tasks:
    - name: Create or update sasl_password_map file
      copy:
        content: "{{ postfix_sasl_password_map }}"
        dest: /etc/postfix/sasl_password
        mode: '0600'
      when: postfix_sasl_password_map is defined

- name: Flush handlers again
  hosts: all
  tasks:
    - name: Flush all registered handlers
      meta: flush_handlers

- name: Start and enable postfix
  hosts: all
  tasks:
    - name: Start and enable postfix service
      service:
        name: postfix
        state: started
        enabled: true


