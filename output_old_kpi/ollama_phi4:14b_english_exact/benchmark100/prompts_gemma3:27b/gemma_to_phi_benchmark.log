---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when:
    - ansible_connection is defined
    - ansible_connection != 'docker'
    - ansible_connection != 'podman'
    - bootstrap_wait_for_host | bool

- name: Prepare system
  block:
    - name: Test connection
      ansible.builtin.ping:

    - name: Test sudo access
      ansible.builtin.command: "sudo -n true"
      register: sudo_test
      failed_when: sudo_test.rc != 0
  rescue:
    - name: Gather facts
      ansible.builtin.setup:

    - name: Install bootstrap packages using raw
      ansible.builtin.raw:
        cmd: "{{ bootstrap_packages_install_command }}"
    
    - name: Ensure libdnf5 is present on RedHat-based systems
      ansible.builtin.package:
        name: libdnf5
        state: present
      when: ansible_facts['os_family'] == 'RedHat'

- name: Gather ansible facts
  ansible.builtin.setup:

- name: Install bootstrap packages (package)
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
    update_cache: yes
  become: "{{ bootstrap_become }}"


