    line: "SHELL={{ cron_shell }}"
    create: true
    mode: '0600'
  notify: Restart cron

- name: Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    line: "PATH={{ cron_path }}"
    create: true
    mode: '0600'
  notify: Restart cron

