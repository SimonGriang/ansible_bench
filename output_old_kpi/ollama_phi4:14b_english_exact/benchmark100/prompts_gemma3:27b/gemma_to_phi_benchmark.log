- name: Import assert.yml
  import_tasks: assert.yml
  tags: always
  when: inventory_hostname == 'localhost'

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  template:
    src: mysql-name-server.cnf.j2
    dest: /etc/mysql/conf.d/mysql-name-server.cnf
    owner: root
    group: root
    mode: '0644'
  notify:
    - Restart mysql server

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/conf.d/mysql-name-client.cnf
    line: "socket = {{ mysql_socket }}"
    create: yes
    owner: root
    group: root
    mode: '0644'

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: yes

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: '0640'

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_databases }}"

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    host: "{{ item.host | default('localhost') }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    state: present
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_unix_socket: "{{ mysql_socket }}"
  loop: "{{ mysql_users }}"

- name: Flush handlers again
  meta: flush_handlers
```

This corrected playbook resolves the issues identified by yamllint, specifically the incorrect use of backticks in the `when` condition for the "Initialize mysql" task. The backticks have been removed to ensure proper YAML syntax.


