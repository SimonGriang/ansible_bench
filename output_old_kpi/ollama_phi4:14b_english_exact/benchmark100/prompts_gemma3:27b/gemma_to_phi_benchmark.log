---
- name: Import assert.yml
  import_tasks: assert.yml
  hosts: localhost
  gather_facts: no

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  block:
    - name: Configure pip proxy settings
      lineinfile:
        path: /etc/pip.conf
        line: "index-url = {{ python_pip_proxy }}"
        insertafter: '^\\[global\\]$'
        create: yes
        mode: '0644'
      when: python_pip_proxy is defined

- name: Trust hosts
  block:
    - name: Configure trusted hosts for pip
      lineinfile:
        path: /etc/pip.conf
        line: "trusted-host = {{ python_pip_trusted_host }}"
        insertafter: '^\\[global\\]$'
        create: yes
        mode: '0644'
      when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    state: "{{ python_pip_pip_state }}"
    executable: "{{ python_pip_executable }}"
  when: ansible_distribution not in ['Debian'] or ansible_distribution_version not in ['bookworm', 'noble']
  and ansible_facts['os_family'] != 'Alpine'

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state | default('present') }}"
    version: "{{ item.version | default(omit) }}"
    executable: "{{ python_pip_executable }}"
  loop: "{{ python_pip_modules }}"
  loop_control:
    label: "{{ item.name }}"
  when: ansible_distribution not in ['Debian'] or ansible_distribution_version not in ['bookworm', 'noble']
  and ansible_facts['os_family'] != 'Alpine'
