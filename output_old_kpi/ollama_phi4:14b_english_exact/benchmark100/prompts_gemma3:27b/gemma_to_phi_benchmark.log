---
- name: Check if the Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Check Helm version
  command: helm version --short
  register: helm_existing_version
  failed_when: false
  changed_when: false

- name: Download helm
  unarchive:
    src: "{{ helm_repo_path }}/helm-{{ helm_version }}-linux-{{ helm_platform }}-{{ helm_arch }}.tar.gz"
    dest: /tmp
    remote_src: true
  when: not helm_check.stat.exists or helm_existing_version.stdout is search(helm_version)
  register: helm_download

- name: Copy helm binary into place
  copy:
    src: "/tmp/linux-{{ helm_platform }}-{{ helm_arch }}/helm"
    dest: "{{ helm_bin_path }}"
    mode: '0755'
    remote_src: true
  become: true
  when: helm_download.changed


