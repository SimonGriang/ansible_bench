content='```yaml\n---\n- name: Check if the Helm binary exists\n  stat:\n    path: "{{ helm_bin_path }}"\n  register: helm_check\n\n- name: Check Helm version\n  command: helm version --short\n  register: helm_existing_version\n  failed_when: false\n  changed_when: false\n\n- name: Download helm\n  unarchive:\n    src: "{{ helm_repo_path }}/helm-{{ helm_version }}-linux-{{ helm_platform }}-{{ helm_arch }}.tar.gz"\n    dest: /tmp\n    remote_src: yes\n  when: not helm_check.stat.exists or\n        helm_existing_version.stdout is search(helm_version)\n  register: helm_download\n\n- name: Copy helm binary into place\n  copy:\n    src: "/tmp/linux-{{ helm_platform }}-{{ helm_arch }}/helm"\n    dest: "{{ helm_bin_path }}"\n    mode: \'0755\'\n    remote_src: yes\n  become: true\n  when: helm_download.changed\n```' additional_kwargs={} response_metadata={'model': 'phi4:14b', 'created_at': '2025-10-07T09:22:33.691037872Z', 'done': True, 'done_reason': 'stop', 'total_duration': 4926083246, 'load_duration': 68133830, 'prompt_eval_count': 597, 'prompt_eval_duration': 373212541, 'eval_count': 209, 'eval_duration': 4483264105, 'model_name': 'phi4:14b'} id='run--c6b22585-93f0-4e3a-b6b9-b0f3dcd87b14-0' usage_metadata={'input_tokens': 597, 'output_tokens': 209, 'total_tokens': 806}
