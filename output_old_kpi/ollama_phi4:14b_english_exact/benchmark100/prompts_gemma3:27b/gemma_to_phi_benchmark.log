---
- name: Secure Vault Hardening Configuration
  hosts: all
  become: yes
  vars:
    vault_hardening_configure_selinux_apparmor: true

  tasks:
    - name: Ensure shell history doesn't contain 'ansible-vault'
      lineinfile:
        path: /etc/profile.d/history.sh
        line: 'export HISTIGNORE="*ansible-vault*:*vault*:*ansible*vault*:"'
        create: yes
      notify: restart_shell

    - name: Set file permissions to 0644, owner to root, group to root
      file:
        path: /etc/profile.d/history.sh
        mode: '0644'
        owner: root
        group: root

    - name: Configure SELinux and AppArmor
      block:
        - name: Install selinux-policy package
          package:
            name: selinux-policy
            state: present

        - name: Set SELinux policy to targeted and state to enforcing
          selinux:
            policy: targeted
            state: enforcing

      when: 
        - vault_hardening_configure_selinux_apparmor == true
        - ansible_selinux.status == "enabled"

    - name: Ensure AppArmor is installed if enabled
      package:
        name: apparmor
        state: present
      when: ansible_apparmor.status == "enabled"

  handlers:
    - name: restart_shell
      shell: source /etc/profile.d/history.sh


