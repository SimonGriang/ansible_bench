- name: Restart the RKE2 service
  service:
    name: "{{ rke2_service_name }}"
    state: restarted
  notify: Service (re)started
  delegate_to: "{{ rke2_node_name }}"

- name: Wait for all nodes to be ready
  shell: >
    {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
    get nodes --no-headers | grep -v NotReady | wc -l
  register: ready_nodes
  until: ready_nodes.stdout | int == groups['{{ rke2_cluster_group_name }}'] | length
  retries: 100
  delay: 15
  delegate_to: >-
    {{ groups['rke2_servers_group_name'][0] if 'active_server' not in vars else active_server }}
  run_once: true

- name: Wait for all pods to be ready
  shell: >
    {{ rke2_data_path }}/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml
    get pods --all-namespaces
    --field-selector=status.phase!=Running,status.phase!=Succeeded
    -o jsonpath='{.items[*].metadata.name}' | wc -l
  register: unready_pods
  until: unready_pods.stdout | int == 0
  retries: 100
  delay: 15
  delegate_to: >-
    {{ groups['rke2_servers_group_name'][0] if 'active_server' not in vars else active_server }}
  run_once: true
  when:
    - rke2_wait_for_all_pods_to_be_ready | bool
    - not ansible_check_mode
```

