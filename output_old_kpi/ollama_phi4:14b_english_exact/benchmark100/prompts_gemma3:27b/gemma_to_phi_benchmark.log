unt': 422, 'eval_duration': 8065613425, 'model_name': 'phi4:14b'} id='run--3dbd6ac6-1c93-46a1-b8d8-2ebe6e8f177a-0' usage_metadata={'input_tokens': 731, 'output_tokens': 422, 'total_tokens': 1153}
