---

- import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify:
    - Set root password
    - Systemctl daemon-reexec

- name: Configure mysql server
  mysql_variables:
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    config: '/etc/mysql/my.cnf'
  loop: "{{ mysql_configuration_options }}"
  notify: Restart mysql server

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/my.cnf
    line: "socket = /var/run/mysqld/mysqld.sock"
    regexp: "^socket"

- name: Initialize mysql
  command: mysql_install_db
  changed_when: false
  when: ansible_os_family == 'Debian' or ansible_os_family == 'Suse'

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: 0644

- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  when: mysql_databases is defined

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv | default(omit) }}"
    host: "{{ item.host | default(omit) }}"
    state: present
  loop: "{{ mysql_users }}"
  when: mysql_users is defined

- name: Flush handlers again
  meta: flush_handlers

