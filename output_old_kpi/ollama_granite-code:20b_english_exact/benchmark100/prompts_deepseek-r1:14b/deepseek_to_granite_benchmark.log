---
- name: Set ansible_package_state based on how Ansible is installed
  set_fact:
    ansible_package_state: "{{ 'present' if ansible_package_state == 'latest' else 'absent' }}"

- name: Setup Ansible on RedHat
  include_tasks: setup-RedHat.yml
  when:
    - ansible_os_family == "RedHat"
    - ansible_distribution != "Fedora"
    - ansible_package_state == "present"

- name: Setup Ansible on Fedora
  include_tasks: setup-Fedora.yml
  when:
    - ansible_distribution == "Fedora"
    - ansible_package_state == "present"

- name: Setup Ansible on Ubuntu
  include_tasks: setup-Ubuntu.yml
  when:
    - ansible_distribution == "Ubuntu"
    - ansible_package_state == "present"

- name: Setup Ansible on Debian
  include_tasks: setup-Debian.yml
  when:
    - ansible_os_family == "Debian"
    - ansible_package_state == "present"

- name: Setup Ansible using Pip
