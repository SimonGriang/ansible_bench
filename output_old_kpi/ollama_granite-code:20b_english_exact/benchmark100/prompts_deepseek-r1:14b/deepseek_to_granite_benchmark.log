---
- name: Apache HTTPD server configuration
  hosts: all
  tasks:
  - import_tasks: assert.yml
  - name: Install Apache HTTP server
    package:
      name: "{{ httpd_packages }}"
      state: present
  - name: Configure SELinux settings
    selinux:
      boolean: "{{ item }}"
      state: "{{ httpd_selinux_state }}"
    loop: "{{ httpd_seboolean }}"
    when: ansible_selinux.status == "enabled"
  - name: Configure Apache HTTP server
    template:
      src: "{{ httpd_conf_src }}"
      dest: "{{ httpd_conf_dest }}"
      mode: 0644
    notify: restart apache
  - name: Activate Apache modules
    command: a2enmod {{ item }}
    loop: "{{ httpd_modules }}"
    when: ansible_os_family == "Debian"
    changed_when: false
  - import_tasks: ssl.yml
    when: httpd_ssl_enabled
  - import_tasks: locations.yml
    when: httpd_locations is defined
  - import_tasks: vhosts.yml
    when: httpd_vhosts is defined
  - name: Configure Apache ports
    template:
      src: "{{ httpd_ports_conf_src }}"
      dest: "{{ httpd_ports_conf_dest }}"
      mode: 0644
    notify: restart apache
    when: ansible_os_family in [ "Debian", "Suse" ]
  - import_tasks: directories.yml
    when: httpd_directories is defined
  - name: Flush handlers
    meta: flush_handlers
  - name: Removing default html
    file:
      path: "{{ httpd_docroot }}/index.html"
      state: absent
    when: httpd_remove_example
  - name: Start and enable Apache service
    service:
      name: "{{ httpd_service }}"
      state: started
      enabled: true

