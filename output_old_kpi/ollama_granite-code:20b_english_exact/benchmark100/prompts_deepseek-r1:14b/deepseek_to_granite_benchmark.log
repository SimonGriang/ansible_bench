---
- import_tasks: assert.yml
- name: Task 2 - Install using package
  block:
  - name: Task 2(a) - Install using apt (Debian)
    apt:
      name: "{{ hashicorp_product }}"
      state: present
    when: ansible_os_family == "Debian"
  - name: Task 2(b) - Install using yum (RHEL/CentOS)
    yum:
      name: "{{ hashicorp_product }}"
      state: present
    when: ansible_os_family == "RedHat"
- name: Task 3 - Configure debian
  block:
  - name: Task 3(a) - Add GPG key
    apt_key:
      url: "{{ hashicorp_gpg_key_url }}"
      state: present
  - name: Task 3(b) - Add apt repository
    apt_repository:
      repo: "{{ hashicorp_apt_repo }}"
      state: present
      update_cache: yes
- name: Task 4 - Install hashicorp product using package
  block:
  - name: Task 4(a) - Install latest version
    package:
      name: "{{ hashicorp_product }}"
      state: latest
  - name: Task 4(b) - Install specific version
    package:
      name: "{{ hashicorp_product }}"
      state: present
      version: "{{ hashicorp_version }}"
- name: Task 5 - Install manually
  unarchive:
    dest: /usr/local/bin
    group: root
    mode: 0755
    remote_src: yes
    src: https://releases.hashicorp.com/jackson/1.0.0/jackson_1.0.0_linux_amd64.zip

