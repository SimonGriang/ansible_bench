---

- name: Import assertion file
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install system requirements
  package:
    name: bash
    state: present

- when: java_vendor == "openjdk"
  block:
    - name: Install OpenJDK Java
      package:
        name: openjdk
        state: present

- when: java_source == "local" and java_format == "rpm"
  block:
    - name: Copy and install Oracle Java RPM package
      copy:
        src: /path/to/oracle-java.rpm
        dest: /tmp/oracle-java.rpm
      become: true
    - name: Install Oracle Java RPM package
      package:
        name: /tmp/oracle-java.rpm
        state: present

- when: java_source == "local" and java_format == "deb"
  block:
    - name: Copy and install Oracle Java DEB package
      copy:
        src: /path/to/oracle-java.deb
        dest: /tmp/oracle-java.deb
      become: true
    - name: Install Oracle Java DEB package
      package:
        name: /tmp/oracle-java.deb
        state: present

- when: java_source == "repository" and java_format == "rpm"
  block:
    - name: Install Oracle Java RPM package
      package:
        name: oracle-java
        state: present

- when: java_format == "targz" and java_vendor == "oracle"
  block:
    - name: Extract and install Oracle Java targz package
      unarchive:
        src: /path/to/oracle-java.targz
        dest: /opt/java
        remote_src: true
    - name: Install Oracle Java targz package
      package:
        name: /opt/java/jdk1.8.0_291
        state: present

- when: java_jce is enabled and java_version == 8 and java_vendor == "oracle"
  block:
    - name: Install Java Cryptography Extension (JCE) policy software
      unarchive:
        src: /path/to/UnlimitedJCEPolicyJDK8.zip
        dest: /opt/java
        remote_src: true
    - name: Install Java Cryptography Extension (JCE) policy software
      package:
        name: UnlimitedJCEPolicy
        state: present

- when: java_format == "targz" and distribution != "Alpine"
  block:
    - name: Set Java alternative link
      alternatives:
        name: java
        link: /usr/bin/java
        path: /opt/java/jdk1.8.0_291/bin/java

- name: Find Java home directory
  command: readlink -f /usr/bin/java
  register: java_home_result

- name: Set JAVA_HOME in environment
  lineinfile:
    path: /etc/profile.d/java_home.sh
    line: "export JAVA_HOME={{ java_home_result.stdout }}"
    create: true


