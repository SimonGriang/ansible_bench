---

- name: "Java (Adoptium, OpenJDK) | Setup"
  block:
    - name: "Java (Adoptium, OpenJDK) | Setup | Set java_jdk_vendor fact to temurin if currently set to adoptopenjdk"
      set_fact:
        java_jdk_vendor: temurin
      when: java_jdk_vendor == "adoptopenjdk"

    - name: "Java (Adoptium, OpenJDK) | Setup | Gather OS specific variables"
      include_vars: "{{ item }}"
      with_first_found:
        - files:
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_system_version }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_system_release }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_system }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_version }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_release }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_distribution }}.yml"
            - "{{ java_jdk_vendor }}.yml"
          skip: true
          paths:
            - ../vars
      tags:
        - always

    - name: "Java (Adoptium, OpenJDK) | Setup | Gather architecture specific variables"
      include_vars: "{{ item }}"
      with_first_found:
        - files:
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_system_version }}-{{ ansible_architecture }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_system_release }}-{{ ansible_architecture }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_architecture }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_version }}-{{ ansible_architecture }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_release }}-{{ ansible_architecture }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_architecture }}.yml"
            - "{{ java_jdk_vendor }}-{{ ansible_architecture }}.yml"
          skip: true
          paths:
            - ../vars
      tags:
        - always

    - name: "Java (Adoptium, OpenJDK) | Setup | Set OS specific variables (I)"
      block:
        - name: "Java (Adoptium, OpenJDK) | Setup | Set OS specific variables (I) | Set default OpenJDK version"
          set_fact:
            java_version_string: "{{ __java_version_string }}"
          when: java_version_string is not defined

        - name: "Java (Adoptium, OpenJDK) | Setup | Set OS specific variables (I) | Set default OpenJDK repository"
          set_fact:
            java_apt_repository: "{{ __java_apt_repository }}"
          when: java_apt_repository is not defined

        - name: "Java (Adoptium, OpenJDK) | Setup | Set OS specific variables (I) | Set default OpenJDK lib"
          set_fact:
            java_apt_lib: "{{ __java_apt_lib }}"
          when: java_apt_lib is not defined

        - name: "Java (Adoptium, OpenJDK) | Setup | Set OS specific variables (I) | Override default OpenJDK variables"
          include_vars: "{{ item }}"
          with_first_found:
            - files:
                - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_system_version }}.yml"
                - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_system_release }}.yml"
                - "{{ java_jdk_vendor }}-{{ ansible_system }}.yml"
                - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_version }}.yml"
                - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_release }}.yml"
                - "{{ java_jdk_vendor }}-{{ ansible_distribution }}.yml"
                - "{{ java_jdk_vendor }}.yml"
              skip: true
              paths:
                - ../vars
          tags:
            - always

        - name: "Java (Adoptium, OpenJDK) | Setup | Set OS specific variables (I) | Override default OpenJDK variables (II)"
          include_vars: "{{ item }}"
          with_first_found:
            - files:
                - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_system_version }}-{{ ansible_architecture }}.yml"
                - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_system_release }}-{{ ansible_architecture }}.yml"
                - "{{ java_jdk_vendor }}-{{ ansible_system }}-{{ ansible_architecture }}.yml"
                - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_version }}-{{ ansible_architecture }}.yml"
                - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_distribution_release }}-{{ ansible_architecture }}.yml"
                - "{{ java_jdk_vendor }}-{{ ansible_distribution }}-{{ ansible_architecture }}.yml"
                - "{{ java_jdk_vendor }}-{{ ansible_architecture }}.yml"
              skip: true
              paths:
                - ../vars
          tags:
            - always
      tags:
        - always

    - name: "Java (Adoptium, OpenJDK) | Setup | Set specific variables"
      set_fact:
        java_home: "/usr/lib/jvm/java-{{ java_version_string }}-openjdk-$(arch)"

    - name: "Java (Adoptium, OpenJDK) | Setup | Debian pre-requisites"
      block:
        - name: "Java (Adoptium, OpenJDK) | Setup | Debian pre-requisites | Remove deprecated repositories"
          apt_repository:
            repo: "deb http://security.debian.org/debian-security {{ ansible_distribution_release }}/updates main"
            state: absent

        - name: "Java (Adoptium, OpenJDK) | Setup | Debian pre-requisites | Install extra apt tools"
          apt:
            name:
              - apt-transport-https
              - ca-certificates
              - curl
              - software-properties-common
            state: present

        - name: "Java (Adoptium, OpenJDK) | Setup | Debian pre-requisites | Add key repositories"
          apt_key:
            url: "{{ item.url }}"
            id: "{{ item.id }}"
            state: present
          with_items:
            - url: https://apt.releases.hashicorp.com/gpg
              id: 6A030B78
            - url: https://download.docker.com/linux/{{ ansible_distribution | lower }} {{ ansible_distribution_release }} stable
              id: 9DC858229FC7DD3885412A14886C46402C65B1AF

        - name: "Java (Adoptium, OpenJDK) | Setup | Debian pre-requisites | Add required repositories"
          apt_repository:
            repo: "{{ item }}"
            state: present
          with_items:
            - "deb https://apt.dockerproject.org/repo {{ ansible_distribution_release }} main"
            - "deb https://apt.releases.hashicorp.com {{ ansible_distribution_release }} main"
      when: ansible_os_family == "Debian"

    - name: "Java (Adoptium, OpenJDK) | Setup | RedHat pre-requisites"
      block:
        - name: "Java (Adoptium, OpenJDK) | Setup | RedHat pre-requisites | Add key repositories"
          get_url:
            url: "{{ item.url }}"
            dest: "{{ __java_download_path }}/{{ item.file }}"
          with_items:
            - url: https://apt.releases.hashicorp.com/gpg
              file: hashicorp.asc
            - url: https://download.docker.com/linux/{{ ansible_distribution | lower }} {{ ansible_distribution_release }} stable
              file: docker.asc

        - name: "Java (Adoptium, OpenJDK) | Setup | RedHat pre-requisites | Import key repositories"
          command: rpm --import "{{ __java_download_path }}/{{ item.file }}"
          with_items:
            - file: hashicorp.asc
            - file: docker.asc

        - name: "Java (Adoptium, OpenJDK) | Setup | RedHat pre-requisites | Add required repositories"
          yum:
            name:
              - https://apt.dockerproject.org/repo/main/centos/7
              - https://apt.releases.hashicorp.com/centos/{{ ansible_distribution_major_version }} main
            state: present
      when: ansible_os_family == "RedHat"

    - name: "Java (Adoptium, OpenJDK) | Setup | Install required libs"
      package:
        name: "{{ java_apt_lib }}"
        state: present

    - name: "Java (Adoptium, OpenJDK) | Setup | Install Java, Debian"
      apt:
        name: "openjdk-{{ java_version_string }}-jdk"
        state: present
        update_cache: true
        cache_valid_time: 3600
      when: ansible_os_family == "Debian"

    - name: "Java (Adoptium, OpenJDK) | Setup | Install Java, RedHat"
      yum:
        name: "java-{{ java_version_string }}-openjdk"
        state: present
      when: ansible_os_family == "RedHat"

    - name: "Java (Adoptium, OpenJDK) | Setup | Export environment variables"
      copy:
        dest: /etc/profile.d/java.sh
        content: |
          export JAVA_HOME="{{ java_home }}"
          export PATH="{{ java_home }}/bin:$PATH"
      when: ansible_os_family == "Debian" or ansible_os_family == "RedHat"

    - name: "Java (Adoptium, OpenJDK) | Setup | Source environment variables"
      shell: source /etc/profile.d/java.sh
      when: ansible_os_family == "Debian" or ansible_os_family == "RedHat"

    - name: "Java (Adoptium, OpenJDK) | Setup | Correct java version selected for Java < 11"
      alternatives:
        name: java
        link: /usr/bin/java
        path: /usr/lib/jvm/java-{{ java_version_string }}-openjdk-$(arch)/bin/java
      when: ansible_os_family == "Debian" or ansible_os_family == "RedHat" and java_version_string | int < 11

    - name: "Java (Adoptium, OpenJDK) | Setup | Correct java version selected for Java >= 11"
      alternatives:
        name: java
        link: /usr/bin/java
        path: /usr/lib/jvm/java-{{ java_version_string }}-openjdk-$(arch)/bin/java
      when: ansible_os_family == "Debian" or ansible_os_family == "RedHat" and java_version_string | int >= 11

