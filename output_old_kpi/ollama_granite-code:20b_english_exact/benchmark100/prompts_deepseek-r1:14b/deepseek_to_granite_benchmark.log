---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install php
  package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  shell: "php --info | grep 'php.ini'"
  args:
    warn: false
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout_lines[0]) }}"
    mode: 0644
  notify: Restart httpd

