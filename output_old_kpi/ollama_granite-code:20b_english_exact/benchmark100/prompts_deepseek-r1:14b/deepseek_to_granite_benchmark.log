---
- name: Run GRUB tasks
  hosts: all
  tasks:
    - name: Stat the /sys/firmware/efi/efivars/ directory
      stat:
        path: /sys/firmware/efi/efivars/
      register: efi_check

    - name: Delete /boot/grub2/grub.cfg if the EFI firmware exists
      file:
        path: /boot/grub2/grub.cfg
        state: absent
      when: efi_check.stat.exists

    - name: Copy a template file named 01_users.j2 to /etc/grub.d/01_users with proper permissions
      copy:
        src: 01_users.j2
        dest: /etc/grub.d/01_users
        owner: root
        group: root
        mode: '0755'

    - name: Insert a password_pbkdf2 line into /etc/grub2-efi.cfg for EFI systems
      lineinfile:
        path: /etc/grub2-efi.cfg
        line: password_pbkdf2 {{ ansible_user_dir }}

    - name: Insert a password_pbkdf2 line into /etc/grub2.cfg for MBR systems
      lineinfile:
        path: /etc/grub2.cfg
        line: password_pbkdf2 {{ ansible_user_dir }}

    - name: Modify GRUB password entries to include --unrestricted flag if enabled
      lineinfile:
        path: /etc/grub2.cfg
        line: password_pbkdf2 --unrestricted {{ ansible_user_dir }}

