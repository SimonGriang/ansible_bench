      - "{{ ansible_os_family }}-{{ ansible_os_family }}.yml"
      paths:
      - vars
      skip: true

- name: Include OS family specific tasks
  include_tasks: "{{ item }}"
  with_first_found:
    - files:
      - "{{ ansible_os_family }}.yml"
      paths:
      - tasks
      skip: true

- name: Install Docker packages
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_version.full is version_compare('2.12', '<') or ansible_os_family in ['CoreOS', 'Container Linux by Google'] }}"
  when: not ansible_os_family in ["CoreOS", "Container Linux by Google"]

- name: Install Docker packages with downgrade option
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: true
  notify: restart docker
  ignore_errors: "{{ ansible_version.full is version_compare('2.12', '>=') and ansible_os_family in ['CoreOS', 'Container Linux by Google'] }}"
  when: ansible_version.full is version_compare('2.12', '>=') and ansible_os_family in ["CoreOS", "Container Linux by Google"]

- name: Install docker-compose plugin
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_version.full is version_compare('2.12', '<') or ansible_os_family in ['CoreOS', 'Container Linux by Google'] }}"
  when: docker_install_compose_plugin and not ansible_os_family in ["CoreOS", "Container Linux by Google"]

- name: Install docker-compose-plugin with downgrade option
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: true
  notify: restart docker
  ignore_errors: "{{ ansible_version.full is version_compare('2.12', '>=') and ansible_os_family in ['CoreOS', 'Container Linux by Google'] }}"
  when: docker_install_compose_plugin and ansible_version.full is version_compare('2.12', '>=') and ansible_os_family in ["CoreOS", "Container Linux by Google"]

- name: Ensure /etc/docker directory exists
  file:
    path: /etc/docker
    state: directory
    mode: 0755
  when: docker_daemon_options is not null

- name: Configure Docker daemon options
  copy:
    dest: /etc/docker/daemon.json
    content: "{{ docker_daemon_options | to_json }}"
    mode: 0644
  when: docker_daemon_options is not null
  notify: restart docker

- name: Ensure Docker service is started and enabled
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: "{{ ansible_check_mode }}"
  when: docker_service_manage

- name: Flush handlers to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose.yml tasks
  include_tasks: docker-compose.yml
  when: docker_install_compose

- name: Get docker group information
  getent:
    database: group
    key: docker

- name: Set fact for user modification
  set_fact:
    docker_users_modify: "{{ True if docker_users | difference(getent_docker.stdout_lines) else False }}"

- name: Include docker-users.yml tasks
  include_tasks: docker-users.yml
  when: docker_users_modify

