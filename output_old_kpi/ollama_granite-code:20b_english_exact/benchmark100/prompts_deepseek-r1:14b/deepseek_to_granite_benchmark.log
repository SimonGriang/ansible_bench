        AIRgap_IMAGE_CHECKSUM: "{{ airgap_image_checksum }}"
        AIRGAP_IMAGE_PATH: "{{ airgap_image_path }}"
        INSTALL_RKE2_ARM64: "{% if ansible_architecture == 'aarch64' %}--arm64{% endif %}"
      register: rke2_install_command
      changed_when: false
      until: rke2_install_command is succeeded
      retries: 5
      delay: 10

    - name: Copy Custom Manifests
      template:
        src: ../templates/rke2-custom-manifests.yaml.j2
        dest: /etc/kubernetes/manifests/rke2-custom-manifests.yaml
      notify:
        - restart rke2-server

