---
- name: Check Java certificates
  hosts: all
  vars:
    java_certs:
      - path: /path/to/java1.crt
        alias: java1
      - path: /path/to/java2.crt
        alias: java2
  tasks:
    - name: Verify Java certificate existence
      stat:
        path: "{{ item.path }}"
      loop: "{{ java_certs }}"
      register: java_certs_status

    - name: Fail if Java certificate is missing
      fail:
        msg: "Java certificate {{ item.item.alias }} is missing"
      loop: "{{ java_certs_status.results }}"
      when: not item.stat.exists

- name: Set keystore directory for Java versions less than 11
  hosts: all
  vars:
    ansible_python_interpreter: /usr/bin/python3
  tasks:
    - name: Configure keystore directory for Java < 11
      set_fact:
        java_keystore_dir: /path/to/legacy/keystore
      when: ansible_distribution_major_version | int < 11

- name: Set keystore directory for Java versions 11 or newer
  hosts: all
  vars:
    ansible_python_interpreter: /usr/bin/python3
  tasks:
    - name: Configure keystore directory for Java >= 11
      set_fact:
        java_keystore_dir: /path/to/new/keystore
      when: ansible_distribution_major_version | int >= 11

- name: Import SSL certificates into Java keystore
  hosts: all
  tasks:
    - name: Import SSL certificates into Java keystore
      java_import_cert:
        path: "{{ item.path }}"
        alias: "{{ item.alias }}"
        keystore: "{{ java_keystore_dir }}"
        keystore_pass: "{{ java_keystore_pass }}"
        state: present
      loop:
        - path: /path/to/java1.crt
          alias: java1
        - path: /path/to/java2.crt
          alias: java2


