---
- name: "rke2-install : rke2 configuration directory"
  file:
    path: "{{ rke2_config_dir }}"
    state: directory
    owner: root
    group: root
    mode: 0755

- name: "rke2-install : server node taints"
  command: >
    kubectl taint nodes --all node-role.kubernetes.io/control-plane:NoSchedule
  when: rke2_node_type == "server"

- name: "rke2-install : agent node taints"
  command: >
    kubectl taint nodes --all node-role.kubernetes.io/worker:NoSchedule
  when: rke2_node_type == "agent"

- name: "rke2-install : copy rke2 configuration file"
  template:
    src: rke2.yaml.j2
    dest: "{{ rke2_config_file }}"
    owner: root
    group: root
    mode: 0644
  notify:
    - "rke2-service : restart rke2 service"

- name: "rke2-install : copy kubelet configuration file"
  template:
    src: kubelet.conf.j2
    dest: "{{ rke2_kubelet_dir }}/kubelet.conf"
    owner: root
    group: root
    mode: 0644
  notify:
    - "rke2-service : restart rke2 service"
  when: rke2_kubelet_config is defined

- name: "rke2-install : copy containerd registry configuration file"
  template:
    src: containerd-registries.conf.j2
    dest: "{{ rke2_ containerd_dir }}/registries.yaml"
    owner: root
    group: root
    mode: 0644
  notify:
    - "rke2-service : restart rke2 service"
  when: rke2_custom_registry is defined

- name: "rke2-install : start rke2 service on other nodes"
  systemd:
    name: rke2-server.service
    state: started
    enabled: yes
  when: rke2_node_type == "server" andinventory_hostname != rke2_node_name
  notify:
    - "rke2-service : mask other rke2 services"

- name: "rke2-install : mask other rke2 services on nodes"
  systemd:
    name: "{{ item }}"
    enabled: no
    masked: yes
  loop:
    - rke2-agent.service
    - rke2-server.service
  when: rke2_node_type != "server"

- name: "rke2-install : wait for remaining nodes to be ready - no CNI"
  uri:
    url: "https://{{ item }}:6443/readyz"
    validate_certs: no
  register: api_response
  until: api_response.status == 200
  retries: 60
  delay: 1
  with_items: "{{ ansible_play_hosts }}"
  run_once: yes
  when: rke2_cni == "none"

- name: "rke2-install : wait for remaining nodes to be ready - with CNI"
  uri:
    url: "https://{{ item }}:6443/readyz"
    validate_certs: no
  register: api_response
  until: api_response.status == 200
  retries: 60
  delay: 1
  with_items: "{{ ansible_play_hosts }}"
  run_once: yes
  when: rke2_cni != "none"

