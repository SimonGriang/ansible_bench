---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  ansible.builtin.wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
  when: connection not in [ "container", "docker", "community.docker.docker" ]

- name: Prepare system
  ansible.builtin.command: "{{ bootstrap_curl_cmd }} {{ bootstrap_url }} | sh"
  args:
    creates: "{{ bootstrap_install_dir }}/bootstrap.sh"
  register: bootstrap_install
  changed_when: false  # We want curl output, not a diff
  until: bootstrap_install is succeeded
  retries: "{{ bootstrap_retries }}"
  delay: "{{ bootstrap_delay }}"
  # No delegate_to or run_once here because we need the whole system

- name: Gather ansible facts
  ansible.builtin.setup:
    gather_subset: "network,hardware,virtual"
    filter: "ansible_distribution"  # We only need distro info, not every fact
  become: false
  delegate_to: localhost
  run_once: true

- name: Install bootstrap packages
  ansible.builtin.package:
    name: "{{ bootstrap_facts_packages }}"
    state: present
  become: "{{ bootstrap_become }}"
  register: install_packages
  until: install_packages is succeeded
  retries: "{{ bootstrap_retries }}"
  delay: "{{ bootstrap_delay }}"

