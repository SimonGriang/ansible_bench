38841, 'eval_count': 507, 'eval_duration': 12005559823, 'model_name': 'granite-code:20b'} id='run--7d24f9f1-2527-42b9-bd53-ddb697ebf25c-0' usage_metadata={'input_tokens': 517, 'output_tokens': 507, 'total_tokens': 1024}
