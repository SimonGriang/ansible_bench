---

- name: Validate variables
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Wait for host to be available
  wait_for_connection:
    timeout: 300
  delegate_to: localhost

- name: Prepare system for bootstrap
  block:
  - name: Test connection
    ping:
  - name: Handle connection failures
    fail:
      msg: Connectivity test failed
    when: ansible_ssh_login_SHELL is failed
  - name: Gather facts
    setup:
  - name: Install raw bootstrap packages
    package:
      name: "{{ bootstrap_packages }}"
      state: present
  delegate_to: localhost

- name: Ensure system preparation with Ansible modules
  block:
  - name: Gather facts
    setup:
  - name: Install packages based on detected OS family
    package:
      name: "{{ bootstrap_packages }}"
      state: present
    when: ansible_os_family == "Debian"
  - name: Ensure the system is fully prepared
    command: echo "System is prepared"
  delegate_to: localhost

