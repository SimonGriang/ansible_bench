---
- name: Create RKE2 config directory
  file:
    path: /etc/rke2
    owner: root
    group: root
    mode: 0755
    state: directory

- name: Set server taints
  command: rke2 server taints --taints="{{ rke2_server_node_taints }}"
  when: groups['server'] is defined and inventory_hostname in groups['server']

- name: Copy RKE2 configuration file
  copy:
    src: "{{ rke2_config_src }}"
    dest: /etc/rke2/rke2.yaml
    owner: root
    group: root
    mode: 0644
  notify:
    - restart rke2

- name: Copy kubelet configuration file
  copy:
    src: "{{ rke2_kubelet_config_src }}"
    dest: /var/lib/rke2/agent/kubelet/config.yaml
    owner: root
    group: root
    mode: 0644
  when: rke2_kubelet_config | length > 0
  notify:
    - restart rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: "{{ rke2_registry_config_src }}"
    dest: /etc/docker/registry/config.yml
    owner: root
    group: root
    mode: 0644
  when: rke2_registry_config | length > 0 and rke2_registry_config_secret | length == 0
  notify:
    - restart rke2

- name: Register etcd restore from file
  set_fact:
    rke2_etcd_local_restore: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file | length > 0 and rke2_service_status.stdout == "active"

- name: Register etcd restore from S3
  set_fact:
    rke2_etcd_s3_restore: true
  when: rke2_etcd_s3_endpoint is defined and rke2_etcd_s3_endpoint | length > 0 and rke2_etcd_s3_bucket is defined and rke2_etcd_s3_bucket | length > 0 and rke2_etcd_s3_access_key is defined and rke2_etcd_s3_access_key | length > 0 and rke2_etcd_s3_secret_key is defined and rke2_etcd_s3_secret_key | length > 0 and rke2_service_status.stdout == "active"

- name: Restore etcd from file
  block:
    - name: Create etcd data directory
      file:
        path: /var/lib/rke2/agent/etc/etcd/
        owner: root
        group: root
        mode: 0750
        state: directory

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file_src }}"
        dest: /var/lib/rke2/agent/etc/etcd/member/snap-shot.db
        owner: root
        group: root
        mode: 0644

    - name: Restore etcd snapshot
      shell:
        cmd: RKE2_DATA_DIR="/var/lib/rke2/agent/etc/etcd/" /usr/local/bin/rke2-restore --config /etc/rke2/rke2.yaml --name={{ inventory_hostname }} --backup-dir /var/lib/rke2/agent/etc/etcd/member/ --backup-file snap-shot.db
      become: true
      register: rke2_etcd_restore
      changed_when: "'restoring' in rke2_etcd_restore.stdout_lines"
      until: "rke2_etcd_restore.rc == 0"
      retries: "{{ rke2_download_retries }}"
      delay: "{{ rke2_download_delay }}"
  when: rke2_etcd_local_restore is defined and rke2_etcd_local_restore

- name: Restore etcd from S3
  block:
    - name: Create etcd data directory
      file:
        path: /var/lib/rke2/agent/etc/etcd/
        owner: root
        group: root
        mode: 0750
        state: directory

    - name: Restore etcd snapshot
      shell:
        cmd: RKE2_DATA_DIR="/var/lib/rke2/agent/etc/etcd/" /usr/local/bin/rke2-restore --config /etc/rke2/rke2.yaml --name={{ inventory_hostname }} --s3-endpoint {{ rke2_etcd_s3_endpoint }} --s3-bucket {{ rke2_etcd_s3_bucket }} --s3-access-key {{ rke2_etcd_s3_access_key }} --s3-secret-key {{ rke2_etcd_s3_secret_key }} --s3-region {{ rke2_etcd_s3_region }} --s3-folder {{ rke2_etcd_s3_folder }} --s3-insecure={{ rke2_etcd_s3_insecure }}
      become: true
      register: rke2_etcd_restore
      changed_when: "'restoring' in rke2_etcd_restore.stdout_lines"
      until: "rke2_etcd_restore.rc == 0"
      retries: "{{ rke2_download_retries }}"
      delay: "{{ rke2_download_delay }}"
  when: rke2_etcd_s3_restore is defined and rke2_etcd_s3_restore

- name: Start RKE2 service
  service:
    name: rke2-server
    state: started
    enabled: yes
    env:
      RKE2_TOKEN: "{{ rke2_token }}"
  notify:
    - restart rke2

- name: Mask RKE2 agent service
  service:
    name: rke2-agent
    enabled: no
    state: stopped

- name: Wait for first server to be ready (no CNI)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 6443
    timeout: 30
    state: started
  when: rke2_cni | length == 0 and groups['server'] is defined and inventory_hostname == groups['server'][0]

- name: Wait for first server to be ready (with CNI)
  wait_for:
    host: "{{ inventory_hostname }}"
    port: 6443
    timeout: 30
    state: started
  when: rke2_cni | length > 0 and groups['server'] is defined and inventory_hostname == groups['server'][0]

- name: Restore etcd
  block:
    - name: Clean up old etcd data
      shell:
        cmd: RKE2_DATA_DIR="/var/lib/rke2/agent/etc/etcd/" /usr/local/bin/rke2-cleanup --config /etc/rke2/rke2.yaml
      become: true
      register: rke2_etcd_cleanup
      changed_when: "'cleaned' in rke2_etcd_cleanup.stdout_lines"
      until: "rke2_etcd_cleanup.rc == 0"
      retries: "{{ rke2_download_retries }}"
      delay: "{{ rke2_download_delay }}"

    - name: Clean up old etcd tokens
      shell:
        cmd: RKE2_DATA_DIR="/var/lib/rke2/agent/etc/etcd/" /usr/local/bin/rke2-token clean --config /etc/rke2/rke2.yaml
      become: true
      register: rke2_etcd_token_cleanup
      changed_when: "'cleaned' in rke2_etcd_token_cleanup.stdout_lines"
      until: "rke2_etcd_token_cleanup.rc == 0"
      retries: "{{ rke2_download_retries }}"
      delay: "{{ rke2_download_delay }}"
  when: rke2_etcd_local_restore is defined and rke2_etcd_local_restore or rke2_etcd_s3_restore is defined and rke2_etcd_s3_restore

- name: Set Active Server variable
  set_fact:
    rke2_active_server: "{{ inventory_hostname }}"
  delegate_to: "{{ item }}"
  delegate_facts: true
  loop: "{{ groups['server'] }}"

