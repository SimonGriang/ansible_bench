---
- name: Generate OpenSSL private key
  openssl_privatekey:
    path: "{{ openssl_key_path }}"
    mode: "{{ openssl_key_mode }}"
    owner: "{{ openssl_key_owner }}"
    group: "{{ openssl_key_group }}"

- name: Generate OpenSSL Certificate Signing Request
  openssl_csr:
    path: "{{ openssl_csr_path }}"
    privatekey_path: "{{ openssl_key_path }}"
    common_name: "{{ openssl_csr_common_name }}"
    mode: "{{ openssl_csr_mode }}"
    owner: "{{ openssl_csr_owner }}"
    group: "{{ openssl_csr_group }}"

- name: Generate OpenSSL X.509 certificate
  openssl_certificate:
    path: "{{ openssl_cert_path }}"
    privatekey_path: "{{ openssl_key_path }}"
    csr_path: "{{ openssl_csr_path }}"
    mode: "{{ openssl_cert_mode }}"
    owner: "{{ openssl_cert_owner }}"
    group: "{{ openssl_cert_group }}"

- name: Generate PKCS#12 file
  openssl_pkcs12:
    path: "{{ openssl_pkcs12_path }}"
    privatekey_path: "{{ openssl_key_path }}"
    certificate_path: "{{ openssl_cert_path }}"
    friendly_name: "{{ openssl_pkcs12_friendly_name }}"
    mode: "{{ openssl_pkcs12_mode }}"
    owner: "{{ openssl_pkcs12_owner }}"
    group: "{{ openssl_pkcs12_group }}"

- name: Read private key content
  slurp:
    src: "{{ openssl_key_path }}"
  register: private_key_content

- name: Read certificate content
  slurp:
    src: "{{ openssl_cert_path }}"
  register: certificate_content

- name: Create combined private key and certificate file
  copy:
    content: "{{ private_key_content['content'] + certificate_content['content'] }}"
    dest: "{{ openssl_combined_path }}"
    mode: "{{ openssl_combined_mode }}"
    owner: "{{ openssl_combined_owner }}"
    group: "{{ openssl_combined_group }}"

