- name: Copy generated private SSH key for user
  copy:
    src: "~/.ssh/id_rsa"
    dest: "~/.ssh/"
    owner: "{{ user }}"
    group: "{{ user }}"
    mode: "0600"
- name: Check users password valid time for user
  command: "chage -l {{ user }} | grep 'Password expires' | awk '{print $3}'"
  register: password_expires
  changed_when: false
- name: Set users password valid time for user
  command: "chage -E {{ password_expires.stdout }} {{ user }}"
- name: Place private key file for user
  copy:
