      when: ansible_os_family == "RedHat"

    - name: gather facts
      setup:
      become: no
  when:
    - __bootstrap_ preparation_enabled
    - not __bootstrap_ preparation_ fact_only

- import_tasks: package.yml
  when: __bootstrap_ preparation_enabled


