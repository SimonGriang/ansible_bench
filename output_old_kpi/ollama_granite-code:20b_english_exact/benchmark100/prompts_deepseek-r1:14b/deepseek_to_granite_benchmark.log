    path: /etc/ssl/csr/example.com.csr
    privatekey_path: /etc/ssl/private/example.com.key
    common_name: example.com
    country_name: US
    state_or_province_name: California
    locality_name: San Francisco
    organization_name: Example, Inc.
    organizational_unit_name: Example
    email_address: webmaster@example.com
    subject_alt_name:
      - DNS:example.com
      - DNS:www.example.com
    owner: root
    group: root
    mode: "0644"

- name: Generate Self-Signed SSL Certificate
  openssl_certificate:
    path: /etc/ssl/certs/example.com.crt
    privatekey_path: /etc/ssl/private/example.com.key
    csr_path: /etc/ssl/csr/example.com.csr
    provider: selfsigned
    owner: root
    group: root
    mode: "0644"

- name: Create PKCS#12 File
  openssl_pkcs12:
    path: /etc/ssl/certs/example.com.pfx
    privatekey_path: /etc/ssl/private/example.com.key
    certificate_path: /etc/ssl/certs/example.com.crt
    owner: root
    group: root
    mode: "0600"

- name: Read Private Key Content
  slurp:
    src: /etc/ssl/private/example.com.key
  register: private_key_content

- name: Read Certificate Content
  slurp:
    src: /etc/ssl/certs/example.com.crt
  register: certificate_content

- name: Combine Private Key and Certificate
  copy:
    content: "{{ private_key_content['content'] }}{{ certificate_content['content'] }}"
    dest: /etc/ssl/certs/example.com.pem
    owner: root
    group: root
    mode: "0644"

