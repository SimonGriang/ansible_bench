d time for user\n  command: "chage -E {{ password_expires.stdout }} {{ user }}"\n\n- name: Place private key file for user\n  copy:\n    src: private.key\n    dest: "~/.ssh/"\n    owner: "{{ user }}"\n    group: "{{ user }}"\n    mode: 0600' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-05T07:50:52.583379164Z', 'done': True, 'done_reason': 'stop', 'total_duration': 14999215486, 'load_duration': 36141836, 'prompt_eval_count': 787, 'prompt_eval_duration': 545313142, 'eval_count': 667, 'eval_duration': 14416650244, 'model_name': 'granite-code:20b'} id='run--e5746eee-ff1d-44c5-b61b-ec709df34fe1-0' usage_metadata={'input_tokens': 787, 'output_tokens': 667, 'total_tokens': 1454}
