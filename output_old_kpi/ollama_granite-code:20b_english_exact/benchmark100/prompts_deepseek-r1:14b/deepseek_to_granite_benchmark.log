---

- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install Python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present
  when: python_pip_packages is defined

- name: Configure pip proxy settings
  ini_file:
    dest: /etc/pip.conf
    section: global
    option: index-url
    value: "{{ python_pip_proxy }}"
    mode: 0644
  when: python_pip_proxy is defined

- name: Configure pip trusted hosts
  ini_file:
    dest: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ python_pip_trusted_host }}"
    mode: 0644
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: latest
    skip_existing: true
  when:
  - python_pip_packages is defined
  - ansible_distribution != ' bookworm'
  - ansible_distribution != 'noble'
  - ansible_os_family != 'alpine'

- name: Install Python modules
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version }}"
    state: "{{ item.state }}"
  loop: "{{ python_pip_modules }}"
  when:
  - python_pip_modules is defined
  - ansible_distribution != 'bookworm'
  - ansible_distribution != 'noble'
  - ansible_os_family != 'alpine'

