ribution == "noble" or ansible_os_family == "Alpine" )' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-05T07:19:31.267732608Z', 'done': True, 'done_reason': 'stop', 'total_duration': 16085911815, 'load_duration': 27263985, 'prompt_eval_count': 1656, 'prompt_eval_duration': 89627813, 'eval_count': 633, 'eval_duration': 15967969269, 'model_name': 'granite-code:20b'} id='run--16ce23dd-132f-47d5-86cc-278a9e355559-0' usage_metadata={'input_tokens': 1656, 'output_tokens': 633, 'total_tokens': 2289}
