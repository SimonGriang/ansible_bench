---
- name: Install Ansible
  ansible.builtin.package:
    name: ansible
    state: "{{ ansible_package_state }}"

- name: Create temporary directory for Ansible installation
  ansible.builtin.tempfile:
    state: directory
    prefix: ansible
  register: tempdir

- name: Download Ansible installation package
  ansible.builtin.get_url:
    url: https://storage.googleapis.com/ansible-legacy/ansible-{{ ansible_version }}.tar.gz
    dest: "{{ tempdir.path }}/ansible-{{ ansible_version }}.tar.gz"

- name: Extract Ansible installation package
  ansible.builtin.unarchive:
    src: "{{ tempdir.path }}/ansible-{{ ansible_version }}.tar.gz"
    dest: "{{ tempdir.path }}"
    remote_src: true

- name: Install Ansible
  ansible.builtin.command:
    argv:
      - "{{ tempdir.path }}/ansible-{{ ansible_version }}/bin/ansible-install"
      - "--prefix=/usr"

- name: Clean up temporary directory
  ansible.builtin.file:
    path: "{{ tempdir.path }}"
    state: absent

