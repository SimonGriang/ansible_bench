---
- name: Check if Helm binary exists
  stat:
    path: /tmp/helm
  register: helm_check

- name: Check Helm version
  command: helm version
  register: helm_existing_version

- name: Download Helm
  unarchive:
    src: https://get.helm.sh/helm-v3.5.0-linux-amd64.tar.gz
    dest: /tmp
    remote_src: true
  when: helm_check.stat.exists == false or helm_existing_version.stdout != "version.BuildInfo{Version:\"v3.5.0\", GitCommit:\"0ad800ef43d3b826f31a5ad8dfbb4fe062e60646\", GitTreeState:\"clean\", GoVersion:\"go1.15.12\"}"

- name: Copy helm binary into place
  copy:
    src: /tmp/linux-amd64/helm
    dest: /usr/local/bin/helm
    mode: 0755
    owner: root
    group: root
  when: helm_check.stat.exists == false or helm_existing_version.stdout != "version.BuildInfo{Version:\"v3.5.0\", GitCommit:\"0ad800ef43d3b826f31a5ad8dfbb4fe062e60646\", GitTreeState:\"clean\", GoVersion:\"go1.15.12\"}"


