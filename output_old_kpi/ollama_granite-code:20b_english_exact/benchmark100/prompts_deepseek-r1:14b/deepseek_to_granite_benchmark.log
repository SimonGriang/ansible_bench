  tasks:
    - name: Install EPEL GPG key
      ansible.builtin.apt_key:
        url: "{{ epel_gpg_key }}"
        state: present

    - name: Install EPEL release package
      ansible.builtin.apt:
        name: "{{ epel_url }}"
        state: present
        update_cache: true

    - name: Install EPEL next release package (conditional)
      ansible.builtin.apt:
        name: "{{ epel_next_url }}"
        state: present
        update_cache: true
      when: epel_next

    - name: Update package cache
      ansible.builtin.apt:
        update_cache: true
        cache_valid_time: 3600


