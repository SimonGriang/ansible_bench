on': 11425448105, 'load_duration': 27882403, 'prompt_eval_count': 1032, 'prompt_eval_duration': 16288574, 'eval_count': 478, 'eval_duration': 11380186173, 'model_name': 'granite-code:20b'} id='run--1b8f3a03-ddff-451b-974c-21227a2c6a26-0' usage_metadata={'input_tokens': 1032, 'output_tokens': 478, 'total_tokens': 1510}
