---
- name: Create local SSH key directory for user
  file:
    path: "~/.ssh"
    state: directory
    owner: "{{ user }}"
    group: "{{ user }}"
    mode: 0750

- name: Manage user account
  user:
    name: "{{ user }}"
    state: present
    comment: ""
    home: "/home/{{ user }}"
    shell: /bin/bash

- name: Set sudo options for user
  template:
    src: sudoers.j2
    dest: /etc/sudoers.d/{{ user }}
    mode: 0440
    owner: root
    group: root

- name: Generate private SSH key for user
  command: "ssh-keygen -t rsa -b 4096 -C '' -f ~/.ssh/id_rsa"
  args:
    creates: "~/.ssh/id_rsa"

- name: Generate public SSH key for user
  command: "ssh-keygen -y -f ~/.ssh/id_rsa > ~/.ssh/id_rsa.pub"
  args:
    creates: "~/.ssh/id_rsa.pub"

- name: Convert SSH key to ppk format for user
  command: "puttygen ~/.ssh/id_rsa -O private-openssh -o ~/.ssh/id_rsa.ppk"
  args:
    creates: "~/.ssh/id_rsa.ppk"

- name: Get or set the home directory for user
  command: "getent passwd {{ user }} | cut -d: -f6"
  register: home_directory
  changed_when: false

- name: Create .ssh directory for user
  file:
    path: "~/.ssh"
    state: directory
    owner: "{{ user }}"
    group: "{{ user }}"
    mode: 0700

- name: Deploy authorized keys for user
  copy:
    src:authorized_keys
    dest: "~/.ssh/authorized_keys"
    owner: "{{ user }}"
    group: "{{ user }}"
    mode: 0600

- name: Remove unauthorized keys for user
  lineinfile:
    path: "~/.ssh/authorized_keys"
    state: absent
