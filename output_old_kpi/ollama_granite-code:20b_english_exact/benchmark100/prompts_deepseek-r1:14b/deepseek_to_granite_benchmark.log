---
- import_tasks: assert.yml
- name: Install Docker Compose package
  package:
    name: docker-compose
    state: present
  when: docker_compose_install_type == "package"
- name: Install Docker Compose binary
  block:
    - name: Install required packages
      package:
        name: "{{ item }}"
        state: present
      with_items: "{{ docker_compose_binary_required_packages }}"
    - name: Download Docker Compose binary
      get_url:
        url: "{{ docker_compose_binary_url }}"
        dest: /tmp/docker-compose
        mode: 0755
    - name: Move binary into /usr/local/bin
      copy:
        src: /tmp/docker-compose
        dest: /usr/local/bin
        remote_src: true
        mode: 0755
  when: docker_compose_install_type == "binary"

