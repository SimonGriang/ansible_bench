---
- name: "User management configuration"
  tasks:
    - import_tasks: assert.yml
    - name: "Install required software packages"
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ users_requirements }}"
      when: users_requirements is defined and users_requirements | length > 0
    - include_tasks: group.yml
      loop: "{{ users_groups }}"
      loop_control:
        loop_var: group
    - name: "Configure sudoers directory inclusion"
      block:
        - name: "Add /etc/sudoers.d directory inclusion"
          lineinfile:
            path: /etc/sudoers
            line: "#includedir /etc/sudoers.d"
            regexp: "^#includedir /etc/sudoers.d"
            state: present
          become: true
        - name: "Validate sudoers changes"
          command: visudo -cf /etc/sudoers
          changed_when: false
          become: true
      when: users_sudoers_include_dir
    - include_tasks: user.yml
      loop: "{{ users }}"
      loop_control:
        loop_var: user
    - name: "Configure cron allow permissions"
      block:
        - name: "Generate /etc/cron.allow file"
          template:
            src: cron.allow.j2
            dest: /etc/cron.allow
            mode: "0644"
          become: true
      when: users_cron_allow
    - name: "Remove cron allow file if not needed"
      file:
        path: /etc/cron.allow
        state: absent
      when: not users_cron_allow


