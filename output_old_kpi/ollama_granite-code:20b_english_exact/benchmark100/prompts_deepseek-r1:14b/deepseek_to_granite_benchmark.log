---

- name: Run assert.yml
  import_tasks: assert.yml
  run_once: true

- name: Install git
  package:
    name: git
    state: present

- name: Check if user exists
  user:
    name: "{{ item }}"
    state: present
  check_mode: true
  register: user_check
  with_items:
    - john
    - jane

- name: Create git config directory
  file:
    path: "/home/{{ item }}/git-config"
    state: directory
    mode: 0755
  with_items:
    - john
    - jane

- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ item }}/git-config/gitconfig"
    mode: 0644
  with_items:
    - john
    - jane

- name: Create repository destination
  file:
    path: "/home/{{ item }}/ git-repos/{{ repo }}"
    state: directory
    mode: 0755
  with_items:
    - john
    - jane
  loop:
    - project-a
    - project-b

- name: Clone all repositories
  git:
    repo: "{{ item.repo }}"
    dest: "/home/{{ item.user }}/git-repos/{{ item.dest }}"
    version: "{{ item.version }}"
    executable: /usr/bin/git
  with_items:
    - { user: john, dest: project-a, repo: https://github.com/john/project-a.git, version: main }
    - { user: john, dest: project-b, repo: https://github.com/john/project-b.git, version: main }
    - { user: jane, dest: project-a, repo: https://github.com/jane/project-a.git, version: main }
    - { user: jane, dest: project-b, repo: https://github.com/jane/project-b.git, version: main }

