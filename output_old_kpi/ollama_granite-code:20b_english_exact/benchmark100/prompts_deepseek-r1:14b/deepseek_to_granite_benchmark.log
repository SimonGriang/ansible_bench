---

- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  run_once: true

- name: Task 2 - Install git
  package:
    name: git
    state: present

- name: Task 3 - Check if user exists
  user:
    name: "{{ item }}"
    state: present
  check_mode: true
  register: user_check
  with_items:
    - john
    - jane

- name: Task 4 - Create git config directory
  file:
    path: "/home/{{ item }}/git-config"
    state: directory
    mode: "0755"
  with_items:
    - john
    - jane

- name: Task 5 - Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ item }}/git-config/gitconfig"
    mode: "0644"
  with_items:
    - john
    - jane

- name: Task 6 - Create repository destination
  file:
    path: "/home/{{ item }}/git-repos/{{ repo }}"
    state: directory
    mode: "0755"
  with_items:
    - john
    - jane
  loop:
    - project-a
    - project-b

- name: Task 7 - Clone all repositories
  git:
    repo: "{{ item.repo }}"
    dest: "/home/{{ item.user }}/git-repos/{{ item.dest }}"
    version: "{{ item.version }}"
    executable: /usr/bin/git
  with_items:
