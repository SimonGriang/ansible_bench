---
- import_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ service_required_packages }}"
    state: present
  notify: Gather facts

- name: Configure systemd service
  template:
    src: systemd.j2
    dest: "/etc/systemd/system/{{ item.name }}.service"
    mode: 0644
  loop: "{{ service_list }}"
  notify: Gather facts

- name: Configure sysvinit service
  template:
    src: sysvinit.j2
    dest: "/etc/init.d/{{ item.name }}"
    mode: 0755
  loop: "{{ service_list }}"
  notify: Gather facts

- name: Manage service
  service:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    enabled: "{{ item.enabled }}"
  loop: "{{ service_list }}"

- name: Flush handlers
  meta: flush_handlers


