---
- name: Configure httpd virtual hosts
  hosts: all
  tasks:
    - name: Create docroot directories for each virtual host
      file:
        path: "{{ httpd_vhosts_directory }}/{{ item.name }}/docroot"
        state: directory
        mode: 0755
        create: "{{ create_docroot }}"
      loop: "{{ httpd_vhosts }}"
      when: item.documentroot is defined
      notify: Test httpd configuration validity and Restart httpd

    - name: Configure virtual host settings
      template:
        src: vhost_conf_template
        dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
        mode: 0644
      loop: "{{ httpd_vhosts }}"
      notify: Test httpd configuration validity and Restart httpd

    - name: Enable virtual hosts on Debian systems
      command: a2ensite {{ item.name }}
      args:
        creates: "{{ httpd_sites_enabled }}/{{ item.name }}.conf"
      loop: "{{ httpd_vhosts }}"
      when: ansible_os_family == "Debian"
      notify: Test httpd configuration validity and Restart httpd
  handlers:
    - name: Test httpd configuration validity and Restart httpd
      command: httpd -t
      notify: Restart httpd
    - name: Restart httpd
      service:
        name: httpd
        state: restarted


