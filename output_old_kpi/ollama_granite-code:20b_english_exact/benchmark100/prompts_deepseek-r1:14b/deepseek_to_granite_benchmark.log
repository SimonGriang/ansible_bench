---
- import_tasks: assert.yml
- name: Install logrotate
  package:
    name: "{{ logrotate_packages }}"
    state: present
- name: Configure logrotate
  template:
    src: "{{ logrotate_config_file }}.j2"
    dest: "{{ logrotate_config_file }}"
    owner: root
    group: root
    mode: 0644
  notify: restart logrotate
- name: Generate logrotate.d files
  template:
    src: "{{ item.name }}.j2"
    dest: "{{ logrotate_dir }}/{{ item.name }}"
    owner: root
    group: root
    mode: 0644
  loop: "{{ logrotate_entries }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.absent is not defined or not item.absent
  notify: restart logrotate
- name: Remove logrotate.d files
  file:
    path: "{{ logrotate_dir }}/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  loop_control:
    label: "{{ item.name }}"
  when: item.absent is defined and item.absent
  notify: restart logrotate
- name: Start logrotate
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service is defined

