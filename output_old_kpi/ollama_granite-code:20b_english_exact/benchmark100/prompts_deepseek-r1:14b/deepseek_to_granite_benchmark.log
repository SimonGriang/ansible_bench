content='---\n- name: Install and configure Redis\n  hosts: all\n  tasks:\n    - import_tasks: assert.yml\n      run_once: true\n\n    - name: Enable Redis module stream for RHEL 8\n      when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"\n      become: true\n      dnf:\n        name: redis\n        state: present\n\n    - name: Install Redis package\n      become: true\n      package:\n        name: "{{ redis_packages }}"\n        state: present\n\n    - name: Configure Redis settings\n      become: true\n      template:\n        src: redis.conf-{{ ansible_distribution }}.j2\n        dest: /etc/redis.conf\n        owner: "{{ redis_owner }}"\n        group: "{{ redis_group }}"\n        mode: "{{ redis_mode }}"\n      notify: restart Redis\n\n    - name: Start and enable Redis service\n      become: true\n      service:\n        name: "{{ redis_service }}"\n        state: started\n        enabled: true\n\n  handlers:\n    - name: restart Redis\n      become: true\n      service:\n        name: "{{ redis_service }}"\n        state: restarted' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-05T07:45:13.251127648Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5673397406, 'load_duration': 36231198, 'prompt_eval_count': 464, 'prompt_eval_duration': 177462412, 'eval_count': 236, 'eval_duration': 5458511011, 'model_name': 'granite-code:20b'} id='run--d3cbe97a-cc21-4dd8-ba5d-80227cfbb435-0' usage_metadata={'input_tokens': 464, 'output_tokens': 236, 'total_tokens': 700}
