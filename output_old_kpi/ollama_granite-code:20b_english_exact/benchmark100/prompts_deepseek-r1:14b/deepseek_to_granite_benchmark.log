      environment:
        INSTALL_RKE2_TYPE: "agent"
        INSTALL_RKE2_VERSION: "v{{ rke2_version }}"
        AIRGAP_IMAGE: "{{ airgap_image }}"
        AIRGAP_IMAGE_CHECKSUM: "{{ airgap_image_checksum }}"
        AIRGAP_IMAGE_PATH: "{{ airgap_image_path }}"
        INSTALL_RKE2_ARM64: "{% if ansible_architecture == 'aarch64' %}--arm64{% endif %}"
      register: rke2_install_command
      changed_when: false
      until: rke2_install_command is succeeded
      retries: 5
      delay: 10

    - name: Copy Custom Manifests
      template:
        src: ../templates/rke2-custom-manifests.yaml.j2
        dest: /etc/kubernetes/manifests/rke2-custom-manifests.yaml
      notify:
        - restart rke2-server

    - name: Copy Static Pods
      copy:
        src: ../files/{{ item }}
        dest: /etc/kubernetes/manifests/{{ item }}
        owner: root
        group: root
        mode: 0644
      loop:
        - rke2-static-pod-ResponseWriter.yaml
        - rke2-static-pod-cluster-profiler.yaml
      notify:
        - restart rke2-server

    - name: Copy RKE2 environment file
      template:
