      file:
        path: /var/lib/rke2/agent/artifacts/{{ item }}
        state: file
        mode: 0640
        owner: root
        group: root
      loop:
        - rke2.linux-amd64.tar.gz
        - rke2-linux-amd64.sha256
        - rke2.linux-amd64.tar.gz.sha256
      when: airgap_mode and rke2_install_method == 'exists'

