---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  tags: [always]

- name: Task 2 - Pre-configure debian systems
  block:
    - name: Import debconf tasks
      import_tasks: debconf.yml
  when: ansible_os_family == "Debian"
  tags: [always]

- name: Task 3 - Install postfix
  ansible.builtin.package:
    name: postfix
    state: present
  tags: [postfix]

- name: Task 4 - Install postfix-mysql
  ansible.builtin.package:
    name: postfix-mysql
    state: present
  when: postfix_mysql_enabled | bool
  tags: [postfix]

- name: Task 5 - Configure postfix (transport_maps)
  ansible.builtin.template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: 0644
    owner: root
    group: root
  notify: restart postfix
  tags: [postfix]

- name: Task 6 - Configure postfix (header_checks)
  ansible.builtin.template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: 0644
    owner: root
    group: root
  notify: reload postfix
  tags: [postfix]

- name: Task 7 - Setting values for main.cf (1/2)
  ansible.builtin.set_fact:
    postfix_main_cf:
      # configure recipient_access
  tags: [postfix]

- name: Task 8 - Setting values for main.cf (2/2)
  ansible.builtin.set_fact:
    postfix_main_cf:
      # configure sender_access
  tags: [postfix]

- name: Task 9 - Configure postfix (main.cf)
  ansible.builtin.template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 0644
    owner: root
    group: root
  notify: validate postfix
  tags: [postfix]

- name: Task 10 - Configure postfix (master.cf)
  ansible.builtin.template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: 0644
    owner: root
    group: root
  notify: restart postfix
  tags: [postfix]

- name: Task 11 - Creates cert/key directory
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: postfix
    group: postfix
    mode: 0700
  loop:
    - /etc/postfix/cert
    - /etc/postfix/key
  tags: [postfix, always]

- name: Task 12 - Deploy Postfix TLS server certificate
  ansible.builtin.copy:
    src: "{{ postfix_tls_server_cert }}"
    dest: /etc/postfix/cert/server.pem
    mode: 0644
    owner: root
    group: postfix
  notify: reload postfix
  tags: [postfix]

- name: Task 13 - Deploy Postfix TLS server key
  ansible.builtin.copy:
    src: "{{ postfix_tls_server_key }}"
    dest: /etc/postfix/key/server.pem
    mode: 0644
    owner: root
    group: postfix
  notify: reload postfix
  tags: [postfix]

- name: Task 14 - Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Task 15 - Configure aliases
  ansible.builtin.lineinfile:
    path: /etc/aliases
    line: "{{ item.line }}"
    regexp: "^{{ item.regexp }}$"
    state: "{{ item.state }}"
    mode: 0644
    owner: root
    group: root
  loop:
    - line: postmaster: root
      regexp: postmaster
      state: absent
    - line: root: root
      regexp: root
      state: present
  notify: rebuild postfix
  tags: [postfix]

- name: Task 16 - Configure sender_access
  ansible.builtin.lineinfile:
    path: /etc/postfix/sender_access
    line: "{{ item.line }}"
    regexp: "^{{ item.regexp }}$"
    state: "{{ item.state }}"
    mode: 0644
    owner: root
    group: root
  loop:
    - line: 127.0.0.1/32   ALL
      regexp: 127.0.0.1/32
      state: absent
    - line: 192.168.0.0/16 ALL
      regexp: 192.168.0.0/16
      state: present
  notify: reload postfix
  tags: [postfix]

- name: Task 17 - Configure recipient_access
  ansible.builtin.lineinfile:
    path: /etc/postfix/recipient_access
    line: "{{ item.line }}"
    regexp: "^{{ item.regexp }}$"
    state: "{{ item.state }}"
    mode: 0644
    owner: root
    group: root
  loop:
    - line: 127.0.0.1/32   ALL
      regexp: 127.0.0.1/32
      state: absent
    - line: 192.168.0.0/16 ALL
      regexp: 192.168.0.0/16
      state: present
  notify: reload postfix
  tags: [postfix]

- name: Task 18 - Place sasl_password_map
  ansible.builtin.copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: /etc/postfix/sasl_password
    owner: root
    group: root
    mode: 0600
  notify: rebuild map
  tags: [postfix]

- name: Task 19 - Flush handlers again
  ansible.builtin.meta: flush_handlers

- name: Task 20 - Start and enable postfix
  ansible.builtin.service:
    name: postfix
    state: started
    enabled: yes
  tags: [postfix]

