---
- name: Task 1 - Import assertion file
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Install cron packages
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Task 3 - Configure cron shell
  lineinfile:
    path: /etc/cron.conf
    line: "SHELL={{ cron_shell }}"
    regexp: "^SHELL="
    state: present
  register: cron_configuration_changed

- name: Task 4 - Restart cron service
  service:
    name: cron
    state: restarted
  when: cron_configuration_changed.changed

- name: Task 5 - Configure cron path
  lineinfile:
    path: /etc/cron.conf
    line: "PATH={{ cron_path }}"
    regexp: "^PATH="
    state: present
  register: cron_configuration_changed

- name: Task 6 - Restart cron service
  service:
    name: cron
    state: restarted
  when: cron_configuration_changed.changed

- name: Task 7 - Configure cron mailto
  lineinfile:
    path: /etc/cron.conf
    line: "MAILTO={{ cron_mailto }}"
    regexp: "^MAILTO="
    state: present
  register: cron_configuration_changed

- name: Task 8 - Restart cron service
  service:
    name: cron
    state: restarted
  when: cron_configuration_changed.changed

- name: Task 9 - Start and enable cron service
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service

