---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item }}"
    state: directory
    mode: "{{ dns_mode }}"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  loop:
    - "{{ dns_config_dir }}"
    - "{{ dns_data_dir }}"

- name: Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Create user
  user:
    name: "{{ dns_owner }}"
    state: present
    system: true

- name: Generate rndc key
  shell: rndc-confgen -a -c {{ dns_config_dir }}
  args:
    creates: "{{ dns_config_dir }}/rndc.key"

- name: Set permissions on rndc key file
  file:
    path: "{{ dns_config_dir }}/rndc.key"
    owner: root
    group: "{{ dns_group }}"
    mode: 0640

- name: Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.cache
    dest: "{{ dns_data_dir }}/root. hints"
    mode: 0644
  when: dns_caching_dns

- name: Create zone file
  template:
    src: named.conf.j2
    dest: "{{ dns_config_dir }}/{{ item.zone }}.conf"
    validate: named-checkconf %s
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Add zones to configuration
  assemble:
    src: "{{ dns_config_dir }}/"
    dest: "{{ dns_config_dir }}/named.conf"
    owner: root
    group: "{{ dns_group }}"
    mode: 0640
  notify: Restart dns

- name: Place systemd override
  template:
    src: systemd.j2
    dest: "{{ dns_config_dir }}/systemd.conf"
    validate: systemd-check %s
  notify: Reload systemd
  when: dns_dns_service_manager == "systemd"

- name: Start and enable dns
  service:
    name: "{{ dns_service_name }}"
    state: started
    enabled: true

