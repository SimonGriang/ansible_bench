    - name: Configure keystore directory for Java < 11
      set_fact:
        java_keystore_dir: /path/to/legacy/keystore
      when: ansible_distribution_major_version | int < 11

- name: Set keystore directory for Java versions 11 or newer
  hosts: all
  vars:
    ansible_python_interpreter: /usr/bin/python3
