    timeout: "{{ bootstrap_timeout }}"
  connection: "{{ __bootstrap_connection }}"
  become: false
  when: __bootstrap_wait

- block:
    - name: test connection
      connection: local
      command: "{{ __bootstrap_ gather_cmd }}"
      changed_when: false

    - name: test sudo
      connection: local
      command: sudo -v
      changed_when: false

    - name: install python for Ansible
      raw: "{{ __bootstrap_raw_python_package }}"
      changed_when: false
      when: __bootstrap_raw_python_package is defined

    - name: install libdnf5 (RedHat)
      raw: "yum install libdnf5 -y"
