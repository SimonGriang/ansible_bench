---
- name: "CIS - Section 3.1"
  hosts: all
  tasks:
    - name: "3.1.1 | Ensure etcd group is created"
      group:
        name: etcd
        state: present
    - name: "3.1.2 | Ensure etcd user is created"
      user:
        name: etcd
        shell: /bin/nologin
        group: etcd
        comment: etcd user
        state: present
    - name: "3.1.3 | Ensure /etc/sysctl.d/60-rke2-cis.conf is configured"
      copy:
        src: "{{ '/usr/local/share/rke2/rke2-cis-sysctl.conf' if (not usr_local.stat.writeable) or (partition_result.rc == 1) else '/opt/rke2/share/rke2/rke2-cis-sysctl.conf' }}"
        dest: /etc/sysctl.d/60-rke2-cis.conf
        mode: 0600
        remote_src: true
      notify: "Restart systemd-sysctl"
  handlers:
    - name: "Restart systemd-sysctl"
      systemd:
        name: systemd-sysctl
        daemon_reload: yes
        state: restarted

