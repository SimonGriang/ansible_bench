---
- name: Install unzip package
  apt:
    name: unzip
    state: present
  tags:
    - package

- name: Create system group for promtail
  group:
    name: promtail
    state: present
    system: true
  tags:
    - group

- name: Create system user for promtail
  user:
    name: promtail
    group: promtail
    groups: adm,sudo
    append: true
    create_home: true
    home: /var/lib/promtail
    shell: /usr/sbin/nologin
    system: true
  tags:
    - user

- name: Ensure /usr/local/bin directory exists
  file:
    path: /usr/local/bin
    state: directory
    owner: root
    group: root
    mode: 0755
  tags:
    - directory

- name: Create config directories
  file:
    path: "{{ item }}"
    state: directory
    owner: promtail
    group: promtail
    mode: 0750
  loop:
    - /etc/promtail
    - /etc/promtail/positions
    - /etc/promtail/scrape_configs
  tags:
    - directory

- name: Create application directories
  file:
    path: "{{ item }}"
    state: directory
    owner: promtail
    group: promtail
    mode: 0755
  loop:
    - /var/lib/promtail
    - /var/log/promtail
  tags:
    - directory

- name: Check promtail binary existence
  stat:
    path: /usr/local/bin/promtail
  register: promtail_binary
  tags:
    - binary

- name: Download promtail binaries
  get_url:
    url: https://github.com/grafana/loki/releases/download/v2.3.0/promtail-linux-amd64.zip
    dest: /tmp/promtail.zip
    mode: 0440
    checksum: sha256:85e3c51e20537346282865047a66b82276015445f07e0e887b8443880e833536
  when: not promtail_binary.stat.exists
  tags:
    - binary

- name: Propagate local promtail binaries
  copy:
    src: /usr/local/bin/promtail
    dest: /tmp/promtail
    mode: 0755
  when: not promtail_binary.stat.exists
  tags:
    - binary

- name: Download promtail binaries for controller node
  get_url:
    url: http://<controller_ip>/tmp/promtail
    dest: /tmp/promtail
    mode: 0755
  delegate_to: controller
  run_once: true
  when: not promtail_binary.stat.exists
  tags:
    - binary

- name: Propagate promtail binaries
  copy:
    src: /tmp/promtail
    dest: /usr/local/bin
    mode: 0755
  when: not promtail_binary.stat.exists
  tags:
    - binary

- name: Unpack promtail binaries
  unarchive:
    src: /tmp/promtail.zip
    dest: /usr/local/bin
    remote_src: true
  when: not promtail_binary.stat.exists
  tags:
    - binary

- name: Create symlink to latest promtail version
  file:
    src: /usr/local/bin/promtail-linux-amd64
    dest: /usr/local/bin/promtail
    owner: root
    group: root
    state: link
  notify: Restart promtail
  when: not promtail_binary.stat.exists
  tags:
    - binary

- name: Write promtail config file
  template:
    src: promtail.yml.j2
    dest: /etc/promtail/promtail.yml
    owner: promtail
    group: promtail
    mode: 0640
  notify: Restart promtail
  tags:
    - config

- name: Create systemd service unit
  template:
    src: promtail.service.j2
    dest: /usr/lib/systemd/system/promtail.service
    owner: root
    group: root
    mode: 0644
  notify: Restart promtail
  tags:
    - service

