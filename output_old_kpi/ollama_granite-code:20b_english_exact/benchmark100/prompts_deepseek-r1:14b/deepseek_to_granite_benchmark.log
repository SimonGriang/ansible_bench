---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  run_once: yes

- name: Task 2 - Install requirements
  package:
    name: "{{ sysctl_requirements }}"
    state: present
  when: sysctl_requirements is defined and not ansible_connection == 'container'

- name: Task 3 - Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: "{{ 'present' if sysctl_items is defined and not ansible_connection == 'container' else 'absent' }}"
    reload: "{{ sysctl_reload }}"
  loop: "{{ sysctl_items }}"
  notify: sysctl_reload


