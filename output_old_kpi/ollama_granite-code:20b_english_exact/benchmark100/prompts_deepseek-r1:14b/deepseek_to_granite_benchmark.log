---
- name: Bootstrap | Gather OS release information
  command: cat /etc/os-release
  register: os_release_raw

- name: Bootstrap | Set OS release facts
  set_fact:
    os_release: "{{ os_release_raw.stdout | from_json }}"

- name: Bootstrap | Set distribution name
  set_fact:
    ansible_distribution: "{{ os_release['NAME'] | lower }}"

- name: Bootstrap | Set distribution major version
  set_fact:
    ansible_distribution_major_version: "{{ os_release['VERSION_ID'] }}"

- name: Bootstrap | Set OS family
  set_fact:
    ansible_os_family: "{{ os_family_map[ansible_distribution] | default('Debian') }}"
  vars:
    os_family_map:
      Debian: Debian
      RedHat: RedHat
      CentOS: RedHat
      Fedora: RedHat

