---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present
  notify: restart apache

- name: Configure selinux
  selinux:
    state: "{{ httpd_selinux }}"
    policy: "{{ httpd_selinux_policy }}"
    boolean: "{{ item.name }}"
    value: "{{ item.value }}"
  with_items: "{{ httpd_sebooleans }}"
  when: httpd_selinux | bool

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify:
    - configtest
    - restart apache

- name: Activate httpd module | Debian
  community.general.mod_watch:
    name: "{{ item }}"
    state: present
  with_items: "{{ httpd_modules_to_activate_with_command }}"
  notify: restart apache
  when: ansible_os_family == 'Debian'

- import_tasks: ssl.yml
  when: https_ssl_enable | bool

- import_tasks: locations.yml
  when: httpd_locations is defined

- import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Configure ports
  template:
    src: ports.conf.j2
    dest: /etc/apache2/ports.conf
    mode: 0644
  notify:
    - configtest
    - restart apache
  when: ansible_os_family == 'Debian' or ansible_os_family == 'Suse'

- import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: "{{ httpd_data_directory }}/index.html"
    state: absent
  notify: restart apache
  when: httpd_remove_example | bool

- name: Start and enable httpd
  ansible.builtin.service:
    name: "{{ httpd_service }}"
    state: started
    enabled: true

