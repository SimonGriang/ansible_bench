---
- name: Install and configure Redis
  hosts: all
  tasks:
    - import_tasks: assert.yml
      run_once: true

    - name: Enable Redis module stream for RHEL 8
      when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"
      become: true
      dnf:
        name: redis
        state: present

    - name: Install Redis package
      become: true
      package:
        name: "{{ redis_packages }}"
        state: present

    - name: Configure Redis settings
      become: true
      template:
        src: redis.conf-{{ ansible_distribution }}.j2
        dest: /etc/redis.conf
        owner: "{{ redis_owner }}"
        group: "{{ redis_group }}"
        mode: "{{ redis_mode }}"
      notify: restart Redis

    - name: Start and enable Redis service
      become: true
      service:
        name: "{{ redis_service }}"
        state: started
        enabled: true

  handlers:
    - name: restart Redis
      become: true
      service:
        name: "{{ redis_service }}"
        state: restarted

Explanation:
- The yamllint error "line too long" is fixed by breaking the long line into multiple lines.
- The yamllint error "no new line character at the end of file" is fixed by adding a new line character at the end of the file.

