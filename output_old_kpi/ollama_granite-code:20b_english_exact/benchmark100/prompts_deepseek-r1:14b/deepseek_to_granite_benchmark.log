---
- name: locations | Enable modules
  tags:
    - configuration
    - debian
    - suse
  block:
    - name: locations | Enable modules | Debian | proxy
      apache2_module:
        name: proxy
        state: present
      notify: httpd configuration test and restart
    - name: locations | Enable modules | Debian | proxy_http
      apache2_module:
        name: proxy_http
        state: present
      notify: httpd configuration test and restart
    - name: locations | Enable modules | Suse | proxy
      apache2_module:
        name: proxy
        state: present
      notify: httpd configuration test and restart
    - name: locations | Enable modules | Suse | proxy_http
      apache2_module:
        name: proxy_http
        state: present
      notify: httpd configuration test and restart
- name: locations | Configure locations
  tags:
    - configuration
    - template
  template:
    src: "httpd/conf.d/locations/{{ item }}.conf.j2"
    dest: "/etc/httpd/conf.d/locations/{{ item }}.conf"
    mode: "0644"
    owner: root
    group: root
  loop: "{{ httpd_locations }}"
  notify: httpd configuration test and restart


