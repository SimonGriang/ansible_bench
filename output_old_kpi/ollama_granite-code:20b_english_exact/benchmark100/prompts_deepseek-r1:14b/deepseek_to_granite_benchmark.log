    - name: Copy SystemD unit file for Vault
      copy:
        src: /tmp/vault.service
        dest: /etc/systemd/system/vault.service
        mode: 0644
    - name: Start and enable Vault service
      systemd:
        name: vault
        state: started
        enabled: true

- name: Initialize Vault
  hosts: all
  tasks:
    - name: Initialize Vault
      command: vault operator init

- name: Unseal Vault
  hosts: all
  tasks:
    - name: Unseal Vault
      command: vault operator unseal

- name: Enable and start Jenkins master
  hosts: all
  tasks:
    - name: Enable and start Jenkins master
      systemd:
        name: jenkins
        state: started
        enabled: true

- name: Install Jenkins
  hosts: all
  tasks:
    - name: Install Jenkins
      apt:
        name: jenkins
        state: present

- name: Create necessary directories for Jenkins
  hosts: all
  tasks:
    - name: Create necessary directories for Jenkins
      file:
        path: "{{ item }}"
        state: directory
      loop:
        - /var/cache/jenkins/heap
        - /var/lib/jenkins/jobs
        - /var/log/jenkins
    - name: Set appropriate permissions for Jenkins directories
      file:
        path: "{{ item }}"
        owner: jenkins
        group: jenkins
        recurse: true
      loop:
        - /var/cache/jenkins/heap
        - /var/lib/jenkins/jobs
        - /var/log/jenkins
    - name: Create necessary symbolic links for Jenkins directories
      file:
        src: "{{ item.src }}"
        dest: "{{ item.dest }}"
        state: link
      loop:
        - src: /var/lib/jenkins/jobs
          dest: /var/cache/jenkins/jobs
        - src: /var/log/jenkins
          dest: /var/lib/jenkins/logs

- name: Download and extract Jenkins archive
  hosts: all
