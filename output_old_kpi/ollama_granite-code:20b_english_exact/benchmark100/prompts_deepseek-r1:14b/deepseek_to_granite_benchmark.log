---
- name: Bootstrap Server
  tasks:
    - name: Lookup bootstrap facts
      raw: "cat /etc/os-release"
      register: bootstrap_facts
      changed_when: false
      vars:
        ansible_user: "{{ bootstrap_user }}"
    - name: Set bootstrap facts
      loop: "{{ bootstrap__os_family_map }}"
      set_fact:
        bootstrap_distribution: "{{ item.value.distribution | regex_replace('(.*) \\(.*\\)', '\\1') | regex_replace('(.*) \\d+\\.\\d+(\\.\\d+)?', '\\1') }}"
        bootstrap_distribution_major_version: "{{ item.value.distribution | regex_replace('(.*) \\(.*\\)', '\\1') | regex_replace('\\w+ (\\d+\\.\\d+(\\.\\d+)?)', '\\1') }}"
      when: item.value.distribution is defined
      become: "{{ item.value.become | default(omit) }}"
    - name: Set bootstrap facts (II)
      loop: "{{ bootstrap__os_family_map }}"
      set_fact:
        bootstrap_os_family: "{{ item.key }}"
      become: "{{ item.value.become | default(omit) }}"

