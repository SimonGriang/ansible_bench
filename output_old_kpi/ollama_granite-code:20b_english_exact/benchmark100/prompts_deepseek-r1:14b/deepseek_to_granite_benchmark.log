---
- name: Initialize Kubernetes with kubeadm
  hosts: all
  tasks:
    - name: Initialize Kubernetes with kubeadm
      command: kubeadm init

- name: Create a kubeconfig for the admin user
  hosts: all
  tasks:
    - name: Create a kubeconfig for the admin user
      command: kubeadmin.sh create-kubeconfig

- name: Install Docker
  hosts: all
  tasks:
    - name: Install Docker
      apt:
        name: docker.io
        state: present

- name: Start and enable Docker service
  hosts: all
  tasks:
    - name: Start and enable Docker service
      systemd:
        name: docker
        state: started
        enabled: true

- name: Download and extract WeaveNet release archive
  hosts: all
  tasks:
    - name: Download and extract WeaveNet release archive
      unarchive:
        src: https://github.com/weaveworks/weave/releases/download/v2.8.1/weave-linux-amd64.tar.gz
        dest: /opt
        remote_src: true

- name: Copy WeaveNet binary to /usr/local/bin
  hosts: all
  tasks:
    - name: Copy WeaveNet binary to /usr/local/bin
      copy:
        src: /opt/weave/weave
        dest: /usr/local/bin/weave
        mode: 0755

- name: Create /etc/cni/net.d directory
  hosts: all
  tasks:
    - name: Create /etc/cni/net.d directory
      file:
        path: /etc/cni/net.d
        state: directory

- name: Copy WeaveNet CNI plugin configuration to /etc/cni/net.d
  hosts: all
  tasks:
    - name: Copy WeaveNet CNI plugin configuration to /etc/cni/net.d
      copy:
        src: /opt/weave/weave-cni.conflist
        dest: /etc/cni/net.d/weave.conflist
        mode: 0644

- name: Copy Calico CNI plugin configuration to /etc/cni/net.d
  hosts: all
  tasks:
    - name: Copy Calico CNI plugin configuration to /etc/cni/net.d
      copy:
        src: /opt/calico/calico.conflist
        dest: /etc/cni/net.d/calico.conflist
        mode: 0644

- name: Create /opt/cni/bin directory
  hosts: all
  tasks:
    - name: Create /opt/cni/bin directory
      file:
        path: /opt/cni/bin
        state: directory

- name: Copy Calico CNI plugin binary to /opt/cni/bin
  hosts: all
  tasks:
    - name: Copy Calico CNI plugin binary to /opt/cni/bin
      copy:
        src: /opt/calico/calico
        dest: /opt/cni/bin/calico
        mode: 0755

- name: Copy Calico CNI plugin binary to /opt/cni/bin
  hosts: all
  tasks:
    - name: Copy Calico CNI plugin binary to /opt/cni/bin
      copy:
        src: /opt/calico/calico
        dest: /opt/cni/bin/calico
        mode: 0755

- name: Copy Calico CNI plugin binary to /opt/cni/bin
  hosts: all
  tasks:
    - name: Copy Calico CNI plugin binary to /opt/cni/bin
      copy:
        src: /opt/calico/calico
        dest: /opt/cni/bin/calico
        mode: 0755

- name: Copy Calico CNI plugin binary to /opt/cni/bin
  hosts: all
  tasks:
    - name: Copy Calico CNI plugin binary to /opt/cni/bin
      copy:
        src: /opt/calico/calico
        dest: /opt/cni/bin/calico
        mode: 0755

- name: Enable Calico CNI plugin
  hosts: all
  tasks:
    - name: Enable Calico CNI plugin
      systemd:
        name: calico
        state: started
        enabled: true

- name: InstallMetricsServer
  hosts: all
  tasks:
    - name: Install MetricsServer
      command: kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml

- name: Install Helm v3
  hosts: all
  tasks:
    - name: Add Helm v3 repository
      command: helm repo add chartmuseum https://chartmuseum.build.cd.jenkins.io
    - name: Update Helm v3 repository
      command: helm repo update
    - name: Install Helm v3
      command: helm install chartmuseum/helm --version 3.7.0

- name: Install Vault
  hosts: all
  tasks:
    - name: Install Vault
      unarchive:
        src: /tmp/vault.zip
        dest: /usr/local/bin
        remote_src: true
    - name: Set file permissions for Vault
      file:
        path: /usr/local/bin/vault
        mode: 0755
    - name: Create Vault data directory
      file:
        path: /var/lib/vault
        state: directory
    - name: Create symbolic link for Vault data directory
      file:
        src: /var/lib/vault
        dest: /opt/vault/data
        state: link
    - name: Copy Vault configuration file
      copy:
        src: /tmp/vault.hcl
        dest: /opt/vault/config/vault.hcl
        mode: 0644
    - name: Copy SystemD unit file for Vault
      copy:
        src: /tmp/vault.service
        dest: /etc/systemd/system/vault.service
        mode: 0644
    - name: Start and enable Vault service
      systemd:
        name: vault
        state: started
        enabled: true

- name: Initialize Vault
  hosts: all
  tasks:
    - name: Initialize Vault
      command: vault operator init

- name: Unseal Vault
  hosts: all
  tasks:
    - name: Unseal Vault
      command: vault operator unseal

