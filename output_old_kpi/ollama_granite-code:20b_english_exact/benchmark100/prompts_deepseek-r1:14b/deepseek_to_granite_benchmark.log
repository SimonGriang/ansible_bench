- name: "CIS - Section 3.1"
  hosts: all
  tasks:
    - name: "3.1.1 | Ensure etcd group is created"
      group:
        name: etcd
        state: present
    - name: "3.1.2 | Ensure etcd user is created"
      user:
        name: etcd
        shell: /bin/nologin
        group: etcd
        comment: etcd user
        state: present
