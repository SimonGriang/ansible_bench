---
- import_tasks: assert.yml
- name: Install mysql
  package:
    name: "{{ packages }}"
    state: present
  notify: root password
  tags: packages
- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/my.cnf
    line: "{{ item.line }}"
    regexp: "{{ item.regexp }}"
    state: present
  loop: "{{ mysql_server_settings }}"
  notify: mysql server restart
  tags: configuration
- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/my.cnf
    line: "socket = /run/mysqld/mysqld.sock"
    regexp: '^socket = '
    state: present
  notify: mysql server restart
  tags: configuration
- name: Initialize mysql
  command: mysql_install_db --user=mysql --basedir=/usr/bin --datadir=/var/lib/mysql/
  when: ansible_os_family == "Debian"
  changed_when: false
  notify: mysql server restart
- name: Initialize mysql
  command: mysql_install_db --user=mysql --basedir=/usr/bin --datadir=/var/lib/mysql/
  when: ansible_os_family == "Archlinux"
  changed_when: false
  notify: mysql server restart
- name: Start and enable mysql
  service:
    name: "{{ service_name }}"
    state: started
    enabled: yes
- name: Flush handlers
  meta: flush_handlers
- name: Place my.cnf
  template:
    src: mysql/my.cnf.j2
    dest: /etc/mysql/my.cnf
    mode: "0644"
- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ databases }}"
  when: initial_import is not defined
- name: List databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ databases }}"
  register: mysql_databases
- name: Import database
  command: "mysql -uroot < {{ initial_import }}/{{ item }}"
  loop: "{{ databases }}"
  when: initial_import is defined and item not in mysql_databases.stdout_lines
- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  loop: "{{ users }}"
  notify: mysql server restart
- name: Flush handlers again
  meta: flush_handlers

