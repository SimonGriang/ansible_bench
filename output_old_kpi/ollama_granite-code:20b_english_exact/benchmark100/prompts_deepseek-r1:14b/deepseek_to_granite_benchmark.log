---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Install cron package
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure cron shell environment
  lineinfile:
    path: /etc/cron.env
    regexp: "^SHELL="
    line: "SHELL=/bin/bash"
    create: yes

- name: Configure cron path environment
  lineinfile:
    path: /etc/cron.env
    regexp: "^PATH="
    line: "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    create: yes

- name: Configure cron mailto settings
  lineinfile:
    path: /etc/cron.env
    regexp: "^MAILTO="
    line: "MAILTO=root"
    create: yes

- name: Start and enable cron service
  service:
    name: cron
    state: started
    enabled: "{{ cron_service is defined }}"

- name: Schedule cron jobs
  cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    state: present
  with_items: "{{ cron_jobs }}"

