---
- name: cadvisor | create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: "0755"
  loop:
    - /opt/cadvisor
    - /etc/systemd/system/cadvisor.service.d

- name: cadvisor | download
  get_url:
    url: https://github.com/google/cadvisor/releases/download/v0.37.0/cadvisor
    dest: /opt/cadvisor/cadvisor
    mode: "0755"
    checksum: "sha256:2f1173bf290518891f8577e6a94056208c7056207527b9b3a45b4f0f60065c01"

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: /tmp/downloads/cadvisor
    dest: /opt/cadvisor/cadvisor
    mode: "0755"
    owner: root
    group: root
    remote_src: yes
  notify: restart cadvisor

- name: cadvisor | symlink
  file:
    src: /opt/cadvisor/cadvisor
    dest: /usr/local/bin/cadvisor
    owner: root
    group: root
    state: link

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    owner: root
    group: root
    mode: "0644"
  notify: restart cadvisor

- name: test_task
  service:
    name: cadvisor
    state: started
  register: service_active

- name: debug
  debug:
    var: service_active

- name: cadvisor | enable server systemd
  systemd:
    name: cadvisor
    enabled: yes

- name: cadvisor | start server systemd
  systemd:
    name: cadvisor
    state: started
    daemon_reload: yes

