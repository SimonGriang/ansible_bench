- name: "Playbook: k3s-deploy"
  tasks:
    - name: "Install Keepalived service"
      import_tasks: tasks/keepalived.yml
      when: ha_enabled and ha_keepalived_enabled
    - name: "Download and install RKE2"
      import_tasks: tasks/rke2.yml
    - name: "Perform CIS hardening"
      import_tasks: tasks/cis.yml
      when: cis_profile is defined
    - name: "Find and identify the active server"
      import_tasks: tasks/active-server.yml
    - name: "Enable IPVS kernel module"
      import_tasks: tasks/ipvs.yml
      when: ha_enabled and ha_mode == "ipvs"
    - name: "Copy kube-vip manifests"
      import_tasks: tasks/kube-vip.yml
      when: ha_enabled and ha_mode != "none" and ha_kube_vip_enabled
    - name: "Copy ingress-nginx manifests"
      import_tasks: tasks/ingress-nginx.yml
      when: ingress_nginx_values is defined
    - name: "Prepare the first server node"
      import_tasks: tasks/first-server.yml
      when: groups['k3s_cluster'] | length > 1 and groups['k3s_cluster'] | first == inventory_hostname
    - name: "Perform etcd restore"
      import_tasks: tasks/etcd-restore.yml
      when: ha_enabled and ha_mode != "none" and ha_cluster_reset
    - name: "Download kubeconfig"
      import_tasks: tasks/kubeconfig.yml
      when: download_kubeconfig
    - name: "Prepare and join remaining cluster nodes"
      import_tasks: tasks/join-nodes.yml
      when: groups['k3s_cluster'] | length > 1 and inventory_hostname != groups['k3s_cluster'] | first
    - name: "Perform rolling restart of server nodes"
      import_tasks: tasks/rolling-restart-servers.yml
      when: ha_enabled and ha_mode != "none" and k3s_version_changed
    - name: "Perform rolling restart of agent nodes"
      import_tasks: tasks/rolling-restart-agents.yml
      when: ha_enabled and ha_mode != "none" and k3s_version_changed
    - name: "Flush handlers"
      meta: flush_handlers
    - name: "Perform rolling restart when config changes"
      import_tasks: tasks/rolling-restart.yml
      when: ha_enabled and ha_mode != "none" and k3s_config_changed
    - name: "Perform final steps"
      import_tasks: tasks/summary.yml


