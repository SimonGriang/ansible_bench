      when: airgap_mode and rke2_install_method == 'exists'

    - name: Airgap mode - ensure install script exists and has acceptable permissions
      file:
        path: /usr/local/bin/rke2-install
        state: file
        mode: 0700
        owner: root
        group: root
      when: airgap_mode and rke2_install_method == 'exists'

    - name: Populate service facts
      service_facts:

    - name: Get stats of the FS object
      stat:
        path: /usr/local
      register: local_partition_stats

    - name: Set RKE2 bin path
      set_fact:
        rke2_bin_path: "/usr/local/bin{{ '/usr/bin' if ansible_facts.services['rke2-server.service']['status'] is not defined else '' }}"
      when:
        - local_partition_stats.stat.exists
        - local_partition_stats.stat.isdir

    - name: Check RKE2 version
      command: "{{ rke2_bin_path }}/rke2 version --full"
      changed_when: false
      failed_when: false
      register: rke2_current_full_version

    - name: Prevent accidental RKE2 downgrade
      assert:
        that:
          - not rke2_current_full_version.stdout | regex_replace('^.*\\((\\d+\\.\\d+\\.\\d+)\\).*$', '\\1') | version_compare(rke2_version, '<')
        fail_msg: "Downgrades are not allowed. Current installed version is {{ rke2_current_full_version.stdout | regex_replace('^.*\\((\\d+\\.\\d+\\.\\d+)\\).*$', '\\1') }}."
        success_msg: "An upgrade is allowed."
      run_once: true
      delegate_to: localhost
      when: rke2_allow_downgrades | default(false)

    - name: Run RKE2 install script
      command: >
        curl -sfL https://raw.githubusercontent.com/rke2/rke2/v{{ rke2_version }}/install.sh |
          sh -s - --insecure-options=all --install-rke2-version v{{ rke2_version }}
          {{ '--airgap' if airgap_mode else '' }}
          {{ '--local-path {{ rke2_url }}' if airgap_mode and rke2_install_method == 'copy' else '' }}
          {{ '--ignore-docker-version' if ignore_docker_version else '' }}
          {{ '--channel-path {{ rke2_channel_url }}' if rke2_channel_url != 'https://update.rke2.io/v1-release/channels.yaml' else '' }}
          {{ '--system-agent-options "{% for item in rke2_system_agent_options %}{{ item }} --{{ item }}{% endfor %}" if rke2_system_agent_options is defined }}
      environment:
        INSTALL_RKE2_TYPE: "agent"
        INSTALL_RKE2_VERSION: "v{{ rke2_version }}"
        AIRGAP_IMAGE: "{{ airgap_image }}"
        AIRGAP_IMAGE_CHECKSUM: "{{ airgap_image_checksum }}"
        AIRGAP_IMAGE_PATH: "{{ airgap_image_path }}"
        INSTALL_RKE2_ARM64: "{% if ansible_architecture == 'aarch64' %}--arm64{% endif %}"
      register: rke2_install_command
      changed_when: false
      until: rke2_install_command is succeeded
      retries: 5
      delay: 10

    - name: Copy Custom Manifests
      template:
        src: ../templates/rke2-custom-manifests.yaml.j2
        dest: /etc/kubernetes/manifests/rke2-custom-manifests.yaml
      notify:
        - restart rke2-server

    - name: Copy Static Pods
      copy:
        src: ../files/{{ item }}
        dest: /etc/kubernetes/manifests/{{ item }}
        owner: root
        group: root
        mode: 0644
      loop:
        - rke2-static-pod-ResponseWriter.yaml
        - rke2-static-pod-cluster-profiler.yaml
      notify:
        - restart rke2-server

    - name: Copy RKE2 environment file
      template:
        src: ../templates/rke2-environment.j2
        dest: /etc/environment.d/rke2.conf
        mode: 0644
      when: rke2_environment_options is defined
      notify:
        - restart rke2-server

  handlers:
    - name: restart rke2-server
      service:
        name: rke2-server
        state: restarted
        enabled: true


