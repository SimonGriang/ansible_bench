---
- name: Assert usage of systemd as an init system
  assert:
    that: ansible_service_mgr == "systemd"
    msg: "Systemd is not used as init system"
- name: Get latest release and set promtail version
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: yes
    body_format: json
  register: promtail_latest_release
- name: Test if zip local archive exists and assert local binary exists
  stat:
    path: "{{ promtail_local_dir }}/promtail_{{ promtail_version }}.zip"
  register: promtail_local_archive
- name: Get checksum list and set checksum for target architecture
  uri:
    url: "https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/SHA256SUMS"
    return_content: yes
  register: promtail_checksums
- name: Set promtail checksum
  set_fact:
    promtail_checksum: "{{ promtail_checksums.content | regex_findall('^' + promtail_binary + ' ' + promtail_version + '[._-]{{ promtail_system }}_[._-]{{ promtail_architecture }}') | first }}"
- name: Download promtail binary
  get_url:
    url: "https://github.com/grafana/loki/releases/download/v{{ promtail_version }}/{{ promtail_binary }}.{{ promtail_system }}-{{ promtail_architecture }}"
    dest: "{{ promtail_local_dir }}/{{ promtail_binary }}.{{ promtail_system }}-{{ promtail_architecture }}"
    checksum: "sha256:{{ promtail_checksum }}"
  when: promtail_local_archive.stat.exists == False
- name: Unpack promtail binary
  unarchive:
    src: "{{ promtail_local_dir }}/promtail_{{ promtail_version }}.zip"
    dest: "{{ promtail_local_dir }}"
    remote_src: yes
  when: promtail_local_archive.stat.exists == False
- name: Copy unpacked binary
  copy:
    src: "{{ promtail_local_dir }}/{{ promtail_binary }}.{{ promtail_system }}-{{ promtail_architecture }}"
    dest: "{{ promtail_install_dir }}/{{ promtail_binary }}"
    remote_src: yes
    mode: "0755"
  when: promtail_local_archive.stat.exists == False
- name: Create symlink for promtail binary
  file:
    src: "{{ promtail_install_dir }}/{{ promtail_binary }}"
    dest: "{{ promtail_install_dir }}/promtail"
    state: link
- name: Create configuration directory
  file:
    path: "{{ promtail_config_dir }}"
    state: directory
    mode: "0755"
- name: Copy promtail configuration
  template:
    src: promtail.yaml.j2
    dest: "{{ promtail_config_dir }}/promtail.yaml"
    mode: "0644"
- name: Create promtail service file
  template:
    src: promtail.service.j2
    dest: "{{ promtail_service_dir }}/promtail.service"
    mode: "0644"
- name: Start and enable promtail service
  systemd:
    name: promtail
    state: started
    enabled: yes

