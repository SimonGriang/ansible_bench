content='---\n- name: "Remove old Docker versions."\n  yum:\n    name: "{{ docker_obsolete_packages }}"\n    state: absent\n\n- name: "Add Docker GPG key."\n  rpm_key:\n    key: "{{ docker_yum_gpg_key }}"\n    state: present\n  when: docker_add_repo\n\n- name: "Add Docker repository."\n  copy:\n    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    content: "{{ docker_yum_repo_content }}"\n    owner: root\n    group: root\n    mode: 0644\n  when: docker_add_repo\n\n- name: "Configure Docker Nightly repo."\n  ini_file:\n    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    section: "docker-ce-nightly"\n    option: enabled\n    value: "{{ docker_yum_repo_enable_nightly }}"\n    mode: 0644\n    no_extra_spaces: true\n    state: "{{ \'present\' if docker_yum_repo_enable_nightly else \'absent\' }}"\n  when: docker_add_repo\n\n- name: "Configure Docker Test repo."\n  ini_file:\n    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    section: "docker-ce-test"\n    option: enabled\n    value: "{{ docker_yum_repo_enable_test }}"\n    mode: 0644\n    no_extra_spaces: true\n    state: "{{ \'present\' if docker_yum_repo_enable_test else \'absent\' }}"\n  when: docker_add_repo\n\n- name: "Configure containerd on RHEL 8."\n  yum:\n    name: "{{ item }}"\n    state: present\n  loop:\n    - runc\n    - container-selinux\n    - containerd.io\n  when: ansible_facts.distribution_major_version == "8"' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-05T07:10:06.432748864Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10065712225, 'load_duration': 38305507, 'prompt_eval_count': 606, 'prompt_eval_duration': 529927515, 'eval_count': 429, 'eval_duration': 9496156471, 'model_name': 'granite-code:20b'} id='run--eede41e4-a626-4116-80da-67b038b9b8fd-0' usage_metadata={'input_tokens': 606, 'output_tokens': 429, 'total_tokens': 1035}
