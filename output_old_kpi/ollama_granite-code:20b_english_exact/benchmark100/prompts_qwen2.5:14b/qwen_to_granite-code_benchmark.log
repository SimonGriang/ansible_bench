- name: Task 1
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2
  package:
    name: nginx
    state: present

- name: Task 3
  copy:
    src: templates/nginx.conf
    dest: /etc/nginx/nginx.conf
    mode: 0644
    owner: root
    group: root
  notify: restart nginx

- name: Task 4
  file:
    path: /etc/nginx/conf.d
    state: directory
    mode: 0755
    owner: root
    group: root

- name: Task 5
  copy:
    src: templates/default.conf
    dest: /etc/nginx/conf.d/default.conf
    mode: 0644
    owner: root
    group: root
  notify: restart nginx

- name: Task 6
  service:
    name: nginx
    state: started
    enabled: true


