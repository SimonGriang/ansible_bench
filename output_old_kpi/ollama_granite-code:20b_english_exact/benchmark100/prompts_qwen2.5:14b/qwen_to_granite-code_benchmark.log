---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml
- name: Install git
  ansible.builtin.package:
    name: "{{ git_packages }}"
    state: present
- name: See if the specified user exists
  ansible.builtin.getent:
    database: passwd
    key: "{{ git_user }}"
- name: Create directory for git configuration
  ansible.builtin.file:
    path: "~{{ git_user }}/{{ git_config_dir }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: git_config_dir is defined and git_user_exists is defined and git_user_exists.stdout == "1"
- name: Place git configuration
  ansible.builtin.copy:
    src: "{{ git_config_src }}"
    dest: "~{{ git_user }}/{{ git_config_dir }}/{{ git_config_file }}"
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: git_config_src is defined and git_config_dir is defined and git_config_file is defined and git_user_exists is defined and git_user_exists.stdout == "1"
- name: Create repository_destination
  ansible.builtin.file:
    path: "{{ git_repository_destination }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: git_repository_destination is defined and git_user_exists is defined and git_user_exists.stdout == "1"
- name: Clone all roles
  ansible.builtin.git:
    repo: "{{ item.repo }}"
    dest: "{{ git_repository_destination }}/{{ item.dest }}"
    version: "{{ item.version }}"
    recursive: true
    force: true
    become_user: "{{ git_user }}"
  loop: "{{ git_repositories }}"
  when: git_repositories is defined and git_repository_destination is defined and git_user_exists is defined and git_user_exists.stdout == "1"


