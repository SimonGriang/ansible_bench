Task 2: Install apache httpd
Description Task 2: Install the Apache HTTPD server from the package manager using the variable httpd_packages.

Task 3: Configure selinux
Description Task 3: Modify SELinux settings if SELinux is enabled. This block will modify SELinux booleans and allow connections to custom ports as defined in the variables.

Task 4: Configure httpd
Description Task 4: Template the main httpd configuration file using src and dest variables, and notify handlers to test and restart the service.

Task 5: Activate httpd module | Debian
Description Task 5: Activate Apache modules using a2enmod command on Debian-based systems, notify handlers to test and restart the service.

Task 6: Import ssl.yml
Description Task 6: Import ssl.yml tasks file if HTTPS SSL is enabled.

Task 7: Import locations.yml
Description Task 7: Import locations.yml tasks file if there are defined locations for the Apache server.

Task 8: Import vhosts.yml
Description Task 8: Import vhosts.yml tasks file if there are defined virtual hosts for the Apache server.

Task 9: Configure ports
Description Task 9: Template the ports configuration file and notify handlers to test and restart the service if the OS is Debian or Suse.

Task 10: Import directories.yml
Description Task 10: Import directories.yml tasks file if there are defined directories for the Apache server.

Task 11: Flush handlers
Description Task 11: Flush all handlers to ensure they are executed after the tasks are completed.

Task 12: Removing default html
Description Task 12: Remove the default index.html file if the variable httpd_remove_example is true.

Task 13: Start and enable httpd
Description Task 13: Start and enable the Apache service using the variable httpd_service.


- Last generated (faulty) playbook: 
---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present
  notify: Test and restart apache

- block:
  - name: Set SELinux booleans
    seboolean:
      name: "{{ item.name }}"
      state: "{{ item.state }}"
      persistent: yes
    with_items: "{{ setype_boolean }}"

  - name: Allow httpd to connect to custom ports
    seport:
      ports: "{{ item }}"
      proto: tcp
      setype: httpd_port_t
      state: present
    with_items: "{{ httpd_ports_list }}"
  when: ansible_selinux.status == "enabled"

- name: Template main httpd configuration file
  template:
    src: "{{ httpd_conf_src }}"
    dest: "{{ httpd_conf_dest }}"
    mode: "{{ httpd_conf_mode }}"
    owner: "{{ httpd_conf_owner }}"
    group: "{{ httpd_conf_group }}"
  notify: Test and restart apache

- name: Activate Apache modules
  command: "a2enmod {{ item }}"
  notify: Test and restart apache
  with_items: "{{ httpd_modules }}"
  when: ansible_os_family == "Debian"

- import_tasks: ssl.yml
  when: https_ssl_enabled

- import_tasks: locations.yml
  when: httpd_locations is defined

- import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- block:
  - name: Template ports configuration file
    template:
      src: ports.conf.j2
      dest: /etc/apache2/ports.conf
      mode: 0644
      owner: root
      group: root
    notify: Test and restart apache

  - name: Restart Apache
    service:
      name: "{{ httpd_service }}"
      state: restarted
    when: ansible_os_family in ["Debian", "Suse"]

  - name: Restart Apache
    service:
      name: httpd
      state: restarted
    when: ansible_os_family == "RedHat"
  when: ansible_os_family in ["Debian", "Suse", "RedHat"]

- import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


