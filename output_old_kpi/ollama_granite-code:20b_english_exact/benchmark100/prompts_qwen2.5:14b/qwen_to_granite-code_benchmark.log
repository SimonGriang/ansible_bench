---
- import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/cron.conf
    regexp: '^#?SHELL='
    line: "SHELL={{ cron_shell }}"
    state: present
  notify: restart cron

- name: Configure path
  lineinfile:
    path: /etc/cron.conf
    regexp: '^#?PATH='
    line: "PATH={{ cron_path }}"
    state: present
  notify: restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/cron.conf
    regexp: '^#?MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    state: present
  notify: restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
