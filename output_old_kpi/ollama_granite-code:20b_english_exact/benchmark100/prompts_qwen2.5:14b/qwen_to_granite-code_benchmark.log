    that:
      - "item is defined"
  loop:
    - bootstrap_host
    - bootstrap_port
    - bootstrap_hostname
    - bootstrap_install_raw
    - bootstrap_install
    - bootstrap_wait_for_host

- name: wait for host (when configured)
  wait_for:
    host: "{{ bootstrap_host }}"
    port: "{{ bootstrap_port }}"
    connect_timeout: 1
    state: started
    timeout: 60
    msg: " waits for host to become available"
  when: bootstrap_wait_for_host

- name: prepare system
  block:
    - name: establish connection to host
      delegate_to: localhost
      connection: local
      become: no
      uri:
        url: "{{ bootstrap_protocol }}://{{ bootstrap_host }}:{{ bootstrap_port }}"
        status_code: 200
        follow_redirects: all
        body_format: raw
      register: bootstrap_connection
      until: bootstrap_connection.status == 200
      retries: "{{ bootstrap_connection_retries }}"
      delay: "{{ bootstrap_connection_delay }}"
      changed_when: false
      check_mode: no

    - name: gather facts
      delegate_to: localhost
      connection: local
      setup:
        gather_subset: all
      when: bootstrap_connection.status == 200
  rescue:
    - debug:
        msg: "Cannot connect to host {{ bootstrap_host }}. Make sure the host is up and accessible."

- name: include tasks to gather bootstrap facts (raw)
  include_tasks: _gather_facts_raw.yml

- name: Install bootstrap packages (raw).
  raw: "{{ bootstrap_install_raw }}"
  when: bootstrap_install_raw is defined

- name: ensure system is prepared by issuing ansible modules.
  block:
    - name: gather ansible facts
      setup:
        gather_subset: all

    - name: install bootstrap packages
      ansible.builtin.package:
        name: "{{ bootstrap_install }}"
        state: present
      when: bootstrap_install is defined
  when: bootstrap_install is defined


