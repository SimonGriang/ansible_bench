---
- name: Check if python is installed
  ansible.builtin.command: python --version
  register: python_check
  ignore_errors: true

- name: Check if python3 is installed
  ansible.builtin.command: python3 --version
  register: python3_check
  ignore_errors: true

- name: Debug Python executable path
  ansible.builtin.debug:
    msg: "Python executable path {{ python_check.executable }}"
  when: python_check.executable is defined

- name: Debug Python3 executable path
  ansible.builtin.debug:
    msg: "Python3 executable path {{ python3_check.executable }}"
  when: python3_check.executable is defined

- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install requirements
  ansible.builtin.dnf:
    name: "{{ openssl_requirements }}"
    state: present
  when: ansible_pkg_mgr == "dnf"

- name: Install pip packages
  ansible.builtin.pip:
    name: "{{ openssl_pip_packages }}"

- name: Create key directory
  ansible.builtin.file:
    path: "{{ openssl_key_dir }}"
    state: directory
    mode: "{{ openssl_key_dir_mode }}"
    owner: "{{ openssl_key_dir_owner }}"
    group: "{{ openssl_key_dir_group }}"

- name: Create csr directory
  ansible.builtin.file:
    path: "{{ openssl_csr_dir }}"
    state: directory
    mode: "{{ openssl_csr_dir_mode }}"
    owner: "{{ openssl_csr_dir_owner }}"
    group: "{{ openssl_csr_dir_group }}"

- name: Create crt directory
  ansible.builtin.file:
    path: "{{ openssl_crt_dir }}"
    state: directory
    mode: "{{ openssl_crt_dir_mode }}"
    owner: "{{ openssl_crt_dir_owner }}"
    group: "{{ openssl_crt_dir_group }}"

- name: Include create.yml
  ansible.builtin.include_tasks: create.yml
  loop: "{{ openssl_items }}"
  loop_control:
    loop_var: openssl_item


