---
- name: Remove obsolete Docker versions
  yum:
    name: docker
    state: absent

- name: Add Docker GPG key
  apt_key:
    url: https://download.docker.com/linux/ubuntu/gpg
    state: present

- name: Add Docker repository
  apt_repository:
    repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu xenial stable
    state: present

- name: Enable Docker nightly repository
  apt_repository:
    repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu xenial nightly
    state: present
  when: docker_nightly_enabled

- name: Enable Docker test repository
  apt_repository:
    repo: deb [arch=amd64] https://download.docker.com/linux/ubuntu xenial test
    state: present
  when: docker_test_enabled

- name: Configure containerd on RHEL 8
  yum:
    name: "{{ item }}"
    state: present
  when: ansible_distribution == "RedHat" and ansible_distribution_major_version == "8"
  with_items:
    - container-selinux
    - containerd.io




