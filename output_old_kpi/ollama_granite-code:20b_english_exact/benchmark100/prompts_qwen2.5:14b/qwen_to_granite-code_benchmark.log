---
- name: Set package state based on how Ansible is installed
  set_fact:
    ansible_package_state: "present"
  when: ansible_pkg_mgr == "apt" or ansible_pkg_mgr == "zypper" or ansible_pkg_mgr == "yum" or ansible_pkg_mgr == "dnf" or ansible_pkg_mgr == "pkgng" or ansible_pkg_mgr == " Homebrew"

- name: Include setup-RedHat.yml tasks file for RedHat systems
  include_tasks: setup-RedHat.yml
  when: ansible_pkg_mgr == "yum" or ansible_pkg_mgr == "dnf"

- name: Include setup-Fedora.yml tasks file for Fedora systems
  include_tasks: setup-Fedora.yml
  when: ansible_distribution == "Fedora"

- name: Include setup-Ubuntu.yml tasks file for Ubuntu systems
  include_tasks: setup-Ubuntu.yml
  when: ansible_distribution == "Ubuntu"

- name: Include setup-Debian.yml tasks file for Debian systems
  include_tasks: setup-Debian.yml
  when: ansible_pkg_mgr == "apt"

- name: Include setup-pip.yml tasks file for systems with Ansible installed via pip
  include_tasks: setup-pip.yml
  when: ansible_pip_version.stdout == ""

