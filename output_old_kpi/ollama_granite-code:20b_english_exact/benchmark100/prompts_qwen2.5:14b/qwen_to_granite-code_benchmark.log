---

- name: "hardening | Disable swap"
  command: swapoff -a
  when: vault_hardening_disable_swap
  changed_when: false

- name: "hardening | Disable swap now"
  command: swapoff -a
  when: ansible_swaptotal_mb > 0 and vault_hardening_disable_swap
  changed_when: false

- name: "hardening | Disable swap permanently"
  mount:
    name: swap
    fstype: swap
    state: absent
  when: vault_hardening_disable_swap

- name: "hardening | Disable core dumps"
  pam_ limits:
    domain: "{{ item }}"
    limit_type: core
    limit_item: hard
    value: 0
  loop:
    - "core"
    - "root"
    - "*`
  when: vault_hardening_disable_core_dumps

- name: "hardening | Disable Shell Command History"
  copy:
    dest: /etc/profile.d/vault-hardening-disable-shell-history.sh
    content: |
      export HISTCONTROL=ignoreboth
      export HISTFILESIZE=0
  when: vault_hardening_disable_shell_command_history

- name: "hardening | Configure SELinux / AppArmor"
  tags:
    - skip_ansible_lint
  block:
    - name: "hardening | Enable SELinux"
      tags:
        - skip_ansible_lint
      command: selinuxenabled
      register: selinux_enabled
      changed_when: selinux_enabled.stdout == "true"

    - name: "hardening | Install selinux-policy"
      tags:
        - skip_ansible_lint
      package:
        name: selinux-policy
        state: present
      when: selinux_enabled.stdout == "true" and ansible_distribution != 'Fedora'

    - name: "hardening | Install selinux-policy"
      tags:
        - skip_ansible_lint
      package:
        name: selinux-policy
        state: present
      when: selinux_enabled.stdout == "true" and ansible_distribution == 'Fedora' and ansible_distribution_major_version < '33'

    - name: "hardening | Install selinux-policy"
      tags:
        - skip_ansible_lint
      package:
        name: selinux-policy-targeted
        state: present
      when: selinux_enabled.stdout == "true" and ansible_distribution == 'Fedora' and ansible_distribution_major_version >= '33'

    - name: "hardening | Set SELinux policy"
      tags:
        - skip_ansible_lint
      command: setsebool -P httpd_can_network_connect 1
      changed_when: true
      when: selinux_enabled.stdout == "true" and ansible_distribution != 'Fedora'

    - name: "hardening | Set SELinux policy"
      tags:
        - skip_ansible_lint
