        password: "{{ item.password }}"
        state: "present"
        host: "{{ item.host | default('localhost') }}"
        priv: "{{ item.priv | default('*.*:ALL,GRANT') }}"
      loop: "{{ mysql_users }}"
      become: true
      become_user: "root"
    - name: "Flush handlers again"
      meta: "flush_handlers"


