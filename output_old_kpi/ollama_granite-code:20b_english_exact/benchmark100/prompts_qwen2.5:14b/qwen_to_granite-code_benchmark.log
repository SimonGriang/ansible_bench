---
- name: promtail-install
  become: true
  block:
    - name: Ensure unzip package is available
      ansible.builtin.apt:
        name: unzip
        state: present
        update_cache: true
      when: ansible_os_family == "Debian"
    - name: Ensure unzip package is available
      ansible.builtin.yum:
        name: unzip
        state: present
      when: ansible_os_family == "RedHat"
    - name: Create system group for promtail
      ansible.builtin.group:
        name: promtail
        state: present
    - name: Create promtail user
      ansible.builtin.user:
        name: promtail
        group: promtail
        state: present
    - name: Ensure /usr/local/bin directory exists
      ansible.builtin.file:
        path: /usr/local/bin
        state: directory
        owner: promtail
        group: promtail
        mode: "0755"
    - name: Create config directories
      ansible.builtin.file:
        path: "{{ item }}"
        state: directory
        owner: promtail
        group: promtail
        mode: "0755"
      loop:
        - /etc/promtail
        - /etc/promtail/positions
        - /etc/promtail/config.d
        - /etc/promtail/rules
        - /etc/promtail/scrape_configs
    - name: Create application directories
      ansible.builtin.file:
        path: "{{ item }}"
        state: directory
        owner: promtail
        group: promtail
        mode: "0755"
      loop:
        - /opt/promtail
        - /var/lib/promtail
    - name: Check if promtail binary exists
      ansible.builtin.stat:
        path: /opt/promtail/promtail
      register: promtail_binary_exists
    - name: Download promtail binaries
      ansible.builtin.get_url:
        url: https://github.com/grafana/promtail/releases/download/v2.3.0/promtail-linux-amd64.zip
        dest: /opt/promtail/promtail.zip
        mode: "0644"
        owner: promtail
        group: promtail
        checksum: sha256:540fa331276646b3956129a6b98c760521845e7525241225152558453e05b457
      when: not promtail_binary_exists.stat.exists and promtail_distribution == "propagate"
    - name: Propagate locally distributed promtail archive
      ansible.builtin.copy:
        src: /tmp/promtail.zip
        dest: /opt/promtail/promtail.zip
        mode: "0644"
        owner: promtail
        group: promtail
      when: not promtail_binary_exists.stat.exists and promtail_distribution == "local"
    - name: Download promtail binaries to controller node
      ansible.builtin.copy:
        src: /tmp/promtail.zip
        dest: /opt/promtail/promtail.zip
        mode: "0644"
        owner: promtail
        group: promtail
      when: not promtail_binary_exists.stat.exists and promtail_distribution == "controller"
    - name: Propagate promtail binaries
      ansible.builtin.unarchive:
        src: /opt/promtail/promtail.zip
        dest: /opt/promtail
        remote_src: true
        owner: promtail
        group: promtail
      when: promtail_distribution == "propagate"
    - name: Unpack promtail binaries
      ansible.builtin.unarchive:
        src: /opt/promtail/promtail.zip
        dest: /opt/promtail
        remote_src: true
        owner: promtail
        group: promtail
      when: promtail_distribution == "controller"
    - name: Create symlink to latest version
      ansible.builtin.file:
        src: /opt/promtail/promtail
        dest: /usr/local/bin/promtail
        owner: promtail
        group: promtail
        state: link
      notify: restart promtail
    - name: Write configuration
      ansible.builtin.template:
        src: promtail.yml.j2
        dest: /etc/promtail/promtail.yml
        owner: promtail
        group: promtail
        mode: "0644"
      notify: restart promtail
    - name: Create systemd service unit
      ansible.builtin.template:
        src: promtail.service.j2
        dest: /etc/systemd/system/promtail.service
        owner: root
        group: root
        mode: "0644"
      notify: restart promtail
  handlers:
    - name: restart promtail
      ansible.builtin.service:
        name: promtail
        state: restarted
