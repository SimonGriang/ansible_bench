- name: Task 3
  include_tasks: "{{ vault_installation_method }}.yml"

- name: Task 4
  lineinfile:
    path: /etc/vault.d/vault.env
    regexp: "^{{ item.key }}="
    line: "{{ item.key }}={{ item.value }}"
  notify: Restart vault
  with_items: "{{ vault_environment_settings }}"

- name: Task 5
  import_tasks: hardening.yml

- name: Task 6
  service:
    name: vault
    state: started
    enabled: true
  when: vault_type == "oss"

- name: Task 7
  service:
    name: vault
    enabled: true
  when: vault_type != "oss"


