      path: "{{ rke2_artifacts_dir }}"
      state: directory
      mode: 0700
    when: rke2_airgap_mode and rke2_airgap_implementation != "exists"
  - name: Download RKE2 checksum and artifacts
    block:
    - name: Download checksum file
      get_url:
        url: https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/sha256sum-amd64.txt
        dest: "{{ rke2_bin_dir }}/sha256sum-amd64.txt"
    - name: Download artifacts
      get_url:
        url: "{{ item.url }}"
        dest: "{{ rke2_bin_dir }}/{{ item.dest }}"
        checksum: "sha256:{{ item.checksum }}"
      with_items:
        - url: https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/rke2-amd64.tar.gz
          dest: rke2.tar.gz
          checksum: "{{ rke2_checksum }}"
        - url: https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/rke2-linux-amd64.tar.gz
          dest: rke2-linux-amd64.tar.gz
          checksum: "{{ rke2_linux_checksum }}"
        - url: https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/rke2-linux-amd64-install.sh
          dest: install.sh
          checksum: "{{ rke2_install_checksum }}"
    - name: Download install script
      get_url:
        url: https://get.rke2.io
        dest: "{{ rke2_bin_dir }}/install.sh"
        mode: 0700
    when: rke2_airgap_mode and rke2_airgap_implementation == "download"
  - name: Rescue for failed download
    block:
    - name: Create rescue folder
      file:
        path: "{{ rke2_bin_dir }}"
        state: directory
    - name: Download rescue artifacts
      get_url:
        url: "{{ item.url }}"
        dest: "{{ rke2_bin_dir }}/{{ item.dest }}"
        mode: 0600
      with_items:
        - url: https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/rke2-amd64.tar.gz
          dest: rke2.tar.gz
        - url: https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/rke2-linux-amd64.tar.gz
          dest: rke2-linux-amd64.tar.gz
        - url: https://github.com/rancher/rke2/releases/download/v{{ rke2_version }}/rke2-linux-amd64-install.sh
          dest: install.sh
    - name: Copy rescue artifacts
      copy:
        src: "{{ item.src }}"
        dest: "{{ rke2_bin_dir }}/{{ item.dest }}"
        mode: 0600
      with_items:
        - src: "{{ rke2_bin_dir }}/rke2.tar.gz"
          dest: rke2.tar.gz
        - src: "{{ rke2_bin_dir }}/rke2-linux-amd64.tar.gz"
          dest: rke2-linux-amd64.tar.gz
        - src: "{{ rke2_bin_dir }}/install.sh"
          dest: install.sh
    when: rke2_airgap_mode and rke2_airgap_implementation == "download" and not rke2_airgap_rescue
  - name: Copy local RKE2 artifacts
    copy:
      src: "{{ item.src }}"
      dest: "{{ rke2_artifacts_dir }}/{{ item.dest }}"
      mode: 0640
      force: yes
    with_items: "{{ rke2_airgap_copy_list }}"
    when: rke2_airgap_mode and rke2_airgap_implementation == "copy"
  - name: Airgap mode - additional images tarballs
    block:
    - name: Create folder for additional images tarballs
      file:
        path: "{{ rke2_tarball_images_dir }}"
        state: directory
      when: rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation != "exists"
    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_tarball_images_dir }}/"
        mode: 0640
        force: yes
      with_items: "{{ rke2_airgap_copy_additional_tarballs }}"
      when: rke2_airgap_copy_additional_tarballs | length > 0 and rke2_airgap_implementation != "exists"
    when: rke2_airgap_mode
  - name: Ensure artifacts exist and have acceptable permissions
    block:
    - name: Check artifacts exist
      stat:
        path: "{{ item }}"
      register: rke2_stat_result
      with_items:
        - "{{ rke2_bin_dir }}/rke2.tar.gz"
        - "{{ rke2_bin_dir }}/rke2-linux-amd64.tar.gz"
        - "{{ rke2_bin_dir }}/install.sh"
    - name: Modify artifact permissions
      file:
        path: "{{ item.item }}"
        mode: 0640
      when: item.stat.exists and item.stat.mode|string != '0640'
      with_items: "{{ rke2_stat_result.results }}"
    - name: Fail if permissions are too permissive
      fail:
        msg: "One or more RKE2 artifacts had permissions that were too permissive and were modified to 0640"
      when: rke2_stat_result.changed
    when: rke2_airgap_mode and rke2_airgap_implementation == "exists"
  - name: Populate service facts
    service_facts:
  - name: Get stats of the FS object
    stat:
      path: /usr/local
    register: fs_object_stats
  - name: Check if /usr/local is on a separate partition
    command: grep -qs '/usr/local ' /proc/mounts
    register: grep_result
    changed_when: false
    failed_when: grep_result.rc not in [0, 1]
    check_mode: false
    when: fs_object_stats.stat.exists
  - name: Set RKE2 bin path
    set_fact:
      rke2_bin_path: "{{ '/usr/local/bin' if grep_result.rc == 0 and (ansible_os_family == 'Debian' or ansible_os_family == 'RedHat') else '/usr/bin' }}"
  - name: Check RKE2 version
    command: "{{ rke2_bin_path }}/rke2 version"
    register: installed_rke2_version
    changed_when: false
    failed_when: installed_rke2_version.rc not in [0, 1]
    check_mode: false
  - name: Set RKE2 versions
    when: not ansible_check_mode
    block:
    - name: Set installed RKE2 version fact
      set_fact:
        installed_rke2_version: "{{ installed_rke2_version.stdout }}"
      when: installed_rke2_version.rc == 0
    - name: Set running RKE2 version fact
      set_fact:
        rke2_service_version: "{{ rke2_service.version }}"
      when: rke2_service is defined
    - name: Set RKE2 versions fact
      set_fact:
        rke2_versions:
          installed: "{{ installed_rke2_version | default('unknown') }}"
          running: "{{ rke2_service_version | default('unknown') }}"
  - name: Prevent accidental RKE2 downgrade
    when: not ansible_check_mode and installed_rke2_version.rc == 0
    block:
    - name: Check running RKE2 version is compatible with installed version
      assert:
        that: "rke2_version | version_compare(installed_rke2_version.stdout, operator='>=')"
        msg: "Running RKE2 version is older than the installed version. Downgrades are not supported. To downgrade RKE2, first uninstall RKE2 and then install the older version."
      when: rke2_service is defined and rke2_service.version is version_compare(installed_rke2_version.stdout, operator='>')
  - name: Run RKE2 install script
    become: true
    command: "{{ rke2_bin_path }}/install.sh --version {{ rke2_version }} {{ 'install-method=airgap' if rke2_airgap_mode else '' }}"
    register: install_rke2
    changed_when: false
    failed_when: install_rke2.rc not in [0, 1]
    when: not ansible_check_mode and rke2_version != installed_rke2_version.stdout and not ansible_check_mode
  - name: Copy Custom Manifests
    copy:
      src: "{{ item }}"
      dest: "{{ rke2_data_path }}/server/manifests/"
      force: yes
    with_fileglob:
      - ../files/manifests/*.yaml
    when: rke2_custom_manifests is defined
  - name: Copy Static Pods
    copy:
      src: "{{ item }}"
      dest: "{{ rke2_agent_pod_manifests_path }}/"
      force: yes
    with_fileglob:
      - ../files/static-pods/*.yaml
    when: rke2_static_pods is defined
  - name: Copy RKE2 environment file
    copy:
      dest: /etc/sysconfig/rke2-env
      content: |
        {% for key, value in rke2_environment_variables.items() %}
        export {{ key }}="{{ value }}"
        {% endfor %}
      mode: 0644
    when: rke2_environment_variables is defined and rke2_environment_variables | length > 0


