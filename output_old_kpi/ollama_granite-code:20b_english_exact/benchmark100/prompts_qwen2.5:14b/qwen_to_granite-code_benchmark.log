---
- name: "Check if Helm binary exists"
  stat:
    path: /opt/bin/helm
  register: helm_bin

- name: "Check Helm version"
  command: /opt/bin/helm version --client
  register: helm_version
  when: helm_bin.stat.exists

- name: "Download helm"
  get_url:
    url: https://storage.googleapis.com/kubernetes-helm/helm-v2.12.3-linux-amd64.tar.gz
    dest: /tmp/helm-v2.12.3-linux-amd64.tar.gz
  when: not helm_bin.stat.exists or helm_version.stdout is version('2.12.0','<')

- name: "Copy helm binary into place"
  unarchive:
    src: /tmp/helm-v2.12.3-linux-amd64.tar.gz
    dest: /tmp
    remote_src: true
  when: not helm_bin.stat.exists or helm_version.stdout is version('2.12.0','<')

- name: "Copy helm binary into place"
  copy:
    src: /tmp/linux-amd64/helm
    dest: /opt/bin/helm
    remote_src: true
    mode: 0755
  when: not helm_bin.stat.exists or helm_version.stdout is version('2.12.0','<')


