---
- name: Check current docker-compose version
  command: docker-compose --version
  register: current_docker_compose_version

- name: Set fact for current Docker Compose version
  set_fact:
    current_docker_compose_version: "{{ current_docker_compose_version.stdout | regex_replace('^docker-compose version (.*), build .*$', '\\1') }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: current_docker_compose_version.stdout != docker_compose_version

- name: Install Docker Compose (if configured)
  get_url:
    url: https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-Linux-x86_64
    dest: /usr/local/bin/docker-compose
    mode: 0755
  when: current_docker_compose_version.stdout != docker_compose_version or docker_compose_version not in current_docker_compose_version.stdout


