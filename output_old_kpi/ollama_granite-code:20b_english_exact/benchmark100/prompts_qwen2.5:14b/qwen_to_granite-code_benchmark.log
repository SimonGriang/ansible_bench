- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: stopped
    enabled: false
  when: rke2_type == "server" and inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Wait for the first server be ready - no CNI
  command: rke2 status --name {{ inventory_hostname }}
  register: node_status
  until: node_status.stdout.find("Ready") != -1 and node_status.stdout.find("CNI") == -1
  retries: 60
  delay: 10
  when: rke2_type == "server" and inventory_hostname == groups[rke2_cluster_group_name][0] and not rke2_disable_cni

- name: Wait for the first server be ready - with CNI
  command: rke2 status --name {{ inventory_hostname }}
  register: node_status
  until: node_status.stdout.find("Ready") != -1 and node_status.stdout.find("CNI") != -1
  retries: 60
  delay: 10
  when: rke2_type == "server" and inventory_hostname == groups[rke2_cluster_group_name][0] and rke2_disable_cni

- name: Restore etcd
  block:
    - command: rke2-server etcd-remove-member --name {{ inventory_hostname }}
    - command: rke2-server etcd-remove-member --name {{ groups[rke2_cluster_group_name][0] }}
    - command: rke2-server etcd-snapshot --name {{ groups[rke2_cluster_group_name][0] }}
    - command: rke2-server etcd-restore --name {{ inventory_hostname }} --backup-path /var/lib/rancher/rke2/agent/etc/etcd/snapshots/rke2-backup.db
    - command: rm -rf /var/lib/rancher/rke2/agent/etc/etcd/snapshots
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: rke2_type == "server"


