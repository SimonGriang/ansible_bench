    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  command: "ssh-keygen -q -t {{ user.ssh_key_type | default('rsa') }} -N '' -f {{ user.ssh_key_file | default(omit) }} -C {{ user.comment | default(omit) }}"
  args:
    creates: "{{ user.ssh_key_file | default(omit) }}"
  no_log: "{{ user.ssh_key_passphrase is defined }}"
  become: false
  when: user.manage_ssh_key

- name: Generate public ssh key for {{ user.name }}
  command: "ssh-keygen -y -f {{ user.ssh_key_file | default(omit) }} -m {{ user.ssh_key_type | default('rsa') }}"
  args:
    creates: "{{ user.ssh_key_file | default(omit) }}.pub"
  no_log: "{{ user.ssh_key_passphrase is defined }}"
  become: false
  when: user.manage_ssh_key

- name: Convert ssh key to ppk for {{ user.name }}
  command: "puttygen {{ user.ssh_key_file | default(omit) }} -O private-openssh -o {{ user.ssh_key_file | default(omit) }}.ppk"
  args:
    creates: "{{ user.ssh_key_file | default(omit) }}.ppk"
  no_log: "{{ user.ssh_key_passphrase is defined }}"
  become: false
  when: user.manage_ssh_key and user.ssh_key_type == "rsa"

- name: Get or set the home directory for {{ user.name }}
  command: "getent passwd {{ user.name }} | cut -d: -f6"
  register: user_home
  changed_when: false
  failed_when: "user_home.rc != 0 and user_home.rc != 1"
  when: user.home is not defined

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ (user.home | default(user_home.stdout)) }}/.ssh"
    state: directory
    owner: "{{ user.name }}"
    group: "{{ user.group | default(omit) }}"
    mode: 0700
  when: user.manage_ssh_key or user.private_keys is defined

- name: Deploy authorized keys for {{ user.name }}
  copy:
    content: "{{ item }}"
    dest: "{{ (user.home | default(user_home.stdout)) }}/.ssh/authorized_keys"
    owner: "{{ user.name }}"
    group: "{{ user.group | default(omit) }}"
    mode: 0600
    backup: "{{ user.backup | default(omit) }}"
  with_items: "{{ user.authorized_keys | default([]) }}"
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for {{ user.name }}
  lineinfile:
    path: "{{ (user.home | default(user_home.stdout)) }}/.ssh/authorized_keys"
    state: absent
    regexp: "{{ item }}"
  with_items: "{{ user.unauthorized_keys | default([]) }}"
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ user.ssh_key_file | default(omit) }}"
    dest: "{{ (user.home | default(user_home.stdout)) }}/.ssh/id_rsa"
    owner: "{{ user.name }}"
    group: "{{ user.group | default(omit) }}"
    mode: 0600
