---
- name: "mysql_setup"
  hosts: "localhost"
  gather_facts: false
  tasks:
    - name: "Include assert.yml"
      import_tasks: "assert.yml"
      run_once: true
    - name: "Install mysql"
      package:
        name: "{{ mysql_packages }}"
        state: "present"
      notify:
        - "Set root password"
        - "Systemctl daemon-reexec"
    - name: "Configure mysql server"
      lineinfile:
        path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
        regexp: "{{ item.regexp }}"
        line: "{{ item.line }}"
        state: "present"
      loop: "{{ mysql_configuration_options }}"
      notify: "Restart mysql server"
    - name: "Configure mysql client"
      lineinfile:
        path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
        regexp: "^socket"
        line: "socket={{ mysql_socket }}"
        state: "present"
    - name: "Initialize mysql"
      command: "{{ mysql_initialize_command }}"
      args:
        creates: "/var/lib/mysql/mysql"
      when: ansible_os_family in [ "alpine", "archlinux" ]
    - name: "Start and enable mysql"
      service:
        name: "{{ mysql_service }}"
        state: "started"
        enabled: true
    - name: "Flush handlers"
      meta: "flush_handlers"
    - name: "Place my.cnf"
      template:
        src: "my.cnf.j2"
        dest: "/root/.my.cnf"
    - name: "Create databases"
      mysql_db:
        name: "{{ item.name }}"
        state: "present"
        encoding: "{{ item.encoding | default('utf8') }}"
        collation: "{{ item.collation | default('utf8_general_ci') }}"
      loop: "{{ mysql_databases }}"
      become: true
      become_user: "root"
    - name: "Create users"
      mysql_user:
        name: "{{ item.name }}"
        password: "{{ item.password }}"
        state: "present"
        host: "{{ item.host | default('localhost') }}"
        priv: "{{ item.priv | default('*.*:ALL,GRANT') }}"
      loop: "{{ mysql_users }}"
      become: true
      become_user: "root"
    - name: "Flush handlers again"
      meta: "flush_handlers"


