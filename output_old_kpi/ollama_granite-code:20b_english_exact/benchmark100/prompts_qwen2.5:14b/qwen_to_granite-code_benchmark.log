- import_tasks: assert.yml

- name: Install required software
  package:
    name: "{{ users_requirements }}"
    state: present
  when: users_requirements is defined

- include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    loop_var: user_group
  when: users_groups is defined

- name: Ensure /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: '#includedir /etc/sudoers.d'
    state:present
  when: users_sudo_includedir is defined

- include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    loop_var: user
  when: users is defined

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
  when: users_cron_allow is defined

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: users_cron_allow is not defined


