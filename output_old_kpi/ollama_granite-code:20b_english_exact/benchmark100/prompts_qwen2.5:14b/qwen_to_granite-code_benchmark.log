---
- import_tasks: assert.yml

- name: Install cron
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  ansible.builtin.lineinfile:
    path: /etc/cron.conf
    regexp: '^#?SHELL='
    line: "SHELL={{ cron_shell }}"
    state: present
  notify: restart cron

- name: Configure path
  ansible.builtin.lineinfile:
    path: /etc/cron.conf
    regexp: '^#?PATH='
    line: "PATH={{ cron_path }}"
    state: present
  notify: restart cron

- name: Configure mailto
  ansible.builtin.lineinfile:
    path: /etc/cron.conf
    regexp: '^#?MAILTO='
    line: "MAILTO={{ cron_mailto }}"
    state: present
  notify: restart cron

- name: Start and enable cron
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service is defined and cron_service

- name: Schedule requested cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    job: "{{ item.job }}"
    minute: "{{ item.minute | defaultomit }}"
    hour: "{{ item.hour | defaultomit }}"
    day: "{{ item.day | defaultomit }}"
    month: "{{ item.month | defaultomit }}"
    weekday: "{{ item.weekday | defaultomit }}"
    state: "{{ item.state | default('present') }}"
  loop: "{{ cron_jobs }}"
  notify: restart cron


