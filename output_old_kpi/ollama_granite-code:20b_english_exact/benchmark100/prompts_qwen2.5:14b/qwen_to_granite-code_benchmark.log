---
- name: Assert usage of systemd as an init system
  assert:
    that:
      - ansible_service_mgr == "systemd"
    fail_msg: "Systemd must be used as init system!"
    success_msg: "Systemd is used as init system."

- name: Get latest release of promtail
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: true
  register: promtail_latest_release

- set_fact:
    promtail_version: "{{ promtail_latest_release.json.tag_name }}"

- name: Test if zip local archive exists
  stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}.{{ go_arch }}.zip"
  register: binary_archive

- name: Assert local binary exists
  assert:
    that: binary_archive.stat.exists
    fail_msg: "Local binary archive does not exist!"
    success_msg: "Local binary archive exists."
  when: promtail_binary_local_dir is defined

- name: Get checksum list
  uri:
    url: https://api.github.com/repos/grafana/loki/releases/assets/{{ promtail_latest_release.json.assets[0].id }}/download
    return_content: true
  register: promtail_checksum_list

- set_fact:
    promtail_checksum: "{{ promtail_checksum_list.content | from_json | json_query( promtail_checksum_query ) }}"
  vars:
    promtail_checksum_query: "checksums[?algorithm=='sha256'].checksum | [0]"

- set_fact:
    promtail_checksum: "{{ promtail_checksum_list.content | from_json | json_query( promtail_checksum_query_ secondary ) }}"
  vars:
    promtail_checksum_query_secondary: "checksums[?algorithm=='sha256'].checksum | [?contains(@, go_arch) == `true` ] | [0]"


