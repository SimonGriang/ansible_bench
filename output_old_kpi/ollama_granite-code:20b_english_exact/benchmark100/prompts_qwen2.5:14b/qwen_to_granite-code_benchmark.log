---

- import_tasks: assert.yml

- name: Install cron
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  ansible.builtin.lineinfile:
    path: /etc/cron.allow
    regexp: '^SHELL='
    line: 'SHELL={{ cron_shell }}'
    state: present
    create: true
    mode: "0600"
  notify: Restart cron

- name: Configure path
  ansible.builtin.lineinfile:
    path: /etc/cron.allow
    regexp: '^PATH='
    line: 'PATH={{ cron_path }}'
    state: present
    create: true
    mode: "0600"
  notify: Restart cron

- name: Configure mailto
  ansible.builtin.lineinfile:
    path: /etc/cron.allow
    regexp: '^MAILTO='
    line: 'MAILTO={{ cron_mailto }}'
    state: present
    create: true
    mode: "0600"
  notify: Restart cron

- name: Start and enable cron
  ansible.builtin.service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service | length > 0

- name: Schedule requested cron jobs
  ansible.builtin.cron:
    name: "{{ item.name }}"
    job: "{{ item.command }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    state: present
  with_items: "{{ cron_jobs }}"


