---
- name: Bootstrap | Get distribution facts
  raw: cat /etc/os-release
  register: bootstrap_os_release

- name: Bootstrap | Set bootstrap distribution
  set_fact:
    bootstrap_distribution: "{{ bootstrap_os_release.stdout | from_json | regex_search('ID=(.*)') | regex_replace('ID=\\(.*\\)', '\\1') }}"

- name: Bootstrap | Set bootstrap distribution major version
  set_fact:
    bootstrap_distribution_major_version: "{{ bootstrap_os_release.stdout | from_json | regex_search('VERSION_ID=(.*)') | regex_replace('VERSION_ID=\\(.*\\)', '\\1') }}"

- name: Bootstrap | Set bootstrap os family
  set_fact:
    bootstrap_os_family: "{{ bootstrap__os_family_map[bootstrap_distribution] }}"


