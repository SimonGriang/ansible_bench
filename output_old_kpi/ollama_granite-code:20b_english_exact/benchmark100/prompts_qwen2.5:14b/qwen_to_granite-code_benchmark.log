---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Install python pip
  pip:
    name: "{{ python_pip_name }}"
    state: "{{ python_pip_state }}"
    version: "{{ python_pip_version }}"

- name: Configure pip proxy
  block:
    - name: Update pip.conf [proxy] section
      lineinfile:
        path: /etc/pip.conf
        line: "[global]"
        state: present
    - name: Add proxy to pip.conf [global] section
      lineinfile:
        path: /etc/pip.conf
        line: "proxy={{ python_pip_proxy }}"
        state: present
  when: python_pip_proxy is defined

- name: Trust hosts
  block:
    - name: Update pip.conf [global] section
      lineinfile:
        path: /etc/pip.conf
        line: "[global]"
        state: present
    - name: Add trusted hosts to pip.conf [global] section
      lineinfile:
        path: /etc/pip.conf
        line: "trusted-host={{ python_pip_trusted_host }}"
        state: present
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: latest
  when: python_pip_update and not ( ansible_distribution == "Bookworm" or ansible_distribution == "Noble" ) and not ( ansible_os_family == "Alpine" )

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    state: "{{ item.state }}"
    version: "{{ item.version }}"
  loop: "{{ python_pip_modules }}"
  when: not ( ansible_distribution == "Bookworm" or ansible_distribution == "Noble" ) and not ( ansible_os_family == "Alpine" )


