---
- import_tasks: assert.yml
- name: Install mysql
  ansible.builtin.package:
    name: "{{ mysql_packages }}"
    state: present
- name: Configure mysql server
  ansible.builtin.lineinfile:
    path: /etc/mysql/my.cnf
    line: "{{ item.line }}"
    regexp: "{{ item.regexp }}"
    state: present
  with_items: "{{ mysql_configuration_options }}"
- name: Configure mysql client
  ansible.builtin.lineinfile:
    path: /etc/mysql/my.cnf
    line: "socket=/var/run/mysqld/mysqld.sock"
    regexp: "^socket="
    state: present
- name: Initialize mysql
  ansible.builtin.command: mysql_install_db
  args:
    creates: /var/lib/mysql/mysql
- name: Start and enable mysql
  ansible.builtin.service:
    name: mysql
    state: started
    enabled: true
- name: Place my.cnf
  ansible.builtin.copy:
    src: /tmp/my.cnf
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: "0644"
- name: Create databases
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: present
  loop: "{{ mysql_databases }}"
  loop_control:
    label: "Creating database {{ item.name }}"
- name: List databases
  ansible.builtin.command: mysql -e 'SHOW DATABASES;'
  register: mysql_databases_list
- name: Import database
  community.mysql.mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.target }}"
  loop: "{{ mysql_import_databases }}"
  loop_control:
    label: "Importing database {{ item.name }}"
  when: item.name not in mysql_databases_list.stdout_lines
- name: Create users
  community.mysql.mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  loop: "{{ mysql_users }}"
  loop_control:
    label: "Creating user {{ item.name }}"
- name: Flush handlers
  ansible.builtin.meta: flush_handlers
- name: Flush handlers again
  ansible.builtin.meta: flush_handlers


