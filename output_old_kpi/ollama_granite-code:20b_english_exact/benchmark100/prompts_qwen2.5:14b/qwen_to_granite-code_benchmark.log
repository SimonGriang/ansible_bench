---
- name: Install Keepalived
  ansible.builtin.apt:
    name: keepalived
    state: present
  when: ha_mode and rke2_server_group in group_names

- name: Download and install RKE2
  ansible.builtin.unarchive:
    src: https://github.com/rancher/rke2/releases/download/{{ rke2_version }}/rke2.yml
    dest: /var/lib/rke2/agent/
    owner: root
    group: root
    mode: "0755"

- name: Perform CIS Hardening
  community.general.import_role:
    name: cis_hardening
  when: cis_profile is defined

- name: Identify Active Server
  ansible.builtin.set_fact:
    active_server: "{{ groups[rke2_server_group][0] }}"

- name: Enable IPVS kernel module
  ansible.builtin.shell: modprobe -- ip_vs
  when: kubevip_mode and ha_mode

- name: Copy Kube-VIP manifests to masternode
  ansible.builtin.copy:
    src: "{{ kubevip_manifest_url }}"
    dest: /var/lib/rke2/agent/
  when: not ha_mode

- name: Copy ingress-nginx manifests to masternode
  ansible.builtin.copy:
    src: "{{ ingress_nginx_manifest_url }}"
    dest: /var/lib/rke2/agent/
  when: ingress_nginx_config is defined

- name: Prepare very first server node in cluster
  ansible.builtin.shell: "echo '1' > /var/lib/rke2/server"
  args:
    creates: /var/lib/rke2/server

- name: Restore etcd specific tasks
  ansible.builtin.import_tasks: etcd_restore.yml
  when: etcd_restore

- name: Download kubeconfig to ansible localhost
  ansible.builtin.fetch:
    src: /etc/kubernetes/admin.conf
    dest: ./kubeconfig
    flat: true
  when: download_kubeconfig

- name: Prepare and join remaining nodes of the cluster
  ansible.builtin.shell: "echo '2' > /var/lib/rke2/server ; sleep 30 ; rke2 join --token {{ rke2_token }} {{ rke2_url }}"
  args:
    creates: /etc/kubernetes/admin.conf
  when: rke2_server_group in group_names and inventory_hostname != active_server

- name: Perform rolling restart for servers when RKE2 version changes
  ansible.builtin.shell: "sleep 30 ; rke2@$(hostname -s) reset ; sleep 5 ; rke2@$(hostname -s) export ; sleep 5 ; /bin/systemctl restart rke2-server ; sleep 15 ; /bin/systemctl stop rke2-agent ; sleep 5 ; /bin/systemctl start rke2-agent"
  when: rke2_server_group in group_names and rke2_version_check and rke2_version != rke2_current_version

- name: Perform rolling restart for agents when RKE2 version changes
  ansible.builtin.shell: "sleep 30 ; rke2@$(hostname -s) reset ; sleep 5 ; rke2@$(hostname -s) export ; sleep 5 ; /bin/systemctl stop rke2-server ; sleep 15 ; /bin/systemctl restart rke2-agent"
  when: rke2_server_group not in group_names and rke2_version_check and rke2_version != rke2_current_version

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Perform rolling restart when config files change
  ansible.builtin.shell: "sleep 30 ; rke2@$(hostname -s) reset ; sleep 5 ; rke2@$(hostname -s) export ; sleep 5 ; /bin/systemctl restart rke2-server ; sleep 5 ; /bin/systemctl restart rke2-agent ; sleep 15 ; /bin/systemctl stop rke2-server ; sleep 5 ; /bin/systemctl start rke2-agent"
  when: rke2_server_group in group_names and rke2_config_check

- name: Final steps
  ansible.builtin.debug:
    msg: "Playbook execution completed successfully"


