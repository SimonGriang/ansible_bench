---
- name: Create group
  group:
    name: "{{ vault_group }}"

- name: Create user
  user:
    name: "{{ vault_user }}"
    home: /var/empty
    shell: "{{ vault_user_shell }}"
    groups:
      - "{{ vault_group }}"

- name: Create download directory
  file:
    path: "{{ vault_download_path }}"
    owner: root
    group: root
    mode: 0755
    state: directory

- name: Download Vault binary
  unarchive:
    src: "https://releases.hashicorp.com/vault/{{ vault_version }}/vault_{{ vault_version }}_linux_amd64.zip"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    owner: root

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_stat

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0755
    state: directory
  when: vault_path_stat.stat.exists == False and vault_path != ""

- name: Create directories in vault_path
  file:
    path: "{{ vault_path }}/{{ item.path }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: 0755
    state: directory
  with_items:
    - "{{ vault_directories }}"

- name: Create data directories
  file:
    path: "{{ vault_data_directory }}/{{ item.path }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: 0755
    state: directory
  with_items:
    - "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command:openssl req -newkey rsa:2048 -nodes -keyout {{ vault_data_directory }}/tls/vault.key -x509 -days 1095 -out {{ vault_data_directory }}/tls/vault.crt -subj "/CN=vault"
  args:
    creates: "{{ vault_data_directory }}/tls/vault.key"
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ vault_data_directory }}/tls/{{ item }}"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  with_items:
    - "vault.crt"
    - "vault.key"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    owner: root
    group: root
    mode: 0755
    remote_src: yes
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  capabilities:
    path: /usr/bin/vault
    capability: cap_ipc_lock=ep
    state: present
  changed_when: False

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0644
    state: file
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    mode: 0755
    state: directory

- name: Copy Vault service file
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: 0644
  notify: Daemon reload
  when: vault_service_manager == "systemd"

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
    mode: 0644
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


