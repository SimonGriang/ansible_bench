    owner: "{{ item.owner | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
    mode: 0755
  loop: "{{ httpd_vhosts }}"
  when: item.create_docroot | default(True)
  notify: Test Apache configuration and restart Apache

- name: Create virtual host configuration files
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory ~ '/' ~ item.servername | urlsplit('hostname') ~ '.conf' }}"
    mode: 0644
  loop: "{{ httpd_vhosts }}"
  notify: Test Apache configuration and restart Apache

- name: Enable virtual hosts on Debian-based systems
  command: a2ensite {{ item.servername | urlsplit('hostname') ~ '.conf' }}
  args:
    creates: "/etc/apache2/sites-enabled/{{ item.servername | urlsplit('hostname') ~ '.conf' }}"
  loop: "{{ httpd_vhosts }}"
  when: ansible_os_family == 'Debian'
  notify: Test Apache configuration and restart Apache


