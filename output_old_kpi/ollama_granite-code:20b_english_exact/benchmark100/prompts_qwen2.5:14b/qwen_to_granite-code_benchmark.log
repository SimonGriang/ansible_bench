---
- import_tasks: assert.yml
- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/my.cnf
    line: "{{ item.line }}"
    regexp: "{{ item.regexp }}"
    state: present
  with_items: "{{ mysql_configuration_options }}"
- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/my.cnf
    line: "socket=/var/run/mysqld/mysqld.sock"
    regexp: "^socket="
    state: present
- name: Initialize mysql
  command: mysql_install_db
  args:
    creates: /var/lib/mysql/mysql
- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: true
- name: Place my.cnf
  copy:
    src: /tmp/my.cnf
    dest: /etc/mysql/my.cnf
    owner: root
    group: root
    mode: 0644
- name: Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: present
  with_items: "{{ mysql_databases }}"
  loop_control:
    label: "Creating database {{ item.name }}"
- name: List databases
  command: mysql -e 'SHOW DATABASES;'
  register: mysql_databases_list
- name: Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.target }}"
  with_items: "{{ mysql_import_databases }}"
  loop_control:
    label: "Importing database {{ item.name }}"
  when: item.name not in mysql_databases_list.stdout_lines
- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.priv }}"
    state: present
  with_items: "{{ mysql_users }}"
  loop_control:
    label: "Creating user {{ item.name }}"
- name: Flush handlers
  meta: flush_handlers
- name: Flush handlers again
  meta: flush_handlers


