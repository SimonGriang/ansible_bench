    failed_when: install_rke2.rc not in [0, 1]
    when: not ansible_check_mode and rke2_version != installed_rke2_version.stdout and not ansible_check_mode
  - name: Copy Custom Manifests
    copy:
      src: "{{ item }}"
      dest: "{{ rke2_data_path }}/server/manifests/"
      force: yes
    with_fileglob:
      - ../files/manifests/*.yaml
    when: rke2_custom_manifests is defined
  - name: Copy Static Pods
    copy:
      src: "{{ item }}"
      dest: "{{ rke2_agent_pod_manifests_path }}/"
      force: yes
    with_fileglob:
      - ../files/static-pods/*.yaml
    when: rke2_static_pods is defined
  - name: Copy RKE2 environment file
    copy:
      dest: /etc/sysconfig/rke2-env
      content: |
        {% for key, value in rke2_environment_variables.items() %}
        export {{ key }}="{{ value }}"
        {% endfor %}
      mode: 0644
    when: rke2_environment_variables is defined and rke2_environment_variables | length > 0
  when: not rke2_skip_downloads


