        rke2_service_version: "{{ rke2_service.version }}"
      when: rke2_service is defined
    - name: Set RKE2 versions fact
      set_fact:
        rke2_versions:
          installed: "{{ installed_rke2_version | default('unknown') }}"
          running: "{{ rke2_service_version | default('unknown') }}"
  - name: Prevent accidental RKE2 downgrade
    when: not ansible_check_mode and installed_rke2_version.rc == 0
    block:
    - name: Check running RKE2 version is compatible with installed version
      assert:
        that: "rke2_version | version_compare(installed_rke2_version.stdout, operator='>=')"
