---
- name: Create ssl key
  file:
    path: "{{ item.path }}/{{ item.name }}.key"
    state: file
    mode: 640
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ssl.list}}"
  loop_control:
    label: "Create {{ item.name }}.key"

- name: Create ssl csr
  openssl_csr:
    path: "{{ item.path }}/{{ item.name }}.csr"
    privatekey_path: "{{ item.path }}/{{ item.name }}.key"
    common_name: "{{ item.name }}.com"
    mode: 644
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ssl.list}}"
  loop_control:
    label: "Create {{ item.name }}.csr"

- name: Create ssl certificates
  openssl_ certificate:
    path: "{{ item.path }}/{{ item.name }}.crt"
    privatekey_path: "{{ item.path }}/{{ item.name }}.key"
    csr_path: "{{ item.path }}/{{ item.name }}.csr"
    mode: 644
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ssl.list}}"
  loop_control:
    label: "Create {{ item.name }}.crt"

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ item.path }}/{{ item.name }}.pfx"
    privatekey_path: "{{ item.path }}/{{ item.name }}.key"
    certificate_path: "{{ item.path }}/{{ item.name }}.crt"
    friendly_name: "test {{ item.name }} pfx"
    mode: 640
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ssl.list}}"
  loop_control:
    label: "Create {{ item.name }}.pfx"

- name: Read private key
  slurp:
    src: "{{ item.path }}/{{ item.name }}.key"
  loop: "{{ssl.list}}"
  loop_control:
    label: "Read {{ item.name }}.key"
  register: private_key_content

- name: Read certificate
  slurp:
    src: "{{ item.path }}/{{ item.name }}.crt"
  loop: "{{ssl.list}}"
  loop_control:
    label: "Read {{ item.name }}.crt"
  register: certificate_content

- name: Create combined private_key and certificate file
  copy:
    dest: "{{ item.path }}/{{ item.name }}_combined.pem"
    content: "{{ private_key_content['results'][loop_index]['content'] }}{{ certificate_content['results'][loop_index]['content'] }}"
    mode: 640
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ssl.list}}"
  loop_control:
    loop_var: loop_index
    label: "Create {{ item.name }}_combined.pem"


