---
- name: cadvisor | create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: 0755
  with_items:
    - /opt/cadvisor
    - /etc/systemd/system/cadvisor.service.d

- name: cadvisor | download
  unarchive:
    src: "https://github.com/google/cadvisor/releases/download/v0.37.0/cadvisor-0.37.0.linux-arm64.tar.gz"
    dest: /opt/cadvisor/
    remote_src: yes
    mode: 0755
    owner: root
    group: root
    sha256sum: "c034438b6a27746e517877b456129a30a7a8f2b8c55325597216f006c6004849"
  when: cadvisor_local_dir is not defined

- name: cadvisor | propagate locally distributed cadvisor binary
  copy:
    src: "{{ cadvisor_local_dir }}"
    dest: /opt/cadvisor/
    owner: root
    group: root
    mode: preserve
  notify: restart cadvisor
  when: cadvisor_local_dir is defined

- name: cadvisor | symlink
  file:
    src: /opt/cadvisor/cadvisor
    dest: /usr/local/bin/cadvisor
    owner: root
    group: root
    state: link

- name: cadvisor | server systemd service
  template:
    src: cadvisor.service.j2
    dest: /etc/systemd/system/cadvisor.service
    owner: root
    group: root
    mode: 0644
  notify: restart cadvisor

- name: test_task
  service_facts:

