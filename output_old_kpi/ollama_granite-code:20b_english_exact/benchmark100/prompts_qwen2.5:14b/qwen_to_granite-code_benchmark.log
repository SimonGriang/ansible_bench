---
- import_tasks: assert.yml
- name: Uninstall conflicting systemd-logger
  ansible.builtin.package:
    name: systemd-logger
    state: absent
  tags:
    - rsyslog

- name: Install rsyslog
  ansible.builtin.package:
    name: "{{ rsyslog_package_name }}"
    state: "{{ rsyslog_package_state }}"
  tags:
    - rsyslog

- name: Install additional rsyslog packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features }}"
  tags:
    - rsyslog

- name: Configuring default rsyslog
  ansible.builtin.template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: "0644"
  register: rsyslog_config
  when: rsyslog_deploy_default_config
  tags:
    - rsyslog

- name: Make configuration directory
  ansible.builtin.file:
    path: /etc/rsyslog.d/
    state: directory
    owner: root
    group: root
    mode: "0755"
  tags:
    - rsyslog

- name: Configuring rsyslog forward rule
  ansible.builtin.template:
    src: forward.conf.j2
    dest: /etc/rsyslog.d/forward.conf
    owner: root
    group: root
    mode: "0644"
  when: not rsyslog_deploy_default_config
  tags:
    - rsyslog

- name: Configuring additional config files
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/rsyslog.d/
    owner: root
    group: root
    mode: "0644"
  loop: "{{ rsyslog_config_files }}"
  when: rsyslog_config_files is defined
  tags:
    - rsyslog

- name: Start and enable rsyslog
  ansible.builtin.service:
    name: rsyslog
    state: started
    enabled: true
  tags:
    - rsyslog


