---
- name: Task 1 - Enable proxy modules in Apache
  tags: apache
  block:
    - name: Install Apache2 modules
      ansible.builtin.apt:
        name: "{{ item }}"
        state: present
      loop:
        - libapache2-mod-proxy
        - libapache2-mod-proxy-http
      notify: restart apache2
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"

- name: Task 2 - Configure Apache locations using a template
  tags: apache
  block:
    - name: Template configuration for Apache locations
      ansible.builtin.template:
        src: apache.conf.j2
        dest: /etc/apache2/sites-available/example.com.conf
        owner: root
        group: root
        mode: "0644"
      notify: restart apache2
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"


