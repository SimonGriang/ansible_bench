---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Pre-configure debian systems
  set_fact:
    ansible_ssh_pipelining: yes
    main_mailer_type: "No configuration"
  when: ansible_os_family == "Debian"

- name: Install postfix
  package:
    name: postfix
    state: present

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined or postfix_virtual_mailbox_domains is defined or postix_virtual_alias_maps is defined

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    owner: root
    group: root
    mode: '0644'
  notify: restart postfix
  tags:
    - postfix_transport_maps

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    owner: root
    group: root
    mode: '0644'
  notify: restart postfix
  tags:
    - postfix_header_checks

- name: Setting values for main.cf (1/2)
  set_fact:
    smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions | default(omit) }}"
    smtpd_sender_restrictions: "{{ smtpd_sender_restrictions | default(omit) }}"
  when: smtpd_recipient_restrictions is defined or smtpd_sender_restrictions is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    mynetworks: "{{ mynetworks | default('127.0.0.0/8 [::1]/128') }}"
    mydestination: "{{ mydestination | default('localhost, localhost.localdomain, localhost.localdomain') }}"
    relay_domains: "{{ relay_domains | default(omit) }}"
    virtual_mailbox_domains: "{{ virtual_mailbox_domains | default(omit) }}"
    virtual_alias_domains: "{{ virtual_alias_domains | default(omit) }}"

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    owner: root
    group: root
    mode: '0644'
  notify: restart postfix
  tags:
    - postfix_main_cf

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    owner: root
    group: root
    mode: '0644'
  notify: restart postfix
  tags:
    - postfix_master_cf

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    owner: root
    group: root
    mode: '0755'
  loop:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"
  when: postfix_smtpd_tls_cert_file is defined or postfix_smtpd_tls_key_file is defined
  notify: restart postfix
  tags:
    - postfix_tls

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    owner: root
    group: root
    mode: '0644'
  notify: restart postfix
  when: postfix_smtpd_tls_cert_file is defined
  tags:
    - postfix_tls

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    owner: root
    group: root
    mode: '0600'
  notify: restart postfix
  when: postfix_smtpd_tls_key_file is defined
  tags:
    - postfix_tls

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
    owner: root
    group: root
    mode: '0644'
  notify:
    - rebuild alias database
    - reload postfix
  tags:
    - postfix_aliases

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    owner: root
    group: root
    mode: '0644'
  notify:
    - rebuild sender_access database
    - reload postfix
  tags:
    - postfix_sender_access

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    owner: root
    group: root
    mode: '0644'
  notify:
    - validate configuration
    - rebuild recipient_access database
    - reload postfix
  tags:
    - postfix_recipient_access

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map | join('\n') }}"
    dest: /etc/postfix/sasl_password_map
    owner: root
    group: root
    mode: '0644'
  notify:
    - rebuild sasl_password_map database
  tags:
    - postfix_sasl_password_map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: yes


