---
- name: Create ssl key
  file:
    path: "{{ item.ssl_key_path }}"
    state: touch
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  with_items: "{{ssl_items}}"

- name: Create ssl csr
  command: "openssl req -new -key {{ item.ssl_key_path }} -out {{ item.ssl_csr_path }} -subj '/CN={{ item.common_name }}'"
  with_items: "{{ssl_items}}"

- name: Create ssl certificates
  command: "openssl x509 -req -days {{ item. validity }} -in {{ item.ssl_csr_path }} -signkey {{ item.ssl_key_path }} -out {{ item.ssl_certificate_path }}"
  with_items: "{{ssl_items}}"

- name: Create PKCS#12 file
  command: "openssl pkcs12 -export -inkey {{ item.ssl_key_path }} -in {{ item.ssl_certificate_path }} -out {{ item.ssl_pkcs12_path }} -name {{ item.common_name }} -password ${{ item.ssl_pkcs12_password }}"
  with_items: "{{ssl_items}}"

- name: Read private key
  slurp:
    src: "{{ item.ssl_key_path }}"
  register: private_key
  with_items: "{{ssl_items}}"

- name: Read certificate
  slurp:
    src: "{{ item.ssl_certificate_path }}"
  register: certificate
  with_items: "{{ssl_items}}"

- name: Create combined private_key and certificate file
  copy:
    content: "{{ private_key.content }}{{ certificate.content }}"
    dest: "{{ item.ssl_combined_path }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
    mode: "{{ item.mode }}"
  with_items: "{{ssl_items}}"



