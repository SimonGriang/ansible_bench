    state: present

- name: Task 6
  yum:
    name: java-1.8.0-oracle
    state: present

- name: Task 7
  unarchive:
    src: /tmp/jdk-8u212-linux-x64.tar.gz
    dest: /usr/java
    remote_src: true

- name: Task 8
  unarchive:
    src: /tmp/jce_policy-8.zip
    dest: /tmp
    remote_src: true

- name: Task 9
  copy:
