---
- name: "Cordon and Drain the node {{ rke2_node_name }}"
  command: "kubectl cordon --kubeconfig {{ rke2_data_path }}/agent/etc/kubernetes/admin.conf {{ rke2_node_name }}"
  register: drain
  until: drain.stdout == ""
  retries: 100
  delay: 15
  changed_when: false

- name: "Restart RKE2 service on {{ rke2_node_name }}"
  service:
    name: rke2-server
    state: restarted
  notify: "Service (re)started"

- name: "Wait for all nodes to be ready again"
  command: "kubectl wait --kubeconfig {{ rke2_data_path }}/agent/etc/kubernetes/admin.conf node --for condition=Ready --all --timeout=600s"
  retries: 100
  delay: 15
  changed_when: false
  when: rke2_wait_for_all_nodes_to_be_ready

- name: "Uncordon the node {{ rke2_node_name }}"
  command: "kubectl uncordon --kubeconfig {{ rke2_data_path }}/agent/etc/kubernetes/admin.conf {{ rke2_node_name }}"
  retries: 100
  delay: 15
  changed_when: false
  when: rke2_drain_node_during_upgrade

- name: "Wait for all pods to be ready again"
  command: "kubectl wait --kubeconfig {{ rke2_data_path }}/agent/etc/kubernetes/admin.conf pod --all --for condition=Ready --timeout=600s"
  retries: 100
  delay: 15
  changed_when: false
  when: rke2_wait_for_all_pods_to_be_ready

- name: "Wait for all pods to pass readiness checks"
  command: "kubectl wait --kubeconfig {{ rke2_data_path }}/agent/etc/kubernetes/admin.conf pod --all --for condition=Ready --timeout=600s"
  retries: 100
  delay: 15
  changed_when: false
  when: rke2_wait_for_all_pods_to_be_healthy


