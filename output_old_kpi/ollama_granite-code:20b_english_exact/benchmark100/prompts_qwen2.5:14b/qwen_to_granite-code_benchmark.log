---
- name: Bootstrap
  hosts: all
  tasks:
    - import_tasks: assert.yml
    - name: Wait for port to be available
      wait_for:
        port: "{{ ansible_port }}"
        timeout: "{{ bootstrap_timeout }}"
        connect_timeout: "{{ bootstrap_timeout }}"
        state: started
      delegate_to: localhost
      connection: local
    - name: Prepare system
      block:
        - name: Test connection
          command: whoami
        - name: Test sudo
          command: sudo whoami
      become: true
      become_user: root
      become_method: sudo
    - name: Gather bootstrap facts
      setup:
      when: bootstrap_prepare_facts_failed
    - name: Install bootstrap packages (raw)
      raw: "{{ bootstrap_packages_raw[ansible_os_family] }}"
      changed_when: false
      when: ansible_os_family in bootstrap_packages_raw
    - name: Ensure libdnf5 is present on Fedora/RedHat
      package:
        name: libdnf5
        state: present
      when: ansible_os_family in ["Fedora", "RedHat"]
    - name: Gather ansible facts
      setup:
    - name: Install bootstrap packages (package)
      package:
        name: "{{ bootstrap_packages_package[ansible_os_family] }}"
        state: present
        update_cache: true
      when: ansible_os_family in bootstrap_packages_package


