ad_duration': 30813638, 'prompt_eval_count': 1206, 'prompt_eval_duration': 15071794, 'eval_count': 536, 'eval_duration': 10489989412, 'model_name': 'granite-code:20b'} id='run--32249afa-bc5e-4a77-8fdf-8d95818d0d7c-0' usage_metadata={'input_tokens': 1206, 'output_tokens': 536, 'total_tokens': 1742}
