---

- import_tasks: assert.yml

- name: Task 2 - Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Task 3 - Create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_user }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_dir_mode }}"
  loop:
    - /var/lib/named
    - /var/lib/named/data
    - /var/lib/named/dynamic
    - /etc/named.conf.d
    - /etc/systemd/system/named.service.d

- name: Task 4 - Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Task 5 - Create user
  user:
    name: "{{ dns_user }}"
    group: "{{ dns_group }}"
    system: yes
    createhome: no

- name: Task 6 - Generate rndc key
  command: rndc-confgen -a -b 512 -c {{ dns_keys_dir }}/rndc.key

- name: Task 7 - Set permissions on rndc key file
  file:
    path: "{{ dns_keys_dir }}/rndc.key"
    mode: 0600

- name: Task 8 - Get the hints/root file
  get_url:
    url: https://www.internic.net/domain/named.cache
    dest: /var/lib/named/data/root. hints

- name: Task 9 - Create zone file
  template:
    src: zone.j2
    dest: /etc/named.conf.d/zones.conf

- name: Task 10 - Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/named.conf

- name: Task 11 - Place systemd override
  copy:
    src: named.conf.override.j2
    dest: /etc/systemd/system/named.service.d/override.conf

- name: Task 12 - Start and enable dns
  systemd:
    name: named
    state: started
    enabled: yes


