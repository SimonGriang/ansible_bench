---

- name: Import assert.yml
  include_tasks: assert.yml

- name: Enable redis module stream (RHEL 8)
  when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"
  yum:
    name: "https://download.redis.io/releases/redis-6.2.6.tar.gz/redis-6.2.6/redis-6.2.6.el8.x86_64.rpm"
    state: present

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: "redis.conf.j2"
    dest: "/etc/redis.conf"
    owner: "redis"
    group: "redis"
    mode: "0644"
  notify: restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes


