---
- name: Task 1
  when: java_jdk_vendor == "adoptopenjdk"
  set_fact:
    java_jdk_vendor: "temurin"

- name: Task 2
  include_vars:
    file: "{{ java_os_variables_file }}"
    name: java_os_variables

- name: Task 3
  include_vars:
    file: "{{ java_arch_variables_file }}"
    name: java_arch_variables

- name: Task 4
  when: java_os_variables.java_version is not defined or java_os_variables.java_version == "None"
  fail:
    msg: "java_os_variables.java_version is not defined or set to None"

- name: Task 5
  when: java_arch_variables.java_version is not defined or java_arch_variables.java_version == "None"
  fail:
    msg: "java_arch_variables.java_version is not defined or set to None"

- name: Task 6
  set_fact:
    java_home: "{{ openjdk_home }}"

- name: Task 7
  when: ansible_os_family == "Debian"
  block:
    - name: Debian - Remove deprecated repositories
      apt_repository:
        repo: "{{ item.repo }}"
        state: absent
      with_items: "{{ java_debian_repos_deprecated }}"

    - name: Debian - Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
      with_items: "{{ java_debian_extra_tools }}"

    - name: Debian - Add key repositories
      apt_key:
        data: "{{ lookup('file', item) }}"
        id: "{{ item | regex_replace('.*\\.pub') | regex_replace('.pub$') }}"
        state: present
      with_items: "{{ java_debian_key_repositories }}"
      register: java_debian_apt_key_result

    - name: Debian - Add repositories
      apt_repository:
        repo: "{{ item }}"
        state: present
      with_items: "{{ java_debian_repositories }}"
      register: java_debian_apt_repo_result

- name: Task 8
  when: ansible_os_family == "RedHat"
  block:
    - name: RedHat - Add key repositories
      rpm_key:
        key: "{{ item }}"
        state: present
      with_items: "{{ java_redhat_key_repositories }}"
      register: java_redhat_rpm_key_result

    - name: RedHat - Add repositories
      command: "rpm -Uvh {{ item }} creates=/etc/yum.repos.d/{{ item | basename }}"
      with_items: "{{ java_redhat_repositories }}"
      register: java_redhat_rpm_repo_result

- name: Task 9
  when: java_os_variables.java_lib is defined and java_os_variables.java_lib != "None"
  package:
    name: "{{ java_os_variables.java_lib }}"
    state: present

- name: Task 10
  when: ansible_os_family == "Debian"
  block:
    - name: Debian - Ensure cache is updated
      apt:
        update_cache: yes
        cache_valid_time: 3600

    - name: Debian - Install Java
      apt:
        name: "openjdk-{{ java_version }}-{{ java_arch_variables.java_arch_nickname | lower }}"
        state: present
      register: java_debian_package_result

    - name: Debian - Check package is installed
      assert:
        that:
          - java_debian_package_result is changed

- name: Task 11
  when: ansible_os_family == "RedHat"
  block:
    - name: RedHat - Ensure cache is updated
      yum:
        update_cache: yes
        cache_valid_time: 3600

    - name: RedHat - Install Java
      yum:
        name: "java-{{ java_version }}-{{ java_arch_variables.java_arch_nickname | lower }}"
        state: present
      register: java_redhat_package_result

    - name: RedHat - Check package is installed
      assert:
        that:
          - java_redhat_package_result is changed

- name: Task 12
  template:
    src: java_environment.sh.j2
    dest: "{{ java_environment_sh }}"

- name: Task 13
  shell: "source {{ java_environment_sh }} creates={{ java_environment_sh }}"

- name: Task 14
  when: ansible_os_family == "Debian" and java_version | int < 11
  shell: "update-alternatives --set {{ java_link }} {{ java_install_dir }}/{{ java_version }}/bin/{{ java_binary }}"

- name: Task 15
  when: ansible_os_family == "Debian" and java_version | int >= 11
  shell: "update-alternatives --set {{ java_link }} {{ java_install_dir }}/{{ java_version }}/bin/{{ java_binary }}1"


