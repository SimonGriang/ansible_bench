---
- name: "Update apt cache"
  apt:
    update_cache: yes
    cache_valid_time: 3600

- name: "Update dnf cache"
  dnf:
    update_cache: yes
    cache_valid_time: 3600

- name: "Install packages"
  package:
    name: keepalived
    state: present

- name: "Create directory for keepalived"
  file:
    path: /etc/keepalived
    state: directory
    owner: root
    group: root
    mode: 0755

- name: "Create Kubernetes API health check script for Debian OS family"
  copy:
    content: |
      #! /bin/bash
      curl -k -s https://localhost:6443/api >/dev/null 2>&1
    dest: /etc/keepalived/keepalived-api-check.sh
    owner: root
    group: root
    mode: 0755
  notify: restart keepalived

- name: "Create Kubernetes API health check script for RedHat OS famliy"
  copy:
    content: |
      #! /bin/bash
      curl -k -s https://localhost:6443/api >/dev/null 2>&1
    dest: /etc/keepalived/keepalived-api-check.sh
    owner: root
    group: root
    mode: 0755
  notify: restart keepalived

- name: "Create RKE2 Server health check script for Debian OS family"
  copy:
    content: |
      #! /bin/bash
      curl -ks https://10.42.0.0:6443/api >/dev/null 2>&1
    dest: /etc/keepalived/keepalived-rke2-server-check.sh
    owner: root
    group: root
    mode: 0755
  notify: restart keepalived

- name: "Create RKE2 Server health check script for RedHat OS family"
  copy:
    content: |
      #! /bin/bash
      curl -ks https://10.42.0.0:6443/api >/dev/null 2>&1
    dest: /etc/keepalived/keepalived-rke2-server-check.sh
    owner: root
    group: root
    mode: 0755
  notify: restart keepalived

- name: "Create keepalived config file"
  copy:
    content: |
      ! Configuration file for keepalived
      global_defs {
        router_id LVS_DEVEL
      }

      vrrp_instanceVI_1 {
        state BACKUP
        interface em1
        virtual_router_id 51
        priority 100
        authentication {
          auth_type PASS
          auth_pass 5555pass
        }
        virtual_ipaddress {
          192.168.0.250/24 dev em1
        }
        track_script {
          check_kubernetes_api
          check_rke2_server
        }
      }
    dest: /etc/keepalived/keepalived.conf
    owner: root
    group: root
    mode: 0644
  notify: restart keepalived

- name: "Enable keepalived and make sure it is not masked"
  service:
    name: keepalived
    state: started
    enabled: yes
    masked: no
  notify: restart keepalived

- name: "Flush handlers"
  meta: flush_handlers


