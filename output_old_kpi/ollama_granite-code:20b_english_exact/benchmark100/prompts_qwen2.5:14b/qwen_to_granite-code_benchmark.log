  when: java_vendor == "openjdk"

- name: Task 4
  yum:
    name: /tmp/jdk-8u212-linux-x64.rpm
    state: present

- name: Task 5
  apt:
    deb: /tmp/jdk-8u212-linux-x64.deb
    state: present

- name: Task 6
  yum:
    name: java-1.8.0-oracle
    state: present

- name: Task 7
  unarchive:
    src: /tmp/jdk-8u212-linux-x64.tar.gz
    dest: /usr/java
