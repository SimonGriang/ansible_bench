---
- name: Bootstrap | Gather facts
  ansible.builtin.gather_facts:
    bootstrap_facts:

- name: Bootstrap | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ ansible_facts['distribution'] }}"
    bootstrap_distribution_major_version: "{{ item.regex }}"
  loop: "{{ bootstrap_os_family_map[ansible_facts['distribution']] }}"
  when:
    - ansible_facts['distribution'] is defined
    - bootstrap_os_family_map[ansible_facts['distribution']] is defined

- name: Bootstrap | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.family }}"
  loop: "{{ bootstrap_os_family_map[bootstrap_distribution] }}"
  when:
    - bootstrap_distribution is defined
    - bootstrap_os_family_map[bootstrap_distribution] is defined


