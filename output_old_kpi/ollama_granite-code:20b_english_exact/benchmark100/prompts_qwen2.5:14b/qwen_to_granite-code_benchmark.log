- name: "hardening | Disable swap now"
  command: swapoff -a
  when: ansible_swaptotal_mb > 0 and vault_hardening_disable_swap
  changed_when: false

- name: "hardening | Disable swap permanently"
  mount:
    name: swap
    fstype: swap
    state: absent
  when: vault_hardening_disable_swap

- name: "hardening | Disable core dumps"
  pam_limits:
    domain: "{{ item }}"
    limit_type: core
    limit_item: hard
