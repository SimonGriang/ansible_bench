---

- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "~{{ user.name }}/.ssh"
    state: directory
    mode: 0750
  become: false
  when: user.manage_ssh_key

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    state: "{{ user.state | default(omit) }}"
    password: "{{ user.password | default(omit) }}"
    update_password: "{{ user.update_password | default(omit) }}"
    expires: "{{ user.password_validity_days | default(omit) }}"
    password_lock: "{{ user.password_lock | default(omit) }}"
    ssh_key: "{{ user.ssh_key | default(omit) }}"
    generate_ssh_key: "{{ user.manage_ssh_key | default(omit) }}"
    ssh_key_type: "{{ user.ssh_key_type | default(omit) }}"
    ssh_key_file: "{{ user.ssh_key_file | default(omit) }}"
    ssh_key_passphrase: "{{ user.ssh_key_passphrase | default(omit) }}"
    sudo: "{{ user.sudo | default(omit) }}"
    sudo_user: "{{ user.sudo_user | default(omit) }}"
    sudo_exe: "{{ user.sudo_exe | default(omit) }}"
    sudo_group: "{{ user.sudo_group | default(omit) }}"
    sudo_mode: "{{ user.sudo_mode | default(omit) }}"
    su: "{{ user.su | default(omit) }}"
    su_user: "{{ user.su_user | default(omit) }}"
    su_exe: "{{ user.su_exe | default(omit) }}"
    home: "{{ user.home | default(omit) }}"
    createhome: "{{ user.createhome | default(omit) }}"
    move_home: "{{ user.move_home | default(omit) }}"
    force: "{{ user.force | default(omit) }}"
    remove: "{{ user.remove | default(omit) }}"
    non_unique: "{{ user.non_unique | default(omit) }}"
    group: "{{ user.group | default(omit) }}"
    groups: "{{ user.groups | default(omit) }}"
    append: "{{ user.append | default(omit) }}"
    comment: "{{ user.comment | default(omit) }}"
    failed_when_user_exists: "{{ user.failed_when_user_exists | default(omit) }}"
    backup: "{{ user.backup | default(omit) }}"
    local: "{{ user.local | default(omit) }}"
    system: "{{ user.system | default(omit) }}"

- name: Set sudo options for {{ user.name }}
  copy:
    dest: "/etc/sudoers.d/{{ user.name }}"
    content: "{{ user.sudo_options }}"
    validate: "/usr/sbin/visudo --check %s"
    mode: 0640
    owner: root
    group: root
  when: user.sudo_options is defined

- name: Remove sudo options for {{ user.name }}
  file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudo_options is not defined

- name: Generate private ssh key for {{ user.name }}
  command: "ssh-keygen -q -t {{ user.ssh_key_type | default('rsa') }} -N '' -f {{ user.ssh_key_file | default(omit) }} -C {{ user.comment | default(omit) }}"
  args:
    creates: "{{ user.ssh_key_file | default(omit) }}"
  no_log: "{{ user.ssh_key_passphrase is defined }}"
  become: false
  when: user.manage_ssh_key

- name: Generate public ssh key for {{ user.name }}
  command: "ssh-keygen -y -f {{ user.ssh_key_file | default(omit) }} -m {{ user.ssh_key_type | default('rsa') }}"
  args:
