---
- name: Task 1
  block:
    - name: Enable proxy module
      apt:
        name: proxy
        state: present
      when: ansible_os_family == "Debian"
    - name: Enable proxy module
      zypper:
        name:apache2-mod_proxy
        state: present
      when: ansible_os_family == "Suse"
