        dest: /etc/rke2/rke2.yaml
      notify: restart rke2

    - name: Copy kubelet config file
      copy:
        src: kubelet.conf
        dest: /etc/rke2/kubelet.conf
      notify: restart rke2
      when: kubelet_arg_content is defined

    - name: Copy Containerd Registry Configuration file
      copy:
        src: containerd-registry.conf
        dest: /etc/rke2/Agent.yaml
      notify: restart rke2
      when: containerd_registry_content is defined

    - name: Start RKE2 service
      service:
        name: rke2-server
        state: started
      notify: restart rke2
      when: groups['agent']|length > 0

    - name: Mask other RKE2 services
      command: |
        if [ "{{ rke2_type }}" == "server" ]; then
          systemctl mask rke2-agent.service
        fi
      when: groups['server']|length > 0

    - name: Wait for remaining nodes to be ready - no CNI
      command: |
        until [ "$(kubectl get nodes | grep -c "Ready")" == "$(kubectl get nodes | wc -l)" ]; do sleep 10; done
      when: groups['server']|length > 0

    - name: Wait for remaining nodes to be ready - with CNI
      command: |
        until [ "$(kubectl get nodes | grep -c "Ready")" == "$(kubectl get nodes | wc -l)" ]; do sleep 10; done
      when: groups['server']|length == 0

  handlers:
    - name: restart rke2
      service:
        name: rke2-server
        state: restarted



