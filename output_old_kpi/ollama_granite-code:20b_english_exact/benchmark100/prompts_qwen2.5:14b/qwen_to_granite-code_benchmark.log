---

- name: check if all variables have been set correctly
  assert:
    that:
      - "item is defined"
  loop:
    - bootstrap_host
    - bootstrap_port
    - bootstrap_hostname
    - bootstrap_install_raw
    - bootstrap_install
    - bootstrap_wait_for_host

- name: wait for host (when configured)
  wait_for:
    host: "{{ bootstrap_host }}"
    port: "{{ bootstrap_port }}"
    connect_timeout: 1
    state: started
    timeout: 60
    msg: " waits for host to become available"
  when: bootstrap_wait_for_host

- name: prepare system
  block:
    - name: establish connection to host
      delegate_to: localhost
      connection: local
      become: no
      uri:
        url: "{{ bootstrap_protocol }}://{{ bootstrap_host }}:{{ bootstrap_port }}"
        status_code: 200
        follow_redirects: all
        body_format: raw
