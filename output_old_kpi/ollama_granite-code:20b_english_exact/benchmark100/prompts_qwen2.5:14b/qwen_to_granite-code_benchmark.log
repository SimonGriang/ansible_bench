---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present
  notify: Test and restart apache

- block:
  - name: Set SELinux booleans
    seboolean:
      name: "{{ item.name }}"
      state: "{{ item.state }}"
      persistent: yes
    with_items: "{{ setype_boolean }}"

  - name: Allow httpd to connect to custom ports
    seport:
      ports: "{{ item }}"
      proto: tcp
      setype: httpd_port_t
      state: present
    with_items: "{{ httpd_ports_list }}"
  when: ansible_selinux.status == "enabled"

- name: Template main httpd configuration file
  template:
    src: "{{ httpd_conf_src }}"
    dest: "{{ httpd_conf_dest }}"
    mode: "{{ httpd_conf_mode }}"
    owner: "{{ httpd_conf_owner }}"
    group: "{{ httpd_conf_group }}"
  notify: Test and restart apache

- name: Activate Apache modules
  command: "a2enmod {{ item }}"
  notify: Test and restart apache
  with_items: "{{ httpd_modules }}"
  when: ansible_os_family == "Debian"

- import_tasks: ssl.yml
  when: https_ssl_enabled

- import_tasks: locations.yml
  when: httpd_locations is defined

- import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- block:
  - name: Template ports configuration file
    template:
      src: ports.conf.j2
      dest: /etc/apache2/ports.conf
      mode: 0644
      owner: root
      group: root
    notify: Test and restart apache

  - name: Restart Apache
    service:
      name: "{{ httpd_service }}"
      state: restarted
    when: ansible_os_family in ["Debian", "Suse"]

  - name: Restart Apache
    service:
      name: httpd
      state: restarted
    when: ansible_os_family == "RedHat"
  when: ansible_os_family in ["Debian", "Suse", "RedHat"]

- import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example

- name: Start and enable httpd
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


