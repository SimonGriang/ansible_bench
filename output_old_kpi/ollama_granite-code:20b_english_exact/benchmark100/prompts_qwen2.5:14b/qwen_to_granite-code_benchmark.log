---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  tags:
    - always

- name: Task 2 - Install openvpn packages
  package:
    name: "{{ openvpn_packages }}"
    state: present
  tags:
    - openvpn

- name: Task 3 - Setup openvpn server or client
  include_tasks: "setup-{{ openvpn_role }}.yml"
  tags:
    - openvpn

- name: Task 4 - Start and enable openvpn
  service:
    name: "{{ openvpn_service }}"
    state: started
    enabled: true
