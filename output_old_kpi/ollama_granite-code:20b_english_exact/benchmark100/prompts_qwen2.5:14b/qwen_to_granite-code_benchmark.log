- import_tasks: assert.yml

- name: Install cron
  ansible.builtin.package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  ansible.builtin.lineinfile:
    path: /etc/cron.allow
    regexp: '^SHELL='
    line: 'SHELL={{ cron_shell }}'
    state: present
    create: true
    mode: "0600"
  notify: Restart cron

- name: Configure path
  ansible.builtin.lineinfile:
    path: /etc/cron.allow
    regexp: '^PATH='
    line: 'PATH={{ cron_path }}'
    state: present
    create: true
    mode: "0600"
  notify: Restart cron

- name: Configure mailto
  ansible.builtin.lineinfile:
    path: /etc/cron.allow
    regexp: '^MAILTO='
    line: 'MAILTO={{ cron_mailto }}'
