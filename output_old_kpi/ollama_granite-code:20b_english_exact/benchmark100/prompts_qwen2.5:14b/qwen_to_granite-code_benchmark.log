---
- name: Populate services facts
  ansible.builtin.service_facts:

- name: Set the Active Server variable
  ansible.builtin.set_fact:
    active_server: "{{ item }}"
  loop: "{{ groups[rke2_cluster_group_name] }}"
  when:
    - item in groups[rke2_servers_group_name]
    - item vars service_facts.services["rke2-server.service"].active == "active"


