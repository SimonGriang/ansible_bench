    dest: "{{ rke2_manifests_dir }}/{{ item | basename | regex_replace('\\.j2$', '') }}"
    owner: root
    group: root
    mode: '0640'
  with_fileglob:
    - templates/kube-vip/loadbalancer/*.yaml.j2
  when: cloud_provider is defined


