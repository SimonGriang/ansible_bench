---
- name: Download RKE2 kubeconfig
  fetch:
    src: /etc/rancher/rke2/rke2.yaml
    dest: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    flat: yes
  delegate_to: "{{ item }}"
  loop: "{{ groups[rke2_servers_group_name] }}"
  run_once: yes
  when:
    - rke2_download_kubeconf
    - inventory_hostname == (groups[rke2_servers_group_name] | first)

- name: Replace loopback IP by master server IP
  replace:
    path: "{{ rke2_download_kubeconf_path }}/{{ rke2_download_kubeconf_file_name }}"
    regexp: '(127\.0\.0\.1|::1)'
    replace: "{{ rke2_api_ip | default(groups[rke2_servers_group_name] | first) }}"
  delegate_to: localhost
  run_once: yes
  when:
    - not ansible_check_mode
    - rke2_download_kubeconf
    - inventory_hostname == (groups[rke2_servers_group_name] | first)


