content='---\n- name: Import assert.yml\n  import_playbook: assert.yml\n\n- name: Install required packages\n  package:\n    name: "{{ grub_packages }}"\n    state: present\n\n- name: Set GRUB_TIMEOUT\n  lineinfile:\n    path: /etc/default/grub\n    regexp: "^GRUB_TIMEOUT="\n    line: "GRUB_TIMEOUT={{ grub_timeout }}"\n    state: present\n  notify: Update grub\n\n- name: Set GRUB_RECORDFAIL_TIMEOUT\n  lineinfile:\n    path: /etc/default/grub\n    regexp: "^GRUB_RECORDFAIL_TIMEOUT="\n    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"\n    state: present\n  notify: Update grub\n\n- name: Add options to GRUB_CMDLINE_LINUX\n  lineinfile:\n    path: /etc/default/grub\n    regexp: "^GRUB_CMDLINE_LINUX="\n    line: \'GRUB_CMDLINE_LINUX="{{ grub_options | join(" ") }}"\'\n    state: present\n  notify: Update grub\n  when: grub_options is defined and grub_options | length > 0\n\n- name: Import password.yml\n  import_playbook: password.yml\n  when: grub_set_password\n\n- name: Flush handlers\n  meta: flush_handlers' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-02T17:51:23.463431292Z', 'done': True, 'done_reason': 'stop', 'total_duration': 7026753336, 'load_duration': 41328865, 'prompt_eval_count': 1978, 'prompt_eval_duration': 526154945, 'eval_count': 302, 'eval_duration': 6457957045, 'model_name': 'granite-code:20b'} id='run--2d284606-62ea-4f00-a7a4-0594236d05b1-0' usage_metadata={'input_tokens': 1978, 'output_tokens': 302, 'total_tokens': 2280}
