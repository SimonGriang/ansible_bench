- name: Check if python3.11 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/src/python3.11/EXTERNALLY-MANAGED
  register: python311_managed_file_check

- name: Rename python3.11 EXTERNALLY-MANAGED file if it exists
  rename:
    path: /usr/src/python3.11/EXTERNALLY-MANAGED
    dest: /usr/src/python3.11/EXTERNALLY-MANAGED.old
  when: python311_managed_file_check.stat.exists

- name: Check if python3.12 EXTERNALLY-MANAGED file exists
  stat:
    path: /usr/src/python3.12/EXTERNALLY-MANAGED
  register: python312_managed_file_check

- name: Rename python3.12 EXTERNALLY-MANAGED file if it exists
  rename:
    path: /usr/src/python3.12/EXTERNALLY-MANAGED
    dest: /usr/src/python3.12/EXTERNALLY-MANAGED.old
  when: python312_managed_file_check.stat.exists

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install python pip
  pip:
    name: "{{ python_pip_packages }}"
    executable: pip3
  when: python_pip_packages is defined and ansible_os_family != "alpine" and ansible_distribution != "bookworm" and ansible_distribution != "noble"

- name: Configure pip proxy
  pip:
    name: "{{ python_pip_packages }}"
    executable: pip3
    extra_args: "-i {{ python_pip_proxy }}"
  when: python_pip_packages is defined and python_pip_proxy is defined and ansible_os_family != "alpine" and ansible_distribution != "bookworm" and ansible_distribution != "noble"

- name: Trust hosts
  pip:
    name: "{{ python_pip_packages }}"
    executable: pip3
    extra_args: "--trusted-host {{ python_pip_trusted_host }}"
  when: python_pip_packages is defined and python_pip_trusted_host is defined and ansible_os_family != "alpine" and ansible_distribution != "bookworm" and ansible_distribution != "noble"

- name: Update pip
  pip:
    executable: pip3
    name: pip
    state: latest
    extra_args: "--upgrade --no-cache-dir --no-warn-script-location"
  when: python_pip_update is defined and python_pip_update == true and ansible_os_family != "alpine" and ansible_distribution != "bookworm" and ansible_distribution != "noble"

- name: Install requested modules
  pip:
    executable: pip3
    name: "{{ python_pip_modules }}"
  when: python_pip_modules is defined and ansible_os_family != "alpine" and ansible_distribution != "bookworm" and ansible_distribution != "noble"


