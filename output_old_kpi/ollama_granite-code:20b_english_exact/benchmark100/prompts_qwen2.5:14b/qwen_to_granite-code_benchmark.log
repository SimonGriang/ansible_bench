---

- name: Remove Docker apt key and source list file
  file:
    path: "{{ item }}"
    state: absent
  loop:
    - /etc/apt/trusted.gpg.d/docker-archive-keyring.gpg
    - /etc/apt/sources.list.d/docker.list
  notify: Update apt cache

- name: Uninstall old versions of Docker
  apt:
    name: docker
    state: absent
  notify: Update apt cache

- name: Remove legacy Docker repository file
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent
  notify: Update apt cache

- name: Install necessary dependencies for Docker
  apt:
    name: "{{ item }}"
    state: present
  loop:
    - apt-transport-https
    - ca-certificates
    - python3-debian

- name: Add or remove Docker repository
  apt_repository:
    repo: "deb [arch=amd64] https://download.docker.com/linux/{{ ansible_distribution|lower }} {{ ansible_distribution_release }} stable"
    state: "{{ 'present' if docker_add_repo else 'absent' }}"
  notify: Update apt cache

- name: Flush handlers to update apt cache
  meta: flush_handlers


