---

- import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Install requirements
  package:
    name: "{{ sysctl_requirements }}"
    state: present
  when: sysctl_requirements|length > 0

- name: Set sysctl setting
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: "{{ item.state | default(omit) }}"
    reload: "{{ item.reload | default(omit) }}"
    sysctl_file: /etc/sysctl.d/98-ansible-sysctl.conf
    sysctl_set: "{{ item.sysctl_set | default(omit) }}"
  loop: "{{ sysctl_items }}"
  when:
    - sysctl_items is defined
    - sysctl_items|length > 0
    - not (ansible_connection == 'container')


