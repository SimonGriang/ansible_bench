---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == "server"

- name: Copy RKE2 configuration file
  template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
  notify: Config file changed

- name: Copy kubelet configuration file
  template:
    src: kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
  notify: Config file changed
  when: rke2_kubelet_config != ""

- name: Copy Containerd Registry Configuration file
  template:
    src: registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
  notify: Config file changed
  when: rke2_custom_registry_mirrors != "" or rke2_custom_registry_configs != ""

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file != "" and rke2_services["rke2-server.service"] is not defined

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file != "" and rke2_etcd_snapshot_s3_options.access_key != "" and rke2_etcd_snapshot_s3_options.secret_key != "" and rke2_etcd_snapshot_s3_options.bucket != "" and rke2_etcd_snapshot_s3_options.snapshot_name != ""

- name: Restore etcd from file
  block:
    - file:
        path: /var/lib/rancher/rke2/agent/etc/etcd/snapshots
        state: directory
    - copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/etc/etcd/snapshots/rke2-backup.db
    - command: rke2-server etcd-restore --backup-path /var/lib/rancher/rke2/agent/etc/etcd/snapshots/rke2-backup.db
  when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - command: rke2-server etcd-restore --s3 --s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }} --s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }} --s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }} --s3-endpoint {{ rke2_etcd_snapshot_s3_options.endpoint }} --s3-region {{ rke2_etcd_snapshot_s3_options.region }} --s3-snapshot {{ rke2_etcd_snapshot_s3_options.snapshot_name }}
  when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: true
    env:
      RKE2_TOKEN: "{{ rke2_token }}"
  when: rke2_type == "server" and inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: stopped
    enabled: false
  when: rke2_type == "server" and inventory_hostname == groups[rke2_cluster_group_name][0]

- name: Wait for the first server be ready - no CNI
  command: rke2 status --name {{ inventory_hostname }}
  register: node_status
  until: node_status.stdout.find("Ready") != -1 and node_status.stdout.find("CNI") == -1
  retries: 60
  delay: 10
  when: rke2_type == "server" and inventory_hostname == groups[rke2_cluster_group_name][0] and not rke2_disable_cni

- name: Wait for the first server be ready - with CNI
  command: rke2 status --name {{ inventory_hostname }}
  register: node_status
  until: node_status.stdout.find("Ready") != -1 and node_status.stdout.find("CNI") != -1
  retries: 60
  delay: 10
  when: rke2_type == "server" and inventory_hostname == groups[rke2_cluster_group_name][0] and rke2_disable_cni

- name: Restore etcd
  block:
    - command: rke2-server etcd-remove-member --name {{ inventory_hostname }}
    - command: rke2-server etcd-remove-member --name {{ groups[rke2_cluster_group_name][0] }}
    - command: rke2-server etcd-snapshot --name {{ groups[rke2_cluster_group_name][0] }}
    - command: rke2-server etcd-restore --name {{ inventory_hostname }} --backup-path /var/lib/rancher/rke2/agent/etc/etcd/snapshots/rke2-backup.db
    - command: rm -rf /var/lib/rancher/rke2/agent/etc/etcd/snapshots
  when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: rke2_type == "server"


