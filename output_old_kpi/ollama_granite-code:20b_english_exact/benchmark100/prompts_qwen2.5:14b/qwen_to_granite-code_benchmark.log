---

- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2 - Install logrotate
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Task 3 - Configure logrotate
  template:
    src: "{{ logrotate_config_file }}.j2"
    dest: "{{ logrotate_config_directory }}"
  notify: Task 6 - Start logrotate

- name: Task 4 - Generate logrotate.d files
  template:
    src: logrotate.d.j2
    dest: "{{ logrotate_config_directory }}/{{ item.name }}"
  loop: "{{ logrotate_entries }}"
  when: item.state is undefined or item.state != "absent"
  notify: Task 6 - Start logrotate

- name: Task 5 - Remove logrotate.d files
  file:
    path: "{{ logrotate_config_directory }}/{{ item.name }}"
    state: absent
  loop: "{{ logrotate_entries }}"
  when: item.state is defined and item.state == "absent"
  notify: Task 6 - Start logrotate

- name: Task 6 - Start logrotate
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled }}"
  when: logrotate_service is defined


