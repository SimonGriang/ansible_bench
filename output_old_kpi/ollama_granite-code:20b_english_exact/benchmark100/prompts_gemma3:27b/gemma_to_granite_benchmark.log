---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port|default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  when: ansible_connection is defined and not ansible_connection == 'container' and bootstrap_wait_for_host

- block:
  - name: test connection
    ping:
  - name: test sudo
    command: sudo echo OK
    changed_when: false
  - name: gather bootstrap packages facts
    package_facts:
  - name: install bootstrap packages
    package:
      name: "{{ bootstrap_facts_packages }}"
      update_cache: true
      become: "{{ bootstrap_become }}"
  rescue:
  - name: gather facts
    setup:
  - name: install bootstrap packages
    raw: "{{ bootstrap_package_command }}"
  - name: ensure libdnf5 is present
    package:
      name: libdnf
      state: present
    when: ansible_distribution == "CentOS" or ansible_distribution == "Red Hat Enterprise Linux" or ansible_distribution == "Oracle Linux"
  - name: gather bootstrap packages facts
    package_facts:

- name: gather ansible facts
  setup:

- name: install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages }}"
    update_cache: true
    become: "{{ bootstrap_become }}"

