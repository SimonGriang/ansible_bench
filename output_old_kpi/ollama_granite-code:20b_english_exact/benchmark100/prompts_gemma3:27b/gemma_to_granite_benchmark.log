---
- import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: Install python pip
  package:
    name: "{{ python_pip_packages }}"
    state: present

- name: Configure pip proxy
  ini_file:
    path: /etc/pip.conf
    section: global
    option: index-url
    value: "{{ python_pip_proxy }}"
    mode: 0644
  when: python_pip_proxy is defined

- name: Trust hosts
  ini_file:
    path: /etc/pip.conf
    section: global
    option: trusted-host
    value: "{{ python_pip_trusted_host }}"
    mode: 0644
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: "{{ python_pip_pip_package }}"
    executable: "{{ python_pip_executable }}"
    state: "{{ python_pip_pip_state }}"
  when:
    - python_pip_pip_package is defined
    - python_pip_pip_state is defined
    - not (ansible_os_family == "Debian" and (ansible_distribution_release in ["bookworm", "noble", "Alpine"]))

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version }}"
    executable: "{{ python_pip_executable }}"
    state: "{{ item.state }}"
  loop: "{{ python_pip_modules }}"
  when:
    - python_pip_modules is defined
    - not (ansible_os_family == "Debian" and (ansible_distribution_release in ["bookworm", "noble", "Alpine"]))
  loop_control:
    label: "{{ item.name }}"


