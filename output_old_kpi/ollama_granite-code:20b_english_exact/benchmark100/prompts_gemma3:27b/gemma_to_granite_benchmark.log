---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- block:
  - name: Install using package
    package:
      name: "{{ hashicorp_products }}"
      state: present
  when: hashicorp_installation_method == "package"

- block:
  - name: Install repository for RedHat
    copy:
      content: |
        [hashicorp]
        name=Hashicorp
        baseurl={{ hashicorp_repo_url }}
        enabled=1
        gpgcheck=1
        repo_gpgcheck=1
        gpgkey=https://apt.releases.hashicorp.com/gpg
        sslverify=1
        sslcacert=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
        metadata_expire=300
      dest: /etc/yum.repos.d/hashicorp.repo
      owner: root
      group: root
      mode: "0640"
    when: ansible_os_family == "RedHat"
  when: hashicorp_installation_method == "package"

- block:
  - name: Configure debian
    apt:
      update_cache: yes
      cache_valid_time: 3600
  when: hashicorp_installation_method == "package" and ansible_os_family == "Debian"

- block:
  - name: Install required package gpg
    package:
      name: gpg
      state: present
  when: hashicorp_installation_method == "package" and ansible_os_family == "Debian"

- block:
  - name: Install apt key for Debian
    apt_key:
      url: https://apt.releases.hashicorp.com/gpg
      keyring: /etc/apt/trusted.gpg.d/hashicorp.gpg
      state: present
      ignore_errors: true
  when: hashicorp_installation_method == "package" and ansible_os_family == "Debian"

- block:
  - name: Install repository for Debian
    apt_repository:
      repo: "deb [arch={{ hashicorp_architecture_mapping[ansible_architecture] }}] {{ hashicorp_repo_url }} {{ ansible_distribution_release }} main"
      state: present
      filename: hashicorp
  when: hashicorp_installation_method == "package" and ansible_os_family == "Debian"

- block:
  - name: Install hashicorp product using package
    package:
      name: "{{ hashicorp_products }}"
      state: present
  when: hashicorp_installation_method == "package" and hashicorp_products is defined

- block:
  - name: Install latest hashicorp product using package
    package:
      name: "{{ item.name }}"
      state: latest
    loop: "{{ hashicorp_products }}"
    loop_control:
      label: "Install {{ item.name }} using package"
  when: hashicorp_installation_method == "package" and hashicorp_products is defined

- block:
  - name: Install versioned hashicorp product using package
    package:
      name: "{{ version_coupler }}{{ item.name }}"
      state: present
    loop: "{{ hashicorp_products }}"
    loop_control:
      label: "Install {{ item.name }} using package"
    when: item.version is defined
  when: hashicorp_installation_method == "package" and hashicorp_products is defined

- block:
  - name: Install manually
    unarchive:
      src: "{{ hashicorp_src }}"
      dest: "{{ hashicorp_dest }}"
      group: "{{ hashicorp_group }}"
      mode: "{{ hashicorp_mode }}"
      owner: "{{ hashicorp_owner }}"
    loop: "{{ hashicorp_products }}"
    loop_control:
      label: "Install {{ item.name }} manually"
  when: hashicorp_installation_method == "manual"

