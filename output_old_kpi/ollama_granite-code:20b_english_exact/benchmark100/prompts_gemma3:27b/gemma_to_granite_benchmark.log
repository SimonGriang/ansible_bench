content='---\n\n- name: Task 1 - Import assert.yml\n  include_tasks: assert.yml\n  run_once: true\n  delegate_to: localhost\n\n- name: Task 2 - Install required packages\n  package:\n    name: "{{ selinux_requirements }}"\n    state: present\n  notify: Gather facts\n\n- name: Task 3 - Flush handlers\n  meta: flush_handlers\n\n- name: Task 4 - Configure selinux\n  selinux:\n    state: "{{ selinux_state }}"\n    policy: "{{ selinux_policy }}"\n  when: ansible_selinux.status is defined and not ansible_local.system.is_container\n  notify: Reboot\n\n- name: Task 5 - Manage selinux booleans\n  selinux:\n    name: "{{ item.name }}"\n    state: "{{ item.state | default(\'yes\') }}"\n    persistent: yes\n  loop: "{{ selinux_booleans }}"\n  when: selinux_booleans is defined' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-07T05:47:37.625453199Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5045988310, 'load_duration': 40883379, 'prompt_eval_count': 534, 'prompt_eval_duration': 491930798, 'eval_count': 210, 'eval_duration': 4511975248, 'model_name': 'granite-code:20b'} id='run--d377262f-6822-4cd8-a23e-ea04cb208b4e-0' usage_metadata={'input_tokens': 534, 'output_tokens': 210, 'total_tokens': 744}
