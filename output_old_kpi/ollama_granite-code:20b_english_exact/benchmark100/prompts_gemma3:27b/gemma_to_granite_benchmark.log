---
- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Pre-configure debian systems
  debconf:
    name: postfix
    question: postfix/mailer_type
    value: "No configuration"
    vtype: string
  when: ansible_os_family == "Debian"
  changed_when: false

- name: Install postfix
  package:
    name: postfix
    state: present
  register: install_postfix

- name: Install postfix-mysql
  package:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined or postfix_virtual_domains is defined

- name: Configure postfix (transport_maps)
  template:
    src: transport_maps.j2
    dest: /etc/postfix/transport_maps
    mode: 0644
  when: postfix_transport_maps is defined
  notify:
    - validate postfix
    - restart postfix
  register: postfix_transport_maps

- name: Configure postfix (header_checks)
  template:
    src: header_checks.j2
    dest: /etc/postfix/header_checks
    mode: 0644
  when: postfix_header_checks is defined
  notify:
    - validate postfix
    - reload postfix
  register: postfix_header_checks

- name: Setting values for main.cf (1/2)
  set_fact:
    postfix_main_cf_smtp_tls_security_level: "{{ 'encrypt' if (postfix_smtp_tls_wrappermode is defined and not postfix_smtp_tls_wrappermode == 'no-ssl') else 'none' }}"
  when: not (postfix_smtp_tls_wrappermode is defined and not postfix_smtp_tls_wrappermode == 'no-ssl')

- name: Setting values for main.cf (2/2)
  set_fact:
    postfix_main_cf_smtp_tls_wrappermode: "{{ postfix_smtp_tls_wrappermode }}"
  when: postfix_smtp_tls_wrappermode is defined

- name: Configure postfix (main.cf)
  template:
    src: main.cf.j2
    dest: /etc/postfix/main.cf
    mode: 0644
  notify:
    - validate postfix
    - restart postfix
  register: postfix_main_cf

- name: Configure postfix (master.cf)
  template:
    src: master.cf.j2
    dest: /etc/postfix/master.cf
    mode: 0644
  notify:
    - validate postfix
    - restart postfix
  register: postfix_master_cf

- name: Creates cert/key directory
  file:
    path: "{{ postfix_tls_cert_dir }}"
    state: directory
    mode: 0755
  when: postfix_smtp_tls_cert_file is defined or postfix_smtp_tls_key_file is defined

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtp_tls_cert_file }}"
    dest: "{{ postfix_smtp_tls_cert_file }}"
    mode: 0644
  when: postfix_smtp_tls_cert_file is defined

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtp_tls_key_file }}"
    dest: "{{ postfix_smtp_tls_key_file }}"
    mode: 0600
  when: postfix_smtp_tls_key_file is defined

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  template:
    src: aliases.j2
    dest: /etc/aliases
    mode: 0644
  when: postfix_aliases is defined
  register: postfix_aliases

- name: Configure sender_access
  template:
    src: sender_access.j2
    dest: /etc/postfix/sender_access
    mode: 0644
  when: postfix_sender_access is defined
  register: postfix_sender_access

- name: Configure recipient_access
  template:
    src: recipient_access.j2
    dest: /etc/postfix/recipient_access
    mode: 0644
  when: postfix_recipient_access is defined
  register: postfix_recipient_access

- name: Place sasl_password_map
  copy:
    content: "{{ postfix_sasl_password_map }}"
    dest: /etc/postfix/sasl_password_map
    mode: 0640
  when: postfix_sasl_password_map is defined
  register: postfix_sasl_password_map

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  service:
    name: postfix
    state: started
    enabled: true


