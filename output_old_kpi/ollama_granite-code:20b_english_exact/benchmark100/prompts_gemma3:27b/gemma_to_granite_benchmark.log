---
- name: Create RKE2 directory
  become: true
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: "0755"

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_type == "server"

- name: Set agent taints
  set_fact:
    combined_node_taints: "{{ rke2_agent_node_taints }}"
  when: rke2_type == "agent"

- name: Copy RKE2 config
  become: true
  template:
    src: rke2.yaml.j2
    dest: /etc/rancher/rke2/rke2.yaml
    mode: "0644"
  register: rke2_config

- name: Copy kubelet config
  become: true
  template:
    src: kubelet.conf.j2
    dest: /var/lib/rke2/agent/etc/kubelet.conf
    mode: "0644"
  register: kubelet_config
  when: rke2_kubelet_config | length > 0

- name: Copy Containerd Registry Configuration file
  become: true
  template:
    src: containerd-registry.yaml.j2
    dest: /etc/rancher/rke2/system-images/containerd/registry.yaml
    mode: "0644"
  register: containerd_config
  when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0

- name: Start RKE2 service
  become: true
  service:
    name: rke2
    state: started
    enabled: true
  environment:
    RKE2_TOKEN: "{{ rke2_token }}"
  register: rke2_service

- name: Mask other RKE2 service
  become: true
  service:
    name: rke2
    enabled: false
    masked: true
  when: rke2_type == "server"

- name: Wait for remaining nodes to be ready - no CNI
  shell: >
    kubectl wait --request-timeout=30s --for=condition=Ready node {{ inventory_hostname }}
    --timeout=60s &&
    [[ $(kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Memory Pressure")].status}') == "False" ]] &&
    [[ $(kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Disk Pressure")].status}') == "False" ]] &&
    [[ $(kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="PID Pressure")].status}') == "False" ]] &&
    ! [[ -f /var/lib/cni/bin/flannel-cni ]] &&
    [[ $(kubectl get node {{ inventory_hostname }} -o jsonpath='{.spec.providerID}') == "rke2://$(hostname -s)" ]];
  args:
    executable: /bin/bash
  register: node_ready
  retries: 120
  delay: 5
  when: rke2_cni == "none" and (rke2_type == "server" or rke2_type == "first_server")

- name: Wait for remaining nodes to be ready - with CNI
  shell: >
    kubectl wait --request-timeout=30s --for=condition=Ready node --timeout=60s
    {{ inventory_hostname }} &&
    [[ $(kubectl get node {{ inventory_hostname }} -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}') == "True" ]] &&
    [[ $(kubectl get nodes -o jsonpath='{.items[*].status.conditions[?(@.type=="Ready")].status}') | grep True | wc -l | tr -d ' ') == "{{ groups['all'] | length }}" ]];
  args:
    executable: /bin/bash
  register: node_ready
  retries: 120
  delay: 5
  when: rke2_cni != "none" and (rke2_type == "server" or rke2_type == "first_server")

