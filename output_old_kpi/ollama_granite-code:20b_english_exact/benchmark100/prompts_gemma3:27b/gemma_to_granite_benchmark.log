---
- name: "Include OS-specific variables."
  include_vars: "{{ item }}"
  with_first_found:
    - files:
      - "{{ ansible_facts.os_family }}-{{ ansible_facts.distribution }}-{{ ansible_facts.distribution_version }}.yml"
      - "{{ ansible_facts.os_family }}-{{ ansible_facts.distribution }}-{{ ansible_facts.distribution_major_version }}.yml"
      - "{{ ansible_facts.os_family }}-{{ ansible_facts.distribution }}.yml"
      - "{{ ansible_facts.os_family }}-{{ ansible_facts.distribution_version }}.yml"
      - "{{ ansible_facts.os_family }}-{{ ansible_facts.distribution_major_version }}.yml"
      - "{{ ansible_facts.os_family }}.yml"
      - defaults/main.yml
      paths:
      -vars
      skip: true

- name: "Include RedHat setup tasks."
  include_tasks: setup-RedHat.yml
  when: ansible_facts.os_family == 'RedHat'

- name: "Include Debian setup tasks."
  include_tasks: setup-Debian.yml
  when: ansible_facts.os_family == 'Debian'

- name: "Install Docker packages."
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: not ansible_facts.os_family == 'RedHat' or not ansible_facts.os_family == 'Debian'

- name: "Install Docker packages (with downgrade option)."
  package:
    name: "{{ docker_packages }}"
    state: "{{ docker_packages_state }}"
    allow_downgrade: true
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: ansible_facts.os_family == 'RedHat' or ansible_facts.os_family == 'Debian'

- name: "Install docker-compose plugin."
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: docker_install_compose_plugin and not ansible_facts.os_family == 'RedHat' or not ansible_facts.os_family == 'Debian'

- name: "Install docker-compose-plugin (with downgrade option)."
  package:
    name: "{{ docker_compose_package }}"
    state: "{{ docker_compose_package_state }}"
    allow_downgrade: true
  notify: restart docker
  ignore_errors: "{{ ansible_check_mode }}"
  when: docker_install_compose_plugin and ansible_facts.os_family == 'RedHat' or ansible_facts.os_family == 'Debian'

- name: "Ensure /etc/docker/ directory exists."
  file:
    path: /etc/docker/
    state: directory
    mode: 0755
  when: docker_daemon_options is defined

- name: "Configure Docker daemon options."
  copy:
    content: "{{ docker_daemon_options | to_json | from_json | indent(2) }}"
    dest: /etc/docker/daemon.json
    mode: 0644
    backup: yes
  notify: restart docker
  when: docker_daemon_options is defined

- name: "Ensure Docker is started and enabled at boot."
  service:
    name: docker
    state: "{{ docker_service_state }}"
    enabled: "{{ docker_service_enabled }}"
  ignore_errors: "{{ ansible_check_mode }}"

- name: "Ensure handlers are notified now to avoid firewall conflicts."
  meta: flush_handlers

- name: "Include docker-compose tasks."
  include: docker-compose.yml
  when: docker_install_compose

- name: "Get docker group info using getent."
  getent:
    database: group
    key: docker

- name: "Check if there are any users to add to the docker group."
  set_fact:
    at_least_one_user_to_modify: "{{ True if docker_users | difference(getent_group_docker.keys()) | list | length > 0 else False }}"
  when:
    - docker_users is defined
    - getent_group_docker is defined

- name: "Include docker-users tasks."
  include: docker-users.yml
  when:
    - docker_users is defined
    - getent_group_docker is defined
    - at_least_one_user_to_modify is defined
    - at_least_one_user_to_modify


