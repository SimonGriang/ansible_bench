---

- name: Task 1
  import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Task 3
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: "^SHELL="
    line: "SHELL={{ cron_shell }}"
    create: true
    mode: 0600
    notify: Restart cron

- name: Task 4
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: "^PATH="
    line: "PATH={{ cron_path }}"
    create: true
    mode: 0600
    notify: Restart cron

- name: Task 5
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: "^MAILTO="
    line: "MAILTO={{ cron_mailto }}"
    create: true
    mode: 0600
    notify: Restart cron

- name: Task 6
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service | length > 0

- name: Task 7
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    special_time: "{{ item.special_time }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default(omit) }}"
    user: "{{ item.user | default(omit) }}"
    cron_file: "{{ item.cron_file | default(omit) }}"
    env: "{{ item.env | default(omit) }}"
    path: "{{ item.path | default(omit) }}"
    backup: "{{ item.backup | default(omit) }}"
    disabled: "{{ item.disabled | default(omit) }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined

