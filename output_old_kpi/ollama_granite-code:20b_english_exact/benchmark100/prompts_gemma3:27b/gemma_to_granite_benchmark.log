---
- name: Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present
  when: grub_packages is defined and grub_packages | length > 0

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: true
    mode: 0664
    notify: Update grub
  when: grub_timeout is defined

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: true
    mode: 0664
    notify: Update grub
  when: grub_recordfail_timeout is defined

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_CMDLINE_LINUX{{ item }}"
    create: true
    mode: 0664
    notify: Update grub
  loop: "{{ grub_options }}"
  when: grub_options is defined and grub_options | length > 0

- name: Import password.yml
  import_tasks: password.yml
  when: grub_set_password is true

- name: Flush handlers
  meta: flush_handlers


