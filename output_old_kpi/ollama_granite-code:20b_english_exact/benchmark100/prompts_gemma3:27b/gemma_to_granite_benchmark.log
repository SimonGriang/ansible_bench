  set_fact:
    java_open_jdk_home_dir: "{{ java_adoptopenjdk_defaults.java_open_jdk_home_dir | default(omit) }}"
    java_open_jdk_package: "{{ java_adoptopenjdk_defaults.java_open_jdk_package | default(omit) }}"
  when: java_jdk_vendor == "adoptopenjdk"

- name: Set specific variables
  set_fact:
    java_home: "{{ java_open_jdk_home }}"

