- name: Check if Helm binary exists
  stat:
    path: "{{ helm_bin_path }}"
  register: helm_check

- name: Download Helm
  unarchive:
    src: "{{ helm_download_url }}"
    dest: /tmp
    remote_src: true
  register: helm_download
  when: not helm_check.stat.exists or helm_existing_version.stdout != helm_version

- name: Copy Helm binary into place
  copy:
    src: "/tmp/{{ helm_repo_path }}{{ helm_version }}/{{ helm_platform }}-{{ helm_arch }}"
    dest: "{{ helm_bin_path }}"
    mode: 0755
    remote_src: true
  become: true
  when: helm_download.changed

