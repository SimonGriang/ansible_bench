    name: "{{ httpd_packages }}"
    state: present

- name: Task 3 - Configure selinux
  block:
    - seboolean:
        name: "{{ item }}"
        state: yes
        persistent: yes
      loop: "{{ httpd_seboolean }}"
    - seport:
        ports: "{{ item }}"
        state: present
        proto: tcp
      loop: "{{ httpd_seports }}"
  when: ansible_selinux.status == "enabled"

- name: Task 4 - Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    mode: 0644
  notify:
