      register: nodes_summary
      retries: 5
      until: nodes_summary is succeeded
      when: inventory_hostname == (groups[rke2_servers_group_name] | first)

- name: K8s nodes state
  hosts: "{{ rke2_servers_group_name }}"
  tasks:
    - name: Display Kubernetes node information
      debug:
        var: nodes_summary.stdout_lines


