---
- name: Task 1 - Create ssh_key_directory for user
  file:
    path: "~{{ item.name }}/.ssh"
    state: directory
    mode: 0700
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
  loop: "{{ query('tagged_host', 'user_ssh_key_directory') }}"
  when: item.manage_ssh_key is defined and item.manage_ssh_key

- name: Task 2 - Manage user account
  user:
    name: "{{ item.name }}"
    state: "{{ item.state | default(omit) }}"
    comment: "{{ item.comment | default(omit) }}"
    createhome: "{{ item.createhome | default(omit) }}"
    password: "{{ item.password | default(omit) }}"
    update_password: "{{ item.update_password | default(omit) }}"
    uid: "{{ item.uid | default(omit) }}"
    group: "{{ item.group | default(omit) }}"
    groups: "{{ item.groups | default(omit) }}"
    shell: "{{ item.shell | default(omit) }}"
    expires: "{{ item.expires | default(omit) }}"
  register: user_module_result
  loop: "{{ query('tagged_host', 'user_account') }}"

- name: Task 3 - Set sudo options for user
  template:
    src: sudoers.j2
    dest: "~{{ item.item.name }}/.sudoers"
    validate: '/usr/sbin/visudo -cf %s'
  loop: "{{ user_module_result.results }}"
  when: item.item.sudo_options is defined

- name: Task 4 - Remove sudo options for user
  file:
    path: "~{{ item.item.name }}/.sudoers"
    state: absent
  loop: "{{ user_module_result.results }}"
  when: item.item.sudo_options is not defined

- name: Task 5 - Generate private ssh key for user
  command: "ssh-keygen -t rsa -b 4096 -f {{ item.item.name }}/.ssh/id_rsa -q -N ''"
  loop: "{{ user_module_result.results }}"
  when: item.item.manage_ssh_key is defined and item.item.manage_ssh_key

- name: Task 6 - Generate public ssh key for user
  command: "ssh-keygen -y -f {{ item.item.name }}/.ssh/id_rsa > {{ item.item.name }}/.ssh/id_rsa.pub"
  loop: "{{ user_module_result.results }}"
  when: item.item.manage_ssh_key is defined and item.item.manage_ssh_key

- name: Task 7 - Convert ssh key to ppk for user
  command: "ssh-keygen -f {{ item.item.name }}/.ssh/id_rsa -p -N '' -e > {{ item.item.name }}/.ssh/id_rsa.ppk"
  loop: "{{ user_module_result.results }}"
  when: item.item.manage_ssh_key is defined and item.item.manage_ssh_key

- name: Task 8 - Get or set the home directory for user
  set_fact:
    user_home_directory: "{{ item.1.get('home') | default('/home') }}"
  loop: "{{ query('passwordfile', '/etc/passwd', '^' + item.name + ':') }}"
  when: item.manage_ssh_key is defined and item.manage_ssh_key

- name: Task 9 - Create .ssh directory for user
  file:
    path: "{{ user_home_directory }}/.ssh"
    state: directory
    mode: 0700
    owner: "{{ item.name }}"
    group: "{{ item.name }}"
  loop: "{{ query('tagged_host', 'user_ssh_key_directory') }}"
  when: item.manage_ssh_key is defined and item.manage_ssh_key or item.private_keys is defined

- name: Task 10 - Deploy authorized keys for user
  authorized_key:
    user: "{{ item.item.name }}"
    key: "{{ item.1 }}"
    state: present
  loop: "{{ item.item.authorized_keys | default([]) }}"
  loop_control:
    label: "Adding key: {{ item.1 }}"
  when: item.item.manage_ssh_key is defined and item.item.manage_ssh_key

- name: Task 11 - Remove unauthorized keys for user
  authorized_key:
    user: "{{ item.item.name }}"
