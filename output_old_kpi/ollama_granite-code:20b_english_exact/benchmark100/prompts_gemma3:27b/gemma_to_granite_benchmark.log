---

- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Task 2
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify: Set root password, Systemctl daemon-reexec

- name: Task 3
  template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: "/etc/mysql/{{ mysql_name }}/my.cnf"
    mode: 0644
  notify: Restart mysql server

- name: Task 4
  template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: "/etc/mysql/{{ mysql_name }}/my.cnf"
    mode: 0644

- name: Task 5
  command: "{{ mysql_initialize_command }}"
  when: ansible_os_family == 'Debian' or ansible_os_family == 'Archlinux'

- name: Task 6
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Task 7
  meta: flush_handlers

- name: Task 8
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Task 9
  mysql_db:
    name: "{{ item.name }}"
    state: present
    encoding: "{{ item.encoding | default(omit) }}"
    collation: "{{ item.collation | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_socket: "{{ mysql_socket }}"
  with_items: "{{ mysql_databases }}"

- name: Task 10
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    state: present
    host: "{{ item.host | default(omit) }}"
    priv: "{{ item.priv | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_socket: "{{ mysql_socket }}"
  with_items: "{{ mysql_users }}"

- name: Task 11
  meta: flush_handlers

