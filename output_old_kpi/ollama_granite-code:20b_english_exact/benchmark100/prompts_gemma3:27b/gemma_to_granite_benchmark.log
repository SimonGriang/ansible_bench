---
- name: Create document root directories for virtual hosts.
  ansible.builtin.file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: "0755"
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Creating docroot directory for {{ item.name }}"
  when:
    - httpd_vhosts is defined
    - item.documentroot is defined
    - item.create_docroot | default(true) | bool
  notify: Test httpd configuration validity

- name: Configure virtual hosts.
  ansible.builtin.template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
    mode: "0644"
  loop: "{{ httpd_vhosts }}"
  loop_control:
    label: "Configuring virtual host {{ item.name }}"
  notify: Restart httpd

