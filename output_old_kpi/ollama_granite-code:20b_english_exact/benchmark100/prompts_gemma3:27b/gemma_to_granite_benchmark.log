---
- name: Task 1 - Enable Apache modules
  become: true
  when: ansible_os_family == "Debian" or ansible_os_family == "Suse"
  ansible.builtin.apt:
    name: "{{ item }}"
    state: present
  with_items:
    - proxy_http
    - proxy
- name: Task 2 - Configure Apache locations
  become: true
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ httpd_config_directory }}/{{ item.name }}"
    mode: 0644
  with_items: "{{ httpd_locations }}"
  notify:
    - Test httpd configuration validity
    - Restart httpd

