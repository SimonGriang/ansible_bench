---
- name: "Import assert.yml"
  ansible.builtin.import_tasks: assert.yml
  run_once: yes
  delegate_to: localhost

- name: "Configure apk"
  block:
    - name: "Update apk cache"
      ansible.builtin.apk:
        update_cache: yes
        upgrade: safe
    - name: "Reboot after upgrade"
      ansible.builtin.reboot:
  when: ansible_pkg_mgr == "apk"
  ansible.builtin.notify: "Reboot"

- name: "Configure apt"
  block:
    - name: "Prevent package upgrades"
      ansible.builtin.dpkg_selections:
        name: "{{ update_excluded_packages }}"
        selection: hold
    - name: "Update apt cache"
      ansible.builtin.apt:
        update_cache: yes
        upgrade: safe
    - name: "Reboot after upgrade"
      ansible.builtin.reboot:
  when: ansible_pkg_mgr == "apt"
  ansible.builtin.notify: "Reboot"

- name: "Update all software (dnf)"
  ansible.builtin.yum:
    name: "*"
    state: latest
    exclude: "{{ update_excluded_packages }}"
  when: ansible_pkg_mgr == "dnf" or ansible_pkg_mgr == "dnf5"
  ansible.builtin.notify: "Reboot"

- name: "Update all software (pacman)"
  ansible.builtin.pacman:
    update_cache: yes
    upgrade: yes
  when: ansible_pkg_mgr == "pacman"
  ansible.builtin.notify: "Reboot"

- name: "Configure yum"
  block:
    - name: "Get yum version"
      ansible.builtin.shell: "yum --version |& grep 'yum' | awk '{print $1;}'"
      ansible.builtin.register: yum_version
    - name: "Set fact for yum_version"
      ansible.builtin.set_fact:
        yum_version: "{{ yum_version.stdout }}"
    - name: "Update yum cache"
      ansible.builtin.yum:
        update_cache: yes
        exclude: "{{ update_excluded_packages }}"
    - name: "Reboot after upgrade"
      ansible.builtin.reboot:
  when: ansible_pkg_mgr == "yum"
  ansible.builtin.notify: "Reboot"

- name: "Update all software (zypper)"
  community.general.zypper:
    name: "*"
    state: latest
  when: ansible_pkg_mgr == "zypper"
  ansible.builtin.notify: "Reboot"

