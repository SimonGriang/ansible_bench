d_duration': 44479721, 'prompt_eval_count': 854, 'prompt_eval_duration': 630381428, 'eval_count': 543, 'eval_duration': 12375295451, 'model_name': 'granite-code:20b'} id='run--071fadd3-0dbe-4550-8103-2f79c6c90329-0' usage_metadata={'input_tokens': 854, 'output_tokens': 543, 'total_tokens': 1397}
