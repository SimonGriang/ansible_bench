---
- name: Task 1 - Import assert.yml
  include_tasks: assert.yml

- name: Task 2 - Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present
  notify: Set root password, Systemctl daemon-reexec

- name: Task 3 - Configure mysql server
  template:
    src: "{{ mysql_name }}-server.cnf.j2"
    dest: "/etc/mysql/conf.d/{{ mysql_name }}-server.cnf"
    mode: 0644
    owner: root
    group: root
  register: mysql_server_configuration
  notify: Systemctl daemon-reexec

- name: Task 4 - Configure mysql client
  template:
    src: "{{ mysql_name }}-client.cnf.j2"
    dest: "/etc/mysql/conf.d/{{ mysql_name }}-client.cnf"
    mode: 0644
    owner: root
    group: root

- name: Task 5 - Initialize mysql
  command: "{{ mysql_initialize_command }}"
  args:
    creates: "{{ mysql_socket }}"
  when: ansible_os_family == "Debian"
  notify: Systemctl daemon-reexec

- name: Task 6 - Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    state: started
    enabled: true

- name: Task 7 - Flush handlers
  meta: flush_handlers

- name: Task 8 - Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    mode: 0640

- name: Task 9 - Create databases
  mysql_db:
    name: "{{ item.name }}"
    state: "{{ item.state | default(omit) }}"
    target: "{{ item.target | default(omit) }}"
    encoding: "{{ item.encoding | default(omit) }}"
    collation: "{{ item.collation | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket if mysql_use_socket else omit }}"
    login_port: "{{ mysql_port if not mysql_use_socket else omit }}"
  loop: "{{ mysql_databases }}"

- name: Task 10 - List databases
  mysql_info:
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket if mysql_use_socket else omit }}"
    login_port: "{{ mysql_port if not mysql_use_socket else omit }}"
  register: mysql_databases_list

- name: Task 11 - Import database
  mysql_db:
    name: "{{ item.name }}"
    state: import
    target: "{{ item.target }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket if mysql_use_socket else omit }}"
    login_port: "{{ mysql_port if not mysql_use_socket else omit }}"
  loop: "{{ mysql_databases }}"
  when: item.target is defined and item.name not in mysql_databases_list.databases

- name: Task 12 - Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password | default(omit) }}"
    priv: "{{ item.priv | default(omit) }}"
    host: "{{ item.host | default(omit) }}"
    state: "{{ item.state | default(omit) }}"
    login_user: root
    login_password: "{{ mysql_root_password }}"
    login_host: "{{ mysql_socket if mysql_use_socket else omit }}"
    login_port: "{{ mysql_port if not mysql_use_socket else omit }}"
  loop: "{{ mysql_users }}"

- name: Task 13 - Flush handlers again
  meta: flush_handlers

