---
- name: rke2-install
  become: true
  tasks:
  - name: Create the RKE2 config directory
    file:
      path: /etc/rancher/rke2
      state: directory
      mode: 0755
  - name: Set server taints
    set_fact:
      combined_node_taints: "{{ rke2_server_node_taints }}"
    when: rke2_type == "server"
  - name: Copy rke2 config
    template:
      src: rke2.yaml.j2
      dest: /etc/rancher/rke2/rke2.yaml
      owner: root
      group: root
      mode: 0644
    notify: Config file changed
  - name: Copy kubelet config
    template:
      src: kubelet.conf.j2
      dest: /etc/kubernetes/kubelet.conf
      owner: root
      group: root
      mode: 0644
    notify: Config file changed
    when: rke2_kubelet_config | length > 0
  - name: Copy Containerd Registry Configuration file
    template:
      src: registry.yaml.j2
      dest: /etc/rancher/rke2/registry.yaml
      owner: root
      group: root
      mode: 0644
    notify: Config file changed
    when: rke2_custom_registry_mirrors | length > 0 or rke2_custom_registry_configs | length > 0
  - name: Register if we need to do a etcd restore from file
    set_fact:
      do_etcd_restore: true
    when: rke2_etcd_snapshot_file is defined and rke2_type == "server" and rke2_etcd_snapshot_s3_options is not defined
  - name: Register if we need to do a etcd restore from s3
    set_fact:
      do_etcd_restore_from_s3: true
    when: rke2_etcd_snapshot_file is defined and rke2_type == "server" and rke2_etcd_snapshot_s3_options is defined and rke2_etcd_snapshot_s3_options.access_key | length > 0 and rke2_etcd_snapshot_s3_options.secret_key | length > 0 and rke2_etcd_snapshot_s3_options.bucket | length > 0
  - name: Restore etcd from file
    become: true
    command: >
      rke2
      --install-dir {{ rke2_install_dir }}
      --config {{ rke2_config_file }}
      --etcd-snapshot-restore
      --etcd-snapshot-path {{ rke2_etcd_snapshot_file }}
    async: 900
    poll: 0
    when: do_etcd_restore
  - name: Restore etcd from s3
    become: true
    command: >
      rke2
      --install-dir {{ rke2_install_dir }}
      --config {{ rke2_config_file }}
      --etcd-snapshot-restore
      --s3-endpoint {{ rke2_etcd_snapshot_s3_options.endpoint }}
      --s3-access-key {{ rke2_etcd_snapshot_s3_options.access_key }}
      --s3-secret-key {{ rke2_etcd_snapshot_s3_options.secret_key }}
      --s3-bucket {{ rke2_etcd_snapshot_s3_options.bucket }}
      --s3-region {{ rke2_etcd_snapshot_s3_options.region }}
      --s3-skip-ssl-verify {{ rke2_etcd_snapshot_s3_options.skip_ssl_verify | default('false') }}
      --s3-object-name {{ rke2_etcd_snapshot_s3_options.object_name }}
    async: 900
    poll: 0
    when: do_etcd_restore_from_s3
  - name: Start RKE2 service on the first server
    systemd:
      name: rke2-server.service
      state: started
      enabled: true
      daemon_reload: true
      env:
        RKE2_TOKEN: "{{ rke2_token }}"
    notify: Service (re)started
  - name: Mask RKE2 agent service on the first server
    systemd:
      name: rke2-agent.service
      state: stopped
      enabled: false
      daemon_reload: true
  - name: Wait for the first server be ready - no CNI
    command: >
      kubectl get node {{ inventory_hostname }}
      --kubeconfig /etc/kubernetes/admin.conf
    register: command_result
    until: command_result.stdout | length > 0 and ('Ready' in command_result.stdout or 'taints' in command_result.stdout)
    retries: 36
    delay: 10
    when: rke2_cni == "none"
  - name: Wait for the first server be ready - with CNI
    command: >
      kubectl get node {{ inventory_hostname }}
      --kubeconfig /etc/kubernetes/admin.conf
    register: command_result
    until: command_result.stdout | length > 0 and 'Ready' in command_result.stdout
    retries: 36
    delay: 10
    when: rke2_cni != "none"
  - name: Restore etcd
    delegate_to: "{{ item }}"
    run_once: true
    run_once_delay: 30
    run_once_start_parameter: 1
    with_items: "{{ groups[rke2_cluster_group_name] }}"
    when: do_etcd_restore or do_etcd_restore_from_s3
  - name: Set an Active Server variable
    delegate_to: "{{ item }}"
    run_once: true
    run_once_delay: 30
    run_once_start_parameter: 1
    with_items: "{{ groups[rke2_cluster_group_name] }}"
    when: rke2_type == "server"
- name: rke2-postinstall
  become: true
  tasks:
  - name: Set an Active Server variable
    delegate_to: "{{ item }}"
    run_once: true
    run_once_delay: 30
    run_once_start_parameter: 1
    with_items: "{{ groups[rke2_cluster_group_name] }}"
    when: rke2_type == "server"

