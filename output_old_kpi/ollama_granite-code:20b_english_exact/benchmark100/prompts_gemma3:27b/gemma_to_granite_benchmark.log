---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Install required software
  package:
    name: "{{ users_requirements }}"
    state: present
  register: install_packages
  until: install_packages is succeeded
  retries: 5
  delay: 2
  when:
    - users_requirements is defined
    - users_requirements | length > 0

- name: Loop over users_groups
  include_tasks: group.yml
  loop: "{{ users_groups }}"
  loop_control:
    label: "{{ item.name }}"
  when: users_groups is defined

- name: Ensure /etc/sudoers.d directory is included
  lineinfile:
    path: /etc/sudoers
    line: "#includedir {{ users_sudo_includedir }}"
    state: present
    validate: '/usr/sbin/visudo -cf %s'
  register: includedir

- name: Loop over users
  include_tasks: user.yml
  loop: "{{ users }}"
  loop_control:
    label: "{{ item.name }}"
  when: users is defined

- name: Manage cron permission
  template:
    src: cron.allow.j2
    dest: /etc/cron.allow
    mode: 0644
  when: users_cron_allow | bool

- name: Check existence of /etc/cron.allow
  file:
    path: /etc/cron.allow
    state: absent
  when: not users_cron_allow | bool

