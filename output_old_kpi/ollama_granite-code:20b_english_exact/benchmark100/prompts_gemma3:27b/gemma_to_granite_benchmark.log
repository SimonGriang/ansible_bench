---
- name: lookup bootstrap facts
  ansible.builtin.raw:
    whoami: root
  register: bootstrap_facts
  changed_when: false

- name: set bootstrap facts
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ bootstrap__os_family_map[item.key] }}"
    bootstrap_distribution_major_version: "{{ item.value.version | regex_search('([0-9]+\\.)+[0-9]+') }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when:
  - bootstrap_facts.rc == 0
  - bootstrap_distribution is not defined
  - "'{{ item.value.pretty_name }}' in bootstrap_facts.stdout_lines[0]"
  become: "{{ bootstrap_become | default(omit) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"

- name: set bootstrap facts
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap__os_family_map | dict2items }}"
  when:
  - bootstrap_distribution is defined
  - bootstrap_distribution in item.value.distribution
  become: "{{ bootstrap_become | default(omit) }}"
  become_user: "{{ bootstrap_become_user | default(omit) }}"

