---
- name: Check Java Certificate Existence
  stat:
    path: "{{ item.path }}"
  register: check_java_certs
  with_items: "{{ java_certs }}"

- name: Fail if Java Certificate Doesn't Exist
  fail:
    msg: "Java certificate doesn't exist"
  when: not item.stat.exists
  with_items: "{{ check_java_certs.results }}"

- name: Set Keystore Directory for Java < 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_old }}"
  when: java_keystore_dir is not defined or java_keystore_dir is none
  vars:
    java_keystore_dir_old: "{{ java_open_jdk_home }}/jre/lib/security"
  when: java_open_jdk_version_major < 11

- name: Set Keystore Directory for Java >= 11
  set_fact:
    java_keystore_dir: "{{ java_keystore_dir_new }}"
  when: java_keystore_dir is not defined or java_keystore_dir is none
  vars:
    java_keystore_dir_new: "{{ java_open_jdk_home }}/lib/security"
  when: java_open_jdk_version_major >= 11

- name: Import SSL Certificates into Java Keystore
  java_cert:
    cert_path: "{{ item.path }}"
    name: "{{ item.alias }}"
    keystore_path: "{{ java_open_jdk_home }}/jre/lib/security/java.keystore"
    state: present
    keystore_password: "{{ java_cert_keystore_pass }}"
    alias: "{{ item.alias }}"
  with_items: "{{ java_certs }}"

