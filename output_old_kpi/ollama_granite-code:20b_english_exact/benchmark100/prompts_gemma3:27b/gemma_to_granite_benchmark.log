      block:
        - name: Download artifacts and checksums
          get_url:
            url: https://example.com/rke2-artifacts.tar.gz
            dest: /tmp/rke2-artifacts.tar.gz
        - name: Copy artifacts to remote
          copy:
            src: /tmp/rke2-artifacts.tar.gz
            dest: /var/lib/rke2/agent/artifacts
      rescue:
        - name: Download local artifacts
          copy:
            src: /path/to/local/rke2-artifacts.tar.gz
            dest: /tmp/rke2-artifacts.tar.gz
        - name: Copy local artifacts to remote
          copy:
            src: /tmp/rke2-artifacts.tar.gz
            dest: /var/lib/rke2/agent/artifacts

    - name: Copy local RKE2 artifacts
      copy:
        src: /path/to/local/rke2-artifacts/
        dest: /var/lib/rke2/agent/artifacts
      when: airgap_mode == true and implementation == "copy"

    - name: Copy additional tarball images for RKE2 components
      copy:
        src: /path/to/additional/images.tar.gz
        dest: /var/lib/rke2/agent/images/
      when: airgap_mode == true and additional_images is defined

    - name: Ensure RKE2 artifacts exist and have appropriate permissions
      file:
        path: "{{ item }}"
        mode: 0644
      loop:
        - /var/lib/rke2/agent/artifacts
        - /var/lib/rke2/agent/artifacts/rke2-images.tar.gz
        - /var/lib/rke2/agent/artifacts/rke2-linux-amd64-bin-v1.21.10-rke2.tar.gz
      when: airgap_mode == true

    - name: Populate service facts
      service_facts:

    - name: Get stats of the FS object
      stat:
        path: /usr/local
      register: local_fs_stats

    - name: Check if separate partition
      set_fact:
        separate_partition: "{{ local_fs_stats.stat.mount }}"
      when: local_fs_stats.stat.exists

    - name: Set RKE2 bin path
      set_fact:
        rke2_bin_path: "{{ '/usr/local/bin/rke2' if separate_partition is undefined else '/bin/rke2' }}"

    - name: Check RKE2 version
      command: "{{ rke2_bin_path }} version"
      register: rke2_version_result
      changed_when: false

    - name: Set RKE2 versions
      set_fact:
        installed_rke2_version: "{{ rke2_version_result.stdout_lines[0] }}"
        running_rke2_version: "{{ rke2_version_result.stdout_lines[1] }}"

    - name: Prevent accidental RKE2 downgrade
      assert:
        that: "installed_rke2_version == running_rke2_version or allow_downgrade"
        msg: "Downgrades are not allowed"

    - name: Run RKE2 install script
      command: "{{ rke2_bin_path }} install --insecure-options=all"
      environment:
        INSTALL_RKE2_TYPE: "agent"

    - name: Copy Custom Manifests
      copy:
        src: "{{ item }}"
        dest: /var/lib/rke2/agent/etc/kubernetes/manifests/
      with_fileglob:
        - ../manifests/*.yaml
      when: custom_manifests is defined

    - name: Copy Static Pods
      copy:
        src: "{{ item }}"
        dest: /etc/kubernetes/manifests/
      with_fileglob:
        - ../manifests/*.yaml
      when: static_pods is defined

    - name: Copy RKE2 environment file
      template:
        src: rke2-env.j2
        dest: /var/lib/rke2/agent/etc/rke2/rke2-env.sh
      when: rke2_env_file is defined

