---
- include_tasks: assert.yml
- name: Install requirements
  package:
    name: bash
    state: present
- block:
    - name: Install openjdk java (package)
      package:
        name: "{{ java_package_name }}"
        state: present
      environment:
        USE: "{{ java_package_use }}"
    - name: Set java_home
      alternatives:
        name: java
        link: /usr/bin/java
        path: "{{ java_package_java_home }}"
  when: java_vendor == "openjdk"
- block:
    - name: Install RPM
      copy:
        src: "{{ java_local_path }}"
        dest: /tmp/{{ java_local_filename }}
        mode: 0644
    - name: Install local Oracle Java RPM package
      package:
        name: /tmp/{{ java_local_filename }}
        state: present
  when: java_source == "local" and java_format == "rpm"
- block:
    - name: Install DEB
      copy:
        src: "{{ java_local_path }}"
        dest: /tmp/{{ java_local_filename }}
        mode: 0644
    - name: Install local Oracle Java DEB package
      package:
        name: /tmp/{{ java_local_filename }}
        state: present
  when: java_source == "local" and java_format == "deb"
- block:
    - name: Install Oracle Java (rpm) (repository)
      package:
        name: "{{ java_package_name }}"
        state: present
  when: java_source == "repository" and java_format == "rpm"
- block:
    - name: Configure oracle targz
      unarchive:
        src: "{{ java_local_path }}"
        dest: "{{ java_download_path }}"
        copy: no
      when: java_download_path != java_install_path
    - name: Install oracle java (targz)
      unarchive:
        src: "{{ java_local_path }}"
        dest: "{{ java_install_path }}"
        copy: no
      when: java_download_path == java_install_path
    - name: Install oracle java policy software (targz)
      unarchive:
        src: "{{ java_jce_local_path }}"
        dest: "{{ java_install_path }}/jre/lib/security"
        copy: no
      when: java_jce is true and java_version == "8" and java_vendor == "oracle"
    - name: Set alternative (targz)
      alternatives:
        name: java
        link: /usr/bin/java
        path: "{{ java_install_path }}/bin/java"
      when: java_format == "targz" and ansible_distribution != "Alpine" and java_vendor == "oracle"
  when: java_format == "targz" and java_vendor == "oracle"
- block:
    - name: Find JAVA_HOME
      command: readlink -f /usr/bin/java
      register: java_bin_path
    - name: Set JAVA_HOME
      lineinfile:
        path: /etc/profile.d/java_home.sh
        line: export JAVA_HOME="$(dirname {{ java_bin_path.stdout }})/.."
        create: yes
        mode: 0644
  when: java_format == "rpm" or java_format == "deb"


