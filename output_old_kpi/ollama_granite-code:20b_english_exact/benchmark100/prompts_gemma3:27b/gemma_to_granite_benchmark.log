---
- name: Check OS compatibility
  hosts: all
  tasks:
    - name: Verify if the system is Amazon Linux 2 or a RedHat-based distribution with major version 7, 8, or 9.
      assert:
        that:
          - (ansible_distribution == "Amazon" and ansible_distribution_major_version == "2") or
            (ansible_os_family == "RedHat" and ansible_distribution_major_version in ["7", "8", "9"])
        success_msg: "OS is compatible"
        fail_msg: "OS is not compatible"

- name: Install epel gpg key
  hosts: all
  tasks:
    - name: Install the EPEL GPG key
      ansible.builtin.get_url:
        url: "{{ epel_gpg_key }}"
        dest: /etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-{{ epel_gpg_key_id }}
        mode: 0644
      when: ansible_os_family == "RedHat"

- name: Install epel-release package
  hosts: all
  tasks:
    - name: Install the epel-release package
      ansible.builtin.package:
        name: epel-release
        state: present
      when: ansible_os_family == "RedHat"
    - name: Notify the handler Update package cache after installation
      ansible.builtin.meta:
        trigger_handlers:
          - Update package cache

- name: Install epel-next-release package
  hosts: all
  tasks:
    - name: Install the epel-next-release package
      ansible.builtin.package:
        name: epel-next-release
        state: present
      when: ansible_os_family == "RedHat" and epel_next
    - name: Notify the handler Update package cache after installation
      ansible.builtin.meta:
        trigger_handlers:
          - Update package cache


