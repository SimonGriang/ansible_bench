---
- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2 - Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Task 3 - Configure shell
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: "^SHELL="
    line: "SHELL={{ cron_shell }}"
    create: true
    mode: "0600"
    notify: Restart cron

- name: Task 4 - Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: "^PATH="
    line: "PATH={{ cron_path }}"
    create: true
    mode: "0600"
    notify: Restart cron

- name: Task 5 - Configure mailto
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: "^MAILTO="
    line: "MAILTO={{ cron_mailto }}"
    create: true
    mode: "0600"
    notify: Restart cron

- name: Task 6 - Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: true
  when: cron_service | length > 0

- name: Task 7 - Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default(omit) }}"
    hour: "{{ item.hour | default(omit) }}"
    day: "{{ item.day | default(omit) }}"
    month: "{{ item.month | default(omit) }}"
    weekday: "{{ item.weekday | default(omit) }}"
    special_time: "{{ item.special_time | default(omit) }}"
    job: "{{ item.job }}"
    state: "{{ item.state | default(omit) }}"
    user: "{{ item.user | default(omit) }}"
  loop: "{{ cron_jobs }}"
  loop_control:
    label: "{{ item.name }}"
  when: cron_jobs is defined

