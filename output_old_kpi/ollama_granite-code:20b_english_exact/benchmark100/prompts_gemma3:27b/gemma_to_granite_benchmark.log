    - name: strict noexec flag
      command: setenforce 0
      when: ansible_selinux.status == "enabled"

    - name: Install SELinux policy
      package:
        name: selinux-policy
        state: present
      when: ansible_selinux.status == "enabled"

    - name: Set SELinux policy to targeted enforcing
      command: selinuxpolicy --set-policy targeted
      when: ansible_selinux.status == "enabled"

    - name: Install AppArmor package
      package:
        name: apparmor
        state: present
      when: ansible_apparmor.status == "enabled"

    - name: Unload AppArmor profiles
      command: aa-disable {{ item }}
      loop: "{{ ansible_apparmor.profiles }}"
      when: ansible_apparmor.status == "enabled"

    - name: Remove AppArmor package
      package:
        name: apparmor
        state: absent
      when: ansible_apparmor.status == "enabled"

    - name: Disable SELinux
      command: setenforce 0
      when: ansible_selinux.status == "enabled"

