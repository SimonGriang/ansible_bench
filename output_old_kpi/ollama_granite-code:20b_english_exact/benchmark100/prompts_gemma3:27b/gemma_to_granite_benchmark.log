    - ansible_os_family == "Debian"

- name: Install extra apt tools
  apt:
    name: "{{ item }}"
    state: present
  loop: "{{ java_open_jdk_apt_extra_packages }}"
  when:
    - java_jdk_vendor == "adoptopenjdk"
    - ansible_os_family == "Debian"

- name: Add required key repositories
  apt_key:
    url: "{{ item }}"
    state: present
  loop: "{{ java_required_key_repositories_openjdk }}"
  when:
