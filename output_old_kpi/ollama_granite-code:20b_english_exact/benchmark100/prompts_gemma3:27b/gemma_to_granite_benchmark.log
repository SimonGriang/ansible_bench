---
- name: Bootstrap | Gather bootstrap facts
  ansible.builtin.raw: uname -a
  register: bootstrap_facts
  changed_when: false
  when: bootstrap_facts is not defined
  tags: bootstrap_facts

- name: Bootstrap | Set bootstrap facts (I)
  ansible.builtin.set_fact:
    bootstrap_distribution: "{{ item.key }}"
    bootstrap_distribution_major_version: "{{ item.value }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"
  when:
    - bootstrap_facts.rc == 0
    - bootstrap_distribution is not defined
    - "'{{ item.key }}' in bootstrap_facts.stdout"
  tags: bootstrap_facts

- name: Bootstrap | Set bootstrap facts (II)
  ansible.builtin.set_fact:
    bootstrap_os_family: "{{ item.key }}"
  loop: "{{ bootstrap_os_family_map | dict2items }}"
  loop_control:
    label: "{{ item.key }}"
  when: "'{{ bootstrap_distribution }}' in {{ item.value }}"
  tags: bootstrap_facts

