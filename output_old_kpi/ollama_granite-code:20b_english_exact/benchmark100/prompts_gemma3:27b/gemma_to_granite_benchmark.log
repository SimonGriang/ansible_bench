---
- name: Run RKE2 Playbook
  hosts: localhost
  tasks:
    - include_tasks: tasks/keepalived.yml
      when: ha_mode and rke2_servers_group_name in group_names and rke2_api_ip is defined
    - include_tasks: tasks/rke2.yml
    - include_tasks: tasks/cis.yml
      when: rke2_cis_profile is defined and rke2_cis_profile | length > 0
    - include_tasks: tasks/find_active_server.yml
    - include_tasks: tasks/ip_vs.yml
      when: ipvs_mode and rke2_servers_group_name in group_names and ha_mode and "keepalived" not in rke2_calico_ `__variable`
    - include_tasks: tasks/kubevip.yml
      when: ha_mode and kubevip_mode and "keepalived" not in rke2_calico_ `__variable`
    - include_tasks: tasks/ingress-nginx.yml
      when: rke2_ingress_nginx_values is defined and rke2_ingress_nginx_values | length > 0
    - include_tasks: tasks/first_server.yml
      when: rke2_servers_group_name in group_names and (active_server is not defined or (rke2_servers_group_name | length == 1))
    - include_tasks: tasks/first_server_restore.yml
      when: active_server is defined and (rke2_servers_group_name in group_names and (rke2_cluster_group_name | length > 1)) and (do_etcd_restore or do_etcd_restore_from_s3 is defined)
    - include_tasks: tasks/download_kubeconfig.yaml
      when: rke2_download_kubeconf and rke2_servers_group_name in group_names
    - include_tasks: tasks/remaining_nodes.yml
      when: active_server is defined and rke2_cluster_group_name | length > 1
    - name: Rolling cordon and drain restart on servers
      include_tasks: tasks/rolling_restart.yml
      loop: "{{ groups[rke2_servers_group_name] }}"
      loop_control:
        loop_var: inventory_hostname
      when: installed_version is defined and installed_version != rke2_version and rke2_servers_group_name in group_names
    - name: Rolling cordon and drain restart on agents
      include_tasks: tasks/rolling_restart.yml
      loop: "{{ groups[rke2_agents_group_name] }}"
      loop_control:
        loop_var: inventory_hostname
      when: installed_version is defined and installed_version != rke2_version and rke2_servers_group_name not in group_names
    - name: Flush handlers
      meta: flush_handlers
    - include_tasks: tasks/rolling_restart.yml
      loop: "{{ groups[rke2_cluster_group_name] }}"
      loop_control:
        loop_var: inventory_hostname
      when: rke2_restart_needed
    - include_tasks: tasks/summary.yml

