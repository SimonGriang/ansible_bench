    name: "{{ selinux_requirements }}"
    state: present
  notify: Gather facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  selinux:
    state: "{{ selinux_state }}"
    policy: "{{ selinux_policy }}"
  when:
  - ansible_selinux.status != 'disabled'
  - not (ansible_virtualization_type is defined and ansible_virtualization_type == "docker")
  notify: Reboot

- name: Manage selinux booleans
  selinux:
    name: "{{ item.name }}"
    state: "{{ item.state | default('yes') }}"
    persistent: "{{ item.persistent | default(omit) }}"
  loop: "{{ selinux_booleans }}"
  loop_control:
    label: "{{ item.name }}"
  when: selinux_booleans is defined

