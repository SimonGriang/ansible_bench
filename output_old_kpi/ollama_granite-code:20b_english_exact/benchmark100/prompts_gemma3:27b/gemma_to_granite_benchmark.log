---
- name: "CIS - 2.2.1 - Ensure etcd group is created"
  ansible.builtin.group:
    name: etcd
    state: present

- name: "CIS - 2.2.2 - Ensure etcd user is created"
  ansible.builtin.user:
    name: etcd
    group: etcd
    shell: /bin/nologin
    comment: etcd user
    state: present

- name: "CIS - 2.2.3 - Ensure /etc/sysctl.d/60-rke2-cis.conf is configured"
  ansible.builtin.copy:
    src: "{{ '/usr/local/share/rke2/rke2-cis-sysctl.conf' if (ansible_local.system.partition_result.rc == 0 and ansible_local.system.is_writeable_usr_local_share_rke2.rc == 0) else '/usr/share/rke2/rke2-cis-sysctl.conf' }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: 0600
    remote_src: true
  notify: "Restart systemd-sysctl"

- name: "CIS - 2.2.4 - Ensure sysctl flush all is executed"
  ansible.builtin.meta: flush_handlers

