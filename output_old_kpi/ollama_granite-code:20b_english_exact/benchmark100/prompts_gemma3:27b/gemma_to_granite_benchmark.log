content='---\n- name: Remove old Docker packages\n  yum:\n    name: "{{ docker_obsolete_packages }}"\n    state: absent\n\n- name: Add Docker GPG key\n  rpm_key:\n    key: "{{ docker_yum_gpg_key }}"\n    state: present\n  when: docker_add_repo\n\n- name: Add Docker repository\n  copy:\n    src: "{{ docker_yum_repo_url }}"\n    dest: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    owner: root\n    group: root\n    mode: 0644\n  when: docker_add_repo\n\n- name: Configure Docker Nightly repo\n  ini_file:\n    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    section: "docker-{{ docker_edition }}-nightly"\n    option: enabled\n    value: "{{ docker_yum_repo_enable_nightly }}"\n    mode: 0644\n    no_extra_spaces: yes\n  when: docker_add_repo\n\n- name: Configure Docker Test repo\n  ini_file:\n    path: "/etc/yum.repos.d/docker-{{ docker_edition }}.repo"\n    section: "docker-{{ docker_edition }}-test"\n    option: enabled\n    value: "{{ docker_yum_repo_enable_test }}"\n    mode: 0644\n    no_extra_spaces: yes\n  when: docker_add_repo\n\n- block:\n  - name: Ensure runc is uninstalled\n    yum:\n      name: runc\n      state: absent\n\n  - name: Ensure container-selinux is installed\n    yum:\n      name: container-selinux\n      state: present\n\n  - name: Ensure containerd.io is installed\n    yum:\n      name: containerd.io\n      state: present\n  when: ansible_facts.distribution_major_version == 8\n...' additional_kwargs={} response_metadata={'model': 'granite-code:20b', 'created_at': '2025-10-07T05:46:26.95626398Z', 'done': True, 'done_reason': 'stop', 'total_duration': 10754700712, 'load_duration': 40529846, 'prompt_eval_count': 726, 'prompt_eval_duration': 692747520, 'eval_count': 410, 'eval_duration': 10019878114, 'model_name': 'granite-code:20b'} id='run--62188f96-4767-46e2-a6f7-476585a2dac0-0' usage_metadata={'input_tokens': 726, 'output_tokens': 410, 'total_tokens': 1136}
