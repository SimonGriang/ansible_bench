---

- name: Task 1 - Import assert.yml
  import_tasks: assert.yml
  delegate_to: localhost

- name: Task 2 - Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Task 3 - Create directories
  file:
    path: "{{ item }}"
    state: directory
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: "{{ dns_dirmode }}"
  loop:
    - "{{ dns_datadir }}"
    - "{{ dns_confdir }}"

- name: Task 4 - Create group
  group:
    name: "{{ dns_group }}"
    state: present

- name: Task 5 - Create user
  user:
    name: "{{ dns_owner }}"
    system: true
    state: present

- name: Task 6 - Generate rndc key
  command: rndc-confgen -a
  args:
    creates: "{{ dns_confdir }}/rndc.key"
  notify: Rndc reload

- name: Task 7 - Set permissions on rndc key file
  file:
    path: "{{ dns_confdir }}/rndc.key"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0640

- name: Task 8 - Get the hints/root file
  get_url:
    url: "{{ dns_root_hints }}"
    dest: "{{ dns_datadir }}/root.hints"
    mode: 0644
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
  when: dns_caching_dns
  notify: Rndc reload

- name: Task 9 - Create zone file
  template:
    src: zone.j2
    dest: "{{ dns_datadir }}/{{ item.name }}.zone"
    owner: "{{ dns_owner }}"
    group: "{{ dns_group }}"
    mode: 0644
  loop: "{{ dns_zones }}"
  notify: Rndc reload

- name: Task 10 - Add zones to configuration
  template:
    src: named.conf.j2
    dest: "{{ dns_confdir }}/named.conf"
    validate: named-checkconf -z -o named.conf.signed -d {{ dns_datadir }} %s
    backup: yes
  notify: Restart dns

- name: Task 11 - Place systemd override
  block:
    - name: Create systemd override directory
      file:
        path: /etc/systemd/system/dns.service.d
        state: directory
        owner: root
        group: root
        mode: 0755

    - name: Place override configuration
      template:
        src: override.conf.j2
        dest: /etc/systemd/system/dns.service.d/override.conf
        owner: root
        group: root
        mode: 0644
      notify: reload systemd
  when: ansible_service_mgr == "systemd"

- name: Task 12 - Start and enable dns
  service:
    name: "{{ dns_service }}"
    state: started
    enabled: true

