    regexp: "^SHELL="
    line: "SHELL={{ cron_shell }}"
    create: true
    mode: "0600"
    notify: Restart cron

- name: Task 4 - Configure path
  lineinfile:
    path: "{{ cron_configuration }}"
    regexp: "^PATH="
    line: "PATH={{ cron_path }}"
