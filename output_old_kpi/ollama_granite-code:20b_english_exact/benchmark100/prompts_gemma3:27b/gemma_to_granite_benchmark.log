  ignore_errors: "{{ ansible_check_mode }}"

- name: Ensure handlers are notified now to avoid firewall conflicts
  meta: flush_handlers

- name: Include docker-compose tasks
  include: docker-compose.yml
  when: docker_install_compose

- name: Get docker group info using getent
  getent:
    database: group
    key: docker

- name: Check if there are any users to add to the docker group
  set_fact:
    at_least_one_user_to_modify: "{{ True if docker_users | difference(getent_group_docker.keys()) | list | length > 0 else False }}"
  when:
    - docker_users is defined
    - getent_group_docker is defined

- name: Include docker-users tasks
  include: docker-users.yml
  when:
    - docker_users is defined
    - getent_group_docker is defined
    - at_least_one_user_to_modify is defined
    - at_least_one_user_to_modify

