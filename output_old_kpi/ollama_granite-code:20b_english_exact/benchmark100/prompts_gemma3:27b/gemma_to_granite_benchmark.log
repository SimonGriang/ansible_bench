---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for port to become available
  wait_for:
    port: "{{ ansible_port | default(22) }}"
    timeout: "{{ bootstrap_timeout }}"
  delegate_to: localhost
  when:
  - ansible_connection is defined
  - not ansible_connection.startswith('container')
  - bootstrap_wait_for_host

- name: Prepare system
  block:
  - name: Test connection
    ping:
  - name: Verify sudo access
    command: sudo -v
    changed_when: false
  rescue:
  - name: Gather bootstrap facts
    setup:
  - name: Install bootstrap packages
    package:
      name: "{{ bootstrap_facts_packages | split(',') }}"
      state: present
    become: "{{ bootstrap_become }}"

- name: Gather ansible facts
  setup:
  become: no

- name: Install bootstrap packages
  package:
    name: "{{ bootstrap_facts_packages | split(',') }}"
    state: present
  become: "{{ bootstrap_become }}"

