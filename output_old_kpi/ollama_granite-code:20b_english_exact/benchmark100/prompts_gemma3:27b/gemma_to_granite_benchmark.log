---

- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost

- name: Wait for host to be reachable
  wait_for:
    port: "{{ bootstrap_port | default(22) }}"
    host: "{{ hostvars[inventory_hostname]['ansible_ssh_host'] | default(hostvars[inventory_hostname]['ansible_host'] | default(inventory_hostname)) }}"
    timeout: "{{ bootstrap_timeout }}"
  connection: local
  become: "{{ bootstrap_become | default(omit) }}"
  when: "ansible_connection != 'container/docker' and bootstrap_wait_for_host"

- block:

  - name: Test connection
    wait_for_connection:
      timeout: "{{ bootstrap_timeout }}"
    register: bootstrap_connect

  - name: Debug timeout
    debug:
      var: bootstrap_timeout
    when: not bootstrap_connect. rescue_error

  - include_tasks: gather_facts.yml

  when: bootstrap_connect.rescue_error is defined

- name: Install bootstrap packages
  raw: "{{ bootstrap_install_packages }}"
  changed_when: >
    (bootstrap_install_packages.stdout is defined and
    ((bootstrap_os == 'alpine' and
    bootstrap_install_packages.stdout is match('^stderr:.*')) or
    (bootstrap_os == 'archlinux' and
    bootstrap_install_packages.stdout is match('^stderr:.*')) or
    (bootstrap_os == 'gentoo' and
    bootstrap_install_packages.stdout is match('^stderr:.*')) or
    (bootstrap_os == 'debian' and
    bootstrap_install_packages.stdout is not match('^stderr:.*')) or
    (bootstrap_os == 'redhat' and
    bootstrap_install_packages.stdout is not match('^stderr:.*')) or
    (bootstrap_os == 'rocky' and
    bootstrap_install_packages.stdout is not match('^stderr:.*')) or
    (bootstrap_os == 'suse' and
    bootstrap_install_packages.stdout is not match('^stderr:.*'))))
  args:
    executable: /bin/sh
  become_user: "{{ bootstrap_user }}"
  environment: "{{ bootstrap_environment }}"
  register: bootstrap_install_packages
  no_log: "{{ bootstrap_no_log | default(True) }}"
  become: "{{ bootstrap_become | default(omit) }}"

- block:

  - include_tasks: gather_facts.yml

  - name: Install packages
    package:
      name: "{{ bootstrap__facts_packages }}"
      state: present
      update_cache: yes
    become: "{{ bootstrap_become | default(omit) }}"

  when: bootstrap__facts_packages is defined


