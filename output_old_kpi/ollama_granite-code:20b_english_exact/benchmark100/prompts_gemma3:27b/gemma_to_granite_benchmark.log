---
- import_tasks: assert.yml
  run_once: true
  delegate_to: localhost
- name: Install git
  package:
    name: "{{ git_packages }}"
    state: present
- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_username }}"
  failed_when: fail_key | default(true) and getent_passwd.{{ git_username }} is not defined
- name: Create directory for git configuration
  file:
    path: "/home/{{ git_username }}/.config"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0755"
    state: directory
- name: Place git configuration
  template:
    src: gitconfig.j2
    dest: "/home/{{ git_username }}/.gitconfig"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0644"
- name: Create repository_destination
  file:
    path: "{{ git_repository_destination }}"
    owner: "{{ git_username }}"
    group: "{{ git_username }}"
    mode: "0755"
    state: directory
- name: Clone all roles
  git:
    repo: "{{ item.url }}"
    dest: "{{ git_repository_destination }}/{{ item.name }}"
    version: "{{ item.version | defaultomit }}"
    force: "{{ item.force | defaultomit }}"
  become_user: "{{ git_username }}"
  loop: "{{ git_repositories }}"
  loop_control:
    label: "Cloning {{ item.name }} to {{ git_repository_destination }}/{{ item.name }}"

