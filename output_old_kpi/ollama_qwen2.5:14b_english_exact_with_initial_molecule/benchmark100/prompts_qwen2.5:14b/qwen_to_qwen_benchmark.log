---
- name: Create the RKE2 config directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  when: rke2_type == 'server'
  k8s_raw_fact:
    api_version: node.k8s.io/v1
    kind: Node
    path: spec.taints
    value: '[{"key": "node-role.kubernetes.io/control-plane", "value": "true", "effect": "NoSchedule"}]'

- name: Set agent taints
  when: rke2_type == 'agent'
  k8s_raw_fact:
    api_version: node.k8s.io/v1
    kind: Node
    path: spec.taints
    value: '[{"key": "node-role.kubernetes.io/worker", "value": "true", "effect": "NoSchedule"}]'

- name: Copy RKE2 config file
  copy:
    src: rke2-config.yaml
    dest: /etc/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: restart_rke2

- name: Copy kubelet config file
  when: kubelet_config is defined and kubelet_config != ''
  copy:
    src: kubelet-config.yaml
    dest: /etc/rke2/kubelet-config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: restart_rke2

- name: Copy Containerd Registry Configuration file
  when: containerd_registry is defined and containerd_registry != ''
  copy:
    src: containerd-registry-config.toml
    dest: /etc/rke2/agent/containerd-registry-config.toml
    owner: root
    group: root
    mode: '0644'
  notify: restart_rke2

- name: Start RKE2 service
  systemd:
    name: rke2-server
    state: started
    enabled: yes
    masked: no
  register: start_rke2_result
  until: start_rke2_result.is_ok
  retries: 10
  delay: 10
  notify: restart_rke2

- name: Mask other RKE2 services
  when: rke2_type == 'server'
  systemd:
    name: rke2-agent
    state: masked
    enabled: no
    daemon_reload: yes

- name: Wait for remaining nodes to be ready - no CNI
  wait_for:
    path: /var/lib/rancher/rke2/agent/kubelet.conf
    sleep: 10
    timeout: 300

- name: Wait for remaining nodes to be ready - with CNI
  wait_for:
    path: /run/flannel/subnet.env
    sleep: 10
    timeout: 300


