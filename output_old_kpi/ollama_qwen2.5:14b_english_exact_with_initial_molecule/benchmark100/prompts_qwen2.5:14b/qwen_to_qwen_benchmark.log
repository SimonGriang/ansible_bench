    content: |
      /var/log/cron/cron.log {
        daily
        missingok
        rotate 7
        compress
        delaycompress
        missingok
        notifempty
      }
    mode: '0644'
  when: cron_service is defined and cron_service != ""
  notify: restart cron

- name: Ensure cron log rotation is enabled
  systemd:
    name: logrotate.timer
    enabled: yes
    state: started
  when: cron_service is defined and cron_service != ""
  notify: restart cron

- name: Ensure cron log rotation is executed immediately
