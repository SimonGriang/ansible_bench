  delegate_to: 127.0.0.1
  when: bootstrap_port is defined

- name: Prepare system
  raw: whoami && test -w /
  register: prepare_system
  changed_when: false
  become: false

- name: Gather bootstrap facts
  setup:
  when: prepare_system.failed

- name: Install bootstrap packages (raw)
  raw: |
    case "$PACKER_BUILDER_TYPE" in
      vmware*)
        tdnf -y --setopt=install_weak_deps=0 install python3 python3-decorator python3-jinja python3-requests
        ;;
      parallels*)
        tdnf -y --setopt=install_weak_deps=0 install python3 python3-decorator python3-jinja python3-requests
        ;;
      *)
        dnf -y --setopt=install_weak_deps=0 install python3 python3-decorator python3-jinja python3-requests
        ;;
    esac
  when: ansible_os_family == "RedHat" or (ansible_os_family == "Debian" and ansible_distribution_release == "trusty")

- name: Ensure libdnf5 is present on Fedora/RedHat
  raw: dnf -y install libdnf5
  when: ansible_os_family == "RedHat"

- name: Gather ansible facts
  setup: {}

- name: Install bootstrap packages (package)
  package:
    name: "{{ item }}"
    state: present
    update_cache: yes
  with_items:
    - python3
    - python3-decorator
    - python3-jinja
    - python3-requests
  when: ansible_os_family == "RedHat" or (ansible_os_family == "Debian" and ansible_distribution_release == "trusty")


