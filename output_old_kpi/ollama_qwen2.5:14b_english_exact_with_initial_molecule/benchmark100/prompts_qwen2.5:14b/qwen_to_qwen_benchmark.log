- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  when: selinux_requirements is defined and selinux_requirements|length > 0
- name: Flush handlers
  meta: flush_handlers
- name: Configure selinux
  block:
    - name: Set selinux state
      selinux:
        policy: "{{ selinux_policy }}"
        state: "{{ selinux_state }}"
    - name: Manage selinux booleans
      selinux_boolean:
        name: "{{ item.key }}"
        state: "{{ item.value|bool }}"
        persistent: yes
      loop: "{{ selinux_booleans|dict2items }}"


