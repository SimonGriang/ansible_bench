---
- import_tasks: assert.yml

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: installed
    enablerepo: crb
    disableexcludes: true
  when: ansible_os_family == "RedHat" and ansible_distribution_major_version == "8"

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: "redis.conf.j2"
    dest: "{{ lookup('dict', {'debian': '/etc/redis/6379/redis.conf', 'redhat': '/etc/redis.conf'})[ansible_facts['os_family']] }}"
    owner: redis
    group: redis
    mode: '0644'
  notify: restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: true


