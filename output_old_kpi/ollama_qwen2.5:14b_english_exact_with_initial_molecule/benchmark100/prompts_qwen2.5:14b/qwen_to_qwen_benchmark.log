---
- import_tasks: assert.yml
  name: Import assert.yml file for validation purposes, only run once on localhost.
  remote_user: root
  run_once: true
  delegate_to: localhost

- name: Install the Apache HTTPD server from the package manager using the variable httpd_packages.
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Modify SELinux settings if SELinux is enabled.
  when: selinux_enabled
  selinux:
    boolean: "{{ item.0 }} {{ item.1 }}"
  loop: "{{ selinux_booleans | pairs }}"
  notify: test_httpd
  when: "'httpd' in item.0 | lower"
  loop_control:
    extended: true

- name: Template the main httpd configuration file using src and dest variables.
  template:
    src: "httpd.conf.j2"
    dest: "{{ httpd_conf }}"
  notify: test_httpd

- name: Activate Apache modules using a2enmod command on Debian-based systems.
  command: "{{ a2enmod_command }} {{ item }}"
  notify: test_httpd
  when: "'Debian' in ansible_distribution | lower"
  loop: "{{ httpd_modules }}"
  loop_control:
    extended: true

- name: Import ssl.yml tasks file if HTTPS SSL is enabled.
  import_tasks: ssl.yml
  when: https_ssl_enabled

- name: Import locations.yml tasks file if there are defined locations for the Apache server.
  import_tasks: locations.yml
  when: httpd_locations is defined

- name: Import vhosts.yml tasks file if there are defined virtual hosts for the Apache server.
  import_tasks: vhosts.yml
  when: httpd_vhosts is defined

- name: Template the ports configuration file and notify handlers to test and restart the service if the OS is Debian or Suse.
  template:
    src: "ports.conf.j2"
    dest: "{{ httpd_ports }}"
  notify: test_httpd
  when: "'Debian' in ansible_distribution | lower or 'Suse' in ansible_distribution | lower"

- name: Import directories.yml tasks file if there are defined directories for the Apache server.
  import_tasks: directories.yml
  when: httpd_directories is defined

- name: Flush all handlers to ensure they are executed after the tasks are completed.
  meta: flush_handlers

- name: Remove the default index.html file if the variable httpd_remove_example is true.
  file:
    path: "{{ httpd_default_dir }}/index.html"
    state: absent
  when: httpd_remove_example

- name: Start and enable the Apache service using the variable httpd_service.
  service:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


