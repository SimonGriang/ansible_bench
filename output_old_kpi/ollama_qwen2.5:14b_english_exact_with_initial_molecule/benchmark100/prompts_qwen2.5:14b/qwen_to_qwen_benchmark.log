---
- name: Install epel
  ansible.builtin.yum:
    name: epel-release
    state: present
  when: >
    ansible_os_family == 'RedHat' and
    (ansible_distribution_major_version is version in ['7', '8', '9'] or
     ansible_distribution == 'Amazon')

- name: Install epel gpg key
  ansible.builtin.get_url:
    url: https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}
    dest: /etc/pki/rpm-gpg/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}
  when: >
    ansible_os_family == 'RedHat' and
    (ansible_distribution_major_version is version in ['7', '8', '9'] or
     ansible_distribution == 'Amazon')

- name: Install epel-release
  ansible.builtin.yum:
    name: epel-release
    state: present
  when: >
    ansible_os_family == 'RedHat' and
    (ansible_distribution_major_version is version in ['7', '8', '9'] or
     ansible_distribution == 'Amazon')

- name: Install epel-next-release
  ansible.builtin.yum:
    name: epel-next-release
    state: present
  when: >
    ansible_os_family == 'RedHat' and
    (ansible_distribution_major_version is version in ['7', '8', '9'] or
     ansible_distribution == 'Amazon') and
    epel_next | default(false)
  notify: update_package_cache

- name: Update package cache
  ansible.builtin.yum:
    state: list
  listen: update_package_cache


