    ssh_key_pubkey: "{{ user.ssh_key_pubkey|default('') }}"
    ssh_key_passphrase: "{{ user.ssh_key_passphrase|default('') }}"
    ssh_key_force: "{{ user.ssh_key_force|default(false) }}"
    ssh_key_passphrase_force: "{{ user.ssh_key_passphrase_force|default(false) }}"
    ssh_key_passphrase_cipher: "{{ user.ssh_key_passphrase_cipher|default('none') }}"
