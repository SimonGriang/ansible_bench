 \'.items[].metadata.name\'\n      register: registered_nodes\n\n    - name: Remove old node secrets and nodes\n      shell: kubectl delete node {{ item }}\n      with_items: "{{ registered_nodes.results[0].stdout_lines }}"\n      when: (do_etcd_restore is defined) or (do_etcd_restore_from_s3 is defined)\n\n- name: Set an Active Server variable\n  set_fact:\n    active_server: "{{ inventory_hostname }}"\n  when: rke2_node_type == \'server\'' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-01T12:42:01.111762411Z', 'done': True, 'done_reason': 'stop', 'total_duration': 29296869978, 'load_duration': 90698876, 'prompt_eval_count': 2466, 'prompt_eval_duration': 783097383, 'eval_count': 1246, 'eval_duration': 28407318557, 'model_name': 'qwen2.5:14b'} id='run--fa054679-01a7-47cd-a8aa-a3ec902916ae-0' usage_metadata={'input_tokens': 2466, 'output_tokens': 1246, 'total_tokens': 3712}
