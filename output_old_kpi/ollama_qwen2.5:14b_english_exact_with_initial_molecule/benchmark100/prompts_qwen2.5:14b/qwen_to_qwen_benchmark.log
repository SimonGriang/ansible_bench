t.changed\n\n- name: Create symlink to latest version\n  ansible.builtin.file:\n    src: /opt/promtail/promtail\n    dest: /usr/local/bin/promtail\n    state: link\n    mode: \'0755\'\n  become: yes\n  notify: restart promtail service\n\n- name: Write configuration\n  ansible.builtin.template:\n    src: promtail_config.j2\n    dest: /etc/promtail/promtail.yml\n    mode: \'0640\'\n    owner: promtail\n    group: promtail\n  become: yes\n  notify: restart promtail service\n\n- name: Create systemd service unit\n  ansible.builtin.template:\n    src: promtail.service.j2\n    dest: /etc/systemd/system/promtail.service\n    mode: \'0644\'\n    owner: root\n    group: root\n  become: yes\n  notify: restart promtail service' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-01T10:45:20.008259864Z', 'done': True, 'done_reason': 'stop', 'total_duration': 27328780022, 'load_duration': 88817872, 'prompt_eval_count': 2473, 'prompt_eval_duration': 14947626, 'eval_count': 1191, 'eval_duration': 27210361936, 'model_name': 'qwen2.5:14b'} id='run--42c07efb-b016-4f3e-8e52-6369868747a6-0' usage_metadata={'input_tokens': 2473, 'output_tokens': 1191, 'total_tokens': 3664}
