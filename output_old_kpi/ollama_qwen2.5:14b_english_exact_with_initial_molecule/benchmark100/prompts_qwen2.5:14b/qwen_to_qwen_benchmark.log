---
- name: Update java_jdk_vendor to temurin if it is adoptopenjdk
  set_fact:
    java_jdk_vendor: temurin
  when: java_jdk_vendor == 'adoptopenjdk'

- name: Include OS-specific variables based on distribution
  include_vars:
    file: "{{ ansible_distribution | lower }}-{{ ansible_distribution_major_version }}.yml"

- name: Include architecture-specific variables
  include_vars:
    file: "{{ ansible_architecture }}.yml"

- name: Set OS-specific variables (part I)
  set_fact:
    java_{{ item }}: "{{ os_vars[item] }}"
  loop:
    - jdk_major_version
    - jdk_major_version_patch
    - jdk_major_version_major
    - jdk_major_version_minor
    - jdk_major_version_security
    - jdk_major_version_service
    - jdk_major_version_update
    - jdk_major_version_u
    - jdk_major_version_v
    - jdk_major_version_version
    - jdk_major_version_x
  when: os_vars[item] is defined and os_vars[item] is not none

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    java_{{ item }}: "{{ os_arch_vars[item] }}"
  loop:
    - jdk_path
    - jre_path
    - jre_bin_path
    - jre_lib_path
    - jre_lib_ext_path
    - jre_lib_jrockit_path
    - jre_lib_jvm_path
    - jre_lib_management_path
    - jre_lib_msutil_path
    - jre_lib_policy_path
    - jre_lib_rsrv_path
    - jre_lib_security_path
    - jre_lib_verify_path
    - jre_lib_jpda_path
    - jre_lib_jpeg_path
    - jre_lib_nashorn_path
    - jre_lib_plugin_path
    - jre_lib_swt_path
    - jre_lib_tzupdater_path
    - jre_lib_web_path
    - jre_lib_xmlparserv2_path
    - jre_lib_ext_policy_path
    - jre_lib_ext_security_path
    - jre_lib_ext_swi_path
    - jre_lib_ext_jaxp_path
    - jre_lib_ext_jaxws_path
    - jre_lib_ext_jndi_path
    - jre_lib_ext_management_path
    - jre_lib_ext_msutil_path
  when: os_arch_vars[item] is defined and os_arch_vars[item] is not none

- name: Set specific variables
  set_fact:
    java_home: "{{ openjdk_home }}"

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt_key:
        state: absent
        keyserver: keyserver.ubuntu.com
        id: DEB_KEY_ID
      when: ansible_distribution == 'Debian'
      register: remove_deprecated_repositories

    - name: Install extra apt tools
      apt:
        name: apt-transport-https
        state: present
      when: ansible_distribution == 'Debian'
      register: install_extra_apt_tools

    - name: Add key repositories
      apt_key:
        id: DEB_KEY_ID
        keyserver: keyserver.ubuntu.com
      when: ansible_distribution == 'Debian'
      register: add_key_repositories

    - name: Add repositories
      apt_repository:
        filename: /etc/apt/sources.list.d/openjdk.list
        repo: "deb http://deb.debian.org/debian/ {{ ansible_distribution_release }}-backports main"
      when: ansible_distribution == 'Debian'
      register: add_repositories

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        state: present
        key: RHEL_KEY_ID
      when: ansible_distribution == 'RedHat'
      register: add_key_repositories

    - name: Add repositories
      yum_repository:
        name: openjdk-repo
        description: OpenJDK Repository
        baseurl: http://mirror.centos.org/centos/$releasever/extras/$basearch/
        enabled: true
        gpgcheck: true
      when: ansible_distribution == 'RedHat'
      register: add_repositories

- name: Install required libraries
  package:
    name: "{{ required_libraries }}"
    state: present
  when: ansible_distribution in ['Debian', 'RedHat']

- name: Install Java, Debian
  block:
    - name: Update cache
      apt:
        update_cache: yes
      when: ansible_distribution == 'Debian'
      register: update_cache

    - name: Install package
      apt:
        name: "{{ java_package }}"
        state: present
      when: ansible_distribution == 'Debian'
      register: install_java_package

    - name: Check installed package
      command: dpkg -s {{ java_package }}
      when: ansible_distribution == 'Debian'
      register: check_installed_package
      changed_when: false
      failed_when: false

- name: Install Java, RedHat
  block:
    - name: Update cache
      yum:
        update_cache: yes
      when: ansible_distribution == 'RedHat'
      register: update_cache

    - name: Install package
      yum:
        name: "{{ java_package }}"
        state: present
      when: ansible_distribution == 'RedHat'
      register: install_java_package

    - name: Check installed package
      command: rpm -q {{ java_package }}
      when: ansible_distribution == 'RedHat'
      register: check_installed_package
      changed_when: false
      failed_when: false

- name: Export environment variables
  template:
    src: java_env_template.j2
    dest: /etc/profile.d/java.sh

- name: Source environment variables
  shell: source /etc/profile.d/java.sh

- name: Correct java version selected for Java versions less than 11
  command: alternatives --set java /usr/lib/jvm/java-8-openjdk-{{ ansible_distribution | lower }}-{{ ansible_distribution_major_version }}/jre/bin/java
  when: java_major_version | int < 11 and ansible_distribution == 'Debian'

- name: Correct java version selected for Java versions greater than or equal to 11
  command: alternatives --set java /usr/lib/jvm/java-11-openjdk-{{ ansible_distribution | lower }}-{{ ansible_distribution_major_version }}/jre/bin/java
  when: java_major_version | int >= 11 and ansible_distribution == 'Debian'


