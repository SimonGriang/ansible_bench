---
- name: Ensure the unzip package is available on the target system
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop:
    - unzip
  when: ansible_os_family == "Debian"
  become: yes
  register: result
  changed_when: result is defined and result.changed

- name: Ensure the unzip package is available on the target system
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop:
    - unzip
  when: ansible_os_family == "RedHat"
  become: yes
  register: result
  changed_when: result is defined and result.changed

- name: Create a system group for promtail
  ansible.builtin.group:
    name: promtail
    system: true
    state: present
  become: yes
  when: ansible_group_by_name.promtail is not defined

- name: Create the promtail user
  ansible.builtin.user:
    name: promtail
    system: true
    group: promtail
    state: present
  become: yes
  when: ansible_user_by_name.promtail is not defined

- name: Ensure the /usr/local/bin directory exists
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
  become: yes

- name: Create config directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0750'
    owner: promtail
    group: promtail
  loop:
    - /etc/promtail
    - /etc/promtail/tls
  become: yes

- name: Create application directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0750'
    owner: promtail
    group: promtail
  loop:
    - /opt/promtail
    - /var/lib/promtail
  become: yes

- name: Check if the promtail binary exists
  ansible.builtin.stat:
    path: /opt/promtail/promtail
  register: promtail_binary_exists
  changed_when: false

- name: Download promtail binaries
  ansible.builtin.get_url:
    url: "{{ promtail_binary_url }}"
    dest: /tmp/promtail.tar.gz
    mode: '0750'
    owner: promtail
    group: promtail
  when: not promtail_binary_exists.stat.exists and not promtail_binary_local_distribution and promtail_binary_propagation
  become: yes
  register: download_result
  changed_when: download_result is defined and download_result.changed

- name: Propagate locally distributed promtail archive
  ansible.builtin.copy:
    src: "{{ promtail_binary_source }}"
    dest: /tmp/promtail.tar.gz
    mode: '0750'
    owner: promtail
    group: promtail
  when: not promtail_binary_exists.stat.exists and promtail_binary_local_distribution and not promtail_binary_propagation
  become: yes
  register: copy_result
  changed_when: copy_result is defined and copy_result.changed

- name: Download promtail binaries to controller node
  ansible.builtin.get_url:
    url: "{{ promtail_binary_url }}"
    dest: /tmp/promtail.tar.gz
    mode: '0750'
    owner: promtail
    group: promtail
  when: not promtail_binary_exists.stat.exists and not promtail_binary_local_distribution and promtail_binary_propagation
  become: yes
  register: download_controller_result
  changed_when: download_controller_result is defined and download_controller_result.changed

- name: Propagate promtail binaries
  ansible.builtin.copy:
    src: /tmp/promtail.tar.gz
    dest: /opt/promtail/promtail.tar.gz
    mode: '0750'
    owner: promtail
    group: promtail
  when: not promtail_binary_exists.stat.exists and not promtail_binary_local_distribution and promtail_binary_propagation
  become: yes
  register: propagate_result
  changed_when: propagate_result is defined and propagate_result.changed

- name: Unpack promtail binaries
  ansible.builtin.unarchive:
    src: /opt/promtail/promtail.tar.gz
    dest: /opt/promtail
    remote_src: true
    creates: /opt/promtail/promtail
    mode: '0750'
    owner: promtail
    group: promtail
  become: yes
  check_mode: false
  register: unpack_result
  changed_when: unpack_result is defined and unpack_result.changed

- name: Create symlink to latest version
  ansible.builtin.file:
    src: /opt/promtail/promtail
    dest: /usr/local/bin/promtail
    state: link
    mode: '0755'
  become: yes
  notify: restart promtail service

- name: Write configuration
  ansible.builtin.template:
    src: promtail_config.j2
    dest: /etc/promtail/promtail.yml
    mode: '0640'
    owner: promtail
    group: promtail
  become: yes
  notify: restart promtail service

- name: Create systemd service unit
  ansible.builtin.template:
    src: promtail.service.j2
    dest: /etc/systemd/system/promtail.service
    mode: '0644'
    owner: root
    group: root
  become: yes
  notify: restart promtail service


