---
- name: Create ssl key
  copy:
    content: "{{ item }}"
    dest: "/etc/ssl/private/{{ item.split('/')[-1] }}.key"
    mode: '0640'
    owner: root
    group: root
  with_items: "{{ ssl_keys }}"
  loop_control:
    loop_var: item

- name: Create ssl csr
  openssl_csr:
    privatekey_path: "/etc/ssl/private/{{ item.split('/')[-1] }}.key"
    dest: "/etc/ssl/csr/{{ item.split('/')[-1] }}.csr"
    common_name: "{{ item.split('/')[-1] }}"
    mode: '0644'
    owner: root
    group: root
  with_items: "{{ ssl_csr }}"
  loop_control:
    loop_var: item

- name: Create ssl certificates
  openssl_certificate:
    csr: "/etc/ssl/csr/{{ item.split('/')[-1] }}.csr"
    privatekey_path: "/etc/ssl/private/{{ item.split('/')[-1] }}.key"
    dest: "/etc/ssl/certs/{{ item.split('/')[-1] }}.crt"
    mode: '0644'
    owner: root
    group: root
    provider: selfsigned
  with_items: "{{ ssl_certificates }}"
  loop_control:
    loop_var: item

- name: Create PKCS#12 file
  openssl_pkcs12:
    export: yes
    name: "{{ item.split('/')[-1] }}"
    certificate: "/etc/ssl/certs/{{ item.split('/')[-1] }}.crt"
    privatekey: "/etc/ssl/private/{{ item.split('/')[-1] }}.key"
    dest: "/etc/ssl/pkcs12/{{ item.split('/')[-1] }}.p12"
    mode: '0640'
    owner: root
    group: root
  with_items: "{{ ssl_pkcs12 }}"
  loop_control:
    loop_var: item

- name: Read private key
  slurp:
