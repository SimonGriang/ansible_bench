---
- name: Remove externally managed from Debian 12
  file:
    path: /etc/someconfigfile
    state: absent
  when: ansible_facts['os_family'] == 'Debian' and ansible_facts['distribution'] == 'Debian' and ansible_facts['distribution_major_version'] == '12'

- name: Ensure Pip is installed
  pip:
    name: pip
    state: present
  when: ansible_facts['os_family'] != 'Debian' or (ansible_facts['os_family'] == 'Debian' and ansible_facts['distribution_major_version'] != '12')

- name: Ensure packaging is available via dnf
  yum:
    name: python3-packaging
    state: present
  when: ansible_facts['os_family'] == 'RedHat'

- name: Ensure pip_install_packages are installed
  pip:
    name: "{{ item }}"
    version: "{{ item.version | default('') }}"
    virtualenv: "{{ item.virtualenv | default('') }}"
    extra_args: "{{ item.extra_args | default('') }}"
  loop: "{{ pip_install_packages }}"
  when: ansible_facts['os_family'] != 'Debian' or (ansible_facts['os_family'] == 'Debian' and ansible_facts['distribution_major_version'] != '12')


