---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Install python pip
  package:
    name: "{{ python_pip_package }}"
    state: present

- name: Configure pip proxy
  lineinfile:
    path: /etc/pip.conf
    line: "proxy = {{ python_pip_proxy }}"
    create: yes
  when: python_pip_proxy is defined

- name: Trust hosts
  lineinfile:
    path: /etc/pip.conf
    line: "index-url = http://{{ python_pip_proxy }}/{{ python_pip_index }}"
    create: yes
  when: python_pip_trusted_host is defined

- name: Update pip
  pip:
    name: pip
    state: latest
  when: python_pip_update | bool and ansible_facts.system_release != 'bookworm' and ansible_facts.system_release != 'noble' and ansible_os_family != 'Alpine'

- name: Install requested modules
  pip:
    name: "{{ item.name }}"
    version: "{{ item.version }}"
    state: "{{ item.state }}"
  loop: "{{ python_pip_modules }}"
  when: ansible_facts.system_release != 'bookworm' and ansible_facts.system_release != 'noble' and ansible_os_family != 'Alpine'


