    that:
      - bootstrap_required_var1 is defined
      - bootstrap_required_var2 is defined
      - bootstrap_required_var3 is defined

- name: Task 2: wait for host (when configured)
  wait_for:
    host: "{{ ansible_hostname }}"
    port: 22
    delay: 10
    timeout: 300
  when: bootstrap_wait_for_host|default('false')|bool

- name: Task 3: prepare system
  block:
    - name: Include tasks to gather bootstrap facts (raw)
      include_tasks: gather_bootstrap_facts.yml
    - name: Install bootstrap packages (raw)
      raw: "{{ bootstrap_install.raw }}"
      when: ansible_facts['os_family'] == 'RedHat'
    - name: Ensure system is prepared by issuing ansible modules
      block:
        - name: Gather ansible facts
          setup:
        - name: Install bootstrap packages
          package:
            name: "{{ item }}"
            state: present
          loop: "{{ bootstrap_facts.packages }}"
  rescue:
    - name: Debug failed prepare system
      debug:
        msg: "Failed to prepare the system. Check connection details and permissions."
  when: ansible_connection != 'local'


