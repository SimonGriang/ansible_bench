---
- import_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item['path'] }}"
    state: directory
    mode: "{{ item['mode'] }}"
    owner: "{{ item['owner'] }}"
    group: "{{ item['group'] }}"
  with_items:
    - { path: "/var/cache/bind", mode: "0755", owner: "bind", group: "bind" }
    - { path: "/etc/bind/zones", mode: "0755", owner: "bind", group: "bind" }

- name: Create group
  group:
    name: bind
    system: true

- name: Create user
  user:
    name: bind
    system: true
    create_home: no
    shell: /usr/sbin/nologin
    group: bind

- name: Generate rndc key
  command: "dnssec-keygen -a HMAC-MD5 -b 128 -n HOST -r /dev/urandom -k {{ item }}-keyfile"
  args:
    creates: "{{ item }}-keyfile"
  register: rndc_keygen
  with_items:
    - "/etc/bind/rndc"
  changed_when: "rndc_keygen.stdout.find('Generating key') != -1"

- name: Set permissions on rndc key file
  file:
    path: "{{ item }}"
    mode: "0640"
    owner: "root"
    group: "bind"
  with_items:
    - "/etc/bind/rndc.key"
    - "/etc/bind/rndc.conf"

- name: Get the hints/root file
  get_url:
    url: "https://www.internic.net/domain/named.root"
    dest: "/etc/bind/db.root"
    mode: "0644"

- name: Create zone file
  template:
    src: "templates/db.domain.j2"
    dest: "/etc/bind/zones/db.{{ domain }}"
    mode: "0644"

- name: Add zones to configuration
  template:
    src: "templates/named.conf.j2"
    dest: "/etc/bind/named.conf"
    mode: "0644"

- name: Place systemd override
  file:
    path: "/etc/systemd/system/named.service.d/override.conf"
    state: touch
    mode: "0644"

- name: Start and enable dns
  systemd:
    name: named
    enabled: yes
    state: started


