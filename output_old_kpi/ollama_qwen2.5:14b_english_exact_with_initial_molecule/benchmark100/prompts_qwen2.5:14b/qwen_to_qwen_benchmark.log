- name: Create the RKE2 manifests directory
  file:
    path: /etc/rke2/server/manifests
    state: directory
    mode: '0755'

- name: Copy kube-vip files to first server
  copy:
    src: "{{ item }}"
    dest: /etc/rke2/server/manifests/
    mode: '0644'
  with_items:
    - kube-vip-ds.yml
    - kube-vip-svc.yml

- name: Copy kube-vip load balancer manifests to first server
  copy:
    src: "{{ item }}"
    dest: /etc/rke2/server/manifests/
    mode: '0644'
  with_items:
    - kube-vip-lb.yml
  when: cloud_provider_enabled | default('false') | bool


