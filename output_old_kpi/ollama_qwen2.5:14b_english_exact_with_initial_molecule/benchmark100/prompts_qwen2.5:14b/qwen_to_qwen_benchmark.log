    ssh_key_passphrase_cipher_iv: "{{ user.ssh_key_passphrase_cipher_iv|default('none') }}"
    ssh_key_passphrase_cipher_salt: "{{ user.ssh_key_passphrase_cipher_salt|default('none') }}"
    ssh_key_passphrase_cipher_iterations: "{{ user.ssh_key_passphrase_cipher_iterations|default('1000') }}"
    ssh_key_passphrase_cipher_algorithm: "{{ user.ssh_key_passphrase_cipher_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_mode_algorithm: "{{ user.ssh_key_passphrase_cipher_mode_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_key_algorithm: "{{ user.ssh_key_passphrase_cipher_key_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_iv_algorithm: "{{ user.ssh_key_passphrase_cipher_iv_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_salt_algorithm: "{{ user.ssh_key_passphrase_cipher_salt_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_iterations_algorithm: "{{ user.ssh_key_passphrase_cipher_iterations_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_algorithm_algorithm: "{{ user.ssh_key_passphrase_cipher_algorithm_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_mode_algorithm_algorithm: "{{ user.ssh_key_passphrase_cipher_mode_algorithm_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_key_algorithm_algorithm: "{{ user.ssh_key_passphrase_cipher_key_algorithm_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_iv_algorithm_algorithm: "{{ user.ssh_key_passphrase_cipher_iv_algorithm_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_salt_algorithm_algorithm: "{{ user.ssh_key_passphrase_cipher_salt_algorithm_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_iterations_algorithm_algorithm: "{{ user.ssh_key_passphrase_cipher_iterations_algorithm_algorithm|default('none') }}"
    ssh_key_passphrase_cipher_algorithm_algorithm_algorithm: "{{ user.ssh_key_passphrase_cipher_algorithm_algorithm_algorithm|default('none') }}"
  when: user.name is defined

- name: Set sudo options for {{ user.name }}
  file:
    path: /etc/sudoers.d/{{ user.name }}
    state: file
    mode: 0640
    content: "{{ user.sudo }}\n"
    owner: root
    group: root
    validate: /usr/sbin/visudo --check
  when: user.sudo is defined

- name: Remove sudo options for {{ user.name }}
  file:
    path: /etc/sudoers.d/{{ user.name }}
    state: absent
  when: user.sudo is not defined

- name: Generate private ssh key for {{ user.name }}
  command: ssh-keygen -t {{ user.ssh_key_type|default('rsa') }} -b {{ user.ssh_key_bits|default('2048') }} -f {{ user.ssh_key_dir }}/{{ user.name }} -N ''
  when: user.manage_ssh_key|default(false)
  run_once: true
  delegate_to: localhost
  become: no

- name: Generate public ssh key for {{ user.name }}
  command: ssh-keygen -y -f {{ user.ssh_key_dir }}/{{ user.name }} > {{ user.ssh_key_dir }}/{{ user.name }}.pub
  when: user.manage_ssh_key|default(false)
  run_once: true
  delegate_to: localhost
  become: no

- name: Convert ssh key to ppk for {{ user.name }}
  command: puttygen {{ user.ssh_key_dir }}/{{ user.name }} -o {{ user.ssh_key_dir }}/{{ user.name }}.ppk -O force-command
  when: user.manage_ssh_key|default(false)
  run_once: true
  delegate_to: localhost
  become: no

- name: Get or set the home directory for {{ user.name }}
  command: getent passwd {{ user.name }} | cut -d: -f6
  register: user_home_dir
  when: user.home_dir is not defined
  delegate_to: localhost
  become: yes
  changed_when: false

- name: Create .ssh directory for {{ user.name }}
  file:
    path: "{{ user.home_dir }}/.ssh"
    state: directory
    mode: 0700
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.manage_ssh_key|default(false) or user.private_keys is defined
  become: yes

- name: Deploy authorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys }}"
  when: user.authorized_keys is defined

- name: Remove unauthorized keys for {{ user.name }}
  authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys is defined

- name: Copy generated private ssh key for {{ user.name }}
  copy:
    src: "{{ user.ssh_key_dir }}/{{ user.name }}"
    dest: "{{ user.home_dir }}/.ssh/id_rsa"
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.copy_private_key|default(false)

- name: Check users password valid time for {{ user.name }}
  shell: chage -l {{ user.name }} | grep "Password expires" | awk '{print $3}'
  register: password_valid_time
  when: user.password_valid_time is defined

- name: Set users password valid time for {{ user.name }}
  command: chage --password_expire {{ user.name }} +{{ user.password_valid_time|default('90') }}
  when: user.password_valid_time is defined and password_valid_time.stdout != "+{{ user.password_valid_time|default('90') }}"

- name: Place private key file for {{ user.name }}
  copy:
    src: "{{ user.private_keys.0 }}"
    dest: "{{ user.home_dir }}/.ssh/id_rsa"
    mode: 0600
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.private_keys is defined


