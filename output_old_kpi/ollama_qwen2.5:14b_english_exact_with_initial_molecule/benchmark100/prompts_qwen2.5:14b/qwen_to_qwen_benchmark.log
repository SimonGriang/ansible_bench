---
- name: Enable proxy modules in Apache
  block:
    - name: Enable proxy module on Debian
      ansible.builtin.apache2ctl:
        module: "proxy"
        config: "proxy"
      when: ansible_os_family == "Debian"

    - name: Enable proxy module on Suse
      ansible.builtin.apache2ctl:
        module: "proxy"
        config: "proxy"
      when: ansible_os_family == "Suse"

    - name: Enable proxy_http module on Debian
      ansible.builtin.apache2ctl:
        module: "proxy_http"
        config: "proxy_http"
      when: ansible_os_family == "Debian"

    - name: Enable proxy_http module on Suse
      ansible.builtin.apache2ctl:
        module: "proxy_http"
        config: "proxy_http"
      when: ansible_os_family == "Suse"

- name: Configure Apache locations using a template
  block:
    - name: Ensure template file exists
      ansible.builtin.template:
        src: "templates/apache_locations.conf.j2"
        dest: "/etc/apache2/sites-available/locations.conf"
        owner: root
        group: root
        mode: "0644"
      notify: test_apache_configuration

    - name: Ensure template file exists
      ansible.builtin.template:
        src: "templates/apache_locations.conf.j2"
        dest: "/etc/httpd/conf.d/locations.conf"
        owner: root
        group: root
        mode: "0644"
      when: ansible_os_family == "Suse"
      notify: test_apache_configuration

  notify: restart_apache_server


