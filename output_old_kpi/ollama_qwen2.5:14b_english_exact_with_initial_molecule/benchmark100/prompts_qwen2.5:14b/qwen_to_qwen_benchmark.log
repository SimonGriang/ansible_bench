---
- name: Install Keepalived when HA mode is enabled
  when: ha_mode and is_rke2_server
  yum:
    name: keepalived
    state: present

- name: Download and install RKE2
  block:
    - name: Download RKE2 binary
      get_url:
        url: "{{ rke2_version_url }}"
        dest: "/usr/local/bin/rke2"
        mode: '0755'
    - name: Set RKE2 environment variables
      command: "{{ rke2_install_command }}"

- name: CIS Hardening
  block:
    - name: Apply CIS hardening profile
      command: "rke2 cis {{ cis_profile }}"

- name: Find Active Server
  command: "rke2 query active-server"

- name: Enable IPVS kernel module
  when: use_kube_vip and ha_mode
  block:
    - name: Load IPVS kernel module
      command: "modprobe ip_vs"
    - name: Ensure IPVS module loads on boot
      lineinfile:
        path: /etc/modules-load.d/ipvs.conf
        line: ip_vs

- name: Copy kube-vip manifests to the masternode
  when: not use_keepalived
  block:
    - name: Copy kube-vip manifest
      copy:
        src: "kube-vip.yml"
        dest: "/opt/kube-vip.yml"

- name: Copy ingress-nginx manifests to the masternode
  when: ingress_nginx_config is defined
  block:
    - name: Copy ingress-nginx manifest
      copy:
        src: "ingress-nginx.yml"
        dest: "/opt/ingress-nginx.yml"

- name: Prepare very first server node in the cluster
  block:
    - name: Initialize the first server node
      command: "rke2 server --cluster-init --token {{ rke2_token }}"

- name: Restore etcd specific tasks
  block:
    - name: Restore etcd data
      command: "rke2 etcd restore --data-dir /var/lib/rke2/etcd --snapshots /var/lib/rke2/etcd/snapshots/{{ etcd_snapshot }}"

- name: Download kubeconfig to ansible localhost
  when: download_kubeconfig
  block:
    - name: Download kubeconfig
      fetch:
        src: /etc/rancher/rke2/rke2.yaml
        dest: "./kubeconfig-{{ inventory_hostname }}.yaml"
        flat: yes

- name: Prepare and join remaining nodes of the cluster
  when: active_server is defined
  block:
    - name: Join remaining nodes to the cluster
      command: "rke2 agent --server {{ active_server }} --token {{ rke2_token }}"

- name: Rolling cordon and drain restart when version changes - servers
  command: "rke2 rolling-update --selector node-role.kubernetes.io/control-plane=true --restart=true"

- name: Rolling cordon and drain restart when version changes - agents
  command: "rke2 rolling-update --selector node-role.kubernetes.io/worker=true --restart=true"

- name: Flush handlers
  meta: flush_handlers

- name: Rolling restart when config files change
  command: "rke2 restart"

- name: Final steps
  block:
    - name: Finalize playbook execution
      command: "rke2 status"


