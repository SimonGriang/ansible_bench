---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory
    mode: '0750'

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_node_type == 'server'

- name: Copy RKE2 configuration file
  copy:
    dest: /etc/rancher/rke2/config.yaml
    mode: '0640'
    content: "{{ lookup('template', 'path/to/rke2-config-template.yaml') }}"
  notify: Config file changed

- name: Copy kubelet configuration file
  copy:
    dest: /etc/rancher/rke2/kubelet-config.yaml
    mode: '0640'
    content: "{{ lookup('template', 'path/to/kubelet-config-template.yaml') }}"
  when: rke2_kubelet_config | length > 0
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  copy:
    dest: /etc/rancher/rke2/registries.yaml
    mode: '0640'
    content: "{{ lookup('template', 'path/to/registries-template.yaml') }}"
  when: (rke2_custom_registry_mirrors | length > 0) or (rke2_custom_registry_configs | length > 0)
  notify: Config file changed

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: (rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != '') and (rke2_server_service_state == 'disabled' or rke2_server_service_state == 'undefined')

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file is defined and rke2_etcd_snapshot_file != '' and rke2_etcd_snapshot_s3_options is defined

- name: Restore etcd from file
  block:
    - name: Create the RKE2 etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/agent/snapshots
        state: directory
        mode: '0750'

    - name: Copy the etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/snapshots
        mode: '0640'

    - name: Restore etcd from snapshot file
      shell: rke2 etcd snapshot restore /var/lib/rancher/rke2/agent/snapshots/{{ rke2_etcd_snapshot_file | basename }} --kubeconfig /etc/rancher/rke2/kubeconfig
      when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Restore etcd from S3 snapshot
      shell: rke2 etcd snapshot restore s3://{{ rke2_etcd_snapshot_s3_options.bucket }}/{{ rke2_etcd_snapshot_s3_options.snapshot_name }} --kubeconfig /etc/rancher/rke2/kubeconfig --s3-endpoint={{ rke2_etcd_snapshot_s3_options.endpoint }} --s3-region={{ rke2_etcd_snapshot_s3_options.region }} --s3-access-key={{ rke2_etcd_snapshot_s3_options.access_key }} --s3-secret-key={{ rke2_etcd_snapshot_s3_options.secret_key }}
      when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server.service
    enabled: yes
    state: started
  when: rke2_node_type == 'server' and inventory_hostname == groups['rke2_cluster_group_name'][0]
  environment:
    RKE2_TOKEN: "{{ rke2_cluster_token }}"

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent.service
    enabled: no
    state: masked
  when: rke2_node_type == 'server' and inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: "{{ rke2_kubeconfig }}"
    delay: 10
    timeout: 600
  when: rke2_node_type == 'server' and inventory_hostname == groups['rke2_cluster_group_name'][0] and rke2_cni is not defined

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: "{{ rke2_kubeconfig }}"
    delay: 10
    timeout: 600
  when: rke2_node_type == 'server' and inventory_hostname == groups['rke2_cluster_group_name'][0] and rke2_cni is defined

- name: Restore etcd
  block:
    - name: Get registered nodes
      shell: kubectl get nodes -o json | jq -r '.items[].metadata.name'
      register: registered_nodes

    - name: Remove old node secrets and nodes
      shell: kubectl delete node {{ item }}
      with_items: "{{ registered_nodes.results[0].stdout_lines }}"
      when: (do_etcd_restore is defined) or (do_etcd_restore_from_s3 is defined)

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: rke2_node_type == 'server'
