---
- name: Create Vault group
  group:
    name: "{{ vault_group }}"
    state: present

- name: Create Vault user
  user:
    name: "{{ vault_user }}"
    create_home: no
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    system: yes
    state: present

- name: Create Vault download directory
  file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Download Vault binary
  unarchive:
    src: "{{ vault_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: yes
    owner: root
    group: root
    creates: "{{ vault_download_path }}/vault"

- name: Check if vault_path exists
  stat:
    path: "{{ vault_path }}"
  register: vault_path_check

- name: Create vault_path if it does not exist
  file:
    path: "{{ vault_path }}"
    state: directory
    mode: 0755
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: not vault_path_check.stat.exists and vault_path is defined

- name: Create directory in vault_path
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ vault_directories }}"

- name: Create data directory
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  command: >
    openssl req -x509 -newkey rsa:4096 -keyout {{ vault_data_directory }}/tls/tls.key -out {{ vault_data_directory }}/tls/tls.crt -days 1095 -nodes -subj "/CN=Vault" -reqconf default
  notify: Restart vault

- name: Set ownership of tls material
  file:
    path: "{{ item }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  with_items: "{{ vault_tls_files }}"

- name: Copy Vault binary
  copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: 0755
    owner: root
    group: root
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  command: setcap cap_ipc_lock=ep /usr/bin/vault
  args:
    warn: no
    changed_when: False

- name: Touch vault.env
  file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    mode: 0644
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  file:
    path: /usr/lib/systemd/system
    state: directory
    mode: 0755

- name: Copy Vault service file
  template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: 0644
  notify: Daemon reload
  when: ansible_service_mgr == 'systemd'

- name: Copy vault configuration
  copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: 0644
  notify: Restart vault

- name: Flush handlers
  meta: flush_handlers


