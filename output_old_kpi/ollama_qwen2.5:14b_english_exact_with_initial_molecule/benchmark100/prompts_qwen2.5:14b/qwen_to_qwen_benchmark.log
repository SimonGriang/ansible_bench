---
- name: Ensure the unzip package is available on the target system
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop:
    - unzip
  when: ansible_os_family == "Debian"
  become: yes
  register: result
  changed_when: result.changed
  notify: update package cache

- name: Ensure the unzip package is available on the target system
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop:
    - unzip
  when: ansible_os_family == "RedHat"
  become: yes
  register: result
  changed_when: result.changed

- name: Create a system group for promtail
  ansible.builtin.group:
    name: promtail
    system: yes
    state: present
  become: yes
  when: ansible_group_by_name.promtail is not defined

- name: Create the promtail user
  ansible.builtin.user:
    name: promtail
    system: yes
    group: promtail
    state: present
  become: yes
  when: ansible_user_by_name.promtail is not defined

- name: Ensure the /usr/local/bin directory exists
  ansible.builtin.file:
    path: /usr/local/bin
    state: directory
    mode: '0755'
  become: yes

- name: Create config directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0750'
    owner: promtail
    group: promtail
  loop:
    - /etc/promtail
    - /etc/promtail/tls
  become: yes

- name: Create application directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    mode: '0750'
    owner: promtail
    group: promtail
  loop:
    - /opt/promtail
    - /var/lib/promtail
  become: yes

- name: Check if the promtail binary exists
  ansible.builtin.stat:
    path: /opt/promtail/promtail
  register: promtail_binary_exists
  changed_when: false

- name: Download promtail binaries
  ansible.builtin.get_url:
    url: "{{ promtail_binary_url }}"
    dest: /tmp/promtail.tar.gz
    mode: '0750'
    owner: promtail
    group: promtail
  when: promtail_binary_exists.stat.exists == False and promtail_binary_local_distribution == False and promtail_binary_propagation == True
  become: yes
  register: download_result
  changed_when: download_result.changed

- name: Propagate locally distributed promtail archive
  ansible.builtin.copy:
    src: "{{ promtail_binary_source }}"
    dest: /tmp/promtail.tar.gz
    mode: '0750'
    owner: promtail
    group: promtail
  when: promtail_binary_exists.stat.exists == False and promtail_binary_local_distribution == True and promtail_binary_propagation == False
  become: yes
  register: copy_result
  changed_when: copy_result.changed

- name: Download promtail binaries to controller node
  ansible.builtin.get_url:
    url: "{{ promtail_binary_url }}"
    dest: /tmp/promtail.tar.gz
    mode: '0750'
