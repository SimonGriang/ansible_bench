---
- import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/my.cnf
    line: "{{ item.value }}"
    regexp: "{{ item.regexp | default(None) }}"
  loop: "{{ mysql_configuration_options | dict2items }}"
  when: item.value is defined

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/conf.d/client.cnf
    line: "socket={{ mysql_socket }}"

- name: Initialize mysql
  command: mysqld --initialize-insecure
  when:
    - ansible_distribution == 'Alpine'
    - ansible_os_family == 'Archlinux'

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    dest: /etc/mysql/conf.d/my.cnf
    content: "{{ mycnf_content }}"
    mode: 0644

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases | map('query', 'lookup', 'mysql_databases') | map(attribute='name') | list }}"
  when: "'initial_import' not in item

- name: List databases
  command: mysql -u root -Bse 'show databases;'
  register: db_list
  changed_when: false

- name: Import database
  command: mysql -u root {{ item.name }} < {{ item.file }}
  loop: "{{ mysql_databases | map('query', 'lookup', 'mysql_databases') | map('query', 'select', 'name', 'file') | list }}"
  when: "'initial_import' in item

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers
  meta: flush_handlers

- name: Flush handlers again
  meta: flush_handlers


