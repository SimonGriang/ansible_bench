---
- name: Ensure apt key is not present in trusted.gpg.d
  apt_key:
    keyid: "{{ docker_keyid }}"
    state: absent

- name: Ensure old apt source list is not present in /etc/apt/sources.list.d
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure old versions of Docker are not installed
  package:
    name: "{{ docker_package_name }}"
    state: absent

- name: Ensure legacy repo file is not present
  file:
    path: /etc/apt/sources.list.d/docker.list
    state: absent

- name: Ensure dependencies are installed
  package:
    name:
      - apt-transport-https
      - ca-certificates
      - python3-debian
    state: present

- name: Add or remove Docker repository
  block:
    - name: Remove Docker repository
      apt_repository:
        repo: "deb https://download.docker.com/linux/{{ ansible_distribution|lower }} {{ docker_apt_repo_codename }} stable"
        state: absent
      when: docker_add_repo == "false"
      notify: update_apt_cache

    - name: Add Docker repository
      apt_repository:
        repo: "deb https://download.docker.com/linux/{{ ansible_distribution|lower }} {{ docker_apt_repo_codename }} stable"
        key_OPTS:
          keyserver: keyserver.ubuntu.com
          key: "{{ docker_gpg_key }}"
        state: present
      when: docker_add_repo == "true"
      notify: update_apt_cache

- name: Ensure handlers are notified immediately to update the apt cache
  meta: flush_handlers


