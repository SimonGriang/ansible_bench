- name: Install DEB
  when: java_package == "deb"
  package:
    name: /path/to/java.deb
    state: present

- name: Install oracle java (rpm) (repository)
  when: java_package == "rpm" and java_repository is defined
  yum:
    name: "{{ java_repository }}"
    state: present

- name: Configure oracle targz
  when: java_package == "targz"
  become: yes
  block:
    - name: Ensure installation directory exists
      file:
        path: /usr/java
        state: directory
        mode: '0755'
    - name: Extract Oracle Java TARGZ package
      unarchive:
        src: /path/to/java.tar.gz
        dest: /usr/java
        remote_src: yes

- name: Install oracle java policy software (targz)
  when: java_package == "targz" and java_version is version("8", "<")
  become: yes
  block:
    - name: Extract JCE policy files
      unarchive:
        src: /path/to/jce_policy.zip
        dest: /usr/java/{{ java_version }}/jre/lib/security
        remote_src: yes
    - name: Update permissions for JCE policy files
      file:
        path: /usr/java/{{ java_version }}/jre/lib/security/local_policy.jar
        mode: '0644'
      args:
        path: /usr/java/{{ java_version }}/jre/lib/security/us_export_policy.jar
        mode: '0644'

- name: Set alternative (targz)
  when: java_package == "targz" and ansible_facts['ansible_distribution'] != "Alpine"
  become: yes
  block:
    - name: Create java symlink
      file:
        path: /usr/bin/java
        src: /usr/java/{{ java_version }}/bin/java
        state: link
        force: yes

- name: Find JAVA_HOME
  command: readlink -f /usr/bin/java
  changed_when: false
  register: java_home_output
  when: java_package == "targz"

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: "JAVA_HOME={{ java_home_output.stdout }}"
  when: java_package == "targz"


