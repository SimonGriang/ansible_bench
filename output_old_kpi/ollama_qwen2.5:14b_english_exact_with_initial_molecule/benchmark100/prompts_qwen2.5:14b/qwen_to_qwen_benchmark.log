---
- name: Cordon and Drain the node {{ rke2_node_name }}
  kubectl:
    command: drain
    args: >
      --node-name={{ rke2_node_name }}
      --delete-local-data=true
      --ignore-daemonsets=true
      --force=true
      --timeout=30s
      {{ rke2_drain_additional_args }}
  register: drain_node_result
  until: "'{{ drain_node_result.stdout }}' | search('errors to fix before') or '{{ drain_node_result.stdout }}' | search(' drained.')"
  retries: 100
  delay: 15

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  kubectl:
    command: get
    args: "nodes --no-headers"
  register: nodes_status
  until: "'{{ nodes_status.stdout }}' | grep -q -v 'NotReady'"
  retries: 100
  delay: 15

- name: Uncordon the node {{ rke2_node_name }}
  kubectl:
    command: uncordon
    args: "{{ rke2_node_name }}"
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  kubectl:
    command: get
    args: "pods --all-namespaces -o json"
  register: pods_status
  until: >
    '{{ pods_status.stdout }}' | jq -r '.items[] | select(.status.containerStatuses[].ready == true) | .metadata.name' | grep -q .
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  kubectl:
    command: wait
    args: >
      --for=condition=Ready=true
      --timeout=30s
      pod
      --all-namespaces
  register: pods_health
  until: "'{{ pods_health.stderr }}' | search('timed out waiting for the condition')"
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy


