---
- name: Check if the system is EFI
  stat:
    path: /sys/firmware/efi/efivars
  register: efi_system

- name: Remove the grub.cfg file if the system is EFI
  file:
    path: /boot/grub2/grub.cfg
    state: absent
  when: efi_system.stat.exists

- name: Install a user template for GRUB
  copy:
    src: 01_users
    dest: /etc/grub.d/01_users
    owner: root
    group: root
    mode: 0700
  notify: update-grub

- name: Add a password to the EFI GRUB configuration
  lineinfile:
    path: /etc/grub2-efi.cfg
    regexp: '^set superusers="root"'
    line: "set superusers=\"root\""
    insertafter: '^set superusers='
  notify: update-grub
  when: efi_system.stat.exists

- name: Add a password to the MBR GRUB configuration
  lineinfile:
    path: /etc/grub2.cfg
    regexp: '^set superusers="root"'
    line: "set superusers=\"root\""
    insertafter: '^set superusers='
  notify: update-grub
  when: not efi_system.stat.exists

- name: Add --unrestricted option to specified files
  lineinfile:
    path: "{{ item }}"
    regexp: 'CLASS="([^"]*)"'
    line: 'CLASS="{{ lookup("env", "BASH_ENV") }} --unrestricted"'
  notify: update-grub
  when: grub_password_unrestricted is defined and grub_password_unrestricted
  with_items: "{{ grub_password_unrestricted_files }}"


