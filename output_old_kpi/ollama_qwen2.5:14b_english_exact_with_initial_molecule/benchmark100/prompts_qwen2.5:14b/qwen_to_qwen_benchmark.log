---
- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_binary_exists

- name: Check Helm version
  command: /usr/local/bin/helm version --short
  when: helm_binary_exists.stat.exists
  register: helm_version
  changed_when: false

- name: Download helm
  get_url:
    url: "https://get.helm.sh/helm-v{{ helm_version.stdout.split('v')[-1] }}-{{ ansible_system }}-amd64.tar.gz"
    dest: /tmp/helm.tar.gz
  when: not helm_binary_exists.stat.exists or helm_version is undefined

- name: Copy helm binary into place
  copy:
    src: /tmp/helm.tar.gz
    dest: /usr/local/bin/helm
    mode: '0755'
  when: not helm_binary_exists.stat.exists or helm_version.stdout == ""
  register: copy_helm
  notify: cleanup_temp_files

- name: Extract helm binary
  unarchive:
    src: /tmp/helm.tar.gz
    dest: /usr/local/bin/
    remote_src: yes
    creates: /usr/local/bin/helm
  when: not helm_binary_exists.stat.exists or helm_version.stdout == ""

- name: Remove downloaded helm tarball
  file:
    path: /tmp/helm.tar.gz
    state: absent
  notify: cleanup_temp_files

handlers:
  - name: cleanup_temp_files
    file:
      path: /tmp/helm.tar.gz
      state: absent


