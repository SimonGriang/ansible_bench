---
- name: Create etcd group
  ansible.builtin.group:
    name: etcd
    state: present
    system: true
  when: "'etcd' not in groups"

- name: Create etcd user
  ansible.builtin.user:
    name: etcd
    comment: 'etcd user'
    group: etcd
    shell: /bin/nologin
    system: true
  when: "'etcd' not in user_groups('etcd')"

- name: Copy systemctl config file for kernel hardening
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/sysctl.d/60-rke2-cis.conf
    mode: '0600'
  with_items:
    - /usr/local/share/rke2/rke2-cis-sysctl.conf
    - /opt/rke2/share/rke2/rke2-cis-sysctl.conf
  when: "'/usr/local' is writable or not part_of_partition('/usr/local', '/')"
  notify: restart_systemd_sysctl

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers: true


