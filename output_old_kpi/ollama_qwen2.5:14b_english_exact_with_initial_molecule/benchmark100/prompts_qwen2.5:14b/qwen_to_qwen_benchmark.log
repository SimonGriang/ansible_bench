---
- name: Check current docker-compose version
  command: docker-compose --version
  register: current_docker_compose_version

- name: Set fact for current Docker Compose version
  set_fact:
    current_docker_compose_version: "{{ current_docker_compose_version.stdout.split(' version ')[1].split(',')[0] }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: current_docker_compose_version.stdout is defined and current_docker_compose_version.stdout != 'version {{ docker_compose_version }}'

- name: Install Docker Compose (if configured)
  block:
    - name: Download Docker Compose binary
      get_url:
        url: https://github.com/docker/compose/releases/download/{{ docker_compose_version }}/docker-compose-{{ docker_compose_version }}-linux-x86_64
        dest: /usr/local/bin/docker-compose
        mode: '0755'

    - name: Verify Docker Compose installation
      command: docker-compose --version
      register: installed_docker_compose_version
      changed_when: installed_docker_compose_version.stdout != current_docker_compose_version.stdout
  when: current_docker_compose_version.stdout is undefined or current_docker_compose_version.stdout != 'version {{ docker_compose_version }}'


