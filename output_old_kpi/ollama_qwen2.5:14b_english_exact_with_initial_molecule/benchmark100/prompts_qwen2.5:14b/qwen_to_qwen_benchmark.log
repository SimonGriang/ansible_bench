content='---\n- name: Ensure document root directories are created for each virtual host\n  file:\n    path: "{{ item.document_root }}"\n    state: directory\n    mode: \'0755\'\n    create: "{{ item.create_docroot|default(true) }}"\n  loop: "{{ httpd_vhosts }}"\n  when: item.document_root is defined\n\n- name: Create virtual host configuration files\n  template:\n    src: vhost_conf_template\n    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"\n    mode: \'0644\'\n  loop: "{{ httpd_vhosts }}"\n  notify: test_apache_conf\n  notify: restart_apache_server\n\n- name: Enable virtual hosts on Debian-based systems\n  command: a2ensite "{{ item.name }}"\n  args:\n    creates: "{{ item.name }}"\n  loop: "{{ httpd_vhosts }}"\n  when: ansible_os_family == \'Debian\'\n  notify: test_apache_conf\n  notify: restart_apache_server' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-01T10:54:53.089131534Z', 'done': True, 'done_reason': 'stop', 'total_duration': 3224288789, 'load_duration': 66300727, 'prompt_eval_count': 502, 'prompt_eval_duration': 104486040, 'eval_count': 210, 'eval_duration': 3044346808, 'model_name': 'qwen2.5:14b'} id='run--976b33be-0468-43fd-8dfc-758593e9cfaa-0' usage_metadata={'input_tokens': 502, 'output_tokens': 210, 'total_tokens': 712}
