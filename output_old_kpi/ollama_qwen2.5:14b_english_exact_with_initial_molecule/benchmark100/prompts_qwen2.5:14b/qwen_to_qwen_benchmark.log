---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0700'
    timeout: 60

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_install_script_local }}"
    dest: "{{ rke2_install_script_path }}"
    mode: '0700'
    force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_dir }}"
    mode: '0700'
    state: directory
  when: rke2_airgap_mode and rke2_airgap_implementation != 'exists'

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum file
      get_url:
        url: "{{ rke2_checksum_url }}"
        dest: "{{ rke2_checksum_path }}"
        mode: '0640'
        timeout: 60
    - name: Download RKE2 artifacts
      get_url:
        url: "{{ item }}"
        dest: "{{ rke2_artifacts_dir }}"
        mode: '0640'
        timeout: 60
      with_items: "{{ rke2_artifacts_list }}"
    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_path }}"
        mode: '0700'
        timeout: 60
  when: rke2_airgap_mode and rke2_airgap_implementation == "download"

- name: Rescue for failed download
  block:
    - name: Create directory for RKE2 artifacts
      file:
        path: "{{ rke2_artifacts_dir }}"
        mode: '0700'
        state: directory
    - name: Download RKE2 artifacts locally
      get_url:
        url: "{{ item }}"
        dest: "{{ rke2_artifacts_local }}"
        mode: '0640'
        timeout: 60
      with_items: "{{ rke2_artifacts_list }}"
    - name: Download RKE2 install script locally
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_local }}"
        mode: '0700'
        timeout: 60
    - name: Copy local RKE2 artifacts to remote
      copy:
        src: "{{ rke2_artifacts_local }}/{{ item }}"
        dest: "{{ rke2_artifacts_dir }}/{{ item }}"
        mode: '0640'
        force: yes
      with_items: "{{ rke2_artifacts_list }}"
  rescue:
    - debug:
        msg: "Failed to download RKE2 artifacts, trying local copies"
