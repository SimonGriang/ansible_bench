---
- ansible.builtin.import_tasks: assert.yml

- name: Install required packages
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  with_items: "{{ selinux_requirements }}"
  notify: gather_facts

- name: Flush handlers
  ansible.builtin.meta: flush_handlers

- name: Configure selinux
  block:
    - name: Manage selinux
      ansible.posix.selinux:
        policy: "{{ item.policy }}"
        state: "{{ item.state }}"
      notify: reboot_system
      loop: "{{ selinux_config }}"
      when:
        - selinux_status.status is defined
        - selinux_status.enabled is defined
        - selinux_status.type is defined
        - selinux_status.status is True
        - selinux_status.enabled is True
        - selinux_status.type is not None

    - name: Manage selinux booleans
      ansible.posix.seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persitent | default('yes') }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.name }}"


