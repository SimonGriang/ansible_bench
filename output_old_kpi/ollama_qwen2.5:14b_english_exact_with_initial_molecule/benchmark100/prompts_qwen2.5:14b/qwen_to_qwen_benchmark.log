---
- name: Check if python is installed
  command: which python
  register: python_check
  changed_when: false
  failed_when: false

- name: Check if python3 is installed
  command: which python3
  register: python3_check
  changed_when: false
  failed_when: false

- name: Debug Python executable path
  debug:
    msg: "Python executable path: {{ python_check.stdout }}"
  when: python_check.stdout is defined

- name: Debug Python3 executable path
  debug:
    msg: "Python3 executable path: {{ python3_check.stdout }}"
  when: python3_check.stdout is defined

- name: Import assert.yml
  import_tasks: assert.yml

- name: Install requirements
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_requirements }}"

- name: Ensure packaging is available via dnf
  package:
    name: python3-packaging
    state: present

- name: Install pip packages
  pip:
    name: "{{ item }}"
    state: present
  loop: "{{ openssl_pip_packages }}"

- name: Create key directory
  file:
    path: /etc/ssl/private
    state: directory
    owner: root
    group: root
    mode: '0700'

- name: Create csr directory
  file:
    path: /etc/ssl/csr
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Create crt directory
  file:
    path: /etc/ssl/crt
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Include create.yml
  include_tasks: create.yml
  loop: "{{ openssl_items }}"


