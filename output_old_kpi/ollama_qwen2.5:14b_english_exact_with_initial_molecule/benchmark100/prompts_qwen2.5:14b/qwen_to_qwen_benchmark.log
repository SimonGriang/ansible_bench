---
- name: create | Create ssl key
  openssl_privatekey:
    path: "{{ item.key_path }}"
    cipher: "{{ item.key_cipher | default('AES-256-CBC') }}"
    mode: '0600'
    owner: "{{ item.key_owner | default('root') }}"
    group: "{{ item.key_group | default('root') }}"
  loop: "{{ ssl_items }}"
  register: ssl_key_result

- name: create | Create ssl csr
  openssl_csr:
    path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    common_name: "{{ item.common_name }}"
    mode: '0600'
    owner: "{{ item.csr_owner | default('root') }}"
    group: "{{ item.csr_group | default('root') }}"
  loop: "{{ ssl_items }}"
  register: ssl_csr_result

- name: create | Create ssl certificates
  openssl_certificate:
    path: "{{ item.cert_path }}"
    provider: selfsigned
    privatekey_path: "{{ item.key_path }}"
    csr_path: "{{ item.csr_path }}"
    mode: '0600'
    owner: "{{ item.cert_owner | default('root') }}"
    group: "{{ item.cert_group | default('root') }}"
  loop: "{{ ssl_items }}"
  register: ssl_cert_result

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ item.pkcs12_path }}"
    name: "{{ item.common_name }}"
    certificate: "{{ item.cert_path }}"
    privatekey: "{{ item.key_path }}"
    mode: '0600'
    owner: "{{ item.pkcs12_owner | default('root') }}"
    group: "{{ item.pkcs12_group | default('root') }}"
  loop: "{{ ssl_items }}"
  register: ssl_pkcs12_result

- name: create | Read private key
  slurp:
    src: "{{ item.key_path }}"
  loop: "{{ ssl_items }}"
  register: ssl_key_data

- name: create | Read certificate
  slurp:
    src: "{{ item.cert_path }}"
  loop: "{{ ssl_items }}"
  register: ssl_cert_data

- name: create | Create combined private_key and certificate file
  copy:
    content: "{{ item.key_data.content + '\n' + item.cert_data.content | b64decode }}"
    dest: "{{ item.combined_path }}"
    mode: '0600'
    owner: "{{ item.combined_owner | default('root') }}"
    group: "{{ item.combined_group | default('root') }}"
  loop: "{{ ssl_items }}"
  vars:
    item.key_data: "{{ ssl_key_data.results[item.index].result }}"
    item.cert_data: "{{ ssl_cert_data.results[item.index].result }}"
  register: ssl_combined_result


