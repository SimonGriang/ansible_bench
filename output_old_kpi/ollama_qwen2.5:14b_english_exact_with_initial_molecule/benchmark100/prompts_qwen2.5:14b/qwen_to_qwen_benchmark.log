---
- import_tasks: assert.yml

- name: Pre-configure debian systems
  lineinfile:
    path: /etc/postfix/main.cf
    regexp: '^main_mailer_type='
    line: 'main_mailer_type = No configuration'
  when: ansible_os_family == "Debian"

- name: Install postfix
  apt:
    name: postfix
    state: present
  when: ansible_os_family == "Debian"

- name: Install postfix-mysql
  apt:
    name: postfix-mysql
    state: present
  when: postfix_virtual_mailbox_maps is defined or postfix_virtual_mailbox_domains is defined or postfix_virtual_alias_maps is defined

- name: Configure postfix (transport_maps)
  template:
    src: postfix_transport_maps.j2
    dest: /etc/postfix/transport
  notify: validate_transport_maps
  notify: rebuild_transport_maps

- name: Configure postfix (header_checks)
  template:
    src: postfix_header_checks.j2
    dest: /etc/postfix/header_checks
  notify: validate_header_checks
  notify: reload_postfix

- name: Setting values for main.cf (1/2)
  set_fact:
    smtpd_recipient_restrictions: "{{ smtpd_recipient_restrictions }}"
    smtpd_sender_restrictions: "{{ smtpd_sender_restrictions }}"
  when: smtpd_recipient_restrictions is defined or smtpd_sender_restrictions is defined

- name: Setting values for main.cf (2/2)
  set_fact:
    mynetworks: "{{ mynetworks }}"
    mydestination: "{{ mydestination }}"
    relay_domains: "{{ relay_domains }}"
    virtual_mailbox_domains: "{{ virtual_mailbox_domains }}"
    virtual_alias_domains: "{{ virtual_alias_domains }}"
  when: mynetworks is defined or mydestination is defined or relay_domains is defined or virtual_mailbox_domains is defined or virtual_alias_domains is defined

- name: Configure postfix (main.cf)
  template:
    src: postfix_main.cf.j2
    dest: /etc/postfix/main.cf
  notify: validate_main_cf
  notify: restart_postfix

- name: Configure postfix (master.cf)
  template:
    src: postfix_master.cf.j2
    dest: /etc/postfix/master.cf
  notify: validate_master_cf
  notify: restart_postfix

- name: Creates cert/key directory
  file:
    path: "{{ item }}"
    state: directory
    mode: '0700'
  with_items:
    - "{{ postfix_smtpd_tls_cert_file | dirname }}"
    - "{{ postfix_smtpd_tls_key_file | dirname }}"

- name: Deploy Postfix TLS server certificate
  copy:
    src: "{{ postfix_smtpd_tls_cert_file | basename }}"
    dest: "{{ postfix_smtpd_tls_cert_file }}"
    mode: '0644'
  notify: reload_postfix

- name: Deploy Postfix TLS server key
  copy:
    src: "{{ postfix_smtpd_tls_key_file | basename }}"
    dest: "{{ postfix_smtpd_tls_key_file }}"
    mode: '0600'
  notify: reload_postfix

- name: Flush handlers
  meta: flush_handlers

- name: Configure aliases
  copy:
    src: /etc/postfix/aliases
    dest: /etc/postfix/aliases
  notify: rebuild_alias_database
  notify: reload_postfix

- name: Configure sender_access
  copy:
    src: /etc/postfix/sender_access
    dest: /etc/postfix/sender_access
  notify: rebuild_sender_access_database
  notify: reload_postfix

- name: Configure recipient_access
  copy:
    src: /etc/postfix/recipient_access
    dest: /etc/postfix/recipient_access
  notify: validate_recipient_access
  notify: rebuild_recipient_access_database
  notify: reload_postfix

- name: Place sasl_password_map
  copy:
    content: "{{ sasl_password_map }}"
    dest: /etc/postfix/sasl_password_map
  notify: rebuild_sasl_password_map_database

- name: Flush handlers again
  meta: flush_handlers

- name: Start and enable postfix
  systemd:
    name: postfix
    enabled: yes
    state: started


