---
- name: Cordon and Drain the node {{ rke2_node_name }}
  kubectl:
    command: drain
    args: "--node-name={{ rke2_node_name }} --delete-local-data=true --ignore-daemonsets=true --force=true --timeout=30s {{ rke2_drain_additional_args }}"
  register: drain_node_result
  until: "'{{ drain_node_result.stdout }}' | search('errors to fix before' or ' drained.')"
  retries: 100
  delay: 15

- name: Restart RKE2 service on {{ rke2_node_name }}
  service:
    name: rke2
    state: restarted
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  kubectl:
    command: get
    args: "nodes --no-headers | grep -v NotReady"
  register: nodes_ready
  until: nodes_ready.stdout.find("NotReady") == -1
  retries: 100
  delay: 15

- name: Uncordon the node {{ rke2_node_name }}
  kubectl:
    command: uncordon
    args: "{{ rke2_node_name }}"
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  kubectl:
    command: get
    args: "pods --all-namespaces -o json | jq -r '.items[] | select(.status.containerStatuses[].ready == true) | .metadata.name'"
  register: pods_ready
  until: pods_ready.stdout.find("null") == -1
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  kubectl:
    command: wait
    args: "--for=condition=Ready=true --timeout=30s pod --all-namespaces"
  register: pods_healthy
  until: "'{{ pods_healthy.stderr }}' | search('timed out waiting for the condition')"
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy


