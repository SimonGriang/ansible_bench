    - Systemctl daemon-reexec

- name: Configure mysql server
  lineinfile:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-server.cnf"
    line: "{{ item.option }} = {{ item.value }}"
    create: true
  loop: "{{ mysql_configuration_options }}"
  notify: restart_mysql_server

- name: Configure mysql client
  lineinfile:
    path: "{{ mysql_configuration_destination }}/{{ mysql_name }}-client.cnf"
    line: "socket = {{ mysql_socket }}"
    create: true

- name: Initialize mysql
  command: "{{ mysql_initialize_command }}"
  when: ansible_facts['os_family'] in ['Alpine', 'Archlinux']

- name: Start and enable mysql
  service:
    name: "{{ mysql_service }}"
    enabled: yes
    state: started

- name: Flush handlers
  meta: flush_handlers

- name: Place my.cnf
  template:
    src: my.cnf.j2
    dest: /root/.my.cnf
    owner: root
    group: root
    mode: '0600'

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases }}"
  become: yes

- name: Create users
  mysql_user:
    name: "{{ item.name }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    state: present
  loop: "{{ mysql_users }}"
  become: yes

- name: Flush handlers again
  meta: flush_handlers


