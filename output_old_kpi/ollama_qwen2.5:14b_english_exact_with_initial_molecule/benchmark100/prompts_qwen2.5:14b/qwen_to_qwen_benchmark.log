---
- import_tasks: assert.yml

- name: Install git
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ git_packages }}"
  no_log: false

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_user }}"
  register: user_exists

- name: Create directory for git configuration
  file:
    path: "~{{ git_user }}/.gitconfig.d"
    state: directory
    mode: '0755'
  when: user_exists is defined and user_exists.is_key_present and git_config_dir is defined

- name: Place git configuration
  copy:
    dest: "{{ git_config_dir }}/{{ item.key }}.conf"
    content: "{{ item.value }}"
    mode: '0644'
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  loop: "{{ git_config|default([]) }}"
  when: user_exists is defined and user_exists.is_key_present and git_config_dir is defined and item is defined

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    mode: '0755'
  when: repository_destination is defined and user_exists is defined and user_exists.is_key_present

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}/{{ item.name }}"
    version: "{{ item.version }}"
    accept_hostkey: yes
    force: yes
  loop: "{{ git_repositories }}"
  become: "{{ item.get('become', 'false') | bool }}"
  become_user: "{{ item.become_user | default('') }}"


