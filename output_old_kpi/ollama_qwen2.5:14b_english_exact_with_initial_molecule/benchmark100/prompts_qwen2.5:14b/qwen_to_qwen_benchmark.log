      $InputFilePollInterval 10
      $InputFileTag cron-log:
      $InputFileName /var/log/cron/cron.log
      $InputFileStateFile cron-log-state
      $InputFilePersistState TRUE
      $InputFileSeverity info
      $InputFileFacility local0
      $InputRunFileMonitor
    mode: '0644'
  when: cron_service is defined and cron_service != ""
  notify: restart cron

- name: Ensure cron log rotation is monitored by rsyslog
  systemd:
    name: rsyslog
    enabled: yes
