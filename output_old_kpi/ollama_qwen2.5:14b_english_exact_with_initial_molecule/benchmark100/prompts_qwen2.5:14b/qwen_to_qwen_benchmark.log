rue, 'done_reason': 'stop', 'total_duration': 11399063937, 'load_duration': 72115798, 'prompt_eval_count': 1289, 'prompt_eval_duration': 333028440, 'eval_count': 562, 'eval_duration': 10987266730, 'model_name': 'qwen2.5:14b'} id='run--51fae87f-0455-43c4-a773-46043296ce99-0' usage_metadata={'input_tokens': 1289, 'output_tokens': 562, 'total_tokens': 1851}
