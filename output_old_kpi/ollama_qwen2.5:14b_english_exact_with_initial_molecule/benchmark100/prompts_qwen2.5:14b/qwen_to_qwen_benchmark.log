    move_home: "{{ user.move_home|default(false) }}"
    generate_ssh_key: "{{ user.generate_ssh_key|default(false) }}"
    ssh_key_file: "{{ user.ssh_key_file|default('') }}"
    ssh_key_type: "{{ user.ssh_key_type|default('rsa') }}"
    ssh_key_bits: "{{ user.ssh_key_bits|default('2048') }}"
