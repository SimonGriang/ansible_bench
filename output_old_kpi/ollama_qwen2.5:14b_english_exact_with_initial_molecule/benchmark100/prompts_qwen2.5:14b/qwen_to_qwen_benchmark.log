---
- name: Create document root directories for each virtual host
  file:
    path: "{{ item.documentroot }}"
    state: directory
    mode: '0755'
  loop: "{{ httpd_vhosts }}"
  when: item.create_docroot | default(true)

- name: Configure virtual hosts using a template
  template:
    src: "{{ vhost_conf_template }}"
    dest: "{{ httpd_vhosts_directory }}/{{ item.name }}.conf"
  loop: "{{ httpd_vhosts }}"
  notify: 
    - test httpd configuration
    - restart httpd service

- name: Test httpd configuration
  command: apachectl configtest
  when: ansible_facts.services['httpd'].state == 'started'

- name: Restart httpd service
  service:
    name: httpd
    state: restarted
  when: ansible_facts.services['httpd'].state == 'started'


