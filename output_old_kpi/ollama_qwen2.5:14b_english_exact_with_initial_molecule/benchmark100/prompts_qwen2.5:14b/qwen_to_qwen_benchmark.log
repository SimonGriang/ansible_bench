---
- name: Ensure old versions of Docker are not installed
  yum:
    name: docker
    state: absent
  when: ansible_os_family == 'RedHat' and ansible_distribution_major_version == '7'
- name: Ensure old versions of Docker are not installed
  apt:
    name: docker
    state: absent
  when: ansible_os_family == 'Debian' and ansible_distribution_major_version == '7'
- name: Add Docker GPG key
  apt_key:
    url: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg
    state: present
  when: ansible_os_family == 'Debian'
- name: Add Docker GPG key
  rpm_key:
    key: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg
    state: present
  when: ansible_os_family == 'RedHat'
- name: Add Docker repository
  apt_repository:
    repo: "deb [arch=amd64] https://download.docker.com/linux/{{ ansible_os_family | lower }} {{ ansible_distribution_release }}/stable docker"
    state: present
  when: ansible_os_family == 'Debian'
- name: Add Docker repository
  yum_repository:
    name: docker
    description: Docker Repository
    baseurl: https://download.docker.com/linux/{{ ansible_os_family | lower }}/{{ ansible_distribution_release }}/stable
    enabled: true
    gpgcheck: true
    gpgkey: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg
  when: ansible_os_family == 'RedHat'
- name: Configure Docker Nightly repo
  apt_repository:
    repo: "deb [arch=amd64] https://download.docker.com/linux/{{ ansible_os_family | lower }} {{ ansible_distribution_release }}/nightly docker"
    state: present
  when: docker_repo_nightly
- name: Configure Docker Nightly repo
  yum_repository:
    name: docker-nightly
    description: Docker Nightly Repository
    baseurl: https://download.docker.com/linux/{{ ansible_os_family | lower }}/{{ ansible_distribution_release }}/nightly
    enabled: true
    gpgcheck: true
    gpgkey: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg
  when: docker_repo_nightly
- name: Configure Docker Test repo
  apt_repository:
    repo: "deb [arch=amd64] https://download.docker.com/linux/{{ ansible_os_family | lower }} {{ ansible_distribution_release }}/test docker"
    state: present
  when: docker_repo_test
- name: Configure Docker Test repo
  yum_repository:
    name: docker-test
    description: Docker Test Repository
    baseurl: https://download.docker.com/linux/{{ ansible_os_family | lower }}/{{ ansible_distribution_release }}/test
    enabled: true
    gpgcheck: true
    gpgkey: https://download.docker.com/linux/{{ ansible_os_family | lower }}/gpg
  when: docker_repo_test
- name: Configure containerd on RHEL 8
  block:
    - name: Ensure runc is not installed
      yum:
        name: runc
        state: absent
    - name: Install container-selinux
      yum:
        name: container-selinux
        state: present
    - name: Install containerd.io
      yum:
        name: containerd.io
        state: present
  when: ansible_distribution_major_version == '8' and ansible_os_family == 'RedHat'


