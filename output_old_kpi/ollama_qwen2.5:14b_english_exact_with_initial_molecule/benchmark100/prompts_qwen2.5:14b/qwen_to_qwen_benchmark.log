---
- import_tasks: assert.yml
  remote_addr: localhost

- name: Install php
  package:
    name: "{{ php_packages }}"
    state: present

- name: Find used php.ini
  shell: php -r 'echo php_ini_loaded_file();'
  register: php_found_ini_location
  when: php_ini_location is not defined

- name: Configure php
  template:
    src: php.ini.j2
    dest: "{{ php_ini_location | default(php_found_ini_location.stdout, true) }}"
  notify: restart httpd


