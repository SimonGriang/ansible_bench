- name: Create local ssh_key_directory for {{ user.name }}
  file:
    path: "{{ user.ssh_key_dir }}"
    state: directory
    mode: 0750
  when: user.manage_ssh_key|default(false)
  run_once: true
  delegate_to: localhost
  become: no

- name: Manage user {{ user.name }}
  user:
    name: "{{ user.name }}"
    state: "{{ user.state }}"
    password: "{{ user.password }}"
    update_password: "{{ user.update_password|default('always') }}"
    uid: "{{ user.uid|default('') }}"
    gid: "{{ user.gid|default('') }}"
    groups: "{{ user.groups|default([]) }}"
