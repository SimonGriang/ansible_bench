---
- import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/cron
    line: "SHELL=/bin/bash"
    create: yes
    mode: '0644'
  notify: restart cron

- name: Configure path
  lineinfile:
    path: /etc/cron.d/cron
    line: "PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
    create: yes
    mode: '0644'
  notify: restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/cron
    line: "MAILTO={{ mailto }}"
    create: yes
    mode: '0644'
  notify: restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    enabled: yes
    state: started
  when: cron_service is defined and cron_service != ""

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    state: "{{ item.state }}"
  with_items: "{{ cron_jobs }}"
  when: cron_jobs is defined
  notify: restart cron

- name: Ensure cron.d directory exists
  file:
    path: /etc/cron.d
    state: directory
    mode: '0755'
  when: cron_jobs is defined

- name: Ensure cron user exists
  user:
    name: cron
    state: present
