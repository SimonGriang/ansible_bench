---
- name: Enable proxy and proxy_http modules on Debian and Suse systems
  ansible.builtin.a2enmod:
    modname: proxy
  when: ansible_facts['os_family'] == "Debian" or ansible_facts['os_family'] == "Suse"

- name: Enable proxy and proxy_http modules on Debian and Suse systems
  ansible.builtin.a2enmod:
    modname: proxy_http
  when: ansible_facts['os_family'] == "Debian" or ansible_facts['os_family'] == "Suse"

- name: Use the location.conf.j2 template to configure Apache location blocks
  ansible.builtin.template:
    src: location.conf.j2
    dest: "{{ item.destination }}"
    mode: '0644'
  with_items: "{{ httpd_locations }}"
  notify: httpd configuration test and restart


