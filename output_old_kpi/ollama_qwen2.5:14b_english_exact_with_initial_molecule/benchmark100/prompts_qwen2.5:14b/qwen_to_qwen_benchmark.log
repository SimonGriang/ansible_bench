---
- import_tasks: assert.yml
  run_once: true
  when: inventory_hostname == 'localhost'

- name: Install required packages
  package:
    name: "{{ grub_packages }}"
    state: present

- name: Set GRUB_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_TIMEOUT={{ grub_timeout }}"
    create: yes
    regexp: '^GRUB_TIMEOUT='
    insertafter: eof
  notify: Update grub

- name: Set GRUB_RECORDFAIL_TIMEOUT
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_RECORDFAIL_TIMEOUT={{ grub_recordfail_timeout }}"
    create: yes
    regexp: '^GRUB_RECORDFAIL_TIMEOUT='
    insertafter: eof
  notify: Update grub

- name: Add options to GRUB_CMDLINE_LINUX
  lineinfile:
    path: /etc/default/grub
    line: "GRUB_CMDLINE_LINUX=\"{{ item }}\""
    create: yes
    insertafter: eof
    regexp: '^GRUB_CMDLINE_LINUX='
  with_items: "{{ grub_options }}"
  notify: Update grub
  when: grub_options is defined and grub_options|length > 0

- name: Import password.yml
  import_tasks: password.yml
  when: grub_set_password is defined and grub_set_password is boolean

- name: Flush handlers
  meta: flush_handlers


