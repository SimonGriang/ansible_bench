- name: Install epel
  ansible.builtin.yum:
    name: epel-release
    state: latest
  when: ansible_os_family == "RedHat" and (ansible_distribution == "RedHat" or ansible_distribution == "CentOS" or ansible_distribution == "Fedora" or ansible_distribution == "Amazon")
  notify: update_package_cache

- name: Install epel gpg key
  ansible.builtin.yum:
    name: 'https://dl.fedoraproject.org/pub/epel/RPM-GPG-KEY-EPEL-{{ ansible_distribution_major_version }}'
    state: present
  notify: update_package_cache

- name: Install epel-release
  ansible.builtin.yum:
    name: epel-release
    state: present
  notify: update_package_cache

- name: Install epel-next-release
  ansible.builtin.yum:
    name: epel-next-release
    state: present
  when: epel_next | default(false)
  notify: update_package_cache


