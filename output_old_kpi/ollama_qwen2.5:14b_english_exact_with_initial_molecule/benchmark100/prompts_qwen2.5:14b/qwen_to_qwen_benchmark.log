  ansible.builtin.import_tasks: assert.yml

- name: Install fail2ban
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: "{{ fail2ban_packages }}"
  register: install_fail2ban_result

- name: Copy filters in filter.d
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: "/etc/fail2ban/filter.d/{{ item | basename }}"
    mode: '0644'
  loop: "{{ custom_filter_files }}"
  notify: restart_fail2ban

- name: Configure fail2ban.local
  ansible.builtin.lineinfile:
    path: /etc/fail2ban/fail2ban.local
    regexp: "{{ item.regexp }}"
    line: "{{ item.line }}"
    mode: '0644'
  loop: "{{ fail2ban_local_config }}"
  notify: restart_fail2ban

- name: Configure jail.local
  ansible.builtin.lineinfile:
    path: /etc/fail2ban/jail.local
    regexp: "{{ item.regexp }}"
    line: "{{ item.line }}"
    mode: '0644'
  loop: "{{ jail_local_config }}"
  notify: restart_fail2ban

- name: Stat auth log file
  ansible.builtin.stat:
    path: /var/log/auth.log
  register: auth_log_stat

- name: Touch auth log file
  ansible.builtin.file:
    path: /var/log/auth.log
    state: touch
    mode: '0640'
  when: auth_log_stat.stat.exists | bool

- name: Start and enable fail2ban
  ansible.builtin.systemd:
    name: "{{ fail2ban_service }}"
    enabled: yes
    state: started


