  notify: restart cron

- name: Ensure cron log rotation is monitored by syslog-ng
  copy:
    dest: /etc/syslog-ng/conf.d/cron.conf
    content: |
      source s_cron {
        file("/var/log/cron/cron.log" flush_lines(0));
      };
      filter f_cron {
        facility(local0);
      };
      destination d_cron {
