---
- name: Assert usage of systemd as an init system
  ansible.builtin.assert:
    that:
      - ansible_systemd is defined
      - ansible_systemd == True

- name: Get latest release of promtail
  ansible.builtin.uri:
    url: https://api.github.com/repos/grafana/loki/releases/latest
    return_content: True
    status_code: 200
  register: promtail_release
  changed_when: False
  vars:
    promtail_version: "{{ promtail_release.json.tag_name }}"

- name: Test if zip local archive exists
  ansible.builtin.stat:
    path: "{{ promtail_binary_local_dir }}/promtail-{{ promtail_version }}-linux-{{ go_arch }}.zip"
  register: promtail_archive_exists
  failed_when: False

- name: Assert local binary exists
  ansible.builtin.assert:
    that:
      - promtail_binary_local_dir is defined
      - promtail_archive_exists.stat is defined
      - promtail_archive_exists.stat.exists == True

- name: Get checksum list
  ansible.builtin.uri:
    url: "https://github.com/grafana/loki/releases/download/{{ promtail_version }}/checksums.txt"
    return_content: True
    status_code: 200
  register: promtail_checksums
  vars:
    checksum_lines: "{{ promtail_checksums.content.split('\n')[:100] }}"
    promtail_checksum: "{{ checksum_lines | select('search', 'promtail-linux-' ~ go_arch ~ '\\.') | first }}"

- name: Get checksum for specific architecture
  ansible.builtin.set_fact:
    promtail_checksum: "{{ promtail_checksum }}"


