- name: Configure redis
  template:
    src: "redis.conf.j2"
    dest: >
      "{{ 'debian': '/etc/redis/6379/redis.conf', 'redhat': '/etc/redis.conf' | lookup('dict', ansible_facts['os_family']) }}"
    owner: redis
    group: redis
    mode: '0644'
  notify: restart redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes


