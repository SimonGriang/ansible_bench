---
- name: Task 1: check if all variables have been set correctly
  assert:
    that:
      - bootstrap_var1 is defined
      - bootstrap_var2 is defined
      - bootstrap_var3 is defined
    fail_msg: "Required variables are not set correctly."

- name: Task 2: wait for host (when configured)
  wait_for:
    host: "{{ ansible_hostname }}"
    port: 22
    delay: 5
    timeout: 60
  when: bootstrap_wait_for_host|default(false)|bool

- name: Task 3: prepare system
  block:
    - name: Ensure connection to the host
      setup:
    - name: Gather bootstrap facts (raw)
      include_tasks: gather_bootstrap_facts.yml
  rescue:
    - name: Debug message
      debug:
        msg: "Failed to establish a connection to the host."

- name: Task 4: include tasks to gather bootstrap facts (raw)
  include_tasks: gather_bootstrap_facts.yml

- name: Task 5: Install bootstrap packages (raw)
  raw: "{{ bootstrap_install_raw }}"
  when: ansible_os_family == 'Debian' or ansible_os_family == 'RedHat'

- name: Task 6: ensure system is prepared by issuing ansible modules
  block:
    - name: Gather ansible facts
      setup:
    - name: Install bootstrap packages using ansible package module
      yum:
        name: "{{ item }}"
        state: present
      with_items: "{{ bootstrap_facts.packages }}"
      when: ansible_os_family == 'RedHat'
    - name: Install bootstrap packages using ansible package module
      apt:
        name: "{{ item }}"
        state: present
      with_items: "{{ bootstrap_facts.packages }}"
      when: ansible_os_family == 'Debian'


