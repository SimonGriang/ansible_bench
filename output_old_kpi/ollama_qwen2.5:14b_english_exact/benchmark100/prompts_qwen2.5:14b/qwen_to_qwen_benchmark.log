---
- import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ cron_packages | default([]) }}"
  loop_control:
    extended: true

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "SHELL={{ cron_shell }}"
    create: yes
    regexp: '^SHELL='
    state: present
    mode: '0600'
  notify: Restart cron

- name: Configure path
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "PATH={{ cron_path }}"
    create: yes
    regexp: '^PATH='
    state: present
    mode: '0600'
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    regexp: '^MAILTO='
