---
- import_tasks: assert.yml
  name: Import assert.yml file for validation purposes
  run_once: true
  remote_addr: localhost

- name: Install the Apache HTTPD server
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Modify SELinux booleans if SELinux is enabled
  when: ansible_facts | lookup('vars', 'selinux_booleans') is defined
  block:
    - name: Set custom ports for SELinux
      seboolean:
        name: httpd_can_network_connect_port{{ item }}
        state: on
      loop: "{{ selinux_ports }}"
    - name: Set other necessary SELinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
      with_items: "{{ selinux_booleans }}"

- name: Template the main httpd configuration file
  template:
    src: "{{ httpd_conf_src }}"
    dest: "{{ httpd_conf_dest }}"
  notify: test_httpd_service
  notify: restart_httpd_service

- name: Activate Apache modules using a2enmod on Debian
  command: a2enmod {{ item }}
  when: ansible_os_family == "Debian"
  with_items: "{{ httpd_modules }}"
  notify: test_httpd_service
  notify: restart_httpd_service

- name: Import ssl.yml tasks file if HTTPS SSL is enabled
  import_tasks: ssl.yml
  when: https_ssl_enabled

- name: Import locations.yml tasks file if there are defined locations
  import_tasks: locations.yml
  when: locations_defined

- name: Import vhosts.yml tasks file if there are defined virtual hosts
  import_tasks: vhosts.yml
  when: vhosts_defined

- name: Template the ports configuration file
  template:
    src: "{{ ports_conf_src }}"
    dest: "{{ ports_conf_dest }}"
  notify: test_httpd_service
  notify: restart_httpd_service
  when: ansible_os_family in ['Debian', 'Suse']

- name: Import directories.yml tasks file if there are defined directories
  import_tasks: directories.yml
  when: directories_defined

- name: Flush all handlers
  meta: flush_handlers

- name: Remove the default index.html file
  file:
    path: /var/www/html/index.html
    state: absent
  when: httpd_remove_example

- name: Start and enable the Apache service
  systemd:
    name: "{{ httpd_service }}"
    state: started
    enabled: yes


