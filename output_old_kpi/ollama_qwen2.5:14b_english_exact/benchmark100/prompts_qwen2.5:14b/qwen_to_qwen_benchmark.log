---
- import_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
  when: git_packages is defined

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_user }}"
  register: user_exists
  when: git_user is defined

- name: Create directory for git configuration
  file:
    path: "{{ git_config_dir }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: user_exists is succeeded and git_config_dir is defined

- name: Place git configuration
  copy:
    dest: "{{ git_config_dir }}/.gitconfig"
    content: |
      [user]
      name = {{ git_user }}
      email = {{ git_email }}
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: git_email is defined and user_exists is succeeded

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: repository_destination is defined and user_exists is succeeded

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}/{{ item.name }}"
    version: "{{ item.version }}"
    accept_hostkey: yes
    clone: yes
    update: yes
  with_items: "{{ git_repositories }}"
  become: yes
  become_user: "{{ git_user }}"
  when: git_repositories is defined and user_exists is succeeded


