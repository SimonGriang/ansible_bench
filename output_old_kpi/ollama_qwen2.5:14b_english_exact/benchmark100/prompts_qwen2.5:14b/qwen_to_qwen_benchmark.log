content='---\n- import_tasks: assert.yml\n\n- name: Install git\n  package:\n    name: "{{ git_packages }}"\n  when: git_packages is defined\n\n- name: See if the specified user exists\n  getent:\n    database: passwd\n    key: "{{ git_user }}"\n  register: user_exists\n  when: git_user is defined\n\n- name: Create directory for git configuration\n  file:\n    path: "{{ git_config_dir }}"\n    state: directory\n    owner: "{{ git_user }}"\n    group: "{{ git_user }}"\n  when: user_exists.succeeded and git_config_dir is defined\n\n- name: Place git configuration\n  copy:\n    dest: "{{ git_config_dir }}/.gitconfig"\n    content: |\n      [user]\n      name = {{ git_user }}\n      email = {{ git_email }}\n    owner: "{{ git_user }}"\n    group: "{{ git_user }}"\n  when: git_email is defined and user_exists.succeeded\n\n- name: Create repository_destination\n  file:\n    path: "{{ repository_destination }}"\n    state: directory\n    owner: "{{ git_user }}"\n    group: "{{ git_user }}"\n  when: repository_destination is defined and user_exists.succeeded\n\n- name: Clone all roles\n  git:\n    repo: "{{ item.repo }}"\n    dest: "{{ repository_destination }}/{{ item.name }}"\n    version: "{{ item.version }}"\n    accept_hostkey: yes\n    clone: yes\n    update: yes\n  loop: "{{ git_repositories }}"\n  become: yes\n  become_user: "{{ git_user }}"\n  when: git_repositories is defined and user_exists.succeeded' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-01T17:02:55.241655948Z', 'done': True, 'done_reason': 'stop', 'total_duration': 5929230565, 'load_duration': 81283473, 'prompt_eval_count': 910, 'prompt_eval_duration': 9074602, 'eval_count': 332, 'eval_duration': 5833049305, 'model_name': 'qwen2.5:14b'} id='run--962ab160-3e9b-4b04-9d48-50e5c1dcd71a-0' usage_metadata={'input_tokens': 910, 'output_tokens': 332, 'total_tokens': 1242}
_______________________________________Cleaned LLM Output:_______________________________________ 
---
- import_tasks: assert.yml

- name: Install git
  package:
    name: "{{ git_packages }}"
  when: git_packages is defined

- name: See if the specified user exists
  getent:
    database: passwd
    key: "{{ git_user }}"
  register: user_exists
  when: git_user is defined

- name: Create directory for git configuration
  file:
    path: "{{ git_config_dir }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: user_exists.succeeded and git_config_dir is defined

- name: Place git configuration
  copy:
    dest: "{{ git_config_dir }}/.gitconfig"
    content: |
      [user]
      name = {{ git_user }}
      email = {{ git_email }}
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: git_email is defined and user_exists.succeeded

- name: Create repository_destination
  file:
    path: "{{ repository_destination }}"
    state: directory
    owner: "{{ git_user }}"
    group: "{{ git_user }}"
  when: repository_destination is defined and user_exists.succeeded

- name: Clone all roles
  git:
    repo: "{{ item.repo }}"
    dest: "{{ repository_destination }}/{{ item.name }}"
    version: "{{ item.version }}"
    accept_hostkey: yes
    clone: yes
    update: yes
  loop: "{{ git_repositories }}"
  become: yes
  become_user: "{{ git_user }}"
  when: git_repositories is defined and user_exists.succeeded


