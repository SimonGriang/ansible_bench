---
- name: Install Ansible
  package:
    name: ansible
    state: "{{ ansible_package_state }}"
  become: yes
  vars:
    ansible_epel_repo_name: epel
  when: ansible_epel_repo_name is defined
  register: ansible_install_result
- name: Enable EPEL repository if not enabled
  yum:
    name: "{{ ansible_epel_repo_name }}"
    state: enabled
  become: yes
  when:
    - ansible_epel_repo_name is defined
    - ansible_install_result.changed
  tags:
    - ansible
    - package


