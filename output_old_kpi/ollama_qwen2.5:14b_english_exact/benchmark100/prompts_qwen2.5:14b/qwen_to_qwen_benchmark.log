---
- name: gather_facts | Lookup bootstrap facts
  get_url:
    url: "https://example.com/metadata/os-release"
    dest: /etc/os-release
  register: os_release_info

- name: gather_facts | Lookup bootstrap facts
  command: cat /etc/os-release
  register: os_release_content
  when: os_release_info is not defined or not os_release_info.changed

- name: gather_facts | Lookup bootstrap facts
  set_fact:
    os_release: "{{ os_release_content.stdout_lines }}"

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    bootstrap_distribution: "{{ item.value }}"
  loop:
    - {key: "ID", value: "{{ os_release.0.ID }}"}
    - {key: "VERSION_ID", value: "{{ os_release.0.VERSION_ID }}"}
  when: item.key is defined and item.value is defined

- name: gather_facts | Set bootstrap facts (I)
  set_fact:
    bootstrap_major_version: "{{ item.value | regex_replace('^([0-9]+).*$','\\1') }}"
  loop:
