---
- import_tasks: assert.yml

- name: Install dns
  package:
    name: "{{ dns_packages }}"
    state: present

- name: Create directories
  file:
    path: "{{ item.path }}"
    state: directory
    mode: "{{ item.mode }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop:
    - {path: "/etc/named", mode: "0750", owner: "root", group: "bind"}
    - {path: "/var/cache/bind", mode: "0770", owner: "named", group: "bind"}

- name: Create group
  group:
    name: bind
    system: true

- name: Create user
  user:
    name: named
    system: true
    group: bind
    create_home: no

- name: Generate rndc key
  command: named-rndc -g -k "{{ item.key_name }}" -s "{{ item.server }}" -p "{{ item.port }}"
  args:
    creates: /etc/bind/rndc.key
  register: rndc_key
  loop:
    - {key_name: "rndc-key", server: "localhost", port: "953"}
  loop_control:
    extended: true
  changed_when: "'key file exists' not in rndc_key.stdout"

- name: Set permissions on rndc key file
  file:
    path: /etc/bind/rndc.key
    mode: 0600
    owner: root
    group: bind

- name: Get the hints/root file
  get_url:
    url: "{{ hints_root_url }}"
    dest: /etc/bind/db.root
    mode: 0644

- name: Create zone file
  template:
    src: zone.j2
    dest: /etc/bind/db.{{ item }}
    mode: 0644
  loop: "{{ zone_files }}"

- name: Add zones to configuration
  template:
    src: named.conf.j2
    dest: /etc/bind/named.conf
    mode: 0644

- name: Place systemd override
  copy:
    src: named.service
    dest: /etc/systemd/system/named.service.d/override.conf
    mode: 0644

- name: Start and enable dns
  service:
    name: named
    state: started
    enabled: yes


