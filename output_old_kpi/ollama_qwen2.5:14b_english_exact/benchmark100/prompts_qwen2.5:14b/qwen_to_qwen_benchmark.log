---
- name: Create the RKE2 manifests directory
  ansible.builtin.file:
    path: /etc/rke2/manifests
    state: directory
    mode: '0750'

- name: Copy kube-vip files to first server
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/rke2/manifests/
    mode: '0644'
  with_items:
    - "kube-vip-dns.yaml.j2"
    - "kube-vip-service.yaml.j2"
  notify: restart rke2-server

- name: Copy kube-vip load balancer manifests to first server
  ansible.builtin.copy:
    src: "{{ item }}"
    dest: /etc/rke2/manifests/
    mode: '0644'
  with_items:
    - "kube-vip-lb.yaml.j2"
  when: cloud_provider_enabled
  notify: restart rke2-server


