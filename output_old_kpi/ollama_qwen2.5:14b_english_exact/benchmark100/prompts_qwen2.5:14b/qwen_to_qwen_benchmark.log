---
- name: Create the RKE2 config directory
  file:
    path: /etc/rancher/rke2
    state: directory

- name: Set server taints
  set_fact:
    combined_node_taints: "{{ rke2_server_node_taints }}"
  when: rke2_node_role == 'server'

- name: Copy RKE2 configuration file
  copy:
    src: templates/rke2-config.yaml.j2
    dest: /etc/rancher/rke2/config.yaml
  notify: Config file changed

- name: Copy kubelet configuration file
  copy:
    src: templates/kubelet-config.yaml.j2
    dest: /etc/rancher/rke2/kubelet-config.yaml
  when: rke2_kubelet_config is defined and (rke2_kubelet_config | length) > 0
  notify: Config file changed

- name: Copy Containerd Registry Configuration file
  copy:
    src: templates/registries.yaml.j2
    dest: /etc/rancher/rke2/registries.yaml
  when: (rke2_custom_registry_mirrors is defined and (rke2_custom_registry_mirrors | length) > 0) or (rke2_custom_registry_configs is defined and (rke2_custom_registry_configs | length) > 0)
  notify: Config file changed

- name: Register if we need to do a etcd restore from file
  set_fact:
    do_etcd_restore: true
  when: rke2_etcd_snapshot_file is defined and (rke2_etcd_snapshot_file | length) > 0 and (rke2_server_service_status == 'disabled' or rke2_server_service_status is undefined)

- name: Register if we need to do a etcd restore from s3
  set_fact:
    do_etcd_restore_from_s3: true
  when: rke2_etcd_snapshot_file is defined and (rke2_etcd_snapshot_file | length) > 0 and rke2_etcd_snapshot_s3_options.access_key is defined and rke2_etcd_snapshot_s3_options.secret_key is defined and rke2_etcd_snapshot_s3_options.bucket is defined and rke2_etcd_snapshot_s3_options.snapshot_name is defined

- name: Restore etcd from file
  block:
    - name: Create RKE2 etcd snapshot directory
      file:
        path: /var/lib/rancher/rke2/agent/etcd-snapshots
        state: directory

    - name: Copy etcd snapshot file
      copy:
        src: "{{ rke2_etcd_snapshot_file }}"
        dest: /var/lib/rancher/rke2/agent/etcd-snapshots/etcd-snapshot

    - name: Restore etcd from snapshot file
      command: /usr/local/bin/rke2-etcd-restore /var/lib/rancher/rke2/agent/etcd-snapshots/etcd-snapshot
      when: do_etcd_restore is defined

- name: Restore etcd from s3
  block:
    - name: Copy etcd snapshot file from S3
      s3:
        bucket: "{{ rke2_etcd_snapshot_s3_options.bucket }}"
        object: "{{ rke2_etcd_snapshot_s3_options.snapshot_name }}"
        mode: get
        dest: /var/lib/rancher/rke2/agent/etcd-snapshots/etcd-snapshot
        aws_access_key: "{{ rke2_etcd_snapshot_s3_options.access_key }}"
        aws_secret_key: "{{ rke2_etcd_snapshot_s3_options.secret_key }}"

    - name: Restore etcd from S3 snapshot
      command: /usr/local/bin/rke2-etcd-restore /var/lib/rancher/rke2/agent/etcd-snapshots/etcd-snapshot
      when: do_etcd_restore_from_s3 is defined

- name: Start RKE2 service on the first server
  service:
    name: rke2-server
    state: started
    enabled: yes
    environment:
      RKE2_TOKEN: "{{ rke2_join_token }}"
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Mask RKE2 agent service on the first server
  service:
    name: rke2-agent
    state: stopped
    enabled: no
    masked: yes
  when: inventory_hostname == groups['rke2_cluster_group_name'][0]

- name: Wait for the first server be ready - no CNI
  wait_for:
    path: /var/lib/rancher/rke2/server/node.info
    state: file
    delay: 10
    timeout: 300
  when: inventory_hostname == groups['rke2_cluster_group_name'][0] and rke2_cni is not defined

- name: Wait for the first server be ready - with CNI
  wait_for:
    path: /var/lib/rancher/rke2/server/node.info
    state: file
    delay: 10
    timeout: 300
  when: inventory_hostname == groups['rke2_cluster_group_name'][0] and rke2_cni is defined

- name: Restore etcd
  block:
    - name: Get registered nodes
      shell: /usr/local/bin/rke2-get-nodes | grep "ready\|not-ready"
      register: registered_nodes

    - name: Remove old node secrets and nodes
      shell: /usr/local/bin/rke2-remove-node-secrets-and-nodes.sh
      when: do_etcd_restore is defined or do_etcd_restore_from_s3 is defined

- name: Set an Active Server variable
  set_fact:
    active_server: "{{ inventory_hostname }}"
  when: inventory_hostname in groups['rke2_cluster_group_name']


