  register: prepare_system_result
  changed_when: false
  failed_when: false
  delegate_to: localhost
  ignore_errors: true

- name: Gather bootstrap facts
  setup:
    gather_subset:
      - "bootstrap_facts"
  when: prepare_system_result is not defined or not prepare_system_result.facts

- name: Gather ansible facts
  setup: {}

