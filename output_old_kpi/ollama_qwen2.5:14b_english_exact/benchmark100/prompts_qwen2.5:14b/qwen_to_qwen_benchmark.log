- name: Import assert.yml
  import_tasks: assert.yml
  run_once: true
  remote_addr: localhost

- name: Install logrotate
  package:
    name: "{{ logrotate_packages }}"
    state: present

- name: Configure logrotate
  template:
    src: "{{ logrotate_config_file }}.j2"
    dest: "{{ logrotate_config_directory }}/{{ logrotate_config_file }}"

- name: Generate logrotate.d files
  template:
    src: "{{ item.src }}.j2"
    dest: "{{ logrotate_config_directory }}/logrotate.d/{{ item.dest }}"
  with_items: "{{ logrotate_entries | selectattr('state', 'undefined') | selectattr('state', '!=', 'absent') | list }}"

- name: Remove logrotate.d files
  file:
    path: "{{ logrotate_config_directory }}/logrotate.d/{{ item }}"
    state: absent
  with_items: "{{ logrotate_entries | selectattr('state', 'defined') | selectattr('state', '==', 'absent') | map(attribute='filename') | list }}"

- name: Start logrotate
  service:
    name: "{{ logrotate_service }}"
    state: "{{ logrotate_service_state }}"
    enabled: "{{ logrotate_service_enabled | default('yes', true) }}"
  when: logrotate_service is defined


