---
- import_tasks: assert.yml
  name: Import assert.yml

- name: Install requirements
  package:
    name: bash
    state: present

- name: Install openjdk java (package)
  when: java_vendor == "openjdk"
  package:
    name: "{{ item }}"
    state: present
  loop:
    - openjdk-11-jdk
    - openjdk-8-jdk

- name: Install RPM
  when: java_package_type == "rpm" and java_vendor == "oracle"
  package:
    name: /usr/local/src/jdk-8u271-linux-x64.rpm
    state: present

- name: Install DEB
  when: java_package_type == "deb" and java_vendor == "oracle"
  package:
    name: /usr/local/src/jdk-8u271-linux-x64.deb
    state: present

- name: Install oracle java (rpm) (repository)
  when: java_package_type == "rpm" and java_vendor == "oracle" and install_type == "repo"
  yum:
    name: https://example.com/path/to/jdk-8u271-linux-x64.rpm
    state: present

- name: Configure oracle targz
  when: java_package_type == "targz"
  block:
    - name: Create /usr/java directory
      file:
        path: /usr/java
        state: directory
        mode: '0755'
    - name: Extract tarball to /usr/java
      unarchive:
        src: /usr/local/src/jdk-8u271-linux-x64.tar.gz
        dest: /usr/java
        remote_src: yes
        creates: /usr/java/jdk1_8_0_271

- name: Install oracle java policy software (targz)
  when: java_package_type == "targz" and oracle_java_jce
  block:
    - name: Copy JCE policy files to java home
      copy:
        src: /usr/local/src/jce_policy-8.zip
        dest: /usr/java/jdk1_8_0_271/jre/lib/security/
        remote_src: yes
        owner: root
        group: root
        mode: '0644'

- name: Set alternative (targz)
  when: java_package_type == "targz" and ansible_facts['ansible_distribution'] != "Alpine"
  alternatives:
    name: java
    path: /usr/java/jdk1_8_0_271/bin/java
    link: /usr/bin/java
    priority: 10
    state: present

- name: Find JAVA_HOME
  set_fact:
    java_home: "{{ lookup('pipe', 'readlink -f /usr/bin/java | rev | cut -d / -f 2- | rev') }}"

- name: Set JAVA_HOME in /etc/environment
  lineinfile:
    path: /etc/environment
    regexp: '^JAVA_HOME='
    line: 'JAVA_HOME={{ java_home }}'
    create: yes
    mode: '0644'


