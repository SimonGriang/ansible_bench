---
- import_tasks: assert.yml

- name: Install required packages
  package:
    name: "{{ selinux_requirements }}"
    state: present
  notify: gather_facts

- name: Flush handlers
  meta: flush_handlers

- name: Configure selinux
  when:
    - "'disabled' not in selinux_status.stdout"
    - ansible_connection != 'local'
  block:
    - name: Manage selinux
      selinux:
        policy: "{{ selinux_policy }}"
        state: "{{ 'enforcing' if selinux_enforcing else 'permissive' }}"
      notify: reboot_system

    - name: Manage selinux booleans
      seboolean:
        name: "{{ item.name }}"
        state: "{{ item.state }}"
        persistent: "{{ item.persistent|default(true) }}"
      loop: "{{ selinux_booleans }}"
      loop_control:
        label: "{{ item.name }}"


