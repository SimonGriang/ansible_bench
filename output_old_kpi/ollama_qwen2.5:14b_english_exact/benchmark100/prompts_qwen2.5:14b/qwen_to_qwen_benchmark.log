---
- name: create | Create ssl key
  openssl_privatekey:
    path: "{{ item.path }}/{{ item.name }}.key"
    provider: "{{ item.provider }}"
    mode: '0600'
    owner: 'root'
    group: 'root'
  with_items: "{{ ssl_keys }}"
  tags:
    - ssl
    - key

- name: create | Create ssl csr
  openssl_csr:
    path: "{{ item.path }}/{{ item.name }}.csr"
    privatekey_path: "{{ item.path }}/{{ item.name }}.key"
    common_name: "{{ item.name }}"
    mode: '0600'
    owner: 'root'
    group: 'root'
  with_items: "{{ ssl_csr }}"
  tags:
    - ssl
    - csr

- name: create | Create ssl certificates
  openssl_certificate:
    path: "{{ item.path }}/{{ item.name }}.crt"
    privatekey_path: "{{ item.path }}/{{ item.name }}.key"
    provider: selfsigned
    mode: '0600'
    owner: 'root'
    group: 'root'
  with_items: "{{ ssl_certs }}"
  tags:
    - ssl
    - cert

- name: create | Create PKCS#12 file
  openssl_pkcs12:
    export: yes
    path: "{{ item.path }}/{{ item.name }}.p12"
    name: "{{ item.name }}"
    privatekey_path: "{{ item.path }}/{{ item.name }}.key"
    certificate_path: "{{ item.path }}/{{ item.name }}.crt"
    mode: '0600'
    owner: 'root'
    group: 'root'
  with_items: "{{ ssl_pkcs12 }}"
  tags:
    - ssl
    - pkcs12

- name: create | Read private key
  slurp:
    src: "{{ item.path }}/{{ item.name }}.key"
  register: private_key_contents
  with_items: "{{ ssl_keys }}"
  tags:
    - ssl
    - key

- name: create | Read certificate
  slurp:
    src: "{{ item.path }}/{{ item.name }}.crt"
  register: cert_contents
  with_items: "{{ ssl_certs }}"
  tags:
    - ssl
    - cert

- name: create | Create combined private_key and certificate file
  copy:
    content: "{{ private_key_contents[loop.index0].content + cert_contents[loop.index0].content }}"
    dest: "{{ item.path }}/{{ item.name }}.combined.pem"
    mode: '0600'
    owner: 'root'
    group: 'root'
  with_items: "{{ ssl_keys }}"
  tags:
    - ssl
    - combined


