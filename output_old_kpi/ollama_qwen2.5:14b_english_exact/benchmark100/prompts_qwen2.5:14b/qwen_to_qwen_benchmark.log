---
- name: Create the RKE2 config directory
  file:
    path: /etc/rke2
    state: directory
    mode: '0755'

- name: Set server taints
  k8s_yaml:
    class: Kubernetes
    definition: |
      apiVersion: "k8s.cattle.io/v3"
      kind: Node
      metadata:
        name: "{{ inventory_hostname }}"
      spec:
        taints:
          - effect: NoSchedule
            key: node-type
            value: server
  when: rke2_type == 'server'

- name: Set agent taints
  k8s_yaml:
    class: Kubernetes
    definition: |
      apiVersion: "k8s.cattle.io/v3"
      kind: Node
      metadata:
        name: "{{ inventory_hostname }}"
      spec:
        taints:
          - effect: NoSchedule
            key: node-type
            value: agent
  when: rke2_type == 'agent'

- name: Copy RKE2 config file
  copy:
    src: rke2.yaml
    dest: /etc/rke2/config.yaml
    owner: root
    group: root
    mode: '0644'
  notify: restart_rke2

- name: Copy kubelet config file
  copy:
    src: kubelet.yaml
    dest: /etc/rke2/kubelet.yaml
    owner: root
    group: root
    mode: '0644'
  when: kubelet_yaml is defined
  notify: restart_rke2

- name: Copy Containerd Registry Configuration file
  copy:
    src: containerd-registry.yaml
    dest: /etc/rke2/agent.yaml
    owner: root
    group: root
    mode: '0644'
  when: rke2_type == 'agent' and containerd_registry is defined
  notify: restart_rke2

- name: Start RKE2 service
  service:
    name: rke2
    state: started
    enabled: yes
  when: rke2_type is defined
  notify: restart_rke2
  register: rke2_start_result
  until: rke2_start_result|succeeded
  retries: 5
  delay: 10

- name: Mask other RKE2 services
  service:
    name: "{{ item }}"
    state: masked
  loop:
    - rke2-agent
    - rke2-server
  when: rke2_type is defined

- name: Wait for remaining nodes to be ready - no CNI
  command: kubectl get nodes
  register: node_status
  until: node_status.stdout.find('Ready') != -1
  retries: 10
  delay: 5
  when: not cni_init and rke2_type is defined

- name: Wait for remaining nodes to be ready - with CNI
  command: kubectl get nodes
  register: node_status
  until: node_status.stdout.find('Ready') != -1
  retries: 10
  delay: 5
  when: cni_init and rke2_type is defined


