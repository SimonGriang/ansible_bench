, 'prompt_eval_duration': 261248444, 'eval_count': 523, 'eval_duration': 7336587700, 'model_name': 'qwen2.5:14b'} id='run--bb23a6b8-f376-4467-8f9c-b5f7e21832d0-0' usage_metadata={'input_tokens': 619, 'output_tokens': 523, 'total_tokens': 1142}
