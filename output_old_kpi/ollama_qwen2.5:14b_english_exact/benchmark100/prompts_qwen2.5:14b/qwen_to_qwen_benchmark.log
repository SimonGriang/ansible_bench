    bootstrap_os_family: "{% if bootstrap_distribution is defined %}{{ bootstrap_os_family_map[bootstrap_distribution] }}{% endif %}"
  vars:
    bootstrap_os_family_map:
      CentOS: "RedHat"
      Fedora: "RedHat"
      Debian: "Debian"
      Ubuntu: "Debian"
  when: bootstrap_distribution is defined


