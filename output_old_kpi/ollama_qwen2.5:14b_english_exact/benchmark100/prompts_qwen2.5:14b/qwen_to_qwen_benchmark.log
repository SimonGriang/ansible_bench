  when: os_vars.java_package_name is defined and os_vars.java_package_name is not None and os_vars.java_package_version is defined and os_vars.java_package_version is not None

- name: Set OS and architecture-specific variables (part II)
  set_fact:
    java_home: "{{ arch_vars.java_home }}"
  when: arch_vars.java_home is defined and arch_vars.java_home is not None

- name: Set specific variables
  set_fact:
    java_home: "{{ os_vars.java_home }}"
  when: os_vars.java_home is defined and os_vars.java_home is not None

- name: Debian pre-requisites
  block:
    - name: Remove deprecated repositories
      apt:
        name: "{{ item }}"
        state: absent
      loop: "{{ os_vars.deprecated_repositories }}"
      when: ansible_os_family == 'Debian'
    - name: Install extra apt tools
      apt:
        name: "{{ item }}"
        state: present
      loop: "{{ os_vars.apt_tools }}"
      when: ansible_os_family == 'Debian'
    - name: Add key repositories
      apt_key:
        url: "{{ item }}"
      loop: "{{ os_vars.key_repositories }}"
      when: ansible_os_family == 'Debian'
    - name: Add repositories
      apt_repository:
        filename: "{{ item.filename }}"
        repo: "{{ item.repo }}"
        state: present
      loop: "{{ os_vars.repositories }}"
      when: ansible_os_family == 'Debian'

- name: RedHat pre-requisites
  block:
    - name: Add key repositories
      rpm_key:
        key: "{{ item }}"
      loop: "{{ os_vars.key_repositories }}"
      when: ansible_os_family == 'RedHat'
    - name: Add repositories
      yum_repository:
        name: "{{ item.name }}"
        description: "{{ item.description }}"
        baseurl: "{{ item.baseurl }}"
        enabled: "{{ item.enabled }}"
        gpgcheck: "{{ item.gpgcheck }}"
        gpgkey: "{{ item.gpgkey }}"
      loop: "{{ os_vars.repositories }}"
      when: ansible_os_family == 'RedHat'

- name: Install required libraries
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ os_vars.required_libraries }}"
  when: os_vars.required_libraries is defined

- name: Install Java, Debian
  block:
    - name: Ensure cache is updated
      apt:
        update_cache: yes
      when: ansible_os_family == 'Debian'
    - name: Install package
      apt:
        name: "{{ java_package_name }}={{ java_package_version }}"
        state: present
      when: ansible_os_family == 'Debian'
    - name: Check package installation status
      shell: dpkg -s "{{ java_package_name }}"
      register: java_installed
      changed_when: java_installed.stdout.find('Status: install ok installed') != -1
      when: ansible_os_family == 'Debian'

- name: Install Java, RedHat
  block:
    - name: Ensure cache is updated
      yum:
        name: '*'
        state: latest
      when: ansible_os_family == 'RedHat'
    - name: Install package
      yum:
        name: "{{ java_package_name }}-{{ java_package_version }}"
        state: present
      when: ansible_os_family == 'RedHat'
    - name: Check package installation status
      shell: rpm -q "{{ java_package_name }}"
      register: java_installed
      changed_when: java_installed.stdout.find('is installed') != -1
      when: ansible_os_family == 'RedHat'

- name: Export environment variables
  template:
    src: java_env.j2
    dest: /etc/profile.d/java_env.sh

- name: Source environment variables
  shell: source /etc/profile.d/java_env.sh

- name: Correct java version selected for Java versions less than 11
  shell: update-alternatives --config java
  when: java_package_version is version('<11', version_compare='semver') and ansible_os_family == 'Debian'

- name: Correct java version selected for Java versions greater than or equal to 11
  shell: update-alternatives --config java
  when: java_package_version is version('>=11', version_compare='semver') and ansible_os_family == 'Debian'


