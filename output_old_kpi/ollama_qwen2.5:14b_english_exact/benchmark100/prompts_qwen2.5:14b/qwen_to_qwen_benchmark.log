---
- import_tasks: assert.yml
  delegate_to: localhost
  run_once: true

- name: Wait for port to be available
  wait_for:
    port: "{{ bootstrap_port }}"
    timeout: "{{ bootstrap_timeout }}"
    state: started
  connection: local

- name: Prepare system
  action: meta rinse
  become: true
  become_user: root
  become_flags: '--no-user-switch'

- name: Gather bootstrap facts
  block:
    - setup:
        gather_subset:
          - bootstrap
          - !bootstrap

- name: Install bootstrap packages (raw)
  raw: "{{ bootstrap_cmd_raw }}"
  when: ansible_facts['os_family'] is defined and ansible_facts['os_family'] != 'RedHat'

- name: Ensure libdnf5 is present on Fedora/RedHat
  yum:
    name: libdnf5
    state: present
  when: ansible_facts['os_family'] == 'RedHat'

- name: Gather ansible facts
  setup: {}

- name: Install bootstrap packages (package)
  package:
    name: "{{ bootstrap_packages }}"
    state: present
    update_cache: true


