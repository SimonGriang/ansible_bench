---
- import_tasks: assert.yml

- name: Manage automatic startup of services for apt-based systems
  apt:
    name: "{{ item }}"
    state: "{{ apt_autostart_state }}"
  loop:
    - apt-transport-https
    - ca-certificates
    - curl
    - software-properties-common

- name: Disable automatic service management on installation
  block:
    - name: Write /usr/sbin/policy-rc.d to disable automatic service management
      copy:
        dest: /usr/sbin/policy-rc.d
        content: 'exit 101'
        mode: 0755
        owner: root
        group: root
  when: apt_autostart_state == "disabled"

- name: Enable automatic service management on installation
  block:
    - name: Remove /usr/sbin/policy-rc.d to enable automatic service management
      file:
        path: /usr/sbin/policy-rc.d
        state: absent
  when: apt_autostart_state == "enabled"


