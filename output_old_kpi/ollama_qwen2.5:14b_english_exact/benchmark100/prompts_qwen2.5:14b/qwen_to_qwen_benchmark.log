content='---\n- name: Download RKE2 installation script\n  get_url:\n    url: "{{ rke2_install_script_url }}"\n    dest: "{{ rke2_install_script_dest }}"\n    mode: "0755"\n    timeout: 60\n\n- name: Copy local RKE2 installation script\n  copy:\n    src: "{{ rke2_local_install_script }}"\n    dest: "{{ rke2_install_script_dest }}"\n    mode: "0700"\n    force: yes\n  when: rke2_airgap_mode and rke2_airgap_implementation\n\n- name: Create RKE2 artifacts folder\n  file:\n    path: "{{ rke2_artifacts_path }}"\n    mode: "0700"\n    state: directory\n  when: rke2_airgap_mode and rke2_airgap_implementation != "exists"\n\n- name: Download RKE2 checksum and artifacts\n  block:\n    - name: Download RKE2 checksum\n      get_url:\n        url: "{{ rke2_artifacts_checksum_url }}"\n        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifacts_checksum_filename }}"\n        mode: "0640"\n        timeout: 60\n      when: rke2_airgap_mode and rke2_airgap_implementation == "download"\n\n    - name: Download RKE2 artifacts\n      get_url:\n        url: "{{ rke2_artifacts_url }}"\n        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifacts_filename }}"\n        mode: "0640"\n        timeout: 60\n      when: rke2_airgap_mode and rke2_airgap_implementation == "download"\n\n    - name: Download RKE2 install script\n      get_url:\n        url: "{{ rke2_install_script_url }}"\n        dest: "{{ rke2_install_script_dest }}"\n        mode: "0700"\n        timeout: 60\n      when: rke2_airgap_mode and rke2_airgap_implementation == "download"\n\n  rescue:\n    - name: Create directory for failed download\n      file:\n        path: "{{ rke2_download_fail_path }}"\n        mode: "0755"\n        state: directory\n        owner: root\n        group: root\n\n    - name: Download RKE2 artifacts and install script locally\n      get_url:\n        url: "{{ item }}"\n        dest: "{{ rke2_download_fail_path }}/{{ item }}"\n        mode: "0640"\n        timeout: 60\n      with_items:\n        - "{{ rke