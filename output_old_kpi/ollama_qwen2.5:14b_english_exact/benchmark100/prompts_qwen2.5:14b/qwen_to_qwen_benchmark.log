---
- import_tasks: assert.yml

- name: Uninstall conflicting systemd-logger
  package:
    name: systemd-logger
    state: absent

- name: Install rsyslog
  package:
    name: rsyslog
    state: present

- name: Install additional rsyslog packages
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ rsyslog_features }}"

- name: Configuring default rsyslog
  template:
    src: rsyslog.conf.j2
    dest: /etc/rsyslog.conf
    owner: root
    group: root
    mode: '0644'
  when: rsyslog_deploy_default_config

- name: Make configuration directory
  file:
    path: /etc/rsyslog.d/
    state: directory
    owner: root
    group: root
    mode: '0755'

- name: Configuring rsyslog forward rule
  template:
    src: forward_rules.conf.j2
    dest: /etc/rsyslog.d/forward_rules.conf
    owner: root
    group: root
    mode: '0644'
  when: not rsyslog_deploy_default_config

- name: Configuring additional config files
  copy:
    src: "{{ item.src }}"
    dest: "{{ item.dest }}"
    owner: root
    group: root
    mode: "{{ item.mode }}"
  loop: "{{ rsyslog_additional_configs }}"

- name: Start and enable rsyslog
  systemd:
    name: rsyslog
    enabled: true
    state: started


