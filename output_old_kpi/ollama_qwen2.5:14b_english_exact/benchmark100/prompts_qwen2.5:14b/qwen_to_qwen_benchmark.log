1/bin/java\n    link: /usr/bin/java\n    priority: 10\n    state: present\n\n- name: Find JAVA_HOME\n  set_fact:\n    java_home: "{{ lookup(\'pipe\', \'readlink -f /usr/bin/java | rev | cut -d / -f 2- | rev\') }}"\n\n- name: Set JAVA_HOME in /etc/environment\n  lineinfile:\n    path: /etc/environment\n    regexp: \'^JAVA_HOME=\'\n    line: "JAVA_HOME={{ java_home }}"\n    create: yes\n    mode: \'0644\'' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-01T17:48:11.500322687Z', 'done': True, 'done_reason': 'stop', 'total_duration': 13126308054, 'load_duration': 95007931, 'prompt_eval_count': 1473, 'prompt_eval_duration': 332614311, 'eval_count': 703, 'eval_duration': 12691894962, 'model_name': 'qwen2.5:14b'} id='run--8f488eed-99a7-4804-873b-196e2bda566c-0' usage_metadata={'input_tokens': 1473, 'output_tokens': 703, 'total_tokens': 2176} 98%|█████████▊| 98/100 [1:53:00<01:57, 58.59s/it]
