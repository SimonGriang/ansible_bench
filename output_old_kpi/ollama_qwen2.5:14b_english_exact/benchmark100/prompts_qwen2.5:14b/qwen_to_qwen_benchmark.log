---
- name: Install Keepalived when HA mode is enabled
  when: rke2_ha_mode and inventory_hostname in groups['rke2_servers']
  apt:
    name: keepalived
    state: present

- name: Download and install RKE2
  get_url:
    url: "https://update.rke2.io/{{ rke2_version }}/rke2-install.sh"
    dest: /usr/local/bin/rke2-install.sh
  register: rke2_install_url
  notify: install_rke2

- name: Perform CIS Hardening
  block:
    - name: Apply CIS hardening rules
      ansible.builtin.template:
        src: cis_rules.j2
        dest: /etc/cis_rules.conf
      when: cis_profile is defined
  notify: apply_cis_rules

- name: Identify the active server in the RKE2 cluster
  shell: rke2 query active-server
  register: active_server
  changed_when: false
  failed_when: false

- name: Enable IPVS kernel module
  when: use_kube_vip and rke2_ha_mode
  sysctl:
    name: net.ipv4.neigh.default.gc_thresh3
    value: 4096
    state: present
    reload: true

- name: Copy Kube-VIP manifests to the masternode
  when: not use_keepalived
  copy:
    src: kube-vip.yaml
    dest: /etc/rke2/kube-vip.yaml

- name: Copy ingress-nginx manifests to the masternode
  when: ingress_nginx_config is defined
  copy:
    src: ingress-nginx.yaml
    dest: /etc/rke2/ingress-nginx.yaml

- name: Prepare very first server node in the cluster
  when: not active_server.defined
  block:
    - name: Initialize RKE2 server
      shell: rke2 server init --token {{ rke2_join_token }} --etcd-external=false --kubelet-arg="volume-plugin-dir=/var/lib/rancher/rke2/bin/kubelet-plugins/volume/exec"
      notify: start_rke2_server

- name: Restore etcd specific tasks
  when: restore_etcd
