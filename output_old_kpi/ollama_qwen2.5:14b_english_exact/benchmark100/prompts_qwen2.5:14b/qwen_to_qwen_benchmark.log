---
- name: Create ssl key
  openssl_privatekey:
    path: "{{ item.key_path }}"
    mode: '0640'
    owner: 'root'
    group: 'root'
  loop: "{{ ssl_items }}"
  register: ssl_keys

- name: Create ssl csr
  openssl_csr:
    path: "{{ item.csr_path }}"
    privatekey_path: "{{ item.key_path }}"
    mode: '0644'
    common_name: "{{ item.common_name }}"
    owner: 'root'
    group: 'root'
  loop: "{{ ssl_items }}"
  register: ssl_csrs

- name: Create ssl certificates
  openssl_certificate:
    path: "{{ item.crt_path }}"
    provider: selfsigned
    privatekey_path: "{{ item.key_path }}"
    csr_path: "{{ item.csr_path }}"
    mode: '0644'
    owner: 'root'
    group: 'root'
  loop: "{{ ssl_items }}"
  register: ssl_certs

- name: Create PKCS#12 file
  openssl_pkcs12:
    path: "{{ item.p12_path }}"
    name: "{{ item.friendly_name }}"
    privatekey_path: "{{ item.key_path }}"
    certificate_path: "{{ item.crt_path }}"
    mode: '0640'
    owner: 'root'
    group: 'root'
  loop: "{{ ssl_items }}"
  register: ssl_p12

- name: Read private key
  slurp:
    src: "{{ item.key_path }}"
  loop: "{{ ssl_items }}"
  register: private_key_content

- name: Read certificate
  slurp:
    src: "{{ item.crt_path }}"
  loop: "{{ ssl_items }}"
  register: certificate_content

- name: Create combined private_key and certificate file
  copy:
    content: "{{ item.private_key_content.content + lookup('file', item.crt_path) }}"
    dest: "{{ item.combined_path }}"
    mode: '0640'
    owner: 'root'
    group: 'root'
  loop: "{{ ssl_items }}"
  register: combined_files


