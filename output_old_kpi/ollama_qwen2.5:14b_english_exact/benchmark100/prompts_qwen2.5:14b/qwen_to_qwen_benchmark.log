---
- name: group | Manage group {{ group.name }}
  ansible.builtin.group:
    name: "{{ group.name }}"
    state: "{{ group.state }}"
    gid: "{{ group.gid }}"
    system: "{{ group.system }}"

- name: group | Set sudo options for group {{ group.name }}
  block:
    - name: Template sudoers file for group {{ group.name }}
      ansible.builtin.template:
        src: "sudoers_group.j2"
        dest: "/etc/sudoers.d/{{ group.name }}"
        mode: "0440"
      notify: Validate sudoers file
      when: group.sudo_options is defined

    - name: Validate sudoers file
      ansible.builtin.command: visudo -c -s < /etc/sudoers.d/{{ group.name }}
      register: sudoers_validation
      failed_when: sudoers_validation.rc != 0
      changed_when: false
      when: group.sudo_options is defined


