---
- import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ cron_packages }}"
    state: present

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "SHELL=/bin/bash"
    mode: '0644'
  notify: restart cron

- name: Configure path
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
    mode: '0644'
  notify: restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/cron_config
    line: "MAILTO={{ mailto }}"
    mode: '0644'
  notify: restart cron

- name: Start and enable cron
  service:
    name: "{{ cron_service }}"
    state: started
    enabled: yes
  when: cron_service is defined and cron_service != ""

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute }}"
    hour: "{{ item.hour }}"
    day: "{{ item.day }}"
    month: "{{ item.month }}"
    weekday: "{{ item.weekday }}"
    job: "{{ item.job }}"
    special_time: "{{ item.special_time }}"
    state: "{{ item.state }}"
  with_items: "{{ cron_jobs }}"
  when: cron_jobs is defined and cron_jobs | length > 0



