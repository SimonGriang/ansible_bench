---
- name: Check current docker-compose version
  command: docker-compose --version
  register: docker_compose_version

- name: Set fact for current Docker Compose version
  set_fact:
    current_docker_compose_version: "{{ docker_compose_version.stdout.split('version: ')[1].split(',')[0].strip() }}"

- name: Delete existing docker-compose version if it's different
  file:
    path: /usr/local/bin/docker-compose
    state: absent
  when: current_docker_compose_version is undefined or current_docker_compose_version != "{{ desired_docker_compose_version }}"

- name: Install Docker Compose (if configured)
  block:
    - name: Download Docker Compose
      get_url:
        url: "https://github.com/docker/compose/releases/download/{{ desired_docker_compose_version }}/docker-compose-$(uname -s)-$(uname -m)"
        dest: /usr/local/bin/docker-compose
      when: current_docker_compose_version is undefined or current_docker_compose_version != "{{ desired_docker_compose_version }}"

    - name: Ensure Docker Compose is executable
      file:
        path: /usr/local/bin/docker-compose
        mode: '0755'
      when: current_docker_compose_version is undefined or current_docker_compose_version != "{{ desired_docker_compose_version }}"


