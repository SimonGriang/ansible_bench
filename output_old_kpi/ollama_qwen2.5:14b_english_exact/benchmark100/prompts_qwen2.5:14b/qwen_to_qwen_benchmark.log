---
- import_tasks: assert.yml

- name: Configure package management for apk
  ansible.builtin.shell: apk update && apk upgrade --available
  args:
    executable: /bin/sh
  notify: reboot

- name: Configure package management for apt
  ansible.builtin.apt:
    upgrade: full
    install_recommends: no
    options:
      - hold='{{ item.package }}'
    name: "{{ item.package }}"
  loop:
    - { package: 'package1' }
    - { package: 'package2' }
  register: held_packages
  changed_when: held_packages.results|map(attribute='changed')|any
  notify: reboot

- name: Update all software using dnf
  ansible.builtin.yum:
    name: '@System'
    state: latest
    exclude: 'package1,package2'
  notify: reboot

- name: Update all software using pacman
  ansible.builtin.pacman:
    sync:
      - '--sync'
      - '--refresh'
      - '--sysupgrade'
  notify: reboot

- name: Configure package management for yum
  ansible.builtin.yum:
    name: '@System'
    state: latest
  notify: reboot

- name: Update all software using zypper
  ansible.builtin.zypper:
    name: '@System'
    update: yes
  notify: reboot


