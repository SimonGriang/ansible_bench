---
- name: Download RKE2 installation script
  get_url:
    url: "{{ rke2_install_script_url }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: "0755"
    timeout: 60

- name: Copy local RKE2 installation script
  copy:
    src: "{{ rke2_local_install_script }}"
    dest: "{{ rke2_install_script_dest }}"
    mode: "0700"
    force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation

- name: Create RKE2 artifacts folder
  file:
    path: "{{ rke2_artifacts_path }}"
    mode: "0700"
    state: directory
  when: rke2_airgap_mode and rke2_airgap_implementation != "exists"

- name: Download RKE2 checksum and artifacts
  block:
    - name: Download RKE2 checksum
      get_url:
        url: "{{ rke2_artifacts_checksum_url }}"
        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifacts_checksum_filename }}"
        mode: "0640"
        timeout: 60
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"

    - name: Download RKE2 artifacts
      get_url:
        url: "{{ rke2_artifacts_url }}"
        dest: "{{ rke2_artifacts_path }}/{{ rke2_artifacts_filename }}"
        mode: "0640"
        timeout: 60
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"

    - name: Download RKE2 install script
      get_url:
        url: "{{ rke2_install_script_url }}"
        dest: "{{ rke2_install_script_dest }}"
        mode: "0700"
        timeout: 60
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"

  rescue:
    - name: Create directory for failed download
      file:
        path: "{{ rke2_download_fail_path }}"
        mode: "0755"
        state: directory
        owner: root
        group: root

    - name: Download RKE2 artifacts and install script locally
      get_url:
        url: "{{ item }}"
        dest: "{{ rke2_download_fail_path }}/{{ item }}"
        mode: "0640"
        timeout: 60
      with_items:
        - "{{ rke2_artifacts_url }}"
        - "{{ rke2_install_script_url }}"
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"

    - name: Copy local RKE2 artifacts
      copy:
        src: "{{ rke2_download_fail_path }}/{{ item }}"
        dest: "{{ rke2_artifacts_path }}/{{ item }}"
        mode: "0640"
        force: yes
      with_items:
        - "{{ rke2_artifacts_filename }}"
        - "{{ rke2_install_script_filename }}"
      when: rke2_airgap_mode and rke2_airgap_implementation == "download"

- name: Copy local RKE2 artifacts
  copy:
    src: "{{ rke2_local_artifacts }}"
    dest: "{{ rke2_artifacts_path }}/{{ rke2_artifacts_filename }}"
    mode: "0640"
    force: yes
  when: rke2_airgap_mode and rke2_airgap_implementation == "copy"

- name: Airgap mode - additional images tarballs
  block:
    - name: Create folder for additional images tarballs
      file:
        path: "{{ rke2_additional_images_path }}"
        mode: "0700"
        state: directory
      when: rke2_airgap_mode and rke2_airgap_copy_additional_tarballs|length > 0 and rke2_airgap_implementation != "exists"

    - name: Copy additional images tarballs
      copy:
        src: "{{ item }}"
        dest: "{{ rke2_additional_images_path }}/{{ item }}"
        mode: "0640"
        force: yes
      with_items: "{{ rke2_airgap_copy_additional_tarballs }}"
      when: rke2_airgap_mode and rke2_airgap_copy_additional_tarballs|length > 0 and rke2_airgap_implementation != "exists"

- name: Ensure artifacts exist and have acceptable permissions
  block:
    - name: Ensure RKE2 artifacts exist
      stat:
        path: "{{ rke2_artifacts_path }}/{{ rke2_artifacts_filename }}"
      register: rke2_artifacts_stat
      when: rke2_airgap_mode and rke2_airgap_implementation == "exists"

    - name: Ensure RKE2 install script exists
      stat:
        path: "{{ rke2_install_script_dest }}"
      register: rke2_install_script_stat
      when: rke2_airgap_mode and rke2_airgap_implementation == "exists"

    - name: Modify artifacts permissions if too permissive
      file:
        path: "{{ item.path }}"
        mode: "0640"
      with_items:
        - "{{ rke2_artifacts_stat }}"
        - "{{ rke2_install_script_stat }}"
      when: item.stat.mode|mode != "0640" and rke2_airgap_mode and rke2_airgap_implementation == "exists"

- name: Populate service facts
  ansible.builtin.setup:
    filter: service.*

- name: Get stats of the FS object
  ansible.builtin.stat:
    path: /usr/local

- name: Check if separate partition
  ansible.builtin.shell: |
    grep "{{ rke2_bin_path }}" /proc/mounts
  register: rke2_partition_check
  changed_when: false

- name: Set RKE2 bin path
  ansible.builtin.set_fact:
    rke2_bin_path: "{{ rke2_bin_path }}"

- name: Check RKE2 version
  shell: "{{ rke2_bin_path }}/rke2 version"
  register: rke2_version_check
  changed_when: false

- name: Set RKE2 versions
  ansible.builtin.set_fact:
    rke2_installed_version: "{{ rke2_version_check.stdout }}"
  when: not ansible_check_mode

- name: Prevent accidental RKE2 downgrade
  block:
    - name: Prevent downgrade
      fail:
        msg: "Downgrade from {{ rke2_installed_version }} to {{ rke2_version }} is not allowed"
      when: rke2_version < rke2_installed_version and not rke2_allow_downgrade

- name: Run RKE2 install script
  block:
    - name: Run RKE2 install script
      shell: "{{ rke2_bin_path }}/rke2 install --channel={{ rke2_channel }}"
      when: rke2_version != rke2_installed_version and not ansible_check_mode
      environment:
        RKE2_AIRGAP_MODE: "{{ rke2_airgap_mode }}"
        RKE2_AIRGAP_IMPLEMENTATION: "{{ rke2_airgap_implementation }}"
        RKE2_AIRGAP_PATH: "{{ rke2_artifacts_path }}"
        RKE2_AIRGAP_IMAGES_PATH: "{{ rke2_additional_images_path }}"
        RKE2_AIRGAP_DOWNLOAD_URL: "{{ rke2_artifacts_url }}"
        RKE2_AIRGAP_DOWNLOAD_URL_CHECKSUM: "{{ rke2_artifacts_checksum_url }}"
        RKE2_AIRGAP_COPY_ADDITIONAL_TARBALLS: "{{ rke2_airgap_copy_additional_tarballs }}"
        RKE2_AIRGAP_DOWNLOAD_PATH: "{{ rke2_download_fail_path }}"
        RKE2_AIRGAP_DOWNLOAD_URL_LOCAL: "{{ rke2_artifacts_url }}"
        RKE2_AIRGAP_DOWNLOAD_URL_LOCAL_CHECKSUM: "{{ rke2_artifacts_checksum_url }}"
        RKE2_AIRGAP_DOWNLOAD_URL_LOCAL_TARBALLS: "{{ rke2_artifacts_url }}"
        RKE2_AIRGAP_DOWNLOAD_URL_LOCAL_TARBALLS_CHECKSUM: "{{ rke2_artifacts_checksum_url }}"
      when: rke2_airgap_mode
      register: rke2_install_result
      changed_when: rke2_install_result.stdout_lines is defined
      failed_when: rke2_install_result.rc != 0

- name: Copy Custom Manifests
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_data_path }}/{{ item }}"
    mode: "0640"
    force: yes
  with_items: "{{ rke2_custom_manifests }}"
  when: rke2_custom_manifests|length > 0

- name: Copy Static Pods
  copy:
    src: "{{ item }}"
    dest: "{{ rke2_agent_pod_manifests_path }}/{{ item }}"
    mode: "0640"
    force: yes
  with_items: "{{ rke2_static_pods }}"
  when: rke2_static_pods|length > 0

- name: Copy RKE2 environment file
  copy:
    src: "{{ rke2_env_file }}"
    dest: "{{ rke2_data_path }}/rke2.env"
    mode: "0640"
    force: yes
  when: rke2_environment_options|length > 0 and rke2_environment_options != ""


