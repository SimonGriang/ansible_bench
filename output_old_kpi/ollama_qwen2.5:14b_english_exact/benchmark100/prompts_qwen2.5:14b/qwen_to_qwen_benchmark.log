---
- name: Install Keepalived when HA mode is enabled
  when: rke2_ha_mode and inventory_hostname in groups['rke2_servers']
  apt:
    name: keepalived
    state: present

- name: Download and install RKE2
  get_url:
    url: "https://update.rke2.io/{{ rke2_version }}/rke2-install.sh"
    dest: /usr/local/bin/rke2-install.sh
  register: rke2_install_url
  notify: install_rke2

- name: Perform CIS Hardening
  block:
    - name: Apply CIS hardening rules
      ansible.builtin.template:
        src: cis_rules.j2
        dest: /etc/cis_rules.conf
      when: cis_profile is defined
  notify: apply_cis_rules

- name: Identify the active server in the RKE2 cluster
  shell: rke2 query active-server
  register: active_server
  changed_when: false
  failed_when: false

- name: Enable IPVS kernel module
  when: use_kube_vip and rke2_ha_mode
  sysctl:
    name: net.ipv4.neigh.default.gc_thresh3
    value: 4096
    state: present
    reload: true

- name: Copy Kube-VIP manifests to the masternode
  when: not use_keepalived
  copy:
    src: kube-vip.yaml
    dest: /etc/rke2/kube-vip.yaml

- name: Copy ingress-nginx manifests to the masternode
  when: ingress_nginx_config is defined
  copy:
    src: ingress-nginx.yaml
    dest: /etc/rke2/ingress-nginx.yaml

- name: Prepare very first server node in the cluster
  when: not active_server.defined
  block:
    - name: Initialize RKE2 server
      shell: rke2 server init --token {{ rke2_join_token }} --etcd-external=false --kubelet-arg="volume-plugin-dir=/var/lib/rancher/rke2/bin/kubelet-plugins/volume/exec"
      notify: start_rke2_server

- name: Restore etcd specific tasks
  when: restore_etcd
  block:
    - name: Restore etcd data
      shell: rke2 etcd restore --data-dir /var/lib/rke2/etcd --backup-dir /backups/etcd
      changed_when: false

- name: Download kubeconfig to ansible localhost
  when: download_kubeconfig
  copy:
    src: /etc/rancher/rke2/rke2.yaml
    dest: "{{ ansible_user_dir }}/{{ inventory_hostname }}_rke2.yaml"
    flat: yes

- name: Prepare and join remaining nodes of the cluster
  when: active_server is defined
  block:
    - name: Join RKE2 node
      shell: rke2 agent join {{ active_server.stdout }} --token {{ rke2_join_token }}
      changed_when: false
      failed_when: false
    - name: Wait for node to be ready
      wait_for:
        path: /var/lib/rancher/rke2/server/node.info
        state: file
        sleep: 5
        timeout: 300

- name: Perform rolling restart for servers when the RKE2 version changes
  when: rke2_version is changed
  block:
    - name: Cordon server node
      shell: kubectl cordon {{ inventory_hostname }}
    - name: Drain server node
      shell: kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data --force --timeout=60m
    - name: Restart rke2
      shell: systemctl restart rke2-server
    - name: Uncordon server node
      shell: kubectl uncordon {{ inventory_hostname }}

- name: Perform rolling restart for agents when the RKE2 version changes
  when: rke2_version is changed
  block:
    - name: Cordon agent node
      shell: kubectl cordon {{ inventory_hostname }}
    - name: Drain agent node
      shell: kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data --force --timeout=60m
    - name: Restart rke2
      shell: systemctl restart rke2-agent
    - name: Uncordon agent node
      shell: kubectl uncordon {{ inventory_hostname }}

- name: Flush handlers
  meta: flush_handlers

- name: Perform rolling restart when configuration files change
  when: rke2_config_files is changed
  block:
    - name: Restart rke2
      shell: systemctl restart rke2-server
    - name: Wait for node to be ready
      wait_for:
        path: /var/lib/rancher/rke2/server/node.info
        state: file
        sleep: 5
        timeout: 300

- name: Final steps
  block:
    - name: Ensure RKE2 is running
      service:
        name: rke2-server
        state: started
        enabled: yes
    - name: Verify RKE2 status
      shell: rke2 query status
      register: rke2_status
      changed_when: false
      failed_when: "'ready' not in rke2_status.stdout.stdout"


