---
- ansible.builtin.import_tasks: assert.yml
  name: Import assert.yml

- name: Install vsftpd
  ansible.builtin.yum:
    name: vsftpd
    state: present

- name: Configure vsftpd
  ansible.builtin.template:
    src: vsftpd.conf.j2
    dest: /etc/vsftpd/vsftpd.conf
    owner: root
    group: root
    mode: '0600'
  notify: vsftpd_restart

- name: Start and enable vsftpd
  ansible.builtin.systemd:
    name: vsftpd
    enabled: true
    state: started

# Correcting the linting issues reported:
---
- name: Import assert.yml
  ansible.builtin.import_tasks: assert.yml

- name: Install vsftpd
  ansible.builtin.package:
    name: vsftpd
    state: present

- name: Configure vsftpd
  ansible.builtin.template:
    src: vsftpd.conf.j2
    dest: /etc/vsftpd/vsftpd.conf
    owner: root
    group: root
    mode: '0600'
  notify: vsftpd_restart

- name: Start and enable vsftpd
  ansible.builtin.systemd:
    name: vsftpd
    enabled: true
    state: started


