---
- import_tasks: assert.yml
 delegate_to: localhost

- name: Install docker-compose package
  when: installation_type == "package"
  apt:
    name: docker-compose
    state: present
  become: yes

- name: Install docker-compose as a binary
  when: installation_type == "binary"
  block:
    - name: Install required packages
      apt:
        name:
          - curl
          - jq
        state: present
      become: yes

    - name: Download docker-compose binary
      get_url:
        url: https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)
        dest: /usr/local/bin/docker-compose
        mode: 'u+x,g+x,o+r'
      become: yes


