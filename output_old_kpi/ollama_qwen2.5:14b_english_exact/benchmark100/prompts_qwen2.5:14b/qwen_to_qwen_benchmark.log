---
- name: Cordon and Drain the node {{ rke2_node_name }}
  kubectl:
    command: drain
    api_version: "{{ rke2_data_path }}config"
    kubeconfig: "{{ rke2_data_path }}kubeconfig"
    node_name: "{{ rke2_node_name }}"
    delete_local_data: yes
    ignore_daemon_sets: yes
    force: yes
    now: yes
    timeout: 0
    grace_period: 0
    additional_args: "{{ rke2_drain_additional_args }}"
  register: drain_node_result
  until: drain_node_result|success
  retries: 100
  delay: 15

- name: Restart RKE2 service on {{ rke2_node_name }}
  systemd:
    name: rke2-server
    state: restarted
    enabled: yes
  notify: Service (re)started

- name: Wait for all nodes to be ready again
  kubectl:
    command: get
    api_version: "{{ rke2_data_path }}config"
    kubeconfig: "{{ rke2_data_path }}kubeconfig"
    resource: nodes
    format: json
  register: get_nodes_result
  until: "'Ready' in get_nodes_result.stdout | from_json | json_query('[].status.conditions[].type')"
  retries: 100
  delay: 15

- name: Uncordon the node {{ rke2_node_name }}
  kubectl:
    command: uncordon
    api_version: "{{ rke2_data_path }}config"
    kubeconfig: "{{ rke2_data_path }}kubeconfig"
    node_name: "{{ rke2_node_name }}"
  when: rke2_drain_node_during_upgrade

- name: Wait for all pods to be ready again
  kubectl:
    command: get
    api_version: "{{ rke2_data_path }}config"
    kubeconfig: "{{ rke2_data_path }}kubeconfig"
    resource: pods
    format: json
  register: get_pods_result
  until: get_pods_result.stdout | from_json | json_query('[?status.phase!=`Running` && status.phase!=`Succeeded`].metadata.name') | length == 0
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_ready

- name: Wait for all pods to pass readiness checks
  kubectl:
    command: wait
    api_version: "{{ rke2_data_path }}config"
    kubeconfig: "{{ rke2_data_path }}kubeconfig"
    resource: pods
    format: json
    args:
      - "--for=condition=Ready"
      - "--timeout=0s"
  register: wait_pods_result
  until: wait_pods_result|success
  retries: 100
  delay: 15
  when: rke2_wait_for_all_pods_to_be_healthy


