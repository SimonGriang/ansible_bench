---
- name: Create local ssh_key_directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ user.ssh_key_directory }}"
    state: directory
    mode: '0750'
  when: user.manage_ssh_key | default(false)
  run_once: true
  delegate_to: localhost
  become: false

- name: Manage user {{ user.name }}
  ansible.builtin.user:
    name: "{{ user.name }}"
    state: "{{ user.state }}"
    password: "{{ user.password }}"
    uid: "{{ user.uid }}"
    gid: "{{ user.gid }}"
    groups: "{{ user.groups }}"
    shell: "{{ user.shell }}"
    create_home: "{{ user.create_home }}"
    system: "{{ user.system }}"
    expiry_date: "{{ user.expiry_date }}"
    move_home: "{{ user.move_home }}"
    remove: "{{ user.remove }}"
    home: "{{ user.home }}"
    ssh_key_options: "{{ user.ssh_key_options }}"
    update_password: "{{ user.update_password }}"
    force: "{{ user.force }}"
    password_lock: "{{ user.password_lock }}"
    shell_lock: "{{ user.shell_lock }}"

- name: Set sudo options for {{ user.name }}
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: touch
    mode: '0640'
    content: "{{ user.sudoers }}"
  when: user.sudoers is defined
  register: sudo_result
  failed_when: sudo_result is failed and sudo_result.rc != 2
  changed_when: sudo_result is changed and sudo_result.rc != 2

- name: Remove sudo options for {{ user.name }}
  ansible.builtin.file:
    path: "/etc/sudoers.d/{{ user.name }}"
    state: absent
  when: user.sudoers is not defined

- name: Generate private ssh key for {{ user.name }}
  ansible.builtin.shell: >
    ssh-keygen -q -t rsa -N '' -f {{ user.ssh_key_directory }}/{{ user.name }} -C "{{ user.name }}@{{ inventory_hostname }}"
  when: user.manage_ssh_key | default(false)
  register: ssh_keygen
  delegate_to: localhost
  become: false
  changed_when: false

- name: Generate public ssh key for {{ user.name }}
  ansible.builtin.shell: >
    ssh-keygen -y -f {{ user.ssh_key_directory }}/{{ user.name }} > {{ user.ssh_key_directory }}/{{ user.name }}.pub
  when: user.manage_ssh_key | default(false)
  delegate_to: localhost
  become: false
  changed_when: false

- name: Convert ssh key to ppk for {{ user.name }}
  ansible.builtin.shell: >
    puttygen {{ user.ssh_key_directory }}/{{ user.name }} -o {{ user.ssh_key_directory }}/{{ user.name }}.ppk -sil
  when: user.manage_ssh_key | default(false)
  register: ppk_result
  delegate_to: localhost
  become: false
  changed_when: false

- name: Get or set the home directory for {{ user.name }}
  ansible.builtin.getent:
    database: passwd
    key: "{{ user.name }}"
  register: user_info
  changed_when: false

- name: Create .ssh directory for {{ user.name }}
  ansible.builtin.file:
    path: "{{ user.home }}/.ssh"
    state: directory
    mode: '0700'
  when: user.manage_ssh_key | default(false) or user.private_keys is defined
  become: true

- name: Deploy authorized keys for {{ user.name }}
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: present
  loop: "{{ user.authorized_keys }}"
  when: user.authorized_keys is defined
  become: true

- name: Remove unauthorized keys for {{ user.name }}
  ansible.builtin.authorized_key:
    user: "{{ user.name }}"
    key: "{{ item }}"
    state: absent
  loop: "{{ user.unauthorized_keys }}"
  when: user.unauthorized_keys is defined
  become: true

- name: Copy generated private ssh key for {{ user.name }}
  ansible.builtin.copy:
    src: "{{ user.ssh_key_directory }}/{{ user.name }}"
    dest: "{{ user.home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.copy_private_key | default(false)

- name: Check users password valid time for {{ user.name }}
  ansible.builtin.shell: >
    chage -l {{ user.name }} | grep 'Password expires'
  register: password_valid_time
  changed_when: false

- name: Set users password valid time for {{ user.name }}
  ansible.builtin.shell: >
    chage -M {{ user.password_validity_days }} {{ user.name }}
  when: user.password_validity_days is defined and password_valid_time.stdout != "Password never expires"

- name: Place private key file for {{ user.name }}
  ansible.builtin.copy:
    src: "{{ user.private_keys[0] }}"
    dest: "{{ user.home }}/.ssh/id_rsa"
    mode: '0600'
    owner: "{{ user.name }}"
    group: "{{ user.name }}"
  when: user.private_keys is defined
  become: true
