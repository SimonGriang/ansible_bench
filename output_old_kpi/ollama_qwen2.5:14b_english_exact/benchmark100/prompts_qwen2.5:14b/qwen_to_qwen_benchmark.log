---
- import_tasks: assert.yml
  vars:
    ansible_host: "localhost"

- name: Install apache httpd
  package:
    name: "{{ httpd_packages }}"
    state: present

- name: Configure selinux
  when: ansible_selinux.status == 'enabled'
  seboolean:
    name: "{{ item.key }}"
    value: "{{ item.value|bool }}"
    persist: true
  with_dict:
    http: true
    http_port: true
    https: true
    https_port: true

- name: Configure httpd
  template:
    src: "{{ httpd_config_src }}"
    dest: "{{ httpd_config_dest }}"
    owner: root
    group: root
    mode: '0644'
  notify: test_httpd_config
  notify: restart_httpd

- name: Activate httpd module | Debian
  when: ansible_os_family == 'Debian'
  command: "{{ item }}"
  notify: test_httpd_config
  with_items: "{{ httpd_modules }}"
  register: mod_result
  changed_when: "'already enabled' not in mod_result.results[0].stdout"

- import_tasks: ssl.yml
  when: https_ssl_enable is defined and https_ssl_enable is true

- import_tasks: locations.yml
  when: httpd_locations is defined and httpd_locations|length > 0

- import_tasks: vhosts.yml
  when: httpd_vhosts is defined and httpd_vhosts|length > 0

- name: Configure ports
  when: ansible_os_family in ['Debian', 'Suse']
  template:
    src: "{{ httpd_ports_src }}"
    dest: "{{ httpd_ports_dest }}"
    owner: root
    group: root
    mode: '0644'
  notify: test_httpd_config
  notify: restart_httpd

- import_tasks: directories.yml
  when: httpd_directories is defined and httpd_directories|length > 0

- name: Flush handlers
  meta: flush_handlers

- name: Removing default html
  when: httpd_remove_example is defined and httpd_remove_example is true
  file:
    path: "{{ item }}"
    state: absent
  with_items:
    - /var/www/html/index.html

- name: Start and enable httpd
  systemd:
    name: httpd
    enabled: true
    state: started


