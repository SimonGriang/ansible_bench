---
- name: Ensure old versions of Docker are not installed
  package:
    name: '{{ item }}'
    state: absent
  loop:
    - docker-engine
    - docker.io
    - docker-ce-old
    - docker-ce-test
    - docker-ce-nightly

- name: Add Docker GPG key
  apt_key:
    url: 'https://download.docker.com/linux/{{ ansible_distributionLowerCase }}/gpg'
    state: present

- name: Add Docker repository
  apt_repository:
    repo: 'deb [arch={{ apt_architecture }}] https://download.docker.com/linux/{{ ansible_distributionLowerCase }} {{ ansible_distribution_version }} stable'
    state: present

- name: Configure Docker Nightly repo
  apt_repository:
    repo: 'deb [arch={{ apt_architecture }}] https://download.docker.com/linux/{{ ansible_distributionLowerCase }} {{ ansible_distribution_version }} nightly'
    state: present
  when: docker_repo_nightly

- name: Configure Docker Test repo
  apt_repository:
    repo: 'deb [arch={{ apt_architecture }}] https://download.docker.com/linux/{{ ansible_distributionLowerCase }} {{ ansible_distribution_version }} test'
    state: present
  when: docker_repo_test

- name: Configure containerd on RHEL 8
  block:
    - name: Ensure runc is not installed
      package:
        name: runc
        state: absent
      when: ansible_distribution_major_version == '8'
    - name: Ensure container-selinux and containerd.io are installed
      package:
        name: '{{ item }}'
        state: present
      loop:
        - container-selinux
        - containerd.io
      when: ansible_distribution_major_version == '8'


