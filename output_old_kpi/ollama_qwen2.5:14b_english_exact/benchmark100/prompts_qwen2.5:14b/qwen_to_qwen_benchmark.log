content='---\n- import_tasks: assert.yml\n  vars:\n    ansible_host: localhost\n\n- name: Install apache httpd\n  package:\n    name: "{{ httpd_packages }}"\n    state: present\n\n- name: Configure selinux\n  when: ansible_selinux.status == \'enabled\'\n  seboolean:\n    name: "{{ item.key }}"\n    value: "{{ item.value }}"\n    persist: yes\n  with_dict:\n    http: on\n    http_port: on\n    https: on\n    https_port: on\n\n- name: Configure httpd\n  template:\n    src: "{{ httpd_config_src }}"\n    dest: "{{ httpd_config_dest }}"\n    owner: root\n    group: root\n    mode: \'0644\'\n  notify: test_httpd_config\n  notify: restart_httpd\n\n- name: Activate httpd module | Debian\n  when: ansible_os_family == \'Debian\'\n  command: "{{ item }}"\n  notify: test_httpd_config\n  with_items: "{{ httpd_modules }}"\n  register: mod_result\n  changed_when: "\'already enabled\' not in mod_result.results.stdout"\n\n- import_tasks: ssl.yml\n  when: https_ssl_enable\n\n- import_tasks: locations.yml\n  when: httpd_locations|length > 0\n\n- import_tasks: vhosts.yml\n  when: httpd_vhosts|length > 0\n\n- name: Configure ports\n  when: ansible_os_family in [\'Debian\', \'Suse\']\n  template:\n    src: "{{ httpd_ports_src }}"\n    dest: "{{ httpd_ports_dest }}"\n    owner: root\n    group: root\n    mode: \'0644\'\n  notify: test_httpd_config\n  notify: restart_httpd\n\n- import_tasks: directories.yml\n  when: httpd_directories|length > 0\n\n- name: Flush handlers\n  meta: flush_handlers\n\n- name: Removing default html\n  when: httpd_remove_example\n  file:\n    path: "{{ item }}"\n    state: absent\n  with_items:\n    - /var/www/html/index.html\n\n- name: Start and enable httpd\n  systemd:\n    name: httpd\n    enabled: yes\n    state: started' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-01T16:39:47.560263116Z', 'done': True, 'done_reason': 'stop', 'total_duration': 8469482921, 'load_duration': 81812570, 'prompt_eval_count': 712, 'prompt_eval_duration': 340632454, 'eval_count': 467, 'eval_duration': 8034896428, 'model_name': 'qwen2.5:14b'} id='run--6a4496f5-2a09-4164-bf1a-79d5ea35a9ae-0' usage_metadata={'input_tokens': 712, 'output_tokens': 467, 'total_tokens': 1179}
