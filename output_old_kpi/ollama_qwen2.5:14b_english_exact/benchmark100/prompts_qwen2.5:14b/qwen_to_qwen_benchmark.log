---
- import_tasks: assert.yml

- name: Install mysql
  package:
    name: "{{ mysql_packages }}"
    state: present

- name: Configure mysql server
  lineinfile:
    path: /etc/mysql/my.cnf
    regexp: '^#{{ item.key }}'
    line: "{{ item.key }} = {{ item.value }}"
  loop: "{{ mysql_configuration_options|dict2items }}"

- name: Configure mysql client
  lineinfile:
    path: /etc/mysql/conf.d/client.cnf
    regexp: '^#socket'
    line: "socket = {{ mysql_client_socket }}"

- name: Initialize mysql
  command: mysql_install_db
  when: ansible_facts distributions|selectattr('id','defined')|map(attribute='id')|list in ['alpine', 'arch']

- name: Start and enable mysql
  service:
    name: mysql
    state: started
    enabled: yes

- name: Place my.cnf
  copy:
    dest: /etc/mysql/my.cnf
    content: "{{ custom_my_cnf }}"
    mode: "0644"

- name: Create databases
  mysql_db:
    name: "{{ item }}"
    state: present
  loop: "{{ mysql_databases|map(attribute='db')|list }}"
  when: "'initial_import' not in item

- name: List databases
  command: mysql -e 'show databases;'

- name: Import database
  command: mysql {{ item.db }} < {{ item.import_file }}
  loop: "{{ mysql_databases }}"
  when: "'initial_import' in item

- name: Create users
  mysql_user:
    name: "{{ item.username }}"
    password: "{{ item.password }}"
    priv: "{{ item.privileges }}"
    host: "{{ item.host }}"
    state: present
  loop: "{{ mysql_users }}"

- name: Flush handlers
  meta: flush_handlers

- name: Flush handlers again
  meta: flush_handlers


