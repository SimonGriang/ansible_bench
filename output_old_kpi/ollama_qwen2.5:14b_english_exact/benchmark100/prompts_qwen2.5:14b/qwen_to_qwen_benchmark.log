- name: Ensure document root directories are created for each virtual host
  file:
    path: "{{ item.docroot }}"
    state: directory
    mode: '0755'
    create: true
  loop: "{{ httpd_vhosts }}"
  when: item.create_docroot is undefined or item.create_docroot == True

