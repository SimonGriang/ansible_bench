---
- name: Create Vault group
  ansible.builtin.group:
    name: "{{ vault_group }}"

- name: Create Vault user
  ansible.builtin.user:
    name: "{{ vault_user }}"
    create_home: false
    shell: "{{ vault_user_shell }}"
    group: "{{ vault_group }}"
    system: true

- name: Create Vault download directory
  ansible.builtin.file:
    path: "{{ vault_download_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"

- name: Download Vault binary
  ansible.builtin.unarchive:
    url: "{{ vault_binary_url }}"
    dest: "{{ vault_download_path }}"
    remote_src: false
    owner: root
    group: root
    mode: '0755'

- name: Check if vault_path exists
  ansible.builtin.stat:
    path: "{{ vault_path }}"

- name: Create vault_path if it does not exist
  ansible.builtin.file:
    path: "{{ vault_path }}"
    state: directory
    mode: '0755'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  when: not vault_path.stat.exists and vault_path is defined

- name: Create directory in vault_path
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_directories }}"

- name: Create data directory
  ansible.builtin.file:
    path: "{{ item.path }}"
    state: directory
    mode: '0755'
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_data_directories }}"

- name: Generate TLS key and certificate
  community.crypto.x509_certificate:
    path: "{{ vault_data_directory }}/tls/{{ item.name }}.pem"
    privatekey_path: "{{ vault_data_directory }}/tls/{{ item.name }}.key"
    csr_path: "{{ vault_data_directory }}/tls/{{ item.name }}.csr"
    country_name: "{{ item.country }}"
    state_or_province_name: "{{ item.state }}"
    locality_name: "{{ item.locality }}"
    organization_name: "{{ item.org }}"
    organizational_unit_name: "{{ item.org_unit }}"
    common_name: "{{ item.common_name }}"
    email_address: "{{ item.email }}"
    days: 1095
    provider: 'selfsigned'
  loop: "{{ vault_tls_certs }}"
  notify: Restart vault

- name: Set ownership of tls material
  ansible.builtin.file:
    path: "{{ item.path }}"
    owner: "{{ item.owner }}"
    group: "{{ item.group }}"
  loop: "{{ vault_tls_files }}"

- name: Copy Vault binary
  ansible.builtin.copy:
    src: "{{ vault_download_path }}/vault"
    dest: "{{ vault_path }}/usr/bin/vault"
    mode: '0755'
  notify: Restart vault

- name: Set cap_ipc_lock=ep on /usr/bin/vault
  ansible.builtin.set_fact:
    vault_binary_path: "{{ vault_path }}/usr/bin/vault"
    ansible_facts:
      changed: false
  notify: Restart vault

- name: Touch vault.env
  ansible.builtin.file:
    path: "{{ vault_path }}/etc/vault.d/vault.env"
    state: touch
    mode: '0644'
    owner: "{{ vault_user }}"
    group: "{{ vault_group }}"
  notify: Restart vault

- name: Create /usr/lib/systemd/system
  ansible.builtin.file:
    path: /usr/lib/systemd/system
    state: directory
    mode: '0755'

- name: Copy Vault service file
  ansible.builtin.template:
    src: vault.service.j2
    dest: /usr/lib/systemd/system/vault.service
    mode: '0644'
  notify: Daemon reload
  when: ansible_service_mgr == 'systemd'

- name: Copy vault configuration
  ansible.builtin.copy:
    src: vault.hcl
    dest: "{{ vault_path }}/etc/vault.d/vault.hcl"
    mode: '0644'
  notify: Restart vault

- name: Flush handlers
  ansible.builtin.meta:
    flush_handlers:



