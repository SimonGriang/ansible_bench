---
- import_tasks: assert.yml

- name: Install cron
  package:
    name: "{{ item }}"
    state: present
  loop: "{{ cron_packages | default([]) }}"
  loop_control:
    extended: true

- name: Configure shell
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "SHELL={{ cron_shell }}"
    create: yes
    regexp: '^SHELL='
    state: present
    mode: '0600'
  notify: Restart cron

- name: Configure path
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "PATH={{ cron_path }}"
    create: yes
    regexp: '^PATH='
    state: present
    mode: '0600'
  notify: Restart cron

- name: Configure mailto
  lineinfile:
    path: /etc/cron.d/cron.conf
    line: "MAILTO={{ cron_mailto }}"
    create: yes
    regexp: '^MAILTO='
    state: present
    mode: '0600'
  notify: Restart cron

- name: Start and enable cron
  service:
    name: cron
    enabled: true
    state: started
  when: cron_service is defined and cron_service | length > 0

- name: Schedule requested cron jobs
  cron:
    name: "{{ item.name }}"
    minute: "{{ item.minute | default('0') }}"
    hour: "{{ item.hour | default('0') }}"
    day: "{{ item.day | default('*') }}"
    month: "{{ item.month | default('*') }}"
    weekday: "{{ item.weekday | default('*') }}"
    job: "{{ item.command }}"
    state: present
  loop: "{{ cron_jobs | default([]) }}"
  loop_control:
    extended: true


