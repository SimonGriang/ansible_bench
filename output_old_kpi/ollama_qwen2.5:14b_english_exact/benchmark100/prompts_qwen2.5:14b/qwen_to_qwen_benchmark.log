---
- name: Check if Helm binary exists
  stat:
    path: /usr/local/bin/helm
  register: helm_binary_exists

- name: Check Helm version
  command: /usr/local/bin/helm version --short
  when: helm_binary_exists.stat.exists
  register: helm_version
  changed_when: false

- name: Download helm
  get_url:
    url: "https://get.helm.sh/helm-v{{ helm_version.stdout.split('v')[-1] }}/helm-v{{ helm_version.stdout.split('v')[-1] }}-{{ ansible_distribution_release }}-{{ ansible_system }}.tar.gz"
    dest: /tmp/helm.tar.gz
  when: not helm_binary_exists.stat.exists or helm_version.stdout.split('v')[-1] < "3.8.0"

- name: Copy helm binary into place
  copy:
    src: /tmp/helm
    dest: /usr/local/bin/helm
    mode: '0755'
  when: not helm_binary_exists.stat.exists or helm_version.stdout.split('v')[-1] < "3.8.0"
  register: copy_helm_result
  notify: Clean up temp files

- name: Ensure helm binary is executable
  file:
    path: /usr/local/bin/helm
    mode: '0755'
    state: file
  when: not helm_binary_exists.stat.exists or helm_version.stdout.split('v')[-1] < "3.8.0"

handlers:
  - name: Clean up temp files
    file:
      path: /tmp/helm.tar.gz
      state: absent
    listen: Clean up temp files


