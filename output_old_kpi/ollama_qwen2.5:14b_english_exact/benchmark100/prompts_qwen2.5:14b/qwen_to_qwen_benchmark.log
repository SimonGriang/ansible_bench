  package:
    name: "{{ item }}"
    state: present
  with_items: "{{ bootstrap_facts_packages }}"
  when: bootstrap_facts_packages is defined
  register: bootstrap_package_install
  changed_when: true
  failed_when: bootstrap_package_install.results | selectattr('failed', 'defined') | list


