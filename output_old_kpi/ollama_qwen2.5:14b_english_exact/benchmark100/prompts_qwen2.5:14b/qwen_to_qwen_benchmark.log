    dest: "{{ ansible_user_dir }}/{{ inventory_hostname }}_rke2.yaml"
    flat: yes

- name: Prepare and join remaining nodes of the cluster
  when: active_server is defined
  block:
    - name: Join RKE2 node
      shell: rke2 agent join {{ active_server.stdout }} --token {{ rke2_join_token }}
      changed_when: false
      failed_when: false
    - name: Wait for node to be ready
      wait_for:
        path: /var/lib/rancher/rke2/server/node.info
        state: file
        sleep: 5
        timeout: 300

- name: Perform rolling restart for servers when the RKE2 version changes
  when: rke2_version is changed
  block:
    - name: Cordon server node
      shell: kubectl cordon {{ inventory_hostname }}
    - name: Drain server node
      shell: kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data --force --timeout=60m
    - name: Restart rke2
      shell: systemctl restart rke2-server
    - name: Uncordon server node
      shell: kubectl uncordon {{ inventory_hostname }}

- name: Perform rolling restart for agents when the RKE2 version changes
  when: rke2_version is changed
  block:
    - name: Cordon agent node
      shell: kubectl cordon {{ inventory_hostname }}
    - name: Drain agent node
      shell: kubectl drain {{ inventory_hostname }} --ignore-daemonsets --delete-local-data --force --timeout=60m
    - name: Restart rke2
      shell: systemctl restart rke2-agent
    - name: Uncordon agent node
      shell: kubectl uncordon {{ inventory_hostname }}

- name: Flush handlers
  meta: flush_handlers

- name: Perform rolling restart when configuration files change
