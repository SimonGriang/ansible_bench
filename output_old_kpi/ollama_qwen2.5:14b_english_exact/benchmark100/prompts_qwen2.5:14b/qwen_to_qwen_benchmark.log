---
- import_tasks: assert.yml

- name: Enable redis module stream (RHEL 8)
  dnf:
    name: redis
    state: installed
    enabled: yes
  when: ansible_distribution_major_version == '8' and ansible_os_family == 'RedHat'

- name: Install redis
  package:
    name: "{{ redis_packages }}"
    state: present

- name: Configure redis
  template:
    src: "redis.conf.j2"
    dest: "{{ redis_config_file }}"
    owner: root
    group: root
    mode: '0644'
  notify: restart_redis

- name: Start and enable redis
  service:
    name: "{{ redis_service }}"
    state: started
    enabled: yes


