content='---\n- name: Check if the system is EFI\n  stat:\n    path: /sys/firmware/efi/efivars\n  register: efi_check\n\n- name: Remove the grub.cfg file if the system is EFI\n  file:\n    path: /boot/grub2/grub.cfg\n    state: absent\n  when: efi_check.stat.exists\n\n- name: Install a user template for GRUB\n  copy:\n    dest: /etc/grub.d/01_users\n    mode: 0700\n    owner: root\n    content: |\n      #!/bin/sh\n      exec tail -n +0\n  notify: update-grub\n\n- name: Add a password to the EFI GRUB configuration\n  lineinfile:\n    path: /etc/grub2-efi.cfg\n    regexp: \'^set superusers="root"\'\n    line: \'set superusers="root"\\npassword_pbkdf2 root {{ grub_password_hash }}\'\n  notify: update-grub\n  when: efi_check.stat.exists\n\n- name: Add a password to the MBR GRUB configuration\n  lineinfile:\n    path: /etc/grub2.cfg\n    regexp: \'^set superusers="root"\'\n    line: \'set superusers="root"\\npassword_pbkdf2 root {{ grub_password_hash }}\'\n  notify: update-grub\n  when: not efi_check.stat.exists\n\n- name: Add --unrestricted option to specified files\n  replace:\n    path: "{{ item }}"\n    regexp: \'CLASS="([^"]*)"\'\n    replace: \'CLASS="{{ "\\1 --unrestricted" }}\'\n  notify: update-grub\n  when: grub_password_unrestricted\n  with_items: "{{ grub_password_unrestricted_files }}"\n  loop_control:\n    loop_var: item' additional_kwargs={} response_metadata={'model': 'qwen2.5:14b', 'created_at': '2025-10-01T16:06:04.509675067Z', 'done': True, 'done_reason': 'stop', 'total_duration': 6653464432, 'load_duration': 70516472, 'prompt_eval_count': 576, 'prompt_eval_duration': 300347800, 'eval_count': 383, 'eval_duration': 6268136324, 'model_name': 'qwen2.5:14b'} id='run--09a4fc01-07d0-43cd-bce8-dee20f712e1f-0' usage_metadata={'input_tokens': 576, 'output_tokens': 383, 'total_tokens': 959}
